;; compiler_regalloc.tl - Planning-only scalar register allocation.
;;
;; This pass mirrors the legacy backend's planning shape without changing
;; assembly emission. It computes inspectable live intervals, ineligible vars,
;; and register/spill homes for scalar IR values. The selfhost pools keep
;; %rsp/%rbp reserved and admit caller-saved integer/XMM registers only for
;; values that cannot be clobbered by call emission.
(import stdlib.io)
(import stdlib.array)
(import stdlib.string)
(import stdlib.str_cat_runtime as str_cat)
(import stdlib.hashmap)

;; Block labels are interned ids, so their maps are integer-keyed (refs #5718).
(import (hashmap.hashmap i64 i64) as reg_label_i64_map)
(import (hashmap.hashmap i64 i64) as reg_i64_i64_map)
(import compiler_ast_types as ast)
(import compiler_abi as cabi)
(import compiler_liveness as live)
(import compiler_ir_types as ir)
(import compiler_parallel_move as pmove)
(cfg test (import stdlib.test))

(defmacro (compiler-reg-global-shared-view [place : Expr]) : Expr
  (cfg
    stage0-seed-bootstrap
    place
    `(unsafe
      (ptr-read (ptr-addr-of ,place)))))

;; Physical-register IDs and interned block-label IDs are deliberately carried
;; by distinct dense wrappers. Both use a contiguous live prefix, but keeping
;; separate types prevents an i64 from one identity domain from reaching an API
;; for the other by accident.
(defstruct CompilerRegIdSeq
  (slots (__tl_dyn-array i64))
  (len i64))

(defstruct CompilerRegLabelSeq
  (slots (__tl_dyn-array i64))
  (len i64))

;; Width is an instruction property, not a physical-register identity. Scalar
;; XMM and width-neutral vector homes have distinct compact IDs so emission
;; retains the required class; their ownership IDs collapse onto the same
;; hardware family for interference.
(defenum CompilerRegLocation
  (Register i64)
  ;; A 2-word register-group value lives in two GP registers (word0,
  ;; word1). A group that cannot get two registers spills to a 16-byte slot,
  ;; represented as the ordinary CompilerRegLocation.Spill (the backend reads the second
  ;; word at offset-8 using the program word-count map).
  (RegisterPair i64 i64)
  (Spill i64)
  ;; Rematerialization: a single-def value whose definition is a cheap static
  ;; recompute (a constant or an address materialization `leaq label(%rip)`) is
  ;; not spilled to a slot under pressure -- it is RECOMPUTED at each use and its
  ;; defining store is dropped. The carried IrValue is exactly what the def Mov
  ;; produced, so recomputing always yields the identical value.
  (Remat ir.CompilerIrValue))

(defenum CompilerRegMaybeLocation
  (No)
  (Some CompilerRegLocation))

(defenum CompilerRegMaybeId
  (No)
  (Some i64))

(defstruct CompilerRegAssignment
  (var i64)
  (location CompilerRegLocation))

(defstruct CompilerRegInterval
  (var i64)
  (start i64)
  (end i64))

;; Dense interval storage. The live logical sequence is the contiguous
;; `slots[0 .. len)` prefix, in exactly the order consumers observe. Hot
;; producers append into geometric capacity; the cold prepend helper preserves
;; fixture/worklist order by shifting the live prefix. Per-variable segment
;; sequences in CompilerRegIntervalIndex are sorted by ascending start.
(defstruct CompilerRegIntervalSeq
  (slots (__tl_dyn-array CompilerRegInterval))
  (len i64))

(defenum CompilerRegMaybeInterval
  (No)
  (Some CompilerRegInterval))

;; The per-function var-type view is a pair of var-id-indexed arrays. IR
;; variable IDs are a dense monotonic domain bounded by the function's `vars`
;; watermark. `present` distinguishes real definitions from holes in that
;; domain; `items` carries the exact type for each present ID.
(defstruct CompilerRegVarTypes
  (present (__tl_dyn-array i64))
  (items (__tl_dyn-array ast.AstType)))

(defenum CompilerRegMaybeType
  (No)
  (Some ast.AstType))

;; Authoritative assignment storage. Variable IDs define deterministic plan
;; order: iteration scans the dense `present` domain from low to high, while
;; `items[var]` provides direct lookup. Greedy/worklist code owns its table and
;; mutates it in place; plan overlays use the copying helper below so a retained
;; predecessor cannot observe successor-only updates.
(defstruct CompilerRegAssignmentTable
  (present (__tl_dyn-array i64))
  (items (__tl_dyn-array CompilerRegLocation)))

;; One register's live-interval union: the segments of every resident of that
;; register, `slots[0 .. count)` ascending by effective start, three i64 per
;; entry (see the block comment above compiler-reg-live-union-entry-words).
;; Growth replaces the whole value in its owning array, exactly as
;; CompilerRegIntervalSeq does -- an array of structs each holding an array,
;; never an array of arrays.
(defstruct CompilerRegLiveUnion
  (slots (__tl_dyn-array i64))
  (count i64))

;; Mutable inverse index for the greedy allocator's physical-register homes.
;; `words` is a flat [register][variable-word] bitset; primary/secondary retain
;; each variable's current pool indices so assignment updates clear old homes in
;; O(1). Register pairs occupy both indexed registers.
;;
;; `live-union*` is the per-register LiveIntervalUnion (LLVM RAGreedy): the live
;; SEGMENTS of every resident of a register, kept sorted by effective start, so
;; "is this register free for v?" is a stabbing query over v's own (1.37 on
;; average) segments instead of one segmented-interference predicate call per
;; resident (22.8 on average). See compiler-reg-live-union-interferes?.
(defstruct CompilerRegGreedyOccupancy
  (words (__tl_dyn-array i64))
  (word-count i64)
  (primary (__tl_dyn-array i64))
  (secondary (__tl_dyn-array i64))
  ;; Canonical ownership register ID -> pool index, -1 when absent.
  (pool-index (__tl_dyn-array i64))
  ;; pool index -> that register's union.
  (live-union (__tl_dyn-array CompilerRegLiveUnion))
  ;; pool index -> residents with NO segment data. Such a resident is answered
  ;; by the coarse whole-interval fallback inside the interference predicate,
  ;; which the union does not model, so a nonzero count sends the whole query
  ;; back to the per-resident scan.
  (live-union-coarse (__tl_dyn-array i64))
  ;; The segment table the union was built from. Every query must use the same
  ;; interval index the occupancy was made with.
  (live-union-segments (__tl_dyn-array CompilerRegIntervalSeq)))

(defstruct CompilerRegIntervalIndex
  (starts (__tl_dyn-array i64))
  (ends (__tl_dyn-array i64))
  (segments (__tl_dyn-array CompilerRegIntervalSeq)))

(defenum CompilerRegIntervalSelection
  (Selection CompilerRegIntervalSeq CompilerRegIntervalIndex))

;; Scalar literal SafeDiv/SafeMod scratch participates in the ordinary greedy
;; allocation before the final homes are published.  The model is empty for
;; every function without that exact shape, so unrelated worklists keep their
;; original size.  Synthetic ids start at `scratch-base` and are stripped from
;; the public CompilerRegPlan after they have constrained the real homes.
(defstruct CompilerRegEarlyScratchModel
  (interval-index CompilerRegIntervalIndex)
  (type-info CompilerRegVarTypes)
  (assignments CompilerRegAssignmentTable)
  (scratch-weights (__tl_dyn-array i64))
  ;; Per-synthetic-var physical homes barred by the real lowering constraint.
  ;; C15b feeds these into the scratch greedy so a pseudo cannot satisfy demand
  ;; with an operand/result home that the late scratch planner must reject.
  (scratch-excluded (__tl_dyn-array CompilerRegIdSeq))
  (scratch-base i64)
  (scratch-count i64))

;; A liveness handle belongs to exactly one immutable CompilerIrFunction value.
;; Regalloc creates a fresh handle after every IR rewrite, then shares its
;; baseline analysis through all read-only planning helpers for that version.
;; The edge-precise result is populated only for scalar opt2 allocation and
;; coalescing. Keeping both analyses here lets the coalescer retain its one
;; deliberately conservative exclusion while making the version boundary
;; explicit and preventing accidental cross-function reuse.
(defenum CompilerRegMaybeLiveness
  (No)
  (Some live.CompilerFunctionLiveness))

(defstruct CompilerRegLivenessHandle
  (baseline live.CompilerFunctionLiveness)
  (edge-precise CompilerRegMaybeLiveness))

(cfg
  (any regalloc-liveness-census test)
  (define compiler-reg-liveness-census-baseline : i64
    0))
(cfg
  (any regalloc-liveness-census test)
  (define compiler-reg-liveness-census-edge-precise : i64
    0))

(define (compiler-reg-liveness-census-reset!) : unit
  (cfg
    (any regalloc-liveness-census test)
    (begin
      (set! compiler-reg-liveness-census-baseline 0)
      (set! compiler-reg-liveness-census-edge-precise 0))
    unit))

(define (compiler-reg-liveness-census-baseline-count) : i64
  (cfg
    (any regalloc-liveness-census test)
    compiler-reg-liveness-census-baseline
    0))

(define (compiler-reg-liveness-census-edge-precise-count) : i64
  (cfg
    (any regalloc-liveness-census test)
    compiler-reg-liveness-census-edge-precise
    0))

(define (compiler-reg-instr-seq-has-phi?
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    false
    (match (ir.compiler-ir-instr-seq-ref instrs index)
      [(ir.CompilerIrInstr.Phi _ _ _) true]
      [_ (compiler-reg-instr-seq-has-phi? instrs (+ index 1))])))

(define (compiler-reg-block-seq-has-phi?
  [blocks : ir.CompilerIrBlockSeq]
  [index : i64]) : bool
  (if (>= index (ir.compiler-ir-block-seq-count blocks))
    false
    (match (ir.compiler-ir-block-seq-ref blocks index)
      [(ir.CompilerIrBlock.Block _ instrs)
        (if (compiler-reg-instr-seq-has-phi? instrs 0)
          true
          (compiler-reg-block-seq-has-phi? blocks (+ index 1)))])))

(define (compiler-reg-blocks-have-phi? [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (if (compiler-reg-instr-seq-has-phi? instrs 0)
            true
            (compiler-reg-blocks-have-phi? (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq) (compiler-reg-block-seq-has-phi? seq 0)]))

(define (compiler-reg-liveness-handle-make
  [func : ir.CompilerIrFunction]
  [need-edge-precise : bool]) : CompilerRegLivenessHandle
  (let
    [baseline : live.CompilerFunctionLiveness
      (live.compiler-live-analyze-function func)]
    (begin
      (cfg
        (any regalloc-liveness-census test)
        (set!
          compiler-reg-liveness-census-baseline
          (+ compiler-reg-liveness-census-baseline 1))
        unit)
      (cfg
        regalloc-liveness-census
        (let
          [message : String
            (if (and
              need-edge-precise
              (match func
                [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
                  (compiler-reg-blocks-have-phi? blocks)]))
              "regalloc-liveness-census|baseline=1|edge-precise=1\n"
              "regalloc-liveness-census|baseline=1|edge-precise=0\n")]
          (io.print-error message))
        unit)
      (if need-edge-precise
        (match func
          [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
            ;; Edge-precise liveness differs from the baseline only at Phi
            ;; instructions (phi inputs attribute to predecessor edges instead
            ;; of the phi block). A phi-free function has identical analyses,
            ;; so reuse the baseline instead of running a second fixpoint.
            (if (compiler-reg-blocks-have-phi? blocks)
              (let
                [edge-precise : live.CompilerFunctionLiveness
                  (live.compiler-live-analyze-function-edge-precise func)]
                (begin
                  (cfg
                    (any regalloc-liveness-census test)
                    (set!
                      compiler-reg-liveness-census-edge-precise
                      (+ compiler-reg-liveness-census-edge-precise 1))
                    unit)
                  (CompilerRegLivenessHandle
                    baseline
                    (CompilerRegMaybeLiveness.Some edge-precise))))
              (CompilerRegLivenessHandle
                baseline
                (CompilerRegMaybeLiveness.Some baseline)))])
        (CompilerRegLivenessHandle baseline (CompilerRegMaybeLiveness.No))))))

(define (compiler-reg-liveness-handle-edge-precise
  [handle : CompilerRegLivenessHandle]) : live.CompilerFunctionLiveness
  (match handle.edge-precise
    [(CompilerRegMaybeLiveness.Some liveness) liveness]
    [(CompilerRegMaybeLiveness.No)
      ;; Callers requesting this accessor are scalar coalescer paths and must
      ;; request edge-precise analysis when constructing their handle.
      (io.panic "regalloc: missing edge-precise liveness handle")]))

(defstruct CompilerRegActive
  (var i64)
  (end i64)
  (reg i64))

;; Linear-scan active set: a contiguous run sorted by (end, var) ascending.
(defstruct CompilerRegActiveSeq
  (slots (__tl_dyn-array CompilerRegActive))
  (len i64))

;; One accepted per-call-region placement (M-G2b): a spilled call-spanning
;; root `var` is homed in its shadow caller-saved register over the point
;; range [lo,hi] -- the inclusive point coords of the first/last coalesce-class
;; reference inside ONE kind-0-clobber-free run of ONE block. The backend
;; caller-save rewrite mints a register-homed segment var W for the range,
;; remaps every class reference in it to W, and materializes the boundary
;; movs: `Mov W <- var` at lo when entry = 1 (the value is live INTO the
;; region), and `Mov var <- W` after hi when exit = 1 (the region redefines
;; the value AND it lives past the region). The home slot stays the
;; authoritative cross-call location everywhere outside the region.
(defenum CompilerRegCallRegion
  (CompilerRegCallRegion i64 i64 i64 i64 i64))

;; Accepted placements in ACCEPT order; consumers walk it back to front, which
;; is the order the former prepend-built cons list presented.
(defstruct CompilerRegCallRegionSeq
  (slots (__tl_dyn-array CompilerRegCallRegion))
  (len i64))

;; P11b phase 3 (loop-scope EVICTION): one materialization step for a PARKED
;; occupant whose pool register was lent to a hot loop invariant.
;;
;; A parked occupant O is a value the plan homes in register R whose live range
;; COVERS a rescue region but which is never mentioned inside it -- a value
;; computed before the loop and read after it. Lending R to the region's
;; invariant costs exactly one store of O at the region anchor plus one reload
;; per region exit edge on which O is still live; no in-region traffic at all,
;; which is what separates this from ordinary spilling.
;;
;;   kind = save    (0): at `point`, `Mov S <- O` into a fresh slot-homed var S
;;                       minted by the rewrite. Emitted BEFORE the region's own
;;                       activation mov, which is what frees R for the shadow.
;;   kind = restore (1): at `point`, `Mov O <- S` -- R gets O's value back.
;;
;; `point` is in the same instruction-point space as the regions, and both
;; kinds insert BEFORE the instruction at that point.
(defenum CompilerRegCallEvict
  (CompilerRegCallEvict i64 i64 i64))

;; Eviction steps in RECORD order (saves precede their restores per victim).
(defstruct CompilerRegCallEvictSeq
  (slots (__tl_dyn-array CompilerRegCallEvict))
  (len i64))

(define (compiler-reg-call-evict-kind-save) : i64
  0)

(define (compiler-reg-call-evict-kind-restore) : i64
  1)

(define (compiler-reg-call-evict-seq-empty) : CompilerRegCallEvictSeq
  (CompilerRegCallEvictSeq (array.make-array CompilerRegCallEvict 0) 0))

(define (compiler-reg-call-evict-seq-push
  [seq : CompilerRegCallEvictSeq]
  [item : CompilerRegCallEvict]) : CompilerRegCallEvictSeq
  (let
    [slots : (__tl_dyn-array CompilerRegCallEvict) seq.slots]
    [len : i64 seq.len]
    [cap : i64 (array-length slots)]
    (if (< len cap)
      (begin
        (set! (array-ref slots len) item)
        (CompilerRegCallEvictSeq slots (+ len 1)))
      (let
        [grown : (__tl_dyn-array CompilerRegCallEvict)
          (array.make-array
            CompilerRegCallEvict
            (if (< cap 4)
              4
              (* cap 2)))]
        [i : i64 0]
        (begin
          (while (< i len)
            (begin
              (set! (array-ref grown i) (array-ref slots i))
              (set! i (+ i 1))))
          (set! (array-ref grown len) item)
          (CompilerRegCallEvictSeq grown (+ len 1)))))))

;; Call-spanning split result: the shadow (split) var set, a per-var map
;; (var-id -> caller-saved register ID for its call-free regions, -1 = none),
;; the accepted per-call-region placements the backend rewrite realizes, and
;; the parked-occupant eviction steps those placements depend on.
;; The regs map generalizes the former single hardcoded %r9 so multiple
;; OVERLAPPING call-spanning values can each be kept in a distinct caller-saved
;; register between the same calls.
(defenum CompilerRegCallSplit
  (CompilerRegCallSplit
    live.CompilerLiveI64Set
    (__tl_dyn-array i64)
    CompilerRegCallRegionSeq
    CompilerRegCallEvictSeq))

(define (compiler-reg-call-split-shadows [s : CompilerRegCallSplit]) : live.CompilerLiveI64Set
  (match s
    [(CompilerRegCallSplit shadows _ _ _) shadows]))

(define (compiler-reg-call-split-regs [s : CompilerRegCallSplit]) : (__tl_dyn-array
    i64)
  (match s
    [(CompilerRegCallSplit _ regs _ _) regs]))

(define (compiler-reg-call-split-regions [s : CompilerRegCallSplit]) : CompilerRegCallRegionSeq
  (match s
    [(CompilerRegCallSplit _ _ regions _) regions]))

(define (compiler-reg-call-split-evictions [s : CompilerRegCallSplit]) : CompilerRegCallEvictSeq
  (match s
    [(CompilerRegCallSplit _ _ _ evictions) evictions]))

(define (compiler-reg-call-region-seq-empty) : CompilerRegCallRegionSeq
  (CompilerRegCallRegionSeq (array.make-array CompilerRegCallRegion 0) 0))

(define (compiler-reg-call-split-empty) : CompilerRegCallSplit
  (CompilerRegCallSplit
    (live.compiler-live-set-empty)
    (array.make-array i64 0)
    (compiler-reg-call-region-seq-empty)
    (compiler-reg-call-evict-seq-empty)))

;; SplitKit occupant-liberation record (design 3.2): to free a callee-saved
;; register R for a call-spanning value V across its crossing region, a cold
;; through-occupant O of R is split -- stored to its slot before the region and
;; reloaded after -- so R is free over [region-start,region-end). Fields:
;;   occupant var O, region start, region end (point coords), the freed CSR
;;   register, and O's stack slot offset (store-before / reload-after home).
;; Carried by the split plan; the array stays empty until M5 turns the
;; live-occupant lever on.
(defenum CompilerRegOccupantSplit
  (CompilerRegOccupantSplit i64 i64 i64 i64 i64))

;; SplitKit per-sub-range value model (design 1.2). Produced by the greedy and
;; threaded through CompilerRegPlan: a spilled call-spanning value V keeps its
;; canonical stack slot while its live range partitions at call boundaries into
;; register sub-ranges (future minted pieces V_i + boundary copies) and slot
;; sub-ranges. Indexed by piece var id:
;;   piece-of[V_i]        -- original root V of a minted piece; -1 for non-pieces
;;   piece-start/-end     -- V_i's sub-range [start,end) in point coords
;;   piece-reg[V_i]       -- physreg ID the worklist gave V_i (-1 = spilled)
;;   piece-writeback[V_i] -- 1 iff V is redefined inside V_i (needs the OUT copy)
;;   occupant-split       -- the freed-CSR store/reload plans (design 3.2)
;; M1 threads an EMPTY (budget-0) plan: no pieces are minted and nothing consumes
;; it, so allocation and emission are unchanged until M2+ populate it.
(defstruct CompilerRegSplitPlan
  (piece-of (__tl_dyn-array i64))
  (piece-start (__tl_dyn-array i64))
  (piece-end (__tl_dyn-array i64))
  (piece-reg (__tl_dyn-array i64))
  (piece-writeback (__tl_dyn-array i64))
  (occupant-split (__tl_dyn-array CompilerRegOccupantSplit)))

(defenum CompilerRegPlan
  (Plan
    CompilerRegAssignmentTable
    live.CompilerLiveI64Set
    CompilerRegIntervalSeq
    CompilerRegVarTypes
    CompilerRegCallSplit
    CompilerRegSplitPlan))

(defenum CompilerRegAssignState
  (State CompilerRegActiveSeq CompilerRegAssignmentTable))

(defenum CompilerRegCallSaveAssignState
  (State CompilerRegAssignmentTable CompilerRegCallSplit))

(defenum CompilerRegCallSaveRewrite
  (Rewrite
    ir.CompilerIrBlockList
    i64
    i64
    CompilerRegAssignmentTable
    CompilerRegVarTypes))

;; Per-instruction rewrite state for rematerialization. The rewritten
;; instructions themselves are not carried here: they are pushed straight into
;; a caller-owned `CompilerIrInstrBuilder` threaded `(&mut ...)` through the
;; walk, so the payload is only the scalars and lists that thread forward
;; (emit point, next var id, and the extra assignment/type overlays remat grows).
(defenum CompilerRegCallSaveInstrRewrite
  (Rewrite i64 i64 CompilerRegAssignmentTable CompilerRegVarTypes))

;; Conservative cold-call clobber splitting happens before scalar allocation.
;; `temp-start` is the first synthetic stack-home used to carry a protected GP
;; value across the cold call, or -1 when the input function was returned
;; unchanged.  The rewritten function is the single source of truth for both
;; liveness and emission.
(defenum CompilerRegColdCallRewrite
  (Rewrite ir.CompilerIrFunction i64))

(defenum CompilerRegColdCallCandidate
  (NoCandidate)
  (Candidate i64 i64))

;; Form (a) early-exit shrink wrapping is also an IR rewrite before scalar
;; allocation. These per-function results accompany the returned function;
;; empty labels mean the input was unchanged. Backend emission is sequential,
;; including its FPO retry, so the state is reset by every rewrite call.
(define compiler-reg-early-exit-saving-label : i64
  -1)
(define compiler-reg-early-exit-bare-label : String
  "")
(define compiler-reg-early-exit-prefix-count : i64
  0)

(define (compiler-reg-early-exit-bare-label-current) : String
  (string.copy (& compiler-reg-early-exit-bare-label)))

(define (compiler-reg-early-exit-saving-label-current) : i64
  compiler-reg-early-exit-saving-label)

(define (compiler-reg-early-exit-prefix-count-current) : i64
  compiler-reg-early-exit-prefix-count)

(define (compiler-reg-early-exit-state-reset!) : unit
  (begin
    (set! compiler-reg-early-exit-saving-label (ir.compiler-ir-label-none))
    (set! compiler-reg-early-exit-bare-label "")
    (set! compiler-reg-early-exit-prefix-count 0)))

(define (compiler-reg-cold-call-rewrite-function-value
  [rewrite : CompilerRegColdCallRewrite]) : ir.CompilerIrFunction
  (match rewrite
    [(CompilerRegColdCallRewrite.Rewrite func _) func]))

(define (compiler-reg-cold-call-rewrite-temp-start
  [rewrite : CompilerRegColdCallRewrite]) : i64
  (match rewrite
    [(CompilerRegColdCallRewrite.Rewrite _ temp-start) temp-start]))

(defstruct CompilerRegRematTable
  (def-counts (__tl_dyn-array i64))
  (candidates (__tl_dyn-array i64))
  (kinds (__tl_dyn-array i64))
  (values (__tl_dyn-array ir.CompilerIrValue))
  (offsets (__tl_dyn-array ir.CompilerIrValue))
  (op-types (__tl_dyn-array ast.AstType))
  (types (__tl_dyn-array ast.AstType)))

(define (compiler-reg-remat-kind-mov) : i64
  1)

(define (compiler-reg-remat-kind-load) : i64
  2)

(define (compiler-reg-remat-kind-gep) : i64
  3)

(defenum CompilerRegEdgeCopyDirection
  (IntoRegion)
  (OutOfRegion))

(defenum CompilerRegEdgeCopyPlacement
  (PredEnd)
  (SuccEntry))

(defenum CompilerRegEdgeCopy
  (Copy
    i64
    i64
    i64
    i64
    ast.AstType
    CompilerRegEdgeCopyDirection
    CompilerRegEdgeCopyPlacement))

;; Boundary copies in plan order (the order the former reverse-at-the-end cons
;; accumulator produced), so consumers walk it front to back.
(defstruct CompilerRegEdgeCopySeq
  (slots (__tl_dyn-array CompilerRegEdgeCopy))
  (len i64))

(defenum CompilerRegEdgeCopyPlacementResult
  (Ok CompilerRegEdgeCopyPlacement)
  (Refused String))

(defenum CompilerRegEdgeCopyPlan
  (Plan CompilerRegEdgeCopySeq)
  (Refused String))

(defenum CompilerRegEdgeCopyRewrite
  (Rewrite ir.CompilerIrBlockList)
  (Refused String))

;; A loop-split rescue candidate. The region is a dense sequence of block labels: a single
;; label for the single-block (read-only / non-phi self-loop / step-2 single-block)
;; paths, or the whole natural-loop block range for the step-2 MULTI-BLOCK
;; phi-carried homing. apply-candidate remaps every region block and the edge-copy
;; plan (already multi-block aware) places boundary copies at the region edges.
(defenum CompilerRegLoopSplitCandidate
  (NoCandidate)
  (Candidate i64 CompilerRegLabelSeq ast.AstType i64 CompilerRegEdgeCopySeq i64))

(defenum CompilerRegLeafCsrSplitCandidate
  (NoCandidate)
  (Candidate
    i64
    CompilerRegLabelSeq
    ast.AstType
    i64
    i64
    CompilerRegEdgeCopySeq
    i64))

(defstruct CompilerRegLeafCsrFuseFacts
  (uses i64)
  (free-branches i64))

(defenum CompilerRegLoopSplitRewriteResult
  (Result CompilerRegCallSaveRewrite i64))

;; Result of the eviction-aware register pick (below): a candidate register `r`
;; together with the strictly-lower-weight var to evict (re-spill) so `r` becomes
;; free over the loop region, or None when no such register exists.
(defenum CompilerRegLoopSplitEvict
  (CompilerRegLoopSplitEvictNone)
  (CompilerRegLoopSplitEvict i64 i64))

(defenum CompilerRegParamAssignPlan
  (Plan
    CompilerRegAssignmentTable
    live.CompilerLiveI64Set
    live.CompilerLiveI64Set))

(cfg
  (any regalloc-census test)
  (defstruct CompilerRegCallSpanCensus
    (counts (__tl_dyn-array i64))))

(defstruct CompilerRegMove
  (src i64)
  (dst i64)
  (strict bool))

;; Coalesce move candidates in ADD order. The former cons list was built by
;; prepending, so its head was the newest entry: every order-sensitive consumer
;; below (mark-strict, class merging, first-wins copy hints) walks index
;; `len - 1` down to 0.
(defstruct CompilerRegMoveSeq
  (slots (__tl_dyn-array CompilerRegMove))
  (len i64))

;; Deterministic move-copy classes used by scalar home coalescing. Roots are the
;; lowest var id in each class; allocation then reuses any assigned class home.
(defstruct CompilerRegCoalesceMap
  (parents (__tl_dyn-array i64)))

(define (compiler-reg-id-seq-empty) : CompilerRegIdSeq
  (CompilerRegIdSeq (array.make-array i64 0) 0))

(define (compiler-reg-id-seq-with-capacity [capacity : i64]) : CompilerRegIdSeq
  (CompilerRegIdSeq (array.make-array i64 capacity) 0))

(defmacro (compiler-reg-id-seq-count [items : CompilerRegIdSeq]) : i64
  `(__tl-project-field-name ,items "len"))

(defmacro (compiler-reg-id-seq-empty? [items : CompilerRegIdSeq]) : bool
  `(= (__tl-project-field-name ,items "len") 0))

(defmacro (compiler-reg-id-seq-ref [items : CompilerRegIdSeq] [index : i64]) : i64
  `(array-ref (__tl-project-field-name ,items "slots") ,index))

(define (compiler-reg-id-seq-push [items : CompilerRegIdSeq] [item : i64]) : CompilerRegIdSeq
  (let
    [slots : (__tl_dyn-array i64) items.slots]
    [len : i64 items.len]
    (begin
      (if (< len (array-length slots))
        unit
        (let
          [bigger : (__tl_dyn-array i64)
            (array.make-array
              i64
              (if (< (array-length slots) 4)
                4
                (* (array-length slots) 2)))]
          [index : i64 0]
          (begin
            (while (< index len)
              (begin
                (set! (array-ref bigger index) (array-ref slots index))
                (set! index (+ index 1))))
            (set! slots bigger))))
      (set! (array-ref slots len) item)
      (CompilerRegIdSeq slots (+ len 1)))))

;; Persistent prepend for cold one/few-element constraint extension. Retained
;; parent sequences remain exact; bulk producers use a capacity-sized builder
;; and `push` instead of repeatedly copying prefixes.
(define (compiler-reg-id-seq-prepend [head : i64] [rest : CompilerRegIdSeq]) : CompilerRegIdSeq
  (let
    [len : i64 (compiler-reg-id-seq-count rest)]
    [out : CompilerRegIdSeq (compiler-reg-id-seq-with-capacity (+ len 1))]
    [index : i64 0]
    (begin
      (set! out (compiler-reg-id-seq-push out head))
      (while (< index len)
        (begin
          (set!
            out
            (compiler-reg-id-seq-push out (compiler-reg-id-seq-ref rest index)))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-label-seq-empty) : CompilerRegLabelSeq
  (CompilerRegLabelSeq (array.make-array i64 0) 0))

(define (compiler-reg-label-seq-with-capacity [capacity : i64]) : CompilerRegLabelSeq
  (CompilerRegLabelSeq (array.make-array i64 capacity) 0))

(defmacro (compiler-reg-label-seq-count [items : CompilerRegLabelSeq]) : i64
  `(__tl-project-field-name ,items "len"))

(defmacro (compiler-reg-label-seq-ref
  [items : CompilerRegLabelSeq]
  [index : i64]) : i64
  `(array-ref (__tl-project-field-name ,items "slots") ,index))

(define (compiler-reg-label-seq-push [items : CompilerRegLabelSeq] [item : i64]) : CompilerRegLabelSeq
  (let
    [slots : (__tl_dyn-array i64) items.slots]
    [len : i64 items.len]
    (begin
      (if (< len (array-length slots))
        unit
        (let
          [bigger : (__tl_dyn-array i64)
            (array.make-array
              i64
              (if (< (array-length slots) 4)
                4
                (* (array-length slots) 2)))]
          [index : i64 0]
          (begin
            (while (< index len)
              (begin
                (set! (array-ref bigger index) (array-ref slots index))
                (set! index (+ index 1))))
            (set! slots bigger))))
      (set! (array-ref slots len) item)
      (CompilerRegLabelSeq slots (+ len 1)))))

(define (compiler-reg-label-seq-prepend
  [head : i64]
  [rest : CompilerRegLabelSeq]) : CompilerRegLabelSeq
  (let
    [len : i64 (compiler-reg-label-seq-count rest)]
    [out : CompilerRegLabelSeq (compiler-reg-label-seq-with-capacity (+ len 1))]
    [index : i64 0]
    (begin
      (set! out (compiler-reg-label-seq-push out head))
      (while (< index len)
        (begin
          (set!
            out
            (compiler-reg-label-seq-push
              out
              (compiler-reg-label-seq-ref rest index)))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-string-prefix? [text : String] [prefix : String]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [prefix-len : i64 (string.string-length prefix)]
    (if (> prefix-len text-len)
      false
      (string.eq (string.substring text 0 prefix-len) prefix))))

(define (compiler-reg-spmd-varying-param? [name : String]) : bool
  (compiler-reg-string-prefix? name "__tl_spmd_varying_arg_"))

(define (compiler-reg-spmd-mask-param? [name : String]) : bool
  (or
    (compiler-reg-string-prefix? name "__tl_spmd_active_mask")
    (compiler-reg-string-prefix? name "__tl_spmd_mask_arg_")))

(define (compiler-reg-assignments-prepend
  [head : CompilerRegAssignment]
  [rest : CompilerRegAssignmentTable]) : CompilerRegAssignmentTable
  ;; Cold fixture/overlay builder. Preserve the old persistent-prepend
  ;; ownership contract by copying before overriding `head.var`; production
  ;; allocator mutations use compiler-reg-assignment-table-insert directly.
  (compiler-reg-assignment-insert rest head.var head.location))

;; Capacity for a seq that must hold `len + 1` elements; the caller copies the
;; live prefix into a fresh array of this size when the current one is full.
(define (compiler-reg-seq-grown-capacity [cap : i64]) : i64
  (if (< cap 4)
    4
    (* cap 2)))

(define (compiler-reg-interval-seq-empty) : CompilerRegIntervalSeq
  (CompilerRegIntervalSeq (array.make-array CompilerRegInterval 0) 0))

(define (compiler-reg-interval-seq-with-capacity [capacity : i64]) : CompilerRegIntervalSeq
  (CompilerRegIntervalSeq (array.make-array CompilerRegInterval capacity) 0))

(defmacro (compiler-reg-interval-seq-count [items : CompilerRegIntervalSeq]) : i64
  `(__tl-project-field-name ,items "len"))

(defmacro (compiler-reg-interval-seq-empty? [items : CompilerRegIntervalSeq]) : bool
  `(= (__tl-project-field-name ,items "len") 0))

(defmacro (compiler-reg-interval-seq-ref
  [items : CompilerRegIntervalSeq]
  [index : i64]) : CompilerRegInterval
  `(array-ref (__tl-project-field-name ,items "slots") ,index))

(define (compiler-reg-interval-seq-grow [items : CompilerRegIntervalSeq]) : CompilerRegIntervalSeq
  (let
    [slots : (__tl_dyn-array CompilerRegInterval) items.slots]
    [len : i64 items.len]
    ;; Most per-variable segment sequences contain one interval.  Start at one
    ;; slot so their dense backing arrays do not zero three unused interval
    ;; records; subsequent growth remains geometric.
    [capacity : i64
      (if (= (array-length slots) 0)
        1
        (* (array-length slots) 2))]
    [bigger : (__tl_dyn-array CompilerRegInterval)
      (array.make-array CompilerRegInterval capacity)]
    [index : i64 0]
    (begin
      (while (< index len)
        (begin
          (set! (array-ref bigger index) (array-ref slots index))
          (set! index (+ index 1))))
      (CompilerRegIntervalSeq bigger len))))

(define (compiler-reg-interval-seq-prepend
  [head : CompilerRegInterval]
  [rest : CompilerRegIntervalSeq]) : CompilerRegIntervalSeq
  (let
    [len : i64 rest.len]
    [old-slots : (__tl_dyn-array CompilerRegInterval) rest.slots]
    [capacity : i64
      (if (> (array-length old-slots) len)
        (array-length old-slots)
        (if (= (array-length old-slots) 0)
          1
          (* (array-length old-slots) 2)))]
    [slots : (__tl_dyn-array CompilerRegInterval)
      (array.make-array CompilerRegInterval capacity)]
    [index : i64 0]
    (begin
      ;; Prepend is intentionally persistent: some cold fixture/worklist
      ;; builders retain `rest`, so shifting its shared backing array would
      ;; mutate that still-live view.
      (set! (array-ref slots 0) head)
      (while (< index len)
        (begin
          (set! (array-ref slots (+ index 1)) (array-ref old-slots index))
          (set! index (+ index 1))))
      (CompilerRegIntervalSeq slots (+ len 1)))))

(define (compiler-reg-interval-seq-append
  [items : CompilerRegIntervalSeq]
  [item : CompilerRegInterval]) : CompilerRegIntervalSeq
  (let
    [ready : CompilerRegIntervalSeq
      (if (>= items.len (array-length items.slots))
        (compiler-reg-interval-seq-grow items)
        items)]
    [slots : (__tl_dyn-array CompilerRegInterval) ready.slots]
    [len : i64 ready.len]
    (begin
      (set! (array-ref slots len) item)
      (CompilerRegIntervalSeq slots (+ len 1)))))

(define (compiler-reg-interval-seq-append-all
  [items : CompilerRegIntervalSeq]
  [suffix : CompilerRegIntervalSeq]) : CompilerRegIntervalSeq
  (let
    [out : CompilerRegIntervalSeq items]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-interval-seq-count suffix))
        (begin
          (set!
            out
            (compiler-reg-interval-seq-append
              out
              (compiler-reg-interval-seq-ref suffix index)))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-edge-copy-seq-empty) : CompilerRegEdgeCopySeq
  (CompilerRegEdgeCopySeq (array.make-array CompilerRegEdgeCopy 0) 0))

(define (compiler-reg-edge-copy-seq-push
  [copies : CompilerRegEdgeCopySeq]
  [item : CompilerRegEdgeCopy]) : CompilerRegEdgeCopySeq
  (let
    [slots : (__tl_dyn-array CompilerRegEdgeCopy) copies.slots]
    [len : i64 copies.len]
    (begin
      (if (< len (array-length slots))
        unit
        (let
          [bigger : (__tl_dyn-array CompilerRegEdgeCopy)
            (array.make-array
              CompilerRegEdgeCopy
              (compiler-reg-seq-grown-capacity (array-length slots)))]
          [i : i64 0]
          (begin
            (while (< i len)
              (begin
                (set! (array-ref bigger i) (array-ref slots i))
                (set! i (+ i 1))))
            (set! slots bigger))))
      (set! (array-ref slots len) item)
      (CompilerRegEdgeCopySeq slots (+ len 1)))))

(define (compiler-reg-active-seq-empty) : CompilerRegActiveSeq
  (CompilerRegActiveSeq (array.make-array CompilerRegActive 0) 0))

(define (compiler-reg-move-seq-empty) : CompilerRegMoveSeq
  (CompilerRegMoveSeq (array.make-array CompilerRegMove 0) 0))

(define (compiler-reg-move-seq-push
  [moves : CompilerRegMoveSeq]
  [item : CompilerRegMove]) : CompilerRegMoveSeq
  (let
    [slots : (__tl_dyn-array CompilerRegMove) moves.slots]
    [len : i64 moves.len]
    (begin
      (if (< len (array-length slots))
        unit
        (let
          [bigger : (__tl_dyn-array CompilerRegMove)
            (array.make-array
              CompilerRegMove
              (compiler-reg-seq-grown-capacity (array-length slots)))]
          [i : i64 0]
          (begin
            (while (< i len)
              (begin
                (set! (array-ref bigger i) (array-ref slots i))
                (set! i (+ i 1))))
            (set! slots bigger))))
      (set! (array-ref slots len) item)
      (CompilerRegMoveSeq slots (+ len 1)))))

(define (compiler-reg-call-region-seq-push
  [regions : CompilerRegCallRegionSeq]
  [item : CompilerRegCallRegion]) : CompilerRegCallRegionSeq
  (let
    [slots : (__tl_dyn-array CompilerRegCallRegion) regions.slots]
    [len : i64 regions.len]
    (begin
      (if (< len (array-length slots))
        unit
        (let
          [bigger : (__tl_dyn-array CompilerRegCallRegion)
            (array.make-array
              CompilerRegCallRegion
              (compiler-reg-seq-grown-capacity (array-length slots)))]
          [i : i64 0]
          (begin
            (while (< i len)
              (begin
                (set! (array-ref bigger i) (array-ref slots i))
                (set! i (+ i 1))))
            (set! slots bigger))))
      (set! (array-ref slots len) item)
      (CompilerRegCallRegionSeq slots (+ len 1)))))

(define (compiler-reg-call-region-stat-seq-empty) : CompilerRegCallRegionStatSeq
  (CompilerRegCallRegionStatSeq
    (array.make-array CompilerRegCallRegionStat 0)
    0))

(define (compiler-reg-call-region-stat-seq-push
  [rows : CompilerRegCallRegionStatSeq]
  [item : CompilerRegCallRegionStat]) : CompilerRegCallRegionStatSeq
  (let
    [slots : (__tl_dyn-array CompilerRegCallRegionStat) rows.slots]
    [len : i64 rows.len]
    (begin
      (if (< len (array-length slots))
        unit
        (let
          [bigger : (__tl_dyn-array CompilerRegCallRegionStat)
            (array.make-array
              CompilerRegCallRegionStat
              (compiler-reg-seq-grown-capacity (array-length slots)))]
          [i : i64 0]
          (begin
            (while (< i len)
              (begin
                (set! (array-ref bigger i) (array-ref slots i))
                (set! i (+ i 1))))
            (set! slots bigger))))
      (set! (array-ref slots len) item)
      (CompilerRegCallRegionStatSeq slots (+ len 1)))))

(define (compiler-reg-max [a : i64] [b : i64]) : i64
  (if (> a b)
    a
    b))

(define (compiler-reg-stack-slot-offset [var : i64]) : i64
  (- 0 (* 8 (+ var 1))))

;; Allocatable integer register pool. Only callee-saved registers are admitted
;; by the primary pass:
;; a value whose live interval spans a call keeps its home across that call
;; because the callee preserves these registers, so no spill/reload around the
;; call is needed. The former pool also offered %r8/%r9, which are caller-saved
;; under both SysV and Win64 and are clobbered by an intervening call — a value
;; homed there and read after the call (e.g. the first operand of `(+ a (f))`)
;; would silently observe garbage. The five registers below are exactly those
;; the backend prologue/epilogue save and restore. Mirrors the former Rust
;; backend's `SYSV_ALLOCATABLE_INTEGER_REGS` (callee-saved only).
;;
;; %rbx is callee-saved under both SysV and Win64 and was historically reserved
;; as the backend's hard scratch register for the right-hand operand of integer
;; binops/compares/gep/div/shift. That fixed scratch role moved under the
;; scavenger, freeing %rbx to join the callee-saved pool. It is added LAST so
;; functions needing four or fewer registers keep their previous r12-r15 homes;
;; %rbx only homes a value once the four call-safe registers are exhausted, and
;; when it does the backend prologue/epilogue saves/restores it into a frame slot
;; exactly like r12-r15.
(define (compiler-reg-sysv-integer-registers) : CompilerRegIdSeq
  (let
    [out : CompilerRegIdSeq (compiler-reg-id-seq-with-capacity 5)]
    (begin
      (set! out (compiler-reg-id-seq-push out cabi.compiler-reg-id-r12))
      (set! out (compiler-reg-id-seq-push out cabi.compiler-reg-id-r13))
      (set! out (compiler-reg-id-seq-push out cabi.compiler-reg-id-r14))
      (set! out (compiler-reg-id-seq-push out cabi.compiler-reg-id-r15))
      (set! out (compiler-reg-id-seq-push out cabi.compiler-reg-id-rbx))
      out)))

;; M-G3 stage 2 / Win64 FPO: %rbp as the last callee-saved pool register. Only
;; enabled per-function by the backend (compiler-reg-set-rbp-pool-enabled!) when
;; the function is frame-pointer-omission eligible: the prologue then addresses
;; the frame purely rsp-relative, freeing %rbp to home a value like every other
;; nonvolatile register. %rbp is added LAST in each ABI pool so lower-pressure
;; functions keep their existing assignments.
;; The flag defaults to false, so every non-backend planning path (regalloc unit
;; tests, SIMD/AVX config, stack-only plans) sees the historical 14-register pool.
(define compiler-reg-rbp-pool-enabled : bool
  false)

(define (compiler-reg-set-rbp-pool-enabled! [on : bool]) : unit
  (set! compiler-reg-rbp-pool-enabled on))

(define (compiler-reg-sysv-integer-registers-with-rbp) : CompilerRegIdSeq
  (let
    [out : CompilerRegIdSeq (compiler-reg-id-seq-with-capacity 6)]
    (begin
      (set! out (compiler-reg-id-seq-push out cabi.compiler-reg-id-r12))
      (set! out (compiler-reg-id-seq-push out cabi.compiler-reg-id-r13))
      (set! out (compiler-reg-id-seq-push out cabi.compiler-reg-id-r14))
      (set! out (compiler-reg-id-seq-push out cabi.compiler-reg-id-r15))
      (set! out (compiler-reg-id-seq-push out cabi.compiler-reg-id-rbx))
      (set! out (compiler-reg-id-seq-push out cabi.compiler-reg-id-rbp))
      out)))

;; Conservative caller-saved extension for the scalar opt2 pass. These registers
;; are caller-saved on both SysV and Win64, are not callee-saved registers that
;; would need prologue/epilogue save/restore, and are used only for intervals
;; that do not span a modeled backend caller-clobber point. This legacy helper is
;; intentionally the three-register subset; the unified greedy pool owns
;; %r10/%r11/%r8 behind the same clobber filter.
(define (compiler-reg-zero-call-caller-saved-integer-registers) : CompilerRegIdSeq
  (let
    [out : CompilerRegIdSeq (compiler-reg-id-seq-with-capacity 3)]
    (begin
      (set! out (compiler-reg-id-seq-push out cabi.compiler-reg-id-r9))
      (set! out (compiler-reg-id-seq-push out cabi.compiler-reg-id-rcx))
      (set! out (compiler-reg-id-seq-push out cabi.compiler-reg-id-rdx))
      out)))

(define (compiler-reg-caller-saved-integer-registers-from-abi
  [target-abi : cabi.CompilerRegTargetAbi]
  [idx : i64]) : CompilerRegIdSeq
  (let
    [count : i64 (cabi.compiler-abi-caller-saved-gp-register-count target-abi)]
    [index : i64 idx]
    [out : CompilerRegIdSeq
      (compiler-reg-id-seq-with-capacity
        (if (< idx count)
          (- count idx)
          0))]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (compiler-reg-id-seq-push
              out
              (cabi.compiler-abi-caller-saved-gp-register-id target-abi index)))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-callee-saved-integer-registers-from-abi
  [target-abi : cabi.CompilerRegTargetAbi]
  [idx : i64]) : CompilerRegIdSeq
  (let
    [count : i64 (cabi.compiler-abi-callee-saved-gp-register-count target-abi)]
    [index : i64 idx]
    [out : CompilerRegIdSeq
      (compiler-reg-id-seq-with-capacity
        (if (< idx count)
          (- count idx)
          0))]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (compiler-reg-id-seq-push
              out
              (cabi.compiler-abi-callee-saved-gp-register-id target-abi index)))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-sysv-caller-saved-integer-registers) : CompilerRegIdSeq
  (compiler-reg-caller-saved-integer-registers-from-abi
    cabi.CompilerRegTargetAbi.Linux
    0))

(define (compiler-reg-sysv-callee-saved-integer-registers) : CompilerRegIdSeq
  (compiler-reg-callee-saved-integer-registers-from-abi
    cabi.CompilerRegTargetAbi.Linux
    0))

(define (compiler-reg-win64-caller-saved-integer-registers) : CompilerRegIdSeq
  (compiler-reg-caller-saved-integer-registers-from-abi
    cabi.CompilerRegTargetAbi.Windows
    0))

(define (compiler-reg-win64-callee-saved-integer-registers) : CompilerRegIdSeq
  (compiler-reg-callee-saved-integer-registers-from-abi
    cabi.CompilerRegTargetAbi.Windows
    0))

(define (compiler-reg-id-seq-append
  [left : CompilerRegIdSeq]
  [right : CompilerRegIdSeq]) : CompilerRegIdSeq
  (let
    [left-len : i64 (compiler-reg-id-seq-count left)]
    [right-len : i64 (compiler-reg-id-seq-count right)]
    [out : CompilerRegIdSeq
      (compiler-reg-id-seq-with-capacity (+ left-len right-len))]
    [index : i64 0]
    (begin
      (while (< index left-len)
        (begin
          (set!
            out
            (compiler-reg-id-seq-push out (compiler-reg-id-seq-ref left index)))
          (set! index (+ index 1))))
      (set! index 0)
      (while (< index right-len)
        (begin
          (set!
            out
            (compiler-reg-id-seq-push out (compiler-reg-id-seq-ref right index)))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-id-seq-push-all
  [out0 : CompilerRegIdSeq]
  [items : CompilerRegIdSeq]) : CompilerRegIdSeq
  (let
    [out : CompilerRegIdSeq out0]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-id-seq-count items))
        (begin
          (set!
            out
            (compiler-reg-id-seq-push out (compiler-reg-id-seq-ref items index)))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-callee-saved-integer-registers-for-abi
  [target-abi : cabi.CompilerRegTargetAbi]) : CompilerRegIdSeq
  (match target-abi
    [(cabi.CompilerRegTargetAbi.Linux) (compiler-reg-sysv-integer-registers)]
    [(cabi.CompilerRegTargetAbi.Windows)
      (compiler-reg-win64-callee-saved-integer-registers)]))

(define (compiler-reg-callee-saved-integer-register-count-for-abi
  [target-abi : cabi.CompilerRegTargetAbi]) : i64
  (compiler-reg-id-seq-count
    (compiler-reg-callee-saved-integer-registers-for-abi target-abi)))

;; Under scratch-vreg, every XMM-family register is allocator-owned. Volatile
;; registers form the prefix and ABI-nonvolatile registers form the suffix, so
;; the greedy clobber constraint can restrict call-spanning values to the suffix.
;; ABI-fixed argument/result uses and instruction-selection temporaries are
;; represented by preferences, clobber points, or bounded scratch requirements.
;; The default-off path retains XMM0/XMM1 as reserved backend scratch until the
;; scratch-vreg cutover.
(define (compiler-reg-low-xmm-allocatable?) : bool
  (cfg scratch-vreg true false))

(define (compiler-reg-xmm-class-register [reg : i64] [vector : bool]) : i64
  (cabi.compiler-abi-register-with-vector-class reg vector))

(define (compiler-reg-xmm-caller-registers-for-abi-range
  [target-abi : cabi.CompilerRegTargetAbi]
  [idx : i64]
  [end : i64]
  [vector : bool]) : CompilerRegIdSeq
  (let
    [limit : i64
      (if (< end (cabi.compiler-abi-caller-saved-xmm-register-count target-abi))
        end
        (cabi.compiler-abi-caller-saved-xmm-register-count target-abi))]
    [index : i64 idx]
    [out : CompilerRegIdSeq
      (compiler-reg-id-seq-with-capacity
        (if (< idx limit)
          (- limit idx)
          0))]
    (begin
      (while (< index limit)
        (begin
          (if (and (not (compiler-reg-low-xmm-allocatable?)) (< index 2))
            unit
            (set!
              out
              (compiler-reg-id-seq-push
                out
                (compiler-reg-xmm-class-register
                  (cabi.compiler-abi-caller-saved-xmm-register-id
                    target-abi
                    index)
                  vector))))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-xmm-caller-registers-for-abi-from
  [target-abi : cabi.CompilerRegTargetAbi]
  [idx : i64]
  [vector : bool]) : CompilerRegIdSeq
  (compiler-reg-xmm-caller-registers-for-abi-range
    target-abi
    idx
    (cabi.compiler-abi-caller-saved-xmm-register-count target-abi)
    vector))

(define (compiler-reg-xmm-callee-registers-for-abi-from
  [target-abi : cabi.CompilerRegTargetAbi]
  [idx : i64]
  [vector : bool]) : CompilerRegIdSeq
  (let
    [count : i64 (cabi.compiler-abi-callee-saved-xmm-register-count target-abi)]
    [index : i64 idx]
    [out : CompilerRegIdSeq
      (compiler-reg-id-seq-with-capacity
        (if (< idx count)
          (- count idx)
          0))]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (compiler-reg-id-seq-push
              out
              (compiler-reg-xmm-class-register
                (cabi.compiler-abi-callee-saved-xmm-register-id
                  target-abi
                  index)
                vector)))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-xmm-registers-for-abi-build
  [target-abi : cabi.CompilerRegTargetAbi]) : CompilerRegIdSeq
  (compiler-reg-id-seq-append
    (compiler-reg-xmm-caller-registers-for-abi-from target-abi 0 false)
    (compiler-reg-xmm-callee-registers-for-abi-from target-abi 0 false)))

(define (compiler-reg-vector-registers-for-abi-build
  [target-abi : cabi.CompilerRegTargetAbi]) : CompilerRegIdSeq
  (match target-abi
    [(cabi.CompilerRegTargetAbi.Linux)
      ;; Preserve the established high-register vector preference, then use
      ;; XMM2-XMM5 as overflow capacity. XMM0/XMM1 stay out of the vector class
      ;; until every vector lowering has explicit scratch.
      (compiler-reg-id-seq-append
        (compiler-reg-xmm-caller-registers-for-abi-range
          target-abi
          6
          (cabi.compiler-abi-caller-saved-xmm-register-count target-abi)
          true)
        (compiler-reg-xmm-caller-registers-for-abi-range target-abi 2 6 true))]
    [(cabi.CompilerRegTargetAbi.Windows)
      ;; Keep XMM2-XMM5 as the volatile prefix before XMM6-XMM15.
      (compiler-reg-id-seq-append
        (compiler-reg-xmm-caller-registers-for-abi-range target-abi 2 6 true)
        (compiler-reg-xmm-callee-registers-for-abi-from target-abi 0 true))]))

(define compiler-reg-linux-xmm-registers : CompilerRegIdSeq
  (compiler-reg-xmm-registers-for-abi-build cabi.CompilerRegTargetAbi.Linux))
(define compiler-reg-windows-xmm-registers : CompilerRegIdSeq
  (compiler-reg-xmm-registers-for-abi-build cabi.CompilerRegTargetAbi.Windows))
(define compiler-reg-linux-vector-registers : CompilerRegIdSeq
  (compiler-reg-vector-registers-for-abi-build cabi.CompilerRegTargetAbi.Linux))
(define compiler-reg-windows-vector-registers : CompilerRegIdSeq
  (compiler-reg-vector-registers-for-abi-build
    cabi.CompilerRegTargetAbi.Windows))
(define compiler-reg-linux-xmm-callee-registers : CompilerRegIdSeq
  (compiler-reg-xmm-callee-registers-for-abi-from
    cabi.CompilerRegTargetAbi.Linux
    0
    false))
(define compiler-reg-windows-xmm-callee-registers : CompilerRegIdSeq
  (compiler-reg-xmm-callee-registers-for-abi-from
    cabi.CompilerRegTargetAbi.Windows
    0
    false))
(define compiler-reg-linux-vector-callee-registers : CompilerRegIdSeq
  (compiler-reg-xmm-callee-registers-for-abi-from
    cabi.CompilerRegTargetAbi.Linux
    0
    true))
(define compiler-reg-windows-vector-callee-registers : CompilerRegIdSeq
  (compiler-reg-xmm-callee-registers-for-abi-from
    cabi.CompilerRegTargetAbi.Windows
    0
    true))

(define (compiler-reg-xmm-registers-for-abi
  [target-abi : cabi.CompilerRegTargetAbi]) : CompilerRegIdSeq
  (match target-abi
    [(cabi.CompilerRegTargetAbi.Linux)
      (compiler-reg-global-shared-view compiler-reg-linux-xmm-registers)]
    [(cabi.CompilerRegTargetAbi.Windows)
      (compiler-reg-global-shared-view compiler-reg-windows-xmm-registers)]))

(define (compiler-reg-vector-registers-for-abi
  [target-abi : cabi.CompilerRegTargetAbi]) : CompilerRegIdSeq
  (match target-abi
    [(cabi.CompilerRegTargetAbi.Linux)
      (compiler-reg-global-shared-view compiler-reg-linux-vector-registers)]
    [(cabi.CompilerRegTargetAbi.Windows)
      (compiler-reg-global-shared-view compiler-reg-windows-vector-registers)]))

(define (compiler-reg-xmm-callee-registers-for-abi
  [target-abi : cabi.CompilerRegTargetAbi]) : CompilerRegIdSeq
  (match target-abi
    [(cabi.CompilerRegTargetAbi.Linux)
      (compiler-reg-global-shared-view compiler-reg-linux-xmm-callee-registers)]
    [(cabi.CompilerRegTargetAbi.Windows)
      (compiler-reg-global-shared-view
        compiler-reg-windows-xmm-callee-registers)]))

(define (compiler-reg-vector-callee-registers-for-abi
  [target-abi : cabi.CompilerRegTargetAbi]) : CompilerRegIdSeq
  (match target-abi
    [(cabi.CompilerRegTargetAbi.Linux)
      (compiler-reg-global-shared-view
        compiler-reg-linux-vector-callee-registers)]
    [(cabi.CompilerRegTargetAbi.Windows)
      (compiler-reg-global-shared-view
        compiler-reg-windows-vector-callee-registers)]))

(define (compiler-reg-xmm-caller-register-count-for-abi
  [target-abi : cabi.CompilerRegTargetAbi]) : i64
  (-
    (cabi.compiler-abi-caller-saved-xmm-register-count target-abi)
    (if (compiler-reg-low-xmm-allocatable?)
      0
      2)))

(define (compiler-reg-vector-caller-register-count-for-abi
  [target-abi : cabi.CompilerRegTargetAbi]) : i64
  (- (cabi.compiler-abi-caller-saved-xmm-register-count target-abi) 2))

(define (compiler-reg-xmm-registers) : CompilerRegIdSeq
  (compiler-reg-xmm-registers-for-abi cabi.CompilerRegTargetAbi.Linux))

(define (compiler-reg-xmm-family-index [reg : i64]) : i64
  (cabi.compiler-abi-register-vector-family-index reg))

(define (compiler-reg-registers-overlap? [left : i64] [right : i64]) : bool
  (cabi.compiler-abi-registers-overlap? left right))

(define (compiler-reg-mask-registers) : CompilerRegIdSeq
  (let
    [index : i64 1]
    [out : CompilerRegIdSeq (compiler-reg-id-seq-with-capacity 6)]
    (begin
      (while (<= index 6)
        (begin
          (set!
            out
            (compiler-reg-id-seq-push
              out
              (cabi.compiler-abi-mask-register-id index)))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-caller-saved-xmm-registers-from-abi
  [target-abi : cabi.CompilerRegTargetAbi]
  [idx : i64]) : CompilerRegIdSeq
  (let
    [count : i64 (cabi.compiler-abi-caller-saved-xmm-register-count target-abi)]
    [index : i64 idx]
    [out : CompilerRegIdSeq
      (compiler-reg-id-seq-with-capacity
        (if (< idx count)
          (- count idx)
          0))]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (compiler-reg-id-seq-push
              out
              (cabi.compiler-abi-caller-saved-xmm-register-id target-abi index)))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-callee-saved-xmm-registers-from-abi
  [target-abi : cabi.CompilerRegTargetAbi]
  [idx : i64]) : CompilerRegIdSeq
  (let
    [count : i64 (cabi.compiler-abi-callee-saved-xmm-register-count target-abi)]
    [index : i64 idx]
    [out : CompilerRegIdSeq
      (compiler-reg-id-seq-with-capacity
        (if (< idx count)
          (- count idx)
          0))]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (compiler-reg-id-seq-push
              out
              (cabi.compiler-abi-callee-saved-xmm-register-id target-abi index)))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-sysv-caller-saved-xmm-registers) : CompilerRegIdSeq
  (compiler-reg-caller-saved-xmm-registers-from-abi
    cabi.CompilerRegTargetAbi.Linux
    0))

(define (compiler-reg-sysv-callee-saved-xmm-registers) : CompilerRegIdSeq
  (compiler-reg-callee-saved-xmm-registers-from-abi
    cabi.CompilerRegTargetAbi.Linux
    0))

(define (compiler-reg-win64-caller-saved-xmm-registers) : CompilerRegIdSeq
  (compiler-reg-caller-saved-xmm-registers-from-abi
    cabi.CompilerRegTargetAbi.Windows
    0))

(define (compiler-reg-win64-callee-saved-xmm-registers) : CompilerRegIdSeq
  (compiler-reg-callee-saved-xmm-registers-from-abi
    cabi.CompilerRegTargetAbi.Windows
    0))

(define (compiler-reg-id-seq-contains? [regs : CompilerRegIdSeq] [want : i64]) : bool
  (let
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (< index (compiler-reg-id-seq-count regs)) (not found))
        (begin
          (if (= (compiler-reg-id-seq-ref regs index) want)
            (set! found true)
            unit)
          (set! index (+ index 1))))
      found)))

(define (compiler-reg-float-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.F64) true]
    [(ast.AstType.F32) true]
    [_ false]))

(define (compiler-reg-scalar-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.I64) true]
    [(ast.AstType.I32) true]
    [(ast.AstType.I16) true]
    [(ast.AstType.I8) true]
    [(ast.AstType.U64) true]
    [(ast.AstType.U32) true]
    [(ast.AstType.U16) true]
    [(ast.AstType.U8) true]
    [(ast.AstType.F64) true]
    [(ast.AstType.F32) true]
    [(ast.AstType.Bool) true]
    [(ast.AstType.Char) true]
    [(ast.AstType.Func _ _) true]
    [(ast.AstType.Ptr _) true]
    [(ast.AstType.MutPtr _) true]
    [(ast.AstType.Ref _ _) true]
    [(ast.AstType.MutRef _ _) true]
    [_ false]))

;; Aggregate types represented as a single 8-byte handle (an arena/heap pointer
;; or a fat-string descriptor pointer). Their VALUES are register-sized, so a var
;; of one of these types can live in a callee-saved register exactly like a raw
;; pointer — the backend already moves them with a plain movq. Values whose
;; address is taken (AddrOf source) or that name a stack object (Alloc) stay on
;; the stack via the memory rule, so register homing here is safe. Zero-sized
;; AstType.Expr/AstType.ExprList are excluded.
(define (compiler-reg-handle-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.String) true]
    [(ast.AstType.Str) true]
    [(ast.AstType.Box _) true]
    [(ast.AstType.Array _ _) true]
    [(ast.AstType.DynArray _) true]
    ;; Bare Slice has no runtime by-value representation in this packet.
    [(ast.AstType.Slice _) false]
    [(ast.AstType.Enum _) true]
    [(ast.AstType.EnumArgs _ _) true]
    [(ast.AstType.Struct _) true]
    [(ast.AstType.StructArgs _ _) true]
    [(ast.AstType.Var _) true]
    [(ast.AstType.VarArgs _ _) true]
    [_ false]))

(define (compiler-reg-register-eligible-type? [ty : ast.AstType]) : bool
  (if (compiler-reg-scalar-type? ty)
    true
    (compiler-reg-handle-type? ty)))

(define (compiler-reg-var-types-empty) : CompilerRegVarTypes
  (CompilerRegVarTypes
    (array.make-array i64 0)
    (array.make-array ast.AstType 0)))

(define (compiler-reg-var-types-lookup
  [types : CompilerRegVarTypes]
  [var : i64]) : CompilerRegMaybeType
  (let
    [present : (__tl_dyn-array i64) types.present]
    [items : (__tl_dyn-array ast.AstType) types.items]
    (if (or (< var 0) (>= var (array-length present)))
      CompilerRegMaybeType.No
      (if (= (array-ref present var) 0)
        CompilerRegMaybeType.No
        (CompilerRegMaybeType.Some (array-ref items var))))))

;; Dense builder update. Callers use this only for uniquely owned fixture or
;; rewrite accumulators; published plans are combined by
;; compiler-reg-var-types-merge, which copies its inputs. Synthetic IDs are
;; minted monotonically from the function watermark, so geometric growth makes
;; a run of new IDs amortized linear while `present` keeps spare slots absent.
(define (compiler-reg-var-types-insert
  [types : CompilerRegVarTypes]
  [var : i64]
  [ty : ast.AstType]) : CompilerRegVarTypes
  (if (< var 0)
    types
    (let
      [old-present : (__tl_dyn-array i64) types.present]
      [old-items : (__tl_dyn-array ast.AstType) types.items]
      [old-len : i64 (array-length old-present)]
      (if (< var old-len)
        (begin
          (set! (array-ref old-present var) 1)
          (set! (array-ref old-items var) ty)
          types)
        (let
          [grown : i64
            (if (< old-len 4)
              4
              (* old-len 2))]
          [new-len : i64
            (if (> (+ var 1) grown)
              (+ var 1)
              grown)]
          [present : (__tl_dyn-array i64) (array.make-array i64 new-len)]
          [items : (__tl_dyn-array ast.AstType)
            (array.make-array ast.AstType new-len)]
          [index : i64 0]
          (begin
            (while (< index old-len)
              (begin
                (set! (array-ref present index) (array-ref old-present index))
                (set! (array-ref items index) (array-ref old-items index))
                (set! index (+ index 1))))
            (set! (array-ref present var) 1)
            (set! (array-ref items var) ty)
            (CompilerRegVarTypes present items)))))))

(define (compiler-reg-addr-of-result-type) : ast.AstType
  (ast.ast-ty-mut-ptr (ast.AstType.U8)))

(define (compiler-reg-var-type-array-set!
  [present : (__tl_dyn-array i64)]
  [types : (__tl_dyn-array ast.AstType)]
  [var : i64]
  [ty : ast.AstType]) : unit
  (if (or (< var 0) (>= var (array-length present)))
    unit
    (begin
      (set! (array-ref present var) 1)
      (set! (array-ref types var) ty))))

(define (compiler-reg-param-types-array!
  [params : ir.CompilerIrParamList]
  [present : (__tl_dyn-array i64)]
  [types : (__tl_dyn-array ast.AstType)]) : unit
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) unit]
    [(ir.CompilerIrParamList.Array seq)
      (compiler-reg-param-types-array!
        (ir.compiler-ir-param-seq-to-list seq)
        present
        types)]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param _ ty id)
          (begin
            (compiler-reg-var-type-array-set! present types id ty)
            (compiler-reg-param-types-array!
              (__tl-box-place rest)
              present
              types))])]))

(define (compiler-reg-instr-def-type-array!
  [instr : ir.CompilerIrInstr]
  [present : (__tl_dyn-array i64)]
  [types : (__tl_dyn-array ast.AstType)]) : unit
  (match instr
    [(ir.CompilerIrInstr.Mov dst _ ty)
      (compiler-reg-var-type-array-set! present types dst ty)]
    [(ir.CompilerIrInstr.AddrOf dst _)
      (compiler-reg-var-type-array-set!
        present
        types
        dst
        (compiler-reg-addr-of-result-type))]
    [(ir.CompilerIrInstr.Gep dst _ _ _)
      (compiler-reg-var-type-array-set!
        present
        types
        dst
        (compiler-reg-addr-of-result-type))]
    [(ir.CompilerIrInstr.Load dst _ ty)
      (compiler-reg-var-type-array-set! present types dst ty)]
    [(ir.CompilerIrInstr.Cast dst _ _ to-ty)
      (compiler-reg-var-type-array-set! present types dst to-ty)]
    [(ir.CompilerIrInstr.Bitcast dst _ _ to-ty)
      (compiler-reg-var-type-array-set! present types dst to-ty)]
    [(ir.CompilerIrInstr.BinOp dst op _ _ ty)
      (compiler-reg-var-type-array-set!
        present
        types
        dst
        (ir.compiler-ir-binop-result-type op ty))]
    [(ir.CompilerIrInstr.UnOp dst _ _ ty)
      (compiler-reg-var-type-array-set! present types dst ty)]
    [(ir.CompilerIrInstr.VectorReduce dst _ _ _ elem-ty)
      (compiler-reg-var-type-array-set! present types dst elem-ty)]
    [(ir.CompilerIrInstr.MaskReduce dst _ _ _)
      (compiler-reg-var-type-array-set! present types dst (ast.AstType.Bool))]
    [(ir.CompilerIrInstr.Call dst _ _ ty)
      (compiler-reg-var-type-array-set! present types dst ty)]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [result (__tl-project-field (__tl-box-place payload-box) result)]
        (match result
          [(ir.CompilerIrSpmdCallResult.Unit) unit]
          [(ir.CompilerIrSpmdCallResult.Value dst _ ty)
            (compiler-reg-var-type-array-set! present types dst ty)]))]
    [(ir.CompilerIrInstr.Phi dst _ ty)
      (compiler-reg-var-type-array-set! present types dst ty)]
    [(ir.CompilerIrInstr.Pack dst _ ty)
      (compiler-reg-var-type-array-set! present types dst ty)]
    [(ir.CompilerIrInstr.Word dst _ _ ty)
      (compiler-reg-var-type-array-set! present types dst ty)]
    [_ unit]))

(define (compiler-reg-instr-seq-types-array!
  [instrs : ir.CompilerIrInstrSeq]
  [present : (__tl_dyn-array i64)]
  [types : (__tl_dyn-array ast.AstType)]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-reg-instr-def-type-array!
            (array-ref slots index)
            present
            types)
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-block-list-types-array!
  [blocks : ir.CompilerIrBlockList]
  [present : (__tl_dyn-array i64)]
  [types : (__tl_dyn-array ast.AstType)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (compiler-reg-instr-seq-types-array! instrs present types)
            (compiler-reg-block-list-types-array!
              (__tl-box-place rest)
              present
              types))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-instr-seq-types-array! instrs present types)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-function-var-types [func : ir.CompilerIrFunction]) : CompilerRegVarTypes
  (match func
    [(ir.CompilerIrFunction.Function _ params _ vars blocks)
      (let
        [present : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [types : (__tl_dyn-array ast.AstType)
          (array.make-array ast.AstType vars)]
        (begin
          (compiler-reg-param-types-array! params present types)
          (compiler-reg-block-list-types-array! blocks present types)
          (CompilerRegVarTypes present types)))]))

(define (compiler-reg-move-list-contains?
  [moves : CompilerRegMoveSeq]
  [src : i64]
  [dst : i64]) : bool
  (let
    [slots : (__tl_dyn-array CompilerRegMove) moves.slots]
    [index : i64 (- moves.len 1)]
    [found : bool false]
    (begin
      (while (and (>= index 0) (not found))
        (begin
          (let
            [item : CompilerRegMove (array-ref slots index)]
            [found-src : i64 item.src]
            [found-dst : i64 item.dst]
            (if (and (= found-src src) (= found-dst dst))
              (set! found true)
              unit))
          (set! index (- index 1))))
      found)))

(define (compiler-reg-move-list-contains-undirected?
  [moves : CompilerRegMoveSeq]
  [src : i64]
  [dst : i64]) : bool
  (let
    [slots : (__tl_dyn-array CompilerRegMove) moves.slots]
    [index : i64 (- moves.len 1)]
    [found : bool false]
    (begin
      (while (and (>= index 0) (not found))
        (begin
          (let
            [item : CompilerRegMove (array-ref slots index)]
            [found-src : i64 item.src]
            [found-dst : i64 item.dst]
            (if (or
              (and (= found-src src) (= found-dst dst))
              (and (= found-src dst) (= found-dst src)))
              (set! found true)
              unit))
          (set! index (- index 1))))
      found)))

(define (compiler-reg-move-list-empty? [moves : CompilerRegMoveSeq]) : bool
  (= moves.len 0))

(define (compiler-reg-move-parallel-resource [var : i64]) : i64
  (+ var 1))

(define (compiler-reg-move-parallel-id [src : i64] [dst : i64]) : i64
  (+ (* (+ src 1) 1000000) (+ dst 1)))

(define (compiler-reg-move-parallel-edge [move : CompilerRegMove]) : pmove.CompilerParallelMoveEdge
  (pmove.ParallelMoveEdge
    (compiler-reg-move-parallel-id move.src move.dst)
    (compiler-reg-move-parallel-resource move.dst)
    0
    (compiler-reg-move-parallel-resource move.src)
    0))

(define (compiler-reg-move-list-parallel-edges [moves : CompilerRegMoveSeq]) : pmove.CompilerParallelMoveEdgeSeq
  (let
    [slots : (__tl_dyn-array CompilerRegMove) moves.slots]
    [count : i64 moves.len]
    [index : i64 (- count 1)]
    [edges : pmove.CompilerParallelMoveEdgeSeq
      (pmove.compiler-parallel-move-edge-seq-with-capacity count)]
    (begin
      ;; The former loop consed each ascending move onto the head. Walk the
      ;; dense source backward so decision order remains newest-first.
      (while (>= index 0)
        (begin
          (pmove.compiler-parallel-move-edge-push!
            (&mut edges)
            (compiler-reg-move-parallel-edge (array-ref slots index)))
          (set! index (- index 1))))
      edges)))

(define (compiler-reg-move-list-parallel-decision [moves : CompilerRegMoveSeq]) : pmove.CompilerParallelMoveDecision
  (let
    [edges : pmove.CompilerParallelMoveEdgeSeq
      (compiler-reg-move-list-parallel-edges moves)]
    (pmove.compiler-parallel-move-decision edges edges)))

(define (compiler-reg-move-list-parallel-decision-ok?) : bool
  (let
    [chain : CompilerRegMoveSeq
      (compiler-reg-move-seq-push
        (compiler-reg-move-seq-push
          (compiler-reg-move-seq-empty)
          (CompilerRegMove 1 2 false))
        (CompilerRegMove 0 1 false))]
    [cycle : CompilerRegMoveSeq
      (compiler-reg-move-seq-push
        (compiler-reg-move-seq-push
          (compiler-reg-move-seq-empty)
          (CompilerRegMove 1 0 false))
        (CompilerRegMove 0 1 false))]
    (and
      (match (compiler-reg-move-list-parallel-decision chain)
        [(pmove.CompilerParallelMoveUnblocked id)
          (= id (compiler-reg-move-parallel-id 1 2))]
        [_ false])
      (match (compiler-reg-move-list-parallel-decision cycle)
        [(pmove.CompilerParallelMoveCycle id)
          (= id (compiler-reg-move-parallel-id 0 1))]
        [_ false]))))

;; Marks the NEWEST undirected match (the head of the former cons list) strict.
(define (compiler-reg-move-list-mark-strict
  [moves : CompilerRegMoveSeq]
  [src : i64]
  [dst : i64]) : CompilerRegMoveSeq
  (let
    [slots : (__tl_dyn-array CompilerRegMove) moves.slots]
    [index : i64 (- moves.len 1)]
    (begin
      (while (>= index 0)
        (let
          [item : CompilerRegMove (array-ref slots index)]
          [found-src : i64 item.src]
          [found-dst : i64 item.dst]
          (if (or
            (and (= found-src src) (= found-dst dst))
            (and (= found-src dst) (= found-dst src)))
            (begin
              (set!
                (array-ref slots index)
                (CompilerRegMove found-src found-dst true))
              (set! index (- 0 1)))
            (set! index (- index 1)))))
      moves)))

(define (compiler-reg-move-list-add
  [moves : CompilerRegMoveSeq]
  [src : i64]
  [dst : i64]
  [strict : bool]
  [undirected : bool]) : CompilerRegMoveSeq
  (if (= src dst)
    moves
    (if (if undirected
      (compiler-reg-move-list-contains-undirected? moves src dst)
      (compiler-reg-move-list-contains? moves src dst))
      (if strict
        (compiler-reg-move-list-mark-strict moves src dst)
        moves)
      (compiler-reg-move-seq-push moves (CompilerRegMove src dst strict)))))

(define (compiler-reg-phi-input-moves
  [dst : i64]
  [inputs : ir.CompilerIrPhiInputList]
  [moves : CompilerRegMoveSeq]
  [strict-pairs : bool]) : CompilerRegMoveSeq
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) moves]
    [(ir.CompilerIrPhiInputList.Array seq)
      (compiler-reg-phi-input-moves
        dst
        (ir.compiler-ir-phi-input-seq-to-list seq)
        moves
        strict-pairs)]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (let
        [tail : CompilerRegMoveSeq
          (compiler-reg-phi-input-moves
            dst
            (__tl-box-place rest)
            moves
            strict-pairs)]
        (match value
          [(ir.CompilerIrValue.Var src)
            (compiler-reg-move-list-add tail src dst strict-pairs strict-pairs)]
          [_ tail]))]))

(define (compiler-reg-instr-moves
  [instr : ir.CompilerIrInstr]
  [moves : CompilerRegMoveSeq]
  [strict-pairs : bool]) : CompilerRegMoveSeq
  (match instr
    [(ir.CompilerIrInstr.Mov dst src _)
      (match src
        [(ir.CompilerIrValue.Var var)
          (compiler-reg-move-list-add moves var dst false strict-pairs)]
        [_ moves])]
    [(ir.CompilerIrInstr.Phi dst inputs _)
      (compiler-reg-phi-input-moves dst inputs moves strict-pairs)]
    [_ moves]))

(define (compiler-reg-instr-seq-moves
  [instrs : ir.CompilerIrInstrSeq]
  [moves : CompilerRegMoveSeq]
  [strict-pairs : bool]) : CompilerRegMoveSeq
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [index : i64 (- instrs.len 1)]
    [out : CompilerRegMoveSeq moves]
    (begin
      (while (>= index 0)
        (begin
          (set!
            out
            (compiler-reg-instr-moves (array-ref slots index) out strict-pairs))
          (set! index (- index 1))))
      out)))

(define (compiler-reg-block-list-moves
  [blocks : ir.CompilerIrBlockList]
  [moves : CompilerRegMoveSeq]
  [strict-pairs : bool]) : CompilerRegMoveSeq
  (match blocks
    [(ir.CompilerIrBlockList.Nil) moves]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-block-list-moves
            (__tl-box-place rest)
            (compiler-reg-instr-seq-moves instrs moves strict-pairs)
            strict-pairs)])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out : CompilerRegMoveSeq moves]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set!
                    out
                    (compiler-reg-instr-seq-moves instrs out strict-pairs))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-reg-function-moves
  [func : ir.CompilerIrFunction]
  [strict-pairs : bool]) : CompilerRegMoveSeq
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (compiler-reg-block-list-moves
        blocks
        (compiler-reg-move-seq-empty)
        strict-pairs)]))

;; M-C (part 1): a 64-bit-width integer cast (i64 <-> u64) is a pure register
;; copy -- the optimizer deliberately KEEPS same-width sign-reinterpreting casts
;; as IrInstrCast (opt-int-cast-as-mov?) and the backend emits them as a plain
;; `movq src-home, dst-home` (compiler-backend-emit-cast, the same-size arm),
;; eliding it when the homes coincide. The bounds-check index temp is exactly
;; this shape (lower-cast-value i64->u64 feeding IrInstrBoundsCheck). Narrower
;; same-width casts (i32<->u32 ...) are excluded: their register homes hold the
;; sign/zero-NORMALIZED 64-bit value, which differs between the signednesses,
;; so those pairs are not same-valued at the 64-bit register level.
(define (compiler-reg-int-width-64? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.I64) true]
    [(ast.AstType.U64) true]
    [_ false]))

(define (compiler-reg-cast-copy-64?
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : bool
  (and (compiler-reg-int-width-64? from-ty) (compiler-reg-int-width-64? to-ty)))

;; Scalar operations whose backend lowering can destructively reuse an operand
;; home for the result. Comparisons produce a fresh boolean through cmp/setcc;
;; div/mod use fixed rax:rdx and are not ordinary operand ties.
(define (compiler-reg-binop-destructive-tie? [op : ir.CompilerIrBinOp]) : bool
  (and
    (not (compiler-reg-clobber-binop-div? op))
    (not (ir.compiler-ir-binop-compare? op))))

(define (compiler-reg-binop-destructive-commutative? [op : ir.CompilerIrBinOp]) : bool
  (match op
    [(ir.CompilerIrBinOp.Add) true]
    [(ir.CompilerIrBinOp.Mul) true]
    [(ir.CompilerIrBinOp.And) true]
    [(ir.CompilerIrBinOp.Or) true]
    [(ir.CompilerIrBinOp.BitAnd) true]
    [(ir.CompilerIrBinOp.BitOr) true]
    [(ir.CompilerIrBinOp.BitXor) true]
    [_ false]))

;; GAP8-C. A two-address BinOp ties its destination to an operand's home, and
;; both tie mechanisms below prefer the LHS. When the LHS is a fused `gep; load`
;; result that is the backend's COMMUTED ALU memory-operand fold candidate
;; (compiler-backend-gep-load-alu-probe, `mem-is-lhs?`), that preference is
;; exactly wrong: the fold stages the NON-loaded operand into the destination's
;; home and then reads the memory operand from the other side, so it only saves
;; an instruction when the destination home IS that operand's home and the
;; staging `mov` self-elides. Coalescing the destination onto the LOAD's home
;; instead makes the folded and unfolded forms the same two instructions -- which
;; is why the commuted arm landed inert.
;;
;; So: for a commutative BinOp whose LHS is a fusable load and whose RHS is not,
;; prefer the RHS. Every other shape keeps today's LHS preference exactly.
;;
;; The admission below MIRRORS the backend, the way
;; compiler-reg-leaf-csr-fuse-free-branch-var mirrors
;; compiler-backend-fuse-free-branch-var: the structural conditions are restated
;; here rather than shared, because regalloc runs before homes exist and can only
;; see the IR half of the fold's gate. The home-dependent half (a register-homed
;; destination distinct from the address component homes) stays the backend's;
;; a preference that does not pay off costs code shape, never correctness.
;; Mirror of compiler-backend-gep-load-alu-mnemonic INTERSECTED with
;; compiler-backend-commutative-binop?: the ops whose commuted memory-operand
;; form the backend actually folds. `Mul` is absent from the mnemonic table
;; (`imul mem` needs the two-operand register form and folds worse than the fused
;; load), `Sub` is in the table but is not commutative (`MEM - x` is not
;; `x - MEM`), and the logical `And`/`Or` have no memory-form mnemonic there.
(define (compiler-reg-alu-mem-fold-commutative? [op : ir.CompilerIrBinOp]) : bool
  (match op
    [(ir.CompilerIrBinOp.Add) true]
    [(ir.CompilerIrBinOp.BitAnd) true]
    [(ir.CompilerIrBinOp.BitOr) true]
    [(ir.CompilerIrBinOp.BitXor) true]
    [_ false]))

;; The var defined by a fusable `gep; load` pair immediately before `index`, or
;; -1. This is the admission compiler-backend-emit-gep-step applies before the
;; ALU probe is ever consulted -- a single-use gep whose result the very next
;; instruction loads -- plus the probe's own load-destination gates: single use,
;; not float, eight bytes wide. Width is tested as i64/u64 rather than through a
;; type-size table because that is the width every folded word-loop accumulator
;; carries and regalloc has no segment bases to size other types with; a narrower
;; admission only declines preferences, it never mis-states one.
(define (compiler-reg-alu-fused-load-dst
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [use-counts : (__tl_dyn-array i64)]) : i64
  (if (< index 2)
    (- 0 1)
    (match (array-ref slots (- index 1))
      [(ir.CompilerIrInstr.Load load-dst src load-ty)
        (if (and
          (compiler-reg-int-width-64? load-ty)
          (compiler-reg-alu-single-use? use-counts load-dst))
          (match src
            [(ir.CompilerIrValue.Var gep-var)
              (match (array-ref slots (- index 2))
                [(ir.CompilerIrInstr.Gep gep-dst _ _ _)
                  (if (and
                    (= gep-dst gep-var)
                    (compiler-reg-alu-single-use? use-counts gep-var))
                    load-dst
                    (- 0 1))]
                [_ (- 0 1)])]
            [_ (- 0 1)])
          (- 0 1))]
      [_ (- 0 1)])))

;; Mirror of compiler-backend-var-single-use?, with one addition: a ZERO-LENGTH
;; count array means "counts not built yet" and admits everything. The flag pass
;; runs once that way to find out whether the function has any candidate at all,
;; and only pays for the use-count walk when it does.
(define (compiler-reg-alu-single-use?
  [use-counts : (__tl_dyn-array i64)]
  [var : i64]) : bool
  (if (= (array-length use-counts) 0)
    true
    (if (or (< var 0) (>= var (array-length use-counts)))
      false
      (= (array-ref use-counts var) 1))))

(define (compiler-reg-alu-load-defines?
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [var : i64]) : bool
  (if (< index 0)
    false
    (match (array-ref slots index)
      [(ir.CompilerIrInstr.Load load-dst _ _) (= load-dst var)]
      [_ false])))

(define (compiler-reg-alu-prefer-rhs-binop?
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [ty : ast.AstType]
  [use-counts : (__tl_dyn-array i64)]) : bool
  (and
    (compiler-reg-alu-mem-fold-commutative? op)
    (compiler-reg-int-width-64? ty)
    (match lhs
      [(ir.CompilerIrValue.Var lhs-var)
        (match rhs
          [(ir.CompilerIrValue.Var rhs-var)
            (and
              (not (= lhs-var rhs-var))
              (=
                (compiler-reg-alu-fused-load-dst slots index use-counts)
                lhs-var)
              ;; BOTH operands loaded is the backend's PAIR fold
              ;; (compiler-backend-gep-load-pair-alu-probe), which loads one
              ;; memory operand straight into the result home and needs no
              ;; operand tie at all. Its shape is `gep; load; gep; load; binop`,
              ;; so the rhs-defining load sits three slots back. Leave those ties
              ;; exactly where they are.
              (not (compiler-reg-alu-load-defines? slots (- index 3) rhs-var)))]
          [_ false])]
      [_ false])))

(define (compiler-reg-alu-prefer-rhs-seq
  [instrs : ir.CompilerIrInstrSeq]
  [flags : (__tl_dyn-array i64)]
  [use-counts : (__tl_dyn-array i64)]
  [found : i64]) : i64
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    [out : i64 found]
    (begin
      (while (< index count)
        (begin
          (match (array-ref slots index)
            [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
              ;; Counted BEFORE the store, so a zero-length `flags` still yields
              ;; a truthful count -- that is how the probe pass avoids allocating
              ;; a per-var array for the overwhelming majority of functions that
              ;; hold no candidate at all.
              (if (compiler-reg-alu-prefer-rhs-binop?
                slots
                index
                op
                lhs
                rhs
                ty
                use-counts)
                (begin
                  (if (and (>= dst 0) (< dst (array-length flags)))
                    (set! (array-ref flags dst) 1)
                    unit)
                  (set! out (+ out 1)))
                unit)]
            [_ unit])
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-alu-prefer-rhs-blocks
  [blocks : ir.CompilerIrBlockList]
  [flags : (__tl_dyn-array i64)]
  [use-counts : (__tl_dyn-array i64)]
  [found : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) found]
    [(ir.CompilerIrBlockList.Cons block rest)
      (compiler-reg-alu-prefer-rhs-blocks
        (__tl-box-place rest)
        flags
        use-counts
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-alu-prefer-rhs-seq instrs flags use-counts found)]))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out : i64 found]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set!
                    out
                    (compiler-reg-alu-prefer-rhs-seq
                      instrs
                      flags
                      use-counts
                      out))])
              (set! i (+ i 1))))
          out))]))

;; Use-only counts (the ref-count walks above deliberately score defs too).
;; Structurally identical to compiler-backend-count-instr-uses: the id extractor
;; and its bitset fallback enumerate the same operand positions, and the fold's
;; single-use question is asked about a var whose only candidate use is one
;; operand of one instruction, so the extractor's per-instruction de-duplication
;; cannot separate the two answers.
(define (compiler-reg-alu-use-counts-add-instr!
  [counts : (__tl_dyn-array i64)]
  [instr : ir.CompilerIrInstr]) : unit
  (let
    [ids : (__tl_dyn-array i64) (live.compiler-live-instr-ids)]
    [id-count : i64 (live.compiler-live-instr-use-ids! instr)]
    (if (< id-count 0)
      (compiler-reg-ref-counts-add-set-weighted!
        counts
        (live.compiler-live-instr-uses instr)
        1)
      (compiler-reg-ref-counts-add-ids-weighted! counts ids id-count 1))))

(define (compiler-reg-alu-use-counts-seq!
  [counts : (__tl_dyn-array i64)]
  [instrs : ir.CompilerIrInstrSeq]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (while (< index count)
      (begin
        (compiler-reg-alu-use-counts-add-instr! counts (array-ref slots index))
        (set! index (+ index 1))))))

(define (compiler-reg-alu-use-counts-blocks!
  [blocks : ir.CompilerIrBlockList]
  [counts : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-alu-use-counts-seq! counts instrs)])
        (compiler-reg-alu-use-counts-blocks! (__tl-box-place rest) counts))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-alu-use-counts-seq! counts instrs)])
            (set! i (+ i 1)))))]))

;; Per-var flags: 1 where a two-address BinOp destination should tie to its RHS
;; instead of its LHS. Indexed by the BinOp's destination var, so the two tie
;; mechanisms consult it without re-deriving the shape.
;;
;; Built in two probes so the common function pays nothing: the first runs the
;; structural match with no use counts (every single-use test admits), and only a
;; function that produced a candidate walks its uses and re-runs the match for
;; real. The corpus census says that is a handful of functions.
(define (compiler-reg-function-alu-prefer-rhs [func : ir.CompilerIrFunction]) : (__tl_dyn-array
    i64)
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ vars blocks)
      (let
        [none : (__tl_dyn-array i64) (array.make-array i64 0)]
        [probe : i64 (compiler-reg-alu-prefer-rhs-blocks blocks none none 0)]
        (if (= probe 0)
          none
          (let
            [flags : (__tl_dyn-array i64) (array.make-array i64 vars)]
            [counts : (__tl_dyn-array i64) (array.make-array i64 vars)]
            (begin
              (compiler-reg-alu-use-counts-blocks! blocks counts)
              (compiler-reg-alu-prefer-rhs-blocks blocks flags counts 0)
              flags))))]))

(define (compiler-reg-alu-prefer-rhs?
  [flags : (__tl_dyn-array i64)]
  [var : i64]) : bool
  (and (>= var 0) (< var (array-length flags)) (= (array-ref flags var) 1)))

;; Harvest width-64 int casts as coalescable moves (M-C part 1). Kept SEPARATE
;; from compiler-reg-function-moves so the SIMD/AVX plan path and the post-hoc
;; loop-split/remat coalesce rebuilds stay byte-identical; only the scalar-opt2
;; plan-from seeds its move list with these (appended BEHIND the real moves so
;; existing first-wins copy-hint priorities are unchanged).
(define (compiler-reg-cast-move-instr
  [instr : ir.CompilerIrInstr]
  [moves : CompilerRegMoveSeq]) : CompilerRegMoveSeq
  (match instr
    [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
      (match src
        [(ir.CompilerIrValue.Var var)
          (if (compiler-reg-cast-copy-64? from-ty to-ty)
            (compiler-reg-move-list-add moves var dst false false)
            moves)]
        [_ moves])]
    [_ moves]))

(define (compiler-reg-cast-moves-seq
  [instrs : ir.CompilerIrInstrSeq]
  [moves : CompilerRegMoveSeq]) : CompilerRegMoveSeq
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [index : i64 (- instrs.len 1)]
    [out : CompilerRegMoveSeq moves]
    (begin
      (while (>= index 0)
        (begin
          (set! out (compiler-reg-cast-move-instr (array-ref slots index) out))
          (set! index (- index 1))))
      out)))

(define (compiler-reg-cast-moves-blocks
  [blocks : ir.CompilerIrBlockList]
  [moves : CompilerRegMoveSeq]) : CompilerRegMoveSeq
  (match blocks
    [(ir.CompilerIrBlockList.Nil) moves]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-cast-moves-blocks
            (__tl-box-place rest)
            (compiler-reg-cast-moves-seq instrs moves))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out : CompilerRegMoveSeq moves]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set! out (compiler-reg-cast-moves-seq instrs out))])
              (set! i (+ i 1))))
          out))]))

;; Destructive ties are useful for chains, but feeding every scalar binop into
;; the general class coalescer makes arithmetic-heavy self-host functions
;; pathologically expensive. Build a bounded candidate set instead. A tie is
;; harvested when either endpoint is already move/phi-related, when its source is
;; another destructive result, or when its destination feeds another destructive
;; operation. This covers straight-line chains and phi-carried reductions while
;; skipping isolated arithmetic.
(define (compiler-reg-destructive-mark-move-vars!
  [moves : CompilerRegMoveSeq]
  [anchors : (__tl_dyn-array i64)]) : unit
  (let
    [slots : (__tl_dyn-array CompilerRegMove) moves.slots]
    [count : i64 moves.len]
    [index : i64 0]
    (while (< index count)
      (begin
        (let
          [item : CompilerRegMove (array-ref slots index)]
          [src : i64 item.src]
          [dst : i64 item.dst]
          (begin
            (if (and (>= src 0) (< src (array-length anchors)))
              (set! (array-ref anchors src) 1)
              unit)
            (if (and (>= dst 0) (< dst (array-length anchors)))
              (set! (array-ref anchors dst) 1)
              unit)))
        (set! index (+ index 1))))))

(define (compiler-reg-destructive-shape-instr!
  [instr : ir.CompilerIrInstr]
  [defs : (__tl_dyn-array i64)]
  [uses : (__tl_dyn-array i64)]) : unit
  (match instr
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs _)
      (if (compiler-reg-binop-destructive-tie? op)
        (begin
          (if (and (>= dst 0) (< dst (array-length defs)))
            (set! (array-ref defs dst) 1)
            unit)
          (match lhs
            [(ir.CompilerIrValue.Var var)
              (if (and (>= var 0) (< var (array-length uses)))
                (set! (array-ref uses var) 1)
                unit)]
            [_ unit])
          (if (compiler-reg-binop-destructive-commutative? op)
            (match rhs
              [(ir.CompilerIrValue.Var var)
                (if (and (>= var 0) (< var (array-length uses)))
                  (set! (array-ref uses var) 1)
                  unit)]
              [_ unit])
            unit))
        unit)]
    [_ unit]))

(define (compiler-reg-destructive-shape-seq!
  [instrs : ir.CompilerIrInstrSeq]
  [defs : (__tl_dyn-array i64)]
  [uses : (__tl_dyn-array i64)]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (while (< index count)
      (begin
        (compiler-reg-destructive-shape-instr!
          (array-ref slots index)
          defs
          uses)
        (set! index (+ index 1))))))

(define (compiler-reg-destructive-shape-blocks!
  [blocks : ir.CompilerIrBlockList]
  [defs : (__tl_dyn-array i64)]
  [uses : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-destructive-shape-seq! instrs defs uses)])
        (compiler-reg-destructive-shape-blocks! (__tl-box-place rest) defs uses))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-destructive-shape-seq! instrs defs uses)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-destructive-candidate?
  [src : i64]
  [dst : i64]
  [anchors : (__tl_dyn-array i64)]
  [defs : (__tl_dyn-array i64)]
  [uses : (__tl_dyn-array i64)]
  [eligible : (__tl_dyn-array i64)]) : bool
  (and
    (>= src 0)
    (< src (array-length anchors))
    (>= dst 0)
    (< dst (array-length anchors))
    (< src (array-length eligible))
    (< dst (array-length eligible))
    (= (array-ref eligible src) 1)
    (= (array-ref eligible dst) 1)
    (or
      (= (array-ref anchors src) 1)
      (= (array-ref anchors dst) 1)
      (= (array-ref defs src) 1)
      (= (array-ref uses dst) 1))))

(define (compiler-reg-destructive-add-value-tie
  [value : ir.CompilerIrValue]
  [dst : i64]
  [moves : CompilerRegMoveSeq]
  [anchors : (__tl_dyn-array i64)]
  [defs : (__tl_dyn-array i64)]
  [uses : (__tl_dyn-array i64)]
  [eligible : (__tl_dyn-array i64)]) : CompilerRegMoveSeq
  (match value
    [(ir.CompilerIrValue.Var src)
      (if (compiler-reg-destructive-candidate?
        src
        dst
        anchors
        defs
        uses
        eligible)
        (compiler-reg-move-list-add moves src dst false false)
        moves)]
    [_ moves]))

(define (compiler-reg-destructive-value-candidate?
  [value : ir.CompilerIrValue]
  [dst : i64]
  [anchors : (__tl_dyn-array i64)]
  [defs : (__tl_dyn-array i64)]
  [uses : (__tl_dyn-array i64)]
  [eligible : (__tl_dyn-array i64)]) : bool
  (match value
    [(ir.CompilerIrValue.Var src)
      (compiler-reg-destructive-candidate? src dst anchors defs uses eligible)]
    [_ false]))

(define (compiler-reg-destructive-tie-instr
  [instr : ir.CompilerIrInstr]
  [moves : CompilerRegMoveSeq]
  [anchors : (__tl_dyn-array i64)]
  [defs : (__tl_dyn-array i64)]
  [uses : (__tl_dyn-array i64)]
  [eligible : (__tl_dyn-array i64)]
  [prefer-rhs : (__tl_dyn-array i64)]) : CompilerRegMoveSeq
  (match instr
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs _)
      (if (compiler-reg-binop-destructive-tie? op)
        ;; GAP8-C: a commutative BinOp whose lhs is the backend's commuted
        ;; ALU-fold load takes the rhs home instead, so the fold's staging `mov`
        ;; self-elides and the load disappears into the ALU line. An rhs that is
        ;; not itself an eligible chain candidate has no home to reuse, so the
        ;; lhs-first selection below still decides those.
        (if (and
          (compiler-reg-alu-prefer-rhs? prefer-rhs dst)
          (compiler-reg-destructive-value-candidate?
            rhs
            dst
            anchors
            defs
            uses
            eligible))
          (compiler-reg-destructive-add-value-tie
            rhs
            dst
            moves
            anchors
            defs
            uses
            eligible)
          (compiler-reg-destructive-tie-lhs-first
            dst
            op
            lhs
            rhs
            moves
            anchors
            defs
            uses
            eligible))
        moves)]
    [_ moves]))

(define (compiler-reg-destructive-tie-lhs-first
  [dst : i64]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [moves : CompilerRegMoveSeq]
  [anchors : (__tl_dyn-array i64)]
  [defs : (__tl_dyn-array i64)]
  [uses : (__tl_dyn-array i64)]
  [eligible : (__tl_dyn-array i64)]) : CompilerRegMoveSeq
  ;; Select exactly one destructive home. Prefer lhs whenever it is an
  ;; eligible chain candidate; for commutative operations, rhs is the
  ;; deterministic fallback when lhs cannot participate. Adding both
  ;; alternatives lets unrelated rhs values reshape otherwise-stable
  ;; coalesce classes and can increase register pressure.
  (if (compiler-reg-destructive-value-candidate?
    lhs
    dst
    anchors
    defs
    uses
    eligible)
    (compiler-reg-destructive-add-value-tie
      lhs
      dst
      moves
      anchors
      defs
      uses
      eligible)
    (if (compiler-reg-binop-destructive-commutative? op)
      (match lhs
        ;; A variable lhs remains the canonical destructive operand even
        ;; when it is not a chain candidate. Falling through to rhs in
        ;; that case perturbs unrelated arithmetic classes. A literal lhs
        ;; has no reusable home, so rhs is the only legal alternative.
        [(ir.CompilerIrValue.Var _) moves]
        [_
          (match rhs
            ;; Keep the alternate relation chain-shaped: the reusable rhs
            ;; must itself be a destructive result. This covers operand-
            ;; swapped commutative chains without turning literal-led
            ;; standalone arithmetic into a global preference source.
            [(ir.CompilerIrValue.Var rhs-var)
              (if (and
                (>= rhs-var 0)
                (< rhs-var (array-length defs))
                (= (array-ref defs rhs-var) 1))
                (compiler-reg-destructive-add-value-tie
                  rhs
                  dst
                  moves
                  anchors
                  defs
                  uses
                  eligible)
                moves)]
            [_ moves])])
      moves)))

(define (compiler-reg-destructive-tie-moves-seq
  [instrs : ir.CompilerIrInstrSeq]
  [moves : CompilerRegMoveSeq]
  [anchors : (__tl_dyn-array i64)]
  [defs : (__tl_dyn-array i64)]
  [uses : (__tl_dyn-array i64)]
  [eligible : (__tl_dyn-array i64)]
  [prefer-rhs : (__tl_dyn-array i64)]) : CompilerRegMoveSeq
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [index : i64 (- instrs.len 1)]
    [out : CompilerRegMoveSeq moves]
    (begin
      (while (>= index 0)
        (begin
          (set!
            out
            (compiler-reg-destructive-tie-instr
              (array-ref slots index)
              out
              anchors
              defs
              uses
              eligible
              prefer-rhs))
          (set! index (- index 1))))
      out)))

(define (compiler-reg-destructive-tie-moves-blocks
  [blocks : ir.CompilerIrBlockList]
  [moves : CompilerRegMoveSeq]
  [anchors : (__tl_dyn-array i64)]
  [defs : (__tl_dyn-array i64)]
  [uses : (__tl_dyn-array i64)]
  [eligible : (__tl_dyn-array i64)]
  [prefer-rhs : (__tl_dyn-array i64)]) : CompilerRegMoveSeq
  (match blocks
    [(ir.CompilerIrBlockList.Nil) moves]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-destructive-tie-moves-blocks
            (__tl-box-place rest)
            (compiler-reg-destructive-tie-moves-seq
              instrs
              moves
              anchors
              defs
              uses
              eligible
              prefer-rhs)
            anchors
            defs
            uses
            eligible
            prefer-rhs)])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out : CompilerRegMoveSeq moves]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set!
                    out
                    (compiler-reg-destructive-tie-moves-seq
                      instrs
                      out
                      anchors
                      defs
                      uses
                      eligible
                      prefer-rhs))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-reg-function-destructive-tie-moves
  [func : ir.CompilerIrFunction]
  [moves : CompilerRegMoveSeq]
  [eligible : (__tl_dyn-array i64)]
  [prefer-rhs : (__tl_dyn-array i64)]) : CompilerRegMoveSeq
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ vars blocks)
      (let
        [anchors : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [defs : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [uses : (__tl_dyn-array i64) (array.make-array i64 vars)]
        (begin
          (compiler-reg-destructive-mark-move-vars!
            (compiler-reg-function-moves func false)
            anchors)
          (compiler-reg-destructive-shape-blocks! blocks defs uses)
          (compiler-reg-destructive-tie-moves-blocks
            blocks
            moves
            anchors
            defs
            uses
            eligible
            prefer-rhs)))]))

;; function-moves with the width-64 cast copies appended at the TAIL (the cast
;; list is built first and used as the seed accumulator the real moves are
;; prepended onto), so every existing move keeps its first-wins position for
;; copy-hints and the coalesce pass sees the cast pairs last.
(define (compiler-reg-function-moves-with-destructive-and-casts-eligible
  [func : ir.CompilerIrFunction]
  [strict-pairs : bool]
  [eligible : (__tl_dyn-array i64)]
  [prefer-rhs : (__tl_dyn-array i64)]) : CompilerRegMoveSeq
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (compiler-reg-block-list-moves
        blocks
        (compiler-reg-function-destructive-tie-moves
          func
          (compiler-reg-cast-moves-blocks blocks (compiler-reg-move-seq-empty))
          eligible
          prefer-rhs)
        strict-pairs)]))

(define (compiler-reg-function-moves-with-destructive-and-casts
  [func : ir.CompilerIrFunction]
  [strict-pairs : bool]) : CompilerRegMoveSeq
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ vars _)
      (let
        [eligible : (__tl_dyn-array i64) (array.make-array i64 vars)]
        (begin
          (compiler-reg-fill-i64-array eligible 1)
          (compiler-reg-function-moves-with-destructive-and-casts-eligible
            func
            strict-pairs
            eligible
            (compiler-reg-function-alu-prefer-rhs func))))]))

(define (compiler-reg-move-list-filter-storage-identity
  [moves : CompilerRegMoveSeq]
  [storage-vars : live.CompilerLiveI64Set]) : CompilerRegMoveSeq
  (let
    [slots : (__tl_dyn-array CompilerRegMove) moves.slots]
    [count : i64 moves.len]
    [index : i64 0]
    [out : CompilerRegMoveSeq (compiler-reg-move-seq-empty)]
    (begin
      (while (< index count)
        (begin
          (let
            [item : CompilerRegMove (array-ref slots index)]
            [src : i64 item.src]
            [dst : i64 item.dst]
            (if (or
              (live.compiler-live-set-contains? storage-vars src)
              (live.compiler-live-set-contains? storage-vars dst))
              unit
              (set! out (compiler-reg-move-seq-push out item))))
          (set! index (+ index 1))))
      out)))

;; For a NON-zero `value`, or for an array being *re*-initialised. `make-array`
;; of an i64 array already hands back zeroed memory, so a `... 0` fill directly
;; after the allocation repeats the allocator's work with a scalar loop.
(define (compiler-reg-fill-i64-array
  [items : (__tl_dyn-array i64)]
  [value : i64]) : unit
  (let
    [index : i64 0]
    [count : i64 (array-length items)]
    (begin
      (while (< index count)
        (begin
          (set! (array-ref items index) value)
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-select-false-preference-instr!
  [instr : ir.CompilerIrInstr]
  [preferences : (__tl_dyn-array i64)]) : unit
  (match instr
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [false-value (__tl-project-field (__tl-box-place payload-box) on-false)]
        (match false-value
          [(ir.CompilerIrValue.Var false-var)
            (if (and (>= dst 0) (< dst (array-length preferences)))
              (set! (array-ref preferences dst) false-var)
              unit)]
          [_ unit]))]
    [_ unit]))

(define (compiler-reg-select-false-preference-seq!
  [instrs : ir.CompilerIrInstrSeq]
  [preferences : (__tl_dyn-array i64)]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-reg-select-false-preference-instr!
            (array-ref slots index)
            preferences)
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-select-false-preference-blocks!
  [blocks : ir.CompilerIrBlockList]
  [preferences : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-select-false-preference-seq! instrs preferences)])
        (compiler-reg-select-false-preference-blocks!
          (__tl-box-place rest)
          preferences))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-select-false-preference-seq! instrs preferences)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-function-select-false-preferences
  [func : ir.CompilerIrFunction]
  [vars : i64]) : (__tl_dyn-array i64)
  (let
    [preferences : (__tl_dyn-array i64) (array.make-array i64 vars)]
    (begin
      (compiler-reg-fill-i64-array preferences -1)
      (match func
        [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
          (compiler-reg-select-false-preference-blocks! blocks preferences)])
      preferences)))

(define (compiler-reg-fill-location-array
  [items : (__tl_dyn-array CompilerRegLocation)]
  [value : CompilerRegLocation]) : unit
  (let
    [index : i64 0]
    [count : i64 (array-length items)]
    (begin
      (while (< index count)
        (begin
          (set! (array-ref items index) value)
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-assignment-table-make [vars : i64]) : CompilerRegAssignmentTable
  (let
    [n : i64
      (if (< vars 1)
        1
        vars)]
    [present : (__tl_dyn-array i64) (array.make-array i64 n)]
    [items : (__tl_dyn-array CompilerRegLocation)
      (array.make-array CompilerRegLocation n)]
    (begin
      (compiler-reg-fill-location-array items (CompilerRegLocation.Spill 0))
      (CompilerRegAssignmentTable present items))))

(define (compiler-reg-assignment-table-empty) : CompilerRegAssignmentTable
  (compiler-reg-assignment-table-make 1))

(define (compiler-reg-assignment-table-copy-with-capacity
  [assignments : (& assignments CompilerRegAssignmentTable)]
  [capacity : i64]) : CompilerRegAssignmentTable
  (let
    [old-present : (__tl_dyn-array i64) assignments.present]
    [old-items : (__tl_dyn-array CompilerRegLocation) assignments.items]
    [size : i64
      (if (> capacity (array-length old-present))
        capacity
        (array-length old-present))]
    [out : CompilerRegAssignmentTable (compiler-reg-assignment-table-make size)]
    [present : (__tl_dyn-array i64) out.present]
    [items : (__tl_dyn-array CompilerRegLocation) out.items]
    [index : i64 0]
    (begin
      (while (< index (array-length old-present))
        (begin
          (set! (array-ref present index) (array-ref old-present index))
          (if (= (array-ref old-present index) 0)
            unit
            (set! (array-ref items index) (clone (array-ref old-items index))))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-assignment-table-with-min-capacity
  [assignments : CompilerRegAssignmentTable]
  [vars : i64]) : CompilerRegAssignmentTable
  (if (<= vars (array-length assignments.present))
    assignments
    (compiler-reg-assignment-table-copy-with-capacity assignments vars)))

(define (compiler-reg-assignment-table-insert
  [assignments : CompilerRegAssignmentTable]
  [var : i64]
  [location : CompilerRegLocation]) : CompilerRegAssignmentTable
  (let
    [present : (__tl_dyn-array i64) assignments.present]
    [items : (__tl_dyn-array CompilerRegLocation) assignments.items]
    (begin
      (if (or (< var 0) (>= var (array-length present)))
        unit
        (begin
          (set! (array-ref present var) 1)
          (set! (array-ref items var) location)))
      assignments)))

(define (compiler-reg-assignment-table-overlay!
  [dst : CompilerRegAssignmentTable]
  [src : CompilerRegAssignmentTable]) : unit
  (let
    [present : (__tl_dyn-array i64) src.present]
    [items : (__tl_dyn-array CompilerRegLocation) src.items]
    [index : i64 0]
    (begin
      (while (< index (array-length present))
        (begin
          (if (= (array-ref present index) 0)
            unit
            (begin
              (compiler-reg-assignment-table-insert
                dst
                index
                (clone (array-ref items index)))
              unit))
          (set! index (+ index 1))))
      unit)))

;; RAGreedy Component 1: drop a var's current assignment (present[var]=0) without
;; choosing a new location. The evict-and-requeue worklist UNASSIGNS an evicted
;; resident here (rather than whole-spilling it via insert-Spill) so it can be
;; re-enqueued and given a fresh allocation attempt. items[var] is left stale; it
;; is dead while present[var]=0 and is overwritten on the next insert.
(define (compiler-reg-assignment-table-unassign
  [assignments : CompilerRegAssignmentTable]
  [var : i64]) : CompilerRegAssignmentTable
  (let
    [present : (__tl_dyn-array i64) assignments.present]
    (begin
      (if (or (< var 0) (>= var (array-length present)))
        unit
        (set! (array-ref present var) 0))
      assignments)))

(define (compiler-reg-assignment-table-lookup
  [assignments : (& assignments CompilerRegAssignmentTable)]
  [var : i64]) : CompilerRegMaybeLocation
  (let
    [present : (__tl_dyn-array i64) assignments.present]
    [items : (__tl_dyn-array CompilerRegLocation) assignments.items]
    (if (or (< var 0) (>= var (array-length present)))
      CompilerRegMaybeLocation.No
      (if (= (array-ref present var) 0)
        CompilerRegMaybeLocation.No
        (CompilerRegMaybeLocation.Some (clone (array-ref items var)))))))

(define (compiler-reg-assignment-table-has-spill-from?
  [assignments : CompilerRegAssignmentTable]
  [index : i64]) : bool
  (let
    [present : (__tl_dyn-array i64) assignments.present]
    [items : (__tl_dyn-array CompilerRegLocation) assignments.items]
    (cond
      [(>= index (array-length present)) false]
      [(= (array-ref present index) 0)
        (compiler-reg-assignment-table-has-spill-from? assignments (+ index 1))]
      [else
        (match (array-ref items index)
          [(CompilerRegLocation.Spill _) true]
          [_
            (compiler-reg-assignment-table-has-spill-from?
              assignments
              (+ index 1))])])))

(define (compiler-reg-assignment-table-has-spill?
  [assignments : CompilerRegAssignmentTable]) : bool
  (compiler-reg-assignment-table-has-spill-from? assignments 0))

(define (compiler-reg-interval-index-fill!
  [intervals : CompilerRegIntervalSeq]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]) : unit
  (let
    [index : i64 0]
    (while (< index (compiler-reg-interval-seq-count intervals))
      (begin
        (let
          [interval : CompilerRegInterval
            (compiler-reg-interval-seq-ref intervals index)]
          [var : i64 interval.var]
          (if (or
            (< var 0)
            (>= var (array-length starts))
            (>= (array-ref starts var) 0))
            unit
            (begin
              (set! (array-ref starts var) interval.start)
              (set! (array-ref ends var) interval.end))))
        (set! index (+ index 1))))))

(define (compiler-reg-interval-index-build
  [intervals : CompilerRegIntervalSeq]
  [vars : i64]) : CompilerRegIntervalIndex
  (let
    [starts : (__tl_dyn-array i64) (array.make-array i64 vars)]
    [ends : (__tl_dyn-array i64) (array.make-array i64 vars)]
    [segments : (__tl_dyn-array CompilerRegIntervalSeq)
      (array.make-array CompilerRegIntervalSeq 0)]
    (begin
      (compiler-reg-fill-i64-array starts -1)
      (compiler-reg-fill-i64-array ends -1)
      (compiler-reg-interval-index-fill! intervals starts ends)
      (CompilerRegIntervalIndex starts ends segments))))

(define (compiler-reg-interval-index-lookup
  [index : CompilerRegIntervalIndex]
  [var : i64]) : CompilerRegMaybeInterval
  (let
    [starts : (__tl_dyn-array i64) index.starts]
    [ends : (__tl_dyn-array i64) index.ends]
    (if (or (< var 0) (>= var (array-length starts)))
      CompilerRegMaybeInterval.No
      (if (< (array-ref starts var) 0)
        CompilerRegMaybeInterval.No
        (CompilerRegMaybeInterval.Some
          (CompilerRegInterval var (array-ref starts var) (array-ref ends var)))))))

(define (compiler-reg-extend-interval
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [var : i64]
  [point : i64]) : unit
  (if (< var 0)
    unit
    (if (>= var (array-length starts))
      unit
      (let
        [start : i64 (array-ref starts var)]
        [end : i64 (array-ref ends var)]
        (begin
          (if (< start 0)
            (begin
              (set! (array-ref starts var) point)
              (set! (array-ref ends var) point))
            (begin
              (if (< point start)
                (set! (array-ref starts var) point)
                unit)
              (if (> point end)
                (set! (array-ref ends var) point)
                unit)))
          unit)))))

(define (compiler-reg-low-bit-index [bits : i64]) : i64
  (let
    [value : i64 bits]
    [offset : i64 0]
    (begin
      (if (= (bit-and value 0xffffffff) 0)
        (begin
          (set! value (shr value 32))
          (set! offset (+ offset 32)))
        unit)
      (if (= (bit-and value 0xffff) 0)
        (begin
          (set! value (shr value 16))
          (set! offset (+ offset 16)))
        unit)
      (if (= (bit-and value 0xff) 0)
        (begin
          (set! value (shr value 8))
          (set! offset (+ offset 8)))
        unit)
      (if (= (bit-and value 0xf) 0)
        (begin
          (set! value (shr value 4))
          (set! offset (+ offset 4)))
        unit)
      (if (= (bit-and value 0x3) 0)
        (begin
          (set! value (shr value 2))
          (set! offset (+ offset 2)))
        unit)
      (if (= (bit-and value 0x1) 0)
        (+ offset 1)
        offset))))

;; Live-set and greedy-occupancy words use only their low 32 bits. Isolate the
;; lowest set bit and map its 32-bit De Bruijn product to the bit index. This
;; replaces the five dependent branch-and-shift steps in the hot register-
;; allocator scans with one multiply and one compact table lookup.
(define compiler-reg-low-bit-index32-table : (Array i64 32)
  (array
    (cast 0 : i64)
    1
    28
    2
    29
    14
    24
    3
    30
    22
    20
    15
    25
    17
    4
    8
    31
    27
    13
    23
    21
    19
    16
    7
    26
    12
    18
    6
    11
    5
    10
    9))

(defmacro (compiler-reg-low-bit-index32 [bits : i64]) : i64
  `(let
    [value : i64 (bit-and ,bits 0xffffffff)]
    (if (= value 0)
      (cast 31 : i64)
      (let
        [isolated : i64 (bit-and value (- 0 value))]
        [slot : i64 (shr (bit-and (* isolated 0x077cb531) 0xffffffff) 27)]
        (cast (array-ref compiler-reg-low-bit-index32-table slot) : i64)))))

;; The same De Bruijn lookup with the zero guard dropped. CALLERS MUST PROVE the
;; low 32 bits of `bits` are not all zero. Every use sits directly inside a
;; `(while (not (= bits 0)))` -- or the equivalent `(if (= bits 0) ..)` early
;; return -- over a live-set word, and a live-set word only ever carries bits
;; 0..31 (`compiler-live-set-bit-mask` shifts by `value & 31`, and
;; `compiler-live-set-word-bits` is 32); the whole walk family already depends on
;; that, since the guarded form answers 31 for a word whose only set bits are
;; high ones. A nonzero low half also makes the mask redundant: the lowest set
;; bit of `bits` then lies in the low 32, so `bits & (- bits)` isolates exactly
;; the bit `(bits & 0xffffffff) & (- (bits & 0xffffffff))` does. What the guarded
;; form spends on top of this and the nonzero form does not: a movabs of the
;; mask, an `and`, a `test`/`jne` pair, and -- because the dead `31` arm is a
;; second definition of the result -- a stack slot to phi the two arms through,
;; which costs a store on this arm and a reload at the merge.
;;
;; The bits-0..31 property survives everything the walks do to a word on the way
;; here: `bit-or` of two live-set words and `bit-and` with a phi-touched mask
;; word set no new positions, and `bits & (bits - 1)` -- how every one of these
;; loops advances -- only clears. So a word that reaches a use site nonzero has
;; a nonzero low half, whether it arrived raw, masked, or part-consumed.
(defmacro (compiler-reg-low-bit-index32-nonzero [bits : i64]) : i64
  `(let
    [value : i64 ,bits]
    [isolated : i64 (bit-and value (- 0 value))]
    [slot : i64 (shr (bit-and (* isolated 0x077cb531) 0xffffffff) 27)]
    (cast (array-ref compiler-reg-low-bit-index32-table slot) : i64)))

(define (compiler-reg-segment-flush-var!
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [var : i64]) : unit
  (if (or (< var 0) (>= var (array-length starts)) (< (array-ref starts var) 0))
    unit
    (let
      [existing : CompilerRegIntervalSeq (array-ref segments var)]
      [interval : CompilerRegInterval
        (CompilerRegInterval var (array-ref starts var) (array-ref ends var))]
      (begin
        (if (compiler-reg-interval-seq-empty? existing)
          (let
            [slots : (__tl_dyn-array CompilerRegInterval)
              (array.make-array CompilerRegInterval 1)]
            (begin
              (set! (array-ref slots 0) interval)
              (set! (array-ref segments var) (CompilerRegIntervalSeq slots 1))))
          (set!
            (array-ref segments var)
            (compiler-reg-interval-seq-append existing interval)))
        (set! (array-ref starts var) -1)
        (set! (array-ref ends var) -1)
        unit))))

(define (compiler-reg-segment-note-point!
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [var : i64]
  [point : i64]) : unit
  (if (or (< var 0) (>= var (array-length starts)))
    unit
    (if (< (array-ref starts var) 0)
      (begin
        (set! (array-ref starts var) point)
        (set! (array-ref ends var) point))
      (let
        [end : i64 (array-ref ends var)]
        (if (<= point (+ end 1))
          (if (> point end)
            (set! (array-ref ends var) point)
            unit)
          (begin
            (compiler-reg-segment-flush-var! segments starts ends var)
            (set! (array-ref starts var) point)
            (set! (array-ref ends var) point)))))))

;; Segment build for one instruction point: a def/use pass at `point` followed
;; by a live-after pass bridging `point`/`point + 1`. This replaces the four
;; separate word walks it once was (defs@point, uses@point, live-after@point,
;; live-after@point+1), and the def/use pass now takes the var ids directly
;; instead of decoding them back out of freshly built per-instruction bitsets.
;;
;; Equivalence: every step below reads and writes only the slot of the variable
;; it is handling, and the coarse `starts`/`ends` arrays are always distinct
;; from the segment `segment-starts`/`segment-ends` arrays, so operations on
;; different variables -- and the coarse-vs-segment operations for one variable
;; -- commute. The per-variable order is therefore all that matters, and it is
;; preserved:
;;   * defs and uses apply the SAME idempotent pair (extend the coarse interval
;;     to `point`, note `point` in the segment), so a variable that is both a
;;     def and a use gets one application, whether the two arrive OR'd into one
;;     word (the set form) or as a def id plus a use id (the id form);
;;   * live-after still notes `point` before `point + 1` (fused into the per-bit
;;     body of `compiler-reg-extend-segment-after-words!`) and still extends the
;;     coarse interval to `point + 1`.
;;
;; Bridging live-after into the SEGMENT at `point` (LLVM SlotIndex semantics: a
;; value live-OUT of this instruction is live AT it) makes a pass-through value
;; one continuous segment instead of degenerate single-point segments that
;; wrongly fail the half-open overlap test. A value whose LAST use is here is
;; NOT in live-after, so it still ends at `point`, preserving the def/use touch
;; that lets a copy/two-address result coalesce. Defs are marked at `point`
;; first, so this never extends a def back.
;;
;; The def/use half of the walk for one variable:
(define (compiler-reg-extend-segment-touch!
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [segment-starts : (__tl_dyn-array i64)]
  [segment-ends : (__tl_dyn-array i64)]
  [var : i64]
  [point : i64]) : unit
  (if (< var 0)
    unit
    (begin
      (compiler-reg-extend-interval starts ends var point)
      (compiler-reg-segment-note-point!
        segments
        segment-starts
        segment-ends
        var
        point))))

(define (compiler-reg-extend-segment-touch-ids!
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [segment-starts : (__tl_dyn-array i64)]
  [segment-ends : (__tl_dyn-array i64)]
  [ids : (__tl_dyn-array i64)]
  [id-count : i64]
  [point : i64]) : unit
  (let
    [index : i64 0]
    (while (< index id-count)
      (begin
        (compiler-reg-extend-segment-touch!
          starts
          ends
          segments
          segment-starts
          segment-ends
          (array-ref ids index)
          point)
        (set! index (+ index 1))))))

;; The live-after half: bridge every value live out of this instruction across
;; the `point`/`next` pair. This one stays a word walk and does not become an id
;; list -- live-after is a whole live row (36.9M of the 39.1M words this walk
;; reads in an opt2 self-compile), not a one-or-two-bit per-instruction set.
;;
;; A whole row is not a full row, though, and the walk pays for the difference:
;; of the 26,954,947 words it reads in an opt2 self-compile, 21.1M (78%) are
;; zero and carry the loop to the next word and nothing else, at 19 instructions
;; each. Two things are therefore kept out of the per-word step.
;; `compiler-live-set-word-at-bounded` reloads the set handle, the array handle
;; behind it and the data pointer behind that on every call, so the pointer is
;; taken once up front (`compiler-live-set-word-data`; heap allocation is a bump
;; into the active arena and nothing is moved or freed under a live value, and
;; nothing here writes to `live-after`, so it stays valid across the calls in
;; the body). And the word's bit base belongs to the bits, not to the word:
;; computing it in the item expression lets the loop hoist it into the inner
;; walk's preheader, charging the 5.9M words that carry a bit instead of all
;; 27.0M. Same words, same order, same values.
;;
;; The per-bit body spells out BOTH bridges instead of calling them. It used to
;; be a `compiler-reg-segment-note-span!` call -- inlined, since this was its
;; only call site -- followed by a `compiler-reg-extend-interval` call, which is
;; NOT inlined because ten other call sites keep it out of line. That second
;; call cost this walk a call/ret, four argument moves and a second `var < 0`
;; test on every live bit. The two bridges touch DISJOINT arrays --
;; `segments`/`segment-starts`/`segment-ends` versus `starts`/`ends` -- so they
;; commute, and the fused body applies exactly the same steps to the same slots
;; in the same order:
;;   * the segment half opens a segment when none is open, raises its end while
;;     `point` still adjoins it, and otherwise flushes and reopens. That is
;;     `(note-point! .. point)` followed by `(note-point! .. next)` -- with no
;;     open segment the pair opens one segment [point, next]; with
;;     `point <= end + 1` the first note can only raise `end` to `point`, which
;;     leaves `next <= end' + 1` true, so the second raises `end` to
;;     `max(end, next)`; with `point > end + 1` the first flushes and reopens at
;;     `point` and the second raises `end` to `next`;
;;   * the coarse half then extends `[starts[var], ends[var]]` to cover `next`,
;;     which is the body `compiler-reg-extend-interval` still runs for its other
;;     callers.
;; ONE range guard covers both halves, and the four i64 arrays are indexed
;; through backing pointers taken once in the preheader instead of through their
;; handles. This is what the fused loop is for: `compiler-reg-segment-flush-var!`
;; sits in the cold reopen arm, and a call in the loop stops the optimizer
;; hoisting anything out of it, so EVERY live bit was re-reading a handle, the
;; length behind it and the data pointer behind that, then re-testing the same
;; index -- eight instructions of array metadata per bit for two reads the loop
;; had already proven in range.
;;
;; The guard is what makes the raw indexing sound, and it is proven here rather
;; than assumed: `var-limit` is the MINIMUM of all four lengths, so
;; `0 <= item-var < var-limit` puts the index inside every one of them. (In
;; practice the four are equal -- `compiler-reg-live-interval-selection` is the
;; only root of this walk and allocates each as `(array.make-array i64 vars)` --
;; but nothing here depends on that.) `item-var < 0` stays tested: it cannot
;; happen (`index >= 0` and the De Bruijn table holds 0..31) but it is the other
;; half of the range proof, not a redundant test.
;;
;; The pointers stay valid across the loop. Nothing resizes these arrays --
;; `compiler-reg-segment-flush-var!` writes `segment-starts`/`segment-ends`
;; slots and one `segments` slot, and the sequence it appends to is a fresh
;; allocation -- and heap allocation is a bump into the active arena that never
;; moves or frees a live value. flush-var!'s own writes go through the handles
;; while this loop reads and writes through the pointers, but both name the same
;; backing store, so the -1 it parks in the flushed row is exactly what the next
;; `ptr-read` of that row sees.
(define (compiler-reg-extend-segment-after-words!
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [segment-starts : (__tl_dyn-array i64)]
  [segment-ends : (__tl_dyn-array i64)]
  [live-after : live.CompilerLiveI64Set]
  [point : i64]) : unit
  (let
    [after-words : i64 (live.compiler-live-set-word-count live-after)]
    [after-data : (MutPtr i64) (live.compiler-live-set-word-data live-after)]
    [starts-len : i64 (array-length starts)]
    [ends-len : i64 (array-length ends)]
    [segment-starts-len : i64 (array-length segment-starts)]
    [segment-ends-len : i64 (array-length segment-ends)]
    [coarse-limit : i64
      (if (< starts-len ends-len)
        starts-len
        ends-len)]
    [segment-limit : i64
      (if (< segment-starts-len segment-ends-len)
        segment-starts-len
        segment-ends-len)]
    [var-limit : i64
      (if (< coarse-limit segment-limit)
        coarse-limit
        segment-limit)]
    [starts-data : (MutPtr i64)
      (unsafe
        (array-data starts))]
    [ends-data : (MutPtr i64)
      (unsafe
        (array-data ends))]
    [segment-starts-data : (MutPtr i64)
      (unsafe
        (array-data segment-starts))]
    [segment-ends-data : (MutPtr i64)
      (unsafe
        (array-data segment-ends))]
    [next : i64 (+ point 1)]
    [index : i64 0]
    (while (< index after-words)
      (let
        [after-bits : i64
          (live.compiler-live-set-word-at-data after-data index)]
        (begin
          (while (not (= after-bits 0))
            (let
              [item-var : i64
                (+
                  (* index (live.compiler-live-set-word-bits))
                  (compiler-reg-low-bit-index32-nonzero after-bits))]
              (begin
                (if (or (< item-var 0) (>= item-var var-limit))
                  unit
                  (let
                    [open-start : i64
                      (unsafe
                        (ptr-read (ptr-offset segment-starts-data item-var)))]
                    (begin
                      (if (< open-start 0)
                        (unsafe
                          (begin
                            (ptr-write!
                              (ptr-offset segment-starts-data item-var)
                              point)
                            (ptr-write!
                              (ptr-offset segment-ends-data item-var)
                              next)))
                        (let
                          [open-end : i64
                            (unsafe
                              (ptr-read (ptr-offset segment-ends-data item-var)))]
                          (if (<= point (+ open-end 1))
                            (if (> next open-end)
                              (unsafe
                                (ptr-write!
                                  (ptr-offset segment-ends-data item-var)
                                  next))
                              unit)
                            (begin
                              (compiler-reg-segment-flush-var!
                                segments
                                segment-starts
                                segment-ends
                                item-var)
                              (unsafe
                                (begin
                                  (ptr-write!
                                    (ptr-offset segment-starts-data item-var)
                                    point)
                                  (ptr-write!
                                    (ptr-offset segment-ends-data item-var)
                                    next)))))))
                      (let
                        [start : i64
                          (unsafe
                            (ptr-read (ptr-offset starts-data item-var)))]
                        [end : i64
                          (unsafe
                            (ptr-read (ptr-offset ends-data item-var)))]
                        (begin
                          (if (< start 0)
                            (unsafe
                              (begin
                                (ptr-write!
                                  (ptr-offset starts-data item-var)
                                  next)
                                (ptr-write!
                                  (ptr-offset ends-data item-var)
                                  next)))
                            (begin
                              (if (< next start)
                                (unsafe
                                  (ptr-write!
                                    (ptr-offset starts-data item-var)
                                    next))
                                unit)
                              (if (> next end)
                                (unsafe
                                  (ptr-write!
                                    (ptr-offset ends-data item-var)
                                    next))
                                unit)))
                          unit)))))
                (set! after-bits (bit-and after-bits (- after-bits 1))))))
          (set! index (+ index 1)))))))

;; Id-driven build: the def is one var id and the uses are a short id list, so
;; neither needs a bitset. Only the per-variable ORDER of the two passes is
;; observable (every step reads and writes just the slots of the variable it
;; handles -- `starts`/`ends`, `segment-starts`/`segment-ends` and `segments`
;; are var-indexed and compiler-reg-segment-flush-var! touches only that var's
;; row -- so steps for different variables commute), and it is the same order
;; the fused walk used: def/use at `point` first, then the live-after span.
(define (compiler-reg-extend-segment-ids!
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [segment-starts : (__tl_dyn-array i64)]
  [segment-ends : (__tl_dyn-array i64)]
  [def-var : i64]
  [ids : (__tl_dyn-array i64)]
  [id-count : i64]
  [live-after : live.CompilerLiveI64Set]
  [point : i64]) : unit
  (begin
    (compiler-reg-extend-segment-touch!
      starts
      ends
      segments
      segment-starts
      segment-ends
      def-var
      point)
    (compiler-reg-extend-segment-touch-ids!
      starts
      ends
      segments
      segment-starts
      segment-ends
      ids
      id-count
      point)
    (compiler-reg-extend-segment-after-words!
      starts
      ends
      segments
      segment-starts
      segment-ends
      live-after
      point)))

;; Bitset build, kept for the rare instruction whose use list is wider than the
;; id buffer. Same two passes in the same per-variable order.
(define (compiler-reg-extend-segment-sets!
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [segment-starts : (__tl_dyn-array i64)]
  [segment-ends : (__tl_dyn-array i64)]
  [defs : live.CompilerLiveI64Set]
  [uses : live.CompilerLiveI64Set]
  [live-after : live.CompilerLiveI64Set]
  [point : i64]) : unit
  (let
    [defs-words : i64 (live.compiler-live-set-word-count defs)]
    [uses-words : i64 (live.compiler-live-set-word-count uses)]
    [word-count : i64
      (if (>= defs-words uses-words)
        defs-words
        uses-words)]
    [index : i64 0]
    (begin
      (while (< index word-count)
        (let
          [base : i64 (* index (live.compiler-live-set-word-bits))]
          ;; `compiler-live-set-word-at-bounded` is an unchecked read, so each
          ;; set is only touched inside its own word range; a shorter set
          ;; contributes no bits for the trailing words, exactly as its own
          ;; walk did.
          [touched : i64
            (bit-or
              (if (< index defs-words)
                (live.compiler-live-set-word-at-bounded defs index)
                0)
              (if (< index uses-words)
                (live.compiler-live-set-word-at-bounded uses index)
                0))]
          (begin
            (while (not (= touched 0))
              (let
                [item-var : i64
                  (+ base (compiler-reg-low-bit-index32-nonzero touched))]
                (begin
                  (compiler-reg-extend-segment-touch!
                    starts
                    ends
                    segments
                    segment-starts
                    segment-ends
                    item-var
                    point)
                  (set! touched (bit-and touched (- touched 1))))))
            (set! index (+ index 1)))))
      (compiler-reg-extend-segment-after-words!
        starts
        ends
        segments
        segment-starts
        segment-ends
        live-after
        point))))

(define (compiler-reg-extend-segment-instr!
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [segment-starts : (__tl_dyn-array i64)]
  [segment-ends : (__tl_dyn-array i64)]
  [live-after : live.CompilerLiveI64Set]
  [point : i64]
  [instr : ir.CompilerIrInstr]) : unit
  (let
    [ids : (__tl_dyn-array i64) (live.compiler-live-instr-ids)]
    [id-count : i64 (live.compiler-live-instr-use-ids! instr)]
    (if (< id-count 0)
      (compiler-reg-extend-segment-sets!
        starts
        ends
        segments
        segment-starts
        segment-ends
        (live.compiler-live-instr-defs instr)
        (live.compiler-live-instr-uses instr)
        live-after
        point)
      (compiler-reg-extend-segment-ids!
        starts
        ends
        segments
        segment-starts
        segment-ends
        (live.compiler-live-instr-def-var instr)
        ids
        id-count
        live-after
        point))))

(define (compiler-reg-extend-set-words
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [set : live.CompilerLiveI64Set]
  [word-index : i64]
  [point : i64]) : unit
  (let
    [index : i64 word-index]
    [word-count : i64 (live.compiler-live-set-word-count set)]
    (while (< index word-count)
      (begin
        ;; `compiler-reg-extend-set-word-bits` returns immediately for an empty
        ;; word, so testing here skips the call setup for the common case.
        (let
          [bits : i64 (live.compiler-live-set-word-at-bounded set index)]
          (if (= bits 0)
            unit
            (compiler-reg-extend-set-word-bits
              starts
              ends
              bits
              (* index (live.compiler-live-set-word-bits))
              point)))
        (set! index (+ index 1))))))

(define (compiler-reg-extend-set-word-bits
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [bits : i64]
  [var : i64]
  [point : i64]) : unit
  (if (= bits 0)
    unit
    (let
      [index : i64 (compiler-reg-low-bit-index32-nonzero bits)]
      (begin
        (compiler-reg-extend-interval starts ends (+ var index) point)
        (compiler-reg-extend-set-word-bits
          starts
          ends
          (bit-and bits (- bits 1))
          var
          point)))))

(define (compiler-reg-extend-interval-ids!
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [ids : (__tl_dyn-array i64)]
  [id-count : i64]
  [point : i64]) : unit
  (let
    [index : i64 0]
    (while (< index id-count)
      (begin
        (compiler-reg-extend-interval starts ends (array-ref ids index) point)
        (set! index (+ index 1))))))

;; Extend one instruction's coarse intervals. The def/use halves take the ids
;; directly (compiler-reg-extend-set-words exists only to recover those same ids
;; from freshly allocated bitsets); live-after stays a word walk.
(define (compiler-reg-extend-instr
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [live-after : live.CompilerLiveI64Set]
  [point : i64]
  [instr : ir.CompilerIrInstr]) : unit
  (let
    [ids : (__tl_dyn-array i64) (live.compiler-live-instr-ids)]
    [id-count : i64 (live.compiler-live-instr-use-ids! instr)]
    (begin
      (if (< id-count 0)
        (begin
          (compiler-reg-extend-set-words
            starts
            ends
            (live.compiler-live-instr-defs instr)
            0
            point)
          (compiler-reg-extend-set-words
            starts
            ends
            (live.compiler-live-instr-uses instr)
            0
            point))
        (begin
          (compiler-reg-extend-interval
            starts
            ends
            (live.compiler-live-instr-def-var instr)
            point)
          (compiler-reg-extend-interval-ids! starts ends ids id-count point)))
      (compiler-reg-extend-set-words starts ends live-after 0 (+ point 1)))))

(define (compiler-reg-live-intervals-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [live-afters : live.CompilerLiveInstrSetVec]
  [point : i64]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]) : i64
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [after-items : (__tl_dyn-array live.CompilerLiveI64Set) live-afters.items]
    [index : i64 0]
    [out-point : i64 point]
    (begin
      (while (< index count)
        (let
          [live-after : live.CompilerLiveI64Set
            (if (< index (array-length after-items))
              (array-ref after-items index)
              (live.compiler-live-set-empty))]
          (begin
            (compiler-reg-extend-instr
              starts
              ends
              live-after
              out-point
              (array-ref slots index))
            (set! out-point (+ out-point 2))
            (set! index (+ index 1)))))
      out-point)))

(define (compiler-reg-live-intervals-find-afters
  [liveness : live.CompilerFunctionLiveness]
  [label : i64]) : live.CompilerLiveInstrSetVec
  (match (live.compiler-live-function-find-block liveness label)
    [(live.CompilerLiveMaybeBlock.Some live-block)
      (live.compiler-live-block-instr-after live-block)]
    [(live.CompilerLiveMaybeBlock.No) (live.compiler-live-instr-set-vec-empty)]))

(define (compiler-reg-live-intervals-blocks-with-live
  [blocks : ir.CompilerIrBlockList]
  [liveness : live.CompilerFunctionLiveness]
  [point : i64]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) point]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (let
            [live-afters : live.CompilerLiveInstrSetVec
              (compiler-reg-live-intervals-find-afters liveness label)]
            (compiler-reg-live-intervals-blocks-with-live
              (__tl-box-place rest)
              liveness
              (compiler-reg-live-intervals-instr-seq
                instrs
                live-afters
                point
                starts
                ends)
              starts
              ends))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out-point : i64 point]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block label instrs)
                  (let
                    [live-afters : live.CompilerLiveInstrSetVec
                      (compiler-reg-live-intervals-find-afters liveness label)]
                    (set!
                      out-point
                      (compiler-reg-live-intervals-instr-seq
                        instrs
                        live-afters
                        out-point
                        starts
                        ends)))])
              (set! i (+ i 1))))
          out-point))]))

(define (compiler-reg-interval-arrays-to-seq
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [index : i64]
  [acc : CompilerRegIntervalSeq]) : CompilerRegIntervalSeq
  (let
    [old-slots : (__tl_dyn-array CompilerRegInterval) acc.slots]
    [old-len : i64 acc.len]
    [additional-capacity : i64
      (if (< index 0)
        0
        (+ index 1))]
    [slots : (__tl_dyn-array CompilerRegInterval)
      (array.make-array CompilerRegInterval (+ old-len additional-capacity))]
    [out-len : i64 old-len]
    [copy-index : i64 0]
    [var : i64 0]
    (begin
      (while (< copy-index old-len)
        (begin
          (set! (array-ref slots copy-index) (array-ref old-slots copy-index))
          (set! copy-index (+ copy-index 1))))
      (while (<= var index)
        (begin
          (if (< (array-ref starts var) 0)
            unit
            (begin
              (set!
                (array-ref slots out-len)
                (CompilerRegInterval
                  var
                  (array-ref starts var)
                  (array-ref ends var)))
              (set! out-len (+ out-len 1))))
          (set! var (+ var 1))))
      (CompilerRegIntervalSeq slots out-len))))

(define (compiler-reg-live-intervals
  [func : ir.CompilerIrFunction]
  [liveness : live.CompilerFunctionLiveness]) : CompilerRegIntervalSeq
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ vars blocks)
      (let
        [starts : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [ends : (__tl_dyn-array i64) (array.make-array i64 vars)]
        (begin
          (compiler-reg-fill-i64-array starts -1)
          (compiler-reg-fill-i64-array ends -1)
          (compiler-reg-live-intervals-blocks-with-live
            blocks
            liveness
            0
            starts
            ends)
          (compiler-reg-interval-arrays-to-seq
            starts
            ends
            (- vars 1)
            (compiler-reg-interval-seq-empty))))]))

(define (compiler-reg-live-interval-selection-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [live-afters : live.CompilerLiveInstrSetVec]
  [point : i64]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [segment-starts : (__tl_dyn-array i64)]
  [segment-ends : (__tl_dyn-array i64)]) : i64
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [after-items : (__tl_dyn-array live.CompilerLiveI64Set) live-afters.items]
    [index : i64 0]
    [out-point : i64 point]
    (begin
      (while (< index count)
        (let
          [live-after : live.CompilerLiveI64Set
            (if (< index (array-length after-items))
              (array-ref after-items index)
              (live.compiler-live-set-empty))]
          [instr : ir.CompilerIrInstr (array-ref slots index)]
          (begin
            (compiler-reg-extend-segment-instr!
              starts
              ends
              segments
              segment-starts
              segment-ends
              live-after
              out-point
              instr)
            (set! out-point (+ out-point 2))
            (set! index (+ index 1)))))
      out-point)))

(define (compiler-reg-live-interval-selection-blocks
  [blocks : ir.CompilerIrBlockList]
  [liveness : live.CompilerFunctionLiveness]
  [point : i64]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [segment-starts : (__tl_dyn-array i64)]
  [segment-ends : (__tl_dyn-array i64)]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) point]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (let
            [live-afters : live.CompilerLiveInstrSetVec
              (compiler-reg-live-intervals-find-afters liveness label)]
            (compiler-reg-live-interval-selection-blocks
              (__tl-box-place rest)
              liveness
              (compiler-reg-live-interval-selection-instr-seq
                instrs
                live-afters
                point
                starts
                ends
                segments
                segment-starts
                segment-ends)
              starts
              ends
              segments
              segment-starts
              segment-ends))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out-point : i64 point]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block label instrs)
                  (let
                    [live-afters : live.CompilerLiveInstrSetVec
                      (compiler-reg-live-intervals-find-afters liveness label)]
                    (set!
                      out-point
                      (compiler-reg-live-interval-selection-instr-seq
                        instrs
                        live-afters
                        out-point
                        starts
                        ends
                        segments
                        segment-starts
                        segment-ends)))])
              (set! i (+ i 1))))
          out-point))]))

(define (compiler-reg-live-interval-selection
  [func : ir.CompilerIrFunction]
  [liveness : live.CompilerFunctionLiveness]) : CompilerRegIntervalSelection
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ vars blocks)
      (let
        [starts : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [ends : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [segments : (__tl_dyn-array CompilerRegIntervalSeq)
          (array.make-array CompilerRegIntervalSeq vars)]
        [segment-starts : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [segment-ends : (__tl_dyn-array i64) (array.make-array i64 vars)]
        (begin
          (compiler-reg-fill-i64-array starts -1)
          (compiler-reg-fill-i64-array ends -1)
          (compiler-reg-fill-i64-array segment-starts -1)
          (compiler-reg-fill-i64-array segment-ends -1)
          (compiler-reg-live-interval-selection-blocks
            blocks
            liveness
            0
            starts
            ends
            segments
            segment-starts
            segment-ends)
          (let
            [index : i64 0]
            (while (< index vars)
              (begin
                (compiler-reg-segment-flush-var!
                  segments
                  segment-starts
                  segment-ends
                  index)
                (set! index (+ index 1)))))
          (CompilerRegIntervalSelection.Selection
            (compiler-reg-interval-arrays-to-seq
              starts
              ends
              (- vars 1)
              (compiler-reg-interval-seq-empty))
            (CompilerRegIntervalIndex starts ends segments))))]))

;; ---------------------------------------------------------------------------
;; Edge-precise segment build (used only for the coalescer's interference index).
;; Identical to the conservative builder EXCEPT a phi instruction contributes NO
;; uses at the phi point -- its inputs are edge-uses, already kept live to the end
;; of their own predecessor by compiler-live-analyze-function-edge-precise's
;; phi-out live-out. The phi result is still a def at the phi point, and live-after
;; bridging is unchanged. This drops the spurious phi-input segments that make a
;; loop carry falsely interfere with itself.
;;
;; The single consumer (`compiler-reg-hybrid-coalesce-index`) reads ONLY the
;; per-var segment rows of the phi-touched vars, and takes the coarse
;; start/end arrays from the CONSERVATIVE index -- so the EP build's coarse
;; interval work is dead, and so is every segment row of a var the mask does
;; not select (3.16% of vars are phi-touched in an opt2 self-compile). This
;; build therefore takes the mask up front and writes only the rows that will
;; be read.
;;
;; Row equivalence: every step of the walk reads and writes only the slots of
;; the variable it is handling (`segment-starts` / `segment-ends` / `segments`
;; are var-indexed and `compiler-reg-segment-flush-var!` touches one row), so
;; steps for different variables commute and dropping the unselected ones
;; leaves each selected variable seeing exactly the same ordered sequence of
;; touches -- def/use at `point`, then the live-after span `point`/`point + 1`,
;; in ascending word then ascending bit order -- that the unmasked walk gave
;; it. The rows the mask drops are the rows the consumer discards.
;; ---------------------------------------------------------------------------
;; Pack the 0/1 phi-touched mask into live-set-shaped words so the live-after
;; bridge can select its bits with one AND. Returns the word array; the count
;; of words up to and including the last non-empty one is taken separately so
;; the bridge can stop early.
(define (compiler-reg-ep-mask-words [mask : (__tl_dyn-array i64)] [vars : i64]) : (__tl_dyn-array
    i64)
  (let
    [word-count : i64
      (if (< vars 1)
        1
        (+ (live.compiler-live-set-word-index (- vars 1)) 1))]
    [words : (__tl_dyn-array i64) (array.make-array i64 word-count)]
    [v : i64 0]
    [limit : i64
      (if (< vars (array-length mask))
        vars
        (array-length mask))]
    (begin
      (while (< v limit)
        (begin
          (if (= (array-ref mask v) 1)
            (let
              [w : i64 (live.compiler-live-set-word-index v)]
              (set!
                (array-ref words w)
                (bit-or (array-ref words w) (live.compiler-live-set-bit-mask v))))
            unit)
          (set! v (+ v 1))))
      words)))

(define (compiler-reg-ep-mask-word-limit [words : (__tl_dyn-array i64)]) : i64
  (let
    [i : i64 (array-length words)]
    (begin
      (while (and (> i 0) (= (array-ref words (- i 1)) 0))
        (set! i (- i 1)))
      i)))

(define (compiler-reg-ep-selected? [mask : (__tl_dyn-array i64)] [var : i64]) : bool
  (and (>= var 0) (< var (array-length mask)) (= (array-ref mask var) 1)))

(define (compiler-reg-ep-touch!
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [segment-starts : (__tl_dyn-array i64)]
  [segment-ends : (__tl_dyn-array i64)]
  [mask : (__tl_dyn-array i64)]
  [var : i64]
  [point : i64]) : unit
  (if (compiler-reg-ep-selected? mask var)
    (compiler-reg-segment-note-point!
      segments
      segment-starts
      segment-ends
      var
      point)
    unit))

(define (compiler-reg-ep-touch-ids!
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [segment-starts : (__tl_dyn-array i64)]
  [segment-ends : (__tl_dyn-array i64)]
  [mask : (__tl_dyn-array i64)]
  [ids : (__tl_dyn-array i64)]
  [id-count : i64]
  [point : i64]) : unit
  (let
    [index : i64 0]
    (while (< index id-count)
      (begin
        (compiler-reg-ep-touch!
          segments
          segment-starts
          segment-ends
          mask
          (array-ref ids index)
          point)
        (set! index (+ index 1))))))

;; The segment-bridge body is spelled out here rather than called, exactly as
;; the conservative walk (`compiler-reg-extend-segment-after-words!`) spells out
;; its own copy: a shared helper would be a call per live bit in BOTH walks, and
;; two callers keep it out of line. The steps and their order are identical in
;; both -- open the segment when none is open, otherwise raise its end when
;; `point` still adjoins it, and otherwise flush and reopen -- so the rows
;; produced are the same.
;;
;; This is the phi-masked twin of `compiler-reg-extend-segment-after-words!` and
;; it takes the same treatment for the same reason. `flush-var!` sits in the
;; cold reopen arm, and a call in the loop stops the optimizer hoisting anything
;; out of it, so every live bit re-read a handle, the length behind it and the
;; data pointer behind that, for each of the two arrays it touches -- array
;; metadata for reads the loop had already proven in range. The three word
;; arrays and the live-after backing are read through pointers taken once in the
;; preheader, and the word's bit base moves into the item expression so the
;; inner walk's preheader charges it to the words that carry a bit rather than
;; to every word. Same words, same order, same values.
;;
;; Both range proofs are LOCAL and neither rests on a caller contract:
;;   * `limit` is the minimum of `after-words`, `mask-limit` AND the mask array's
;;     own length, so `0 <= index < limit` is inside both backings. The third
;;     term never binds -- `compiler-reg-ep-mask-word-limit` counts down from
;;     `(array-length words)` -- but taking it here is what makes the raw mask
;;     read sound without knowing that.
;;   * `var-limit` is the MINIMUM of the two segment array lengths, so
;;     `0 <= item-var < var-limit` puts the index inside both. The guard is new
;;     only in the sense that the bounds check used to be the array-ref's own:
;;     `item-var` is already in range on every path (the mask word only carries
;;     bits for `v < vars`, and both arrays are `vars` long), so the arm the
;;     guard adds is dead. `item-var < 0` cannot happen either -- `index >= 0`
;;     and the De Bruijn table holds 0..31 -- but it is the other half of the
;;     range proof, not a redundant test.
;; The pointers stay valid across the loop for the reason the conservative walk
;; gives: heap allocation is a bump into the active arena that never moves or
;; frees a live value, nothing here resizes these arrays, and nothing writes to
;; `live-after` or `mask-words`. `flush-var!` writes `segment-starts` /
;; `segment-ends` slots through the handles while this loop reads and writes
;; through the pointers, but both name the same backing store, so the -1 it
;; parks in the flushed row is exactly what the next `ptr-read` of that row
;; sees.
(define (compiler-reg-ep-after-words!
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [segment-starts : (__tl_dyn-array i64)]
  [segment-ends : (__tl_dyn-array i64)]
  [live-after : live.CompilerLiveI64Set]
  [mask-words : (__tl_dyn-array i64)]
  [mask-limit : i64]
  [point : i64]) : unit
  (let
    [after-words : i64 (live.compiler-live-set-word-count live-after)]
    [after-data : (MutPtr i64) (live.compiler-live-set-word-data live-after)]
    [mask-len : i64 (array-length mask-words)]
    [mask-data : (MutPtr i64)
      (unsafe
        (array-data mask-words))]
    [word-limit : i64
      (if (< after-words mask-limit)
        after-words
        mask-limit)]
    [limit : i64
      (if (< word-limit mask-len)
        word-limit
        mask-len)]
    [segment-starts-len : i64 (array-length segment-starts)]
    [segment-ends-len : i64 (array-length segment-ends)]
    [var-limit : i64
      (if (< segment-starts-len segment-ends-len)
        segment-starts-len
        segment-ends-len)]
    [segment-starts-data : (MutPtr i64)
      (unsafe
        (array-data segment-starts))]
    [segment-ends-data : (MutPtr i64)
      (unsafe
        (array-data segment-ends))]
    [next : i64 (+ point 1)]
    [index : i64 0]
    (while (< index limit)
      (let
        [after-bits : i64
          (bit-and
            (live.compiler-live-set-word-at-data after-data index)
            (unsafe
              (ptr-read (ptr-offset mask-data index))))]
        (begin
          (while (not (= after-bits 0))
            (let
              [item-var : i64
                (+
                  (* index (live.compiler-live-set-word-bits))
                  (compiler-reg-low-bit-index32-nonzero after-bits))]
              (begin
                (if (or (< item-var 0) (>= item-var var-limit))
                  unit
                  (let
                    [open-start : i64
                      (unsafe
                        (ptr-read (ptr-offset segment-starts-data item-var)))]
                    (if (< open-start 0)
                      (unsafe
                        (begin
                          (ptr-write!
                            (ptr-offset segment-starts-data item-var)
                            point)
                          (ptr-write!
                            (ptr-offset segment-ends-data item-var)
                            next)))
                      (let
                        [open-end : i64
                          (unsafe
                            (ptr-read (ptr-offset segment-ends-data item-var)))]
                        (if (<= point (+ open-end 1))
                          (if (> next open-end)
                            (unsafe
                              (ptr-write!
                                (ptr-offset segment-ends-data item-var)
                                next))
                            unit)
                          (begin
                            (compiler-reg-segment-flush-var!
                              segments
                              segment-starts
                              segment-ends
                              item-var)
                            (unsafe
                              (begin
                                (ptr-write!
                                  (ptr-offset segment-starts-data item-var)
                                  point)
                                (ptr-write!
                                  (ptr-offset segment-ends-data item-var)
                                  next)))))))))
                (set! after-bits (bit-and after-bits (- after-bits 1))))))
          (set! index (+ index 1)))))))

(define (compiler-reg-ep-sets!
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [segment-starts : (__tl_dyn-array i64)]
  [segment-ends : (__tl_dyn-array i64)]
  [defs : live.CompilerLiveI64Set]
  [uses : live.CompilerLiveI64Set]
  [live-after : live.CompilerLiveI64Set]
  [mask-words : (__tl_dyn-array i64)]
  [mask-limit : i64]
  [point : i64]) : unit
  (let
    [defs-words : i64 (live.compiler-live-set-word-count defs)]
    [uses-words : i64 (live.compiler-live-set-word-count uses)]
    [widest : i64
      (if (>= defs-words uses-words)
        defs-words
        uses-words)]
    [word-count : i64
      (if (< widest mask-limit)
        widest
        mask-limit)]
    [index : i64 0]
    (begin
      (while (< index word-count)
        (let
          [base : i64 (* index (live.compiler-live-set-word-bits))]
          [touched : i64
            (bit-and
              (bit-or
                (if (< index defs-words)
                  (live.compiler-live-set-word-at-bounded defs index)
                  0)
                (if (< index uses-words)
                  (live.compiler-live-set-word-at-bounded uses index)
                  0))
              (array-ref mask-words index))]
          (begin
            (while (not (= touched 0))
              (let
                [item-var : i64
                  (+ base (compiler-reg-low-bit-index32-nonzero touched))]
                (begin
                  (compiler-reg-segment-note-point!
                    segments
                    segment-starts
                    segment-ends
                    item-var
                    point)
                  (set! touched (bit-and touched (- touched 1))))))
            (set! index (+ index 1)))))
      (compiler-reg-ep-after-words!
        segments
        segment-starts
        segment-ends
        live-after
        mask-words
        mask-limit
        point))))

(define (compiler-reg-extend-segment-instr-ep!
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [segment-starts : (__tl_dyn-array i64)]
  [segment-ends : (__tl_dyn-array i64)]
  [mask : (__tl_dyn-array i64)]
  [mask-words : (__tl_dyn-array i64)]
  [mask-limit : i64]
  [live-after : live.CompilerLiveI64Set]
  [point : i64]
  [instr : ir.CompilerIrInstr]) : unit
  (let
    [ids : (__tl_dyn-array i64) (live.compiler-live-instr-ids)]
    [id-count : i64 (live.compiler-live-instr-use-ids-nophi! instr)]
    (if (< id-count 0)
      (compiler-reg-ep-sets!
        segments
        segment-starts
        segment-ends
        (live.compiler-live-instr-defs instr)
        (live.compiler-live-instr-uses-nophi instr)
        live-after
        mask-words
        mask-limit
        point)
      (begin
        (compiler-reg-ep-touch!
          segments
          segment-starts
          segment-ends
          mask
          (live.compiler-live-instr-def-var instr)
          point)
        (compiler-reg-ep-touch-ids!
          segments
          segment-starts
          segment-ends
          mask
          ids
          id-count
          point)
        (compiler-reg-ep-after-words!
          segments
          segment-starts
          segment-ends
          live-after
          mask-words
          mask-limit
          point)))))

(define (compiler-reg-live-interval-selection-ep-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [live-afters : live.CompilerLiveInstrSetVec]
  [point : i64]
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [segment-starts : (__tl_dyn-array i64)]
  [segment-ends : (__tl_dyn-array i64)]
  [mask : (__tl_dyn-array i64)]
  [mask-words : (__tl_dyn-array i64)]
  [mask-limit : i64]) : i64
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [after-items : (__tl_dyn-array live.CompilerLiveI64Set) live-afters.items]
    [index : i64 0]
    [out-point : i64 point]
    (begin
      (while (< index count)
        (let
          [live-after : live.CompilerLiveI64Set
            (if (< index (array-length after-items))
              (array-ref after-items index)
              (live.compiler-live-set-empty))]
          [instr : ir.CompilerIrInstr (array-ref slots index)]
          (begin
            (compiler-reg-extend-segment-instr-ep!
              segments
              segment-starts
              segment-ends
              mask
              mask-words
              mask-limit
              live-after
              out-point
              instr)
            (set! out-point (+ out-point 2))
            (set! index (+ index 1)))))
      out-point)))

(define (compiler-reg-live-interval-selection-ep-blocks
  [blocks : ir.CompilerIrBlockList]
  [liveness : live.CompilerFunctionLiveness]
  [point : i64]
  [segments : (__tl_dyn-array CompilerRegIntervalSeq)]
  [segment-starts : (__tl_dyn-array i64)]
  [segment-ends : (__tl_dyn-array i64)]
  [mask : (__tl_dyn-array i64)]
  [mask-words : (__tl_dyn-array i64)]
  [mask-limit : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) point]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (let
            [live-afters : live.CompilerLiveInstrSetVec
              (compiler-reg-live-intervals-find-afters liveness label)]
            (compiler-reg-live-interval-selection-ep-blocks
              (__tl-box-place rest)
              liveness
              (compiler-reg-live-interval-selection-ep-instr-seq
                instrs
                live-afters
                point
                segments
                segment-starts
                segment-ends
                mask
                mask-words
                mask-limit)
              segments
              segment-starts
              segment-ends
              mask
              mask-words
              mask-limit))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out-point : i64 point]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block label instrs)
                  (let
                    [live-afters : live.CompilerLiveInstrSetVec
                      (compiler-reg-live-intervals-find-afters liveness label)]
                    (set!
                      out-point
                      (compiler-reg-live-interval-selection-ep-instr-seq
                        instrs
                        live-afters
                        out-point
                        segments
                        segment-starts
                        segment-ends
                        mask
                        mask-words
                        mask-limit)))])
              (set! i (+ i 1))))
          out-point))]))

;; Returns just the per-var EP segment rows for the masked vars; every other
;; row is the empty sequence the consumer would have discarded anyway.
(define (compiler-reg-live-interval-selection-ep-segments
  [func : ir.CompilerIrFunction]
  [liveness : live.CompilerFunctionLiveness]
  [mask : (__tl_dyn-array i64)]) : (__tl_dyn-array CompilerRegIntervalSeq)
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ vars blocks)
      (let
        [segments : (__tl_dyn-array CompilerRegIntervalSeq)
          (array.make-array CompilerRegIntervalSeq vars)]
        [segment-starts : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [segment-ends : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [mask-words : (__tl_dyn-array i64)
          (compiler-reg-ep-mask-words mask vars)]
        [mask-limit : i64 (compiler-reg-ep-mask-word-limit mask-words)]
        (begin
          (compiler-reg-fill-i64-array segment-starts -1)
          (compiler-reg-fill-i64-array segment-ends -1)
          (if (> mask-limit 0)
            (let
              [_end-point : i64
                (compiler-reg-live-interval-selection-ep-blocks
                  blocks
                  liveness
                  0
                  segments
                  segment-starts
                  segment-ends
                  mask
                  mask-words
                  mask-limit)]
              unit)
            unit)
          (let
            [index : i64 0]
            (while (< index vars)
              (begin
                (if (compiler-reg-ep-selected? mask index)
                  (compiler-reg-segment-flush-var!
                    segments
                    segment-starts
                    segment-ends
                    index)
                  unit)
                (set! index (+ index 1)))))
          segments))]))

;; ---------------------------------------------------------------------------
;; Hybrid coalescing interference index (SOUND containment of edge-precise).
;;
;; Edge-precise (EP) liveness is the precise SSA interference, but using it for
;; EVERY var is risky: a single EP bug for a non-carry value would mis-coalesce it.
;; We only NEED EP precision for the loop-carry phi web (phi results + their
;; inputs); every other value's conservative interference is already correct.
;;
;; So the hybrid index keeps the CONSERVATIVE coarse [start,end] for all vars and
;; the CONSERVATIVE segments for non-phi-touched vars, substituting EP segments
;; ONLY for phi-touched vars (a phi result or a phi input). Soundness: for a pair
;; (A phi-touched, B not), the overlap test compares A's EP segments against B's
;; CONSERVATIVE segments; since conservative over-approximates B's real liveness,
;; any real interference of A with B is still detected -- only A-vs-A' (both
;; phi-touched carry-web members) get the precise relaxation. A non-phi value (e.g.
;; a struct field bound by a match) therefore can never be wrongly coalesced.
;; ---------------------------------------------------------------------------
(define (compiler-reg-phi-touched-add-inputs!
  [inputs : ir.CompilerIrPhiInputList]
  [mask : (__tl_dyn-array i64)]) : unit
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) unit]
    [(ir.CompilerIrPhiInputList.Array seq)
      (compiler-reg-phi-touched-add-inputs!
        (ir.compiler-ir-phi-input-seq-to-list seq)
        mask)]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (begin
        (match value
          [(ir.CompilerIrValue.Var v) (compiler-reg-mark-phi-def! mask v)]
          [_ unit])
        (compiler-reg-phi-touched-add-inputs! (__tl-box-place rest) mask))]))

;; ---------------------------------------------------------------------------
;; Live-out-input phi exclusion (soundness guard on the EP coalescer).
;;
;; Edge-precise coalescing of a phi carry is safe only when every phi input DIES at
;; the phi -- i.e. is consumed on its predecessor edge and not live past the phi's
;; block. When an input is instead live-OUT of the phi block (e.g. a mutable loop
;; counter `v` that is a phi input to an in-loop `(if ... a v)` merge yet is also used
;; across the rest of the loop), its edge-precise segment collapses to the tiny
;; predecessor-edge slice, understating how entangled it is; coalescing this phi's
;; result with a (dead) sibling input then shares a register across a region where the
;; entangled input is genuinely live, corrupting it (this is exactly the
;; `compiler-reg-merged-root-index` self-host mis-coalesce the fixpoint caught).
;;
;; So a phi with ANY live-out input is normally EXCLUDED from EP relaxation: its
;; result and inputs fall back to conservative interference. The narrow exception is
;; a single-block self-loop back-edge value that is DEFINED in the block and has no
;; ordinary (non-phi) use there. Such a value is live-out only to feed successor phi
;; edges: sharing its storage with the header phi is exactly the destructive loop
;; carry, while a counter still used by the exit compare fails the non-phi-use proof.
;; Pure loop/if-merge carries whose inputs are all dead after the merge stay relaxed
;; as before. Using the sound EP block live-out here can only over-exclude (a missed
;; coalesce), never under-exclude.
;; ---------------------------------------------------------------------------
(define (compiler-reg-block-live-out-by-label
  [liveness : live.CompilerFunctionLiveness]
  [label : i64]) : live.CompilerLiveI64Set
  (match (live.compiler-live-function-find-block liveness label)
    [(live.CompilerLiveMaybeBlock.Some lb) lb.live-out]
    [(live.CompilerLiveMaybeBlock.No) (live.compiler-live-set-empty)]))

(define (compiler-reg-phi-inputs-any-live-out?
  [inputs : ir.CompilerIrPhiInputList]
  [live-out : live.CompilerLiveI64Set]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) false]
    [(ir.CompilerIrPhiInputList.Array seq)
      (compiler-reg-phi-inputs-any-live-out?
        (ir.compiler-ir-phi-input-seq-to-list seq)
        live-out)]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (if (match value
        [(ir.CompilerIrValue.Var v)
          (live.compiler-live-set-contains? live-out v)]
        [_ false])
        true
        (compiler-reg-phi-inputs-any-live-out? (__tl-box-place rest) live-out))]))

(define (compiler-reg-instr-seq-defines-var?
  [instrs : ir.CompilerIrInstrSeq]
  [var : i64]) : bool
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (< index count) (not found))
        (begin
          (if (and
            (>= var 0)
            (= (compiler-reg-instr-def-var (array-ref slots index)) var))
            (set! found true)
            unit)
          (set! index (+ index 1))))
      found)))

(define (compiler-reg-instr-seq-non-phi-uses-var?
  [instrs : ir.CompilerIrInstrSeq]
  [var : i64]) : bool
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (< index count) (not found))
        (let
          [instr : ir.CompilerIrInstr (array-ref slots index)]
          (begin
            (match instr
              [(ir.CompilerIrInstr.Phi _ _ _) unit]
              [_
                (if (live.compiler-live-set-contains?
                  (live.compiler-live-instr-uses instr)
                  var)
                  (set! found true)
                  unit)])
            (set! index (+ index 1)))))
      found)))

(define (compiler-reg-phi-live-out-inputs-self-loop-safe?
  [inputs : ir.CompilerIrPhiInputList]
  [live-out : live.CompilerLiveI64Set]
  [instrs : ir.CompilerIrInstrSeq]
  [block-label : i64]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) true]
    [(ir.CompilerIrPhiInputList.Array seq)
      (compiler-reg-phi-live-out-inputs-self-loop-safe?
        (ir.compiler-ir-phi-input-seq-to-list seq)
        live-out
        instrs
        block-label)]
    [(ir.CompilerIrPhiInputList.Cons value predecessor rest)
      (and
        (match value
          [(ir.CompilerIrValue.Var var)
            (if (live.compiler-live-set-contains? live-out var)
              (and
                (= predecessor block-label)
                (compiler-reg-instr-seq-defines-var? instrs var)
                (not (compiler-reg-instr-seq-non-phi-uses-var? instrs var)))
              true)]
          [_ true])
        (compiler-reg-phi-live-out-inputs-self-loop-safe?
          (__tl-box-place rest)
          live-out
          instrs
          block-label))]))

(define (compiler-reg-phi-touched-safe-seq!
  [instrs : ir.CompilerIrInstrSeq]
  [live-out : live.CompilerLiveI64Set]
  [self-loop : bool]
  [block-label : i64]
  [mask : (__tl_dyn-array i64)]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (match (array-ref slots index)
            [(ir.CompilerIrInstr.Phi dst inputs _)
              (if (and
                (compiler-reg-phi-inputs-any-live-out? inputs live-out)
                (not
                  (and
                    self-loop
                    (compiler-reg-phi-live-out-inputs-self-loop-safe?
                      inputs
                      live-out
                      instrs
                      block-label))))
                unit
                (begin
                  (compiler-reg-mark-phi-def! mask dst)
                  (compiler-reg-phi-touched-add-inputs! inputs mask)))]
            [_ unit])
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-phi-touched-safe-blocks!
  [blocks : ir.CompilerIrBlockList]
  [liveness : live.CompilerFunctionLiveness]
  [allow-exit-live-self-loop : bool]
  [mask : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (begin
            (compiler-reg-phi-touched-safe-seq!
              instrs
              (compiler-reg-block-live-out-by-label liveness label)
              (and
                allow-exit-live-self-loop
                (live.compiler-live-label-set-contains?
                  (live.compiler-live-block-successors block)
                  label))
              label
              mask)
            (compiler-reg-phi-touched-safe-blocks!
              (__tl-box-place rest)
              liveness
              allow-exit-live-self-loop
              mask))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block label instrs)
                (compiler-reg-phi-touched-safe-seq!
                  instrs
                  (compiler-reg-block-live-out-by-label liveness label)
                  (and
                    allow-exit-live-self-loop
                    (live.compiler-live-label-set-contains?
                      (live.compiler-live-block-successors
                        (ir.compiler-ir-block-seq-ref seq i))
                      label))
                  label
                  mask)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-function-phi-touched-safe-mode
  [func : ir.CompilerIrFunction]
  [liveness : live.CompilerFunctionLiveness]
  [allow-exit-live-self-loop : bool]) : (__tl_dyn-array i64)
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ vars blocks)
      (let
        [mask : (__tl_dyn-array i64) (array.make-array i64 vars)]
        (begin
          (compiler-reg-phi-touched-safe-blocks!
            blocks
            liveness
            allow-exit-live-self-loop
            mask)
          mask))]))

(define (compiler-reg-function-phi-touched-safe
  [func : ir.CompilerIrFunction]
  [liveness : live.CompilerFunctionLiveness]) : (__tl_dyn-array i64)
  (compiler-reg-function-phi-touched-safe-mode func liveness true))

;; Hybrid segments: EP segments for phi-touched vars, conservative otherwise.
(define (compiler-reg-hybrid-coalesce-index
  [cons-index : CompilerRegIntervalIndex]
  [ep-segs : (__tl_dyn-array CompilerRegIntervalSeq)]
  [mask : (__tl_dyn-array i64)]) : CompilerRegIntervalIndex
  (let
    [cons-starts : (__tl_dyn-array i64) cons-index.starts]
    [cons-ends : (__tl_dyn-array i64) cons-index.ends]
    [cons-segs : (__tl_dyn-array CompilerRegIntervalSeq) cons-index.segments]
    [n : i64 (array-length cons-starts)]
    [hybrid-segs : (__tl_dyn-array CompilerRegIntervalSeq)
      (array.make-array CompilerRegIntervalSeq n)]
    [v : i64 0]
    (begin
      (while (< v n)
        (begin
          (set!
            (array-ref hybrid-segs v)
            (if (if (< v (array-length mask))
              (= (array-ref mask v) 1)
              false)
              (if (< v (array-length ep-segs))
                (array-ref ep-segs v)
                (compiler-reg-interval-seq-empty))
              (if (< v (array-length cons-segs))
                (array-ref cons-segs v)
                (compiler-reg-interval-seq-empty))))
          (set! v (+ v 1))))
      (CompilerRegIntervalIndex cons-starts cons-ends hybrid-segs))))

;; ---------------------------------------------------------------------------
;; Cheap block-level liveness for register planning (#perf).
;;
;; The register allocator only needs, per variable, a single [first-live,
;; last-live] interval, which can be built from block-level live-in/live-out plus
;; per-instruction mentions. This pass reuses the tested use/def/successor
;; extraction from compiler-live-build-blocks, then runs the backward dataflow
;; fixpoint over MUTABLE i64-word bitsets (in place, no per-operation allocation),
;; instead of the shared liveness pass's immutable linked-list bitset unions and
;; per-instruction live-after materialization. Block-level live-in/out keeps the
;; intervals sound across control flow that pure mention ranges miss (a
;; loop-carried value is live-out of the body and live-in of the header, so its
;; interval covers the whole loop). 63 data bits per word avoid the i64 sign bit.
;; ---------------------------------------------------------------------------
(define (compiler-reg-bits-words [vars : i64]) : i64
  (/ (+ vars 62) 63))

(define (compiler-reg-bits-set!
  [row : (__tl_dyn-array i64)]
  [base : i64]
  [var : i64]) : unit
  (let
    [w : i64 (+ base (/ var 63))]
    (set! (array-ref row w) (bit-or (array-ref row w) (shl 1 (% var 63))))))

(define (compiler-reg-chunk->row!
  [row : (__tl_dyn-array i64)]
  [base : i64]
  [bits : i64]
  [var-base : i64]) : unit
  (if (= bits 0)
    unit
    (let
      [i : i64 (compiler-reg-low-bit-index32-nonzero bits)]
      (begin
        (compiler-reg-bits-set! row base (+ var-base i))
        (compiler-reg-chunk->row! row base (bit-and bits (- bits 1)) var-base)))))

(define (compiler-reg-set-words->row!
  [set : live.CompilerLiveI64Set]
  [row : (__tl_dyn-array i64)]
  [base : i64]
  [word-index : i64]) : unit
  (if (>= word-index (live.compiler-live-set-word-count set))
    unit
    (begin
      (compiler-reg-chunk->row!
        row
        base
        (live.compiler-live-set-word-at-bounded set word-index)
        (* word-index (live.compiler-live-set-word-bits)))
      (compiler-reg-set-words->row! set row base (+ word-index 1)))))

(define (compiler-reg-set->row!
  [set : live.CompilerLiveI64Set]
  [row : (__tl_dyn-array i64)]
  [base : i64]) : unit
  (compiler-reg-set-words->row! set row base 0))

(define (compiler-reg-live-block-succs [block : live.CompilerLiveBlock]) : live.CompilerLiveLabelSet
  block.successors)

(define (compiler-reg-bits-build-rows-from-array!
  [blocks : (__tl_dyn-array live.CompilerLiveBlock)]
  [idmap : reg_label_i64_map.Map (:consume)]
  [use-rows : (__tl_dyn-array i64)]
  [def-rows : (__tl_dyn-array i64)]
  [words : i64]
  [index : i64]) : reg_label_i64_map.Map
  (if (>= index (array-length blocks))
    idmap
    (let
      [block : live.CompilerLiveBlock (array-ref blocks index)]
      (begin
        (compiler-reg-set->row! block.uses use-rows (* index words))
        (compiler-reg-set->row! block.defs def-rows (* index words))
        (reg_label_i64_map.insert-ref! (&mut idmap) block.label index)
        (compiler-reg-bits-build-rows-from-array!
          blocks
          idmap
          use-rows
          def-rows
          words
          (+ index 1))))))

(define (compiler-reg-bits-clear-row!
  [row : (__tl_dyn-array i64)]
  [base : i64]
  [words : i64]) : unit
  (let
    [w : i64 0]
    (begin
      (while (< w words)
        (begin
          (set! (array-ref row (+ base w)) 0)
          (set! w (+ w 1))))
      unit)))

(define (compiler-reg-bits-or-row!
  [dst : (__tl_dyn-array i64)]
  [dbase : i64]
  [src : (__tl_dyn-array i64)]
  [sbase : i64]
  [words : i64]) : unit
  (let
    [w : i64 0]
    (begin
      (while (< w words)
        (begin
          (set!
            (array-ref dst (+ dbase w))
            (bit-or (array-ref dst (+ dbase w)) (array-ref src (+ sbase w))))
          (set! w (+ w 1))))
      unit)))

(define (compiler-reg-bits-or-succs!
  [live-out : (__tl_dyn-array i64)]
  [live-in : (__tl_dyn-array i64)]
  [succs : live.CompilerLiveLabelSet]
  [idmap : reg_label_i64_map.Map]
  [b : i64]
  [words : i64]) : unit
  (match succs
    [(live.CompilerLiveLabelSet.Nil) unit]
    [(live.CompilerLiveLabelSet.Dense _ _)
      (begin
        (match (reg_label_i64_map.get
          (& idmap)
          (live.compiler-live-label-set-ref succs 0))
          [(reg_label_i64_map.LookupFound idx)
            (compiler-reg-bits-or-row!
              live-out
              (* b words)
              live-in
              (* idx words)
              words)]
          [(reg_label_i64_map.LookupMissing) unit])
        (compiler-reg-bits-or-succs!
          live-out
          live-in
          (live.compiler-live-label-set-tail succs)
          idmap
          b
          words))]))

(define (compiler-reg-bits-update-live-in!
  [live-in : (__tl_dyn-array i64)]
  [use-rows : (__tl_dyn-array i64)]
  [live-out : (__tl_dyn-array i64)]
  [def-rows : (__tl_dyn-array i64)]
  [base : i64]
  [words : i64]) : bool
  (let
    [w : i64 0]
    [changed : bool false]
    (begin
      (while (< w words)
        (let
          [idx : i64 (+ base w)]
          [next : i64
            (bit-or
              (array-ref use-rows idx)
              (bit-and
                (array-ref live-out idx)
                (bit-xor (array-ref def-rows idx) -1)))]
          (begin
            (if (= next (array-ref live-in idx))
              unit
              (begin
                (set! (array-ref live-in idx) next)
                (set! changed true)))
            (set! w (+ w 1)))))
      changed)))

(define (compiler-reg-bits-iterate!
  [arr : (__tl_dyn-array live.CompilerLiveBlock)]
  [idmap : reg_label_i64_map.Map]
  [words : i64]
  [use-rows : (__tl_dyn-array i64)]
  [live-in : (__tl_dyn-array i64)]
  [live-out : (__tl_dyn-array i64)]
  [def-rows : (__tl_dyn-array i64)]
  [b : i64]
  [changed : bool]) : bool
  (if (< b 0)
    changed
    (begin
      (compiler-reg-bits-clear-row! live-out (* b words) words)
      (compiler-reg-bits-or-succs!
        live-out
        live-in
        (compiler-reg-live-block-succs (array-ref arr b))
        idmap
        b
        words)
      (let
        [next-changed : bool
          (if (compiler-reg-bits-update-live-in!
            live-in
            use-rows
            live-out
            def-rows
            (* b words)
            words)
            true
            changed)]
        (compiler-reg-bits-iterate!
          arr
          idmap
          words
          use-rows
          live-in
          live-out
          def-rows
          (- b 1)
          next-changed)))))

(define (compiler-reg-bits-fixpoint!
  [arr : (__tl_dyn-array live.CompilerLiveBlock)]
  [idmap : reg_label_i64_map.Map]
  [count : i64]
  [words : i64]
  [use-rows : (__tl_dyn-array i64)]
  [live-in : (__tl_dyn-array i64)]
  [live-out : (__tl_dyn-array i64)]
  [def-rows : (__tl_dyn-array i64)]) : unit
  (if (compiler-reg-bits-iterate!
    arr
    idmap
    words
    use-rows
    live-in
    live-out
    def-rows
    (- count 1)
    false)
    (compiler-reg-bits-fixpoint!
      arr
      idmap
      count
      words
      use-rows
      live-in
      live-out
      def-rows)
    unit))

(define (compiler-reg-bits-extend-word!
  [bits : i64]
  [var-base : i64]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [point : i64]) : unit
  (if (= bits 0)
    unit
    (let
      [i : i64 (compiler-reg-low-bit-index bits)]
      (begin
        (compiler-reg-extend-interval starts ends (+ var-base i) point)
        (compiler-reg-bits-extend-word!
          (bit-and bits (- bits 1))
          var-base
          starts
          ends
          point)))))

(define (compiler-reg-bits-extend-row!
  [row : (__tl_dyn-array i64)]
  [base : i64]
  [words : i64]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [point : i64]) : unit
  (let
    [w : i64 0]
    (begin
      (while (< w words)
        (begin
          (compiler-reg-bits-extend-word!
            (array-ref row (+ base w))
            (* w 63)
            starts
            ends
            point)
          (set! w (+ w 1))))
      unit)))

(define (compiler-reg-bits-mentions-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [point : i64]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]) : i64
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    [out-point : i64 point]
    (begin
      (while (< index count)
        (begin
          (compiler-reg-extend-instr
            starts
            ends
            (live.compiler-live-set-empty)
            out-point
            (array-ref slots index))
          (set! out-point (+ out-point 2))
          (set! index (+ index 1))))
      out-point)))

(define (compiler-reg-bits-intervals-walk
  [ir-blocks : ir.CompilerIrBlockList]
  [live-in : (__tl_dyn-array i64)]
  [live-out : (__tl_dyn-array i64)]
  [words : i64]
  [b : i64]
  [point : i64]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]) : i64
  (match ir-blocks
    [(ir.CompilerIrBlockList.Nil) point]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (compiler-reg-bits-extend-row!
              live-in
              (* b words)
              words
              starts
              ends
              point)
            (let
              [end-point : i64
                (compiler-reg-bits-mentions-instr-seq instrs point starts ends)]
              (begin
                (compiler-reg-bits-extend-row!
                  live-out
                  (* b words)
                  words
                  starts
                  ends
                  end-point)
                (compiler-reg-bits-intervals-walk
                  (__tl-box-place rest)
                  live-in
                  live-out
                  words
                  (+ b 1)
                  end-point
                  starts
                  ends))))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [block-index : i64 b]
        [out-point : i64 point]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (begin
                    (compiler-reg-bits-extend-row!
                      live-in
                      (* block-index words)
                      words
                      starts
                      ends
                      out-point)
                    (set!
                      out-point
                      (compiler-reg-bits-mentions-instr-seq
                        instrs
                        out-point
                        starts
                        ends))
                    (compiler-reg-bits-extend-row!
                      live-out
                      (* block-index words)
                      words
                      starts
                      ends
                      out-point))])
              (set! block-index (+ block-index 1))
              (set! i (+ i 1))))
          out-point))]))

(define (compiler-reg-bits-map-capacity [count : i64]) : i64
  (if (< count 4)
    8
    (* count 2)))

(define (compiler-reg-block-intervals [func : ir.CompilerIrFunction]) : CompilerRegIntervalSeq
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ vars blocks)
      (let
        [seq : ir.CompilerIrBlockSeq
          (live.compiler-live-ir-block-list-to-seq blocks)]
        [live-blocks : (__tl_dyn-array live.CompilerLiveBlock)
          (live.compiler-live-build-block-array seq vars)]
        [count : i64 (array-length live-blocks)]
        [words : i64 (compiler-reg-bits-words vars)]
        [cells : i64 (* count words)]
        [use-rows : (__tl_dyn-array i64) (array.make-array i64 cells)]
        [def-rows : (__tl_dyn-array i64) (array.make-array i64 cells)]
        [live-in : (__tl_dyn-array i64) (array.make-array i64 cells)]
        [live-out : (__tl_dyn-array i64) (array.make-array i64 cells)]
        [starts : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [ends : (__tl_dyn-array i64) (array.make-array i64 vars)]
        (begin
          (compiler-reg-fill-i64-array starts -1)
          (compiler-reg-fill-i64-array ends -1)
          (let
            [idmap : reg_label_i64_map.Map
              (compiler-reg-bits-build-rows-from-array!
                live-blocks
                (reg_label_i64_map.with-capacity
                  (compiler-reg-bits-map-capacity count))
                use-rows
                def-rows
                words
                0)]
            (begin
              (compiler-reg-bits-fixpoint!
                live-blocks
                idmap
                count
                words
                use-rows
                live-in
                live-out
                def-rows)
              (compiler-reg-bits-intervals-walk
                blocks
                live-in
                live-out
                words
                0
                0
                starts
                ends)
              (compiler-reg-interval-arrays-to-seq
                starts
                ends
                (- vars 1)
                (compiler-reg-interval-seq-empty))))))]))

;; When handles-ok? is true (scalar path) 8-byte aggregate handles are register
;; eligible; when false (SIMD/AVX path, unchanged) only CPU scalars/pointers are.
(define (compiler-reg-ineligible-non-scalars
  [types : CompilerRegVarTypes]
  [set : live.CompilerLiveI64Set]
  [handles-ok? : bool]) : live.CompilerLiveI64Set
  (let
    [present : (__tl_dyn-array i64) types.present]
    [items : (__tl_dyn-array ast.AstType) types.items]
    [index : i64 0]
    [out : live.CompilerLiveI64Set set]
    (begin
      (while (< index (array-length present))
        (begin
          (if (or
            (= (array-ref present index) 0)
            (if handles-ok?
              (compiler-reg-register-eligible-type? (array-ref items index))
              (compiler-reg-scalar-type? (array-ref items index))))
            unit
            (set! out (live.compiler-live-set-insert out index)))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-ineligible-params
  [params : ir.CompilerIrParamList]
  [set : live.CompilerLiveI64Set]) : live.CompilerLiveI64Set
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) set]
    [(ir.CompilerIrParamList.Array seq)
      (compiler-reg-ineligible-params
        (ir.compiler-ir-param-seq-to-list seq)
        set)]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param _ _ var)
          (compiler-reg-ineligible-params
            (__tl-box-place rest)
            (live.compiler-live-set-insert set var))])]))

(define (compiler-reg-integer-param-type?
  [type-segment-bases : i64]
  [ty : ast.AstType]) : bool
  (and
    ;; GAP3b: pin-eligibility matches greedy-eligibility
    ;; (compiler-reg-param-greedy-eligible?). An 8-byte handle (Array/String/
    ;; enum/struct descriptor pointer) arriving in %rdi is pin-identical to a
    ;; scalar: M-A2/M-C2 established handles as ordinary GP values the backend
    ;; moves with a plain movq, and M-A already let handle params take greedy
    ;; CSR homes in every function -- the pin path kept a stale scalar-only
    ;; restriction from the pre-M-A era, paying an entry copy plus a
    ;; callee-saved save for every handle param of a zero-clobber leaf
    ;; (sum_array shape). Floats keep the XMM exclusion; two-word register
    ;; groups occupy two ABI slots and keep the legacy stack home; genuinely
    ;; by-reference/address-taken params are excluded upstream by
    ;; base-ineligible (compiler-reg-param-pin-safe?).
    (compiler-reg-register-eligible-type? ty)
    (not (compiler-reg-float-type? ty))
    (not (compiler-reg-type-register-group? type-segment-bases ty))))

;; M-A (RC1): a non-group register-eligible param that did NOT get
;; an ABI pin stays OUT of the ineligible/blocked sets and becomes an ordinary
;; greedy candidate. Its greedy home is restricted to the CALLEE-SAVED pool
;; (compiler-reg-greedy-alloc-one! `is-param`): the backend's entry copy writes
;; the home register in the prologue (after the callee-saved saves), and a
;; callee-saved home can neither clobber another param's incoming arg register
;; nor be clobbered by a call. Handle types (Array/String/enum/struct -- 8-byte
;; descriptors) qualify exactly like scalars. Floats use the same rule over the
;; ABI XMM bank: SysV has no nonvolatile suffix, while Win64 may keep an unpinned
;; parameter in XMM6-XMM15. Two-word register groups keep the legacy stack home.
(define (compiler-reg-param-greedy-eligible?
  [type-segment-bases : i64]
  [ty : ast.AstType]) : bool
  (and
    (compiler-reg-register-eligible-type? ty)
    (not (compiler-reg-type-register-group? type-segment-bases ty))))

(define (compiler-reg-param-int-reg
  [target-abi : cabi.CompilerRegTargetAbi]
  [int-idx : i64]
  [position : i64]) : CompilerRegMaybeId
  (let
    [idx : i64
      (if (cabi.compiler-abi-arg-banks-independent? target-abi)
        int-idx
        position)]
    [reg : i64 (cabi.compiler-abi-gp-arg-register-id target-abi idx)]
    ;; %r8 is the backend's integer scratch register on both ABIs.
    (if (or
      (= reg cabi.compiler-reg-id-invalid)
      (= reg cabi.compiler-reg-id-r8))
      CompilerRegMaybeId.No
      (CompilerRegMaybeId.Some reg))))

(define (compiler-reg-param-float-reg
  [target-abi : cabi.CompilerRegTargetAbi]
  [float-idx : i64]
  [position : i64]) : CompilerRegMaybeId
  (let
    [idx : i64
      (if (cabi.compiler-abi-arg-banks-independent? target-abi)
        float-idx
        position)]
    [reg : i64 (cabi.compiler-abi-float-arg-register-id target-abi idx)]
    (if (or
      (= reg cabi.compiler-reg-id-invalid)
      (not
        (compiler-reg-id-seq-contains?
          (compiler-reg-xmm-registers-for-abi target-abi)
          reg)))
      CompilerRegMaybeId.No
      (CompilerRegMaybeId.Some reg))))

;; GAP3c: inclusive-START point-range spanning test for the pin gate. A param
;; is defined by the PROLOGUE (before point 0) and its interval is
;; entry-extended to start at 0 (M-A), so -- unlike an ordinary var, whose
;; start point is its own defining instruction (a call result born AT a call
;; is not clobbered by it) -- a clobber point AT the interval start is already
;; inside the param's live range: `start <= c < end`. The greedy's
;; strict-interior test (compiler-reg-greedy-var-spans-clobber?) would let a
;; param live ACROSS a call at point 0 (function opens with the call, param
;; used after) keep its caller-saved pin -- a miscompile. A clobber at `end`
;; stays non-spanning: it is the param's own last-use instruction, whose
;; operands are read before the clobber lands (the model every register-homed
;; value already relies on). Out-of-range vars conservatively span.
(define (compiler-reg-param-pin-word-in-range?
  [bits : i64]
  [var-base : i64]
  [start : i64]
  [end : i64]) : bool
  (if (= bits 0)
    false
    (let
      [i : i64 (compiler-reg-low-bit-index32-nonzero bits)]
      [c : i64 (+ var-base i)]
      (if (if (<= start c)
        (< c end)
        false)
        true
        (compiler-reg-param-pin-word-in-range?
          (bit-and bits (- bits 1))
          var-base
          start
          end)))))

(define (compiler-reg-param-pin-set-in-range-words?
  [set : live.CompilerLiveI64Set]
  [start : i64]
  [end : i64]
  [word-index : i64]) : bool
  (if (>= word-index (live.compiler-live-set-word-count set))
    false
    (if (compiler-reg-param-pin-word-in-range?
      (live.compiler-live-set-word-at-bounded set word-index)
      (* word-index (live.compiler-live-set-word-bits))
      start
      end)
      true
      (compiler-reg-param-pin-set-in-range-words?
        set
        start
        end
        (+ word-index 1)))))

(define (compiler-reg-param-pin-spans-clobber?
  [interval-index : CompilerRegIntervalIndex]
  [clobber-points : live.CompilerLiveI64Set]
  [var : i64]) : bool
  (let
    [starts : (__tl_dyn-array i64) interval-index.starts]
    [ends : (__tl_dyn-array i64) interval-index.ends]
    (if (and (>= var 0) (< var (array-length starts)))
      (if (< (array-ref starts var) 0)
        false
        ;; Hull first: it is the cheap superset test, and a param whose hull is
        ;; clobber-free needs no segment walk at all. Only when the hull says
        ;; "spanned" is it worth asking whether the point is actually inside a
        ;; live segment or in a HOLE -- the dispatcher case, where a param used
        ;; by one arm has the sibling arms' calls inside its hull and inside no
        ;; segment of its own. Inclusive hull start: a param is defined by the
        ;; prologue, before point 0, so a clobber AT its interval start is
        ;; already inside its live range (see the GAP3c note above).
        (and
          (compiler-reg-param-pin-set-in-range-words?
            clobber-points
            (array-ref starts var)
            (array-ref ends var)
            0)
          (if (compiler-reg-interval-index-var-has-segments? interval-index var)
            (compiler-reg-segments-span-clobber?
              (array-ref interval-index.segments var)
              clobber-points
              (array-ref starts var)
              true)
            true)))
      true)))

;; GAP3c: per-interval pin clobber gate. A param may keep its incoming ABI
;; register iff no clobber/pressure point falls inside the pinned interval
;; (inclusive-start spanning test above), by the greedy's kind point sets:
;;   * kind 6 (call-like MINUS the tail-call family: call/syscall/cpuid/xgetbv)
;;     clobbers every caller-saved register and control RESUMES afterwards:
;;     bans any spanned pin. Tail calls are deliberately absent -- control never
;;     returns past one, so no pin has to survive it (compiler-reg-clobber-
;;     instr-kind? kind 6);
;;   * kind 1 (div/mod, constant divisors included): bans any spanned pin.
;;     The register hazard alone is only %rax:%rdx, but the canned divmod
;;     expansion is SCRATCH-HUNGRY (magic reciprocal + rounding temps), and a
;;     pin live across it measurably starves the scavenger into per-iteration
;;     emergency save/restore pairs (qs_checksum: +4 movs/iter for -4
;;     prologue movs = a net loss in every loop) -- so all pins are refused,
;;     not just %rdx;
;;   * kind 2 (VARIABLE-count shift) hardwires only %rcx/%cl and stages at
;;     most the count: bans only a spanned %rcx pin.
;; Switch dispatches no longer participate in this gate. GAP2b-v2 made the
;; dispatch emergency scavenge restore borrowed occupants before the indirect
;; jmp, so the old function-global "any switch bans all pins" guard would now
;; reject valid placements for a bug that is no longer present.
;; "Spanned" is the inclusive-start test: a param whose LAST use is the
;; clobbering instruction itself (the dividend/divisor of the div, an
;; outgoing argument of the call) is read before the clobber lands, exactly
;; as the greedy already assumes for every register-homed value.
;; BoundsCheck/Pack are absent from all kinds (clobber-point-instr?/kind sets
;; exclude them); their scavenged scratches see the pin through the
;; interval-driven occupancy masks like any other register-homed value. A var
;; without an interval never spans here; pin-safe? independently refuses
;; params without an interval (unused params are never pinned).
(define (compiler-reg-param-pin-clobber-free?
  [interval-index : CompilerRegIntervalIndex]
  [call-points : live.CompilerLiveI64Set]
  [div-points : live.CompilerLiveI64Set]
  [shift-points : live.CompilerLiveI64Set]
  [low-xmm-points : live.CompilerLiveI64Set]
  [var : i64]
  [reg : i64]) : bool
  ;; GAP2b-v2: the kind-3 (any-switch-refuses-all-pins) clause is REMOVED. The
  ;; dispatch emitter's emergency scavenge is now sound (it restores every
  ;; borrowed occupant BEFORE the indirect jmp via a slot-indirect transfer --
  ;; compiler-backend-emit-switch-dispatch-emergency), so an ABI pin that
  ;; perturbs occupancy at a dispatch no longer risks the restore-after-jmp
  ;; miscompile.
  (and
    (not (compiler-reg-param-pin-spans-clobber? interval-index call-points var))
    (not (compiler-reg-param-pin-spans-clobber? interval-index div-points var))
    (or
      (not (= reg cabi.compiler-reg-id-rcx))
      (not
        (compiler-reg-param-pin-spans-clobber? interval-index shift-points var)))
    (or
      (and
        (not (= reg (cabi.compiler-abi-xmm-register-id 0)))
        (not (= reg (cabi.compiler-abi-xmm-register-id 1))))
      (not
        (compiler-reg-param-pin-spans-clobber?
          interval-index
          low-xmm-points
          var)))))

(define (compiler-reg-param-pin-safe?
  [assignments : CompilerRegAssignmentTable]
  [interval-index : CompilerRegIntervalIndex]
  [base-ineligible : live.CompilerLiveI64Set]
  [var : i64]
  [reg : i64]) : bool
  (and
    (not (live.compiler-live-set-contains? base-ineligible var))
    (match (compiler-reg-interval-index-lookup interval-index var)
      [(CompilerRegMaybeInterval.Some interval)
        (not
          (compiler-reg-assignment-table-location-conflicts?
            assignments
            interval-index
            var
            (- 0 1)
            (CompilerRegLocation.Register reg)))]
      [(CompilerRegMaybeInterval.No) false])))

(define (compiler-reg-param-assign-walk
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [params : ir.CompilerIrParamList]
  [interval-index : CompilerRegIntervalIndex]
  [assignments : CompilerRegAssignmentTable]
  [ineligible : live.CompilerLiveI64Set]
  [blocked : live.CompilerLiveI64Set]
  [int-idx : i64]
  [float-idx : i64]
  [position : i64]
  [pins-ok? : bool]
  [call-points : live.CompilerLiveI64Set]
  [div-points : live.CompilerLiveI64Set]
  [shift-points : live.CompilerLiveI64Set]
  [low-xmm-points : live.CompilerLiveI64Set]) : CompilerRegParamAssignPlan
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil)
      (CompilerRegParamAssignPlan.Plan assignments ineligible blocked)]
    [(ir.CompilerIrParamList.Array seq)
      (compiler-reg-param-assign-walk
        type-segment-bases
        target-abi
        (ir.compiler-ir-param-seq-to-list seq)
        interval-index
        assignments
        ineligible
        blocked
        int-idx
        float-idx
        position
        pins-ok?
        call-points
        div-points
        shift-points
        low-xmm-points)]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param _ ty var-id)
          (let
            [is-float : bool (compiler-reg-float-type? ty)]
            [is-group : bool
              (compiler-reg-type-register-group? type-segment-bases ty)]
            [next-int : i64
              (if is-float
                int-idx
                (+ int-idx 1))]
            [next-float : i64
              (if is-float
                (+ float-idx 1)
                float-idx)]
            [next-position : i64 (+ position 1)]
            ;; A register-group param occupies TWO ABI slots; this walk's
            ;; int-idx accounting does not model that, so every pin PAST a
            ;; group param is disabled (the group itself never pins).
            [tail-pins-ok? : bool (and pins-ok? (not is-group))]
            [reg : CompilerRegMaybeId
              (if (and pins-ok? (not is-group))
                (if is-float
                  (compiler-reg-param-float-reg target-abi float-idx position)
                  (if (compiler-reg-integer-param-type? type-segment-bases ty)
                    (compiler-reg-param-int-reg target-abi int-idx position)
                    CompilerRegMaybeId.No))
                CompilerRegMaybeId.No)]
            (match reg
              [(CompilerRegMaybeId.Some home)
                ;; GAP3c: the pin gate is PER-INTERVAL and per-register (the
                ;; old function-global backend-clobber-point? gate revoked
                ;; every pin on any call/div/shift anywhere -- apply_op's div
                ;; disqualified pins its add arm never reached). The pinned
                ;; var is deliberately NOT inserted into `blocked`: the greedy
                ;; skips already-assigned vars, and plan-from's coalesce-hull
                ;; validation (compiler-reg-param-pins-demote!) may still
                ;; revoke the pin, after which the param must compete as an
                ;; ordinary callee-saved greedy candidate.
                (if (and
                  (compiler-reg-param-pin-clobber-free?
                    interval-index
                    call-points
                    div-points
                    shift-points
                    low-xmm-points
                    var-id
                    home)
                  (compiler-reg-param-pin-safe?
                    assignments
                    interval-index
                    ineligible
                    var-id
                    home))
                  (compiler-reg-param-assign-walk
                    type-segment-bases
                    target-abi
                    (__tl-box-place rest)
                    interval-index
                    (compiler-reg-assignment-table-insert
                      assignments
                      var-id
                      (CompilerRegLocation.Register home))
                    ineligible
                    blocked
                    next-int
                    next-float
                    next-position
                    tail-pins-ok?
                    call-points
                    div-points
                    shift-points
                    low-xmm-points)
                  ;; Pin-unsafe scalar param: integer and float scalar params
                  ;; are greedy-eligible -- leave it out of
                  ;; ineligible/blocked so the greedy may home it callee-saved.
                  (compiler-reg-param-assign-walk
                    type-segment-bases
                    target-abi
                    (__tl-box-place rest)
                    interval-index
                    assignments
                    ineligible
                    blocked
                    next-int
                    next-float
                    next-position
                    tail-pins-ok?
                    call-points
                    div-points
                    shift-points
                    low-xmm-points))]
              [(CompilerRegMaybeId.No)
                ;; No ABI pin available (skipped arg register, stack-passed
                ;; position, post-group position, or non-pinnable type). A
                ;; greedy-eligible param stays unblocked (M-A candidate);
                ;; group/otherwise-ineligible params keep the legacy
                ;; stack home. base-ineligible members (address-taken, stack
                ;; call args, ...) are already in both sets and stay excluded.
                (if (compiler-reg-param-greedy-eligible? type-segment-bases ty)
                  (compiler-reg-param-assign-walk
                    type-segment-bases
                    target-abi
                    (__tl-box-place rest)
                    interval-index
                    assignments
                    ineligible
                    blocked
                    next-int
                    next-float
                    next-position
                    tail-pins-ok?
                    call-points
                    div-points
                    shift-points
                    low-xmm-points)
                  (compiler-reg-param-assign-walk
                    type-segment-bases
                    target-abi
                    (__tl-box-place rest)
                    interval-index
                    assignments
                    (live.compiler-live-set-insert ineligible var-id)
                    (live.compiler-live-set-insert blocked var-id)
                    next-int
                    next-float
                    next-position
                    tail-pins-ok?
                    call-points
                    div-points
                    shift-points
                    low-xmm-points))]))])]))

(define (compiler-reg-param-assign-plan
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [interval-index : CompilerRegIntervalIndex]
  [base-ineligible : live.CompilerLiveI64Set]
  [vars : i64]
  [ignore-single-cold-call? : bool]) : CompilerRegParamAssignPlan
  (match func
    [(ir.CompilerIrFunction.Function _ params _ _ _)
      (match (ir.compiler-ir-param-list-force-cons params)
        [(ir.CompilerIrParamList.Nil)
          (CompilerRegParamAssignPlan.Plan
            (compiler-reg-assignment-table-make vars)
            base-ineligible
            base-ineligible)]
        [(ir.CompilerIrParamList.Array seq)
          (let
            [assignments : CompilerRegAssignmentTable
              (compiler-reg-assignment-table-make vars)]
            (compiler-reg-param-assign-walk
              type-segment-bases
              target-abi
              (ir.compiler-ir-param-seq-to-list seq)
              interval-index
              assignments
              base-ineligible
              base-ineligible
              0
              0
              0
              true
              (if ignore-single-cold-call?
                (live.compiler-live-set-empty)
                ;; Kind 6, not kind 0: the tail-call family is excluded. An ABI
                ;; pin asks "may this param stay in its incoming argument
                ;; register for its whole interval?", i.e. must the value
                ;; SURVIVE every point inside that interval. No value survives a
                ;; tail call (control never returns), so a tail call inside the
                ;; hull never invalidates a pin -- see kind 6 in
                ;; compiler-reg-clobber-instr-kind?. The marshalling that
                ;; overwrites the pinned register happens on the arm that jumps
                ;; out, and it reads the pin before writing it (the sound arg
                ;; parallel move).
                (compiler-reg-clobber-kind-points type-segment-bases func 6))
              (compiler-reg-clobber-kind-points type-segment-bases func 1)
              (compiler-reg-clobber-kind-points type-segment-bases func 2)
              (cfg
                scratch-vreg
                (compiler-reg-clobber-kind-points type-segment-bases func 5)
                (live.compiler-live-set-empty))))]
        [(ir.CompilerIrParamList.Cons _ _)
          (let
            [assignments : CompilerRegAssignmentTable
              (compiler-reg-assignment-table-make vars)]
            ;; M-A (RC1): the walk always runs -- non-pinned greedy-eligible
            ;; params stay out of ineligible/blocked in ALL functions and
            ;; compete in the greedy for a callee-saved home.
            ;; GAP3c: the pin gate is PER-INTERVAL and per-register instead of
            ;; the old function-global backend-clobber-point? test: a param
            ;; whose live range crosses no clobber point that could overwrite
            ;; ITS register keeps the incoming ABI register even in a function
            ;; with calls/divs/shifts elsewhere (the greedy's kind 0/1/2 point
            ;; sets; see compiler-reg-param-pin-clobber-free?). The walk's
            ;; per-var check uses the param's OWN interval; plan-from
            ;; re-validates every surviving pin against its coalesce-class
            ;; hull once the coalesce map exists (a disjoint-coalesced member
            ;; may extend the pinned register's effective range past a
            ;; clobber; compiler-reg-param-pins-demote!).
            (compiler-reg-param-assign-walk
              type-segment-bases
              target-abi
              params
              interval-index
              assignments
              base-ineligible
              base-ineligible
              0
              0
              0
              true
              (if ignore-single-cold-call?
                (live.compiler-live-set-empty)
                ;; Kind 6, not kind 0: the tail-call family is excluded. An ABI
                ;; pin asks "may this param stay in its incoming argument
                ;; register for its whole interval?", i.e. must the value
                ;; SURVIVE every point inside that interval. No value survives a
                ;; tail call (control never returns), so a tail call inside the
                ;; hull never invalidates a pin -- see kind 6 in
                ;; compiler-reg-clobber-instr-kind?. The marshalling that
                ;; overwrites the pinned register happens on the arm that jumps
                ;; out, and it reads the pin before writing it (the sound arg
                ;; parallel move).
                (compiler-reg-clobber-kind-points type-segment-bases func 6))
              (compiler-reg-clobber-kind-points type-segment-bases func 1)
              (compiler-reg-clobber-kind-points type-segment-bases func 2)
              (cfg
                scratch-vreg
                (compiler-reg-clobber-kind-points type-segment-bases func 5)
                (live.compiler-live-set-empty))))])]))

(define (compiler-reg-ineligible-instr
  [instr : ir.CompilerIrInstr]
  [set : live.CompilerLiveI64Set]) : live.CompilerLiveI64Set
  (match instr
    [(ir.CompilerIrInstr.Alloc dst _) (live.compiler-live-set-insert set dst)]
    [(ir.CompilerIrInstr.AddrOf _ src) (live.compiler-live-set-insert set src)]
    ;; A GEP result is a computed scalar pointer (mut-ptr U8); like an AddrOf
    ;; *destination* it is register-eligible. It only needs a memory home if its
    ;; own address is taken, which the AddrOf arm above already covers (it marks
    ;; the AddrOf *source* ineligible). Unconditionally pinning every GEP result
    ;; to a stack slot left the backend's register-home GEP fast path dead and
    ;; forced a reload-into-%r10 per dereference (the #1 movq destination in the
    ;; mov census). A register-homed GEP is computed straight into its home with
    ;; a single leaq and dereferenced directly, so it is left eligible here.
    [_ set]))

(define (compiler-reg-ineligible-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [set : live.CompilerLiveI64Set]) : live.CompilerLiveI64Set
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    [out : live.CompilerLiveI64Set set]
    (begin
      (while (< index count)
        (begin
          (set! out (compiler-reg-ineligible-instr (array-ref slots index) out))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-ineligible-memory
  [blocks : ir.CompilerIrBlockList]
  [set : live.CompilerLiveI64Set]) : live.CompilerLiveI64Set
  (match blocks
    [(ir.CompilerIrBlockList.Nil) set]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-ineligible-memory
            (__tl-box-place rest)
            (compiler-reg-ineligible-instr-seq instrs set))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out : live.CompilerLiveI64Set set]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set! out (compiler-reg-ineligible-instr-seq instrs out))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-reg-call-live-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [liveness : live.CompilerFunctionLiveness]
  [label : i64]
  [start-index : i64]
  [set : live.CompilerLiveI64Set]) : live.CompilerLiveI64Set
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    [instr-index : i64 start-index]
    [out : live.CompilerLiveI64Set set]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (match (array-ref slots index)
              [(ir.CompilerIrInstr.Call _ _ _ _)
                (live.compiler-live-set-union
                  out
                  (live.compiler-live-after liveness label instr-index))]
              [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
                (live.compiler-live-set-union
                  out
                  (live.compiler-live-after liveness label instr-index))]
              [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
                (live.compiler-live-set-union
                  out
                  (live.compiler-live-after liveness label instr-index))]
              [(ir.CompilerIrInstr.SpmdCall payload-box)
                (live.compiler-live-set-union
                  out
                  (live.compiler-live-after liveness label instr-index))]
              [(ir.CompilerIrInstr.TailCall _ _ _)
                (live.compiler-live-set-union
                  out
                  (live.compiler-live-after liveness label instr-index))]
              [(ir.CompilerIrInstr.TailCallIndirect _ _ _)
                (live.compiler-live-set-union
                  out
                  (live.compiler-live-after liveness label instr-index))]
              [_ out]))
          (set! instr-index (+ instr-index 1))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-call-live-blocks
  [blocks : ir.CompilerIrBlockList]
  [liveness : live.CompilerFunctionLiveness]
  [set : live.CompilerLiveI64Set]) : live.CompilerLiveI64Set
  (match blocks
    [(ir.CompilerIrBlockList.Nil) set]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (compiler-reg-call-live-blocks
            (__tl-box-place rest)
            liveness
            (compiler-reg-call-live-instr-seq instrs liveness label 0 set))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out : live.CompilerLiveI64Set set]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block label instrs)
                  (set!
                    out
                    (compiler-reg-call-live-instr-seq
                      instrs
                      liveness
                      label
                      0
                      out))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-reg-call-arg-vars-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [set : live.CompilerLiveI64Set]) : live.CompilerLiveI64Set
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    [out : live.CompilerLiveI64Set set]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (match (array-ref slots index)
              [(ir.CompilerIrInstr.Call _ _ args _)
                (live.compiler-live-set-union
                  out
                  (live.compiler-live-call-args-vars args))]
              [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
                (let
                  [base (__tl-project-field (__tl-box-place payload-box) base)]
                  [args (__tl-project-field (__tl-box-place payload-box) args)]
                  (live.compiler-live-set-union
                    out
                    (live.compiler-live-value-vars-into
                      (live.compiler-live-call-args-vars args)
                      base)))]
              [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
                (let
                  [base (__tl-project-field (__tl-box-place payload-box) base)]
                  [func
                    (__tl-project-field (__tl-box-place payload-box) callee)]
                  [args (__tl-project-field (__tl-box-place payload-box) args)]
                  (live.compiler-live-set-union
                    out
                    (live.compiler-live-value-vars-into
                      (live.compiler-live-value-vars-into
                        (live.compiler-live-call-args-vars args)
                        base)
                      func)))]
              [(ir.CompilerIrInstr.SpmdCall payload-box)
                (let
                  [active-mask
                    (__tl-project-field
                      (__tl-box-place payload-box)
                      active-mask)]
                  [args (__tl-project-field (__tl-box-place payload-box) args)]
                  (live.compiler-live-set-union
                    out
                    (live.compiler-live-value-vars-into
                      (live.compiler-live-spmd-call-args-vars args)
                      active-mask)))]
              [(ir.CompilerIrInstr.TailCall _ args _)
                (live.compiler-live-set-union
                  out
                  (live.compiler-live-call-args-vars args))]
              [(ir.CompilerIrInstr.TailCallIndirect func args _)
                (live.compiler-live-set-union
                  out
                  (live.compiler-live-value-vars-into
                    (live.compiler-live-call-args-vars args)
                    func))]
              [_ out]))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-call-arg-vars-blocks
  [blocks : ir.CompilerIrBlockList]
  [set : live.CompilerLiveI64Set]) : live.CompilerLiveI64Set
  (match blocks
    [(ir.CompilerIrBlockList.Nil) set]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-call-arg-vars-blocks
            (__tl-box-place rest)
            (compiler-reg-call-arg-vars-instr-seq instrs set))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out : live.CompilerLiveI64Set set]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set! out (compiler-reg-call-arg-vars-instr-seq instrs out))])
              (set! i (+ i 1))))
          out))]))

;; --- Register-eligible GP call args ---------------------------------------
;; Direct, c-abi, and indirect call USER args may stay register-eligible when
;; every arg is passed in a single GP arg register, within the per-ABI arg-register
;; count from that call shape's starting ABI slot. Scalars and 8-byte handles are
;; one register class here; the backend resolves any register source/dest conflict
;; among them with a target-aware parallel move. Float/group/aggregate/stack args
;; still stay memory-sourced because they use other banks, multiple registers, or
;; stack marshalling. Special operands such as indirect call targets and C ABI
;; result bases also stay memory-sourced; the backend loads them after user arg
;; setup. The SIMD path keeps the old block-everything behavior via
;; compiler-reg-call-arg-vars-blocks (unchanged).
;; Per-ABI GP integer arg-register count: SysV has 6 (%rdi/%rsi/%rdx/%rcx/%r8/%r9),
;; Win64 has 4 (%rcx/%rdx/%r8/%r9). Mirrored in the backend at
;; compiler-backend-call-args-gp-parallel-from? -- keep the two in sync.
(define (compiler-reg-arg-reg-limit-for-abi
  [target-abi : cabi.CompilerRegTargetAbi]) : i64
  (cabi.compiler-abi-gp-arg-register-count target-abi))

;; A call arg is passed in a SINGLE general-purpose arg register on both ABIs iff it
;; is neither a float nor a register-group value. Handle values (string/box/array/
;; enum/single-word-struct pointers) count as GP, exactly like a raw pointer -- the
;; backend marshals them with one movq. This is the regalloc mirror of the backend's
;; compiler-backend-types-all-gp-int? (the parallel-move precondition); keep the two
;; in sync.
(define (compiler-reg-call-arg-gp-class?
  [type-segment-bases : i64]
  [value : ir.CompilerIrValue]
  [types : CompilerRegVarTypes]) : bool
  (match value
    [(ir.CompilerIrValue.Var id)
      (match (compiler-reg-var-types-lookup types id)
        [(CompilerRegMaybeType.Some ty)
          (and
            (not (compiler-reg-float-type? ty))
            (not (compiler-reg-type-register-group? type-segment-bases ty)))]
        [(CompilerRegMaybeType.No) false])]
    [(ir.CompilerIrValue.F64 _) false]
    [(ir.CompilerIrValue.Unit) false]
    [_ true]))

(define (compiler-reg-call-args-array-gp-class?
  [type-segment-bases : i64]
  [values : (__tl_dyn-array ir.CompilerIrValue)]
  [types : CompilerRegVarTypes]
  [index : i64]
  [count : i64]) : bool
  (if (>= index count)
    true
    (and
      (compiler-reg-call-arg-gp-class?
        type-segment-bases
        (array-ref values index)
        types)
      (compiler-reg-call-args-array-gp-class?
        type-segment-bases
        values
        types
        (+ index 1)
        count))))

(define (compiler-reg-call-args-gp-class?
  [type-segment-bases : i64]
  [args : ir.CompilerIrCallArgs]
  [types : CompilerRegVarTypes]) : bool
  (match args
    [(ir.CompilerIrCallArgs.Nil) false]
    [(ir.CompilerIrCallArgs.One v)
      (compiler-reg-call-arg-gp-class? type-segment-bases v types)]
    [(ir.CompilerIrCallArgs.Two a b)
      (and
        (compiler-reg-call-arg-gp-class? type-segment-bases a types)
        (compiler-reg-call-arg-gp-class? type-segment-bases b types))]
    [(ir.CompilerIrCallArgs.Array values)
      (compiler-reg-call-args-array-gp-class?
        type-segment-bases
        values
        types
        0
        (array-length values))]))

;; A call whose args are ALL single-GP-register passed (and within the per-ABI
;; arg-register arity from its starting ABI slot) is marshalled by the backend
;; with the sound parallel move (compiler-backend-emit-arg-move-list) whenever a
;; register source/dest conflict exists, so ALL its arg vars -- scalars and
;; 8-byte handles alike, they are the same GP register class -- may stay
;; register-homed. Mirrors compiler-backend-call-args-gp-parallel-from?.
(define (compiler-reg-call-gp-parallel-from?
  [type-segment-bases : i64]
  [args : ir.CompilerIrCallArgs]
  [types : CompilerRegVarTypes]
  [start : i64]
  [limit : i64]) : bool
  (let
    [count : i64 (ir.compiler-ir-call-args-count args)]
    (and
      (> count 0)
      (<= (+ start count) limit)
      (compiler-reg-call-args-gp-class? type-segment-bases args types))))

(define (compiler-reg-call-arg-float?
  [value : ir.CompilerIrValue]
  [types : CompilerRegVarTypes]) : bool
  (match value
    [(ir.CompilerIrValue.Var id)
      (match (compiler-reg-var-types-lookup types id)
        [(CompilerRegMaybeType.Some ty) (compiler-reg-float-type? ty)]
        [(CompilerRegMaybeType.No) false])]
    [(ir.CompilerIrValue.F64 _) true]
    [_ false]))

(define (compiler-reg-call-arg-group?
  [type-segment-bases : i64]
  [value : ir.CompilerIrValue]
  [types : CompilerRegVarTypes]) : bool
  (match value
    [(ir.CompilerIrValue.Var id)
      (match (compiler-reg-var-types-lookup types id)
        [(CompilerRegMaybeType.Some ty)
          (compiler-reg-type-register-group? type-segment-bases ty)]
        [(CompilerRegMaybeType.No) true])]
    [_ false]))

(define (compiler-reg-call-args-array-has-group?
  [type-segment-bases : i64]
  [values : (__tl_dyn-array ir.CompilerIrValue)]
  [types : CompilerRegVarTypes]
  [i : i64]) : bool
  (if (>= i (array-length values))
    false
    (or
      (compiler-reg-call-arg-group?
        type-segment-bases
        (array-ref values i)
        types)
      (compiler-reg-call-args-array-has-group?
        type-segment-bases
        values
        types
        (+ i 1)))))

(define (compiler-reg-call-args-have-group?
  [type-segment-bases : i64]
  [args : ir.CompilerIrCallArgs]
  [types : CompilerRegVarTypes]) : bool
  (match args
    [(ir.CompilerIrCallArgs.Nil) false]
    [(ir.CompilerIrCallArgs.One a)
      (compiler-reg-call-arg-group? type-segment-bases a types)]
    [(ir.CompilerIrCallArgs.Two a b)
      (or
        (compiler-reg-call-arg-group? type-segment-bases a types)
        (compiler-reg-call-arg-group? type-segment-bases b types))]
    [(ir.CompilerIrCallArgs.Array values)
      (compiler-reg-call-args-array-has-group?
        type-segment-bases
        values
        types
        0)]))

;; The backend's current float marshaller is ordered rather than a parallel-move
;; solver. A register-passed float may nevertheless enter the greedy: after
;; allocation we retain its home only when it is exactly the ABI destination
;; register and demote every other home to a memory source. GP args on a mixed
;; call and stack-passed floats remain structurally blocked here. Register groups
;; use the old all-memory rule because their multi-slot ABI accounting is separate.
(define (compiler-reg-call-arg-vars-selective-value
  [out : live.CompilerLiveI64Set]
  [value : ir.CompilerIrValue]
  [types : CompilerRegVarTypes]
  [target-abi : cabi.CompilerRegTargetAbi]
  [int-idx : i64]
  [float-idx : i64]
  [position : i64]) : live.CompilerLiveI64Set
  (match value
    [(ir.CompilerIrValue.Var id)
      (let
        [is-float : bool (compiler-reg-call-arg-float? value types)]
        (if (and
          is-float
          (not
            (cabi.compiler-abi-stack-call-arg-for-banks?
              target-abi
              is-float
              int-idx
              float-idx
              position)))
          out
          (live.compiler-live-set-insert out id)))]
    [_ out]))

(define (compiler-reg-call-arg-vars-selective-array
  [out : live.CompilerLiveI64Set]
  [values : (__tl_dyn-array ir.CompilerIrValue)]
  [types : CompilerRegVarTypes]
  [target-abi : cabi.CompilerRegTargetAbi]
  [i : i64]
  [int-idx : i64]
  [float-idx : i64]
  [position : i64]) : live.CompilerLiveI64Set
  (if (>= i (array-length values))
    out
    (let
      [value : ir.CompilerIrValue (array-ref values i)]
      [is-float : bool (compiler-reg-call-arg-float? value types)]
      (compiler-reg-call-arg-vars-selective-array
        (compiler-reg-call-arg-vars-selective-value
          out
          value
          types
          target-abi
          int-idx
          float-idx
          position)
        values
        types
        target-abi
        (+ i 1)
        (if is-float
          int-idx
          (+ int-idx 1))
        (if is-float
          (+ float-idx 1)
          float-idx)
        (+ position 1)))))

(define (compiler-reg-call-arg-vars-selective
  [out : live.CompilerLiveI64Set]
  [args : ir.CompilerIrCallArgs]
  [types : CompilerRegVarTypes]
  [target-abi : cabi.CompilerRegTargetAbi]
  [start : i64]) : live.CompilerLiveI64Set
  (match args
    [(ir.CompilerIrCallArgs.Nil) out]
    [(ir.CompilerIrCallArgs.One a)
      (compiler-reg-call-arg-vars-selective-value
        out
        a
        types
        target-abi
        start
        0
        start)]
    [(ir.CompilerIrCallArgs.Two a b)
      (let
        [a-float : bool (compiler-reg-call-arg-float? a types)]
        [after-a : live.CompilerLiveI64Set
          (compiler-reg-call-arg-vars-selective-value
            out
            a
            types
            target-abi
            start
            0
            start)]
        (compiler-reg-call-arg-vars-selective-value
          after-a
          b
          types
          target-abi
          (if a-float
            start
            (+ start 1))
          (if a-float
            1
            0)
          (+ start 1)))]
    [(ir.CompilerIrCallArgs.Array values)
      (compiler-reg-call-arg-vars-selective-array
        out
        values
        types
        target-abi
        0
        start
        0
        start)]))

(define (compiler-reg-call-arg-vars-unless-gp-parallel
  [type-segment-bases : i64]
  [out : live.CompilerLiveI64Set]
  [args : ir.CompilerIrCallArgs]
  [types : CompilerRegVarTypes]
  [start : i64]
  [target-abi : cabi.CompilerRegTargetAbi]) : live.CompilerLiveI64Set
  (if (compiler-reg-call-gp-parallel-from?
    type-segment-bases
    args
    types
    start
    (compiler-reg-arg-reg-limit-for-abi target-abi))
    out
    (if (compiler-reg-call-args-have-group? type-segment-bases args types)
      (live.compiler-live-set-union
        out
        (live.compiler-live-call-args-vars args))
      (compiler-reg-call-arg-vars-selective out args types target-abi start))))

(define (compiler-reg-call-arg-vars-instr-seq-scalar
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [set : live.CompilerLiveI64Set]
  [types : CompilerRegVarTypes]
  [target-abi : cabi.CompilerRegTargetAbi]) : live.CompilerLiveI64Set
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    [out : live.CompilerLiveI64Set set]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (match (array-ref slots index)
              [(ir.CompilerIrInstr.Call _ _ args _)
                ;; GP-parallel call (every arg passed in ONE GP arg register,
                ;; within the per-ABI arity): scalars and 8-byte handles are the
                ;; same register class to the backend, whose marshalling resolves
                ;; every register source/dest conflict with the sound parallel
                ;; move (compiler-backend-emit-call-args), so ALL arg vars --
                ;; handle args included -- may stay register-homed. Zero-arg
                ;; calls have no arg vars to disqualify. Register groups retain
                ;; the all-memory rule. A register-passed float may reach the
                ;; XMM greedy, but its final home is retained only when it equals
                ;; the ABI target; every other float home is demoted later.
                (compiler-reg-call-arg-vars-unless-gp-parallel
                  type-segment-bases
                  out
                  args
                  types
                  0
                  target-abi)]
              [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
                (let
                  [base (__tl-project-field (__tl-box-place payload-box) base)]
                  [args (__tl-project-field (__tl-box-place payload-box) args)]
                  (compiler-reg-call-arg-vars-unless-gp-parallel
                    type-segment-bases
                    (live.compiler-live-value-vars-into out base)
                    args
                    types
                    0
                    target-abi))]
              [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
                (let
                  [base (__tl-project-field (__tl-box-place payload-box) base)]
                  [func
                    (__tl-project-field (__tl-box-place payload-box) callee)]
                  [args (__tl-project-field (__tl-box-place payload-box) args)]
                  (compiler-reg-call-arg-vars-unless-gp-parallel
                    type-segment-bases
                    (live.compiler-live-value-vars-into
                      (live.compiler-live-value-vars-into out base)
                      func)
                    args
                    types
                    0
                    target-abi))]
              ;; Tail calls (M-G2a): the true tail-jump path marshals args FIRST
              ;; (compiler-backend-emit-tail-call routes a gp-parallel shape --
              ;; tail-stack-count 0, target always an in-program function, so
              ;; never c-abi -- through the same conflict-checked
              ;; compiler-backend-emit-call-args as direct calls) and only THEN
              ;; emits the epilogue (compiler-backend-tail-jump-tail: CSR
              ;; restores + leave + jmp). CSR-homed sources are read before
              ;; their restore overwrites them; the arg registers are all
              ;; caller-saved on both ABIs, so the restores never touch
              ;; marshalled args; register-only marshalling writes no frame
              ;; slot the restores read. So a gp-parallel tail call
              ;; disqualifies NO arg vars, exactly like a gp-parallel direct
              ;; call. Register groups retain the all-memory rule; eligible float
              ;; args use the same exact-target-or-demote contract as direct calls.
              [(ir.CompilerIrInstr.TailCall _ args _)
                (compiler-reg-call-arg-vars-unless-gp-parallel
                  type-segment-bases
                  out
                  args
                  types
                  0
                  target-abi)]
              ;; Indirect tail calls marshal at base 1 (closure env reserved in
              ;; ABI arg-register 0). The backend's base-aware parallel move can
              ;; safely marshal register-homed GP user args, but the closure
              ;; pointer itself is loaded after argument setup and remains
              ;; memory-sourced.
              [(ir.CompilerIrInstr.TailCallIndirect func args _)
                (compiler-reg-call-arg-vars-unless-gp-parallel
                  type-segment-bases
                  (live.compiler-live-value-vars-into out func)
                  args
                  types
                  1
                  target-abi)]
              ;; Closure/indirect calls reserve ABI arg-register 0 for the env and
              ;; marshal user args at base 1. Register-homed GP user args are safe
              ;; through the same base-aware backend parallel move; the closure
              ;; descriptor/call target remains memory-sourced because it is loaded
              ;; after argument setup.
              [(ir.CompilerIrInstr.CallIndirect _ func args _)
                (compiler-reg-call-arg-vars-unless-gp-parallel
                  type-segment-bases
                  (live.compiler-live-value-vars-into out func)
                  args
                  types
                  1
                  target-abi)]
              [(ir.CompilerIrInstr.CallIndirectC _ func args _)
                (compiler-reg-call-arg-vars-unless-gp-parallel
                  type-segment-bases
                  (live.compiler-live-value-vars-into out func)
                  args
                  types
                  0
                  target-abi)]
              [_ out]))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-call-arg-vars-blocks-scalar
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [set : live.CompilerLiveI64Set]
  [types : CompilerRegVarTypes]
  [target-abi : cabi.CompilerRegTargetAbi]) : live.CompilerLiveI64Set
  (match blocks
    [(ir.CompilerIrBlockList.Nil) set]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-call-arg-vars-blocks-scalar
            type-segment-bases
            (__tl-box-place rest)
            (compiler-reg-call-arg-vars-instr-seq-scalar
              type-segment-bases
              instrs
              set
              types
              target-abi)
            types
            target-abi)])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out : live.CompilerLiveI64Set set]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set!
                    out
                    (compiler-reg-call-arg-vars-instr-seq-scalar
                      type-segment-bases
                      instrs
                      out
                      types
                      target-abi))])
              (set! i (+ i 1))))
          out))]))

;; Ineligible variables are computed structurally (non-scalar/non-handle types,
;; call-argument vars, address-taken/memory targets). A value live across a call
;; is NOT structurally ineligible: the primary integer pool admits only
;; callee-saved registers (%r12-%r15/%rbx) which the callee (TypeLisp function
;; prologue/epilogue, or a runtime helper that push/pops them) preserves across
;; the call. The scalar zero-call extension is layered on later and separately
;; rejects any interval spanning a modeled caller-clobber point.
(define (compiler-reg-ineligible-vars-non-params
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [types : CompilerRegVarTypes]
  [target-abi : cabi.CompilerRegTargetAbi]) : live.CompilerLiveI64Set
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (compiler-reg-ineligible-memory
        blocks
        (compiler-reg-call-arg-vars-blocks-scalar
          type-segment-bases
          blocks
          (compiler-reg-ineligible-non-scalars
            types
            (live.compiler-live-set-empty)
            true)
          types
          target-abi))]))

;; SIMD/AVX register planning shares the integer GP allocation quality of the
;; scalar path: a value live across a call is NOT force-spilled. The SIMD integer
;; pool is the 5 callee-saved GP registers (compiler-reg-sysv-integer-registers)
;; with caller-saved-count=0, so a call-spanning integer that wins one of them is
;; preserved across the call by the callee (TypeLisp prologue/epilogue, or a
;; runtime helper that push/pops the callee-saved set) -- exactly as on the scalar
;; path, where the same callee-saved-only argument keeps call-spanning integers
;; register-homed. Float and vector candidates use the same ABI-aware clobber
;; constraint: SysV has no nonvolatile XMM suffix, while Win64 can keep them in
;; XMM6-XMM15. Aggregate handles and masks remain ineligible via
;; compiler-reg-ineligible-non-scalars (false), so only CPU scalars/pointers are
;; register eligible -- unchanged. The
;; caller-saved call-spanning RESCUE is deliberately NOT enabled here: the
;; backend's call-save rewrite (compiler-reg-caller-save-rewrite-blocks, which
;; materialises the save/restore around calls) is gated to scalar mode only
;; (call-save-enabled = false for AVX), so rehoming a spilled call-spanning value
;; into a caller-saved register would leave it unsaved across the call. Spilled
;; call-spanning integers therefore stay in memory (still correct), exactly as a
;; non-rescued scalar spill would.
(define (compiler-reg-ineligible-vars-simd
  [func : ir.CompilerIrFunction]
  [types : CompilerRegVarTypes]
  [intervals : CompilerRegIntervalSeq]) : live.CompilerLiveI64Set
  (match func
    [(ir.CompilerIrFunction.Function _ params _ _ blocks)
      ;; Mask registers have no ABI-nonvolatile subset and remain ineligible
      ;; across calls. Float/vector call constraints are applied by their greedy
      ;; allocators instead: SysV forces a spill, while Win64 admits XMM6-XMM15.
      (let
        [vector-mask-defs : live.CompilerLiveUseDef
          (compiler-reg-function-vector-mask-defs func)]
        [private-param-defs : live.CompilerLiveUseDef
          (compiler-reg-spmd-private-param-defs
            params
            (live.compiler-live-set-empty)
            (live.compiler-live-set-empty))]
        [call-points : live.CompilerLiveI64Set (compiler-reg-call-points func)]
        ;; Only hidden helper parameters must escape the structural
        ;; non-scalar block so their incoming private registers get homes.
        ;; SpmdCall operands/results can use their ordinary vector spill
        ;; homes; admitting them to fixed-register allocation here would
        ;; also reclassify synthetic/scalar IR fixtures as SIMD values.
        [private-param-vars : live.CompilerLiveI64Set
          (live.compiler-live-set-union
            private-param-defs.uses
            private-param-defs.defs)]
        [base-ineligible : live.CompilerLiveI64Set
          (live.compiler-live-set-minus
            (compiler-reg-ineligible-memory
              blocks
              (compiler-reg-ineligible-params
                params
                (compiler-reg-call-arg-vars-blocks
                  blocks
                  (compiler-reg-ineligible-non-scalars
                    types
                    (live.compiler-live-set-empty)
                    false))))
            private-param-vars)]
        (compiler-reg-mark-spanning-in-set
          intervals
          vector-mask-defs.defs
          call-points
          base-ineligible))]))

(define (compiler-reg-interval-before?
  [left : CompilerRegInterval]
  [right : CompilerRegInterval]) : bool
  (let
    [left-start : i64 left.start]
    [right-start : i64 right.start]
    [left-end : i64 left.end]
    [right-end : i64 right.end]
    (cond
      [(< left-start right-start) true]
      [(> left-start right-start) false]
      [(< left-end right-end) true]
      [(> left-end right-end) false]
      [else (< left.var right.var)])))

(define (compiler-reg-candidate-interval-copy [item : CompilerRegInterval]) : CompilerRegInterval
  (CompilerRegInterval item.var item.start item.end))

(define (compiler-reg-candidate-sift-down
  [items : (__tl_dyn-array CompilerRegInterval)]
  [root : i64]
  [count : i64]) : unit
  (let
    [node : i64 root]
    [done : bool false]
    (while (not done)
      (let
        [left : i64 (+ (* node 2) 1)]
        [right : i64 (+ (* node 2) 2)]
        [largest : i64
          (let
            [pick : i64 node]
            (begin
              (if (and
                (< left count)
                (compiler-reg-interval-before?
                  (array-ref items pick)
                  (array-ref items left)))
                (set! pick left)
                unit)
              (if (and
                (< right count)
                (compiler-reg-interval-before?
                  (array-ref items pick)
                  (array-ref items right)))
                (set! pick right)
                unit)
              pick))]
        (if (= largest node)
          (set! done true)
          (let
            [node-item : CompilerRegInterval
              (compiler-reg-candidate-interval-copy (array-ref items node))]
            [largest-item : CompilerRegInterval
              (compiler-reg-candidate-interval-copy (array-ref items largest))]
            (begin
              (set! (array-ref items node) largest-item)
              (set! (array-ref items largest) node-item)
              (set! node largest))))))))

(define (compiler-reg-candidate-heapsort!
  [items : (__tl_dyn-array CompilerRegInterval)]
  [count : i64]) : unit
  (begin
    (let
      [index : i64 (- (/ count 2) 1)]
      (while (>= index 0)
        (begin
          (compiler-reg-candidate-sift-down items index count)
          (set! index (- index 1)))))
    (let
      [last : i64 (- count 1)]
      (while (> last 0)
        (let
          [root-item : CompilerRegInterval
            (compiler-reg-candidate-interval-copy (array-ref items 0))]
          [last-item : CompilerRegInterval
            (compiler-reg-candidate-interval-copy (array-ref items last))]
          (begin
            (set! (array-ref items 0) last-item)
            (set! (array-ref items last) root-item)
            (compiler-reg-candidate-sift-down items 0 last)
            (set! last (- last 1))))))))

(define (compiler-reg-candidate-sort [candidates : CompilerRegIntervalSeq]) : CompilerRegIntervalSeq
  (let
    [count : i64 (compiler-reg-interval-seq-count candidates)]
    [items : (__tl_dyn-array CompilerRegInterval)
      (array.make-array CompilerRegInterval count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            (array-ref items index)
            (compiler-reg-interval-seq-ref candidates index))
          (set! index (+ index 1))))
      (compiler-reg-candidate-heapsort! items count)
      (CompilerRegIntervalSeq items count))))

(define (compiler-reg-candidates
  [intervals : CompilerRegIntervalSeq]
  [types : CompilerRegVarTypes]
  [ineligible : live.CompilerLiveI64Set]
  [want-float : bool]) : CompilerRegIntervalSeq
  (let
    [out : CompilerRegIntervalSeq
      (compiler-reg-interval-seq-with-capacity
        (compiler-reg-interval-seq-count intervals))]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-interval-seq-count intervals))
        (let
          [interval : CompilerRegInterval
            (compiler-reg-interval-seq-ref intervals index)]
          (begin
            (let
              [var : i64 interval.var]
              (if (live.compiler-live-set-contains? ineligible var)
                unit
                (match (compiler-reg-var-types-lookup types var)
                  [(CompilerRegMaybeType.Some ty)
                    (if (if want-float
                      (compiler-reg-float-type? ty)
                      (not (compiler-reg-float-type? ty)))
                      (set! out (compiler-reg-interval-seq-append out interval))
                      unit)]
                  [(CompilerRegMaybeType.No) unit])))
            (set! index (+ index 1)))))
      (compiler-reg-candidate-sort out))))

(define (compiler-reg-vector-defs-instr
  [instr : ir.CompilerIrInstr]
  [set : live.CompilerLiveI64Set]) : live.CompilerLiveI64Set
  (match instr
    [(ir.CompilerIrInstr.LaneId dst _ _)
      (live.compiler-live-set-insert set dst)]
    [(ir.CompilerIrInstr.Splat dst _ _ _)
      (live.compiler-live-set-insert set dst)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (live.compiler-live-set-insert set dst))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [elem-ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (match elem-ty
          [(ast.AstType.Bool) set]
          [_ (live.compiler-live-set-insert set dst)]))]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        (if (= lanes 0)
          set
          (live.compiler-live-set-insert set dst)))]
    [(ir.CompilerIrInstr.VectorLoad dst _ _ _ _)
      (live.compiler-live-set-insert set dst)]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [elem-ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (match elem-ty
          [(ast.AstType.Bool) set]
          [_ (live.compiler-live-set-insert set dst)]))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (live.compiler-live-set-insert set dst))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (live.compiler-live-set-insert set dst))]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [backend (__tl-project-field (__tl-box-place payload-box) backend)]
        [result (__tl-project-field (__tl-box-place payload-box) result)]
        (match backend
          [(ir.CompilerIrSpmdBackend.Avx512)
            (match result
              [(ir.CompilerIrSpmdCallResult.Unit) set]
              [(ir.CompilerIrSpmdCallResult.Value dst class _)
                (match class
                  [(ir.CompilerIrSpmdValueClass.Varying)
                    (live.compiler-live-set-insert set dst)]
                  [_ set])])]
          [(ir.CompilerIrSpmdBackend.Avx2)
            (match result
              [(ir.CompilerIrSpmdCallResult.Unit) set]
              [(ir.CompilerIrSpmdCallResult.Value dst class _)
                (match class
                  [(ir.CompilerIrSpmdValueClass.Varying)
                    (live.compiler-live-set-insert set dst)]
                  [_ set])])]
          [_ set]))]
    [_ set]))

(define (compiler-reg-mask-defs-instr
  [instr : ir.CompilerIrInstr]
  [set : live.CompilerLiveI64Set]) : live.CompilerLiveI64Set
  (match instr
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (live.compiler-live-set-insert set dst))]
    [(ir.CompilerIrInstr.MaskBinOp dst _ _ _ _)
      (live.compiler-live-set-insert set dst)]
    [(ir.CompilerIrInstr.MaskNot dst _ _)
      (live.compiler-live-set-insert set dst)]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [elem-ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (match elem-ty
          [(ast.AstType.Bool) (live.compiler-live-set-insert set dst)]
          [_ set]))]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [elem-ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (match elem-ty
          [(ast.AstType.Bool) (live.compiler-live-set-insert set dst)]
          [_ set]))]
    [(ir.CompilerIrInstr.TailMask dst _ _ _)
      (live.compiler-live-set-insert set dst)]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [backend (__tl-project-field (__tl-box-place payload-box) backend)]
        [result (__tl-project-field (__tl-box-place payload-box) result)]
        (match backend
          [(ir.CompilerIrSpmdBackend.Avx512)
            (match result
              [(ir.CompilerIrSpmdCallResult.Unit) set]
              [(ir.CompilerIrSpmdCallResult.Value dst class _)
                (match class
                  [(ir.CompilerIrSpmdValueClass.Mask)
                    (live.compiler-live-set-insert set dst)]
                  [_ set])])]
          [(ir.CompilerIrSpmdBackend.Avx2)
            (match result
              [(ir.CompilerIrSpmdCallResult.Unit) set]
              [(ir.CompilerIrSpmdCallResult.Value dst class _)
                (match class
                  [(ir.CompilerIrSpmdValueClass.Mask)
                    (live.compiler-live-set-insert set dst)]
                  [_ set])])]
          [_ set]))]
    [_ set]))

(define (compiler-reg-spmd-private-param-defs
  [params : ir.CompilerIrParamList]
  [vector-set : live.CompilerLiveI64Set]
  [mask-set : live.CompilerLiveI64Set]) : live.CompilerLiveUseDef
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) (live.CompilerLiveUseDef vector-set mask-set)]
    [(ir.CompilerIrParamList.Array seq)
      (compiler-reg-spmd-private-param-defs
        (ir.compiler-ir-param-seq-to-list seq)
        vector-set
        mask-set)]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param name _ var)
          (compiler-reg-spmd-private-param-defs
            (__tl-box-place rest)
            (if (compiler-reg-spmd-varying-param? name)
              (live.compiler-live-set-insert vector-set var)
              vector-set)
            (if (compiler-reg-spmd-mask-param? name)
              (live.compiler-live-set-insert mask-set var)
              mask-set))])]))

(define (compiler-reg-vector-mask-defs-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [vector-set : live.CompilerLiveI64Set]
  [mask-set : live.CompilerLiveI64Set]) : live.CompilerLiveUseDef
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    [out-vector : live.CompilerLiveI64Set vector-set]
    [out-mask : live.CompilerLiveI64Set mask-set]
    (begin
      (while (< index count)
        (begin
          (set!
            out-vector
            (compiler-reg-vector-defs-instr (array-ref slots index) out-vector))
          (set!
            out-mask
            (compiler-reg-mask-defs-instr (array-ref slots index) out-mask))
          (set! index (+ index 1))))
      (live.CompilerLiveUseDef out-vector out-mask))))

(define (compiler-reg-vector-mask-defs-blocks
  [blocks : ir.CompilerIrBlockList]
  [vector-set : live.CompilerLiveI64Set]
  [mask-set : live.CompilerLiveI64Set]) : live.CompilerLiveUseDef
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (live.CompilerLiveUseDef vector-set mask-set)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [defs : live.CompilerLiveUseDef
              (compiler-reg-vector-mask-defs-instr-seq
                instrs
                vector-set
                mask-set)]
            (compiler-reg-vector-mask-defs-blocks
              (__tl-box-place rest)
              defs.uses
              defs.defs))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out-vector : live.CompilerLiveI64Set vector-set]
        [out-mask : live.CompilerLiveI64Set mask-set]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (let
                    [defs : live.CompilerLiveUseDef
                      (compiler-reg-vector-mask-defs-instr-seq
                        instrs
                        out-vector
                        out-mask)]
                    (begin
                      (set! out-vector defs.uses)
                      (set! out-mask defs.defs)))])
              (set! i (+ i 1))))
          (live.CompilerLiveUseDef out-vector out-mask)))]))

(define (compiler-reg-function-vector-mask-defs [func : ir.CompilerIrFunction]) : live.CompilerLiveUseDef
  (match func
    [(ir.CompilerIrFunction.Function _ params _ _ blocks)
      (let
        [defs : live.CompilerLiveUseDef
          (compiler-reg-spmd-private-param-defs
            params
            (live.compiler-live-set-empty)
            (live.compiler-live-set-empty))]
        (compiler-reg-vector-mask-defs-blocks blocks defs.uses defs.defs))]))

(define (compiler-reg-special-candidates
  [intervals : CompilerRegIntervalSeq]
  [vars : live.CompilerLiveI64Set]
  [blocked : live.CompilerLiveI64Set]) : CompilerRegIntervalSeq
  (let
    [out : CompilerRegIntervalSeq
      (compiler-reg-interval-seq-with-capacity
        (compiler-reg-interval-seq-count intervals))]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-interval-seq-count intervals))
        (let
          [interval : CompilerRegInterval
            (compiler-reg-interval-seq-ref intervals index)]
          (begin
            (let
              [var : i64 interval.var]
              (if (and
                (live.compiler-live-set-contains? vars var)
                (not (live.compiler-live-set-contains? blocked var)))
                (set! out (compiler-reg-interval-seq-append out interval))
                unit))
            (set! index (+ index 1)))))
      (compiler-reg-candidate-sort out))))

;; Vector/mask IR values carry their scalar lane type in type-info, so the
;; earlier scalar-class greedy can provisionally assign them a GP/XMM home.
;; Class-specific allocation owns the final home and must replace that
;; provisional assignment; the old fixed-candidate allocator did so implicitly.
(define (compiler-reg-unassign-special-candidates!
  [assignments : CompilerRegAssignmentTable]
  [candidates : CompilerRegIntervalSeq]) : unit
  (let
    [index : i64 0]
    (while (< index (compiler-reg-interval-seq-count candidates))
      (begin
        (compiler-reg-assignment-table-unassign
          assignments
          (__tl-project-field
            (compiler-reg-interval-seq-ref candidates index)
            var))
        (set! index (+ index 1))))))

(define (compiler-reg-active-before?
  [left : CompilerRegActive]
  [right : CompilerRegActive]) : bool
  (let
    [left-end : i64 left.end]
    [right-end : i64 right.end]
    (if (< left-end right-end)
      true
      (if (> left-end right-end)
        false
        (< left.var right.var)))))

;; Place `item` after every element it does not strictly precede -- the position
;; the former cons walk chose -- shifting the suffix up one slot.
(define (compiler-reg-active-insert
  [active : CompilerRegActiveSeq]
  [item : CompilerRegActive]) : CompilerRegActiveSeq
  (let
    [slots : (__tl_dyn-array CompilerRegActive) active.slots]
    [len : i64 active.len]
    [at : i64 0]
    (begin
      (while (and
        (< at len)
        (not (compiler-reg-active-before? item (array-ref slots at))))
        (set! at (+ at 1)))
      (if (< len (array-length slots))
        unit
        (let
          [bigger : (__tl_dyn-array CompilerRegActive)
            (array.make-array
              CompilerRegActive
              (compiler-reg-seq-grown-capacity (array-length slots)))]
          [i : i64 0]
          (begin
            (while (< i len)
              (begin
                (set! (array-ref bigger i) (array-ref slots i))
                (set! i (+ i 1))))
            (set! slots bigger))))
      (let
        [j : i64 len]
        (while (> j at)
          (begin
            (set! (array-ref slots j) (array-ref slots (- j 1)))
            (set! j (- j 1)))))
      (set! (array-ref slots at) item)
      (CompilerRegActiveSeq slots (+ len 1)))))

;; Drop everything that ended at or before `start`. Survivors are re-inserted
;; from the back so the result matches the former tail-first cons rebuild.
(define (compiler-reg-expire-active
  [active : CompilerRegActiveSeq]
  [start : i64]) : CompilerRegActiveSeq
  (let
    [slots : (__tl_dyn-array CompilerRegActive) active.slots]
    [index : i64 (- active.len 1)]
    [out : CompilerRegActiveSeq (compiler-reg-active-seq-empty)]
    (begin
      (while (>= index 0)
        (begin
          (let
            [item : CompilerRegActive (array-ref slots index)]
            (if (<= item.end start)
              unit
              (set! out (compiler-reg-active-insert out item))))
          (set! index (- index 1))))
      out)))

;; General hole-filling: is `reg` held by an active value that
;; conflicts with `var`? Two same-register values conflict iff their live
;; SEGMENTS overlap. This is sound for EVERY candidate because the allocator runs
;; on the merged-root index, where each candidate carries complete segments -- a
;; singleton its own live range, a class root the union of its members'. Every
;; segment hole is therefore genuine deadness, exactly the LLVM LiveInterval
;; property that makes segment-overlap an exact interference test. The earlier
;; rule trusted holes only for non-singleton roots, conservatively treating all
;; other values' segments as if incomplete; the merged-root index guarantees they
;; are not, so the restriction is dropped. (`hole-aware-vars` is retained on the
;; signature for the call sites but no longer gates the decision.)
(define (compiler-reg-active-register-conflicts?
  [active : CompilerRegActiveSeq]
  [reg : i64]
  [index : CompilerRegIntervalIndex]
  [var : i64]
  ;; lint-allow: unused-variable
  [hole-aware-vars : live.CompilerLiveI64Set]) : bool
  (let
    [slots : (__tl_dyn-array CompilerRegActive) active.slots]
    [count : i64 active.len]
    [at : i64 0]
    [conflict : bool false]
    (begin
      (while (and (< at count) (not conflict))
        (begin
          (let
            [item : CompilerRegActive (array-ref slots at)]
            (if (and
              (compiler-reg-registers-overlap? reg item.reg)
              (compiler-reg-vars-interfere-segmented-index? index var item.var))
              (set! conflict true)
              unit))
          (set! at (+ at 1))))
      conflict)))

;; First register not in conflict with `var` over its live segments
;; (CompilerRegMaybeId.No if every register is occupied by an interfering value).
(define (compiler-reg-first-free-register-holes
  [regs : CompilerRegIdSeq]
  [active : CompilerRegActiveSeq]
  [index : CompilerRegIntervalIndex]
  [var : i64]
  [hole-aware-vars : live.CompilerLiveI64Set]) : CompilerRegMaybeId
  (let
    [at : i64 0]
    [result : CompilerRegMaybeId (CompilerRegMaybeId.No)]
    [done : bool false]
    (begin
      (while (and (< at (compiler-reg-id-seq-count regs)) (not done))
        (let
          [reg : i64 (compiler-reg-id-seq-ref regs at)]
          (if (compiler-reg-active-register-conflicts?
            active
            reg
            index
            var
            hole-aware-vars)
            (set! at (+ at 1))
            (begin
              (set! result (CompilerRegMaybeId.Some reg))
              (set! done true)))))
      result)))

(define (compiler-reg-assignment-table-override-copy
  [assignments : (& assignments CompilerRegAssignmentTable)]
  [var : i64]
  [location : CompilerRegLocation]) : CompilerRegAssignmentTable
  (if (< var 0)
    (compiler-reg-assignment-table-copy-with-capacity
      assignments
      (array-length assignments.present))
    (compiler-reg-assignment-table-insert
      (compiler-reg-assignment-table-copy-with-capacity assignments (+ var 1))
      var
      location)))

;; Compatibility name for expression-shaped builders. The input is consumed,
;; but the returned table still owns fresh arrays; retained snapshots call the
;; explicit borrowed override helper above.
(define (compiler-reg-assignment-insert
  [assignments : CompilerRegAssignmentTable]
  [var : i64]
  [location : CompilerRegLocation]) : CompilerRegAssignmentTable
  (compiler-reg-assignment-table-override-copy assignments var location))

(define (compiler-reg-assignment-lookup
  [assignments : CompilerRegAssignmentTable]
  [var : i64]) : CompilerRegMaybeLocation
  (compiler-reg-assignment-table-lookup assignments var))

(define (compiler-reg-location-eq?
  [left : CompilerRegLocation]
  [right : CompilerRegLocation]) : bool
  (match left
    [(CompilerRegLocation.Register left-reg)
      (match right
        [(CompilerRegLocation.Register right-reg) (= left-reg right-reg)]
        [_ false])]
    [(CompilerRegLocation.RegisterPair left-a left-b)
      (match right
        [(CompilerRegLocation.RegisterPair right-a right-b)
          (and (= left-a right-a) (= left-b right-b))]
        [_ false])]
    [(CompilerRegLocation.Spill left-offset)
      (match right
        [(CompilerRegLocation.Spill right-offset) (= left-offset right-offset)]
        [_ false])]
    ;; Conservative: distinct rematerialised values never alias, and treating two
    ;; equal ones as different only forgoes a copy elision (never unsound).
    [(CompilerRegLocation.Remat _) false]))

;; Physical ownership overlap is deliberately separate from logical location
;; equality.  A %vec6 vector home and a %xmm6 scalar home are different
;; allocator-class spellings, but they cannot hold interfering values.  Spill
;; slots retain their existing exact-offset alias rule.
(define (compiler-reg-location-overlaps?
  [left : CompilerRegLocation]
  [right : CompilerRegLocation]) : bool
  (match left
    [(CompilerRegLocation.Register left-reg)
      (match right
        [(CompilerRegLocation.Register right-reg)
          (compiler-reg-registers-overlap? left-reg right-reg)]
        [(CompilerRegLocation.RegisterPair right-a right-b)
          (or
            (compiler-reg-registers-overlap? left-reg right-a)
            (compiler-reg-registers-overlap? left-reg right-b))]
        [_ false])]
    [(CompilerRegLocation.RegisterPair left-a left-b)
      (match right
        [(CompilerRegLocation.Register right-reg)
          (or
            (compiler-reg-registers-overlap? left-a right-reg)
            (compiler-reg-registers-overlap? left-b right-reg))]
        [(CompilerRegLocation.RegisterPair right-a right-b)
          (or
            (compiler-reg-registers-overlap? left-a right-a)
            (compiler-reg-registers-overlap? left-a right-b)
            (compiler-reg-registers-overlap? left-b right-a)
            (compiler-reg-registers-overlap? left-b right-b))]
        [_ false])]
    [(CompilerRegLocation.Spill left-offset)
      (match right
        [(CompilerRegLocation.Spill right-offset) (= left-offset right-offset)]
        [_ false])]
    [(CompilerRegLocation.Remat _) false]))

(define (compiler-reg-location-uses-register?
  [location : CompilerRegLocation]
  [reg : i64]) : bool
  (match location
    [(CompilerRegLocation.Register found)
      (compiler-reg-registers-overlap? found reg)]
    [(CompilerRegLocation.RegisterPair a b)
      (or
        (compiler-reg-registers-overlap? a reg)
        (compiler-reg-registers-overlap? b reg))]
    [(CompilerRegLocation.Spill _) false]
    [(CompilerRegLocation.Remat _) false]))

(define (compiler-reg-location-primary-register
  [location : CompilerRegLocation]) : i64
  (match location
    [(CompilerRegLocation.Register found) found]
    [(CompilerRegLocation.RegisterPair first _) first]
    [_ cabi.compiler-reg-id-invalid]))

(define (compiler-reg-assignment-table-var-uses-register?
  [assignment-index : (& assignment-index CompilerRegAssignmentTable)]
  [var : i64]
  [reg : i64]) : bool
  (match (compiler-reg-assignment-table-lookup assignment-index var)
    [(CompilerRegMaybeLocation.Some location)
      (compiler-reg-location-uses-register? location reg)]
    [(CompilerRegMaybeLocation.No) false]))

(define (compiler-reg-assignment-table-primary-register-home
  [assignment-index : (& assignment-index CompilerRegAssignmentTable)]
  [var : i64]) : i64
  (match (compiler-reg-assignment-table-lookup assignment-index var)
    [(CompilerRegMaybeLocation.Some location)
      (compiler-reg-location-primary-register location)]
    [(CompilerRegMaybeLocation.No) cabi.compiler-reg-id-invalid]))

(define (compiler-reg-assignments-use-register?
  [assignments : CompilerRegAssignmentTable]
  [reg : i64]) : bool
  (let
    [present : (__tl_dyn-array i64) assignments.present]
    [items : (__tl_dyn-array CompilerRegLocation) assignments.items]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (< index (array-length present)) (not found))
        (begin
          (if (and
            (not (= (array-ref present index) 0))
            (compiler-reg-location-uses-register? (array-ref items index) reg))
            (set! found true)
            unit)
          (set! index (+ index 1))))
      found)))

(define (compiler-reg-assignments-register-use-count
  [assignments : CompilerRegAssignmentTable]
  [reg : i64]) : i64
  (let
    [present : (__tl_dyn-array i64) assignments.present]
    [items : (__tl_dyn-array CompilerRegLocation) assignments.items]
    [index : i64 0]
    [count : i64 0]
    (begin
      (while (< index (array-length present))
        (begin
          (if (and
            (not (= (array-ref present index) 0))
            (compiler-reg-location-uses-register? (array-ref items index) reg))
            (set! count (+ count 1))
            unit)
          (set! index (+ index 1))))
      count)))

(define (compiler-reg-var-live-at-point?
  [starts : (& starts (__tl_dyn-array i64))]
  [ends : (& ends (__tl_dyn-array i64))]
  [var : i64]
  [point : i64]) : bool
  (and
    (>= var 0)
    (< var (array-length starts))
    (< var (array-length ends))
    (>= (array-ref starts var) 0)
    (<= (array-ref starts var) point)
    (<= point (array-ref ends var))))

(define (compiler-reg-var-live-over-range?
  [starts : (& starts (__tl_dyn-array i64))]
  [ends : (& ends (__tl_dyn-array i64))]
  [var : i64]
  [lo : i64]
  [hi : i64]) : bool
  (and
    (>= var 0)
    (< var (array-length starts))
    (< var (array-length ends))
    (>= (array-ref starts var) 0)
    (>= (array-ref ends var) 0)
    (<= (array-ref starts var) hi)
    (<= lo (array-ref ends var))))

(define (compiler-reg-assignment-table-register-free-at-point?
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [assignment-index : CompilerRegAssignmentTable]
  [vars : i64]
  [point : i64]
  [reg : i64]) : bool
  (let
    [v : i64 0]
    [free : bool true]
    (begin
      (while (and (< v vars) free)
        (begin
          (if (and
            (compiler-reg-var-live-at-point? starts ends v point)
            (compiler-reg-assignment-table-var-uses-register?
              assignment-index
              v
              reg))
            (set! free false)
            unit)
          (set! v (+ v 1))))
      free)))

(define (compiler-reg-assignment-table-register-free-over-range?
  [starts : (& starts (__tl_dyn-array i64))]
  [ends : (& ends (__tl_dyn-array i64))]
  [assignment-index : (& assignment-index CompilerRegAssignmentTable)]
  [vars : i64]
  [lo : i64]
  [hi : i64]
  [reg : i64]) : bool
  (let
    [v : i64 0]
    [free : bool true]
    (begin
      (while (and (< v vars) free)
        (begin
          (if (and
            (compiler-reg-var-live-over-range? starts ends v lo hi)
            (compiler-reg-assignment-table-var-uses-register?
              assignment-index
              v
              reg))
            (set! free false)
            unit)
          (set! v (+ v 1))))
      free)))

(define (compiler-reg-interval-lookup
  [intervals : CompilerRegIntervalSeq]
  [var : i64]) : CompilerRegMaybeInterval
  (let
    [index : i64 0]
    [result : CompilerRegMaybeInterval CompilerRegMaybeInterval.No]
    [done : bool false]
    (begin
      (while (and
        (< index (compiler-reg-interval-seq-count intervals))
        (not done))
        (let
          [interval : CompilerRegInterval
            (compiler-reg-interval-seq-ref intervals index)]
          [id : i64 interval.var]
          (cond
            [(= id var)
              (begin
                (set! result (CompilerRegMaybeInterval.Some interval))
                (set! done true))]
            [(> id var) (set! done true)]
            [else (set! index (+ index 1))])))
      result)))

(define (compiler-reg-interval-overlap?
  [left : CompilerRegInterval]
  [right : CompilerRegInterval]) : bool
  (let
    [left-start : i64 left.start]
    [left-end : i64 left.end]
    [right-start : i64 right.start]
    [right-end : i64 right.end]
    ;; Half-open boundary touch (X.end == Y.start): X's last read happens
    ;; before Y's same-point def writes, so the pair may share a register
    ;; -- EXCEPT when the touch point is 0 (M-A RC1). A value live at
    ;; point 0 without a def there (a parameter) had its home register
    ;; written in the PROLOGUE, before point 0, which the point model
    ;; cannot represent: two params used only near entry would otherwise
    ;; look disjoint ([0,0] vs [0,e]) and share a home whose second entry
    ;; copy destroys the first param's value. A 0-touch therefore counts
    ;; as overlap; touches at any later point keep the half-open rule.
    (not
      (or
        (and (<= left-end right-start) (not (= right-start 0)))
        (and (<= right-end left-start) (not (= left-start 0)))))))

(define (compiler-reg-interval-seq-overlaps-one?
  [segments : CompilerRegIntervalSeq]
  [interval : CompilerRegInterval]) : bool
  (let
    [slots : (__tl_dyn-array CompilerRegInterval) segments.slots]
    [count : i64 segments.len]
    [index : i64 0]
    [overlap : bool false]
    [done : bool false]
    (begin
      (while (and (< index count) (not done))
        (let
          [head : CompilerRegInterval (array-ref slots index)]
          [head-start : i64 head.start]
          [head-end : i64 head.end]
          [interval-start : i64 interval.start]
          [interval-end : i64 interval.end]
          (cond
            [(and (<= head-end interval-start) (not (= interval-start 0)))
              (set! index (+ index 1))]
            [(and (<= interval-end head-start) (not (= head-start 0)))
              (set! done true)]
            [else
              (begin
                (set! overlap true)
                (set! done true))])))
      overlap)))

(define (compiler-reg-interval-seq-overlaps?
  [left : CompilerRegIntervalSeq]
  [right : CompilerRegIntervalSeq]) : bool
  (let
    [left-slots : (__tl_dyn-array CompilerRegInterval) left.slots]
    [right-slots : (__tl_dyn-array CompilerRegInterval) right.slots]
    [left-count : i64 left.len]
    [right-count : i64 right.len]
    [left-index : i64 0]
    [right-index : i64 0]
    [overlap : bool false]
    (begin
      ;; Both inputs are ascending by start. A non-overlapping pair lets the
      ;; scan retire the interval that ends first; neither cursor retreats.
      (while (and
        (< left-index left-count)
        (< right-index right-count)
        (not overlap))
        (let
          [left-interval : CompilerRegInterval
            (array-ref left-slots left-index)]
          [right-interval : CompilerRegInterval
            (array-ref right-slots right-index)]
          [left-start : i64 left-interval.start]
          [left-end : i64 left-interval.end]
          [right-start : i64 right-interval.start]
          [right-end : i64 right-interval.end]
          (cond
            [(and (<= left-end right-start) (not (= right-start 0)))
              (set! left-index (+ left-index 1))]
            [(and (<= right-end left-start) (not (= left-start 0)))
              (set! right-index (+ right-index 1))]
            [else (set! overlap true)])))
      overlap)))

(define (compiler-reg-interval-range?
  [intervals : CompilerRegIntervalSeq]
  [var : i64]
  [start : i64]
  [end : i64]) : bool
  (match (compiler-reg-interval-lookup intervals var)
    [(CompilerRegMaybeInterval.Some interval)
      (and (= interval.start start) (= interval.end end))]
    [(CompilerRegMaybeInterval.No) false]))

(define (compiler-reg-vars-interfere-index?
  [intervals : CompilerRegIntervalIndex]
  [left : i64]
  [right : i64]) : bool
  (if (= left right)
    true
    (match (compiler-reg-interval-index-lookup intervals left)
      [(CompilerRegMaybeInterval.Some left-interval)
        (match (compiler-reg-interval-index-lookup intervals right)
          [(CompilerRegMaybeInterval.Some right-interval)
            (compiler-reg-interval-overlap? left-interval right-interval)]
          [(CompilerRegMaybeInterval.No) true])]
      [(CompilerRegMaybeInterval.No) true])))

;; Answer interference from per-var live segments when both
;; sides have segment data, with the coarse interval as the conservative
;; fallback.
;;
;; The `left` operand is re-resolved on every query even though the greedy
;; allocator's register scans hold it fixed across a whole register's residents.
;; Hoisting it into a `...-with-left?` entry threaded through the scans was
;; measured and REJECTED: the resolve is two compares and one bound-checked
;; load, which is cheaper than carrying the result across the call boundary at
;; every one of the ~19M queries (opt2 self-compile: +58M instructions net,
;; from `reg-free?` losing its inlining and the scans paying an extra argument
;; per query). Reducing this cost needs the query COUNT to drop -- a per-
;; register interval union -- not a cheaper per-query prologue.
(define (compiler-reg-vars-interfere-segmented-index?
  [intervals : CompilerRegIntervalIndex]
  [left : i64]
  [right : i64]) : bool
  (if (= left right)
    true
    (let
      [segments : (__tl_dyn-array CompilerRegIntervalSeq) intervals.segments]
      [left-segments : CompilerRegIntervalSeq
        (if (or (< left 0) (>= left (array-length segments)))
          (compiler-reg-interval-seq-empty)
          (array-ref segments left))]
      [right-segments : CompilerRegIntervalSeq
        (if (or (< right 0) (>= right (array-length segments)))
          (compiler-reg-interval-seq-empty)
          (array-ref segments right))]
      (if (and
        (not (compiler-reg-interval-seq-empty? left-segments))
        (not (compiler-reg-interval-seq-empty? right-segments)))
        (compiler-reg-interval-seq-overlaps? left-segments right-segments)
        (compiler-reg-vars-interfere-index? intervals left right)))))

;; Two values may share a register iff they occupy the SAME register class. The
;; old rule demanded identical AstType tags AND scalar-ness, which refused to
;; coalesce a copy between e.g. an i64 and a Ptr, or -- far more commonly in this
;; compiler -- between any two 8-byte HANDLE values (Enum/Struct/String/Box/Array
;; descriptors), even though all of those live in one GP register and are moved
;; with a plain movq. Nominal type is irrelevant to register sharing: the only
;; constraint is GP-vs-SSE (you cannot put a GP value in an XMM register), and
;; width consistency is already guaranteed because coalescing is driven by pure
;; moves, whose two endpoints always have the same representation. So: both
;; register-eligible, and both the same register class.
(define (compiler-reg-compatible-types?
  [types : CompilerRegVarTypes]
  [left : i64]
  [right : i64]) : bool
  (match (compiler-reg-var-types-lookup types left)
    [(CompilerRegMaybeType.Some left-ty)
      (match (compiler-reg-var-types-lookup types right)
        [(CompilerRegMaybeType.Some right-ty)
          (and
            (compiler-reg-register-eligible-type? left-ty)
            (compiler-reg-register-eligible-type? right-ty)
            (if (compiler-reg-float-type? left-ty)
              (compiler-reg-float-type? right-ty)
              (not (compiler-reg-float-type? right-ty))))]
        [(CompilerRegMaybeType.No) false])]
    [(CompilerRegMaybeType.No) false]))

;; M-C2: the overlap waiver admits every REGISTER-ELIGIBLE non-group value,
;; not just CPU scalars. The scalar-type? restriction predated handle register
;; eligibility (M-A/M-A2): when it was written, 8-byte handle values
;; (Array/String/enum/struct descriptors) were categorically stack-homed, so
;; scalar-only merely mirrored global eligibility. The waiver's value-carry
;; proof (single-def direct-copy chain => one register holds the shared bit
;; pattern) is representation-based and type-agnostic for anything the backend
;; moves with a plain movq; register groups never reach this test (both sides
;; are refused via group-vars in compiler-reg-coalesce-vars-compatible?), and
;; the float check keeps GP/XMM classes apart exactly as before.
(define (compiler-reg-same-value-overlap-eligible?
  [types : CompilerRegVarTypes]
  [left : i64]
  [right : i64]) : bool
  (match (compiler-reg-var-types-lookup types left)
    [(CompilerRegMaybeType.Some left-ty)
      (match (compiler-reg-var-types-lookup types right)
        [(CompilerRegMaybeType.Some right-ty)
          (and
            (compiler-reg-register-eligible-type? left-ty)
            (compiler-reg-register-eligible-type? right-ty)
            (if (compiler-reg-float-type? left-ty)
              (compiler-reg-float-type? right-ty)
              (not (compiler-reg-float-type? right-ty))))]
        [(CompilerRegMaybeType.No) false])]
    [(CompilerRegMaybeType.No) false]))

(define (compiler-reg-location-conflicts?
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [var : i64]
  [ignore-var : i64]
  [location : CompilerRegLocation]) : bool
  (compiler-reg-assignment-table-location-conflicts?
    assignments
    intervals
    var
    ignore-var
    location))

(define (compiler-reg-assignment-table-location-conflicts-from?
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [var : i64]
  [ignore-var : i64]
  [location : CompilerRegLocation]
  [index : i64]) : bool
  (let
    [present : (__tl_dyn-array i64) assignments.present]
    [items : (__tl_dyn-array CompilerRegLocation) assignments.items]
    (cond
      [(>= index (array-length present)) false]
      [(= (array-ref present index) 0)
        (compiler-reg-assignment-table-location-conflicts-from?
          assignments
          intervals
          var
          ignore-var
          location
          (+ index 1))]
      [(or (= index var) (= index ignore-var))
        (compiler-reg-assignment-table-location-conflicts-from?
          assignments
          intervals
          var
          ignore-var
          location
          (+ index 1))]
      [(and
          (compiler-reg-location-overlaps? (array-ref items index) location)
          (compiler-reg-vars-interfere-index? intervals var index))
        true]
      [else
        (compiler-reg-assignment-table-location-conflicts-from?
          assignments
          intervals
          var
          ignore-var
          location
          (+ index 1))])))

(define (compiler-reg-assignment-table-location-conflicts?
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [var : i64]
  [ignore-var : i64]
  [location : CompilerRegLocation]) : bool
  (compiler-reg-assignment-table-location-conflicts-from?
    assignments
    intervals
    var
    ignore-var
    location
    0))

(define (compiler-reg-assignment-table-location-conflicts-segmented-from?
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [var : i64]
  [ignore-var : i64]
  [location : CompilerRegLocation]
  [index : i64]) : bool
  (let
    [present : (__tl_dyn-array i64) assignments.present]
    [items : (__tl_dyn-array CompilerRegLocation) assignments.items]
    (cond
      [(>= index (array-length present)) false]
      [(= (array-ref present index) 0)
        (compiler-reg-assignment-table-location-conflicts-segmented-from?
          assignments
          intervals
          var
          ignore-var
          location
          (+ index 1))]
      [(or (= index var) (= index ignore-var))
        (compiler-reg-assignment-table-location-conflicts-segmented-from?
          assignments
          intervals
          var
          ignore-var
          location
          (+ index 1))]
      [(and
          (compiler-reg-location-overlaps? (array-ref items index) location)
          (compiler-reg-vars-interfere-segmented-index? intervals var index))
        true]
      [else
        (compiler-reg-assignment-table-location-conflicts-segmented-from?
          assignments
          intervals
          var
          ignore-var
          location
          (+ index 1))])))

(define (compiler-reg-assignment-table-location-conflicts-segmented?
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [var : i64]
  [ignore-var : i64]
  [location : CompilerRegLocation]) : bool
  (compiler-reg-assignment-table-location-conflicts-segmented-from?
    assignments
    intervals
    var
    ignore-var
    location
    0))

;; ---------------------------------------------------------------------------
;; #2 value-number same-value coalescing (move-flood bucket b).
;;
;; Bucket b (un-coalesced SSA copies, the dominant move class) is src-live
;; fan-out: `dst := src` where src stays live past the copy, so src and dst
;; OVERLAP and the interference-gated coalescer rejects them. But a copy whose
;; dst and src are BOTH single-static-def holds one identical value over the
;; entire overlap (dst mirrors src, neither is ever redefined), so merging them
;; into one register is sound regardless of overlap -- LLVM's
;; valuesIdentical/CR_Erase case (RegisterCoalescer.cpp:2799/3008).
;;
;; SOUNDNESS: only DIRECT `CompilerIrInstr.Mov dst (CompilerIrValue.Var src)` copies with
;; def-count[dst]==def-count[src]==1 enter the same-value relation. Phi inputs
;; (path-dependent) and multi-def vars -- the loop-carried set!/back-edge values
;; that are the fibonacci/four_acc/bce_sum miscompile class -- are EXCLUDED
;; because loop-carried values are lowered to phis or carry multiple defs and so
;; are never single-def direct copies. The relaxation only WAIVES interference
;; for proven same-value pairs; the geometry predicate is unchanged, and the
;; all-pairs class-compatibility check still rejects any class that would mix a
;; distinct-value var with an overlapping member.
;; The single var an instruction defines, or -1. This is
;; `live.compiler-live-instr-def-var`, the same decode the liveness def set is
;; built from, so the def census can never disagree with liveness about where a
;; var is defined (a missed def site would understate a multi-def var and is the
;; one unsound failure mode). Mirrors the def list of
;; compiler-reg-instr-def-type-array!.
(define (compiler-reg-instr-def-var [instr : ir.CompilerIrInstr]) : i64
  (live.compiler-live-instr-def-var instr))

(define (compiler-reg-count-def! [counts : (__tl_dyn-array i64)] [var : i64]) : unit
  (if (and (>= var 0) (< var (array-length counts)))
    (set! (array-ref counts var) (+ (array-ref counts var) 1))
    unit))

(define (compiler-reg-count-seq-defs!
  [instrs : ir.CompilerIrInstrSeq]
  [counts : (__tl_dyn-array i64)]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-reg-count-def!
            counts
            (compiler-reg-instr-def-var (array-ref slots index)))
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-count-block-defs!
  [blocks : ir.CompilerIrBlockList]
  [counts : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (compiler-reg-count-seq-defs! instrs counts)
            (compiler-reg-count-block-defs! (__tl-box-place rest) counts))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-count-seq-defs! instrs counts)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-mark-phi-def!
  [phi-defs : (__tl_dyn-array i64)]
  [var : i64]) : unit
  (if (and (>= var 0) (< var (array-length phi-defs)))
    (set! (array-ref phi-defs var) 1)
    unit))

(define (compiler-reg-mark-phi-defs-seq!
  [instrs : ir.CompilerIrInstrSeq]
  [phi-defs : (__tl_dyn-array i64)]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (match (array-ref slots index)
            [(ir.CompilerIrInstr.Phi dst _ _)
              (compiler-reg-mark-phi-def! phi-defs dst)]
            [_ unit])
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-mark-phi-defs-blocks!
  [blocks : ir.CompilerIrBlockList]
  [phi-defs : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (compiler-reg-mark-phi-defs-seq! instrs phi-defs)
            (compiler-reg-mark-phi-defs-blocks! (__tl-box-place rest) phi-defs))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-mark-phi-defs-seq! instrs phi-defs)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-param-count-defs!
  [params : ir.CompilerIrParamList]
  [counts : (__tl_dyn-array i64)]) : unit
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) unit]
    [(ir.CompilerIrParamList.Array seq)
      (compiler-reg-param-count-defs!
        (ir.compiler-ir-param-seq-to-list seq)
        counts)]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param _ _ id)
          (begin
            (compiler-reg-count-def! counts id)
            (compiler-reg-param-count-defs! (__tl-box-place rest) counts))])]))

(define (compiler-reg-function-def-counts [func : ir.CompilerIrFunction]) : (__tl_dyn-array
    i64)
  (match func
    [(ir.CompilerIrFunction.Function _ params _ vars blocks)
      (let
        [counts : (__tl_dyn-array i64) (array.make-array i64 vars)]
        (begin
          (compiler-reg-param-count-defs! params counts)
          (compiler-reg-count-block-defs! blocks counts)
          counts))]))

;; Same-value union-find, path-compressed; the class root is its min member id.
(define (compiler-reg-sv-find [parents : (__tl_dyn-array i64)] [x : i64]) : i64
  (if (or (< x 0) (>= x (array-length parents)))
    (- 0 1)
    (let
      [p : i64 (array-ref parents x)]
      (if (= p x)
        x
        (let
          [r : i64 (compiler-reg-sv-find parents p)]
          (begin
            (set! (array-ref parents x) r)
            r))))))

(define (compiler-reg-sv-union!
  [parents : (__tl_dyn-array i64)]
  [a : i64]
  [b : i64]) : unit
  (let
    [ra : i64 (compiler-reg-sv-find parents a)]
    [rb : i64 (compiler-reg-sv-find parents b)]
    (if (or (< ra 0) (< rb 0) (= ra rb))
      unit
      (if (< ra rb)
        (set! (array-ref parents rb) ra)
        (set! (array-ref parents ra) rb)))))

(define (compiler-reg-sv-single-def?
  [counts : (__tl_dyn-array i64)]
  [var : i64]) : bool
  (and (>= var 0) (< var (array-length counts)) (= (array-ref counts var) 1)))

(define (compiler-reg-sv-single-def-non-phi?
  [counts : (__tl_dyn-array i64)]
  [phi-defs : (__tl_dyn-array i64)]
  [var : i64]) : bool
  (and
    (compiler-reg-sv-single-def? counts var)
    (or (>= var (array-length phi-defs)) (= (array-ref phi-defs var) 0))))

(define (compiler-reg-sv-eligible?
  [eligible : (__tl_dyn-array i64)]
  [var : i64]) : bool
  (if (= (array-length eligible) 0)
    true
    (and
      (>= var 0)
      (< var (array-length eligible))
      (= (array-ref eligible var) 1))))

(define (compiler-reg-sv-add-instr!
  [instr : ir.CompilerIrInstr]
  [counts : (__tl_dyn-array i64)]
  [phi-defs : (__tl_dyn-array i64)]
  [eligible : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]) : unit
  (match instr
    [(ir.CompilerIrInstr.Mov dst src _)
      (match src
        [(ir.CompilerIrValue.Var svar)
          (if (and
            (compiler-reg-sv-single-def-non-phi? counts phi-defs dst)
            (compiler-reg-sv-single-def-non-phi? counts phi-defs svar)
            (compiler-reg-sv-eligible? eligible dst)
            (compiler-reg-sv-eligible? eligible svar))
            (compiler-reg-sv-union! parents svar dst)
            unit)]
        [_ unit])]
    [_ unit]))

(define (compiler-reg-sv-seq!
  [instrs : ir.CompilerIrInstrSeq]
  [counts : (__tl_dyn-array i64)]
  [phi-defs : (__tl_dyn-array i64)]
  [eligible : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-reg-sv-add-instr!
            (array-ref slots index)
            counts
            phi-defs
            eligible
            parents)
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-sv-blocks!
  [blocks : ir.CompilerIrBlockList]
  [counts : (__tl_dyn-array i64)]
  [phi-defs : (__tl_dyn-array i64)]
  [eligible : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (compiler-reg-sv-seq! instrs counts phi-defs eligible parents)
            (compiler-reg-sv-blocks!
              (__tl-box-place rest)
              counts
              phi-defs
              eligible
              parents))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-sv-seq! instrs counts phi-defs eligible parents)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-function-same-value-parents-filtered
  [func : ir.CompilerIrFunction]
  [eligible : (__tl_dyn-array i64)]) : (__tl_dyn-array i64)
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ vars blocks)
      (let
        [counts : (__tl_dyn-array i64) (compiler-reg-function-def-counts func)]
        [phi-defs : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [parents : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [index : i64 0]
        (begin
          (compiler-reg-mark-phi-defs-blocks! blocks phi-defs)
          (while (< index vars)
            (begin
              (set! (array-ref parents index) index)
              (set! index (+ index 1))))
          (compiler-reg-sv-blocks! blocks counts phi-defs eligible parents)
          parents))]))

(define (compiler-reg-function-same-value-parents
  [func : ir.CompilerIrFunction]) : (__tl_dyn-array i64)
  (compiler-reg-function-same-value-parents-filtered
    func
    (array.make-array i64 0)))

(define (compiler-reg-same-value-eligible-vars
  [interval-index : CompilerRegIntervalIndex]
  [clobber-points : live.CompilerLiveI64Set]) : (__tl_dyn-array i64)
  (let
    [starts : (__tl_dyn-array i64) interval-index.starts]
    [ends : (__tl_dyn-array i64) interval-index.ends]
    [eligible : (__tl_dyn-array i64)
      (array.make-array i64 (array-length starts))]
    [var : i64 0]
    (begin
      (while (< var (array-length starts))
        (begin
          (if (and
            (>= (array-ref starts var) 0)
            (not
              (compiler-reg-call-set-in-range?
                clobber-points
                (array-ref starts var)
                (array-ref ends var))))
            (set! (array-ref eligible var) 1)
            unit)
          (set! var (+ var 1))))
      eligible)))

(define (compiler-reg-same-value-eligible-vars-excluding
  [interval-index : CompilerRegIntervalIndex]
  [clobber-points : live.CompilerLiveI64Set]
  [storage-vars : live.CompilerLiveI64Set]) : (__tl_dyn-array i64)
  (let
    [eligible : (__tl_dyn-array i64)
      (compiler-reg-same-value-eligible-vars interval-index clobber-points)]
    [var : i64 0]
    (begin
      (while (< var (array-length eligible))
        (begin
          (if (live.compiler-live-set-contains? storage-vars var)
            (set! (array-ref eligible var) 0)
            unit)
          (set! var (+ var 1))))
      eligible)))

;; ---------------------------------------------------------------------------
;; M-C (part 1): same-value coalescing for copies OF mutable sources.
;;
;; The single-def-only same-value relation above never merges a copy of a
;; MUTABLE var (multi-def loop counter, or a phi-defined carry), so the
;; lowerer's fresh bounds-check index temps (`t = Mov i` / the width-64
;; `t = Cast i : u64`) each burn a register and a `movq` per iteration.
;;
;; Extension rule for `Mov/Cast64 dst <- src` where src is mutable:
;;   * dst is single-def non-phi and kind-0-eligible (existing semantics),
;;   * src is kind-0-eligible (existing clobber-span exclusion semantics),
;;   * both are GP-int scalars (floats/handles/groups excluded),
;;   * NO def point of the class's mutable member falls inside the LIVENESS
;;     (segments, hull fallback) of any single-def member of the other class.
;;
;; Soundness: the shared register is written by every def of the mutable m and
;; by each member's copy; two members co-live at q hold different values only
;; if some def D of m executed between their copy anchors -- but then the
;; earlier chain link is live AT D (its next use is reachable), so D lies in
;; that member's live segments and the merge was refused. Phi defs are modeled
;; at the phi instruction point: the backend writes phi homes only on the
;; specific CFG edge (single-successor pred ends, where live-out(pred) =
;; live-in(header), or dedicated `_branch_*` edge blocks -- switches reject phi
;; targets), and intra-edge-block read/write conflicts are ordered by the
;; parallel-copy solver, so "live at a write" implies "live at the phi point",
;; which the segment test sees. A class carries AT MOST ONE mutable member
;; (mutables only ever enter as copy SOURCES; a second one is refused), and the
;; def-inside check runs against the WHOLE other class on every union, so
;; copy-of-copy chains cannot smuggle a member past a def (the chain test).
;; The conservative interval-index is used (over-approximated liveness can only
;; refuse more), NOT the EP-relaxed coalesce index.
;;
;; The relation is consumed exactly like the single-def one: it only WAIVES the
;; overlap test for scalar pairs in compiler-reg-coalesce-vars-compatible?; the
;; merged root inherits the union interval/segments (merged-root-index), so
;; spans-call/div/shift for the class is the conservative OR of its members.
;; Only the scalar-opt2 plan builds this relation; SIMD/AVX and the post-hoc
;; loop-split/remat coalesce rebuilds keep the old builder byte-identical.
;; ---------------------------------------------------------------------------
(defstruct CompilerRegSvMultiCtx
  (parents (__tl_dyn-array i64))
  (counts (__tl_dyn-array i64))
  (phi-defs (__tl_dyn-array i64))
  (eligible (__tl_dyn-array i64))
  (class-multi (__tl_dyn-array i64))
  (def-off (__tl_dyn-array i64))
  (def-pts (__tl_dyn-array i64))
  (starts (__tl_dyn-array i64))
  (ends (__tl_dyn-array i64))
  (segments (__tl_dyn-array CompilerRegIntervalSeq))
  (int-ok (__tl_dyn-array i64)))

;; Fill the flattened per-var def-point buckets (block defs only; param entry
;; defs execute before every instruction and can never fall between two copy
;; anchors, so they are excluded). Same 2-points-per-instruction numbering as
;; compiler-reg-clobber-kind-points and the interval builders.
(define (compiler-reg-sv-def-points-fill-seq
  [instrs : ir.CompilerIrInstrSeq]
  [point : i64]
  [cursor : (__tl_dyn-array i64)]
  [pts : (__tl_dyn-array i64)]) : i64
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    [p : i64 point]
    (begin
      (while (< index count)
        (begin
          (let
            [v : i64 (compiler-reg-instr-def-var (array-ref slots index))]
            (if (and (>= v 0) (< v (array-length cursor)))
              (let
                [slot : i64 (array-ref cursor v)]
                (begin
                  (if (and (>= slot 0) (< slot (array-length pts)))
                    (set! (array-ref pts slot) p)
                    unit)
                  (set! (array-ref cursor v) (+ slot 1))))
              unit))
          (set! p (+ p 2))
          (set! index (+ index 1))))
      p)))

(define (compiler-reg-sv-def-points-fill-blocks
  [blocks : ir.CompilerIrBlockList]
  [point : i64]
  [cursor : (__tl_dyn-array i64)]
  [pts : (__tl_dyn-array i64)]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) point]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-sv-def-points-fill-blocks
            (__tl-box-place rest)
            (compiler-reg-sv-def-points-fill-seq instrs point cursor pts)
            cursor
            pts)])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out-point : i64 point]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set!
                    out-point
                    (compiler-reg-sv-def-points-fill-seq
                      instrs
                      out-point
                      cursor
                      pts))])
              (set! i (+ i 1))))
          out-point))]))

(define (compiler-reg-sv-point-in-segments?
  [segs : CompilerRegIntervalSeq]
  [p : i64]) : bool
  (let
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (< index (compiler-reg-interval-seq-count segs)) (not found))
        (begin
          (let
            [interval : CompilerRegInterval
              (compiler-reg-interval-seq-ref segs index)]
            (if (and (<= interval.start p) (<= p interval.end))
              (set! found true)
              (set! index (+ index 1))))
          unit))
      found)))

;; Is point p inside var v's liveness? Segment-precise when segments exist,
;; whole-hull fallback otherwise. Inclusive at both ends: a def point can never
;; equal another instruction's point, so inclusivity only rounds block-boundary
;; geometry conservatively (toward refusing a merge).
(define (compiler-reg-sv-point-in-var-live?
  [ctx : CompilerRegSvMultiCtx]
  [v : i64]
  [p : i64]) : bool
  (let
    [segments : (__tl_dyn-array CompilerRegIntervalSeq) ctx.segments]
    [starts : (__tl_dyn-array i64) ctx.starts]
    [ends : (__tl_dyn-array i64) ctx.ends]
    [segs : CompilerRegIntervalSeq
      (if (and (>= v 0) (< v (array-length segments)))
        (array-ref segments v)
        (compiler-reg-interval-seq-empty))]
    (if (compiler-reg-interval-seq-empty? segs)
      (if (and (>= v 0) (< v (array-length starts)))
        (and
          (>= (array-ref starts v) 0)
          (<= (array-ref starts v) p)
          (<= p (array-ref ends v)))
        false)
      (compiler-reg-sv-point-in-segments? segs p))))

;; Does any def point of mutable var m fall inside v's liveness?
(define (compiler-reg-sv-multi-def-in-var?
  [ctx : CompilerRegSvMultiCtx]
  [m : i64]
  [v : i64]) : bool
  (let
    [def-off : (__tl_dyn-array i64) ctx.def-off]
    [def-pts : (__tl_dyn-array i64) ctx.def-pts]
    (if (or (< m 0) (>= (+ m 1) (array-length def-off)))
      true
      (let
        [i : i64 (array-ref def-off m)]
        [stop : i64 (array-ref def-off (+ m 1))]
        [hit : bool false]
        (begin
          (while (< i stop)
            (begin
              (if (and
                (not hit)
                (compiler-reg-sv-point-in-var-live?
                  ctx
                  v
                  (if (and (>= i 0) (< i (array-length def-pts)))
                    (array-ref def-pts i)
                    (- 0 1))))
                (set! hit true)
                unit)
              (set! i (+ i 1))))
          hit)))))

;; Does any def point of m fall inside the liveness of ANY single-def member of
;; the class rooted at `root`?
(define (compiler-reg-sv-multi-conflict?
  [ctx : CompilerRegSvMultiCtx]
  [m : i64]
  [root : i64]) : bool
  (let
    [parents : (__tl_dyn-array i64) ctx.parents]
    [counts : (__tl_dyn-array i64) ctx.counts]
    [phi-defs : (__tl_dyn-array i64) ctx.phi-defs]
    [n : i64 (array-length parents)]
    [v : i64 0]
    [hit : bool false]
    (begin
      (while (< v n)
        (begin
          (if (and
            (not hit)
            (compiler-reg-sv-single-def-non-phi? counts phi-defs v)
            (= (compiler-reg-sv-find parents v) root)
            (compiler-reg-sv-multi-def-in-var? ctx m v))
            (set! hit true)
            unit)
          (set! v (+ v 1))))
      hit)))

;; Metadata-maintaining union: refuses a second mutable member, refuses when the
;; (dragged or direct) mutable's defs intrude into the other class's liveness,
;; and records the surviving class's mutable member under the new root.
(define (compiler-reg-sv-multi-union!
  [ctx : CompilerRegSvMultiCtx]
  [a : i64]
  [b : i64]) : unit
  (let
    [parents : (__tl_dyn-array i64) ctx.parents]
    [class-multi : (__tl_dyn-array i64) ctx.class-multi]
    [ra : i64 (compiler-reg-sv-find parents a)]
    [rb : i64 (compiler-reg-sv-find parents b)]
    (if (or (< ra 0) (< rb 0) (= ra rb))
      unit
      (let
        [ma : i64
          (if (< ra (array-length class-multi))
            (array-ref class-multi ra)
            (- 0 1))]
        [mb : i64
          (if (< rb (array-length class-multi))
            (array-ref class-multi rb)
            (- 0 1))]
        (if (and (>= ma 0) (>= mb 0))
          unit
          (let
            [m : i64
              (if (>= ma 0)
                ma
                mb)]
            (if (and
              (>= m 0)
              (compiler-reg-sv-multi-conflict?
                ctx
                m
                (if (>= ma 0)
                  rb
                  ra)))
              unit
              (begin
                (compiler-reg-sv-union! parents a b)
                (let
                  [r : i64 (compiler-reg-sv-find parents a)]
                  (if (and (>= r 0) (< r (array-length class-multi)))
                    (set! (array-ref class-multi r) m)
                    unit))))))))))

(define (compiler-reg-sv-int-ok? [int-ok : (__tl_dyn-array i64)] [v : i64]) : bool
  (and (>= v 0) (< v (array-length int-ok)) (= (array-ref int-ok v) 1)))

;; One copy pair (Mov, or width-64 int Cast). The single-def-src path mirrors
;; the original relation (no type restriction); the mutable-src path is the
;; M-C extension, GP-int scalars only.
(define (compiler-reg-sv-multi-pair!
  [ctx : CompilerRegSvMultiCtx]
  [svar : i64]
  [dst : i64]) : unit
  (let
    [counts : (__tl_dyn-array i64) ctx.counts]
    [phi-defs : (__tl_dyn-array i64) ctx.phi-defs]
    [eligible : (__tl_dyn-array i64) ctx.eligible]
    [int-ok : (__tl_dyn-array i64) ctx.int-ok]
    (if (and
      (compiler-reg-sv-single-def-non-phi? counts phi-defs dst)
      (compiler-reg-sv-eligible? eligible dst)
      (compiler-reg-sv-eligible? eligible svar))
      (if (compiler-reg-sv-single-def-non-phi? counts phi-defs svar)
        (compiler-reg-sv-multi-union! ctx svar dst)
        (if (and
          (compiler-reg-sv-int-ok? int-ok svar)
          (compiler-reg-sv-int-ok? int-ok dst))
          (compiler-reg-sv-multi-union! ctx svar dst)
          unit))
      unit)))

(define (compiler-reg-sv-multi-add-instr!
  [instr : ir.CompilerIrInstr]
  [ctx : CompilerRegSvMultiCtx]) : unit
  (match instr
    [(ir.CompilerIrInstr.Mov dst src _)
      (match src
        [(ir.CompilerIrValue.Var svar)
          (compiler-reg-sv-multi-pair! ctx svar dst)]
        [_ unit])]
    [(ir.CompilerIrInstr.Cast dst src from-ty to-ty)
      (match src
        [(ir.CompilerIrValue.Var svar)
          (if (compiler-reg-cast-copy-64? from-ty to-ty)
            (compiler-reg-sv-multi-pair! ctx svar dst)
            unit)]
        [_ unit])]
    [_ unit]))

(define (compiler-reg-sv-multi-seq!
  [instrs : ir.CompilerIrInstrSeq]
  [ctx : CompilerRegSvMultiCtx]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-reg-sv-multi-add-instr! (array-ref slots index) ctx)
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-sv-multi-blocks!
  [blocks : ir.CompilerIrBlockList]
  [ctx : CompilerRegSvMultiCtx]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-sv-multi-seq! instrs ctx)])
        (compiler-reg-sv-multi-blocks! (__tl-box-place rest) ctx))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-sv-multi-seq! instrs ctx)])
            (set! i (+ i 1)))))]))

;; Build the extended same-value relation (scalar-opt2 plan path only).
(define (compiler-reg-function-same-value-parents-multi
  [func : ir.CompilerIrFunction]
  [eligible : (__tl_dyn-array i64)]
  [type-info : CompilerRegVarTypes]
  [interval-index : CompilerRegIntervalIndex]) : (__tl_dyn-array i64)
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ vars blocks)
      (let
        [counts : (__tl_dyn-array i64) (compiler-reg-function-def-counts func)]
        [phi-defs : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [parents : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [class-multi : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [int-ok : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [bucket : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [def-off : (__tl_dyn-array i64) (array.make-array i64 (+ vars 1))]
        [index : i64 0]
        (begin
          (compiler-reg-mark-phi-defs-blocks! blocks phi-defs)
          (compiler-reg-count-block-defs! blocks bucket)
          (set! (array-ref def-off 0) 0)
          (while (< index vars)
            (begin
              (set!
                (array-ref def-off (+ index 1))
                (+ (array-ref def-off index) (array-ref bucket index)))
              (set! index (+ index 1))))
          (set! index 0)
          (let
            [total : i64 (array-ref def-off vars)]
            [def-pts : (__tl_dyn-array i64)
              (array.make-array
                i64
                (if (< total 1)
                  1
                  total))]
            [cursor : (__tl_dyn-array i64) (array.make-array i64 vars)]
            (begin
              (while (< index vars)
                (begin
                  (set! (array-ref parents index) index)
                  (set! (array-ref cursor index) (array-ref def-off index))
                  (set!
                    (array-ref class-multi index)
                    (if (compiler-reg-sv-single-def-non-phi?
                      counts
                      phi-defs
                      index)
                      (- 0 1)
                      index))
                  (set!
                    (array-ref int-ok index)
                    (match (compiler-reg-var-types-lookup type-info index)
                      [(CompilerRegMaybeType.Some ty)
                        (if (and
                          (compiler-reg-scalar-type? ty)
                          (not (compiler-reg-float-type? ty)))
                          1
                          0)]
                      [(CompilerRegMaybeType.No) 0]))
                  (set! index (+ index 1))))
              (let
                [_fill : i64
                  (compiler-reg-sv-def-points-fill-blocks
                    blocks
                    0
                    cursor
                    def-pts)]
                (begin
                  (compiler-reg-sv-multi-blocks!
                    blocks
                    (CompilerRegSvMultiCtx
                      parents
                      counts
                      phi-defs
                      eligible
                      class-multi
                      def-off
                      def-pts
                      interval-index.starts
                      interval-index.ends
                      interval-index.segments
                      int-ok))
                  parents))))))]))

(define (compiler-reg-same-value-class?
  [parents : (__tl_dyn-array i64)]
  [left : i64]
  [right : i64]) : bool
  (if (= (array-length parents) 0)
    false
    (let
      [rl : i64 (compiler-reg-sv-find parents left)]
      [rr : i64 (compiler-reg-sv-find parents right)]
      (and (>= rl 0) (= rl rr)))))

(define (compiler-reg-coalesce-map-init!
  [parents : (__tl_dyn-array i64)]
  [sizes : (__tl_dyn-array i64)]
  [index : i64]) : unit
  (if (>= index (array-length parents))
    unit
    (begin
      (set! (array-ref parents index) index)
      (set! (array-ref sizes index) 1)
      (compiler-reg-coalesce-map-init! parents sizes (+ index 1)))))

(define (compiler-reg-coalesce-map-root-from-parents
  [parents : (__tl_dyn-array i64)]
  [var : i64]) : i64
  (if (or (< var 0) (>= var (array-length parents)))
    (- 0 1)
    (array-ref parents var)))

(define (compiler-reg-coalesce-vars-compatible?
  [intervals : CompilerRegIntervalIndex]
  [types : CompilerRegVarTypes]
  [group-vars : live.CompilerLiveI64Set]
  [left : i64]
  [right : i64]
  [strict : bool]
  [sv-parents : (__tl_dyn-array i64)]) : bool
  (and
    (not (= left right))
    (not (live.compiler-live-set-contains? group-vars left))
    (not (live.compiler-live-set-contains? group-vars right))
    (compiler-reg-compatible-types? types left right)
    ;; #2 same-value relaxation: a proven same-value pair (single-def direct copy)
    ;; may coalesce despite overlap -- one register holds the shared value. The
    ;; geometry test itself is unchanged; this only ADDS the same-value escape.
    (or
      (not
        (if strict
          (compiler-reg-vars-interfere-index? intervals left right)
          (compiler-reg-vars-interfere-segmented-index? intervals left right)))
      (and
        (compiler-reg-same-value-overlap-eligible? types left right)
        (compiler-reg-same-value-class? sv-parents left right)))))

(define (compiler-reg-coalesce-map-var-compatible-with-root?
  [parents : (__tl_dyn-array i64)]
  [intervals : CompilerRegIntervalIndex]
  [types : CompilerRegVarTypes]
  [group-vars : live.CompilerLiveI64Set]
  [var : i64]
  [root : i64]
  [strict : bool]
  [index : i64]
  [sv-parents : (__tl_dyn-array i64)]) : bool
  (cond
    [(>= index (array-length parents)) true]
    [(= (array-ref parents index) root)
      (if (compiler-reg-coalesce-vars-compatible?
        intervals
        types
        group-vars
        var
        index
        strict
        sv-parents)
        (compiler-reg-coalesce-map-var-compatible-with-root?
          parents
          intervals
          types
          group-vars
          var
          root
          strict
          (+ index 1)
          sv-parents)
        false)]
    [else
      (compiler-reg-coalesce-map-var-compatible-with-root?
        parents
        intervals
        types
        group-vars
        var
        root
        strict
        (+ index 1)
        sv-parents)]))

(define (compiler-reg-coalesce-map-classes-compatible-from?
  [parents : (__tl_dyn-array i64)]
  [intervals : CompilerRegIntervalIndex]
  [types : CompilerRegVarTypes]
  [group-vars : live.CompilerLiveI64Set]
  [left-root : i64]
  [right-root : i64]
  [strict : bool]
  [index : i64]
  [sv-parents : (__tl_dyn-array i64)]) : bool
  (cond
    [(>= index (array-length parents)) true]
    [(= (array-ref parents index) left-root)
      (if (compiler-reg-coalesce-map-var-compatible-with-root?
        parents
        intervals
        types
        group-vars
        index
        right-root
        strict
        0
        sv-parents)
        (compiler-reg-coalesce-map-classes-compatible-from?
          parents
          intervals
          types
          group-vars
          left-root
          right-root
          strict
          (+ index 1)
          sv-parents)
        false)]
    [else
      (compiler-reg-coalesce-map-classes-compatible-from?
        parents
        intervals
        types
        group-vars
        left-root
        right-root
        strict
        (+ index 1)
        sv-parents)]))

(define (compiler-reg-coalesce-map-classes-compatible?
  [parents : (__tl_dyn-array i64)]
  [intervals : CompilerRegIntervalIndex]
  [types : CompilerRegVarTypes]
  [group-vars : live.CompilerLiveI64Set]
  [left-root : i64]
  [right-root : i64]
  [strict : bool]
  [sv-parents : (__tl_dyn-array i64)]) : bool
  (compiler-reg-coalesce-map-classes-compatible-from?
    parents
    intervals
    types
    group-vars
    left-root
    right-root
    strict
    0
    sv-parents))

(define (compiler-reg-coalesce-map-merge-root-parents-into!
  [parents : (__tl_dyn-array i64)]
  [winner : i64]
  [loser : i64]
  [index : i64]) : unit
  (if (>= index (array-length parents))
    unit
    (begin
      (if (= (array-ref parents index) loser)
        (set! (array-ref parents index) winner)
        unit)
      (compiler-reg-coalesce-map-merge-root-parents-into!
        parents
        winner
        loser
        (+ index 1)))))

;; Per-pair join (LLVM joinVirtRegs structure): maintain a per-root merged COARSE
;; interval [start,end] -- the union extent of the class members. Two roots with
;; DISJOINT coarse extents provably have no interfering member pair (each member's
;; segments lie within its coarse interval, which lies within the root extent), so
;; they join in O(1) without the O(n^2) all-pairs class scan. This is a sound
;; SUBSET of classes-compatible? (coarse-disjoint => segment-disjoint => every
;; cross pair non-interfering; the class is type-homogeneous and src/dst types are
;; already checked), so the coalescing RESULT is identical -- only the common
;; disjoint case takes the fast path. When extents overlap, the exact
;; classes-compatible? check still decides, preserving coalescing semantics
;; precisely.
(define (compiler-reg-coalesce-init-coarse!
  [root-start : (__tl_dyn-array i64)]
  [root-end : (__tl_dyn-array i64)]
  [src-start : (__tl_dyn-array i64)]
  [src-end : (__tl_dyn-array i64)]
  [index : i64]) : unit
  (if (>= index (array-length root-start))
    unit
    (begin
      (set!
        (array-ref root-start index)
        (if (< index (array-length src-start))
          (array-ref src-start index)
          (- 0 1)))
      (set!
        (array-ref root-end index)
        (if (< index (array-length src-end))
          (array-ref src-end index)
          (- 0 1)))
      (compiler-reg-coalesce-init-coarse!
        root-start
        root-end
        src-start
        src-end
        (+ index 1)))))

(define (compiler-reg-coalesce-coarse-disjoint?
  [root-start : (__tl_dyn-array i64)]
  [root-end : (__tl_dyn-array i64)]
  [a : i64]
  [b : i64]) : bool
  (let
    [a-start : i64 (array-ref root-start a)]
    [a-end : i64 (array-ref root-end a)]
    [b-start : i64 (array-ref root-start b)]
    [b-end : i64 (array-ref root-end b)]
    (if (or (< a-start 0) (< a-end 0) (< b-start 0) (< b-end 0))
      false
      (or (<= a-end b-start) (<= b-end a-start)))))

(define (compiler-reg-coalesce-map-merge-root-into!
  [parents : (__tl_dyn-array i64)]
  [sizes : (__tl_dyn-array i64)]
  [root-start : (__tl_dyn-array i64)]
  [root-end : (__tl_dyn-array i64)]
  [winner : i64]
  [loser : i64]) : unit
  (begin
    (set!
      (array-ref sizes winner)
      (+ (array-ref sizes winner) (array-ref sizes loser)))
    (set! (array-ref sizes loser) 0)
    (let
      [loser-start : i64 (array-ref root-start loser)]
      [loser-end : i64 (array-ref root-end loser)]
      [winner-start : i64 (array-ref root-start winner)]
      [winner-end : i64 (array-ref root-end winner)]
      (begin
        (if (< winner-start 0)
          (set! (array-ref root-start winner) loser-start)
          (if (if (< loser-start 0)
            false
            (< loser-start winner-start))
            (set! (array-ref root-start winner) loser-start)
            unit))
        (if (> loser-end winner-end)
          (set! (array-ref root-end winner) loser-end)
          unit)))
    (compiler-reg-coalesce-map-merge-root-parents-into! parents winner loser 0)))

(define (compiler-reg-coalesce-map-try-merge!
  [parents : (__tl_dyn-array i64)]
  [sizes : (__tl_dyn-array i64)]
  [root-start : (__tl_dyn-array i64)]
  [root-end : (__tl_dyn-array i64)]
  [intervals : CompilerRegIntervalIndex]
  [types : CompilerRegVarTypes]
  [group-vars : live.CompilerLiveI64Set]
  [left : i64]
  [right : i64]
  [strict : bool]
  [sv-parents : (__tl_dyn-array i64)]) : bool
  (let
    [left-root : i64 (compiler-reg-coalesce-map-root-from-parents parents left)]
    [right-root : i64
      (compiler-reg-coalesce-map-root-from-parents parents right)]
    (cond
      [(or (< left-root 0) (< right-root 0) (= left-root right-root)) false]
      [(not
          (compiler-reg-coalesce-vars-compatible?
            intervals
            types
            group-vars
            left
            right
            strict
            sv-parents))
        false]
      [(or
          (and
            (= (array-ref sizes left-root) 1)
            (= (array-ref sizes right-root) 1))
          ;; per-pair join fast path: disjoint merged extents => trivially legal.
          (compiler-reg-coalesce-coarse-disjoint?
            root-start
            root-end
            left-root
            right-root)
          (compiler-reg-coalesce-map-classes-compatible?
            parents
            intervals
            types
            group-vars
            left-root
            right-root
            strict
            sv-parents))
        (let
          [winner : i64
            (if (< left-root right-root)
              left-root
              right-root)]
          [loser : i64
            (if (< left-root right-root)
              right-root
              left-root)]
          (begin
            (compiler-reg-coalesce-map-merge-root-into!
              parents
              sizes
              root-start
              root-end
              winner
              loser)
            true))]
      [else false])))

(define (compiler-reg-coalesce-map-merge-moves!
  [parents : (__tl_dyn-array i64)]
  [sizes : (__tl_dyn-array i64)]
  [root-start : (__tl_dyn-array i64)]
  [root-end : (__tl_dyn-array i64)]
  [moves : CompilerRegMoveSeq]
  [intervals : CompilerRegIntervalIndex]
  [types : CompilerRegVarTypes]
  [group-vars : live.CompilerLiveI64Set]
  [changed : bool]
  [sv-parents : (__tl_dyn-array i64)]) : bool
  (let
    [slots : (__tl_dyn-array CompilerRegMove) moves.slots]
    [index : i64 (- moves.len 1)]
    [out : bool changed]
    (begin
      (while (>= index 0)
        (begin
          (let
            [item : CompilerRegMove (array-ref slots index)]
            [did-merge : bool
              (compiler-reg-coalesce-map-try-merge!
                parents
                sizes
                root-start
                root-end
                intervals
                types
                group-vars
                item.src
                item.dst
                item.strict
                sv-parents)]
            (set! out (or out did-merge)))
          (set! index (- index 1))))
      out)))

(define (compiler-reg-coalesce-map-fixpoint!
  [parents : (__tl_dyn-array i64)]
  [sizes : (__tl_dyn-array i64)]
  [root-start : (__tl_dyn-array i64)]
  [root-end : (__tl_dyn-array i64)]
  [moves : CompilerRegMoveSeq]
  [intervals : CompilerRegIntervalIndex]
  [types : CompilerRegVarTypes]
  [group-vars : live.CompilerLiveI64Set]
  [sv-parents : (__tl_dyn-array i64)]) : unit
  (begin
    (compiler-reg-coalesce-map-merge-moves!
      parents
      sizes
      root-start
      root-end
      moves
      intervals
      types
      group-vars
      false
      sv-parents)
    unit))

(define (compiler-reg-coalesce-map-build
  [moves : CompilerRegMoveSeq]
  [intervals : CompilerRegIntervalIndex]
  [types : CompilerRegVarTypes]
  [group-vars : live.CompilerLiveI64Set]
  [vars : i64]
  [sv-parents : (__tl_dyn-array i64)]) : CompilerRegCoalesceMap
  (if (compiler-reg-move-list-empty? moves)
    (CompilerRegCoalesceMap (array.make-array i64 0))
    (let
      [n : i64
        (if (< vars 1)
          1
          vars)]
      [parents : (__tl_dyn-array i64) (array.make-array i64 n)]
      [sizes : (__tl_dyn-array i64) (array.make-array i64 n)]
      [root-start : (__tl_dyn-array i64) (array.make-array i64 n)]
      [root-end : (__tl_dyn-array i64) (array.make-array i64 n)]
      (begin
        (compiler-reg-coalesce-map-init! parents sizes 0)
        (compiler-reg-coalesce-init-coarse!
          root-start
          root-end
          intervals.starts
          intervals.ends
          0)
        (compiler-reg-coalesce-map-fixpoint!
          parents
          sizes
          root-start
          root-end
          moves
          intervals
          types
          group-vars
          sv-parents)
        (CompilerRegCoalesceMap parents)))))

(define (compiler-reg-coalesce-location-from-class-from
  [coalesce : CompilerRegCoalesceMap]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [var : i64]
  [root : i64]
  [index : i64]) : CompilerRegMaybeLocation
  (let
    [parents : (__tl_dyn-array i64) coalesce.parents]
    (cond
      [(>= index (array-length parents)) CompilerRegMaybeLocation.No]
      [(or (= index var) (not (= (array-ref parents index) root)))
        (compiler-reg-coalesce-location-from-class-from
          coalesce
          assignments
          intervals
          var
          root
          (+ index 1))]
      [else
        (match (compiler-reg-assignment-table-lookup assignments index)
          [(CompilerRegMaybeLocation.Some location)
            (if (compiler-reg-assignment-table-location-conflicts-segmented?
              assignments
              intervals
              var
              index
              location)
              (compiler-reg-coalesce-location-from-class-from
                coalesce
                assignments
                intervals
                var
                root
                (+ index 1))
              (CompilerRegMaybeLocation.Some location))]
          [(CompilerRegMaybeLocation.No)
            (compiler-reg-coalesce-location-from-class-from
              coalesce
              assignments
              intervals
              var
              root
              (+ index 1))])])))

(define (compiler-reg-coalesce-location
  [coalesce : CompilerRegCoalesceMap]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [var : i64]) : CompilerRegMaybeLocation
  (let
    [parents : (__tl_dyn-array i64) coalesce.parents]
    [root : i64 (compiler-reg-coalesce-map-root-from-parents parents var)]
    (if (< root 0)
      CompilerRegMaybeLocation.No
      (compiler-reg-coalesce-location-from-class-from
        coalesce
        assignments
        intervals
        var
        root
        0))))

(define (compiler-reg-assignment-count
  [assignments : CompilerRegAssignmentTable]) : i64
  (let
    [present : (__tl_dyn-array i64) assignments.present]
    [index : i64 0]
    [count : i64 0]
    (begin
      (while (< index (array-length present))
        (begin
          (if (= (array-ref present index) 0)
            unit
            (set! count (+ count 1)))
          (set! index (+ index 1))))
      count)))

(define (compiler-reg-spill-count [assignments : CompilerRegAssignmentTable]) : i64
  (let
    [present : (__tl_dyn-array i64) assignments.present]
    [items : (__tl_dyn-array CompilerRegLocation) assignments.items]
    [index : i64 0]
    [count : i64 0]
    (begin
      (while (< index (array-length present))
        (begin
          (if (= (array-ref present index) 0)
            unit
            (match (array-ref items index)
              [(CompilerRegLocation.Spill _) (set! count (+ count 1))]
              [_ unit]))
          (set! index (+ index 1))))
      count)))

(define (compiler-reg-copy-hints-add-move!
  [hints : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]
  [src : i64]
  [dst : i64]) : unit
  (let
    [n : i64 (array-length hints)]
    [root-src : i64
      (if (if (>= src 0)
        (< src (array-length parents))
        false)
        (array-ref parents src)
        src)]
    [root-dst : i64
      (if (if (>= dst 0)
        (< dst (array-length parents))
        false)
        (array-ref parents dst)
        dst)]
    (if (or
      (= root-src root-dst)
      (< root-src 0)
      (>= root-src n)
      (< root-dst 0)
      (>= root-dst n))
      unit
      (begin
        (if (< (array-ref hints root-src) 0)
          (set! (array-ref hints root-src) root-dst)
          unit)
        (if (< (array-ref hints root-dst) 0)
          (set! (array-ref hints root-dst) root-src)
          unit)
        unit))))

(define (compiler-reg-copy-hints-from-moves!
  [hints : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]
  [moves : CompilerRegMoveSeq]) : unit
  (let
    [slots : (__tl_dyn-array CompilerRegMove) moves.slots]
    [index : i64 (- moves.len 1)]
    (while (>= index 0)
      (begin
        (let
          [item : CompilerRegMove (array-ref slots index)]
          (compiler-reg-copy-hints-add-move! hints parents item.src item.dst))
        (set! index (- index 1))))))

;; Two-address binop dst<->operand coalesce hints (LLVM TwoAddressInstructionPass).
;; The backend lowers a two-address binop as `movq lhs,staging; op rhs,staging`,
;; so biasing dst onto lhs's register elides the `movq` when they coincide. div/mod
;; are rax:rdx-fixed (staging is not the dst) -> skipped. Commutative ops also hint
;; dst<->rhs so the allocator can coalesce whichever operand lands free. Pure
;; tie-break: copy-hints-add-move! is first-wins and the greedy consumes it free-
;; only (never forces a spill/evict).
(define (compiler-reg-binop-two-address? [op : ir.CompilerIrBinOp]) : bool
  (match op
    [(ir.CompilerIrBinOp.Div) false]
    [(ir.CompilerIrBinOp.Mod) false]
    [(ir.CompilerIrBinOp.SafeDiv) false]
    [(ir.CompilerIrBinOp.SafeMod) false]
    [_ true]))

(define (compiler-reg-binop-commutative? [op : ir.CompilerIrBinOp]) : bool
  (match op
    [(ir.CompilerIrBinOp.Add) true]
    [(ir.CompilerIrBinOp.Mul) true]
    [(ir.CompilerIrBinOp.And) true]
    [(ir.CompilerIrBinOp.Or) true]
    [(ir.CompilerIrBinOp.BitAnd) true]
    [(ir.CompilerIrBinOp.BitOr) true]
    [(ir.CompilerIrBinOp.BitXor) true]
    [_ false]))

(define (compiler-reg-copy-hints-from-binops-instr!
  [instr : ir.CompilerIrInstr]
  [hints : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]
  [prefer-rhs : (__tl_dyn-array i64)]) : unit
  (match instr
    [(ir.CompilerIrInstr.BinOp dst op lhs rhs _)
      (if (compiler-reg-binop-two-address? op)
        ;; GAP8-C: the hint list is first-wins, so preferring the rhs is exactly
        ;; offering it first. The lhs is still offered behind it -- a flipped
        ;; binop whose rhs root is already hinted elsewhere keeps the old bias
        ;; rather than losing one. The flag is only ever set for a commutative
        ;; op, so the rhs hint it puts first is one the unflipped path would
        ;; have offered second anyway.
        (if (compiler-reg-alu-prefer-rhs? prefer-rhs dst)
          (begin
            (match rhs
              [(ir.CompilerIrValue.Var rhs-var)
                (compiler-reg-copy-hints-add-move! hints parents rhs-var dst)]
              [_ unit])
            (match lhs
              [(ir.CompilerIrValue.Var lhs-var)
                (compiler-reg-copy-hints-add-move! hints parents lhs-var dst)]
              [_ unit]))
          (begin
            (match lhs
              [(ir.CompilerIrValue.Var lhs-var)
                (compiler-reg-copy-hints-add-move! hints parents lhs-var dst)]
              [_ unit])
            (if (compiler-reg-binop-commutative? op)
              (match rhs
                [(ir.CompilerIrValue.Var rhs-var)
                  (compiler-reg-copy-hints-add-move! hints parents rhs-var dst)]
                [_ unit])
              unit)))
        unit)]
    [_ unit]))

(define (compiler-reg-copy-hints-from-binops-seq!
  [instrs : ir.CompilerIrInstrSeq]
  [hints : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]
  [prefer-rhs : (__tl_dyn-array i64)]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-reg-copy-hints-from-binops-instr!
            (array-ref slots index)
            hints
            parents
            prefer-rhs)
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-copy-hints-from-binops-blocks!
  [blocks : ir.CompilerIrBlockList]
  [hints : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]
  [prefer-rhs : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-copy-hints-from-binops-seq!
              instrs
              hints
              parents
              prefer-rhs)])
        (compiler-reg-copy-hints-from-binops-blocks!
          (__tl-box-place rest)
          hints
          parents
          prefer-rhs))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-copy-hints-from-binops-seq!
                  instrs
                  hints
                  parents
                  prefer-rhs)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-copy-hints-from-binops!
  [func : ir.CompilerIrFunction]
  [hints : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]
  [prefer-rhs : (__tl_dyn-array i64)]) : unit
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (compiler-reg-copy-hints-from-binops-blocks!
        blocks
        hints
        parents
        prefer-rhs)]))

;; Build per-root copy hints from the move list + two-address binops, mapping each
;; endpoint to its coalesce root. Moves are added first (first-wins), then binops
;; fill the rest, biasing each binop dst toward an operand's register.
(define (compiler-reg-function-copy-hints
  [moves : CompilerRegMoveSeq]
  [coalesce : CompilerRegCoalesceMap]
  [n : i64]
  [func : ir.CompilerIrFunction]
  [prefer-rhs : (__tl_dyn-array i64)]) : (__tl_dyn-array i64)
  (let
    [hints : (__tl_dyn-array i64) (array.make-array i64 n)]
    [parents : (__tl_dyn-array i64) coalesce.parents]
    (begin
      (compiler-reg-fill-i64-array hints -1)
      (compiler-reg-copy-hints-from-moves! hints parents moves)
      (compiler-reg-copy-hints-from-binops! func hints parents prefer-rhs)
      hints)))

(define (compiler-reg-fixed-preferred-register
  [assignments : CompilerRegAssignmentTable]
  [active : CompilerRegActiveSeq]
  [regs : CompilerRegIdSeq]
  [preferences : (__tl_dyn-array i64)]
  [interval-index : CompilerRegIntervalIndex]
  [var : i64]
  [start : i64]) : CompilerRegMaybeId
  (if (or (< var 0) (>= var (array-length preferences)))
    (CompilerRegMaybeId.No)
    (let
      [preferred : i64 (array-ref preferences var)]
      [ends : (__tl_dyn-array i64) interval-index.ends]
      (if (or
        (< preferred 0)
        (>= preferred (array-length ends))
        (> (array-ref ends preferred) start))
        (CompilerRegMaybeId.No)
        (match (compiler-reg-assignment-table-lookup assignments preferred)
          [(CompilerRegMaybeLocation.Some location)
            (match location
              [(CompilerRegLocation.Register reg)
                (if (or
                  (not (compiler-reg-id-seq-contains-physical? regs reg))
                  (compiler-reg-active-register-conflicts?
                    active
                    reg
                    interval-index
                    var
                    (live.compiler-live-set-empty)))
                  (CompilerRegMaybeId.No)
                  (CompilerRegMaybeId.Some reg))]
              [_ (CompilerRegMaybeId.No)])]
          [(CompilerRegMaybeLocation.No) (CompilerRegMaybeId.No)])))))

(define (compiler-reg-id-seq-contains-physical?
  [regs : CompilerRegIdSeq]
  [reg : i64]) : bool
  (let
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (< index (compiler-reg-id-seq-count regs)) (not found))
        (begin
          (if (compiler-reg-registers-overlap?
            (compiler-reg-id-seq-ref regs index)
            reg)
            (set! found true)
            unit)
          (set! index (+ index 1))))
      found)))

(define (compiler-reg-assignment-table-physical-active-from
  [assignments : CompilerRegAssignmentTable]
  [interval-index : CompilerRegIntervalIndex]
  [regs : CompilerRegIdSeq]
  [index : i64]
  [active : CompilerRegActiveSeq]) : CompilerRegActiveSeq
  (let
    [present : (__tl_dyn-array i64) assignments.present]
    [items : (__tl_dyn-array CompilerRegLocation) assignments.items]
    (if (>= index (array-length present))
      active
      (let
        [next : CompilerRegActiveSeq
          (if (= (array-ref present index) 0)
            active
            (match (array-ref items index)
              [(CompilerRegLocation.Register reg)
                (if (compiler-reg-id-seq-contains-physical? regs reg)
                  (match (compiler-reg-interval-index-lookup
                    interval-index
                    index)
                    [(CompilerRegMaybeInterval.Some interval)
                      (compiler-reg-active-insert
                        active
                        (CompilerRegActive index interval.end reg))]
                    [(CompilerRegMaybeInterval.No) active])
                  active)]
              [_ active]))]
        (compiler-reg-assignment-table-physical-active-from
          assignments
          interval-index
          regs
          (+ index 1)
          next)))))

;; Fixed-candidate allocation follows scalar allocation. Seed its active set
;; once with every already-assigned owner of the candidate physical bank; the
;; normal segment-aware interference query then prevents a future scalar
;; %xmm6 and an overlapping %vec6 from being accepted as independent homes.
;; This keeps candidate selection O(assignments + candidates * pool) rather
;; than rescanning the full scalar table for every register choice.
(define (compiler-reg-first-free-fixed-register
  [regs : CompilerRegIdSeq]
  [active : CompilerRegActiveSeq]
  [interval-index : CompilerRegIntervalIndex]
  [var : i64]) : CompilerRegMaybeId
  (let
    [index : i64 0]
    [result : CompilerRegMaybeId (CompilerRegMaybeId.No)]
    [done : bool false]
    (begin
      (while (and (< index (compiler-reg-id-seq-count regs)) (not done))
        (let
          [reg : i64 (compiler-reg-id-seq-ref regs index)]
          (if (compiler-reg-active-register-conflicts?
            active
            reg
            interval-index
            var
            (live.compiler-live-set-empty))
            (set! index (+ index 1))
            (begin
              (set! result (CompilerRegMaybeId.Some reg))
              (set! done true)))))
      result)))

(define (compiler-reg-assign-fixed-candidates-from
  [candidates : CompilerRegIntervalSeq]
  [index : i64]
  [regs : CompilerRegIdSeq]
  [active : CompilerRegActiveSeq]
  [assignments : CompilerRegAssignmentTable]
  [preferences : (__tl_dyn-array i64)]
  [interval-index : CompilerRegIntervalIndex]) : CompilerRegAssignState
  (if (>= index (compiler-reg-interval-seq-count candidates))
    (CompilerRegAssignState.State active assignments)
    (let
      [interval : CompilerRegInterval
        (compiler-reg-interval-seq-ref candidates index)]
      [var : i64 interval.var]
      [start : i64 interval.start]
      [end : i64 interval.end]
      [expired : CompilerRegActiveSeq (compiler-reg-expire-active active start)]
      [preferred : CompilerRegMaybeId
        (compiler-reg-fixed-preferred-register
          assignments
          expired
          regs
          preferences
          interval-index
          var
          start)]
      (match preferred
        [(CompilerRegMaybeId.Some reg)
          (compiler-reg-assign-fixed-candidates-from
            candidates
            (+ index 1)
            regs
            (compiler-reg-active-insert expired (CompilerRegActive var end reg))
            (compiler-reg-assignment-table-insert
              assignments
              var
              (CompilerRegLocation.Register reg))
            preferences
            interval-index)]
        [(CompilerRegMaybeId.No)
          (match (compiler-reg-first-free-fixed-register
            regs
            expired
            interval-index
            var)
            [(CompilerRegMaybeId.No)
              (compiler-reg-assign-fixed-candidates-from
                candidates
                (+ index 1)
                regs
                expired
                assignments
                preferences
                interval-index)]
            [(CompilerRegMaybeId.Some reg)
              (compiler-reg-assign-fixed-candidates-from
                candidates
                (+ index 1)
                regs
                (compiler-reg-active-insert
                  expired
                  (CompilerRegActive var end reg))
                (compiler-reg-assignment-table-insert
                  assignments
                  var
                  (CompilerRegLocation.Register reg))
                preferences
                interval-index)])]))))

(define (compiler-reg-assign-fixed-candidates
  [candidates : CompilerRegIntervalSeq]
  [regs : CompilerRegIdSeq]
  [active : CompilerRegActiveSeq]
  [assignments : CompilerRegAssignmentTable]
  [preferences : (__tl_dyn-array i64)]
  [interval-index : CompilerRegIntervalIndex]) : CompilerRegAssignState
  (compiler-reg-assign-fixed-candidates-from
    candidates
    0
    regs
    (compiler-reg-assignment-table-physical-active-from
      assignments
      interval-index
      regs
      0
      active)
    assignments
    preferences
    interval-index))

;; Call points (#perf/correctness): the primary integer pool admits only
;; callee-saved registers, so a value live across a call keeps its home safely.
;; The scalar caller-saved extension consults a stricter backend clobber set.
;; XMM/float/vector pools apply the same point set as an ABI register-mask
;; constraint: volatile homes are unavailable across these points, while an ABI
;; nonvolatile suffix remains legal.
(defenum CompilerRegCallScan
  (Scan i64 live.CompilerLiveI64Set))

(define (compiler-reg-call-points-seq
  [instrs : ir.CompilerIrInstrSeq]
  [point : i64]
  [set : live.CompilerLiveI64Set]) : CompilerRegCallScan
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    [p : i64 point]
    [out : live.CompilerLiveI64Set set]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (match (array-ref slots index)
              [(ir.CompilerIrInstr.Call _ _ _ _)
                (live.compiler-live-set-insert out p)]
              [(ir.CompilerIrInstr.CallIndirect _ _ _ _)
                (live.compiler-live-set-insert out p)]
              [(ir.CompilerIrInstr.CallIndirectC _ _ _ _)
                (live.compiler-live-set-insert out p)]
              [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
                (live.compiler-live-set-insert out p)]
              [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
                (live.compiler-live-set-insert out p)]
              [(ir.CompilerIrInstr.SpmdCall payload-box)
                (live.compiler-live-set-insert out p)]
              [(ir.CompilerIrInstr.TailCall _ _ _)
                (live.compiler-live-set-insert out p)]
              [(ir.CompilerIrInstr.TailCallIndirect _ _ _)
                (live.compiler-live-set-insert out p)]
              [_ out]))
          (set! p (+ p 2))
          (set! index (+ index 1))))
      (CompilerRegCallScan.Scan p out))))

(define (compiler-reg-call-points-blocks
  [blocks : ir.CompilerIrBlockList]
  [point : i64]
  [set : live.CompilerLiveI64Set]) : CompilerRegCallScan
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (CompilerRegCallScan.Scan point set)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (match (compiler-reg-call-points-seq instrs point set)
            [(CompilerRegCallScan.Scan p2 s2)
              (compiler-reg-call-points-blocks (__tl-box-place rest) p2 s2)])])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out-point : i64 point]
        [out-set : live.CompilerLiveI64Set set]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (match (compiler-reg-call-points-seq instrs out-point out-set)
                    [(CompilerRegCallScan.Scan p2 s2)
                      (begin
                        (set! out-point p2)
                        (set! out-set s2))])])
              (set! i (+ i 1))))
          (CompilerRegCallScan.Scan out-point out-set)))]))

(define (compiler-reg-call-points [func : ir.CompilerIrFunction]) : live.CompilerLiveI64Set
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (match (compiler-reg-call-points-blocks
        blocks
        0
        (live.compiler-live-set-empty))
        [(CompilerRegCallScan.Scan _ set) set])]))

(define (compiler-reg-backend-clobber-binop? [op : ir.CompilerIrBinOp]) : bool
  (match op
    [(ir.CompilerIrBinOp.Div) true]
    [(ir.CompilerIrBinOp.Mod) true]
    [(ir.CompilerIrBinOp.SafeDiv) true]
    [(ir.CompilerIrBinOp.SafeMod) true]
    [(ir.CompilerIrBinOp.Shl _) true]
    [(ir.CompilerIrBinOp.Shr _) true]
    [_ false]))

(define (compiler-reg-backend-caller-clobber-instr?
  [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Call _ _ _ _) true]
    [(ir.CompilerIrInstr.CallIndirect _ _ _ _) true]
    [(ir.CompilerIrInstr.CallIndirectC _ _ _ _) true]
    [(ir.CompilerIrInstr.CallCAbiStoreResult _) true]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult _) true]
    [(ir.CompilerIrInstr.SpmdCall _) true]
    [(ir.CompilerIrInstr.TailCall _ _ _) true]
    [(ir.CompilerIrInstr.TailCallIndirect _ _ _) true]
    [(ir.CompilerIrInstr.Syscall _ _) true]
    [(ir.CompilerIrInstr.BoundsCheck _ _ _) true]
    [(ir.CompilerIrInstr.CpuId _ _ _ _) true]
    [(ir.CompilerIrInstr.Xgetbv _ _) true]
    [(ir.CompilerIrInstr.Pack _ _ _) true]
    [(ir.CompilerIrInstr.BinOp _ op _ _ _)
      (compiler-reg-backend-clobber-binop? op)]
    [_ false]))

;; The tail-call family, exhaustively: the two IR instructions after which
;; control NEVER returns to this function. `TailCall` (direct) and
;; `TailCallIndirect` (computed callee) are the whole set -- there is no
;; tail C-ABI form (CallCAbiStoreResult / CallIndirectCAbiStoreResult store a
;; returned aggregate into a local buffer and are therefore resuming calls by
;; construction), and `SpmdCall` likewise returns. Both carry
;; CompilerIrEffect.ControlFlow in the IR effect model
;; (compiler-ir-instr-effect) and both are block TERMINATORS: the backend
;; emits them as "restore callee-saved regs; leave; jmp target"
;; (compiler-backend-tail-jump-tail), and the cold-call region builder already
;; classifies them as control flow (compiler-reg-call-region-control-flow-instr?).
(define (compiler-reg-tail-call-instr? [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.TailCall _ _ _) true]
    [(ir.CompilerIrInstr.TailCallIndirect _ _ _) true]
    [_ false]))

;; Clobber-POINT predicate for the register-search restriction + same-value
;; coalescing exclusion. Identical to caller-clobber-instr? EXCEPT bounds checks
;; are NOT clobber points: a bounds check's only register-clobbering effect is the
;; cold `call tl_oob_abort` on the never-taken failure branch, and that abort is
;; NORETURN -- on the success (fall-through) path NO caller-saved register is
;; clobbered. So a value live across a bounds check is never actually clobbered;
;; treating it as call-spanning wrongly bans it from all 9 caller-saved regs
;; (start-idx = caller-saved-count) AND excludes its loop-carried phi from
;; coalescing (2x slot inflation), forcing array-loop values to spill where clang
;; keeps them in registers. caller-clobber-instr? stays true for bounds checks so
;; remat-use-site-ok? remains conservative (the bounds-check cmp's scavenged
;; scratch could clobber a single-instruction remat home).
;;
;; IrInstrPack is ALSO not a clobber point. A Pack
;; (the 16-byte register-resident aggregate build for Maybe/Pair/tuple) never
;; clobbers a caller-saved register holding another live value:
;; compiler-backend-emit-pack-words takes a pure register-move fast path into the
;; Pack's OWN group-home registers (compiler-backend-emit-pack-words-direct-
;; registers -- only dst0/dst1, which the allocator gave the Pack's result, never
;; a live-across value's home), and for memory words it loads through a SCAVENGED
;; scratch (compiler-backend-scavenge-reg-here / -xmm-reg, default %r8/%r9/%xmm2/
;; %xmm3) chosen via the interval-aware occupied-mask -- scavenge-candidate-ok?
;; rejects any register free-bit not clear in the occupancy mask, so it can never
;; pick a register homing a live value, and even the default fallback is emergency
;; push/pop-wrapped when occupied. So a value live across a Pack is never actually
;; clobbered; treating it as call-spanning wrongly bans it from all 9 caller-saved
;; regs and excludes its loop-carried phi from same-value coalescing (forcing
;; spills/static reloads where the value could stay register-resident). The emit-
;; time scavenge freeness self-check is the soundness net. caller-clobber-instr?
;; stays true for Pack (remat conservatism), same split as bounds checks.
(define (compiler-reg-backend-clobber-point-instr?
  [_type-segment-bases : i64]
  [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.BoundsCheck _ _ _) false]
    [(ir.CompilerIrInstr.Pack _ _ _) false]
    ;; GAP3a: a shift by an in-range CONSTANT count is emitted as `shlq $imm, reg`
    ;; (compiler-backend-binop-immediate-shift-asm) and never reads or writes
    ;; %rcx/%cl, so it is NOT a clobber point. Only variable-count shifts (or
    ;; out-of-range constants, which fall back to the %cl register path) remain
    ;; clobber points -- the same rhs/type-aware classification the greedy's
    ;; kind-2 point set already uses (compiler-reg-clobber-binop-shift?). Before
    ;; this arm the coarse op-only test (compiler-reg-backend-clobber-binop? via
    ;; caller-clobber-instr?) counted EVERY shift, so the param ABI-pin gate
    ;; (compiler-reg-param-assign-plan) stack-homed or CSR-copied all params of
    ;; zero-call functions whose only "clobbers" were constant shifts
    ;; (crc_update shape). Divisions keep their rax:rdx clobber classification.
    ;; compiler-reg-backend-caller-clobber-instr? intentionally stays
    ;; conservative (remat-use-site-ok? / splitkit range proofs).
    [(ir.CompilerIrInstr.BinOp _ op _ rhs ty)
      (or
        (compiler-reg-clobber-binop-div? op)
        (compiler-reg-clobber-binop-shift? op rhs ty))]
    [_ (compiler-reg-backend-caller-clobber-instr? instr)]))

(define (compiler-reg-backend-win64-extra-clobber-instr?
  [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.Mov _ _ _) true]
    [(ir.CompilerIrInstr.AddrOf _ _) true]
    [(ir.CompilerIrInstr.Gep _ _ _ _) true]
    [(ir.CompilerIrInstr.Load _ _ _) true]
    [(ir.CompilerIrInstr.StorePtr _ _ _) true]
    [(ir.CompilerIrInstr.CopyBytes _ _ _) true]
    [(ir.CompilerIrInstr.Cast _ _ _ _) true]
    [(ir.CompilerIrInstr.Bitcast _ _ _ _) true]
    [(ir.CompilerIrInstr.BinOp _ _ _ _ _) true]
    [(ir.CompilerIrInstr.UnOp _ _ _ _) true]
    [(ir.CompilerIrInstr.LaneId _ _ _) true]
    [(ir.CompilerIrInstr.Splat _ _ _ _) true]
    [(ir.CompilerIrInstr.VectorBinOp _) true]
    [(ir.CompilerIrInstr.VectorPrefix _) true]
    [(ir.CompilerIrInstr.VectorReduce _ _ _ _ _) true]
    [(ir.CompilerIrInstr.VectorCompare _) true]
    [(ir.CompilerIrInstr.MaskBinOp _ _ _ _ _) true]
    [(ir.CompilerIrInstr.MaskNot _ _ _) true]
    [(ir.CompilerIrInstr.MaskReduce _ _ _ _) true]
    [(ir.CompilerIrInstr.Select _) true]
    [(ir.CompilerIrInstr.VectorLoad _ _ _ _ _) true]
    [(ir.CompilerIrInstr.VectorStore _) true]
    [(ir.CompilerIrInstr.PredicatedStore _) true]
    [(ir.CompilerIrInstr.PredicatedLoad _) true]
    [(ir.CompilerIrInstr.GatherLoad _) true]
    [(ir.CompilerIrInstr.VectorShuffle _) true]
    [(ir.CompilerIrInstr.TailMask _ _ _ _) true]
    [(ir.CompilerIrInstr.EntryArgc _) true]
    [(ir.CompilerIrInstr.EntryArgv _) true]
    [(ir.CompilerIrInstr.EntryEnvp _) true]
    [(ir.CompilerIrInstr.Store _ _ _) true]
    [(ir.CompilerIrInstr.Branch _ _ _) true]
    [(ir.CompilerIrInstr.TotalEnumBranch _ _ _) true]
    [(ir.CompilerIrInstr.Return _) true]
    [(ir.CompilerIrInstr.Pack _ _ _) true]
    [(ir.CompilerIrInstr.Word _ _ _ _) true]
    [(ir.CompilerIrInstr.Switch _ _ _ _) true]
    [(ir.CompilerIrInstr.TotalEnumSwitch _ _ _ _ _) true]
    [_ false]))

(define (compiler-reg-backend-caller-clobber-instr-for-abi?
  [target-abi : cabi.CompilerRegTargetAbi]
  [instr : ir.CompilerIrInstr]) : bool
  (match target-abi
    [(cabi.CompilerRegTargetAbi.Linux)
      (compiler-reg-backend-caller-clobber-instr? instr)]
    [(cabi.CompilerRegTargetAbi.Windows)
      (or
        (compiler-reg-backend-caller-clobber-instr? instr)
        (compiler-reg-backend-win64-extra-clobber-instr? instr))]))

;; Per-register clobber model (15c). The merged caller-clobber set above is too
;; coarse for the greedy: it treats a div/shift exactly like a call (all
;; caller-saved unavailable across it). But idiv clobbers only rax:rdx, and a variable shift only rcx, so a value CAN cross a
;; div in %r9/%rcx and a shift in %r9/%rdx. These per-kind point sets let the
;; greedy forbid only the registers an op actually clobbers.
;;   kind 0 = call-like (all caller-saved)   kind 1 = idiv
;;   kind 2 = shift                          kind 4 = loop-split rdx use
;;   kind 6 = call-like MINUS the tail-call family (see kind 6 below)
(define (compiler-reg-clobber-binop-div? [op : ir.CompilerIrBinOp]) : bool
  (match op
    [(ir.CompilerIrBinOp.Div) true]
    [(ir.CompilerIrBinOp.Mod) true]
    [(ir.CompilerIrBinOp.SafeDiv) true]
    [(ir.CompilerIrBinOp.SafeMod) true]
    [_ false]))

(define (compiler-reg-clobber-binop-rdx? [op : ir.CompilerIrBinOp]) : bool
  (match op
    [(ir.CompilerIrBinOp.Mul) true]
    [_ (compiler-reg-clobber-binop-div? op)]))

;; A shift binop clobbers %rcx ONLY when its count is emitted through the %cl
;; register path. The backend emits a CONSTANT, in-range count as an immediate
;; `shlq $imm, reg` (compiler-backend-binop-immediate-shift-asm) that never reads
;; or writes %rcx/%cl; a VARIABLE count -- or a constant the immediate path
;; rejects as out-of-range (count<0 or count>=type-width) -- is instead moved
;; into %rcx and shifted by %cl (compiler-backend-binop-shift-asm). So a value
;; live across a constant in-range shift is NEVER actually clobbered in %rcx;
;; the old op-only test treated every shift as an %rcx clobber point and
;; needlessly banned such values from %rcx (compiler-reg-greedy-forbidden-regs
;; via spans-shift). This rhs/type-aware test mirrors the backend's own
;; emission predicate compiler-backend-binop-valid-immediate-shift?; the shift
;; width is replicated locally (integer byte-size * 8) because regalloc must not
;; depend on the backend (cf. compiler-abi-gp-arg-register). scavcheck
;; SELFCHECK_CLEAN is the soundness net: a misclassified count that actually uses
;; %cl would surface as a %rcx clobber of a live value.
(define (compiler-reg-clobber-shift-width [ty : ast.AstType]) : i64
  (match ty
    [(ast.AstType.I64) 64]
    [(ast.AstType.U64) 64]
    [(ast.AstType.I32) 32]
    [(ast.AstType.U32) 32]
    [(ast.AstType.I16) 16]
    [(ast.AstType.U16) 16]
    [(ast.AstType.I8) 8]
    [(ast.AstType.U8) 8]
    [_ 0]))

;; True when rhs is a constant shift count the backend emits as an immediate
;; `$imm` (no %rcx use). Mirrors compiler-backend-immediate-operand restricted to
;; an integer constant + compiler-backend-shift-count-valid? (0 <= count <
;; width). Any other rhs (a variable, or an out-of-range constant) is left to the
;; %cl register path, so it stays a clobber point (conservative).
(define (compiler-reg-shift-const-in-range?
  [rhs : ir.CompilerIrValue]
  [count-ty : ast.AstType]
  [lhs-ty : ast.AstType]) : bool
  (match rhs
    [(ir.CompilerIrValue.I64 n)
      (if (match count-ty
        [(ast.AstType.I64) true]
        [(ast.AstType.I32) true]
        [(ast.AstType.I16) true]
        [(ast.AstType.I8) true]
        [_ false])
        (and (>= n 0) (< n (compiler-reg-clobber-shift-width lhs-ty)))
        (match count-ty
          [(ast.AstType.U64)
            (<
              (cast n : u64)
              (cast (compiler-reg-clobber-shift-width lhs-ty) : u64))]
          [_ (and (>= n 0) (< n (compiler-reg-clobber-shift-width lhs-ty)))]))]
    [_ false]))

(define (compiler-reg-clobber-binop-shift?
  [op : ir.CompilerIrBinOp]
  [rhs : ir.CompilerIrValue]
  [ty : ast.AstType]) : bool
  (match op
    [(ir.CompilerIrBinOp.Shl count-ty)
      (not (compiler-reg-shift-const-in-range? rhs count-ty ty))]
    [(ir.CompilerIrBinOp.Shr count-ty)
      (not (compiler-reg-shift-const-in-range? rhs count-ty ty))]
    [_ false]))

(define (compiler-reg-clobber-instr-kind?
  [type-segment-bases : i64]
  [instr : ir.CompilerIrInstr]
  [kind : i64]) : bool
  (match instr
    [(ir.CompilerIrInstr.BinOp _ op _ rhs ty)
      (cond
        [(= kind 1) (compiler-reg-clobber-binop-div? op)]
        [(= kind 2) (compiler-reg-clobber-binop-shift? op rhs ty)]
        [(= kind 4) (compiler-reg-clobber-binop-rdx? op)]
        [else false])]
    ;; kind 3 = switch dispatch points (GAP3c pin gate only; never kind 0 --
    ;; a switch clobbers no register per se, but its DISPATCH emitter's
    ;; emergency scavenge wraps a save/restore around the indirect jmp whose
    ;; restore lands AFTER the jmp = unreachable (the GAP2b vm_run finding),
    ;; so occupancy added at a dispatch by an ABI pin must be refused until
    ;; that emitter is fixed).
    [(ir.CompilerIrInstr.Switch _ _ _ _) (= kind 3)]
    [(ir.CompilerIrInstr.TotalEnumSwitch _ _ _ _ _) (= kind 3)]
    [_
      (cond
        [(= kind 0)
          (compiler-reg-backend-clobber-point-instr? type-segment-bases instr)]
        ;; kind 6 = kind 0 MINUS the tail-call family. A "clobber point" exists
        ;; to force a value that must SURVIVE an instruction into a register the
        ;; instruction preserves. After a tail call there is no survival to
        ;; model: control never returns to this function -- the callee returns
        ;; directly to OUR caller (the backend emits restore-CSRs + `leave` +
        ;; `jmp`, compiler-backend-tail-jump-tail), and the instruction is a
        ;; block terminator with no successor block, so NOTHING is live-out of
        ;; it. The values live INTO a tail call are exactly its arguments, and
        ;; they die AT it: the parallel-move marshalling into the argument
        ;; registers runs BEFORE the jmp and reads every source before writing
        ;; any destination (compiler-backend-emit-arg-move-list, which breaks
        ;; true cycles with a scavenged temp), so it needs no callee-saved home
        ;; either. This mirrors the BoundsCheck/Pack split above and the
        ;; abort-interlock precedent: the clobber is real but unobservable,
        ;; because no reachable instruction reads the clobbered register.
        ;;
        ;; Kind 0's coarse hull test (compiler-reg-greedy-var-spans-clobber? /
        ;; compiler-reg-param-pin-spans-clobber?) is what makes this matter. In
        ;; a multi-arm tail-call DISPATCHER -- a switch over N arms, each arm
        ;; permuting the same parameters into argument registers and jumping out
        ;; -- a parameter used only by arm 3 has an interval hull covering every
        ;; sibling arm, so it "spans" their tail calls in linear point space
        ;; even though no CFG path carries it across one. Under kind 0 the ABI
        ;; pin is revoked and the greedy's csr-only rule homes it in
        ;; %r12-%r15/%rbx/%rbp, and the prologue then pays 2n callee-saved
        ;; push/mov pairs on every invocation of a function that contains no
        ;; real call at all.
        ;;
        ;; Kind 6 is used by the ABI-pin gate and the scalar greedy only. The
        ;; conservative kind-0 set stays in force for the consumers that model
        ;; something OTHER than survival across the point (call-region
        ;; boundaries, the leaf CSR-split gate, the caller-saved rescue), and
        ;; compiler-reg-backend-caller-clobber-instr? -- remat's use-site
        ;; conservatism and the Win64 ABI predicate -- still counts tail calls.
        [(= kind 6)
          (and
            (compiler-reg-backend-clobber-point-instr? type-segment-bases instr)
            (not (compiler-reg-tail-call-instr? instr)))]
        ;; kind 5 = vector lowering that may still use XMM0/XMM1 family
        ;; spellings internally. The scalar allocator treats only those two
        ;; physical homes as clobbered; the vector pool remains XMM2+.
        [(= kind 5)
          (match instr
            [(ir.CompilerIrInstr.VectorBinOp _) true]
            [(ir.CompilerIrInstr.VectorCompare _) true]
            [(ir.CompilerIrInstr.MaskNot _ _ _) true]
            [(ir.CompilerIrInstr.Select _) true]
            [(ir.CompilerIrInstr.PredicatedLoad _) true]
            [(ir.CompilerIrInstr.VectorShuffle _) true]
            [(ir.CompilerIrInstr.TailMask _ _ _ _) true]
            [_ false])]
        [else false])]))

(define (compiler-reg-clobber-kind-points-seq
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [point : i64]
  [set : live.CompilerLiveI64Set]
  [kind : i64]) : CompilerRegCallScan
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    [p : i64 point]
    [out : live.CompilerLiveI64Set set]
    (begin
      (while (< index count)
        (begin
          (if (compiler-reg-clobber-instr-kind?
            type-segment-bases
            (array-ref slots index)
            kind)
            (set! out (live.compiler-live-set-insert out p))
            unit)
          (set! p (+ p 2))
          (set! index (+ index 1))))
      (CompilerRegCallScan.Scan p out))))

(define (compiler-reg-clobber-kind-points-blocks
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [point : i64]
  [set : live.CompilerLiveI64Set]
  [kind : i64]) : CompilerRegCallScan
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (CompilerRegCallScan.Scan point set)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (match (compiler-reg-clobber-kind-points-seq
            type-segment-bases
            instrs
            point
            set
            kind)
            [(CompilerRegCallScan.Scan p2 s2)
              (compiler-reg-clobber-kind-points-blocks
                type-segment-bases
                (__tl-box-place rest)
                p2
                s2
                kind)])])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out-point : i64 point]
        [out-set : live.CompilerLiveI64Set set]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (match (compiler-reg-clobber-kind-points-seq
                    type-segment-bases
                    instrs
                    out-point
                    out-set
                    kind)
                    [(CompilerRegCallScan.Scan p2 s2)
                      (begin
                        (set! out-point p2)
                        (set! out-set s2))])])
              (set! i (+ i 1))))
          (CompilerRegCallScan.Scan out-point out-set)))]))

(define (compiler-reg-clobber-kind-points
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [kind : i64]) : live.CompilerLiveI64Set
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (match (compiler-reg-clobber-kind-points-blocks
        type-segment-bases
        blocks
        0
        (live.compiler-live-set-empty)
        kind)
        [(CompilerRegCallScan.Scan _ set) set])]))

;; "Does any set bit of `bits` land strictly inside (start, end) once offset by
;; `var-base`?" The bit positions satisfying `start < var-base + i < end` form a
;; contiguous run, so the whole question is one mask test instead of a walk over
;; the set bits.
;;
;; The mask is clamped to positions 0..31 because `compiler-reg-low-bit-index32`
;; only ever reported indices in that range: it masks its argument to
;; `0xffffffff` and answers 31 when the low word is empty. A word carrying bits
;; above position 31 therefore tested index 31 in the original loop, which is
;; reproduced here by folding that case into bit 31 of the effective word rather
;; than assuming callers never pass one.
(define (compiler-reg-call-word-range-mask [low-bit : i64] [high-bit : i64]) : i64
  (shl (- (shl 1 (+ (- high-bit low-bit) 1)) 1) low-bit))

(define (compiler-reg-call-word-in-range?
  [bits : i64]
  [var-base : i64]
  [start : i64]
  [end : i64]) : bool
  (let
    [low : i64 (bit-and bits 0xffffffff)]
    [effective : i64
      (if (= bits low)
        low
        (bit-or low 0x80000000))]
    (if (= effective 0)
      false
      (let
        [lo : i64 (- (+ start 1) var-base)]
        [hi : i64 (- (- end 1) var-base)]
        [low-bit : i64
          (if (< lo 0)
            0
            lo)]
        [high-bit : i64
          (if (> hi 31)
            31
            hi)]
        (if (> low-bit high-bit)
          false
          (not
            (=
              (bit-and
                effective
                (compiler-reg-call-word-range-mask low-bit high-bit))
              0)))))))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-word-count-in-range
    [bits : i64]
    [var-base : i64]
    [start : i64]
    [end : i64]) : i64
    (if (= bits 0)
      0
      (let
        [i : i64 (compiler-reg-low-bit-index32 bits)]
        [c : i64 (+ var-base i)]
        [rest : i64
          (compiler-reg-call-word-count-in-range
            (bit-and bits (- bits 1))
            var-base
            start
            end)]
        (if (if (< start c)
          (< c end)
          false)
          (+ 1 rest)
          rest)))))

(define (compiler-reg-call-set-in-range-words?
  [set : live.CompilerLiveI64Set]
  [start : i64]
  [end : i64]
  [word-index : i64]
  [last-word : i64]) : bool
  (if (> word-index last-word)
    false
    (if (compiler-reg-call-word-in-range?
      (live.compiler-live-set-word-at-bounded set word-index)
      (* word-index (live.compiler-live-set-word-bits))
      start
      end)
      true
      (compiler-reg-call-set-in-range-words?
        set
        start
        end
        (+ word-index 1)
        last-word))))

;; Only the words holding positions inside `(start, end)` can answer yes, so the
;; scan starts and stops at those words instead of walking the whole set. Word
;; `w` holds global positions `w * word-bits .. w * word-bits + word-bits - 1`,
;; and the positions of interest are `start + 1 .. end - 1`, which gives the
;; bounds directly. Words outside that span contain no position the predicate
;; could accept, so skipping them cannot change the answer.
(define (compiler-reg-call-set-in-range?
  [set : live.CompilerLiveI64Set]
  [start : i64]
  [end : i64]) : bool
  (let
    [bits : i64 (live.compiler-live-set-word-bits)]
    [last-pos : i64 (- end 1)]
    [first-pos : i64
      (if (< (+ start 1) 0)
        0
        (+ start 1))]
    (if (> first-pos last-pos)
      false
      (let
        [count : i64 (live.compiler-live-set-word-count set)]
        [first-word : i64 (/ first-pos bits)]
        [raw-last-word : i64 (/ last-pos bits)]
        [last-word : i64
          (if (>= raw-last-word count)
            (- count 1)
            raw-last-word)]
        (if (> first-word last-word)
          false
          (compiler-reg-call-set-in-range-words?
            set
            start
            end
            first-word
            last-word))))))

;; SEGMENT-AWARE clobber-span test.
;;
;; The coarse hull test above answers "does a clobber point lie between this
;; value's first and last reference?". That is not the question the callers ask;
;; they ask "must this value SURVIVE a clobber point?", and the hull over-answers
;; whenever the value's live range has a HOLE. The canonical producer of holes is
;; a multi-arm dispatch: a value referenced in the entry block and again in arm 3
;; is dead in arms 0..2 and 4..n, yet its hull covers every one of them, so a
;; real call in a SIBLING arm pins it into a callee-saved home and the prologue
;; pays a push/pop for a register the value never needed.
;;
;; A hole is genuine deadness, not a gap in the model. If a value were live at a
;; point between two of its segments, dataflow liveness would have marked it live
;; there and the segment builder would have covered the point: the builder notes
;; every def, every use, and every live-AFTER bit of every instruction
;; (compiler-reg-extend-segment-touch! / the live-after bridge). So a point
;; outside all of a value's segments is a point on no path that carries the value
;; forward -- reaching it means the value is dead, and a clobber there destroys
;; nothing. This is the same LLVM LiveInterval property the allocator ALREADY
;; trusts for interference: compiler-reg-active-register-conflicts? lets two
;; values share one physical register exactly when their segments do not overlap,
;; on the merged-root index where "every segment hole is genuine deadness". If
;; holes were unsound here they would already be unsound there.
;;
;; Boundary conventions, per segment [s, e]:
;;   * `e` is exclusive, exactly as in the hull test. A segment ends at the
;;     value's last reference in that run (a value live-OUT of an instruction is
;;     in live-after and so keeps the segment open), so a clobber AT `e` is the
;;     instruction that consumes the value, which reads its operands before the
;;     clobber lands.
;;   * `s` is INCLUSIVE for every segment except the one starting at the hull
;;     start, which follows the caller's convention (`inclusive-hull-start?`).
;;     The hull start is the value's definition -- a call result born AT a call
;;     is not clobbered by it -- but a LATER segment opens where the value flows
;;     IN from a predecessor block, and a clobber at that point would destroy a
;;     value that is already live. (Parameters pass `true`: their home is written
;;     by the prologue, before point 0.)
;;
;; Both callers gate this walk behind their existing hull test. Every segment
;; lies inside the hull and every segment's accepted range lies inside the hull's
;; accepted range, so "no clobber in the hull" implies "no clobber in any
;; segment": the guard is exact, and a function without holes-that-matter pays
;; exactly what it paid before.
(define (compiler-reg-segments-span-clobber?
  [segments : CompilerRegIntervalSeq]
  [clobber-points : live.CompilerLiveI64Set]
  [hull-start : i64]
  [inclusive-hull-start? : bool]) : bool
  (let
    [count : i64 (compiler-reg-interval-seq-count segments)]
    [index : i64 0]
    [hit : bool false]
    (begin
      (while (and (< index count) (not hit))
        (begin
          (let
            [segment : CompilerRegInterval
              (compiler-reg-interval-seq-ref segments index)]
            [segment-start : i64 segment.start]
            ;; compiler-reg-call-set-in-range? accepts `start < c < end`; passing
            ;; `s - 1` turns that into the inclusive-start `s <= c < e`.
            [low : i64
              (if (and (= segment-start hull-start) (not inclusive-hull-start?))
                segment-start
                (- segment-start 1))]
            (if (compiler-reg-call-set-in-range? clobber-points low segment.end)
              (set! hit true)
              unit))
          (set! index (+ index 1))))
      hit)))

(define (compiler-reg-direct-call-points-seq
  [instrs : ir.CompilerIrInstrSeq]
  [point : i64]
  [set : live.CompilerLiveI64Set]) : CompilerRegCallScan
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    [p : i64 point]
    [out : live.CompilerLiveI64Set set]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (match (array-ref slots index)
              [(ir.CompilerIrInstr.Call _ _ _ _)
                (live.compiler-live-set-insert out p)]
              [(ir.CompilerIrInstr.SpmdCall payload-box)
                (live.compiler-live-set-insert out p)]
              [_ out]))
          (set! p (+ p 2))
          (set! index (+ index 1))))
      (CompilerRegCallScan.Scan p out))))

(define (compiler-reg-direct-call-points-blocks
  [blocks : ir.CompilerIrBlockList]
  [point : i64]
  [set : live.CompilerLiveI64Set]) : CompilerRegCallScan
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (CompilerRegCallScan.Scan point set)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (match (compiler-reg-direct-call-points-seq instrs point set)
            [(CompilerRegCallScan.Scan p2 s2)
              (compiler-reg-direct-call-points-blocks
                (__tl-box-place rest)
                p2
                s2)])])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out-point : i64 point]
        [out-set : live.CompilerLiveI64Set set]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (match (compiler-reg-direct-call-points-seq
                    instrs
                    out-point
                    out-set)
                    [(CompilerRegCallScan.Scan p2 s2)
                      (begin
                        (set! out-point p2)
                        (set! out-set s2))])])
              (set! i (+ i 1))))
          (CompilerRegCallScan.Scan out-point out-set)))]))

(define (compiler-reg-direct-call-points [func : ir.CompilerIrFunction]) : live.CompilerLiveI64Set
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (match (compiler-reg-direct-call-points-blocks
        blocks
        0
        (live.compiler-live-set-empty))
        [(CompilerRegCallScan.Scan _ set) set])]))

(define (compiler-reg-loop-depth-max) : i64
  8)

;; Loop-depth spill-weight multiplier, applied per ref when the spill-weight
;; walk scores a candidate. With allocation running on edge-precise liveness
;; (see compiler-reg-plan-from), loop-carry classes no longer inflate to
;; [entry, loop-end], so the legacy 2x ladder ranks per-iteration-hot webs
;; correctly against genuinely cold cross-loop webs. Steeper bases were tried
;; in the #6248 campaign and rejected: at 8^depth a depth-(d+1) web outranks
;; a depth-d web with many more refs even when the outer loop is the
;; genuinely hotter one (the lex_source regression seen there).
(define (compiler-reg-loop-depth-weight [depth : i64]) : i64
  (cond
    [(<= depth 0) 1]
    [(= depth 1) 2]
    [(= depth 2) 4]
    [(= depth 3) 8]
    [else 16]))

(define (compiler-reg-loop-depth-block-ids
  [blocks : ir.CompilerIrBlockList]
  [ids : reg_label_i64_map.Map (:consume)]
  [index : i64]) : reg_label_i64_map.Map
  (match blocks
    [(ir.CompilerIrBlockList.Nil) ids]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label _)
          (begin
            (reg_label_i64_map.insert-ref! (&mut ids) label index)
            (compiler-reg-loop-depth-block-ids
              (__tl-box-place rest)
              ids
              (+ index 1)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (compiler-reg-loop-depth-block-ids-seq seq ids index)]))

(define (compiler-reg-loop-depth-block-ids-seq
  [seq : ir.CompilerIrBlockSeq]
  [ids : reg_label_i64_map.Map (:consume)]
  [index : i64]) : reg_label_i64_map.Map
  (let
    [count : i64 (ir.compiler-ir-block-seq-count seq)]
    [i : i64 index]
    [out : reg_label_i64_map.Map ids]
    (begin
      (while (< i count)
        (match (ir.compiler-ir-block-seq-ref seq i)
          [(ir.CompilerIrBlock.Block label _)
            (reg_label_i64_map.insert-ref! (&mut out) label i)])
        (set! i (+ i 1)))
      out)))

(define (compiler-reg-loop-depth-record-succ!
  [loop-ends : (__tl_dyn-array i64)]
  [ids : reg_label_i64_map.Map]
  [source-id : i64]
  [label : i64]) : unit
  (match (reg_label_i64_map.get (& ids) label)
    [(reg_label_i64_map.LookupFound target-id)
      (if (and (>= target-id 0) (<= target-id source-id))
        (if (> source-id (array-ref loop-ends target-id))
          (set! (array-ref loop-ends target-id) source-id)
          unit)
        unit)]
    [(reg_label_i64_map.LookupMissing) unit]))

(define (compiler-reg-loop-depth-record-succs!
  [loop-ends : (__tl_dyn-array i64)]
  [ids : reg_label_i64_map.Map]
  [source-id : i64]
  [succs : live.CompilerLiveLabelSet]) : unit
  (match succs
    [(live.CompilerLiveLabelSet.Nil) unit]
    [(live.CompilerLiveLabelSet.Dense _ _)
      (begin
        (compiler-reg-loop-depth-record-succ!
          loop-ends
          ids
          source-id
          (live.compiler-live-label-set-ref succs 0))
        (compiler-reg-loop-depth-record-succs!
          loop-ends
          ids
          source-id
          (live.compiler-live-label-set-tail succs)))]))

(define (compiler-reg-loop-depth-record-blocks!
  [blocks : ir.CompilerIrBlockList]
  [ids : reg_label_i64_map.Map]
  [loop-ends : (__tl_dyn-array i64)]
  [index : i64]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (compiler-reg-loop-depth-record-succs!
          loop-ends
          ids
          index
          (live.compiler-live-block-successors block))
        (compiler-reg-loop-depth-record-blocks!
          (__tl-box-place rest)
          ids
          loop-ends
          (+ index 1)))]
    [(ir.CompilerIrBlockList.Array seq)
      (compiler-reg-loop-depth-record-blocks-seq! seq ids loop-ends index)]))

(define (compiler-reg-loop-depth-record-blocks-seq!
  [seq : ir.CompilerIrBlockSeq]
  [ids : reg_label_i64_map.Map]
  [loop-ends : (__tl_dyn-array i64)]
  [index : i64]) : unit
  (let
    [count : i64 (ir.compiler-ir-block-seq-count seq)]
    [i : i64 index]
    (while (< i count)
      (begin
        (compiler-reg-loop-depth-record-succs!
          loop-ends
          ids
          i
          (live.compiler-live-block-successors
            (ir.compiler-ir-block-seq-ref seq i)))
        (set! i (+ i 1))))))

(define (compiler-reg-loop-depth-bump-range!
  [depths : (__tl_dyn-array i64)]
  [index : i64]
  [end : i64]) : unit
  (if (or (>= index (array-length depths)) (> index end))
    unit
    (begin
      (if (< (array-ref depths index) (compiler-reg-loop-depth-max))
        (set! (array-ref depths index) (+ (array-ref depths index) 1))
        unit)
      (compiler-reg-loop-depth-bump-range! depths (+ index 1) end))))

(define (compiler-reg-loop-depths-from-ends!
  [loop-ends : (__tl_dyn-array i64)]
  [depths : (__tl_dyn-array i64)]
  [index : i64]) : unit
  (if (>= index (array-length loop-ends))
    unit
    (begin
      (if (>= (array-ref loop-ends index) index)
        (compiler-reg-loop-depth-bump-range!
          depths
          index
          (array-ref loop-ends index))
        unit)
      (compiler-reg-loop-depths-from-ends! loop-ends depths (+ index 1)))))

(define (compiler-reg-function-loop-depths [blocks : ir.CompilerIrBlockList]) : (__tl_dyn-array
    i64)
  (let
    [count : i64 (ir.compiler-ir-block-list-count blocks)]
    [depths : (__tl_dyn-array i64) (array.make-array i64 count)]
    [loop-ends : (__tl_dyn-array i64) (array.make-array i64 count)]
    [ids : reg_label_i64_map.Map
      (compiler-reg-loop-depth-block-ids
        blocks
        (reg_label_i64_map.with-capacity (compiler-reg-bits-map-capacity count))
        0)]
    (begin
      (compiler-reg-fill-i64-array loop-ends (- 0 1))
      (compiler-reg-loop-depth-record-blocks! blocks ids loop-ends 0)
      (compiler-reg-loop-depths-from-ends! loop-ends depths 0)
      depths)))

(define (compiler-reg-ref-counts-add-var-weighted!
  [counts : (__tl_dyn-array i64)]
  [var : i64]
  [weight : i64]) : unit
  (if (and (>= var 0) (< var (array-length counts)))
    (set! (array-ref counts var) (+ (array-ref counts var) weight))
    unit))

(define (compiler-reg-ref-counts-add-ids-weighted!
  [counts : (__tl_dyn-array i64)]
  [ids : (__tl_dyn-array i64)]
  [id-count : i64]
  [weight : i64]) : unit
  (let
    [index : i64 0]
    (while (< index id-count)
      (begin
        (compiler-reg-ref-counts-add-var-weighted!
          counts
          (array-ref ids index)
          weight)
        (set! index (+ index 1))))))

(define (compiler-reg-ref-counts-add-word-weighted!
  [counts : (__tl_dyn-array i64)]
  [bits : i64]
  [var-base : i64]
  [weight : i64]) : unit
  (if (= bits 0)
    unit
    (let
      [i : i64 (compiler-reg-low-bit-index32 bits)]
      [var : i64 (+ var-base i)]
      (begin
        (compiler-reg-ref-counts-add-var-weighted! counts var weight)
        (compiler-reg-ref-counts-add-word-weighted!
          counts
          (bit-and bits (- bits 1))
          var-base
          weight)))))

(define (compiler-reg-ref-counts-add-set-words-weighted!
  [counts : (__tl_dyn-array i64)]
  [set : live.CompilerLiveI64Set]
  [word-index : i64]
  [weight : i64]) : unit
  (if (>= word-index (live.compiler-live-set-word-count set))
    unit
    (begin
      ;; `compiler-reg-ref-counts-add-word-weighted!` returns immediately for an
      ;; empty word, so testing here skips the call for the common case in a
      ;; sparse live set without changing what happens.
      (let
        [bits : i64 (live.compiler-live-set-word-at-bounded set word-index)]
        (if (= bits 0)
          unit
          (compiler-reg-ref-counts-add-word-weighted!
            counts
            bits
            (* word-index (live.compiler-live-set-word-bits))
            weight)))
      (compiler-reg-ref-counts-add-set-words-weighted!
        counts
        set
        (+ word-index 1)
        weight))))

(define (compiler-reg-ref-counts-add-set-weighted!
  [counts : (__tl_dyn-array i64)]
  [set : live.CompilerLiveI64Set]
  [weight : i64]) : unit
  (compiler-reg-ref-counts-add-set-words-weighted! counts set 0 weight))

(define (compiler-reg-ref-counts-add-instr!
  [counts : (__tl_dyn-array i64)]
  [instr : ir.CompilerIrInstr]) : unit
  (compiler-reg-ref-counts-add-instr-weighted! counts instr 1))

(define (compiler-reg-ref-counts-add-instr-weighted!
  [counts : (__tl_dyn-array i64)]
  [instr : ir.CompilerIrInstr]
  [weight : i64]) : unit
  (let
    [ids : (__tl_dyn-array i64) (live.compiler-live-instr-ids)]
    [id-count : i64 (live.compiler-live-instr-use-ids! instr)]
    (if (< id-count 0)
      (begin
        (compiler-reg-ref-counts-add-set-weighted!
          counts
          (live.compiler-live-instr-uses instr)
          weight)
        (compiler-reg-ref-counts-add-set-weighted!
          counts
          (live.compiler-live-instr-defs instr)
          weight))
      (begin
        ;; Uses and defs are counted independently -- a var that is read and
        ;; written here scores twice, exactly as the two separate set walks did.
        (compiler-reg-ref-counts-add-ids-weighted! counts ids id-count weight)
        (compiler-reg-ref-counts-add-var-weighted!
          counts
          (live.compiler-live-instr-def-var instr)
          weight)))))

(define (compiler-reg-ref-counts-seq!
  [counts : (__tl_dyn-array i64)]
  [instrs : ir.CompilerIrInstrSeq]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (while (< index count)
      (begin
        (compiler-reg-ref-counts-add-instr! counts (array-ref slots index))
        (set! index (+ index 1))))))

(define (compiler-reg-ref-counts-seq-weighted!
  [counts : (__tl_dyn-array i64)]
  [instrs : ir.CompilerIrInstrSeq]
  [weight : i64]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (while (< index count)
      (begin
        (compiler-reg-ref-counts-add-instr-weighted!
          counts
          (array-ref slots index)
          weight)
        (set! index (+ index 1))))))

(define (compiler-reg-ref-counts-blocks!
  [counts : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-ref-counts-seq! counts instrs)])
        (compiler-reg-ref-counts-blocks! counts (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-ref-counts-seq! counts instrs)])
            (set! i (+ i 1)))))]))

;; Boolean "does this variable appear in the IR at all?" walk.
;;
;; `compiler-reg-color-stack-slots` is the only consumer of the UNWEIGHTED
;; counts above, and it only ever asks whether a count is zero -- a variable no
;; instruction mentions needs no frame slot. This chain answers exactly that
;; question with one byte per variable.
;;
;; It marks the same variables the weighted walk would have left nonzero: every
;; write there adds weight 1 at the same variable positions, and the counts
;; start at zero, so "nonzero count" and "marked" name the same set. What it
;; drops is the read-modify-write, the weight parameter, and the
;; add-instr!/add-set-weighted! forwarding layers. The weighted chain above is
;; untouched -- the spill-weight, remat, and merge consumers keep exact counts,
;; as does the regalloc test that asserts them.
;;
;; The per-variable store is spelled inline at each site instead of going
;; through a shared helper: that helper would be a real call on the hottest
;; edge of the pass (P28's single-caller inlining cliff -- several callers here
;; would keep it out of line), so the body is written out the way P29 spelled
;; segment-note-span! inline.
(define (compiler-reg-ref-mark-word!
  [marks : (__tl_dyn-array bool)]
  [bits : i64]
  [var-base : i64]) : unit
  (if (= bits 0)
    unit
    (let
      [var : i64 (+ var-base (compiler-reg-low-bit-index32 bits))]
      (begin
        (if (and (>= var 0) (< var (array-length marks)))
          (set! (array-ref marks var) true)
          unit)
        (compiler-reg-ref-mark-word! marks (bit-and bits (- bits 1)) var-base)))))

(define (compiler-reg-ref-mark-set-words!
  [marks : (__tl_dyn-array bool)]
  [set : live.CompilerLiveI64Set]
  [word-index : i64]) : unit
  (if (>= word-index (live.compiler-live-set-word-count set))
    unit
    (begin
      ;; Same empty-word shortcut the weighted walk uses.
      (let
        [bits : i64 (live.compiler-live-set-word-at-bounded set word-index)]
        (if (= bits 0)
          unit
          (compiler-reg-ref-mark-word!
            marks
            bits
            (* word-index (live.compiler-live-set-word-bits)))))
      (compiler-reg-ref-mark-set-words! marks set (+ word-index 1)))))

(define (compiler-reg-ref-mark-instr!
  [marks : (__tl_dyn-array bool)]
  [instr : ir.CompilerIrInstr]) : unit
  (let
    [ids : (__tl_dyn-array i64) (live.compiler-live-instr-ids)]
    [id-count : i64 (live.compiler-live-instr-use-ids! instr)]
    (if (< id-count 0)
      (begin
        (compiler-reg-ref-mark-set-words!
          marks
          (live.compiler-live-instr-uses instr)
          0)
        (compiler-reg-ref-mark-set-words!
          marks
          (live.compiler-live-instr-defs instr)
          0))
      (let
        [index : i64 0]
        (begin
          ;; Uses first, then the def -- the same order and the same variable
          ;; set the weighted walk visited; only the stored value differs.
          (while (< index id-count)
            (let
              [var : i64 (array-ref ids index)]
              (begin
                (if (and (>= var 0) (< var (array-length marks)))
                  (set! (array-ref marks var) true)
                  unit)
                (set! index (+ index 1)))))
          (let
            [def-var : i64 (live.compiler-live-instr-def-var instr)]
            (if (and (>= def-var 0) (< def-var (array-length marks)))
              (set! (array-ref marks def-var) true)
              unit)))))))

(define (compiler-reg-ref-mark-seq!
  [marks : (__tl_dyn-array bool)]
  [instrs : ir.CompilerIrInstrSeq]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (while (< index count)
      (begin
        (compiler-reg-ref-mark-instr! marks (array-ref slots index))
        (set! index (+ index 1))))))

(define (compiler-reg-ref-marks-blocks!
  [marks : (__tl_dyn-array bool)]
  [blocks : ir.CompilerIrBlockList]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-ref-mark-seq! marks instrs)])
        (compiler-reg-ref-marks-blocks! marks (__tl-box-place rest)))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-ref-mark-seq! marks instrs)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-ref-counts-blocks-weighted!
  [counts : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]
  [depths : (__tl_dyn-array i64)]
  [block-index : i64]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-ref-counts-seq-weighted!
              counts
              instrs
              (compiler-reg-loop-depth-weight (array-ref depths block-index)))])
        (compiler-reg-ref-counts-blocks-weighted!
          counts
          (__tl-box-place rest)
          depths
          (+ block-index 1)))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [index : i64 block-index]
        (while (< i count)
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-ref-counts-seq-weighted!
                  counts
                  instrs
                  (compiler-reg-loop-depth-weight (array-ref depths index)))])
            (set! index (+ index 1))
            (set! i (+ i 1)))))]))

(define (compiler-reg-remat-value? [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.I64 _) true]
    [(ir.CompilerIrValue.Bool _) true]
    [(ir.CompilerIrValue.Char _) true]
    [(ir.CompilerIrValue.F64 _) true]
    [(ir.CompilerIrValue.GlobalAddr _) true]
    [_ false]))

(define (compiler-reg-remat-mov-value?
  [value : ir.CompilerIrValue]
  [allow-invariant-loads : bool]) : bool
  (match value
    [(ir.CompilerIrValue.Global _) allow-invariant-loads]
    [_ (compiler-reg-remat-value? value)]))

(define (compiler-reg-remat-gep?
  [base : ir.CompilerIrValue]
  [offset : ir.CompilerIrValue]) : bool
  (match base
    [(ir.CompilerIrValue.GlobalAddr _)
      (match offset
        [(ir.CompilerIrValue.I64 _) true]
        [_ false])]
    [_ false]))

(define (compiler-reg-remat-load?
  [src : ir.CompilerIrValue]
  [allow-invariant-loads : bool]) : bool
  (if allow-invariant-loads
    (match src
      [(ir.CompilerIrValue.GlobalAddr _) true]
      [_ false])
    false))

(define (compiler-reg-remat-discount-weight [weight : i64]) : i64
  (/ weight 2))

;; A value the backend can RECOMPUTE in one instruction at each use: a static
;; address materialisation (`leaq label(%rip)`). Plain integer/bool/char constants
;; are deliberately EXCLUDED: the optimiser's constant propagation already inlines
;; them directly into their uses (so an optimised function never carries a constant
;; in a spillable vreg), making constant remat moot on real code; addresses cannot
;; always be folded into an instruction's immediate, so they are the case that
;; genuinely benefits. CompilerIrValue.Global (a LOAD of a mutable global) and CompilerIrValue.F64
;; (no scalar backend support) must never be rematerialised.
(define (compiler-reg-remat-recompute-value? [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.GlobalAddr _) true]
    [(ir.CompilerIrValue.Function _) true]
    [(ir.CompilerIrValue.String _) true]
    [(ir.CompilerIrValue.Bytes _) true]
    [_ false]))

(define (compiler-reg-remat-init-vals!
  [vals : (__tl_dyn-array ir.CompilerIrValue)]
  [vars : i64]) : unit
  (let
    [i : i64 0]
    (while (< i vars)
      (begin
        (set! (array-ref vals i) (ir.CompilerIrValue.Unit))
        (set! i (+ i 1))))))

;; Record var -> rematerialisable value for every var whose SOLE definition is a
;; Mov of a recomputable value.
(define (compiler-reg-collect-remat-seq!
  [instrs : ir.CompilerIrInstrSeq]
  [def-counts : (__tl_dyn-array i64)]
  [flags : (__tl_dyn-array i64)]
  [vals : (__tl_dyn-array ir.CompilerIrValue)]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (while (< index count)
      (begin
        (match (array-ref slots index)
          [(ir.CompilerIrInstr.Mov dst value _)
            ;; flags[dst]: 0 = not remat, 1 = remat, 2 = poisoned (address-taken,
            ;; must keep a real slot). A poisoned var never becomes remat.
            (if (if (if (compiler-reg-remat-recompute-value? value)
              (compiler-reg-sv-single-def? def-counts dst)
              false)
              (if (>= dst 0)
                (if (< dst (array-length flags))
                  (not (= (array-ref flags dst) 2))
                  false)
                false)
              false)
              (begin
                (set! (array-ref flags dst) 1)
                (set! (array-ref vals dst) value)
                unit)
              unit)]
          ;; Taking a var's address needs its real storage; poison it so it is
          ;; never rematerialised (its slot must hold the value).
          [(ir.CompilerIrInstr.AddrOf _ src)
            (if (if (>= src 0)
              (< src (array-length flags))
              false)
              (begin
                (set! (array-ref flags src) 2)
                unit)
              unit)]
          [_ unit])
        (set! index (+ index 1))))))

(define (compiler-reg-collect-remat-blocks!
  [blocks : ir.CompilerIrBlockList]
  [def-counts : (__tl_dyn-array i64)]
  [flags : (__tl_dyn-array i64)]
  [vals : (__tl_dyn-array ir.CompilerIrValue)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-collect-remat-seq! instrs def-counts flags vals)])
        (compiler-reg-collect-remat-blocks!
          (__tl-box-place rest)
          def-counts
          flags
          vals))]
    [(ir.CompilerIrBlockList.Array seq)
      (compiler-reg-collect-remat-seq-from! seq 0 def-counts flags vals)]))

(define (compiler-reg-collect-remat-seq-from!
  [blocks : ir.CompilerIrBlockSeq]
  [index : i64]
  [def-counts : (__tl_dyn-array i64)]
  [flags : (__tl_dyn-array i64)]
  [vals : (__tl_dyn-array ir.CompilerIrValue)]) : unit
  (if (>= index (ir.compiler-ir-block-seq-count blocks))
    unit
    (begin
      (match (ir.compiler-ir-block-seq-ref blocks index)
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-collect-remat-seq! instrs def-counts flags vals)])
      (compiler-reg-collect-remat-seq-from!
        blocks
        (+ index 1)
        def-counts
        flags
        vals))))

;; Post-allocation rewrite: a singleton (non-coalesced) rematerialisable var that
;; the allocator chose to SPILL is converted to CompilerRegLocation.Remat instead -- its
;; uses recompute the value and its def store is dropped (backend). Coalesced
;; members are excluded so a class never half-remats. The already-reserved spill
;; slot is simply left unused.
(define (compiler-reg-rewrite-remat-assignments
  [assignments : CompilerRegAssignmentTable]
  [func : ir.CompilerIrFunction]
  [coalesce : CompilerRegCoalesceMap]
  [shadows : live.CompilerLiveI64Set]
  [vars : i64]) : CompilerRegAssignmentTable
  (let
    [def-counts : (__tl_dyn-array i64) (compiler-reg-function-def-counts func)]
    [parents : (__tl_dyn-array i64) coalesce.parents]
    [merged-roots : live.CompilerLiveI64Set
      (compiler-reg-coalesce-merged-root-set coalesce)]
    [flags : (__tl_dyn-array i64) (array.make-array i64 vars)]
    [vals : (__tl_dyn-array ir.CompilerIrValue)
      (array.make-array ir.CompilerIrValue vars)]
    [v : i64 0]
    (begin
      (compiler-reg-remat-init-vals! vals vars)
      (match func
        [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
          (match blocks
            [(ir.CompilerIrBlockList.Array seq)
              (compiler-reg-collect-remat-seq-from! seq 0 def-counts flags vals)]
            [_
              (compiler-reg-collect-remat-blocks! blocks def-counts flags vals)])])
      (while (< v vars)
        (begin
          ;; Skip vars the call-spanning saver shadows: those keep a real slot to
          ;; restore from around calls, so they must not lose it to remat.
          (if (if (< v (array-length flags))
            (if (= (array-ref flags v) 1)
              (if (live.compiler-live-set-contains? shadows v)
                false
                (not
                  (compiler-reg-coalesce-var-nonsingleton?
                    parents
                    merged-roots
                    v)))
              false)
            false)
            (match (compiler-reg-assignment-table-lookup assignments v)
              [(CompilerRegMaybeLocation.Some loc)
                (match loc
                  [(CompilerRegLocation.Spill _)
                    (begin
                      (compiler-reg-assignment-table-insert
                        assignments
                        v
                        (CompilerRegLocation.Remat (array-ref vals v)))
                      unit)]
                  [_ unit])]
              [(CompilerRegMaybeLocation.No) unit])
            unit)
          (set! v (+ v 1))))
      assignments)))

(define (compiler-reg-coalesce-var-nonsingleton?
  [parents : (__tl_dyn-array i64)]
  [merged-roots : live.CompilerLiveI64Set]
  [var : i64]) : bool
  (if (or (< var 0) (>= var (array-length parents)))
    false
    (let
      [root : i64 (array-ref parents var)]
      [mapped : i64
        (if (and (>= root 0) (< root (array-length parents)))
          root
          var)]
      (live.compiler-live-set-contains? merged-roots mapped))))

(define (compiler-reg-remat-discount-single-def-spill-weights!
  [weights : (__tl_dyn-array i64)]
  [def-status : (__tl_dyn-array i64)]
  [coalesce : CompilerRegCoalesceMap]) : unit
  (let
    [parents : (__tl_dyn-array i64) coalesce.parents]
    [merged-roots : live.CompilerLiveI64Set
      (compiler-reg-coalesce-merged-root-set coalesce)]
    [var : i64 0]
    (while (< var (array-length weights))
      (begin
        (let
          [status : i64
            (if (< var (array-length def-status))
              (array-ref def-status var)
              0)]
          (if (and
            (= (bit-and status 1) 1)
            (= (/ status 2) 1)
            (not
              (compiler-reg-coalesce-var-nonsingleton? parents merged-roots var)))
            (set!
              (array-ref weights var)
              (compiler-reg-remat-discount-weight (array-ref weights var)))
            unit))
        (set! var (+ var 1))))))

(define (compiler-reg-remat-instr-mutates-memory? [instr : ir.CompilerIrInstr]) : bool
  (match (ir.compiler-ir-instr-effect instr)
    [(ir.CompilerIrEffect.MemoryWrite) true]
    [(ir.CompilerIrEffect.Unknown) true]
    [_ false]))

(define (compiler-reg-remat-instrs-mutates-memory?
  [instrs : ir.CompilerIrInstrSeq]) : bool
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (< index count) (not found))
        (begin
          (set!
            found
            (compiler-reg-remat-instr-mutates-memory? (array-ref slots index)))
          (set! index (+ index 1))))
      found)))

(define (compiler-reg-remat-blocks-mutates-memory?
  [blocks : ir.CompilerIrBlockList]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (or
            (compiler-reg-remat-instrs-mutates-memory? instrs)
            (compiler-reg-remat-blocks-mutates-memory? (__tl-box-place rest)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [found : bool false]
        (begin
          (while (and (< i count) (not found))
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set!
                    found
                    (compiler-reg-remat-instrs-mutates-memory? instrs))])
              (set! i (+ i 1))))
          found))]))

(define (compiler-reg-remat-invariant-loads-ok? [func : ir.CompilerIrFunction]) : bool
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (not (compiler-reg-remat-blocks-mutates-memory? blocks))]))

(define (compiler-reg-remat-status-candidate-add-instr!
  [def-status : (__tl_dyn-array i64)]
  [instr : ir.CompilerIrInstr]
  [allow-invariant-loads : bool]) : unit
  (match instr
    [(ir.CompilerIrInstr.Mov dst value _)
      (if (and
        (compiler-reg-remat-mov-value? value allow-invariant-loads)
        (>= dst 0)
        (< dst (array-length def-status)))
        (set! (array-ref def-status dst) (bit-or (array-ref def-status dst) 1))
        unit)]
    [(ir.CompilerIrInstr.Gep dst base offset _)
      (if (and
        (compiler-reg-remat-gep? base offset)
        (>= dst 0)
        (< dst (array-length def-status)))
        (set! (array-ref def-status dst) (bit-or (array-ref def-status dst) 1))
        unit)]
    [(ir.CompilerIrInstr.Load dst src _)
      (if (and
        (compiler-reg-remat-load? src allow-invariant-loads)
        (>= dst 0)
        (< dst (array-length def-status)))
        (set! (array-ref def-status dst) (bit-or (array-ref def-status dst) 1))
        unit)]
    [_ unit]))

(define (compiler-reg-ref-counts-add-instr-weighted-remat!
  [counts : (__tl_dyn-array i64)]
  [def-status : (__tl_dyn-array i64)]
  [instr : ir.CompilerIrInstr]
  [weight : i64]
  [allow-invariant-loads : bool]) : unit
  (let
    [ids : (__tl_dyn-array i64) (live.compiler-live-instr-ids)]
    [id-count : i64 (live.compiler-live-instr-use-ids! instr)]
    [def-var : i64 (live.compiler-live-instr-def-var instr)]
    (begin
      (if (< id-count 0)
        (let
          [uses : live.CompilerLiveI64Set (live.compiler-live-instr-uses instr)]
          [defs : live.CompilerLiveI64Set (live.compiler-live-instr-defs instr)]
          (begin
            (compiler-reg-ref-counts-add-set-weighted! counts uses weight)
            (compiler-reg-ref-counts-add-set-weighted! counts defs weight)
            (compiler-reg-ref-counts-add-set-weighted! def-status defs 2)))
        (begin
          (compiler-reg-ref-counts-add-ids-weighted! counts ids id-count weight)
          (compiler-reg-ref-counts-add-var-weighted! counts def-var weight)
          (compiler-reg-ref-counts-add-var-weighted! def-status def-var 2)))
      (compiler-reg-remat-status-candidate-add-instr!
        def-status
        instr
        allow-invariant-loads))))

(define (compiler-reg-ref-counts-seq-weighted-remat!
  [counts : (__tl_dyn-array i64)]
  [def-status : (__tl_dyn-array i64)]
  [instrs : ir.CompilerIrInstrSeq]
  [weight : i64]
  [allow-invariant-loads : bool]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-reg-ref-counts-add-instr-weighted-remat!
            counts
            def-status
            (array-ref slots index)
            weight
            allow-invariant-loads)
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-ref-counts-blocks-weighted-remat!
  [counts : (__tl_dyn-array i64)]
  [def-status : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]
  [depths : (__tl_dyn-array i64)]
  [block-index : i64]
  [allow-invariant-loads : bool]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-ref-counts-seq-weighted-remat!
              counts
              def-status
              instrs
              (compiler-reg-loop-depth-weight (array-ref depths block-index))
              allow-invariant-loads)])
        (compiler-reg-ref-counts-blocks-weighted-remat!
          counts
          def-status
          (__tl-box-place rest)
          depths
          (+ block-index 1)
          allow-invariant-loads))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [index : i64 block-index]
        (while (< i count)
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-ref-counts-seq-weighted-remat!
                  counts
                  def-status
                  instrs
                  (compiler-reg-loop-depth-weight (array-ref depths index))
                  allow-invariant-loads)])
            (set! index (+ index 1))
            (set! i (+ i 1)))))]))

(define (compiler-reg-function-spill-weights [func : ir.CompilerIrFunction]) : (__tl_dyn-array
    i64)
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ vars blocks)
      (let
        [counts : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [depths : (__tl_dyn-array i64)
          (compiler-reg-function-loop-depths blocks)]
        (begin
          (compiler-reg-ref-counts-blocks-weighted! counts blocks depths 0)
          counts))]))

(define (compiler-reg-function-spill-weights-combined
  [func : ir.CompilerIrFunction]
  [coalesce : CompilerRegCoalesceMap]
  [vars : i64]) : (__tl_dyn-array i64)
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ fn-vars blocks)
      (let
        [raw : (__tl_dyn-array i64) (array.make-array i64 fn-vars)]
        [def-status : (__tl_dyn-array i64) (array.make-array i64 fn-vars)]
        [depths : (__tl_dyn-array i64)
          (compiler-reg-function-loop-depths blocks)]
        [allow-invariant-loads : bool
          (compiler-reg-remat-invariant-loads-ok? func)]
        (begin
          (compiler-reg-ref-counts-blocks-weighted-remat!
            raw
            def-status
            blocks
            depths
            0
            allow-invariant-loads)
          (let
            [discounted : (__tl_dyn-array i64) (array.make-array i64 fn-vars)]
            (begin
              (compiler-reg-copy-i64-array! discounted raw 0)
              (compiler-reg-remat-discount-single-def-spill-weights!
                discounted
                def-status
                coalesce)
              (compiler-reg-greedy-combine-spill-weights
                (compiler-reg-merge-ref-counts coalesce discounted vars)
                (compiler-reg-merge-ref-counts coalesce raw vars))))))]))

(define (compiler-reg-interval-index-var-has-segments?
  [index : CompilerRegIntervalIndex]
  [var : i64]) : bool
  (let
    [segments : (__tl_dyn-array CompilerRegIntervalSeq) index.segments]
    (and
      (>= var 0)
      (< var (array-length segments))
      (not (compiler-reg-interval-seq-empty? (array-ref segments var))))))

(define (compiler-reg-edge-copy-list-count [copies : CompilerRegEdgeCopySeq]) : i64
  copies.len)

(define (compiler-reg-region-label-map-from
  [labels : CompilerRegLabelSeq]
  [out : reg_label_i64_map.Map (:consume)]) : reg_label_i64_map.Map
  (let
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-label-seq-count labels))
        (begin
          (reg_label_i64_map.insert-ref!
            (&mut out)
            (compiler-reg-label-seq-ref labels index)
            1)
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-region-label-map [labels : CompilerRegLabelSeq]) : reg_label_i64_map.Map
  (compiler-reg-region-label-map-from
    labels
    (reg_label_i64_map.with-capacity
      (compiler-reg-bits-map-capacity (compiler-reg-label-seq-count labels)))))

(define (compiler-reg-label-seq-contains?
  [labels : CompilerRegLabelSeq]
  [want : i64]) : bool
  (let
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (< index (compiler-reg-label-seq-count labels)) (not found))
        (begin
          (if (= (compiler-reg-label-seq-ref labels index) want)
            (set! found true)
            unit)
          (set! index (+ index 1))))
      found)))

(define (compiler-reg-region-label?
  [region : reg_label_i64_map.Map]
  [label : i64]) : bool
  (match (reg_label_i64_map.get (& region) label)
    [(reg_label_i64_map.LookupFound _) true]
    [(reg_label_i64_map.LookupMissing) false]))

(define (compiler-reg-edge-copy-live-block-label
  [block : live.CompilerLiveBlock]) : i64
  block.label)

(define (compiler-reg-edge-copy-increment-pred!
  [liveness : live.CompilerFunctionLiveness]
  [pred-counts : (__tl_dyn-array i64)]
  [label : i64]) : unit
  (let
    [index : i64 (live.compiler-live-function-block-index liveness label)]
    (if (>= index 0)
      (set! (array-ref pred-counts index) (+ (array-ref pred-counts index) 1))
      unit)))

(define (compiler-reg-edge-copy-count-preds-succs!
  [liveness : live.CompilerFunctionLiveness]
  [pred-counts : (__tl_dyn-array i64)]
  [succs : live.CompilerLiveLabelSet]) : unit
  (match succs
    [(live.CompilerLiveLabelSet.Nil) unit]
    [(live.CompilerLiveLabelSet.Dense _ _)
      (begin
        (compiler-reg-edge-copy-increment-pred!
          liveness
          pred-counts
          (live.compiler-live-label-set-ref succs 0))
        (compiler-reg-edge-copy-count-preds-succs!
          liveness
          pred-counts
          (live.compiler-live-label-set-tail succs)))]))

(define (compiler-reg-edge-copy-count-preds-blocks!
  [liveness : live.CompilerFunctionLiveness]
  [blocks : (__tl_dyn-array live.CompilerLiveBlock)]
  [pred-counts : (__tl_dyn-array i64)]
  [index : i64]) : unit
  (if (>= index (array-length blocks))
    unit
    (begin
      (compiler-reg-edge-copy-count-preds-succs!
        liveness
        pred-counts
        (compiler-reg-live-block-succs (array-ref blocks index)))
      (compiler-reg-edge-copy-count-preds-blocks!
        liveness
        blocks
        pred-counts
        (+ index 1)))))

(define (compiler-reg-edge-copy-pred-counts
  [liveness : live.CompilerFunctionLiveness]
  [blocks : (__tl_dyn-array live.CompilerLiveBlock)]) : (__tl_dyn-array i64)
  (let
    [pred-counts : (__tl_dyn-array i64)
      (array.make-array i64 (array-length blocks))]
    (begin
      (compiler-reg-edge-copy-count-preds-blocks! liveness blocks pred-counts 0)
      pred-counts)))

(define (compiler-reg-edge-copy-refusal [from-label : i64] [to-label : i64]) : String
  (str_cat.str-cat
    "regalloc: edge copy from "
    (ir.compiler-ir-label-text from-label)
    " to "
    (ir.compiler-ir-label-text to-label)
    " needs critical-edge splitting"))

(define (compiler-reg-edge-copy-placement-for
  [from-label : i64]
  [to-label : i64]
  [from-succs : i64]
  [to-preds : i64]) : CompilerRegEdgeCopyPlacementResult
  (cond
    [(= from-succs 1)
      (CompilerRegEdgeCopyPlacementResult.Ok
        CompilerRegEdgeCopyPlacement.PredEnd)]
    [(= to-preds 1)
      (CompilerRegEdgeCopyPlacementResult.Ok
        CompilerRegEdgeCopyPlacement.SuccEntry)]
    [else
      (CompilerRegEdgeCopyPlacementResult.Refused
        (compiler-reg-edge-copy-refusal from-label to-label))]))

(define (compiler-reg-edge-copy-live-on-edge?
  [from-block : live.CompilerLiveBlock]
  [to-block : live.CompilerLiveBlock]
  [var : i64]) : bool
  (and
    (live.compiler-live-set-contains?
      (live.compiler-live-block-live-out from-block)
      var)
    (live.compiler-live-set-contains?
      (live.compiler-live-block-live-in to-block)
      var)))

;; Group-aware variant for the SplitKit phi-carried homing: the coalesce group
;; (which shares one spill slot) is live across the edge iff SOME member is live
;; out of `from` AND SOME member is live in to `to`. Different members are live on
;; different boundary edges (the preheader edge carries the phi's INIT input, the
;; exit edge carries the back-edge/result member), but they share the slot the
;; INTO/OUT copies load/store, so any-member liveness is the correct test.
(define (compiler-reg-edge-copy-group-live-on-edge?
  [from-block : live.CompilerLiveBlock]
  [to-block : live.CompilerLiveBlock]
  [members : live.CompilerLiveI64Set]) : bool
  (and
    (live.compiler-live-set-intersects?
      (live.compiler-live-block-live-out from-block)
      members)
    (live.compiler-live-set-intersects?
      (live.compiler-live-block-live-in to-block)
      members)))

(define (compiler-reg-edge-copy-boundary-one
  [liveness : live.CompilerFunctionLiveness]
  [blocks : (__tl_dyn-array live.CompilerLiveBlock)]
  [pred-counts : (__tl_dyn-array i64)]
  [region : reg_label_i64_map.Map]
  [from-block : live.CompilerLiveBlock]
  [from-label : i64]
  [from-inside : bool]
  [from-succs : i64]
  [stack-var : i64]
  [region-var : i64]
  [ty : ast.AstType]
  [members : live.CompilerLiveI64Set]
  [to-label : i64]
  [acc : CompilerRegEdgeCopySeq]) : CompilerRegEdgeCopyPlan
  (let
    [to-index : i64 (live.compiler-live-function-block-index liveness to-label)]
    (if (>= to-index 0)
      (let
        [to-block : live.CompilerLiveBlock (array-ref blocks to-index)]
        [to-inside : bool (compiler-reg-region-label? region to-label)]
        (if (or
          (= from-inside to-inside)
          (not
            ;; An empty `members` set selects the existing per-var liveness test
            ;; (read-only / non-phi homing -- byte-identical). A non-empty set is
            ;; the phi-carried coalesce group: the slot is live on the edge iff ANY
            ;; member is (no single member is live on every boundary edge).
            (if (= (live.compiler-live-set-word-count members) 0)
              (compiler-reg-edge-copy-live-on-edge?
                from-block
                to-block
                stack-var)
              (compiler-reg-edge-copy-group-live-on-edge?
                from-block
                to-block
                members))))
          (CompilerRegEdgeCopyPlan.Plan acc)
          (match (compiler-reg-edge-copy-placement-for
            from-label
            to-label
            from-succs
            (array-ref pred-counts to-index))
            [(CompilerRegEdgeCopyPlacementResult.Ok placement)
              (if to-inside
                (CompilerRegEdgeCopyPlan.Plan
                  (compiler-reg-edge-copy-seq-push
                    acc
                    (CompilerRegEdgeCopy.Copy
                      from-label
                      to-label
                      stack-var
                      region-var
                      ty
                      CompilerRegEdgeCopyDirection.IntoRegion
                      placement)))
                (CompilerRegEdgeCopyPlan.Plan
                  (compiler-reg-edge-copy-seq-push
                    acc
                    (CompilerRegEdgeCopy.Copy
                      from-label
                      to-label
                      region-var
                      stack-var
                      ty
                      CompilerRegEdgeCopyDirection.OutOfRegion
                      placement))))]
            [(CompilerRegEdgeCopyPlacementResult.Refused message)
              (CompilerRegEdgeCopyPlan.Refused message)])))
      (CompilerRegEdgeCopyPlan.Refused
        (str_cat.str-cat
          "regalloc: edge copy target block not found: "
          (ir.compiler-ir-label-text to-label)
          "")))))

(define (compiler-reg-edge-copy-boundary-succs
  [liveness : live.CompilerFunctionLiveness]
  [blocks : (__tl_dyn-array live.CompilerLiveBlock)]
  [pred-counts : (__tl_dyn-array i64)]
  [region : reg_label_i64_map.Map]
  [from-block : live.CompilerLiveBlock]
  [from-label : i64]
  [from-inside : bool]
  [from-succs : i64]
  [stack-var : i64]
  [region-var : i64]
  [ty : ast.AstType]
  [members : live.CompilerLiveI64Set]
  [succs : live.CompilerLiveLabelSet]
  [acc : CompilerRegEdgeCopySeq]) : CompilerRegEdgeCopyPlan
  (match succs
    [(live.CompilerLiveLabelSet.Nil) (CompilerRegEdgeCopyPlan.Plan acc)]
    [(live.CompilerLiveLabelSet.Dense _ _)
      (match (compiler-reg-edge-copy-boundary-one
        liveness
        blocks
        pred-counts
        region
        from-block
        from-label
        from-inside
        from-succs
        stack-var
        region-var
        ty
        members
        (live.compiler-live-label-set-ref succs 0)
        acc)
        [(CompilerRegEdgeCopyPlan.Plan next)
          (compiler-reg-edge-copy-boundary-succs
            liveness
            blocks
            pred-counts
            region
            from-block
            from-label
            from-inside
            from-succs
            stack-var
            region-var
            ty
            members
            (live.compiler-live-label-set-tail succs)
            next)]
        [(CompilerRegEdgeCopyPlan.Refused message)
          (CompilerRegEdgeCopyPlan.Refused message)])]))

(define (compiler-reg-edge-copy-boundary-blocks
  [liveness : live.CompilerFunctionLiveness]
  [blocks : (__tl_dyn-array live.CompilerLiveBlock)]
  [pred-counts : (__tl_dyn-array i64)]
  [region : reg_label_i64_map.Map]
  [stack-var : i64]
  [region-var : i64]
  [ty : ast.AstType]
  [members : live.CompilerLiveI64Set]
  [index : i64]
  [acc : CompilerRegEdgeCopySeq]) : CompilerRegEdgeCopyPlan
  (if (>= index (array-length blocks))
    (CompilerRegEdgeCopyPlan.Plan acc)
    (let
      [block : live.CompilerLiveBlock (array-ref blocks index)]
      [label : i64 (compiler-reg-edge-copy-live-block-label block)]
      [succs : live.CompilerLiveLabelSet (compiler-reg-live-block-succs block)]
      (match (compiler-reg-edge-copy-boundary-succs
        liveness
        blocks
        pred-counts
        region
        block
        label
        (compiler-reg-region-label? region label)
        (live.compiler-live-label-set-count succs)
        stack-var
        region-var
        ty
        members
        succs
        acc)
        [(CompilerRegEdgeCopyPlan.Plan next)
          (compiler-reg-edge-copy-boundary-blocks
            liveness
            blocks
            pred-counts
            region
            stack-var
            region-var
            ty
            members
            (+ index 1)
            next)]
        [(CompilerRegEdgeCopyPlan.Refused message)
          (CompilerRegEdgeCopyPlan.Refused message)]))))

(define (compiler-reg-edge-copy-plan-for-region-group-with-liveness
  [liveness : live.CompilerFunctionLiveness]
  [region-labels : CompilerRegLabelSeq]
  [stack-var : i64]
  [region-var : i64]
  [ty : ast.AstType]
  [members : live.CompilerLiveI64Set]) : CompilerRegEdgeCopyPlan
  (compiler-reg-edge-copy-plan-for-region-members-with-liveness
    liveness
    region-labels
    stack-var
    region-var
    ty
    members))

(define (compiler-reg-edge-copy-plan-for-region-with-liveness
  [liveness : live.CompilerFunctionLiveness]
  [region-labels : CompilerRegLabelSeq]
  [stack-var : i64]
  [region-var : i64]
  [ty : ast.AstType]) : CompilerRegEdgeCopyPlan
  (compiler-reg-edge-copy-plan-for-region-members-with-liveness
    liveness
    region-labels
    stack-var
    region-var
    ty
    (live.compiler-live-set-empty)))

(define (compiler-reg-edge-copy-plan-for-region-members
  [func : ir.CompilerIrFunction]
  [region-labels : CompilerRegLabelSeq]
  [stack-var : i64]
  [region-var : i64]
  [ty : ast.AstType]
  [members : live.CompilerLiveI64Set]) : CompilerRegEdgeCopyPlan
  (compiler-reg-edge-copy-plan-for-region-members-with-liveness
    (live.compiler-live-analyze-function func)
    region-labels
    stack-var
    region-var
    ty
    members))

(define (compiler-reg-edge-copy-plan-for-region-members-with-liveness
  [liveness : live.CompilerFunctionLiveness]
  [region-labels : CompilerRegLabelSeq]
  [stack-var : i64]
  [region-var : i64]
  [ty : ast.AstType]
  [members : live.CompilerLiveI64Set]) : CompilerRegEdgeCopyPlan
  (match liveness
    [(live.CompilerFunctionLiveness.Liveness _ blocks)
      (let
        [pred-counts : (__tl_dyn-array i64)
          (compiler-reg-edge-copy-pred-counts liveness blocks)]
        (compiler-reg-edge-copy-boundary-blocks
          liveness
          blocks
          pred-counts
          (compiler-reg-region-label-map region-labels)
          stack-var
          region-var
          ty
          members
          0
          (compiler-reg-edge-copy-seq-empty)))]))

(define (compiler-reg-edge-copy-instr [copy : CompilerRegEdgeCopy]) : ir.CompilerIrInstr
  (match copy
    [(CompilerRegEdgeCopy.Copy _ _ src dst ty _ _)
      (ir.CompilerIrInstr.Mov dst (ir.CompilerIrValue.Var src) ty)]))

(define (compiler-reg-edge-copy-target-label [copy : CompilerRegEdgeCopy]) : i64
  (match copy
    [(CompilerRegEdgeCopy.Copy from-label to-label _ _ _ _ placement)
      (match placement
        [(CompilerRegEdgeCopyPlacement.PredEnd) from-label]
        [(CompilerRegEdgeCopyPlacement.SuccEntry) to-label])]))

(define (compiler-reg-edge-copy-placement [copy : CompilerRegEdgeCopy]) : CompilerRegEdgeCopyPlacement
  (match copy
    [(CompilerRegEdgeCopy.Copy _ _ _ _ _ _ placement) placement]))

;; Insertion slot for an edge copy: PredEnd lands before the terminator (an
;; empty block has none, so the copy becomes the whole block), SuccEntry lands
;; after the leading phis. Computed directly on the dense sequence (refs
;; #5726).
(define (compiler-reg-edge-copy-insert-index
  [instrs : ir.CompilerIrInstrSeq]
  [placement : CompilerRegEdgeCopyPlacement]) : i64
  (match placement
    [(CompilerRegEdgeCopyPlacement.PredEnd)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (if (< count 1)
          0
          (- count 1)))]
    [(CompilerRegEdgeCopyPlacement.SuccEntry)
      (let
        [index : i64 0]
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        [done : bool false]
        (begin
          (while (and (< index count) (not done))
            (match (ir.compiler-ir-instr-seq-ref instrs index)
              [(ir.CompilerIrInstr.Phi _ _ _) (set! index (+ index 1))]
              [_ (set! done true)]))
          index))]))

;; The output is exactly one instruction longer than the input, so it is
;; written straight into a right-sized dense sequence instead of through a
;; cons spine (refs #5726).
(define (compiler-reg-edge-copy-insert-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [insert-at : i64]
  [copy-instr : ir.CompilerIrInstr]) : ir.CompilerIrInstrSeq
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [out : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr (+ count 1))]
    [index : i64 0]
    (begin
      (while (< index insert-at)
        (begin
          (set! (array-ref out index) (array-ref slots index))
          (set! index (+ index 1))))
      (set! (array-ref out insert-at) copy-instr)
      (while (< index count)
        (begin
          (set! (array-ref out (+ index 1)) (array-ref slots index))
          (set! index (+ index 1))))
      (ir.CompilerIrInstrSeq out (+ count 1)))))

(define (compiler-reg-edge-copy-insert-in-block
  [block : ir.CompilerIrBlock]
  [copy : CompilerRegEdgeCopy]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (ir.CompilerIrBlock.Block
        label
        (compiler-reg-edge-copy-insert-instr-seq
          instrs
          (compiler-reg-edge-copy-insert-index
            instrs
            (compiler-reg-edge-copy-placement copy))
          (compiler-reg-edge-copy-instr copy)))]))

(define (compiler-reg-edge-copy-insert-one
  [blocks : ir.CompilerIrBlockList]
  [copy : CompilerRegEdgeCopy]) : CompilerRegEdgeCopyRewrite
  (match blocks
    [(ir.CompilerIrBlockList.Nil)
      (CompilerRegEdgeCopyRewrite.Refused
        (str_cat.str-cat
          "regalloc: edge copy insertion block not found: "
          (ir.compiler-ir-label-text (compiler-reg-edge-copy-target-label copy))
          ""))]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label _)
          (if (= label (compiler-reg-edge-copy-target-label copy))
            (CompilerRegEdgeCopyRewrite.Rewrite
              (ir.compiler-ir-block-cons
                (compiler-reg-edge-copy-insert-in-block block copy)
                (__tl-box-place rest)))
            (match (compiler-reg-edge-copy-insert-one
              (__tl-box-place rest)
              copy)
              [(CompilerRegEdgeCopyRewrite.Rewrite tail)
                (CompilerRegEdgeCopyRewrite.Rewrite
                  (ir.compiler-ir-block-cons block tail))]
              [(CompilerRegEdgeCopyRewrite.Refused message)
                (CompilerRegEdgeCopyRewrite.Refused message)]))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [slots : (__tl_dyn-array ir.CompilerIrBlock)
          (array.make-array ir.CompilerIrBlock count)]
        [i : i64 0]
        [found : bool false]
        [target : i64 (compiler-reg-edge-copy-target-label copy)]
        (begin
          (while (< i count)
            (let
              [block : ir.CompilerIrBlock (ir.compiler-ir-block-seq-ref seq i)]
              (begin
                (set!
                  (array-ref slots i)
                  (match block
                    [(ir.CompilerIrBlock.Block label _)
                      (if (and (not found) (= label target))
                        (begin
                          (set! found true)
                          (compiler-reg-edge-copy-insert-in-block block copy))
                        block)]))
                (set! i (+ i 1)))))
          (if found
            (CompilerRegEdgeCopyRewrite.Rewrite
              (ir.CompilerIrBlockList.Array (ir.CompilerIrBlockSeq slots count)))
            (CompilerRegEdgeCopyRewrite.Refused
              (str_cat.str-cat
                "regalloc: edge copy insertion block not found: "
                (ir.compiler-ir-label-text target)
                "")))))]))

(define (compiler-reg-edge-copy-apply
  [blocks : ir.CompilerIrBlockList]
  [copies : CompilerRegEdgeCopySeq]) : CompilerRegEdgeCopyRewrite
  (let
    [slots : (__tl_dyn-array CompilerRegEdgeCopy) copies.slots]
    [count : i64 copies.len]
    [index : i64 0]
    [current : ir.CompilerIrBlockList blocks]
    [refusal : String ""]
    [refused : bool false]
    (begin
      (while (and (< index count) (not refused))
        (begin
          (match (compiler-reg-edge-copy-insert-one
            current
            (array-ref slots index))
            [(CompilerRegEdgeCopyRewrite.Rewrite rewritten)
              (set! current rewritten)]
            [(CompilerRegEdgeCopyRewrite.Refused message)
              (begin
                (set! refusal message)
                (set! refused true))])
          (set! index (+ index 1))))
      (if refused
        (CompilerRegEdgeCopyRewrite.Refused refusal)
        (CompilerRegEdgeCopyRewrite.Rewrite current)))))

(define (compiler-reg-loop-split-noop
  [blocks : ir.CompilerIrBlockList]
  [vars : i64]) : CompilerRegCallSaveRewrite
  (CompilerRegCallSaveRewrite.Rewrite
    blocks
    vars
    vars
    (compiler-reg-assignment-table-empty)
    (compiler-reg-var-types-empty)))

(define (compiler-reg-loop-split-direction-present?
  [copies : CompilerRegEdgeCopySeq]
  [want-into : bool]) : bool
  (let
    [slots : (__tl_dyn-array CompilerRegEdgeCopy) copies.slots]
    [count : i64 copies.len]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (< index count) (not found))
        (begin
          (match (array-ref slots index)
            [(CompilerRegEdgeCopy.Copy _ _ _ _ _ direction _)
              (if (match direction
                [(CompilerRegEdgeCopyDirection.IntoRegion) want-into]
                [(CompilerRegEdgeCopyDirection.OutOfRegion) (not want-into)])
                (set! found true)
                unit)])
          (set! index (+ index 1))))
      found)))

(define (compiler-reg-loop-split-copies-bidirectional?
  [copies : CompilerRegEdgeCopySeq]) : bool
  (and
    (compiler-reg-loop-split-direction-present? copies true)
    (compiler-reg-loop-split-direction-present? copies false)))

;; SplitKit step 1 (redefined write-back). Does any phi instruction in this block
;; DEFINE `var`? Phi-defined loop-carried values are EXCLUDED from the redefined
;; write-back path: rewriting a phi destination to the region register (and routing
;; its back-edge input through that register) is the phi-correct step-2 work. A var
;; that is redefined only by ordinary (non-phi) instructions has no such hazard --
;; the region remap rewrites its def to the register and the internal self-back-edge
;; carries it in-register.
;; Scanned in place over the contiguous sequence: materialising a cons list
;; first cost one 112 B heap node per instruction to answer a question that
;; reads one tag and one destination var. refs #5726
(define (compiler-reg-loop-split-phi-defines-var?
  [instrs : ir.CompilerIrInstrSeq]
  [var : i64]) : bool
  (let
    [index : i64 0]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    (begin
      (while (< index count)
        (begin
          (match (ir.compiler-ir-instr-seq-ref instrs index)
            [(ir.CompilerIrInstr.Phi dst _ _) (when (= dst var) (return true))]
            [_ unit])
          (set! index (+ index 1))))
      false)))

;; SplitKit step 1. Is `block` a single-block self-loop -- i.e. does it list its own
;; label among its successors (the loop body branches back to itself)? For such a
;; block the back-edge is INTERNAL to the (single-block) region, so a value homed in
;; a register stays in that register across iterations with NO boundary copy on the
;; back-edge. This is the only loop shape where a REDEFINED value can be soundly
;; homed with the existing single-block region machinery: a value carried across an
;; EXTERNAL back-edge (body -> header) would be reloaded/written-back every iteration
;; (no benefit) and, more importantly, would normally be phi-carried (step 2).
(define (compiler-reg-loop-split-self-loop?
  [block : live.CompilerLiveBlock]
  [region-label : i64]) : bool
  (live.compiler-live-label-set-contains?
    (compiler-reg-live-block-succs block)
    region-label))

;; SplitKit step 1. Is `var` its own coalesce root (parents[var] == var)? The
;; redefined write-back path homes the WHOLE coalesced group, so it only accepts a
;; root (a non-root member is reached via its root) -- that homes each group exactly
;; once and keeps the slot/edge-copy bookkeeping anchored on the canonical var. A var
;; with no coalesce entry (out of range) is a trivial singleton root.
(define (compiler-reg-loop-split-coalesce-root?
  [parents : (__tl_dyn-array i64)]
  [var : i64]) : bool
  (if (or (< var 0) (>= var (array-length parents)))
    true
    (= (array-ref parents var) var)))

;; SplitKit step 1. Point every coalesced member of `root` (every v with
;; parents[v] == root, including root itself) at `new-var` in the region remap. The
;; coalescer merged these vars because they are move-related and share one storage
;; slot; redirecting them all to the homed register inside the region (with the
;; INTO/OUT copies syncing that shared slot at the boundary) is the write-back that a
;; root-only remap would have left half-done. For a singleton root this sets exactly
;; remap[root] = new-var (byte-identical to the prior root-only remap).
(define (compiler-reg-loop-split-remap-coalesced-group!
  [remap : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]
  [root : i64]
  [new-var : i64]) : unit
  (let
    [n : i64 (array-length remap)]
    [v : i64 0]
    (while (< v n)
      (begin
        (if (and (< v (array-length parents)) (= (array-ref parents v) root))
          (set! (array-ref remap v) new-var)
          unit)
        (set! v (+ v 1))))))

;; SplitKit step 2 (phi-carried homing). The bitset of every coalesce-group
;; member of `root` (every v in [0,vars) with parents[v] == root, root included).
;; The coalescer keeps `parents` flat (every member points directly at its root --
;; see merge-root-parents-into!), so membership is a single array read. Used for
;; group-aware liveness on region-boundary edges and for the group mention count.
(define (compiler-reg-loop-split-group-member-set
  [parents : (__tl_dyn-array i64)]
  [root : i64]
  [vars : i64]) : live.CompilerLiveI64Set
  (let
    [n : i64
      (if (< vars (array-length parents))
        vars
        (array-length parents))]
    [set : live.CompilerLiveI64Set (live.compiler-live-set-empty)]
    [v : i64 0]
    (begin
      (while (< v n)
        (begin
          (if (= (array-ref parents v) root)
            (set! set (live.compiler-live-set-insert set v))
            unit)
          (set! v (+ v 1))))
      set)))

;; Every input of a group-carrying phi must be a VARIABLE whose root is also
;; `root`. This is the phi-correctness gate: after the region remap rewrites every
;; group member to the homed register R, such a phi becomes `R = phi [R, ...],
;; [R, ...]` -- an identity whose per-edge lowering is a self-move (R = R), so it
;; cannot RACE the INTO copy (R = slot) on the preheader edge. A constant input or
;; an input in a DIFFERENT coalesce group would lower to a real edge move that
;; conflicts with the INTO copy (order-dependent => silent miscompile), so it is
;; rejected.
(define (compiler-reg-loop-split-phi-inputs-all-in-group?
  [inputs : ir.CompilerIrPhiInputList]
  [parents : (__tl_dyn-array i64)]
  [root : i64]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) true]
    [(ir.CompilerIrPhiInputList.Array seq)
      (compiler-reg-loop-split-phi-inputs-all-in-group?
        (ir.compiler-ir-phi-input-seq-to-list seq)
        parents
        root)]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (and
        (match value
          [(ir.CompilerIrValue.Var src)
            (and
              (>= src 0)
              (< src (array-length parents))
              (= (array-ref parents src) root))]
          [_ false])
        (compiler-reg-loop-split-phi-inputs-all-in-group?
          (__tl-box-place rest)
          parents
          root))]))

;; The block is a phi-carrier for `root` iff (a) some phi DEFINES a group member
;; -- that phi is the loop-carrying one, its result flows around the back-edge --
;; AND (b) every such phi has all-in-group inputs (the phi-correctness gate
;; below; vacuously true when no such phi exists, which is why (a) is required
;; separately). (a) ensures we only take this path for genuinely phi-carried
;; values; step 1 handles the non-phi self-loop redefinition.
;;
;; This is the top seq->list site of the whole opt2 self-compile (227.9M Ir over
;; 357 755 calls): it used to materialise the block as a cons list ONCE and then
;; walk that list TWICE, once per predicate. Both predicates are pure read-only
;; scans, so they run directly over the sequence and the list is gone. refs #5726
(define (compiler-reg-loop-split-phi-group-defined-seq?
  [instrs : ir.CompilerIrInstrSeq]
  [parents : (__tl_dyn-array i64)]
  [root : i64]) : bool
  (let
    [index : i64 0]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    (begin
      (while (< index count)
        (begin
          (match (ir.compiler-ir-instr-seq-ref instrs index)
            [(ir.CompilerIrInstr.Phi dst _ _)
              (when
                (and
                  (>= dst 0)
                  (< dst (array-length parents))
                  (= (array-ref parents dst) root))
                (return true))]
            [_ unit])
          (set! index (+ index 1))))
      false)))

(define (compiler-reg-loop-split-phi-carry-clean-seq?
  [instrs : ir.CompilerIrInstrSeq]
  [parents : (__tl_dyn-array i64)]
  [root : i64]) : bool
  (let
    [index : i64 0]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    (begin
      (while (< index count)
        (begin
          (match (ir.compiler-ir-instr-seq-ref instrs index)
            [(ir.CompilerIrInstr.Phi dst inputs _)
              (if (and
                (>= dst 0)
                (< dst (array-length parents))
                (= (array-ref parents dst) root))
                (unless
                  (compiler-reg-loop-split-phi-inputs-all-in-group?
                    inputs
                    parents
                    root)
                  (return false))
                unit)]
            [_ unit])
          (set! index (+ index 1))))
      true)))

(define (compiler-reg-loop-split-phi-carried-group?
  [instrs : ir.CompilerIrInstrSeq]
  [parents : (__tl_dyn-array i64)]
  [root : i64]) : bool
  (and
    (compiler-reg-loop-split-phi-group-defined-seq? instrs parents root)
    (compiler-reg-loop-split-phi-carry-clean-seq? instrs parents root)))

;; The step-2 acceptance predicate: a single-block SELF-LOOP that carries `var`'s
;; coalesce group through a phi-correct header phi, with `var` the canonical
;; coalesce root. The back-edge of a self-loop is internal to the (single-block)
;; region, so the carried value stays in the homed register across iterations with
;; NO per-iteration copy; the only boundary work is the INTO copy at the loop entry
;; and (when the value is read after the loop) the OUT copy at the exit, both
;; placed/refused by the edge-copy planner.
(define (compiler-reg-loop-split-phi-carried-candidate?
  [block : live.CompilerLiveBlock]
  [region-label : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [var : i64]
  [parents : (__tl_dyn-array i64)]) : bool
  (and
    (compiler-reg-loop-split-self-loop? block region-label)
    (compiler-reg-loop-split-coalesce-root? parents var)
    (compiler-reg-loop-split-phi-carried-group? instrs parents var)))

(define (compiler-reg-loop-split-instr-mentions-var?
  [instr : ir.CompilerIrInstr]
  [var : i64]) : bool
  (or
    (live.compiler-live-set-contains? (live.compiler-live-instr-uses instr) var)
    (live.compiler-live-set-contains? (live.compiler-live-instr-defs instr) var)))

;; Group-aware mention count: how many instructions touch ANY member of the homed
;; coalesce group (used by the hot-benefit gate for the phi-carried path, where the
;; per-iteration uses are spread across the phi result / back-edge / preheader
;; members rather than a single var).
(define (compiler-reg-loop-split-instr-mentions-group?
  [instr : ir.CompilerIrInstr]
  [members : live.CompilerLiveI64Set]) : bool
  (or
    (live.compiler-live-set-intersects?
      (live.compiler-live-instr-uses instr)
      members)
    (live.compiler-live-set-intersects?
      (live.compiler-live-instr-defs instr)
      members)))

;; Read-only counter: scan the sequence in place. refs #5726
(define (compiler-reg-loop-split-mention-count-group
  [instrs : ir.CompilerIrInstrSeq]
  [members : live.CompilerLiveI64Set]) : i64
  (let
    [index : i64 0]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [total : i64 0]
    (begin
      (while (< index count)
        (begin
          (if (compiler-reg-loop-split-instr-mentions-group?
            (ir.compiler-ir-instr-seq-ref instrs index)
            members)
            (set! total (+ total 1))
            unit)
          (set! index (+ index 1))))
      total)))

;; Read-only counter: scan the sequence in place. refs #5726
(define (compiler-reg-loop-split-mention-count
  [instrs : ir.CompilerIrInstrSeq]
  [var : i64]) : i64
  (let
    [index : i64 0]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [total : i64 0]
    (begin
      (while (< index count)
        (begin
          (if (compiler-reg-loop-split-instr-mentions-var?
            (ir.compiler-ir-instr-seq-ref instrs index)
            var)
            (set! total (+ total 1))
            unit)
          (set! index (+ index 1))))
      total)))

(define (compiler-reg-loop-split-region-interval
  [region-var : i64]
  [start : i64]
  [end : i64]) : CompilerRegIntervalSeq
  (compiler-reg-interval-seq-prepend
    (CompilerRegInterval region-var start end)
    (compiler-reg-interval-seq-empty)))

(define (compiler-reg-loop-split-var-overlaps-region?
  [intervals : CompilerRegIntervalIndex]
  [var : i64]
  [region-intervals : CompilerRegIntervalSeq]) : bool
  (let
    [segments : (__tl_dyn-array CompilerRegIntervalSeq) intervals.segments]
    [var-segments : CompilerRegIntervalSeq
      (if (or (< var 0) (>= var (array-length segments)))
        (compiler-reg-interval-seq-empty)
        (array-ref segments var))]
    (if (not (compiler-reg-interval-seq-empty? var-segments))
      (compiler-reg-interval-seq-overlaps? var-segments region-intervals)
      (match (compiler-reg-interval-index-lookup intervals var)
        [(CompilerRegMaybeInterval.Some interval)
          (compiler-reg-interval-seq-overlaps-one? region-intervals interval)]
        [(CompilerRegMaybeInterval.No) true]))))

(define (compiler-reg-loop-split-location-conflicts-region?
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [region-intervals : CompilerRegIntervalSeq]
  [ignore-var : i64]
  [location : CompilerRegLocation]) : bool
  (let
    [present : (__tl_dyn-array i64) assignments.present]
    [items : (__tl_dyn-array CompilerRegLocation) assignments.items]
    [assigned-var : i64 0]
    [conflict : bool false]
    (begin
      (while (and (< assigned-var (array-length present)) (not conflict))
        (begin
          (if (and
            (not (= (array-ref present assigned-var) 0))
            (not (= assigned-var ignore-var))
            (compiler-reg-location-overlaps?
              (array-ref items assigned-var)
              location)
            (compiler-reg-loop-split-var-overlaps-region?
              intervals
              assigned-var
              region-intervals))
            (set! conflict true)
            unit)
          (set! assigned-var (+ assigned-var 1))))
      conflict)))

(define (compiler-reg-loop-split-first-register
  [regs : CompilerRegIdSeq]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [region-intervals : CompilerRegIntervalSeq]
  [ignore-var : i64]) : CompilerRegMaybeId
  (let
    [index : i64 0]
    [result : CompilerRegMaybeId CompilerRegMaybeId.No]
    [done : bool false]
    (begin
      (while (and (< index (compiler-reg-id-seq-count regs)) (not done))
        (let
          [reg : i64 (compiler-reg-id-seq-ref regs index)]
          (if (compiler-reg-loop-split-location-conflicts-region?
            assignments
            intervals
            region-intervals
            ignore-var
            (CompilerRegLocation.Register reg))
            (set! index (+ index 1))
            (begin
              (set! result (CompilerRegMaybeId.Some reg))
              (set! done true)))))
      result)))

;; Return the single assigned var (other than ignore-var) that holds `location`
;; and overlaps the region, or -1 if zero -- or more than one -- such var exists.
;; `acc` threads the search: -2 = none seen yet, -1 = multiple (not evictable),
;; >=0 = the one var found so far.
(define (compiler-reg-loop-split-region-occupant
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [region-intervals : CompilerRegIntervalSeq]
  [ignore-var : i64]
  [location : CompilerRegLocation]
  [acc : i64]) : i64
  (let
    [present : (__tl_dyn-array i64) assignments.present]
    [items : (__tl_dyn-array CompilerRegLocation) assignments.items]
    [assigned-var : i64 0]
    [out : i64 acc]
    (begin
      (while (and (< assigned-var (array-length present)) (not (= out (- 0 1))))
        (begin
          (if (and
            (not (= (array-ref present assigned-var) 0))
            (not (= assigned-var ignore-var))
            (compiler-reg-location-overlaps?
              (array-ref items assigned-var)
              location)
            (compiler-reg-loop-split-var-overlaps-region?
              intervals
              assigned-var
              region-intervals))
            (set!
              out
              (if (= out (- 0 2))
                assigned-var
                (- 0 1)))
            unit)
          (set! assigned-var (+ assigned-var 1))))
      out)))

;; Eviction-aware register pick: used when no candidate register is FREE over the
;; region. Find a candidate register whose region occupant is a SINGLE var of
;; STRICTLY LOWER spill weight than the loop-invariant being homed. Re-spilling
;; that lower-weight var frees the register for the hotter invariant -- a strict
;; total-spill-cost decrease (so it cannot oscillate; fuel bounds it anyway).
;; Returns the register and the var to evict, or None.
(define (compiler-reg-loop-split-first-register-evict
  [regs : CompilerRegIdSeq]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [region-intervals : CompilerRegIntervalSeq]
  [ignore-var : i64]
  [weights : (__tl_dyn-array i64)]
  [inv-weight : i64]) : CompilerRegLoopSplitEvict
  (let
    [index : i64 0]
    [result : CompilerRegLoopSplitEvict (CompilerRegLoopSplitEvictNone)]
    [done : bool false]
    (begin
      (while (and (< index (compiler-reg-id-seq-count regs)) (not done))
        (let
          [reg : i64 (compiler-reg-id-seq-ref regs index)]
          [occ : i64
            (compiler-reg-loop-split-region-occupant
              assignments
              intervals
              region-intervals
              ignore-var
              (CompilerRegLocation.Register reg)
              (- 0 2))]
          (if (and
            (>= occ 0)
            (< occ (array-length weights))
            (< (array-ref weights occ) inv-weight))
            (begin
              (set! result (CompilerRegLoopSplitEvict reg occ))
              (set! done true))
            (set! index (+ index 1)))))
      result)))

(define (compiler-reg-loop-split-type-ok?
  [type-info : CompilerRegVarTypes]
  [group-vars : live.CompilerLiveI64Set]
  [var : i64]) : CompilerRegMaybeType
  (if (live.compiler-live-set-contains? group-vars var)
    CompilerRegMaybeType.No
    (match (compiler-reg-var-types-lookup type-info var)
      [(CompilerRegMaybeType.Some ty)
        (if (and
          (compiler-reg-register-eligible-type? ty)
          (not (compiler-reg-float-type? ty)))
          (CompilerRegMaybeType.Some ty)
          CompilerRegMaybeType.No)]
      [(CompilerRegMaybeType.No) CompilerRegMaybeType.No])))

(define (compiler-reg-loop-split-hot-benefit?
  [mentions : i64]
  [depth : i64]
  [copy-count : i64]) : bool
  (and
    (> depth 0)
    (> mentions 0)
    (> (* mentions (compiler-reg-loop-depth-weight depth)) copy-count)))

(define (compiler-reg-loop-split-succs-has-backedge?
  [liveness : live.CompilerFunctionLiveness]
  [source-index : i64]
  [succs : live.CompilerLiveLabelSet]) : bool
  (match succs
    [(live.CompilerLiveLabelSet.Nil) false]
    [(live.CompilerLiveLabelSet.Dense _ _)
      (let
        [target-index : i64
          (live.compiler-live-function-block-index
            liveness
            (live.compiler-live-label-set-ref succs 0))]
        (if (>= target-index 0)
          (if (<= target-index source-index)
            true
            (compiler-reg-loop-split-succs-has-backedge?
              liveness
              source-index
              (live.compiler-live-label-set-tail succs)))
          (compiler-reg-loop-split-succs-has-backedge?
            liveness
            source-index
            (live.compiler-live-label-set-tail succs))))]))

(define (compiler-reg-loop-split-region-remap-blocks
  [blocks : ir.CompilerIrBlockList]
  [region : reg_label_i64_map.Map]
  [remap : (__tl_dyn-array i64)]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) ir.CompilerIrBlockList.Nil]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (let
            [rewritten-block : ir.CompilerIrBlock
              (if (compiler-reg-region-label? region label)
                (ir.CompilerIrBlock.Block
                  label
                  (compiler-reg-remap-instr-seq remap instrs))
                block)]
            (ir.compiler-ir-block-cons
              rewritten-block
              (compiler-reg-loop-split-region-remap-blocks
                (__tl-box-place rest)
                region
                remap)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [slots : (__tl_dyn-array ir.CompilerIrBlock)
          (array.make-array ir.CompilerIrBlock count)]
        [i : i64 0]
        (begin
          (while (< i count)
            (let
              [block : ir.CompilerIrBlock (ir.compiler-ir-block-seq-ref seq i)]
              (begin
                (set!
                  (array-ref slots i)
                  (match block
                    [(ir.CompilerIrBlock.Block label instrs)
                      (if (compiler-reg-region-label? region label)
                        (ir.CompilerIrBlock.Block
                          label
                          (compiler-reg-remap-instr-seq remap instrs))
                        block)]))
                (set! i (+ i 1)))))
          (ir.CompilerIrBlockList.Array (ir.CompilerIrBlockSeq slots count))))]))

;; A loop region (one loop block) is clobber-free for caller-saved registers iff it
;; contains no call/syscall -- those clobber the whole caller-saved set. Per-reg
;; fixed-use hazards are handled separately: %rcx is offered only when the region
;; crosses no variable shift, and %rdx only when it crosses no div/mod/mul fixed
;; use. In a clobber-free region a caller-saved reg survives the loop and is
;; protected from scratch use by the scavenger freeness check (the rescued var's
;; home is occupied while live) -- exactly as for the callee-saved regs the rescue
;; already uses, so no prologue save is needed.
(define (compiler-reg-loop-split-seq-has-call-or-syscall?
  [instrs : ir.CompilerIrInstrSeq]) : bool
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (< index count) (not found))
        (begin
          (set!
            found
            (match (array-ref slots index)
              [(ir.CompilerIrInstr.Call _ _ _ _) true]
              [(ir.CompilerIrInstr.CallIndirect _ _ _ _) true]
              [(ir.CompilerIrInstr.CallIndirectC _ _ _ _) true]
              [(ir.CompilerIrInstr.CallCAbiStoreResult _) true]
              [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult _) true]
              [(ir.CompilerIrInstr.TailCall _ _ _) true]
              [(ir.CompilerIrInstr.TailCallIndirect _ _ _) true]
              [(ir.CompilerIrInstr.Syscall _ _) true]
              [_ false]))
          (set! index (+ index 1))))
      found)))

(define (compiler-reg-loop-split-region-crosses-kind-seq?
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]
  [point : i64]
  [kind : i64]
  [start : i64]
  [end : i64]) : bool
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    [p : i64 point]
    [found : bool false]
    (begin
      (while (and (< index count) (< p end) (not found))
        (begin
          (if (and
            (>= p start)
            (compiler-reg-clobber-instr-kind?
              type-segment-bases
              (array-ref slots index)
              kind))
            (set! found true)
            unit)
          (set! p (+ p 2))
          (set! index (+ index 1))))
      found)))

(define (compiler-reg-loop-split-region-crosses-kind-blocks?
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [point : i64]
  [kind : i64]
  [start : i64]
  [end : i64]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [next-point : i64
              (+ point (* 2 (ir.compiler-ir-instr-seq-count instrs)))]
            (cond
              [(>= point end) false]
              [(<= next-point start)
                (compiler-reg-loop-split-region-crosses-kind-blocks?
                  type-segment-bases
                  (__tl-box-place rest)
                  next-point
                  kind
                  start
                  end)]
              [(compiler-reg-loop-split-region-crosses-kind-seq?
                  type-segment-bases
                  instrs
                  point
                  kind
                  start
                  end)
                true]
              [else
                (compiler-reg-loop-split-region-crosses-kind-blocks?
                  type-segment-bases
                  (__tl-box-place rest)
                  next-point
                  kind
                  start
                  end)]))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [index : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [p : i64 point]
        [found : bool false]
        (begin
          (while (and (< index count) (< p end) (not found))
            (match (ir.compiler-ir-block-seq-ref seq index)
              [(ir.CompilerIrBlock.Block _ instrs)
                (let
                  [next-point : i64
                    (+ p (* 2 (ir.compiler-ir-instr-seq-count instrs)))]
                  (begin
                    (if (and
                      (> next-point start)
                      (compiler-reg-loop-split-region-crosses-kind-seq?
                        type-segment-bases
                        instrs
                        p
                        kind
                        start
                        end))
                      (set! found true)
                      unit)
                    (set! p next-point)
                    (set! index (+ index 1))))]))
          found))]))

(define (compiler-reg-loop-split-region-crosses-kind?
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [kind : i64]
  [start : i64]
  [end : i64]) : bool
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (compiler-reg-loop-split-region-crosses-kind-blocks?
        type-segment-bases
        blocks
        0
        kind
        start
        end)]))

(define (compiler-reg-loop-split-region-rcx-safe?
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [start : i64]
  [end : i64]) : bool
  (not
    (compiler-reg-loop-split-region-crosses-kind?
      type-segment-bases
      func
      2
      start
      end)))

(define (compiler-reg-loop-split-region-rdx-safe?
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [start : i64]
  [end : i64]) : bool
  (not
    (compiler-reg-loop-split-region-crosses-kind?
      type-segment-bases
      func
      4
      start
      end)))

(define (compiler-reg-loop-split-cons-if
  [enabled : bool]
  [reg : i64]
  [rest : CompilerRegIdSeq]) : CompilerRegIdSeq
  (if enabled
    (compiler-reg-id-seq-prepend reg rest)
    rest))

;; Candidate registers for the loop-split rescue. Always the 5 callee-saved (sound
;; everywhere). When the region is clobber-free, ALSO offer caller-saved
;; r8/r9/rsi/rdi and the fixed-use regs %rcx/%rdx when the region-specific
;; clobber scan proves they are not overwritten. Caller-saved candidates are tried
;; first, so a clobber-free hot loop can keep a value in a register without adding
;; a callee reg to the prologue save set.
(define (compiler-reg-loop-split-candidate-regs
  [clobber-free? : bool]
  [rcx-safe? : bool]
  [rdx-safe? : bool]) : CompilerRegIdSeq
  (if clobber-free?
    (compiler-reg-id-seq-prepend
      cabi.compiler-reg-id-r8
      (compiler-reg-id-seq-prepend
        cabi.compiler-reg-id-r9
        (compiler-reg-id-seq-prepend
          cabi.compiler-reg-id-rsi
          (compiler-reg-id-seq-prepend
            cabi.compiler-reg-id-rdi
            (compiler-reg-loop-split-cons-if
              rcx-safe?
              cabi.compiler-reg-id-rcx
              (compiler-reg-loop-split-cons-if
                rdx-safe?
                cabi.compiler-reg-id-rdx
                (compiler-reg-sysv-integer-registers)))))))
    (compiler-reg-sysv-integer-registers)))

;; ---------------------------------------------------------------------------
;; On-demand per-header critical-edge split (dedicated preheader insertion).
;;
;; A loop block that is its own region (phi-header with a self/critical entry
;; edge -- the array_sum shape) cannot receive the once-per-loop INTO copy:
;; edge-copy-plan-for-region refuses because the entry edge is critical
;; (predecessor has >1 successor AND the loop block has >1 predecessor). LLVM's
;; LoopSimplify inserts a dedicated preheader. We do the same, but ONLY for the
;; one header the loop-split is about to home (so non-qualifying loops are
;; untouched -- a global insert+prune perturbs every loop's per-round liveness,
;; which is why slice-2 measured +3299). These per-header helpers (ported from
;; the slice-2 preheader machinery) splice a single `<h>.preheader: jmp <h>`
;; block before header h, redirect h's single out-of-loop critical-edge
;; predecessor to it, and relabel h's phi inputs from that predecessor to the
;; preheader (a pass-through, value-preserving).
;; ---------------------------------------------------------------------------
(define (compiler-reg-preheader-block-label [block : ir.CompilerIrBlock]) : i64
  (match block
    [(ir.CompilerIrBlock.Block label _) label]))

(define (compiler-reg-preheader-succ-count [block : ir.CompilerIrBlock]) : i64
  (live.compiler-live-label-set-count
    (live.compiler-live-block-successors block)))

(define (compiler-reg-preheader-succ-contains?
  [block : ir.CompilerIrBlock]
  [label : i64]) : bool
  (live.compiler-live-label-set-contains?
    (live.compiler-live-block-successors block)
    label))

;; True iff the block's terminator is a conditional branch -- the only
;; critical-edge terminator we know how to redirect (a Jump has a single
;; successor, so it is never a critical edge).
(define (compiler-reg-preheader-terminator-branch? [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (let
        [c : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (if (<= c 0)
          false
          (match (ir.compiler-ir-instr-seq-ref instrs (- c 1))
            [(ir.CompilerIrInstr.Branch _ _ _) true]
            [(ir.CompilerIrInstr.TotalEnumBranch _ _ _) true]
            [_ false])))]))

;; loop-ends[h] = highest block index with a back-edge to block h (-1 if none).
;; h is a loop header iff loop-ends[h] >= h; [h..loop-ends[h]] is its natural
;; loop. Same back-edge scan the loop-depth pass uses.
(define (compiler-reg-preheader-loop-ends
  [blocks : ir.CompilerIrBlockList]
  [count : i64]) : (__tl_dyn-array i64)
  (let
    [loop-ends : (__tl_dyn-array i64) (array.make-array i64 count)]
    [ids : reg_label_i64_map.Map
      (compiler-reg-loop-depth-block-ids
        blocks
        (reg_label_i64_map.with-capacity (compiler-reg-bits-map-capacity count))
        0)]
    (begin
      (compiler-reg-fill-i64-array loop-ends (- 0 1))
      (compiler-reg-loop-depth-record-blocks! blocks ids loop-ends 0)
      loop-ends)))

(define (compiler-reg-preheader-loop-ends-seq
  [seq : ir.CompilerIrBlockSeq]
  [count : i64]) : (__tl_dyn-array i64)
  (let
    [loop-ends : (__tl_dyn-array i64) (array.make-array i64 count)]
    [ids : reg_label_i64_map.Map
      (compiler-reg-loop-depth-block-ids-seq
        seq
        (reg_label_i64_map.with-capacity (compiler-reg-bits-map-capacity count))
        0)]
    (begin
      (compiler-reg-fill-i64-array loop-ends (- 0 1))
      (compiler-reg-loop-depth-record-blocks-seq! seq ids loop-ends 0)
      loop-ends)))

;; Scan all blocks for predecessors of header `h` (succ contains h-label) that
;; lie OUTSIDE the natural-loop range [h..le]. Returns the single such index,
;; -1 if none, or -2 if more than one (multi-entry -- not this slice).
(define (compiler-reg-preheader-scan-outside-preds
  [orig : (__tl_dyn-array ir.CompilerIrBlock)]
  [h : i64]
  [le : i64]
  [h-label : i64]
  [n : i64]
  [p : i64]
  [found : i64]) : i64
  (if (>= p n)
    found
    (if (= found (- 0 2))
      (- 0 2)
      (compiler-reg-preheader-scan-outside-preds
        orig
        h
        le
        h-label
        n
        (+ p 1)
        (if (and
          (or (< p h) (> p le))
          (compiler-reg-preheader-succ-contains? (array-ref orig p) h-label))
          (if (= found (- 0 1))
            p
            (- 0 2))
          found)))))

;; If the header at block index `h` qualifies for a dedicated preheader, return
;; the block index of its single out-of-loop predecessor; otherwise -1.
(define (compiler-reg-preheader-pred-for-header
  [orig : (__tl_dyn-array ir.CompilerIrBlock)]
  [loop-ends : (__tl_dyn-array i64)]
  [ids : reg_label_i64_map.Map]
  [h : i64]
  [h-label : i64]) : i64
  (if (or
    (<= h 0)
    (>= h (array-length loop-ends))
    (< (array-ref loop-ends h) h)
    (reg_label_i64_map.contains?
      (& ids)
      (ir.compiler-ir-label
        (str_cat.str-cat (ir.compiler-ir-label-text h-label) ".preheader"))))
    (- 0 1)
    (let
      [le : i64 (array-ref loop-ends h)]
      [n : i64 (array-length orig)]
      [pred : i64
        (compiler-reg-preheader-scan-outside-preds
          orig
          h
          le
          h-label
          n
          0
          (- 0 1))]
      (if (< pred 0)
        (- 0 1)
        (if (and
          (> (compiler-reg-preheader-succ-count (array-ref orig pred)) 1)
          (compiler-reg-preheader-terminator-branch? (array-ref orig pred)))
          pred
          (- 0 1))))))

;; Redirect a successor label: if `s` is a header that gets a preheader and the
;; block doing the redirect (`pred-index`) is that header's single out-of-loop
;; predecessor, retarget to the header's preheader label; else unchanged.
(define (compiler-reg-preheader-subst-label
  [ids : reg_label_i64_map.Map]
  [header-pred : (__tl_dyn-array i64)]
  [pred-index : i64]
  [s : i64]) : i64
  (match (reg_label_i64_map.get (& ids) s)
    [(reg_label_i64_map.LookupFound h-idx)
      (if (and
        (< h-idx (array-length header-pred))
        (= (array-ref header-pred h-idx) pred-index))
        (ir.compiler-ir-label
          (str_cat.str-cat (ir.compiler-ir-label-text s) ".preheader"))
        s)]
    [(reg_label_i64_map.LookupMissing) s]))

;; A 1:1 copy with the last instruction replaced: the output is exactly as
;; long as the input, so it is written straight into a right-sized dense
;; sequence instead of through a cons spine (refs #5726).
(define (compiler-reg-preheader-replace-last-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [new-last : ir.CompilerIrInstr]) : ir.CompilerIrInstrSeq
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [out : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index (- count 1))
        (begin
          (set! (array-ref out index) (array-ref slots index))
          (set! index (+ index 1))))
      (set! (array-ref out (- count 1)) new-last)
      (ir.CompilerIrInstrSeq out count))))

;; Redirect the conditional-branch terminator of `block` (at `index`) for any
;; target that is a preheader-getting header whose single out-of-loop
;; predecessor is this block.
(define (compiler-reg-preheader-redirect-block
  [ids : reg_label_i64_map.Map]
  [header-pred : (__tl_dyn-array i64)]
  [block : ir.CompilerIrBlock]
  [index : i64]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [c : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (if (<= c 0)
          block
          (match (ir.compiler-ir-instr-seq-ref instrs (- c 1))
            [(ir.CompilerIrInstr.Branch cond t f)
              (let
                [nt : i64
                  (compiler-reg-preheader-subst-label ids header-pred index t)]
                [nf : i64
                  (compiler-reg-preheader-subst-label ids header-pred index f)]
                (if (and (= nt t) (= nf f))
                  block
                  (ir.CompilerIrBlock.Block
                    label
                    (compiler-reg-preheader-replace-last-instr-seq
                      instrs
                      (ir.CompilerIrInstr.Branch cond nt nf)))))]
            [(ir.CompilerIrInstr.TotalEnumBranch cond t f)
              (let
                [nt : i64
                  (compiler-reg-preheader-subst-label ids header-pred index t)]
                [nf : i64
                  (compiler-reg-preheader-subst-label ids header-pred index f)]
                (if (and (= nt t) (= nf f))
                  block
                  (ir.CompilerIrBlock.Block
                    label
                    (compiler-reg-preheader-replace-last-instr-seq
                      instrs
                      (ir.CompilerIrInstr.TotalEnumBranch cond nt nf)))))]
            [_ block])))]))

;; Relabel a header's phi inputs that came from `pred-label` to `ph-label`
;; (the value is unchanged -- the preheader is a pass-through).
(define (compiler-reg-preheader-relabel-phi-inputs
  [inputs : ir.CompilerIrPhiInputList]
  [pred-label : i64]
  [ph-label : i64]) : ir.CompilerIrPhiInputList
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) ir.CompilerIrPhiInputList.Nil]
    [(ir.CompilerIrPhiInputList.Array seq)
      (compiler-reg-preheader-relabel-phi-inputs
        (ir.compiler-ir-phi-input-seq-to-list seq)
        pred-label
        ph-label)]
    [(ir.CompilerIrPhiInputList.Cons value label rest)
      (ir.compiler-ir-phi-input-cons
        value
        (if (= label pred-label)
          ph-label
          label)
        (compiler-reg-preheader-relabel-phi-inputs
          (__tl-box-place rest)
          pred-label
          ph-label))]))

(define (compiler-reg-preheader-relabel-instr
  [instr : ir.CompilerIrInstr]
  [pred-label : i64]
  [ph-label : i64]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Phi dst inputs ty)
      (ir.CompilerIrInstr.Phi
        dst
        (compiler-reg-preheader-relabel-phi-inputs inputs pred-label ph-label)
        ty)]
    [_ instr]))

;; A 1:1 phi-input relabel: the output is exactly as long as the input, so it
;; is written straight into a right-sized dense sequence instead of through a
;; cons spine (refs #5726).
(define (compiler-reg-preheader-relabel-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [pred-label : i64]
  [ph-label : i64]) : ir.CompilerIrInstrSeq
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [out : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            (array-ref out index)
            (compiler-reg-preheader-relabel-instr
              (array-ref slots index)
              pred-label
              ph-label))
          (set! index (+ index 1))))
      (ir.CompilerIrInstrSeq out count))))

(define (compiler-reg-preheader-relabel-header
  [block : ir.CompilerIrBlock]
  [pred-label : i64]
  [ph-label : i64]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (ir.CompilerIrBlock.Block
        label
        (compiler-reg-preheader-relabel-instr-seq instrs pred-label ph-label))]))

;; Walk the block list: redirect each block's terminator, and immediately
;; before each preheader-getting header splice an empty `jmp header` preheader
;; (with the header's phi inputs relabeled from the predecessor to it).
(define (compiler-reg-preheader-rewrite
  [orig : (__tl_dyn-array ir.CompilerIrBlock)]
  [ids : reg_label_i64_map.Map]
  [header-pred : (__tl_dyn-array i64)]
  [blocks : ir.CompilerIrBlockList]
  [index : i64]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) ir.CompilerIrBlockList.Nil]
    [(ir.CompilerIrBlockList.Cons block rest)
      (let
        [tail : ir.CompilerIrBlockList
          (compiler-reg-preheader-rewrite
            orig
            ids
            header-pred
            (__tl-box-place rest)
            (+ index 1))]
        [redirected : ir.CompilerIrBlock
          (compiler-reg-preheader-redirect-block ids header-pred block index)]
        [pred : i64
          (if (< index (array-length header-pred))
            (array-ref header-pred index)
            (- 0 1))]
        (if (>= pred 0)
          (let
            [h-label : i64 (compiler-reg-preheader-block-label block)]
            [ph-label : i64
              (ir.compiler-ir-label
                (str_cat.str-cat
                  (ir.compiler-ir-label-text h-label)
                  ".preheader"))]
            [pred-label : i64
              (compiler-reg-preheader-block-label (array-ref orig pred))]
            (ir.compiler-ir-block-cons
              (ir.CompilerIrBlock.Block
                ph-label
                (ir.compiler-ir-instr-seq1 (ir.CompilerIrInstr.Jump h-label)))
              (ir.compiler-ir-block-cons
                (compiler-reg-preheader-relabel-header
                  redirected
                  pred-label
                  ph-label)
                tail)))
          (ir.compiler-ir-block-cons redirected tail)))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 (- (ir.compiler-ir-block-seq-count seq) 1)]
        [out : ir.CompilerIrBlockList ir.CompilerIrBlockList.Nil]
        (begin
          (while (>= i 0)
            (let
              [actual-index : i64 (+ index i)]
              [block : ir.CompilerIrBlock (ir.compiler-ir-block-seq-ref seq i)]
              [redirected : ir.CompilerIrBlock
                (compiler-reg-preheader-redirect-block
                  ids
                  header-pred
                  block
                  actual-index)]
              [pred : i64
                (if (< actual-index (array-length header-pred))
                  (array-ref header-pred actual-index)
                  (- 0 1))]
              (begin
                (set!
                  out
                  (if (>= pred 0)
                    (let
                      [h-label : i64 (compiler-reg-preheader-block-label block)]
                      [ph-label : i64
                        (ir.compiler-ir-label
                          (str_cat.str-cat
                            (ir.compiler-ir-label-text h-label)
                            ".preheader"))]
                      [pred-label : i64
                        (compiler-reg-preheader-block-label
                          (array-ref orig pred))]
                      (ir.compiler-ir-block-cons
                        (ir.CompilerIrBlock.Block
                          ph-label
                          (ir.compiler-ir-instr-seq1
                            (ir.CompilerIrInstr.Jump h-label)))
                        (ir.compiler-ir-block-cons
                          (compiler-reg-preheader-relabel-header
                            redirected
                            pred-label
                            ph-label)
                          out)))
                    (ir.compiler-ir-block-cons redirected out)))
                (set! i (- i 1)))))
          out))]))

;; Splice a dedicated preheader for ONE header (given by label). Builds a
;; header-pred array with only that header set (if it qualifies via
;; pred-for-header), then runs the per-header rewrite. Non-target loops are
;; untouched. Returns the original blocks unchanged if the header does not
;; qualify (no critical-edge out-of-loop predecessor, or a preheader already
;; exists).
(define (compiler-reg-loop-split-splice-preheader
  [blocks : ir.CompilerIrBlockList]
  [header-label : i64]) : ir.CompilerIrBlockList
  (let
    [seq : ir.CompilerIrBlockSeq
      (live.compiler-live-ir-block-list-to-seq blocks)]
    [count : i64 (ir.compiler-ir-block-seq-count seq)]
    (if (<= count 1)
      blocks
      (let
        [orig : (__tl_dyn-array ir.CompilerIrBlock) seq.slots]
        [ids : reg_label_i64_map.Map
          (compiler-reg-loop-depth-block-ids-seq
            seq
            (reg_label_i64_map.with-capacity
              (compiler-reg-bits-map-capacity count))
            0)]
        [loop-ends : (__tl_dyn-array i64)
          (compiler-reg-preheader-loop-ends-seq seq count)]
        [header-pred : (__tl_dyn-array i64) (array.make-array i64 count)]
        (begin
          (compiler-reg-fill-i64-array header-pred (- 0 1))
          (match (reg_label_i64_map.get (& ids) header-label)
            [(reg_label_i64_map.LookupFound h)
              (let
                [pred : i64
                  (compiler-reg-preheader-pred-for-header
                    orig
                    loop-ends
                    ids
                    h
                    header-label)]
                (if (>= pred 0)
                  (begin
                    (set! (array-ref header-pred h) pred)
                    (compiler-reg-preheader-rewrite
                      orig
                      ids
                      header-pred
                      blocks
                      0))
                  blocks))]
            [(reg_label_i64_map.LookupMissing) blocks]))))))

(define (compiler-reg-loop-split-try-var
  [_abi : cabi.CompilerRegTargetAbi]
  [_func : ir.CompilerIrFunction]
  [liveness : live.CompilerFunctionLiveness]
  [region-label : i64]
  [block : live.CompilerLiveBlock]
  [instrs : ir.CompilerIrInstrSeq]
  [region-start : i64]
  [region-end : i64]
  [depth : i64]
  [candidate-regs : CompilerRegIdSeq]
  [vars : i64]
  [var : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : live.CompilerLiveI64Set]
  [parents : (__tl_dyn-array i64)]
  [merged-roots : live.CompilerLiveI64Set]
  [weights : (__tl_dyn-array i64)]) : CompilerRegLoopSplitCandidate
  (let
    ;; SplitKit step 2: is this a phi-carried single-block self-loop value (a real
    ;; SSA loop-carried accumulator/counter, phi-defined at the loop header) whose
    ;; whole coalesce group is phi-correct (every header-phi input is in the group)?
    ;; If so we home the GROUP (the shared spill slot) in a register across the
    ;; self-loop with a group-aware boundary plan; step 1 only covered NON-phi
    ;; self-loop redefinition.
    [phi-carried? : bool
      (compiler-reg-loop-split-phi-carried-candidate?
        block
        region-label
        instrs
        var
        parents)]
    [members : live.CompilerLiveI64Set
      (if phi-carried?
        (compiler-reg-loop-split-group-member-set parents var vars)
        (live.compiler-live-set-empty))]
    (if (if phi-carried?
      ;; Phi-carried gate. The structural preconditions (self-loop, `var` is the
      ;; coalesce root, the header phi(s) carrying the group have all-in-group
      ;; inputs) are checked by phi-carried-candidate? above. The remaining gate
      ;; is only "is it a spillable multi-segment value"; group liveness across
      ;; the region boundary is enforced by the group-aware plan below (an INTO
      ;; copy proves the group is live into the loop; OUT copies, emitted on every
      ;; live exit edge or else the plan is refused, prove the write-backs exist).
      (compiler-reg-interval-index-var-has-segments? intervals var)
      (and
        (live.compiler-live-set-contains?
          (live.compiler-live-block-live-in block)
          var)
        (live.compiler-live-set-contains?
          (live.compiler-live-block-live-out block)
          var)
        ;; SplitKit step 1: admit BOTH read-only loop invariants (var not written in the
        ;; region) AND redefined values, but for redefinition only in the bounded sound
        ;; case: a single-block self-loop where the redefinition is NOT phi-carried. The
        ;; read-only path needs only an INTO copy; the redefined path additionally needs
        ;; write-back (OUT copies), required below. `(not (defs-in-block))` used to
        ;; hard-reject every redefined value.
        (or
          (not
            (live.compiler-live-set-contains?
              (live.compiler-live-block-defs block)
              var))
          (and
            (compiler-reg-loop-split-self-loop? block region-label)
            (not (compiler-reg-loop-split-phi-defines-var? instrs var))))
        (compiler-reg-interval-index-var-has-segments? intervals var)
        ;; Coalescing gate. A carried `(set! acc EXPR)` lowers to `tmp = EXPR; acc = tmp`,
        ;; so the reg-alloc coalescer merges acc with tmp -- EVERY loop-carried redefined
        ;; value is a non-singleton coalesce root. The READ-ONLY path keeps the original
        ;; exclusion (region-remap rewrites only the homed var, so coalesced members would
        ;; be left dangling). The REDEFINED self-loop path instead HOMES THE WHOLE COALESCED
        ;; GROUP: apply-candidate remaps every move-related member to the region register
        ;; and the INTO/OUT copies sync the shared slot at the region boundary -- so a
        ;; coalesced ROOT is accepted (a non-root member is left for its root's turn, so the
        ;; group is homed exactly once).
        (if (live.compiler-live-set-contains?
          (live.compiler-live-block-defs block)
          var)
          (compiler-reg-loop-split-coalesce-root? parents var)
          (not
            (compiler-reg-coalesce-var-nonsingleton? parents merged-roots var)))))
      (match (compiler-reg-assignment-lookup assignments var)
        [(CompilerRegMaybeLocation.Some location)
          (match location
            [(CompilerRegLocation.Spill _)
              (match (compiler-reg-loop-split-type-ok? type-info group-vars var)
                [(CompilerRegMaybeType.Some ty)
                  (let
                    [labels : CompilerRegLabelSeq
                      (compiler-reg-label-seq-prepend
                        region-label
                        (compiler-reg-label-seq-empty))]
                    [mentions : i64
                      (if phi-carried?
                        (compiler-reg-loop-split-mention-count-group
                          instrs
                          members)
                        (compiler-reg-loop-split-mention-count instrs var))]
                    [region-intervals : CompilerRegIntervalSeq
                      (compiler-reg-loop-split-region-interval
                        vars
                        region-start
                        region-end)]
                    (match (if phi-carried?
                      (compiler-reg-edge-copy-plan-for-region-group-with-liveness
                        liveness
                        labels
                        var
                        vars
                        ty
                        members)
                      (compiler-reg-edge-copy-plan-for-region-with-liveness
                        liveness
                        labels
                        var
                        vars
                        ty))
                      [(CompilerRegEdgeCopyPlan.Plan copies)
                        (let
                          [copy-count : i64
                            (compiler-reg-edge-copy-list-count copies)]
                          (if (and
                            ;; Read-only loop invariants are sound with an INTO copy
                            ;; alone: the var is never written in the region, so its
                            ;; slot stays authoritative for any out-of-region read.
                            ;; REDEFINED values (var in defs block -- the SplitKit
                            ;; step-1 case) instead REQUIRE write-back: an OUT copy must
                            ;; store the region register back to the var's slot at every
                            ;; region exit so out-of-region reads observe the current
                            ;; value. The planner emits an OUT copy on every live exit
                            ;; edge or REFUSES (critical edge -> handled above), so a
                            ;; non-refused bidirectional plan write-backs every exit;
                            ;; requiring at least one OUT (copies-bidirectional?) rejects
                            ;; the degenerate no-exit redefinition that never writes back.
                            ;;
                            ;; The PHI-CARRIED path uses the weaker INTO-present test:
                            ;; the group-aware planner already emits an OUT copy on
                            ;; every live exit edge (or refuses on a critical one), so a
                            ;; non-refused plan with an INTO copy has all required
                            ;; write-backs; values NOT live after the loop (a homed
                            ;; counter) correctly need no OUT copy and are still homed.
                            (if phi-carried?
                              (compiler-reg-loop-split-direction-present?
                                copies
                                true)
                              (if (live.compiler-live-set-contains?
                                (live.compiler-live-block-defs block)
                                var)
                                (compiler-reg-loop-split-copies-bidirectional?
                                  copies)
                                (compiler-reg-loop-split-direction-present?
                                  copies
                                  true)))
                            (compiler-reg-loop-split-hot-benefit?
                              mentions
                              depth
                              copy-count))
                            (match (compiler-reg-loop-split-first-register
                              candidate-regs
                              assignments
                              intervals
                              region-intervals
                              var)
                              [(CompilerRegMaybeId.Some reg)
                                (CompilerRegLoopSplitCandidate.Candidate
                                  var
                                  labels
                                  ty
                                  reg
                                  copies
                                  (- 0 1))]
                              [(CompilerRegMaybeId.No)
                                (match (compiler-reg-loop-split-first-register-evict
                                  candidate-regs
                                  assignments
                                  intervals
                                  region-intervals
                                  var
                                  weights
                                  (if (< var (array-length weights))
                                    (array-ref weights var)
                                    0))
                                  [(CompilerRegLoopSplitEvict ereg evar)
                                    (CompilerRegLoopSplitCandidate.Candidate
                                      var
                                      labels
                                      ty
                                      ereg
                                      copies
                                      evar)]
                                  [(CompilerRegLoopSplitEvictNone)
                                    (CompilerRegLoopSplitCandidate.NoCandidate)])])
                            (CompilerRegLoopSplitCandidate.NoCandidate)))]
                      [(CompilerRegEdgeCopyPlan.Refused _)
                        (CompilerRegLoopSplitCandidate.NoCandidate)]))]
                [(CompilerRegMaybeType.No)
                  (CompilerRegLoopSplitCandidate.NoCandidate)])]
            [_ (CompilerRegLoopSplitCandidate.NoCandidate)])]
        [(CompilerRegMaybeLocation.No)
          (CompilerRegLoopSplitCandidate.NoCandidate)])
      (CompilerRegLoopSplitCandidate.NoCandidate))))

(define (compiler-reg-loop-split-select-var
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [liveness : live.CompilerFunctionLiveness]
  [region-label : i64]
  [block : live.CompilerLiveBlock]
  [instrs : ir.CompilerIrInstrSeq]
  [region-start : i64]
  [region-end : i64]
  [depth : i64]
  [candidate-regs : CompilerRegIdSeq]
  [vars : i64]
  [var : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : live.CompilerLiveI64Set]
  [parents : (__tl_dyn-array i64)]
  [merged-roots : live.CompilerLiveI64Set]
  [weights : (__tl_dyn-array i64)]) : CompilerRegLoopSplitCandidate
  (if (>= var vars)
    (CompilerRegLoopSplitCandidate.NoCandidate)
    (match (compiler-reg-loop-split-try-var
      target-abi
      func
      liveness
      region-label
      block
      instrs
      region-start
      region-end
      depth
      candidate-regs
      vars
      var
      type-info
      assignments
      intervals
      group-vars
      parents
      merged-roots
      weights)
      [(CompilerRegLoopSplitCandidate.NoCandidate)
        (compiler-reg-loop-split-select-var
          target-abi
          func
          liveness
          region-label
          block
          instrs
          region-start
          region-end
          depth
          candidate-regs
          vars
          (+ var 1)
          type-info
          assignments
          intervals
          group-vars
          parents
          merged-roots
          weights)]
      [(CompilerRegLoopSplitCandidate.Candidate
          stack-var
          label
          ty
          reg
          copies
          evicted)
        (CompilerRegLoopSplitCandidate.Candidate
          stack-var
          label
          ty
          reg
          copies
          evicted)])))

(define (compiler-reg-loop-split-select-blocks
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [blocks : ir.CompilerIrBlockList]
  [liveness : live.CompilerFunctionLiveness]
  [live-blocks : (__tl_dyn-array live.CompilerLiveBlock)]
  [depths : (__tl_dyn-array i64)]
  [point : i64]
  [block-index : i64]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : live.CompilerLiveI64Set]
  [parents : (__tl_dyn-array i64)]
  [merged-roots : live.CompilerLiveI64Set]
  [weights : (__tl_dyn-array i64)]) : CompilerRegLoopSplitCandidate
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (CompilerRegLoopSplitCandidate.NoCandidate)]
    [(ir.CompilerIrBlockList.Cons ir-block rest)
      (match ir-block
        [(ir.CompilerIrBlock.Block label instrs)
          (let
            [next-point : i64
              (+ point (* 2 (ir.compiler-ir-instr-seq-count instrs)))]
            [depth : i64
              (if (< block-index (array-length depths))
                (array-ref depths block-index)
                0)]
            [candidate-regs : CompilerRegIdSeq
              (compiler-reg-loop-split-candidate-regs
                (not (compiler-reg-loop-split-seq-has-call-or-syscall? instrs))
                (compiler-reg-loop-split-region-rcx-safe?
                  type-segment-bases
                  func
                  point
                  next-point)
                (compiler-reg-loop-split-region-rdx-safe?
                  type-segment-bases
                  func
                  point
                  next-point))]
            (if (and
              (< block-index (array-length live-blocks))
              (> depth 0)
              ;; phi-blocks allowed: the not-defined-in-block gate in try-var
              ;; restricts to read-only invariants (a phi-defined var IS defined
              ;; in the block, so it is rejected), and on-demand preheader
              ;; insertion carries/relabels the header's phi inputs.
              true
              (compiler-reg-loop-split-succs-has-backedge?
                liveness
                block-index
                (compiler-reg-live-block-succs
                  (array-ref live-blocks block-index))))
              (match (compiler-reg-loop-split-select-var
                target-abi
                func
                liveness
                label
                (array-ref live-blocks block-index)
                instrs
                point
                next-point
                depth
                candidate-regs
                vars
                0
                type-info
                assignments
                intervals
                group-vars
                parents
                merged-roots
                weights)
                [(CompilerRegLoopSplitCandidate.NoCandidate)
                  (compiler-reg-loop-split-select-blocks
                    type-segment-bases
                    target-abi
                    func
                    (__tl-box-place rest)
                    liveness
                    live-blocks
                    depths
                    next-point
                    (+ block-index 1)
                    vars
                    type-info
                    assignments
                    intervals
                    group-vars
                    parents
                    merged-roots
                    weights)]
                [(CompilerRegLoopSplitCandidate.Candidate
                    stack-var
                    region
                    ty
                    reg
                    copies
                    evicted)
                  (CompilerRegLoopSplitCandidate.Candidate
                    stack-var
                    region
                    ty
                    reg
                    copies
                    evicted)])
              (compiler-reg-loop-split-select-blocks
                type-segment-bases
                target-abi
                func
                (__tl-box-place rest)
                liveness
                live-blocks
                depths
                next-point
                (+ block-index 1)
                vars
                type-info
                assignments
                intervals
                group-vars
                parents
                merged-roots
                weights)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (compiler-reg-loop-split-select-blocks-seq
        type-segment-bases
        target-abi
        func
        seq
        liveness
        live-blocks
        depths
        point
        block-index
        vars
        type-info
        assignments
        intervals
        group-vars
        parents
        merged-roots
        weights)]))

(define (compiler-reg-loop-split-select-blocks-seq
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [seq : ir.CompilerIrBlockSeq]
  [liveness : live.CompilerFunctionLiveness]
  [live-blocks : (__tl_dyn-array live.CompilerLiveBlock)]
  [depths : (__tl_dyn-array i64)]
  [point : i64]
  [block-index : i64]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : live.CompilerLiveI64Set]
  [parents : (__tl_dyn-array i64)]
  [merged-roots : live.CompilerLiveI64Set]
  [weights : (__tl_dyn-array i64)]) : CompilerRegLoopSplitCandidate
  (let
    [i : i64 0]
    [count : i64 (ir.compiler-ir-block-seq-count seq)]
    [out : CompilerRegLoopSplitCandidate
      (CompilerRegLoopSplitCandidate.NoCandidate)]
    [found : bool false]
    [p : i64 point]
    [b : i64 block-index]
    (begin
      (while (and (< i count) (not found))
        (begin
          (match (ir.compiler-ir-block-seq-ref seq i)
            [(ir.CompilerIrBlock.Block label instrs)
              (let
                [next-point : i64
                  (+ p (* 2 (ir.compiler-ir-instr-seq-count instrs)))]
                [depth : i64
                  (if (< b (array-length depths))
                    (array-ref depths b)
                    0)]
                [candidate-regs : CompilerRegIdSeq
                  (compiler-reg-loop-split-candidate-regs
                    (not
                      (compiler-reg-loop-split-seq-has-call-or-syscall? instrs))
                    (compiler-reg-loop-split-region-rcx-safe?
                      type-segment-bases
                      func
                      p
                      next-point)
                    (compiler-reg-loop-split-region-rdx-safe?
                      type-segment-bases
                      func
                      p
                      next-point))]
                (begin
                  (if (and
                    (< b (array-length live-blocks))
                    (> depth 0)
                    (compiler-reg-loop-split-succs-has-backedge?
                      liveness
                      b
                      (compiler-reg-live-block-succs (array-ref live-blocks b))))
                    (match (compiler-reg-loop-split-select-var
                      target-abi
                      func
                      liveness
                      label
                      (array-ref live-blocks b)
                      instrs
                      p
                      next-point
                      depth
                      candidate-regs
                      vars
                      0
                      type-info
                      assignments
                      intervals
                      group-vars
                      parents
                      merged-roots
                      weights)
                      [(CompilerRegLoopSplitCandidate.NoCandidate) unit]
                      [(CompilerRegLoopSplitCandidate.Candidate
                          stack-var
                          region
                          ty
                          reg
                          copies
                          evicted)
                        (begin
                          (set!
                            out
                            (CompilerRegLoopSplitCandidate.Candidate
                              stack-var
                              region
                              ty
                              reg
                              copies
                              evicted))
                          (set! found true))])
                    unit)
                  (set! p next-point)))])
          (set! b (+ b 1))
          (set! i (+ i 1))))
      out)))

(define (compiler-reg-loop-split-apply-candidate
  [blocks : ir.CompilerIrBlockList]
  [vars : i64]
  [stack-var : i64]
  [region-labels : CompilerRegLabelSeq]
  [ty : ast.AstType]
  [reg : i64]
  [copies : CompilerRegEdgeCopySeq]
  [evicted-var : i64]
  [parents : (__tl_dyn-array i64)]) : CompilerRegCallSaveRewrite
  (let
    [remap : (__tl_dyn-array i64) (compiler-reg-caller-save-remap vars)]
    ;; The region is the candidate's block-label sequence (one label for the
    ;; single-block paths -- byte-identical to the prior single-label map -- or the
    ;; whole natural loop for the multi-block phi-carried homing).
    [region-map : reg_label_i64_map.Map
      (compiler-reg-region-label-map region-labels)]
    ;; The new region-resident var (id `vars`) takes the register. When this
    ;; candidate evicted a lower-weight var to free that register, also override
    ;; the evicted var to Spill -- assignment-table-merge -> assignment-insert
    ;; overwrites its prior Register home, and a whole-var spill is always sound.
    ;; (The offset is a placeholder; color-stack-slots re-colors all spills.)
    [extra-assignments : CompilerRegAssignmentTable
      (if (>= evicted-var 0)
        (compiler-reg-assignments-prepend
          (CompilerRegAssignment vars (CompilerRegLocation.Register reg))
          (compiler-reg-assignments-prepend
            (CompilerRegAssignment
              evicted-var
              (CompilerRegLocation.Spill
                (compiler-reg-stack-slot-offset evicted-var)))
            (compiler-reg-assignment-table-empty)))
        (compiler-reg-assignments-prepend
          (CompilerRegAssignment vars (CompilerRegLocation.Register reg))
          (compiler-reg-assignment-table-empty)))]
    (begin
      (set! (array-ref remap stack-var) vars)
      ;; Home the whole coalesced group (move-related members of `stack-var`), not
      ;; just the root, so a redefined carried value's every alias inside the region
      ;; resolves to the homed register. For a singleton root this re-sets exactly
      ;; remap[stack-var] = vars (identical to the root-only remap above).
      (compiler-reg-loop-split-remap-coalesced-group!
        remap
        parents
        stack-var
        vars)
      (match (compiler-reg-edge-copy-apply
        (compiler-reg-loop-split-region-remap-blocks blocks region-map remap)
        copies)
        [(CompilerRegEdgeCopyRewrite.Rewrite rewritten-blocks)
          (CompilerRegCallSaveRewrite.Rewrite
            rewritten-blocks
            vars
            (+ vars 1)
            extra-assignments
            (compiler-reg-var-types-insert
              (compiler-reg-var-types-empty)
              vars
              ty))]
        [(CompilerRegEdgeCopyRewrite.Refused _)
          (compiler-reg-loop-split-noop blocks vars)]))))

;; ===========================================================================
;; SplitKit step 2 -- MULTI-BLOCK phi-carried homing (the dominant 607 population).
;;
;; A real SSA loop-carried value is a phi at the loop HEADER taking the initial
;; value from the preheader edge and the updated value from the back-edge; the body
;; that updates it is a SEPARATE block. So it is a MULTI-BLOCK region (header +
;; body), which the single-block self-loop path (try-var) rejects. Here we home the
;; whole coalesce group across the natural loop: the back-edge is INTERNAL to the
;; region (the carry stays in the homed register with NO per-iteration copy), the
;; preheader edge gets the INTO copy, and live exit edges get the OUT copy (or the
;; plan is refused on a critical edge). The phi becomes `R = phi [R,..],[R,..]`
;; (an identity whose per-edge lowering is a self-move) once every group member --
;; result, back-edge input, preheader input -- is remapped to R; the
;; phi-correctness gate (every header-phi input is in the group) guarantees that,
;; so the INTO copy cannot race a real phi-lowering move.
;;
;; ADMITTED SHAPE: a natural loop [H..E] (E = loop-ends[H], the highest block with
;; a back-edge to H) whose BODY blocks (H..E] are each entered only from inside the
;; region, so the region's ONLY entry is H. That is the soundness witness the
;; INTO copy needs: the planner places a header-edge INTO copy at PredEnd (H has
;; >1 predecessor, so SuccEntry is unavailable and a multi-successor preheader is
;; refused as critical), which puts the `R = slot` load AHEAD of the lowered
;; header-phi moves. A body-block entry edge would instead place the load at
;; SuccEntry -- after the phis -- and a phi reading a remapped group member from
;; the outside predecessor would read an undefined R. E == H+1 with pred-count 1
;; on the body is the 2-block special case this started as, and stays bit-identical.
;; ===========================================================================
;; Start point (doubled instruction index, matching select-blocks) of each block;
;; length n+1 so points[n] is the end point of the last block.
(define (compiler-reg-loop-phi-mb-block-points
  [block-array : (__tl_dyn-array ir.CompilerIrBlock)]) : (__tl_dyn-array i64)
  (let
    [n : i64 (array-length block-array)]
    [points : (__tl_dyn-array i64) (array.make-array i64 (+ n 1))]
    [i : i64 0]
    [acc : i64 0]
    (begin
      (while (< i n)
        (begin
          (set! (array-ref points i) acc)
          (set!
            acc
            (+
              acc
              (match (array-ref block-array i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (* 2 (ir.compiler-ir-instr-seq-count instrs))])))
          (set! i (+ i 1))))
      (set! (array-ref points n) acc)
      points)))

(define (compiler-reg-loop-phi-mb-region-labels
  [block-array : (__tl_dyn-array ir.CompilerIrBlock)]
  [idx : i64]
  [end-idx : i64]) : CompilerRegLabelSeq
  (let
    [limit : i64
      (if (< end-idx (array-length block-array))
        end-idx
        (- (array-length block-array) 1))]
    [index : i64 idx]
    [out : CompilerRegLabelSeq
      (compiler-reg-label-seq-with-capacity
        (if (<= idx limit)
          (+ (- limit idx) 1)
          0))]
    (begin
      (while (<= index limit)
        (begin
          (match (array-ref block-array index)
            [(ir.CompilerIrBlock.Block label _)
              (set! out (compiler-reg-label-seq-push out label))])
          (set! index (+ index 1))))
      out)))

;; Any call/syscall in region blocks [s..e]? (caller-saved candidates are only safe
;; when none clobbers them across the loop.)
(define (compiler-reg-loop-phi-mb-region-has-call?
  [block-array : (__tl_dyn-array ir.CompilerIrBlock)]
  [s : i64]
  [e : i64]) : bool
  (if (or (> s e) (>= s (array-length block-array)))
    false
    (or
      (match (array-ref block-array s)
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-loop-split-seq-has-call-or-syscall? instrs)])
      (compiler-reg-loop-phi-mb-region-has-call? block-array (+ s 1) e))))

;; Does any instruction in `instrs` DEFINE `var`? (region read-only test)
(define (compiler-reg-loop-phi-mb-seq-defines?
  [instrs : ir.CompilerIrInstrSeq]
  [var : i64]) : bool
  (let
    [index : i64 0]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    (begin
      (while (< index count)
        (begin
          (when
            (live.compiler-live-set-contains?
              (live.compiler-live-instr-defs
                (ir.compiler-ir-instr-seq-ref instrs index))
              var)
            (return true))
          (set! index (+ index 1))))
      false)))

;; Is `var` written anywhere in region blocks [s..e]? A LOOP-INVARIANT home is
;; only sound when it is not: the var's slot stays authoritative for every
;; out-of-region read, so the boundary plan needs the INTO copy alone.
(define (compiler-reg-loop-phi-mb-region-defines?
  [block-array : (__tl_dyn-array ir.CompilerIrBlock)]
  [s : i64]
  [e : i64]
  [var : i64]) : bool
  (if (or (> s e) (>= s (array-length block-array)))
    false
    (or
      (match (array-ref block-array s)
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-loop-phi-mb-seq-defines? instrs var)])
      (compiler-reg-loop-phi-mb-region-defines? block-array (+ s 1) e var))))

;; Sum single-var mentions across region blocks [s..e] (hot-benefit input for
;; the loop-invariant class, whose home is one var rather than a coalesce group).
(define (compiler-reg-loop-phi-mb-region-var-mentions
  [block-array : (__tl_dyn-array ir.CompilerIrBlock)]
  [s : i64]
  [e : i64]
  [var : i64]) : i64
  (if (or (> s e) (>= s (array-length block-array)))
    0
    (+
      (match (array-ref block-array s)
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-loop-split-mention-count instrs var)])
      (compiler-reg-loop-phi-mb-region-var-mentions block-array (+ s 1) e var))))

;; Sum group mentions across region blocks [s..e] (hot-benefit input).
(define (compiler-reg-loop-phi-mb-region-mentions
  [block-array : (__tl_dyn-array ir.CompilerIrBlock)]
  [s : i64]
  [e : i64]
  [members : live.CompilerLiveI64Set]) : i64
  (if (or (> s e) (>= s (array-length block-array)))
    0
    (+
      (match (array-ref block-array s)
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-loop-split-mention-count-group instrs members)])
      (compiler-reg-loop-phi-mb-region-mentions block-array (+ s 1) e members))))

;; Per-block predecessor index RANGE, packed two entries per block:
;; ranges[2b] = lowest predecessor block index (block count when b has none),
;; ranges[2b+1] = highest predecessor block index (-1 when b has none). One
;; successor scan answers "are ALL of b's predecessors inside [lo..hi]?" for
;; every region the header scan tries, which keeps the single-entry test O(1)
;; per body block instead of a fresh CFG walk per candidate header.
(define (compiler-reg-loop-phi-mb-record-pred-range!
  [liveness : live.CompilerFunctionLiveness]
  [ranges : (__tl_dyn-array i64)]
  [from : i64]
  [succs : live.CompilerLiveLabelSet]) : unit
  (match succs
    [(live.CompilerLiveLabelSet.Nil) unit]
    [(live.CompilerLiveLabelSet.Dense _ _)
      (begin
        (let
          [to : i64
            (live.compiler-live-function-block-index
              liveness
              (live.compiler-live-label-set-ref succs 0))]
          (if (and (>= to 0) (< (* 2 to) (array-length ranges)))
            (begin
              (when
                (< from (array-ref ranges (* 2 to)))
                (set! (array-ref ranges (* 2 to)) from))
              (when
                (> from (array-ref ranges (+ (* 2 to) 1)))
                (set! (array-ref ranges (+ (* 2 to) 1)) from)))
            unit))
        (compiler-reg-loop-phi-mb-record-pred-range!
          liveness
          ranges
          from
          (live.compiler-live-label-set-tail succs)))]))

(define (compiler-reg-loop-phi-mb-pred-ranges
  [liveness : live.CompilerFunctionLiveness]
  [live-blocks : (__tl_dyn-array live.CompilerLiveBlock)]) : (__tl_dyn-array
    i64)
  (let
    [n : i64 (array-length live-blocks)]
    [ranges : (__tl_dyn-array i64) (array.make-array i64 (* 2 n))]
    [b : i64 0]
    (begin
      (while (< b n)
        (begin
          (set! (array-ref ranges (* 2 b)) n)
          (set! (array-ref ranges (+ (* 2 b) 1)) (- 0 1))
          (set! b (+ b 1))))
      (set! b 0)
      (while (< b n)
        (begin
          (compiler-reg-loop-phi-mb-record-pred-range!
            liveness
            ranges
            b
            (compiler-reg-live-block-succs (array-ref live-blocks b)))
          (set! b (+ b 1))))
      ranges)))

;; Single-entry gate for the region [h..end]: every BODY block (h..end] has ALL
;; of its predecessors inside the region, so the only way in is the header h.
;; With end == h+1 and a body whose one predecessor is h this is exactly the
;; original 2-block `pred-counts[h+1] == 1` test.
(define (compiler-reg-loop-phi-mb-body-entered-inside?
  [ranges : (__tl_dyn-array i64)]
  [body : i64]
  [end : i64]
  [h : i64]) : bool
  (let
    [b : i64 body]
    (begin
      (while (<= b end)
        (begin
          (unless
            (and
              (< (+ (* 2 b) 1) (array-length ranges))
              (>= (array-ref ranges (* 2 b)) h)
              (<= (array-ref ranges (+ (* 2 b) 1)) end))
            (return false))
          (set! b (+ b 1))))
      true)))

;; Try to home coalesce-root `var`'s phi-carried group across the region.
(define (compiler-reg-loop-phi-mb-try-var
  [_func : ir.CompilerIrFunction]
  [liveness : live.CompilerFunctionLiveness]
  [block-array : (__tl_dyn-array ir.CompilerIrBlock)]
  [h : i64]
  [end-idx : i64]
  [header-instrs : ir.CompilerIrInstrSeq]
  [region-labels : CompilerRegLabelSeq]
  [region-start : i64]
  [region-end : i64]
  [depth : i64]
  [candidate-regs : CompilerRegIdSeq]
  [vars : i64]
  [var : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : live.CompilerLiveI64Set]
  [parents : (__tl_dyn-array i64)]
  [weights : (__tl_dyn-array i64)]) : CompilerRegLoopSplitCandidate
  (if (and
    (compiler-reg-loop-split-coalesce-root? parents var)
    (compiler-reg-loop-split-phi-carried-group? header-instrs parents var)
    (compiler-reg-interval-index-var-has-segments? intervals var))
    (match (compiler-reg-assignment-lookup assignments var)
      [(CompilerRegMaybeLocation.Some location)
        (match location
          [(CompilerRegLocation.Spill _)
            (match (compiler-reg-loop-split-type-ok? type-info group-vars var)
              [(CompilerRegMaybeType.Some ty)
                (let
                  [members : live.CompilerLiveI64Set
                    (compiler-reg-loop-split-group-member-set parents var vars)]
                  [mentions : i64
                    (compiler-reg-loop-phi-mb-region-mentions
                      block-array
                      h
                      end-idx
                      members)]
                  [region-intervals : CompilerRegIntervalSeq
                    (compiler-reg-loop-split-region-interval
                      vars
                      region-start
                      region-end)]
                  (match (compiler-reg-edge-copy-plan-for-region-group-with-liveness
                    liveness
                    region-labels
                    var
                    vars
                    ty
                    members)
                    [(CompilerRegEdgeCopyPlan.Plan copies)
                      (if (and
                        ;; INTO present + non-refused => every live exit edge already
                        ;; carries its OUT write-back (the planner refuses otherwise),
                        ;; so this is the sufficient soundness witness; not-live-out
                        ;; carried values correctly need no OUT copy.
                        (compiler-reg-loop-split-direction-present? copies true)
                        (compiler-reg-loop-split-hot-benefit?
                          mentions
                          depth
                          (compiler-reg-edge-copy-list-count copies)))
                        (match (compiler-reg-loop-split-first-register
                          candidate-regs
                          assignments
                          intervals
                          region-intervals
                          var)
                          [(CompilerRegMaybeId.Some reg)
                            (CompilerRegLoopSplitCandidate.Candidate
                              var
                              region-labels
                              ty
                              reg
                              copies
                              (- 0 1))]
                          [(CompilerRegMaybeId.No)
                            (match (compiler-reg-loop-split-first-register-evict
                              candidate-regs
                              assignments
                              intervals
                              region-intervals
                              var
                              weights
                              (if (< var (array-length weights))
                                (array-ref weights var)
                                0))
                              [(CompilerRegLoopSplitEvict ereg evar)
                                (CompilerRegLoopSplitCandidate.Candidate
                                  var
                                  region-labels
                                  ty
                                  ereg
                                  copies
                                  evar)]
                              [(CompilerRegLoopSplitEvictNone)
                                (CompilerRegLoopSplitCandidate.NoCandidate)])])
                        (CompilerRegLoopSplitCandidate.NoCandidate))]
                    [(CompilerRegEdgeCopyPlan.Refused _)
                      (CompilerRegLoopSplitCandidate.NoCandidate)]))]
              [(CompilerRegMaybeType.No)
                (CompilerRegLoopSplitCandidate.NoCandidate)])]
          [_ (CompilerRegLoopSplitCandidate.NoCandidate)])]
      [(CompilerRegMaybeLocation.No)
        (CompilerRegLoopSplitCandidate.NoCandidate)])
    (CompilerRegLoopSplitCandidate.NoCandidate)))

;; SplitKit step 1, MULTI-BLOCK: home a spilled LOOP-INVARIANT value (live into
;; the loop header, never written anywhere in the region) in a register across the
;; whole natural loop. The single-block read-only path (loop-split-select-var) can
;; only do this when the entire loop is ONE block, so every invariant carried
;; through a real header+body loop -- a descriptor handle, a bound, a base pointer
;; -- spills whole and is reloaded on every use. The region here is the same
;; single-entry natural loop the phi-carried path uses, and the soundness argument
;; is the read-only one: the var is never redefined inside, so its slot stays
;; authoritative and the boundary plan needs only the INTO copy (OUT copies the
;; planner still emits on live exit edges are redundant stores of an unchanged
;; value, not correctness-carrying). Non-singleton coalesce members are excluded
;; exactly as the single-block read-only path excludes them, which keeps the
;; read-only argument anchored on ONE var: widening this to whole coalesce groups
;; (region-invariant iff no MEMBER is written inside, group-aware boundary plan)
;; was built and measured on both corpora and moved no benchmark row, so the
;; narrow form is kept.
(define (compiler-reg-loop-phi-mb-try-invariant-var
  [liveness : live.CompilerFunctionLiveness]
  [block-array : (__tl_dyn-array ir.CompilerIrBlock)]
  [header-block : live.CompilerLiveBlock]
  [h : i64]
  [end-idx : i64]
  [region-labels : CompilerRegLabelSeq]
  [region-start : i64]
  [region-end : i64]
  [depth : i64]
  [candidate-regs : CompilerRegIdSeq]
  [vars : i64]
  [var : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : live.CompilerLiveI64Set]
  [parents : (__tl_dyn-array i64)]
  [merged-roots : live.CompilerLiveI64Set]
  [weights : (__tl_dyn-array i64)]) : CompilerRegLoopSplitCandidate
  (if (and
    (live.compiler-live-set-contains?
      (live.compiler-live-block-live-in header-block)
      var)
    (not (compiler-reg-coalesce-var-nonsingleton? parents merged-roots var))
    (compiler-reg-interval-index-var-has-segments? intervals var)
    (not (compiler-reg-loop-phi-mb-region-defines? block-array h end-idx var)))
    (match (compiler-reg-assignment-lookup assignments var)
      [(CompilerRegMaybeLocation.Some location)
        (match location
          [(CompilerRegLocation.Spill _)
            (match (compiler-reg-loop-split-type-ok? type-info group-vars var)
              [(CompilerRegMaybeType.Some ty)
                (let
                  [mentions : i64
                    (compiler-reg-loop-phi-mb-region-var-mentions
                      block-array
                      h
                      end-idx
                      var)]
                  [region-intervals : CompilerRegIntervalSeq
                    (compiler-reg-loop-split-region-interval
                      vars
                      region-start
                      region-end)]
                  (match (compiler-reg-edge-copy-plan-for-region-with-liveness
                    liveness
                    region-labels
                    var
                    vars
                    ty)
                    [(CompilerRegEdgeCopyPlan.Plan copies)
                      (if (and
                        (compiler-reg-loop-split-direction-present? copies true)
                        (compiler-reg-loop-split-hot-benefit?
                          mentions
                          depth
                          (compiler-reg-edge-copy-list-count copies)))
                        (match (compiler-reg-loop-split-first-register
                          candidate-regs
                          assignments
                          intervals
                          region-intervals
                          var)
                          [(CompilerRegMaybeId.Some reg)
                            (CompilerRegLoopSplitCandidate.Candidate
                              var
                              region-labels
                              ty
                              reg
                              copies
                              (- 0 1))]
                          [(CompilerRegMaybeId.No)
                            (match (compiler-reg-loop-split-first-register-evict
                              candidate-regs
                              assignments
                              intervals
                              region-intervals
                              var
                              weights
                              (if (< var (array-length weights))
                                (array-ref weights var)
                                0))
                              [(CompilerRegLoopSplitEvict ereg evar)
                                (CompilerRegLoopSplitCandidate.Candidate
                                  var
                                  region-labels
                                  ty
                                  ereg
                                  copies
                                  evar)]
                              [(CompilerRegLoopSplitEvictNone)
                                (CompilerRegLoopSplitCandidate.NoCandidate)])])
                        (CompilerRegLoopSplitCandidate.NoCandidate))]
                    [(CompilerRegEdgeCopyPlan.Refused _)
                      (CompilerRegLoopSplitCandidate.NoCandidate)]))]
              [(CompilerRegMaybeType.No)
                (CompilerRegLoopSplitCandidate.NoCandidate)])]
          [_ (CompilerRegLoopSplitCandidate.NoCandidate)])]
      [(CompilerRegMaybeLocation.No)
        (CompilerRegLoopSplitCandidate.NoCandidate)])
    (CompilerRegLoopSplitCandidate.NoCandidate)))

(define (compiler-reg-loop-phi-mb-select-var
  [func : ir.CompilerIrFunction]
  [liveness : live.CompilerFunctionLiveness]
  [block-array : (__tl_dyn-array ir.CompilerIrBlock)]
  [header-block : live.CompilerLiveBlock]
  [h : i64]
  [end-idx : i64]
  [header-instrs : ir.CompilerIrInstrSeq]
  [region-labels : CompilerRegLabelSeq]
  [region-start : i64]
  [region-end : i64]
  [depth : i64]
  [candidate-regs : CompilerRegIdSeq]
  [vars : i64]
  [var : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : live.CompilerLiveI64Set]
  [parents : (__tl_dyn-array i64)]
  [merged-roots : live.CompilerLiveI64Set]
  [weights : (__tl_dyn-array i64)]) : CompilerRegLoopSplitCandidate
  (if (>= var vars)
    (CompilerRegLoopSplitCandidate.NoCandidate)
    (match (match (compiler-reg-loop-phi-mb-try-var
      func
      liveness
      block-array
      h
      end-idx
      header-instrs
      region-labels
      region-start
      region-end
      depth
      candidate-regs
      vars
      var
      type-info
      assignments
      intervals
      group-vars
      parents
      weights)
      ;; Phi-carried first (unchanged priority), then the loop-invariant class:
      ;; a var live into the header that is never written inside the region.
      [(CompilerRegLoopSplitCandidate.NoCandidate)
        (compiler-reg-loop-phi-mb-try-invariant-var
          liveness
          block-array
          header-block
          h
          end-idx
          region-labels
          region-start
          region-end
          depth
          candidate-regs
          vars
          var
          type-info
          assignments
          intervals
          group-vars
          parents
          merged-roots
          weights)]
      [(CompilerRegLoopSplitCandidate.Candidate sv lbls ty reg copies ev)
        (CompilerRegLoopSplitCandidate.Candidate sv lbls ty reg copies ev)])
      [(CompilerRegLoopSplitCandidate.NoCandidate)
        (compiler-reg-loop-phi-mb-select-var
          func
          liveness
          block-array
          header-block
          h
          end-idx
          header-instrs
          region-labels
          region-start
          region-end
          depth
          candidate-regs
          vars
          (+ var 1)
          type-info
          assignments
          intervals
          group-vars
          parents
          merged-roots
          weights)]
      [(CompilerRegLoopSplitCandidate.Candidate sv lbls ty reg copies ev)
        (CompilerRegLoopSplitCandidate.Candidate sv lbls ty reg copies ev)])))

;; Scan block indices for a natural-loop header (loop-ends[h] > h) at loop
;; depth>0 whose body blocks (h..loop-ends[h]] are each entered from inside the
;; region only, then try to home one of its phi-carried groups or, failing that,
;; one of its spilled loop invariants.
(define (compiler-reg-loop-phi-mb-select-headers
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [liveness : live.CompilerFunctionLiveness]
  [live-blocks : (__tl_dyn-array live.CompilerLiveBlock)]
  [block-array : (__tl_dyn-array ir.CompilerIrBlock)]
  [points : (__tl_dyn-array i64)]
  [loop-ends : (__tl_dyn-array i64)]
  [pred-ranges : (__tl_dyn-array i64)]
  [depths : (__tl_dyn-array i64)]
  [h : i64]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : live.CompilerLiveI64Set]
  [parents : (__tl_dyn-array i64)]
  [merged-roots : live.CompilerLiveI64Set]
  [weights : (__tl_dyn-array i64)]) : CompilerRegLoopSplitCandidate
  (if (>= h (array-length block-array))
    (CompilerRegLoopSplitCandidate.NoCandidate)
    (let
      [end-idx : i64
        (if (< h (array-length loop-ends))
          (array-ref loop-ends h)
          (- 0 1))]
      [body : i64 (+ h 1)]
      (if (and
        (>= end-idx body)
        (< end-idx (array-length block-array))
        (< h (array-length depths))
        (< h (array-length live-blocks))
        (> (array-ref depths h) 0)
        (compiler-reg-loop-phi-mb-body-entered-inside?
          pred-ranges
          body
          end-idx
          h))
        (let
          [region-start : i64 (array-ref points h)]
          [region-end : i64 (array-ref points (+ end-idx 1))]
          [candidate-regs : CompilerRegIdSeq
            (compiler-reg-loop-split-candidate-regs
              (not
                (compiler-reg-loop-phi-mb-region-has-call?
                  block-array
                  h
                  end-idx))
              (compiler-reg-loop-split-region-rcx-safe?
                type-segment-bases
                func
                region-start
                region-end)
              (compiler-reg-loop-split-region-rdx-safe?
                type-segment-bases
                func
                region-start
                region-end))]
          (match (compiler-reg-loop-phi-mb-select-var
            func
            liveness
            block-array
            (array-ref live-blocks h)
            h
            end-idx
            (match (array-ref block-array h)
              [(ir.CompilerIrBlock.Block _ instrs) instrs])
            (compiler-reg-loop-phi-mb-region-labels block-array h end-idx)
            region-start
            region-end
            (array-ref depths h)
            candidate-regs
            vars
            0
            type-info
            assignments
            intervals
            group-vars
            parents
            merged-roots
            weights)
            [(CompilerRegLoopSplitCandidate.NoCandidate)
              (compiler-reg-loop-phi-mb-select-headers
                type-segment-bases
                func
                liveness
                live-blocks
                block-array
                points
                loop-ends
                pred-ranges
                depths
                (+ h 1)
                vars
                type-info
                assignments
                intervals
                group-vars
                parents
                merged-roots
                weights)]
            [(CompilerRegLoopSplitCandidate.Candidate sv lbls ty reg copies ev)
              (CompilerRegLoopSplitCandidate.Candidate sv lbls ty reg copies ev)]))
        (compiler-reg-loop-phi-mb-select-headers
          type-segment-bases
          func
          liveness
          live-blocks
          block-array
          points
          loop-ends
          pred-ranges
          depths
          (+ h 1)
          vars
          type-info
          assignments
          intervals
          group-vars
          parents
          merged-roots
          weights)))))

;; Top-level multi-block phi selector: build block array / points / loop-ends /
;; pred ranges and scan headers. Returns a candidate (with multi-block region
;; labels) or NoCandidate. Called as the fallback after the single-block
;; select-blocks finds nothing, so the single-block paths stay byte-identical.
(define (compiler-reg-loop-phi-mb-select
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [blocks : ir.CompilerIrBlockList]
  [liveness : live.CompilerFunctionLiveness]
  [live-blocks : (__tl_dyn-array live.CompilerLiveBlock)]
  [depths : (__tl_dyn-array i64)]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : live.CompilerLiveI64Set]
  [parents : (__tl_dyn-array i64)]
  [merged-roots : live.CompilerLiveI64Set]
  [weights : (__tl_dyn-array i64)]) : CompilerRegLoopSplitCandidate
  (let
    [seq : ir.CompilerIrBlockSeq
      (live.compiler-live-ir-block-list-to-seq blocks)]
    [block-array : (__tl_dyn-array ir.CompilerIrBlock) seq.slots]
    [count : i64 (array-length block-array)]
    (if (<= count 1)
      (CompilerRegLoopSplitCandidate.NoCandidate)
      (compiler-reg-loop-phi-mb-select-headers
        type-segment-bases
        func
        liveness
        live-blocks
        block-array
        (compiler-reg-loop-phi-mb-block-points block-array)
        (compiler-reg-preheader-loop-ends-seq seq count)
        (compiler-reg-loop-phi-mb-pred-ranges liveness live-blocks)
        depths
        0
        vars
        type-info
        assignments
        intervals
        group-vars
        parents
        merged-roots
        weights))))

;; A leaf can still exhaust the caller-saved bank inside a hot loop even when a
;; caller-saved register is free before or after that loop. The whole-range
;; greedy then gives a read-only loop invariant a callee-saved home and pays a
;; push/pop on every function invocation. Split that range at the natural-loop
;; boundary when all of the following are proven:
;;
;;   * the function has no kind-0 caller-clobber point;
;;   * the invariant is the sole user of its callee-saved physical register;
;;   * one caller-saved register is free over the loop and a different one is
;;     free over every live segment outside the loop;
;;   * the edge-copy planner needs exactly one INTO move and no write-back.
;;
;; The last gate makes the static instruction-count delta strictly profitable:
;; one boundary move replaces the callee-save push+pop pair. No spill or
;; eviction is admitted. The hashmap get-value-or shape is the motivating case:
;; its slots pointer moves from a pre-loop volatile register into the %r8 that
;; becomes dead after the hash multiply.
(define (compiler-reg-leaf-csr-fuse-free-branch-var
  [slots : (__tl_dyn-array ir.CompilerIrInstr)]
  [index : i64]) : i64
  (if (<= index 0)
    (- 0 1)
    (match (ir.compiler-ir-instr-scalar-fact (array-ref slots index))
      [(ir.CompilerIrInstrScalarFact.Branch cond _ _)
        (match cond
          [(ir.CompilerIrValue.Var var)
            (match (array-ref slots (- index 1))
              [(ir.CompilerIrInstr.BinOp dst op _ _ ty)
                (if (and
                  (= dst var)
                  (compiler-reg-scratch-compare-op? op)
                  (not (compiler-reg-float-type? ty)))
                  var
                  (- 0 1))]
              [(ir.CompilerIrInstr.UnOp
                  dst
                  (ir.CompilerIrUnOp.Not)
                  _
                  (ast.AstType.Bool))
                (if (= dst var)
                  var
                  (- 0 1))]
              [_ (- 0 1)])]
          [_ (- 0 1)])]
      [_ (- 0 1)])))

(define (compiler-reg-leaf-csr-fuse-facts-seq
  [instrs : ir.CompilerIrInstrSeq]
  [var : i64]) : CompilerRegLeafCsrFuseFacts
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    [uses : i64 0]
    [free-branches : i64 0]
    (begin
      (while (< index count)
        (begin
          (if (live.compiler-live-set-contains?
            (live.compiler-live-instr-uses (array-ref slots index))
            var)
            (set! uses (+ uses 1))
            unit)
          (if (= (compiler-reg-leaf-csr-fuse-free-branch-var slots index) var)
            (set! free-branches (+ free-branches 1))
            unit)
          (set! index (+ index 1))))
      (CompilerRegLeafCsrFuseFacts uses free-branches))))

(define (compiler-reg-leaf-csr-fuse-facts-blocks
  [blocks : ir.CompilerIrBlockList]
  [var : i64]
  [uses : i64]
  [free-branches : i64]) : CompilerRegLeafCsrFuseFacts
  (match blocks
    [(ir.CompilerIrBlockList.Nil)
      (CompilerRegLeafCsrFuseFacts uses free-branches)]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [facts : CompilerRegLeafCsrFuseFacts
              (compiler-reg-leaf-csr-fuse-facts-seq instrs var)]
            (compiler-reg-leaf-csr-fuse-facts-blocks
              (__tl-box-place rest)
              var
              (+ uses facts.uses)
              (+ free-branches facts.free-branches)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (compiler-reg-leaf-csr-fuse-facts-block-seq seq var uses free-branches)]))

(define (compiler-reg-leaf-csr-fuse-facts-block-seq
  [blocks : ir.CompilerIrBlockSeq]
  [var : i64]
  [uses : i64]
  [free-branches : i64]) : CompilerRegLeafCsrFuseFacts
  (let
    [index : i64 0]
    [count : i64 (ir.compiler-ir-block-seq-count blocks)]
    [total-uses : i64 uses]
    [total-free : i64 free-branches]
    (begin
      (while (< index count)
        (begin
          (match (ir.compiler-ir-block-seq-ref blocks index)
            [(ir.CompilerIrBlock.Block _ instrs)
              (let
                [facts : CompilerRegLeafCsrFuseFacts
                  (compiler-reg-leaf-csr-fuse-facts-seq instrs var)]
                (begin
                  (set! total-uses (+ total-uses facts.uses))
                  (set! total-free (+ total-free facts.free-branches))))])
          (set! index (+ index 1))))
      (CompilerRegLeafCsrFuseFacts total-uses total-free))))

(define (compiler-reg-leaf-csr-fuse-safe?
  [func : ir.CompilerIrFunction]
  [var : i64]) : bool
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (let
        [facts : CompilerRegLeafCsrFuseFacts
          (compiler-reg-leaf-csr-fuse-facts-blocks blocks var 0 0)]
        (and (> facts.uses 0) (= facts.uses facts.free-branches)))]))

(define (compiler-reg-leaf-csr-location-conflicts-region?
  [func : ir.CompilerIrFunction]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [region-intervals : CompilerRegIntervalSeq]
  [ignore-var : i64]
  [location : CompilerRegLocation]) : bool
  (let
    [present : (__tl_dyn-array i64) assignments.present]
    [items : (__tl_dyn-array CompilerRegLocation) assignments.items]
    [assigned-var : i64 0]
    [conflict : bool false]
    (begin
      (while (and (< assigned-var (array-length present)) (not conflict))
        (begin
          (if (and
            (not (= (array-ref present assigned-var) 0))
            (not (= assigned-var ignore-var))
            (compiler-reg-location-overlaps?
              (array-ref items assigned-var)
              location)
            (not (compiler-reg-leaf-csr-fuse-safe? func assigned-var))
            (compiler-reg-loop-split-var-overlaps-region?
              intervals
              assigned-var
              region-intervals))
            (set! conflict true)
            unit)
          (set! assigned-var (+ assigned-var 1))))
      conflict)))

(define (compiler-reg-leaf-csr-first-inner-register
  [func : ir.CompilerIrFunction]
  [regs : CompilerRegIdSeq]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [region-intervals : CompilerRegIntervalSeq]
  [ignore-var : i64]) : CompilerRegMaybeId
  (let
    [index : i64 0]
    [result : CompilerRegMaybeId CompilerRegMaybeId.No]
    [done : bool false]
    (begin
      (while (and (< index (compiler-reg-id-seq-count regs)) (not done))
        (let
          [reg : i64 (compiler-reg-id-seq-ref regs index)]
          (if (compiler-reg-leaf-csr-location-conflicts-region?
            func
            assignments
            intervals
            region-intervals
            ignore-var
            (CompilerRegLocation.Register reg))
            (set! index (+ index 1))
            (begin
              (set! result (CompilerRegMaybeId.Some reg))
              (set! done true)))))
      result)))

(define (compiler-reg-leaf-csr-filter-caller-regs
  [regs : CompilerRegIdSeq]
  [rax-safe? : bool]
  [rcx-safe? : bool]
  [rdx-safe? : bool]) : CompilerRegIdSeq
  (let
    [index : i64 0]
    [out : CompilerRegIdSeq
      (compiler-reg-id-seq-with-capacity (compiler-reg-id-seq-count regs))]
    (begin
      (while (< index (compiler-reg-id-seq-count regs))
        (let
          [reg : i64 (compiler-reg-id-seq-ref regs index)]
          (begin
            (if (or
              (and (= reg cabi.compiler-reg-id-rax) (not rax-safe?))
              (and (= reg cabi.compiler-reg-id-rcx) (not rcx-safe?))
              (and (= reg cabi.compiler-reg-id-rdx) (not rdx-safe?)))
              unit
              (set! out (compiler-reg-id-seq-push out reg)))
            (set! index (+ index 1)))))
      out)))

(define (compiler-reg-leaf-csr-caller-regs
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [start : i64]
  [end : i64]) : CompilerRegIdSeq
  (compiler-reg-leaf-csr-filter-caller-regs
    (compiler-reg-caller-saved-integer-registers-from-abi target-abi 0)
    (not
      (compiler-reg-loop-split-region-crosses-kind?
        type-segment-bases
        func
        1
        start
        end))
    (compiler-reg-loop-split-region-rcx-safe? type-segment-bases func start end)
    (compiler-reg-loop-split-region-rdx-safe? type-segment-bases func start end)))

(define (compiler-reg-leaf-csr-region-defines?
  [live-blocks : (__tl_dyn-array live.CompilerLiveBlock)]
  [start-index : i64]
  [end-index : i64]
  [var : i64]) : bool
  (let
    [index : i64 start-index]
    [found : bool false]
    (begin
      (while (and
        (<= index end-index)
        (< index (array-length live-blocks))
        (not found))
        (begin
          (if (live.compiler-live-set-contains?
            (live.compiler-live-block-defs (array-ref live-blocks index))
            var)
            (set! found true)
            unit)
          (set! index (+ index 1))))
      found)))

(define (compiler-reg-leaf-csr-region-mentions
  [blocks : (__tl_dyn-array ir.CompilerIrBlock)]
  [start-index : i64]
  [end-index : i64]
  [var : i64]) : i64
  (if (or (> start-index end-index) (>= start-index (array-length blocks)))
    0
    (+
      (match (array-ref blocks start-index)
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-loop-split-mention-count instrs var)])
      (compiler-reg-leaf-csr-region-mentions
        blocks
        (+ start-index 1)
        end-index
        var))))

(define (compiler-reg-leaf-csr-location-conflicts-outer-segments?
  [segments : CompilerRegIntervalSeq]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [region-start : i64]
  [region-end : i64]
  [ignore-var : i64]
  [location : CompilerRegLocation]) : bool
  (let
    [slots : (__tl_dyn-array CompilerRegInterval) segments.slots]
    [count : i64 segments.len]
    [index : i64 0]
    [conflict : bool false]
    (begin
      (while (and (< index count) (not conflict))
        (begin
          (let
            [interval : CompilerRegInterval (array-ref slots index)]
            [start : i64 interval.start]
            [end : i64 interval.end]
            [before? : bool
              (and
                (< start region-start)
                (compiler-reg-loop-split-location-conflicts-region?
                  assignments
                  intervals
                  (compiler-reg-loop-split-region-interval
                    ignore-var
                    start
                    (if (< end region-start)
                      end
                      region-start))
                  ignore-var
                  location))]
            [after? : bool
              (and
                (> end region-end)
                (compiler-reg-loop-split-location-conflicts-region?
                  assignments
                  intervals
                  (compiler-reg-loop-split-region-interval
                    ignore-var
                    (if (> start region-end)
                      start
                      region-end)
                    end)
                  ignore-var
                  location))]
            (if (or before? after?)
              (set! conflict true)
              unit))
          (set! index (+ index 1))))
      conflict)))

(define (compiler-reg-leaf-csr-location-conflicts-outer?
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [region-start : i64]
  [region-end : i64]
  [var : i64]
  [location : CompilerRegLocation]) : bool
  (let
    [segments : (__tl_dyn-array CompilerRegIntervalSeq) intervals.segments]
    [var-segments : CompilerRegIntervalSeq
      (if (and (>= var 0) (< var (array-length segments)))
        (array-ref segments var)
        (compiler-reg-interval-seq-empty))]
    (if (not (compiler-reg-interval-seq-empty? var-segments))
      (compiler-reg-leaf-csr-location-conflicts-outer-segments?
        var-segments
        assignments
        intervals
        region-start
        region-end
        var
        location)
      (match (compiler-reg-interval-index-lookup intervals var)
        [(CompilerRegMaybeInterval.Some interval)
          (compiler-reg-leaf-csr-location-conflicts-outer-segments?
            (compiler-reg-interval-seq-prepend
              interval
              (compiler-reg-interval-seq-empty))
            assignments
            intervals
            region-start
            region-end
            var
            location)]
        [(CompilerRegMaybeInterval.No) true]))))

(define (compiler-reg-leaf-csr-first-outer-register
  [regs : CompilerRegIdSeq]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [region-start : i64]
  [region-end : i64]
  [var : i64]
  [inner-reg : i64]) : CompilerRegMaybeId
  (let
    [index : i64 0]
    [result : CompilerRegMaybeId CompilerRegMaybeId.No]
    [done : bool false]
    (begin
      (while (and (< index (compiler-reg-id-seq-count regs)) (not done))
        (let
          [reg : i64 (compiler-reg-id-seq-ref regs index)]
          (if (or
            (compiler-reg-registers-overlap? reg inner-reg)
            (compiler-reg-leaf-csr-location-conflicts-outer?
              assignments
              intervals
              region-start
              region-end
              var
              (CompilerRegLocation.Register reg)))
            (set! index (+ index 1))
            (begin
              (set! result (CompilerRegMaybeId.Some reg))
              (set! done true)))))
      result)))

(define (compiler-reg-leaf-csr-try-var
  [func : ir.CompilerIrFunction]
  [liveness : live.CompilerFunctionLiveness]
  [live-blocks : (__tl_dyn-array live.CompilerLiveBlock)]
  [block-array : (__tl_dyn-array ir.CompilerIrBlock)]
  [region-labels : CompilerRegLabelSeq]
  [region-start-index : i64]
  [region-end-index : i64]
  [region-start : i64]
  [region-end : i64]
  [vars : i64]
  [var : i64]
  [param-vars : live.CompilerLiveI64Set]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : live.CompilerLiveI64Set]
  [parents : (__tl_dyn-array i64)]
  [merged-roots : live.CompilerLiveI64Set]
  [inner-regs : CompilerRegIdSeq]
  [outer-regs : CompilerRegIdSeq]
  [callee-regs : CompilerRegIdSeq]) : CompilerRegLeafCsrSplitCandidate
  (if (or
    (live.compiler-live-set-contains? param-vars var)
    (live.compiler-live-set-contains? group-vars var)
    (compiler-reg-coalesce-var-nonsingleton? parents merged-roots var)
    (>= region-start-index (array-length live-blocks))
    (not
      (live.compiler-live-set-contains?
        (live.compiler-live-block-live-in
          (array-ref live-blocks region-start-index))
        var))
    (compiler-reg-leaf-csr-region-defines?
      live-blocks
      region-start-index
      region-end-index
      var)
    (<=
      (compiler-reg-leaf-csr-region-mentions
        block-array
        region-start-index
        region-end-index
        var)
      0))
    CompilerRegLeafCsrSplitCandidate.NoCandidate
    (match (compiler-reg-assignment-lookup assignments var)
      [(CompilerRegMaybeLocation.Some location)
        (match location
          [(CompilerRegLocation.Register csr)
            (if (and
              (compiler-reg-id-seq-contains? callee-regs csr)
              (=
                (compiler-reg-assignments-register-use-count assignments csr)
                1))
              (match (compiler-reg-loop-split-type-ok? type-info group-vars var)
                [(CompilerRegMaybeType.Some ty)
                  (let
                    [region-intervals : CompilerRegIntervalSeq
                      (compiler-reg-loop-split-region-interval
                        vars
                        region-start
                        region-end)]
                    (match (compiler-reg-leaf-csr-first-inner-register
                      func
                      inner-regs
                      assignments
                      intervals
                      region-intervals
                      var)
                      [(CompilerRegMaybeId.Some inner-reg)
                        (let
                          [fused-occupant : i64
                            (compiler-reg-loop-split-region-occupant
                              assignments
                              intervals
                              region-intervals
                              var
                              (CompilerRegLocation.Register inner-reg)
                              (- 0 2))]
                          [outer : CompilerRegMaybeId
                            (compiler-reg-leaf-csr-first-outer-register
                              outer-regs
                              assignments
                              intervals
                              region-start
                              region-end
                              var
                              inner-reg)]
                          (if (= fused-occupant (- 0 1))
                            CompilerRegLeafCsrSplitCandidate.NoCandidate
                            (match outer
                              [(CompilerRegMaybeId.Some outer-reg)
                                (match (compiler-reg-edge-copy-plan-for-region-with-liveness
                                  liveness
                                  region-labels
                                  var
                                  (+ vars 1)
                                  ty)
                                  [(CompilerRegEdgeCopyPlan.Plan copies)
                                    (if (and
                                      (=
                                        (compiler-reg-edge-copy-list-count
                                          copies)
                                        1)
                                      (compiler-reg-loop-split-direction-present?
                                        copies
                                        true))
                                      (CompilerRegLeafCsrSplitCandidate.Candidate
                                        var
                                        region-labels
                                        ty
                                        inner-reg
                                        outer-reg
                                        copies
                                        fused-occupant)
                                      CompilerRegLeafCsrSplitCandidate.NoCandidate)]
                                  [(CompilerRegEdgeCopyPlan.Refused _)
                                    CompilerRegLeafCsrSplitCandidate.NoCandidate])]
                              [(CompilerRegMaybeId.No)
                                CompilerRegLeafCsrSplitCandidate.NoCandidate])))]
                      [(CompilerRegMaybeId.No)
                        CompilerRegLeafCsrSplitCandidate.NoCandidate]))]
                [(CompilerRegMaybeType.No)
                  CompilerRegLeafCsrSplitCandidate.NoCandidate])
              CompilerRegLeafCsrSplitCandidate.NoCandidate)]
          [_ CompilerRegLeafCsrSplitCandidate.NoCandidate])]
      [(CompilerRegMaybeLocation.No)
        CompilerRegLeafCsrSplitCandidate.NoCandidate])))

(define (compiler-reg-leaf-csr-select-var
  [func : ir.CompilerIrFunction]
  [liveness : live.CompilerFunctionLiveness]
  [live-blocks : (__tl_dyn-array live.CompilerLiveBlock)]
  [block-array : (__tl_dyn-array ir.CompilerIrBlock)]
  [region-labels : CompilerRegLabelSeq]
  [region-start-index : i64]
  [region-end-index : i64]
  [region-start : i64]
  [region-end : i64]
  [vars : i64]
  [var : i64]
  [param-vars : live.CompilerLiveI64Set]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : live.CompilerLiveI64Set]
  [parents : (__tl_dyn-array i64)]
  [merged-roots : live.CompilerLiveI64Set]
  [inner-regs : CompilerRegIdSeq]
  [outer-regs : CompilerRegIdSeq]
  [callee-regs : CompilerRegIdSeq]) : CompilerRegLeafCsrSplitCandidate
  (if (>= var vars)
    CompilerRegLeafCsrSplitCandidate.NoCandidate
    (match (compiler-reg-leaf-csr-try-var
      func
      liveness
      live-blocks
      block-array
      region-labels
      region-start-index
      region-end-index
      region-start
      region-end
      vars
      var
      param-vars
      type-info
      assignments
      intervals
      group-vars
      parents
      merged-roots
      inner-regs
      outer-regs
      callee-regs)
      [(CompilerRegLeafCsrSplitCandidate.NoCandidate)
        (compiler-reg-leaf-csr-select-var
          func
          liveness
          live-blocks
          block-array
          region-labels
          region-start-index
          region-end-index
          region-start
          region-end
          vars
          (+ var 1)
          param-vars
          type-info
          assignments
          intervals
          group-vars
          parents
          merged-roots
          inner-regs
          outer-regs
          callee-regs)]
      [(CompilerRegLeafCsrSplitCandidate.Candidate
          split-var
          labels
          ty
          inner-reg
          outer-reg
          copies
          fused-occupant)
        (CompilerRegLeafCsrSplitCandidate.Candidate
          split-var
          labels
          ty
          inner-reg
          outer-reg
          copies
          fused-occupant)])))

(define (compiler-reg-leaf-csr-select-headers
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [liveness : live.CompilerFunctionLiveness]
  [live-blocks : (__tl_dyn-array live.CompilerLiveBlock)]
  [block-array : (__tl_dyn-array ir.CompilerIrBlock)]
  [points : (__tl_dyn-array i64)]
  [loop-ends : (__tl_dyn-array i64)]
  [depths : (__tl_dyn-array i64)]
  [header : i64]
  [vars : i64]
  [param-vars : live.CompilerLiveI64Set]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : live.CompilerLiveI64Set]
  [parents : (__tl_dyn-array i64)]
  [merged-roots : live.CompilerLiveI64Set]
  [outer-regs : CompilerRegIdSeq]
  [callee-regs : CompilerRegIdSeq]) : CompilerRegLeafCsrSplitCandidate
  (if (>= header (array-length block-array))
    CompilerRegLeafCsrSplitCandidate.NoCandidate
    (let
      [end-index : i64
        (if (< header (array-length loop-ends))
          (array-ref loop-ends header)
          (- 0 1))]
      (if (and
        (>= end-index header)
        (< (+ end-index 1) (array-length points))
        (< header (array-length depths))
        (> (array-ref depths header) 0))
        (let
          [region-start : i64 (array-ref points header)]
          [region-end : i64 (array-ref points (+ end-index 1))]
          [inner-regs : CompilerRegIdSeq
            (compiler-reg-leaf-csr-caller-regs
              type-segment-bases
              target-abi
              func
              region-start
              region-end)]
          (match (compiler-reg-leaf-csr-select-var
            func
            liveness
            live-blocks
            block-array
            (compiler-reg-loop-phi-mb-region-labels
              block-array
              header
              end-index)
            header
            end-index
            region-start
            region-end
            vars
            0
            param-vars
            type-info
            assignments
            intervals
            group-vars
            parents
            merged-roots
            inner-regs
            outer-regs
            callee-regs)
            [(CompilerRegLeafCsrSplitCandidate.NoCandidate)
              (compiler-reg-leaf-csr-select-headers
                type-segment-bases
                target-abi
                func
                liveness
                live-blocks
                block-array
                points
                loop-ends
                depths
                (+ header 1)
                vars
                param-vars
                type-info
                assignments
                intervals
                group-vars
                parents
                merged-roots
                outer-regs
                callee-regs)]
            [(CompilerRegLeafCsrSplitCandidate.Candidate
                split-var
                labels
                ty
                inner-reg
                outer-reg
                copies
                fused-occupant)
              (CompilerRegLeafCsrSplitCandidate.Candidate
                split-var
                labels
                ty
                inner-reg
                outer-reg
                copies
                fused-occupant)]))
        (compiler-reg-leaf-csr-select-headers
          type-segment-bases
          target-abi
          func
          liveness
          live-blocks
          block-array
          points
          loop-ends
          depths
          (+ header 1)
          vars
          param-vars
          type-info
          assignments
          intervals
          group-vars
          parents
          merged-roots
          outer-regs
          callee-regs)))))

(define (compiler-reg-leaf-csr-remap-edge-copy
  [copy : CompilerRegEdgeCopy]
  [from-var : i64]
  [to-var : i64]) : CompilerRegEdgeCopy
  (match copy
    [(CompilerRegEdgeCopy.Copy
        from-label
        to-label
        src
        dst
        ty
        direction
        placement)
      (CompilerRegEdgeCopy.Copy
        from-label
        to-label
        (if (= src from-var)
          to-var
          src)
        (if (= dst from-var)
          to-var
          dst)
        ty
        direction
        placement)]))

(define (compiler-reg-leaf-csr-remap-edge-copies
  [copies : CompilerRegEdgeCopySeq]
  [from-var : i64]
  [to-var : i64]) : CompilerRegEdgeCopySeq
  (let
    [source : (__tl_dyn-array CompilerRegEdgeCopy) copies.slots]
    [count : i64 copies.len]
    [out : (__tl_dyn-array CompilerRegEdgeCopy)
      (array.make-array
        CompilerRegEdgeCopy
        (if (< count 1)
          1
          count))]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            (array-ref out index)
            (compiler-reg-leaf-csr-remap-edge-copy
              (array-ref source index)
              from-var
              to-var))
          (set! index (+ index 1))))
      (CompilerRegEdgeCopySeq out count))))

;; The split boundary must remain a real copy after the fresh allocation pass.
;; A plain Mov is deliberately coalescable, which would reunite the outside and
;; loop pieces and recreate the original whole-function callee-saved range.
;; A same-type Bitcast has identical backend copy semantics, but is not a
;; coalescing candidate.
(define (compiler-reg-leaf-csr-boundary-instr
  [instr : ir.CompilerIrInstr]
  [src-var : i64]
  [dst-var : i64]) : ir.CompilerIrInstr
  (match instr
    [(ir.CompilerIrInstr.Mov dst src ty)
      (match src
        [(ir.CompilerIrValue.Var found-src)
          (if (and (= dst dst-var) (= found-src src-var))
            (match ty
              [(ast.AstType.I64) (ir.CompilerIrInstr.Bitcast dst src ty ty)]
              [(ast.AstType.U64) (ir.CompilerIrInstr.Bitcast dst src ty ty)]
              [_ (ir.CompilerIrInstr.Cast dst src ty ty)])
            instr)]
        [_ instr])]
    [_ instr]))

;; A 1:1 Mov->Bitcast/Cast rewrite: the output is exactly as long as the
;; input, so it is written straight into a right-sized dense sequence instead
;; of through a cons spine (refs #5726).
(define (compiler-reg-leaf-csr-boundary-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [src-var : i64]
  [dst-var : i64]) : ir.CompilerIrInstrSeq
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [out : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr count)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            (array-ref out index)
            (compiler-reg-leaf-csr-boundary-instr
              (array-ref slots index)
              src-var
              dst-var))
          (set! index (+ index 1))))
      (ir.CompilerIrInstrSeq out count))))

(define (compiler-reg-leaf-csr-boundary-blocks
  [blocks : ir.CompilerIrBlockList]
  [src-var : i64]
  [dst-var : i64]) : ir.CompilerIrBlockList
  (match blocks
    [(ir.CompilerIrBlockList.Nil) ir.CompilerIrBlockList.Nil]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block label instrs)
          (ir.compiler-ir-block-cons
            (ir.CompilerIrBlock.Block
              label
              (compiler-reg-leaf-csr-boundary-instr-seq instrs src-var dst-var))
            (compiler-reg-leaf-csr-boundary-blocks
              (__tl-box-place rest)
              src-var
              dst-var))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [slots : (__tl_dyn-array ir.CompilerIrBlock)
          (array.make-array ir.CompilerIrBlock count)]
        [index : i64 0]
        (begin
          (while (< index count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq index)
                [(ir.CompilerIrBlock.Block label instrs)
                  (set!
                    (array-ref slots index)
                    (ir.CompilerIrBlock.Block
                      label
                      (compiler-reg-leaf-csr-boundary-instr-seq
                        instrs
                        src-var
                        dst-var)))])
              (set! index (+ index 1))))
          (ir.CompilerIrBlockList.Array (ir.CompilerIrBlockSeq slots count))))]))

(define (compiler-reg-leaf-csr-apply-candidate
  [blocks : ir.CompilerIrBlockList]
  [vars : i64]
  [stack-var : i64]
  [region-labels : CompilerRegLabelSeq]
  [ty : ast.AstType]
  [inner-reg : i64]
  [outer-reg : i64]
  [copies : CompilerRegEdgeCopySeq]
  [fused-occupant : i64]) : CompilerRegCallSaveRewrite
  (let
    [outer-var : i64 vars]
    [inner-var : i64 (+ vars 1)]
    [outer-remap : (__tl_dyn-array i64) (compiler-reg-caller-save-remap vars)]
    [region-remap : (__tl_dyn-array i64)
      (compiler-reg-caller-save-remap (+ vars 1))]
    [extra-assignments : CompilerRegAssignmentTable
      (compiler-reg-assignments-prepend
        (CompilerRegAssignment
          outer-var
          (CompilerRegLocation.Register outer-reg))
        (compiler-reg-assignments-prepend
          (CompilerRegAssignment
            inner-var
            (CompilerRegLocation.Register inner-reg))
          (if (>= fused-occupant 0)
            (compiler-reg-assignments-prepend
              (CompilerRegAssignment
                fused-occupant
                (CompilerRegLocation.Register inner-reg))
              (compiler-reg-assignment-table-empty))
            (compiler-reg-assignment-table-empty))))]
    (begin
      (set! (array-ref outer-remap stack-var) outer-var)
      (set! (array-ref region-remap outer-var) inner-var)
      (match (compiler-reg-edge-copy-apply
        (compiler-reg-loop-split-region-remap-blocks
          (compiler-reg-remap-blocks outer-remap blocks)
          (compiler-reg-region-label-map region-labels)
          region-remap)
        (compiler-reg-leaf-csr-remap-edge-copies copies stack-var outer-var))
        [(CompilerRegEdgeCopyRewrite.Rewrite rewritten-blocks)
          (CompilerRegCallSaveRewrite.Rewrite
            (compiler-reg-leaf-csr-boundary-blocks
              rewritten-blocks
              outer-var
              inner-var)
            vars
            (+ vars 2)
            extra-assignments
            (compiler-reg-var-types-insert
              (compiler-reg-var-types-insert
                (compiler-reg-var-types-empty)
                inner-var
                ty)
              outer-var
              ty))]
        [(CompilerRegEdgeCopyRewrite.Refused _)
          (compiler-reg-loop-split-noop blocks vars)]))))

(define (compiler-reg-leaf-csr-split-rewrite-one
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [blocks : ir.CompilerIrBlockList]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [plan : CompilerRegPlan]) : CompilerRegCallSaveRewrite
  (if (or
    (not (compiler-reg-scalar-full-intervals? func))
    (>
      (live.compiler-live-set-count
        (compiler-reg-clobber-kind-points type-segment-bases func 0))
      0))
    (compiler-reg-loop-split-noop blocks vars)
    (let
      [depths : (__tl_dyn-array i64) (compiler-reg-function-loop-depths blocks)]
      (if (not (compiler-reg-depths-have-loop? depths 0))
        (compiler-reg-loop-split-noop blocks vars)
        (let
          [liveness : live.CompilerFunctionLiveness
            (live.compiler-live-analyze-function func)]
          [selection : CompilerRegIntervalSelection
            (compiler-reg-live-interval-selection func liveness)]
          [assignments : CompilerRegAssignmentTable
            (compiler-reg-plan-assignments plan)]
          [group-vars : live.CompilerLiveI64Set
            (compiler-reg-function-group-vars type-segment-bases func type-info)]
          [seq : ir.CompilerIrBlockSeq
            (live.compiler-live-ir-block-list-to-seq blocks)]
          [block-array : (__tl_dyn-array ir.CompilerIrBlock) seq.slots]
          [param-vars : live.CompilerLiveI64Set
            (match func
              [(ir.CompilerIrFunction.Function _ params _ _ _)
                (compiler-reg-ineligible-params
                  params
                  (live.compiler-live-set-empty))])]
          [outer-regs : CompilerRegIdSeq
            (compiler-reg-leaf-csr-caller-regs
              type-segment-bases
              target-abi
              func
              0
              (array-ref
                (compiler-reg-loop-phi-mb-block-points block-array)
                (array-length block-array)))]
          [callee-regs : CompilerRegIdSeq
            (compiler-reg-callee-saved-integer-registers-from-abi target-abi 0)]
          (match selection
            [(CompilerRegIntervalSelection.Selection _ intervals)
              (let
                [coalesce : CompilerRegCoalesceMap
                  (compiler-reg-coalesce-map-build
                    (compiler-reg-function-moves func false)
                    intervals
                    type-info
                    group-vars
                    vars
                    (array.make-array i64 0))]
                [parents : (__tl_dyn-array i64) coalesce.parents]
                [merged-roots : live.CompilerLiveI64Set
                  (compiler-reg-coalesce-merged-root-set coalesce)]
                (match liveness
                  [(live.CompilerFunctionLiveness.Liveness _ live-blocks)
                    (match (compiler-reg-leaf-csr-select-headers
                      type-segment-bases
                      target-abi
                      func
                      liveness
                      live-blocks
                      block-array
                      (compiler-reg-loop-phi-mb-block-points block-array)
                      (compiler-reg-preheader-loop-ends-seq
                        seq
                        (array-length block-array))
                      depths
                      0
                      vars
                      param-vars
                      type-info
                      assignments
                      intervals
                      group-vars
                      parents
                      merged-roots
                      outer-regs
                      callee-regs)
                      [(CompilerRegLeafCsrSplitCandidate.NoCandidate)
                        (compiler-reg-loop-split-noop blocks vars)]
                      [(CompilerRegLeafCsrSplitCandidate.Candidate
                          stack-var
                          region-labels
                          ty
                          inner-reg
                          outer-reg
                          copies
                          fused-occupant)
                        (compiler-reg-leaf-csr-apply-candidate
                          blocks
                          vars
                          stack-var
                          region-labels
                          ty
                          inner-reg
                          outer-reg
                          copies
                          fused-occupant)])]))]))))))

;; Multi-split: rescue EVERY profitable spilled loop-carried var, not just the
;; first. Each split rewrites the IR (region uses -> a new register-resident var
;; SV + edge copies at the region boundary) and merges SV's register assignment
;; into `plan`; the next pass recomputes liveness/intervals on the rewritten
;; blocks, so its conflict check (loop-split-first-register / location-conflicts-
;; region?) already sees every prior split's SV occupying its register across its
;; region and avoids it -- which is exactly what makes picking the FINAL (not
;; re-allocated) registers sound. The region remap also stops the same var being
;; re-selected for the same region, so it converges; fuel (the integer register
;; count) bounds it. With a single candidate this is bit-identical to the old
;; one-shot behaviour (merging additions with the empty tail is the identity).
(define (compiler-reg-depths-have-loop?
  [depths : (__tl_dyn-array i64)]
  [index : i64]) : bool
  (if (>= index (array-length depths))
    false
    (if (> (array-ref depths index) 0)
      true
      (compiler-reg-depths-have-loop? depths (+ index 1)))))

(define (compiler-reg-loop-split-rewrite-one
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [blocks : ir.CompilerIrBlockList]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [plan : CompilerRegPlan]) : CompilerRegLoopSplitRewriteResult
  (if (not (compiler-reg-scalar-full-intervals? func))
    (CompilerRegLoopSplitRewriteResult.Result
      (compiler-reg-loop-split-noop blocks vars)
      (ir.compiler-ir-label-none))
    (let
      [depths : (__tl_dyn-array i64) (compiler-reg-function-loop-depths blocks)]
      ;; Every candidate class (single-block self-loop/read-only, single-block
      ;; phi, multi-block phi-carried) and the refused-preheader splice lives
      ;; inside a natural loop. A function with no loop-depth above zero can
      ;; produce none of them, so skip the liveness fixpoint, interval build,
      ;; and coalesce map entirely for loop-free functions.
      (if (not (compiler-reg-depths-have-loop? depths 0))
        (CompilerRegLoopSplitRewriteResult.Result
          (compiler-reg-loop-split-noop blocks vars)
          (ir.compiler-ir-label-none))
        (let
          [liveness-handle : CompilerRegLivenessHandle
            (compiler-reg-liveness-handle-make func false)]
          (compiler-reg-loop-split-rewrite-fueled
            type-segment-bases
            target-abi
            func
            liveness-handle
            blocks
            vars
            type-info
            plan
            depths
            (compiler-reg-callee-saved-integer-register-count-for-abi
              target-abi)))))))

(define (compiler-reg-loop-split-rewrite-fueled
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [liveness-handle : CompilerRegLivenessHandle]
  [blocks : ir.CompilerIrBlockList]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [plan : CompilerRegPlan]
  [depths : (__tl_dyn-array i64)]
  [fuel : i64]) : CompilerRegLoopSplitRewriteResult
  (if (<= fuel 0)
    (CompilerRegLoopSplitRewriteResult.Result
      (compiler-reg-loop-split-noop blocks vars)
      (ir.compiler-ir-label-none))
    (let
      [liveness : live.CompilerFunctionLiveness liveness-handle.baseline]
      [selection : CompilerRegIntervalSelection
        (compiler-reg-live-interval-selection func liveness)]
      [assignments : CompilerRegAssignmentTable
        (compiler-reg-plan-assignments plan)]
      [group-vars : live.CompilerLiveI64Set
        (compiler-reg-function-group-vars type-segment-bases func type-info)]
      (match selection
        [(CompilerRegIntervalSelection.Selection _ intervals)
          (let
            [coalesce : CompilerRegCoalesceMap
              (compiler-reg-coalesce-map-build
                (compiler-reg-function-moves func false)
                intervals
                type-info
                group-vars
                vars
                (array.make-array i64 0))]
            [parents : (__tl_dyn-array i64) coalesce.parents]
            [merged-roots : live.CompilerLiveI64Set
              (compiler-reg-coalesce-merged-root-set coalesce)]
            (match liveness
              [(live.CompilerFunctionLiveness.Liveness _ live-blocks)
                (match (match (compiler-reg-loop-split-select-blocks
                  type-segment-bases
                  target-abi
                  func
                  blocks
                  liveness
                  live-blocks
                  depths
                  0
                  0
                  vars
                  type-info
                  assignments
                  intervals
                  group-vars
                  parents
                  merged-roots
                  (compiler-reg-function-spill-weights func))
                  ;; Step-2 fallback: when the single-block paths (read-only /
                  ;; non-phi self-loop / single-block phi) find nothing, try the
                  ;; MULTI-BLOCK phi-carried homing (the dominant 607 population).
                  ;; As a fallback it leaves every single-block decision -- and so
                  ;; all non-phi / read-only codegen -- byte-identical.
                  [(CompilerRegLoopSplitCandidate.NoCandidate)
                    (compiler-reg-loop-phi-mb-select
                      type-segment-bases
                      func
                      blocks
                      liveness
                      live-blocks
                      depths
                      vars
                      type-info
                      assignments
                      intervals
                      group-vars
                      parents
                      merged-roots
                      (compiler-reg-function-spill-weights func))]
                  [(CompilerRegLoopSplitCandidate.Candidate
                      sv
                      lbls
                      ty
                      reg
                      copies
                      ev)
                    (CompilerRegLoopSplitCandidate.Candidate
                      sv
                      lbls
                      ty
                      reg
                      copies
                      ev)])
                  [(CompilerRegLoopSplitCandidate.NoCandidate)
                    (CompilerRegLoopSplitRewriteResult.Result
                      (compiler-reg-loop-split-noop blocks vars)
                      (compiler-reg-loop-split-refused-select-blocks
                        type-segment-bases
                        func
                        blocks
                        liveness
                        live-blocks
                        depths
                        0
                        0
                        vars
                        type-info
                        assignments
                        intervals
                        group-vars
                        parents
                        merged-roots))]
                  [(CompilerRegLoopSplitCandidate.Candidate
                      stack-var
                      region-label
                      ty
                      reg
                      copies
                      evicted)
                    (let
                      [applied : CompilerRegCallSaveRewrite
                        (compiler-reg-loop-split-apply-candidate
                          blocks
                          vars
                          stack-var
                          region-label
                          ty
                          reg
                          copies
                          evicted
                          parents)]
                      (match applied
                        [(CompilerRegCallSaveRewrite.Rewrite
                            new-blocks
                            _
                            new-vars
                            split-assignments
                            split-types)
                          (match func
                            [(ir.CompilerIrFunction.Function
                                name
                                params
                                ret-ty
                                _
                                _)
                              (let
                                [new-func : ir.CompilerIrFunction
                                  (ir.CompilerIrFunction.Function
                                    name
                                    params
                                    ret-ty
                                    new-vars
                                    new-blocks)]
                                [new-plan : CompilerRegPlan
                                  (compiler-reg-plan-with-call-save-rewrite
                                    plan
                                    applied)]
                                [rest : CompilerRegLoopSplitRewriteResult
                                  (compiler-reg-loop-split-rewrite-fueled
                                    type-segment-bases
                                    target-abi
                                    new-func
                                    (compiler-reg-liveness-handle-make
                                      new-func
                                      false)
                                    new-blocks
                                    new-vars
                                    type-info
                                    new-plan
                                    (compiler-reg-function-loop-depths
                                      new-blocks)
                                    (- fuel 1))]
                                (match rest
                                  [(CompilerRegLoopSplitRewriteResult.Result
                                      rest-rewrite
                                      refused-header)
                                    (match rest-rewrite
                                      [(CompilerRegCallSaveRewrite.Rewrite
                                          final-blocks
                                          _
                                          final-vars
                                          rest-assignments
                                          rest-types)
                                        (CompilerRegLoopSplitRewriteResult.Result
                                          (CompilerRegCallSaveRewrite.Rewrite
                                            final-blocks
                                            vars
                                            final-vars
                                            ;; ROUND ORDER, NOT UNWIND ORDER
                                            ;; (#5927). Each fuel round rewrites
                                            ;; the PREVIOUS round's blocks, so the
                                            ;; rounds are a SEQUENCE of plan edits
                                            ;; and the last edit for a var must
                                            ;; win. This round contributes
                                            ;; `split-assignments`; the deeper
                                            ;; rounds contribute
                                            ;; `rest-assignments`, and merge's
                                            ;; FIRST argument overwrites the
                                            ;; second. Merging this round's edits
                                            ;; last resurrected an assignment a
                                            ;; LATER round had deliberately
                                            ;; overridden: the eviction pick
                                            ;; re-spills the single region
                                            ;; occupant of the register it takes,
                                            ;; and when that occupant is an
                                            ;; earlier round's own region var, the
                                            ;; re-spill was dropped and BOTH region
                                            ;; vars kept the same physical register
                                            ;; across the same loop -- the second
                                            ;; region var's preheader INTO copy
                                            ;; then clobbered the first's only def
                                            ;; (a loop bound reaching the back-edge
                                            ;; compare, silently miscompiled).
                                            ;; Deeper-round edits therefore go in
                                            ;; as `extra` so they win.
                                            (compiler-reg-assignment-table-merge
                                              rest-assignments
                                              split-assignments)
                                            ;; Types stay in unwind order: every
                                            ;; round types exactly one FRESH var
                                            ;; id, so no round ever overrides
                                            ;; another's entry and the merge
                                            ;; direction cannot change the map.
                                            (compiler-reg-var-types-merge
                                              split-types
                                              rest-types))
                                          refused-header)])]))])]))])]))]))))

;; ---------------------------------------------------------------------------
;; Scan for a loop block whose region rescue is REFUSED only because of a
;; critical entry edge, yet is otherwise homeable (all gates pass and a register
;; is free over the region). Returns that block's label (the header to splice a
;; preheader before) or "" if none. Mirrors select-blocks/select-var/try-var but
;; (a) does not skip phi-blocks and (b) acts on the EdgeCopyRefused branch.
;; ---------------------------------------------------------------------------
(define (compiler-reg-loop-split-refused-try-var
  [_func : ir.CompilerIrFunction]
  [liveness : live.CompilerFunctionLiveness]
  [region-label : i64]
  [block : live.CompilerLiveBlock]
  [instrs : ir.CompilerIrInstrSeq]
  [region-start : i64]
  [region-end : i64]
  ;; lint-allow: unused-variable
  [depth : i64]
  [candidate-regs : CompilerRegIdSeq]
  [vars : i64]
  [var : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : live.CompilerLiveI64Set]
  [parents : (__tl_dyn-array i64)]
  [merged-roots : live.CompilerLiveI64Set]) : i64
  (let
    ;; SplitKit step 2: phi-carried single-block self-loop refused only by a
    ;; critical ENTRY edge is unblocked by a dedicated preheader, just like the
    ;; read-only case below. Variable-bound loops (no provable >=1 trip) keep the
    ;; zero-trip pre-test, so entry->header is critical; a preheader gives the
    ;; once-per-loop INTO copy a non-critical edge. (Live-out values whose EXIT
    ;; edge is also critical still refuse at plan time -- not a preheader case.)
    [phi-carried? : bool
      (compiler-reg-loop-split-phi-carried-candidate?
        block
        region-label
        instrs
        var
        parents)]
    [members : live.CompilerLiveI64Set
      (if phi-carried?
        (compiler-reg-loop-split-group-member-set parents var vars)
        (live.compiler-live-set-empty))]
    (if (if phi-carried?
      (compiler-reg-interval-index-var-has-segments? intervals var)
      (and
        (live.compiler-live-set-contains?
          (live.compiler-live-block-live-in block)
          var)
        (live.compiler-live-set-contains?
          (live.compiler-live-block-live-out block)
          var)
        (not
          (live.compiler-live-set-contains?
            (live.compiler-live-block-defs block)
            var))
        (compiler-reg-interval-index-var-has-segments? intervals var)
        (not (compiler-reg-coalesce-var-nonsingleton? parents merged-roots var))))
      (match (compiler-reg-assignment-lookup assignments var)
        [(CompilerRegMaybeLocation.Some location)
          (match location
            [(CompilerRegLocation.Spill _)
              (match (compiler-reg-loop-split-type-ok? type-info group-vars var)
                [(CompilerRegMaybeType.Some ty)
                  (let
                    [labels : CompilerRegLabelSeq
                      (compiler-reg-label-seq-prepend
                        region-label
                        (compiler-reg-label-seq-empty))]
                    [region-intervals : CompilerRegIntervalSeq
                      (compiler-reg-loop-split-region-interval
                        vars
                        region-start
                        region-end)]
                    (match (if phi-carried?
                      (compiler-reg-edge-copy-plan-for-region-group-with-liveness
                        liveness
                        labels
                        var
                        vars
                        ty
                        members)
                      (compiler-reg-edge-copy-plan-for-region-with-liveness
                        liveness
                        labels
                        var
                        vars
                        ty))
                      ;; A plan (not refused) means the existing rounds already
                      ;; handle this var -- not a preheader case.
                      [(CompilerRegEdgeCopyPlan.Plan _)
                        (ir.compiler-ir-label-none)]
                      ;; Refused = critical entry edge. Homeable iff a register is
                      ;; free over the region; if so a preheader unblocks it.
                      [(CompilerRegEdgeCopyPlan.Refused _)
                        (match (compiler-reg-loop-split-first-register
                          candidate-regs
                          assignments
                          intervals
                          region-intervals
                          var)
                          [(CompilerRegMaybeId.Some _) region-label]
                          [(CompilerRegMaybeId.No) (ir.compiler-ir-label-none)])]))]
                [(CompilerRegMaybeType.No) (ir.compiler-ir-label-none)])]
            [_ (ir.compiler-ir-label-none)])]
        [(CompilerRegMaybeLocation.No) (ir.compiler-ir-label-none)])
      (ir.compiler-ir-label-none))))

(define (compiler-reg-loop-split-refused-select-var
  [func : ir.CompilerIrFunction]
  [liveness : live.CompilerFunctionLiveness]
  [region-label : i64]
  [block : live.CompilerLiveBlock]
  [instrs : ir.CompilerIrInstrSeq]
  [region-start : i64]
  [region-end : i64]
  [depth : i64]
  [candidate-regs : CompilerRegIdSeq]
  [vars : i64]
  [var : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : live.CompilerLiveI64Set]
  [parents : (__tl_dyn-array i64)]
  [merged-roots : live.CompilerLiveI64Set]) : i64
  (if (>= var vars)
    (ir.compiler-ir-label-none)
    (let
      [r : i64
        (compiler-reg-loop-split-refused-try-var
          func
          liveness
          region-label
          block
          instrs
          region-start
          region-end
          depth
          candidate-regs
          vars
          var
          type-info
          assignments
          intervals
          group-vars
          parents
          merged-roots)]
      (if (= r (ir.compiler-ir-label-none))
        (compiler-reg-loop-split-refused-select-var
          func
          liveness
          region-label
          block
          instrs
          region-start
          region-end
          depth
          candidate-regs
          vars
          (+ var 1)
          type-info
          assignments
          intervals
          group-vars
          parents
          merged-roots)
        r))))

(define (compiler-reg-loop-split-refused-select-blocks
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [blocks : ir.CompilerIrBlockList]
  [liveness : live.CompilerFunctionLiveness]
  [live-blocks : (__tl_dyn-array live.CompilerLiveBlock)]
  [depths : (__tl_dyn-array i64)]
  [point : i64]
  [block-index : i64]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : live.CompilerLiveI64Set]
  [parents : (__tl_dyn-array i64)]
  [merged-roots : live.CompilerLiveI64Set]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) (ir.compiler-ir-label-none)]
    [(ir.CompilerIrBlockList.Cons ir-block rest)
      (match ir-block
        [(ir.CompilerIrBlock.Block label instrs)
          (let
            [next-point : i64
              (+ point (* 2 (ir.compiler-ir-instr-seq-count instrs)))]
            [depth : i64
              (if (< block-index (array-length depths))
                (array-ref depths block-index)
                0)]
            [candidate-regs : CompilerRegIdSeq
              (compiler-reg-loop-split-candidate-regs
                (not (compiler-reg-loop-split-seq-has-call-or-syscall? instrs))
                (compiler-reg-loop-split-region-rcx-safe?
                  type-segment-bases
                  func
                  point
                  next-point)
                (compiler-reg-loop-split-region-rdx-safe?
                  type-segment-bases
                  func
                  point
                  next-point))]
            (if (and
              (< block-index (array-length live-blocks))
              (> depth 0)
              (compiler-reg-loop-split-succs-has-backedge?
                liveness
                block-index
                (compiler-reg-live-block-succs
                  (array-ref live-blocks block-index))))
              (let
                [r : i64
                  (compiler-reg-loop-split-refused-select-var
                    func
                    liveness
                    label
                    (array-ref live-blocks block-index)
                    instrs
                    point
                    next-point
                    depth
                    candidate-regs
                    vars
                    0
                    type-info
                    assignments
                    intervals
                    group-vars
                    parents
                    merged-roots)]
                (if (= r (ir.compiler-ir-label-none))
                  (compiler-reg-loop-split-refused-select-blocks
                    type-segment-bases
                    func
                    (__tl-box-place rest)
                    liveness
                    live-blocks
                    depths
                    next-point
                    (+ block-index 1)
                    vars
                    type-info
                    assignments
                    intervals
                    group-vars
                    parents
                    merged-roots)
                  r))
              (compiler-reg-loop-split-refused-select-blocks
                type-segment-bases
                func
                (__tl-box-place rest)
                liveness
                live-blocks
                depths
                next-point
                (+ block-index 1)
                vars
                type-info
                assignments
                intervals
                group-vars
                parents
                merged-roots)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (compiler-reg-loop-split-refused-select-blocks-seq
        type-segment-bases
        func
        seq
        liveness
        live-blocks
        depths
        point
        block-index
        vars
        type-info
        assignments
        intervals
        group-vars
        parents
        merged-roots)]))

(define (compiler-reg-loop-split-refused-select-blocks-seq
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [seq : ir.CompilerIrBlockSeq]
  [liveness : live.CompilerFunctionLiveness]
  [live-blocks : (__tl_dyn-array live.CompilerLiveBlock)]
  [depths : (__tl_dyn-array i64)]
  [point : i64]
  [block-index : i64]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : live.CompilerLiveI64Set]
  [parents : (__tl_dyn-array i64)]
  [merged-roots : live.CompilerLiveI64Set]) : i64
  (compiler-reg-loop-split-refused-select-blocks-seq-from
    type-segment-bases
    func
    seq
    liveness
    live-blocks
    depths
    point
    block-index
    vars
    type-info
    assignments
    intervals
    group-vars
    parents
    merged-roots
    0))

(define (compiler-reg-loop-split-refused-select-blocks-seq-from
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [seq : ir.CompilerIrBlockSeq]
  [liveness : live.CompilerFunctionLiveness]
  [live-blocks : (__tl_dyn-array live.CompilerLiveBlock)]
  [depths : (__tl_dyn-array i64)]
  [point : i64]
  [block-index : i64]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [assignments : CompilerRegAssignmentTable]
  [intervals : CompilerRegIntervalIndex]
  [group-vars : live.CompilerLiveI64Set]
  [parents : (__tl_dyn-array i64)]
  [merged-roots : live.CompilerLiveI64Set]
  [index : i64]) : i64
  (if (>= index (ir.compiler-ir-block-seq-count seq))
    (ir.compiler-ir-label-none)
    (match (ir.compiler-ir-block-seq-ref seq index)
      [(ir.CompilerIrBlock.Block label instrs)
        (let
          [next-point : i64
            (+ point (* 2 (ir.compiler-ir-instr-seq-count instrs)))]
          [depth : i64
            (if (< block-index (array-length depths))
              (array-ref depths block-index)
              0)]
          [candidate-regs : CompilerRegIdSeq
            (compiler-reg-loop-split-candidate-regs
              (not (compiler-reg-loop-split-seq-has-call-or-syscall? instrs))
              (compiler-reg-loop-split-region-rcx-safe?
                type-segment-bases
                func
                point
                next-point)
              (compiler-reg-loop-split-region-rdx-safe?
                type-segment-bases
                func
                point
                next-point))]
          (if (and
            (< block-index (array-length live-blocks))
            (> depth 0)
            (compiler-reg-loop-split-succs-has-backedge?
              liveness
              block-index
              (compiler-reg-live-block-succs
                (array-ref live-blocks block-index))))
            (let
              [r : i64
                (compiler-reg-loop-split-refused-select-var
                  func
                  liveness
                  label
                  (array-ref live-blocks block-index)
                  instrs
                  point
                  next-point
                  depth
                  candidate-regs
                  vars
                  0
                  type-info
                  assignments
                  intervals
                  group-vars
                  parents
                  merged-roots)]
              (if (= r (ir.compiler-ir-label-none))
                (compiler-reg-loop-split-refused-select-blocks-seq-from
                  type-segment-bases
                  func
                  seq
                  liveness
                  live-blocks
                  depths
                  next-point
                  (+ block-index 1)
                  vars
                  type-info
                  assignments
                  intervals
                  group-vars
                  parents
                  merged-roots
                  (+ index 1))
                r))
            (compiler-reg-loop-split-refused-select-blocks-seq-from
              type-segment-bases
              func
              seq
              liveness
              live-blocks
              depths
              next-point
              (+ block-index 1)
              vars
              type-info
              assignments
              intervals
              group-vars
              parents
              merged-roots
              (+ index 1))))])))

(define (compiler-reg-loop-split-max-rounds-for-abi
  [target-abi : cabi.CompilerRegTargetAbi]) : i64
  ;; Campaign: +6 for the caller-saved rescue rounds (r8/r9/rsi/rdi plus
  ;; guarded rcx/rdx) in
  ;; clobber-free regions; extra rounds stop early when no free candidate remains.
  (+ (compiler-reg-callee-saved-integer-register-count-for-abi target-abi) 6))

(define (compiler-reg-loop-split-rewrite-rounds
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [blocks : ir.CompilerIrBlockList]
  [in-vars : i64]
  [current-vars : i64]
  [plan : CompilerRegPlan]
  [extra-assignments : CompilerRegAssignmentTable]
  [extra-types : CompilerRegVarTypes]
  [rounds-left : i64]) : CompilerRegCallSaveRewrite
  (if (<= rounds-left 0)
    (CompilerRegCallSaveRewrite.Rewrite
      blocks
      in-vars
      current-vars
      extra-assignments
      extra-types)
    (let
      [round-plan : CompilerRegPlan
        (compiler-reg-plan-with-call-save-rewrite
          plan
          (CompilerRegCallSaveRewrite.Rewrite
            blocks
            in-vars
            current-vars
            extra-assignments
            extra-types))]
      [round-type-info : CompilerRegVarTypes
        (compiler-reg-function-var-types func)]
      (match (compiler-reg-loop-split-rewrite-one
        type-segment-bases
        target-abi
        func
        blocks
        current-vars
        round-type-info
        round-plan)
        [(CompilerRegLoopSplitRewriteResult.Result rewrite refused-header)
          (match rewrite
            [(CompilerRegCallSaveRewrite.Rewrite
                next-blocks
                _
                next-vars
                next-assignments
                next-types)
              (if (= next-vars current-vars)
                ;; No var homed this round. Before giving up, use the refused
                ;; preheader label found during the same liveness pass as the
                ;; candidate search.
                (if (= refused-header (ir.compiler-ir-label-none))
                  (CompilerRegCallSaveRewrite.Rewrite
                    blocks
                    in-vars
                    current-vars
                    extra-assignments
                    extra-types)
                  (let
                    [spliced : ir.CompilerIrBlockList
                      (compiler-reg-loop-split-splice-preheader
                        blocks
                        refused-header)]
                    (if (>
                      (ir.compiler-ir-block-list-count spliced)
                      (ir.compiler-ir-block-list-count blocks))
                      (match func
                        [(ir.CompilerIrFunction.Function name params ret-ty _ _)
                          (compiler-reg-loop-split-rewrite-rounds
                            type-segment-bases
                            target-abi
                            (ir.CompilerIrFunction.Function
                              name
                              params
                              ret-ty
                              current-vars
                              spliced)
                            spliced
                            in-vars
                            current-vars
                            plan
                            extra-assignments
                            extra-types
                            (- rounds-left 1))])
                      (CompilerRegCallSaveRewrite.Rewrite
                        blocks
                        in-vars
                        current-vars
                        extra-assignments
                        extra-types))))
                (match func
                  [(ir.CompilerIrFunction.Function name params ret-ty _ _)
                    (let
                      [merged-assignments : CompilerRegAssignmentTable
                        (compiler-reg-assignment-table-merge
                          next-assignments
                          extra-assignments)]
                      [merged-types : CompilerRegVarTypes
                        (compiler-reg-var-types-merge next-types extra-types)]
                      [next-func : ir.CompilerIrFunction
                        (ir.CompilerIrFunction.Function
                          name
                          params
                          ret-ty
                          next-vars
                          next-blocks)]
                      (compiler-reg-loop-split-rewrite-rounds
                        type-segment-bases
                        target-abi
                        next-func
                        next-blocks
                        in-vars
                        next-vars
                        plan
                        merged-assignments
                        merged-types
                        (- rounds-left 1)))]))])]))))

(define (compiler-reg-loop-split-rewrite-blocks
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [blocks : ir.CompilerIrBlockList]
  [vars : i64]
  [_type-info : CompilerRegVarTypes]
  [plan : CompilerRegPlan]) : CompilerRegCallSaveRewrite
  (compiler-reg-loop-split-rewrite-blocks-for-abi
    type-segment-bases
    cabi.CompilerRegTargetAbi.Linux
    func
    blocks
    vars
    _type-info
    plan))

(define (compiler-reg-loop-split-rewrite-blocks-for-abi
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [blocks : ir.CompilerIrBlockList]
  [vars : i64]
  [_type-info : CompilerRegVarTypes]
  [plan : CompilerRegPlan]) : CompilerRegCallSaveRewrite
  (compiler-reg-loop-split-rewrite-rounds
    type-segment-bases
    target-abi
    func
    blocks
    vars
    vars
    plan
    (compiler-reg-assignment-table-empty)
    (compiler-reg-var-types-empty)
    (compiler-reg-loop-split-max-rounds-for-abi target-abi)))

;; ---------------------------------------------------------------------------
;; M-G2b -- per-call-region split via the WIDENED caller-saved rescue.
;;
;; Gate autopsy of the pre-M-G2b rescue (fired 6/8,959 spilled call-spanning
;; roots): (1) it required %r9 free over the var's WHOLE hull -- a
;; call-spanning hull covers most of the function and %r9 is in the zero-call
;; scratch pool, so nearly every hull conflicted (the single biggest killer);
;; (2) `boundary-vars` excluded every var live across ANY block boundary,
;; i.e. every loop-carried value and every param -- the entire hot
;; population; (3) `calls == clobbers` rejected any hull containing a
;; div/shift; (4) `clobber-vars` rejected any var that is an argument or
;; result of ANY call; (5) the `refs > 2*calls+1` benefit gate charged every
;; call in the hull two boundary movs even where the value had no uses
;; between those calls.
;;
;; The widened design replaces whole-hull shadowing with PER-REGION homing:
;;   region  = maximal run of instrs inside ONE block containing no kind-0
;;             clobber (call/syscall/cpuid/xgetbv/...; div/shift are NOT
;;             boundaries because the shadow pool never contains
;;             rax/rdx/rcx, the only registers they clobber), trimmed to the
;;             first/last coalesce-class reference [lo,hi];
;;   select  = regions with >= 2 uses AND net memory-op win >= 2, where
;;             net = uses + defs - entry-reload - exit-store. The SplitKit-M5
;;             failure mode was boundary movs outweighing the win; this bound
;;             makes every accepted region profitable BY CONSTRUCTION, both
;;             statically and per loop iteration (a block-scoped region's
;;             boundary movs execute exactly as often as its uses);
;;   cap     = best 4 regions per root (net * loop-depth-weight score,
;;             preferring regions in loop bodies), 64 regions per function;
;;   reg     = first of %r8/%r9/%rsi/%rdi (SysV; %r8/%r9 on Win64 where
;;             rsi/rdi are callee-saved) whose segment-precise occupancy is
;;             free over ALL of the root's selected regions -- the same
;;             caller-saved subset the loop-split rescue proved safe for
;;             clobber-free regions (rax/rcx/rdx are fixed-use, r10/r11 are
;;             the emergency scavenger's preferred picks).
;; Boundary vars / params / multi-block values are ADMITTED: the home slot
;; stays the authoritative location at every region boundary (the entry
;; reload reads it; the exit store refreshes it before any code outside the
;; block can run -- the region is clobber-free straight-line code), which is
;; the old rescue's slot discipline generalized. The assignment table is NOT
;; modified: shadow roots stay CompilerRegSpill (their home slot lives on,
;; and the remat interlock keeps them remat-free); the backend caller-save
;; rewrite mints the register-homed segment vars from the region table.
;; ---------------------------------------------------------------------------
;; Per-region statistics row from the enumeration walk: var, lo, hi, uses,
;; defs, first-def (1 = the region's first class ref is a def whose instr
;; does not read the class -> no entry reload needed), loop depth, KIND.
;;
;; kind = compiler-reg-call-region-kind-block (0): one kind-0-clobber-free run
;; inside ONE block. Its entry reload sits at `lo`, INSIDE the region, so both
;; the reload and the uses it serves run the same number of times; the win is
;; purely static (refs minus boundary movs) and the loop depth scales the whole
;; net equally.
;;
;; kind = compiler-reg-call-region-kind-loop (1): a whole natural loop
;; [h..loop-ends[h]], anchored at the LAST instruction of the layout
;; predecessor h-1 (its preheader). The entry reload runs ONCE per loop entry
;; while every use runs once per iteration, so the two sides sit at different
;; frequencies and the score must weight them separately -- that asymmetry, not
;; the extra span, is what makes a one-use-per-iteration loop invariant
;; (liveness_storage's spilled bound, reloaded ~25M times) profitable at all.
(defenum CompilerRegCallRegionStat
  (CompilerRegCallRegionStat i64 i64 i64 i64 i64 i64 i64 i64))

(define (compiler-reg-call-region-kind-block) : i64
  0)

(define (compiler-reg-call-region-kind-loop) : i64
  1)

;; Candidate grades; see compiler-reg-call-region-mark-candidates.
(define (compiler-reg-call-region-cand-full) : i64
  1)

(define (compiler-reg-call-region-cand-loop) : i64
  2)

(define (compiler-reg-call-region-stat-kind [stat : CompilerRegCallRegionStat]) : i64
  (match stat
    [(CompilerRegCallRegionStat _ _ _ _ _ _ _ kind) kind]))

;; One bucket of candidate rows in FLUSH order; the picker walks it back to
;; front, which is the order the former prepend-built cons bucket presented.
(defstruct CompilerRegCallRegionStatSeq
  (slots (__tl_dyn-array CompilerRegCallRegionStat))
  (len i64))

(defenum CompilerRegCallRegionMaybeStat
  (CompilerRegCallRegionNoStat)
  (CompilerRegCallRegionSomeStat CompilerRegCallRegionStat))

;; Region boundary = kind-0 clobber (all caller-saved registers die). This
;; matches the greedy's kind-0 classification exactly: div/shift BinOps are
;; kind-1/2 (rax:rdx / rcx only) and NOT boundaries; BoundsCheck/Pack are not
;; clobber points at all (compiler-reg-backend-clobber-point-instr? type-segment-bases excludes
;; them).
(define (compiler-reg-call-region-boundary-instr?
  [type-segment-bases : i64]
  [instr : ir.CompilerIrInstr]) : bool
  (match instr
    [(ir.CompilerIrInstr.BinOp _ _ _ _ _) false]
    [_ (compiler-reg-backend-clobber-point-instr? type-segment-bases instr)]))

;; Shadow register pool: caller-saved registers with NO fixed-use hazard
;; inside a kind-0-free region. Unlike loop-split's guarded rcx/rdx widening,
;; call-region shadows keep the stable r8/r9/rsi/rdi subset: rax/rcx/rdx carry
;; div/shift/return fixed uses, r10/r11 are the emergency scavenger's default
;; picks. %rsi/%rdi are callee-saved homes on Win64, so shadows there stay on
;; the two common caller-saved registers.
(define (compiler-reg-call-region-pool [target-abi : cabi.CompilerRegTargetAbi]) : (__tl_dyn-array
    i64)
  (match target-abi
    [(cabi.CompilerRegTargetAbi.Linux)
      (make-array
        (cast cabi.compiler-reg-id-r8 : i64)
        cabi.compiler-reg-id-r9
        cabi.compiler-reg-id-rsi
        cabi.compiler-reg-id-rdi)]
    [(cabi.CompilerRegTargetAbi.Windows)
      (make-array (cast cabi.compiler-reg-id-r8 : i64) cabi.compiler-reg-id-r9)]))

;; Loop-scoped shadow pool: CALLEE-saved registers only, and only the ones the
;; plan already homes a value in.
;;
;; Two independent reasons, both load-bearing:
;;
;;   * FREE OF CHARGE. compiler-backend-callee-needs-save? saves a callee-saved
;;     register iff the plan homes a value there, so a register already in that
;;     set costs no extra push/pop when the shadow joins it. A register outside
;;     it would add a prologue/epilogue pair for one loop, which is exactly the
;;     trade the leaf-CSR-fuse path exists to undo. So the pool is intersected
;;     with the plan's live register set at selection time.
;;
;;   * IMMUNE TO THE NON-CALL CLOBBERS. A loop region spans whole blocks, so it
;;     can contain div/shift BinOps, CopyBytes (`rep movs` -- rsi/rdi/rcx) and
;;     Pack/BoundsCheck scavenge picks, none of which the region-splitting
;;     boundary predicate treats as a boundary. Every one of those touches only
;;     caller-saved registers, so a callee-saved home needs no extra proof
;;     beyond the occupancy scan. rsi/rdi/rbp are filtered out because rsi/rdi
;;     ARE callee-saved on Win64 yet are exactly the registers `rep movs`
;;     clobbers, and rbp can be a frame pointer.
(define (compiler-reg-call-region-loop-pool-reg-ok? [reg : i64]) : bool
  (not
    (or
      (= reg cabi.compiler-reg-id-rsi)
      (= reg cabi.compiler-reg-id-rdi)
      (= reg cabi.compiler-reg-id-rbp))))

;; Is `reg` homed by the plan for some var? (the prologue-save proxy above)
(define (compiler-reg-call-region-reg-in-plan?
  [present : (__tl_dyn-array i64)]
  [items : (__tl_dyn-array CompilerRegLocation)]
  [n : i64]
  [reg : i64]) : bool
  (let
    [v : i64 0]
    (begin
      (while (< v n)
        (begin
          (when
            (= (array-ref present v) 1)
            (match (array-ref items v)
              [(CompilerRegLocation.Register r) (when (= r reg) (return true))]
              [(CompilerRegLocation.RegisterPair r0 r1)
                (when (or (= r0 reg) (= r1 reg)) (return true))]
              [_ unit]))
          (set! v (+ v 1))))
      false)))

;; The base pool followed by the loop-scoped tail. Loop rows search the whole
;; array; block rows stop at the base count, so every block-only root picks
;; bit-for-bit the register it always did. Keeping ONE array (rather than two
;; pools) matters for the occupancy index: pool-index-of then covers the tail
;; too, so a callee-saved occupant is seen by the conflict scan.
(define (compiler-reg-call-region-pool-with-loop-tail
  [base : (__tl_dyn-array i64)]
  [target-abi : cabi.CompilerRegTargetAbi]
  [present : (__tl_dyn-array i64)]
  [items : (__tl_dyn-array CompilerRegLocation)]
  [n : i64]) : (__tl_dyn-array i64)
  (let
    [csr-count : i64
      (cabi.compiler-abi-callee-saved-gp-register-count target-abi)]
    [keep : (__tl_dyn-array i64)
      (array.make-array
        i64
        (if (< csr-count 1)
          1
          csr-count))]
    [keep-n : i64 0]
    [base-count : i64 (array-length base)]
    [i : i64 0]
    (begin
      (while (< i csr-count)
        (let
          [r : i64 (cabi.compiler-abi-callee-saved-gp-register-id target-abi i)]
          (begin
            (if (and
              (not (= r cabi.compiler-reg-id-invalid))
              (compiler-reg-call-region-loop-pool-reg-ok? r)
              (< (compiler-reg-call-region-pool-index-of base r) 0)
              (compiler-reg-call-region-reg-in-plan? present items n r))
              (begin
                (set! (array-ref keep keep-n) r)
                (set! keep-n (+ keep-n 1)))
              unit)
            (set! i (+ i 1)))))
      (let
        [out : (__tl_dyn-array i64)
          (array.make-array i64 (+ base-count keep-n))]
        [j : i64 0]
        (begin
          (while (< j base-count)
            (begin
              (set! (array-ref out j) (array-ref base j))
              (set! j (+ j 1))))
          (set! j 0)
          (while (< j keep-n)
            (begin
              (set! (array-ref out (+ base-count j)) (array-ref keep j))
              (set! j (+ j 1))))
          out)))))

;; Size guards: at most 4 realized regions per root and 64 per function
;; (bounds the minted segment vars and the rewrite work).
(define (compiler-reg-call-region-root-cap) : i64
  4)

(define (compiler-reg-call-region-function-cap) : i64
  64)

;; ---------------------------------------------------------------------------
;; Cycle 26: property-based dominating early-return shrink wrapping.
;;
;; Discover a frame-free entry region made of compare+branch blocks over
;; incoming parameters/literals. Safe returns are cloned onto the initial bare
;; path, all other exits must share one saving frontier, and every framed edge
;; back into the region targets a framed clone. This is independent of source
;; name, parameter count/types, return type, total block count, and body shape.
(define (compiler-reg-early-exit-value-safe?
  [params : live.CompilerLiveI64Set]
  [value : ir.CompilerIrValue]) : bool
  (match value
    [(ir.CompilerIrValue.Var var) (live.compiler-live-set-contains? params var)]
    [(ir.CompilerIrValue.I64 _) true]
    [(ir.CompilerIrValue.F64 _) true]
    [(ir.CompilerIrValue.Bool _) true]
    [(ir.CompilerIrValue.Char _) true]
    [(ir.CompilerIrValue.Unit) true]
    [_ false]))

(define (compiler-reg-early-exit-return-block?
  [params : live.CompilerLiveI64Set]
  [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (and
        (= (ir.compiler-ir-instr-seq-count instrs) 1)
        (match (ir.compiler-ir-instr-seq-ref instrs 0)
          [(ir.CompilerIrInstr.Return maybe)
            (match maybe
              [(ir.CompilerIrMaybeValue.No) true]
              [(ir.CompilerIrMaybeValue.Some value)
                (compiler-reg-early-exit-value-safe? params value)])]
          [_ false]))]))

(define (compiler-reg-early-exit-guard-block?
  [params : live.CompilerLiveI64Set]
  [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (and
        (= (ir.compiler-ir-instr-seq-count instrs) 2)
        (match (ir.compiler-ir-instr-seq-ref instrs 0)
          [(ir.CompilerIrInstr.BinOp dst op lhs rhs ty)
            (and
              (compiler-reg-scratch-compare-op? op)
              ;; The shrink-wrap prefix renderer currently uses the integer
              ;; compare emitter.  XMM-homed operands would reach its GP-only
              ;; register sizing path, so floating guards are not admissible.
              (not (compiler-reg-float-type? ty))
              (compiler-reg-early-exit-value-safe? params lhs)
              (compiler-reg-early-exit-value-safe? params rhs)
              (match (ir.compiler-ir-instr-scalar-fact
                (ir.compiler-ir-instr-seq-ref instrs 1))
                [(ir.CompilerIrInstrScalarFact.Branch cond _ _)
                  (match cond
                    [(ir.CompilerIrValue.Var cond-var) (= cond-var dst)]
                    [_ false])]
                [_ false]))]
          [_ false]))]))

(define (compiler-reg-early-exit-framed-label [label : i64]) : i64
  (ir.compiler-ir-label
    (str_cat.str-cat (ir.compiler-ir-label-text label) "__shrinkwrap_framed")))

(define (compiler-reg-early-exit-bare-label-at
  [prefix : String]
  [states : (__tl_dyn-array i64)]
  [index : i64]) : i64
  (let
    [i : i64 0]
    [ordinal : i64 0]
    (begin
      (while (< i index)
        (begin
          (if (= (array-ref states i) 2)
            (set! ordinal (+ ordinal 1))
            unit)
          (set! i (+ i 1))))
      (ir.compiler-ir-label
        (str_cat.str-cat prefix (string.int->string ordinal))))))

;; mode 0 is the initial prefix, 1 is the ordinary body, and 2 is a framed
;; guard clone. Only terminators change, preserving all variable identities.
(define (compiler-reg-early-exit-target
  [seq : ir.CompilerIrBlockSeq]
  [states : (__tl_dyn-array i64)]
  [target : i64]
  [mode : i64]
  [saving-label : i64]
  [bare-prefix : String]) : i64
  (let
    [index : i64 (compiler-reg-cold-call-find-label seq target)]
    (if (< index 0)
      target
      (let
        [state : i64 (array-ref states index)]
        (cond
          [(= mode 0)
            (cond
              [(= state 1) target]
              [(= state 2)
                (compiler-reg-early-exit-bare-label-at bare-prefix states index)]
              [else saving-label])]
          [(= mode 1)
            (if (= state 1)
              (compiler-reg-early-exit-framed-label target)
              target)]
          [else
            (if (= state 1)
              (compiler-reg-early-exit-framed-label target)
              target)])))))

(define (compiler-reg-early-exit-rewrite-block
  [seq : ir.CompilerIrBlockSeq]
  [states : (__tl_dyn-array i64)]
  [block : ir.CompilerIrBlock]
  [mode : i64]
  [saving-label : i64]
  [bare-prefix : String]) : ir.CompilerIrBlock
  (match block
    [(ir.CompilerIrBlock.Block label instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (if (<= count 0)
          block
          (let
            [last : ir.CompilerIrInstr
              (ir.compiler-ir-instr-seq-ref instrs (- count 1))]
            [replacement : ir.CompilerIrInstr
              (match last
                [(ir.CompilerIrInstr.Jump target)
                  (ir.CompilerIrInstr.Jump
                    (compiler-reg-early-exit-target
                      seq
                      states
                      target
                      mode
                      saving-label
                      bare-prefix))]
                [(ir.CompilerIrInstr.Branch cond on-true on-false)
                  (ir.CompilerIrInstr.Branch
                    cond
                    (compiler-reg-early-exit-target
                      seq
                      states
                      on-true
                      mode
                      saving-label
                      bare-prefix)
                    (compiler-reg-early-exit-target
                      seq
                      states
                      on-false
                      mode
                      saving-label
                      bare-prefix))]
                [(ir.CompilerIrInstr.TotalEnumBranch cond on-true on-false)
                  (ir.CompilerIrInstr.TotalEnumBranch
                    cond
                    (compiler-reg-early-exit-target
                      seq
                      states
                      on-true
                      mode
                      saving-label
                      bare-prefix)
                    (compiler-reg-early-exit-target
                      seq
                      states
                      on-false
                      mode
                      saving-label
                      bare-prefix))]
                [_ last])]
            [out : (__tl_dyn-array ir.CompilerIrInstr)
              (array.make-array ir.CompilerIrInstr count)]
            [i : i64 0]
            (begin
              (while (< i count)
                (begin
                  (set!
                    (array-ref out i)
                    (if (= i (- count 1))
                      replacement
                      (ir.compiler-ir-instr-seq-ref instrs i)))
                  (set! i (+ i 1))))
              (ir.CompilerIrBlock.Block label (ir.CompilerIrInstrSeq out count))))))]))

(define (compiler-reg-early-exit-frontier-phi?
  [seq : ir.CompilerIrBlockSeq]
  [index : i64]) : bool
  (if (< index 0)
    true
    (match (ir.compiler-ir-block-seq-ref seq index)
      [(ir.CompilerIrBlock.Block _ instrs)
        (and
          (> (ir.compiler-ir-instr-seq-count instrs) 0)
          (match (ir.compiler-ir-instr-seq-ref instrs 0)
            [(ir.CompilerIrInstr.Phi _ _ _) true]
            [_ false]))])))

(define (compiler-reg-early-exit-target-is-guard?
  [seq : ir.CompilerIrBlockSeq]
  [states : (__tl_dyn-array i64)]
  [target : i64]) : bool
  (let
    [index : i64 (compiler-reg-cold-call-find-label seq target)]
    (and (>= index 0) (= (array-ref states index) 1))))

;; Framed guard clones are needed only for real body/back edges.  An acyclic
;; entry guard reaches the saving frontier once and is never revisited, so a
;; clone would be unreachable and would disrupt the body's natural fallthrough
;; into its return block.  If any outside edge re-enters the guard region, clone
;; the whole region: internal guard edges can then remain structurally identical
;; on the framed path, including multi-block chains.
(define (compiler-reg-early-exit-needs-framed-clones?
  [seq : ir.CompilerIrBlockSeq]
  [states : (__tl_dyn-array i64)]) : bool
  (let
    [i : i64 0]
    [found : bool false]
    (begin
      (while (and (not found) (< i (ir.compiler-ir-block-seq-count seq)))
        (begin
          (if (not (= (array-ref states i) 1))
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (let
                  [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
                  (if (> count 0)
                    (match (ir.compiler-ir-instr-scalar-fact
                      (ir.compiler-ir-instr-seq-ref instrs (- count 1)))
                      [(ir.CompilerIrInstrScalarFact.Jump target)
                        (if (compiler-reg-early-exit-target-is-guard?
                          seq
                          states
                          target)
                          (set! found true)
                          unit)]
                      [(ir.CompilerIrInstrScalarFact.Branch _ on-true on-false)
                        (if (or
                          (compiler-reg-early-exit-target-is-guard?
                            seq
                            states
                            on-true)
                          (compiler-reg-early-exit-target-is-guard?
                            seq
                            states
                            on-false))
                          (set! found true)
                          unit)]
                      [_ unit])
                    unit))])
            unit)
          (set! i (+ i 1))))
      found)))

(define (compiler-reg-early-exit-label-collision?
  [seq : ir.CompilerIrBlockSeq]
  [states : (__tl_dyn-array i64)]
  [saving-label : i64]
  [bare-prefix : String]) : bool
  (let
    [i : i64 0]
    [collision : bool false]
    (begin
      (while (and (not collision) (< i (ir.compiler-ir-block-seq-count seq)))
        (match (ir.compiler-ir-block-seq-ref seq i)
          [(ir.CompilerIrBlock.Block label _)
            (begin
              (if (or
                (= label saving-label)
                (compiler-reg-string-prefix?
                  (ir.compiler-ir-label-text label)
                  bare-prefix))
                (set! collision true)
                unit)
              (if (and
                (not collision)
                (= (array-ref states i) 1)
                (>=
                  (compiler-reg-cold-call-find-label
                    seq
                    (compiler-reg-early-exit-framed-label label))
                  0))
                (set! collision true)
                unit)
              (if (and
                (not collision)
                (= (array-ref states i) 2)
                (>=
                  (compiler-reg-cold-call-find-label
                    seq
                    (compiler-reg-early-exit-bare-label-at bare-prefix states i))
                  0))
                (set! collision true)
                unit))])
        (set! i (+ i 1)))
      collision)))

(define (compiler-reg-early-exit-shrinkwrap-function
  [func : ir.CompilerIrFunction]) : ir.CompilerIrFunction
  (begin
    (set! compiler-reg-early-exit-saving-label (ir.compiler-ir-label-none))
    (set! compiler-reg-early-exit-bare-label "")
    (set! compiler-reg-early-exit-prefix-count 0)
    (match func
      [(ir.CompilerIrFunction.Function name params ret-ty vars blocks)
        (let
          [seq : ir.CompilerIrBlockSeq
            (live.compiler-live-ir-block-list-to-seq blocks)]
          [count : i64 (ir.compiler-ir-block-seq-count seq)]
          [param-vars : live.CompilerLiveI64Set
            (compiler-reg-ineligible-params
              params
              (live.compiler-live-set-empty))]
          (if (or
            (<= count 0)
            (not
              (compiler-reg-early-exit-guard-block?
                param-vars
                (ir.compiler-ir-block-seq-ref seq 0))))
            func
            (let
              [states : (__tl_dyn-array i64) (array.make-array i64 count)]
              [fruitful : (__tl_dyn-array i64) (array.make-array i64 count)]
              [queue : (__tl_dyn-array i64) (array.make-array i64 count)]
              [head : i64 0]
              [tail : i64 0]
              [scan : i64 0]
              [changed : bool true]
              [valid : bool true]
              [return-count : i64 0]
              [frontier-index : i64 (- 0 1)]
              [guard-count : i64 0]
              (begin
                ;; A cheap comparison belongs to the prefix only when some path
                ;; through cheap comparisons reaches a bare return. This prevents
                ;; greedily absorbing a compare whose two successors are distinct
                ;; framed frontiers (the common loop-entry guard after an early
                ;; return) while retaining real multi-block guard chains.
                (while (< scan count)
                  (begin
                    (if (compiler-reg-early-exit-return-block?
                      param-vars
                      (ir.compiler-ir-block-seq-ref seq scan))
                      (set! (array-ref fruitful scan) 1)
                      unit)
                    (set! scan (+ scan 1))))
                (while changed
                  (begin
                    (set! changed false)
                    (set! scan 0)
                    (while (< scan count)
                      (begin
                        (if (and
                          (= (array-ref fruitful scan) 0)
                          (compiler-reg-early-exit-guard-block?
                            param-vars
                            (ir.compiler-ir-block-seq-ref seq scan)))
                          (match (ir.compiler-ir-block-seq-ref seq scan)
                            [(ir.CompilerIrBlock.Block _ instrs)
                              (match (ir.compiler-ir-instr-scalar-fact
                                (ir.compiler-ir-instr-seq-ref instrs 1))
                                [(ir.CompilerIrInstrScalarFact.Branch
                                    _
                                    on-true
                                    on-false)
                                  (let
                                    [true-index : i64
                                      (compiler-reg-cold-call-find-label
                                        seq
                                        on-true)]
                                    [false-index : i64
                                      (compiler-reg-cold-call-find-label
                                        seq
                                        on-false)]
                                    (if (or
                                      (and
                                        (>= true-index 0)
                                        (= (array-ref fruitful true-index) 1))
                                      (and
                                        (>= false-index 0)
                                        (= (array-ref fruitful false-index) 1)))
                                      (begin
                                        (set! (array-ref fruitful scan) 1)
                                        (set! changed true))
                                      unit))]
                                [_ unit])])
                          unit)
                        (set! scan (+ scan 1))))))
                (if (and valid (= (array-ref fruitful 0) 1))
                  (begin
                    (set! (array-ref states 0) 1)
                    (set! (array-ref queue 0) 0)
                    (set! tail 1))
                  (set! valid false))
                ;; Discover the maximal safe region. Non-safe successors form the
                ;; saving frontier and therefore must all name the same block.
                (while (and valid (< head tail))
                  (let
                    [index : i64 (array-ref queue head)]
                    (begin
                      (set! head (+ head 1))
                      (match (ir.compiler-ir-block-seq-ref seq index)
                        [(ir.CompilerIrBlock.Block _ instrs)
                          (match (ir.compiler-ir-instr-scalar-fact
                            (ir.compiler-ir-instr-seq-ref instrs 1))
                            [(ir.CompilerIrInstrScalarFact.Branch
                                _
                                on-true
                                on-false)
                              (let
                                [side : i64 0]
                                (while (and valid (< side 2))
                                  (let
                                    [target : i64
                                      (if (= side 0)
                                        on-true
                                        on-false)]
                                    [target-index : i64
                                      (compiler-reg-cold-call-find-label
                                        seq
                                        target)]
                                    (begin
                                      (cond
                                        [(< target-index 0) (set! valid false)]
                                        [(and
                                            (=
                                              (array-ref fruitful target-index)
                                              1)
                                            (compiler-reg-early-exit-guard-block?
                                              param-vars
                                              (ir.compiler-ir-block-seq-ref
                                                seq
                                                target-index)))
                                          (if (=
                                            (array-ref states target-index)
                                            0)
                                            (begin
                                              (set!
                                                (array-ref states target-index)
                                                1)
                                              (set!
                                                (array-ref queue tail)
                                                target-index)
                                              (set! tail (+ tail 1)))
                                            unit)]
                                        [(compiler-reg-early-exit-return-block?
                                            param-vars
                                            (ir.compiler-ir-block-seq-ref
                                              seq
                                              target-index))
                                          (if (=
                                            (array-ref states target-index)
                                            0)
                                            (begin
                                              (set!
                                                (array-ref states target-index)
                                                2)
                                              (set!
                                                return-count
                                                (+ return-count 1)))
                                            unit)]
                                        [(< frontier-index 0)
                                          (begin
                                            (set! frontier-index target-index)
                                            (set!
                                              (array-ref states target-index)
                                              3))]
                                        [(not (= frontier-index target-index))
                                          (set! valid false)]
                                        [else unit])
                                      (set! side (+ side 1))))))]
                            [_ (set! valid false)])]))))
                (set! guard-count tail)
                (if (or
                  (not valid)
                  (<= return-count 0)
                  (< frontier-index 0)
                  (compiler-reg-early-exit-frontier-phi? seq frontier-index))
                  func
                  (match (ir.compiler-ir-block-seq-ref seq 0)
                    [(ir.CompilerIrBlock.Block entry-label _)
                      (let
                        [saving-label : i64
                          (ir.compiler-ir-label
                            (str_cat.str-cat
                              (ir.compiler-ir-label-text entry-label)
                              "__shrinkwrap_save"))]
                        [bare-prefix : String
                          (str_cat.str-cat
                            (ir.compiler-ir-label-text entry-label)
                            "__shrinkwrap_bare")]
                        [framed-count : i64
                          (if (compiler-reg-early-exit-needs-framed-clones?
                            seq
                            states)
                            guard-count
                            0)]
                        [out-count : i64
                          (+ (+ count return-count) (+ framed-count 1))]
                        [out : (__tl_dyn-array ir.CompilerIrBlock)
                          (array.make-array ir.CompilerIrBlock out-count)]
                        [out-index : i64 0]
                        [i : i64 0]
                        [save-instrs : (__tl_dyn-array ir.CompilerIrInstr)
                          (array.make-array ir.CompilerIrInstr 1)]
                        (if (compiler-reg-early-exit-label-collision?
                          seq
                          states
                          saving-label
                          bare-prefix)
                          func
                          (begin
                            ;; Initial guard prefix.
                            (while (< i count)
                              (begin
                                (if (= (array-ref states i) 1)
                                  (begin
                                    (set!
                                      (array-ref out out-index)
                                      (compiler-reg-early-exit-rewrite-block
                                        seq
                                        states
                                        (ir.compiler-ir-block-seq-ref seq i)
                                        0
                                        saving-label
                                        bare-prefix))
                                    (set! out-index (+ out-index 1)))
                                  unit)
                                (set! i (+ i 1))))
                            ;; Bare-return clones remain contiguous with the prefix.
                            (set! i 0)
                            (while (< i count)
                              (begin
                                (if (= (array-ref states i) 2)
                                  (match (ir.compiler-ir-block-seq-ref seq i)
                                    [(ir.CompilerIrBlock.Block _ instrs)
                                      (begin
                                        (set!
                                          (array-ref out out-index)
                                          (ir.CompilerIrBlock.Block
                                            (compiler-reg-early-exit-bare-label-at
                                              bare-prefix
                                              states
                                              i)
                                            instrs))
                                        (set! out-index (+ out-index 1)))])
                                  unit)
                                (set! i (+ i 1))))
                            (set!
                              (array-ref save-instrs 0)
                              (ir.CompilerIrInstr.Jump
                                (compiler-reg-cold-call-block-label
                                  (ir.compiler-ir-block-seq-ref
                                    seq
                                    frontier-index))))
                            (set!
                              (array-ref out out-index)
                              (ir.CompilerIrBlock.Block
                                saving-label
                                (ir.CompilerIrInstrSeq save-instrs 1)))
                            (set! out-index (+ out-index 1))
                            ;; Original framed body blocks, with backedges redirected.
                            ;; Keep the return blocks until after the framed guard
                            ;; clones.  This preserves the useful body -> guard ->
                            ;; return fallthrough chain instead of adding a jump on
                            ;; every loop iteration (the C21 layout property, now
                            ;; applied to every admitted CFG).
                            (set! i 0)
                            (while (< i count)
                              (begin
                                (if (and
                                  (not (= (array-ref states i) 1))
                                  (not (= (array-ref states i) 2)))
                                  (begin
                                    (set!
                                      (array-ref out out-index)
                                      (compiler-reg-early-exit-rewrite-block
                                        seq
                                        states
                                        (ir.compiler-ir-block-seq-ref seq i)
                                        1
                                        saving-label
                                        bare-prefix))
                                    (set! out-index (+ out-index 1)))
                                  unit)
                                (set! i (+ i 1))))
                            ;; Framed clones preserve ordinary return/epilogue edges.
                            (set! i 0)
                            (while (< i count)
                              (begin
                                (if (and
                                  (> framed-count 0)
                                  (= (array-ref states i) 1))
                                  (match (compiler-reg-early-exit-rewrite-block
                                    seq
                                    states
                                    (ir.compiler-ir-block-seq-ref seq i)
                                    2
                                    saving-label
                                    bare-prefix)
                                    [(ir.CompilerIrBlock.Block label instrs)
                                      (begin
                                        (set!
                                          (array-ref out out-index)
                                          (ir.CompilerIrBlock.Block
                                            (compiler-reg-early-exit-framed-label
                                              label)
                                            instrs))
                                        (set! out-index (+ out-index 1)))])
                                  unit)
                                (set! i (+ i 1))))
                            ;; The framed copies of bare-path returns retain their
                            ;; original labels and therefore still use the ordinary
                            ;; shared epilogue after the saving edge.
                            (set! i 0)
                            (while (< i count)
                              (begin
                                (if (= (array-ref states i) 2)
                                  (begin
                                    (set!
                                      (array-ref out out-index)
                                      (compiler-reg-early-exit-rewrite-block
                                        seq
                                        states
                                        (ir.compiler-ir-block-seq-ref seq i)
                                        1
                                        saving-label
                                        bare-prefix))
                                    (set! out-index (+ out-index 1)))
                                  unit)
                                (set! i (+ i 1))))
                            (set!
                              compiler-reg-early-exit-saving-label
                              saving-label)
                            (set!
                              compiler-reg-early-exit-bare-label
                              bare-prefix)
                            (set!
                              compiler-reg-early-exit-prefix-count
                              (+ guard-count return-count))
                            (ir.CompilerIrFunction.Function
                              name
                              params
                              ret-ty
                              vars
                              (ir.CompilerIrBlockList.Array
                                (ir.CompilerIrBlockSeq out out-count))))))]))))))])))

;; ---------------------------------------------------------------------------
;; Cycle 20: cold-call clobber splitting.
;;
;; The backend's Windows unwind program describes a fixed entry prologue, so
;; sinking nonvolatile pushes into arbitrary body blocks is not a portable
;; first shrink-wrap form.  Instead, recognize one deliberately narrow CFG
;; shape and make the call clobber disappear from GP allocation:
;;
;;   * exactly one kind-0 clobber in the function;
;;   * that clobber is the sole instruction before a jump in a side block;
;;   * the jump has a bypass predecessor and leads toward a real loop;
;;   * two to twelve ordinary GP values are live through the call.
;;
;; Each live-through value V gets a stack-only carrier S.  The cold block is
;; rewritten to `S <- V; call; V <- S; jump`.  The scalar allocator then ignores
;; this one GP call-mask point: V has been killed before the call and redefined
;; after it, while S is forced to memory.  The no-call edge retains V in its
;; caller-saved home and executes no boundary copies.  Float/vector call masks
;; are intentionally unchanged.
;; ---------------------------------------------------------------------------
(define (compiler-reg-cold-call-clobber-count-seq
  [type-segment-bases : i64]
  [instrs : ir.CompilerIrInstrSeq]) : i64
  (let
    [i : i64 0]
    [count : i64 0]
    (begin
      (while (< i (ir.compiler-ir-instr-seq-count instrs))
        (begin
          (if (compiler-reg-call-region-boundary-instr?
            type-segment-bases
            (ir.compiler-ir-instr-seq-ref instrs i))
            (set! count (+ count 1))
            unit)
          (set! i (+ i 1))))
      count)))

(define (compiler-reg-cold-call-find-candidate
  [type-segment-bases : i64]
  [seq : ir.CompilerIrBlockSeq]) : CompilerRegColdCallCandidate
  (let
    [b : i64 0]
    [clobbers : i64 0]
    [candidate : i64 (- 0 1)]
    [join : i64 (ir.compiler-ir-label-none)]
    (begin
      (while (< b (ir.compiler-ir-block-seq-count seq))
        (begin
          (match (ir.compiler-ir-block-seq-ref seq b)
            [(ir.CompilerIrBlock.Block _ instrs)
              (begin
                (set!
                  clobbers
                  (+
                    clobbers
                    (compiler-reg-cold-call-clobber-count-seq
                      type-segment-bases
                      instrs)))
                (if (= (ir.compiler-ir-instr-seq-count instrs) 2)
                  (match (ir.compiler-ir-instr-seq-ref instrs 0)
                    [(ir.CompilerIrInstr.Call _ _ _ _)
                      (match (ir.compiler-ir-instr-seq-ref instrs 1)
                        [(ir.CompilerIrInstr.Jump target)
                          (if (= candidate (- 0 1))
                            (begin
                              (set! candidate b)
                              (set! join target))
                            (set! candidate (- 0 2)))]
                        [_ unit])]
                    [_ unit])
                  unit))])
          (set! b (+ b 1))))
      (if (and (= clobbers 1) (>= candidate 0))
        (CompilerRegColdCallCandidate.Candidate candidate join)
        CompilerRegColdCallCandidate.NoCandidate))))

(define (compiler-reg-cold-call-block-label [block : ir.CompilerIrBlock]) : i64
  (match block
    [(ir.CompilerIrBlock.Block label _) label]))

(define (compiler-reg-cold-call-find-label
  [seq : ir.CompilerIrBlockSeq]
  [label : i64]) : i64
  (let
    [i : i64 0]
    [found : i64 (- 0 1)]
    (begin
      (while (and (< i (ir.compiler-ir-block-seq-count seq)) (< found 0))
        (begin
          (if (=
            (compiler-reg-cold-call-block-label
              (ir.compiler-ir-block-seq-ref seq i))
            label)
            (set! found i)
            unit)
          (set! i (+ i 1))))
      found)))

(define (compiler-reg-cold-call-predecessor-count
  [seq : ir.CompilerIrBlockSeq]
  [label : i64]
  [excluded : i64]) : i64
  (let
    [i : i64 0]
    [count : i64 0]
    (begin
      (while (< i (ir.compiler-ir-block-seq-count seq))
        (begin
          (if (and
            (not (= i excluded))
            (live.compiler-live-label-set-contains?
              (live.compiler-live-block-successors
                (ir.compiler-ir-block-seq-ref seq i))
              label))
            (set! count (+ count 1))
            unit)
          (set! i (+ i 1))))
      count)))

(define (compiler-reg-cold-call-reaches-loop-labels?
  [seq : ir.CompilerIrBlockSeq]
  [depths : (__tl_dyn-array i64)]
  [labels : live.CompilerLiveLabelSet]
  [seen : (__tl_dyn-array bool)]) : bool
  (match labels
    [(live.CompilerLiveLabelSet.Nil) false]
    [(live.CompilerLiveLabelSet.Dense _ _)
      (or
        (compiler-reg-cold-call-reaches-loop-from?
          seq
          depths
          (compiler-reg-cold-call-find-label
            seq
            (live.compiler-live-label-set-ref labels 0))
          seen)
        (compiler-reg-cold-call-reaches-loop-labels?
          seq
          depths
          (live.compiler-live-label-set-tail labels)
          seen))]))

(define (compiler-reg-cold-call-reaches-loop-from?
  [seq : ir.CompilerIrBlockSeq]
  [depths : (__tl_dyn-array i64)]
  [block : i64]
  [seen : (__tl_dyn-array bool)]) : bool
  (if (or
    (< block 0)
    (>= block (ir.compiler-ir-block-seq-count seq))
    (array-ref seen block))
    false
    (begin
      (set! (array-ref seen block) true)
      (or
        (> (array-ref depths block) 0)
        (compiler-reg-cold-call-reaches-loop-labels?
          seq
          depths
          (live.compiler-live-block-successors
            (ir.compiler-ir-block-seq-ref seq block))
          seen)))))

(define (compiler-reg-cold-call-cfg-ok?
  [blocks : ir.CompilerIrBlockList]
  [seq : ir.CompilerIrBlockSeq]
  [call-block : i64]
  [join-label : i64]) : bool
  (let
    [join-block : i64 (compiler-reg-cold-call-find-label seq join-label)]
    [depths : (__tl_dyn-array i64) (compiler-reg-function-loop-depths blocks)]
    [reaches-loop? : bool
      (compiler-reg-cold-call-reaches-loop-from?
        seq
        depths
        join-block
        (array.make-array bool (ir.compiler-ir-block-seq-count seq)))]
    [call-label : i64
      (compiler-reg-cold-call-block-label
        (ir.compiler-ir-block-seq-ref seq call-block))]
    (and
      (> call-block 0)
      (> join-block call-block)
      (= (array-ref depths call-block) 0)
      reaches-loop?
      (> (compiler-reg-cold-call-predecessor-count seq call-label (- 0 1)) 0)
      ;; One predecessor is the call block and at least one distinct predecessor
      ;; is the bypass edge.
      (> (compiler-reg-cold-call-predecessor-count seq join-label (- 0 1)) 1)
      (> (compiler-reg-cold-call-predecessor-count seq join-label call-block) 0))))

(define (compiler-reg-cold-call-protectable-type?
  [type-segment-bases : i64]
  [ty : ast.AstType]) : bool
  (and
    (compiler-reg-register-eligible-type? ty)
    (not (compiler-reg-float-type? ty))
    (not (compiler-reg-type-register-group? type-segment-bases ty))))

;; Fill `selected` in ascending var-id order.  Returning cap+1 means either the
;; bounded budget was exceeded or a live GP register-group could not be carried
;; in one stack word.  Edge-precise liveness keeps loop-phi back-edge inputs off
;; this preheader boundary.
(define (compiler-reg-cold-call-select-live!
  [type-segment-bases : i64]
  [live-after : live.CompilerLiveI64Set]
  [defs : live.CompilerLiveI64Set]
  [memory-vars : live.CompilerLiveI64Set]
  [type-info : CompilerRegVarTypes]
  [vars : i64]
  [selected : (__tl_dyn-array i64)]) : i64
  (let
    [v : i64 0]
    [count : i64 0]
    [unsafe : bool false]
    (begin
      (while (< v vars)
        (begin
          (if (and
            (live.compiler-live-set-contains? live-after v)
            (not (live.compiler-live-set-contains? defs v))
            (not (live.compiler-live-set-contains? memory-vars v)))
            (match (compiler-reg-var-types-lookup type-info v)
              [(CompilerRegMaybeType.Some ty)
                (if (compiler-reg-cold-call-protectable-type?
                  type-segment-bases
                  ty)
                  (begin
                    (if (< count (array-length selected))
                      (set! (array-ref selected count) v)
                      unit)
                    (set! count (+ count 1)))
                  ;; XMM-family values retain their real call masks; values
                  ;; that are not register-eligible already have stack homes.
                  ;; A GP register group would be exposed by the ignored mask,
                  ;; but this first form has only one-word carriers.
                  (if (and
                    (compiler-reg-register-eligible-type? ty)
                    (not (compiler-reg-float-type? ty)))
                    (set! unsafe true)
                    unit))]
              [(CompilerRegMaybeType.No) unit])
            unit)
          (set! v (+ v 1))))
      (if unsafe
        (+ (array-length selected) 1)
        count))))

(define (compiler-reg-cold-call-rewrite-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [selected : (__tl_dyn-array i64)]
  [selected-count : i64]
  [temp-start : i64]
  [type-info : CompilerRegVarTypes]) : ir.CompilerIrInstrSeq
  (let
    [old-count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [out-count : i64 (+ old-count (* 2 selected-count))]
    [out : (__tl_dyn-array ir.CompilerIrInstr)
      (array.make-array ir.CompilerIrInstr out-count)]
    [w : i64 0]
    [i : i64 0]
    (begin
      ;; Candidate admission fixes the call at instruction zero.
      (while (< i selected-count)
        (let
          [v : i64 (array-ref selected i)]
          (begin
            (match (compiler-reg-var-types-lookup type-info v)
              [(CompilerRegMaybeType.Some ty)
                (set!
                  (array-ref out w)
                  (ir.CompilerIrInstr.Mov
                    (+ temp-start i)
                    (ir.CompilerIrValue.Var v)
                    ty))]
              [(CompilerRegMaybeType.No) unit])
            (set! w (+ w 1))
            (set! i (+ i 1)))))
      (set! (array-ref out w) (ir.compiler-ir-instr-seq-ref instrs 0))
      (set! w (+ w 1))
      (set! i 0)
      (while (< i selected-count)
        (let
          [v : i64 (array-ref selected i)]
          (begin
            (match (compiler-reg-var-types-lookup type-info v)
              [(CompilerRegMaybeType.Some ty)
                (set!
                  (array-ref out w)
                  (ir.CompilerIrInstr.Mov
                    v
                    (ir.CompilerIrValue.Var (+ temp-start i))
                    ty))]
              [(CompilerRegMaybeType.No) unit])
            (set! w (+ w 1))
            (set! i (+ i 1)))))
      (set! i 1)
      (while (< i old-count)
        (begin
          (set! (array-ref out w) (ir.compiler-ir-instr-seq-ref instrs i))
          (set! w (+ w 1))
          (set! i (+ i 1))))
      (ir.CompilerIrInstrSeq out out-count))))

(define (compiler-reg-cold-call-rewrite-function
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]) : CompilerRegColdCallRewrite
  (match func
    [(ir.CompilerIrFunction.Function name params ret-ty vars blocks)
      (let
        [seq : ir.CompilerIrBlockSeq
          (live.compiler-live-ir-block-list-to-seq blocks)]
        (match (compiler-reg-cold-call-find-candidate type-segment-bases seq)
          [(CompilerRegColdCallCandidate.NoCandidate)
            (CompilerRegColdCallRewrite.Rewrite func (- 0 1))]
          [(CompilerRegColdCallCandidate.Candidate call-block join-label)
            (if (not
              (compiler-reg-cold-call-cfg-ok? blocks seq call-block join-label))
              (CompilerRegColdCallRewrite.Rewrite func (- 0 1))
              (let
                [type-info : CompilerRegVarTypes
                  (compiler-reg-function-var-types func)]
                [liveness
                  : live.CompilerFunctionLiveness
                  ;; Phi inputs belong to predecessor edges.  The baseline
                  ;; block analysis conservatively made back-edge inputs look
                  ;; live across this preheader call (nine values in the
                  ;; hashmap helper instead of the three real parameters).
                  (live.compiler-live-analyze-function-edge-precise func)]
                [call-instrs : ir.CompilerIrInstrSeq
                  (match (ir.compiler-ir-block-seq-ref seq call-block)
                    [(ir.CompilerIrBlock.Block _ instrs) instrs])]
                [call-instr : ir.CompilerIrInstr
                  (ir.compiler-ir-instr-seq-ref call-instrs 0)]
                [selected : (__tl_dyn-array i64) (array.make-array i64 12)]
                [selected-count : i64
                  (compiler-reg-cold-call-select-live!
                    type-segment-bases
                    (live.compiler-live-after
                      liveness
                      (compiler-reg-cold-call-block-label
                        (ir.compiler-ir-block-seq-ref seq call-block))
                      0)
                    (live.compiler-live-instr-defs call-instr)
                    (compiler-reg-ineligible-memory
                      blocks
                      (live.compiler-live-set-empty))
                    type-info
                    vars
                    selected)]
                (if (or (< selected-count 2) (> selected-count 12))
                  (CompilerRegColdCallRewrite.Rewrite func (- 0 1))
                  (let
                    [count : i64 (ir.compiler-ir-block-seq-count seq)]
                    [out : (__tl_dyn-array ir.CompilerIrBlock)
                      (array.make-array ir.CompilerIrBlock count)]
                    [b : i64 0]
                    (begin
                      (while (< b count)
                        (begin
                          (set!
                            (array-ref out b)
                            (if (= b call-block)
                              (match (ir.compiler-ir-block-seq-ref seq b)
                                [(ir.CompilerIrBlock.Block label instrs)
                                  (ir.CompilerIrBlock.Block
                                    label
                                    (compiler-reg-cold-call-rewrite-instrs
                                      instrs
                                      selected
                                      selected-count
                                      vars
                                      type-info))])
                              (ir.compiler-ir-block-seq-ref seq b)))
                          (set! b (+ b 1))))
                      (CompilerRegColdCallRewrite.Rewrite
                        (ir.CompilerIrFunction.Function
                          name
                          params
                          ret-ty
                          (+ vars selected-count)
                          (ir.CompilerIrBlockList.Array
                            (ir.CompilerIrBlockSeq out count)))
                        vars))))))]))]))

(define (compiler-reg-call-region-root
  [parents : (__tl_dyn-array i64)]
  [n : i64]
  [v : i64]) : i64
  (if (and (>= v 0) (< v (array-length parents)))
    (let
      [p : i64 (array-ref parents v)]
      (if (and (>= p 0) (< p n))
        p
        v))
    v))

;; Flush root's open region row into its bucket (kept only when it can ever
;; be selected: >= 2 uses) and close it.
(define (compiler-reg-call-region-flush-root!
  [root : i64]
  [buckets : (__tl_dyn-array CompilerRegCallRegionStatSeq)]
  [cur-lo : (__tl_dyn-array i64)]
  [cur-hi : (__tl_dyn-array i64)]
  [cur-uses : (__tl_dyn-array i64)]
  [cur-defs : (__tl_dyn-array i64)]
  [cur-firstdef : (__tl_dyn-array i64)]
  [cur-depth : (__tl_dyn-array i64)]) : unit
  (begin
    (if (and (>= (array-ref cur-lo root) 0) (>= (array-ref cur-uses root) 2))
      (set!
        (array-ref buckets root)
        (compiler-reg-call-region-stat-seq-push
          (array-ref buckets root)
          (CompilerRegCallRegionStat
            root
            (array-ref cur-lo root)
            (array-ref cur-hi root)
            (array-ref cur-uses root)
            (array-ref cur-defs root)
            (array-ref cur-firstdef root)
            (array-ref cur-depth root)
            (compiler-reg-call-region-kind-block))))
      unit)
    (set! (array-ref cur-lo root) (- 0 1))))

;; Attribute one instr's refs (its uses OR defs var set) to the candidates'
;; open regions. PER-VAR, deliberately NOT class-merged: storage coloring
;; later assigns every var its OWN slot by its own liveness, so two
;; coalesce-class members that share a plan offset may end up in DIFFERENT
;; final slots (their value flows through the class's explicit copy movs).
;; A region's boundary movs must therefore read/write exactly the var whose
;; refs they serve -- a class-merged region homed on the ROOT's slot reads
;; stale storage once coloring de-aliases the members (the M-G2b gating
;; miscompile: color_walk's entry reload read the root's slot while the
;; region's member refs lived in their own colored slot).
;; `rid` is the current region id (bumped at every block start and at every
;; kind-0 boundary instr); a ref under a NEW rid flushes the var's previous
;; region row and opens a fresh one at this point. Callers pass the uses set
;; FIRST, so a region opened by a def-that-also-reads (x = x + 1) correctly
;; records first-def = 0 (entry reload required).
(define (compiler-reg-call-region-note-set!
  [set : live.CompilerLiveI64Set]
  [is-def : bool]
  [cand : (__tl_dyn-array i64)]
  [n : i64]
  [rid : i64]
  [p : i64]
  [depth : i64]
  [buckets : (__tl_dyn-array CompilerRegCallRegionStatSeq)]
  [cur-region : (__tl_dyn-array i64)]
  [cur-lo : (__tl_dyn-array i64)]
  [cur-hi : (__tl_dyn-array i64)]
  [cur-uses : (__tl_dyn-array i64)]
  [cur-defs : (__tl_dyn-array i64)]
  [cur-firstdef : (__tl_dyn-array i64)]
  [cur-depth : (__tl_dyn-array i64)]) : unit
  (let
    [wi : i64 0]
    [wc : i64 (live.compiler-live-set-word-count set)]
    (while (< wi wc)
      (let
        [bits : i64 (live.compiler-live-set-word-at-bounded set wi)]
        (begin
          (while (not (= bits 0))
            (let
              [b : i64 (compiler-reg-low-bit-index32 bits)]
              [v : i64 (+ (* wi (live.compiler-live-set-word-bits)) b)]
              (begin
                (compiler-reg-call-region-note-var!
                  v
                  is-def
                  cand
                  n
                  rid
                  p
                  depth
                  buckets
                  cur-region
                  cur-lo
                  cur-hi
                  cur-uses
                  cur-defs
                  cur-firstdef
                  cur-depth)
                (set! bits (bit-and bits (- bits 1))))))
          (set! wi (+ wi 1)))))))

;; Per-var body of compiler-reg-call-region-note-set!, shared by the id form
;; below. Each var's row is independent, so the order the vars arrive in does
;; not matter; only uses-before-defs at one point does, and that is the caller's
;; two-call sequence.
(define (compiler-reg-call-region-note-var!
  [v : i64]
  [is-def : bool]
  [cand : (__tl_dyn-array i64)]
  [n : i64]
  [rid : i64]
  [p : i64]
  [depth : i64]
  [buckets : (__tl_dyn-array CompilerRegCallRegionStatSeq)]
  [cur-region : (__tl_dyn-array i64)]
  [cur-lo : (__tl_dyn-array i64)]
  [cur-hi : (__tl_dyn-array i64)]
  [cur-uses : (__tl_dyn-array i64)]
  [cur-defs : (__tl_dyn-array i64)]
  [cur-firstdef : (__tl_dyn-array i64)]
  [cur-depth : (__tl_dyn-array i64)]) : unit
  (if (and (>= v 0) (< v n) (= (array-ref cand v) 1))
    (begin
      (if (not (= (array-ref cur-region v) rid))
        (begin
          (compiler-reg-call-region-flush-root!
            v
            buckets
            cur-lo
            cur-hi
            cur-uses
            cur-defs
            cur-firstdef
            cur-depth)
          (set! (array-ref cur-region v) rid)
          (set! (array-ref cur-lo v) p)
          (set! (array-ref cur-hi v) p)
          (set! (array-ref cur-uses v) 0)
          (set! (array-ref cur-defs v) 0)
          (set!
            (array-ref cur-firstdef v)
            (if is-def
              1
              0))
          (set! (array-ref cur-depth v) depth))
        unit)
      (set! (array-ref cur-hi v) p)
      (if is-def
        (set! (array-ref cur-defs v) (+ (array-ref cur-defs v) 1))
        (set! (array-ref cur-uses v) (+ (array-ref cur-uses v) 1))))
    unit))

(define (compiler-reg-call-region-note-ids!
  [ids : (__tl_dyn-array i64)]
  [id-count : i64]
  [cand : (__tl_dyn-array i64)]
  [n : i64]
  [rid : i64]
  [p : i64]
  [depth : i64]
  [buckets : (__tl_dyn-array CompilerRegCallRegionStatSeq)]
  [cur-region : (__tl_dyn-array i64)]
  [cur-lo : (__tl_dyn-array i64)]
  [cur-hi : (__tl_dyn-array i64)]
  [cur-uses : (__tl_dyn-array i64)]
  [cur-defs : (__tl_dyn-array i64)]
  [cur-firstdef : (__tl_dyn-array i64)]
  [cur-depth : (__tl_dyn-array i64)]) : unit
  (let
    [index : i64 0]
    (while (< index id-count)
      (begin
        (compiler-reg-call-region-note-var!
          (array-ref ids index)
          false
          cand
          n
          rid
          p
          depth
          buckets
          cur-region
          cur-lo
          cur-hi
          cur-uses
          cur-defs
          cur-firstdef
          cur-depth)
        (set! index (+ index 1))))))

;; Enumeration walk: single pass over all instrs in layout order with the
;; greedy's point numbering (+2 per instr across blocks). Phi instructions
;; are skipped entirely (they sit at block heads; their inputs are read on
;; EDGES in predecessor blocks and their defs land in the home slot, so they
;; are never region members).
(define (compiler-reg-call-region-collect!
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [depths : (__tl_dyn-array i64)]
  [cand : (__tl_dyn-array i64)]
  [n : i64]
  [buckets : (__tl_dyn-array CompilerRegCallRegionStatSeq)]) : unit
  (let
    [seq : ir.CompilerIrBlockSeq
      (live.compiler-live-ir-block-list-to-seq blocks)]
    [bslots : (__tl_dyn-array ir.CompilerIrBlock) seq.slots]
    [nblocks : i64 seq.len]
    [cur-region : (__tl_dyn-array i64)
      (array.make-array
        i64
        (if (< n 1)
          1
          n))]
    [cur-lo : (__tl_dyn-array i64)
      (array.make-array
        i64
        (if (< n 1)
          1
          n))]
    [cur-hi : (__tl_dyn-array i64)
      (array.make-array
        i64
        (if (< n 1)
          1
          n))]
    [cur-uses : (__tl_dyn-array i64)
      (array.make-array
        i64
        (if (< n 1)
          1
          n))]
    [cur-defs : (__tl_dyn-array i64)
      (array.make-array
        i64
        (if (< n 1)
          1
          n))]
    [cur-firstdef : (__tl_dyn-array i64)
      (array.make-array
        i64
        (if (< n 1)
          1
          n))]
    [cur-depth : (__tl_dyn-array i64)
      (array.make-array
        i64
        (if (< n 1)
          1
          n))]
    [p : i64 0]
    [rid : i64 0]
    [b : i64 0]
    (begin
      (compiler-reg-fill-i64-array cur-region (- 0 1))
      (compiler-reg-fill-i64-array cur-lo (- 0 1))
      (while (< b nblocks)
        (begin
          (set! rid (+ rid 1))
          (match (array-ref bslots b)
            [(ir.CompilerIrBlock.Block _ instrs)
              (let
                [islots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
                [ilen : i64 (ir.compiler-ir-instr-seq-count instrs)]
                [depth : i64
                  (if (< b (array-length depths))
                    (array-ref depths b)
                    0)]
                [i : i64 0]
                (while (< i ilen)
                  (let
                    [instr : ir.CompilerIrInstr (array-ref islots i)]
                    (begin
                      (if (compiler-reg-call-region-boundary-instr?
                        type-segment-bases
                        instr)
                        (set! rid (+ rid 1))
                        (match instr
                          [(ir.CompilerIrInstr.Phi _ _ _) unit]
                          [_
                            (let
                              [ids : (__tl_dyn-array i64)
                                (live.compiler-live-instr-ids)]
                              [id-count : i64
                                (live.compiler-live-instr-use-ids! instr)]
                              (begin
                                (if (< id-count 0)
                                  (compiler-reg-call-region-note-set!
                                    (live.compiler-live-instr-uses instr)
                                    false
                                    cand
                                    n
                                    rid
                                    p
                                    depth
                                    buckets
                                    cur-region
                                    cur-lo
                                    cur-hi
                                    cur-uses
                                    cur-defs
                                    cur-firstdef
                                    cur-depth)
                                  (compiler-reg-call-region-note-ids!
                                    ids
                                    id-count
                                    cand
                                    n
                                    rid
                                    p
                                    depth
                                    buckets
                                    cur-region
                                    cur-lo
                                    cur-hi
                                    cur-uses
                                    cur-defs
                                    cur-firstdef
                                    cur-depth))
                                (compiler-reg-call-region-note-var!
                                  (live.compiler-live-instr-def-var instr)
                                  true
                                  cand
                                  n
                                  rid
                                  p
                                  depth
                                  buckets
                                  cur-region
                                  cur-lo
                                  cur-hi
                                  cur-uses
                                  cur-defs
                                  cur-firstdef
                                  cur-depth)))]))
                      (set! p (+ p 2))
                      (set! i (+ i 1))))))])
          (set! b (+ b 1))))
      (let
        [r : i64 0]
        (while (< r n)
          (begin
            (if (= (array-ref cand r) 1)
              (compiler-reg-call-region-flush-root!
                r
                buckets
                cur-lo
                cur-hi
                cur-uses
                cur-defs
                cur-firstdef
                cur-depth)
              unit)
            (set! r (+ r 1))))))))

;; ===========================================================================
;; P11b: loop-scoped rescue rows.
;;
;; The enumeration walk above bumps its region id at every BLOCK start, so a
;; loop invariant read once per iteration lands in a one-use row and is thrown
;; away by the >= 2 uses floor. That is the whole liveness_storage flagship:
;; `recompute!`'s spilled bound sits at one fixed slot and is reloaded at three
;; loop checks for ~25.0M dynamic instructions, inside loops the versioner had
;; ALREADY cloned -- the check-removal win handed straight back as spill
;; traffic. No per-block region can fix it, because the reload and the use it
;; feeds are the same instruction pair inside the same block: the load has to
;; leave the loop entirely.
;;
;; So the region model gains a second shape. A LOOP row covers the natural loop
;; [h..loop-ends[h]] and is anchored at the LAST instruction of block h-1 -- the
;; loop's preheader -- which the rewrite already knows how to handle: the
;; activation mov is emitted just before the anchor instruction, so it runs once
;; per loop entry, and the remap then covers every use inside the loop.
;;
;; SOUNDNESS. The shadow is the block-scoped rescue's model at a wider span: a
;; pure copy of a root whose slot stays authoritative, so the only obligations
;; are (a) the anchor dominates every remapped reference and (b) nothing in the
;; span rewrites either side of the copy.
;;
;;   (a) DOMINATION. Admission demands that every body block (h..e] has ALL of
;;       its predecessors inside [h..e] (the single-entry witness the loop-phi
;;       multi-block machinery already uses) AND that the header's predecessor
;;       set is exactly {h-1} plus in-region back edges. Together those make
;;       h-1 the sole way in, so the anchor -- the last instruction of h-1,
;;       which every edge into h executes -- dominates the whole region. The
;;       back edge stays INSIDE the point span, so the shadow survives across
;;       iterations with no per-iteration copy; that is where the win comes
;;       from.
;;
;;   (b) NO REWRITE OF EITHER SIDE. The root must not be DEFINED anywhere in
;;       [h..e] (the loop-invariant class), which is also why phis are a
;;       non-issue: a phi def disqualifies the var outright, so a loop row's
;;       root never has a header phi to race, and the rewrite's standing
;;       phi-exclusion rule is left exactly as it was. defs = 0 also means
;;       exit = 0: a read-only invariant needs NO write-back, so the region has
;;       no exit-edge obligation at all and the block-scoped exit-store path is
;;       untouched. The span must contain no kind-0 boundary instruction, and
;;       the shadow register comes from the callee-saved loop pool, which no
;;       non-call clobber in the span can reach.
;;
;; Registers: see compiler-reg-call-region-loop-pool-reg-ok?. The caller-saved
;; pool is the wrong bank here -- a hot loop's own address and index registers
;; occupy r8/r9/rsi/rdi for its whole body, which is exactly why the greedy had
;; to spill the invariant in the first place.
;; ===========================================================================
;; Predecessor index RANGE per block, packed two entries per block as in
;; compiler-reg-loop-phi-mb-pred-ranges: ranges[2b] = lowest predecessor index
;; (block count when b has none), ranges[2b+1] = highest (-1 when none). Built
;; from the IR successor sets rather than from live blocks because the rescue
;; runs without a liveness handle.
(define (compiler-reg-call-region-record-pred-range!
  [ids : reg_label_i64_map.Map]
  [ranges : (__tl_dyn-array i64)]
  [from : i64]
  [succs : live.CompilerLiveLabelSet]) : unit
  (match succs
    [(live.CompilerLiveLabelSet.Nil) unit]
    [(live.CompilerLiveLabelSet.Dense _ _)
      (begin
        (match (reg_label_i64_map.get
          (& ids)
          (live.compiler-live-label-set-ref succs 0))
          [(reg_label_i64_map.LookupFound to)
            (if (and (>= to 0) (< (+ (* 2 to) 1) (array-length ranges)))
              (begin
                (when
                  (< from (array-ref ranges (* 2 to)))
                  (set! (array-ref ranges (* 2 to)) from))
                (when
                  (> from (array-ref ranges (+ (* 2 to) 1)))
                  (set! (array-ref ranges (+ (* 2 to) 1)) from)))
              unit)]
          [(reg_label_i64_map.LookupMissing) unit])
        (compiler-reg-call-region-record-pred-range!
          ids
          ranges
          from
          (live.compiler-live-label-set-tail succs)))]))

(define (compiler-reg-call-region-pred-ranges
  [bslots : (__tl_dyn-array ir.CompilerIrBlock)]
  [nblocks : i64]
  [ids : reg_label_i64_map.Map]) : (__tl_dyn-array i64)
  (let
    [ranges : (__tl_dyn-array i64)
      (array.make-array
        i64
        (*
          2
          (if (< nblocks 1)
            1
            nblocks)))]
    [b : i64 0]
    (begin
      (while (< b nblocks)
        (begin
          (set! (array-ref ranges (* 2 b)) nblocks)
          (set! (array-ref ranges (+ (* 2 b) 1)) (- 0 1))
          (set! b (+ b 1))))
      (set! b 0)
      (while (< b nblocks)
        (begin
          (compiler-reg-call-region-record-pred-range!
            ids
            ranges
            b
            (live.compiler-live-block-successors (array-ref bslots b)))
          (set! b (+ b 1))))
      ranges)))

;; Region admission for header `h` with natural-loop end `e` (= loop-ends[h],
;; so a back edge into h from e is already proven). e == h is the single-block
;; self-loop, which is admitted: it is the flagship's inner shape, and its
;; empty body range makes the single-entry scan trivially true.
(define (compiler-reg-call-region-loop-admit?
  [ranges : (__tl_dyn-array i64)]
  [depths : (__tl_dyn-array i64)]
  [nblocks : i64]
  [h : i64]
  [e : i64]) : bool
  (and
    (>= h 1)
    (>= e h)
    (< e nblocks)
    (< h (array-length depths))
    (> (array-ref depths h) 0)
    (< (+ (* 2 h) 1) (array-length ranges))
    ;; the header's lowest predecessor is the LAYOUT predecessor h-1 (so no
    ;; earlier block jumps into the loop) and its highest is inside the region
    ;; (so no later block does either): h-1 is the single preheader.
    (= (array-ref ranges (* 2 h)) (- h 1))
    (<= (array-ref ranges (+ (* 2 h) 1)) e)
    (compiler-reg-loop-phi-mb-body-entered-inside? ranges (+ h 1) e h)))

;; Per-var accumulator for one region scan. `stamp` carries the header id, so
;; each region starts from zero counters without an O(vars) clear per header.
(define (compiler-reg-call-region-loop-note-var!
  [v : i64]
  [is-def : bool]
  [cand : (__tl_dyn-array i64)]
  [n : i64]
  [sid : i64]
  [stamp : (__tl_dyn-array i64)]
  [uses : (__tl_dyn-array i64)]
  [defs : (__tl_dyn-array i64)]) : unit
  ;; both candidate grades: a loop row's cost is register pressure, not a call
  (if (and (>= v 0) (< v n) (> (array-ref cand v) 0))
    (begin
      (if (not (= (array-ref stamp v) sid))
        (begin
          (set! (array-ref stamp v) sid)
          (set! (array-ref uses v) 0)
          (set! (array-ref defs v) 0))
        unit)
      (if is-def
        (set! (array-ref defs v) (+ (array-ref defs v) 1))
        (set! (array-ref uses v) (+ (array-ref uses v) 1))))
    unit))

(define (compiler-reg-call-region-loop-note-set!
  [set : live.CompilerLiveI64Set]
  [cand : (__tl_dyn-array i64)]
  [n : i64]
  [sid : i64]
  [stamp : (__tl_dyn-array i64)]
  [uses : (__tl_dyn-array i64)]
  [defs : (__tl_dyn-array i64)]) : unit
  (let
    [wi : i64 0]
    [wc : i64 (live.compiler-live-set-word-count set)]
    (while (< wi wc)
      (let
        [bits : i64 (live.compiler-live-set-word-at-bounded set wi)]
        (begin
          (while (not (= bits 0))
            (let
              [b : i64 (compiler-reg-low-bit-index32 bits)]
              (begin
                (compiler-reg-call-region-loop-note-var!
                  (+ (* wi (live.compiler-live-set-word-bits)) b)
                  false
                  cand
                  n
                  sid
                  stamp
                  uses
                  defs)
                (set! bits (bit-and bits (- bits 1))))))
          (set! wi (+ wi 1)))))))

(define (compiler-reg-call-region-loop-note-ids!
  [ids : (__tl_dyn-array i64)]
  [id-count : i64]
  [cand : (__tl_dyn-array i64)]
  [n : i64]
  [sid : i64]
  [stamp : (__tl_dyn-array i64)]
  [uses : (__tl_dyn-array i64)]
  [defs : (__tl_dyn-array i64)]) : unit
  (let
    [index : i64 0]
    (while (< index id-count)
      (begin
        (compiler-reg-call-region-loop-note-var!
          (array-ref ids index)
          false
          cand
          n
          sid
          stamp
          uses
          defs)
        (set! index (+ index 1))))))

;; Accumulate one instruction's refs. Phis contribute their DEF only: their
;; operands are read on predecessor edges and the rewrite never remaps a phi,
;; but a phi def is precisely what disqualifies a var from the invariant class.
(define (compiler-reg-call-region-loop-note-instr!
  [instr : ir.CompilerIrInstr]
  [cand : (__tl_dyn-array i64)]
  [n : i64]
  [sid : i64]
  [stamp : (__tl_dyn-array i64)]
  [uses : (__tl_dyn-array i64)]
  [defs : (__tl_dyn-array i64)]) : unit
  (match instr
    [(ir.CompilerIrInstr.Phi _ _ _)
      (compiler-reg-call-region-loop-note-var!
        (live.compiler-live-instr-def-var instr)
        true
        cand
        n
        sid
        stamp
        uses
        defs)]
    [_
      (let
        [ids : (__tl_dyn-array i64) (live.compiler-live-instr-ids)]
        [id-count : i64 (live.compiler-live-instr-use-ids! instr)]
        (begin
          (if (< id-count 0)
            (compiler-reg-call-region-loop-note-set!
              (live.compiler-live-instr-uses instr)
              cand
              n
              sid
              stamp
              uses
              defs)
            (compiler-reg-call-region-loop-note-ids!
              ids
              id-count
              cand
              n
              sid
              stamp
              uses
              defs))
          (compiler-reg-call-region-loop-note-var!
            (live.compiler-live-instr-def-var instr)
            true
            cand
            n
            sid
            stamp
            uses
            defs)))]))

;; Scan region blocks [s..e], accumulating refs. False = the span holds a
;; kind-0 boundary instruction, which kills the whole region (the shadow would
;; not survive it).
(define (compiler-reg-call-region-loop-scan-blocks!
  [type-segment-bases : i64]
  [bslots : (__tl_dyn-array ir.CompilerIrBlock)]
  [s : i64]
  [e : i64]
  [cand : (__tl_dyn-array i64)]
  [n : i64]
  [sid : i64]
  [stamp : (__tl_dyn-array i64)]
  [uses : (__tl_dyn-array i64)]
  [defs : (__tl_dyn-array i64)]) : bool
  (let
    [b : i64 s]
    (begin
      (while (<= b e)
        (match (array-ref bslots b)
          [(ir.CompilerIrBlock.Block _ instrs)
            (let
              [islots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
              [ilen : i64 (ir.compiler-ir-instr-seq-count instrs)]
              [i : i64 0]
              (begin
                (while (< i ilen)
                  (let
                    [instr : ir.CompilerIrInstr (array-ref islots i)]
                    (begin
                      (when
                        (compiler-reg-call-region-boundary-instr?
                          type-segment-bases
                          instr)
                        (return false))
                      (compiler-reg-call-region-loop-note-instr!
                        instr
                        cand
                        n
                        sid
                        stamp
                        uses
                        defs)
                      (set! i (+ i 1)))))
                (set! b (+ b 1))))]))
      true)))

;; The anchor instruction (the preheader's last, at point `lo`) is inside the
;; span, so it has to clear the same boundary bar as the loop body.
(define (compiler-reg-call-region-loop-anchor-ok?
  [type-segment-bases : i64]
  [block : ir.CompilerIrBlock]) : bool
  (match block
    [(ir.CompilerIrBlock.Block _ instrs)
      (let
        [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
        (if (<= count 0)
          false
          (not
            (compiler-reg-call-region-boundary-instr?
              type-segment-bases
              (ir.compiler-ir-instr-seq-ref instrs (- count 1))))))]))

;; Push one loop row per candidate root that the region scan found used and
;; never defined. Walks the candidate ORDER list rather than all vars, so the
;; cost per header is the candidate count, not the var count.
(define (compiler-reg-call-region-loop-push-rows!
  [order : (__tl_dyn-array i64)]
  [cand-count : i64]
  [n : i64]
  [sid : i64]
  [stamp : (__tl_dyn-array i64)]
  [uses : (__tl_dyn-array i64)]
  [defs : (__tl_dyn-array i64)]
  [lo : i64]
  [hi : i64]
  [depth : i64]
  [buckets : (__tl_dyn-array CompilerRegCallRegionStatSeq)]) : unit
  (let
    [ci : i64 0]
    (while (< ci cand-count)
      (let
        [v : i64 (array-ref order ci)]
        (begin
          (if (and
            (>= v 0)
            (< v n)
            (= (array-ref stamp v) sid)
            (>= (array-ref uses v) 1)
            (= (array-ref defs v) 0))
            (set!
              (array-ref buckets v)
              (compiler-reg-call-region-stat-seq-push
                (array-ref buckets v)
                (CompilerRegCallRegionStat
                  v
                  lo
                  hi
                  (array-ref uses v)
                  0
                  0
                  depth
                  (compiler-reg-call-region-kind-loop))))
            unit)
          (set! ci (+ ci 1)))))))

(define (compiler-reg-call-region-loop-rows!
  [type-segment-bases : i64]
  [blocks : ir.CompilerIrBlockList]
  [depths : (__tl_dyn-array i64)]
  [cand : (__tl_dyn-array i64)]
  [order : (__tl_dyn-array i64)]
  [cand-count : i64]
  [n : i64]
  [buckets : (__tl_dyn-array CompilerRegCallRegionStatSeq)]) : unit
  (let
    [seq : ir.CompilerIrBlockSeq
      (live.compiler-live-ir-block-list-to-seq blocks)]
    [bslots : (__tl_dyn-array ir.CompilerIrBlock) seq.slots]
    [nblocks : i64 seq.len]
    [an : i64
      (if (< n 1)
        1
        n)]
    (if (< nblocks 2)
      unit
      (let
        [points : (__tl_dyn-array i64)
          (compiler-reg-loop-phi-mb-block-points bslots)]
        [loop-ends : (__tl_dyn-array i64)
          (compiler-reg-preheader-loop-ends-seq seq nblocks)]
        [ranges : (__tl_dyn-array i64)
          (compiler-reg-call-region-pred-ranges
            bslots
            nblocks
            (compiler-reg-loop-depth-block-ids
              blocks
              (reg_label_i64_map.with-capacity
                (compiler-reg-bits-map-capacity nblocks))
              0))]
        [stamp : (__tl_dyn-array i64) (array.make-array i64 an)]
        [uses : (__tl_dyn-array i64) (array.make-array i64 an)]
        [defs : (__tl_dyn-array i64) (array.make-array i64 an)]
        [h : i64 1]
        (begin
          (compiler-reg-fill-i64-array stamp (- 0 1))
          (while (< h nblocks)
            (let
              [e : i64
                (if (< h (array-length loop-ends))
                  (array-ref loop-ends h)
                  (- 0 1))]
              (begin
                (when
                  (compiler-reg-call-region-loop-admit?
                    ranges
                    depths
                    nblocks
                    h
                    e)
                  (let
                    ;; anchor = last instruction of the preheader h-1;
                    ;; hi = last instruction of the loop's final block e.
                    [lo : i64 (- (array-ref points h) 2)]
                    [hi : i64 (- (array-ref points (+ e 1)) 2)]
                    (when
                      (and
                        (>= lo (array-ref points (- h 1)))
                        (> hi lo)
                        (compiler-reg-call-region-loop-anchor-ok?
                          type-segment-bases
                          (array-ref bslots (- h 1)))
                        (compiler-reg-call-region-loop-scan-blocks!
                          type-segment-bases
                          bslots
                          h
                          e
                          cand
                          n
                          h
                          stamp
                          uses
                          defs))
                      (compiler-reg-call-region-loop-push-rows!
                        order
                        cand-count
                        n
                        h
                        stamp
                        uses
                        defs
                        lo
                        hi
                        (array-ref depths h)
                        buckets))))
                (set! h (+ h 1))))))))))

(define (compiler-reg-call-region-stat-entry [stat : CompilerRegCallRegionStat]) : i64
  (match stat
    [(CompilerRegCallRegionStat _ _ _ _ _ firstdef _ _)
      (if (= firstdef 1)
        0
        1)]))

;; Exit store needed iff the region redefines the value AND it lives past the
;; region's last instr (interval end beyond hi's live-after half-point).
;; Unknown interval -> conservative 1 (an extra dead store is safe; a missing
;; live store is a miscompile).
(define (compiler-reg-call-region-stat-exit
  [stat : CompilerRegCallRegionStat]
  [ends : (__tl_dyn-array i64)]) : i64
  (match stat
    [(CompilerRegCallRegionStat var _ hi _ defs _ _ _)
      (if (= defs 0)
        0
        (if (and
          (>= var 0)
          (< var (array-length ends))
          (<= (array-ref ends var) (+ hi 1)))
          0
          1))]))

(define (compiler-reg-call-region-stat-net
  [stat : CompilerRegCallRegionStat]
  [ends : (__tl_dyn-array i64)]) : i64
  (match stat
    [(CompilerRegCallRegionStat _ _ _ uses defs _ _ _)
      (-
        (+ uses defs)
        (+
          (compiler-reg-call-region-stat-entry stat)
          (compiler-reg-call-region-stat-exit stat ends)))]))

;; TRIP-COUNT FACTOR, for the rescue's frequency model ONLY.
;;
;; compiler-reg-loop-depth-weight is a RANK-ORDERING device: the greedy uses it
;; to decide which of two values to spill, and only the relative order matters
;; there. Its 1/2/4/8/16 ladder therefore encodes "a loop body runs twice per
;; entry", which is fine for ranking and wrong as an absolute frequency.
;;
;; The rescue is the one consumer that reads it as an absolute frequency, in a
;; cost/BENEFIT inequality: it compares reloads removed from a loop body against
;; movs added at the loop's boundary. Measured consequence of the ladder's
;; trip-2 assumption (regalloc-evict-census over an opt2 self-compile): 39 of 91
;; eviction candidates priced out, and NONE of them reached break-even -- a
;; single reload moved out of a loop cannot pay for a store plus a reload when
;; the loop is modelled as iterating twice. 85 parked victims sat there
;; unusable for that reason alone.
;;
;; So the rescue -- and nothing else -- multiplies the body side by T per loop
;; level the use sits below the cost point. The global ladder is untouched, so
;; every spill and eviction decision elsewhere in the allocator is unchanged.
;;
;; T = 8 is the base the house depth currency already uses (the ladder's own
;; step, and the inliner's depth currency), so the two frequency models agree
;; rather than inventing a third number; combined with the ladder's own factor
;; of 2 per level it prices a loop at ~16 iterations, which is conservative for
;; the hot loops the rescue targets. Capped at two levels, exactly as the depth
;; ladder saturates, so a deep nest cannot manufacture an unbounded benefit.
(define (compiler-reg-call-region-trip-factor) : i64
  8)

(define (compiler-reg-call-region-trip-multiplier [delta : i64]) : i64
  (cond
    [(<= delta 0) 1]
    [(= delta 1) (compiler-reg-call-region-trip-factor)]
    [else
      (*
        (compiler-reg-call-region-trip-factor)
        (compiler-reg-call-region-trip-factor))]))

;; Block rows: every ref and every boundary mov runs at the same frequency, so
;; the depth weight multiplies the whole net, and no trip factor applies -- both
;; sides sit at the same point.
;; Loop rows: the uses run once per ITERATION and the single entry reload runs
;; once per loop ENTRY, so only the uses take the depth weight AND the trip
;; factor. That is the whole point of the preheader anchor -- a
;; one-use-per-iteration invariant has net 0 under the block formula. Admission
;; proves the anchor block is the loop's sole preheader and therefore sits
;; exactly one loop level above the header, so the delta is 1 by construction.
(define (compiler-reg-call-region-stat-score
  [stat : CompilerRegCallRegionStat]
  [ends : (__tl_dyn-array i64)]) : i64
  (match stat
    [(CompilerRegCallRegionStat _ _ _ uses _ _ depth kind)
      (if (= kind (compiler-reg-call-region-kind-loop))
        (-
          (*
            uses
            (*
              (compiler-reg-loop-depth-weight depth)
              (compiler-reg-call-region-trip-multiplier 1)))
          1)
        (*
          (compiler-reg-call-region-stat-net stat ends)
          (compiler-reg-loop-depth-weight depth)))]))

;; Profitability floor. Block rows: >= 2 uses (the memo bound) AND net
;; memory-op win >= 2 after charging the boundary movs. Loop rows: one use
;; inside a real loop already pays, because the reload it replaces leaves the
;; loop entirely (static instruction count is unchanged -- one mov added to the
;; preheader, one load removed from the body).
(define (compiler-reg-call-region-stat-eligible?
  [stat : CompilerRegCallRegionStat]
  [ends : (__tl_dyn-array i64)]) : bool
  (match stat
    [(CompilerRegCallRegionStat _ _ _ uses _ _ depth kind)
      (if (= kind (compiler-reg-call-region-kind-loop))
        (and (>= uses 1) (> depth 0))
        (and (>= uses 2) (>= (compiler-reg-call-region-stat-net stat ends) 2)))]))

;; Does [lo,hi] touch any already-picked range for this root? The walk's own
;; rows never overlap (each is one rid run), so for a bucket of pure block rows
;; this is exactly the old "same lo" identity test. A loop row, however, spans
;; the block rows nested inside it: taking both would spend budget on a region
;; the rewrite then declines (one shadow per root is active at a time) and
;; would drag the shared register search over a range already covered.
(define (compiler-reg-call-region-picked?
  [picked-lo : (__tl_dyn-array i64)]
  [picked-hi : (__tl_dyn-array i64)]
  [k : i64]
  [lo : i64]
  [hi : i64]) : bool
  (let
    [j : i64 0]
    [found : bool false]
    (begin
      (while (< j k)
        (begin
          (if (and
            (<= (array-ref picked-lo j) hi)
            (>= (array-ref picked-hi j) lo))
            (set! found true)
            unit)
          (set! j (+ j 1))))
      found)))

;; Best eligible LOOP row by score that does not overlap an already-tried
;; range. Used by the per-root fallback: when the joint search over the top
;; rows finds no register, the widest loop -- which scores highest and is the
;; hardest to home -- must not bury the tighter inner loop underneath it.
(define (compiler-reg-call-region-best-loop-from
  [rows : CompilerRegCallRegionStatSeq]
  [ends : (__tl_dyn-array i64)]
  [tried-lo : (__tl_dyn-array i64)]
  [tried-hi : (__tl_dyn-array i64)]
  [k : i64]) : CompilerRegCallRegionMaybeStat
  (let
    [slots : (__tl_dyn-array CompilerRegCallRegionStat) rows.slots]
    [index : i64 (- rows.len 1)]
    [top-score : i64 (- 0 1)]
    [top : CompilerRegCallRegionMaybeStat (CompilerRegCallRegionNoStat)]
    (begin
      (while (>= index 0)
        (let
          [stat : CompilerRegCallRegionStat (array-ref slots index)]
          [score : i64 (compiler-reg-call-region-stat-score stat ends)]
          (begin
            (match stat
              [(CompilerRegCallRegionStat _ lo hi _ _ _ _ kind)
                (if (and
                  (= kind (compiler-reg-call-region-kind-loop))
                  (compiler-reg-call-region-stat-eligible? stat ends)
                  (not
                    (compiler-reg-call-region-picked? tried-lo tried-hi k lo hi))
                  (> score top-score))
                  (begin
                    (set! top-score score)
                    (set! top (CompilerRegCallRegionSomeStat stat)))
                  unit)])
            (set! index (- index 1)))))
      top)))

;; Best eligible row by score that does not overlap an already-picked range.
(define (compiler-reg-call-region-best-from
  [rows : CompilerRegCallRegionStatSeq]
  [ends : (__tl_dyn-array i64)]
  [picked-lo : (__tl_dyn-array i64)]
  [picked-hi : (__tl_dyn-array i64)]
  [k : i64]
  [best-score : i64]
  [best : CompilerRegCallRegionMaybeStat]) : CompilerRegCallRegionMaybeStat
  (let
    [slots : (__tl_dyn-array CompilerRegCallRegionStat) rows.slots]
    [index : i64 (- rows.len 1)]
    [top-score : i64 best-score]
    [top : CompilerRegCallRegionMaybeStat best]
    (begin
      (while (>= index 0)
        (let
          [stat : CompilerRegCallRegionStat (array-ref slots index)]
          [score : i64 (compiler-reg-call-region-stat-score stat ends)]
          (begin
            (match stat
              [(CompilerRegCallRegionStat _ lo hi _ _ _ _ _)
                (if (and
                  (compiler-reg-call-region-stat-eligible? stat ends)
                  (not
                    (compiler-reg-call-region-picked?
                      picked-lo
                      picked-hi
                      k
                      lo
                      hi))
                  (> score top-score))
                  (begin
                    (set! top-score score)
                    (set! top (CompilerRegCallRegionSomeStat stat)))
                  unit)])
            (set! index (- index 1)))))
      top)))

;; Segment-precise occupancy: does var overlap point range [lo,hi]?
;; CLOSED-interval overlap (inclusive at both ends, unlike the allocator's
;; half-open boundary-touch waiver) so even a boundary-touching occupant --
;; e.g. a dead def at lo whose register write would land between our entry
;; reload and the region body -- conflicts. Hull fallback when no segments.
(define (compiler-reg-call-region-var-overlaps-segs?
  [segs : CompilerRegIntervalSeq]
  [lo : i64]
  [hi : i64]) : bool
  (let
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (< index (compiler-reg-interval-seq-count segs)) (not found))
        (let
          [interval : CompilerRegInterval
            (compiler-reg-interval-seq-ref segs index)]
          (if (and (<= interval.start (+ hi 1)) (>= interval.end lo))
            (set! found true)
            (set! index (+ index 1)))))
      found)))

(define (compiler-reg-call-region-var-overlaps?
  [interval-index : CompilerRegIntervalIndex]
  [v : i64]
  [lo : i64]
  [hi : i64]) : bool
  (let
    [segments : (__tl_dyn-array CompilerRegIntervalSeq) interval-index.segments]
    [starts : (__tl_dyn-array i64) interval-index.starts]
    [ends : (__tl_dyn-array i64) interval-index.ends]
    (if (and (>= v 0) (< v (array-length starts)))
      (let
        [segs : CompilerRegIntervalSeq
          (if (< v (array-length segments))
            (array-ref segments v)
            (compiler-reg-interval-seq-empty))]
        (if (not (compiler-reg-interval-seq-empty? segs))
          (compiler-reg-call-region-var-overlaps-segs? segs lo hi)
          (and
            (>= (array-ref starts v) 0)
            (<= (array-ref starts v) (+ hi 1))
            (>= (array-ref ends v) lo))))
      true)))

(define (compiler-reg-call-region-pool-index-of
  [pool : (__tl_dyn-array i64)]
  [reg : i64]) : i64
  (let
    [j : i64 0]
    [found : i64 (- 0 1)]
    (begin
      (while (< j (array-length pool))
        (begin
          (if (and (< found 0) (= (array-ref pool j) reg))
            (set! found j)
            unit)
          (set! j (+ j 1))))
      found)))

;; Is pool register `pix` occupied over [lo,hi] by any recorded occupant?
;; Occupants = every var assigned a pool register (or a register pair
;; containing one) plus every previously accepted shadow var (recorded on
;; its coalesce root, whose merged segments cover it). A candidate's own
;; occupancy is appended only AFTER all its regions are picked, so no
;; self-skip is needed -- and none is WANTED: two same-class siblings must
;; not share a register over overlapping regions (they are distinct values
;; under the storage-sharing coalesce).
(define (compiler-reg-call-region-reg-conflicts?
  [occ-var : (__tl_dyn-array i64)]
  [occ-reg : (__tl_dyn-array i64)]
  [occ-n : i64]
  [interval-index : CompilerRegIntervalIndex]
  [pix : i64]
  [lo : i64]
  [hi : i64]) : bool
  (let
    [j : i64 0]
    [conflict : bool false]
    (begin
      (while (and (< j occ-n) (not conflict))
        (begin
          (if (and
            (= (array-ref occ-reg j) pix)
            (compiler-reg-call-region-var-overlaps?
              interval-index
              (array-ref occ-var j)
              lo
              hi))
            (set! conflict true)
            unit)
          (set! j (+ j 1))))
      conflict)))

;; ===========================================================================
;; P11b PHASE 3: loop-scope EVICTION of a PARKED occupant.
;;
;; Phase 2 homes a spilled loop invariant in a pool register that is FREE over
;; the whole region. Measurement says the flagship never gets that far: in
;; liveness_storage's versioned `recompute!` clones every one of the nine pool
;; registers is held by a value live across the ENCLOSING loop, so the
;; find-a-free-register model has nothing to find and the invariant keeps its
;; three per-iteration reloads.
;;
;; This is the missing lever. When the search fails, look for an occupant that
;; is merely PARKED across the region -- live over it, mentioned nowhere inside
;; it -- and lend its register out for the region's extent:
;;
;;      anchor:  Mov S <- O          (one store, once per loop ENTRY)
;;               Mov W <- V          (the Phase 2 shadow load)
;;      region:  ... uses of V read W in O's register, no memory traffic ...
;;      exit_i:  Mov O <- S          (one reload per LIVE exit edge)
;;
;; Why only parked occupants (v1): a victim mentioned inside the region would
;; need its own reloads there, and pricing that against the invariant's is a
;; comparative-frequency problem this pass does not model. Zero-mention victims
;; make the trade unconditional -- the region gains a register and pays only at
;; its boundary.
;;
;; SOUNDNESS, in the same terms Phase 2 used:
;;
;;   * DOMINATION. The save sits at the region anchor, which admission already
;;     proved is the sole way into the loop, so S is written before any path
;;     that clobbers O's register.
;;
;;   * COVERAGE. Every exit EDGE of [h..e] gets a reload placed at the head of
;;     its target block, and the target is admitted only when ALL of its
;;     predecessors lie inside [h..e] -- so the reload is reached exactly on
;;     paths that ran the save, never on a first entry from outside. Targets
;;     are further restricted to blocks laid out AFTER the region, which rules
;;     out the one shape that would break that argument: an exit back into the
;;     preheader or an enclosing header, whose first entry precedes the save.
;;     A target starting with a phi is refused (nothing may be inserted above
;;     a phi). Any exit edge that cannot be served refuses the whole candidate.
;;
;;   * EXIT KINDS. Return and TailCall inside the region are exits with NO
;;     successor and need no reload: the epilogue restores callee-saved
;;     registers from their prologue slots, not from the register, and the
;;     victim -- unmentioned in the region by construction -- is neither a
;;     return value nor a tail-call argument. Every other terminator's
;;     successors are enumerated from the block's successor set, so a Switch
;;     arm is an ordinary exit edge.
;;
;;   * NO IN-REGION READ. The mention scan covers the ANCHOR INSTRUCTION as
;;     well as the loop body. That instruction runs AFTER both movs, so an
;;     occupant read by the preheader's own terminator (a branch condition,
;;     say) would observe the shadow; the closed-interval occupancy test hides
;;     that case from Phase 2, and eviction has to reject it explicitly.
;; ===========================================================================
;; pool index to lend, victim var, live reload count, save-point count. The
;; reload and save points themselves come back in the caller's two out arrays.
(defenum CompilerRegCallEvictPick
  (CompilerRegCallEvictNoPick)
  (CompilerRegCallEvictSomePick i64 i64 i64 i64))

;; Accepted evictions per function. Each one adds a store plus up to three
;; reloads to the function's boundary code, all at loop-ENTRY frequency.
(define (compiler-reg-call-region-evict-cap) : i64
  2)

;; Attempts per function, accepted or not. Each attempt walks the function's
;; blocks twice (pred ranges + mention marking), so this is the compile-time
;; bound; functions that never fail the free-register search pay nothing.
(define (compiler-reg-call-region-evict-attempt-cap) : i64
  4)

;; Reloads per eviction. Beyond this the boundary cost stops being a boundary
;; cost, and a region with many exits is usually not the tight inner loop the
;; rescue is for.
(define (compiler-reg-call-region-evict-exit-cap) : i64
  3)

;; Record one mentioned var, in BOTH currencies the decision needs:
;;
;;   * stamp, keyed by var AND by coalesce ROOT. Storage-shared siblings are one
;;     value to the interval index -- a member carries no segments of its own and
;;     the root's hull conservatively covers the whole class -- so a root can
;;     look "parked across the region" purely BECAUSE a sibling is read inside
;;     it. Stamping the class is what makes the parked test mean what it says.
;;
;;   * busy, keyed by POOL REGISTER. The occupancy index only sees vars the
;;     plan gave a register AND the interval index gave a range; anything that
;;     misses either test is invisible to it. Asking instead "does any var
;;     mentioned in this region live in that register" answers the question the
;;     eviction actually depends on -- is the register READ here -- without
;;     relying on the occupancy index being complete.
(define (compiler-reg-call-region-evict-mark-var!
  [v : i64]
  [n : i64]
  [parents : (__tl_dyn-array i64)]
  [assignments : CompilerRegAssignmentTable]
  [pool : (__tl_dyn-array i64)]
  [stamp : (__tl_dyn-array i64)]
  [busy : (__tl_dyn-array i64)]) : unit
  (when
    (and (>= v 0) (< v n))
    (begin
      (set! (array-ref stamp v) 1)
      (let
        [rr : i64 (compiler-reg-call-region-root parents n v)]
        (when (and (>= rr 0) (< rr n)) (set! (array-ref stamp rr) 1)))
      (match (compiler-reg-assignment-table-lookup assignments v)
        [(CompilerRegMaybeLocation.Some location)
          (match location
            [(CompilerRegLocation.Register r)
              (compiler-reg-call-region-evict-mark-busy! pool busy r)]
            [(CompilerRegLocation.RegisterPair r0 r1)
              (begin
                (compiler-reg-call-region-evict-mark-busy! pool busy r0)
                (compiler-reg-call-region-evict-mark-busy! pool busy r1))]
            [_ unit])]
        [(CompilerRegMaybeLocation.No) unit]))))

(define (compiler-reg-call-region-evict-mark-busy!
  [pool : (__tl_dyn-array i64)]
  [busy : (__tl_dyn-array i64)]
  [reg : i64]) : unit
  (let
    [pi : i64 (compiler-reg-call-region-pool-index-of pool reg)]
    (when
      (and (>= pi 0) (< pi (array-length busy)))
      (set! (array-ref busy pi) 1))))

(define (compiler-reg-call-region-evict-mark-set!
  [set : live.CompilerLiveI64Set]
  [n : i64]
  [parents : (__tl_dyn-array i64)]
  [assignments : CompilerRegAssignmentTable]
  [pool : (__tl_dyn-array i64)]
  [stamp : (__tl_dyn-array i64)]
  [busy : (__tl_dyn-array i64)]) : unit
  (let
    [wi : i64 0]
    [wc : i64 (live.compiler-live-set-word-count set)]
    (while (< wi wc)
      (let
        [bits : i64 (live.compiler-live-set-word-at-bounded set wi)]
        (begin
          (while (not (= bits 0))
            (let
              [b : i64 (compiler-reg-low-bit-index32 bits)]
              (begin
                (compiler-reg-call-region-evict-mark-var!
                  (+ (* wi (live.compiler-live-set-word-bits)) b)
                  n
                  parents
                  assignments
                  pool
                  stamp
                  busy)
                (set! bits (bit-and bits (- bits 1))))))
          (set! wi (+ wi 1)))))))

;; Every var one instruction touches -- uses AND def. Unlike the candidate
;; walker this counts a phi's INPUTS too: they are read on the edges into the
;; block, which for a victim is a read the eviction must not hide.
(define (compiler-reg-call-region-evict-mark-instr!
  [instr : ir.CompilerIrInstr]
  [n : i64]
  [parents : (__tl_dyn-array i64)]
  [assignments : CompilerRegAssignmentTable]
  [pool : (__tl_dyn-array i64)]
  [stamp : (__tl_dyn-array i64)]
  [busy : (__tl_dyn-array i64)]) : unit
  (let
    [ids : (__tl_dyn-array i64) (live.compiler-live-instr-ids)]
    [id-count : i64 (live.compiler-live-instr-use-ids! instr)]
    (begin
      (if (< id-count 0)
        (compiler-reg-call-region-evict-mark-set!
          (live.compiler-live-instr-uses instr)
          n
          parents
          assignments
          pool
          stamp
          busy)
        (let
          [index : i64 0]
          (while (< index id-count)
            (begin
              (compiler-reg-call-region-evict-mark-var!
                (array-ref ids index)
                n
                parents
                assignments
                pool
                stamp
                busy)
              (set! index (+ index 1))))))
      (compiler-reg-call-region-evict-mark-var!
        (live.compiler-live-instr-def-var instr)
        n
        parents
        assignments
        pool
        stamp
        busy))))

;; Mark every var mentioned at a point in [lo,hi]. Blocks [s..e] are walked
;; whole and the point filter drops the preheader's prefix, so the ANCHOR
;; instruction (the last of block h-1, at exactly `lo`) is included.
(define (compiler-reg-call-region-evict-mark-blocks!
  [bslots : (__tl_dyn-array ir.CompilerIrBlock)]
  [points : (__tl_dyn-array i64)]
  [s : i64]
  [e : i64]
  [lo : i64]
  [n : i64]
  [parents : (__tl_dyn-array i64)]
  [assignments : CompilerRegAssignmentTable]
  [pool : (__tl_dyn-array i64)]
  [stamp : (__tl_dyn-array i64)]
  [busy : (__tl_dyn-array i64)]) : unit
  (let
    [b : i64 s]
    (while (<= b e)
      (match (array-ref bslots b)
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [islots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
            [ilen : i64 (ir.compiler-ir-instr-seq-count instrs)]
            [i : i64 0]
            [point : i64 (array-ref points b)]
            (begin
              (while (< i ilen)
                (begin
                  (when
                    (>= point lo)
                    (compiler-reg-call-region-evict-mark-instr!
                      (array-ref islots i)
                      n
                      parents
                      assignments
                      pool
                      stamp
                      busy))
                  (set! point (+ point 2))
                  (set! i (+ i 1))))
              (set! b (+ b 1))))]))))

;; Does any var of the coalesce CLASS rooted at `vr` appear in this set?
(define (compiler-reg-call-region-evict-set-hits-class?
  [set : live.CompilerLiveI64Set]
  [parents : (__tl_dyn-array i64)]
  [n : i64]
  [vr : i64]) : bool
  (let
    [wi : i64 0]
    [wc : i64 (live.compiler-live-set-word-count set)]
    (begin
      (while (< wi wc)
        (let
          [bits : i64 (live.compiler-live-set-word-at-bounded set wi)]
          (begin
            (while (not (= bits 0))
              (let
                [u : i64
                  (+
                    (* wi (live.compiler-live-set-word-bits))
                    (compiler-reg-low-bit-index32 bits))]
                (begin
                  (when
                    (= (compiler-reg-call-region-root parents n u) vr)
                    (return true))
                  (set! bits (bit-and bits (- bits 1))))))
            (set! wi (+ wi 1)))))
      false)))

;; VERIFIER. The search decides on the stamp array above; this asks the same
;; question for ONE coalesce class down an independent path (set membership plus
;; the def accessor, no shared id buffer), so a bug in either one cannot pass
;; both. Class-scoped for the same reason the stamp is: siblings share storage,
;; so a sibling's read is a read of the register the eviction is lending out.
(define (compiler-reg-call-region-evict-var-mentioned?
  [bslots : (__tl_dyn-array ir.CompilerIrBlock)]
  [points : (__tl_dyn-array i64)]
  [s : i64]
  [e : i64]
  [lo : i64]
  [parents : (__tl_dyn-array i64)]
  [n : i64]
  [v : i64]) : bool
  (let
    [b : i64 s]
    [vr : i64 (compiler-reg-call-region-root parents n v)]
    (begin
      (while (<= b e)
        (match (array-ref bslots b)
          [(ir.CompilerIrBlock.Block _ instrs)
            (let
              [islots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
              [ilen : i64 (ir.compiler-ir-instr-seq-count instrs)]
              [i : i64 0]
              [point : i64 (array-ref points b)]
              (begin
                (while (< i ilen)
                  (let
                    [instr : ir.CompilerIrInstr (array-ref islots i)]
                    (begin
                      (when
                        (and
                          (>= point lo)
                          (or
                            (=
                              (compiler-reg-call-region-root
                                parents
                                n
                                (live.compiler-live-instr-def-var instr))
                              vr)
                            (compiler-reg-call-region-evict-set-hits-class?
                              (live.compiler-live-instr-uses instr)
                              parents
                              n
                              vr)))
                        (return true))
                      (set! point (+ point 2))
                      (set! i (+ i 1)))))
                (set! b (+ b 1))))]))
      false)))

;; A reload target only has to be a block whose head accepts an instruction.
;;
;; It does NOT have to be entered exclusively from the region -- that is the
;; whole reason the save sits at the victim's definition rather than at the
;; region anchor. A reload reached from OUTSIDE the region writes the victim's
;; own value back over itself:
;;
;;   * the slot is correct there, because the sole definition refreshes it and
;;     dominates every point the victim is live at, and
;;   * nothing else is destroyed, because the reload only runs where the victim
;;     is live, and a live victim means no other value can be sharing its
;;     register at that point -- they would interfere.
;;
;; Measurement is what forced this: on the liveness/gvn/cfg corpus EVERY exit
;; edge of a rescue region is critical (versioned loop clones merge into shared
;; tails), so an anchor-saved eviction could never place a single reload.
;;
;; 0 = usable; the nonzero codes name the refusals for the census.
(define (compiler-reg-call-region-evict-exit-target-status
  [bslots : (__tl_dyn-array ir.CompilerIrBlock)]
  [nblocks : i64]
  [t : i64]) : i64
  (if (or (< t 0) (>= t nblocks))
    1
    (match (array-ref bslots t)
      [(ir.CompilerIrBlock.Block _ instrs)
        (if (<= (ir.compiler-ir-instr-seq-count instrs) 0)
          3
          (match (ir.compiler-ir-instr-seq-ref instrs 0)
            [(ir.CompilerIrInstr.Phi _ _ _) 3]
            [_ 0]))])))

;; Is `v` alone in its coalesce class? Siblings share storage but are DISTINCT
;; values at disjoint times, so a class with members breaks the "a live victim
;; owns its register alone" argument the reload placement rests on: a sibling
;; could be the value in the register at a reload point. v1 takes only
;; singletons.
(define (compiler-reg-call-region-evict-class-singleton?
  [parents : (__tl_dyn-array i64)]
  [n : i64]
  [v : i64]) : bool
  (let
    [u : i64 0]
    (begin
      (unless (= (compiler-reg-call-region-root parents n v) v) (return false))
      (while (< u n)
        (begin
          (when
            (and
              (not (= u v))
              (= (compiler-reg-call-region-root parents n u) v))
            (return false))
          (set! u (+ u 1))))
      true)))

;; Save points for the victim: the point just AFTER each of its defining
;; instructions, which is where the slot mirror is written. Every def has to be
;; mirrored -- one missed def leaves the slot stale against the register, which
;; is the whole invariant the reload placement rests on.
;;
;; A ZERO-def victim -- a parameter, whose value the prologue establishes and no
;; instruction ever rewrites -- is mirrored once at the function's first point,
;; which dominates everything by construction. That population is not marginal:
;; it is what the liveness flagship's parked pool registers actually hold.
;;
;; Negative results refuse and say why: -2 the def is a phi (an edge def; a
;; mirror between phis would break the block's phi prefix), -3 it is its block's
;; last instruction (the mirror has to stay in the same block), -4 it is not
;; strictly before the region (a parked value is defined before the loop, so a
;; later def means the interval overlap was a hull artifact), -5 more defs than
;; `cap` -- each costs a store at its own frequency.
(define (compiler-reg-call-region-evict-def-points!
  [bslots : (__tl_dyn-array ir.CompilerIrBlock)]
  [points : (__tl_dyn-array i64)]
  [nblocks : i64]
  [v : i64]
  [lo : i64]
  [cap : i64]
  [out : (__tl_dyn-array i64)]) : i64
  (let
    [b : i64 0]
    [count : i64 0]
    (begin
      (while (< b nblocks)
        (match (array-ref bslots b)
          [(ir.CompilerIrBlock.Block _ instrs)
            (let
              [islots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
              [ilen : i64 (ir.compiler-ir-instr-seq-count instrs)]
              [i : i64 0]
              (begin
                (while (< i ilen)
                  (let
                    [instr : ir.CompilerIrInstr (array-ref islots i)]
                    (begin
                      (when
                        (= (live.compiler-live-instr-def-var instr) v)
                        (let
                          [p : i64 (+ (array-ref points b) (* 2 i))]
                          (begin
                            (match instr
                              [(ir.CompilerIrInstr.Phi _ _ _) (return (- 0 2))]
                              [_ unit])
                            (when (>= i (- ilen 1)) (return (- 0 3)))
                            (when (>= p lo) (return (- 0 4)))
                            (when (>= count cap) (return (- 0 5)))
                            (set! (array-ref out count) (+ p 2))
                            (set! count (+ count 1)))))
                      (set! i (+ i 1)))))
                (set! b (+ b 1))))]))
      (if (= count 0)
        (begin
          (set! (array-ref out 0) 0)
          1)
        count))))

;; Defs of one victim that the save protocol will mirror. Two is already an
;; if/else assigning the same value; beyond that the stores stop being boundary
;; code.
(define (compiler-reg-call-region-evict-def-cap) : i64
  2)

(define (compiler-reg-call-region-evict-block-of-point
  [points : (__tl_dyn-array i64)]
  [nblocks : i64]
  [p : i64]) : i64
  (let
    [b : i64 0]
    [found : i64 0]
    (begin
      (while (< b nblocks)
        (begin
          (when (<= (array-ref points b) p) (set! found b))
          (set! b (+ b 1))))
      found)))

(define (compiler-reg-call-region-evict-point-recorded?
  [out : (__tl_dyn-array i64)]
  [count : i64]
  [p : i64]) : bool
  (let
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (when (= (array-ref out i) p) (return true))
          (set! i (+ i 1))))
      false)))

;; Distinct reload points for the natural loop [h..e], one per exit TARGET.
;; -1 refuses the candidate: an exit edge whose target cannot host a reload
;; (phi head, empty block, unresolved label) or more targets than the cap.
(define (compiler-reg-call-region-evict-exit-points!
  [bslots : (__tl_dyn-array ir.CompilerIrBlock)]
  [nblocks : i64]
  [ids : reg_label_i64_map.Map]
  [points : (__tl_dyn-array i64)]
  [h : i64]
  [e : i64]
  [out : (__tl_dyn-array i64)]) : i64
  (let
    [b : i64 h]
    [count : i64 0]
    (begin
      (while (<= b e)
        (let
          [succs : live.CompilerLiveLabelSet
            (live.compiler-live-block-successors (array-ref bslots b))]
          [more : bool true]
          (begin
            (while more
              (match succs
                [(live.CompilerLiveLabelSet.Nil) (set! more false)]
                [(live.CompilerLiveLabelSet.Dense _ _)
                  (begin
                    (match (reg_label_i64_map.get
                      (& ids)
                      (live.compiler-live-label-set-ref succs 0))
                      [(reg_label_i64_map.LookupFound t)
                        (when
                          (or (< t h) (> t e))
                          (let
                            [status : i64
                              (compiler-reg-call-region-evict-exit-target-status
                                bslots
                                nblocks
                                t)]
                            (begin
                              (unless
                                (= status 0)
                                (begin
                                  (cfg
                                    regalloc-census
                                    (compiler-reg-evict-census-bump!
                                      (+ 8 status))
                                    unit)
                                  (return (- 0 1))))
                              (unless
                                (compiler-reg-call-region-evict-point-recorded?
                                  out
                                  count
                                  (array-ref points t))
                                (begin
                                  (when
                                    (>=
                                      count
                                      (compiler-reg-call-region-evict-exit-cap))
                                    (begin
                                      (cfg
                                        regalloc-census
                                        (compiler-reg-evict-census-bump! 12)
                                        unit)
                                      (return (- 0 1))))
                                  (set!
                                    (array-ref out count)
                                    (array-ref points t))
                                  (set! count (+ count 1)))))))]
                      [(reg_label_i64_map.LookupMissing)
                        (begin
                          (cfg
                            regalloc-census
                            (compiler-reg-evict-census-bump! 13)
                            unit)
                          (return (- 0 1)))])
                    (set! succs (live.compiler-live-label-set-tail succs)))]))
            (set! b (+ b 1)))))
      count)))

;; Occupant kinds recorded alongside the pool-register occupancy index.
(define (compiler-reg-call-region-occ-kind-scalar) : i64
  0)

(define (compiler-reg-call-region-occ-kind-pair) : i64
  1)

(define (compiler-reg-call-region-occ-kind-shadow) : i64
  2)

;; The ONE value occupying pool register `pix` over [lo,hi], or -1 when there is
;; none, when two DISTINCT values share it, or when any of them is a register
;; pair half / an already accepted shadow. Identity is the coalesce ROOT, not
;; the var: storage-shared siblings are one value with one home, so counting
;; them separately would refuse every multi-member class outright. A shadow
;; occupant is by definition read inside its own region.
(define (compiler-reg-call-region-evict-sole-occupant
  [occ-var : (__tl_dyn-array i64)]
  [occ-reg : (__tl_dyn-array i64)]
  [occ-kind : (__tl_dyn-array i64)]
  [occ-n : i64]
  [interval-index : CompilerRegIntervalIndex]
  [parents : (__tl_dyn-array i64)]
  [n : i64]
  [pix : i64]
  [lo : i64]
  [hi : i64]) : i64
  (let
    [j : i64 0]
    [found : i64 (- 0 1)]
    [found-root : i64 (- 0 1)]
    (begin
      (while (< j occ-n)
        (begin
          (when
            (and
              (= (array-ref occ-reg j) pix)
              (compiler-reg-call-region-var-overlaps?
                interval-index
                (array-ref occ-var j)
                lo
                hi))
            (let
              [rr : i64
                (compiler-reg-call-region-root parents n (array-ref occ-var j))]
              (begin
                (unless
                  (=
                    (array-ref occ-kind j)
                    (compiler-reg-call-region-occ-kind-scalar))
                  (return (- 0 1)))
                (unless (or (< found 0) (= rr found-root)) (return (- 0 1)))
                (when
                  (< found 0)
                  (begin
                    (set! found (array-ref occ-var j))
                    (set! found-root rr))))))
          (set! j (+ j 1))))
      found)))

;; May the victim still be live at `p`? Intervals cover every live point, so a
;; miss is proof of deadness and the reload can be dropped; a var with no
;; interval data of its own answers through its coalesce root, and an unknown
;; var answers "live" (compiler-reg-call-region-var-overlaps? returns true out
;; of range). A false "live" costs one dead reload; a false "dead" is a
;; miscompile, which is why both views are consulted.
(define (compiler-reg-call-region-evict-live-at?
  [interval-index : CompilerRegIntervalIndex]
  [parents : (__tl_dyn-array i64)]
  [n : i64]
  [v : i64]
  [p : i64]) : bool
  (or
    (compiler-reg-call-region-var-overlaps? interval-index v p p)
    (compiler-reg-call-region-var-overlaps?
      interval-index
      (compiler-reg-call-region-root parents n v)
      p
      p)))

(define (compiler-reg-call-region-evict-weight
  [weights : (__tl_dyn-array i64)]
  [v : i64]) : i64
  (if (and (>= v 0) (< v (array-length weights)))
    (array-ref weights v)
    0))

;; PRICING. The invariant's uses run at LOOP depth, amplified by the trip factor
;; for each level the body sits below the anchor -- see
;; compiler-reg-call-region-trip-multiplier for why the raw depth ladder cannot
;; carry this inequality. Against that: the shadow load once per loop ENTRY, one
;; reload per live exit (an exit target of a loop at depth d sits at depth <= d,
;; so the anchor's weight bounds it), and the victim's store at the frequency of
;; its DEFINITION -- a separate number, and the one that sinks the trade when the
;; parked value is recomputed inside an enclosing loop.
;;
;; The 2x margin stays ON TOP of the trip estimate. It is what still refuses a
;; region whose only justification is a use that does not sit below the cost
;; point at all (delta 0 -> multiplier 1, the old arithmetic), and a victim whose
;; store lands in an enclosing loop.
;;
;; SINGLE-USE FLOOR, and it is measured, not assumed. An eviction is not a free
;; rescue: the victim's save sits at its DEFINITION, which for the parameter
;; victims this pass actually finds is the function entry -- so the store runs on
;; every call, including calls that never reach the region, while the benefit
;; accrues only when the loop is entered. No depth model sees that asymmetry:
;; the ladder rates a function-entry block and an unconditionally-reached
;; preheader as equally frequent. Landing the trip factor without this floor
;; activated exactly one site in the whole 22-row corpus --
;; liveness_storage's live_out_into_bang, two victims serving ONE in-region use
;; each -- and cost 878,505 Ir there (+0.116% on the row), while the flagship
;; recompute_bang did not move at all. Two or more in-region uses is the same
;; floor the block rows have carried since M-G2b, and it is the margin the
;; conditional-entry gap needs.
(define (compiler-reg-call-region-evict-use-floor) : i64
  2)

(define (compiler-reg-call-region-evict-price-ok?
  [uses : i64]
  [body-depth : i64]
  [entry-depth : i64]
  [def-weight : i64]
  [exits : i64]) : bool
  (and
    (>= uses (compiler-reg-call-region-evict-use-floor))
    (>=
      (*
        (* uses (compiler-reg-loop-depth-weight body-depth))
        (compiler-reg-call-region-trip-multiplier (- body-depth entry-depth)))
      (*
        2
        (+
          (* (+ 1 exits) (compiler-reg-loop-depth-weight entry-depth))
          def-weight)))))

;; Summed frequency weight of the victim's save stores.
(define (compiler-reg-call-region-evict-def-weight
  [points : (__tl_dyn-array i64)]
  [nblocks : i64]
  [depths : (__tl_dyn-array i64)]
  [saves : (__tl_dyn-array i64)]
  [count : i64]) : i64
  (let
    [i : i64 0]
    [total : i64 0]
    (begin
      (while (< i count)
        (begin
          (set!
            total
            (+
              total
              (compiler-reg-loop-depth-weight
                (array-ref
                  depths
                  (compiler-reg-call-region-evict-block-of-point
                    points
                    nblocks
                    (- (array-ref saves i) 2))))))
          (set! i (+ i 1))))
      total)))

;; Locate the region's header/end block pair from its point range: a loop row's
;; lo is the point BEFORE block h's first instruction and its hi is the point of
;; block e's last one, so points[h] = lo+2 and points[e+1] = hi+2.
(define (compiler-reg-call-region-evict-header-of
  [points : (__tl_dyn-array i64)]
  [nblocks : i64]
  [lo : i64]) : i64
  (let
    [b : i64 1]
    (begin
      (while (< b nblocks)
        (begin
          (when (= (array-ref points b) (+ lo 2)) (return b))
          (set! b (+ b 1))))
      (- 0 1))))

(define (compiler-reg-call-region-evict-end-of
  [points : (__tl_dyn-array i64)]
  [nblocks : i64]
  [h : i64]
  [hi : i64]) : i64
  (let
    [b : i64 h]
    (begin
      (while (< b nblocks)
        (begin
          (when (= (array-ref points (+ b 1)) (+ hi 2)) (return b))
          (set! b (+ b 1))))
      (- 0 1))))

;; One eviction attempt for loop region [lo,hi] of `root`. Returns the pool
;; index to lend, the victim, and the number of reload points left in
;; `out-points` after the liveness filter.
(define (compiler-reg-call-region-evict-try
  [blocks : ir.CompilerIrBlockList]
  [depths : (__tl_dyn-array i64)]
  [weights : (__tl_dyn-array i64)]
  [interval-index : CompilerRegIntervalIndex]
  [parents : (__tl_dyn-array i64)]
  [assignments : CompilerRegAssignmentTable]
  [pool : (__tl_dyn-array i64)]
  [pool-count : i64]
  [occ-var : (__tl_dyn-array i64)]
  [occ-reg : (__tl_dyn-array i64)]
  [occ-kind : (__tl_dyn-array i64)]
  [occ-n : i64]
  [evicted : (__tl_dyn-array i64)]
  [root : i64]
  [uses : i64]
  [lo : i64]
  [hi : i64]
  [n : i64]
  [out-points : (__tl_dyn-array i64)]
  [out-saves : (__tl_dyn-array i64)]) : CompilerRegCallEvictPick
  (let
    [seq : ir.CompilerIrBlockSeq
      (live.compiler-live-ir-block-list-to-seq blocks)]
    [bslots : (__tl_dyn-array ir.CompilerIrBlock) seq.slots]
    [nblocks : i64 seq.len]
    (if (< nblocks 2)
      (CompilerRegCallEvictPick.CompilerRegCallEvictNoPick)
      (let
        [points : (__tl_dyn-array i64)
          (compiler-reg-loop-phi-mb-block-points bslots)]
        [h : i64 (compiler-reg-call-region-evict-header-of points nblocks lo)]
        (if (< h 1)
          (CompilerRegCallEvictPick.CompilerRegCallEvictNoPick)
          (let
            [e : i64
              (compiler-reg-call-region-evict-end-of points nblocks h hi)]
            [ids : reg_label_i64_map.Map
              (compiler-reg-loop-depth-block-ids
                blocks
                (reg_label_i64_map.with-capacity
                  (compiler-reg-bits-map-capacity nblocks))
                0)]
            (if (< e h)
              (CompilerRegCallEvictPick.CompilerRegCallEvictNoPick)
              (let
                [ranges : (__tl_dyn-array i64)
                  (compiler-reg-call-region-pred-ranges bslots nblocks ids)]
                (if (not
                  (compiler-reg-call-region-loop-admit?
                    ranges
                    depths
                    nblocks
                    h
                    e))
                  (CompilerRegCallEvictPick.CompilerRegCallEvictNoPick)
                  (let
                    ;; Victim search first, exits second. Both orders decide the
                    ;; same candidates; this one makes the census say whether a
                    ;; corpus lacks PARKED VALUES or merely lacks placeable
                    ;; exits, which are different problems with different fixes.
                    [raw-exits : i64 0]
                    [stamp : (__tl_dyn-array i64)
                      (array.make-array
                        i64
                        (if (< n 1)
                          1
                          n))]
                    [busy : (__tl_dyn-array i64)
                      (array.make-array
                        i64
                        (if (< pool-count 1)
                          1
                          pool-count))]
                    [victim : i64 (- 0 1)]
                    [victim-pix : i64 (- 0 1)]
                    [victim-weight : i64 0]
                    [pix : i64 0]
                    (begin
                      (compiler-reg-call-region-evict-mark-blocks!
                        bslots
                        points
                        (- h 1)
                        e
                        lo
                        n
                        parents
                        assignments
                        pool
                        stamp
                        busy)
                      (while (< pix pool-count)
                        (let
                          [o : i64
                            (if (and
                              (= (array-ref busy pix) 0)
                              (compiler-reg-call-region-loop-pool-reg-ok?
                                (array-ref pool pix)))
                              (compiler-reg-call-region-evict-sole-occupant
                                occ-var
                                occ-reg
                                occ-kind
                                occ-n
                                interval-index
                                parents
                                n
                                pix
                                lo
                                hi)
                              (- 0 1))]
                          (begin
                            (when
                              (>= o 0)
                              (begin
                                (cfg
                                  regalloc-census
                                  (compiler-reg-evict-census-bump! 5)
                                  unit)
                                (when
                                  (and
                                    (not (= o root))
                                    (< o n)
                                    (= (array-ref evicted o) 0)
                                    (= (array-ref stamp o) 0)
                                    ;; parked as a CLASS: a storage-shared
                                    ;; sibling's read is a read of this
                                    ;; register
                                    (=
                                      (array-ref
                                        stamp
                                        (compiler-reg-call-region-root
                                          parents
                                          n
                                          o))
                                      0)
                                    (compiler-reg-call-region-evict-class-singleton?
                                      parents
                                      n
                                      o))
                                  (let
                                    [w : i64
                                      (compiler-reg-call-region-evict-weight
                                        weights
                                        o)]
                                    (begin
                                      (cfg
                                        regalloc-census
                                        (compiler-reg-evict-census-bump! 6)
                                        unit)
                                      (when
                                        (or (< victim 0) (< w victim-weight))
                                        (begin
                                          (set! victim o)
                                          (set! victim-pix pix)
                                          (set! victim-weight w))))))))
                            (set! pix (+ pix 1)))))
                      (if (< victim 0)
                        (begin
                          (cfg
                            regalloc-census
                            (compiler-reg-evict-census-bump! 3)
                            unit)
                          (CompilerRegCallEvictPick.CompilerRegCallEvictNoPick))
                        (if (compiler-reg-call-region-evict-var-mentioned?
                          bslots
                          points
                          (- h 1)
                          e
                          lo
                          parents
                          n
                          victim)
                          (begin
                            (cfg
                              regalloc-census
                              (compiler-reg-evict-census-bump! 7)
                              unit)
                            (CompilerRegCallEvictPick.CompilerRegCallEvictNoPick))
                          (let
                            [live-exits : i64 0]
                            [i : i64 0]
                            [def-count : i64
                              (compiler-reg-call-region-evict-def-points!
                                bslots
                                points
                                nblocks
                                victim
                                lo
                                (compiler-reg-call-region-evict-def-cap)
                                out-saves)]
                            (begin
                              ;; The save mirrors the victim into its slot
                              ;; right after EVERY definition, so a reload --
                              ;; on any edge, reached from inside the region
                              ;; or not -- reads the current value.
                              (when
                                (< def-count 1)
                                (begin
                                  (cfg
                                    regalloc-census
                                    (compiler-reg-evict-census-bump!
                                      (- 12 def-count))
                                    unit)
                                  (return
                                    (CompilerRegCallEvictPick.CompilerRegCallEvictNoPick))))
                              (set!
                                raw-exits
                                (compiler-reg-call-region-evict-exit-points!
                                  bslots
                                  nblocks
                                  ids
                                  points
                                  h
                                  e
                                  out-points))
                              (when
                                (< raw-exits 0)
                                (begin
                                  (cfg
                                    regalloc-census
                                    (compiler-reg-evict-census-bump! 2)
                                    unit)
                                  (return
                                    (CompilerRegCallEvictPick.CompilerRegCallEvictNoPick))))
                              (while (< i raw-exits)
                                (begin
                                  (when
                                    (compiler-reg-call-region-evict-live-at?
                                      interval-index
                                      parents
                                      n
                                      victim
                                      (array-ref out-points i))
                                    (begin
                                      (set!
                                        (array-ref out-points live-exits)
                                        (array-ref out-points i))
                                      (set! live-exits (+ live-exits 1))))
                                  (set! i (+ i 1))))
                              (if (compiler-reg-call-region-evict-price-ok?
                                uses
                                (array-ref depths h)
                                (array-ref depths (- h 1))
                                (compiler-reg-call-region-evict-def-weight
                                  points
                                  nblocks
                                  depths
                                  out-saves
                                  def-count)
                                live-exits)
                                (CompilerRegCallEvictPick.CompilerRegCallEvictSomePick
                                  victim-pix
                                  victim
                                  live-exits
                                  def-count)
                                (begin
                                  (cfg
                                    regalloc-census
                                    (begin
                                      (compiler-reg-evict-census-bump! 4)
                                      ;; how far short: 18 counts the ones
                                      ;; that clear a bare break-even, so
                                      ;; the report can say whether the
                                      ;; safety margin or the model itself
                                      ;; is what refuses a corpus
                                      (when
                                        (>=
                                          (*
                                            (*
                                              uses
                                              (compiler-reg-loop-depth-weight
                                                (array-ref depths h)))
                                            (compiler-reg-call-region-trip-multiplier
                                              (-
                                                (array-ref depths h)
                                                (array-ref depths (- h 1)))))
                                          (+
                                            (*
                                              (+ 1 live-exits)
                                              (compiler-reg-loop-depth-weight
                                                (array-ref depths (- h 1))))
                                            (compiler-reg-call-region-evict-def-weight
                                              points
                                              nblocks
                                              depths
                                              out-saves
                                              def-count)))
                                        (compiler-reg-evict-census-bump! 18)))
                                    unit)
                                  (CompilerRegCallEvictPick.CompilerRegCallEvictNoPick))))))))))))))))))

;; Mark candidate roots in `cand` (spilled + register-eligible scalar/handle
;; type + no remat-candidate class member -- a remat'd value has no stable slot
;; to reload from) and record their ids in walk order in `order`. Returns the
;; candidate count.
;;
;; TWO candidate grades, because the two region shapes want different
;; populations:
;;
;;   cand = compiler-reg-call-region-cand-full (1): the hull ALSO spans a
;;   kind-0 clobber. This is the block-region population and it is unchanged --
;;   the enumeration walk and every block row test for exactly this value, so
;;   block-scoped codegen is bit-for-bit what it was.
;;
;;   cand = compiler-reg-call-region-cand-loop (2): everything above EXCEPT the
;;   kind-0 span. The block rescue exists to bridge calls, so a value that never
;;   crosses one was rightly out of scope for it. Loop rows are a different
;;   class entirely: their cost is pure register PRESSURE inside a call-free
;;   loop, and measurement says that is where the flagship lives -- in
;;   liveness_storage's `recompute!` ten of the spilled values covering the hot
;;   versioned clone report k0 = 0, so the kind-0 gate alone was hiding the
;;   whole target population. Loop rows therefore accept both grades.
(define (compiler-reg-call-region-mark-candidates
  [candidates : CompilerRegIntervalSeq]
  [index : i64]
  [assignments : CompilerRegAssignmentTable]
  [type-info : CompilerRegVarTypes]
  [group-vars : live.CompilerLiveI64Set]
  [kind0 : live.CompilerLiveI64Set]
  [root-has-remat : (__tl_dyn-array i64)]
  [n : i64]
  [cand : (__tl_dyn-array i64)]
  [order : (__tl_dyn-array i64)]
  [count : i64]) : i64
  (if (>= index (compiler-reg-interval-seq-count candidates))
    count
    (let
      [interval : CompilerRegInterval
        (compiler-reg-interval-seq-ref candidates index)]
      [var : i64 interval.var]
      [start : i64 interval.start]
      [end : i64 interval.end]
      ;; lint-allow: single-begin
      (begin
        (if (and
          (>= var 0)
          (< var n)
          (= (array-ref root-has-remat var) 0)
          (match (compiler-reg-loop-split-type-ok? type-info group-vars var)
            [(CompilerRegMaybeType.Some _) true]
            [(CompilerRegMaybeType.No) false])
          (match (compiler-reg-assignment-table-lookup assignments var)
            [(CompilerRegMaybeLocation.Some location)
              (match location
                [(CompilerRegLocation.Spill _) true]
                [_ false])]
            [(CompilerRegMaybeLocation.No) false]))
          (begin
            (set!
              (array-ref cand var)
              (if (compiler-reg-call-set-in-range? kind0 start end)
                (compiler-reg-call-region-cand-full)
                (compiler-reg-call-region-cand-loop)))
            (set! (array-ref order count) var)
            (compiler-reg-call-region-mark-candidates
              candidates
              (+ index 1)
              assignments
              type-info
              group-vars
              kind0
              root-has-remat
              n
              cand
              order
              (+ count 1)))
          (compiler-reg-call-region-mark-candidates
            candidates
            (+ index 1)
            assignments
            type-info
            group-vars
            kind0
            root-has-remat
            n
            cand
            order
            count))))))

;; The widened rescue entry point (M-G2b): enumerate every candidate root's
;; call-free regions, select the profitable ones, and home each accepted
;; root's regions in one caller-saved shadow register. The assignment table
;; is returned UNCHANGED (shadow roots stay spilled; the region table drives
;; the backend rewrite).
(define (compiler-reg-assign-caller-saved-call-spanning
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [candidates : CompilerRegIntervalSeq]
  [assignments : CompilerRegAssignmentTable]
  [interval-index : CompilerRegIntervalIndex]
  [type-info : CompilerRegVarTypes]
  [group-vars : live.CompilerLiveI64Set]
  [parents : (__tl_dyn-array i64)]
  ;; the greedy's coalesced spill weights, which order eviction victims
  ;; coldest-first; empty is tolerated (every victim then scores 0)
  [weights : (__tl_dyn-array i64)]) : CompilerRegCallSaveAssignState
  (let
    [starts : (__tl_dyn-array i64) interval-index.starts]
    [ends : (__tl_dyn-array i64) interval-index.ends]
    [n : i64 (array-length starts)]
    [an : i64
      (if (< n 1)
        1
        n)]
    [kind0 : live.CompilerLiveI64Set
      (compiler-reg-clobber-kind-points type-segment-bases func 0)]
    [remat-cands : (__tl_dyn-array i64)
      (__tl-project-field (compiler-reg-remat-table-build func) candidates)]
    [root-has-remat : (__tl_dyn-array i64) (array.make-array i64 an)]
    [cand : (__tl_dyn-array i64) (array.make-array i64 an)]
    [order : (__tl_dyn-array i64) (array.make-array i64 an)]
    [v : i64 0]
    (begin
      (while (< v (array-length remat-cands))
        (begin
          (if (= (array-ref remat-cands v) 1)
            (let
              [rr : i64 (compiler-reg-call-region-root parents n v)]
              (if (and (>= rr 0) (< rr n))
                (set! (array-ref root-has-remat rr) 1)
                unit))
            unit)
          (set! v (+ v 1))))
      (let
        [root-count : i64
          (compiler-reg-call-region-mark-candidates
            candidates
            0
            assignments
            type-info
            group-vars
            kind0
            root-has-remat
            n
            cand
            order
            0)]
        [cand-count : i64 root-count]
        ;; Per-var live-after horizon: the var's coalesce ROOT's merged hull
        ;; end (members have no eff-index entry of their own); unknown ->
        ;; conservative far end (an unneeded exit store is safe, a missing
        ;; one is a miscompile).
        [vend : (__tl_dyn-array i64) (array.make-array i64 an)]
        (begin
          ;; extend candidacy to coalesce-class MEMBERS of accepted roots:
          ;; their refs are attributed per-var (see note-set!), so each member
          ;; needs its own candidacy bit, type gate included.
          (let
            [v : i64 0]
            (while (< v n)
              (begin
                (if (and
                  (> root-count 0)
                  (= (array-ref cand v) 0)
                  (let
                    [rr : i64 (compiler-reg-call-region-root parents n v)]
                    (and (not (= rr v)) (> (array-ref cand rr) 0)))
                  (match (compiler-reg-loop-split-type-ok?
                    type-info
                    group-vars
                    v)
                    [(CompilerRegMaybeType.Some _) true]
                    [(CompilerRegMaybeType.No) false]))
                  (begin
                    ;; a member inherits its root's GRADE, so a loop-only class
                    ;; stays out of the block walk exactly as its root does
                    (set!
                      (array-ref cand v)
                      (array-ref
                        cand
                        (compiler-reg-call-region-root parents n v)))
                    (set! (array-ref order cand-count) v)
                    (set! cand-count (+ cand-count 1)))
                  unit)
                (set! v (+ v 1)))))
          (let
            [v : i64 0]
            (while (< v n)
              (begin
                (let
                  [rr : i64 (compiler-reg-call-region-root parents n v)]
                  (set!
                    (array-ref vend v)
                    (if (and
                      (>= rr 0)
                      (< rr (array-length ends))
                      (>= (array-ref ends rr) 0))
                      (array-ref ends rr)
                      1073741824)))
                (set! v (+ v 1)))))
          (if (= cand-count 0)
            (CompilerRegCallSaveAssignState.State
              assignments
              (compiler-reg-call-split-empty))
            (match func
              [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
                (let
                  [depths : (__tl_dyn-array i64)
                    (compiler-reg-function-loop-depths blocks)]
                  [buckets : (__tl_dyn-array CompilerRegCallRegionStatSeq)
                    (array.make-array CompilerRegCallRegionStatSeq an)]
                  [present : (__tl_dyn-array i64) assignments.present]
                  [items : (__tl_dyn-array CompilerRegLocation)
                    assignments.items]
                  [base-pool : (__tl_dyn-array i64)
                    (compiler-reg-call-region-pool target-abi)]
                  [base-pool-count : i64 (array-length base-pool)]
                  [pool : (__tl_dyn-array i64)
                    (compiler-reg-call-region-pool-with-loop-tail
                      base-pool
                      target-abi
                      present
                      items
                      n)]
                  [pool-count : i64 (array-length pool)]
                  ;; occupants of the pool registers (var id + pool index); a
                  ;; register PAIR can contribute two entries and every accepted
                  ;; shadow root appends one, so size 3n bounds it.
                  [occ-var : (__tl_dyn-array i64)
                    (array.make-array i64 (+ (* 3 an) 1))]
                  [occ-reg : (__tl_dyn-array i64)
                    (array.make-array i64 (+ (* 3 an) 1))]
                  ;; scalar / pair-half / accepted-shadow, so the eviction
                  ;; search can tell a lendable home from one it must not touch
                  [occ-kind : (__tl_dyn-array i64)
                    (array.make-array i64 (+ (* 3 an) 1))]
                  [occ-n : i64 0]
                  ;; one lend per victim per function (the greedy's single-
                  ;; evictee discipline): the second root wanting the same
                  ;; parked value refuses rather than nesting two save/reload
                  ;; protocols over the same register
                  [evicted : (__tl_dyn-array i64) (array.make-array i64 an)]
                  [evictions : CompilerRegCallEvictSeq
                    (compiler-reg-call-evict-seq-empty)]
                  [evict-budget : i64 (compiler-reg-call-region-evict-cap)]
                  [evict-attempts : i64
                    (compiler-reg-call-region-evict-attempt-cap)]
                  [evict-points : (__tl_dyn-array i64)
                    (array.make-array
                      i64
                      (+ (compiler-reg-call-region-evict-exit-cap) 1))]
                  [evict-saves : (__tl_dyn-array i64)
                    (array.make-array
                      i64
                      (+ (compiler-reg-call-region-evict-def-cap) 1))]
                  [shadows : live.CompilerLiveI64Set
                    (live.compiler-live-set-empty)]
                  [shadow-regs : (__tl_dyn-array i64) (array.make-array i64 an)]
                  [regions : CompilerRegCallRegionSeq
                    (compiler-reg-call-region-seq-empty)]
                  [budget : i64 (compiler-reg-call-region-function-cap)]
                  [root-cap : i64 (compiler-reg-call-region-root-cap)]
                  [picked-lo : (__tl_dyn-array i64) (array.make-array i64 4)]
                  [picked-hi : (__tl_dyn-array i64) (array.make-array i64 4)]
                  [picked-entry : (__tl_dyn-array i64) (array.make-array i64 4)]
                  [picked-exit : (__tl_dyn-array i64) (array.make-array i64 4)]
                  [idx : i64 0]
                  [ci : i64 0]
                  (begin
                    (compiler-reg-fill-i64-array
                      shadow-regs
                      cabi.compiler-reg-id-invalid)
                    (let
                      [bi : i64 0]
                      (while (< bi an)
                        (begin
                          (set!
                            (array-ref buckets bi)
                            (compiler-reg-call-region-stat-seq-empty))
                          (set! bi (+ bi 1)))))
                    (compiler-reg-call-region-collect!
                      type-segment-bases
                      blocks
                      depths
                      cand
                      n
                      buckets)
                    ;; P11b: the same buckets also take the loop-scoped rows,
                    ;; whose preheader anchor is the only way a once-per-
                    ;; iteration invariant reload can leave its loop.
                    (compiler-reg-call-region-loop-rows!
                      type-segment-bases
                      blocks
                      depths
                      cand
                      order
                      cand-count
                      n
                      buckets)
                    ;; index the pool-register occupants once
                    (while (< idx n)
                      (begin
                        (if (= (array-ref present idx) 1)
                          (match (array-ref items idx)
                            [(CompilerRegLocation.Register r)
                              (let
                                [pi : i64
                                  (compiler-reg-call-region-pool-index-of
                                    pool
                                    r)]
                                (if (>= pi 0)
                                  (begin
                                    (set! (array-ref occ-var occ-n) idx)
                                    (set! (array-ref occ-reg occ-n) pi)
                                    (set!
                                      (array-ref occ-kind occ-n)
                                      (compiler-reg-call-region-occ-kind-scalar))
                                    (set! occ-n (+ occ-n 1)))
                                  unit))]
                            [(CompilerRegLocation.RegisterPair r0 r1)
                              (begin
                                (let
                                  [pi : i64
                                    (compiler-reg-call-region-pool-index-of
                                      pool
                                      r0)]
                                  (if (>= pi 0)
                                    (begin
                                      (set! (array-ref occ-var occ-n) idx)
                                      (set! (array-ref occ-reg occ-n) pi)
                                      (set!
                                        (array-ref occ-kind occ-n)
                                        (compiler-reg-call-region-occ-kind-pair))
                                      (set! occ-n (+ occ-n 1)))
                                    unit))
                                (let
                                  [pi : i64
                                    (compiler-reg-call-region-pool-index-of
                                      pool
                                      r1)]
                                  (if (>= pi 0)
                                    (begin
                                      (set! (array-ref occ-var occ-n) idx)
                                      (set! (array-ref occ-reg occ-n) pi)
                                      (set!
                                        (array-ref occ-kind occ-n)
                                        (compiler-reg-call-region-occ-kind-pair))
                                      (set! occ-n (+ occ-n 1)))
                                    unit)))]
                            [_ unit])
                          unit)
                        (set! idx (+ idx 1))))
                    ;; place candidates in walk order until the budget runs out
                    (while (and (< ci cand-count) (> budget 0))
                      (let
                        [root : i64 (array-ref order ci)]
                        [rows : CompilerRegCallRegionStatSeq
                          (array-ref buckets root)]
                        [k : i64 0]
                        [cap : i64
                          (if (< budget root-cap)
                            budget
                            root-cap)]
                        [more : bool true]
                        ;; Does this root's picked set include a loop row? Only
                        ;; then may the register search reach the callee-saved
                        ;; tail, so a block-only root's choice is unchanged.
                        [wants-loop-pool : bool false]
                        (begin
                          (compiler-reg-fill-i64-array picked-lo (- 0 1))
                          (compiler-reg-fill-i64-array picked-hi (- 0 1))
                          ;; pick up to `cap` best non-overlapping rows by score
                          (while (and more (< k cap))
                            (match (compiler-reg-call-region-best-from
                              rows
                              vend
                              picked-lo
                              picked-hi
                              k
                              (- 0 1)
                              (CompilerRegCallRegionNoStat))
                              [(CompilerRegCallRegionNoStat) (set! more false)]
                              [(CompilerRegCallRegionSomeStat stat)
                                (match stat
                                  [(CompilerRegCallRegionStat
                                      _
                                      lo
                                      hi
                                      _
                                      _
                                      _
                                      _
                                      kind)
                                    (begin
                                      (set! (array-ref picked-lo k) lo)
                                      (set! (array-ref picked-hi k) hi)
                                      (when
                                        (=
                                          kind
                                          (compiler-reg-call-region-kind-loop))
                                        (set! wants-loop-pool true))
                                      (set!
                                        (array-ref picked-entry k)
                                        (compiler-reg-call-region-stat-entry
                                          stat))
                                      (set!
                                        (array-ref picked-exit k)
                                        (compiler-reg-call-region-stat-exit
                                          stat
                                          vend))
                                      (set! k (+ k 1)))])]))
                          (if (> k 0)
                            ;; first pool register free over ALL picked regions
                            (let
                              [pix : i64 0]
                              [chosen : i64 (- 0 1)]
                              [search-count : i64
                                (if wants-loop-pool
                                  pool-count
                                  base-pool-count)]
                              (begin
                                (while (and (< pix search-count) (< chosen 0))
                                  (let
                                    [j : i64 0]
                                    [free : bool true]
                                    (begin
                                      (while (and (< j k) free)
                                        (begin
                                          (if (compiler-reg-call-region-reg-conflicts?
                                            occ-var
                                            occ-reg
                                            occ-n
                                            interval-index
                                            pix
                                            (array-ref picked-lo j)
                                            (array-ref picked-hi j))
                                            (set! free false)
                                            unit)
                                          (set! j (+ j 1))))
                                      (if free
                                        (set! chosen pix)
                                        unit)
                                      (set! pix (+ pix 1)))))
                                ;; FALLBACK. The joint search demands one
                                ;; register free over every picked range at
                                ;; once, which a wide outer-loop row makes
                                ;; nearly impossible -- and its failure would
                                ;; otherwise discard the tight inner-loop row
                                ;; behind it, which is the profitable one. So
                                ;; on failure retry LOOP rows one at a time,
                                ;; widest first, and take the first that fits.
                                ;; Block-row outcomes are untouched: this runs
                                ;; only after `chosen` came back negative, and
                                ;; only loop rows are offered.
                                (when
                                  (< chosen 0)
                                  (let
                                    [tries : i64 0]
                                    [tmore : bool true]
                                    [acc-lo : i64 (- 0 1)]
                                    [acc-hi : i64 (- 0 1)]
                                    (begin
                                      (compiler-reg-fill-i64-array
                                        picked-lo
                                        (- 0 1))
                                      (compiler-reg-fill-i64-array
                                        picked-hi
                                        (- 0 1))
                                      (while (and
                                        tmore
                                        (< tries root-cap)
                                        (< chosen 0))
                                        (match (compiler-reg-call-region-best-loop-from
                                          rows
                                          vend
                                          picked-lo
                                          picked-hi
                                          tries)
                                          [(CompilerRegCallRegionNoStat)
                                            (set! tmore false)]
                                          [(CompilerRegCallRegionSomeStat stat)
                                            (match stat
                                              [(CompilerRegCallRegionStat
                                                  _
                                                  lo
                                                  hi
                                                  _
                                                  _
                                                  _
                                                  _
                                                  _)
                                                (let
                                                  [pix : i64 0]
                                                  (begin
                                                    (while (and
                                                      (< pix pool-count)
                                                      (< chosen 0))
                                                      (begin
                                                        (unless
                                                          (compiler-reg-call-region-reg-conflicts?
                                                            occ-var
                                                            occ-reg
                                                            occ-n
                                                            interval-index
                                                            pix
                                                            lo
                                                            hi)
                                                          (set! chosen pix))
                                                        (set! pix (+ pix 1))))
                                                    (when
                                                      (>= chosen 0)
                                                      (begin
                                                        (set! acc-lo lo)
                                                        (set! acc-hi hi)))
                                                    (set!
                                                      (array-ref
                                                        picked-lo
                                                        tries)
                                                      lo)
                                                    (set!
                                                      (array-ref
                                                        picked-hi
                                                        tries)
                                                      hi)
                                                    (set! tries (+ tries 1))))])]))
                                      (if (>= chosen 0)
                                        (begin
                                          (set! (array-ref picked-lo 0) acc-lo)
                                          (set! (array-ref picked-hi 0) acc-hi)
                                          (set! (array-ref picked-entry 0) 1)
                                          (set! (array-ref picked-exit 0) 0)
                                          (set! k 1))
                                        unit))))
                                ;; LAST RESORT: EVICTION. Every pool register is
                                ;; occupied over the region -- the state the
                                ;; flagship is permanently in. Retry the loop
                                ;; rows, best score first, asking whether some
                                ;; occupant is merely PARKED across the region
                                ;; and can lend its register for the region's
                                ;; extent. Nothing here runs unless the two
                                ;; free-register searches above both failed, so
                                ;; no already-homed root changes register.
                                (when
                                  (and
                                    (< chosen 0)
                                    (> evict-budget 0)
                                    (> evict-attempts 0))
                                  (let
                                    [tries : i64 0]
                                    [tmore : bool true]
                                    [acc-lo : i64 (- 0 1)]
                                    [acc-hi : i64 (- 0 1)]
                                    [acc-victim : i64 (- 0 1)]
                                    [acc-exits : i64 0]
                                    [acc-saves : i64 0]
                                    (begin
                                      (compiler-reg-fill-i64-array
                                        picked-lo
                                        (- 0 1))
                                      (compiler-reg-fill-i64-array
                                        picked-hi
                                        (- 0 1))
                                      (while (and
                                        tmore
                                        (< tries root-cap)
                                        (< chosen 0)
                                        (> evict-attempts 0))
                                        (match (compiler-reg-call-region-best-loop-from
                                          rows
                                          vend
                                          picked-lo
                                          picked-hi
                                          tries)
                                          [(CompilerRegCallRegionNoStat)
                                            (set! tmore false)]
                                          [(CompilerRegCallRegionSomeStat stat)
                                            (match stat
                                              [(CompilerRegCallRegionStat
                                                  _
                                                  lo
                                                  hi
                                                  uses
                                                  _
                                                  _
                                                  _
                                                  _)
                                                (begin
                                                  (set!
                                                    evict-attempts
                                                    (- evict-attempts 1))
                                                  (cfg
                                                    regalloc-census
                                                    (compiler-reg-evict-census-bump!
                                                      0)
                                                    unit)
                                                  (match (compiler-reg-call-region-evict-try
                                                    blocks
                                                    depths
                                                    weights
                                                    interval-index
                                                    parents
                                                    assignments
                                                    pool
                                                    pool-count
                                                    occ-var
                                                    occ-reg
                                                    occ-kind
                                                    occ-n
                                                    evicted
                                                    root
                                                    uses
                                                    lo
                                                    hi
                                                    n
                                                    evict-points
                                                    evict-saves)
                                                    [(CompilerRegCallEvictPick.CompilerRegCallEvictNoPick)
                                                      unit]
                                                    [(CompilerRegCallEvictPick.CompilerRegCallEvictSomePick
                                                        pix
                                                        victim
                                                        exits
                                                        save)
                                                      (begin
                                                        (set! chosen pix)
                                                        (set! acc-lo lo)
                                                        (set! acc-hi hi)
                                                        (set! acc-victim victim)
                                                        (set! acc-exits exits)
                                                        (set! acc-saves save))])
                                                  (set!
                                                    (array-ref picked-lo tries)
                                                    lo)
                                                  (set!
                                                    (array-ref picked-hi tries)
                                                    hi)
                                                  (set! tries (+ tries 1)))])]))
                                      (when
                                        (>= chosen 0)
                                        (begin
                                          (set! (array-ref picked-lo 0) acc-lo)
                                          (set! (array-ref picked-hi 0) acc-hi)
                                          (set! (array-ref picked-entry 0) 1)
                                          (set! (array-ref picked-exit 0) 0)
                                          (set! k 1)
                                          (set!
                                            (array-ref evicted acc-victim)
                                            1)
                                          (set! evict-budget (- evict-budget 1))
                                          ;; No live exit means the victim does
                                          ;; not outlive the region at all: the
                                          ;; register was free in fact and only
                                          ;; the conservative hull overlap hid
                                          ;; it, so there is nothing to preserve
                                          ;; and no save is emitted either.
                                          (when
                                            (> acc-exits 0)
                                            (let
                                              [i : i64 0]
                                              (while (< i acc-saves)
                                                (begin
                                                  (set!
                                                    evictions
                                                    (compiler-reg-call-evict-seq-push
                                                      evictions
                                                      (CompilerRegCallEvict
                                                        acc-victim
                                                        (array-ref
                                                          evict-saves
                                                          i)
                                                        (compiler-reg-call-evict-kind-save))))
                                                  (set! i (+ i 1))))))
                                          (let
                                            [i : i64 0]
                                            (while (< i acc-exits)
                                              (begin
                                                (set!
                                                  evictions
                                                  (compiler-reg-call-evict-seq-push
                                                    evictions
                                                    (CompilerRegCallEvict
                                                      acc-victim
                                                      (array-ref evict-points i)
                                                      (compiler-reg-call-evict-kind-restore))))
                                                (set! i (+ i 1)))))
                                          (cfg
                                            regalloc-census
                                            (begin
                                              (compiler-reg-evict-census-bump!
                                                1)
                                              (compiler-reg-evict-census-add!
                                                8
                                                acc-exits))
                                            unit))))))
                                (if (>= chosen 0)
                                  (let
                                    [j : i64 0]
                                    (begin
                                      (set!
                                        shadows
                                        (live.compiler-live-set-insert
                                          shadows
                                          root))
                                      (set!
                                        (array-ref shadow-regs root)
                                        (array-ref pool chosen))
                                      (while (< j k)
                                        (begin
                                          (set!
                                            regions
                                            (compiler-reg-call-region-seq-push
                                              regions
                                              (CompilerRegCallRegion
                                                root
                                                (array-ref picked-lo j)
                                                (array-ref picked-hi j)
                                                (array-ref picked-entry j)
                                                (array-ref picked-exit j))))
                                          (set! j (+ j 1))))
                                      ;; occupancy is recorded on the coalesce
                                      ;; ROOT: members carry no eff-index
                                      ;; segments of their own, and the root's
                                      ;; merged segments conservatively cover
                                      ;; every sibling.
                                      (set!
                                        (array-ref occ-var occ-n)
                                        (compiler-reg-call-region-root
                                          parents
                                          n
                                          root))
                                      (set! (array-ref occ-reg occ-n) chosen)
                                      (set!
                                        (array-ref occ-kind occ-n)
                                        (compiler-reg-call-region-occ-kind-shadow))
                                      (set! occ-n (+ occ-n 1))
                                      (set! budget (- budget k))))
                                  unit)))
                            unit)
                          (set! ci (+ ci 1)))))
                    (CompilerRegCallSaveAssignState.State
                      assignments
                      (CompilerRegCallSplit
                        shadows
                        shadow-regs
                        regions
                        evictions))))])))))))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-set-count-in-range-words
    [set : live.CompilerLiveI64Set]
    [start : i64]
    [end : i64]
    [word-index : i64]) : i64
    (if (>= word-index (live.compiler-live-set-word-count set))
      0
      (+
        (compiler-reg-call-word-count-in-range
          (live.compiler-live-set-word-at-bounded set word-index)
          (* word-index (live.compiler-live-set-word-bits))
          start
          end)
        (compiler-reg-call-set-count-in-range-words
          set
          start
          end
          (+ word-index 1))))))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-set-count-in-range
    [set : live.CompilerLiveI64Set]
    [start : i64]
    [end : i64]) : i64
    (compiler-reg-call-set-count-in-range-words set start end 0)))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-span-census-empty) : CompilerRegCallSpanCensus
    (CompilerRegCallSpanCensus (array.make-array i64 12))))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-span-outcome-register) : i64
    0))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-span-outcome-spill) : i64
    1))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-span-outcome-unassigned) : i64
    2))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-span-bucket [calls : i64]) : i64
    (cond [(= calls 0) 0] [(= calls 1) 1] [(< calls 4) 2] [else 3])))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-span-census-index [bucket : i64] [outcome : i64]) : i64
    (+ (* bucket 3) outcome)))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-span-census-add!
    [census : CompilerRegCallSpanCensus]
    [calls : i64]
    [outcome : i64]) : unit
    (let
      [counts : (__tl_dyn-array i64) census.counts]
      [index : i64
        (compiler-reg-call-span-census-index
          (compiler-reg-call-span-bucket calls)
          outcome)]
      (set! (array-ref counts index) (+ (array-ref counts index) 1)))))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-span-census-count
    [census : (& census CompilerRegCallSpanCensus)]
    [bucket : i64]
    [outcome : i64]) : i64
    (array-ref
      census.counts
      (compiler-reg-call-span-census-index bucket outcome))))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-span-assignment-outcome
    [assignments : CompilerRegAssignmentTable]
    [split-vars : live.CompilerLiveI64Set]
    [var : i64]) : i64
    (if (live.compiler-live-set-contains? split-vars var)
      (compiler-reg-call-span-outcome-register)
      (match (compiler-reg-assignment-lookup assignments var)
        [(CompilerRegMaybeLocation.No)
          (compiler-reg-call-span-outcome-unassigned)]
        [(CompilerRegMaybeLocation.Some location)
          (match location
            [(CompilerRegLocation.Spill _)
              (compiler-reg-call-span-outcome-spill)]
            [_ (compiler-reg-call-span-outcome-register)])]))))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-span-census-intervals!
    [census : CompilerRegCallSpanCensus]
    [intervals : CompilerRegIntervalSeq]
    [assignments : CompilerRegAssignmentTable]
    [call-points : live.CompilerLiveI64Set]
    [split-vars : live.CompilerLiveI64Set]) : unit
    (let
      [index : i64 0]
      (while (< index (compiler-reg-interval-seq-count intervals))
        (begin
          (let
            [interval : CompilerRegInterval
              (compiler-reg-interval-seq-ref intervals index)]
            (compiler-reg-call-span-census-add!
              census
              (compiler-reg-call-set-count-in-range
                call-points
                interval.start
                interval.end)
              (compiler-reg-call-span-assignment-outcome
                assignments
                split-vars
                interval.var)))
          (set! index (+ index 1)))))))

;; Caller-saved integer homes must clear this measured gate before they can be
;; enabled for call-spanning ranges: the register-home benefit must exceed
;; 2*calls_spanned memory ops (spill+reload per normal call) plus the spill-slot
;; and frame overhead. Split-selected originals count as register-covered even
;; though the canonical original var remains stack-homed across the call.
(cfg
  (any regalloc-census test)
  (define (compiler-reg-plan-call-span-census
    [func : ir.CompilerIrFunction]
    [plan : CompilerRegPlan]) : CompilerRegCallSpanCensus
    (let
      [type-info : CompilerRegVarTypes (compiler-reg-function-var-types func)]
      [census : CompilerRegCallSpanCensus (compiler-reg-call-span-census-empty)]
      (begin
        (match plan
          [(CompilerRegPlan.Plan
              assignments
              ineligible
              intervals
              _
              split-vars
              _)
            (compiler-reg-call-span-census-intervals!
              census
              (compiler-reg-candidates intervals type-info ineligible false)
              assignments
              (compiler-reg-call-points func)
              (compiler-reg-call-split-shadows split-vars))])
        census))))

(cfg
  (any regalloc-census test)
  (define (compiler-reg-call-span-census-merge-into!
    [dst : (&mut dst CompilerRegCallSpanCensus)]
    [src : CompilerRegCallSpanCensus]) : unit
    (let
      [dst-counts : (__tl_dyn-array i64) dst.counts]
      [src-counts : (__tl_dyn-array i64) src.counts]
      [index : i64 0]
      (begin
        (while (< index (array-length dst-counts))
          (begin
            (set!
              (array-ref dst-counts index)
              (+ (array-ref dst-counts index) (array-ref src-counts index)))
            (set! index (+ index 1))))
        unit))))

(cfg
  regalloc-census
  (define compiler-reg-call-span-census-total : CompilerRegCallSpanCensus
    (compiler-reg-call-span-census-empty)))

(cfg
  regalloc-census
  (define (compiler-reg-call-span-census-reset!) : unit
    (set!
      compiler-reg-call-span-census-total
      (compiler-reg-call-span-census-empty))))

(cfg
  regalloc-census
  (define (compiler-reg-call-span-census-record-plan!
    [func : ir.CompilerIrFunction]
    [plan : CompilerRegPlan]) : unit
    (compiler-reg-call-span-census-merge-into!
      (&mut compiler-reg-call-span-census-total)
      (compiler-reg-plan-call-span-census func plan))))

(cfg
  regalloc-census
  (define (compiler-reg-call-span-census-row
    [bucket-name : String]
    [bucket : i64]) : String
    (str_cat.str-cat
      "regalloc-call-span-census|"
      bucket-name
      "|"
      (string.int->string
        (compiler-reg-call-span-census-count
          (& compiler-reg-call-span-census-total)
          bucket
          (compiler-reg-call-span-outcome-register)))
      "|"
      (string.int->string
        (compiler-reg-call-span-census-count
          (& compiler-reg-call-span-census-total)
          bucket
          (compiler-reg-call-span-outcome-spill)))
      "|"
      (string.int->string
        (compiler-reg-call-span-census-count
          (& compiler-reg-call-span-census-total)
          bucket
          (compiler-reg-call-span-outcome-unassigned)))
      "\n")))

(cfg
  regalloc-census
  (define (compiler-reg-call-span-census-print!) : unit
    (begin
      (io.print-error
        "regalloc-call-span-census|calls_spanned|register|spill|unassigned\n")
      (io.print-error (compiler-reg-call-span-census-row "0" 0))
      (io.print-error (compiler-reg-call-span-census-row "1" 1))
      (io.print-error (compiler-reg-call-span-census-row "2-3" 2))
      (io.print-error (compiler-reg-call-span-census-row "4+" 3)))))

;; P11b phase 3 eviction census. Slots, in the order the attempt walks them:
;;   0 attempts        1 accepted        2 refused: an exit edge cannot be served
;;   3 refused: no parked victim on any pool register
;;   4 refused: fails the 2x price bar
;;   5 registers with exactly ONE occupant over the region (the eviction's
;;     precondition; the gap to slot 6 is how often that occupant is BUSY)
;;   6 of those, occupants with zero mentions inside the region (parked)
;;   7 verifier disagreements (must stay 0)
;;   8 reloads emitted across all accepted evictions
;; and the exit refusal breakdown, which is the shape of the corpus:
;;   9 target is backward / out of range   10 target has a predecessor OUTSIDE
;;   the region (a critical edge)          11 target opens with a phi
;;  12 more targets than the cap           13 successor label unresolved
;; and the victim-definition refusals, which decide where the mirror can go:
;;  14 the def is a phi                    15 the def ends its block
;;  16 the def is not before the region    17 more defs than the cap
(cfg
  regalloc-census
  (define compiler-reg-evict-census-counts : (__tl_dyn-array i64)
    (array.make-array i64 20)))

(cfg
  regalloc-census
  (define (compiler-reg-evict-census-bump! [slot : i64]) : unit
    (set!
      (array-ref compiler-reg-evict-census-counts slot)
      (+ (array-ref compiler-reg-evict-census-counts slot) 1))))

(cfg
  regalloc-census
  (define (compiler-reg-evict-census-add! [slot : i64] [amount : i64]) : unit
    (set!
      (array-ref compiler-reg-evict-census-counts slot)
      (+ (array-ref compiler-reg-evict-census-counts slot) amount))))

(cfg
  regalloc-census
  (define (compiler-reg-evict-census-print!) : unit
    (io.print-error
      (str_cat.str-cat
        "regalloc-evict-census|attempts="
        (string.int->string (array-ref compiler-reg-evict-census-counts 0))
        "|accepted="
        (string.int->string (array-ref compiler-reg-evict-census-counts 1))
        (str_cat.str-cat
          "|no-exit="
          (string.int->string (array-ref compiler-reg-evict-census-counts 2))
          "|no-victim="
          (string.int->string (array-ref compiler-reg-evict-census-counts 3))
          (str_cat.str-cat
            "|priced-out="
            (string.int->string (array-ref compiler-reg-evict-census-counts 4))
            "|sole-occupant="
            (string.int->string (array-ref compiler-reg-evict-census-counts 5))
            (str_cat.str-cat
              "|parked="
              (string.int->string
                (array-ref compiler-reg-evict-census-counts 6))
              "|verifier-refused="
              (string.int->string
                (array-ref compiler-reg-evict-census-counts 7))
              (str_cat.str-cat
                "|reloads="
                (string.int->string
                  (array-ref compiler-reg-evict-census-counts 8))
                (str_cat.str-cat
                  "|exit-backward="
                  (string.int->string
                    (array-ref compiler-reg-evict-census-counts 9))
                  "|exit-critical="
                  (string.int->string
                    (array-ref compiler-reg-evict-census-counts 10))
                  (str_cat.str-cat
                    "|exit-phi="
                    (string.int->string
                      (array-ref compiler-reg-evict-census-counts 11))
                    "|exit-cap="
                    (string.int->string
                      (array-ref compiler-reg-evict-census-counts 12))
                    (str_cat.str-cat
                      "|exit-label="
                      (string.int->string
                        (array-ref compiler-reg-evict-census-counts 13))
                      "|def-phi="
                      (string.int->string
                        (array-ref compiler-reg-evict-census-counts 14))
                      (str_cat.str-cat
                        "|def-last="
                        (string.int->string
                          (array-ref compiler-reg-evict-census-counts 15))
                        "|def-late="
                        (string.int->string
                          (array-ref compiler-reg-evict-census-counts 16))
                        (str_cat.str-cat
                          "|def-many="
                          (string.int->string
                            (array-ref compiler-reg-evict-census-counts 17))
                          (str_cat.str-cat
                            "|priced-break-even="
                            (string.int->string
                              (array-ref compiler-reg-evict-census-counts 18))
                            "\n"))))))))))))))

;; Dense assignment occupancy for performance and representation audits. These
;; counters are compiled only for explicit regalloc-census builds.
(cfg
  regalloc-census
  (define compiler-reg-assignment-census-plans : i64
    0))
(cfg
  regalloc-census
  (define compiler-reg-assignment-census-capacity : i64
    0))
(cfg
  regalloc-census
  (define compiler-reg-assignment-census-assigned : i64
    0))
(cfg
  regalloc-census
  (define compiler-reg-assignment-census-register : i64
    0))
(cfg
  regalloc-census
  (define compiler-reg-assignment-census-spill : i64
    0))
(cfg
  regalloc-census
  (define compiler-reg-assignment-census-remat : i64
    0))
(cfg
  regalloc-census
  (define compiler-reg-assignment-census-max-capacity : i64
    0))
(cfg
  regalloc-census
  (define compiler-reg-assignment-census-max-assigned : i64
    0))

(cfg
  regalloc-census
  (define (compiler-reg-assignment-census-reset!) : unit
    (begin
      (set! compiler-reg-assignment-census-plans 0)
      (set! compiler-reg-assignment-census-capacity 0)
      (set! compiler-reg-assignment-census-assigned 0)
      (set! compiler-reg-assignment-census-register 0)
      (set! compiler-reg-assignment-census-spill 0)
      (set! compiler-reg-assignment-census-remat 0)
      (set! compiler-reg-assignment-census-max-capacity 0)
      (set! compiler-reg-assignment-census-max-assigned 0))))

(cfg
  regalloc-census
  (define (compiler-reg-assignment-census-record!
    [assignments : (& assignments CompilerRegAssignmentTable)]) : unit
    (let
      [present : (__tl_dyn-array i64) assignments.present]
      [items : (__tl_dyn-array CompilerRegLocation) assignments.items]
      [capacity : i64 (array-length present)]
      [index : i64 0]
      [assigned : i64 0]
      [registers : i64 0]
      [spills : i64 0]
      [remats : i64 0]
      (begin
        (while (< index capacity)
          (begin
            (if (= (array-ref present index) 0)
              unit
              (begin
                (set! assigned (+ assigned 1))
                (match (clone (array-ref items index))
                  [(CompilerRegLocation.Register _)
                    (set! registers (+ registers 1))]
                  [(CompilerRegLocation.RegisterPair _ _)
                    (set! registers (+ registers 1))]
                  [(CompilerRegLocation.Spill _) (set! spills (+ spills 1))]
                  [(CompilerRegLocation.Remat _) (set! remats (+ remats 1))])))
            (set! index (+ index 1))))
        (set!
          compiler-reg-assignment-census-plans
          (+ compiler-reg-assignment-census-plans 1))
        (set!
          compiler-reg-assignment-census-capacity
          (+ compiler-reg-assignment-census-capacity capacity))
        (set!
          compiler-reg-assignment-census-assigned
          (+ compiler-reg-assignment-census-assigned assigned))
        (set!
          compiler-reg-assignment-census-register
          (+ compiler-reg-assignment-census-register registers))
        (set!
          compiler-reg-assignment-census-spill
          (+ compiler-reg-assignment-census-spill spills))
        (set!
          compiler-reg-assignment-census-remat
          (+ compiler-reg-assignment-census-remat remats))
        (if (> capacity compiler-reg-assignment-census-max-capacity)
          (set! compiler-reg-assignment-census-max-capacity capacity)
          unit)
        (if (> assigned compiler-reg-assignment-census-max-assigned)
          (set! compiler-reg-assignment-census-max-assigned assigned)
          unit)))))

(cfg
  regalloc-census
  (define (compiler-reg-assignment-census-print!) : unit
    (begin
      (io.print-error
        "regalloc-assignment-census|plans|capacity|assigned|register|spill|remat|max-capacity|max-assigned\n")
      (io.print-error
        (str_cat.str-cat
          "regalloc-assignment-census|"
          (string.int->string compiler-reg-assignment-census-plans)
          "|"
          (string.int->string compiler-reg-assignment-census-capacity)
          "|"
          (string.int->string compiler-reg-assignment-census-assigned)
          "|"
          (string.int->string compiler-reg-assignment-census-register)
          "|"
          (string.int->string compiler-reg-assignment-census-spill)
          "|"
          (string.int->string compiler-reg-assignment-census-remat)
          "|"
          (string.int->string compiler-reg-assignment-census-max-capacity)
          "|"
          (string.int->string compiler-reg-assignment-census-max-assigned)
          "\n")))))

;; ---- move census (cfg regalloc-census) ------------------------------------
;; Categorise every harvested IR move by why it survived as a reg-reg copy, to
;; see where the move flood actually comes from. Slots:
;;   0 harvested      total moves seen
;;   1 coalesced      src/dst share a coalesce root -> emitted as a self-move
;;   2 samevalue_unco un-coalesced but proven SAME VALUE (#2 should catch these;
;;                    leftovers are multi-def / class-check rejects)
;;   3 disjoint_unco  un-coalesced, DISTINCT value, but live SEGMENTS are
;;                    DISJOINT -> the two could share one register via sound
;;                    hole-filling, so copy-hint *should* fold the copy away
;;   4 interfere      un-coalesced, distinct value, segments overlap -> a real
;;                    simultaneous-liveness copy (needs a split, else irreducible)
(cfg
  regalloc-census
  (define compiler-reg-move-census-counts : (__tl_dyn-array i64)
    (array.make-array i64 16)))

(cfg
  regalloc-census
  (define (compiler-reg-move-census-reset!) : unit
    (set! compiler-reg-move-census-counts (array.make-array i64 16))))

(cfg
  regalloc-census
  (define (compiler-reg-move-census-bump! [slot : i64]) : unit
    (if (if (< slot 0)
      true
      (>= slot (array-length compiler-reg-move-census-counts)))
      unit
      (set!
        (array-ref compiler-reg-move-census-counts slot)
        (+ (array-ref compiler-reg-move-census-counts slot) 1)))))

(cfg
  regalloc-census
  (define (compiler-reg-move-census-find
    [parents : (__tl_dyn-array i64)]
    [v : i64]) : i64
    (if (if (< v 0)
      true
      (>= v (array-length parents)))
      v
      (let
        [p : i64 (array-ref parents v)]
        (if (= p v)
          v
          (compiler-reg-move-census-find parents p))))))

(cfg
  regalloc-census
  (define (compiler-reg-move-census-record!
    [moves : CompilerRegMoveSeq]
    [parents : (__tl_dyn-array i64)]
    [interval-index : CompilerRegIntervalIndex]
    [eff-index : CompilerRegIntervalIndex]
    [types : CompilerRegVarTypes]
    [group-vars : live.CompilerLiveI64Set]
    [sv-parents : (__tl_dyn-array i64)]) : unit
    (let
      [slots : (__tl_dyn-array CompilerRegMove) moves.slots]
      [index : i64 (- moves.len 1)]
      (while (>= index 0)
        (begin
          (let
            [item : CompilerRegMove (array-ref slots index)]
            [src : i64 item.src]
            [dst : i64 item.dst]
            (begin
              (compiler-reg-move-census-bump! 0)
              (let
                [rs : i64 (compiler-reg-move-census-find parents src)]
                [rd : i64 (compiler-reg-move-census-find parents dst)]
                (if (= rs rd)
                  (compiler-reg-move-census-bump! 1)
                  (if (compiler-reg-same-value-class? sv-parents src dst)
                    (compiler-reg-move-census-bump! 2)
                    (if (not
                      (compiler-reg-vars-interfere-segmented-index?
                        interval-index
                        src
                        dst))
                      ;; vars are segment-disjoint. Split by whether their
                      ;; coalesce ROOTS also stay disjoint (slot 5: a root-level
                      ;; copy-hint COULD place them in one register) or the merged
                      ;; classes now conflict (slot 6). Slot 7: of the rootfree
                      ;; ones, the PAIR is coalesce-vars-compatible? -> the merge
                      ;; was blocked by the all-pairs class check, not the pair.
                      (begin
                        (compiler-reg-move-census-bump! 3)
                        (if (compiler-reg-vars-interfere-segmented-index?
                          eff-index
                          rs
                          rd)
                          (compiler-reg-move-census-bump! 6)
                          (begin
                            (compiler-reg-move-census-bump! 5)
                            (if (compiler-reg-coalesce-vars-compatible?
                              interval-index
                              types
                              group-vars
                              src
                              dst
                              false
                              sv-parents)
                              (compiler-reg-move-census-bump! 7)
                              (if (if (live.compiler-live-set-contains?
                                group-vars
                                src)
                                true
                                (live.compiler-live-set-contains?
                                  group-vars
                                  dst))
                                (compiler-reg-move-census-bump! 8)
                                (if (not
                                  (compiler-reg-compatible-types? types src dst))
                                  (compiler-reg-move-census-bump! 9)
                                  (compiler-reg-move-census-bump! 10)))))))
                      (compiler-reg-move-census-bump! 4)))))))
          (set! index (- index 1)))))))

(cfg
  regalloc-census
  (define (compiler-reg-move-census-count-text [index : i64]) : String
    (string.int->string (array-ref compiler-reg-move-census-counts index))))

(cfg
  regalloc-census
  (define (compiler-reg-move-census-print!) : unit
    (begin
      (io.print-error
        "regalloc-move-census|harvested|coalesced|samevalue_unco|disjoint_unco|interfere|disjoint_rootfree|disjoint_rootblocked|rootfree_paircompat|rootfree_group|rootfree_typemismatch|rootfree_other\n")
      (io.print-error
        (str_cat.str-cat
          "regalloc-move-census|"
          (compiler-reg-move-census-count-text 0)
          "|"
          (compiler-reg-move-census-count-text 1)
          "|"
          (compiler-reg-move-census-count-text 2)
          "|"
          (compiler-reg-move-census-count-text 3)
          "|"
          (compiler-reg-move-census-count-text 4)
          "|"
          (compiler-reg-move-census-count-text 5)
          "|"
          (compiler-reg-move-census-count-text 6)
          "|"
          (compiler-reg-move-census-count-text 7)
          "|"
          (compiler-reg-move-census-count-text 8)
          "|"
          (compiler-reg-move-census-count-text 9)
          "|"
          (compiler-reg-move-census-count-text 10)
          "\n")))))

;; Mark every var that is a member of `member-set` AND whose live interval
;; spans a call point as ineligible. Used by the SIMD planner to keep
;; call-spanning MASK values out of registers: opmask registers have no
;; ABI-nonvolatile subset, so a value kept in one across a call would be
;; clobbered by the callee (unsound).
(define (compiler-reg-mark-spanning-in-set
  [intervals : CompilerRegIntervalSeq]
  [member-set : live.CompilerLiveI64Set]
  [call-points : live.CompilerLiveI64Set]
  [ineligible : live.CompilerLiveI64Set]) : live.CompilerLiveI64Set
  (let
    [out : live.CompilerLiveI64Set ineligible]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-interval-seq-count intervals))
        (begin
          (let
            [interval : CompilerRegInterval
              (compiler-reg-interval-seq-ref intervals index)]
            [var : i64 interval.var]
            (if (if (live.compiler-live-set-contains? member-set var)
              (compiler-reg-call-set-in-range?
                call-points
                interval.start
                interval.end)
              false)
              (set! out (live.compiler-live-set-insert out var))
              unit))
          (set! index (+ index 1))))
      out)))

;; The set of 2-word register-group vars in a function -- those defined by
;; CompilerIrInstr.Pack and those read by CompilerIrInstr.Word (the group value being extracted),
;; closed over Mov/Phi copies. These vars need TWO general-purpose registers.
(define (compiler-reg-group-vars-instr
  [set : live.CompilerLiveI64Set]
  [instr : ir.CompilerIrInstr]) : live.CompilerLiveI64Set
  (match instr
    [(ir.CompilerIrInstr.Pack dst _ _) (live.compiler-live-set-insert set dst)]
    [(ir.CompilerIrInstr.Word _ src _ _)
      (match src
        [(ir.CompilerIrValue.Var v) (live.compiler-live-set-insert set v)]
        [_ set])]
    [_ set]))

(define (compiler-reg-group-vars-instr-seq
  [set : live.CompilerLiveI64Set]
  [instrs : ir.CompilerIrInstrSeq]) : live.CompilerLiveI64Set
  (let
    [i : i64 0]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [out : live.CompilerLiveI64Set set]
    (begin
      (while (< i count)
        (begin
          (set!
            out
            (compiler-reg-group-vars-instr
              out
              (ir.compiler-ir-instr-seq-ref instrs i)))
          (set! i (+ i 1))))
      out)))

(define (compiler-reg-group-vars-blocks
  [set : live.CompilerLiveI64Set]
  [blocks : ir.CompilerIrBlockList]) : live.CompilerLiveI64Set
  (match blocks
    [(ir.CompilerIrBlockList.Nil) set]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-group-vars-blocks
            (compiler-reg-group-vars-instr-seq set instrs)
            (__tl-box-place rest))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out : live.CompilerLiveI64Set set]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set! out (compiler-reg-group-vars-instr-seq out instrs))])
              (set! i (+ i 1))))
          out))]))

;; A Phi merging group values, or a Mov copying one, must mark its dst (and
;; the other endpoints) as a group var too -- otherwise the merged value gets a
;; single register and word1 is dropped. Group-ness flows both ways across these
;; copies, so we close the seed set over them to a fixpoint below.
(define (compiler-reg-phi-inputs-any-in-set?
  [set : live.CompilerLiveI64Set]
  [inputs : ir.CompilerIrPhiInputList]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) false]
    [(ir.CompilerIrPhiInputList.Array seq)
      (compiler-reg-phi-inputs-any-in-set?
        set
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (match value
        [(ir.CompilerIrValue.Var v)
          (if (live.compiler-live-set-contains? set v)
            true
            (compiler-reg-phi-inputs-any-in-set? set (__tl-box-place rest)))]
        [_ (compiler-reg-phi-inputs-any-in-set? set (__tl-box-place rest))])]))

(define (compiler-reg-phi-inputs-insert-all
  [set : live.CompilerLiveI64Set]
  [inputs : ir.CompilerIrPhiInputList]) : live.CompilerLiveI64Set
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) set]
    [(ir.CompilerIrPhiInputList.Array seq)
      (compiler-reg-phi-inputs-insert-all
        set
        (ir.compiler-ir-phi-input-seq-to-list seq))]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (let
        [next : live.CompilerLiveI64Set
          (match value
            [(ir.CompilerIrValue.Var v) (live.compiler-live-set-insert set v)]
            [_ set])]
        (compiler-reg-phi-inputs-insert-all next (__tl-box-place rest)))]))

(define (compiler-reg-group-vars-propagate-instr
  [set : live.CompilerLiveI64Set]
  [instr : ir.CompilerIrInstr]) : live.CompilerLiveI64Set
  (match instr
    [(ir.CompilerIrInstr.Mov dst src _)
      (match src
        [(ir.CompilerIrValue.Var v)
          (if (or
            (live.compiler-live-set-contains? set dst)
            (live.compiler-live-set-contains? set v))
            (live.compiler-live-set-insert
              (live.compiler-live-set-insert set dst)
              v)
            set)]
        [_ set])]
    [(ir.CompilerIrInstr.Phi dst inputs _)
      (if (or
        (live.compiler-live-set-contains? set dst)
        (compiler-reg-phi-inputs-any-in-set? set inputs))
        (compiler-reg-phi-inputs-insert-all
          (live.compiler-live-set-insert set dst)
          inputs)
        set)]
    [_ set]))

;; Iterate the instruction SEQ in place by index. The fixpoint re-runs the
;; propagation pass once per round; materializing each block's instr-seq to a list
;; every round (compiler-ir-instr-seq-to-list) allocated O(rounds * instrs) of
;; transient list nodes per function, which on the largest functions overflowed
;; the per-function scratch arena into a second chunk -- enough to expose the
;; arena rewind's latent reuse hazard and corrupt later emission. Reading the seq
;; by index allocates nothing.
(define (compiler-reg-group-vars-propagate-seq
  [set : live.CompilerLiveI64Set]
  [instrs : ir.CompilerIrInstrSeq]
  [index : i64]) : live.CompilerLiveI64Set
  (if (>= index (ir.compiler-ir-instr-seq-count instrs))
    set
    (compiler-reg-group-vars-propagate-seq
      (compiler-reg-group-vars-propagate-instr
        set
        (ir.compiler-ir-instr-seq-ref instrs index))
      instrs
      (+ index 1))))

(define (compiler-reg-group-vars-propagate-blocks
  [set : live.CompilerLiveI64Set]
  [blocks : ir.CompilerIrBlockList]) : live.CompilerLiveI64Set
  (match blocks
    [(ir.CompilerIrBlockList.Nil) set]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-group-vars-propagate-blocks
            (compiler-reg-group-vars-propagate-seq set instrs 0)
            (__tl-box-place rest))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out : live.CompilerLiveI64Set set]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set!
                    out
                    (compiler-reg-group-vars-propagate-seq out instrs 0))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-reg-group-vars-fixpoint
  [set : live.CompilerLiveI64Set]
  [blocks : ir.CompilerIrBlockList]) : live.CompilerLiveI64Set
  (let
    [next : live.CompilerLiveI64Set
      (compiler-reg-group-vars-propagate-blocks set blocks)]
    (if (=
      (live.compiler-live-set-count next)
      (live.compiler-live-set-count set))
      next
      (compiler-reg-group-vars-fixpoint next blocks))))

;; Program-wide canonical aggregate nominal key -> machine-word count map, mirroring
;; CompilerBackendProgramIndex.group-word-counts. The backend sets this once
;; before per-function planning (compiler-reg-set-group-counts!). It lets the
;; register allocator recognise a 2-word register-group value by its TYPE even
;; when this function contains no CompilerIrInstr.Pack that produced it -- e.g. the result
;; of a call returning a group, a group-typed parameter, or a Mov of a group.
;; Without it such a var is mis-classified as an 8-byte handle (see
;; compiler-reg-handle-type?), gets a single GP register, and emit-group-store
;; writes both words into that one register -- silently dropping word1. (At -O2
;; these tiny callees are inlined so the standalone pattern rarely survives; at
;; -O1 it is pervasive.) Self-tests never set it, so the map stays empty and the
;; structural Pack/Word seeding below is unaffected.
(define compiler-reg-group-counts : reg_i64_i64_map.Map
  (reg_i64_i64_map.with-capacity 8))
(define compiler-reg-group-class-masks : reg_i64_i64_map.Map
  (reg_i64_i64_map.with-capacity 8))

;; Direct C calls do not carry ABI metadata in CompilerIrInstr.Call. The backend
;; seeds this program-wide name set from extern signatures before planning.
(define compiler-reg-c-memory-call-names : reg_i64_i64_map.Map
  (reg_i64_i64_map.with-capacity 8))

;; The three maps above are IMAGE-SCOPED facts: the backend installs them from
;; the program index of the image it is about to emit, and their storage belongs
;; to THAT image's arena. Every reader below therefore has to run inside the
;; backend's install-then-use window. That was true of every reader until the
;; optimizer's measured inline tier began reading one register plan per
;; candidate (opt-inline-checked-alloc-cost): those plans run from inside the
;; OPTIMIZER, before this compile's backend has installed anything, so under
;; `compile --batch` the globals still name the PREVIOUS entry's arena -- which
;; is gone by then. Reading a freed map there segfaulted the build-invariance
;; corpus on its third entry, inside compiler-reg-type-register-group?. (The
;; object path records the same hazard where it installs its own maps before
;; group discovery: "a prior batch entry may have left arena-owned maps in the
;; register allocator globals".)
;;
;; A standalone plan has no image, so it is entitled to exactly the answers a
;; fresh process gives -- every one of these queries missing, which is what the
;; regalloc self-tests and the first entry of any batch already see. This flag
;; says that directly: it costs no allocation, it short-circuits ahead of the
;; lookup rather than after it, and because it names the absent image rather
;; than patching the globals it leaves the backend's install-then-use window
;; exactly as it was. A caller arms it around its standalone plan and clears it
;; before returning; nothing here nests.
(define compiler-reg-program-maps-suppressed? : bool
  false)

(define (compiler-reg-suppress-program-maps! [on : bool]) : unit
  (set! compiler-reg-program-maps-suppressed? on))

(define (compiler-reg-program-maps-suppressed-current?) : bool
  compiler-reg-program-maps-suppressed?)

(define (compiler-reg-set-group-counts! [counts : reg_i64_i64_map.Map]) : unit
  (set! compiler-reg-group-counts counts))

(define (compiler-reg-set-group-class-masks! [masks : reg_i64_i64_map.Map]) : unit
  (set! compiler-reg-group-class-masks masks))

(define (compiler-reg-clear-c-memory-call-names!) : unit
  (set! compiler-reg-c-memory-call-names (reg_i64_i64_map.with-capacity 8)))

(define (compiler-reg-add-c-memory-call-name! [name : i64]) : unit
  (reg_i64_i64_map.insert-ref! (&mut compiler-reg-c-memory-call-names) name 1))

(define (compiler-reg-c-memory-call-name? [name : i64]) : bool
  (and
    (not compiler-reg-program-maps-suppressed?)
    (reg_i64_i64_map.contains? (& compiler-reg-c-memory-call-names) name)))

(define (compiler-reg-linux-abi? [target-abi : cabi.CompilerRegTargetAbi]) : bool
  (match target-abi
    [(cabi.CompilerRegTargetAbi.Linux) true]
    [(cabi.CompilerRegTargetAbi.Windows) false]))

(define (compiler-reg-c-memory-marker-array-from?
  [values : (__tl_dyn-array ir.CompilerIrValue)]
  [index : i64]) : bool
  ;; Lowering encodes a by-memory aggregate as value, byte-size, Unit. Indirect
  ;; C calls have no signature id, so this marker is their exact local signal.
  (if (>= (+ index 1) (array-length values))
    false
    (match (array-ref values index)
      [(ir.CompilerIrValue.I64 size)
        (if (and
          (> size 0)
          (match (array-ref values (+ index 1))
            [(ir.CompilerIrValue.Unit) true]
            [_ false]))
          true
          (compiler-reg-c-memory-marker-array-from? values (+ index 1)))]
      [_ (compiler-reg-c-memory-marker-array-from? values (+ index 1))])))

(define (compiler-reg-call-args-have-c-memory-marker?
  [args : ir.CompilerIrCallArgs]) : bool
  (match args
    [(ir.CompilerIrCallArgs.Array values)
      (compiler-reg-c-memory-marker-array-from? values 1)]
    [_ false]))

(define (compiler-reg-call-arg-private-memory?
  [type-segment-bases : i64]
  [types : CompilerRegVarTypes]
  [value : ir.CompilerIrValue]) : bool
  (match (compiler-reg-var-types-lookup
    types
    (match value
      [(ir.CompilerIrValue.Var id) id]
      [_ -1]))
    [(CompilerRegMaybeType.Some ty)
      (compiler-reg-private-memory-type? type-segment-bases ty)]
    [(CompilerRegMaybeType.No) false]))

(define (compiler-reg-call-args-array-have-private-memory?
  [type-segment-bases : i64]
  [types : CompilerRegVarTypes]
  [values : (__tl_dyn-array ir.CompilerIrValue)]
  [index : i64]) : bool
  (if (>= index (array-length values))
    false
    (or
      (compiler-reg-call-arg-private-memory?
        type-segment-bases
        types
        (array-ref values index))
      (compiler-reg-call-args-array-have-private-memory?
        type-segment-bases
        types
        values
        (+ index 1)))))

(define (compiler-reg-call-args-have-private-memory?
  [type-segment-bases : i64]
  [types : CompilerRegVarTypes]
  [args : ir.CompilerIrCallArgs]) : bool
  (match args
    [(ir.CompilerIrCallArgs.Nil) false]
    [(ir.CompilerIrCallArgs.One value)
      (compiler-reg-call-arg-private-memory? type-segment-bases types value)]
    [(ir.CompilerIrCallArgs.Two a b)
      (or
        (compiler-reg-call-arg-private-memory? type-segment-bases types a)
        (compiler-reg-call-arg-private-memory? type-segment-bases types b))]
    [(ir.CompilerIrCallArgs.Array values)
      (compiler-reg-call-args-array-have-private-memory?
        type-segment-bases
        types
        values
        0)]))

(define (compiler-reg-reference-to-slice?
  [type-segment-bases : i64]
  [inner : i64]) : bool
  (match (ast.ast-type-segment-bases-get type-segment-bases inner)
    [(ast.AstType.Region _ nested)
      (compiler-reg-reference-to-slice? type-segment-bases nested)]
    [(ast.AstType.Slice _) true]
    [_ false]))

;; Backend-private SysV MEMORY transport values retain a nominal Struct name
;; carrying `__tl_internal_abi_mem_s<SIZE>__...`.  Regalloc only needs a
;; conservative prefix/shape test to reserve staging scratch; the backend's
;; bounded decoder is authoritative for the actual byte count.
(define (compiler-reg-private-memory-name? [name : String]) : bool
  (let
    [prefix : String "__tl_internal_abi_mem_s"]
    [prefix-len : i64 (string.string-length prefix)]
    [n : i64 (string.string-length name)]
    [i : i64 prefix-len]
    [digits : i64 0]
    [delimiter? : bool false]
    [valid : bool
      (and
        (>= n prefix-len)
        (string.eq (string.substring name 0 prefix-len) prefix))]
    (begin
      (while (and valid (< i n))
        (let
          [digit : i64 (cast (string.string-ref name i) : i64)]
          (if (and (>= digit 48) (<= digit 57))
            (begin
              (set! digits (+ digits 1))
              (set! i (+ i 1)))
            (if (and
              (= (cast (string.string-ref name i) : i64) 95)
              (< (+ i 1) n)
              (= (cast (string.string-ref name (+ i 1)) : i64) 95))
              (begin
                (set! delimiter? true)
                (set! i n))
              (set! valid false)))))
      (and valid (> digits 0) delimiter?))))

(define (compiler-reg-private-memory-type?
  [type-segment-bases : i64]
  [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.Struct name)
      (and
        (ir.compiler-ir-symbol-owned? name)
        (compiler-reg-private-memory-name? (ir.compiler-ir-symbol-text name)))]
    [(ast.AstType.StructArgs name _)
      (and
        (ir.compiler-ir-symbol-owned? name)
        (compiler-reg-private-memory-name? (ir.compiler-ir-symbol-text name)))]
    [(ast.AstType.Region _ inner)
      (compiler-reg-private-memory-type?
        type-segment-bases
        (ast.ast-type-segment-bases-get type-segment-bases inner))]
    [_ false]))

;; True when a var's type is a >=2-word register-group per the program map.
(define (compiler-reg-type-register-group?
  [type-segment-bases : i64]
  [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.Ref _ inner)
      (compiler-reg-reference-to-slice? type-segment-bases inner)]
    [(ast.AstType.MutRef _ inner)
      (compiler-reg-reference-to-slice? type-segment-bases inner)]
    [(ast.AstType.Region _ inner)
      (compiler-reg-type-register-group?
        type-segment-bases
        (ast.ast-type-segment-bases-get type-segment-bases inner))]
    [_
      (if compiler-reg-program-maps-suppressed?
        false
        (match (ast.ast-aggregate-type-key type-segment-bases ty)
          [(ast.AstMaybeNominalKey.Some key)
            (match (reg_i64_i64_map.get (& compiler-reg-group-counts) key)
              [(reg_i64_i64_map.LookupFound count) (> count 1)]
              [(reg_i64_i64_map.LookupMissing) false])]
          [(ast.AstMaybeNominalKey.None) false]))]))

(define (compiler-reg-type-register-group-has-sse?
  [type-segment-bases : i64]
  [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.Ref _ _) false]
    [(ast.AstType.MutRef _ _) false]
    [(ast.AstType.Region _ inner)
      (compiler-reg-type-register-group-has-sse?
        type-segment-bases
        (ast.ast-type-segment-bases-get type-segment-bases inner))]
    [_
      (if compiler-reg-program-maps-suppressed?
        false
        (match (ast.ast-aggregate-type-key type-segment-bases ty)
          [(ast.AstMaybeNominalKey.Some key)
            (match (reg_i64_i64_map.get (& compiler-reg-group-class-masks) key)
              [(reg_i64_i64_map.LookupFound mask) (> mask 0)]
              [(reg_i64_i64_map.LookupMissing) false])]
          [(ast.AstMaybeNominalKey.None) false]))]))

(define (compiler-reg-type-register-group-word-sse?
  [type-segment-bases : i64]
  [ty : ast.AstType]
  [word-index : i64]) : bool
  (match ty
    [(ast.AstType.Ref _ _) false]
    [(ast.AstType.MutRef _ _) false]
    [(ast.AstType.Region _ inner)
      (compiler-reg-type-register-group-word-sse?
        type-segment-bases
        (ast.ast-type-segment-bases-get type-segment-bases inner)
        word-index)]
    [_
      (if compiler-reg-program-maps-suppressed?
        false
        (if (or (< word-index 0) (> word-index 1))
          false
          (match (ast.ast-aggregate-type-key type-segment-bases ty)
            [(ast.AstMaybeNominalKey.Some key)
              (match (reg_i64_i64_map.get
                (& compiler-reg-group-class-masks)
                key)
                [(reg_i64_i64_map.LookupFound mask)
                  (not
                    (=
                      (bit-and
                        mask
                        (if (= word-index 0)
                          1
                          2))
                      0))]
                [(reg_i64_i64_map.LookupMissing) false])]
            [(ast.AstMaybeNominalKey.None) false])))]))

(define (compiler-reg-var-register-group-has-sse?
  [type-segment-bases : i64]
  [types : CompilerRegVarTypes]
  [var : i64]) : bool
  (match (compiler-reg-var-types-lookup types var)
    [(CompilerRegMaybeType.Some ty)
      (compiler-reg-type-register-group-has-sse? type-segment-bases ty)]
    [(CompilerRegMaybeType.No) false]))

;; Array-view form of the seed below: same ascending-id visit order, indexed
;; instead of walked.
(define (compiler-reg-group-vars-from-types-seq
  [type-segment-bases : i64]
  [types : CompilerRegVarTypes]
  [set : live.CompilerLiveI64Set]) : live.CompilerLiveI64Set
  (let
    [present : (__tl_dyn-array i64) types.present]
    [items : (__tl_dyn-array ast.AstType) types.items]
    [count : i64 (array-length present)]
    [index : i64 0]
    [out : live.CompilerLiveI64Set set]
    (begin
      (while (< index count)
        (begin
          (if (= (array-ref present index) 0)
            unit
            (if (compiler-reg-type-register-group?
              type-segment-bases
              (array-ref items index))
              (set! out (live.compiler-live-set-insert out index))
              unit))
          (set! index (+ index 1))))
      out)))

;; Seed every var whose TYPE is a 2-word register-group (the type-based group
;; vars the structural Pack/Word scan misses).
(define (compiler-reg-group-vars-from-types
  [type-segment-bases : i64]
  [types : CompilerRegVarTypes]
  [set : live.CompilerLiveI64Set]) : live.CompilerLiveI64Set
  (compiler-reg-group-vars-from-types-seq type-segment-bases types set))

(define (compiler-reg-function-group-vars
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [types : CompilerRegVarTypes]) : live.CompilerLiveI64Set
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (compiler-reg-group-vars-fixpoint
        (compiler-reg-group-vars-from-types
          type-segment-bases
          types
          (compiler-reg-group-vars-blocks (live.compiler-live-set-empty) blocks))
        blocks)]))

;; LLVM-style coalescing-by-rename. LLVM removes a copy by renaming
;; the two virtual registers into ONE, so a coalesced class is a single value the
;; allocator places atomically. Here: collapse each coalesce class to its root
;; var. `compiler-reg-merged-root-index` returns an interval index in which ONLY
;; the root carries an interval -- the merged [min-start, max-end] over all class
;; members -- and every non-root member is dropped (start = -1, excluded from the
;; candidate list). The allocator then sees one indivisible candidate per class:
;; one placement, one eviction unit, one register, across every pass and pool.
;; Members inherit the root's location via compiler-reg-expand-class-assignments.
;; The merged coarse interval drives interference; a singleton var's coarse
;; interval already equals its live range, so non-coalesced values are unaffected.
(define (compiler-reg-interval-seq-insert-merged
  [segments : CompilerRegIntervalSeq]
  [var : i64]
  [start : i64]
  [end : i64]) : CompilerRegIntervalSeq
  (let
    [out : CompilerRegIntervalSeq
      (compiler-reg-interval-seq-with-capacity
        (+ (compiler-reg-interval-seq-count segments) 1))]
    [merged-start : i64 start]
    [merged-end : i64 end]
    [inserted : bool false]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-interval-seq-count segments))
        (let
          [head : CompilerRegInterval
            (compiler-reg-interval-seq-ref segments index)]
          (begin
            (let
              [head-start : i64 head.start]
              [head-end : i64 head.end]
              (cond
                [(< head-end merged-start)
                  (set! out (compiler-reg-interval-seq-append out head))]
                [(< merged-end head-start)
                  (begin
                    (if inserted
                      unit
                      (begin
                        (set!
                          out
                          (compiler-reg-interval-seq-append
                            out
                            (CompilerRegInterval var merged-start merged-end)))
                        (set! inserted true)))
                    (set! out (compiler-reg-interval-seq-append out head)))]
                [else
                  (begin
                    (if (< head-start merged-start)
                      (set! merged-start head-start)
                      unit)
                    (if (> head-end merged-end)
                      (set! merged-end head-end)
                      unit))]))
            (set! index (+ index 1)))))
      (if inserted
        out
        (compiler-reg-interval-seq-append
          out
          (CompilerRegInterval var merged-start merged-end))))))

(define (compiler-reg-union-segments
  [src : CompilerRegIntervalSeq]
  [root : i64]
  [dst : CompilerRegIntervalSeq]) : CompilerRegIntervalSeq
  (let
    [out : CompilerRegIntervalSeq dst]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-interval-seq-count src))
        (begin
          (let
            [interval : CompilerRegInterval
              (compiler-reg-interval-seq-ref src index)]
            (set!
              out
              (compiler-reg-interval-seq-insert-merged
                out
                root
                interval.start
                interval.end)))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-merged-root-index
  [coalesce : CompilerRegCoalesceMap]
  [interval-index : CompilerRegIntervalIndex]) : CompilerRegIntervalIndex
  (let
    [orig-starts : (__tl_dyn-array i64) interval-index.starts]
    [orig-ends : (__tl_dyn-array i64) interval-index.ends]
    [orig-segs : (__tl_dyn-array CompilerRegIntervalSeq)
      interval-index.segments]
    [parents : (__tl_dyn-array i64) coalesce.parents]
    [n : i64 (array-length orig-starts)]
    [root-starts : (__tl_dyn-array i64) (array.make-array i64 n)]
    [root-ends : (__tl_dyn-array i64) (array.make-array i64 n)]
    [root-segs : (__tl_dyn-array CompilerRegIntervalSeq)
      (array.make-array CompilerRegIntervalSeq n)]
    [v : i64 0]
    (begin
      (compiler-reg-fill-i64-array root-starts -1)
      (compiler-reg-fill-i64-array root-ends -1)
      ;; Object-array entries are not valid empty sequences by default. Initialise
      ;; every root explicitly before accumulating its sorted segment union.
      (while (< v n)
        (begin
          (set! (array-ref root-segs v) (compiler-reg-interval-seq-empty))
          (set! v (+ v 1))))
      (set! v 0)
      (while (< v n)
        (begin
          (if (>= (array-ref orig-starts v) 0)
            (let
              [r : i64
                (if (< v (array-length parents))
                  (array-ref parents v)
                  v)]
              [rr : i64
                (if (and (>= r 0) (< r n))
                  r
                  v)]
              (begin
                (if (or
                  (< (array-ref root-starts rr) 0)
                  (< (array-ref orig-starts v) (array-ref root-starts rr)))
                  (set! (array-ref root-starts rr) (array-ref orig-starts v))
                  unit)
                (if (> (array-ref orig-ends v) (array-ref root-ends rr))
                  (set! (array-ref root-ends rr) (array-ref orig-ends v))
                  unit)
                ;; The root carries the UNION of its
                ;; members' segments. Normal coalescing only merges
                ;; non-interfering members, but same-value coalescing deliberately
                ;; admits overlapping members, so keep the root segment list
                ;; sorted and non-overlapping while preserving genuine holes.
                (set!
                  (array-ref root-segs rr)
                  (compiler-reg-union-segments
                    (if (< v (array-length orig-segs))
                      (array-ref orig-segs v)
                      (compiler-reg-interval-seq-empty))
                    rr
                    (array-ref root-segs rr)))))
            unit)
          (set! v (+ v 1))))
      (CompilerRegIntervalIndex root-starts root-ends root-segs))))

;; Non-singleton coalesce roots are the only values whose segment holes are
;; intentionally widened by class merging, so only they may drive hole-aware
;; register reuse.
(define (compiler-reg-coalesce-merged-root-set-from
  [parents : (__tl_dyn-array i64)]
  [index : i64]
  [out : live.CompilerLiveI64Set]) : live.CompilerLiveI64Set
  (if (>= index (array-length parents))
    out
    (let
      [root : i64 (array-ref parents index)]
      (compiler-reg-coalesce-merged-root-set-from
        parents
        (+ index 1)
        (if (and
          (>= root 0)
          (< root (array-length parents))
          (not (= root index)))
          (live.compiler-live-set-insert out root)
          out)))))

(define (compiler-reg-coalesce-merged-root-set
  [coalesce : CompilerRegCoalesceMap]) : live.CompilerLiveI64Set
  (compiler-reg-coalesce-merged-root-set-from
    coalesce.parents
    0
    (live.compiler-live-set-empty)))

(define (compiler-reg-coalesce-root-set-from-vars-from
  [parents : (__tl_dyn-array i64)]
  [source : live.CompilerLiveI64Set]
  [index : i64]
  [out : live.CompilerLiveI64Set]) : live.CompilerLiveI64Set
  (if (>= index (array-length parents))
    out
    (let
      [root : i64 (array-ref parents index)]
      [mapped : i64
        (if (and (>= root 0) (< root (array-length parents)))
          root
          index)]
      (compiler-reg-coalesce-root-set-from-vars-from
        parents
        source
        (+ index 1)
        (if (live.compiler-live-set-contains? source index)
          (live.compiler-live-set-insert out mapped)
          out)))))

(define (compiler-reg-coalesce-root-set-from-vars
  [coalesce : CompilerRegCoalesceMap]
  [source : live.CompilerLiveI64Set]) : live.CompilerLiveI64Set
  (let
    [parents : (__tl_dyn-array i64) coalesce.parents]
    (if (= (array-length parents) 0)
      source
      (compiler-reg-coalesce-root-set-from-vars-from
        parents
        source
        0
        (live.compiler-live-set-empty)))))

;; Expand a per-root assignment table to all original vars -- every
;; member of a coalesce class inherits its root's location (register or spill
;; slot). This realises the coalesce: the copy `member <- root` becomes
;; src-reg == dst-reg and is dropped at emission. A var whose root got no
;; location stays absent (spills by default).
(define (compiler-reg-expand-class-assignments
  [assignments : CompilerRegAssignmentTable]
  [coalesce : CompilerRegCoalesceMap]
  [storage-vars : live.CompilerLiveI64Set]
  [orig-starts : (__tl_dyn-array i64)]
  [vars : i64]) : CompilerRegAssignmentTable
  (let
    [parents : (__tl_dyn-array i64) coalesce.parents]
    [out : CompilerRegAssignmentTable (compiler-reg-assignment-table-make vars)]
    [v : i64 0]
    (begin
      (while (< v vars)
        (begin
          (if (and
            (< v (array-length orig-starts))
            (>= (array-ref orig-starts v) 0)
            ;; Storage-identity vars (`Alloc` destinations and `AddrOf`
            ;; sources) need their own formula slot to hold the bytes whose
            ;; address is exposed. If coalescing merged them into a register
            ;; root, do not inherit that home; the original copy remains and
            ;; materializes the storage slot for the later AddrOf.
            (not (live.compiler-live-set-contains? storage-vars v)))
            (let
              [r : i64
                (if (< v (array-length parents))
                  (array-ref parents v)
                  v)]
              [rr : i64
                (if (and (>= r 0) (< r vars))
                  r
                  v)]
              (match (compiler-reg-assignment-table-lookup assignments rr)
                [(CompilerRegMaybeLocation.Some loc)
                  (begin
                    (compiler-reg-assignment-table-insert out v loc)
                    unit)]
                [(CompilerRegMaybeLocation.No) unit]))
            unit)
          (set! v (+ v 1))))
      out)))

;; ---------------------------------------------------------------------------
;; SplitKit Phase A step 0: coalesce/segment-preserving spill bookkeeping.
;; ---------------------------------------------------------------------------
;; The empty (budget-0) split plan: no minted pieces, no occupant splits. M1
;; threads this through CompilerRegPlan on every path so the per-sub-range model
;; is carried but inert; M2+ replace it with a populated plan from the greedy.
(define (compiler-reg-split-plan-empty) : CompilerRegSplitPlan
  (CompilerRegSplitPlan
    (array.make-array i64 0)
    (array.make-array i64 0)
    (array.make-array i64 0)
    (array.make-array i64 0)
    (array.make-array i64 0)
    (array.make-array CompilerRegOccupantSplit 0)))

;; The spill-weight eviction scores a candidate by its use count,
;; but a merged class root carries only its OWN var's weight -- which can be the
;; least-used member of the class (e.g. a phi result used once), so the eviction
;; underweights a hot coalesced loop value and spills it (crc32's accumulator).
;; Give the root the MAX weight over its members: that captures the class's
;; hottest reference rate (enough to keep a hot loop value resident) without
;; SUM's over-weighting, which would evict hot singletons that share the loop
;; (the reps var in spmd_reduce).
(define (compiler-reg-merge-ref-counts
  [coalesce : CompilerRegCoalesceMap]
  [ref-counts : (__tl_dyn-array i64)]
  [vars : i64]) : (__tl_dyn-array i64)
  (let
    [parents : (__tl_dyn-array i64) coalesce.parents]
    [out : (__tl_dyn-array i64) (array.make-array i64 vars)]
    [v : i64 0]
    (begin
      (while (< v vars)
        (begin
          (if (< v (array-length ref-counts))
            (let
              [r : i64
                (if (< v (array-length parents))
                  (array-ref parents v)
                  v)]
              [rr : i64
                (if (and (>= r 0) (< r vars))
                  r
                  v)]
              [w : i64 (array-ref ref-counts v)]
              (if (> w (array-ref out rr))
                (set! (array-ref out rr) w)
                unit))
            unit)
          (set! v (+ v 1))))
      out)))

;; ============================================================================
;; LLVM-style per-vreg Greedy register allocator (RAGreedy). The single allocation
;; algorithm across the whole compiler: scalar integer (ABI-specific
;; caller/callee-saved pools with call-clobber as interference), SIMD/AVX integer
;; (the Linux callee-saved pool), and float/vector->XMM-family. For each
;; register class one selectOrSplit
;; pass over the coalesced ROOTS:
;;   * spill-weight PRIORITY ORDER (remat-discounted ref-counts desc, var asc) --
;;     the LLVM enqueue priority;
;;   * a GLOBAL per-physreg interference union (LiveIntervalUnion): a register is
;;     free for a root iff the SOUND segmented-index test clears against EVERY var
;;     holding it (prepass picks + already-assigned roots);
;;   * CALL-CLOBBER as interference: a caller-saved register is unavailable to a
;;     value whose live range crosses a call (the regmask clobbers it);
;;   * COPY-HINT biasing: try the copy-neighbour's register first;
;;   * remat-aware spill-weight EVICTION + the RS_* stage machine: clear a register
;;     all of whose interferers are strictly lower weight, else (split-eligible)
;;     mark RS_Split for the region-split post-pass, else spill. Strict weight order
;;     => terminating. Group/pair roots are left UNASSIGNED (backend stack-homes
;;     them); the call-spanning save/restore rescue then runs over the integer
;;     result.
(define (compiler-reg-greedy-pool-index-capacity) : i64
  (+ cabi.compiler-reg-id-mask-base cabi.compiler-reg-id-mask-count))

(define (compiler-reg-greedy-pool-index-build
  [reg-arr : (__tl_dyn-array i64)]
  [rcount : i64]) : (__tl_dyn-array i64)
  (let
    [out : (__tl_dyn-array i64)
      (array.make-array i64 (compiler-reg-greedy-pool-index-capacity))]
    [i : i64 0]
    (begin
      (compiler-reg-fill-i64-array out -1)
      (while (< i rcount)
        (let
          [key : i64
            (cabi.compiler-abi-register-ownership-id (array-ref reg-arr i))]
          (begin
            (if (and
              (>= key 0)
              (< key (array-length out))
              (< (array-ref out key) 0))
              (set! (array-ref out key) i)
              unit)
            (set! i (+ i 1)))))
      out)))

(define (compiler-reg-greedy-pool-index
  [occupancy : CompilerRegGreedyOccupancy]
  [reg : i64]) : i64
  (let
    [key : i64 (cabi.compiler-abi-register-ownership-id reg)]
    [index : (__tl_dyn-array i64) occupancy.pool-index]
    (if (and (>= key 0) (< key (array-length index)))
      (array-ref index key)
      -1)))

(define (compiler-reg-greedy-occupancy-word-index
  [occupancy : CompilerRegGreedyOccupancy]
  [reg-index : i64]
  [word-index : i64]) : i64
  (+ (* reg-index occupancy.word-count) word-index))

;; ---------------------------------------------------------------------------
;; Per-register live-interval union (LLVM RAGreedy LiveIntervalUnion).
;;
;; The greedy allocator asks "is register r free for v?" 833k times per opt2
;; self-compile and answered it by walking r's occupancy bitset and calling the
;; segmented interference predicate once per resident: 19.0M predicate calls,
;; 97% of which answer "disjoint". A per-query prologue hoist was measured and
;; rejected (see compiler-reg-vars-interfere-segmented-index?) -- at this volume
;; only dropping the QUERY COUNT wins. Keeping the residents' segments sorted by
;; start per register turns the scan into a stabbing query: a binary search per
;; segment of the candidate (1.37 on average), with zero per-resident calls.
;;
;; ENTRY LAYOUT. `live-union[reg].slots` is a flat i64 array of
;; compiler-reg-live-union-entry-words per entry:
;;   +0 effective start   +1 end   +2 prefix maximum of `end` over [0 .. i]
;; sorted ascending by effective start.
;;
;; EFFECTIVE START. The interference rule is half-open EXCEPT that a touch at
;; point 0 counts as overlap (compiler-reg-interval-overlap?, M-A RC1):
;;   overlap(a,b) <=> (a.end > b.start or b.start = 0)
;;                and (b.end > a.start or a.start = 0)
;; Mapping a start of 0 to a sentinel below every program point collapses both
;; disjunctions into one comparison:
;;   overlap(a,b) <=> es(b) < a.end and es(a) < b.end
;; which is the form the sorted search needs: for a candidate segment s, the
;; entries satisfying `es(u) < s.end` are exactly a PREFIX of the array (es is
;; ascending), and within that prefix some entry satisfies `es(s) < u.end`
;; exactly when the prefix maximum of `end` exceeds es(s). Both halves are
;; therefore answered by one binary search plus one load -- and the answer is
;; exact even when entries overlap each other (which pre-seeded homes allow).
(define (compiler-reg-live-union-entry-words) : i64
  3)

(define (compiler-reg-live-union-empty) : CompilerRegLiveUnion
  (CompilerRegLiveUnion (array.make-array i64 0) 0))

;; Below every real program point and above i64 underflow, so `es < end` holds
;; unconditionally for a point-0 segment without special-casing either side.
(define (compiler-reg-live-union-neg-inf) : i64
  (- 0 1000000000))

(define (compiler-reg-live-union-effective-start [start : i64]) : i64
  (if (= start 0)
    (compiler-reg-live-union-neg-inf)
    start))

;; First index in [0, count) whose effective start is >= `bound`, else `count`.
(define (compiler-reg-live-union-lower-bound
  [entries : (__tl_dyn-array i64)]
  [count : i64]
  [bound : i64]) : i64
  (let
    [lo : i64 0]
    [hi : i64 count]
    (begin
      (while (< lo hi)
        (let
          [mid : i64 (+ lo (/ (- hi lo) 2))]
          (if (<
            (array-ref entries (* mid (compiler-reg-live-union-entry-words)))
            bound)
            (set! lo (+ mid 1))
            (set! hi mid))))
      lo)))

;; Does any union entry overlap the segment [es-start, end)?
(define (compiler-reg-live-union-segment-hits?
  [entries : (__tl_dyn-array i64)]
  [count : i64]
  [es-start : i64]
  [end : i64]) : bool
  (let
    [above : i64 (compiler-reg-live-union-lower-bound entries count end)]
    (if (= above 0)
      false
      (>
        (array-ref
          entries
          (+ (* (- above 1) (compiler-reg-live-union-entry-words)) 2))
        es-start))))

;; Does any resident of `reg-index` interfere with the segment sequence `segs`?
(define (compiler-reg-live-union-interferes?
  [occupancy : CompilerRegGreedyOccupancy]
  [reg-index : i64]
  [segs : CompilerRegIntervalSeq]) : bool
  (let
    [union : CompilerRegLiveUnion (array-ref occupancy.live-union reg-index)]
    [entries : (__tl_dyn-array i64) union.slots]
    [count : i64 union.count]
    [slots : (__tl_dyn-array CompilerRegInterval) segs.slots]
    [len : i64 segs.len]
    [index : i64 0]
    [hit : bool false]
    (begin
      (while (and (< index len) (not hit))
        (let
          [seg : CompilerRegInterval (array-ref slots index)]
          (begin
            (if (compiler-reg-live-union-segment-hits?
              entries
              count
              (compiler-reg-live-union-effective-start seg.start)
              seg.end)
              (set! hit true)
              unit)
            (set! index (+ index 1)))))
      hit)))

(define (compiler-reg-live-union-var-segments
  [occupancy : CompilerRegGreedyOccupancy]
  [var : i64]) : CompilerRegIntervalSeq
  (let
    [segments : (__tl_dyn-array CompilerRegIntervalSeq)
      occupancy.live-union-segments]
    (if (or (< var 0) (>= var (array-length segments)))
      (compiler-reg-interval-seq-empty)
      (array-ref segments var))))

;; Storage for `need` entries of `union`: either its own array or a doubled
;; copy. The caller writes the resulting union value back into its slot.
(define (compiler-reg-live-union-reserve
  [union : CompilerRegLiveUnion]
  [need : i64]) : (__tl_dyn-array i64)
  (let
    [entries : (__tl_dyn-array i64) union.slots]
    [words : i64 (compiler-reg-live-union-entry-words)]
    [capacity : i64 (/ (array-length entries) words)]
    (if (<= need capacity)
      entries
      (let
        [doubled : i64
          (if (< capacity 4)
            4
            (* capacity 2))]
        [grown : i64
          (if (< doubled need)
            need
            doubled)]
        [bigger : (__tl_dyn-array i64) (array.make-array i64 (* grown words))]
        [copy : i64 (* union.count words)]
        [index : i64 0]
        (begin
          (while (< index copy)
            (begin
              (set! (array-ref bigger index) (array-ref entries index))
              (set! index (+ index 1))))
          bigger)))))

;; Rewrite the prefix maxima of `end` over [from, count).
(define (compiler-reg-live-union-refresh-max!
  [entries : (__tl_dyn-array i64)]
  [count : i64]
  [from : i64]) : unit
  (let
    [words : i64 (compiler-reg-live-union-entry-words)]
    [index : i64
      (if (< from 0)
        0
        from)]
    [running : i64
      (if (> index 0)
        (array-ref entries (+ (* (- index 1) words) 2))
        (compiler-reg-live-union-neg-inf))]
    (while (< index count)
      (let
        [base : i64 (* index words)]
        [end : i64 (array-ref entries (+ base 1))]
        (begin
          (if (> end running)
            (set! running end)
            unit)
          (set! (array-ref entries (+ base 2)) running)
          (set! index (+ index 1)))))))

;; Insert one segment into `reg-index`'s union, keeping it sorted by effective
;; start. Ties keep insertion order; the query is order-insensitive among equal
;; starts, so any stable position is fine.
(define (compiler-reg-live-union-insert-segment!
  [occupancy : CompilerRegGreedyOccupancy]
  [reg-index : i64]
  [es-start : i64]
  [end : i64]) : unit
  (let
    [store : (__tl_dyn-array CompilerRegLiveUnion) occupancy.live-union]
    [union : CompilerRegLiveUnion (array-ref store reg-index)]
    [count : i64 union.count]
    [entries : (__tl_dyn-array i64)
      (compiler-reg-live-union-reserve union (+ count 1))]
    [words : i64 (compiler-reg-live-union-entry-words)]
    [at : i64 (compiler-reg-live-union-lower-bound entries count es-start)]
    [cursor : i64 (- (* count words) 1)]
    [floor : i64 (* at words)]
    (begin
      (while (>= cursor floor)
        (begin
          (set! (array-ref entries (+ cursor words)) (array-ref entries cursor))
          (set! cursor (- cursor 1))))
      (set! (array-ref entries floor) es-start)
      (set! (array-ref entries (+ floor 1)) end)
      (set!
        (array-ref store reg-index)
        (CompilerRegLiveUnion entries (+ count 1)))
      (compiler-reg-live-union-refresh-max! entries (+ count 1) at))))

;; Add `var` to `reg-index`'s union. A var without segment data cannot be
;; modelled by the union and only bumps the coarse-resident count.
(define (compiler-reg-live-union-add!
  [occupancy : CompilerRegGreedyOccupancy]
  [reg-index : i64]
  [var : i64]) : unit
  (let
    [segs : CompilerRegIntervalSeq
      (compiler-reg-live-union-var-segments occupancy var)]
    [slots : (__tl_dyn-array CompilerRegInterval) segs.slots]
    [len : i64 segs.len]
    [index : i64 0]
    (if (= len 0)
      (let
        [coarse : (__tl_dyn-array i64) occupancy.live-union-coarse]
        (set! (array-ref coarse reg-index) (+ (array-ref coarse reg-index) 1)))
      (while (< index len)
        (let
          [seg : CompilerRegInterval (array-ref slots index)]
          (begin
            (compiler-reg-live-union-insert-segment!
              occupancy
              reg-index
              (compiler-reg-live-union-effective-start seg.start)
              seg.end)
            (set! index (+ index 1))))))))

;; Drop `var` from `reg-index`'s union. Both the union and `var`'s segments are
;; ascending in effective start, so one merge pass compacts out exactly one
;; entry per segment. Entries carry no owner id: two residents can only present
;; the same (start, end) pair when they are pre-seeded overlapping homes, and
;; then dropping either leaves the same multiset -- which is all the query
;; observes.
(define (compiler-reg-live-union-remove!
  [occupancy : CompilerRegGreedyOccupancy]
  [reg-index : i64]
  [var : i64]) : unit
  (let
    [segs : CompilerRegIntervalSeq
      (compiler-reg-live-union-var-segments occupancy var)]
    [len : i64 segs.len]
    (if (= len 0)
      (let
        [coarse : (__tl_dyn-array i64) occupancy.live-union-coarse]
        (set! (array-ref coarse reg-index) (- (array-ref coarse reg-index) 1)))
      (let
        [slots : (__tl_dyn-array CompilerRegInterval) segs.slots]
        [store : (__tl_dyn-array CompilerRegLiveUnion) occupancy.live-union]
        [union : CompilerRegLiveUnion (array-ref store reg-index)]
        [count : i64 union.count]
        [entries : (__tl_dyn-array i64) union.slots]
        [words : i64 (compiler-reg-live-union-entry-words)]
        [read : i64 0]
        [write : i64 0]
        [seg-index : i64 0]
        [first-drop : i64 count]
        (begin
          (while (< read count)
            (let
              [from : i64 (* read words)]
              [to : i64 (* write words)]
              [matched : bool
                (if (< seg-index len)
                  (let
                    [seg : CompilerRegInterval (array-ref slots seg-index)]
                    (and
                      (=
                        (array-ref entries from)
                        (compiler-reg-live-union-effective-start seg.start))
                      (= (array-ref entries (+ from 1)) seg.end)))
                  false)]
              (begin
                (if matched
                  (begin
                    (if (< write first-drop)
                      (set! first-drop write)
                      unit)
                    (set! seg-index (+ seg-index 1)))
                  (begin
                    (if (= from to)
                      unit
                      (begin
                        (set! (array-ref entries to) (array-ref entries from))
                        (set!
                          (array-ref entries (+ to 1))
                          (array-ref entries (+ from 1)))))
                    (set! write (+ write 1))))
                (set! read (+ read 1)))))
          (set!
            (array-ref store reg-index)
            (CompilerRegLiveUnion entries write))
          (compiler-reg-live-union-refresh-max! entries write first-drop))))))

(define (compiler-reg-greedy-occupancy-set-bit!
  [occupancy : CompilerRegGreedyOccupancy]
  [reg-index : i64]
  [var : i64]
  [present : bool]) : unit
  (let
    [primary : (__tl_dyn-array i64) occupancy.primary]
    [word-count : i64 occupancy.word-count]
    (if (or (< reg-index 0) (< var 0) (>= var (array-length primary)))
      unit
      (let
        [word-index : i64 (live.compiler-live-set-word-index var)]
        (if (>= word-index word-count)
          unit
          (let
            [words : (__tl_dyn-array i64) occupancy.words]
            [flat-index : i64
              (compiler-reg-greedy-occupancy-word-index
                occupancy
                reg-index
                word-index)]
            [mask : i64 (live.compiler-live-set-bit-mask var)]
            [old : i64 (array-ref words flat-index)]
            [was-set : bool (not (= (bit-and old mask) 0))]
            (begin
              ;; The union mirrors the bitset exactly: it is only touched when
              ;; this call actually flips the bit, so a redundant set (or clear)
              ;; can neither duplicate nor drop a resident's segments.
              (if present
                (if was-set
                  unit
                  (compiler-reg-live-union-add! occupancy reg-index var))
                (if was-set
                  (compiler-reg-live-union-remove! occupancy reg-index var)
                  unit))
              (set!
                (array-ref words flat-index)
                (if present
                  (bit-or old mask)
                  (bit-and old (bit-xor mask -1)))))))))))

(define (compiler-reg-greedy-occupancy-clear!
  [occupancy : CompilerRegGreedyOccupancy]
  [var : i64]) : unit
  (let
    [primary : (__tl_dyn-array i64) occupancy.primary]
    [secondary : (__tl_dyn-array i64) occupancy.secondary]
    (if (or (< var 0) (>= var (array-length primary)))
      unit
      (let
        [first : i64 (array-ref primary var)]
        [second : i64 (array-ref secondary var)]
        (begin
          (compiler-reg-greedy-occupancy-set-bit! occupancy first var false)
          (if (and (>= second 0) (not (= first second)))
            (compiler-reg-greedy-occupancy-set-bit! occupancy second var false)
            unit)
          (set! (array-ref primary var) -1)
          (set! (array-ref secondary var) -1))))))

(define (compiler-reg-greedy-occupancy-assign!
  [occupancy : CompilerRegGreedyOccupancy]
  [var : i64]
  [first : i64]
  [second : i64]) : unit
  (let
    [primary : (__tl_dyn-array i64) occupancy.primary]
    [secondary : (__tl_dyn-array i64) occupancy.secondary]
    (if (or (< var 0) (>= var (array-length primary)))
      unit
      (begin
        (compiler-reg-greedy-occupancy-clear! occupancy var)
        (set! (array-ref primary var) first)
        (set! (array-ref secondary var) second)
        (compiler-reg-greedy-occupancy-set-bit! occupancy first var true)
        (if (and (>= second 0) (not (= first second)))
          (compiler-reg-greedy-occupancy-set-bit! occupancy second var true)
          unit)))))

(define (compiler-reg-greedy-occupancy-record-location!
  [occupancy : CompilerRegGreedyOccupancy]
  [var : i64]
  [location : CompilerRegLocation]) : unit
  (match location
    [(CompilerRegLocation.Register reg)
      (compiler-reg-greedy-occupancy-assign!
        occupancy
        var
        (compiler-reg-greedy-pool-index occupancy reg)
        -1)]
    [(CompilerRegLocation.RegisterPair first second)
      (compiler-reg-greedy-occupancy-assign!
        occupancy
        var
        (compiler-reg-greedy-pool-index occupancy first)
        (compiler-reg-greedy-pool-index occupancy second))]
    [(CompilerRegLocation.Spill _) unit]
    [(CompilerRegLocation.Remat _) unit]))

;; `interval-index` seeds the per-register union. Every query against the
;; returned occupancy MUST pass the same index: the union is a materialised view
;; of exactly this segment table.
(define (compiler-reg-greedy-occupancy-make
  [assignments : CompilerRegAssignmentTable]
  [interval-index : CompilerRegIntervalIndex]
  [reg-arr : (__tl_dyn-array i64)]
  [rcount : i64]) : CompilerRegGreedyOccupancy
  (let
    [present : (__tl_dyn-array i64) assignments.present]
    [items : (__tl_dyn-array CompilerRegLocation) assignments.items]
    [n : i64 (array-length present)]
    [word-count : i64
      (/
        (+ n (- (live.compiler-live-set-word-bits) 1))
        (live.compiler-live-set-word-bits))]
    [storage-word-count : i64
      (if (< word-count 1)
        1
        word-count)]
    [storage-reg-count : i64
      (if (< rcount 1)
        1
        rcount)]
    [words : (__tl_dyn-array i64)
      (array.make-array i64 (* storage-reg-count storage-word-count))]
    [primary : (__tl_dyn-array i64)
      (array.make-array
        i64
        (if (< n 1)
          1
          n))]
    [secondary : (__tl_dyn-array i64)
      (array.make-array
        i64
        (if (< n 1)
          1
          n))]
    [pool-index : (__tl_dyn-array i64)
      (compiler-reg-greedy-pool-index-build reg-arr rcount)]
    ;; Every register starts empty and only allocates entry storage when it
    ;; first takes a resident: in the average function almost no pool register
    ;; is ever occupied. The slots are initialised by
    ;; compiler-reg-fill-live-union-array!, the same shape the segment tables
    ;; use -- see that helper for why the fill is not written inline here.
    [live-union : (__tl_dyn-array CompilerRegLiveUnion)
      (array.make-array CompilerRegLiveUnion storage-reg-count)]
    [live-union-coarse : (__tl_dyn-array i64)
      (array.make-array i64 storage-reg-count)]
    [occupancy : CompilerRegGreedyOccupancy
      (CompilerRegGreedyOccupancy
        words
        word-count
        primary
        secondary
        pool-index
        live-union
        live-union-coarse
        interval-index.segments)]
    [var : i64 0]
    (begin
      (compiler-reg-fill-i64-array words 0)
      (compiler-reg-fill-i64-array primary -1)
      (compiler-reg-fill-i64-array secondary -1)
      (compiler-reg-fill-live-union-array! live-union 0)
      (while (< var n)
        (begin
          (if (= (array-ref present var) 1)
            (compiler-reg-greedy-occupancy-record-location!
              occupancy
              var
              (array-ref items var))
            unit)
          (set! var (+ var 1))))
      occupancy)))

(define (compiler-reg-greedy-assignment-register!
  [assignments : CompilerRegAssignmentTable]
  [occupancy : CompilerRegGreedyOccupancy]
  [reg-arr : (__tl_dyn-array i64)]
  [var : i64]
  [reg-index : i64]) : CompilerRegAssignmentTable
  (begin
    (compiler-reg-greedy-occupancy-assign! occupancy var reg-index -1)
    (compiler-reg-assignment-table-insert
      assignments
      var
      (CompilerRegLocation.Register (array-ref reg-arr reg-index)))))

(define (compiler-reg-greedy-assignment-spill!
  [assignments : CompilerRegAssignmentTable]
  [occupancy : CompilerRegGreedyOccupancy]
  [var : i64]) : CompilerRegAssignmentTable
  (begin
    (compiler-reg-greedy-occupancy-clear! occupancy var)
    (compiler-reg-assignment-table-insert
      assignments
      var
      (CompilerRegLocation.Spill (compiler-reg-stack-slot-offset var)))))

(define (compiler-reg-greedy-assignment-unassign!
  [assignments : CompilerRegAssignmentTable]
  [occupancy : CompilerRegGreedyOccupancy]
  [var : i64]) : CompilerRegAssignmentTable
  (begin
    (compiler-reg-greedy-occupancy-clear! occupancy var)
    (compiler-reg-assignment-table-unassign assignments var)))

(define (compiler-reg-greedy-id-seq-to-array
  [regs : CompilerRegIdSeq]
  [out : (__tl_dyn-array i64)]
  [i : i64]) : unit
  (let
    [index : i64 0]
    (while (and
      (< index (compiler-reg-id-seq-count regs))
      (< (+ i index) (array-length out)))
      (begin
        (set! (array-ref out (+ i index)) (compiler-reg-id-seq-ref regs index))
        (set! index (+ index 1))))))

;; Max ref-count among vars holding `reg` that interfere with `var`; -1 if none.
(define (compiler-reg-greedy-interferer-max
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (__tl_dyn-array i64)]
  [var : i64]
  [reg-index : i64]
  [word-index : i64]
  [acc : i64]) : i64
  (if (>= word-index occupancy.word-count)
    acc
    (let
      [words : (__tl_dyn-array i64) occupancy.words]
      [bits : i64
        (array-ref
          words
          (compiler-reg-greedy-occupancy-word-index
            occupancy
            reg-index
            word-index))]
      [best : i64 acc]
      (begin
        (while (not (= bits 0))
          (let
            [bit : i64 (compiler-reg-low-bit-index32 bits)]
            [other : i64
              (+ (* word-index (live.compiler-live-set-word-bits)) bit)]
            (begin
              (if (and
                (not (= other var))
                (compiler-reg-vars-interfere-segmented-index?
                  interval-index
                  var
                  other))
                (let
                  [weight : i64
                    (if (< other (array-length ref-counts))
                      (array-ref ref-counts other)
                      0)]
                  (if (> weight best)
                    (set! best weight)
                    unit))
                unit)
              (set! bits (bit-and bits (- bits 1))))))
        (compiler-reg-greedy-interferer-max
          occupancy
          interval-index
          ref-counts
          var
          reg-index
          (+ word-index 1)
          best)))))

;; Can `var` take pool register `reg-index` without interfering with a resident?
;;
;; DECISION IDENTITY with the per-resident scan it replaces. `interferer-max`
;; returns -1 exactly when no resident other than `var` itself interferes:
;; ref-counts entries are built by accumulating loop-depth weights (>= 1) into a
;; zeroed array and are only ever halved by the remat discount, so every real
;; interferer contributes a weight >= 0 > -1. "Free" therefore means "no
;; interferer", which is precisely what the union answers -- provided
;;   * the candidate has segment data, and no resident of this register lacks it
;;     (otherwise the predicate takes its coarse whole-interval fallback, which
;;     the union does not model), and
;;   * the candidate is not itself a resident of this register (the scan skips
;;     `other = var`; the union cannot tell its own entries apart).
;; Any of those three sends the query to the original scan, so the answer is the
;; old answer in every case. Over a full opt2 self-compile all three guards are
;; measured never to fire, so the fallback is a correctness backstop, not a
;; performance path.
(define (compiler-reg-greedy-reg-free?
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (__tl_dyn-array i64)]
  [var : i64]
  [reg-index : i64]) : bool
  (let
    [primary : (__tl_dyn-array i64) occupancy.primary]
    [coarse : (__tl_dyn-array i64) occupancy.live-union-coarse]
    [segs : CompilerRegIntervalSeq
      (if (and (>= reg-index 0) (< reg-index (array-length coarse)))
        (compiler-reg-live-union-var-segments occupancy var)
        (compiler-reg-interval-seq-empty))]
    (if (and
      (not (= segs.len 0))
      (= (array-ref coarse reg-index) 0)
      (or
        (>= var (array-length primary))
        (and
          (not (= (array-ref primary var) reg-index))
          (not (= (array-ref occupancy.secondary var) reg-index)))))
      (not (compiler-reg-live-union-interferes? occupancy reg-index segs))
      (=
        (compiler-reg-greedy-interferer-max
          occupancy
          interval-index
          ref-counts
          var
          reg-index
          0
          (- 0 1))
        (- 0 1)))))

;; {rax,rdx}: the registers an idiv hard-clobbers (rax:rdx outputs). The INT_MIN/-1
;; overflow guard temps are no longer hardcoded to %r10/%r11 -- the guard scavenges
;; free registers (compiler-backend-div-overflow-guard-asm-with-plan), avoiding any
;; div-spanning value via the live query, so a div-spanning var may now use
;; %r10/%r11. rax stays reserved.
(define (compiler-reg-greedy-div-clobber-registers) : CompilerRegIdSeq
  (compiler-reg-id-seq-prepend
    cabi.compiler-reg-id-rax
    (compiler-reg-id-seq-prepend
      cabi.compiler-reg-id-rdx
      (compiler-reg-id-seq-empty))))

;; Caller-saved registers a div/shift-spanning (but NOT call-spanning) var may not
;; use: div-span -> {rax,rdx}, shift-span -> {rcx}, unioned. The call-span case is
;; handled separately by the start-idx skip, so it is not represented here.
(define (compiler-reg-greedy-forbidden-regs
  [spans-div : bool]
  [spans-shift : bool]) : CompilerRegIdSeq
  (let
    [div-part : CompilerRegIdSeq
      (if spans-div
        (compiler-reg-greedy-div-clobber-registers)
        (compiler-reg-id-seq-empty))]
    (if spans-shift
      (compiler-reg-id-seq-prepend cabi.compiler-reg-id-rcx div-part)
      div-part)))

(define (compiler-reg-greedy-first-free
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (__tl_dyn-array i64)]
  [var : i64]
  [reg-arr : (__tl_dyn-array i64)]
  [ridx : i64]
  [rcount : i64]
  [forbidden : CompilerRegIdSeq]) : i64
  (if (>= ridx rcount)
    -1
    (let
      [reg : i64 (array-ref reg-arr ridx)]
      (if (and
        (not (compiler-reg-id-seq-contains? forbidden reg))
        (compiler-reg-greedy-reg-free?
          occupancy
          interval-index
          ref-counts
          var
          ridx))
        ridx
        (compiler-reg-greedy-first-free
          occupancy
          interval-index
          ref-counts
          var
          reg-arr
          (+ ridx 1)
          rcount
          forbidden)))))

;; Copy-hint register: the reg held by the copy-neighbour, if it is in the pool
;; and free for `var`. Biases `var` onto its move-partner's register.
(define (compiler-reg-greedy-hint-free-reg
  [assignments : CompilerRegAssignmentTable]
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (__tl_dyn-array i64)]
  [copy-hints : (__tl_dyn-array i64)]
  [allowed-regs : CompilerRegIdSeq]
  [var : i64]
  [forbidden : CompilerRegIdSeq]) : i64
  (if (or (< var 0) (>= var (array-length copy-hints)))
    -1
    (let
      [nb : i64 (array-ref copy-hints var)]
      (if (< nb 0)
        -1
        (match (compiler-reg-assignment-table-lookup assignments nb)
          [(CompilerRegMaybeLocation.Some loc)
            (match loc
              [(CompilerRegLocation.Register r)
                (let
                  [reg-index : i64 (compiler-reg-greedy-pool-index occupancy r)]
                  (if (and
                    (>= reg-index 0)
                    (not (compiler-reg-id-seq-contains? forbidden r))
                    (compiler-reg-id-seq-contains? allowed-regs r)
                    (compiler-reg-greedy-reg-free?
                      occupancy
                      interval-index
                      ref-counts
                      var
                      reg-index))
                    reg-index
                    -1))]
              [(CompilerRegLocation.RegisterPair _ _) -1]
              [(CompilerRegLocation.Spill _) -1]
              [(CompilerRegLocation.Remat _) -1])]
          [(CompilerRegMaybeLocation.No) -1])))))

;; RAGreedy Component 1 cascade cap (LLVM canEvictInterference / cascade number).
;; A resident may be evicted+requeued at most this many times; once its
;; evict-count reaches the cap it becomes UNEVICTABLE (see interferer-max-capped),
;; so it stays put and the would-be evictor spills instead. This bounds the total
;; number of (re-)allocation attempts to count*(cap+1) -> guaranteed termination,
;; independent of the strict-lower-weight quality gate.
(define (compiler-reg-greedy-evict-cascade-cap) : i64
  4)

;; A weight strictly larger than any real spill weight; returned by
;; interferer-max-capped when a register is pinned by an over-cap (unevictable)
;; resident, so the `< weight` evictability gate can never select it.
(define (compiler-reg-greedy-evict-inf) : i64
  1000000000)

;; Like compiler-reg-greedy-interferer-max, but cascade-aware: if any interferer
;; holding `reg` (and interfering with `var`) has already been evicted at least
;; `cap` times, returns evict-inf (the register is unevictable). Otherwise returns
;; the max interferer weight (-1 if no interferer), identical to interferer-max.
;; With every evict-count==0 this is byte-identical to interferer-max, so the
;; no-eviction forward pass is unchanged.
(define (compiler-reg-greedy-interferer-max-capped
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (__tl_dyn-array i64)]
  [evict-count : (__tl_dyn-array i64)]
  [var : i64]
  [reg-index : i64]
  [word-index : i64]
  [acc : i64]) : i64
  (if (>= word-index occupancy.word-count)
    acc
    (let
      [words : (__tl_dyn-array i64) occupancy.words]
      [bits : i64
        (array-ref
          words
          (compiler-reg-greedy-occupancy-word-index
            occupancy
            reg-index
            word-index))]
      [best : i64 acc]
      (begin
        (while (and (not (= bits 0)) (< best (compiler-reg-greedy-evict-inf)))
          (let
            [bit : i64 (compiler-reg-low-bit-index32 bits)]
            [other : i64
              (+ (* word-index (live.compiler-live-set-word-bits)) bit)]
            (begin
              (if (and
                (not (= other var))
                (compiler-reg-vars-interfere-segmented-index?
                  interval-index
                  var
                  other))
                (let
                  [ec : i64
                    (if (< other (array-length evict-count))
                      (array-ref evict-count other)
                      0)]
                  [weight : i64
                    (if (< other (array-length ref-counts))
                      (array-ref ref-counts other)
                      0)]
                  (if (>= ec (compiler-reg-greedy-evict-cascade-cap))
                    (set! best (compiler-reg-greedy-evict-inf))
                    (if (> weight best)
                      (set! best weight)
                      unit)))
                unit)
              (set! bits (bit-and bits (- bits 1))))))
        (if (>= best (compiler-reg-greedy-evict-inf))
          best
          (compiler-reg-greedy-interferer-max-capped
            occupancy
            interval-index
            ref-counts
            evict-count
            var
            reg-index
            (+ word-index 1)
            best))))))

;; First pool register all of whose interferers are STRICTLY lower weight than
;; `weight` (so clearing it costs less than spilling `var`) AND none of which is
;; over the cascade cap; "" if none.
(define (compiler-reg-greedy-first-evictable
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (__tl_dyn-array i64)]
  [evict-count : (__tl_dyn-array i64)]
  [var : i64]
  [weight : i64]
  [reg-arr : (__tl_dyn-array i64)]
  [ridx : i64]
  [rcount : i64]
  [forbidden : CompilerRegIdSeq]) : i64
  (if (>= ridx rcount)
    -1
    (let
      [reg : i64 (array-ref reg-arr ridx)]
      [m : i64
        (compiler-reg-greedy-interferer-max-capped
          occupancy
          interval-index
          ref-counts
          evict-count
          var
          ridx
          0
          (- 0 1))]
      (if (and
        (not (compiler-reg-id-seq-contains? forbidden reg))
        (>= m 0)
        (< m weight))
        ridx
        (compiler-reg-greedy-first-evictable
          occupancy
          interval-index
          ref-counts
          evict-count
          var
          weight
          reg-arr
          (+ ridx 1)
          rcount
          forbidden)))))

;; RAGreedy Component 1: evict every resident holding `reg` that interferes with
;; `var`, then UNASSIGN it (present[]=0) and RE-ENQUEUE it (pending[]=1) for a
;; fresh allocation attempt, bumping its cascade evict-count. This replaces the
;; old whole-spill-on-evict (which gave the evicted resident no second chance):
;; the requeued resident competes again at its own priority and may land in a
;; different free register, or evict a still-lower resident, or finally spill.
;; first-evictable's cap gate guarantees no resident is requeued more than the
;; cascade cap, so the worklist terminates.
(define (compiler-reg-greedy-evict-requeue!
  [assignments : CompilerRegAssignmentTable]
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [pending : (__tl_dyn-array i64)]
  [evict-count : (__tl_dyn-array i64)]
  [heap : (&mut heap CompilerRegGreedyHeap)]
  [ref-counts : (__tl_dyn-array i64)]
  [var : i64]
  [reg-index : i64]
  [word-index : i64]) : unit
  (if (>= word-index occupancy.word-count)
    unit
    (let
      [words : (__tl_dyn-array i64) occupancy.words]
      [bits : i64
        (array-ref
          words
          (compiler-reg-greedy-occupancy-word-index
            occupancy
            reg-index
            word-index))]
      (begin
        (while (not (= bits 0))
          (let
            [bit : i64 (compiler-reg-low-bit-index32 bits)]
            [other : i64
              (+ (* word-index (live.compiler-live-set-word-bits)) bit)]
            (begin
              (if (and
                (not (= other var))
                (compiler-reg-vars-interfere-segmented-index?
                  interval-index
                  var
                  other))
                (begin
                  (compiler-reg-greedy-assignment-unassign!
                    assignments
                    occupancy
                    other)
                  (if (< other (array-length pending))
                    (begin
                      (set! (array-ref pending other) 1)
                      (compiler-reg-greedy-heap-push! heap ref-counts other))
                    unit)
                  (if (< other (array-length evict-count))
                    (set!
                      (array-ref evict-count other)
                      (+ (array-ref evict-count other) 1))
                    unit))
                unit)
              (set! bits (bit-and bits (- bits 1))))))
        (compiler-reg-greedy-evict-requeue!
          assignments
          occupancy
          interval-index
          pending
          evict-count
          heap
          ref-counts
          var
          reg-index
          (+ word-index 1))))))

(define (compiler-reg-greedy-already-assigned?
  [assignments : CompilerRegAssignmentTable]
  [var : i64]) : bool
  (match (compiler-reg-assignment-table-lookup assignments var)
    [(CompilerRegMaybeLocation.Some _) true]
    [(CompilerRegMaybeLocation.No) false]))

;; RS_* stage machine (LLVM RAGreedy selectOrSplit, made explicit on the per-vreg
;; base). alloc-one! pops one root in priority order and returns its terminal
;; stage:
;;   RS_Assign (1) -- got a register (hint reg, free reg, or by evicting strictly
;;                    lower-weight interferers).
;;   RS_Split  (2) -- no register, but the spilled root has a split-eligible
;;                    (multi-segment / loop-carried) live range, so the function-
;;                    level region-splitter (compiler-reg-loop-split-*, run as the
;;                    backend post-pass on THIS plan) will rescue it: rewrite the
;;                    hot region to a fresh register-resident var + cold-edge
;;                    boundary copies, cost-gated by mentions x loop-depth. The
;;                    greedy returns a CompilerRegPlan (not a rewritten function),
;;                    so the IR-rewriting split necessarily lives in that post-pass;
;;                    this stage records the selectOrSplit decision.
;;   RS_Spill  (3) -- no register and not split-eligible: stack-home it.
;; The plan output is identical to the single-pass M1 (every non-assigned root is
;; spilled either way); the stage is the explicit decision the post-pass consumes.
(define (compiler-reg-greedy-stage-rs-new) : i64
  0)

(define (compiler-reg-greedy-stage-rs-assign) : i64
  1)

(define (compiler-reg-greedy-stage-rs-split) : i64
  2)

(define (compiler-reg-greedy-stage-rs-spill) : i64
  3)

;; Physical-register preference (arg-var -> ABI-arg-register coalescing). For an
;; OUTGOING call-argument var the plan records the greedy-integer-pool INDEX of the
;; SysV register it will be marshalled into (arg position i ->
;; compiler-backend-arg-reg i: 0=%rdi,1=%rsi,2=%rdx,3=%rcx,4=%r8,5=%r9). Homing the
;; arg value directly in that register turns the backend's `movq <home>, %rdi`
;; marshalling move into a `movq %rdi, %rdi` self-move that the peephole drops.
;; SOUND because an arg value is consumed AT the call (not live across it):
;;   * `spans-call` vars are gated out, so a genuinely call-spanning value is NEVER
;;     homed in a caller-saved arg register (it would be clobbered by the call it
;;     spans) -- those fall through to the callee-saved-only search below;
;;   * the preference is honoured ONLY when the register is in the active pool, not
;;     clobbered by a spanned div/shift (`forbidden`), and FREE over the var's whole
;;     interval (no interferer holds it). Any failure returns "" and the normal
;;     hint/free/evict pick runs, so a preference can never force a spill, evict a
;;     value, or create interference -- it only biases a free choice.
(define (compiler-reg-greedy-arg-pref-reg
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (__tl_dyn-array i64)]
  [arg-prefs : (__tl_dyn-array i64)]
  [reg-arr : (__tl_dyn-array i64)]
  [rcount : i64]
  [var : i64]
  [forbidden : CompilerRegIdSeq]
  [spans-call : bool]) : i64
  (if (or spans-call (< var 0) (>= var (array-length arg-prefs)))
    -1
    (let
      [idx : i64 (array-ref arg-prefs var)]
      (if (or (< idx 0) (>= idx rcount))
        -1
        (let
          [reg : i64 (array-ref reg-arr idx)]
          (if (and
            (not (compiler-reg-id-seq-contains? forbidden reg))
            (compiler-reg-greedy-reg-free?
              occupancy
              interval-index
              ref-counts
              var
              idx))
            idx
            -1))))))

(define (compiler-reg-greedy-alloc-one!
  [assignments : CompilerRegAssignmentTable]
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (__tl_dyn-array i64)]
  [copy-hints : (__tl_dyn-array i64)]
  [arg-prefs : (__tl_dyn-array i64)]
  [group-vars : live.CompilerLiveI64Set]
  [param-roots : live.CompilerLiveI64Set]
  [regs : CompilerRegIdSeq]
  [reg-arr : (__tl_dyn-array i64)]
  [rcount : i64]
  [var : i64]
  [call-points : live.CompilerLiveI64Set]
  [div-points : live.CompilerLiveI64Set]
  [shift-points : live.CompilerLiveI64Set]
  [callee-regs : CompilerRegIdSeq]
  [caller-saved-count : i64]
  [unspillable-from : i64]
  [scratch-excluded : (__tl_dyn-array CompilerRegIdSeq)]
  [pending : (__tl_dyn-array i64)]
  [evict-count : (__tl_dyn-array i64)]
  [heap : (&mut heap CompilerRegGreedyHeap)]) : i64
  (if (or
    (compiler-reg-greedy-already-assigned? assignments var)
    (live.compiler-live-set-contains? group-vars var))
    (compiler-reg-greedy-stage-rs-new)
    (let
      ;; Per-register clobber (15c). A call-spanning value may use NO caller-saved
      ;; reg (start past the caller-saved prefix, callee-saved copy-hints only) --
      ;; the original coarse rule. A value that spans only a div/shift may still use
      ;; the caller-saved regs that op does NOT clobber: it searches the whole pool
      ;; (start-idx 0) with `forbidden` excluding just {rax,rdx} (div) and/or
      ;; {rcx} (shift).
      [spans-call : bool
        (compiler-reg-greedy-var-spans-clobber? interval-index call-points var)]
      [spans-div : bool
        (compiler-reg-greedy-var-spans-clobber? interval-index div-points var)]
      [spans-shift : bool
        (compiler-reg-greedy-var-spans-clobber? interval-index shift-points var)]
      ;; M-A (RC1) v1: a param (or a coalesce class containing one) is restricted
      ;; to CALLEE-SAVED homes regardless of call-spanning. The entry copy writes
      ;; the home in the prologue; a caller-saved home could be clobbered by a
      ;; later param's entry-copy scratch or an early scavenge, and the incoming
      ;; SysV arg registers are all caller-saved, so CSR homes are the copy-safe
      ;; set (the prologue saves CSRs BEFORE the param copies run).
      [is-param : bool (live.compiler-live-set-contains? param-roots var)]
      [csr-only : bool (or spans-call is-param)]
      [start-idx : i64
        (if csr-only
          caller-saved-count
          0)]
      [hint-regs : CompilerRegIdSeq
        (if csr-only
          callee-regs
          regs)]
      [scratch-forbidden : CompilerRegIdSeq
        (if (and (>= var 0) (< var (array-length scratch-excluded)))
          (array-ref scratch-excluded var)
          (compiler-reg-id-seq-empty))]
      [forbidden : CompilerRegIdSeq
        (let
          [base : CompilerRegIdSeq
            (if csr-only
              (compiler-reg-id-seq-empty)
              (compiler-reg-greedy-forbidden-regs spans-div spans-shift))]
          (compiler-reg-id-seq-append
            scratch-forbidden
            (if (and (>= unspillable-from 0) (>= var unspillable-from))
              (compiler-reg-id-seq-append
                (compiler-reg-scratch-div-fixed-registers)
                base)
              base)))]
      ;; Highest-priority bias: if this var is an outgoing call argument, try its
      ;; ABI arg register first (free-only, never evicting). Falls through to the
      ;; copy-hint / first-free / evict pick when the arg register is unavailable.
      ;; csr-only (call-spanning OR param) declines: arg registers are all
      ;; caller-saved.
      [pref : i64
        (compiler-reg-greedy-arg-pref-reg
          occupancy
          interval-index
          ref-counts
          arg-prefs
          reg-arr
          rcount
          var
          forbidden
          csr-only)]
      [hint : i64
        (compiler-reg-greedy-hint-free-reg
          assignments
          occupancy
          interval-index
          ref-counts
          copy-hints
          hint-regs
          var
          forbidden)]
      ;; The ABI arg-register preference takes priority over the copy hint; both
      ;; are free-only picks (no eviction), so a single nonnegative test assigns
      ;; whichever applies and otherwise falls through to first-free/evict/spill.
      [chosen : i64
        (if (>= pref 0)
          pref
          hint)]
      (if (>= chosen 0)
        (begin
          (compiler-reg-greedy-assignment-register!
            assignments
            occupancy
            reg-arr
            var
            chosen)
          (compiler-reg-greedy-stage-rs-assign))
        (let
          [free : i64
            (compiler-reg-greedy-first-free
              occupancy
              interval-index
              ref-counts
              var
              reg-arr
              start-idx
              rcount
              forbidden)]
          (if (>= free 0)
            (begin
              (compiler-reg-greedy-assignment-register!
                assignments
                occupancy
                reg-arr
                var
                free)
              (compiler-reg-greedy-stage-rs-assign))
            (let
              [weight : i64
                (if (< var (array-length ref-counts))
                  (array-ref ref-counts var)
                  0)]
              [ev : i64
                (compiler-reg-greedy-first-evictable
                  occupancy
                  interval-index
                  ref-counts
                  evict-count
                  var
                  weight
                  reg-arr
                  start-idx
                  rcount
                  forbidden)]
              (if (>= ev 0)
                (begin
                  (compiler-reg-greedy-evict-requeue!
                    assignments
                    occupancy
                    interval-index
                    pending
                    evict-count
                    heap
                    ref-counts
                    var
                    ev
                    0)
                  (compiler-reg-greedy-assignment-register!
                    assignments
                    occupancy
                    reg-arr
                    var
                    ev)
                  (compiler-reg-greedy-stage-rs-assign))
                ;; Synthetic scratch requirements have no stack representation:
                ;; leave an impossible placement unassigned for the retained
                ;; post-pass/scavenger fallback. Real values keep the ordinary
                ;; whole-interval spill path.
                (if (and (>= unspillable-from 0) (>= var unspillable-from))
                  (compiler-reg-greedy-stage-rs-new)
                  (begin
                    (compiler-reg-greedy-assignment-spill!
                      assignments
                      occupancy
                      var)
                    (if (compiler-reg-interval-index-var-has-segments?
                      interval-index
                      var)
                      (compiler-reg-greedy-stage-rs-split)
                      (compiler-reg-greedy-stage-rs-spill))))))))))))

(define (compiler-reg-greedy-collect-vars
  [candidates : CompilerRegIntervalSeq]
  [out : (__tl_dyn-array i64)]
  [i : i64]) : i64
  (let
    [index : i64 0]
    [at : i64 i]
    (begin
      (while (< index (compiler-reg-interval-seq-count candidates))
        (begin
          (let
            [var : i64
              (__tl-project-field
                (compiler-reg-interval-seq-ref candidates index)
                var)]
            (begin
              (if (< at (array-length out))
                (set! (array-ref out at) var)
                unit)
              (set! at (+ at 1))))
          (set! index (+ index 1))))
      at)))

(define (compiler-reg-greedy-weight-before?
  [ref-counts : (__tl_dyn-array i64)]
  [a : i64]
  [b : i64]) : bool
  (let
    [wa : i64
      (if (< a (array-length ref-counts))
        (array-ref ref-counts a)
        0)]
    [wb : i64
      (if (< b (array-length ref-counts))
        (array-ref ref-counts b)
        0)]
    (if (> wa wb)
      true
      (if (< wa wb)
        false
        (< a b)))))

;; Merge two adjacent sorted runs `[lo, mid)` and `[mid, hi)` of `src` into
;; `dst`, taking from the RIGHT run only when its head is strictly
;; `compiler-reg-greedy-weight-before?` the left head. That tie rule makes the
;; merge stable.
(define (compiler-reg-greedy-merge-run!
  [src : (__tl_dyn-array i64)]
  [dst : (__tl_dyn-array i64)]
  [ref-counts : (__tl_dyn-array i64)]
  [lo : i64]
  [mid : i64]
  [hi : i64]) : unit
  (let
    [i : i64 lo]
    [j : i64 mid]
    [k : i64 lo]
    (while (< k hi)
      (let
        ;; Take the right run when the left is exhausted, and otherwise only
        ;; when its head is STRICTLY before the left head -- the tie goes left,
        ;; which is what makes the merge stable. `k < hi` guarantees at least
        ;; one run still has an element, so `j >= hi` implies `i < mid`.
        [from-right : bool
          (and
            (< j hi)
            (or
              (>= i mid)
              (compiler-reg-greedy-weight-before?
                ref-counts
                (array-ref src j)
                (array-ref src i))))]
        (begin
          (if from-right
            (begin
              (set! (array-ref dst k) (array-ref src j))
              (set! j (+ j 1)))
            (begin
              (set! (array-ref dst k) (array-ref src i))
              (set! i (+ i 1))))
          (set! k (+ k 1)))))))

(define (compiler-reg-greedy-merge-pass!
  [src : (__tl_dyn-array i64)]
  [dst : (__tl_dyn-array i64)]
  [ref-counts : (__tl_dyn-array i64)]
  [count : i64]
  [width : i64]) : unit
  (let
    [lo : i64 0]
    (while (< lo count)
      (let
        [mid : i64
          (if (< (+ lo width) count)
            (+ lo width)
            count)]
        [hi : i64
          (if (< (+ lo (+ width width)) count)
            (+ lo (+ width width))
            count)]
        (begin
          (compiler-reg-greedy-merge-run! src dst ref-counts lo mid hi)
          (set! lo hi))))))

(define (compiler-reg-greedy-copy-range!
  [src : (__tl_dyn-array i64)]
  [dst : (__tl_dyn-array i64)]
  [count : i64]) : unit
  (let
    [i : i64 0]
    (while (< i count)
      (begin
        (set! (array-ref dst i) (array-ref src i))
        (set! i (+ i 1))))))

;; Order the first `count` entries of `arr` by
;; `compiler-reg-greedy-weight-before?`. This was an insertion sort, whose
;; quadratic comparison count is charged entirely to the few hundred-to-
;; thousand-candidate functions (491,190 sorted entries cost 8.44M comparisons
;; in an opt2 self-compile). The comparator is a strict total order and both
;; insertion sort and this bottom-up merge are STABLE, so they agree on the
;; permutation for every input -- including one with repeated ids, where the
;; comparator reports neither element before the other. The eviction order the
;; greedy then walks is therefore bit-identical.
(define (compiler-reg-greedy-sort!
  [arr : (__tl_dyn-array i64)]
  [ref-counts : (__tl_dyn-array i64)]
  [count : i64]) : unit
  (if (< count 2)
    unit
    (let
      [buf : (__tl_dyn-array i64) (array.make-array i64 count)]
      [width : i64 1]
      [flipped : bool false]
      (begin
        (while (< width count)
          (begin
            (if flipped
              (compiler-reg-greedy-merge-pass! buf arr ref-counts count width)
              (compiler-reg-greedy-merge-pass! arr buf ref-counts count width))
            (set! flipped (not flipped))
            (set! width (+ width width))))
        (if flipped
          (compiler-reg-greedy-copy-range! buf arr count)
          unit)))))

;; Combine the remat-DISCOUNTED spill weight (primary eviction priority) with the
;; RAW (undiscounted) use-density (secondary tie-break) into a single key:
;;   combined = discounted * (maxRaw + 1) + raw
;; Sorting/eviction by `combined` therefore orders first by discounted weight
;; (remat values are cheaper to spill, so they rank lower and spill first) and,
;; among equal discounted weight, by raw use count (the genuinely coldest value
;; spills first). The /2 remat discount collapses distinct use counts to the same
;; small integer; without the raw secondary key the greedy would spill an
;; arbitrary tied value (e.g. a 2-use value over the 1-use coldest). maxRaw+1 as
;; the radix keeps `discounted` strictly dominant. A non-remat value (discounted
;; == raw) outranks a remat value of equal raw, so remat is still preferred for
;; spilling.
(define (compiler-reg-greedy-combine-spill-weights
  [discounted : (__tl_dyn-array i64)]
  [raw : (__tl_dyn-array i64)]) : (__tl_dyn-array i64)
  (let
    [n : i64 (array-length discounted)]
    [out : (__tl_dyn-array i64) (array.make-array i64 n)]
    [max-raw : i64 0]
    [v : i64 0]
    (begin
      (while (< v n)
        (begin
          (let
            [r : i64
              (if (< v (array-length raw))
                (array-ref raw v)
                0)]
            (if (> r max-raw)
              (set! max-raw r)
              unit))
          (set! v (+ v 1))))
      (set! v 0)
      (while (< v n)
        (begin
          (let
            [d : i64 (array-ref discounted v)]
            [r : i64
              (if (< v (array-length raw))
                (array-ref raw v)
                0)]
            (set! (array-ref out v) (+ (* d (+ max-raw 1)) r)))
          (set! v (+ v 1))))
      out)))

;; Binary max-heap over (spill weight desc, var-id asc) -- the exact
;; compiler-reg-greedy-weight-before? total order the O(n) pending-array scan
;; selected, so pops are bit-identical while costing O(log n). The pending array
;; stays authoritative for membership: entries it no longer marks are lazily
;; discarded on pop, so evict-requeue never needs a decrease-key.
(defstruct CompilerRegGreedyHeap
  (arr (__tl_dyn-array i64))
  (len i64))

(define (compiler-reg-greedy-heap-weight
  [ref-counts : (__tl_dyn-array i64)]
  [v : i64]) : i64
  (if (< v (array-length ref-counts))
    (array-ref ref-counts v)
    0))

(define (compiler-reg-greedy-heap-better?
  [ref-counts : (__tl_dyn-array i64)]
  [a : i64]
  [b : i64]) : bool
  (let
    [wa : i64 (compiler-reg-greedy-heap-weight ref-counts a)]
    [wb : i64 (compiler-reg-greedy-heap-weight ref-counts b)]
    (if (> wa wb)
      true
      (if (= wa wb)
        (< a b)
        false))))

(define (compiler-reg-greedy-heap-swap!
  [arr : (&mut arr (__tl_dyn-array i64))]
  [a : i64]
  [b : i64]) : unit
  (let
    [t : i64 (array-ref arr a)]
    (begin
      (set! (array-ref arr a) (array-ref arr b))
      (set! (array-ref arr b) t))))

(define (compiler-reg-greedy-heap-sift-up!
  [arr : (&mut arr (__tl_dyn-array i64))]
  [ref-counts : (__tl_dyn-array i64)]
  [index : i64]) : unit
  (if (<= index 0)
    unit
    (let
      [parent : i64 (/ (- index 1) 2)]
      (if (compiler-reg-greedy-heap-better?
        ref-counts
        (array-ref arr index)
        (array-ref arr parent))
        (begin
          (compiler-reg-greedy-heap-swap! arr index parent)
          (compiler-reg-greedy-heap-sift-up! arr ref-counts parent))
        unit))))

(define (compiler-reg-greedy-heap-sift-down!
  [arr : (&mut arr (__tl_dyn-array i64))]
  [ref-counts : (__tl_dyn-array i64)]
  [len : i64]
  [index : i64]) : unit
  (let
    [left : i64 (+ (* index 2) 1)]
    [right : i64 (+ (* index 2) 2)]
    (if (>= left len)
      unit
      (let
        [best : i64
          (if (compiler-reg-greedy-heap-better?
            ref-counts
            (array-ref arr left)
            (array-ref arr index))
            left
            index)]
        [best2 : i64
          (if (and
            (< right len)
            (compiler-reg-greedy-heap-better?
              ref-counts
              (array-ref arr right)
              (array-ref arr best)))
            right
            best)]
        (if (= best2 index)
          unit
          (begin
            (compiler-reg-greedy-heap-swap! arr index best2)
            (compiler-reg-greedy-heap-sift-down! arr ref-counts len best2)))))))

(define (compiler-reg-greedy-heap-copy-from!
  [next : (__tl_dyn-array i64)]
  [old : (& old (__tl_dyn-array i64))]
  [index : i64]) : unit
  (if (>= index (array-length old))
    unit
    (begin
      (set! (array-ref next index) (array-ref old index))
      (compiler-reg-greedy-heap-copy-from! next old (+ index 1)))))

(define (compiler-reg-greedy-heap-grown-array
  [old : (& old (__tl_dyn-array i64))]) : (__tl_dyn-array i64)
  (let
    [next : (__tl_dyn-array i64)
      (array.make-array i64 (* (array-length old) 2))]
    (begin
      (compiler-reg-greedy-heap-copy-from! next old 0)
      next)))

(define (compiler-reg-greedy-heap-grow!
  [heap : (&mut heap CompilerRegGreedyHeap)]) : unit
  (let
    [next : (__tl_dyn-array i64)
      (compiler-reg-greedy-heap-grown-array (& heap.arr))]
    (set! heap.arr next)))

(define (compiler-reg-greedy-heap-push!
  [heap : (&mut heap CompilerRegGreedyHeap)]
  [ref-counts : (__tl_dyn-array i64)]
  [v : i64]) : unit
  (begin
    (if (>= heap.len (array-length heap.arr))
      (compiler-reg-greedy-heap-grow! heap)
      unit)
    (let
      [index : i64 heap.len]
      (begin
        (set! (array-ref heap.arr index) v)
        (set! heap.len (+ index 1))
        (compiler-reg-greedy-heap-sift-up! (&mut heap.arr) ref-counts index)))))

(define (compiler-reg-greedy-heap-pop!
  [heap : (&mut heap CompilerRegGreedyHeap)]
  [ref-counts : (__tl_dyn-array i64)]
  [pending : (__tl_dyn-array i64)]) : i64
  (if (<= heap.len 0)
    (- 0 1)
    (let
      [top : i64 (array-ref heap.arr 0)]
      [last-index : i64 (- heap.len 1)]
      (begin
        (set! (array-ref heap.arr 0) (array-ref heap.arr last-index))
        (set! heap.len last-index)
        (if (> last-index 0)
          (compiler-reg-greedy-heap-sift-down!
            (&mut heap.arr)
            ref-counts
            last-index
            0)
          unit)
        (if (and
          (>= top 0)
          (< top (array-length pending))
          (= (array-ref pending top) 1))
          top
          (compiler-reg-greedy-heap-pop! heap ref-counts pending))))))

;; Seed the worklist: mark every collected root arr[i..count) pending. Non-roots
;; (group-var members, never-collected vars) stay pending=0 and are never popped.
(define (compiler-reg-greedy-worklist-seed!
  [arr : (__tl_dyn-array i64)]
  [i : i64]
  [count : i64]
  [pending : (__tl_dyn-array i64)]
  [heap : (&mut heap CompilerRegGreedyHeap)]
  [ref-counts : (__tl_dyn-array i64)]
  [scratch-base : i64]
  [scratch-phase : bool]) : unit
  (if (>= i count)
    unit
    (begin
      (let
        [v : i64 (array-ref arr i)]
        (if (and
          (>= v 0)
          (< v (array-length pending))
          (or
            (< scratch-base 0)
            (if scratch-phase
              (>= v scratch-base)
              (< v scratch-base))))
          (begin
            (set! (array-ref pending v) 1)
            (compiler-reg-greedy-heap-push! heap ref-counts v))
          unit))
      (compiler-reg-greedy-worklist-seed!
        arr
        (+ i 1)
        count
        pending
        heap
        ref-counts
        scratch-base
        scratch-phase))))

;; Re-entrant evict-and-requeue worklist loop (RAGreedy Component 1). Pop the
;; highest-weight pending root, dequeue it (pending=0), run selectOrSplit
;; (alloc-one!), and record its terminal RS_* stage. alloc-one! may, on the
;; tryEvict path, UNASSIGN + RE-ENQUEUE strictly-lower-weight residents (setting
;; their pending=1 and bumping evict-count); those get a fresh allocation attempt
;; here at their own priority. Termination: a resident is requeued at most
;; cascade-cap times (first-evictable refuses to evict an over-cap resident), so
;; the total pop count is bounded by count*(cap+1).
(define (compiler-reg-greedy-worklist-run!
  [pending : (__tl_dyn-array i64)]
  [evict-count : (__tl_dyn-array i64)]
  [heap : (&mut heap CompilerRegGreedyHeap)]
  [assignments : CompilerRegAssignmentTable]
  [occupancy : CompilerRegGreedyOccupancy]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (__tl_dyn-array i64)]
  [copy-hints : (__tl_dyn-array i64)]
  [arg-prefs : (__tl_dyn-array i64)]
  [group-vars : live.CompilerLiveI64Set]
  [param-roots : live.CompilerLiveI64Set]
  [regs : CompilerRegIdSeq]
  [reg-arr : (__tl_dyn-array i64)]
  [rcount : i64]
  [stages : (__tl_dyn-array i64)]
  [n : i64]
  [call-points : live.CompilerLiveI64Set]
  [div-points : live.CompilerLiveI64Set]
  [shift-points : live.CompilerLiveI64Set]
  [callee-regs : CompilerRegIdSeq]
  [caller-saved-count : i64]
  [unspillable-from : i64]
  [scratch-excluded : (__tl_dyn-array CompilerRegIdSeq)]) : unit
  (let
    [v : i64 (compiler-reg-greedy-heap-pop! heap ref-counts pending)]
    (if (< v 0)
      unit
      (begin
        (if (and (>= v 0) (< v (array-length pending)))
          (set! (array-ref pending v) 0)
          unit)
        (let
          [stg : i64
            (compiler-reg-greedy-alloc-one!
              assignments
              occupancy
              interval-index
              ref-counts
              copy-hints
              arg-prefs
              group-vars
              param-roots
              regs
              reg-arr
              rcount
              v
              call-points
              div-points
              shift-points
              callee-regs
              caller-saved-count
              unspillable-from
              scratch-excluded
              pending
              evict-count
              heap)]
          (if (and (>= v 0) (< v (array-length stages)))
            (set! (array-ref stages v) stg)
            unit))
        (compiler-reg-greedy-worklist-run!
          pending
          evict-count
          heap
          assignments
          occupancy
          interval-index
          ref-counts
          copy-hints
          arg-prefs
          group-vars
          param-roots
          regs
          reg-arr
          rcount
          stages
          n
          call-points
          div-points
          shift-points
          callee-regs
          caller-saved-count
          unspillable-from
          scratch-excluded)))))

;; Staged worklist driver (RAGreedy Component 1): re-entrant evict-and-requeue
;; priority worklist over the unassigned root set, processing highest-current-
;; weight first. Replaces the static forward recursion: when a higher-weight root
;; evicts a lower-weight resident, the resident is UNASSIGNED and RE-ENQUEUED for
;; another allocation attempt (instead of being whole-spilled with no second
;; chance) -- the foundation Component 2 (split-on-spill) builds on. With no
;; eviction firing (the strict descending-weight order makes tryEvict dead for
;; the initial pass) the worklist pops the same sorted sequence and produces the
;; same plan as the old forward pass. `arr[i..count)` are the sorted roots; the
;; per-root terminal RS_* stage is recorded in `stages` for the post-pass split.
(define (compiler-reg-greedy-alloc-all!
  [arr : (__tl_dyn-array i64)]
  [i : i64]
  [count : i64]
  [assignments : CompilerRegAssignmentTable]
  [interval-index : CompilerRegIntervalIndex]
  [ref-counts : (__tl_dyn-array i64)]
  [copy-hints : (__tl_dyn-array i64)]
  [arg-prefs : (__tl_dyn-array i64)]
  [group-vars : live.CompilerLiveI64Set]
  [param-roots : live.CompilerLiveI64Set]
  [regs : CompilerRegIdSeq]
  [reg-arr : (__tl_dyn-array i64)]
  [rcount : i64]
  [stages : (__tl_dyn-array i64)]
  [n : i64]
  [call-points : live.CompilerLiveI64Set]
  [div-points : live.CompilerLiveI64Set]
  [shift-points : live.CompilerLiveI64Set]
  [callee-regs : CompilerRegIdSeq]
  [caller-saved-count : i64]
  [unspillable-from : i64]
  [scratch-excluded : (__tl_dyn-array CompilerRegIdSeq)]) : unit
  (let
    [cap : i64
      (if (< n 1)
        1
        n)]
    [pending : (__tl_dyn-array i64) (array.make-array i64 cap)]
    [evict-count : (__tl_dyn-array i64) (array.make-array i64 cap)]
    [heap : CompilerRegGreedyHeap
      (CompilerRegGreedyHeap
        (array.make-array
          i64
          (if (< (- count i) 1)
            1
            (- count i)))
        0)]
    [occupancy : CompilerRegGreedyOccupancy
      (compiler-reg-greedy-occupancy-make
        assignments
        interval-index
        reg-arr
        rcount)]
    (begin
      ;; Scratch pseudos have no stack home. Mark them at the eviction cascade
      ;; cap so a placed pseudo can evict/requeue a real value but can never be
      ;; evicted itself. Fixed rax/rdx roles remain precolored in the table;
      ;; their occupancy is represented by the existing div clobber set so the
      ;; atomic instruction's operands/results may meet at the boundary.
      (if (>= unspillable-from 0)
        (let
          [v : i64 unspillable-from]
          (while (< v cap)
            (begin
              (compiler-reg-greedy-occupancy-clear! occupancy v)
              (set!
                (array-ref evict-count v)
                (compiler-reg-greedy-evict-cascade-cap))
              (set! v (+ v 1)))))
        unit)
      ;; Establish the unchanged real-value coloring first. Scratch then joins
      ;; the same occupancy/worklist and may evict/requeue a cheaper real root;
      ;; a no-pressure site cannot perturb an already valid real plan merely by
      ;; changing equal-weight heap insertion order.
      (compiler-reg-greedy-worklist-seed!
        arr
        i
        count
        pending
        (&mut heap)
        ref-counts
        unspillable-from
        false)
      (compiler-reg-greedy-worklist-run!
        pending
        evict-count
        (&mut heap)
        assignments
        occupancy
        interval-index
        ref-counts
        copy-hints
        arg-prefs
        group-vars
        param-roots
        regs
        reg-arr
        rcount
        stages
        n
        call-points
        div-points
        shift-points
        callee-regs
        caller-saved-count
        unspillable-from
        scratch-excluded)
      (if (>= unspillable-from 0)
        (begin
          (compiler-reg-greedy-worklist-seed!
            arr
            i
            count
            pending
            (&mut heap)
            ref-counts
            unspillable-from
            true)
          (compiler-reg-greedy-worklist-run!
            pending
            evict-count
            (&mut heap)
            assignments
            occupancy
            interval-index
            ref-counts
            copy-hints
            arg-prefs
            group-vars
            param-roots
            regs
            reg-arr
            rcount
            stages
            n
            call-points
            div-points
            shift-points
            callee-regs
            caller-saved-count
            unspillable-from
            scratch-excluded))
        unit))))

;; Unified Greedy integer register pool: caller-saved zero-call scratch
;; (%r9/%rcx/%rdx) FIRST so non-call-spanning values prefer them -- no
;; prologue/epilogue save/restore, the LLVM CSR-cost try-order -- then the other
;; caller-saved pool members (%r10/%r11/%r8), then the callee-saved pool. The
;; first `caller-saved-count` entries are caller-saved: a value whose live range
;; spans a backend clobber-point (call site / op that clobbers caller-saved regs)
;; may NOT use them (it would be clobbered across the clobber), exactly the
;; regmask-as-interference rule. Such values start their register search at the
;; callee-saved offset. This folds the old prepass-partition +
;; caller-saved-overflow into ONE allocation pass.
(define (compiler-reg-greedy-integer-pool) : CompilerRegIdSeq
  (compiler-reg-id-seq-prepend
    cabi.compiler-reg-id-rax
    (compiler-reg-id-seq-prepend
      cabi.compiler-reg-id-rsi
      (compiler-reg-id-seq-prepend
        cabi.compiler-reg-id-rdi
        (compiler-reg-id-seq-prepend
          cabi.compiler-reg-id-r9
          (compiler-reg-id-seq-prepend
            cabi.compiler-reg-id-rcx
            (compiler-reg-id-seq-prepend
              cabi.compiler-reg-id-rdx
              (compiler-reg-id-seq-prepend
                cabi.compiler-reg-id-r10
                (compiler-reg-id-seq-prepend
                  cabi.compiler-reg-id-r11
                  (compiler-reg-id-seq-prepend
                    cabi.compiler-reg-id-r8
                    (compiler-reg-sysv-integer-registers)))))))))))

(define (compiler-reg-greedy-caller-saved-count) : i64
  (-
    (compiler-reg-id-seq-count (compiler-reg-greedy-integer-pool))
    (compiler-reg-id-seq-count (compiler-reg-sysv-integer-registers))))

;; ABI-aware GP greedy pool. SysV is the byte-identical default pool above. Win64
;; differs ONLY in the caller/callee SPLIT: %rsi/%rdi are NONVOLATILE (callee-
;; saved) on Win64, so they must live in the callee-saved suffix (saved/restored
;; by the prologue, kept across calls) rather than the caller-saved prefix --
;; otherwise a Win64 function homes a value in %rsi/%rdi, treats it as clobbered
;; across calls, and clobbers the caller's nonvolatile register. All 14 registers
;; are in the pool for both ABIs; only the order (and thus caller-saved-count)
;; changes. The SysV self-host fixpoint cannot exercise this (SysV-only).
(define (compiler-reg-greedy-integer-pool-for-abi
  [target-abi : cabi.CompilerRegTargetAbi]) : CompilerRegIdSeq
  (match target-abi
    ;; M-G3 stage 2: when the backend enabled the per-function FPO flag, %rbp
    ;; joins as the LAST callee-saved register (index 14; the caller-saved
    ;; boundary stays 9 -- compiler-reg-greedy-caller-saved-count is derived
    ;; from the base pool, unchanged). Functions needing <= 5 CSRs keep their
    ;; previous homes.
    [(cabi.CompilerRegTargetAbi.Linux)
      (if compiler-reg-rbp-pool-enabled
        (compiler-reg-id-seq-prepend
          cabi.compiler-reg-id-rax
          (compiler-reg-id-seq-prepend
            cabi.compiler-reg-id-rsi
            (compiler-reg-id-seq-prepend
              cabi.compiler-reg-id-rdi
              (compiler-reg-id-seq-prepend
                cabi.compiler-reg-id-r9
                (compiler-reg-id-seq-prepend
                  cabi.compiler-reg-id-rcx
                  (compiler-reg-id-seq-prepend
                    cabi.compiler-reg-id-rdx
                    (compiler-reg-id-seq-prepend
                      cabi.compiler-reg-id-r10
                      (compiler-reg-id-seq-prepend
                        cabi.compiler-reg-id-r11
                        (compiler-reg-id-seq-prepend
                          cabi.compiler-reg-id-r8
                          (compiler-reg-sysv-integer-registers-with-rbp))))))))))
        (compiler-reg-greedy-integer-pool))]
    [(cabi.CompilerRegTargetAbi.Windows)
      ;; Win64: %rsi/%rdi are nonvolatile (callee-saved). The backend prologue/
      ;; epilogue saves them with the Win64 callee-save suffix. Keep the existing
      ;; r12-r15,rbx order first so old homes are stable until pressure reaches
      ;; the two extra Win64 nonvolatile registers. An FPO-eligible function
      ;; appends %rbp after both, preserving every existing home.
      ;; caller-saved (volatile) first: rax,rcx,rdx,r8,r9,r10,r11 (7), then the
      ;; backend-saved callee suffix r12-r15,rbx,rsi,rdi[,rbp].
      (let
        [base : CompilerRegIdSeq
          (compiler-reg-id-seq-prepend
            cabi.compiler-reg-id-rax
            (compiler-reg-id-seq-prepend
              cabi.compiler-reg-id-rcx
              (compiler-reg-id-seq-prepend
                cabi.compiler-reg-id-rdx
                (compiler-reg-id-seq-prepend
                  cabi.compiler-reg-id-r8
                  (compiler-reg-id-seq-prepend
                    cabi.compiler-reg-id-r9
                    (compiler-reg-id-seq-prepend
                      cabi.compiler-reg-id-r10
                      (compiler-reg-id-seq-prepend
                        cabi.compiler-reg-id-r11
                        (compiler-reg-id-seq-append
                          (compiler-reg-sysv-integer-registers)
                          (compiler-reg-id-seq-prepend
                            cabi.compiler-reg-id-rsi
                            (compiler-reg-id-seq-prepend
                              cabi.compiler-reg-id-rdi
                              (compiler-reg-id-seq-empty)))))))))))]
        (if compiler-reg-rbp-pool-enabled
          (compiler-reg-id-seq-append
            base
            (compiler-reg-id-seq-prepend
              cabi.compiler-reg-id-rbp
              (compiler-reg-id-seq-empty)))
          base))]))

(define (compiler-reg-greedy-caller-saved-count-for-abi
  [target-abi : cabi.CompilerRegTargetAbi]) : i64
  (match target-abi
    [(cabi.CompilerRegTargetAbi.Linux) (compiler-reg-greedy-caller-saved-count)]
    [(cabi.CompilerRegTargetAbi.Windows)
      ;; The optional %rbp is appended to the nonvolatile suffix and must not
      ;; move this boundary.
      (cabi.compiler-abi-caller-saved-gp-register-count target-abi)]))

;; Clobber-span test: must var's value SURVIVE any clobber-point?
;; (The clobber-span half of the old per-register zero-call gate, sans the
;; conflict check which the LiveIntervalUnion test already covers.)
;; Out-of-range -> conservative spanning (callee-saved only).
;;
;; The coarse [start,end] hull runs first: it is one masked word test and it is
;; an exact superset of the segment answer, so a value with no clobber in its
;; hull is decided without touching the segment table -- byte-identical work for
;; every value the hull already cleared. A value the HULL rejects then gets the
;; precise question: is the clobber inside one of its live SEGMENTS, or in a
;; HOLE? A hole is genuine deadness (see compiler-reg-segments-span-clobber?),
;; and pinning a value into a callee-saved home for a call it is provably dead
;; across is what makes a multi-arm dispatcher save and restore registers it
;; never needed. Indices without segment data (the hull-only
;; compiler-reg-interval-index-build variant the SIMD/AVX plan uses) keep the
;; coarse answer, so those paths are unchanged.
(define (compiler-reg-greedy-var-spans-clobber?
  [interval-index : CompilerRegIntervalIndex]
  [clobber-points : live.CompilerLiveI64Set]
  [var : i64]) : bool
  (let
    [starts : (__tl_dyn-array i64) interval-index.starts]
    [ends : (__tl_dyn-array i64) interval-index.ends]
    (if (and (>= var 0) (< var (array-length starts)))
      (and
        (compiler-reg-call-set-in-range?
          clobber-points
          (array-ref starts var)
          (array-ref ends var))
        (if (compiler-reg-interval-index-var-has-segments? interval-index var)
          (compiler-reg-segments-span-clobber?
            (array-ref interval-index.segments var)
            clobber-points
            (array-ref starts var)
            false)
          true))
      true)))

(define (compiler-reg-low-xmm-forbidden-registers) : CompilerRegIdSeq
  (compiler-reg-id-seq-prepend
    (cabi.compiler-abi-xmm-register-id 0)
    (compiler-reg-id-seq-prepend
      (cabi.compiler-abi-xmm-register-id 1)
      (compiler-reg-id-seq-empty))))

(define (compiler-reg-low-xmm-exclusions
  [interval-index : CompilerRegIntervalIndex]
  [clobber-points : live.CompilerLiveI64Set]) : (__tl_dyn-array
    CompilerRegIdSeq)
  (let
    [vars : i64 (array-length interval-index.starts)]
    [out : (__tl_dyn-array CompilerRegIdSeq)
      (array.make-array CompilerRegIdSeq vars)]
    [i : i64 0]
    (begin
      (while (< i vars)
        (begin
          (set!
            (array-ref out i)
            (if (compiler-reg-greedy-var-spans-clobber?
              interval-index
              clobber-points
              i)
              (compiler-reg-low-xmm-forbidden-registers)
              (compiler-reg-id-seq-empty)))
          (set! i (+ i 1))))
      out)))

;; Integer call-argument register IDs by position. Invalid past the ABI
;; register arguments (the rest are stack-passed and get no preference).
(define (compiler-reg-abi-arg-reg
  [target-abi : cabi.CompilerRegTargetAbi]
  [pos : i64]) : i64
  (cabi.compiler-abi-gp-arg-register-id target-abi pos))

(define (compiler-reg-id-seq-index-of
  [regs : CompilerRegIdSeq]
  [want : i64]
  [i : i64]) : i64
  (let
    [index : i64 0]
    [result : i64 -1]
    [done : bool false]
    (begin
      (while (and (< index (compiler-reg-id-seq-count regs)) (not done))
        (if (= (compiler-reg-id-seq-ref regs index) want)
          (begin
            (set! result (+ i index))
            (set! done true))
          (set! index (+ index 1))))
      result)))

;; Greedy-integer-pool INDEX of the ABI register for integer arg position `pos`,
;; or -1 if `pos` is not a register-passed argument. Computed by searching the
;; live ABI pool definition, so it stays correct if the pool order changes.
(define (compiler-reg-greedy-arg-pool-index-for-abi
  [target-abi : cabi.CompilerRegTargetAbi]
  [pool : CompilerRegIdSeq]
  [pos : i64]) : i64
  (let
    [reg : i64 (compiler-reg-abi-arg-reg target-abi pos)]
    (if (= reg cabi.compiler-reg-id-invalid)
      -1
      (compiler-reg-id-seq-index-of pool reg 0))))

;; Record arg-var -> ABI-register preference (greedy-pool index) for one call
;; argument at integer position `pos`. Only IrValueVar args take a home; the
;; var is mapped to its coalesce root (parents) like the copy hints, and the first
;; preference for a root wins. Stack-passed positions yield -1 and are skipped.
(define (compiler-reg-arg-pref-value!
  [target-abi : cabi.CompilerRegTargetAbi]
  [pool : CompilerRegIdSeq]
  [value : ir.CompilerIrValue]
  [pos : i64]
  [prefs : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]) : unit
  (match value
    [(ir.CompilerIrValue.Var v)
      (let
        [idx : i64
          (compiler-reg-greedy-arg-pool-index-for-abi target-abi pool pos)]
        (if (< idx 0)
          unit
          (let
            [root : i64
              (if (if (>= v 0)
                (< v (array-length parents))
                false)
                (array-ref parents v)
                v)]
            (if (if (>= root 0)
              (< root (array-length prefs))
              false)
              (if (< (array-ref prefs root) 0)
                (begin
                  (set! (array-ref prefs root) idx)
                  unit)
                unit)
              unit))))]
    [_ unit]))

(define (compiler-reg-arg-pref-array-at!
  [target-abi : cabi.CompilerRegTargetAbi]
  [pool : CompilerRegIdSeq]
  [values : (__tl_dyn-array ir.CompilerIrValue)]
  [i : i64]
  [pos : i64]
  [prefs : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]) : unit
  (if (>= i (array-length values))
    unit
    (begin
      (compiler-reg-arg-pref-value!
        target-abi
        pool
        (array-ref values i)
        pos
        prefs
        parents)
      (compiler-reg-arg-pref-array-at!
        target-abi
        pool
        values
        (+ i 1)
        (+ pos 1)
        prefs
        parents))))

(define (compiler-reg-arg-pref-args-at!
  [target-abi : cabi.CompilerRegTargetAbi]
  [pool : CompilerRegIdSeq]
  [args : ir.CompilerIrCallArgs]
  [start : i64]
  [prefs : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]) : unit
  (match args
    [(ir.CompilerIrCallArgs.Nil) unit]
    [(ir.CompilerIrCallArgs.One a)
      (compiler-reg-arg-pref-value! target-abi pool a start prefs parents)]
    [(ir.CompilerIrCallArgs.Two a b)
      (begin
        (compiler-reg-arg-pref-value! target-abi pool a start prefs parents)
        (compiler-reg-arg-pref-value!
          target-abi
          pool
          b
          (+ start 1)
          prefs
          parents))]
    [(ir.CompilerIrCallArgs.Array values)
      (compiler-reg-arg-pref-array-at!
        target-abi
        pool
        values
        0
        start
        prefs
        parents)]))

(define (compiler-reg-arg-pref-args!
  [target-abi : cabi.CompilerRegTargetAbi]
  [pool : CompilerRegIdSeq]
  [args : ir.CompilerIrCallArgs]
  [prefs : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]) : unit
  (compiler-reg-arg-pref-args-at! target-abi pool args 0 prefs parents))

;; Outgoing call instructions whose integer args are marshalled through ABI arg
;; registers. The callee/function-pointer operand of the indirect forms is NOT an
;; argument and is left without a preference. Closure calls reserve ABI arg slot
;; 0 for the environment pointer, so their user-arg preferences start at slot 1.
;; Syscalls use a different register convention and are intentionally omitted.
(define (compiler-reg-arg-pref-instr!
  [target-abi : cabi.CompilerRegTargetAbi]
  [pool : CompilerRegIdSeq]
  [instr : ir.CompilerIrInstr]
  [prefs : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]) : unit
  (match instr
    [(ir.CompilerIrInstr.Call _ _ args _)
      (compiler-reg-arg-pref-args! target-abi pool args prefs parents)]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (compiler-reg-arg-pref-args! target-abi pool args prefs parents))]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (compiler-reg-arg-pref-args! target-abi pool args prefs parents))]
    [(ir.CompilerIrInstr.TailCall _ args _)
      (compiler-reg-arg-pref-args! target-abi pool args prefs parents)]
    [(ir.CompilerIrInstr.TailCallIndirect _ args _)
      (compiler-reg-arg-pref-args-at! target-abi pool args 1 prefs parents)]
    [(ir.CompilerIrInstr.CallIndirect _ _ args _)
      (compiler-reg-arg-pref-args-at! target-abi pool args 1 prefs parents)]
    [(ir.CompilerIrInstr.CallIndirectC _ _ args _)
      (compiler-reg-arg-pref-args! target-abi pool args prefs parents)]
    [_ unit]))

;; M-C (part 2): call-result %rax preference. The backend stores a scalar call
;; result from %rax into the dst var's home (`movq %rax, <home>` via
;; emit-call-result-store), so homing the dst IN %rax turns that store into an
;; elided self-move. Record a free-only bias toward the pool index of %rax for
;; every var defined by a call-like instruction with a GP-scalar result. Same
;; substrate and consumption as the outgoing-arg preference: first-wins per
;; coalesce root, tried free-only in alloc-one! (never evicts), declined for
;; csr-only roots (call-spanning or param classes -- %rax is illegal across a
;; kind-0 clobber anyway), and filtered against the per-root forbidden set (a
;; div-spanning root already excludes %rax). Float results return in %xmm0 --
;; skipped. Group results use the return register PAIR -- their dst is a group
;; var alloc-one! skips before reading prefs, so a stray pref would be inert;
;; the C-ABI StoreResult forms write memory slots and are omitted entirely.
;; Registered AFTER the arg walk so an existing arg-register preference keeps
;; priority (either bias elides exactly one mov for arg-and-result vars).
(define (compiler-reg-result-pref-var!
  [dst : i64]
  [rax-idx : i64]
  [prefs : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]) : unit
  (if (< rax-idx 0)
    unit
    (let
      [root : i64
        (if (if (>= dst 0)
          (< dst (array-length parents))
          false)
          (array-ref parents dst)
          dst)]
      (if (if (>= root 0)
        (< root (array-length prefs))
        false)
        (if (< (array-ref prefs root) 0)
          (begin
            (set! (array-ref prefs root) rax-idx)
            unit)
          unit)
        unit))))

(define (compiler-reg-result-pref-instr!
  [instr : ir.CompilerIrInstr]
  [rax-idx : i64]
  [prefs : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]) : unit
  (match instr
    [(ir.CompilerIrInstr.Call dst _ _ ty)
      (if (compiler-reg-float-type? ty)
        unit
        (compiler-reg-result-pref-var! dst rax-idx prefs parents))]
    [(ir.CompilerIrInstr.CallIndirect dst _ _ ty)
      (if (compiler-reg-float-type? ty)
        unit
        (compiler-reg-result-pref-var! dst rax-idx prefs parents))]
    [(ir.CompilerIrInstr.CallIndirectC dst _ _ ty)
      (if (compiler-reg-float-type? ty)
        unit
        (compiler-reg-result-pref-var! dst rax-idx prefs parents))]
    [(ir.CompilerIrInstr.Syscall dst _)
      (compiler-reg-result-pref-var! dst rax-idx prefs parents)]
    [_ unit]))

(define (compiler-reg-result-pref-seq!
  [instrs : ir.CompilerIrInstrSeq]
  [rax-idx : i64]
  [prefs : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-reg-result-pref-instr!
            (array-ref slots index)
            rax-idx
            prefs
            parents)
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-result-pref-blocks!
  [blocks : ir.CompilerIrBlockList]
  [rax-idx : i64]
  [prefs : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-result-pref-seq! instrs rax-idx prefs parents)])
        (compiler-reg-result-pref-blocks!
          (__tl-box-place rest)
          rax-idx
          prefs
          parents))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-result-pref-seq! instrs rax-idx prefs parents)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-arg-pref-seq!
  [target-abi : cabi.CompilerRegTargetAbi]
  [pool : CompilerRegIdSeq]
  [instrs : ir.CompilerIrInstrSeq]
  [prefs : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-reg-arg-pref-instr!
            target-abi
            pool
            (array-ref slots index)
            prefs
            parents)
          (set! index (+ index 1))))
      unit)))

(define (compiler-reg-arg-pref-blocks!
  [target-abi : cabi.CompilerRegTargetAbi]
  [pool : CompilerRegIdSeq]
  [blocks : ir.CompilerIrBlockList]
  [prefs : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-arg-pref-seq! target-abi pool instrs prefs parents)])
        (compiler-reg-arg-pref-blocks!
          target-abi
          pool
          (__tl-box-place rest)
          prefs
          parents))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-arg-pref-seq!
                  target-abi
                  pool
                  instrs
                  prefs
                  parents)])
            (set! i (+ i 1)))))]))

;; Build the per-root physical-register preference array: each outgoing call-arg
;; var biased toward the ABI register it is marshalled into. Indexed by coalesce
;; root (like copy hints); -1 = no preference.
(define (compiler-reg-function-arg-prefs
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [coalesce : CompilerRegCoalesceMap]
  [n : i64]) : (__tl_dyn-array i64)
  (let
    [prefs : (__tl_dyn-array i64) (array.make-array i64 n)]
    [parents : (__tl_dyn-array i64) coalesce.parents]
    [pool : CompilerRegIdSeq
      (compiler-reg-greedy-integer-pool-for-abi target-abi)]
    (begin
      (compiler-reg-fill-i64-array prefs -1)
      (match func
        [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
          (begin
            (compiler-reg-arg-pref-blocks! target-abi pool blocks prefs parents)
            ;; M-C (part 2): call-result %rax bias fills roots the arg walk
            ;; left unbiased. The pool index is looked up from the live ABI pool
            ;; definition so it tracks any pool reorder (both ABIs: index 0).
            (compiler-reg-result-pref-blocks!
              blocks
              (compiler-reg-id-seq-index-of pool cabi.compiler-reg-id-rax 0)
              prefs
              parents))])
      prefs)))

;; Float call arguments use independent XMM ordinals on SysV and shared argument
;; positions on Win64. Record only preferences that exist in the allocator's XMM
;; pool. Under scratch-vreg, XMM0/XMM1 are ordinary volatile homes as well as
;; leading ABI argument registers, so these preferences eliminate their moves.
;; `is-float` is supplied by the caller. Every caller already needs the same
;; classification to advance the argument-bank indices, and recomputing it here
;; walked the sorted var-type list a second time for the same value.
(define (compiler-reg-float-arg-pref-value!
  [target-abi : cabi.CompilerRegTargetAbi]
  [pool : CompilerRegIdSeq]
  [value : ir.CompilerIrValue]
  [is-float : bool]
  [float-idx : i64]
  [position : i64]
  [prefs : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]) : unit
  (match value
    [(ir.CompilerIrValue.Var v)
      (if is-float
        (let
          [abi-idx : i64
            (if (cabi.compiler-abi-arg-banks-independent? target-abi)
              float-idx
              position)]
          [reg : i64
            (cabi.compiler-abi-float-arg-register-id target-abi abi-idx)]
          [idx : i64 (compiler-reg-id-seq-index-of pool reg 0)]
          [root : i64
            (if (if (>= v 0)
              (< v (array-length parents))
              false)
              (array-ref parents v)
              v)]
          (if (and
            (>= idx 0)
            (if (>= root 0)
              (< root (array-length prefs))
              false)
            (< (array-ref prefs root) 0))
            (begin
              (set! (array-ref prefs root) idx)
              unit)
            unit))
        unit)]
    [_ unit]))

(define (compiler-reg-float-arg-pref-array!
  [target-abi : cabi.CompilerRegTargetAbi]
  [pool : CompilerRegIdSeq]
  [values : (__tl_dyn-array ir.CompilerIrValue)]
  [types : CompilerRegVarTypes]
  [i : i64]
  [float-idx : i64]
  [position : i64]
  [prefs : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]) : unit
  (if (>= i (array-length values))
    unit
    (let
      [value : ir.CompilerIrValue (array-ref values i)]
      [is-float : bool (compiler-reg-call-arg-float? value types)]
      (begin
        (compiler-reg-float-arg-pref-value!
          target-abi
          pool
          value
          is-float
          float-idx
          position
          prefs
          parents)
        (compiler-reg-float-arg-pref-array!
          target-abi
          pool
          values
          types
          (+ i 1)
          (if is-float
            (+ float-idx 1)
            float-idx)
          (+ position 1)
          prefs
          parents)))))

(define (compiler-reg-float-arg-pref-args-at!
  [target-abi : cabi.CompilerRegTargetAbi]
  [pool : CompilerRegIdSeq]
  [args : ir.CompilerIrCallArgs]
  [types : CompilerRegVarTypes]
  [position : i64]
  [prefs : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]) : unit
  (match args
    [(ir.CompilerIrCallArgs.Nil) unit]
    [(ir.CompilerIrCallArgs.One a)
      (compiler-reg-float-arg-pref-value!
        target-abi
        pool
        a
        (compiler-reg-call-arg-float? a types)
        0
        position
        prefs
        parents)]
    [(ir.CompilerIrCallArgs.Two a b)
      (let
        [a-float : bool (compiler-reg-call-arg-float? a types)]
        (begin
          (compiler-reg-float-arg-pref-value!
            target-abi
            pool
            a
            a-float
            0
            position
            prefs
            parents)
          (compiler-reg-float-arg-pref-value!
            target-abi
            pool
            b
            (compiler-reg-call-arg-float? b types)
            (if a-float
              1
              0)
            (+ position 1)
            prefs
            parents)))]
    [(ir.CompilerIrCallArgs.Array values)
      (compiler-reg-float-arg-pref-array!
        target-abi
        pool
        values
        types
        0
        0
        position
        prefs
        parents)]))

(define (compiler-reg-float-arg-pref-instr!
  [target-abi : cabi.CompilerRegTargetAbi]
  [pool : CompilerRegIdSeq]
  [instr : ir.CompilerIrInstr]
  [types : CompilerRegVarTypes]
  [prefs : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]) : unit
  (match instr
    [(ir.CompilerIrInstr.Call _ _ args _)
      (compiler-reg-float-arg-pref-args-at!
        target-abi
        pool
        args
        types
        0
        prefs
        parents)]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (compiler-reg-float-arg-pref-args-at!
          target-abi
          pool
          args
          types
          0
          prefs
          parents))]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (compiler-reg-float-arg-pref-args-at!
          target-abi
          pool
          args
          types
          0
          prefs
          parents))]
    [(ir.CompilerIrInstr.TailCall _ args _)
      (compiler-reg-float-arg-pref-args-at!
        target-abi
        pool
        args
        types
        0
        prefs
        parents)]
    [(ir.CompilerIrInstr.TailCallIndirect _ args _)
      (compiler-reg-float-arg-pref-args-at!
        target-abi
        pool
        args
        types
        1
        prefs
        parents)]
    [(ir.CompilerIrInstr.CallIndirect _ _ args _)
      (compiler-reg-float-arg-pref-args-at!
        target-abi
        pool
        args
        types
        1
        prefs
        parents)]
    [(ir.CompilerIrInstr.CallIndirectC _ _ args _)
      (compiler-reg-float-arg-pref-args-at!
        target-abi
        pool
        args
        types
        0
        prefs
        parents)]
    [_ unit]))

(define (compiler-reg-float-arg-pref-seq!
  [target-abi : cabi.CompilerRegTargetAbi]
  [pool : CompilerRegIdSeq]
  [instrs : ir.CompilerIrInstrSeq]
  [types : CompilerRegVarTypes]
  [prefs : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [i : i64 0]
    (while (< i count)
      (begin
        (compiler-reg-float-arg-pref-instr!
          target-abi
          pool
          (array-ref slots i)
          types
          prefs
          parents)
        (set! i (+ i 1))))))

(define (compiler-reg-float-arg-pref-blocks!
  [target-abi : cabi.CompilerRegTargetAbi]
  [pool : CompilerRegIdSeq]
  [blocks : ir.CompilerIrBlockList]
  [types : CompilerRegVarTypes]
  [prefs : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-float-arg-pref-seq!
              target-abi
              pool
              instrs
              types
              prefs
              parents)])
        (compiler-reg-float-arg-pref-blocks!
          target-abi
          pool
          (__tl-box-place rest)
          types
          prefs
          parents))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-float-arg-pref-seq!
                  target-abi
                  pool
                  instrs
                  types
                  prefs
                  parents)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-function-float-arg-prefs
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [types : CompilerRegVarTypes]
  [coalesce : CompilerRegCoalesceMap]
  [n : i64]) : (__tl_dyn-array i64)
  (let
    [prefs : (__tl_dyn-array i64) (array.make-array i64 n)]
    [parents : (__tl_dyn-array i64) coalesce.parents]
    [pool : CompilerRegIdSeq (compiler-reg-xmm-registers-for-abi target-abi)]
    (begin
      (compiler-reg-fill-i64-array prefs -1)
      (match func
        [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
          (compiler-reg-float-arg-pref-blocks!
            target-abi
            pool
            blocks
            types
            prefs
            parents)])
      prefs)))

;; Enforce the contract required by the ordered backend float marshaller: every
;; register-homed float call arg must already be in its ABI destination. A greedy
;; fallback register, XMM0/XMM1 target, stack target, or conflicting preference
;; therefore becomes unassigned and is materialised from its normal stack home.
;; Same as the pref variant: the caller has already classified this argument.
(define (compiler-reg-float-arg-demote-value!
  [target-abi : cabi.CompilerRegTargetAbi]
  [value : ir.CompilerIrValue]
  [is-float : bool]
  [float-idx : i64]
  [position : i64]
  [parents : (__tl_dyn-array i64)]
  [assignments : CompilerRegAssignmentTable]) : unit
  (match value
    [(ir.CompilerIrValue.Var v)
      (if is-float
        (let
          [abi-idx : i64
            (if (cabi.compiler-abi-arg-banks-independent? target-abi)
              float-idx
              position)]
          [target : i64
            (cabi.compiler-abi-float-arg-register-id target-abi abi-idx)]
          [root : i64
            (if (if (>= v 0)
              (< v (array-length parents))
              false)
              (array-ref parents v)
              v)]
          (if (compiler-reg-location-register?
            (compiler-reg-assignment-table-lookup assignments root)
            target)
            unit
            (begin
              (compiler-reg-assignment-table-unassign assignments root)
              unit)))
        unit)]
    [_ unit]))

(define (compiler-reg-float-arg-demote-array!
  [target-abi : cabi.CompilerRegTargetAbi]
  [values : (__tl_dyn-array ir.CompilerIrValue)]
  [types : CompilerRegVarTypes]
  [i : i64]
  [float-idx : i64]
  [position : i64]
  [parents : (__tl_dyn-array i64)]
  [assignments : CompilerRegAssignmentTable]) : unit
  (if (>= i (array-length values))
    unit
    (let
      [value : ir.CompilerIrValue (array-ref values i)]
      [is-float : bool (compiler-reg-call-arg-float? value types)]
      (begin
        (compiler-reg-float-arg-demote-value!
          target-abi
          value
          is-float
          float-idx
          position
          parents
          assignments)
        (compiler-reg-float-arg-demote-array!
          target-abi
          values
          types
          (+ i 1)
          (if is-float
            (+ float-idx 1)
            float-idx)
          (+ position 1)
          parents
          assignments)))))

(define (compiler-reg-float-arg-demote-args!
  [target-abi : cabi.CompilerRegTargetAbi]
  [args : ir.CompilerIrCallArgs]
  [types : CompilerRegVarTypes]
  [position : i64]
  [parents : (__tl_dyn-array i64)]
  [assignments : CompilerRegAssignmentTable]) : unit
  (match args
    [(ir.CompilerIrCallArgs.Nil) unit]
    [(ir.CompilerIrCallArgs.One a)
      (compiler-reg-float-arg-demote-value!
        target-abi
        a
        (compiler-reg-call-arg-float? a types)
        0
        position
        parents
        assignments)]
    [(ir.CompilerIrCallArgs.Two a b)
      (let
        [a-float : bool (compiler-reg-call-arg-float? a types)]
        (begin
          (compiler-reg-float-arg-demote-value!
            target-abi
            a
            a-float
            0
            position
            parents
            assignments)
          (compiler-reg-float-arg-demote-value!
            target-abi
            b
            (compiler-reg-call-arg-float? b types)
            (if a-float
              1
              0)
            (+ position 1)
            parents
            assignments)))]
    [(ir.CompilerIrCallArgs.Array values)
      (compiler-reg-float-arg-demote-array!
        target-abi
        values
        types
        0
        0
        position
        parents
        assignments)]))

(define (compiler-reg-float-arg-demote-instr!
  [target-abi : cabi.CompilerRegTargetAbi]
  [instr : ir.CompilerIrInstr]
  [types : CompilerRegVarTypes]
  [parents : (__tl_dyn-array i64)]
  [assignments : CompilerRegAssignmentTable]) : unit
  (match instr
    [(ir.CompilerIrInstr.Call _ _ args _)
      (compiler-reg-float-arg-demote-args!
        target-abi
        args
        types
        0
        parents
        assignments)]
    [(ir.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (compiler-reg-float-arg-demote-args!
          target-abi
          args
          types
          0
          parents
          assignments))]
    [(ir.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (compiler-reg-float-arg-demote-args!
          target-abi
          args
          types
          0
          parents
          assignments))]
    [(ir.CompilerIrInstr.TailCall _ args _)
      (compiler-reg-float-arg-demote-args!
        target-abi
        args
        types
        0
        parents
        assignments)]
    [(ir.CompilerIrInstr.TailCallIndirect _ args _)
      (compiler-reg-float-arg-demote-args!
        target-abi
        args
        types
        1
        parents
        assignments)]
    [(ir.CompilerIrInstr.CallIndirect _ _ args _)
      (compiler-reg-float-arg-demote-args!
        target-abi
        args
        types
        1
        parents
        assignments)]
    [(ir.CompilerIrInstr.CallIndirectC _ _ args _)
      (compiler-reg-float-arg-demote-args!
        target-abi
        args
        types
        0
        parents
        assignments)]
    [_ unit]))

(define (compiler-reg-float-arg-demote-seq!
  [target-abi : cabi.CompilerRegTargetAbi]
  [instrs : ir.CompilerIrInstrSeq]
  [types : CompilerRegVarTypes]
  [parents : (__tl_dyn-array i64)]
  [assignments : CompilerRegAssignmentTable]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [i : i64 0]
    (while (< i count)
      (begin
        (compiler-reg-float-arg-demote-instr!
          target-abi
          (array-ref slots i)
          types
          parents
          assignments)
        (set! i (+ i 1))))))

(define (compiler-reg-float-arg-demote-blocks!
  [target-abi : cabi.CompilerRegTargetAbi]
  [blocks : ir.CompilerIrBlockList]
  [types : CompilerRegVarTypes]
  [parents : (__tl_dyn-array i64)]
  [assignments : CompilerRegAssignmentTable]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-float-arg-demote-seq!
              target-abi
              instrs
              types
              parents
              assignments)])
        (compiler-reg-float-arg-demote-blocks!
          target-abi
          (__tl-box-place rest)
          types
          parents
          assignments))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-float-arg-demote-seq!
                  target-abi
                  instrs
                  types
                  parents
                  assignments)])
            (set! i (+ i 1)))))]))

(define (compiler-reg-float-call-args-demote!
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [types : CompilerRegVarTypes]
  [coalesce : CompilerRegCoalesceMap]
  [assignments : CompilerRegAssignmentTable]) : unit
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
      (compiler-reg-float-arg-demote-blocks!
        target-abi
        blocks
        types
        coalesce.parents
        assignments)]))

(define (compiler-reg-greedy-state-with-scratch-exclusions
  [candidates : CompilerRegIntervalSeq]
  [regs : CompilerRegIdSeq]
  [assignments : CompilerRegAssignmentTable]
  [interval-index : CompilerRegIntervalIndex]
  [group-vars : live.CompilerLiveI64Set]
  [param-roots : live.CompilerLiveI64Set]
  [ref-counts : (__tl_dyn-array i64)]
  [copy-hints : (__tl_dyn-array i64)]
  [arg-prefs : (__tl_dyn-array i64)]
  [call-points : live.CompilerLiveI64Set]
  [div-points : live.CompilerLiveI64Set]
  [shift-points : live.CompilerLiveI64Set]
  [callee-regs : CompilerRegIdSeq]
  [caller-saved-count : i64]
  [unspillable-from : i64]
  [scratch-excluded : (__tl_dyn-array CompilerRegIdSeq)]) : CompilerRegAssignState
  (let
    [n : i64 (array-length assignments.present)]
    [rcount : i64 (compiler-reg-id-seq-count regs)]
    [reg-arr : (__tl_dyn-array i64)
      (array.make-array
        i64
        (if (< (compiler-reg-id-seq-count regs) 1)
          1
          (compiler-reg-id-seq-count regs)))]
    [order : (__tl_dyn-array i64)
      (array.make-array
        i64
        (if (< (array-length assignments.present) 1)
          1
          (array-length assignments.present)))]
    ;; RS_* stage per root (RS_New until selectOrSplit runs); the post-pass region
    ;; split rescues the RS_Split entries.
    [stages : (__tl_dyn-array i64)
      (array.make-array
        i64
        (if (< (array-length assignments.present) 1)
          1
          (array-length assignments.present)))]
    (begin
      (compiler-reg-greedy-id-seq-to-array regs reg-arr 0)
      (let
        [count : i64 (compiler-reg-greedy-collect-vars candidates order 0)]
        (begin
          (compiler-reg-greedy-sort! order ref-counts count)
          (compiler-reg-greedy-alloc-all!
            order
            0
            count
            assignments
            interval-index
            ref-counts
            copy-hints
            arg-prefs
            group-vars
            param-roots
            regs
            reg-arr
            rcount
            stages
            n
            call-points
            div-points
            shift-points
            callee-regs
            caller-saved-count
            unspillable-from
            scratch-excluded)
          (CompilerRegAssignState.State
            (compiler-reg-active-seq-empty)
            assignments))))))

(define (compiler-reg-greedy-state
  [candidates : CompilerRegIntervalSeq]
  [regs : CompilerRegIdSeq]
  [assignments : CompilerRegAssignmentTable]
  [interval-index : CompilerRegIntervalIndex]
  [group-vars : live.CompilerLiveI64Set]
  [param-roots : live.CompilerLiveI64Set]
  [ref-counts : (__tl_dyn-array i64)]
  [copy-hints : (__tl_dyn-array i64)]
  [arg-prefs : (__tl_dyn-array i64)]
  [call-points : live.CompilerLiveI64Set]
  [div-points : live.CompilerLiveI64Set]
  [shift-points : live.CompilerLiveI64Set]
  [callee-regs : CompilerRegIdSeq]
  [caller-saved-count : i64]
  [unspillable-from : i64]) : CompilerRegAssignState
  (compiler-reg-greedy-state-with-scratch-exclusions
    candidates
    regs
    assignments
    interval-index
    group-vars
    param-roots
    ref-counts
    copy-hints
    arg-prefs
    call-points
    div-points
    shift-points
    callee-regs
    caller-saved-count
    unspillable-from
    (array.make-array CompilerRegIdSeq 0)))

;; ============================================================================
;; GAP2b: register-PAIR homing for 16-byte group values. The greedy
;; structurally excludes group vars (2-word aggregates) from scalar candidates,
;; so CompilerRegRegisterPair -- a fully-plumbed location the backend already
;; supports (emit-pack / group-word-operand / scavenge occupancy masks / CSR
;; save detection / storage-coloring rebuild) -- is assigned here, after the
;; scalar homes are final.
;;
;; Candidate soundness gates:
;;  * A clobber-free component first tries the stable caller-saved pair
;;    {r8,r9}. It avoids growing the prologue save set and has no div/shift
;;    fixed-use role. Group values marshalled by a normal call only see the CSR
;;    pool until that multiword ABI path participates in the pair parallel-move
;;    solver. A component that crosses a kind-0 clobber also only sees
;;    {r12,r13,r14,r15,rbx}; %rbp stays out because the FPO/scavenger plan owns
;;    its admission.
;;  * Per-call-region scalar shadows also use the caller-saved pool. A pair
;;    candidate rejects an overlapping shadow region, so the later rewrite can
;;    never mint a scalar home into either pair half.
;;  * Phi endpoints are admitted: compiler_parallel_move represents both pair
;;    halves as resources, so a scalar phi copy that writes either half blocks
;;    until the pair source has been read. The old whole-location exclusion was
;;    made obsolete by that solver.
;;  * group Movs are handled by CO-ASSIGNMENT: Mov-connected components under
;;    the same-value proof (BOTH endpoints single-def, so the component
;;    carries exactly one value and may share one home even under hull
;;    overlap -- the relation scalars got in #2/M-C but groups never did) get
;;    ONE shared pair for every member, so the component's Movs elide as
;;    same-home copies -- strictly better than the storage-coloring slot
;;    aliasing they replace. A group Mov without that proof may retain an
;;    ordinary two-word copy between independently chosen homes; the backend
;;    stages both source words before writing either destination, so this is
;;    safe and admits phi-adjacent group values.
;;  * NOT tail-call args (restore-order analysis kept out of v1), NOT params
;;    (entry marshalling), NOT address-taken/memory-targeted vars.
;;  * Call results, returns, Pack/Word and switch dispatch all read through
;;    compiler-backend-group-word-operand-with-backend-state, which is pair-aware. Group arguments
;;    to ordinary direct and indirect calls may use a CSR pair, but not r8:r9,
;;    until their multiword ABI marshalling participates in the pair
;;    parallel-move solver. A CSR pair is preserved across calls by the callee,
;;    so call-spanning group values are admitted.
;; Interference: per-var segment-precise (the same
;; compiler-reg-vars-interfere-segmented-index? the greedy trusts) against
;; every var holding the probed register (scalar home or either pair half),
;; including pairs this pass already placed.
(define (compiler-reg-group-pair-add-value-var
  [set : live.CompilerLiveI64Set]
  [value : ir.CompilerIrValue]) : live.CompilerLiveI64Set
  (match value
    [(ir.CompilerIrValue.Var id) (live.compiler-live-set-insert set id)]
    [_ set]))

(define (compiler-reg-group-pair-add-call-args
  [set : live.CompilerLiveI64Set]
  [args : ir.CompilerIrCallArgs]) : live.CompilerLiveI64Set
  (match args
    [(ir.CompilerIrCallArgs.Nil) set]
    [(ir.CompilerIrCallArgs.One a)
      (compiler-reg-group-pair-add-value-var set a)]
    [(ir.CompilerIrCallArgs.Two a b)
      (compiler-reg-group-pair-add-value-var
        (compiler-reg-group-pair-add-value-var set a)
        b)]
    [(ir.CompilerIrCallArgs.Array arr)
      (let
        [n : i64 (array-length arr)]
        [i : i64 0]
        [acc : live.CompilerLiveI64Set set]
        (begin
          (while (< i n)
            (begin
              (set!
                acc
                (compiler-reg-group-pair-add-value-var acc (array-ref arr i)))
              (set! i (+ i 1))))
          acc))]))

;; The ordinary call marshaller emits its group-word moves independently. A
;; source already in r8:r9 can therefore overlap an earlier argument
;; destination. Keep the affected component eligible for a CSR pair, but bar
;; it from the caller-saved pair until call marshalling uses the pair
;; parallel-move solver.
(define (compiler-reg-group-pair-caller-unsafe-instr
  [set : live.CompilerLiveI64Set]
  [instr : ir.CompilerIrInstr]) : live.CompilerLiveI64Set
  (match instr
    [(ir.CompilerIrInstr.Call _ _ args _)
      (compiler-reg-group-pair-add-call-args set args)]
    [(ir.CompilerIrInstr.CallIndirect _ _ args _)
      (compiler-reg-group-pair-add-call-args set args)]
    [(ir.CompilerIrInstr.CallIndirectC _ _ args _)
      (compiler-reg-group-pair-add-call-args set args)]
    [_ set]))

;; Read-only fold over the instruction stream: scan the sequence in place
;; instead of materialising it as a cons list first. refs #5726
(define (compiler-reg-group-pair-caller-unsafe-instr-seq
  [set : live.CompilerLiveI64Set]
  [instrs : ir.CompilerIrInstrSeq]) : live.CompilerLiveI64Set
  (let
    [index : i64 0]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [out : live.CompilerLiveI64Set set]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (compiler-reg-group-pair-caller-unsafe-instr
              out
              (ir.compiler-ir-instr-seq-ref instrs index)))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-group-pair-caller-unsafe-blocks
  [set : live.CompilerLiveI64Set]
  [blocks : ir.CompilerIrBlockList]) : live.CompilerLiveI64Set
  (match blocks
    [(ir.CompilerIrBlockList.Nil) set]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-group-pair-caller-unsafe-blocks
            (compiler-reg-group-pair-caller-unsafe-instr-seq set instrs)
            (__tl-box-place rest))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out : live.CompilerLiveI64Set set]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set!
                    out
                    (compiler-reg-group-pair-caller-unsafe-instr-seq out instrs))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-reg-group-pair-excluded-instr
  [set : live.CompilerLiveI64Set]
  [instr : ir.CompilerIrInstr]
  [group-vars : live.CompilerLiveI64Set]) : live.CompilerLiveI64Set
  (match instr
    [(ir.CompilerIrInstr.Mov dst src _)
      (match src
        [(ir.CompilerIrValue.Var _) set]
        [_
          ;; a group Mov from a NON-var source (constant materialisation)
          ;; writes the dst through the group return regs; keep the dst out
          ;; rather than reason about that path in v1.
          (if (live.compiler-live-set-contains? group-vars dst)
            (live.compiler-live-set-insert set dst)
            set)])]
    [(ir.CompilerIrInstr.TailCall _ args _)
      (compiler-reg-group-pair-add-call-args set args)]
    [(ir.CompilerIrInstr.TailCallIndirect target args _)
      (compiler-reg-group-pair-add-value-var
        (compiler-reg-group-pair-add-call-args set args)
        target)]
    [_ set]))

(define (compiler-reg-group-pair-excluded-instr-seq
  [set : live.CompilerLiveI64Set]
  [instrs : ir.CompilerIrInstrSeq]
  [group-vars : live.CompilerLiveI64Set]) : live.CompilerLiveI64Set
  (let
    [i : i64 0]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [out : live.CompilerLiveI64Set set]
    (begin
      (while (< i count)
        (begin
          (set!
            out
            (compiler-reg-group-pair-excluded-instr
              out
              (ir.compiler-ir-instr-seq-ref instrs i)
              group-vars))
          (set! i (+ i 1))))
      out)))

(define (compiler-reg-group-pair-excluded-blocks
  [set : live.CompilerLiveI64Set]
  [blocks : ir.CompilerIrBlockList]
  [group-vars : live.CompilerLiveI64Set]) : live.CompilerLiveI64Set
  (match blocks
    [(ir.CompilerIrBlockList.Nil) set]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-group-pair-excluded-blocks
            (compiler-reg-group-pair-excluded-instr-seq set instrs group-vars)
            (__tl-box-place rest)
            group-vars)])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        [out : live.CompilerLiveI64Set set]
        (begin
          (while (< i count)
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set!
                    out
                    (compiler-reg-group-pair-excluded-instr-seq
                      out
                      instrs
                      group-vars))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-reg-group-pair-csr [idx : i64]) : i64
  (cond
    [(= idx 0) cabi.compiler-reg-id-r12]
    [(= idx 1) cabi.compiler-reg-id-r13]
    [(= idx 2) cabi.compiler-reg-id-r14]
    [(= idx 3) cabi.compiler-reg-id-r15]
    [else cabi.compiler-reg-id-rbx]))

;; The late pair pass reserves only the non-argument caller-saved pair. rax,
;; rcx and rdx have fixed ABI or div/shift roles; r10/r11 are scavenger scratch;
;; rsi/rdi stay with ordinary argument marshalling.
(define (compiler-reg-group-pair-caller-saved [idx : i64]) : i64
  (if (= idx 0)
    cabi.compiler-reg-id-r8
    cabi.compiler-reg-id-r9))

(define (compiler-reg-group-pair-candidate-count [caller-saved-ok? : bool]) : i64
  (if caller-saved-ok?
    7
    5))

(define (compiler-reg-group-pair-candidate
  [caller-saved-ok? : bool]
  [idx : i64]) : i64
  (if caller-saved-ok?
    (if (< idx 2)
      (compiler-reg-group-pair-caller-saved idx)
      (compiler-reg-group-pair-csr (- idx 2)))
    (compiler-reg-group-pair-csr idx)))

;; A caller-saved pair must not overlap a scalar shadow that the per-call-region
;; rescue will materialise after this plan is built. The shadow table records
;; one register per root and point ranges for each realised region; conservative
;; hull overlap is enough here (a false conflict only retains a stack home).
(define (compiler-reg-group-pair-component-live-over-range?
  [interval-index : CompilerRegIntervalIndex]
  [members : (__tl_dyn-array i64)]
  [count : i64]
  [lo : i64]
  [hi : i64]) : bool
  (let
    [starts : (__tl_dyn-array i64) interval-index.starts]
    [ends : (__tl_dyn-array i64) interval-index.ends]
    [i : i64 0]
    [hit : bool false]
    (begin
      (while (and (< i count) (not hit))
        (begin
          (if (compiler-reg-var-live-over-range?
            starts
            ends
            (array-ref members i)
            lo
            hi)
            (set! hit true)
            unit)
          (set! i (+ i 1))))
      hit)))

(define (compiler-reg-group-pair-shadow-reg-conflicts?
  [interval-index : CompilerRegIntervalIndex]
  [members : (__tl_dyn-array i64)]
  [count : i64]
  [split : CompilerRegCallSplit]
  [reg : i64]) : bool
  (match split
    [(CompilerRegCallSplit _ shadow-regs regions _)
      (compiler-reg-group-pair-shadow-reg-conflicts-regions?
        interval-index
        members
        count
        shadow-regs
        regions
        reg)]))

(define (compiler-reg-group-pair-shadow-reg-conflicts-regions?
  [interval-index : CompilerRegIntervalIndex]
  [members : (__tl_dyn-array i64)]
  [count : i64]
  [shadow-regs : (__tl_dyn-array i64)]
  [regions : CompilerRegCallRegionSeq]
  [reg : i64]) : bool
  (let
    [slots : (__tl_dyn-array CompilerRegCallRegion) regions.slots]
    [index : i64 (- regions.len 1)]
    [conflict : bool false]
    (begin
      (while (and (>= index 0) (not conflict))
        (begin
          (match (array-ref slots index)
            [(CompilerRegCallRegion root lo hi _ _)
              (if (and
                (>= root 0)
                (< root (array-length shadow-regs))
                (= (array-ref shadow-regs root) reg)
                (compiler-reg-group-pair-component-live-over-range?
                  interval-index
                  members
                  count
                  lo
                  hi))
                (set! conflict true)
                unit)])
          (set! index (- index 1))))
      conflict)))

(define (compiler-reg-group-pair-weight
  [weights : (__tl_dyn-array i64)]
  [v : i64]) : i64
  (if (and (>= v 0) (< v (array-length weights)))
    (array-ref weights v)
    0))

(define (compiler-reg-group-pair-component-clobber-free?
  [interval-index : CompilerRegIntervalIndex]
  [call-points : live.CompilerLiveI64Set]
  [members : (__tl_dyn-array i64)]
  [count : i64]) : bool
  (let
    [i : i64 0]
    [ok : bool true]
    (begin
      (while (and (< i count) ok)
        (begin
          (if (compiler-reg-greedy-var-spans-clobber?
            interval-index
            call-points
            (array-ref members i))
            (set! ok false)
            unit)
          (set! i (+ i 1))))
      ok)))

(define (compiler-reg-group-pair-component-contains?
  [set : live.CompilerLiveI64Set]
  [members : (__tl_dyn-array i64)]
  [count : i64]) : bool
  (let
    [i : i64 0]
    [hit : bool false]
    (begin
      (while (and (< i count) (not hit))
        (begin
          (if (live.compiler-live-set-contains? set (array-ref members i))
            (set! hit true)
            unit)
          (set! i (+ i 1))))
      hit)))

;; A pair component may evict only scalar register occupants that are strictly
;; colder than the component's hottest member. An overlapping pair occupying
;; this register, or an equal/hotter scalar, makes it unavailable; spill/remat
;; homes and pairs in other registers do not occupy it. The returned positive
;; cost ranks alternatives by the total displaced spill weight; -1 means
;; unavailable. A zero cost is an already-free register.
(define (compiler-reg-group-pair-reg-evict-cost
  [assignments : CompilerRegAssignmentTable]
  [conflicts : (__tl_dyn-array i64)]
  [conflict-count : i64]
  [weights : (__tl_dyn-array i64)]
  [component-weight : i64]
  [reg : i64]) : i64
  (let
    [i : i64 0]
    [cost : i64 0]
    [blocked : bool false]
    (begin
      (while (and (< i conflict-count) (not blocked))
        (let
          [idx : i64 (array-ref conflicts i)]
          (begin
            (match (compiler-reg-assignment-table-lookup assignments idx)
              [(CompilerRegMaybeLocation.Some location)
                (match location
                  [(CompilerRegLocation.Register held)
                    (if (= held reg)
                      (let
                        [weight : i64
                          (compiler-reg-group-pair-weight weights idx)]
                        (if (< weight component-weight)
                          (set! cost (+ cost (+ weight 1)))
                          (set! blocked true)))
                      unit)]
                  [(CompilerRegLocation.RegisterPair first second)
                    (if (or (= first reg) (= second reg))
                      (set! blocked true)
                      unit)]
                  [(CompilerRegLocation.Spill _) unit]
                  [(CompilerRegLocation.Remat _) unit])]
              [(CompilerRegMaybeLocation.No) unit])
            (set! i (+ i 1)))))
      (if blocked
        (- 0 1)
        cost))))

(define (compiler-reg-group-pair-component-conflicts-var?
  [interval-index : CompilerRegIntervalIndex]
  [members : (__tl_dyn-array i64)]
  [count : i64]
  [var : i64]) : bool
  (let
    [i : i64 0]
    [hit : bool false]
    (begin
      (while (and (< i count) (not hit))
        (begin
          (if (compiler-reg-vars-interfere-segmented-index?
            interval-index
            (array-ref members i)
            var)
            (set! hit true)
            unit)
          (set! i (+ i 1))))
      hit)))

;; The ascending list of vars that interfere with ANY component member. Both
;; the per-register evict COST and the accepted pair's eviction walk used to
;; recompute this predicate per register, over every var, even though it reads
;; only `interval-index` and the (fixed) member list -- neither of which the
;; register search touches. Collecting it once per component leaves each of
;; those walks visiting exactly the same vars in the same ascending order, so
;; every cost and every eviction is unchanged; only the 19x repetition of the
;; interference scan is gone.
(define (compiler-reg-group-pair-conflict-vars!
  [interval-index : CompilerRegIntervalIndex]
  [members : (__tl_dyn-array i64)]
  [count : i64]
  [vars : i64]
  [out : (__tl_dyn-array i64)]) : i64
  (let
    [idx : i64 0]
    [at : i64 0]
    (begin
      (while (< idx vars)
        (begin
          (if (compiler-reg-group-pair-component-conflicts-var?
            interval-index
            members
            count
            idx)
            (begin
              (set! (array-ref out at) idx)
              (set! at (+ at 1)))
            unit)
          (set! idx (+ idx 1))))
      at)))

(define (compiler-reg-group-pair-component-register-cost
  [assignments : CompilerRegAssignmentTable]
  [interval-index : CompilerRegIntervalIndex]
  [members : (__tl_dyn-array i64)]
  [count : i64]
  [conflicts : (__tl_dyn-array i64)]
  [conflict-count : i64]
  [weights : (__tl_dyn-array i64)]
  [component-weight : i64]
  [caller-saved? : bool]
  [split : CompilerRegCallSplit]
  [reg : i64]) : i64
  ;; A caller-saved pair candidate is checked against the shadow table because
  ;; the rescue's base pool IS caller-saved. A callee-saved candidate normally
  ;; is not: its register is already homed by a plan value, so no shadow can be
  ;; sitting in it. Loop-scope EVICTION breaks exactly that premise -- it lends
  ;; a callee-saved register whose parked occupant the pair pass is free to
  ;; demote as "colder", after which the pair and the shadow would both own the
  ;; register over the region. So when this function evicted anything, every
  ;; candidate consults the shadow table. Eviction-free functions keep the
  ;; caller-saved-only test bit for bit.
  (if (and
    (or
      caller-saved?
      (> (__tl-project-field (compiler-reg-call-split-evictions split) len) 0))
    (compiler-reg-group-pair-shadow-reg-conflicts?
      interval-index
      members
      count
      split
      reg))
    (- 0 1)
    (compiler-reg-group-pair-reg-evict-cost
      assignments
      conflicts
      conflict-count
      weights
      component-weight
      reg)))

(define (compiler-reg-group-pair-evict-reg-conflicts!
  [assignments : CompilerRegAssignmentTable]
  [conflicts : (__tl_dyn-array i64)]
  [conflict-count : i64]
  [reg : i64]) : unit
  (let
    [i : i64 0]
    (while (< i conflict-count)
      (let
        [idx : i64 (array-ref conflicts i)]
        (begin
          (match (compiler-reg-assignment-table-lookup assignments idx)
            [(CompilerRegMaybeLocation.Some location)
              (match location
                [(CompilerRegLocation.Register held)
                  (if (= held reg)
                    (let
                      [_spill : CompilerRegAssignmentTable
                        (compiler-reg-assignment-table-insert
                          assignments
                          idx
                          (CompilerRegLocation.Spill
                            (compiler-reg-stack-slot-offset idx)))]
                      unit)
                    unit)]
                [_ unit])]
            [(CompilerRegMaybeLocation.No) unit])
          (set! i (+ i 1)))))))

;; Union-find root with full-path compression (iterative).
(define (compiler-reg-group-pair-find
  [parents : (__tl_dyn-array i64)]
  [v : i64]) : i64
  (let
    [root : i64 v]
    (begin
      (while (not (= (array-ref parents root) root))
        (set! root (array-ref parents root)))
      (let
        [cur : i64 v]
        (while (not (= (array-ref parents cur) root))
          (let
            [next : i64 (array-ref parents cur)]
            (begin
              (set! (array-ref parents cur) root)
              (set! cur next)))))
      root)))

;; Group-Mov value-carry edges: union dst/src when BOTH endpoints are sound
;; candidates and BOTH are SINGLE-DEF (the same-value coalescing rationale,
;; which groups never received): dst's only def is this Mov and src is never
;; redefined, so the whole component carries ONE value -- sharing one home is
;; correct even when the hulls OVERLAP (copy-prop routinely keeps the call
;; result live past the Mov, so the M-B slot-alias adjacency proof is too
;; brittle here). If that proof fails but BOTH endpoints are group values, they
;; stay independently eligible: emit-mov stages both source words before either
;; destination write, and phi edges use the pair-aware parallel-move solver.
;; This can retain a necessary group copy, but it is safe and lets phi-carried
;; groups receive pairs. A one-sided group mismatch remains poisoned because it
;; indicates incomplete group-identity propagation rather than a normal copy.
;; Read-only scan (its writes go to the union-find/poison side arrays, never to
;; the IR): walk the contiguous sequence instead of materialising a cons list.
;; refs #5726
(define (compiler-reg-group-pair-mov-edges-instr
  [instr : ir.CompilerIrInstr]
  [group-vars : live.CompilerLiveI64Set]
  [excluded : live.CompilerLiveI64Set]
  [starts : (__tl_dyn-array i64)]
  [def-counts : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]
  [poisoned : (__tl_dyn-array bool)]) : unit
  (match instr
    [(ir.CompilerIrInstr.Mov dst src _)
      (match src
        [(ir.CompilerIrValue.Var src-var)
          (if (and
            (live.compiler-live-set-contains? group-vars dst)
            (live.compiler-live-set-contains? group-vars src-var))
            (if (and
              (not (= dst src-var))
              (>= dst 0)
              (< dst (array-length parents))
              (>= src-var 0)
              (< src-var (array-length parents))
              (not (live.compiler-live-set-contains? excluded dst))
              (not (live.compiler-live-set-contains? excluded src-var))
              (>= (array-ref starts dst) 0)
              (>= (array-ref starts src-var) 0)
              (compiler-reg-sv-single-def? def-counts dst)
              (compiler-reg-sv-single-def? def-counts src-var))
              (let
                [rd : i64 (compiler-reg-group-pair-find parents dst)]
                [rs : i64 (compiler-reg-group-pair-find parents src-var)]
                (set! (array-ref parents rd) rs))
              unit)
            (if (or
              (live.compiler-live-set-contains? group-vars dst)
              (live.compiler-live-set-contains? group-vars src-var))
              (begin
                (if (and (>= dst 0) (< dst (array-length poisoned)))
                  (set! (array-ref poisoned dst) true)
                  unit)
                (if (and (>= src-var 0) (< src-var (array-length poisoned)))
                  (set! (array-ref poisoned src-var) true)
                  unit))
              unit))]
        [_ unit])]
    [_ unit]))

(define (compiler-reg-group-pair-mov-edges-instr-seq
  [instrs : ir.CompilerIrInstrSeq]
  [group-vars : live.CompilerLiveI64Set]
  [excluded : live.CompilerLiveI64Set]
  [starts : (__tl_dyn-array i64)]
  [def-counts : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]
  [poisoned : (__tl_dyn-array bool)]) : unit
  (let
    [index : i64 0]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    (while (< index count)
      (begin
        (compiler-reg-group-pair-mov-edges-instr
          (ir.compiler-ir-instr-seq-ref instrs index)
          group-vars
          excluded
          starts
          def-counts
          parents
          poisoned)
        (set! index (+ index 1))))))

(define (compiler-reg-group-pair-mov-edges-blocks
  [blocks : ir.CompilerIrBlockList]
  [group-vars : live.CompilerLiveI64Set]
  [excluded : live.CompilerLiveI64Set]
  [starts : (__tl_dyn-array i64)]
  [def-counts : (__tl_dyn-array i64)]
  [parents : (__tl_dyn-array i64)]
  [poisoned : (__tl_dyn-array bool)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (begin
            (compiler-reg-group-pair-mov-edges-instr-seq
              instrs
              group-vars
              excluded
              starts
              def-counts
              parents
              poisoned)
            (compiler-reg-group-pair-mov-edges-blocks
              (__tl-box-place rest)
              group-vars
              excluded
              starts
              def-counts
              parents
              poisoned))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (ir.compiler-ir-block-seq-count seq)]
        (while (< i count)
          (begin
            (match (ir.compiler-ir-block-seq-ref seq i)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-group-pair-mov-edges-instr-seq
                  instrs
                  group-vars
                  excluded
                  starts
                  def-counts
                  parents
                  poisoned)])
            (set! i (+ i 1)))))]))

;; TRUE when var v is a sound pair-component member on its own account.
;; SSE-word groups (e.g. an i64+f64 enum) are excluded: the pair pool contains
;; GP registers only, and a float word homed in a GP register would emit an
;; invalid xmm<->gp movsd (the class mask registry is the same data the
;; backend's group-word-sse? reads).
(define (compiler-reg-group-pair-member-ok?
  [type-segment-bases : i64]
  [v : i64]
  [type-info : CompilerRegVarTypes]
  [group-vars : live.CompilerLiveI64Set]
  [excluded : live.CompilerLiveI64Set]
  [starts : (__tl_dyn-array i64)]
  [poisoned : (__tl_dyn-array bool)]
  [assignments : CompilerRegAssignmentTable]) : bool
  (and
    (live.compiler-live-set-contains? group-vars v)
    (not (live.compiler-live-set-contains? excluded v))
    (not (array-ref poisoned v))
    (not
      (compiler-reg-var-register-group-has-sse? type-segment-bases type-info v))
    (>= (array-ref starts v) 0)
    (match (compiler-reg-assignment-table-lookup assignments v)
      [(CompilerRegMaybeLocation.Some _) false]
      [(CompilerRegMaybeLocation.No) true])))

(define (compiler-reg-assign-group-pairs
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [type-info : CompilerRegVarTypes]
  [group-vars : live.CompilerLiveI64Set]
  [interval-index : CompilerRegIntervalIndex]
  [assignments : CompilerRegAssignmentTable]
  [weights : (__tl_dyn-array i64)]
  [call-points : live.CompilerLiveI64Set]
  [split : CompilerRegCallSplit]) : CompilerRegAssignmentTable
  ;; A function with NO group values can never place a pair: every component
  ;; below is gated on `compiler-reg-group-pair-member-ok?`, whose first
  ;; conjunct is `group-vars` membership, so no component is entered and the
  ;; incoming table is returned untouched. Everything the body computes first
  ;; (the excluded / caller-unsafe point sets, the def counts, the Mov-edge
  ;; union-find and the two per-var walks) writes only to locals, so returning
  ;; `assignments` here yields the identical table by construction. Group-free
  ;; functions are 91.4% of the calls in an opt2 self-compile.
  (if (= (live.compiler-live-set-word-count group-vars) 0)
    assignments
    (match func
      [(ir.CompilerIrFunction.Function _ params _ _ blocks)
        (let
          [starts : (__tl_dyn-array i64) interval-index.starts]
          [ends : (__tl_dyn-array i64) interval-index.ends]
          [vars : i64 (array-length starts)]
          [excluded : live.CompilerLiveI64Set
            (compiler-reg-group-pair-excluded-blocks
              (compiler-reg-ineligible-memory
                blocks
                (compiler-reg-ineligible-params
                  params
                  (live.compiler-live-set-empty)))
              blocks
              group-vars)]
          [caller-unsafe : live.CompilerLiveI64Set
            (compiler-reg-group-pair-caller-unsafe-blocks
              (live.compiler-live-set-empty)
              blocks)]
          [def-counts : (__tl_dyn-array i64)
            (compiler-reg-function-def-counts func)]
          [parents : (__tl_dyn-array i64) (array.make-array i64 vars)]
          [poisoned : (__tl_dyn-array bool) (array.make-array bool vars)]
          [members : (__tl_dyn-array i64) (array.make-array i64 vars)]
          [v : i64 0]
          (begin
            (while (< v vars)
              (begin
                (set! (array-ref parents v) v)
                (set! (array-ref poisoned v) false)
                (set! v (+ v 1))))
            (compiler-reg-group-pair-mov-edges-blocks
              blocks
              group-vars
              excluded
              starts
              def-counts
              parents
              poisoned)
            (set! v 0)
            (while (< v vars)
              (begin
                (if (and
                  (= (compiler-reg-group-pair-find parents v) v)
                  (compiler-reg-group-pair-member-ok?
                    type-segment-bases
                    v
                    type-info
                    group-vars
                    excluded
                    starts
                    poisoned
                    assignments))
                  (compiler-reg-assign-group-pair-component
                    type-segment-bases
                    v
                    vars
                    type-info
                    group-vars
                    excluded
                    caller-unsafe
                    starts
                    ends
                    poisoned
                    parents
                    members
                    interval-index
                    assignments
                    weights
                    call-points
                    split)
                  unit)
                (set! v (+ v 1))))
            assignments))])))

;; Place ONE component (root r): collect members, prove every member sound
;; (the single-def Mov-edge relation guarantees the component carries ONE
;; value, so members may overlap freely -- same-value semantics), then choose
;; the cheapest candidate pair. Already-free pairs cost zero; otherwise every
;; interfering scalar must be strictly colder than the component's hottest
;; member and is demoted to its ordinary spill slot before the pair is assigned.
(define (compiler-reg-assign-group-pair-component
  [type-segment-bases : i64]
  [r : i64]
  [vars : i64]
  [type-info : CompilerRegVarTypes]
  [group-vars : live.CompilerLiveI64Set]
  [excluded : live.CompilerLiveI64Set]
  [caller-unsafe : live.CompilerLiveI64Set]
  [starts : (__tl_dyn-array i64)]
  ;; lint-allow: unused-variable
  [ends : (__tl_dyn-array i64)]
  [poisoned : (__tl_dyn-array bool)]
  [parents : (__tl_dyn-array i64)]
  [members : (__tl_dyn-array i64)]
  [interval-index : CompilerRegIntervalIndex]
  [assignments : CompilerRegAssignmentTable]
  [weights : (__tl_dyn-array i64)]
  [call-points : live.CompilerLiveI64Set]
  [split : CompilerRegCallSplit]) : unit
  (let
    [count : i64 0]
    [ok : bool true]
    [component-weight : i64 0]
    [w : i64 0]
    (begin
      (while (< w vars)
        (begin
          (if (= (compiler-reg-group-pair-find parents w) r)
            (begin
              (if (compiler-reg-group-pair-member-ok?
                type-segment-bases
                w
                type-info
                group-vars
                excluded
                starts
                poisoned
                assignments)
                (begin
                  (set! (array-ref members count) w)
                  (set! count (+ count 1)))
                (set! ok false))
              (let
                [weight : i64 (compiler-reg-group-pair-weight weights w)]
                (if (> weight component-weight)
                  (set! component-weight weight)
                  unit)))
            unit)
          (set! w (+ w 1))))
      (if (and ok (> component-weight 0) (> count 0))
        (let
          [caller-saved-ok? : bool
            (and
              (not
                (compiler-reg-group-pair-component-contains?
                  caller-unsafe
                  members
                  count))
              (compiler-reg-group-pair-component-clobber-free?
                interval-index
                call-points
                members
                count))]
          [candidate-count : i64
            (compiler-reg-group-pair-candidate-count caller-saved-ok?)]
          ;; The member-interference scan is the same for every candidate
          ;; register, so collect the interfering vars once here.
          [conflicts : (__tl_dyn-array i64) (array.make-array i64 vars)]
          [conflict-count : i64
            (compiler-reg-group-pair-conflict-vars!
              interval-index
              members
              count
              vars
              conflicts)]
          [best0 : i64 (- 0 1)]
          [best1 : i64 (- 0 1)]
          [best-cost : i64 (- 0 1)]
          [i0 : i64 0]
          (begin
            ;; Search all pairs so an already-free pair always beats eviction,
            ;; and otherwise the coldest displaced scalar set wins.
            (while (< i0 candidate-count)
              (let
                [reg0 : i64
                  (compiler-reg-group-pair-candidate caller-saved-ok? i0)]
                [cost0 : i64
                  (compiler-reg-group-pair-component-register-cost
                    assignments
                    interval-index
                    members
                    count
                    conflicts
                    conflict-count
                    weights
                    component-weight
                    (and caller-saved-ok? (< i0 2))
                    split
                    reg0)]
                (begin
                  (if (>= cost0 0)
                    (let
                      [i1 : i64 (+ i0 1)]
                      (while (< i1 candidate-count)
                        (let
                          [reg1 : i64
                            (compiler-reg-group-pair-candidate
                              caller-saved-ok?
                              i1)]
                          [cost1 : i64
                            (compiler-reg-group-pair-component-register-cost
                              assignments
                              interval-index
                              members
                              count
                              conflicts
                              conflict-count
                              weights
                              component-weight
                              (and caller-saved-ok? (< i1 2))
                              split
                              reg1)]
                          (begin
                            (if (and
                              (>= cost1 0)
                              (or (< best-cost 0) (< (+ cost0 cost1) best-cost)))
                              (begin
                                (set! best0 i0)
                                (set! best1 i1)
                                (set! best-cost (+ cost0 cost1)))
                              unit)
                            (set! i1 (+ i1 1))))))
                    unit)
                  (set! i0 (+ i0 1)))))
            (if (>= best0 0)
              (let
                [reg0 : i64
                  (compiler-reg-group-pair-candidate caller-saved-ok? best0)]
                [reg1 : i64
                  (compiler-reg-group-pair-candidate caller-saved-ok? best1)]
                [pair : CompilerRegLocation
                  (CompilerRegLocation.RegisterPair reg0 reg1)]
                [m : i64 0]
                (begin
                  (compiler-reg-group-pair-evict-reg-conflicts!
                    assignments
                    conflicts
                    conflict-count
                    reg0)
                  (compiler-reg-group-pair-evict-reg-conflicts!
                    assignments
                    conflicts
                    conflict-count
                    reg1)
                  (cfg
                    regalloc-census
                    (io.print-error
                      (str_cat.str-cat
                        "group-pair-assigned|members="
                        (string.int->string count)
                        "|"
                        (string.int->string reg0)
                        ":"
                        (string.int->string reg1)
                        "|evict-cost="
                        (string.int->string best-cost)
                        "\n"))
                    unit)
                  (while (< m count)
                    (let
                      [_ins : CompilerRegAssignmentTable
                        (compiler-reg-assignment-table-insert
                          assignments
                          (array-ref members m)
                          pair)]
                      (set! m (+ m 1))))))
              unit)))
        unit))))

;; GAP3c: coalesce-hull validation of the ABI pins. The pin walk judged each
;; param on its OWN interval, but expand-class-assignments later copies a
;; coalesce ROOT's location onto every class member -- so a pinned param that
;; roots a class effectively occupies its caller-saved register over the whole
;; MERGED hull. A disjoint-coalesced member living past a call would then read
;; the pin register after the call clobbered it (the same hazard the comment at
;; eff-blocked describes for blocked vars, made live by per-interval pins: the
;; old function-global gate could never pin in a clobber-having function, so no
;; member hull could contain a clobber point). Re-run the per-register clobber
;; test on the ROOT's eff-index hull; a failing pin -- or a pin on a var some
;; smaller-id root absorbed (its assignment would be discarded at expansion
;; anyway) -- is UNASSIGNED. The demoted param was never inserted into
;; `blocked` (GAP3c walk), so its root competes in the greedy as an ordinary
;; callee-saved candidate, exactly the M-A contract.
(define (compiler-reg-param-pins-demote-walk!
  [params : ir.CompilerIrParamList]
  [assignments : CompilerRegAssignmentTable]
  [parents : (__tl_dyn-array i64)]
  [eff-index : CompilerRegIntervalIndex]
  [call-points : live.CompilerLiveI64Set]
  [div-points : live.CompilerLiveI64Set]
  [shift-points : live.CompilerLiveI64Set]
  [low-xmm-points : live.CompilerLiveI64Set]) : unit
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) unit]
    [(ir.CompilerIrParamList.Array seq)
      (compiler-reg-param-pins-demote-walk!
        (ir.compiler-ir-param-seq-to-list seq)
        assignments
        parents
        eff-index
        call-points
        div-points
        shift-points
        low-xmm-points)]
    [(ir.CompilerIrParamList.Cons param rest)
      (begin
        (match param
          [(ir.CompilerIrParam.Param _ _ var-id)
            (match (compiler-reg-assignment-table-lookup assignments var-id)
              [(CompilerRegMaybeLocation.Some location)
                (match location
                  [(CompilerRegLocation.Register home)
                    (let
                      [root : i64
                        (if (and
                          (>= var-id 0)
                          (< var-id (array-length parents)))
                          (array-ref parents var-id)
                          var-id)]
                      (if (and
                        (= root var-id)
                        (compiler-reg-param-pin-clobber-free?
                          eff-index
                          call-points
                          div-points
                          shift-points
                          low-xmm-points
                          var-id
                          home))
                        unit
                        (begin
                          (compiler-reg-assignment-table-unassign
                            assignments
                            var-id)
                          unit)))]
                  [_ unit])]
              [(CompilerRegMaybeLocation.No) unit])])
        (compiler-reg-param-pins-demote-walk!
          (__tl-box-place rest)
          assignments
          parents
          eff-index
          call-points
          div-points
          shift-points
          low-xmm-points))]))

(define (compiler-reg-param-pins-demote!
  [func : ir.CompilerIrFunction]
  [assignments : CompilerRegAssignmentTable]
  [coalesce : CompilerRegCoalesceMap]
  [eff-index : CompilerRegIntervalIndex]
  [call-points : live.CompilerLiveI64Set]
  [div-points : live.CompilerLiveI64Set]
  [shift-points : live.CompilerLiveI64Set]
  [low-xmm-points : live.CompilerLiveI64Set]) : unit
  (match func
    [(ir.CompilerIrFunction.Function _ params _ _ _)
      (compiler-reg-param-pins-demote-walk!
        params
        assignments
        coalesce.parents
        eff-index
        call-points
        div-points
        shift-points
        low-xmm-points)]))

(define (compiler-reg-plan-from
  [type-segment-bases : i64]
  [func : ir.CompilerIrFunction]
  [liveness-handle : CompilerRegLivenessHandle]
  [type-info : CompilerRegVarTypes]
  [intervals : CompilerRegIntervalSeq]
  [interval-index : CompilerRegIntervalIndex]
  [assignment-table : CompilerRegAssignmentTable]
  [ineligible : live.CompilerLiveI64Set]
  [blocked : live.CompilerLiveI64Set]
  [allow-caller-saved-zero-call : bool]
  [mask-vars-use-vector-registers : bool]
  [target-abi : cabi.CompilerRegTargetAbi]
  [ignore-single-cold-call? : bool]
  [forced-spill-from : i64]) : CompilerRegPlan
  (let
    [storage-identity-vars : live.CompilerLiveI64Set
      (let
        [base : live.CompilerLiveI64Set
          (if allow-caller-saved-zero-call
            (match func
              [(ir.CompilerIrFunction.Function _ _ _ _ blocks)
                (compiler-reg-ineligible-memory
                  blocks
                  (live.compiler-live-set-empty))])
            (live.compiler-live-set-empty))]
        (if (>= forced-spill-from 0)
          (match func
            [(ir.CompilerIrFunction.Function _ _ _ fn-vars _)
              (compiler-reg-live-set-insert-range
                base
                forced-spill-from
                fn-vars)])
          base))]
    ;; Destructive operand/result ties carry different values and never receive
    ;; the same-value overlap waiver. Keep their ordinary non-overlap relation
    ;; out of intervals spanning call-like, fixed div/mod, or variable-shift
    ;; clobber points, and out of storage-identity variables. Unlike a copy class,
    ;; a different-value destructive chain must not reshape itself across any of
    ;; those physical-register boundaries.
    ;;
    ;; This binding is the scalar plan's call-clobber model: it feeds the
    ;; destructive-tie and same-value coalescing exclusions, the coalesce-hull
    ;; pin re-validation (compiler-reg-param-pins-demote!) and, as `call-points`
    ;; below, the greedy's csr-only restriction. Every one of those asks the same
    ;; SURVIVAL question, so it uses kind 6 -- call-like MINUS the tail-call
    ;; family -- rather than kind 0. Nothing is live across a tail call: it is a
    ;; block terminator after which control never returns here, so a value whose
    ;; coarse interval hull merely covers a sibling arm's tail call keeps the
    ;; caller-saved registers instead of being pinned into a callee-saved home
    ;; the prologue must then push. The conservative kind-0 set remains in force
    ;; where the question is NOT survival: call-region boundaries
    ;; (compiler-reg-call-region-boundary-instr?), the leaf CSR-split gate, and
    ;; the caller-saved rescue all still compute kind 0 for themselves.
    [clobber-points : live.CompilerLiveI64Set
      (if ignore-single-cold-call?
        (live.compiler-live-set-empty)
        (compiler-reg-clobber-kind-points type-segment-bases func 6))]
    ;; Per-register clobber point sets (15c): kind 1 = idiv (rax:rdx), kind 2 =
    ;; variable shift (rcx). Bound once here and reused both for the destructive
    ;; tie exclusion below and for the GAP3c pin demotion / greedy further down;
    ;; each was previously walked twice per function.
    ;; `compiler-reg-clobber-kind-points` is a pure fold over the function's
    ;; blocks and `compiler-live-set-union` never writes through its operands,
    ;; so the shared sets are the same values the two walks produced.
    [div-points : live.CompilerLiveI64Set
      (compiler-reg-clobber-kind-points type-segment-bases func 1)]
    [shift-points : live.CompilerLiveI64Set
      (compiler-reg-clobber-kind-points type-segment-bases func 2)]
    [destructive-fixed-points : live.CompilerLiveI64Set
      (live.compiler-live-set-union div-points shift-points)]
    [destructive-clobber-points : live.CompilerLiveI64Set
      (live.compiler-live-set-union clobber-points destructive-fixed-points)]
    [destructive-eligible : (__tl_dyn-array i64)
      (compiler-reg-same-value-eligible-vars-excluding
        interval-index
        destructive-clobber-points
        storage-identity-vars)]
    ;; GAP8-C operand-tie flips, shared by BOTH tie mechanisms below (the
    ;; destructive-tie move harvest and the copy hints) so the shape is derived
    ;; once per function. Scalar-opt2 only: the SIMD/AVX plan keeps its move list
    ;; and hints byte-identical, and the empty array admits nothing there.
    [alu-prefer-rhs : (__tl_dyn-array i64)
      (if allow-caller-saved-zero-call
        (compiler-reg-function-alu-prefer-rhs func)
        (array.make-array i64 0))]
    [raw-moves
      : CompilerRegMoveSeq
      ;; Phi back-edge moves NON-strict so loop-carried phi/copy pairs coalesce
      ;; (then merge into one root via coalescing-by-rename). SIMD already
      ;; passed false here; only the scalar-opt2 plan gains the loop coalescing.
      ;; Scalar opt2 additionally harvests bounded destructive-binop chain ties,
      ;; then width-64 int casts as copies. SIMD/AVX keeps the plain move list
      ;; byte-identical.
      (if allow-caller-saved-zero-call
        (compiler-reg-function-moves-with-destructive-and-casts-eligible
          func
          false
          destructive-eligible
          alu-prefer-rhs)
        (compiler-reg-function-moves func false))]
    [moves : CompilerRegMoveSeq
      (compiler-reg-move-list-filter-storage-identity
        raw-moves
        storage-identity-vars)]
    [group-vars : live.CompilerLiveI64Set
      (compiler-reg-function-group-vars type-segment-bases func type-info)]
    ;; Same-value overlap-coalescing exclusion points. This is the KIND-6
    ;; (call-like minus tail calls: call/syscall/cpuid/xgetbv) point set, NOT the
    ;; coarse merged
    ;; caller-clobber set. A value that spans only a div/mod or shift is safely
    ;; handled by the greedy's per-register forbidden-regs (div -> {rax,rdx},
    ;; shift -> {rcx}): the coalesced root inherits the union interval and the
    ;; greedy forbids exactly those registers, so the value keeps every other
    ;; register and is never clobbered. Excluding such div/shift-spanning
    ;; same-values from coalescing (as the merged set did) needlessly inflated
    ;; register pressure. Bounds-check and Pack are already absent from both sets
    ;; (clobber-point-instr? returns false for them), so only div/shift differ.
    ;; XMM-family ABI volatility is narrower than the GP clobber model above.
    ;; CpuId/Xgetbv/syscall have fixed GP effects but preserve XMM registers, so
    ;; only real call instructions restrict float/vector candidates to the ABI
    ;; nonvolatile suffix. compiler-reg-call-points deliberately KEEPS the
    ;; tail-call family: the same never-returns argument would license dropping
    ;; them here too, but over-approximating a clobber set is always sound, this
    ;; set is also the SIMD/AVX mask ineligibility input
    ;; (compiler-reg-ineligible-vars-simd), and no measured row depends on
    ;; XMM-homed values crossing a tail-call hull -- so it stays conservative and
    ;; the vector paths stay byte-identical.
    [xmm-call-points : live.CompilerLiveI64Set (compiler-reg-call-points func)]
    ;; Compiler-emitted vector lowering still contains a bounded set of
    ;; XMM0/XMM1-family temporaries. Make that ownership explicit to the scalar
    ;; greedy while scratch-vreg admits those homes; values not crossing one of
    ;; these points remain free to use the low ABI registers.
    [low-xmm-clobber-points : live.CompilerLiveI64Set
      (cfg
        scratch-vreg
        (compiler-reg-clobber-kind-points type-segment-bases func 5)
        (live.compiler-live-set-empty))]
    ;; #2 same-value overlap coalescing: single-def direct copy pairs carry one
    ;; identical value and may coalesce even when their live segments overlap.
    ;; Vars spanning a modeled caller-clobber point stay out of the same-value
    ;; relation; their save/restore and regmask constraints are already
    ;; represented by normal interference and must not be bypassed by an overlap
    ;; waiver.
    [sv-parents
      : (__tl_dyn-array i64)
      ;; M-C (part 1): the scalar-opt2 path uses the extended relation that also
      ;; admits copies of mutable (multi-def / phi-def) sources under the
      ;; def-inside-liveness safety check; other paths keep the single-def-only
      ;; builder (their coalesce map is empty anyway).
      (if allow-caller-saved-zero-call
        (compiler-reg-function-same-value-parents-multi
          func
          (compiler-reg-same-value-eligible-vars-excluding
            interval-index
            clobber-points
            storage-identity-vars)
          type-info
          interval-index)
        (compiler-reg-function-same-value-parents-filtered
          func
          (compiler-reg-same-value-eligible-vars-excluding
            interval-index
            clobber-points
            storage-identity-vars)))]
    ;; Coalescing interference uses a hybrid view. Scalar opt2 allocation already
    ;; receives the edge-precise interval-index at the plan entry; the hybrid adds
    ;; the same precise phi-edge segments while retaining a separately built
    ;; conservative view for the live-out-input exclusion. A loop-carried phi and
    ;; its back-edge / merge input do not really interfere (the baseline spuriously
    ;; overlaps them via phi-inputs-live-at-the-header), so this lets the carry
    ;; coalesce into one interval without weakening that defensive exclusion.
    [coalesce-index : CompilerRegIntervalIndex
      (if (compiler-reg-move-list-empty? moves)
        interval-index
        (if allow-caller-saved-zero-call
          ;; Edge-precise liveness (PHIElimination semantics) computed once and shared
          ;; by the coalescing segment index AND the live-out-input phi exclusion.
          ;; Skipped entirely when there are no moves to coalesce (the empty arm
          ;; above): the map build below returns the empty map without reading
          ;; this index, so the plan is unchanged and the EP interval
          ;; selection + safe-mode exclusion are provably dead work for
          ;; move-free functions.
          (let
            [ep-liveness : live.CompilerFunctionLiveness
              (compiler-reg-liveness-handle-edge-precise liveness-handle)]
            ;; Exclude unsafe live-out inputs while admitting proven self-loop
            ;; back-edge-only values. Fixed div/mod or variable-shift functions
            ;; retain the conservative guard: relaxing an otherwise unrelated
            ;; carry can reshape fixed-home pressure differently on SysV/Win64.
            ;; Built BEFORE the EP segment walk (both are pure reads of `func`
            ;; and `ep-liveness` into their own fresh arrays, so the order does
            ;; not change either result) so the walk can restrict itself to the
            ;; rows the hybrid index will actually read.
            [phi-touched : (__tl_dyn-array i64)
              (compiler-reg-function-phi-touched-safe-mode
                func
                ep-liveness
                (=
                  (live.compiler-live-set-word-count destructive-fixed-points)
                  0))]
            ;; The hybrid's conservative input: allocation runs on the
            ;; edge-precise index (see the EP comment at the plan entry),
            ;; while the live-out-input phi exclusion's defense in depth is
            ;; specified against CONSERVATIVE segments, so this gate alone
            ;; keeps a baseline-liveness index -- computed on the coalescing
            ;; branch only, so move-free functions never pay the second
            ;; interval-selection walk. The M-A (RC1) param extension is
            ;; applied as well, keeping the gate's param hulls identical to
            ;; what it read before the EP switch. The cold-split plan's
            ;; allocation index is edge-precise at both levels, exactly what
            ;; it fed this gate before, so it keeps that same object.
            [cons-index : CompilerRegIntervalIndex
              (if (>= forced-spill-from 0)
                interval-index
                (match (compiler-reg-live-interval-selection
                  func
                  liveness-handle.baseline)
                  [(CompilerRegIntervalSelection.Selection _ cons-idx)
                    (begin
                      (match func
                        [(ir.CompilerIrFunction.Function _ params _ _ _)
                          (compiler-reg-param-intervals-extend-entry!
                            params
                            cons-idx)])
                      cons-idx)]))]
            (compiler-reg-hybrid-coalesce-index
              cons-index
              (compiler-reg-live-interval-selection-ep-segments
                func
                ep-liveness
                phi-touched)
              phi-touched))
          interval-index))]
    [coalesce : CompilerRegCoalesceMap
      (if allow-caller-saved-zero-call
        (compiler-reg-coalesce-map-build
          moves
          coalesce-index
          type-info
          group-vars
          (array-length coalesce-index.starts)
          sv-parents)
        (CompilerRegCoalesceMap (array.make-array i64 0)))]
    ;; Collapse coalesce classes to one root candidate each, and run
    ;; the allocation passes over those roots with an EMPTY coalesce map (the
    ;; merge already realised coalescing, so no per-member coalesce-location is
    ;; needed). SIMD/AVX (allow-caller-saved-zero-call = false) builds no coalesce
    ;; map, so eff-* fall back to the originals and that path is byte-identical.
    [eff-index : CompilerRegIntervalIndex
      (if allow-caller-saved-zero-call
        (compiler-reg-merged-root-index coalesce interval-index)
        interval-index)]
    [low-xmm-exclusions : (__tl_dyn-array CompilerRegIdSeq)
      (cfg
        scratch-vreg
        (compiler-reg-low-xmm-exclusions eff-index low-xmm-clobber-points)
        (array.make-array CompilerRegIdSeq 0))]
    ;; `div-points` / `shift-points` (kinds 1 and 2) are the sets bound above;
    ;; the GAP3c pin demotion below and the greedy share that one computation.
    ;; GAP3c: validate every ABI pin against its coalesce-class hull now that
    ;; the coalesce map exists; unsound pins are unassigned and their params
    ;; fall through to the ordinary greedy CSR path (see
    ;; compiler-reg-param-pins-demote!). Scalar-opt2 only -- the SIMD path
    ;; never pins (param-assign-plan is not on it).
    [_pin-demote : unit
      (if allow-caller-saved-zero-call
        (compiler-reg-param-pins-demote!
          func
          assignment-table
          coalesce
          eff-index
          clobber-points
          div-points
          shift-points
          low-xmm-clobber-points)
        unit)]
    ;; Only scalar opt2 builds the targeted five-pseudo model. When the exact
    ;; literal SafeDiv/SafeMod shape is absent, the builder returns the original
    ;; index/types/table by identity and does not grow the worklist.
    [early-scratch-model : CompilerRegEarlyScratchModel
      (compiler-reg-early-scratch-model
        type-segment-bases
        target-abi
        func
        eff-index
        type-info
        assignment-table
        allow-caller-saved-zero-call)]
    [allocation-index : CompilerRegIntervalIndex
      early-scratch-model.interval-index]
    [early-scratch-base : i64 early-scratch-model.scratch-base]
    [early-scratch-count : i64 early-scratch-model.scratch-count]
    [early-scratch-weights : (__tl_dyn-array i64)
      early-scratch-model.scratch-weights]
    ;; move census (cfg regalloc-census only; no-op otherwise): categorise the
    ;; harvested moves against the final coalesce result + per-var and per-root
    ;; segments.
    [_move-census : unit
      (cfg
        regalloc-census
        (if allow-caller-saved-zero-call
          (compiler-reg-move-census-record!
            moves
            coalesce.parents
            interval-index
            eff-index
            type-info
            group-vars
            sv-parents)
          unit)
        unit)]
    [eff-intervals : CompilerRegIntervalSeq
      (if allow-caller-saved-zero-call
        (compiler-reg-interval-arrays-to-seq
          eff-index.starts
          eff-index.ends
          (- (array-length eff-index.starts) 1)
          (compiler-reg-interval-seq-empty))
        intervals)]
    [allocation-intervals : CompilerRegIntervalSeq
      (if (= early-scratch-count 0)
        eff-intervals
        (compiler-reg-interval-arrays-to-seq
          allocation-index.starts
          allocation-index.ends
          (- (array-length allocation-index.starts) 1)
          (compiler-reg-interval-seq-empty)))]
    ;; copy-hint biasing: per-root preferred move-neighbour for the integer passes.
    [copy-hints
      : (__tl_dyn-array i64)
      ;; Built unconditionally now that the greedy allocates the SIMD-integer path
      ;; too: with the empty false-path coalesce, copy-hints-add-move! falls back to
      ;; identity roots, so this yields direct var->move-neighbour hints -- letting
      ;; the SIMD-integer greedy bias a copy's dst onto its src register (LLVM-style
      ;; copy hint for every class), which the old linear-scan did via `moves`.
      ;; The scalar float->XMM greedy consumes the same hints over its XMM pool.
      (compiler-reg-function-copy-hints
        moves
        coalesce
        (array-length interval-index.starts)
        func
        alu-prefer-rhs)]
    ;; arg-var -> ABI-arg-register physical preference: each outgoing call-argument
    ;; var biased toward the target register it will be marshalled into, so the
    ;; backend's `movq <home>, <arg-reg>` becomes an elided self-move. Indexed by
    ;; coalesce root, like copy-hints. The scalar-opt2 integer greedy consumes
    ;; this GP-pool array; the float greedy consumes the separate XMM-pool array
    ;; below. SIMD-integer uses a different pool and ignores both.
    [arg-prefs : (__tl_dyn-array i64)
      (compiler-reg-function-arg-prefs
        target-abi
        func
        coalesce
        (array-length interval-index.starts))]
    [float-arg-prefs : (__tl_dyn-array i64)
      (compiler-reg-function-float-arg-prefs
        target-abi
        func
        type-info
        coalesce
        (array-length interval-index.starts))]
    ;; The effective scalar allocation pass sees only coalesced
    ;; roots, so original-var exclusions must block the root. Otherwise a root
    ;; may get a register even though one merged member is a call argument or
    ;; parameter that must stay stack/ABI-homed; on Windows that let a stack
    ;; CreateFileA argument inherit %r9 after the same call clobbered %r9 for the
    ;; fourth ABI argument.
    [eff-blocked : live.CompilerLiveI64Set
      (if allow-caller-saved-zero-call
        (compiler-reg-coalesce-root-set-from-vars coalesce blocked)
        blocked)]
    ;; M-A (RC1): param var ids mapped to their coalesce ROOTS -- each greedy
    ;; allocates class roots, and a class containing a param must be restricted
    ;; to callee-saved homes (alloc-one! `is-param`; the entry copy writes the
    ;; home in the prologue). Reuses the ineligible-params walk as a plain
    ;; param-id collector. Scalar-opt2 only: the SIMD path stack-homes every
    ;; param (ineligible-vars-simd). Integer and float candidates consume the
    ;; same root set over their respective callee-saved banks.
    [param-roots : live.CompilerLiveI64Set
      (if allow-caller-saved-zero-call
        (compiler-reg-coalesce-root-set-from-vars
          coalesce
          (match func
            [(ir.CompilerIrFunction.Function _ params _ _ _)
              (compiler-reg-ineligible-params
                params
                (live.compiler-live-set-empty))]))
        (live.compiler-live-set-empty))]
    [integer-candidates : CompilerRegIntervalSeq
      (compiler-reg-candidates eff-intervals type-info eff-blocked false)]
    [scratch-candidates : CompilerRegIntervalSeq
      (compiler-reg-early-scratch-intervals
        allocation-intervals
        early-scratch-base)]
    [integer-registers : CompilerRegIdSeq
      (compiler-reg-callee-saved-integer-registers-for-abi target-abi)]
    [vector-mask-defs : live.CompilerLiveUseDef
      (compiler-reg-function-vector-mask-defs func)]
    ;; Loop-depth-weighted use counts drive spill-weight eviction on the
    ;; integer scalar opt2 stage (allow-caller-saved-zero-call is the scalar-opt2
    ;; discriminator). An empty array selects the original furthest-end policy,
    ;; keeping the SIMD/AVX plan and the caller-saved XMM stage byte-identical.
    [base-eviction-ref-counts : (__tl_dyn-array i64)
      (if allow-caller-saved-zero-call
        ;; The greedy ALWAYS uses remat-discounted spill weights for its priority
        ;; order (LLVM RAGreedy always computes spill weights). The old
        ;; remat-weight-needed gate compared total candidates to the full
        ;; (8-register) pool, so a call-spanning function -- whose values may only
        ;; use only the ABI callee-saved suffix and so oversubscribe even below
        ;; the full scalar pool size -- got an empty weight array and fell back to var-id
        ;; order, keeping the rematerialisable constant in a register and spilling
        ;; a more expensive non-remat value. Always scoring fixes that (each
        ;; coalesced class scored by its hottest member). The discounted
        ;; weight is combined with the RAW use-density as a tie-break (combine-
        ;; spill-weights) so that among equal-discounted values the genuinely
        ;; coldest one spills, not an arbitrary tied one.
        (compiler-reg-function-spill-weights-combined
          func
          coalesce
          (array-length interval-index.starts))
        (array.make-array i64 0))]
    [base-eviction-raw-counts : (__tl_dyn-array i64)
      (if (and allow-caller-saved-zero-call (> early-scratch-count 0))
        (compiler-reg-merge-ref-counts
          coalesce
          (compiler-reg-function-spill-weights func)
          (array-length interval-index.starts))
        (array.make-array i64 0))]
    [eviction-ref-counts : (__tl_dyn-array i64)
      (compiler-reg-early-scratch-extend-weights
        base-eviction-ref-counts
        base-eviction-raw-counts
        (array-length allocation-index.starts)
        early-scratch-base
        early-scratch-count
        early-scratch-weights)]
    ;; The greedy's per-register clobber restriction (15c) reuses the kind
    ;; point sets bound above: `clobber-points` IS the kind-6 set (call-like
    ;; minus the tail-call family; see its binding), and
    ;; div-points/shift-points let the greedy forbid only the registers each op
    ;; actually clobbers, so a div/shift-spanning value keeps the caller-saved
    ;; regs the op leaves alone instead of being forced callee-saved. On the
    ;; SIMD-integer path caller-saved-count=0 makes every pool register
    ;; callee-saved (no restriction); XMM-family paths use the ABI volatile/
    ;; nonvolatile boundary directly.
    [call-points : live.CompilerLiveI64Set clobber-points]
    ;; Step B: preserve the established scalar coloring as the base plan. The
    ;; scratch-only worklist below starts from that exact table and may
    ;; evict/requeue real roots when a targeted instruction creates pressure.
    ;; If it moves no real root, downstream passes retain this original table by
    ;; identity, keeping no-pressure functions byte-identical.
    [prepass-assignments : CompilerRegAssignmentTable assignment-table]
    [integer-state
      : CompilerRegAssignState
      ;; Integer allocation via the unified per-vreg Greedy allocator (priority-queue
      ;; selectOrSplit, per-physreg LiveIntervalUnion, call-clobber as interference).
      ;; Scalar-opt2 (true) uses the ABI-specific integer pool + coalescing; the
      ;; SIMD/AVX branch below (false) uses the Linux callee-saved pool with no
      ;; coalescing -- the same algorithm, a conservative config.
      (if allow-caller-saved-zero-call
        (compiler-reg-greedy-state
          integer-candidates
          (compiler-reg-greedy-integer-pool-for-abi target-abi)
          prepass-assignments
          eff-index
          group-vars
          param-roots
          base-eviction-ref-counts
          copy-hints
          arg-prefs
          call-points
          div-points
          shift-points
          integer-registers
          (compiler-reg-greedy-caller-saved-count-for-abi target-abi)
          -1)
        ;; SIMD/AVX integer allocation: same unified greedy, over the 5 callee-saved
        ;; integer registers (= the old SIMD pool) with caller-saved-count=0 so every
        ;; register is treated callee-saved (no caller-saved-first ordering; the SIMD
        ;; path never partitioned). ref-counts/copy-hints are empty here -> the
        ;; greedy's bounds-guarded spill-weight/hint accesses fall back to var-id
        ;; order / no-hint, matching the old linear-scan's defaults.
        (compiler-reg-greedy-state
          integer-candidates
          integer-registers
          prepass-assignments
          eff-index
          group-vars
          (live.compiler-live-set-empty)
          base-eviction-ref-counts
          copy-hints
          (array.make-array i64 0)
          call-points
          div-points
          shift-points
          integer-registers
          0
          -1))]
    [base-integer-assignments : CompilerRegAssignmentTable
      (match integer-state
        [(CompilerRegAssignState.State _ assignments) assignments])]
    ;; The early interval shape is allocation-independent, but each lowering
    ;; constraint excludes the instruction operands' PHYSICAL homes. Refresh the
    ;; targeted model after base coloring so C15b's scratch phase cannot claim a
    ;; home that the retained late planner must reject. Non-target functions keep
    ;; the original empty model by identity and pay no second walk.
    [colored-early-scratch-model : CompilerRegEarlyScratchModel
      (if (= early-scratch-count 0)
        early-scratch-model
        (compiler-reg-early-scratch-model
          type-segment-bases
          target-abi
          func
          eff-index
          type-info
          base-integer-assignments
          true))]
    [allocation-table : CompilerRegAssignmentTable
      colored-early-scratch-model.assignments]
    [early-scratch-excluded : (__tl_dyn-array CompilerRegIdSeq)
      colored-early-scratch-model.scratch-excluded]
    [scratch-input-assignments : CompilerRegAssignmentTable
      (compiler-reg-assignment-table-with-scratch
        base-integer-assignments
        allocation-table
        early-scratch-base
        early-scratch-count)]
    [scratch-state : CompilerRegAssignState
      (if (= early-scratch-count 0)
        (CompilerRegAssignState.State
          (compiler-reg-active-seq-empty)
          scratch-input-assignments)
        (compiler-reg-greedy-state-with-scratch-exclusions
          scratch-candidates
          (compiler-reg-greedy-integer-pool-for-abi target-abi)
          scratch-input-assignments
          allocation-index
          group-vars
          param-roots
          eviction-ref-counts
          copy-hints
          arg-prefs
          call-points
          div-points
          shift-points
          integer-registers
          (compiler-reg-greedy-caller-saved-count-for-abi target-abi)
          early-scratch-base
          early-scratch-excluded))]
    [integer-scratch-assignments : CompilerRegAssignmentTable
      (match scratch-state
        [(CompilerRegAssignState.State _ assignments) assignments])]
    [integer-assignments : CompilerRegAssignmentTable
      (if (or
        (= early-scratch-count 0)
        (compiler-reg-assignment-table-prefix-eq?
          base-integer-assignments
          integer-scratch-assignments
          early-scratch-base
          0))
        base-integer-assignments
        (compiler-reg-assignment-table-prefix
          integer-scratch-assignments
          early-scratch-base))]
    ;; Step B: the caller-saved-overflow pass is gone -- the unified greedy already
    ;; allocates the caller-saved zero-call prefix itself, so retrying the same
    ;; registers here was redundant. The call-spanning save/restore rescue (a
    ;; real spill-avoidance, not a register-allocation pass) is kept and fed the
    ;; greedy's assignments directly.
    [integer-with-call-save-state : CompilerRegCallSaveAssignState
      (if (and
        allow-caller-saved-zero-call
        (compiler-reg-assignment-table-has-spill? integer-assignments))
        (compiler-reg-assign-caller-saved-call-spanning
          type-segment-bases
          target-abi
          func
          integer-candidates
          integer-assignments
          eff-index
          type-info
          group-vars
          coalesce.parents
          base-eviction-ref-counts)
        (CompilerRegCallSaveAssignState.State
          integer-assignments
          (compiler-reg-call-split-empty)))]
    [integer-call-assignments : CompilerRegAssignmentTable
      (match integer-with-call-save-state
        [(CompilerRegCallSaveAssignState.State assignments _) assignments])]
    [call-save-split : CompilerRegCallSplit
      (match integer-with-call-save-state
        [(CompilerRegCallSaveAssignState.State _ split) split])]
    [call-save-shadows : live.CompilerLiveI64Set
      (compiler-reg-call-split-shadows call-save-split)]
    [scalar-state
      : CompilerRegAssignState
      ;; float -> XMM allocation: the unified greedy over the ABI XMM bank.
      ;; A clobber-spanning float starts at the ABI callee-saved suffix: none on
      ;; SysV (so it spills), XMM6-XMM15 on Win64. Non-spanning floats may use the
      ;; whole configured XMM pool. Reuse the coalesced-class spill weights and copy
      ;; hints so float pressure is ordered by actual use density and moves bias
      ;; toward an already assigned neighbour, matching the integer greedy.
      (compiler-reg-greedy-state-with-scratch-exclusions
        (compiler-reg-candidates eff-intervals type-info eff-blocked true)
        (compiler-reg-xmm-registers-for-abi target-abi)
        integer-call-assignments
        eff-index
        group-vars
        param-roots
        base-eviction-ref-counts
        copy-hints
        float-arg-prefs
        xmm-call-points
        div-points
        shift-points
        (compiler-reg-xmm-callee-registers-for-abi target-abi)
        (compiler-reg-xmm-caller-register-count-for-abi target-abi)
        -1
        low-xmm-exclusions)]
    [scalar-assignments : CompilerRegAssignmentTable
      (match scalar-state
        [(CompilerRegAssignState.State _ assignments) assignments])]
    [_float-call-arg-demote : unit
      (if allow-caller-saved-zero-call
        (compiler-reg-float-call-args-demote!
          target-abi
          func
          type-info
          coalesce
          scalar-assignments)
        unit)]
    [vector-vars : live.CompilerLiveI64Set vector-mask-defs.uses]
    [mask-vars : live.CompilerLiveI64Set vector-mask-defs.defs]
    ;; Scalar-only functions (no vector or mask IR values) have no special
    ;; candidates at all: the select-false preference walk, both special-candidate
    ;; interval filters, the vector greedy, and the mask fixed-candidate pass all
    ;; return their inputs unchanged, so skip the whole vector/mask prep chain.
    [vector-mask-empty? : bool
      (and
        (= (live.compiler-live-set-count vector-vars) 0)
        (= (live.compiler-live-set-count mask-vars) 0))]
    [vector-candidate-vars : live.CompilerLiveI64Set
      (if vector-mask-empty?
        vector-vars
        (if mask-vars-use-vector-registers
          (live.compiler-live-set-union vector-vars mask-vars)
          vector-vars))]
    [mask-candidate-vars : live.CompilerLiveI64Set
      (if vector-mask-empty?
        mask-vars
        (if mask-vars-use-vector-registers
          (live.compiler-live-set-empty)
          mask-vars))]
    [vector-preferences : (__tl_dyn-array i64)
      (if vector-mask-empty?
        (array.make-array i64 0)
        (compiler-reg-function-select-false-preferences
          func
          (array-length interval-index.starts)))]
    [vector-candidates : CompilerRegIntervalSeq
      (if vector-mask-empty?
        (compiler-reg-interval-seq-empty)
        (compiler-reg-special-candidates
          intervals
          vector-candidate-vars
          blocked))]
    [_vector-class-reset : unit
      (compiler-reg-unassign-special-candidates!
        scalar-assignments
        vector-candidates)]
    [vector-state
      : CompilerRegAssignState
      ;; Vectors share the XMM physical bank and the scalar greedy's ABI
      ;; clobber rule. `%vecN` is an allocator-only class spelling; backend
      ;; save/restore sees the same physical N through the overlap helper.
      (if vector-mask-empty?
        (CompilerRegAssignState.State
          (compiler-reg-active-seq-empty)
          scalar-assignments)
        (compiler-reg-greedy-state
          vector-candidates
          (compiler-reg-vector-registers-for-abi target-abi)
          scalar-assignments
          interval-index
          (live.compiler-live-set-empty)
          (live.compiler-live-set-empty)
          (array.make-array i64 0)
          vector-preferences
          (array.make-array i64 0)
          xmm-call-points
          div-points
          shift-points
          (compiler-reg-vector-callee-registers-for-abi target-abi)
          (compiler-reg-vector-caller-register-count-for-abi target-abi)
          -1))]
    [vector-assignments : CompilerRegAssignmentTable
      (match vector-state
        [(CompilerRegAssignState.State _ assignments) assignments])]
    [_mask-class-reset
      : unit
      ;; The scalar greedy provisionally homes mask values in GP registers.
      ;; Clear those homes before fixed k-register allocation so excess mask
      ;; pressure remains unassigned and is emitted through the existing
      ;; stack-slot spill path instead of reaching the backend as a GP home.
      (compiler-reg-unassign-special-candidates!
        vector-assignments
        (compiler-reg-special-candidates intervals mask-candidate-vars blocked))]
    [mask-state : CompilerRegAssignState
      (if vector-mask-empty?
        (CompilerRegAssignState.State
          (compiler-reg-active-seq-empty)
          vector-assignments)
        (compiler-reg-assign-fixed-candidates
          (compiler-reg-special-candidates
            intervals
            mask-candidate-vars
            blocked)
          (compiler-reg-mask-registers)
          (compiler-reg-active-seq-empty)
          vector-assignments
          (array.make-array i64 0)
          interval-index))]
    [assignments : CompilerRegAssignmentTable
      (match mask-state
        [(CompilerRegAssignState.State _ found) found])]
    ;; SplitKit removed: CompilerRegPlan still carries an (empty) split-plan
    ;; field, but nothing populates or consumes it.
    [split-plan : CompilerRegSplitPlan (compiler-reg-split-plan-empty)]
    ;; The passes above assigned class ROOTS; expand so every member
    ;; inherits its root's location (realising the coalesce). SIMD/AVX has no
    ;; coalesce map, so this is the identity there.
    [final-assignments : CompilerRegAssignmentTable
      (if allow-caller-saved-zero-call
        (compiler-reg-rewrite-remat-assignments
          (compiler-reg-expand-class-assignments
            assignments
            coalesce
            storage-identity-vars
            interval-index.starts
            (array-length interval-index.starts))
          func
          coalesce
          call-save-shadows
          (array-length interval-index.starts))
        assignments)]
    ;; GAP2b: register-pair homing for group values. Runs LAST, when every
    ;; scalar home is final, so pair selection/eviction is judged against the
    ;; exact register landscape the backend will see. Linux scalar-opt2 only
    ;; (the M-G3/M-F gating pattern); every other path is byte-identical.
    [pair-assignments : CompilerRegAssignmentTable
      (if allow-caller-saved-zero-call
        (match target-abi
          [(cabi.CompilerRegTargetAbi.Linux)
            (compiler-reg-assign-group-pairs
              type-segment-bases
              func
              type-info
              group-vars
              interval-index
              final-assignments
              base-eviction-ref-counts
              call-points
              call-save-split)]
          [(cabi.CompilerRegTargetAbi.Windows) final-assignments])
        final-assignments)]
    (CompilerRegPlan.Plan
      pair-assignments
      ineligible
      intervals
      type-info
      call-save-split
      split-plan)))

;; SIMD/AVX register plan (unchanged from before #perf): full dataflow-liveness
;; intervals + the call-live-conservative ineligibility, keeping AVX backend
;; golden output byte-identical.
(define (compiler-reg-plan-function-with-type-segment-bases-for-abi
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]) : CompilerRegPlan
  (let
    [liveness-handle : CompilerRegLivenessHandle
      (compiler-reg-liveness-handle-make func false)]
    [liveness : live.CompilerFunctionLiveness liveness-handle.baseline]
    [type-info : CompilerRegVarTypes (compiler-reg-function-var-types func)]
    [intervals : CompilerRegIntervalSeq
      (compiler-reg-live-intervals func liveness)]
    [ineligible : live.CompilerLiveI64Set
      (compiler-reg-ineligible-vars-simd func type-info intervals)]
    [vars : i64
      (match func
        [(ir.CompilerIrFunction.Function _ _ _ function-vars _) function-vars])]
    (compiler-reg-plan-from
      type-segment-bases
      func
      liveness-handle
      type-info
      intervals
      (compiler-reg-interval-index-build intervals vars)
      (compiler-reg-assignment-table-make vars)
      ineligible
      ineligible
      false
      false
      target-abi
      false
      (- 0 1))))

(define (compiler-reg-plan-function-for-abi
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]) : CompilerRegPlan
  (compiler-reg-plan-function-with-type-segment-bases-for-abi
    (ast.ast-node-pool-reader-type-segment-bases)
    target-abi
    func))

(define (compiler-reg-plan-function [func : ir.CompilerIrFunction]) : CompilerRegPlan
  (compiler-reg-plan-function-for-abi cabi.CompilerRegTargetAbi.Linux func))

(define (compiler-reg-plan-function-avx2-with-type-segment-bases-for-abi
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]) : CompilerRegPlan
  (let
    [liveness-handle : CompilerRegLivenessHandle
      (compiler-reg-liveness-handle-make func false)]
    [liveness : live.CompilerFunctionLiveness liveness-handle.baseline]
    [type-info : CompilerRegVarTypes (compiler-reg-function-var-types func)]
    [intervals : CompilerRegIntervalSeq
      (compiler-reg-live-intervals func liveness)]
    [ineligible : live.CompilerLiveI64Set
      (compiler-reg-ineligible-vars-simd func type-info intervals)]
    [vars : i64
      (match func
        [(ir.CompilerIrFunction.Function _ _ _ function-vars _) function-vars])]
    (compiler-reg-plan-from
      type-segment-bases
      func
      liveness-handle
      type-info
      intervals
      (compiler-reg-interval-index-build intervals vars)
      (compiler-reg-assignment-table-make vars)
      ineligible
      ineligible
      false
      true
      target-abi
      false
      (- 0 1))))

(define (compiler-reg-plan-function-avx2-for-abi
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]) : CompilerRegPlan
  (compiler-reg-plan-function-avx2-with-type-segment-bases-for-abi
    (ast.ast-node-pool-reader-type-segment-bases)
    target-abi
    func))

(define (compiler-reg-scalar-full-intervals? [func : ir.CompilerIrFunction]) : bool
  (match func
    [(ir.CompilerIrFunction.Function _ _ _ _ _) true]))

;; M-A (RC1) correctness requirement: a register-homed param's home register is
;; WRITTEN by the backend's entry copy in the prologue, before the first
;; instruction, so the param's interval must be reserved from the function's
;; first point. The precise (segmented) builder starts a live-in-at-entry param
;; at point 1 (live-after of instr 0 extends at point+1); a var whose interval
;; is exactly [0,0] would then look disjoint under the coarse [start,end]
;; fallback, share the param's home register, and its instr-0 def would
;; overwrite the param's entry-copied value before the param's first read.
;; Force every used param's interval (both starts[] and its earliest segment)
;; to start at point 0. Params with no interval (never used) are left alone --
;; they never become candidates.
(define (compiler-reg-param-segments-extend-entry
  [segs : CompilerRegIntervalSeq]
  [min-start : i64]) : CompilerRegIntervalSeq
  (let
    [out : CompilerRegIntervalSeq
      (compiler-reg-interval-seq-with-capacity
        (compiler-reg-interval-seq-count segs))]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-interval-seq-count segs))
        (begin
          (let
            [interval : CompilerRegInterval
              (compiler-reg-interval-seq-ref segs index)]
            [start : i64 interval.start]
            (set!
              out
              (compiler-reg-interval-seq-append
                out
                (CompilerRegInterval
                  interval.var
                  (if (= start min-start)
                    0
                    start)
                  interval.end))))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-param-segments-min-start
  [segs : CompilerRegIntervalSeq]
  [best : i64]) : i64
  (let
    [out : i64 best]
    [index : i64 0]
    (begin
      (while (< index (compiler-reg-interval-seq-count segs))
        (begin
          (let
            [start : i64
              (__tl-project-field
                (compiler-reg-interval-seq-ref segs index)
                start)]
            (if (or (< out 0) (< start out))
              (set! out start)
              unit))
          (set! index (+ index 1))))
      out)))

(define (compiler-reg-param-intervals-extend-entry!
  [params : ir.CompilerIrParamList]
  [interval-index : CompilerRegIntervalIndex]) : unit
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) unit]
    [(ir.CompilerIrParamList.Array seq)
      (compiler-reg-param-intervals-extend-entry!
        (ir.compiler-ir-param-seq-to-list seq)
        interval-index)]
    [(ir.CompilerIrParamList.Cons param rest)
      (match param
        [(ir.CompilerIrParam.Param _ _ var)
          (let
            [starts : (__tl_dyn-array i64) interval-index.starts]
            [segments : (__tl_dyn-array CompilerRegIntervalSeq)
              interval-index.segments]
            (begin
              (if (and
                (>= var 0)
                (< var (array-length starts))
                (> (array-ref starts var) 0))
                (begin
                  (set! (array-ref starts var) 0)
                  (if (< var (array-length segments))
                    (let
                      [segs : CompilerRegIntervalSeq (array-ref segments var)]
                      [min-start : i64
                        (compiler-reg-param-segments-min-start segs (- 0 1))]
                      (if (> min-start 0)
                        (begin
                          (set!
                            (array-ref segments var)
                            (compiler-reg-param-segments-extend-entry
                              segs
                              min-start))
                          unit)
                        unit))
                    unit))
                unit)
              (compiler-reg-param-intervals-extend-entry!
                (__tl-box-place rest)
                interval-index)))])]))

(define (compiler-reg-live-set-insert-range
  [set : live.CompilerLiveI64Set]
  [start : i64]
  [end : i64]) : live.CompilerLiveI64Set
  (if (>= start end)
    set
    (compiler-reg-live-set-insert-range
      (live.compiler-live-set-insert set start)
      (+ start 1)
      end)))

(define (compiler-reg-plan-function-scalar-cold-for-abi
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [forced-spill-from : i64]) : CompilerRegPlan
  (compiler-reg-plan-function-scalar-cold-for-abi-with-types
    target-abi
    func
    forced-spill-from
    (compiler-reg-function-var-types func)))

;; `type-info` must be `(compiler-reg-function-var-types func)`. The backend
;; already needs that view for its caller-save rewrite, so it computes it once
;; and passes it in rather than having both walk the function.
(define (compiler-reg-plan-function-scalar-cold-with-type-segment-bases-for-abi-with-types-and-preassignments
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [forced-spill-from : i64]
  [type-info : CompilerRegVarTypes]
  [forced-assignments : CompilerRegAssignmentTable]) : CompilerRegPlan
  (let
    [liveness-handle : CompilerRegLivenessHandle
      (compiler-reg-liveness-handle-make func true)]
    [vars : i64
      (match func
        [(ir.CompilerIrFunction.Function _ _ _ function-vars _) function-vars])]
    [interval-selection : CompilerRegIntervalSelection
      (if (compiler-reg-scalar-full-intervals? func)
        ;; ALLOCATION RUNS ON EDGE-PRECISE LIVENESS. The baseline treats a
        ;; phi's inputs as uses AT the phi block, so a loop's back-edge def
        ;; appears live-in at the header from EVERY predecessor and leaks
        ;; backward through the versioning guard chain to function entry:
        ;; in a multi-loop function the coalesced loop-carry class then spans
        ;; [entry, loop-end] and the greedy sees one giant cross-function web
        ;; -- hot loop-carried counters lose first-free against every sibling
        ;; loop's residents and spill whole, fragmenting into per-iteration
        ;; mem-to-mem copies (the cfg_domloops/CSR defect, #6248). The EP
        ;; analysis (compiler-live-analyze-function-edge-precise) attributes
        ;; each phi input to its own predecessor edge -- the exact SSA
        ;; interference, identical to the baseline for every var that is not
        ;; a phi input -- so allocation interference, call-span tests, and
        ;; same-value eligibility all get exact inputs and stay sound. The
        ;; coalescing hybrid alone keeps a conservative index (computed on
        ;; its own branch in compiler-reg-plan-from): the live-out-input phi
        ;; exclusion is specified against conservative segments. The
        ;; cold-split caller already used EP for this selection, so it sees
        ;; no change.
        (compiler-reg-live-interval-selection
          func
          (compiler-reg-liveness-handle-edge-precise liveness-handle))
        (let
          [block-intervals : CompilerRegIntervalSeq
            (compiler-reg-block-intervals func)]
          (CompilerRegIntervalSelection.Selection
            block-intervals
            (compiler-reg-interval-index-build block-intervals vars))))]
    (match interval-selection
      [(CompilerRegIntervalSelection.Selection _ interval-index)
        (let
          ;; M-A (RC1): reserve every used param's interval from function entry
          ;; (mutates the index arrays), then rebuild the interval sequence from
          ;; the mutated arrays so both views agree. Content-identical to the
          ;; builder's sequence when no param moved.
          [_param-extend : unit
            (match func
              [(ir.CompilerIrFunction.Function _ params _ _ _)
                (compiler-reg-param-intervals-extend-entry!
                  params
                  interval-index)])]
          [intervals : CompilerRegIntervalSeq
            (compiler-reg-interval-arrays-to-seq
              interval-index.starts
              interval-index.ends
              (- vars 1)
              (compiler-reg-interval-seq-empty))]
          [cold-split? : bool (>= forced-spill-from 0)]
          [base-ineligible : live.CompilerLiveI64Set
            (let
              [base : live.CompilerLiveI64Set
                (compiler-reg-ineligible-vars-non-params
                  type-segment-bases
                  func
                  type-info
                  target-abi)]
              (if cold-split?
                (compiler-reg-live-set-insert-range base forced-spill-from vars)
                base))]
          [param-plan : CompilerRegParamAssignPlan
            (compiler-reg-param-assign-plan
              type-segment-bases
              target-abi
              func
              interval-index
              base-ineligible
              vars
              cold-split?)]
          (match param-plan
            [(CompilerRegParamAssignPlan.Plan preassignments ineligible blocked)
              (let
                [_forced : unit
                  (compiler-reg-assignment-table-overlay!
                    preassignments
                    forced-assignments)]
                (compiler-reg-plan-from
                  type-segment-bases
                  func
                  liveness-handle
                  type-info
                  intervals
                  interval-index
                  preassignments
                  ineligible
                  blocked
                  true
                  false
                  target-abi
                  cold-split?
                  forced-spill-from))]))])))

(define (compiler-reg-plan-function-scalar-cold-with-type-segment-bases-for-abi-with-types
  [type-segment-bases : i64]
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [forced-spill-from : i64]
  [type-info : CompilerRegVarTypes]) : CompilerRegPlan
  (compiler-reg-plan-function-scalar-cold-with-type-segment-bases-for-abi-with-types-and-preassignments
    type-segment-bases
    target-abi
    func
    forced-spill-from
    type-info
    (compiler-reg-assignment-table-empty)))

(define (compiler-reg-plan-function-scalar-cold-for-abi-with-types
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]
  [forced-spill-from : i64]
  [type-info : CompilerRegVarTypes]) : CompilerRegPlan
  (compiler-reg-plan-function-scalar-cold-with-type-segment-bases-for-abi-with-types
    (ast.ast-node-pool-reader-type-segment-bases)
    target-abi
    func
    forced-spill-from
    type-info))

(define (compiler-reg-plan-function-scalar-for-abi
  [target-abi : cabi.CompilerRegTargetAbi]
  [func : ir.CompilerIrFunction]) : CompilerRegPlan
  (compiler-reg-plan-function-scalar-cold-for-abi target-abi func (- 0 1)))

(define (compiler-reg-plan-function-scalar [func : ir.CompilerIrFunction]) : CompilerRegPlan
  (compiler-reg-plan-function-scalar-for-abi
    cabi.CompilerRegTargetAbi.Linux
    func))

;; The cold-call carrier is the ABI boundary: it must never be colored into a
;; register or rematerialized, because the real call is deliberately absent
;; from the GP clobber mask.  Missing assignments are the backend's ordinary
;; stack-home representation and are therefore valid here.
(cfg
  (any test scavenge-self-check)
  (define (compiler-reg-cold-call-carriers-stack?
    [plan : CompilerRegPlan]
    [temp-start : i64]
    [vars : i64]) : bool
    (if (< temp-start 0)
      true
      (match plan
        [(CompilerRegPlan.Plan assignments _ _ _ _ _)
          (let
            [v : i64 temp-start]
            [ok : bool (< temp-start vars)]
            (begin
              (while (and ok (< v vars))
                (begin
                  (match (compiler-reg-assignment-lookup assignments v)
                    [(CompilerRegMaybeLocation.No) unit]
                    [(CompilerRegMaybeLocation.Some location)
                      (match location
                        [(CompilerRegLocation.Spill _) unit]
                        [_ (set! ok false)])])
                  (set! v (+ v 1))))
              ok))]))))

(define (compiler-reg-plan-function-stack-only [func : ir.CompilerIrFunction]) : CompilerRegPlan
  (let
    [type-info : CompilerRegVarTypes (compiler-reg-function-var-types func)]
    (CompilerRegPlan.Plan
      (compiler-reg-assignment-table-empty)
      (live.compiler-live-set-empty)
      (compiler-reg-interval-seq-empty)
      type-info
      (compiler-reg-call-split-empty)
      (compiler-reg-split-plan-empty))))

;; --- stack-slot compaction and storage coloring -----------------------------
;; One frame slot per raw IR variable wastes most of the frame once register
;; allocation has moved many values into registers. The scalar pass renumbers
;; stack-resident scalar variables into a dense frame-slot prefix after regalloc,
;; preserving parameter ids for the prologue spill contract. A second pass
;; colors contiguous inline-storage ranges, sharing those range slots when their
;; AddrOf/Gep-derived pointer lifetimes are disjoint. Variables that already
;; have a register home, dead raw-id holes, and register-only scratch pseudo-vars
;; receive free non-slot ids, and stack-homed register groups are remapped by
;; their word0 id; the backend places word1 in the matching second var-region.
;; Plans with no intervals (the stack-only opt0/opt1 path skips liveness) pass
;; through unchanged. The result's slot count replaces the raw var count in the
;; backend's frame layout.
(defenum CompilerRegColoring
  (None)
  (Remap (__tl_dyn-array i64) i64))

;; Per-var slot-colorability flags: only values the register allocator could
;; legally home in one 64-bit register (scalars and 8-byte handles) are known
;; to occupy exactly one frame slot. Anything else (vectors, masks, inline
;; groups, unknown) is skipped by the scalar interval walk and then receives a
;; private dense slot if it still needs stack storage.
(define (compiler-reg-color-flags
  [types : CompilerRegVarTypes]
  [flags : (__tl_dyn-array bool)]) : unit
  (let
    [present : (__tl_dyn-array i64) types.present]
    [items : (__tl_dyn-array ast.AstType) types.items]
    [index : i64 0]
    [limit : i64
      (if (< (array-length present) (array-length flags))
        (array-length present)
        (array-length flags))]
    (while (< index limit)
      (begin
        (if (= (array-ref present index) 0)
          unit
          (set!
            (array-ref flags index)
            (or
              (compiler-reg-scalar-type? (array-ref items index))
              (compiler-reg-handle-type? (array-ref items index)))))
        (set! index (+ index 1))))))

;; Mark every variable with a final liveness interval. Combined with direct IR
;; uses/defs below, this distinguishes real values (including dead emitted defs)
;; from gaps in the monotonic variable-id watermark.
(define (compiler-reg-color-reference-intervals!
  [intervals : CompilerRegIntervalSeq]
  [references : (__tl_dyn-array bool)]) : unit
  (let
    [index : i64 0]
    (while (< index (compiler-reg-interval-seq-count intervals))
      (begin
        (let
          [var : i64
            (__tl-project-field
              (compiler-reg-interval-seq-ref intervals index)
              var)]
          (if (and (>= var 0) (< var (array-length references)))
            (set! (array-ref references var) true)
            unit))
        (set! index (+ index 1))))))

;; Per-var AstType array for the coloring walk's same-type sharing guard.
;; Every colorable var has a types-list entry (compiler-reg-color-flags only
;; sets its flag from one), so the walk never reads an unwritten element.
(define (compiler-reg-color-var-tys
  [types : CompilerRegVarTypes]
  [tys : (__tl_dyn-array ast.AstType)]) : unit
  (let
    [present : (__tl_dyn-array i64) types.present]
    [items : (__tl_dyn-array ast.AstType) types.items]
    [index : i64 0]
    [limit : i64
      (if (< (array-length present) (array-length tys))
        (array-length present)
        (array-length tys))]
    (while (< index limit)
      (begin
        (if (= (array-ref present index) 0)
          unit
          (set! (array-ref tys index) (array-ref items index)))
        (set! index (+ index 1))))))

(define (compiler-reg-vector-elem-size [ty : ast.AstType]) : i64
  (match ty
    [(ast.AstType.I8) 1]
    [(ast.AstType.U8) 1]
    [(ast.AstType.Bool) 1]
    [(ast.AstType.I16) 2]
    [(ast.AstType.U16) 2]
    [(ast.AstType.I32) 4]
    [(ast.AstType.U32) 4]
    [(ast.AstType.F32) 4]
    [(ast.AstType.I64) 8]
    [(ast.AstType.U64) 8]
    [(ast.AstType.F64) 8]
    [_ 8]))

(define (compiler-reg-vector-stack-words-for-shape
  [lanes : i64]
  [elem-ty : ast.AstType]) : i64
  (let
    [bytes : i64 (* lanes (compiler-reg-vector-elem-size elem-ty))]
    (if (<= bytes 0)
      1
      (/ (+ bytes 7) 8))))

(define (compiler-reg-vector-stack-words-set!
  [words : (__tl_dyn-array i64)]
  [var : i64]
  [lanes : i64]
  [elem-ty : ast.AstType]) : unit
  (if (or (< var 0) (>= var (array-length words)))
    unit
    (let
      [next : i64 (compiler-reg-vector-stack-words-for-shape lanes elem-ty)]
      [old : i64 (array-ref words var)]
      (if (> next old)
        (set! (array-ref words var) next)
        unit))))

(define (compiler-reg-vector-stack-words-set-mask!
  [words : (__tl_dyn-array i64)]
  [var : i64]) : unit
  ;; AVX2 represents lane masks in a full YMM register. AVX-512 uses compact
  ;; k-register spills, but reserving the same four-word range is harmless and
  ;; keeps this target-neutral census conservative.
  (if (or (< var 0) (>= var (array-length words)))
    unit
    (let
      [old : i64 (array-ref words var)]
      (if (> old 3)
        unit
        (set! (array-ref words var) 4)))))

(define (compiler-reg-spmd-avx2-special-param? [name : String]) : bool
  (or
    (compiler-reg-string-prefix? name "__tl_spmd_active_mask_avx2")
    (compiler-reg-string-prefix? name "__tl_spmd_varying_arg_avx2_")
    (compiler-reg-string-prefix? name "__tl_spmd_mask_arg_avx2_")))

(define (compiler-reg-vector-stack-words-params!
  [params : ir.CompilerIrParamList]
  [words : (__tl_dyn-array i64)]) : unit
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) unit]
    [(ir.CompilerIrParamList.Array seq)
      (compiler-reg-vector-stack-words-params!
        (ir.compiler-ir-param-seq-to-list seq)
        words)]
    [(ir.CompilerIrParamList.Cons param rest)
      (begin
        (match param
          [(ir.CompilerIrParam.Param name _ var)
            (if (compiler-reg-spmd-avx2-special-param? name)
              (compiler-reg-vector-stack-words-set-mask! words var)
              unit)])
        (compiler-reg-vector-stack-words-params! (__tl-box-place rest) words))]))

(define (compiler-reg-spmd-avx2-special-param-references!
  [params : ir.CompilerIrParamList]
  [references : (__tl_dyn-array bool)]) : unit
  ;; The backend materializes every private ABI parameter before instruction
  ;; emission, including an active mask unused by the helper body. Keep those
  ;; prologue-only writes in the private-range allocation census.
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil) unit]
    [(ir.CompilerIrParamList.Array seq)
      (compiler-reg-spmd-avx2-special-param-references!
        (ir.compiler-ir-param-seq-to-list seq)
        references)]
    [(ir.CompilerIrParamList.Cons param rest)
      (begin
        (match param
          [(ir.CompilerIrParam.Param name _ var)
            (if (and
              (compiler-reg-spmd-avx2-special-param? name)
              (>= var 0)
              (< var (array-length references)))
              (set! (array-ref references var) true)
              unit)])
        (compiler-reg-spmd-avx2-special-param-references!
          (__tl-box-place rest)
          references))]))

(define (compiler-reg-vector-stack-words-instr!
  [instr : ir.CompilerIrInstr]
  [words : (__tl_dyn-array i64)]) : unit
  (match instr
    [(ir.CompilerIrInstr.LaneId dst lanes elem-ty)
      (compiler-reg-vector-stack-words-set! words dst lanes elem-ty)]
    [(ir.CompilerIrInstr.Splat dst _ lanes elem-ty)
      (compiler-reg-vector-stack-words-set! words dst lanes elem-ty)]
    [(ir.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [elem-ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (compiler-reg-vector-stack-words-set! words dst lanes elem-ty))]
    [(ir.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [elem-ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (compiler-reg-vector-stack-words-set! words dst lanes elem-ty))]
    [(ir.CompilerIrInstr.Select payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [elem-ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (if (= lanes 0)
          unit
          (match elem-ty
            [(ast.AstType.Bool)
              (compiler-reg-vector-stack-words-set-mask! words dst)]
            [_ (compiler-reg-vector-stack-words-set! words dst lanes elem-ty)])))]
    [(ir.CompilerIrInstr.VectorCompare payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        (compiler-reg-vector-stack-words-set-mask! words dst))]
    [(ir.CompilerIrInstr.MaskBinOp dst _ _ _ _)
      (compiler-reg-vector-stack-words-set-mask! words dst)]
    [(ir.CompilerIrInstr.MaskNot dst _ _)
      (compiler-reg-vector-stack-words-set-mask! words dst)]
    [(ir.CompilerIrInstr.TailMask dst _ _ _)
      (compiler-reg-vector-stack-words-set-mask! words dst)]
    [(ir.CompilerIrInstr.VectorLoad dst _ _ lanes elem-ty)
      (compiler-reg-vector-stack-words-set! words dst lanes elem-ty)]
    [(ir.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [elem-ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (match elem-ty
          [(ast.AstType.Bool)
            (compiler-reg-vector-stack-words-set-mask! words dst)]
          [_ (compiler-reg-vector-stack-words-set! words dst lanes elem-ty)]))]
    [(ir.CompilerIrInstr.GatherLoad payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [elem-ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (compiler-reg-vector-stack-words-set! words dst lanes elem-ty))]
    [(ir.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [dst (__tl-project-field (__tl-box-place payload-box) dst)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [elem-ty (__tl-project-field (__tl-box-place payload-box) ty)]
        (compiler-reg-vector-stack-words-set! words dst lanes elem-ty))]
    [(ir.CompilerIrInstr.SpmdCall payload-box)
      (let
        [backend (__tl-project-field (__tl-box-place payload-box) backend)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [result (__tl-project-field (__tl-box-place payload-box) result)]
        (match backend
          [(ir.CompilerIrSpmdBackend.Avx512)
            (match result
              [(ir.CompilerIrSpmdCallResult.Unit) unit]
              [(ir.CompilerIrSpmdCallResult.Value dst class elem-ty)
                (match class
                  [(ir.CompilerIrSpmdValueClass.Varying)
                    (compiler-reg-vector-stack-words-set!
                      words
                      dst
                      lanes
                      elem-ty)]
                  [_ unit])])]
          [(ir.CompilerIrSpmdBackend.Avx2)
            (match result
              [(ir.CompilerIrSpmdCallResult.Unit) unit]
              [(ir.CompilerIrSpmdCallResult.Value dst class elem-ty)
                (match class
                  [(ir.CompilerIrSpmdValueClass.Varying)
                    (compiler-reg-vector-stack-words-set!
                      words
                      dst
                      lanes
                      elem-ty)]
                  [(ir.CompilerIrSpmdValueClass.Mask)
                    (compiler-reg-vector-stack-words-set-mask! words dst)]
                  [_ unit])])]
          [_ unit]))]
    [_ unit]))

(define (compiler-reg-vector-stack-words-seq!
  [instrs : ir.CompilerIrInstrSeq]
  [words : (__tl_dyn-array i64)]) : unit
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (while (< index count)
      (begin
        (compiler-reg-vector-stack-words-instr! (array-ref slots index) words)
        (set! index (+ index 1))))))

(define (compiler-reg-vector-stack-words-blocks!
  [blocks : ir.CompilerIrBlockList]
  [words : (__tl_dyn-array i64)]) : unit
  (match blocks
    [(ir.CompilerIrBlockList.Nil) unit]
    [(ir.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(ir.CompilerIrBlock.Block _ instrs)
            (compiler-reg-vector-stack-words-seq! instrs words)])
        (compiler-reg-vector-stack-words-blocks! (__tl-box-place rest) words))]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [index : i64 0]
        (while (< index (ir.compiler-ir-block-seq-count seq))
          (begin
            (match (ir.compiler-ir-block-seq-ref seq index)
              [(ir.CompilerIrBlock.Block _ instrs)
                (compiler-reg-vector-stack-words-seq! instrs words)])
            (set! index (+ index 1)))))]))

(define (compiler-reg-vector-stack-extra-slots
  [words : (__tl_dyn-array i64)]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (array-length words))
    acc
    (let
      [w : i64 (array-ref words index)]
      (compiler-reg-vector-stack-extra-slots
        words
        (+ index 1)
        (if (> w 1)
          (+ acc (- w 1))
          acc)))))

(define (compiler-reg-vector-stack-words-for-var
  [words : (__tl_dyn-array i64)]
  [var : i64]) : i64
  (if (or (< var 0) (>= var (array-length words)))
    1
    (let
      [w : i64 (array-ref words var)]
      (if (> w 1)
        w
        1))))

(define (compiler-reg-color-reserve-private-range!
  [slot-ends : (__tl_dyn-array i64)]
  [next : i64]
  [words : i64]) : i64
  (let
    [size : i64
      (if (> words 1)
        words
        1)]
    [slot : i64 (compiler-reg-color-next-free-range slot-ends next size 0)]
    (begin
      (compiler-reg-color-set-range-ends!
        slot-ends
        slot
        size
        9223372036854775807)
      slot)))

;; Sorted insert by (start, var): deterministic processing order.
;; In-place heapsort of an interval array by (start, var) -- deterministic
;; total order, O(n log n), no allocation beyond the array itself (the
;; insertion-sort cons spine it replaces allocated O(n^2) cells, which blew
;; the scratch arena on ~7000-var functions).
(define (compiler-reg-color-interval-before?
  [a : CompilerRegInterval]
  [b : CompilerRegInterval]) : bool
  (let
    [a-start : i64 a.start]
    [b-start : i64 b.start]
    (or (< a-start b-start) (and (= a-start b-start) (< a.var b.var)))))

(define (compiler-reg-color-interval-copy [item : CompilerRegInterval]) : CompilerRegInterval
  (CompilerRegInterval item.var item.start item.end))

(define (compiler-reg-color-sift-down
  [items : (__tl_dyn-array CompilerRegInterval)]
  [root : i64]
  [count : i64]) : unit
  (let
    [node : i64 root]
    [done : bool false]
    (while (not done)
      (let
        [left : i64 (+ (* node 2) 1)]
        [right : i64 (+ (* node 2) 2)]
        [largest : i64
          (let
            [pick : i64 node]
            (begin
              (if (and
                (< left count)
                (compiler-reg-color-interval-before?
                  (array-ref items pick)
                  (array-ref items left)))
                (set! pick left)
                unit)
              (if (and
                (< right count)
                (compiler-reg-color-interval-before?
                  (array-ref items pick)
                  (array-ref items right)))
                (set! pick right)
                unit)
              pick))]
        (if (= largest node)
          (set! done true)
          (let
            [node-item : CompilerRegInterval
              (compiler-reg-color-interval-copy (array-ref items node))]
            [largest-item : CompilerRegInterval
              (compiler-reg-color-interval-copy (array-ref items largest))]
            (begin
              (set! (array-ref items node) largest-item)
              (set! (array-ref items largest) node-item)
              (set! node largest))))))))

(define (compiler-reg-color-heapsort
  [items : (__tl_dyn-array CompilerRegInterval)]
  [count : i64]) : unit
  (begin
    (let
      [i : i64 (- (/ count 2) 1)]
      (while (>= i 0)
        (begin
          (compiler-reg-color-sift-down items i count)
          (set! i (- i 1)))))
    (let
      [last : i64 (- count 1)]
      (while (> last 0)
        (let
          [root-item : CompilerRegInterval
            (compiler-reg-color-interval-copy (array-ref items 0))]
          [last-item : CompilerRegInterval
            (compiler-reg-color-interval-copy (array-ref items last))]
          (begin
            (set! (array-ref items 0) last-item)
            (set! (array-ref items last) root-item)
            (compiler-reg-color-sift-down items 0 last)
            (set! last (- last 1))))))))

;; Per-variable full lifetime end over all split live intervals. The scalar
;; coloring walk assigns each variable one remapped frame slot, so a slot must
;; stay busy until that variable's last interval ends, even if the interval
;; sequence has a hole before a later use. `count` bounds the live prefix of
;; `items` that compiler-reg-color-walk-interval-fill kept.
(define (compiler-reg-color-extent-ends
  [items : (__tl_dyn-array CompilerRegInterval)]
  [count : i64]
  [vars : i64]) : (__tl_dyn-array i64)
  (let
    [ends : (__tl_dyn-array i64) (array.make-array i64 vars)]
    [i : i64 0]
    (begin
      (while (< i vars)
        (begin
          (set! (array-ref ends i) (- 0 1))
          (set! i (+ i 1))))
      (set! i 0)
      (while (< i count)
        (let
          [interval : CompilerRegInterval (array-ref items i)]
          [var : i64 interval.var]
          [end : i64 interval.end]
          (begin
            (if (and (>= var 0) (< var vars) (> end (array-ref ends var)))
              (set! (array-ref ends var) end)
              unit)
            (set! i (+ i 1)))))
      ends)))

;; First slot id at or after `from` that is not identity-pinned to a
;; parameter (pins mark slot-ends with i64-max). Fresh slots fill the gaps a
;; sparse parameter id leaves behind, so slot ids never run past the pinned
;; band and the overall renumbering stays inside [0, vars).
(define (compiler-reg-color-next-free-slot
  [slot-ends : (__tl_dyn-array i64)]
  [from : i64]) : i64
  (if (>= from (array-length slot-ends))
    from
    (if (= (array-ref slot-ends from) 9223372036854775807)
      (compiler-reg-color-next-free-slot slot-ends (+ from 1))
      from)))

;; Lowest used slot whose previous occupant ended strictly before `start`.
;; STRICT `<`: phi parallel copies at a block edge read inputs and write
;; destinations at the same interval position, so same-position reuse would let
;; one phi's destination clobber another phi's not-yet-read input through the
;; slot. Parameter pins use i64-max in slot-ends and therefore never match.
;; SAME-TYPE only: sharing a slot MERGES the two variables' ids in the emitted
;; IR, and the rebuilt per-id type table keeps ONE type. The backend recovers
;; operand width/signedness/float-ness from that table (e.g.
;; compiler-backend-binop-operand-ty for bit ops), so merging an i64 with a
;; bool would emit `andb` for a 64-bit bit-and -- a real M-A2 bring-up
;; miscompile (compiler-live-set-minus-words). Only type-identical variables
;; may merge.
(define (compiler-reg-color-find-slot
  [type-segment-bases : i64]
  [slot-ends : (__tl_dyn-array i64)]
  [slot-tys : (__tl_dyn-array ast.AstType)]
  [ty : ast.AstType]
  [used : i64]
  [start : i64]
  [index : i64]) : i64
  (if (>= index used)
    used
    (if (and
      (< (array-ref slot-ends index) start)
      (ast.ast-type-eq-with-seg-bases?
        type-segment-bases
        (array-ref slot-tys index)
        ty))
      index
      (compiler-reg-color-find-slot
        type-segment-bases
        slot-ends
        slot-tys
        ty
        used
        start
        (+ index 1)))))

(define (compiler-reg-color-walk
  [type-segment-bases : i64]
  [items : (__tl_dyn-array CompilerRegInterval)]
  [count : i64]
  [index : i64]
  [assignment-index : CompilerRegAssignmentTable]
  [pinned : live.CompilerLiveI64Set]
  [ineligible : live.CompilerLiveI64Set]
  [colorable : (__tl_dyn-array bool)]
  [var-tys : (__tl_dyn-array ast.AstType)]
  [slot-ends : (__tl_dyn-array i64)]
  [slot-tys : (__tl_dyn-array ast.AstType)]
  [extent-ends : (__tl_dyn-array i64)]
  [used : i64]
  [remap : (__tl_dyn-array i64)]) : i64
  (if (>= index count)
    used
    (let
      [interval : CompilerRegInterval (array-ref items index)]
      [var : i64 interval.var]
      [start : i64 interval.start]
      [end : i64 interval.end]
      (if (or
        ;; Already renumbered: parameter identity pins (the prologue's
        ;; param spill targets the ORIGINAL id's formula slot, so a pinned
        ;; id must never be reassigned mid-walk) and split intervals (the
        ;; first interval wins; revisiting would leak the first slot).
        (>= (array-ref remap var) 0)
        (not (array-ref colorable var))
        (live.compiler-live-set-contains? pinned var)
        (live.compiler-live-set-contains? ineligible var)
        ;; Spilled scalars are re-homed by the id remap (the stale
        ;; assignment entry keyed by the old id is never queried);
        ;; register-homed values keep their ids and homes.
        (match (compiler-reg-assignment-table-lookup assignment-index var)
          [(CompilerRegMaybeLocation.Some location)
            (match location
              [(CompilerRegLocation.Spill _) false]
              [_ true])]
          [(CompilerRegMaybeLocation.No) false]))
        (compiler-reg-color-walk
          type-segment-bases
          items
          count
          (+ index 1)
          assignment-index
          pinned
          ineligible
          colorable
          var-tys
          slot-ends
          slot-tys
          extent-ends
          used
          remap)
        (let
          ;; Prefer the lowest SAME-TYPE scalar slot whose prior owner ended
          ;; before this variable starts. Otherwise take a fresh slot,
          ;; skipping param-pinned ids so sparse parameter ids leave no hole.
          [ty : ast.AstType (array-ref var-tys var)]
          [found : i64
            (compiler-reg-color-find-slot
              type-segment-bases
              slot-ends
              slot-tys
              ty
              used
              start
              0)]
          [slot : i64
            (if (>= found used)
              (compiler-reg-color-next-free-slot slot-ends used)
              found)]
          [next-used : i64
            (if (>= found used)
              (+ slot 1)
              used)]
          [full-end : i64 (compiler-reg-max end (array-ref extent-ends var))]
          (begin
            (set! (array-ref slot-ends slot) full-end)
            (if (< slot (array-length slot-tys))
              (set! (array-ref slot-tys slot) ty)
              unit)
            (set! (array-ref remap var) slot)
            (compiler-reg-color-walk
              type-segment-bases
              items
              count
              (+ index 1)
              assignment-index
              pinned
              ineligible
              colorable
              var-tys
              slot-ends
              slot-tys
              extent-ends
              next-used
              remap)))))))

(define (compiler-reg-color-fill-interval-bounds
  [intervals : CompilerRegIntervalSeq]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]) : unit
  (let
    [index : i64 0]
    (while (< index (compiler-reg-interval-seq-count intervals))
      (begin
        (let
          [interval : CompilerRegInterval
            (compiler-reg-interval-seq-ref intervals index)]
          [var : i64 interval.var]
          (if (and (>= var 0) (< var (array-length starts)))
            (begin
              (set! (array-ref starts var) interval.start)
              (set! (array-ref ends var) interval.end))
            unit))
        (set! index (+ index 1))))))

(define (compiler-reg-color-mark-storage-vars
  [range-of-var : (__tl_dyn-array i64)]
  [first : i64]
  [count : i64]
  [range-id : i64]) : unit
  (let
    [i : i64 0]
    (while (< i count)
      (begin
        (if (and (>= (+ first i) 0) (< (+ first i) (array-length range-of-var)))
          (set! (array-ref range-of-var (+ first i)) range-id)
          unit)
        (set! i (+ i 1))))))

(define (compiler-reg-color-detect-storage-seq
  [instrs : ir.CompilerIrInstrSeq]
  [range-of-var : (__tl_dyn-array i64)]
  [range-base : (__tl_dyn-array i64)]
  [range-size : (__tl_dyn-array i64)]
  [range-count : i64]) : i64
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [len : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [i : i64 0]
    [run-first : i64 (- 0 1)]
    [run-last : i64 (- 0 1)]
    [run-count : i64 0]
    [ranges : i64 range-count]
    (begin
      (while (< i len)
        (begin
          (match (array-ref slots i)
            [(ir.CompilerIrInstr.Alloc dst _)
              (if (or (= run-count 0) (= dst (+ run-last 1)))
                (begin
                  (if (= run-count 0)
                    (set! run-first dst)
                    unit)
                  (set! run-last dst)
                  (set! run-count (+ run-count 1)))
                (begin
                  (set! run-first dst)
                  (set! run-last dst)
                  (set! run-count 1)))]
            [(ir.CompilerIrInstr.AddrOf _ src)
              (begin
                (if (and
                  (> run-count 0)
                  (= src run-last)
                  (= run-first (+ (- src run-count) 1))
                  (< ranges (array-length range-base)))
                  (begin
                    (set! (array-ref range-base ranges) src)
                    (set! (array-ref range-size ranges) run-count)
                    (compiler-reg-color-mark-storage-vars
                      range-of-var
                      run-first
                      run-count
                      ranges)
                    (set! ranges (+ ranges 1)))
                  unit)
                (set! run-first (- 0 1))
                (set! run-last (- 0 1))
                (set! run-count 0))]
            [_
              (begin
                (set! run-first (- 0 1))
                (set! run-last (- 0 1))
                (set! run-count 0))])
          (set! i (+ i 1))))
      ranges)))

(define (compiler-reg-color-detect-storage-blocks
  [blocks : ir.CompilerIrBlockList]
  [range-of-var : (__tl_dyn-array i64)]
  [range-base : (__tl_dyn-array i64)]
  [range-size : (__tl_dyn-array i64)]
  [range-count : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) range-count]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-color-detect-storage-blocks
            (__tl-box-place rest)
            range-of-var
            range-base
            range-size
            (compiler-reg-color-detect-storage-seq
              instrs
              range-of-var
              range-base
              range-size
              range-count))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 range-count]
        (begin
          (while (< i (ir.compiler-ir-block-seq-count seq))
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set!
                    count
                    (compiler-reg-color-detect-storage-seq
                      instrs
                      range-of-var
                      range-base
                      range-size
                      count))])
              (set! i (+ i 1))))
          count))]))

(define (compiler-reg-color-value-root
  [roots : (__tl_dyn-array i64)]
  [value : ir.CompilerIrValue]) : i64
  (match value
    [(ir.CompilerIrValue.Var var)
      (if (and (>= var 0) (< var (array-length roots)))
        (array-ref roots var)
        (- 0 1))]
    [_ (- 0 1)]))

(define (compiler-reg-color-merge-root [acc : i64] [root : i64]) : i64
  (cond
    [(< root 0) (- 0 1)]
    [(< acc 0) root]
    [(= acc root) root]
    [else (- 0 2)]))

(define (compiler-reg-color-phi-root
  [roots : (__tl_dyn-array i64)]
  [inputs : ir.CompilerIrPhiInputList]
  [acc : i64]) : i64
  (match (ir.compiler-ir-phi-input-list-force-cons inputs)
    [(ir.CompilerIrPhiInputList.Nil) acc]
    [(ir.CompilerIrPhiInputList.Array seq)
      (compiler-reg-color-phi-root
        roots
        (ir.compiler-ir-phi-input-seq-to-list seq)
        acc)]
    [(ir.CompilerIrPhiInputList.Cons value _ rest)
      (let
        [next : i64
          (compiler-reg-color-merge-root
            acc
            (compiler-reg-color-value-root roots value))]
        (if (= next (- 0 1))
          (- 0 1)
          (if (= next (- 0 2))
            (- 0 2)
            (compiler-reg-color-phi-root roots (__tl-box-place rest) next))))]))

(define (compiler-reg-color-set-root!
  [roots : (__tl_dyn-array i64)]
  [invalid : (__tl_dyn-array bool)]
  [dst : i64]
  [root : i64]) : bool
  (if (or (< root 0) (< dst 0) (>= dst (array-length roots)))
    false
    (let
      [old : i64 (array-ref roots dst)]
      (if (= old root)
        false
        (if (< old 0)
          (begin
            (set! (array-ref roots dst) root)
            true)
          (begin
            (if (< old (array-length invalid))
              (set! (array-ref invalid old) true)
              unit)
            (if (< root (array-length invalid))
              (set! (array-ref invalid root) true)
              unit)
            (set! (array-ref roots dst) (- 0 2))
            true))))))

;; Result code of one propagation attempt. Bit 0 says the instruction is one of
;; the forms that can ever set a root, so later rounds must revisit it; bit 1
;; says this attempt actually wrote `roots`/`invalid`.
(define (compiler-reg-color-propagate-root-code [changed : bool]) : i64
  (if changed
    3
    1))

(define (compiler-reg-color-propagate-root-instr
  [instr : ir.CompilerIrInstr]
  [range-of-var : (__tl_dyn-array i64)]
  [roots : (__tl_dyn-array i64)]
  [invalid : (__tl_dyn-array bool)]) : i64
  (match instr
    [(ir.CompilerIrInstr.AddrOf dst src)
      (compiler-reg-color-propagate-root-code
        (if (and (>= src 0) (< src (array-length range-of-var)))
          (compiler-reg-color-set-root!
            roots
            invalid
            dst
            (array-ref range-of-var src))
          false))]
    [(ir.CompilerIrInstr.Gep dst base _ _)
      (compiler-reg-color-propagate-root-code
        (compiler-reg-color-set-root!
          roots
          invalid
          dst
          (compiler-reg-color-value-root roots base)))]
    [(ir.CompilerIrInstr.Mov dst value _)
      (compiler-reg-color-propagate-root-code
        (compiler-reg-color-set-root!
          roots
          invalid
          dst
          (compiler-reg-color-value-root roots value)))]
    [(ir.CompilerIrInstr.Phi dst inputs _)
      (compiler-reg-color-propagate-root-code
        (compiler-reg-color-set-root!
          roots
          invalid
          dst
          (compiler-reg-color-phi-root roots inputs (- 0 1))))]
    [(ir.CompilerIrInstr.Select payload-box)
      (compiler-reg-color-propagate-root-code
        (let
          [dst (__tl-project-field (__tl-box-place payload-box) dst)]
          [true-value (__tl-project-field (__tl-box-place payload-box) on-true)]
          [false-value
            (__tl-project-field (__tl-box-place payload-box) on-false)]
          [left : i64 (compiler-reg-color-value-root roots true-value)]
          [right : i64 (compiler-reg-color-value-root roots false-value)]
          (if (>= right 0)
            (compiler-reg-color-set-root! roots invalid dst right)
            (if (and (>= left 0) (= left right))
              (compiler-reg-color-set-root! roots invalid dst left)
              false))))]
    [_ 0]))

;; One block's share of the FIRST propagation round.
;;
;; `cursor` carries the walk's position across blocks: slot 0 is the ordinal of
;; this block's first instruction and slot 1 is the write position in
;; `candidates`.
;;
;; The FIRST round visits every instruction and records, in `candidates`, the
;; function-wide ordinal of each one whose form can set a root. Later rounds
;; replay only those, through compiler-reg-color-propagate-root-replay below. An
;; instruction the first round did not record is one that fell through to the
;; `_` arm above -- it reads nothing and writes nothing on any input, so
;; replaying it can only return "no change". Skipping it therefore leaves the
;; sequence of writes, and so the fixpoint, exactly as it was.
(define (compiler-reg-color-propagate-root-seq
  [instrs : ir.CompilerIrInstrSeq]
  [range-of-var : (__tl_dyn-array i64)]
  [roots : (__tl_dyn-array i64)]
  [invalid : (__tl_dyn-array bool)]
  [candidates : (__tl_dyn-array i64)]
  [cursor : (__tl_dyn-array i64)]) : bool
  (let
    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
    [len : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [base : i64 (array-ref cursor 0)]
    [at : i64 (array-ref cursor 1)]
    [changed : bool false]
    [i : i64 0]
    (begin
      (while (< i len)
        (let
          [code : i64
            (compiler-reg-color-propagate-root-instr
              (array-ref slots i)
              range-of-var
              roots
              invalid)]
          (begin
            (if (= (bit-and code 2) 0)
              unit
              (set! changed true))
            (if (= (bit-and code 1) 0)
              unit
              (begin
                (set! (array-ref candidates at) (+ base i))
                (set! at (+ at 1))))
            (set! i (+ i 1)))))
      (set! (array-ref cursor 1) at)
      (set! (array-ref cursor 0) (+ base len))
      changed)))

(define (compiler-reg-color-propagate-root-blocks
  [blocks : ir.CompilerIrBlockList]
  [range-of-var : (__tl_dyn-array i64)]
  [roots : (__tl_dyn-array i64)]
  [invalid : (__tl_dyn-array bool)]
  [candidates : (__tl_dyn-array i64)]
  [cursor : (__tl_dyn-array i64)]) : bool
  (match blocks
    [(ir.CompilerIrBlockList.Nil) false]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (let
            [head : bool
              (compiler-reg-color-propagate-root-seq
                instrs
                range-of-var
                roots
                invalid
                candidates
                cursor)]
            [tail : bool
              (compiler-reg-color-propagate-root-blocks
                (__tl-box-place rest)
                range-of-var
                roots
                invalid
                candidates
                cursor)]
            (or head tail))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [changed : bool false]
        (begin
          (while (< i (ir.compiler-ir-block-seq-count seq))
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (if (compiler-reg-color-propagate-root-seq
                    instrs
                    range-of-var
                    roots
                    invalid
                    candidates
                    cursor)
                    (set! changed true)
                    unit)])
              (set! i (+ i 1))))
          changed))]))

;; Rounds two and up.
;;
;; `candidates[0, count)` holds, in block order, the function-wide ordinal of
;; every instruction the first round recorded. The ordinals are strictly
;; increasing and each block's share is one contiguous run, so a single pass
;; over the block list -- with `base` tracking the ordinal of the current
;; block's first instruction -- reaches exactly those instructions, in exactly
;; the order the per-block routine above reached them, and touches nothing else.
;; The sequence of compiler-reg-color-propagate-root-instr calls, and so the
;; sequence of writes to `roots`/`invalid`, is therefore identical to replaying
;; through that routine; only the walk that delivers them is different.
;;
;; The walk is spelled iteratively with the per-block body inline in both list
;; shapes. That is the whole point of the split: a later round pays no call per
;; block, no `cursor` round-trip, and no collect/replay branch -- it keeps
;; `base` and the `candidates` position in registers across the entire round.
;;
;; Two details keep the inner loop to one compare and one add of bookkeeping.
;; `ord` carries `candidates[at]` across the whole round, refilled with
;; `max-ordinal` once the list is exhausted; since every `limit` is a sum of
;; instruction counts it is far below that sentinel, so `(< ord limit)` decides
;; the block window and the end of the list in a single test, and the ordinal is
;; read once instead of once per guard and once per body. `changed-bits`
;; accumulates the result codes with `bit-or` instead of branching per
;; instruction: bit 1 of the accumulated word is set exactly when some attempt
;; set it, which is the same disjunction the per-block flag computed.
(define (compiler-reg-color-propagate-root-replay
  [blocks : ir.CompilerIrBlockList]
  [range-of-var : (__tl_dyn-array i64)]
  [roots : (__tl_dyn-array i64)]
  [invalid : (__tl_dyn-array bool)]
  [candidates : (__tl_dyn-array i64)]
  [count : i64]) : bool
  (let
    [max-ordinal : i64 9223372036854775807]
    [cur : ir.CompilerIrBlockList blocks]
    [at : i64 0]
    [ord : i64
      (if (< 0 count)
        (array-ref candidates 0)
        max-ordinal)]
    [base : i64 0]
    [changed-bits : i64 0]
    [done : bool false]
    (begin
      (while (not done)
        (match cur
          [(ir.CompilerIrBlockList.Nil) (set! done true)]
          [(ir.CompilerIrBlockList.Cons block rest)
            (begin
              (match block
                [(ir.CompilerIrBlock.Block _ instrs)
                  (let
                    [slots : (__tl_dyn-array ir.CompilerIrInstr) instrs.slots]
                    [limit : i64
                      (+ base (ir.compiler-ir-instr-seq-count instrs))]
                    (begin
                      (while (< ord limit)
                        (begin
                          (set!
                            changed-bits
                            (bit-or
                              changed-bits
                              (compiler-reg-color-propagate-root-instr
                                (array-ref slots (- ord base))
                                range-of-var
                                roots
                                invalid)))
                          (set! at (+ at 1))
                          (set!
                            ord
                            (if (< at count)
                              (array-ref candidates at)
                              max-ordinal))))
                      (set! base limit)))])
              (set! cur (__tl-box-place rest)))]
          [(ir.CompilerIrBlockList.Array seq)
            (let
              [i : i64 0]
              [n : i64 (ir.compiler-ir-block-seq-count seq)]
              (begin
                (while (< i n)
                  (begin
                    (match (ir.compiler-ir-block-seq-ref seq i)
                      [(ir.CompilerIrBlock.Block _ instrs)
                        (let
                          [slots : (__tl_dyn-array ir.CompilerIrInstr)
                            instrs.slots]
                          [limit : i64
                            (+ base (ir.compiler-ir-instr-seq-count instrs))]
                          (begin
                            (while (< ord limit)
                              (begin
                                (set!
                                  changed-bits
                                  (bit-or
                                    changed-bits
                                    (compiler-reg-color-propagate-root-instr
                                      (array-ref slots (- ord base))
                                      range-of-var
                                      roots
                                      invalid)))
                                (set! at (+ at 1))
                                (set!
                                  ord
                                  (if (< at count)
                                    (array-ref candidates at)
                                    max-ordinal))))
                            (set! base limit)))])
                    (set! i (+ i 1))))
                (set! done true)))]))
      (not (= (bit-and changed-bits 2) 0)))))

;; Total instruction count over the block list, from the per-sequence lengths
;; only -- it never touches an instruction.
(define (compiler-reg-color-instr-total
  [blocks : ir.CompilerIrBlockList]
  [total : i64]) : i64
  (match blocks
    [(ir.CompilerIrBlockList.Nil) total]
    [(ir.CompilerIrBlockList.Cons block rest)
      (match block
        [(ir.CompilerIrBlock.Block _ instrs)
          (compiler-reg-color-instr-total
            (__tl-box-place rest)
            (+ total (ir.compiler-ir-instr-seq-count instrs)))])]
    [(ir.CompilerIrBlockList.Array seq)
      (let
        [i : i64 0]
        [count : i64 total]
        (begin
          (while (< i (ir.compiler-ir-block-seq-count seq))
            (begin
              (match (ir.compiler-ir-block-seq-ref seq i)
                [(ir.CompilerIrBlock.Block _ instrs)
                  (set! count (+ count (ir.compiler-ir-instr-seq-count instrs)))])
              (set! i (+ i 1))))
          count))]))

(define (compiler-reg-color-propagate-roots
  [blocks : ir.CompilerIrBlockList]
  [range-of-var : (__tl_dyn-array i64)]
  [roots : (__tl_dyn-array i64)]
  [invalid : (__tl_dyn-array bool)]) : unit
  (let
    [limit : i64 (array-length roots)]
    ;; `limit` is the round cap the loop below already enforced; at zero the
    ;; original loop ran no round at all, so nothing is collected either.
    (if (< limit 1)
      unit
      (let
        [candidates : (__tl_dyn-array i64)
          (array.make-array i64 (compiler-reg-color-instr-total blocks 0))]
        [cursor : (__tl_dyn-array i64) (array.make-array i64 2)]
        [changed : bool
          (compiler-reg-color-propagate-root-blocks
            blocks
            range-of-var
            roots
            invalid
            candidates
            cursor)]
        [count : i64 (array-ref cursor 1)]
        [rounds : i64 1]
        (while (and changed (< rounds limit))
          (begin
            (set!
              changed
              (compiler-reg-color-propagate-root-replay
                blocks
                range-of-var
                roots
                invalid
