(define (compiler-reg-indirect-call-arg4-function) : CompilerIrFunction
  (let
    [args : (Array CompilerIrValue) (array.make-array CompilerIrValue 4)]
    (begin
      (array-set! args 0 (CompilerIrValue.Var 1))
