(cfg
  test
  (define (compiler-reg-call-span-census-ok?) : bool
    (let
      [zero-census : CompilerRegCallSpanCensus
        (compiler-reg-plan-call-span-census
          (compiler-reg-overlap-function)
          (compiler-reg-plan-function-scalar (compiler-reg-overlap-function)))]
      [one-census : CompilerRegCallSpanCensus
        (compiler-reg-plan-call-span-census
          (compiler-reg-call-live-function)
          (compiler-reg-plan-function-scalar (compiler-reg-call-live-function)))]
      [many-census : CompilerRegCallSpanCensus
        (compiler-reg-plan-call-span-census
          (compiler-reg-many-call-live-function)
          (compiler-reg-plan-function-scalar
            (compiler-reg-many-call-live-function)))]
      (and
        (compiler-reg-call-span-census-count?
          zero-census
          0
          (compiler-reg-call-span-outcome-register)
          7)
        (compiler-reg-call-span-census-count?
          zero-census
          0
          (compiler-reg-call-span-outcome-spill)
          0)
        (compiler-reg-call-span-census-count?
          one-census
          1
          (compiler-reg-call-span-outcome-register)
          1)
        (compiler-reg-call-span-census-count?
          one-census
          0
          (compiler-reg-call-span-outcome-register)
          1)
        (compiler-reg-call-span-census-count?
          many-census
          3
          (compiler-reg-call-span-outcome-register)
          1)
        (compiler-reg-call-span-census-count?
          many-census
          0
          (compiler-reg-call-span-outcome-register)
          1)))))

(define (compiler-reg-same-location?
  [assignments : CompilerRegAssignmentList]
  [left : i64]
  [right : i64]) : bool
  (match (compiler-reg-assignment-lookup assignments left)
    [(CompilerRegMaybeLocation.Some left-location)
      (match (compiler-reg-assignment-lookup assignments right)
        [(CompilerRegMaybeLocation.Some right-location)
          (compiler-reg-location-eq? left-location right-location)]
        [(CompilerRegMaybeLocation.No) false])]
    [(CompilerRegMaybeLocation.No) false]))

(define (compiler-reg-different-location?
  [assignments : CompilerRegAssignmentList]
  [left : i64]
  [right : i64]) : bool
  (match (compiler-reg-assignment-lookup assignments left)
    [(CompilerRegMaybeLocation.Some left-location)
      (match (compiler-reg-assignment-lookup assignments right)
        [(CompilerRegMaybeLocation.Some right-location)
          (not (compiler-reg-location-eq? left-location right-location))]
        [(CompilerRegMaybeLocation.No) false])]
    [(CompilerRegMaybeLocation.No) false]))

(define (compiler-reg-indexed-lookups-ok?) : bool
  (let
    [assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-insert
        (compiler-reg-assignment-insert
          (compiler-reg-assignment-insert
            CompilerRegAssignmentList.Nil
            1
            (CompilerRegLocation.Register "%r12"))
          4
          (CompilerRegLocation.RegisterPair "%r13" "%r14"))
        3
        (CompilerRegLocation.Spill 24))]
    [intervals : CompilerRegIntervalList
      (compiler-reg-interval-cons
        (CompilerRegInterval.Interval 1 2 5)
        (compiler-reg-interval-cons
          (CompilerRegInterval.Interval 3 5 9)
          (compiler-reg-interval-cons
            (CompilerRegInterval.Interval 4 1 4)
            (compiler-reg-interval-cons
              (CompilerRegInterval.Interval 4 8 10)
              CompilerRegIntervalList.Nil))))]
    [assignment-index : CompilerRegAssignmentIndex
      (compiler-reg-assignment-index-build assignments 5)]
    [assignment-table : CompilerRegAssignmentTable
      (compiler-reg-assignment-table-insert
        (compiler-reg-assignment-table-insert
          (compiler-reg-assignment-table-insert
            (compiler-reg-assignment-table-make 5)
            1
            (CompilerRegLocation.Register "%r12"))
          4
          (CompilerRegLocation.RegisterPair "%r13" "%r14"))
        3
        (CompilerRegLocation.Spill 24))]
    [assignment-table-list : CompilerRegAssignmentList
      (compiler-reg-assignment-table-to-list assignment-table)]
    [interval-index : CompilerRegIntervalIndex
      (compiler-reg-interval-index-build intervals 5)]
    [starts : (Array i64) (struct-get interval-index starts)]
    [ends : (Array i64) (struct-get interval-index ends)]
    [assignment-hit-ok : bool
      (match (compiler-reg-assignment-index-lookup assignment-index 1)
        [(CompilerRegMaybeLocation.Some location)
          (compiler-reg-location-eq?
            location
            (CompilerRegLocation.Register "%r12"))]
        [(CompilerRegMaybeLocation.No) false])]
    [assignment-miss-ok : bool
      (match (compiler-reg-assignment-index-lookup assignment-index 2)
        [(CompilerRegMaybeLocation.Some _) false]
        [(CompilerRegMaybeLocation.No) true])]
    [assignment-oob-ok : bool
      (match (compiler-reg-assignment-index-lookup assignment-index -1)
        [(CompilerRegMaybeLocation.Some _) false]
        [(CompilerRegMaybeLocation.No) true])]
    [table-hit-ok : bool
      (match (compiler-reg-assignment-table-lookup assignment-table 1)
        [(CompilerRegMaybeLocation.Some location)
          (compiler-reg-location-eq?
            location
            (CompilerRegLocation.Register "%r12"))]
        [(CompilerRegMaybeLocation.No) false])]
    [table-miss-ok : bool
      (match (compiler-reg-assignment-table-lookup assignment-table 2)
        [(CompilerRegMaybeLocation.Some _) false]
        [(CompilerRegMaybeLocation.No) true])]
    [table-oob-ok : bool
      (match (compiler-reg-assignment-table-lookup assignment-table -1)
        [(CompilerRegMaybeLocation.Some _) false]
        [(CompilerRegMaybeLocation.No) true])]
    [table-list-ok : bool
      (and
        (compiler-reg-location-register?
          (compiler-reg-assignment-lookup assignment-table-list 1)
          "%r12")
        (compiler-reg-location-eq?
          (match (compiler-reg-assignment-lookup assignment-table-list 3)
            [(CompilerRegMaybeLocation.Some location) location]
            [(CompilerRegMaybeLocation.No) (CompilerRegLocation.Spill -1)])
          (CompilerRegLocation.Spill 24)))]
    [interval-hit-ok : bool
      (match (compiler-reg-interval-index-lookup interval-index 3)
        [(CompilerRegMaybeInterval.Some interval)
          (match interval
            [(CompilerRegInterval.Interval var start end)
              (and (= var 3) (= start 5) (= end 9))])]
        [(CompilerRegMaybeInterval.No) false])]
    [interval-miss-ok : bool
      (match (compiler-reg-interval-index-lookup interval-index 2)
        [(CompilerRegMaybeInterval.Some _) false]
        [(CompilerRegMaybeInterval.No) true])]
    [interval-first-ok : bool
      (match (compiler-reg-interval-index-lookup interval-index 4)
        [(CompilerRegMaybeInterval.Some interval)
          (match interval
            [(CompilerRegInterval.Interval var start end)
              (and (= var 4) (= start 1) (= end 4))])]
        [(CompilerRegMaybeInterval.No) false])]
    [interference-ok : bool
      (and
        (not (compiler-reg-vars-interfere-index? interval-index 1 3))
        (compiler-reg-vars-interfere-index? interval-index 1 2))]
    [conflict-ok : bool
      (and
        (not
          (compiler-reg-location-conflicts?
            assignments
            interval-index
            3
            -1
            (CompilerRegLocation.Register "%r12")))
        (compiler-reg-location-conflicts?
          assignments
          interval-index
          2
          -1
          (CompilerRegLocation.Register "%r12")))]
    [table-conflict-ok : bool
      (and
        (not
          (compiler-reg-assignment-table-location-conflicts?
            assignment-table
            interval-index
            3
            -1
            (CompilerRegLocation.Register "%r12")))
        (compiler-reg-assignment-table-location-conflicts?
          assignment-table
          interval-index
          2
          -1
          (CompilerRegLocation.Register "%r12")))]
    [shared-query-ok : bool
      (and
        (compiler-reg-location-uses-register?
          (CompilerRegLocation.RegisterPair "%r13" "%r14")
          "%r14")
        (not
          (compiler-reg-location-uses-register?
            (CompilerRegLocation.RegisterPair "%r13" "%r14")
            "%r15"))
        (compiler-reg-assignment-index-var-uses-register?
          assignment-index
          1
          "%r12")
        (compiler-reg-assignment-index-var-uses-register?
          assignment-index
          4
          "%r14")
        (string.eq
          (compiler-reg-assignment-index-primary-register-home
            assignment-index
            4)
          "%r13")
        (compiler-reg-assignments-use-register? assignments "%r14")
        (not (compiler-reg-assignments-use-register? assignments "%r15"))
        (compiler-reg-var-live-at-point? starts ends 1 3)
        (not (compiler-reg-var-live-at-point? starts ends 1 6))
        (compiler-reg-var-live-over-range? starts ends 1 5 7)
        (not (compiler-reg-var-live-over-range? starts ends 1 6 7))
        (not
          (compiler-reg-assignment-index-register-free-at-point?
            starts
            ends
            assignment-index
            5
            3
            "%r12"))
        (compiler-reg-assignment-index-register-free-at-point?
          starts
          ends
          assignment-index
          5
          6
          "%r12")
        (not
          (compiler-reg-assignment-index-register-free-over-range?
            starts
            ends
            assignment-index
            5
            3
            4
            "%r14"))
        (compiler-reg-assignment-index-register-free-over-range?
          starts
          ends
          assignment-index
          5
          0
          0
          "%r12"))]
    (and
      assignment-hit-ok
      assignment-miss-ok
      assignment-oob-ok
      table-hit-ok
      table-miss-ok
      table-oob-ok
      table-list-ok
      interval-hit-ok
      interval-miss-ok
      interval-first-ok
      interference-ok
      conflict-ok
      table-conflict-ok
      shared-query-ok)))

(define (compiler-reg-segmented-interference-ok?) : bool
  (let
    [starts : (Array i64) (array.make-array i64 5)]
    [ends : (Array i64) (array.make-array i64 5)]
    [segments : (Array CompilerRegIntervalList)
      (array.make-array CompilerRegIntervalList 5)]
    [segment-index : CompilerRegIntervalIndex
      (CompilerRegIntervalIndex starts ends segments)]
    (begin
      (compiler-reg-fill-i64-array starts -1)
      (compiler-reg-fill-i64-array ends -1)
      (array-set! starts 0 0)
      (array-set! ends 0 8)
      (array-set! starts 1 0)
      (array-set! ends 1 8)
      (array-set! starts 3 3)
      (array-set! ends 3 5)
      (array-set! starts 4 7)
      (array-set! ends 4 9)
      (array-set!
        segments
        1
        (compiler-reg-interval-cons
          (CompilerRegInterval.Interval 1 0 2)
          (compiler-reg-interval-cons
            (CompilerRegInterval.Interval 1 6 8)
            CompilerRegIntervalList.Nil)))
      (array-set!
        segments
        3
        (compiler-reg-interval-cons
          (CompilerRegInterval.Interval 3 3 5)
          CompilerRegIntervalList.Nil))
      (array-set!
        segments
        4
        (compiler-reg-interval-cons
          (CompilerRegInterval.Interval 4 7 9)
          CompilerRegIntervalList.Nil))
      (and
        (not (compiler-reg-vars-interfere-segmented-index? segment-index 1 3))
        (compiler-reg-vars-interfere-segmented-index? segment-index 1 4)
        (compiler-reg-vars-interfere-segmented-index? segment-index 0 3)
        (compiler-reg-vars-interfere-segmented-index? segment-index 1 2)))))

(define (compiler-reg-hole-aware-register-reuse-ok?) : bool
  (let
    [starts : (Array i64) (array.make-array i64 5)]
    [ends : (Array i64) (array.make-array i64 5)]
    [segments : (Array CompilerRegIntervalList)
      (array.make-array CompilerRegIntervalList 5)]
    [segment-index : CompilerRegIntervalIndex
      (CompilerRegIntervalIndex starts ends segments)]
    [one-reg : CompilerRegStringList
      (compiler-reg-string-cons "%r12" CompilerRegStringList.Nil)]
    [active-root : CompilerRegActiveList
      (compiler-reg-active-cons
        (CompilerRegActive.Active 0 10 "%r12")
        CompilerRegActiveList.Nil)]
    [active-ordinary : CompilerRegActiveList
      (compiler-reg-active-cons
        (CompilerRegActive.Active 1 10 "%r12")
        CompilerRegActiveList.Nil)]
    [hole-aware : CompilerLiveI64Set (compiler-live-set3 0 2 3)]
    [parents : (Array i64) (array.make-array i64 5)]
    (begin
      (compiler-reg-fill-i64-array starts -1)
      (compiler-reg-fill-i64-array ends -1)
      (array-set! starts 0 0)
      (array-set! ends 0 10)
      (array-set! starts 1 4)
      (array-set! ends 1 6)
      (array-set! starts 2 4)
      (array-set! ends 2 6)
      (array-set! starts 3 1)
      (array-set! ends 3 3)
      (array-set! starts 4 8)
      (array-set! ends 4 9)
      (array-set!
        segments
        0
        (compiler-reg-interval-cons
          (CompilerRegInterval.Interval 0 0 2)
          CompilerRegIntervalList.Nil))
      (array-set!
        segments
        1
        (compiler-reg-interval-cons
          (CompilerRegInterval.Interval 1 4 6)
          CompilerRegIntervalList.Nil))
      (array-set!
        segments
        2
        (compiler-reg-interval-cons
          (CompilerRegInterval.Interval 2 4 6)
          CompilerRegIntervalList.Nil))
      (array-set!
        segments
        3
        (compiler-reg-interval-cons
          (CompilerRegInterval.Interval 3 1 3)
          CompilerRegIntervalList.Nil))
      (array-set!
        segments
        4
        (compiler-reg-interval-cons
          (CompilerRegInterval.Interval 4 8 9)
          CompilerRegIntervalList.Nil))
      (array-set! parents 0 0)
      (array-set! parents 1 0)
      (array-set! parents 2 2)
      (array-set! parents 3 2)
      (array-set! parents 4 4)
      (let
        ;; General hole-filling: the allocator runs on the merged-root
        ;; index, whose per-candidate segments are COMPLETE -- a singleton carries
        ;; its own live range, a class root the union of its members'. Every
        ;; segment hole is therefore genuine deadness, so ANY value may reuse an
        ;; active register in a hole whose segments are disjoint, regardless of
        ;; whether it is a coalesce root or a singleton. var 1's segment [4,6] is
        ;; disjoint from the active root var 0's [0,2], so it reuses %r12.
        [var1-disjoint-reuses : bool
          (match (compiler-reg-first-free-register-holes
            one-reg
            active-root
            segment-index
            1
            hole-aware)
            [(CompilerRegMaybeString.Some reg) (string.eq reg "%r12")]
            [(CompilerRegMaybeString.No) false])]
        [root-hole-reuses : bool
          (match (compiler-reg-first-free-register-holes
            one-reg
            active-root
            segment-index
            2
            hole-aware)
            [(CompilerRegMaybeString.Some reg) (string.eq reg "%r12")]
            [(CompilerRegMaybeString.No) false])]
        ;; overlap still conflicts: var 3's segment [1,3] overlaps var 0's [0,2].
        [root-overlap-conflicts : bool
          (match (compiler-reg-first-free-register-holes
            one-reg
            active-root
            segment-index
            3
            hole-aware)
            [(CompilerRegMaybeString.No) true]
            [(CompilerRegMaybeString.Some _) false])]
        ;; var 4's [8,9] is disjoint from the active ordinary var 1's [4,6].
        [var4-disjoint-reuses : bool
          (match (compiler-reg-first-free-register-holes
            one-reg
            active-ordinary
            segment-index
            4
            hole-aware)
            [(CompilerRegMaybeString.Some reg) (string.eq reg "%r12")]
            [(CompilerRegMaybeString.No) false])]
        [roots : CompilerLiveI64Set
          (compiler-reg-coalesce-merged-root-set
            (CompilerRegCoalesceMap parents))]
        [mapped-blocked : CompilerLiveI64Set
          (compiler-reg-coalesce-root-set-from-vars
            (CompilerRegCoalesceMap parents)
            (compiler-live-set2 1 4))]
        (and
          var1-disjoint-reuses
          root-hole-reuses
          root-overlap-conflicts
          var4-disjoint-reuses
          (compiler-live-set-contains? roots 0)
          (compiler-live-set-contains? roots 2)
          (not (compiler-live-set-contains? roots 1))
          (not (compiler-live-set-contains? roots 3))
          (not (compiler-live-set-contains? roots 4))
          (compiler-live-set-contains? mapped-blocked 0)
          (compiler-live-set-contains? mapped-blocked 4)
          (not (compiler-live-set-contains? mapped-blocked 1))
          (not (compiler-live-set-contains? mapped-blocked 2))
          (not (compiler-live-set-contains? mapped-blocked 3)))))))

(define (compiler-reg-coalesce-test-i64-types [vars : i64]) : CompilerRegVarTypes
  (let
    [present : (Array i64) (array.make-array i64 vars)]
    [types : (Array AstType) (array.make-array AstType vars)]
    [index : i64 0]
    (begin
      (compiler-reg-fill-i64-array present 0)
      (while (< index vars)
        (begin
          (array-set! present index 1)
          (array-set! types index (compiler-reg-i64-ty))
          (set! index (+ index 1))))
      (CompilerRegVarTypes
        (compiler-reg-var-type-arrays-to-list
          present
          types
          (- vars 1)
          CompilerRegVarTypeList.Nil)
        present
        types))))

(define (compiler-reg-coalesce-test-flat-index) : CompilerRegIntervalIndex
  (compiler-reg-interval-index-build
    (compiler-reg-interval-cons
      (CompilerRegInterval.Interval 0 0 1)
      (compiler-reg-interval-cons
        (CompilerRegInterval.Interval 1 4 5)
        (compiler-reg-interval-cons
          (CompilerRegInterval.Interval 2 2 3)
          CompilerRegIntervalList.Nil)))
    3))

(define (compiler-reg-coalesce-test-overlap-index) : CompilerRegIntervalIndex
  (compiler-reg-interval-index-build
    (compiler-reg-interval-cons
      (CompilerRegInterval.Interval 0 0 5)
      (compiler-reg-interval-cons
        (CompilerRegInterval.Interval 1 2 6)
        CompilerRegIntervalList.Nil))
    2))

(define (compiler-reg-coalesce-test-segment-index) : CompilerRegIntervalIndex
  (let
    [starts : (Array i64) (array.make-array i64 2)]
    [ends : (Array i64) (array.make-array i64 2)]
    [segments : (Array CompilerRegIntervalList)
      (array.make-array CompilerRegIntervalList 2)]
    (begin
      (compiler-reg-fill-i64-array starts -1)
      (compiler-reg-fill-i64-array ends -1)
      (array-set! starts 0 0)
      (array-set! ends 0 10)
      (array-set! starts 1 0)
      (array-set! ends 1 10)
      (array-set!
        segments
        0
        (compiler-reg-interval-cons
          (CompilerRegInterval.Interval 0 0 2)
          CompilerRegIntervalList.Nil))
      (array-set!
        segments
        1
        (compiler-reg-interval-cons
          (CompilerRegInterval.Interval 1 4 6)
          CompilerRegIntervalList.Nil))
      (CompilerRegIntervalIndex starts ends segments))))

(define (compiler-reg-coalesce-fixpoint-map-ok?) : bool
  (let
    [types : CompilerRegVarTypes (compiler-reg-coalesce-test-i64-types 3)]
    [moves : CompilerRegMoveList
      (compiler-reg-move-list-add
        (compiler-reg-move-list-add CompilerRegMoveList.Nil 0 2 false true)
        2
        1
        false
        true)]
    [index : CompilerRegIntervalIndex (compiler-reg-coalesce-test-flat-index)]
    [coalesce : CompilerRegCoalesceMap
      (compiler-reg-coalesce-map-build
        moves
        index
        types
        (compiler-live-set-empty)
        3
        (array.make-array i64 0))]
    [assignments : CompilerRegAssignmentTable
      (compiler-reg-assignment-table-insert
        (compiler-reg-assignment-table-make 3)
        0
        (CompilerRegLocation.Register "%r12"))]
    [tie-assignments : CompilerRegAssignmentTable
      (compiler-reg-assignment-table-insert
        (compiler-reg-assignment-table-insert
          (compiler-reg-assignment-table-make 3)
          2
          (CompilerRegLocation.Register "%r13"))
        0
        (CompilerRegLocation.Register "%r12"))]
    (and
      (compiler-reg-location-register?
        (compiler-reg-coalesce-location coalesce assignments index 1)
        "%r12")
      (compiler-reg-location-register?
        (compiler-reg-coalesce-location coalesce tie-assignments index 1)
        "%r12"))))

(define (compiler-reg-coalesce-interference-reject-ok?) : bool
  (let
    [types : CompilerRegVarTypes (compiler-reg-coalesce-test-i64-types 2)]
    [moves : CompilerRegMoveList
      (compiler-reg-move-list-add CompilerRegMoveList.Nil 0 1 false true)]
    [index : CompilerRegIntervalIndex
      (compiler-reg-coalesce-test-overlap-index)]
    [coalesce : CompilerRegCoalesceMap
      (compiler-reg-coalesce-map-build
        moves
        index
        types
        (compiler-live-set-empty)
        2
        (array.make-array i64 0))]
    [assignments : CompilerRegAssignmentTable
      (compiler-reg-assignment-table-insert
        (compiler-reg-assignment-table-make 2)
        0
        (CompilerRegLocation.Register "%r12"))]
    (match (compiler-reg-coalesce-location coalesce assignments index 1)
      [(CompilerRegMaybeLocation.No) true]
      [(CompilerRegMaybeLocation.Some _) false])))

(define (compiler-reg-coalesce-segmented-map-ok?) : bool
  (let
    [types : CompilerRegVarTypes (compiler-reg-coalesce-test-i64-types 2)]
    [moves : CompilerRegMoveList
      (compiler-reg-move-list-add CompilerRegMoveList.Nil 0 1 false true)]
    [index : CompilerRegIntervalIndex
      (compiler-reg-coalesce-test-segment-index)]
    [coalesce : CompilerRegCoalesceMap
      (compiler-reg-coalesce-map-build
        moves
        index
        types
        (compiler-live-set-empty)
        2
        (array.make-array i64 0))]
    [assignments : CompilerRegAssignmentTable
      (compiler-reg-assignment-table-insert
        (compiler-reg-assignment-table-make 2)
        0
        (CompilerRegLocation.Register "%r12"))]
    (compiler-reg-location-register?
      (compiler-reg-coalesce-location coalesce assignments index 1)
      "%r12")))

(define (compiler-reg-coalesce-strict-segmented-reject-ok?) : bool
  (let
    [types : CompilerRegVarTypes (compiler-reg-coalesce-test-i64-types 2)]
    [moves : CompilerRegMoveList
      (compiler-reg-move-list-add CompilerRegMoveList.Nil 0 1 true true)]
    [index : CompilerRegIntervalIndex
      (compiler-reg-coalesce-test-segment-index)]
    [coalesce : CompilerRegCoalesceMap
      (compiler-reg-coalesce-map-build
        moves
        index
        types
        (compiler-live-set-empty)
        2
        (array.make-array i64 0))]
    [assignments : CompilerRegAssignmentTable
      (compiler-reg-assignment-table-insert
        (compiler-reg-assignment-table-make 2)
        0
        (CompilerRegLocation.Register "%r12"))]
    (match (compiler-reg-coalesce-location coalesce assignments index 1)
      [(CompilerRegMaybeLocation.No) true]
      [(CompilerRegMaybeLocation.Some _) false])))

(define (compiler-reg-single-segment-range?
  [segments : CompilerRegIntervalList]
  [var : i64]
  [start : i64]
  [end : i64]) : bool
  (match segments
    [(CompilerRegIntervalList.Cons head rest)
      (match head
        [(CompilerRegInterval.Interval found-var found-start found-end)
          (and
            (= found-var var)
            (= found-start start)
            (= found-end end)
            (match (box-get rest)
              [(CompilerRegIntervalList.Nil) true]
              [_ false]))])]
    [_ false]))

(define (compiler-reg-merged-root-overlap-segments-ok?) : bool
  (let
    [starts : (Array i64) (array.make-array i64 3)]
    [ends : (Array i64) (array.make-array i64 3)]
    [segments : (Array CompilerRegIntervalList)
      (array.make-array CompilerRegIntervalList 3)]
    [parents : (Array i64) (array.make-array i64 3)]
    (begin
      (compiler-reg-fill-i64-array starts -1)
      (compiler-reg-fill-i64-array ends -1)
      (array-set! segments 0 CompilerRegIntervalList.Nil)
      (array-set! segments 1 CompilerRegIntervalList.Nil)
      (array-set! segments 2 CompilerRegIntervalList.Nil)
      (array-set! starts 0 0)
      (array-set! ends 0 6)
      (array-set! starts 1 2)
      (array-set! ends 1 8)
      (array-set!
        segments
        0
        (compiler-reg-interval-cons
          (CompilerRegInterval.Interval 0 0 4)
          (compiler-reg-interval-cons
            (CompilerRegInterval.Interval 0 5 6)
            CompilerRegIntervalList.Nil)))
      (array-set!
        segments
        1
        (compiler-reg-interval-cons
          (CompilerRegInterval.Interval 1 2 8)
          CompilerRegIntervalList.Nil))
      (array-set! parents 0 0)
      (array-set! parents 1 0)
      (array-set! parents 2 2)
      (let
        [merged : CompilerRegIntervalIndex
          (compiler-reg-merged-root-index
            (CompilerRegCoalesceMap parents)
            (CompilerRegIntervalIndex starts ends segments))]
        (and
          (= (array-ref (struct-get merged starts) 0) 0)
          (= (array-ref (struct-get merged ends) 0) 8)
          (< (array-ref (struct-get merged starts) 1) 0)
          (compiler-reg-single-segment-range?
            (array-ref (struct-get merged segments) 0)
            0
            0
            8))))))

(define (compiler-reg-same-value-multi-def-census-ok?) : bool
  (let
    [parents : (Array i64)
      (compiler-reg-function-same-value-parents
        (compiler-reg-same-value-multi-def-census-function))]
    (not (compiler-reg-same-value-class? parents 0 1))))

(define (compiler-reg-same-value-phi-census-ok?) : bool
  (let
    [parents : (Array i64)
      (compiler-reg-function-same-value-parents
        (compiler-reg-loop-backedge-function))]
    (not (compiler-reg-same-value-class? parents 1 2))))

(define (compiler-reg-same-value-clobber-census-ok?) : bool
  (let
    [func : CompilerIrFunction (compiler-reg-same-value-clobber-function)]
    [selection : CompilerRegIntervalSelection
      (compiler-reg-live-interval-selection
        func
        (compiler-live-analyze-function func))]
    (match selection
      [(CompilerRegIntervalSelection.Selection _ interval-index)
        (let
          [parents : (Array i64)
            (compiler-reg-function-same-value-parents-filtered
              func
              (compiler-reg-same-value-eligible-vars
                interval-index
                (compiler-reg-clobber-kind-points func 0)))]
          (not (compiler-reg-same-value-class? parents 0 2)))])))

;; M-C (part 1): build the extended relation the way plan-from does (precise
;; selection index + kind-0 eligibility + var types).
(define (compiler-reg-sv-multi-parents-for [func : CompilerIrFunction]) : (Array
    i64)
  (match (compiler-reg-live-interval-selection
    func
    (compiler-live-analyze-function func))
    [(CompilerRegIntervalSelection.Selection _ interval-index)
      (compiler-reg-function-same-value-parents-multi
        func
        (compiler-reg-same-value-eligible-vars
          interval-index
          (compiler-reg-clobber-kind-points func 0))
        (compiler-reg-function-var-types func)
        interval-index)]))

(define (compiler-reg-sv-multi-ok?) : bool
  (let
    [safe : (Array i64)
      (compiler-reg-sv-multi-parents-for (compiler-reg-sv-multi-safe-function))]
    [reject : (Array i64)
      (compiler-reg-sv-multi-parents-for
        (compiler-reg-sv-multi-reject-function))]
    [chain : (Array i64)
      (compiler-reg-sv-multi-parents-for (compiler-reg-sv-multi-chain-function))]
    [cast : (Array i64)
      (compiler-reg-sv-multi-parents-for (compiler-reg-sv-multi-cast-function))]
    (and
      (compiler-reg-same-value-class? safe 0 1)
      (not (compiler-reg-same-value-class? reject 0 1))
      (compiler-reg-same-value-class? chain 2 3)
      (not (compiler-reg-same-value-class? chain 0 2))
      (not (compiler-reg-same-value-class? chain 0 3))
      (compiler-reg-same-value-class? cast 0 1))))

(define (compiler-reg-coalesce-ok?) : bool
  (match (compiler-reg-plan-function (compiler-reg-move-chain-function))
    [(CompilerRegPlan.Plan chain-assignments _ _ _ _ _)
      (match (compiler-reg-plan-function (compiler-reg-phi-join-function))
        [(CompilerRegPlan.Plan phi-assignments _ _ _ _ _)
          (match (compiler-reg-plan-function
            (compiler-reg-loop-backedge-function))
            [(CompilerRegPlan.Plan loop-assignments _ _ _ _ _)
              (match (compiler-reg-plan-function
                (compiler-reg-interference-blocks-coalesce-function))
                [(CompilerRegPlan.Plan blocked-assignments _ _ _ _ _)
                  (match (compiler-reg-plan-function
                    (compiler-reg-spill-coalesce-function))
                    [(CompilerRegPlan.Plan spill-assignments _ _ _ _ _)
                      (and
                        (compiler-reg-move-list-parallel-decision-ok?)
                        (compiler-reg-same-location? chain-assignments 0 1)
                        (compiler-reg-same-location? chain-assignments 1 2)
                        (compiler-reg-same-location? phi-assignments 0 1)
                        (compiler-reg-different-location? loop-assignments 1 2)
                        (compiler-reg-different-location?
                          blocked-assignments
                          0
                          1)
                        (compiler-reg-same-location? spill-assignments 4 5)
                        (compiler-reg-destructive-chain-ok?)
                        (compiler-reg-coalesce-fixpoint-map-ok?)
                        (compiler-reg-coalesce-interference-reject-ok?)
                        (compiler-reg-coalesce-segmented-map-ok?)
                        (compiler-reg-coalesce-strict-segmented-reject-ok?)
                        (compiler-reg-merged-root-overlap-segments-ok?)
                        (compiler-reg-same-value-multi-def-census-ok?)
                        (compiler-reg-same-value-phi-census-ok?)
                        (compiler-reg-same-value-clobber-census-ok?)
                        (compiler-reg-sv-multi-ok?))])])])])]))

(cfg
  test
  (define (compiler-reg-xmm-ownership-fixed-home
    [preassigned-reg : String]
    [intervals : CompilerRegIntervalList]
    [candidate-start : i64]
    [candidate-end : i64]
    [regs : CompilerRegStringList]) : String
    (let
      [index : CompilerRegIntervalIndex
        (compiler-reg-interval-index-build intervals 2)]
      [assignments : CompilerRegAssignmentTable
        (compiler-reg-assignment-table-insert
          (compiler-reg-assignment-table-make 2)
          0
          (CompilerRegLocation.Register preassigned-reg))]
      [candidates : CompilerRegIntervalList
        (compiler-reg-interval-cons
          (CompilerRegInterval.Interval 1 candidate-start candidate-end)
          CompilerRegIntervalList.Nil)]
      (match (compiler-reg-assign-fixed-candidates
        candidates
        regs
        CompilerRegActiveList.Nil
        assignments
        (array.make-array i64 0)
        index)
        [(CompilerRegAssignState.State _ out)
          (match (compiler-reg-assignment-table-lookup out 1)
            [(CompilerRegMaybeLocation.Some location)
              (compiler-reg-location-primary-register location)]
            [(CompilerRegMaybeLocation.No) ""])]))))

(cfg
  test
  (define (compiler-reg-xmm-ownership-intervals
    [pre-start : i64]
    [pre-end : i64]
    [candidate-start : i64]
    [candidate-end : i64]) : CompilerRegIntervalList
    (compiler-reg-interval-cons
      (CompilerRegInterval.Interval 0 pre-start pre-end)
      (compiler-reg-interval-cons
        (CompilerRegInterval.Interval 1 candidate-start candidate-end)
        CompilerRegIntervalList.Nil))))

(cfg
  test
  (define (compiler-reg-xmm-ownership-segment-hole-intervals) : CompilerRegIntervalList
    (compiler-reg-interval-cons
      (CompilerRegInterval.Interval 0 0 2)
      (compiler-reg-interval-cons
        (CompilerRegInterval.Interval 1 3 5)
        (compiler-reg-interval-cons
          (CompilerRegInterval.Interval 0 6 8)
          CompilerRegIntervalList.Nil)))))

(cfg
  test
  (define (compiler-reg-xmm-physical-ownership-ok?) : bool
    (let
      [vector-pool : CompilerRegStringList
        (compiler-reg-string-cons
          "%vec6"
          (compiler-reg-string-cons "%vec7" CompilerRegStringList.Nil))]
      [scalar-spelled-pool : CompilerRegStringList
        (compiler-reg-string-cons
          "%xmm6"
          (compiler-reg-string-cons "%xmm7" CompilerRegStringList.Nil))]
      [overlap : CompilerRegIntervalList
        (compiler-reg-xmm-ownership-intervals 0 8 2 6)]
      [boundary-reuse : CompilerRegIntervalList
        (compiler-reg-xmm-ownership-intervals 0 2 2 6)]
      (and
        ;; AVX2/AVX-512 spellings and the width-neutral allocator home all own
        ;; the same physical register as an f32/f64 scalar XMM spelling.
        (compiler-reg-registers-overlap? "%xmm6" "%vec6")
        (compiler-reg-registers-overlap? "%xmm6" "%ymm6")
        (compiler-reg-registers-overlap? "%xmm6" "%zmm6")
        (not (compiler-reg-registers-overlap? "%xmm6" "%vec7"))
        (not (compiler-reg-registers-overlap? "%xmm6" "%k6"))
        (= (compiler-reg-xmm-family-index "%xmm13") 13)
        (= (compiler-reg-xmm-family-index "%ymm13") 13)
        (= (compiler-reg-xmm-family-index "%zmm13") 13)
        (= (compiler-reg-xmm-family-index "%vec13") 13)
        (= (compiler-reg-xmm-family-index "%xmm06") -1)
        ;; Deliberate f32/f64-vs-vector collisions reject physical index 6 at
        ;; every emitted width and select the next vector home.
        (string.eq
          (compiler-reg-xmm-ownership-fixed-home
            "%xmm6"
            overlap
            2
            6
            vector-pool)
          "%vec7")
        (string.eq
          (compiler-reg-xmm-ownership-fixed-home
            "%ymm6"
            overlap
            2
            6
            vector-pool)
          "%vec7")
        (string.eq
          (compiler-reg-xmm-ownership-fixed-home
            "%zmm6"
            overlap
            2
            6
            vector-pool)
          "%vec7")
        ;; Mask-on-vector allocation uses the same ownership query even when
        ;; the preassignment and candidate pools use opposite class spellings.
        (string.eq
          (compiler-reg-xmm-ownership-fixed-home
            "%vec6"
            overlap
            2
            6
            scalar-spelled-pool)
          "%xmm7")
        ;; Touching ranges and a segmented phi/liveness hole may safely reuse
        ;; the physical register; real segment overlap still rejects it.
        (string.eq
          (compiler-reg-xmm-ownership-fixed-home
            "%xmm6"
            boundary-reuse
            2
            6
            vector-pool)
          "%vec6")
        (string.eq
          (compiler-reg-xmm-ownership-fixed-home
            "%xmm6"
            (compiler-reg-xmm-ownership-segment-hole-intervals)
            3
            5
            vector-pool)
          "%vec6")))))

(cfg
  test
  (define (compiler-reg-dense-mask-on-vector-homes-ok?) : bool
    (let
      [list-func : CompilerIrFunction (compiler-reg-mask-home-function)]
      [dense-func : CompilerIrFunction
        (compiler-ir-function-compact-blocks list-func)]
      [list-assignments : CompilerRegAssignmentList
        (compiler-reg-plan-assignments
          (compiler-reg-plan-function-avx2 list-func))]
      [dense-assignments : CompilerRegAssignmentList
        (compiler-reg-plan-assignments
          (compiler-reg-plan-function-avx2 dense-func))]
      (and
        (compiler-reg-location-register?
          (compiler-reg-assignment-lookup list-assignments 0)
          "%vec6")
        (compiler-reg-location-register?
          (compiler-reg-assignment-lookup list-assignments 1)
          "%vec7")
        (compiler-reg-location-register?
          (compiler-reg-assignment-lookup dense-assignments 0)
          "%vec6")
        (compiler-reg-location-register?
          (compiler-reg-assignment-lookup dense-assignments 1)
          "%vec7")))))

(define (compiler-reg-vector-mask-homes-ok?) : bool
  (match (compiler-reg-plan-function (compiler-reg-vector-home-function))
    [(CompilerRegPlan.Plan vector-assignments _ _ _ _ _)
      (match (compiler-reg-plan-function
        (compiler-reg-vector-gp-clobber-home-function))
        [(CompilerRegPlan.Plan gp-clobber-assignments _ _ _ _ _)
          (match (compiler-reg-plan-function
            (compiler-reg-vector-select-false-home-function))
            [(CompilerRegPlan.Plan select-assignments _ _ _ _ _)
              (match (compiler-reg-plan-function
                (compiler-reg-mask-home-function))
                [(CompilerRegPlan.Plan mask-assignments _ _ _ _ _)
                  (let
                    [vector-ok : bool
                      (and
                        (compiler-reg-location-register?
                          (compiler-reg-assignment-lookup vector-assignments 0)
                          "%vec6")
                        (compiler-reg-location-register?
                          (compiler-reg-assignment-lookup vector-assignments 1)
                          "%vec7")
                        (compiler-reg-location-register?
                          (compiler-reg-assignment-lookup vector-assignments 2)
                          "%vec7")
                        (compiler-reg-location-register?
                          (compiler-reg-assignment-lookup vector-assignments 3)
                          "%vec6"))]
                    [gp-clobber-ok : bool
                      (compiler-reg-location-register?
                        (compiler-reg-assignment-lookup
                          gp-clobber-assignments
                          0)
                        "%vec6")]
                    [select-ok : bool
                      (and
                        (compiler-reg-location-register?
                          (compiler-reg-assignment-lookup select-assignments 1)
                          "%vec7")
                        (compiler-reg-location-register?
                          (compiler-reg-assignment-lookup select-assignments 2)
                          "%vec8")
                        (compiler-reg-location-register?
                          (compiler-reg-assignment-lookup select-assignments 4)
                          "%vec7"))]
                    [mask-ok : bool
                      (and
                        (compiler-reg-location-register?
                          (compiler-reg-assignment-lookup mask-assignments 0)
                          "%k1")
                        (compiler-reg-location-register?
                          (compiler-reg-assignment-lookup mask-assignments 1)
                          "%k2")
                        (compiler-reg-location-register?
                          (compiler-reg-assignment-lookup mask-assignments 3)
                          "%k1"))]
                    (and vector-ok gp-clobber-ok select-ok mask-ok))])])])]))

(define (compiler-reg-target-clobbers-ok?) : bool
  (let
    [_rbp-off : unit (compiler-reg-set-rbp-pool-enabled! false)]
    [zero-call-callers : CompilerRegStringList
      (compiler-reg-zero-call-caller-saved-integer-registers)]
    [greedy-pool : CompilerRegStringList (compiler-reg-greedy-integer-pool)]
    [sysv-callers : CompilerRegStringList
      (compiler-reg-sysv-caller-saved-integer-registers)]
    [sysv-callees : CompilerRegStringList
      (compiler-reg-sysv-callee-saved-integer-registers)]
    [win-callers : CompilerRegStringList
      (compiler-reg-win64-caller-saved-integer-registers)]
    [win-callees : CompilerRegStringList
      (compiler-reg-win64-callee-saved-integer-registers)]
    [copy-instr : CompilerIrInstr
      (CompilerIrInstr.CopyBytes
        (CompilerIrValue.Var 0)
        (CompilerIrValue.Var 1)
        24)]
    [add-instr : CompilerIrInstr
      (CompilerIrInstr.BinOp
        2
        (CompilerIrBinOp.Add)
        (CompilerIrValue.Var 0)
        (CompilerIrValue.Var 1)
        (AstType.I64))]
    (and
      (compiler-reg-string-list-contains? sysv-callers "%rdi")
      (not (compiler-reg-string-list-contains? sysv-callees "%rdi"))
      (compiler-reg-string-list-contains? win-callees "%rdi")
      (not (compiler-reg-string-list-contains? win-callers "%rdi"))
      (not
        (=
          (compiler-reg-string-list-count (compiler-reg-sysv-integer-registers))
          (compiler-reg-string-list-count win-callees)))
      ;; The callee-saved subpool admits only registers that survive an
      ;; intervening call.
      (compiler-reg-string-list-contains?
        (compiler-reg-sysv-integer-registers)
        "%r12")
      ;; The greedy pool owns the caller-saved backend temps behind the
      ;; clobber-point filter.
      (= (compiler-reg-greedy-caller-saved-count) 9)
      (compiler-reg-string-list-contains? greedy-pool "%r8")
      (compiler-reg-string-list-contains? greedy-pool "%r10")
      (compiler-reg-string-list-contains? greedy-pool "%r11")
      ;; ABI-aware split: SysV caller-saved-count=9; Win64=7 (%rsi/%rdi are
      ;; nonvolatile on Win64 -> in the callee-saved suffix, not the prefix).
      (=
        (compiler-reg-greedy-caller-saved-count-for-abi
          CompilerRegTargetAbi.Linux)
        9)
      (=
        (compiler-reg-greedy-caller-saved-count-for-abi
          CompilerRegTargetAbi.Windows)
        7)
      (=
        (compiler-reg-string-list-count
          (compiler-reg-greedy-integer-pool-for-abi
            CompilerRegTargetAbi.Windows))
        14)
      (compiler-reg-string-list-contains?
        (compiler-reg-greedy-integer-pool-for-abi CompilerRegTargetAbi.Windows)
        "%rsi")
      (compiler-reg-string-list-contains?
        (compiler-reg-greedy-integer-pool-for-abi CompilerRegTargetAbi.Windows)
        "%rdi")
      ;; The scalar zero-call extension is the older three-register subset.
      ;; Keep ABI/result registers and Win64 callee-saved %rsi/%rdi out of it.
      (= (compiler-reg-string-list-count zero-call-callers) 3)
      (compiler-reg-string-list-contains? zero-call-callers "%r9")
      (compiler-reg-string-list-contains? zero-call-callers "%rcx")
      (compiler-reg-string-list-contains? zero-call-callers "%rdx")
      (not
        (compiler-reg-backend-caller-clobber-instr-for-abi?
          CompilerRegTargetAbi.Linux
          copy-instr))
      (compiler-reg-backend-caller-clobber-instr-for-abi?
        CompilerRegTargetAbi.Windows
        copy-instr)
      (not
        (compiler-reg-backend-caller-clobber-instr-for-abi?
          CompilerRegTargetAbi.Linux
          add-instr))
      (compiler-reg-backend-caller-clobber-instr-for-abi?
        CompilerRegTargetAbi.Windows
        add-instr)
      (compiler-reg-string-list-contains? sysv-callers "%rcx")
      (compiler-reg-string-list-contains? sysv-callers "%rdx")
      (compiler-reg-string-list-contains? sysv-callers "%r9")
      (compiler-reg-string-list-contains? win-callers "%rcx")
      (compiler-reg-string-list-contains? win-callers "%rdx")
      (compiler-reg-string-list-contains? win-callers "%r9")
      (not (compiler-reg-string-list-contains? zero-call-callers "%rax"))
      ;; Win64 FPO appends %rbp to the nonvolatile suffix without moving the
      ;; seven-register volatile boundary or any existing pool member.
      (let
        [_rbp-on : unit (compiler-reg-set-rbp-pool-enabled! true)]
        [fpo-pool : CompilerRegStringList
          (compiler-reg-greedy-integer-pool-for-abi
            CompilerRegTargetAbi.Windows)]
        [ok : bool
          (and
            (= (compiler-reg-string-list-count fpo-pool) 15)
            (compiler-reg-string-list-contains? fpo-pool "%rbp")
            (=
              (compiler-reg-greedy-caller-saved-count-for-abi
                CompilerRegTargetAbi.Windows)
              7))]
        [_rbp-restore : unit (compiler-reg-set-rbp-pool-enabled! false)]
        ok)
      (not (compiler-reg-string-list-contains? zero-call-callers "%r8"))
      (not (compiler-reg-string-list-contains? zero-call-callers "%r10"))
      (not (compiler-reg-string-list-contains? zero-call-callers "%r11"))
      (not (compiler-reg-string-list-contains? zero-call-callers "%rdi"))
      (not (compiler-reg-string-list-contains? zero-call-callers "%rsi"))
      (not
        (compiler-reg-string-list-contains?
          (compiler-reg-sysv-integer-registers)
          "%r8"))
      (not
        (compiler-reg-string-list-contains?
          (compiler-reg-sysv-integer-registers)
          "%r9")))))

(define (compiler-reg-xmm-clobbers-ok?) : bool
  (let
    [sysv-pool : CompilerRegStringList
      (compiler-reg-xmm-registers-for-abi CompilerRegTargetAbi.Linux)]
    [win-pool : CompilerRegStringList
      (compiler-reg-xmm-registers-for-abi CompilerRegTargetAbi.Windows)]
    [win-vector-pool : CompilerRegStringList
      (compiler-reg-vector-registers-for-abi CompilerRegTargetAbi.Windows)]
    [sysv-callers : CompilerRegStringList
      (compiler-reg-sysv-caller-saved-xmm-registers)]
    [sysv-callees : CompilerRegStringList
      (compiler-reg-sysv-callee-saved-xmm-registers)]
    [win-callers : CompilerRegStringList
      (compiler-reg-win64-caller-saved-xmm-registers)]
    [win-callees : CompilerRegStringList
      (compiler-reg-win64-callee-saved-xmm-registers)]
    [pool-ok : bool
      (and
        (= (compiler-reg-string-list-count sysv-pool) 14)
        (= (compiler-reg-string-list-count win-pool) 14)
        (= (compiler-reg-string-list-count win-vector-pool) 14)
        (=
          (compiler-reg-xmm-caller-register-count-for-abi
            CompilerRegTargetAbi.Linux)
          14)
        (=
          (compiler-reg-xmm-caller-register-count-for-abi
            CompilerRegTargetAbi.Windows)
          4)
        (compiler-reg-string-list-contains? sysv-pool "%xmm2")
        (compiler-reg-string-list-contains? sysv-pool "%xmm15")
        (compiler-reg-string-list-contains? win-pool "%xmm2")
        (compiler-reg-string-list-contains? win-pool "%xmm6")
        (compiler-reg-string-list-contains? win-pool "%xmm15")
        (compiler-reg-string-list-contains? win-vector-pool "%vec2")
        (compiler-reg-string-list-contains? win-vector-pool "%vec15")
        (not (compiler-reg-string-list-contains? sysv-pool "%xmm0"))
        (not (compiler-reg-string-list-contains? sysv-pool "%xmm1"))
        (not (compiler-reg-string-list-contains? win-vector-pool "%vec0"))
        (not (compiler-reg-string-list-contains? win-vector-pool "%vec1")))]
    [sysv-ok : bool
      (and
        (compiler-reg-string-list-contains? sysv-callers "%xmm14")
        (not (compiler-reg-string-list-contains? sysv-callees "%xmm14")))]
    [win-ok : bool
      (and
        (compiler-reg-string-list-contains? win-callers "%xmm5")
        (not (compiler-reg-string-list-contains? win-callers "%xmm6"))
        (compiler-reg-string-list-contains? win-callees "%xmm6"))]
    [counts-ok : bool
      (and
        (= (compiler-reg-string-list-count sysv-callers) 16)
        (= (compiler-reg-string-list-count sysv-callees) 0)
        (= (compiler-reg-string-list-count win-callers) 6)
        (= (compiler-reg-string-list-count win-callees) 10))]
    (and pool-ok sysv-ok win-ok counts-ok)))

(define (compiler-reg-test-xmm-greedy-assignments
  [abi : CompilerRegTargetAbi]
  [vector : bool]
  [spans-call : bool]) : CompilerRegAssignmentList
  (let
    [intervals : CompilerRegIntervalList
      (compiler-reg-interval-cons
        (CompilerRegInterval.Interval 0 0 10)
        CompilerRegIntervalList.Nil)]
    [call-points : CompilerLiveI64Set
      (if spans-call
        (compiler-live-set-insert (compiler-live-set-empty) 5)
        (compiler-live-set-empty))]
    [state : CompilerRegAssignState
      (compiler-reg-greedy-state
        intervals
        (if vector
          (compiler-reg-vector-registers-for-abi abi)
          (compiler-reg-xmm-registers-for-abi abi))
        (compiler-reg-assignment-table-make 1)
        (compiler-reg-interval-index-build intervals 1)
        (compiler-live-set-empty)
        (compiler-live-set-empty)
        (array.make-array i64 0)
        (array.make-array i64 0)
        (array.make-array i64 0)
        call-points
        (compiler-live-set-empty)
        (compiler-live-set-empty)
        (if vector
          (compiler-reg-vector-callee-registers-for-abi abi)
          (compiler-reg-xmm-callee-registers-for-abi abi))
        (compiler-reg-xmm-caller-register-count-for-abi abi)
        -1)]
    (match state
      [(CompilerRegAssignState.State _ assignments)
        (compiler-reg-assignment-table-to-list assignments)])))

(define (compiler-reg-xmm-abi-call-constraints-ok?) : bool
  (let
    [sysv-float : CompilerRegAssignmentList
      (compiler-reg-test-xmm-greedy-assignments
        CompilerRegTargetAbi.Linux
        false
        true)]
    [win-float : CompilerRegAssignmentList
      (compiler-reg-test-xmm-greedy-assignments
        CompilerRegTargetAbi.Windows
        false
        true)]
    [sysv-vector : CompilerRegAssignmentList
      (compiler-reg-test-xmm-greedy-assignments
        CompilerRegTargetAbi.Linux
        true
        true)]
    [win-vector : CompilerRegAssignmentList
      (compiler-reg-test-xmm-greedy-assignments
        CompilerRegTargetAbi.Windows
        true
        true)]
    [sysv-leaf : CompilerRegAssignmentList
      (compiler-reg-test-xmm-greedy-assignments
        CompilerRegTargetAbi.Linux
        false
        false)]
    (and
      (not
        (compiler-reg-location-any-register?
          (compiler-reg-assignment-lookup sysv-float 0)))
      (not
        (compiler-reg-location-any-register?
          (compiler-reg-assignment-lookup sysv-vector 0)))
      (compiler-reg-location-register?
        (compiler-reg-assignment-lookup win-float 0)
        "%xmm6")
      (compiler-reg-location-register?
        (compiler-reg-assignment-lookup win-vector 0)
        "%vec6")
      (compiler-reg-location-register?
        (compiler-reg-assignment-lookup sysv-leaf 0)
        "%xmm2"))))

(define (compiler-reg-xmm-shared-greedy-bank-ok?) : bool
  (let
    [scalar-candidates : CompilerRegIntervalList
      (compiler-reg-interval-cons
        (CompilerRegInterval.Interval 0 0 10)
        CompilerRegIntervalList.Nil)]
    [vector-candidates : CompilerRegIntervalList
      (compiler-reg-interval-cons
        (CompilerRegInterval.Interval 1 0 10)
        CompilerRegIntervalList.Nil)]
    [all-intervals : CompilerRegIntervalList
      (compiler-reg-interval-cons
        (CompilerRegInterval.Interval 0 0 10)
        vector-candidates)]
    [interval-index : CompilerRegIntervalIndex
      (compiler-reg-interval-index-build all-intervals 2)]
    [scalar-state : CompilerRegAssignState
      (compiler-reg-greedy-state
        scalar-candidates
        (compiler-reg-string-cons "%xmm6" CompilerRegStringList.Nil)
        (compiler-reg-assignment-table-make 2)
        interval-index
        (compiler-live-set-empty)
        (compiler-live-set-empty)
        (array.make-array i64 0)
        (array.make-array i64 0)
        (array.make-array i64 0)
        (compiler-live-set-empty)
        (compiler-live-set-empty)
        (compiler-live-set-empty)
        CompilerRegStringList.Nil
        1
        -1)]
    (match scalar-state
      [(CompilerRegAssignState.State _ scalar-assignments)
        (match (compiler-reg-greedy-state
          vector-candidates
          (compiler-reg-vector-registers-for-abi CompilerRegTargetAbi.Linux)
          scalar-assignments
          interval-index
          (compiler-live-set-empty)
          (compiler-live-set-empty)
          (array.make-array i64 0)
          (array.make-array i64 0)
          (array.make-array i64 0)
          (compiler-live-set-empty)
          (compiler-live-set-empty)
          (compiler-live-set-empty)
          CompilerRegStringList.Nil
          14
          -1)
          [(CompilerRegAssignState.State _ assignments)
            (let
              [items : CompilerRegAssignmentList
                (compiler-reg-assignment-table-to-list assignments)]
              (and
                (compiler-reg-location-register?
                  (compiler-reg-assignment-lookup items 0)
                  "%xmm6")
                (compiler-reg-location-register?
                  (compiler-reg-assignment-lookup items 1)
                  "%vec7")))])])))

(define (compiler-reg-xmm-vector-class-reset-ok?) : bool
  (let
    [candidates : CompilerRegIntervalList
      (compiler-reg-interval-cons
        (CompilerRegInterval.Interval 0 0 10)
        CompilerRegIntervalList.Nil)]
    [index : CompilerRegIntervalIndex
      (compiler-reg-interval-index-build candidates 1)]
    [assignments : CompilerRegAssignmentTable
      (compiler-reg-assignment-table-insert
        (compiler-reg-assignment-table-make 1)
        0
        (CompilerRegLocation.Register "%r12"))]
    [_reset : unit
      (compiler-reg-unassign-special-candidates! assignments candidates)]
    (match (compiler-reg-greedy-state
      candidates
      (compiler-reg-vector-registers-for-abi CompilerRegTargetAbi.Linux)
      assignments
      index
      (compiler-live-set-empty)
      (compiler-live-set-empty)
      (array.make-array i64 0)
      (array.make-array i64 0)
      (array.make-array i64 0)
      (compiler-live-set-empty)
      (compiler-live-set-empty)
      (compiler-live-set-empty)
      CompilerRegStringList.Nil
      14
      -1)
      [(CompilerRegAssignState.State _ out)
        (compiler-reg-location-register?
          (compiler-reg-assignment-table-lookup out 0)
          "%vec6")])))

(define (compiler-reg-color-register-assignments-to [last : i64]) : CompilerRegAssignmentList
  (if (< last 0)
    CompilerRegAssignmentList.Nil
    (compiler-reg-assignment-insert
      (compiler-reg-color-register-assignments-to (- last 1))
      last
      (CompilerRegLocation.Register "%r12"))))

(define (compiler-reg-color-storage-function) : CompilerIrFunction
  (let
    [big : AstType (AstType.Struct (intern "BigStorage"))]
    (CompilerIrFunction.Function
      (compiler-ir-test-symbol "storage_ranges")
      CompilerIrParamList.Nil
      (AstType.Unit)
      6
      (compiler-ir-block-cons
        (compiler-ir-block
          "entry"
          (compiler-ir-instr-cons
            (CompilerIrInstr.Alloc 0 big)
            (compiler-ir-instr-cons
              (CompilerIrInstr.Alloc 1 big)
              (compiler-ir-instr-cons
                (CompilerIrInstr.AddrOf 2 1)
                (compiler-ir-instr-cons
                  (CompilerIrInstr.StorePtr
                    (CompilerIrValue.Var 2)
                    (CompilerIrValue.I64 11)
                    (AstType.I64))
                  (compiler-ir-instr-cons
                    (CompilerIrInstr.Alloc 3 big)
                    (compiler-ir-instr-cons
                      (CompilerIrInstr.Alloc 4 big)
                      (compiler-ir-instr-cons
                        (CompilerIrInstr.AddrOf 5 4)
                        (compiler-ir-instr-cons
                          (CompilerIrInstr.StorePtr
                            (CompilerIrValue.Var 5)
                            (CompilerIrValue.I64 22)
                            (AstType.I64))
                          (compiler-ir-instr-cons
                            (CompilerIrInstr.Return CompilerIrMaybeValue.No)
                            CompilerIrInstrList.Nil))))))))))
        CompilerIrBlockList.Nil))))

(define (compiler-reg-color-pointer-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-insert
    (compiler-reg-assignment-insert
      CompilerRegAssignmentList.Nil
      2
      (CompilerRegLocation.Register "%r12"))
    5
    (CompilerRegLocation.Register "%r13")))

(define (compiler-reg-color-pointer-intervals) : CompilerRegIntervalList
  (compiler-reg-interval-cons
    (CompilerRegInterval.Interval 2 1 3)
    (compiler-reg-interval-cons
      (CompilerRegInterval.Interval 5 5 7)
      CompilerRegIntervalList.Nil)))

(define (compiler-reg-color-pointer-types) : CompilerRegVarTypeList
  (compiler-reg-var-type-cons
    (CompilerRegVarType.Type 2 (AstType.U64))
    (compiler-reg-var-type-cons
      (CompilerRegVarType.Type 5 (AstType.U64))
      CompilerRegVarTypeList.Nil)))

(define (compiler-reg-color-spill-sharing-assignments [vars : i64]) : CompilerRegAssignmentList
  (if (< vars 1)
    CompilerRegAssignmentList.Nil
    (compiler-reg-assignment-insert
      (compiler-reg-color-spill-sharing-assignments (- vars 1))
      (- vars 1)
      (CompilerRegLocation.Spill (* (- vars 1) 8)))))

(define (compiler-reg-color-spill-sharing-types [vars : i64]) : CompilerRegVarTypeList
  (if (< vars 1)
    CompilerRegVarTypeList.Nil
    (compiler-reg-var-type-cons
      (CompilerRegVarType.Type (- vars 1) (AstType.I64))
      (compiler-reg-color-spill-sharing-types (- vars 1)))))

(define (compiler-reg-color-spill-sharing-intervals) : CompilerRegIntervalList
  (compiler-reg-interval-cons
    (CompilerRegInterval.Interval 0 0 2)
    (compiler-reg-interval-cons
      (CompilerRegInterval.Interval 2 1 5)
      (compiler-reg-interval-cons
        (CompilerRegInterval.Interval 1 3 4)
        CompilerRegIntervalList.Nil))))

(define (compiler-reg-color-spill-split-intervals) : CompilerRegIntervalList
  (compiler-reg-interval-cons
    (CompilerRegInterval.Interval 0 0 1)
    (compiler-reg-interval-cons
      (CompilerRegInterval.Interval 1 2 3)
      (compiler-reg-interval-cons
        (CompilerRegInterval.Interval 0 5 7)
        CompilerRegIntervalList.Nil))))

(define (compiler-reg-color-spill-param-intervals) : CompilerRegIntervalList
  (compiler-reg-interval-cons
    (CompilerRegInterval.Interval 0 0 1)
    (compiler-reg-interval-cons
      (CompilerRegInterval.Interval 1 1 2)
      (compiler-reg-interval-cons
        (CompilerRegInterval.Interval 2 3 4)
        CompilerRegIntervalList.Nil))))

(define (compiler-reg-color-spill-slot-sharing-ok?) : bool
  (match (compiler-reg-color-stack-slots
    (CompilerRegPlan.Plan
      (compiler-reg-color-spill-sharing-assignments 3)
      (compiler-live-set-empty)
      (compiler-reg-color-spill-sharing-intervals)
      (compiler-reg-color-spill-sharing-types 3)
      (compiler-reg-call-split-empty)
      (compiler-reg-split-plan-empty))
    (compiler-live-set-empty)
    CompilerIrParamList.Nil
    CompilerIrBlockList.Nil
    3
    3)
    [(CompilerRegColoring.Remap share-remap share-slots)
      (match (compiler-reg-color-stack-slots
        (CompilerRegPlan.Plan
          (compiler-reg-color-spill-sharing-assignments 2)
          (compiler-live-set-empty)
          (compiler-reg-color-spill-split-intervals)
          (compiler-reg-color-spill-sharing-types 2)
          (compiler-reg-call-split-empty)
          (compiler-reg-split-plan-empty))
        (compiler-live-set-empty)
        CompilerIrParamList.Nil
        CompilerIrBlockList.Nil
        2
        2)
        [(CompilerRegColoring.Remap split-remap split-slots)
          (and
            (= share-slots 2)
            (= (array-ref share-remap 0) (array-ref share-remap 1))
            (not (= (array-ref share-remap 0) (array-ref share-remap 2)))
            (= split-slots 2)
            (not (= (array-ref split-remap 0) (array-ref split-remap 1))))]
        [(CompilerRegColoring.None) false])]
    [(CompilerRegColoring.None) false]))

(define (compiler-reg-color-spill-param-pins-ok?) : bool
  (match (compiler-reg-color-stack-slots
    (CompilerRegPlan.Plan
      (compiler-reg-color-spill-sharing-assignments 3)
      (compiler-live-set-empty)
      (compiler-reg-color-spill-param-intervals)
      (compiler-reg-color-spill-sharing-types 3)
      (compiler-reg-call-split-empty)
      (compiler-reg-split-plan-empty))
    (compiler-live-set-empty)
    (compiler-ir-param-cons
      (CompilerIrParam.Param "pinned" (AstType.I64) 1)
      CompilerIrParamList.Nil)
    CompilerIrBlockList.Nil
    3
    3)
    [(CompilerRegColoring.Remap remap slots)
      (and
        (= slots 2)
        (= (array-ref remap 1) 1)
        (= (array-ref remap 0) (array-ref remap 2))
        (not (= (array-ref remap 0) 1)))]
    [(CompilerRegColoring.None) false]))

(define (compiler-reg-color-spill-hole-demand-ok?) : bool
  (match (compiler-reg-color-stack-slots
    (CompilerRegPlan.Plan
      (compiler-reg-color-spill-sharing-assignments 1)
      (compiler-live-set-empty)
      (compiler-reg-interval-cons
        (CompilerRegInterval.Interval 0 0 1)
        CompilerRegIntervalList.Nil)
      (compiler-reg-color-spill-sharing-types 1)
      (compiler-reg-call-split-empty)
      (compiler-reg-split-plan-empty))
    (compiler-live-set-empty)
    CompilerIrParamList.Nil
    CompilerIrBlockList.Nil
    10
    10)
    [(CompilerRegColoring.Remap remap slots)
      (and
        (= slots 1)
        (= (array-ref remap 0) 0)
        (not (= (array-ref remap 9) 0)))]
    [(CompilerRegColoring.None) false]))

(define (compiler-reg-color-spill-scratch-demand-ok?) : bool
  (let
    [params : CompilerIrParamList
      (compiler-ir-param-cons
        (CompilerIrParam.Param "real" (AstType.I64) 0)
        CompilerIrParamList.Nil)]
    (match (compiler-reg-color-stack-slots
      (CompilerRegPlan.Plan
        (compiler-reg-color-spill-sharing-assignments 2)
        (compiler-live-set-empty)
        (compiler-reg-interval-cons
          (CompilerRegInterval.Interval 0 0 1)
          (compiler-reg-interval-cons
            (CompilerRegInterval.Interval 1 0 1)
            CompilerRegIntervalList.Nil))
        (compiler-reg-color-spill-sharing-types 2)
        (compiler-reg-call-split-empty)
        (compiler-reg-split-plan-empty))
      (compiler-live-set-empty)
      params
      CompilerIrBlockList.Nil
      2
      1)
      [(CompilerRegColoring.Remap remap slots)
        (and (= slots 1) (= (array-ref remap 0) 0) (= (array-ref remap 1) 1))]
      [(CompilerRegColoring.None) false])))

(define (compiler-reg-color-vector-stack-function) : CompilerIrFunction
  (CompilerIrFunction.Function
    (compiler-ir-test-symbol "vector_stack_slots")
    CompilerIrParamList.Nil
    (AstType.Unit)
    3
    (compiler-ir-block-cons
      (compiler-ir-block
        "entry"
        (compiler-ir-instr-cons
          (CompilerIrInstr.VectorLoad
            0
            (CompilerIrValue.I64 0)
            (CompilerIrValue.I64 0)
            4
            (AstType.I64))
          (compiler-ir-instr-cons
            (CompilerIrInstr.VectorLoad
              1
              (CompilerIrValue.I64 0)
              (CompilerIrValue.I64 0)
              8
              (AstType.I64))
            (compiler-ir-instr-cons
              (CompilerIrInstr.TailMask
                2
                (CompilerIrValue.I64 0)
                (CompilerIrValue.I64 1)
                8)
              (compiler-ir-instr-cons
                (CompilerIrInstr.Return CompilerIrMaybeValue.No)
                CompilerIrInstrList.Nil)))))
      CompilerIrBlockList.Nil)))

(define (compiler-reg-color-vector-stack-slots-ok?) : bool
  (match (compiler-reg-color-vector-stack-function)
    [(CompilerIrFunction.Function _ params _ vars blocks)
      (match (compiler-reg-color-stack-slots
        (CompilerRegPlan.Plan
          CompilerRegAssignmentList.Nil
          (compiler-live-set-empty)
          (compiler-reg-interval-cons
            (CompilerRegInterval.Interval 0 0 2)
            (compiler-reg-interval-cons
              (CompilerRegInterval.Interval 1 1 3)
              (compiler-reg-interval-cons
                (CompilerRegInterval.Interval 2 2 4)
                CompilerRegIntervalList.Nil)))
          CompilerRegVarTypeList.Nil
          (compiler-reg-call-split-empty)
          (compiler-reg-split-plan-empty))
        (compiler-live-set-empty)
        params
        blocks
        vars
        vars)
        [(CompilerRegColoring.Remap remap slots)
          (and
            (= (array-ref remap 0) 3)
            (= (array-ref remap 1) 11)
            (= (array-ref remap 2) 15)
            (= slots 16))]
        [(CompilerRegColoring.None) false])]))

(define (compiler-reg-vector-stack-mask-words-ok?) : bool
  (let
    [words : (Array i64) (array.make-array i64 6)]
    (begin
      (compiler-reg-vector-stack-words-instr!
        (ir-instr-vector-compare
          0
          (CompilerIrBinOp.Eq)
          (CompilerIrValue.I64 0)
          (CompilerIrValue.I64 0)
          8
          (AstType.I32))
        words)
      (compiler-reg-vector-stack-words-instr!
        (CompilerIrInstr.MaskBinOp
          1
          (CompilerIrMaskBinOp.And)
          (CompilerIrValue.Var 0)
          (CompilerIrValue.Var 0)
          8)
        words)
      (compiler-reg-vector-stack-words-instr!
        (CompilerIrInstr.MaskNot 2 (CompilerIrValue.Var 1) 8)
        words)
      (compiler-reg-vector-stack-words-instr!
        (CompilerIrInstr.TailMask
          3
          (CompilerIrValue.I64 0)
          (CompilerIrValue.I64 1)
          8)
        words)
      (compiler-reg-vector-stack-words-instr!
        (ir-instr-predicated-load
          4
          (CompilerIrValue.I64 0)
          (CompilerIrValue.I64 0)
          (CompilerIrValue.Var 3)
          8
          (AstType.Bool))
        words)
      (compiler-reg-vector-stack-words-instr!
        (ir-instr-select
          5
          (CompilerIrValue.Var 3)
          (CompilerIrValue.Var 4)
          (CompilerIrValue.Var 4)
          8
          (AstType.Bool))
        words)
      (and
        (= (array-ref words 0) 4)
        (= (array-ref words 1) 4)
        (= (array-ref words 2) 4)
        (= (array-ref words 3) 4)
        (= (array-ref words 4) 4)
        (= (array-ref words 5) 4)))))

(define (compiler-reg-color-storage-ranges-ok?) : bool
  (match (compiler-reg-color-storage-function)
    [(CompilerIrFunction.Function _ params _ vars blocks)
      (match (compiler-reg-color-stack-slots
        (CompilerRegPlan.Plan
          (compiler-reg-color-pointer-assignments)
          (compiler-live-set-empty)
          (compiler-reg-color-pointer-intervals)
          (compiler-reg-color-pointer-types)
          (compiler-reg-call-split-empty)
          (compiler-reg-split-plan-empty))
        (compiler-live-set-empty)
        params
        blocks
        vars
        vars)
        [(CompilerRegColoring.Remap remap slots)
          (and
            (= slots 2)
            (= (array-ref remap 0) 0)
            (= (array-ref remap 1) 1)
            (= (array-ref remap 3) 0)
            (= (array-ref remap 4) 1))]
        [(CompilerRegColoring.None) false])]))

(define (compiler-reg-color-stack-group-ok?) : bool
  (let
    [group-var : i64 7]
    [coloring : CompilerRegColoring
      (compiler-reg-color-stack-slots
        (CompilerRegPlan.Plan
          (compiler-reg-color-register-assignments-to (- group-var 1))
          (compiler-live-set-empty)
          (CompilerRegIntervalList.Cons
            (CompilerRegInterval.Interval group-var 0 2)
            (box CompilerRegIntervalList.Nil))
          (compiler-reg-var-type-cons
            (CompilerRegVarType.Type
              group-var
              (AstType.Struct (intern "RegGroup")))
            CompilerRegVarTypeList.Nil)
          (compiler-reg-call-split-empty)
          (compiler-reg-split-plan-empty))
        (compiler-live-set1 group-var)
        CompilerIrParamList.Nil
        CompilerIrBlockList.Nil
        (+ group-var 1)
        (+ group-var 1))]
    (match coloring
      [(CompilerRegColoring.Remap remap slots)
        (and
          (= slots 1)
          (= (array-ref remap group-var) 0)
          (<= (+ (array-ref remap group-var) 1) slots))]
      [(CompilerRegColoring.None) false])))

(cfg
  test
  (define (compiler-reg-liveness-handle-ok?) : bool
    (let
      [func : CompilerIrFunction (compiler-reg-edge-copy-linear-function)]
      [region : CompilerRegStringList
        (compiler-reg-string-cons "hot" CompilerRegStringList.Nil)]
      (begin
        (compiler-reg-liveness-census-reset!)
        (let
          [handle : CompilerRegLivenessHandle
            (compiler-reg-liveness-handle-make func true)]
          [liveness : CompilerFunctionLiveness (struct-get handle baseline)]
          (and
            (match (compiler-reg-edge-copy-plan-for-region-with-liveness
              liveness
              region
              0
              10
              (compiler-reg-i64-ty))
              [(CompilerRegEdgeCopyPlan.Plan _) true]
              [(CompilerRegEdgeCopyPlan.Refused _) false])
            (match (compiler-reg-edge-copy-plan-for-region-with-liveness
              liveness
              region
              0
              11
              (compiler-reg-i64-ty))
              [(CompilerRegEdgeCopyPlan.Plan _) true]
              [(CompilerRegEdgeCopyPlan.Refused _) false])
            (= (compiler-reg-liveness-census-baseline-count) 1)
            ;; The linear fixture is phi-free, so the edge-precise analysis is
            ;; the baseline itself and no second fixpoint is computed.
            (= (compiler-reg-liveness-census-edge-precise-count) 0)))))))

(cfg
  test
  (define (compiler-reg-liveness-handle-phi-fixture) : CompilerIrFunction
    (CompilerIrFunction.Function
      (compiler-ir-test-symbol "liveness_handle_phi")
      CompilerIrParamList.Nil
      (AstType.I64)
      2
      (compiler-ir-block-cons
        (compiler-ir-block
          "entry"
          (compiler-ir-instr-cons
            (CompilerIrInstr.Mov
              0
              (CompilerIrValue.I64 7)
              (compiler-reg-i64-ty))
            (compiler-ir-instr-cons
              (CompilerIrInstr.Jump "loop")
              CompilerIrInstrList.Nil)))
        (compiler-ir-block-cons
          (compiler-ir-block
            "loop"
            (compiler-ir-instr-cons
              (CompilerIrInstr.Phi
                1
                (CompilerIrPhiInputList.Cons
                  (CompilerIrValue.Var 0)
                  "entry"
                  (box
                    (CompilerIrPhiInputList.Cons
                      (CompilerIrValue.Var 1)
                      "loop"
                      (box CompilerIrPhiInputList.Nil))))
                (compiler-reg-i64-ty))
              (compiler-ir-instr-cons
                (CompilerIrInstr.Return
                  (CompilerIrMaybeValue.Some (CompilerIrValue.Var 1)))
                CompilerIrInstrList.Nil)))
          CompilerIrBlockList.Nil)))))

(cfg
  test
  (define (compiler-reg-liveness-handle-phi-ok?) : bool
    (begin
      (compiler-reg-liveness-census-reset!)
      (let
        [_handle : CompilerRegLivenessHandle
          (compiler-reg-liveness-handle-make
            (compiler-reg-liveness-handle-phi-fixture)
            true)]
        (and
          (= (compiler-reg-liveness-census-baseline-count) 1)
          ;; Phi present: the second, edge-precise fixpoint is computed.
          (= (compiler-reg-liveness-census-edge-precise-count) 1))))))

(cfg
  test
  (define (compiler-reg-group-pair-test-fill-homes!
    [assignments : CompilerRegAssignmentTable]
    [var : i64]
    [vars : i64]) : unit
    (if (or (>= var vars) (>= var 6))
      unit
      (let
        [_inserted : CompilerRegAssignmentTable
          (compiler-reg-assignment-table-insert
            assignments
            var
            (CompilerRegLocation.Register
              (compiler-reg-group-pair-csr (- var 1))))]
        (compiler-reg-group-pair-test-fill-homes! assignments (+ var 1) vars)))))

;; Keep the late pair pass honest without depending on an incidental whole
;; program's pressure shape. Cold scalars occupy every CSR so a call-spanning
;; component must evict two of them, while a clobber-free component keeps the
;; r8:r9 pair. A cold scalar in r8 proves caller-pair eviction, while a
;; synthetic call-save shadow reserves r8 over the same range. A normal-call
;; group argument stays eligible for a CSR pair, but not the caller pair,
;; until the multiword ABI marshaller can use the pair parallel-move solver.
(cfg
  test
  (define (compiler-reg-group-pair-widening-ok?) : bool
    (let
      [vars : i64 10]
      [interval-index : CompilerRegIntervalIndex
        (compiler-reg-interval-index-build
          (compiler-reg-interval-cons
            (CompilerRegInterval.Interval 0 0 10)
            (compiler-reg-interval-cons
              (CompilerRegInterval.Interval 1 0 10)
              (compiler-reg-interval-cons
                (CompilerRegInterval.Interval 2 0 10)
                (compiler-reg-interval-cons
                  (CompilerRegInterval.Interval 3 0 10)
                  (compiler-reg-interval-cons
                    (CompilerRegInterval.Interval 4 0 10)
                    (compiler-reg-interval-cons
                      (CompilerRegInterval.Interval 5 0 10)
                      (compiler-reg-interval-cons
                        (CompilerRegInterval.Interval 6 0 10)
                        (compiler-reg-interval-cons
                          (CompilerRegInterval.Interval 7 0 10)
                          (compiler-reg-interval-cons
                            (CompilerRegInterval.Interval 8 0 10)
                            (compiler-reg-interval-cons
                              (CompilerRegInterval.Interval 9 0 10)
                              CompilerRegIntervalList.Nil))))))))))
          vars)]
      [members : (Array i64) (array.make-array i64 vars)]
      [parents : (Array i64) (array.make-array i64 vars)]
      [poisoned : (Array bool) (array.make-array bool vars)]
      [weights : (Array i64) (array.make-array i64 vars)]
      [assignments : CompilerRegAssignmentTable
        (compiler-reg-assignment-table-make vars)]
      [csr-assignments : CompilerRegAssignmentTable
        (compiler-reg-assignment-table-make vars)]
      [caller-occupied : CompilerRegAssignmentTable
        (compiler-reg-assignment-table-make vars)]
      [nonoccupying : CompilerRegAssignmentTable
        (compiler-reg-assignment-table-make vars)]
      [shadow-regs : (Array String) (array.make-array String 2)]
      (begin
        (array-set! members 0 0)
        (compiler-reg-fill-i64-array weights 1)
        (array-set! weights 0 10)
        (let
          [v : i64 0]
          (while (< v vars)
            (begin
              (array-set! parents v v)
              (array-set! poisoned v false)
              (set! v (+ v 1)))))
        (array-set! shadow-regs 1 "%r8")
        (compiler-reg-group-pair-test-fill-homes! assignments 1 vars)
        (compiler-reg-group-pair-test-fill-homes! csr-assignments 1 vars)
        (compiler-reg-group-pair-test-fill-homes! caller-occupied 1 vars)
        (let
          [_nonoccupying-spill : CompilerRegAssignmentTable
            (compiler-reg-assignment-table-insert
              nonoccupying
              1
              (CompilerRegLocation.Spill (compiler-reg-stack-slot-offset 1)))]
          [_nonoccupying-pair : CompilerRegAssignmentTable
            (compiler-reg-assignment-table-insert
              nonoccupying
              2
              (CompilerRegLocation.RegisterPair "%r12" "%r13"))]
          [_caller-occupied-r8 : CompilerRegAssignmentTable
            (compiler-reg-assignment-table-insert
              caller-occupied
              1
              (CompilerRegLocation.Register "%r8"))]
          [_caller-occupied-r12 : CompilerRegAssignmentTable
            (compiler-reg-assignment-table-insert
              caller-occupied
              6
              (CompilerRegLocation.Register "%r12"))]
          [empty-split : CompilerRegCallSplit (compiler-reg-call-split-empty)]
          [shadow-split : CompilerRegCallSplit
            (CompilerRegCallSplit
              (compiler-live-set-empty)
              shadow-regs
              (CompilerRegCallRegionCons
                (CompilerRegCallRegion 1 0 10 0 0)
                (box CompilerRegCallRegionNil)))]
          [phi-excluded : CompilerLiveI64Set
            (compiler-reg-group-pair-excluded-instr
              (compiler-live-set-empty)
              (CompilerIrInstr.Phi
                0
                CompilerIrPhiInputList.Nil
                (AstType.Struct (intern "Pair")))
              (compiler-live-set1 0))]
          [call-caller-unsafe : CompilerLiveI64Set
            (compiler-reg-group-pair-caller-unsafe-instr
              (compiler-live-set-empty)
              (CompilerIrInstr.Call
                1
                (compiler-ir-test-symbol "callee")
                (CompilerIrCallArgs.One (CompilerIrValue.Var 0))
                (AstType.I64)))]
          [indirect-call-caller-unsafe : CompilerLiveI64Set
            (compiler-reg-group-pair-caller-unsafe-instr
              (compiler-live-set-empty)
              (CompilerIrInstr.CallIndirect
                1
                (CompilerIrValue.Var 2)
                (CompilerIrCallArgs.One (CompilerIrValue.Var 0))
                (AstType.I64)))]
          [indirect-c-call-caller-unsafe : CompilerLiveI64Set
            (compiler-reg-group-pair-caller-unsafe-instr
              (compiler-live-set-empty)
              (CompilerIrInstr.CallIndirectC
                1
                (CompilerIrValue.Var 2)
                (CompilerIrCallArgs.One (CompilerIrValue.Var 0))
                (AstType.I64)))]
          [shadow-cost : i64
            (compiler-reg-group-pair-component-register-cost
              assignments
              interval-index
              members
              1
              weights
              10
              true
              shadow-split
              "%r8"
              vars)]
          [free-r8-cost : i64
            (compiler-reg-group-pair-component-register-cost
              nonoccupying
              interval-index
              members
              1
              weights
              10
              true
              empty-split
              "%r8"
              vars)]
          [occupied-r8-cost : i64
            (compiler-reg-group-pair-component-register-cost
              caller-occupied
              interval-index
              members
              1
              weights
              10
              true
              empty-split
              "%r8"
              vars)]
          [csr-evict-cost : i64
            (compiler-reg-group-pair-component-register-cost
              assignments
              interval-index
              members
              1
              weights
              10
              false
              empty-split
              "%r12"
              vars)]
          [blocked-r12-cost : i64
            (compiler-reg-group-pair-component-register-cost
              nonoccupying
              interval-index
              members
              1
              weights
              10
              false
              empty-split
              "%r12"
              vars)]
          (let
            [_caller-placed : unit
              (compiler-reg-assign-group-pair-component
                0
                vars
                (compiler-reg-coalesce-test-i64-types vars)
                (compiler-live-set1 0)
                (compiler-live-set-empty)
                (compiler-live-set-empty)
                (struct-get interval-index starts)
                (struct-get interval-index ends)
                poisoned
                parents
                members
                interval-index
                caller-occupied
                weights
                (compiler-live-set-empty)
                empty-split)]
            [_csr-placed : unit
              (compiler-reg-assign-group-pair-component
                0
                vars
                (compiler-reg-coalesce-test-i64-types vars)
                (compiler-live-set1 0)
                (compiler-live-set-empty)
                (compiler-live-set1 0)
                (struct-get interval-index starts)
                (struct-get interval-index ends)
                poisoned
                parents
                members
                interval-index
                csr-assignments
                weights
                (compiler-live-set-empty)
                empty-split)]
            [_placed : unit
              (compiler-reg-assign-group-pair-component
                0
                vars
                (compiler-reg-coalesce-test-i64-types vars)
                (compiler-live-set1 0)
                (compiler-live-set-empty)
                (compiler-live-set-empty)
                (struct-get interval-index starts)
                (struct-get interval-index ends)
                poisoned
                parents
                members
                interval-index
                assignments
                weights
                (compiler-live-set-empty)
                empty-split)]
            (and
              (= (compiler-reg-group-pair-candidate-count true) 7)
              (string.eq (compiler-reg-group-pair-candidate true 0) "%r8")
              (string.eq (compiler-reg-group-pair-candidate true 1) "%r9")
              (string.eq (compiler-reg-group-pair-candidate true 2) "%r12")
              (= (compiler-reg-group-pair-candidate-count false) 5)
              (string.eq (compiler-reg-group-pair-candidate false 0) "%r12")
              (compiler-reg-group-pair-component-clobber-free?
                interval-index
                (compiler-live-set-empty)
                members
                1)
              (not
                (compiler-reg-group-pair-component-clobber-free?
                  interval-index
                  (compiler-live-set1 5)
                  members
                  1))
              (not (compiler-live-set-contains? phi-excluded 0))
              (compiler-live-set-contains? call-caller-unsafe 0)
              (compiler-live-set-contains? indirect-call-caller-unsafe 0)
              (compiler-live-set-contains? indirect-c-call-caller-unsafe 0)
              (compiler-reg-group-pair-component-contains?
                call-caller-unsafe
                members
                1)
              (= shadow-cost (- 0 1))
              (= free-r8-cost 0)
              (> occupied-r8-cost 0)
              (> csr-evict-cost 0)
              (= blocked-r12-cost (- 0 1))
              (match (compiler-reg-assignment-table-lookup assignments 0)
                [(CompilerRegMaybeLocation.Some location)
                  (match location
                    [(CompilerRegLocation.RegisterPair first second)
                      (and (string.eq first "%r8") (string.eq second "%r9"))]
                    [_ false])]
                [(CompilerRegMaybeLocation.No) false])
              (match (compiler-reg-assignment-table-lookup assignments 1)
                [(CompilerRegMaybeLocation.Some location)
                  (match location
                    [(CompilerRegLocation.Register reg) (string.eq reg "%r12")]
                    [_ false])]
                [(CompilerRegMaybeLocation.No) false])
              (match (compiler-reg-assignment-table-lookup caller-occupied 0)
                [(CompilerRegMaybeLocation.Some location)
                  (match location
                    [(CompilerRegLocation.RegisterPair first second)
                      (and (string.eq first "%r8") (string.eq second "%r9"))]
                    [_ false])]
                [(CompilerRegMaybeLocation.No) false])
              (match (compiler-reg-assignment-table-lookup caller-occupied 1)
                [(CompilerRegMaybeLocation.Some location)
                  (match location
                    [(CompilerRegLocation.Spill _) true]
                    [_ false])]
                [(CompilerRegMaybeLocation.No) false])
              (match (compiler-reg-assignment-table-lookup csr-assignments 0)
                [(CompilerRegMaybeLocation.Some location)
                  (match location
                    [(CompilerRegLocation.RegisterPair first second)
                      (and (string.eq first "%r12") (string.eq second "%r13"))]
                    [_ false])]
                [(CompilerRegMaybeLocation.No) false])
              (match (compiler-reg-assignment-table-lookup csr-assignments 1)
                [(CompilerRegMaybeLocation.Some location)
                  (match location
                    [(CompilerRegLocation.Spill _) true]
                    [_ false])]
                [(CompilerRegMaybeLocation.No) false])
              (match (compiler-reg-assignment-table-lookup csr-assignments 2)
                [(CompilerRegMaybeLocation.Some location)
                  (match location
                    [(CompilerRegLocation.Spill _) true]
                    [_ false])]
                [(CompilerRegMaybeLocation.No) false]))))))))

(define (compiler-regalloc-self-test-failure-message [name : String]) : String
  (string.append "regalloc self-test failed: " name))

(define (compiler-regalloc-self-test-require! [name : String] [ok : bool]) : unit
  (if ok
    unit
    (io.panic (compiler-regalloc-self-test-failure-message name))))

(define (compiler-regalloc-core-self-test?) : bool
  (begin
    (compiler-regalloc-self-test-require!
      "compiler-reg-low-bit-index32-powers-ok?"
      (cfg test (compiler-reg-low-bit-index32-powers-ok? 0 1) true))
    (compiler-regalloc-self-test-require!
      "compiler-reg-reuse-ok?"
      (compiler-reg-reuse-ok?))
    (compiler-regalloc-self-test-require!
      "compiler-reg-f64-reuse-ok?"
      (compiler-reg-f64-reuse-ok?))
    (compiler-regalloc-self-test-require!
      "compiler-reg-overlap-spill-ok?"
      (compiler-reg-overlap-spill-ok?))
    (compiler-regalloc-self-test-require!
      "compiler-reg-f64-overlap-spill-ok?"
      (compiler-reg-f64-overlap-spill-ok?))
    (compiler-regalloc-self-test-require!
      "compiler-reg-call-live-ok?"
      (compiler-reg-call-live-ok?))
    (compiler-regalloc-self-test-require!
      "compiler-reg-f64-call-live-ok?"
      (compiler-reg-f64-call-live-ok?))
    (compiler-regalloc-self-test-require!
      "compiler-reg-call-arg-ok?"
      (compiler-reg-call-arg-ok?))
    (compiler-regalloc-self-test-require!
      "compiler-reg-f64-call-arg-ok?"
      (compiler-reg-f64-call-arg-ok?))
    (compiler-regalloc-self-test-require!
      "compiler-reg-ineligible-ok?"
      (compiler-reg-ineligible-ok?))
    (compiler-regalloc-self-test-require!
      "compiler-reg-target-clobbers-ok?"
      (compiler-reg-target-clobbers-ok?))
    (compiler-regalloc-self-test-require!
      "compiler-reg-xmm-clobbers-ok?"
      (compiler-reg-xmm-clobbers-ok?))
    (compiler-regalloc-self-test-require!
      "compiler-reg-xmm-abi-call-constraints-ok?"
      (compiler-reg-xmm-abi-call-constraints-ok?))
    (compiler-regalloc-self-test-require!
      "compiler-reg-xmm-shared-greedy-bank-ok?"
      (compiler-reg-xmm-shared-greedy-bank-ok?))
    (compiler-regalloc-self-test-require!
      "compiler-reg-xmm-vector-class-reset-ok?"
      (compiler-reg-xmm-vector-class-reset-ok?))
    (compiler-regalloc-self-test-require!
      "compiler-reg-coalesce-ok?"
      (compiler-reg-coalesce-ok?))
    (compiler-regalloc-self-test-require!
      "compiler-reg-liveness-handle-ok?"
      (cfg test (compiler-reg-liveness-handle-ok?) true))
    (compiler-regalloc-self-test-require!
      "compiler-reg-liveness-handle-phi-ok?"
      (cfg test (compiler-reg-liveness-handle-phi-ok?) true))
    (compiler-regalloc-self-test-require!
      "compiler-reg-xmm-physical-ownership-ok?"
      (cfg test (compiler-reg-xmm-physical-ownership-ok?) true))
    (compiler-regalloc-self-test-require!
      "compiler-reg-dense-mask-on-vector-homes-ok?"
      (cfg test (compiler-reg-dense-mask-on-vector-homes-ok?) true))
    (compiler-regalloc-self-test-require!
      "compiler-reg-vector-mask-homes-ok?"
      (compiler-reg-vector-mask-homes-ok?))
    (compiler-regalloc-self-test-require!
