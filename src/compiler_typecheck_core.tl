          (set!
            compiler-tc-walk-rewalk-alloc
            (+
              compiler-tc-walk-rewalk-alloc
              (- (profile.alloc-total) compiler-tc-walk-rewalk-start-alloc)))
          (set!
            compiler-tc-walk-rewalk-live
