(define tc-lazy-import-stub-capacity : i64
  65536)

(define (tc-lazy-import-state-data-new [owner-arena : i64]) : TcLazyImportStateData
  (TcLazyImportStateData
    owner-arena
    (__tl_make-array i64 0)
    (__tl_make-array i64 0)
    (__tl_make-array i64 0)
    (__tl_make-array bool 0)
    (__tl_make-array i64 0)
    0
    -1
    -1
    0
    0))

(define (tc-lazy-import-state-address-initialize [state : TcMacroState]) : i64
  (let
    [address : i64
      (tc-macro-state-slot-address state tc-macro-state-slot-lazy-import)]
    (if (> address 0)
      address
      (let
        [owner : i64 (tc-macro-state-owner-arena state)]
        (in-arena
          (arena.Arena owner)
          (let
            [cell : (__tl_dyn-array TcLazyImportStateData)
              (__tl_make-array TcLazyImportStateData 1)]
            [_init : unit
              (set! (array-ref cell 0) (tc-lazy-import-state-data-new owner))]
            [next : i64
              (cast
                (unsafe
                  (ptr->int
                    (ptr-cast
                      (__tl_array-data cell)
                      : (Ptr TcLazyImportStateData))))
                : i64)]
            (tc-macro-state-slot-address-set!
              state
              tc-macro-state-slot-lazy-import
              next)
            next))))))

(define (tc-macro-state-lazy-import [state : TcMacroState]) : TcLazyImportState
  (TcLazyImportState
    (let
      [address : i64 (tc-macro-state-slot-address state 14)]
      (if (> address 0)
        address
        (tc-lazy-import-state-address-initialize state)))))

(define (tc-job-state-lazy-import [state : TcJobState]) : TcLazyImportState
  (tc-macro-state-lazy-import (tc-job-state-macro-state state)))

(define (tc-lazy-import-state-ptr [state : TcLazyImportState]) : (MutPtr
    TcLazyImportStateData)
  (tc-state-cell-ptr state.address TcLazyImportStateData))

(define (tc-lazy-import-state-view [state : TcLazyImportState]) : (Ptr
    TcLazyImportStateData)
  (tc-state-cell-view state.address TcLazyImportStateData))

(define (tc-lazy-import-state-data [state : TcLazyImportState]) : TcLazyImportStateData
  (tc-state-cell-read state.address TcLazyImportStateData))

(define (tc-lazy-import-stub-storage-ensure-for-state!
  [state : TcLazyImportState]) : unit
  (let
    [data : (MutPtr TcLazyImportStateData) (tc-lazy-import-state-ptr state)]
    (unsafe
      (if (=
        (array-length (deref data).index-slots)
        tc-lazy-import-stub-capacity)
        unit
        (let
          [owner : i64 (deref data).owner-arena]
          (in-arena
            (arena.Arena owner)
            (set!
              (deref data).module-ids
              (__tl_make-array i64 tc-lazy-import-stub-capacity))
            (set!
              (deref data).alias-ids
              (__tl_make-array i64 tc-lazy-import-stub-capacity))
            (set!
              (deref data).target-ids
              (__tl_make-array i64 tc-lazy-import-stub-capacity))
            (set!
              (deref data).summary-backed
              (__tl_make-array bool tc-lazy-import-stub-capacity))
            (set!
              (deref data).index-slots
              (__tl_make-array i64 tc-lazy-import-stub-capacity))))))))

(define (tc-lazy-import-stub-storage-ensure-for-job! [state : TcJobState]) : unit
  (tc-lazy-import-stub-storage-ensure-for-state!
    (tc-job-state-lazy-import state)))

;; Return either the matching record-index slot or the first empty slot. Slots
;; store record index + 1, so reset can clear the index without touching the
;; record arrays. Key equality is checked against those existing arrays.
(define (tc-lazy-import-stub-index-slot-for-data
  [data : (& data TcLazyImportStateData)]
  [importer-module-id : i64]
  [alias-id : i64]) : i64
  (let
    [cursor : i64
      (bit-and
        (+ (* importer-module-id 2654435761) (* alias-id 40503))
        (- tc-lazy-import-stub-capacity 1))]
    [probes : i64 0]
    [out : i64 -1]
    [done : bool false]
    (while (and (not done) (< probes tc-lazy-import-stub-capacity))
      (let
        [entry : i64 (array-ref data.index-slots cursor)]
        (if (= entry 0)
          (begin
            (set! out cursor)
            (set! done true))
          (let
            [record-index : i64 (- entry 1)]
            (if (and
              (= (array-ref data.module-ids record-index) importer-module-id)
              (= (array-ref data.alias-ids record-index) alias-id))
              (begin
                (set! out cursor)
                (set! done true))
              (begin
                (set!
                  cursor
                  (bit-and (+ cursor 1) (- tc-lazy-import-stub-capacity 1)))
                (set! probes (+ probes 1))))))))
    out))

(define (tc-lazy-import-stub-index-reset! [state : TcLazyImportState]) : unit
  (let
    [data : (Ptr TcLazyImportStateData) (tc-lazy-import-state-view state)]
    [slots : (__tl_dyn-array i64)
      (unsafe
        (deref data).index-slots)]
    [slot : i64 0]
    (while (< slot tc-lazy-import-stub-capacity)
      (set! (array-ref slots slot) 0)
      (set! slot (+ slot 1)))))

(define (tc-lazy-import-stub-index-record!
  [state : TcLazyImportState]
  [record-index : i64]
  [importer-module-id : i64]
  [alias-id : i64]
  [target-module-id : i64]) : unit
  (let
    [data : TcLazyImportStateData (tc-lazy-import-state-data state)]
    [slot : i64
      (tc-lazy-import-stub-index-slot-for-data
        (& data)
        importer-module-id
        alias-id)]
    (if (< slot 0)
      unit
      (let
        [entry : i64 (array-ref data.index-slots slot)]
        (if (or
          (= entry 0)
          (not (= target-module-id alias-id))
          (= (array-ref data.target-ids (- entry 1)) alias-id))
          (set! (array-ref data.index-slots slot) (+ record-index 1))
          unit)))))

(define (tc-lazy-import-stubs-reset-for-state! [state : TcMacroState]) : unit
  (let
    [lazy-state : TcLazyImportState (tc-macro-state-lazy-import state)]
    [_storage : unit (tc-lazy-import-stub-storage-ensure-for-state! lazy-state)]
    [data : (MutPtr TcLazyImportStateData)
      (tc-lazy-import-state-ptr lazy-state)]
    [source-names : ci.InternSourceNameSessionHandle
      (tc-macro-state-source-names state)]
    (unsafe
      (set! (deref data).record-count 0)
      (set! (deref data).summary-backed-count 0)
      (set! (deref data).summary-macro-force-count 0)
      (set!
        (deref data).intern-table-id
        (ci.intern-source-name-session-handle-table-id source-names))
      (set!
        (deref data).intern-generation
        (ci.intern-source-name-session-handle-reset-generation source-names)))
    (tc-lazy-import-stub-index-reset! lazy-state)))

(define (tc-lazy-import-stubs-reset-for-job! [state : TcJobState]) : unit
  (tc-lazy-import-stubs-reset-for-state! (tc-job-state-macro-state state)))

(define (tc-lazy-import-stubs-ensure-for-state!
  [state : TcMacroState]
  [lazy-state : TcLazyImportState]) : unit
  (let
    [source-names : ci.InternSourceNameSessionHandle
      (tc-macro-state-source-names state)]
    [data : (Ptr TcLazyImportStateData) (tc-lazy-import-state-view lazy-state)]
    (unsafe
      (if (and
        (=
          (deref data).intern-table-id
          (ci.intern-source-name-session-handle-table-id source-names))
        (=
          (deref data).intern-generation
          (ci.intern-source-name-session-handle-reset-generation source-names)))
        unit
        (tc-lazy-import-stubs-reset-for-state! state)))))

(define (tc-lazy-import-stub-count-for-state [state : TcMacroState]) : i64
  (let
    [lazy-state : TcLazyImportState (tc-macro-state-lazy-import state)]
    [_ready : unit (tc-lazy-import-stubs-ensure-for-state! state lazy-state)]
    (unsafe
      (deref (tc-lazy-import-state-view lazy-state)).record-count)))

(define (tc-lazy-import-summary-macro-force-count-for-state
  [state : TcMacroState]) : i64
  (let
    [lazy-state : TcLazyImportState (tc-macro-state-lazy-import state)]
    [_ready : unit (tc-lazy-import-stubs-ensure-for-state! state lazy-state)]
    (unsafe
      (deref (tc-lazy-import-state-view lazy-state)).summary-macro-force-count)))

(define (tc-lazy-import-summary-macro-force-record-for-state!
  [state : TcMacroState]) : unit
  (let
    [lazy-state : TcLazyImportState (tc-macro-state-lazy-import state)]
    [_ready : unit (tc-lazy-import-stubs-ensure-for-state! state lazy-state)]
    [data : (MutPtr TcLazyImportStateData)
      (tc-lazy-import-state-ptr lazy-state)]
    (unsafe
      (set!
        (deref data).summary-macro-force-count
        (+ (deref data).summary-macro-force-count 1)))))

(define (tc-lazy-import-summary-macro-force-reset-for-state!
  [state : TcMacroState]) : unit
  (let
    [lazy-state : TcLazyImportState (tc-macro-state-lazy-import state)]
    [_ready : unit (tc-lazy-import-stubs-ensure-for-state! state lazy-state)]
    [data : (MutPtr TcLazyImportStateData)
      (tc-lazy-import-state-ptr lazy-state)]
    (unsafe
      (set! (deref data).summary-macro-force-count 0))))

(define (tc-lazy-import-stub-record-for-job!
  [job-state : TcJobState]
  [importer-module-id : i64]
  [alias-id : i64]
  [target-module-id : i64]
  [summary-backed : bool]) : unit
  (let
    [macro-state : TcMacroState (tc-job-state-macro-state job-state)]
    [lazy-state : TcLazyImportState (tc-macro-state-lazy-import macro-state)]
    [_ready : unit
      (tc-lazy-import-stubs-ensure-for-state! macro-state lazy-state)]
    [data : (MutPtr TcLazyImportStateData)
      (tc-lazy-import-state-ptr lazy-state)]
    (unsafe
      (tc-top-env-resolution-inputs-changed!)
      (if (< (deref data).record-count tc-lazy-import-stub-capacity)
        (let
          [index : i64 (deref data).record-count]
          (set! (array-ref (deref data).module-ids index) importer-module-id)
          (set! (array-ref (deref data).alias-ids index) alias-id)
          (set! (array-ref (deref data).target-ids index) target-module-id)
          (set! (array-ref (deref data).summary-backed index) summary-backed)
          (tc-lazy-import-stub-index-record!
            lazy-state
            index
            importer-module-id
            alias-id
            target-module-id)
          (set! (deref data).record-count (+ index 1)))
        unit)
      (if summary-backed
        (set!
          (deref data).summary-backed-count
          (+ (deref data).summary-backed-count 1))
        unit)
      (tc-job-state-reset-derived-caches! job-state))))

(define (tc-lazy-import-stub-target-indexed-for-state
  [state : TcMacroState]
  [importer-module-id : i64]
  [alias-id : i64]) : TcMaybeNameId
  (let
    [lazy-state : TcLazyImportState (tc-macro-state-lazy-import state)]
    [_ready : unit (tc-lazy-import-stubs-ensure-for-state! state lazy-state)]
    [data : TcLazyImportStateData (tc-lazy-import-state-data lazy-state)]
    [slot : i64
      (tc-lazy-import-stub-index-slot-for-data
        (& data)
        importer-module-id
        alias-id)]
    (if (< slot 0)
      (No)
      (let
        [entry : i64 (array-ref data.index-slots slot)]
        (if (= entry 0)
          (No)
          (Some (array-ref data.target-ids (- entry 1))))))))

(define (tc-lazy-import-stub-target-id-for-state
  [state : TcMacroState]
  [importer-module-id : i64]
  [alias-id : i64]) : TcMaybeNameId
  (tc-lazy-import-stub-target-indexed-for-state
    state
    importer-module-id
    alias-id))

;; Lazy loading retains macro bodies in surface summaries without flattening
;; the defining module's import markers into the active program. Preserve that
;; definition environment in the same alias-stub index used by materialized
;; imports. The surface edge carries its lexical owner because one source can
;; contain nested module bodies with independent alias environments.
(define (tc-lazy-import-surface-import-stub-record-for-job!
  [job-state : TcJobState]
  [import-edge : cload.CompilerLoadSurfaceImport]) : unit
  (match import-edge.kind
    [(CompilerLoadSurfaceImportModule)
      (match import-edge.module-name
        [(CompilerLoadSurfaceSomeString target-module)
          (match import-edge.alias
            [(CompilerLoadSurfaceSomeString alias)
              (let
                [alias-id : i64 (ci.intern alias)]
                [target-module-id : i64 (ci.intern target-module)]
                (match (tc-lazy-import-stub-target-indexed-for-state
                  (tc-job-state-macro-state job-state)
                  import-edge.module
                  alias-id)
                  [(Some existing-target)
                    (if (= existing-target target-module-id)
                      unit
                      (tc-lazy-import-stub-record-for-job!
                        job-state
                        import-edge.module
                        alias-id
                        target-module-id
                        true))]
                  [(No)
                    (tc-lazy-import-stub-record-for-job!
                      job-state
                      import-edge.module
                      alias-id
                      target-module-id
                      true)]))]
            [(CompilerLoadSurfaceNoString) unit])]
        [(CompilerLoadSurfaceNoString) unit])]
    [_ unit]))

(define (tc-lazy-import-surface-summary-stubs-record-for-job!
  [job-state : TcJobState]
  [summary : cload.CompilerLoadSurfaceSummary]) : unit
  (let
    [imports : cload.CompilerLoadSurfaceImportList summary.imports]
    [index : i64 0]
    (while (< index (cload.compiler-load-surface-import-list-count imports))
      (tc-lazy-import-surface-import-stub-record-for-job!
        job-state
        (cload.compiler-load-surface-import-list-at imports index))
      (set! index (+ index 1)))))

(define (tc-lazy-import-surface-stubs-record-for-job! [job-state : TcJobState]) : unit
  (let
    [summaries : cload.CompilerLoadSurfaceSummaryList
      (cload.compiler-load-surface-summaries)]
    [index : i64 0]
    (while (< index (cload.compiler-load-surface-summary-list-count summaries))
      (tc-lazy-import-surface-summary-stubs-record-for-job!
        job-state
        (cload.compiler-load-surface-summary-list-at summaries index))
      (set! index (+ index 1)))))

;; Generated declarations can be checked before their source module's marker is
;; reached in the expansion walk. Use an alias-wide target only when every
;; concrete recorded target that exports the requested type resolves to the
;; same symbol handle; otherwise preserve the ordinary unresolved result.
(define (tc-lazy-import-unique-type-key-id
  [state : TcMacroState]
  [symbols : (& symbols csym.CompilerSymbols)]
  [alias-id : i64]
  [base-id : i64]) : TcMaybeNameId
  (let
    [lazy-state : TcLazyImportState (tc-macro-state-lazy-import state)]
    [_ready : unit (tc-lazy-import-stubs-ensure-for-state! state lazy-state)]
    [data : (Ptr TcLazyImportStateData) (tc-lazy-import-state-view lazy-state)]
    [index : i64
      (-
        (unsafe
          (deref data).record-count)
        1)]
    [found-key : i64 -1]
    [found-handle : i64 -1]
    [ambiguous : bool false]
    (while (and (not ambiguous) (>= index 0))
      (let
        [stub-alias-id : i64
          (array-ref
            (unsafe
              (deref data).alias-ids)
            index)]
        [target-id : i64
          (array-ref
            (unsafe
              (deref data).target-ids)
            index)]
        (if (and (= stub-alias-id alias-id) (not (= target-id alias-id)))
          (let
            [key-id : i64
              (csym.compiler-symbol-module-key-id-by-id target-id base-id)]
            [handle : i64
              (tc-type-handle-lookup-id
                (tc-macro-state-nominal-cache state)
                symbols
                key-id
                tc-type-handle-lookup-caller-lazy-unique)]
            (if (csym.compiler-symbols-handle-found? handle)
              (if (< found-handle 0)
                (begin
                  (set! found-key key-id)
                  (set! found-handle handle))
                (if (= handle found-handle)
                  unit
                  (set! ambiguous true)))
              unit))
          unit)
        (set! index (- index 1))))
    (if (and (not ambiguous) (>= found-handle 0))
      (Some found-key)
      (No))))

(define (tc-source-dotted-alias-target-id
  [state : TcMacroState]
  [decls : ast.AstDeclList]
  [current-module-id : i64]
  [alias-id : i64]) : TcMaybeNameId
  (match (tc-lazy-import-stub-target-id-for-state
    state
    current-module-id
    alias-id)
    [(Some target-module-id)
      (if (= target-module-id alias-id)
        (macro-import-alias-target-cached-id
          state
          decls
          current-module-id
          alias-id)
        (Some target-module-id))]
    [(No)
      (macro-import-alias-target-cached-id
        state
        decls
        current-module-id
        alias-id)]))

(define (tc-source-dotted-alias-target-id-in-context
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [current-module-id : i64]
  [alias-id : i64]) : TcMaybeNameId
  (match (tc-lazy-import-stub-target-id-for-state
    (tc-context-macro-state ctx)
    current-module-id
    alias-id)
    [(Some target-module-id)
      (if (= target-module-id alias-id)
        (macro-import-alias-target-cached-id-in-context
          ctx
          decls
          current-module-id
          alias-id)
        (Some target-module-id))]
    [(No)
      (macro-import-alias-target-cached-id-in-context
        ctx
        decls
        current-module-id
        alias-id)]))

(define (tc-call-builtin-lookup-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-name : String]
  [source-id : i64]) : i64
  (cond
    [(< source-id 0) source-id]
    [(and
        (not (tc-hygiene-local-name? source-name))
        (tc-name-qualified-id? (tc-context-structural-session ctx) source-id))
      source-id]
    [(>= (tc-name-first-dot-id (tc-context-structural-session ctx) source-id) 0)
      (match (tc-source-name-lookup-key-with-field-check-lookup
        ctx
        env
        source-name
        source-id
        true)
        [(Ok lookup-name lookup-id)
          (cbi.compiler-builtin-refresh!)
          lookup-id]
        [(Err _) source-id])]
    [else source-id]))

(define (tc-call-variant-name-id? [ctx : TcContext] [name-id : i64]) : bool
  (if (< name-id 0)
    false
    (match (tc-enum-qualified-variant-lookup-handle ctx name-id)
      [(Some _) true]
      [(None) false])))

(define (tc-source-dotted-alias-key
  [ctx : TcContext]
  [name : (& name str)]
  [name-id : i64]
  [first-dot : i64]
  [current-module-id : i64]) : TcMaybeString
  (let
    [n : i64 (string.string-length name)]
    (if (or (<= first-dot 0) (>= first-dot (- n 1)))
      (No)
      (let
        [alias-id : i64 (ci.intern-leading-dot-id name-id)]
        [cached : i64
          (tc-context-source-dotted-alias-key-cache-get
            ctx
            current-module-id
            name-id)]
        (if (= cached -2)
          (let
            [base-id : i64 (ci.intern-dotted-tail-id name-id)]
            (match (tc-context-program ctx)
              [(Program decls-box)
                (match (macro-import-alias-target-cached-id-in-context
                  ctx
                  (ast.ast-decl-list-box-shared-view decls-box)
                  current-module-id
                  alias-id)
                  [(Some target-module-id)
                    (if (< base-id 0)
                      (No)
                      (let
                        [lookup-name : String
                          (csym.compiler-symbol-module-key
                            (tc-env-key-name-text target-module-id)
                            (ci.intern-str base-id))]
                        [lookup-id : i64
                          (tc-qualified-name-key-id target-module-id base-id)]
                        (tc-context-source-dotted-alias-key-cache-put!
                          ctx
                          current-module-id
                          name-id
                          lookup-id)
                        (Some lookup-name)))]
                  [(No)
                    (tc-context-source-dotted-alias-key-cache-put!
                      ctx
                      current-module-id
                      name-id
                      -1)
                    (No)])]))
          (if (< cached 0)
            (No)
            (Some (tc-nominal-name-id-display cached))))))))

(define (tc-source-alias-display-key
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : TcMaybeString
  (let
    [n : i64 (string.string-length name)]
    [first-dot : i64
      (tc-name-first-dot-id (tc-context-structural-session ctx) name-id)]
    (if (or (<= first-dot 0) (>= first-dot (- n 1)))
      (No)
      (let
        [alias-id : i64 (ci.intern-leading-dot-id name-id)]
        [alias : String (string.substring name 0 first-dot)]
        [base-start : i64 (+ first-dot 1)]
        [base : String (string.substring name base-start (- n base-start))]
        [program : ast.AstProgram (tc-context-program ctx)]
        [current-module-id : i64 (tc-context-module-id ctx)]
        (match program
          [(Program decls-box)
            (match (macro-import-alias-target-cached-id-in-context
              ctx
              (ast.ast-decl-list-box-shared-view decls-box)
              current-module-id
              alias-id)
              [(Some target-id)
                (if (= target-id alias-id)
                  (No)
                  (Some (csym.compiler-symbol-module-key alias base)))]
              [(No) (No)])])))))

(define (tc-source-lookup-display-name
  [ctx : TcContext]
  [source-name : String]
  [source-name-id : i64]
  [lookup-name : String]) : String
  (match (tc-source-alias-display-key ctx source-name source-name-id)
    [(Some display-name) display-name]
    [(No) lookup-name]))

(define (tc-source-unbound-display-message
  [ctx : TcContext]
  [source-name : String]
  [source-name-id : i64]
  [lookup-name : String]
  [message : String]) : String
  (match (tc-source-alias-display-key ctx source-name source-name-id)
    [(Some display-name)
      (if (string.eq
        message
        (str_cat.str-cat
          (cdiag.compiler-diagnostic-typecheck-tag (UnboundName))
          "typecheck: unbound name "
          lookup-name))
        (str_cat.str-cat
          (cdiag.compiler-diagnostic-typecheck-tag (UnboundName))
          "typecheck: unbound name "
          display-name)
        message)]
    [(No) message]))

(define (tc-dotted-prefix-depth [name-id : i64]) : i64
  (let
    [current : i64 name-id]
    [depth : i64 0]
    (while (>= (ci.intern-first-dot current) 0)
      (set! depth (+ depth 1))
      (set! current (ci.intern-dotted-prefix-id current)))
    depth))

(define (tc-dotted-tail-after [name-id : i64] [count : i64]) : i64
  (let
    [current : i64 name-id]
    [remaining : i64 count]
    (while (and (> remaining 0) (>= current 0))
      (set! current (ci.intern-dotted-tail-id current))
      (set! remaining (- remaining 1)))
    current))

(define (tc-source-dotted-full-path-key-from-id
  [ctx : TcContext]
  [_name : (& _name str)]
  [name-id : i64]
  [current-module-id : i64]) : TcMaybeString
  (let
    [cached : i64
      (tc-context-source-dotted-full-path-key-cache-get
        ctx
        current-module-id
        name-id)]
    (if (= cached -2)
      (let
        [candidate-id : i64 (ci.intern-dotted-prefix-id name-id)]
        [module-id : i64 -1]
        (while (and (>= candidate-id 0) (< module-id 0))
          (if (or
            (= candidate-id current-module-id)
            (tc-imported-module-identity-id? ctx candidate-id))
            (set! module-id candidate-id)
            (set! candidate-id (ci.intern-dotted-prefix-id candidate-id))))
        (if (>= module-id 0)
          (let
            [base-id : i64
              (tc-dotted-tail-after
                name-id
                (+ (tc-dotted-prefix-depth module-id) 1))]
            [lookup-name : String
              (csym.compiler-symbol-module-key
                (tc-env-key-name-text module-id)
                (ci.intern-str base-id))]
            [lookup-id : i64 (tc-qualified-name-key-id module-id base-id)]
            (tc-context-source-dotted-full-path-key-cache-put!
              ctx
              current-module-id
              name-id
              lookup-id)
            (Some lookup-name))
          (begin
            (tc-context-source-dotted-full-path-key-cache-put!
              ctx
              current-module-id
              name-id
              -1)
            (No))))
      (if (< cached 0)
        (No)
        (Some (tc-nominal-name-id-display cached))))))

(define (tc-unresolved-dotted-name-message [name : String]) : String
  (str_cat.str-cat
    "typecheck: unknown qualified name "
    name
    "; import the module or use a visible dotted module alias"))

(define (tc-string-prefix-at?
  [text : (& text str)]
  [prefix : String]
  [start : i64]) : bool
  (string.is-string-prefix-at (& text) (& prefix) start))

(define (tc-comptime-helper-qualified-candidate-from-id?
  [name : String]
  [name-id : i64]
  [first-dot : i64]) : bool
  (if (<= first-dot 0)
    false
    ;; The prefixes are builtin ids, which already follow the active intern
    ;; table; mirroring them in generation-stamped cells added only state.
    (let
      [prefix-id : i64 (ci.intern-leading-dot-id name-id)]
      (cond
        [(or
            (= prefix-id cbi.compiler-builtin-id-fix-comptime)
            (= prefix-id cbi.compiler-builtin-id-fix-stdlib_slash_comptime)
            (= prefix-id cbi.compiler-builtin-id-fix-string)
            (= prefix-id cbi.compiler-builtin-id-fix-stdlib_slash_string))
          true]
        [(= prefix-id cbi.compiler-builtin-id-fix-stdlib)
          (or
            (tc-string-prefix-at? name "comptime." (+ first-dot 1))
            (tc-string-prefix-at? name "comptime/" (+ first-dot 1))
            (tc-string-prefix-at? name "string." (+ first-dot 1))
            (tc-string-prefix-at? name "string/" (+ first-dot 1)))]
        [else false]))))

(define (tc-comptime-helper-qualified-lookup-key
  [env : TcTypeEnv]
  [name : String]
  [name-id : i64]
  [first-dot : i64]) : TcMaybeString
  (match (tc-comptime-helper-qualified-lookup-key-id env name name-id first-dot)
    [(Some call-name-id) (Some (ci.intern-str call-name-id))]
    [(No) (No)]))

(define (tc-comptime-helper-qualified-lookup-key-id
  [env : TcTypeEnv]
  [name : String]
  [name-id : i64]
  [first-dot : i64]) : TcMaybeNameId
  (if (tc-comptime-helper-qualified-candidate-from-id? name name-id first-dot)
    (let
      [call-name-id : i64
        (ctfe_support.ctfe-comptime-helper-call-name-id name-id)]
      (if (and
        (>= call-name-id 0)
        (not (= call-name-id name-id))
        (ctfe_support.ctfe-comptime-syntax-helper-id? call-name-id)
        (tc-source-name-bound-exact-id? env call-name-id))
        (Some call-name-id)
        (No)))
    (No)))

;; Variant taking the already-interned `name-id`; reads the first-dot position
;; from id-keyed metadata instead of re-hashing `name`.
(define (tc-dotted-type-name-lookup-key-from-id
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : ResultTcString
  (let
    [first-dot : i64
      (tc-name-first-dot-id (tc-context-structural-session ctx) name-id)]
    (if (< first-dot 0)
      (Ok name)
      (let
        [current-module-id : i64 (tc-context-module-id ctx)]
        (match (tc-source-dotted-alias-key
          ctx
          name
          name-id
          first-dot
          current-module-id)
          [(Some key) (Ok key)]
          [(No)
            (match (tc-source-dotted-full-path-key-from-id
              ctx
              name
              name-id
              current-module-id)
              [(Some key) (Ok key)]
              [(No) (Err (tc-unresolved-dotted-name-message name))])])))))

(define (tc-dotted-resolved-key-id-or
  [ctx : TcContext]
  [name-id : i64]
  [fallback : i64]) : i64
  (let
    [module-id : i64 (tc-context-module-id ctx)]
    [alias-key-id : i64
      (tc-context-source-dotted-alias-key-cache-get ctx module-id name-id)]
    (if (>= alias-key-id 0)
      alias-key-id
      (let
        [full-key-id : i64
          (tc-context-source-dotted-full-path-key-cache-get
            ctx
            module-id
            name-id)]
        (if (>= full-key-id 0)
          full-key-id
          fallback)))))

(define (tc-dotted-type-name-lookup-from-id
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : TcNameLookup
  (let
    [key
      (try
        (tc-dotted-type-name-lookup-key-from-id
          ctx
          (tc-global-shared-view name)
          name-id))]
    [resolved-key-id : i64 (tc-dotted-resolved-key-id-or ctx name-id -1)]
    [key-id : i64
      (if (>= resolved-key-id 0)
        resolved-key-id
        (if (string.eq key name)
          name-id
          -1))]
    (if (>= key-id 0)
      (Ok key key-id)
      (Err "typecheck: resolved type name has no interned identity"))))

(define (tc-source-type-name-lookup-key
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : ResultTcString
  (if (tc-source-slash-qualified-id?
    (tc-context-structural-session ctx)
    (tc-global-shared-view name)
    name-id)
    (Err (tc-source-slash-qualified-message name))
    (tc-dotted-type-name-lookup-key-from-id ctx name name-id)))

(define (tc-source-type-name-lookup-from-id
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : TcNameLookup
  (if (tc-source-slash-qualified-id?
    (tc-context-structural-session ctx)
    (tc-global-shared-view name)
    name-id)
    (Err (tc-source-slash-qualified-message name))
    (tc-dotted-type-name-lookup-from-id ctx name name-id)))

(define (tc-enum-qualified-variant-lookup-name-id?
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : bool
  (if (csym.compiler-composite-triple-key-id? name-id)
    true
    (let
      [base-id : i64
        (if (tc-name-qualified-id? session name-id)
          (tc-qualified-name-base-id name-id)
          name-id)]
      (and
        (>= base-id 0)
        (< base-id (ci.intern-capacity))
        (>= (tc-name-first-dot-id session base-id) 0)))))

(define (tc-enum-qualified-variant-lookup-handle
  [ctx : TcContext]
  [name-id : i64]) : option_i64.Option
  (let
    [registries : (& ctx csym.CompilerRegistries) (tc-context-registries ctx)]
    [module-id : i64 (tc-context-module-id ctx)]
    [registry-id : i64 (csym.compiler-registries-identity registries)]
    [cached-handle : i64
      (tc-context-source-qualified-variant-handle-cache-get
        ctx
        registry-id
        module-id
        name-id)]
    (if (>= cached-handle 0)
      (Some cached-handle)
      (if (= cached-handle -1)
        None
        (match (tc-enum-qualified-variant-lookup-key-id ctx name-id module-id)
          [(Some key-id)
            (let
              [resolved-handle : i64
                (tc-context-source-qualified-variant-handle-cache-get
                  ctx
                  registry-id
                  module-id
                  name-id)]
              (if (>= resolved-handle 0)
                (Some resolved-handle)
                (csym.compiler-registries-lookup-variant-key-id
                  registries
                  key-id)))]
          [(None) None])))))

(define (tc-enum-qualified-variant-constructor-handle
  [ctx : TcContext]
  [name-id : i64]) : option_i64.Option
  (match (tc-enum-qualified-variant-lookup-handle ctx name-id)
    [(Some handle) (Some handle)]
    [(None) (tc-enum-qualified-variant-declaration-handle ctx name-id)]))

(define (tc-enum-qualified-variant-declaration-handle
  [ctx : TcContext]
  [name-id : i64]) : option_i64.Option
  (let
    [base-id : i64
      (if (tc-name-qualified-id? (tc-context-structural-session ctx) name-id)
        (tc-qualified-name-base-id name-id)
        name-id)]
    [dotted-parts-id : i64 (tc-enum-qualified-variant-dotted-parts-id base-id)]
    [enum-id : i64
      (cond
        [(csym.compiler-composite-triple-key-id? base-id)
          (csym.compiler-composite-triple-middle-id base-id)]
        [(csym.compiler-composite-pair-key-id? base-id)
          (csym.compiler-composite-pair-left-id base-id)]
        [(csym.compiler-composite-pair-key-id? dotted-parts-id)
          (csym.compiler-composite-pair-left-id dotted-parts-id)]
        [else -1])]
    [variant-id : i64
      (cond
        [(csym.compiler-composite-triple-key-id? base-id)
          (csym.compiler-composite-triple-right-id base-id)]
        [(csym.compiler-composite-pair-key-id? base-id)
          (csym.compiler-composite-pair-right-id base-id)]
        [(csym.compiler-composite-pair-key-id? dotted-parts-id)
          (csym.compiler-composite-pair-right-id dotted-parts-id)]
        [else -1])]
    (if (or (< enum-id 0) (< variant-id 0))
      None
      (match (tc-variant-handle-for-enum-id-and-name-id ctx enum-id variant-id)
        [(Some handle) (Some handle)]
        [(None)
          (tc-variant-handle-for-canonical-enum-id-and-name-id
            ctx
            enum-id
            variant-id)]))))

(define (tc-enum-qualified-variant-dotted-parts-id [name-id : i64]) : i64
  (if (or (< name-id 0) (>= name-id (ci.intern-capacity)))
    -1
    (let
      [name : String (tc-env-key-name-text name-id)]
      [len : i64 (string.string-length name)]
      [data : (Ptr u8)
        (unsafe
          (string-data (& name)))]
      [last-dot : i64 -1]
      [index : i64 0]
      (while (< index len)
        (if (=
          (unsafe
            (ptr-read (ptr-offset data index)))
          (cast 46 : u8))
          (set! last-dot index)
          unit)
        (set! index (+ index 1)))
      (if (or (<= last-dot 0) (>= last-dot (- len 1)))
        -1
        (csym.compiler-composite-pair-key-id
          (ci.intern (string.substring name 0 last-dot))
          (ci.intern
            (string.substring name (+ last-dot 1) (- len (+ last-dot 1)))))))))

(define (tc-enum-qualified-variant-lookup-key-id
  [ctx : TcContext]
  [name-id : i64]
  [module-id : i64]) : option_i64.Option
  (if (tc-enum-qualified-variant-lookup-name-id?
    (tc-context-structural-session ctx)
    name-id)
    (let
      [registries : (& ctx csym.CompilerRegistries) (tc-context-registries ctx)]
      [module : String (tc-context-module ctx)]
      [registry-id : i64 (csym.compiler-registries-identity registries)]
      [cached : i64
        (tc-context-source-qualified-variant-key-cache-get
          ctx
          registry-id
          module-id
          name-id)]
      (if (= cached -2)
        (let
          [structural : bool (>= name-id (ci.intern-capacity))]
          [module-key-id : i64
            (if (and
              (not structural)
              (> (string.string-length module) 0)
              (not
                (tc-name-qualified-id?
                  (tc-context-structural-session ctx)
                  name-id)))
              (csym.compiler-symbol-dotted-variant-key-id-in-module-or
                name-id
                module-id
                -1)
              -1)]
          [module-handle : i64
            (if (< module-key-id 0)
              -1
              (match (csym.compiler-registries-lookup-variant-key-id
                registries
                module-key-id)
                [(Some handle) handle]
                [(None) -1]))]
          [fallback-key-id : i64
            (if structural
              (csym.compiler-symbol-name-id-key name-id)
              (csym.compiler-symbol-dotted-variant-key-id-in-module-or
                name-id
                (csym.compiler-symbol-root-module-id)
                -1))]
          [fallback-handle : i64
            (if (or (>= module-handle 0) (< fallback-key-id 0))
              -1
              (match (csym.compiler-registries-lookup-variant-key-id
                registries
                fallback-key-id)
                [(Some handle) handle]
                [(None) -1]))]
          [resolved : i64
            (if (>= module-handle 0)
              module-key-id
              (if (>= fallback-handle 0)
                fallback-key-id
                -1))]
          [resolved-handle : i64
            (if (>= module-handle 0)
              module-handle
              fallback-handle)]
          (tc-context-source-qualified-variant-key-cache-put!
            ctx
            registry-id
            module-id
            name-id
            resolved
            resolved-handle)
          (if (< resolved 0)
            None
            (Some resolved)))
        (if (< cached 0)
          None
          (Some cached))))
    None))

(define (tc-enum-qualified-variant-lookup-key-from-id
  [ctx : TcContext]
  [name : String]
  [name-id : i64]
  [module-id : i64]) : ResultTcString
  (match (tc-enum-qualified-variant-lookup-key-id ctx name-id module-id)
    [(Some key-id)
      (Ok
        (if (csym.compiler-composite-triple-key-id? key-id)
          (tc-nominal-name-id-display key-id)
          name))]
    [(None) (Err "")]))

(define (tc-source-name-lookup-key-with-field-check
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [name-id : i64]
  [check-local-field : bool]) : ResultTcString
  ;; Intern `name` once; every metadata query below reads the id-keyed slots
  ;; instead of re-hashing the string for each of slash-qualified?, first-dot,
  ;; leading-segment and bound-exact?. This is the hottest name-resolution
  ;; function. The already-interned `name-id` is threaded
  ;; from the caller (AST field or upstream intern) so this hot path never
  ;; re-interns the string; the public String wrappers below intern once.
  (if (tc-source-slash-qualified-id?
    (tc-context-structural-session ctx)
    (tc-global-shared-view name)
    name-id)
    (Err (tc-source-slash-qualified-message name))
    (let
      [first-dot : i64
        (tc-name-first-dot-id (tc-context-structural-session ctx) name-id)]
      (if (< first-dot 0)
        (if (tc-source-name-bound-exact-id? env name-id)
          (Ok name)
          (match (tc-current-module-source-lookup-key ctx env name name-id)
            [(Some key) (Ok key)]
            [(No) (Ok name)]))
        (if (and
          check-local-field
          (tc-source-leading-segment-wins-over-exact-from-id?
            env
            name
            name-id
            first-dot))
          (Ok name)
          (match (tc-comptime-helper-qualified-lookup-key
            env
            (tc-global-shared-view name)
            name-id
            first-dot)
            [(Some key) (Ok key)]
            [(No)
              (let
                [current-module-id : i64 (tc-context-module-id ctx)]
                (match (tc-source-dotted-alias-key
                  ctx
                  name
                  name-id
                  first-dot
                  current-module-id)
                  [(Some key) (Ok key)]
                  [(No)
                    (match (tc-enum-qualified-variant-lookup-key-from-id
                      ctx
                      (tc-global-shared-view name)
                      name-id
                      current-module-id)
                      [(Ok key) (Ok key)]
                      [(Err _)
                        (match (tc-source-dotted-full-path-key-from-id
                          ctx
                          name
                          name-id
                          current-module-id)
                          [(Some key) (Ok key)]
                          [(No)
                            (if (tc-source-name-bound-exact-id? env name-id)
                              (Ok name)
                              (Err (tc-unresolved-dotted-name-message name)))])])]))]))))))

;; id-returning variant of tc-source-name-lookup-key-with-field-check. Takes the
;; already-interned name-id (the AST stores it) so it does not (intern name),
;; and returns the resolved lookup name together with its id, so the hot tc-expr
;; Var path gets the lookup id without re-interning the returned String. For the
;; common bound-name case the result id is the passed name-id (zero interning);
;; qualified/dotted cases carry the ID already recorded by their resolver
;; caches instead of recovering identity from a generated display String.
(define (tc-source-name-lookup-key-with-field-check-source-lookup
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [name-id : i64]
  [check-local-field : bool]) : TcNameLookup
  (if (tc-source-slash-qualified-id?
    (tc-context-structural-session ctx)
    (tc-global-shared-view name)
    name-id)
    (Err (tc-source-slash-qualified-message name))
    (let
      [first-dot : i64
        (tc-name-first-dot-id (tc-context-structural-session ctx) name-id)]
      (if (< first-dot 0)
        (if (tc-source-name-bound-exact-id? env name-id)
          (Ok name name-id)
          (match (tc-current-module-source-lookup-key-id ctx env name-id)
            [(Some key-id)
              (Ok
                (tc-env-key-display (tc-context-structural-session ctx) key-id)
                key-id)]
            [(No) (Ok name name-id)]))
        (if (and
          check-local-field
          (tc-source-leading-segment-wins-over-exact-from-id?
            env
            name
            name-id
            first-dot))
          (Ok name name-id)
          (match (tc-comptime-helper-qualified-lookup-key-id
            env
            (tc-global-shared-view name)
            name-id
            first-dot)
            [(Some key-id) (Ok (ci.intern-str key-id) key-id)]
            [(No)
              (let
                [current-module-id : i64 (tc-context-module-id ctx)]
                (match (tc-source-dotted-alias-key
                  ctx
                  name
                  name-id
                  first-dot
                  current-module-id)
                  [(Some key)
                    (Ok
                      key
                      (tc-context-source-dotted-alias-key-cache-get
                        ctx
                        current-module-id
                        name-id))]
                  [(No)
                    (match (tc-enum-qualified-variant-lookup-key-id
                      ctx
                      name-id
                      current-module-id)
                      [(Some key-id)
                        (Ok
                          (if (csym.compiler-composite-triple-key-id? key-id)
                            (tc-nominal-name-id-display key-id)
                            name)
                          key-id)]
                      [(None)
                        (match (tc-source-dotted-full-path-key-from-id
                          ctx
                          name
                          name-id
                          current-module-id)
                          [(Some key)
                            (Ok
                              key
                              (tc-context-source-dotted-full-path-key-cache-get
                                ctx
                                current-module-id
                                name-id))]
                          [(No)
                            (match (tc-dotted-alias-flat-variant-key-id
                              ctx
                              env
                              name
                              name-id)
                              [(Some flat-key-id) (Ok name flat-key-id)]
                              [(None)
                                (if (tc-source-name-bound-exact-id? env name-id)
                                  (Ok name name-id)
                                  (Err (tc-unresolved-dotted-name-message name)))])])])]))]))))))

(define (tc-source-name-lookup-key-with-field-check-lookup
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [name-id : i64]
  [check-local-field : bool]) : TcNameLookup
  (if (tc-structural-local-name-id? (tc-context-structural-session ctx) name-id)
    (Ok
      (tc-hygiene-name-text-id-for-session
        (tc-context-structural-session ctx)
        name-id)
      name-id)
    (if (macro-hygiene-global-id? (tc-context-structural-session ctx) name-id)
      (let
        [source-id : i64
          (macro-hygiene-global-source-name-id-or
            (tc-context-structural-session ctx)
            name-id
            name-id)]
        [module-id : i64
          (macro-hygiene-global-module-id
            (tc-context-structural-session ctx)
            name-id)]
        [source-ctx : TcContext
          (if (csym.compiler-symbol-root-module-id? module-id)
            (tc-context-with-module-id ctx "" cbi.compiler-builtin-id-fix-empty)
            (tc-context-with-module-id
              ctx
              (tc-env-key-name-text module-id)
              module-id))]
        (tc-source-name-lookup-key-with-field-check-source-lookup
          source-ctx
          env
          (ci.intern-str source-id)
          source-id
          check-local-field))
      (tc-source-name-lookup-key-with-field-check-source-lookup
        ctx
        env
        name
        name-id
        check-local-field))))

(define (tc-qualified-access-target-module-id
  [ctx : TcContext]
  [qualifier-id : i64]) : i64
  (let
    [program : ast.AstProgram (tc-context-program ctx)]
    [current-module-id : i64 (tc-context-module-id ctx)]
    (match program
      [(Program decls-box)
        (macro-resolve-qualified-module-id
          ctx
          (ast.ast-decl-list-box-shared-view decls-box)
          current-module-id
          qualifier-id)])))

(define (tc-resolved-nominal-type-id [name-id : i64] [handle : i64]) : ast.AstType
  (if (=
    (csym.compiler-symbol-handle-kind handle)
    (csym.compiler-symbol-kind-defenum))
    (Enum name-id)
    (if (=
      (csym.compiler-symbol-handle-kind handle)
      (csym.compiler-symbol-kind-defstruct))
      (Struct name-id)
      (Var name-id))))

(define (tc-resolved-nominal-type-with-args-id
  [name-id : i64]
  [handle : i64]
  [lifetimes : ast.AstLifetimeList]) : ast.AstType
  (if (=
    (csym.compiler-symbol-handle-kind handle)
    (csym.compiler-symbol-kind-defenum))
    (ast.ast-ty-enum-args name-id lifetimes)
    (if (=
      (csym.compiler-symbol-handle-kind handle)
      (csym.compiler-symbol-kind-defstruct))
      (ast.ast-ty-struct-args name-id lifetimes)
      (ast.ast-ty-var-args name-id lifetimes))))

(define (tc-nominal-name-id-display-for-session
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : String
  ;; Nominal module/name composites may be appended through an explicit
  ;; structural owner after the compatibility interner's cached table length
  ;; was published. Resolve them from the capability rather than relying on
  ;; that ambient snapshot.
  (tc-hygiene-name-text-id-for-session session name-id))

(define (tc-nominal-name-id-display [name-id : i64]) : String
  (ast.ast-nominal-name-id-display name-id))

(define (tc-current-module-owner-name-matches-id?
  [session : cis.InternStructuralSessionHandle]
  [lookup-id : i64]
  [owner-id : i64]) : bool
  (and
    (>= lookup-id 0)
    (>= owner-id 0)
    (or
      (= owner-id lookup-id)
      (and
        (csym.compiler-composite-pair-key-id? lookup-id)
        (< owner-id (ci.intern-capacity))
        (not (tc-name-qualified-id? session owner-id))
        (= owner-id (csym.compiler-composite-pair-right-id lookup-id)))
      (and
        (< lookup-id (ci.intern-capacity))
        (tc-name-qualified-id? session lookup-id)
        (not (tc-name-qualified-id? session owner-id))
        (= owner-id (tc-qualified-name-base-id lookup-id))))))

(define (tc-current-module-enum-id? [ctx : TcContext] [name-id : i64]) : bool
  (match (tc-context-enum-variants-id
    ctx
    name-id
    (tc-nominal-name-id-display name-id))
    [(Ok _) true]
    [(Err _) false]))

(define (tc-nominal-owner-id-or
  [ctx : TcContext]
  [handle : i64]
  [fallback : i64]) : i64
  (let
    [owner-id : i64
      (csym.compiler-symbols-owner-id-at-index-or
        (tc-context-symbols ctx)
        (csym.compiler-symbol-handle-index handle)
        fallback)]
    owner-id))

(define (tc-resolved-current-module-nominal-type-id
  [ctx : TcContext]
  [name-id : i64]
  [handle : i64]) : ast.AstType
  (match (tc-nominal-owner-name-match ctx handle name-id)
    [(Same) (tc-resolved-nominal-type-id name-id handle)]
    [(Different)
      (let
        [owner-id : i64 (tc-nominal-owner-id-or ctx handle name-id)]
        (if (tc-current-module-owner-name-matches-id?
          (tc-context-structural-session ctx)
          name-id
          owner-id)
          (tc-resolved-nominal-type-id name-id handle)
          (if (and
            (> (string.string-length (tc-context-module ctx)) 0)
            (tc-current-module-enum-id? ctx name-id))
            (Enum name-id)
            (tc-resolved-nominal-type-id owner-id handle))))]
    [(Unnamed)
      (if (and
        (> (string.string-length (tc-context-module ctx)) 0)
        (tc-current-module-enum-id? ctx name-id))
        (Enum name-id)
        (tc-resolved-nominal-type-id name-id handle))]))

(define (tc-resolved-current-module-nominal-type-with-args-id
  [ctx : TcContext]
  [name-id : i64]
  [handle : i64]
  [lifetimes : ast.AstLifetimeList]) : ast.AstType
  (match (tc-nominal-owner-name-match ctx handle name-id)
    [(Same) (tc-resolved-nominal-type-with-args-id name-id handle lifetimes)]
    [(Different)
      (let
        [owner-id : i64 (tc-nominal-owner-id-or ctx handle name-id)]
        (if (tc-current-module-owner-name-matches-id?
          (tc-context-structural-session ctx)
          name-id
          owner-id)
          (tc-resolved-nominal-type-with-args-id name-id handle lifetimes)
          (if (and
            (> (string.string-length (tc-context-module ctx)) 0)
            (tc-current-module-enum-id? ctx name-id))
            (ast.ast-ty-enum-args name-id lifetimes)
            (tc-resolved-nominal-type-with-args-id owner-id handle lifetimes))))]
    [(Unnamed)
      (if (and
        (> (string.string-length (tc-context-module ctx)) 0)
        (tc-current-module-enum-id? ctx name-id))
        (ast.ast-ty-enum-args name-id lifetimes)
        (tc-resolved-nominal-type-with-args-id name-id handle lifetimes))]))

(define (tc-qualified-lookup-owner-id
  [session : cis.InternStructuralSessionHandle]
  [lookup-id : i64]
  [owner-id : i64]) : i64
  (if (and
    (>= lookup-id 0)
    (or
      (tc-name-qualified-id? session lookup-id)
      (>= (tc-name-first-dot-id session lookup-id) 0))
    (>= owner-id 0)
    (not (tc-name-qualified-id? session owner-id)))
    lookup-id
    owner-id))

;; The cached name strings are caller-provided and may live in a transient
;; scratch arena (per-function typecheck arenas): clear them to the
;; static empty string as well, so no slot can compare against freed memory
;; after the owning arena is destroyed.
(define (tc-resolve-type-name-cache-reset-for-state!
  [state : TcNominalCacheState]) : unit
  (let
    [data : (MutPtr TcNominalCacheStateData) (tc-nominal-cache-state-ptr state)]
    (unsafe
      (set! (deref data).type-name-valid false)
      (set! (deref data).type-name-key -1))))

(define (tc-nominal-owner-cache-reset-for-state! [state : TcNominalCacheState]) : unit
  (let
    [data : (MutPtr TcNominalCacheStateData) (tc-nominal-cache-state-ptr state)]
    [index : i64 0]
    (unsafe
      (while (< index 8)
        (set! (array-ref (deref data).owner-handles index) -1)
        (set! (array-ref (deref data).owner-names index) "")
        (set! index (+ index 1)))
      (set! (deref data).type-name-valid false)
      (set! (deref data).type-name-key -1))))

(define (tc-nominal-owner-cache-reset-for-job! [state : TcJobState]) : unit
  (tc-nominal-owner-cache-reset-for-state! (tc-job-state-nominal-cache state)))

(define (tc-nominal-owner-cache-reset-for-macro-state! [state : TcMacroState]) : unit
  (tc-nominal-owner-cache-reset-for-state! (tc-macro-state-nominal-cache state)))

(define (tc-resolve-type-name-cache-lookup
  [state : TcNominalCacheState]
  [lookup-id : i64]) : TcTypeNameLookupCache
  (let
    [data : (Ptr TcNominalCacheStateData) (tc-nominal-cache-state-view state)]
    (unsafe
      (if (and
        (deref data).type-name-valid
        (= (deref data).type-name-key lookup-id))
        (if (deref data).type-name-found
          (Found (deref data).type-name-handle)
          (Missing))
        (Miss)))))

(define (tc-resolve-type-name-cache-store!
  [state : TcNominalCacheState]
  [lookup-id : i64]
  [found : bool]
  [handle : i64]) : unit
  (let
    [data : (MutPtr TcNominalCacheStateData) (tc-nominal-cache-state-ptr state)]
    (unsafe
      (set! (deref data).type-name-key lookup-id)
      (set! (deref data).type-name-found found)
      (set! (deref data).type-name-handle handle)
      (set! (deref data).type-name-valid true))))

(define tc-type-handle-cache-capacity : i64
  4096)

(defmacro (tc-type-handle-cache-field [state : Expr] [field : Expr] [_T : type]) : Expr
  `(unsafe
    (ptr-read
      (ptr-cast
        (ptr-offset
          (int->ptr
            (cast ,(comptime.expr-struct-get state "address") : u64)
            : (Ptr u8))
          (comptime (offset-of (type TcTypeHandleCacheStateData) ,field)))
        : (Ptr ,_T)))))

(define (tc-nominal-cache-type-handles [state : TcNominalCacheState]) : TcTypeHandleCacheState
  (unsafe
    (ptr-read
      (ptr-cast
        (ptr-offset
          (int->ptr (cast state.address : u64) : (Ptr u8))
          (comptime (offset-of (type TcNominalCacheStateData) type-handles)))
        : (Ptr TcTypeHandleCacheState)))))

(defmacro (tc-type-handle-cache-slot [key : Expr]) : Expr
  `(let
    [folded : i64 (bit-xor ,key (bit-xor (shr ,key 17) (shr ,key 34)))]
    (bit-and (* folded 6364136223846793005) (- tc-type-handle-cache-capacity 1))))

(define (tc-type-handle-cache-clear-keys! [keys-address : i64]) : unit
  (let
    [keys : (MutPtr i64)
      (unsafe
        (int->ptr (cast keys-address : u64) : (MutPtr i64)))]
    [index : i64 0]
    (while (< index tc-type-handle-cache-capacity)
      (unsafe
        (ptr-write! (ptr-offset keys index) -1))
      (set! index (+ index 1)))))

;; Symbol construction is append-only, but an addition may retain the same
;; backing allocation. Rebind on either the owner pointer or map generation;
;; clearing the direct map also prevents stale entries if a job later returns
;; to a previously observed table stamp.
(define (tc-type-handle-cache-rebind-and-probe!
  [state : TcTypeHandleCacheState]
  [symbols : (& symbols csym.CompilerSymbols)]
  [lookup-id : i64]
  [key : i64]) : i64
  (unsafe
    (let
      [stamp : csym.CompilerSymbolsTypeMapStamp
        (csym.compiler-symbols-type-map-stamp symbols)]
      [data : (MutPtr TcTypeHandleCacheStateData)
        (tc-type-handle-cache-state-ptr state)]
      [keys-address : i64
        (if (> (deref data).keys-address 0)
          (deref data).keys-address
          (in-arena
            (arena.Arena (deref data).owner-arena)
            (let
              [keys : (__tl_dyn-array i64)
                (__tl_make-array i64 tc-type-handle-cache-capacity)]
              (cast
                (ptr->int (ptr-cast (__tl_array-data keys) : (Ptr i64)))
                : i64))))]
      [handles-address : i64
        (if (> (deref data).handles-address 0)
          (deref data).handles-address
          (in-arena
            (arena.Arena (deref data).owner-arena)
            (let
              [handles : (__tl_dyn-array i64)
                (__tl_make-array i64 tc-type-handle-cache-capacity)]
              (cast
                (ptr->int (ptr-cast (__tl_array-data handles) : (Ptr i64)))
                : i64))))]
      [move-kinds-address : i64
        (if (> (deref data).move-kinds-address 0)
          (deref data).move-kinds-address
          (in-arena
            (arena.Arena (deref data).owner-arena)
            (let
              [move-kinds : (__tl_dyn-array i64)
                (__tl_make-array i64 tc-type-handle-cache-capacity)]
              (cast
                (ptr->int (ptr-cast (__tl_array-data move-kinds) : (Ptr i64)))
                : i64))))]
      (begin
        (tc-type-handle-cache-clear-keys! keys-address)
        (set! (deref data).keys-address keys-address)
        (set! (deref data).handles-address handles-address)
        (set! (deref data).move-kinds-address move-kinds-address)
        (set! (deref data).symbols-owner stamp.owner)
        (set! (deref data).symbols-generation stamp.generation)
        (cfg
          compile-profile
          (begin
            (counters.bump! tc-profile-type-handle-cache-misses)
            (counters.bump! tc-profile-type-handle-symbol-probes)))
        (tc-type-handle-cache-probe-and-store! state symbols lookup-id key)))))

(define (tc-type-handle-cache-probe-and-store!
  [state : TcTypeHandleCacheState]
  [symbols : (& symbols csym.CompilerSymbols)]
  [lookup-id : i64]
  [key : i64]) : i64
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-type-id-or
        symbols
        lookup-id
        (csym.compiler-symbols-missing-handle))]
    [slot : i64 (tc-type-handle-cache-slot key)]
    [keys : (MutPtr i64)
      (unsafe
        (int->ptr
          (cast (tc-type-handle-cache-field state keys-address i64) : u64)
          : (MutPtr i64)))]
    [handles : (MutPtr i64)
      (unsafe
        (int->ptr
          (cast (tc-type-handle-cache-field state handles-address i64) : u64)
          : (MutPtr i64)))]
    [move-kinds : (MutPtr i64)
      (unsafe
        (int->ptr
          (cast (tc-type-handle-cache-field state move-kinds-address i64) : u64)
          : (MutPtr i64)))]
    (unsafe
      (ptr-write! (ptr-offset keys slot) key)
      (ptr-write! (ptr-offset handles slot) handle)
      (ptr-write! (ptr-offset move-kinds slot) 0))
    handle))

;; The move-kind lane of LOOKUP-ID's slot while the cache is bound to SYMBOLS'
;; stamp and the slot still holds LOOKUP-ID; otherwise 0 (unknown).
(define (tc-type-handle-cache-move-kind-address
  [nominal-state : TcNominalCacheState]
  [symbols : (& symbols csym.CompilerSymbols)]
  [lookup-id : i64]) : u64
  (let
    [state : TcTypeHandleCacheState
      (tc-nominal-cache-type-handles nominal-state)]
    [stamp : csym.CompilerSymbolsTypeMapStamp
      (csym.compiler-symbols-type-map-stamp symbols)]
    [slot : i64 (tc-type-handle-cache-slot lookup-id)]
    (if (and
      (= (tc-type-handle-cache-field state symbols-owner i64) stamp.owner)
      (=
        (tc-type-handle-cache-field state symbols-generation i64)
        stamp.generation)
      (=
        (unsafe
          (ptr-read
            (ptr-offset
              (int->ptr
                (cast (tc-type-handle-cache-field state keys-address i64) : u64)
                : (Ptr i64))
              slot)))
        lookup-id))
      (+
        (cast (tc-type-handle-cache-field state move-kinds-address i64) : u64)
        (cast (* slot 8) : u64))
      (cast 0 : u64))))

(define (tc-type-handle-cache-move-kind
  [nominal-state : TcNominalCacheState]
  [symbols : (& symbols csym.CompilerSymbols)]
  [lookup-id : i64]) : i64
  (let
    [address : u64
      (tc-type-handle-cache-move-kind-address nominal-state symbols lookup-id)]
    (if (= address (cast 0 : u64))
      0
      (unsafe
        (ptr-read (int->ptr address : (Ptr i64)))))))

(define (tc-type-handle-cache-move-kind-set!
  [nominal-state : TcNominalCacheState]
  [symbols : (& symbols csym.CompilerSymbols)]
  [lookup-id : i64]
  [kind : i64]) : unit
  (let
    [address : u64
      (tc-type-handle-cache-move-kind-address nominal-state symbols lookup-id)]
    (if (= address (cast 0 : u64))
      unit
      (unsafe
        (ptr-write! (int->ptr address : (MutPtr i64)) kind)))))

(define (tc-type-handle-cache-lookup-id
  [nominal-state : TcNominalCacheState]
  [symbols : (& symbols csym.CompilerSymbols)]
  [lookup-id : i64]) : i64
  (let
    [state : TcTypeHandleCacheState
      (tc-nominal-cache-type-handles nominal-state)]
    [stamp : csym.CompilerSymbolsTypeMapStamp
      (csym.compiler-symbols-type-map-stamp symbols)]
    ;; Cache the caller's exact identity. The backing symbol probe performs
    ;; nominal-name normalization on a miss; hits therefore avoid that generic
    ;; normalization call while aliases with distinct source IDs remain exact.
    [key : i64 lookup-id]
    [bound? : bool
      (and
        (= (tc-type-handle-cache-field state symbols-owner i64) stamp.owner)
        (=
          (tc-type-handle-cache-field state symbols-generation i64)
          stamp.generation))]
    (if bound?
      (let
        [slot : i64 (tc-type-handle-cache-slot key)]
        [keys : (Ptr i64)
          (unsafe
            (int->ptr
              (cast (tc-type-handle-cache-field state keys-address i64) : u64)
              : (Ptr i64)))]
        [handles : (Ptr i64)
          (unsafe
            (int->ptr
              (cast
                (tc-type-handle-cache-field state handles-address i64)
                : u64)
              : (Ptr i64)))]
        (if (=
          (unsafe
            (ptr-read (ptr-offset keys slot)))
          key)
          (begin
            (cfg
              compile-profile
              (counters.bump! tc-profile-type-handle-cache-hits))
            (unsafe
              (ptr-read (ptr-offset handles slot))))
          (begin
            (cfg
              compile-profile
              (begin
                (counters.bump! tc-profile-type-handle-cache-misses)
                (counters.bump! tc-profile-type-handle-symbol-probes)))
            (tc-type-handle-cache-probe-and-store! state symbols lookup-id key))))
      (tc-type-handle-cache-rebind-and-probe! state symbols lookup-id key))))

(defmacro (tc-type-handle-lookup-id
  [nominal-state : Expr]
  [symbols : Expr]
  [lookup-id : Expr]
  [_caller : Expr]) : Expr
  `(begin
    (cfg compile-profile (compiler-tc-type-handle-profile-note-lookup ,_caller))
    (tc-type-handle-cache-lookup-id ,nominal-state ,symbols ,lookup-id)))

(define (tc-resolve-type-name-symbol-lookup-id
  [state : TcNominalCacheState]
  [symbols : (& symbols csym.CompilerSymbols)]
  [lookup-id : i64]) : i64
  (match (tc-resolve-type-name-cache-lookup state lookup-id)
    [(Found handle)
      (begin
        (cfg
          compile-profile
          (begin
            (counters.bump! tc-profile-resolve-name-lookup-calls)
            (counters.bump! tc-profile-resolve-name-cache-hits)))
        handle)]
    [(Missing)
      (begin
        (cfg
          compile-profile
          (begin
            (counters.bump! tc-profile-resolve-name-lookup-calls)
            (counters.bump! tc-profile-resolve-name-cache-hits)))
        (csym.compiler-symbols-missing-handle))]
    [(Miss)
      (let
        [handle : i64
          (tc-type-handle-lookup-id
            state
            symbols
            lookup-id
            tc-type-handle-lookup-caller-resolver)]
        (begin
          (cfg
            compile-profile
            (begin
              (counters.bump! tc-profile-resolve-name-lookup-calls)
              (counters.bump! tc-profile-resolve-name-cache-misses)
              (counters.bump! tc-profile-resolve-type-symbol-probes)))
          (tc-resolve-type-name-cache-store!
            state
            lookup-id
            (csym.compiler-symbols-handle-found? handle)
            (if (csym.compiler-symbols-handle-found? handle)
              handle
              0))
          handle))]))

(define (tc-nominal-owner-cache-slot [handle : i64]) : i64
  (% (csym.compiler-symbol-handle-index handle) 8))

(define (tc-nominal-owner-cache-entry-lookup
  [handle : i64]
  [cached-handle : i64]
  [cached-name : String]) : ResultTcString
  (if (= cached-handle handle)
    (Ok cached-name)
    (Err "")))

(define (tc-nominal-owner-cache-lookup [ctx : TcContext] [handle : i64]) : ResultTcString
  (let
    [data : TcNominalCacheStateData
      (tc-nominal-cache-state-data
        (tc-job-state-nominal-cache (tc-context-job-state ctx)))]
    [slot : i64 (tc-nominal-owner-cache-slot handle)]
    (tc-nominal-owner-cache-entry-lookup
      handle
      (array-ref data.owner-handles slot)
      (tc-global-array-element-shared-view data.owner-names slot))))

;; Whether `tc-nominal-owner-cache-lookup` would find `handle`.
(define (tc-nominal-owner-cache-holds? [ctx : TcContext] [handle : i64]) : bool
  (let
    [data : TcNominalCacheStateData
      (tc-nominal-cache-state-data
        (tc-job-state-nominal-cache (tc-context-job-state ctx)))]
    (=
      (array-ref data.owner-handles (tc-nominal-owner-cache-slot handle))
      handle)))

(define (tc-nominal-owner-cache-store-if-safe!
  [state : TcNominalCacheState]
  [handle : i64]
  [name : String]) : unit
  (if (tc-name-qualified? name)
    unit
    (let
      [data : TcNominalCacheStateData (tc-nominal-cache-state-data state)]
      [slot : i64 (tc-nominal-owner-cache-slot handle)]
      (set! (array-ref data.owner-handles slot) handle)
      (set! (array-ref data.owner-names slot) name))))

(define (tc-nominal-owner-name-list
  [decls : ast.AstDeclList]
  [target : i64]
  [index : i64]
  [module : String]) : ResultTcString
  (match (ast.ast-decl-list-step decls)
    [(Nil) (Err "typecheck: nominal owner not found")]
    [(Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        (match decl
          [(or (Import _ _) (IncludeStr _ _) (IncludeStrComptime _ _)
               (IncludeStrLzss _ _) (IncludeBin _ _) (Test _ _ _ _))
            (tc-nominal-owner-name-list rest target index module)]
          [(Module next-module)
            (tc-nominal-owner-name-list
              rest
              target
              index
              (tc-env-key-name-text next-module))]
          [(ModuleBody name body-box)
            (let
              [body : ast.AstDeclList
                (ast.ast-decl-list-box-shared-view body-box)]
              [body-count : i64 (csym.compiler-decl-list-index-count body)]
              (if (< target (+ index body-count))
                (tc-nominal-owner-name-list
                  body
                  target
                  index
                  (tc-env-key-name-text name))
                (tc-nominal-owner-name-list
                  rest
                  target
                  (+ index body-count)
                  module)))]
          [(or (DefEnum _ name _ _) (DefEnumLifetimes _ name _ _ _)
               (DefStruct _ name _ _ _) (DefStructLifetimes _ name _ _ _ _))
            (if (= target index)
              (Ok
                (csym.compiler-symbol-module-key
                  module
                  (tc-env-key-name-text name)))
              (tc-nominal-owner-name-list rest target (+ index 1) module))]
          [_ (tc-nominal-owner-name-list rest target (+ index 1) module)]))]))

(define (tc-nominal-owner-name-scan
  [state : TcNominalCacheState]
  [program : ast.AstProgram]
  [handle : i64]
  [index : i64]) : ResultTcString
  (match program
    [(Program decls-box)
      (let
        [decls : ast.AstDeclList (ast.ast-decl-list-box-shared-view decls-box)]
        [name : String (try (tc-nominal-owner-name-list decls index 0 ""))]
        (tc-nominal-owner-cache-store-if-safe!
          state
          handle
          (string.copy (& name)))
        (Ok name))]))

(define (tc-nominal-owner-name [ctx : TcContext] [handle : i64]) : ResultTcString
  (let
    [state : TcNominalCacheState
      (tc-job-state-nominal-cache (tc-context-job-state ctx))]
    (match (tc-nominal-owner-cache-lookup ctx handle)
      [(Ok cached) (Ok cached)]
      [(Err _)
        (let
          [program : ast.AstProgram (tc-context-program ctx)]
          [symbols : (& ctx csym.CompilerSymbols) (tc-context-symbols ctx)]
          (match (csym.compiler-symbols-owner-name-at-index
            symbols
            (csym.compiler-symbol-handle-index handle))
            [(CompilerSomeString name)
              (tc-nominal-owner-cache-store-if-safe!
                state
                handle
                (string.copy (& name)))
              (Ok name)]
            [(CompilerNoString)
              (tc-nominal-owner-name-scan
                state
                program
                handle
                (csym.compiler-symbol-handle-index handle))]))])))

;; How the display of the nominal `name-id` compares with the name of the
;; declaration that owns `handle`. Unnamed: that owner has no name.
(defenum TcNominalOwnerMatch
  (Same)
  (Different)
  (Unnamed))

;; Decides exactly as comparing the display with `tc-nominal-owner-name`, but
;; resolves a module/name owner without rendering its name. A cached owner name
;; takes precedence, as it does in `tc-nominal-owner-name`.
(define (tc-nominal-owner-name-match
  [ctx : TcContext]
  [handle : i64]
  [name-id : i64]) : TcNominalOwnerMatch
  (match (if (tc-nominal-owner-cache-holds? ctx handle)
    csym.CompilerOwnerNameComparison.Unresolved
    (csym.compiler-symbols-owner-name-at-index-compare
      (tc-context-symbols ctx)
      (csym.compiler-symbol-handle-index handle)
      name-id))
    [(Equal) Same]
    [(Different) Different]
    [(Unresolved)
      (match (tc-nominal-owner-name ctx handle)
        [(Ok owner-name)
          (if (string.eq (tc-nominal-name-id-display name-id) owner-name)
            Same
            Different)]
        [(Err _) Unnamed])]))

(define (tc-context-with-owner-name-module [ctx : TcContext] [owner-id : i64]) : TcContext
  (if (tc-name-qualified-id? (tc-context-structural-session ctx) owner-id)
    (let
      [module-id : i64 (tc-qualified-name-module-id owner-id)]
      (tc-context-with-module-id ctx (tc-env-key-name-text module-id) module-id))
    (tc-context-with-module-id ctx "" cbi.compiler-builtin-id-fix-empty)))

(define (tc-context-with-nominal-owner-index-module
  [ctx : TcContext]
  [index : i64]) : TcContext
  (let
    [module-id : i64
      (csym.compiler-symbols-owner-module-id-at-index-or
        (tc-context-symbols ctx)
        index
        (csym.compiler-symbol-root-module-id))]
    (if (csym.compiler-symbol-root-module-id? module-id)
      (tc-context-with-module-id ctx "" cbi.compiler-builtin-id-fix-empty)
      (tc-context-with-module-id ctx (tc-env-key-name-text module-id) module-id))))

;; Macro-generated modules already have an identity, but their dotted display
;; names are intentionally absent from the source interner. Resolve
;; `current.module.Type` from the context's module id and the parsed base id.
(define (tc-current-module-dotted-name-id
  [ctx : TcContext]
  [name : (& name str)]
  [name-id : i64]) : i64
  (let
    [module : String (tc-context-module ctx)]
    [module-id : i64 (tc-context-module-id ctx)]
    [module-len : i64 (string.string-length module)]
    [name-len : i64 (string.string-length name)]
    [base-start : i64 (+ module-len 1)]
    (if (and
      (> module-len 0)
      (> name-len base-start)
      (string.eq (string.substring name 0 module-len) module)
      (string.char-eq (string.string-ref name module-len) '.'))
      (let
        [base-id : i64 (ci.intern-dotted-final-id name-id)]
        (if (< base-id 0)
          -1
          (tc-qualified-name-key-id module-id base-id)))
      -1)))

(define (tc-decl-nominal-name-id-matches? [decl : ast.AstDecl] [name-id : i64]) : bool
  (match decl
    [(or (DefEnum _ name _ _) (DefEnumLifetimes _ name _ _ _)
         (DefStruct _ name _ _ _) (DefStructLifetimes _ name _ _ _ _))
      (= name name-id)]
    [_ false]))

(define (tc-symbols-unique-nominal-name-id?
  [symbols : (& symbols csym.CompilerSymbols)]
  [name-id : i64]) : bool
  (let
    [decls : (__tl_dyn-array ast.AstDecl) (csym.compiler-symbols-decls symbols)]
    [decl-count : i64 (csym.compiler-symbols-decl-count symbols)]
    [i : i64 0]
    [matches : i64 0]
    (while (and (< i decl-count) (< matches 2))
      (if (tc-decl-nominal-name-id-matches?
        (ast.ast-array-shared-view decls i)
        name-id)
        (set! matches (+ matches 1))
        unit)
      (set! i (+ i 1)))
    (= matches 1)))

(define (tc-dotted-type-symbol-key-id
  [ctx : TcContext]
  [name : (& name str)]
  [name-id : i64]) : option_i64.Option
  (let
    [first-dot : i64
      (tc-name-first-dot-id (tc-context-structural-session ctx) name-id)]
    [n : i64 (string.string-length name)]
    (if (or (<= first-dot 0) (>= first-dot (- n 1)))
      None
      (let
        [alias-id : i64 (ci.intern-leading-dot-id name-id)]
        [base-id : i64 (ci.intern-dotted-tail-id name-id)]
        (if (or (< alias-id 0) (< base-id 0))
          None
          (match (tc-context-program ctx)
            [(Program decls-box)
              (let
                [target : TcMaybeNameId
                  (tc-source-dotted-alias-target-id-in-context
                    ctx
                    (ast.ast-decl-list-box-shared-view decls-box)
                    (tc-context-module-id ctx)
                    alias-id)]
                [segmented-active : bool
                  (macro-segmented-program-active? (tc-context-job-state ctx))]
                [symbols (tc-context-symbols ctx)]
                (match target
                  [(Some target-module-id)
                    (let
                      [key-id : i64
                        (csym.compiler-symbol-module-key-id-by-id
                          target-module-id
                          base-id)]
                      (match (csym.compiler-symbols-lookup-type-id
                        symbols
                        key-id)
                        [(Some _) (Some key-id)]
                        [(None)
                          ;; A generated module's nested import is present in
                          ;; the segmented view before its target module is
                          ;; materialized. Its temporary self-target is an
                          ;; explicit unresolved alias, not permission to pick
                          ;; the sole same-base nominal from another generated
                          ;; module (for example i64 `vec.Vec` while building
                          ;; the later i32 specialization). Keep the signature
                          ;; unresolved until the alias delta publishes its
                          ;; canonical target; the splice re-resolution pass
                          ;; then resolves it to the right specialization.
                          (if (and
                            segmented-active
                            (= target-module-id alias-id))
                            None
                            (match (tc-lazy-import-unique-type-key-id
                              (tc-context-macro-state ctx)
                              symbols
                              alias-id
                              base-id)
                              [(Some unique-key-id) (Some unique-key-id)]
                              [(No) None]))]))]
                  [(No)
                    (let
                      [key-id : i64
                        (csym.compiler-symbol-module-key-id-by-id
                          alias-id
                          base-id)]
                      (match (csym.compiler-symbols-lookup-type-id
                        symbols
                        key-id)
                        [(Some _) (Some key-id)]
                        [(None)
                          (match (tc-lazy-import-unique-type-key-id
                            (tc-context-macro-state ctx)
                            symbols
                            alias-id
                            base-id)
                            [(Some unique-key-id) (Some unique-key-id)]
                            [(No) None])]))]))]))))))

(define (tc-dotted-unique-nominal-type-id
  [ctx : TcContext]
  [name : (& name str)]
  [name-id : i64]) : option_i64.Option
  (let
    [first-dot : i64
      (tc-name-first-dot-id (tc-context-structural-session ctx) name-id)]
    [n : i64 (string.string-length name)]
    (if (or (<= first-dot 0) (>= first-dot (- n 1)))
      None
      (let
        [base-id : i64 (ci.intern-dotted-tail-id name-id)]
        [symbols (tc-context-symbols ctx)]
        (if (or
          (< base-id 0)
          (not (tc-symbols-unique-nominal-name-id? symbols base-id)))
          None
          (match (csym.compiler-symbols-lookup-type-id symbols base-id)
            [(Some _) (Some base-id)]
            [(None) None]))))))

(define (tc-resolve-source-type-name
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : ast.AstType
  (let
    [symbols : (& ctx csym.CompilerSymbols) (tc-context-symbols ctx)]
    [module : String (tc-context-module ctx)]
    [module-id : i64 (tc-context-module-id ctx)]
    [current-dotted-id : i64
      (tc-current-module-dotted-name-id ctx name name-id)]
    [direct-source-key : option_i64.Option
      (if (>= current-dotted-id 0)
        None
        (tc-dotted-type-symbol-key-id ctx name name-id))]
    [source-result : ResultTcString
      (if (>= current-dotted-id 0)
        (Ok (tc-nominal-name-id-display current-dotted-id))
        (match direct-source-key
          [(Some _) (Ok (tc-global-shared-view name))]
          [(None)
            (tc-dotted-type-name-lookup-key-from-id
              ctx
              (tc-global-shared-view name)
              name-id)]))]
    [source-name : String
      (match (tc-global-shared-view source-result)
        [(Ok key) key]
        [(Err _) (owned_view.compiler-owned-shared-view name)])]
    [source-id : i64
      (if (>= current-dotted-id 0)
        current-dotted-id
        (match direct-source-key
          [(Some key-id) key-id]
          [(None)
            (match source-result
              [(Ok key)
                (if (string.eq key name)
                  name-id
                  (tc-dotted-resolved-key-id-or ctx name-id name-id))]
              [(Err _)
                (match (tc-dotted-unique-nominal-type-id ctx name name-id)
                  [(Some unique-id) unique-id]
                  [(None) name-id])])]))]
    [in-current-module : bool
      (and
        (> (string.string-length module) 0)
        (not
          (tc-name-qualified-id? (tc-context-structural-session ctx) source-id)))]
    [lookup-id : i64
      (if in-current-module
        (tc-qualified-name-key-id module-id source-id)
        source-id)]
    [handle : i64
      (if (>= lookup-id 0)
        (tc-resolve-type-name-symbol-lookup-id
          (tc-job-state-nominal-cache (tc-context-job-state ctx))
          symbols
          lookup-id)
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (if (and
        (tc-name-qualified-id? (tc-context-structural-session ctx) lookup-id)
        (= (tc-qualified-name-module-id lookup-id) module-id))
        (match (tc-stdlib-comptime-syntax-type-id lookup-id)
          [(Some syntax-ty) syntax-ty]
          [(No)
            (tc-resolved-current-module-nominal-type-id ctx lookup-id handle)])
        (let
          [canonical-id : i64 (tc-nominal-owner-id-or ctx handle lookup-id)]
          (match (tc-stdlib-comptime-syntax-type-id canonical-id)
            [(Some syntax-ty) syntax-ty]
            [(No)
              (tc-resolved-nominal-type-id
                (tc-qualified-lookup-owner-id
                  (tc-context-structural-session ctx)
                  lookup-id
                  canonical-id)
                handle)])))
      (if (tc-name-qualified-id? (tc-context-structural-session ctx) source-id)
        (match (tc-context-enum-variants-id ctx source-id source-name)
          [(Ok _) (Enum source-id)]
          [(Err _)
            (cond
              [(string.eq name "Expr") (Expr)]
              [(string.eq name "ExprList") (ExprList)]
              [(string.eq name "ExprClause") (tc-macro-expr-clause-type)]
              [(string.eq name "ExprClauseList")
                (tc-macro-expr-clause-list-type)]
              [(string.eq name "ExprBindingClause")
                (tc-macro-expr-binding-clause-type)]
              [(string.eq name "ExprBindingClauseList")
                (tc-macro-expr-binding-clause-list-type)]
              [(string.eq name "Pattern") (tc-macro-pattern-type)]
              [(string.eq name "PatternList") (tc-macro-pattern-list-type)]
              [(string.eq name "MatchArm") (tc-macro-match-arm-type)]
              [(string.eq name "MatchArmList") (tc-macro-match-arm-list-type)]
              [else (Var name-id)])])
        (cond
          [(string.eq name "Expr") (Expr)]
          [(string.eq name "ExprList") (ExprList)]
          [(string.eq name "ExprClause") (tc-macro-expr-clause-type)]
          [(string.eq name "ExprClauseList") (tc-macro-expr-clause-list-type)]
          [(string.eq name "ExprBindingClause")
            (tc-macro-expr-binding-clause-type)]
          [(string.eq name "ExprBindingClauseList")
            (tc-macro-expr-binding-clause-list-type)]
          [(string.eq name "Pattern") (tc-macro-pattern-type)]
          [(string.eq name "PatternList") (tc-macro-pattern-list-type)]
          [(string.eq name "MatchArm") (tc-macro-match-arm-type)]
          [(string.eq name "MatchArmList") (tc-macro-match-arm-list-type)]
          [else (Var name-id)])))))

(define (tc-resolve-type-name [ctx : TcContext] [name : String] [name-id : i64]) : ast.AstType
  (let
    [resolution-ctx : TcContext (tc-context-for-type-resolution ctx)]
    (if (macro-hygiene-global-id? (tc-context-structural-session ctx) name-id)
      (let
        [source-id : i64
          (macro-hygiene-structural-source-name-id
            (tc-context-structural-session ctx)
            name-id)]
        [module-id : i64
          (macro-hygiene-global-module-id
            (tc-context-structural-session ctx)
            name-id)]
        [source-ctx : TcContext
          (if (csym.compiler-symbol-root-module-id? module-id)
            (tc-context-with-module-id
              resolution-ctx
              ""
              cbi.compiler-builtin-id-fix-empty)
            (tc-context-with-module-id
              resolution-ctx
              (tc-env-key-name-text module-id)
              module-id))]
        (tc-resolve-source-type-name
          source-ctx
          (ci.intern-str source-id)
          source-id))
      (tc-resolve-source-type-name resolution-ctx name name-id))))

(define (tc-resolve-type-composite [ctx : TcContext] [ty : ast.AstType]) : ast.AstType
  ;; Ordinary compatibility callers may have installed a pool distinct from
  ;; `ctx.pools`. Classify child ids in the same pool that the rebuilding path
  ;; would read and append to; the job-owned predicate memo keeps that owner and
  ;; its segment table isolated from every other compile job.
  (let
    [needs-resolution : bool
      (tc-type-needs-resolution-for-reader-context?
        ctx
        (tc-global-shared-view ty))]
    (begin
      (cfg
        compile-profile
        (compiler-tc-resolution-profile-note-input ty needs-resolution))
      (if needs-resolution
        (tc-resolve-type-rebuild ctx ty)
        ty))))

(define (tc-resolve-type [ctx : TcContext] [ty : ast.AstType]) : ast.AstType
  ;; Concrete leaves return directly from this match. Keep that hot path free
  ;; of pool selection, and consult the recursive job-owned predicate only for
  ;; composite shapes, so they are rebuilt only when they need resolution.
  (match (tc-global-shared-view ty)
    [(or (CFunc _ _) (Func _ _) (Tuple _) (Array _ _) (DynArray _) (Slice _)
         (Box _) (Ptr _) (MutPtr _) (Ref _ _) (MutRef _ _) (Region _ _)
         (Invalidate _ _))
      (tc-resolve-type-composite ctx ty)]
    [(or (VarArgs _ _) (Var _))
      (begin
        (cfg
          compile-profile
          (compiler-tc-resolution-profile-note-input ty true))
        (tc-resolve-type-rebuild ctx ty))]
    [_
      (begin
        (cfg
          compile-profile
          (compiler-tc-resolution-profile-note-input ty false))
        ty)]))

(define (tc-resolve-type-rebuild [ctx : TcContext] [ty : ast.AstType]) : ast.AstType
  ;; The caller has proved this value contains an unresolved Var/VarArgs. Reuse
  ;; the public resolver for children so concrete subtrees remain shared.
  (match (tc-global-shared-view ty)
    [(Func args ret)
      (ast.ast-ty-func
        (tc-resolve-type-list ctx (ast.ast-type-list-box-shared-view args))
        (& (tc-resolve-type ctx (ast.ty-node-get ret))))]
    [(CFunc signature mode)
      (CFunc
        (ast.ast-node-pool-reader-type-push
          (& (tc-resolve-type ctx (ast.ty-node-get signature))))
        mode)]
    [(Tuple elems)
      (ast.ast-ty-tuple
        (tc-resolve-type-list ctx (ast.ast-type-list-box-shared-view elems)))]
    [(Array elem len)
      (ast.ast-ty-array (& (tc-resolve-type ctx (ast.ty-node-get elem))) len)]
    [(DynArray elem)
      (ast.ast-ty-dyn-array (& (tc-resolve-type ctx (ast.ty-node-get elem))))]
    [(Slice elem)
      (ast.ast-ty-slice (& (tc-resolve-type ctx (ast.ty-node-get elem))))]
    [(Box elem)
      (ast.ast-ty-box (& (tc-resolve-type ctx (ast.ty-node-get elem))))]
    [(Ptr elem)
      (ast.ast-ty-ptr (& (tc-resolve-type ctx (ast.ty-node-get elem))))]
    [(MutPtr elem)
      (ast.ast-ty-mut-ptr (& (tc-resolve-type ctx (ast.ty-node-get elem))))]
    [(Ref region inner)
      (ast.ast-ty-ref region (& (tc-resolve-type ctx (ast.ty-node-get inner))))]
    [(MutRef region inner)
      (ast.ast-ty-mut-ref
        region
        (& (tc-resolve-type ctx (ast.ty-node-get inner))))]
    [(Region region inner)
      (ast.ast-ty-region
        region
        (& (tc-resolve-type ctx (ast.ty-node-get inner))))]
    [(Invalidate lifetime inner)
      (ast.ast-ty-invalidate
        lifetime
        (& (tc-resolve-type ctx (ast.ty-node-get inner))))]
    [(VarArgs name lifetimes)
      (let
        [name-text : String
          (tc-hygiene-name-text-id-for-session
            (tc-context-structural-session ctx)
            name)]
        (tc-resolve-type-name-with-args
          ctx
          name-text
          name
          (ast.ast-lifetime-list-box-shared-view lifetimes)))]
    [(Var name)
      (let
        [name-text : String
          (tc-hygiene-name-text-id-for-session
            (tc-context-structural-session ctx)
            name)]
        (tc-resolve-type-name ctx name-text name))]
    [_ ty]))

(define (tc-canonicalize-resolved-nominal-type-list-at
  [ctx : TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ast.AstTypeList
  (if (>= index (ast.ast-type-list-len types))
    (ast.ast-type-list-new)
    (ast.ast-type-cons
      (&
        (tc-canonicalize-resolved-nominal-type
          ctx
          (ast.ty-node-get
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))))
      (& (tc-canonicalize-resolved-nominal-type-list-at ctx types (+ index 1))))))

(define (tc-canonicalize-resolved-nominal-type-list
  [ctx : TcContext]
  [types : ast.AstTypeList]) : ast.AstTypeList
  (tc-canonicalize-resolved-nominal-type-list-at ctx (& types) 0))

(define (tc-symbol-handle-decls-eq?
  [symbols : (& symbols csym.CompilerSymbols)]
  [left : i64]
  [right : i64]) : bool
  (match (csym.compiler-symbols-decl-at-index
    symbols
    (csym.compiler-symbol-handle-index left))
    [(Ok left-decl)
      (match (csym.compiler-symbols-decl-at-index
        symbols
        (csym.compiler-symbol-handle-index right))
        [(Ok right-decl) (spec.gen-decl-eq? left-decl right-decl)]
        [(Err _) false])]
    [(Err _) false]))

(define (tc-qualified-nominal-indexed-owner-id-or
  [ctx : TcContext]
  [name : i64]
  [fallback : i64]) : i64
  (let
    [base-id : i64 (tc-qualified-name-base-id name)]
    [source-module-id : i64 (tc-qualified-name-module-id name)]
    [lookup-module-id : i64
      (tc-source-name-id-or ctx source-module-id source-module-id)]
    [symbols (tc-context-symbols ctx)]
    [handle : i64
      (tc-type-handle-lookup-id
        (tc-job-state-nominal-cache (tc-context-job-state ctx))
        symbols
        (tc-qualified-name-key-id lookup-module-id base-id)
        tc-type-handle-lookup-caller-qualified-owner)]
    [flat-handle : i64
      (tc-type-handle-lookup-id
        (tc-job-state-nominal-cache (tc-context-job-state ctx))
        symbols
        base-id
        tc-type-handle-lookup-caller-qualified-owner)]
    [flat-root? : bool
      (and
        (csym.compiler-symbols-handle-found? flat-handle)
        (csym.compiler-symbol-root-module-id?
          (csym.compiler-symbols-owner-module-id-at-index-or
            symbols
            (csym.compiler-symbol-handle-index flat-handle)
            (csym.compiler-symbol-root-module-id))))]
    (if (csym.compiler-symbols-handle-found? handle)
      (let
        [owner-id : i64
          (csym.compiler-symbols-owner-id-at-index-or
            symbols
            (csym.compiler-symbol-handle-index handle)
            fallback)]
        (if (and
          flat-root?
          (tc-name-qualified-id? (tc-context-structural-session ctx) owner-id)
          (tc-imported-module-identity-id? ctx source-module-id)
          (tc-symbol-handle-decls-eq? symbols handle flat-handle))
          base-id
          owner-id))
      (if (and
        flat-root?
        (tc-symbols-unique-nominal-name-id? symbols base-id)
        (tc-imported-module-identity-id? ctx source-module-id))
        base-id
        fallback))))

(define (tc-source-owned-nominal-name-id [ctx : TcContext] [name : i64]) : i64
  (cond
    [(tc-name-qualified-id? (tc-context-structural-session ctx) name)
      (tc-qualified-nominal-indexed-owner-id-or ctx name name)]
    [else
      (let
        [source-name-id : i64
          (macro-hygiene-global-source-name-id-or
            (tc-context-structural-session ctx)
            name
            name)]
        [resolution-module-id : i64
          (tc-context-module-id (tc-context-for-type-resolution ctx))]
        [symbols (tc-context-symbols ctx)]
        [resolution-id : i64
          (if (csym.compiler-symbol-root-module-id? resolution-module-id)
            -1
            (tc-qualified-name-key-id resolution-module-id source-name-id))]
        [resolution-handle : i64
          (if (>= resolution-id 0)
            (tc-type-handle-lookup-id
              (tc-job-state-nominal-cache (tc-context-job-state ctx))
              symbols
              resolution-id
              tc-type-handle-lookup-caller-qualified-owner)
            (csym.compiler-symbols-missing-handle))]
        [handle : i64
          (tc-type-handle-lookup-id
            (tc-job-state-nominal-cache (tc-context-job-state ctx))
            symbols
            source-name-id
            tc-type-handle-lookup-caller-qualified-owner)]
        (if (csym.compiler-symbols-handle-found? handle)
          (let
            [owner-id : i64
              (csym.compiler-symbols-owner-id-at-index-or
                symbols
                (csym.compiler-symbol-handle-index handle)
                source-name-id)]
            (if (and
              (tc-name-qualified-id?
                (tc-context-structural-session ctx)
                owner-id)
              (= (tc-qualified-name-base-id owner-id) source-name-id))
              owner-id
              (if (csym.compiler-symbols-handle-found? resolution-handle)
                resolution-id
                name)))
          (if (csym.compiler-symbols-handle-found? resolution-handle)
            resolution-id
            name)))]))

(define (tc-canonicalize-resolved-nominal-type
  [ctx : TcContext]
  [ty : ast.AstType]) : ast.AstType
  (match (tc-global-shared-view ty)
    [(Func args ret)
      (ast.ast-ty-func
        (tc-canonicalize-resolved-nominal-type-list
          ctx
          (ast.ast-type-list-box-shared-view args))
        (& (tc-canonicalize-resolved-nominal-type ctx (ast.ty-node-get ret))))]
    [(Tuple elems)
      (ast.ast-ty-tuple
        (tc-canonicalize-resolved-nominal-type-list
          ctx
          (ast.ast-type-list-box-shared-view elems)))]
    [(Array elem len)
      (ast.ast-ty-array
        (& (tc-canonicalize-resolved-nominal-type ctx (ast.ty-node-get elem)))
        len)]
    [(DynArray elem)
      (ast.ast-ty-dyn-array
        (& (tc-canonicalize-resolved-nominal-type ctx (ast.ty-node-get elem))))]
    [(Slice elem)
      (ast.ast-ty-slice
        (& (tc-canonicalize-resolved-nominal-type ctx (ast.ty-node-get elem))))]
    [(Box elem)
      (ast.ast-ty-box
        (& (tc-canonicalize-resolved-nominal-type ctx (ast.ty-node-get elem))))]
    [(Ptr elem)
      (ast.ast-ty-ptr
        (& (tc-canonicalize-resolved-nominal-type ctx (ast.ty-node-get elem))))]
    [(MutPtr elem)
      (ast.ast-ty-mut-ptr
        (& (tc-canonicalize-resolved-nominal-type ctx (ast.ty-node-get elem))))]
    [(Ref region inner)
      (ast.ast-ty-ref
        region
        (& (tc-canonicalize-resolved-nominal-type ctx (ast.ty-node-get inner))))]
    [(MutRef region inner)
      (ast.ast-ty-mut-ref
        region
        (& (tc-canonicalize-resolved-nominal-type ctx (ast.ty-node-get inner))))]
    [(Region region inner)
      (ast.ast-ty-region
        region
        (& (tc-canonicalize-resolved-nominal-type ctx (ast.ty-node-get inner))))]
    [(Invalidate lifetime inner)
      (ast.ast-ty-invalidate
        lifetime
        (& (tc-canonicalize-resolved-nominal-type ctx (ast.ty-node-get inner))))]
    [(Enum name) (Enum (tc-source-owned-nominal-name-id ctx name))]
    [(EnumArgs name lifetimes)
      (EnumArgs (tc-source-owned-nominal-name-id ctx name) lifetimes)]
    [(Struct name) (Struct (tc-source-owned-nominal-name-id ctx name))]
    [(StructArgs name lifetimes)
      (StructArgs (tc-source-owned-nominal-name-id ctx name) lifetimes)]
    [_ ty]))

(define (tc-canonicalize-inferred-type [ctx : TcContext] [ty : ast.AstType]) : ast.AstType
  (tc-canonicalize-resolved-nominal-type ctx ty))

(define (tc-resolve-source-type-name-with-args
  [ctx : TcContext]
  [name : String]
  [name-id : i64]
  [lifetimes : ast.AstLifetimeList]) : ast.AstType
  (let
    [symbols : (& ctx csym.CompilerSymbols) (tc-context-symbols ctx)]
    [module : String (tc-context-module ctx)]
    [module-id : i64 (tc-context-module-id ctx)]
    [current-dotted-id : i64
      (tc-current-module-dotted-name-id ctx name name-id)]
    [direct-source-key : option_i64.Option
      (if (>= current-dotted-id 0)
        None
        (tc-dotted-type-symbol-key-id ctx name name-id))]
    [source-result : ResultTcString
      (if (>= current-dotted-id 0)
        (Ok (tc-nominal-name-id-display current-dotted-id))
        (match direct-source-key
          [(Some _) (Ok (tc-global-shared-view name))]
          [(None)
            (tc-dotted-type-name-lookup-key-from-id
              ctx
              (tc-global-shared-view name)
              name-id)]))]
    [source-name : String
      (match (tc-global-shared-view source-result)
        [(Ok key) key]
        [(Err _) (owned_view.compiler-owned-shared-view name)])]
    [source-id : i64
      (if (>= current-dotted-id 0)
        current-dotted-id
        (match direct-source-key
          [(Some key-id) key-id]
          [(None)
            (match source-result
              [(Ok key)
                (if (string.eq key name)
                  name-id
                  (tc-dotted-resolved-key-id-or ctx name-id name-id))]
              [(Err _)
                (match (tc-dotted-unique-nominal-type-id ctx name name-id)
                  [(Some unique-id) unique-id]
                  [(None) name-id])])]))]
    [in-current-module : bool
      (and
        (> (string.string-length module) 0)
        (not
          (tc-name-qualified-id? (tc-context-structural-session ctx) source-id)))]
    [lookup-id : i64
      (if in-current-module
        (tc-qualified-name-key-id module-id source-id)
        source-id)]
    [handle : i64
      (if (>= lookup-id 0)
        (tc-resolve-type-name-symbol-lookup-id
          (tc-job-state-nominal-cache (tc-context-job-state ctx))
          symbols
          lookup-id)
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (if (and
        (tc-name-qualified-id? (tc-context-structural-session ctx) lookup-id)
        (= (tc-qualified-name-module-id lookup-id) module-id))
        (match (tc-stdlib-comptime-syntax-type-id lookup-id)
          [(Some syntax-ty) syntax-ty]
          [(No)
            (tc-resolved-current-module-nominal-type-with-args-id
              ctx
              lookup-id
              handle
              lifetimes)])
        (let
          [canonical-id : i64 (tc-nominal-owner-id-or ctx handle lookup-id)]
          (match (tc-stdlib-comptime-syntax-type-id canonical-id)
            [(Some syntax-ty) syntax-ty]
            [(No)
              (tc-resolved-nominal-type-with-args-id
                (tc-qualified-lookup-owner-id
                  (tc-context-structural-session ctx)
                  lookup-id
                  canonical-id)
                handle
                lifetimes)])))
      (if (tc-name-qualified-id? (tc-context-structural-session ctx) source-id)
        (match (tc-context-enum-variants-id ctx source-id source-name)
          [(Ok _) (ast.ast-ty-enum-args source-id lifetimes)]
          [(Err _) (ast.ast-ty-var-args name-id lifetimes)])
        (ast.ast-ty-var-args name-id lifetimes)))))

(define (tc-resolve-type-name-with-args
  [ctx : TcContext]
  [name : String]
  [name-id : i64]
  [lifetimes : ast.AstLifetimeList]) : ast.AstType
  (let
    [resolution-ctx : TcContext (tc-context-for-type-resolution ctx)]
    (if (macro-hygiene-global-id? (tc-context-structural-session ctx) name-id)
      (let
        [source-id : i64
          (macro-hygiene-structural-source-name-id
            (tc-context-structural-session ctx)
            name-id)]
        [module-id : i64
          (macro-hygiene-global-module-id
            (tc-context-structural-session ctx)
            name-id)]
        [source-ctx : TcContext
          (if (csym.compiler-symbol-root-module-id? module-id)
            (tc-context-with-module-id
              resolution-ctx
              ""
              cbi.compiler-builtin-id-fix-empty)
            (tc-context-with-module-id
              resolution-ctx
              (tc-env-key-name-text module-id)
              module-id))]
        (tc-resolve-source-type-name-with-args
          source-ctx
          (ci.intern-str source-id)
          source-id
          lifetimes))
      (tc-resolve-source-type-name-with-args
        resolution-ctx
        name
        name-id
        lifetimes))))

(define (tc-source-str-value-policy-message) : String
  (tc-kind-message
    (BorrowViolation)
    "typecheck: str is a borrowed string-slice referent; use (& lifetime str)"))

(define (tc-source-str-mut-ref-policy-message) : String
  "typecheck: mutable references to str are reserved; use immutable (& lifetime str)")

(define (tc-source-bytes-value-policy-message) : String
  (tc-kind-message
    (BorrowViolation)
    "typecheck: bytes is a borrowed byte-slice referent; use (& lifetime bytes) or (&mut lifetime bytes)"))

(define (tc-source-type-policy-message [name : String]) : String
  (cond
    [(string.eq name "varying")
      (tc-kind-message
        (Spmd)
        "typecheck: public SPMD varying source types are deferred; varying is inferred inside foreach")]
    [(string.eq name "Varying")
      (tc-kind-message
        (Spmd)
        "typecheck: public SPMD varying source types are deferred; varying is inferred inside foreach")]
    [(string.eq name "Vector")
      (tc-kind-message
        (Spmd)
        "typecheck: public SPMD vector source types are deferred; vector values remain compiler-internal")]
    [(string.eq name "vector")
      (tc-kind-message
        (Spmd)
        "typecheck: public SPMD vector source types are deferred; vector values remain compiler-internal")]
    [(string.eq name "Mask")
      (tc-kind-message
        (Spmd)
        "typecheck: public SPMD mask source types are deferred; masks remain compiler-internal")]
    [(string.eq name "mask")
      (tc-kind-message
        (Spmd)
        "typecheck: public SPMD mask source types are deferred; masks remain compiler-internal")]
    [else
      (str_cat.str-cat
        (cdiag.compiler-diagnostic-typecheck-tag (UnboundName))
        "typecheck: unknown type "
        name
        "; TypeLisp has no source-level type parameters; use comptime-generated concrete declarations instead")]))

(define (tc-nominal-lifetimes-from-decl [decl : ast.AstDecl]) : ResultTcLifetimeList
  (match decl
    [(or (DefEnum _ _ _ _) (DefStruct _ _ _ _ _))
      (Ok (ast.ast-lifetime-list-new))]
    [(or (DefEnumLifetimes _ _ lifetimes _ _)
         (DefStructLifetimes _ _ lifetimes _ _ _))
      (Ok lifetimes)]
    [_
      (Err (tc-kind-message (UnboundName) "typecheck: nominal type not found"))]))

(define (tc-nominal-decl-name-id-matches?
  [session : cis.InternStructuralSessionHandle]
  [lookup-id : i64]
  [module-id : i64]
  [decl-id : i64]) : bool
  (or
    (= lookup-id decl-id)
    (and
      (tc-name-qualified-id? session lookup-id)
      (= (tc-qualified-name-module-id lookup-id) module-id)
      (= (tc-qualified-name-base-id lookup-id) decl-id))))

(define (tc-program-nominal-lifetimes-from-decl
  [session : cis.InternStructuralSessionHandle]
  [decl : ast.AstDecl]
  [lookup-id : i64]
  [module-id : i64]) : ResultTcLifetimeList
  (match decl
    [(or (DefEnum _ name _ _) (DefStruct _ name _ _ _))
      (if (tc-nominal-decl-name-id-matches? session lookup-id module-id name)
        (Ok (ast.ast-lifetime-list-new))
        (Err
          (tc-kind-message (UnboundName) "typecheck: nominal type not found")))]
    [(or (DefEnumLifetimes _ name lifetimes _ _)
         (DefStructLifetimes _ name lifetimes _ _ _))
      (if (tc-nominal-decl-name-id-matches? session lookup-id module-id name)
        (Ok lifetimes)
        (Err
          (tc-kind-message (UnboundName) "typecheck: nominal type not found")))]
    [(Unsafe inner-box)
      (tc-program-nominal-lifetimes-from-decl
        session
        (ast.ast-decl-box-shared-view inner-box)
        lookup-id
        module-id)]
    [_
      (Err (tc-kind-message (UnboundName) "typecheck: nominal type not found"))]))

(define (tc-program-nominal-lifetimes-in-module
  [session : cis.InternStructuralSessionHandle]
  [decls : ast.AstDeclList]
  [lookup-id : i64]
  [module-id : i64]) : ResultTcLifetimeList
  (match (ast.ast-decl-list-step decls)
    [(Nil)
      (Err (tc-kind-message (UnboundName) "typecheck: nominal type not found"))]
    [(Cons decl rest)
      (match (tc-global-shared-view decl)
        [(Module next-module)
          (tc-program-nominal-lifetimes-in-module
            session
            rest
            lookup-id
            next-module)]
        [_
          (match (tc-program-nominal-lifetimes-from-decl
            session
            decl
            lookup-id
            module-id)
            [(Ok lifetimes) (Ok lifetimes)]
            [(Err _)
              (tc-program-nominal-lifetimes-in-module
                session
                rest
                lookup-id
                module-id)])])]))

(define (tc-program-nominal-lifetimes
  [session : cis.InternStructuralSessionHandle]
  [program : ast.AstProgram]
  [lookup-id : i64]) : ResultTcLifetimeList
  (match program
    [(Program decls-box)
      (tc-program-nominal-lifetimes-in-module
        session
        (ast.ast-decl-list-box-shared-view decls-box)
        lookup-id
        -1)]))

(define (tc-nominal-lifetimes-id [ctx : TcContext] [name-id : i64]) : ResultTcLifetimeList
  (let
    [symbols : (& ctx csym.CompilerSymbols) (tc-context-symbols ctx)]
    [handle : i64
      (tc-type-handle-lookup-id
        (tc-job-state-nominal-cache (tc-context-job-state ctx))
        (& symbols)
        name-id
        tc-type-handle-lookup-caller-nominal-lifetime)]
    (if (csym.compiler-symbols-handle-found? handle)
      (let
        [decl : ast.AstDecl
          (try
            (csym.compiler-symbols-decl-at-index
              symbols
              (csym.compiler-symbol-handle-index handle)))]
        (tc-nominal-lifetimes-from-decl decl))
      (match (tc-program-nominal-lifetimes
        (tc-context-structural-session ctx)
        (tc-context-program ctx)
        name-id)
        [(Ok lifetimes) (Ok lifetimes)]
        [(Err message)
          (Err
            (str_cat.str-cat
              message
              ": "
              (tc-nominal-name-id-display name-id)
              "#"
              (string.int->string name-id)))]))))

(define (tc-arena-nominal-name-id? [name-id : i64]) : bool
  (=
    (csym.compiler-symbol-name-id-key name-id)
    (csym.compiler-symbol-name-id-key cbi.compiler-builtin-id-arena-type)))

(define (tc-branded-arena-erases-to-bare?
  [expected-name-id : i64]
  [actual-name-id : i64]
  [actual-lifetimes : ast.AstLifetimeList]) : bool
  (and
    (tc-arena-nominal-name-id? expected-name-id)
    (tc-arena-nominal-name-id? actual-name-id)
    (= (tc-lifetime-list-count actual-lifetimes) 1)))

(define (tc-nominal-lifetime-use-policy-ok
  [ctx : TcContext]
  [name-id : i64]
  [lifetimes : ast.AstLifetimeList]) : ResultTcUnit
  (match (tc-nominal-lifetimes-id ctx name-id)
    [(Ok params)
      (if (or
        (= (tc-lifetime-list-count params) (tc-lifetime-list-count lifetimes))
        (and
          (tc-arena-nominal-name-id? name-id)
          (= (tc-lifetime-list-count lifetimes) 1)))
        Ok
        (Err
          (tc-kind-message
            (ArityMismatch)
            "typecheck: nominal lifetime argument arity mismatch")))]
    [(Err message)
      (Err
        (str_cat.str-cat
          message
          ": "
          (tc-nominal-name-id-display name-id)
          "#"
          (string.int->string name-id)))]))

(define (tc-bare-nominal-lifetime-policy-ok [ctx : TcContext] [name-id : i64]) : ResultTcUnit
  (let
    [params (try (tc-nominal-lifetimes-id ctx name-id))]
    (if (or
      (ast.ast-lifetime-list-empty? (& params))
      (tc-arena-nominal-name-id? name-id))
      Ok
      (Err "typecheck: missing nominal lifetime arguments"))))

(define (tc-source-type-list-policy-ok
  [ctx : TcContext]
  [types : ast.AstTypeList]) : ResultTcUnit
  (tc-source-type-list-policy-ok-at ctx (& types) 0))

;; `(:invalidate r T)` is valid only as a runtime parameter type. It consumes
;; an owned, non-reference `T` whose resolved type contains lifetime `r`
;; (#6670).
(define (tc-source-param-type-policy-ok
  [ctx : TcContext]
  [ty : ast.AstType]
  [comptime? : bool]) : ResultTcUnit
  (match (tc-global-shared-view ty)
    [(Invalidate lifetime inner-id)
      (let
        [inner : ast.AstType (ast.ty-node-get inner-id)]
        (cond
          [comptime?
            (Err
              (tc-kind-message
                (ArenaOwnership)
                "typecheck: :invalidate requires a runtime parameter"))]
          [else
            (let
              [_
                (try
                  (tc-source-type-policy-ok ctx (tc-global-shared-view inner)))]
              [resolved : ast.AstType (tc-resolve-type ctx inner)]
              (cond
                [(tc-type-reference?
                    (tc-type-strip-region (tc-global-shared-view resolved)))
                  (Err
                    (tc-kind-message
                      (ArenaOwnership)
                      "typecheck: :invalidate requires an owned parameter, not a reference"))]
                [(not (tc-type-contains-region resolved lifetime))
                  (Err
                    (tc-kind-message
                      (ArenaOwnership)
                      (str_cat.str-cat
                        "typecheck: :invalidate lifetime `"
                        (tc-lifetime-name-render lifetime)
                        "` does not appear in the parameter type")))]
                [else Ok]))]))]
    [_ (tc-source-type-policy-ok ctx ty)]))

(define (tc-type-reference? [ty : ast.AstType]) : bool
  (match ty
    [(or (Ref _ _) (MutRef _ _)) true]
    [_ false]))

;; The signature of a callable with `:invalidate` parameters: no lifetime is
;; invalidated twice, and the result never carries an invalidated lifetime.
(define (tc-source-invalidate-lifetimes-policy-ok
  [lifetimes : TcNameIdList]
  [ret : ast.AstType]) : ResultTcUnit
  (let
    [cursor : TcNameIdList lifetimes]
    [failure : String ""]
    (while (and
      (= (string.string-length failure) 0)
      (not (tc-name-id-list-empty? cursor)))
      (let
        [lifetime : i64 (tc-name-id-list-head cursor)]
        [rest : TcNameIdList (tc-name-id-list-rest cursor)]
        (cond
          [(tc-name-id-list-contains rest lifetime)
            (set!
              failure
              (str_cat.str-cat
                "typecheck: lifetime `"
                (tc-lifetime-name-render lifetime)
                "` is invalidated by more than one parameter"))]
          [(tc-type-contains-region (tc-global-shared-view ret) lifetime)
            (set!
              failure
              (str_cat.str-cat
                "typecheck: a result cannot contain lifetime `"
                (tc-lifetime-name-render lifetime)
                "` that its function invalidates"))]
          [else unit])
        (set! cursor rest)))
    (if (= (string.string-length failure) 0)
      Ok
      (Err (tc-kind-message (ArenaOwnership) failure)))))

(define (tc-param-list-invalidate-lifetimes
  [params : (& params ast.AstParamList)]) : TcNameIdList
  (unless (tc-invalidate-types-present?) (return Nil))
  (let
    [out : TcNameIdList Nil]
    [index : i64 0]
    (while (< index (ast.ast-param-list-len params))
      (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
        [(Param _ ty _)
          (match (tc-type-invalidate-lifetime (tc-global-shared-view ty))
            [(Some lifetime) (set! out (tc-name-id-list-cons out lifetime))]
            [(No) unit])])
      (set! index (+ index 1)))
    out))

(define (tc-type-list-invalidate-lifetimes [types : (& types ast.AstTypeList)]) : TcNameIdList
  (unless (tc-invalidate-types-present?) (return Nil))
  (let
    [out : TcNameIdList Nil]
    [index : i64 0]
    (while (< index (ast.ast-type-list-len types))
      (match (tc-type-invalidate-lifetime
        (ast.ty-node-get
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback))))
        [(Some lifetime) (set! out (tc-name-id-list-cons out lifetime))]
        [(No) unit])
      (set! index (+ index 1)))
    out))

(define (tc-source-param-type-list-policy-ok-at
  [ctx : TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast.ast-type-list-len types))
    Ok
    (let
      [_
        (try
          (tc-source-param-type-policy-ok
            ctx
            (ast.ty-node-get
              (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))
            false))]
      (tc-source-param-type-list-policy-ok-at ctx types (+ index 1)))))

(define (tc-source-type-list-policy-ok-at
  [ctx : TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast.ast-type-list-len types))
    Ok
    (let
      [_
        (try
          (tc-source-type-policy-ok
            ctx
            (ast.ty-node-get
              (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))))]
      (tc-source-type-list-policy-ok-at ctx types (+ index 1)))))

(define (tc-source-elided-reference-policy-message) : String
  (tc-kind-message
    (LifetimeMismatch)
    "typecheck: elided reference lifetime is only allowed in function signatures; write an explicit lifetime"))

(define (tc-source-function-type-policy-ok
  [ctx : TcContext]
  [args : ast.AstTypeList]
  [ret : ast.AstType]) : ResultTcUnit
  (let
    [normalized
      (try (tc-elide-function-type (tc-context-type-bases ctx) args ret))]
    (match normalized.ty
      [(Func normalized-args normalized-ret)
        (let
          [arg-types : ast.AstTypeList
            (ast.ast-type-list-box-shared-view normalized-args)]
          [_ (try (tc-source-param-type-list-policy-ok-at ctx (& arg-types) 0))]
          (let
            [_
              (try
                (tc-source-type-policy-ok ctx (ast.ty-node-get normalized-ret)))]
            (tc-source-invalidate-lifetimes-policy-ok
              (tc-type-list-invalidate-lifetimes (& arg-types))
              (ast.ty-node-get normalized-ret))))]
      [_
        (Err
          (tc-kind-message
            (TypeMismatch)
            "typecheck: internal lifetime-elision function type mismatch"))])))

;; Validate a written type. A REFERENT? type is the immediate referent of Ptr,
;; MutPtr, & or &mut, the one position where an opaque aggregate foreign to the
;; code's module family may appear (#6999); every other position holds it by
;; value.
(define (tc-source-type-policy-ok [ctx : TcContext] [ty : ast.AstType]) : ResultTcUnit
  (tc-source-type-policy-ok-at ctx ty false))

(define (tc-source-type-policy-ok-at
  [ctx : TcContext]
  [ty : ast.AstType]
  [referent? : bool]) : ResultTcUnit
  (if (tc-type-unquote-marker? (tc-global-shared-view ty))
    Ok
    (let
      [syntax-ok : ResultTcUnit
        (match (tc-global-shared-view ty)
          [(or (Var name) (VarArgs name _))
            (match (tc-source-type-name-lookup-key
              ctx
              (tc-env-key-name-text name)
              name)
              [(Ok _) Ok]
              [(Err message) (Err message)])]
          [_ Ok])]
      [_ (try syntax-ok)]
      (match (tc-resolve-type ctx ty)
        [(CFunc signature _)
          (let
            [shape : ast.AstType (tc-context-type-get ctx signature)]
            [_ (try (tc-check-extern-c-abi ctx (tc-global-shared-view shape)))]
            (tc-source-type-policy-ok ctx shape))]
        [(Func args ret)
          (tc-source-function-type-policy-ok
            ctx
            (ast.ast-type-list-box-shared-view args)
            (ast.ty-node-get ret))]
        [(Tuple elems)
          (tc-source-type-list-policy-ok
            ctx
            (ast.ast-type-list-box-shared-view elems))]
        [(or (Array elem _) (DynArray elem) (Box elem) (Region _ elem))
          (tc-source-type-policy-ok ctx (ast.ty-node-get elem))]
        [(Slice _)
          (Err
            (tc-kind-message
              (TypeMismatch)
              "typecheck: bare Slice type is unsized; borrow it"))]
        [(or (Ptr elem) (MutPtr elem))
          (tc-source-type-policy-ok-at ctx (ast.ty-node-get elem) true)]
        [(Ref lifetime inner)
          (if (tc-elided-lifetime? lifetime)
            (Err (tc-source-elided-reference-policy-message))
            (match (tc-resolve-type ctx (ast.ty-node-get inner))
              [(or (Str) (Bytes)) Ok]
              ;; Slice has no owning/value representation.  It is legal
              ;; only as the immediate referent of a borrow; validate the
              ;; element recursively so nested/unsized elements remain
              ;; rejected by the normal source policy.
              [(Slice elem)
                (tc-source-type-policy-ok ctx (ast.ty-node-get elem))]
              [_ (tc-source-type-policy-ok-at ctx (ast.ty-node-get inner) true)]))]
        [(MutRef lifetime inner)
          (if (tc-elided-lifetime? lifetime)
            (Err (tc-source-elided-reference-policy-message))
            (match (tc-resolve-type ctx (ast.ty-node-get inner))
              [(Str) (Err (tc-source-str-mut-ref-policy-message))]
              [(Bytes) Ok]
              [(Slice elem)
                (tc-source-type-policy-ok ctx (ast.ty-node-get elem))]
              [_ (tc-source-type-policy-ok-at ctx (ast.ty-node-get inner) true)]))]
        [(Invalidate _ _)
          (Err
            (tc-kind-message
              (ArenaOwnership)
              "typecheck: (:invalidate r T) is only valid as a parameter type"))]
        [(Str) (Err (tc-source-str-value-policy-message))]
        [(Bytes) (Err (tc-source-bytes-value-policy-message))]
        [(or (Enum name) (Struct name))
          (let
            [_ (try (tc-source-opaque-value-policy-ok ctx name referent?))]
            (tc-bare-nominal-lifetime-policy-ok ctx name))]
        [(or (EnumArgs name lifetimes) (StructArgs name lifetimes))
          (let
            [_ (try (tc-source-opaque-value-policy-ok ctx name referent?))]
            (tc-nominal-lifetime-use-policy-ok
              ctx
              name
              (ast.ast-lifetime-list-box-shared-view lifetimes)))]
        [(VarArgs name _)
          (Err
            (tc-source-type-policy-message (tc-nominal-name-id-display name)))]
        [(Var name)
          (if (or
            (= name cbi.compiler-builtin-id-fix-ExprClause)
            (= name cbi.compiler-builtin-id-fix-ExprClauseList)
            (= name cbi.compiler-builtin-id-fix-ExprBindingClause)
            (= name cbi.compiler-builtin-id-fix-ExprBindingClauseList)
            (= name cbi.compiler-builtin-id-fix-Pattern)
            (= name cbi.compiler-builtin-id-fix-PatternList)
            (= name cbi.compiler-builtin-id-fix-MatchArm)
            (= name cbi.compiler-builtin-id-fix-MatchArmList))
            Ok
            (Err
              (tc-source-type-policy-message (tc-nominal-name-id-display name))))]
        [_ Ok]))))

(define (tc-source-maybe-type-policy-ok
  [ctx : TcContext]
  [maybe-ty : ast.AstMaybeType]) : ResultTcUnit
  (match maybe-ty
    [(No) Ok]
    [(Some ty) (tc-source-type-policy-ok ctx ty)]))

(define (tc-source-param-list-policy-ok
  [ctx : TcContext]
  [params : (& params ast.AstParamList)]) : ResultTcUnit
  (tc-source-param-list-policy-ok-at ctx (& params) 0))

(define (tc-source-param-list-policy-ok-at
  [ctx : TcContext]
  [params : (& params ast.AstParamList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast.ast-param-list-len params))
    Ok
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param _ ty comptime?)
        (let
          [_ (try (tc-source-param-type-policy-ok ctx ty comptime?))]
          (tc-source-param-list-policy-ok-at ctx params (+ index 1)))])))

(define (tc-source-macro-param-list-policy-ok
  [ctx : TcContext]
  [params : ast.AstMacroParamList]) : ResultTcUnit
  (tc-source-macro-param-list-policy-ok-at ctx (& params) 0))

(define (tc-source-macro-param-list-policy-ok-at
  [ctx : TcContext]
  [params : (& params ast.AstMacroParamList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast.ast-macro-param-list-len params))
    Ok
    (match (ast.ast-macro-param-list-get
      params
      index
      (ast.ast-macro-param-fallback))
      [(Param _ ty variadic _)
        (cond
          [(and
              variadic
              (< (+ index 1) (ast.ast-macro-param-list-len params))
              (not
                (tc-macro-expr-binding-clause-type?
                  (tc-resolve-type ctx (tc-global-shared-view ty)))))
            (Err
              "typecheck: only ExprBindingClause macro operands may be variadic before a later operand")]
          [(tc-macro-type-param-kind? (tc-global-shared-view ty))
            (if variadic
              (Err "typecheck: type macro operand cannot be variadic")
              (tc-source-macro-param-list-policy-ok-at ctx params (+ index 1)))]
          [(tc-macro-module-param-kind? (tc-global-shared-view ty))
            (if variadic
              (Err "typecheck: Module macro operand cannot be variadic")
              (tc-source-macro-param-list-policy-ok-at ctx params (+ index 1)))]
          [else
            (let
              [_ (try (tc-source-type-policy-ok ctx ty))]
              (tc-source-macro-param-list-policy-ok-at ctx params (+ index 1)))])])))

(define (tc-macro-result-name-id?
  [ty : ast.AstType]
  [upper-id : i64]
  [lower-id : i64]) : bool
  (match ty
    [(Var name) (or (= name upper-id) (= name lower-id))]
    [_ false]))

(define (tc-macro-result-module? [ty : ast.AstType]) : bool
  (tc-macro-result-name-id?
    ty
    cbi.compiler-builtin-id-fix-Module
    cbi.compiler-builtin-id-fix-module))

(define (tc-macro-result-decls? [ty : ast.AstType]) : bool
  (tc-macro-result-name-id?
    ty
    cbi.compiler-builtin-id-fix-Decls
    cbi.compiler-builtin-id-fix-decls))

(define (tc-macro-result-decl-emitting? [ty : ast.AstType]) : bool
  (or
    (tc-macro-result-module? (tc-global-shared-view ty))
    (tc-macro-result-decls? ty)))

(define (tc-source-macro-result-policy-ok [ctx : TcContext] [ty : ast.AstType]) : ResultTcUnit
  (if (tc-macro-result-decl-emitting? (tc-global-shared-view ty))
    Ok
    (tc-source-type-policy-ok ctx ty)))

(define (tc-source-field-list-policy-ok
  [ctx : TcContext]
  [fields : ast.AstFieldDefList]) : ResultTcUnit
  (tc-source-field-list-policy-ok-at ctx (& fields) 0))

(define (tc-source-field-list-policy-ok-at
  [ctx : TcContext]
  [fields : (& fields ast.AstFieldDefList)]
  [index : i64]) : ResultTcUnit
  (if (>= index fields.len)
    Ok
    (match (ast.ast-field-def-list-get
      fields
      index
      (ast.ast-field-def-fallback))
      [(Def _ ty _)
        (let
          [_ (try (tc-source-type-policy-ok ctx ty))]
          (tc-source-field-list-policy-ok-at ctx fields (+ index 1)))])))

(define (tc-struct-cleanup-repr-c-message [struct-name : String]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (ResourceOwnership))
    "typecheck: cleanup-owning struct "
    struct-name
    " cannot use repr c"))

(define (tc-source-variant-list-policy-ok
  [ctx : TcContext]
  [variants : ast.AstVariantDefList]) : ResultTcUnit
  (tc-source-variant-list-policy-ok-at ctx (& variants) 0))

(define (tc-source-variant-list-policy-ok-at
  [ctx : TcContext]
  [variants : (& variants ast.AstVariantDefList)]
  [index : i64]) : ResultTcUnit
  (if (>= index variants.len)
    Ok
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(Def _ fields _)
        (let
          [_ (try (tc-source-type-list-policy-ok ctx fields))]
          (tc-source-variant-list-policy-ok-at ctx variants (+ index 1)))])))

(define (tc-decl-lifetime-name-allowed?
  [params : ast.AstLifetimeList]
  [name : i64]) : bool
  (or
    (string.eq (tc-env-key-name-text name) "program")
    (tc-lifetime-list-contains params name)))

(define (tc-decl-lifetime-id-list-all-in?
  [lifetimes : TcNameIdList]
  [params : ast.AstLifetimeList]) : bool
  (let
    [cursor : TcNameIdList lifetimes]
    [allowed : bool true]
    (while (and allowed (not (tc-name-id-list-empty? cursor)))
      (if (tc-decl-lifetime-name-allowed?
        (tc-global-shared-view params)
        (tc-name-id-list-head cursor))
        unit
        (set! allowed false))
      (set! cursor (tc-name-id-list-rest cursor)))
    allowed))

(define (tc-source-type-decl-lifetimes-ok
  [ctx : TcContext]
  [params : ast.AstLifetimeList]
  [ty : ast.AstType]) : ResultTcUnit
  (let
    [lifetimes : TcNameIdList
      (tc-type-collect-reference-lifetimes (tc-resolve-type ctx ty))]
    (if (tc-decl-lifetime-id-list-all-in? lifetimes params)
      Ok
      (Err "typecheck: unknown aggregate lifetime parameter"))))

(define (tc-source-field-list-lifetimes-policy-ok
  [ctx : TcContext]
  [params : ast.AstLifetimeList]
  [fields : ast.AstFieldDefList]) : ResultTcUnit
  (tc-source-field-list-lifetimes-policy-ok-at ctx params (& fields) 0))

(define (tc-source-field-list-lifetimes-policy-ok-at
  [ctx : TcContext]
  [params : ast.AstLifetimeList]
  [fields : (& fields ast.AstFieldDefList)]
  [index : i64]) : ResultTcUnit
  (if (>= index fields.len)
    Ok
    (match (ast.ast-field-def-list-get
      fields
      index
      (ast.ast-field-def-fallback))
      [(Def _ ty _)
        (let
          [_ (try (tc-source-type-policy-ok ctx (tc-global-shared-view ty)))]
          (let
            [_
              (try
                (tc-source-type-decl-lifetimes-ok
                  ctx
                  (tc-global-shared-view params)
                  ty))]
            (tc-source-field-list-lifetimes-policy-ok-at
              ctx
              params
              fields
              (+ index 1))))])))

(define (tc-source-type-list-lifetimes-policy-ok
  [ctx : TcContext]
  [params : ast.AstLifetimeList]
  [types : ast.AstTypeList]) : ResultTcUnit
  (tc-source-type-list-lifetimes-policy-ok-at ctx params (& types) 0))

(define (tc-source-type-list-lifetimes-policy-ok-at
  [ctx : TcContext]
  [params : ast.AstLifetimeList]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast.ast-type-list-len types))
    Ok
    (let
      [head : ast.AstType
        (ast.ty-node-get
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      [_ (try (tc-source-type-policy-ok ctx (tc-global-shared-view head)))]
      (let
        [_
          (try
            (tc-source-type-decl-lifetimes-ok
              ctx
              (tc-global-shared-view params)
              head))]
        (tc-source-type-list-lifetimes-policy-ok-at
          ctx
          params
          types
          (+ index 1))))))

(define (tc-source-variant-list-lifetimes-policy-ok
  [ctx : TcContext]
  [params : ast.AstLifetimeList]
  [variants : ast.AstVariantDefList]) : ResultTcUnit
  (tc-source-variant-list-lifetimes-policy-ok-at ctx params (& variants) 0))

(define (tc-source-variant-list-lifetimes-policy-ok-at
  [ctx : TcContext]
  [params : ast.AstLifetimeList]
  [variants : (& variants ast.AstVariantDefList)]
  [index : i64]) : ResultTcUnit
  (if (>= index variants.len)
    Ok
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(Def _ fields _)
        (let
          [_
            (try
              (tc-source-type-list-lifetimes-policy-ok
                ctx
                (tc-global-shared-view params)
                fields))]
          (tc-source-variant-list-lifetimes-policy-ok-at
            ctx
            params
            variants
            (+ index 1)))])))

(define (tc-source-default-aggregate-layout-finite-ok
  [ctx : TcContext]
  [name-id : i64]) : ResultTcUnit
  (let
    [qualified-id : i64
      (tc-module-name-id-by-id (tc-context-module-id ctx) name-id)]
    (tc-inline-aggregate-nominal-finite-ok
      ctx
      (tc-nominal-name-id-display qualified-id)
      qualified-id
      Nil)))

(define (tc-source-struct-layout-ok
  [ctx : TcContext]
  [name-id : i64]
  [repr : ast.AstStructRepr]
  [fields : ast.AstFieldDefList]) : ResultTcUnit
  (let
    [_ (try (tc-source-default-aggregate-layout-finite-ok ctx name-id))]
    (if (ast.ast-struct-repr-c? (& repr))
      (tc-repr-c-declared-align-ok ctx name-id (& repr) fields)
      Ok)))

;; Storage placement guarantees 8-byte alignment for every owned instance
;; (stack slots, `tl_alloc`, and data cells), so a declared alignment above it
;; has no sound placement yet and is rejected.
(define tc-declared-align-storage-max : i64
  8)

(define (tc-declared-align-message
  [struct-id : i64]
  [field-id : i64]
  [declared : i64]
  [problem : String]
  [limit : i64]) : String
  (str_cat.str-cat
    "typecheck: repr c struct "
    (tc-env-key-name-text struct-id)
    (if (< field-id 0)
      ""
      (str_cat.str-cat " field " (tc-env-key-name-text field-id)))
    " declares (:align "
    (string.int->string declared)
    ")"
    problem
    (string.int->string limit)))

;; A `(:repr c)` struct's declared alignments, checked against the natural
;; layout once every field type is known: like C11 `_Alignas`, a field's
;; `(:align N)` may not weaken its type's alignment and a struct's may not
;; weaken the alignment its fields already require. A struct whose fields
;; are all zero-sized has no storage to align.
(define (tc-repr-c-declared-align-ok
  [ctx : TcContext]
  [name-id : i64]
  [repr : (& repr ast.AstStructRepr)]
  [fields : ast.AstFieldDefList]) : ResultTcUnit
  (let
    [declared : i64 (ast.ast-struct-repr-declared-align repr)]
    (match (tc-repr-c-declared-field-align-ok
      ctx
      name-id
      repr
      (& fields)
      (> declared 0)
      0
      0
      1)
      [(Ok (TcLayoutInfo field-bytes field-align))
        (cond
          [(= declared 0) Ok]
          [(= field-bytes 0)
            (Err
              (str_cat.str-cat
                (tc-declared-align-message
                  name-id
                  -1
                  declared
                  " but its fields occupy "
                  0)
                " bytes"))]
          [(< declared field-align)
            (Err
              (tc-declared-align-message
                name-id
                -1
                declared
                " below the alignment its fields require, "
                field-align))]
          [(> declared tc-declared-align-storage-max)
            (Err
              (tc-declared-align-message
                name-id
                -1
                declared
                "; storage cannot yet place values aligned above "
                tc-declared-align-storage-max))]
          [else Ok])]
      [(Err message) (Err message)])))

;; Check each field's declared alignment and return the total field bytes
;; and the largest effective field alignment. Natural layouts are computed
;; only for fields that declare an alignment, or for every field when the
;; struct itself declares one.
(define (tc-repr-c-declared-field-align-ok
  [ctx : TcContext]
  [struct-id : i64]
  [repr : (& repr ast.AstStructRepr)]
  [fields : (& fields ast.AstFieldDefList)]
  [need-all : bool]
  [index : i64]
  [field-bytes : i64]
  [max-align : i64]) : ResultTcLayoutInfo
  (if (>= index fields.len)
    (Ok (TcLayoutInfo field-bytes max-align))
    (match (ast.ast-field-def-list-get
      fields
      index
      (ast.ast-field-def-fallback))
      [(Def name ty _)
        (let
          [declared : i64 (ast.ast-struct-repr-field-declared-align repr index)]
          (if (and (= declared 0) (not need-all))
            (tc-repr-c-declared-field-align-ok
              ctx
              struct-id
              repr
              fields
              need-all
              (+ index 1)
              field-bytes
              max-align)
            (let
              [info
                (try
                  (tc-inline-aggregate-type-layout ctx (tc-resolve-type ctx ty)))]
              [natural : i64 (tc-layout-info-align info)]
              [next-bytes : i64 (+ field-bytes (tc-layout-info-size info))]
              (cond
                [(= declared 0)
                  (tc-repr-c-declared-field-align-ok
                    ctx
                    struct-id
                    repr
                    fields
                    need-all
                    (+ index 1)
                    next-bytes
                    (tc-max-i64 max-align natural))]
                [(< declared natural)
                  (Err
                    (tc-declared-align-message
                      struct-id
                      (ci.intern-syntax-id-value name)
                      declared
                      " below its type's natural alignment "
                      natural))]
                [(> declared tc-declared-align-storage-max)
                  (Err
                    (tc-declared-align-message
                      struct-id
                      (ci.intern-syntax-id-value name)
                      declared
                      "; storage cannot yet place values aligned above "
                      tc-declared-align-storage-max))]
                [else
                  (tc-repr-c-declared-field-align-ok
                    ctx
                    struct-id
                    repr
                    fields
                    need-all
                    (+ index 1)
                    next-bytes
                    (tc-max-i64 max-align declared))]))))])))

(define (tc-source-pattern-list-policy-ok
  [ctx : TcContext]
  [patterns : ast.AstPatternList]) : ResultTcUnit
  (tc-source-pattern-list-policy-ok-at ctx (& patterns) 0))

(define (tc-source-pattern-list-policy-ok-at
  [ctx : TcContext]
  [patterns : (& patterns ast.AstPatternList)]
  [index : i64]) : ResultTcUnit
  (if (>= index patterns.len)
    Ok
    (let
      [_
        (try
          (tc-source-pattern-policy-ok
            ctx
            (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))))]
      (tc-source-pattern-list-policy-ok-at ctx patterns (+ index 1)))))

(define (tc-source-pattern-policy-ok
  [ctx : TcContext]
  [pattern : ast.AstPattern]) : ResultTcUnit
  (match pattern
    [(Var _ maybe-ty) (tc-source-maybe-type-policy-ok ctx maybe-ty)]
    [(or (Tuple patterns-box) (Array patterns-box) (Slice patterns-box _)
         (Or patterns-box) (Fields patterns-box) (Field _ patterns-box)
         (Variant _ patterns-box))
      (let
        [patterns : ast.AstPatternList
          (ast.ast-pattern-list-box-shared-view patterns-box)]
        (tc-source-pattern-list-policy-ok ctx patterns))]
    [_ Ok]))

(define (tc-source-match-arm-list-policy-ok
  [ctx : TcContext]
  [expr-bases : i64]
  [arms : ast.AstMatchArmList]) : ResultTcUnit
  (tc-source-match-arm-list-policy-ok-at ctx expr-bases (& arms) 0))

(define (tc-source-match-arm-list-policy-ok-at
  [ctx : TcContext]
  [expr-bases : i64]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : ResultTcUnit
  (if (>= index arms.len)
    Ok
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          [_ (try (tc-source-pattern-policy-ok ctx pattern))]
          (let
            [_ (try (tc-source-expr-policy-ok ctx expr-bases body))]
            (tc-source-match-arm-list-policy-ok-at
              ctx
              expr-bases
              arms
              (+ index 1))))])))

(define (tc-source-let-binding-list-policy-ok
  [ctx : TcContext]
  [expr-bases : i64]
  [bindings : ast.AstLetBindingList]) : ResultTcUnit
  (tc-source-let-binding-list-policy-ok-at ctx expr-bases (& bindings) 0))

(define (tc-source-let-binding-list-policy-ok-at
  [ctx : TcContext]
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast.ast-let-binding-list-len bindings))
    Ok
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding _ maybe-ty init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [_ (try (tc-source-maybe-type-policy-ok ctx maybe-ty))]
          (let
            [_ (try (tc-source-expr-policy-ok ctx expr-bases init))]
            (tc-source-let-binding-list-policy-ok-at
              ctx
              expr-bases
              bindings
              (+ index 1))))])))

(define (tc-source-resource-binding-list-policy-ok
  [ctx : TcContext]
  [expr-bases : i64]
  [bindings : ast.AstResourceBindingList]) : ResultTcUnit
  (tc-source-resource-binding-list-policy-ok-at ctx expr-bases (& bindings) 0))

(define (tc-source-resource-binding-list-policy-ok-at
  [ctx : TcContext]
  [expr-bases : i64]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    Ok
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(Binding _ init-box cleanup-box _)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [cleanup : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases cleanup-box)]
          [_ (try (tc-source-expr-policy-ok ctx expr-bases init))]
          (let
            [_ (try (tc-source-expr-policy-ok ctx expr-bases cleanup))]
            (tc-source-resource-binding-list-policy-ok-at
              ctx
              expr-bases
              bindings
              (+ index 1))))])))

(define (tc-source-expr-list-policy-ok
  [ctx : TcContext]
  [expr-bases : i64]
  [exprs : ast.AstExprList]) : ResultTcUnit
  (tc-source-expr-list-policy-ok-at ctx expr-bases (& exprs) 0))

(define (tc-source-expr-list-policy-ok-at
  [ctx : TcContext]
  [expr-bases : i64]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : ResultTcUnit
  (if (>= index exprs.len)
    Ok
    (let
      [expr : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get exprs index 0))]
      [_ (try (tc-source-expr-policy-ok ctx expr-bases expr))]
      (tc-source-expr-list-policy-ok-at ctx expr-bases exprs (+ index 1)))))

(define (tc-source-expr-pair-policy-ok
  [ctx : TcContext]
  [expr-bases : i64]
  [left : ast.AstExpr]
  [right : ast.AstExpr]) : ResultTcUnit
  (let
    [_ (try (tc-source-expr-policy-ok ctx expr-bases left))]
    (tc-source-expr-policy-ok ctx expr-bases right)))

(define (tc-source-expr-triple-policy-ok
  [ctx : TcContext]
  [expr-bases : i64]
  [first : ast.AstExpr]
  [second : ast.AstExpr]
  [third : ast.AstExpr]) : ResultTcUnit
  (let
    [_ (try (tc-source-expr-pair-policy-ok ctx expr-bases first second))]
    (tc-source-expr-policy-ok ctx expr-bases third)))

;; Where the source scope check below stands relative to SPMD constructs.
;; Gang operations are valid in every scope but the first; foreach-active only
;; directly in a foreach body; lane-value only in a foreach-active body.
(define tc-spmd-scope-outside : i64
  0)

;; An spmd-reduce value, or an spmd-scan or spmd-compact body.
(define tc-spmd-scope-gang : i64
  1)
(define tc-spmd-scope-foreach : i64
  2)
(define tc-spmd-scope-active : i64
  3)

;; The operand of a lane-value.
(define tc-spmd-scope-lane-value : i64
  4)

(define (tc-spmd-scope-gang-op-ok? [scope : i64]) : bool
  (not (= scope tc-spmd-scope-outside)))

(define (tc-spmd-foreach-active-scope-message [scope : i64]) : String
  (tc-kind-message
    (Spmd)
    (cond
      [(= scope tc-spmd-scope-active)
        "typecheck: foreach-active cannot be nested inside foreach-active"]
      [(= scope tc-spmd-scope-lane-value)
        "typecheck: foreach-active is not valid inside a lane-value operand"]
      [else "typecheck: foreach-active is only valid inside a foreach body"])))

(define (tc-spmd-lane-value-scope-message [scope : i64]) : String
  (tc-kind-message
    (Spmd)
    (if (= scope tc-spmd-scope-lane-value)
      "typecheck: lane-value cannot be nested inside a lane-value operand"
      "typecheck: lane-value is only valid inside a foreach-active body")))

(define (tc-spmd-broadcast-scope-message) : String
  (tc-kind-message
    (Spmd)
    "typecheck: spmd-broadcast is only valid inside a foreach body, spmd-reduce value expression, or spmd-scan body"))

(define (tc-spmd-shuffle-scope-message) : String
  (tc-kind-message
    (Spmd)
    "typecheck: spmd-shuffle is only valid inside a foreach body, spmd-reduce value expression, or spmd-scan body"))

(define (tc-spmd-lane-scope-message [name : String]) : String
  (str_cat.str-cat
    (tc-kind-message (Spmd) "typecheck: ")
    name
    " is only valid inside a foreach body or spmd-reduce value expression"))

(define (tc-source-expr-list-spmd-broadcast-scope-ok
  [expr-bases : i64]
  [exprs : ast.AstExprList]
  [allow : i64]) : ResultTcUnit
  (tc-source-expr-list-spmd-broadcast-scope-ok-at expr-bases (& exprs) 0 allow))

(define (tc-source-expr-list-spmd-broadcast-scope-ok-at
  [expr-bases : i64]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [allow : i64]) : ResultTcUnit
  (if (>= index exprs.len)
    Ok
    (let
      [expr : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get exprs index 0))]
      [_ (try (tc-source-expr-spmd-broadcast-scope-ok expr-bases expr allow))]
      (tc-source-expr-list-spmd-broadcast-scope-ok-at
        expr-bases
        exprs
        (+ index 1)
        allow))))

(define (tc-source-expr-pair-spmd-broadcast-scope-ok
  [expr-bases : i64]
  [left : ast.AstExpr]
  [right : ast.AstExpr]
  [allow : i64]) : ResultTcUnit
  (let
    [_ (try (tc-source-expr-spmd-broadcast-scope-ok expr-bases left allow))]
    (tc-source-expr-spmd-broadcast-scope-ok expr-bases right allow)))

(define (tc-source-expr-triple-spmd-broadcast-scope-ok
  [expr-bases : i64]
  [first : ast.AstExpr]
  [second : ast.AstExpr]
  [third : ast.AstExpr]
  [allow : i64]) : ResultTcUnit
  (let
    [_
      (try
        (tc-source-expr-pair-spmd-broadcast-scope-ok
          expr-bases
          first
          second
          allow))]
    (tc-source-expr-spmd-broadcast-scope-ok expr-bases third allow)))

(define (tc-source-let-binding-list-spmd-broadcast-scope-ok
  [expr-bases : i64]
  [bindings : ast.AstLetBindingList]
  [allow : i64]) : ResultTcUnit
  (tc-source-let-binding-list-spmd-broadcast-scope-ok-at
    expr-bases
    (& bindings)
    allow
    0))

(define (tc-source-let-binding-list-spmd-broadcast-scope-ok-at
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [allow : i64]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast.ast-let-binding-list-len bindings))
    Ok
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding _ _ init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [_
            (try (tc-source-expr-spmd-broadcast-scope-ok expr-bases init allow))]
          (tc-source-let-binding-list-spmd-broadcast-scope-ok-at
            expr-bases
            bindings
            allow
            (+ index 1)))])))

(define (tc-source-resource-binding-list-spmd-broadcast-scope-ok
  [expr-bases : i64]
  [bindings : ast.AstResourceBindingList]
  [allow : i64]) : ResultTcUnit
  (tc-source-resource-binding-list-spmd-broadcast-scope-ok-at
    expr-bases
    (& bindings)
    allow
    0))

(define (tc-source-resource-binding-list-spmd-broadcast-scope-ok-at
  [expr-bases : i64]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [allow : i64]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    Ok
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(Binding _ init-box cleanup-box _)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [cleanup : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases cleanup-box)]
          [_
            (try
              (tc-source-expr-pair-spmd-broadcast-scope-ok
                expr-bases
                init
                cleanup
                allow))]
          (tc-source-resource-binding-list-spmd-broadcast-scope-ok-at
            expr-bases
            bindings
            allow
            (+ index 1)))])))

(define (tc-source-match-arm-list-spmd-broadcast-scope-ok
  [expr-bases : i64]
  [arms : ast.AstMatchArmList]
  [allow : i64]) : ResultTcUnit
  (tc-source-match-arm-list-spmd-broadcast-scope-ok-at
    expr-bases
    (& arms)
    allow
    0))

(define (tc-source-match-arm-list-spmd-broadcast-scope-ok-at
  [expr-bases : i64]
  [arms : (& arms ast.AstMatchArmList)]
  [allow : i64]
  [index : i64]) : ResultTcUnit
  (if (>= index arms.len)
    Ok
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm _ body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          [_
            (try (tc-source-expr-spmd-broadcast-scope-ok expr-bases body allow))]
          (tc-source-match-arm-list-spmd-broadcast-scope-ok-at
            expr-bases
            arms
            allow
            (+ index 1)))])))

(define (tc-source-expr-spmd-broadcast-scope-ok
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [allow : i64]) : ResultTcUnit
  (match expr
    [(or (Spanned inner-box _) (Unary _ inner-box) (Ann inner-box _)
         (Cast inner-box _) (Box inner-box) (BoxGet inner-box)
         (BoxTake inner-box) (Comptime inner-box) (Quote inner-box)
         (Quasiquote inner-box) (Unquote inner-box) (UnquoteSplicing inner-box)
         (Try inner-box) (Return inner-box) (PtrNullCheck inner-box)
         (PtrAddrOf inner-box) (PtrRead inner-box))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok expr-bases inner allow))]
    [(Binary _ left-box right-box)
      (let
        [left : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases left-box)]
        [right : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases right-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok
          expr-bases
          left
          right
          allow))]
    [(Call func-box args)
      (let
        [func : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases func-box)]
        [_ (try (tc-source-expr-spmd-broadcast-scope-ok expr-bases func allow))]
        (tc-source-expr-list-spmd-broadcast-scope-ok expr-bases args allow))]
    [(If cond-box then-box else-box)
      (let
        [cond : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases cond-box)]
        [then-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases then-box)]
        [else-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases else-box)]
        (tc-source-expr-triple-spmd-broadcast-scope-ok
          expr-bases
          cond
          then-branch
          else-branch
          allow))]
    [(Let let-box)
      (match (ast.ast-let-box-shared-view let-box)
        [(Let bindings body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [_
              (try
                (tc-source-let-binding-list-spmd-broadcast-scope-ok
                  expr-bases
                  bindings
                  allow))]
            (tc-source-expr-spmd-broadcast-scope-ok expr-bases body allow))])]
    [(Lambda lambda-box)
      (match (ast.ast-lambda-box-shared-view lambda-box)
        [(Lambda _ _ body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (tc-source-expr-spmd-broadcast-scope-ok
              expr-bases
              body
              tc-spmd-scope-outside))])]
    [(or (Tuple exprs) (Array exprs) (DynArray exprs) (Begin exprs)
         (Unsafe exprs) (WithRegion _ exprs) (WithScratch exprs)
         (BracketClause exprs) (Syscall exprs))
      (tc-source-expr-list-spmd-broadcast-scope-ok expr-bases exprs allow)]
    [(TupleRef tuple-box _)
      (let
        [tuple : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases tuple-box)]
        (tc-source-expr-spmd-broadcast-scope-ok expr-bases tuple allow))]
    [(or (FixedMakeArray _ len-box) (MakeArray _ len-box))
      (let
        [len : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases len-box)]
        (tc-source-expr-spmd-broadcast-scope-ok expr-bases len allow))]
    [(ArrayRef array-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok
          expr-bases
          array
          index
          allow))]
    [(ArraySet array-box index-box value-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (tc-source-expr-triple-spmd-broadcast-scope-ok
          expr-bases
          array
          index
          value
          allow))]
    [(ArrayTake array-box live-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [live : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases live-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (tc-source-expr-triple-spmd-broadcast-scope-ok
          expr-bases
          array
          live
          index
          allow))]
    [(Replace place-box replacement-box)
      (tc-source-expr-pair-spmd-broadcast-scope-ok
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases place-box)
        (ast.ast-expr-segment-bases-get expr-bases replacement-box)
        allow)]
    [(ArrayPush array-box value-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok
          expr-bases
          array
          value
          allow))]
    [(StringRef str-box index-box)
      (let
        [str : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases str-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok expr-bases str index allow))]
    [(While cond-box body-box)
      (let
        [cond : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases cond-box)]
        [body : ast.AstExpr (Begin body-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok expr-bases cond body allow))]
    [(or (Set _ value-box) (IntToPtr value-box _))
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (tc-source-expr-spmd-broadcast-scope-ok expr-bases value allow))]
    [(Borrow _ _ place-box)
      (let
        [place : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases place-box)]
        (tc-source-expr-spmd-broadcast-scope-ok expr-bases place allow))]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match scrutinee-box arms)
          (let
            [scrutinee : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases scrutinee-box)]
            [_
              (try
                (tc-source-expr-spmd-broadcast-scope-ok
                  expr-bases
                  scrutinee
                  allow))]
            (tc-source-match-arm-list-spmd-broadcast-scope-ok
              expr-bases
              arms
              allow))])]
    [(Foreach fe-box)
      (match (ast.ast-foreach-box-shared-view fe-box)
        [(Foreach _ _ start-box end-box body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [_
              (try
                (tc-source-expr-pair-spmd-broadcast-scope-ok
                  expr-bases
                  start
                  end
                  tc-spmd-scope-outside))]
            (tc-source-expr-spmd-broadcast-scope-ok
              expr-bases
              body
              tc-spmd-scope-foreach))]
        [(Foreach2 _ _ a-box b-box _ _ c-box d-box body-box)
          (let
            [_
              (try
                (tc-source-expr-pair-spmd-broadcast-scope-ok
                  expr-bases
                  (ast.ast-expr-segment-bases-get expr-bases a-box)
                  (ast.ast-expr-segment-bases-get expr-bases b-box)
                  tc-spmd-scope-outside))]
            (let
              [_
                (try
                  (tc-source-expr-pair-spmd-broadcast-scope-ok
                    expr-bases
                    (ast.ast-expr-segment-bases-get expr-bases c-box)
                    (ast.ast-expr-segment-bases-get expr-bases d-box)
                    tc-spmd-scope-outside))]
              (tc-source-expr-spmd-broadcast-scope-ok
                expr-bases
                (ast.ast-expr-segment-bases-get expr-bases body-box)
                tc-spmd-scope-foreach)))])]
    [(SpmdReduce reduce-box)
      (match (__tl-box-place reduce-box)
        [(Reduce _ _ _ start-box end-box init-box value-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [value : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases value-box)]
            [_
              (try
                (tc-source-expr-triple-spmd-broadcast-scope-ok
                  expr-bases
                  start
                  end
                  init
                  tc-spmd-scope-outside))]
            (tc-source-expr-spmd-broadcast-scope-ok
              expr-bases
              value
              tc-spmd-scope-gang))])]
    [(SpmdScan scan-box)
      (match (__tl-box-place scan-box)
        [(Scan _ _ _ start-box end-box _ _ init-box value-box body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [value : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases value-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [_
              (try
                (tc-source-expr-triple-spmd-broadcast-scope-ok
                  expr-bases
                  start
                  end
                  init
                  tc-spmd-scope-outside))]
            (let
              [_
                (try
                  (tc-source-expr-spmd-broadcast-scope-ok
                    expr-bases
                    value
                    tc-spmd-scope-outside))]
              (tc-source-expr-spmd-broadcast-scope-ok
                expr-bases
                body
                tc-spmd-scope-gang)))])]
    [(SpmdCompact compact-box)
      (match (__tl-box-place compact-box)
        [(Compact _ _ start-box end-box _ _ init-box keep-box body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [keep : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases keep-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [_
              (try
                (tc-source-expr-triple-spmd-broadcast-scope-ok
                  expr-bases
                  start
                  end
                  init
                  tc-spmd-scope-outside))]
            (let
              [_
                (try
                  (tc-source-expr-spmd-broadcast-scope-ok
                    expr-bases
                    keep
                    tc-spmd-scope-outside))]
              (tc-source-expr-spmd-broadcast-scope-ok
                expr-bases
                body
                tc-spmd-scope-gang)))])]
    [(SpmdBroadcast value-box lane-box)
      (if (tc-spmd-scope-gang-op-ok? allow)
        (let
          [value : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases value-box)]
          [lane : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases lane-box)]
          (tc-source-expr-pair-spmd-broadcast-scope-ok
            expr-bases
            value
            lane
            allow))
        (Err (tc-spmd-broadcast-scope-message)))]
    [(SpmdShuffle value-box lane-box)
      (if (tc-spmd-scope-gang-op-ok? allow)
        (let
          [value : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases value-box)]
          [lane : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases lane-box)]
          (tc-source-expr-pair-spmd-broadcast-scope-ok
            expr-bases
            value
            lane
            allow))
        (Err (tc-spmd-shuffle-scope-message)))]
    [(ForeachActive _ body-box)
      (if (= allow tc-spmd-scope-foreach)
        (tc-source-expr-spmd-broadcast-scope-ok
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases body-box)
          tc-spmd-scope-active)
        (Err (tc-spmd-foreach-active-scope-message allow)))]
    [(LaneValue value-box)
      (if (= allow tc-spmd-scope-active)
        (tc-source-expr-spmd-broadcast-scope-ok
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases value-box)
          tc-spmd-scope-lane-value)
        (Err (tc-spmd-lane-value-scope-message allow)))]
    [(SpmdProgramIndex)
      (if (tc-spmd-scope-gang-op-ok? allow)
        Ok
        (Err (tc-spmd-lane-scope-message "program-index")))]
    [(SpmdProgramCount)
      (if (tc-spmd-scope-gang-op-ok? allow)
        Ok
        (Err (tc-spmd-lane-scope-message "program-count")))]
    [(StructGet receiver-box _)
      (let
        [receiver : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases receiver-box)]
        (tc-source-expr-spmd-broadcast-scope-ok expr-bases receiver allow))]
    [(StructSet receiver-box _ value-box)
      (let
        [receiver : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases receiver-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok
          expr-bases
          receiver
          value
          allow))]
    [(WithEscape scratch-box body)
      (let
        [scratch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases scratch-box)]
        [_
          (try
            (tc-source-expr-spmd-broadcast-scope-ok expr-bases scratch allow))]
        (tc-source-expr-list-spmd-broadcast-scope-ok expr-bases body allow))]
    [(InArena arena-box body)
      (let
        [arena : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases arena-box)]
        [_
          (try (tc-source-expr-spmd-broadcast-scope-ok expr-bases arena allow))]
        (tc-source-expr-list-spmd-broadcast-scope-ok expr-bases body allow))]
    [(WithResource wr-box)
      (match (__tl-box-place wr-box)
        [(WithResource bindings body)
          (let
            [_
              (try
                (tc-source-resource-binding-list-spmd-broadcast-scope-ok
                  expr-bases
                  bindings
                  allow))]
            (tc-source-expr-list-spmd-broadcast-scope-ok expr-bases body allow))])]
    [(BoxSet inner-box value-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok
          expr-bases
          inner
          value
          allow))]
    [(PtrWrite ptr-box value-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok expr-bases ptr value allow))]
    [(PtrOffset ptr-box offset-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [offset : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases offset-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok
          expr-bases
          ptr
          offset
          allow))]
    [(or (PtrCast ptr-box _) (PtrToInt ptr-box))
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        (tc-source-expr-spmd-broadcast-scope-ok expr-bases ptr allow))]
    [(StringData str-box)
      (let
        [str : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases str-box)]
        (tc-source-expr-spmd-broadcast-scope-ok expr-bases str allow))]
    [(StringFromBytes ptr-box len-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [len : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases len-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok expr-bases ptr len allow))]
    [(ArrayData array-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        (tc-source-expr-spmd-broadcast-scope-ok expr-bases array allow))]
    [(or (CpuIdEax leaf-box subleaf-box) (CpuIdEbx leaf-box subleaf-box)
         (CpuIdEcx leaf-box subleaf-box) (CpuIdEdx leaf-box subleaf-box))
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok
          expr-bases
          leaf
          subleaf
          allow))]
    [(Xgetbv index-box)
      (let
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (tc-source-expr-spmd-broadcast-scope-ok expr-bases index allow))]
    [_ Ok]))

(define (tc-source-lambda-signature-policy-ok
  [ctx : TcContext]
  [params : ast.AstParamList]
  [maybe-ret : ast.AstMaybeType]) : ResultTcUnit
  (match maybe-ret
    [(Some ret)
      (let
        [signature
          (try
            (tc-elide-function-signature (tc-context-type-bases ctx) params ret))]
        [_ (try (tc-source-param-list-policy-ok ctx signature.params))]
        (let
          [_
            (try
              (tc-source-type-policy-ok
                ctx
                (tc-global-shared-view signature.ret)))]
          (tc-source-invalidate-lifetimes-policy-ok
            (tc-param-list-invalidate-lifetimes (& signature.params))
            signature.ret)))]
    [(No)
      (let
        [inputs
          (try
            (tc-elide-input-params-at
              (tc-context-type-bases ctx)
              (& params)
              0
              0
              (ast.ast-param-list-new)))]
        [_ (try (tc-source-param-list-policy-ok ctx inputs.params))]
        (tc-source-invalidate-lifetimes-policy-ok
          (tc-param-list-invalidate-lifetimes (& inputs.params))
          (Unit)))]))

(define (tc-source-expr-policy-ok
  [ctx : TcContext]
  [expr-bases : i64]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match expr
    [(or (Spanned inner-box _) (Unary _ inner-box) (Box inner-box)
         (BoxGet inner-box) (BoxTake inner-box) (Comptime inner-box)
         (Unquote inner-box) (UnquoteSplicing inner-box) (Try inner-box)
         (Return inner-box) (PtrNullCheck inner-box))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-source-expr-policy-ok ctx expr-bases inner))]
    [(Binary _ left-box right-box)
      (let
        [left : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases left-box)]
        [right : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases right-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases left right))]
    [(Call func-box args)
      (let
        [func : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases func-box)]
        [_ (try (tc-source-expr-policy-ok ctx expr-bases func))]
        (tc-source-expr-list-policy-ok ctx expr-bases args))]
    [(or (BracketClause items) (Tuple items) (Array items) (DynArray items)
         (Begin items) (Unsafe items) (WithRegion _ items) (WithScratch items)
         (Syscall items))
      (tc-source-expr-list-policy-ok ctx expr-bases items)]
    [(TypeLiteral ty-id) (tc-source-type-policy-ok ctx (ast.ty-node-get ty-id))]
    [(Init maybe-ty-id)
      (tc-source-maybe-type-policy-ok
        ctx
        (ast.ast-maybe-type-from-id maybe-ty-id))]
    [(If cond-box then-branch-box else-branch-box)
      (let
        [cond : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases cond-box)]
        [then-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases then-branch-box)]
        [else-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases else-branch-box)]
        (tc-source-expr-triple-policy-ok
          ctx
          expr-bases
          cond
          then-branch
          else-branch))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [_
              (try
                (tc-source-let-binding-list-policy-ok ctx expr-bases bindings))]
            (tc-source-expr-policy-ok ctx expr-bases body))])]
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda params maybe-ret body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [_
              (try (tc-source-lambda-signature-policy-ok ctx params maybe-ret))]
            (tc-source-expr-policy-ok ctx expr-bases body))])]
    [(TupleRef tuple-box _)
      (let
        [tuple : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases tuple-box)]
        (tc-source-expr-policy-ok ctx expr-bases tuple))]
    [(or (FixedMakeArray elem-ty-id len-box) (MakeArray elem-ty-id len-box))
      (let
        [len : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases len-box)]
        [_ (try (tc-source-type-policy-ok ctx (ast.ty-node-get elem-ty-id)))]
        (tc-source-expr-policy-ok ctx expr-bases len))]
    [(ArrayRef array-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases array index))]
    [(ArraySet array-box index-box value-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (tc-source-expr-triple-policy-ok ctx expr-bases array index value))]
    [(ArrayTake array-box live-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [live : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases live-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (tc-source-expr-triple-policy-ok ctx expr-bases array live index))]
    [(Replace place-box replacement-box)
      (tc-source-expr-pair-policy-ok
        ctx
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases place-box)
        (ast.ast-expr-segment-bases-get expr-bases replacement-box))]
    [(ArrayPush array-box value-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases array value))]
    [(StringRef str-box index-box)
      (let
        [str : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases str-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases str index))]
    [(While cond-box body-box)
      (let
        [cond : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases cond-box)]
        [body : ast.AstExpr (Begin body-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases cond body))]
    [(Set _ value-box)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (tc-source-expr-policy-ok ctx expr-bases value))]
    [(or (Ann inner-box ty-id) (Cast inner-box ty-id))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        [_ (try (tc-source-expr-policy-ok ctx expr-bases inner))]
        (tc-source-type-policy-ok ctx (ast.ty-node-get ty-id)))]
    [(or (Borrow _ _ place-box) (PtrAddrOf place-box))
      (let
        [place : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases place-box)]
        (tc-source-expr-policy-ok ctx expr-bases place))]
    [(BoxSet inner-box value-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases inner value))]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match scrutinee-box arms)
          (let
            [scrutinee : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases scrutinee-box)]
            [_ (try (tc-source-expr-policy-ok ctx expr-bases scrutinee))]
            (tc-source-match-arm-list-policy-ok ctx expr-bases arms))])]
    [(Foreach fe-box)
      (match (__tl-box-place fe-box)
        [(Foreach _ index-ty start-box end-box body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [_ (try (tc-source-type-policy-ok ctx index-ty))]
            (tc-source-expr-triple-policy-ok ctx expr-bases start end body))]
        [(Foreach2 _ outer-ty a-box b-box _ inner-ty c-box d-box body-box)
          (let
            [_ (try (tc-source-type-policy-ok ctx outer-ty))]
            (let
              [_ (try (tc-source-type-policy-ok ctx inner-ty))]
              (let
                [_
                  (try
                    (tc-source-expr-triple-policy-ok
                      ctx
                      expr-bases
                      (ast.ast-expr-segment-bases-get expr-bases a-box)
                      (ast.ast-expr-segment-bases-get expr-bases b-box)
                      (ast.ast-expr-segment-bases-get expr-bases c-box)))]
                (tc-source-expr-pair-policy-ok
                  ctx
                  expr-bases
                  (ast.ast-expr-segment-bases-get expr-bases d-box)
                  (ast.ast-expr-segment-bases-get expr-bases body-box)))))])]
    [(SpmdReduce reduce-box)
      (match (__tl-box-place reduce-box)
        [(Reduce _ _ index-ty start-box end-box init-box value-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [value : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases value-box)]
            [_ (try (tc-source-type-policy-ok ctx index-ty))]
            (let
              [_
                (try
                  (tc-source-expr-triple-policy-ok
                    ctx
                    expr-bases
                    start
                    end
                    init))]
              (tc-source-expr-policy-ok ctx expr-bases value)))])]
    [(SpmdScan scan-box)
      (match (__tl-box-place scan-box)
        [(Scan
            _
            _
            index-ty
            start-box
            end-box
            _
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [value : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases value-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [_ (try (tc-source-type-policy-ok ctx index-ty))]
            (let
              [_ (try (tc-source-type-policy-ok ctx prefix-ty))]
              (let
                [_
                  (try
                    (tc-source-expr-triple-policy-ok
                      ctx
                      expr-bases
                      start
                      end
                      init))]
                (let
                  [_ (try (tc-source-expr-policy-ok ctx expr-bases value))]
                  (tc-source-expr-policy-ok ctx expr-bases body)))))])]
    [(SpmdCompact compact-box)
      (match (__tl-box-place compact-box)
        [(Compact
            _
            index-ty
            start-box
            end-box
            _
            slot-ty
            init-box
            keep-box
            body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [keep : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases keep-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [_ (try (tc-source-type-policy-ok ctx index-ty))]
            (let
              [_ (try (tc-source-type-policy-ok ctx slot-ty))]
              (let
                [_
                  (try
                    (tc-source-expr-triple-policy-ok
                      ctx
                      expr-bases
                      start
                      end
                      init))]
                (let
                  [_ (try (tc-source-expr-policy-ok ctx expr-bases keep))]
                  (tc-source-expr-policy-ok ctx expr-bases body)))))])]
    [(or (SpmdBroadcast value-box lane-box) (SpmdShuffle value-box lane-box))
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [lane : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases lane-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases value lane))]
    [(StructGet receiver-box _)
      (let
        [receiver : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases receiver-box)]
        (tc-source-expr-policy-ok ctx expr-bases receiver))]
    [(StructSet receiver-box _ value-box)
      (let
        [receiver : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases receiver-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases receiver value))]
    [(WithEscape scratch-box body)
      (let
        [scratch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases scratch-box)]
        [_ (try (tc-source-expr-policy-ok ctx expr-bases scratch))]
        (tc-source-expr-list-policy-ok ctx expr-bases body))]
    [(InArena arena-box body)
      (let
        [arena : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases arena-box)]
        [_ (try (tc-source-expr-policy-ok ctx expr-bases arena))]
        (tc-source-expr-list-policy-ok ctx expr-bases body))]
    [(WithResource wr-box)
      (match (__tl-box-place wr-box)
        [(WithResource bindings body)
          (let
            [_
              (try
                (tc-source-resource-binding-list-policy-ok
                  ctx
                  expr-bases
                  bindings))]
            (tc-source-expr-list-policy-ok ctx expr-bases body))])]
    [(or (Quote _) (Quasiquote _) (BinaryData _) (SpmdProgramIndex)
         (SpmdProgramCount) (ProgramArgc) (ProgramArgv) (ProgramEnvp))
      Ok]
    [(or (PtrRead ptr-box) (PtrToInt ptr-box))
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        (tc-source-expr-policy-ok ctx expr-bases ptr))]
    [(PtrWrite ptr-box value-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases ptr value))]
    [(PtrOffset ptr-box offset-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [offset : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases offset-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases ptr offset))]
    [(PtrCast ptr-box ty-id)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [_ (try (tc-source-expr-policy-ok ctx expr-bases ptr))]
        (tc-source-type-policy-ok ctx (ast.ty-node-get ty-id)))]
    [(IntToPtr value-box ty-id)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [_ (try (tc-source-expr-policy-ok ctx expr-bases value))]
        (tc-source-type-policy-ok ctx (ast.ty-node-get ty-id)))]
    [(StringData str-box)
      (let
        [str : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases str-box)]
        (tc-source-expr-policy-ok ctx expr-bases str))]
    [(StringFromBytes ptr-box len-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [len : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases len-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases ptr len))]
    [(ArrayData array-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        (tc-source-expr-policy-ok ctx expr-bases array))]
    [(or (CpuIdEax leaf-box subleaf-box) (CpuIdEbx leaf-box subleaf-box)
         (CpuIdEcx leaf-box subleaf-box) (CpuIdEdx leaf-box subleaf-box))
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases leaf subleaf))]
    [(Xgetbv index-box)
      (let
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (tc-source-expr-policy-ok ctx expr-bases index))]
    [(or (ForeachActive _ body-box) (LaneValue body-box))
      (tc-source-expr-policy-ok
        ctx
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases body-box))]
    [_ Ok]))

(define (tc-source-decl-policy-ok [ctx : TcContext] [decl : ast.AstDecl]) : ResultTcUnit
  (let
    [expr-bases : i64 (tc-context-expr-bases ctx)]
    (match decl
      [(Def decl-meta _ maybe-ty expr-box)
        (let
          [expr : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases expr-box)]
          [_
            (try
              (tc-source-maybe-type-policy-ok
                ctx
                (tc-global-shared-view maybe-ty)))]
          (if (tc-maybe-type-contains-reference? maybe-ty)
            (Err
              "typecheck: storing references in top-level values requires lifetime support")
            (let
              [_
                (try
                  (tc-source-expr-policy-ok
                    ctx
                    expr-bases
                    (tc-global-shared-view expr)))]
              (tc-source-expr-spmd-broadcast-scope-ok
                expr-bases
                expr
                tc-spmd-scope-outside))))]
      [(DefFn decl-meta _ params ret body-box _)
        (let
          [signature
            (try
              (tc-elide-function-signature
                (tc-context-type-bases ctx)
                params
                ret))]
          [signature-params : ast.AstParamList signature.params]
          [signature-ret : ast.AstType signature.ret]
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          [_ (try (tc-source-param-list-policy-ok ctx signature-params))]
          (let
            [_
              (try
                (match (tc-source-type-policy-ok
                  ctx
                  (tc-global-shared-view signature-ret))
                  [(Ok)
                    (tc-source-invalidate-lifetimes-policy-ok
                      (tc-param-list-invalidate-lifetimes (& signature-params))
                      (tc-global-shared-view signature-ret))]
                  [(Err message) (ResultTcUnit.Err message)]))]
            (let
              [_
                (try
                  (tc-reference-return-policy-ok
                    ctx
                    signature-params
                    signature-ret))]
              (let
                [_
                  (try
                    (tc-source-expr-policy-ok
                      ctx
                      expr-bases
                      (tc-global-shared-view body)))]
                (tc-source-expr-spmd-broadcast-scope-ok
                  expr-bases
                  body
                  tc-spmd-scope-outside)))))]
      [(DefMacro decl-meta _ params ret body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          [_ (try (tc-source-macro-param-list-policy-ok ctx params))]
          (let
            [_ (try (tc-source-macro-result-policy-ok ctx ret))]
            (let
              [_
                (try
                  (tc-source-expr-policy-ok
                    ctx
                    expr-bases
                    (tc-global-shared-view body)))]
              (tc-source-expr-spmd-broadcast-scope-ok
                expr-bases
                body
                tc-spmd-scope-outside))))]
      [(Extern decl-meta _ _ _ ty) (tc-source-type-policy-ok ctx ty)]
      [(DefEnum decl-meta name _ variants)
        (let
          [_ (try (tc-source-variant-list-policy-ok ctx variants))]
          (tc-source-default-aggregate-layout-finite-ok ctx name))]
      [(DefEnumLifetimes decl-meta name lifetimes _ variants)
        (if (tc-lifetime-list-duplicates? lifetimes)
          (Err "typecheck: duplicate lifetime parameter")
          (let
            [_
              (try
                (tc-source-variant-list-lifetimes-policy-ok
                  ctx
                  lifetimes
                  variants))]
            (tc-source-default-aggregate-layout-finite-ok ctx name)))]
      [(DefStruct decl-meta name repr cleanup fields)
        (let
          [_
            (try
              (tc-source-field-list-policy-ok
                ctx
                (tc-global-shared-view fields)))]
          (if (and
            (ast.ast-struct-repr-c? repr)
            (ast.ast-struct-cleanup? cleanup))
            (Err
              (tc-struct-cleanup-repr-c-message
                (csym.compiler-symbol-module-key
                  (tc-context-module ctx)
                  (tc-env-key-name-text name))))
            (tc-source-struct-layout-ok ctx name repr fields)))]
      [(DefStructLifetimes decl-meta name lifetimes repr cleanup fields)
        (if (tc-lifetime-list-duplicates? lifetimes)
          (Err "typecheck: duplicate lifetime parameter")
          (let
            [_
              (try
                (tc-source-field-list-lifetimes-policy-ok
                  ctx
                  lifetimes
                  (tc-global-shared-view fields)))]
            (if (and
              (ast.ast-struct-repr-c? repr)
              (ast.ast-struct-cleanup? cleanup))
              (Err
                (tc-struct-cleanup-repr-c-message
                  (csym.compiler-symbol-module-key
                    (tc-context-module ctx)
                    (tc-env-key-name-text name))))
              (tc-source-struct-layout-ok ctx name repr fields))))]
      [(DefDispatch decl-meta _ variants)
        (if (!= (tc-dispatch-variant-list-scalar-count variants) 1)
          (Err "typecheck: defdispatch requires exactly one scalar variant")
          (if (tc-dispatch-variant-list-duplicate-isa? variants)
            (Err "typecheck: duplicate defdispatch ISA variant")
            Ok))]
      [(IncludeStr _ _)
        (Err "typecheck: include-str must be expanded by compiler loader")]
      [(IncludeStrComptime _ _)
        (Err
          "typecheck: include-str-comptime must be expanded by compiler loader")]
      [(IncludeStrLzss _ _)
        (Err "typecheck: include-str-lzss must be expanded by compiler loader")]
      [(IncludeBin _ _)
        (Err "typecheck: include-bin must be expanded by compiler loader")]
      [(or (Import _ _) (Module _) (ModuleBody _ _)) Ok]
      ;; Module bodies are traversed by the declaration-list diagnostic adapter,
      ;; which retains their nested list origin and owning path.
      [(Test _ body-box _ _)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          (tc-source-expr-policy-ok ctx expr-bases body))]
      [(Unsafe inner-box)
        (let
          [inner : ast.AstDecl (ast.ast-decl-box-shared-view inner-box)]
          (tc-source-decl-policy-ok ctx inner))])))

(defenum ResultTcSourcePolicyDiagnostic
  (Ok)
  (Err (Box cdiag.CompilerDiagnostic)))

(define (tc-source-decl-shape-origin-message? [message : (& message str)]) : bool
  (let
    [text : String (tc-message-text message)]
    (or
      (string.eq
        text
        "typecheck: defdispatch requires exactly one scalar variant")
      (string.eq text "typecheck: duplicate defdispatch ISA variant")
      (string.eq text "typecheck: duplicate lifetime parameter")
      (string.eq
        text
        "typecheck: returned reference lifetime must be tied to a parameter")
      (string.contains (& text) " cannot use repr c")
      (string.contains (& text) " declares (:align "))))

(define (tc-source-decl-list-policy-diagnostic-in-module
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [fallback-path : String]
  [module-id : i64]) : ResultTcSourcePolicyDiagnostic
  (match (ast.ast-decl-list-step decls)
    [(Nil) Ok]
    [(Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        [decl-path : String
          (match (ast.ast-decl-path-list-step paths)
            [(Cons path _) path]
            [(Nil) (owned_view.compiler-owned-shared-view fallback-path)])]
        [rest-paths : ast.AstDeclPathList
          (match (ast.ast-decl-path-list-step paths)
            [(Cons _ path-rest) path-rest]
            [(Nil) (ast.ast-decl-path-list-new)])]
        (match (tc-global-shared-view decl)
          [(Module next-module)
            (tc-source-decl-list-policy-diagnostic-in-module
              ctx
              rest
              rest-paths
              fallback-path
              next-module)]
          [(ModuleBody target-module body-box)
            (let
              [_
                (try
                  (tc-source-decl-list-policy-diagnostic-in-module
                    (tc-context-with-module-id
                      ctx
                      (tc-env-key-name-text target-module)
                      target-module)
                    (ast.ast-decl-list-box-shared-view body-box)
                    (ast.ast-decl-path-list-new)
                    decl-path
                    target-module))]
              (tc-source-decl-list-policy-diagnostic-in-module
                ctx
                rest
                rest-paths
                fallback-path
                module-id))]
          [_
            (match (tc-source-decl-policy-ok
              (tc-context-with-module-id
                ctx
                (if (csym.compiler-symbol-root-module-id? module-id)
                  ""
                  (tc-env-key-name-text module-id))
                module-id)
              (tc-global-shared-view decl))
              [(Ok)
                (tc-source-decl-list-policy-diagnostic-in-module
                  ctx
                  rest
                  rest-paths
                  fallback-path
                  module-id)]
              [(Err message)
                (Err
                  (box
                    (if (tc-source-decl-shape-origin-message? message)
                      (tc-typecheck-diag-with-path
                        (tc-context-expr-bases ctx)
                        (& decls)
                        decl
                        decl-path
                        message)
                      (tc-diag-at-start message))))])]))]))

(define (tc-program-source-types-policy-ok
  [ctx : TcContext]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]) : ResultTcSourcePolicyDiagnostic
  (tc-nominal-owner-cache-reset-for-job! (tc-context-job-state ctx))
  (match program
    [(Program decls-box)
      (let
        [decls : ast.AstDeclList (ast.ast-decl-list-box-shared-view decls-box)]
        (tc-job-state-set-opaque-program!
          (tc-context-job-state ctx)
          (tc-opaque-decls-declare? (& decls)))
        (tc-source-decl-list-policy-diagnostic-in-module
          ctx
          decls
          paths
          ""
          (csym.compiler-symbol-root-module-id)))]))

(define (tc-type-list-eq [a : ast.AstTypeList] [b : ast.AstTypeList]) : bool
  (and
    (= (ast.ast-type-list-len (& a)) (ast.ast-type-list-len (& b)))
    (tc-type-list-eq-at? (& a) (& b) 0)))

(define (tc-type-list-eq-at?
  [a : (& a ast.AstTypeList)]
  [b : (& b ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len a))
    true
    (and
      (tc-type-eq
        (ast.ty-node-get
          (ast.ast-type-list-get a index (ast.ast-type-id-fallback)))
        (ast.ty-node-get
          (ast.ast-type-list-get b index (ast.ast-type-id-fallback))))
      (tc-type-list-eq-at? a b (+ index 1)))))

(define (tc-nominal-name-id-eq? [a : i64] [b : i64]) : bool
  (= (csym.compiler-symbol-name-id-key a) (csym.compiler-symbol-name-id-key b)))

(define (tc-type-eq-core [a : ast.AstType] [b : ast.AstType]) : bool
  (match a
    [(I64)
      (match b
        [(I64) true]
        [_ false])]
    [(I32)
      (match b
        [(I32) true]
        [_ false])]
    [(I16)
      (match b
        [(I16) true]
        [_ false])]
    [(I8)
      (match b
        [(I8) true]
        [_ false])]
    [(U64)
      (match b
        [(U64) true]
        [_ false])]
    [(U32)
      (match b
        [(U32) true]
        [_ false])]
    [(U16)
      (match b
        [(U16) true]
        [_ false])]
    [(U8)
      (match b
        [(U8) true]
        [_ false])]
    [(F64)
      (match b
        [(F64) true]
        [_ false])]
    [(F32)
      (match b
        [(F32) true]
        [_ false])]
    [(Bool)
      (match b
        [(Bool) true]
        [_ false])]
    [(Char)
      (match b
        [(Char) true]
        [_ false])]
    [(String)
      (match b
        [(String) true]
        [_ false])]
    [(Str)
      (match b
        [(Str) true]
        [_ false])]
    [(Bytes)
      (match b
        [(Bytes) true]
        [_ false])]
    [(Unit)
      (match b
        [(Unit) true]
        [_ false])]
    [(Never)
      (match b
        [(Never) true]
        [_ false])]
    [(Expr)
      (match b
        [(Expr) true]
        [_ false])]
    [(ExprList)
      (match b
        [(ExprList) true]
        [_ false])]
    [(Func a-args a-ret)
      (match b
        [(Func b-args b-ret)
          (and
            (tc-type-list-eq
              (ast.ast-type-list-box-shared-view a-args)
              (ast.ast-type-list-box-shared-view b-args))
            (tc-type-eq (ast.ty-node-get a-ret) (ast.ty-node-get b-ret)))]
        [_ false])]
    [(CFunc a-signature a-mode)
      (match b
        [(CFunc b-signature b-mode)
          (and
            (ast.ast-c-function-mode-eq? a-mode b-mode)
            (tc-type-eq
              (ast.ty-node-get a-signature)
              (ast.ty-node-get b-signature)))]
        [_ false])]
    [(Tuple a-elems)
      (match b
        [(Tuple b-elems)
          (tc-type-list-eq
            (ast.ast-type-list-box-shared-view a-elems)
            (ast.ast-type-list-box-shared-view b-elems))]
        [_ false])]
    [(Array a-elem a-len)
      (match b
        [(Array b-elem b-len)
          (and
            (= a-len b-len)
            (tc-type-eq (ast.ty-node-get a-elem) (ast.ty-node-get b-elem)))]
        [_ false])]
    [(DynArray a-elem)
      (match b
        [(DynArray b-elem)
          (tc-type-eq (ast.ty-node-get a-elem) (ast.ty-node-get b-elem))]
        [_ false])]
    [(Slice a-elem)
      (match b
        [(Slice b-elem)
          (tc-type-eq (ast.ty-node-get a-elem) (ast.ty-node-get b-elem))]
        [_ false])]
    [(Box a-elem)
      (match b
        [(Box b-elem)
          (tc-type-eq (ast.ty-node-get a-elem) (ast.ty-node-get b-elem))]
        [_ false])]
    [(Ptr a-elem)
      (match b
        [(Ptr b-elem)
          (tc-type-eq (ast.ty-node-get a-elem) (ast.ty-node-get b-elem))]
        [_ false])]
    [(MutPtr a-elem)
      (match b
        [(MutPtr b-elem)
          (tc-type-eq (ast.ty-node-get a-elem) (ast.ty-node-get b-elem))]
        [_ false])]
    [(Ref a-region a-inner)
      (match b
        [(Ref b-region b-inner)
          (and
            (= a-region b-region)
            (tc-type-eq (ast.ty-node-get a-inner) (ast.ty-node-get b-inner)))]
        [_ false])]
    [(MutRef a-region a-inner)
      (match b
        [(MutRef b-region b-inner)
          (and
            (= a-region b-region)
            (tc-type-eq (ast.ty-node-get a-inner) (ast.ty-node-get b-inner)))]
        [_ false])]
    [(Region _ inner)
      (tc-type-eq-core
        (tc-type-without-regions (ast.ty-node-get inner))
        (tc-type-without-regions b))]
    [(Invalidate a-lifetime a-inner)
      (match b
        [(Invalidate b-lifetime b-inner)
          (and
            (= a-lifetime b-lifetime)
            (tc-type-eq (ast.ty-node-get a-inner) (ast.ty-node-get b-inner)))]
        [_ false])]
    [(Enum a-name)
      (match b
        [(Enum b-name) (tc-nominal-name-id-eq? a-name b-name)]
        [_ false])]
    [(EnumArgs a-name a-lifetimes)
      (match b
        [(EnumArgs b-name b-lifetimes)
          (and
            (tc-nominal-name-id-eq? a-name b-name)
            (tc-lifetime-list-eq
              (ast.ast-lifetime-list-box-shared-view a-lifetimes)
              (ast.ast-lifetime-list-box-shared-view b-lifetimes)))]
        [_ false])]
    [(Struct a-name)
      (match b
        [(Struct b-name) (tc-nominal-name-id-eq? a-name b-name)]
        [_ false])]
    [(StructArgs a-name a-lifetimes)
      (match b
        [(StructArgs b-name b-lifetimes)
          (and
            (tc-nominal-name-id-eq? a-name b-name)
            (tc-lifetime-list-eq
              (ast.ast-lifetime-list-box-shared-view a-lifetimes)
              (ast.ast-lifetime-list-box-shared-view b-lifetimes)))]
        [_ false])]
    [(Var a-name)
      (match b
        [(Var b-name) (tc-nominal-name-id-eq? a-name b-name)]
        [_ false])]
    [(VarArgs a-name a-lifetimes)
      (match b
        [(VarArgs b-name b-lifetimes)
          (and
            (tc-nominal-name-id-eq? a-name b-name)
            (tc-lifetime-list-eq
              (ast.ast-lifetime-list-box-shared-view a-lifetimes)
              (ast.ast-lifetime-list-box-shared-view b-lifetimes)))]
        [_ false])]))

(define (tc-type-eq [a : ast.AstType] [b : ast.AstType]) : bool
  (if (or
    (tc-poison-type? (tc-global-shared-view a))
    (tc-poison-type? (tc-global-shared-view b)))
    true
    (match (tc-global-shared-view a)
      [(Region _ inner) (tc-type-eq (ast.ty-node-get inner) b)]
      [_
        (match (tc-global-shared-view b)
          [(Region _ inner) (tc-type-eq a (ast.ty-node-get inner))]
          [_ (tc-type-eq-core a b)])])))

(define (tc-never-type? [ty : ast.AstType]) : bool
  (match ty
    [(Never) true]
    [_ false]))

(define (tc-f32-to-f64-compatible?
  [expected : ast.AstType]
  [actual : ast.AstType]) : bool
  (match (tc-type-strip-region expected)
    [(F64)
      (match (tc-type-strip-region actual)
        [(F32) true]
        [_ false])]
    [_ false]))

(define (tc-variance-flip [variance : TcVariance]) : TcVariance
  (match variance
    [(TcVarianceBivariant) (TcVarianceBivariant)]
    [(TcVarianceCovariant) (TcVarianceContravariant)]
    [(TcVarianceContravariant) (TcVarianceCovariant)]
    [(TcVarianceInvariant) (TcVarianceInvariant)]))

(define (tc-variance-compose [outer : TcVariance] [inner : TcVariance]) : TcVariance
  (match outer
    [(TcVarianceBivariant) (TcVarianceBivariant)]
    [(TcVarianceInvariant) (TcVarianceInvariant)]
    [(TcVarianceCovariant) inner]
    [(TcVarianceContravariant) (tc-variance-flip inner)]))

(define (tc-variance-merge [left : TcVariance] [right : TcVariance]) : TcVariance
  (match left
    [(TcVarianceBivariant) right]
    [(TcVarianceInvariant) (TcVarianceInvariant)]
    [(TcVarianceCovariant)
      (match right
        [(or (TcVarianceBivariant) (TcVarianceCovariant)) left]
        [_ (TcVarianceInvariant)])]
    [(TcVarianceContravariant)
      (match right
        [(or (TcVarianceBivariant) (TcVarianceContravariant)) left]
        [_ (TcVarianceInvariant)])]))

(define (tc-type-list-lifetime-variance-at
  [ctx : TcContext]
  [types : (& types ast.AstTypeList)]
  [lifetime-id : i64]
  [stack : TcNameIdList]
  [position : TcVariance]
  [index : i64]) : TcVariance
  (if (>= index (ast.ast-type-list-len types))
    (TcVarianceBivariant)
    (tc-variance-merge
      (tc-type-lifetime-variance
        ctx
        (ast.ty-node-get
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))
        lifetime-id
        stack
        position)
      (tc-type-list-lifetime-variance-at
        ctx
        types
        lifetime-id
        stack
        position
        (+ index 1)))))

(define (tc-type-list-lifetime-variance
  [ctx : TcContext]
  [types : ast.AstTypeList]
  [lifetime-id : i64]
  [stack : TcNameIdList]
  [position : TcVariance]) : TcVariance
  (tc-type-list-lifetime-variance-at ctx (& types) lifetime-id stack position 0))

(define (tc-field-list-lifetime-variance-at
  [ctx : TcContext]
  [fields : (& fields ast.AstFieldDefList)]
  [lifetime-id : i64]
  [stack : TcNameIdList]
  [index : i64]) : TcVariance
  (if (>= index fields.len)
    (TcVarianceBivariant)
    (match (ast.ast-field-def-list-get
      fields
      index
      (ast.ast-field-def-fallback))
      [(Def _ ty _)
        (tc-variance-merge
          (tc-type-lifetime-variance
            ctx
            ty
            lifetime-id
            stack
            (TcVarianceCovariant))
          (tc-field-list-lifetime-variance-at
            ctx
            fields
            lifetime-id
            stack
            (+ index 1)))])))

(define (tc-variant-list-lifetime-variance-at
  [ctx : TcContext]
  [variants : (& variants ast.AstVariantDefList)]
  [lifetime-id : i64]
  [stack : TcNameIdList]
  [index : i64]) : TcVariance
  (if (>= index variants.len)
    (TcVarianceBivariant)
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(Def _ payloads _)
        (tc-variance-merge
          (tc-type-list-lifetime-variance
            ctx
            payloads
            lifetime-id
            stack
            (TcVarianceCovariant))
          (tc-variant-list-lifetime-variance-at
            ctx
            variants
            lifetime-id
            stack
            (+ index 1)))])))

(define (tc-nominal-lifetime-variance-at
  [ctx : TcContext]
  [name-id : i64]
  [index : i64]
  [stack : TcNameIdList]) : TcVariance
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-type-id-or
        (tc-context-symbols-ref (& ctx))
        name-id
        (csym.compiler-symbols-missing-handle))]
    (if (not (csym.compiler-symbols-handle-found? handle))
      (TcVarianceInvariant)
      (let
        [nominal-id : i64 (tc-nominal-owner-id-or ctx handle name-id)]
        (if (or (< nominal-id 0) (tc-name-id-list-contains stack nominal-id))
          ;; A recursive occurrence transmits its surrounding polarity. Using
          ;; covariance here is the conservative one-step fixed point: a
          ;; mutable-pointer/invariant wrapper still turns the cycle invariant.
          (TcVarianceCovariant)
          (let
            [owner-ctx : TcContext
              (tc-context-with-nominal-owner-index-module
                ctx
                (csym.compiler-symbol-handle-index handle))]
            [next-stack : TcNameIdList (tc-name-id-list-add stack nominal-id)]
            (match (csym.compiler-symbols-decl-at-index
              (tc-context-symbols owner-ctx)
              (csym.compiler-symbol-handle-index handle))
              [(Ok decl)
                (match decl
                  [(DefStructLifetimes _ _ lifetimes _ _ fields)
                    (if (>= index (tc-lifetime-list-count lifetimes))
                      (TcVarianceInvariant)
                      (tc-field-list-lifetime-variance-at
                        owner-ctx
                        (& fields)
                        (ast.ast-lifetime-list-get
                          (& lifetimes)
                          index
                          (ast.ast-lifetime-fallback))
                        next-stack
                        0))]
                  [(DefEnumLifetimes _ _ lifetimes _ variants)
                    (if (>= index (tc-lifetime-list-count lifetimes))
                      (TcVarianceInvariant)
                      (tc-variant-list-lifetime-variance-at
                        owner-ctx
                        (& variants)
                        (ast.ast-lifetime-list-get
                          (& lifetimes)
                          index
                          (ast.ast-lifetime-fallback))
                        next-stack
                        0))]
                  [_ (TcVarianceInvariant)])]
              [(Err _) (TcVarianceInvariant)])))))))

(define (tc-nominal-args-lifetime-variance-at
  [ctx : TcContext]
  [name-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [lifetime-id : i64]
  [stack : TcNameIdList]
  [position : TcVariance]
  [index : i64]) : TcVariance
  (if (>= index (ast.ast-lifetime-list-len (& lifetimes)))
    (TcVarianceBivariant)
    (let
      [argument : i64
        (ast.ast-lifetime-list-get
          (& lifetimes)
          index
          (ast.ast-lifetime-fallback))]
      [head : TcVariance
        (if (= argument lifetime-id)
          ;; Arena's brand is a capability identity, not a borrowed view. Its
          ;; phantom lifetime stays invariant even though the unchanged runtime
          ;; declaration has no field that ordinary inference could inspect.
          (if (and (tc-arena-nominal-name-id? name-id) (= index 0))
            (TcVarianceInvariant)
            (tc-variance-compose
              position
              (tc-nominal-lifetime-variance-at ctx name-id index stack)))
          (TcVarianceBivariant))]
      (tc-variance-merge
        head
        (tc-nominal-args-lifetime-variance-at
          ctx
          name-id
          lifetimes
          lifetime-id
          stack
          position
          (+ index 1))))))

(define (tc-type-lifetime-variance
  [ctx : TcContext]
  [ty : ast.AstType]
  [lifetime-id : i64]
  [stack : TcNameIdList]
  [position : TcVariance]) : TcVariance
  (match (tc-resolve-type ctx ty)
    [(Func params ret)
      (tc-variance-merge
        (tc-type-list-lifetime-variance
          ctx
          (ast.ast-type-list-box-shared-view params)
          lifetime-id
          stack
          (tc-variance-flip position))
        (tc-type-lifetime-variance
          ctx
          (ast.ty-node-get ret)
          lifetime-id
          stack
          position))]
    [(Tuple elems)
      (tc-type-list-lifetime-variance
        ctx
        (ast.ast-type-list-box-shared-view elems)
        lifetime-id
        stack
        position)]
    [(or (Array elem _) (DynArray elem) (Slice elem) (Box elem) (Ptr elem))
      (tc-type-lifetime-variance
        ctx
        (ast.ty-node-get elem)
        lifetime-id
        stack
        position)]
    ;; An owned dynamic array is a move-only handle whose elements change only
    ;; through its owning place or a `&mut` to it (invariant in its referent),
    ;; never through a shared reference. Like Box and Slice it follows its
    ;; context: shortening moves the handle and leaves no longer-typed alias.
    [(MutPtr elem)
      (tc-type-lifetime-variance
        ctx
        (ast.ty-node-get elem)
        lifetime-id
        stack
        (TcVarianceInvariant))]
    [(or (Ref lifetime inner) (Region lifetime inner))
      (tc-variance-merge
        (if (= lifetime lifetime-id)
          position
          (TcVarianceBivariant))
        (tc-type-lifetime-variance
          ctx
          (ast.ty-node-get inner)
          lifetime-id
          stack
          position))]
    [(MutRef lifetime inner)
      (tc-variance-merge
        (if (= lifetime lifetime-id)
          position
          (TcVarianceBivariant))
        (tc-type-lifetime-variance
          ctx
          (ast.ty-node-get inner)
          lifetime-id
          stack
          (TcVarianceInvariant)))]
    [(Invalidate lifetime inner)
      (tc-variance-merge
        (if (= lifetime lifetime-id)
          (TcVarianceInvariant)
          (TcVarianceBivariant))
        (tc-type-lifetime-variance
          ctx
          (ast.ty-node-get inner)
          lifetime-id
          stack
          position))]
    [(or (EnumArgs name lifetimes) (StructArgs name lifetimes))
      (tc-nominal-args-lifetime-variance-at
        ctx
        name
        (ast.ast-lifetime-list-box-shared-view lifetimes)
        lifetime-id
        stack
        position
        0)]
    [(VarArgs _ lifetimes)
      (if (tc-lifetime-list-contains
        (ast.ast-lifetime-list-box-shared-view lifetimes)
        lifetime-id)
        (TcVarianceInvariant)
        (TcVarianceBivariant))]
    [_ (TcVarianceBivariant)]))

(define (tc-lifetime-coercible-for-variance?
  [env : TcTypeEnv]
  [variance : TcVariance]
  [expected : i64]
  [actual : i64]) : bool
  (if (= expected actual)
    true
    (match variance
      [(TcVarianceBivariant) true]
      [(TcVarianceCovariant)
        (tc-lifetime-outlives-lifetime-id? env actual expected)]
      [(TcVarianceContravariant)
        (tc-lifetime-outlives-lifetime-id? env expected actual)]
      [(TcVarianceInvariant) false])))

(define (tc-nominal-lifetime-coercion-variance-at
  [ctx : TcContext]
  [name-id : i64]
  [index : i64]) : TcVariance
  (if (and (tc-arena-nominal-name-id? name-id) (= index 0))
    (TcVarianceInvariant)
    (tc-nominal-lifetime-variance-at ctx name-id index Nil)))

(define (tc-nominal-lifetime-args-coercible-at?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [expected : (& expected ast.AstLifetimeList)]
  [actual : (& actual ast.AstLifetimeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-lifetime-list-len expected))
    true
    (and
      (tc-lifetime-coercible-for-variance?
        env
        (tc-nominal-lifetime-coercion-variance-at ctx name-id index)
        (ast.ast-lifetime-list-get expected index (ast.ast-lifetime-fallback))
        (ast.ast-lifetime-list-get actual index (ast.ast-lifetime-fallback)))
      (tc-nominal-lifetime-args-coercible-at?
        ctx
        env
        name-id
        expected
        actual
        (+ index 1)))))

(define (tc-nominal-lifetime-args-coercible?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [expected : ast.AstLifetimeList]
  [actual : ast.AstLifetimeList]) : bool
  (and
    (=
      (ast.ast-lifetime-list-len (& expected))
      (ast.ast-lifetime-list-len (& actual)))
    (tc-nominal-lifetime-args-coercible-at?
      ctx
      env
      name-id
      (& expected)
      (& actual)
      0)))

(define (tc-type-list-coercible-at?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expected : (& expected ast.AstTypeList)]
  [actual : (& actual ast.AstTypeList)]
  [contravariant : bool]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len expected))
    true
    (let
      [want : ast.AstType
        (ast.ty-node-get
          (ast.ast-type-list-get expected index (ast.ast-type-id-fallback)))]
      [got : ast.AstType
        (ast.ty-node-get
          (ast.ast-type-list-get actual index (ast.ast-type-id-fallback)))]
      (and
        (if contravariant
          (tc-type-coercible-core? ctx env got want)
          (tc-type-coercible-core? ctx env want got))
        (tc-type-list-coercible-at?
          ctx
          env
          expected
          actual
          contravariant
          (+ index 1))))))

(define (tc-type-list-coercible?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expected : ast.AstTypeList]
  [actual : ast.AstTypeList]
  [contravariant : bool]) : bool
  (and
    (= (ast.ast-type-list-len (& expected)) (ast.ast-type-list-len (& actual)))
    (tc-type-list-coercible-at? ctx env (& expected) (& actual) contravariant 0)))

(defenum TcTypeRegionProbe
  (No)
  (Some i64 i64))

(define (tc-type-region-probe [ty : ast.AstType]) : TcTypeRegionProbe
  (match ty
    [(Region lifetime inner) (Some lifetime inner)]
    [_ (No)]))

(define (tc-type-coercible-nonregion-core?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expected : ast.AstType]
  [actual : ast.AstType]) : bool
  (if (tc-type-eq
    (tc-global-shared-view expected)
    (tc-global-shared-view actual))
    true
    (match expected
      [(Func expected-params expected-ret)
        (match actual
          [(Func actual-params actual-ret)
            (and
              (tc-type-list-coercible?
                ctx
                env
                (ast.ast-type-list-box-shared-view expected-params)
                (ast.ast-type-list-box-shared-view actual-params)
                true)
              (tc-type-coercible-core?
                ctx
                env
                (ast.ty-node-get expected-ret)
                (ast.ty-node-get actual-ret)))]
          [_ false])]
      [(Tuple expected-elems)
        (match actual
          [(Tuple actual-elems)
            (tc-type-list-coercible?
              ctx
              env
              (ast.ast-type-list-box-shared-view expected-elems)
              (ast.ast-type-list-box-shared-view actual-elems)
              false)]
          [_ false])]
      [(Array expected-elem expected-len)
        (match actual
          [(Array actual-elem actual-len)
            (and
              (= expected-len actual-len)
              (tc-type-coercible-core?
                ctx
                env
                (ast.ty-node-get expected-elem)
                (ast.ty-node-get actual-elem)))]
          [_ false])]
      [(Slice expected-elem)
        (match actual
          [(Slice actual-elem)
            (tc-type-coercible-core?
              ctx
              env
              (ast.ty-node-get expected-elem)
              (ast.ty-node-get actual-elem))]
          [_ false])]
      [(Box expected-elem)
        (match actual
          [(Box actual-elem)
            (tc-type-coercible-core?
              ctx
              env
              (ast.ty-node-get expected-elem)
              (ast.ty-node-get actual-elem))]
          [_ false])]
      ;; Covariant like Box; see `tc-type-lifetime-variance`.
      [(DynArray expected-elem)
        (match actual
          [(DynArray actual-elem)
            (tc-type-coercible-core?
              ctx
              env
              (ast.ty-node-get expected-elem)
              (ast.ty-node-get actual-elem))]
          [_ false])]
      [(Ptr expected-elem)
        (match actual
          [(Ptr actual-elem)
            (tc-type-coercible-core?
              ctx
              env
              (ast.ty-node-get expected-elem)
              (ast.ty-node-get actual-elem))]
          [_ false])]
      [(Ref expected-lifetime expected-inner)
        (match actual
          [(Ref actual-lifetime actual-inner)
            (and
              (tc-lifetime-outlives-lifetime-id?
                env
                actual-lifetime
                expected-lifetime)
              (tc-type-coercible-core?
                ctx
                env
                (ast.ty-node-get expected-inner)
                (ast.ty-node-get actual-inner)))]
          [_ false])]
      [(MutRef expected-lifetime expected-inner)
        (match actual
          [(MutRef actual-lifetime actual-inner)
            (and
              (tc-lifetime-outlives-lifetime-id?
                env
                actual-lifetime
                expected-lifetime)
              (tc-type-eq
                (ast.ty-node-get expected-inner)
                (ast.ty-node-get actual-inner)))]
          [_ false])]
      [(EnumArgs expected-name expected-lifetimes)
        (match actual
          [(EnumArgs actual-name actual-lifetimes)
            (and
              (tc-nominal-name-id-eq? expected-name actual-name)
              (tc-nominal-lifetime-args-coercible?
                ctx
                env
                expected-name
                (ast.ast-lifetime-list-box-shared-view expected-lifetimes)
                (ast.ast-lifetime-list-box-shared-view actual-lifetimes)))]
          [_ false])]
      ;; A branded Arena may be deliberately erased to the legacy bare handle
      ;; for read-only/compatibility helpers. This is one-way: the converse case
      ;; remains unmatched, so a copied bare handle cannot regain authority over
      ;; a generated brand.
      [(Struct expected-name)
        (match actual
          [(StructArgs actual-name actual-lifetimes)
            (tc-branded-arena-erases-to-bare?
              expected-name
              actual-name
              (ast.ast-lifetime-list-box-shared-view actual-lifetimes))]
          [_ false])]
      [(StructArgs expected-name expected-lifetimes)
        (match actual
          [(StructArgs actual-name actual-lifetimes)
            (and
              (tc-nominal-name-id-eq? expected-name actual-name)
              (tc-nominal-lifetime-args-coercible?
                ctx
                env
                expected-name
                (ast.ast-lifetime-list-box-shared-view expected-lifetimes)
                (ast.ast-lifetime-list-box-shared-view actual-lifetimes)))]
          [_ false])]
      [_ false])))

(define (tc-type-coercible-core?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expected : ast.AstType]
  [actual : ast.AstType]) : bool
  ;; Region allocation tags are not part of type identity, but when both sides
  ;; carry one, changing the tag must be a proven shortening. The scalar probes
  ;; leave each owning AstType available for exactly one recursive/structural use.
  (let
    [expected-region : TcTypeRegionProbe
      (tc-type-region-probe (tc-global-shared-view expected))]
    [actual-region : TcTypeRegionProbe
      (tc-type-region-probe (tc-global-shared-view actual))]
    (match expected-region
      [(Some expected-lifetime expected-inner)
        (match actual-region
          [(Some actual-lifetime actual-inner)
            (and
              (tc-lifetime-outlives-lifetime-id?
                env
                actual-lifetime
                expected-lifetime)
              (tc-type-coercible-core?
                ctx
                env
                (ast.ty-node-get expected-inner)
                (ast.ty-node-get actual-inner)))]
          [(No)
            (tc-type-coercible-core?
              ctx
              env
              (ast.ty-node-get expected-inner)
              actual)])]
      [(No)
        (match actual-region
          [(Some _ actual-inner)
            (tc-type-coercible-core?
              ctx
              env
              expected
              (ast.ty-node-get actual-inner))]
          [(No) (tc-type-coercible-nonregion-core? ctx env expected actual)])])))

(define (tc-type-coercible?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expected : ast.AstType]
  [actual : ast.AstType]) : bool
  (if (tc-never-type? (tc-global-shared-view actual))
    true
    (if (tc-type-coercible-core?
      ctx
      env
      (tc-global-shared-view expected)
      (tc-global-shared-view actual))
      true
      ;; Preserve the existing scalar-only contextual numeric conversion. The
      ;; structural recursion above deliberately does not lift it into arrays,
      ;; pointers, references, or nominal aggregates.
      (tc-f32-to-f64-compatible? expected actual))))

;; A lifetime failure: it carries its kind to `tc-type-mismatch-message-in-context`.
(define (tc-lifetime-coercion-outlives-detail [source : i64] [required : i64]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (LifetimeMismatch))
    "; source lifetime `"
    (ci.intern-str source)
    "` does not outlive required lifetime `"
    (ci.intern-str required)
    "`"))

(define (tc-lifetime-coercion-invariant-detail
  [label : String]
  [expected : ast.AstType]
  [actual : ast.AstType]) : String
  (let
    [source-lifetimes : TcNameIdList
      (tc-type-collect-reference-lifetimes actual)]
    [required-lifetimes : TcNameIdList
      (tc-type-collect-reference-lifetimes expected)]
    (if (or
      (tc-name-id-list-empty? source-lifetimes)
      (tc-name-id-list-empty? required-lifetimes))
      (str_cat.str-cat "; " label " is invariant")
      (str_cat.str-cat
        "; source lifetime `"
        (ci.intern-str (tc-name-id-list-head source-lifetimes))
        "` cannot satisfy required lifetime `"
        (ci.intern-str (tc-name-id-list-head required-lifetimes))
        "` because "
        label
        " is invariant"))))

(define (tc-func-invalidate-effects-differ?
  [want : ast.AstType]
  [got : ast.AstType]) : bool
  (match want
    [(Func want-params _)
      (match got
        [(Func got-params _)
          (tc-type-list-invalidate-effects-differ?
            (ast.ast-type-list-box-shared-view want-params)
            (ast.ast-type-list-box-shared-view got-params))]
        [_ false])]
    [_ false]))

(define (tc-type-list-invalidate-effects-differ?
  [a : ast.AstTypeList]
  [b : ast.AstTypeList]) : bool
  (let
    [index : i64 0]
    [differ : bool false]
    (while (and
      (not differ)
      (< index (ast.ast-type-list-len (& a)))
      (< index (ast.ast-type-list-len (& b))))
      (if (=
        (tc-type-invalidate-param?
          (ast.ty-node-get
            (ast.ast-type-list-get (& a) index (ast.ast-type-id-fallback))))
        (tc-type-invalidate-param?
          (ast.ty-node-get
            (ast.ast-type-list-get (& b) index (ast.ast-type-id-fallback)))))
        unit
        (set! differ true))
      (set! index (+ index 1)))
    differ))

(define (tc-type-invalidate-param? [ty : ast.AstType]) : bool
  (match ty
    [(Invalidate _ _) true]
    [_ false]))

(define (tc-lifetime-coercion-variance-detail
  [label : String]
  [expected : ast.AstType]
  [actual : ast.AstType]) : String
  (let
    [source-lifetimes : TcNameIdList
      (tc-type-collect-reference-lifetimes actual)]
    [required-lifetimes : TcNameIdList
      (tc-type-collect-reference-lifetimes expected)]
    (if (or
      (tc-name-id-list-empty? source-lifetimes)
      (tc-name-id-list-empty? required-lifetimes))
      (str_cat.str-cat "; " label " failed")
      (str_cat.str-cat
        "; source lifetime `"
        (ci.intern-str (tc-name-id-list-head source-lifetimes))
        "` cannot satisfy required lifetime `"
        (ci.intern-str (tc-name-id-list-head required-lifetimes))
        "` because "
        label
        " failed"))))

(define (tc-nominal-lifetime-coercion-failure-detail-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [expected : ast.AstLifetimeList]
  [actual : ast.AstLifetimeList]
  [index : i64]) : String
  (if (>= index (ast.ast-lifetime-list-len (& expected)))
    ""
    (let
      [required : i64
        (ast.ast-lifetime-list-get
          (& expected)
          index
          (ast.ast-lifetime-fallback))]
      [source : i64
        (ast.ast-lifetime-list-get (& actual) index (ast.ast-lifetime-fallback))]
      [variance : TcVariance
        (tc-nominal-lifetime-coercion-variance-at ctx name-id index)]
      (if (= required source)
        (tc-nominal-lifetime-coercion-failure-detail-at
          ctx
          env
          name-id
          expected
          actual
          (+ index 1))
        (match variance
          [(TcVarianceBivariant) ""]
          [(TcVarianceCovariant)
            (if (tc-lifetime-outlives-lifetime-id? env source required)
              ""
              (tc-lifetime-coercion-outlives-detail source required))]
          [(TcVarianceContravariant)
            (if (tc-lifetime-outlives-lifetime-id? env required source)
              ""
              (str_cat.str-cat
                (cdiag.compiler-diagnostic-typecheck-tag (LifetimeMismatch))
                "; required lifetime `"
                (ci.intern-str required)
                "` does not outlive source lifetime `"
                (ci.intern-str source)
                "` for contravariant lifetime parameter "
                (string.int->string (+ index 1))
                " of `"
                (tc-nominal-name-id-display name-id)
                "`"))]
          [(TcVarianceInvariant)
            (str_cat.str-cat
              "; source lifetime `"
              (ci.intern-str source)
              "` cannot satisfy required lifetime `"
              (ci.intern-str required)
              "` because lifetime parameter "
              (string.int->string (+ index 1))
              " of `"
              (tc-nominal-name-id-display name-id)
              "` is invariant")])))))

(define (tc-type-coercion-failure-detail
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expected : ast.AstType]
  [actual : ast.AstType]) : String
  (let
    [want : ast.AstType (tc-type-strip-region (tc-resolve-type ctx expected))]
    [got : ast.AstType (tc-type-strip-region (tc-resolve-type ctx actual))]
    (match want
      [(Ref required want-inner)
        (match got
          [(Ref source got-inner)
            (let
              [want-inner-ty : ast.AstType (ast.ty-node-get want-inner)]
              [got-inner-ty : ast.AstType (ast.ty-node-get got-inner)]
              [inner-detail : String
                (tc-type-coercion-failure-detail
                  ctx
                  env
                  (tc-global-shared-view want-inner-ty)
                  (tc-global-shared-view got-inner-ty))]
              (cond
                [(not
                    (tc-type-coercible-core? ctx env want-inner-ty got-inner-ty))
                  inner-detail]
                [(tc-lifetime-outlives-lifetime-id? env source required) ""]
                [else (tc-lifetime-coercion-outlives-detail source required)]))]
          [_ ""])]
      [(MutRef required want-inner)
        (match got
          [(MutRef source got-inner)
            (if (tc-type-eq
              (ast.ty-node-get want-inner)
              (ast.ty-node-get got-inner))
              (if (tc-lifetime-outlives-lifetime-id? env source required)
                ""
                (tc-lifetime-coercion-outlives-detail source required))
              (tc-lifetime-coercion-invariant-detail
                "mutable reference referent type"
                (ast.ty-node-get want-inner)
                (ast.ty-node-get got-inner)))]
          [_ ""])]
      [(MutPtr want-inner)
        (match got
          [(MutPtr got-inner)
            (tc-lifetime-coercion-invariant-detail
              "mutable raw pointer referent type"
              (ast.ty-node-get want-inner)
              (ast.ty-node-get got-inner))]
          [_ ""])]
      ;; Covariant, so a failure is its element's.
      [(DynArray want-inner)
        (match got
          [(DynArray got-inner)
            (tc-type-coercion-failure-detail
              ctx
              env
              (ast.ty-node-get want-inner)
              (ast.ty-node-get got-inner))]
          [_ ""])]
      [(Func want-params want-ret)
        (match got
          [(Func got-params got-ret)
            (let
              [want-fn : ast.AstType (Func want-params want-ret)]
              [got-fn : ast.AstType (Func got-params got-ret)]
              (if (tc-func-invalidate-effects-differ?
                (tc-global-shared-view want-fn)
                (tc-global-shared-view got-fn))
                "; the function types differ in a parameter's :invalidate effect"
                (tc-lifetime-coercion-variance-detail
                  "function parameter/result variance"
                  want-fn
                  got-fn)))]
          [_ ""])]
      [(EnumArgs want-name want-lifetimes)
        (match got
          [(EnumArgs got-name got-lifetimes)
            (if (tc-nominal-name-id-eq? want-name got-name)
              (tc-nominal-lifetime-coercion-failure-detail-at
                ctx
                env
                want-name
                (ast.ast-lifetime-list-box-shared-view want-lifetimes)
                (ast.ast-lifetime-list-box-shared-view got-lifetimes)
                0)
              "")]
          [_ ""])]
      [(StructArgs want-name want-lifetimes)
        (match got
          [(StructArgs got-name got-lifetimes)
            (if (tc-nominal-name-id-eq? want-name got-name)
              (tc-nominal-lifetime-coercion-failure-detail-at
                ctx
                env
                want-name
                (ast.ast-lifetime-list-box-shared-view want-lifetimes)
                (ast.ast-lifetime-list-box-shared-view got-lifetimes)
                0)
              "")]
          [_ ""])]
      [_ ""])))

;; A type mismatch with the coercion failure detail appended. A context kind
;; other than a plain type mismatch wins, then a lifetime failure in the detail.
(define (tc-type-mismatch-message-in-context
  [ctx : TcContext]
  [env : TcTypeEnv]
  [actual : ast.AstType]
  [expected : ast.AstType]
  [message : String]) : String
  (let
    [context-kind : bool
      (and
        (cdiag.compiler-diagnostic-typecheck-tagged? (& message))
        (not
          (string.eq
            (cdiag.compiler-diagnostic-typecheck-tag-code (& message))
            (cdiag.compiler-diagnostic-code-typecheck-type-mismatch))))]
    [base : String
      (tc-type-mismatch-message
        (tc-global-shared-view actual)
        (tc-global-shared-view expected)
        message)]
    [detail : String (tc-type-coercion-failure-detail ctx env expected actual)]
    [text : String
      (str_cat.str-cat
        base
        (cdiag.compiler-diagnostic-untagged-message (string.copy (& detail))))]
    (if (and
      (not context-kind)
      (cdiag.compiler-diagnostic-typecheck-tagged? (& detail)))
      (tc-message-with-tag-of (& detail) text)
      text)))

(define (tc-type-compatible? [expected : ast.AstType] [actual : ast.AstType]) : bool
  (if (tc-never-type? (tc-global-shared-view actual))
    true
    (if (tc-type-eq
      (tc-global-shared-view expected)
      (tc-global-shared-view actual))
      true
      (tc-f32-to-f64-compatible? expected actual))))

(define (tc-match-canonicalized-inferred-type-for-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [canonical : ast.AstType]
  [expected : ast.AstType]) : TcInferredTypeMatch
  (let
    [canonical-expected : ast.AstType
      (tc-canonicalize-inferred-type ctx expected)]
    (if (tc-type-coercible?
      ctx
      env
      canonical-expected
      (tc-global-shared-view canonical))
      (Compatible canonical)
      (Mismatch canonical))))

(define (tc-match-inferred-type-for-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : ast.AstType]
  [expected : ast.AstType]) : TcInferredTypeMatch
  (if (tc-type-coercible?
    ctx
    env
    (tc-global-shared-view expected)
    (tc-global-shared-view ty))
    (Compatible ty)
    (let
      [canonical : ast.AstType (tc-canonicalize-inferred-type ctx ty)]
      (if (tc-type-coercible?
        ctx
        env
        (tc-global-shared-view expected)
        (tc-global-shared-view canonical))
        (Compatible canonical)
        (tc-match-canonicalized-inferred-type-for-expected
          ctx
          env
          canonical
          expected)))))

(define (tc-nominal-name-id-canonical-eq?
  [ctx : TcContext]
  [actual : i64]
  [expected : i64]) : bool
  (let
    [actual-base : i64 (tc-qualified-name-base-id actual)]
    [expected-base : i64 (tc-qualified-name-base-id expected)]
    (cond
      [(not (tc-nominal-name-id-eq? actual-base expected-base)) false]
      [else
        (let
          [canonical-actual : i64 (tc-source-owned-nominal-name-id ctx actual)]
          (cond
            [(tc-nominal-name-id-eq? canonical-actual expected) true]
            [else
              (tc-nominal-name-id-eq?
                canonical-actual
                (tc-source-owned-nominal-name-id ctx expected))]))])))

(define (tc-merge-branch-type-raw
  [ctx : TcContext]
  [env : TcTypeEnv]
  [a : ast.AstType]
  [b : ast.AstType]) : ResultTcType
  (cond
    [(tc-never-type? (tc-global-shared-view a)) (Ok b)]
    [(tc-never-type? (tc-global-shared-view b)) (Ok a)]
    [(tc-type-eq (tc-global-shared-view a) (tc-global-shared-view b))
      (let
        [a-regions : TcNameIdList
          (tc-type-collect-regions (tc-global-shared-view a))]
        [b-regions : TcNameIdList
          (tc-type-collect-regions (tc-global-shared-view b))]
        (if (tc-name-id-list-eq a-regions b-regions)
          (Ok a)
          (match a-regions
            [(Nil) (Ok b)]
            [_
              (match b-regions
                [(Nil) (Ok a)]
                [_
                  (Err
                    (tc-kind-message
                      (TypeMismatch)
                      "typecheck: if branches must match"))])])))]
    [(tc-type-coercible?
        ctx
        env
        (tc-global-shared-view a)
        (tc-global-shared-view b))
      (Ok a)]
    [(tc-type-coercible? ctx env (tc-global-shared-view b) a) (Ok b)]
    [else
      (Err (tc-kind-message (TypeMismatch) "typecheck: if branches must match"))]))

(define (tc-merge-branch-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [a : ast.AstType]
  [b : ast.AstType]) : ResultTcType
  (match (tc-merge-branch-type-raw
    ctx
    env
    (tc-global-shared-view a)
    (tc-global-shared-view b))
    [(Ok merged) (Ok merged)]
    [(Err _)
      (tc-merge-branch-type-raw
        ctx
        env
        (tc-canonicalize-inferred-type ctx a)
        (tc-canonicalize-inferred-type ctx b))]))

;; An `if` typed without an expected type joins its branches the way `match`
;; joins arms: when their types do not merge, re-check one branch with the
;; other's type as its expected type. An unconstrained literal branch thereby
;; adopts the other branch's type, so `(if c 0 n)` with `n : i64` is `i64`, as
;; `(match b [true 0] [false n])` already was (#8590). The original error stands
;; when neither re-check merges.
(define (tc-merge-if-branch-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [then-branch-id : i64]
  [else-branch-id : i64]
  [then-ty : ast.AstType]
  [else-ty : ast.AstType]) : ResultTcType
  (match (tc-merge-branch-type
    ctx
    env
    (tc-global-shared-view then-ty)
    (tc-global-shared-view else-ty))
    [(Ok merged) (Ok merged)]
    [(Err message)
      (match (tc-expr-with-expected-or-actual-id
        ctx
        env
        then-branch-id
        (tc-global-shared-view else-ty))
        [(Ok retyped-then)
          (match (tc-merge-branch-type
            ctx
            env
            retyped-then
            (tc-global-shared-view else-ty))
            [(Ok merged) (Ok merged)]
            [(Err _)
              (tc-merge-if-else-retyped ctx env else-branch-id then-ty message)])]
        [(Err _)
          (tc-merge-if-else-retyped ctx env else-branch-id then-ty message)])]))

(define (tc-merge-if-else-retyped
  [ctx : TcContext]
  [env : TcTypeEnv]
  [else-branch-id : i64]
  [then-ty : ast.AstType]
  [message : String]) : ResultTcType
  (match (tc-expr-with-expected-or-actual-id
    ctx
    env
    else-branch-id
    (tc-global-shared-view then-ty))
    [(Ok retyped-else)
      (match (tc-merge-branch-type ctx env then-ty retyped-else)
        [(Ok merged) (Ok merged)]
        [(Err _) (Err message)])]
    [(Err _) (Err message)]))

(define (tc-match-arm-merge-message
  [previous : ast.AstType]
  [current : ast.AstType]) : String
  (str_cat.str-cat
    "typecheck: match arms must agree: previous arm type "
    (tc-type-render previous)
    ", current arm type "
    (tc-type-render current)))

(define (tc-integer-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(or (I64) (I32) (I16) (I8) (U64) (U32) (U16) (U8)) true]
    [_ false]))

(define (tc-repeat-text [piece : String] [count : i64]) : String
  (let
    [out : String ""]
    [i : i64 0]
    (while (< i count)
      (set! out (str_cat.str-cat out (string.copy (& piece)) ""))
      (set! i (+ i 1)))
    out))

(define (tc-binary-ones [bits : i64]) : String
  (tc-repeat-text "1" bits))

(define (tc-binary-min-signed [bits : i64]) : String
  (str_cat.str-cat "1" (tc-repeat-text "0" (- bits 1))))

(define (tc-integer-literal-fits-positive-type?
  [text : String]
  [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(I8)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "127"
        "7f"
        (tc-binary-ones 7))]
    [(I16)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "32767"
        "7fff"
        (tc-binary-ones 15))]
    [(I32)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "2147483647"
        "7fffffff"
        (tc-binary-ones 31))]
    [(I64)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "9223372036854775807"
        "7fffffffffffffff"
        (tc-binary-ones 63))]
    [(U8)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "255"
        "ff"
        (tc-binary-ones 8))]
    [(U16)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "65535"
        "ffff"
        (tc-binary-ones 16))]
    [(U32)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "4294967295"
        "ffffffff"
        (tc-binary-ones 32))]
    [(U64)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "18446744073709551615"
        "ffffffffffffffff"
        (tc-binary-ones 64))]
    [_ false]))

(define (tc-integer-literal-fits-negative-type?
  [text : String]
  [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(I8)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "128"
        "80"
        (tc-binary-min-signed 8))]
    [(I16)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "32768"
        "8000"
        (tc-binary-min-signed 16))]
    [(I32)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "2147483648"
        "80000000"
        (tc-binary-min-signed 32))]
    [(I64)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "9223372036854775808"
        "8000000000000000"
        (tc-binary-min-signed 64))]
    [_ false]))

(define (tc-integer-literal-fits-type? [text : String] [ty : ast.AstType]) : bool
  (if (ast.ast-int-literal-negative? text)
    (tc-integer-literal-fits-negative-type? text ty)
    (tc-integer-literal-fits-positive-type? text ty)))

(define (tc-integer-literal-value-fits-type? [value : i64] [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(I8) (and (>= value -128) (<= value 127))]
    [(I16) (and (>= value -32768) (<= value 32767))]
    [(I32) (and (>= value -2147483648) (<= value 2147483647))]
    [(I64) true]
    [(U8) (and (>= value 0) (<= value 255))]
    [(U16) (and (>= value 0) (<= value 65535))]
    [(U32) (and (>= value 0) (<= value 4294967295))]
    [(U64) (>= value 0)]
    [_ false]))

(define (tc-integer-literal-fits-value-or-text?
  [value : i64]
  [text : String]
  [ty : ast.AstType]) : bool
  (if (> (string.string-length text) 0)
    (tc-integer-literal-fits-type? text ty)
    (tc-integer-literal-value-fits-type? value ty)))

(define (tc-integer-literal-range-message
  [ctx : TcContext]
  [value : i64]
  [text : String]
  [expected : ast.AstType]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (TypeMismatch))
    "typecheck: integer literal "
    (ast.ast-lit-int-text (Int value text))
    " does not fit expected type "
    (tc-type-render (tc-type-without-regions (tc-resolve-type ctx expected)))))

(define (tc-integer-literal-type-with-expected
  [ctx : TcContext]
  [value : i64]
  [text : String]
  [expected : ast.AstType]) : ResultTcType
  (let
    [resolved : ast.AstType
      (tc-type-without-regions
        (tc-resolve-type ctx (tc-global-shared-view expected)))]
    (if (tc-integer-type? (tc-global-shared-view resolved))
      (if (tc-integer-literal-fits-value-or-text?
        value
        (string.copy (& text))
        (tc-global-shared-view resolved))
        (Ok resolved)
        (Err (tc-integer-literal-range-message ctx value text expected)))
      (Ok (I32)))))

(define (tc-float-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(or (F64) (F32)) true]
    [_ false]))

;; Word-class for register-resident aggregates: a POD type that occupies
;; at most one machine word and is trivially copyable by value. Integers, bool,
;; char, and raw pointers qualify. Floats are excluded (a register-resident
;; aggregate is packed into general-purpose words). Owning handles (Box, String,
;; Array, DynArray), references, closures, tuples, and nested struct/enum fields
;; are excluded too: they would need deep-clone or multi-word handling that the
;; word-copy representation does not provide.
(define (tc-word-class-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(or (I64) (U64) (I32) (U32) (I16) (U16) (I8) (U8) (Bool) (Char) (Ptr _)
         (MutPtr _))
      true]
    [_ false]))

(define (tc-ordered-comparison-type? [ty : ast.AstType]) : bool
  (if (tc-integer-type? (tc-global-shared-view ty))
    true
    (if (tc-float-type? (tc-global-shared-view ty))
      true
      (match (tc-type-strip-region ty)
        [(Char) true]
        [_ false]))))

(define (tc-castable-type? [ty : ast.AstType]) : bool
  (if (tc-integer-type? (tc-global-shared-view ty))
    true
    (match (tc-type-strip-region ty)
      [(or (Char) (F64) (F32)) true]
      [_ false])))

(define (tc-function-to-integer-cast?
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : bool
  (match (tc-type-strip-region from-ty)
    [(Func _ _) (tc-integer-type? (tc-type-strip-region to-ty))]
    [_ false]))

(define (tc-raw-pointer-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(or (Ptr _) (MutPtr _)) true]
    [_ false]))

(define (tc-type-move-kind-copyable-type-list-at
  [ctx : TcContext]
  [types : (& types ast.AstTypeList)]
  [stack : TcNameIdList]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    true
    (and
      (tc-move-kind-copyable?
        (tc-type-move-kind-with-stack
          ctx
          (tc-context-type-get
            ctx
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))
          stack))
      (tc-type-move-kind-copyable-type-list-at ctx types stack (+ index 1)))))

(define (tc-type-move-kind-copyable-type-list?
  [ctx : TcContext]
  [types : ast.AstTypeList]
  [stack : TcNameIdList]) : bool
  (tc-type-move-kind-copyable-type-list-at ctx (& types) stack 0))

(define (tc-type-move-kind-copyable-nominal-types?
  [ctx : TcContext]
  [nominal-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [types : ast.AstTypeList]
  [stack : TcNameIdList]) : bool
  ;; Resolve declaration fields/payloads in the declaration owner's module,
  ;; then apply the use-site lifetime arguments positionally. A failed
  ;; substitution is an invalid type and therefore conservatively MoveOnly.
  (match (tc-lifetime-subst-from-nominal-args-id ctx nominal-id lifetimes)
    [(Ok subst)
      (tc-type-move-kind-copyable-type-list?
        ctx
        (tc-lifetime-subst-type-list subst types)
        stack)]
    [(Err _) false]))

(define (tc-type-move-kind-copyable-struct-fields?
  [ctx : TcContext]
  [nominal-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [fields : ast.AstFieldDefList]
  [stack : TcNameIdList]) : bool
  (tc-type-move-kind-copyable-nominal-types?
    ctx
    nominal-id
    lifetimes
    (tc-field-type-list ctx fields)
    stack))

(define (tc-type-move-kind-copyable-enum-variants-at
  [ctx : TcContext]
  [nominal-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [variants : (& variants ast.AstVariantDefList)]
  [stack : TcNameIdList]
  [index : i64]) : bool
  (if (>= index variants.len)
    true
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(Def _ payloads _)
        (and
          (tc-type-move-kind-copyable-nominal-types?
            ctx
            nominal-id
            (tc-global-shared-view lifetimes)
            (tc-resolve-type-list ctx payloads)
            stack)
          (tc-type-move-kind-copyable-enum-variants-at
            ctx
            nominal-id
            lifetimes
            variants
            stack
            (+ index 1)))])))

(define (tc-type-move-kind-copyable-enum-variants?
  [ctx : TcContext]
  [nominal-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [variants : ast.AstVariantDefList]
  [stack : TcNameIdList]) : bool
  (tc-type-move-kind-copyable-enum-variants-at
    ctx
    nominal-id
    lifetimes
    (& variants)
    stack
    0))

(define (tc-move-kind-code [kind : TcMoveKind]) : i64
  (match kind
    [(Copyable) 1]
    [(MoveOnly) 2]))

;; A declaration's top-level move kind (empty stack, no lifetime arguments) is
;; fixed for one CompilerSymbols stamp, so it is memoized beside the declaration's
;; type-handle cache slot. Recursive and lifetime-applied queries classify
;; directly: a cycle-truncated inner answer must not become the declaration's.
(define (tc-type-move-kind-nominal-with-stack
  [ctx : TcContext]
  [name-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [stack : TcNameIdList]) : TcMoveKind
  (let
    [nominal-state : TcNominalCacheState
      (tc-job-state-nominal-cache (tc-context-job-state ctx))]
    [handle : i64
      (tc-type-handle-lookup-id
        nominal-state
        (tc-context-symbols-ref (& ctx))
        name-id
        tc-type-handle-lookup-caller-move-kind)]
    (if (not (csym.compiler-symbols-handle-found? handle))
      (MoveOnly)
      (if (and
        (match stack
          [(Nil) true]
          [_ false])
        (= (tc-lifetime-list-count (& lifetimes)) 0))
        (let
          [cached : i64
            (tc-type-handle-cache-move-kind
              nominal-state
              (tc-context-symbols-ref (& ctx))
              name-id)]
          (if (= cached 1)
            (Copyable)
            (if (= cached 2)
              (MoveOnly)
              (let
                [kind : TcMoveKind
                  (tc-type-move-kind-nominal-handle
                    ctx
                    name-id
                    handle
                    lifetimes
                    stack)]
                (tc-type-handle-cache-move-kind-set!
                  nominal-state
                  (tc-context-symbols-ref (& ctx))
                  name-id
                  (tc-move-kind-code kind))
                kind))))
        (tc-type-move-kind-nominal-handle ctx name-id handle lifetimes stack)))))

(define (tc-type-move-kind-nominal-handle
  [ctx : TcContext]
  [name-id : i64]
  [handle : i64]
  [lifetimes : ast.AstLifetimeList]
  [stack : TcNameIdList]) : TcMoveKind
  (let
    [kind : i64 (csym.compiler-symbol-handle-kind handle)]
    [nominal-id : i64 (tc-nominal-owner-id-or ctx handle name-id)]
    (if (or
      (< nominal-id 0)
      (not
        (or
          (= kind (csym.compiler-symbol-kind-defstruct))
          (= kind (csym.compiler-symbol-kind-defenum)))))
      (MoveOnly)
      (if (tc-name-id-list-contains stack nominal-id)
        ;; Recursive by-value declarations are invalid layouts, but the
        ;; classifier remains total and conservative instead of recursing
        ;; forever.
        (MoveOnly)
        (let
          [owner-ctx : TcContext
            (tc-context-with-nominal-owner-index-module
              ctx
              (csym.compiler-symbol-handle-index handle))]
          (match (csym.compiler-symbols-decl-at-index
            (tc-context-symbols-ref (& owner-ctx))
            (csym.compiler-symbol-handle-index handle))
            [(Ok decl)
              (let
                [next-stack : TcNameIdList
                  (tc-name-id-list-add stack nominal-id)]
                (match decl
                  [(or (DefStruct _ _ _ cleanup fields)
                       (DefStructLifetimes _ _ _ _ cleanup fields))
                    (if (ast.ast-struct-cleanup? cleanup)
                      (MoveOnly)
                      (if (tc-type-move-kind-copyable-struct-fields?
                        owner-ctx
                        nominal-id
                        lifetimes
                        fields
                        next-stack)
                        (Copyable)
                        (MoveOnly)))]
                  [(or (DefEnum _ _ cleanup variants)
                       (DefEnumLifetimes _ _ _ cleanup variants))
                    (if (ast.ast-enum-cleanup? cleanup)
                      (MoveOnly)
                      (if (tc-type-move-kind-copyable-enum-variants?
                        owner-ctx
                        nominal-id
                        lifetimes
                        variants
                        next-stack)
                        (Copyable)
                        (MoveOnly)))]
                  [_ (MoveOnly)]))]
            [(Err _) (MoveOnly)]))))))

(define (tc-type-move-kind-with-stack
  [ctx : TcContext]
  [ty : ast.AstType]
  [stack : TcNameIdList]) : TcMoveKind
  (match (tc-resolve-type ctx ty)
    [(or (I64) (I32) (I16) (I8) (U64) (U32) (U16) (U8) (F64) (F32) (Bool) (Char)
         (Unit) (Never) (Expr) (ExprList) (Func _ _) (CFunc _ _) (Ptr _)
         (MutPtr _) (Ref _ _))
      (Copyable)]
    ;; Function values are represented by the function type only. Capturing
    ;; closures carry a separate environment and remain a later issue.
    ;; Shared references are handles and remain Copyable independent of their
    ;; referent. Mutable references are unique and therefore MoveOnly.
    [(or (Region _ inner) (Invalidate _ inner) (Array inner _))
      (tc-type-move-kind-with-stack ctx (tc-context-type-get ctx inner) stack)]
    [(Tuple elems)
      (if (tc-type-move-kind-copyable-type-list?
        ctx
        (ast.ast-type-list-box-shared-view elems)
        stack)
        (Copyable)
        (MoveOnly))]
    ;; These are owning handles or unsized/compatibility views. Their element
    ;; types do not make the value shallowly Copyable.
    [(or (Enum name) (Struct name))
      (tc-type-move-kind-nominal-with-stack
        ctx
        name
        (ast.ast-lifetime-list-new)
        stack)]
    [(EnumArgs name lifetimes)
      (tc-type-move-kind-nominal-with-stack
        ctx
        name
        (ast.ast-lifetime-list-box-shared-view lifetimes)
        stack)]
    [(StructArgs name lifetimes)
      (let
        [args : ast.AstLifetimeList
          (ast.ast-lifetime-list-box-shared-view lifetimes)]
        (if (and
          (tc-arena-nominal-name-id? name)
          (> (tc-lifetime-list-count args) 0))
          (MoveOnly)
          (tc-type-move-kind-nominal-with-stack ctx name args stack)))]
    ;; Unresolved names and invalid type variables must never accidentally
    ;; become Copyable.
    [(or (MutRef _ _) (String) (Str) (Bytes) (DynArray _) (Slice _) (Box _)
         (Var _) (VarArgs _ _))
      (MoveOnly)]))

(define (tc-type-move-kind [ctx : TcContext] [ty : ast.AstType]) : TcMoveKind
  (tc-type-move-kind-with-stack ctx ty Nil))

(define (tc-move-kind-copyable? [kind : TcMoveKind]) : bool
  (match kind
    [(Copyable) true]
    [(MoveOnly) false]))

(define (tc-type-copyable? [ctx : TcContext] [ty : ast.AstType]) : bool
  (tc-move-kind-copyable? (tc-type-move-kind ctx ty)))

(define (tc-type-move-only? [ctx : TcContext] [ty : ast.AstType]) : bool
  (not (tc-type-copyable? ctx ty)))

;; Calls implicitly reborrow direct reference arguments. In particular, a
;; mutable-reference binding remains usable after it is passed to another
;; mutable-reference parameter, matching Rust's call-site reborrow behavior.
;; Every move-only non-reference parameter consumes its argument by value.
(define (tc-call-param-moves-argument? [ctx : TcContext] [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx (tc-global-shared-view ty)))
    [(or (Ref _ _) (MutRef _ _)) false]
    [_ (tc-type-move-only? ctx ty)]))

(define (tc-raw-pointer-elem [ty : ast.AstType] [message : String]) : ResultTcType
  (match (tc-type-strip-region ty)
    [(or (Ptr elem) (MutPtr elem)) (Ok (ast.ty-node-get elem))]
    [_ (Err message)]))

(define (tc-mut-pointer-elem [ty : ast.AstType] [message : String]) : ResultTcType
  (match (tc-type-strip-region ty)
    [(MutPtr elem) (Ok (ast.ty-node-get elem))]
    [_ (Err message)]))

(define (tc-atomic-pointer-name? [name : String]) : bool
  (cbi.compiler-builtin-typecheck-atomic-pointer-name? name))

(define (tc-atomic-load-name? [name : (& name str)]) : bool
  (or (string.eq name "atomic-load") (string.eq name "volatile-load")))

(define (tc-atomic-store-name? [name : (& name str)]) : bool
  (or (string.eq name "atomic-store!") (string.eq name "volatile-store!")))

(define (tc-atomic-cas-name? [name : (& name str)]) : bool
  (string.eq name "atomic-cas!"))

(define (tc-atomic-elem-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(or (I64) (U64) (I32) (U32)) true]
    [_ false]))

(define (tc-atomic-kind-volatile? [name : String]) : bool
  (or (string.eq name "volatile-load") (string.eq name "volatile-store!")))

(define (tc-atomic-check-elem [name : String] [elem : ast.AstType]) : ResultTcType
  (let
    [resolved : ast.AstType (tc-type-strip-region elem)]
    (if (tc-atomic-elem-type? (tc-global-shared-view resolved))
      (Ok resolved)
      (Err
        (if (tc-atomic-kind-volatile? name)
          "typecheck: volatile pointer element must be i32, i64, u32, or u64"
          "typecheck: atomic pointer element must be i32, i64, u32, or u64")))))

(define (tc-atomic-pointer-elem
  [ctx : TcContext]
  [name : String]
  [ptr-ty : ast.AstType]) : ResultTcType
  (if (tc-atomic-load-name? name)
    (let
      [elem
        (try
          (tc-raw-pointer-elem
            (tc-resolve-type ctx ptr-ty)
            (str_cat.str-cat
              "typecheck: "
              (tc-global-shared-view name)
              " requires a raw pointer operand")))]
      (tc-atomic-check-elem name (tc-resolve-type ctx elem)))
    (let
      [elem
        (try
          (tc-mut-pointer-elem
            (tc-resolve-type ctx ptr-ty)
            (str_cat.str-cat
              "typecheck: "
              (tc-global-shared-view name)
              " requires a MutPtr pointer operand")))]
      (tc-atomic-check-elem name (tc-resolve-type ctx elem)))))

(define (tc-atomic-value-mismatch-message [name : String]) : String
  (if (tc-atomic-kind-volatile? name)
    (tc-kind-message (TypeMismatch) "typecheck: volatile value type mismatch")
    (tc-kind-message (TypeMismatch) "typecheck: atomic value type mismatch")))

(define (tc-atomic-load-arity-message [name : String]) : String
  (str_cat.str-cat
    (tc-kind-message (ArityMismatch) "typecheck: ")
    name
    " expects exactly one argument"))

(define (tc-atomic-update-arity-message [name : String]) : String
  (if (tc-atomic-kind-volatile? name)
    "typecheck: volatile-store! expects exactly two arguments"
    "typecheck: atomic update expects exactly two arguments"))

(define (tc-atomic-check-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [value : ast.AstExpr]
  [elem : ast.AstType]
  [message : String]) : ResultTcUnit
  (let
    [value-ty
      (try
        (tc-expr-with-expected-or-actual
          ctx
          env
          value
          (tc-global-shared-view elem)))]
    (tc-expect value-ty elem message)))

(define (tc-atomic-one-arg-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [ptr : ast.AstExpr]
  [rest : ast.AstExprList]) : ResultTcType
  (if (ast.ast-expr-list-empty? (& rest))
    (let
      [ptr-ty : ast.AstType (try (tc-expr ctx env ptr))]
      (tc-atomic-pointer-elem ctx name ptr-ty))
    (Err (tc-atomic-load-arity-message name))))

(define (tc-atomic-two-arg-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [ptr : ast.AstExpr]
  [value : ast.AstExpr]
  [rest : ast.AstExprList]) : ResultTcType
  (if (ast.ast-expr-list-empty? (& rest))
    (let
      [ptr-ty : ast.AstType (try (tc-expr ctx env ptr))]
      [elem
        (try (tc-atomic-pointer-elem ctx (tc-global-shared-view name) ptr-ty))]
      [_
        (try
          (tc-atomic-check-value
            ctx
            env
            value
            (tc-global-shared-view elem)
            (tc-atomic-value-mismatch-message (tc-global-shared-view name))))]
      (if (tc-atomic-store-name? name)
        (Ok (Unit))
        (if (string.eq name "atomic-add!")
          (Ok (Unit))
          (Ok elem))))
    (Err (tc-atomic-update-arity-message name))))

(define (tc-atomic-cas-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ptr : ast.AstExpr]
  [expected : ast.AstExpr]
  [new-value : ast.AstExpr]
  [rest : ast.AstExprList]) : ResultTcType
  (if (ast.ast-expr-list-empty? (& rest))
    (let
      [ptr-ty : ast.AstType (try (tc-expr ctx env ptr))]
      [elem : ast.AstType
        (try (tc-atomic-pointer-elem ctx "atomic-cas!" ptr-ty))]
      [_
        (try
          (tc-atomic-check-value
            ctx
            env
            expected
            (tc-global-shared-view elem)
            (tc-kind-message
              (TypeMismatch)
              "typecheck: atomic expected value type mismatch")))]
      (let
        [_
          (try
            (tc-atomic-check-value
              ctx
              env
              new-value
              (tc-global-shared-view elem)
              (tc-kind-message
                (TypeMismatch)
                "typecheck: atomic new value type mismatch")))]
        (Ok elem)))
    (Err "typecheck: atomic-cas! expects exactly three arguments")))

(define (tc-atomic-nonload-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [ptr : ast.AstExpr]
  [tail0 : ast.AstExprList]) : ResultTcType
  (if (> tail0.len 0)
    (let
      [value : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& tail0) 0 0))]
      [tail1 : ast.AstExprList (ast.ast-expr-list-tail-from-ref (& tail0) 1)]
      (if (tc-atomic-cas-name? name)
        (if (> tail1.len 0)
          (tc-atomic-cas-call
            ctx
            env
            ptr
            value
            (tc-context-expr-get ctx (ast.ast-expr-list-get (& tail1) 0 0))
            (ast.ast-expr-list-tail-from-ref (& tail1) 1))
          (Err "typecheck: atomic-cas! expects exactly three arguments"))
        (tc-atomic-two-arg-call ctx env name ptr value tail1)))
    (Err
      (if (tc-atomic-cas-name? name)
        "typecheck: atomic-cas! expects exactly three arguments"
        (tc-atomic-update-arity-message name)))))

(define (tc-atomic-pointer-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [args : ast.AstExprList]) : ResultTcType
  (let
    [_ (try (tc-require-unsafe ctx env (tc-global-shared-view name)))]
    (if (> args.len 0)
      (let
        [ptr : ast.AstExpr
          (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
        [tail0 : ast.AstExprList (ast.ast-expr-list-tail-from-ref (& args) 1)]
        (if (tc-atomic-load-name? name)
          (tc-atomic-one-arg-call ctx env name ptr tail0)
          (tc-atomic-nonload-call ctx env name ptr tail0)))
      (Err
        (if (tc-atomic-load-name? name)
          (tc-atomic-load-arity-message name)
          (if (tc-atomic-cas-name? name)
            "typecheck: atomic-cas! expects exactly three arguments"
            (tc-atomic-update-arity-message name)))))))

(define (tc-ptr-addr-of-local-lookup [env : TcTypeEnv] [name-id : i64]) : ResultTcType
  (match (tc-type-env-spine-step env)
    [(Done) (Err "typecheck: ptr-addr-of requires a local or parameter name")]
    [(Cache rest-env) (tc-ptr-addr-of-local-lookup rest-env name-id)]
    [(Bind key ty rest-env)
      (if (= key (tc-hygiene-global-boundary-id))
        (Err
          "typecheck: ptr-addr-of requires a local, parameter, or global name")
        (if (= key name-id)
          (Ok ty)
          (tc-ptr-addr-of-local-lookup rest-env name-id)))]))

(define (tc-ptr-addr-of-root-type [_ctx : TcContext] [ty : ast.AstType]) : ResultTcType
  ;; A root name selects its storage slot. That slot remains addressable when
  ;; its stored value is itself a reference; projections through the reference
  ;; are still rejected by the struct/array cases below.
  (Ok ty))

(define (tc-ptr-addr-of-place
  [ctx : TcContext]
  [env : TcTypeEnv]
  [place : ast.AstExpr]) : ResultTcType
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-segment-bases ctx)
    (& place))
    [(Var name)
      (match (tc-ptr-addr-of-local-lookup env name)
        [(Ok ty) (tc-ptr-addr-of-root-type ctx ty)]
        [(Err _)
          (let
            [ty : ast.AstType (try (tc-expr ctx env place))]
            (tc-ptr-addr-of-root-type ctx ty))])]
    [(StructGet receiver-box field)
      (let
        [receiver : ast.AstExpr (tc-context-expr-get ctx receiver-box)]
        [receiver-ty : ast.AstType
          (try (tc-ptr-addr-of-place ctx env receiver))]
        (match (tc-type-strip-region
          (tc-resolve-type ctx (tc-global-shared-view receiver-ty)))
          [(or (Struct _) (StructArgs _ _))
            (tc-struct-get-result-type-id ctx receiver-ty field)]
          [_
            (Err
              "typecheck: ptr-addr-of requires a local/parameter, dotted field, or fixed-array array-ref place")]))]
    [(TupleRef tuple-box _)
      (let
        [tuple : ast.AstExpr (tc-context-expr-get ctx tuple-box)]
        [_ (try (tc-ptr-addr-of-place ctx env tuple))]
        (tc-expr ctx env place))]
    [(ArrayRef array-box index-box)
      (let
        [index-ty : ast.AstType
          (try (tc-expr-with-expected-or-actual-id ctx env index-box (I64)))]
        (if (tc-integer-type? index-ty)
          (let
            [array : ast.AstExpr (tc-context-expr-get ctx array-box)]
            [array-ty : ast.AstType (try (tc-ptr-addr-of-place ctx env array))]
            (match (tc-type-strip-region (tc-resolve-type ctx array-ty))
              [(Array elem-ty _) (Ok (ast.ty-node-get elem-ty))]
              [(DynArray _)
                (Err
                  "typecheck: ptr-addr-of dynamic array elements are not addressable; use __tl_array-data plus ptr-offset")]
              [_
                (Err
                  "typecheck: ptr-addr-of requires a local/parameter, dotted field, or fixed-array array-ref place")]))
          (Err "typecheck: array index must be integer")))]
    [_
      (Err
        "typecheck: ptr-addr-of requires a local/parameter, dotted field, or fixed-array array-ref place")]))

(define (tc-require-unsafe [ctx : TcContext] [env : TcTypeEnv] [name : String]) : ResultTcUnit
  (if (tc-in-unsafe? env)
    (begin
      (tc-unused-unsafe-mark-current-used!
        (tc-job-state-unused-unsafe (tc-context-job-state ctx)))
      Ok)
    (Err
      (str_cat.str-cat
        (cdiag.compiler-diagnostic-typecheck-tag (UnsafeContext))
        "typecheck: "
        name
        " requires unsafe context"))))

(define (tc-dyn-array-elem-list-supported?
  [env : TcTypeEnv]
  [types : ast.AstTypeList]) : bool
  (tc-dyn-array-elem-list-supported-at? env (& types) 0))

(define (tc-dyn-array-elem-list-supported-at?
  [env : TcTypeEnv]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    true
    (if (tc-dyn-array-elem-supported?
      env
      (ast.ty-node-get
        (ast.ast-type-list-get types index (ast.ast-type-id-fallback))))
      (tc-dyn-array-elem-list-supported-at? env types (+ index 1))
      false)))

(define (tc-dyn-array-elem-supported? [env : TcTypeEnv] [ty : ast.AstType]) : bool
  (if (tc-integer-type? (tc-global-shared-view ty))
    true
    (match (tc-type-strip-region (tc-global-shared-view ty))
      [(or (Bool) (Char) (F64) (F32) (String) (Enum _) (EnumArgs _ _) (Struct _)
           (StructArgs _ _) (DynArray _))
        true]
      [(Tuple elems)
        (tc-dyn-array-elem-list-supported?
          env
          (ast.ast-type-list-box-shared-view elems))]
      [(Ref _ _)
        (tc-reference-lifetimes-visible?
          env
          (tc-type-collect-reference-lifetimes ty))]
      [_ false])))

(define (tc-spmd-varying? [class : TcSpmdClass]) : bool
  (match class
    [(Uniform) false]
    [(Varying) true]))

(define (tc-spmd-merge-class [a : TcSpmdClass] [b : TcSpmdClass]) : TcSpmdClass
  (if (tc-spmd-varying? a)
    Varying
    (if (tc-spmd-varying? b)
      Varying
      Uniform)))

(define (tc-spmd-varying-value-type-supported? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(or (I64) (U64) (I32) (U32) (I16) (U16) (I8) (U8) (F64) (F32) (Bool)) true]
    [_ false]))

(define (tc-spmd-varying-expr-type-supported? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-global-shared-view ty))
    [(or (Enum _) (EnumArgs _ _)) true]
    [_ (tc-spmd-varying-value-type-supported? ty)]))

(define (tc-spmd-varying-enum-type-supported?
  [ctx : TcContext]
  [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(or (Enum _) (EnumArgs _ _)) true]
    [(Var name)
      (match (tc-context-enum-variants-id ctx name (tc-env-key-name-text name))
        [(Ok _) true]
        [(Err _) false])]
    [_ false]))

(define (tc-spmd-lane-type-supported? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(or (I64) (U64) (I32) (U32) (I16) (U16) (I8) (U8) (F64) (F32) (Bool)) true]
    [_ false]))

(define (tc-spmd-broadcast-type-supported? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(or (I64) (U64) (I32) (U32) (F64) (F32)) true]
    [_ false]))

(define (tc-spmd-broadcast-type-message) : String
  (tc-kind-message
    (Spmd)
    "typecheck: spmd-broadcast value must have type i32, u32, i64, u64, f32, or f64; bool broadcast remains deferred"))

(define (tc-spmd-shuffle-type-message) : String
  (tc-kind-message
    (Spmd)
    "typecheck: spmd-shuffle value must have type i32, u32, i64, u64, f32, or f64; bool shuffle remains deferred"))

(define (tc-spmd-broadcast-finish
  [ctx : TcContext]
  [expr-ty : ast.AstType]
  [value-class : TcSpmdClass]
  [lane-ty : ast.AstType]
  [lane-class : TcSpmdClass]
  [lane-env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (if (tc-spmd-broadcast-type-supported?
    (tc-resolve-type ctx (tc-global-shared-view expr-ty)))
    (let
      [_
        (try
          (tc-spmd-require-uniform
            lane-class
            (tc-kind-message
              (Spmd)
              "typecheck: spmd-broadcast lane must be uniform")))]
      (let
        [_
          (try
            (tc-expect
              (tc-resolve-type ctx lane-ty)
              (I64)
              (tc-kind-message
                (Spmd)
                "typecheck: spmd-broadcast lane must have type i64")))]
        (tc-spmd-finish expr-ty value-class lane-env)))
    (Err (tc-spmd-broadcast-type-message))))

(define (tc-spmd-shuffle-finish
  [ctx : TcContext]
  [expr-ty : ast.AstType]
  [value-class : TcSpmdClass]
  [lane-ty : ast.AstType]
  [lane-env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (if (tc-spmd-broadcast-type-supported?
    (tc-resolve-type ctx (tc-global-shared-view expr-ty)))
    (let
      [_
        (try
          (tc-expect
            (tc-resolve-type ctx lane-ty)
            (I64)
            (tc-kind-message
              (Spmd)
              "typecheck: spmd-shuffle lane must have type i64")))]
      (tc-spmd-finish expr-ty value-class lane-env))
    (Err (tc-spmd-shuffle-type-message))))

(define (tc-spmd-finish
  [ty : ast.AstType]
  [class : TcSpmdClass]
  [env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (if (and
    (tc-spmd-varying? class)
    (not (tc-spmd-varying-expr-type-supported? (tc-global-shared-view ty))))
    (Err
      (str_cat.str-cat
        (cdiag.compiler-diagnostic-typecheck-tag (Spmd))
        "typecheck: foreach varying value type is not supported: "
        (tc-type-render (tc-type-strip-region ty))))
    (Ok (TcSpmdExprInfo ty class env))))

(define (tc-spmd-finish-ctx
  [ctx : TcContext]
  [ty : ast.AstType]
  [class : TcSpmdClass]
  [env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (let
    [resolved : ast.AstType (tc-resolve-type ctx ty)]
    (if (and
      (tc-spmd-varying? class)
      (tc-spmd-varying-enum-type-supported?
        ctx
        (tc-global-shared-view resolved)))
      (Ok (TcSpmdExprInfo resolved class env))
      (tc-spmd-finish resolved class env))))

(define (tc-spmd-finish-lane
  [ctx : TcContext]
  [ty : ast.AstType]
  [class : TcSpmdClass]
  [env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (let
    [resolved : ast.AstType (tc-resolve-type ctx ty)]
    [supported-enum : bool
      (tc-spmd-varying-enum-type-supported?
        ctx
        (tc-global-shared-view resolved))]
    (if (and
      (tc-spmd-varying? class)
      (not (tc-spmd-lane-type-supported? (tc-global-shared-view resolved)))
      (not supported-enum))
      (Err
        (str_cat.str-cat
          (cdiag.compiler-diagnostic-typecheck-tag (Spmd))
          "typecheck: foreach varying array lane type is not supported: "
          (tc-type-render (tc-type-strip-region resolved))))
      (if (and (tc-spmd-varying? class) supported-enum)
        (Ok (TcSpmdExprInfo resolved class env))
        (tc-spmd-finish-ctx ctx resolved class env)))))

(define (tc-spmd-cpuid-like
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : ast.AstType]
  [leaf : ast.AstExpr]
  [subleaf : ast.AstExpr]) : ResultTcSpmdExprInfo
  (let
    [leaf-info : TcSpmdExprInfo
      (try (tc-spmd-expr ctx expr-bases env spmd-env leaf))]
    (match leaf-info
      [(TcSpmdExprInfo _ leaf-class leaf-env)
        (let
          [subleaf-info : TcSpmdExprInfo
            (try (tc-spmd-expr ctx expr-bases env leaf-env subleaf))]
          (match subleaf-info
            [(TcSpmdExprInfo _ subleaf-class subleaf-env)
              (tc-spmd-finish
                expr-ty
                (tc-spmd-merge-class leaf-class subleaf-class)
                subleaf-env)]))])))

(define (tc-spmd-binding
  [name-id : i64]
  [ty : ast.AstType]
  [class : TcSpmdClass]
  [scope : TcSpmdScope]
  [role : TcSpmdRole]) : TcSpmdBinding
  (TcSpmdBinding name-id ty class scope role))

(define (tc-spmd-binding-at [bindings : u64] [index : i64]) : TcSpmdBinding
  (unsafe
    (ptr-read (ptr-offset (int->ptr bindings : (Ptr TcSpmdBinding)) index))))

(define (tc-spmd-env-binding-count [env : TcTypeEnv]) : i64
  (match (tc-type-env-spine-step env)
    [(Done) 0]
    [(Cache rest-env) (tc-spmd-env-binding-count rest-env)]
    [(Bind _ _ rest-env) (+ 1 (tc-spmd-env-binding-count rest-env))]))

(define (tc-spmd-env-fill-from-type-env
  [env : TcTypeEnv]
  [bindings : (__tl_dyn-array TcSpmdBinding)]
  [index : i64]) : unit
  (match (tc-type-env-spine-step env)
    [(Done) unit]
    [(Cache rest-env) (tc-spmd-env-fill-from-type-env rest-env bindings index)]
    [(Bind name-id ty rest-env)
      (set!
        (array-ref bindings index)
        (tc-spmd-binding name-id ty Uniform Outer Value))
      (tc-spmd-env-fill-from-type-env rest-env bindings (- index 1))]))

(define (tc-spmd-env-from-type-env [env : TcTypeEnv]) : TcSpmdEnv
  (let
    [count : i64 (tc-spmd-env-binding-count env)]
    [bindings : (__tl_dyn-array TcSpmdBinding)
      (__tl_make-array TcSpmdBinding count)]
    (tc-spmd-env-fill-from-type-env
      env
      (owned_view.compiler-owned-shared-view bindings)
      (- count 1))
    (tc-spmd-env-new bindings count)))

(define (tc-spmd-env-new
  [bindings : (__tl_dyn-array TcSpmdBinding)]
  [len : i64]) : TcSpmdEnv
  (TcSpmdEnv
    (unsafe
      (ptr->int (__tl_array-data bindings)))
    len))

(define (tc-spmd-env-len [env : TcSpmdEnv]) : i64
  env.len)

(define (tc-spmd-env-mark [env : TcSpmdEnv]) : TcSpmdEnvMark
  (TcSpmdEnvMark (tc-spmd-env-len env)))

(define (tc-spmd-env-restore [env : TcSpmdEnv] [mark : TcSpmdEnvMark]) : TcSpmdEnv
  (let
    [mark-len : i64 mark.len]
    [current-len : i64 (tc-spmd-env-len env)]
    [restored-len : i64
      (if (< mark-len 0)
        0
        (if (> mark-len current-len)
          current-len
          mark-len))]
    (TcSpmdEnv env.bindings restored-len)))

(define (tc-spmd-env-copy-bindings
  [dst : (__tl_dyn-array TcSpmdBinding)]
  [src : u64]
  [index : i64]
  [count : i64]) : unit
  (unless
    (>= index count)
    (set! (array-ref dst index) (tc-spmd-binding-at src index))
    (tc-spmd-env-copy-bindings dst src (+ index 1) count)))

(define (tc-spmd-env-bind-id
  [env : TcSpmdEnv]
  [name-id : i64]
  [ty : ast.AstType]
  [class : TcSpmdClass]
  [scope : TcSpmdScope]) : TcSpmdEnv
  (tc-spmd-env-bind-role-id env name-id ty class scope Value))

(define (tc-spmd-env-bind-role-id
  [env : TcSpmdEnv]
  [name-id : i64]
  [ty : ast.AstType]
  [class : TcSpmdClass]
  [scope : TcSpmdScope]
  [role : TcSpmdRole]) : TcSpmdEnv
  (let
    [old-len : i64 (tc-spmd-env-len env)]
    [new-len : i64 (+ old-len 1)]
    [new-bindings : (__tl_dyn-array TcSpmdBinding)
      (__tl_make-array TcSpmdBinding new-len)]
    (tc-spmd-env-copy-bindings
      (owned_view.compiler-owned-shared-view new-bindings)
      env.bindings
      0
      old-len)
    (set!
      (array-ref new-bindings old-len)
      (tc-spmd-binding name-id ty class scope role))
    (tc-spmd-env-new new-bindings new-len)))

(define (tc-spmd-env-lookup-from [bindings : u64] [index : i64] [name-id : i64]) : TcSpmdLookup
  (if (< index 0)
    Missing
    (let
      [binding : TcSpmdBinding (tc-spmd-binding-at bindings index)]
      (if (= binding.name name-id)
        (Found binding.ty binding.class binding.scope binding.role)
        (tc-spmd-env-lookup-from bindings (- index 1) name-id)))))

(define (tc-spmd-env-lookup-id [env : TcSpmdEnv] [name-id : i64]) : TcSpmdLookup
  (tc-spmd-env-lookup-from env.bindings (- (tc-spmd-env-len env) 1) name-id))

(define (tc-spmd-env-has-local-from?
  [bindings : u64]
  [index : i64]
  [name-id : i64]) : bool
  (if (< index 0)
    false
    (let
      [binding : TcSpmdBinding (tc-spmd-binding-at bindings index)]
      (if (= binding.name name-id)
        (match binding.scope
          [(Local) true]
          [(Outer) (tc-spmd-env-has-local-from? bindings (- index 1) name-id)])
        (tc-spmd-env-has-local-from? bindings (- index 1) name-id)))))

(define (tc-spmd-env-has-local-id? [env : TcSpmdEnv] [name-id : i64]) : bool
  (tc-spmd-env-has-local-from? env.bindings (- (tc-spmd-env-len env) 1) name-id))

(define (tc-spmd-env-has-outer-from?
  [bindings : u64]
  [index : i64]
  [name-id : i64]) : bool
  (if (< index 0)
    false
    (let
      [binding : TcSpmdBinding (tc-spmd-binding-at bindings index)]
      (if (= binding.name name-id)
        (match binding.scope
          [(Outer) true]
          [(Local) (tc-spmd-env-has-outer-from? bindings (- index 1) name-id)])
        (tc-spmd-env-has-outer-from? bindings (- index 1) name-id)))))

(define (tc-spmd-env-has-outer-id? [env : TcSpmdEnv] [name-id : i64]) : bool
  (tc-spmd-env-has-outer-from? env.bindings (- (tc-spmd-env-len env) 1) name-id))

(define (tc-spmd-env-local-index [bindings : u64] [index : i64] [name-id : i64]) : i64
  (if (< index 0)
    -1
    (let
      [binding : TcSpmdBinding (tc-spmd-binding-at bindings index)]
      (if (= binding.name name-id)
        (match binding.scope
          [(Local) index]
          [(Outer) (tc-spmd-env-local-index bindings (- index 1) name-id)])
        (tc-spmd-env-local-index bindings (- index 1) name-id)))))

(define (tc-spmd-env-set-local-class-id
  [env : TcSpmdEnv]
  [name-id : i64]
  [class : TcSpmdClass]) : TcSpmdEnv
  (let
    [old-len : i64 (tc-spmd-env-len env)]
    [local-index : i64
      (tc-spmd-env-local-index env.bindings (- old-len 1) name-id)]
    (if (< local-index 0)
      env
      (let
        [new-bindings : (__tl_dyn-array TcSpmdBinding)
          (__tl_make-array TcSpmdBinding old-len)]
        [old-binding : TcSpmdBinding
          (tc-spmd-binding-at env.bindings local-index)]
        (tc-spmd-env-copy-bindings
          (owned_view.compiler-owned-shared-view new-bindings)
          env.bindings
          0
          old-len)
        (set!
          (array-ref new-bindings local-index)
          (tc-spmd-binding
            old-binding.name
            old-binding.ty
            class
            old-binding.scope
            old-binding.role))
        (tc-spmd-env-new new-bindings old-len)))))

(define (tc-spmd-env-mark-outer-into
  [dst : (__tl_dyn-array TcSpmdBinding)]
  [src : u64]
  [index : i64]
  [count : i64]) : unit
  (if (>= index count)
    unit
    (let
      [binding : TcSpmdBinding (tc-spmd-binding-at src index)]
      (set!
        (array-ref dst index)
        (tc-spmd-binding
          binding.name
          binding.ty
          binding.class
          Outer
          binding.role))
      (tc-spmd-env-mark-outer-into dst src (+ index 1) count))))

(define (tc-spmd-env-mark-outer [env : TcSpmdEnv]) : TcSpmdEnv
  (let
    [old-len : i64 (tc-spmd-env-len env)]
    [new-bindings : (__tl_dyn-array TcSpmdBinding)
      (__tl_make-array TcSpmdBinding old-len)]
    (tc-spmd-env-mark-outer-into
      (owned_view.compiler-owned-shared-view new-bindings)
      env.bindings
      0
      old-len)
    (tc-spmd-env-new new-bindings old-len)))

(define (tc-spmd-env-merge-binding-class
  [left : TcSpmdBinding]
  [right-bindings : u64]
  [right-len : i64]
  [index : i64]) : TcSpmdClass
  (if (>= index right-len)
    left.class
    (let
      [right : TcSpmdBinding (tc-spmd-binding-at right-bindings index)]
      (tc-spmd-merge-class left.class right.class))))

(define (tc-spmd-env-merge-classes-into
  [dst : (__tl_dyn-array TcSpmdBinding)]
  [left-bindings : u64]
  [right-bindings : u64]
  [left-len : i64]
  [right-len : i64]
  [index : i64]) : unit
  (if (>= index left-len)
    unit
    (let
      [left : TcSpmdBinding (tc-spmd-binding-at left-bindings index)]
      (set!
        (array-ref dst index)
        (tc-spmd-binding
          left.name
          (tc-global-shared-view left.ty)
          (tc-spmd-env-merge-binding-class
            (tc-global-shared-view left)
            right-bindings
            right-len
            index)
          left.scope
          left.role))
      (tc-spmd-env-merge-classes-into
        dst
        left-bindings
        right-bindings
        left-len
        right-len
        (+ index 1)))))

(define (tc-spmd-env-merge-classes [left : TcSpmdEnv] [right : TcSpmdEnv]) : TcSpmdEnv
  (let
    [left-len : i64 (tc-spmd-env-len left)]
    [merged : (__tl_dyn-array TcSpmdBinding)
      (__tl_make-array TcSpmdBinding left-len)]
    ;; Branch merge is index-aligned: both branches start from the same
    ;; snapshot and local lets restore to that mark before the merge.
    (tc-spmd-env-merge-classes-into
      (owned_view.compiler-owned-shared-view merged)
      left.bindings
      right.bindings
      left-len
      (tc-spmd-env-len right)
      0)
    (tc-spmd-env-new merged left-len)))

;; --- foreach-active scopes (#8306) ---
;; A foreach-active body runs one lane at a time, so a varying binding from
;; outside the body is hidden there: the body reads it only through
;; lane-value. Entering the body pushes a barrier sentinel; a lane-value
;; operand pushes an opening sentinel that lifts the barrier below it again.
;; Scope never nests a body inside an operand or another body, so the
;; innermost sentinel decides.
(define tc-spmd-env-sentinel-name : i64
  -1)

(define (tc-spmd-env-push-sentinel [env : TcSpmdEnv] [role : TcSpmdRole]) : TcSpmdEnv
  (tc-spmd-env-bind-role-id
    env
    tc-spmd-env-sentinel-name
    (Unit)
    Uniform
    Local
    role))

(define (tc-spmd-env-innermost-sentinel-from [bindings : u64] [index : i64]) : TcSpmdRole
  (if (< index 0)
    Value
    (let
      [binding : TcSpmdBinding (tc-spmd-binding-at bindings index)]
      (match binding.role
        [(ActiveBarrier) ActiveBarrier]
        [(LaneValueOpen) LaneValueOpen]
        [_ (tc-spmd-env-innermost-sentinel-from bindings (- index 1))]))))

;; True inside a foreach-active body, outside any lane-value operand in it.
(define (tc-spmd-env-in-active-body? [env : TcSpmdEnv]) : bool
  (match (tc-spmd-env-innermost-sentinel-from
    env.bindings
    (- (tc-spmd-env-len env) 1))
    [(ActiveBarrier) true]
    [_ false]))

;; A value bound inside the gang that is not a scalar lane value may carry
;; per-lane state the SPMD class does not see: a closure can capture varying
;; values, and a tuple, struct, array or reference can hold such a closure. A
;; foreach-active body therefore hides every gang-local binding except scalar
;; lane values, like a varying binding: reading one there could observe the
;; lane's varying state without lane-value. Values from outside the foreach
;; are uniform and stay visible.
(define (tc-spmd-gang-local-opaque?
  [scope : TcSpmdScope]
  [ty : (& ty ast.AstType)]) : bool
  (match scope
    [(Outer) false]
    [(Local)
      (not
        (tc-spmd-lane-type-supported?
          (owned_view.compiler-owned-reference-shared-view ty)))]))

(define (tc-spmd-env-hidden-from?
  [bindings : u64]
  [index : i64]
  [name-id : i64]
  [below-barrier : bool]) : bool
  (if (< index 0)
    false
    (let
      [binding : TcSpmdBinding (tc-spmd-binding-at bindings index)]
      (match binding.role
        [(LaneValueOpen) false]
        [(ActiveBarrier)
          (tc-spmd-env-hidden-from? bindings (- index 1) name-id true)]
        [_
          (if (= binding.name name-id)
            (and
              below-barrier
              (or
                (tc-spmd-varying? binding.class)
                (tc-spmd-gang-local-opaque? binding.scope (& binding.ty))))
            (tc-spmd-env-hidden-from?
              bindings
              (- index 1)
              name-id
              below-barrier))]))))

;; True when NAME-ID resolves to a varying binding, or a gang-local value that
;; is not a scalar lane value, declared outside the innermost foreach-active
;; body. The body reads a varying binding only through lane-value and cannot
;; read such a value at all.
(define (tc-spmd-env-hidden-id? [env : TcSpmdEnv] [name-id : i64]) : bool
  (tc-spmd-env-hidden-from?
    env.bindings
    (- (tc-spmd-env-len env) 1)
    name-id
    false))

(define (tc-literal-type [lit : ast.AstLiteral]) : ast.AstType
  (match lit
    [(Int _ _) (I32)]
    [(Float _) (F64)]
    [(Bool _) (Bool)]
    [(Char _) (Char)]
    [(String _) (String)]
    [(Unit) (Unit)]))

(define (tc-param-type-list-into
  [ctx : TcContext]
  [params : (& params ast.AstParamList)]
  [index : i64]
  [out : (&mut out ast.AstTypeList)]) : unit
  (unless
    (>= index (ast.ast-param-list-len params))
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param _ ty _)
        (let
          [resolved : ast.AstType (tc-resolve-type ctx ty)]
          (ast.ast-type-list-push
            out
            (ast.ast-node-pool-reader-type-push (& resolved))))])
    (tc-param-type-list-into ctx params (+ index 1) out)))

(define (tc-param-type-list [ctx : TcContext] [params : ast.AstParamList]) : ast.AstTypeList
  (let
    [out : ast.AstTypeList
      (ast.ast-type-list-with-capacity (ast.ast-param-list-len (& params)))]
    (tc-param-type-list-into ctx (& params) 0 (&mut out))
    out))

(define (tc-macro-param-type-list-into
  [ctx : TcContext]
  [params : (& params ast.AstMacroParamList)]
  [index : i64]
  [out : (&mut out ast.AstTypeList)]) : unit
  (unless
    (>= index (ast.ast-macro-param-list-len params))
    (match (ast.ast-macro-param-list-get
      params
      index
      (ast.ast-macro-param-fallback))
      [(Param _ ty _ _)
        (ast.ast-type-list-push
          out
          (ast.ast-node-pool-reader-type-push
            (& (tc-resolve-type ctx (tc-macro-signature-type ty)))))])
    (tc-macro-param-type-list-into ctx params (+ index 1) out)))

(define (tc-macro-param-type-list
  [ctx : TcContext]
  [params : ast.AstMacroParamList]) : ast.AstTypeList
  (let
    [out : ast.AstTypeList
      (ast.ast-type-list-with-capacity
        (ast.ast-macro-param-list-len (& params)))]
    (tc-macro-param-type-list-into ctx (& params) 0 (&mut out))
    out))

(define (tc-type-list-ref [types : ast.AstTypeList] [index : i64]) : ResultTcType
  (if (or (< index 0) (>= index (ast.ast-type-list-len (& types))))
    (Err "typecheck: tuple index out of bounds")
    (Ok
      (ast.ty-node-get
        (ast.ast-type-list-get (& types) index (ast.ast-type-id-fallback))))))

(define (tc-expr-list-len [exprs : ast.AstExprList]) : i64
  exprs.len)

(define (tc-expr-list-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]) : ResultTcTypeList
  (let
    [out : ast.AstTypeList (ast.ast-type-list-new)]
    [_ (try (tc-expr-list-types-into-at ctx env (& exprs) 0 (&mut out)))]
    (Ok out)))

(define (tc-expr-list-types-into-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [out : (&mut out ast.AstTypeList)]) : ResultTcUnit
  (if (>= index exprs.len)
    Ok
    (let
      [ty (try (tc-expr-id ctx env (ast.ast-expr-list-get exprs index 0)))]
      (ast.ast-type-list-push out (ast.ast-node-pool-reader-type-push (& ty)))
      (tc-expr-list-types-into-at ctx env exprs (+ index 1) out))))

(define (tc-check-array-rest
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]
  [elem-ty : ast.AstType]) : ResultTcUnit
  (tc-check-array-rest-at ctx env (& exprs) 0 elem-ty))

(define (tc-check-array-rest-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [elem-ty : ast.AstType]) : ResultTcUnit
  (if (>= index exprs.len)
    Ok
    (let
      [ty
        (try
          (tc-expr-with-expected-or-actual-id
            ctx
            env
            (ast.ast-expr-list-get exprs index 0)
            (tc-global-shared-view elem-ty)))]
      [_
        (try
          (tc-expect
            ty
            (tc-global-shared-view elem-ty)
            "typecheck: array elements must have same type"))]
      (tc-check-array-rest-at ctx env exprs (+ index 1) elem-ty))))

(define (tc-signature-lifetime-type-list-collect-into
  [types : ast.AstTypeList]
  [skip-id : i64]
  [out : TcNameIdList]) : TcNameIdList
  (tc-signature-lifetime-type-list-collect-at (& types) skip-id 0 out))

(define (tc-signature-lifetime-type-list-collect-at
  [types : (& types ast.AstTypeList)]
  [skip-id : i64]
  [index : i64]
  [out : TcNameIdList]) : TcNameIdList
  (if (>= index (ast.ast-type-list-len types))
    out
    (tc-signature-lifetime-type-list-collect-at
      types
      skip-id
      (+ index 1)
      (tc-signature-lifetime-type-collect-into
        (ast.ty-node-get
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))
        skip-id
        out))))

(define (tc-signature-lifetime-type-collect-into
  [ty : ast.AstType]
  [skip-id : i64]
  [out : TcNameIdList]) : TcNameIdList
  ;; Nested function types introduce their own signature lifetime scope.
  (match ty
    [(Func _ _) out]
    [(Tuple elems)
      (tc-signature-lifetime-type-list-collect-into
        (ast.ast-type-list-box-shared-view elems)
        skip-id
        out)]
    [(or (Array elem _) (DynArray elem) (Box elem) (Ptr elem) (MutPtr elem)
         (Region _ elem))
      (tc-signature-lifetime-type-collect-into
        (ast.ty-node-get elem)
        skip-id
        out)]
    [(or (Ref lifetime inner) (MutRef lifetime inner)
         (Invalidate lifetime inner))
      (tc-signature-lifetime-type-collect-into
        (ast.ty-node-get inner)
        skip-id
        (if (= lifetime skip-id)
          out
          (tc-name-id-list-add out lifetime)))]
    [(or (EnumArgs _ lifetimes) (StructArgs _ lifetimes) (VarArgs _ lifetimes))
      (tc-lifetime-list-to-name-id-list-into (deref lifetimes) out)]
    [_ out]))

(define (tc-param-list-has-name-id-at?
  [params : (& params ast.AstParamList)]
  [name-id : i64]
  [index : i64]) : bool
  (if (>= index (ast.ast-param-list-len params))
    false
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param name _ _)
        (or
          (= name name-id)
          (tc-param-list-has-name-id-at? params name-id (+ index 1)))])))

(define (tc-signature-lifetime-needs-marker?
  [params : (& params ast.AstParamList)]
  [lifetime-id : i64]) : bool
  (and
    (>= lifetime-id 0)
    (not (tc-elaborated-lifetime-hidden? lifetime-id))
    (not (tc-program-lifetime-id? lifetime-id))
    (not (tc-param-list-has-name-id-at? params lifetime-id 0))))

(define (tc-bind-signature-lifetime-markers
  [env : TcTypeEnv]
  [params : (& params ast.AstParamList)]
  [lifetimes : TcNameIdList]) : TcTypeEnv
  (let
    [cursor : TcNameIdList lifetimes]
    [out : TcTypeEnv env]
    (while (not (tc-name-id-list-empty? cursor))
      (let
        [lifetime : i64 (tc-name-id-list-head cursor)]
        (if (tc-signature-lifetime-needs-marker? params lifetime)
          (set!
            out
            (tc-bind-runtime-marker-id
              out
              (tc-signature-lifetime-marker-id)
              (Var lifetime)
              Other))
          unit)
        (set! cursor (tc-name-id-list-rest cursor))))
    out))

(define (tc-type-env-scoped-carrier-bind-signature-lifetime-markers
  [carrier : TcTypeEnvScopedCarrier]
  [params : (& params ast.AstParamList)]
  [lifetimes : TcNameIdList]) : TcTypeEnvScopedCarrier
  (let
    [cursor : TcNameIdList lifetimes]
    [out : TcTypeEnvScopedCarrier carrier]
    (while (not (tc-name-id-list-empty? cursor))
      (let
        [lifetime : i64 (tc-name-id-list-head cursor)]
        (if (tc-signature-lifetime-needs-marker? params lifetime)
          (set!
            out
            (tc-type-env-scoped-carrier-with-sidecar
              (tc-global-shared-view out)
              (tc-type-env-scoped-sidecar-bind-marker-id
                out.sidecar
                (tc-signature-lifetime-marker-id)
                (Var lifetime)
                Other)))
          unit)
        (set! cursor (tc-name-id-list-rest cursor))))
    out))

(define (tc-bind-params
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : (& params ast.AstParamList)]) : TcTypeEnv
  (tc-bind-params-at ctx env (& params) 0 Nil))

(define (tc-bind-params-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : (& params ast.AstParamList)]
  [index : i64]
  [lifetimes : TcNameIdList]) : TcTypeEnv
  (if (>= index (ast.ast-param-list-len params))
    (tc-bind-invalidate-marker
      (tc-bind-signature-lifetime-markers env params lifetimes)
      params)
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param name ty _)
        (tc-bind-params-at
          ctx
          (tc-bind-id
            env
            name
            (if (tc-invalidate-types-present?)
              (tc-type-strip-invalidate
                (tc-resolve-type ctx (tc-global-shared-view ty)))
              (tc-resolve-type ctx (tc-global-shared-view ty))))
          params
          (+ index 1)
          (tc-signature-lifetime-type-collect-into ty name lifetimes))])))

;; --- `(:invalidate r T)` parameters (#6670) --------------------------------
;;
;; A function or lambda body binds its parameters as their inner types and
;; records the lifetimes they invalidate under one marker, a lifetime list of
;; (lifetime, parameter) pairs. Every later parameter list rebinds the marker,
;; so a nested lambda never inherits its enclosing function's effect. Until a
;; parameter list declares an effect, no marker is written.
(define tc-invalidate-param-bind-count : i64
  0)
(define tc-invalidate-marker-id-generation : i64
  -1)
(define tc-invalidate-marker-id-cache : i64
  -1)

(define (tc-invalidate-marker-id) : i64
  (let
    [generation : i64 (ci.intern-generation)]
    (if (= tc-invalidate-marker-id-generation generation)
      tc-invalidate-marker-id-cache
      (let
        [marker-id : i64 (ci.intern "\n__typelisp_invalidate_marker")]
        (set! tc-invalidate-marker-id-cache marker-id)
        (set! tc-invalidate-marker-id-generation generation)
        marker-id))))

;; The (lifetime, parameter) pairs of a parameter list's `:invalidate` effects.
(define (tc-param-list-invalidate-pairs [params : (& params ast.AstParamList)]) : ast.AstLifetimeList
  (let
    [out : ast.AstLifetimeList (ast.ast-lifetime-list-new)]
    [index : i64 0]
    (while (< index (ast.ast-param-list-len params))
      (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
        [(Param name ty _)
          (match (tc-type-invalidate-lifetime (tc-global-shared-view ty))
            [(Some lifetime)
              (ast.ast-lifetime-list-push (&mut out) lifetime)
              (ast.ast-lifetime-list-push (&mut out) name)]
            [(No) unit])])
      (set! index (+ index 1)))
    out))

;; The marker to bind for a parameter list, or No when none is needed.
(define (tc-invalidate-marker-type [params : (& params ast.AstParamList)]) : ast.AstMaybeType
  (unless (tc-invalidate-types-present?) (return (No)))
  (let
    [pairs : ast.AstLifetimeList (tc-param-list-invalidate-pairs params)]
    (if (ast.ast-lifetime-list-empty? (& pairs))
      (if (= tc-invalidate-param-bind-count 0)
        (No)
        (Some (ast.ast-ty-var-args (tc-invalidate-marker-id) pairs)))
      (begin
        (set!
          tc-invalidate-param-bind-count
          (+ tc-invalidate-param-bind-count 1))
        (Some (ast.ast-ty-var-args (tc-invalidate-marker-id) pairs))))))

(define (tc-bind-invalidate-marker
  [env : TcTypeEnv]
  [params : (& params ast.AstParamList)]) : TcTypeEnv
  (match (tc-invalidate-marker-type params)
    [(Some marker)
      (tc-bind-runtime-marker-id env (tc-invalidate-marker-id) marker Other)]
    [(No) env]))

;; The (lifetime, parameter) pairs the innermost enclosing function or lambda
;; body declares.
(define (tc-invalidate-marker-pairs [env : TcTypeEnv]) : ast.AstLifetimeList
  (if (= tc-invalidate-param-bind-count 0)
    (ast.ast-lifetime-list-new)
    (match (if (tc-type-env-scoped-runtime-active? env)
      (tc-type-env-scoped-carrier-marker-type
        (tc-type-env-scoped-runtime-current env)
        (tc-invalidate-marker-id))
      (tc-env-marker-type env (tc-invalidate-marker-id)))
      [(Some (VarArgs _ pairs)) (ast.ast-lifetime-list-box-shared-view pairs)]
      [_ (ast.ast-lifetime-list-new)])))

;; Whether the enclosing body declares `(:invalidate lifetime)` on a parameter,
;; which lets it destroy the owner of that brand.
(define (tc-invalidate-lifetime-declared? [env : TcTypeEnv] [lifetime : i64]) : bool
  (let
    [pairs : ast.AstLifetimeList (tc-invalidate-marker-pairs env)]
    [index : i64 0]
    [found : bool false]
    (while (and (not found) (< index (ast.ast-lifetime-list-len (& pairs))))
      (if (=
        (ast.ast-lifetime-list-get (& pairs) index (ast.ast-lifetime-fallback))
        lifetime)
        (set! found true)
        unit)
      (set! index (+ index 2)))
    found))

(define (tc-type-env-scoped-carrier-bind-params
  [ctx : TcContext]
  [carrier : TcTypeEnvScopedCarrier]
  [params : (& params ast.AstParamList)]) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-bind-params-at ctx carrier (& params) 0 Nil))

(define (tc-type-env-scoped-carrier-bind-params-at
  [ctx : TcContext]
  [carrier : TcTypeEnvScopedCarrier]
  [params : (& params ast.AstParamList)]
  [index : i64]
  [lifetimes : TcNameIdList]) : TcTypeEnvScopedCarrier
  (if (>= index (ast.ast-param-list-len params))
    (let
      [out : TcTypeEnvScopedCarrier
        (tc-type-env-scoped-carrier-bind-signature-lifetime-markers
          carrier
          params
          lifetimes)]
      (match (tc-invalidate-marker-type params)
        [(Some marker)
          (tc-type-env-scoped-carrier-with-sidecar
            (tc-global-shared-view out)
            (tc-type-env-scoped-sidecar-bind-marker-id
              out.sidecar
              (tc-invalidate-marker-id)
              marker
              Other))]
        [(No) out]))
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param name ty _)
        (tc-type-env-scoped-carrier-bind-params-at
          ctx
          (tc-type-env-scoped-carrier-bind-id
            carrier
            name
            (if (tc-invalidate-types-present?)
              (tc-type-strip-invalidate
                (tc-resolve-type ctx (tc-global-shared-view ty)))
              (tc-resolve-type ctx (tc-global-shared-view ty))))
          params
          (+ index 1)
          (tc-signature-lifetime-type-collect-into ty name lifetimes))])))

(define (tc-bind-macro-params
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : (& params ast.AstMacroParamList)]) : TcTypeEnv
  (tc-bind-macro-params-at ctx env (& params) 0))

(define (tc-bind-macro-params-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : (& params ast.AstMacroParamList)]
  [index : i64]) : TcTypeEnv
  (if (>= index (ast.ast-macro-param-list-len params))
    env
    (match (ast.ast-macro-param-list-get
      params
      index
      (ast.ast-macro-param-fallback))
      [(Param name ty variadic _)
        (tc-bind-macro-params-at
          ctx
          (tc-bind-id
            env
            name
            (cond
              [(tc-macro-type-param-kind? (tc-global-shared-view ty)) (Expr)]
              [(tc-macro-module-param-kind? (tc-global-shared-view ty))
                (String)]
              [(and
                  variadic
                  (tc-macro-expr-clause-type?
                    (tc-resolve-type
                      ctx
                      (tc-macro-signature-type (tc-global-shared-view ty)))))
                (tc-macro-expr-clause-list-type)]
              [(and
                  variadic
                  (tc-macro-expr-binding-clause-type?
                    (tc-resolve-type
                      ctx
                      (tc-macro-signature-type (tc-global-shared-view ty)))))
                (tc-macro-expr-binding-clause-list-type)]
              [(tc-macro-expr-clause-type?
                  (tc-resolve-type
                    ctx
                    (tc-macro-signature-type (tc-global-shared-view ty))))
                (tc-macro-expr-clause-type)]
              [(tc-macro-expr-binding-clause-type?
                  (tc-resolve-type ctx (tc-macro-signature-type ty)))
                (tc-macro-expr-binding-clause-type)]
              [variadic (ExprList)]
              [else (Expr)]))
          params
          (+ index 1))])))

(define (tc-ctfe-env-extend-macro-params
  [ctx : TcContext]
  [env : ctfe_support.CtfeEnv]
  [params : ast.AstMacroParamList]) : ctfe_support.CtfeEnv
  (tc-ctfe-env-extend-macro-params-at ctx env (& params) 0))

(define (tc-ctfe-env-extend-macro-params-at
  [ctx : TcContext]
  [env : ctfe_support.CtfeEnv]
  [params : (& params ast.AstMacroParamList)]
  [index : i64]) : ctfe_support.CtfeEnv
  (if (>= index (ast.ast-macro-param-list-len params))
    env
    (match (ast.ast-macro-param-list-get
      params
      index
      (ast.ast-macro-param-fallback))
      [(Param name ty variadic _)
        (tc-ctfe-env-extend-macro-params-at
          ctx
          (ctfe_support.ctfe-env-extend-id
            env
            name
            (cond
              [(tc-macro-type-param-kind? (tc-global-shared-view ty))
                (Type (Var name))]
              [(tc-macro-module-param-kind? (tc-global-shared-view ty))
                (String "" cbi.compiler-builtin-id-fix-empty)]
              [(and
                  variadic
                  (tc-macro-expr-clause-type?
                    (tc-resolve-type
                      ctx
                      (tc-macro-signature-type (tc-global-shared-view ty)))))
                (ExprClauseList (ast.ast-expr-clause-list-new))]
              [(and
                  variadic
                  (tc-macro-expr-binding-clause-type?
                    (tc-resolve-type
                      ctx
                      (tc-macro-signature-type (tc-global-shared-view ty)))))
                (ExprBindingClauseList (ast.ast-expr-binding-clause-list-new))]
              [variadic (ExprList (ast.ast-expr-list-new))]
              [(tc-macro-expr-clause-type?
                  (tc-resolve-type
                    ctx
                    (tc-macro-signature-type (tc-global-shared-view ty))))
                (ExprClause
                  (ast.ast-expr-clause
                    (ast.ast-node-pool-context-expr-push
                      (tc-context-pools ctx)
                      (Var
                        (tc-generated-name-id
                          (str_cat.str-cat (tc-env-key-name-text name) "$first"))))
                    (ast.ast-node-pool-context-expr-push
                      (tc-context-pools ctx)
                      (Var
                        (tc-generated-name-id
                          (str_cat.str-cat
                            (tc-env-key-name-text name)
                            "$second"))))))]
              [(tc-macro-expr-binding-clause-type?
                  (tc-resolve-type
                    ctx
                    (tc-macro-signature-type (tc-global-shared-view ty))))
                (let
                  [unit-expr : i64
                    (ast.ast-node-pool-context-expr-push
                      (tc-context-pools ctx)
                      (Literal (Unit)))]
                  (ExprBindingClause
                    (ast.ast-expr-binding-clause-id
                      (ci.intern-syntax-id-from-raw name)
                      false
                      unit-expr
                      (ast.ast-node-pool-context-expr-push
                        (tc-context-pools ctx)
                        (Var
                          (tc-generated-name-id
                            (str_cat.str-cat
                              (tc-env-key-name-text name)
                              "$init"))))
                      (ctfe_support.ctfe-untyped-expr-type)
                      (ast.ast-source-span 0 0 0 0))))]
              [else
                (Expr
                  (ast.ast-node-pool-context-expr-push
                    (tc-context-pools ctx)
                    (Var name))
                  (tc-resolve-type ctx (tc-macro-signature-type ty)))]))
          params
          (+ index 1))])))

(define (tc-dispatch-isa-eq? [a : ast.AstDispatchIsa] [b : ast.AstDispatchIsa]) : bool
  (match a
    [(Scalar)
      (match b
        [(Scalar) true]
        [_ false])]
    [(Avx2)
      (match b
        [(Avx2) true]
        [_ false])]
    [(Avx512)
      (match b
        [(Avx512) true]
        [_ false])]))

(define (tc-dispatch-variant-list-contains-isa-from?
  [variants : (& variants ast.AstDispatchVariantList)]
  [index : i64]
  [isa : ast.AstDispatchIsa]) : bool
  (if (>= index variants.len)
    false
    (match (ast.ast-dispatch-variant-list-get
      variants
      index
      (ast.ast-dispatch-variant-fallback))
      [(Variant found-isa _)
        (if (tc-dispatch-isa-eq? found-isa isa)
          true
          (tc-dispatch-variant-list-contains-isa-from? variants (+ index 1) isa))])))

(define (tc-dispatch-variant-list-duplicate-isa-from?
  [variants : (& variants ast.AstDispatchVariantList)]
  [index : i64]) : bool
  (if (>= index variants.len)
    false
    (match (ast.ast-dispatch-variant-list-get
      variants
      index
      (ast.ast-dispatch-variant-fallback))
      [(Variant isa _)
        (or
          (tc-dispatch-variant-list-contains-isa-from? variants (+ index 1) isa)
          (tc-dispatch-variant-list-duplicate-isa-from? variants (+ index 1)))])))

(define (tc-dispatch-variant-list-duplicate-isa?
  [variants : (& variants ast.AstDispatchVariantList)]) : bool
  (tc-dispatch-variant-list-duplicate-isa-from? (& variants) 0))

(define (tc-dispatch-variant-list-scalar-count-from
  [variants : (& variants ast.AstDispatchVariantList)]
  [index : i64]
  [count : i64]) : i64
  (if (>= index variants.len)
    count
    (match (ast.ast-dispatch-variant-list-get
      variants
      index
      (ast.ast-dispatch-variant-fallback))
      [(Variant isa _)
        (tc-dispatch-variant-list-scalar-count-from
          variants
          (+ index 1)
          (+
            count
            (match isa
              [(Scalar) 1]
              [_ 0])))])))

(define (tc-dispatch-variant-list-scalar-count
  [variants : (& variants ast.AstDispatchVariantList)]) : i64
  (tc-dispatch-variant-list-scalar-count-from (& variants) 0 0))

(define (tc-dispatch-symbol-key-id [ctx : TcContext] [name : i64]) : i64
  (if (tc-name-qualified-id? (tc-context-structural-session ctx) name)
    (csym.compiler-symbol-name-id-key name)
    (csym.compiler-symbol-module-key-id-by-id (tc-context-module-id ctx) name)))

(define (tc-dispatch-variant-non-function-message [name : i64]) : String
  (str_cat.str-cat
    "typecheck: defdispatch variant is not a function "
    (tc-env-key-name-text name)))

(define (tc-dispatch-variant-type
  [ctx : TcContext]
  [dispatch-name : i64]
  [variant-name : i64]) : ResultTcType
  (let
    [logical-key : i64 (tc-dispatch-symbol-key-id ctx dispatch-name)]
    [lookup-key : i64 (tc-dispatch-symbol-key-id ctx variant-name)]
    (if (= lookup-key logical-key)
      (Err "typecheck: defdispatch cannot use itself as a variant")
      (let
        [module-id : i64 (tc-context-module-id ctx)]
        [symbols-ctx : TcContext ctx]
        [handle : i64
          (if (tc-name-qualified-id?
            (tc-context-structural-session ctx)
            variant-name)
            (csym.compiler-symbols-lookup-value-id-or
              (tc-context-symbols symbols-ctx)
              variant-name
              (csym.compiler-symbols-missing-handle))
            (csym.compiler-symbols-lookup-value-in-module-id-or
              (tc-context-symbols symbols-ctx)
              module-id
              variant-name
              (csym.compiler-symbols-missing-handle)))]
        (if (csym.compiler-symbols-handle-found? handle)
          (let
            [kind : i64 (csym.compiler-symbol-handle-kind handle)]
            (if (= kind (csym.compiler-symbol-kind-defdispatch))
              (Err "typecheck: defdispatch variant cannot be another dispatch")
              (if (or
                (= kind (csym.compiler-symbol-kind-function-define))
                (= kind (csym.compiler-symbol-kind-extern)))
                (let
                  [decl : ast.AstDecl
                    (try
                      (csym.compiler-symbols-decl-at-index
                        (tc-context-symbols symbols-ctx)
                        (csym.compiler-symbol-handle-index handle)))]
                  [ty : ast.AstType (try (tc-top-decl-type ctx decl))]
                  (match (tc-global-shared-view ty)
                    [(Func _ _) (Ok ty)]
                    [_
                      (Err
                        (tc-dispatch-variant-non-function-message variant-name))]))
                (Err (tc-dispatch-variant-non-function-message variant-name)))))
          (Err
            (str_cat.str-cat
              "typecheck: unknown defdispatch variant "
              (ci.intern-str variant-name))))))))

(define (tc-dispatch-variant-signatures-from
  [ctx : TcContext]
  [dispatch-name : i64]
  [variants : (& variants ast.AstDispatchVariantList)]
  [index : i64]
  [expected : ast.AstMaybeType]) : ResultTcType
  (if (>= index variants.len)
    (match expected
      [(Some ty) (Ok ty)]
      [(No) (Err "typecheck: defdispatch has no variants")])
    (match (ast.ast-dispatch-variant-list-get
      variants
      index
      (ast.ast-dispatch-variant-fallback))
      [(Variant _ variant-name)
        (let
          [ty : ast.AstType
            (try (tc-dispatch-variant-type ctx dispatch-name variant-name))]
          (match (tc-global-shared-view expected)
            [(No)
              (tc-dispatch-variant-signatures-from
                ctx
                dispatch-name
                variants
                (+ index 1)
                (Some ty))]
            [(Some want)
              (if (tc-type-eq ty want)
                (tc-dispatch-variant-signatures-from
                  ctx
                  dispatch-name
                  variants
                  (+ index 1)
                  expected)
                (Err "typecheck: defdispatch variant signatures must match"))]))])))

(define (tc-dispatch-variant-signatures
  [ctx : TcContext]
  [dispatch-name : i64]
  [variants : ast.AstDispatchVariantList]
  [expected : ast.AstMaybeType]) : ResultTcType
  (tc-dispatch-variant-signatures-from
    ctx
    dispatch-name
    (& variants)
    0
    expected))

(define (tc-dispatch-decl-type
  [ctx : TcContext]
  [name : i64]
  [variants : ast.AstDispatchVariantList]) : ResultTcType
  (if (!= (tc-dispatch-variant-list-scalar-count variants) 1)
    (Err "typecheck: defdispatch requires exactly one scalar variant")
    (if (tc-dispatch-variant-list-duplicate-isa? variants)
      (Err "typecheck: duplicate defdispatch ISA variant")
      (tc-dispatch-variant-signatures ctx name variants No))))

(define (tc-top-decl-type [ctx : TcContext] [decl : ast.AstDecl]) : ResultTcType
  (match decl
    [(Def decl-meta _ maybe-ty expr-box)
      (let
        [expr : ast.AstExpr (tc-context-expr-get ctx expr-box)]
        (match maybe-ty
          [(Some ty) (Ok (tc-resolve-type ctx ty))]
          [(No)
            (match (ast.ast-expr-unspan-with-segment-bases
              (tc-context-expr-segment-bases ctx)
              (& expr))
              [(Literal lit) (Ok (tc-literal-type lit))]
              [(Ann _ ty-id) (Ok (tc-resolve-type ctx (ast.ty-node-get ty-id)))]
              [_ (Err "typecheck: top-level value requires annotation")])]))]
    [(DefFn decl-meta _ params ret _ _)
      (let
        [signature
          (try
            (tc-elide-function-signature (tc-context-type-bases ctx) params ret))]
        (Ok
          (ast.ast-ty-func
            (tc-param-type-list ctx signature.params)
            (& (tc-resolve-type ctx signature.ret)))))]
    [(Extern decl-meta _ _ _ ty) (Ok (tc-resolve-type ctx ty))]
    [(DefDispatch decl-meta name variants)
      (tc-dispatch-decl-type ctx name variants)]
    [(Unsafe inner-box)
      (let
        [inner : ast.AstDecl (ast.ast-decl-box-shared-view inner-box)]
        (tc-top-decl-type ctx inner))]
    [_ (Err "typecheck: declaration has no value type")]))

;; Like `tc-top-decl-type`, but infers an un-annotated top-level `define`'s type
;; from its initializer expression when it is neither a literal nor an annotated
;; expression. The `env` carries the bindings of all preceding declarations
;; (functions, enum/struct constructors, earlier globals), so a global such as
;; `(define result (factorial 5))` or `(define pair (Pair 10 11))` resolves
;; through the ordinary expression typechecker instead of demanding an
;; annotation. This mirrors the former Rust typechecker, whose first pass over
;; the declarations runs `check_expr(value)` for an un-annotated `Decl::Def`.
(define (tc-top-decl-type-with-env
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decl : ast.AstDecl]) : ResultTcType
  (match (tc-global-shared-view decl)
    [(Def decl-meta _ maybe-ty expr-box)
      (let
        [expr : ast.AstExpr (tc-context-expr-get ctx expr-box)]
        (match maybe-ty
          [(Some ty) (Ok (tc-resolve-type ctx ty))]
          [(No)
            (match (ast.ast-expr-unspan-with-segment-bases
              (tc-context-expr-segment-bases ctx)
              (& expr))
              [(Literal lit) (Ok (tc-literal-type lit))]
              [(Ann _ ty-id) (Ok (tc-resolve-type ctx (ast.ty-node-get ty-id)))]
              [_ (tc-expr ctx env expr)])]))]
    [_ (tc-top-decl-type ctx decl)]))

(define (tc-field-type-list [ctx : TcContext] [fields : ast.AstFieldDefList]) : ast.AstTypeList
  (tc-field-type-list-at ctx (& fields) 0))

(define (tc-field-type-list-at
  [ctx : TcContext]
  [fields : (& fields ast.AstFieldDefList)]
  [index : i64]) : ast.AstTypeList
  (if (>= index (ast.ast-field-def-list-len fields))
    (ast.ast-type-list-new)
    (match (ast.ast-field-def-list-get
      fields
      index
      (ast.ast-field-def-fallback))
      [(Def _ ty _)
        (ast.ast-type-cons
          (& (tc-resolve-type ctx ty))
          (& (tc-field-type-list-at ctx fields (+ index 1))))])))

(define (tc-tag-regions [regions : TcNameIdList] [ty : ast.AstType]) : ast.AstType
  (if (tc-name-id-list-empty? regions)
    ty
    (tc-tag-region
      (tc-name-id-list-head regions)
      (tc-tag-regions (tc-name-id-list-rest regions) ty))))

(define (tc-tag-type-list-regions
  [regions : TcNameIdList]
  [types : ast.AstTypeList]) : ast.AstTypeList
  (tc-tag-type-list-regions-at regions (& types) 0))

(define (tc-tag-type-list-regions-at
  [regions : TcNameIdList]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ast.AstTypeList
  (if (>= index (ast.ast-type-list-len types))
    (ast.ast-type-list-new)
    (ast.ast-type-cons
      (&
        (tc-tag-regions
          regions
          (ast.ty-node-get
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))))
      (& (tc-tag-type-list-regions-at regions types (+ index 1))))))

(define (tc-project-type-list-from-region-container
  [container-ty : ast.AstType]
  [types : ast.AstTypeList]) : ast.AstTypeList
  (tc-project-type-list-from-region-container-at container-ty (& types) 0))

(define (tc-project-type-list-from-region-container-at
  [container-ty : ast.AstType]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ast.AstTypeList
  (if (>= index (ast.ast-type-list-len types))
    (ast.ast-type-list-new)
    (ast.ast-type-cons
      (&
        (tc-project-from-region-container
          (tc-global-shared-view container-ty)
          (ast.ty-node-get
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))))
      (&
        (tc-project-type-list-from-region-container-at
          container-ty
          types
          (+ index 1))))))

(define (tc-enum-variant-constructor-type-id
  [ctx : TcContext]
  [enum-name-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [fields : ast.AstTypeList]) : ast.AstType
  (let
    [ret : ast.AstType
      (if (ast.ast-lifetime-list-empty? (& lifetimes))
        (Enum enum-name-id)
        (ast.ast-ty-enum-args enum-name-id lifetimes))]
    (if (ast.ast-type-list-empty? (& fields))
      ret
      ;; Variant field spellings belong to the enum declaration's module.
      ;; Generated modules can construct an imported enum, so resolving in the
      ;; caller would give nominal payloads a different canonical identity than
      ;; the same fields used by match-pattern binding.
      (ast.ast-ty-func
        (tc-resolve-type-list
          (tc-context-with-owner-name-module ctx enum-name-id)
          fields)
        (& ret)))))

(define (tc-bind-enum-variants-in-module-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [module-id : i64]
  [enum-name-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [variants : ast.AstVariantDefList]) : ResultTcEnv
  (tc-bind-enum-variants-in-module-id-at
    ctx
    env
    module-id
    enum-name-id
    lifetimes
    (& variants)
    0))

(define (tc-bind-enum-variants-in-module-id-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [module-id : i64]
  [enum-name-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [variants : (& variants ast.AstVariantDefList)]
  [index : i64]) : ResultTcEnv
  (if (>= index variants.len)
    (Ok env)
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(Def name fields _)
        (let
          [scoped-enum-id : i64
            (tc-module-name-id-by-id module-id enum-name-id)]
          [constructor-ty : ast.AstType
            (tc-enum-variant-constructor-type-id
              ctx
              scoped-enum-id
              (tc-global-shared-view lifetimes)
              fields)]
          (ctfe_support.ctfe-module-value-add-id-for-state!
            (tc-context-ctfe-macro-state ctx)
            module-id
            name
            (tc-global-shared-view constructor-ty))
          (tc-bind-enum-variants-in-module-id-at
            ctx
            (tc-bind-alias-id-if-free
              env
              (tc-module-name-id-by-id module-id name)
              constructor-ty)
            module-id
            enum-name-id
            lifetimes
            variants
            (+ index 1)))])))

(define (tc-build-top-env-list
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [env : TcTypeEnv]) : ResultTcEnv
  (tc-build-top-env-list-explicit-in-module
    ctx
    decls
    env
    ""
    cbi.compiler-builtin-id-fix-empty))

;; An explicit top-env build creates one cache at its result boundary. Applying
;; the function-body 32-bind compaction policy while the spine is still growing
;; repeatedly copies the whole prefix (and every cache payload array), turning a
;; large package top-env build into quadratic work. Nested module bodies call the
;; raw list helper and inherit this outer scope.
(define (tc-build-top-env-list-explicit-in-module
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [env : TcTypeEnv]
  [module : String]
  [module-id : i64]) : ResultTcEnv
  (let
    [state : TcTopEnvMembershipState
      (tc-job-state-topenv-membership (tc-context-job-state ctx))]
    [saved-env-state : TcTopEnvMembershipState
      (tc-type-env-topenv-membership-state env)]
    [saved : bool (tc-topenv-explicit-build-active? state)]
    (tc-type-env-set-topenv-membership-state! env state)
    (tc-topenv-membership-set-explicit-build-active! state true)
    (match (tc-build-top-env-list-in-module ctx decls env module module-id)
      [(Ok next-env)
        (tc-topenv-membership-set-explicit-build-active! state saved)
        (tc-type-env-set-topenv-membership-state! next-env saved-env-state)
        (Ok next-env)]
      [(Err message)
        (tc-topenv-membership-set-explicit-build-active! state saved)
        (tc-type-env-set-topenv-membership-state! env saved-env-state)
        (Err message)])))

(define (tc-build-top-env-bind-decl-in-module
  [ctx : TcContext]
  [env : TcTypeEnv]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]) : ResultTcEnv
  (match (tc-global-shared-view decl)
    [(ModuleBody name body-box)
      (let
        [module : String (tc-env-key-name-text name)]
        (tc-build-top-env-list-in-module
          ctx
          (ast.ast-decl-list-box-shared-view body-box)
          env
          module
          name))]
    [(Unsafe inner-box)
      (let
        [inner : ast.AstDecl (ast.ast-decl-box-shared-view inner-box)]
        (match (tc-global-shared-view inner)
          [(DefFn decl-meta name _ _ _ _)
            (let
              [ty : ast.AstType
                (try
                  (tc-top-decl-type
                    (tc-context-with-module-id ctx module module-id)
                    inner))]
              (ctfe_support.ctfe-module-value-add-id-for-state!
                (tc-context-ctfe-macro-state ctx)
                module-id
                name
                (tc-global-shared-view ty))
              (Ok
                (tc-bind-unsafe-id
                  env
                  (tc-module-name-id-by-id module-id name)
                  ty)))]
          [(Extern decl-meta name kind _ _)
            (let
              [extern-ctx : TcContext
                (tc-context-with-module-id ctx module module-id)]
              [ty : ast.AstType (try (tc-top-decl-type extern-ctx inner))]
              (ctfe_support.ctfe-module-value-add-id-for-state!
                (tc-context-ctfe-macro-state ctx)
                module-id
                name
                (tc-global-shared-view ty))
              (Ok
                (tc-bind-unsafe-id
                  env
                  (tc-module-name-id-by-id module-id name)
                  ty)))]
          [_ (Ok env)]))]
    [(Def decl-meta name _ _)
      (let
        [ty : ast.AstType
          (try
            (tc-top-decl-type-with-env
              (tc-context-with-module-id ctx module module-id)
              env
              decl))]
        (ctfe_support.ctfe-module-value-add-id-for-state!
          (tc-context-ctfe-macro-state ctx)
          module-id
          name
          (tc-global-shared-view ty))
        (Ok (tc-bind-id env (tc-module-name-id-by-id module-id name) ty)))]
    [(or (DefFn _ name _ _ _ _) (DefDispatch _ name _))
      (let
        [ty : ast.AstType
          (try
            (tc-top-decl-type
              (tc-context-with-module-id ctx module module-id)
              decl))]
        (ctfe_support.ctfe-module-value-add-id-for-state!
          (tc-context-ctfe-macro-state ctx)
          module-id
          name
          (tc-global-shared-view ty))
        (Ok (tc-bind-id env (tc-module-name-id-by-id module-id name) ty)))]
    [(Extern decl-meta name kind _ _)
      (let
        [extern-ctx : TcContext
          (tc-context-with-module-id ctx module module-id)]
        [ty : ast.AstType (try (tc-top-decl-type extern-ctx decl))]
        (ctfe_support.ctfe-module-value-add-id-for-state!
          (tc-context-ctfe-macro-state ctx)
          module-id
          name
          (tc-global-shared-view ty))
        (Ok (tc-bind-id env (tc-module-name-id-by-id module-id name) ty)))]
    [(DefEnum decl-meta name cleanup variants)
      (let
        [enum-ty : ast.AstType (Enum (tc-module-name-id-by-id module-id name))]
        [with-variants : TcTypeEnv
          (try
            (tc-bind-enum-variants-in-module-id
              (tc-context-with-module-id ctx module module-id)
              env
              module-id
              name
              (ast.ast-lifetime-list-new)
              variants))]
        (Ok
          (tc-bind-enum-cleanup-module-id
            with-variants
            module-id
            cleanup
            enum-ty)))]
    [(DefEnumLifetimes decl-meta name lifetimes cleanup variants)
      (let
        [enum-ty : ast.AstType
          (ast.ast-ty-enum-args
            (tc-module-name-id-by-id module-id name)
            (tc-global-shared-view lifetimes))]
        [with-variants : TcTypeEnv
          (try
            (tc-bind-enum-variants-in-module-id
              (tc-context-with-module-id ctx module module-id)
              env
              module-id
              name
              lifetimes
              variants))]
        (Ok
          (tc-bind-enum-cleanup-module-id
            with-variants
            module-id
            cleanup
            enum-ty)))]
    [(DefStruct decl-meta name _ cleanup fields)
      (let
        [struct-ty : ast.AstType
          (Struct (tc-module-name-id-by-id module-id name))]
        [constructor-ty : ast.AstType
          (ast.ast-ty-func
            (tc-field-type-list
              (tc-context-with-module-id ctx module module-id)
              fields)
            (& struct-ty))]
        (ctfe_support.ctfe-module-value-add-id-for-state!
          (tc-context-ctfe-macro-state ctx)
          module-id
          name
          (tc-global-shared-view constructor-ty))
        (Ok
          (tc-bind-struct-cleanup-module-id
            (tc-bind-id
              env
              (tc-module-name-id-by-id module-id name)
              constructor-ty)
            module-id
            cleanup
            struct-ty)))]
    [(DefStructLifetimes decl-meta name lifetimes _ cleanup fields)
      (let
        [struct-ty : ast.AstType
          (ast.ast-ty-struct-args
            (tc-module-name-id-by-id module-id name)
            lifetimes)]
        [constructor-ty : ast.AstType
          (ast.ast-ty-func
            (tc-field-type-list
              (tc-context-with-module-id ctx module module-id)
              fields)
            (& struct-ty))]
        (ctfe_support.ctfe-module-value-add-id-for-state!
          (tc-context-ctfe-macro-state ctx)
          module-id
          name
          (tc-global-shared-view constructor-ty))
        (Ok
          (tc-bind-struct-cleanup-module-id
            (tc-bind-id
              env
              (tc-module-name-id-by-id module-id name)
              constructor-ty)
            module-id
            cleanup
            struct-ty)))]
    [(or (Module _) (DefMacro _ _ _ _ _) (Import _ _) (IncludeStr _ _)
         (IncludeStrComptime _ _) (IncludeStrLzss _ _) (IncludeBin _ _)
         (Test _ _ _ _))
      (Ok env)]))

(define (tc-build-top-env-list-in-module
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [env : TcTypeEnv]
  [module : String]
  [module-id : i64]) : ResultTcEnv
  ;; Index cursor rather than `ast-decl-list-step`: the module arm reads one id
  ;; out of the row and the bind arm hands the row on, so the step result's
  ;; 144 B and its row copy are pure overhead. The early exit on the first Err
  ;; is preserved by stopping the loop with `ok`.
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [decl-offset : i64 decls.offset]
    [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
    [index : i64 0]
    [current-env : TcTypeEnv env]
    [current-module : String module]
    [current-module-id : i64 module-id]
    [message : String ""]
    [ok : bool true]
    (while (and ok (< index count))
      (match (ast.ast-decl-list-ref-borrowed (& decls) index)
        [(Module _)
          (let
            [next-module : i64
              (ast.ast-decl-list-module-id-at
                (& decls)
                index
                cbi.compiler-builtin-id-fix-empty)]
            (set! current-module (tc-env-key-name-text next-module))
            (set! current-module-id next-module))]
        [_
          (match (tc-build-top-env-bind-decl-in-module
            ctx
            current-env
            (tc-global-shared-view current-module)
            current-module-id
            (ast.ast-array-shared-view decl-slots (+ decl-offset index)))
            [(Ok next-env) (set! current-env next-env)]
            [(Err step-message)
              (set! message step-message)
              (set! ok false)])])
      (set! index (+ index 1)))
    (if (string.eq message "")
      (Ok current-env)
      (Err message))))

(define (tc-bind-enum-variant-aliases
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [enum-name-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [variants : ast.AstVariantDefList]) : TcTypeEnv
  (tc-bind-enum-variant-aliases-at
    ctx
    env
    alias-id
    importer-module-id
    source-module-id
    import-unqualified
    enum-name-id
    lifetimes
    (& variants)
    0))

(define (tc-bind-enum-variant-aliases-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [enum-name-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [variants : (& variants ast.AstVariantDefList)]
  [index : i64]) : TcTypeEnv
  (if (>= index variants.len)
    env
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(Def name fields _)
        (let
          [constructor-ty : ast.AstType
            (tc-enum-variant-constructor-type-id
              ctx
              enum-name-id
              (tc-global-shared-view lifetimes)
              fields)]
          (tc-bind-enum-variant-aliases-at
            ctx
            (let
              [_note : unit
                (tc-unqualified-import-note-value!
                  ctx
                  env
                  alias-id
                  importer-module-id
                  source-module-id
                  import-unqualified
                  name)]
              (tc-bind-alias-id-if-free
                env
                (tc-module-name-id-by-id alias-id name)
                constructor-ty))
            alias-id
            importer-module-id
            source-module-id
            import-unqualified
            enum-name-id
            lifetimes
            variants
            (+ index 1)))])))

;; Alias construction runs after the canonical top env is built, so reuse the
;; existing `module/name` type instead of recomputing each imported decl type.
(define (tc-import-alias-source-value-type
  [env : TcTypeEnv]
  [module-id : i64]
  [name-id : i64]) : ResultTcType
  (tc-lookup-id env (tc-module-name-id-by-id module-id name-id)))

(define (tc-import-alias-summary-index-build-current
  [all-decls : ast.AstDeclList]) : TcImportAliasSummaryIndex
  (let
    [capacity : i64
      (+ (parser.ast-decl-list-count (tc-global-shared-view all-decls)) 1)]
    [decls : (__tl_dyn-array ast.AstDeclList)
      (__tl_make-array ast.AstDeclList capacity)]
    [modules : tc_i64_i64_map.Map (tc_i64_i64_map.with-capacity capacity)]
    [slot-count : i64 0]
    [count : i64 (ast.ast-decl-list-len (& all-decls))]
    [source-offset : i64 all-decls.offset]
    [index : i64 0]
    [cur-module-id : i64 cbi.compiler-builtin-id-fix-empty]
    (while (< index count)
      ;; `all-decls` remains immutable for the complete index build. Keep
      ;; the source row borrowed for this tag probe, then copy a non-marker
      ;; row directly from the stable source slot into its owned module
      ;; list. No borrow survives destination growth or map allocation, and
      ;; the fresh destination lists cannot alias the source storage.
      (match (array-ref all-decls.slots (+ source-offset index))
        [(Module next-module) (set! cur-module-id next-module)]
        [_
          (match (tc_i64_i64_map.get (& modules) cur-module-id)
            [(LookupFound slot)
              (ast.ast-decl-list-push-from
                (&mut (array-ref decls slot))
                (& all-decls.slots)
                (+ source-offset index))]
            [(LookupMissing)
              (tc_i64_i64_map.insert-ref!
                (&mut modules)
                cur-module-id
                slot-count)
              (set! (array-ref decls slot-count) (ast.ast-decl-list-new))
              (ast.ast-decl-list-push-from
                (&mut (array-ref decls slot-count))
                (& all-decls.slots)
                (+ source-offset index))
              (set! slot-count (+ slot-count 1))])])
      (set! index (+ index 1)))
    (TcImportAliasSummaryIndex modules decls slot-count)))

(define (tc-import-alias-summary-index-build [all-decls : ast.AstDeclList]) : TcImportAliasSummaryIndex
  (tc-import-alias-summary-index-build-current all-decls))

(define (tc-import-alias-summary-index-lookup
  [index : (& index TcImportAliasSummaryIndex)]
  [target-module-id : i64]) : TcImportAliasSummaryLookup
  (match (tc_i64_i64_map.get (& index.modules) target-module-id)
    [(LookupFound slot)
      (if (and (>= slot 0) (< slot index.count))
        (Found slot)
        (Missing))]
    [(LookupMissing) (Missing)]))

(define (tc-import-alias-surface-summary-backed-in?
  [summaries : cload.CompilerLoadSurfaceSummaryList]
  [target-module-id : i64]) : bool
  (let
    [index : i64 0]
    (while (< index (cload.compiler-load-surface-summary-list-count summaries))
      (if (=
        (__tl-project-field
          (cload.compiler-load-surface-summary-list-at summaries index)
          module-id)
        target-module-id)
        (return true)
        (set! index (+ index 1))))
    false))

(define (tc-import-alias-surface-summary-backed? [target-module-id : i64]) : bool
  (tc-import-alias-surface-summary-backed-in?
    (cload.compiler-load-surface-summaries)
    target-module-id))

(define (tc-import-alias-summary-backed?
  [index : (& index TcImportAliasSummaryIndex)]
  [target-module-id : i64]) : bool
  (match (tc-import-alias-summary-index-lookup index target-module-id)
    [(Found _) true]
    [(Missing) (tc-import-alias-surface-summary-backed? target-module-id)]))

(define (tc-bind-import-alias-decl-in-module
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias : i64]
  [importer-module : i64]
  [import-unqualified : bool]
  [module : i64]
  [decl : ast.AstDecl]) : ResultTcEnv
  (match decl
    [(Unsafe inner-box)
      (let
        [inner : ast.AstDecl (ast.ast-decl-box-shared-view inner-box)]
        (match inner
          [(or (DefFn _ name _ _ _ _) (Extern _ name _ _ _))
            (let
              [ty : ast.AstType
                (try (tc-import-alias-source-value-type env module name))]
              (Ok
                (tc-bind-import-alias-value-unsafe-id
                  ctx
                  env
                  alias
                  importer-module
                  module
                  import-unqualified
                  name
                  ty)))]
          [_ (Ok env)]))]
    [(or (Def _ name _ _) (DefFn _ name _ _ _ _) (DefDispatch _ name _)
         (Extern _ name _ _ _))
      (let
        [ty : ast.AstType
          (try (tc-import-alias-source-value-type env module name))]
        (Ok
          (tc-bind-import-alias-value-id
            ctx
            env
            alias
            importer-module
            module
            import-unqualified
            name
            ty)))]
    [(DefEnum decl-meta name cleanup variants)
      (let
        [scoped-name-id : i64 (tc-module-name-id-by-id module name)]
        [enum-ty : ast.AstType (Enum scoped-name-id)]
        (Ok
          (tc-bind-enum-cleanup-import-alias
            ctx
            (tc-bind-enum-variant-aliases
              (tc-context-with-module-id
                ctx
                (tc-env-key-name-text module)
                module)
              env
              alias
              importer-module
              module
              import-unqualified
              scoped-name-id
              (ast.ast-lifetime-list-new)
              variants)
            alias
            importer-module
            module
            import-unqualified
            cleanup
            enum-ty)))]
    [(DefEnumLifetimes decl-meta name lifetimes cleanup variants)
      (let
        [scoped-name-id : i64 (tc-module-name-id-by-id module name)]
        [enum-ty : ast.AstType
          (ast.ast-ty-enum-args
            scoped-name-id
            (tc-global-shared-view lifetimes))]
        (Ok
          (tc-bind-enum-cleanup-import-alias
            ctx
            (tc-bind-enum-variant-aliases
              (tc-context-with-module-id
                ctx
                (tc-env-key-name-text module)
                module)
              env
              alias
              importer-module
              module
              import-unqualified
              scoped-name-id
              lifetimes
              variants)
            alias
            importer-module
            module
            import-unqualified
            cleanup
            enum-ty)))]
    [(DefStruct decl-meta name _ cleanup fields)
      (let
        [struct-ty : ast.AstType (Struct (tc-module-name-id-by-id module name))]
        [constructor-ty : ast.AstType
          (try (tc-import-alias-source-value-type env module name))]
        (Ok
          (tc-bind-struct-cleanup-import-alias
            ctx
            (tc-bind-import-alias-value-id
              ctx
              env
              alias
              importer-module
              module
              import-unqualified
              name
              constructor-ty)
            alias
            importer-module
            module
            import-unqualified
            cleanup
            struct-ty)))]
    [(DefStructLifetimes decl-meta name lifetimes _ cleanup fields)
      (let
        [struct-ty : ast.AstType
          (ast.ast-ty-struct-args
            (tc-module-name-id-by-id module name)
            lifetimes)]
        [constructor-ty : ast.AstType
          (try (tc-import-alias-source-value-type env module name))]
        (Ok
          (tc-bind-struct-cleanup-import-alias
            ctx
            (tc-bind-import-alias-value-id
              ctx
              env
              alias
              importer-module
              module
              import-unqualified
              name
              constructor-ty)
            alias
            importer-module
            module
            import-unqualified
            cleanup
            struct-ty)))]
    [_ (Ok env)]))

(define (tc-bind-import-alias-module-list
  [ctx : TcContext]
  [decls : (& decls ast.AstDeclList)]
  [env : TcTypeEnv]
  [target-module : i64]
  [alias : i64]
  [importer-module : i64]
  [import-unqualified : bool]
  [module : i64]) : ResultTcEnv
  ;; Index cursor rather than `ast-decl-list-step`. Only the module marker and
  ;; the fallback arm touch the row, and the fallback hands the backing slot to
  ;; the binder directly, so the step's 104 B copy and 144 B result are gone.
  (let
    [cur-env : TcTypeEnv env]
    [target-module-id : i64 target-module]
    [cur-module-id : i64 module]
    [message : String ""]
    [ok : bool true]
    [count : i64 (ast.ast-decl-list-len decls)]
    [decl-offset : i64 decls.offset]
    [index : i64 0]
    (while (and ok (< index count))
      (match (array-ref decls.slots (+ decl-offset index))
        [(Module next-module) (set! cur-module-id next-module)]
        [(or (Import _ _) (IncludeStr _ _) (IncludeStrComptime _ _)
             (IncludeStrLzss _ _) (IncludeBin _ _) (Test _ _ _ _))
          unit]
        [_
          (if (= cur-module-id target-module-id)
            (match (tc-bind-import-alias-decl-in-module
              ctx
              cur-env
              alias
              importer-module
              import-unqualified
              cur-module-id
              (tc-global-array-element-shared-view
                decls.slots
                (+ decl-offset index)))
              [(Ok next-env) (set! cur-env next-env)]
              [(Err step-message)
                (set! message step-message)
                (set! ok false)])
            unit)])
      (set! index (+ index 1)))
    (if (string.eq message "")
      (Ok cur-env)
      (Err message))))

(define (tc-bind-import-alias-module
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [env : TcTypeEnv]
  [target-module : i64]
  [alias : i64]
  [importer-module : i64]
  [import-unqualified : bool]) : ResultTcEnv
  (tc-bind-import-alias-module-list
    ctx
    (& decls)
    env
    target-module
    alias
    importer-module
    import-unqualified
    cbi.compiler-builtin-id-fix-empty))

(define (tc-bind-import-alias-module-with-index
  [ctx : TcContext]
  [summary-index : (& summary-index TcImportAliasSummaryIndex)]
  [decls : ast.AstDeclList]
  [env : TcTypeEnv]
  [target-module : i64]
  [alias : i64]
  [importer-module : i64]
  [import-unqualified : bool]) : ResultTcEnv
  (match (tc-import-alias-summary-index-lookup summary-index target-module)
    [(Found slot)
      (let
        [target-decls : ast.AstDeclList
          (unsafe
            (ptr-read (ptr-offset (__tl_array-data summary-index.decls) slot)))]
        (match (tc-bind-import-alias-module-list
          ctx
          (& target-decls)
          env
          target-module
          alias
          importer-module
          import-unqualified
          target-module)
          [(Ok next-env) (Ok next-env)]
          [(Err _)
            (tc-bind-import-alias-module
              ctx
              decls
              env
              target-module
              alias
              importer-module
              import-unqualified)]))]
    [(Missing)
      (tc-bind-import-alias-module
        ctx
        decls
        env
        target-module
        alias
        importer-module
        import-unqualified)]))

(define (tc-import-alias-materialized-key-id
  [alias-key : i64]
  [target-module : i64]) : i64
  (csym.compiler-composite-pair-key-id alias-key target-module))

(define (tc-import-alias-materialized?
  [seen : (& seen tc_i64_i64_map.Map)]
  [key : i64]) : bool
  (match (tc_i64_i64_map.get (& seen) key)
    [(LookupFound _) true]
    [(LookupMissing) false]))

(define (tc-bind-selected-import-item
  [ctx : TcContext]
  [env : TcTypeEnv]
  [importer-module : i64]
  [target-module : i64]
  [item : i64]
  [alias : i64]) : ResultTcEnv
  (match (tc-import-alias-source-value-type env target-module item)
    [(Ok ty)
      (let
        [source-name : i64 (tc-module-name-id-by-id target-module item)]
        [unsafe-binding : bool (tc-binding-unsafe-id? env source-name)]
        (Ok
          (if unsafe-binding
            (tc-bind-import-alias-value-unsafe-id
              ctx
              env
              importer-module
              importer-module
              target-module
              true
              alias
              ty)
            (tc-bind-import-alias-value-id
              ctx
              env
              importer-module
              importer-module
              target-module
              true
              alias
              ty))))]
    [(Err _)
      (let
        [symbols (tc-context-symbols ctx)]
        (if (or
          (csym.compiler-symbols-handle-found?
            (csym.compiler-symbols-lookup-type-in-module-id-or
              symbols
              target-module
              item
              (csym.compiler-symbols-missing-handle)))
          (csym.compiler-symbols-handle-found?
            (csym.compiler-symbols-lookup-macro-in-module-id-or
              symbols
              target-module
              item
              (csym.compiler-symbols-missing-handle))))
          (Ok env)
          (Err
            (str_cat.str-cat
              "typecheck: selected import "
              (str_cat.str-cat
                (tc-env-key-name-text target-module)
                (str_cat.str-cat " has no item " (tc-env-key-name-text item)))))))]))

(define (tc-build-top-env-aliases-list
  [ctx : TcContext]
  [all-decls : ast.AstDeclList]
  [decls : ast.AstDeclList]
  [env : TcTypeEnv]
  [module-id : i64]) : ResultTcEnv
  ;; Index cursor rather than `ast-decl-list-step`. The wrapper peel still runs
  ;; by value (it needs owned `Box` storage to walk an `AstDecl.Unsafe` chain),
  ;; but it now reads the backing slot directly instead of a stepped-out copy,
  ;; so the 104 B row copy and the 144 B step result are gone.
  ;; The summary index is working storage for this loop only (#8412). It is
  ;; built in its own arena and destroyed when the loop ends: lookups read row
  ;; copies whose payloads stay owned by the source pools, and every binding,
  ;; lazy-import stub and message is made in the enclosing arena.
  (let
    [cur-env : TcTypeEnv env]
    [cur-module-id : i64 module-id]
    [message : String ""]
    [ok : bool true]
    [enclosing-arena : i64 (arena.tl_arena_current)]
    [index-arena : i64 (arena.tl_arena_make)]
    [_switch-to-index : unit
      (unsafe
        (arena.tl_arena_set index-arena))]
    [summary-index : TcImportAliasSummaryIndex
      (tc-import-alias-summary-index-build (tc-global-shared-view all-decls))]
    [_restore-enclosing : unit
      (unsafe
        (arena.tl_arena_set enclosing-arena))]
    [seen-aliases : tc_i64_i64_map.Map (tc_i64_i64_map.with-capacity 512)]
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
    [decl-offset : i64 decls.offset]
    [index : i64 0]
    (while (and ok (< index count))
      (match (ast.ast-decl-unwrapped
        (& (array-ref decl-slots (+ decl-offset index))))
        [(Module next-module) (set! cur-module-id next-module)]
        [(Import
            decl-meta
            (Spec (ModuleItem item) _ (Some target-module) (Some alias) _))
          (let
            [alias-key : i64
              (csym.compiler-symbols-import-alias-key-id cur-module-id alias)]
            [seen-key : i64
              (tc-import-alias-materialized-key-id alias-key target-module)]
            (unless
              (tc-import-alias-materialized? seen-aliases seen-key)
              (tc_i64_i64_map.insert-ref! (&mut seen-aliases) seen-key 1)
              (match (tc-bind-selected-import-item
                ctx
                cur-env
                cur-module-id
                target-module
                item
                alias)
                [(Ok next-env) (set! cur-env next-env)]
                [(Err step-message)
                  ;; A macro-expansion pass builds this environment over
                  ;; the program as expanded so far. While the target
                  ;; module still has a pending generator its exports are
                  ;; not final, so the item may simply not exist yet: a
                  ;; later pass binds it, and the completed expansion is
                  ;; checked by the loader's selected-item validator.
                  (unless
                    (cload.compiler-load-module-has-pending-generator?
                      (tc-global-shared-view all-decls)
                      target-module)
                    (set! message step-message)
                    (set! ok false))])))]
        [(Import decl-meta (Spec _ _ (Some target-module) (Some alias) _))
          (let
            [alias-key : i64
              (csym.compiler-symbols-import-alias-key-id cur-module-id alias)]
            [seen-key : i64
              (tc-import-alias-materialized-key-id alias-key target-module)]
            (unless
              (tc-import-alias-materialized? seen-aliases seen-key)
              (tc_i64_i64_map.insert-ref! (&mut seen-aliases) seen-key 1)
              (if (= alias cbi.compiler-builtin-id-fix-empty)
                (match (tc-bind-import-alias-module-with-index
                  ctx
                  (& summary-index)
                  (tc-global-shared-view all-decls)
                  cur-env
                  target-module
                  alias-key
                  cur-module-id
                  true)
                  [(Ok next-env) (set! cur-env next-env)]
                  [(Err step-message)
                    (set! message step-message)
                    (set! ok false)])
                (begin
                  (let
                    [summary-backed : bool
                      (tc-import-alias-summary-backed?
                        (& summary-index)
                        target-module)]
                    (tc-lazy-import-stub-record-for-job!
                      (tc-context-job-state ctx)
                      cur-module-id
                      alias
                      target-module
                      summary-backed))
                  unit))))]
        [_ unit])
      (set! index (+ index 1)))
    (unsafe
      (arena.tl_arena_destroy index-arena))
    (if (string.eq message "")
      (Ok cur-env)
      (Err message))))

(define (tc-build-top-env [ctx : TcContext] [program : ast.AstProgram]) : ResultTcEnv
  (tc-nominal-owner-cache-reset-for-job! (tc-context-job-state ctx))
  (tc-unqualified-import-ambiguity-reset!)
  ;; A whole-program rebuild replaces the active declaration view. Rebuild
  ;; the compact value-signature index from that same view so declarations
  ;; removed by a non-inert splice cannot survive as stale reflection hits.
  ;; Incremental Extend plans bypass this entry and update the index
  ;; as they bind only their additive/refreshed declarations.
  (ctfe_support.ctfe-module-value-reset-for-state!
    (tc-context-ctfe-macro-state ctx))
  ;; Expanded declarations retain their source aliases after lazy imports are
  ;; removed. Keep the expansion-time alias -> generated-module identities;
  ;; compile-start reset already prevents them leaking between programs.
  (match program
    [(Program decls-box)
      (let
        [decls : ast.AstDeclList (ast.ast-decl-list-box-shared-view decls-box)]
        [body-state : TcBodyState (tc-context-body-state ctx)]
        [job-state : TcJobState body-state.job-state]
        [_surface-import-stubs : unit
          (tc-lazy-import-surface-stubs-record-for-job! job-state)]
        [membership-state : TcTopEnvMembershipState
          (tc-job-state-topenv-membership job-state)]
        [base-env : TcTypeEnv (tc-default-env-with-job-state job-state)]
        ;; Activate the membership bloom across the bind-list so the
        ;; enum-variant alias-if-free guard is O(1) instead of rescanning the
        ;; whole top-env spine per variant.
        [_membership-begin : unit
          (tc-topenv-membership-begin!
            membership-state
            base-env
            body-state.intern-table-id
            body-state.intern-generation)]
        (match (tc-build-top-env-list
          ctx
          (tc-global-shared-view decls)
          base-env)
          [(Ok env)
            (let
              [cached-env : TcTypeEnv (tc-env-with-cache env)]
              [_alias-fanout-begin : unit
                (tc-topenv-membership-set-alias-fanout-active!
                  membership-state
                  true)]
              ;; Alias fanout copies canonical entries by lookup; cache the
              ;; source env before adding aliases so that copy is O(1).
              (match (tc-build-top-env-aliases-list
                ctx
                (tc-global-shared-view decls)
                decls
                cached-env
                cbi.compiler-builtin-id-fix-empty)
                [(Ok aliases)
                  (tc-topenv-membership-set-alias-fanout-active!
                    membership-state
                    false)
                  (tc-topenv-membership-end! membership-state)
                  ;; Membership is only needed while constructing the
                  ;; explicit top env. Detach the capability from the
                  ;; shared store so ordinary body binds pay only the
                  ;; zero-address check; incremental explicit builders
                  ;; reattach it for their scoped operation.
                  (tc-type-env-set-topenv-membership-state!
                    aliases
                    (TcTopEnvMembershipState 0))
                  (let
                    [out : TcTypeEnv
                      (tc-env-with-cache-layer-over-explicit aliases)]
                    (Ok out))]
                [(Err message)
                  (tc-topenv-membership-set-alias-fanout-active!
                    membership-state
                    false)
                  (tc-topenv-membership-end! membership-state)
                  (Err message)]))]
          [(Err message)
            (tc-topenv-membership-end! membership-state)
            (Err message)]))]))

;; Append-only env extension (plan P2). Given the live top-env and a materialized
;; module's export-summary (its decl list: `(module NAME)` header + generated
;; body, as recorded in the P1 memo), fold that module's exported symbols into the
;; env without a whole-program rebuild. The caller folds the generated module's
;; import marker into the same raw prefix and publishes one cache layer for the
;; combined delta. This is the incremental counterpart of
;; tc-build-top-env: because generated splices are additive/inert (they introduce
;; new names in their own module namespace and never redefine existing ones, see
;; macro-decl-cannot-fire? / the inert-splice arm), extending the env with a module
;; reproduces the same resolutions the whole-program env would compute. The summary
;; list carries its own `(module NAME)` header, which tc-build-top-env-list-in-module
;; honors, so the caller need not thread the module name separately.
(define (env-extend-with-module
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [summary : ast.AstDeclList]) : ResultTcEnv
  (match (ast.ast-decl-list-step summary)
    [(Nil) (Ok top-env)]
    [(Cons _ _)
      (tc-build-top-env-list-explicit-in-module
        ctx
        summary
        top-env
        ""
        cbi.compiler-builtin-id-fix-empty)]))

;; Most module-owned values are uniquely named and can resolve through their
;; canonical module-qualified top-env key. Keep bindings whose source spelling
;; cannot be recovered from that key (root/dotted names), plus bindings whose
;; source name must preserve module-overlay shadowing order.
;;
;; Seed the existing per-module `seen` set with compile-root value names once.
;; A collision then takes the same LookupFound path as a repeated local name,
;; avoiding a second symbol-table lookup for every imported declaration.
;; A module view binds some of its declarations (unsafe ones, and those whose
;; name the compile root or another declaration of the module also declares)
;; with their types resolved when the view is built. During macro expansion a
;; lazily imported alias can still be unpublished then (`m.Map` of a generated
;; module the root materialized first), and such a type keeps naming it
;; unresolved. The view records one such name; the macro view cache rebuilds it
;; once that name resolves instead of typing later code against it (#8614).
(define tc-module-view-pending-name : i64
  -1)

;; The first `alias.Name` type `ty` still names unresolved, or -1. A resolved
;; nominal is an Enum or Struct node; a plain type parameter has no dot.
(define (tc-type-unresolved-alias-name [ctx : TcContext] [ty : ast.AstType]) : i64
  (match ty
    [(Func args ret)
      (let
        [in-args : i64
          (tc-type-list-unresolved-alias-name-at
            ctx
            (ast.ast-type-list-box-shared-view args)
            0)]
        (if (>= in-args 0)
          in-args
          (tc-type-id-unresolved-alias-name ctx ret)))]
    [(Tuple elems)
      (tc-type-list-unresolved-alias-name-at
        ctx
        (ast.ast-type-list-box-shared-view elems)
        0)]
    [(or (Array elem _) (DynArray elem) (Slice elem) (Box elem) (CFunc elem _)
         (Ptr elem) (MutPtr elem) (Ref _ elem) (MutRef _ elem) (Region _ elem)
         (Invalidate _ elem))
      (tc-type-id-unresolved-alias-name ctx elem)]
    [(or (VarArgs name _) (Var name))
      (tc-unresolved-alias-name-or-none ctx name)]
    [_ -1]))

(define (tc-unresolved-alias-name-or-none [ctx : TcContext] [name : i64]) : i64
  (if (>= (tc-name-first-dot-id (tc-context-structural-session ctx) name) 0)
    name
    -1))

(define (tc-type-id-unresolved-alias-name [ctx : TcContext] [id : i64]) : i64
  (tc-type-unresolved-alias-name ctx (tc-context-type-get ctx id)))

(define (tc-type-list-unresolved-alias-name-at
  [ctx : TcContext]
  [types : ast.AstTypeList]
  [index : i64]) : i64
  (if (>= index (ast.ast-type-list-len (& types)))
    -1
    (let
      [found : i64
        (tc-type-id-unresolved-alias-name
          ctx
          (ast.ast-type-list-get (& types) index (ast.ast-type-id-fallback)))]
      (if (>= found 0)
        found
        (tc-type-list-unresolved-alias-name-at ctx types (+ index 1))))))

;; Whether `name` (an `alias.Name` type of `module-id`) still fails to resolve.
(define (tc-module-view-pending-name-unresolved?
  [ctx : TcContext]
  [module : String]
  [module-id : i64]
  [name : i64]) : bool
  (let
    [module-ctx : TcContext (tc-context-with-module-id ctx module module-id)]
    (>=
      (tc-type-unresolved-alias-name
        module-ctx
        (tc-resolve-type module-ctx (Var name)))
      0)))

(define (tc-module-view-note-type! [ctx : TcContext] [ty : ast.AstType]) : unit
  (if (< tc-module-view-pending-name 0)
    (set! tc-module-view-pending-name (tc-type-unresolved-alias-name ctx ty))
    unit))

(define (tc-module-view-bind-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnv
  (tc-module-view-note-type! ctx (tc-global-shared-view ty))
  (tc-bind-id env name-id ty))

(define (tc-module-view-bind-unsafe-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnv
  (tc-module-view-note-type! ctx (tc-global-shared-view ty))
  (tc-bind-unsafe-id env name-id ty))

(define (tc-module-local-root-shadow-name-note!
  [session : cis.InternStructuralSessionHandle]
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [name-id : i64]) : unit
  (tc_i64_i64_map.insert-ref! seen (tc-env-name-key-id session name-id) 1))

(define (tc-module-local-root-shadow-variants-note-at!
  [session : cis.InternStructuralSessionHandle]
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [variants : (& variants ast.AstVariantDefList)]
  [index : i64]) : unit
  (if (>= index variants.len)
    unit
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(Def name _ _)
        (tc-module-local-root-shadow-name-note! session seen name)
        (tc-module-local-root-shadow-variants-note-at!
          session
          seen
          variants
          (+ index 1))])))

(define (tc-module-local-root-shadow-cleanup-note!
  [session : cis.InternStructuralSessionHandle]
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [cleanup-name : ast.AstStructCleanup]) : unit
  (match cleanup-name
    [(No) unit]
    [(Fn name)
      (tc-module-local-root-shadow-name-note!
        session
        seen
        (ci.intern-syntax-id-value name))]))

(define (tc-module-local-root-shadow-enum-cleanup-note!
  [session : cis.InternStructuralSessionHandle]
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [cleanup-name : ast.AstEnumCleanup]) : unit
  (match cleanup-name
    [(No) unit]
    [(Fn name)
      (tc-module-local-root-shadow-name-note!
        session
        seen
        (ci.intern-syntax-id-value name))]))

(define (tc-module-local-root-shadow-decl-note!
  [session : cis.InternStructuralSessionHandle]
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [decl : ast.AstDecl]) : unit
  (match decl
    [(Unsafe inner-box)
      (tc-module-local-root-shadow-decl-note!
        session
        seen
        (ast.ast-decl-box-shared-view inner-box))]
    [(or (Def _ name _ _) (DefFn _ name _ _ _ _) (DefDispatch _ name _)
         (Extern _ name _ _ _))
      (tc-module-local-root-shadow-name-note! session seen name)]
    [(or (DefEnum _ _ cleanup variants)
         (DefEnumLifetimes _ _ _ cleanup variants))
      (tc-module-local-root-shadow-enum-cleanup-note! session seen cleanup)
      (tc-module-local-root-shadow-variants-note-at!
        session
        seen
        (& variants)
        0)]
    [(or (DefStruct _ name _ cleanup _)
         (DefStructLifetimes _ name _ _ cleanup _))
      (tc-module-local-root-shadow-name-note! session seen name)
      (tc-module-local-root-shadow-cleanup-note! session seen cleanup)]
    [_ unit]))

(define (tc-module-local-root-shadow-names-note!
  [session : cis.InternStructuralSessionHandle]
  [decls : (& decls ast.AstDeclList)]
  [seen : (&mut seen tc_i64_i64_map.Map)]) : unit
  (let
    [slot : i64 (tc-module-decl-index-slot cbi.compiler-builtin-id-fix-empty)]
    (if (< slot 0)
      unit
      (let
        [j : i64 (array-ref tc-module-decl-index-starts slot)]
        [end : i64 (array-ref tc-module-decl-index-ends slot)]
        (while (< j end)
          (tc-module-local-root-shadow-decl-note!
            session
            seen
            (ast.ast-array-shared-view
              decls.slots
              (+ decls.offset (array-ref tc-module-decl-index-positions j))))
          (set! j (+ j 1)))))))

(define (tc-module-local-name-should-bind!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [name-id : i64]) : bool
  (if (or
    (csym.compiler-symbol-root-module-id? (tc-context-module-id ctx))
    (ci.intern-dotted? name-id))
    true
    (let
      [key-id : i64
        (tc-env-name-key-id (tc-context-structural-session ctx) name-id)]
      (match (tc_i64_i64_map.get seen key-id)
        [(LookupFound _) true]
        [(LookupMissing)
          (tc_i64_i64_map.insert-ref! seen key-id 1)
          (tc-name-bound-before-hygiene-global-boundary-id? env key-id)]))))

(define (tc-bind-struct-cleanup-local-shadowed!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [cleanup : ast.AstStructCleanup]
  [struct-ty : ast.AstType]) : TcTypeEnv
  (match cleanup
    [(No) env]
    [(Fn cleanup-name)
      (let
        [raw-cleanup-name : i64 (ci.intern-syntax-id-value cleanup-name)]
        (if (tc-module-local-name-should-bind! ctx env seen raw-cleanup-name)
          (tc-bind-id
            env
            raw-cleanup-name
            (tc-struct-cleanup-function-type struct-ty))
          env))]))

(define (tc-bind-enum-cleanup-local-shadowed!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [cleanup : ast.AstEnumCleanup]
  [enum-ty : ast.AstType]) : TcTypeEnv
  (match cleanup
    [(No) env]
    [(Fn cleanup-name)
      (let
        [raw-cleanup-name : i64 (ci.intern-syntax-id-value cleanup-name)]
        (if (tc-module-local-name-should-bind! ctx env seen raw-cleanup-name)
          (tc-bind-id
            env
            raw-cleanup-name
            (tc-enum-cleanup-function-type enum-ty))
          env))]))

(define (tc-bind-enum-variants-local-shadowed-at!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [scoped-enum-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [variants : (& variants ast.AstVariantDefList)]
  [index : i64]) : TcTypeEnv
  (if (>= index variants.len)
    env
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(Def name fields _)
        (tc-bind-enum-variants-local-shadowed-at!
          ctx
          (if (tc-module-local-name-should-bind! ctx env seen name)
            (tc-module-view-bind-id
              ctx
              env
              name
              (tc-enum-variant-constructor-type-id
                ctx
                scoped-enum-id
                (tc-global-shared-view lifetimes)
                fields))
            env)
          seen
          scoped-enum-id
          lifetimes
          variants
          (+ index 1))])))

(define (tc-module-local-env-add-decl
  [ctx : TcContext]
  [env : TcTypeEnv]
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [decl : ast.AstDecl]) : ResultTcEnv
  (match (tc-global-shared-view decl)
    [(Unsafe inner-box)
      (let
        [inner : ast.AstDecl (ast.ast-decl-box-shared-view inner-box)]
        ;; Unsafety is carried by the local env binding, not the canonical
        ;; top-env key, so unsafe value declarations must always be overlaid.
        (match (tc-global-shared-view inner)
          [(or (DefFn _ name _ _ _ _) (Extern _ name _ _ _))
            (let
              [ty : ast.AstType (try (tc-top-decl-type ctx inner))]
              (Ok (tc-module-view-bind-unsafe-id ctx env name ty)))]
          [_ (Ok env)]))]
    [(Def decl-meta name _ _)
      (if (tc-module-local-name-should-bind! ctx env seen name)
        (let
          [ty : ast.AstType (try (tc-top-decl-type-with-env ctx env decl))]
          (Ok (tc-module-view-bind-id ctx env name ty)))
        (Ok env))]
    [(or (DefFn _ name _ _ _ _) (DefDispatch _ name _) (Extern _ name _ _ _))
      (if (tc-module-local-name-should-bind! ctx env seen name)
        (let
          [ty : ast.AstType (try (tc-top-decl-type ctx decl))]
          (Ok (tc-module-view-bind-id ctx env name ty)))
        (Ok env))]
    [(DefEnum decl-meta name cleanup variants)
      (let
        [scoped-name : i64
          (tc-module-name-id-by-id (tc-context-module-id ctx) name)]
        [enum-ty : ast.AstType (Enum scoped-name)]
        (Ok
          (tc-bind-enum-cleanup-local-shadowed!
            ctx
            (tc-bind-enum-variants-local-shadowed-at!
              ctx
              env
              seen
              scoped-name
              (ast.ast-lifetime-list-new)
              (& variants)
              0)
            seen
            cleanup
            enum-ty)))]
    [(DefEnumLifetimes decl-meta name lifetimes cleanup variants)
      (let
        [scoped-name : i64
          (tc-module-name-id-by-id (tc-context-module-id ctx) name)]
        [enum-ty : ast.AstType
          (ast.ast-ty-enum-args scoped-name (tc-global-shared-view lifetimes))]
        (Ok
          (tc-bind-enum-cleanup-local-shadowed!
            ctx
            (tc-bind-enum-variants-local-shadowed-at!
              ctx
              env
              seen
              scoped-name
              lifetimes
              (& variants)
              0)
            seen
            cleanup
            enum-ty)))]
    [(DefStruct decl-meta name _ cleanup fields)
      (let
        [struct-ty : ast.AstType
          (Struct (tc-module-name-id-by-id (tc-context-module-id ctx) name))]
        [constructor-ty : ast.AstType
          (ast.ast-ty-func (tc-field-type-list ctx fields) (& struct-ty))]
        (Ok
          (tc-bind-struct-cleanup-local-shadowed!
            ctx
            (if (tc-module-local-name-should-bind! ctx env seen name)
              (tc-module-view-bind-id ctx env name constructor-ty)
              env)
            seen
            cleanup
            struct-ty)))]
    [(DefStructLifetimes decl-meta name lifetimes _ cleanup fields)
      (let
        [struct-ty : ast.AstType
          (ast.ast-ty-struct-args
            (tc-module-name-id-by-id (tc-context-module-id ctx) name)
            lifetimes)]
        [constructor-ty : ast.AstType
          (ast.ast-ty-func (tc-field-type-list ctx fields) (& struct-ty))]
        (Ok
          (tc-bind-struct-cleanup-local-shadowed!
            ctx
            (if (tc-module-local-name-should-bind! ctx env seen name)
              (tc-module-view-bind-id ctx env name constructor-ty)
              env)
            seen
            cleanup
            struct-ty)))]
    [(Import decl-meta (Spec _ _ (Some target-module) (Some alias) _))
      (if (= alias cbi.compiler-builtin-id-fix-empty)
        (match (tc-context-program ctx)
          [(Program decls-box)
            (tc-bind-import-alias-module
              ctx
              (ast.ast-decl-list-box-shared-view decls-box)
              env
              target-module
              cbi.compiler-builtin-id-fix-empty
              (tc-context-module-id ctx)
              true)])
        (Ok env))]
    [_ (Ok env)]))

(define (tc-module-local-env-list
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [env : TcTypeEnv]
  [_ : String]
  [target-module-id : i64]
  [_module : String]) : ResultTcEnv
  (let
    [_ensure : unit (tc-module-decl-index-ensure! decls)]
    [slot : i64 (tc-module-decl-index-slot target-module-id)]
    [root-slot : i64
      (tc-module-decl-index-slot cbi.compiler-builtin-id-fix-empty)]
    (if (< slot 0)
      (Ok env)
      (let
        [j : i64 (array-ref tc-module-decl-index-starts slot)]
        [end : i64 (array-ref tc-module-decl-index-ends slot)]
        [root-count : i64
          (if (< root-slot 0)
            0
            (-
              (array-ref tc-module-decl-index-ends root-slot)
              (array-ref tc-module-decl-index-starts root-slot)))]
        [cur-env : TcTypeEnv env]
        [seen : tc_i64_i64_map.Map
          (tc_i64_i64_map.with-capacity (+ (+ (- end j) root-count) 1))]
        [_root-shadows : unit
          (tc-module-local-root-shadow-names-note!
            (tc-context-structural-session ctx)
            decls
            (&mut seen))]
        [message : String ""]
        [ok : bool true]
        (while (and ok (< j end))
          (let
            [decl : ast.AstDecl
              (tc-global-array-element-shared-view
                decls.slots
                (+ decls.offset (array-ref tc-module-decl-index-positions j)))]
            (match (tc-global-shared-view decl)
              [(Module _) unit]
              [_
                (match (tc-module-local-env-add-decl
                  ctx
                  cur-env
                  (&mut seen)
                  decl)
                  [(Ok next-env) (set! cur-env next-env)]
                  [(Err step-message)
                    (set! message step-message)
                    (set! ok false)])])
            (set! j (+ j 1))))
        (if ok
          (Ok cur-env)
          (Err message))))))

(define (tc-module-local-env-id
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [module : String]
  [module-id : i64]) : ResultTcEnv
  (if (= module-id cbi.compiler-builtin-id-fix-empty)
    (Ok top-env)
    (let
      [env
        (try
          (if (macro-segmented-program-active? (tc-context-job-state ctx))
            (macro-segmented-module-local-env-id
              (tc-context-with-module-id ctx module module-id)
              top-env
              module-id)
            (match (tc-context-program ctx)
              [(Program decls-box)
                (tc-module-local-env-list
                  (tc-context-with-module-id
                    ctx
                    (tc-global-shared-view module)
                    module-id)
                  (ast.ast-decl-list-box-shared-view decls-box)
                  top-env
                  module
                  module-id
                  "")])))]
      ;; A module view is immutable once built. Publish its local bindings as
      ;; one explicit cache layer so every function-local cache falls through
      ;; to it instead of copying the complete module prefix again.
      (Ok (tc-env-with-cache-layer-over-explicit env)))))

(define (tc-module-local-env-cache-lookup-at
  [cache : TcModuleLocalEnvCache]
  [module-id : i64]
  [index : i64]) : TcMaybeTypeEnv
  (if (>= index cache.len)
    (No)
    (let
      [entry : TcModuleLocalEnvEntry (array-ref cache.slots index)]
      (if (= entry.module-id module-id)
        (Some entry.env)
        (tc-module-local-env-cache-lookup-at cache module-id (+ index 1))))))

(define (tc-module-local-env-cache-lookup
  [cache : TcModuleLocalEnvCache]
  [module-id : i64]) : TcMaybeTypeEnv
  (tc-module-local-env-cache-lookup-at cache module-id 0))

(define (tc-module-local-env-cache-insert
  [cache : TcModuleLocalEnvCache]
  [module-id : i64]
  [env : TcTypeEnv]) : TcModuleLocalEnvCache
  (let
    [n : i64 cache.len]
    [src : (__tl_dyn-array TcModuleLocalEnvEntry) cache.slots]
    [slots : (__tl_dyn-array TcModuleLocalEnvEntry)
      (__tl_make-array TcModuleLocalEnvEntry (+ n 1))]
    [i : i64 0]
    (while (< i n)
      (set! (array-ref slots i) (array-ref src i))
      (set! i (+ i 1)))
    (set! (array-ref slots n) (TcModuleLocalEnvEntry module-id env))
    (TcModuleLocalEnvCache slots (+ n 1))))

(define (tc-module-local-env-cached-id
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [module : String]
  [module-id : i64]
  [cache : TcModuleLocalEnvCache]) : ResultTcModuleLocalEnv
  (if (= module-id cbi.compiler-builtin-id-fix-empty)
    (Ok top-env cache)
    (match (tc-module-local-env-cache-lookup
      (tc-global-shared-view cache)
      module-id)
      [(Some env)
        (begin
          (cfg
            compile-profile
            (counters.bump! tc-profile-env-module-local-hits))
          (Ok env cache))]
      [(No)
        (begin
          (cfg
            compile-profile
            (counters.bump! tc-profile-env-module-local-misses))
          (let
            [env (try (tc-module-local-env-id ctx top-env module module-id))]
            (Ok env (tc-module-local-env-cache-insert cache module-id env))))])))

(define (tc-expect
  [actual : ast.AstType]
  [expected : ast.AstType]
  [message : String]) : ResultTcUnit
  (if (tc-type-compatible?
    (tc-global-shared-view expected)
    (tc-global-shared-view actual))
    Ok
    (Err (tc-type-mismatch-message actual expected message))))

(define (tc-expect-in-context
  [ctx : TcContext]
  [env : TcTypeEnv]
  [actual : ast.AstType]
  [expected : ast.AstType]
  [message : String]) : ResultTcUnit
  (cond
    [(tc-type-coercible?
        ctx
        env
        (tc-global-shared-view expected)
        (tc-global-shared-view actual))
      Ok]
    [else
      (let
        [canonical-actual : ast.AstType
          (tc-canonicalize-inferred-type ctx actual)]
        (cond
          [(tc-type-coercible?
              ctx
              env
              (tc-global-shared-view expected)
              (tc-global-shared-view canonical-actual))
            Ok]
          [else
            (let
              [canonical-expected : ast.AstType
                (tc-canonicalize-inferred-type
                  ctx
                  (tc-global-shared-view expected))]
              (cond
                [(tc-type-coercible?
                    ctx
                    env
                    canonical-expected
                    (tc-global-shared-view canonical-actual))
                  Ok]
                [else
                  (Err
                    (tc-type-mismatch-message-in-context
                      ctx
                      env
                      canonical-actual
                      expected
                      message))]))]))]))

(define (tc-contextual-result-type
  [expected : ast.AstType]
  [actual : ast.AstType]) : ast.AstType
  ;; Preserve active allocation-owner tags, but let a successful checker-only
  ;; lifetime coercion expose the required shorter reference/nominal lifetime.
  (if (tc-type-contains-region-tag? (tc-global-shared-view actual))
    actual
    expected))

(define (tc-float-literal-non-finite-message [ty-name : String]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (TypeMismatch))
    "typecheck: non-finite "
    ty-name
    " literal is not supported"))

(define (tc-float-literal-f64-type [text : String]) : ResultTcType
  (match (cfloat.compiler-float-parse-f64 (string.copy (& text)))
    [(CompilerFloatSomeF64 value)
      (if (cfloat.compiler-float-f64-finite? value)
        (Ok (F64))
        (Err (tc-float-literal-non-finite-message "f64")))]
    [(CompilerFloatNoF64)
      (if (cfloat.compiler-float-decimal-syntax? text)
        (Err (tc-float-literal-non-finite-message "f64"))
        (Err "typecheck: invalid f64 literal"))]))

(define (tc-float-literal-f32-type [text : String] [expected : ast.AstType]) : ResultTcType
  (match (cfloat.compiler-float-parse-f64 (string.copy (& text)))
    [(CompilerFloatSomeF64 value)
      (let
        [rounded : f64 (cfloat.compiler-float-round-f32-as-f64 value)]
        (if (and
          (cfloat.compiler-float-f64-finite? value)
          (cfloat.compiler-float-f64-finite? rounded))
          (Ok expected)
          (Err (tc-float-literal-non-finite-message "f32"))))]
    [(CompilerFloatNoF64)
      (if (cfloat.compiler-float-decimal-syntax? text)
        (Err (tc-float-literal-non-finite-message "f32"))
        (Err "typecheck: invalid f64 literal"))]))

(define (tc-float-literal-type-with-expected
  [text : String]
  [expected : ast.AstType]) : ResultTcType
  (if (tc-type-eq (tc-type-strip-region (tc-global-shared-view expected)) (F32))
    (tc-float-literal-f32-type text expected)
    (let
      [actual (try (tc-float-literal-f64-type text))]
      (if (tc-type-compatible?
        (tc-global-shared-view expected)
        (tc-global-shared-view actual))
        (Ok (tc-contextual-result-type expected actual))
        (Ok actual)))))

(define (tc-literal-type-checked [lit : ast.AstLiteral]) : ResultTcType
  (match (tc-global-shared-view lit)
    [(Float text) (tc-float-literal-f64-type text)]
    [_ (Ok (tc-literal-type lit))]))

;; These predicates only inspect syntax: the canonical AST unspanner follows
;; the caller's expression owner and may erase expansion wrappers without
;; executing a macro. Contextual validation below retains diagnostic spans.
(define (tc-float-literal-expr? [ctx : TcContext] [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-bases ctx)
    (& expr))
    [(Literal lit)
      (match lit
        [(Float _) true]
        [_ false])]
    [_ false]))

(define (tc-float-literal-expr-with-expected-with-bases
  [structural-session : cis.InternStructuralSessionHandle]
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcType
  (match expr
    [(Spanned inner-box span)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (match (tc-float-literal-expr-with-expected-with-bases
          structural-session
          expr-bases
          (tc-global-shared-view inner)
          expected)
          [(Ok ty) (Ok ty)]
          [(Err message)
            (tc-locate-spanned-error
              expr-bases
              structural-session
              inner
              span
              message)]))]
    [(MacroExpansion inner-box _ _)
      (tc-float-literal-expr-with-expected-with-bases
        structural-session
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box)
        expected)]
    [(Literal lit)
      (match lit
        [(Float text) (tc-float-literal-type-with-expected text expected)]
        [(Int _ _) (Ok (I32))]
        [(Bool _) (Ok (Bool))]
        [(Char _) (Ok (Char))]
        [(String _) (Ok (String))]
        [(Unit) (Ok (Unit))])]
    [_ (Ok (F64))]))

(define (tc-float-literal-expr-with-expected
  [ctx : TcContext]
  [expr : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcType
  (tc-float-literal-expr-with-expected-with-bases
    (tc-context-structural-session ctx)
    (tc-context-expr-bases ctx)
    expr
    expected))

(define (tc-integer-literal-expr? [ctx : TcContext] [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-bases ctx)
    (& expr))
    [(Literal lit)
      (match lit
        [(Int _ _) true]
        [_ false])]
    [_ false]))

;; Literal classification only peels span/expansion wrappers and cannot install
;; another pool. Snapshot its owner at the public boundary and keep that scalar
;; through recursion so colliding ids cannot follow the compatibility reader.
(define (tc-integer-literal-expr-with-expected-with-bases
  [ctx : TcContext]
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcType
  (match expr
    [(Spanned inner-box span)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (match (tc-integer-literal-expr-with-expected-with-bases
          ctx
          expr-bases
          (tc-global-shared-view inner)
          expected)
          [(Ok ty) (Ok ty)]
          [(Err message)
            (tc-locate-spanned-error
              expr-bases
              (tc-context-structural-session ctx)
              inner
              span
              message)]))]
    [(MacroExpansion inner-box _ _)
      (tc-integer-literal-expr-with-expected-with-bases
        ctx
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box)
        expected)]
    [(Literal lit)
      (match lit
        [(Int value text)
          (tc-integer-literal-type-with-expected ctx value text expected)]
        [(Float _) (Ok (F64))]
        [(Bool _) (Ok (Bool))]
        [(Char _) (Ok (Char))]
        [(String _) (Ok (String))]
        [(Unit) (Ok (Unit))])]
    [_ (Ok (I32))]))

(define (tc-integer-literal-expr-with-expected
  [ctx : TcContext]
  [expr : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcType
  (tc-integer-literal-expr-with-expected-with-bases
    ctx
    (tc-context-expr-bases ctx)
    expr
    expected))

(define (tc-binop-types-from-left
  [ctx : TcContext]
  [env : TcTypeEnv]
  [op : ast.AstBinOp]
  [left-ty : ast.AstType]
  [right : ast.AstExpr]) : ResultTcBinOpTypes
  (let
    [right-ty
      (try
        (tc-expr-with-expected-or-actual
          ctx
          env
          right
          (tc-global-shared-view left-ty)))]
    [result-ty
      (try
        (tc-binop-type
          op
          (tc-global-shared-view left-ty)
          (tc-global-shared-view right-ty)))]
    (Ok (TcBinOpTypes left-ty right-ty result-ty))))

(define (tc-binop-types-from-right
  [ctx : TcContext]
  [op : ast.AstBinOp]
  [left : ast.AstExpr]
  [right-ty : ast.AstType]) : ResultTcBinOpTypes
  (let
    [left-ty
      (try
        (tc-integer-literal-expr-with-expected
          ctx
          left
          (tc-global-shared-view right-ty)))]
    [result-ty
      (try
        (tc-binop-type
          op
          (tc-global-shared-view left-ty)
          (tc-global-shared-view right-ty)))]
    (Ok (TcBinOpTypes left-ty right-ty result-ty))))

(define (tc-binop-types-with-same-operands
  [op : ast.AstBinOp]
  [operand-ty : ast.AstType]) : ResultTcBinOpTypes
  (let
    [result-ty
      (try
        (tc-binop-type
          op
          (tc-global-shared-view operand-ty)
          (tc-global-shared-view operand-ty)))]
    (Ok (TcBinOpTypes (tc-global-shared-view operand-ty) operand-ty result-ty))))

(define (tc-binop-expr-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [op : ast.AstBinOp]
  [left : ast.AstExpr]
  [right : ast.AstExpr]) : ResultTcBinOpTypes
  (let
    [left-ty (try (tc-expr ctx env (tc-global-shared-view left)))]
    (if (tc-float-literal-expr? ctx (tc-global-shared-view left))
      (let
        [right-actual (try (tc-expr ctx env (tc-global-shared-view right)))]
        (if (tc-type-eq (tc-type-strip-region right-actual) (F32))
          (let
            [_ (try (tc-float-literal-expr-with-expected ctx left (F32)))]
            (tc-binop-types-with-same-operands op (F32)))
          (tc-binop-types-from-left ctx env op left-ty right)))
      (if (tc-integer-literal-expr? ctx (tc-global-shared-view left))
        (let
          [right-actual (try (tc-expr ctx env (tc-global-shared-view right)))]
          (if (tc-integer-type? (tc-global-shared-view right-actual))
            (tc-binop-types-from-right ctx op left right-actual)
            (tc-binop-types-from-left ctx env op left-ty right)))
        (tc-binop-types-from-left ctx env op left-ty right)))))

(define (tc-binop-contextual-operand-type
  [op : ast.AstBinOp]
  [expected : ast.AstType]) : ast.AstMaybeType
  (match op
    [(or (Add) (Sub) (Mul) (Div))
      (if (or
        (tc-integer-type? (tc-global-shared-view expected))
        (tc-float-type? (tc-global-shared-view expected)))
        (Some expected)
        (No))]
    [(or (Mod) (BitAnd) (BitOr) (BitXor) (Shl) (Shr))
      (if (tc-integer-type? (tc-global-shared-view expected))
        (Some expected)
        (No))]
    [(or (And) (Or))
      (if (tc-type-eq (tc-global-shared-view expected) (Bool))
        (Some expected)
        (No))]
    [_ (No)]))

(define (tc-binary-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [op : ast.AstBinOp]
  [left : ast.AstExpr]
  [right : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcType
  (let
    [operand-expected : ast.AstType
      (tc-type-without-regions
        (tc-resolve-type ctx (tc-global-shared-view expected)))]
    (match (tc-binop-contextual-operand-type op operand-expected)
      [(No) (tc-expr ctx env expr)]
      [(Some operand-ty)
        (let
          [left-ty
            (try
              (tc-expr-with-expected-or-actual
                ctx
                env
                left
                (tc-global-shared-view operand-ty)))]
          [right-ty : ast.AstType
            (try (tc-expr-with-expected-or-actual ctx env right operand-ty))]
          (match (tc-binop-type op left-ty right-ty)
            [(Ok result-ty)
              (if (tc-type-compatible?
                (tc-global-shared-view expected)
                (tc-global-shared-view result-ty))
                (Ok (tc-contextual-result-type expected result-ty))
                (Ok result-ty))]
            [(Err _) (tc-expr ctx env expr)]))])))

(define (tc-unop-contextual-operand-type
  [op : ast.AstUnOp]
  [expected : ast.AstType]) : ast.AstMaybeType
  (match op
    [(Neg)
      (if (or
        (tc-integer-type? (tc-global-shared-view expected))
        (tc-float-type? (tc-global-shared-view expected)))
        (Some expected)
        (No))]
    [(BitNot)
      (if (tc-integer-type? (tc-global-shared-view expected))
        (Some expected)
        (No))]
    [(Not)
      (if (tc-type-eq (tc-global-shared-view expected) (Bool))
        (Some expected)
        (No))]))

(define (tc-unary-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [op : ast.AstUnOp]
  [inner : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcType
  (let
    [operand-expected : ast.AstType
      (tc-type-without-regions
        (tc-resolve-type ctx (tc-global-shared-view expected)))]
    (match (tc-unop-contextual-operand-type op operand-expected)
      [(No) (tc-expr ctx env expr)]
      [(Some operand-ty)
        (let
          [inner-ty : ast.AstType
            (try (tc-expr-with-expected-or-actual ctx env inner operand-ty))]
          (match (tc-unop-type op inner-ty)
            [(Ok result-ty)
              (if (tc-type-compatible?
                (tc-global-shared-view expected)
                (tc-global-shared-view result-ty))
                (Ok (tc-contextual-result-type expected result-ty))
                (Ok result-ty))]
            [(Err _) (tc-expr ctx env expr)]))])))

(define (tc-expr-list-with-expected-elements
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]
  [elem-ty : ast.AstType]) : ResultTcUnit
  (tc-expr-list-with-expected-elements-at ctx env (& exprs) 0 elem-ty))

(define (tc-expr-list-with-expected-elements-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [elem-ty : ast.AstType]) : ResultTcUnit
  (if (>= index exprs.len)
    Ok
    (let
      [got
        (try
          (tc-expr-with-expected-or-actual-id
            ctx
            env
            (ast.ast-expr-list-get exprs index 0)
            (tc-global-shared-view elem-ty)))]
      [_
        (try
          (tc-expect
            got
            (tc-global-shared-view elem-ty)
            "typecheck: array elements must have same type"))]
      (tc-expr-list-with-expected-elements-at ctx env exprs (+ index 1) elem-ty))))

(define (tc-expr-array-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]
  [elem-ty : ast.AstType]
  [expected-len : i64]) : ResultTcType
  (if (= (tc-expr-list-len (tc-global-shared-view exprs)) expected-len)
    (let
      [_
        (try
          (tc-ensure-cleanup-resource-not-stored-list
            ctx
            env
            (tc-global-shared-view exprs)))]
      (let
        [_
          (try
            (tc-expr-list-with-expected-elements
              ctx
              env
              exprs
              (tc-global-shared-view elem-ty)))]
        (Ok (ast.ast-ty-array (& elem-ty) expected-len))))
    (tc-expr ctx env (Array exprs))))

(define (tc-dyn-array-literal-element-supported
  [env : TcTypeEnv]
  [elem-ty : ast.AstType]) : ResultTcUnit
  (if (tc-dyn-array-elem-supported? env elem-ty)
    Ok
    (Err
      (tc-kind-message
        (TypeMismatch)
        "typecheck: dynamic array literal element type is not supported"))))

(define (tc-expr-dyn-array-literal-with-elem
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]
  [elem-ty : ast.AstType]) : ResultTcType
  (let
    [resolved-elem : ast.AstType (tc-resolve-type ctx elem-ty)]
    [_
      (try
        (tc-ensure-cleanup-resource-not-stored-list
          ctx
          env
          (tc-global-shared-view exprs)))]
    (let
      [_
        (try
          (tc-dyn-array-literal-element-supported
            env
            (tc-global-shared-view resolved-elem)))]
      (let
        [_
          (try
            (tc-expr-list-with-expected-elements
              ctx
              env
              exprs
              (tc-global-shared-view resolved-elem)))]
        (Ok (tc-tag-active-region env (ast.ast-ty-dyn-array (& resolved-elem))))))))

(define (tc-expr-dyn-array-literal-infer
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]) : ResultTcType
  (let
    [_
      (try
        (tc-ensure-cleanup-resource-not-stored-list
          ctx
          env
          (tc-global-shared-view exprs)))]
    (if (ast.ast-expr-list-empty? (& exprs))
      (Err
        "typecheck: cannot infer element type of empty dynamic array literal")
      (let
        [first : i64 (ast.ast-expr-list-get (& exprs) 0 0)]
        [rest : ast.AstExprList (ast.ast-expr-list-tail-from-ref (& exprs) 1)]
        [first-ty (try (tc-expr-id ctx env first))]
        [_
          (try
            (tc-dyn-array-literal-element-supported
              env
              (tc-global-shared-view first-ty)))]
        (let
          [_
            (try
              (tc-check-array-rest
                ctx
                env
                rest
                (tc-global-shared-view first-ty)))]
          (Ok (tc-tag-active-region env (ast.ast-ty-dyn-array (& first-ty)))))))))

(define (tc-expr-dyn-array-literal-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]
  [expected : ast.AstType]) : ResultTcType
  (match (tc-type-strip-region (tc-resolve-type ctx expected))
    [(DynArray elem-ty)
      (tc-expr-dyn-array-literal-with-elem
        ctx
        env
        exprs
        (tc-context-type-get ctx elem-ty))]
    [_ (tc-expr-dyn-array-literal-infer ctx env exprs)]))

(define (tc-expr-if-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [cond-id : i64]
  [then-branch-id : i64]
  [else-branch-id : i64]
  [expected : ast.AstType]) : ResultTcType
  (let
    [cond-ty : ast.AstType (try (tc-expr-id ctx env cond-id))]
    [_ (try (tc-expect cond-ty (Bool) "typecheck: if condition must be bool"))]
    [then-ty
      (try
        (tc-expr-with-expected-or-actual-id
          ctx
          env
          then-branch-id
          (tc-global-shared-view expected)))]
    [else-ty
      (try
        (tc-expr-with-expected-or-actual-id
          ctx
          env
          else-branch-id
          (tc-global-shared-view expected)))]
    (if (and
      (tc-type-coercible?
        ctx
        env
        (tc-global-shared-view expected)
        (tc-global-shared-view then-ty))
      (tc-type-coercible?
        ctx
        env
        (tc-global-shared-view expected)
        (tc-global-shared-view else-ty)))
      (Ok expected)
      (tc-merge-branch-type ctx env then-ty else-ty))))

(define (tc-type-list-len [types : (& types ast.AstTypeList)]) : i64
  (ast.ast-type-list-len (& types)))

;; Flow each tuple element into its expected element type so contextual
;; literals (e.g. f32 floats) resolve against the tuple's declared element
;; type instead of their default. Returns the resolved element types.
(define (tc-check-tuple-elements-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]
  [types : ast.AstTypeList]) : ResultTcTypeList
  (let
    [out : ast.AstTypeList (ast.ast-type-list-new)]
    [_
      (try
        (tc-check-tuple-elements-with-expected-into-at
          ctx
          env
          (& exprs)
          (& types)
          0
          (&mut out)))]
    (Ok out)))

(define (tc-check-tuple-elements-with-expected-into-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [out : (&mut out ast.AstTypeList)]) : ResultTcUnit
  (if (>= index exprs.len)
    (if (>= index (ast.ast-type-list-len types))
      Ok
      (Err
        (tc-kind-message
          (TypeMismatch)
          "typecheck: tuple element type mismatch")))
    (if (>= index (ast.ast-type-list-len types))
      (Err
        (tc-kind-message
          (TypeMismatch)
          "typecheck: tuple element type mismatch"))
      (let
        [expr-id : i64 (ast.ast-expr-list-get exprs index 0)]
        [want : ast.AstType
          (ast.ty-node-get
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
        [got
          (try
            (tc-expr-with-expected-or-actual-id
              ctx
              env
              expr-id
              (tc-global-shared-view want)))]
        [_
          (try
            (tc-expect
              (tc-global-shared-view got)
              (tc-global-shared-view want)
              "typecheck: tuple element type mismatch"))]
        (ast.ast-type-list-push
          out
          (ast.ast-node-pool-reader-type-push
            (& (tc-contextual-result-type want got))))
        (tc-check-tuple-elements-with-expected-into-at
          ctx
          env
          exprs
          types
          (+ index 1)
          out)))))

(define (tc-expr-tuple-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]
  [expected-elems : ast.AstTypeList]) : ResultTcType
  (if (=
    (tc-expr-list-len (tc-global-shared-view exprs))
    (tc-type-list-len expected-elems))
    (let
      [_
        (try
          (tc-ensure-cleanup-resource-not-stored-list
            ctx
            env
            (tc-global-shared-view exprs)))]
      [result-elems : ast.AstTypeList
        (try
          (tc-check-tuple-elements-with-expected ctx env exprs expected-elems))]
      (Ok (ast.ast-ty-tuple result-elems)))
    (tc-expr ctx env (Tuple exprs))))

;; Flow the expected type into a begin's final expression so a contextual
;; literal in tail position resolves against it; non-final expressions keep
;; the non-contextual policy (any type is allowed).
(define (tc-begin-list-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [expected : ast.AstType]) : ResultTcType
  (tc-begin-list-with-expected-at ctx env (& exprs) 0 expected))

(define (tc-begin-list-with-expected-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [expected : ast.AstType]) : ResultTcType
  (if (>= index exprs.len)
    (Ok (Unit))
    (if (= (+ index 1) exprs.len)
      (tc-expr-with-expected-or-actual-id
        ctx
        env
        (ast.ast-expr-list-get exprs index 0)
        expected)
      (let
        [_ (try (tc-expr-id ctx env (ast.ast-expr-list-get exprs index 0)))]
        (tc-begin-list-with-expected-at ctx env exprs (+ index 1) expected)))))

(define (tc-ctfe-value-type
  [ctx : TcContext]
  [value : ctfe_support.CompilerCtfeValue]) : ResultTcType
  (match value
    [(I64 _) (Ok (I64))]
    [(F64 _) (Ok (F64))]
    [(F32 _) (Ok (F32))]
    [(Bool _) (Ok (Bool))]
    [(Char _) (Ok (Char))]
    [(or (String _ _) (Name _ _))
      (Err
        (tc-kind-message
          (ComptimeConstraint)
          "String value is compile-time only"))]
    [(Unit) (Ok (Unit))]
    [(or (Expr _ _) (CapturedExpr _ _ _)) (Ok (Expr))]
    [(Type ty)
      (Err
        (str_cat.str-cat
          (cdiag.compiler-diagnostic-typecheck-tag (ComptimeConstraint))
          "type value "
          (tc-type-render (tc-resolve-type ctx ty))
          " is compile-time only"))]
    [(or (ExprList _) (CapturedExprList _ _)) (Ok (ExprList))]
    [(or (ExprClause _) (CapturedExprClause _ _))
      (Ok (tc-macro-expr-clause-type))]
    [(or (ExprClauseList _) (CapturedExprClauseList _ _))
      (Ok (tc-macro-expr-clause-list-type))]
    [(ExprBindingClause _) (Ok (tc-macro-expr-binding-clause-type))]
    [(ExprBindingClauseList _) (Ok (tc-macro-expr-binding-clause-list-type))]
    [(Pattern _) (Ok (tc-macro-pattern-type))]
    [(PatternList _) (Ok (tc-macro-pattern-list-type))]
    [(MatchArm _) (Ok (tc-macro-match-arm-type))]
    [(MatchArmList _) (Ok (tc-macro-match-arm-list-type))]
    [(LetBinding _)
      (Err
        (tc-kind-message
          (ComptimeConstraint)
          "LetBinding value is compile-time only"))]
    [(LetBindingList _)
      (Err
        (tc-kind-message
          (ComptimeConstraint)
          "LetBindingList value is compile-time only"))]
    [(TypeInfo _)
      (Err
        (tc-kind-message
          (ComptimeConstraint)
          "TypeInfo value is compile-time only"))]
    [(TypeInfoBox _)
      (Err
        (tc-kind-message
          (ComptimeConstraint)
          "TypeInfo box value is compile-time only"))]
    [(TypeInfoList _)
      (Err
        (tc-kind-message
          (ComptimeConstraint)
          "TypeInfoList value is compile-time only"))]
    [(TypeField _ _)
      (Err
        (tc-kind-message
          (ComptimeConstraint)
          "TypeField value is compile-time only"))]
    [(TypeFieldList _)
      (Err
        (tc-kind-message
          (ComptimeConstraint)
          "TypeFieldList value is compile-time only"))]
    [(TypeVariantPayload _)
      (Err
        (tc-kind-message
          (ComptimeConstraint)
          "TypeVariantPayload value is compile-time only"))]
    [(TypeVariantPayloadList _)
      (Err
        (tc-kind-message
          (ComptimeConstraint)
          "TypeVariantPayloadList value is compile-time only"))]
    [(TypeVariant _ _)
      (Err
        (tc-kind-message
          (ComptimeConstraint)
          "TypeVariant value is compile-time only"))]
    [(TypeVariantList _)
      (Err
        (tc-kind-message
          (ComptimeConstraint)
          "TypeVariantList value is compile-time only"))]))

(define (tc-ctfe-float-value? [value : ctfe_support.CompilerCtfeValue]) : bool
  (match value
    [(or (F64 _) (F32 _)) true]
    [_ false]))

(define (tc-ctfe-value-type-with-expected
  [ctx : TcContext]
  [value : ctfe_support.CompilerCtfeValue]
  [expected : ast.AstType]) : ResultTcType
  (let
    [actual (try (tc-ctfe-value-type ctx (tc-global-shared-view value)))]
    (if (and
      (tc-ctfe-float-value? value)
      (tc-type-eq (tc-type-strip-region (tc-global-shared-view expected)) (F32)))
      (Ok expected)
      (if (tc-type-compatible?
        (tc-global-shared-view expected)
        (tc-global-shared-view actual))
        (Ok (tc-contextual-result-type expected actual))
        (Ok actual)))))

(define (tc-expr-result-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expected : ast.AstType]
  [allow-mut-by-value-borrow : bool]
  [result : ResultTcType]) : ResultTcType
  (let
    [actual : ast.AstType (try result)]
    (cond
      [(tc-type-coercible?
          ctx
          env
          (tc-global-shared-view expected)
          (tc-global-shared-view actual))
        (Ok (tc-contextual-result-type expected actual))]
      [(and
          allow-mut-by-value-borrow
          (tc-call-string-temporary-ref-compatible?
            ctx
            (tc-global-shared-view expected)
            (tc-global-shared-view actual)))
        (Ok expected)]
      [else
        (match (tc-match-inferred-type-for-expected
          ctx
          env
          (tc-global-shared-view actual)
          (tc-global-shared-view expected))
          [(Compatible matched)
            (Ok (tc-contextual-result-type expected matched))]
          [(Mismatch _) (Ok actual)])])))

(define (tc-macro-expansion-result-with-frame
  [ctx : TcContext]
  [inner : ast.AstExpr]
  [path-id : i64]
  [origin-path-id : i64]
  [macro-name-id : i64]
  [span : ast.AstSourceSpan]
  [result : ResultTcType]) : ResultTcType
  (match result
    [(Ok ty) (Ok ty)]
    [(Err message)
      (let
        [located : String
          (if (tc-encoded-error? message)
            message
            (match (tc-expr-maybe-span (tc-context-expr-bases ctx) inner)
              [(Some primary) (tc-located-error primary message)]
              [(No) (tc-located-error span message)]))]
        (Err
          (tc-macro-framed-error
            path-id
            span
            origin-path-id
            macro-name-id
            (tc-unbound-finalize-located-error located))))]))

(define (tc-expr-with-expected-or-actual-core-inner
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [expected : ast.AstType]
  [allow-mut-by-value-borrow : bool]) : ResultTcType
  (match (tc-global-shared-view expr)
    [(Spanned inner-box span)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        (match (tc-global-shared-view inner)
          [(MacroExpansion expanded provenance-id macro-name-id)
            (tc-macro-expansion-result-with-frame
              ctx
              (tc-context-expr-get ctx expanded)
              (macro-expansion-invocation-path-id provenance-id)
              (macro-expansion-origin-path-id provenance-id)
              macro-name-id
              span
              (tc-semantic-expansion
                ctx
                env
                (macro-expansion-origin-path-id provenance-id)
                macro-name-id
                span
                (tc-expr-with-expected-or-actual-core-id
                  ctx
                  env
                  expanded
                  expected
                  allow-mut-by-value-borrow)))]
          [_
            (let
              [result : ResultTcType
                (match (tc-global-shared-view inner)
                  [(Unsafe exprs)
                    (tc-unsafe-begin-list-scoped
                      ctx
                      env
                      exprs
                      (Some expected)
                      (Some span))]
                  [_
                    (tc-expr-with-expected-or-actual-core-id
                      ctx
                      env
                      inner-box
                      expected
                      allow-mut-by-value-borrow)])]
              (match result
                [(Ok ty) (Ok ty)]
                [(Err message)
                  (tc-locate-spanned-error-with-context
                    ctx
                    env
                    inner
                    span
                    message)]))]))]
    [(MacroExpansion inner _ _)
      (tc-expr-with-expected-or-actual-core-id
        ctx
        env
        inner
        expected
        allow-mut-by-value-borrow)]
    [(Binary op left-box right-box)
      (let
        [left : ast.AstExpr (tc-context-expr-get ctx left-box)]
        [right : ast.AstExpr (tc-context-expr-get ctx right-box)]
        (tc-binary-expr-with-expected-or-actual
          ctx
          env
          expr
          op
          left
          right
          expected))]
    [(Unary op inner-box)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        (tc-unary-expr-with-expected-or-actual ctx env expr op inner expected))]
    [(If cond-box then-branch-box else-branch-box)
      (tc-expr-if-with-expected-or-actual
        ctx
        env
        cond-box
        then-branch-box
        else-branch-box
        expected)]
    [(Match match-box)
      (match (ast.ast-match-box-shared-view match-box)
        [(Match scrutinee-box arms)
          (let
            [scrut-ty (try (tc-expr-id ctx env scrutinee-box))]
            (tc-match-expr ctx env scrut-ty arms (Some expected)))])]
    [(Array exprs)
      (match (tc-type-strip-region expected)
        [(Array elem-ty len)
          (tc-expr-array-with-expected-or-actual
            ctx
            env
            exprs
            (ast.ty-node-get elem-ty)
            len)]
        [_ (tc-expr ctx env expr)])]
    [(DynArray exprs)
      (tc-expr-dyn-array-literal-with-expected-or-actual ctx env exprs expected)]
    [(Tuple exprs)
      (match (tc-type-strip-region expected)
        [(Tuple expected-elems)
          (tc-expr-tuple-with-expected-or-actual
            ctx
            env
            exprs
            (ast.ast-type-list-box-shared-view expected-elems))]
        [_ (tc-expr ctx env expr)])]
    [(Begin exprs) (tc-begin-list-with-expected ctx env exprs expected)]
    [(Unsafe exprs)
      (tc-unsafe-begin-list-scoped ctx env exprs (Some expected) No)]
    [(Let let-box)
      (match (ast.ast-let-box-shared-view let-box)
        [(Let bindings body-box)
          (let
            [body : ast.AstExpr (tc-context-expr-get ctx body-box)]
            [next-env
              (try (tc-let-bindings-for-body ctx env bindings body-box body))]
            [body-ty
              (try
                (tc-expr-with-expected-or-actual-id
                  ctx
                  next-env
                  body-box
                  expected))]
            [_
              (try
                (tc-ensure-reference-type-does-not-escape-names
                  (tc-global-shared-view body-ty)
                  (tc-let-binding-list-add-bound-name-ids bindings Nil)))]
            (Ok body-ty))])]
    [(WithRegion region body)
      (tc-with-region-expr-scoped ctx env region body (Some expected))]
    [(WithEscape scratch-box body)
      (let
        [scratch : ast.AstExpr (tc-context-expr-get ctx scratch-box)]
        (tc-with-escape-expr ctx env scratch body (Some expected)))]
    [(WithScratch body) (tc-with-scratch-expr ctx env body (Some expected))]
    [(InArena arena-box body)
      (let
        [arena : ast.AstExpr (tc-context-expr-get ctx arena-box)]
        (tc-in-arena-expr-scoped ctx env arena body (Some expected)))]
    [(WithResource wr-box)
      (match (ast.ast-with-resource-box-shared-view wr-box)
        [(WithResource bindings body)
          (tc-with-resource-expr ctx env bindings body (Some expected))])]
    [(Borrow mutable lifetime-id place-box)
      (let
        [_ (try (tc-normalize-dotted-local-field-node! ctx env place-box))]
        [lifetime : ast.AstBorrowLifetime
          (ast.ast-borrow-lifetime-from-id lifetime-id)]
        [place : ast.AstExpr (tc-context-expr-get ctx place-box)]
        (if (and mutable allow-mut-by-value-borrow)
          (tc-borrow-expr-with-policy
            ctx
            (tc-context-expr-bases ctx)
            env
            mutable
            lifetime
            place
            true)
          (tc-expr ctx env expr)))]
    [(Box inner-box)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        (tc-box-expr-with-expected-or-actual ctx env inner expected))]
    [(BoxGet inner-box)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        (tc-box-get-expr-with-expected-or-actual ctx env inner expected))]
    [(BoxTake inner-box)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        (tc-deref-expr-with-expected-or-actual ctx env inner expected))]
    [(Comptime inner-box)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        [ctfe-env : ctfe_support.CtfeEnv
          (tc-ctfe-env-for-comptime ctx (tc-global-shared-view inner))]
        (match (ctfe_support.compiler-ctfe-eval
          inner
          ctfe-env
          (ctfe_support.ctfe-fuel-limit))
          [(Ok value _) (tc-ctfe-value-type-with-expected ctx value expected)]
          [(Err diag)
            (let
              [diag-view : cdiag.CompilerDiagnostic
                (cdiag.compiler-diagnostic-box-shared-view diag)]
              (Err
                (cdiag.compiler-diagnostic-typecheck-error-text (& diag-view))))]))]
    [(Init maybe-ty-id)
      (match (ast.ast-maybe-type-from-id maybe-ty-id)
        [(No) (tc-init-expr ctx env expected)]
        [(Some ty)
          (let
            [actual (try (tc-init-expr ctx env ty))]
            (if (tc-type-compatible?
              (tc-global-shared-view expected)
              (tc-global-shared-view actual))
              (Ok (tc-contextual-result-type expected actual))
              (Ok actual)))])]
    [(Box inner-box)
      (match (tc-type-strip-region (tc-resolve-type ctx expected))
        [(Box inner-ty)
          (let
            [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
            [want : ast.AstType (ast.ty-node-get inner-ty)]
            [_
              (try
                (tc-ensure-cleanup-resource-not-stored-expr
                  ctx
                  env
                  (tc-global-shared-view inner)))]
            (let
              [got
                (try
                  (tc-expr-with-expected-or-actual
                    ctx
                    env
                    inner
                    (tc-global-shared-view want)))]
              [_
                (try
                  (tc-expect
                    (tc-global-shared-view got)
                    (tc-global-shared-view want)
                    "typecheck: box inner type mismatch"))]
              (Ok
                (tc-tag-active-region
                  env
                  (ast.ast-ty-box (& (tc-contextual-result-type want got)))))))]
        [_ (tc-expr ctx env expr)])]
    [(Call func-box _)
      (let
        [_
          (try
            (tc-expected-call-variant-retarget!
              ctx
              env
              func-box
              (tc-global-shared-view expected)))]
        (tc-expr-result-with-expected-or-actual
          ctx
          env
          expected
          allow-mut-by-value-borrow
          (tc-expr ctx env expr)))]
    [_
      (if (tc-integer-literal-expr? ctx (tc-global-shared-view expr))
        (tc-integer-literal-expr-with-expected ctx expr expected)
        (if (tc-float-literal-expr? ctx (tc-global-shared-view expr))
          (tc-float-literal-expr-with-expected ctx expr expected)
          (tc-expr-result-with-expected-or-actual
            ctx
            env
            expected
            allow-mut-by-value-borrow
            (tc-expr ctx env expr))))]))

(define (tc-expr-scoped-bindings? [expr : (& expr ast.AstExpr)]) : bool
  (match expr
    [(or (Let _) (While _ _) (ForOwnedState _) (ForOwnedStep _) (Foreach _)
         (SpmdReduce _) (SpmdScan _) (SpmdCompact _) (ForeachActive _ _)
         (WithResource _))
      true]
    [_ false]))

(define (tc-expr-with-expected-or-actual-core
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [expected : ast.AstType]
  [allow-mut-by-value-borrow : bool]) : ResultTcType
  (if (and
    (tc-type-env-scoped-runtime-active? env)
    (tc-expr-scoped-bindings? expr))
    (let
      [saved : TcTypeEnvScopedRuntimeSave (tc-type-env-scoped-runtime-save env)]
      [result : ResultTcType
        (tc-expr-with-expected-or-actual-core-inner
          ctx
          env
          expr
          expected
          allow-mut-by-value-borrow)]
      (tc-type-env-scoped-runtime-restore! saved)
      result)
    (tc-expr-with-expected-or-actual-core-inner
      ctx
      env
      expr
      expected
      allow-mut-by-value-borrow)))

(define (tc-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcType
  (tc-expr-with-expected-or-actual-core ctx env expr expected false))

(define (tc-expr-with-expected-or-actual-call-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcType
  (tc-expr-with-expected-or-actual-core ctx env expr expected true))

;; Safe thread spawns deliberately consume a direct lambda across the thread
;; boundary. Their dedicated capture checker validates that transfer after
;; ordinary argument typing, so admit only the top-level lambda here; nested
;; closures in its body still take the normal fail-closed path.
(define (tc-expr-with-expected-or-actual-thread-spawn-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcType
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-segment-bases ctx)
    (& expr))
    [(Lambda lambda-box)
      (match (ast.ast-lambda-box-owned-copy lambda-box)
        [(Lambda params maybe-ret body-box)
          (tc-expr-result-with-expected-or-actual
            ctx
            env
            expected
            true
            (tc-lambda-expr-with-capture-check
              ctx
              env
              params
              maybe-ret
              (tc-context-expr-get ctx body-box)
              false))])]
    [_ (tc-expr-with-expected-or-actual-call-arg ctx env expr expected)]))

;; Id entrypoints keep the original AST node identity available to future
;; body-local type caches. The value-based forms above remain necessary for
;; synthetic expressions that were never pushed into the node pool.
(define (tc-expr-id-normalized-recorded
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]) : ResultTcType
  (let
    [expr : ast.AstExpr (tc-context-expr-get ctx expr-id)]
    [result : ResultTcType
      (match (tc-global-shared-view expr)
        [(Var name)
          (tc-var-expr-after-local-field-check
            ctx
            env
            name
            (tc-hygiene-name-text-id-for-session
              (tc-context-structural-session ctx)
              name))]
        [(Set name value-box)
          (tc-set-expr-after-local-field-check ctx env name value-box)]
        [_ (tc-expr ctx env (tc-global-shared-view expr))])]
    (match (tc-global-shared-view result)
      [(Ok ty)
        (let
          [body-state : TcBodyState (tc-context-body-state ctx)]
          (tc-body-type-fact-record!
            body-state
            expr-id
            (tc-global-shared-view ty))
          (if body-state.inlay-hint-enabled
            (tc-inlay-hint-maybe-record-expr-for-state
              body-state.inlay-hint-state
              expr
              ty)
            unit))]
      [(Err _) unit])
    result))

(define (tc-expr-id-normalized-observed
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]) : ResultTcType
  (if (= (tc-context-semantic-observer ctx).address 0)
    (tc-expr-id-normalized-recorded ctx env expr-id)
    (let
      [_enter : unit (tc-semantic-observe-enter! ctx env expr-id)]
      [result : ResultTcType (tc-expr-id-normalized-recorded ctx env expr-id)]
      (tc-semantic-observe-expression!
        ctx
        env
        expr-id
        (tc-global-shared-view result))
      result)))

(define (tc-expr-id-after-dotted-local-field-normalization
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]) : ResultTcType
  (if (= tc-semantic-observed-jobs 0)
    (tc-expr-id-normalized-recorded ctx env expr-id)
    (tc-expr-id-normalized-observed ctx env expr-id)))

(define (tc-expr-id [ctx : TcContext] [env : TcTypeEnv] [expr-id : i64]) : ResultTcType
  (let
    [expr : ast.AstExpr (tc-context-expr-get ctx expr-id)]
    (match (tc-global-shared-view expr)
      [(or (Var name) (Set name _))
        (if (<
          (tc-dotted-name-first-dot-id (tc-context-structural-session ctx) name)
          0)
          (tc-expr-id-after-dotted-local-field-normalization ctx env expr-id)
          (let
            [_
              (try
                (tc-normalize-dotted-local-field-direct-node!
                  ctx
                  env
                  expr-id
                  expr))]
            (tc-expr-id-after-dotted-local-field-normalization ctx env expr-id)))]
      [_ (tc-expr-id-after-dotted-local-field-normalization ctx env expr-id)])))

(define (tc-body-type-fact-lookup-profiled
  [_site : String]
  [ctx : TcContext]
  [expr-id : i64]) : TcBodyTypeFact
  (match (tc-body-type-fact-lookup (tc-context-body-state ctx) expr-id)
    [(Hit ty)
      (begin
        (cfg
          compile-profile
          (compiler-tc-body-fact-profile-hit (tc-context-job-state ctx) _site))
        (Hit ty))]
    [(Miss)
      (begin
        (cfg
          compile-profile
          (compiler-tc-body-fact-profile-miss (tc-context-job-state ctx) _site))
        (Miss))]))

(define (tc-body-type-fact-expr-id
  [site : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]) : ResultTcType
  (match (tc-body-type-fact-lookup-profiled
    (tc-global-shared-view site)
    ctx
    expr-id)
    [(Hit ty) (Ok ty)]
    [(Miss)
      (compiler-tc-reinfer-profiled ctx site (tc-expr-id ctx env expr-id))]))

(define (tc-body-type-fact-list-types-into-at
  [state : TcBodyState]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [out : (&mut out ast.AstTypeList)]) : ResultTcUnit
  (if (>= index exprs.len)
    Ok
    (match (tc-body-type-fact-lookup
      state
      (ast.ast-expr-list-get exprs index 0))
      [(Hit ty)
        (ast.ast-type-list-push out (ast.ast-node-pool-reader-type-push (& ty)))
        (tc-body-type-fact-list-types-into-at state exprs (+ index 1) out)]
      [(Miss) (Err "")])))

(define (tc-body-type-fact-list-types
  [state : TcBodyState]
  [exprs : (& exprs ast.AstExprList)]) : ResultTcTypeList
  (if (unsafe
    (deref (tc-body-state-view state)).type-facts-consuming)
    (let
      [out : ast.AstTypeList (ast.ast-type-list-new)]
      [_
        (try
          (tc-body-type-fact-list-types-into-at state (& exprs) 0 (&mut out)))]
      (Ok out))
    (Err "")))

(define (tc-body-type-fact-expr-list-types
  [_site : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]) : ResultTcTypeList
  (match (tc-body-type-fact-list-types (tc-context-body-state ctx) exprs)
    [(Ok types)
      (begin
        (cfg
          compile-profile
          (compiler-tc-body-fact-profile-hit (tc-context-job-state ctx) _site))
        (Ok types))]
    [(Err _)
      (begin
        (cfg
          compile-profile
          (compiler-tc-body-fact-profile-miss
            (tc-context-job-state ctx)
            (tc-global-shared-view _site)))
        (compiler-tc-reinfer-profiled
          ctx
          _site
          (tc-expr-list-types ctx env exprs)))]))

(define (tc-move-binding-type-id
  [site : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [maybe-ty : ast.AstMaybeType]
  [init-id : i64]) : ast.AstType
  (match maybe-ty
    [(Some t)
      (let
        [resolved : ast.AstType (tc-resolve-type ctx t)]
        (match (match (tc-body-let-init-type-lookup
          (tc-context-body-state ctx)
          init-id)
          [(Hit typed) (ResultTcType.Ok typed)]
          [(Miss)
            (tc-expr-with-expected-or-actual-id
              ctx
              env
              init-id
              (tc-global-shared-view resolved))])
          [(Ok init-ty)
            (if (tc-type-contains-any-region (tc-global-shared-view init-ty))
              init-ty
              resolved)]
          [(Err _) resolved]))]
    [(No)
      (match (tc-body-type-fact-expr-id site ctx env init-id)
        [(Ok t) t]
        [(Err _) (I64)])]))

;; Contextual typing is deliberately separate from non-contextual `tc-expr-id`:
;; the same node can produce a different result type when an expected type
;; guides literal, array, tuple, borrow, or call-argument typing.
(define (tc-expr-with-expected-or-actual-after-dotted-local-field-normalization
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [expected : ast.AstType]
  [allow-mut-by-value-borrow : bool]) : ResultTcType
  (match (tc-global-shared-view expr)
    [(Var name)
      (tc-expr-result-with-expected-or-actual
        ctx
        env
        expected
        allow-mut-by-value-borrow
        (tc-var-expr-after-local-field-check
          ctx
          env
          name
          (tc-hygiene-name-text-id-for-session
            (tc-context-structural-session ctx)
            name)))]
    [(Set name value-box)
      (tc-expr-result-with-expected-or-actual
        ctx
        env
        expected
        allow-mut-by-value-borrow
        (tc-set-expr-after-local-field-check ctx env name value-box))]
    [_
      (tc-expr-with-expected-or-actual-core
        ctx
        env
        expr
        expected
        allow-mut-by-value-borrow)]))

(define (tc-expr-with-expected-or-actual-core-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]
  [expected : ast.AstType]
  [allow-mut-by-value-borrow : bool]) : ResultTcType
  (if (or
    (= tc-semantic-observed-jobs 0)
    (= (tc-context-semantic-observer ctx).address 0))
    (tc-expr-with-expected-or-actual-core-id-inner
      ctx
      env
      expr-id
      expected
      allow-mut-by-value-borrow)
    (tc-semantic-expr-with-expected-or-actual-core-id
      ctx
      env
      expr-id
      expected
      allow-mut-by-value-borrow)))

;; Keep the ordinary tail call independent of observed-result storage. Both
;; paths call the same checker and normalize the same source node once.
(define (tc-semantic-expr-with-expected-or-actual-core-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]
  [expected : ast.AstType]
  [allow-mut-by-value-borrow : bool]) : ResultTcType
  (let
    [_semantic-enter : unit
      (when
        (and
          (> tc-semantic-observed-jobs 0)
          (!= (tc-context-semantic-observer ctx).address 0))
        (tc-semantic-observe-enter! ctx env expr-id))]
    [result : ResultTcType
      (tc-expr-with-expected-or-actual-core-id-inner
        ctx
        env
        expr-id
        expected
        allow-mut-by-value-borrow)]
    (if (not
      (or
        (= tc-semantic-observed-jobs 0)
        (= (tc-context-semantic-observer ctx).address 0)))
      (tc-semantic-observe-expression!
        ctx
        env
        expr-id
        (tc-global-shared-view result))
      unit)
    result))

(define (tc-expr-with-expected-or-actual-core-id-inner
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]
  [expected : ast.AstType]
  [allow-mut-by-value-borrow : bool]) : ResultTcType
  (let
    [expr : ast.AstExpr (tc-context-expr-get ctx expr-id)]
    (match (tc-global-shared-view expr)
      [(Var name)
        (if (or
          (macro-hygiene-global-id? (tc-context-structural-session ctx) name)
          (<
            (tc-dotted-name-first-dot-id
              (tc-context-structural-session ctx)
              name)
            0))
          (let
            [resolved-name
              (try
                (if (tc-bare-variant-name-gate? ctx name)
                  (tc-expected-bare-variant-retarget!
                    ctx
                    env
                    expr-id
                    name
                    (tc-global-shared-view expected))
                  (ResultTcNameId.Ok name)))]
            (tc-expr-with-expected-or-actual-after-dotted-local-field-normalization
              ctx
              env
              (if (= resolved-name name)
                expr
                (Var resolved-name))
              expected
              allow-mut-by-value-borrow))
          (let
            [_
              (try
                (tc-normalize-dotted-local-field-direct-node!
                  ctx
                  env
                  expr-id
                  expr))]
            (tc-expr-with-expected-or-actual-after-dotted-local-field-normalization
              ctx
              env
              (tc-context-expr-get ctx expr-id)
              expected
              allow-mut-by-value-borrow)))]
      [(Set name _)
        (if (or
          (macro-hygiene-global-id? (tc-context-structural-session ctx) name)
          (<
            (tc-dotted-name-first-dot-id
              (tc-context-structural-session ctx)
              name)
            0))
          (tc-expr-with-expected-or-actual-after-dotted-local-field-normalization
            ctx
            env
            expr
            expected
            allow-mut-by-value-borrow)
          (let
            [_
              (try
                (tc-normalize-dotted-local-field-direct-node!
                  ctx
                  env
                  expr-id
                  expr))]
            (tc-expr-with-expected-or-actual-after-dotted-local-field-normalization
              ctx
              env
              (tc-context-expr-get ctx expr-id)
              expected
              allow-mut-by-value-borrow)))]
      [_
        (tc-expr-with-expected-or-actual-core
          ctx
          env
          expr
          expected
          allow-mut-by-value-borrow)])))

(define (tc-expr-with-expected-or-actual-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]
  [expected : ast.AstType]) : ResultTcType
  (tc-expr-with-expected-or-actual-core-id ctx env expr-id expected false))

(define (tc-binop-type
  [op : ast.AstBinOp]
  [left : ast.AstType]
  [right : ast.AstType]) : ResultTcType
  (match op
    [(or (And) (Or))
      (if (and (tc-type-eq left (Bool)) (tc-type-eq right (Bool)))
        (Ok (Bool))
        (Err "typecheck: boolean operator expects bool operands"))]
    [(or (Eq) (Ne))
      (if (tc-type-eq left right)
        (Ok (Bool))
        (Err "typecheck: equality operands must match"))]
    [(or (Lt) (Le) (Gt) (Ge)) (tc-compare-binop-type left right)]
    [(or (Add) (Sub) (Mul) (Div)) (tc-arithmetic-binop-type left right)]
    [(or (Shl) (Shr)) (tc-shift-binop-type left right)]
    [_ (tc-integer-binop-type left right)]))

(define (tc-integer-binop-type [left : ast.AstType] [right : ast.AstType]) : ResultTcType
  (if (and
    (tc-integer-type? (tc-global-shared-view left))
    (tc-type-eq (tc-global-shared-view left) right))
    (Ok left)
    (Err
      (tc-kind-message
        (TypeMismatch)
        "typecheck: integer operator expects matching integer operands"))))

(define (tc-arithmetic-binop-type [left : ast.AstType] [right : ast.AstType]) : ResultTcType
  (if (and
    (tc-float-type? (tc-global-shared-view left))
    (tc-type-eq (tc-global-shared-view left) (tc-global-shared-view right)))
    (Ok left)
    (tc-integer-binop-type left right)))

(define (tc-shift-binop-type [left : ast.AstType] [right : ast.AstType]) : ResultTcType
  (if (tc-integer-type? (tc-global-shared-view left))
    (if (tc-integer-type? right)
      (Ok left)
      (Err "typecheck: shift count must be integer"))
    (Err "typecheck: shift left operand must be integer")))

(define (tc-compare-binop-type [left : ast.AstType] [right : ast.AstType]) : ResultTcType
  (if (and
    (tc-ordered-comparison-type? (tc-global-shared-view left))
    (tc-type-eq (tc-global-shared-view left) (tc-global-shared-view right)))
    (Ok (Bool))
    (Err
      (str_cat.str-cat
        "typecheck: comparison expects matching ordered scalar operands, got "
        (tc-type-render left)
        " and "
        (tc-type-render right)))))

(define (tc-unop-type [op : ast.AstUnOp] [ty : ast.AstType]) : ResultTcType
  (match op
    [(Not)
      (if (tc-type-eq ty (Bool))
        (Ok (Bool))
        (Err "typecheck: not expects bool"))]
    [(Neg)
      (if (or
        (tc-integer-type? (tc-global-shared-view ty))
        (tc-float-type? (tc-global-shared-view ty)))
        (Ok ty)
        (Err "typecheck: neg expects integer or float"))]
    [(BitNot)
      (if (tc-integer-type? (tc-global-shared-view ty))
        (Ok ty)
        (Err "typecheck: bit-not expects integer"))]))

(define (tc-default-builtin-unshadowed-scan-id?
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (match (tc-type-env-view env)
    [(Nil) false]
    [(Cache cache-ptr _ partial _ below)
      (let
        [ids : tc_i64_i64_map.Map
          (tc-type-env-cache-field-at cache-ptr 32 tc_i64_i64_map.Map)]
        [shadow-flags : (__tl_dyn-array i64)
          (tc-type-env-cache-field-at cache-ptr 72 (__tl_dyn-array i64))]
        (match (tc_i64_i64_map.get (& ids) name-id)
          [(LookupFound index)
            (=
              (bit-and
                (array-ref shadow-flags index)
                tc-env-cache-flag-default-shadow)
              0)]
          [(LookupMissing)
            (if partial
              (tc-default-builtin-unshadowed-scan-id? below name-id)
              true)]))]
    [(Bind key _ rest)
      (if (= key name-id)
        false
        (if (= key (tc-default-boundary-id))
          true
          (tc-default-builtin-unshadowed-scan-id? rest name-id)))]))

(define (tc-name-local-bound-before-module-scan-id?
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (match (tc-type-env-view env)
    [(Nil) false]
    [(Cache _ scan-through _ rest _)
      (if scan-through
        (tc-name-local-bound-before-module-scan-id? rest name-id)
        false)]
    [(Bind key _ rest)
      (if (= key name-id)
        true
        (tc-name-local-bound-before-module-scan-id? rest name-id))]))

(define (tc-top-level-value-owned-by-module-id?
  [ctx : TcContext]
  [module-id : i64]
  [name-id : i64]) : bool
  (let
    [symbols (tc-context-symbols ctx)]
    [handle : i64
      (csym.compiler-symbols-lookup-value-in-module-id-or
        symbols
        module-id
        name-id
        (csym.compiler-symbols-missing-handle))]
    (and
      (csym.compiler-symbols-handle-found? handle)
      ;; Module-qualified alias entries can point at declarations owned by a
      ;; different module.  Those aliases must not count as a definition-site
      ;; shadow of a compiler-private intrinsic.
      (=
        (csym.compiler-symbols-owner-module-id-at-index-or
          symbols
          (csym.compiler-symbol-handle-index handle)
          -2)
        module-id))))

(define (tc-private-intrinsic-unshadowed-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (and
    (cbi.compiler-builtin-private-intrinsic-id? name-id)
    ;; Function parameters and lexical bindings always shadow, including in an
    ;; imported body.  The scoped runtime holds the hot local stack separately;
    ;; the persistent scan covers callers that materialized that stack.
    (not
      (or
        (and
          (tc-type-env-scoped-runtime-active? env)
          (>= (tc-type-env-scoped-runtime-lookup-index env name-id) 0))
        (tc-name-local-bound-before-module-scan-id? env name-id)))
    ;; A top-level definition shadows only in the module that owns this body.
    ;; In an imported aggregate, the ordinary value env belongs to the caller,
    ;; while type-module-id retains the declaration's defining module.
    (not
      (let
        [module-id : i64 (tc-context-type-module-id ctx)]
        (if (csym.compiler-symbol-root-module-id? module-id)
          ;; Root-module probes used by the compiler's in-process source tests
          ;; rebuild the type env repeatedly while sharing symbol storage.  The
          ;; env is authoritative for an unqualified root definition.
          (tc-name-bound-id? env name-id)
          (tc-top-level-value-owned-by-module-id? ctx module-id name-id))))))

;; Compiler-private text inspectors expose ordinary callable signatures to
;; move/borrow analysis even though their direct calls still use intrinsic
;; result checking below. Keeping these signatures out of general expression
;; lookup preserves normal shadowing and avoids making CTFE evaluate the private
;; implementation functions while it is constructing their definitions.
(define (tc-private-string-intrinsic-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : ResultTcType
  (if (tc-private-intrinsic-unshadowed-id? ctx env name-id)
    (let
      [text : ast.AstType
        (ast.ast-ty-ref cbi.compiler-builtin-id-fix-value (& (Str)))]
      [left : ast.AstType
        (ast.ast-ty-ref cbi.compiler-builtin-id-fix-left (& (Str)))]
      [right : ast.AstType
        (ast.ast-ty-ref cbi.compiler-builtin-id-fix-right (& (Str)))]
      (cond
        [(= name-id cbi.compiler-builtin-id-tl-private-string-length)
          (Ok (tc-fn1 text (I64)))]
        [(= name-id cbi.compiler-builtin-id-tl-private-string-ref)
          (Ok (tc-fn2 text (I64) (Char)))]
        [(= name-id cbi.compiler-builtin-id-tl-private-string-eq)
          (Ok (tc-fn2 left right (Bool)))]
        [(= name-id cbi.compiler-builtin-id-tl-private-string-to-int)
          (Ok (tc-fn1 text (I64)))]
        [else (Err "")]))
    (Err "")))

(define (tc-private-string-intrinsic-call-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]) : ResultTcType
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-segment-bases ctx)
    (& func))
    [(Var raw-name)
      (let
        [raw-text : String
          (tc-hygiene-name-text-id-for-session
            (tc-context-structural-session ctx)
            raw-name)]
        [hygiene-global : bool
          (tc-hygiene-global-name-id?
            (tc-context-structural-session ctx)
            raw-name)]
        [name : String
          (if (and
            hygiene-global
            (not
              (macro-hygiene-global-id?
                (tc-context-structural-session ctx)
                raw-name)))
            (tc-hygiene-global-call-name raw-text)
            raw-text)]
        [name-id : i64
          (tc-builtin-call-name-id
            (tc-context-structural-session ctx)
            raw-name
            hygiene-global)]
        [lookup-id : i64 (tc-call-builtin-lookup-id ctx env name name-id)]
        (tc-private-string-intrinsic-type ctx env lookup-id))]
    [_ (Err "")]))

;; Source-level builtin dispatch observes module-local declaration
;; copies through `tc-name-bound-id?`. Dotted modules keep the authoritative
;; declaration under its qualified top-env key instead, so consult symbol
;; ownership when the exact environment lookup misses. Lexical and imported
;; bindings remain the first, cheap test.
(define (tc-source-value-bound-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (or
    (tc-name-bound-id? env name-id)
    (let
      [module-id : i64 (tc-context-type-module-id ctx)]
      (and
        (not (csym.compiler-symbol-root-module-id? module-id))
        (tc-top-level-value-owned-by-module-id? ctx module-id name-id)))))

(define (tc-default-builtin-unshadowed-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (if (cbi.compiler-builtin-typecheck-region-arg-id? name-id)
    (if (tc-type-env-scoped-runtime-active? env)
      (let
        [carrier : TcTypeEnvScopedCarrier
          (tc-type-env-scoped-runtime-current env)]
        [name-index : i64
          (tc-type-env-scoped-carrier-lookup-index carrier name-id)]
        [boundary-index : i64
          (tc-type-env-scoped-carrier-lookup-index
            carrier
            (tc-default-boundary-id))]
        [scoped : bool
          (cond
            [(>= name-index 0)
              (and (>= boundary-index 0) (> boundary-index name-index))]
            [(>= boundary-index 0) true]
            [else
              (begin
                (cfg
                  compile-profile
                  (counters.bump! tc-profile-env-scoped-tail-fallbacks))
                (tc-default-builtin-unshadowed-scan-id?
                  (__tl-project-field
                    (__tl-project-field carrier sidecar)
                    persistent)
                  name-id))])]
        scoped)
      (tc-default-builtin-unshadowed-scan-id? env name-id))
    false))

;; The type-handle flat lookup keys by the real intern id (so it misses non-root
;; names as intended -- the add path binds those under a
;; pair-key only the in-module probes reach). The variant registry keys by
;; name-id-key(intern "module/name") = composite-pair-key-id module-id name-id
;; for a non-root bare name; we compute that pair-key directly from the ids
;; instead of building and interning the qualified string.
(define (tc-constructor-non-root-bare-name-id?
  [session : cis.InternStructuralSessionHandle]
  [module : String]
  [name-id : i64]) : bool
  (and
    (> (string.string-length module) 0)
    (not (tc-name-qualified-id? session name-id))
    ;; Dotted enum variants use the qualified-variant cache domain below.
    ;; Treating one as a bare module-local name probes the wrong registry key
    ;; and can overwrite that same cache entry with a false miss.
    (< (tc-name-first-dot-id session name-id) 0)))

;; A hygienic global (a macro template's name, or a bare variant typecheck
;; qualified through its expected enum) names a constructor exactly when its
;; source spelling does in its definition module.
(define (tc-constructor-name-id? [ctx : TcContext] [name-id : i64]) : bool
  (if (macro-hygiene-global-id? (tc-context-structural-session ctx) name-id)
    (let
      [session : cis.InternStructuralSessionHandle
        (tc-context-structural-session ctx)]
      [source-id : i64
        (macro-hygiene-global-source-name-id-or session name-id -1)]
      [module-id : i64 (macro-hygiene-global-module-id session name-id)]
      (and
        (>= source-id 0)
        (tc-constructor-source-name-id?
          (if (csym.compiler-symbol-root-module-id? module-id)
            (tc-context-with-module-id ctx "" cbi.compiler-builtin-id-fix-empty)
            (tc-context-with-module-id
              ctx
              (tc-env-key-name-text module-id)
              module-id))
          source-id)))
    (tc-constructor-source-name-id? ctx name-id)))

(define (tc-constructor-source-name-id? [ctx : TcContext] [name-id : i64]) : bool
  (let
    [symbols : (& ctx csym.CompilerSymbols) (tc-context-symbols ctx)]
    [registries : (& ctx csym.CompilerRegistries) (tc-context-registries ctx)]
    [module : String (tc-context-module ctx)]
    [ctx-module-id : i64 (tc-context-module-id ctx)]
    [module-id : i64
      (if (> (string.string-length module) 0)
        ctx-module-id
        -1)]
    [non-root-bare? : bool
      (tc-constructor-non-root-bare-name-id?
        (tc-context-structural-session ctx)
        module
        name-id)]
    [variant-key : i64
      (if non-root-bare?
        (csym.compiler-composite-pair-key-id module-id name-id)
        name-id)]
    [handle : i64
      (tc-type-handle-lookup-id
        (tc-job-state-nominal-cache (tc-context-job-state ctx))
        (& symbols)
        name-id
        tc-type-handle-lookup-caller-constructor)]
    [variant-found : bool
      (if (and
        (not non-root-bare?)
        (tc-enum-qualified-variant-lookup-name-id?
          (tc-context-structural-session ctx)
          name-id))
        (match (tc-enum-qualified-variant-lookup-handle ctx name-id)
          [(Some _) true]
          [(None) false])
        (let
          [registry-id : i64 (csym.compiler-registries-identity registries)]
          [cached : i64
            (tc-context-source-qualified-variant-key-cache-get
              ctx
              registry-id
              ctx-module-id
              name-id)]
          (if (= cached -2)
            (match (csym.compiler-registries-lookup-variant-key-id
              registries
              (csym.compiler-symbol-name-id-key variant-key))
              [(Some variant-handle)
                (tc-context-source-qualified-variant-key-cache-put!
                  ctx
                  registry-id
                  ctx-module-id
                  name-id
                  variant-key
                  variant-handle)
                true]
              [(None)
                (tc-context-source-qualified-variant-key-cache-put!
                  ctx
                  registry-id
                  ctx-module-id
                  name-id
                  -1
                  -1)
                false])
            (>= cached 0))))]
    (if (csym.compiler-symbols-handle-found? handle)
      (if (=
        (csym.compiler-symbol-handle-kind handle)
        (csym.compiler-symbol-kind-defstruct))
        true
        variant-found)
      variant-found)))

(define (tc-call-allows-region-args-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (if (tc-default-builtin-unshadowed-id? env name-id)
    true
    (match (tc-active-region env)
      [(Some _) (tc-constructor-name-id? ctx name-id)]
      [(No) false])))

;; id-returning variant: AstExpr.Var already carries the interned i64 name id,
;; so callers that only need the id avoid the id->String (intern-str) round trip.
(define (tc-expr-var-name-id [expr-bases : i64] [expr : ast.AstExpr]) : i64
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(Var name) name]
    [_ -1]))

(define (tc-call-arity-message-prefix) : String
  (tc-kind-message (ArityMismatch) "typecheck: call arity mismatch: "))

(define (tc-call-arity-message? [message : (& message str)]) : bool
  (tc-diag-string-prefix? message (tc-call-arity-message-prefix)))

(define (tc-call-expr? [expr-bases : i64] [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(Call _ _) true]
    [_ false]))

(define (tc-locate-call-arity-error
  [expr-bases : i64]
  [inner : ast.AstExpr]
  [span : ast.AstSourceSpan]
  [message : String]) : ResultTcType
  (if (and
    (tc-call-expr? expr-bases inner)
    (tc-call-arity-message? message)
    (not (tc-encoded-error? message)))
    (Err (tc-located-error span message))
    (Err message)))

(define (tc-locate-spanned-error
  [expr-bases : i64]
  [session : cis.InternStructuralSessionHandle]
  [inner : ast.AstExpr]
  [span : ast.AstSourceSpan]
  [message : String]) : ResultTcType
  (if (tc-borrow-place-error-message? message)
    (Err (tc-rich-borrow-place-error span message))
    (match (tc-spanned-escape-error
      expr-bases
      session
      (tc-global-shared-view inner)
      span
      (tc-global-shared-view message))
      [(Some rich) (Err rich)]
      [(No) (tc-locate-call-arity-error expr-bases inner span message)])))

(define (tc-unbound-name-message-prefix) : String
  (tc-kind-message (UnboundName) "typecheck: unbound name "))

(define (tc-unbound-name-message? [message : (& message str)]) : bool
  (tc-diag-string-prefix? message (tc-unbound-name-message-prefix)))

(define (tc-unbound-suggestion-scope-module-id
  [ctx : TcContext]
  [name-id : i64]) : i64
  (if (< (tc-name-first-dot-id (tc-context-structural-session ctx) name-id) 0)
    (tc-context-module-id ctx)
    (let
      [alias-id : i64 (ci.intern-leading-dot-id name-id)]
      (match (tc-context-program ctx)
        [(Program decls-box)
          (match (tc-source-dotted-alias-target-id-in-context
            ctx
            (ast.ast-decl-list-box-shared-view decls-box)
            (tc-context-module-id ctx)
            alias-id)
            [(Some target-id) target-id]
            [(No) -1])]))))

;; These are compiler-recognized unqualified public names whose definitions
;; live in stdlib modules. Keep this catalog beside the typecheck suggestion
;; policy so a missing import can be diagnosed without loading or parsing
;; unrelated stdlib modules on an error path.
(define (tc-unbound-stdlib-provider [name : (& name str)]) : String
  (cond
    [(or
        (string.eq name "print-error")
        (string.eq name "print-format")
        (string.eq name "println")
        (string.eq name "panic")
        (string.eq name "error")
        (string.eq name "flush-stdout"))
      "stdlib.io"]
    [(or
        (string.eq name "string-length")
        (string.eq name "string-ref")
        (string.eq name "char-at")
        (string.eq name "string-eq")
        (string.eq name "string=?")
        (string.eq name "string-append")
        (string.eq name "string-concat"))
      "stdlib.string"]
    [else ""]))

(define (tc-unbound-import-help [name : String] [module : String]) : String
  (str_cat.str-cat
    name
    " is provided by "
    (tc-global-shared-view module)
    " — add (import "
    module
    ")"))

;; Removed public spellings can still receive migration help without becoming
;; compatibility aliases or pretending that an import makes them available.
(define (tc-unbound-migration-help [name : (& name str)]) : String
  (if (string.eq name "string->int")
    "string->int was removed — add (import stdlib.string) and use string.>int"
    ""))

(define (tc-unbound-suggestion-max-distance [name-len : i64]) : i64
  (cond [(<= name-len 4) 1] [(<= name-len 12) 2] [else 3]))

(define (tc-unbound-suggestion-candidate-name? [name : (& name str)]) : bool
  (let
    [n : i64 (string.string-length name)]
    [i : i64 0]
    [ok : bool (> n 0)]
    ;; Compiler-private names are implementation details, not useful fixes.
    (if (and
      (> n 1)
      (string.char-eq (string.string-ref name 0) '_')
      (string.char-eq (string.string-ref name 1) '_'))
      (set! ok false)
      unit)
    (while (and ok (< i n))
      (let
        [ch : char (string.string-ref name i)]
        (if (or
          (string.char-eq ch '.')
          (string.char-eq ch '/')
          (string.char-eq ch '\\'))
          (set! ok false)
          (set! i (+ i 1)))))
    ok))

(define (tc-unbound-string-less? [left : String] [right : String]) : bool
  (let
    [left-len : i64 (string.string-length left)]
    [right-len : i64 (string.string-length right)]
    [limit : i64
      (if (< left-len right-len)
        left-len
        right-len)]
    [i : i64 0]
    (while (< i limit)
      (let
        [left-byte : i64 (cast (string.string-ref left i) : i64)]
        [right-byte : i64 (cast (string.string-ref right i) : i64)]
        (cond
          [(< left-byte right-byte) (return true)]
          [(> left-byte right-byte) (return false)]
          [else (set! i (+ i 1))])))
    (< left-len right-len)))

;; Reuse three rows for every candidate. Suggestions run only after lookup has
;; failed, and this keeps the rare error path bounded to O(length(name)) storage.
(define (tc-unbound-edit-distance
  [wanted : String]
  [candidate : String]
  [previous-previous-row : (&mut previous-previous-row (__tl_dyn-array i64))]
  [previous-row : (&mut previous-row (__tl_dyn-array i64))]
  [current-row : (&mut current-row (__tl_dyn-array i64))]) : i64
  (let
    [wanted-len : i64 (string.string-length wanted)]
    [candidate-len : i64 (string.string-length candidate)]
    [j : i64 0]
    [i : i64 1]
    (while (<= j wanted-len)
      (set! (array-ref previous-row j) j)
      (set! j (+ j 1)))
    (while (<= i candidate-len)
      (set! (array-ref current-row 0) i)
      (set! j 1)
      (while (<= j wanted-len)
        (let
          [deletion : i64 (+ (array-ref previous-row j) 1)]
          [insertion : i64 (+ (array-ref current-row (- j 1)) 1)]
          [substitution : i64
            (+
              (array-ref previous-row (- j 1))
              (if (string.char-eq
                (string.string-ref candidate (- i 1))
                (string.string-ref wanted (- j 1)))
                0
                1))]
          [best : i64
            (if (< deletion insertion)
              deletion
              insertion)]
          (if (< substitution best)
            (set! best substitution)
            unit)
          ;; Optimal-string-alignment distance treats one adjacent swap
          ;; as one edit. The extra prior row keeps the error path
          ;; bounded to O(length(name)) storage.
          (when
            (and
              (> i 1)
              (> j 1)
              (string.char-eq
                (string.string-ref candidate (- i 1))
                (string.string-ref wanted (- j 2)))
              (string.char-eq
                (string.string-ref candidate (- i 2))
                (string.string-ref wanted (- j 1))))
            (let
              [transposition : i64
                (+ (array-ref previous-previous-row (- j 2)) 1)]
              (when (< transposition best) (set! best transposition))))
          (set! (array-ref current-row j) best)
          (set! j (+ j 1))))
      (set! j 0)
      (while (<= j wanted-len)
        (set! (array-ref previous-previous-row j) (array-ref previous-row j))
        (set! (array-ref previous-row j) (array-ref current-row j))
        (set! j (+ j 1)))
      (set! i (+ i 1)))
    (array-ref previous-row wanted-len)))

(defstruct TcUnboundVisibleNames
  (seen tc_i64_i64_map.Map)
  (ids (__tl_dyn-array i64))
  (len i64)
  (slots i64))

(define (tc-unbound-visible-names-new) : TcUnboundVisibleNames
  (TcUnboundVisibleNames
    (tc_i64_i64_map.with-capacity 128)
    (__tl_make-array i64 64)
    0
    0))

(define (tc-unbound-visible-names-copy-prefix!
  [src : (& src (__tl_dyn-array i64))]
  [dst : (&mut dst (__tl_dyn-array i64))]
  [len : i64]) : unit
  (let
    [index : i64 0]
    (while (< index len)
      (set! (array-ref dst index) (array-ref src index))
      (set! index (+ index 1)))))

(define (tc-unbound-visible-names-ensure-capacity!
  [names : (&mut names TcUnboundVisibleNames)]) : unit
  (if (< names.len (array-length names.ids))
    unit
    (let
      [old-capacity : i64 (array-length names.ids)]
      [next-capacity : i64
        (if (< old-capacity 1)
          64
          (* old-capacity 2))]
      [next : (__tl_dyn-array i64) (__tl_make-array i64 next-capacity)]
      (tc-unbound-visible-names-copy-prefix!
        (& names.ids)
        (&mut next)
        names.len)
      (set! names.ids next))))

(define (tc-unbound-visible-names-add!
  [names : (&mut names TcUnboundVisibleNames)]
  [candidate-id : i64]) : unit
  (if (and
    (>= candidate-id 0)
    (tc_i64_i64_map.insert-if-absent-ref! (&mut names.seen) candidate-id 1))
    (begin
      (tc-unbound-visible-names-ensure-capacity! names)
      (set! (array-ref names.ids names.len) candidate-id)
      (set! names.len (+ names.len 1))
      (cfg
        compile-profile
        (counters.bump! tc-profile-unbound-visible-candidates))
      unit)
    unit))

(define (tc-unbound-key-module-id
  [session : cis.InternStructuralSessionHandle]
  [key-id : i64]) : i64
  (cond
    [(and (tc-env-key-has-name-id? key-id) (ci.intern-qualified? key-id))
      (ci.intern-qualified-module-id key-id)]
    [(csym.compiler-composite-pair-key-id? key-id)
      (csym.compiler-composite-pair-left-id key-id)]
    [(>= key-id (ci.intern-structural-key-base))
      (match (cis.intern-structural-session-record-for-raw session key-id)
        [(Some record)
          (if (= record.kind (ci.intern-structural-kind-pair))
            record.left-id
            -1)]
        [(No) -1])]
    [else -1]))

(define (tc-unbound-key-base-id
  [session : cis.InternStructuralSessionHandle]
  [key-id : i64]) : i64
  (cond
    [(and (tc-env-key-has-name-id? key-id) (ci.intern-qualified? key-id))
      (ci.intern-qualified-base-id key-id)]
    [(csym.compiler-composite-pair-key-id? key-id)
      (csym.compiler-composite-pair-right-id key-id)]
    [(>= key-id (ci.intern-structural-key-base))
      (match (cis.intern-structural-session-record-for-raw session key-id)
        [(Some record)
          (if (= record.kind (ci.intern-structural-kind-pair))
            record.right-id
            -1)]
        [(No) -1])]
    [else key-id]))

;; Environment keys already encode the namespace in which a spelling is
;; visible. Invert that encoding once per live binding/cache entry instead of
;; scanning every intern spelling and reproving visibility with a chain lookup
;; for each candidate. Normalizing first also turns qualified renderable names
;; and hygienic globals into the same module/base key shape used by lookup.
(define (tc-unbound-visible-names-note-key!
  [names : (&mut names TcUnboundVisibleNames)]
  [session : cis.InternStructuralSessionHandle]
  [wanted-qualified : bool]
  [module-qualified : bool]
  [target-module-id : i64]
  [raw-key-id : i64]) : unit
  (let
    [key-id : i64 (tc-env-name-key-id session raw-key-id)]
    [key-module-id : i64 (tc-unbound-key-module-id session key-id)]
    [source-id : i64
      (cond
        [(>= key-module-id 0)
          (if (= key-module-id target-module-id)
            (tc-env-key-source-id-or-neg
              session
              (tc-unbound-key-base-id session key-id))
            -1)]
        [wanted-qualified
          (if (and
            (>= target-module-id 0)
            (csym.compiler-symbol-root-module-id? target-module-id))
            (tc-env-key-source-id-or-neg session key-id)
            -1)]
        [else (tc-env-key-source-id-or-neg session key-id)])]
    (begin
      (set! names.slots (+ names.slots 1))
      (cfg compile-profile (counters.bump! tc-profile-unbound-candidate-slots))
      (if (and
        (>= source-id 0)
        (or wanted-qualified (< key-module-id 0) module-qualified))
        (tc-unbound-visible-names-add! names source-id)
        unit))))

(define (tc-unbound-visible-names-persistent!
  [names : (&mut names TcUnboundVisibleNames)]
  [session : cis.InternStructuralSessionHandle]
  [wanted-qualified : bool]
  [module-qualified : bool]
  [target-module-id : i64]
  [env : TcTypeEnv]) : unit
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    [done : bool false]
    (while (not done)
      (cond
        [(>= head 0)
          (let
            [binding-ptr : (Ptr TcTypeEnvBinding)
              (tc-type-env-binding-ptr store-handle head)]
            (tc-unbound-visible-names-note-key!
              names
              session
              wanted-qualified
              module-qualified
              target-module-id
              (tc-type-env-binding-name-at binding-ptr))
            (set! head (tc-type-env-binding-parent-at binding-ptr)))]
        [(< head -1)
          (let
            [cache : TcTypeEnvCache
              (tc-type-env-cache-at
                (tc-type-env-cache-ptr
                  store-handle
                  (tc-type-env-cache-index head)))]
            [ids : tc_i64_i64_map.Map cache.ids]
            [remaining : i64 (tc_i64_i64_map.len (& ids))]
            [cursor : i64 0]
            (while (> remaining 0)
              (set! cursor (tc_i64_i64_map.next-occupied (& ids) cursor))
              (match (tc_i64_i64_map.entry-at (& ids) cursor)
                [(EntrySome key-id _)
                  (tc-unbound-visible-names-note-key!
                    names
                    session
                    wanted-qualified
                    module-qualified
                    target-module-id
                    key-id)]
                [(EntryNone) unit])
              (set! cursor (+ cursor 1))
              (set! remaining (- remaining 1)))
            (if cache.partial
              (set! head cache.below)
              (set! done true)))]
        [else (set! done true)]))))

(define (tc-unbound-visible-names
  [module-qualified : bool]
  [target-module-id : i64]
  [wanted-qualified : bool]
  [env : TcTypeEnv]) : TcUnboundVisibleNames
  (let
    [session : cis.InternStructuralSessionHandle
      (tc-type-env-structural-session env)]
    [names : TcUnboundVisibleNames (tc-unbound-visible-names-new)]
    (if (tc-type-env-scoped-runtime-active? env)
      (let
        [carrier : TcTypeEnvScopedCarrier
          (tc-type-env-scoped-runtime-current env)]
        [sidecar : TcTypeEnvScopedSidecar carrier.sidecar]
        [stack : TcTypeEnvScopedStack sidecar.stack]
        [index : i64 (- stack.slot-count 1)]
        (while (>= index sidecar.materialize-start)
          (let
            [slot : TcTypeEnvScopedSlot
              (tc-global-array-element-shared-view stack.slots index)]
            (tc-unbound-visible-names-note-key!
              (&mut names)
              session
              wanted-qualified
              module-qualified
              target-module-id
              slot.name-id)
            (set! index (- index 1))))
        (tc-unbound-visible-names-persistent!
          (&mut names)
          session
          wanted-qualified
          module-qualified
          target-module-id
          sidecar.persistent))
      (tc-unbound-visible-names-persistent!
        (&mut names)
        session
        wanted-qualified
        module-qualified
        target-module-id
        env))
    names))

(define (tc-unbound-better-candidate?
  [distance : i64]
  [best-distance : i64]
  [candidate : String]
  [best : String]) : bool
  (or
    (< distance best-distance)
    (and
      (= distance best-distance)
      (or (string.eq best "") (tc-unbound-string-less? candidate best)))))

;; A speculative typecheck whose failure the caller discards (a macro operand
;; probe) must not pay for a "did you mean" suggestion: finalizing one unbound
;; name scans every visible name, and a self-compile discards many such
;; errors. The depth lives in the job-owned scoped
;; state reached through the environment, so no other job is affected and no
;; signature has to carry it. Only a caller that drops the error unconditionally
;; may open this scope; a reported diagnostic must keep its suggestion.
(define (tc-unbound-suggestion-suppress-depth [env : TcTypeEnv]) : i64
  (tc-type-env-scoped-state-field
    (tc-type-env-scoped-state env)
    unbound-suggestion-suppress-depth
    i64))

(define (tc-unbound-suggestion-suppress-depth-set!
  [env : TcTypeEnv]
  [depth : i64]) : unit
  (let
    [state : TcTypeEnvScopedState (tc-type-env-scoped-state env)]
    (unsafe
      (ptr-write!
        (ptr-cast
          (ptr-offset
            (int->ptr (cast state.address : u64) : (Ptr u8))
            (comptime
              (offset-of
                (type TcTypeEnvScopedStateData)
                unbound-suggestion-suppress-depth)))
          : (MutPtr i64))
        depth))))

(define (tc-unbound-suggestions-suppress-push! [env : TcTypeEnv]) : unit
  (tc-unbound-suggestion-suppress-depth-set!
    env
    (+ (tc-unbound-suggestion-suppress-depth env) 1)))

(define (tc-unbound-suggestions-suppress-pop! [env : TcTypeEnv]) : unit
  (let
    [depth : i64 (tc-unbound-suggestion-suppress-depth env)]
    (if (> depth 0)
      (tc-unbound-suggestion-suppress-depth-set! env (- depth 1))
      (io.panic "typecheck: unbalanced unbound-suggestion suppression scope"))))

(define (tc-unbound-near-miss
  [module-qualified : bool]
  [module-id : i64]
  [env : TcTypeEnv]
  [wanted : String]
  [wanted-id : i64]) : String
  (cond
    [(> (tc-unbound-suggestion-suppress-depth env) 0) ""]
    [else
      (tc-unbound-near-miss-scan
        module-qualified
        module-id
        env
        wanted
        wanted-id)]))

(define (tc-unbound-near-miss-scan
  [module-qualified : bool]
  [module-id : i64]
  [env : TcTypeEnv]
  [wanted : String]
  [wanted-id : i64]) : String
  (let
    [wanted-separator : i64 (tc-name-first-char wanted '.')]
    [wanted-qualified : bool (>= wanted-separator 0)]
    [wanted-qualifier : String
      (if wanted-qualified
        (string.substring wanted 0 wanted-separator)
        "")]
    [wanted-qualifier-id : i64
      (if wanted-qualified
        (if (>= module-id 0)
          module-id
          (ci.intern (tc-global-shared-view wanted-qualifier)))
        -1)]
    [wanted-text : String
      (if wanted-qualified
        (string.substring
          wanted
          (+ wanted-separator 1)
          (- (string.string-length wanted) (+ wanted-separator 1)))
        wanted)]
    [wanted-len : i64 (string.string-length wanted-text)]
    [max-distance : i64 (tc-unbound-suggestion-max-distance wanted-len)]
    [visible : TcUnboundVisibleNames
      (tc-unbound-visible-names
        module-qualified
        (if wanted-qualified
          wanted-qualifier-id
          module-id)
        wanted-qualified
        env)]
    [previous-previous-row : (__tl_dyn-array i64)
      (__tl_make-array i64 (+ wanted-len 1))]
    [previous-row : (__tl_dyn-array i64) (__tl_make-array i64 (+ wanted-len 1))]
    [current-row : (__tl_dyn-array i64) (__tl_make-array i64 (+ wanted-len 1))]
    [candidate-index : i64 0]
    [best-distance : i64 (+ max-distance 1)]
    [best : String ""]
    (begin
      (cfg compile-profile (counters.bump! tc-profile-unbound-scans))
      (while (< candidate-index visible.len)
        (let
          [candidate-id : i64 (array-ref visible.ids candidate-index)]
          [candidate : String (ci.intern-str candidate-id)]
          [candidate-len : i64 (string.string-length candidate)]
          [suggestable : bool (tc-unbound-suggestion-candidate-name? candidate)]
          (if (and
            (not (= candidate-id wanted-id))
            suggestable
            (or
              (not wanted-qualified)
              (not (ci.intern-qualified? candidate-id)))
            (<=
              (if (> candidate-len wanted-len)
                (- candidate-len wanted-len)
                (- wanted-len candidate-len))
              max-distance))
            (begin
              (cfg
                compile-profile
                (counters.bump! tc-profile-unbound-length-survivors))
              (let
                [_note-edit : unit
                  (cfg
                    compile-profile
                    (counters.bump! tc-profile-unbound-edit-evaluations))]
                [distance : i64
                  (tc-unbound-edit-distance
                    (tc-global-shared-view wanted-text)
                    (tc-global-shared-view candidate)
                    (&mut previous-previous-row)
                    (&mut previous-row)
                    (&mut current-row))]
                [better : bool
                  (and
                    (<= distance max-distance)
                    (tc-unbound-better-candidate?
                      distance
                      best-distance
                      (tc-global-shared-view candidate)
                      (tc-global-shared-view best)))]
                (when
                  better
                  (set! best-distance distance)
                  (set!
                    best
                    (if wanted-qualified
                      (tc-name-slashes-to-dots
                        (csym.compiler-symbol-module-key
                          (tc-global-shared-view wanted-qualifier)
                          candidate))
                      (string.copy candidate))))))
            unit)
          (set! candidate-index (+ candidate-index 1))))
      best)))

(defenum TcUnboundSuggestion
  (No)
  (Help String)
  (Replace String String))

(define (tc-unbound-suggestion
  [module-qualified : bool]
  [module-id : i64]
  [env : TcTypeEnv]
  [name : String]
  [name-id : i64]) : TcUnboundSuggestion
  (let
    [migration : String (tc-unbound-migration-help name)]
    (if (> (string.string-length migration) 0)
      (Help migration)
      (let
        [provider : String (tc-unbound-stdlib-provider name)]
        (if (> (string.string-length provider) 0)
          (Help (tc-unbound-import-help name provider))
          (let
            [near-miss : String
              (tc-unbound-near-miss module-qualified module-id env name name-id)]
            (if (> (string.string-length near-miss) 0)
              (Replace
                (str_cat.str-cat
                  "did you mean "
                  (tc-global-shared-view near-miss)
                  "?")
                near-miss)
              (No))))))))

(define (tc-unbound-finalize-located-error [message : String]) : String
  (begin
    (cfg compile-profile (counters.bump! tc-profile-unbound-finalizers))
    (if (and (tc-located-error? message) (not (tc-rich-error? message)))
      (let
        [prefix-len : i64 (string.string-length (tc-located-error-prefix))]
        [line-end : i64 (tc-located-error-field-end message prefix-len)]
        [col-start : i64 (+ line-end 1)]
        [col-end : i64 (tc-located-error-field-end message col-start)]
        [end-line-start : i64 (+ col-end 1)]
        [end-line-end : i64 (tc-located-error-field-end message end-line-start)]
        [end-col-start : i64 (+ end-line-end 1)]
        [end-col-end : i64 (tc-located-error-field-end message end-col-start)]
        [clean-start : i64 (+ end-col-end 1)]
        [clean-message : String
          (string.substring
            message
            clean-start
            (- (string.string-length message) clean-start))]
        (if (tc-unbound-name-message? clean-message)
          (match tc-unbound-suggestion-snapshot
            [(Some module-qualified module-id env name-id)
              (let
                [name : String
                  (tc-name-slashes-to-dots
                    (tc-hygiene-name-text-id-for-session
                      (tc-type-env-structural-session env)
                      name-id))]
                [clean-name : String
                  (string.substring
                    clean-message
                    (string.string-length (tc-unbound-name-message-prefix))
                    (-
                      (string.string-length clean-message)
                      (string.string-length (tc-unbound-name-message-prefix))))]
                [display-message : String
                  (str_cat.str-cat
                    (tc-unbound-name-message-prefix)
                    (tc-global-shared-view name))]
                (if (string.eq (tc-name-slashes-to-dots clean-name) name)
                  (let
                    [span : ast.AstSourceSpan
                      (ast.ast-source-span
                        (string.>int
                          (tc-located-error-field message prefix-len line-end))
                        (string.>int
                          (tc-located-error-field message col-start col-end))
                        (string.>int
                          (tc-located-error-field
                            message
                            end-line-start
                            end-line-end))
                        (string.>int
                          (tc-located-error-field
                            message
                            end-col-start
                            end-col-end)))]
                    (match (tc-unbound-suggestion
                      module-qualified
                      module-id
                      env
                      (tc-global-shared-view name)
                      name-id)
                      [(Help help)
                        (tc-rich-error-with-help span display-message help)]
                      [(Replace help replacement)
                        (tc-rich-error-with-machine-fix
                          span
                          (ast.ast-source-span
                            (ast.ast-source-span-start-line span)
                            (ast.ast-source-span-start-col span)
                            (ast.ast-source-span-start-line span)
                            (+
                              (ast.ast-source-span-start-col span)
                              (string.string-length name)))
                          display-message
                          help
                          replacement)]
                      [(No) (tc-located-error span display-message)]))
                  message))]
            [(No) message])
          message))
      message)))

(define (tc-locate-integer-binop-error
  [ctx : TcContext]
  [env : TcTypeEnv]
  [left-id : i64]
  [right-id : i64]
  [fallback : ast.AstSourceSpan]
  [message : String]) : ResultTcType
  (let
    [saved : TcTypeEnvScopedRuntimeSave (tc-type-env-scoped-runtime-save env)]
    [left : ast.AstExpr (tc-context-expr-get ctx left-id)]
    [right : ast.AstExpr (tc-context-expr-get ctx right-id)]
    [result : ResultTcType
      (match (tc-expr ctx env left)
        [(Ok left-ty)
          (match (tc-expr ctx env (tc-global-shared-view right))
            [(Ok right-ty)
              (if (and
                (or
                  (tc-integer-type? (tc-global-shared-view left-ty))
                  (tc-float-type? (tc-global-shared-view left-ty)))
                (not
                  (tc-type-eq
                    (tc-global-shared-view left-ty)
                    (tc-global-shared-view right-ty))))
                (Err
                  (tc-located-error
                    (match right
                      [(Spanned _ right-span) right-span]
                      [_ fallback])
                    (tc-type-mismatch-message right-ty left-ty message)))
                (Err (tc-located-error fallback message)))]
            [(Err _) (Err (tc-located-error fallback message))])]
        [(Err _) (Err (tc-located-error fallback message))])]
    (tc-type-env-scoped-runtime-restore! saved)
    result))

(define (tc-locate-spanned-error-with-context
  [ctx : TcContext]
  [env : TcTypeEnv]
  [inner : ast.AstExpr]
  [span : ast.AstSourceSpan]
  [message : String]) : ResultTcType
  (cond
    [(and (tc-unbound-name-message? message) (not (tc-encoded-error? message)))
      (match (tc-global-shared-view inner)
        [(Var name-id)
          (tc-unbound-suggestion-snapshot-record! ctx env name-id)
          (Err (tc-located-error span message))]
        [_
          (tc-locate-spanned-error
            (tc-context-expr-bases ctx)
            (tc-context-structural-session ctx)
            inner
            span
            message)])]
    [(and
        (or
          (tc-message-text-prefix? (& message) "typecheck: ambiguous `")
          (tc-message-text-prefix? (& message) "typecheck: ambiguous variant `"))
        (not (tc-encoded-error? message)))
      (match (tc-global-shared-view inner)
        [(or (Var _) (Call _ _)) (Err (tc-located-error span message))]
        [_
          (tc-locate-spanned-error
            (tc-context-expr-bases ctx)
            (tc-context-structural-session ctx)
            inner
            span
            message)])]
    [(and
        (tc-message-text-is?
          (& message)
          "typecheck: integer operator expects matching integer operands")
        (not (tc-encoded-error? message)))
      (match (tc-global-shared-view inner)
        [(Binary _ left-id right-id)
          (tc-locate-integer-binop-error ctx env left-id right-id span message)]
        [_
          (tc-locate-spanned-error
            (tc-context-expr-bases ctx)
            (tc-context-structural-session ctx)
            inner
            span
            message)])]
    [(and
        (or
          (tc-message-text-prefix?
            (& message)
            "typecheck: unknown struct field ")
          (tc-message-text-prefix?
            (& message)
            "typecheck: cannot assign to function `"))
        (not (tc-encoded-error? message)))
      (match (tc-global-shared-view inner)
        [(or (Set _ _) (StructSet _ _ _) (StructGet _ _))
          (Err (tc-located-error span message))]
        [_
          (tc-locate-spanned-error
            (tc-context-expr-bases ctx)
            (tc-context-structural-session ctx)
            inner
            span
            message)])]
    [else
      (match (tc-global-shared-view inner)
        [(Set _ _) (Err message)]
        [(Spanned nested-box _)
          (tc-locate-spanned-error
            (tc-context-expr-bases ctx)
            (tc-context-structural-session ctx)
            (tc-context-expr-get ctx nested-box)
            span
            message)]
        [_
          (tc-locate-spanned-error
            (tc-context-expr-bases ctx)
            (tc-context-structural-session ctx)
            inner
            span
            message)])]))

(define (tc-call-arity-callee-name [expr-bases : i64] [func : ast.AstExpr]) : String
  (let
    [nid : i64 (tc-expr-var-name-id expr-bases (tc-global-shared-view func))]
    (if (>= nid 0)
      (tc-hygiene-name-text-id nid)
      (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& func))
        [(Lambda _) "lambda"]
        [_ "call target"]))))

(define (tc-call-arity-argument-word [count : i64]) : String
  (if (= count 1)
    " argument"
    " arguments"))

(define (tc-call-arity-count-message
  [expr-bases : i64]
  [func : ast.AstExpr]
  [expected : i64]
  [actual : i64]) : String
  (str_cat.str-cat
    (tc-call-arity-message-prefix)
    (tc-call-arity-callee-name expr-bases func)
    " expected "
    (string.int->string expected)
    (tc-call-arity-argument-word expected)
    ", got "
    (string.int->string actual)
    (tc-call-arity-argument-word actual)))

(define (tc-call-arity-message
  [expr-bases : i64]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]) : String
  (tc-call-arity-count-message
    expr-bases
    func
    (tc-type-list-len params)
    (tc-expr-list-len args)))

(define (tc-call-fixed-arity-message
  [expr-bases : i64]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [expected : i64]) : String
  (tc-call-arity-count-message expr-bases func expected (tc-expr-list-len args)))

(define (tc-call-arity-invariant-message [phase : String]) : String
  (str_cat.str-cat "typecheck: internal " phase " call arity invariant failed"))

(define (tc-call-direct-value-handle [ctx : TcContext] [func : ast.AstExpr]) : i64
  (let
    [name-id : i64
      (tc-expr-var-name-id (tc-context-expr-segment-bases ctx) func)]
    [module-id : i64 (tc-context-module-id ctx)]
    [symbols-ctx : TcContext ctx]
    (if (< name-id 0)
      (csym.compiler-symbols-missing-handle)
      (let
        [lookup-id : i64
          (tc-env-name-key-id (tc-context-structural-session ctx) name-id)]
        (if (or
          (macro-hygiene-global-id? (tc-context-structural-session ctx) name-id)
          (tc-name-qualified-id? (tc-context-structural-session ctx) name-id))
          (csym.compiler-symbols-lookup-value-id-or
            (tc-context-symbols symbols-ctx)
            lookup-id
            (csym.compiler-symbols-missing-handle))
          (csym.compiler-symbols-lookup-value-in-module-id-or
            (tc-context-symbols symbols-ctx)
            module-id
            lookup-id
            (csym.compiler-symbols-missing-handle)))))))

(define (tc-call-param-list-name-at
  [params : (& params ast.AstParamList)]
  [index : i64]) : TcMaybeNameId
  (if (or (< index 0) (>= index (ast.ast-param-list-len params)))
    No
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param name _ _) (Some name)])))

(define (tc-call-field-list-name-at
  [fields : (& fields ast.AstFieldDefList)]
  [index : i64]) : TcMaybeNameId
  (if (or (< index 0) (>= index (ast.ast-field-def-list-len fields)))
    No
    (match (ast.ast-field-def-list-get
      fields
      index
      (ast.ast-field-def-fallback))
      [(Def name _ _) (Some (ci.intern-syntax-id-value name))])))

(define (tc-call-decl-param-name-at [decl : ast.AstDecl] [index : i64]) : TcMaybeNameId
  (match decl
    [(DefFn decl-meta _ params _ _ _)
      (tc-call-param-list-name-at (& params) index)]
    [(or (DefStruct _ _ _ _ fields) (DefStructLifetimes _ _ _ _ _ fields))
      (tc-call-field-list-name-at (& fields) index)]
    [(Unsafe inner-box)
      (tc-call-decl-param-name-at
        (ast.ast-decl-box-shared-view inner-box)
        index)]
    [_ No]))

(define (tc-call-parameter-name-at
  [ctx : TcContext]
  [func : ast.AstExpr]
  [index : i64]) : TcMaybeNameId
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-segment-bases ctx)
    (& func))
    [(Lambda lambda-box)
      (match (ast.ast-lambda-box-shared-view lambda-box)
        [(Lambda params _ _) (tc-call-param-list-name-at (& params) index)])]
    [_
      (let
        [handle : i64 (tc-call-direct-value-handle ctx func)]
        (if (csym.compiler-symbols-handle-found? handle)
          (match (csym.compiler-symbols-decl-at-index
            (tc-context-symbols ctx)
            (csym.compiler-symbol-handle-index handle))
            [(Ok decl) (tc-call-decl-param-name-at decl index)]
            [(Err _) No])
          No))]))

(define (tc-call-argument-message-prefix
  [ctx : TcContext]
  [func : ast.AstExpr]
  [index : i64]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (TypeMismatch))
    "typecheck: call `"
    (tc-call-arity-callee-name
      (tc-context-expr-segment-bases ctx)
      (tc-global-shared-view func))
    "` argument "
    (string.int->string (+ index 1))
    (match (tc-call-parameter-name-at ctx func index)
      [(Some name-id)
        (str_cat.str-cat
          " (parameter `"
          (tc-hygiene-name-text-id-for-session
            (tc-context-structural-session ctx)
            name-id)
          "`)")]
      [(No) ""])
    " type mismatch"))

(define (tc-call-argument-expected-text-message
  [ctx : TcContext]
  [func : ast.AstExpr]
  [index : i64]
  [actual : ast.AstType]
  [expected : String]) : String
  (str_cat.str-cat
    (tc-call-argument-message-prefix ctx func index)
    ": expected "
    expected
    ", found "
    (tc-type-render (tc-type-without-regions actual))))

;; Deferred arity-mismatch message. tc-call-arity-message is real work (two
;; list-length walks, callee-name unspan/intern, two string.int->string division loops,
;; seven string-appends) but it is only ever consumed on the arity-mismatch error
;; path, which never fires while typechecking well-formed code (the self-compile).
;; Carrying the ingredients in this enum and materializing the text only at the
;; error arms keeps the success path -- the overwhelmingly common one -- free of
;; that build, with byte-identical output for accepted programs and identical
;; diagnostics for rejected ones.
(defenum TcArityMessage
  (Detailed ast.AstExpr ast.AstExprList ast.AstTypeList))

(define (tc-arity-message-text [expr-bases : i64] [arity-msg : TcArityMessage]) : String
  (match arity-msg
    [(Detailed func args params)
      (tc-call-arity-message expr-bases func args params)]))

(define (tc-argument-message-prefix-text
  [ctx : TcContext]
  [arity-msg : TcArityMessage]
  [index : i64]) : String
  (match arity-msg
    [(Detailed func _ _) (tc-call-argument-message-prefix ctx func index)]))

(define (tc-nullary-variant-call-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [enum-name-id : i64]
  [ret : ast.AstType]) : ResultTcType
  (let
    [nid : i64
      (tc-expr-var-name-id
        (tc-context-expr-segment-bases ctx)
        (tc-global-shared-view func))]
    (if (>= nid 0)
      (let
        [symbols-ctx : TcContext ctx]
        [handle : i64
          (tc-source-variant-handle-for-enum-id-or
            ctx
            enum-name-id
            nid
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? handle)
          (if (tc-nominal-name-id-eq?
            (tc-variant-owner-id-or ctx handle -1)
            enum-name-id)
            (let
              [fields : ast.AstTypeList
                (try
                  (csym.compiler-registries-variant-fields-indexed
                    (tc-context-symbols symbols-ctx)
                    handle))]
              (if (ast.ast-type-list-empty? (& fields))
                (Ok (tc-tag-active-region env ret))
                (Err
                  (tc-call-arity-count-message
                    (tc-context-expr-segment-bases ctx)
                    func
                    (ast.ast-type-list-len (& fields))
                    0))))
            (Err "typecheck: call target is not a function"))
          (if (tc-name-qualified-id?
            (tc-context-structural-session ctx)
            enum-name-id)
            (Ok (tc-tag-active-region env ret))
            (Err "typecheck: call target is not a function"))))
      (Err "typecheck: call target is not a function"))))

(define (tc-call-region-args-allowed-for-func
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]) : bool
  (let
    [name-id : i64
      (tc-expr-var-name-id (tc-context-expr-segment-bases ctx) func)]
    (if (>= name-id 0)
      (tc-call-allows-region-args-id? ctx env name-id)
      false)))

(define (tc-call-constructor-target-for-func
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [params : ast.AstTypeList]
  [ret : ast.AstType]) : ast.AstMaybeType
  (let
    [name-id : i64
      (tc-expr-var-name-id (tc-context-expr-segment-bases ctx) func)]
    (if (>= name-id 0)
      (if (tc-constructor-name-id? ctx name-id)
        (Some (tc-constructor-target-type env params ret))
        (No))
      (No))))

(define (tc-lifetime-constructor-ret? [ret : ast.AstType]) : bool
  (match ret
    [(or (StructArgs _ lifetimes) (EnumArgs _ lifetimes))
      (> (tc-lifetime-list-count (deref lifetimes)) 0)]
    [_ false]))

(define (tc-call-lifetime-constructor-for-func?
  [ctx : TcContext]
  [func : ast.AstExpr]
  [ret : ast.AstType]) : bool
  (if (tc-lifetime-constructor-ret? ret)
    (let
      [name-id : i64
        (tc-expr-var-name-id (tc-context-expr-segment-bases ctx) func)]
      (if (>= name-id 0)
        (tc-constructor-name-id? ctx name-id)
        false))
    false))

(define (tc-lifetime-subst-type-list
  [subst : TcLifetimeSubst]
  [types : ast.AstTypeList]) : ast.AstTypeList
  (let
    [out : ast.AstTypeList
      (ast.ast-type-list-with-capacity (ast.ast-type-list-len (& types)))]
    (tc-lifetime-subst-type-list-into subst (& types) (&mut out) 0)
    out))

(define (tc-lifetime-subst-type-list-into
  [subst : TcLifetimeSubst]
  [types : (& types ast.AstTypeList)]
  [out : (&mut out ast.AstTypeList)]
  [index : i64]) : unit
  (unless
    (>= index (ast.ast-type-list-len types))
    (ast.ast-type-list-push
      out
      (ast.ast-node-pool-reader-type-push
        (&
          (tc-lifetime-subst-type
            subst
            (ast.ty-node-get
              (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))))))
    (tc-lifetime-subst-type-list-into subst types out (+ index 1))))

(define (tc-lifetime-subst-type [subst : TcLifetimeSubst] [ty : ast.AstType]) : ast.AstType
  (match (tc-global-shared-view ty)
    [(Func args ret)
      (ast.ast-ty-func
        (tc-lifetime-subst-type-list
          subst
          (ast.ast-type-list-box-shared-view args))
        (& (tc-lifetime-subst-type subst (ast.ty-node-get ret))))]
    [(Tuple elems)
      (ast.ast-ty-tuple
        (tc-lifetime-subst-type-list
          subst
          (ast.ast-type-list-box-shared-view elems)))]
    [(Array elem len)
      (ast.ast-ty-array
        (& (tc-lifetime-subst-type subst (ast.ty-node-get elem)))
        len)]
    [(DynArray elem)
      (ast.ast-ty-dyn-array
        (& (tc-lifetime-subst-type subst (ast.ty-node-get elem))))]
    [(Slice elem)
      (ast.ast-ty-slice
        (& (tc-lifetime-subst-type subst (ast.ty-node-get elem))))]
    [(Box elem)
      (ast.ast-ty-box (& (tc-lifetime-subst-type subst (ast.ty-node-get elem))))]
    [(Ptr elem)
      (ast.ast-ty-ptr (& (tc-lifetime-subst-type subst (ast.ty-node-get elem))))]
    [(MutPtr elem)
      (ast.ast-ty-mut-ptr
        (& (tc-lifetime-subst-type subst (ast.ty-node-get elem))))]
    [(Ref lifetime inner)
      (ast.ast-ty-ref
        (tc-lifetime-subst-apply subst lifetime)
        (& (tc-lifetime-subst-type subst (ast.ty-node-get inner))))]
    [(MutRef lifetime inner)
      (ast.ast-ty-mut-ref
        (tc-lifetime-subst-apply subst lifetime)
        (& (tc-lifetime-subst-type subst (ast.ty-node-get inner))))]
    [(Region region inner)
      (ast.ast-ty-region
        (tc-lifetime-subst-apply subst region)
        (& (tc-lifetime-subst-type subst (ast.ty-node-get inner))))]
    [(Invalidate lifetime inner)
      (ast.ast-ty-invalidate
        (tc-lifetime-subst-apply subst lifetime)
        (& (tc-lifetime-subst-type subst (ast.ty-node-get inner))))]
    [(EnumArgs name lifetimes)
      (ast.ast-ty-enum-args
        name
        (tc-lifetime-subst-list
          subst
          (ast.ast-lifetime-list-box-shared-view lifetimes)))]
    [(StructArgs name lifetimes)
      (ast.ast-ty-struct-args
        name
        (tc-lifetime-subst-list
          subst
          (ast.ast-lifetime-list-box-shared-view lifetimes)))]
    [(VarArgs name lifetimes)
      (ast.ast-ty-var-args
        name
        (tc-lifetime-subst-list
          subst
          (ast.ast-lifetime-list-box-shared-view lifetimes)))]
    [_ ty]))

(define (tc-call-lifetime-subst-mismatch-message) : String
  "typecheck: internal call lifetime substitution mismatch")

(define (tc-infer-lifetime-name
  [params : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : i64]
  [actual : i64]) : ResultTcLifetimeSubst
  (if (tc-lifetime-list-contains params formal)
    (tc-lifetime-subst-bind subst formal actual)
    (if (= formal actual)
      (Ok subst)
      (Err (tc-call-lifetime-subst-mismatch-message)))))

;; Call inference follows the formal occurrence's structural variance. A
;; covariant occurrence contributes an upper bound and therefore keeps the
;; shortest comparable actual lifetime; a contravariant occurrence contributes
;; a lower bound and keeps the longest. Invariant occurrences must agree
;; exactly. Shadowing is safe because substitution lookup returns the newest
;; binding first, and the fully substituted call is validated afterwards.
(define (tc-lifetime-subst-bind-for-variance
  [env : TcTypeEnv]
  [subst : TcLifetimeSubst]
  [from : i64]
  [to : i64]
  [variance : TcVariance]) : ResultTcLifetimeSubst
  (match (tc-lifetime-subst-lookup subst from)
    [(Some existing)
      (if (= existing to)
        (Ok subst)
        (match variance
          [(TcVarianceBivariant) (Ok subst)]
          [(TcVarianceCovariant)
            (cond
              [(tc-lifetime-outlives-lifetime-id? env existing to)
                (Ok (tc-lifetime-subst-push subst from to))]
              [(tc-lifetime-outlives-lifetime-id? env to existing) (Ok subst)]
              [else (Err (tc-call-lifetime-subst-mismatch-message))])]
          [(TcVarianceContravariant)
            (cond
              [(tc-lifetime-outlives-lifetime-id? env existing to) (Ok subst)]
              [(tc-lifetime-outlives-lifetime-id? env to existing)
                (Ok (tc-lifetime-subst-push subst from to))]
              [else (Err (tc-call-lifetime-subst-mismatch-message))])]
          [(TcVarianceInvariant)
            (Err (tc-call-lifetime-subst-mismatch-message))]))]
    [(No) (Ok (tc-lifetime-subst-push subst from to))]))

(define (tc-infer-call-lifetime-name
  [env : TcTypeEnv]
  [params : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : i64]
  [actual : i64]
  [variance : TcVariance]) : ResultTcLifetimeSubst
  (if (tc-lifetime-list-contains params formal)
    (tc-lifetime-subst-bind-for-variance env subst formal actual variance)
    (if (tc-lifetime-coercible-for-variance? env variance formal actual)
      (Ok subst)
      (Err (tc-call-lifetime-subst-mismatch-message)))))

(define (tc-infer-call-nominal-lifetime-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]
  [name-id : i64]
  [formal : ast.AstLifetimeList]
  [actual : ast.AstLifetimeList]
  [position : TcVariance]) : ResultTcLifetimeSubst
  (if (=
    (ast.ast-lifetime-list-len (& formal))
    (ast.ast-lifetime-list-len (& actual)))
    (tc-infer-call-nominal-lifetime-list-at
      ctx
      env
      params
      subst
      name-id
      (& formal)
      (& actual)
      position
      0)
    (Err (tc-call-lifetime-subst-mismatch-message))))

(define (tc-infer-call-nominal-lifetime-list-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]
  [name-id : i64]
  [formal : (& formal ast.AstLifetimeList)]
  [actual : (& actual ast.AstLifetimeList)]
  [position : TcVariance]
  [index : i64]) : ResultTcLifetimeSubst
  (if (>= index (ast.ast-lifetime-list-len formal))
    (Ok subst)
    (let
      [next-subst
        (try
          (tc-infer-call-lifetime-name
            env
            (tc-global-shared-view params)
            subst
            (ast.ast-lifetime-list-get formal index (ast.ast-lifetime-fallback))
            (ast.ast-lifetime-list-get actual index (ast.ast-lifetime-fallback))
            (tc-variance-compose
              position
              (tc-nominal-lifetime-variance-at ctx name-id index Nil))))]
      (tc-infer-call-nominal-lifetime-list-at
        ctx
        env
        params
        next-subst
        name-id
        formal
        actual
        position
        (+ index 1)))))

(define (tc-infer-lifetime-list
  [params : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : ast.AstLifetimeList]
  [actual : ast.AstLifetimeList]) : ResultTcLifetimeSubst
  (if (=
    (ast.ast-lifetime-list-len (& formal))
    (ast.ast-lifetime-list-len (& actual)))
    (tc-infer-lifetime-list-at params subst (& formal) (& actual) 0)
    (Err (tc-call-lifetime-subst-mismatch-message))))

(define (tc-infer-lifetime-list-at
  [params : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : (& formal ast.AstLifetimeList)]
  [actual : (& actual ast.AstLifetimeList)]
  [index : i64]) : ResultTcLifetimeSubst
  (if (>= index (ast.ast-lifetime-list-len formal))
    (Ok subst)
    (let
      [next-subst
        (try
          (tc-infer-lifetime-name
            (tc-global-shared-view params)
            subst
            (ast.ast-lifetime-list-get formal index (ast.ast-lifetime-fallback))
            (ast.ast-lifetime-list-get actual index (ast.ast-lifetime-fallback))))]
      (tc-infer-lifetime-list-at params next-subst formal actual (+ index 1)))))

(define (tc-infer-lifetime-subst-from-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : ast.AstType]
  [actual : ast.AstType]
  [position : TcVariance]) : ResultTcLifetimeSubst
  (let
    [want : ast.AstType (tc-resolve-type ctx (tc-global-shared-view formal))]
    [got : ast.AstType (tc-resolve-type ctx (tc-global-shared-view actual))]
    (match want
      [(Ref formal-lifetime formal-inner)
        (match got
          [(Ref actual-lifetime actual-inner)
            (let
              [next-subst
                (try
                  (tc-infer-call-lifetime-name
                    env
                    (tc-global-shared-view params)
                    subst
                    formal-lifetime
                    actual-lifetime
                    position))]
              [formal-inner-ty : ast.AstType
                (tc-type-strip-region
                  (tc-resolve-type ctx (tc-context-type-get ctx formal-inner)))]
              [actual-inner-ty : ast.AstType
                (tc-type-strip-region
                  (tc-resolve-type ctx (tc-context-type-get ctx actual-inner)))]
              (match formal-inner-ty
                [(Slice formal-elem)
                  (match actual-inner-ty
                    [(Slice actual-elem)
                      (tc-infer-lifetime-subst-from-type
                        ctx
                        env
                        params
                        next-subst
                        (ast.ty-node-get formal-elem)
                        (ast.ty-node-get actual-elem)
                        position)]
                    [(Array actual-elem _)
                      (tc-infer-lifetime-subst-from-type
                        ctx
                        env
                        params
                        next-subst
                        (ast.ty-node-get formal-elem)
                        (ast.ty-node-get actual-elem)
                        position)]
                    [_ (Err (tc-call-lifetime-subst-mismatch-message))])]
                [_
                  (tc-infer-lifetime-subst-from-type
                    ctx
                    env
                    params
                    next-subst
                    (ast.ty-node-get formal-inner)
                    (ast.ty-node-get actual-inner)
                    position)]))]
          [_ (Err (tc-call-lifetime-subst-mismatch-message))])]
      [(MutRef formal-lifetime formal-inner)
        (match got
          [(MutRef actual-lifetime actual-inner)
            (let
              [next-subst
                (try
                  (tc-infer-call-lifetime-name
                    env
                    (tc-global-shared-view params)
                    subst
                    formal-lifetime
                    actual-lifetime
                    position))]
              [formal-inner-ty : ast.AstType
                (tc-type-strip-region
                  (tc-resolve-type ctx (tc-context-type-get ctx formal-inner)))]
              [actual-inner-ty : ast.AstType
                (tc-type-strip-region
                  (tc-resolve-type ctx (tc-context-type-get ctx actual-inner)))]
              (match formal-inner-ty
                [(Slice formal-elem)
                  (match actual-inner-ty
                    [(Slice actual-elem)
                      (tc-infer-lifetime-subst-from-type
                        ctx
                        env
                        params
                        next-subst
                        (ast.ty-node-get formal-elem)
                        (ast.ty-node-get actual-elem)
                        (TcVarianceInvariant))]
                    [(Array actual-elem _)
                      (tc-infer-lifetime-subst-from-type
                        ctx
                        env
                        params
                        next-subst
                        (ast.ty-node-get formal-elem)
                        (ast.ty-node-get actual-elem)
                        (TcVarianceInvariant))]
                    [_ (Err (tc-call-lifetime-subst-mismatch-message))])]
                [_
                  (tc-infer-lifetime-subst-from-type
                    ctx
                    env
                    params
                    next-subst
                    (ast.ty-node-get formal-inner)
                    (ast.ty-node-get actual-inner)
                    (TcVarianceInvariant))]))]
          [_ (Err (tc-call-lifetime-subst-mismatch-message))])]
      [(Region formal-lifetime formal-inner)
        (match got
          [(Region actual-lifetime actual-inner)
            (let
              [next-subst
                (try
                  (tc-infer-call-lifetime-name
                    env
                    (tc-global-shared-view params)
                    subst
                    formal-lifetime
                    actual-lifetime
                    position))]
              (tc-infer-lifetime-subst-from-type
                ctx
                env
                params
                next-subst
                (ast.ty-node-get formal-inner)
                (ast.ty-node-get actual-inner)
                position))]
          [_ (Err (tc-call-lifetime-subst-mismatch-message))])]
      ;; A function value's `:invalidate` lifetime is inferred invariantly with
      ;; its wrapper; an ordinary argument is inferred from the wrapped type.
      [(Invalidate formal-lifetime formal-inner)
        (match (tc-global-shared-view got)
          [(Invalidate actual-lifetime actual-inner)
            (let
              [next-subst
                (try
                  (tc-infer-call-lifetime-name
                    env
                    (tc-global-shared-view params)
                    subst
                    formal-lifetime
                    actual-lifetime
                    (TcVarianceInvariant)))]
              (tc-infer-lifetime-subst-from-type
                ctx
                env
                params
                next-subst
                (ast.ty-node-get formal-inner)
                (ast.ty-node-get actual-inner)
                position))]
          [_
            (tc-infer-lifetime-subst-from-type
              ctx
              env
              params
              subst
              (ast.ty-node-get formal-inner)
              got
              position)])]
      [(EnumArgs formal-name formal-lifetimes)
        (match got
          [(EnumArgs actual-name actual-lifetimes)
            (if (tc-nominal-name-id-eq? formal-name actual-name)
              (tc-infer-call-nominal-lifetime-list
                ctx
                env
                params
                subst
                formal-name
                (ast.ast-lifetime-list-box-shared-view formal-lifetimes)
                (ast.ast-lifetime-list-box-shared-view actual-lifetimes)
                position)
              (Err (tc-call-lifetime-subst-mismatch-message)))]
          [_ (Err (tc-call-lifetime-subst-mismatch-message))])]
      [(StructArgs formal-name formal-lifetimes)
        (match got
          [(StructArgs actual-name actual-lifetimes)
            (if (tc-nominal-name-id-eq? formal-name actual-name)
              (tc-infer-call-nominal-lifetime-list
                ctx
                env
                params
                subst
                formal-name
                (ast.ast-lifetime-list-box-shared-view formal-lifetimes)
                (ast.ast-lifetime-list-box-shared-view actual-lifetimes)
                position)
              (Err (tc-call-lifetime-subst-mismatch-message)))]
          [_ (Err (tc-call-lifetime-subst-mismatch-message))])]
      [(Func formal-params formal-ret)
        (match got
          [(Func actual-params actual-ret)
            (let
              [next-subst
                (try
                  (tc-infer-lifetime-subst-from-type-list
                    ctx
                    env
                    (tc-global-shared-view params)
                    subst
                    (ast.ast-type-list-box-shared-view formal-params)
                    (ast.ast-type-list-box-shared-view actual-params)
                    (tc-variance-flip position)))]
              (tc-infer-lifetime-subst-from-type
                ctx
                env
                params
                next-subst
                (ast.ty-node-get formal-ret)
                (ast.ty-node-get actual-ret)
                position))]
          [_ (Err (tc-call-lifetime-subst-mismatch-message))])]
      [(Tuple formal-elems)
        (match got
          [(Tuple actual-elems)
            (tc-infer-lifetime-subst-from-type-list
              ctx
              env
              params
              subst
              (ast.ast-type-list-box-shared-view formal-elems)
              (ast.ast-type-list-box-shared-view actual-elems)
              position)]
          [_ (Err (tc-call-lifetime-subst-mismatch-message))])]
      [(Array formal-elem formal-len)
        (match got
          [(Array actual-elem actual-len)
            (if (= formal-len actual-len)
              (tc-infer-lifetime-subst-from-type
                ctx
                env
                params
                subst
                (ast.ty-node-get formal-elem)
                (ast.ty-node-get actual-elem)
                position)
              (Err (tc-call-lifetime-subst-mismatch-message)))]
          [_ (Err (tc-call-lifetime-subst-mismatch-message))])]
      [(DynArray formal-elem)
        (match got
          [(DynArray actual-elem)
            (tc-infer-lifetime-subst-from-type
              ctx
              env
              params
              subst
              (ast.ty-node-get formal-elem)
              (ast.ty-node-get actual-elem)
              position)]
          [_ (Err (tc-call-lifetime-subst-mismatch-message))])]
      [(Slice formal-elem)
        (match got
          [(Slice actual-elem)
            (tc-infer-lifetime-subst-from-type
              ctx
              env
              params
              subst
              (ast.ty-node-get formal-elem)
              (ast.ty-node-get actual-elem)
              position)]
          [_ (Err (tc-call-lifetime-subst-mismatch-message))])]
      [(Box formal-elem)
        (match got
          [(Box actual-elem)
            (tc-infer-lifetime-subst-from-type
              ctx
              env
              params
              subst
              (ast.ty-node-get formal-elem)
              (ast.ty-node-get actual-elem)
              position)]
          [_ (Err (tc-call-lifetime-subst-mismatch-message))])]
      [(Ptr formal-elem)
        (match got
          [(Ptr actual-elem)
            (tc-infer-lifetime-subst-from-type
              ctx
              env
              params
              subst
              (ast.ty-node-get formal-elem)
              (ast.ty-node-get actual-elem)
              position)]
          [_ (Err (tc-call-lifetime-subst-mismatch-message))])]
      [(MutPtr formal-elem)
        (match got
          [(MutPtr actual-elem)
            (tc-infer-lifetime-subst-from-type
              ctx
              env
              params
              subst
              (ast.ty-node-get formal-elem)
              (ast.ty-node-get actual-elem)
              (TcVarianceInvariant))]
          [_ (Err (tc-call-lifetime-subst-mismatch-message))])]
      [_
        (if (tc-type-coercible?
          ctx
          env
          (tc-resolve-type ctx formal)
          (tc-resolve-type ctx actual))
          (Ok subst)
          (Err (tc-call-lifetime-subst-mismatch-message)))])))

(define (tc-infer-lifetime-subst-from-type-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : ast.AstTypeList]
  [actual : ast.AstTypeList]
  [position : TcVariance]) : ResultTcLifetimeSubst
  (if (= (ast.ast-type-list-len (& formal)) (ast.ast-type-list-len (& actual)))
    (tc-infer-lifetime-subst-from-type-list-at
      ctx
      env
      params
      subst
      (& formal)
      (& actual)
      position
      0)
    (Err (tc-call-lifetime-subst-mismatch-message))))

(define (tc-infer-lifetime-subst-from-type-list-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : (& formal ast.AstTypeList)]
  [actual : (& actual ast.AstTypeList)]
  [position : TcVariance]
  [index : i64]) : ResultTcLifetimeSubst
  (if (>= index (ast.ast-type-list-len formal))
    (Ok subst)
    (let
      [next-subst
        (try
          (tc-infer-lifetime-subst-from-type
            ctx
            env
            (tc-global-shared-view params)
            subst
            (ast.ty-node-get
              (ast.ast-type-list-get formal index (ast.ast-type-id-fallback)))
            (ast.ty-node-get
              (ast.ast-type-list-get actual index (ast.ast-type-id-fallback)))
            position))]
      (tc-infer-lifetime-subst-from-type-list-at
        ctx
        env
        params
        next-subst
        formal
        actual
        position
        (+ index 1)))))

(define (tc-call-immutable-ref-formal? [ctx : TcContext] [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-global-shared-view ty))
    [(Ref _ _) true]
    [(or (Var _) (VarArgs _ _))
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(Ref _ _) true]
        [_ false])]
    [_ false]))

;; A Slice is an unsized view, so only a borrowed Slice referent is a legal
;; call formal.  Keep this predicate deliberately shallow: Slice nested inside
;; another owning/container type must not activate call unsizing.
(define (tc-call-slice-ref-formal? [ctx : TcContext] [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(or (Ref _ inner) (MutRef _ inner))
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-context-type-get ctx inner)))
        [(Slice _) true]
        [_ false])]
    [_ false]))

;; Closed, call-local whole-array unsizing.  This is intentionally separate
;; from tc-type-compatible?/tc-match-inferred-type-for-expected: a fixed Array
;; reference can become a Slice reference only at a typed call boundary, with
;; matching mutability. The decomposition names the two element types and the
;; mutability; the typecheck predicate below decides compatibility and lowering
;; asks only for the shape, because typecheck has already proven the call.
(defenum TcArraySliceUnsize
  (No)
  (Shared ast.AstType ast.AstType)
  (Mutable ast.AstType ast.AstType))

(define (tc-call-array-ref-to-slice-ref-unsize
  [ctx : TcContext]
  [expected : ast.AstType]
  [actual : ast.AstType]) : TcArraySliceUnsize
  (let
    [want : ast.AstType (tc-type-strip-region (tc-resolve-type ctx expected))]
    [got : ast.AstType (tc-type-strip-region (tc-resolve-type ctx actual))]
    (match want
      [(Ref _ want-inner)
        (match got
          [(Ref _ got-inner)
            (match (tc-call-slice-and-array-elems ctx want-inner got-inner)
              [(Mutable want-elem got-elem) (Shared want-elem got-elem)]
              [_ No])]
          [_ No])]
      [(MutRef _ want-inner)
        (match got
          [(MutRef _ got-inner)
            (tc-call-slice-and-array-elems ctx want-inner got-inner)]
          [_ No])]
      [_ No])))

;; The resolved element types of a `Slice` referent and an `Array` referent,
;; tagged `Mutable`; the shared caller retags them.
(define (tc-call-slice-and-array-elems
  [ctx : TcContext]
  [want-inner : i64]
  [got-inner : i64]) : TcArraySliceUnsize
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-context-type-get ctx want-inner)))
    [(Slice want-elem)
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-context-type-get ctx got-inner)))
        [(Array got-elem _)
          (Mutable
            (tc-resolve-type ctx (ast.ty-node-get want-elem))
            (tc-resolve-type ctx (ast.ty-node-get got-elem)))]
        [_ No])]
    [_ No]))

;; Through a shared reference the element type may shorten the lifetimes it
;; stores, exactly as a shared borrow of one element may (#8111): the elements
;; are only read, and `tc-type-coercible-core?` admits structural lifetime
;; subtyping, never a representation change. Through a mutable reference the
;; element type must be exact, because a write through the Slice could store a
;; shorter-lived reference into the array.
(define (tc-call-array-ref-to-slice-ref-compatible?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expected : ast.AstType]
  [actual : ast.AstType]) : bool
  (match (tc-call-array-ref-to-slice-ref-unsize ctx expected actual)
    [(No) false]
    [(Shared want-elem got-elem)
      (tc-type-coercible-core? ctx env want-elem got-elem)]
    [(Mutable want-elem got-elem) (tc-type-eq want-elem got-elem)]))

;; Lowering's question: is this call argument a whole-array unsize? Typecheck
;; has already checked the element types against the instantiated formal.
(define (tc-call-array-ref-to-slice-ref-shape?
  [ctx : TcContext]
  [expected : ast.AstType]
  [actual : ast.AstType]) : bool
  (match (tc-call-array-ref-to-slice-ref-unsize ctx expected actual)
    [(No) false]
    [_ true]))

(define (tc-call-mutable-ref-formal? [ctx : TcContext] [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-global-shared-view ty))
    [(MutRef _ _) true]
    [(or (Var _) (VarArgs _ _))
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(MutRef _ _) true]
        [_ false])]
    [_ false]))

(define (tc-call-actual-immutable-reference?
  [ctx : TcContext]
  [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-global-shared-view ty))
    [(Ref _ _) true]
    [(or (Var _) (VarArgs _ _))
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(Ref _ _) true]
        [_ false])]
    [_ false]))

(define (tc-call-string-temporary-ref-compatible?
  [ctx : TcContext]
  [want : ast.AstType]
  [got : ast.AstType]) : bool
  (and
    (tc-str-ref-type? (tc-resolve-type ctx want))
    (match (tc-type-strip-region got)
      [(String) true]
      [_ false])))

(define (tc-call-type-list-has-immutable-ref-formal?
  [ctx : TcContext]
  [types : (& types ast.AstTypeList)]) : bool
  (tc-call-type-list-has-immutable-ref-formal-at? ctx (& types) 0))

(define (tc-call-type-list-has-immutable-ref-formal-at?
  [ctx : TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    false
    (if (tc-call-immutable-ref-formal?
      ctx
      (ast.ty-node-get
        (ast.ast-type-list-get types index (ast.ast-type-id-fallback))))
      true
      (tc-call-type-list-has-immutable-ref-formal-at? ctx types (+ index 1)))))

(define (tc-call-auto-borrow-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : ast.AstExpr]) : ResultTcType
  (let
    [expr-bases : i64 (tc-context-expr-bases ctx)]
    [place (try (tc-borrow-place ctx expr-bases env arg))]
    (match place
      [(TcBorrowPlace lifetime referent-ty _)
        (Ok (ast.ast-ty-ref lifetime (& referent-ty)))])))

;; The auto-borrow `(& arg)` as a value. Only the place is a node; the borrow
;; is returned rather than pushed and read back, so no pool is read here.
(define (tc-call-auto-borrow-expr [arg : ast.AstExpr]) : ast.AstExpr
  (Borrow
    false
    (ast.ast-borrow-lifetime-to-id Inferred)
    (ast.ast-node-push arg)))

(define (tc-call-effective-var-arg-type
  [ctx : TcContext]
  [name : i64]
  [got : ast.AstType]) : ResultTcType
  ;; An existing shared reference already has the effective call shape. An
  ;; existing mutable reference must still pass through tc-borrow-place-var so
  ;; the call gets a tracked shared reborrow with the referent's lifetime.
  (if (tc-call-actual-immutable-reference? ctx (tc-global-shared-view got))
    (Ok got)
    (let
      [place : TcBorrowPlace (try (tc-borrow-place-var name got))]
      (match place
        [(TcBorrowPlace lifetime referent-ty _)
          (Ok (ast.ast-ty-ref lifetime (& referent-ty)))]))))

;; Body-local memo for a call argument's non-contextual inferred type, keyed by
;; the argument's Spanned payload node id. Call arguments are re-inferred by the
;; lifetime-substitution pass, the effective-arg (auto-borrow) rewrite, and the
;; move/borrow-check passes; without a memo each nesting level of a call chain
;; re-walks its whole argument subtree, which is exponential in nesting depth.
;; The facts live in the per-function-body tc-body-type-fact table (populated
;; while recording, dropped by tc-body-type-facts-clear!), so entries never leak
;; across bodies. Unlike tc-body-type-fact-lookup this lookup also hits during
;; the recording phase: the redundant walks it collapses run at the same program
;; point with the same environment as the walk that recorded the fact, so the
;; recorded type is exactly the type a re-walk would recompute.
;;
;; The key is the immediate payload id of the first source view under the
;; argument's expansion wrappers, and it indexes the owning body's fact table.
;; Peeling a wrapper reads a node, so the chain must be read from the caller's
;; expression owner: an unrelated installed pool can hold another valid view at
;; the same id and would select a different body fact. Peeling cannot expand a
;; macro or install a pool, so one owner snapshot covers the whole chain. An
;; unwrapped source view needs no read and takes no snapshot.
(define (tc-call-arg-fact-key-with-bases [expr-bases : i64] [arg : ast.AstExpr]) : i64
  (match arg
    [(Spanned inner-box _) inner-box]
    [(MacroExpansion inner-box _ _)
      (tc-call-arg-fact-key-with-bases
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [_ -1]))

(define (tc-call-arg-fact-key [ctx : TcContext] [arg : ast.AstExpr]) : i64
  (match arg
    [(Spanned inner-box _) inner-box]
    [(MacroExpansion inner-box _ _)
      (let
        [expr-bases : i64 (tc-context-expr-bases ctx)]
        (tc-call-arg-fact-key-with-bases
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases inner-box)))]
    [_ -1]))

(define (tc-call-arg-fact-lookup [state : TcBodyState] [key : i64]) : TcBodyTypeFact
  (let
    [data : (Ptr TcBodyStateData) (tc-body-state-view state)]
    (unsafe
      (if (and
        (>= key 0)
        (or (deref data).type-facts-recording (deref data).type-facts-consuming))
        (let
          [slot : i64 (tc-body-type-fact-slot state key)]
          (if (and (>= slot 0) (< slot (deref data).type-fact-count))
            (let
              [address : u64
                (ptr->int
                  (ptr-offset
                    (__tl_array-data (deref data).type-fact-types)
                    slot))]
              (Hit (ptr-read (int->ptr address : (Ptr ast.AstType)))))
            (Miss)))
        (Miss)))))

(define (tc-call-arg-expr-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : ast.AstExpr]) : ResultTcType
  (let
    [key : i64 (tc-call-arg-fact-key ctx (tc-global-shared-view arg))]
    [state : TcBodyState (tc-context-body-state ctx)]
    (match (tc-call-arg-fact-lookup state key)
      [(Hit ty) (Ok ty)]
      [(Miss)
        (let
          [ty (try (tc-expr ctx env arg))]
          (if (>= key 0)
            (tc-body-type-fact-record! state key (tc-global-shared-view ty))
            unit)
          (Ok ty))])))

;; A formal that resolves to a type with no reference/region lifetimes and no
;; struct/enum lifetime arguments cannot contribute lifetime bindings to the
;; call substitution, so the substitution pass may skip inferring that
;; argument's type entirely (tc-check-call-args typechecks every argument right
;; after). tc-resolve-type resolves aliases structurally, so lifetimes hidden
;; behind an alias are still seen.
(define (tc-lifetime-subst-formal-inert? [ctx : TcContext] [want : ast.AstType]) : bool
  (match (tc-type-collect-regions-into (tc-resolve-type ctx want) Nil)
    [(Nil) true]
    [_ false]))

;; Whether a call argument is a String temporary (a literal or a call) for a
;; `(& str)` formal: it cannot be borrowed as a place, so it skips the place
;; borrow and the diagnostic that borrow would build.
(define (tc-call-string-temporary-arg?
  [ctx : TcContext]
  [arg : ast.AstExpr]
  [want : ast.AstType]
  [got : ast.AstType]) : bool
  (and
    (tc-borrow-operand-temporary? (tc-context-expr-bases ctx) arg)
    (tc-call-string-temporary-ref-compatible? ctx want got)))

(define (tc-call-effective-arg-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : ast.AstExpr]
  [want : ast.AstType]) : ResultTcType
  ;; Slice formals require an already-borrowed argument.  Do not run the
  ;; ordinary immutable-reference auto-borrow path for them.
  (if (tc-call-slice-ref-formal? ctx (tc-global-shared-view want))
    (tc-call-arg-expr-type ctx env arg)
    (if (tc-call-immutable-ref-formal? ctx (tc-global-shared-view want))
      (match (ast.ast-expr-unspan-with-segment-bases
        (tc-context-expr-segment-bases ctx)
        (& arg))
        [(Var name)
          (if (tc-dotted-place-name-id? ctx env name)
            (let
              [got
                (try
                  (tc-call-arg-expr-type ctx env (tc-global-shared-view arg)))]
              (if (tc-call-actual-immutable-reference?
                ctx
                (tc-global-shared-view got))
                (Ok got)
                (tc-call-auto-borrow-type ctx env arg)))
            (match (tc-lookup-visible-id ctx env name)
              [(Ok got) (tc-call-effective-var-arg-type ctx name got)]
              [(Err message)
                ;; Qualified module values are ordinary variable expressions,
                ;; but are not stored under their surface dotted id in the
                ;; lexical env. Let normal expression lookup resolve them
                ;; before deciding whether the typed reference formal can
                ;; auto-borrow the resulting place.
                (match (tc-call-arg-expr-type
                  ctx
                  env
                  (tc-global-shared-view arg))
                  [(Ok got)
                    (if (tc-call-actual-immutable-reference?
                      ctx
                      (tc-global-shared-view got))
                      (Ok got)
                      (tc-call-auto-borrow-type ctx env arg))]
                  [(Err _) (Err message)])]))]
        [_
          (let
            [got
              (try (tc-call-arg-expr-type ctx env (tc-global-shared-view arg)))]
            (cond
              [(tc-call-actual-immutable-reference?
                  ctx
                  (tc-global-shared-view got))
                (Ok got)]
              ;; a String temporary (a literal or a call) cannot be borrowed as
              ;; a place, so skip the place borrow and its diagnostic
              [(tc-call-string-temporary-arg?
                  ctx
                  (tc-global-shared-view arg)
                  (tc-global-shared-view want)
                  (tc-global-shared-view got))
                (Ok want)]
              [else
                (match (tc-call-auto-borrow-type ctx env arg)
                  [(Ok borrowed) (Ok borrowed)]
                  [(Err message)
                    (if (tc-call-string-temporary-ref-compatible?
                      ctx
                      (tc-global-shared-view want)
                      got)
                      (Ok want)
                      (Err message))])]))])
      (tc-expr-with-expected-or-actual-call-arg ctx env arg want))))

(define (tc-call-effective-var-arg-expr
  [ctx : TcContext]
  [name : i64]
  [got : ast.AstType]
  [arg : ast.AstExpr]) : ResultTcExpr
  (if (tc-call-actual-immutable-reference? ctx (tc-global-shared-view got))
    (Ok arg)
    (let
      [_ (try (tc-borrow-place-var name got))]
      (Ok (tc-call-auto-borrow-expr arg)))))

(define (tc-call-effective-arg-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : ast.AstExpr]
  [want : ast.AstType]) : ResultTcExpr
  (if (tc-call-slice-ref-formal? ctx (tc-global-shared-view want))
    (Ok arg)
    (if (tc-call-immutable-ref-formal? ctx (tc-global-shared-view want))
      (if (tc-call-explicit-borrow-expr?
        (tc-context-expr-segment-bases ctx)
        (tc-global-shared-view arg))
        (Ok arg)
        (match (ast.ast-expr-unspan-with-segment-bases
          (tc-context-expr-segment-bases ctx)
          (& arg))
          [(Var name)
            (if (tc-dotted-place-name-id? ctx env name)
              (let
                [got
                  (try
                    (tc-call-arg-expr-type ctx env (tc-global-shared-view arg)))]
                (if (tc-call-actual-immutable-reference? ctx got)
                  (Ok arg)
                  (let
                    [_
                      (try
                        (tc-call-auto-borrow-type
                          ctx
                          env
                          (tc-global-shared-view arg)))]
                    (Ok (tc-call-auto-borrow-expr arg)))))
              (match (tc-lookup-visible-id ctx env name)
                [(Ok got) (tc-call-effective-var-arg-expr ctx name got arg)]
                [(Err message)
                  (match (tc-call-arg-expr-type
                    ctx
                    env
                    (tc-global-shared-view arg))
                    [(Ok got)
                      (if (tc-call-actual-immutable-reference? ctx got)
                        (Ok arg)
                        (let
                          [_
                            (try
                              (tc-call-auto-borrow-type
                                ctx
                                env
                                (tc-global-shared-view arg)))]
                          (Ok (tc-call-auto-borrow-expr arg))))]
                    [(Err _) (Err message)])]))]
          [_
            (let
              [got
                (try
                  (tc-call-arg-expr-type ctx env (tc-global-shared-view arg)))]
              (cond
                [(tc-call-actual-immutable-reference?
                    ctx
                    (tc-global-shared-view got))
                  (Ok arg)]
                [(tc-call-string-temporary-arg?
                    ctx
                    (tc-global-shared-view arg)
                    (tc-global-shared-view want)
                    (tc-global-shared-view got))
                  (Ok arg)]
                [else
                  (match (tc-call-auto-borrow-type
                    ctx
                    env
                    (tc-global-shared-view arg))
                    [(Ok _) (Ok (tc-call-auto-borrow-expr arg))]
                    [(Err message)
                      (if (tc-call-string-temporary-ref-compatible?
                        ctx
                        want
                        got)
                        (Ok arg)
                        (Err message))])]))]))
      (Ok arg))))

(define (tc-infer-call-lifetime-subst
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [lifetimes : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]) : ResultTcLifetimeSubst
  (tc-infer-call-lifetime-subst-at
    ctx
    env
    func
    (tc-global-shared-view args)
    (tc-global-shared-view params)
    (& args)
    (& params)
    0
    lifetimes
    subst))

(define (tc-infer-lifetime-subst-from-mixed-source-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [lifetimes : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]
  [want : ast.AstType]
  [got : ast.AstType]) : ResultTcLifetimeSubst
  (let
    [canonical-got : ast.AstType
      (tc-canonicalize-inferred-type ctx (tc-global-shared-view got))]
    (match (tc-infer-lifetime-subst-from-type
      ctx
      env
      (tc-global-shared-view lifetimes)
      subst
      (tc-global-shared-view want)
      (tc-global-shared-view canonical-got)
      (TcVarianceCovariant))
      [(Ok next-subst) (Ok next-subst)]
      [(Err _)
        (let
          [canonical-want : ast.AstType
            (tc-canonicalize-inferred-type ctx want)]
          (match (tc-infer-lifetime-subst-from-type
            ctx
            env
            (tc-global-shared-view lifetimes)
            subst
            (tc-global-shared-view canonical-want)
            got
            (TcVarianceCovariant))
            [(Ok next-subst) (Ok next-subst)]
            [(Err _)
              (tc-infer-lifetime-subst-from-type
                ctx
                env
                lifetimes
                subst
                canonical-want
                canonical-got
                (TcVarianceCovariant))]))])))

(define (tc-infer-call-lifetime-subst-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [all-args : ast.AstExprList]
  [all-params : ast.AstTypeList]
  [args : (& args ast.AstExprList)]
  [params : (& params ast.AstTypeList)]
  [index : i64]
  [lifetimes : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]) : ResultTcLifetimeSubst
  (if (>= index args.len)
    (if (>= index (ast.ast-type-list-len params))
      (Ok subst)
      (Err
        (tc-call-arity-message
          (tc-context-expr-segment-bases ctx)
          func
          all-args
          all-params)))
    (if (>= index (ast.ast-type-list-len params))
      (Err
        (tc-call-arity-message
          (tc-context-expr-segment-bases ctx)
          func
          all-args
          all-params))
      (let
        [arg : ast.AstExpr
          (tc-context-expr-get ctx (ast.ast-expr-list-get args index 0))]
        [want : ast.AstType
          (ast.ty-node-get
            (ast.ast-type-list-get params index (ast.ast-type-id-fallback)))]
        (if (tc-lifetime-subst-formal-inert? ctx (tc-global-shared-view want))
          (tc-infer-call-lifetime-subst-at
            ctx
            env
            func
            all-args
            all-params
            args
            params
            (+ index 1)
            lifetimes
            subst)
          (match (let
            [typed : ResultTcType
              (tc-call-effective-arg-type
                ctx
                env
                (tc-global-shared-view arg)
                (tc-global-shared-view want))]
            [typed-ok : bool
              (match (& typed)
                [(ResultTcType.Ok _) true]
                [(ResultTcType.Err _) false])]
            (if typed-ok
              typed
              (tc-call-arg-type-after-error
                ctx
                env
                (tc-global-shared-view arg)
                (tc-global-shared-view want)
                typed)))
            [(Ok got)
              (match (tc-infer-lifetime-subst-from-type
                ctx
                env
                (tc-global-shared-view lifetimes)
                subst
                (tc-global-shared-view want)
                (tc-global-shared-view got)
                (TcVarianceCovariant))
                [(Ok next-subst)
                  (tc-infer-call-lifetime-subst-at
                    ctx
                    env
                    func
                    all-args
                    all-params
                    args
                    params
                    (+ index 1)
                    lifetimes
                    next-subst)]
                [(Err _message)
                  (match (tc-infer-lifetime-subst-from-mixed-source-type
                    ctx
                    env
                    (tc-global-shared-view lifetimes)
                    subst
                    (tc-global-shared-view want)
                    (tc-global-shared-view got))
                    [(Ok next-subst)
                      (tc-infer-call-lifetime-subst-at
                        ctx
                        env
                        func
                        all-args
                        all-params
                        args
                        params
                        (+ index 1)
                        lifetimes
                        next-subst)]
                    [(Err _)
                      (let
                        [canonical-want : ast.AstType
                          (tc-canonicalize-inferred-type ctx want)]
                        [canonical-got : ast.AstType
                          (tc-canonicalize-inferred-type ctx got)]
                        [required-want : ast.AstType
                          (tc-lifetime-subst-type subst canonical-want)]
                        (Err
                          (tc-locate-error-at-expr
                            (tc-context-expr-bases ctx)
                            arg
                            (tc-type-mismatch-message-in-context
                              ctx
                              env
                              canonical-got
                              required-want
                              (tc-call-argument-message-prefix ctx func index)))))])])]
            [(Err message)
              (Err
                (tc-locate-error-at-expr
                  (tc-context-expr-bases ctx)
                  arg
                  message))]))))))

(define (tc-call-lifetime-constructor-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [ret : ast.AstType]
  [allow-region-args : bool]) : ResultTcType
  (let
    [outer : bool (tc-call-temporary-borrow-scope-enter!)]
    [typed-call : ResultTcType
      (let
        [lifetimes : ast.AstLifetimeList
          (match (tc-global-shared-view ret)
            [(or (StructArgs _ params-lifetimes) (EnumArgs _ params-lifetimes))
              (ast.ast-lifetime-list-box-shared-view params-lifetimes)]
            [_ (ast.ast-lifetime-list-new)])]
        (match (tc-infer-call-lifetime-subst
          ctx
          env
          (tc-global-shared-view func)
          (tc-global-shared-view args)
          (tc-global-shared-view params)
          lifetimes
          Nil)
          [(Ok subst)
            (let
              [target : ast.AstType
                (tc-tag-active-region
                  env
                  (tc-lifetime-subst-type subst (tc-global-shared-view ret)))]
              [resolved-params : ast.AstTypeList
                (tc-lifetime-subst-type-list
                  subst
                  (tc-global-shared-view params))]
              (match (tc-check-call-args
                ctx
                env
                func
                (tc-global-shared-view args)
                resolved-params
                allow-region-args
                (Some (tc-global-shared-view target)))
                [(Ok) (Ok target)]
                [(Err message) (Err message)]))]
          [(Err message) (Err message)]))]
    (if tc-call-temporary-borrow-typed
      (tc-call-temporary-borrow-scope-exit
        ctx
        env
        (& args)
        (& params)
        ret
        outer
        typed-call)
      (begin
        (set! tc-call-temporary-borrow-typed outer)
        typed-call))))

(define (tc-call-function-lifetimes
  [params : ast.AstTypeList]
  [ret : ast.AstType]) : ast.AstLifetimeList
  (tc-name-id-list-to-lifetime-list
    (tc-type-collect-reference-lifetimes-into
      ret
      (tc-type-list-collect-reference-lifetimes params Nil))))

;; Whether a call's lifetimes are all call-scoped: each is the outer lifetime
;; of exactly one reference parameter, and no other lifetime or region occurs
;; in the parameters or the result. Such a lifetime only says how long the call
;; borrows its argument, so the call infers nothing: each one becomes the
;; call-temporary lifetime, which every lifetime outlives.
(define (tc-call-lifetimes-call-scoped?
  [ctx : TcContext]
  [params : (& params ast.AstTypeList)]
  [ret : ast.AstType]
  [lifetimes : (& lifetimes ast.AstLifetimeList)]) : bool
  (and
    (tc-name-id-list-empty? (tc-type-collect-regions-into ret Nil))
    (=
      (tc-call-scoped-reference-param-count ctx params 0 0)
      (ast.ast-lifetime-list-len lifetimes))))

;; The number of reference parameters from `index` on, each with a referent
;; free of lifetimes, or -1 when some other parameter carries a lifetime.
(define (tc-call-scoped-reference-param-count
  [ctx : TcContext]
  [params : (& params ast.AstTypeList)]
  [index : i64]
  [count : i64]) : i64
  (if (>= index (ast.ast-type-list-len params))
    count
    (let
      [param : ast.AstType
        (ast.ty-node-get
          (ast.ast-type-list-get params index (ast.ast-type-id-fallback)))]
      [referent : i64
        (match (& param)
          [(or (Ref _ inner) (MutRef _ inner)) inner]
          [_ -1])]
      (cond
        [(>= referent 0)
          (if (tc-lifetime-subst-formal-inert? ctx (ast.ty-node-get referent))
            (tc-call-scoped-reference-param-count
              ctx
              params
              (+ index 1)
              (+ count 1))
            -1)]
        [(tc-lifetime-subst-formal-inert? ctx param)
          (tc-call-scoped-reference-param-count ctx params (+ index 1) count)]
        [else -1]))))

;; The substitution of a call whose lifetimes are all call-scoped.
(define (tc-call-scoped-lifetime-subst
  [lifetimes : (& lifetimes ast.AstLifetimeList)]) : TcLifetimeSubst
  (let
    [subst : TcLifetimeSubst Nil]
    [index : i64 0]
    [temporary : i64 (tc-call-temporary-lifetime-id)]
    (while (< index (ast.ast-lifetime-list-len lifetimes))
      (set!
        subst
        (tc-lifetime-subst-push
          subst
          (ast.ast-lifetime-list-get
            lifetimes
            index
            (ast.ast-lifetime-fallback))
          temporary))
      (set! index (+ index 1)))
    subst))

;; Check a call's arguments against its signature under a lifetime substitution.
(define (tc-call-lifetime-function-type-with-subst
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [ret : ast.AstType]
  [allow-region-args : bool]
  [subst : TcLifetimeSubst]) : ResultTcType
  (let
    [resolved-ret : ast.AstType (tc-lifetime-subst-type subst ret)]
    [resolved-params : ast.AstTypeList
      (tc-lifetime-subst-type-list subst params)]
    (match (tc-check-call-args
      ctx
      env
      func
      (tc-global-shared-view args)
      (tc-global-shared-view resolved-params)
      allow-region-args
      (No))
      [(Ok)
        (match (tc-check-invalidate-call
          ctx
          env
          args
          resolved-params
          (tc-global-shared-view resolved-ret))
          [(Ok) (Ok (tc-tag-active-region env resolved-ret))]
          [(Err message) (Err message)])]
      [(Err message) (Err message)])))

(define (tc-call-lifetime-function-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [ret : ast.AstType]
  [lifetimes : ast.AstLifetimeList]
  [allow-region-args : bool]) : ResultTcType
  (let
    [outer : bool (tc-call-temporary-borrow-scope-enter!)]
    [typed-call : ResultTcType
      (match (if (tc-call-lifetimes-call-scoped?
        ctx
        (& params)
        (tc-global-shared-view ret)
        (& lifetimes))
        (tc-call-lifetime-function-type-with-subst
          ctx
          env
          (tc-global-shared-view func)
          (tc-global-shared-view args)
          (tc-global-shared-view params)
          (tc-global-shared-view ret)
          allow-region-args
          (tc-call-scoped-lifetime-subst (& lifetimes)))
        (ResultTcType.Err ""))
        [(Ok scoped-ty) (Ok scoped-ty)]
        ;; Infer the substitution, which also gives a rejected call its
        ;; diagnostic.
        [(Err _)
          (match (tc-infer-call-lifetime-subst
            ctx
            env
            (tc-global-shared-view func)
            (tc-global-shared-view args)
            (tc-global-shared-view params)
            lifetimes
            Nil)
            [(Ok subst)
              (tc-call-lifetime-function-type-with-subst
                ctx
                env
                (tc-global-shared-view func)
                (tc-global-shared-view args)
                (tc-global-shared-view params)
                (tc-global-shared-view ret)
                allow-region-args
                subst)]
            [(Err message) (Err message)])])]
    (if tc-call-temporary-borrow-typed
      (tc-call-temporary-borrow-scope-exit
        ctx
        env
        (& args)
        (& params)
        ret
        outer
        typed-call)
      (begin
        (set! tc-call-temporary-borrow-typed outer)
        typed-call))))

;; A call through `:invalidate` parameters (#6670). After lifetime
;; substitution each invalidated brand must be one the caller may end (a local
;; arena's brand, or a lifetime the caller itself invalidates), no two
;; arguments may invalidate the same brand, the call cannot run inside that
;; arena, and its result cannot carry the brand.
(define (tc-check-invalidate-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [ret : ast.AstType]) : ResultTcUnit
  (unless (tc-invalidate-types-present?) (return Ok))
  (let
    [index : i64 0]
    [seen : TcNameIdList Nil]
    [failure : String ""]
    [failed? : bool false]
    (while (and
      (not failed?)
      (< index (ast.ast-type-list-len (& params)))
      (< index args.len))
      (match (tc-type-invalidate-lifetime
        (ast.ty-node-get
          (ast.ast-type-list-get (& params) index (ast.ast-type-id-fallback))))
        [(Some brand)
          (let
            [message : String
              (cond
                [(not (tc-invalidate-brand-destroyable? env brand))
                  "typecheck: an :invalidate argument must be a branded local arena owner or a value the caller itself invalidates"]
                [(tc-name-id-list-contains seen brand)
                  "typecheck: a call cannot invalidate the same arena through two arguments"]
                [(tc-active-region-owned-by-arena-id? env brand)
                  "typecheck: an :invalidate call cannot run inside the arena it destroys"]
                [(tc-type-contains-arena-owner-region?
                    env
                    (tc-global-shared-view ret)
                    brand)
                  "typecheck: an :invalidate call cannot return a value tied to the arena it destroys"]
                [else ""])]
            (if (= (string.string-length message) 0)
              (set! seen (tc-name-id-list-add seen brand))
              (begin
                (set! failed? true)
                (set!
                  failure
                  (tc-locate-error-at-expr
                    (tc-context-expr-bases ctx)
                    (tc-context-expr-get
                      ctx
                      (ast.ast-expr-list-get (& args) index 0))
                    (tc-kind-message (ArenaOwnership) message))))))]
        [(No) unit])
      (set! index (+ index 1)))
    (if failed?
      (Err failure)
      Ok)))

(define (tc-call-dynamic-c-varargs-abi? [abi : ast.AstExternAbi]) : bool
  (or
    (ast.ast-extern-abi-c-varargs-open? (& abi))
    (ast.ast-extern-abi-c-varargs-typed? (& abi))))

(define (tc-call-extern-abi-for-name-id [ctx : TcContext] [name-id : i64]) : TcMaybeExternAbi
  (let
    [symbols-ctx : TcContext ctx]
    [structural-session : cis.InternStructuralSessionHandle
      (tc-context-structural-session ctx)]
    [lookup-id : i64 (tc-env-name-key-id structural-session name-id)]
    [module-id : i64 (tc-context-module-id ctx)]
    [handle : i64
      (if (or
        (macro-hygiene-global-id? structural-session name-id)
        (tc-name-qualified-id? structural-session name-id))
        (csym.compiler-symbols-lookup-value-id-or
          (tc-context-symbols symbols-ctx)
          lookup-id
          (csym.compiler-symbols-missing-handle))
        (csym.compiler-symbols-lookup-value-in-module-id-or
          (tc-context-symbols symbols-ctx)
          module-id
          lookup-id
          (csym.compiler-symbols-missing-handle)))]
    (if (and
      (csym.compiler-symbols-handle-found? handle)
      (=
        (csym.compiler-symbol-handle-kind handle)
        (csym.compiler-symbol-kind-extern)))
      (match (csym.compiler-symbols-decl-at-index
        (tc-context-symbols symbols-ctx)
        (csym.compiler-symbol-handle-index handle))
        [(Ok (Extern decl-meta _ kind metadata _))
          (match kind
            [(Function)
              (Some
                (ast.ast-extern-metadata-abi
                  (ast.ast-extern-metadata-box-shared-view metadata)))]
            [(Value) (No)])]
        [_ (No)])
      (No))))

(define (tc-call-extern-abi [ctx : TcContext] [func : ast.AstExpr]) : TcMaybeExternAbi
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-segment-bases ctx)
    (& func))
    [(Var name) (tc-call-extern-abi-for-name-id ctx name)]
    [_ (No)]))

(define (tc-name-base-eq? [name : String] [base : String]) : bool
  (if (string.eq name base)
    true
    (if (tc-name-qualified? name)
      (string.eq (tc-qualified-name-base name) base)
      false)))

(define (tc-nominal-struct-type-id-eq?
  [ctx : TcContext]
  [ty : ast.AstType]
  [expected-id : i64]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(or (Struct actual) (StructArgs actual _))
      (tc-nominal-name-id-eq? actual expected-id)]
    [_ false]))

(define (tc-arena-type? [ctx : TcContext] [ty : ast.AstType]) : bool
  (tc-nominal-struct-type-id-eq? ctx ty cbi.compiler-builtin-id-arena-type))

(define (tc-arena-phase-type? [ctx : TcContext] [ty : ast.AstType]) : bool
  (tc-nominal-struct-type-id-eq?
    ctx
    ty
    cbi.compiler-builtin-id-arena-phase-type))

(define (tc-arena-source-call-base-id?
  [ctx : TcContext]
  [_env : TcTypeEnv]
  [name-id : i64]
  [base-id : i64]) : bool
  (if (tc-name-qualified-id? (tc-context-structural-session ctx) name-id)
    (and
      (=
        (tc-qualified-name-module-id name-id)
        cbi.compiler-builtin-id-arena-module)
      (= (tc-qualified-name-base-id name-id) base-id))
    (and
      (= name-id base-id)
      (= (tc-context-module-id ctx) cbi.compiler-builtin-id-arena-module))))

(define (tc-arena-canonical-call-base-id?
  [session : cis.InternStructuralSessionHandle]
  [lookup-id : i64]
  [base-id : i64]) : bool
  (and
    ;; Test/serial adapters can classify the installed table's ordinary
    ;; pair/triple compiler keys without granting access to macro-hygiene
    ;; records. Production contexts take the explicit-session path.
    (if (<= session.address 0)
      (or
        (csym.compiler-composite-pair-key-id? lookup-id)
        (csym.compiler-composite-triple-key-id? lookup-id))
      (tc-name-qualified-id? session lookup-id))
    (=
      (tc-qualified-name-module-id lookup-id)
      cbi.compiler-builtin-id-arena-module)
    (= (tc-qualified-name-base-id lookup-id) base-id)))

(define (tc-arena-safe-call-kind-none) : i64
  0)

(define (tc-arena-safe-call-kind-phase) : i64
  1)

(define (tc-arena-safe-call-kind-rewind) : i64
  2)

(define (tc-arena-safe-call-kind-destroy) : i64
  3)

(define (tc-arena-safe-call-base-kind-id [base-id : i64]) : i64
  (cond
    [(= base-id cbi.compiler-builtin-id-arena-phase-base)
      (tc-arena-safe-call-kind-phase)]
    [(= base-id cbi.compiler-builtin-id-arena-rewind-safe-base)
      (tc-arena-safe-call-kind-rewind)]
    [(= base-id cbi.compiler-builtin-id-arena-destroy-safe-base)
      (tc-arena-safe-call-kind-destroy)]
    [else (tc-arena-safe-call-kind-none)]))

;; Call dispatch has already resolved dotted module aliases into `lookup-id`.
;; Classify that canonical id once, then check the source-name owner fallback
;; once.  The old per-builtin predicates repeated the same environment name
;; resolution for phase, rewind-safe!, and destroy-safe! in sequence.
(define (tc-arena-safe-call-kind-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [lookup-id : i64]) : i64
  (let
    [canonical-module-id : i64 (tc-qualified-name-module-id lookup-id)]
    [canonical-kind : i64
      (if (= canonical-module-id cbi.compiler-builtin-id-arena-module)
        (tc-arena-safe-call-base-kind-id (tc-qualified-name-base-id lookup-id))
        (tc-arena-safe-call-kind-none))]
    (if (not (= canonical-kind (tc-arena-safe-call-kind-none)))
      canonical-kind
      (let
        [qualified : bool
          (tc-name-qualified-id? (tc-context-structural-session ctx) name-id)]
        [source-base-id : i64
          (if qualified
            (tc-qualified-name-base-id name-id)
            name-id)]
        [source-kind : i64 (tc-arena-safe-call-base-kind-id source-base-id)]
        (cond
          [(= source-kind (tc-arena-safe-call-kind-none)) source-kind]
          [(and
              qualified
              (=
                (tc-qualified-name-module-id name-id)
                cbi.compiler-builtin-id-arena-module)
              (tc-source-name-bound-exact-id? env name-id))
            source-kind]
          [qualified (tc-arena-safe-call-kind-none)]
          [(= (tc-context-module-id ctx) cbi.compiler-builtin-id-arena-module)
            source-kind]
          [else (tc-arena-safe-call-kind-none)])))))

(define (tc-arena-owner-kind-none) : i64
  0)

(define (tc-arena-owner-kind-ordinary) : i64
  1)

(define (tc-arena-owner-kind-atomic) : i64
  2)

(define (tc-arena-owner-call-kind-ids
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-id : i64]
  [lookup-id : i64]
  [arg-count : i64]) : i64
  (if (= arg-count 0)
    (cond
      [(or
          (tc-arena-source-call-base-id?
            ctx
            env
            source-id
            cbi.compiler-builtin-id-arena-make-atomic)
          (tc-arena-canonical-call-base-id?
            (tc-context-structural-session ctx)
            lookup-id
            cbi.compiler-builtin-id-arena-make-atomic-base))
        (tc-arena-owner-kind-atomic)]
      [(or
          (tc-arena-source-call-base-id?
            ctx
            env
            source-id
            cbi.compiler-builtin-id-arena-make)
          (tc-arena-canonical-call-base-id?
            (tc-context-structural-session ctx)
            lookup-id
            cbi.compiler-builtin-id-arena-make-base))
        (tc-arena-owner-kind-ordinary)]
      [else (tc-arena-owner-kind-none)])
    (tc-arena-owner-kind-none)))

(define (tc-arena-brand-id [kind : i64] [call-site-id : i64]) : i64
  (ci.intern-generated-canonical-name
    (str_cat.str-cat
      (if (= kind (tc-arena-owner-kind-atomic))
        (tc-arena-brand-atomic-prefix)
        (tc-arena-brand-ordinary-prefix))
      (string.int->string call-site-id))))

(define (tc-arena-branded-type [kind : i64] [call-site-id : i64]) : ast.AstType
  (ast.ast-ty-struct-args
    cbi.compiler-builtin-id-arena-type
    (ast.ast-lifetime-cons
      (tc-arena-brand-id kind call-site-id)
      (& (ast.ast-lifetime-list-new)))))

(define (tc-arena-call-lookup-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-id : i64]) : i64
  (if (or
    (< source-id 0)
    (tc-name-qualified-id? (tc-context-structural-session ctx) source-id))
    source-id
    (let
      [first-dot : i64
        (tc-name-first-dot-id (tc-context-structural-session ctx) source-id)]
      (if (or
        (< first-dot 0)
        (tc-source-leading-segment-wins-over-exact-id-from-dot?
          env
          source-id
          first-dot))
        source-id
        (let
          [current-module-id : i64 (tc-context-module-id ctx)]
          [alias-id : i64 (ci.intern-leading-dot-id source-id)]
          [module-id : i64 (ci.intern-dotted-prefix-id source-id)]
          [base-id : i64 (ci.intern-dotted-final-id source-id)]
          [alias-target-id : i64
            (match (tc-context-program ctx)
              [(Program decls-box)
                (match (tc-source-dotted-alias-target-id-in-context
                  ctx
                  (ast.ast-decl-list-box-shared-view decls-box)
                  current-module-id
                  alias-id)
                  [(Some target-id) target-id]
                  [(No) -1])])]
          (if (= alias-target-id cbi.compiler-builtin-id-arena-module)
            (tc-qualified-name-key-id alias-target-id base-id)
            (if (and
              (= module-id cbi.compiler-builtin-id-arena-module)
              (or
                (= current-module-id module-id)
                (tc-imported-module-identity-id? ctx module-id)))
              (tc-qualified-name-key-id module-id base-id)
              source-id)))))))

(define (tc-arena-owner-call-kind
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]) : i64
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-segment-bases ctx)
    (& expr))
    [(Call func-box args)
      (let
        [nid : i64
          (tc-expr-var-name-id
            (tc-context-expr-segment-bases ctx)
            (tc-context-expr-get ctx func-box))]
        (if (>= nid 0)
          (let
            [source-id : i64
              (macro-hygiene-global-source-name-id-or
                (tc-context-structural-session ctx)
                nid
                nid)]
            [lookup-id : i64 (tc-arena-call-lookup-id ctx env source-id)]
            (tc-arena-owner-call-kind-ids ctx env source-id lookup-id args.len))
          (tc-arena-owner-kind-none)))]
    [_ (tc-arena-owner-kind-none)]))

(define (tc-phase-call-owner
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]) : TcMaybeNameId
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-segment-bases ctx)
    (& expr))
    [(Call func-box args)
      (if (= args.len 1)
        (let
          [owner-expr : ast.AstExpr
            (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
          [nid : i64
            (tc-expr-var-name-id
              (tc-context-expr-segment-bases ctx)
              (tc-context-expr-get ctx func-box))]
          (if (>= nid 0)
            (let
              [source-id : i64
                (macro-hygiene-global-source-name-id-or
                  (tc-context-structural-session ctx)
                  nid
                  nid)]
              [lookup-id : i64 (tc-arena-call-lookup-id ctx env source-id)]
              (if (=
                (tc-arena-safe-call-kind-id ctx env source-id lookup-id)
                (tc-arena-safe-call-kind-phase))
                (let
                  [oid : i64
                    (tc-expr-var-name-id
                      (tc-context-expr-segment-bases ctx)
                      owner-expr)]
                  (if (>= oid 0)
                    (if (or
                      (tc-ordinary-arena-owner-active-id? env oid)
                      (tc-atomic-arena-owner-active-id? env oid))
                      (Some oid)
                      (No))
                    (No)))
                (No)))
            (No)))
        (No))]
    [_ (No)]))

(define (tc-bind-arena-owner-from-kind-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [ty : ast.AstType]
  [kind : i64]) : TcTypeEnv
  (let
    [brand-env : TcTypeEnv
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(StructArgs arena-name lifetimes)
          (let
            [args : ast.AstLifetimeList
              (ast.ast-lifetime-list-box-shared-view lifetimes)]
            (if (and
              (tc-arena-nominal-name-id? arena-name)
              (= (tc-lifetime-list-count args) 1))
              (let
                [brand : i64
                  (ast.ast-lifetime-list-get
                    (& args)
                    0
                    (ast.ast-lifetime-fallback))]
                [brand-kind : i64
                  (if (tc-generated-atomic-arena-brand-id? brand)
                    (tc-arena-owner-kind-atomic)
                    (if (tc-generated-ordinary-arena-brand-id? brand)
                      (tc-arena-owner-kind-ordinary)
                      kind))]
                (tc-bind-id
                  (if (= brand-kind (tc-arena-owner-kind-atomic))
                    (tc-bind-atomic-arena-owner env brand)
                    (tc-bind-ordinary-arena-owner env brand))
                  brand
                  (Var brand)))
              env))]
        [_ env])]
    (cond
      [(= kind (tc-arena-owner-kind-atomic))
        (tc-bind-atomic-arena-owner brand-env name)]
      [(= kind (tc-arena-owner-kind-ordinary))
        (tc-bind-ordinary-arena-owner brand-env name)]
      [else brand-env])))

(define (tc-bind-arena-owner-if-needed-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [ty : ast.AstType]
  [init : ast.AstExpr]) : TcTypeEnv
  (tc-bind-arena-owner-from-kind-id
    ctx
    env
    name
    ty
    (tc-arena-owner-call-kind ctx env init)))

(define (tc-bind-arena-phase-if-needed-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [init : ast.AstExpr]) : TcTypeEnv
  (match (tc-phase-call-owner ctx env init)
    [(Some owner-id) (tc-bind-arena-phase-token env name owner-id)]
    [(No) env]))

(define (tc-bind-initialized-value-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [ty : ast.AstType]
  [init : ast.AstExpr]) : TcTypeEnv
  (let
    [_semantic-site : unit
      (when
        (and
          (> tc-semantic-observed-jobs 0)
          (!= (tc-context-semantic-observer ctx).address 0))
        (tc-semantic-observer-send!
          (tc-context-semantic-observer ctx)
          ctx
          env
          (BindingSite
            (tc-expr-maybe-span
              (tc-context-expr-bases ctx)
              (tc-global-shared-view init)))))]
    [owner-env : TcTypeEnv
      (if (or
        (tc-type-eq (tc-type-strip-region (tc-global-shared-view ty)) (I64))
        (tc-arena-type? ctx (tc-global-shared-view ty)))
        (tc-bind-arena-owner-if-needed-id
          ctx
          env
          name
          (tc-global-shared-view ty)
          (tc-global-shared-view init))
        env)]
    [phase-env : TcTypeEnv
      (tc-bind-arena-phase-if-needed-id ctx owner-env name init)]
    (tc-bind-id phase-env name ty)))

(define (tc-bind-checked-let-transition-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [ty : ast.AstType]
  [transition : TcCheckedLetBindingTransition]) : TcTypeEnv
  (let
    [owner-env : TcTypeEnv
      (if (or
        (tc-type-eq (tc-type-strip-region (tc-global-shared-view ty)) (I64))
        (tc-arena-type? ctx (tc-global-shared-view ty)))
        (tc-bind-arena-owner-from-kind-id
          ctx
          env
          name
          (tc-global-shared-view ty)
          transition.arena-owner-kind)
        env)]
    [phase-env : TcTypeEnv
      (if (>= transition.phase-owner-id 0)
        (tc-bind-arena-phase-token owner-env name transition.phase-owner-id)
        owner-env)]
    (tc-bind-id phase-env name ty)))

(define (tc-checked-let-binding-apply
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [ty : ast.AstType]
  [init : ast.AstExpr]) : TcCheckedLetBindingApplied
  (let
    [_semantic-site : unit
      (when
        (and
          (> tc-semantic-observed-jobs 0)
          (!= (tc-context-semantic-observer ctx).address 0))
        (tc-semantic-observer-send!
          (tc-context-semantic-observer ctx)
          ctx
          env
          (BindingSite
            (tc-expr-maybe-span
              (tc-context-expr-bases ctx)
              (tc-global-shared-view init)))))]
    [owner-kind : i64
      (tc-arena-owner-call-kind ctx env (tc-global-shared-view init))]
    [owner-env : TcTypeEnv
      (if (or
        (tc-type-eq (tc-type-strip-region (tc-global-shared-view ty)) (I64))
        (tc-arena-type? ctx (tc-global-shared-view ty)))
        (tc-bind-arena-owner-from-kind-id
          ctx
          env
          name
          (tc-global-shared-view ty)
          owner-kind)
        env)]
    [phase-owner : TcMaybeNameId (tc-phase-call-owner ctx owner-env init)]
    [phase-owner-id : i64
      (match phase-owner
        [(Some owner-id) owner-id]
        [(No) -1])]
    [phase-env : TcTypeEnv
      (if (>= phase-owner-id 0)
        (tc-bind-arena-phase-token owner-env name phase-owner-id)
        owner-env)]
    [transition : TcCheckedLetBindingTransition
      (TcCheckedLetBindingTransition owner-kind phase-owner-id)]
    (TcCheckedLetBindingApplied (tc-bind-id phase-env name ty) transition)))

(define (tc-call-varargs-tail-args
  [expr-bases : i64]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : (& params ast.AstTypeList)]) : ResultTcExprList
  (tc-call-varargs-tail-args-at expr-bases func (& args) (& params) 0))

(define (tc-call-varargs-tail-args-at
  [expr-bases : i64]
  [func : ast.AstExpr]
  [args : (& args ast.AstExprList)]
  [params : (& params ast.AstTypeList)]
  [index : i64]) : ResultTcExprList
  (if (>= index (ast.ast-type-list-len params))
    (Ok (ast.ast-expr-list-tail-from-ref args index))
    (if (< index args.len)
      (tc-call-varargs-tail-args-at expr-bases func args params (+ index 1))
      (Err
        (tc-call-arity-count-message
          expr-bases
          func
          (ast.ast-type-list-len params)
          args.len)))))

(define (tc-type-list-append [a : ast.AstTypeList] [b : ast.AstTypeList]) : ast.AstTypeList
  (let
    [out : ast.AstTypeList
      (ast.ast-type-list-with-capacity
        (+ (ast.ast-type-list-len (& a)) (ast.ast-type-list-len (& b))))]
    (ast.ast-type-list-append-from (&mut out) (& a) 0)
    (ast.ast-type-list-append-from (&mut out) (& b) 0)
    out))

(define (tc-type-list-repeat [ty : ast.AstType] [count : i64]) : ast.AstTypeList
  (let
    [out : ast.AstTypeList (ast.ast-type-list-with-capacity count)]
    [id : i64 (ast.ast-node-pool-reader-type-push (& ty))]
    (tc-type-list-repeat-into (&mut out) id count)
    out))

(define (tc-type-list-repeat-into
  [out : (&mut out ast.AstTypeList)]
  [id : i64]
  [count : i64]) : unit
  (unless
    (<= count 0)
    (ast.ast-type-list-push out id)
    (tc-type-list-repeat-into out id (- count 1))))

(define (tc-call-open-varargs-tail-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : ast.AstExprList]) : ResultTcTypeList
  (let
    [out : ast.AstTypeList (ast.ast-type-list-new)]
    [_
      (try
        (tc-call-open-varargs-tail-types-into-at ctx env (& args) 0 (&mut out)))]
    (Ok out)))

(define (tc-call-open-varargs-tail-types-into-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [index : i64]
  [out : (&mut out ast.AstTypeList)]) : ResultTcUnit
  (if (>= index args.len)
    Ok
    (let
      [arg : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get args index 0))]
      [ty (try (tc-expr ctx env arg))]
      [resolved : ast.AstType (tc-resolve-type ctx (tc-global-shared-view ty))]
      (if (tc-extern-abi-value-type-ok? ctx (tc-global-shared-view resolved))
        (begin
          (ast.ast-type-list-push
            out
            (ast.ast-node-pool-reader-type-push (& ty)))
          (tc-call-open-varargs-tail-types-into-at ctx env args (+ index 1) out))
        (Err (tc-extern-abi-unsupported-message "variadic argument" resolved))))))

(define (tc-call-extern-varargs-params
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [abi : ast.AstExternAbi]) : ResultTcTypeList
  (let
    [tail-args : ast.AstExprList
      (try
        (tc-call-varargs-tail-args (tc-context-expr-bases ctx) func args params))]
    (if (ast.ast-extern-abi-c-varargs-open? (& abi))
      (let
        [tail-types : ast.AstTypeList
          (try (tc-call-open-varargs-tail-types ctx env tail-args))]
        (Ok (tc-type-list-append params tail-types)))
      (if (ast.ast-extern-abi-c-varargs-typed? (& abi))
        (let
          [tail-ty : ast.AstType
            (tc-resolve-type ctx (ast.ast-extern-abi-varargs-tail-type abi))]
          (Ok
            (tc-type-list-append
              params
              (tc-type-list-repeat tail-ty (tc-expr-list-len tail-args)))))
        (Ok params)))))

(define (tc-call-function-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [ret : ast.AstType]) : ResultTcType
  (match (tc-call-extern-abi ctx (tc-global-shared-view func))
    [(Some abi)
      (if (tc-call-dynamic-c-varargs-abi? (tc-global-shared-view abi))
        (let
          [expanded-params
            (try
              (tc-call-extern-varargs-params
                ctx
                env
                (tc-global-shared-view func)
                (tc-global-shared-view args)
                params
                abi))]
          (tc-call-function-type-normal ctx env func args expanded-params ret))
        (tc-call-function-type-normal ctx env func args params ret))]
    [(No) (tc-call-function-type-normal ctx env func args params ret)]))

(define (tc-thread-name-last-dot [name : (& name str)]) : i64
  (let
    [first : i64 (tc-name-first-dot name)]
    (if (< first 0)
      -1
      (let
        [i : i64 (+ first 1)]
        [n : i64 (string.string-length name)]
        [last : i64 first]
        (while (< i n)
          (if (string.char-eq (string.string-ref name i) '.')
            (set! last i)
            unit)
          (set! i (+ i 1)))
        last))))

(define (tc-thread-name-base [name : String]) : String
  (if (tc-name-qualified? name)
    (tc-qualified-name-base name)
    name))

(define (tc-thread-source-name-base [name : String]) : String
  (if (tc-name-qualified? name)
    (tc-qualified-name-base name)
    (let
      [dot : i64 (tc-thread-name-last-dot name)]
      (if (and (>= dot 0) (< dot (- (string.string-length name) 1)))
        (string.substring
          name
          (+ dot 1)
          (- (string.string-length name) (+ dot 1)))
        name))))

(define (tc-thread-name-base-eq? [name : String] [base : String]) : bool
  (tc-name-base-eq? name base))

(define (tc-thread-generated-module-prefix) : String
  "stdlib.thread.generated.")

(define (tc-thread-generated-module? [module : String]) : bool
  (tc-string-prefix? module (tc-thread-generated-module-prefix)))

(define (tc-thread-generated-module-type-key [module : String]) : String
  (let
    [prefix-len : i64
      (string.string-length (tc-thread-generated-module-prefix))]
    [module-len : i64 (string.string-length module)]
    (if (tc-thread-generated-module? (tc-global-shared-view module))
      (string.substring module prefix-len (- module-len prefix-len))
      "")))

(define (tc-thread-generated-name-module [name : String] [base : String]) : TcMaybeString
  (if (tc-name-qualified? name)
    (let
      [module : String (tc-qualified-name-module (tc-global-shared-view name))]
      (if (and
        (tc-thread-generated-module? (tc-global-shared-view module))
        (string.eq (tc-qualified-name-base name) base))
        (Some module)
        (No)))
    (No)))

(define (tc-thread-generated-name? [name : String] [base : String]) : bool
  (match (tc-thread-generated-name-module name base)
    [(Some _) true]
    [(No) false]))

(define (tc-thread-type-name-base? [name : String] [base : String]) : bool
  (string.eq (tc-thread-name-base name) base))

(define (tc-thread-generated-handle-type-name? [name : String]) : bool
  (or
    (tc-thread-generated-name? (tc-global-shared-view name) "Handle")
    (and
      (not (tc-name-qualified? (& name)))
      (>= (tc-thread-name-last-dot name) 0)
      (string.eq (tc-thread-source-name-base name) "Handle"))))

(define (tc-spawn-string-name? [name : String]) : bool
  (string.eq (tc-thread-source-name-base name) "spawn-string"))

(define (tc-spawn-i64-vec-name? [name : String]) : bool
  (string.eq (tc-thread-source-name-base name) "spawn-i64-vec"))

(define (tc-spawn-box-i64-name? [name : String]) : bool
  (string.eq (tc-thread-source-name-base name) "spawn-box-i64"))

(define (tc-thread-legacy-safe-spawn-base? [base : String]) : bool
  (or
    (string.eq base "spawn-string")
    (string.eq base "spawn-i64-vec")
    (string.eq base "spawn-box-i64")))

(define (tc-thread-legacy-safe-spawn-name? [name : String]) : bool
  (tc-thread-legacy-safe-spawn-base? (tc-thread-source-name-base name)))

(define (tc-thread-safe-handle-type-name? [name : String]) : bool
  (let
    [base : String (tc-thread-name-base (tc-global-shared-view name))]
    (or
      (tc-thread-generated-handle-type-name? name)
      (string.eq base "ThreadString")
      (string.eq base "ThreadI64Vec")
      (string.eq base "ThreadBoxI64"))))

(define (tc-thread-spawn-lookup-name
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-name : String]
  [source-id : i64]) : String
  (match (tc-source-name-lookup-key-with-field-check
    ctx
    env
    (tc-global-shared-view source-name)
    source-id
    true)
    [(Ok lookup-name) lookup-name]
    [(Err _) source-name]))

(define (tc-thread-potential-safe-spawn-name?
  [source-name : String]
  [lookup-name : String]) : bool
  (or
    (tc-thread-legacy-safe-spawn-name? (tc-global-shared-view source-name))
    (tc-thread-legacy-safe-spawn-name? (tc-global-shared-view lookup-name))
    (tc-thread-generated-name? (tc-global-shared-view lookup-name) "spawn")
    (string.eq (tc-thread-source-name-base source-name) "spawn")
    (string.eq (tc-thread-name-base lookup-name) "spawn")))

(define (tc-thread-potential-safe-spawn-source-name? [source-name : String]) : bool
  (let
    [base : String (tc-thread-source-name-base source-name)]
    (or (string.eq base "spawn") (tc-thread-legacy-safe-spawn-base? base))))

(define (tc-thread-channel-send-name? [name : String]) : bool
  (let
    [base : String (tc-thread-source-name-base name)]
    (and
      (tc-string-prefix? (tc-global-shared-view base) "channel-")
      (tc-string-has-suffix? base "-send"))))

;; Classifying a call name for the thread-safety checks costs a qualified?
;; scan plus a last-dot scan over the rendered name, and both checks run for
;; every call expression in the program. The answers depend only on a typed
;; renderable source-name ID and its immutable intern-session owner. A job-owned
;; sparse epoch map avoids allocating `intern-capacity` slots and never consults
;; the active process-global intern selector.
(define (tc-thread-name-kind-ensure-owner!
  [state : TcThreadNameKindState]
  [table-id : i64]
  [generation : i64]) : TcThreadNameKindStateData
  (let
    [data : TcThreadNameKindStateData (tc-thread-name-kind-state-data state)]
    (unless
      (and
        (= data.intern-generation generation)
        (= data.intern-table-id table-id))
      (tc-cache-map-clear! (&mut data.kinds))
      (set! data.epoch (+ data.epoch 1))
      (set! data.intern-generation generation)
      (set! data.intern-table-id table-id)
      (tc-thread-name-kind-state-data-set! state (tc-global-shared-view data)))
    data))

(define (tc-thread-name-kind-compute [name : String]) : i64
  (bit-or
    (if (tc-thread-channel-send-name? (tc-global-shared-view name))
      1
      0)
    (if (tc-thread-potential-safe-spawn-source-name? name)
      2
      0)))

(define (tc-thread-name-kind-owned
  [state : TcThreadNameKindState]
  [table-id : i64]
  [generation : i64]
  [source-name-id : ci.InternId]
  [name : String]) : i64
  (let
    [data : TcThreadNameKindStateData
      (tc-thread-name-kind-ensure-owner! state table-id generation)]
    [key : i64 (ci.intern-id-value source-name-id)]
    (if (not data.accelerator-enabled)
      (tc-thread-name-kind-compute name)
      (let
        [packed : i64 (tc_i64_i64_map.get-value-or (& data.kinds) key 0)]
        (if (= (shr packed 2) data.epoch)
          (bit-and packed 3)
          (let
            [kind : i64 (tc-thread-name-kind-compute name)]
            (tc-cache-map-grow-in-owner! (&mut data.kinds) data.owner-arena)
            (tc_i64_i64_map.insert-ref!
              (&mut data.kinds)
              key
              (bit-or (shl data.epoch 2) kind))
            (tc-thread-name-kind-state-data-set! state data)
            kind))))))

(define (tc-thread-name-kind
  [ctx : TcContext]
  [source-name-id : i64]
  [name : String]) : i64
  (let
    [session : ci.InternSourceNameSession
      (ci.intern-source-name-session-handle-session
        (tc-context-source-names ctx))]
    [identity : ci.InternSyntaxTextIdentity
      (ci.intern-source-name-session-identity session source-name-id)]
    (match (ci.intern-source-name-session-resolve session identity (& name))
      [(ParsedIdentity owned-id)
        (tc-thread-name-kind-owned
          (tc-job-state-thread-name-kind (tc-context-job-state ctx))
          session.table-id
          session.reset-generation
          (ci.intern-id-from-renderable owned-id)
          name)]
      [(GeneratedIdentity owned-id lookup)
        (match lookup
          [(InternLookupFound resolved-id)
            (if (= owned-id resolved-id)
              (tc-thread-name-kind-owned
                (tc-job-state-thread-name-kind (tc-context-job-state ctx))
                session.table-id
                session.reset-generation
                (ci.intern-id-from-renderable owned-id)
                name)
              (tc-thread-name-kind-compute name))]
          [_ (tc-thread-name-kind-compute name)])]
      [_ (tc-thread-name-kind-compute name)])))

(define (tc-thread-safe-spawn-call-name
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]) : TcMaybeString
  (let
    [nid : i64 (tc-expr-var-name-id (tc-context-expr-segment-bases ctx) func)]
    (if (>= nid 0)
      (let
        [source-id : i64
          (macro-hygiene-global-source-name-id-or
            (tc-context-structural-session ctx)
            nid
            nid)]
        [name : String (ci.intern-str source-id)]
        (if (=
          (bit-and
            (tc-thread-name-kind ctx source-id (tc-global-shared-view name))
            2)
          2)
          (if (tc-thread-potential-safe-spawn-name?
            (tc-global-shared-view name)
            (tc-thread-spawn-lookup-name
              ctx
              env
              (tc-global-shared-view name)
              source-id))
            (Some name)
            (No))
          (No)))
      (No))))

(define (tc-thread-channel-send-call-name
  [ctx : TcContext]
  [func : ast.AstExpr]) : TcMaybeString
  (let
    [nid : i64 (tc-expr-var-name-id (tc-context-expr-segment-bases ctx) func)]
    (if (>= nid 0)
      (let
        [source-id : i64
          (macro-hygiene-global-source-name-id-or
            (tc-context-structural-session ctx)
            nid
            nid)]
        [name : String (ci.intern-str source-id)]
        (if (=
          (bit-and
            (tc-thread-name-kind ctx source-id (tc-global-shared-view name))
            1)
          1)
          (Some name)
          (No)))
      (No))))

(define (tc-thread-channel-send-result-name? [name : String]) : bool
  (tc-string-has-suffix? (tc-thread-name-base name) "SendResult"))

(define (tc-thread-channel-send-result-type?
  [ctx : TcContext]
  [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(or (Enum name) (EnumArgs name _))
      (tc-thread-channel-send-result-name? (tc-nominal-name-id-display name))]
    [_ false]))

(define (tc-thread-channel-send-message-param [params : ast.AstTypeList]) : ResultTcType
  (if (= (ast.ast-type-list-len (& params)) 2)
    (Ok
      (ast.ty-node-get
        (ast.ast-type-list-get (& params) 1 (ast.ast-type-id-fallback))))
    (Err "typecheck: channel send expects channel and message parameters")))

(define (tc-thread-channel-send-message-arg
  [expr-bases : i64]
  [args : ast.AstExprList]) : ResultTcExpr
  (if (= args.len 2)
    (Ok
      (ast.ast-expr-segment-bases-get
        expr-bases
        (ast.ast-expr-list-get (& args) 1 0)))
    (Err "typecheck: channel send expects channel and message arguments")))

(define (tc-thread-generated-spawn-result-module
  [ctx : TcContext]
  [ty : ast.AstType]) : TcMaybeString
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(or (Enum name) (EnumArgs name _))
      (tc-thread-generated-name-module
        (tc-nominal-name-id-display name)
        "SpawnResult")]
    [_ (No)]))

(define (tc-thread-spawn-result-type-base? [ctx : TcContext] [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(or (Enum name) (EnumArgs name _))
      (tc-thread-type-name-base?
        (tc-nominal-name-id-display name)
        "SpawnResult")]
    [_ false]))

(define (tc-thread-safe-spawn-result-type-name? [name : String]) : bool
  (let
    [base : String (tc-thread-name-base name)]
    (or
      (string.eq base "SpawnResult")
      (string.eq base "ThreadStringSpawnResult")
      (string.eq base "ThreadI64VecSpawnResult")
      (string.eq base "ThreadBoxI64SpawnResult"))))

(define (tc-thread-safe-user-type? [ctx : TcContext] [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(or (Struct name) (StructArgs name _))
      (tc-thread-safe-handle-type-name? (tc-nominal-name-id-display name))]
    [(or (Enum name) (EnumArgs name _))
      (tc-thread-safe-spawn-result-type-name? (tc-nominal-name-id-display name))]
    [_ false]))

(define (tc-thread-generated-spawn-module
  [ctx : TcContext]
  [source-name : String]
  [lookup-name : String]
  [ret : ast.AstType]) : TcMaybeString
  (match (tc-thread-generated-name-module
    (tc-global-shared-view lookup-name)
    "spawn")
    [(Some module) (Some module)]
    [(No)
      (if (or
        (string.eq (tc-thread-source-name-base source-name) "spawn")
        (string.eq (tc-thread-name-base lookup-name) "spawn"))
        (match (tc-thread-generated-spawn-result-module
          ctx
          (tc-global-shared-view ret))
          [(Some module) (Some module)]
          [(No)
            (if (tc-thread-spawn-result-type-base? ctx ret)
              (Some "")
              (No))])
        (No))]))

(define (tc-thread-generated-spawn-result-type?
  [ctx : TcContext]
  [module : String]
  [ty : ast.AstType]) : bool
  (if (string.eq module "")
    (tc-thread-spawn-result-type-base? ctx ty)
    (match (tc-thread-generated-spawn-result-module ctx ty)
      [(Some result-module) (string.eq result-module module)]
      [(No) false])))

(define (tc-thread-legacy-safe-spawn-result-type-name?
  [spawn-name : String]
  [result-name : String]) : bool
  (cond
    [(tc-spawn-string-name? (tc-global-shared-view spawn-name))
      (tc-thread-name-base-eq? result-name "ThreadStringSpawnResult")]
    [(tc-spawn-i64-vec-name? (tc-global-shared-view spawn-name))
      (tc-thread-name-base-eq? result-name "ThreadI64VecSpawnResult")]
    [(tc-spawn-box-i64-name? spawn-name)
      (tc-thread-name-base-eq? result-name "ThreadBoxI64SpawnResult")]
    [else false]))

(define (tc-thread-safe-spawn-result-type?
  [ctx : TcContext]
  [source-name : String]
  [lookup-name : String]
  [generated-module : TcMaybeString]
  [ty : ast.AstType]) : bool
  (match generated-module
    [(Some module) (tc-thread-generated-spawn-result-type? ctx module ty)]
    [(No)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(or (Enum name) (EnumArgs name _))
          (or
            (tc-thread-legacy-safe-spawn-result-type-name?
              source-name
              (tc-nominal-name-id-display name))
            (tc-thread-legacy-safe-spawn-result-type-name?
              lookup-name
              (tc-nominal-name-id-display name)))]
        [_ false])]))

(define (tc-thread-generated-spawn-task-ret-type?
  [ctx : TcContext]
  [module : String]
  [ty : ast.AstType]) : bool
  (let
    [type-key : String
      (tc-thread-generated-module-type-key (tc-global-shared-view module))]
    [resolved : ast.AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
    (cond
      [(string.eq module "")
        (match resolved
          [(or (I64) (Bool) (Unit)) true]
          [_ false])]
      [(string.eq type-key "i64")
        (match resolved
          [(I64) true]
          [_ false])]
      [(string.eq type-key "bool")
        (match resolved
          [(Bool) true]
          [_ false])]
      [(string.eq type-key "unit")
        (match resolved
          [(Unit) true]
          [_ false])]
      [else false])))

(define (tc-thread-safe-spawn-task-ret-type?
  [ctx : TcContext]
  [source-name : String]
  [lookup-name : String]
  [generated-module : TcMaybeString]
  [ty : ast.AstType]) : bool
  (match generated-module
    [(Some module) (tc-thread-generated-spawn-task-ret-type? ctx module ty)]
    [(No)
      (let
        [resolved : ast.AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
        (cond
          [(or
              (tc-spawn-string-name? (tc-global-shared-view source-name))
              (tc-spawn-string-name? (tc-global-shared-view lookup-name)))
            (match resolved
              [(String) true]
              [_ false])]
          [(or
              (tc-spawn-i64-vec-name? (tc-global-shared-view source-name))
              (tc-spawn-i64-vec-name? (tc-global-shared-view lookup-name)))
            (match resolved
              [(Struct name)
                (let
                  [display : String (tc-nominal-name-id-display name)]
                  (and
                    (tc-name-qualified? display)
                    (string.eq
                      (tc-qualified-name-module (tc-global-shared-view display))
                      "stdlib.vector.generated.i64")
                    (string.eq (tc-qualified-name-base display) "Vec")))]
              [_ false])]
          [(or
              (tc-spawn-box-i64-name? source-name)
              (tc-spawn-box-i64-name? lookup-name))
            (match resolved
              [(Box elem)
                (match (tc-type-strip-region
                  (tc-resolve-type ctx (ast.ty-node-get elem)))
                  [(I64) true]
                  [_ false])]
              [_ false])]
          [else false]))]))

(define (tc-thread-safe-spawn-task-type?
  [ctx : TcContext]
  [source-name : String]
  [lookup-name : String]
  [generated-module : TcMaybeString]
  [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(Func task-params task-ret-box)
      (let
        [task-param-list : ast.AstTypeList
          (ast.ast-type-list-box-shared-view task-params)]
        (if (ast.ast-type-list-empty? (& task-param-list))
          (tc-thread-safe-spawn-task-ret-type?
            ctx
            source-name
            lookup-name
            generated-module
            (ast.ty-node-get task-ret-box))
          false))]
    [_ false]))

(define (tc-thread-safe-spawn-signature?
  [ctx : TcContext]
  [source-name : String]
  [lookup-name : String]
  [params : ast.AstTypeList]
  [ret : ast.AstType]) : bool
  (let
    [generated-module : TcMaybeString
      (tc-thread-generated-spawn-module
        ctx
        (tc-global-shared-view source-name)
        (tc-global-shared-view lookup-name)
        (tc-global-shared-view ret))]
    (and
      (tc-thread-safe-spawn-result-type?
        ctx
        (tc-global-shared-view source-name)
        (tc-global-shared-view lookup-name)
        (tc-global-shared-view generated-module)
        ret)
      (if (= (ast.ast-type-list-len (& params)) 1)
        (tc-thread-safe-spawn-task-type?
          ctx
          source-name
          lookup-name
          generated-module
          (ast.ty-node-get
            (ast.ast-type-list-get (& params) 0 (ast.ast-type-id-fallback))))
        false))))

(define (tc-thread-transfer-class-merge
  [left : TcThreadTransferClass]
  [right : TcThreadTransferClass]) : TcThreadTransferClass
  (match (& left)
    [(Rejected _) left]
    [(Transferable)
      (match (& right)
        [(Rejected _) right]
        [_ (Transferable)])]
    [(Shareable)
      (match (& right)
        [(Rejected _) right]
        [(Transferable) (Transferable)]
        [(Shareable) (Shareable)])]))

(define (tc-thread-transfer-reject [message : String]) : TcThreadTransferClass
  (Rejected message))

(define (tc-thread-transfer-aggregate-class [class : TcThreadTransferClass]) : TcThreadTransferClass
  (match (& class)
    [(Rejected _) class]
    [_ (Transferable)]))

(define (tc-thread-transfer-region-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "scoped-region and lifetime-parameterized values cannot cross thread boundaries"))

(define (tc-thread-transfer-reference-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "borrowed references cannot cross thread boundaries"))

(define (tc-thread-transfer-mut-reference-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "mutable references cannot cross thread boundaries"))

(define (tc-thread-transfer-raw-pointer-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "raw pointers cannot cross thread boundaries in safe code"))

(define (tc-thread-transfer-owned-heap-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "owned heap storage needs a static/program or spanning atomic owner proof"))

(define (tc-thread-transfer-cleanup-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "cleanup-required resources cannot cross thread boundaries"))

(define (tc-thread-transfer-type-list-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [types : ast.AstTypeList]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (tc-thread-transfer-type-list-class-at ctx env (& types) stack owner-proof 0))

(define (tc-thread-transfer-type-list-class-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [types : (& types ast.AstTypeList)]
  [stack : TcStringList]
  [owner-proof : bool]
  [index : i64]) : TcThreadTransferClass
  (if (>= index (ast.ast-type-list-len types))
    (Shareable)
    (tc-thread-transfer-class-merge
      (tc-thread-transfer-type-class
        ctx
        env
        (ast.ty-node-get
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))
        (tc-global-shared-view stack)
        owner-proof)
      (tc-thread-transfer-type-list-class-at
        ctx
        env
        types
        stack
        owner-proof
        (+ index 1)))))

(define (tc-thread-transfer-field-list-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [fields : ast.AstFieldDefList]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (tc-thread-transfer-field-list-class-at
    ctx
    env
    (& fields)
    stack
    owner-proof
    0))

(define (tc-thread-transfer-field-list-class-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [fields : (& fields ast.AstFieldDefList)]
  [stack : TcStringList]
  [owner-proof : bool]
  [index : i64]) : TcThreadTransferClass
  (if (>= index fields.len)
    (Shareable)
    (match (ast.ast-field-def-list-get
      fields
      index
      (ast.ast-field-def-fallback))
      [(Def _ ty _)
        (tc-thread-transfer-class-merge
          (tc-thread-transfer-type-class
            ctx
            env
            ty
            (tc-global-shared-view stack)
            owner-proof)
          (tc-thread-transfer-field-list-class-at
            ctx
            env
            fields
            stack
            owner-proof
            (+ index 1)))])))

(define (tc-thread-transfer-variant-list-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [variants : ast.AstVariantDefList]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (tc-thread-transfer-variant-list-class-at
    ctx
    env
    (& variants)
    stack
    owner-proof
    0))

(define (tc-thread-transfer-variant-list-class-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [variants : (& variants ast.AstVariantDefList)]
  [stack : TcStringList]
  [owner-proof : bool]
  [index : i64]) : TcThreadTransferClass
  (if (>= index variants.len)
    (Shareable)
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(Def _ payloads _)
        (tc-thread-transfer-class-merge
          (tc-thread-transfer-type-list-class
            ctx
            env
            payloads
            (tc-global-shared-view stack)
            owner-proof)
          (tc-thread-transfer-variant-list-class-at
            ctx
            env
            variants
            stack
            owner-proof
            (+ index 1)))])))

(define (tc-thread-transfer-struct-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [struct-name-id : i64]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (if (tc-string-list-contains
    (tc-global-shared-view stack)
    (tc-global-shared-view struct-name))
    (tc-thread-transfer-reject
      (str_cat.str-cat
        "recursive aggregate "
        struct-name
        " needs an explicit spanning owner proof"))
    (match (tc-struct-decl-id ctx struct-name-id)
      [(Ok decl)
        (match decl
          [(TcStructDecl _ cleanup fields)
            (if (ast.ast-struct-cleanup? cleanup)
              (tc-thread-transfer-cleanup-reject)
              (tc-thread-transfer-aggregate-class
                (tc-thread-transfer-field-list-class
                  ctx
                  env
                  fields
                  (tc-string-list-add stack struct-name)
                  owner-proof)))])]
      [(Err message) (tc-thread-transfer-reject message)])))

(define (tc-thread-transfer-enum-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [enum-name-id : i64]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (if (tc-string-list-contains
    (tc-global-shared-view stack)
    (tc-global-shared-view enum-name))
    (tc-thread-transfer-reject
      (str_cat.str-cat
        "recursive aggregate "
        enum-name
        " needs an explicit spanning owner proof"))
    (match (tc-enum-decl-id ctx enum-name-id)
      [(Ok decl)
        (match decl
          [(TcEnumDecl cleanup variants)
            (if (ast.ast-enum-cleanup? cleanup)
              (tc-thread-transfer-cleanup-reject)
              (tc-thread-transfer-aggregate-class
                (tc-thread-transfer-variant-list-class
                  ctx
                  env
                  variants
                  (tc-string-list-add stack enum-name)
                  owner-proof)))])]
      [(Err message) (tc-thread-transfer-reject message)])))

(define (tc-thread-transfer-type-class-with-stack
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : ast.AstType]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (let
    [resolved : ast.AstType (tc-resolve-type ctx ty)]
    [atomic-owner-regions : bool
      (tc-type-regions-all-atomic-arena-owners?
        env
        (tc-global-shared-view resolved))]
    (match resolved
      [(Region region inner)
        (cond
          [(tc-atomic-arena-owner-active-id? env region)
            (tc-thread-transfer-type-class
              ctx
              env
              (ast.ty-node-get inner)
              stack
              true)]
          [(tc-ordinary-arena-owner-active-id? env region)
            (tc-thread-transfer-owned-heap-reject)]
          [else (tc-thread-transfer-region-reject)])]
      [(or (Ref _ _) (Str) (Bytes) (Slice _))
        (tc-thread-transfer-reference-reject)]
      [(MutRef _ _) (tc-thread-transfer-mut-reference-reject)]
      [(or (Ptr _) (MutPtr _)) (tc-thread-transfer-raw-pointer-reject)]
      [(String)
        (if owner-proof
          (Shareable)
          (tc-thread-transfer-owned-heap-reject))]
      [(or (DynArray elem) (Box elem))
        (if owner-proof
          (tc-thread-transfer-aggregate-class
            (tc-thread-transfer-type-class
              ctx
              env
              (ast.ty-node-get elem)
              stack
              owner-proof))
          (tc-thread-transfer-owned-heap-reject))]
      [(Tuple elems)
        (tc-thread-transfer-aggregate-class
          (tc-thread-transfer-type-list-class
            ctx
            env
            (ast.ast-type-list-box-shared-view elems)
            stack
            owner-proof))]
      [(Array elem _)
        (tc-thread-transfer-aggregate-class
          (tc-thread-transfer-type-class
            ctx
            env
            (ast.ty-node-get elem)
            stack
            owner-proof))]
      [(Struct name)
        (tc-thread-transfer-struct-class
          ctx
          env
          (tc-nominal-name-id-display name)
          name
          stack
          owner-proof)]
      [(StructArgs name lifetimes)
        (if (and
          (> (tc-lifetime-list-count (deref lifetimes)) 0)
          (not owner-proof)
          (not atomic-owner-regions))
          (tc-thread-transfer-region-reject)
          (tc-thread-transfer-struct-class
            ctx
            env
            (tc-nominal-name-id-display name)
            name
            stack
            (or owner-proof atomic-owner-regions)))]
      [(Enum name)
        (tc-thread-transfer-enum-class
          ctx
          env
          (tc-nominal-name-id-display name)
          name
          stack
          owner-proof)]
      [(EnumArgs name lifetimes)
        (if (and
          (> (tc-lifetime-list-count (deref lifetimes)) 0)
          (not owner-proof)
          (not atomic-owner-regions))
          (tc-thread-transfer-region-reject)
          (tc-thread-transfer-enum-class
            ctx
            env
            (tc-nominal-name-id-display name)
            name
            stack
            (or owner-proof atomic-owner-regions)))]
      [(Func _ _)
        (tc-thread-transfer-reject
          "function value transfer requires a direct no-capture function symbol")]
      [(or (Expr) (ExprList))
        (tc-thread-transfer-reject
          "compile-time expression values cannot cross thread boundaries")]
      [(Var _)
        (tc-thread-transfer-reject
          "unresolved type variable cannot cross thread boundaries")]
      [(VarArgs _ _)
        (tc-thread-transfer-reject
          "unresolved lifetime-parameterized type cannot cross thread boundaries")]
      [_ (Shareable)])))

(define (tc-thread-transfer-type-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : ast.AstType]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (tc-thread-transfer-type-class-with-stack ctx env ty stack owner-proof))

(define (tc-thread-transfer-classify-type-in-env
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : ast.AstType]) : TcThreadTransferClass
  (tc-thread-transfer-type-class ctx env ty Nil false))

(define (tc-region-list-atomic-arena-owners
  [env : TcTypeEnv]
  [regions : TcNameIdList]
  [out : TcNameIdList]) : TcNameIdList
  (let
    [cursor : TcNameIdList regions]
    [owners : TcNameIdList out]
    (while (not (tc-name-id-list-empty? cursor))
      (let
        [region : i64 (tc-name-id-list-head cursor)]
        (if (tc-atomic-arena-owner-active-id? env region)
          (set! owners (tc-name-id-list-add owners region))
          unit)
        (set! cursor (tc-name-id-list-rest cursor))))
    owners))

(define (tc-type-atomic-arena-owner-regions
  [env : TcTypeEnv]
  [ty : ast.AstType]) : TcNameIdList
  (tc-region-list-atomic-arena-owners env (tc-type-collect-regions ty) Nil))

(define (tc-thread-safe-spawn-capture-message
  [spawn-name : String]
  [ctx : TcContext]
  [name : String]
  [ty : ast.AstType]
  [reason : String]) : String
  (str_cat.str-cat
    (tc-kind-message (ThreadSafety) "typecheck: ")
    spawn-name
    " cannot capture `"
    name
    "` of type "
    (tc-type-render (tc-type-without-regions (tc-resolve-type ctx ty)))
    "; "
    reason))

(define (tc-check-thread-safe-spawn-captures-scan-root
  [expr-bases : i64]
  [spawn-name : String]
  [ctx : TcContext]
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [body : ast.AstExpr]) : ResultTcUnit
  (match (tc-type-env-marker-step env)
    [(Done) Ok]
    [(Cache rest-env)
      (tc-check-thread-safe-spawn-captures-scan-root
        expr-bases
        spawn-name
        ctx
        root
        rest-env
        bound
        body)]
    [(Bind key ty rest-env)
      (let
        [name : String
          (if (tc-env-key-has-name-id? key)
            (ci.intern-str key)
            "")]
        (cond
          [(or
              (= key (tc-region-marker-id))
              (= key (tc-default-boundary-id))
              (tc-cleanup-owner-marker-entry? key ty)
              (tc-ordinary-arena-owner-marker-entry?
                key
                (tc-global-shared-view ty))
              (tc-atomic-arena-owner-marker-entry?
                key
                (tc-global-shared-view ty))
              (not (tc-env-key-has-name-id? key)))
            (tc-check-thread-safe-spawn-captures-scan-root
              expr-bases
              spawn-name
              ctx
              root
              rest-env
              bound
              body)]
          [(not
              (tc-expr-uses-free-name?
                expr-bases
                (tc-global-shared-view body)
                (tc-global-shared-view name)
                (tc-global-shared-view bound)))
            (tc-check-thread-safe-spawn-captures-scan-root
              expr-bases
              spawn-name
              ctx
              root
              rest-env
              bound
              body)]
          [(tc-expr-sets-free-name?
              expr-bases
              (tc-global-shared-view body)
              (tc-global-shared-view name)
              (tc-global-shared-view bound))
            (Err
              (str_cat.str-cat
                (cdiag.compiler-diagnostic-typecheck-tag (ThreadSafety))
                "typecheck: "
                spawn-name
                " lambda cannot assign captured binding"))]
          [(tc-ordinary-arena-owner-active-id? root key)
            (Err
              (str_cat.str-cat
                (cdiag.compiler-diagnostic-typecheck-tag (ThreadSafety))
                "typecheck: "
                spawn-name
                " cannot capture ordinary arena handle `"
                name
                "`; use arena-make-atomic for a spanning owner"))]
          [(tc-cleanup-owner-active-id? root key)
            (Err
              (str_cat.str-cat
                (cdiag.compiler-diagnostic-typecheck-tag (ThreadSafety))
                "typecheck: "
                spawn-name
                " cannot capture cleanup-required resource"))]
          [else
            (match (tc-thread-transfer-classify-type-in-env
              ctx
              root
              (tc-global-shared-view ty))
              [(Rejected reason)
                (Err
                  (tc-thread-safe-spawn-capture-message
                    spawn-name
                    ctx
                    name
                    ty
                    reason))]
              [_
                (tc-check-thread-safe-spawn-captures-scan-root
                  expr-bases
                  spawn-name
                  ctx
                  root
                  rest-env
                  bound
                  body)])]))]))

(define (tc-check-thread-safe-spawn-captures
  [spawn-name : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : ast.AstParamList]
  [body : ast.AstExpr]) : ResultTcUnit
  (tc-check-thread-safe-spawn-captures-scan-root
    (tc-context-expr-bases ctx)
    spawn-name
    ctx
    env
    (tc-type-env-marker-start env)
    (tc-param-bound-names params)
    body))

(define (tc-thread-safe-spawn-captured-owner-regions-scan-root
  [expr-bases : i64]
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [body : ast.AstExpr]
  [owners : TcNameIdList]) : TcNameIdList
  (match (tc-type-env-marker-step env)
    [(Done) owners]
    [(Cache rest-env)
      (tc-thread-safe-spawn-captured-owner-regions-scan-root
        expr-bases
        root
        rest-env
        bound
        body
        owners)]
    [(Bind key ty rest-env)
      (let
        [name : String
          (if (tc-env-key-has-name-id? key)
            (ci.intern-str key)
            "")]
        (cond
          [(or
              (= key (tc-region-marker-id))
              (= key (tc-default-boundary-id))
              (tc-cleanup-owner-marker-entry? key ty)
              (tc-ordinary-arena-owner-marker-entry?
                key
                (tc-global-shared-view ty))
              (tc-atomic-arena-owner-marker-entry?
                key
                (tc-global-shared-view ty))
              (not (tc-env-key-has-name-id? key)))
            (tc-thread-safe-spawn-captured-owner-regions-scan-root
              expr-bases
              root
              rest-env
              bound
              body
              owners)]
          [(not
              (tc-expr-uses-free-name?
                expr-bases
                (tc-global-shared-view body)
                name
                (tc-global-shared-view bound)))
            (tc-thread-safe-spawn-captured-owner-regions-scan-root
              expr-bases
              root
              rest-env
              bound
              body
              owners)]
          [else
            (tc-thread-safe-spawn-captured-owner-regions-scan-root
              expr-bases
              root
              rest-env
              bound
              body
              (tc-name-id-list-add-all
                (if (tc-atomic-arena-owner-active-id? root key)
                  (tc-name-id-list-add owners key)
                  owners)
                (tc-type-atomic-arena-owner-regions root ty)))]))]))

(define (tc-thread-safe-spawn-captured-owner-regions
  [expr-bases : i64]
  [env : TcTypeEnv]
  [params : ast.AstParamList]
  [body : ast.AstExpr]) : TcNameIdList
  (tc-thread-safe-spawn-captured-owner-regions-scan-root
    expr-bases
    env
    (tc-type-env-marker-start env)
    (tc-param-bound-names params)
    body
    Nil))

(define (tc-thread-safe-spawn-direct-lambda-owner-regions
  [expr-bases : i64]
  [env : TcTypeEnv]
  [arg : ast.AstExpr]) : TcNameIdList
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& arg))
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda params _ body-box)
          (if (= (ast.ast-param-list-len (& params)) 0)
            (tc-thread-safe-spawn-captured-owner-regions
              expr-bases
              env
              params
              (ast.ast-expr-segment-bases-get expr-bases body-box))
            Nil)])]
    [_ Nil]))

(define (tc-check-thread-safe-spawn-direct-lambda-arg
  [spawn-name : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : ast.AstExpr]) : ResultTcUnit
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-segment-bases ctx)
    (& arg))
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda params _ body-box)
          (if (= (ast.ast-param-list-len (& params)) 0)
            (tc-check-thread-safe-spawn-captures
              spawn-name
              ctx
              env
              params
              (tc-context-expr-get ctx body-box))
            (Err
              (str_cat.str-cat
                (cdiag.compiler-diagnostic-typecheck-tag (ThreadSafety))
                "typecheck: "
                spawn-name
                " requires a direct nullary lambda argument so captures can be checked")))])]
    [_
      (Err
        (str_cat.str-cat
          (cdiag.compiler-diagnostic-typecheck-tag (ThreadSafety))
          "typecheck: "
          spawn-name
          " requires a direct nullary lambda argument so captures can be checked"))]))

(define (tc-check-thread-safe-spawn-direct-lambda
  [spawn-name : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : ast.AstExpr]) : ResultTcUnit
  (match (tc-active-region env)
    [(Some region)
      (if (tc-atomic-arena-owner-active-id? env region)
        (tc-check-thread-safe-spawn-direct-lambda-arg spawn-name ctx env arg)
        (Err
          (str_cat.str-cat
            (cdiag.compiler-diagnostic-typecheck-tag (ThreadSafety))
            "typecheck: "
            spawn-name
            " cannot spawn from scoped arena; closure storage would not outlive the worker")))]
    [(No) (tc-check-thread-safe-spawn-direct-lambda-arg spawn-name ctx env arg)]))

(define (tc-check-thread-safe-spawn-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [ret : ast.AstType]) : ResultTcNameIdList
  (match (tc-thread-safe-spawn-call-name ctx env (tc-global-shared-view func))
    [(Some source-name)
      (let
        [source-id : i64
          (macro-hygiene-global-source-name-id-or
            (tc-context-structural-session ctx)
            (tc-expr-var-name-id
              (tc-context-expr-segment-bases ctx)
              (tc-global-shared-view func))
            (tc-expr-var-name-id (tc-context-expr-segment-bases ctx) func))]
        [lookup-name : String
          (tc-thread-spawn-lookup-name
            ctx
            env
            (tc-global-shared-view source-name)
            source-id)]
        (if (tc-thread-safe-spawn-signature?
          ctx
          (tc-global-shared-view source-name)
          lookup-name
          params
          ret)
          (if (= args.len 1)
            (let
              [arg : ast.AstExpr
                (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
              [_
                (try
                  (tc-check-thread-safe-spawn-direct-lambda
                    source-name
                    ctx
                    env
                    (tc-global-shared-view arg)))]
              (Ok
                (tc-thread-safe-spawn-direct-lambda-owner-regions
                  (tc-context-expr-bases ctx)
                  env
                  arg)))
            (Err
              (str_cat.str-cat
                (cdiag.compiler-diagnostic-typecheck-tag (ArityMismatch))
                "typecheck: "
                source-name
                " expects one argument")))
          (Ok Nil)))]
    [(No) (Ok Nil)]))

(define (tc-thread-channel-send-message
  [send-name : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [message-ty : ast.AstType]) : ResultTcUnit
  (match (tc-thread-transfer-classify-type-in-env
    ctx
    env
    (tc-global-shared-view message-ty))
    [(Rejected reason)
      (Err
        (str_cat.str-cat
          (cdiag.compiler-diagnostic-typecheck-tag (ThreadSafety))
          "typecheck: "
          send-name
          " cannot send value of type "
          (tc-type-render
            (tc-type-without-regions (tc-resolve-type ctx message-ty)))
          "; "
          reason))]
    [_ Ok]))

(define (tc-check-thread-channel-send-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [ret : ast.AstType]) : ResultTcUnit
  (match (tc-thread-channel-send-call-name ctx func)
    [(Some send-name)
      (if (tc-thread-channel-send-result-type? ctx ret)
        (let
          [_ (try (tc-thread-channel-send-message-param params))]
          [message-expr
            (try
              (tc-thread-channel-send-message-arg
                (tc-context-expr-segment-bases ctx)
                args))]
          [message-ty (try (tc-expr ctx env message-expr))]
          (tc-thread-channel-send-message send-name ctx env message-ty))
        Ok)]
    [(No) Ok]))

(define (tc-thread-channel-send-function-result?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]) : bool
  (match (tc-expr ctx env func)
    [(Ok fn-ty)
      (match (tc-type-strip-region fn-ty)
        [(Func _ ret-box)
          (tc-thread-channel-send-result-type? ctx (ast.ty-node-get ret-box))]
        [_ false])]
    [(Err _) false]))

(define (tc-thread-channel-send-call?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]) : bool
  (match (tc-thread-channel-send-call-name ctx (tc-global-shared-view func))
    [(Some _) (tc-thread-channel-send-function-result? ctx env func)]
    [(No) false]))

(define (tc-thread-safe-spawn-call-signature?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [params : ast.AstTypeList]) : bool
  (match (tc-thread-safe-spawn-call-name ctx env (tc-global-shared-view func))
    [(Some source-name)
      (let
        [source-id : i64
          (macro-hygiene-global-source-name-id-or
            (tc-context-structural-session ctx)
            (tc-expr-var-name-id
              (tc-context-expr-segment-bases ctx)
              (tc-global-shared-view func))
            (tc-expr-var-name-id
              (tc-context-expr-segment-bases ctx)
              (tc-global-shared-view func)))]
        [lookup-name : String
          (tc-thread-spawn-lookup-name
            ctx
            env
            (tc-global-shared-view source-name)
            source-id)]
        (match (tc-expr ctx env func)
          [(Ok fn-ty)
            (match (tc-type-strip-region fn-ty)
              [(Func _ ret-box)
                (tc-thread-safe-spawn-signature?
                  ctx
                  source-name
                  lookup-name
                  params
                  (ast.ty-node-get ret-box))]
              [_ false])]
          [(Err _) false]))]
    [(No) false]))

(define (tc-call-function-type-normal
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [ret : ast.AstType]) : ResultTcType
  (let
    [allow-region-args : bool
      (tc-call-region-args-allowed-for-func
        ctx
        env
        (tc-global-shared-view func))]
    (if (tc-call-lifetime-constructor-for-func?
      ctx
      (tc-global-shared-view func)
      (tc-global-shared-view ret))
      (tc-call-lifetime-constructor-type
        ctx
        env
        func
        args
        params
        ret
        allow-region-args)
      (let
        [constructor-target : ast.AstMaybeType
          (tc-call-constructor-target-for-func
            ctx
            env
            (tc-global-shared-view func)
            (tc-global-shared-view params)
            (tc-global-shared-view ret))]
        (match (tc-global-shared-view constructor-target)
          [(Some _)
            (let
              [_
                (try
                  (tc-check-call-args
                    ctx
                    env
                    func
                    args
                    params
                    allow-region-args
                    (tc-global-shared-view constructor-target)))]
              (match constructor-target
                [(Some target) (Ok target)]
                [(No) (Ok (tc-tag-active-region env ret))]))]
          [(No)
            (let
              [lifetimes : ast.AstLifetimeList
                (tc-call-function-lifetimes
                  (tc-global-shared-view params)
                  (tc-global-shared-view ret))]
              [thread-spawn-args : bool
                (tc-thread-safe-spawn-call-signature?
                  ctx
                  env
                  (tc-global-shared-view func)
                  (tc-global-shared-view params))]
              (if (ast.ast-lifetime-list-empty? (& lifetimes))
                (let
                  [_
                    (try
                      (if thread-spawn-args
                        (tc-check-thread-spawn-args-with-message
                          ctx
                          env
                          args
                          params
                          allow-region-args
                          constructor-target
                          (Detailed
                            (tc-global-shared-view func)
                            (tc-global-shared-view args)
                            (tc-global-shared-view params)))
                        (tc-check-call-args-with-message
                          ctx
                          env
                          (tc-global-shared-view args)
                          (tc-global-shared-view params)
                          allow-region-args
                          constructor-target
                          (Detailed
                            (tc-global-shared-view func)
                            (tc-global-shared-view args)
                            (tc-global-shared-view params)))))]
                  (let
                    [spawn-owner-regions
                      (try
                        (tc-check-thread-safe-spawn-call
                          ctx
                          env
                          (tc-global-shared-view func)
                          (tc-global-shared-view args)
                          (tc-global-shared-view params)
                          (tc-global-shared-view ret)))]
                    [_
                      (try
                        (tc-check-thread-channel-send-call
                          ctx
                          env
                          func
                          args
                          params
                          (tc-global-shared-view ret)))]
                    (Ok
                      (tc-tag-regions
                        spawn-owner-regions
                        (tc-tag-active-region env ret)))))
                (tc-call-lifetime-function-type
                  ctx
                  env
                  func
                  args
                  params
                  ret
                  lifetimes
                  allow-region-args)))])))))

(define (tc-check-call-args-with-message
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [allow-region-args : bool]
  [constructor-target : ast.AstMaybeType]
  [arity-msg : TcArityMessage]) : ResultTcUnit
  (let
    [_ (try (tc-normalize-dotted-local-field-expr-list! ctx env args))]
    (tc-check-call-args-with-message-at
      ctx
      env
      (& args)
      (& params)
      0
      allow-region-args
      constructor-target
      arity-msg
      false)))

(define (tc-check-thread-spawn-args-with-message
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [params : (& params ast.AstTypeList)]
  [allow-region-args : bool]
  [constructor-target : ast.AstMaybeType]
  [arity-msg : TcArityMessage]) : ResultTcUnit
  (let
    [_ (try (tc-normalize-dotted-local-field-expr-list! ctx env args))]
    (tc-check-call-args-with-message-at
      ctx
      env
      (& args)
      (& params)
      0
      allow-region-args
      constructor-target
      arity-msg
      true)))

;; Call-only compatibility extensions. Keep ordinary inferred-type matching
;; unchanged, then admit the closed whole-array reference unsize and an owned
;; String temporary passed to a borrowed str formal. The effective-argument
;; pass has already rejected non-place values of every other referent type.
(define (tc-match-call-type-for-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [actual : ast.AstType]
  [expected : ast.AstType]) : TcInferredTypeMatch
  (match (tc-match-inferred-type-for-expected
    ctx
    env
    (tc-global-shared-view actual)
    (tc-global-shared-view expected))
    [(Compatible matched) (Compatible matched)]
    [(Mismatch mismatched)
      (if (or
        (tc-call-array-ref-to-slice-ref-compatible?
          ctx
          env
          (tc-global-shared-view expected)
          (tc-global-shared-view actual))
        (tc-call-string-temporary-ref-compatible?
          ctx
          expected
          (tc-global-shared-view actual)))
        (Compatible actual)
        (Mismatch mismatched))]))

(define (tc-check-call-args-with-message-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [params : (& params ast.AstTypeList)]
  [index : i64]
  [allow-region-args : bool]
  [constructor-target : ast.AstMaybeType]
  [arity-msg : TcArityMessage]
  [thread-spawn-args : bool]) : ResultTcUnit
  (if (>= index args.len)
    (if (>= index (ast.ast-type-list-len params))
      Ok
      (Err
        (tc-arity-message-text (tc-context-expr-segment-bases ctx) arity-msg)))
    (if (>= index (ast.ast-type-list-len params))
      (Err
        (tc-arity-message-text (tc-context-expr-segment-bases ctx) arity-msg))
      (let
        [arg : ast.AstExpr
          (tc-context-expr-get ctx (ast.ast-expr-list-get args index 0))]
        [want : ast.AstType
          (if (tc-invalidate-types-present?)
            (tc-type-strip-invalidate
              (ast.ty-node-get
                (ast.ast-type-list-get params index (ast.ast-type-id-fallback))))
            (ast.ty-node-get
              (ast.ast-type-list-get params index (ast.ast-type-id-fallback))))]
        (match (tc-call-effective-arg-expr
          ctx
          env
          (tc-global-shared-view arg)
          (tc-global-shared-view want))
          [(Ok effective-arg)
            (let
              [typed-first : ResultTcType
                (match (& constructor-target)
                  [(No)
                    (if thread-spawn-args
                      (tc-expr-with-expected-or-actual-thread-spawn-arg
                        ctx
                        env
                        (tc-global-shared-view effective-arg)
                        (tc-global-shared-view want))
                      (tc-expr-with-expected-or-actual-call-arg
                        ctx
                        env
                        (tc-global-shared-view effective-arg)
                        (tc-global-shared-view want)))]
                  [(Some _)
                    (tc-expr-with-expected-or-actual
                      ctx
                      env
                      (tc-global-shared-view effective-arg)
                      (tc-global-shared-view want))])]
              [typed-first-ok : bool
                (match (& typed-first)
                  [(ResultTcType.Ok _) true]
                  [(ResultTcType.Err _) false])]
              [typed-arg : ResultTcType
                (if typed-first-ok
                  typed-first
                  (tc-call-arg-type-after-error
                    ctx
                    env
                    (tc-global-shared-view effective-arg)
                    (tc-global-shared-view want)
                    typed-first))]
              (match typed-arg
                [(Ok got)
                  (let
                    [matched-got : TcInferredTypeMatch
                      (tc-match-call-type-for-expected
                        ctx
                        env
                        (tc-global-shared-view got)
                        (tc-global-shared-view want))]
                    [expect-result : ResultTcUnit
                      (match matched-got
                        [(Compatible _) Ok]
                        [(Mismatch actual)
                          (Err
                            (tc-locate-error-at-expr
                              (tc-context-expr-bases ctx)
                              arg
                              (tc-type-mismatch-message-in-context
                                ctx
                                env
                                actual
                                (tc-global-shared-view want)
                                (tc-argument-message-prefix-text
                                  ctx
                                  (tc-global-shared-view arity-msg)
                                  index))))])]
                    [_ (try expect-result)]
                    (if (and
                      (tc-type-contains-any-region (tc-global-shared-view got))
                      (not allow-region-args)
                      (not (tc-type-contains-any-region want))
                      (not
                        (tc-type-regions-all-atomic-arena-owners?
                          env
                          (tc-global-shared-view got)))
                      (not
                        (tc-type-contains-reference?
                          (tc-global-shared-view got))))
                      (Err
                        (let
                          [moved : String
                            (tc-move-out-of-reference-error
                              ctx
                              (tc-context-expr-bases ctx)
                              env
                              (tc-global-shared-view effective-arg)
                              (tc-global-shared-view got)
                              (match (& constructor-target)
                                [(Some _)
                                  "construct with an owned clone of it, or make the field a reference"]
                                [(No)
                                  "pass an owned clone, or make the parameter a reference and pass `(& ...)`"]))]
                          (if (> (string.string-length moved) 0)
                            moved
                            (tc-region-call-arg-error
                              (tc-context-expr-bases ctx)
                              effective-arg))))
                      (match (tc-global-shared-view constructor-target)
                        [(Some target)
                          (let
                            [_
                              (try
                                (tc-ensure-cleanup-resource-not-stored-expr
                                  ctx
                                  env
                                  effective-arg))]
                            (let
                              [_
                                (try
                                  (tc-ensure-region-value-can-flow-into
                                    env
                                    target
                                    got
                                    "constructor result"))]
                              (tc-check-call-args-with-message-at
                                ctx
                                env
                                args
                                params
                                (+ index 1)
                                allow-region-args
                                constructor-target
                                arity-msg
                                thread-spawn-args)))]
                        [(No)
                          (tc-check-call-args-with-message-at
                            ctx
                            env
                            args
                            params
                            (+ index 1)
                            allow-region-args
                            constructor-target
                            arity-msg
                            thread-spawn-args)])))]
                ;; A `(type X)` argument types as an error. It fills a
                ;; `[comptime T : type]` parameter, and reaches here only before
                ;; specialization removes it from the call.
                [(Err message)
                  (if (and
                    (tc-macro-type-param-kind? (tc-global-shared-view want))
                    (match (ast.ast-expr-unspan-with-segment-bases
                      (tc-context-expr-bases ctx)
                      (& arg))
                      [(TypeLiteral _) true]
                      [_ false]))
                    (tc-check-call-args-with-message-at
                      ctx
                      env
                      args
                      params
                      (+ index 1)
                      allow-region-args
                      constructor-target
                      arity-msg
                      thread-spawn-args)
                    (Err message))]))]
          [(Err message)
            (Err
              (tc-locate-error-at-expr (tc-context-expr-bases ctx) arg message))])))))

(define (tc-check-call-args
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [allow-region-args : bool]
  [constructor-target : ast.AstMaybeType]) : ResultTcUnit
  (tc-check-call-args-with-message
    ctx
    env
    (tc-global-shared-view args)
    (tc-global-shared-view params)
    allow-region-args
    constructor-target
    (Detailed func args params)))

(defenum TcDirectLambdaCheck
  (No)
  (Ok ast.AstType)
  (Err String))

(define (tc-direct-lambda-check
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]) : TcDirectLambdaCheck
  (match expr
    [(or (Spanned inner-box _) (MacroExpansion inner-box _ _))
      (tc-direct-lambda-check ctx env (tc-context-expr-get ctx inner-box))]
    [(Lambda lambda-box)
      (match (ast.ast-lambda-box-shared-view lambda-box)
        [(Lambda params maybe-ret body-box)
          (match (tc-lambda-expr-allow-ref-captures
            ctx
            env
            params
            maybe-ret
            (tc-context-expr-get ctx body-box))
            [(Ok fn-ty) (Ok fn-ty)]
            [(Err message) (Err message)])])]
    [_ (No)]))

;; Unsafe declarations deliberately keep the ordinary function type at the ABI
;; boundary, but that type must never escape into a first-class value. Ordinary
;; expression typing therefore runs first, preserving dotted-name normalization,
;; diagnostics, facts, and every safe-call path. Only its specific unsafe-value
;; rejection may be retried as a syntactically direct call target.
(define (tc-unsafe-callable-value-error? [message : (& message str)]) : bool
  (string.contains
    message
    " is an unsafe callable and cannot be used as a plain function value"))

(define (tc-call-target-direct-name
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [fallback-message : String]) : ResultTcType
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-segment-bases ctx)
    (& func))
    [(Var name)
      (if (and
        (or
          (tc-env-key-has-name-id? name)
          (macro-hygiene-global-id? (tc-context-structural-session ctx) name))
        (not (tc-dotted-place-name-id? ctx env name)))
        (tc-opaque-value-reference-ok
          ctx
          name
          (tc-var-expr-after-local-field-check-mode
            ctx
            env
            name
            (tc-hygiene-name-text-id-for-session
              (tc-context-structural-session ctx)
              name)
            true))
        (Err fallback-message))]
    [_ (Err fallback-message)]))

(define (tc-call-target-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]) : ResultTcType
  (match (tc-expr ctx env (tc-global-shared-view func))
    [(Ok ty) (Ok ty)]
    [(Err message)
      (if (tc-unsafe-callable-value-error? message)
        (tc-call-target-direct-name ctx env func message)
        (Err message))]))

(define (tc-call-target-expr-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]) : ResultTcType
  (let
    [func : ast.AstExpr (tc-context-expr-get ctx func-id)]
    (match (tc-expr-id ctx env func-id)
      [(Ok ty) (Ok ty)]
      [(Err message)
        (if (tc-unsafe-callable-value-error? message)
          (let
            [result : ResultTcType
              (tc-call-target-direct-name ctx env func message)]
            (match (tc-global-shared-view result)
              [(Ok ty)
                (tc-body-type-fact-record!
                  (tc-context-body-state ctx)
                  func-id
                  ty)]
              [(Err _) unit])
            result)
          (Err message))])))

(define (tc-call-c-function-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [signature : i64]
  [mode : ast.AstCFunctionMode]) : ResultTcType
  (if (ast.ast-c-function-mode-nullable? mode)
    (Err
      (tc-locate-error-at-expr
        (tc-context-expr-bases ctx)
        func
        "typecheck: nullable C function pointer must be checked before calling"))
    (let
      [_
        (try
          (if (ast.ast-c-function-mode-unsafe? mode)
            (tc-require-unsafe ctx env "C function pointer")
            ResultTcUnit.Ok))]
      (let
        [signature-type : ast.AstType (ast.ty-node-get signature)]
        [_
          (try
            (tc-check-extern-c-abi ctx (tc-global-shared-view signature-type)))]
        (match signature-type
          [(Func params result)
            (tc-call-function-type-normal
              ctx
              env
              func
              args
              (ast.ast-type-list-box-shared-view params)
              (ast.ty-node-get result))]
          [_ (Err "typecheck: invalid C function signature")])))))

;; The `(type X)` arguments a call passes to `[comptime T : type]` parameters,
;; keyed by parameter name.
(defstruct TcComptimeTypeArgs
  (names (__tl_dyn-array i64))
  (types (__tl_dyn-array ast.AstType))
  (len i64))

(define (tc-comptime-type-args-empty) : TcComptimeTypeArgs
  (TcComptimeTypeArgs (__tl_make-array i64 0) (__tl_make-array ast.AstType 0) 0))

;; A call to a function with `[comptime T : type]` parameters is typed against
;; the signature its specialization gets: each such `T` replaced by the call's
;; `(type X)` argument. Specialization rewrites these calls only after macro
;; expansion, so the expansion-time checks of macro operands and results see
;; the unspecialized call.
(define (tc-call-comptime-type-args
  [ctx : TcContext]
  [func : ast.AstExpr]
  [args : (& args ast.AstExprList)]) : TcComptimeTypeArgs
  (let
    [handle : i64 (tc-call-direct-value-handle ctx func)]
    (if (csym.compiler-symbols-handle-found? handle)
      (match (csym.compiler-symbols-decl-at-index
        (tc-context-symbols ctx)
        (csym.compiler-symbol-handle-index handle))
        [(Ok decl) (tc-decl-comptime-type-args ctx decl args)]
        [(Err _) (tc-comptime-type-args-empty)])
      (tc-comptime-type-args-empty))))

;; Until a comptime parameter exists no call can need substitution, so an
;; ordinary call pays one counter test (see `ast-comptime-param-count`).
(defmacro (tc-comptime-params-present?) : Expr
  `(not (= ast.ast-comptime-param-count 0)))

(define (tc-call-comptime-function-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [ret : ast.AstType]) : ResultTcType
  (let
    [comptime-args : TcComptimeTypeArgs
      (tc-call-comptime-type-args ctx (tc-global-shared-view func) (& args))]
    (if (= comptime-args.len 0)
      (tc-call-function-type ctx env func args params ret)
      (tc-call-function-type
        ctx
        env
        func
        args
        (tc-type-list-subst-comptime (& comptime-args) params)
        (tc-type-subst-comptime (& comptime-args) ret)))))

(define (tc-call-has-type-literal-arg?
  [ctx : TcContext]
  [args : (& args ast.AstExprList)]) : bool
  (let
    [index : i64 0]
    [found : bool false]
    (while (and (not found) (< index args.len))
      (match (ast.ast-expr-unspan-with-segment-bases
        (tc-context-expr-bases ctx)
        (& (tc-context-expr-get ctx (ast.ast-expr-list-get args index 0))))
        [(TypeLiteral _) (set! found true)]
        [_ unit])
      (set! index (+ index 1)))
    found))

(define (tc-decl-comptime-type-args
  [ctx : TcContext]
  [decl : ast.AstDecl]
  [args : (& args ast.AstExprList)]) : TcComptimeTypeArgs
  (match decl
    [(DefFn _ _ params _ _ _) (tc-param-comptime-type-args ctx (& params) args)]
    [(Unsafe inner-box)
      (tc-decl-comptime-type-args
        ctx
        (ast.ast-decl-box-shared-view inner-box)
        args)]
    [_ (tc-comptime-type-args-empty)]))

(define (tc-param-comptime-type-args
  [ctx : TcContext]
  [params : (& params ast.AstParamList)]
  [args : (& args ast.AstExprList)]) : TcComptimeTypeArgs
  (let
    [count : i64 (ast.ast-param-list-len params)]
    [names : (__tl_dyn-array i64) (__tl_make-array i64 count)]
    [types : (__tl_dyn-array ast.AstType) (__tl_make-array ast.AstType count)]
    [len : i64 0]
    [index : i64 0]
    (while (and (< index count) (< index args.len))
      (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
        [(Param name ty comptime?)
          (when
            (and comptime? (tc-macro-type-param-kind? ty))
            (match (ast.ast-expr-unspan-with-segment-bases
              (tc-context-expr-bases ctx)
              (& (tc-context-expr-get ctx (ast.ast-expr-list-get args index 0))))
              [(TypeLiteral ty-id)
                (set! (array-ref names len) name)
                (set!
                  (array-ref types len)
                  (tc-resolve-type ctx (tc-context-type-get ctx ty-id)))
                (set! len (+ len 1))]
              [_ unit]))])
      (set! index (+ index 1)))
    (TcComptimeTypeArgs names types len)))

(define (tc-type-subst-comptime
  [subst : (& subst TcComptimeTypeArgs)]
  [ty : ast.AstType]) : ast.AstType
  (match (tc-global-shared-view ty)
    [(Func params ret)
      (ast.ast-ty-func
        (tc-type-list-subst-comptime
          subst
          (ast.ast-type-list-box-shared-view params))
        (& (tc-type-subst-comptime subst (ast.ty-node-get ret))))]
    [(Tuple elems)
      (ast.ast-ty-tuple
        (tc-type-list-subst-comptime
          subst
          (ast.ast-type-list-box-shared-view elems)))]
    [(Array elem len)
      (ast.ast-ty-array
        (& (tc-type-subst-comptime subst (ast.ty-node-get elem)))
        len)]
    [(DynArray elem)
      (ast.ast-ty-dyn-array
        (& (tc-type-subst-comptime subst (ast.ty-node-get elem))))]
    [(Slice elem)
      (ast.ast-ty-slice
        (& (tc-type-subst-comptime subst (ast.ty-node-get elem))))]
    [(Box elem)
      (ast.ast-ty-box (& (tc-type-subst-comptime subst (ast.ty-node-get elem))))]
    [(Ptr elem)
      (ast.ast-ty-ptr (& (tc-type-subst-comptime subst (ast.ty-node-get elem))))]
    [(MutPtr elem)
      (ast.ast-ty-mut-ptr
        (& (tc-type-subst-comptime subst (ast.ty-node-get elem))))]
    [(Ref region inner)
      (ast.ast-ty-ref
        region
        (& (tc-type-subst-comptime subst (ast.ty-node-get inner))))]
    [(MutRef region inner)
      (ast.ast-ty-mut-ref
        region
        (& (tc-type-subst-comptime subst (ast.ty-node-get inner))))]
    [(Region region inner)
      (ast.ast-ty-region
        region
        (& (tc-type-subst-comptime subst (ast.ty-node-get inner))))]
    [(Invalidate lifetime inner)
      (ast.ast-ty-invalidate
        lifetime
        (& (tc-type-subst-comptime subst (ast.ty-node-get inner))))]
    [(Var name)
      (let
        [index : i64 0]
        [found : i64 -1]
        (while (and (< found 0) (< index subst.len))
          (when (= (array-ref subst.names index) name) (set! found index))
          (set! index (+ index 1)))
        (if (< found 0)
          ty
          (owned_view.compiler-owned-array-element-shared-view
            subst.types
            found)))]
    [_ ty]))

(define (tc-type-list-subst-comptime
  [subst : (& subst TcComptimeTypeArgs)]
  [types : ast.AstTypeList]) : ast.AstTypeList
  (tc-type-list-subst-comptime-at subst (& types) 0))

(define (tc-type-list-subst-comptime-at
  [subst : (& subst TcComptimeTypeArgs)]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ast.AstTypeList
  (if (>= index (ast.ast-type-list-len types))
    (ast.ast-type-list-new)
    (ast.ast-type-cons
      (&
        (tc-type-subst-comptime
          subst
          (ast.ty-node-get
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))))
      (& (tc-type-list-subst-comptime-at subst types (+ index 1))))))

(define (tc-call-expr-ordinary
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcType
  (let
    [direct : TcDirectLambdaCheck
      (tc-direct-lambda-check ctx env (tc-global-shared-view func))]
    (match direct
      [(Ok fn-ty)
        (match fn-ty
          [(Func params ret)
            (tc-call-function-type
              ctx
              env
              func
              args
              (ast.ast-type-list-box-shared-view params)
              (ast.ty-node-get ret))]
          [_ (Err "typecheck: call target is not a function")])]
      [(Err message) (Err message)]
      [(No)
        (let
          [fn-ty
            (try (tc-call-target-expr ctx env (tc-global-shared-view func)))]
          (match (tc-global-shared-view fn-ty)
            [(CFunc signature mode)
              (tc-call-c-function-type ctx env func args signature mode)]
            [(Func params ret)
              (if (and
                (tc-comptime-params-present?)
                (tc-call-has-type-literal-arg? ctx (& args)))
                (tc-call-comptime-function-type
                  ctx
                  env
                  func
                  args
                  (ast.ast-type-list-box-shared-view params)
                  (ast.ty-node-get ret))
                (tc-call-function-type
                  ctx
                  env
                  func
                  args
                  (ast.ast-type-list-box-shared-view params)
                  (ast.ty-node-get ret)))]
            [(Region _ inner)
              (match (ast.ty-node-get inner)
                [(CFunc signature mode)
                  (tc-call-c-function-type ctx env func args signature mode)]
                [(Func params ret)
                  (let
                    [_
                      (try
                        (tc-check-call-args-with-message
                          ctx
                          env
                          (tc-global-shared-view args)
                          (ast.ast-type-list-box-shared-view
                            (tc-global-shared-view params))
                          false
                          (No)
                          (Detailed
                            func
                            args
                            (ast.ast-type-list-box-shared-view params))))]
                    (Ok (tc-tag-active-region env (ast.ty-node-get ret))))]
                [(or (Enum enum-name) (EnumArgs enum-name _))
                  (if (ast.ast-expr-list-empty? (& args))
                    (tc-nullary-variant-call-expr
                      ctx
                      env
                      func
                      enum-name
                      (ast.ty-node-get inner))
                    (Err
                      (tc-call-fixed-arity-message
                        (tc-context-expr-segment-bases ctx)
                        func
                        args
                        0)))]
                [_ (Err "typecheck: call target is not a function")])]
            [(or (Enum enum-name) (EnumArgs enum-name _))
              (if (ast.ast-expr-list-empty? (& args))
                (tc-nullary-variant-call-expr ctx env func enum-name fn-ty)
                (Err
                  (tc-call-fixed-arity-message
                    (tc-context-expr-segment-bases ctx)
                    func
                    args
                    0)))]
            [_ (Err "typecheck: call target is not a function")]))])))

(define (tc-phase-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 1)
    (let
      [owner-expr : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [owner-ty (try (tc-expr ctx env (tc-global-shared-view owner-expr)))]
      (if (tc-arena-type? ctx owner-ty)
        (let
          [oid : i64
            (tc-expr-var-name-id
              (tc-context-expr-segment-bases ctx)
              (tc-global-shared-view owner-expr))]
          (if (>= oid 0)
            (if (or
              (tc-ordinary-arena-owner-active-id? env oid)
              (tc-atomic-arena-owner-active-id? env oid))
              (match (tc-expr ctx env func)
                [(Ok (Func _ ret)) (Ok (ast.ty-node-get ret))]
                [(Ok _) (Err "typecheck: arena.phase target is not a function")]
                [(Err message) (Err message)])
              (Err
                (tc-locate-error-at-expr
                  (tc-context-expr-bases ctx)
                  owner-expr
                  (tc-kind-message
                    (ArenaOwnership)
                    "typecheck: arena.phase requires a direct arena owner"))))
            (Err
              (tc-locate-error-at-expr
                (tc-context-expr-bases ctx)
                owner-expr
                (tc-kind-message
                  (ArenaOwnership)
                  "typecheck: arena.phase requires a direct arena owner")))))
        (Err
          (tc-locate-error-at-expr
            (tc-context-expr-bases ctx)
            owner-expr
            (tc-kind-message
              (ArenaOwnership)
              "typecheck: arena.phase arena must be Arena")))))
    (Err
      (tc-kind-message
        (ArityMismatch)
        "typecheck: arena.phase expects exactly one argument"))))

(define (tc-rewind-safe-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 1)
    (let
      [phase-expr : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [phase-ty (try (tc-expr ctx env (tc-global-shared-view phase-expr)))]
      (if (tc-arena-phase-type? ctx phase-ty)
        (let
          [pid : i64
            (tc-expr-var-name-id
              (tc-context-expr-segment-bases ctx)
              (tc-global-shared-view phase-expr))]
          (if (>= pid 0)
            (match (tc-arena-phase-token-region-active env pid)
              [(Some _)
                (match (tc-arena-phase-token-owner-active env pid)
                  [(Some owner)
                    (if (tc-active-region-owned-by-arena-id? env owner)
                      (Err
                        (tc-locate-error-at-expr
                          (tc-context-expr-bases ctx)
                          phase-expr
                          (tc-kind-message
                            (ArenaOwnership)
                            "typecheck: arena.rewind-safe! cannot run inside the arena it rewinds")))
                      (Ok (Unit)))]
                  [(No) (Ok (Unit))])]
              [(No)
                (Err
                  (tc-locate-error-at-expr
                    (tc-context-expr-bases ctx)
                    phase-expr
                    "typecheck: arena.rewind-safe! requires a direct arena phase token"))])
            (Err
              (tc-locate-error-at-expr
                (tc-context-expr-bases ctx)
                phase-expr
                "typecheck: arena.rewind-safe! requires a direct arena phase token"))))
        (Err
          (tc-locate-error-at-expr
            (tc-context-expr-bases ctx)
            phase-expr
            "typecheck: arena.rewind-safe! phase must be ArenaPhase"))))
    (Err
      (tc-kind-message
        (ArityMismatch)
        "typecheck: arena.rewind-safe! expects exactly one argument"))))

;; A brand a safe destroy or an `:invalidate` call may end: a local arena's
;; generated brand, or a lifetime the enclosing body's parameters invalidate.
(define (tc-invalidate-brand-destroyable? [env : TcTypeEnv] [brand : i64]) : bool
  (or
    (tc-generated-ordinary-arena-brand-id? brand)
    (tc-generated-atomic-arena-brand-id? brand)
    (tc-invalidate-lifetime-declared? env brand)))

;; Safe destroy has two identities to preserve. The normalized expression is
;; the exact place consumed by the move checker, while a branded Arena's
;; lifetime is the stable owner identity used for region and atomic-user
;; invalidation. Legacy bare owners retain the direct-local name-marker path.
(define (tc-destroy-safe-owner-place-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [owner-expr : ast.AstExpr]
  [owner-ty : ast.AstType]) : TcMaybeNameId
  (match (tc-move-direct-root-base-path (tc-context-expr-bases ctx) owner-expr)
    [(Some place)
      (match (tc-arena-branded-region ctx owner-ty)
        [(Some brand)
          (if (tc-invalidate-brand-destroyable? env brand)
            (Some brand)
            (No))]
        [(No)
          (if (and
            (= place.segments.len 0)
            (or
              (tc-ordinary-arena-owner-active-id? env place.root)
              (tc-atomic-arena-owner-active-id? env place.root)))
            (Some place.root)
            (No))])]
    [(No) (No)]))

(define (tc-destroy-safe-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : ast.AstExprList]) : ResultTcType
  (unless
    (= args.len 1)
    (return
      (Err
        (tc-kind-message
          (ArityMismatch)
          "typecheck: arena.destroy-safe! expects exactly one argument"))))
  (let
    [owner-expr : ast.AstExpr
      (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
    [owner-ty (try (tc-expr ctx env (tc-global-shared-view owner-expr)))]
    (unless
      (tc-arena-type? ctx (tc-global-shared-view owner-ty))
      (return
        (Err
          (tc-locate-error-at-expr
            (tc-context-expr-bases ctx)
            owner-expr
            (tc-kind-message
              (ArenaOwnership)
              "typecheck: arena.destroy-safe! arena must be Arena")))))
    (let
      [owner-id : TcMaybeNameId
        (tc-destroy-safe-owner-place-id
          ctx
          env
          (tc-global-shared-view owner-expr)
          owner-ty)]
      (match owner-id
        [(Some oid)
          (if (tc-active-region-owned-by-arena-id? env oid)
            (Err
              (tc-locate-error-at-expr
                (tc-context-expr-bases ctx)
                owner-expr
                (tc-kind-message
                  (ArenaOwnership)
                  "typecheck: arena.destroy-safe! cannot run inside the arena it destroys")))
            (Ok (Unit)))]
        [(No)
          (Err
            (tc-locate-error-at-expr
              (tc-context-expr-bases ctx)
              owner-expr
              (tc-kind-message
                (ArenaOwnership)
                "typecheck: arena.destroy-safe! requires a direct arena owner or branded local owner place")))]))))

(define (tc-call-expr-ordinary-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]
  [args : ast.AstExprList]) : ResultTcType
  (let
    [func : ast.AstExpr (tc-context-expr-get ctx func-id)]
    [direct : TcDirectLambdaCheck
      (tc-direct-lambda-check ctx env (tc-global-shared-view func))]
    (match direct
      [(Ok fn-ty)
        (tc-body-type-fact-record!
          (tc-context-body-state ctx)
          func-id
          (tc-global-shared-view fn-ty))
        (match fn-ty
          [(Func params ret)
            (tc-call-function-type
              ctx
              env
              func
              args
              (ast.ast-type-list-box-shared-view params)
              (ast.ty-node-get ret))]
          [_ (Err "typecheck: call target is not a function")])]
      [(Err message) (Err message)]
      [(No)
        (let
          [fn-ty (try (tc-call-target-expr-id ctx env func-id))]
          (match (tc-global-shared-view fn-ty)
            [(CFunc signature mode)
              (tc-call-c-function-type ctx env func args signature mode)]
            [(Func params ret)
              (if (and
                (tc-comptime-params-present?)
                (tc-call-has-type-literal-arg? ctx (& args)))
                (tc-call-comptime-function-type
                  ctx
                  env
                  func
                  args
                  (ast.ast-type-list-box-shared-view params)
                  (ast.ty-node-get ret))
                (tc-call-function-type
                  ctx
                  env
                  func
                  args
                  (ast.ast-type-list-box-shared-view params)
                  (ast.ty-node-get ret)))]
            [(Region _ inner)
              (match (ast.ty-node-get inner)
                [(CFunc signature mode)
                  (tc-call-c-function-type ctx env func args signature mode)]
                [(Func params ret)
                  (let
                    [_
                      (try
                        (tc-check-call-args-with-message
                          ctx
                          env
                          (tc-global-shared-view args)
                          (ast.ast-type-list-box-shared-view
                            (tc-global-shared-view params))
                          false
                          (No)
                          (Detailed
                            func
                            args
                            (ast.ast-type-list-box-shared-view params))))]
                    (Ok (tc-tag-active-region env (ast.ty-node-get ret))))]
                [(or (Enum enum-name) (EnumArgs enum-name _))
                  (if (ast.ast-expr-list-empty? (& args))
                    (tc-nullary-variant-call-expr
                      ctx
                      env
                      func
                      enum-name
                      (ast.ty-node-get inner))
                    (Err
                      (tc-call-fixed-arity-message
                        (tc-context-expr-segment-bases ctx)
                        func
                        args
                        0)))]
                [_ (Err "typecheck: call target is not a function")])]
            [(or (Enum enum-name) (EnumArgs enum-name _))
              (if (ast.ast-expr-list-empty? (& args))
                (tc-nullary-variant-call-expr ctx env func enum-name fn-ty)
                (Err
                  (tc-call-fixed-arity-message
                    (tc-context-expr-segment-bases ctx)
                    func
                    args
                    0)))]
            [_ (Err "typecheck: call target is not a function")]))])))

(define (tc-arena-owner-call-type-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]
  [args : ast.AstExprList]
  [kind : i64]) : ResultTcType
  ;; Preserve ordinary lookup, arity, and shadowing diagnostics. Only a call
  ;; that really resolves to the canonical zero-argument constructor gets its
  ;; otherwise-bare result refined with the call-site brand.
  (let
    [ty (try (tc-call-expr-ordinary-id ctx env func-id args))]
    (if (tc-arena-type? ctx (tc-global-shared-view ty))
      (Ok (tc-arena-branded-type kind func-id))
      (Ok ty))))

(define (tc-str-ref-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(Ref _ inner)
      (match (tc-type-strip-region (ast.ty-node-get inner))
        [(Str) true]
        [_ false])]
    [_ false]))

(define (tc-string-handle-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-global-shared-view ty))
    [(String) true]
    [_ (tc-str-ref-type? ty)]))

(define (tc-bytes-ref-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(or (Ref _ inner) (MutRef _ inner))
      (match (tc-type-strip-region (ast.ty-node-get inner))
        [(Bytes) true]
        [_ false])]
    [_ false]))

(define (tc-bytes-handle-type? [ty : ast.AstType]) : bool
  (tc-bytes-ref-type? ty))

(define (tc-length-handle-type? [ty : ast.AstType]) : bool
  (or
    (tc-string-handle-type? (tc-global-shared-view ty))
    (tc-bytes-handle-type? ty)))

(define (tc-check-string-handle-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [index : i64]
  [arg : ast.AstExpr]) : ResultTcUnit
  (let
    [arg-ty (try (tc-expr ctx env (tc-global-shared-view arg)))]
    (if (tc-string-handle-type? (tc-global-shared-view arg-ty))
      Ok
      (Err
        (tc-locate-error-at-expr
          (tc-context-expr-bases ctx)
          arg
          (tc-call-argument-expected-text-message
            ctx
            func
            index
            arg-ty
            "String or (& str)"))))))

(define (tc-check-length-handle-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [index : i64]
  [arg : ast.AstExpr]) : ResultTcUnit
  (let
    [arg-ty (try (tc-expr ctx env (tc-global-shared-view arg)))]
    (if (tc-length-handle-type? (tc-global-shared-view arg-ty))
      Ok
      (Err
        (tc-locate-error-at-expr
          (tc-context-expr-bases ctx)
          arg
          (tc-call-argument-expected-text-message
            ctx
            func
            index
            arg-ty
            "String, (& str), (& bytes), or (&mut bytes)"))))))

(define (tc-check-exact-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : ast.AstExpr]
  [want : ast.AstType]
  [message : String]) : ResultTcUnit
  (let
    [arg-ty
      (try
        (tc-expr-with-expected-or-actual
          ctx
          env
          (tc-global-shared-view arg)
          (tc-global-shared-view want)))]
    (tc-expect-at-expr ctx arg arg-ty want message)))

(define (tc-one-string-handle-builtin-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [ret : ast.AstType]) : ResultTcType
  (if (= args.len 1)
    (let
      [arg : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [_ (try (tc-check-string-handle-arg ctx env func 0 arg))]
      (Ok (tc-tag-active-region env ret)))
    (Err
      (tc-call-fixed-arity-message
        (tc-context-expr-segment-bases ctx)
        func
        args
        1))))

(define (tc-one-length-handle-builtin-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [ret : ast.AstType]) : ResultTcType
  (if (= args.len 1)
    (let
      [arg : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [_ (try (tc-check-length-handle-arg ctx env func 0 arg))]
      (Ok (tc-tag-active-region env ret)))
    (Err
      (tc-call-fixed-arity-message
        (tc-context-expr-segment-bases ctx)
        func
        args
        1))))

(define (tc-two-string-handle-builtin-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [ret : ast.AstType]) : ResultTcType
  (if (= args.len 2)
    (let
      [left : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [right : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 1 0))]
      [_
        (try
          (tc-check-string-handle-arg
            ctx
            env
            (tc-global-shared-view func)
            0
            left))]
      (let
        [_ (try (tc-check-string-handle-arg ctx env func 1 right))]
        (Ok (tc-tag-active-region env ret))))
    (Err
      (tc-call-fixed-arity-message
        (tc-context-expr-segment-bases ctx)
        func
        args
        2))))

(define (tc-string-length-helper-call-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-id : i64]
  [lookup-id : i64]) : bool
  (or
    (and
      (cbi.compiler-builtin-typecheck-string-length-id? lookup-id)
      (tc-private-intrinsic-unshadowed-id?
        ctx
        env
        (tc-env-name-key-id (tc-type-env-structural-session env) lookup-id)))
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      source-id
      (cbi.compiler-builtin-typecheck-public-string-length-id? source-id)
      lookup-id
      cbi.compiler-builtin-id-string-length
      "string-length")))

(define (tc-string-ref-helper-call-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-id : i64]
  [lookup-id : i64]) : bool
  (or
    (and
      (cbi.compiler-builtin-typecheck-string-ref-call-id? lookup-id)
      (tc-private-intrinsic-unshadowed-id?
        ctx
        env
        (tc-env-name-key-id (tc-type-env-structural-session env) lookup-id)))
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      source-id
      (and
        (cbi.compiler-builtin-typecheck-public-string-ref-id? source-id)
        (not (cbi.compiler-builtin-typecheck-public-char-at-id? source-id)))
      lookup-id
      cbi.compiler-builtin-id-string-ref
      "string-ref")
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      source-id
      (cbi.compiler-builtin-typecheck-public-char-at-id? source-id)
      lookup-id
      cbi.compiler-builtin-id-char-at
      "char-at")))

(define (tc-string-eq-helper-call-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-id : i64]
  [lookup-id : i64]) : bool
  (or
    (and
      (cbi.compiler-builtin-typecheck-string-eq-id? lookup-id)
      (tc-private-intrinsic-unshadowed-id? ctx env lookup-id))
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      source-id
      (= source-id cbi.compiler-builtin-id-eq)
      lookup-id
      cbi.compiler-builtin-id-eq
      "eq")
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      source-id
      (and
        (cbi.compiler-builtin-typecheck-public-string-eq-id? source-id)
        (not
          (cbi.compiler-builtin-typecheck-public-string-eq-question-id?
            source-id)))
      lookup-id
      cbi.compiler-builtin-id-string-eq
      "string-eq")
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      source-id
      (cbi.compiler-builtin-typecheck-public-string-eq-question-id? source-id)
      lookup-id
      cbi.compiler-builtin-id-string-eq-question
      "string=?")))

(define (tc-string-copy-helper-call-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-id : i64]
  [lookup-id : i64]) : bool
  (or
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      source-id
      (= source-id cbi.compiler-builtin-id-string-append)
      lookup-id
      cbi.compiler-builtin-id-string-append
      "string-append")
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      source-id
      (= source-id cbi.compiler-builtin-id-string-concat)
      lookup-id
      cbi.compiler-builtin-id-string-concat
      "string-concat")))

(define (tc-string-to-int-helper-call-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [lookup-id : i64]) : bool
  (and
    (cbi.compiler-builtin-typecheck-string-to-int-id? lookup-id)
    (tc-private-intrinsic-unshadowed-id? ctx env lookup-id)))

(define (tc-borrowed-string-builtin-id? [name-id : i64]) : bool
  (cbi.compiler-builtin-typecheck-borrowed-string-id? name-id))

(define (tc-borrowed-string-builtin-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [name-id : i64]
  [args : ast.AstExprList]) : ResultTcType
  (if (cbi.compiler-builtin-typecheck-string-eq-id? name-id)
    (tc-two-string-handle-builtin-call ctx env func args (Bool))
    (if (cbi.compiler-builtin-typecheck-string-to-int-id? name-id)
      (tc-one-string-handle-builtin-call ctx env func args (I64))
      (Err "typecheck: unknown borrowed string builtin"))))

;; Typecheck the private `(__tl_string_ref s i)` intrinsic: a String plus any
;; integer index, yielding `char`. Public `string-ref` and `char-at` live in
;; stdlib/string.tl and lower through this private operation.
(define (tc-string-ref-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 2)
    (let
      [str : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [index : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 1 0))]
      [str-ty (try (tc-expr ctx env (tc-global-shared-view str)))]
      (if (tc-string-handle-type? (tc-global-shared-view str-ty))
        (let
          [index-ty (try (tc-expr ctx env (tc-global-shared-view index)))]
          (if (tc-integer-type? (tc-global-shared-view index-ty))
            (Ok (Char))
            (Err
              (tc-locate-error-at-expr
                (tc-context-expr-bases ctx)
                index
                (tc-call-argument-expected-text-message
                  ctx
                  func
                  1
                  index-ty
                  "integer")))))
        (Err
          (tc-locate-error-at-expr
            (tc-context-expr-bases ctx)
            str
            (tc-call-argument-expected-text-message
              ctx
              func
              0
              str-ty
              "String or (& str)")))))
    (Err
      (tc-call-fixed-arity-message
        (tc-context-expr-segment-bases ctx)
        func
        args
        2))))

(define (tc-length-string-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [arg-ty : ast.AstType]) : ResultTcType
  (let
    [public-helper : bool
      (tc-string-length-helper-call-id? ctx env name-id name-id)]
    [private-helper : bool
      (cbi.compiler-builtin-typecheck-string-length-id? name-id)]
    [unshadowed : bool (tc-default-builtin-unshadowed-id? env name-id)]
    (when
      (and
        (or public-helper unshadowed)
        (tc-length-handle-type? (tc-global-shared-view arg-ty)))
      (return (Ok (I64))))
    (unless private-helper (return (tc-call-expr-ordinary ctx env func args)))
    (unless
      (or public-helper unshadowed)
      (return (tc-call-expr-ordinary ctx env func args)))
    (if (tc-length-handle-type? (tc-global-shared-view arg-ty))
      (Ok (I64))
      (let
        [arg : ast.AstExpr
          (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
        (Err
          (tc-locate-error-at-expr
            (tc-context-expr-bases ctx)
            arg
            (tc-call-argument-expected-text-message
              ctx
              func
              0
              arg-ty
              "String, (& str), (& bytes), or (&mut bytes)")))))))

(define (tc-array-length-non-array-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [arg-ty : ast.AstType]) : ResultTcType
  (if (cbi.compiler-builtin-typecheck-array-length-id? name-id)
    (if (and
      (tc-type-eq (tc-type-strip-region arg-ty) (Expr))
      (tc-source-value-bound-id? ctx env name-id))
      (Ok (I64))
      (Err
        "typecheck: array-length requires fixed array, private dynamic array, or borrowed Slice"))
    (tc-length-string-call ctx env name-id func args arg-ty)))

(define (tc-array-length-array-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [arg-ty : ast.AstType]) : ResultTcType
  (if (cbi.compiler-builtin-typecheck-string-length-id? name-id)
    (if (tc-default-builtin-unshadowed-id? env name-id)
      (let
        [arg : ast.AstExpr
          (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
        (Err
          (tc-locate-error-at-expr
            (tc-context-expr-bases ctx)
            arg
            (tc-call-argument-expected-text-message
              ctx
              func
              0
              arg-ty
              "String or (& str)"))))
      (tc-call-expr-ordinary ctx env func args))
    (Ok (I64))))

(define (tc-array-length-receiver [ctx : TcContext] [receiver-ty : ast.AstType]) : ResultTcArrayReceiver
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-global-shared-view receiver-ty)))
    [(or (Array elem-ty _) (DynArray elem-ty))
      (Ok (TcArrayReceiver receiver-ty (ast.ty-node-get elem-ty)))]
    [(or (Ref _ referent-ty) (MutRef _ referent-ty))
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-context-type-get ctx referent-ty)))
        [(Slice elem-ty)
          (Ok (TcArrayReceiver receiver-ty (ast.ty-node-get elem-ty)))]
        [_ (tc-array-length-receiver ctx (ast.ty-node-get referent-ty))])]
    [_
      (Err
        "typecheck: array-length requires fixed array, private dynamic array, or borrowed Slice")]))

;; Core `length` / `array-length` accept fixed arrays and supported references;
;; compiler-private dynamic arrays and borrowed Slice receivers retain their
;; intrinsic path. The stdlib `string-length` wrapper uses the private
;; `__tl_string_length` intrinsic.
(define (tc-array-length-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 1)
    (let
      [arg : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [arg-ty : ast.AstType (try (tc-expr ctx env arg))]
      (match (tc-array-length-receiver ctx (tc-global-shared-view arg-ty))
        [(Ok _) (tc-array-length-array-call ctx env name-id func args arg-ty)]
        [(Err _)
          (tc-array-length-non-array-call ctx env name-id func args arg-ty)]))
    (if (cbi.compiler-builtin-typecheck-array-length-id? name-id)
      (Err
        (tc-call-fixed-arity-message
          (tc-context-expr-segment-bases ctx)
          func
          args
          1))
      (tc-call-expr-ordinary ctx env func args))))

(define (tc-layout-query-name? [name : String]) : bool
  (if (string.eq name "size-of")
    true
    (if (string.eq name "align-of")
      true
      (string.eq name "offset-of"))))

;; Layout queries are CTFE-only. Inside `(comptime ...)` the typechecker gets the
;; folded value from `compiler-ctfe-eval`; if an unshadowed query reaches normal
;; expression typing, it is a runtime use and must be rejected.
(define (tc-one-arg-layout-query-runtime-call
  [name : String]
  [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 1)
    (Err
      (str_cat.str-cat
        (cdiag.compiler-diagnostic-typecheck-tag (ComptimeConstraint))
        "typecheck: "
        name
        " is compile-time only; wrap it in (comptime ...)"))
    (Err
      (str_cat.str-cat
        (cdiag.compiler-diagnostic-typecheck-tag (ArityMismatch))
        "typecheck: "
        name
        " expects exactly one type argument"))))

(define (tc-offset-layout-query-runtime-call [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 2)
    (Err
      (tc-kind-message
        (ComptimeConstraint)
        "typecheck: offset-of is compile-time only; wrap it in (comptime ...)"))
    (Err
      (tc-kind-message
        (ArityMismatch)
        "typecheck: offset-of expects exactly one type argument and one field name"))))

(define (tc-layout-query-runtime-call [name : String] [args : ast.AstExprList]) : ResultTcType
  (if (string.eq name "offset-of")
    (tc-offset-layout-query-runtime-call args)
    (tc-one-arg-layout-query-runtime-call name args)))

(define (tc-reflection-query-runtime-call [name : String]) : ResultTcType
  (Err
    (str_cat.str-cat
      (cdiag.compiler-diagnostic-typecheck-tag (ComptimeConstraint))
      "typecheck: "
      name
      " is compile-time only; wrap it in (comptime ...)")))

(define (tc-reflection-runtime-call-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [name-id : i64]) : bool
  (let
    [helper-id : i64 (ctfe_support.ctfe-comptime-helper-call-name-id name-id)]
    (and
      (ctfe_support.ctfe-builtin-reflection-id? helper-id)
      ;; Macro transformer checking installs the bare helper ID in its private
      ;; environment. Runtime checking does not, even when a qualified wrapper
      ;; declaration is visible through an imported module.
      (not (tc-source-value-bound-id? ctx env helper-id))
      (or
        (not (tc-source-value-bound-id? ctx env name-id))
        ;; A real stdlib.comptime wrapper is source-bound, but its qualified
        ;; spelling still denotes the compile-time primitive. Preserve local
        ;; bare shadowing and unrelated `other.type-expr` functions. The
        ;; spelling is only needed here, so it is computed here: every call
        ;; expression passes through this test, and the lookup copies the name.
        (not
          (string.eq
            (ctfe_support.ctfe-comptime-helper-lookup-name
              (tc-global-shared-view name))
            name))))))

;; The clone-able type set is a whole-program fixpoint (O(types*fields) plus a
;; type-name map build). It is invariant across a compile, but `tc-clone-able-
;; type?` is invoked once per `(clone ...)` / `with-escape` body in the program,
;; so recomputing it each time was a large repeated cost. Cache it per compile:
;; populated eagerly in the typecheck entry and reset per compile in macro-
;; expand-program / the REPL entry. Clone checks can also run while the segmented
;; macro program is still active. Those checks populate the same cache in the
;; stable AST-pool arena, and a splice invalidates it only when module/import/type
;; declarations changed. Function-body expression expansion can therefore reuse
;; the whole-program fixpoint without retaining scratch-arena storage or hiding a
;; generated nominal declaration.
;; Clone helper discovery is a semantic observation of the real declaration
;; typecheck, not a reason to run a second partial typechecker. Lowering installs
;; the reachability pass's retained value/function names before checking the
;; specialized source program. Stable canonical names, rather than declaration
;; positions, survive pool compaction and generated-module reshaping. While a
;; retained declaration is checked, clone/with-scratch forms fold their resolved
;; result type directly into the nominal root closure. The root list and name set
;; live in a dedicated arena because function bodies use rewindable scratch.
(define (tc-clone-root-collection-decl-key
  [module-id : i64]
  [decl : ast.AstDecl]) : i64
  (match (ast.ast-decl-unwrapped (& decl))
    [(or (Def _ name _ _) (DefFn _ name _ _ _ _))
      (csym.compiler-symbol-module-key-id-by-id module-id name)]
    [_ -1]))

(define (tc-clone-root-collection-selected-from-program
  [program : ast.AstProgram]) : tc_i64_i64_map.Map
  (match program
    [(Program decls-box)
      (let
        [decls : ast.AstDeclList (ast.ast-decl-list-box-shared-view decls-box)]
        [selected : tc_i64_i64_map.Map
          (tc_i64_i64_map.with-capacity
            (if (< (ast.ast-decl-list-len decls) 8)
              8
              (ast.ast-decl-list-len decls)))]
        [module-id : i64 cbi.compiler-builtin-id-fix-empty]
        [index : i64 0]
        [count : i64 (ast.ast-decl-list-len decls)]
        ;; The row was read by value and then peeled twice more (once inside
        ;; `-decl-key`, once here) -- three 104 B copies per declaration to read
        ;; a name id and a module id. The backing slot is matched in place, and
        ;; the wrapper peel now runs only on an `AstDecl.Unsafe` row.
        [decl-offset : i64 decls.offset]
        (while (< index count)
          (let
            [key : i64
              (tc-clone-root-collection-decl-key
                module-id
                (tc-global-array-element-shared-view
                  decls.slots
                  (+ decl-offset index)))]
            (if (>= key 0)
              (tc_i64_i64_map.insert-ref! (&mut selected) key 1)
              unit)
            (match (tc-global-array-element-shared-view
              decls.slots
              (+ decl-offset index))
              [(Module next-module) (set! module-id next-module)]
              [(Unsafe inner-box)
                (match (ast.ast-decl-box-shared-view inner-box)
                  [(Module next-module) (set! module-id next-module)]
                  [_ unit])]
              [_ unit])
            (set! index (+ index 1))))
        selected)]))

(define (tc-clone-root-collection-use!
  [job-state : TcJobState]
  [retained : ast.AstProgram]) : unit
  (let
    [state : TcCloneState (tc-job-state-clone job-state)]
    [data : (MutPtr TcCloneStateData) (tc-clone-state-ptr state)]
    [arena-handle : i64 (arena.tl_arena_make)]
    (unsafe
      (in-arena
        (arena.Arena arena-handle)
        (set!
          (deref data).root-selected
          (tc-clone-root-collection-selected-from-program retained)))
      (set! (deref data).root-roots (clone_support.CloneRootEntries.Empty))
      (set! (deref data).root-current-decl false)
      (set! (deref data).root-arena arena-handle)
      (set! (deref data).root-active true))))

(define (tc-clone-root-collection-select-decl!
  [ctx : TcContext]
  [decl : ast.AstDecl]
  [module-id : i64]) : unit
  (let
    [state : TcCloneState (tc-job-state-clone (tc-context-job-state ctx))]
    [data : TcCloneStateData (tc-clone-state-data state)]
    (if data.root-active
      (let
        [key : i64 (tc-clone-root-collection-decl-key module-id decl)]
        [selected : bool
          (and (>= key 0) (tc_i64_i64_map.contains? (& data.root-selected) key))]
        (begin
          (set! data.root-current-decl selected)
          (tc-clone-state-data-set! state data)
          (cfg
            (any
              compiler-surface-producer
              compiler-build-identity
              embedded-stdlib-tlci)
            (surface_facts.surface-typecheck-facts-recording-select-decl! key)
            unit)))
      unit)))

(cfg
  (any compiler-surface-producer compiler-build-identity embedded-stdlib-tlci)
  (define (tc-clone-root-collection-record-surface-roots!
    [roots : clone_support.CloneRootEntries]) : unit
    (let
      [index : i64 0]
      [count : i64 (clone_support.clone-root-entries-len roots)]
      (surface_facts.surface-typecheck-facts-recording-start-clone-call!)
      (while (< index count)
        (surface_facts.surface-typecheck-facts-recording-note-clone-root!
          (clone_support.clone-root-entries-key-id-at-or roots index -1))
        (set! index (+ index 1))))))

(define (tc-clone-root-collection-note! [ctx : TcContext] [ty : ast.AstType]) : unit
  (let
    [state : TcCloneState (tc-job-state-clone (tc-context-job-state ctx))]
    [initial : (Ptr TcCloneStateData) (tc-clone-state-view state)]
    (if (and
      (unsafe
        (deref initial).root-active)
      (unsafe
        (deref initial).root-current-decl))
      (match (tc-context-program ctx)
        [(Program decls-box)
          (let
            [decls : ast.AstDeclList
              (ast.ast-decl-list-box-shared-view decls-box)]
            [pools : ast.AstNodePoolContext (tc-context-pools ctx)]
            [able-set : clone_support.CloneNameSet (tc-clone-able-set ctx)]
            ;; Building the able set may have updated this same job-owned cell.
            [data : TcCloneStateData (tc-clone-state-data state)]
            [prev-arena : i64 (arena.tl_arena_current)]
            [_switch : unit
              (unsafe
                (arena.tl_arena_set data.root-arena))]
            [resolved : ast.AstType
              (tc-type-without-regions (tc-resolve-type ctx ty))]
            (begin
              (cfg
                compiler-surface-producer
                (tc-clone-root-collection-record-surface-roots!
                  (if (surface_facts.surface-typecheck-facts-recording?)
                    (clone_support.clone-root-add-type
                      (& pools)
                      (& decls)
                      (& able-set)
                      (Empty)
                      (tc-global-shared-view resolved)
                      cbi.compiler-builtin-id-fix-empty)
                    (Empty)))
                unit)
              ;; Resolve the nominal closure while `ty` and all nested type-pool
              ;; ids are still live in this function's semantic scratch scope.
              ;; Retaining the shallow AstType until the declaration walk ends
              ;; would leave those nested ids pointing past a pool rewind.
              (set!
                data.root-roots
                (clone_support.clone-root-add-type
                  (& pools)
                  (& decls)
                  (& able-set)
                  data.root-roots
                  resolved
                  cbi.compiler-builtin-id-fix-empty))
              (set! data.root-arena (arena.tl_arena_current))
              (tc-clone-state-data-set! state data)
              (unsafe
                (arena.tl_arena_set prev-arena))))])
      unit)))

(define (tc-clone-root-collection-copy-roots
  [roots : clone_support.CloneRootEntries]) : clone_support.CloneRootEntries
  (clone_support.clone-root-entries-copy roots))

(define (tc-clone-root-collection-clear-state! [state : TcCloneState]) : unit
  (let
    [data : (MutPtr TcCloneStateData) (tc-clone-state-ptr state)]
    (unsafe
      (set! (deref data).root-active false)
      (set! (deref data).root-current-decl false)
      (set! (deref data).root-roots (clone_support.CloneRootEntries.Empty))
      (set! (deref data).root-arena 0))))

(define (tc-clone-root-collection-finish! [ctx : TcContext]) : clone_support.CloneRootEntries
  (let
    [state : TcCloneState (tc-job-state-clone (tc-context-job-state ctx))]
    [data : TcCloneStateData (tc-clone-state-data state)]
    (if data.root-active
      (let
        [roots : clone_support.CloneRootEntries
          (tc-clone-root-collection-copy-roots data.root-roots)]
        [arena-handle : i64 data.root-arena]
        (tc-clone-root-collection-clear-state! state)
        (unsafe
          (arena.tl_arena_destroy arena-handle))
        roots)
      (Empty))))

(define (tc-clone-root-collection-abort! [job-state : TcJobState]) : unit
  (let
    [state : TcCloneState (tc-job-state-clone job-state)]
    [data : (Ptr TcCloneStateData) (tc-clone-state-view state)]
    (unsafe
      (if (deref data).root-active
        (let
          [arena-handle : i64 (deref data).root-arena]
          (tc-clone-root-collection-clear-state! state)
          (arena.tl_arena_destroy arena-handle))
        unit))))

(define (tc-clone-root-collection-apply-surface-facts! [ctx : TcContext]) : unit
  (let
    [state : TcCloneState (tc-job-state-clone (tc-context-job-state ctx))]
    [data : TcCloneStateData (tc-clone-state-data state)]
    (if (and data.root-active (surface_facts.surface-typecheck-facts-active?))
      (let
        [facts : surface_facts.SurfaceTypecheckFacts
          (surface_facts.surface-typecheck-facts-current)]
        [decl-keys : (__tl_dyn-array i64) facts.clone-decl-keys]
        [root-keys : (__tl_dyn-array i64) facts.clone-root-keys]
        [call-indices : (__tl_dyn-array i64) facts.clone-call-indices]
        [count : i64 (array-length decl-keys)]
        [index : i64 0]
        (in-arena
          (arena.Arena data.root-arena)
          (while (< index count)
            (let
              [call-index : i64 (array-ref call-indices index)]
              [decl-key : i64 (array-ref decl-keys index)]
              [end : i64 (+ index 1)]
              (while (and
                (< end count)
                (= (array-ref call-indices end) call-index))
                (set! end (+ end 1)))
              (if (tc_i64_i64_map.contains? (& data.root-selected) decl-key)
                (let
                  [cursor : i64 (- end 1)]
                  (while (>= cursor index)
                    (let
                      [root-key : i64 (array-ref root-keys cursor)]
                      (if (clone_support.clone-root-entries-contains-id?
                        data.root-roots
                        root-key)
                        unit
                        (set!
                          data.root-roots
                          (clone_support.clone-root-entries-add-id
                            data.root-roots
                            root-key)))
                      (set! cursor (- cursor 1)))))
                unit)
              (set! index end))))
        (tc-clone-state-data-set! state data))
      unit)))

(define (tc-clone-able-cache-reset-for-state! [state : TcCloneState]) : unit
  (let
    [data : (MutPtr TcCloneStateData) (tc-clone-state-ptr state)]
    (unsafe
      (set! (deref data).able-ready false)
      (set! (deref data).able-cache (clone_support.clone-name-set-empty)))))

(define (tc-clone-able-cache-reset-for-job! [state : TcJobState]) : unit
  (tc-clone-able-cache-reset-for-state! (tc-job-state-clone state)))

(define (tc-clone-root-collection-active-for-job? [state : TcJobState]) : bool
  (unsafe
    (deref (tc-clone-state-view (tc-job-state-clone state))).root-active))

(define (tc-clone-root-collection-arena-for-macro-state [state : TcMacroState]) : i64
  (unsafe
    (deref (tc-clone-state-view (tc-macro-state-clone state))).root-arena))

(define (tc-clone-able-set-build [ctx : TcContext]) : clone_support.CloneNameSet
  (if (macro-segmented-program-active? (tc-context-job-state ctx))
    (macro-segmented-clone-able-set-build
      (tc-context-job-state ctx)
      (tc-context-pools ctx))
    (match (tc-context-program ctx)
      [(Program decls-box)
        (let
          [decls : ast.AstDeclList
            (ast.ast-decl-list-box-shared-view decls-box)]
          [pools : ast.AstNodePoolContext (tc-context-pools ctx)]
          [all-type-names : clone_support.CloneNameSet
            (clone_support.clone-all-type-names
              (& decls)
              (clone_support.clone-name-set-for-decls (& decls)))]
          (clone_support.clone-fixpoint (& pools) (& decls) (& all-type-names)))])))

(define (tc-clone-able-cache-populate! [ctx : TcContext]) : unit
  (let
    [state : TcCloneState (tc-job-state-clone (tc-context-job-state ctx))]
    [data : (MutPtr TcCloneStateData) (tc-clone-state-ptr state)]
    [pools : ast.AstNodePoolContext (tc-context-pools ctx)]
    ;; The pool base owns the cached fixpoint for the context lifetime; the
    ;; lexical extent restores the caller only after the cache is complete.
    [cache-arena : arena.Arena
      (arena.Arena (ast.ast-node-pool-context-base-arena pools))]
    [able-cache : clone_support.CloneNameSet
      (in-arena cache-arena (tc-clone-able-set-build ctx))]
    (unsafe
      (set! (deref data).able-cache able-cache)
      (set! (deref data).able-ready true))))

(define (tc-clone-able-set [ctx : TcContext]) : clone_support.CloneNameSet
  (let
    [state : TcCloneState (tc-job-state-clone (tc-context-job-state ctx))]
    [data : (Ptr TcCloneStateData) (tc-clone-state-view state)]
    (unsafe
      (if (deref data).able-ready
        (deref data).able-cache
        (begin
          (tc-clone-able-cache-populate! ctx)
          (deref (tc-clone-state-view state)).able-cache)))))

(define (tc-clone-unsupported-path-type
  [pools : (& pools ast.AstNodePoolContext)]
  [decls : (& decls ast.AstDeclList)]
  [able : (& able clone_support.CloneNameSet)]
  [names : (& names clone_support.CloneNameSet)]
  [seen : (& seen clone_support.CloneNameSet)]
  [ty : ast.AstType]
  [module-id : i64]
  [path : String]) : String
  (if (clone_support.clone-field-type-able-id?
    pools
    (tc-global-shared-view ty)
    able
    module-id)
    ""
    (match (tc-global-shared-view ty)
      [(Tuple elems)
        (tc-clone-unsupported-path-type-list-at
          pools
          decls
          able
          names
          seen
          (& (__tl-box-place elems))
          module-id
          path
          0)]
      [(or (Array elem _) (DynArray elem) (Slice elem))
        (tc-clone-unsupported-path-type
          pools
          decls
          able
          names
          seen
          (clone_support.clone-type-get pools elem)
          module-id
          (str_cat.str-cat path "[]"))]
      [(Box elem)
        (tc-clone-unsupported-path-type
          pools
          decls
          able
          names
          seen
          (clone_support.clone-type-get pools elem)
          module-id
          (str_cat.str-cat path ".*"))]
      [(Region _ inner)
        (tc-clone-unsupported-path-type
          pools
          decls
          able
          names
          seen
          (clone_support.clone-type-get pools inner)
          module-id
          path)]
      [(or (Var name) (VarArgs name _) (Enum name) (EnumArgs name _)
           (Struct name) (StructArgs name _))
        (tc-clone-unsupported-path-nominal
          pools
          decls
          able
          names
          seen
          name
          module-id
          path)]
      [_
        (str_cat.str-cat
          path
          ": "
          (tc-type-render ty)
          " has no clone capability")])))

(define (tc-clone-unsupported-path-type-list-at
  [pools : (& pools ast.AstNodePoolContext)]
  [decls : (& decls ast.AstDeclList)]
  [able : (& able clone_support.CloneNameSet)]
  [names : (& names clone_support.CloneNameSet)]
  [seen : (& seen clone_support.CloneNameSet)]
  [types : (& types ast.AstTypeList)]
  [module-id : i64]
  [path : String]
  [index : i64]) : String
  (if (>= index (ast.ast-type-list-len types))
    ""
    (let
      [ty : ast.AstType
        (clone_support.clone-type-get
          pools
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      [candidate : String
        (tc-clone-unsupported-path-type
          pools
          decls
          able
          names
          seen
          ty
          module-id
          (str_cat.str-cat
            (tc-global-shared-view path)
            "["
            (string.int->string index)
            "]"))]
      (if (string.eq candidate "")
        (tc-clone-unsupported-path-type-list-at
          pools
          decls
          able
          names
          seen
          types
          module-id
          path
          (+ index 1))
        candidate))))

(define (tc-clone-unsupported-path-fields-at
  [pools : (& pools ast.AstNodePoolContext)]
  [decls : (& decls ast.AstDeclList)]
  [able : (& able clone_support.CloneNameSet)]
  [names : (& names clone_support.CloneNameSet)]
  [seen : (& seen clone_support.CloneNameSet)]
  [fields : (& fields ast.AstFieldDefList)]
  [module-id : i64]
  [path : String]
  [index : i64]) : String
  (if (>= index (ast.ast-field-def-list-len fields))
    ""
    (match (ast.ast-field-def-list-get
      fields
      index
      (ast.ast-field-def-fallback))
      [(Def name ty _)
        (let
          [candidate : String
            (tc-clone-unsupported-path-type
              pools
              decls
              able
              names
              seen
              ty
              module-id
              (str_cat.str-cat
                (tc-global-shared-view path)
                "."
                (ci.intern-str (ci.intern-syntax-id-value name))))]
          (if (string.eq candidate "")
            (tc-clone-unsupported-path-fields-at
              pools
              decls
              able
              names
              seen
              fields
              module-id
              path
              (+ index 1))
            candidate))])))

(define (tc-clone-unsupported-path-variants-at
  [pools : (& pools ast.AstNodePoolContext)]
  [decls : (& decls ast.AstDeclList)]
  [able : (& able clone_support.CloneNameSet)]
  [names : (& names clone_support.CloneNameSet)]
  [seen : (& seen clone_support.CloneNameSet)]
  [variants : (& variants ast.AstVariantDefList)]
  [module-id : i64]
  [path : String]
  [index : i64]) : String
  (if (>= index (ast.ast-variant-def-list-len variants))
    ""
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(Def name payloads _)
        (let
          [candidate : String
            (tc-clone-unsupported-path-type-list-at
              pools
              decls
              able
              names
              seen
              (& payloads)
              module-id
              (str_cat.str-cat
                (tc-global-shared-view path)
                "."
                (ci.intern-str name))
              0)]
          (if (string.eq candidate "")
            (tc-clone-unsupported-path-variants-at
              pools
              decls
              able
              names
              seen
              variants
              module-id
              path
              (+ index 1))
            candidate))])))

(define (tc-clone-unsupported-path-nominal
  [pools : (& pools ast.AstNodePoolContext)]
  [decls : (& decls ast.AstDeclList)]
  [able : (& able clone_support.CloneNameSet)]
  [names : (& names clone_support.CloneNameSet)]
  [seen : (& seen clone_support.CloneNameSet)]
  [name : i64]
  [module-id : i64]
  [path : String]) : String
  (let
    [resolved-key : i64
      (clone_support.clone-type-name-resolve-id names module-id name)]
    [root-fallback : bool
      (clone_support.clone-name-root-fallback-eligible? module-id name)]
    [root-key : i64 (clone_support.clone-name-key-id name)]
    [current-module-id : i64 (clone_support.clone-root-module-id)]
    [index : i64 0]
    [count : i64 (ast.ast-decl-list-len decls)]
    [found : bool false]
    [out : String ""]
    (while (and (not found) (< index count))
      (if (ast.ast-decl-list-unwrapped-module-or-type-definition-at?
        decls
        index)
        (match (ast.ast-decl-unwrapped
          (& (ast.ast-decl-list-get decls index (ast.ast-decl-fallback))))
          [(Module next-module) (set! current-module-id next-module)]
          [(DefEnum _ decl-name _ variants)
            (let
              [decl-key : i64
                (clone_support.clone-name-key-id-in-module
                  current-module-id
                  decl-name)]
              (when
                (or
                  (= decl-key resolved-key)
                  (and root-fallback (= decl-key root-key)))
                (set! found true)
                (if (clone_support.clone-name-set-contains-id? seen decl-key)
                  unit
                  (let
                    [next-seen : clone_support.CloneNameSet
                      (clone_support.clone-name-set-insert-id
                        (owned_view.compiler-owned-reference-shared-view seen)
                        decl-key)]
                    (set!
                      out
                      (tc-clone-unsupported-path-variants-at
                        pools
                        decls
                        able
                        names
                        (& next-seen)
                        (& variants)
                        current-module-id
                        (tc-global-shared-view path)
                        0))))))]
          [(DefStruct _ decl-name _ _ fields)
            (let
              [decl-key : i64
                (clone_support.clone-name-key-id-in-module
                  current-module-id
                  decl-name)]
              (when
                (or
                  (= decl-key resolved-key)
                  (and root-fallback (= decl-key root-key)))
                (set! found true)
                (if (clone_support.clone-name-set-contains-id? seen decl-key)
                  unit
                  (let
                    [next-seen : clone_support.CloneNameSet
                      (clone_support.clone-name-set-insert-id
                        (owned_view.compiler-owned-reference-shared-view seen)
                        decl-key)]
                    (set!
                      out
                      (tc-clone-unsupported-path-fields-at
                        pools
                        decls
                        able
                        names
                        (& next-seen)
                        (& fields)
                        current-module-id
                        (tc-global-shared-view path)
                        0))))))]
          [_ unit])
        unit)
      (set! index (+ index 1)))
    (if found
      out
      (str_cat.str-cat
        path
        ": nominal declaration is unavailable to clone validation"))))

(define (tc-clone-unsupported-detail [ctx : TcContext] [ty : ast.AstType]) : String
  (let
    [pools : ast.AstNodePoolContext (tc-context-pools ctx)]
    [decls : ast.AstDeclList
      (if (macro-segmented-program-active? (tc-context-job-state ctx))
        (match (macro-segmented-program-flatten-raw (tc-context-job-state ctx))
          [(MacroSegmentedProgramFlatView flattened _paths) flattened])
        (match (tc-context-program ctx)
          [(Program decls-box) (__tl-box-place decls-box)]))]
    [able : clone_support.CloneNameSet (tc-clone-able-set ctx)]
    [names : clone_support.CloneNameSet
      (clone_support.clone-all-type-names
        (& decls)
        (clone_support.clone-name-set-for-decls (& decls)))]
    [seen : clone_support.CloneNameSet (clone_support.clone-name-set-empty)]
    [root : String (tc-type-render (tc-global-shared-view ty))]
    [nominal-root : bool
      (match (& ty)
        [(or (Var _) (VarArgs _ _) (Enum _) (EnumArgs _ _) (Struct _)
             (StructArgs _ _))
          true]
        [_ false])]
    [path : String
      (if nominal-root
        (tc-clone-unsupported-path-type
          (& pools)
          (& decls)
          (& able)
          (& names)
          (& seen)
          ty
          (tc-context-module-id ctx)
          root)
        "")]
    (if (string.eq path "")
      ""
      (str_cat.str-cat " at " path))))

(define (tc-clone-able-type? [ctx : TcContext] [ty : ast.AstType]) : bool
  (let
    [pools : ast.AstNodePoolContext (tc-context-pools ctx)]
    [resolved : ast.AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    [able-set : clone_support.CloneNameSet (tc-clone-able-set ctx)]
    (clone_support.clone-field-type-able-id?
      (& pools)
      resolved
      able-set
      (tc-context-module-id ctx))))

;; `(clone x)` deep-copies x into the current arena. Type-directed: the
;; result is the argument's type, stripped of any inner-region tag (the copy
;; lands in the enclosing arena, not the source's region). Unsupported types are
;; rejected here so no heap-backed value silently lowers as a shallow handle copy.
(define (tc-c-fn-check-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 1)
    (let
      [ty (try (tc-expr-id ctx env (ast.ast-expr-list-get (& args) 0 0)))]
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(CFunc signature mode)
          (let
            [_
              (try
                (tc-check-extern-c-abi ctx (tc-context-type-get ctx signature)))]
            (Ok
              (CFunc
                signature
                (if (ast.ast-c-function-mode-unsafe? mode)
                  UnsafeNonNull
                  NonNull))))]
        [_ (Err "typecheck: c-fn-check requires a typed C function pointer")]))
    (Err
      (tc-kind-message
        (ArityMismatch)
        "typecheck: c-fn-check expects exactly one argument"))))

(define (tc-clone-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 1)
    (let
      [arg : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [arg-ty (try (tc-expr ctx env arg))]
      [clone-ty : ast.AstType
        (tc-type-without-regions (tc-global-shared-view arg-ty))]
      (if (tc-clone-able-type? ctx (tc-global-shared-view clone-ty))
        (begin
          (tc-clone-root-collection-note! ctx (tc-global-shared-view clone-ty))
          (Ok clone-ty))
        (Err
          (str_cat.str-cat
            (cdiag.compiler-diagnostic-typecheck-tag (TypeMismatch))
            "typecheck: clone unsupported type "
            (tc-type-render
              (tc-type-without-regions (tc-resolve-type ctx arg-ty)))
            (tc-clone-unsupported-detail ctx clone-ty)))))
    (Err
      (tc-kind-message
        (ArityMismatch)
        "typecheck: clone expects exactly one argument"))))

(define (tc-float-sqrt-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 1)
    (let
      [arg : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [arg-ty (try (tc-expr ctx env (tc-global-shared-view arg)))]
      (match (tc-type-strip-region (tc-resolve-type ctx arg-ty))
        [(F64) (Ok (F64))]
        [(F32) (Ok (F32))]
        [_
          (Err
            (tc-locate-error-at-expr
              (tc-context-expr-bases ctx)
              arg
              "typecheck: __tl_float_sqrt expects f64 or f32"))]))
    (Err
      (tc-kind-message
        (ArityMismatch)
        "typecheck: __tl_float_sqrt expects exactly one argument"))))

(define (tc-float-bitcast-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 1)
    (let
      [arg : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [arg-ty (try (tc-expr ctx env (tc-global-shared-view arg)))]
      (if (cbi.compiler-builtin-lower-float-to-bits-id? name-id)
        (match (tc-type-strip-region (tc-resolve-type ctx arg-ty))
          [(F64) (Ok (U64))]
          [(F32) (Ok (U32))]
          [_
            (Err
              (tc-locate-error-at-expr
                (tc-context-expr-bases ctx)
                arg
                "typecheck: __tl_float_to_bits expects f64 or f32"))])
        (match (tc-type-strip-region (tc-resolve-type ctx arg-ty))
          [(U64) (Ok (F64))]
          [(U32) (Ok (F32))]
          [_
            (Err
              (tc-locate-error-at-expr
                (tc-context-expr-bases ctx)
                arg
                "typecheck: __tl_float_from_bits expects u64 or u32"))])))
    (Err
      (tc-kind-message
        (ArityMismatch)
        "typecheck: float bitcast expects exactly one argument"))))

(define (tc-tls-current-arena-read-call [args : ast.AstExprList]) : ResultTcType
  (if (ast.ast-expr-list-empty? (& args))
    (Ok (I64))
    (Err "typecheck: tls-current-arena expects no arguments")))

(define (tc-tls-current-arena-set-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : ast.AstExprList]) : ResultTcType
  (let
    [_ (try (tc-require-unsafe ctx env "tls-current-arena-set!"))]
    (if (= args.len 1)
      (let
        [value : ast.AstExpr
          (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
        [_
          (try
            (tc-check-exact-arg
              ctx
              env
              value
              (I64)
              (tc-kind-message
                (TypeMismatch)
                "typecheck: tls-current-arena-set! value type mismatch")))]
        (Ok (Unit)))
      (Err
        (tc-kind-message
          (ArityMismatch)
          "typecheck: tls-current-arena-set! expects exactly one argument")))))

(define (tc-tls-current-arena-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [args : ast.AstExprList]) : ResultTcType
  (if (cbi.compiler-builtin-typecheck-tls-current-arena-read-id? name-id)
    (tc-tls-current-arena-read-call args)
    (tc-tls-current-arena-set-call ctx env args)))

;; The subview kind `name` spells, before any shadowing check. Nearly every
;; call name starts with neither `s` nor `_`, so its first byte settles most
;; lookups without a string comparison.
(define (tc-slice-view-spelling-kind [name : (& name str)]) : TcSliceViewCallKind
  (let
    [first : i64
      (if (> (string.string-length name) 0)
        (cast (string.string-ref name 0) : i64)
        0)]
    (cond
      [(= first 115)
        (cond
          [(string.eq name "slice-view") Shared]
          [(string.eq name "slice-mut-view") Mutable]
          [(string.eq name "slice-split-at") SplitShared]
          [(string.eq name "slice-split-at-mut") SplitMutable]
          [else None])]
      [(= first 95)
        (cond
          [(string.eq name "__tl_bytes-view") BytesShared]
          [(string.eq name "__tl_bytes-mut-view") BytesMutable]
          [else None])]
      [else None])))

(define (tc-slice-view-call-kind-name
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [name : String]) : TcSliceViewCallKind
  ;; Source-level definitions (including imported stdlib wrappers) shadow the
  ;; unqualified core spellings.  Keep this check identical to the other
  ;; source builtins: private/compiler names use their own policy, while these
  ;; public compatibility operations consult the authoritative source-value
  ;; membership table.
  (let
    [kind : TcSliceViewCallKind (tc-slice-view-spelling-kind (& name))]
    (if (or
      (= kind TcSliceViewCallKind.None)
      (tc-source-value-bound-id? ctx env name-id))
      (None)
      kind)))

(define (tc-slice-view-call-kind
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]) : TcSliceViewCallKind
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-segment-bases ctx)
    (& func))
    [(Var raw-name)
      (let
        [raw-text : String
          (tc-hygiene-name-text-id-for-session
            (tc-context-structural-session ctx)
            raw-name)]
        [hygiene-global : bool
          (tc-hygiene-global-name-id?
            (tc-context-structural-session ctx)
            raw-name)]
        [name : String
          (if (and
            hygiene-global
            (not
              (macro-hygiene-global-id?
                (tc-context-structural-session ctx)
                raw-name)))
            (tc-hygiene-global-call-name raw-text)
            raw-text)]
        [name-id : i64
          (tc-builtin-call-name-id
            (tc-context-structural-session ctx)
            raw-name
            hygiene-global)]
        (tc-slice-view-call-kind-name ctx env name-id name))]
    [_ (None)]))

(define (tc-slice-view-call-spelling?
  [expr-bases : i64]
  [session : cis.InternStructuralSessionHandle]
  [func : ast.AstExpr]) : bool
  ;; Borrow gating runs before a complete type environment is available.  It
  ;; therefore recognizes the raw spelling conservatively; the real
  ;; classifier above still performs shadowing checks before interception.
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& func))
    [(Var raw-name)
      (let
        [raw-text : String
          (tc-hygiene-name-text-id-for-session session raw-name)]
        [name : String
          (if (tc-hygiene-global-name-id? session raw-name)
            (tc-hygiene-global-call-name raw-text)
            raw-text)]
        (not
          (= (tc-slice-view-spelling-kind (& name)) TcSliceViewCallKind.None)))]
    [_ false]))

(define (tc-slice-call-mutable? [kind : TcSliceViewCallKind]) : bool
  (or
    (= kind TcSliceViewCallKind.Mutable)
    (= kind SplitMutable)
    (= kind BytesMutable)))

(define (tc-slice-call-bytes? [kind : TcSliceViewCallKind]) : bool
  (or (= kind BytesShared) (= kind BytesMutable)))

(define (tc-slice-call-split? [kind : TcSliceViewCallKind]) : bool
  (or (= kind SplitShared) (= kind SplitMutable)))

(define (tc-slice-view-source-info [ctx : TcContext] [source-ty : ast.AstType]) : TcSliceViewSourceInfo
  (match (tc-type-strip-region (tc-resolve-type ctx source-ty))
    [(Array elem len) (Direct (Array elem len))]
    [(DynArray elem) (Direct (DynArray elem))]
    [(Ref lifetime referent-id)
      (let
        [referent : ast.AstType
          (tc-type-strip-region
            (tc-resolve-type ctx (tc-context-type-get ctx referent-id)))]
        (match referent
          [(Array elem len) (Borrow lifetime false (Array elem len))]
          [(DynArray elem) (Borrow lifetime false (DynArray elem))]
          [(Slice elem) (Borrow lifetime false (Slice elem))]
          [(Str) (Borrow lifetime false (Str))]
          [(Bytes) (Borrow lifetime false (Bytes))]
          [_ (Invalid)]))]
    [(MutRef lifetime referent-id)
      (let
        [referent : ast.AstType
          (tc-type-strip-region
            (tc-resolve-type ctx (tc-context-type-get ctx referent-id)))]
        (match referent
          [(Array elem len) (Borrow lifetime true (Array elem len))]
          [(DynArray elem) (Borrow lifetime true (DynArray elem))]
          [(Slice elem) (Borrow lifetime true (Slice elem))]
          [(Bytes) (Borrow lifetime true (Bytes))]
          [_ (Invalid)]))]
    [_ (Invalid)]))

(define (tc-slice-view-source-element
  [ctx : TcContext]
  [source : TcSliceViewSourceInfo]) : ast.AstType
  (match source
    [(Direct direct-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx direct-ty))
        [(Array elem _) (ast.ty-node-get elem)]
        [(DynArray elem) (ast.ty-node-get elem)]
        [_ (Unit)])]
    [(Borrow _ _ referent)
      (match (tc-type-strip-region (tc-resolve-type ctx referent))
        [(or (Array elem _) (DynArray elem) (Slice elem))
          (ast.ty-node-get elem)]
        [(or (Str) (Bytes)) (U8)]
        [_ (Unit)])]
    [_ (Unit)]))

;; Whether `source` suits `kind`: a byte view needs u8 elements, and only a
;; byte view reads a `str` or `bytes` referent.
(define (tc-slice-view-source-fits?
  [ctx : TcContext]
  [kind : TcSliceViewCallKind]
  [source : TcSliceViewSourceInfo]
  [element : ast.AstType]) : bool
  (let
    [text-referent : bool
      (match source
        [(Borrow _ _ referent)
          (match (tc-type-strip-region (tc-resolve-type ctx referent))
            [(or (Str) (Bytes)) true]
            [_ false])]
        [_ false])]
    (if (tc-slice-call-bytes? kind)
      (match (tc-type-strip-region (tc-resolve-type ctx element))
        [(U8) true]
        [_ false])
      (not text-referent))))

;; The borrowed view a subview call of `kind` returns over `element`.
(define (tc-slice-view-borrow-type
  [ctx : TcContext]
  [kind : TcSliceViewCallKind]
  [lifetime : i64]
  [element : ast.AstType]) : ast.AstType
  (let
    [referent : ast.AstType
      (if (tc-slice-call-bytes? kind)
        (Bytes)
        (ast.ast-ty-slice-with-pools (tc-context-pools ctx) (& element)))]
    (if (tc-slice-call-mutable? kind)
      (ast.ast-ty-mut-ref-with-pools
        (tc-context-pools ctx)
        lifetime
        (& referent))
      (ast.ast-ty-ref-with-pools (tc-context-pools ctx) lifetime (& referent)))))

(define (tc-slice-view-result-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [kind : TcSliceViewCallKind]
  [source : ast.AstExpr]
  [source-ty : ast.AstType]) : ResultTcType
  (let
    [source-info : TcSliceViewSourceInfo
      (tc-slice-view-source-info ctx source-ty)]
    [source-element : ast.AstType
      (tc-slice-view-source-element ctx (tc-global-shared-view source-info))]
    (when
      (or
        (match (tc-global-shared-view source-info)
          [(Invalid) true]
          [_ false])
        (not
          (tc-slice-view-source-fits?
            ctx
            kind
            (tc-global-shared-view source-info)
            (tc-global-shared-view source-element))))
      (return
        (Err
          (tc-locate-error-at-expr
            (tc-context-expr-bases ctx)
            source
            (tc-kind-message
              (TypeMismatch)
              (if (tc-slice-call-bytes? kind)
                "typecheck: a bytes view source must be a u8 array, a u8 dynamic array, or a borrowed str, bytes or u8 Slice"
                "typecheck: slice-view source must be a fixed array, dynamic array, or borrowed reference to one"))))))
    (match source-info
      [(Invalid) (Err "unreachable")]
      [(Direct _)
        (when
          (tc-slice-call-mutable? kind)
          (match (tc-mut-borrow-non-call-place-ok
            ctx
            env
            (tc-global-shared-view source))
            [(Ok) unit]
            [(Err message)
              (return
                (Err
                  (tc-locate-error-at-expr
                    (tc-context-expr-bases ctx)
                    source
                    message)))]))
        (match (tc-borrow-place
          ctx
          (tc-context-expr-bases ctx)
          env
          (tc-global-shared-view source))
          [(Ok place)
            (match place
              [(TcBorrowPlace lifetime _ _)
                (Ok
                  (tc-slice-view-borrow-type ctx kind lifetime source-element))])]
          [(Err message)
            (Err
              (tc-locate-error-at-expr
                (tc-context-expr-bases ctx)
                source
                message))])]
      [(Borrow lifetime source-mutable _)
        (if (and (tc-slice-call-mutable? kind) (not source-mutable))
          (Err
            (tc-locate-error-at-expr
              (tc-context-expr-bases ctx)
              source
              (tc-kind-message
                (BorrowViolation)
                (if (tc-slice-call-bytes? kind)
                  "typecheck: __tl_bytes-mut-view requires a mutable borrowed source"
                  "typecheck: slice-mut-view requires a mutable borrowed source"))))
          (Ok (tc-slice-view-borrow-type ctx kind lifetime source-element)))])))

(define (tc-slice-split-result-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [kind : TcSliceViewCallKind]
  [source : ast.AstExpr]
  [source-ty : ast.AstType]) : ResultTcType
  (match (tc-slice-view-source-info ctx (tc-global-shared-view source-ty))
    [(Borrow _ source-mutable referent)
      (match (tc-type-strip-region (tc-resolve-type ctx referent))
        [(Slice _)
          (if (and (tc-slice-call-mutable? kind) (not source-mutable))
            (Err
              (tc-locate-error-at-expr
                (tc-context-expr-bases ctx)
                source
                (tc-kind-message
                  (BorrowViolation)
                  "typecheck: slice-split-at-mut requires a mutable borrowed Slice")))
            (begin
              (when
                (tc-slice-call-mutable? kind)
                (match (tc-mut-borrow-non-call-place-ok
                  ctx
                  env
                  (tc-global-shared-view source))
                  [(Ok) unit]
                  [(Err message)
                    (return
                      (Err
                        (tc-locate-error-at-expr
                          (tc-context-expr-bases ctx)
                          source
                          message)))]))
              (let
                [half-ty : ast.AstType
                  (try
                    (tc-slice-view-result-type ctx env kind source source-ty))]
                (Ok
                  (ast.ast-ty-tuple
                    (ast.ast-type-cons-with-pools
                      (tc-context-pools ctx)
                      (& half-ty)
                      (&
                        (ast.ast-type-cons-with-pools
                          (tc-context-pools ctx)
                          (& half-ty)
                          (& (ast.ast-type-list-new))))))))))]
        [_
          (Err
            (tc-locate-error-at-expr
              (tc-context-expr-bases ctx)
              source
              (tc-kind-message
                (TypeMismatch)
                "typecheck: slice-split-at source must be a borrowed Slice")))])]
    [_
      (Err
        (tc-locate-error-at-expr
          (tc-context-expr-bases ctx)
          source
          (tc-kind-message
            (TypeMismatch)
            "typecheck: slice-split-at source must be a borrowed Slice")))]))

(define (tc-slice-split-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [kind : TcSliceViewCallKind]
  [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 2)
    (let
      [source : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [mid : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 1 0))]
      [source-ty (try (tc-expr ctx env (tc-global-shared-view source)))]
      [result-ty : ast.AstType
        (try (tc-slice-split-result-type ctx env kind source source-ty))]
      [mid-ty (try (tc-expr ctx env (tc-global-shared-view mid)))]
      (if (tc-integer-type? (tc-global-shared-view mid-ty))
        (Ok result-ty)
        (Err
          (tc-locate-error-at-expr
            (tc-context-expr-bases ctx)
            mid
            (tc-call-argument-expected-text-message ctx func 1 mid-ty "integer")))))
    (Err
      (tc-call-fixed-arity-message
        (tc-context-expr-segment-bases ctx)
        func
        args
        2))))

(define (tc-slice-view-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [kind : TcSliceViewCallKind]
  [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 3)
    (let
      [source : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [start : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 1 0))]
      [len : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 2 0))]
      [source-ty (try (tc-expr ctx env (tc-global-shared-view source)))]
      [result-ty : ast.AstType
        (try (tc-slice-view-result-type ctx env kind source source-ty))]
      [start-ty (try (tc-expr ctx env (tc-global-shared-view start)))]
      (if (tc-integer-type? (tc-global-shared-view start-ty))
        (let
          [len-ty (try (tc-expr ctx env (tc-global-shared-view len)))]
          (if (tc-integer-type? (tc-global-shared-view len-ty))
            (Ok result-ty)
            (Err
              (tc-locate-error-at-expr
                (tc-context-expr-bases ctx)
                len
                (tc-call-argument-expected-text-message
                  ctx
                  func
                  2
                  len-ty
                  "integer")))))
        (Err
          (tc-locate-error-at-expr
            (tc-context-expr-bases ctx)
            start
            (tc-call-argument-expected-text-message
              ctx
              func
              1
              start-ty
              "integer")))))
    (Err
      (tc-call-fixed-arity-message
        (tc-context-expr-segment-bases ctx)
        func
        args
        3))))

(define (tc-call-or-array-length-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]
  [args : ast.AstExprList]) : ResultTcType
  (let
    [func : ast.AstExpr (tc-context-expr-get ctx func-id)]
    (match (ast.ast-expr-unspan-with-segment-bases
      (tc-context-expr-segment-bases ctx)
      (& func))
      [(Var raw-name)
        ;; Keep builtin dispatch identical to the string-name call path; only
        ;; the ordinary fallback needs the pooled function expression id.
        (let
          [raw-text : String
            (tc-hygiene-name-text-id-for-session
              (tc-context-structural-session ctx)
              raw-name)]
          [hygiene-global : bool
            (tc-hygiene-global-name-id?
              (tc-context-structural-session ctx)
              raw-name)]
          [name : String
            (if (and
              hygiene-global
              (not
                (macro-hygiene-global-id?
                  (tc-context-structural-session ctx)
                  raw-name)))
              (tc-hygiene-global-call-name raw-text)
              raw-text)]
          [name-id : i64
            (tc-builtin-call-name-id
              (tc-context-structural-session ctx)
              raw-name
              hygiene-global)]
          [lookup-id : i64
            (tc-call-builtin-lookup-id
              ctx
              env
              (tc-global-shared-view name)
              name-id)]
          (if (or
            (< name-id 0)
            (csym.compiler-composite-triple-key-id? lookup-id)
            (tc-call-variant-name-id? ctx name-id))
            (tc-call-expr-ordinary-id ctx env func-id args)
            (let
              [arena-call-kind : i64
                (tc-arena-safe-call-kind-id ctx env name-id lookup-id)]
              [arena-owner-kind : i64
                (tc-arena-owner-call-kind-ids
                  ctx
                  env
                  name-id
                  lookup-id
                  args.len)]
              [slice-call-kind : TcSliceViewCallKind
                (tc-slice-view-call-kind-name
                  ctx
                  env
                  name-id
                  (tc-global-shared-view name))]
              (cond
                [(and
                    (tc-layout-query-name? (tc-global-shared-view name))
                    (not (tc-source-value-bound-id? ctx env name-id)))
                  (tc-layout-query-runtime-call name args)]
                [(tc-string-length-helper-call-id? ctx env name-id lookup-id)
                  (tc-one-length-handle-builtin-call ctx env func args (I64))]
                [(tc-slice-call-split? slice-call-kind)
                  (tc-slice-split-call ctx env func slice-call-kind args)]
                [(not (= slice-call-kind TcSliceViewCallKind.None))
                  (tc-slice-view-call ctx env func slice-call-kind args)]
                [(cbi.compiler-builtin-typecheck-length-call-id? name-id)
                  (tc-array-length-call ctx env name-id func args)]
                [(and
                    (cbi.compiler-builtin-typecheck-string-ref-call-id? name-id)
                    (not (tc-source-value-bound-id? ctx env name-id)))
                  (tc-string-ref-call ctx env func args)]
                [(tc-string-ref-helper-call-id? ctx env name-id lookup-id)
                  (tc-string-ref-call ctx env func args)]
                [(and
                    (tc-atomic-pointer-name? (tc-global-shared-view name))
                    (not (tc-source-value-bound-id? ctx env name-id)))
                  (tc-atomic-pointer-call ctx env name args)]
                [(not (= arena-owner-kind (tc-arena-owner-kind-none)))
                  (tc-arena-owner-call-type-id
                    ctx
                    env
                    func-id
                    args
                    arena-owner-kind)]
                [(= arena-call-kind (tc-arena-safe-call-kind-phase))
                  (tc-phase-call ctx env func args)]
                [(= arena-call-kind (tc-arena-safe-call-kind-rewind))
                  (tc-rewind-safe-call ctx env args)]
                [(= arena-call-kind (tc-arena-safe-call-kind-destroy))
                  (tc-destroy-safe-call ctx env args)]
                [(and
                    (cbi.compiler-builtin-typecheck-tls-current-arena-id?
                      name-id)
                    (not (tc-source-value-bound-id? ctx env name-id)))
                  (tc-tls-current-arena-call ctx env name-id args)]
                [(and
                    (tc-borrowed-string-builtin-id? name-id)
                    (tc-default-builtin-unshadowed-id? env name-id))
                  (tc-borrowed-string-builtin-call ctx env func name-id args)]
                [(tc-string-eq-helper-call-id? ctx env name-id lookup-id)
                  (tc-borrowed-string-builtin-call
                    ctx
                    env
                    func
                    cbi.compiler-builtin-id-tl-private-string-eq
                    args)]
                [(tc-string-copy-helper-call-id? ctx env name-id lookup-id)
                  (tc-two-string-handle-builtin-call ctx env func args (String))]
                [(tc-string-to-int-helper-call-id? ctx env lookup-id)
                  (tc-borrowed-string-builtin-call
                    ctx
                    env
                    func
                    cbi.compiler-builtin-id-tl-private-string-to-int
                    args)]
                [(tc-reflection-runtime-call-id?
                    ctx
                    env
                    (tc-global-shared-view name)
                    name-id)
                  (tc-reflection-query-runtime-call
                    (ctfe_support.ctfe-comptime-helper-lookup-name name))]
                [(and
                    (ctfe_support.ctfe-builtin-module-value-id? name-id)
                    (not (tc-source-value-bound-id? ctx env name-id)))
                  (tc-reflection-query-runtime-call name)]
                [(and
                    (cbi.compiler-builtin-typecheck-float-sqrt-id? name-id)
                    (tc-private-intrinsic-unshadowed-id? ctx env name-id))
                  (tc-float-sqrt-call ctx env args)]
                [(and
                    (cbi.compiler-builtin-typecheck-float-bitcast-id? name-id)
                    (tc-private-intrinsic-unshadowed-id? ctx env name-id))
                  (tc-float-bitcast-call ctx env name-id args)]
                [(and
                    (cbi.compiler-builtin-c-fn-check-id? name-id)
                    (not (tc-source-value-bound-id? ctx env name-id)))
                  (tc-c-fn-check-call ctx env args)]
                [(and
                    (cbi.compiler-builtin-typecheck-clone-id? name-id)
                    (not (tc-source-value-bound-id? ctx env name-id)))
                  (tc-clone-call ctx env args)]
                [else (tc-call-expr-ordinary-id ctx env func-id args)]))))]
      [_ (tc-call-expr-ordinary-id ctx env func-id args)])))

(define (tc-let-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : ast.AstLetBindingList]) : ResultTcEnv
  (tc-let-bindings-at ctx env (& bindings) 0))

(define (tc-let-binding-resolve-maybe-type
  [ctx : TcContext]
  [maybe-ty : ast.AstMaybeType]) : ast.AstMaybeType
  (match maybe-ty
    [(Some want) (Some (tc-resolve-type ctx want))]
    [(No) No]))

(define (tc-let-binding-plain-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [maybe-ty : ast.AstMaybeType]
  [init : ast.AstExpr]) : ResultTcType
  ;; This path exists only to extend the environment while expression macros
  ;; are being expanded. The complete expanded let is checked afterward by
  ;; `tc-let-bindings-for-body`, which proves concrete closure capability and
  ;; captured-lifetime uses against the rest of the bindings and body. Admit a
  ;; direct lambda here so a macro-produced reference-capturing closure can
  ;; survive long enough to reach that proof instead of being treated as an
  ;; already-escaping plain function value during the expansion walk.
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-bases ctx)
    (& init))
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda params maybe-ret body-box)
          (tc-lambda-expr-allow-ref-captures
            ctx
            env
            params
            maybe-ret
            (tc-context-expr-get ctx body-box))])]
    [_
      (match maybe-ty
        [(Some want) (tc-expr-with-expected-or-actual ctx env init want)]
        [(No) (tc-expr ctx env init)])]))

(define (tc-let-binding-plain-expected-ok
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [maybe-ty : ast.AstMaybeType]
  [init : ast.AstExpr]
  [init-ty : ast.AstType]) : ResultTcUnit
  (match maybe-ty
    [(Some want)
      (match (tc-expect-in-context
        ctx
        env
        init-ty
        want
        (str_cat.str-cat "typecheck: let binding `" name "` type mismatch"))
        [(Ok) Ok]
        [(Err message)
          (Err
            (tc-locate-error-at-expr (tc-context-expr-bases ctx) init message))])]
    [(No) Ok]))

(define (tc-let-binding-plain-bind-type
  [_ctx : TcContext]
  [maybe-ty : ast.AstMaybeType]
  [init-ty : ast.AstType]) : ast.AstType
  (match maybe-ty
    [(Some want)
      (if (tc-type-contains-region-tag? (tc-global-shared-view init-ty))
        init-ty
        want)]
    [(No) init-ty]))

(define (tc-let-bindings-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : ResultTcEnv
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (Ok env)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name maybe-ty init-box)
        (let
          [init : ast.AstExpr (tc-context-expr-get ctx init-box)]
          [resolved-maybe-ty : ast.AstMaybeType
            (tc-let-binding-resolve-maybe-type ctx maybe-ty)]
          [init-ty
            (try
              (tc-let-binding-plain-type
                ctx
                env
                (tc-global-shared-view resolved-maybe-ty)
                (tc-global-shared-view init)))]
          [_
            (try
              (tc-let-binding-plain-expected-ok
                ctx
                env
                (tc-env-key-name-text-for-session
                  (tc-context-structural-session ctx)
                  name)
                (tc-global-shared-view resolved-maybe-ty)
                (tc-global-shared-view init)
                (tc-global-shared-view init-ty)))]
          (let
            [_
              (try
                (tc-ensure-cleanup-resource-not-let-bound
                  ctx
                  env
                  (tc-global-shared-view init)))]
            (let
              [_
                (try
                  (tc-ensure-let-value-can-bind
                    ctx
                    env
                    (tc-global-shared-view init)
                    (tc-global-shared-view init-ty)))]
              (tc-let-bindings-at
                ctx
                (tc-bind-initialized-value-id
                  ctx
                  env
                  name
                  (tc-let-binding-plain-bind-type ctx resolved-maybe-ty init-ty)
                  init)
                bindings
                (+ index 1)))))])))

(define (tc-lambda-captures-reference?
  [expr-bases : i64]
  [env : TcTypeEnv]
  [params : ast.AstParamList]
  [body : ast.AstExpr]) : bool
  (tc-type-env-scoped-carrier-lambda-captures-reference?
    expr-bases
    (tc-type-env-scoped-carrier-from-marker-visible-env env)
    params
    body))

(define (tc-type-env-scoped-lambda-captures-reference-scan
  [expr-bases : i64]
  [cursor : TcTypeEnvScopedMarkerCursor]
  [bound : TcStringList]
  [body : ast.AstExpr]) : bool
  (match (tc-type-env-scoped-marker-step cursor)
    [(Done) false]
    [(Bind key ty rest-cursor)
      (if (or
        (= key (tc-region-marker-id))
        (= key (tc-default-boundary-id))
        (tc-cleanup-owner-marker-entry? key ty)
        (tc-ordinary-arena-owner-marker-entry? key (tc-global-shared-view ty))
        (tc-atomic-arena-owner-marker-entry? key (tc-global-shared-view ty)))
        (tc-type-env-scoped-lambda-captures-reference-scan
          expr-bases
          rest-cursor
          bound
          body)
        (if (and
          (tc-expr-uses-free-name?
            expr-bases
            (tc-global-shared-view body)
            (tc-env-key-name-text key)
            (tc-global-shared-view bound))
          (tc-type-contains-reference? ty))
          true
          (tc-type-env-scoped-lambda-captures-reference-scan
            expr-bases
            rest-cursor
            bound
            body)))]))

(define (tc-type-env-scoped-carrier-lambda-captures-reference?
  [expr-bases : i64]
  [carrier : TcTypeEnvScopedCarrier]
  [params : ast.AstParamList]
  [body : ast.AstExpr]) : bool
  (begin
    (cfg compile-profile (counters.bump! tc-profile-env-marker-scans))
    (tc-type-env-scoped-lambda-captures-reference-scan
      expr-bases
      (tc-type-env-scoped-carrier-marker-cursor carrier)
      (tc-param-bound-names params)
      body)))

(define (tc-ref-capturing-lambda-init?
  [expr-bases : i64]
  [env : TcTypeEnv]
  [init : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& init))
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda params _ body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (tc-lambda-captures-reference? expr-bases env params body))])]
    [_ false]))

;; Concrete closure facts are deliberately not part of AstType.Func: literals
;; and fact-preserving local aliases may retain them, while wider value flows
;; fail closed when they would erase required ownership or lifetime facts. The
;; move checker computes the capability from the literal's captures/body; this
;; early query lets the ordinary let escape proof reject unsafe widening.
(define (tc-move-only-capturing-lambda-init?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [init : ast.AstExpr]) : bool
  (let
    [expr-bases : i64 (tc-context-expr-bases ctx)]
    (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& init))
      [(Lambda lambda-box)
        (match (__tl-box-place lambda-box)
          [(Lambda params _ body-box)
            (let
              [body : ast.AstExpr
                (ast.ast-expr-segment-bases-get expr-bases body-box)]
              (tc-lambda-capture-has-move-only? ctx expr-bases env params body))])]
      [_ false])))

(define (tc-consuming-capturing-lambda-init?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [init : ast.AstExpr]) : bool
  (let
    [expr-bases : i64 (tc-context-expr-bases ctx)]
    (and
      (tc-move-only-capturing-lambda-init? ctx env (tc-global-shared-view init))
      (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& init))
        [(Lambda lambda-box)
          (match (__tl-box-place lambda-box)
            [(Lambda params _ body-box)
              (=
                (tc-lambda-call-capability ctx env params body-box)
                (tc-closure-call-capability-once))])]
        [_ false]))))

(define (tc-ref-closure-expr-list-local-uses-ok?
  [expr-bases : i64]
  [exprs : ast.AstExprList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-ref-closure-expr-list-local-uses-ok-at? expr-bases (& exprs) 0 name bound))

(define (tc-ref-closure-expr-list-local-uses-ok-at?
  [expr-bases : i64]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [name : String]
  [bound : TcStringList]) : bool
  (if (>= index exprs.len)
    true
    (and
      (tc-ref-closure-local-uses-ok?
        expr-bases
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get exprs index 0))
        (tc-global-shared-view name)
        (tc-global-shared-view bound))
      (tc-ref-closure-expr-list-local-uses-ok-at?
        expr-bases
        exprs
        (+ index 1)
        name
        bound))))

(define (tc-ref-closure-let-binding-list-local-uses-ok?
  [expr-bases : i64]
  [bindings : ast.AstLetBindingList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-ref-closure-let-binding-list-local-uses-ok-at?
    expr-bases
    (& bindings)
    name
    bound
    0))

(define (tc-ref-closure-let-binding-list-local-uses-ok-at?
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [name : String]
  [bound : TcStringList]
  [index : i64]) : bool
  (if (>= index (ast.ast-let-binding-list-len bindings))
    true
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding bind-name _ init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          (and
            (tc-ref-closure-local-uses-ok?
              expr-bases
              init
              (tc-global-shared-view name)
              (tc-global-shared-view bound))
            (tc-ref-closure-let-binding-list-local-uses-ok-at?
              expr-bases
              bindings
              name
              (tc-string-list-add bound (ci.intern-str bind-name))
              (+ index 1))))])))

(define (tc-ref-closure-let-rest-and-body-local-uses-ok-at?
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [body : ast.AstExpr]
  [name : String]
  [bound : TcStringList]
  [allow-copy-alias : bool]
  [index : i64]) : bool
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (tc-ref-closure-local-uses-ok? expr-bases body name bound)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding bind-name _ init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [bind-name-text : String (tc-env-key-name-text bind-name)]
          [direct-copy-alias : bool
            (and
              allow-copy-alias
              (match (ast.ast-expr-unspan-with-segment-bases
                expr-bases
                (& init))
                [(Var source-name)
                  (and
                    (string.eq (tc-env-key-name-text source-name) name)
                    (not
                      (tc-string-list-contains
                        (tc-global-shared-view bound)
                        (tc-global-shared-view name))))]
                [_ false]))]
          [nested-fact-capture : bool
            (and
              allow-copy-alias
              (match (ast.ast-expr-unspan-with-segment-bases
                expr-bases
                (& init))
                [(Lambda lambda-box)
                  (match (ast.ast-lambda-box-shared-view lambda-box)
                    [(Lambda params _ lambda-body-box)
                      (tc-expr-uses-free-name?
                        expr-bases
                        (ast.ast-expr-segment-bases-get
                          expr-bases
                          lambda-body-box)
                        (tc-global-shared-view name)
                        (tc-param-list-add-bound-names
                          params
                          (tc-global-shared-view bound)))])]
                [_ false]))]
          (if (or direct-copy-alias nested-fact-capture)
            (and
              (tc-ref-closure-let-rest-and-body-local-uses-ok-at?
                expr-bases
                bindings
                (tc-global-shared-view body)
                bind-name-text
                Nil
                true
                (+ index 1))
              (tc-ref-closure-let-rest-and-body-local-uses-ok-at?
                expr-bases
                bindings
                body
                name
                (tc-string-list-add bound (ci.intern-str bind-name))
                true
                (+ index 1)))
            (and
              (tc-ref-closure-local-uses-ok?
                expr-bases
                init
                (tc-global-shared-view name)
                (tc-global-shared-view bound))
              (tc-ref-closure-let-rest-and-body-local-uses-ok-at?
                expr-bases
                bindings
                body
                name
                (tc-string-list-add bound (ci.intern-str bind-name))
                allow-copy-alias
                (+ index 1)))))])))

(define (tc-ref-closure-resource-binding-list-local-uses-ok?
  [expr-bases : i64]
  [bindings : ast.AstResourceBindingList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-ref-closure-resource-binding-list-local-uses-ok-at?
    expr-bases
    (& bindings)
    name
    bound
    0))

(define (tc-ref-closure-resource-binding-list-local-uses-ok-at?
  [expr-bases : i64]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [name : String]
  [bound : TcStringList]
  [index : i64]) : bool
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    true
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(Binding bind-name init-box cleanup-box _)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [cleanup : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases cleanup-box)]
          (and
            (tc-ref-closure-local-uses-ok?
              expr-bases
              init
              (tc-global-shared-view name)
              (tc-global-shared-view bound))
            (tc-ref-closure-local-uses-ok?
              expr-bases
              cleanup
              (tc-global-shared-view name)
              (tc-global-shared-view bound))
            (tc-ref-closure-resource-binding-list-local-uses-ok-at?
              expr-bases
              bindings
              name
              (tc-string-list-add bound (ci.intern-str bind-name))
              (+ index 1))))])))

(define (tc-ref-closure-match-arms-local-uses-ok?
  [expr-bases : i64]
  [arms : ast.AstMatchArmList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-ref-closure-match-arms-local-uses-ok-at? expr-bases (& arms) name bound 0))

(define (tc-ref-closure-match-arms-local-uses-ok-at?
  [expr-bases : i64]
  [arms : (& arms ast.AstMatchArmList)]
  [name : String]
  [bound : TcStringList]
  [index : i64]) : bool
  (if (>= index arms.len)
    true
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          (and
            (tc-ref-closure-local-uses-ok?
              expr-bases
              body
              (tc-global-shared-view name)
              (tc-pattern-add-bound-names pattern (tc-global-shared-view bound)))
            (tc-ref-closure-match-arms-local-uses-ok-at?
              expr-bases
              arms
              name
              bound
              (+ index 1))))])))

(define (tc-ref-closure-direct-call?
  [expr-bases : i64]
  [func : ast.AstExpr]
  [name : String]
  [bound : TcStringList]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& func))
    [(Var var-name)
      (and
        (string.eq (tc-env-key-name-text var-name) name)
        (not (tc-string-list-contains bound name)))]
    [_ false]))

(define (tc-ref-closure-no-free-use?
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [name : String]
  [bound : TcStringList]) : bool
  (not
    (tc-expr-uses-free-name?
      expr-bases
      (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
      name
      bound)))

(define (tc-ref-closure-local-uses-ok?
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [name : String]
  [bound : TcStringList]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(Var var-name)
      (not
        (and
          (string.eq (tc-env-key-name-text var-name) name)
          (not (tc-string-list-contains bound name))))]
    [(Call func-box args)
      (let
        [func : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases func-box)]
        (if (tc-ref-closure-direct-call?
          expr-bases
          (tc-global-shared-view func)
          (tc-global-shared-view name)
          (tc-global-shared-view bound))
          (tc-ref-closure-expr-list-local-uses-ok? expr-bases args name bound)
          (and
            (tc-ref-closure-local-uses-ok?
              expr-bases
              func
              (tc-global-shared-view name)
              (tc-global-shared-view bound))
            (tc-ref-closure-expr-list-local-uses-ok? expr-bases args name bound))))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (and
              (tc-ref-closure-let-binding-list-local-uses-ok?
                expr-bases
                (tc-global-shared-view bindings)
                (tc-global-shared-view name)
                (tc-global-shared-view bound))
              (tc-ref-closure-local-uses-ok?
                expr-bases
                body
                name
                (tc-let-binding-list-add-bound-names bindings bound))))])]
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda params _ body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (not
              (tc-expr-uses-free-name?
                expr-bases
                body
                name
                (tc-param-list-add-bound-names params bound))))])]
    [(Set var-name value-box)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (and
          (not
            (and
              (string.eq (tc-env-key-name-text var-name) name)
              (not
                (tc-string-list-contains
                  (tc-global-shared-view bound)
                  (tc-global-shared-view name)))))
          (tc-ref-closure-local-uses-ok? expr-bases value name bound)))]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match scrutinee-box arms)
          (let
            [scrutinee : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases scrutinee-box)]
            (and
              (tc-ref-closure-local-uses-ok?
                expr-bases
                scrutinee
                (tc-global-shared-view name)
                (tc-global-shared-view bound))
              (tc-ref-closure-match-arms-local-uses-ok?
                expr-bases
                arms
                name
                bound)))])]
    [(Foreach fe-box)
      (match (__tl-box-place fe-box)
        [(Foreach index _ start-box end-box body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (and
              (tc-ref-closure-local-uses-ok?
                expr-bases
                start
                (tc-global-shared-view name)
                (tc-global-shared-view bound))
              (tc-ref-closure-local-uses-ok?
                expr-bases
                end
                (tc-global-shared-view name)
                (tc-global-shared-view bound))
              (tc-ref-closure-local-uses-ok?
                expr-bases
                body
                name
                (tc-string-list-add bound (tc-env-key-name-text index)))))]
        [(Foreach2 outer _ a-box b-box inner _ c-box d-box body-box)
          (and
            (tc-ref-closure-local-uses-ok?
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases a-box)
              (tc-global-shared-view name)
              (tc-global-shared-view bound))
            (tc-ref-closure-local-uses-ok?
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases b-box)
              (tc-global-shared-view name)
              (tc-global-shared-view bound))
            (tc-ref-closure-local-uses-ok?
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases c-box)
              (tc-global-shared-view name)
              (tc-global-shared-view bound))
            (tc-ref-closure-local-uses-ok?
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases d-box)
              (tc-global-shared-view name)
              (tc-global-shared-view bound))
            (tc-ref-closure-local-uses-ok?
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases body-box)
              name
              (tc-string-list-add
                (tc-string-list-add bound (tc-env-key-name-text outer))
                (tc-env-key-name-text inner))))])]
    [(SpmdReduce reduce-box)
      (match (__tl-box-place reduce-box)
        [(Reduce _ index _ start-box end-box init-box value-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [value : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases value-box)]
            (and
              (tc-ref-closure-local-uses-ok?
                expr-bases
                start
                (tc-global-shared-view name)
                (tc-global-shared-view bound))
              (tc-ref-closure-local-uses-ok?
                expr-bases
                end
                (tc-global-shared-view name)
                (tc-global-shared-view bound))
              (tc-ref-closure-local-uses-ok?
                expr-bases
                init
                (tc-global-shared-view name)
                (tc-global-shared-view bound))
              (tc-ref-closure-local-uses-ok?
                expr-bases
                value
                name
                (tc-string-list-add bound (tc-env-key-name-text index)))))])]
    [(SpmdScan scan-box)
      (match (__tl-box-place scan-box)
        [(Scan _ index _ start-box end-box prefix _ init-box value-box body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [value : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases value-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [index-bound : TcStringList
              (tc-string-list-add
                (tc-global-shared-view bound)
                (tc-env-key-name-text index))]
            [body-bound : TcStringList
              (tc-string-list-add
                (tc-global-shared-view index-bound)
                (tc-env-key-name-text prefix))]
            (and
              (tc-ref-closure-local-uses-ok?
                expr-bases
                start
                (tc-global-shared-view name)
                (tc-global-shared-view bound))
              (tc-ref-closure-local-uses-ok?
                expr-bases
                end
                (tc-global-shared-view name)
                (tc-global-shared-view bound))
              (tc-ref-closure-local-uses-ok?
                expr-bases
                init
                (tc-global-shared-view name)
                bound)
              (tc-ref-closure-local-uses-ok?
                expr-bases
                value
                (tc-global-shared-view name)
                index-bound)
              (tc-ref-closure-local-uses-ok? expr-bases body name body-bound)))])]
    [(SpmdCompact compact-box)
      (match (__tl-box-place compact-box)
        [(Compact index _ start-box end-box slot _ init-box keep-box body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [keep : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases keep-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [index-bound : TcStringList
              (tc-string-list-add
                (tc-global-shared-view bound)
                (tc-env-key-name-text index))]
            [body-bound : TcStringList
              (tc-string-list-add
                (tc-global-shared-view index-bound)
                (tc-env-key-name-text slot))]
            (and
              (tc-ref-closure-local-uses-ok?
                expr-bases
                start
                (tc-global-shared-view name)
                (tc-global-shared-view bound))
              (tc-ref-closure-local-uses-ok?
                expr-bases
                end
                (tc-global-shared-view name)
                (tc-global-shared-view bound))
              (tc-ref-closure-local-uses-ok?
                expr-bases
                init
                (tc-global-shared-view name)
                bound)
              (tc-ref-closure-local-uses-ok?
                expr-bases
                keep
                (tc-global-shared-view name)
                index-bound)
              (tc-ref-closure-local-uses-ok? expr-bases body name body-bound)))])]
    [(WithResource wr-box)
      (match (__tl-box-place wr-box)
        [(WithResource bindings body)
          (and
            (tc-ref-closure-resource-binding-list-local-uses-ok?
              expr-bases
              (tc-global-shared-view bindings)
              (tc-global-shared-view name)
              (tc-global-shared-view bound))
            (tc-ref-closure-expr-list-local-uses-ok?
              expr-bases
              body
              name
              (tc-resource-binding-list-add-bound-names bindings bound)))])]
    [(ForeachActive lane body-box)
      (tc-ref-closure-local-uses-ok?
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases body-box)
        name
        (tc-string-list-add bound (tc-env-key-name-text lane)))]
    ;; These forms may not use the name at all.
    [(or (Spanned _ _) (MacroExpansion _ _ _) (PtrAddrOf _) (ForOwnedState _)
         (ForOwnedStep _))
      (tc-ref-closure-no-free-use? expr-bases expr name bound)]
    [_
      (tc-ref-closure-expr-list-local-uses-ok?
        expr-bases
        (ast.ast-expr-child-ids
          (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr)))
        name
        bound)]))

(define (tc-reference-closure-escape-message) : String
  (tc-kind-message
    (RegionEscape)
    "typecheck: reference-capturing closure value would escape lexical scope"))

(define (tc-capability-closure-escape-message) : String
  (tc-kind-message
    (ResourceOwnership)
    "typecheck: closure capability would be erased by escaping the direct local binding"))

(define (tc-move-closure-escape-message) : String
  (tc-kind-message
    (ResourceOwnership)
    "typecheck: non-Copy closure ownership would be erased by escaping the direct local binding"))

(define (tc-let-binding-ref-closure-scope-ok-at
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]
  [body : ast.AstExpr]
  [name : String]
  [allow-copy-alias : bool]) : ResultTcUnit
  (if (tc-ref-closure-let-rest-and-body-local-uses-ok-at?
    expr-bases
    bindings
    body
    name
    Nil
    allow-copy-alias
    index)
    Ok
    (Err (tc-reference-closure-escape-message))))

(define (tc-let-binding-capability-closure-scope-ok-at
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]
  [body : ast.AstExpr]
  [name : String]) : ResultTcUnit
  (if (tc-ref-closure-let-rest-and-body-local-uses-ok-at?
    expr-bases
    bindings
    body
    name
    Nil
    false
    index)
    Ok
    (Err (tc-capability-closure-escape-message))))

(define (tc-let-binding-move-closure-scope-ok-at
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]
  [body : ast.AstExpr]
  [name : String]) : ResultTcUnit
  (if (tc-ref-closure-let-rest-and-body-local-uses-ok-at?
    expr-bases
    bindings
    body
    name
    Nil
    true
    index)
    Ok
    (Err (tc-move-closure-escape-message))))

(define (tc-inlay-hint-storage-ensure-for-state! [state : TcInlayHintState]) : unit
  (let
    [data : (MutPtr TcInlayHintStateData) (tc-inlay-hint-state-ptr state)]
    (unsafe
      (if (= (array-length (deref data).lines) tc-inlay-hint-capacity)
        unit
        (in-arena
          (arena.Arena (deref data).fixed-storage-arena)
          (set! (deref data).lines (__tl_make-array i64 tc-inlay-hint-capacity))
          (set! (deref data).cols (__tl_make-array i64 tc-inlay-hint-capacity))
          (set!
            (deref data).types
            (__tl_make-array String tc-inlay-hint-capacity)))))))

(define (tc-inlay-hint-string-arena-ensure-for-state!
  [state : TcInlayHintState]) : i64
  (let
    [data : TcInlayHintStateData (tc-inlay-hint-state-data state)]
    (if (= data.string-arena 0)
      (let
        [owner : i64 (arena.tl_arena_make_small)]
        (set! data.string-arena owner)
        (tc-inlay-hint-state-data-set! state (tc-global-shared-view data))
        data.string-arena)
      data.string-arena)))

;; Destroying any segment of the chain frees the complete generation arena.
(define (tc-inlay-hint-string-arena-release-for-state!
  [state : TcInlayHintState]) : unit
  (unsafe
    (let
      [data : (MutPtr TcInlayHintStateData) (tc-inlay-hint-state-ptr state)]
      [string-arena : i64 (deref data).string-arena]
      (if (= string-arena 0)
        unit
        (arena.tl_arena_destroy string-arena))
      (set! (deref data).string-arena 0))))

(define (tc-inlay-hints-reset-for-state! [state : TcInlayHintState]) : unit
  (let
    [data : (MutPtr TcInlayHintStateData) (tc-inlay-hint-state-ptr state)]
    ;; Make any strings held in fixed slots unreachable before freeing them.
    (unsafe
      (set! (deref data).enabled false)
      (set! (deref data).count 0))
    (tc-inlay-hint-string-arena-release-for-state! state)))

(define (tc-inlay-hints-enable-for-state! [state : TcInlayHintState]) : unit
  (tc-inlay-hint-storage-ensure-for-state! state)
  ;; Clear the logical range before destroying the prior generation.
  (unsafe
    (set! (deref (tc-inlay-hint-state-ptr state)).count 0))
  (tc-inlay-hint-string-arena-release-for-state! state)
  (unsafe
    (set! (deref (tc-inlay-hint-state-ptr state)).enabled true)))

(define (tc-inlay-hints-disable-for-state! [state : TcInlayHintState]) : unit
  (unsafe
    (set! (deref (tc-inlay-hint-state-ptr state)).enabled false)))

(define (tc-inlay-hints-size-for-state [state : TcInlayHintState]) : i64
  (let
    [count : i64
      (unsafe
        (deref (tc-inlay-hint-state-view state)).count)]
    (if (< count tc-inlay-hint-capacity)
      count
      tc-inlay-hint-capacity)))

(define (tc-inlay-hint-line-at-for-state [state : TcInlayHintState] [i : i64]) : i64
  (array-ref
    (unsafe
      (deref (tc-inlay-hint-state-view state)).lines)
    i))

(define (tc-inlay-hint-col-at-for-state [state : TcInlayHintState] [i : i64]) : i64
  (array-ref
    (unsafe
      (deref (tc-inlay-hint-state-view state)).cols)
    i))

(define (tc-inlay-hint-type-at-for-state [state : TcInlayHintState] [i : i64]) : String
  (array-ref
    (unsafe
      (deref (tc-inlay-hint-state-view state)).types)
    i))

(define (tc-inlay-hint-record-for-state!
  [state : TcInlayHintState]
  [line : i64]
  [col : i64]
  [ty : String]) : unit
  ;; Copy rendered text into this state generation so it survives destruction
  ;; of a transient typecheck/tool arena.
  (let
    [data : TcInlayHintStateData (tc-inlay-hint-state-data state)]
    [slot : i64 (% data.count tc-inlay-hint-capacity)]
    [owner : i64 (tc-inlay-hint-string-arena-ensure-for-state! state)]
    (in-arena
      (arena.Arena owner)
      (set! (array-ref data.lines slot) line)
      (set! (array-ref data.cols slot) col)
      (set! (array-ref data.types slot) (string.copy (& ty))))
    (let
      [latest : (MutPtr TcInlayHintStateData) (tc-inlay-hint-state-ptr state)]
      (unsafe
        (set! (deref latest).count (+ (deref latest).count 1))))))

;; Record the inferred type of an un-annotated let binding value. The explicit
;; form is used by body hot paths; the no-state form remains a test adapter.
(define (tc-inlay-hint-maybe-record-for-state
  [state : TcInlayHintState]
  [maybe-ty : ast.AstMaybeType]
  [init : ast.AstExpr]
  [init-ty : ast.AstType]) : unit
  (match maybe-ty
    [(No)
      (match init
        [(Spanned _ span)
          (tc-inlay-hint-record-for-state!
            state
            (ast.ast-source-span-start-line span)
            (ast.ast-source-span-start-col span)
            (tc-type-render init-ty))]
        [_ unit])]
    [(Some _) unit]))

;; Record the inferred type of any spanned expression for tl/getType.
(define (tc-inlay-hint-maybe-record-expr-for-state
  [state : TcInlayHintState]
  [expr : ast.AstExpr]
  [ty : ast.AstType]) : unit
  (match expr
    [(Spanned _ span)
      (tc-inlay-hint-record-for-state!
        state
        (ast.ast-source-span-start-line span)
        (ast.ast-source-span-start-col span)
        (tc-type-render ty))]
    [_ unit]))

(cfg
  test
  (define tc-let-binding-init-type-call-count : i64
    0))

(cfg
  test
  (define (tc-let-binding-init-type-call-count-for-test) : i64
    tc-let-binding-init-type-call-count))

(define (tc-let-init-contextual-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [init-id : i64]
  [want : ast.AstType]) : ResultTcType
  (let
    [typed : ResultTcType
      (tc-expr-with-expected-or-actual-id ctx env init-id want)]
    (match (tc-global-shared-view typed)
      [(Ok ty)
        (tc-body-let-init-type-record! (tc-context-body-state ctx) init-id ty)]
      [(Err _) unit])
    typed))

(define (tc-let-binding-init-type-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [maybe-ty : ast.AstMaybeType]
  [init-id : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]
  [body : ast.AstExpr]) : ResultTcType
  (begin
    (cfg
      test
      (set!
        tc-let-binding-init-type-call-count
        (+ tc-let-binding-init-type-call-count 1))
      unit)
    (let
      [expr-bases : i64 (tc-context-expr-bases ctx)]
      [init : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases init-id)]
      [ref-capturing-lambda : bool
        (tc-ref-capturing-lambda-init?
          expr-bases
          env
          (tc-global-shared-view init))]
      [copyable-ref-capturing-lambda : bool
        (and
          ref-capturing-lambda
          (not
            (tc-move-only-capturing-lambda-init?
              ctx
              env
              (tc-global-shared-view init))))]
      [move-only-capturing-lambda : bool
        (tc-move-only-capturing-lambda-init?
          ctx
          env
          (tc-global-shared-view init))]
      [consuming-capturing-lambda : bool
        (tc-consuming-capturing-lambda-init?
          ctx
          env
          (tc-global-shared-view init))]
      [capability-capturing-lambda : bool
        (or
          ref-capturing-lambda
          move-only-capturing-lambda
          consuming-capturing-lambda)]
      (match maybe-ty
        [(Some want)
          (let
            [resolved-want : ast.AstType (tc-resolve-type ctx want)]
            (if capability-capturing-lambda
              (let
                [_
                  (try
                    (cond
                      [ref-capturing-lambda
                        (tc-let-binding-ref-closure-scope-ok-at
                          expr-bases
                          bindings
                          index
                          body
                          name
                          copyable-ref-capturing-lambda)]
                      [consuming-capturing-lambda
                        (tc-let-binding-capability-closure-scope-ok-at
                          expr-bases
                          bindings
                          index
                          body
                          name)]
                      [else
                        (tc-let-binding-move-closure-scope-ok-at
                          expr-bases
                          bindings
                          index
                          body
                          name)]))]
                (match (ast.ast-expr-unspan-with-segment-bases
                  expr-bases
                  (& init))
                  [(Lambda lambda-box)
                    (match (__tl-box-place lambda-box)
                      [(Lambda params maybe-ret lambda-body-box)
                        (let
                          [lambda-body : ast.AstExpr
                            (tc-context-expr-get ctx lambda-body-box)]
                          (tc-lambda-expr-allow-ref-captures
                            ctx
                            env
                            params
                            maybe-ret
                            lambda-body))])]
                  [_
                    (tc-let-init-contextual-type ctx env init-id resolved-want)]))
              (tc-let-init-contextual-type ctx env init-id resolved-want)))]
        [(No)
          (if capability-capturing-lambda
            (let
              [_
                (try
                  (cond
                    [ref-capturing-lambda
                      (tc-let-binding-ref-closure-scope-ok-at
                        expr-bases
                        bindings
                        index
                        body
                        name
                        copyable-ref-capturing-lambda)]
                    [consuming-capturing-lambda
                      (tc-let-binding-capability-closure-scope-ok-at
                        expr-bases
                        bindings
                        index
                        body
                        name)]
                    [else
                      (tc-let-binding-move-closure-scope-ok-at
                        expr-bases
                        bindings
                        index
                        body
                        name)]))]
              (match (ast.ast-expr-unspan-with-segment-bases
                expr-bases
                (& init))
                [(Lambda lambda-box)
                  (match (__tl-box-place lambda-box)
                    [(Lambda params maybe-ret lambda-body-box)
                      (let
                        [lambda-body : ast.AstExpr
                          (tc-context-expr-get ctx lambda-body-box)]
                        (tc-lambda-expr-allow-ref-captures
                          ctx
                          env
                          params
                          maybe-ret
                          lambda-body))])]
                [_ (tc-expr-id ctx env init-id)]))
            (tc-expr-id ctx env init-id))]))))

(define (tc-let-bindings-for-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : (& bindings ast.AstLetBindingList)]
  [body-id : i64]
  [body : ast.AstExpr]) : ResultTcEnv
  (tc-let-bindings-for-body-at ctx env (& bindings) body-id body 0))

(define (tc-let-bindings-for-body-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : (& bindings ast.AstLetBindingList)]
  [body-id : i64]
  [body : ast.AstExpr]
  [index : i64]) : ResultTcEnv
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (Ok env)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name maybe-ty init-box)
        (let
          [init : ast.AstExpr (tc-context-expr-get ctx init-box)]
          [init-ty
            (try
              (tc-let-binding-init-type-at
                ctx
                env
                (tc-env-key-name-text-for-session
                  (tc-context-structural-session ctx)
                  name)
                (tc-global-shared-view maybe-ty)
                init-box
                bindings
                (+ index 1)
                (tc-global-shared-view body)))]
          [_
            (try
              (tc-opaque-by-value-ok
                ctx
                (tc-global-shared-view init-ty)
                "cannot hold by value the"))]
          [body-state : TcBodyState (tc-context-body-state ctx)]
          (if body-state.inlay-hint-enabled
            (tc-inlay-hint-maybe-record-for-state
              body-state.inlay-hint-state
              (tc-global-shared-view maybe-ty)
              (tc-global-shared-view init)
              (tc-global-shared-view init-ty))
            unit)
          (match maybe-ty
            [(Some want)
              (let
                [resolved-want : ast.AstType (tc-resolve-type ctx want)]
                [_
                  (try
                    (tc-let-binding-plain-expected-ok
                      ctx
                      env
                      (tc-env-key-name-text-for-session
                        (tc-context-structural-session ctx)
                        name)
                      (Some (tc-global-shared-view resolved-want))
                      (tc-global-shared-view init)
                      (tc-global-shared-view init-ty)))]
                (let
                  [_
                    (try
                      (tc-ensure-cleanup-resource-not-let-bound
                        ctx
                        env
                        (tc-global-shared-view init)))]
                  (let
                    [_
                      (try
                        (tc-ensure-let-value-can-bind
                          ctx
                          env
                          (tc-global-shared-view init)
                          (tc-global-shared-view init-ty)))]
                    [binding-ty : ast.AstType
                      (if (tc-type-contains-any-region
                        (tc-global-shared-view init-ty))
                        init-ty
                        resolved-want)]
                    [facts : TcCheckedLetBindingFactState
                      (tc-job-state-checked-let-binding-facts
                        (tc-context-job-state ctx))]
                    [next-env : TcTypeEnv
                      (if (tc-checked-let-binding-facts-enabled? facts)
                        (let
                          [applied : TcCheckedLetBindingApplied
                            (tc-checked-let-binding-apply
                              ctx
                              env
                              name
                              (tc-global-shared-view binding-ty)
                              init)]
                          (tc-checked-let-binding-fact-record!
                            facts
                            body-id
                            index
                            name
                            init-box
                            binding-ty
                            applied.transition)
                          applied.env)
                        (tc-bind-initialized-value-id
                          ctx
                          env
                          name
                          binding-ty
                          init))]
                    (tc-let-bindings-for-body-at
                      ctx
                      next-env
                      bindings
                      body-id
                      body
                      (+ index 1)))))]
            [(No)
              (let
                [_
                  (try
                    (tc-ensure-cleanup-resource-not-let-bound
                      ctx
                      env
                      (tc-global-shared-view init)))]
                (let
                  [_
                    (try
                      (tc-ensure-let-value-can-bind
                        ctx
                        env
                        (tc-global-shared-view init)
                        (tc-global-shared-view init-ty)))]
                  [binding-ty : ast.AstType init-ty]
                  [facts : TcCheckedLetBindingFactState
                    (tc-job-state-checked-let-binding-facts
                      (tc-context-job-state ctx))]
                  [next-env : TcTypeEnv
                    (if (tc-checked-let-binding-facts-enabled? facts)
                      (let
                        [applied : TcCheckedLetBindingApplied
                          (tc-checked-let-binding-apply
                            ctx
                            env
                            name
                            (tc-global-shared-view binding-ty)
                            init)]
                        (tc-checked-let-binding-fact-record!
                          facts
                          body-id
                          index
                          name
                          init-box
                          binding-ty
                          applied.transition)
                        applied.env)
                      (tc-bind-initialized-value-id
                        ctx
                        env
                        name
                        binding-ty
                        init))]
                  (tc-let-bindings-for-body-at
                    ctx
                    next-env
                    bindings
                    body-id
                    body
                    (+ index 1))))]))])))

(define (tc-resource-cleanup-direct-name-ok
  [expr-bases : i64]
  [cleanup : ast.AstExpr]) : ResultTcUnit
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& cleanup))
    [(Var _) Ok]
    [_
      (Err
        (tc-kind-message
          (ResourceOwnership)
          "typecheck: with cleanup must be a direct function name"))]))

(define (tc-resource-cleanup-resource-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [cleanup : ast.AstExpr]) : ResultTcType
  (let
    [_
      (try
        (tc-resource-cleanup-direct-name-ok
          (tc-context-expr-segment-bases ctx)
          (tc-global-shared-view cleanup)))]
    [cleanup-ty : ast.AstType (try (tc-expr ctx env cleanup))]
    (match (tc-type-strip-region (tc-resolve-type ctx cleanup-ty))
      [(Func args ret)
        (let
          [ret-ty : ast.AstType (ast.ty-node-get ret)]
          [args : ast.AstTypeList (ast.ast-type-list-box-shared-view args)]
          (if (= (ast.ast-type-list-len (& args)) 1)
            (let
              [arg-ty : ast.AstType
                (ast.ty-node-get
                  (ast.ast-type-list-get (& args) 0 (ast.ast-type-id-fallback)))]
              (if (tc-type-eq ret-ty (Unit))
                (Ok arg-ty)
                (Err
                  (tc-kind-message
                    (ResourceOwnership)
                    "typecheck: with cleanup function type mismatch"))))
            (Err
              (tc-kind-message
                (ResourceOwnership)
                "typecheck: with cleanup function type mismatch"))))]
      [_
        (Err
          (tc-kind-message
            (ResourceOwnership)
            "typecheck: with cleanup function type mismatch"))])))

(define (tc-resource-cleanup-ok
  [ctx : TcContext]
  [env : TcTypeEnv]
  [cleanup : ast.AstExpr]
  [resource-ty : ast.AstType]) : ResultTcUnit
  (let
    [cleanup-resource-ty
      (try (tc-resource-cleanup-resource-type ctx env cleanup))]
    (tc-expect
      cleanup-resource-ty
      (tc-type-without-regions resource-ty)
      (tc-kind-message
        (ResourceOwnership)
        "typecheck: with cleanup function type mismatch"))))

(define (tc-resource-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : (& bindings ast.AstResourceBindingList)]) : ResultTcEnv
  (tc-resource-bindings-at ctx env (& bindings) 0))

(define (tc-resource-bindings-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [index : i64]) : ResultTcEnv
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    (Ok env)
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(Binding name init-box cleanup-box _)
        (let
          [init : ast.AstExpr (tc-context-expr-get ctx init-box)]
          [cleanup : ast.AstExpr (tc-context-expr-get ctx cleanup-box)]
          [expected-init-ty
            (try
              (tc-resource-cleanup-resource-type
                ctx
                env
                (tc-global-shared-view cleanup)))]
          [init-ty : ast.AstType
            (try
              (tc-expr-with-expected-or-actual-id
                ctx
                env
                init-box
                expected-init-ty))]
          [_ (try (tc-ensure-cleanup-resource-not-transferred ctx env init))]
          (let
            [_
              (try
                (tc-resource-cleanup-ok
                  ctx
                  env
                  cleanup
                  (tc-global-shared-view init-ty)))]
            (tc-semantic-observe-binding-site! ctx env init-box)
            (tc-resource-bindings-at
              ctx
              (tc-bind-id
                (tc-bind-id env (tc-cleanup-owner-marker-id) (Var name))
                name
                (tc-type-without-regions init-ty))
              bindings
              (+ index 1))))])))

(define (tc-begin-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]) : ResultTcType
  (tc-begin-list-at ctx env (& exprs) 0))

(define (tc-begin-list-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : ResultTcType
  (if (>= index exprs.len)
    (Ok (Unit))
    (if (= (+ index 1) exprs.len)
      (tc-expr-id ctx env (ast.ast-expr-list-get exprs index 0))
      (let
        [_ (try (tc-expr-id ctx env (ast.ast-expr-list-get exprs index 0)))]
        (tc-begin-list-at ctx env exprs (+ index 1))))))

(define (tc-while-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]) : ResultTcType
  (when
    (= exprs.len 0)
    (return
      (Err
        (tc-kind-message
          (ArityMismatch)
          "typecheck: while requires at least one body expression"))))
  (let
    [index : i64 0]
    (while (< index exprs.len)
      (let
        [expr-id : i64 (ast.ast-expr-list-get exprs index 0)]
        [ty : ast.AstType (try (tc-expr-id ctx env expr-id))]
        (match (tc-global-shared-view ty)
          [(or (Unit) (Never)) unit]
          [_
            (match (tc-expect ty (Unit) "typecheck: while body must be unit")
              [(Ok) unit]
              [(Err message)
                (return
                  (Err
                    (tc-locate-error-at-expr
                      (tc-context-expr-bases ctx)
                      (tc-context-expr-get ctx expr-id)
                      message)))])]))
      (set! index (+ index 1)))
    (Ok (Unit))))

;; A body checked against the context's expected type when it has one, and
;; synthesized otherwise.
(define (tc-begin-list-maybe-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [expected : ast.AstMaybeType]) : ResultTcType
  (match expected
    [(Some ty) (tc-begin-list-with-expected ctx env exprs ty)]
    [(No) (tc-begin-list ctx env exprs)]))

(define (tc-spmd-require-uniform [class : TcSpmdClass] [message : String]) : ResultTcUnit
  (if (tc-spmd-varying? class)
    (Err message)
    Ok))

(define (tc-spmd-inline-helper-empty-stack) : TcNameIdList
  Nil)

(define (tc-spmd-inline-helper-stack-for-state [state : TcSpmdTraversalState]) : TcNameIdList
  (unsafe
    (deref (tc-spmd-traversal-state-view state)).inline-helper-stack))

(define (tc-spmd-inline-helper-stack-restore-for-state!
  [state : TcSpmdTraversalState]
  [stack : TcNameIdList]) : unit
  (unsafe
    (set! (deref (tc-spmd-traversal-state-ptr state)).inline-helper-stack stack)))

(define (tc-spmd-inline-helper-stack-push-for-state!
  [state : TcSpmdTraversalState]
  [name-id : i64]) : TcNameIdList
  (let
    [data : TcSpmdTraversalStateData (tc-spmd-traversal-state-data state)]
    [previous : TcNameIdList data.inline-helper-stack]
    ;; The first two names create the persistent dense spine. Allocate that
    ;; store in the compiler job's arena even if traversal currently runs in
    ;; a disposable function scratch arena.
    (set!
      data.inline-helper-stack
      (in-arena
        (arena.Arena data.owner-arena)
        (tc-name-id-list-add previous name-id)))
    (tc-spmd-traversal-state-data-set! state data)
    previous))

(define (tc-spmd-inline-helper-stack-contains-for-state?
  [state : TcSpmdTraversalState]
  [name-id : i64]) : bool
  (tc-name-id-list-contains
    (tc-spmd-inline-helper-stack-for-state state)
    name-id))

(define (tc-spmd-inline-helper-stack-reset-for-state!
  [state : TcSpmdTraversalState]) : unit
  (tc-spmd-inline-helper-stack-restore-for-state!
    state
    (tc-spmd-inline-helper-empty-stack)))

(define (tc-spmd-inline-helper-stack-reset-for-job! [job-state : TcJobState]) : unit
  (tc-spmd-inline-helper-stack-reset-for-state!
    (tc-job-state-spmd-traversal job-state)))

(define (tc-spmd-inline-helper-recursive-message) : String
  (tc-kind-message
    (Spmd)
    "typecheck: recursive SPMD helper call is not supported"))

(define (tc-spmd-inline-helper-resolve-name
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [func : ast.AstExpr]) : TcNameLookup
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-segment-bases ctx)
    (& func))
    [(Var raw-name)
      (let
        [raw-text : String
          (tc-hygiene-name-text-id-for-session
            (tc-context-structural-session ctx)
            raw-name)]
        [source-name-id : i64
          (macro-hygiene-global-source-name-id-or
            (tc-context-structural-session ctx)
            raw-name
            raw-name)]
        (cond
          [(tc-spmd-env-has-local-id? spmd-env raw-name) (Err "")]
          [(tc-hygiene-global-name-id?
              (tc-context-structural-session ctx)
              raw-name)
            (Ok raw-text source-name-id)]
          [(tc-name-qualified-id? (tc-context-structural-session ctx) raw-name)
            (Ok raw-text raw-name)]
          [else
            (tc-source-name-lookup-key-with-field-check-lookup
              ctx
              env
              raw-text
              raw-name
              true)]))]
    [_ (Err "")]))

(define (tc-spmd-inline-helper-from-decl
  [expr-bases : i64]
  [name-id : i64]
  [module-id : i64]
  [decl : ast.AstDecl]) : ResultTcSpmdInlineHelper
  (match decl
    [(DefFn decl-meta _ params ret body-box _)
      (let
        [body : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases body-box)]
        (Ok (Some name-id module-id params ret body)))]
    [(Extern _ _ (Function) metadata ty)
      (match (ast.ast-extern-metadata-imported-spmd
        (ast.ast-extern-metadata-box-shared-view metadata))
        [(No) (Ok (No))]
        [(Package _ _ _ callables) (Ok (Imported ty callables))])]
    [(Unsafe inner-box)
      (let
        [inner : ast.AstDecl (ast.ast-decl-box-shared-view inner-box)]
        (tc-spmd-inline-helper-from-decl expr-bases name-id module-id inner))]
    [_ (Ok (No))]))

(define (tc-spmd-inline-helper-lookup
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [func : ast.AstExpr]) : ResultTcSpmdInlineHelper
  (match (tc-spmd-inline-helper-resolve-name ctx env spmd-env func)
    [(Ok _ lookup-id)
      (if (tc-spmd-inline-helper-stack-contains-for-state?
        (tc-job-state-spmd-traversal (tc-context-job-state ctx))
        lookup-id)
        (Err (tc-spmd-inline-helper-recursive-message))
        (let
          [handle : i64
            (csym.compiler-symbols-lookup-value-id-or
              (tc-context-symbols ctx)
              lookup-id
              (csym.compiler-symbols-missing-handle))]
          (if (csym.compiler-symbols-handle-found? handle)
            (if (or
              (=
                (csym.compiler-symbol-handle-kind handle)
                (csym.compiler-symbol-kind-function-define))
              (=
                (csym.compiler-symbol-handle-kind handle)
                (csym.compiler-symbol-kind-extern)))
              (let
                [declaration-id : i64
                  (csym.compiler-symbol-handle-index handle)]
                [module-id : i64
                  (csym.compiler-symbols-owner-module-id-at-index-or
                    (tc-context-symbols (& ctx))
                    declaration-id
                    (tc-context-module-id ctx))]
                [decl : ast.AstDecl
                  (try
                    (csym.compiler-symbols-decl-at-index
                      (tc-context-symbols (& ctx))
                      declaration-id))]
                (tc-spmd-inline-helper-from-decl
                  expr-bases
                  lookup-id
                  module-id
                  decl))
              (Ok (No)))
            (Ok (No)))))]
    [(Err message)
      (if (string.eq message "")
        (Ok (No))
        (Err message))]))

(define (tc-spmd-inline-helper-module [module-id : i64]) : String
  (if (csym.compiler-symbol-root-module-id? module-id)
    ""
    (tc-env-key-name-text module-id)))

(define (tc-spmd-inline-helper-env
  [ctx : TcContext]
  [fallback : TcTypeEnv]
  [module : String]
  [module-id : i64]) : TcTypeEnv
  (match (tc-hygiene-definition-env-id ctx fallback module module-id)
    [(Ok helper-env) helper-env]
    [(Err _) fallback]))

(define (tc-spmd-inline-helper-arg-role
  [expr-bases : i64]
  [spmd-env : TcSpmdEnv]
  [arg : ast.AstExpr]) : TcSpmdRole
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& arg))
    [(or (Ann inner-box _) (Cast inner-box _))
      (tc-spmd-inline-helper-arg-role
        expr-bases
        spmd-env
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(Var name)
      (match (tc-spmd-env-lookup-id spmd-env name)
        ;; A helper never proves a rank-2 row-major write: its body sees the
        ;; coordinate as a plain varying value.
        [(Found _ _ _ (ForeachCoordinate _ _ _ _)) Value]
        [(Found _ _ _ role) role]
        [(Missing) Value])]
    [_ Value]))

(define (tc-spmd-inline-helper-bind-args
  [ctx : TcContext]
  [expr-bases : i64]
  [caller-env : TcTypeEnv]
  [caller-spmd-env : TcSpmdEnv]
  [func : ast.AstExpr]
  [helper-ctx : TcContext]
  [helper-env : TcTypeEnv]
  [helper-spmd-env : TcSpmdEnv]
  [params : ast.AstParamList]
  [args : ast.AstExprList]
  [seen-class : TcSpmdClass]) : ResultTcSpmdInlineCallState
  (tc-spmd-inline-helper-bind-args-at
    ctx
    expr-bases
    caller-env
    caller-spmd-env
    func
    helper-ctx
    helper-env
    helper-spmd-env
    (& params)
    (& args)
    0
    seen-class))

(define (tc-spmd-inline-helper-bind-args-at
  [ctx : TcContext]
  [expr-bases : i64]
  [caller-env : TcTypeEnv]
  [caller-spmd-env : TcSpmdEnv]
  [func : ast.AstExpr]
  [helper-ctx : TcContext]
  [helper-env : TcTypeEnv]
  [helper-spmd-env : TcSpmdEnv]
  [params : (& params ast.AstParamList)]
  [args : (& args ast.AstExprList)]
  [index : i64]
  [seen-class : TcSpmdClass]) : ResultTcSpmdInlineCallState
  (cond
    [(>= index (ast.ast-param-list-len params))
      (if (>= index args.len)
        (Ok
          (TcSpmdInlineCallState
            caller-spmd-env
            helper-env
            helper-spmd-env
            seen-class))
        (Err
          (tc-call-arity-count-message
            expr-bases
            func
            (ast.ast-param-list-len params)
            args.len)))]
    [(>= index args.len)
      (Err
        (tc-call-arity-count-message
          expr-bases
          func
          (ast.ast-param-list-len params)
          args.len))]
    [else
      (let
        [arg : ast.AstExpr
          (ast.ast-expr-segment-bases-get
            expr-bases
            (ast.ast-expr-list-get args index 0))]
        [arg-info
          (try
            (tc-spmd-expr
              ctx
              expr-bases
              caller-env
              caller-spmd-env
              (tc-global-shared-view arg)))]
        (match arg-info
          [(TcSpmdExprInfo _ arg-class next-caller-spmd-env)
            (match (ast.ast-param-list-get
              params
              index
              (ast.ast-param-fallback))
              [(Param param-name param-ty _)
                (let
                  [bound-ty : ast.AstType
                    (tc-type-strip-invalidate
                      (tc-resolve-type helper-ctx param-ty))]
                  (if (and
                    (tc-spmd-varying? arg-class)
                    (not
                      (tc-spmd-varying-value-type-supported?
                        (tc-global-shared-view bound-ty))))
                    (Err
                      (str_cat.str-cat
                        (cdiag.compiler-diagnostic-typecheck-tag (Spmd))
                        "typecheck: SPMD helper varying parameter type is not supported: "
                        (tc-type-render (tc-type-strip-region bound-ty))))
                    (tc-spmd-inline-helper-bind-args-at
                      ctx
                      expr-bases
                      caller-env
                      next-caller-spmd-env
                      func
                      helper-ctx
                      (tc-bind-id
                        helper-env
                        param-name
                        (tc-global-shared-view bound-ty))
                      (tc-spmd-env-bind-role-id
                        helper-spmd-env
                        param-name
                        bound-ty
                        arg-class
                        Local
                        (tc-spmd-inline-helper-arg-role
                          expr-bases
                          caller-spmd-env
                          arg))
                      params
                      args
                      (+ index 1)
                      (tc-spmd-merge-class seen-class arg-class))))])]))]))

(define (tc-spmd-inline-helper-body
  [ctx : TcContext]
  [expr-bases : i64]
  [helper-env : TcTypeEnv]
  [helper-spmd-env : TcSpmdEnv]
  [name-id : i64]
  [body : ast.AstExpr]) : ResultTcSpmdExprInfo
  (let
    [traversal : TcSpmdTraversalState
      (tc-job-state-spmd-traversal (tc-context-job-state ctx))]
    [previous : TcNameIdList
      (tc-spmd-inline-helper-stack-push-for-state! traversal name-id)]
    [result : ResultTcSpmdExprInfo
      (Err (tc-spmd-inline-helper-recursive-message))]
    (set! result (tc-spmd-expr ctx expr-bases helper-env helper-spmd-env body))
    (tc-spmd-inline-helper-stack-restore-for-state! traversal previous)
    result))

(define (tc-spmd-call-uniform-only
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : ast.AstType]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcSpmdExprInfo
  (let
    [func-info (try (tc-spmd-expr ctx expr-bases env spmd-env func))]
    (match func-info
      [(TcSpmdExprInfo _ _ func-env)
        (let
          [args-info (try (tc-spmd-expr-list ctx expr-bases env func-env args))]
          (match args-info
            [(TcSpmdExprListInfo args-class args-env)
              (let
                [_
                  (try
                    (tc-spmd-require-uniform
                      args-class
                      (tc-kind-message
                        (Spmd)
                        "typecheck: foreach calls with varying arguments are not supported")))]
                (tc-spmd-finish expr-ty Uniform args-env))]))])))

(define (tc-spmd-imported-callable-has-specialization-at?
  [callables : (& callables ast.AstImportedSpmdCallableList)]
  [signature : String]
  [index : i64]) : bool
  (if (>= index (ast.ast-imported-spmd-callable-list-len callables))
    false
    (let
      [callable : ast.AstImportedSpmdCallable
        (ast.ast-imported-spmd-callable-list-get
          callables
          index
          (ast.ast-imported-spmd-callable-fallback))]
      [specializations : ast.AstImportedSpmdSpecializationList
        callable.specializations]
      (or
        (and
          (string.eq (ci.intern-id-str callable.signature) signature)
          (>
            (ast.ast-imported-spmd-specialization-list-len (& specializations))
            0))
        (tc-spmd-imported-callable-has-specialization-at?
          callables
          signature
          (+ index 1))))))

(define (tc-spmd-imported-specializations-have-varying-result-at?
  [specializations : (& specializations ast.AstImportedSpmdSpecializationList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-imported-spmd-specialization-list-len specializations))
    false
    (let
      [item : ast.AstImportedSpmdSpecialization
        (ast.ast-imported-spmd-specialization-list-get
          specializations
          index
          (ast.ast-imported-spmd-specialization-fallback))]
      (or
        (string.eq (ci.intern-id-str item.result) "v")
        (tc-spmd-imported-specializations-have-varying-result-at?
          specializations
          (+ index 1))))))

(define (tc-spmd-imported-callable-has-varying-result-at?
  [callables : (& callables ast.AstImportedSpmdCallableList)]
  [signature : (& signature str)]
  [index : i64]) : bool
  (if (>= index (ast.ast-imported-spmd-callable-list-len callables))
    false
    (let
      [callable : ast.AstImportedSpmdCallable
        (ast.ast-imported-spmd-callable-list-get
          callables
          index
          (ast.ast-imported-spmd-callable-fallback))]
      [specializations : ast.AstImportedSpmdSpecializationList
        callable.specializations]
      (or
        (and
          (string.eq (ci.intern-id-str callable.signature) signature)
          (tc-spmd-imported-specializations-have-varying-result-at?
            (& specializations)
            0))
        (tc-spmd-imported-callable-has-varying-result-at?
          callables
          signature
          (+ index 1))))))

(define (tc-spmd-imported-call-result-class
  [expr-ty : ast.AstType]
  [fn-ty : ast.AstType]
  [callables : (& callables ast.AstImportedSpmdCallableList)]
  [args-class : TcSpmdClass]) : TcSpmdClass
  (cond
    [(not (tc-spmd-varying? args-class)) Uniform]
    [(tc-type-eq (tc-type-without-regions expr-ty) (Unit)) Uniform]
    [else
      (let
        [signature : String (tc-type-render (tc-type-without-regions fn-ty))]
        (cond
          [(tc-spmd-imported-callable-has-varying-result-at?
              callables
              signature
              0)
            Varying]
          [(tc-spmd-imported-callable-has-specialization-at?
              callables
              signature
              0)
            Uniform]
          [else Varying]))]))

(define (tc-spmd-imported-call
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : ast.AstType]
  [fn-ty : ast.AstType]
  [callables : (& callables ast.AstImportedSpmdCallableList)]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcSpmdExprInfo
  (let
    [func-info : TcSpmdExprInfo
      (try (tc-spmd-expr ctx expr-bases env spmd-env func))]
    (match func-info
      [(TcSpmdExprInfo _ _ func-env)
        (let
          [args-info : TcSpmdExprListInfo
            (try (tc-spmd-expr-list ctx expr-bases env func-env args))]
          (match args-info
            [(TcSpmdExprListInfo args-class args-env)
              (tc-spmd-finish-ctx
                ctx
                (tc-global-shared-view expr-ty)
                (tc-spmd-imported-call-result-class
                  expr-ty
                  fn-ty
                  callables
                  args-class)
                args-env)]))])))

(define (tc-spmd-atomic-public-symbol? [symbol : (& symbol str)]) : bool
  (or
    (string.eq symbol "tl_atomic_i64_load")
    (string.eq symbol "tl_atomic_i64_store")
    (string.eq symbol "tl_atomic_i64_add")
    (string.eq symbol "tl_atomic_i64_fetch_add")
    (string.eq symbol "tl_atomic_i32_load")
    (string.eq symbol "tl_atomic_i32_store")
    (string.eq symbol "tl_atomic_i32_add")
    (string.eq symbol "tl_atomic_i32_fetch_add")))

(define (tc-spmd-atomic-public-name? [name : String]) : bool
  (or
    (string.eq name "atomic-i64-load")
    (string.eq name "atomic-i64-store!")
    (string.eq name "atomic-i64-add!")
    (string.eq name "atomic-i64-fetch-add!")
    (string.eq name "atomic-i32-load")
    (string.eq name "atomic-i32-store!")
    (string.eq name "atomic-i32-add!")
    (string.eq name "atomic-i32-fetch-add!")))

(define (tc-spmd-atomic-name-candidate? [name : String]) : bool
  (or
    (tc-spmd-atomic-public-name? (tc-global-shared-view name))
    (tc-spmd-atomic-public-symbol? name)
    (and
      (tc-name-qualified? name)
      (tc-spmd-atomic-public-name? (tc-qualified-name-base name)))))

(define (tc-spmd-atomic-symbol-for-name [name : String]) : String
  (cond
    [(string.eq name "atomic-i64-load") "tl_atomic_i64_load"]
    [(string.eq name "atomic-i64-store!") "tl_atomic_i64_store"]
    [(string.eq name "atomic-i64-add!") "tl_atomic_i64_add"]
    [(string.eq name "atomic-i64-fetch-add!") "tl_atomic_i64_fetch_add"]
    [(string.eq name "atomic-i32-load") "tl_atomic_i32_load"]
    [(string.eq name "atomic-i32-store!") "tl_atomic_i32_store"]
    [(string.eq name "atomic-i32-add!") "tl_atomic_i32_add"]
    [(string.eq name "atomic-i32-fetch-add!") "tl_atomic_i32_fetch_add"]
    [else ""]))

(define (tc-spmd-atomic-import-path? [path : String]) : bool
  (or (string.eq path "stdlib/atomic.tl") (string.eq path "atomic.tl")))

(define (tc-spmd-program-imports-atomic? [decls : ast.AstDeclList]) : bool
  (match (ast.ast-decl-list-step decls)
    [(Nil) false]
    [(Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        (match decl
          [(Import decl-meta (Spec _ path _ _ _))
            (or
              (tc-spmd-atomic-import-path? path)
              (tc-spmd-program-imports-atomic? rest))]
          [_ (tc-spmd-program-imports-atomic? rest)]))]))

(define (tc-spmd-context-imports-atomic? [ctx : TcContext]) : bool
  (let
    [program : ast.AstProgram (tc-context-program ctx)]
    (match program
      [(Program decls-box)
        (tc-spmd-program-imports-atomic?
          (ast.ast-decl-list-box-shared-view decls-box))])))

(define (tc-spmd-atomic-imported-symbol-for-name
  [ctx : TcContext]
  [name : String]) : TcMaybeString
  (if (and
    (tc-spmd-atomic-public-name? (tc-global-shared-view name))
    (tc-spmd-context-imports-atomic? ctx))
    (Some (tc-spmd-atomic-symbol-for-name name))
    (No)))

(define (tc-spmd-atomic-value-result? [symbol : String]) : bool
  (or
    (string.eq symbol "tl_atomic_i64_load")
    (string.eq symbol "tl_atomic_i64_fetch_add")
    (string.eq symbol "tl_atomic_i32_load")
    (string.eq symbol "tl_atomic_i32_fetch_add")))

(define (tc-spmd-atomic-extern-symbol-from-handle
  [symbols : (& symbols csym.CompilerSymbols)]
  [handle : i64]) : TcMaybeString
  (if (=
    (csym.compiler-symbol-handle-kind handle)
    (csym.compiler-symbol-kind-extern))
    (match (csym.compiler-symbols-decl-at-index
      symbols
      (csym.compiler-symbol-handle-index handle))
      [(Ok decl)
        (match decl
          [(Extern decl-meta _ kind metadata _)
            (match kind
              [(Function)
                (let
                  [symbol : String
                    (ast.ast-extern-metadata-symbol (& (deref metadata)))]
                  (if (tc-spmd-atomic-public-symbol? symbol)
                    (Some symbol)
                    (No)))]
              [(Value) (No)])]
          [_ (No)])]
      [(Err _) (No)])
    (No)))

(define (tc-spmd-atomic-extern-symbol-lookup-id
  [symbols : (& symbols csym.CompilerSymbols)]
  [lookup-id : i64]) : TcMaybeString
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-value-id-or
        symbols
        lookup-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (tc-spmd-atomic-extern-symbol-from-handle symbols handle)
      (No))))

(define (tc-spmd-atomic-extern-symbol-for-name-id
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : TcMaybeString
  (if (not (tc-spmd-atomic-name-candidate? (tc-global-shared-view name)))
    (No)
    (let
      [symbols (tc-context-symbols ctx)]
      [direct : TcMaybeString
        (tc-spmd-atomic-extern-symbol-lookup-id symbols name-id)]
      [source-name : String (tc-hygiene-global-symbol-name name)]
      (match direct
        [(Some symbol) (Some symbol)]
        [(No) (tc-spmd-atomic-imported-symbol-for-name ctx source-name)]))))

(define (tc-spmd-atomic-call-symbol
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [func : ast.AstExpr]) : ResultTcString
  (match (tc-spmd-inline-helper-resolve-name ctx env spmd-env func)
    [(Ok lookup-name lookup-id)
      (if (string.eq lookup-name "")
        (Ok "")
        (match (tc-spmd-atomic-extern-symbol-for-name-id
          ctx
          lookup-name
          lookup-id)
          [(Some symbol) (Ok symbol)]
          [(No) (Ok "")]))]
    [(Err message)
      (if (string.eq message "")
        (Ok "")
        (Err message))]))

(define (tc-spmd-atomic-call-with-symbol
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : ast.AstType]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [symbol : String]) : ResultTcSpmdExprInfo
  (let
    [func-info : TcSpmdExprInfo
      (try (tc-spmd-expr ctx expr-bases env spmd-env func))]
    (match func-info
      [(TcSpmdExprInfo _ _ func-env)
        (let
          [args-info : TcSpmdExprListInfo
            (try (tc-spmd-expr-list ctx expr-bases env func-env args))]
          (match args-info
            [(TcSpmdExprListInfo args-class args-env)
              (tc-spmd-finish
                expr-ty
                (if (tc-spmd-atomic-value-result? symbol)
                  args-class
                  Uniform)
                args-env)]))])))

(define (tc-spmd-atomic-call
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : ast.AstType]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcSpmdExprInfo
  (let
    [symbol
      (try
        (tc-spmd-atomic-call-symbol
          ctx
          env
          spmd-env
          (tc-global-shared-view func)))]
    (if (string.eq symbol "")
      (tc-spmd-inline-call ctx expr-bases env spmd-env expr-ty func args)
      (tc-spmd-atomic-call-with-symbol
        ctx
        expr-bases
        env
        spmd-env
        expr-ty
        func
        args
        symbol))))

(define (tc-spmd-inline-call-inner
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : ast.AstType]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcSpmdExprInfo
  (let
    [helper
      (try
        (tc-spmd-inline-helper-lookup
          ctx
          expr-bases
          env
          spmd-env
          (tc-global-shared-view func)))]
    (match helper
      [(Some name-id module-id params _ body)
        (let
          [module : String (tc-spmd-inline-helper-module module-id)]
          [helper-ctx : TcContext
            (tc-context-with-module-id
              ctx
              (tc-global-shared-view module)
              module-id)]
          [base-env : TcTypeEnv
            (tc-spmd-inline-helper-env ctx env module module-id)]
          [base-spmd-env : TcSpmdEnv
            (tc-spmd-env-mark-outer (tc-spmd-env-from-type-env base-env))]
          [call-state
            (try
              (tc-spmd-inline-helper-bind-args
                ctx
                expr-bases
                env
                spmd-env
                func
                helper-ctx
                base-env
                base-spmd-env
                params
                args
                Uniform))]
          (match call-state
            [(TcSpmdInlineCallState
                caller-next
                helper-env
                helper-spmd-env
                args-class)
              (if (tc-spmd-varying? args-class)
                (let
                  [body-info
                    (try
                      (tc-spmd-inline-helper-body
                        helper-ctx
                        expr-bases
                        helper-env
                        helper-spmd-env
                        name-id
                        body))]
                  (match body-info
                    [(TcSpmdExprInfo _ body-class _)
                      (tc-spmd-finish expr-ty body-class caller-next)]))
                (tc-spmd-finish expr-ty Uniform caller-next))]))]
      [(Imported fn-ty callables)
        (let
          [callable-items : ast.AstImportedSpmdCallableList
            (ast.ast-imported-spmd-callable-list-box-shared-view callables)]
          (tc-spmd-imported-call
            ctx
            expr-bases
            env
            spmd-env
            expr-ty
            fn-ty
            (& callable-items)
            func
            args))]
      [(No)
        (tc-spmd-call-uniform-only
          ctx
          expr-bases
          env
          spmd-env
          expr-ty
          func
          args)])))

(define (tc-spmd-inline-call
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : ast.AstType]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcSpmdExprInfo
  (if (tc-type-env-scoped-runtime-active? env)
    (let
      [saved : TcTypeEnvScopedRuntimeSave
        (tc-type-env-scoped-runtime-suspend! env)]
      [result : ResultTcSpmdExprInfo
        (tc-spmd-inline-call-inner
          ctx
          expr-bases
          env
          spmd-env
          expr-ty
          func
          args)]
      (tc-type-env-scoped-runtime-restore! saved)
      result)
    (tc-spmd-inline-call-inner ctx expr-bases env spmd-env expr-ty func args)))

(define (tc-spmd-masked-if-inline-helper-body
  [ctx : TcContext]
  [expr-bases : i64]
  [helper-env : TcTypeEnv]
  [helper-spmd-env : TcSpmdEnv]
  [name-id : i64]
  [body : ast.AstExpr]) : ResultTcUnit
  (let
    [traversal : TcSpmdTraversalState
      (tc-job-state-spmd-traversal (tc-context-job-state ctx))]
    [previous : TcNameIdList
      (tc-spmd-inline-helper-stack-push-for-state! traversal name-id)]
    [result : ResultTcUnit (Err (tc-spmd-inline-helper-recursive-message))]
    (set!
      result
      (tc-spmd-masked-if-expr ctx expr-bases helper-env helper-spmd-env body))
    (tc-spmd-inline-helper-stack-restore-for-state! traversal previous)
    result))

(define (tc-spmd-masked-if-inline-call-inner
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcUnit
  (let
    [helper
      (try
        (tc-spmd-inline-helper-lookup
          ctx
          expr-bases
          env
          spmd-env
          (tc-global-shared-view func)))]
    (match helper
      [(Some name-id module-id params _ body)
        (let
          [module : String (tc-spmd-inline-helper-module module-id)]
          [helper-ctx : TcContext
            (tc-context-with-module-id
              ctx
              (tc-global-shared-view module)
              module-id)]
          [base-env : TcTypeEnv
            (tc-spmd-inline-helper-env ctx env module module-id)]
          [base-spmd-env : TcSpmdEnv
            (tc-spmd-env-mark-outer (tc-spmd-env-from-type-env base-env))]
          [call-state
            (try
              (tc-spmd-inline-helper-bind-args
                ctx
                expr-bases
                env
                spmd-env
                func
                helper-ctx
                base-env
                base-spmd-env
                params
                args
                Uniform))]
          (match call-state
            [(TcSpmdInlineCallState _ helper-env helper-spmd-env _)
              (tc-spmd-masked-if-inline-helper-body
                helper-ctx
                expr-bases
                helper-env
                helper-spmd-env
                name-id
                body)]))]
      [(Imported _ _)
        (tc-spmd-masked-if-expr-list ctx expr-bases env spmd-env args)]
      [(No)
        (tc-spmd-masked-if-unsupported "varying calls inside masked branches")])))

(define (tc-spmd-masked-if-inline-call
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcUnit
  (if (tc-type-env-scoped-runtime-active? env)
    (let
      [saved : TcTypeEnvScopedRuntimeSave
        (tc-type-env-scoped-runtime-suspend! env)]
      [result : ResultTcUnit
        (tc-spmd-masked-if-inline-call-inner
          ctx
          expr-bases
          env
          spmd-env
          func
          args)]
      (tc-type-env-scoped-runtime-restore! saved)
      result)
    (tc-spmd-masked-if-inline-call-inner ctx expr-bases env spmd-env func args)))

(define (tc-spmd-masked-if-call
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [expr : ast.AstExpr]) : ResultTcUnit
  (let
    [symbol
      (try
        (tc-spmd-atomic-call-symbol
          ctx
          env
          spmd-env
          (tc-global-shared-view func)))]
    (if (string.eq symbol "")
      (tc-spmd-masked-if-inline-call ctx expr-bases env spmd-env func args)
      (let
        [_
          (try
            (tc-spmd-atomic-call-with-symbol
              ctx
              expr-bases
              env
              spmd-env
              (match (tc-expr ctx env expr)
                [(Ok ty) ty]
                [(Err _) (Unit)])
              func
              args
              symbol))]
        Ok))))

(define (tc-spmd-masked-if-unsupported [detail : String]) : ResultTcUnit
  (Err
    (str_cat.str-cat
      (cdiag.compiler-diagnostic-typecheck-tag (Spmd))
      "typecheck: SPMD masked if does not support "
      detail)))

(define (tc-spmd-masked-if-result-type-supported? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-global-shared-view ty))
    [(Unit) true]
    [_ (tc-spmd-varying-value-type-supported? ty)]))

(define (tc-spmd-masked-if-result-type-ok [ty : ast.AstType]) : ResultTcUnit
  (if (tc-spmd-masked-if-result-type-supported? (tc-global-shared-view ty))
    Ok
    (Err
      (str_cat.str-cat
        (cdiag.compiler-diagnostic-typecheck-tag (Spmd))
        "typecheck: SPMD masked if result type is not supported: "
        (tc-type-render (tc-type-strip-region ty))))))

(define (tc-spmd-masked-if-index-var? [spmd-env : TcSpmdEnv] [name-id : i64]) : bool
  (match (tc-spmd-env-lookup-id spmd-env name-id)
    [(or (Found _ (Varying) (Local) (ForeachIndex))
         (Found _ (Varying) (Local) (CompactIndex))
         (Found _ (Varying) (Local) (CompactSlot)))
      true]
    [_ false]))

(define (tc-spmd-foreach-write-index-var?
  [spmd-env : TcSpmdEnv]
  [name-id : i64]) : bool
  (match (tc-spmd-env-lookup-id spmd-env name-id)
    [(or (Found _ (Varying) (Local) (ForeachIndex))
         (Found _ (Varying) (Local) (CompactSlot)))
      true]
    [_ false]))

(define (tc-spmd-env-has-compact-slot-at? [bindings : u64] [index : i64]) : bool
  (if (< index 0)
    false
    (match (tc-spmd-binding-at bindings index)
      [(TcSpmdBinding _ _ _ _ role)
        (match role
          [(CompactSlot) true]
          [_ (tc-spmd-env-has-compact-slot-at? bindings (- index 1))])])))

(define (tc-spmd-env-has-compact-slot? [env : TcSpmdEnv]) : bool
  (tc-spmd-env-has-compact-slot-at? env.bindings (- (tc-spmd-env-len env) 1)))

(define (tc-spmd-foreach-index-unsupported [spmd-env : TcSpmdEnv]) : ResultTcUnit
  (if (tc-spmd-env-has-compact-slot? spmd-env)
    (Err
      (tc-kind-message
        (Spmd)
        "typecheck: spmd-compact varying array destination indexes must use the compact slot plus a uniform offset"))
    (Err
      (tc-kind-message
        (Spmd)
        "typecheck: foreach does not support non-contiguous array element destination indexes; use the foreach index plus a uniform offset"))))

(define (tc-spmd-foreach-uniform-offset
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (let
    [info (try (tc-spmd-expr ctx expr-bases env spmd-env expr))]
    (match info
      [(TcSpmdExprInfo _ class _)
        (if (tc-spmd-varying? class)
          (tc-spmd-foreach-index-unsupported spmd-env)
          Ok)])))

(define (tc-spmd-foreach-direct-index
  [expr-bases : i64]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(or (Ann inner-box _) (Cast inner-box _))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-spmd-foreach-direct-index expr-bases spmd-env inner))]
    [(Var name)
      (if (tc-spmd-foreach-write-index-var? spmd-env name)
        Ok
        (tc-spmd-foreach-index-unsupported spmd-env))]
    [_ (tc-spmd-foreach-index-unsupported spmd-env)]))

(define (tc-spmd-foreach-index-rank1
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(or (Ann inner-box _) (Cast inner-box _))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-spmd-foreach-index-rank1 ctx expr-bases env spmd-env inner))]
    [(Binary op left-box right-box)
      (let
        [left : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases left-box)]
        [right : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases right-box)]
        (match op
          [(Add)
            (match (tc-spmd-foreach-direct-index
              expr-bases
              spmd-env
              (tc-global-shared-view left))
              [(Ok)
                (tc-spmd-foreach-uniform-offset
                  ctx
                  expr-bases
                  env
                  spmd-env
                  right)]
              [(Err _)
                (let
                  [_
                    (try
                      (tc-spmd-foreach-direct-index expr-bases spmd-env right))]
                  (tc-spmd-foreach-uniform-offset
                    ctx
                    expr-bases
                    env
                    spmd-env
                    left))])]
          [(Sub)
            (let
              [_ (try (tc-spmd-foreach-direct-index expr-bases spmd-env left))]
              (tc-spmd-foreach-uniform-offset ctx expr-bases env spmd-env right))]
          [_ (tc-spmd-foreach-index-unsupported spmd-env)]))]
    [_
      (tc-spmd-foreach-direct-index
        expr-bases
        spmd-env
        (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr)))]))

;; The latest binding of NAME-ID at or below INDEX, or -1.
(define (tc-spmd-env-latest-index-from
  [bindings : u64]
  [index : i64]
  [name-id : i64]) : i64
  (if (< index 0)
    -1
    (let
      [binding : TcSpmdBinding (tc-spmd-binding-at bindings index)]
      (if (= binding.name name-id)
        index
        (tc-spmd-env-latest-index-from bindings (- index 1) name-id)))))

;; The index of the inner coordinate of the rank-2 domain whose body is being
;; checked, or -1. Entering a nested domain marks the coordinates outer, and a
;; helper body never binds them, so neither sees one.
(define (tc-spmd-env-rank2-inner-from [bindings : u64] [index : i64]) : i64
  (if (< index 0)
    -1
    (let
      [binding : TcSpmdBinding (tc-spmd-binding-at bindings index)]
      (match binding.role
        [(ForeachCoordinate ordinal _ _ _)
          (if (and
            (= ordinal 1)
            (match binding.scope
              [(Local) true]
              [(Outer) false]))
            index
            (tc-spmd-env-rank2-inner-from bindings (- index 1)))]
        [_ (tc-spmd-env-rank2-inner-from bindings (- index 1))]))))

(define (tc-spmd-env-rank2-inner [env : TcSpmdEnv]) : i64
  (tc-spmd-env-rank2-inner-from env.bindings (- (tc-spmd-env-len env) 1)))

(define (tc-spmd-row-major-atom [expr-bases : i64] [expr : ast.AstExpr]) : ast.AstExpr
  (let
    [unspanned : ast.AstExpr
      (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))]
    (match (tc-global-shared-view unspanned)
      [(Ann inner-box _)
        (tc-spmd-row-major-atom
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases inner-box))]
      [_ unspanned])))

;; HEADER-ID when that foreach header bound is an integer literal or a
;; variable BODY never assigns, else -1.
(define (tc-spmd-foreach2-stable-atom
  [expr-bases : i64]
  [header-id : i64]
  [body : ast.AstExpr]) : i64
  (match (tc-spmd-row-major-atom
    expr-bases
    (ast.ast-expr-segment-bases-get expr-bases header-id))
    [(Literal (Int _ _)) header-id]
    [(Var name)
      (if (tc-expr-uses-free-names?
        expr-bases
        body
        (tc-string-list-add Nil (tc-env-key-name-text name))
        Nil
        true)
        -1
        header-id)]
    [_ -1]))

;; True when body expression EXPR denotes the stable header atom HEADER-ID.
;; A variable must resolve below the domain's outer coordinate at OUTER-AT,
;; i.e. to the enclosing binding the header read rather than a body local.
(define (tc-spmd-row-major-atom-eq?
  [expr-bases : i64]
  [spmd-env : TcSpmdEnv]
  [outer-at : i64]
  [expr : ast.AstExpr]
  [header-id : i64]) : bool
  (if (< header-id 0)
    false
    (match (tc-spmd-row-major-atom
      expr-bases
      (ast.ast-expr-segment-bases-get expr-bases header-id))
      [(Literal (Int value _))
        (match (tc-spmd-row-major-atom expr-bases expr)
          [(Literal (Int other _)) (= value other)]
          [_ false])]
      [(Var name)
        (match (tc-spmd-row-major-atom expr-bases expr)
          [(Var other)
            (and
              (= name other)
              (let
                [found : i64
                  (tc-spmd-env-latest-index-from
                    spmd-env.bindings
                    (- (tc-spmd-env-len spmd-env) 1)
                    name)]
                (and (>= found 0) (< found outer-at))))]
          [_ false])]
      [_ false])))

(define (tc-spmd-row-major-zero? [expr-bases : i64] [header-id : i64]) : bool
  (and
    (>= header-id 0)
    (match (tc-spmd-row-major-atom
      expr-bases
      (ast.ast-expr-segment-bases-get expr-bases header-id))
      [(Literal (Int value _)) (= value 0)]
      [_ false])))

;; True when EXPR is the inner span: (- end begin) over the header's stable
;; inner bounds, or bare end when begin is the literal 0.
(define (tc-spmd-row-major-span?
  [expr-bases : i64]
  [spmd-env : TcSpmdEnv]
  [inner-at : i64]
  [expr : ast.AstExpr]) : bool
  (match (tc-spmd-binding-at spmd-env.bindings inner-at)
    [(TcSpmdBinding _ _ _ _ role)
      (match role
        [(ForeachCoordinate _ begin-id end-id _)
          (match (tc-spmd-row-major-atom
            expr-bases
            (tc-global-shared-view expr))
            [(Binary (Sub) left-box right-box)
              (and
                (tc-spmd-row-major-atom-eq?
                  expr-bases
                  spmd-env
                  (- inner-at 1)
                  (ast.ast-expr-segment-bases-get expr-bases left-box)
                  end-id)
                (tc-spmd-row-major-atom-eq?
                  expr-bases
                  spmd-env
                  (- inner-at 1)
                  (ast.ast-expr-segment-bases-get expr-bases right-box)
                  begin-id))]
            [_
              (and
                (tc-spmd-row-major-zero? expr-bases begin-id)
                (tc-spmd-row-major-atom-eq?
                  expr-bases
                  spmd-env
                  (- inner-at 1)
                  expr
                  end-id))])]
        [_ false])]))

(defstruct TcSpmdRowMajorTerms
  (rows i64)
  (columns i64)
  (ok bool))

(define (tc-spmd-row-major-fail) : TcSpmdRowMajorTerms
  (TcSpmdRowMajorTerms 0 0 false))

(define (tc-spmd-row-major-uniform-term
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [inner-at : i64]
  [expr : ast.AstExpr]
  [acc : TcSpmdRowMajorTerms]) : TcSpmdRowMajorTerms
  (match (tc-spmd-expr ctx expr-bases env spmd-env (tc-global-shared-view expr))
    [(Ok (TcSpmdExprInfo _ class _))
      (if (tc-spmd-varying? class)
        (tc-spmd-row-major-fail)
        (let
          [node : ast.AstExpr
            (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))]
          (match (tc-global-shared-view node)
            [(Literal _) acc]
            [(Var name)
              (let
                [found : i64
                  (tc-spmd-env-latest-index-from
                    spmd-env.bindings
                    (- (tc-spmd-env-len spmd-env) 1)
                    name)]
                (if (and (>= found 0) (< found (- inner-at 1)))
                  (match (tc-spmd-binding-at spmd-env.bindings inner-at)
                    [(TcSpmdBinding _ _ _ _ role)
                      (match role
                        [(ForeachCoordinate _ _ _ body-id)
                          (if (tc-expr-uses-free-names?
                            expr-bases
                            (ast.ast-expr-segment-bases-get expr-bases body-id)
                            (tc-string-list-add Nil (tc-env-key-name-text name))
                            Nil
                            true)
                            (tc-spmd-row-major-fail)
                            acc)]
                        [_ (tc-spmd-row-major-fail)])])
                  (tc-spmd-row-major-fail)))]
            [_
              ;; Lane-uniform is insufficient: every offset must stay constant
              ;; across the domain. Closed scalar operations preserve that
              ;; invariant; memory reads and calls require a captured outer value.
              (if (match (tc-global-shared-view node)
                [(or (Unary _ _) (Binary _ _ _) (Cast _ _) (Ann _ _)
                     (MacroExpansion _ _ _))
                  true]
                [_ false])
                (let
                  [children : ast.AstExprList (ast.ast-expr-child-ids node)]
                  [index : i64 0]
                  [result : TcSpmdRowMajorTerms acc]
                  (while (and
                    result.ok
                    (< index (ast.ast-expr-list-len (& children))))
                    (set!
                      result
                      (tc-spmd-row-major-uniform-term
                        ctx
                        expr-bases
                        env
                        spmd-env
                        inner-at
                        (ast.ast-expr-segment-bases-get
                          expr-bases
                          (ast.ast-expr-list-get (& children) index -1))
                        result))
                    (set! index (+ index 1)))
                  result)
                (tc-spmd-row-major-fail))])))]
    [(Err _) (tc-spmd-row-major-fail)]))

;; Count the coordinate terms of the additive tree EXPR, whose terms have
;; sign POSITIVE?. At the top level a term is the inner coordinate, a row
;; product, or a uniform value; inside a row factor (FACTOR?) it is the outer
;; coordinate or a uniform value. A coordinate must appear with positive sign
;; and nowhere else, so any other term fails the proof.
(define (tc-spmd-row-major-terms
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [inner-at : i64]
  [expr : ast.AstExpr]
  [positive? : bool]
  [factor? : bool]
  [acc : TcSpmdRowMajorTerms]) : TcSpmdRowMajorTerms
  (if (not acc.ok)
    acc
    (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
      [(Ann inner-box _)
        (tc-spmd-row-major-terms
          ctx
          expr-bases
          env
          spmd-env
          inner-at
          (ast.ast-expr-segment-bases-get expr-bases inner-box)
          positive?
          factor?
          acc)]
      [(Binary op left-box right-box)
        (let
          [left : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases left-box)]
          [right : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases right-box)]
          (match op
            [(Add)
              (tc-spmd-row-major-terms
                ctx
                expr-bases
                env
                spmd-env
                inner-at
                right
                positive?
                factor?
                (tc-spmd-row-major-terms
                  ctx
                  expr-bases
                  env
                  spmd-env
                  inner-at
                  left
                  positive?
                  factor?
                  acc))]
            [(Sub)
              (tc-spmd-row-major-terms
                ctx
                expr-bases
                env
                spmd-env
                inner-at
                right
                (not positive?)
                factor?
                (tc-spmd-row-major-terms
                  ctx
                  expr-bases
                  env
                  spmd-env
                  inner-at
                  left
                  positive?
                  factor?
                  acc))]
            [(Mul)
              (let
                [uniform : TcSpmdRowMajorTerms
                  (tc-spmd-row-major-uniform-term
                    ctx
                    expr-bases
                    env
                    spmd-env
                    inner-at
                    (tc-global-shared-view expr)
                    acc)]
                (cond
                  [uniform.ok uniform]
                  [(and
                      positive?
                      (not factor?)
                      (or
                        (and
                          (tc-spmd-row-major-span?
                            expr-bases
                            spmd-env
                            inner-at
                            (tc-global-shared-view left))
                          (tc-spmd-row-major-row-factor?
                            ctx
                            expr-bases
                            env
                            spmd-env
                            inner-at
                            (tc-global-shared-view right)))
                        (and
                          (tc-spmd-row-major-span?
                            expr-bases
                            spmd-env
                            inner-at
                            (tc-global-shared-view right))
                          (tc-spmd-row-major-row-factor?
                            ctx
                            expr-bases
                            env
                            spmd-env
                            inner-at
                            (tc-global-shared-view left)))))
                    (TcSpmdRowMajorTerms (+ acc.rows 1) acc.columns true)]
                  [else (tc-spmd-row-major-fail)]))]
            [_
              (tc-spmd-row-major-uniform-term
                ctx
                expr-bases
                env
                spmd-env
                inner-at
                expr
                acc)]))]
      [(Var name)
        (match (tc-spmd-env-lookup-id spmd-env name)
          [(Found _ (Varying) (Local) (ForeachCoordinate ordinal _ _ _))
            (cond
              [(not positive?) (tc-spmd-row-major-fail)]
              [(and factor? (= ordinal 0))
                (TcSpmdRowMajorTerms (+ acc.rows 1) acc.columns true)]
              [(and (not factor?) (= ordinal 1))
                (TcSpmdRowMajorTerms acc.rows (+ acc.columns 1) true)]
              [else (tc-spmd-row-major-fail)])]
          [_
            (tc-spmd-row-major-uniform-term
              ctx
              expr-bases
              env
              spmd-env
              inner-at
              expr
              acc)])]
      [_
        (tc-spmd-row-major-uniform-term
          ctx
          expr-bases
          env
          spmd-env
          inner-at
          expr
          acc)])))

;; True when EXPR is the outer coordinate plus uniform offsets.
(define (tc-spmd-row-major-row-factor?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [inner-at : i64]
  [expr : ast.AstExpr]) : bool
  (let
    [terms : TcSpmdRowMajorTerms
      (tc-spmd-row-major-terms
        ctx
        expr-bases
        env
        spmd-env
        inner-at
        expr
        true
        true
        (TcSpmdRowMajorTerms 0 0 true))]
    (and terms.ok (= terms.rows 1) (= terms.columns 0))))

;; A rank-2 index is injective over the whole domain when it is
;; U + (y - A) * S + (x - B) for constant uniform U, A and B and S the exact inner
;; span: the checked domain product keeps (y - y0) * S + (x - x0) in
;; [0, rows * S), and adding a constant modulo 2^64 preserves injectivity.
;; Additive terms may appear in any order and grouping.
(define (tc-spmd-row-major-index?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [inner-at : i64]
  [expr : ast.AstExpr]) : bool
  (let
    [terms : TcSpmdRowMajorTerms
      (tc-spmd-row-major-terms
        ctx
        expr-bases
        env
        spmd-env
        inner-at
        expr
        true
        false
        (TcSpmdRowMajorTerms 0 0 true))]
    (and terms.ok (= terms.rows 1) (= terms.columns 1))))

(define (tc-spmd-foreach-index
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (let
    [inner-at : i64 (tc-spmd-env-rank2-inner spmd-env)]
    (cond
      [(< inner-at 0)
        (tc-spmd-foreach-index-rank1 ctx expr-bases env spmd-env expr)]
      [(tc-spmd-row-major-index? ctx expr-bases env spmd-env inner-at expr) Ok]
      [else
        (Err
          (tc-kind-message
            (Spmd)
            "typecheck: rank-2 foreach array element destination indexes must be row-major with stable uniform offsets: base + (y - y0) * (x1 - x0) + (x - x0) over the coordinates and the header's inner bounds"))])))

(define (tc-spmd-masked-if-uniform-offset
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (let
    [info (try (tc-spmd-expr ctx expr-bases env spmd-env expr))]
    (match info
      [(TcSpmdExprInfo _ class _)
        (if (tc-spmd-varying? class)
          (tc-spmd-masked-if-unsupported
            "gather/scatter-like array indexes; use the foreach index plus a uniform offset")
          Ok)])))

(define (tc-spmd-masked-if-direct-index
  [expr-bases : i64]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(or (Ann inner-box _) (Cast inner-box _))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-spmd-masked-if-direct-index expr-bases spmd-env inner))]
    [(Var name)
      (if (tc-spmd-masked-if-index-var? spmd-env name)
        Ok
        (tc-spmd-masked-if-unsupported
          "gather/scatter-like array indexes; use the foreach index plus a uniform offset"))]
    [_
      (tc-spmd-masked-if-unsupported
        "gather/scatter-like array indexes; use the foreach index plus a uniform offset")]))

(define (tc-spmd-masked-if-index-rank1
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(or (Ann inner-box _) (Cast inner-box _))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-spmd-masked-if-index-rank1 ctx expr-bases env spmd-env inner))]
    [(Binary op left-box right-box)
      (let
        [left : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases left-box)]
        [right : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases right-box)]
        (match op
          [(Add)
            (match (tc-spmd-masked-if-direct-index
              expr-bases
              spmd-env
              (tc-global-shared-view left))
              [(Ok)
                (tc-spmd-masked-if-uniform-offset
                  ctx
                  expr-bases
                  env
                  spmd-env
                  right)]
              [(Err _)
                (let
                  [_
                    (try
                      (tc-spmd-masked-if-direct-index expr-bases spmd-env right))]
                  (tc-spmd-masked-if-uniform-offset
                    ctx
                    expr-bases
                    env
                    spmd-env
                    left))])]
          [(Sub)
            (let
              [_
                (try (tc-spmd-masked-if-direct-index expr-bases spmd-env left))]
              (tc-spmd-masked-if-uniform-offset
                ctx
                expr-bases
                env
                spmd-env
                right))]
          [_
            (tc-spmd-masked-if-unsupported
              "gather/scatter-like array indexes; use the foreach index plus a uniform offset")]))]
    [_
      (tc-spmd-masked-if-direct-index
        expr-bases
        spmd-env
        (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr)))]))

(define (tc-spmd-masked-if-index
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (let
    [inner-at : i64 (tc-spmd-env-rank2-inner spmd-env)]
    (cond
      [(< inner-at 0)
        (tc-spmd-masked-if-index-rank1 ctx expr-bases env spmd-env expr)]
      [(tc-spmd-row-major-index? ctx expr-bases env spmd-env inner-at expr) Ok]
      [else
        (tc-spmd-masked-if-unsupported
          "rank-2 array indexes other than the row-major form with stable uniform offsets: base + (y - y0) * (x1 - x0) + (x - x0)")])))

(define (tc-spmd-masked-if-lane-type-ok [ty : ast.AstType]) : ResultTcUnit
  (if (tc-spmd-lane-type-supported? (tc-global-shared-view ty))
    Ok
    (Err
      (str_cat.str-cat
        (cdiag.compiler-diagnostic-typecheck-tag (Spmd))
        "typecheck: SPMD masked if lane type is not supported: "
        (tc-type-render (tc-type-strip-region ty))))))

(define (tc-spmd-masked-if-expr-list
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [exprs : ast.AstExprList]) : ResultTcUnit
  (tc-spmd-masked-if-expr-list-at ctx expr-bases env spmd-env (& exprs) 0))

(define (tc-spmd-masked-if-expr-list-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : ResultTcUnit
  (if (>= index exprs.len)
    Ok
    (let
      [_
        (try
          (tc-spmd-masked-if-expr
            ctx
            expr-bases
            env
            spmd-env
            (ast.ast-expr-segment-bases-get
              expr-bases
              (ast.ast-expr-list-get exprs index 0))))]
      (tc-spmd-masked-if-expr-list-at
        ctx
        expr-bases
        env
        spmd-env
        exprs
        (+ index 1)))))

(define (tc-spmd-masked-if-let-bindings
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [bindings : ast.AstLetBindingList]
  [mark : TcSpmdEnvMark]) : ResultTcSpmdLetState
  (tc-spmd-masked-if-let-bindings-at
    ctx
    expr-bases
    env
    spmd-env
    (& bindings)
    mark
    0))

(define (tc-spmd-masked-if-let-bindings-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [bindings : (& bindings ast.AstLetBindingList)]
  [mark : TcSpmdEnvMark]
  [index : i64]) : ResultTcSpmdLetState
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (Ok (TcSpmdLetState env spmd-env mark))
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name maybe-ty init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [_
            (try
              (tc-spmd-masked-if-expr
                ctx
                expr-bases
                env
                spmd-env
                (tc-global-shared-view init)))]
          [info : TcSpmdExprInfo
            (try (tc-spmd-expr ctx expr-bases env spmd-env init))]
          (match info
            [(TcSpmdExprInfo init-ty init-class next-spmd-env)
              (let
                [_semantic-site : unit
                  (tc-semantic-observe-binding-site! ctx env init-box)]
                [bound-ty : ast.AstType
                  (match maybe-ty
                    [(Some want)
                      (if (tc-type-contains-any-region
                        (tc-global-shared-view init-ty))
                        init-ty
                        (tc-resolve-type ctx want))]
                    [(No) init-ty])]
                (tc-spmd-masked-if-let-bindings-at
                  ctx
                  expr-bases
                  (tc-bind-id env name (tc-global-shared-view bound-ty))
                  (tc-spmd-env-bind-id
                    next-spmd-env
                    name
                    bound-ty
                    init-class
                    Local)
                  bindings
                  mark
                  (+ index 1)))]))])))

(define (tc-spmd-masked-if-expr
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (tc-semantic-spmd
    ctx
    env
    (tc-spmd-masked-if-expr-unspanned
      ctx
      expr-bases
      env
      spmd-env
      (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr)))))

(define (tc-spmd-masked-if-expr-unspanned
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match (tc-global-shared-view expr)
    [(or (Literal _) (Var _) (TypeLiteral _) (SpmdProgramIndex)
         (SpmdProgramCount))
      Ok]
    [(or (Ann inner-box _) (Cast inner-box _) (Unary _ inner-box))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-spmd-masked-if-expr ctx expr-bases env spmd-env inner))]
    [(Binary _ left-box right-box)
      (let
        [left : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases left-box)]
        [right : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases right-box)]
        [_ (try (tc-spmd-masked-if-expr ctx expr-bases env spmd-env left))]
        (tc-spmd-masked-if-expr ctx expr-bases env spmd-env right))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [state
              (try
                (tc-spmd-masked-if-let-bindings
                  ctx
                  expr-bases
                  env
                  spmd-env
                  bindings
                  (tc-spmd-env-mark spmd-env)))]
            (match state
              [(TcSpmdLetState body-env body-spmd-env _)
                (tc-spmd-masked-if-expr
                  ctx
                  expr-bases
                  body-env
                  body-spmd-env
                  body)]))])]
    [(If cond-box then-box else-box)
      (let
        [cond : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases cond-box)]
        [then-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases then-box)]
        [else-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases else-box)]
        [_ (try (tc-spmd-masked-if-expr ctx expr-bases env spmd-env cond))]
        (let
          [_
            (try
              (tc-spmd-masked-if-expr ctx expr-bases env spmd-env then-branch))]
          (tc-spmd-masked-if-expr ctx expr-bases env spmd-env else-branch)))]
    [(Begin exprs)
      (tc-spmd-masked-if-expr-list ctx expr-bases env spmd-env exprs)]
    [(ArrayRef array-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        [_ (try (tc-spmd-masked-if-expr ctx expr-bases env spmd-env array))]
        (let
          [_ (try (tc-spmd-masked-if-index ctx expr-bases env spmd-env index))]
          [ty (try (tc-expr ctx env expr))]
          (tc-spmd-masked-if-lane-type-ok ty)))]
    [(ArraySet array-box index-box value-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [_ (try (tc-spmd-masked-if-expr ctx expr-bases env spmd-env array))]
        (let
          [_ (try (tc-spmd-masked-if-index ctx expr-bases env spmd-env index))]
          (let
            [_
              (try
                (tc-spmd-masked-if-expr
                  ctx
                  expr-bases
                  env
                  spmd-env
                  (tc-global-shared-view value)))]
            [ty (try (tc-expr ctx env value))]
            (tc-spmd-masked-if-lane-type-ok ty))))]
    [(ArrayTake _ _ _)
      (Err
        "typecheck: __tl_array-take! is not supported in masked spmd control flow")]
    [(Replace _ _)
      (Err "typecheck: replace! is not supported in masked spmd control flow")]
    [(StructSet receiver-box _ value-box)
      (let
        [receiver : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases receiver-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [_ (try (tc-spmd-masked-if-expr ctx expr-bases env spmd-env receiver))]
        (let
          [_
            (try
              (tc-spmd-masked-if-expr
                ctx
                expr-bases
                env
                spmd-env
                (tc-global-shared-view value)))]
          [ty (try (tc-expr ctx env value))]
          (tc-spmd-masked-if-lane-type-ok ty)))]
    [(Call func-box args)
      (let
        [func : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases func-box)]
        (tc-spmd-masked-if-call ctx expr-bases env spmd-env func args expr))]
    [(Syscall _)
      (tc-spmd-masked-if-unsupported "varying calls inside masked branches")]
    [(While cond-box body-box)
      (let
        [cond : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases cond-box)]
        [body : ast.AstExpr (Begin body-box)]
        [_
          (try
            (tc-spmd-masked-if-expr
              ctx
              expr-bases
              env
              spmd-env
              (tc-global-shared-view cond)))]
        [cond-info (try (tc-spmd-expr ctx expr-bases env spmd-env cond))]
        (match cond-info
          [(TcSpmdExprInfo _ cond-class cond-env)
            (if (tc-spmd-varying? cond-class)
              (tc-spmd-masked-if-expr ctx expr-bases env cond-env body)
              (tc-spmd-masked-if-unsupported
                "uniform while inside masked branches"))]))]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match scrutinee-box arms)
          (tc-spmd-masked-if-match
            ctx
            expr-bases
            env
            spmd-env
            (ast.ast-expr-segment-bases-get expr-bases scrutinee-box)
            arms)])]
    [(Foreach _)
      (tc-spmd-masked-if-unsupported "nested foreach inside masked branches")]
    ;; Serializing the active lanes of a masked branch is foreach-active's main
    ;; use: the body is checked as scalar code, like anywhere else in a gang.
    [(ForeachActive lane body-box)
      (let
        [_
          (try
            (tc-spmd-foreach-active
              ctx
              expr-bases
              env
              spmd-env
              lane
              (ast.ast-expr-segment-bases-get expr-bases body-box)))]
        Ok)]
    [(SpmdReduce _)
      (tc-spmd-masked-if-unsupported
        "nested spmd-reduce inside masked branches")]
    [(SpmdScan _)
      (tc-spmd-masked-if-unsupported "nested spmd-scan inside masked branches")]
    [(SpmdCompact _)
      (tc-spmd-masked-if-unsupported
        "nested spmd-compact inside masked branches")]
    [(SpmdBroadcast _ _)
      (tc-spmd-masked-if-unsupported "spmd-broadcast inside masked branches")]
    [(SpmdShuffle _ _)
      (tc-spmd-masked-if-unsupported "spmd-shuffle inside masked branches")]
    [(or (Set _ _) (ArrayPush _ _) (BoxSet _ _) (PtrWrite _ _))
      (tc-spmd-masked-if-unsupported
        "side effects other than contiguous array writes inside masked branches")]
    [(or (FixedMakeArray _ _) (MakeArray _ _) (Array _) (DynArray _) (Box _)
         (WithRegion _ _) (WithEscape _ _) (WithScratch _) (InArena _ _))
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [(BoxTake _)
      (tc-spmd-masked-if-unsupported "move from Box inside masked branches")]
    [_
      (tc-spmd-masked-if-unsupported
        "this branch shape in the masked-control-flow subset")]))

(define (tc-spmd-masked-if
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : ast.AstType]
  [then-branch : ast.AstExpr]
  [else-branch : ast.AstExpr]) : ResultTcSpmdExprInfo
  (let
    [_ (try (tc-spmd-masked-if-result-type-ok (tc-global-shared-view expr-ty)))]
    (let
      [_ (try (tc-spmd-masked-if-expr ctx expr-bases env spmd-env then-branch))]
      (let
        [_
          (try (tc-spmd-masked-if-expr ctx expr-bases env spmd-env else-branch))]
        (match (tc-type-strip-region (tc-global-shared-view expr-ty))
          [(Unit) (tc-spmd-finish expr-ty Uniform spmd-env)]
          [_ (tc-spmd-finish expr-ty Varying spmd-env)])))))

(define (tc-spmd-let-bindings
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [bindings : ast.AstLetBindingList]
  [mark : TcSpmdEnvMark]) : ResultTcSpmdLetState
  (tc-spmd-let-bindings-at ctx expr-bases env spmd-env (& bindings) mark 0))

(define (tc-spmd-let-bindings-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [bindings : (& bindings ast.AstLetBindingList)]
  [mark : TcSpmdEnvMark]
  [index : i64]) : ResultTcSpmdLetState
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (Ok (TcSpmdLetState env spmd-env mark))
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name maybe-ty init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [info : TcSpmdExprInfo
            (try (tc-spmd-expr ctx expr-bases env spmd-env init))]
          (match info
            [(TcSpmdExprInfo init-ty init-class next-spmd-env)
              (let
                [_semantic-site : unit
                  (tc-semantic-observe-binding-site! ctx env init-box)]
                [bound-ty : ast.AstType
                  (match maybe-ty
                    [(Some want)
                      (if (tc-type-contains-any-region
                        (tc-global-shared-view init-ty))
                        init-ty
                        (tc-resolve-type ctx want))]
                    [(No) init-ty])]
                (tc-spmd-let-bindings-at
                  ctx
                  expr-bases
                  (tc-bind-id env name (tc-global-shared-view bound-ty))
                  (tc-spmd-env-bind-id
                    next-spmd-env
                    name
                    bound-ty
                    init-class
                    Local)
                  bindings
                  mark
                  (+ index 1)))]))])))

(define (tc-spmd-expr-list
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [exprs : ast.AstExprList]) : ResultTcSpmdExprListInfo
  (tc-spmd-expr-list-at ctx expr-bases env spmd-env (& exprs) 0))

(define (tc-spmd-expr-list-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : ResultTcSpmdExprListInfo
  (if (>= index exprs.len)
    (Ok (TcSpmdExprListInfo Uniform spmd-env))
    (let
      [expr : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get exprs index 0))]
      [info : TcSpmdExprInfo
        (try (tc-spmd-expr ctx expr-bases env spmd-env expr))]
      (match info
        [(TcSpmdExprInfo _ class next-spmd-env)
          (let
            [rest-info : TcSpmdExprListInfo
              (try
                (tc-spmd-expr-list-at
                  ctx
                  expr-bases
                  env
                  next-spmd-env
                  exprs
                  (+ index 1)))]
            (match rest-info
              [(TcSpmdExprListInfo rest-class rest-env)
                (Ok
                  (TcSpmdExprListInfo
                    (tc-spmd-merge-class class rest-class)
                    rest-env))]))]))))

(define (tc-spmd-begin-list
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [exprs : ast.AstExprList]) : ResultTcSpmdExprInfo
  (tc-spmd-begin-list-at ctx expr-bases env spmd-env (& exprs) 0))

(define (tc-spmd-begin-list-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : ResultTcSpmdExprInfo
  (if (>= index exprs.len)
    (Ok (TcSpmdExprInfo (ast.AstType.Unit) Uniform spmd-env))
    (let
      [expr : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get exprs index 0))]
      (if (= (+ index 1) exprs.len)
        (tc-spmd-expr ctx expr-bases env spmd-env expr)
        (let
          [info : TcSpmdExprInfo
            (try (tc-spmd-expr ctx expr-bases env spmd-env expr))]
          (match info
            [(TcSpmdExprInfo _ _ next-spmd-env)
              (tc-spmd-begin-list-at
                ctx
                expr-bases
                env
                next-spmd-env
                exprs
                (+ index 1))]))))))

(define (tc-spmd-match-pattern-binding-supported?
  [class : TcSpmdClass]
  [ty : ast.AstType]) : bool
  (if (tc-spmd-varying? class)
    (tc-spmd-lane-type-supported? ty)
    true))

(define (tc-spmd-match-pattern-binding-diagnostic [ty : ast.AstType]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (Spmd))
    "typecheck: foreach varying match pattern binding type is not supported: "
    (tc-type-render (tc-type-strip-region ty))))

(define (tc-spmd-pattern-bound-names
  [ctx : TcContext]
  [scrut-ty : ast.AstType]
  [pattern : ast.AstPattern]) : TcNameIdList
  (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
    [(or (ast.AstType.Enum _) (ast.AstType.EnumArgs _ _))
      (tc-enum-arm-pattern-bound-name-ids pattern TcNameIdList.Nil)]
    [_ (tc-pattern-add-bound-name-ids pattern TcNameIdList.Nil)]))

;; The names an enum match arm's pattern binds: a variant pattern's payload
;; binders, and for an or-pattern those of every alternative. A bare name at
;; the top of an enum arm is a nullary variant, not a binder.
(define (tc-enum-arm-pattern-bound-name-ids
  [pattern : ast.AstPattern]
  [bound : TcNameIdList]) : TcNameIdList
  (match pattern
    [(ast.AstPattern.Variant _ args-box)
      (tc-pattern-list-add-bound-name-ids
        (ast.ast-pattern-list-box-shared-view args-box)
        bound)]
    [(ast.AstPattern.Or alternatives-box)
      (let
        [alternatives : ast.AstPatternList
          (ast.ast-pattern-list-box-shared-view alternatives-box)]
        [out : TcNameIdList bound]
        [index : i64 0]
        (while (< index alternatives.len)
          (set!
            out
            (tc-enum-arm-pattern-bound-name-ids
              (ast.ast-pattern-list-get
                (& alternatives)
                index
                (ast.ast-pattern-fallback))
              out))
          (set! index (+ index 1)))
        out)]
    [_ bound]))

(define (tc-spmd-match-bind-pattern-names
  [arm-env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [names : TcNameIdList]
  [class : TcSpmdClass]) : ResultTcSpmdEnv
  (if (tc-name-id-list-empty? names)
    (Ok spmd-env)
    (let
      [name-id : i64 (tc-name-id-list-head names)]
      [ty : ast.AstType (try (tc-lookup-id arm-env name-id))]
      (if (tc-spmd-match-pattern-binding-supported?
        class
        (tc-global-shared-view ty))
        (tc-spmd-match-bind-pattern-names
          arm-env
          (tc-spmd-env-bind-id spmd-env name-id ty class Local)
          (tc-name-id-list-rest names)
          class)
        (Err (tc-spmd-match-pattern-binding-diagnostic ty))))))

;; Lane-masked lowering of a varying `match` tests each arm's single pattern,
;; so an or-pattern there is rejected rather than lowered.
(define (tc-spmd-bind-match-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : ast.AstType]
  [scrut-class : TcSpmdClass]
  [pattern : ast.AstPattern]) : ResultTcEnv
  (if (and
    (tc-spmd-varying? scrut-class)
    (tc-pattern-contains-or? (tc-global-shared-view pattern)))
    (ResultTcEnv.Err
      (tc-kind-message
        (cdiag.CompilerTypecheckKind.Spmd)
        "typecheck: foreach varying match does not support or-patterns"))
    (tc-bind-match-pattern ctx env scrut-ty pattern)))

(define (tc-pattern-contains-or? [pattern : ast.AstPattern]) : bool
  (match pattern
    [(ast.AstPattern.Or _) true]
    [(or (ast.AstPattern.Variant _ items-box) (ast.AstPattern.Tuple items-box)
         (ast.AstPattern.Array items-box) (ast.AstPattern.Slice items-box _)
         (ast.AstPattern.Fields items-box) (ast.AstPattern.Field _ items-box))
      (tc-pattern-list-contains-or?
        (ast.ast-pattern-list-box-shared-view items-box))]
    [_ false]))

(define (tc-pattern-list-contains-or? [patterns : ast.AstPatternList]) : bool
  (let
    [index : i64 0]
    (while (< index patterns.len)
      (when
        (tc-pattern-contains-or?
          (ast.ast-pattern-list-get
            (& patterns)
            index
            (ast.ast-pattern-fallback)))
        (return true))
      (set! index (+ index 1)))
    false))

(define (tc-spmd-masked-if-match-arms
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [scrut-ty : ast.AstType]
  [scrut-class : TcSpmdClass]
  [arms : ast.AstMatchArmList]) : ResultTcUnit
  (tc-spmd-masked-if-match-arms-at
    ctx
    expr-bases
    env
    spmd-env
    scrut-ty
    scrut-class
    (& arms)
    0))

(define (tc-spmd-masked-if-match-arms-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [scrut-ty : ast.AstType]
  [scrut-class : TcSpmdClass]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : ResultTcUnit
  (if (>= index arms.len)
    Ok
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          [arm-env
            (try
              (tc-spmd-bind-match-pattern
                ctx
                env
                (tc-global-shared-view scrut-ty)
                scrut-class
                (tc-global-shared-view pattern)))]
          [arm-spmd-env
            (try
              (tc-spmd-match-bind-pattern-names
                arm-env
                spmd-env
                (tc-spmd-pattern-bound-names
                  ctx
                  (tc-global-shared-view scrut-ty)
                  pattern)
                scrut-class))]
          [_
            (try
              (tc-spmd-masked-if-expr ctx expr-bases arm-env arm-spmd-env body))]
          (tc-spmd-masked-if-match-arms-at
            ctx
            expr-bases
            env
            spmd-env
            scrut-ty
            scrut-class
            arms
            (+ index 1)))])))

(define (tc-spmd-masked-if-match
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [scrutinee : ast.AstExpr]
  [arms : ast.AstMatchArmList]) : ResultTcUnit
  (let
    [_
      (try
        (tc-spmd-masked-if-expr
          ctx
          expr-bases
          env
          spmd-env
          (tc-global-shared-view scrutinee)))]
    [scrut-info (try (tc-spmd-expr ctx expr-bases env spmd-env scrutinee))]
    (match scrut-info
      [(TcSpmdExprInfo scrut-ty scrut-class scrut-env)
        (tc-spmd-masked-if-match-arms
          ctx
          expr-bases
          env
          scrut-env
          scrut-ty
          scrut-class
          arms)])))

(define (tc-spmd-match-arms
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [scrut-ty : ast.AstType]
  [scrut-class : TcSpmdClass]
  [arms : ast.AstMatchArmList]
  [class : TcSpmdClass]) : ResultTcSpmdExprListInfo
  (tc-spmd-match-arms-at
    ctx
    expr-bases
    env
    spmd-env
    scrut-ty
    scrut-class
    (& arms)
    class
    0))

(define (tc-spmd-match-arms-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [scrut-ty : ast.AstType]
  [scrut-class : TcSpmdClass]
  [arms : (& arms ast.AstMatchArmList)]
  [class : TcSpmdClass]
  [index : i64]) : ResultTcSpmdExprListInfo
  (if (>= index arms.len)
    (Ok (TcSpmdExprListInfo class spmd-env))
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          [mark : TcSpmdEnvMark (tc-spmd-env-mark spmd-env)]
          [arm-env
            (try
              (tc-spmd-bind-match-pattern
                ctx
                env
                (tc-global-shared-view scrut-ty)
                scrut-class
                (tc-global-shared-view pattern)))]
          [arm-spmd-env
            (try
              (tc-spmd-match-bind-pattern-names
                arm-env
                spmd-env
                (tc-spmd-pattern-bound-names
                  ctx
                  (tc-global-shared-view scrut-ty)
                  pattern)
                scrut-class))]
          [body-info : TcSpmdExprInfo
            (try (tc-spmd-expr ctx expr-bases arm-env arm-spmd-env body))]
          (match body-info
            [(TcSpmdExprInfo _ body-class body-env)
              (let
                [rest-info : TcSpmdExprListInfo
                  (try
                    (tc-spmd-match-arms-at
                      ctx
                      expr-bases
                      env
                      spmd-env
                      scrut-ty
                      scrut-class
                      arms
                      (tc-spmd-merge-class class body-class)
                      (+ index 1)))]
                (match rest-info
                  [(TcSpmdExprListInfo rest-class rest-env)
                    (Ok
                      (TcSpmdExprListInfo
                        rest-class
                        (tc-spmd-env-merge-classes
                          (tc-spmd-env-restore body-env mark)
                          rest-env)))]))]))])))

(define (tc-spmd-check-foreach-body-with-env
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [index-id : i64]
  [index-ty : ast.AstType]
  [body : ast.AstExpr]) : ResultTcUnit
  (let
    [body-env : TcTypeEnv
      (tc-bind-id env index-id (tc-global-shared-view index-ty))]
    [body-spmd-env : TcSpmdEnv
      (tc-spmd-env-bind-role-id
        (tc-spmd-env-mark-outer spmd-env)
        index-id
        index-ty
        Varying
        Local
        ForeachIndex)]
    [result : ResultTcUnit Ok]
    (tc-spmd-inline-helper-stack-reset-for-job! (tc-context-job-state ctx))
    (set!
      result
      (match (tc-spmd-expr ctx expr-bases body-env body-spmd-env body)
        [(Ok _) Ok]
        [(Err message) (Err message)]))
    (tc-spmd-inline-helper-stack-reset-for-job! (tc-context-job-state ctx))
    result))

;; Check a rank-2 domain's BODY with both coordinates bound read-only and
;; varying: in scalar order every (outer, inner) pair is its own logical
;; instance. The inner coordinate's role carries the stable header bounds
;; INNER-BEGIN-ID and INNER-END-ID, plus the domain body id, for the proof.
(define (tc-spmd-check-foreach2-body-with-env
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [outer : i64]
  [inner : i64]
  [inner-begin-id : i64]
  [inner-end-id : i64]
  [body-id : i64]) : ResultTcUnit
  (let
    [body : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases body-id)]
    [body-env : TcTypeEnv (tc-bind-id (tc-bind-id env outer (I64)) inner (I64))]
    [inner-role : TcSpmdRole
      (ForeachCoordinate
        1
        (tc-spmd-foreach2-stable-atom
          expr-bases
          inner-begin-id
          (tc-global-shared-view body))
        (tc-spmd-foreach2-stable-atom
          expr-bases
          inner-end-id
          (tc-global-shared-view body))
        body-id)]
    [body-spmd-env : TcSpmdEnv
      (tc-spmd-env-bind-role-id
        (tc-spmd-env-bind-role-id
          (tc-spmd-env-mark-outer spmd-env)
          outer
          (I64)
          Varying
          Local
          (ForeachCoordinate 0 -1 -1 body-id))
        inner
        (I64)
        Varying
        Local
        inner-role)]
    [result : ResultTcUnit Ok]
    (tc-spmd-inline-helper-stack-reset-for-job! (tc-context-job-state ctx))
    (set!
      result
      (match (tc-spmd-expr ctx expr-bases body-env body-spmd-env body)
        [(Ok _) Ok]
        [(Err message) (Err message)]))
    (tc-spmd-inline-helper-stack-reset-for-job! (tc-context-job-state ctx))
    result))

(define (tc-spmd-check-foreach-body
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [index-id : i64]
  [index-ty : ast.AstType]
  [body : ast.AstExpr]) : ResultTcUnit
  (tc-spmd-check-foreach-body-with-env
    ctx
    expr-bases
    env
    (tc-spmd-env-from-type-env env)
    index-id
    index-ty
    body))

(define (tc-spmd-scan-body-no-nested-list
  [expr-bases : i64]
  [exprs : ast.AstExprList]) : ResultTcUnit
  (tc-spmd-scan-body-no-nested-list-at expr-bases (& exprs) 0))

(define (tc-spmd-scan-body-no-nested-list-at
  [expr-bases : i64]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : ResultTcUnit
  (if (>= index exprs.len)
    Ok
    (let
      [_
        (try
          (tc-spmd-scan-body-no-nested-spmd
            expr-bases
            (ast.ast-expr-segment-bases-get
              expr-bases
              (ast.ast-expr-list-get exprs index 0))))]
      (tc-spmd-scan-body-no-nested-list-at expr-bases exprs (+ index 1)))))

(define (tc-spmd-scan-body-no-nested-pair
  [expr-bases : i64]
  [left : ast.AstExpr]
  [right : ast.AstExpr]) : ResultTcUnit
  (let
    [_ (try (tc-spmd-scan-body-no-nested-spmd expr-bases left))]
    (tc-spmd-scan-body-no-nested-spmd expr-bases right)))

(define (tc-spmd-scan-body-no-nested-spmd
  [expr-bases : i64]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(TupleRef tuple-box index-box)
      (tc-spmd-scan-body-no-nested-pair
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases tuple-box)
        (ast.ast-expr-segment-bases-get expr-bases index-box))]
    [(Foreach _)
      (Err
        (tc-kind-message
          (Spmd)
          "typecheck: nested foreach inside spmd-scan is not supported"))]
    [(SpmdReduce _)
      (Err
        (tc-kind-message
          (Spmd)
          "typecheck: nested spmd-reduce inside spmd-scan is not supported"))]
    [(SpmdScan _)
      (Err
        (tc-kind-message
          (Spmd)
          "typecheck: nested spmd-scan inside spmd-scan is not supported"))]
    [(SpmdCompact _)
      (Err
        (tc-kind-message
          (Spmd)
          "typecheck: nested spmd-compact inside spmd-scan is not supported"))]
    [(SpmdProgramIndex)
      (Err
        (tc-kind-message
          (Spmd)
          "typecheck: program-index is not supported inside spmd-scan body"))]
    [(SpmdProgramCount)
      (Err
        (tc-kind-message
          (Spmd)
          "typecheck: program-count is not supported inside spmd-scan body"))]
    [(ForeachActive _ _)
      (Err
        (tc-kind-message
          (Spmd)
          "typecheck: foreach-active is not supported inside spmd-scan body"))]
    [(or (Quote _) (Quasiquote _) (PtrAddrOf _) (Spanned _ _)
         (MacroExpansion _ _ _) (ForOwnedState _) (ForOwnedStep _))
      Ok]
    [_
      (tc-spmd-scan-body-no-nested-list
        expr-bases
        (ast.ast-expr-child-ids
          (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))))]))

(define (tc-spmd-check-scan-body
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [index-id : i64]
  [index-ty : ast.AstType]
  [prefix-id : i64]
  [prefix-ty : ast.AstType]
  [body : ast.AstExpr]) : ResultTcUnit
  (let
    [index-env : TcTypeEnv
      (tc-bind-id env index-id (tc-global-shared-view index-ty))]
    [body-env : TcTypeEnv
      (tc-bind-id index-env prefix-id (tc-global-shared-view prefix-ty))]
    [base-spmd-env : TcSpmdEnv
      (tc-spmd-env-mark-outer (tc-spmd-env-from-type-env env))]
    [index-spmd-env : TcSpmdEnv
      (tc-spmd-env-bind-role-id
        base-spmd-env
        index-id
        index-ty
        Varying
        Local
        ForeachIndex)]
    [body-spmd-env : TcSpmdEnv
      (tc-spmd-env-bind-id index-spmd-env prefix-id prefix-ty Varying Local)]
    [result : ResultTcUnit Ok]
    [_
      (try
        (tc-spmd-scan-body-no-nested-spmd
          expr-bases
          (tc-global-shared-view body)))]
    (tc-spmd-inline-helper-stack-reset-for-job! (tc-context-job-state ctx))
    (set!
      result
      (match (tc-spmd-expr ctx expr-bases body-env body-spmd-env body)
        [(Ok _) Ok]
        [(Err message) (Err message)]))
    (tc-spmd-inline-helper-stack-reset-for-job! (tc-context-job-state ctx))
    result))

(define (tc-spmd-check-compact
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [index-id : i64]
  [index-ty : ast.AstType]
  [slot-id : i64]
  [slot-ty : ast.AstType]
  [keep : ast.AstExpr]
  [body : ast.AstExpr]) : ResultTcUnit
  (let
    [index-env : TcTypeEnv
      (tc-bind-id env index-id (tc-global-shared-view index-ty))]
    [body-env : TcTypeEnv
      (tc-bind-id index-env slot-id (tc-global-shared-view slot-ty))]
    [base-spmd-env : TcSpmdEnv
      (tc-spmd-env-mark-outer (tc-spmd-env-from-type-env env))]
    ;; The logical input index may participate in reads and predicates, but it
    ;; must not authorize compact destination writes. Only the slot receives
    ;; the dedicated write-index role.
    [index-spmd-env : TcSpmdEnv
      (tc-spmd-env-bind-role-id
        base-spmd-env
        index-id
        index-ty
        Varying
        Local
        CompactIndex)]
    [body-spmd-env : TcSpmdEnv
      (tc-spmd-env-bind-role-id
        index-spmd-env
        slot-id
        slot-ty
        Varying
        Local
        CompactSlot)]
    [result : ResultTcUnit Ok]
    (tc-spmd-inline-helper-stack-reset-for-job! (tc-context-job-state ctx))
    (set!
      result
      (match (tc-spmd-masked-if-expr
        ctx
        expr-bases
        index-env
        index-spmd-env
        (tc-global-shared-view keep))
        [(Ok)
          (match (tc-spmd-expr ctx expr-bases index-env index-spmd-env keep)
            [(Ok _)
              (match (tc-spmd-expr ctx expr-bases body-env body-spmd-env body)
                [(Ok _) Ok]
                [(Err message) (Err message)])]
            [(Err message) (Err message)])]
        [(Err message) (Err message)]))
    (tc-spmd-inline-helper-stack-reset-for-job! (tc-context-job-state ctx))
    result))

;; `spmd-reduce` allows varying bool values for `all`/`any`, so it cannot reuse
;; the full foreach body checker: that checker applies foreach array-lane
;; restrictions to the entire expression. This path only classifies the reduce
;; value enough to enforce nested cross-lane value/lane rules.
(define (tc-spmd-reduce-class-finish
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]
  [class : TcSpmdClass]) : ResultTcSpmdExprInfo
  (let
    [ty : ast.AstType (try (tc-expr ctx env expr))]
    (tc-spmd-finish ty class spmd-env)))

(define (tc-spmd-reduce-class-with-expected-or-actual
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcSpmdExprInfo
  (tc-semantic-spmd
    ctx
    env
    (match (tc-spmd-reduce-class
      ctx
      expr-bases
      env
      spmd-env
      (tc-global-shared-view expr))
      [(Ok info)
        (match info
          [(TcSpmdExprInfo _ class next-spmd-env)
            (match (tc-expr-with-expected-or-actual ctx env expr expected)
              [(Ok ty) (tc-spmd-finish ty class next-spmd-env)]
              [(Err message) (ResultTcSpmdExprInfo.Err message)])])]
      [(Err message) (ResultTcSpmdExprInfo.Err message)])))

(define (tc-spmd-reduce-let-bindings
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [bindings : ast.AstLetBindingList]
  [mark : TcSpmdEnvMark]) : ResultTcSpmdLetState
  (tc-spmd-reduce-let-bindings-at
    ctx
    expr-bases
    env
    spmd-env
    (& bindings)
    mark
    0))

(define (tc-spmd-reduce-let-bindings-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [bindings : (& bindings ast.AstLetBindingList)]
  [mark : TcSpmdEnvMark]
  [index : i64]) : ResultTcSpmdLetState
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (Ok (TcSpmdLetState env spmd-env mark))
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name maybe-ty init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [info : TcSpmdExprInfo
            (try (tc-spmd-reduce-class ctx expr-bases env spmd-env init))]
          (match info
            [(TcSpmdExprInfo init-ty init-class next-spmd-env)
              (let
                [_semantic-site : unit
                  (tc-semantic-observe-binding-site! ctx env init-box)]
                [bound-ty : ast.AstType
                  (match maybe-ty
                    [(Some want)
                      (if (tc-type-contains-any-region
                        (tc-global-shared-view init-ty))
                        init-ty
                        (tc-resolve-type ctx want))]
                    [(No) init-ty])]
                (tc-spmd-reduce-let-bindings-at
                  ctx
                  expr-bases
                  (tc-bind-id env name (tc-global-shared-view bound-ty))
                  (tc-spmd-env-bind-id
                    next-spmd-env
                    name
                    bound-ty
                    init-class
                    Local)
                  bindings
                  mark
                  (+ index 1)))]))])))

(define (tc-spmd-reduce-class
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcSpmdExprInfo
  (tc-semantic-spmd
    ctx
    env
    (tc-spmd-reduce-class-unspanned
      ctx
      expr-bases
      env
      spmd-env
      (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr)))))

(define (tc-spmd-reduce-class-unspanned
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcSpmdExprInfo
  (match (tc-global-shared-view expr)
    [(or (Literal _) (SpmdProgramCount))
      (tc-spmd-reduce-class-finish ctx env spmd-env expr Uniform)]
    [(SpmdProgramIndex)
      (tc-spmd-reduce-class-finish ctx env spmd-env expr Varying)]
    [(Var name)
      (if (tc-dotted-place-name-id? ctx env name)
        (let
          [virtual-id
            (try
              (tc-dotted-local-field-expr-id-after-check
                (tc-context-structural-session ctx)
                name))]
          (tc-spmd-reduce-class
            ctx
            expr-bases
            env
            spmd-env
            (ast.ast-expr-segment-bases-get expr-bases virtual-id)))
        (match (tc-spmd-env-lookup-id spmd-env name)
          [(Found _ class _ _)
            (tc-spmd-reduce-class-finish ctx env spmd-env expr class)]
          [(Missing)
            (tc-spmd-reduce-class-finish ctx env spmd-env expr Uniform)]))]
    [(Binary _ left-box right-box)
      (let
        [left : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases left-box)]
        [right : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases right-box)]
        [left-info : TcSpmdExprInfo
          (try (tc-spmd-reduce-class ctx expr-bases env spmd-env left))]
        (match left-info
          [(TcSpmdExprInfo _ left-class left-env)
            (let
              [right-info : TcSpmdExprInfo
                (try (tc-spmd-reduce-class ctx expr-bases env left-env right))]
              (match right-info
                [(TcSpmdExprInfo _ right-class right-env)
                  (tc-spmd-reduce-class-finish
                    ctx
                    env
                    right-env
                    expr
                    (tc-spmd-merge-class left-class right-class))]))]))]
    [(or (Unary _ inner-box) (Ann inner-box _) (Cast inner-box _))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        [info : TcSpmdExprInfo
          (try (tc-spmd-reduce-class ctx expr-bases env spmd-env inner))]
        (match info
          [(TcSpmdExprInfo _ class next-spmd-env)
            (tc-spmd-reduce-class-finish ctx env next-spmd-env expr class)]))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [state
              (try
                (tc-spmd-reduce-let-bindings
                  ctx
                  expr-bases
                  env
                  spmd-env
                  bindings
                  (tc-spmd-env-mark spmd-env)))]
            (match state
              [(TcSpmdLetState body-env body-spmd-env mark)
                (let
                  [body-info : TcSpmdExprInfo
                    (try
                      (tc-spmd-reduce-class
                        ctx
                        expr-bases
                        body-env
                        body-spmd-env
                        body))]
                  (match body-info
                    [(TcSpmdExprInfo _ body-class final-spmd-env)
                      (tc-spmd-reduce-class-finish
                        ctx
                        env
                        (tc-spmd-env-restore final-spmd-env mark)
                        expr
                        body-class)]))]))])]
    [(ArrayRef array-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        [array-info : TcSpmdExprInfo
          (try (tc-spmd-reduce-class ctx expr-bases env spmd-env array))]
        (match array-info
          [(TcSpmdExprInfo _ array-class array-env)
            (let
              [index-info : TcSpmdExprInfo
                (try (tc-spmd-reduce-class ctx expr-bases env array-env index))]
              (match index-info
                [(TcSpmdExprInfo _ index-class index-env)
                  (tc-spmd-reduce-class-finish
                    ctx
                    env
                    index-env
                    expr
                    (tc-spmd-merge-class array-class index-class))]))]))]
    [(SpmdBroadcast value-box lane-box)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [lane : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases lane-box)]
        [value-info : TcSpmdExprInfo
          (try (tc-spmd-reduce-class ctx expr-bases env spmd-env value))]
        (match value-info
          [(TcSpmdExprInfo _ value-class value-env)
            (let
              [lane-info : TcSpmdExprInfo
                (try
                  (tc-spmd-reduce-class-with-expected-or-actual
                    ctx
                    expr-bases
                    env
                    value-env
                    lane
                    (I64)))]
              (match lane-info
                [(TcSpmdExprInfo lane-ty lane-class lane-env)
                  (let
                    [expr-ty : ast.AstType (try (tc-expr ctx env expr))]
                    (tc-spmd-broadcast-finish
                      ctx
                      expr-ty
                      value-class
                      lane-ty
                      lane-class
                      lane-env))]))]))]
    [(SpmdShuffle value-box lane-box)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [lane : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases lane-box)]
        [value-info : TcSpmdExprInfo
          (try (tc-spmd-reduce-class ctx expr-bases env spmd-env value))]
        (match value-info
          [(TcSpmdExprInfo _ value-class value-env)
            (let
              [lane-info : TcSpmdExprInfo
                (try
                  (tc-spmd-reduce-class-with-expected-or-actual
                    ctx
                    expr-bases
                    env
                    value-env
                    lane
                    (I64)))]
              (match lane-info
                [(TcSpmdExprInfo lane-ty _ lane-env)
                  (let
                    [expr-ty : ast.AstType (try (tc-expr ctx env expr))]
                    (tc-spmd-shuffle-finish
                      ctx
                      expr-ty
                      value-class
                      lane-ty
                      lane-env))]))]))]
    [_ (tc-spmd-reduce-class-finish ctx env spmd-env expr Uniform)]))

(define (tc-spmd-check-reduce-value-broadcasts
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [index-id : i64]
  [index-ty : ast.AstType]
  [value : ast.AstExpr]) : ResultTcUnit
  (let
    [value-env : TcTypeEnv
      (tc-bind-id env index-id (tc-global-shared-view index-ty))]
    [value-spmd-env : TcSpmdEnv
      (tc-spmd-env-bind-role-id
        (tc-spmd-env-mark-outer (tc-spmd-env-from-type-env env))
        index-id
        index-ty
        Varying
        Local
        ForeachIndex)]
    [_
      (try (tc-spmd-reduce-class ctx expr-bases value-env value-spmd-env value))]
    Ok))

(define (tc-spmd-expr
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcSpmdExprInfo
  (tc-semantic-spmd
    ctx
    env
    (match (tc-expr ctx env (tc-global-shared-view expr))
      [(Ok ty) (tc-spmd-expr-typed ctx expr-bases env spmd-env expr ty)]
      [(Err message) (ResultTcSpmdExprInfo.Err message)])))

(define (tc-spmd-expr-with-expected-or-actual
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcSpmdExprInfo
  (tc-semantic-spmd
    ctx
    env
    (match (tc-expr-with-expected-or-actual
      ctx
      env
      (tc-global-shared-view expr)
      expected)
      [(Ok ty) (tc-spmd-expr-typed ctx expr-bases env spmd-env expr ty)]
      [(Err message) (ResultTcSpmdExprInfo.Err message)])))

(define (tc-spmd-array-value-expr
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [array-ty : ast.AstType]
  [value : ast.AstExpr]) : ResultTcSpmdExprInfo
  (match (tc-type-strip-region (tc-resolve-type ctx array-ty))
    [(Array elem-ty _)
      (tc-spmd-expr-with-expected-or-actual
        ctx
        expr-bases
        env
        spmd-env
        value
        (ast.ty-node-get elem-ty))]
    [(DynArray elem-ty)
      (tc-spmd-expr-with-expected-or-actual
        ctx
        expr-bases
        env
        spmd-env
        value
        (ast.ty-node-get elem-ty))]
    [_ (tc-spmd-expr ctx expr-bases env spmd-env value)]))

(define (tc-spmd-array-length-call?
  [expr-bases : i64]
  [session : cis.InternStructuralSessionHandle]
  [func : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& func))
    [(Var raw-name)
      (let
        [hygiene-global : bool (tc-hygiene-global-name-id? session raw-name)]
        [name-id : i64
          (tc-builtin-call-name-id session raw-name hygiene-global)]
        (cbi.compiler-builtin-typecheck-array-length-id? name-id))]
    [_ false]))

(define (tc-spmd-array-length-call
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : ast.AstType]
  [args : ast.AstExprList]) : ResultTcSpmdExprInfo
  (let
    [info : TcSpmdExprListInfo
      (try (tc-spmd-expr-list ctx expr-bases env spmd-env args))]
    (match info
      [(TcSpmdExprListInfo class next-env)
        (tc-spmd-finish expr-ty class next-env)])))

(define (tc-spmd-for-owned-state
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [source-name : i64]
  [index-name : i64]
  [source : i64]
  [body : i64]
  [expr-ty : ast.AstType]) : ResultTcSpmdExprInfo
  (let
    [source-expr : ast.AstExpr
      (ast.ast-expr-segment-bases-get expr-bases source)]
    [body-expr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases body)]
    [source-name-id : i64 (tc-for-owned-name-id expr-bases source-name)]
    [index-name-id : i64 (tc-for-owned-name-id expr-bases index-name)]
    [source-info : TcSpmdExprInfo
      (try (tc-spmd-expr ctx expr-bases env spmd-env source-expr))]
    (match source-info
      [(TcSpmdExprInfo source-ty source-class source-env)
        (let
          [mark : TcSpmdEnvMark (tc-spmd-env-mark source-env)]
          [body-env : TcTypeEnv
            (tc-bind-id
              (tc-bind-id env source-name-id (tc-global-shared-view source-ty))
              index-name-id
              (I64))]
          [body-spmd-env : TcSpmdEnv
            (tc-spmd-env-bind-id
              (tc-spmd-env-bind-id
                source-env
                source-name-id
                source-ty
                source-class
                Local)
              index-name-id
              (I64)
              Uniform
              Local)]
          [body-info : TcSpmdExprInfo
            (try (tc-spmd-expr ctx expr-bases body-env body-spmd-env body-expr))]
          (match body-info
            [(TcSpmdExprInfo _ body-class final-env)
              (tc-spmd-finish
                expr-ty
                body-class
                (tc-spmd-env-restore final-env mark))]))])))

(define (tc-spmd-for-owned-step-body
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [binding-name : i64]
  [body : i64]
  [elem-ty : ast.AstType]
  [item-class : TcSpmdClass]
  [expr-ty : ast.AstType]) : ResultTcSpmdExprInfo
  (let
    [binding-name-id : i64 (tc-for-owned-name-id expr-bases binding-name)]
    [mark : TcSpmdEnvMark (tc-spmd-env-mark spmd-env)]
    [body-env : TcTypeEnv
      (tc-bind-id env binding-name-id (tc-global-shared-view elem-ty))]
    [body-spmd-env : TcSpmdEnv
      (tc-spmd-env-bind-id spmd-env binding-name-id elem-ty item-class Local)]
    [body-expr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases body)]
    [body-info : TcSpmdExprInfo
      (try (tc-spmd-expr ctx expr-bases body-env body-spmd-env body-expr))]
    (match body-info
      [(TcSpmdExprInfo _ body-class final-env)
        (tc-spmd-finish expr-ty body-class (tc-spmd-env-restore final-env mark))])))

(define (tc-spmd-for-owned-step
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [source-name : i64]
  [index-name : i64]
  [binding-name : i64]
  [done-name : i64]
  [body : i64]
  [expr-ty : ast.AstType]) : ResultTcSpmdExprInfo
  (let
    [source-expr : ast.AstExpr
      (ast.ast-expr-segment-bases-get expr-bases source-name)]
    [index-expr : ast.AstExpr
      (ast.ast-expr-segment-bases-get expr-bases index-name)]
    [done-expr : ast.AstExpr
      (ast.ast-expr-segment-bases-get expr-bases done-name)]
    [source-info : TcSpmdExprInfo
      (try (tc-spmd-expr ctx expr-bases env spmd-env source-expr))]
    (match source-info
      [(TcSpmdExprInfo source-ty source-class source-env)
        (let
          [index-info : TcSpmdExprInfo
            (try (tc-spmd-expr ctx expr-bases env source-env index-expr))]
          (match index-info
            [(TcSpmdExprInfo _ index-class index-env)
              (let
                [done-info : TcSpmdExprInfo
                  (try (tc-spmd-expr ctx expr-bases env index-env done-expr))]
                (match done-info
                  [(TcSpmdExprInfo _ done-class done-env)
                    (match (tc-type-strip-region
                      (tc-resolve-type ctx source-ty))
                      [(Array elem-id _)
                        (tc-spmd-for-owned-step-body
                          ctx
                          expr-bases
                          env
                          done-env
                          binding-name
                          body
                          (tc-context-type-get ctx elem-id)
                          (tc-spmd-merge-class
                            source-class
                            (tc-spmd-merge-class index-class done-class))
                          expr-ty)]
                      [_
                        (Err
                          "typecheck: scalar for owned step requires fixed-array state")])]))]))])))

;; --- foreach-active (#8306) ---
(define (tc-spmd-active-hidden-message [name-id : i64]) : String
  (str_cat.str-cat
    (tc-kind-message (Spmd) "typecheck: foreach-active body reads varying `")
    (tc-env-key-name-text name-id)
    "`; read it with (lane-value "
    (tc-env-key-name-text name-id)
    ")"))

(define (tc-spmd-active-hidden-opaque-message [name-id : i64]) : String
  (str_cat.str-cat
    (tc-kind-message
      (Spmd)
      "typecheck: foreach-active body reads gang-local value `")
    (tc-env-key-name-text name-id)
    "`, which is not a scalar lane value and can carry per-lane state such as a captured varying value; bind it outside the foreach or inside the body"))

(define (tc-spmd-active-unsupported-message [what : String]) : String
  (str_cat.str-cat
    (tc-kind-message (Spmd) "typecheck: ")
    what
    " inside foreach-active is not supported"))

(define (tc-spmd-active-lambda-capture-from
  [expr-bases : i64]
  [spmd-env : TcSpmdEnv]
  [index : i64]
  [below-barrier : bool]
  [lambda : ast.AstExpr]) : ResultTcUnit
  (if (< index 0)
    Ok
    (let
      [binding : TcSpmdBinding (tc-spmd-binding-at spmd-env.bindings index)]
      (match binding.role
        [(LaneValueOpen) Ok]
        [(ActiveBarrier)
          (tc-spmd-active-lambda-capture-from
            expr-bases
            spmd-env
            (- index 1)
            true
            lambda)]
        [_
          (if (and
            below-barrier
            (tc-spmd-env-hidden-id? spmd-env binding.name)
            (tc-expr-uses-free-name?
              expr-bases
              (tc-global-shared-view lambda)
              (tc-env-key-name-text binding.name)
              Nil))
            (Err
              (if (tc-spmd-varying? binding.class)
                (str_cat.str-cat
                  (tc-kind-message
                    (Spmd)
                    "typecheck: a lambda inside foreach-active cannot capture varying `")
                  (tc-env-key-name-text binding.name)
                  "`; read it with lane-value outside the lambda")
                (tc-spmd-active-hidden-opaque-message binding.name)))
            (tc-spmd-active-lambda-capture-from
              expr-bases
              spmd-env
              (- index 1)
              below-barrier
              lambda))]))))

;; A lambda in a foreach-active body must not capture a binding the body can
;; read only through lane-value.
(define (tc-spmd-active-lambda-capture-ok
  [expr-bases : i64]
  [spmd-env : TcSpmdEnv]
  [lambda : ast.AstExpr]) : ResultTcUnit
  (if (tc-spmd-env-in-active-body? spmd-env)
    (tc-spmd-active-lambda-capture-from
      expr-bases
      spmd-env
      (- (tc-spmd-env-len spmd-env) 1)
      false
      lambda)
    Ok))

;; Check a foreach-active body inside a foreach gang. LANE is a uniform,
;; read-only i64; varying bindings from outside the body are hidden behind a
;; barrier, so the body is scalar code that may write shared state. The body
;; runs zero or more times, so the gang environment after it merges the
;; classes before and after.
(define (tc-spmd-foreach-active
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [lane : i64]
  [body : ast.AstExpr]) : ResultTcSpmdEnv
  (if (tc-spmd-env-in-active-body? spmd-env)
    (Err (tc-spmd-foreach-active-scope-message tc-spmd-scope-active))
    (let
      [_semantic-site : unit
        (when
          (and
            (> tc-semantic-observed-jobs 0)
            (!= (tc-context-semantic-observer ctx).address 0))
          (tc-semantic-observer-send!
            (tc-context-semantic-observer ctx)
            ctx
            env
            (BindingSite
              (tc-expr-maybe-span expr-bases (tc-global-shared-view body)))))]
      [mark : TcSpmdEnvMark (tc-spmd-env-mark spmd-env)]
      [body-spmd-env : TcSpmdEnv
        (tc-spmd-env-bind-role-id
          (tc-spmd-env-push-sentinel spmd-env ActiveBarrier)
          lane
          (I64)
          Uniform
          Local
          ActiveLane)]
      [info
        (try
          (tc-spmd-expr
            ctx
            expr-bases
            (tc-bind-id env lane (I64))
            body-spmd-env
            body))]
      (match info
        [(TcSpmdExprInfo _ _ after-env)
          (Ok
            (tc-spmd-env-merge-classes
              spmd-env
              (tc-spmd-env-restore after-env mark)))]))))

(define (tc-spmd-lane-value-operand-list-ok
  [expr-bases : i64]
  [exprs : ast.AstExprList]) : ResultTcUnit
  (tc-spmd-lane-value-operand-list-ok-at expr-bases (& exprs) 0))

(define (tc-spmd-lane-value-operand-list-ok-at
  [expr-bases : i64]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : ResultTcUnit
  (if (>= index exprs.len)
    Ok
    (let
      [_
        (try
          (tc-spmd-lane-value-operand-ok
            expr-bases
            (ast.ast-expr-segment-bases-get
              expr-bases
              (ast.ast-expr-list-get exprs index 0))))]
      (tc-spmd-lane-value-operand-list-ok-at expr-bases exprs (+ index 1)))))

;; A lane-value operand only reads gang values: it neither writes nor calls,
;; so reading one lane of it has no effect the other lanes could observe.
(define (tc-spmd-lane-value-operand-ok [expr-bases : i64] [expr : ast.AstExpr]) : ResultTcUnit
  (let
    [unspanned : ast.AstExpr
      (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))]
    [reads-only : bool
      (match (tc-global-shared-view unspanned)
        [(or (Literal _) (Var _) (SpmdProgramIndex) (SpmdProgramCount)
             (Binary _ _ _) (Unary _ _) (Ann _ _) (Cast _ _) (If _ _ _) (Let _)
             (ArrayRef _ _) (StructGet _ _) (TupleRef _ _) (SpmdBroadcast _ _)
             (SpmdShuffle _ _) (MacroExpansion _ _ _))
          true]
        [_ false])]
    (if reads-only
      (tc-spmd-lane-value-operand-list-ok
        expr-bases
        (ast.ast-expr-child-ids unspanned))
      (Err
        (tc-kind-message
          (Spmd)
          "typecheck: a lane-value operand may only read gang values (bindings, literals, operators, casts, if, let, and array, field and tuple reads); compute a call or write in the gang before foreach-active")))))

;; `(lane-value value)` in a foreach-active body: VALUE is checked under the
;; gang's rules, with the body's barrier lifted, and the current lane's value
;; of it is uniform.
(define (tc-spmd-lane-value
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : ast.AstType]
  [value : ast.AstExpr]) : ResultTcSpmdExprInfo
  (if (tc-spmd-env-in-active-body? spmd-env)
    (let
      [_
        (try
          (tc-spmd-lane-value-operand-ok
            expr-bases
            (tc-global-shared-view value)))]
      [info : TcSpmdExprInfo
        (try
          (tc-spmd-expr
            ctx
            expr-bases
            env
            (tc-spmd-env-push-sentinel spmd-env LaneValueOpen)
            value))]
      (match info
        [(TcSpmdExprInfo value-ty _ _)
          (if (tc-spmd-lane-type-supported?
            (tc-resolve-type ctx (tc-global-shared-view value-ty)))
            (tc-spmd-finish expr-ty Uniform spmd-env)
            (Err
              (str_cat.str-cat
                (tc-kind-message
                  (Spmd)
                  "typecheck: lane-value operand must have a scalar lane type (an integer, float or bool type), found ")
                (tc-type-render (tc-type-strip-region value-ty)))))]))
    (Err (tc-spmd-lane-value-scope-message tc-spmd-scope-foreach))))

;; `(set! name value)` in a gang, once the target's role is known to allow a
;; write. A gang may set its own locals; a binding declared outside the gang
;; only from a foreach-active body, which runs one lane at a time (#8306).
(define (tc-spmd-set
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : ast.AstType]
  [name : i64]
  [value-box : i64]) : ResultTcSpmdExprInfo
  (let
    [value : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases value-box)]
    (if (tc-dotted-place-name-id? ctx env name)
      (let
        [virtual-id
          (try
            (tc-dotted-local-field-set-expr-id-after-check
              expr-bases
              (tc-context-structural-session ctx)
              name
              value-box))]
        (tc-spmd-expr-typed
          ctx
          expr-bases
          env
          spmd-env
          (ast.ast-expr-segment-bases-get expr-bases virtual-id)
          expr-ty))
      (let
        [value-info : TcSpmdExprInfo
          (try (tc-spmd-expr ctx expr-bases env spmd-env value))]
        (match value-info
          [(TcSpmdExprInfo _ value-class value-env)
            (cond
              [(tc-spmd-env-has-local-id? value-env name)
                (tc-spmd-finish
                  expr-ty
                  Uniform
                  (tc-spmd-env-set-local-class-id value-env name value-class))]
              [(and
                  (tc-spmd-env-has-outer-id? value-env name)
                  (not (tc-spmd-env-in-active-body? value-env)))
                (Err
                  (tc-kind-message
                    (Spmd)
                    "typecheck: foreach cannot set binding declared outside foreach"))]
              [else (tc-spmd-finish expr-ty Uniform value-env)])])))))

;; Classify BOUNDS from INDEX on in order, threading the SPMD env; each must
;; be uniform. The result carries the env after the last bound.
(define (tc-spmd-uniform-bounds
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [bounds : ast.AstExprList]
  [index : i64]) : ResultTcSpmdExprInfo
  (if (>= index bounds.len)
    (Ok (TcSpmdExprInfo (ast.AstType.Unit) Uniform spmd-env))
    (match (tc-spmd-expr
      ctx
      expr-bases
      env
      spmd-env
      (ast.ast-expr-segment-bases-get
        expr-bases
        (ast.ast-expr-list-get (& bounds) index 0)))
      [(Ok (TcSpmdExprInfo _ class next-env))
        (let
          [_
            (try
              (tc-spmd-require-uniform
                class
                (tc-kind-message
                  (Spmd)
                  "typecheck: foreach bounds must be uniform")))]
          (tc-spmd-uniform-bounds
            ctx
            expr-bases
            env
            next-env
            bounds
            (+ index 1)))]
      [(Err message) (Err message)])))

(define (tc-spmd-expr-typed
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]
  [expr-ty : ast.AstType]) : ResultTcSpmdExprInfo
  (match (tc-global-shared-view expr)
    [(Spanned inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-spmd-expr-typed ctx expr-bases env spmd-env inner expr-ty))]
    [(MacroExpansion inner-box _ _)
      (tc-spmd-expr-typed
        ctx
        expr-bases
        env
        spmd-env
        (ast.ast-expr-segment-bases-get expr-bases inner-box)
        expr-ty)]
    [(ForOwnedState payload)
      (tc-spmd-for-owned-state
        ctx
        expr-bases
        env
        spmd-env
        (ast.ast-for-owned-state-source-name (& payload))
        (ast.ast-for-owned-state-index-name (& payload))
        (ast.ast-for-owned-state-source (& payload))
        (ast.ast-for-owned-state-body (& payload))
        expr-ty)]
    [(ForOwnedStep payload)
      (tc-spmd-for-owned-step
        ctx
        expr-bases
        env
        spmd-env
        (ast.ast-for-owned-step-source-name (& payload))
        (ast.ast-for-owned-step-index-name (& payload))
        (ast.ast-for-owned-step-binding-name (& payload))
        (ast.ast-for-owned-step-done-name (& payload))
        (ast.ast-for-owned-step-body (& payload))
        expr-ty)]
    [(SpmdProgramIndex)
      (if (tc-spmd-env-in-active-body? spmd-env)
        (Err
          (tc-kind-message
            (Spmd)
            "typecheck: foreach-active body reads varying program-index; read it with (lane-value (program-index))"))
        (tc-spmd-finish expr-ty Varying spmd-env))]
    [(Var name)
      (if (tc-dotted-place-name-id? ctx env name)
        (let
          [virtual-id
            (try
              (tc-dotted-local-field-expr-id-after-check
                (tc-context-structural-session ctx)
                name))]
          (tc-spmd-expr-typed
            ctx
            expr-bases
            env
            spmd-env
            (ast.ast-expr-segment-bases-get expr-bases virtual-id)
            expr-ty))
        (match (tc-spmd-env-lookup-id spmd-env name)
          [(Found _ class _ _)
            (if (tc-spmd-env-hidden-id? spmd-env name)
              (Err
                (if (tc-spmd-varying? class)
                  (tc-spmd-active-hidden-message name)
                  (tc-spmd-active-hidden-opaque-message name)))
              (tc-spmd-finish-ctx ctx expr-ty class spmd-env))]
          [(Missing) (tc-spmd-finish-ctx ctx expr-ty Uniform spmd-env)]))]
    [(or (Ann inner-box _) (Cast inner-box _))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        [info : TcSpmdExprInfo
          (try (tc-spmd-expr ctx expr-bases env spmd-env inner))]
        (match info
          [(TcSpmdExprInfo _ class next-spmd-env)
            (tc-spmd-finish-ctx ctx expr-ty class next-spmd-env)]))]
    [(Call func-box args)
      (let
        [func : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases func-box)]
        (if (tc-spmd-array-length-call?
          expr-bases
          (tc-context-structural-session ctx)
          (tc-global-shared-view func))
          (tc-spmd-array-length-call ctx expr-bases env spmd-env expr-ty args)
          (tc-spmd-atomic-call ctx expr-bases env spmd-env expr-ty func args)))]
    [(If cond-box then-branch-box else-branch-box)
      (let
        [cond : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases cond-box)]
        [then-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases then-branch-box)]
        [else-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases else-branch-box)]
        [cond-info : TcSpmdExprInfo
          (try (tc-spmd-expr ctx expr-bases env spmd-env cond))]
        (match cond-info
          [(TcSpmdExprInfo _ cond-class cond-env)
            (if (tc-spmd-varying? cond-class)
              (tc-spmd-masked-if
                ctx
                expr-bases
                env
                cond-env
                expr-ty
                then-branch
                else-branch)
              (let
                [then-info
                  (try (tc-spmd-expr ctx expr-bases env cond-env then-branch))]
                (match then-info
                  [(TcSpmdExprInfo _ then-class then-env)
                    (let
                      [else-info : TcSpmdExprInfo
                        (try
                          (tc-spmd-expr ctx expr-bases env cond-env else-branch))]
                      (match else-info
                        [(TcSpmdExprInfo _ else-class else-env)
                          (tc-spmd-finish
                            expr-ty
                            (tc-spmd-merge-class then-class else-class)
                            (tc-spmd-env-merge-classes then-env else-env))]))])))]))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [state
              (try
                (tc-spmd-let-bindings
                  ctx
                  expr-bases
                  env
                  spmd-env
                  bindings
                  (tc-spmd-env-mark spmd-env)))]
            (match state
              [(TcSpmdLetState body-env body-spmd-env mark)
                (let
                  [body-info : TcSpmdExprInfo
                    (try
                      (tc-spmd-expr ctx expr-bases body-env body-spmd-env body))]
                  (match body-info
                    [(TcSpmdExprInfo _ body-class final-spmd-env)
                      (tc-spmd-finish
                        expr-ty
                        body-class
                        (tc-spmd-env-restore final-spmd-env mark))]))]))])]
    [(Lambda _)
      (let
        [_ (try (tc-spmd-active-lambda-capture-ok expr-bases spmd-env expr))]
        (tc-spmd-finish expr-ty Uniform spmd-env))]
    [(ArrayRef array-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        [array-info : TcSpmdExprInfo
          (try (tc-spmd-expr ctx expr-bases env spmd-env array))]
        (match array-info
          [(TcSpmdExprInfo _ array-class array-env)
            (let
              [index-info : TcSpmdExprInfo
                (try (tc-spmd-expr ctx expr-bases env array-env index))]
              (match index-info
                [(TcSpmdExprInfo _ index-class index-env)
                  (tc-spmd-finish-lane
                    ctx
                    expr-ty
                    (tc-spmd-merge-class array-class index-class)
                    index-env)]))]))]
    [(ArraySet array-box index-box value-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [array-info : TcSpmdExprInfo
          (try (tc-spmd-expr ctx expr-bases env spmd-env array))]
        (match array-info
          [(TcSpmdExprInfo array-ty array-class array-env)
            (let
              [index-info
                (try
                  (tc-spmd-expr
                    ctx
                    expr-bases
                    env
                    array-env
                    (tc-global-shared-view index)))]
              (match index-info
                [(TcSpmdExprInfo _ index-class index-env)
                  (let
                    [_
                      (try
                        (if (tc-spmd-varying? index-class)
                          (tc-spmd-foreach-index
                            ctx
                            expr-bases
                            env
                            array-env
                            index)
                          ResultTcUnit.Ok))]
                    [value-info
                      (try
                        (tc-spmd-array-value-expr
                          ctx
                          expr-bases
                          env
                          index-env
                          (tc-global-shared-view array-ty)
                          value))]
                    (match value-info
                      [(TcSpmdExprInfo _ value-class value-env)
                        (let
                          [write-class : TcSpmdClass
                            (tc-spmd-merge-class
                              array-class
                              (tc-spmd-merge-class index-class value-class))]
                          (match (tc-type-strip-region array-ty)
                            [(Array elem-ty _)
                              (if (and
                                (tc-spmd-varying? write-class)
                                (not
                                  (tc-spmd-lane-type-supported?
                                    (ast.ty-node-get elem-ty))))
                                (Err
                                  (str_cat.str-cat
                                    (cdiag.compiler-diagnostic-typecheck-tag
                                      (Spmd))
                                    "typecheck: foreach varying array lane type is not supported: "
                                    (tc-type-render
                                      (tc-type-strip-region
                                        (ast.ty-node-get elem-ty)))))
                                (tc-spmd-finish expr-ty Uniform value-env))]
                            [(DynArray elem-ty)
                              (if (and
                                (tc-spmd-varying? write-class)
                                (not
                                  (tc-spmd-lane-type-supported?
                                    (ast.ty-node-get elem-ty))))
                                (Err
                                  (str_cat.str-cat
                                    (cdiag.compiler-diagnostic-typecheck-tag
                                      (Spmd))
                                    "typecheck: foreach varying array lane type is not supported: "
                                    (tc-type-render
                                      (tc-type-strip-region
                                        (ast.ty-node-get elem-ty)))))
                                (tc-spmd-finish expr-ty Uniform value-env))]
                            [_ (tc-spmd-finish expr-ty Uniform value-env)]))]))]))]))]
    [(ArrayTake _ _ _)
      (Err
        (tc-kind-message
          (Spmd)
          "typecheck: __tl_array-take! is not supported in SPMD"))]
    [(Replace _ _)
      (Err
        (tc-kind-message (Spmd) "typecheck: replace! is not supported in SPMD"))]
    [(StructSet receiver-box field value-box)
      (let
        [receiver : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases receiver-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [receiver-info : TcSpmdExprInfo
          (try (tc-spmd-expr ctx expr-bases env spmd-env receiver))]
        (match receiver-info
          [(TcSpmdExprInfo receiver-ty receiver-class receiver-env)
            (let
              [value-info : TcSpmdExprInfo
                (try (tc-spmd-expr ctx expr-bases env receiver-env value))]
              (match value-info
                [(TcSpmdExprInfo _ value-class value-env)
                  (let
                    [field-ty : ast.AstType
                      (try (tc-struct-set-field-type-id ctx receiver-ty field))]
                    [write-class : TcSpmdClass
                      (tc-spmd-merge-class receiver-class value-class)]
                    (if (and
                      (tc-spmd-varying? write-class)
                      (not
                        (tc-spmd-lane-type-supported?
                          (tc-type-strip-region
                            (tc-global-shared-view field-ty)))))
                      (Err
                        (str_cat.str-cat
                          (cdiag.compiler-diagnostic-typecheck-tag (Spmd))
                          "typecheck: foreach varying struct field type is not supported: "
                          (tc-type-render (tc-type-strip-region field-ty))))
                      (tc-spmd-finish expr-ty Uniform value-env)))]))]))]
    [(ArrayPush array-box value-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [array-info : TcSpmdExprInfo
          (try (tc-spmd-expr ctx expr-bases env spmd-env array))]
        (match array-info
          [(TcSpmdExprInfo array-ty array-class array-env)
            (let
              [value-info : TcSpmdExprInfo
                (try (tc-spmd-expr ctx expr-bases env array-env value))]
              (match value-info
                [(TcSpmdExprInfo _ value-class value-env)
                  (let
                    [write-class : TcSpmdClass
                      (tc-spmd-merge-class array-class value-class)]
                    (match (tc-type-strip-region array-ty)
                      [(DynArray elem-ty)
                        (if (and
                          (tc-spmd-varying? write-class)
                          (not
                            (tc-spmd-lane-type-supported?
                              (ast.ty-node-get elem-ty))))
                          (Err
                            (str_cat.str-cat
                              (cdiag.compiler-diagnostic-typecheck-tag (Spmd))
                              "typecheck: foreach varying array lane type is not supported: "
                              (tc-type-render
                                (tc-type-strip-region (ast.ty-node-get elem-ty)))))
                          (tc-spmd-finish expr-ty Uniform value-env))]
                      [_ (tc-spmd-finish expr-ty Uniform value-env)]))]))]))]
    [(While cond-box body-box)
      (let
        [cond : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases cond-box)]
        [body : ast.AstExpr (Begin body-box)]
        [cond-info
          (try
            (tc-spmd-expr
              ctx
              expr-bases
              env
              spmd-env
              (tc-global-shared-view cond)))]
        (match cond-info
          [(TcSpmdExprInfo _ cond-class cond-env)
            (if (tc-spmd-varying? cond-class)
              (let
                [_
                  (try
                    (tc-spmd-masked-if-expr ctx expr-bases env spmd-env cond))]
                (let
                  [_
                    (try
                      (tc-spmd-masked-if-expr
                        ctx
                        expr-bases
                        (tc-enter-loop-target env)
                        cond-env
                        (tc-global-shared-view body)))]
                  [body-info
                    (try
                      (tc-spmd-expr
                        ctx
                        expr-bases
                        (tc-enter-loop-target env)
                        cond-env
                        body))]
                  (match body-info
                    [(TcSpmdExprInfo _ _ body-env)
                      (tc-spmd-finish
                        expr-ty
                        Uniform
                        (tc-spmd-env-merge-classes cond-env body-env))])))
              (let
                [body-info
                  (try
                    (tc-spmd-expr
                      ctx
                      expr-bases
                      (tc-enter-loop-target env)
                      cond-env
                      body))]
                (match body-info
                  [(TcSpmdExprInfo _ _ body-env)
                    (tc-spmd-finish
                      expr-ty
                      Uniform
                      (tc-spmd-env-merge-classes cond-env body-env))])))]))]
    [(Begin exprs) (tc-spmd-begin-list ctx expr-bases env spmd-env exprs)]
    [(Unsafe exprs)
      (tc-spmd-begin-list ctx expr-bases (tc-enter-unsafe env) spmd-env exprs)]
    [(Set name value-box)
      (match (tc-spmd-env-lookup-id spmd-env name)
        [(Found _ _ _ (CompactSlot))
          (Err
            (tc-kind-message
              (Spmd)
              "typecheck: spmd-compact slot binding is read-only"))]
        [(Found _ _ _ (ActiveLane))
          (Err
            (tc-kind-message
              (Spmd)
              "typecheck: foreach-active lane binding is read-only"))]
        [(Found _ _ _ (ForeachCoordinate _ _ _ _))
          (Err
            (tc-kind-message
              (Spmd)
              "typecheck: rank-2 foreach coordinate bindings are read-only"))]
        [(Found _ class _ _)
          (if (tc-spmd-env-hidden-id? spmd-env name)
            (Err
              (if (tc-spmd-varying? class)
                (str_cat.str-cat
                  (tc-kind-message
                    (Spmd)
                    "typecheck: foreach-active body cannot set varying binding `")
                  (tc-env-key-name-text name)
                  "`")
                (tc-spmd-active-hidden-opaque-message name)))
            (tc-spmd-set ctx expr-bases env spmd-env expr-ty name value-box))]
        [(Missing)
          (tc-spmd-set ctx expr-bases env spmd-env expr-ty name value-box)])]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match scrutinee-box arms)
          (let
            [scrutinee : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases scrutinee-box)]
            [scrut-info : TcSpmdExprInfo
              (try (tc-spmd-expr ctx expr-bases env spmd-env scrutinee))]
            (match scrut-info
              [(TcSpmdExprInfo scrut-ty scrut-class scrut-env)
                (let
                  [initial-class : TcSpmdClass
                    (match (tc-type-strip-region
                      (tc-global-shared-view expr-ty))
                      [(Unit) Uniform]
                      [_ scrut-class])]
                  [arms-info : TcSpmdExprListInfo
                    (try
                      (tc-spmd-match-arms
                        ctx
                        expr-bases
                        env
                        scrut-env
                        scrut-ty
                        scrut-class
                        arms
                        initial-class))]
                  (match arms-info
                    [(TcSpmdExprListInfo arms-class arms-env)
                      (tc-spmd-finish expr-ty arms-class arms-env)]))]))])]
    [(Foreach fe-box)
      (if (tc-spmd-env-in-active-body? spmd-env)
        (Err (tc-spmd-active-unsupported-message "a nested foreach"))
        (match (__tl-box-place fe-box)
          [(Foreach index index-ty start-box end-box body-box)
            (let
              [start : ast.AstExpr
                (ast.ast-expr-segment-bases-get expr-bases start-box)]
              [end : ast.AstExpr
                (ast.ast-expr-segment-bases-get expr-bases end-box)]
              [body : ast.AstExpr
                (ast.ast-expr-segment-bases-get expr-bases body-box)]
              [start-info : TcSpmdExprInfo
                (try (tc-spmd-expr ctx expr-bases env spmd-env start))]
              (match start-info
                [(TcSpmdExprInfo _ start-class start-env)
                  (let
                    [_
                      (try
                        (tc-spmd-require-uniform
                          start-class
                          (tc-kind-message
                            (Spmd)
                            "typecheck: foreach bounds must be uniform")))]
                    [end-info : TcSpmdExprInfo
                      (try (tc-spmd-expr ctx expr-bases env start-env end))]
                    (match end-info
                      [(TcSpmdExprInfo _ end-class end-env)
                        (let
                          [_
                            (try
                              (tc-spmd-require-uniform
                                end-class
                                (tc-kind-message
                                  (Spmd)
                                  "typecheck: foreach bounds must be uniform")))]
                          (let
                            [_
                              (try
                                (tc-spmd-check-foreach-body-with-env
                                  ctx
                                  expr-bases
                                  env
                                  end-env
                                  index
                                  (tc-resolve-type ctx index-ty)
                                  body))]
                            (tc-spmd-finish expr-ty Uniform end-env)))]))]))]
          [(Foreach2 outer _ a-box b-box inner _ c-box d-box body-box)
            (match (tc-spmd-uniform-bounds
              ctx
              expr-bases
              env
              spmd-env
              (ast.ast-expr-cons
                a-box
                (&
                  (ast.ast-expr-cons
                    b-box
                    (&
                      (ast.ast-expr-cons
                        c-box
                        (&
                          (ast.ast-expr-cons d-box (& (ast.ast-expr-list-new)))))))))
              0)
              [(Ok (TcSpmdExprInfo _ _ bounds-env))
                (let
                  [_
                    (try
                      (tc-spmd-check-foreach2-body-with-env
                        ctx
                        expr-bases
                        env
                        (tc-global-shared-view bounds-env)
                        outer
                        inner
                        c-box
                        d-box
                        body-box))]
                  (tc-spmd-finish expr-ty Uniform bounds-env))]
              [(Err message) (Err message)])]))]
    [(SpmdReduce _)
      (if (tc-spmd-env-in-active-body? spmd-env)
        (Err (tc-spmd-active-unsupported-message "spmd-reduce"))
        (Err
          (tc-kind-message
            (Spmd)
            "typecheck: spmd-reduce inside foreach is not supported")))]
    [(SpmdScan _)
      (if (tc-spmd-env-in-active-body? spmd-env)
        (Err (tc-spmd-active-unsupported-message "spmd-scan"))
        (Err
          (tc-kind-message
            (Spmd)
            "typecheck: spmd-scan inside foreach is not supported")))]
    [(SpmdCompact _)
      (if (tc-spmd-env-in-active-body? spmd-env)
        (Err (tc-spmd-active-unsupported-message "spmd-compact"))
        (Err
          (tc-kind-message
            (Spmd)
            "typecheck: spmd-compact inside SPMD is not supported")))]
    [(SpmdBroadcast value-box lane-box)
      (if (tc-spmd-env-in-active-body? spmd-env)
        (Err (tc-spmd-active-unsupported-message "spmd-broadcast"))
        (let
          [value : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases value-box)]
          [lane : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases lane-box)]
          [value-info : TcSpmdExprInfo
            (try (tc-spmd-expr ctx expr-bases env spmd-env value))]
          (match value-info
            [(TcSpmdExprInfo _ value-class value-env)
              (let
                [lane-info : TcSpmdExprInfo
                  (try
                    (tc-spmd-expr-with-expected-or-actual
                      ctx
                      expr-bases
                      env
                      value-env
                      lane
                      (I64)))]
                (match lane-info
                  [(TcSpmdExprInfo lane-ty lane-class lane-env)
                    (tc-spmd-broadcast-finish
                      ctx
                      expr-ty
                      value-class
                      lane-ty
                      lane-class
                      lane-env)]))])))]
    [(SpmdShuffle value-box lane-box)
      (if (tc-spmd-env-in-active-body? spmd-env)
        (Err (tc-spmd-active-unsupported-message "spmd-shuffle"))
        (let
          [value : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases value-box)]
          [lane : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases lane-box)]
          [value-info : TcSpmdExprInfo
            (try (tc-spmd-expr ctx expr-bases env spmd-env value))]
          (match value-info
            [(TcSpmdExprInfo _ value-class value-env)
              (let
                [lane-info : TcSpmdExprInfo
                  (try
                    (tc-spmd-expr-with-expected-or-actual
                      ctx
                      expr-bases
                      env
                      value-env
                      lane
                      (I64)))]
                (match lane-info
                  [(TcSpmdExprInfo lane-ty _ lane-env)
                    (tc-spmd-shuffle-finish
                      ctx
                      expr-ty
                      value-class
                      lane-ty
                      lane-env)]))])))]
    [(WithRegion region body)
      (tc-spmd-begin-list
        ctx
        expr-bases
        (tc-push-region env region)
        spmd-env
        body)]
    [(WithEscape _ _)
      (Err "typecheck: with-escape inside spmd is not supported")]
    [(WithScratch _)
      (Err "typecheck: with-scratch inside spmd is not supported")]
    [(InArena _ _) (Err "typecheck: in-arena inside spmd is not supported")]
    [(WithResource _) (Err "typecheck: resource with is not implemented yet")]
    [(or (Quote _) (Quasiquote _)) (tc-spmd-finish expr-ty Uniform spmd-env)]
    [(Unquote _) (Err "typecheck: unquote is only valid inside quasiquote")]
    [(UnquoteSplicing _)
      (Err "typecheck: unquote-splicing is only valid inside quasiquote")]
    [(Try _)
      (if (tc-spmd-env-in-active-body? spmd-env)
        (Err (tc-spmd-active-unsupported-message "try"))
        (Err
          (tc-kind-message
            (Spmd)
            "typecheck: try inside foreach is not supported")))]
    [(Return _)
      (if (tc-spmd-env-in-active-body? spmd-env)
        (Err (tc-spmd-active-unsupported-message "return"))
        (Err
          (tc-kind-message
            (Spmd)
            "typecheck: return inside foreach is not supported")))]
    [(Break)
      (if (tc-spmd-env-in-active-body? spmd-env)
        (Err (tc-spmd-active-unsupported-message "break"))
        (Err
          (tc-kind-message
            (Spmd)
            "typecheck: break inside foreach is not supported")))]
    [(Continue)
      (if (tc-spmd-env-in-active-body? spmd-env)
        (Err (tc-spmd-active-unsupported-message "continue"))
        (Err
          (tc-kind-message
            (Spmd)
            "typecheck: continue inside foreach is not supported")))]
    [(ForeachActive lane body-box)
      (let
        [after-env
          (try
            (tc-spmd-foreach-active
              ctx
              expr-bases
              env
              spmd-env
              lane
              (ast.ast-expr-segment-bases-get expr-bases body-box)))]
        (tc-spmd-finish expr-ty Uniform after-env))]
    [(LaneValue value-box)
      (tc-spmd-lane-value
        ctx
        expr-bases
        env
        spmd-env
        expr-ty
        (ast.ast-expr-segment-bases-get expr-bases value-box))]
    [(or (CpuIdEax leaf-box subleaf-box) (CpuIdEbx leaf-box subleaf-box)
         (CpuIdEcx leaf-box subleaf-box) (CpuIdEdx leaf-box subleaf-box))
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (tc-spmd-cpuid-like ctx expr-bases env spmd-env expr-ty leaf subleaf))]
    [(Syscall args)
      (let
        [args-info : TcSpmdExprListInfo
          (try (tc-spmd-expr-list ctx expr-bases env spmd-env args))]
        (match args-info
          [(TcSpmdExprListInfo args-class args-env)
            (let
              [_
                (try
                  (tc-spmd-require-uniform
                    args-class
                    (tc-kind-message
                      (Spmd)
                      "typecheck: foreach calls with varying arguments are not supported")))]
              (tc-spmd-finish expr-ty Uniform args-env))]))]
    [_
      (let
        [info : TcSpmdExprListInfo
          (try
            (tc-spmd-expr-list
              ctx
              expr-bases
              env
              spmd-env
              (ast.ast-expr-child-ids expr)))]
        (match info
          [(TcSpmdExprListInfo class next-spmd-env)
            (tc-spmd-finish expr-ty class next-spmd-env)]))]))

(define (tc-param-list-add-bound-names
  [params : ast.AstParamList]
  [bound : TcStringList]) : TcStringList
  (tc-param-list-add-bound-names-at (& params) 0 bound))

(define (tc-param-list-add-bound-names-at
  [params : (& params ast.AstParamList)]
  [index : i64]
  [bound : TcStringList]) : TcStringList
  (if (>= index (ast.ast-param-list-len params))
    bound
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param name _ _)
        (tc-param-list-add-bound-names-at
          params
          (+ index 1)
          (tc-string-list-add bound (tc-env-key-name-text name)))])))

(define (tc-param-bound-names [params : ast.AstParamList]) : TcStringList
  (tc-param-list-add-bound-names params Nil))

(define (tc-pattern-add-bound-names
  [pattern : ast.AstPattern]
  [bound : TcStringList]) : TcStringList
  (match pattern
    [(or (Var name _) (Binding name))
      (tc-string-list-add bound (tc-env-key-name-text name))]
    [(or (Tuple patterns-box) (Array patterns-box) (Slice patterns-box _)
         (Or patterns-box) (Fields patterns-box) (Field _ patterns-box)
         (Variant _ patterns-box))
      (let
        [patterns : ast.AstPatternList
          (ast.ast-pattern-list-box-shared-view patterns-box)]
        (tc-pattern-list-add-bound-names patterns bound))]
    [(or (Wildcard) (Literal _)) bound]))

(define (tc-pattern-list-add-bound-names
  [patterns : ast.AstPatternList]
  [bound : TcStringList]) : TcStringList
  (tc-pattern-list-add-bound-names-at (& patterns) bound 0))

(define (tc-pattern-list-add-bound-names-at
  [patterns : (& patterns ast.AstPatternList)]
  [bound : TcStringList]
  [index : i64]) : TcStringList
  (if (>= index patterns.len)
    bound
    (tc-pattern-list-add-bound-names-at
      patterns
      (tc-pattern-add-bound-names
        (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))
        bound)
      (+ index 1))))

(define (tc-pattern-add-bound-name-ids
  [pattern : ast.AstPattern]
  [bound : TcNameIdList]) : TcNameIdList
  (match pattern
    [(or (Var name _) (Binding name)) (tc-name-id-list-add bound name)]
    [(or (Tuple patterns-box) (Array patterns-box) (Slice patterns-box _)
         (Or patterns-box) (Fields patterns-box) (Field _ patterns-box)
         (Variant _ patterns-box))
      (tc-pattern-list-add-bound-name-ids
        (ast.ast-pattern-list-box-shared-view patterns-box)
        bound)]
    [(or (Wildcard) (Literal _)) bound]))

(define (tc-pattern-list-add-bound-name-ids
  [patterns : ast.AstPatternList]
  [bound : TcNameIdList]) : TcNameIdList
  (tc-pattern-list-add-bound-name-ids-at (& patterns) bound 0))

(define (tc-pattern-list-add-bound-name-ids-at
  [patterns : (& patterns ast.AstPatternList)]
  [bound : TcNameIdList]
  [index : i64]) : TcNameIdList
  (if (>= index patterns.len)
    bound
    (tc-pattern-list-add-bound-name-ids-at
      patterns
      (tc-pattern-add-bound-name-ids
        (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))
        bound)
      (+ index 1))))

(define (tc-let-binding-list-add-bound-names
  [bindings : ast.AstLetBindingList]
  [bound : TcStringList]) : TcStringList
  (tc-let-binding-list-add-bound-names-at (& bindings) bound 0))

(define (tc-let-binding-list-add-bound-names-at
  [bindings : (& bindings ast.AstLetBindingList)]
  [bound : TcStringList]
  [index : i64]) : TcStringList
  (if (>= index (ast.ast-let-binding-list-len bindings))
    bound
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name _ _)
        (tc-let-binding-list-add-bound-names-at
          bindings
          (tc-string-list-add bound (tc-env-key-name-text name))
          (+ index 1))])))

(define (tc-let-binding-list-add-bound-name-ids
  [bindings : ast.AstLetBindingList]
  [bound : TcNameIdList]) : TcNameIdList
  (tc-let-binding-list-add-bound-name-ids-at (& bindings) bound 0))

(define (tc-let-binding-list-add-bound-name-ids-at
  [bindings : (& bindings ast.AstLetBindingList)]
  [bound : TcNameIdList]
  [index : i64]) : TcNameIdList
  (if (>= index (ast.ast-let-binding-list-len bindings))
    bound
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name _ _)
        (tc-let-binding-list-add-bound-name-ids-at
          bindings
          (tc-name-id-list-add bound name)
          (+ index 1))])))

(define (tc-resource-binding-list-add-bound-names
  [bindings : ast.AstResourceBindingList]
  [bound : TcStringList]) : TcStringList
  (tc-resource-binding-list-add-bound-names-at (& bindings) bound 0))

(define (tc-resource-binding-list-add-bound-names-at
  [bindings : (& bindings ast.AstResourceBindingList)]
  [bound : TcStringList]
  [index : i64]) : TcStringList
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    bound
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(Binding name _ _ _)
        (tc-resource-binding-list-add-bound-names-at
          bindings
          (tc-string-list-add bound (tc-env-key-name-text name))
          (+ index 1))])))

;; The free-name walkers: whether an expression names one of `names` where
;; `bound` does not shadow it, as a read or a `set!` target. With `sets-only?`
;; only assignments count (a `set!` target or the root of a `replace` place);
;; lambda capture checks use that to reject mutation of captured bindings while
;; allowing local parameter/let assignment inside the lambda.
(define (tc-expr-list-uses-free-names?
  [expr-bases : i64]
  [exprs : ast.AstExprList]
  [names : TcStringList]
  [bound : TcStringList]
  [sets-only? : bool]) : bool
  (tc-expr-list-uses-free-names-at?
    expr-bases
    (& exprs)
    0
    names
    bound
    sets-only?))

(define (tc-expr-list-uses-free-names-at?
  [expr-bases : i64]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [names : TcStringList]
  [bound : TcStringList]
  [sets-only? : bool]) : bool
  (if (>= index exprs.len)
    false
    (or
      (tc-expr-uses-free-names?
        expr-bases
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get exprs index 0))
        (tc-global-shared-view names)
        (tc-global-shared-view bound)
        sets-only?)
      (tc-expr-list-uses-free-names-at?
        expr-bases
        exprs
        (+ index 1)
        names
        bound
        sets-only?))))

(define (tc-let-binding-list-uses-free-names?
  [expr-bases : i64]
  [bindings : ast.AstLetBindingList]
  [names : TcStringList]
  [bound : TcStringList]
  [sets-only? : bool]) : bool
  (tc-let-binding-list-uses-free-names-at?
    expr-bases
    (& bindings)
    names
    bound
    0
    sets-only?))

(define (tc-let-binding-list-uses-free-names-at?
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [names : TcStringList]
  [bound : TcStringList]
  [index : i64]
  [sets-only? : bool]) : bool
  (if (>= index (ast.ast-let-binding-list-len bindings))
    false
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding bind-name _ init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          (or
            (tc-expr-uses-free-names?
              expr-bases
              init
              (tc-global-shared-view names)
              (tc-global-shared-view bound)
              sets-only?)
            (tc-let-binding-list-uses-free-names-at?
              expr-bases
              bindings
              names
              (tc-string-list-add bound (ci.intern-str bind-name))
              (+ index 1)
              sets-only?)))])))

(define (tc-resource-binding-list-uses-free-names?
  [expr-bases : i64]
  [bindings : ast.AstResourceBindingList]
  [names : TcStringList]
  [bound : TcStringList]
  [sets-only? : bool]) : bool
  (tc-resource-binding-list-uses-free-names-at?
    expr-bases
    (& bindings)
    names
    bound
    0
    sets-only?))

(define (tc-resource-binding-list-uses-free-names-at?
  [expr-bases : i64]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [names : TcStringList]
  [bound : TcStringList]
  [index : i64]
  [sets-only? : bool]) : bool
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    false
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(Binding bind-name init-box cleanup-box _)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [cleanup : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases cleanup-box)]
          (or
            (tc-expr-uses-free-names?
              expr-bases
              init
              (tc-global-shared-view names)
              (tc-global-shared-view bound)
              sets-only?)
            (tc-expr-uses-free-names?
              expr-bases
              cleanup
              (tc-global-shared-view names)
              (tc-global-shared-view bound)
              sets-only?)
            (tc-resource-binding-list-uses-free-names-at?
              expr-bases
              bindings
              names
              (tc-string-list-add bound (ci.intern-str bind-name))
              (+ index 1)
              sets-only?)))])))

(define (tc-match-arms-use-free-names?
  [expr-bases : i64]
  [arms : ast.AstMatchArmList]
  [names : TcStringList]
  [bound : TcStringList]
  [sets-only? : bool]) : bool
  (tc-match-arms-use-free-names-at?
    expr-bases
    (& arms)
    names
    bound
    0
    sets-only?))

(define (tc-match-arms-use-free-names-at?
  [expr-bases : i64]
  [arms : (& arms ast.AstMatchArmList)]
  [names : TcStringList]
  [bound : TcStringList]
  [index : i64]
  [sets-only? : bool]) : bool
  (if (>= index arms.len)
    false
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          (or
            (tc-expr-uses-free-names?
              expr-bases
              body
              (tc-global-shared-view names)
              (tc-pattern-add-bound-names pattern (tc-global-shared-view bound))
              sets-only?)
            (tc-match-arms-use-free-names-at?
              expr-bases
              arms
              names
              bound
              (+ index 1)
              sets-only?)))])))

(define (tc-for-owned-name-id [expr-bases : i64] [expr-id : i64]) : i64
  (tc-expr-var-name-id
    expr-bases
    (ast.ast-expr-segment-bases-get expr-bases expr-id)))

(define (tc-for-owned-add-bound-name
  [expr-bases : i64]
  [expr-id : i64]
  [bound : TcStringList]) : TcStringList
  (let
    [name-id : i64 (tc-for-owned-name-id expr-bases expr-id)]
    (if (>= name-id 0)
      (tc-string-list-add bound (tc-env-key-name-text name-id))
      bound)))

(define (tc-for-owned-add-bound-source-id
  [session : cis.InternStructuralSessionHandle]
  [expr-bases : i64]
  [expr-id : i64]
  [bound : TcNameIdList]) : TcNameIdList
  (let
    [name-id : i64 (tc-for-owned-name-id expr-bases expr-id)]
    (if (>= name-id 0)
      (tc-name-id-list-add bound (tc-env-key-source-id-or-neg session name-id))
      bound)))

(define (tc-expr-uses-free-names?
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [names : TcStringList]
  [bound : TcStringList]
  [sets-only? : bool]) : bool
  (match (tc-global-shared-view expr)
    [(Var var-name)
      (and
        (not sets-only?)
        (let
          [text : String (tc-env-key-name-text var-name)]
          (and
            (tc-string-list-contains names (tc-global-shared-view text))
            (not (tc-string-list-contains bound text)))))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (or
              (tc-let-binding-list-uses-free-names?
                expr-bases
                (tc-global-shared-view bindings)
                (tc-global-shared-view names)
                (tc-global-shared-view bound)
                sets-only?)
              (tc-expr-uses-free-names?
                expr-bases
                body
                names
                (tc-let-binding-list-add-bound-names bindings bound)
                sets-only?)))])]
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda params _ body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (tc-expr-uses-free-names?
              expr-bases
              body
              names
              (tc-param-list-add-bound-names params bound)
              sets-only?))])]
    [(ForOwnedState payload)
      (let
        [source-name : i64 (ast.ast-for-owned-state-source-name (& payload))]
        [index-name : i64 (ast.ast-for-owned-state-index-name (& payload))]
        (or
          (tc-expr-uses-free-names?
            expr-bases
            (ast.ast-expr-segment-bases-get
              expr-bases
              (ast.ast-for-owned-state-source (& payload)))
            (tc-global-shared-view names)
            (tc-global-shared-view bound)
            sets-only?)
          (tc-expr-uses-free-names?
            expr-bases
            (ast.ast-expr-segment-bases-get
              expr-bases
              (ast.ast-for-owned-state-body (& payload)))
            names
            (tc-for-owned-add-bound-name
              expr-bases
              index-name
              (tc-for-owned-add-bound-name expr-bases source-name bound))
            sets-only?)))]
    [(ForOwnedStep payload)
      (let
        [source-name : i64 (ast.ast-for-owned-step-source-name (& payload))]
        [index-name : i64 (ast.ast-for-owned-step-index-name (& payload))]
        [binding-name : i64 (ast.ast-for-owned-step-binding-name (& payload))]
        [expected-type : i64 (ast.ast-for-owned-step-expected-type (& payload))]
        [done-name : i64 (ast.ast-for-owned-step-done-name (& payload))]
        [body : i64 (ast.ast-for-owned-step-body (& payload))]
        (or
          (tc-expr-uses-free-names?
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases source-name)
            (tc-global-shared-view names)
            (tc-global-shared-view bound)
            sets-only?)
          (tc-expr-uses-free-names?
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases index-name)
            (tc-global-shared-view names)
            (tc-global-shared-view bound)
            sets-only?)
          (if (>= expected-type 0)
            (tc-expr-uses-free-names?
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases expected-type)
              (tc-global-shared-view names)
              (tc-global-shared-view bound)
              sets-only?)
            false)
          (tc-expr-uses-free-names?
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases done-name)
            (tc-global-shared-view names)
            (tc-global-shared-view bound)
            sets-only?)
          (tc-expr-uses-free-names?
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases body)
            names
            (tc-for-owned-add-bound-name expr-bases binding-name bound)
            sets-only?)))]
    [(Set var-name value-box)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (or
          (let
            [text : String (tc-env-key-name-text var-name)]
            (and
              (tc-string-list-contains
                (tc-global-shared-view names)
                (tc-global-shared-view text))
              (not (tc-string-list-contains (tc-global-shared-view bound) text))))
          (tc-expr-uses-free-names? expr-bases value names bound sets-only?)))]
    [(Replace place-box replacement-box)
      (let
        [place : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases place-box)]
        [replacement : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases replacement-box)]
        (or
          (and
            sets-only?
            (match (tc-move-root-projection-var-id
              expr-bases
              (tc-global-shared-view place))
              [(Some root-id)
                (let
                  [text : String (tc-env-key-name-text root-id)]
                  (and
                    (tc-string-list-contains
                      (tc-global-shared-view names)
                      (tc-global-shared-view text))
                    (not
                      (tc-string-list-contains
                        (tc-global-shared-view bound)
                        text))))]
              [(No) false]))
          (tc-expr-uses-free-names?
            expr-bases
            place
            (tc-global-shared-view names)
            (tc-global-shared-view bound)
            sets-only?)
          (tc-expr-uses-free-names?
            expr-bases
            replacement
            names
            bound
            sets-only?)))]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match scrutinee-box arms)
          (let
            [scrutinee : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases scrutinee-box)]
            (or
              (tc-expr-uses-free-names?
                expr-bases
                scrutinee
                (tc-global-shared-view names)
                (tc-global-shared-view bound)
                sets-only?)
              (tc-match-arms-use-free-names?
                expr-bases
                arms
                names
                bound
                sets-only?)))])]
    [(Foreach fe-box)
      (match (__tl-box-place fe-box)
        [(Foreach index _ start-box end-box body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (or
              (tc-expr-uses-free-names?
                expr-bases
                start
                (tc-global-shared-view names)
                (tc-global-shared-view bound)
                sets-only?)
              (tc-expr-uses-free-names?
                expr-bases
                end
                (tc-global-shared-view names)
                (tc-global-shared-view bound)
                sets-only?)
              (tc-expr-uses-free-names?
                expr-bases
                body
                names
                (tc-string-list-add bound (tc-env-key-name-text index))
                sets-only?)))]
        [(Foreach2 outer _ a-box b-box inner _ c-box d-box body-box)
          (or
            (tc-expr-uses-free-names?
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases a-box)
              (tc-global-shared-view names)
              (tc-global-shared-view bound)
              sets-only?)
            (tc-expr-uses-free-names?
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases b-box)
              (tc-global-shared-view names)
              (tc-global-shared-view bound)
              sets-only?)
            (tc-expr-uses-free-names?
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases c-box)
              (tc-global-shared-view names)
              (tc-global-shared-view bound)
              sets-only?)
            (tc-expr-uses-free-names?
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases d-box)
              (tc-global-shared-view names)
              (tc-global-shared-view bound)
              sets-only?)
            (tc-expr-uses-free-names?
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases body-box)
              names
              (tc-string-list-add
                (tc-string-list-add bound (tc-env-key-name-text outer))
                (tc-env-key-name-text inner))
              sets-only?))])]
    [(SpmdReduce reduce-box)
      (match (__tl-box-place reduce-box)
        [(Reduce _ index _ start-box end-box init-box value-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [value : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases value-box)]
            (or
              (tc-expr-uses-free-names?
                expr-bases
                start
                (tc-global-shared-view names)
                (tc-global-shared-view bound)
                sets-only?)
              (tc-expr-uses-free-names?
                expr-bases
                end
                (tc-global-shared-view names)
                (tc-global-shared-view bound)
                sets-only?)
              (tc-expr-uses-free-names?
                expr-bases
                init
                (tc-global-shared-view names)
                (tc-global-shared-view bound)
                sets-only?)
              (tc-expr-uses-free-names?
                expr-bases
                value
                names
                (tc-string-list-add bound (tc-env-key-name-text index))
                sets-only?)))])]
    [(SpmdScan scan-box)
      (match (__tl-box-place scan-box)
        [(Scan _ index _ start-box end-box prefix _ init-box value-box body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [value : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases value-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [value-bound : TcStringList
              (tc-string-list-add
                (tc-global-shared-view bound)
                (tc-env-key-name-text index))]
            [body-bound : TcStringList
              (tc-string-list-add
                (tc-global-shared-view value-bound)
                (tc-env-key-name-text prefix))]
            (or
              (tc-expr-uses-free-names?
                expr-bases
                start
                (tc-global-shared-view names)
                (tc-global-shared-view bound)
                sets-only?)
              (tc-expr-uses-free-names?
                expr-bases
                end
                (tc-global-shared-view names)
                (tc-global-shared-view bound)
                sets-only?)
              (tc-expr-uses-free-names?
                expr-bases
                init
                (tc-global-shared-view names)
                bound
                sets-only?)
              (tc-expr-uses-free-names?
                expr-bases
                value
                (tc-global-shared-view names)
                value-bound
                sets-only?)
              (tc-expr-uses-free-names?
                expr-bases
                body
                names
                body-bound
                sets-only?)))])]
    [(SpmdCompact compact-box)
      (match (__tl-box-place compact-box)
        [(Compact index _ start-box end-box slot _ init-box keep-box body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [keep : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases keep-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [keep-bound : TcStringList
              (tc-string-list-add
                (tc-global-shared-view bound)
                (tc-env-key-name-text index))]
            [body-bound : TcStringList
              (tc-string-list-add
                (tc-global-shared-view keep-bound)
                (tc-env-key-name-text slot))]
            (or
              (tc-expr-uses-free-names?
                expr-bases
                start
                (tc-global-shared-view names)
                (tc-global-shared-view bound)
                sets-only?)
              (tc-expr-uses-free-names?
                expr-bases
                end
                (tc-global-shared-view names)
                (tc-global-shared-view bound)
                sets-only?)
              (tc-expr-uses-free-names?
                expr-bases
                init
                (tc-global-shared-view names)
                bound
                sets-only?)
              (tc-expr-uses-free-names?
                expr-bases
                keep
                (tc-global-shared-view names)
                keep-bound
                sets-only?)
              (tc-expr-uses-free-names?
                expr-bases
                body
                names
                body-bound
                sets-only?)))])]
    [(WithResource wr-box)
      (match (__tl-box-place wr-box)
        [(WithResource bindings body)
          (or
            (tc-resource-binding-list-uses-free-names?
              expr-bases
              (tc-global-shared-view bindings)
              (tc-global-shared-view names)
              (tc-global-shared-view bound)
              sets-only?)
            (tc-expr-list-uses-free-names?
              expr-bases
              body
              names
              (tc-resource-binding-list-add-bound-names bindings bound)
              sets-only?))])]
    [(ForeachActive lane body-box)
      (tc-expr-uses-free-names?
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases body-box)
        names
        (tc-string-list-add bound (tc-env-key-name-text lane))
        sets-only?)]
    [_
      (tc-expr-list-uses-free-names?
        expr-bases
        (ast.ast-expr-child-ids expr)
        names
        bound
        sets-only?)]))

;; Single-name entry points over the name-set walkers above.
(define (tc-expr-uses-free-name?
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-expr-uses-free-names? expr-bases expr (One name) bound false))

(define (tc-expr-list-uses-free-name?
  [expr-bases : i64]
  [exprs : ast.AstExprList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-expr-list-uses-free-names? expr-bases exprs (One name) bound false))

(define (tc-expr-sets-free-name?
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-expr-uses-free-names? expr-bases expr (One name) bound true))

;; The id rule for a dot-free target text: the source-name id of an env key,
;; or -1 when the key's display can never equal the target. Pool ids render
;; as their text (intern-str is injective), structural-local and hygiene
;; global/local ids render as their source names, and composite keys render
;; dotted (with '/'), so they map to -1. For any dot-free target text T this
;; makes (= (tc-env-key-source-id-or-neg v) (intern T)) EXACTLY
;; (string.eq (tc-env-key-name-text v) T).
(define (tc-env-key-source-id-or-neg
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : i64
  (cond
    [(and (>= name-id 0) (< name-id (ci.intern-capacity))) name-id]
    [(>= name-id (ci.intern-structural-key-base))
      (cis.intern-structural-session-syntax-source-name-id-or
        session
        name-id
        -1)]
    [else -1]))

;; Same shadowing rules as `tc-expr-uses-free-name?`, but the target is one or
;; two source-name ids matched in a single walk and the bound set is keyed by
;; source-name id (the exact id form of the string-keyed set for the dot-free
;; target texts the compat prescan uses).
(define (tc-expr-list-uses-free-source-id?
  [session : cis.InternStructuralSessionHandle]
  [expr-bases : i64]
  [exprs : ast.AstExprList]
  [target-1 : i64]
  [target-2 : i64]
  [bound : TcNameIdList]) : bool
  (tc-expr-list-uses-free-source-id-at?
    session
    expr-bases
    (& exprs)
    0
    target-1
    target-2
    bound))

(define (tc-expr-list-uses-free-source-id-at?
  [session : cis.InternStructuralSessionHandle]
  [expr-bases : i64]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [target-1 : i64]
  [target-2 : i64]
  [bound : TcNameIdList]) : bool
  (if (>= index exprs.len)
    false
    (or
      (tc-expr-uses-free-source-id?
        session
        expr-bases
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get exprs index 0))
        target-1
        target-2
        bound)
      (tc-expr-list-uses-free-source-id-at?
        session
        expr-bases
        exprs
        (+ index 1)
        target-1
        target-2
        bound))))

(define (tc-let-binding-list-uses-free-source-id?
  [session : cis.InternStructuralSessionHandle]
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [target-1 : i64]
  [target-2 : i64]
  [bound : TcNameIdList]) : bool
  (tc-let-binding-list-uses-free-source-id-at?
    session
    expr-bases
    (& bindings)
    target-1
    target-2
    bound
    0))

(define (tc-let-binding-list-uses-free-source-id-at?
  [session : cis.InternStructuralSessionHandle]
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [target-1 : i64]
  [target-2 : i64]
  [bound : TcNameIdList]
  [index : i64]) : bool
  (if (>= index (ast.ast-let-binding-list-len bindings))
    false
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding bind-name _ init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          (or
            (tc-expr-uses-free-source-id?
              session
              expr-bases
              init
              target-1
              target-2
              bound)
            (tc-let-binding-list-uses-free-source-id-at?
              session
              expr-bases
              bindings
              target-1
              target-2
              (tc-name-id-list-add
                bound
                (tc-env-key-source-id-or-neg session bind-name))
              (+ index 1))))])))

(define (tc-resource-binding-list-uses-free-source-id?
  [session : cis.InternStructuralSessionHandle]
  [expr-bases : i64]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [target-1 : i64]
  [target-2 : i64]
  [bound : TcNameIdList]) : bool
  (tc-resource-binding-list-uses-free-source-id-at?
    session
    expr-bases
    (& bindings)
    target-1
    target-2
    bound
    0))

(define (tc-resource-binding-list-uses-free-source-id-at?
  [session : cis.InternStructuralSessionHandle]
  [expr-bases : i64]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [target-1 : i64]
  [target-2 : i64]
  [bound : TcNameIdList]
  [index : i64]) : bool
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    false
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(Binding bind-name init-box cleanup-box _)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [cleanup : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases cleanup-box)]
          (or
            (tc-expr-uses-free-source-id?
              session
              expr-bases
              init
              target-1
              target-2
              bound)
            (tc-expr-uses-free-source-id?
              session
              expr-bases
              cleanup
              target-1
              target-2
              bound)
            (tc-resource-binding-list-uses-free-source-id-at?
              session
              expr-bases
              bindings
              target-1
              target-2
              (tc-name-id-list-add
                bound
                (tc-env-key-source-id-or-neg session bind-name))
              (+ index 1))))])))

(define (tc-match-arms-use-free-source-id?
  [session : cis.InternStructuralSessionHandle]
  [expr-bases : i64]
  [arms : ast.AstMatchArmList]
  [target-1 : i64]
  [target-2 : i64]
  [bound : TcNameIdList]) : bool
  (tc-match-arms-use-free-source-id-at?
    session
    expr-bases
    (& arms)
    target-1
    target-2
    bound
    0))

(define (tc-match-arms-use-free-source-id-at?
  [session : cis.InternStructuralSessionHandle]
  [expr-bases : i64]
  [arms : (& arms ast.AstMatchArmList)]
  [target-1 : i64]
  [target-2 : i64]
  [bound : TcNameIdList]
  [index : i64]) : bool
  (if (>= index arms.len)
    false
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          (or
            (tc-expr-uses-free-source-id?
              session
              expr-bases
              body
              target-1
              target-2
              (tc-pattern-add-bound-source-ids session pattern bound))
            (tc-match-arms-use-free-source-id-at?
              session
              expr-bases
              arms
              target-1
              target-2
              bound
              (+ index 1))))])))

(define (tc-pattern-add-bound-source-ids
  [session : cis.InternStructuralSessionHandle]
  [pattern : ast.AstPattern]
  [bound : TcNameIdList]) : TcNameIdList
  (match pattern
    [(or (Var name _) (Binding name))
      (tc-name-id-list-add bound (tc-env-key-source-id-or-neg session name))]
    [(or (Tuple patterns-box) (Array patterns-box) (Slice patterns-box _)
         (Or patterns-box) (Fields patterns-box) (Field _ patterns-box)
         (Variant _ patterns-box))
      (let
        [patterns : ast.AstPatternList
          (ast.ast-pattern-list-box-shared-view patterns-box)]
        (tc-pattern-list-add-bound-source-ids session patterns bound))]
    [(or (Wildcard) (Literal _)) bound]))

(define (tc-pattern-list-add-bound-source-ids
  [session : cis.InternStructuralSessionHandle]
  [patterns : ast.AstPatternList]
  [bound : TcNameIdList]) : TcNameIdList
  (tc-pattern-list-add-bound-source-ids-at session (& patterns) bound 0))

(define (tc-pattern-list-add-bound-source-ids-at
  [session : cis.InternStructuralSessionHandle]
  [patterns : (& patterns ast.AstPatternList)]
  [bound : TcNameIdList]
  [index : i64]) : TcNameIdList
  (if (>= index patterns.len)
    bound
    (tc-pattern-list-add-bound-source-ids-at
      session
      patterns
      (tc-pattern-add-bound-source-ids
        session
        (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))
        bound)
      (+ index 1))))

(define (tc-let-binding-list-add-bound-source-ids
  [session : cis.InternStructuralSessionHandle]
  [bindings : ast.AstLetBindingList]
  [bound : TcNameIdList]) : TcNameIdList
  (tc-let-binding-list-add-bound-source-ids-at session (& bindings) bound 0))

(define (tc-let-binding-list-add-bound-source-ids-at
  [session : cis.InternStructuralSessionHandle]
  [bindings : (& bindings ast.AstLetBindingList)]
  [bound : TcNameIdList]
  [index : i64]) : TcNameIdList
  (if (>= index (ast.ast-let-binding-list-len bindings))
    bound
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name _ _)
        (tc-let-binding-list-add-bound-source-ids-at
          session
          bindings
          (tc-name-id-list-add bound (tc-env-key-source-id-or-neg session name))
          (+ index 1))])))

(define (tc-resource-binding-list-add-bound-source-ids
  [session : cis.InternStructuralSessionHandle]
  [bindings : ast.AstResourceBindingList]
  [bound : TcNameIdList]) : TcNameIdList
  (tc-resource-binding-list-add-bound-source-ids-at
    session
    (& bindings)
    bound
    0))

(define (tc-resource-binding-list-add-bound-source-ids-at
  [session : cis.InternStructuralSessionHandle]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [bound : TcNameIdList]
  [index : i64]) : TcNameIdList
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    bound
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(Binding name _ _ _)
        (tc-resource-binding-list-add-bound-source-ids-at
          session
          bindings
          (tc-name-id-list-add bound (tc-env-key-source-id-or-neg session name))
          (+ index 1))])))

(define (tc-param-list-add-bound-source-ids
  [session : cis.InternStructuralSessionHandle]
  [params : ast.AstParamList]
  [bound : TcNameIdList]) : TcNameIdList
  (tc-param-list-add-bound-source-ids-at session (& params) 0 bound))

(define (tc-param-list-add-bound-source-ids-at
  [session : cis.InternStructuralSessionHandle]
  [params : (& params ast.AstParamList)]
  [index : i64]
  [bound : TcNameIdList]) : TcNameIdList
  (if (>= index (ast.ast-param-list-len params))
    bound
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param name _ _)
        (tc-param-list-add-bound-source-ids-at
          session
          params
          (+ index 1)
          (tc-name-id-list-add bound (tc-env-key-source-id-or-neg session name)))])))

(define (tc-expr-uses-free-source-id?
  [session : cis.InternStructuralSessionHandle]
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [target-1 : i64]
  [target-2 : i64]
  [bound : TcNameIdList]) : bool
  (match (tc-global-shared-view expr)
    [(Var var-name)
      (let
        [sid : i64 (tc-env-key-source-id-or-neg session var-name)]
        (if (or (= sid target-1) (= sid target-2))
          (not (tc-name-id-list-contains bound sid))
          false))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (or
              (tc-let-binding-list-uses-free-source-id?
                session
                expr-bases
                bindings
                target-1
                target-2
                bound)
              (tc-expr-uses-free-source-id?
                session
                expr-bases
                body
                target-1
                target-2
                (tc-let-binding-list-add-bound-source-ids
                  session
                  bindings
                  bound))))])]
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda params _ body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (tc-expr-uses-free-source-id?
              session
              expr-bases
              body
              target-1
              target-2
              (tc-param-list-add-bound-source-ids session params bound)))])]
    [(ForOwnedState payload)
      (let
        [source-name : i64 (ast.ast-for-owned-state-source-name (& payload))]
        [index-name : i64 (ast.ast-for-owned-state-index-name (& payload))]
        (or
          (tc-expr-uses-free-source-id?
            session
            expr-bases
            (ast.ast-expr-segment-bases-get
              expr-bases
              (ast.ast-for-owned-state-source (& payload)))
            target-1
            target-2
            bound)
          (tc-expr-uses-free-source-id?
            session
            expr-bases
            (ast.ast-expr-segment-bases-get
              expr-bases
              (ast.ast-for-owned-state-body (& payload)))
            target-1
            target-2
            (tc-for-owned-add-bound-source-id
              session
              expr-bases
              index-name
              (tc-for-owned-add-bound-source-id
                session
                expr-bases
                source-name
                bound)))))]
    [(ForOwnedStep payload)
      (let
        [source-name : i64 (ast.ast-for-owned-step-source-name (& payload))]
        [index-name : i64 (ast.ast-for-owned-step-index-name (& payload))]
        [binding-name : i64 (ast.ast-for-owned-step-binding-name (& payload))]
        [expected-type : i64 (ast.ast-for-owned-step-expected-type (& payload))]
        [done-name : i64 (ast.ast-for-owned-step-done-name (& payload))]
        [body : i64 (ast.ast-for-owned-step-body (& payload))]
        (or
          (tc-expr-uses-free-source-id?
            session
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases source-name)
            target-1
            target-2
            bound)
          (tc-expr-uses-free-source-id?
            session
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases index-name)
            target-1
            target-2
            bound)
          (if (>= expected-type 0)
            (tc-expr-uses-free-source-id?
              session
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases expected-type)
              target-1
              target-2
              bound)
            false)
          (tc-expr-uses-free-source-id?
            session
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases done-name)
            target-1
            target-2
            bound)
          (tc-expr-uses-free-source-id?
            session
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases body)
            target-1
            target-2
            (tc-for-owned-add-bound-source-id
              session
              expr-bases
              binding-name
              bound))))]
    [(Set var-name value-box)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [sid : i64 (tc-env-key-source-id-or-neg session var-name)]
        (or
          (if (or (= sid target-1) (= sid target-2))
            (not (tc-name-id-list-contains bound sid))
            false)
          (tc-expr-uses-free-source-id?
            session
            expr-bases
            value
            target-1
            target-2
            bound)))]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match scrutinee-box arms)
          (let
            [scrutinee : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases scrutinee-box)]
            (or
              (tc-expr-uses-free-source-id?
                session
                expr-bases
                scrutinee
                target-1
                target-2
                bound)
              (tc-match-arms-use-free-source-id?
                session
                expr-bases
                arms
                target-1
                target-2
                bound)))])]
    [(Foreach fe-box)
      (match (__tl-box-place fe-box)
        [(Foreach index _ start-box end-box body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (or
              (tc-expr-uses-free-source-id?
                session
                expr-bases
                start
                target-1
                target-2
                bound)
              (tc-expr-uses-free-source-id?
                session
                expr-bases
                end
                target-1
                target-2
                bound)
              (tc-expr-uses-free-source-id?
                session
                expr-bases
                body
                target-1
                target-2
                (tc-name-id-list-add
                  bound
                  (tc-env-key-source-id-or-neg session index)))))]
        [(Foreach2 outer _ a-box b-box inner _ c-box d-box body-box)
          (or
            (tc-expr-uses-free-source-id?
              session
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases a-box)
              target-1
              target-2
              bound)
            (tc-expr-uses-free-source-id?
              session
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases b-box)
              target-1
              target-2
              bound)
            (tc-expr-uses-free-source-id?
              session
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases c-box)
              target-1
              target-2
              bound)
            (tc-expr-uses-free-source-id?
              session
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases d-box)
              target-1
              target-2
              bound)
            (tc-expr-uses-free-source-id?
              session
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases body-box)
              target-1
              target-2
              (tc-name-id-list-add
                (tc-name-id-list-add
                  bound
                  (tc-env-key-source-id-or-neg session outer))
                (tc-env-key-source-id-or-neg session inner))))])]
    [(SpmdReduce reduce-box)
      (match (__tl-box-place reduce-box)
        [(Reduce _ index _ start-box end-box init-box value-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [value : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases value-box)]
            (or
              (tc-expr-uses-free-source-id?
                session
                expr-bases
                start
                target-1
                target-2
                bound)
              (tc-expr-uses-free-source-id?
                session
                expr-bases
                end
                target-1
                target-2
                bound)
              (tc-expr-uses-free-source-id?
                session
                expr-bases
                init
                target-1
                target-2
                bound)
              (tc-expr-uses-free-source-id?
                session
                expr-bases
                value
                target-1
                target-2
                (tc-name-id-list-add
                  bound
                  (tc-env-key-source-id-or-neg session index)))))])]
    [(SpmdScan scan-box)
      (match (__tl-box-place scan-box)
        [(Scan _ index _ start-box end-box prefix _ init-box value-box body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [value : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases value-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [value-bound : TcNameIdList
              (tc-name-id-list-add
                bound
                (tc-env-key-source-id-or-neg session index))]
            [body-bound : TcNameIdList
              (tc-name-id-list-add
                value-bound
                (tc-env-key-source-id-or-neg session prefix))]
            (or
              (tc-expr-uses-free-source-id?
                session
                expr-bases
                start
                target-1
                target-2
                bound)
              (tc-expr-uses-free-source-id?
                session
                expr-bases
                end
                target-1
                target-2
                bound)
              (tc-expr-uses-free-source-id?
                session
                expr-bases
                init
                target-1
                target-2
                bound)
              (tc-expr-uses-free-source-id?
                session
                expr-bases
                value
                target-1
                target-2
                value-bound)
              (tc-expr-uses-free-source-id?
                session
                expr-bases
                body
                target-1
                target-2
                body-bound)))])]
    [(SpmdCompact compact-box)
      (match (__tl-box-place compact-box)
        [(Compact index _ start-box end-box slot _ init-box keep-box body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [keep : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases keep-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [keep-bound : TcNameIdList
              (tc-name-id-list-add
                bound
                (tc-env-key-source-id-or-neg session index))]
            [body-bound : TcNameIdList
              (tc-name-id-list-add
                keep-bound
                (tc-env-key-source-id-or-neg session slot))]
            (or
              (tc-expr-uses-free-source-id?
                session
                expr-bases
                start
                target-1
                target-2
                bound)
              (tc-expr-uses-free-source-id?
                session
                expr-bases
                end
                target-1
                target-2
                bound)
              (tc-expr-uses-free-source-id?
                session
                expr-bases
                init
                target-1
                target-2
                bound)
              (tc-expr-uses-free-source-id?
                session
                expr-bases
                keep
                target-1
                target-2
                keep-bound)
              (tc-expr-uses-free-source-id?
                session
                expr-bases
                body
                target-1
                target-2
                body-bound)))])]
    [(WithResource wr-box)
      (match (__tl-box-place wr-box)
        [(WithResource bindings body)
          (or
            (tc-resource-binding-list-uses-free-source-id?
              session
              expr-bases
              bindings
              target-1
              target-2
              bound)
            (tc-expr-list-uses-free-source-id?
              session
              expr-bases
              body
              target-1
              target-2
              (tc-resource-binding-list-add-bound-source-ids
                session
                bindings
                bound)))])]
    [(ForeachActive lane body-box)
      (tc-expr-uses-free-source-id?
        session
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases body-box)
        target-1
        target-2
        (tc-name-id-list-add bound (tc-env-key-source-id-or-neg session lane)))]
    [_
      (tc-expr-list-uses-free-source-id?
        session
        expr-bases
        (ast.ast-expr-child-ids expr)
        target-1
        target-2
        bound)]))

(define (tc-name-is-free-cleanup-owner?
  [owners : TcStringList]
  [name : String]
  [bound : TcStringList]) : bool
  (and
    (tc-string-list-contains owners (tc-global-shared-view name))
    (not (tc-string-list-contains bound name))))

(define (tc-expr-list-result-uses-cleanup-owner?
  [expr-bases : i64]
  [exprs : ast.AstExprList]
  [owners : TcStringList]
  [bound : TcStringList]) : bool
  (if (ast.ast-expr-list-empty? (& exprs))
    false
    (tc-expr-result-uses-cleanup-owner?
      expr-bases
      (ast.ast-expr-segment-bases-get
        expr-bases
        (ast.ast-expr-list-get (& exprs) (- exprs.len 1) 0))
      owners
      bound)))

(define (tc-expr-list-any-result-uses-cleanup-owner?
  [expr-bases : i64]
  [exprs : ast.AstExprList]
  [owners : TcStringList]
  [bound : TcStringList]) : bool
  (tc-expr-list-any-result-uses-cleanup-owner-at?
    expr-bases
    (& exprs)
    0
    owners
    bound))

(define (tc-expr-list-any-result-uses-cleanup-owner-at?
  [expr-bases : i64]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [owners : TcStringList]
  [bound : TcStringList]) : bool
  (if (>= index exprs.len)
    false
    (or
      (tc-expr-result-uses-cleanup-owner?
        expr-bases
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get exprs index 0))
        (tc-global-shared-view owners)
        (tc-global-shared-view bound))
      (tc-expr-list-any-result-uses-cleanup-owner-at?
        expr-bases
        exprs
        (+ index 1)
        owners
        bound))))

(define (tc-match-arms-result-use-cleanup-owner?
  [expr-bases : i64]
  [arms : ast.AstMatchArmList]
  [owners : TcStringList]
  [bound : TcStringList]) : bool
  (tc-match-arms-result-use-cleanup-owner-at?
    expr-bases
    (& arms)
    owners
    bound
    0))

(define (tc-match-arms-result-use-cleanup-owner-at?
  [expr-bases : i64]
  [arms : (& arms ast.AstMatchArmList)]
  [owners : TcStringList]
  [bound : TcStringList]
  [index : i64]) : bool
  (if (>= index arms.len)
    false
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          (or
            (tc-expr-result-uses-cleanup-owner?
              expr-bases
              body
              (tc-global-shared-view owners)
              (tc-pattern-add-bound-names pattern (tc-global-shared-view bound)))
            (tc-match-arms-result-use-cleanup-owner-at?
              expr-bases
              arms
              owners
              bound
              (+ index 1))))])))

(define (tc-expr-result-uses-cleanup-owner?
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [owners : TcStringList]
  [bound : TcStringList]) : bool
  (match expr
    [(or (Spanned inner-box _) (MacroExpansion inner-box _ _) (Ann inner-box _)
         (Cast inner-box _) (Comptime inner-box) (Try inner-box)
         (Return inner-box) (BoxGet inner-box) (BoxTake inner-box))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-expr-result-uses-cleanup-owner? expr-bases inner owners bound))]
    [(Var name)
      (tc-name-is-free-cleanup-owner? owners (tc-env-key-name-text name) bound)]
    [(If _ then-branch-box else-branch-box)
      (let
        [then-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases then-branch-box)]
        [else-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases else-branch-box)]
        (or
          (tc-expr-result-uses-cleanup-owner?
            expr-bases
            then-branch
            (tc-global-shared-view owners)
            (tc-global-shared-view bound))
          (tc-expr-result-uses-cleanup-owner?
            expr-bases
            else-branch
            owners
            bound)))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (tc-expr-result-uses-cleanup-owner?
              expr-bases
              body
              owners
              (tc-let-binding-list-add-bound-names bindings bound)))])]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match _ arms)
          (tc-match-arms-result-use-cleanup-owner? expr-bases arms owners bound)])]
    [(Foreach fe-box)
      (match (__tl-box-place fe-box)
        [(Foreach index _ _ _ body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (tc-expr-result-uses-cleanup-owner?
              expr-bases
              body
              owners
              (tc-string-list-add bound (tc-env-key-name-text index))))]
        [(Foreach2 outer _ _ _ inner _ _ _ body-box)
          (tc-expr-result-uses-cleanup-owner?
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases body-box)
            owners
            (tc-string-list-add
              (tc-string-list-add bound (tc-env-key-name-text outer))
              (tc-env-key-name-text inner)))])]
    [(SpmdReduce reduce-box)
      (match (__tl-box-place reduce-box)
        [(Reduce _ index _ _ _ _ value-box)
          (let
            [value : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases value-box)]
            (tc-expr-result-uses-cleanup-owner?
              expr-bases
              value
              owners
              (tc-string-list-add bound (tc-env-key-name-text index))))])]
    [(SpmdScan scan-box)
      (match (__tl-box-place scan-box)
        [(Scan _ index _ _ _ prefix _ _ value-box body-box)
          (let
            [value : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases value-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [value-bound : TcStringList
              (tc-string-list-add bound (tc-env-key-name-text index))]
            [body-bound : TcStringList
              (tc-string-list-add
                (tc-global-shared-view value-bound)
                (tc-env-key-name-text prefix))]
            (or
              (tc-expr-result-uses-cleanup-owner?
                expr-bases
                value
                (tc-global-shared-view owners)
                value-bound)
              (tc-expr-result-uses-cleanup-owner?
                expr-bases
                body
                owners
                body-bound)))])]
    [(SpmdCompact compact-box)
      (match (__tl-box-place compact-box)
        [(Compact index _ _ _ slot _ _ keep-box body-box)
          (let
            [keep : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases keep-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [keep-bound : TcStringList
              (tc-string-list-add bound (tc-env-key-name-text index))]
            [body-bound : TcStringList
              (tc-string-list-add
                (tc-global-shared-view keep-bound)
                (tc-env-key-name-text slot))]
            (or
              (tc-expr-result-uses-cleanup-owner?
                expr-bases
                keep
                (tc-global-shared-view owners)
                keep-bound)
              (tc-expr-result-uses-cleanup-owner?
                expr-bases
                body
                owners
                body-bound)))])]
    [(or (SpmdBroadcast value-box _) (SpmdShuffle value-box _))
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (tc-expr-result-uses-cleanup-owner? expr-bases value owners bound))]
    [(ForeachActive lane body-box)
      (tc-expr-result-uses-cleanup-owner?
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases body-box)
        owners
        (tc-string-list-add bound (tc-env-key-name-text lane)))]
    [(LaneValue value-box)
      (tc-expr-result-uses-cleanup-owner?
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases value-box)
        owners
        bound)]
    [(or (Begin exprs) (Unsafe exprs) (WithRegion _ exprs) (WithEscape _ exprs)
         (WithScratch exprs) (InArena _ exprs))
      (tc-expr-list-result-uses-cleanup-owner? expr-bases exprs owners bound)]
    [(BoxSet inner-box value-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (or
          (tc-expr-result-uses-cleanup-owner?
            expr-bases
            inner
            (tc-global-shared-view owners)
            (tc-global-shared-view bound))
          (tc-expr-result-uses-cleanup-owner? expr-bases value owners bound)))]
    [(WithResource wr-box)
      (match (__tl-box-place wr-box)
        [(WithResource bindings body)
          (tc-expr-list-result-uses-cleanup-owner?
            expr-bases
            body
            owners
            (tc-resource-binding-list-add-bound-names bindings bound))])]
    [_ false]))

;; `tc-expr-result-uses-cleanup-owner?` can only answer true through
;; `tc-name-is-free-cleanup-owner?`, which first requires the name to be a member
;; of `owners`. With an empty owner list the answer is false for every
;; expression, so the recursive expression walk is pure overhead and is skipped.
(define (tc-expr-result-uses-active-cleanup-owner?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]) : bool
  (let
    [owners : TcStringList (tc-active-cleanup-owners env)]
    (match (tc-global-shared-view owners)
      [(Nil) false]
      [_
        (tc-expr-result-uses-cleanup-owner?
          (tc-context-expr-bases ctx)
          expr
          owners
          Nil)])))

(define (tc-expr-list-any-result-uses-active-cleanup-owner?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]) : bool
  (let
    [owners : TcStringList (tc-active-cleanup-owners env)]
    (match (tc-global-shared-view owners)
      [(Nil) false]
      [_
        (tc-expr-list-any-result-uses-cleanup-owner?
          (tc-context-expr-bases ctx)
          exprs
          owners
          Nil)])))

;; An ordinary `let` may own a cleanup-owning value under the move checker's
;; discharge obligation (#6947), but it cannot take a value an active `with`
;; owner still cleans.
(define (tc-ensure-cleanup-resource-not-let-bound
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (if (tc-expr-result-uses-active-cleanup-owner? ctx env expr)
    (Err
      (tc-kind-message
        (ResourceOwnership)
        "typecheck: ordinary let cannot own cleanup-required resource; use with"))
    Ok))

(define (tc-ensure-cleanup-resource-not-transferred
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (if (tc-expr-result-uses-active-cleanup-owner? ctx env expr)
    (Err
      (tc-kind-message
        (ResourceOwnership)
        "typecheck: cleanup-required resource already has a cleanup owner"))
    Ok))

(define (tc-ensure-cleanup-resource-not-stored-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (if (tc-expr-result-uses-active-cleanup-owner? ctx env expr)
    (Err
      (tc-kind-message
        (ResourceOwnership)
        "typecheck: cannot store cleanup-required resource in ordinary aggregate"))
    Ok))

(define (tc-ensure-cleanup-resource-not-stored-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]) : ResultTcUnit
  (if (tc-expr-list-any-result-uses-active-cleanup-owner? ctx env exprs)
    (Err
      (tc-kind-message
        (ResourceOwnership)
        "typecheck: cannot store cleanup-required resource in ordinary aggregate"))
    Ok))

(define (tc-ensure-cleanup-resource-not-assigned
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (if (tc-expr-result-uses-active-cleanup-owner? ctx env expr)
    (Err
      (tc-kind-message
        (ResourceOwnership)
        "typecheck: cannot store cleanup-required resource in longer-lived binding"))
    Ok))

(define (tc-type-env-scoped-carrier-check-lambda-region-captures-scan
  [expr-bases : i64]
  [carrier : TcTypeEnvScopedCarrier]
  [cursor : TcTypeEnvScopedMarkerCursor]
  [bound : TcStringList]
  [body : ast.AstExpr]
  [allow-immutable-reference-captures : bool]) : ResultTcUnit
  (match (tc-type-env-scoped-marker-step cursor)
    [(Done) Ok]
    [(Bind key ty rest-cursor)
      (let
        [name : String (tc-env-key-name-text key)]
        (cond
          [(or
              (= key (tc-region-marker-id))
              (= key (tc-default-boundary-id))
              (tc-cleanup-owner-marker-entry? key ty)
              (tc-ordinary-arena-owner-marker-entry?
                key
                (tc-global-shared-view ty))
              (tc-atomic-arena-owner-marker-entry?
                key
                (tc-global-shared-view ty)))
            (tc-type-env-scoped-carrier-check-lambda-region-captures-scan
              expr-bases
              carrier
              rest-cursor
              bound
              body
              allow-immutable-reference-captures)]
          [(not
              (tc-expr-uses-free-name?
                expr-bases
                (tc-global-shared-view body)
                (tc-global-shared-view name)
                (tc-global-shared-view bound)))
            (tc-type-env-scoped-carrier-check-lambda-region-captures-scan
              expr-bases
              carrier
              rest-cursor
              bound
              body
              allow-immutable-reference-captures)]
          [(tc-expr-sets-free-name?
              expr-bases
              (tc-global-shared-view body)
              name
              (tc-global-shared-view bound))
            (Err "typecheck: lambda cannot assign captured binding")]
          [(tc-type-env-scoped-carrier-cleanup-owner-active?
              (tc-global-shared-view carrier)
              key)
            (Err
              (tc-kind-message
                (ResourceOwnership)
                "typecheck: lambda cannot capture cleanup-required resource; resource value would escape"))]
          [(tc-type-contains-mut-reference? (tc-global-shared-view ty))
            (if allow-immutable-reference-captures
              (tc-type-env-scoped-carrier-check-lambda-region-captures-scan
                expr-bases
                carrier
                rest-cursor
                bound
                body
                allow-immutable-reference-captures)
              (Err
                (tc-kind-message
                  (RegionEscape)
                  "typecheck: lambda cannot capture mutable reference; reference value would escape lexical scope")))]
          [(tc-type-contains-reference? (tc-global-shared-view ty))
            (if (or
              allow-immutable-reference-captures
              ;; Nominal lifetime arguments participate in the general
              ;; reference predicate. A generated atomic Arena brand is a
              ;; spanning owner capability, not a stack borrow; keep its exact
              ;; type for the later structural thread-transfer classifier.
              (tc-type-regions-all-atomic-arena-owners?
                (tc-type-env-scoped-carrier-env carrier)
                ty))
              (tc-type-env-scoped-carrier-check-lambda-region-captures-scan
                expr-bases
                carrier
                rest-cursor
                bound
                body
                allow-immutable-reference-captures)
              (Err
                (tc-kind-message
                  (RegionEscape)
                  "typecheck: lambda cannot capture immutable reference; reference value would escape lexical scope")))]
          [(tc-type-contains-any-region (tc-global-shared-view ty))
            (if (tc-type-regions-all-atomic-arena-owners?
              (tc-type-env-scoped-carrier-env carrier)
              ty)
              (tc-type-env-scoped-carrier-check-lambda-region-captures-scan
                expr-bases
                carrier
                rest-cursor
                bound
                body
                allow-immutable-reference-captures)
              (Err
                (tc-kind-message
                  (RegionEscape)
                  "typecheck: lambda cannot capture region-tagged value; region value would escape")))]
          [else
            (tc-type-env-scoped-carrier-check-lambda-region-captures-scan
              expr-bases
              carrier
              rest-cursor
              bound
              body
              allow-immutable-reference-captures)]))]))

(define (tc-type-env-scoped-carrier-check-lambda-region-captures
  [expr-bases : i64]
  [carrier : TcTypeEnvScopedCarrier]
  [bound : TcStringList]
  [body : ast.AstExpr]
  [allow-immutable-reference-captures : bool]) : ResultTcUnit
  (begin
    (cfg compile-profile (counters.bump! tc-profile-env-marker-scans))
    (tc-type-env-scoped-carrier-check-lambda-region-captures-scan
      expr-bases
      (tc-global-shared-view carrier)
      (tc-type-env-scoped-carrier-marker-cursor carrier)
      bound
      body
      allow-immutable-reference-captures)))

(define (tc-check-lambda-region-captures-scan
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [body : ast.AstExpr]
  [allow-immutable-reference-captures : bool]) : ResultTcUnit
  (tc-type-env-scoped-carrier-check-lambda-region-captures
    expr-bases
    (tc-type-env-scoped-carrier-from-marker-visible-env env)
    bound
    body
    allow-immutable-reference-captures))

(define (tc-check-lambda-region-captures
  [expr-bases : i64]
  [env : TcTypeEnv]
  [params : ast.AstParamList]
  [body : ast.AstExpr]) : ResultTcUnit
  (tc-check-lambda-region-captures-scan
    expr-bases
    env
    (tc-param-bound-names params)
    body
    false))

(define (tc-check-lambda-region-captures-allow-refs
  [expr-bases : i64]
  [env : TcTypeEnv]
  [params : ast.AstParamList]
  [body : ast.AstExpr]) : ResultTcUnit
  (tc-check-lambda-region-captures-scan
    expr-bases
    env
    (tc-param-bound-names params)
    body
    true))

;; Enum queries are frequent during macro expansion, and the generated-name
;; compatibility path cannot always use CompilerSymbols. Index the flat
;; program view by source and module-qualified ids. The index is rebuilt at the
;; existing macro-splice cache boundary, so a replaced comptime template
;; declaration cannot leave a stale name.
(define tc-program-enum-index-ready : bool
  false)
(define tc-program-enum-index-decl-count : i64
  -1)
(define tc-program-enum-index-decl-offset : i64
  -1)
(define tc-program-enum-index-generation : i64
  -1)
(define tc-program-enum-index-arena : i64
  0)
(define tc-program-enum-index-positions : tc_i64_i64_map.Map
  (tc_i64_i64_map.with-capacity 16))

(define (tc-program-enum-index-reset!) : unit
  (set! tc-program-enum-index-ready false)
  (set! tc-program-enum-index-decl-count -1)
  (set! tc-program-enum-index-decl-offset -1)
  (unless
    (= tc-program-enum-index-arena 0)
    (unsafe
      (arena.tl_arena_destroy tc-program-enum-index-arena))
    (set! tc-program-enum-index-arena 0)))

(define (tc-program-enum-index-bind-if-absent!
  [positions : (&mut positions tc_i64_i64_map.Map)]
  [key-id : i64]
  [position : i64]) : unit
  (if (< key-id 0)
    unit
    (match (tc_i64_i64_map.get (& positions) key-id)
      [(LookupFound _) unit]
      [(LookupMissing) (tc_i64_i64_map.insert-ref! positions key-id position)])))

(define (tc-program-enum-index-bind-name!
  [positions : (&mut positions tc_i64_i64_map.Map)]
  [module-id : i64]
  [name-id : i64]
  [position : i64]) : unit
  (tc-program-enum-index-bind-if-absent!
    positions
    (csym.compiler-symbol-name-id-key name-id)
    position)
  (tc-program-enum-index-bind-if-absent!
    positions
    (csym.compiler-symbol-module-key-id-by-id module-id name-id)
    position))

(define (tc-program-enum-index-bind-decl!
  [positions : (&mut positions tc_i64_i64_map.Map)]
  [module-id : i64]
  [decl : ast.AstDecl]
  [position : i64]) : unit
  (match decl
    [(or (DefEnum _ name _ _) (DefEnumLifetimes _ name _ _ _))
      (tc-program-enum-index-bind-name! positions module-id name position)]
    [_ unit]))

(define (tc-program-enum-index-ensure! [decls : (& decls ast.AstDeclList)]) : unit
  (if (and
    tc-program-enum-index-ready
    (= tc-program-enum-index-decl-count decls.len)
    (= tc-program-enum-index-decl-offset decls.offset)
    (= tc-program-enum-index-generation (ci.intern-generation)))
    unit
    (let
      [_reset : unit (tc-program-enum-index-reset!)]
      [count : i64 decls.len]
      [decl-offset : i64 decls.offset]
      [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
      [prev-arena : i64 (arena.tl_arena_current)]
      [index-arena : i64 (arena.tl_arena_make)]
      [_switch : unit
        (unsafe
          (arena.tl_arena_set index-arena))]
      [positions : tc_i64_i64_map.Map (tc_i64_i64_map.with-capacity 8192)]
      [module-id : i64 (csym.compiler-symbol-root-module-id)]
      [position : i64 0]
      (while (< position count)
        (let
          [decl : ast.AstDecl
            (tc-global-array-element-shared-view
              decl-slots
              (+ decl-offset position))]
          (match (tc-global-shared-view decl)
            [(Module next-module) (set! module-id next-module)]
            [_
              (tc-program-enum-index-bind-decl!
                (&mut positions)
                module-id
                decl
                position)])
          (set! position (+ position 1))))
      (set! tc-program-enum-index-positions positions)
      (set! tc-program-enum-index-decl-count count)
      (set! tc-program-enum-index-decl-offset decl-offset)
      (set! tc-program-enum-index-generation (ci.intern-generation))
      (set! tc-program-enum-index-arena (arena.tl_arena_current))
      (unsafe
        (arena.tl_arena_set prev-arena))
      (set! tc-program-enum-index-ready true))))

(define (tc-program-enum-variants-from-indexed-decl
  [decl : ast.AstDecl]
  [enum-name : String]) : parser.ResultAstVariantDefList
  (match decl
    [(or (DefEnum _ _ _ variants) (DefEnumLifetimes _ _ _ _ variants))
      (Ok variants)]
    [_ (Err (str_cat.str-cat "typecheck: unknown enum " enum-name))]))

(define (tc-program-enum-variants-id
  [program : ast.AstProgram]
  [enum-name-id : i64]
  [enum-name : String]) : parser.ResultAstVariantDefList
  (match program
    [(Program decls-box)
      (let
        [decls : ast.AstDeclList (ast.ast-decl-list-box-shared-view decls-box)]
        [_ensure : unit (tc-program-enum-index-ensure! decls)]
        (match (tc_i64_i64_map.get
          (& tc-program-enum-index-positions)
          (csym.compiler-symbol-name-id-key enum-name-id))
          [(LookupFound position)
            (tc-program-enum-variants-from-indexed-decl
              (tc-global-array-element-shared-view
                decls.slots
                (+ decls.offset position))
              enum-name)]
          [(LookupMissing)
            (Err (str_cat.str-cat "typecheck: unknown enum " enum-name))]))]))

(define (tc-context-enum-variants-id
  [ctx : TcContext]
  [enum-name-id : i64]
  [enum-name : String]) : parser.ResultAstVariantDefList
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-type-id-or
        (tc-context-symbols-ref (& ctx))
        enum-name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (if (=
        (csym.compiler-symbol-handle-kind handle)
        (csym.compiler-symbol-kind-defenum))
        (let
          [decl
            (try
              (csym.compiler-symbols-decl-at-index
                (tc-context-symbols ctx)
                (csym.compiler-symbol-handle-index handle)))]
          (match decl
            [(or (DefEnum _ _ _ variants) (DefEnumLifetimes _ _ _ _ variants))
              (Ok variants)]
            [_ (Err (str_cat.str-cat "typecheck: unknown enum " enum-name))]))
        (Err (str_cat.str-cat "typecheck: unknown enum " enum-name)))
      (tc-program-enum-variants-id
        (tc-context-program ctx)
        enum-name-id
        enum-name))))

(define (tc-context-enum-variants-at-handle
  [ctx : TcContext]
  [handle : i64]
  [enum-name-id : i64]
  [enum-name : String]) : parser.ResultAstVariantDefList
  (if (and
    (csym.compiler-symbols-handle-found? handle)
    (=
      (csym.compiler-symbol-handle-kind handle)
      (csym.compiler-symbol-kind-defenum)))
    (let
      [decl : ast.AstDecl
        (try
          (csym.compiler-symbols-decl-at-index
            (tc-context-symbols ctx)
            (csym.compiler-symbol-handle-index handle)))]
      (match decl
        [(or (DefEnum _ _ _ variants) (DefEnumLifetimes _ _ _ _ variants))
          (Ok variants)]
        [_ (Err (str_cat.str-cat "typecheck: unknown enum " enum-name))]))
    (tc-context-enum-variants-id ctx enum-name-id enum-name)))

(define (tc-layout-info-size [info : TcLayoutInfo]) : i64
  (match info
    [(TcLayoutInfo size _) size]))

(define (tc-layout-info-align [info : TcLayoutInfo]) : i64
  (match info
    [(TcLayoutInfo _ align) align]))

(define (tc-inline-field-layout-name-id [field : TcInlineFieldLayout]) : i64
  (match field
    [(Field name _ _) name]))

(define (tc-inline-field-layout-type [field : TcInlineFieldLayout]) : ast.AstType
  (match field
    [(Field _ ty _) ty]))

(define (tc-inline-field-layout-offset [field : TcInlineFieldLayout]) : i64
  (match field
    [(Field _ _ offset) offset]))

(define (tc-inline-field-layout-list-offset-id
  [fields : TcInlineFieldLayoutList]
  [name-id : i64]) : i64
  (tc-inline-field-layout-list-offset-id-at fields name-id 0))

(define (tc-inline-field-layout-list-offset-id-at
  [fields : TcInlineFieldLayoutList]
  [name-id : i64]
  [index : i64]) : i64
  (if (>= index (tc-inline-field-layout-list-count fields))
    -1
    (let
      [field : TcInlineFieldLayout
        (tc-inline-field-layout-list-ref fields index)]
      (begin
        (cfg
          compile-profile
          (counters.bump! tc-profile-layout-inline-field-visits))
        (if (=
          (tc-inline-field-layout-name-id (tc-global-shared-view field))
          name-id)
          (tc-inline-field-layout-offset field)
          (tc-inline-field-layout-list-offset-id-at fields name-id (+ index 1)))))))

;; Register-resident aggregate eightbytes may be INTEGER (the
;; existing word-class data) or SSE. SSE admits exact aligned f64 fields and
;; packed f32 fields that share an eightbyte only with other SSE fields. Mixed
;; integer/float sub-word eightbytes intentionally stay memory-backed.
(define (tc-sse-eightbyte-field? [ty : ast.AstType] [offset : i64]) : bool
  (match (tc-type-strip-region ty)
    [(F64) (= (% offset 8) 0)]
    [(F32) (= (% offset 4) 0)]
    [_ false]))

(define (tc-register-field-class [ty : ast.AstType] [offset : i64]) : i64
  (if (tc-word-class-type? (tc-global-shared-view ty))
    0
    (if (tc-sse-eightbyte-field? ty offset)
      1
      2)))

(define (tc-register-field-size [ty : ast.AstType]) : i64
  (match (tc-type-strip-region ty)
    [(or (I64) (U64) (F64) (Ptr _) (MutPtr _)) 8]
    [(or (I32) (U32) (F32)) 4]
    [(or (I16) (U16)) 2]
    [(or (I8) (U8) (Bool) (Char)) 1]
    [_ 8]))

;; True when every struct field is word-class, so the aggregate can be
;; packed into general-purpose register words instead of a memory slot.
;; True when every struct field can be assigned to a supported
;; register eightbyte class and every occupied eightbyte has a single class.
;; This preserves every existing INTEGER case, exact f64 SSE eightbytes, and
;; homogeneous packed f32 SSE eightbytes while rejecting mixed int/float words.
(define (tc-inline-field-overlaps-word?
  [field : TcInlineFieldLayout]
  [word-index : i64]) : bool
  (let
    [offset : i64 (tc-inline-field-layout-offset (tc-global-shared-view field))]
    [size : i64 (tc-register-field-size (tc-inline-field-layout-type field))]
    [word-base : i64 (* word-index 8)]
    (and (< offset (+ word-base 8)) (> (+ offset size) word-base))))

(define (tc-inline-fields-word-register-class
  [fields : TcInlineFieldLayoutList]
  [word-index : i64]
  [found : i64]) : i64
  (tc-inline-fields-word-register-class-at fields word-index found 0))

(define (tc-inline-fields-word-register-class-at
  [fields : TcInlineFieldLayoutList]
  [word-index : i64]
  [found : i64]
  [index : i64]) : i64
  (if (>= index (tc-inline-field-layout-list-count fields))
    found
    (let
      [field : TcInlineFieldLayout
        (tc-inline-field-layout-list-ref fields index)]
      (if (tc-inline-field-overlaps-word?
        (tc-global-shared-view field)
        word-index)
        (let
          [class : i64
            (tc-register-field-class
              (tc-inline-field-layout-type (tc-global-shared-view field))
              (tc-inline-field-layout-offset field))]
          (cond
            [(= class 2) 2]
            [(= found -1)
              (tc-inline-fields-word-register-class-at
                fields
                word-index
                class
                (+ index 1))]
            [(= found class)
              (tc-inline-fields-word-register-class-at
                fields
                word-index
                found
                (+ index 1))]
            [else 2]))
        (tc-inline-fields-word-register-class-at
          fields
          word-index
          found
          (+ index 1))))))

(define (tc-inline-fields-all-register-class?
  [fields : TcInlineFieldLayoutList]) : bool
  (and
    (<
      (tc-inline-fields-word-register-class (tc-global-shared-view fields) 0 -1)
      2)
    (< (tc-inline-fields-word-register-class fields 1 -1) 2)))

;; True when every payload field of a variant is word-class -- so a 16-byte
;; enum (tag in word0, the single word-class payload in word1) can be carried
;; register-resident.
(define (tc-register-payload-class [payload : TcInlinePayloadLayout]) : i64
  (match payload
    [(Payload _ ty offset) (tc-register-field-class ty offset)]))

;; Return -1 for an empty payload list, 0 for INTEGER, 1 for SSE, and 2 when the
;; payload fields cannot share one supported register eightbyte class.
(define (tc-inline-payloads-register-class
  [payloads : TcInlinePayloadLayoutList]
  [found : i64]) : i64
  (tc-inline-payloads-register-class-at payloads found 0))

(define (tc-inline-payloads-register-class-at
  [payloads : TcInlinePayloadLayoutList]
  [found : i64]
  [index : i64]) : i64
  (if (>= index (tc-inline-payload-layout-list-count payloads))
    found
    (let
      [class : i64
        (tc-register-payload-class
          (tc-inline-payload-layout-list-ref payloads index))]
      (cond
        [(= class 2) 2]
        [(= found -1)
          (tc-inline-payloads-register-class-at payloads class (+ index 1))]
        [(= found class)
          (tc-inline-payloads-register-class-at payloads found (+ index 1))]
        [else 2]))))

(define (tc-inline-enum-register-payload-class
  [variants : TcInlineVariantLayoutList]
  [found : i64]) : i64
  (tc-inline-enum-register-payload-class-at variants found 0))

(define (tc-inline-enum-register-payload-class-at
  [variants : TcInlineVariantLayoutList]
  [found : i64]
  [index : i64]) : i64
  (if (>= index (tc-inline-variant-layout-list-count variants))
    found
    (match (tc-inline-variant-layout-list-ref variants index)
      [(Variant _ _ _ payloads)
        (let
          [class : i64 (tc-inline-payloads-register-class payloads -1)]
          (cond
            [(= class 2) 2]
            [(= class -1)
              (tc-inline-enum-register-payload-class-at
                variants
                found
                (+ index 1))]
            [(= found -1)
              (tc-inline-enum-register-payload-class-at
                variants
                class
                (+ index 1))]
            [(= found class)
              (tc-inline-enum-register-payload-class-at
                variants
                found
                (+ index 1))]
            [else 2]))])))

(define (tc-inline-enum-payloads-all-register-class?
  [variants : TcInlineVariantLayoutList]) : bool
  (< (tc-inline-enum-register-payload-class variants -1) 2))

(define (tc-inline-payload-layout-list-empty?
  [payloads : TcInlinePayloadLayoutList]) : bool
  (= (tc-inline-payload-layout-list-count payloads) 0))

(define (tc-inline-enum-variants-tag-only?
  [variants : TcInlineVariantLayoutList]) : bool
  (tc-inline-enum-variants-tag-only-at? variants 0))

(define (tc-inline-enum-variants-tag-only-at?
  [variants : TcInlineVariantLayoutList]
  [index : i64]) : bool
  (if (>= index (tc-inline-variant-layout-list-count variants))
    true
    (match (tc-inline-variant-layout-list-ref variants index)
      [(Variant _ size _ payloads)
        (if (and (= size 8) (tc-inline-payload-layout-list-empty? payloads))
          (tc-inline-enum-variants-tag-only-at? variants (+ index 1))
          false)])))

(define (tc-inline-enum-layout-tag-only?
  [size : i64]
  [variants : TcInlineVariantLayoutList]) : bool
  (and (= size 8) (tc-inline-enum-variants-tag-only? variants)))

(define (tc-inline-payload-layout-index [payload : TcInlinePayloadLayout]) : i64
  (match payload
    [(Payload index _ _) index]))

(define (tc-inline-payload-layout-type [payload : TcInlinePayloadLayout]) : ast.AstType
  (match payload
    [(Payload _ ty _) ty]))

(define (tc-inline-payload-layout-offset [payload : TcInlinePayloadLayout]) : i64
  (match payload
    [(Payload _ _ offset) offset]))

(define (tc-inline-payload-layout-list-offset
  [payloads : TcInlinePayloadLayoutList]
  [index : i64]) : i64
  (tc-inline-payload-layout-list-offset-at payloads index 0))

(define (tc-inline-payload-layout-list-offset-at
  [payloads : TcInlinePayloadLayoutList]
  [payload-index : i64]
  [index : i64]) : i64
  (if (>= index (tc-inline-payload-layout-list-count payloads))
    -1
    (let
      [payload : TcInlinePayloadLayout
        (tc-inline-payload-layout-list-ref payloads index)]
      (begin
        (cfg
          compile-profile
          (counters.bump! tc-profile-layout-inline-payload-visits))
        (if (=
          (tc-inline-payload-layout-index (tc-global-shared-view payload))
          payload-index)
          (tc-inline-payload-layout-offset payload)
          (tc-inline-payload-layout-list-offset-at
            payloads
            payload-index
            (+ index 1)))))))

(define (tc-inline-variant-layout-name-id [variant : TcInlineVariantLayout]) : i64
  (match variant
    [(Variant name _ _ _) name]))

(define (tc-inline-variant-layout-payloads [variant : TcInlineVariantLayout]) : TcInlinePayloadLayoutList
  (match variant
    [(Variant _ _ _ payloads) payloads]))

(define (tc-inline-variant-layout-member-id [name-id : i64]) : i64
  (if (or (< name-id 0) (>= name-id (ci.intern-capacity)))
    -1
    (ci.intern-dotted-final-id name-id)))

(define (tc-inline-variant-layout-name-matches-id?
  [stored-id : i64]
  [name-id : i64]) : bool
  (or
    (= stored-id name-id)
    (let
      [stored-member-id : i64 (tc-inline-variant-layout-member-id stored-id)]
      [name-member-id : i64 (tc-inline-variant-layout-member-id name-id)]
      (and
        (>= stored-member-id 0)
        (>= name-member-id 0)
        (or
          (= stored-member-id name-member-id)
          (string.eq
            (ci.intern-str stored-member-id)
            (ci.intern-str name-member-id)))))))

(define (tc-inline-variant-layout-list-payload-offset-exact-id
  [variants : TcInlineVariantLayoutList]
  [name-id : i64]
  [index : i64]) : i64
  (tc-inline-variant-layout-list-payload-offset-exact-id-at
    variants
    name-id
    index
    0))

(define (tc-inline-variant-layout-list-payload-offset-exact-id-at
  [variants : TcInlineVariantLayoutList]
  [name-id : i64]
  [payload-index : i64]
  [index : i64]) : i64
  (if (>= index (tc-inline-variant-layout-list-count variants))
    -1
    (let
      [variant : TcInlineVariantLayout
        (tc-inline-variant-layout-list-ref variants index)]
      (begin
        (cfg
          compile-profile
          (counters.bump! tc-profile-layout-inline-variant-visits))
        (if (=
          (tc-inline-variant-layout-name-id (tc-global-shared-view variant))
          name-id)
          (tc-inline-payload-layout-list-offset
            (tc-inline-variant-layout-payloads variant)
            payload-index)
          (tc-inline-variant-layout-list-payload-offset-exact-id-at
            variants
            name-id
            payload-index
            (+ index 1)))))))

(define (tc-inline-variant-layout-list-payload-offset-fallback-id
  [variants : TcInlineVariantLayoutList]
  [name-id : i64]
  [index : i64]) : i64
  (tc-inline-variant-layout-list-payload-offset-fallback-id-at
    variants
    name-id
    index
    0))

(define (tc-inline-variant-layout-list-payload-offset-fallback-id-at
  [variants : TcInlineVariantLayoutList]
  [name-id : i64]
  [payload-index : i64]
  [index : i64]) : i64
  (if (>= index (tc-inline-variant-layout-list-count variants))
    -1
    (let
      [variant : TcInlineVariantLayout
        (tc-inline-variant-layout-list-ref variants index)]
      (begin
        (cfg
          compile-profile
          (counters.bump! tc-profile-layout-inline-variant-visits))
        (if (tc-inline-variant-layout-name-matches-id?
          (tc-inline-variant-layout-name-id (tc-global-shared-view variant))
          name-id)
          (tc-inline-payload-layout-list-offset
            (tc-inline-variant-layout-payloads variant)
            payload-index)
          (tc-inline-variant-layout-list-payload-offset-fallback-id-at
            variants
            name-id
            payload-index
            (+ index 1)))))))

(define (tc-inline-aggregate-layout-size [layout : TcInlineAggregateLayout]) : i64
  (match layout
    [(Struct size _ _) size]
    [(Enum size _ _) size]))

(define (tc-inline-aggregate-layout-align [layout : TcInlineAggregateLayout]) : i64
  (match layout
    [(Struct _ align _) align]
    [(Enum _ align _) align]))

(define (tc-inline-aggregate-layout-field-offset-id
  [layout : TcInlineAggregateLayout]
  [name-id : i64]) : i64
  (match layout
    [(Struct _ _ fields) (tc-inline-field-layout-list-offset-id fields name-id)]
    [(Enum _ _ _) -1]))

(define (tc-inline-aggregate-layout-variant-payload-offset-id
  [layout : TcInlineAggregateLayout]
  [name-id : i64]
  [index : i64]) : i64
  (match layout
    [(Struct _ _ _) -1]
    [(Enum _ _ variants)
      (let
        [exact : i64
          (tc-inline-variant-layout-list-payload-offset-exact-id
            (tc-global-shared-view variants)
            name-id
            index)]
        (if (>= exact 0)
          exact
          (tc-inline-variant-layout-list-payload-offset-fallback-id
            variants
            name-id
            index)))]))

(define (tc-align-up [n : i64] [align : i64]) : i64
  (if (<= align 1)
    n
    (* (/ (+ n (- align 1)) align) align)))

(define (tc-max-i64 [a : i64] [b : i64]) : i64
  (if (> a b)
    a
    b))

(define (tc-struct-decl-id [ctx : TcContext] [struct-name-id : i64]) : ResultTcStructDecl
  (let
    [symbols : (& ctx csym.CompilerSymbols) (tc-context-symbols ctx)]
    [handle : i64
      (csym.compiler-symbols-lookup-type-id-or
        symbols
        struct-name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (if (=
        (csym.compiler-symbol-handle-kind handle)
        (csym.compiler-symbol-kind-defstruct))
        (let
          [decl
            (try
              (csym.compiler-symbols-decl-at-index
                symbols
                (csym.compiler-symbol-handle-index handle)))]
          (match decl
            [(or (DefStruct _ _ repr cleanup fields)
                 (DefStructLifetimes _ _ _ repr cleanup fields))
              (Ok (TcStructDecl repr cleanup fields))]
            [_ (Err "typecheck: struct symbol owner is not a struct")]))
        (Err
          (str_cat.str-cat
            "typecheck: unknown struct "
            (tc-nominal-name-id-display struct-name-id))))
      (Err
        (str_cat.str-cat
          "typecheck: unknown struct "
          (tc-nominal-name-id-display struct-name-id))))))

(define (tc-struct-decl-at-handle
  [ctx : TcContext]
  [handle : i64]
  [struct-name-id : i64]
  [_ : (& _ str)]) : ResultTcStructDecl
  (if (and
    (csym.compiler-symbols-handle-found? handle)
    (=
      (csym.compiler-symbol-handle-kind handle)
      (csym.compiler-symbol-kind-defstruct)))
    (let
      [decl : ast.AstDecl
        (try
          (csym.compiler-symbols-decl-at-index
            (tc-context-symbols ctx)
            (csym.compiler-symbol-handle-index handle)))]
      (match decl
        [(or (DefStruct _ _ repr cleanup fields)
             (DefStructLifetimes _ _ _ repr cleanup fields))
          (Ok (TcStructDecl repr cleanup fields))]
        [_ (Err "typecheck: struct symbol owner is not a struct")]))
    (tc-struct-decl-id ctx struct-name-id)))

(define (tc-enum-decl-id [ctx : TcContext] [enum-name-id : i64]) : ResultTcEnumDecl
  (let
    [symbols : (& ctx csym.CompilerSymbols) (tc-context-symbols ctx)]
    [handle : i64
      (csym.compiler-symbols-lookup-type-id-or
        symbols
        enum-name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (if (=
        (csym.compiler-symbol-handle-kind handle)
        (csym.compiler-symbol-kind-defenum))
        (let
          [decl : ast.AstDecl
            (try
              (csym.compiler-symbols-decl-at-index
                symbols
                (csym.compiler-symbol-handle-index handle)))]
          (match decl
            [(or (DefEnum _ _ cleanup variants)
                 (DefEnumLifetimes _ _ _ cleanup variants))
              (Ok (TcEnumDecl cleanup variants))]
            [_ (Err "typecheck: enum symbol owner is not an enum")]))
        (Err
          (str_cat.str-cat
            "typecheck: unknown enum "
            (tc-nominal-name-id-display enum-name-id))))
      (Err
        (str_cat.str-cat
          "typecheck: unknown enum "
          (tc-nominal-name-id-display enum-name-id))))))

(define (tc-inline-aggregate-cycle-stack-render [stack : TcStringList]) : String
  (if (tc-string-list-empty? stack)
    ""
    (let
      [head : String (tc-string-list-head (tc-global-shared-view stack))]
      [tail : String
        (tc-inline-aggregate-cycle-stack-render (tc-string-list-rest stack))]
      (if (string.eq tail "")
        head
        (str_cat.str-cat tail " -> " head)))))

(define (tc-inline-aggregate-cycle-path [stack : TcStringList] [name : String]) : String
  (let
    [prefix : String (tc-inline-aggregate-cycle-stack-render stack)]
    (if (string.eq prefix "")
      name
      (str_cat.str-cat prefix " -> " name))))

(define (tc-inline-aggregate-cycle-message
  [name : String]
  [stack : TcStringList]) : String
  (str_cat.str-cat
    "typecheck: inline aggregate layout cycle "
    (tc-inline-aggregate-cycle-path stack (tc-global-shared-view name))
    "; insert (Box "
    name
    ") at the recursive edge"))

(define (tc-inline-aggregate-type-list-finite-ok
  [ctx : TcContext]
  [types : ast.AstTypeList]
  [stack : TcStringList]) : ResultTcUnit
  (tc-inline-aggregate-type-list-finite-ok-at ctx (& types) stack 0))

(define (tc-inline-aggregate-type-list-finite-ok-at
  [ctx : TcContext]
  [types : (& types ast.AstTypeList)]
  [stack : TcStringList]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast.ast-type-list-len types))
    Ok
    (let
      [_
        (try
          (tc-inline-aggregate-type-finite-ok
            ctx
            (tc-context-type-get
              ctx
              (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))
            (tc-global-shared-view stack)))]
      (tc-inline-aggregate-type-list-finite-ok-at ctx types stack (+ index 1)))))

(define (tc-inline-aggregate-fields-finite-ok
  [ctx : TcContext]
  [fields : ast.AstFieldDefList]
  [stack : TcStringList]) : ResultTcUnit
  (tc-inline-aggregate-fields-finite-ok-at ctx (& fields) stack 0))

(define (tc-inline-aggregate-fields-finite-ok-at
  [ctx : TcContext]
  [fields : (& fields ast.AstFieldDefList)]
  [stack : TcStringList]
  [index : i64]) : ResultTcUnit
  (if (>= index fields.len)
    Ok
    (match (ast.ast-field-def-list-get
      fields
      index
      (ast.ast-field-def-fallback))
      [(Def _ ty _)
        (let
          [_
            (try
              (tc-inline-aggregate-type-finite-ok
                ctx
                ty
                (tc-global-shared-view stack)))]
          (tc-inline-aggregate-fields-finite-ok-at ctx fields stack (+ index 1)))])))

(define (tc-inline-aggregate-variants-finite-ok
  [ctx : TcContext]
  [variants : ast.AstVariantDefList]
  [stack : TcStringList]) : ResultTcUnit
  (tc-inline-aggregate-variants-finite-ok-at ctx (& variants) stack 0))

(define (tc-inline-aggregate-variants-finite-ok-at
  [ctx : TcContext]
  [variants : (& variants ast.AstVariantDefList)]
  [stack : TcStringList]
  [index : i64]) : ResultTcUnit
  (if (>= index variants.len)
    Ok
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(Def _ fields _)
        (let
          [_
            (try
              (tc-inline-aggregate-type-list-finite-ok
                ctx
                fields
                (tc-global-shared-view stack)))]
          (tc-inline-aggregate-variants-finite-ok-at
            ctx
            variants
            stack
            (+ index 1)))])))

(define (tc-inline-aggregate-context-for-name-id
  [ctx : TcContext]
  [name-id : i64]) : TcContext
  (if (and
    (>= name-id 0)
    (tc-name-qualified-id? (tc-context-structural-session ctx) name-id))
    (let
      [module-id : i64 (tc-qualified-name-module-id name-id)]
      (if (>= module-id 0)
        (tc-context-with-module-id
          ctx
          (tc-env-key-name-text module-id)
          module-id)
        ctx))
    ctx))

(define (tc-inline-aggregate-nominal-finite-ok
  [ctx : TcContext]
  [name : String]
  [name-id : i64]
  [stack : TcStringList]) : ResultTcUnit
  (if (tc-string-list-contains
    (tc-global-shared-view stack)
    (tc-global-shared-view name))
    (Err (tc-inline-aggregate-cycle-message name stack))
    (let
      [handle : i64
        (csym.compiler-symbols-lookup-type-id-or
          (tc-context-symbols ctx)
          name-id
          (csym.compiler-symbols-missing-handle))]
      (if (csym.compiler-symbols-handle-found? handle)
        (if (=
          (csym.compiler-symbol-handle-kind handle)
          (csym.compiler-symbol-kind-defenum))
          (let
            [variants
              (try
                (tc-context-enum-variants-at-handle
                  ctx
                  handle
                  name-id
                  (tc-global-shared-view name)))]
            (tc-inline-aggregate-variants-finite-ok
              ctx
              variants
              (tc-string-list-cons stack name)))
          (if (=
            (csym.compiler-symbol-handle-kind handle)
            (csym.compiler-symbol-kind-defstruct))
            (let
              [decl (try (tc-struct-decl-at-handle ctx handle name-id name))]
              (match decl
                [(TcStructDecl _ _ fields)
                  (tc-inline-aggregate-fields-finite-ok
                    ctx
                    fields
                    (tc-string-list-cons stack name))]))
            (Err (str_cat.str-cat "typecheck: unknown aggregate " name))))
        (match (tc-context-enum-variants-id
          ctx
          name-id
          (tc-global-shared-view name))
          [(Ok variants)
            (tc-inline-aggregate-variants-finite-ok
              (tc-inline-aggregate-context-for-name-id ctx name-id)
              variants
              (tc-string-list-cons stack name))]
          [(Err _) (Err (str_cat.str-cat "typecheck: unknown aggregate " name))])))))

(define (tc-inline-aggregate-type-finite-ok
  [ctx : TcContext]
  [ty : ast.AstType]
  [stack : TcStringList]) : ResultTcUnit
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(Tuple elems)
      (tc-inline-aggregate-type-list-finite-ok
        ctx
        (ast.ast-type-list-box-shared-view elems)
        stack)]
    [(Array elem _)
      (tc-inline-aggregate-type-finite-ok
        ctx
        (tc-context-type-get ctx elem)
        stack)]
    [(or (Enum name) (EnumArgs name _) (Struct name) (StructArgs name _))
      (tc-inline-aggregate-nominal-finite-ok
        ctx
        (tc-nominal-name-id-display name)
        name
        stack)]
    [_ Ok]))

;; Test fixtures select a parsed declaration by expected spelling. This is a
;; lookup-only adapter; production compiler paths carry the declaration id.
(define (tc-inline-aggregate-layout-finite-ok
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : ResultTcUnit
  (tc-inline-aggregate-nominal-finite-ok ctx name name-id Nil))

(define (tc-inline-aggregate-layout-info [size : i64] [align : i64]) : TcLayoutInfo
  (TcLayoutInfo size align))

(define (tc-inline-aggregate-pointer-layout-info) : TcLayoutInfo
  (tc-inline-aggregate-layout-info 8 8))

(define (tc-inline-aggregate-zero-layout-info) : TcLayoutInfo
  (tc-inline-aggregate-layout-info 0 1))

(define (tc-inline-aggregate-finish-layout [cursor : i64] [max-align : i64]) : TcLayoutInfo
  (let
    [align : i64
      (if (= max-align 0)
        1
        max-align)]
    (tc-inline-aggregate-layout-info (tc-align-up cursor align) align)))

(define (tc-inline-aggregate-array-size
  [elem-size : i64]
  [elem-align : i64]
  [count : i64]) : i64
  (if (<= count 0)
    0
    (* (tc-align-up elem-size elem-align) count)))

(define (tc-inline-aggregate-field-defs-layout
  [ctx : TcContext]
  [repr : (& repr ast.AstStructRepr)]
  [fields : ast.AstFieldDefList]
  [cursor : i64]
  [max-align : i64]
  [stack : TcStringList]) : ResultTcInlineFieldsLayout
  (let
    [layout : TcInlineFieldLayoutList
      (tc-inline-field-layout-list-with-count-for-state
        (tc-job-state-agg-layout-cache (tc-context-job-state ctx))
        fields.len)]
    (tc-inline-aggregate-field-defs-layout-at
      ctx
      repr
      (& fields)
      0
      cursor
      max-align
      stack
      layout)))

(define (tc-inline-aggregate-field-defs-layout-at
  [ctx : TcContext]
  [repr : (& repr ast.AstStructRepr)]
  [fields : (& fields ast.AstFieldDefList)]
  [index : i64]
  [cursor : i64]
  [max-align : i64]
  [stack : TcStringList]
  [layout : TcInlineFieldLayoutList]) : ResultTcInlineFieldsLayout
  (if (>= index fields.len)
    (match (tc-inline-aggregate-finish-layout cursor max-align)
      [(TcLayoutInfo size align) (Ok (Fields size align layout))])
    (match (ast.ast-field-def-list-get
      fields
      index
      (ast.ast-field-def-fallback))
      [(Def name ty _)
        (let
          [resolved : ast.AstType (tc-resolve-type ctx ty)]
          [info
            (try
              (tc-inline-aggregate-type-layout-with-stack
                ctx
                (tc-global-shared-view resolved)
                (tc-global-shared-view stack)))]
          ;; A field's `(:align N)` raises only this field's placement
          ;; and the containing struct's alignment, never its size.
          [field-align : i64
            (tc-max-i64
              (tc-layout-info-align info)
              (ast.ast-struct-repr-field-declared-align repr index))]
          [field-size : i64 (tc-layout-info-size info)]
          [offset : i64 (tc-align-up cursor field-align)]
          [next-cursor : i64 (+ offset field-size)]
          [next-align : i64 (tc-max-i64 max-align field-align)]
          (begin
            (cfg
              compile-profile
              (counters.bump! tc-profile-layout-inline-field-builds))
            (tc-inline-field-layout-list-set!
              (tc-global-shared-view layout)
              index
              (Field (ci.intern-syntax-id-value name) resolved offset))
            (tc-inline-aggregate-field-defs-layout-at
              ctx
              repr
              fields
              (+ index 1)
              next-cursor
              next-align
              stack
              layout)))])))

(define (tc-inline-aggregate-payloads-layout
  [ctx : TcContext]
  [types : ast.AstTypeList]
  [cursor : i64]
  [max-align : i64]
  [stack : TcStringList]) : ResultTcInlinePayloadFieldsLayout
  (let
    [layout : TcInlinePayloadLayoutList
      (tc-inline-payload-layout-list-with-count-for-state
        (tc-job-state-agg-layout-cache (tc-context-job-state ctx))
        (ast.ast-type-list-len (& types)))]
    (tc-inline-aggregate-payloads-layout-at
      ctx
      (& types)
      0
      cursor
      max-align
      stack
      layout)))

(define (tc-inline-aggregate-payloads-layout-at
  [ctx : TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [cursor : i64]
  [max-align : i64]
  [stack : TcStringList]
  [layout : TcInlinePayloadLayoutList]) : ResultTcInlinePayloadFieldsLayout
  (if (>= index (ast.ast-type-list-len types))
    (match (tc-inline-aggregate-finish-layout cursor max-align)
      [(TcLayoutInfo size align) (Ok (Fields size align layout))])
    (let
      [ty : ast.AstType
        (tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      [info
        (try
          (tc-inline-aggregate-type-layout-with-stack
            ctx
            (tc-global-shared-view ty)
            (tc-global-shared-view stack)))]
      [field-align : i64 (tc-layout-info-align info)]
      [field-size : i64 (tc-layout-info-size info)]
      [offset : i64 (tc-align-up cursor field-align)]
      [next-cursor : i64 (+ offset field-size)]
      [next-align : i64 (tc-max-i64 max-align field-align)]
      (begin
        (cfg
          compile-profile
          (counters.bump! tc-profile-layout-inline-payload-builds))
        (tc-inline-payload-layout-list-set!
          layout
          index
          (Payload index ty offset))
        (tc-inline-aggregate-payloads-layout-at
          ctx
          types
          (+ index 1)
          next-cursor
          next-align
          stack
          layout)))))

;; Lay out a structural type list exactly like the fields of a C aggregate.
;; Unlike the payload/field walkers above this helper only needs the completed
;; size/alignment, so it is also used by anonymous tuples.  Keeping the walk in
;; typecheck makes nested tuple/array layout agree with nominal aggregates and
;; gives every caller the same cycle/error propagation behavior.
(define (tc-inline-aggregate-type-list-layout
  [ctx : TcContext]
  [types : ast.AstTypeList]
  [cursor : i64]
  [max-align : i64]
  [stack : TcStringList]) : ResultTcLayoutInfo
  (tc-inline-aggregate-type-list-layout-at
    ctx
    (& types)
    0
    cursor
    max-align
    stack))

(define (tc-inline-aggregate-type-list-layout-at
  [ctx : TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [cursor : i64]
  [max-align : i64]
  [stack : TcStringList]) : ResultTcLayoutInfo
  (if (>= index (ast.ast-type-list-len types))
    (match (tc-inline-aggregate-finish-layout cursor max-align)
      [(TcLayoutInfo size align) (Ok (TcLayoutInfo size align))])
    (let
      [ty : ast.AstType
        (tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      [info
        (try
          (tc-inline-aggregate-type-layout-with-stack
            ctx
            ty
            (tc-global-shared-view stack)))]
      [field-align : i64 (tc-layout-info-align info)]
      [field-size : i64 (tc-layout-info-size info)]
      [offset : i64 (tc-align-up cursor field-align)]
      [next-cursor : i64 (+ offset field-size)]
      [next-align : i64 (tc-max-i64 max-align field-align)]
      (tc-inline-aggregate-type-list-layout-at
        ctx
        types
        (+ index 1)
        next-cursor
        next-align
        stack))))

(define (tc-inline-aggregate-struct-layout-with-stack
  [ctx : TcContext]
  [struct-name : String]
  [struct-name-id : i64]
  [handle : i64]
  [stack : TcStringList]) : ResultTcInlineAggregateLayout
  (if (tc-string-list-contains
    (tc-global-shared-view stack)
    (tc-global-shared-view struct-name))
    (Err (tc-inline-aggregate-cycle-message struct-name stack))
    (let
      [decl : TcStructDecl
        (try (tc-struct-decl-at-handle ctx handle struct-name-id struct-name))]
      (match decl
        [(TcStructDecl repr _ fields)
          (let
            ;; A struct's `(:align N)` seeds the aggregate alignment, so it
            ;; raises the final alignment and rounds the size up to it.
            [layout : TcInlineFieldsLayout
              (try
                (tc-inline-aggregate-field-defs-layout
                  ctx
                  (& repr)
                  fields
                  0
                  (ast.ast-struct-repr-declared-align (& repr))
                  (tc-string-list-cons stack struct-name)))]
            (match layout
              [(Fields size align fields-layout)
                (Ok (Struct size align fields-layout))]))]))))

(define (tc-inline-aggregate-variants-layout
  [ctx : TcContext]
  [variants : ast.AstVariantDefList]
  [max-size : i64]
  [max-align : i64]
  [stack : TcStringList]) : ResultTcInlineAggregateLayout
  (let
    [layout : TcInlineVariantLayoutList
      (tc-inline-variant-layout-list-with-count-for-state
        (tc-job-state-agg-layout-cache (tc-context-job-state ctx))
        variants.len)]
    (tc-inline-aggregate-variants-layout-at
      ctx
      (& variants)
      max-size
      max-align
      stack
      0
      layout)))

(define (tc-inline-aggregate-variants-layout-at
  [ctx : TcContext]
  [variants : (& variants ast.AstVariantDefList)]
  [max-size : i64]
  [max-align : i64]
  [stack : TcStringList]
  [index : i64]
  [layout : TcInlineVariantLayoutList]) : ResultTcInlineAggregateLayout
  (if (>= index variants.len)
    (Ok (Enum (tc-align-up max-size max-align) max-align layout))
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(Def variant-name fields _)
        (let
          [payload-layout
            (try
              (tc-inline-aggregate-payloads-layout
                ctx
                fields
                8
                8
                (tc-global-shared-view stack)))]
          (match payload-layout
            [(Fields variant-size variant-align payloads)
              (let
                [next-size : i64 (tc-max-i64 max-size variant-size)]
                [next-align : i64 (tc-max-i64 max-align variant-align)]
                (begin
                  (cfg
                    compile-profile
                    (counters.bump! tc-profile-layout-inline-variant-builds))
                  (tc-inline-variant-layout-list-set!
                    layout
                    index
                    (Variant variant-name variant-size variant-align payloads))
                  (tc-inline-aggregate-variants-layout-at
                    ctx
                    variants
                    next-size
                    next-align
                    stack
                    (+ index 1)
                    layout)))]))])))

(define (tc-inline-aggregate-enum-layout-with-stack
  [ctx : TcContext]
  [enum-name : String]
  [enum-name-id : i64]
  [handle : i64]
  [stack : TcStringList]) : ResultTcInlineAggregateLayout
  (if (tc-string-list-contains
    (tc-global-shared-view stack)
    (tc-global-shared-view enum-name))
    (Err (tc-inline-aggregate-cycle-message enum-name stack))
    (let
      [variants
        (try
          (tc-context-enum-variants-at-handle
            ctx
            handle
            enum-name-id
            (tc-global-shared-view enum-name)))]
      (tc-inline-aggregate-variants-layout
        ctx
        variants
        8
        8
        (tc-string-list-cons stack enum-name)))))

;; --- full inline-aggregate layout memo ---------------------------------------
;; Without it, every struct-get field offset, enum payload offset, and
;; lower-type-size query on a nominal recomputes the whole recursive
;; tc-inline-aggregate-* layout (the scalar caches memoize only the final size
;; and the register-word count as scalars). This cache memoizes the COMPLETE
;; TcInlineAggregateLayout per type name. Like the scalar caches,
;; this cache is keyed by the intern id of the nominal name: symbol handles can
;; be reassigned when specialization rebuilds the symbol table, while intern ids
;; are stable until intern-reset!. The cached value's final-size backing arrays
;; are allocated in the cache state's retained payload owner before storing --
;; a layout computed in a transient lowering scratch arena would otherwise
;; dangle after that arena rewinds (the scratch-arena hazard).
(define tc-agg-layout-cache-capacity : i64
  65536)

;; A reset empties only the table slots filled since the previous one (#8520),
;; up to this many; past it, the reset empties the whole table.
(define tc-agg-layout-cache-log-capacity : i64
  8192)

(define (tc-agg-layout-cache-table-storage-ensure-for-state!
  [state : TcAggLayoutCacheState]) : unit
  (let
    [data : (MutPtr TcAggLayoutCacheStateData)
      (tc-agg-layout-cache-state-ptr state)]
    (unsafe
      (if (=
        (array-length (deref data).agg-layout-cache)
        tc-agg-layout-cache-capacity)
        unit
        (in-arena
          (arena.Arena (deref data).owner-arena)
          (set!
            (deref data).agg-layout-cache
            (__tl_make-array TcAggLayoutCacheSlot tc-agg-layout-cache-capacity))
          ;; A fresh table holds no valid slots, so its first reset fills it
          ;; all.
          (let
            [filled : (__tl_dyn-array i64)
              (__tl_make-array i64 (+ tc-agg-layout-cache-log-capacity 1))]
            (set! (array-ref filled 0) (+ tc-agg-layout-cache-log-capacity 1))
            (set! (deref data).agg-layout-filled filled)))))))

(define (tc-agg-layout-cache-table-storage-ensure-for-job!
  [job-state : TcJobState]) : unit
  (tc-agg-layout-cache-table-storage-ensure-for-state!
    (tc-job-state-agg-layout-cache job-state)))

;; `make-array` does not produce valid Empty enum slots, so the fill is
;; mandatory before the first probe. Validate against the owning source-name
;; session rather than whichever compatibility interner is process-active.
(define (tc-agg-layout-cache-ensure-for-state!
  [state : TcAggLayoutCacheState]
  [intern-table-id : i64]
  [intern-generation : i64]) : unit
  (tc-agg-layout-cache-table-storage-ensure-for-state! state)
  (let
    [data : (Ptr TcAggLayoutCacheStateData)
      (tc-agg-layout-cache-state-view state)]
    (unsafe
      (unless
        (and
          (= (deref data).intern-table-id intern-table-id)
          (= (deref data).intern-generation intern-generation))
        (tc-agg-layout-cache-storage-reset-for-state! state)
        (let
          [next-data : (MutPtr TcAggLayoutCacheStateData)
            (tc-agg-layout-cache-state-ptr state)]
          (set! (deref next-data).intern-table-id intern-table-id)
          (set! (deref next-data).intern-generation intern-generation))))))

;; Cache key: the stable i64 identity of the nominal type name. Source intern
;; ids and structural/generated ids occupy different numeric domains, so hash
;; the full id into an open-addressed table rather than indexing the array by
;; id. Symbol handles cannot be used because specialization rebuilds the symbol
;; table and shifts handle indexes mid-compile.
(define (tc-agg-layout-cache-slot-key [name-id : i64]) : i64
  (bit-and
    (bit-xor name-id (shr name-id 16))
    (- tc-agg-layout-cache-capacity 1)))

;; The cache's slot table, for readers that walk every cached layout.
(define (tc-agg-layout-cache-slots [state : TcAggLayoutCacheState]) : (__tl_dyn-array
    TcAggLayoutCacheSlot)
  (unsafe
    (deref (tc-agg-layout-cache-state-view state)).agg-layout-cache))

(define (tc-agg-layout-cache-probe-slot-for-state
  [state : TcAggLayoutCacheState]
  [name-id : i64]) : i64
  (let
    [data : (Ptr TcAggLayoutCacheStateData)
      (tc-agg-layout-cache-state-view state)]
    [slots : (__tl_dyn-array TcAggLayoutCacheSlot)
      (unsafe
        (deref data).agg-layout-cache)]
    [cursor : i64 (tc-agg-layout-cache-slot-key name-id)]
    [steps : i64 0]
    (while (< steps tc-agg-layout-cache-capacity)
      (match (tc-global-array-element-shared-view slots cursor)
        [(Empty) (return cursor)]
        [(Full cached-id _)
          (if (= cached-id name-id)
            (return cursor)
            (begin
              (set!
                cursor
                (bit-and (+ cursor 1) (- tc-agg-layout-cache-capacity 1)))
              (set! steps (+ steps 1))))]))
    -1))

;; Layout arrays are allocated in the persistent program arena at their final
;; size, so the completed value can be stored without recursively cloning it.
;; Only fully-resolved Ok layouts reach this point, so a cached entry can never
;; participate in a cycle (its computation already terminated).
(define (tc-agg-layout-cache-store-for-state!
  [state : TcAggLayoutCacheState]
  [slot : i64]
  [name-id : i64]
  [layout : TcInlineAggregateLayout]) : unit
  (set!
    (array-ref
      (unsafe
        (deref (tc-agg-layout-cache-state-view state)).agg-layout-cache)
      slot)
    (TcAggLayoutCacheSlot.Full name-id layout))
  (tc-agg-layout-cache-note-filled!
    (unsafe
      (deref (tc-agg-layout-cache-state-view state)).agg-layout-filled)
    slot))

;; Log table slot SLOT as filled in FILLED, the layout cache's fill log: slot 0
;; is the count and the indices follow. A count above the log capacity means
;; the next reset empties the whole table.
(define (tc-agg-layout-cache-note-filled!
  [filled : (__tl_dyn-array i64)]
  [slot : i64]) : unit
  (let
    [count : i64 (array-ref filled 0)]
    (if (< count tc-agg-layout-cache-log-capacity)
      (begin
        (set! (array-ref filled (+ count 1)) slot)
        (set! (array-ref filled 0) (+ count 1)))
      (set! (array-ref filled 0) (+ tc-agg-layout-cache-log-capacity 1)))))

(define (tc-inline-aggregate-layout-kind-dispatch
  [ctx : TcContext]
  [name : String]
  [name-id : i64]
  [handle : i64]
  [stack : TcStringList]) : ResultTcInlineAggregateLayout
  (let
    [layout-ctx : TcContext
      (tc-context-with-nominal-owner-index-module
        ctx
        (csym.compiler-symbol-handle-index handle))]
    (if (=
      (csym.compiler-symbol-handle-kind handle)
      (csym.compiler-symbol-kind-defenum))
      (tc-inline-aggregate-enum-layout-with-stack
        layout-ctx
        name
        name-id
        handle
        stack)
      (if (=
        (csym.compiler-symbol-handle-kind handle)
        (csym.compiler-symbol-kind-defstruct))
        (tc-inline-aggregate-struct-layout-with-stack
          layout-ctx
          name
          name-id
          handle
          stack)
        (Err (str_cat.str-cat "typecheck: unknown aggregate " name))))))

(define (tc-inline-aggregate-layout-fill-cache
  [ctx : TcContext]
  [name : String]
  [handle : i64]
  [stack : TcStringList]
  [name-id : i64]
  [slot : i64]) : ResultTcInlineAggregateLayout
  (let
    [state : TcAggLayoutCacheState
      (tc-job-state-agg-layout-cache (tc-context-job-state ctx))]
    [data : (Ptr TcAggLayoutCacheStateData)
      (tc-agg-layout-cache-state-view state)]
    [slots : (__tl_dyn-array TcAggLayoutCacheSlot)
      (unsafe
        (deref data).agg-layout-cache)]
    [layout
      (try
        (tc-inline-aggregate-layout-kind-dispatch
          ctx
          (tc-global-shared-view name)
          name-id
          handle
          (tc-global-shared-view stack)))]
    (tc-agg-layout-cache-store-for-state! state slot name-id layout)
    (match (tc-global-array-element-shared-view slots slot)
      [(Full _ cached) (Ok cached)]
      [(Empty)
        ;; Unreachable: the slot was just stored. Recompute defensively.
        (tc-inline-aggregate-layout-kind-dispatch ctx name name-id handle stack)])))

(define (tc-inline-aggregate-layout-for-with-stack
  [ctx : TcContext]
  [name : String]
  [name-id : i64]
  [stack : TcStringList]) : ResultTcInlineAggregateLayout
  (let
    [state : TcAggLayoutCacheState
      (tc-job-state-agg-layout-cache (tc-context-job-state ctx))]
    [source-names : ci.InternSourceNameSessionHandle
      (tc-context-source-names ctx)]
    [handle : i64
      (tc-type-handle-lookup-id
        (tc-job-state-nominal-cache (tc-context-job-state ctx))
        (tc-context-symbols ctx)
        name-id
        tc-type-handle-lookup-caller-aggregate-layout)]
    (if (csym.compiler-symbols-handle-found? handle)
      (begin
        (tc-agg-layout-cache-ensure-for-state!
          state
          (ci.intern-source-name-session-handle-table-id source-names)
          (ci.intern-source-name-session-handle-reset-generation source-names))
        (let
          [data : (Ptr TcAggLayoutCacheStateData)
            (tc-agg-layout-cache-state-view state)]
          [slots : (__tl_dyn-array TcAggLayoutCacheSlot)
            (unsafe
              (deref data).agg-layout-cache)]
          [slot : i64 (tc-agg-layout-cache-probe-slot-for-state state name-id)]
          (if (< slot 0)
            (begin
              (cfg
                compile-profile
                (counters.bump! tc-profile-layout-cache-bypasses))
              (tc-inline-aggregate-layout-kind-dispatch
                ctx
                name
                name-id
                handle
                stack))
            (match (tc-global-array-element-shared-view slots slot)
              [(Full _ layout)
                (begin
                  (cfg
                    compile-profile
                    (counters.bump! tc-profile-layout-cache-hits))
                  (Ok layout))]
              [(Empty)
                (begin
                  (cfg
                    compile-profile
                    (counters.bump! tc-profile-layout-cache-misses))
                  (tc-inline-aggregate-layout-fill-cache
                    ctx
                    name
                    handle
                    stack
                    name-id
                    slot))]))))
      (match (tc-context-enum-variants-id
        ctx
        name-id
        (tc-global-shared-view name))
        [(Ok _)
          (tc-inline-aggregate-enum-layout-with-stack
            (tc-inline-aggregate-context-for-name-id ctx name-id)
            name
            name-id
            -1
            stack)]
        [(Err _) (Err (str_cat.str-cat "typecheck: unknown aggregate " name))]))))

;; Borrowed Slices and `bytes` are fat references (`ast.ast-type-fat-referent?`):
;; a data pointer plus a signed length. Their referent is stored in the type
;; pool, so inspect that node here rather than treating every Ref/MutRef as a
;; one-word pointer. Region wrappers on either the reference itself (stripped
;; by the caller) or its immediate referent do not change the representation.
(define (tc-inline-aggregate-fat-reference? [ctx : TcContext] [inner : i64]) : bool
  (ast.ast-type-fat-referent?
    (&
      (tc-type-strip-region
        (tc-resolve-type ctx (tc-context-type-get ctx inner))))))

(define (tc-inline-aggregate-type-layout-with-stack
  [ctx : TcContext]
  [ty : ast.AstType]
  [stack : TcStringList]) : ResultTcLayoutInfo
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(or (I64) (U64) (F64)) (Ok (tc-inline-aggregate-layout-info 8 8))]
    [(or (I32) (U32) (F32)) (Ok (tc-inline-aggregate-layout-info 4 4))]
    [(or (I16) (U16)) (Ok (tc-inline-aggregate-layout-info 2 2))]
    [(or (I8) (U8) (Bool) (Char)) (Ok (tc-inline-aggregate-layout-info 1 1))]
    [(or (Unit) (Never) (Expr) (ExprList))
      (Ok (tc-inline-aggregate-zero-layout-info))]
    [(or (Func _ _) (DynArray _) (Box _) (CFunc _ _) (Ptr _) (MutPtr _) (String)
         (Str) (Var _) (VarArgs _ _))
      (Ok (tc-inline-aggregate-pointer-layout-info))]
    [(Slice _)
      (Err
        "typecheck: slice has no by-value layout; use a borrowed slice reference")]
    [(or (Ref _ inner) (MutRef _ inner))
      (if (tc-inline-aggregate-fat-reference? ctx inner)
        (Ok (tc-inline-aggregate-layout-info 16 8))
        (Ok (tc-inline-aggregate-pointer-layout-info)))]
    [(or (Region _ inner) (Invalidate _ inner))
      (tc-inline-aggregate-type-layout-with-stack
        ctx
        (tc-context-type-get ctx inner)
        stack)]
    [(Bytes)
      (Err
        "typecheck: bytes has no by-value layout; use (& lifetime bytes) or (&mut lifetime bytes)")]
    [(Tuple types)
      (tc-inline-aggregate-type-list-layout
        ctx
        (ast.ast-type-list-box-shared-view types)
        0
        0
        stack)]
    [(Array elem count)
      (let
        [elem-info : TcLayoutInfo
          (try
            (tc-inline-aggregate-type-layout-with-stack
              ctx
              (tc-context-type-get ctx elem)
              stack))]
        (Ok
          (TcLayoutInfo
            (tc-inline-aggregate-array-size
              (tc-layout-info-size elem-info)
              (tc-layout-info-align elem-info)
              count)
            (tc-layout-info-align elem-info))))]
    [(or (Struct name) (StructArgs name _) (Enum name) (EnumArgs name _))
      (let
        [layout : TcInlineAggregateLayout
          (try
            (tc-inline-aggregate-layout-for-with-stack
              ctx
              (tc-nominal-name-id-display name)
              name
              stack))]
        (Ok
          (TcLayoutInfo
            (tc-inline-aggregate-layout-size (tc-global-shared-view layout))
            (tc-inline-aggregate-layout-align layout))))]))

(define (tc-inline-aggregate-type-layout [ctx : TcContext] [ty : ast.AstType]) : ResultTcLayoutInfo
  (tc-inline-aggregate-type-layout-with-stack ctx ty Nil))

(define (tc-inline-aggregate-layout-for-id [ctx : TcContext] [name-id : i64]) : ResultTcInlineAggregateLayout
  (tc-inline-aggregate-layout-for-with-stack
    ctx
    (tc-nominal-name-id-display name-id)
    name-id
    Nil))

;; Compile-time cache: memoize the inline-aggregate SIZE. Without it,
;; tc-inline-aggregate-layout-for-with-stack re-walks the whole layout on every
;; lower-type-size query. The cache must do NO allocation during lowering
;; (the scratch-arena hazard makes a grown map / cached field-list dangle):
;; so it is a FIXED job-owned i64 array, allocated lazily in the owning compiler
;; job's lifetime arena and only read/written by that job thereafter. It is keyed
;; by the intern id of the nominal type name: symbol handles can be reassigned
;; when specialization rebuilds the symbol table, while intern ids are
;; append-only until that owning interner is reset.
;; A size is encoded as size+1 (0 = uncached); only fully-resolved layouts are
;; cached (Err forward-refs stay uncached until their nested types resolve).
;; Entries are valid only for the current program; tc-agg-caches-reset! forces
;; the next query to clear them at lower boundaries.
(define tc-agg-scalar-cache-capacity : i64
  400000)

;; These scalar caches are keyed by intern id, not by symbol-handle INDEX, which
;; is only meaningful for one snapshot of a program's symbol table. Specialization
;; rebuilds that table after inserting generated declarations, so a cached value
;; under an old handle index could be returned for a different type whose new
;; handle reuses the same index. Intern ids are stable across that rebuild.
;; The owning source-name session's table and reset generation are the cheap
;; clear tokens across programs, while tc-agg-caches-reset-for-job! covers
;; lower/test paths that reuse cache arrays without resetting the intern table.
;;
;; A scalar cache array ends with its fill log: past the `capacity` table slots,
;; a count cell, then up to `tc-agg-scalar-cache-log-capacity` keys filled since
;; the last clear, so a clear costs what the program cached rather than the
;; whole table (#8520). A count above the log capacity means the log
;; overflowed, or the array is fresh and its contents unknown: the next clear
;; then empties the whole table.
(define tc-agg-scalar-cache-log-capacity : i64
  16384)
(define tc-agg-scalar-cache-length : i64
  (+ tc-agg-scalar-cache-capacity (+ tc-agg-scalar-cache-log-capacity 1)))

(define (tc-agg-scalar-cache-new) : (__tl_dyn-array i64)
  (let
    [slots : (__tl_dyn-array i64)
      (__tl_make-array i64 tc-agg-scalar-cache-length)]
    (set!
      (array-ref slots tc-agg-scalar-cache-capacity)
      (+ tc-agg-scalar-cache-log-capacity 1))
    slots))

;; Log table slot KEY of SLOTS as filled.
(define (tc-agg-scalar-cache-note-filled!
  [slots : (&mut slots (__tl_dyn-array i64))]
  [key : i64]) : unit
  (let
    [count : i64 (array-ref slots tc-agg-scalar-cache-capacity)]
    (if (< count tc-agg-scalar-cache-log-capacity)
      (begin
        (set!
          (array-ref slots (+ tc-agg-scalar-cache-capacity (+ count 1)))
          key)
        (set! (array-ref slots tc-agg-scalar-cache-capacity) (+ count 1)))
      (set!
        (array-ref slots tc-agg-scalar-cache-capacity)
        (+ tc-agg-scalar-cache-log-capacity 1)))))

;; Empty every table slot filled since the last clear: the logged keys, or the
;; whole table when the log overflowed. The table then caches nothing.
(define (tc-agg-scalar-cache-clear! [slots : (&mut slots (__tl_dyn-array i64))]) : unit
  (let
    [count : i64 (array-ref slots tc-agg-scalar-cache-capacity)]
    [index : i64 0]
    (if (> count tc-agg-scalar-cache-log-capacity)
      (while (< index tc-agg-scalar-cache-capacity)
        (set! (array-ref slots index) 0)
        (set! index (+ index 1)))
      (while (< index count)
        (set!
          (array-ref
            slots
            (array-ref slots (+ tc-agg-scalar-cache-capacity (+ index 1))))
          0)
        (set! index (+ index 1))))
    (set! (array-ref slots tc-agg-scalar-cache-capacity) 0)))

(define (tc-agg-size-cache-storage-ensure-for-state!
  [state : TcAggScalarCacheState]) : unit
  (let
    [data : (MutPtr TcAggScalarCacheStateData)
      (tc-agg-scalar-cache-state-ptr state)]
    (unsafe
      (if (= (array-length (deref data).size-cache) tc-agg-scalar-cache-length)
        unit
        (in-arena
          (arena.Arena (deref data).owner-arena)
          (set! (deref data).size-cache (tc-agg-scalar-cache-new)))))))

(define (tc-agg-size-cache-storage-ensure-for-job! [job-state : TcJobState]) : unit
  (tc-agg-size-cache-storage-ensure-for-state!
    (tc-job-state-agg-scalar-caches job-state)))

(define (tc-agg-size-cache-ensure-for-state!
  [state : TcAggScalarCacheState]
  [intern-table-id : i64]
  [intern-generation : i64]) : unit
  (tc-agg-size-cache-storage-ensure-for-state! state)
  (let
    [data : TcAggScalarCacheStateData (tc-agg-scalar-cache-state-data state)]
    (unless
      (and
        (= data.size-intern-table-id intern-table-id)
        (= data.size-intern-generation intern-generation))
      (tc-agg-scalar-cache-clear! (&mut data.size-cache))
      (set! data.size-intern-table-id intern-table-id)
      (set! data.size-intern-generation intern-generation)
      (tc-agg-scalar-cache-state-data-set! state data))))

(define (tc-agg-scalar-cache-key-id [name-id : i64]) : i64
  (if (>= name-id tc-agg-scalar-cache-capacity)
    (- 0 1)
    name-id))

(define (tc-inline-aggregate-size-cached
  [ctx : TcContext]
  [name-id : i64]
  [fallback : i64]) : i64
  (let
    [state : TcAggScalarCacheState
      (tc-job-state-agg-scalar-caches (tc-context-job-state ctx))]
    [source-names : ci.InternSourceNameSessionHandle
      (tc-context-source-names ctx)]
    (tc-agg-size-cache-ensure-for-state!
      state
      (ci.intern-source-name-session-handle-table-id source-names)
      (ci.intern-source-name-session-handle-reset-generation source-names))
    (let
      [key : i64 (tc-agg-scalar-cache-key-id name-id)]
      (if (< key 0)
        (match (tc-inline-aggregate-layout-for-with-stack
          ctx
          (tc-nominal-name-id-display name-id)
          name-id
          Nil)
          [(Ok layout) (tc-inline-aggregate-layout-size layout)]
          [(Err _) fallback])
        (let
          [data : (Ptr TcAggScalarCacheStateData)
            (tc-agg-scalar-cache-state-view state)]
          [slots : (__tl_dyn-array i64)
            (unsafe
              (deref data).size-cache)]
          [cached : i64 (array-ref slots key)]
          (if (> cached 0)
            (- cached 1)
            (match (tc-inline-aggregate-layout-for-with-stack
              ctx
              (tc-nominal-name-id-display name-id)
              name-id
              Nil)
              [(Ok layout)
                (let
                  [size : i64 (tc-inline-aggregate-layout-size layout)]
                  (set! (array-ref slots key) (+ size 1))
                  (tc-agg-scalar-cache-note-filled! (&mut slots) key)
                  size)]
              [(Err _) fallback])))))))

;; Same arena-safe fixed cache for bare aggregate ALIGN queries. Lowering
;; asks for alignment on the same hot aggregate paths as size; rebuilding the full
;; layout here defeats the size/regword caches.
(define (tc-agg-align-cache-storage-ensure-for-state!
  [state : TcAggScalarCacheState]) : unit
  (let
    [data : (MutPtr TcAggScalarCacheStateData)
      (tc-agg-scalar-cache-state-ptr state)]
    (unsafe
      (if (= (array-length (deref data).align-cache) tc-agg-scalar-cache-length)
        unit
        (in-arena
          (arena.Arena (deref data).owner-arena)
          (set! (deref data).align-cache (tc-agg-scalar-cache-new)))))))

(define (tc-agg-align-cache-storage-ensure-for-job! [job-state : TcJobState]) : unit
  (tc-agg-align-cache-storage-ensure-for-state!
    (tc-job-state-agg-scalar-caches job-state)))

(define (tc-agg-align-cache-ensure-for-state!
  [state : TcAggScalarCacheState]
  [intern-table-id : i64]
  [intern-generation : i64]) : unit
  (tc-agg-align-cache-storage-ensure-for-state! state)
  (let
    [data : TcAggScalarCacheStateData (tc-agg-scalar-cache-state-data state)]
    (unless
      (and
        (= data.align-intern-table-id intern-table-id)
        (= data.align-intern-generation intern-generation))
      (tc-agg-scalar-cache-clear! (&mut data.align-cache))
      (set! data.align-intern-table-id intern-table-id)
      (set! data.align-intern-generation intern-generation)
      (tc-agg-scalar-cache-state-data-set! state data))))

(define (tc-inline-aggregate-align-cached
  [ctx : TcContext]
  [name-id : i64]
  [fallback : i64]) : i64
  (let
    [state : TcAggScalarCacheState
      (tc-job-state-agg-scalar-caches (tc-context-job-state ctx))]
    [source-names : ci.InternSourceNameSessionHandle
      (tc-context-source-names ctx)]
    (tc-agg-align-cache-ensure-for-state!
      state
      (ci.intern-source-name-session-handle-table-id source-names)
      (ci.intern-source-name-session-handle-reset-generation source-names))
    (let
      [key : i64 (tc-agg-scalar-cache-key-id name-id)]
      (if (< key 0)
        (match (tc-inline-aggregate-layout-for-with-stack
          ctx
          (tc-nominal-name-id-display name-id)
          name-id
          Nil)
          [(Ok layout) (tc-inline-aggregate-layout-align layout)]
          [(Err _) fallback])
        (let
          [data : (Ptr TcAggScalarCacheStateData)
            (tc-agg-scalar-cache-state-view state)]
          [slots : (__tl_dyn-array i64)
            (unsafe
              (deref data).align-cache)]
          [cached : i64 (array-ref slots key)]
          (if (> cached 0)
            (- cached 1)
            (match (tc-inline-aggregate-layout-for-with-stack
              ctx
              (tc-nominal-name-id-display name-id)
              name-id
              Nil)
              [(Ok layout)
                (let
                  [align : i64 (tc-inline-aggregate-layout-align layout)]
                  (set! (array-ref slots key) (+ align 1))
                  (tc-agg-scalar-cache-note-filled! (&mut slots) key)
                  align)]
              [(Err _) fallback])))))))

;; Compile-time cache: memoize a bare aggregate's register-resident word count
;; (0 = not register-resident, else 1 or 2). Same arena-safe intern-id keyed
;; fixed array as the size cache; this is the hot query for every aggregate
;; construct / struct-get / copy (lower-type-register-words). Encoded as
;; words+1 (0 = uncached). Only fully-resolved layouts are cached.
;; Same per-program keying as the size cache, so it is gated on
;; intern-generation and explicitly invalidated at lower boundaries.
(define (tc-agg-regwords-cache-storage-ensure-for-state!
  [state : TcAggScalarCacheState]) : unit
  (let
    [data : (MutPtr TcAggScalarCacheStateData)
      (tc-agg-scalar-cache-state-ptr state)]
    (unsafe
      (if (=
        (array-length (deref data).regwords-cache)
        tc-agg-scalar-cache-length)
        unit
        (in-arena
          (arena.Arena (deref data).owner-arena)
          (set! (deref data).regwords-cache (tc-agg-scalar-cache-new)))))))

(define (tc-agg-regwords-cache-storage-ensure-for-job! [job-state : TcJobState]) : unit
  (tc-agg-regwords-cache-storage-ensure-for-state!
    (tc-job-state-agg-scalar-caches job-state)))

(define (tc-agg-scalar-caches-reset-for-job! [job-state : TcJobState]) : unit
  (let
    [state : TcAggScalarCacheState (tc-job-state-agg-scalar-caches job-state)]
    [data : (MutPtr TcAggScalarCacheStateData)
      (tc-agg-scalar-cache-state-ptr state)]
    (unsafe
      (set! (deref data).size-intern-table-id -1)
      (set! (deref data).size-intern-generation -1)
      (set! (deref data).align-intern-table-id -1)
      (set! (deref data).align-intern-generation -1)
      (set! (deref data).regwords-intern-table-id -1)
      (set! (deref data).regwords-intern-generation -1))))

(define (tc-agg-layout-cache-reset-for-job! [job-state : TcJobState]) : unit
  (let
    [address : i64 (tc-job-state-agg-layout-cache-address job-state)]
    (if (> address 0)
      (let
        [state : TcAggLayoutCacheState (TcAggLayoutCacheState address)]
        [data : (MutPtr TcAggLayoutCacheStateData)
          (tc-agg-layout-cache-state-ptr state)]
        (unsafe
          (set! (deref data).intern-table-id -1)
          (set! (deref data).intern-generation -1)))
      unit)))

(define (tc-agg-caches-reset-for-job! [job-state : TcJobState]) : unit
  (tc-agg-layout-cache-reset-for-job! job-state)
  (tc-agg-scalar-caches-reset-for-job! job-state))

(define (tc-agg-caches-reset!) : unit
  (tc-agg-caches-reset-for-job! (tc-serial-job-state)))

(define (tc-agg-regwords-cache-ensure-for-state!
  [state : TcAggScalarCacheState]
  [intern-table-id : i64]
  [intern-generation : i64]) : unit
  (tc-agg-regwords-cache-storage-ensure-for-state! state)
  (let
    [data : TcAggScalarCacheStateData (tc-agg-scalar-cache-state-data state)]
    (unless
      (and
        (= data.regwords-intern-table-id intern-table-id)
        (= data.regwords-intern-generation intern-generation))
      (tc-agg-scalar-cache-clear! (&mut data.regwords-cache))
      (set! data.regwords-intern-table-id intern-table-id)
      (set! data.regwords-intern-generation intern-generation)
      (tc-agg-scalar-cache-state-data-set! state data))))

(define (tc-inline-aggregate-regwords-compute [ctx : TcContext] [name-id : i64]) : i64
  (match (tc-inline-aggregate-layout-for-with-stack
    ctx
    (tc-nominal-name-id-display name-id)
    name-id
    Nil)
    [(Ok layout)
      (if (tc-inline-aggregate-layout-register-resident?
        (tc-global-shared-view layout))
        (/ (+ (tc-inline-aggregate-layout-size layout) 7) 8)
        0)]
    [(Err _) 0]))

(define (tc-inline-aggregate-regwords-cached [ctx : TcContext] [name-id : i64]) : i64
  (let
    [state : TcAggScalarCacheState
      (tc-job-state-agg-scalar-caches (tc-context-job-state ctx))]
    [source-names : ci.InternSourceNameSessionHandle
      (tc-context-source-names ctx)]
    (tc-agg-regwords-cache-ensure-for-state!
      state
      (ci.intern-source-name-session-handle-table-id source-names)
      (ci.intern-source-name-session-handle-reset-generation source-names))
    (let
      [key : i64 (tc-agg-scalar-cache-key-id name-id)]
      (if (< key 0)
        (tc-inline-aggregate-regwords-compute ctx name-id)
        (let
          [data : (Ptr TcAggScalarCacheStateData)
            (tc-agg-scalar-cache-state-view state)]
          [slots : (__tl_dyn-array i64)
            (unsafe
              (deref data).regwords-cache)]
          [cached : i64 (array-ref slots key)]
          (if (> cached 0)
            (- cached 1)
            (match (tc-inline-aggregate-layout-for-with-stack
              ctx
              (tc-nominal-name-id-display name-id)
              name-id
              Nil)
              [(Ok layout)
                (let
                  [words : i64
                    (if (tc-inline-aggregate-layout-register-resident?
                      (tc-global-shared-view layout))
                      (/ (+ (tc-inline-aggregate-layout-size layout) 7) 8)
                      0)]
                  (set! (array-ref slots key) (+ words 1))
                  (tc-agg-scalar-cache-note-filled! (&mut slots) key)
                  words)]
              [(Err _) 0])))))))

;; A struct/enum layout is "register-resident (1-word)" when it fits in a
;; single 8-byte machine word and is built only of word-class data. Such a value
;; can live in a register end-to-end (packed/extracted by shift+mask) instead of
;; round-tripping through a memory slot.
;;
;; Scope (slice 2): single-word STRUCTs (all fields word-class) AND nullary
;; size-8 ENUMs. A size-8 enum is necessarily nullary -- the tag occupies the
;; whole first word at offset 0, so any variant payload would force size >= 16 --
;; hence its single register-resident word is just the discriminant tag.
;;
;; This makes `=` on a nullary enum a tag (structural) compare rather than the
;; old stack-slot handle compare: two separately-constructed values of the same
;; variant now compare equal, which is the intended value-semantics for a POD
;; tag (and matches what `match` already observes). Bootstrap fixpoint +
;; integration corpus are the canary that the compiler's own codegen does not
;; depend on the prior handle-identity behavior.
(define (tc-inline-aggregate-layout-register-resident?
  [layout : TcInlineAggregateLayout]) : bool
  (match layout
    [(Struct size _ fields)
      ;; An integer-class struct of 1 word (8 B) or 2 words (16 B) whose
      ;; fields are all supported register classes is register-resident --
      ;; carried in one or two register-class words end-to-end. Beyond the
      ;; INTEGER-only gate, exact f64 SSE eightbytes and homogeneous packed
      ;; f32 SSE eightbytes are admitted while mixed int/float words stay
      ;; memory-backed.
      (if (or (= size 8) (= size 16))
        (tc-inline-fields-all-register-class? fields)
        false)]
    ;; An enum is register-resident at 1 word (size 8 -- necessarily
    ;; nullary, the tag word) or 2 words (size 16 -- tag in word0, a single
    ;; supported register-class payload in word1). Larger or unsupported
    ;; aggregate-payload enums keep the memory path.
    [(Enum size _ variants)
      (if (or (= size 8) (= size 16))
        (tc-inline-enum-payloads-all-register-class? variants)
        false)]))

(define (tc-name-register-resident-id? [ctx : TcContext] [name-id : i64]) : bool
  (match (tc-inline-aggregate-layout-for-id ctx name-id)
    [(Ok layout) (tc-inline-aggregate-layout-register-resident? layout)]
    [(Err _) false]))

(define (tc-ctfe-inline-layout-fields-into
  [fields : TcInlineFieldLayoutList]
  [out : ctfe_support.CtfeLayoutFieldList]) : ctfe_support.CtfeLayoutFieldList
  (tc-ctfe-inline-layout-fields-into-at fields out 0))

(define (tc-ctfe-inline-layout-fields-into-at
  [fields : TcInlineFieldLayoutList]
  [out : ctfe_support.CtfeLayoutFieldList]
  [index : i64]) : ctfe_support.CtfeLayoutFieldList
  (if (>= index (tc-inline-field-layout-list-count fields))
    out
    (match (tc-inline-field-layout-list-ref fields index)
      [(Field name _ offset)
        (tc-ctfe-inline-layout-fields-into-at
          fields
          (ctfe_support.ctfe-layout-field-list-push-id
            out
            (Field (tc-env-key-name-text name) offset)
            name)
          (+ index 1))])))

(define (tc-ctfe-inline-layout-field-count [fields : TcInlineFieldLayoutList]) : i64
  (tc-inline-field-layout-list-count fields))

(define (tc-ctfe-inline-layout-fields [fields : TcInlineFieldLayoutList]) : ctfe_support.CtfeLayoutFieldList
  (tc-ctfe-inline-layout-fields-into
    (tc-global-shared-view fields)
    (ctfe_support.ctfe-layout-field-list-with-capacity
      (tc-ctfe-inline-layout-field-count fields))))

(define (tc-ctfe-inline-aggregate-layout-info
  [name : String]
  [layout : TcInlineAggregateLayout]) : ctfe_support.CtfeLayoutInfo
  (match layout
    [(Struct size align fields)
      (Info name true size align (tc-ctfe-inline-layout-fields fields))]
    [(Enum size align _)
      (Info name false size align (ctfe_support.ctfe-layout-field-list-empty))]))

(define (tc-ctfe-struct-layout-info
  [ctx : TcContext]
  [struct-name : String]
  [struct-name-id : i64]) : ctfe_support.CtfeLayoutInfo
  (match (tc-inline-aggregate-layout-for-id ctx struct-name-id)
    [(Ok layout) (tc-ctfe-inline-aggregate-layout-info struct-name layout)]
    [(Err _)
      (Info struct-name false 8 8 (ctfe_support.ctfe-layout-field-list-empty))]))

(define (tc-ctfe-type-layout-info
  [ctx : TcContext]
  [type-name : String]
  [type-name-id : i64]) : ctfe_support.CtfeLayoutInfo
  (match (tc-inline-aggregate-layout-for-id ctx type-name-id)
    [(Ok layout) (tc-ctfe-inline-aggregate-layout-info type-name layout)]
    [(Err _)
      (Info type-name false 8 8 (ctfe_support.ctfe-layout-field-list-empty))]))

(define (tc-ctfe-layout-add-alias
  [layouts : ctfe_support.CtfeLayoutInfoList]
  [info : ctfe_support.CtfeLayoutInfo]
  [alias : String]
  [alias-id : i64]) : ctfe_support.CtfeLayoutInfoList
  (match info
    [(Info _ repr-c? size align fields)
      (ctfe_support.ctfe-layout-info-list-add-if-missing-id
        layouts
        (Info alias repr-c? size align fields)
        alias-id)]))

(define (tc-ctfe-layout-add-names
  [layouts : ctfe_support.CtfeLayoutInfoList]
  [info : ctfe_support.CtfeLayoutInfo]
  [key-id : i64]
  [name : String]
  [name-id : i64]
  [module : String]) : ctfe_support.CtfeLayoutInfoList
  (let
    [with-key : ctfe_support.CtfeLayoutInfoList
      (ctfe_support.ctfe-layout-info-list-add-if-missing-id
        layouts
        (tc-global-shared-view info)
        key-id)]
    (if (= (string.string-length module) 0)
      with-key
      (tc-ctfe-layout-add-alias with-key info name name-id))))

(define (tc-ctfe-layouts-add-struct
  [ctx : TcContext]
  [layouts : ctfe_support.CtfeLayoutInfoList]
  [module : String]
  [module-id : i64]
  [name : i64]) : ctfe_support.CtfeLayoutInfoList
  (let
    [name-str : String (tc-env-key-name-text name)]
    [key : String
      (csym.compiler-symbol-module-key
        (tc-global-shared-view module)
        (tc-global-shared-view name-str))]
    [key-id : i64
      (if (= (string.string-length module) 0)
        name
        (tc-module-name-id-by-id module-id name))]
    [info : ctfe_support.CtfeLayoutInfo
      (tc-ctfe-struct-layout-info ctx key key-id)]
    (tc-ctfe-layout-add-names layouts info key-id name-str name module)))

(define (tc-ctfe-layouts-add-enum
  [ctx : TcContext]
  [layouts : ctfe_support.CtfeLayoutInfoList]
  [module : String]
  [module-id : i64]
  [name : i64]) : ctfe_support.CtfeLayoutInfoList
  (let
    [name-str : String (tc-env-key-name-text name)]
    [key : String
      (csym.compiler-symbol-module-key
        (tc-global-shared-view module)
        (tc-global-shared-view name-str))]
    [key-id : i64
      (if (= (string.string-length module) 0)
        name
        (tc-module-name-id-by-id module-id name))]
    [info : ctfe_support.CtfeLayoutInfo
      (tc-ctfe-type-layout-info ctx key key-id)]
    (tc-ctfe-layout-add-names layouts info key-id name-str name module)))

(define (tc-ctfe-layouts-from-decls
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [module : String]
  [module-id : i64]
  [layouts : ctfe_support.CtfeLayoutInfoList]) : ctfe_support.CtfeLayoutInfoList
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [index : i64 0]
    [current-module : String module]
    [current-module-id : i64 module-id]
    [current-layouts : ctfe_support.CtfeLayoutInfoList layouts]
    ;; One match on the backing slot instead of a borrowed tag test followed by
    ;; an `ast-decl-list-ref` re-read (a 104 B SRET row copy for every
    ;; declaration that passed the test, plus a second out-of-line call for the
    ;; test itself). Every arm here binds only an i64 name, so the projection
    ;; match loads the tag and one word.
    [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
    [decl-offset : i64 decls.offset]
    (while (< index count)
      (match (array-ref decl-slots (+ decl-offset index))
        [(Module next-module)
          (set! current-module (tc-env-key-name-text next-module))
          (set! current-module-id next-module)]
        [(or (DefStruct _ name _ _ _) (DefStructLifetimes _ name _ _ _ _))
          (set!
            current-layouts
            (tc-ctfe-layouts-add-struct
              ctx
              current-layouts
              (tc-global-shared-view current-module)
              current-module-id
              name))]
        [(or (DefEnum _ name _ _) (DefEnumLifetimes _ name _ _ _))
          (set!
            current-layouts
            (tc-ctfe-layouts-add-enum
              ctx
              current-layouts
              (tc-global-shared-view current-module)
              current-module-id
              name))]
        [_ unit])
      (set! index (+ index 1)))
    current-layouts))

(define (tc-ctfe-layouts [ctx : TcContext]) : ctfe_support.CtfeLayoutInfoList
  (let
    [program : ast.AstProgram (tc-context-program ctx)]
    (match program
      [(Program decls-box)
        (let
          [decls : ast.AstDeclList
            (ast.ast-decl-list-box-shared-view decls-box)]
          (ctfe_support.ctfe-build-seen-reset!)
          (tc-ctfe-layouts-from-decls
            ctx
            (tc-global-shared-view decls)
            ""
            cbi.compiler-builtin-id-fix-empty
            (ctfe_support.ctfe-layout-info-list-with-capacity
              ;; Splice extension grows this owner-arena vector
              ;; geometrically; reserve only the known program surface.
              (ctfe_support.ctfe-metadata-decl-capacity decls))))])))

;; The comptime evaluator has no import scope, so each type literal of a
;; comptime expression is resolved here, in the module being checked, to the
;; declaration identity an ordinary annotation names: `(type other.Point)`
;; reaches the layout and reflection entries of `size_dep/Point` (#8112).
;; Literals whose resolution is their written type stay out of the table, so
;; an unknown type still reaches the evaluator's own diagnostic.
(define (tc-ctfe-type-literal-resolutions-into
  [ctx : TcContext]
  [resolutions : (&mut resolutions ctfe_support.CtfeTypeLiteralResolutions)]
  [expr : ast.AstExpr]) : unit
  (let
    [children : ast.AstExprList
      (ast.ast-expr-child-ids (tc-global-shared-view expr))]
    [count : i64 (ast.ast-expr-list-len (& children))]
    [index : i64 0]
    (match (tc-global-shared-view expr)
      [(TypeLiteral ty-id)
        (let
          [written : ast.AstType (tc-context-type-get ctx ty-id)]
          [resolved : ast.AstType
            (tc-resolve-type ctx (tc-global-shared-view written))]
          (unless
            (ast.ast-type-eq?
              (tc-global-shared-view written)
              (tc-global-shared-view resolved))
            (ast.ast-type-list-push (&mut resolutions.written) ty-id)
            (ast.ast-type-list-push
              (&mut resolutions.resolved)
              (ast.ast-node-pool-context-type-push
                (tc-context-pools ctx)
                resolved))))]
      [_ unit])
    (while (< index count)
      (tc-ctfe-type-literal-resolutions-into
        ctx
        resolutions
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& children) index -1)))
      (set! index (+ index 1)))))

;; The CTFE environment for evaluating the source comptime expression `expr`.
(define (tc-ctfe-env-for-comptime [ctx : TcContext] [expr : ast.AstExpr]) : ctfe_support.CtfeEnv
  (let
    [env : ctfe_support.CtfeEnv (tc-ctfe-env ctx)]
    [resolutions : ctfe_support.CtfeTypeLiteralResolutions
      (ctfe_support.ctfe-type-literal-resolutions-empty)]
    (tc-ctfe-type-literal-resolutions-into ctx (&mut resolutions) expr)
    (if (ast.ast-type-list-empty? (& resolutions.written))
      env
      (ctfe_support.ctfe-env-with-type-literals env resolutions))))

;; CTFE base environment (reflection + layout metadata). This is invariant across
;; a single compile (same program/symbols/registries), but is requested up to ~8
;; times per compile -- once in macro expansion plus once per comptime evaluation
;; in the typecheck and lower passes -- and each `ctfe-reflections-from-program` /
;; `tc-ctfe-layouts` build walks the whole program (O(program), tens of MB). The
;; cache is reset per compile at the top of `macro-expand-program` (which always
;; runs first) and populated by whichever request arrives first:
;; `macro-expand-ctfe-env-build-once!` at expansion entry, or -- for the
;; typecheck/lower comptime requests after the job setup cleared the cache --
;; right here, built ONCE into the pool context's base arena so the cached value
;; never dangles into a rewound scratch arena. Later requests rebase the cached
;; env onto their own pools instead of rebuilding.
;; Compiles that never request metadata keep the empty env for their whole
;; lifetime, so those O(program) walks run only when metadata is consumed.
;; A generator import a module has not materialized yet, such as an instance
;; another module generated first, resolves through its lazy-import stub, not
;; through an import declaration. Reflection resolves a declaration's dotted
;; field types through the same aliases (#8474), so the cached env takes every
;; stub recorded since it last synced. Returns the cached env.
(define (tc-ctfe-env-sync-import-stubs! [state : TcMacroState]) : ctfe_support.CtfeEnv
  (let
    [env : ctfe_support.CtfeEnv
      (tc-macro-walk-field state macro-expand-ctfe-env-value)]
    [lazy-state : TcLazyImportState (tc-macro-state-lazy-import state)]
    [_ready : unit (tc-lazy-import-stubs-ensure-for-state! state lazy-state)]
    [data : TcLazyImportStateData (tc-lazy-import-state-data lazy-state)]
    [synced : i64
      (if (<
        data.record-count
        (tc-macro-walk-field state macro-expand-ctfe-env-import-stubs))
        0
        (tc-macro-walk-field state macro-expand-ctfe-env-import-stubs))]
    [owner : i64 (tc-macro-walk-field state macro-expand-ctfe-env-owner-arena)]
    (if (or
      (= data.record-count synced)
      (not (tc-macro-walk-field state macro-expand-ctfe-env-has-metadata))
      (= owner 0))
      env
      (let
        [synced-env : ctfe_support.CtfeEnv
          (in-arena
            (arena.Arena owner)
            (let
              [reflections : ctfe_support.CtfeReflectInfoList
                (ctfe_support.ctfe-env-reflections (& env))]
              [index : i64 synced]
              (while (< index data.record-count)
                (let
                  [alias-id : i64 (array-ref data.alias-ids index)]
                  [target-id : i64 (array-ref data.target-ids index)]
                  (unless
                    (= target-id alias-id)
                    (set!
                      reflections
                      (ctfe_support.ctfe-reflect-info-list-add-alias
                        reflections
                        (array-ref data.module-ids index)
                        alias-id
                        target-id))))
                (set! index (+ index 1)))
              (ctfe_support.ctfe-env-with-reflections env reflections)))]
        (tc-macro-walk-set! state macro-expand-ctfe-env-value synced-env)
        (tc-macro-walk-set!
          state
          macro-expand-ctfe-env-import-stubs
          data.record-count)
        synced-env))))

(define (tc-ctfe-env [ctx : TcContext]) : ctfe_support.CtfeEnv
  (let
    [state : TcMacroState (tc-context-macro-state ctx)]
    (if (tc-macro-walk-field state macro-expand-ctfe-env-ready)
      (ctfe_support.ctfe-env-rebase-pools
        (tc-ctfe-env-sync-import-stubs! state)
        (tc-context-pools ctx))
      (if (tc-macro-walk-field state ctfe-needs-metadata)
        (let
          [owner : i64
            (ast.ast-node-pool-context-base-arena (tc-context-pools ctx))]
          [built : ctfe_support.CtfeEnv
            (in-arena
              (arena.Arena owner)
              (ctfe_support.ctfe-env-with-metadata-and-pools-and-source-names-and-macro-state
                (tc-ctfe-layouts ctx)
                (ctfe_support.ctfe-reflections-from-program
                  (tc-context-program ctx))
                (tc-context-pools ctx)
                (tc-context-source-names ctx)
                (tc-macro-ctfe-state state)))]
          (tc-macro-walk-set! state macro-expand-ctfe-env-value built)
          (tc-macro-walk-set! state macro-expand-ctfe-env-owner-arena owner)
          (tc-macro-walk-set! state macro-expand-ctfe-env-has-metadata true)
          (tc-macro-walk-set! state macro-expand-ctfe-env-ready true)
          (tc-macro-walk-set! state macro-expand-ctfe-env-import-stubs 0)
          (tc-ctfe-env-sync-import-stubs! state))
        (ctfe_support.ctfe-env-empty-with-pools-and-source-names-and-macro-state
          (tc-context-pools ctx)
          (tc-context-source-names ctx)
          (tc-macro-ctfe-state state))))))

(define (tc-string-prefix? [text : String] [prefix : String]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [prefix-len : i64 (string.string-length prefix)]
    (if (< text-len prefix-len)
      false
      (string.eq (string.substring text 0 prefix-len) prefix))))

(define (tc-result-info-enum-id [info : TcResultInfo]) : i64
  (match info
    [(TcResultInfo _ enum-id _ _ _ _) enum-id]))

(define (tc-result-info-kind [info : TcResultInfo]) : TcTryKind
  (match info
    [(TcResultInfo kind _ _ _ _ _) kind]))

(define (tc-result-info-ok-id [info : TcResultInfo]) : i64
  (match info
    [(TcResultInfo _ _ ok-id _ _ _) ok-id]))

(define (tc-result-info-ok-type [info : TcResultInfo]) : ast.AstType
  (match info
    [(TcResultInfo _ _ _ ok-ty _ _) ok-ty]))

(define (tc-result-info-err-id [info : TcResultInfo]) : i64
  (match info
    [(TcResultInfo _ _ _ _ err-id _) err-id]))

(define (tc-result-info-err-type [info : TcResultInfo]) : ast.AstType
  (match info
    [(TcResultInfo _ _ _ _ _ err-ty) err-ty]))

(define (tc-ok-variant-name? [name : i64]) : bool
  (tc-string-prefix? (tc-env-key-name-text name) "Ok"))

(define (tc-err-variant-name? [name : i64]) : bool
  (tc-string-prefix? (tc-env-key-name-text name) "Err"))

(define (tc-some-variant-name? [name : i64]) : bool
  (tc-string-prefix? (tc-env-key-name-text name) "Some"))

(define (tc-none-variant-name? [name : i64]) : bool
  (tc-string-prefix? (tc-env-key-name-text name) "None"))

(define (tc-result-variant-payload-type
  [ctx : TcContext]
  [variant-name : i64]
  [fields : ast.AstTypeList]) : ResultTcType
  (if (= (ast.ast-type-list-len (& fields)) 1)
    (Ok
      (tc-resolve-type
        ctx
        (tc-context-type-get
          ctx
          (ast.ast-type-list-get (& fields) 0 (ast.ast-type-id-fallback)))))
    (Err
      (str_cat.str-cat
        "typecheck: try requires Result-like variant with one payload "
        (ci.intern-str variant-name)))))

;; `ok-value?` holds for a `try` operand, whose `Ok*` payload is the value the
;; `try` yields: a payload-free `Ok*` yields `unit`, and more than one payload
;; is rejected. The enclosing function's family is only ever built through its
;; `Err*` variant, so its `Ok*` variant may carry any number of payloads; the
;; recorded Ok type is then `unit`.
(define (tc-result-info-build
  [ctx : TcContext]
  [ok-value? : bool]
  [try-kind : TcTryKind]
  [enum-name : i64]
  [ok-name : i64]
  [ok-fields : ast.AstTypeList]
  [err-name : i64]
  [err-fields : ast.AstTypeList]) : ResultTcResultInfo
  (let
    [ok-count : i64 (ast.ast-type-list-len (& ok-fields))]
    [ok-ty : ast.AstType
      (if (or (= ok-count 0) (and (> ok-count 1) (not ok-value?)))
        (Unit)
        (try (tc-result-variant-payload-type ctx ok-name ok-fields)))]
    [err-ty : ast.AstType
      (try (tc-result-variant-payload-type ctx err-name err-fields))]
    (Ok (TcResultInfo try-kind enum-name ok-name ok-ty err-name err-ty))))

(define (tc-option-none-variant-type
  [variant-name : i64]
  [fields : ast.AstTypeList]) : ResultTcType
  (if (ast.ast-type-list-empty? (& fields))
    (Ok (Unit))
    (Err
      (str_cat.str-cat
        "typecheck: try requires Option-like variant with no payload "
        (ci.intern-str variant-name)))))

(define (tc-option-info-build
  [ctx : TcContext]
  [enum-name : i64]
  [some-name : i64]
  [some-fields : ast.AstTypeList]
  [none-name : i64]
  [none-fields : ast.AstTypeList]) : ResultTcResultInfo
  (let
    [some-ty (try (tc-result-variant-payload-type ctx some-name some-fields))]
    [none-ty (try (tc-option-none-variant-type none-name none-fields))]
    (Ok
      (TcResultInfo TcTryOption enum-name some-name some-ty none-name none-ty))))

(define (tc-result-info-two-variants
  [ctx : TcContext]
  [ok-value? : bool]
  [enum-name : i64]
  [first-name : i64]
  [first-fields : ast.AstTypeList]
  [second-name : i64]
  [second-fields : ast.AstTypeList]) : ResultTcResultInfo
  (cond
    [(and (tc-ok-variant-name? first-name) (tc-err-variant-name? second-name))
      (tc-result-info-build
        ctx
        ok-value?
        TcTryResult
        enum-name
        first-name
        first-fields
        second-name
        second-fields)]
    [(and (tc-err-variant-name? first-name) (tc-ok-variant-name? second-name))
      (tc-result-info-build
        ctx
        ok-value?
        TcTryResult
        enum-name
        second-name
        second-fields
        first-name
        first-fields)]
    [(and
        (tc-some-variant-name? first-name)
        (tc-none-variant-name? second-name))
      (tc-option-info-build
        ctx
        enum-name
        first-name
        first-fields
        second-name
        second-fields)]
    [(and
        (tc-none-variant-name? first-name)
        (tc-some-variant-name? second-name))
      (tc-option-info-build
        ctx
        enum-name
        second-name
        second-fields
        first-name
        first-fields)]
    [else
      (Err
        "typecheck: try requires Result-like Ok*/Err* or Option-like Some*/None* variants")]))

(define (tc-result-info-from-variants
  [ctx : TcContext]
  [ok-value? : bool]
  [enum-name : i64]
  [variants : ast.AstVariantDefList]) : ResultTcResultInfo
  (if (= variants.len 2)
    (let
      [first : ast.AstVariantDef
        (ast.ast-variant-def-list-get
          (& variants)
          0
          (ast.ast-variant-def-fallback))]
      [second : ast.AstVariantDef
        (ast.ast-variant-def-list-get
          (& variants)
          1
          (ast.ast-variant-def-fallback))]
      (match first
        [(Def first-name first-fields _)
          (match second
            [(Def second-name second-fields _)
              (tc-result-info-two-variants
                ctx
                ok-value?
                enum-name
                first-name
                first-fields
                second-name
                second-fields)])]))
    (Err "typecheck: try requires Result-like enum with exactly two variants")))

(define (tc-result-info [ctx : TcContext] [ok-value? : bool] [ty : ast.AstType]) : ResultTcResultInfo
  (match (tc-type-strip-region ty)
    [(or (Enum enum-name) (EnumArgs enum-name _))
      (let
        [enum-name-str : String (tc-nominal-name-id-display enum-name)]
        [enum-ctx : TcContext
          (tc-context-with-nominal-owner-module-id ctx enum-name)]
        [variants : ast.AstVariantDefList
          (try (tc-context-enum-variants-id ctx enum-name enum-name-str))]
        (tc-result-info-from-variants enum-ctx ok-value? enum-name variants))]
    [_ (Err "typecheck: try requires Result-like enum")]))

(define (tc-try-classify-carrier
  [ctx : TcContext]
  [ok-value? : bool]
  [ty : ast.AstType]) : TcTryCarrierClassification
  (match (tc-result-info ctx ok-value? ty)
    [(Ok info) (TcTryCarrier info)]
    [(Err message) (TcTryNotCarrier message)]))

(define (tc-try-compatibility-for-infos
  [operand-info : TcResultInfo]
  [return-info : TcResultInfo]) : TcTryCompatibility
  (let
    [operand-kind : TcTryKind
      (tc-result-info-kind (tc-global-shared-view operand-info))]
    [return-kind : TcTryKind
      (tc-result-info-kind (tc-global-shared-view return-info))]
    (match operand-kind
      [(TcTryResult)
        (match return-kind
          [(TcTryResult)
            (let
              [operand-residual : ast.AstType
                (tc-result-info-err-type operand-info)]
              [return-residual : ast.AstType
                (tc-result-info-err-type return-info)]
              (if (tc-type-compatible?
                (tc-global-shared-view return-residual)
                (tc-global-shared-view operand-residual))
                TcTryCompatible
                (TcTryIncompatible
                  (TcTryResidualTypeMismatch operand-residual return-residual))))]
          [(TcTryOption)
            (TcTryIncompatible
              (TcTryCarrierKindMismatch operand-kind return-kind))])]
      [(TcTryOption)
        (match return-kind
          [(TcTryOption) TcTryCompatible]
          [(TcTryResult)
            (TcTryIncompatible
              (TcTryCarrierKindMismatch operand-kind return-kind))])])))

(define (tc-try-compatibility-for-classifications
  [operand : TcTryCarrierClassification]
  [enclosing-return : TcTryCarrierClassification]
  [early-exit : TcTryEarlyExitContext]) : TcTryCompatibility
  (match early-exit
    [(TcTryEarlyExitForbiddenSpmd)
      (TcTryIncompatible (TcTryEarlyExitForbidden early-exit))]
    [(TcTryEarlyExitAllowed)
      (match operand
        [(TcTryNotCarrier message)
          (TcTryIncompatible (TcTryOperandNotCarrier message))]
        [(TcTryCarrier operand-info)
          (match enclosing-return
            [(TcTryNotCarrier message)
              (TcTryIncompatible (TcTryEnclosingReturnNotCarrier message))]
            [(TcTryCarrier return-info)
              (tc-try-compatibility-for-infos operand-info return-info)])])]))

;; Read-only semantic query over already-resolved operand/return types. It
;; performs no expression checking and retains no TcTypeEnv or phase state.
;; Both successful and unsuccessful results preserve every carrier fact that
;; could be classified, including exact enum/variant ids and payload types.
(define (tc-try-query
  [ctx : TcContext]
  [operand-ty : ast.AstType]
  [return-ty : ast.AstType]
  [early-exit : TcTryEarlyExitContext]) : TcTryQueryResult
  (let
    [operand : TcTryCarrierClassification
      (tc-try-classify-carrier ctx true operand-ty)]
    [enclosing-return : TcTryCarrierClassification
      (tc-try-classify-carrier ctx false return-ty)]
    (match (tc-try-compatibility-for-classifications
      (tc-global-shared-view operand)
      (tc-global-shared-view enclosing-return)
      early-exit)
      [(TcTryCompatible)
        (match operand
          [(TcTryCarrier operand-info)
            (match enclosing-return
              [(TcTryCarrier return-info)
                (TcTryQueryCompatible operand-info return-info)]
              [(TcTryNotCarrier message)
                (TcTryQueryIncompatible
                  (TcTryCarrier operand-info)
                  (TcTryNotCarrier (string.copy message))
                  (TcTryEnclosingReturnNotCarrier message))])]
          [(TcTryNotCarrier message)
            (TcTryQueryIncompatible
              (TcTryNotCarrier (string.copy message))
              enclosing-return
              (TcTryOperandNotCarrier message))])]
      [(TcTryIncompatible reason)
        (TcTryQueryIncompatible operand enclosing-return reason)])))

(define (tc-try-incompatibility-message [reason : TcTryIncompatibility]) : String
  (match reason
    [(TcTryOperandNotCarrier _)
      "typecheck: try operand must be Result-like enum"]
    [(TcTryEnclosingReturnNotCarrier _)
      "typecheck: try requires enclosing Result-like function"]
    [(TcTryCarrierKindMismatch _ _) "typecheck: try carrier mismatch"]
    [(TcTryResidualTypeMismatch operand-residual return-residual)
      (tc-type-mismatch-message
        operand-residual
        return-residual
        "typecheck: try error type mismatch")]
    [(TcTryEarlyExitForbidden _)
      (tc-kind-message (Spmd) "typecheck: try inside foreach is not supported")]))

(define (tc-try-expr [ctx : TcContext] [env : TcTypeEnv] [inner : ast.AstExpr]) : ResultTcType
  (let
    [operand-ty : ast.AstType (try (tc-expr ctx env inner))]
    (match (tc-current-return-type env)
      [(Ok return-ty)
        (match (tc-try-query ctx operand-ty return-ty TcTryEarlyExitAllowed)
          [(TcTryQueryCompatible operand-info _)
            (Ok (tc-result-info-ok-type operand-info))]
          [(TcTryQueryIncompatible _ _ reason)
            (Err (tc-try-incompatibility-message reason))])]
      [(Err _) (Err "typecheck: try requires enclosing Result-like function")])))

(define (tc-return-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [value : ast.AstExpr]) : ResultTcType
  (match (tc-current-return-type env)
    [(Ok return-ty)
      (let
        [value-ty
          (try
            (tc-expr-with-expected-or-actual
              ctx
              env
              (tc-global-shared-view value)
              (tc-global-shared-view return-ty)))]
        [_
          (try (tc-expect value-ty return-ty "typecheck: return type mismatch"))]
        (if (tc-expr-result-uses-active-cleanup-owner? ctx env value)
          (Err
            (tc-kind-message
              (ResourceOwnership)
              "typecheck: cleanup-required resource would escape with scope"))
          (Ok (Never))))]
    [(Err _) (Err "typecheck: return requires enclosing function")]))

(define (tc-variant-owner-name [ctx : TcContext] [handle : i64]) : ResultTcString
  (match (csym.compiler-symbols-owner-name-at-index
    (tc-context-symbols ctx)
    (csym.compiler-registry-handle-owner-index handle))
    [(CompilerSomeString name) (Ok name)]
    [(CompilerNoString)
      (match (tc-context-program ctx)
        [(Program decls-box)
          (let
            [decls : ast.AstDeclList
              (ast.ast-decl-list-box-shared-view decls-box)]
            (tc-variant-owner-name-list
              decls
              (csym.compiler-registry-handle-owner-index handle)
              0
              ""))])]))

(define (tc-variant-owner-name-list
  [decls : ast.AstDeclList]
  [target : i64]
  [index : i64]
  [module : String]) : ResultTcString
  (match (ast.ast-decl-list-step decls)
    [(Nil) (Err "typecheck: variant owner is not enum")]
    [(Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        (match (tc-global-shared-view decl)
          [(or (Import _ _) (IncludeStr _ _) (IncludeStrComptime _ _)
               (IncludeStrLzss _ _) (IncludeBin _ _) (Test _ _ _ _))
            (tc-variant-owner-name-list rest target index module)]
          [(Module next-module)
            (tc-variant-owner-name-list
              rest
              target
              index
              (tc-env-key-name-text next-module))]
          [_
            (if (= target index)
              (match decl
                [(or (DefEnum _ name _ _) (DefEnumLifetimes _ name _ _ _))
                  (Ok
                    (csym.compiler-symbol-module-key
                      module
                      (tc-env-key-name-text name)))]
                [_ (Err "typecheck: variant owner is not enum")])
              (tc-variant-owner-name-list rest target (+ index 1) module))]))]))

(define (tc-variant-constructor-type-for-handle
  [ctx : TcContext]
  [handle : i64]) : ResultTcType
  (let
    [_semantic-variant : unit
      (when
        (and
          (> tc-semantic-observed-jobs 0)
          (!= (tc-context-semantic-observer ctx).address 0))
        (tc-semantic-observer-send!
          (tc-context-semantic-observer ctx)
          ctx
          (TcTypeEnv 0 -1 0)
          (ResolvedMember handle)))]
    [owner-id : i64 (tc-variant-owner-id-or ctx handle -1)]
    [fields
      (try
        (csym.compiler-registries-variant-fields-indexed
          (tc-context-symbols ctx)
          handle))]
    [lifetimes (try (tc-nominal-lifetimes-id ctx owner-id))]
    (Ok (tc-enum-variant-constructor-type-id ctx owner-id lifetimes fields))))

(define (tc-variant-constructor-type-for-lookup-or-id
  [ctx : TcContext]
  [lookup-id : i64]
  [not-found-message : String]) : ResultTcType
  (let
    [registries (tc-context-registries ctx)]
    (match (csym.compiler-registries-lookup-variant-id registries lookup-id)
      [(Some handle) (tc-variant-constructor-type-for-handle ctx handle)]
      [(None)
        (match (tc-enum-qualified-variant-lookup-handle ctx lookup-id)
          [(Some handle) (tc-variant-constructor-type-for-handle ctx handle)]
          [(None) (Err not-found-message)])])))

(define (tc-struct-decl-field-name-list-render [decl : TcStructDecl]) : String
  (match decl
    [(TcStructDecl _ _ fields)
      (if (= (ast.ast-field-def-list-len (& fields)) 0)
        "<none>"
        (tc-struct-field-name-list-render-at (& fields) 0))]))

(define (tc-struct-field-name-list-render-at
  [fields : (& fields ast.AstFieldDefList)]
  [index : i64]) : String
  (if (>= index (ast.ast-field-def-list-len fields))
    ""
    (let
      [maybe-name : TcMaybeNameId (tc-call-field-list-name-at fields index)]
      (match maybe-name
        [(Some name)
          (str_cat.str-cat
            (ci.intern-str name)
            (if (>= (+ index 1) (ast.ast-field-def-list-len fields))
              ""
              (str_cat.str-cat
                ", "
                (tc-struct-field-name-list-render-at fields (+ index 1)))))]
        [(No) ""]))))

(define (tc-unknown-struct-field-message
  [ctx : TcContext]
  [struct-name-id : i64]
  [field-id : i64]) : String
  (let
    [base : String
      (str_cat.str-cat
        (cdiag.compiler-diagnostic-typecheck-tag (UnknownStructField))
        "typecheck: unknown struct field "
        (csym.compiler-struct-field-key
          (tc-nominal-name-id-display struct-name-id)
          (ci.intern-str field-id)))]
    [decl-result : ResultTcStructDecl (tc-struct-decl-id ctx struct-name-id)]
    (match decl-result
      [(Ok decl)
        (str_cat.str-cat
          base
          "; available fields: "
          (tc-struct-decl-field-name-list-render decl))]
      [(Err _) base])))

(define (tc-struct-field-type-id
  [ctx : TcContext]
  [struct-name-id : i64]
  [field-id : i64]) : ResultTcType
  (let
    [handle : i64
      (csym.compiler-registries-lookup-struct-field-id-or
        (tc-context-registries ctx)
        struct-name-id
        field-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (let
        [_semantic-member : unit
          (when
            (and
              (> tc-semantic-observed-jobs 0)
              (!= (tc-context-semantic-observer ctx).address 0))
            (tc-semantic-observer-send!
              (tc-context-semantic-observer ctx)
              ctx
              (TcTypeEnv 0 -1 0)
              (ResolvedMember handle)))]
        [field-ctx : TcContext
          (tc-context-with-nominal-owner-index-module
            ctx
            (csym.compiler-registry-handle-owner-index handle))]
        [ty : ast.AstType
          (try
            (csym.compiler-registries-struct-field-type-indexed
              (tc-context-symbols ctx)
              handle))]
        (Ok (tc-resolve-type field-ctx ty)))
      (Err (tc-unknown-struct-field-message ctx struct-name-id field-id)))))

(define (tc-lifetime-subst-from-nominal-args-id
  [ctx : TcContext]
  [name-id : i64]
  [args : ast.AstLifetimeList]) : ResultTcLifetimeSubst
  (if (and
    (tc-arena-nominal-name-id? name-id)
    (= (tc-lifetime-list-count args) 1))
    ;; Arena's single checker-only brand is phantom: its one-word runtime
    ;; declaration intentionally has no lifetime parameter or field to rewrite.
    (Ok Nil)
    (let
      [params : ast.AstLifetimeList (try (tc-nominal-lifetimes-id ctx name-id))]
      (tc-infer-lifetime-list (tc-global-shared-view params) Nil params args))))

(define (tc-struct-field-type-with-args-id
  [ctx : TcContext]
  [struct-name-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [field-id : i64]) : ResultTcType
  (let
    [handle : i64
      (csym.compiler-registries-lookup-struct-field-id-or
        (tc-context-registries ctx)
        struct-name-id
        field-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (let
        [_semantic-member : unit
          (when
            (and
              (> tc-semantic-observed-jobs 0)
              (!= (tc-context-semantic-observer ctx).address 0))
            (tc-semantic-observer-send!
              (tc-context-semantic-observer ctx)
              ctx
              (TcTypeEnv 0 -1 0)
              (ResolvedMember handle)))]
        [field-ctx : TcContext
          (tc-context-with-nominal-owner-index-module
            ctx
            (csym.compiler-registry-handle-owner-index handle))]
        [ty : ast.AstType
          (try
            (csym.compiler-registries-struct-field-type-indexed
              (tc-context-symbols ctx)
              handle))]
        [subst : TcLifetimeSubst
          (try
            (tc-lifetime-subst-from-nominal-args-id
              field-ctx
              struct-name-id
              lifetimes))]
        (Ok (tc-resolve-type field-ctx (tc-lifetime-subst-type subst ty))))
      (Err (tc-unknown-struct-field-message ctx struct-name-id field-id)))))

(define (tc-comptime-unknown-field-id [owner : String] [field-id : i64]) : ResultTcType
  (Err
    (str_cat.str-cat
      (cdiag.compiler-diagnostic-typecheck-tag (UnknownStructField))
      "typecheck: unknown struct field "
      (csym.compiler-struct-field-key owner (ci.intern-str field-id)))))

(define (tc-comptime-sequence-field-type
  [owner : String]
  [elem-ty : ast.AstType]
  [field-id : i64]) : ResultTcType
  (cond
    [(= field-id cbi.compiler-builtin-id-fix-items)
      (Ok (DynArray (ast.ty-node-push (& elem-ty))))]
    [(= field-id cbi.compiler-builtin-id-fix-len) (Ok (I64))]
    [else (tc-comptime-unknown-field-id owner field-id)]))

(define (tc-comptime-expr-clause-field-type [field-id : i64]) : ResultTcType
  (cond
    [(= field-id cbi.compiler-builtin-id-fix-first) (Ok (Expr))]
    [(= field-id cbi.compiler-builtin-id-fix-second) (Ok (Expr))]
    [else (tc-comptime-unknown-field-id "ExprClause" field-id)]))

(define (tc-comptime-expr-binding-clause-field-type [field-id : i64]) : ResultTcType
  (cond
    [(= field-id cbi.compiler-builtin-id-fix-name) (Ok (String))]
    [(= field-id cbi.compiler-builtin-id-fix-has_type) (Ok (Bool))]
    [(= field-id cbi.compiler-builtin-id-fix-ty) (Ok (Expr))]
    [(= field-id cbi.compiler-builtin-id-fix-init) (Ok (Expr))]
    [else (tc-comptime-unknown-field-id "ExprBindingClause" field-id)]))

(define (tc-comptime-match-arm-field-type [field-id : i64]) : ResultTcType
  (cond
    [(= field-id cbi.compiler-builtin-id-fix-pattern)
      (Ok (tc-macro-pattern-type))]
    [(= field-id cbi.compiler-builtin-id-fix-body) (Ok (Expr))]
    [else (tc-comptime-unknown-field-id "MatchArm" field-id)]))

(define (tc-struct-get-result-type-id
  [ctx : TcContext]
  [receiver-ty : ast.AstType]
  [field-id : i64]) : ResultTcType
  (if (not (tc-job-state-opaque-program? (tc-context-job-state ctx)))
    (tc-struct-get-result-type-checked-id ctx receiver-ty field-id)
    (match (tc-opaque-representation-ok
      ctx
      (tc-type-strip-region
        (tc-resolve-type ctx (tc-global-shared-view receiver-ty)))
      "cannot access a field of the")
      [(Ok) (tc-struct-get-result-type-checked-id ctx receiver-ty field-id)]
      [(Err message) (Err message)])))

(define (tc-struct-get-result-type-checked-id
  [ctx : TcContext]
  [receiver-ty : ast.AstType]
  [field-id : i64]) : ResultTcType
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-global-shared-view receiver-ty)))
    [(Struct struct-name)
      (let
        [field-ty (try (tc-struct-field-type-id ctx struct-name field-id))]
        (Ok (tc-project-from-region-container receiver-ty field-ty)))]
    [(StructArgs struct-name lifetimes)
      (let
        [field-ty
          (try
            (tc-struct-field-type-with-args-id
              ctx
              struct-name
              (ast.ast-lifetime-list-box-shared-view lifetimes)
              field-id))]
        (Ok (tc-project-from-region-container receiver-ty field-ty)))]
    [(or (Ref lifetime referent-ty) (MutRef lifetime referent-ty))
      (let
        [field-ty
          (try
            (tc-struct-get-result-type-id
              ctx
              (tc-context-type-get ctx referent-ty)
              field-id))]
        (Ok (tc-tag-region lifetime field-ty)))]
    [(ExprList) (tc-comptime-sequence-field-type "ExprList" (Expr) field-id)]
    [(Var name)
      (cond
        [(= name cbi.compiler-builtin-id-fix-ExprClause)
          (tc-comptime-expr-clause-field-type field-id)]
        [(= name cbi.compiler-builtin-id-fix-ExprClauseList)
          (tc-comptime-sequence-field-type
            "ExprClauseList"
            (tc-macro-expr-clause-type)
            field-id)]
        [(= name cbi.compiler-builtin-id-fix-ExprBindingClause)
          (tc-comptime-expr-binding-clause-field-type field-id)]
        [(= name cbi.compiler-builtin-id-fix-ExprBindingClauseList)
          (tc-comptime-sequence-field-type
            "ExprBindingClauseList"
            (tc-macro-expr-binding-clause-type)
            field-id)]
        [(= name cbi.compiler-builtin-id-fix-PatternList)
          (tc-comptime-sequence-field-type
            "PatternList"
            (tc-macro-pattern-type)
            field-id)]
        [(= name cbi.compiler-builtin-id-fix-MatchArm)
          (tc-comptime-match-arm-field-type field-id)]
        [(= name cbi.compiler-builtin-id-fix-MatchArmList)
          (tc-comptime-sequence-field-type
            "MatchArmList"
            (tc-macro-match-arm-type)
            field-id)]
        [else
          (Err
            (str_cat.str-cat
              (cdiag.compiler-diagnostic-typecheck-tag (TypeMismatch))
              "typecheck: field projection ."
              (ci.intern-str field-id)
              " requires struct, got "
              (tc-type-render
                (tc-type-strip-region (tc-resolve-type ctx receiver-ty)))))])]
    [_
      (Err
        (str_cat.str-cat
          (cdiag.compiler-diagnostic-typecheck-tag (TypeMismatch))
          "typecheck: field projection ."
          (ci.intern-str field-id)
          " requires struct, got "
          (tc-type-render
            (tc-type-strip-region (tc-resolve-type ctx receiver-ty)))))]))

(define (tc-borrow-place-var-by-value [name : i64] [ty : ast.AstType]) : ResultTcBorrowPlace
  (match (tc-type-outer-region (tc-global-shared-view ty))
    [(Some region)
      (Ok (TcBorrowPlace region (tc-borrow-referent-type ty) false))]
    [(No) (Ok (TcBorrowPlace name (tc-borrow-referent-type ty) false))]))

(define (tc-reference-containing-place-borrow-ok? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    ;; Structural tuples preserve the lifetimes of their reference-bearing
    ;; elements in the borrowed referent type. Lowering already walks the same
    ;; tuple shape recursively, so borrowing the tuple's storage is no less
    ;; representable than borrowing a lifetime-parameterized nominal below.
    [(Tuple _) true]
    ;; A fixed array stores its elements inline, so its borrowed referent type
    ;; keeps every element lifetime exactly as the element type spells it (the
    ;; `Slice` unsizing of `(& items)` carries the same element type). Admit it
    ;; when a borrow of one element would be admitted, or when the elements are
    ;; shared references. An element that stores a mutable reference is not
    ;; admitted: a shared view of several `&mut` would need a lending contract.
    [(Array elem _)
      (let
        [elem-ty : ast.AstType (tc-type-strip-region (ast.ty-node-get elem))]
        (and
          (not
            (tc-type-contains-mut-reference? (tc-global-shared-view elem-ty)))
          (match (tc-global-shared-view elem-ty)
            [(Ref _ _) true]
            [_ (tc-reference-containing-place-borrow-ok? elem-ty)])))]
    [(or (EnumArgs _ lifetimes) (StructArgs _ lifetimes) (VarArgs _ lifetimes))
      (> (tc-lifetime-list-count (deref lifetimes)) 0)]
    [_ false]))

(define (tc-borrow-place-var [name : i64] [ty : ast.AstType]) : ResultTcBorrowPlace
  (match (tc-type-strip-region (tc-global-shared-view ty))
    [(Ref lifetime referent-ty)
      (Ok
        (TcBorrowPlace
          lifetime
          (tc-borrow-referent-type (ast.ty-node-get referent-ty))
          true))]
    [(MutRef lifetime referent-ty)
      (Ok
        (TcBorrowPlace
          lifetime
          (tc-borrow-referent-type (ast.ty-node-get referent-ty))
          false))]
    [_
      (if (and
        (tc-type-contains-reference? (tc-global-shared-view ty))
        (not
          (tc-reference-containing-place-borrow-ok? (tc-global-shared-view ty))))
        (Err
          "typecheck: borrowing places that contain references is not implemented")
        (tc-borrow-place-var-by-value name ty))]))

(define (tc-borrow-referent-type [ty : ast.AstType]) : ast.AstType
  (match (tc-type-without-regions (tc-global-shared-view ty))
    [(String) (Str)]
    [_ (tc-type-without-regions ty)]))

;; Projecting a field or tuple element that already stores a reference reborrows
;; its referent. The stored reference owns the provenance lifetime; retaining
;; the enclosing place lifetime would make `(& (array-ref iter.slots i))`
;; appear to borrow the iterator state rather than the source array.
;; A stored shared reference makes the rest of the path shared; a stored `&mut`
;; reached through a shared one still grants only shared access.
(define (tc-borrow-place-projected-type
  [fallback-lifetime : i64]
  [projected-ty : ast.AstType]
  [through-shared : bool]) : TcBorrowPlace
  ;; Field and tuple declarations are already resolved before projection; the
  ;; enclosing place has had any transient region tag stripped as well.
  (match (tc-global-shared-view projected-ty)
    [(Ref lifetime referent-ty)
      (TcBorrowPlace
        lifetime
        (tc-borrow-referent-type (ast.ty-node-get referent-ty))
        true)]
    [(MutRef lifetime referent-ty)
      (TcBorrowPlace
        lifetime
        (tc-borrow-referent-type (ast.ty-node-get referent-ty))
        through-shared)]
    [_
      (TcBorrowPlace
        fallback-lifetime
        (tc-borrow-referent-type projected-ty)
        through-shared)]))

(define (tc-borrow-place-struct-field-id
  [ctx : TcContext]
  [place : TcBorrowPlace]
  [field-id : i64]) : ResultTcBorrowPlace
  (match place
    [(TcBorrowPlace lifetime receiver-ty shared)
      (let
        [_
          (if (tc-job-state-opaque-program? (tc-context-job-state ctx))
            (try
              (tc-opaque-representation-ok
                ctx
                (tc-type-strip-region
                  (tc-resolve-type ctx (tc-global-shared-view receiver-ty)))
                "cannot borrow a field of the"))
            unit)]
        (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
          [(Struct struct-name)
            (let
              [field-ty : ast.AstType
                (try (tc-struct-field-type-id ctx struct-name field-id))]
              (Ok (tc-borrow-place-projected-type lifetime field-ty shared)))]
          [(StructArgs struct-name lifetimes)
            (let
              [field-ty : ast.AstType
                (try
                  (tc-struct-field-type-with-args-id
                    ctx
                    struct-name
                    (ast.ast-lifetime-list-box-shared-view lifetimes)
                    field-id))]
              (Ok (tc-borrow-place-projected-type lifetime field-ty shared)))]
          [_
            (Err
              (tc-kind-message
                (BorrowViolation)
                "typecheck: field projection borrow requires struct place"))]))]))

(define (tc-borrow-place-tuple-field
  [ctx : TcContext]
  [place : TcBorrowPlace]
  [index : i64]) : ResultTcBorrowPlace
  (match place
    [(TcBorrowPlace lifetime tuple-ty shared)
      (match (tc-type-strip-region (tc-resolve-type ctx tuple-ty))
        [(Tuple elems)
          (let
            [elem-ty : ast.AstType
              (try
                (tc-type-list-ref
                  (ast.ast-type-list-box-shared-view elems)
                  index))]
            (Ok (tc-borrow-place-projected-type lifetime elem-ty shared)))]
        [_
          (Err
            (tc-kind-message
              (BorrowViolation)
              "typecheck: tuple-ref borrow requires tuple place"))])]))

(define (tc-borrow-place-array-element
  [ctx : TcContext]
  [place : TcBorrowPlace]) : ResultTcBorrowPlace
  (match place
    [(TcBorrowPlace lifetime array-ty shared)
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-global-shared-view array-ty)))
        [(Array elem-ty _)
          (Ok
            (TcBorrowPlace
              lifetime
              (tc-borrow-referent-type (ast.ty-node-get elem-ty))
              shared))]
        ;; A private buffer is move-only: its elements are storage owned through
        ;; the buffer, so they keep its shared flag (#8743).
        [(DynArray elem-ty)
          (Ok
            (TcBorrowPlace
              lifetime
              (tc-borrow-referent-type (ast.ty-node-get elem-ty))
              shared))]
        [(Slice elem-ty)
          (Ok
            (TcBorrowPlace
              lifetime
              (tc-borrow-referent-type (ast.ty-node-get elem-ty))
              shared))]
        [_
          (Err
            (str_cat.str-cat
              (cdiag.compiler-diagnostic-typecheck-tag (BorrowViolation))
              "typecheck: array-ref borrow requires array place, got "
              (tc-type-render
                (tc-type-strip-region (tc-resolve-type ctx array-ty)))))])]))

(define (tc-borrow-place-box-get [ctx : TcContext] [place : TcBorrowPlace]) : ResultTcBorrowPlace
  (match place
    [(TcBorrowPlace lifetime box-ty shared)
      (match (tc-type-strip-region (tc-resolve-type ctx box-ty))
        ;; A Box owns its contents, so they keep the Box's shared flag (#8743).
        [(Box inner-ty)
          (Ok
            (TcBorrowPlace
              lifetime
              (tc-borrow-referent-type (ast.ty-node-get inner-ty))
              shared))]
        [_
          (Err
            (tc-kind-message
              (BorrowViolation)
              "typecheck: deref borrow requires Box place"))])]))

(define (tc-borrow-place-deref
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [receiver : ast.AstExpr]) : ResultTcBorrowPlace
  (let
    [receiver-ty (try (tc-expr ctx env (tc-global-shared-view receiver)))]
    (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
      [(Box _)
        (let
          [place : TcBorrowPlace
            (try (tc-borrow-place ctx expr-bases env receiver))]
          (tc-borrow-place-box-get ctx place))]
      [(or (Ref _ _) (MutRef _ _))
        (tc-borrow-place ctx expr-bases env receiver)]
      [_
        (Err
          (tc-kind-message
            (BorrowViolation)
            "typecheck: deref borrow requires Box or reference place"))])))

(define (tc-borrow-place
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]) : ResultTcBorrowPlace
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(Var name)
      (if (tc-dotted-place-name-id? ctx env name)
        (let
          [virtual-id
            (try
              (tc-dotted-local-field-expr-id-after-check
                (tc-context-structural-session ctx)
                name))]
          (tc-borrow-place
            ctx
            expr-bases
            env
            (ast.ast-expr-segment-bases-get expr-bases virtual-id)))
        (match (tc-lookup-visible-id ctx env name)
          [(Ok ty) (tc-borrow-place-var name ty)]
          [(Err message)
            (match (tc-var-expr-after-local-field-check
              ctx
              env
              name
              (tc-hygiene-name-text-id-for-session
                (tc-context-structural-session ctx)
                name))
              [(Ok ty) (tc-borrow-place-var name ty)]
              [(Err _) (Err message)])]))]
    [(StructGet receiver-box field)
      (let
        [receiver : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases receiver-box)]
        [place (try (tc-borrow-place ctx expr-bases env receiver))]
        (tc-borrow-place-struct-field-id ctx place field))]
    [(TupleRef tuple-box index)
      (let
        [tuple : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases tuple-box)]
        [place (try (tc-borrow-place ctx expr-bases env tuple))]
        (tc-borrow-place-tuple-field ctx place index))]
    [(ArrayRef array-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        [index-ty (try (tc-expr ctx env index))]
        (if (tc-integer-type? index-ty)
          (let
            [place (try (tc-borrow-place ctx expr-bases env array))]
            (tc-borrow-place-array-element ctx place))
          (Err "typecheck: array index must be integer")))]
    [(BoxGet box-box)
      (let
        [box-expr : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases box-box)]
        [place (try (tc-borrow-place ctx expr-bases env box-expr))]
        (tc-borrow-place-box-get ctx place))]
    [(BoxTake receiver-box)
      (tc-borrow-place-deref
        ctx
        expr-bases
        env
        (ast.ast-expr-segment-bases-get expr-bases receiver-box))]
    [_ (Err (tc-borrow-place-error-message))]))

(define (tc-mut-borrow-by-value-place-message) : String
  (tc-kind-message
    (BorrowViolation)
    "typecheck: mutable borrow of by-value place is only supported as an immediate call argument"))

(define (tc-mut-borrow-storage-backed-type?
  [ctx : TcContext]
  [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(or (Ref _ _) (MutRef _ _) (Tuple _) (Array _ _) (DynArray _)) true]
    [(or (Struct name) (StructArgs name _) (Enum name) (EnumArgs name _))
      (not (tc-name-register-resident-id? ctx name))]
    [_ false]))

(define (tc-mut-borrow-non-call-place-ok
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-segment-bases ctx)
    (& expr))
    [(Var name)
      (let
        [ty (try (tc-lookup-visible-id ctx env name))]
        (if (tc-mut-borrow-storage-backed-type? ctx ty)
          Ok
          (Err (tc-mut-borrow-by-value-place-message))))]
    [(StructGet receiver-box _)
      (let
        [receiver : ast.AstExpr (tc-context-expr-get ctx receiver-box)]
        (tc-mut-borrow-non-call-place-ok ctx env receiver))]
    [(TupleRef tuple-box _)
      (let
        [tuple : ast.AstExpr (tc-context-expr-get ctx tuple-box)]
        (tc-mut-borrow-non-call-place-ok ctx env tuple))]
    [(ArrayRef array-box _)
      (let
        [array : ast.AstExpr (tc-context-expr-get ctx array-box)]
        (tc-mut-borrow-non-call-place-ok ctx env array))]
    [(BoxGet box-box)
      (let
        [box-expr : ast.AstExpr (tc-context-expr-get ctx box-box)]
        [_
          (try
            (tc-store-place-lifetime ctx env (tc-global-shared-view box-expr)))]
        (let
          [box-ty (try (tc-expr ctx env box-expr))]
          [_ (try (tc-box-set-inner-type ctx box-ty))]
          Ok))]
    [(BoxTake receiver-box)
      (let
        [receiver : ast.AstExpr (tc-context-expr-get ctx receiver-box)]
        [_
          (try
            (tc-store-place-lifetime ctx env (tc-global-shared-view receiver)))]
        (let
          [receiver-ty (try (tc-expr ctx env receiver))]
          [_ (try (tc-box-set-inner-type ctx receiver-ty))]
          Ok))]
    [_ Ok]))

(define (tc-store-place-lifetime-var [name : i64] [ty : ast.AstType]) : ResultTcNameId
  (match (tc-type-outer-region ty)
    [(Some region) (Ok region)]
    [(No) (Ok name)]))

(define (tc-store-place-lifetime
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]) : ResultTcNameId
  (match (tc-store-place-target ctx env expr)
    [(Ok lifetime _) (ResultTcNameId.Ok lifetime)]
    [(Err message) (ResultTcNameId.Err message)]))

(define (tc-store-place-target
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]) : ResultTcStorePlaceTarget
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-segment-bases ctx)
    (& expr))
    [(Var name)
      (if (tc-dotted-place-name-id? ctx env name)
        (let
          [virtual-id
            (try
              (tc-dotted-local-field-expr-id-after-check
                (tc-context-structural-session ctx)
                name))]
          (tc-store-place-target ctx env (tc-context-expr-get ctx virtual-id)))
        (let
          [ty : ast.AstType (try (tc-lookup-visible-id ctx env name))]
          [lifetime : i64 (try (tc-store-place-lifetime-var name ty))]
          (Ok lifetime Nil)))]
    [(StructGet receiver-box _)
      (let
        [receiver : ast.AstExpr (tc-context-expr-get ctx receiver-box)]
        (tc-store-place-target ctx env receiver))]
    [(TupleRef tuple-box _)
      (let
        [tuple : ast.AstExpr (tc-context-expr-get ctx tuple-box)]
        (tc-store-place-target ctx env tuple))]
    [(ArrayRef array-box index-box)
      (let
        [array : ast.AstExpr (tc-context-expr-get ctx array-box)]
        [index : ast.AstExpr (tc-context-expr-get ctx index-box)]
        [index-ty : ast.AstType (try (tc-expr ctx env index))]
        (if (tc-integer-type? index-ty)
          (tc-store-place-target ctx env array)
          (Err "typecheck: array index must be integer")))]
    [(BoxGet box-box)
      (let
        [box-expr : ast.AstExpr (tc-context-expr-get ctx box-box)]
        [box-ty (try (tc-expr ctx env (tc-global-shared-view box-expr)))]
        [_ (try (tc-box-set-inner-type ctx (tc-global-shared-view box-ty)))]
        (match (tc-type-strip-region (tc-resolve-type ctx box-ty))
          [(MutRef lifetime referent)
            (tc-store-place-reference-target ctx lifetime referent)]
          [_ (tc-store-place-target ctx env box-expr)]))]
    [(BoxTake receiver-box)
      (let
        [receiver : ast.AstExpr (tc-context-expr-get ctx receiver-box)]
        [receiver-ty (try (tc-expr ctx env (tc-global-shared-view receiver)))]
        (match (tc-type-strip-region
          (tc-resolve-type ctx (tc-global-shared-view receiver-ty)))
          [(MutPtr _) (Ok (tc-raw-place-lifetime-id) Nil)]
          [(Ptr _) (Err (tc-raw-deref-read-only-message))]
          [_
            (let
              [_
                (try
                  (tc-box-set-inner-type
                    ctx
                    (tc-global-shared-view receiver-ty)))]
              (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
                [(MutRef lifetime referent)
                  (tc-store-place-reference-target ctx lifetime referent)]
                [_ (tc-store-place-target ctx env receiver)]))]))]
    [_
      (Err
        (tc-kind-message (Place) "typecheck: expression is not a storage place"))]))

;; The target of a place reached through `(&mut lifetime referent)`: its
;; references must outlive `lifetime`, except those whose lifetimes appear in
;; `referent`, which outlive the reference itself.
(define (tc-store-place-reference-target
  [ctx : TcContext]
  [lifetime : i64]
  [referent : i64]) : ResultTcStorePlaceTarget
  (Ok
    lifetime
    (tc-type-collect-reference-lifetimes
      (tc-resolve-type ctx (ast.ty-node-get referent)))))

;; A place reached through a raw pointer has no checked lifetime: like
;; `ptr-write!`, a store through it does not check the references it writes.
;; Interned lifetime and name IDs are non-negative.
(define (tc-raw-place-lifetime-id) : i64
  -1)

(define (tc-ensure-reference-value-can-store-in-place
  [ctx : TcContext]
  [env : TcTypeEnv]
  [place-expr : ast.AstExpr]
  [value-ty : ast.AstType]
  [context : String]) : ResultTcUnit
  (let
    [lifetimes : TcNameIdList (tc-type-collect-reference-lifetimes value-ty)]
    (match lifetimes
      [(Nil) Ok]
      [_
        (tc-ensure-reference-lifetimes-can-store-at
          env
          lifetimes
          (tc-store-place-target ctx env place-expr)
          context)])))

;; Whether the nearest binding of LIFETIME-ID in ENV is a signature lifetime.
;; A local of the same name shadows it, and a borrow of that local carries the
;; same lifetime name without living as long.
(define (tc-lifetime-nearest-signature-id?
  [env : TcTypeEnv]
  [lifetime-id : i64]) : bool
  (if (tc-type-env-scoped-runtime-active? env)
    (let
      [carrier : TcTypeEnvScopedCarrier
        (tc-type-env-scoped-runtime-current env)]
      [stack : TcTypeEnvScopedStack
        (tc-global-shared-view carrier.sidecar.stack)]
      (tc-type-env-scoped-stack-signature-lifetime-index?
        stack
        (tc-type-env-scoped-stack-find-lifetime-index
          stack
          (tc-type-env-structural-session carrier.env)
          lifetime-id)
        lifetime-id))
    (tc-lifetime-nearest-binding-signature-scan-id?
      env
      (tc-type-env-structural-session env)
      lifetime-id
      (tc-signature-lifetime-marker-id))))

;; The names of NAMES whose nearest binding in ENV is a signature lifetime.
(define (tc-name-id-list-signature-lifetimes
  [env : TcTypeEnv]
  [names : TcNameIdList]) : TcNameIdList
  (let
    [out : TcNameIdList Nil]
    [rest : TcNameIdList names]
    (while (not (tc-name-id-list-empty? rest))
      (let
        [name : i64 (tc-name-id-list-head rest)]
        (if (tc-lifetime-nearest-signature-id? env name)
          (set! out (tc-name-id-list-add out name))
          unit)
        (set! rest (tc-name-id-list-rest rest))))
    out))

;; A referent lifetime outlives the `&mut` reference only while its name still
;; denotes the signature lifetime the referent type was written with.
(define (tc-ensure-reference-lifetimes-can-store-at
  [env : TcTypeEnv]
  [lifetimes : TcNameIdList]
  [target : ResultTcStorePlaceTarget]
  [context : String]) : ResultTcUnit
  (match target
    [(Ok target-lifetime implied)
      (if (or
        (= target-lifetime (tc-raw-place-lifetime-id))
        (tc-reference-lifetimes-outlive-lifetime?
          env
          (tc-name-id-list-difference
            lifetimes
            (tc-name-id-list-signature-lifetimes env implied))
          target-lifetime))
        Ok
        (Err
          (str_cat.str-cat
            (cdiag.compiler-diagnostic-typecheck-tag (RegionEscape))
            "typecheck: cannot store reference into longer-lived "
            context
            "; reference value would escape lexical scope")))]
    [(Err _)
      (Err
        (str_cat.str-cat
          (cdiag.compiler-diagnostic-typecheck-tag (RegionEscape))
          "typecheck: cannot store reference into non-place "
          context
          "; reference value would escape lexical scope"))]))

(define (tc-borrow-place-result-type
  [mutable : bool]
  [lifetime : ast.AstBorrowLifetime]
  [place : TcBorrowPlace]) : ResultTcType
  (match place
    [(TcBorrowPlace inferred referent-ty through-shared)
      (if (and mutable through-shared)
        (Err
          (tc-kind-message
            (BorrowViolation)
            "typecheck: mutable borrow through a shared reference; borrow the owner mutably or pass a (&mut T)"))
        (match lifetime
          [(Inferred)
            (Ok
              (if mutable
                (ast.ast-ty-mut-ref inferred (& referent-ty))
                (ast.ast-ty-ref inferred (& referent-ty))))]
          [(Named requested)
            (if (= requested inferred)
              (Ok
                (if mutable
                  (ast.ast-ty-mut-ref inferred (& referent-ty))
                  (ast.ast-ty-ref inferred (& referent-ty))))
              (Err
                (tc-kind-message
                  (LifetimeMismatch)
                  "typecheck: borrow lifetime mismatch")))]))]))

(define (tc-borrow-expr-with-policy
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [mutable : bool]
  [lifetime : ast.AstBorrowLifetime]
  [place-expr : ast.AstExpr]
  [allow-mut-by-value-borrow : bool]) : ResultTcType
  (match (tc-borrow-place ctx expr-bases env (tc-global-shared-view place-expr))
    [(Ok place)
      (if (and mutable (not allow-mut-by-value-borrow))
        (let
          [_ (try (tc-mut-borrow-non-call-place-ok ctx env place-expr))]
          (tc-borrow-place-result-type mutable lifetime place))
        (tc-borrow-place-result-type mutable lifetime place))]
    [(Err message)
      ;; A successfully typed place cannot be a temporary. Direct call
      ;; arguments recover temporary borrows from this error; other positions
      ;; keep the diagnostic without rescanning successful place borrows.
      (if (tc-borrow-operand-temporary?
        expr-bases
        (tc-global-shared-view place-expr))
        (ResultTcType.Err (tc-temporary-borrow-position-message))
        (Err message))]))

;; --- borrowed call-argument temporaries (section 3.10) ----------------------
;;
;; A direct call argument `(& operand)` or `(&mut operand)` whose operand names
;; no place evaluates the operand by value into hidden storage that lives until
;; the call returns, and borrows that storage with the call-temporary lifetime.
;; These classifiers only read shallow node views from the live pool; they
;; neither mutate rows nor retain a view after returning.
;; Whether a borrow operand is a temporary rather than a place: a call,
;; constructor, literal, or other value expression. A type annotation is
;; transparent. Projections stay places, so a field of a temporary is still a
;; borrow of a non-place.
(define (tc-borrow-operand-temporary?
  [expr-bases : i64]
  [operand : ast.AstExpr]) : bool
  (match (tc-global-shared-view operand)
    [(or (ast.AstExpr.Spanned inner-box _)
         (ast.AstExpr.MacroExpansion inner-box _ _)
         (ast.AstExpr.Ann inner-box _))
      (tc-borrow-operand-id-temporary? expr-bases inner-box)]
    [(or (ast.AstExpr.Var _) (ast.AstExpr.StructGet _ _)
         (ast.AstExpr.TupleRef _ _) (ast.AstExpr.ArrayRef _ _)
         (ast.AstExpr.BoxGet _) (ast.AstExpr.BoxTake _))
      false]
    [_ true]))

(define (tc-borrow-operand-id-temporary? [expr-bases : i64] [id : i64]) : bool
  (tc-borrow-operand-temporary?
    expr-bases
    (ast.ast-expr-segment-bases-get expr-bases id)))

;; The operand node of a call argument that borrows a temporary, or -1. This
;; reads through span and expansion wrappers by node ID. It does not evaluate
;; operands or retain their arena-backed handles.
(define (tc-call-temporary-borrow-operand-id
  [expr-bases : i64]
  [arg : ast.AstExpr]) : i64
  (match (tc-global-shared-view arg)
    [(or (ast.AstExpr.Spanned inner-box _)
         (ast.AstExpr.MacroExpansion inner-box _ _))
      (tc-call-temporary-borrow-operand-id-at expr-bases inner-box)]
    [(ast.AstExpr.Borrow _ _ operand-box)
      (if (tc-borrow-operand-id-temporary? expr-bases operand-box)
        operand-box
        -1)]
    [_ -1]))

(define (tc-call-temporary-borrow-operand-id-at [expr-bases : i64] [id : i64]) : i64
  (tc-call-temporary-borrow-operand-id
    expr-bases
    (ast.ast-expr-segment-bases-get expr-bases id)))

(define (tc-call-temporary-borrow-arg? [expr-bases : i64] [arg : ast.AstExpr]) : bool
  (>=
    (tc-call-temporary-borrow-operand-id expr-bases (tc-global-shared-view arg))
    0))

(define (tc-call-temporary-borrow-arg-id? [expr-bases : i64] [id : i64]) : bool
  (>= (tc-call-temporary-borrow-operand-id-at expr-bases id) 0))

;; A call argument that failed to type as an ordinary expression: a borrowed
;; temporary types here instead (section 3.10). Ordinary typing rejects every
;; borrow of a non-place, so no argument pays for this test unless it failed.
(define (tc-call-arg-type-after-error
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : ast.AstExpr]
  [want : ast.AstType]
  [failed : ResultTcType]) : ResultTcType
  (if (tc-call-temporary-borrow-arg?
    (tc-context-expr-bases ctx)
    (tc-global-shared-view arg))
    (let
      [ty (try (tc-call-temporary-borrow-type ctx env arg want))]
      (set! tc-call-temporary-borrow-typed true)
      (ResultTcType.Ok ty))
    failed))

;; A call checks the borrowed temporaries its arguments typed once they are
;; typed: none may escape through the result or a `&mut` argument, and a later
;; argument may not skip one's cleanup. `enter` starts the call's record and
;; returns the enclosing call's; a call that typed a temporary passes through
;; `exit`, which restores the record and runs the checks. Their error wins over
;; one from typing the call, which may have tripped over the escaping lifetime
;; first.
(define (tc-call-temporary-borrow-scope-enter!) : bool
  (let
    [outer : bool tc-call-temporary-borrow-typed]
    (set! tc-call-temporary-borrow-typed false)
    outer))

(define (tc-call-temporary-borrow-scope-exit
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [params : (& params ast.AstTypeList)]
  [ret : ast.AstType]
  [outer : bool]
  [typed-call : ResultTcType]) : ResultTcType
  (set! tc-call-temporary-borrow-typed outer)
  (let
    [_ (try (tc-check-call-temporary-borrows ctx env args params ret))]
    typed-call))

;; The type a reference formal expects of a temporary's value, used to type a
;; literal operand such as `(& 7)` against `(& u8)`. A `Slice` formal expects an
;; array literal of its element type; a borrowed `str` formal takes a `String`
;; value and gives no hint.
(define (tc-call-temporary-referent-hint
  [ctx : TcContext]
  [want : ast.AstType]
  [operand : ast.AstExpr]) : ast.AstMaybeType
  (let
    [referent-id : i64
      (match (tc-type-strip-region (tc-resolve-type ctx want))
        [(or (ast.AstType.Ref _ referent) (ast.AstType.MutRef _ referent))
          referent]
        [_ -1])]
    (if (< referent-id 0)
      (ast.AstMaybeType.No)
      (let
        [referent-ty : ast.AstType (tc-context-type-get ctx referent-id)]
        (match (tc-type-strip-region
          (tc-resolve-type ctx (tc-global-shared-view referent-ty)))
          [(ast.AstType.Str) (ast.AstMaybeType.No)]
          [(ast.AstType.Slice elem)
            (match (ast.ast-expr-unspan-with-segment-bases
              (tc-context-expr-bases ctx)
              (& operand))
              [(ast.AstExpr.Array exprs)
                (ast.AstMaybeType.Some
                  (ast.AstType.Array elem (ast.ast-expr-list-len (& exprs))))]
              [_ (ast.AstMaybeType.No)])]
          [_ (ast.AstMaybeType.Some referent-ty)])))))

;; The type of a call argument that borrows a temporary: a reference with the
;; call-temporary lifetime to the operand's value (`str` for a `String`).
(define (tc-call-temporary-borrow-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : ast.AstExpr]
  [want : ast.AstType]) : ResultTcType
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-bases ctx)
    (& arg))
    [(ast.AstExpr.Borrow mutable lifetime-id operand-box)
      (match (ast.ast-borrow-lifetime-from-id lifetime-id)
        [(ast.AstBorrowLifetime.Named _)
          (ResultTcType.Err
            (tc-kind-message
              (cdiag.CompilerTypecheckKind.LifetimeMismatch)
              "typecheck: a borrowed temporary has no lifetime to name; remove the lifetime from this borrow"))]
        [(ast.AstBorrowLifetime.Inferred)
          (let
            [operand : ast.AstExpr (tc-context-expr-get ctx operand-box)]
            [hint : ast.AstMaybeType
              (tc-call-temporary-referent-hint
                ctx
                want
                (tc-global-shared-view operand))]
            [operand-ty : ast.AstType
              (try
                (match hint
                  [(ast.AstMaybeType.Some hint-ty)
                    (tc-expr-with-expected-or-actual ctx env operand hint-ty)]
                  [(ast.AstMaybeType.No) (tc-expr ctx env operand)]))]
            ;; the move and borrow checks read the operand's type back
            [_recorded : unit
              (tc-body-type-fact-record!
                (tc-context-body-state ctx)
                operand-box
                (tc-global-shared-view operand-ty))]
            (cond
              [(and
                  (tc-type-contains-reference?
                    (tc-global-shared-view operand-ty))
                  (not
                    (tc-reference-containing-place-borrow-ok?
                      (tc-global-shared-view operand-ty))))
                (ResultTcType.Err
                  "typecheck: borrowing places that contain references is not implemented")]
              [(and
                  (tc-type-reaches-cleanup?
                    ctx
                    (tc-global-shared-view operand-ty))
                  (not
                    (tc-cleanup-owning-aggregate-type?
                      ctx
                      (tc-global-shared-view operand-ty))))
                (ResultTcType.Err
                  (tc-kind-message
                    (cdiag.CompilerTypecheckKind.ResourceOwnership)
                    "typecheck: a borrowed temporary that holds a cleanup-owning value must itself declare a cleanup function; bind it to a local and discharge it explicitly"))]
              [else
                (let
                  [referent-ty : ast.AstType
                    (tc-borrow-referent-type operand-ty)]
                  [lifetime : i64 (tc-call-temporary-lifetime-id)]
                  (ResultTcType.Ok
                    (if mutable
                      (ast.ast-ty-mut-ref lifetime (& referent-ty))
                      (ast.ast-ty-ref lifetime (& referent-ty)))))]))])]
    [_ (ResultTcType.Err (tc-borrow-place-error-message))]))

;; Whether evaluating `expr` can leave an enclosing argument list early through
;; `return`, `try`, `break`, or `continue`. A nested lambda body runs later.
(define (tc-expr-may-exit-early? [ctx : TcContext] [expr : ast.AstExpr]) : bool
  (match (tc-global-shared-view expr)
    [(or (ast.AstExpr.Return _) (ast.AstExpr.Try _) (ast.AstExpr.Break)
         (ast.AstExpr.Continue))
      true]
    [(ast.AstExpr.Lambda _) false]
    [_
      (let
        [children : ast.AstExprList (ast.ast-expr-child-ids expr)]
        [index : i64 0]
        [found : bool false]
        (while (and (not found) (< index children.len))
          (if (tc-expr-may-exit-early?
            ctx
            (tc-context-expr-get
              ctx
              (ast.ast-expr-list-get (& children) index -1)))
            (set! found true)
            unit)
          (set! index (+ index 1)))
        found)]))

;; Whether an argument after `index` can leave the call's argument list early,
;; which would skip the cleanup a borrowed cleanup-owning temporary at `index`
;; is owed after the call.
(define (tc-call-later-arg-may-exit-early?
  [ctx : TcContext]
  [args : (& args ast.AstExprList)]
  [index : i64]) : bool
  (let
    [cursor : i64 (+ index 1)]
    [found : bool false]
    (while (and (not found) (< cursor args.len))
      (if (tc-expr-may-exit-early?
        ctx
        (tc-context-expr-get ctx (ast.ast-expr-list-get args cursor 0)))
        (set! found true)
        unit)
      (set! cursor (+ cursor 1)))
    found))

;; The lifetime a reference formal binds, or -1 when the formal is not a
;; reference.
(define (tc-call-reference-formal-lifetime
  [ctx : TcContext]
  [formal : ast.AstType]) : i64
  (match (tc-type-strip-region (tc-resolve-type ctx formal))
    [(or (ast.AstType.Ref lifetime _) (ast.AstType.MutRef lifetime _)) lifetime]
    [_ -1]))

;; Whether a parameter other than `index` stores `lifetime` behind a mutable
;; reference, where the callee could keep a borrow past the call.
(define (tc-call-mutable-formal-mentions-lifetime?
  [ctx : TcContext]
  [params : (& params ast.AstTypeList)]
  [index : i64]
  [lifetime : i64]) : bool
  (let
    [cursor : i64 0]
    [found : bool false]
    (while (and (not found) (< cursor (ast.ast-type-list-len params)))
      (if (= cursor index)
        unit
        (match (tc-type-strip-region
          (tc-resolve-type
            ctx
            (ast.ty-node-get
              (ast.ast-type-list-get params cursor (ast.ast-type-id-fallback)))))
          [(ast.AstType.MutRef _ referent)
            (if (tc-name-id-list-contains
              (tc-type-collect-regions (ast.ty-node-get referent))
              lifetime)
              (set! found true)
              unit)]
          [_ unit]))
      (set! cursor (+ cursor 1)))
    found))

;; Rejects a call that could keep a borrow of one of its temporary arguments
;; past the call: the argument's formal lifetime appears in the result type, or
;; behind another mutable-reference parameter.
(define (tc-check-call-temporary-borrows
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [params : (& params ast.AstTypeList)]
  [ret : ast.AstType]) : ResultTcUnit
  (let
    [expr-bases : i64 (tc-context-expr-bases ctx)]
    [ret-lifetimes : TcNameIdList TcNameIdList.Nil]
    [ret-lifetimes-ready : bool false]
    [index : i64 0]
    [failed : bool false]
    [message : String ""]
    (while (and
      (not failed)
      (< index args.len)
      (< index (ast.ast-type-list-len params)))
      (let
        [arg : ast.AstExpr
          (tc-context-expr-get ctx (ast.ast-expr-list-get args index 0))]
        (if (tc-call-temporary-borrow-arg?
          expr-bases
          (tc-global-shared-view arg))
          (let
            [lifetime : i64
              (tc-call-reference-formal-lifetime
                ctx
                (ast.ty-node-get
                  (ast.ast-type-list-get
                    params
                    index
                    (ast.ast-type-id-fallback))))]
            (if (and
              (>= lifetime 0)
              (or
                (tc-name-id-list-contains
                  (begin
                    (unless
                      ret-lifetimes-ready
                      (set!
                        ret-lifetimes
                        (tc-type-collect-regions (tc-global-shared-view ret)))
                      (set! ret-lifetimes-ready true))
                    (tc-global-shared-view ret-lifetimes))
                  lifetime)
                (tc-call-mutable-formal-mentions-lifetime?
                  ctx
                  params
                  index
                  lifetime)))
              (begin
                (set! failed true)
                (set!
                  message
                  (match (tc-expr-maybe-span expr-bases arg)
                    [(TcMaybeAstSourceSpan.Some span)
                      (tc-rich-error-one-secondary
                        span
                        (tc-temporary-borrow-escape-message)
                        (tc-temporary-borrow-escape-help)
                        span
                        "this temporary is dropped when the call returns")]
                    [(TcMaybeAstSourceSpan.No)
                      (tc-temporary-borrow-escape-message)])))
              (when
                (and
                  (tc-call-later-arg-may-exit-early? ctx args index)
                  (match (tc-expr
                    ctx
                    env
                    (tc-context-expr-get
                      ctx
                      (tc-call-temporary-borrow-operand-id
                        expr-bases
                        (tc-global-shared-view arg))))
                    [(ResultTcType.Ok operand-ty)
                      (tc-cleanup-owning-aggregate-type? ctx operand-ty)]
                    [(ResultTcType.Err _) false]))
                (set! failed true)
                (set!
                  message
                  (tc-locate-error-at-expr
                    expr-bases
                    arg
                    (tc-kind-message
                      (cdiag.CompilerTypecheckKind.ResourceOwnership)
                      "typecheck: a later argument can leave the call early and skip the cleanup of this borrowed cleanup-owning temporary; bind the value with `with` before the call"))))))
          unit)
        (set! index (+ index 1))))
    (if failed
      (ResultTcUnit.Err message)
      ResultTcUnit.Ok)))

(define (tc-borrow-expr
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [mutable : bool]
  [lifetime : ast.AstBorrowLifetime]
  [place-expr : ast.AstExpr]) : ResultTcType
  (tc-borrow-expr-with-policy
    ctx
    expr-bases
    env
    mutable
    lifetime
    place-expr
    false))

(define (tc-literal-pattern-compatible?
  [lit : ast.AstLiteral]
  [scrut-ty : ast.AstType]) : bool
  (let
    [lit-ty : ast.AstType (tc-literal-type (tc-global-shared-view lit))]
    (match lit
      [(Int _ _) (tc-integer-type? scrut-ty)]
      [_ (tc-type-eq lit-ty scrut-ty)])))

(define (tc-bind-literal-pattern
  [env : TcTypeEnv]
  [lit : ast.AstLiteral]
  [scrut-ty : ast.AstType]) : ResultTcEnv
  (let
    [_ (try (tc-literal-type-checked (tc-global-shared-view lit)))]
    (if (tc-literal-pattern-compatible? lit scrut-ty)
      (Ok env)
      (Err
        (tc-kind-message
          (TypeMismatch)
          "typecheck: literal pattern type mismatch")))))

(define (tc-bind-scalar-match-pattern
  [env : TcTypeEnv]
  [scrut-ty : ast.AstType]
  [pattern : ast.AstPattern]) : ResultTcEnv
  (match pattern
    [(Wildcard) (Ok env)]
    [(Binding name) (Ok (tc-bind-id env name scrut-ty))]
    [(Literal lit) (tc-bind-literal-pattern env lit scrut-ty)]
    [(Variant name _)
      (if (tc-box-pattern-name? name)
        (Err
          (tc-kind-message
            (Pattern)
            "typecheck: box pattern requires Box scrutinee"))
        (Err
          "typecheck: scalar match only supports literal, binding, or wildcard patterns"))]
    [(Slice _ _) (Err (tc-slice-pattern-scrutinee-message))]
    [_
      (Err
        "typecheck: scalar match only supports literal, binding, or wildcard patterns")]))

;; How a pattern list binds each element against its type: as a variant
;; payload, a tuple or array element, a struct field, or the borrowed forms
;; of the first two with the borrow's lifetime.
(defenum TcPatternListMode
  (Sub)
  (Element)
  (StructField)
  (BorrowedSub i64)
  (BorrowedElement i64))

(define (tc-bind-pattern-list-element
  [ctx : TcContext]
  [env : TcTypeEnv]
  [mode : TcPatternListMode]
  [pattern : ast.AstPattern]
  [ty : ast.AstType]) : ResultTcEnv
  (match mode
    [(Sub)
      (let
        [_
          (try
            (tc-payload-binder-variant-check
              ctx
              (tc-global-shared-view pattern)
              (tc-global-shared-view ty)))]
        (tc-bind-sub-pattern ctx env pattern ty))]
    [(Element) (tc-bind-tuple-sub-pattern ctx env pattern ty)]
    [(StructField) (tc-bind-struct-field-pattern ctx env pattern ty)]
    [(BorrowedSub lifetime)
      (let
        [_
          (try
            (tc-payload-binder-variant-check
              ctx
              (tc-global-shared-view pattern)
              (tc-global-shared-view ty)))]
        (tc-bind-borrowed-sub-pattern ctx env lifetime pattern ty))]
    [(BorrowedElement lifetime)
      (tc-bind-borrowed-tuple-sub-pattern ctx env lifetime pattern ty)]))

(define (tc-bind-pattern-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [mode : TcPatternListMode]
  [patterns : ast.AstPatternList]
  [types : ast.AstTypeList]) : ResultTcEnv
  (tc-bind-pattern-list-at ctx env mode (& patterns) (& types) 0))

(define (tc-pattern-arity-message [expected : i64] [found : i64]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (ArityMismatch))
    "typecheck: pattern arity mismatch: expected "
    (string.int->string expected)
    ", found "
    (string.int->string found)))

(define (tc-bind-pattern-list-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [mode : TcPatternListMode]
  [patterns : (& patterns ast.AstPatternList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ResultTcEnv
  (if (>= index (ast.ast-pattern-list-len patterns))
    (if (>= index (ast.ast-type-list-len types))
      (Ok env)
      (Err
        (tc-pattern-arity-message
          (ast.ast-type-list-len types)
          (ast.ast-pattern-list-len patterns))))
    (if (>= index (ast.ast-type-list-len types))
      (Err
        (tc-pattern-arity-message
          (ast.ast-type-list-len types)
          (ast.ast-pattern-list-len patterns)))
      (let
        [pattern : ast.AstPattern
          (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))]
        [ty : ast.AstType
          (ast.ty-node-get
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
        [next-env : TcTypeEnv
          (try (tc-bind-pattern-list-element ctx env mode pattern ty))]
        (tc-bind-pattern-list-at ctx next-env mode patterns types (+ index 1))))))

;; Where an or-pattern sits: an arm's whole pattern, checked against the
;; scrutinee like any arm pattern, or an enum payload position, owned or
;; borrowed. Struct field, box, tuple and array sub-patterns must be
;; irrefutable, so an or-pattern there could never reach a later alternative;
;; those positions reject it.
(defenum TcOrPatternSite
  (Arm)
  (Payload TcPatternListMode))

(define (tc-or-pattern-position-message) : String
  (tc-kind-message
    (cdiag.CompilerTypecheckKind.Pattern)
    "typecheck: an or-pattern must be a whole match arm pattern or an enum payload pattern; struct field, box, tuple and array sub-patterns must be irrefutable"))

(define (tc-bind-or-alternative
  [ctx : TcContext]
  [env : TcTypeEnv]
  [site : TcOrPatternSite]
  [ty : ast.AstType]
  [pattern : ast.AstPattern]) : ResultTcEnv
  (match site
    [(TcOrPatternSite.Arm) (tc-bind-match-pattern ctx env ty pattern)]
    [(TcOrPatternSite.Payload mode)
      (tc-bind-pattern-list-element ctx env mode pattern ty)]))

(define (tc-or-alternative-bound-names
  [ctx : TcContext]
  [site : TcOrPatternSite]
  [ty : ast.AstType]
  [pattern : ast.AstPattern]) : TcNameIdList
  (match site
    [(TcOrPatternSite.Arm) (tc-borrow-check-pattern-bound-names ctx ty pattern)]
    [(TcOrPatternSite.Payload _)
      (tc-pattern-add-bound-name-ids pattern TcNameIdList.Nil)]))

;; Whether `pattern` matches every value at its site, leaving nothing for a
;; later alternative.
(define (tc-or-alternative-catchall?
  [ctx : TcContext]
  [site : TcOrPatternSite]
  [ty : ast.AstType]
  [pattern : ast.AstPattern]) : bool
  (match site
    ;; Like the arm coverage walk, a borrowed enum arm is checked against the
    ;; enum, where a bare identifier names a nullary variant.
    [(TcOrPatternSite.Arm)
      (tc-match-pattern-catchall-for-type?
        ctx
        (tc-match-coverage-type ctx ty)
        pattern)]
    [(TcOrPatternSite.Payload _) (tc-sub-pattern-irrefutable? ctx pattern ty)]))

(define (tc-or-binding-types [env : TcTypeEnv] [names : TcNameIdList]) : (__tl_dyn-array
    ast.AstType)
  (let
    [types : (__tl_dyn-array ast.AstType)
      (__tl_make-array ast.AstType (tc-name-id-list-len names))]
    [cursor : TcNameIdList names]
    [index : i64 0]
    (while (not (tc-name-id-list-empty? cursor))
      (set!
        (array-ref types index)
        (match (tc-lookup-id env (tc-name-id-list-head cursor))
          [(ResultTcType.Ok ty) ty]
          [(ResultTcType.Err _) (ast.AstType.Unit)]))
      (set! cursor (tc-name-id-list-rest cursor))
      (set! index (+ index 1)))
    types))

(define (tc-or-alternative-label [index : i64]) : String
  (str_cat.str-cat "alternative " (string.int->string (+ index 1))))

;; Checks that the or-pattern alternative at `index`, bound into `alt-env`,
;; binds exactly the first alternative's names at the first alternative's
;; types.
(define (tc-or-alternative-bindings-ok
  [alt-env : TcTypeEnv]
  [first-names : TcNameIdList]
  [first-types : (__tl_dyn-array ast.AstType)]
  [alt-names : TcNameIdList]
  [index : i64]) : ResultTcUnit
  (let
    [cursor : TcNameIdList first-names]
    [slot : i64 0]
    (while (not (tc-name-id-list-empty? cursor))
      (let
        [name : i64 (tc-name-id-list-head cursor)]
        [first-ty : ast.AstType
          (tc-global-array-element-shared-view first-types slot)]
        (when
          (not (tc-name-id-list-contains alt-names name))
          (return
            (ResultTcUnit.Err
              (tc-kind-message
                (cdiag.CompilerTypecheckKind.Pattern)
                (str_cat.str-cat
                  "typecheck: or-pattern alternative 1 binds `"
                  (tc-env-key-name-text name)
                  "` but "
                  (tc-or-alternative-label index)
                  " does not")))))
        (match (tc-lookup-id alt-env name)
          [(ResultTcType.Ok alt-ty)
            (unless
              (tc-type-eq
                (tc-global-shared-view first-ty)
                (tc-global-shared-view alt-ty))
              (return
                (ResultTcUnit.Err
                  (tc-kind-message
                    (cdiag.CompilerTypecheckKind.TypeMismatch)
                    (str_cat.str-cat
                      "typecheck: or-pattern binding `"
                      (tc-env-key-name-text name)
                      "` has type "
                      (tc-type-render first-ty)
                      " in alternative 1 but "
                      (tc-type-render alt-ty)
                      " in "
                      (tc-or-alternative-label index))))))]
          [(ResultTcType.Err message) (return (ResultTcUnit.Err message))])
        (set! slot (+ slot 1))
        (set! cursor (tc-name-id-list-rest cursor))))
    (set! cursor alt-names)
    (while (not (tc-name-id-list-empty? cursor))
      (let
        [name : i64 (tc-name-id-list-head cursor)]
        (unless
          (tc-name-id-list-contains first-names name)
          (return
            (ResultTcUnit.Err
              (tc-kind-message
                (cdiag.CompilerTypecheckKind.Pattern)
                (str_cat.str-cat
                  "typecheck: or-pattern "
                  (tc-or-alternative-label index)
                  " binds `"
                  (tc-env-key-name-text name)
                  "` but alternative 1 does not")))))
        (set! cursor (tc-name-id-list-rest cursor))))
    ResultTcUnit.Ok))

;; An or-pattern checks every alternative against the same type from the same
;; environment. Each alternative must bind exactly the first one's names, each
;; at the same type, and no alternative may follow one that already matches
;; every value. The arm body sees the first alternative's bindings.
(define (tc-bind-or-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [site : TcOrPatternSite]
  [ty : ast.AstType]
  [alternatives : ast.AstPatternList]) : ResultTcEnv
  (let
    [first : ast.AstPattern
      (ast.ast-pattern-list-get (& alternatives) 0 (ast.ast-pattern-fallback))]
    [first-names : TcNameIdList
      (tc-or-alternative-bound-names
        ctx
        (tc-global-shared-view site)
        (tc-global-shared-view ty)
        (tc-global-shared-view first))]
    [saved : TcTypeEnvScopedRuntimeSave (tc-type-env-scoped-runtime-save env)]
    [first-bound : ResultTcEnv
      (tc-bind-or-alternative
        ctx
        env
        (tc-global-shared-view site)
        (tc-global-shared-view ty)
        (tc-global-shared-view first))]
    [first-types : (__tl_dyn-array ast.AstType)
      (match first-bound
        [(ResultTcEnv.Ok first-env) (tc-or-binding-types first-env first-names)]
        [(ResultTcEnv.Err message) (return (ResultTcEnv.Err message))])]
    [index : i64 1]
    (tc-type-env-scoped-runtime-restore! (tc-global-shared-view saved))
    (while (< index alternatives.len)
      (let
        [previous : ast.AstPattern
          (ast.ast-pattern-list-get
            (& alternatives)
            (- index 1)
            (ast.ast-pattern-fallback))]
        [alternative : ast.AstPattern
          (ast.ast-pattern-list-get
            (& alternatives)
            index
            (ast.ast-pattern-fallback))]
        (when
          (tc-or-alternative-catchall?
            ctx
            (tc-global-shared-view site)
            (tc-global-shared-view ty)
            previous)
          (return
            (ResultTcEnv.Err
              (tc-kind-message
                (cdiag.CompilerTypecheckKind.Pattern)
                (str_cat.str-cat
                  "typecheck: unreachable or-pattern "
                  (tc-or-alternative-label index)
                  " after an alternative that matches every value")))))
        (match (tc-bind-or-alternative
          ctx
          env
          (tc-global-shared-view site)
          (tc-global-shared-view ty)
          (tc-global-shared-view alternative))
          [(ResultTcEnv.Ok alt-env)
            (match (tc-or-alternative-bindings-ok
              alt-env
              first-names
              (tc-global-shared-view first-types)
              (tc-or-alternative-bound-names
                ctx
                (tc-global-shared-view site)
                (tc-global-shared-view ty)
                alternative)
              index)
              [(ResultTcUnit.Ok) unit]
              [(ResultTcUnit.Err message) (return (ResultTcEnv.Err message))])]
          [(ResultTcEnv.Err message) (return (ResultTcEnv.Err message))])
        (tc-type-env-scoped-runtime-restore! (tc-global-shared-view saved))
        (set! index (+ index 1))))
    (tc-bind-or-alternative ctx env site ty first)))

;; The struct a `(fields ...)` pattern matches at type `ty`: its name id, or -1
;; when `ty` is not a struct.
(define (tc-fields-pattern-struct-id [ctx : TcContext] [ty : ast.AstType]) : i64
  (match (tc-type-strip-region (tc-resolve-type ctx (tc-global-shared-view ty)))
    [(or (ast.AstType.Struct struct-name)
         (ast.AstType.StructArgs struct-name _))
      struct-name]
    [_ -1]))

(define (tc-fields-pattern-requires-struct-message) : String
  (tc-kind-message
    (cdiag.CompilerTypecheckKind.Pattern)
    "typecheck: (fields ...) pattern requires a struct value"))

(define (tc-field-def-index-by-text
  [fields : (& fields ast.AstFieldDefList)]
  [text : (& text str)]) : i64
  (let
    [index : i64 0]
    (while (< index (ast.ast-field-def-list-len fields))
      (begin
        (match (ast.ast-field-def-list-get
          fields
          index
          (ast.ast-field-def-fallback))
          [(ast.AstFieldDef.Def field-name _ _)
            (when
              (string.eq
                (tc-env-key-name-text (ci.intern-syntax-id-value field-name))
                text)
              (return index))])
        (set! index (+ index 1))))
    -1))

;; The positional field patterns a `(fields ...)` pattern stands for against
;; the struct `struct-name-id` declaring `fields`: each field takes the pattern
;; of the entry naming it, and `_` when no entry does.
(define (tc-fields-pattern-positional
  [ctx : TcContext]
  [struct-name-id : i64]
  [fields : ast.AstFieldDefList]
  [entries : ast.AstPatternList]) : parser.ResultAstPatternList
  (let
    [slots : (__tl_dyn-array i64) (__tl_make-array i64 entries.len)]
    [index : i64 0]
    [out : ast.AstPatternList
      (ast.ast-pattern-list-with-capacity
        (ast.ast-field-def-list-len (& fields)))]
    (while (< index entries.len)
      (match (ast.ast-pattern-list-get
        (& entries)
        index
        (ast.ast-pattern-fallback))
        [(ast.AstPattern.Field name _)
          (let
            [text : String (tc-env-key-name-text name)]
            [slot : i64 (tc-field-def-index-by-text (& fields) text)]
            [earlier : i64 0]
            (when
              (< slot 0)
              (return
                (parser.ResultAstPatternList.Err
                  (tc-unknown-struct-field-message ctx struct-name-id name))))
            (while (< earlier index)
              (when
                (= (array-ref slots earlier) slot)
                (return
                  (parser.ResultAstPatternList.Err
                    (tc-kind-message
                      (cdiag.CompilerTypecheckKind.Pattern)
                      (str_cat.str-cat
                        "typecheck: (fields ...) pattern names field `"
                        text
                        "` twice")))))
              (set! earlier (+ earlier 1)))
            (set! (array-ref slots index) slot)
            (set! index (+ index 1)))]
        [_
          (return
            (parser.ResultAstPatternList.Err
              "typecheck: internal: malformed (fields ...) pattern"))]))
    (set! index 0)
    (while (< index (ast.ast-field-def-list-len (& fields)))
      (let
        [entry : i64 0]
        [pattern : ast.AstPattern ast.AstPattern.Wildcard]
        (while (< entry entries.len)
          (begin
            (if (= (array-ref slots entry) index)
              (match (ast.ast-pattern-list-get
                (& entries)
                entry
                (ast.ast-pattern-fallback))
                [(ast.AstPattern.Field _ items-box)
                  (let
                    [items : ast.AstPatternList
                      (ast.ast-pattern-list-box-shared-view items-box)]
                    (set! pattern (ast.ast-pattern-field-sub (& items))))]
                [_ unit])
              unit)
            (set! entry (+ entry 1))))
        (ast.ast-pattern-list-push (&mut out) pattern)
        (set! index (+ index 1))))
    (parser.ResultAstPatternList.Ok out)))

;; The positional field patterns and their types for a `(fields ...)` pattern
;; matched at struct type `ty`.
(defenum ResultTcFieldsPattern
  (Ok ast.AstPatternList ast.AstTypeList)
  (Err String))

(define (tc-fields-pattern-resolve
  [ctx : TcContext]
  [ty : ast.AstType]
  [entries : ast.AstPatternList]) : ResultTcFieldsPattern
  (let
    [struct-name-id : i64
      (tc-fields-pattern-struct-id ctx (tc-global-shared-view ty))]
    (if (< struct-name-id 0)
      (ResultTcFieldsPattern.Err (tc-fields-pattern-requires-struct-message))
      ;; Like a positional struct pattern, a by-name one reads the
      ;; representation, so a foreign opaque struct rejects it (#6999).
      (match (tc-opaque-name-representation-ok
        ctx
        struct-name-id
        "cannot match the")
        [(ResultTcUnit.Err message) (ResultTcFieldsPattern.Err message)]
        [(ResultTcUnit.Ok)
          (tc-fields-pattern-resolve-struct ctx ty entries struct-name-id)]))))

(define (tc-fields-pattern-resolve-struct
  [ctx : TcContext]
  [ty : ast.AstType]
  [entries : ast.AstPatternList]
  [struct-name-id : i64]) : ResultTcFieldsPattern
  (match (tc-struct-decl-id ctx struct-name-id)
    [(ResultTcStructDecl.Ok decl)
      (match decl
        [(TcStructDecl _ _ fields)
          (match (tc-struct-pattern-field-types-for-scrut
            ctx
            struct-name-id
            ty
            (tc-global-shared-view fields))
            [(ResultTcTypeList.Ok field-types)
              (match (tc-fields-pattern-positional
                ctx
                struct-name-id
                fields
                entries)
                [(parser.ResultAstPatternList.Ok positional)
                  (ResultTcFieldsPattern.Ok positional field-types)]
                [(parser.ResultAstPatternList.Err message)
                  (ResultTcFieldsPattern.Err message)])]
            [(ResultTcTypeList.Err message) (ResultTcFieldsPattern.Err message)])])]
    [(ResultTcStructDecl.Err message) (ResultTcFieldsPattern.Err message)]))

;; Binds a `(fields ...)` pattern as the positional struct pattern it stands
;; for: `mode` is StructField for an owned struct and BorrowedElement for a
;; borrowed one.
(define (tc-bind-fields-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [mode : TcPatternListMode]
  [ty : ast.AstType]
  [entries : ast.AstPatternList]) : ResultTcEnv
  (match (tc-fields-pattern-resolve ctx ty entries)
    [(ResultTcFieldsPattern.Ok positional field-types)
      (tc-bind-pattern-list ctx env mode positional field-types)]
    [(ResultTcFieldsPattern.Err message) (ResultTcEnv.Err message)]))

(define (tc-fields-pattern-irrefutable?
  [ctx : TcContext]
  [ty : ast.AstType]
  [entries : ast.AstPatternList]) : bool
  (match (tc-fields-pattern-resolve ctx ty entries)
    [(ResultTcFieldsPattern.Ok positional field-types)
      (tc-pattern-list-irrefutable? ctx positional field-types)]
    [(ResultTcFieldsPattern.Err _) false]))

(define (tc-tuple-pattern-element-types
  [ctx : TcContext]
  [tuple-ty : ast.AstType]) : ResultTcTypeList
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-global-shared-view tuple-ty)))
    [(Tuple elem-types-box)
      (Ok
        (tc-project-type-list-from-region-container
          tuple-ty
          (ast.ast-type-list-box-shared-view elem-types-box)))]
    [_
      (Err
        (tc-kind-message
          (Pattern)
          "typecheck: tuple pattern requires Tuple scrutinee"))]))

(defenum ResultTcArrayPatternInfo
  (Ok ast.AstType i64)
  (Err String))

(define (tc-array-pattern-info [ctx : TcContext] [array-ty : ast.AstType]) : ResultTcArrayPatternInfo
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-global-shared-view array-ty)))
    [(Array elem-id count)
      (Ok
        (tc-project-from-region-container
          array-ty
          (tc-context-type-get ctx elem-id))
        count)]
    [_
      (Err
        (tc-kind-message
          (Pattern)
          "typecheck: array pattern requires fixed Array scrutinee"))]))

(define (tc-bind-array-pattern-list-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [mode : TcPatternListMode]
  [patterns : (& patterns ast.AstPatternList)]
  [elem-ty : ast.AstType]
  [count : i64]
  [index : i64]) : ResultTcEnv
  (if (>= index (ast.ast-pattern-list-len patterns))
    (if (>= index count)
      (Ok env)
      (Err (tc-pattern-arity-message count (ast.ast-pattern-list-len patterns))))
    (if (>= index count)
      (Err (tc-pattern-arity-message count (ast.ast-pattern-list-len patterns)))
      (let
        [next-env
          (try
            (tc-bind-pattern-list-element
              ctx
              env
              mode
              (ast.ast-pattern-list-get
                patterns
                index
                (ast.ast-pattern-fallback))
              (tc-global-shared-view elem-ty)))]
        (tc-bind-array-pattern-list-at
          ctx
          next-env
          mode
          patterns
          elem-ty
          count
          (+ index 1))))))

(define (tc-bind-array-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [mode : TcPatternListMode]
  [array-ty : ast.AstType]
  [patterns : ast.AstPatternList]) : ResultTcEnv
  (match (tc-array-pattern-info ctx array-ty)
    [(Ok elem-ty count)
      (tc-bind-array-pattern-list-at ctx env mode (& patterns) elem-ty count 0)]
    [(Err message) (Err message)]))

(define (tc-bind-tuple-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [mode : TcPatternListMode]
  [tuple-ty : ast.AstType]
  [patterns : ast.AstPatternList]) : ResultTcEnv
  (let
    [elem-types : ast.AstTypeList
      (try (tc-tuple-pattern-element-types ctx tuple-ty))]
    (tc-bind-pattern-list ctx env mode patterns elem-types)))

;; The borrowed scrutinee a `(slice ...)` pattern matches (SPEC 5.13): the
;; borrow's lifetime and mutability, the element type, and the static length
;; of a borrowed fixed array (-1 for a Slice, whose length is read at run time).
(defenum TcSlicePatternScrutinee
  (Invalid)
  (View i64 bool ast.AstType i64))

(define (tc-slice-pattern-referent
  [ctx : TcContext]
  [lifetime : i64]
  [mutable : bool]
  [referent-id : i64]) : TcSlicePatternScrutinee
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-context-type-get ctx referent-id)))
    [(Slice elem)
      (View
        lifetime
        mutable
        (tc-resolve-type ctx (tc-context-type-get ctx elem))
        -1)]
    [(Array elem count)
      (View
        lifetime
        mutable
        (tc-resolve-type ctx (tc-context-type-get ctx elem))
        count)]
    [_ (Invalid)]))

(define (tc-slice-pattern-scrutinee [ctx : TcContext] [scrut-ty : ast.AstType]) : TcSlicePatternScrutinee
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-global-shared-view scrut-ty)))
    [(Ref lifetime referent-id)
      (tc-slice-pattern-referent ctx lifetime false referent-id)]
    [(MutRef lifetime referent-id)
      (tc-slice-pattern-referent ctx lifetime true referent-id)]
    [_ (Invalid)]))

;; The number of element patterns before an optional `& rest`.
(define (tc-slice-pattern-element-count
  [items : (& items ast.AstPatternList)]
  [has-rest : bool]) : i64
  (if has-rest
    (- (ast.ast-pattern-list-len items) 1)
    (ast.ast-pattern-list-len items)))

;; `rest` borrows the remaining elements with the scrutinee's lifetime and
;; mutability.
(define (tc-slice-pattern-rest-type
  [ctx : TcContext]
  [lifetime : i64]
  [mutable : bool]
  [elem-ty : ast.AstType]) : ast.AstType
  (let
    [referent : ast.AstType
      (ast.ast-ty-slice-with-pools (tc-context-pools ctx) (& elem-ty))]
    (if mutable
      (ast.ast-ty-mut-ref-with-pools
        (tc-context-pools ctx)
        lifetime
        (& referent))
      (ast.ast-ty-ref-with-pools (tc-context-pools ctx) lifetime (& referent)))))

;; Copy elements bind by value and take any payload pattern. Other elements
;; bind as references with the scrutinee's lifetime, as through `(& place)`; a
;; mutable view binds them as `&mut` references, by name or `_` only.
(define (tc-bind-slice-element-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [lifetime : i64]
  [mutable : bool]
  [pattern : ast.AstPattern]
  [elem-ty : ast.AstType]) : ResultTcEnv
  (if (tc-type-copyable? ctx (tc-global-shared-view elem-ty))
    (tc-bind-sub-pattern ctx env pattern elem-ty)
    (if mutable
      (match pattern
        [(Wildcard) (Ok env)]
        [(or (Binding name) (Var name _))
          (Ok
            (tc-bind-id
              env
              name
              (ast.ast-ty-mut-ref
                lifetime
                (& (tc-type-without-regions elem-ty)))))]
        [_
          (Err
            (tc-kind-message
              (Pattern)
              "typecheck: a mutable slice pattern binds a non-Copy element only to a name or `_`; match the element through its reference"))])
      (tc-bind-borrowed-sub-pattern ctx env lifetime pattern elem-ty))))

(define (tc-bind-slice-elements-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [lifetime : i64]
  [mutable : bool]
  [items : (& items ast.AstPatternList)]
  [elem-ty : ast.AstType]
  [count : i64]
  [index : i64]) : ResultTcEnv
  (if (>= index count)
    (Ok env)
    (let
      [element-ty : ast.AstType (tc-global-shared-view elem-ty)]
      [next-env : TcTypeEnv
        (try
          (tc-bind-slice-element-pattern
            ctx
            env
            lifetime
            mutable
            (ast.ast-pattern-list-get items index (ast.ast-pattern-fallback))
            element-ty))]
      (tc-bind-slice-elements-at
        ctx
        next-env
        lifetime
        mutable
        items
        elem-ty
        count
        (+ index 1)))))

(define (tc-slice-pattern-array-length-message
  [count : i64]
  [has-rest : bool]
  [length : i64]) : String
  (tc-kind-message
    (Pattern)
    (str_cat.str-cat
      (if has-rest
        "typecheck: slice pattern needs at least "
        "typecheck: slice pattern matches exactly ")
      (string.int->string count)
      " elements, but the fixed array has "
      (string.int->string length))))

(define (tc-bind-slice-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : ast.AstType]
  [items : ast.AstPatternList]
  [has-rest : bool]) : ResultTcEnv
  (match (tc-slice-pattern-scrutinee ctx scrut-ty)
    [(View lifetime mutable elem-ty length)
      (let
        [count : i64 (tc-slice-pattern-element-count (& items) has-rest)]
        (if (and
          (>= length 0)
          (if has-rest
            (> count length)
            (not (= count length))))
          (Err (tc-slice-pattern-array-length-message count has-rest length))
          (let
            [element-ty : ast.AstType (tc-global-shared-view elem-ty)]
            [elements-env : TcTypeEnv
              (try
                (tc-bind-slice-elements-at
                  ctx
                  env
                  lifetime
                  mutable
                  (& items)
                  element-ty
                  count
                  0))]
            (if has-rest
              (match (ast.ast-pattern-list-get
                (& items)
                count
                (ast.ast-pattern-fallback))
                [(or (Binding name) (Var name _))
                  (Ok
                    (tc-bind-id
                      elements-env
                      name
                      (tc-slice-pattern-rest-type ctx lifetime mutable elem-ty)))]
                [_ (Ok elements-env)])
              (Ok elements-env)))))]
    [(Invalid) (Err (tc-slice-pattern-scrutinee-message))]))

(define (tc-slice-pattern-scrutinee-message) : String
  (tc-kind-message
    (Pattern)
    "typecheck: slice pattern requires a borrowed Slice or fixed-array scrutinee, `(& (Slice T))` or `(&mut (Slice T))`"))

;; A matched shared Slice reference inside a borrowed payload is read through
;; the outer borrow; its own lifetime carries the elements' provenance.
(define (tc-bind-borrowed-slice-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [field-ty : ast.AstType]
  [items : ast.AstPatternList]
  [has-rest : bool]) : ResultTcEnv
  (match (tc-slice-pattern-scrutinee ctx (tc-global-shared-view field-ty))
    [(View _ mutable _ _)
      (if mutable
        (Err
          (tc-kind-message
            (BorrowViolation)
            "typecheck: a slice pattern cannot match a mutable Slice reference through a shared borrow"))
        (tc-bind-slice-pattern ctx env field-ty items has-rest))]
    [(Invalid) (Err (tc-slice-pattern-scrutinee-message))]))

;; Owned and borrowed slice scrutinees: a `(slice ...)` pattern binds through
;; the view; any other pattern keeps the scalar rules.
(define (tc-bind-slice-scrutinee-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : ast.AstType]
  [pattern : ast.AstPattern]) : ResultTcEnv
  (match (tc-global-shared-view pattern)
    [(Slice items-box has-rest)
      (tc-bind-slice-pattern
        ctx
        env
        scrut-ty
        (ast.ast-pattern-list-box-shared-view items-box)
        has-rest)]
    [_ (tc-bind-scalar-match-pattern env scrut-ty pattern)]))

(define (tc-bind-tuple-sub-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [pattern : ast.AstPattern]
  [elem-ty : ast.AstType]) : ResultTcEnv
  (match (tc-global-shared-view pattern)
    [(or (Var _ _) (Binding _)) (tc-bind-sub-pattern ctx env pattern elem-ty)]
    [(Wildcard) (Ok env)]
    [(Tuple patterns-box)
      (tc-bind-tuple-pattern
        ctx
        env
        Element
        elem-ty
        (ast.ast-pattern-list-box-shared-view patterns-box))]
    [(Array patterns-box)
      (tc-bind-array-pattern
        ctx
        env
        Element
        elem-ty
        (ast.ast-pattern-list-box-shared-view patterns-box))]
    [(Variant name _)
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-global-shared-view elem-ty)))
        [(or (Struct _) (StructArgs _ _))
          (tc-bind-sub-pattern ctx env pattern elem-ty)]
        [(Box _)
          (if (tc-box-pattern-name? name)
            (tc-bind-sub-pattern ctx env pattern elem-ty)
            (Err
              (tc-kind-message
                (Pattern)
                "typecheck: tuple element pattern requires an irrefutable aggregate pattern")))]
        [_
          (Err
            (tc-kind-message
              (Pattern)
              "typecheck: tuple element pattern requires an irrefutable aggregate pattern"))])]
    [(ast.AstPattern.Fields entries-box)
      (tc-bind-fields-pattern
        ctx
        env
        TcPatternListMode.StructField
        elem-ty
        (ast.ast-pattern-list-box-shared-view entries-box))]
    [(ast.AstPattern.Or _) (ResultTcEnv.Err (tc-or-pattern-position-message))]
    [_
      (Err
        (tc-kind-message
          (Pattern)
          "typecheck: tuple element pattern requires binding, wildcard, or nested tuple, struct, or box pattern"))]))

(defenum ResultTcVariantPayloadTypes
  (Ok ast.AstTypeList)
  (Err String))

(define (tc-variant-pattern-payload-types
  [ctx : TcContext]
  [enum-name-id : i64]
  [owner-index : i64]
  [enum-lifetimes : ast.AstLifetimeList]
  [fields : ast.AstTypeList]) : ResultTcVariantPayloadTypes
  (let
    [field-ctx : TcContext
      (tc-context-with-nominal-owner-index-module ctx owner-index)]
    [resolved-fields : ast.AstTypeList (tc-resolve-type-list field-ctx fields)]
    (if (ast.ast-lifetime-list-empty? (& enum-lifetimes))
      (Ok resolved-fields)
      (let
        [subst : TcLifetimeSubst
          (try
            (tc-lifetime-subst-from-nominal-args-id
              field-ctx
              enum-name-id
              enum-lifetimes))]
        (Ok (tc-lifetime-subst-type-list subst resolved-fields))))))

(define (tc-bind-variant-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name-id : i64]
  [variant-name-id : i64]
  [enum-lifetimes : ast.AstLifetimeList]
  [args : ast.AstPatternList]
  [payload-regions : TcNameIdList]) : ResultTcEnv
  (let
    [_
      (try
        (tc-opaque-name-representation-ok ctx enum-name-id "cannot match the"))]
    [enum-name : String (tc-nominal-name-id-display enum-name-id)]
    [variant-name : String
      (tc-env-key-display (tc-context-structural-session ctx) variant-name-id)]
    [handle : i64
      (tc-source-variant-handle-for-enum-id-or
        ctx
        enum-name-id
        variant-name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (let
        [owner-id : i64 (tc-variant-owner-id-or ctx handle -1)]
        [owner : String
          (if (>= owner-id 0)
            (tc-nominal-name-id-display owner-id)
            "<unknown>")]
        (if (and
          (>= owner-id 0)
          (or
            (tc-nominal-name-id-eq? owner-id enum-name-id)
            (tc-nominal-name-id-canonical-eq? ctx owner-id enum-name-id)))
          (let
            [fields : ast.AstTypeList
              (try
                (csym.compiler-registries-variant-fields-indexed
                  (tc-context-symbols ctx)
                  handle))]
            [payload-fields : ast.AstTypeList
              (try
                (tc-variant-pattern-payload-types
                  ctx
                  owner-id
                  (csym.compiler-registry-handle-owner-index handle)
                  enum-lifetimes
                  fields))]
            (tc-bind-pattern-list
              ctx
              env
              Sub
              args
              (tc-tag-type-list-regions payload-regions payload-fields)))
          (Err
            (str_cat.str-cat
              "typecheck: variant "
              variant-name
              " belongs to enum "
              owner
              ", not "
              enum-name))))
      (Err (str_cat.str-cat "typecheck: unknown variant " variant-name)))))

(define (tc-box-pattern-name? [name : i64]) : bool
  (string.eq (tc-env-key-name-text name) "box"))

(define (tc-box-pattern-args-supported?
  [ctx : TcContext]
  [args : ast.AstPatternList]
  [inner-ty : ast.AstType]) : bool
  (let
    [args-ref : (& args ast.AstPatternList) (& args)]
    (if (= args-ref.len 1)
      (tc-box-pattern-inner-supported?
        ctx
        (ast.ast-pattern-list-get args-ref 0 (ast.ast-pattern-fallback))
        inner-ty)
      false)))

(define (tc-box-pattern-inner-supported?
  [ctx : TcContext]
  [pattern : ast.AstPattern]
  [inner-ty : ast.AstType]) : bool
  (match pattern
    [(or (Wildcard) (Binding _) (Var _ _)) true]
    [(Tuple patterns-box)
      (match (tc-type-strip-region (tc-resolve-type ctx inner-ty))
        [(Tuple elem-types-box)
          (tc-pattern-list-irrefutable?
            ctx
            (ast.ast-pattern-list-box-shared-view patterns-box)
            (ast.ast-type-list-box-shared-view elem-types-box))]
        [_ false])]
    [(Array patterns-box)
      (tc-array-pattern-irrefutable?
        ctx
        (ast.ast-pattern-list-box-shared-view patterns-box)
        inner-ty)]
    [(Variant name args-box)
      (if (tc-box-pattern-name? name)
        (match (tc-type-strip-region (tc-resolve-type ctx inner-ty))
          [(Box nested-inner)
            (tc-box-pattern-args-supported?
              ctx
              (ast.ast-pattern-list-box-shared-view args-box)
              (ast.ty-node-get nested-inner))]
          [_ false])
        (match (tc-type-strip-region
          (tc-resolve-type ctx (tc-global-shared-view inner-ty)))
          [(or (Struct struct-name) (StructArgs struct-name _))
            (tc-struct-pattern-irrefutable?
              ctx
              (tc-nominal-name-id-display struct-name)
              struct-name
              inner-ty
              (tc-env-key-name-text name)
              name
              (ast.ast-pattern-list-box-shared-view args-box))]
          [_ false]))]
    [(ast.AstPattern.Fields entries-box)
      (tc-fields-pattern-irrefutable?
        ctx
        inner-ty
        (ast.ast-pattern-list-box-shared-view entries-box))]
    [_ false]))

(define (tc-bind-box-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : ast.AstPatternList]
  [inner-ty : ast.AstType]) : ResultTcEnv
  (let
    [args-ref : (& args ast.AstPatternList) (& args)]
    (if (= args-ref.len 1)
      (let
        [inner : ast.AstPattern
          (ast.ast-pattern-list-get args-ref 0 (ast.ast-pattern-fallback))]
        (match (tc-global-shared-view inner)
          ;; Binding the fields reports an unknown or refutable field itself.
          [(ast.AstPattern.Fields entries-box)
            (tc-bind-fields-pattern
              ctx
              env
              TcPatternListMode.StructField
              inner-ty
              (ast.ast-pattern-list-box-shared-view entries-box))]
          [(ast.AstPattern.Or _)
            (ResultTcEnv.Err (tc-or-pattern-position-message))]
          [_
            (if (tc-box-pattern-inner-supported?
              ctx
              (tc-global-shared-view inner)
              (tc-global-shared-view inner-ty))
              (tc-bind-sub-pattern ctx env inner inner-ty)
              (ResultTcEnv.Err
                (tc-kind-message
                  (cdiag.CompilerTypecheckKind.Pattern)
                  "typecheck: box pattern only supports irrefutable binding, wildcard, or nested box patterns")))]))
      (ResultTcEnv.Err
        (tc-kind-message
          (ArityMismatch)
          "typecheck: box pattern expects exactly one inner pattern")))))

(define (tc-struct-pattern-name-in-scrut-module
  [session : cis.InternStructuralSessionHandle]
  [struct-name : String]
  [name : String]
  [name-id : i64]) : String
  (if (tc-name-qualified-id? session name-id)
    (tc-nominal-name-id-display name-id)
    (let
      [module : String (tc-qualified-name-module struct-name)]
      (if (string.eq module "")
        name
        (csym.compiler-symbol-module-key module name)))))

(define (tc-source-struct-name-for-pattern
  [ctx : TcContext]
  [struct-name : String]
  [pattern-name : String]
  [pattern-name-id : i64]) : ResultTcString
  (if (tc-name-qualified-id?
    (tc-context-structural-session ctx)
    pattern-name-id)
    (let
      [qualifier-id : i64 (tc-qualified-name-module-id pattern-name-id)]
      [base-id : i64 (tc-qualified-name-base-id pattern-name-id)]
      [target-module-id : i64
        (tc-qualified-access-target-module-id ctx qualifier-id)]
      (Ok
        (csym.compiler-symbol-module-key
          (tc-env-key-name-text target-module-id)
          (ci.intern-str base-id))))
    (match (tc-source-type-name-lookup-from-id ctx pattern-name pattern-name-id)
      [(Ok lookup-name lookup-id)
        (Ok
          (tc-struct-pattern-name-in-scrut-module
            (tc-context-structural-session ctx)
            struct-name
            lookup-name
            lookup-id))]
      [(Err message) (Err message)])))

(define (tc-struct-pattern-name-matches?
  [ctx : TcContext]
  [struct-name : String]
  [pattern-name : String]
  [pattern-name-id : i64]) : bool
  (match (tc-source-struct-name-for-pattern
    ctx
    (tc-global-shared-view struct-name)
    pattern-name
    pattern-name-id)
    [(Ok lookup-name) (string.eq lookup-name struct-name)]
    [(Err _) false]))

(define (tc-struct-pattern-head-message
  [pattern-name : String]
  [struct-name : String]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (TypeMismatch))
    "typecheck: struct pattern head "
    pattern-name
    " does not match struct "
    struct-name))

(define (tc-struct-pattern-field-types-for-scrut
  [ctx : TcContext]
  [struct-name-id : i64]
  [scrut-ty : ast.AstType]
  [fields : ast.AstFieldDefList]) : ResultTcTypeList
  ;; The declared field types name types from the struct's own module, so they
  ;; resolve there, as `tc-struct-field-type-id` resolves a field read (#8727).
  (let
    [field-types : ast.AstTypeList
      (tc-field-type-list
        (tc-context-with-nominal-owner-module-id ctx struct-name-id)
        fields)]
    [resolved-scrut-ty : ast.AstType
      (tc-type-strip-region
        (tc-resolve-type ctx (tc-global-shared-view scrut-ty)))]
    (match resolved-scrut-ty
      [(or (StructArgs _ lifetimes) (VarArgs _ lifetimes))
        (let
          [subst : TcLifetimeSubst
            (try
              (tc-lifetime-subst-from-nominal-args-id
                ctx
                struct-name-id
                (ast.ast-lifetime-list-box-shared-view lifetimes)))]
          (Ok
            (tc-project-type-list-from-region-container
              scrut-ty
              (tc-lifetime-subst-type-list subst field-types))))]
      [_ (Ok (tc-project-type-list-from-region-container scrut-ty field-types))])))

(define (tc-bind-struct-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [struct-name-id : i64]
  [scrut-ty : ast.AstType]
  [pattern-name : String]
  [pattern-name-id : i64]
  [args : ast.AstPatternList]) : ResultTcEnv
  (let
    [_
      (try
        (tc-opaque-name-representation-ok ctx struct-name-id "cannot match the"))]
    [lookup-name
      (try
        (tc-source-struct-name-for-pattern
          ctx
          (tc-global-shared-view struct-name)
          (tc-global-shared-view pattern-name)
          pattern-name-id))]
    (if (string.eq lookup-name struct-name)
      (let
        [decl : TcStructDecl (try (tc-struct-decl-id ctx struct-name-id))]
        (match decl
          [(TcStructDecl _ _ fields)
            (let
              [field-types : ast.AstTypeList
                (try
                  (tc-struct-pattern-field-types-for-scrut
                    ctx
                    struct-name-id
                    scrut-ty
                    fields))]
              (tc-bind-pattern-list ctx env StructField args field-types))]))
      (Err (tc-struct-pattern-head-message pattern-name struct-name)))))

(define (tc-bind-struct-field-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [pattern : ast.AstPattern]
  [field-ty : ast.AstType]) : ResultTcEnv
  (let
    [ty : ast.AstType (tc-resolve-type ctx field-ty)]
    (match pattern
      [(or (Var name _) (Binding name)) (Ok (tc-bind-id env name ty))]
      [(Wildcard) (Ok env)]
      [(Tuple patterns-box)
        (tc-bind-tuple-pattern
          ctx
          env
          Element
          ty
          (ast.ast-pattern-list-box-shared-view patterns-box))]
      [(Array patterns-box)
        (tc-bind-array-pattern
          ctx
          env
          Element
          ty
          (ast.ast-pattern-list-box-shared-view patterns-box))]
      [(Variant name args-box)
        (let
          [args : ast.AstPatternList
            (ast.ast-pattern-list-box-shared-view args-box)]
          (match (tc-type-strip-region (tc-global-shared-view ty))
            [(or (Struct struct-name) (StructArgs struct-name _))
              (tc-bind-struct-pattern
                ctx
                env
                (tc-nominal-name-id-display struct-name)
                struct-name
                ty
                (tc-env-key-name-text name)
                name
                args)]
            [_
              (Err
                (tc-kind-message
                  (Pattern)
                  "typecheck: struct field pattern only supports binding, wildcard, or nested struct patterns"))]))]
      [(ast.AstPattern.Fields entries-box)
        (tc-bind-fields-pattern
          ctx
          env
          TcPatternListMode.StructField
          ty
          (ast.ast-pattern-list-box-shared-view entries-box))]
      [(ast.AstPattern.Or _) (ResultTcEnv.Err (tc-or-pattern-position-message))]
      [_
        (Err
          (tc-kind-message
            (Pattern)
            "typecheck: struct field pattern only supports binding, wildcard, or nested struct patterns"))])))

(define (tc-bind-sub-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [pattern : ast.AstPattern]
  [field-ty : ast.AstType]) : ResultTcEnv
  (let
    [ty : ast.AstType (tc-resolve-type ctx field-ty)]
    (match pattern
      [(Var name maybe-ty)
        (match maybe-ty
          [(No) (Ok (tc-bind-id env name ty))]
          [(Some annotation)
            (let
              [expected : ast.AstType (tc-resolve-type ctx annotation)]
              [_
                (try
                  (tc-expect
                    (tc-global-shared-view ty)
                    (tc-global-shared-view expected)
                    "typecheck: pattern binding type mismatch"))]
              (Ok (tc-bind-id env name (tc-contextual-result-type expected ty))))])]
      [(Binding name) (Ok (tc-bind-id env name ty))]
      [(Wildcard) (Ok env)]
      [(Literal lit) (tc-bind-literal-pattern env lit ty)]
      [(Tuple patterns-box)
        (tc-bind-tuple-pattern
          ctx
          env
          Element
          ty
          (ast.ast-pattern-list-box-shared-view patterns-box))]
      [(Array patterns-box)
        (tc-bind-array-pattern
          ctx
          env
          Element
          ty
          (ast.ast-pattern-list-box-shared-view patterns-box))]
      [(Slice items-box has-rest)
        (tc-bind-slice-pattern
          ctx
          env
          ty
          (ast.ast-pattern-list-box-shared-view items-box)
          has-rest)]
      [(Variant name args-box)
        (let
          [args : ast.AstPatternList
            (ast.ast-pattern-list-box-shared-view args-box)]
          (match (tc-type-strip-region (tc-global-shared-view ty))
            [(Expr) (tc-bind-expr-variant-pattern ctx env name args)]
            [(Enum enum-name)
              (tc-bind-variant-pattern
                ctx
                env
                enum-name
                name
                (ast.ast-lifetime-list-new)
                args
                (tc-type-outer-regions ty))]
            [(EnumArgs enum-name lifetimes)
              (tc-bind-variant-pattern
                ctx
                env
                enum-name
                name
                (ast.ast-lifetime-list-box-shared-view lifetimes)
                args
                (tc-type-outer-regions ty))]
            [(or (Struct struct-name) (StructArgs struct-name _))
              (tc-bind-struct-pattern
                ctx
                env
                (tc-nominal-name-id-display struct-name)
                struct-name
                ty
                (tc-env-key-name-text name)
                name
                args)]
            [(Box inner-ty)
              (if (tc-box-pattern-name? name)
                (tc-bind-box-pattern ctx env args (ast.ty-node-get inner-ty))
                (Err
                  (tc-kind-message
                    (Pattern)
                    "typecheck: nested variant pattern requires enum field")))]
            [_
              (if (tc-box-pattern-name? name)
                (Err
                  (tc-kind-message
                    (Pattern)
                    "typecheck: box pattern requires Box field"))
                (Err
                  (tc-kind-message
                    (Pattern)
                    "typecheck: nested variant pattern requires enum field")))]))]
      [(ast.AstPattern.Or alternatives-box)
        (tc-bind-or-pattern
          ctx
          env
          (TcOrPatternSite.Payload TcPatternListMode.Sub)
          ty
          (ast.ast-pattern-list-box-shared-view alternatives-box))]
      [(ast.AstPattern.Fields entries-box)
        (tc-bind-fields-pattern
          ctx
          env
          TcPatternListMode.StructField
          ty
          (ast.ast-pattern-list-box-shared-view entries-box))]
      [_ (ResultTcEnv.Err "typecheck: unsupported nested match pattern")])))

(define (tc-borrowed-field-ref-type [lifetime : i64] [field-ty : ast.AstType]) : ast.AstType
  (ast.ast-ty-ref lifetime (& (tc-borrow-referent-type field-ty))))

;; The type of a name bound by a pattern matched through a shared reference
;; (section 5.13). A Copy payload, field, slot or element binds by value. A
;; `(Box T)` binds a shared reference to the boxed `T`. Any other value binds a
;; shared reference with the scrutinee lifetime, `String` as `str`.
(define (tc-borrowed-binding-type
  [ctx : TcContext]
  [lifetime : i64]
  [field-ty : ast.AstType]) : ast.AstType
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-global-shared-view field-ty)))
    [(ast.AstType.Box inner-ty)
      (tc-borrowed-field-ref-type lifetime (tc-context-type-get ctx inner-ty))]
    [_
      (if (tc-type-copyable? ctx (tc-global-shared-view field-ty))
        field-ty
        (tc-borrowed-field-ref-type lifetime field-ty))]))

;; Whether a name bound through a shared borrowed pattern holds the payload by
;; value, per `tc-borrowed-binding-type`.
(define (tc-borrowed-binding-by-value?
  [ctx : TcContext]
  [field-ty : ast.AstType]) : bool
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-global-shared-view field-ty)))
    [(ast.AstType.Box _) false]
    [_ (tc-type-copyable? ctx field-ty)]))

(define (tc-bind-borrowed-struct-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [lifetime : i64]
  [struct-name : String]
  [struct-name-id : i64]
  [scrut-ty : ast.AstType]
  [pattern-name : String]
  [pattern-name-id : i64]
  [args : ast.AstPatternList]) : ResultTcEnv
  (let
    [_
      (try
        (tc-opaque-name-representation-ok ctx struct-name-id "cannot match the"))]
    [lookup-name
      (try
        (tc-source-struct-name-for-pattern
          ctx
          (tc-global-shared-view struct-name)
          (tc-global-shared-view pattern-name)
          pattern-name-id))]
    (if (string.eq lookup-name struct-name)
      (let
        [decl : TcStructDecl (try (tc-struct-decl-id ctx struct-name-id))]
        (match decl
          [(TcStructDecl _ _ fields)
            (let
              [field-types : ast.AstTypeList
                (try
                  (tc-struct-pattern-field-types-for-scrut
                    ctx
                    struct-name-id
                    scrut-ty
                    fields))]
              (tc-bind-pattern-list
                ctx
                env
                (BorrowedElement lifetime)
                args
                field-types))]))
      (Err (tc-struct-pattern-head-message pattern-name struct-name)))))

(define (tc-bind-borrowed-tuple-sub-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [lifetime : i64]
  [pattern : ast.AstPattern]
  [elem-ty : ast.AstType]) : ResultTcEnv
  (match pattern
    [(or (ast.AstPattern.Var name _) (ast.AstPattern.Binding name))
      (ResultTcEnv.Ok
        (tc-bind-id env name (tc-borrowed-binding-type ctx lifetime elem-ty)))]
    [(ast.AstPattern.Wildcard) (ResultTcEnv.Ok env)]
    [(ast.AstPattern.Tuple patterns-box)
      (tc-bind-tuple-pattern
        ctx
        env
        (TcPatternListMode.BorrowedElement lifetime)
        elem-ty
        (ast.ast-pattern-list-box-shared-view patterns-box))]
    [(ast.AstPattern.Array patterns-box)
      (tc-bind-array-pattern
        ctx
        env
        (TcPatternListMode.BorrowedElement lifetime)
        elem-ty
        (ast.ast-pattern-list-box-shared-view patterns-box))]
    [(ast.AstPattern.Variant name args-box)
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-global-shared-view elem-ty)))
        [(or (ast.AstType.Struct struct-name)
             (ast.AstType.StructArgs struct-name _))
          (tc-bind-borrowed-struct-pattern
            ctx
            env
            lifetime
            (tc-nominal-name-id-display struct-name)
            struct-name
            elem-ty
            (tc-env-key-name-text name)
            name
            (ast.ast-pattern-list-box-shared-view args-box))]
        [_
          (ResultTcEnv.Err
            (tc-kind-message
              (cdiag.CompilerTypecheckKind.Pattern)
              "typecheck: borrowed tuple element pattern requires binding, wildcard, or nested tuple or struct pattern"))])]
    [(ast.AstPattern.Fields entries-box)
      (tc-bind-fields-pattern
        ctx
        env
        (TcPatternListMode.BorrowedElement lifetime)
        elem-ty
        (ast.ast-pattern-list-box-shared-view entries-box))]
    [(ast.AstPattern.Or _) (ResultTcEnv.Err (tc-or-pattern-position-message))]
    [_
      (ResultTcEnv.Err
        (tc-kind-message
          (cdiag.CompilerTypecheckKind.Pattern)
          "typecheck: borrowed tuple element pattern requires binding, wildcard, or nested tuple or struct pattern"))]))

(define (tc-bind-borrowed-variant-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [lifetime : i64]
  [enum-name-id : i64]
  [variant-name-id : i64]
  [enum-lifetimes : ast.AstLifetimeList]
  [args : ast.AstPatternList]) : ResultTcEnv
  (let
    [_
      (try
        (tc-opaque-name-representation-ok ctx enum-name-id "cannot match the"))]
    [enum-name : String (tc-nominal-name-id-display enum-name-id)]
    [variant-name : String
      (tc-env-key-display (tc-context-structural-session ctx) variant-name-id)]
    [handle : i64
      (tc-source-variant-handle-for-enum-id-or
        ctx
        enum-name-id
        variant-name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (let
        [owner-id : i64 (tc-variant-owner-id-or ctx handle -1)]
        [owner : String
          (if (>= owner-id 0)
            (tc-nominal-name-id-display owner-id)
            "<unknown>")]
        (if (and
          (>= owner-id 0)
          (or
            (tc-nominal-name-id-eq? owner-id enum-name-id)
            (tc-nominal-name-id-canonical-eq? ctx owner-id enum-name-id)))
          (let
            [fields : ast.AstTypeList
              (try
                (csym.compiler-registries-variant-fields-indexed
                  (tc-context-symbols ctx)
                  handle))]
            [payload-fields : ast.AstTypeList
              (try
                (tc-variant-pattern-payload-types
                  ctx
                  owner-id
                  (csym.compiler-registry-handle-owner-index handle)
                  enum-lifetimes
                  fields))]
            (tc-bind-pattern-list
              ctx
              env
              (BorrowedSub lifetime)
              args
              payload-fields))
          (Err
            (str_cat.str-cat
              "typecheck: variant "
              variant-name
              " belongs to enum "
              owner
              ", not "
              enum-name))))
      (Err (str_cat.str-cat "typecheck: unknown variant " variant-name)))))

(define (tc-bind-borrowed-sub-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [lifetime : i64]
  [pattern : ast.AstPattern]
  [field-ty : ast.AstType]) : ResultTcEnv
  (let
    [ty : ast.AstType (tc-resolve-type ctx field-ty)]
    (match pattern
      [(or (ast.AstPattern.Var name _) (ast.AstPattern.Binding name))
        (ResultTcEnv.Ok
          (tc-bind-id env name (tc-borrowed-binding-type ctx lifetime ty)))]
      [(ast.AstPattern.Wildcard) (ResultTcEnv.Ok env)]
      [(ast.AstPattern.Literal lit) (tc-bind-literal-pattern env lit ty)]
      [(ast.AstPattern.Tuple patterns-box)
        (tc-bind-tuple-pattern
          ctx
          env
          (TcPatternListMode.BorrowedElement lifetime)
          ty
          (ast.ast-pattern-list-box-shared-view patterns-box))]
      [(ast.AstPattern.Array patterns-box)
        (tc-bind-array-pattern
          ctx
          env
          (TcPatternListMode.BorrowedElement lifetime)
          ty
          (ast.ast-pattern-list-box-shared-view patterns-box))]
      [(ast.AstPattern.Slice items-box has-rest)
        (tc-bind-borrowed-slice-pattern
          ctx
          env
          ty
          (ast.ast-pattern-list-box-shared-view items-box)
          has-rest)]
      [(ast.AstPattern.Variant name args-box)
        (let
          [args : ast.AstPatternList
            (ast.ast-pattern-list-box-shared-view args-box)]
          (match (tc-type-strip-region (tc-global-shared-view ty))
            [(ast.AstType.Enum enum-name)
              (tc-bind-borrowed-variant-pattern
                ctx
                env
                lifetime
                enum-name
                name
                (ast.ast-lifetime-list-new)
                args)]
            [(ast.AstType.EnumArgs enum-name lifetimes)
              (tc-bind-borrowed-variant-pattern
                ctx
                env
                lifetime
                enum-name
                name
                (ast.ast-lifetime-list-box-shared-view lifetimes)
                args)]
            [(ast.AstType.Box _)
              (if (tc-box-pattern-name? name)
                (ResultTcEnv.Err
                  (tc-kind-message
                    (cdiag.CompilerTypecheckKind.BorrowViolation)
                    "typecheck: borrowed box patterns are not supported"))
                (ResultTcEnv.Err
                  (tc-kind-message
                    (cdiag.CompilerTypecheckKind.Pattern)
                    "typecheck: nested variant pattern requires enum field")))]
            [(or (ast.AstType.Struct struct-name)
                 (ast.AstType.StructArgs struct-name _))
              (tc-bind-borrowed-struct-pattern
                ctx
                env
                lifetime
                (tc-nominal-name-id-display struct-name)
                struct-name
                ty
                (tc-env-key-name-text name)
                name
                args)]
            [_
              (if (tc-box-pattern-name? name)
                (ResultTcEnv.Err
                  (tc-kind-message
                    (cdiag.CompilerTypecheckKind.Pattern)
                    "typecheck: box pattern requires Box field"))
                (ResultTcEnv.Err
                  (tc-kind-message
                    (cdiag.CompilerTypecheckKind.Pattern)
                    "typecheck: nested variant pattern requires enum field")))]))]
      [(ast.AstPattern.Or alternatives-box)
        (tc-bind-or-pattern
          ctx
          env
          (TcOrPatternSite.Payload (TcPatternListMode.BorrowedSub lifetime))
          ty
          (ast.ast-pattern-list-box-shared-view alternatives-box))]
      [(ast.AstPattern.Fields entries-box)
        (tc-bind-fields-pattern
          ctx
          env
          (TcPatternListMode.BorrowedElement lifetime)
          ty
          (ast.ast-pattern-list-box-shared-view entries-box))]
      [_ (ResultTcEnv.Err "typecheck: unsupported nested match pattern")])))

(define (tc-bind-borrowed-enum-match-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [lifetime : i64]
  [enum-name-id : i64]
  [enum-lifetimes : ast.AstLifetimeList]
  [pattern : ast.AstPattern]) : ResultTcEnv
  (match pattern
    [(Wildcard) (Ok env)]
    [(Binding variant-name)
      (tc-bind-borrowed-variant-pattern
        ctx
        env
        lifetime
        enum-name-id
        variant-name
        enum-lifetimes
        (ast.ast-pattern-list-new))]
    [(Variant variant-name args-box)
      (let
        [args : ast.AstPatternList
          (ast.ast-pattern-list-box-shared-view args-box)]
        (tc-bind-borrowed-variant-pattern
          ctx
          env
          lifetime
          enum-name-id
          variant-name
          enum-lifetimes
          args))]
    [_ (Err "typecheck: unsupported enum match pattern")]))

;; A pattern on a `(& T)` scrutinee whose referent no other borrowed arm takes.
;; For a struct referent (#8583) a constructor-shaped pattern binds each field
;; through the borrow, as a borrowed tuple element does
;; (`tc-borrowed-binding-type`: by value when `Copy`, else a reference into the
;; scrutinee). A wildcard or binding, and any pattern on another referent, binds
;; as a scalar: a binding takes the reference itself.
(define (tc-bind-borrowed-struct-match-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [lifetime : i64]
  [referent-ty : ast.AstType]
  [scrut-ty : ast.AstType]
  [pattern : ast.AstPattern]) : ResultTcEnv
  (let
    [struct-name : i64
      (match (tc-global-shared-view referent-ty)
        [(or (Struct name) (StructArgs name _)) name]
        [_ -1])]
    [atom : bool
      (match (& pattern)
        [(or (Wildcard) (Binding _)) true]
        [_ false])]
    (if (or (< struct-name 0) atom)
      (tc-bind-scalar-match-pattern env scrut-ty pattern)
      (match pattern
        [(Variant pattern-name args-box)
          (tc-bind-borrowed-struct-pattern
            ctx
            env
            lifetime
            (tc-nominal-name-id-display struct-name)
            struct-name
            referent-ty
            (tc-env-key-name-text pattern-name)
            pattern-name
            (ast.ast-pattern-list-box-shared-view args-box))]
        [(ast.AstPattern.Fields entries-box)
          (tc-bind-fields-pattern
            ctx
            env
            (TcPatternListMode.BorrowedElement lifetime)
            referent-ty
            (ast.ast-pattern-list-box-shared-view entries-box))]
        [_
          (Err
            (tc-kind-message
              (Pattern)
              "typecheck: borrowed struct match requires a constructor-shaped struct pattern, binding, or wildcard"))]))))

(define (tc-bind-match-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : ast.AstType]
  [pattern : ast.AstPattern]) : ResultTcEnv
  (match (tc-global-shared-view pattern)
    [(Var name maybe-ty)
      (let
        [actual : ast.AstType (tc-resolve-type ctx scrut-ty)]
        (match maybe-ty
          [(No) (Ok (tc-bind-id env name actual))]
          [(Some annotation)
            (let
              [expected : ast.AstType (tc-resolve-type ctx annotation)]
              [_
                (try
                  (tc-expect
                    (tc-global-shared-view actual)
                    (tc-global-shared-view expected)
                    "typecheck: pattern binding type mismatch"))]
              (Ok
                (tc-bind-id
                  env
                  name
                  (tc-contextual-result-type expected actual))))]))]
    [(Or alternatives-box)
      (tc-bind-or-pattern
        ctx
        env
        TcOrPatternSite.Arm
        scrut-ty
        (ast.ast-pattern-list-box-shared-view alternatives-box))]
    [_ (tc-bind-match-pattern-unannotated ctx env scrut-ty pattern)]))

(define (tc-bind-match-pattern-unannotated
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : ast.AstType]
  [pattern : ast.AstPattern]) : ResultTcEnv
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-global-shared-view scrut-ty)))
    [(Ref lifetime referent-box)
      (let
        [referent-ty : ast.AstType
          (tc-type-strip-region
            (tc-resolve-type ctx (ast.ty-node-get referent-box)))]
        (match (tc-global-shared-view referent-ty)
          [(Enum enum-name)
            (tc-bind-borrowed-enum-match-pattern
              ctx
              env
              lifetime
              enum-name
              (ast.ast-lifetime-list-new)
              pattern)]
          [(EnumArgs enum-name lifetimes)
            (tc-bind-borrowed-enum-match-pattern
              ctx
              env
              lifetime
              enum-name
              (ast.ast-lifetime-list-box-shared-view lifetimes)
              pattern)]
          [(Tuple _)
            (match pattern
              [(Wildcard) (Ok env)]
              [(Binding name) (Ok (tc-bind-id env name scrut-ty))]
              [(Tuple patterns-box)
                (tc-bind-tuple-pattern
                  ctx
                  env
                  (BorrowedElement lifetime)
                  referent-ty
                  (ast.ast-pattern-list-box-shared-view patterns-box))]
              [_
                (Err
                  (tc-kind-message
                    (Pattern)
                    "typecheck: borrowed tuple match requires (tuple ...), binding, or wildcard pattern"))])]
          [(Array _ _)
            (match pattern
              [(Wildcard) (Ok env)]
              [(Binding name) (Ok (tc-bind-id env name scrut-ty))]
              [(Array patterns-box)
                (tc-bind-array-pattern
                  ctx
                  env
                  (BorrowedElement lifetime)
                  referent-ty
                  (ast.ast-pattern-list-box-shared-view patterns-box))]
              [(Slice items-box has-rest)
                (tc-bind-slice-pattern
                  ctx
                  env
                  scrut-ty
                  (ast.ast-pattern-list-box-shared-view items-box)
                  has-rest)]
              [_
                (Err
                  (tc-kind-message
                    (Pattern)
                    "typecheck: borrowed fixed-array match requires (array ...), (slice ...), binding, or wildcard pattern"))])]
          [(Slice _) (tc-bind-slice-scrutinee-pattern ctx env scrut-ty pattern)]
          [(Box _)
            (match pattern
              [(Wildcard) (Ok env)]
              [(Binding name) (Ok (tc-bind-id env name scrut-ty))]
              [(Literal lit) (tc-bind-literal-pattern env lit scrut-ty)]
              [(Variant name _)
                (if (tc-box-pattern-name? name)
                  (Err
                    (tc-kind-message
                      (BorrowViolation)
                      "typecheck: borrowed box patterns are not supported"))
                  (Err
                    "typecheck: scalar match only supports literal, binding, or wildcard patterns"))]
              [_
                (Err
                  "typecheck: scalar match only supports literal, binding, or wildcard patterns")])]
          [_
            (tc-bind-borrowed-struct-match-pattern
              ctx
              env
              lifetime
              referent-ty
              scrut-ty
              pattern)]))]
    [(MutRef _ _) (tc-bind-slice-scrutinee-pattern ctx env scrut-ty pattern)]
    [(Enum enum-name)
      (match pattern
        [(Wildcard) (Ok env)]
        [(Binding variant-name)
          (tc-bind-variant-pattern
            ctx
            env
            enum-name
            variant-name
            (ast.ast-lifetime-list-new)
            (ast.ast-pattern-list-new)
            (tc-type-outer-regions scrut-ty))]
        [(Variant variant-name args-box)
          (let
            [args : ast.AstPatternList
              (ast.ast-pattern-list-box-shared-view args-box)]
            (tc-bind-variant-pattern
              ctx
              env
              enum-name
              variant-name
              (ast.ast-lifetime-list-new)
              args
              (tc-type-outer-regions scrut-ty)))]
        [_ (Err "typecheck: unsupported enum match pattern")])]
    [(EnumArgs enum-name lifetimes)
      (match pattern
        [(Wildcard) (Ok env)]
        [(Binding variant-name)
          (tc-bind-variant-pattern
            ctx
            env
            enum-name
            variant-name
            (ast.ast-lifetime-list-box-shared-view lifetimes)
            (ast.ast-pattern-list-new)
            (tc-type-outer-regions scrut-ty))]
        [(Variant variant-name args-box)
          (let
            [args : ast.AstPatternList
              (ast.ast-pattern-list-box-shared-view args-box)]
            (tc-bind-variant-pattern
              ctx
              env
              enum-name
              variant-name
              (ast.ast-lifetime-list-box-shared-view lifetimes)
              args
              (tc-type-outer-regions scrut-ty)))]
        [_ (Err "typecheck: unsupported enum match pattern")])]
    [(or (Struct struct-name) (StructArgs struct-name _))
      (match pattern
        [(Wildcard) (Ok env)]
        [(Binding name) (Ok (tc-bind-id env name scrut-ty))]
        [(Variant pattern-name args-box)
          (tc-bind-struct-pattern
            ctx
            env
            (tc-nominal-name-id-display struct-name)
            struct-name
            scrut-ty
            (ci.intern-str pattern-name)
            pattern-name
            (ast.ast-pattern-list-box-shared-view args-box))]
        [(ast.AstPattern.Fields entries-box)
          (tc-bind-fields-pattern
            ctx
            env
            TcPatternListMode.StructField
            scrut-ty
            (ast.ast-pattern-list-box-shared-view entries-box))]
        [_
          (Err
            "typecheck: struct match only supports constructor-shaped, binding, or wildcard patterns")])]
    [(Tuple _)
      (match pattern
        [(Wildcard) (Ok env)]
        [(Binding name) (Ok (tc-bind-id env name scrut-ty))]
        [(Tuple patterns-box)
          (tc-bind-tuple-pattern
            ctx
            env
            Element
            scrut-ty
            (ast.ast-pattern-list-box-shared-view patterns-box))]
        [_
          (Err
            (tc-kind-message
              (Pattern)
              "typecheck: tuple match requires (tuple ...), binding, or wildcard pattern"))])]
    [(Array _ _)
      (match pattern
        [(Wildcard) (Ok env)]
        [(Binding name) (Ok (tc-bind-id env name scrut-ty))]
        [(Array patterns-box)
          (tc-bind-array-pattern
            ctx
            env
            Element
            scrut-ty
            (ast.ast-pattern-list-box-shared-view patterns-box))]
        [_
          (Err
            (tc-kind-message
              (Pattern)
              "typecheck: fixed-array match requires (array ...), binding, or wildcard pattern"))])]
    [(Expr) (tc-bind-expr-match-pattern ctx env pattern)]
    [(Var name)
      (if (= name cbi.compiler-builtin-id-fix-ExprClause)
        (tc-bind-expr-clause-match-pattern ctx env pattern)
        (tc-bind-scalar-match-pattern env scrut-ty pattern))]
    [(Box inner-ty)
      (match pattern
        [(Wildcard) (Ok env)]
        [(Binding name) (Ok (tc-bind-id env name scrut-ty))]
        [(Literal lit) (tc-bind-literal-pattern env lit scrut-ty)]
        [(Variant name args-box)
          (let
            [args : ast.AstPatternList
              (ast.ast-pattern-list-box-shared-view args-box)]
            (if (tc-box-pattern-name? name)
              (tc-bind-box-pattern ctx env args (ast.ty-node-get inner-ty))
              (Err
                "typecheck: Box match only supports (box ...), binding, or wildcard patterns")))]
        [_ (Err "typecheck: unsupported Box match pattern")])]
    [_ (tc-bind-scalar-match-pattern env scrut-ty pattern)]))

(define (tc-locate-match-pattern-error
  [expr-bases : i64]
  [body : ast.AstExpr]
  [message : String]) : String
  (if (tc-encoded-error? message)
    message
    (match (tc-expr-maybe-span expr-bases body)
      [(Some span) (tc-located-error span message)]
      [(No) message])))

(define (tc-match-arm-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : ast.AstType]
  [arm : ast.AstMatchArm]) : ResultTcType
  (let
    [saved : TcTypeEnvScopedRuntimeSave (tc-type-env-scoped-runtime-save env)]
    [result : ResultTcType
      (match arm
        [(Arm pattern body-box)
          (let
            [body : ast.AstExpr (tc-context-expr-get ctx body-box)]
            [_semantic-scope : unit
              (when
                (and
                  (> tc-semantic-observed-jobs 0)
                  (!= (tc-context-semantic-observer ctx).address 0))
                (tc-semantic-observer-send!
                  (tc-context-semantic-observer ctx)
                  ctx
                  env
                  (ScopeEnter body-box)))]
            (match (tc-bind-match-pattern ctx env scrut-ty pattern)
              [(Ok arm-env) (tc-expr ctx arm-env body)]
              [(Err message)
                (Err
                  (tc-locate-match-pattern-error
                    (tc-context-expr-bases ctx)
                    body
                    message))]))])]
    (tc-type-env-scoped-runtime-restore! saved)
    (when
      (and
        (> tc-semantic-observed-jobs 0)
        (!= (tc-context-semantic-observer ctx).address 0))
      (tc-semantic-observer-send!
        (tc-context-semantic-observer ctx)
        ctx
        env
        ScopeLeave))
    result))

(define (tc-match-arm-type-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : ast.AstType]
  [arm : ast.AstMatchArm]
  [expected : ast.AstType]) : ResultTcType
  (let
    [saved : TcTypeEnvScopedRuntimeSave (tc-type-env-scoped-runtime-save env)]
    [result : ResultTcType
      (match arm
        [(Arm pattern body-box)
          (let
            [body : ast.AstExpr (tc-context-expr-get ctx body-box)]
            [_semantic-scope : unit
              (when
                (and
                  (> tc-semantic-observed-jobs 0)
                  (!= (tc-context-semantic-observer ctx).address 0))
                (tc-semantic-observer-send!
                  (tc-context-semantic-observer ctx)
                  ctx
                  env
                  (ScopeEnter body-box)))]
            (match (tc-bind-match-pattern ctx env scrut-ty pattern)
              [(Ok arm-env)
                (match (tc-expr-with-expected-or-actual
                  ctx
                  arm-env
                  body
                  (tc-global-shared-view expected))
                  [(Ok got)
                    (match (tc-match-inferred-type-for-expected
                      ctx
                      arm-env
                      got
                      (tc-global-shared-view expected))
                      [(Compatible _) (Ok expected)]
                      [(Mismatch actual)
                        (Err
                          (tc-type-mismatch-message-in-context
                            ctx
                            arm-env
                            actual
                            expected
                            "typecheck: match arm result type mismatch"))])]
                  [(Err message) (Err message)])]
              [(Err message)
                (Err
                  (tc-locate-match-pattern-error
                    (tc-context-expr-bases ctx)
                    body
                    message))]))])]
    (tc-type-env-scoped-runtime-restore! saved)
    (when
      (and
        (> tc-semantic-observed-jobs 0)
        (!= (tc-context-semantic-observer ctx).address 0))
      (tc-semantic-observer-send!
        (tc-context-semantic-observer ctx)
        ctx
        env
        ScopeLeave))
    result))

(define (tc-check-match-arm-types-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : ast.AstType]
  [arms : (& arms ast.AstMatchArmList)]
  [expected : ast.AstType]) : ResultTcType
  (let
    [arms-ref : (& arms ast.AstMatchArmList) (& arms)]
    (if (= arms-ref.len 0)
      (Err "typecheck: match must have at least one arm")
      (tc-check-match-arm-types-with-expected-at
        ctx
        env
        scrut-ty
        arms-ref
        expected
        0))))

(define (tc-check-match-arm-types-with-expected-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : ast.AstType]
  [arms : (& arms ast.AstMatchArmList)]
  [expected : ast.AstType]
  [index : i64]) : ResultTcType
  (if (>= index arms.len)
    (Ok expected)
    (let
      [_
        (try
          (tc-match-arm-type-with-expected
            ctx
            env
            (tc-global-shared-view scrut-ty)
            (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
            (tc-global-shared-view expected)))]
      (tc-check-match-arm-types-with-expected-at
        ctx
        env
        scrut-ty
        arms
        expected
        (+ index 1)))))

(define (tc-match-rest-types-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : ast.AstType]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]
  [want : ast.AstType]) : ResultTcType
  (if (>= index arms.len)
    (Ok want)
    (let
      [arm : ast.AstMatchArm
        (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))]
      (match (tc-match-arm-type-with-expected
        ctx
        env
        (tc-global-shared-view scrut-ty)
        (tc-global-shared-view arm)
        (tc-global-shared-view want))
        [(Ok _) (tc-match-rest-types-at ctx env scrut-ty arms (+ index 1) want)]
        [(Err _)
          (let
            [got
              (try
                (tc-match-arm-type ctx env (tc-global-shared-view scrut-ty) arm))]
            (match (tc-merge-branch-type
              ctx
              env
              (tc-global-shared-view want)
              (tc-global-shared-view got))
              [(Ok merged)
                (tc-match-rest-types-at
                  ctx
                  env
                  scrut-ty
                  arms
                  (+ index 1)
                  merged)]
              [(Err _) (Err (tc-match-arm-merge-message want got))]))]))))

(define (tc-check-match-arm-types-from-first-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : ast.AstType]
  [first-arm : ast.AstMatchArm]
  [rest : (& rest ast.AstMatchArmList)]
  [index : i64]
  [first-ty : ast.AstType]) : ResultTcType
  (if (>= index rest.len)
    (Ok first-ty)
    (let
      [second-arm : ast.AstMatchArm
        (ast.ast-match-arm-list-get rest index (ast.ast-match-arm-fallback))]
      [remaining-index : i64 (+ index 1)]
      [second-ty
        (try
          (tc-match-arm-type
            ctx
            env
            (tc-global-shared-view scrut-ty)
            (tc-global-shared-view second-arm)))]
      (match (tc-merge-branch-type
        ctx
        env
        (tc-global-shared-view first-ty)
        (tc-global-shared-view second-ty))
        [(Ok merged)
          (tc-match-rest-types-at ctx env scrut-ty rest remaining-index merged)]
        [(Err _)
          (match (tc-match-arm-type-with-expected
            ctx
            env
            (tc-global-shared-view scrut-ty)
            first-arm
            (tc-global-shared-view second-ty))
            [(Ok _)
              (tc-match-rest-types-at
                ctx
                env
                scrut-ty
                rest
                remaining-index
                second-ty)]
            [(Err _)
              (match (tc-match-arm-type-with-expected
                ctx
                env
                (tc-global-shared-view scrut-ty)
                second-arm
                (tc-global-shared-view first-ty))
                [(Ok _)
                  (tc-match-rest-types-at
                    ctx
                    env
                    scrut-ty
                    rest
                    remaining-index
                    first-ty)]
                [(Err _) (Err (tc-match-arm-merge-message first-ty second-ty))])])]))))

(define (tc-check-match-arm-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : ast.AstType]
  [arms : (& arms ast.AstMatchArmList)]) : ResultTcType
  (let
    [arms-ref : (& arms ast.AstMatchArmList) (& arms)]
    (if (= arms-ref.len 0)
      (Err "typecheck: match must have at least one arm")
      (let
        [arm : ast.AstMatchArm
          (ast.ast-match-arm-list-get arms-ref 0 (ast.ast-match-arm-fallback))]
        [first-ty
          (try
            (tc-match-arm-type
              ctx
              env
              (tc-global-shared-view scrut-ty)
              (tc-global-shared-view arm)))]
        (tc-check-match-arm-types-from-first-at
          ctx
          env
          scrut-ty
          arm
          arms-ref
          1
          first-ty)))))

(define (tc-qualified-name-last-slash [name : (& name str)]) : i64
  (let
    [data : (Ptr u8)
      (unsafe
        (string-data (& name)))]
    [i : i64 (- (string.string-length name) 1)]
    (while (>= i 0)
      (if (=
        (unsafe
          (ptr-read (ptr-offset data i)))
        (cast 47 : u8))
        (return i)
        (set! i (- i 1))))
    -1))

(define (tc-qualified-name-module [name : String]) : String
  (let
    [slash : i64 (tc-qualified-name-last-slash name)]
    (if (< slash 0)
      ""
      (string.substring name 0 slash))))

(define (tc-qualified-name-base [name : String]) : String
  (let
    [slash : i64 (tc-qualified-name-last-slash name)]
    (if (< slash 0)
      name
      (string.substring
        name
        (+ slash 1)
        (- (string.string-length name) (+ slash 1))))))

(define (tc-qualified-variant-name [enum-name : String] [variant-name : String]) : String
  (let
    [module : String
      (tc-qualified-name-module (tc-global-shared-view enum-name))]
    [enum-base : String (tc-qualified-name-base enum-name)]
    [qualified-variant : String
      (csym.compiler-enum-qualified-variant-name enum-base variant-name)]
    (csym.compiler-symbol-module-key module qualified-variant)))

(define (tc-qualified-variant-key-id-by-id
  [enum-name-id : i64]
  [variant-name-id : i64]) : i64
  (csym.compiler-symbol-module-key-id-by-id
    (tc-qualified-name-module-id enum-name-id)
    (csym.compiler-enum-qualified-variant-name-id
      (tc-qualified-name-base-id enum-name-id)
      variant-name-id)))

(define (tc-variant-owner-id-or
  [ctx : TcContext]
  [handle : i64]
  [fallback : i64]) : i64
  (csym.compiler-symbols-owner-id-at-index-or
    (tc-context-symbols ctx)
    (csym.compiler-registry-handle-owner-index handle)
    fallback))

(define (tc-source-variant-handle-for-enum-id-raw-or
  [ctx : TcContext]
  [enum-name-id : i64]
  [variant-name-id : i64]
  [fallback : i64]) : i64
  (let
    [registries : (& ctx csym.CompilerRegistries) (tc-context-registries ctx)]
    (if (tc-name-qualified-id?
      (tc-context-structural-session ctx)
      variant-name-id)
      (csym.compiler-registries-lookup-variant-id-or
        registries
        variant-name-id
        fallback)
      (if (and
        (>= variant-name-id 0)
        (< variant-name-id (ci.intern-capacity))
        (>=
          (tc-name-first-dot-id
            (tc-context-structural-session ctx)
            variant-name-id)
          0))
        (let
          [variant-name : String (ci.intern-str variant-name-id)]
          (match (tc-dotted-alias-variant-handle
            ctx
            variant-name
            variant-name-id)
            [(Some handle) handle]
            [(None)
              (match (tc-enum-qualified-variant-lookup-handle
                ctx
                variant-name-id)
                [(Some handle) handle]
                [(None)
                  (match (tc-dotted-type-name-lookup-from-id
                    ctx
                    variant-name
                    variant-name-id)
                    [(Ok _ lookup-id)
                      (csym.compiler-registries-lookup-variant-id-or
                        registries
                        lookup-id
                        fallback)]
                    [(Err _) fallback])])]))
        (let
          [handle : i64
            (csym.compiler-registries-lookup-variant-id-or
              registries
              variant-name-id
              (csym.compiler-symbols-missing-handle))]
          (if (and
            (csym.compiler-symbols-handle-found? handle)
            (let
              [owner-id : i64 (tc-variant-owner-id-or ctx handle -1)]
              (or
                (tc-nominal-name-id-eq? owner-id enum-name-id)
                (tc-nominal-name-id-canonical-eq? ctx owner-id enum-name-id))))
            handle
            (csym.compiler-registries-lookup-variant-key-id-or
              registries
              (tc-qualified-variant-key-id-by-id enum-name-id variant-name-id)
              fallback)))))))

(define (tc-source-variant-handle-for-enum-id-or
  [ctx : TcContext]
  [enum-name-id : i64]
  [variant-name-id : i64]
  [fallback : i64]) : i64
  (let
    [handle : i64
      (tc-source-variant-handle-for-enum-id-raw-or
        ctx
        enum-name-id
        variant-name-id
        (csym.compiler-symbols-missing-handle))]
    (cond
      [(csym.compiler-symbols-handle-found? handle) handle]
      [else
        (match (tc-variant-handle-for-enum-id-and-name-id
          ctx
          enum-name-id
          variant-name-id)
          [(Some enum-handle) enum-handle]
          [(None) fallback])])))

;; --- Bare variant names (SPEC 3.5.1, 4.4.3, 5.12.1) -------------------------
;; Where an enum type is expected, a bare variant name means that enum's
;; variant. Otherwise it sees only the enums its module declares or imports
;; with `.*`, never a module the file did not import, and two such enums
;; declaring the name make it ambiguous.
;;
;; The index maps a (declaring module, variant name) key to the module's one
;; declaring variant's registry handle plus one, or to 0 when two of its enums
;; declare the name. `names` marks every declared variant name by its pool id,
;; so the common bare value lookup that names no variant costs one array read.
(define tc-bare-variant-index-ready : bool
  false)
(define tc-bare-variant-index-registry-id : i64
  -1)
(define tc-bare-variant-index-decl-count : i64
  -1)
(define tc-bare-variant-index-arena : i64
  0)

;; The symbol revision and context the index was last validated against.
(define tc-bare-variant-index-revision : i64
  -1)
(define tc-bare-variant-index-shared : u64
  0)
(define tc-bare-variant-index-entries : csym.CompilerSymbolMap
  (csym.compiler-symbol-map-with-capacity 16))
(define tc-bare-variant-index-names : (__tl_dyn-array bool)
  (__tl_make-array bool 0))

;; A parsed, unqualified, non-hygienic source name such as `Ok`.
(define (tc-bare-variant-name-id? [name-id : i64]) : bool
  (and
    (>= name-id 0)
    (< name-id (ci.intern-pool-len))
    (< (ci.intern-first-dot name-id) 0)
    (not (ci.intern-qualified? name-id))
    (not (ci.intern-macro-global-name-id? name-id))
    (not (ci.intern-macro-local-name-id? name-id))))

(define (tc-bare-variant-index-bind!
  [session : cis.InternStructuralSessionHandle]
  [entries : (&mut entries csym.CompilerSymbolMap)]
  [names : (&mut names (__tl_dyn-array bool))]
  [module-id : i64]
  [enum-index : i64]
  [variants : (& variants ast.AstVariantDefList)]) : unit
  (let
    [index : i64 0]
    (while (< index variants.len)
      (match (ast.ast-variant-def-list-get
        variants
        index
        (ast.ast-variant-def-fallback))
        [(Def name _ _)
          (let
            [member-id : i64 (tc-variant-member-name-id session name)]
            [name-id : i64
              (if (and (>= member-id 0) (< member-id (ci.intern-pool-len)))
                member-id
                (ci.intern (tc-variant-member-name-text member-id)))]
            [key-id : i64
              (csym.compiler-symbol-module-key-id-by-id module-id name-id)]
            [value : i64
              (+
                (csym.compiler-registry-make-handle
                  (csym.compiler-symbol-kind-enum-variant)
                  enum-index
                  index)
                1)]
            [previous : i64
              (csym.compiler-symbol-map-lookup-handle-id entries key-id)]
            (set! (array-ref names name-id) true)
            (cond
              [(< previous 0)
                (csym.compiler-symbol-map-bind-id! entries key-id value)]
              [(= previous value) unit]
              [else (csym.compiler-symbol-map-bind-id! entries key-id 0)]))])
      (set! index (+ index 1)))))

(define (tc-bare-variant-index-scan!
  [ctx : TcContext]
  [entries : (&mut entries csym.CompilerSymbolMap)]
  [names : (&mut names (__tl_dyn-array bool))]
  [start : i64]
  [count : i64]) : unit
  (let
    [session : cis.InternStructuralSessionHandle
      (tc-context-structural-session ctx)]
    [decls : (__tl_dyn-array ast.AstDecl)
      (csym.compiler-symbols-decls (tc-context-symbols ctx))]
    [index : i64 start]
    (while (< index count)
      (let
        [module-id : i64
          (csym.compiler-symbols-owner-module-id-at-index-or
            (tc-context-symbols ctx)
            index
            (csym.compiler-symbol-root-module-id))]
        (match (array-ref decls index)
          [(or (DefEnum _ _ _ variants) (DefEnumLifetimes _ _ _ _ variants))
            (tc-bare-variant-index-bind!
              session
              entries
              names
              module-id
              index
              (& variants))]
          [_ unit])
        (set! index (+ index 1))))))

;; Symbol declarations only append under one registry identity, so a grown
;; table extends the index in its own arena instead of rebuilding it.
(define (tc-bare-variant-index-ensure! [ctx : TcContext]) : unit
  (let
    [registry-id : i64
      (csym.compiler-registries-identity (tc-context-registries ctx))]
    [count : i64 (csym.compiler-symbols-decl-count (tc-context-symbols ctx))]
    [current : bool
      (and
        tc-bare-variant-index-ready
        (= tc-bare-variant-index-registry-id registry-id)
        (<= tc-bare-variant-index-decl-count count))]
    (if (and current (= tc-bare-variant-index-decl-count count))
      unit
      (let
        [prev-arena : i64 (arena.tl_arena_current)]
        (if current
          (begin
            (unsafe
              (arena.tl_arena_set tc-bare-variant-index-arena))
            (tc-bare-variant-index-scan!
              ctx
              (&mut tc-bare-variant-index-entries)
              (&mut tc-bare-variant-index-names)
              tc-bare-variant-index-decl-count
              count))
          (let
            [index-arena : i64 (arena.tl_arena_make)]
            [_switch : unit
              (unsafe
                (arena.tl_arena_set index-arena))]
            [entries : csym.CompilerSymbolMap
              (csym.compiler-symbol-map-with-capacity 256)]
            [names : (__tl_dyn-array bool)
              (__tl_make-array bool (ci.intern-capacity))]
            (tc-bare-variant-index-scan!
              ctx
              (&mut entries)
              (&mut names)
              0
              count)
            (if (= tc-bare-variant-index-arena 0)
              unit
              (unsafe
                (arena.tl_arena_destroy tc-bare-variant-index-arena)))
            (set! tc-bare-variant-index-entries entries)
            (set! tc-bare-variant-index-names names)
            (set! tc-bare-variant-index-registry-id registry-id)
            (set! tc-bare-variant-index-arena index-arena)
            (set! tc-bare-variant-index-ready true)))
        (set! tc-bare-variant-index-decl-count count)
        (unsafe
          (arena.tl_arena_set prev-arena))))
    (set! tc-bare-variant-index-revision csym.compiler-symbols-revision)
    (set! tc-bare-variant-index-shared ctx.shared)))

;; The declaring-module entry: the variant's registry handle, -1 when no enum of
;; `module-id` declares `name-id`, or -2 when two do.
(define (tc-bare-variant-module-entry [module-id : i64] [name-id : i64]) : i64
  (let
    [value : i64
      (csym.compiler-symbol-map-lookup-handle-id
        (& tc-bare-variant-index-entries)
        (csym.compiler-symbol-module-key-id-by-id module-id name-id))]
    (cond [(< value 0) -1] [(= value 0) -2] [else (- value 1)])))

;; The module a `(import m.*)` at `position` reads, or -1 for any other decl.
(define (tc-bare-variant-star-target-at
  [decls : (& decls ast.AstDeclList)]
  [position : i64]) : i64
  (match (ast.ast-decl-unwrapped
    (& (array-ref decls.slots (+ decls.offset position))))
    [(Import _ (Spec (ModuleAll) _ (Some target-module) _ _)) target-module]
    [_ -1]))

;; Registry handle of the one visible enum variant spelled `name-id` in the
;; current module: -1 when no visible enum declares it, -2 when two do.
;; Whether any enum declares a variant spelled `name-id`; the cheap gate in
;; front of every bare-variant rule.
;; Inline form of `tc-bare-variant-declared-name?` for the hot lookup paths:
;; a fresh index answers from the bitset without a call. `name-id` must be a
;; plain variable, which the expansion reads more than once.
(defmacro (tc-bare-variant-name-gate? [ctx : Expr] [name-id : Expr]) : Expr
  `(if (and
    tc-bare-variant-index-ready
    (= tc-bare-variant-index-revision csym.compiler-symbols-revision)
    (= tc-bare-variant-index-shared (__tl-project-field ,ctx shared)))
    (and
      (>= ,name-id 0)
      (< ,name-id (array-length tc-bare-variant-index-names))
      (array-ref tc-bare-variant-index-names ,name-id))
    (tc-bare-variant-declared-name? ,ctx ,name-id)))

(define (tc-bare-variant-declared-name? [ctx : TcContext] [name-id : i64]) : bool
  (if (and
    tc-bare-variant-index-ready
    (= tc-bare-variant-index-revision csym.compiler-symbols-revision)
    (= tc-bare-variant-index-shared ctx.shared))
    unit
    (tc-bare-variant-index-ensure! ctx))
  (and
    (>= name-id 0)
    (< name-id (array-length tc-bare-variant-index-names))
    (array-ref tc-bare-variant-index-names name-id)))

(define (tc-bare-variant-visible-handle [ctx : TcContext] [name-id : i64]) : i64
  (if (not (tc-bare-variant-declared-name? ctx name-id))
    -1
    (let
      [module-id : i64 (tc-context-module-id ctx)]
      [found : i64 (tc-bare-variant-module-entry module-id name-id)]
      (match (tc-context-program ctx)
        [(Program decls-box)
          (let
            [decls : ast.AstDeclList
              (ast.ast-decl-list-box-shared-view decls-box)]
            [_ensure : unit (tc-module-decl-index-ensure! (& decls))]
            [slot : i64 (tc-module-decl-index-slot module-id)]
            [j : i64
              (if (< slot 0)
                0
                (array-ref tc-module-import-index-starts slot))]
            [end : i64
              (if (< slot 0)
                0
                (array-ref tc-module-import-index-ends slot))]
            (while (and (< j end) (not (= found -2)))
              (let
                [target : i64
                  (tc-bare-variant-star-target-at
                    (& decls)
                    (array-ref tc-module-import-index-positions j))]
                [entry : i64
                  (if (< target 0)
                    -1
                    (tc-bare-variant-module-entry target name-id))]
                (cond
                  [(= entry -1) unit]
                  [(or (= found -1) (= found entry)) (set! found entry)]
                  [else (set! found -2)])
                (set! j (+ j 1))))
            found)]))))

;; `out` extended with ` or Enum.V` when `variants` declares `name-id`.
(define (tc-bare-variant-candidate-append
  [session : cis.InternStructuralSessionHandle]
  [out : String]
  [enum-name : i64]
  [variants : (& variants ast.AstVariantDefList)]
  [name-id : i64]) : String
  (match (tc-variant-member-handle-in-list-at
    session
    (csym.compiler-symbol-make-handle (csym.compiler-symbol-kind-defenum) 0)
    name-id
    variants
    0)
    [(Some _)
      (let
        [separator : String
          (if (= (string.string-length out) 0)
            ""
            " or ")]
        (str_cat.str-cat
          out
          separator
          (tc-env-key-name-text enum-name)
          "."
          (ci.intern-str name-id)))]
    [(None) out]))

;; `A.V or B.V` over the enums of `module-id` that declare `name-id`.
(define (tc-bare-variant-module-candidates
  [session : cis.InternStructuralSessionHandle]
  [decls : (& decls ast.AstDeclList)]
  [module-id : i64]
  [name-id : i64]
  [prefix : String]) : String
  (let
    [slot : i64 (tc-module-decl-index-slot module-id)]
    [j : i64
      (if (< slot 0)
        0
        (array-ref tc-module-decl-index-starts slot))]
    [end : i64
      (if (< slot 0)
        0
        (array-ref tc-module-decl-index-ends slot))]
    [out : String prefix]
    (while (< j end)
      (match (ast.ast-decl-unwrapped
        (&
          (array-ref
            decls.slots
            (+ decls.offset (array-ref tc-module-decl-index-positions j)))))
        [(or (DefEnum _ enum-name _ variants)
             (DefEnumLifetimes _ enum-name _ _ variants))
          (set!
            out
            (tc-bare-variant-candidate-append
              session
              out
              enum-name
              (& variants)
              name-id))]
        [_ unit])
      (set! j (+ j 1)))
    out))

(define (tc-bare-variant-ambiguous-message [ctx : TcContext] [name-id : i64]) : String
  (match (tc-context-program ctx)
    [(Program decls-box)
      (let
        [decls : ast.AstDeclList (ast.ast-decl-list-box-shared-view decls-box)]
        [_ensure : unit (tc-module-decl-index-ensure! (& decls))]
        [session : cis.InternStructuralSessionHandle
          (tc-context-structural-session ctx)]
        [module-id : i64 (tc-context-module-id ctx)]
        [slot : i64 (tc-module-decl-index-slot module-id)]
        [j : i64
          (if (< slot 0)
            0
            (array-ref tc-module-import-index-starts slot))]
        [end : i64
          (if (< slot 0)
            0
            (array-ref tc-module-import-index-ends slot))]
        [candidates : String
          (tc-bare-variant-module-candidates
            session
            (& decls)
            module-id
            name-id
            "")]
        (while (< j end)
          (let
            [target : i64
              (tc-bare-variant-star-target-at
                (& decls)
                (array-ref tc-module-import-index-positions j))]
            (if (< target 0)
              unit
              (set!
                candidates
                (tc-bare-variant-module-candidates
                  session
                  (& decls)
                  target
                  name-id
                  candidates)))
            (set! j (+ j 1))))
        (tc-kind-message
          (UnboundName)
          (str_cat.str-cat
            "typecheck: ambiguous variant `"
            (ci.intern-str name-id)
            "`; qualify as "
            candidates)))]))

;; Lexical storage (a let, parameter or lambda binding, hygiene-scoped by its
;; id) shadows every declaration, variants included.
(define (tc-bare-variant-local-binding? [env : TcTypeEnv] [name-id : i64]) : bool
  (or
    (and
      (tc-type-env-scoped-runtime-active? env)
      (>= (tc-type-env-scoped-runtime-lookup-index env name-id) 0))
    (tc-name-local-bound-before-module-scan-id? env name-id)))

;; Whether `ty` can be an enum (an unresolved nominal may be one). Checked
;; before any name query, so the common non-enum expected type costs one match.
(define (tc-enum-shaped-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(or (Enum _) (EnumArgs _ _) (Var _) (VarArgs _ _)) true]
    [_ false]))

;; Whether a binding of type `ty` can be a variant constructor: an enum value
;; (nullary) or a function returning one.
(define (tc-variant-constructor-shaped-type?
  [ctx : TcContext]
  [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(Func _ ret-id) (tc-enum-shaped-type? (tc-context-type-get ctx ret-id))]
    [(or (Enum _) (EnumArgs _ _)) true]
    [_ false]))

;; No expected enum: a bare name bound to a variant constructor keeps the
;; ordinary lookup when one visible enum declares it; two are ambiguous.
(define (tc-bare-variant-unexpected-check
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [ty : ast.AstType]) : ResultTcUnit
  (if (and
    (tc-bare-variant-declared-name? ctx name-id)
    (tc-variant-constructor-shaped-type? ctx ty)
    (tc-bare-variant-name-id? name-id)
    (= (tc-bare-variant-visible-handle ctx name-id) -2)
    (not (tc-bare-variant-local-binding? env name-id)))
    (Err (tc-bare-variant-ambiguous-message ctx name-id))
    Ok))

;; The lookup of a bare name the environment does not bind: only a variant of
;; a visible enum resolves, so a loaded module the file never imported stays
;; invisible.
(define (tc-bare-variant-constructor-type-or
  [ctx : TcContext]
  [name-id : i64]
  [not-found-message : String]) : ResultTcType
  (let
    [handle : i64 (tc-bare-variant-visible-handle ctx name-id)]
    (cond
      [(= handle -2) (Err (tc-bare-variant-ambiguous-message ctx name-id))]
      [(< handle 0) (Err not-found-message)]
      [else (tc-variant-constructor-type-for-handle ctx handle)])))

(define (tc-expected-enum-name-id [ctx : TcContext] [expected : ast.AstType]) : i64
  (match (tc-type-strip-region
    (match (tc-type-strip-region (tc-global-shared-view expected))
      [(or (Var _) (VarArgs _ _))
        (tc-resolve-type ctx (tc-global-shared-view expected))]
      [_ (tc-global-shared-view expected)]))
    [(or (Enum enum-id) (EnumArgs enum-id _)) enum-id]
    [_ -1]))

;; A function, value or struct constructor that the current module declares or
;; imports unqualified under the variant's name. The root module keys values by
;; bare name, which every module's flat aliases share, so there only the root's
;; own declarations count.
(define (tc-bare-variant-declaration-conflict?
  [ctx : TcContext]
  [handle : i64]
  [struct? : bool]) : bool
  (and
    (csym.compiler-symbols-handle-found? handle)
    (if struct?
      (=
        (csym.compiler-symbol-handle-kind handle)
        (csym.compiler-symbol-kind-defstruct))
      (not
        (=
          (csym.compiler-symbol-handle-kind handle)
          (csym.compiler-symbol-kind-enum-variant))))
    (or
      (not (csym.compiler-symbol-root-module-id? (tc-context-module-id ctx)))
      (csym.compiler-symbol-root-module-id?
        (csym.compiler-symbols-owner-module-id-at-index-or
          (tc-context-symbols ctx)
          (csym.compiler-symbol-handle-index handle)
          cbi.compiler-builtin-id-runtime-module)))))

(define (tc-bare-variant-value-conflict? [ctx : TcContext] [name-id : i64]) : bool
  (or
    (tc-bare-variant-declaration-conflict?
      ctx
      (csym.compiler-symbols-lookup-value-in-module-id-or
        (tc-context-symbols ctx)
        (tc-context-module-id ctx)
        name-id
        (csym.compiler-symbols-missing-handle))
      false)
    (tc-bare-variant-declaration-conflict?
      ctx
      (csym.compiler-symbols-lookup-type-in-module-id-or
        (tc-context-symbols ctx)
        (tc-context-module-id ctx)
        name-id
        (csym.compiler-symbols-missing-handle))
      true)))

(define (tc-bare-variant-enum-name-id [ctx : TcContext] [handle : i64]) : i64
  (match (csym.compiler-symbols-decl-at-index
    (tc-context-symbols ctx)
    (csym.compiler-registry-handle-owner-index handle))
    [(Ok decl)
      (match (ast.ast-decl-unwrapped (& decl))
        [(or (DefEnum _ name _ _) (DefEnumLifetimes _ name _ _ _)) name]
        [_ -1])]
    [(Err _) -1]))

;; R1/R2: where the expected type is an enum declaring `name-id`, the bare name
;; is that enum's variant unless a local binding shadows it; a same-named
;; module function, value or struct constructor makes it ambiguous. When the
;; ordinary lookup would pick another variant, the `Var` node is rewritten to
;; `Enum.Variant` as seen from the enum's own module (the hygienic spelling a
;; macro template produces), so lowering, specialization and the semantic
;; index resolve the same variant without the expected type. Typed
;; macro-operand checks journal the rewrite and restore the written name.
(define (tc-expected-bare-variant-retarget!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [var-id : i64]
  [name-id : i64]
  [expected : ast.AstType]) : ResultTcNameId
  (let
    [enum-id : i64
      (if (and
        (tc-bare-variant-declared-name? ctx name-id)
        (tc-enum-shaped-type? (tc-global-shared-view expected))
        (tc-bare-variant-name-id? name-id))
        (tc-expected-enum-name-id ctx expected)
        -1)]
    [handle : i64
      (if (< enum-id 0)
        (csym.compiler-symbols-missing-handle)
        (tc-source-variant-handle-for-enum-id-or
          ctx
          enum-id
          name-id
          (csym.compiler-symbols-missing-handle)))]
    (cond
      [(not (csym.compiler-symbols-handle-found? handle)) (Ok name-id)]
      [(tc-bare-variant-value-conflict? ctx name-id)
        (if (tc-bare-variant-local-binding? env name-id)
          (Ok name-id)
          (Err
            (tc-kind-message
              (UnboundName)
              (str_cat.str-cat
                "typecheck: ambiguous `"
                (ci.intern-str name-id)
                "`: both the variant "
                (tc-env-key-name-text (tc-bare-variant-enum-name-id ctx handle))
                "."
                (ci.intern-str name-id)
                " and a module-level declaration of that name are visible; qualify the variant"))))]
      [(= (tc-bare-variant-visible-handle ctx name-id) handle) (Ok name-id)]
      [(tc-bare-variant-local-binding? env name-id) (Ok name-id)]
      [else
        (let
          [qualified-id : i64
            (macro-hygiene-global-id
              (tc-context-structural-session ctx)
              (csym.compiler-symbols-owner-module-id-at-index-or
                (tc-context-symbols ctx)
                (csym.compiler-registry-handle-owner-index handle)
                (csym.compiler-symbol-root-module-id))
              (ci.intern
                (str_cat.str-cat
                  (tc-env-key-name-text
                    (tc-bare-variant-enum-name-id ctx handle))
                  "."
                  (ci.intern-str name-id)))
              false)]
          (tc-dotted-macro-journal-record!
            (tc-context-macro-state ctx)
            var-id
            (Var name-id))
          (ast.ast-node-set! var-id (Var qualified-id))
          (Ok qualified-id))])))

;; The callee of a call in an expected-enum position, when it is a `Var`.
(define (tc-expected-call-variant-retarget!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]
  [expected : ast.AstType]) : ResultTcUnit
  (if (tc-enum-shaped-type? (tc-global-shared-view expected))
    (tc-expected-callee-variant-retarget! ctx env func-id expected)
    Ok))

(define (tc-expected-callee-variant-retarget!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]
  [expected : ast.AstType]) : ResultTcUnit
  (match (tc-context-expr-get ctx func-id)
    [(Spanned inner-id _)
      (tc-expected-callee-variant-retarget! ctx env inner-id expected)]
    [(Var name-id)
      (let
        [_
          (try
            (tc-expected-bare-variant-retarget!
              ctx
              env
              func-id
              name-id
              expected))]
        Ok)]
    [_ Ok]))

;; A bare binder in a variant payload position that spells a variant of the
;; payload's enum would silently match every value; require `(V)` or another
;; name (the precedent is Rust's `bindings_with_variant_name` lint).
(define (tc-payload-binder-variant-check
  [ctx : TcContext]
  [pattern : ast.AstPattern]
  [payload-ty : ast.AstType]) : ResultTcUnit
  (let
    [name-id : i64
      (match pattern
        [(or (Binding name) (Var name _)) name]
        [_ -1])]
    [enum-id : i64
      (if (or
        (not (tc-bare-variant-declared-name? ctx name-id))
        (not (tc-enum-shaped-type? (tc-global-shared-view payload-ty)))
        (ci.intern-macro-global-name-id? name-id)
        (ci.intern-macro-local-name-id? name-id))
        -1
        (tc-expected-enum-name-id ctx payload-ty))]
    (if (or
      (< enum-id 0)
      (not
        (csym.compiler-symbols-handle-found?
          (tc-source-variant-handle-for-enum-id-or
            ctx
            enum-id
            name-id
            (csym.compiler-symbols-missing-handle)))))
      Ok
      (Err
        (tc-kind-message
          (Pattern)
          (str_cat.str-cat
            "typecheck: pattern binder `"
            (ci.intern-str name-id)
            "` spells a variant of the payload enum "
            (tc-nominal-name-id-display enum-id)
            "; write `("
            (ci.intern-str name-id)
            ")` to match that variant or rename the binder"))))))

(define (tc-variant-name-for-enum [enum-name : String] [variant-name : String]) : String
  (if (tc-name-qualified? variant-name)
    variant-name
    (tc-qualified-variant-name enum-name variant-name)))

(define (tc-source-variant-name-for-enum-id
  [ctx : TcContext]
  [enum-name : String]
  [variant-name : String]
  [variant-id : i64]) : String
  (cond
    [(< variant-id 0)
      (if (>= (tc-name-first-dot variant-name) 0)
        variant-name
        (tc-qualified-variant-name enum-name variant-name))]
    [(tc-name-qualified-id? (tc-context-structural-session ctx) variant-id)
      variant-name]
    [(>=
        (tc-name-first-dot-id (tc-context-structural-session ctx) variant-id)
        0)
      (let
        [current-module-id : i64 (tc-context-module-id ctx)]
        (match (tc-enum-qualified-variant-lookup-key-from-id
          ctx
          (tc-global-shared-view variant-name)
          variant-id
          current-module-id)
          [(Ok lookup-name) lookup-name]
          [(Err _)
            (match (tc-dotted-type-name-lookup-key-from-id
              ctx
              (tc-global-shared-view variant-name)
              variant-id)
              [(Ok lookup-name) lookup-name]
              [(Err _) variant-name])]))]
    [else
      (let
        [handle : i64
          (csym.compiler-registries-lookup-variant-id-or
            (tc-context-registries ctx)
            variant-id
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? handle)
          (match (tc-variant-owner-name ctx handle)
            [(Ok owner)
              (if (string.eq owner enum-name)
                variant-name
                (tc-qualified-variant-name enum-name variant-name))]
            [(Err _) (tc-qualified-variant-name enum-name variant-name)])
          (tc-qualified-variant-name enum-name variant-name)))]))

(define (tc-dotted-alias-flat-variant-key-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [_name : (& _name str)]
  [name-id : i64]) : option_i64.Option
  (let
    [alias-id : i64 (ci.intern-leading-dot-id name-id)]
    [tail-id : i64 (ci.intern-dotted-tail-id name-id)]
    [enum-name-id : i64
      (if (>= tail-id 0)
        (ci.intern-leading-dot-id tail-id)
        -1)]
    [variant-id : i64
      (if (>= tail-id 0)
        (ci.intern-dotted-tail-id tail-id)
        -1)]
    (if (or (< alias-id 0) (< enum-name-id 0) (< variant-id 0))
      None
      (let
        [target-module-id : i64
          (match (tc-context-program ctx)
            [(Program decls-box)
              (match (tc-source-dotted-alias-target-id-in-context
                ctx
                (ast.ast-decl-list-box-shared-view decls-box)
                (tc-context-module-id ctx)
                alias-id)
                [(Some target-id) target-id]
                [(No) -1])])]
        [target-qualified-key-id : i64
          (csym.compiler-symbol-module-key-id-by-id
            target-module-id
            (csym.compiler-enum-qualified-variant-name-id
              enum-name-id
              variant-id))]
        [target-flat-key-id : i64
          (csym.compiler-symbol-module-key-id-by-id target-module-id variant-id)]
        [alias-qualified-key-id : i64
          (csym.compiler-symbol-module-key-id-by-id
            alias-id
            (csym.compiler-enum-qualified-variant-name-id
              enum-name-id
              variant-id))]
        [alias-flat-key-id : i64
          (csym.compiler-symbol-module-key-id-by-id alias-id variant-id)]
        [enum-qualified-key-id : i64
          (csym.compiler-enum-qualified-variant-name-id enum-name-id variant-id)]
        (cond
          [(and
              (>= target-module-id 0)
              (tc-source-name-bound-exact-id? env target-qualified-key-id))
            (Some target-qualified-key-id)]
          [(and
              (>= target-module-id 0)
              (tc-source-name-bound-exact-id? env target-flat-key-id))
            (Some target-flat-key-id)]
          [(tc-source-name-bound-exact-id? env alias-qualified-key-id)
            (Some alias-qualified-key-id)]
          [(tc-source-name-bound-exact-id? env alias-flat-key-id)
            (Some alias-flat-key-id)]
          [(tc-source-name-bound-exact-id? env enum-qualified-key-id)
            (Some enum-qualified-key-id)]
          [(tc-source-name-bound-exact-id? env variant-id) (Some variant-id)]
          [else None])))))

(define (tc-dotted-alias-variant-key-id
  [ctx : TcContext]
  [_variant-name : String]
  [variant-name-id : i64]) : option_i64.Option
  (let
    [alias-id : i64 (ci.intern-leading-dot-id variant-name-id)]
    [tail-id : i64 (ci.intern-dotted-tail-id variant-name-id)]
    [tail-tail-id : i64
      (if (>= tail-id 0)
        (ci.intern-dotted-tail-id tail-id)
        -1)]
    [enum-name-id : i64
      (if (>= tail-tail-id 0)
        (ci.intern-leading-dot-id tail-id)
        -1)]
    [base-name-id : i64
      (if (>= tail-tail-id 0)
        tail-tail-id
        tail-id)]
    (if (or
      (< alias-id 0)
      (< base-name-id 0)
      (= (string.string-length (ci.intern-str alias-id)) 0)
      (= (string.string-length (ci.intern-str base-name-id)) 0)
      (and
        (>= tail-tail-id 0)
        (or
          (< enum-name-id 0)
          (= (string.string-length (ci.intern-str enum-name-id)) 0))))
      None
      (match (tc-context-program ctx)
        [(Program decls-box)
          (match (tc-source-dotted-alias-target-id-in-context
            ctx
            (ast.ast-decl-list-box-shared-view decls-box)
            (tc-context-module-id ctx)
            alias-id)
            [(Some target-module-id)
              (let
                [key-id : i64
                  (csym.compiler-symbol-module-key-id-by-id
                    target-module-id
                    (if (< enum-name-id 0)
                      base-name-id
                      (csym.compiler-enum-qualified-variant-name-id
                        enum-name-id
                        base-name-id)))]
                (match (csym.compiler-registries-lookup-variant-key-id
                  (tc-context-registries ctx)
                  key-id)
                  [(Some _) (Some key-id)]
                  [(None)
                    (let
                      [alias-key-id : i64
                        (csym.compiler-symbol-module-key-id-by-id
                          target-module-id
                          base-name-id)]
                      (match (csym.compiler-registries-lookup-variant-key-id
                        (tc-context-registries ctx)
                        alias-key-id)
                        [(Some _) (Some alias-key-id)]
                        [(None) None]))]))]
            [(No) None])]))))

(define (tc-dotted-alias-variant-handle
  [ctx : TcContext]
  [_variant-name : (& _variant-name str)]
  [variant-name-id : i64]) : option_i64.Option
  (match (tc-dotted-alias-variant-key-id ctx "" variant-name-id)
    [(Some key-id)
      (csym.compiler-registries-lookup-variant-key-id
        (tc-context-registries ctx)
        key-id)]
    [(None)
      (let
        [tail-id : i64 (ci.intern-dotted-tail-id variant-name-id)]
        [enum-id : i64
          (if (>= tail-id 0)
            (ci.intern-leading-dot-id tail-id)
            -1)]
        [base-id : i64
          (if (>= tail-id 0)
            (ci.intern-dotted-tail-id tail-id)
            -1)]
        (if (or (< enum-id 0) (< base-id 0))
          None
          (match (csym.compiler-registries-lookup-variant-id
            (tc-context-registries ctx)
            base-id)
            [(Some handle)
              (if (=
                (tc-qualified-name-base-id
                  (tc-variant-owner-id-or ctx handle -1))
                enum-id)
                (Some handle)
                (tc-dotted-alias-variant-handle-for-enum-id
                  ctx
                  variant-name-id
                  enum-id
                  base-id))]
            [(None)
              (tc-dotted-alias-variant-handle-for-enum-id
                ctx
                variant-name-id
                enum-id
                base-id)])))]))

(define (tc-dotted-alias-variant-handle-for-enum-id
  [ctx : TcContext]
  [variant-name-id : i64]
  [enum-id : i64]
  [variant-id : i64]) : option_i64.Option
  (let
    [alias-id : i64 (ci.intern-leading-dot-id variant-name-id)]
    [alias-enum-key-id : i64
      (csym.compiler-symbol-module-key-id-by-id alias-id enum-id)]
    (match (tc-variant-handle-for-enum-id-and-name-id
      ctx
      alias-enum-key-id
      variant-id)
      [(Some handle) (Some handle)]
      [(None)
        (match (tc-context-program ctx)
          [(Program decls-box)
            (match (tc-source-dotted-alias-target-id-in-context
              ctx
              (ast.ast-decl-list-box-shared-view decls-box)
              (tc-context-module-id ctx)
              alias-id)
              [(Some target-module-id)
                (match (tc-variant-handle-for-enum-id-and-name-id
                  ctx
                  (csym.compiler-symbol-module-key-id-by-id
                    target-module-id
                    enum-id)
                  variant-id)
                  [(Some handle) (Some handle)]
                  [(None)
                    (tc-variant-handle-for-enum-id-and-name-id
                      ctx
                      enum-id
                      variant-id)])]
              [(No)
                (tc-variant-handle-for-enum-id-and-name-id
                  ctx
                  enum-id
                  variant-id)])])])))

(define (tc-variant-handle-for-enum-id-and-name-id
  [ctx : TcContext]
  [enum-id : i64]
  [variant-id : i64]) : option_i64.Option
  (let
    [enum-handle : i64
      (csym.compiler-symbols-lookup-type-id-or
        (tc-context-symbols ctx)
        enum-id
        (csym.compiler-symbols-missing-handle))]
    (if (and
      (csym.compiler-symbols-handle-found? enum-handle)
      (=
        (csym.compiler-symbol-handle-kind enum-handle)
        (csym.compiler-symbol-kind-defenum)))
      (match (csym.compiler-symbols-decl-at-index
        (tc-context-symbols ctx)
        (csym.compiler-symbol-handle-index enum-handle))
        [(Ok decl)
          (match decl
            [(or (DefEnum _ _ _ variants) (DefEnumLifetimes _ _ _ _ variants))
              (tc-variant-handle-in-list-at
                (tc-context-structural-session ctx)
                enum-handle
                variant-id
                (& variants)
                0)]
            [_ None])]
        [(Err _) None])
      None)))

(define tc-canonical-enum-decl-index-ready : bool
  false)
(define tc-canonical-enum-decl-index-registry-id : i64
  -1)
(define tc-canonical-enum-decl-index-arena : i64
  0)
(define tc-canonical-enum-decl-index-positions : csym.CompilerSymbolMap
  (csym.compiler-symbol-map-with-capacity 16))

(define (tc-canonical-enum-decl-index-bind!
  [positions : (&mut positions csym.CompilerSymbolMap)]
  [name-id : i64]
  [position : i64]) : unit
  (let
    [key-id : i64 (ci.intern (tc-variant-member-name-text name-id))]
    [value : i64 (+ position 1)]
    [previous : i64
      (csym.compiler-symbol-map-lookup-handle-id positions key-id)]
    (cond
      [(< previous 0)
        (csym.compiler-symbol-map-bind-id! positions key-id value)]
      [(= previous value) unit]
      [else (csym.compiler-symbol-map-bind-id! positions key-id 0)])))

(define (tc-canonical-enum-decl-index-ensure! [ctx : TcContext]) : unit
  (let
    [registry-id : i64
      (csym.compiler-registries-identity (tc-context-registries ctx))]
    (if (and
      tc-canonical-enum-decl-index-ready
      (= tc-canonical-enum-decl-index-registry-id registry-id))
      unit
      (let
        [decls : (__tl_dyn-array ast.AstDecl)
          (csym.compiler-symbols-decls (tc-context-symbols ctx))]
        [count : i64
          (csym.compiler-symbols-decl-count (tc-context-symbols ctx))]
        [prev-arena : i64 (arena.tl_arena_current)]
        [index-arena : i64 (arena.tl_arena_make)]
        [_switch : unit
          (unsafe
            (arena.tl_arena_set index-arena))]
        [positions : csym.CompilerSymbolMap
          (csym.compiler-symbol-map-with-capacity 64)]
        [index : i64 0]
        (while (< index count)
          (match (array-ref decls index)
            [(or (DefEnum _ name _ _) (DefEnumLifetimes _ name _ _ _))
              (tc-canonical-enum-decl-index-bind! (&mut positions) name index)]
            [_ unit])
          (set! index (+ index 1)))
        (if (= tc-canonical-enum-decl-index-arena 0)
          unit
          (unsafe
            (arena.tl_arena_destroy tc-canonical-enum-decl-index-arena)))
        (set! tc-canonical-enum-decl-index-positions positions)
        (set! tc-canonical-enum-decl-index-registry-id registry-id)
        (set! tc-canonical-enum-decl-index-arena index-arena)
        (set! tc-canonical-enum-decl-index-ready true)
        (unsafe
          (arena.tl_arena_set prev-arena))))))

(define (tc-variant-handle-for-canonical-enum-id-and-name-id
  [ctx : TcContext]
  [enum-id : i64]
  [variant-id : i64]) : option_i64.Option
  (let
    [_ensure : unit (tc-canonical-enum-decl-index-ensure! ctx)]
    [key-id : i64 (ci.intern (tc-variant-member-name-text enum-id))]
    [value : i64
      (csym.compiler-symbol-map-lookup-handle-id
        (& tc-canonical-enum-decl-index-positions)
        key-id)]
    (if (<= value 0)
      None
      (let
        [index : i64 (- value 1)]
        (match (array-ref
          (csym.compiler-symbols-decls (tc-context-symbols ctx))
          index)
          [(or (DefEnum _ _ _ variants) (DefEnumLifetimes _ _ _ _ variants))
            (tc-variant-handle-in-list-at
              (tc-context-structural-session ctx)
              (csym.compiler-symbol-make-handle
                (csym.compiler-symbol-kind-defenum)
                index)
              variant-id
              (& variants)
              0)]
          [_ None])))))

(define (tc-variant-handle-in-list-at
  [session : cis.InternStructuralSessionHandle]
  [enum-handle : i64]
  [variant-id : i64]
  [variants : (& variants ast.AstVariantDefList)]
  [index : i64]) : option_i64.Option
  (tc-variant-member-handle-in-list-at
    session
    enum-handle
    (tc-variant-member-name-id session variant-id)
    variants
    index))

(define (tc-variant-member-handle-in-list-at
  [session : cis.InternStructuralSessionHandle]
  [enum-handle : i64]
  [variant-member : i64]
  [variants : (& variants ast.AstVariantDefList)]
  [index : i64]) : option_i64.Option
  (if (>= index variants.len)
    None
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(Def name _ _)
        (if (tc-variant-member-id-eq?
          (tc-variant-member-name-id session name)
          variant-member)
          (Some
            (csym.compiler-registry-make-handle
              (csym.compiler-symbol-kind-enum-variant)
              (csym.compiler-symbol-handle-index enum-handle)
              index))
          (tc-variant-member-handle-in-list-at
            session
            enum-handle
            variant-member
            variants
            (+ index 1)))])))

(define (tc-variant-member-name-id
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : i64
  (let
    [member-id : i64
      (cond
        [(csym.compiler-composite-triple-key-id? name-id)
          (csym.compiler-composite-triple-right-id name-id)]
        [(csym.compiler-composite-pair-key-id? name-id)
          (csym.compiler-composite-pair-right-id name-id)]
        [(and
            (>= name-id 0)
            (< name-id (ci.intern-capacity))
            (>= (tc-name-first-dot-id session name-id) 0))
          (ci.intern-dotted-final-id name-id)]
        [else name-id])]
    (macro-hygiene-global-source-name-id-or session member-id member-id)))

(define (tc-variant-member-id-eq? [left : i64] [right : i64]) : bool
  (cond
    [(= left right) true]
    [(or
        (< left 0)
        (>= left (ci.intern-capacity))
        (< right 0)
        (>= right (ci.intern-capacity)))
      false]
    [(and (tc-variant-member-dotless? left) (tc-variant-member-dotless? right))
      (string.eq (ci.intern-str left) (ci.intern-str right))]
    [else
      (string.eq
        (tc-variant-member-name-text left)
        (tc-variant-member-name-text right))]))

;; A source-lane id records where its first dot is when it is interned, so a
;; dotless one is its own member name.
(define (tc-variant-member-dotless? [name-id : i64]) : bool
  (and (< name-id (ci.intern-pool-len)) (< (ci.intern-first-dot name-id) 0)))

(define (tc-variant-member-name-text [name-id : i64]) : String
  (let
    [name : String (tc-env-key-name-text name-id)]
    [len : i64 (string.string-length name)]
    [data : (Ptr u8)
      (unsafe
        (string-data (& name)))]
    [last-dot : i64 -1]
    [index : i64 0]
    (while (< index len)
      (if (=
        (unsafe
          (ptr-read (ptr-offset data index)))
        (cast 46 : u8))
        (set! last-dot index)
        unit)
      (set! index (+ index 1)))
    (if (and (>= last-dot 0) (< last-dot (- len 1)))
      (string.substring name (+ last-dot 1) (- len (+ last-dot 1)))
      name)))

(define (tc-variant-name-matches-id?
  [ctx : TcContext]
  [enum-id : i64]
  [pattern-id : i64]
  [variant-id : i64]) : bool
  (tc-variant-name-matches-resolved?
    ctx
    enum-id
    pattern-id
    (tc-variant-name-handle ctx enum-id pattern-id)
    (tc-variant-member-name-id (tc-context-structural-session ctx) pattern-id)
    variant-id
    (tc-variant-name-handle ctx enum-id variant-id)
    (tc-variant-member-name-id (tc-context-structural-session ctx) variant-id)))

;; `tc-variant-name-matches-id?` for names already resolved with
;; `tc-variant-name-handle` and `tc-variant-member-name-id`.
(define (tc-variant-name-matches-resolved?
  [ctx : TcContext]
  [enum-id : i64]
  [pattern-id : i64]
  [pattern-handle : i64]
  [pattern-member : i64]
  [variant-id : i64]
  [variant-handle : i64]
  [variant-member : i64]) : bool
  (cond
    [(= pattern-id variant-id) true]
    [(or (< enum-id 0) (< pattern-id 0) (< variant-id 0)) false]
    [else
      (and
        (csym.compiler-symbols-handle-found? pattern-handle)
        (csym.compiler-symbols-handle-found? variant-handle)
        (or
          (= pattern-handle variant-handle)
          (and
            (= pattern-member variant-member)
            (tc-variant-handle-owner-id-eq?
              ctx
              (tc-context-symbols ctx)
              pattern-handle
              variant-handle))))]))

(define (tc-variant-name-handle
  [ctx : TcContext]
  [enum-id : i64]
  [name-id : i64]) : i64
  (if (or (< enum-id 0) (< name-id 0))
    (csym.compiler-symbols-missing-handle)
    (tc-source-variant-handle-for-enum-id-or
      ctx
      enum-id
      name-id
      (csym.compiler-symbols-missing-handle))))

(define (tc-variant-handle-owner-id-eq?
  [ctx : TcContext]
  [symbols : (& symbols csym.CompilerSymbols)]
  [left : i64]
  [right : i64]) : bool
  (let
    [left-owner : i64
      (csym.compiler-symbols-owner-id-at-index-or
        symbols
        (csym.compiler-registry-handle-owner-index left)
        -1)]
    [right-owner : i64
      (csym.compiler-symbols-owner-id-at-index-or
        symbols
        (csym.compiler-registry-handle-owner-index right)
        -2)]
    (or
      (tc-nominal-name-id-eq? left-owner right-owner)
      (tc-nominal-name-id-canonical-eq? ctx left-owner right-owner))))

(define (tc-expr-pattern-enum-id) : i64
  (tc-stdlib-comptime-type-key-id "Expr" cbi.compiler-builtin-id-fix-Expr))

(define (tc-expr-variant-pattern-id?
  [ctx : TcContext]
  [pattern-id : i64]
  [variant-id : i64]) : bool
  (or
    (tc-variant-name-matches-id?
      ctx
      (tc-expr-pattern-enum-id)
      pattern-id
      variant-id)
    ;; `Expr` is represented by the compiler-owned syntax type after the
    ;; verified stdlib declaration is loaded.  Its ordinary registry owner is
    ;; therefore not always available to the generic qualified-variant lookup.
    ;; Preserve the public `Expr.Var` spelling by checking both the short member
    ;; identity and the immediately preceding enum qualifier.  A different
    ;; owner such as `Other.Var` remains rejected.
    (and
      (>= pattern-id 0)
      (< pattern-id (ci.intern-capacity))
      (>=
        (tc-name-first-dot-id (tc-context-structural-session ctx) pattern-id)
        0)
      (= (ci.intern-dotted-final-id pattern-id) variant-id)
      (tc-nominal-name-id-eq?
        (ci.intern-dotted-prefix-id pattern-id)
        cbi.compiler-builtin-id-fix-Expr))))

(define (tc-expr-variant-payload-types [ctx : TcContext] [variant-id : i64]) : ResultTcTypeList
  (cond
    [(tc-expr-variant-pattern-id?
        ctx
        variant-id
        cbi.compiler-builtin-id-comptime-expr-bool-variant)
      (Ok (tc-type-list1 (Bool)))]
    [(tc-expr-variant-pattern-id?
        ctx
        variant-id
        cbi.compiler-builtin-id-comptime-expr-int-variant)
      (Ok (tc-type-list1 (I64)))]
    [(tc-expr-variant-pattern-id?
        ctx
        variant-id
        cbi.compiler-builtin-id-comptime-expr-var-variant)
      (Ok (tc-type-list1 (String)))]
    [(tc-expr-variant-pattern-id?
        ctx
        variant-id
        cbi.compiler-builtin-id-comptime-expr-splice-variant)
      (Ok (tc-type-list1 (Expr)))]
    [(tc-expr-variant-pattern-id?
        ctx
        variant-id
        cbi.compiler-builtin-id-comptime-expr-if-variant)
      (Ok (tc-type-list3 (Expr) (Expr) (Expr)))]
    [(tc-expr-variant-pattern-id?
        ctx
        variant-id
        cbi.compiler-builtin-id-comptime-expr-call-variant)
      (Ok (tc-type-list2 (Expr) (ExprList)))]
    [(tc-expr-variant-pattern-id?
        ctx
        variant-id
        cbi.compiler-builtin-id-comptime-expr-begin-variant)
      (Ok (tc-type-list1 (ExprList)))]
    [(tc-expr-variant-pattern-id?
        ctx
        variant-id
        cbi.compiler-builtin-id-comptime-expr-quote-variant)
      (Ok (tc-type-list1 (Expr)))]
    [(tc-expr-variant-pattern-id?
        ctx
        variant-id
        cbi.compiler-builtin-id-comptime-expr-quasiquote-variant)
      (Ok (tc-type-list1 (Expr)))]
    [(tc-expr-variant-pattern-id?
        ctx
        variant-id
        cbi.compiler-builtin-id-comptime-expr-unquote-variant)
      (Ok (tc-type-list1 (Expr)))]
    [(tc-expr-variant-pattern-id?
        ctx
        variant-id
        cbi.compiler-builtin-id-comptime-expr-unquote-splicing-variant)
      (Ok (tc-type-list1 (Expr)))]
    [else
      (Err
        (str_cat.str-cat
          "typecheck: unknown Expr variant "
          (tc-env-key-name-text variant-id)))]))

(define (tc-bind-expr-variant-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [variant-id : i64]
  [args : ast.AstPatternList]) : ResultTcEnv
  (let
    [payloads : ast.AstTypeList
      (try (tc-expr-variant-payload-types ctx variant-id))]
    (tc-bind-pattern-list ctx env Sub args payloads)))

(define (tc-bind-expr-match-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [pattern : ast.AstPattern]) : ResultTcEnv
  (match pattern
    [(Wildcard) (Ok env)]
    [(Binding name) (Ok (tc-bind-id env name (Expr)))]
    [(Variant variant-name args-box)
      (let
        [args : ast.AstPatternList
          (ast.ast-pattern-list-box-shared-view args-box)]
        (tc-bind-expr-variant-pattern ctx env variant-name args))]
    [_ (Err "typecheck: unsupported Expr match pattern")]))

(define (tc-expr-clause-pattern-name? [name : i64]) : bool
  (= name cbi.compiler-builtin-id-fix-ExprClause))

(define (tc-bind-expr-clause-match-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [pattern : ast.AstPattern]) : ResultTcEnv
  (match pattern
    [(Wildcard) (Ok env)]
    [(Binding name) (Ok (tc-bind-id env name (tc-macro-expr-clause-type)))]
    [(Variant variant-name args-box)
      (if (tc-expr-clause-pattern-name? variant-name)
        (tc-bind-pattern-list
          ctx
          env
          Sub
          (ast.ast-pattern-list-box-shared-view args-box)
          (tc-type-list2 (Expr) (Expr)))
        (Err
          (str_cat.str-cat
            "typecheck: unknown ExprClause constructor "
            (ci.intern-str variant-name))))]
    [_ (Err "typecheck: unsupported ExprClause match pattern")]))

(define (tc-expr-clause-pattern-irrefutable?
  [ctx : TcContext]
  [pattern : ast.AstPattern]) : bool
  (match pattern
    [(or (Wildcard) (Binding _)) true]
    [(Variant name args-box)
      (if (tc-expr-clause-pattern-name? name)
        (tc-pattern-list-irrefutable?
          ctx
          (ast.ast-pattern-list-box-shared-view args-box)
          (tc-type-list2 (Expr) (Expr)))
        false)]
    [_ false]))

(define (tc-enum-single-matching-variant-id
  [ctx : TcContext]
  [variants : ast.AstVariantDefList]
  [enum-id : i64]
  [pattern-id : i64]) : TcMaybeNameId
  (if (= variants.len 1)
    (match (ast.ast-variant-def-list-get
      (& variants)
      0
      (ast.ast-variant-def-fallback))
      [(Def name _ _)
        (if (tc-variant-name-matches-id? ctx enum-id pattern-id name)
          (Some name)
          (No))])
    (No)))

;; Variant registries retain declaration-spelled payload types. Resolve them in
;; the enum owner's module just as binding does before recursively deciding
;; whether the payload pattern covers the whole variant.
(define (tc-variant-pattern-irrefutable-id?
  [ctx : TcContext]
  [enum-id : i64]
  [variant-id : i64]
  [enum-lifetimes : ast.AstLifetimeList]
  [args : ast.AstPatternList]) : bool
  (let
    [handle : i64
      (tc-source-variant-handle-for-enum-id-or
        ctx
        enum-id
        variant-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (let
        [owner-id : i64 (tc-variant-owner-id-or ctx handle -1)]
        (if (and
          (>= owner-id 0)
          (or
            (tc-nominal-name-id-eq? owner-id enum-id)
            (tc-nominal-name-id-canonical-eq? ctx owner-id enum-id)))
          (match (csym.compiler-registries-variant-fields-indexed
            (tc-context-symbols ctx)
            handle)
            [(Ok fields)
              (match (tc-variant-pattern-payload-types
                ctx
                owner-id
                (csym.compiler-registry-handle-owner-index handle)
                enum-lifetimes
                fields)
                [(Ok payload-fields)
                  (tc-pattern-list-irrefutable? ctx args payload-fields)]
                [(Err _) false])]
            [(Err _) false])
          false))
      false)))

(define (tc-struct-pattern-irrefutable?
  [ctx : TcContext]
  [struct-name : String]
  [struct-name-id : i64]
  [scrut-ty : ast.AstType]
  [pattern-name : String]
  [pattern-name-id : i64]
  [args : ast.AstPatternList]) : bool
  (if (tc-struct-pattern-name-matches?
    ctx
    struct-name
    pattern-name
    pattern-name-id)
    (match (tc-struct-decl-id ctx struct-name-id)
      [(Ok decl)
        (match decl
          [(TcStructDecl _ _ fields)
            (match (tc-struct-pattern-field-types-for-scrut
              ctx
              struct-name-id
              scrut-ty
              fields)
              [(Ok field-types)
                (tc-pattern-list-irrefutable? ctx args field-types)]
              [(Err _) false])])]
      [(Err _) false])
    false))

(define (tc-array-pattern-list-irrefutable-at?
  [ctx : TcContext]
  [patterns : (& patterns ast.AstPatternList)]
  [elem-ty : ast.AstType]
  [count : i64]
  [index : i64]) : bool
  (if (>= index (ast.ast-pattern-list-len patterns))
    (>= index count)
    (if (>= index count)
      false
      (and
        (tc-sub-pattern-irrefutable?
          ctx
          (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))
          (tc-global-shared-view elem-ty))
        (tc-array-pattern-list-irrefutable-at?
          ctx
          patterns
          elem-ty
          count
          (+ index 1))))))

(define (tc-array-pattern-irrefutable?
  [ctx : TcContext]
  [patterns : ast.AstPatternList]
  [array-ty : ast.AstType]) : bool
  (match (tc-array-pattern-info ctx array-ty)
    [(Ok elem-ty count)
      (tc-array-pattern-list-irrefutable-at? ctx (& patterns) elem-ty count 0)]
    [(Err _) false]))

(define (tc-sub-pattern-irrefutable?
  [ctx : TcContext]
  [pattern : ast.AstPattern]
  [field-ty : ast.AstType]) : bool
  (match pattern
    [(Or alternatives-box)
      (tc-or-pattern-irrefutable?
        ctx
        (ast.ast-pattern-list-box-shared-view alternatives-box)
        field-ty)]
    [(Fields entries-box)
      (tc-fields-pattern-irrefutable?
        ctx
        field-ty
        (ast.ast-pattern-list-box-shared-view entries-box))]
    [(or (Wildcard) (Var _ _) (Binding _)) true]
    [(Literal _) false]
    [(Tuple patterns-box)
      (match (tc-tuple-pattern-element-types ctx field-ty)
        [(Ok elem-types)
          (tc-pattern-list-irrefutable?
            ctx
            (ast.ast-pattern-list-box-shared-view patterns-box)
            elem-types)]
        [(Err _) false])]
    [(Array patterns-box)
      (tc-array-pattern-irrefutable?
        ctx
        (ast.ast-pattern-list-box-shared-view patterns-box)
        field-ty)]
    [(Slice items-box has-rest)
      (tc-slice-pattern-irrefutable?
        ctx
        (ast.ast-pattern-list-box-shared-view items-box)
        has-rest
        field-ty)]
    [(Variant name args-box)
      (let
        [args : ast.AstPatternList
          (ast.ast-pattern-list-box-shared-view args-box)]
        (match (tc-type-strip-region
          (tc-resolve-type ctx (tc-global-shared-view field-ty)))
          [(Enum enum-name)
            (match (tc-context-enum-variants-id
              ctx
              enum-name
              (tc-nominal-name-id-display enum-name))
              [(Ok variants)
                (match (tc-enum-single-matching-variant-id
                  ctx
                  variants
                  enum-name
                  name)
                  [(Some variant-id)
                    (tc-variant-pattern-irrefutable-id?
                      ctx
                      enum-name
                      variant-id
                      (ast.ast-lifetime-list-new)
                      args)]
                  [(No) false])]
              [(Err _) false])]
          [(EnumArgs enum-name lifetimes)
            (match (tc-context-enum-variants-id
              ctx
              enum-name
              (tc-nominal-name-id-display enum-name))
              [(Ok variants)
                (match (tc-enum-single-matching-variant-id
                  ctx
                  variants
                  enum-name
                  name)
                  [(Some variant-id)
                    (tc-variant-pattern-irrefutable-id?
                      ctx
                      enum-name
                      variant-id
                      (ast.ast-lifetime-list-box-shared-view lifetimes)
                      args)]
                  [(No) false])]
              [(Err _) false])]
          [(or (Struct struct-name) (StructArgs struct-name _))
            (tc-struct-pattern-irrefutable?
              ctx
              (tc-nominal-name-id-display struct-name)
              struct-name
              field-ty
              (tc-env-key-name-text name)
              name
              args)]
          [(Box inner-ty)
            (if (tc-box-pattern-name? name)
              (tc-box-pattern-args-supported?
                ctx
                args
                (ast.ty-node-get inner-ty))
              false)]
          [_ false]))]
    [_ false]))

(define (tc-pattern-list-irrefutable?
  [ctx : TcContext]
  [patterns : ast.AstPatternList]
  [types : ast.AstTypeList]) : bool
  (tc-pattern-list-irrefutable-at? ctx (& patterns) (& types) 0))

(define (tc-pattern-list-irrefutable-at?
  [ctx : TcContext]
  [patterns : (& patterns ast.AstPatternList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-pattern-list-len patterns))
    (>= index (ast.ast-type-list-len types))
    (if (>= index (ast.ast-type-list-len types))
      false
      (let
        [pattern : ast.AstPattern
          (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))]
        [ty : ast.AstType
          (ast.ty-node-get
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
        (if (tc-sub-pattern-irrefutable? ctx pattern ty)
          (tc-pattern-list-irrefutable-at? ctx patterns types (+ index 1))
          false)))))

;; An or-pattern sub-pattern matches every value of `ty` when one alternative
;; does, or when its alternatives together cover `ty`: every variant of an
;; enum, each by a variant pattern with an irrefutable payload, both `bool`
;; literals, or every length of a borrowed Slice or fixed array. This stays apart from the arm-level coverage walk, which runs for
;; every enum `match` and must not become recursive through it.
(define (tc-or-pattern-irrefutable?
  [ctx : TcContext]
  [alternatives : ast.AstPatternList]
  [ty : ast.AstType]) : bool
  (let
    [flat : ast.AstMatchArmList
      (ast.ast-match-arm-list-with-capacity alternatives.len)]
    [index : i64 0]
    (tc-or-pattern-flatten-into! (ast.ast-pat-or alternatives) 0 (&mut flat))
    (while (< index flat.len)
      (begin
        (match (ast.ast-match-arm-list-get
          (& flat)
          index
          (ast.ast-match-arm-fallback))
          [(ast.AstMatchArm.Arm alternative _)
            (when
              (tc-sub-pattern-irrefutable?
                ctx
                alternative
                (tc-global-shared-view ty))
              (return true))])
        (set! index (+ index 1))))
    (match (tc-type-strip-region
      (tc-resolve-type ctx (tc-global-shared-view ty)))
      [(ast.AstType.Enum enum-name)
        (tc-or-alternatives-cover-enum?
          ctx
          (& flat)
          enum-name
          (ast.ast-lifetime-list-new))]
      [(ast.AstType.EnumArgs enum-name lifetimes)
        (tc-or-alternatives-cover-enum?
          ctx
          (& flat)
          enum-name
          (ast.ast-lifetime-list-box-shared-view lifetimes))]
      [(ast.AstType.Bool)
        (and
          (tc-match-arms-cover-bool? (& flat) true)
          (tc-match-arms-cover-bool? (& flat) false))]
      [_
        (match (tc-slice-pattern-scrutinee ctx (tc-global-shared-view ty))
          [(TcSlicePatternScrutinee.View _ _ elem-ty array-length)
            (match (tc-slice-match-exhaustive-ok
              ctx
              elem-ty
              array-length
              (& flat))
              [(ResultTcUnit.Ok) true]
              [(ResultTcUnit.Err _) false])]
          [(TcSlicePatternScrutinee.Invalid) false])])))

(define (tc-or-alternatives-cover-enum?
  [ctx : TcContext]
  [alternatives : (& alternatives ast.AstMatchArmList)]
  [enum-id : i64]
  [enum-lifetimes : ast.AstLifetimeList]) : bool
  (match (tc-context-enum-variants-id
    ctx
    enum-id
    (tc-nominal-name-id-display enum-id))
    [(parser.ResultAstVariantDefList.Ok variants)
      (let
        [variant-index : i64 0]
        (while (< variant-index variants.len)
          (match (ast.ast-variant-def-list-get
            (& variants)
            variant-index
            (ast.ast-variant-def-fallback))
            [(ast.AstVariantDef.Def variant-id _ _)
              (let
                [index : i64 0]
                [covered : bool false]
                (while (and (not covered) (< index alternatives.len))
                  (begin
                    (match (ast.ast-match-arm-list-get
                      alternatives
                      index
                      (ast.ast-match-arm-fallback))
                      [(ast.AstMatchArm.Arm alternative _)
                        (match alternative
                          [(ast.AstPattern.Variant name args-box)
                            (when
                              (and
                                (tc-variant-name-matches-id?
                                  ctx
                                  enum-id
                                  name
                                  variant-id)
                                (tc-variant-pattern-irrefutable-id?
                                  ctx
                                  enum-id
                                  variant-id
                                  (tc-global-shared-view enum-lifetimes)
                                  (ast.ast-pattern-list-box-shared-view
                                    args-box)))
                              (set! covered true))]
                          [_ unit])])
                    (set! index (+ index 1))))
                (unless covered (return false))
                (set! variant-index (+ variant-index 1)))]))
        true)]
    [(parser.ResultAstVariantDefList.Err _) false]))

(define (tc-pattern-covers-variant?
  [ctx : TcContext]
  [pattern : ast.AstPattern]
  [arm-names : (& arm-names TcArmVariantNames)]
  [arm-index : i64]
  [enum-id : i64]
  [variant-id : i64]
  [variant-handle : i64]
  [variant-member : i64]
  [enum-lifetimes : ast.AstLifetimeList]) : bool
  (match pattern
    [(Wildcard) true]
    [(Binding name)
      (tc-variant-name-matches-resolved?
        ctx
        enum-id
        name
        (array-ref arm-names.handles arm-index)
        (array-ref arm-names.members arm-index)
        variant-id
        variant-handle
        variant-member)]
    [(Variant name args-box)
      (let
        [args : ast.AstPatternList
          (ast.ast-pattern-list-box-shared-view args-box)]
        (and
          (tc-variant-name-matches-resolved?
            ctx
            enum-id
            name
            (array-ref arm-names.handles arm-index)
            (array-ref arm-names.members arm-index)
            variant-id
            variant-handle
            variant-member)
          (tc-variant-pattern-irrefutable-id?
            ctx
            enum-id
            variant-id
            enum-lifetimes
            args)))]
    [_ false]))

;; Each arm's variant name resolved against the scrutinee's enum, as
;; `tc-variant-name-handle` and `tc-variant-member-name-id`. Coverage compares
;; every arm with every variant, so an arm's name is resolved once per match
;; rather than once per variant.
(defstruct TcArmVariantNames
  (handles (__tl_dyn-array i64))
  (members (__tl_dyn-array i64)))

(define (tc-arm-variant-names
  [ctx : TcContext]
  [arms : (& arms ast.AstMatchArmList)]
  [enum-id : i64]) : TcArmVariantNames
  (let
    [handles : (__tl_dyn-array i64) (__tl_make-array i64 arms.len)]
    [members : (__tl_dyn-array i64) (__tl_make-array i64 arms.len)]
    [index : i64 0]
    (while (< index arms.len)
      (let
        [name-id : i64
          (match (ast.ast-match-arm-list-get
            arms
            index
            (ast.ast-match-arm-fallback))
            [(Arm pattern _)
              (match pattern
                [(Binding name) name]
                [(Variant name _) name]
                [_ -1])])]
        (set!
          (array-ref handles index)
          (tc-variant-name-handle ctx enum-id name-id))
        (set!
          (array-ref members index)
          (tc-variant-member-name-id
            (tc-context-structural-session ctx)
            name-id))
        (set! index (+ index 1))))
    (TcArmVariantNames handles members)))

(define (tc-match-arms-cover-variant-at?
  [ctx : TcContext]
  [arms : (& arms ast.AstMatchArmList)]
  [arm-names : (& arm-names TcArmVariantNames)]
  [enum-id : i64]
  [variant-id : i64]
  [variant-handle : i64]
  [variant-member : i64]
  [enum-lifetimes : ast.AstLifetimeList]
  [index : i64]) : bool
  (if (>= index arms.len)
    false
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern _)
        (if (tc-pattern-covers-variant?
          ctx
          pattern
          arm-names
          index
          enum-id
          variant-id
          variant-handle
          variant-member
          (tc-global-shared-view enum-lifetimes))
          true
          (tc-match-arms-cover-variant-at?
            ctx
            arms
            arm-names
            enum-id
            variant-id
            variant-handle
            variant-member
            enum-lifetimes
            (+ index 1)))])))

(define (tc-match-missing-variant-message [variant-name : String]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (NonExhaustiveMatch))
    "typecheck: match missing arm for variant "
    variant-name))

(define (tc-pattern-mentions-variant?
  [ctx : TcContext]
  [pattern : ast.AstPattern]
  [enum-id : i64]
  [variant-id : i64]) : bool
  (match pattern
    [(Binding name) (tc-variant-name-matches-id? ctx enum-id name variant-id)]
    [(Variant name _) (tc-variant-name-matches-id? ctx enum-id name variant-id)]
    [_ false]))

(define (tc-match-arms-mention-variant?
  [ctx : TcContext]
  [arms : ast.AstMatchArmList]
  [enum-id : i64]
  [variant-id : i64]) : bool
  (tc-match-arms-mention-variant-at? ctx (& arms) enum-id variant-id 0))

(define (tc-match-arms-mention-variant-at?
  [ctx : TcContext]
  [arms : (& arms ast.AstMatchArmList)]
  [enum-id : i64]
  [variant-id : i64]
  [index : i64]) : bool
  (if (>= index arms.len)
    false
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern _)
        (if (tc-pattern-mentions-variant? ctx pattern enum-id variant-id)
          true
          (tc-match-arms-mention-variant-at?
            ctx
            arms
            enum-id
            variant-id
            (+ index 1)))])))

(define (tc-enum-variants-exhaustive-ok
  [ctx : TcContext]
  [enum-id : i64]
  [enum-lifetimes : ast.AstLifetimeList]
  [variants : ast.AstVariantDefList]
  [arms : ast.AstMatchArmList]) : ResultTcUnit
  (let
    [arms : ast.AstMatchArmList (tc-or-pattern-flattened-arms arms)]
    [arm-names : TcArmVariantNames (tc-arm-variant-names ctx (& arms) enum-id)]
    (tc-enum-variants-exhaustive-ok-at
      ctx
      enum-id
      enum-lifetimes
      (& variants)
      arms
      (& arm-names)
      0)))

;; Coverage treats an arm-level or-pattern as the union of its alternatives,
;; which is what one arm per alternative covers. Arms without one are returned
;; as they are.
(define (tc-or-pattern-flattened-arms [arms : ast.AstMatchArmList]) : ast.AstMatchArmList
  (let
    [index : i64 0]
    [found : bool false]
    (while (and (not found) (< index arms.len))
      (begin
        (match (ast.ast-match-arm-list-get
          (& arms)
          index
          (ast.ast-match-arm-fallback))
          [(ast.AstMatchArm.Arm pattern _)
            (match pattern
              [(ast.AstPattern.Or _) (set! found true)]
              [_ unit])])
        (set! index (+ index 1))))
    (if found
      (let
        [out : ast.AstMatchArmList
          (ast.ast-match-arm-list-with-capacity arms.len)]
        (set! index 0)
        (while (< index arms.len)
          (begin
            (match (ast.ast-match-arm-list-get
              (& arms)
              index
              (ast.ast-match-arm-fallback))
              [(ast.AstMatchArm.Arm pattern body)
                (tc-or-pattern-flatten-into! pattern body (&mut out))])
            (set! index (+ index 1))))
        out)
      arms)))

(define (tc-or-pattern-flatten-into!
  [pattern : ast.AstPattern]
  [body : i64]
  [out : (&mut out ast.AstMatchArmList)]) : unit
  (match (tc-global-shared-view pattern)
    [(ast.AstPattern.Or alternatives-box)
      (let
        [alternatives : ast.AstPatternList
          (ast.ast-pattern-list-box-shared-view alternatives-box)]
        [index : i64 0]
        (while (< index alternatives.len)
          (begin
            (tc-or-pattern-flatten-into!
              (ast.ast-pattern-list-get
                (& alternatives)
                index
                (ast.ast-pattern-fallback))
              body
              out)
            (set! index (+ index 1)))))]
    [_ (ast.ast-match-arm-list-push out (ast.ast-match-arm pattern body))]))

(define (tc-enum-variants-exhaustive-ok-at
  [ctx : TcContext]
  [enum-id : i64]
  [enum-lifetimes : ast.AstLifetimeList]
  [variants : (& variants ast.AstVariantDefList)]
  [arms : ast.AstMatchArmList]
  [arm-names : (& arm-names TcArmVariantNames)]
  [index : i64]) : ResultTcUnit
  (if (>= index variants.len)
    Ok
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(Def name _ _)
        (if (tc-match-arms-cover-variant-at?
          ctx
          (& arms)
          arm-names
          enum-id
          name
          (tc-variant-name-handle ctx enum-id name)
          (tc-variant-member-name-id (tc-context-structural-session ctx) name)
          (tc-global-shared-view enum-lifetimes)
          0)
          (tc-enum-variants-exhaustive-ok-at
            ctx
            enum-id
            enum-lifetimes
            variants
            arms
            arm-names
            (+ index 1))
          (if (tc-match-arms-mention-variant? ctx arms enum-id name)
            (Err
              (tc-kind-message
                (NonExhaustiveMatch)
                "typecheck: non-exhaustive match"))
            (Err (tc-match-missing-variant-message (tc-env-key-name-text name)))))])))

(define (tc-match-arms-have-catchall? [arms : (& arms ast.AstMatchArmList)]) : bool
  (tc-match-arms-have-catchall-at? (& arms) 0))

(define (tc-match-arms-have-catchall-at?
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index arms.len)
    false
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern _)
        (match (tc-global-shared-view pattern)
          [(or (Wildcard) (Binding _) (Var _ _)) true]
          ;; A typed binding, such as `for`'s annotated item (#8581).
          [(Or _)
            (or
              (tc-pattern-plain-catchall? pattern)
              (tc-match-arms-have-catchall-at? arms (+ index 1)))]
          [_ (tc-match-arms-have-catchall-at? arms (+ index 1))])])))

;; A wildcard or binding, or an or-pattern with one as an alternative.
(define (tc-pattern-plain-catchall? [pattern : ast.AstPattern]) : bool
  (match pattern
    [(or (ast.AstPattern.Wildcard) (ast.AstPattern.Binding _)
         (ast.AstPattern.Var _ _))
      true]
    [(ast.AstPattern.Or alternatives-box)
      (let
        [alternatives : ast.AstPatternList
          (ast.ast-pattern-list-box-shared-view alternatives-box)]
        [index : i64 0]
        (while (< index alternatives.len)
          (when
            (tc-pattern-plain-catchall?
              (ast.ast-pattern-list-get
                (& alternatives)
                index
                (ast.ast-pattern-fallback)))
            (return true))
          (set! index (+ index 1)))
        false)]
    [_ false]))

;; The literal `want`, or an or-pattern with it as an alternative.
(define (tc-pattern-covers-bool? [pattern : ast.AstPattern] [want : bool]) : bool
  (match pattern
    [(ast.AstPattern.Literal (ast.AstLiteral.Bool value)) (= value want)]
    [(ast.AstPattern.Or alternatives-box)
      (let
        [alternatives : ast.AstPatternList
          (ast.ast-pattern-list-box-shared-view alternatives-box)]
        [index : i64 0]
        (while (< index alternatives.len)
          (when
            (tc-pattern-covers-bool?
              (ast.ast-pattern-list-get
                (& alternatives)
                index
                (ast.ast-pattern-fallback))
              want)
            (return true))
          (set! index (+ index 1)))
        false)]
    [_ false]))

(define (tc-match-arms-have-catchall-for-type?
  [ctx : TcContext]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]) : bool
  (tc-match-arms-have-catchall-for-type-at? ctx scrut-ty (& arms) 0))

(define (tc-match-arms-have-catchall-for-type-at?
  [ctx : TcContext]
  [scrut-ty : ast.AstType]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index arms.len)
    false
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern _)
        (if (tc-match-pattern-catchall-for-type?
          ctx
          (tc-global-shared-view scrut-ty)
          pattern)
          true
          (tc-match-arms-have-catchall-for-type-at?
            ctx
            scrut-ty
            arms
            (+ index 1)))])))

(define (tc-match-arms-cover-bool?
  [arms : (& arms ast.AstMatchArmList)]
  [want : bool]) : bool
  (tc-match-arms-cover-bool-at? (& arms) want 0))

(define (tc-match-arms-cover-bool-at?
  [arms : (& arms ast.AstMatchArmList)]
  [want : bool]
  [index : i64]) : bool
  (if (>= index arms.len)
    false
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm pattern _)
        (match (tc-global-shared-view pattern)
          [(ast.AstPattern.Literal (ast.AstLiteral.Bool value))
            (if (= value want)
              true
              (tc-match-arms-cover-bool-at? arms want (+ index 1)))]
          [(ast.AstPattern.Or _)
            (or
              (tc-pattern-covers-bool? pattern want)
              (tc-match-arms-cover-bool-at? arms want (+ index 1)))]
          [_ (tc-match-arms-cover-bool-at? arms want (+ index 1))])])))

(define (tc-match-pattern-catchall-for-shape?
  [ctx : TcContext]
  [scrut-ty : ast.AstType]
  [pattern : ast.AstPattern]) : bool
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-global-shared-view scrut-ty)))
    [(or (Enum _) (EnumArgs _ _))
      (match pattern
        [(Wildcard) true]
        [_ false])]
    [(Box inner-ty)
      (match pattern
        [(or (Wildcard) (Binding _)) true]
        [(Variant name args-box)
          (if (tc-box-pattern-name? name)
            (tc-box-pattern-args-supported?
              ctx
              (ast.ast-pattern-list-box-shared-view args-box)
              (ast.ty-node-get inner-ty))
            false)]
        [_ false])]
    [(or (Struct struct-name) (StructArgs struct-name _))
      (match pattern
        [(or (Wildcard) (Binding _)) true]
        [(Variant name args-box)
          (tc-struct-pattern-irrefutable?
            ctx
            (tc-nominal-name-id-display struct-name)
            struct-name
            scrut-ty
            (tc-env-key-name-text name)
            name
            (ast.ast-pattern-list-box-shared-view args-box))]
        [(ast.AstPattern.Fields entries-box)
          (tc-fields-pattern-irrefutable?
            ctx
            scrut-ty
            (ast.ast-pattern-list-box-shared-view entries-box))]
        [_ false])]
    [(Tuple elem-types-box)
      (match pattern
        [(or (Wildcard) (Binding _)) true]
        [(Tuple patterns-box)
          (tc-pattern-list-irrefutable?
            ctx
            (ast.ast-pattern-list-box-shared-view patterns-box)
            (ast.ast-type-list-box-shared-view elem-types-box))]
        [_ false])]
    [(Array _ _)
      (match pattern
        [(or (Wildcard) (Binding _)) true]
        [(Array patterns-box)
          (tc-array-pattern-irrefutable?
            ctx
            (ast.ast-pattern-list-box-shared-view patterns-box)
            scrut-ty)]
        [_ false])]
    [(Ref _ referent-box)
      (match (tc-type-strip-region
        (tc-resolve-type ctx (ast.ty-node-get referent-box)))
        [(Tuple elem-types-box)
          (match pattern
            [(or (Wildcard) (Binding _)) true]
            [(Tuple patterns-box)
              (tc-pattern-list-irrefutable?
                ctx
                (ast.ast-pattern-list-box-shared-view patterns-box)
                (ast.ast-type-list-box-shared-view elem-types-box))]
            [_ false])]
        [(Array _ _)
          (match pattern
            [(or (Wildcard) (Binding _)) true]
            [(Array patterns-box)
              (tc-array-pattern-irrefutable?
                ctx
                (ast.ast-pattern-list-box-shared-view patterns-box)
                (ast.ty-node-get referent-box))]
            [_ false])]
        ;; A borrowed struct pattern (#8583) is irrefutable exactly when the
        ;; same pattern is on the struct itself.
        [(or (Struct _) (StructArgs _ _))
          (tc-match-pattern-catchall-for-shape?
            ctx
            (ast.ty-node-get referent-box)
            pattern)]
        [_
          (match pattern
            [(or (Wildcard) (Binding _)) true]
            [_ false])])]
    [(Var name)
      (if (= name cbi.compiler-builtin-id-fix-ExprClause)
        (tc-expr-clause-pattern-irrefutable? ctx pattern)
        (match pattern
          [(or (Wildcard) (Binding _)) true]
          [_ false]))]
    [_
      (match pattern
        [(or (Wildcard) (Binding _)) true]
        [_ false])]))

(define (tc-match-arm-reachability-loop
  [ctx : TcContext]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]
  [seen-catchall : bool]) : ResultTcUnit
  (tc-match-arm-reachability-loop-at ctx scrut-ty (& arms) seen-catchall 0))

(define (tc-match-arm-reachability-loop-at
  [ctx : TcContext]
  [scrut-ty : ast.AstType]
  [arms : (& arms ast.AstMatchArmList)]
  [seen-catchall : bool]
  [index : i64]) : ResultTcUnit
  (if (>= index arms.len)
    Ok
    (if seen-catchall
      (Err
        (tc-kind-message
          (Pattern)
          "typecheck: unreachable match arm after wildcard `_`"))
      (match (ast.ast-match-arm-list-get
        arms
        index
        (ast.ast-match-arm-fallback))
        [(Arm pattern _)
          (tc-match-arm-reachability-loop-at
            ctx
            (tc-global-shared-view scrut-ty)
            arms
            (tc-match-pattern-catchall-for-type? ctx scrut-ty pattern)
            (+ index 1))]))))

(define (tc-match-arm-reachability-ok
  [ctx : TcContext]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]) : ResultTcUnit
  (let
    [_
      (try
        (tc-slice-match-arm-reachability-ok
          ctx
          (tc-global-shared-view scrut-ty)
          (& arms)))]
    (tc-match-arm-reachability-loop ctx scrut-ty arms false)))

;; Whether every element pattern of a slice arm is irrefutable, so the arm
;; matches every view whose length it accepts.
(define (tc-slice-pattern-elements-irrefutable?
  [ctx : TcContext]
  [items : (& items ast.AstPatternList)]
  [count : i64]
  [elem-ty : ast.AstType]) : bool
  (let
    [index : i64 0]
    [ok : bool true]
    (while (and ok (< index count))
      (set!
        ok
        (tc-sub-pattern-irrefutable?
          ctx
          (ast.ast-pattern-list-get items index (ast.ast-pattern-fallback))
          (tc-global-shared-view elem-ty)))
      (set! index (+ index 1)))
    ok))

;; A slice pattern is irrefutable when it accepts every length the scrutinee
;; can have (`(slice & rest)`, or a fixed array's exact length) and every
;; element pattern is irrefutable.
(define (tc-slice-pattern-irrefutable?
  [ctx : TcContext]
  [items : ast.AstPatternList]
  [has-rest : bool]
  [scrut-ty : ast.AstType]) : bool
  (match (tc-slice-pattern-scrutinee ctx scrut-ty)
    [(View _ _ elem-ty length)
      (let
        [count : i64 (tc-slice-pattern-element-count (& items) has-rest)]
        (and
          (if (>= length 0)
            (if has-rest
              (<= count length)
              (= count length))
            (and has-rest (= count 0)))
          (tc-slice-pattern-elements-irrefutable? ctx (& items) count elem-ty)))]
    [(Invalid) false]))

(define (tc-match-pattern-catchall-for-type?
  [ctx : TcContext]
  [scrut-ty : ast.AstType]
  [pattern : ast.AstPattern]) : bool
  (match (tc-global-shared-view pattern)
    [(Slice items-box has-rest)
      (tc-slice-pattern-irrefutable?
        ctx
        (ast.ast-pattern-list-box-shared-view items-box)
        has-rest
        scrut-ty)]
    ;; A `Var` pattern binds like `Binding`; its annotation is checked when it
    ;; is bound (#8581).
    [(Var name _)
      (tc-match-pattern-catchall-for-shape?
        ctx
        scrut-ty
        (ast.AstPattern.Binding name))]
    ;; An or-pattern arm is a catch-all when one alternative is. Coverage by
    ;; several alternatives together is checked like one arm per alternative.
    [(Or alternatives-box)
      (let
        [alternatives : ast.AstPatternList
          (ast.ast-pattern-list-box-shared-view alternatives-box)]
        [index : i64 0]
        (while (< index alternatives.len)
          (when
            (tc-match-pattern-catchall-for-type?
              ctx
              (tc-global-shared-view scrut-ty)
              (ast.ast-pattern-list-get
                (& alternatives)
                index
                (ast.ast-pattern-fallback)))
            (return true))
          (set! index (+ index 1)))
        false)]
    [_ (tc-match-pattern-catchall-for-shape? ctx scrut-ty pattern)]))

;; The most element patterns any slice arm or slice alternative of an
;; or-pattern arm has, or -1 without either.
(define (tc-slice-arms-max-count [arms : (& arms ast.AstMatchArmList)]) : i64
  (let
    [index : i64 0]
    [most : i64 -1]
    (while (< index arms.len)
      (begin
        (match (ast.ast-match-arm-list-get
          arms
          index
          (ast.ast-match-arm-fallback))
          [(ast.AstMatchArm.Arm (ast.AstPattern.Slice items-box has-rest) _)
            (let
              [items : ast.AstPatternList
                (ast.ast-pattern-list-box-shared-view items-box)]
              [count : i64 (tc-slice-pattern-element-count (& items) has-rest)]
              (when (> count most) (set! most count)))]
          [(ast.AstMatchArm.Arm (ast.AstPattern.Or alternatives-box) _)
            (set!
              most
              (tc-slice-or-alternatives-max-count
                (ast.ast-pattern-list-box-shared-view alternatives-box)
                most))]
          [_ unit])
        (set! index (+ index 1))))
    most))

;; `most`, raised to the element count of any slice alternative of an
;; or-pattern, including those of nested or-patterns.
(define (tc-slice-or-alternatives-max-count
  [alternatives : ast.AstPatternList]
  [most : i64]) : i64
  (let
    [index : i64 0]
    [result : i64 most]
    (while (< index alternatives.len)
      (begin
        (match (ast.ast-pattern-list-get
          (& alternatives)
          index
          (ast.ast-pattern-fallback))
          [(ast.AstPattern.Slice items-box has-rest)
            (let
              [items : ast.AstPatternList
                (ast.ast-pattern-list-box-shared-view items-box)]
              [count : i64 (tc-slice-pattern-element-count (& items) has-rest)]
              (when (> count result) (set! result count)))]
          [(ast.AstPattern.Or nested-box)
            (set!
              result
              (tc-slice-or-alternatives-max-count
                (ast.ast-pattern-list-box-shared-view nested-box)
                result))]
          [_ unit])
        (set! index (+ index 1))))
    result))

;; Records the lengths a slice arm covers when its element patterns are all
;; irrefutable: an exact arm marks `exact`, and the result is the smallest
;; `& rest` element count so far (-1 when there is none).
(define (tc-slice-cover-add-arm!
  [ctx : TcContext]
  [exact : (&mut exact (__tl_dyn-array bool))]
  [rest-min : i64]
  [items : (& items ast.AstPatternList)]
  [count : i64]
  [has-rest : bool]
  [elem-ty : ast.AstType]) : i64
  (cond
    [(not (tc-slice-pattern-elements-irrefutable? ctx items count elem-ty))
      rest-min]
    [has-rest
      (if (or (< rest-min 0) (< count rest-min))
        count
        rest-min)]
    [else
      (set! (array-ref exact count) true)
      rest-min]))

;; Whether earlier slice arms with irrefutable elements match every view of
;; `length`: `exact` marks `(slice p1 ... pn)` lengths and `rest-min` is the
;; smallest `& rest` arm's element count (-1 when there is none).
(define (tc-slice-length-covered?
  [exact : (& exact (__tl_dyn-array bool))]
  [rest-min : i64]
  [length : i64]) : bool
  (or
    (and (>= rest-min 0) (>= length rest-min))
    (and (< length (array-length exact)) (array-ref exact length))))

;; Whether every length from `count` up is already covered.
(define (tc-slice-lengths-from-covered?
  [exact : (& exact (__tl_dyn-array bool))]
  [rest-min : i64]
  [count : i64]) : bool
  (if (< rest-min 0)
    false
    (let
      [length : i64 count]
      [ok : bool true]
      (while (and ok (< length rest-min))
        (set! ok (tc-slice-length-covered? exact rest-min length))
        (set! length (+ length 1)))
      ok)))

(define (tc-slice-unreachable-arm-message [after-catchall : bool]) : String
  (tc-kind-message
    (Pattern)
    (if after-catchall
      "typecheck: unreachable match arm after a slice pattern that matches every length"
      "typecheck: unreachable match arm: earlier slice patterns already match every length it matches")))

;; The same for the or-pattern alternative at `index` of an arm.
(define (tc-slice-unreachable-alternative-message
  [index : i64]
  [after-catchall : bool]) : String
  (tc-kind-message
    (cdiag.CompilerTypecheckKind.Pattern)
    (str_cat.str-cat
      "typecheck: unreachable or-pattern "
      (tc-or-alternative-label index)
      (if after-catchall
        " after a slice pattern that matches every length"
        ": earlier slice patterns already match every length it matches"))))

;; Length coverage of a slice match (SPEC 5.13). An arm is unreachable when
;; earlier arms with irrefutable element patterns already match every length it
;; can match; any arm after an irrefutable slice pattern, such as
;; `(slice & rest)`, is unreachable like one after `_`. Arms after `_` are left
;; to `tc-match-arm-reachability-ok`. An or-pattern arm's slice alternatives
;; count as arms of their own, so its lengths are the union of theirs and an
;; alternative whose lengths are already covered is unreachable.
(define (tc-slice-match-arm-reachability-ok
  [ctx : TcContext]
  [scrut-ty : ast.AstType]
  [arms : (& arms ast.AstMatchArmList)]) : ResultTcUnit
  ;; A match without slice arms skips resolving its scrutinee type.
  (match (if (< (tc-slice-arms-max-count arms) 0)
    (TcSlicePatternScrutinee.Invalid)
    (tc-slice-pattern-scrutinee ctx (tc-global-shared-view scrut-ty)))
    [(View _ _ elem-ty _)
      (let
        [exact : (__tl_dyn-array bool)
          (__tl_make-array bool (+ (tc-slice-arms-max-count arms) 1))]
        [rest-min : i64 -1]
        [catchall : bool false]
        [index : i64 0]
        (while (< index arms.len)
          (match (ast.ast-match-arm-list-get
            arms
            index
            (ast.ast-match-arm-fallback))
            [(ast.AstMatchArm.Arm pattern _)
              (let
                [or-arm? : bool
                  (match (tc-global-shared-view pattern)
                    [(ast.AstPattern.Or _) true]
                    [_ false])]
                [alternatives : ast.AstMatchArmList
                  (ast.ast-match-arm-list-with-capacity
                    (if or-arm?
                      4
                      0))]
                [alt-index : i64 0]
                (when
                  catchall
                  (return
                    (ResultTcUnit.Err (tc-slice-unreachable-arm-message true))))
                (when
                  or-arm?
                  (tc-or-pattern-flatten-into!
                    (tc-global-shared-view pattern)
                    0
                    (&mut alternatives)))
                (while (<
                  alt-index
                  (if or-arm?
                    alternatives.len
                    1))
                  (begin
                    (when
                      catchall
                      (return
                        (ResultTcUnit.Err
                          (tc-slice-unreachable-alternative-message
                            alt-index
                            true))))
                    (match (if or-arm?
                      (match (ast.ast-match-arm-list-get
                        (& alternatives)
                        alt-index
                        (ast.ast-match-arm-fallback))
                        [(ast.AstMatchArm.Arm alternative _) alternative])
                      (tc-global-shared-view pattern))
                      [(ast.AstPattern.Slice items-box has-rest)
                        (let
                          [items : ast.AstPatternList
                            (ast.ast-pattern-list-box-shared-view items-box)]
                          [count : i64
                            (tc-slice-pattern-element-count (& items) has-rest)]
                          (when
                            (if has-rest
                              (tc-slice-lengths-from-covered?
                                (& exact)
                                rest-min
                                count)
                              (tc-slice-length-covered?
                                (& exact)
                                rest-min
                                count))
                            (return
                              (ResultTcUnit.Err
                                (if or-arm?
                                  (tc-slice-unreachable-alternative-message
                                    alt-index
                                    false)
                                  (tc-slice-unreachable-arm-message false)))))
                          (set!
                            catchall
                            (tc-slice-pattern-irrefutable?
                              ctx
                              (tc-global-shared-view items)
                              has-rest
                              (tc-global-shared-view scrut-ty)))
                          (set!
                            rest-min
                            (tc-slice-cover-add-arm!
                              ctx
                              (&mut exact)
                              rest-min
                              (& items)
                              count
                              has-rest
                              (tc-global-shared-view elem-ty))))]
                      [_ unit])
                    (set! alt-index (+ alt-index 1))))
                (set! index (+ index 1)))]))
        ResultTcUnit.Ok)]
    [(TcSlicePatternScrutinee.Invalid) ResultTcUnit.Ok]))

(define (tc-slice-match-missing-length-message [length : i64] [open : bool]) : String
  (tc-kind-message
    (NonExhaustiveMatch)
    (str_cat.str-cat
      "typecheck: match missing arm for slices of length "
      (string.int->string length)
      (if open
        " or more"
        ""))))

;; A slice match without a catch-all arm is exhaustive when its arms with
;; irrefutable element patterns cover every length: lengths below the smallest
;; `& rest` arm each need an exact arm. A borrowed fixed array only needs its
;; own length. Or-pattern arms arrive flattened into one arm per alternative,
;; so they cover the union of their alternatives' lengths.
(define (tc-slice-match-exhaustive-ok
  [ctx : TcContext]
  [elem-ty : ast.AstType]
  [array-length : i64]
  [arms : (& arms ast.AstMatchArmList)]) : ResultTcUnit
  (let
    [most : i64 (tc-slice-arms-max-count arms)]
    [exact : (__tl_dyn-array bool) (__tl_make-array bool (+ most 1))]
    [rest-min : i64 -1]
    [index : i64 0]
    (while (< index arms.len)
      (match (ast.ast-match-arm-list-get
        arms
        index
        (ast.ast-match-arm-fallback))
        [(Arm (Slice items-box has-rest) _)
          (let
            [items : ast.AstPatternList
              (ast.ast-pattern-list-box-shared-view items-box)]
            [count : i64 (tc-slice-pattern-element-count (& items) has-rest)]
            (set!
              rest-min
              (tc-slice-cover-add-arm!
                ctx
                (&mut exact)
                rest-min
                (& items)
                count
                has-rest
                (tc-global-shared-view elem-ty))))]
        [_ unit])
      (set! index (+ index 1)))
    (if (>= array-length 0)
      (if (tc-slice-length-covered? (& exact) rest-min array-length)
        Ok
        (Err
          (tc-kind-message
            (NonExhaustiveMatch)
            "typecheck: non-exhaustive match")))
      (let
        [length : i64 0]
        [limit : i64
          (if (< rest-min 0)
            (+ most 1)
            rest-min)]
        (while (< length limit)
          (unless
            (tc-slice-length-covered? (& exact) rest-min length)
            (return
              (Err
                (tc-slice-match-missing-length-message
                  length
                  (and (< rest-min 0) (= length most))))))
          (set! length (+ length 1)))
        (if (< rest-min 0)
          (Err (tc-slice-match-missing-length-message (+ most 1) true))
          Ok)))))

(define (tc-match-coverage-type [ctx : TcContext] [scrut-ty : ast.AstType]) : ast.AstType
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-global-shared-view scrut-ty)))
    [(Ref _ referent-box)
      (let
        [referent-ty : ast.AstType
          (tc-type-strip-region
            (tc-resolve-type ctx (ast.ty-node-get referent-box)))]
        (match (& referent-ty)
          [(or (Enum _) (EnumArgs _ _)) referent-ty]
          [_ scrut-ty]))]
    [_ scrut-ty]))

(define (tc-match-bool-exhaustive-ok [arms : ast.AstMatchArmList]) : ResultTcUnit
  (if (tc-match-arms-have-catchall? arms)
    Ok
    (if (tc-match-arms-cover-bool? arms true)
      (if (tc-match-arms-cover-bool? arms false)
        Ok
        (Err
          (tc-kind-message
            (NonExhaustiveMatch)
            "typecheck: match missing arm for false")))
      (Err
        (tc-kind-message
          (NonExhaustiveMatch)
          "typecheck: match missing arm for true")))))

(define (tc-match-exhaustiveness-ok
  [ctx : TcContext]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]) : ResultTcUnit
  (match (tc-type-strip-region (tc-global-shared-view scrut-ty))
    [(Enum enum-name)
      (let
        [enum-name-str : String (tc-nominal-name-id-display enum-name)]
        (match (tc-context-enum-variants-id ctx enum-name enum-name-str)
          [(Ok variants)
            (tc-enum-variants-exhaustive-ok
              ctx
              enum-name
              (ast.ast-lifetime-list-new)
              variants
              arms)]
          [(Err _)
            (Err
              (tc-kind-message
                (NonExhaustiveMatch)
                "typecheck: non-exhaustive match"))]))]
    [(EnumArgs enum-name lifetimes)
      (let
        [enum-name-str : String (tc-nominal-name-id-display enum-name)]
        (match (tc-context-enum-variants-id ctx enum-name enum-name-str)
          [(Ok variants)
            (tc-enum-variants-exhaustive-ok
              ctx
              enum-name
              (deref lifetimes)
              variants
              arms)]
          [(Err _)
            (Err
              (tc-kind-message
                (NonExhaustiveMatch)
                "typecheck: non-exhaustive match"))]))]
    [(Bool) (tc-match-bool-exhaustive-ok arms)]
    [_
      (if (tc-match-arms-have-catchall-for-type?
        ctx
        (tc-global-shared-view scrut-ty)
        (tc-global-shared-view arms))
        Ok
        (match (tc-slice-pattern-scrutinee ctx scrut-ty)
          [(TcSlicePatternScrutinee.View _ _ elem-ty array-length)
            (let
              [flat : ast.AstMatchArmList
                (tc-or-pattern-flattened-arms (tc-global-shared-view arms))]
              (tc-slice-match-exhaustive-ok ctx elem-ty array-length (& flat)))]
          [(TcSlicePatternScrutinee.Invalid)
            (ResultTcUnit.Err
              (tc-kind-message
                (NonExhaustiveMatch)
                "typecheck: non-exhaustive match"))]))]))

(define (tc-match-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]
  [expected : ast.AstMaybeType]) : ResultTcType
  (let
    [coverage-ty : ast.AstType
      (tc-match-coverage-type ctx (tc-global-shared-view scrut-ty))]
    [_
      (try
        (tc-match-arm-reachability-ok
          ctx
          (tc-global-shared-view coverage-ty)
          (tc-global-shared-view arms)))]
    (let
      [result-ty : ast.AstType
        (try
          (match expected
            [(Some ty)
              (tc-check-match-arm-types-with-expected ctx env scrut-ty arms ty)]
            [(No) (tc-check-match-arm-types ctx env scrut-ty arms)]))]
      [_ (try (tc-match-exhaustiveness-ok ctx coverage-ty arms))]
      (Ok result-ty))))

;; spmd-reduce operator/type rules (SPEC 5.15): the init/value/result type
;; must be in the operator's supported set -- `sum` over i32/i64/f32/f64,
;; `min`/`max` over i32/i64, `all`/`any` over bool.
(define (tc-reduce-op-type-ok? [op : ast.AstReduceOp] [ty : ast.AstType]) : bool
  (match op
    [(Sum)
      (match ty
        [(or (I32) (I64) (F32) (F64)) true]
        [_ false])]
    [(or (Min) (Max))
      (match ty
        [(or (I32) (I64)) true]
        [_ false])]
    [(or (All) (Any))
      (match ty
        [(Bool) true]
        [_ false])]))

(define (tc-reduce-op-type-msg [op : ast.AstReduceOp]) : String
  (match op
    [(Sum)
      (tc-kind-message
        (Spmd)
        "typecheck: spmd-reduce sum requires an i32, i64, f32, or f64 type")]
    [(Min)
      (tc-kind-message
        (Spmd)
        "typecheck: spmd-reduce min requires an i32 or i64 type")]
    [(Max)
      (tc-kind-message
        (Spmd)
        "typecheck: spmd-reduce max requires an i32 or i64 type")]
    [(All)
      (tc-kind-message (Spmd) "typecheck: spmd-reduce all requires a bool type")]
    [(Any)
      (tc-kind-message (Spmd) "typecheck: spmd-reduce any requires a bool type")]))

(define (tc-scan-op-type-ok? [op : ast.AstReduceOp] [ty : (& ty ast.AstType)]) : bool
  (match op
    [(or (Sum) (Min) (Max))
      (match ty
        [(or (I32) (I64)) true]
        [_ false])]
    [(or (All) (Any))
      (match ty
        [(Bool) true]
        [_ false])]))

(define (tc-scan-op-type-msg [op : ast.AstReduceOp]) : String
  (match op
    [(Sum)
      (tc-kind-message
        (Spmd)
        "typecheck: spmd-scan sum requires an i32 or i64 type; floating-point scan ordering is deferred")]
    [(Min)
      (tc-kind-message
        (Spmd)
        "typecheck: spmd-scan min requires an i32 or i64 type; floating-point scan ordering is deferred")]
    [(Max)
      (tc-kind-message
        (Spmd)
        "typecheck: spmd-scan max requires an i32 or i64 type; floating-point scan ordering is deferred")]
    [(All)
      (tc-kind-message (Spmd) "typecheck: spmd-scan all requires a bool type")]
    [(Any)
      (tc-kind-message (Spmd) "typecheck: spmd-scan any requires a bool type")]))

;; spmd-reduce purity/effect rules (SPEC.md 5.15). The first reduction slice
;; accepts a narrow, clearly-pure surface and rejects everything else with a focused
;; diagnostic rather than guessing at varying/uniform semantics not yet
;; implemented: the varying index, uniform variables, and literals;
;; arithmetic/comparison/boolean operators over those; `ann`/`cast` wrappers;
;; dynamic-array reads, including pure gather-only reads through another array;
;; and local `let` bindings whose initializers obey
;; the same rules. Writes (`set!`, `array-set!`), function calls, nested
;; `foreach`/`spmd-reduce`, varying control flow (`if`/`while`/`match`),
;; sequencing, and aggregate constructors are rejected. The `in-index` flag
;; preserves the broadcast/shuffle index restrictions while nested pure array
;; reads remain valid. Uniformity of `start`/`end`/`init` is enforced by
;; scoping: they are
;; typed outside the lane context, so referencing the index is an unbound error.
(define (tc-spmd-value-pure [expr-bases : i64] [expr : ast.AstExpr]) : ResultTcUnit
  (tc-spmd-value-pure-at expr-bases expr false))

(define (tc-spmd-value-pure-at
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [in-index : bool]) : ResultTcUnit
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(or (Literal _) (SpmdProgramIndex) (SpmdProgramCount) (Var _)) Ok]
    [(Binary _ left-box right-box)
      (let
        [left : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases left-box)]
        [right : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases right-box)]
        [_ (try (tc-spmd-value-pure-at expr-bases left in-index))]
        (tc-spmd-value-pure-at expr-bases right in-index))]
    [(or (Unary _ inner-box) (Ann inner-box _) (Cast inner-box _))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-spmd-value-pure-at expr-bases inner in-index))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [_
              (try
                (tc-spmd-value-let-bindings-pure-at
                  expr-bases
                  bindings
                  in-index))]
            (tc-spmd-value-pure-at expr-bases body in-index))])]
    [(ArrayRef array-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        [_ (try (tc-spmd-value-pure-at expr-bases array false))]
        (tc-spmd-value-pure-at expr-bases index true))]
    [(Set _ _)
      (Err
        (tc-kind-message
          (Spmd)
          "`set!` is not allowed inside a spmd-reduce value expression; reductions must use the explicit accumulator, not outer mutation (SPEC.md 5.15)"))]
    [(ArraySet _ _ _)
      (Err
        (tc-kind-message
          (Spmd)
          "array element assignment is not allowed inside a spmd-reduce value expression; the value expression must be free of writes and other side effects (SPEC.md 5.15)"))]
    [(ArrayTake _ _ _)
      (Err
        (tc-kind-message
          (Spmd)
          "`__tl_array-take!` is not allowed inside a spmd-reduce value expression; the value expression must be free of writes and other side effects (SPEC.md 5.15)"))]
    [(Replace _ _)
      (Err
        (tc-kind-message
          (Spmd)
          "`replace!` is not allowed inside a spmd-reduce value expression; the value expression must be free of writes and other side effects (SPEC.md 5.15)"))]
    [(StructSet _ _ _)
      (Err
        (tc-kind-message
          (Spmd)
          "struct field assignment is not allowed inside a spmd-reduce value expression; the value expression must be free of writes and other side effects (SPEC.md 5.15)"))]
    [(ArrayPush _ _)
      (Err
        (tc-kind-message
          (Spmd)
          "`__tl_array-push!` is not allowed inside a spmd-reduce value expression; the value expression must be free of writes and other side effects (SPEC.md 5.15)"))]
    [(Call _ _)
      (Err
        (tc-kind-message
          (Spmd)
          "function calls are not allowed inside a spmd-reduce value expression; side-effecting builtins and user calls with varying arguments are deferred in the first slice (SPEC.md 5.15)"))]
    [(Foreach _)
      (Err
        (tc-kind-message
          (Spmd)
          "a nested foreach is not allowed inside a spmd-reduce value expression (SPEC.md 5.15)"))]
    [(SpmdReduce _)
      (Err
        (tc-kind-message
          (Spmd)
          "a nested spmd-reduce is not allowed inside a spmd-reduce value expression (SPEC.md 5.15)"))]
    [(SpmdScan _)
      (Err
        (tc-kind-message
          (Spmd)
          "a nested spmd-scan is not allowed inside a spmd-reduce value expression (SPEC.md 5.15)"))]
    [(SpmdCompact _)
      (Err
        (tc-kind-message
          (Spmd)
          "a nested spmd-compact is not allowed inside a spmd-reduce value expression (SPEC.md 5.15)"))]
    [(SpmdBroadcast value-box lane-box)
      (if in-index
        (Err
          (tc-kind-message
            (Spmd)
            "spmd-broadcast is not allowed inside an array index in a spmd-reduce value expression (SPEC.md 5.15)"))
        (let
          [value : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases value-box)]
          [lane : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases lane-box)]
          [_ (try (tc-spmd-value-pure-at expr-bases value false))]
          (tc-spmd-value-pure-at expr-bases lane false)))]
    [(SpmdShuffle value-box lane-box)
      (if in-index
        (Err
          (tc-kind-message
            (Spmd)
            "spmd-shuffle is not allowed inside an array index in a spmd-reduce value expression (SPEC.md 5.15)"))
        (let
          [value : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases value-box)]
          [lane : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases lane-box)]
          [_ (try (tc-spmd-value-pure-at expr-bases value false))]
          (tc-spmd-value-pure-at expr-bases lane false)))]
    [(or (If _ _ _) (While _ _) (Match _))
      (Err
        (tc-kind-message
          (Spmd)
          "varying control flow is not allowed inside a spmd-reduce value expression; the first slice has no varying if/while/match (SPEC.md 5.15)"))]
    [_
      (Err
        (tc-kind-message
          (Spmd)
          "this expression is not allowed inside a spmd-reduce value expression; the first slice allows only the varying index, uniform variables, literals, arithmetic/comparison/boolean operators, dynamic-array reads, and local let bindings (SPEC.md 5.15)"))]))

(define (tc-spmd-value-let-bindings-pure-at
  [expr-bases : i64]
  [bindings : ast.AstLetBindingList]
  [in-index : bool]) : ResultTcUnit
  (tc-spmd-value-let-bindings-pure-at-index expr-bases (& bindings) in-index 0))

(define (tc-spmd-value-let-bindings-pure-at-index
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [in-index : bool]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast.ast-let-binding-list-len bindings))
    Ok
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding _ _ init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [_ (try (tc-spmd-value-pure-at expr-bases init in-index))]
          (tc-spmd-value-let-bindings-pure-at-index
            expr-bases
            bindings
            in-index
            (+ index 1)))])))

(define (tc-spmd-reduce-type-from-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [value-env : TcTypeEnv]
  [op : ast.AstReduceOp]
  [init : ast.AstExpr]
  [value : ast.AstExpr]) : ResultTcType
  (let
    [value-ty : ast.AstType (try (tc-expr ctx value-env value))]
    (if (tc-reduce-op-type-ok?
      op
      (tc-resolve-type ctx (tc-global-shared-view value-ty)))
      (let
        [init-ty
          (try
            (tc-expr-with-expected-or-actual
              ctx
              env
              init
              (tc-global-shared-view value-ty)))]
        [_
          (try
            (tc-expect
              init-ty
              (tc-global-shared-view value-ty)
              (tc-kind-message
                (Spmd)
                "typecheck: spmd-reduce init and value type mismatch")))]
        (Ok value-ty))
      (Err (tc-reduce-op-type-msg op)))))

(define (tc-spmd-reduce-type-from-value-or-message
  [ctx : TcContext]
  [env : TcTypeEnv]
  [value-env : TcTypeEnv]
  [op : ast.AstReduceOp]
  [init : ast.AstExpr]
  [value : ast.AstExpr]
  [fallback-message : String]) : ResultTcType
  (match (tc-spmd-reduce-type-from-value ctx env value-env op init value)
    [(Ok ty) (Ok ty)]
    [(Err _) (Err fallback-message)]))

(define (tc-spmd-reduce-init-value-type
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [value-env : TcTypeEnv]
  [op : ast.AstReduceOp]
  [init : ast.AstExpr]
  [value : ast.AstExpr]) : ResultTcType
  (let
    [init-ty (try (tc-expr ctx env (tc-global-shared-view init)))]
    (if (tc-reduce-op-type-ok?
      op
      (tc-resolve-type ctx (tc-global-shared-view init-ty)))
      (let
        [_ (try (tc-spmd-value-pure expr-bases (tc-global-shared-view value)))]
        (match (tc-expr-with-expected-or-actual
          ctx
          value-env
          (tc-global-shared-view value)
          (tc-global-shared-view init-ty))
          [(Ok value-ty)
            (match (tc-expect
              value-ty
              (tc-global-shared-view init-ty)
              (tc-kind-message
                (Spmd)
                "typecheck: spmd-reduce init and value type mismatch"))
              [(Ok) (Ok init-ty)]
              [(Err message)
                (tc-spmd-reduce-type-from-value-or-message
                  ctx
                  env
                  value-env
                  op
                  init
                  value
                  message)])]
          [(Err message)
            (tc-spmd-reduce-type-from-value-or-message
              ctx
              env
              value-env
              op
              init
              value
              message)]))
      (Err (tc-reduce-op-type-msg op)))))

(define (tc-spmd-scan-init-value-type
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [value-env : TcTypeEnv]
  [op : ast.AstReduceOp]
  [prefix-ty : ast.AstType]
  [init : ast.AstExpr]
  [value : ast.AstExpr]) : ResultTcType
  (let
    [resolved-prefix-ty : ast.AstType (tc-resolve-type ctx prefix-ty)]
    (if (tc-scan-op-type-ok? op resolved-prefix-ty)
      (let
        [init-ty
          (try
            (tc-expr-with-expected-or-actual
              ctx
              env
              init
              (tc-global-shared-view resolved-prefix-ty)))]
        [_
          (try
            (tc-expect
              (tc-resolve-type ctx init-ty)
              (tc-global-shared-view resolved-prefix-ty)
              (tc-kind-message
                (Spmd)
                "typecheck: spmd-scan prefix init type mismatch")))]
        (let
          [_
            (try (tc-spmd-value-pure expr-bases (tc-global-shared-view value)))]
          (let
            [value-ty
              (try
                (tc-expr-with-expected-or-actual
                  ctx
                  value-env
                  value
                  (tc-global-shared-view resolved-prefix-ty)))]
            [_
              (try
                (tc-expect
                  (tc-resolve-type ctx value-ty)
                  (tc-global-shared-view resolved-prefix-ty)
                  (tc-kind-message
                    (Spmd)
                    "typecheck: spmd-scan value type mismatch")))]
            (Ok resolved-prefix-ty))))
      (Err (tc-scan-op-type-msg op)))))

(define (tc-spmd-compact-expr-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [index : i64]
  [index-ty : ast.AstType]
  [start-box : i64]
  [end-box : i64]
  [slot : i64]
  [slot-ty : ast.AstType]
  [init-box : i64]
  [keep-box : i64]
  [body-box : i64]) : ResultTcType
  (let
    [resolved-index-ty : ast.AstType (tc-resolve-type ctx index-ty)]
    [resolved-slot-ty : ast.AstType (tc-resolve-type ctx slot-ty)]
    (if (= index slot)
      (Err
        (tc-kind-message
          (Spmd)
          "typecheck: spmd-compact index and slot bindings must have distinct names"))
      (let
        [_
          (try
            (tc-expect
              (tc-global-shared-view resolved-index-ty)
              (I64)
              (tc-kind-message
                (Spmd)
                "typecheck: spmd-compact index type must be i64")))]
        (let
          [_
            (try
              (tc-expect
                (tc-global-shared-view resolved-slot-ty)
                (I64)
                (tc-kind-message
                  (Spmd)
                  "typecheck: spmd-compact slot type must be i64")))]
          (let
            [start-ty : ast.AstType
              (try (tc-expr-with-expected-or-actual-id ctx env start-box (I64)))]
            [_
              (try
                (tc-expect
                  (tc-resolve-type ctx start-ty)
                  (I64)
                  (tc-kind-message
                    (Spmd)
                    "typecheck: spmd-compact start expression must have type i64")))]
            (let
              [end-ty : ast.AstType
                (try (tc-expr-with-expected-or-actual-id ctx env end-box (I64)))]
              [_
                (try
                  (tc-expect
                    (tc-resolve-type ctx end-ty)
                    (I64)
                    (tc-kind-message
                      (Spmd)
                      "typecheck: spmd-compact end expression must have type i64")))]
              (let
                [init-ty : ast.AstType
                  (try
                    (tc-expr-with-expected-or-actual-id ctx env init-box (I64)))]
                [_
                  (try
                    (tc-expect
                      (tc-resolve-type ctx init-ty)
                      (I64)
                      (tc-kind-message
                        (Spmd)
                        "typecheck: spmd-compact initial slot must have type i64")))]
                (let
                  [index-env : TcTypeEnv
                    (tc-bind-id
                      env
                      index
                      (tc-global-shared-view resolved-index-ty))]
                  [body-env : TcTypeEnv
                    (tc-bind-id
                      index-env
                      slot
                      (tc-global-shared-view resolved-slot-ty))]
                  [keep : ast.AstExpr (tc-context-expr-get ctx keep-box)]
                  [body : ast.AstExpr (tc-context-expr-get ctx body-box)]
                  [keep-ty : ast.AstType
                    (try
                      (tc-expr-with-expected-or-actual-id
                        ctx
                        index-env
                        keep-box
                        (Bool)))]
                  [_
                    (try
                      (tc-expect
                        (tc-resolve-type ctx keep-ty)
                        (Bool)
                        (tc-kind-message
                          (Spmd)
                          "typecheck: spmd-compact predicate must have type bool")))]
                  (let
                    [body-ty : ast.AstType
                      (try (tc-expr-id ctx body-env body-box))]
                    [_
                      (try
                        (tc-expect
                          body-ty
                          (Unit)
                          (tc-kind-message
                            (Spmd)
                            "typecheck: spmd-compact body must be unit")))]
                    (let
                      [_
                        (try
                          (tc-spmd-check-compact
                            ctx
                            (tc-context-expr-bases ctx)
                            env
                            index
                            resolved-index-ty
                            slot
                            resolved-slot-ty
                            keep
                            body))]
                      (Ok (I64)))))))))))))

(define (tc-ptr-addr-of-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [place : ast.AstExpr]) : ResultTcType
  (let
    [_ (try (tc-require-unsafe ctx env "ptr-addr-of"))]
    [ty : ast.AstType (try (tc-ptr-addr-of-place ctx env place))]
    [resolved : ast.AstType (tc-resolve-type ctx ty)]
    (Ok (ast.ast-ty-mut-ptr (& (tc-type-without-regions resolved))))))

(define (tc-ptr-read-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ptr : ast.AstExpr]) : ResultTcType
  (let
    [_ (try (tc-require-unsafe ctx env "ptr-read"))]
    [ptr-ty : ast.AstType (try (tc-expr ctx env ptr))]
    [elem : ast.AstType
      (try
        (tc-raw-pointer-elem
          (tc-resolve-type ctx ptr-ty)
          "typecheck: ptr-read requires a raw pointer operand"))]
    [resolved : ast.AstType (tc-resolve-type ctx elem)]
    [_
      (try
        (tc-opaque-by-value-ok
          ctx
          (tc-global-shared-view resolved)
          "cannot read through a pointer to the"))]
    (Ok resolved)))

(define (tc-ptr-write-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ptr : ast.AstExpr]
  [value : ast.AstExpr]) : ResultTcType
  (let
    [_ (try (tc-require-unsafe ctx env "ptr-write!"))]
    (let
      [ptr-ty : ast.AstType (try (tc-expr ctx env ptr))]
      [elem : ast.AstType
        (try
          (tc-mut-pointer-elem
            (tc-resolve-type ctx ptr-ty)
            "typecheck: ptr-write! requires a MutPtr pointer operand"))]
      [_
        (try
          (tc-opaque-by-value-ok
            ctx
            (tc-global-shared-view elem)
            "cannot write through a pointer to the"))]
      [value-ty
        (try
          (tc-expr-with-expected-or-actual
            ctx
            env
            value
            (tc-resolve-type ctx (tc-global-shared-view elem))))]
      [_
        (try
          (tc-expect
            value-ty
            (tc-resolve-type ctx elem)
            "typecheck: ptr-write! value type mismatch"))]
      (Ok (Unit)))))

(define (tc-ptr-offset-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ptr : ast.AstExpr]
  [offset : ast.AstExpr]) : ResultTcType
  (let
    [_ (try (tc-require-unsafe ctx env "ptr-offset"))]
    (let
      [ptr-ty : ast.AstType (try (tc-expr ctx env ptr))]
      [resolved-ptr : ast.AstType (tc-resolve-type ctx ptr-ty)]
      [elem : ast.AstType
        (try
          (tc-raw-pointer-elem
            (tc-global-shared-view resolved-ptr)
            "typecheck: ptr-offset requires a raw pointer operand"))]
      ;; An offset scales by the pointee's size, part of its representation.
      [_
        (try (tc-opaque-by-value-ok ctx elem "cannot offset a pointer to the"))]
      [offset-ty : ast.AstType
        (try (tc-expr-with-expected-or-actual ctx env offset (I64)))]
      (if (tc-integer-type? offset-ty)
        (Ok resolved-ptr)
        (Err "typecheck: ptr-offset requires an integer offset")))))

(define (tc-ptr-cast-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ptr : ast.AstExpr]
  [target : ast.AstType]) : ResultTcType
  (let
    [_ (try (tc-require-unsafe ctx env "ptr-cast"))]
    [resolved-target : ast.AstType (tc-resolve-type ctx target)]
    (if (tc-raw-pointer-type? (tc-global-shared-view resolved-target))
      (let
        [ptr-ty : ast.AstType (try (tc-expr ctx env ptr))]
        (if (tc-raw-pointer-type? (tc-resolve-type ctx ptr-ty))
          (Ok resolved-target)
          (Err "typecheck: ptr-cast requires a raw pointer operand")))
      (Err "typecheck: ptr-cast target must be a raw pointer type"))))

(define (tc-ptr-to-int-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ptr : ast.AstExpr]) : ResultTcType
  (let
    [_ (try (tc-require-unsafe ctx env "ptr->int"))]
    [ptr-ty : ast.AstType (try (tc-expr ctx env ptr))]
    (if (tc-raw-pointer-type? (tc-resolve-type ctx ptr-ty))
      (Ok (U64))
      (Err "typecheck: ptr->int requires a raw pointer operand"))))

(define (tc-int-to-ptr-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [value : ast.AstExpr]
  [target : ast.AstType]) : ResultTcType
  (let
    [_ (try (tc-require-unsafe ctx env "int->ptr"))]
    [resolved-target : ast.AstType (tc-resolve-type ctx target)]
    (if (tc-raw-pointer-type? (tc-global-shared-view resolved-target))
      (let
        [value-ty : ast.AstType (try (tc-expr ctx env value))]
        (if (tc-integer-type? value-ty)
          (Ok resolved-target)
          (Err "typecheck: int->ptr requires an integer operand")))
      (Err "typecheck: int->ptr target must be a raw pointer type"))))

(define (tc-string-data-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [str : ast.AstExpr]) : ResultTcType
  (let
    [_ (try (tc-require-unsafe ctx env "string-data"))]
    [str-ty : ast.AstType (try (tc-expr ctx env str))]
    (if (tc-length-handle-type? str-ty)
      (Ok (ast.ast-ty-ptr (& (U8))))
      (Err "typecheck: string-data requires String or bytes"))))

(define (tc-string-from-bytes-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ptr : ast.AstExpr]
  [len : ast.AstExpr]) : ResultTcType
  (let
    [_ (try (tc-require-unsafe ctx env "string-from-bytes"))]
    [ptr-ty : ast.AstType (try (tc-expr ctx env ptr))]
    (match (tc-type-strip-region (tc-resolve-type ctx ptr-ty))
      [(or (Ptr elem) (MutPtr elem))
        (if (tc-type-compatible? (ast.ty-node-get elem) (U8))
          (let
            [len-ty : ast.AstType
              (try (tc-expr-with-expected-or-actual ctx env len (I64)))]
            (if (tc-integer-type? len-ty)
              (Ok (String))
              (Err "typecheck: string-from-bytes length must be integer")))
          (Err "typecheck: string-from-bytes pointer must point at u8"))]
      [_ (Err "typecheck: string-from-bytes requires a raw u8 pointer")])))

(define (tc-array-data-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [array : ast.AstExpr]) : ResultTcType
  (let
    [_ (try (tc-require-unsafe ctx env "__tl_array-data"))]
    [array-ty : ast.AstType (try (tc-expr ctx env array))]
    (match (tc-type-strip-region (tc-resolve-type ctx array-ty))
      [(Array elem-ty _)
        (Ok (ast.ast-ty-mut-ptr (& (ast.ty-node-get elem-ty))))]
      [(DynArray elem-ty)
        (Ok (ast.ast-ty-mut-ptr (& (ast.ty-node-get elem-ty))))]
      [_ (Err "typecheck: __tl_array-data requires an array")])))

(define (tc-program-entry-ptr-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]) : ResultTcType
  (let
    [_ (try (tc-require-unsafe ctx env name))]
    (Ok (ast.ast-ty-ptr (& (ast.ast-ty-ptr (& (U8))))))))

(define (tc-cpuid-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [leaf : ast.AstExpr]
  [subleaf : ast.AstExpr]) : ResultTcType
  (let
    [leaf-ty : ast.AstType
      (try (tc-expr-with-expected-or-actual ctx env leaf (I64)))]
    (if (tc-integer-type? leaf-ty)
      (let
        [subleaf-ty : ast.AstType
          (try (tc-expr-with-expected-or-actual ctx env subleaf (I64)))]
        (if (tc-integer-type? subleaf-ty)
          (Ok (I64))
          (Err "typecheck: cpuid subleaf must be integer")))
      (Err "typecheck: cpuid leaf must be integer"))))

(define (tc-xgetbv-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [index : ast.AstExpr]) : ResultTcType
  (let
    [index-ty : ast.AstType
      (try (tc-expr-with-expected-or-actual ctx env index (I64)))]
    (if (tc-integer-type? index-ty)
      (Ok (I64))
      (Err "typecheck: xgetbv index must be integer"))))

;; Each syscall operand (number and arguments) must be an integer; the raw
;; kernel result is an i64.
(define (tc-syscall-args
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : ast.AstExprList]) : ResultTcUnit
  (tc-syscall-args-at ctx env (& args) 0))

(define (tc-syscall-args-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [index : i64]) : ResultTcUnit
  (if (>= index args.len)
    (Ok)
    (let
      [arg-ty
        (try
          (tc-expr
            ctx
            env
            (tc-context-expr-get ctx (ast.ast-expr-list-get args index 0))))]
      (if (tc-integer-type? arg-ty)
        (tc-syscall-args-at ctx env args (+ index 1))
        (Err "typecheck: syscall operands must be integer")))))

(define (tc-syscall-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : ast.AstExprList]) : ResultTcType
  (let
    [_ (try (tc-require-unsafe ctx env "syscall"))]
    (let
      [_ (try (tc-syscall-args ctx env args))]
      (Ok (I64)))))

(define (tc-box-expr [ctx : TcContext] [env : TcTypeEnv] [inner : ast.AstExpr]) : ResultTcType
  (let
    [_
      (try
        (tc-ensure-cleanup-resource-not-stored-expr
          ctx
          env
          (tc-global-shared-view inner)))]
    [inner-ty (try (tc-expr ctx env inner))]
    (Ok (tc-tag-active-region env (ast.ast-ty-box (& inner-ty))))))

(define (tc-box-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [inner : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcType
  (match (tc-type-strip-region (tc-resolve-type ctx expected))
    [(Box expected-inner)
      (let
        [expected-inner-ty : ast.AstType (ast.ty-node-get expected-inner)]
        [_
          (try
            (tc-ensure-cleanup-resource-not-stored-expr
              ctx
              env
              (tc-global-shared-view inner)))]
        [inner-ty
          (try
            (tc-expr-with-expected-or-actual
              ctx
              env
              inner
              (tc-global-shared-view expected-inner-ty)))]
        (Ok
          (tc-tag-active-region
            env
            (ast.ast-ty-box
              (& (tc-contextual-result-type expected-inner-ty inner-ty))))))]
    [_ (tc-box-expr ctx env inner)]))

(define (tc-box-get-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [box-expr : ast.AstExpr]) : ResultTcType
  (let
    [box-ty : ast.AstType (try (tc-expr ctx env box-expr))]
    (match (tc-type-strip-region
      (tc-resolve-type ctx (tc-global-shared-view box-ty)))
      [(Box inner-ty)
        (tc-opaque-by-value-result
          ctx
          (tc-project-from-region-container box-ty (ast.ty-node-get inner-ty))
          "cannot read out of a box the")]
      [_
        (Err
          (tc-kind-message
            (TypeMismatch)
            "typecheck: deref requires Box or reference type"))])))

(define (tc-box-get-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [box-expr : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcType
  (let
    [box-ty
      (try
        (tc-expr-with-expected-or-actual
          ctx
          env
          box-expr
          (ast.ast-ty-box (& expected))))]
    (match (tc-type-strip-region
      (tc-resolve-type ctx (tc-global-shared-view box-ty)))
      [(Box inner-ty)
        (let
          [projected : ast.AstType
            (tc-project-from-region-container box-ty (ast.ty-node-get inner-ty))]
          (tc-opaque-by-value-result
            ctx
            (if (tc-type-compatible?
              (tc-global-shared-view expected)
              (tc-global-shared-view projected))
              (tc-contextual-result-type expected projected)
              projected)
            "cannot read out of a box the"))]
      [_
        (Err
          (tc-kind-message
            (TypeMismatch)
            "typecheck: deref requires Box or reference type"))])))

(define (tc-deref-result-type [ctx : TcContext] [receiver-ty : ast.AstType]) : ResultTcType
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-global-shared-view receiver-ty)))
    [(Box inner-ty)
      (Ok
        (tc-project-from-region-container
          receiver-ty
          (ast.ty-node-get inner-ty)))]
    [(or (Ref lifetime referent-ty) (MutRef lifetime referent-ty))
      (Ok (tc-tag-region lifetime (ast.ty-node-get referent-ty)))]
    [(or (Ptr _) (MutPtr _)) (Err (tc-raw-deref-whole-message))]
    [_
      (Err
        (tc-kind-message
          (TypeMismatch)
          "typecheck: deref requires Box or reference type"))]))

;; `(deref p)` with a raw pointer `p` is an unsafe place only as the receiver
;; of a struct-field projection. `(deref p).field` reads that one field at its
;; offset from `p`, and through a `MutPtr` `(set! (deref p).field v)` stores
;; it; further field, tuple and array projections may follow. Like
;; `ptr-write!`, a store neither drops nor ownership-checks the value it
;; overwrites. The whole pointee keeps its by-value `ptr-read` and `ptr-write!`
;; forms, so a raw-pointer `deref` anywhere else is rejected.
(define (tc-raw-deref-whole-message) : String
  (tc-kind-message
    (TypeMismatch)
    "typecheck: deref of a raw pointer must be projected to a struct field, as in (deref p).field; read or write the whole pointee with ptr-read or ptr-write!"))

(define (tc-raw-deref-read-only-message) : String
  (tc-kind-message
    (BorrowViolation)
    "typecheck: cannot assign through a (Ptr T), whose pointee is read-only; use a (MutPtr T)"))

;; The pointer type when `receiver` is `(deref p)` over a raw pointer `p`.
(define (tc-raw-deref-pointer-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [receiver : ast.AstExpr]) : ast.AstMaybeType
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-bases ctx)
    (& receiver))
    [(BoxTake pointer-box)
      (match (tc-expr-id ctx env pointer-box)
        [(Ok pointer-ty)
          (let
            [resolved : ast.AstType
              (tc-type-strip-region (tc-resolve-type ctx pointer-ty))]
            (match (tc-global-shared-view resolved)
              [(or (Ptr _) (MutPtr _)) (Some resolved)]
              [_ No]))]
        [(Err _) No])]
    [_ No]))

;; The raw pointer a place is reached through: its root is a raw-pointer
;; `deref`, possibly under field, tuple and array projections.
(define (tc-raw-deref-place-pointer-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [place : ast.AstExpr]) : ast.AstMaybeType
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-bases ctx)
    (& place))
    [(BoxTake _) (tc-raw-deref-pointer-type ctx env place)]
    [(or (StructGet receiver-box _) (TupleRef receiver-box _)
         (ArrayRef receiver-box _))
      (tc-raw-deref-place-pointer-type
        ctx
        env
        (tc-context-expr-get ctx receiver-box))]
    [_ No]))

(define (tc-raw-deref-place?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [place : ast.AstExpr]) : bool
  (match (tc-raw-deref-place-pointer-type ctx env place)
    [(Some _) true]
    [(No) false]))

;; The type a struct-field projection reads its field from. An ordinary
;; receiver is typed as an expression; only when that fails is the receiver
;; tried as a raw-pointer `deref`, so ordinary projections pay nothing. The
;; StructGet case of `tc-expr-inner` inlines the same fallback.
(define (tc-field-receiver-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [receiver : ast.AstExpr]) : ResultTcType
  (match (tc-expr ctx env (tc-global-shared-view receiver))
    [(Ok receiver-ty) (Ok receiver-ty)]
    [(Err message) (tc-raw-deref-field-receiver-type ctx env receiver message)]))

(define (tc-raw-deref-field-receiver-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [receiver : ast.AstExpr]
  [message : String]) : ResultTcType
  (match (tc-raw-deref-pointer-type ctx env receiver)
    [(Some pointer-ty)
      (let
        [_ (try (tc-require-unsafe ctx env "deref of a raw pointer"))]
        [elem (try (tc-raw-pointer-elem pointer-ty message))]
        (Ok (tc-resolve-type ctx elem)))]
    [(No) (Err message)]))

(define (tc-deref-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [receiver : ast.AstExpr]) : ResultTcType
  (let
    [receiver-ty : ast.AstType (try (tc-expr ctx env receiver))]
    (tc-opaque-by-value-result
      ctx
      (try (tc-deref-result-type ctx receiver-ty))
      "cannot dereference by value the")))

(define (tc-deref-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [receiver : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcType
  (match (tc-expr ctx env (tc-global-shared-view receiver))
    [(Ok receiver-ty)
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-global-shared-view receiver-ty)))
        [(Box _)
          (tc-box-get-expr-with-expected-or-actual ctx env receiver expected)]
        [_
          (let
            [projected : ast.AstType
              (try (tc-deref-result-type ctx receiver-ty))]
            (tc-opaque-by-value-result
              ctx
              (if (tc-type-compatible?
                (tc-global-shared-view expected)
                (tc-global-shared-view projected))
                (tc-contextual-result-type expected projected)
                projected)
              "cannot dereference by value the"))])]
    [(Err _)
      ;; Preserve contextual inference for `(deref (box (init)))`.
      (tc-box-get-expr-with-expected-or-actual ctx env receiver expected)]))

(define (tc-box-set-inner-type [ctx : TcContext] [box-ty : ast.AstType]) : ResultTcType
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-global-shared-view box-ty)))
    [(Box inner-ty)
      (Ok (tc-project-from-region-container box-ty (ast.ty-node-get inner-ty)))]
    [(MutRef _ referent-ty) (Ok (ast.ty-node-get referent-ty))]
    [(Ref _ _)
      (Err
        (tc-kind-message
          (BorrowViolation)
          "typecheck: set! deref requires mutable access"))]
    [(or (Ptr _) (MutPtr _)) (Err (tc-raw-deref-whole-message))]
    [_ (Err "typecheck: set! deref requires Box or mutable reference")]))

(define (tc-box-mutation-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [box-expr : ast.AstExpr]
  [value : ast.AstExpr]) : ResultTcType
  (let
    [_ (try (tc-store-place-lifetime ctx env (tc-global-shared-view box-expr)))]
    (let
      [box-ty (try (tc-expr ctx env (tc-global-shared-view box-expr)))]
      [target-context : String
        (match (tc-type-strip-region
          (tc-resolve-type ctx (tc-global-shared-view box-ty)))
          [(MutRef _ _) "&mut referent"]
          [_ "box"])]
      [inner-ty : ast.AstType (try (tc-box-set-inner-type ctx box-ty))]
      [value-ty
        (try
          (tc-expr-with-expected-or-actual
            ctx
            env
            (tc-global-shared-view value)
            (tc-global-shared-view inner-ty)))]
      [_
        (try
          (tc-expect
            (tc-global-shared-view value-ty)
            (tc-global-shared-view inner-ty)
            "typecheck: box assignment type mismatch"))]
      (let
        [_ (try (tc-ensure-cleanup-resource-not-stored-expr ctx env value))]
        (let
          [_
            (try
              (tc-ensure-region-value-can-flow-into
                env
                inner-ty
                (tc-global-shared-view value-ty)
                "box"))]
          (let
            [_
              (try
                (tc-ensure-reference-value-can-store-in-place
                  ctx
                  env
                  (tc-context-expr-get
                    ctx
                    (ast.ast-expr-box-get (ast.ast-node-push box-expr)))
                  value-ty
                  target-context))]
            (Ok (Unit))))))))

(define (tc-init-unsupported-message [ctx : TcContext] [ty : ast.AstType]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (TypeMismatch))
    "typecheck: init unsupported type "
    (tc-type-render (tc-type-without-regions (tc-resolve-type ctx ty)))))

(define (tc-init-cleanup-owning-message [ctx : TcContext] [ty : ast.AstType]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (ResourceOwnership))
    "typecheck: init does not support cleanup-owning aggregate "
    (tc-type-render (tc-type-without-regions (tc-resolve-type ctx ty)))))

(define (tc-init-aggregate-layout-ok [ctx : TcContext] [ty : ast.AstType]) : ResultTcUnit
  (let
    [_ (try (tc-inline-aggregate-type-layout ctx ty))]
    Ok))

(define (tc-init-type-list-supported
  [ctx : TcContext]
  [env : TcTypeEnv]
  [types : ast.AstTypeList]) : ResultTcUnit
  (tc-init-type-list-supported-at ctx env (& types) 0))

(define (tc-init-type-list-supported-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast.ast-type-list-len types))
    Ok
    (let
      [_
        (try
          (tc-init-type-supported
            ctx
            env
            (ast.ty-node-get
              (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))))]
      (tc-init-type-list-supported-at ctx env types (+ index 1)))))

(define (tc-init-struct-field-types-for-result
  [ctx : TcContext]
  [struct-name-id : i64]
  [struct-ty : ast.AstType]
  [fields : ast.AstFieldDefList]) : ast.AstTypeList
  (let
    [field-types : ast.AstTypeList
      (tc-resolve-type-list ctx (tc-field-type-list ctx fields))]
    (match struct-ty
      [(or (StructArgs _ lifetimes) (VarArgs _ lifetimes))
        (match (tc-lifetime-subst-from-nominal-args-id
          ctx
          struct-name-id
          (ast.ast-lifetime-list-box-shared-view lifetimes))
          [(Ok subst) (tc-lifetime-subst-type-list subst field-types)]
          [(Err _) field-types])]
      [_ field-types])))

(define (tc-init-enum-fields-for-result
  [ctx : TcContext]
  [enum-name-id : i64]
  [enum-ty : ast.AstType]
  [fields : ast.AstTypeList]) : ast.AstTypeList
  (let
    [field-types : ast.AstTypeList (tc-resolve-type-list ctx fields)]
    (match enum-ty
      [(or (EnumArgs _ lifetimes) (VarArgs _ lifetimes))
        (match (tc-lifetime-subst-from-nominal-args-id
          ctx
          enum-name-id
          (ast.ast-lifetime-list-box-shared-view lifetimes))
          [(Ok subst) (tc-lifetime-subst-type-list subst field-types)]
          [(Err _) field-types])]
      [_ field-types])))

(define (tc-context-with-nominal-owner-module-id
  [ctx : TcContext]
  [nominal-id : i64]) : TcContext
  (let
    [handle : i64
      (if (>= nominal-id 0)
        (csym.compiler-symbols-lookup-type-id-or
          (tc-context-symbols ctx)
          nominal-id
          (csym.compiler-symbols-missing-handle))
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (tc-context-with-nominal-owner-handle-module ctx handle)
      (if (and
        (>= nominal-id 0)
        (< nominal-id (ci.intern-capacity))
        (ci.intern-qualified? nominal-id))
        (let
          [module-id : i64 (ci.intern-qualified-module-id nominal-id)]
          (tc-context-with-module-id
            ctx
            (tc-env-key-name-text module-id)
            module-id))
        ctx))))

(define (tc-context-with-nominal-owner-handle-module
  [ctx : TcContext]
  [handle : i64]) : TcContext
  (let
    [module-id : i64
      (csym.compiler-symbols-owner-module-id-at-index-or
        (tc-context-symbols ctx)
        (csym.compiler-symbol-handle-index handle)
        cbi.compiler-builtin-id-fix-empty)]
    (if (>= module-id 0)
      (tc-context-with-module-id ctx (tc-env-key-name-text module-id) module-id)
      (tc-context-with-module-id ctx "" cbi.compiler-builtin-id-fix-empty))))

(define (tc-init-nominal-field-context-id
  [ctx : TcContext]
  [nominal-name-id : i64]) : TcContext
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-type-id-or
        (tc-context-symbols ctx)
        nominal-name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (tc-context-with-nominal-owner-handle-module ctx handle)
      (tc-context-with-nominal-owner-module-id ctx nominal-name-id))))

(define (tc-init-struct-supported
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name-id : i64]
  [struct-ty : ast.AstType]) : ResultTcUnit
  (let
    [decl (try (tc-struct-decl-id ctx struct-name-id))]
    (match decl
      [(TcStructDecl repr cleanup fields)
        (let
          [field-ctx : TcContext
            (tc-init-nominal-field-context-id ctx struct-name-id)]
          (if (ast.ast-struct-repr-c? repr)
            (Err "typecheck: init supports only default-layout structs")
            (if (ast.ast-struct-cleanup? cleanup)
              (Err (tc-init-cleanup-owning-message ctx struct-ty))
              (let
                [_
                  (try
                    (tc-init-aggregate-layout-ok
                      field-ctx
                      (tc-global-shared-view struct-ty)))]
                (tc-init-type-list-supported
                  field-ctx
                  env
                  (tc-init-struct-field-types-for-result
                    field-ctx
                    struct-name-id
                    struct-ty
                    fields))))))])))

(define (tc-init-enum-supported
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name-id : i64]
  [enum-ty : ast.AstType]) : ResultTcUnit
  (let
    [field-ctx : TcContext (tc-init-nominal-field-context-id ctx enum-name-id)]
    [decl (try (tc-enum-decl-id ctx enum-name-id))]
    (match decl
      [(TcEnumDecl cleanup variants)
        (if (ast.ast-enum-cleanup? cleanup)
          (Err (tc-init-cleanup-owning-message ctx enum-ty))
          (let
            [_
              (try
                (tc-init-aggregate-layout-ok
                  field-ctx
                  (tc-global-shared-view enum-ty)))]
            (if (ast.ast-variant-def-list-empty? (& variants))
              (Err "typecheck: init requires enum with at least one variant")
              (match (ast.ast-variant-def-list-get
                (& variants)
                0
                (ast.ast-variant-def-fallback))
                [(Def _ fields _)
                  (tc-init-type-list-supported
                    field-ctx
                    env
                    (tc-init-enum-fields-for-result
                      field-ctx
                      enum-name-id
                      enum-ty
                      fields))]))))])))

(define (tc-init-type-supported
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : ast.AstType]) : ResultTcUnit
  (let
    [resolved : ast.AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (if (tc-integer-type? (tc-global-shared-view resolved))
      Ok
      (match (tc-global-shared-view resolved)
        [(or (F64) (F32) (Bool) (Char) (Unit) (String) (Ptr _) (MutPtr _)) Ok]
        [(CFunc _ mode)
          (if (ast.ast-c-function-mode-nullable? mode)
            Ok
            (Err "typecheck: init cannot create a non-null C function pointer"))]
        [(DynArray elem)
          (let
            [elem-ty : ast.AstType
              (tc-type-without-regions
                (tc-resolve-type ctx (ast.ty-node-get elem)))]
            (if (tc-dyn-array-elem-supported? env elem-ty)
              Ok
              (Err
                (tc-kind-message
                  (TypeMismatch)
                  "typecheck: init dynamic array element type is not supported"))))]
        [(Box elem) (tc-init-type-supported ctx env (ast.ty-node-get elem))]
        [(Tuple elems)
          (let
            [_ (try (tc-init-aggregate-layout-ok ctx resolved))]
            (tc-init-type-list-supported
              ctx
              env
              (ast.ast-type-list-box-shared-view elems)))]
        [(Array elem count)
          (if (< count 0)
            (Err "typecheck: init fixed array length must be non-negative")
            (let
              [_ (try (tc-init-aggregate-layout-ok ctx resolved))]
              (tc-init-type-supported ctx env (ast.ty-node-get elem))))]
        [(or (Struct name) (StructArgs name _))
          (tc-init-struct-supported ctx env name resolved)]
        [(or (Enum name) (EnumArgs name _))
          (tc-init-enum-supported ctx env name resolved)]
        [_ (Err (tc-init-unsupported-message ctx resolved))]))))

(define (tc-init-expr [ctx : TcContext] [env : TcTypeEnv] [ty : ast.AstType]) : ResultTcType
  (let
    [resolved : ast.AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    [_
      (try
        (tc-opaque-representation-ok
          ctx
          (tc-global-shared-view resolved)
          "cannot initialize the"))]
    [_ (try (tc-init-type-supported ctx env (tc-global-shared-view resolved)))]
    (Ok (tc-tag-active-region env resolved))))

(define (tc-make-array-zero-literal-length?
  [expr-bases : i64]
  [len : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& len))
    [(Literal (Int value _)) (= value 0)]
    [_ false]))

(define (tc-make-array-requires-element-init?
  [expr-bases : i64]
  [elem : ast.AstType]
  [len : ast.AstExpr]) : bool
  (not
    (and
      (tc-make-array-zero-literal-length? expr-bases len)
      (not (tc-type-contains-reference? elem)))))

(define (tc-fixed-make-array-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [elem : ast.AstType]
  [len : ast.AstExpr]) : ResultTcType
  (let
    [ctfe-env : ctfe_support.CtfeEnv
      (tc-ctfe-env-for-comptime ctx (tc-global-shared-view len))]
    (match (ctfe_support.compiler-ctfe-eval
      len
      ctfe-env
      (ctfe_support.ctfe-fuel-limit))
      [(Ok value _)
        (match value
          [(I64 count)
            (if (< count 0)
              (Err
                (tc-kind-message
                  (ComptimeConstraint)
                  "typecheck: make-array length must be a non-negative compile-time integer"))
              (tc-init-expr ctx env (ast.ast-ty-array (& elem) count)))]
          [_
            (Err
              (tc-kind-message
                (ComptimeConstraint)
                "typecheck: make-array length must be a non-negative compile-time integer"))])]
      [(Err _)
        (Err
          (tc-kind-message
            (ComptimeConstraint)
            "typecheck: make-array length must be a non-negative compile-time integer"))])))

;; An unquote recursively enters ordinary typechecking, which may install a
;; different node-pool context during macro expansion. Re-project every child
;; read through `ctx`; unlike the non-installing analysis walks above, this
;; traversal must not hoist one segment-bases token across the recursion.
(define (tc-quasiquote-template-list-ok
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]) : ResultTcUnit
  (tc-quasiquote-template-list-ok-at ctx env (& exprs) 0))

(define (tc-quasiquote-template-list-ok-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : ResultTcUnit
  (if (>= index exprs.len)
    Ok
    (let
      [_
        (try
          (tc-quasiquote-template-ok
            ctx
            env
            (tc-context-expr-get ctx (ast.ast-expr-list-get exprs index 0))))]
      (tc-quasiquote-template-list-ok-at ctx env exprs (+ index 1)))))

(define (tc-quasiquote-template-ok
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match expr
    [(or (Spanned inner-box _) (MacroExpansion inner-box _ _)
         (Unary _ inner-box) (Ann inner-box _) (Cast inner-box _)
         (Box inner-box) (BoxGet inner-box) (BoxTake inner-box)
         (Comptime inner-box) (Return inner-box) (Try inner-box)
         (Quasiquote inner-box))
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        (tc-quasiquote-template-ok ctx env inner))]
    [(Unquote inner-box)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        [ty (try (tc-expr ctx env inner))]
        (tc-expect ty (Expr) "typecheck: unquote expects Expr"))]
    [(UnquoteSplicing inner-box)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        [ty (try (tc-expr ctx env inner))]
        (tc-expect ty (ExprList) "typecheck: unquote-splicing expects ExprList"))]
    [(Binary _ left-box right-box)
      (let
        [left : ast.AstExpr (tc-context-expr-get ctx left-box)]
        [right : ast.AstExpr (tc-context-expr-get ctx right-box)]
        [_ (try (tc-quasiquote-template-ok ctx env left))]
        (tc-quasiquote-template-ok ctx env right))]
    [(Call func-box args)
      (let
        [func : ast.AstExpr (tc-context-expr-get ctx func-box)]
        [_ (try (tc-quasiquote-template-ok ctx env func))]
        (tc-quasiquote-template-list-ok ctx env args))]
    [(or (BracketClause items) (Tuple items) (Array items) (DynArray items)
         (Begin items) (Unsafe items))
      (tc-quasiquote-template-list-ok ctx env items)]
    [(If cond-box then-branch-box else-branch-box)
      (let
        [cond : ast.AstExpr (tc-context-expr-get ctx cond-box)]
        [then-branch : ast.AstExpr (tc-context-expr-get ctx then-branch-box)]
        [else-branch : ast.AstExpr (tc-context-expr-get ctx else-branch-box)]
        [_ (try (tc-quasiquote-template-ok ctx env cond))]
        (let
          [_ (try (tc-quasiquote-template-ok ctx env then-branch))]
          (tc-quasiquote-template-ok ctx env else-branch)))]
    [(BoxSet inner-box value-box)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        [value : ast.AstExpr (tc-context-expr-get ctx value-box)]
        [_ (try (tc-quasiquote-template-ok ctx env inner))]
        (tc-quasiquote-template-ok ctx env value))]
    [(Quote _) Ok]
    [_ Ok]))

(define (tc-clone-out-unsupported-message
  [ctx : TcContext]
  [form : String]
  [ty : ast.AstType]) : String
  (str_cat.str-cat
    (tc-kind-message (TypeMismatch) "typecheck: ")
    form
    " result type is not clone-supported: "
    (tc-type-render (tc-type-without-regions (tc-resolve-type ctx ty)))))

(define (tc-with-escape-unsupported-message
  [ctx : TcContext]
  [ty : ast.AstType]) : String
  (tc-clone-out-unsupported-message ctx "with-escape" ty))

(define (tc-with-scratch-unsupported-message
  [ctx : TcContext]
  [ty : ast.AstType]) : String
  (tc-clone-out-unsupported-message ctx "with-scratch" ty))

(define (tc-with-region-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [region : i64]
  [body : ast.AstExprList]
  [expected : ast.AstMaybeType]) : ResultTcType
  (let
    [region-env : TcTypeEnv (tc-push-region env region)]
    [body-ty : ast.AstType
      (try (tc-begin-list-maybe-expected ctx region-env body expected))]
    (if (tc-type-contains-region (tc-global-shared-view body-ty) region)
      (Err
        (str_cat.str-cat
          (cdiag.compiler-diagnostic-typecheck-tag (RegionEscape))
          "typecheck: region-tagged value cannot escape with-arena '"
          (tc-lifetime-name-render region)
          "'"))
      (Ok body-ty))))

;; with-escape is a first-class scratch-arena clone path, not a lexical
;; lifetime binder. The scratch expression is just an arena handle, and
;; supported results leave the form with scratch-region tags erased.
(define (tc-with-escape-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scratch : ast.AstExpr]
  [body : ast.AstExprList]
  [expected : ast.AstMaybeType]) : ResultTcType
  (let
    [scratch-ty : ast.AstType (try (tc-expr ctx env scratch))]
    (if (tc-arena-type? ctx scratch-ty)
      (let
        [body-ty : ast.AstType
          (try (tc-begin-list-maybe-expected ctx env body expected))]
        (if (tc-clone-able-type? ctx (tc-global-shared-view body-ty))
          (let
            [clone-ty : ast.AstType (tc-type-without-regions body-ty)]
            (tc-clone-root-collection-note!
              ctx
              (tc-global-shared-view clone-ty))
            (Ok clone-ty))
          (Err (tc-with-escape-unsupported-message ctx body-ty))))
      (Err
        (tc-kind-message
          (ArenaOwnership)
          "typecheck: with-escape arena must be Arena")))))

(define (tc-with-scratch-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [body : ast.AstExprList]
  [expected : ast.AstMaybeType]) : ResultTcType
  (let
    [body-ty : ast.AstType
      (try (tc-begin-list-maybe-expected ctx env body expected))]
    (if (tc-clone-able-type? ctx (tc-global-shared-view body-ty))
      (let
        [clone-ty : ast.AstType (tc-type-without-regions body-ty)]
        (tc-clone-root-collection-note! ctx (tc-global-shared-view clone-ty))
        (Ok clone-ty))
      (Err (tc-with-scratch-unsupported-message ctx body-ty)))))

(define (tc-in-arena-owner
  [expr-bases : i64]
  [env : TcTypeEnv]
  [arena : ast.AstExpr]) : TcMaybeNameId
  (let
    [nid : i64 (tc-expr-var-name-id expr-bases arena)]
    (if (>= nid 0)
      (if (or
        (tc-ordinary-arena-owner-active-id? env nid)
        (tc-atomic-arena-owner-active-id? env nid))
        (Some nid)
        (No))
      (No))))

(define (tc-arena-branded-region [ctx : TcContext] [arena-ty : ast.AstType]) : TcMaybeNameId
  (match (tc-type-strip-region (tc-resolve-type ctx arena-ty))
    [(StructArgs arena-name lifetimes)
      (let
        [args : ast.AstLifetimeList
          (ast.ast-lifetime-list-box-shared-view lifetimes)]
        (if (and
          (tc-arena-nominal-name-id? arena-name)
          (= (tc-lifetime-list-count args) 1))
          (Some
            (ast.ast-lifetime-list-get (& args) 0 (ast.ast-lifetime-fallback)))
          (No)))]
    [_ (No)]))

(define (tc-in-arena-region
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arena : ast.AstExpr]
  [arena-ty : ast.AstType]) : TcMaybeNameId
  (match (tc-arena-branded-region ctx arena-ty)
    [(Some region) (Some region)]
    [(No)
      (match (tc-in-arena-owner (tc-context-expr-segment-bases ctx) env arena)
        [(Some owner) (Some (tc-current-arena-owner-region env owner))]
        [(No) (No)])]))

(define (tc-in-arena-body-env
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arena : ast.AstExpr]
  [arena-ty : ast.AstType]) : TcTypeEnv
  (match (tc-in-arena-region ctx env arena arena-ty)
    [(Some region) (tc-push-region env region)]
    [(No) env]))

(define (tc-in-arena-body-result
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arena : ast.AstExpr]
  [arena-ty : ast.AstType]
  [body-ty : ast.AstType]) : ast.AstType
  (match (tc-type-outer-region (tc-global-shared-view body-ty))
    [(Some _) body-ty]
    [(No)
      (tc-tag-active-region
        (tc-in-arena-body-env ctx env arena arena-ty)
        body-ty)]))

(define (tc-in-arena-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arena : ast.AstExpr]
  [body : ast.AstExprList]
  [expected : ast.AstMaybeType]) : ResultTcType
  (let
    [arena-ty (try (tc-expr ctx env (tc-global-shared-view arena)))]
    (if (tc-arena-type? ctx (tc-global-shared-view arena-ty))
      (let
        [body-ty
          (try
            (tc-begin-list-maybe-expected
              ctx
              (tc-in-arena-body-env
                ctx
                env
                (tc-global-shared-view arena)
                (tc-global-shared-view arena-ty))
              body
              expected))]
        (Ok (tc-in-arena-body-result ctx env arena arena-ty body-ty)))
      (Err
        (tc-kind-message
          (ArenaOwnership)
          "typecheck: in-arena arena must be Arena")))))

(define (tc-with-resource-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : ast.AstResourceBindingList]
  [body : ast.AstExprList]
  [expected : ast.AstMaybeType]) : ResultTcType
  (let
    [body-env : TcTypeEnv (try (tc-resource-bindings ctx env bindings))]
    [body-ty : ast.AstType
      (try (tc-begin-list-maybe-expected ctx body-env body expected))]
    (if (tc-expr-list-result-uses-cleanup-owner?
      (tc-context-expr-bases ctx)
      body
      (tc-resource-binding-list-add-bound-names bindings Nil)
      Nil)
      (Err
        (tc-kind-message
          (ResourceOwnership)
          "typecheck: cleanup-required resource would escape with scope"))
      (Ok body-ty))))

(define (tc-unsafe-begin-list-scoped
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]
  [expected : ast.AstMaybeType]
  [span : TcMaybeAstSourceSpan]) : ResultTcType
  (let
    [saved : TcTypeEnvScopedRuntimeSave
      (tc-type-env-scoped-runtime-enter-env! env)]
    [result : ResultTcType (tc-unsafe-begin-list ctx env exprs expected span)]
    (tc-type-env-scoped-runtime-restore! saved)
    result))

(define (tc-with-region-expr-scoped
  [ctx : TcContext]
  [env : TcTypeEnv]
  [region : i64]
  [body : ast.AstExprList]
  [expected : ast.AstMaybeType]) : ResultTcType
  (let
    [saved : TcTypeEnvScopedRuntimeSave
      (tc-type-env-scoped-runtime-enter-env! env)]
    [result : ResultTcType (tc-with-region-expr ctx env region body expected)]
    (tc-type-env-scoped-runtime-restore! saved)
    result))

(define (tc-in-arena-expr-scoped
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arena : ast.AstExpr]
  [body : ast.AstExprList]
  [expected : ast.AstMaybeType]) : ResultTcType
  (let
    [saved : TcTypeEnvScopedRuntimeSave
      (tc-type-env-scoped-runtime-enter-env! env)]
    [result : ResultTcType (tc-in-arena-expr ctx env arena body expected)]
    (tc-type-env-scoped-runtime-restore! saved)
    result))

(define (tc-lambda-expr-normalized-with-capture-check-inner
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : ast.AstParamList]
  [maybe-ret : ast.AstMaybeType]
  [body : ast.AstExpr]
  [allow-immutable-reference-captures : bool]) : ResultTcType
  (let
    [_
      (try
        (if allow-immutable-reference-captures
          (tc-check-lambda-region-captures-allow-refs
            (tc-context-expr-bases ctx)
            env
            (tc-global-shared-view params)
            (tc-global-shared-view body))
          (tc-check-lambda-region-captures
            (tc-context-expr-bases ctx)
            env
            (tc-global-shared-view params)
            (tc-global-shared-view body))))]
    [lambda-env : TcTypeEnv
      (match (tc-global-shared-view maybe-ret)
        [(Some ret)
          (tc-bind-return-type
            (tc-bind-params
              ctx
              (tc-clear-unsafe-context (tc-clear-loop-target env))
              params)
            (tc-resolve-type ctx ret))]
        [(No)
          (tc-bind-return-type
            (tc-bind-params
              ctx
              (tc-clear-unsafe-context (tc-clear-loop-target env))
              params)
            (Never))])]
    [body-ty
      (try
        (match (tc-global-shared-view maybe-ret)
          [(Some ret)
            (tc-expr-with-expected-or-actual
              ctx
              lambda-env
              body
              (tc-resolve-type ctx ret))]
          [(No) (tc-expr ctx lambda-env body)]))]
    (if (and
      (tc-type-contains-any-region (tc-global-shared-view body-ty))
      (not
        (tc-type-regions-all-atomic-arena-owners?
          lambda-env
          (tc-global-shared-view body-ty)))
      ;; A reference result whose signature has already tied it to a
      ;; lambda parameter is not an arena escape. It remains governed
      ;; by the ordinary expected-type and return-lifetime checks.
      (not
        (match (tc-global-shared-view maybe-ret)
          [(Some ret) (tc-type-contains-reference? ret)]
          [(No) false])))
      (Err
        (tc-kind-message
          (RegionEscape)
          "typecheck: lambda return value has region-tagged type; region value would escape"))
      (match maybe-ret
        [(Some ret)
          (let
            [_
              (try
                (tc-expect
                  body-ty
                  (tc-resolve-type ctx (tc-global-shared-view ret))
                  "typecheck: lambda return type mismatch"))]
            (Ok
              (ast.ast-ty-func
                (tc-param-type-list ctx params)
                (& (tc-resolve-type ctx ret)))))]
        [(No)
          (Ok (ast.ast-ty-func (tc-param-type-list ctx params) (& body-ty)))]))))

(define (tc-lambda-expr-normalized-with-capture-check
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : ast.AstParamList]
  [maybe-ret : ast.AstMaybeType]
  [body : ast.AstExpr]
  [allow-immutable-reference-captures : bool]) : ResultTcType
  (let
    [observer : TcSemanticObserver (tc-context-semantic-observer ctx)]
    [_semantic-enter : unit
      (when
        (!= observer.address 0)
        (tc-semantic-observer-send!
          observer
          ctx
          env
          (FunctionEnter
            -1
            (match (tc-global-shared-view body)
              [(Spanned inner _) inner]
              [_ -1])
            (tc-global-shared-view params)
            (tc-global-shared-view maybe-ret))))]
    [result : ResultTcType
      (if (tc-type-env-scoped-runtime-active? env)
        (let
          [saved : TcTypeEnvScopedRuntimeSave
            (tc-type-env-scoped-runtime-save env)]
          [result : ResultTcType
            (tc-lambda-expr-normalized-with-capture-check-inner
              ctx
              env
              params
              maybe-ret
              body
              allow-immutable-reference-captures)]
          (tc-type-env-scoped-runtime-restore! saved)
          result)
        (tc-lambda-expr-normalized-with-capture-check-inner
          ctx
          env
          params
          maybe-ret
          body
          allow-immutable-reference-captures))]
    (when
      (!= observer.address 0)
      (tc-semantic-observer-send!
        observer
        ctx
        env
        (FunctionLeave (tc-global-shared-view result))))
    result))

(define (tc-lambda-expr-with-capture-check
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : ast.AstParamList]
  [maybe-ret : ast.AstMaybeType]
  [body : ast.AstExpr]
  [allow-immutable-reference-captures : bool]) : ResultTcType
  (match maybe-ret
    [(Some ret)
      (let
        [signature : TcElidedSignature
          (try
            (tc-elide-function-signature (tc-context-type-bases ctx) params ret))]
        (tc-lambda-expr-normalized-with-capture-check
          ctx
          env
          signature.params
          (Some signature.ret)
          body
          allow-immutable-reference-captures))]
    [(No)
      (let
        [inputs : TcElidedParams
          (try
            (tc-elide-input-params-at
              (tc-context-type-bases ctx)
              (& params)
              0
              0
              (ast.ast-param-list-new)))]
        (tc-lambda-expr-normalized-with-capture-check
          ctx
          env
          inputs.params
          (No)
          body
          allow-immutable-reference-captures))]))

(define (tc-lambda-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : ast.AstParamList]
  [maybe-ret : ast.AstMaybeType]
  [body-id : i64]
  [body : ast.AstExpr]) : ResultTcType
  (let
    [body-state : TcBodyState (tc-context-body-state ctx)]
    [fn-ty
      (try
        (tc-lambda-expr-with-capture-check
          ctx
          env
          (tc-global-shared-view params)
          maybe-ret
          (tc-global-shared-view body)
          false))]
    (if (and
      (unsafe
        (deref (tc-body-state-view body-state)).type-facts-recording)
      (tc-lambda-capture-has-move-only?
        ctx
        (tc-context-expr-bases ctx)
        env
        (tc-global-shared-view params)
        body)
      (=
        (tc-lambda-call-capability ctx env params body-id)
        (tc-closure-call-capability-once)))
      (Err (tc-capability-closure-escape-message))
      (Ok fn-ty))))

(define (tc-lambda-expr-allow-ref-captures
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : ast.AstParamList]
  [maybe-ret : ast.AstMaybeType]
  [body : ast.AstExpr]) : ResultTcType
  (tc-lambda-expr-with-capture-check ctx env params maybe-ret body true))

(define (tc-array-readable-receiver
  [ctx : TcContext]
  [receiver-ty : ast.AstType]) : ResultTcArrayReceiver
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-global-shared-view receiver-ty)))
    [(or (Array elem-ty _) (DynArray elem-ty))
      (Ok (TcArrayReceiver receiver-ty (ast.ty-node-get elem-ty)))]
    [(or (Ref _ referent-ty) (MutRef _ referent-ty))
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-context-type-get ctx referent-ty)))
        [(Slice elem-ty)
          (Ok (TcArrayReceiver receiver-ty (ast.ty-node-get elem-ty)))]
        [_ (tc-array-readable-receiver ctx (ast.ty-node-get referent-ty))])]
    [_ (Err "typecheck: array-ref requires array type")]))

(define (tc-array-set-receiver [ctx : TcContext] [receiver-ty : ast.AstType]) : ResultTcArrayReceiver
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-global-shared-view receiver-ty)))
    [(or (Array elem-ty _) (DynArray elem-ty))
      (Ok (TcArrayReceiver receiver-ty (ast.ty-node-get elem-ty)))]
    [(or (Slice _) (Ref _ _))
      (Err
        (tc-kind-message
          (BorrowViolation)
          "typecheck: set! array element requires mutable array access"))]
    [(MutRef _ referent-ty)
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-context-type-get ctx referent-ty)))
        [(Slice elem-ty)
          (Ok (TcArrayReceiver receiver-ty (ast.ty-node-get elem-ty)))]
        [_ (tc-array-set-receiver ctx (ast.ty-node-get referent-ty))])]
    [_ (Err "typecheck: set! array element requires array type")]))

;; Replacing writes the selected place directly, so a projected place must not
;; bypass the cleanup contract of the resource that owns its root.
;; Keep this place-specific: the general result-flow cleanup check intentionally
;; preserves the compatibility behavior of ordinary projected reads.
(define (tc-active-cleanup-owner-place?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [place : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-segment-bases ctx)
    (& place))
    [(Var name)
      (if (tc-dotted-place-name-id? ctx env name)
        (match (tc-dotted-local-field-expr-id-after-check
          (tc-context-structural-session ctx)
          name)
          [(Ok virtual-id)
            (tc-active-cleanup-owner-place?
              ctx
              env
              (ast.ast-expr-segment-bases-get
                (tc-context-expr-bases ctx)
                virtual-id))]
          [(Err _) false])
        (tc-cleanup-owner-active-id? env name))]
    [_
      ;; A projection root may itself be a dotted field such as `holder.items`;
      ;; resolve it like a direct place so the owning root's state applies.
      (match (tc-move-root-projection-var-id (tc-context-expr-bases ctx) place)
        [(Some root-id) (tc-active-cleanup-owner-place? ctx env (Var root-id))]
        [(No) false])]))

(define (tc-replace-place-value-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [place : ast.AstExpr]) : ResultTcType
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-segment-bases ctx)
    (& place))
    [(Var name)
      (if (tc-dotted-place-name-id? ctx env name)
        (let
          [virtual-id
            (try
              (tc-dotted-local-field-expr-id-after-check
                (tc-context-structural-session ctx)
                name))]
          (tc-replace-place-value-type
            ctx
            env
            (ast.ast-expr-segment-bases-get
              (tc-context-expr-bases ctx)
              virtual-id)))
        (let
          [ty : ast.AstType (try (tc-lookup-visible-id ctx env name))]
          (match (tc-type-strip-region
            (tc-resolve-type ctx (tc-global-shared-view ty)))
            [(MutRef _ referent-id) (Ok (tc-context-type-get ctx referent-id))]
            [(Ref _ _)
              (Err
                (tc-kind-message
                  (BorrowViolation)
                  "typecheck: replace! requires mutable place access"))]
            [_ (Ok (tc-resolve-type ctx ty))])))]
    [(StructGet receiver-box field)
      (let
        [receiver-ty : ast.AstType
          (try
            (tc-replace-place-value-type
              ctx
              env
              (ast.ast-expr-segment-bases-get
                (tc-context-expr-bases ctx)
                receiver-box)))]
        (tc-struct-set-field-type-id ctx receiver-ty field))]
    [(TupleRef receiver-box index)
      (let
        [receiver-ty : ast.AstType
          (try
            (tc-replace-place-value-type
              ctx
              env
              (ast.ast-expr-segment-bases-get
                (tc-context-expr-bases ctx)
                receiver-box)))]
        (tc-tuple-set-element-type ctx receiver-ty index))]
    [(ArrayRef array-box index-box)
      (let
        [index-ty : ast.AstType
          (try (tc-expr-with-expected-or-actual-id ctx env index-box (I64)))]
        (if (tc-integer-type? index-ty)
          (let
            [array-ty : ast.AstType (try (tc-expr-id ctx env array-box))]
            [receiver : TcArrayReceiver
              (try (tc-array-set-receiver ctx array-ty))]
            (match receiver
              [(TcArrayReceiver _ elem-ty) (Ok elem-ty)]))
          (Err "typecheck: replace! array index must be integer")))]
    [(or (BoxGet receiver-box) (BoxTake receiver-box))
      (let
        [receiver-ty : ast.AstType (try (tc-expr-id ctx env receiver-box))]
        (tc-box-set-inner-type ctx receiver-ty))]
    [_ (Err "typecheck: replace! target must be a mutable place")]))

(define (tc-replace-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [place : ast.AstExpr]
  [replacement-id : i64]) : ResultTcType
  (match (tc-raw-deref-place-pointer-type ctx env (tc-global-shared-view place))
    [(Some _)
      (Err
        (tc-kind-message
          (Place)
          "typecheck: replace! target cannot be reached through a raw pointer; use ptr-read and ptr-write!"))]
    [(No) (tc-replace-storage-place-type ctx env place replacement-id)]))

(define (tc-replace-storage-place-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [place : ast.AstExpr]
  [replacement-id : i64]) : ResultTcType
  (match (tc-store-place-lifetime ctx env (tc-global-shared-view place))
    [(Ok _)
      (if (tc-active-cleanup-owner-place? ctx env (tc-global-shared-view place))
        (Err
          (tc-kind-message
            (ResourceOwnership)
            "typecheck: replace! cannot replace an active cleanup owner"))
        (let
          [place-ty
            (try
              (tc-replace-place-value-type
                ctx
                env
                (tc-global-shared-view place)))]
          (if (tc-cleanup-owning-aggregate-type?
            ctx
            (tc-global-shared-view place-ty))
            (Err
              (tc-kind-message
                (ResourceOwnership)
                "typecheck: replace! does not support cleanup-owning places"))
            (let
              [replacement : ast.AstExpr
                (tc-context-expr-get ctx replacement-id)]
              [replacement-ty
                (try
                  (tc-expr-with-expected-or-actual-id
                    ctx
                    env
                    replacement-id
                    (tc-global-shared-view place-ty)))]
              [_
                (try
                  (tc-expect-in-context
                    ctx
                    env
                    (tc-global-shared-view replacement-ty)
                    (tc-global-shared-view place-ty)
                    "typecheck: replace! replacement type mismatch"))]
              (let
                [_
                  (try
                    (tc-ensure-cleanup-resource-not-stored-expr
                      ctx
                      env
                      replacement))]
                (let
                  [_
                    (try
                      (tc-ensure-region-value-can-flow-into
                        env
                        (tc-global-shared-view place-ty)
                        (tc-global-shared-view replacement-ty)
                        "replace! destination"))]
                  (let
                    [_
                      (try
                        (tc-ensure-reference-value-can-store-in-place
                          ctx
                          env
                          place
                          replacement-ty
                          "replace! destination"))]
                    (Ok place-ty))))))))]
    [(Err _)
      (Err
        (tc-kind-message
          (Place)
          "typecheck: replace! target must be a storage place"))]))

(define (tc-array-push-receiver [ctx : TcContext] [receiver-ty : ast.AstType]) : ResultTcArrayReceiver
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-global-shared-view receiver-ty)))
    [(DynArray elem-ty)
      (Ok (TcArrayReceiver receiver-ty (ast.ty-node-get elem-ty)))]
    [(Array _ _)
      (Err "typecheck: __tl_array-push! requires dynamic array type")]
    [(MutRef _ referent-ty)
      (tc-array-push-receiver ctx (ast.ty-node-get referent-ty))]
    [(Ref _ _)
      (Err
        (tc-kind-message
          (BorrowViolation)
          "typecheck: __tl_array-push! requires mutable dynamic array access"))]
    [_ (Err "typecheck: __tl_array-push! requires dynamic array type")]))

(define (tc-array-mutation-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [array : ast.AstExpr]
  [array-ty : ast.AstType]
  [elem-ty : ast.AstType]
  [value : ast.AstExpr]
  [mismatch-message : String]) : ResultTcType
  (let
    [value-ty
      (try
        (tc-expr-with-expected-or-actual
          ctx
          env
          (tc-global-shared-view value)
          (tc-global-shared-view elem-ty)))]
    [_
      (try
        (tc-expect (tc-global-shared-view value-ty) elem-ty mismatch-message))]
    (let
      [_ (try (tc-ensure-cleanup-resource-not-stored-expr ctx env value))]
      (let
        [_
          (try
            (tc-ensure-region-value-can-flow-into
              env
              array-ty
              (tc-global-shared-view value-ty)
              "array"))]
        (let
          [_
            (try
              (tc-ensure-reference-value-can-store-in-place
                ctx
                env
                array
                value-ty
                "array"))]
          (Ok (Unit)))))))

(define (tc-tuple-set-element-type
  [ctx : TcContext]
  [receiver-ty : ast.AstType]
  [index : i64]) : ResultTcType
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-global-shared-view receiver-ty)))
    [(Tuple elems)
      (let
        [elem-ty
          (try
            (tc-type-list-ref (ast.ast-type-list-box-shared-view elems) index))]
        (Ok (tc-project-from-region-container receiver-ty elem-ty)))]
    [(MutRef _ referent-ty)
      (let
        [referent : ast.AstType (tc-context-type-get ctx referent-ty)]
        (match (tc-type-strip-region
          (tc-resolve-type ctx (tc-global-shared-view referent)))
          [(Tuple _) (tc-tuple-set-element-type ctx referent index)]
          [_
            (Err
              "typecheck: set! tuple element mutable reference requires tuple")]))]
    [(Ref _ _)
      (Err
        (tc-kind-message
          (BorrowViolation)
          "typecheck: set! tuple element requires mutable tuple access"))]
    [_ (Err "typecheck: set! tuple element requires tuple")]))

(define (tc-struct-set-field-type-id
  [ctx : TcContext]
  [receiver-ty : ast.AstType]
  [field-id : i64]) : ResultTcType
  (if (ast.ast-tuple-set-field-id? field-id)
    (tc-tuple-set-element-type
      ctx
      receiver-ty
      (ast.ast-tuple-set-index-from-field-id field-id))
    (match (tc-type-strip-region
      (tc-resolve-type ctx (tc-global-shared-view receiver-ty)))
      [(or (Struct _) (StructArgs _ _) (MutRef _ _))
        (tc-struct-get-result-type-id ctx receiver-ty field-id)]
      [(Ref _ _)
        (Err
          (tc-kind-message
            (BorrowViolation)
            "typecheck: set! struct field requires mutable struct access"))]
      [_ (Err "typecheck: set! struct field requires struct")])))

(define (tc-struct-field-mutation-value-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [receiver : ast.AstExpr]
  [field-id : i64]
  [value : ast.AstExpr]) : ResultTcType
  (let
    [_ (try (tc-store-place-lifetime ctx env (tc-global-shared-view receiver)))]
    (let
      [receiver-ty
        (try
          (if (ast.ast-tuple-set-field-id? field-id)
            (tc-expr ctx env (tc-global-shared-view receiver))
            (tc-field-receiver-type ctx env (tc-global-shared-view receiver))))]
      [field-ty : ast.AstType
        (try
          (tc-struct-set-field-type-id
            ctx
            (tc-global-shared-view receiver-ty)
            field-id))]
      [value-ty
        (try
          (tc-expr-with-expected-or-actual
            ctx
            env
            (tc-global-shared-view value)
            (tc-global-shared-view field-ty)))]
      [_
        (try
          (tc-expect
            (tc-global-shared-view value-ty)
            (tc-global-shared-view field-ty)
            (if (ast.ast-tuple-set-field-id? field-id)
              (tc-kind-message
                (TypeMismatch)
                "typecheck: tuple element assignment type mismatch")
              (tc-kind-message
                (TypeMismatch)
                "typecheck: struct field assignment type mismatch"))))]
      (let
        [_ (try (tc-ensure-cleanup-resource-not-stored-expr ctx env value))]
        (let
          [_
            (try
              (tc-ensure-region-value-can-flow-into
                env
                field-ty
                (tc-global-shared-view value-ty)
                (if (ast.ast-tuple-set-field-id? field-id)
                  "tuple element"
                  "struct field")))]
          (let
            [context : String
              (if (ast.ast-tuple-set-field-id? field-id)
                "tuple element"
                "struct field")]
            [_
              (try
                (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
                  ;; `b.f` with `b : (&mut m T)` stores through the reference.
                  [(MutRef lifetime referent)
                    (tc-ensure-reference-lifetimes-can-store-at
                      env
                      (tc-type-collect-reference-lifetimes value-ty)
                      (tc-store-place-reference-target ctx lifetime referent)
                      context)]
                  [_
                    (tc-ensure-reference-value-can-store-in-place
                      ctx
                      env
                      receiver
                      value-ty
                      context)]))]
            (Ok (Unit))))))))

;; A name whose type holds an opaque aggregate by value, or a function whose
;; parameters or result do, is unusable outside its module family (#6999).
;; This covers the aggregate's constructors and nullary variants. RESULT is the
;; name's type.
(define (tc-opaque-value-reference-ok
  [ctx : TcContext]
  [name : i64]
  [result : ResultTcType]) : ResultTcType
  (match result
    [(Ok ty)
      (let
        [opaque : i64 (tc-opaque-by-value-name ctx (tc-global-shared-view ty))]
        (if (< opaque 0)
          (Ok ty)
          (Err
            (tc-opaque-representation-message
              opaque
              (if (tc-constructor-name-id? ctx name)
                "cannot construct the"
                (str_cat.str-cat
                  "cannot use "
                  (tc-nominal-name-id-display name)
                  ", which holds by value the"))))))]
    [(Err message) (Err message)]))

(define (tc-var-expr-after-local-field-check-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [name-text : String]
  [direct-call-target : bool]) : ResultTcType
  (if (tc-hygiene-global-name-id? (tc-context-structural-session ctx) name)
    (let
      [global-id : i64
        (macro-hygiene-global-source-name-id-or
          (tc-context-structural-session ctx)
          name
          -1)]
      (if (< global-id 0)
        (Err
          (str_cat.str-cat
            "typecheck: macro hygiene source id unavailable: "
            name-text))
        (if (macro-hygiene-global-id? (tc-context-structural-session ctx) name)
          (let
            [module-id : i64
              (macro-hygiene-global-module-id
                (tc-context-structural-session ctx)
                name)]
            (if (macro-hygiene-global-legacy-id?
              (tc-context-structural-session ctx)
              name)
              (if (tc-hygiene-global-binding-unsafe-id? env global-id)
                (let
                  [ty
                    (try
                      (tc-lookup-hygiene-global-visible-id ctx env global-id))]
                  (tc-unsafe-callable-use
                    ctx
                    env
                    (ci.intern-str global-id)
                    ty
                    direct-call-target))
                (tc-lookup-hygiene-global-visible-id ctx env global-id))
              (tc-lookup-hygiene-context-global-visible-id-mode
                ctx
                env
                (macro-decl-module-display module-id)
                module-id
                global-id
                direct-call-target)))
          (match (tc-hygiene-global-decode name-text)
            [(Legacy global-name)
              (if (tc-hygiene-global-binding-unsafe-id? env global-id)
                (let
                  [ty
                    (try
                      (tc-lookup-hygiene-global-visible-id ctx env global-id))]
                  (tc-unsafe-callable-use
                    ctx
                    env
                    global-name
                    ty
                    direct-call-target))
                (tc-lookup-hygiene-global-visible-id ctx env global-id))]
            [(Context module _)
              (tc-lookup-hygiene-context-global-visible-id-mode
                ctx
                env
                module
                (let
                  [module-id : i64 (ci.intern-qualified-module-id name)]
                  (if (< module-id 0)
                    cbi.compiler-builtin-id-fix-empty
                    module-id))
                global-id
                direct-call-target)]))))
    (match (tc-source-name-lookup-key-with-field-check-lookup
      ctx
      env
      (tc-global-shared-view name-text)
      name
      false)
      [(Ok lookup-name lookup-id)
        (match (tc-lookup-unsafe-key-id
          env
          (tc-env-name-key-id (tc-type-env-structural-session env) lookup-id))
          [(Ok ty unsafe)
            (let
              [_
                (try
                  (if (tc-bare-variant-name-gate? ctx name)
                    (tc-bare-variant-unexpected-check
                      ctx
                      env
                      name
                      (tc-global-shared-view ty))
                    ResultTcUnit.Ok))]
              (tc-semantic-observe-reference! ctx env lookup-id false)
              (if unsafe
                (let
                  [unsafe-ty
                    (try
                      (tc-unsafe-callable-use
                        ctx
                        env
                        (tc-source-lookup-display-name
                          ctx
                          name-text
                          name
                          lookup-name)
                        ty
                        direct-call-target))]
                  (match (tc-unqualified-import-ambiguity-message ctx env name)
                    [(No) (Ok unsafe-ty)]
                    [(Some message) (Err message)]))
                (match (tc-unqualified-import-ambiguity-message ctx env name)
                  [(No) (Ok ty)]
                  [(Some message) (Err message)])))]
          [(Err message)
            (match (tc-dotted-alias-variant-handle ctx name-text name)
              [(Some handle)
                (tc-variant-constructor-type-for-handle ctx handle)]
              [(None)
                (if (tc-bare-variant-name-id? name)
                  (tc-bare-variant-constructor-type-or
                    ctx
                    name
                    (tc-source-unbound-display-message
                      ctx
                      name-text
                      name
                      lookup-name
                      message))
                  (tc-variant-constructor-type-for-lookup-or-id
                    ctx
                    lookup-id
                    (tc-source-unbound-display-message
                      ctx
                      name-text
                      name
                      lookup-name
                      message)))])])]
      [(Err message)
        (tc-source-lookup-error-or-variant-constructor ctx name message)])))

(define (tc-var-expr-after-local-field-check
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [name-text : String]) : ResultTcType
  (if (tc-job-state-opaque-program? (tc-context-job-state ctx))
    (tc-opaque-value-reference-ok
      ctx
      name
      (tc-var-expr-after-local-field-check-mode ctx env name name-text false))
    (tc-var-expr-after-local-field-check-mode ctx env name name-text false)))

(define (tc-source-lookup-error-or-variant-constructor
  [ctx : TcContext]
  [name-id : i64]
  [message : String]) : ResultTcType
  (match (tc-enum-qualified-variant-constructor-handle ctx name-id)
    [(Some handle) (tc-variant-constructor-type-for-handle ctx handle)]
    [(None) (Err message)]))

;; #7976: a qualified `set!` target (`alias.global`, `module.path.global`, or a
;; projection of one such as `alias.global.field`) never binds in the value
;; environment. When its longest qualified prefix names another module's
;; global, report the ownership rule the unqualified forms get instead of an
;; unbound name.
(define (tc-set-foreign-qualified-global-message
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]) : TcMaybeString
  (if (and (>= name 0) (< name (ci.intern-capacity)))
    (let
      [candidate : i64 name]
      [result : TcMaybeString (No)]
      [searching : bool true]
      (while (and
        searching
        (>= candidate 0)
        (>= (ci.intern-first-dot candidate) 0))
        (let
          [handle : i64 (tc-move-value-symbol-handle-id ctx env candidate)]
          (if (and
            (csym.compiler-symbols-handle-found? handle)
            (=
              (csym.compiler-symbol-handle-kind handle)
              (csym.compiler-symbol-kind-value-define)))
            (begin
              (if (tc-module-ids-same?
                (tc-move-global-owner-module-id ctx handle)
                (tc-context-module-id ctx))
                unit
                (set!
                  result
                  (Some
                    (tc-move-foreign-global-write-message
                      ctx
                      candidate
                      handle
                      (if (= candidate name)
                        "assign to"
                        "assign to part of")))))
              (set! searching false))
            (set! candidate (ci.intern-dotted-prefix-id candidate)))))
      result)
    (No)))

(define (tc-set-function-declaration?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]) : bool
  ;; Lexical storage shadows declarations, while a hygienic definition-site
  ;; name keeps its declaration identity even when the caller shadows it.
  (if (and
    (not (macro-hygiene-global-id? (tc-context-structural-session ctx) name))
    (or
      (and
        (tc-type-env-scoped-runtime-active? env)
        (>= (tc-type-env-scoped-runtime-lookup-index env name) 0))
      (tc-name-local-bound-before-module-scan-id? env name)))
    false
    (match (tc-unqualified-import-ambiguity-message ctx env name)
      [(Some _) false]
      [(No)
        (match (tc-source-name-lookup-key-with-field-check-lookup
          ctx
          env
          (tc-hygiene-name-text-id-for-session
            (tc-context-structural-session ctx)
            name)
          name
          false)
          [(Err _) false]
          [(Ok _ _)
            (let
              [handle : i64 (tc-move-value-symbol-handle-id ctx env name)]
              [kind : i64 (csym.compiler-symbol-handle-kind handle)]
              (cond
                [(not (csym.compiler-symbols-handle-found? handle)) false]
                [(= kind (csym.compiler-symbol-kind-function-define)) true]
                [(= kind (csym.compiler-symbol-kind-extern))
                  (match (csym.compiler-symbols-decl-at-index
                    (tc-context-symbols ctx)
                    (csym.compiler-symbol-handle-index handle))
                    [(Ok decl)
                      (match (ast.ast-decl-unwrapped (& decl))
                        [(Extern _ _ (Function) _ _) true]
                        [_ false])]
                    [(Err _) false])]
                [else false]))])])))

(define (tc-set-function-declaration-message [ctx : TcContext] [name : i64]) : String
  (tc-kind-message
    (Place)
    (str_cat.str-cat
      "typecheck: cannot assign to function `"
      (tc-hygiene-name-text-id-for-session
        (tc-context-structural-session ctx)
        name)
      "`; assign to a function-valued variable instead")))

(define (tc-set-expr-after-local-field-check
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [value-box : i64]) : ResultTcType
  (let
    [value : ast.AstExpr (tc-context-expr-get ctx value-box)]
    (match (tc-lookup-visible-id ctx env name)
      [(Ok var-ty)
        (if (and
          (match (tc-global-shared-view var-ty)
            [(Func _ _) true]
            [_ false])
          (tc-set-function-declaration? ctx env name))
          (Err (tc-set-function-declaration-message ctx name))
          (let
            [value-ty
              (try
                (tc-expr-with-expected-or-actual-id
                  ctx
                  env
                  value-box
                  (tc-global-shared-view var-ty)))]
            [_
              (try
                (tc-expect-in-context
                  ctx
                  env
                  (tc-global-shared-view value-ty)
                  (tc-global-shared-view var-ty)
                  "typecheck: assignment type mismatch"))]
            (let
              [_ (try (tc-ensure-cleanup-resource-not-assigned ctx env value))]
              (let
                [_
                  (try
                    (tc-ensure-region-value-can-flow-into
                      env
                      var-ty
                      (tc-global-shared-view value-ty)
                      "assignment"))]
                (let
                  [_
                    (try
                      (tc-ensure-reference-value-can-assign env name value-ty))]
                  (Ok (Unit)))))))]
      [(Err message)
        (if (tc-set-function-declaration? ctx env name)
          (Err (tc-set-function-declaration-message ctx name))
          (match (tc-set-foreign-qualified-global-message ctx env name)
            [(Some foreign) (Err foreign)]
            [(No) (Err message)]))])))

(define (tc-for-owned-name-id-result
  [ctx : TcContext]
  [expr-id : i64]
  [role : String]) : ResultTcExprId
  (let
    [pools : ast.AstNodePoolContext (tc-context-pools ctx)]
    [name-id : i64
      (match (ast.ast-expr-unspan-with-pools
        pools
        (& (tc-context-expr-get ctx expr-id)))
        [(Var name) name]
        [_ -1])]
    (if (>= name-id 0)
      (Ok name-id)
      (Err
        (str_cat.str-cat
          "typecheck: internal scalar for planner expected a variable for "
          role
          ", got "
          (ctfe_support.ctfe-describe-expr
            (ast.ast-expr-unspan-with-pools
              pools
              (& (tc-context-expr-get ctx expr-id)))))))))

(define (tc-for-owned-expected-type [ctx : TcContext] [expected-id : i64]) : ResultTcType
  (let
    [expected : ast.AstExpr (tc-context-expr-get ctx expected-id)]
    (match (ctfe_support.ctfe-expr-to-type
      (tc-global-shared-view expected)
      expected
      (tc-ctfe-env ctx)
      (ctfe_support.ctfe-fuel-limit))
      [(Ok ty _) (Ok (tc-resolve-type ctx ty))]
      [(Err diag)
        (let
          [diagnostic : cdiag.CompilerDiagnostic
            (cdiag.compiler-diagnostic-box-shared-view diag)]
          (Err (cdiag.compiler-diagnostic-typecheck-error-text (& diagnostic))))])))

(define (tc-for-owned-body-unit
  [ctx : TcContext]
  [env : TcTypeEnv]
  [body-id : i64]) : ResultTcType
  (let
    [body-ty : ast.AstType (try (tc-expr-id ctx env body-id))]
    [_
      (try
        (tc-expect
          body-ty
          (Unit)
          "typecheck: scalar for body must produce unit"))]
    (Ok (Unit))))

(define (tc-for-owned-state-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-name-id : i64]
  [index-name-id : i64]
  [source-id : i64]
  [body-id : i64]) : ResultTcType
  (let
    [source-name : i64
      (try (tc-for-owned-name-id-result ctx source-name-id "source state"))]
    [index-name : i64
      (try (tc-for-owned-name-id-result ctx index-name-id "source index"))]
    [source-ty : ast.AstType (try (tc-expr-id ctx env source-id))]
    (match (tc-type-strip-region
      (tc-resolve-type ctx (tc-global-shared-view source-ty)))
      [(Array _ _)
        (tc-for-owned-body-unit
          ctx
          (tc-bind-id (tc-bind-id env source-name source-ty) index-name (I64))
          body-id)]
      [_
        (Err
          "typecheck: scalar for owned planner requires a fixed-array source")])))

(define (tc-for-owned-step-after-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [binding-name : i64]
  [expected-id : i64]
  [elem-ty : ast.AstType]
  [body-id : i64]) : ResultTcType
  (let
    [expected-ty
      (try
        (if (>= expected-id 0)
          (tc-for-owned-expected-type ctx expected-id)
          (ResultTcType.Ok (tc-global-shared-view elem-ty))))]
    [_
      (try
        (tc-expect
          (tc-global-shared-view elem-ty)
          expected-ty
          "typecheck: scalar for item annotation mismatch"))]
    (tc-for-owned-body-unit ctx (tc-bind-id env binding-name elem-ty) body-id)))

(define (tc-for-owned-step-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-id : i64]
  [index-id : i64]
  [binding-id : i64]
  [expected-id : i64]
  [done-id : i64]
  [body-id : i64]) : ResultTcType
  (let
    [_ (try (tc-for-owned-name-id-result ctx source-id "source state"))]
    (let
      [_ (try (tc-for-owned-name-id-result ctx index-id "source index"))]
      (let
        [binding-name : i64
          (try (tc-for-owned-name-id-result ctx binding-id "item binding"))]
        [_ (try (tc-for-owned-name-id-result ctx done-id "done flag"))]
        [source-ty : ast.AstType (try (tc-expr-id ctx env source-id))]
        (match (tc-type-strip-region (tc-resolve-type ctx source-ty))
          [(Array elem-id _)
            (let
              [index-ty : ast.AstType
                (try
                  (tc-expr-with-expected-or-actual-id ctx env index-id (I64)))]
              (if (tc-integer-type? index-ty)
                (let
                  [done-ty : ast.AstType
                    (try
                      (tc-expr-with-expected-or-actual-id
                        ctx
                        env
                        done-id
                        (Bool)))]
                  [_
                    (try
                      (tc-expect
                        done-ty
                        (Bool)
                        "typecheck: scalar for done state must be bool"))]
                  (tc-for-owned-step-after-types
                    ctx
                    env
                    binding-name
                    expected-id
                    (tc-context-type-get ctx elem-id)
                    body-id))
                (Err "typecheck: scalar for owned-array index must be integer")))]
          [_
            (Err
              "typecheck: scalar for owned step requires its matching fixed-array state")])))))

(define (tc-foreach2-coordinate-type? [ty : ast.AstType]) : bool
  (match ty
    [(I64) true]
    [_ false]))

;; Type a rank-2 foreach bound in the enclosing scope: no coordinate is
;; visible to any bound.
(define (tc-foreach2-bound-ok
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound-id : i64]) : ResultTcUnit
  (let
    [ty (try (tc-expr-with-expected-or-actual-id ctx env bound-id (I64)))]
    (tc-expect
      ty
      (I64)
      (tc-kind-message
        (Spmd)
        "typecheck: rank-2 foreach bounds must have type i64"))))

(define (tc-foreach2-bounds-ok
  [ctx : TcContext]
  [env : TcTypeEnv]
  [outer-start : i64]
  [outer-end : i64]
  [inner-start : i64]
  [inner-end : i64]) : ResultTcUnit
  (let
    [_ (try (tc-foreach2-bound-ok ctx env outer-start))]
    (let
      [_ (try (tc-foreach2-bound-ok ctx env outer-end))]
      (let
        [_ (try (tc-foreach2-bound-ok ctx env inner-start))]
        (tc-foreach2-bound-ok ctx env inner-end)))))

(define (tc-expr-inner [ctx : TcContext] [env : TcTypeEnv] [expr : ast.AstExpr]) : ResultTcType
  (match expr
    [(Spanned inner-box span)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        (match (tc-global-shared-view inner)
          [(MacroExpansion expanded provenance-id macro-name-id)
            (tc-macro-expansion-result-with-frame
              ctx
              (tc-context-expr-get ctx expanded)
              (macro-expansion-invocation-path-id provenance-id)
              (macro-expansion-origin-path-id provenance-id)
              macro-name-id
              span
              (tc-semantic-expansion
                ctx
                env
                (macro-expansion-origin-path-id provenance-id)
                macro-name-id
                span
                (tc-expr-id ctx env expanded)))]
          [_
            (let
              [result : ResultTcType
                (match (tc-global-shared-view inner)
                  [(Unsafe exprs)
                    (tc-unsafe-begin-list-scoped ctx env exprs No (Some span))]
                  [_ (tc-expr-id ctx env inner-box)])]
              (match result
                [(Ok ty) (Ok ty)]
                [(Err message)
                  (tc-locate-spanned-error-with-context
                    ctx
                    env
                    inner
                    span
                    message)]))]))]
    [(or (MacroExpansion inner _ _) (LaneValue inner))
      (tc-expr-id ctx env inner)]
    [(Literal lit) (tc-literal-type-checked lit)]
    [(BinaryData _) (Ok (ast.ast-ty-dyn-array (& (U8))))]
    [(Var name)
      (if (and
        (not (tc-env-key-has-name-id? name))
        (not
          (macro-hygiene-global-id? (tc-context-structural-session ctx) name)))
        (tc-lookup-id env name)
        (let
          [name-text : String
            (tc-hygiene-name-text-id-for-session
              (tc-context-structural-session ctx)
              name)]
          (if (tc-dotted-place-name-id? ctx env name)
            (let
              [virtual-id
                (try
                  (tc-dotted-local-field-expr-id-after-check
                    (tc-context-structural-session ctx)
                    name))]
              (tc-expr-id ctx env virtual-id))
            (tc-var-expr-after-local-field-check ctx env name name-text))))]
    [(TypeLiteral ty-id)
      (Err
        (str_cat.str-cat
          (cdiag.compiler-diagnostic-typecheck-tag (ComptimeConstraint))
          "type value "
          (tc-type-render (tc-resolve-type ctx (tc-context-type-get ctx ty-id)))
          " is compile-time only"))]
    [(Init maybe-ty-id)
      (match (ast.ast-maybe-type-from-id maybe-ty-id)
        [(Some ty) (tc-init-expr ctx env ty)]
        [(No)
          (Err
            "typecheck: contextual init requires an expected type; use (init : T) or add an annotation")])]
    [(Ann inner-box ty-id)
      (let
        [want-ty : ast.AstType
          (tc-resolve-type ctx (tc-context-type-get ctx ty-id))]
        [got
          (try
            (tc-expr-with-expected-or-actual-id
              ctx
              env
              inner-box
              (tc-global-shared-view want-ty)))]
        [_
          (try
            (tc-expect
              (tc-global-shared-view got)
              (tc-global-shared-view want-ty)
              "typecheck: annotation type mismatch"))]
        (Ok
          (if (tc-type-contains-any-region (tc-global-shared-view got))
            got
            want-ty)))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (let
            [body : ast.AstExpr (tc-context-expr-get ctx body-box)]
            [next-env
              (try (tc-let-bindings-for-body ctx env bindings body-box body))]
            [body-ty (try (tc-expr-id ctx next-env body-box))]
            [_
              (try
                (tc-ensure-reference-type-does-not-escape-names
                  (tc-global-shared-view body-ty)
                  (tc-let-binding-list-add-bound-name-ids bindings Nil)))]
            (Ok body-ty))])]
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda params maybe-ret body-box)
          (let
            [body : ast.AstExpr (tc-context-expr-get ctx body-box)]
            (tc-lambda-expr ctx env params maybe-ret body-box body))])]
    [(Tuple exprs)
      (let
        [_
          (try
            (tc-ensure-cleanup-resource-not-stored-list
              ctx
              env
              (tc-global-shared-view exprs)))]
        [tys (try (tc-expr-list-types ctx env exprs))]
        (Ok (tc-tag-active-region env (ast.ast-ty-tuple tys))))]
    [(TupleRef tuple-box index)
      (let
        [tuple-ty (try (tc-expr-id ctx env tuple-box))]
        (match (tc-type-strip-region (tc-global-shared-view tuple-ty))
          [(Tuple tys)
            (let
              [elem-ty
                (try
                  (tc-type-list-ref
                    (ast.ast-type-list-box-shared-view tys)
                    index))]
              (Ok (tc-project-from-region-container tuple-ty elem-ty)))]
          [_ (Err "typecheck: tuple-ref requires tuple type")]))]
    [(Array exprs)
      (let
        [_
          (try
            (tc-ensure-cleanup-resource-not-stored-list
              ctx
              env
              (tc-global-shared-view exprs)))]
        (if (ast.ast-expr-list-empty? (& exprs))
          (Err "typecheck: cannot infer type of empty array")
          (let
            [first : i64 (ast.ast-expr-list-get (& exprs) 0 0)]
            [rest : ast.AstExprList
              (ast.ast-expr-list-tail-from-ref (& exprs) 1)]
            [first-ty (try (tc-expr-id ctx env first))]
            [_
              (try
                (tc-check-array-rest
                  ctx
                  env
                  rest
                  (tc-global-shared-view first-ty)))]
            (Ok (ast.ast-ty-array (& first-ty) (tc-expr-list-len exprs))))))]
    [(DynArray exprs) (tc-expr-dyn-array-literal-infer ctx env exprs)]
    [(FixedMakeArray elem-ty-id len-box)
      (tc-fixed-make-array-expr
        ctx
        env
        (tc-resolve-type ctx (tc-context-type-get ctx elem-ty-id))
        (tc-context-expr-get ctx len-box))]
    [(MakeArray elem-ty-id len-box)
      (let
        [len : ast.AstExpr (tc-context-expr-get ctx len-box)]
        [elem : ast.AstType
          (tc-resolve-type ctx (tc-context-type-get ctx elem-ty-id))]
        [len-ty
          (try (tc-expr-with-expected-or-actual-id ctx env len-box (I64)))]
        (cond
          [(not (tc-integer-type? len-ty))
            (Err "typecheck: __tl_make-array length must be integer")]
          [(not (tc-dyn-array-elem-supported? env (tc-global-shared-view elem)))
            (Err
              (tc-kind-message
                (TypeMismatch)
                "typecheck: __tl_make-array element type is not supported"))]
          [(not
              (tc-make-array-requires-element-init?
                (tc-context-expr-segment-bases ctx)
                (tc-global-shared-view elem)
                len))
            (Ok (tc-tag-active-region env (ast.ast-ty-dyn-array (& elem))))]
          [else
            (let
              [_
                (try
                  (tc-init-type-supported ctx env (tc-global-shared-view elem)))]
              (Ok (tc-tag-active-region env (ast.ast-ty-dyn-array (& elem)))))]))]
    [(ArrayRef array-box index-box)
      (let
        [array-ty (try (tc-expr-id ctx env array-box))]
        [index-ty
          (try (tc-expr-with-expected-or-actual-id ctx env index-box (I64)))]
        (if (tc-integer-type? index-ty)
          (let
            [receiver (try (tc-array-readable-receiver ctx array-ty))]
            (match receiver
              [(TcArrayReceiver container-ty elem-ty)
                (Ok (tc-project-from-region-container container-ty elem-ty))]))
          (Err "typecheck: array index must be integer")))]
    [(ArraySet array-box index-box value-box)
      (let
        [array : ast.AstExpr (tc-context-expr-get ctx array-box)]
        [value : ast.AstExpr (tc-context-expr-get ctx value-box)]
        [array-ty
          (try
            (match (tc-raw-deref-place-pointer-type
              ctx
              env
              (tc-global-shared-view array))
              [(Some (Ptr _))
                (ResultTcType.Err (tc-raw-deref-read-only-message))]
              [_ (tc-expr-id ctx env array-box)]))]
        [index-ty
          (try (tc-expr-with-expected-or-actual-id ctx env index-box (I64)))]
        (if (tc-integer-type? index-ty)
          (let
            [receiver (try (tc-array-set-receiver ctx array-ty))]
            (match receiver
              [(TcArrayReceiver container-ty elem-ty)
                (tc-array-mutation-value
                  ctx
                  env
                  array
                  container-ty
                  elem-ty
                  value
                  (tc-kind-message
                    (TypeMismatch)
                    "typecheck: array assignment value type mismatch"))]))
          (Err "typecheck: array index must be integer")))]
    [(ArrayTake array-box live-box index-box)
      (let
        [array-ty (try (tc-expr-id ctx env array-box))]
        [receiver (try (tc-array-set-receiver ctx array-ty))]
        (match receiver
          [(TcArrayReceiver container-ty elem-ty)
            (match (tc-type-strip-region (tc-resolve-type ctx container-ty))
              [(DynArray _)
                (let
                  [live-ty (try (tc-expr-id ctx env live-box))]
                  [live-receiver (try (tc-array-set-receiver ctx live-ty))]
                  (match live-receiver
                    [(TcArrayReceiver live-container live-elem)
                      (match (tc-type-strip-region
                        (tc-resolve-type ctx live-container))
                        [(DynArray _)
                          (if (tc-type-eq
                            (tc-type-strip-region
                              (tc-resolve-type ctx live-elem))
                            (Bool))
                            (let
                              [index-ty
                                (try
                                  (tc-expr-with-expected-or-actual-id
                                    ctx
                                    env
                                    index-box
                                    (I64)))]
                              (if (tc-integer-type? index-ty)
                                (Ok
                                  (ast.ast-ty-tuple
                                    (ast.ast-type-cons
                                      (& (Bool))
                                      (&
                                        (ast.ast-type-cons
                                          (& elem-ty)
                                          (& (ast.ast-type-list-new)))))))
                                (Err
                                  "typecheck: __tl_array-take! index must be integer")))
                            (Err
                              "typecheck: __tl_array-take! liveness bitmap must contain bool"))]
                        [_
                          (Err
                            "typecheck: __tl_array-take! liveness bitmap must be dynamic array")])]))]
              [_
                (Err
                  (tc-kind-message
                    (TypeMismatch)
                    "typecheck: __tl_array-take! source must be dynamic array"))])]))]
    [(Replace place-box replacement-box)
      (tc-replace-type
        ctx
        env
        (tc-context-expr-get ctx place-box)
        replacement-box)]
    [(ArrayPush array-box value-box)
      (let
        [array : ast.AstExpr (tc-context-expr-get ctx array-box)]
        [value : ast.AstExpr (tc-context-expr-get ctx value-box)]
        [array-ty (try (tc-expr-id ctx env array-box))]
        [receiver (try (tc-array-push-receiver ctx array-ty))]
        (match receiver
          [(TcArrayReceiver container-ty elem-ty)
            (tc-array-mutation-value
              ctx
              env
              array
              container-ty
              elem-ty
              value
              (tc-kind-message
                (TypeMismatch)
                "typecheck: __tl_array-push! value type mismatch"))]))]
    [(StringRef str-box index-box)
      (let
        [str-ty (try (tc-expr-id ctx env str-box))]
        [_
          (try
            (tc-expect str-ty (String) "typecheck: string-ref requires String"))]
        [index-ty
          (try (tc-expr-with-expected-or-actual-id ctx env index-box (I64)))]
        (if (tc-integer-type? index-ty)
          (Ok (Char))
          (Err "typecheck: string index must be integer")))]
    [(Begin exprs) (tc-begin-list ctx env exprs)]
    ;; `(unsafe ...)` types like `begin`; the unsafe-context flag exists for
    ;; the raw-pointer op checks.
    [(Unsafe exprs) (tc-unsafe-begin-list-scoped ctx env exprs No No)]
    [(If cond-box then-branch-box else-branch-box)
      (let
        [cond-ty (try (tc-expr-id ctx env cond-box))]
        [_
          (try
            (tc-expect cond-ty (Bool) "typecheck: if condition must be bool"))]
        [then-ty (try (tc-expr-id ctx env then-branch-box))]
        [else-ty (try (tc-expr-id ctx env else-branch-box))]
        (tc-merge-if-branch-types
          ctx
          env
          then-branch-box
          else-branch-box
          then-ty
          else-ty))]
    [(Set name value-box)
      (if (tc-dotted-place-name-id? ctx env name)
        (let
          [virtual-id
            (try
              (tc-dotted-local-field-set-expr-id-after-check
                (tc-context-expr-segment-bases ctx)
                (tc-context-structural-session ctx)
                name
                value-box))]
          (tc-expr-id ctx env virtual-id))
        (tc-set-expr-after-local-field-check ctx env name value-box))]
    [(Cast inner-box ty-id)
      (let
        [inner-ty (try (tc-expr-id ctx env inner-box))]
        [target-ty : ast.AstType
          (tc-resolve-type ctx (tc-context-type-get ctx ty-id))]
        (if (and
          (tc-castable-type? (tc-global-shared-view inner-ty))
          (tc-castable-type? (tc-global-shared-view target-ty)))
          (Ok target-ty)
          (if (tc-function-to-integer-cast?
            inner-ty
            (tc-global-shared-view target-ty))
            (let
              [_ (try (tc-require-unsafe ctx env "function-to-integer cast"))]
              (Ok target-ty))
            (Err
              (tc-kind-message
                (TypeMismatch)
                "typecheck: cast requires scalar numeric (integer/char/float) source and target")))))]
    [(Borrow mutable lifetime-id place-box)
      (let
        [_ (try (tc-normalize-dotted-local-field-node! ctx env place-box))]
        (tc-borrow-expr
          ctx
          (tc-context-expr-bases ctx)
          env
          mutable
          (ast.ast-borrow-lifetime-from-id lifetime-id)
          (tc-context-expr-get ctx place-box)))]
    [(Unary op inner-box)
      (let
        [ty (try (tc-expr-id ctx env inner-box))]
        (tc-unop-type op ty))]
    [(Binary op left-box right-box)
      (let
        [left : ast.AstExpr (tc-context-expr-get ctx left-box)]
        [right : ast.AstExpr (tc-context-expr-get ctx right-box)]
        [binop-types (try (tc-binop-expr-types ctx env op left right))]
        (match binop-types
          [(TcBinOpTypes _ _ result-ty) (Ok result-ty)]))]
    [(Call func-box args) (tc-call-or-array-length-id ctx env func-box args)]
    [(BracketClause _)
      (Err
        "typecheck: bracket clause is only valid as an ExprClause or ExprBindingClause macro operand")]
    [(While cond-box body-box)
      (let
        [cond-ty (try (tc-expr-id ctx env cond-box))]
        [_
          (try
            (tc-expect cond-ty (Bool) "typecheck: while condition must be bool"))]
        (tc-while-body ctx (tc-enter-loop-target env) body-box))]
    [(Foreach fe-box)
      (match (ast.ast-foreach-box-shared-view fe-box)
        [(Foreach index index-ty start-box end-box body-box)
          (let
            [body : ast.AstExpr (tc-context-expr-get ctx body-box)]
            [resolved-index-ty : ast.AstType (tc-resolve-type ctx index-ty)]
            (if (tc-integer-type? (tc-global-shared-view resolved-index-ty))
              (let
                [start-ty
                  (try
                    (tc-expr-with-expected-or-actual-id
                      ctx
                      env
                      start-box
                      (tc-global-shared-view resolved-index-ty)))]
                (if (tc-integer-type? start-ty)
                  (let
                    [end-ty
                      (try
                        (tc-expr-with-expected-or-actual-id
                          ctx
                          env
                          end-box
                          (tc-global-shared-view resolved-index-ty)))]
                    (if (tc-integer-type? end-ty)
                      (let
                        [body-env : TcTypeEnv
                          (tc-bind-id
                            env
                            index
                            (tc-global-shared-view resolved-index-ty))]
                        [body-ty (try (tc-expr-id ctx body-env body-box))]
                        [_
                          (try
                            (tc-expect
                              body-ty
                              (Unit)
                              (tc-kind-message
                                (Spmd)
                                "typecheck: foreach body must be unit")))]
                        (let
                          [_
                            (try
                              (tc-spmd-check-foreach-body
                                ctx
                                (tc-context-expr-bases ctx)
                                env
                                index
                                resolved-index-ty
                                body))]
                          (Ok (Unit))))
                      (Err
                        (tc-kind-message
                          (Spmd)
                          "typecheck: foreach end expression must be integer"))))
                  (Err
                    (tc-kind-message
                      (Spmd)
                      "typecheck: foreach start expression must be integer"))))
              (Err
                (tc-kind-message
                  (Spmd)
                  "typecheck: foreach index type must be integer"))))]
        [(Foreach2
            outer
            outer-ty
            outer-start-box
            outer-end-box
            inner
            inner-ty
            inner-start-box
            inner-end-box
            body-box)
          (if (and
            (tc-foreach2-coordinate-type? (tc-resolve-type ctx outer-ty))
            (tc-foreach2-coordinate-type? (tc-resolve-type ctx inner-ty)))
            (let
              [_
                (try
                  (tc-foreach2-bounds-ok
                    ctx
                    env
                    outer-start-box
                    outer-end-box
                    inner-start-box
                    inner-end-box))]
              (let
                [body-ty
                  (try
                    (tc-expr-id
                      ctx
                      (tc-bind-id (tc-bind-id env outer (I64)) inner (I64))
                      body-box))]
                [_
                  (try
                    (tc-expect
                      body-ty
                      (Unit)
                      (tc-kind-message
                        (Spmd)
                        "typecheck: foreach body must be unit")))]
                (let
                  [_
                    (try
                      (tc-spmd-check-foreach2-body-with-env
                        ctx
                        (tc-context-expr-bases ctx)
                        env
                        (tc-spmd-env-from-type-env env)
                        outer
                        inner
                        inner-start-box
                        inner-end-box
                        body-box))]
                  (Ok (Unit)))))
            (Err
              (tc-kind-message
                (Spmd)
                "typecheck: rank-2 foreach coordinate types must be i64")))])]
    [(SpmdReduce reduce-box)
      (match (ast.ast-spmd-reduce-box-shared-view reduce-box)
        [(Reduce op index index-ty start-box end-box init-box value-box)
          (let
            [init : ast.AstExpr (tc-context-expr-get ctx init-box)]
            [value : ast.AstExpr (tc-context-expr-get ctx value-box)]
            [resolved-index-ty : ast.AstType (tc-resolve-type ctx index-ty)]
            (if (tc-integer-type? (tc-global-shared-view resolved-index-ty))
              (let
                [start-ty (try (tc-expr-id ctx env start-box))]
                (if (tc-integer-type? start-ty)
                  (let
                    [end-ty (try (tc-expr-id ctx env end-box))]
                    (if (tc-integer-type? end-ty)
                      (let
                        [value-env : TcTypeEnv
                          (tc-bind-id
                            env
                            index
                            (tc-global-shared-view resolved-index-ty))]
                        [result-ty
                          (try
                            (tc-spmd-reduce-init-value-type
                              ctx
                              (tc-context-expr-bases ctx)
                              env
                              value-env
                              op
                              init
                              (tc-global-shared-view value)))]
                        [_
                          (try
                            (tc-spmd-check-reduce-value-broadcasts
                              ctx
                              (tc-context-expr-bases ctx)
                              env
                              index
                              resolved-index-ty
                              value))]
                        (Ok result-ty))
                      (Err
                        (tc-kind-message
                          (Spmd)
                          "typecheck: spmd-reduce end expression must be integer"))))
                  (Err
                    (tc-kind-message
                      (Spmd)
                      "typecheck: spmd-reduce start expression must be integer"))))
              (Err
                (tc-kind-message
                  (Spmd)
                  "typecheck: spmd-reduce index type must be integer"))))])]
    [(SpmdScan scan-box)
      (match (ast.ast-spmd-scan-box-shared-view scan-box)
        [(Scan
            op
            index
            index-ty
            start-box
            end-box
            prefix
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [init : ast.AstExpr (tc-context-expr-get ctx init-box)]
            [value : ast.AstExpr (tc-context-expr-get ctx value-box)]
            [body : ast.AstExpr (tc-context-expr-get ctx body-box)]
            [resolved-index-ty : ast.AstType (tc-resolve-type ctx index-ty)]
            [resolved-prefix-ty : ast.AstType (tc-resolve-type ctx prefix-ty)]
            (if (tc-integer-type? (tc-global-shared-view resolved-index-ty))
              (let
                [start-ty
                  (try
                    (tc-expr-with-expected-or-actual-id
                      ctx
                      env
                      start-box
                      (tc-global-shared-view resolved-index-ty)))]
                (if (tc-integer-type? start-ty)
                  (let
                    [end-ty
                      (try
                        (tc-expr-with-expected-or-actual-id
                          ctx
                          env
                          end-box
                          (tc-global-shared-view resolved-index-ty)))]
                    (if (tc-integer-type? end-ty)
                      (let
                        [value-env : TcTypeEnv
                          (tc-bind-id
                            env
                            index
                            (tc-global-shared-view resolved-index-ty))]
                        [body-env : TcTypeEnv
                          (tc-bind-id
                            value-env
                            prefix
                            (tc-global-shared-view resolved-prefix-ty))]
                        [_
                          (try
                            (tc-spmd-scan-init-value-type
                              ctx
                              (tc-context-expr-bases ctx)
                              env
                              value-env
                              op
                              (tc-global-shared-view resolved-prefix-ty)
                              init
                              value))]
                        (let
                          [body-ty (try (tc-expr-id ctx body-env body-box))]
                          [_
                            (try
                              (tc-expect
                                body-ty
                                (Unit)
                                (tc-kind-message
                                  (Spmd)
                                  "typecheck: spmd-scan body must be unit")))]
                          (let
                            [_
                              (try
                                (tc-spmd-check-scan-body
                                  ctx
                                  (tc-context-expr-bases ctx)
                                  env
                                  index
                                  resolved-index-ty
                                  prefix
                                  resolved-prefix-ty
                                  body))]
                            (Ok (Unit)))))
                      (Err
                        (tc-kind-message
                          (Spmd)
                          "typecheck: spmd-scan end expression must be integer"))))
                  (Err
                    (tc-kind-message
                      (Spmd)
                      "typecheck: spmd-scan start expression must be integer"))))
              (Err
                (tc-kind-message
                  (Spmd)
                  "typecheck: spmd-scan index type must be integer"))))])]
    [(SpmdCompact compact-box)
      (match (ast.ast-spmd-compact-box-shared-view compact-box)
        [(Compact
            index
            index-ty
            start-box
            end-box
            slot
            slot-ty
            init-box
            keep-box
            body-box)
          (tc-spmd-compact-expr-type
            ctx
            env
            index
            index-ty
            start-box
            end-box
            slot
            slot-ty
            init-box
            keep-box
            body-box)])]
    [(SpmdBroadcast value-box lane-box)
      (let
        [lane-ty
          (try (tc-expr-with-expected-or-actual-id ctx env lane-box (I64)))]
        [_
          (try
            (tc-expect
              (tc-resolve-type ctx lane-ty)
              (I64)
              (tc-kind-message
                (Spmd)
                "typecheck: spmd-broadcast lane must have type i64")))]
        [value-ty (try (tc-expr-id ctx env value-box))]
        (if (tc-spmd-broadcast-type-supported?
          (tc-resolve-type ctx (tc-global-shared-view value-ty)))
          (Ok value-ty)
          (Err (tc-spmd-broadcast-type-message))))]
    [(SpmdShuffle value-box lane-box)
      (let
        [lane-ty
          (try (tc-expr-with-expected-or-actual-id ctx env lane-box (I64)))]
        [_
          (try
            (tc-expect
              (tc-resolve-type ctx lane-ty)
              (I64)
              (tc-kind-message
                (Spmd)
                "typecheck: spmd-shuffle lane must have type i64")))]
        [value-ty (try (tc-expr-id ctx env value-box))]
        (if (tc-spmd-broadcast-type-supported?
          (tc-resolve-type ctx (tc-global-shared-view value-ty)))
          (Ok value-ty)
          (Err (tc-spmd-shuffle-type-message))))]
    [(or (SpmdProgramIndex) (SpmdProgramCount) (ProgramArgc)) (Ok (I64))]
    ;; The SPMD walker checks where these may appear and what they may read;
    ;; here they only type. foreach-active runs its body once per active lane,
    ;; so like foreach it is unit and so is its body.
    [(ForeachActive lane body-box)
      (let
        [body-ty (try (tc-expr-id ctx (tc-bind-id env lane (I64)) body-box))]
        [_
          (try
            (tc-expect
              body-ty
              (Unit)
              (tc-kind-message
                (Spmd)
                "typecheck: foreach-active body must be unit")))]
        (Ok (Unit)))]
    [(Match match-box)
      (match (ast.ast-match-box-shared-view match-box)
        [(Match scrutinee-box arms)
          (let
            [scrut-ty (try (tc-expr-id ctx env scrutinee-box))]
            (tc-match-expr ctx env scrut-ty arms No))])]
    [(StructGet receiver-box field)
      (match (tc-expr-id ctx env receiver-box)
        [(Ok receiver-ty) (tc-struct-get-result-type-id ctx receiver-ty field)]
        [(Err message)
          (let
            [receiver-ty
              (try
                (tc-raw-deref-field-receiver-type
                  ctx
                  env
                  (tc-context-expr-get ctx receiver-box)
                  message))]
            (tc-struct-get-result-type-id ctx receiver-ty field))])]
    [(StructSet receiver-box field value-box)
      (let
        [receiver : ast.AstExpr (tc-context-expr-get ctx receiver-box)]
        [value : ast.AstExpr (tc-context-expr-get ctx value-box)]
        (tc-struct-field-mutation-value-id ctx env receiver field value))]
    [(WithRegion region body)
      (tc-with-region-expr-scoped ctx env region body No)]
    [(WithEscape scratch-box body)
      (let
        [scratch : ast.AstExpr (tc-context-expr-get ctx scratch-box)]
        (tc-with-escape-expr ctx env scratch body No))]
    [(WithScratch body) (tc-with-scratch-expr ctx env body No)]
    [(InArena arena-box body)
      (let
        [arena : ast.AstExpr (tc-context-expr-get ctx arena-box)]
        (tc-in-arena-expr-scoped ctx env arena body No))]
    [(WithResource wr-box)
      (match (ast.ast-with-resource-box-shared-view wr-box)
        [(WithResource bindings body)
          (tc-with-resource-expr ctx env bindings body No)])]
    [(Box inner-box)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        (tc-box-expr ctx env inner))]
    [(BoxGet inner-box)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        (tc-box-get-expr ctx env inner))]
    [(BoxTake inner-box)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        (tc-deref-expr ctx env inner))]
    [(BoxSet box-box value-box)
      (let
        [box-expr : ast.AstExpr (tc-context-expr-get ctx box-box)]
        [value : ast.AstExpr (tc-context-expr-get ctx value-box)]
        (tc-box-mutation-value ctx env box-expr value))]
    [(Comptime inner-box)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        [ctfe-env : ctfe_support.CtfeEnv
          (tc-ctfe-env-for-comptime ctx (tc-global-shared-view inner))]
        (match (ctfe_support.compiler-ctfe-eval
          inner
          ctfe-env
          (ctfe_support.ctfe-fuel-limit))
          [(Ok value _) (tc-ctfe-value-type ctx value)]
          [(Err diag)
            (let
              [diagnostic : cdiag.CompilerDiagnostic
                (cdiag.compiler-diagnostic-box-shared-view diag)]
              (Err
                (cdiag.compiler-diagnostic-typecheck-error-text (& diagnostic))))]))]
    [(Quote _) (Ok (Expr))]
    [(Quasiquote template-box)
      (let
        [template : ast.AstExpr (tc-context-expr-get ctx template-box)]
        [_ (try (tc-quasiquote-template-ok ctx env template))]
        (Ok (Expr)))]
    [(Unquote _) (Err "typecheck: unquote is only valid inside quasiquote")]
    [(UnquoteSplicing _)
      (Err "typecheck: unquote-splicing is only valid inside quasiquote")]
    [(Try inner-box)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        (tc-try-expr ctx env inner))]
    [(Return value-box)
      (let
        [value : ast.AstExpr (tc-context-expr-get ctx value-box)]
        (tc-return-expr ctx env value))]
    [(Break) (tc-loop-control-expr env "break")]
    [(Continue) (tc-loop-control-expr env "continue")]
    [(PtrNull ty-id)
      (let
        [resolved : ast.AstType (tc-resolve-type ctx (ast.ty-node-get ty-id))]
        (match (tc-global-shared-view resolved)
          [(CFunc _ mode)
            (if (ast.ast-c-function-mode-nullable? mode)
              (Ok resolved)
              (Err
                "typecheck: ptr-null cannot create a non-null C function pointer"))]
          [(or (Ptr _) (MutPtr _)) (Ok resolved)]
          [_
            (Err
              "typecheck: ptr-null requires a pointer type, e.g. (ptr-null : (Ptr i64))")]))]
    [(PtrNullCheck inner-box)
      (let
        [inner-ty (try (tc-expr-id ctx env inner-box))]
        (match (tc-type-strip-region inner-ty)
          [(or (CFunc _ _) (Ptr _) (MutPtr _)) (Ok (Bool))]
          [_ (Err "typecheck: ptr-null? requires a raw pointer operand")]))]
    [(PtrAddrOf place-box)
      (let
        [_ (try (tc-normalize-dotted-local-field-node! ctx env place-box))]
        [place : ast.AstExpr (tc-context-expr-get ctx place-box)]
        (tc-ptr-addr-of-expr ctx env place))]
    [(PtrRead ptr-box)
      (let
        [ptr : ast.AstExpr (tc-context-expr-get ctx ptr-box)]
        (tc-ptr-read-expr ctx env ptr))]
    [(PtrWrite ptr-box value-box)
      (let
        [ptr : ast.AstExpr (tc-context-expr-get ctx ptr-box)]
        [value : ast.AstExpr (tc-context-expr-get ctx value-box)]
        (tc-ptr-write-expr ctx env ptr value))]
    [(PtrOffset ptr-box offset-box)
      (let
        [ptr : ast.AstExpr (tc-context-expr-get ctx ptr-box)]
        [offset : ast.AstExpr (tc-context-expr-get ctx offset-box)]
        (tc-ptr-offset-expr ctx env ptr offset))]
    [(PtrCast ptr-box target-id)
      (let
        [ptr : ast.AstExpr (tc-context-expr-get ctx ptr-box)]
        (tc-ptr-cast-expr ctx env ptr (ast.ty-node-get target-id)))]
    [(PtrToInt ptr-box)
      (let
        [ptr : ast.AstExpr (tc-context-expr-get ctx ptr-box)]
        (tc-ptr-to-int-expr ctx env ptr))]
    [(IntToPtr value-box target-id)
      (let
        [value : ast.AstExpr (tc-context-expr-get ctx value-box)]
        (tc-int-to-ptr-expr ctx env value (ast.ty-node-get target-id)))]
    [(StringData str-box)
      (let
        [str : ast.AstExpr (tc-context-expr-get ctx str-box)]
        (tc-string-data-expr ctx env str))]
    [(StringFromBytes ptr-box len-box)
      (let
        [ptr : ast.AstExpr (tc-context-expr-get ctx ptr-box)]
        [len : ast.AstExpr (tc-context-expr-get ctx len-box)]
        (tc-string-from-bytes-expr ctx env ptr len))]
    [(ArrayData array-box)
      (let
        [array : ast.AstExpr (tc-context-expr-get ctx array-box)]
        (tc-array-data-expr ctx env array))]
    [(ProgramArgv) (tc-program-entry-ptr-expr ctx env "program-argv")]
    [(ProgramEnvp) (tc-program-entry-ptr-expr ctx env "program-envp")]
    [(or (CpuIdEax leaf-box subleaf-box) (CpuIdEbx leaf-box subleaf-box)
         (CpuIdEcx leaf-box subleaf-box) (CpuIdEdx leaf-box subleaf-box))
      (let
        [leaf : ast.AstExpr (tc-context-expr-get ctx leaf-box)]
        [subleaf : ast.AstExpr (tc-context-expr-get ctx subleaf-box)]
        (tc-cpuid-expr ctx env leaf subleaf))]
    [(Xgetbv index-box)
      (let
        [index : ast.AstExpr (tc-context-expr-get ctx index-box)]
        (tc-xgetbv-expr ctx env index))]
    [(Syscall args) (tc-syscall-expr ctx env args)]
    [(ForOwnedState payload)
      (tc-for-owned-state-expr
        ctx
        env
        (ast.ast-for-owned-state-source-name (& payload))
        (ast.ast-for-owned-state-index-name (& payload))
        (ast.ast-for-owned-state-source (& payload))
        (ast.ast-for-owned-state-body (& payload)))]
    [(ForOwnedStep payload)
      (tc-for-owned-step-expr
        ctx
        env
        (ast.ast-for-owned-step-source-name (& payload))
        (ast.ast-for-owned-step-index-name (& payload))
        (ast.ast-for-owned-step-binding-name (& payload))
        (ast.ast-for-owned-step-expected-type (& payload))
        (ast.ast-for-owned-step-done-name (& payload))
        (ast.ast-for-owned-step-body (& payload)))]
    [_ (Err "typecheck: unsupported expression")]))

(define (tc-expr [ctx : TcContext] [env : TcTypeEnv] [expr : ast.AstExpr]) : ResultTcType
  (if (and
    (tc-type-env-scoped-runtime-active? env)
    (tc-expr-scoped-bindings? expr))
    (let
      [saved : TcTypeEnvScopedRuntimeSave (tc-type-env-scoped-runtime-save env)]
      [result : ResultTcType (tc-expr-inner ctx env expr)]
      (tc-type-env-scoped-runtime-restore! saved)
      result)
    (tc-expr-inner ctx env expr)))

(define (tc-extern-abi-enum-aggregate-type? [ty : ast.AstType]) : bool
  (match (tc-type-without-regions ty)
    [(or (Enum _) (EnumArgs _ _)) true]
    [_ false]))

(define (tc-extern-abi-inline-enum-type-ok?
  [ctx : TcContext]
  [ty : ast.AstType]) : bool
  (match (tc-type-without-regions ty)
    [(or (Enum name) (EnumArgs name _))
      (match (tc-inline-aggregate-layout-for-with-stack
        ctx
        (tc-nominal-name-id-display name)
        name
        Nil)
        [(Ok layout)
          (match layout
            [(Enum _ _ _) true]
            [_ false])]
        [(Err _) false])]
    [_ false]))

(define (tc-extern-abi-value-type-ok? [ctx : TcContext] [ty : ast.AstType]) : bool
  (match (tc-type-without-regions (tc-global-shared-view ty))
    [(or (I64) (I32) (I16) (I8) (U64) (U32) (U16) (U8) (F64) (F32) (Bool) (Char)
         (Unit) (Never) (Func _ _) (Ptr _) (MutPtr _) (String) (DynArray _)
         (Struct _) (StructArgs _ _))
      true]
    [(CFunc signature _)
      (match (tc-check-extern-c-abi ctx (tc-context-type-get ctx signature))
        [(Ok) true]
        [(Err _) false])]
    [(or (Enum _) (EnumArgs _ _)) (tc-extern-abi-inline-enum-type-ok? ctx ty)]
    [_ false]))

(define (tc-extern-abi-unsupported-message
  [position : String]
  [ty : ast.AstType]) : String
  (if (tc-extern-abi-enum-aggregate-type? (tc-global-shared-view ty))
    (str_cat.str-cat
      "typecheck: extern ABI c does not support enum aggregate "
      position
      " type "
      (tc-type-render ty))
    (str_cat.str-cat
      "typecheck: extern ABI c does not support "
      position
      " type "
      (tc-type-render ty))))

;; A public Slice reference is a two-word (pointer, length) value in the
;; language ABI, but native externals do not have a corresponding direct
;; reference form. Keep this guard deliberately narrow: only an immediate
;; Ref/MutRef whose resolved referent is Slice is rejected. Callers can expose
;; the native ABI explicitly as a pointer plus length, or wrap those fields in
;; an ordinary repr-c aggregate.
(define (tc-extern-native-slice-ref-type? [ctx : TcContext] [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(or (Ref _ inner) (MutRef _ inner))
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-context-type-get ctx inner)))
        [(Slice _) true]
        [_ false])]
    [_ false]))

(define (tc-extern-native-slice-ref-unsupported-message) : String
  (tc-kind-message
    (TypeMismatch)
    "typecheck: extern/native Slice references are unsupported; use pointer+length"))

(define (tc-check-extern-native-value-type [ctx : TcContext] [ty : ast.AstType]) : ResultTcUnit
  (let
    [resolved : ast.AstType
      (tc-type-strip-region (tc-resolve-type ctx (tc-global-shared-view ty)))]
    (match (tc-global-shared-view resolved)
      [(CFunc signature _)
        (tc-check-extern-c-abi ctx (tc-context-type-get ctx signature))]
      [_
        (cond
          [(tc-extern-native-slice-ref-type? ctx resolved)
            (Err (tc-extern-native-slice-ref-unsupported-message))]
          ;; An extern body is not checked, so it cannot prove the destroy an
          ;; `:invalidate` parameter promises (#6670).
          [(tc-type-invalidate-param? (tc-global-shared-view ty))
            (Err
              (tc-kind-message
                (ArenaOwnership)
                "typecheck: an extern function cannot declare an :invalidate parameter"))]
          [else Ok])])))

(define (tc-check-extern-native-signature-args-at
  [ctx : TcContext]
  [args : (& args ast.AstTypeList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast.ast-type-list-len args))
    Ok
    (let
      [_
        (try
          (tc-check-extern-native-value-type
            ctx
            (tc-context-type-get
              ctx
              (ast.ast-type-list-get args index (ast.ast-type-id-fallback)))))]
      (tc-check-extern-native-signature-args-at ctx args (+ index 1)))))

(define (tc-raw-c-function-pointer-type-message) : String
  "typecheck: raw C function pointer requires an explicit CFunc type")

(define (tc-check-extern-native-result-type
  [ctx : TcContext]
  [ty : ast.AstType]) : ResultTcUnit
  (let
    [resolved : ast.AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
    (match (tc-global-shared-view resolved)
      [(Func _ _) (Err (tc-raw-c-function-pointer-type-message))]
      [_ (tc-check-extern-native-value-type ctx resolved)])))

;; Default native declarations include private runtime contracts that are not
;; ordinary C signatures. Still validate explicit C callable types and borrowed
;; Slice boundaries regardless of whether the declaration writes `:abi c`.
(define (tc-check-extern-native-signature [ctx : TcContext] [ty : ast.AstType]) : ResultTcUnit
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(Func args ret)
      (let
        [_
          (try
            (tc-check-extern-native-signature-args-at
              ctx
              (__tl-box-place args)
              0))]
        (tc-check-extern-native-result-type ctx (tc-context-type-get ctx ret)))]
    [_ Ok]))

(define (tc-check-extern-arg-abi [ctx : TcContext] [args : ast.AstTypeList]) : ResultTcUnit
  (tc-check-extern-arg-abi-at ctx (& args) 0))

(define (tc-check-extern-arg-abi-at
  [ctx : TcContext]
  [args : (& args ast.AstTypeList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast.ast-type-list-len args))
    Ok
    (let
      [head : ast.AstType
        (ast.ty-node-get
          (ast.ast-type-list-get args index (ast.ast-type-id-fallback)))]
      (if (tc-extern-abi-value-type-ok? ctx (tc-global-shared-view head))
        (tc-check-extern-arg-abi-at ctx args (+ index 1))
        (Err (tc-extern-abi-unsupported-message "parameter" head))))))

(define (tc-check-extern-c-abi [ctx : TcContext] [ty : ast.AstType]) : ResultTcUnit
  (match ty
    [(Func args ret)
      (let
        [_
          (try
            (tc-check-extern-arg-abi
              ctx
              (ast.ast-type-list-box-shared-view args)))]
        (match (tc-type-strip-region (ast.ty-node-get ret))
          [(Func _ _) (Err (tc-raw-c-function-pointer-type-message))]
          [_
            (if (tc-extern-abi-value-type-ok? ctx (ast.ty-node-get ret))
              Ok
              (Err
                (tc-extern-abi-unsupported-message
                  "return"
                  (ast.ty-node-get ret))))]))]
    [_ (Err "typecheck: extern must have function type")]))

(define (tc-check-extern-value-c-abi [ctx : TcContext] [ty : ast.AstType]) : ResultTcUnit
  (match (tc-type-strip-region (tc-global-shared-view ty))
    [(Func _ _) (Err (tc-raw-c-function-pointer-type-message))]
    [_
      (if (tc-extern-abi-value-type-ok? ctx (tc-global-shared-view ty))
        Ok
        (Err (tc-extern-abi-unsupported-message "value" ty)))]))

(define (tc-check-extern-varargs-tail-type
  [ctx : TcContext]
  [abi : ast.AstExternAbi]) : ResultTcUnit
  (if (ast.ast-extern-abi-c-varargs-typed? (& abi))
    (let
      [tail-ty : ast.AstType
        (tc-resolve-type ctx (ast.ast-extern-abi-varargs-tail-type abi))]
      (if (tc-extern-abi-value-type-ok? ctx (tc-global-shared-view tail-ty))
        Ok
        (Err (tc-extern-abi-unsupported-message "variadic argument" tail-ty))))
    Ok))

(define (tc-check-extern-decl
  [ctx : TcContext]
  [kind : ast.AstExternKind]
  [metadata : ast.AstExternMetadata]
  [ty : ast.AstType]) : ResultTcUnit
  (match (tc-global-shared-view metadata)
    [(Metadata abi _ _ _ _)
      (let
        [explicit-abi : bool
          (ast.ast-extern-metadata-explicit-abi? (& metadata))]
        [resolved : ast.AstType (tc-resolve-type ctx ty)]
        (match kind
          [(Function)
            (let
              [_
                (try
                  (tc-check-extern-native-signature
                    ctx
                    (tc-global-shared-view resolved)))]
              (if (and
                (ast.ast-extern-abi-c? (& abi))
                (or explicit-abi (ast.ast-extern-abi-c-varargs? (& abi))))
                (let
                  [_ (try (tc-check-extern-c-abi ctx resolved))]
                  (if (ast.ast-extern-abi-c-varargs? (& abi))
                    (tc-check-extern-varargs-tail-type ctx abi)
                    Ok))
                Ok))]
          [(Value)
            (if (ast.ast-extern-abi-c-varargs? (& abi))
              (Err "typecheck: extern value cannot use c-varargs ABI")
              (tc-check-extern-value-c-abi ctx resolved))]))]))

(define (tc-summary-add-decl
  [summary : CompilerTypecheckSummary]
  [decl : ast.AstDecl]) : CompilerTypecheckSummary
  (match summary
    [(CompilerTypecheckSummary values functions externs)
      (match decl
        [(Def decl-meta _ _ _)
          (CompilerTypecheckSummary (+ values 1) functions externs)]
        [(DefFn decl-meta _ _ _ _ _)
          (CompilerTypecheckSummary values (+ functions 1) externs)]
        [(Extern decl-meta _ _ _ _)
          (CompilerTypecheckSummary values functions (+ externs 1))]
        [(Unsafe inner-box)
          (let
            [inner : ast.AstDecl (ast.ast-decl-box-shared-view inner-box)]
            (tc-summary-add-decl summary inner))]
        [_ summary])]))

(define (tc-macro-signature-type [ty : ast.AstType]) : ast.AstType
  (match (tc-global-shared-view ty)
    [(Var name)
      (match (tc-macro-signature-stdlib-comptime-type-id name)
        [(Some syntax-ty) syntax-ty]
        [(No)
          (cond
            [(= name cbi.compiler-builtin-id-fix-Expr) (Expr)]
            [(= name cbi.compiler-builtin-id-fix-ExprList) (ExprList)]
            [(= name cbi.compiler-builtin-id-fix-ExprClause)
              (tc-macro-expr-clause-type)]
            [(= name cbi.compiler-builtin-id-fix-ExprClauseList)
              (tc-macro-expr-clause-list-type)]
            [(= name cbi.compiler-builtin-id-fix-ExprBindingClause)
              (tc-macro-expr-binding-clause-type)]
            [(= name cbi.compiler-builtin-id-fix-ExprBindingClauseList)
              (tc-macro-expr-binding-clause-list-type)]
            [(= name cbi.compiler-builtin-id-fix-Pattern)
              (tc-macro-pattern-type)]
            [(= name cbi.compiler-builtin-id-fix-PatternList)
              (tc-macro-pattern-list-type)]
            [(= name cbi.compiler-builtin-id-fix-MatchArm)
              (tc-macro-match-arm-type)]
            [(= name cbi.compiler-builtin-id-fix-MatchArmList)
              (tc-macro-match-arm-list-type)]
            [else ty])])]
    [(or (VarArgs name _) (Enum name) (EnumArgs name _) (Struct name)
         (StructArgs name _))
      (match (tc-macro-signature-stdlib-comptime-type-id name)
        [(Some syntax-ty) syntax-ty]
        [(No) ty])]
    [_ ty]))

(define (tc-macro-produced-type-compatible?
  [ctx : TcContext]
  [ret : ast.AstType]
  [produced : ast.AstType]) : bool
  (let
    [expected : ast.AstType (tc-resolve-type ctx (tc-macro-signature-type ret))]
    (or
      (tc-type-eq (tc-global-shared-view expected) (Expr))
      (tc-type-eq (tc-global-shared-view produced) (Expr))
      (ctfe_support.ctfe-untyped-expr-type? produced)
      (ctfe_support.ctfe-captured-expr-type? (tc-global-shared-view produced))
      (tc-type-compatible? expected (tc-resolve-type ctx produced)))))

(define (tc-check-defmacro-produced-type
  [ctx : TcContext]
  [ret : ast.AstType]
  [value : ctfe_support.CompilerCtfeValue]) : ResultTcUnit
  (if (tc-macro-result-module? (tc-global-shared-view ret))
    (match value
      [(Expr _ _) Ok]
      [_ (Err "typecheck: Module macro body must return Expr")])
    (if (tc-macro-result-decls? (tc-global-shared-view ret))
      (match value
        [(Expr _ _) Ok]
        [_ (Err "typecheck: Decls macro body must return Expr")])
      (match value
        [(Expr _ produced)
          (if (tc-macro-produced-type-compatible? ctx ret produced)
            Ok
            (Err
              "typecheck: macro body produced type does not match declaration"))]
        [_ (Err "typecheck: macro body must return Expr")]))))

(define (tc-comptime-purity-chain-push [chain : TcStringList] [name : String]) : TcStringList
  (tc-string-list-cons chain name))

(define (tc-comptime-purity-chain-render [chain : TcStringList]) : String
  (if (tc-string-list-empty? chain)
    ""
    (let
      [head : String (tc-string-list-head (tc-global-shared-view chain))]
      [tail : String
        (tc-comptime-purity-chain-render (tc-string-list-rest chain))]
      (if (string.eq tail "")
        head
        (str_cat.str-cat tail " -> " head)))))

(define (tc-comptime-purity-chain-path [chain : TcStringList] [name : String]) : String
  (let
    [prefix : String (tc-comptime-purity-chain-render chain)]
    (if (string.eq prefix "")
      name
      (str_cat.str-cat prefix " -> " name))))

(define (tc-comptime-purity-error
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [chain : TcStringList]
  [name : String]
  [reason : String]) : ResultTcUnit
  (Err
    (tc-locate-error-at-expr
      expr-bases
      expr
      (str_cat.str-cat
        "typecheck: comptime purity rejects "
        reason
        "; reference path: "
        (tc-comptime-purity-chain-path chain name)))))

(define (tc-comptime-purity-banned-module? [module : String]) : bool
  (cond
    [(string.eq module "io") true]
    [(string.eq module "stdlib.io") true]
    [(string.eq module "stdlib/io") true]
    [(string.eq module "fs") true]
    [(string.eq module "stdlib.fs") true]
    [(string.eq module "stdlib/fs") true]
    [(string.eq module "process") true]
    [(string.eq module "stdlib.process") true]
    [(string.eq module "stdlib/process") true]
    [(string.eq module "stdlib.process-runtime") true]
    [(string.eq module "stdlib/process_runtime") true]
    [(string.eq module "env") true]
    [(string.eq module "stdlib.env") true]
    [(string.eq module "stdlib/env") true]
    [else false]))

(define (tc-comptime-purity-banned-qualified?
  [ctx : TcContext]
  [_ : (& _ str)]
  [name-id : i64]) : bool
  (let
    [source-id : i64
      (macro-hygiene-global-source-name-id-or
        (tc-context-structural-session ctx)
        name-id
        name-id)]
    (if (tc-name-qualified-id? (tc-context-structural-session ctx) source-id)
      (let
        [qualifier-id : i64 (tc-qualified-name-module-id source-id)]
        [target-id : i64
          (tc-qualified-access-target-module-id ctx qualifier-id)]
        [qualifier : String (ci.intern-str qualifier-id)]
        [target : String (tc-env-key-name-text target-id)]
        (or
          (tc-comptime-purity-banned-module? qualifier)
          (tc-comptime-purity-banned-module? target)))
      false)))

(define (tc-comptime-purity-ctfe-builtin?
  [session : cis.InternStructuralSessionHandle]
  [name : String]
  [name-id : i64]) : bool
  (let
    [lookup-name : String (tc-hygiene-global-call-name name)]
    [lookup-id : i64
      (macro-hygiene-global-source-name-id-or session name-id name-id)]
    [call-id : i64 (ctfe_support.ctfe-comptime-helper-call-name-id lookup-id)]
    (cond
      [(ctfe_support.ctfe-builtin-size-align-id? lookup-id) true]
      [(ctfe_support.ctfe-builtin-offset-of-id? lookup-id) true]
      [(ctfe_support.ctfe-builtin-reflection-id? call-id) true]
      [(ctfe_support.ctfe-builtin-module-value-id? call-id) true]
      [(ctfe_support.ctfe-string-eq-helper-name-id?
          (tc-global-shared-view lookup-name)
          lookup-id)
        true]
      [(ctfe_support.ctfe-builtin-string-build-id? call-id) true]
      [(ctfe_support.ctfe-string-length-helper-name-id?
          (tc-global-shared-view lookup-name)
          lookup-id)
        true]
      [(ctfe_support.ctfe-string-ref-helper-name-id?
          (tc-global-shared-view lookup-name)
          lookup-id)
        true]
      [(ctfe_support.ctfe-string-to-int-helper-name-id? lookup-name lookup-id)
        true]
      [(ctfe_support.ctfe-builtin-int-to-string-id? call-id) true]
      [(ctfe_support.ctfe-builtin-inspector-id? call-id) true]
      [(ctfe_support.ctfe-builtin-expr-clause-list-inspector-id? call-id) true]
      [(ctfe_support.ctfe-builtin-expr-binding-clause-list-inspector-id?
          call-id)
        true]
      [(ctfe_support.ctfe-builtin-comptime-error-id? call-id) true]
      [else false])))

(define (tc-macro-param-list-add-bound-names
  [params : ast.AstMacroParamList]
  [bound : TcStringList]) : TcStringList
  (tc-macro-param-list-add-bound-names-at (& params) 0 bound))

(define (tc-macro-param-list-add-bound-names-at
  [params : (& params ast.AstMacroParamList)]
  [index : i64]
  [bound : TcStringList]) : TcStringList
  (if (>= index (ast.ast-macro-param-list-len params))
    bound
    (match (ast.ast-macro-param-list-get
      params
      index
      (ast.ast-macro-param-fallback))
      [(Param name _ _ _)
        (tc-macro-param-list-add-bound-names-at
          params
          (+ index 1)
          (tc-string-list-add bound (tc-env-key-name-text name)))])))

(define (tc-macro-param-bound-names [params : ast.AstMacroParamList]) : TcStringList
  (tc-macro-param-list-add-bound-names params Nil))

;; Purity analysis is a read-only pre-typecheck walk: it may recurse into a
;; referenced declaration, but never expands a macro or installs a pool. Carry
;; one stable expression segment table through the whole reachability walk.
(define (tc-comptime-purity-expr
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [expr : ast.AstExpr]) : ResultTcUnit
  (tc-comptime-purity-expr-mode ctx expr-bases env bound chain seen false expr))

(define (tc-comptime-purity-node-mode
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [expr-id : i64]) : ResultTcUnit
  (tc-comptime-purity-expr-mode
    ctx
    expr-bases
    env
    bound
    chain
    seen
    template?
    (ast.ast-expr-segment-bases-get expr-bases expr-id)))

(define (tc-comptime-purity-node2-mode
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [left : i64]
  [right : i64]) : ResultTcUnit
  (let
    [_
      (try
        (tc-comptime-purity-node-mode
          ctx
          expr-bases
          env
          (tc-global-shared-view bound)
          (tc-global-shared-view chain)
          (tc-global-shared-view seen)
          template?
          left))]
    (tc-comptime-purity-node-mode
      ctx
      expr-bases
      env
      bound
      chain
      seen
      template?
      right)))

(define (tc-comptime-purity-node3-mode
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [first : i64]
  [second : i64]
  [third : i64]) : ResultTcUnit
  (let
    [_
      (try
        (tc-comptime-purity-node-mode
          ctx
          expr-bases
          env
          (tc-global-shared-view bound)
          (tc-global-shared-view chain)
          (tc-global-shared-view seen)
          template?
          first))]
    (let
      [_
        (try
          (tc-comptime-purity-node-mode
            ctx
            expr-bases
            env
            (tc-global-shared-view bound)
            (tc-global-shared-view chain)
            (tc-global-shared-view seen)
            template?
            second))]
      (tc-comptime-purity-node-mode
        ctx
        expr-bases
        env
        bound
        chain
        seen
        template?
        third))))

(define (tc-comptime-purity-template-bound
  [template? : bool]
  [bound : TcStringList]
  [name : i64]) : TcStringList
  (if template?
    bound
    (tc-string-list-add bound (tc-env-key-name-text name))))

(define (tc-comptime-purity-reject-or-template-ok
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [chain : TcStringList]
  [template? : bool]
  [name : String]
  [reason : String]) : ResultTcUnit
  (if template?
    Ok
    (tc-comptime-purity-error expr-bases expr chain name reason)))

(define (tc-comptime-purity-reject-or-template-node
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [expr : ast.AstExpr]
  [name : String]
  [reason : String]
  [inner : i64]) : ResultTcUnit
  (if template?
    (tc-comptime-purity-node-mode
      ctx
      expr-bases
      env
      bound
      chain
      seen
      true
      inner)
    (tc-comptime-purity-error expr-bases expr chain name reason)))

(define (tc-comptime-purity-reject-or-template-node2
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [expr : ast.AstExpr]
  [name : String]
  [reason : String]
  [left : i64]
  [right : i64]) : ResultTcUnit
  (if template?
    (tc-comptime-purity-node2-mode
      ctx
      expr-bases
      env
      bound
      chain
      seen
      true
      left
      right)
    (tc-comptime-purity-error expr-bases expr chain name reason)))

(define (tc-comptime-purity-expr-list-mode
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [exprs : ast.AstExprList]) : ResultTcUnit
  (tc-comptime-purity-expr-list-mode-at
    ctx
    expr-bases
    env
    bound
    chain
    seen
    template?
    (& exprs)
    0))

(define (tc-comptime-purity-expr-list-mode-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : ResultTcUnit
  (if (>= index exprs.len)
    Ok
    (let
      [_
        (try
          (tc-comptime-purity-node-mode
            ctx
            expr-bases
            env
            (tc-global-shared-view bound)
            (tc-global-shared-view chain)
            (tc-global-shared-view seen)
            template?
            (ast.ast-expr-list-get exprs index 0)))]
      (tc-comptime-purity-expr-list-mode-at
        ctx
        expr-bases
        env
        bound
        chain
        seen
        template?
        exprs
        (+ index 1)))))

(define (tc-comptime-purity-let-bindings-mode
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [bindings : ast.AstLetBindingList]) : ResultTcStringList
  (tc-comptime-purity-let-bindings-mode-at
    ctx
    expr-bases
    env
    bound
    chain
    seen
    template?
    (& bindings)
    0))

(define (tc-comptime-purity-let-bindings-mode-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : ResultTcStringList
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (Ok bound)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name _ init-box)
        (let
          [_
            (try
              (tc-comptime-purity-node-mode
                ctx
                expr-bases
                env
                (tc-global-shared-view bound)
                (tc-global-shared-view chain)
                (tc-global-shared-view seen)
                template?
                init-box))]
          (tc-comptime-purity-let-bindings-mode-at
            ctx
            expr-bases
            env
            (tc-macro-abstract-binding-bound
              expr-bases
              (tc-context-macro-state ctx)
              bound
              name
              (ast.ast-expr-segment-bases-get expr-bases init-box)
              template?)
            chain
            seen
            template?
            bindings
            (+ index 1)))])))

(define (tc-comptime-purity-resource-bindings-mode
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [bindings : ast.AstResourceBindingList]) : ResultTcStringList
  (tc-comptime-purity-resource-bindings-mode-at
    ctx
    expr-bases
    env
    bound
    chain
    seen
    template?
    (& bindings)
    0))

(define (tc-comptime-purity-resource-bindings-mode-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [index : i64]) : ResultTcStringList
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    (Ok bound)
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(Binding name init-box cleanup-box _)
        (let
          [_
            (try
              (tc-comptime-purity-node2-mode
                ctx
                expr-bases
                env
                (tc-global-shared-view bound)
                (tc-global-shared-view chain)
                (tc-global-shared-view seen)
                template?
                init-box
                cleanup-box))]
          (tc-comptime-purity-resource-bindings-mode-at
            ctx
            expr-bases
            env
            (tc-comptime-purity-template-bound template? bound name)
            chain
            seen
            template?
            bindings
            (+ index 1)))])))

(define (tc-comptime-purity-match-arms-mode
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [arms : ast.AstMatchArmList]) : ResultTcUnit
  (tc-comptime-purity-match-arms-mode-at
    ctx
    expr-bases
    env
    bound
    chain
    seen
    template?
    (& arms)
    0))

(define (tc-comptime-purity-match-arms-mode-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : ResultTcUnit
  (if (>= index arms.len)
    Ok
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (let
          [_
            (try
              (tc-comptime-purity-node-mode
                ctx
                expr-bases
                env
                (if template?
                  (owned_view.compiler-owned-shared-view bound)
                  (tc-pattern-add-bound-names
                    pattern
                    (tc-global-shared-view bound)))
                (tc-global-shared-view chain)
                (tc-global-shared-view seen)
                template?
                body-box))]
          (tc-comptime-purity-match-arms-mode-at
            ctx
            expr-bases
            env
            bound
            chain
            seen
            template?
            arms
            (+ index 1)))])))

(define (tc-for-owned-purity-add-bound
  [expr-bases : i64]
  [expr-id : i64]
  [bound : TcStringList]) : TcStringList
  (let
    [name-id : i64
      (tc-expr-var-name-id
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases expr-id))]
    (if (>= name-id 0)
      (tc-string-list-add bound (tc-env-key-name-text name-id))
      bound)))

(define (tc-comptime-purity-expr-mode
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match (tc-global-shared-view expr)
    [(Var name)
      (if template?
        Ok
        (tc-comptime-purity-var ctx expr-bases env bound chain seen expr name))]
    [(Call func args)
      (let
        [_
          (try
            (tc-macro-abstract-check-current-call
              (tc-context-macro-state ctx)
              expr-bases
              (tc-global-shared-view bound)
              template?
              expr
              (ast.ast-expr-segment-bases-get expr-bases func)
              (tc-global-shared-view args)))]
        (let
          [_
            (try
              (tc-comptime-purity-node-mode
                ctx
                expr-bases
                env
                (tc-global-shared-view bound)
                (tc-global-shared-view chain)
                (tc-global-shared-view seen)
                template?
                func))]
          (tc-comptime-purity-expr-list-mode
            ctx
            expr-bases
            env
            bound
            chain
            seen
            template?
            args)))]
    [(If cond then-branch else-branch)
      (tc-comptime-purity-if-mode
        ctx
        expr-bases
        env
        bound
        chain
        seen
        template?
        cond
        then-branch
        else-branch)]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body)
          (let
            [body-bound
              (try
                (tc-comptime-purity-let-bindings-mode
                  ctx
                  expr-bases
                  env
                  bound
                  (tc-global-shared-view chain)
                  (tc-global-shared-view seen)
                  template?
                  bindings))]
            (tc-comptime-purity-node-mode
              ctx
              expr-bases
              env
              body-bound
              chain
              seen
              template?
              body))])]
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda params _ body)
          (tc-comptime-purity-node-mode
            ctx
            expr-bases
            env
            (if template?
              bound
              (tc-param-list-add-bound-names params bound))
            chain
            seen
            template?
            body)])]
    [(ForOwnedState payload)
      (let
        [_
          (try
            (tc-comptime-purity-node-mode
              ctx
              expr-bases
              env
              (tc-global-shared-view bound)
              (tc-global-shared-view chain)
              (tc-global-shared-view seen)
              template?
              (ast.ast-for-owned-state-source (& payload))))]
        (tc-comptime-purity-node-mode
          ctx
          expr-bases
          env
          (tc-for-owned-purity-add-bound
            expr-bases
            (ast.ast-for-owned-state-index-name (& payload))
            (tc-for-owned-purity-add-bound
              expr-bases
              (ast.ast-for-owned-state-source-name (& payload))
              bound))
          chain
          seen
          template?
          (ast.ast-for-owned-state-body (& payload))))]
    [(ForOwnedStep payload)
      (let
        [_
          (try
            (tc-comptime-purity-node3-mode
              ctx
              expr-bases
              env
              (tc-global-shared-view bound)
              (tc-global-shared-view chain)
              (tc-global-shared-view seen)
              template?
              (ast.ast-for-owned-step-source-name (& payload))
              (ast.ast-for-owned-step-index-name (& payload))
              (ast.ast-for-owned-step-done-name (& payload))))]
        (tc-comptime-purity-node-mode
          ctx
          expr-bases
          env
          (tc-for-owned-purity-add-bound
            expr-bases
            (ast.ast-for-owned-step-binding-name (& payload))
            bound)
          chain
          seen
          template?
          (ast.ast-for-owned-step-body (& payload))))]
    [(Unsafe exprs)
      (if template?
        (tc-comptime-purity-expr-list-mode
          ctx
          expr-bases
          env
          bound
          chain
          seen
          true
          exprs)
        (tc-comptime-purity-error expr-bases expr chain "unsafe" "unsafe block"))]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match scrut arms)
          (let
            [_
              (try
                (tc-comptime-purity-node-mode
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view bound)
                  (tc-global-shared-view chain)
                  (tc-global-shared-view seen)
                  template?
                  scrut))]
            (tc-comptime-purity-match-arms-mode
              ctx
              expr-bases
              env
              bound
              chain
              seen
              template?
              arms))])]
    [(Foreach fe-box)
      (match (__tl-box-place fe-box)
        [(Foreach index _ start end body)
          (let
            [_
              (try
                (tc-comptime-purity-node2-mode
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view bound)
                  (tc-global-shared-view chain)
                  (tc-global-shared-view seen)
                  template?
                  start
                  end))]
            (tc-comptime-purity-node-mode
              ctx
              expr-bases
              env
              (tc-comptime-purity-template-bound template? bound index)
              chain
              seen
              template?
              body))]
        [(Foreach2 outer _ a b inner _ c d body)
          (let
            [_
              (try
                (tc-comptime-purity-node2-mode
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view bound)
                  (tc-global-shared-view chain)
                  (tc-global-shared-view seen)
                  template?
                  a
                  b))]
            (let
              [_
                (try
                  (tc-comptime-purity-node2-mode
                    ctx
                    expr-bases
                    env
                    (tc-global-shared-view bound)
                    (tc-global-shared-view chain)
                    (tc-global-shared-view seen)
                    template?
                    c
                    d))]
              (tc-comptime-purity-node-mode
                ctx
                expr-bases
                env
                (tc-comptime-purity-template-bound
                  template?
                  (tc-comptime-purity-template-bound template? bound outer)
                  inner)
                chain
                seen
                template?
                body)))])]
    [(SpmdReduce reduce-box)
      (match (__tl-box-place reduce-box)
        [(Reduce _ index _ start end init value)
          (let
            [_
              (try
                (tc-comptime-purity-node3-mode
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view bound)
                  (tc-global-shared-view chain)
                  (tc-global-shared-view seen)
                  template?
                  start
                  end
                  init))]
            (tc-comptime-purity-node-mode
              ctx
              expr-bases
              env
              (tc-comptime-purity-template-bound template? bound index)
              chain
              seen
              template?
              value))])]
    [(SpmdScan scan-box)
      (match (__tl-box-place scan-box)
        [(Scan _ index _ start end prefix _ init value body)
          (let
            [_
              (try
                (tc-comptime-purity-node3-mode
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view bound)
                  (tc-global-shared-view chain)
                  (tc-global-shared-view seen)
                  template?
                  start
                  end
                  init))]
            (let
              [index-bound : TcStringList
                (tc-comptime-purity-template-bound template? bound index)]
              [_
                (try
                  (tc-comptime-purity-node-mode
                    ctx
                    expr-bases
                    env
                    (tc-global-shared-view index-bound)
                    (tc-global-shared-view chain)
                    (tc-global-shared-view seen)
                    template?
                    value))]
              (tc-comptime-purity-node-mode
                ctx
                expr-bases
                env
                (tc-comptime-purity-template-bound template? index-bound prefix)
                chain
                seen
                template?
                body)))])]
    [(SpmdCompact compact-box)
      (match (__tl-box-place compact-box)
        [(Compact index _ start end slot _ init keep body)
          (let
            [_
              (try
                (tc-comptime-purity-node3-mode
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view bound)
                  (tc-global-shared-view chain)
                  (tc-global-shared-view seen)
                  template?
                  start
                  end
                  init))]
            (let
              [index-bound : TcStringList
                (tc-comptime-purity-template-bound template? bound index)]
              [_
                (try
                  (tc-comptime-purity-node-mode
                    ctx
                    expr-bases
                    env
                    (tc-global-shared-view index-bound)
                    (tc-global-shared-view chain)
                    (tc-global-shared-view seen)
                    template?
                    keep))]
              (tc-comptime-purity-node-mode
                ctx
                expr-bases
                env
                (tc-comptime-purity-template-bound template? index-bound slot)
                chain
                seen
                template?
                body)))])]
    [(WithResource wr-box)
      (match (__tl-box-place wr-box)
        [(WithResource bindings body)
          (let
            [body-bound
              (try
                (tc-comptime-purity-resource-bindings-mode
                  ctx
                  expr-bases
                  env
                  bound
                  (tc-global-shared-view chain)
                  (tc-global-shared-view seen)
                  template?
                  bindings))]
            (tc-comptime-purity-expr-list-mode
              ctx
              expr-bases
              env
              body-bound
              chain
              seen
              template?
              body))])]
    [(Quote _) Ok]
    [(Quasiquote inner)
      (tc-comptime-purity-node-mode
        ctx
        expr-bases
        env
        bound
        chain
        seen
        true
        inner)]
    [(or (Unquote inner) (UnquoteSplicing inner))
      (tc-comptime-purity-node-mode
        ctx
        expr-bases
        env
        bound
        chain
        seen
        false
        inner)]
    [(PtrNull _)
      (tc-comptime-purity-reject-or-template-ok
        expr-bases
        expr
        chain
        template?
        "ptr-null"
        "raw pointer operation")]
    [(PtrNullCheck inner)
      (tc-comptime-purity-reject-or-template-node
        ctx
        expr-bases
        env
        bound
        chain
        seen
        template?
        expr
        "ptr-null?"
        "raw pointer operation"
        inner)]
    [(PtrAddrOf place)
      (tc-comptime-purity-reject-or-template-node
        ctx
        expr-bases
        env
        bound
        chain
        seen
        template?
        expr
        "ptr-addr-of"
        "raw pointer operation"
        place)]
    [(PtrRead ptr)
      (tc-comptime-purity-reject-or-template-node
        ctx
        expr-bases
        env
        bound
        chain
        seen
        template?
        expr
        "ptr-read"
        "raw pointer operation"
        ptr)]
    [(PtrWrite ptr value)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        expr-bases
        env
        bound
        chain
        seen
        template?
        expr
        "ptr-write!"
        "raw pointer operation"
        ptr
        value)]
    [(PtrOffset ptr offset)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        expr-bases
        env
        bound
        chain
        seen
        template?
        expr
        "ptr-offset"
        "raw pointer operation"
        ptr
        offset)]
    [(PtrCast ptr _)
      (tc-comptime-purity-reject-or-template-node
        ctx
        expr-bases
        env
        bound
        chain
        seen
        template?
        expr
        "ptr-cast"
        "raw pointer operation"
        ptr)]
    [(PtrToInt ptr)
      (tc-comptime-purity-reject-or-template-node
        ctx
        expr-bases
        env
        bound
        chain
        seen
        template?
        expr
        "ptr->int"
        "raw pointer operation"
        ptr)]
    [(IntToPtr value _)
      (tc-comptime-purity-reject-or-template-node
        ctx
        expr-bases
        env
        bound
        chain
        seen
        template?
        expr
        "int->ptr"
        "raw pointer operation"
        value)]
    [(StringData str)
      (tc-comptime-purity-reject-or-template-node
        ctx
        expr-bases
        env
        bound
        chain
        seen
        template?
        expr
        "string-data"
        "unsafe FFI bridge"
        str)]
    [(StringFromBytes ptr len)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        expr-bases
        env
        bound
        chain
        seen
        template?
        expr
        "string-from-bytes"
        "unsafe FFI bridge"
        ptr
        len)]
    [(ArrayData array)
      (tc-comptime-purity-reject-or-template-node
        ctx
        expr-bases
        env
        bound
        chain
        seen
        template?
        expr
        "__tl_array-data"
        "unsafe FFI bridge"
        array)]
    [(ProgramArgc)
      (tc-comptime-purity-reject-or-template-ok
        expr-bases
        expr
        chain
        template?
        "program-argc"
        "runtime process state")]
    [(ProgramArgv)
      (tc-comptime-purity-reject-or-template-ok
        expr-bases
        expr
        chain
        template?
        "program-argv"
        "runtime process state")]
    [(ProgramEnvp)
      (tc-comptime-purity-reject-or-template-ok
        expr-bases
        expr
        chain
        template?
        "program-envp"
        "runtime process state")]
    [(or (CpuIdEax leaf subleaf) (CpuIdEbx leaf subleaf) (CpuIdEcx leaf subleaf)
         (CpuIdEdx leaf subleaf))
      (tc-comptime-purity-reject-or-template-node2
        ctx
        expr-bases
        env
        bound
        chain
        seen
        template?
        expr
        "cpuid"
        "host CPU query"
        leaf
        subleaf)]
    [(Xgetbv index)
      (tc-comptime-purity-reject-or-template-node
        ctx
        expr-bases
        env
        bound
        chain
        seen
        template?
        expr
        "xgetbv"
        "host CPU query"
        index)]
    [(Syscall args)
      (if template?
        (tc-comptime-purity-expr-list-mode
          ctx
          expr-bases
          env
          bound
          chain
          seen
          true
          args)
        (tc-comptime-purity-error
          expr-bases
          expr
          chain
          "syscall"
          "host syscall"))]
    [(ForeachActive lane body)
      (tc-comptime-purity-node-mode
        ctx
        expr-bases
        env
        (tc-comptime-purity-template-bound template? bound lane)
        chain
        seen
        template?
        body)]
    [_
      (tc-comptime-purity-expr-list-mode
        ctx
        expr-bases
        env
        bound
        chain
        seen
        template?
        (ast.ast-expr-child-ids expr))]))

(define (tc-comptime-purity-var
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [expr : ast.AstExpr]
  [name-id : i64]) : ResultTcUnit
  (let
    [name : String
      (tc-hygiene-name-text-id-for-session
        (tc-context-structural-session ctx)
        name-id)]
    (cond
      [(tc-string-list-contains
          (tc-global-shared-view bound)
          (tc-global-shared-view name))
        Ok]
      [(tc-comptime-purity-banned-qualified? ctx name name-id)
        (tc-comptime-purity-error
          expr-bases
          expr
          chain
          (tc-global-shared-view name)
          (str_cat.str-cat
            "import from module "
            (tc-qualified-name-module name)))]
      [(tc-comptime-purity-ctfe-builtin?
          (tc-context-structural-session ctx)
          (tc-global-shared-view name)
          name-id)
        Ok]
      [else
        (match (tc-lookup-unsafe-id env name-id)
          [(Ok _ unsafe?)
            (if unsafe?
              (tc-comptime-purity-error
                expr-bases
                expr
                chain
                (tc-global-shared-view name)
                (str_cat.str-cat "unsafe declaration " name))
              (tc-comptime-purity-var-handle
                ctx
                expr-bases
                env
                bound
                chain
                seen
                expr
                name-id))]
          [(Err _)
            (tc-comptime-purity-var-handle
              ctx
              expr-bases
              env
              bound
              chain
              seen
              expr
              name-id)])])))

(define (tc-comptime-purity-var-handle
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [expr : ast.AstExpr]
  [name-id : i64]) : ResultTcUnit
  (let
    [source-id : i64
      (macro-hygiene-global-source-name-id-or
        (tc-context-structural-session ctx)
        name-id
        name-id)]
    [module-id : i64
      (if (macro-hygiene-global-id? (tc-context-structural-session ctx) name-id)
        (macro-hygiene-global-module-id
          (tc-context-structural-session ctx)
          name-id)
        (tc-context-module-id ctx))]
    [handle : i64
      (csym.compiler-symbols-lookup-value-in-module-id-or
        (tc-context-symbols ctx)
        module-id
        source-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (let
        [name : String (ci.intern-str source-id)]
        [kind : i64 (csym.compiler-symbol-handle-kind handle)]
        (cond
          [(= kind (csym.compiler-symbol-kind-extern))
            (tc-comptime-purity-error
              expr-bases
              expr
              chain
              (tc-global-shared-view name)
              (str_cat.str-cat "extern reference " name))]
          [(= kind (csym.compiler-symbol-kind-defdispatch))
            (tc-comptime-purity-error
              expr-bases
              expr
              chain
              (tc-global-shared-view name)
              (str_cat.str-cat "runtime dispatch reference " name))]
          [(or
              (= kind (csym.compiler-symbol-kind-value-define))
              (= kind (csym.compiler-symbol-kind-function-define)))
            (tc-comptime-purity-handle-decl
              ctx
              expr-bases
              env
              bound
              chain
              seen
              expr
              name
              handle)]
          [else Ok]))
      Ok)))

(define (tc-comptime-purity-handle-decl
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [_bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [_expr : ast.AstExpr]
  [name : String]
  [handle : i64]) : ResultTcUnit
  (if (tc-string-list-contains
    (tc-global-shared-view seen)
    (tc-global-shared-view name))
    Ok
    (let
      [index : i64 (csym.compiler-symbol-handle-index handle)]
      [decls : (__tl_dyn-array ast.AstDecl)
        (csym.compiler-symbols-decls (tc-context-symbols ctx))]
      (if (or (< index 0) (>= index (array-length decls)))
        Ok
        (tc-comptime-purity-decl
          ctx
          expr-bases
          env
          (tc-comptime-purity-chain-push chain (tc-global-shared-view name))
          (tc-string-list-add seen name)
          (tc-global-array-element-shared-view decls index))))))

(define (tc-comptime-purity-decl
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [chain : TcStringList]
  [seen : TcStringList]
  [decl : ast.AstDecl]) : ResultTcUnit
  (match decl
    [(Def decl-meta _ _ expr-box)
      (let
        [expr : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases expr-box)]
        (tc-comptime-purity-expr ctx expr-bases env Nil chain seen expr))]
    [(DefFn decl-meta _ params _ body-box _)
      (let
        [body : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases body-box)]
        (tc-comptime-purity-expr
          ctx
          expr-bases
          env
          (tc-param-bound-names params)
          chain
          seen
          body))]
    [(DefMacro decl-meta _ _ _ _) Ok]
    [(Extern decl-meta name _ _ _)
      (tc-comptime-purity-error
        expr-bases
        (Var name)
        chain
        (tc-env-key-name-text name)
        (str_cat.str-cat "extern reference " (tc-env-key-name-text name)))]
    [(DefDispatch decl-meta name _)
      (tc-comptime-purity-error
        expr-bases
        (Var name)
        chain
        (tc-env-key-name-text name)
        (str_cat.str-cat
          "runtime dispatch reference "
          (tc-env-key-name-text name)))]
    [(Unsafe _)
      (Err
        (str_cat.str-cat
          "typecheck: comptime purity rejects unsafe declaration; reference path: "
          (tc-comptime-purity-chain-render chain)))]
    [_ Ok]))

(define (tc-check-defmacro-purity
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [name : i64]
  [params : ast.AstMacroParamList]
  [body : ast.AstExpr]) : ResultTcUnit
  (tc-comptime-purity-expr
    ctx
    expr-bases
    env
    (tc-macro-param-bound-names params)
    (tc-comptime-purity-chain-push Nil (tc-env-key-name-text name))
    (tc-string-list-add Nil (tc-env-key-name-text name))
    body))

;; The ordinary comptime-purity walk already models executable macro syntax,
;; including quote/unquote and lexical shadowing.  Reuse that walk while a
;; small abstract-kind state is active instead of maintaining a second large
;; recursive visitor.  Typechecking is single-threaded, and every scoped state
;; mutation below is restored before returning.
(defstruct TcMacroAbstractState
  (active bool)
  (macro-name String)
  (param-name String)
  (kind-mask i64)
  (cleanup-owning-mask i64))

(defenum TcMacroAbstractGuard
  (No)
  (Kind String)
  (CleanupOwning))

;; Bit 0 means the abstract operand may not own cleanup; bit 1 means it may.
;; An empty mask represents an unreachable branch, matching the kind mask.
(defstruct TcMacroAbstractStateData
  (active bool)
  (macro-name String)
  (param-name String)
  (kind-mask i64)
  (cleanup-owning-mask i64))

(define (tc-macro-abstract-state-new) : TcMacroAbstractStateData
  (TcMacroAbstractStateData false "" "" 0 0))

(define (tc-macro-abstract-state-address-initialize [state : TcMacroState]) : i64
  (tc-macro-state-cell-initialize
    state
    TcMacroAbstractStateData
    tc-macro-state-slot-abstract
    (tc-macro-abstract-state-new)))

(define (tc-macro-abstract-state-address [state : TcMacroState]) : i64
  (tc-macro-state-address-fast
    state
    2
    tc-macro-abstract-state-address-initialize))

(define (tc-macro-abstract-state-ptr [state : TcMacroState]) : (MutPtr
    TcMacroAbstractStateData)
  (tc-state-cell-ptr
    (tc-macro-abstract-state-address state)
    TcMacroAbstractStateData))

(define (tc-macro-abstract-state-view [state : TcMacroState]) : (Ptr
    TcMacroAbstractStateData)
  (tc-state-cell-view
    (tc-macro-abstract-state-address state)
    TcMacroAbstractStateData))

(define (tc-macro-abstract-state-data [state : TcMacroState]) : TcMacroAbstractStateData
  (tc-state-cell-read
    (tc-macro-abstract-state-address state)
    TcMacroAbstractStateData))

(define (tc-macro-abstract-state-data-set!
  [state : TcMacroState]
  [data : TcMacroAbstractStateData]) : unit
  (tc-state-cell-write!
    (tc-macro-abstract-state-address state)
    TcMacroAbstractStateData
    data))

(define (tc-macro-abstract-state-save [state : TcMacroState]) : TcMacroAbstractState
  (let
    [data : (Ptr TcMacroAbstractStateData) (tc-macro-abstract-state-view state)]
    (unsafe
      (TcMacroAbstractState
        (deref data).active
        (deref data).macro-name
        (deref data).param-name
        (deref data).kind-mask
        (deref data).cleanup-owning-mask))))

(define (tc-macro-abstract-state-restore!
  [carrier : TcMacroState]
  [state : TcMacroAbstractState]) : unit
  (let
    [data : (MutPtr TcMacroAbstractStateData)
      (tc-macro-abstract-state-ptr carrier)]
    (unsafe
      (set! (deref data).active state.active)
      (set! (deref data).macro-name state.macro-name)
      (set! (deref data).param-name state.param-name)
      (set! (deref data).kind-mask state.kind-mask)
      (set! (deref data).cleanup-owning-mask state.cleanup-owning-mask))))

;; Generated identities are cache keys, not syntax IDs. Keep their compact IDs
;; in the macro job instead of interning them through whichever compatibility
;; table happens to be installed. The string comparison makes hash collisions
;; exact, and sequential IDs remain stable when the small table grows.
(defstruct TcMacroIdentityStateData
  (keys (__tl_dyn-array String))
  (slots (__tl_dyn-array i64))
  (capacity i64)
  (count i64)
  (owner-table-id i64)
  (owner-reset-generation i64)
  (ready bool))

(define (tc-macro-identity-state-new) : TcMacroIdentityStateData
  (TcMacroIdentityStateData
    (__tl_make-array String 0)
    (__tl_make-array i64 0)
    0
    0
    -1
    -1
    false))

(define (tc-macro-identity-state-address-initialize [state : TcMacroState]) : i64
  (tc-macro-state-cell-initialize
    state
    TcMacroIdentityStateData
    tc-macro-state-slot-identity
    (tc-macro-identity-state-new)))

(define (tc-macro-identity-state-address [state : TcMacroState]) : i64
  (tc-macro-state-address-fast
    state
    10
    tc-macro-identity-state-address-initialize))

(define (tc-macro-identity-state-ptr [state : TcMacroState]) : (MutPtr
    TcMacroIdentityStateData)
  (tc-state-cell-ptr
    (tc-macro-identity-state-address state)
    TcMacroIdentityStateData))

(define (tc-macro-identity-state-view [state : TcMacroState]) : (Ptr
    TcMacroIdentityStateData)
  (tc-state-cell-view
    (tc-macro-identity-state-address state)
    TcMacroIdentityStateData))

(define (tc-macro-identity-state-data [state : TcMacroState]) : TcMacroIdentityStateData
  (tc-state-cell-read
    (tc-macro-identity-state-address state)
    TcMacroIdentityStateData))

(define (tc-macro-identity-state-data-set!
  [state : TcMacroState]
  [data : TcMacroIdentityStateData]) : unit
  (tc-state-cell-write!
    (tc-macro-identity-state-address state)
    TcMacroIdentityStateData
    data))

(define (tc-macro-owner-text-copy [state : TcMacroState] [text : String]) : String
  (let
    [owner : i64 (tc-macro-state-owner-arena state)]
    (in-arena (arena.Arena owner) (string.copy (& text)))))

(define (tc-macro-identity-reset-for-state! [state : TcMacroState]) : unit
  (let
    [data : (MutPtr TcMacroIdentityStateData)
      (tc-macro-identity-state-ptr state)]
    (unsafe
      (set! (deref data).count 0)
      (set! (deref data).owner-table-id -1)
      (set! (deref data).owner-reset-generation -1)
      (set! (deref data).ready false))))

(define (tc-macro-identity-state-initialize! [state : TcMacroState]) : unit
  (let
    [table-id : i64 (tc-macro-state-source-name-table-id state)]
    [reset-generation : i64 (tc-macro-state-source-name-reset-generation state)]
    [data : (MutPtr TcMacroIdentityStateData)
      (tc-macro-identity-state-ptr state)]
    (unsafe
      (if (and
        (deref data).ready
        (= (deref data).owner-table-id table-id)
        (= (deref data).owner-reset-generation reset-generation))
        unit
        (let
          [owner : i64 (tc-macro-state-owner-arena state)]
          (in-arena
            (arena.Arena owner)
            (let
              [_allocate : unit
                (unless
                  (>= (deref data).capacity 16)
                  (set! (deref data).capacity 16)
                  (set!
                    (deref data).keys
                    (__tl_make-array String (deref data).capacity))
                  (set!
                    (deref data).slots
                    (__tl_make-array i64 (deref data).capacity)))]
              [index : i64 0]
              (while (< index (deref data).capacity)
                (set! (array-ref (deref data).slots index) 0)
                (set! index (+ index 1)))
              (set! (deref data).count 0)
              (set! (deref data).owner-table-id table-id)
              (set! (deref data).owner-reset-generation reset-generation)
              (set! (deref data).ready true))))))))

(define (tc-macro-identity-rehash-one!
  [keys-address : u64]
  [slots : (&mut slots (__tl_dyn-array i64))]
  [capacity : i64]
  [id : i64]) : unit
  (let
    [key : String
      (unsafe
        (ptr-read
          (ptr-offset
            (int->ptr
              (ptr-read (int->ptr keys-address : (Ptr u64)))
              : (Ptr String))
            id)))]
    [cursor : i64 (bit-and (ci.intern-hash key) (- capacity 1))]
    (while (> (array-ref slots cursor) 0)
      (set! cursor (bit-and (+ cursor 1) (- capacity 1))))
    (set! (array-ref slots cursor) (+ id 1))))

(define (tc-macro-identity-state-grow! [state : TcMacroState]) : unit
  (let
    [data : TcMacroIdentityStateData (tc-macro-identity-state-data state)]
    [next-capacity : i64 (* data.capacity 2)]
    [owner : i64 (tc-macro-state-owner-arena state)]
    (in-arena
      (arena.Arena owner)
      (let
        [next-keys : (__tl_dyn-array String)
          (__tl_make-array String next-capacity)]
        [next-slots : (__tl_dyn-array i64) (__tl_make-array i64 next-capacity)]
        [index : i64 0]
        (while (< index data.count)
          (set! (array-ref next-keys index) (array-ref data.keys index))
          (tc-macro-identity-rehash-one!
            (tc-array-address next-keys)
            (&mut next-slots)
            next-capacity
            index)
          (set! index (+ index 1)))
        (set! data.keys next-keys)
        (set! data.slots next-slots)
        (set! data.capacity next-capacity)
        (tc-macro-identity-state-data-set! state data)))))

(define (tc-macro-identity-lookup-for-state
  [state : TcMacroState]
  [name : String]) : i64
  (tc-macro-identity-state-initialize! state)
  (let
    [data : TcMacroIdentityStateData (tc-macro-identity-state-data state)]
    [cursor : i64 (bit-and (ci.intern-hash name) (- data.capacity 1))]
    [steps : i64 0]
    [out : i64 -1]
    [done : bool false]
    (while (and (not done) (< steps data.capacity))
      (let
        [slot : i64 (array-ref data.slots cursor)]
        (if (= slot 0)
          (set! done true)
          (let
            [id : i64 (- slot 1)]
            (if (string.eq (array-ref data.keys id) name)
              (begin
                (set! out id)
                (set! done true))
              (begin
                (set! cursor (bit-and (+ cursor 1) (- data.capacity 1)))
                (set! steps (+ steps 1))))))))
    out))

(define (tc-macro-identity-intern-for-state
  [state : TcMacroState]
  [name : String]) : i64
  (let
    [existing : i64
      (tc-macro-identity-lookup-for-state state (tc-global-shared-view name))]
    (if (>= existing 0)
      existing
      (begin
        (let
          [data-before : (Ptr TcMacroIdentityStateData)
            (tc-macro-identity-state-view state)]
          (unsafe
            (if (>=
              (* (+ (deref data-before).count 1) 2)
              (deref data-before).capacity)
              (tc-macro-identity-state-grow! state)
              unit)))
        (unsafe
          (let
            [data : (MutPtr TcMacroIdentityStateData)
              (tc-macro-identity-state-ptr state)]
            [id : i64 (deref data).count]
            [cursor : i64
              (bit-and (ci.intern-hash name) (- (deref data).capacity 1))]
            (while (> (array-ref (deref data).slots cursor) 0)
              (set! cursor (bit-and (+ cursor 1) (- (deref data).capacity 1))))
            (set!
              (array-ref (deref data).keys id)
              (tc-macro-owner-text-copy state name))
            (set! (array-ref (deref data).slots cursor) (+ id 1))
            (set! (deref data).count (+ (deref data).count 1))
            id))))))

(define (tc-macro-abstract-call-id
  [expr-bases : i64]
  [session : cis.InternStructuralSessionHandle]
  [func : ast.AstExpr]
  [bound : TcStringList]) : i64
  (let
    [raw-id : i64 (tc-expr-var-name-id expr-bases func)]
    (if (or
      (< raw-id 0)
      (tc-string-list-contains
        bound
        (tc-hygiene-name-text-id-for-session session raw-id)))
      -1
      (ctfe_support.ctfe-comptime-helper-call-name-id
        (macro-hygiene-global-source-name-id-or session raw-id raw-id)))))

(define (tc-macro-abstract-arg
  [expr-bases : i64]
  [args : (& args ast.AstExprList)]
  [index : i64]) : ast.AstExpr
  (ast.ast-expr-segment-bases-get
    expr-bases
    (ast.ast-expr-list-get args index 0)))

(define (tc-macro-abstract-alias-marker [name : String]) : String
  (str_cat.str-cat " abstract type alias " name))

(define (tc-macro-abstract-bound-alias-at?
  [items : TcStringList]
  [name : String]
  [marker : String]) : bool
  (let
    [cursor : TcStringList items]
    [found : bool false]
    [done : bool false]
    (while (and (not done) (not (tc-string-list-empty? cursor)))
      (let
        [item : String (tc-string-list-head (tc-global-shared-view cursor))]
        (cond
          [(string.eq item marker)
            (set! found true)
            (set! done true)]
          [(string.eq item name) (set! done true)]
          [else unit])
        (set! cursor (tc-string-list-rest cursor))))
    found))

(define (tc-macro-abstract-bound-alias? [bound : TcStringList] [name : String]) : bool
  (tc-macro-abstract-bound-alias-at?
    bound
    (tc-global-shared-view name)
    (tc-macro-abstract-alias-marker name)))

(define (tc-macro-abstract-param-var?
  [expr-bases : i64]
  [state : TcMacroState]
  [expr : ast.AstExpr]
  [bound : TcStringList]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(Var name-id)
      (let
        [abstract : TcMacroAbstractStateData
          (tc-macro-abstract-state-data state)]
        [name : String
          (tc-hygiene-name-text-id-for-session
            (tc-macro-state-structural-session state)
            name-id)]
        (or
          (and
            (string.eq name abstract.param-name)
            (not
              (tc-string-list-contains
                (tc-global-shared-view bound)
                (tc-global-shared-view name))))
          (tc-macro-abstract-bound-alias? bound name)))]
    [_ false]))

(define (tc-macro-abstract-cleanup-owning-call?
  [state : TcMacroState]
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [bound : TcStringList]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(Call func args)
      (and
        (=
          (tc-macro-abstract-call-id
            expr-bases
            (tc-macro-state-structural-session state)
            (ast.ast-expr-segment-bases-get expr-bases func)
            (tc-global-shared-view bound))
          (cbi.compiler-builtin-ctfe "type-cleanup-owning?"))
        (= args.len 1)
        (tc-macro-abstract-param-var?
          expr-bases
          state
          (tc-macro-abstract-arg expr-bases (& args) 0)
          bound))]
    [_ false]))

(define (tc-macro-abstract-binding-bound
  [expr-bases : i64]
  [state : TcMacroState]
  [bound : TcStringList]
  [name-id : i64]
  [init : ast.AstExpr]
  [template? : bool]) : TcStringList
  (unsafe
    (let
      [abstract : (Ptr TcMacroAbstractStateData)
        (tc-macro-abstract-state-view state)]
      [next-bound : TcStringList
        (if (and (deref abstract).active (not template?))
          (tc-string-list-cons
            (tc-global-shared-view bound)
            (tc-env-key-name-text name-id))
          (tc-comptime-purity-template-bound
            template?
            (tc-global-shared-view bound)
            name-id))]
      (if (and
        (deref abstract).active
        (not template?)
        (tc-macro-abstract-param-var? expr-bases state init bound))
        (tc-string-list-cons
          next-bound
          (tc-macro-abstract-alias-marker (tc-env-key-name-text name-id)))
        next-bound))))

(define (tc-macro-abstract-kind-bit [kind : String]) : i64
  (cond
    [(string.eq kind "i64") (shl 1 0)]
    [(string.eq kind "i32") (shl 1 1)]
    [(string.eq kind "i16") (shl 1 2)]
    [(string.eq kind "i8") (shl 1 3)]
    [(string.eq kind "u64") (shl 1 4)]
    [(string.eq kind "u32") (shl 1 5)]
    [(string.eq kind "u16") (shl 1 6)]
    [(string.eq kind "u8") (shl 1 7)]
    [(string.eq kind "f64") (shl 1 8)]
    [(string.eq kind "f32") (shl 1 9)]
    [(string.eq kind "bool") (shl 1 10)]
    [(string.eq kind "char") (shl 1 11)]
    [(string.eq kind "string") (shl 1 12)]
    [(string.eq kind "unit") (shl 1 13)]
    [(string.eq kind "never") (shl 1 14)]
    [(string.eq kind "array") (shl 1 15)]
    [(string.eq kind "dyn-array") (shl 1 16)]
    [(string.eq kind "function") (shl 1 17)]
    [(string.eq kind "tuple") (shl 1 18)]
    [(string.eq kind "struct") (shl 1 19)]
    [(string.eq kind "enum") (shl 1 20)]
    [(string.eq kind "str") (shl 1 21)]
    [(string.eq kind "ptr") (shl 1 22)]
    [(string.eq kind "mut-ptr") (shl 1 23)]
    [(string.eq kind "ref") (shl 1 24)]
    [(string.eq kind "mut-ref") (shl 1 25)]
    [(string.eq kind "region") (shl 1 26)]
    [(string.eq kind "type-var") (shl 1 27)]
    [(string.eq kind "box") (shl 1 28)]
    [(string.eq kind "c-function") (shl 1 30)]
    [(string.eq kind "invalidate") (shl 1 31)]
    [else (shl 1 29)]))

(define (tc-macro-abstract-kind-list-mask-from
  [kinds : (& kinds ast.AstMacroTypeKindList)]
  [index : i64]) : i64
  (if (>= index (ast.ast-macro-type-kind-list-len kinds))
    0
    (bit-or
      (tc-macro-abstract-kind-bit
        (ci.intern-str (ast.ast-macro-type-kind-list-get kinds index 0)))
      (tc-macro-abstract-kind-list-mask-from kinds (+ index 1)))))

(define (tc-macro-abstract-kind-list-mask
  [kinds : (& kinds ast.AstMacroTypeKindList)]) : i64
  (tc-macro-abstract-kind-list-mask-from kinds 0))

(define (tc-macro-abstract-mask-allows? [state : TcMacroState] [allowed : i64]) : bool
  (=
    (bit-and
      (unsafe
        (deref (tc-macro-abstract-state-view state)).kind-mask)
      (bit-xor allowed -1))
    0))

(define (tc-macro-abstract-reflection-supported?
  [state : TcMacroState]
  [call-id : i64]) : bool
  (cond
    [(or
        (= call-id (cbi.compiler-builtin-ctfe "type-info"))
        (= call-id (cbi.compiler-builtin-ctfe "type-kind"))
        (= call-id (cbi.compiler-builtin-ctfe "type-key"))
        (= call-id (cbi.compiler-builtin-ctfe "type-cleanup-owning?"))
        (= call-id (cbi.compiler-builtin-ctfe "type-expr"))
        (= call-id (cbi.compiler-builtin-ctfe "type-declared-align")))
      true]
    [(or
        (= call-id (cbi.compiler-builtin-ctfe "type-nominal-module"))
        (= call-id (cbi.compiler-builtin-ctfe "type-nominal-name")))
      (tc-macro-abstract-mask-allows? state (bit-or (shl 1 19) (shl 1 20)))]
    [(or
        (= call-id (cbi.compiler-builtin-ctfe "offset-of"))
        (= call-id (cbi.compiler-builtin-ctfe "struct-field-count"))
        (= call-id (cbi.compiler-builtin-ctfe "struct-field-name"))
        (= call-id (cbi.compiler-builtin-ctfe "struct-field-type"))
        (= call-id (cbi.compiler-builtin-ctfe "struct-field-declared-align")))
      (tc-macro-abstract-mask-allows? state (shl 1 19))]
    [(or
        (= call-id (cbi.compiler-builtin-ctfe "enum-variant-count"))
        (= call-id (cbi.compiler-builtin-ctfe "enum-variant-name"))
        (= call-id (cbi.compiler-builtin-ctfe "enum-variant-payload-count"))
        (= call-id (cbi.compiler-builtin-ctfe "enum-variant-payload-type")))
      (tc-macro-abstract-mask-allows? state (shl 1 20))]
    [(or
        (= call-id (cbi.compiler-builtin-ctfe "array-element-type"))
        (= call-id (cbi.compiler-builtin-ctfe "array-dynamic?")))
      (tc-macro-abstract-mask-allows? state (bit-or (shl 1 15) (shl 1 16)))]
    [(= call-id (cbi.compiler-builtin-ctfe "box-element-type"))
      (tc-macro-abstract-mask-allows? state (shl 1 28))]
    [(= call-id (cbi.compiler-builtin-ctfe "reference-element-type"))
      (tc-macro-abstract-mask-allows? state (bit-or (shl 1 24) (shl 1 25)))]
    [(or
        (= call-id (cbi.compiler-builtin-ctfe "tuple-element-count"))
        (= call-id (cbi.compiler-builtin-ctfe "tuple-element-type")))
      (tc-macro-abstract-mask-allows? state (shl 1 18))]
    [(or
        (= call-id (cbi.compiler-builtin-ctfe "function-param-count"))
        (= call-id (cbi.compiler-builtin-ctfe "function-param-type"))
        (= call-id (cbi.compiler-builtin-ctfe "function-return-type")))
      (tc-macro-abstract-mask-allows? state (shl 1 17))]
    ;; Kind `array` does not imply a fixed length.
    [(= call-id (cbi.compiler-builtin-ctfe "array-length")) false]
    ;; No kind proves cleanup ownership, but the true branch of the exact
    ;; `type-cleanup-owning?` predicate does.
    [(= call-id (cbi.compiler-builtin-ctfe "type-cleanup-function"))
      (=
        (bit-and
          (unsafe
            (deref (tc-macro-abstract-state-view state)).cleanup-owning-mask)
          1)
        0)]
    [else false]))

(define (tc-macro-abstract-required [call-id : i64]) : String
  (cond
    [(or
        (= call-id (cbi.compiler-builtin-ctfe "type-nominal-module"))
        (= call-id (cbi.compiler-builtin-ctfe "type-nominal-name")))
      "struct or enum"]
    [(or
        (= call-id (cbi.compiler-builtin-ctfe "offset-of"))
        (= call-id (cbi.compiler-builtin-ctfe "struct-field-count"))
        (= call-id (cbi.compiler-builtin-ctfe "struct-field-name"))
        (= call-id (cbi.compiler-builtin-ctfe "struct-field-type"))
        (= call-id (cbi.compiler-builtin-ctfe "struct-field-declared-align")))
      "struct"]
    [(or
        (= call-id (cbi.compiler-builtin-ctfe "enum-variant-count"))
        (= call-id (cbi.compiler-builtin-ctfe "enum-variant-name"))
        (= call-id (cbi.compiler-builtin-ctfe "enum-variant-payload-count"))
        (= call-id (cbi.compiler-builtin-ctfe "enum-variant-payload-type")))
      "enum"]
    [(or
        (= call-id (cbi.compiler-builtin-ctfe "array-element-type"))
        (= call-id (cbi.compiler-builtin-ctfe "array-dynamic?")))
      "array"]
    [(= call-id (cbi.compiler-builtin-ctfe "array-length")) "fixed array shape"]
    [(= call-id (cbi.compiler-builtin-ctfe "box-element-type")) "box"]
    [(= call-id (cbi.compiler-builtin-ctfe "reference-element-type"))
      "reference"]
    [(or
        (= call-id (cbi.compiler-builtin-ctfe "tuple-element-count"))
        (= call-id (cbi.compiler-builtin-ctfe "tuple-element-type")))
      "tuple"]
    [(or
        (= call-id (cbi.compiler-builtin-ctfe "function-param-count"))
        (= call-id (cbi.compiler-builtin-ctfe "function-param-type"))
        (= call-id (cbi.compiler-builtin-ctfe "function-return-type")))
      "function"]
    [(= call-id (cbi.compiler-builtin-ctfe "type-cleanup-function"))
      "cleanup-owning type"]
    [else "a stronger type-kind bound"]))

(define (tc-macro-abstract-check-current-call
  [state : TcMacroState]
  [expr-bases : i64]
  [bound : TcStringList]
  [template? : bool]
  [expr : ast.AstExpr]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcUnit
  (let
    [abstract : (Ptr TcMacroAbstractStateData)
      (tc-macro-abstract-state-view state)]
    (if (or
      (not
        (unsafe
          (deref abstract).active))
      template?
      (= args.len 0))
      Ok
      (let
        [call-id : i64
          (tc-macro-abstract-call-id
            expr-bases
            (tc-macro-state-structural-session state)
            (tc-global-shared-view func)
            (tc-global-shared-view bound))]
        (if (and
          (or
            (ctfe_support.ctfe-builtin-reflection-id? call-id)
            (ctfe_support.ctfe-builtin-offset-of-id? call-id))
          (tc-macro-abstract-param-var?
            expr-bases
            state
            (tc-macro-abstract-arg expr-bases (& args) 0)
            bound)
          (not (tc-macro-abstract-reflection-supported? state call-id)))
          (let
            [name-id : i64 (tc-expr-var-name-id expr-bases func)]
            [call-name : String
              (if (< name-id 0)
                "reflection operation"
                (tc-hygiene-name-text-id-for-session
                  (tc-macro-state-structural-session state)
                  name-id))]
            [text : String
              (str_cat.str-cat
                "typecheck: macro "
                (tc-name-slashes-to-dots
                  (unsafe
                    (deref abstract).macro-name))
                " constrained type operand "
                (unsafe
                  (deref abstract).param-name)
                " cannot use "
                call-name
                "; requires "
                (tc-macro-abstract-required call-id))]
            (Err
              (tc-locate-error-at-expr
                expr-bases
                expr
                (if (=
                  call-id
                  (cbi.compiler-builtin-ctfe "type-cleanup-function"))
                  (tc-kind-message (ResourceOwnership) text)
                  text))))
          Ok)))))

(define (tc-macro-abstract-kind-literal [expr-bases : i64] [expr : ast.AstExpr]) : TcMacroAbstractGuard
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(Literal (String string-id)) (Kind (ci.intern-str string-id))]
    [_ No]))

(define (tc-macro-abstract-type-kind-param?
  [state : TcMacroState]
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [bound : TcStringList]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(Call func args)
      (and
        (=
          (tc-macro-abstract-call-id
            expr-bases
            (tc-macro-state-structural-session state)
            (ast.ast-expr-segment-bases-get expr-bases func)
            (tc-global-shared-view bound))
          (cbi.compiler-builtin-ctfe "type-kind"))
        (= args.len 1)
        (tc-macro-abstract-param-var?
          expr-bases
          state
          (tc-macro-abstract-arg expr-bases (& args) 0)
          bound))]
    [_ false]))

(define (tc-macro-abstract-kind-equality
  [state : TcMacroState]
  [expr-bases : i64]
  [left : ast.AstExpr]
  [right : ast.AstExpr]
  [bound : TcStringList]) : TcMacroAbstractGuard
  (if (tc-macro-abstract-type-kind-param?
    state
    expr-bases
    (tc-global-shared-view left)
    (tc-global-shared-view bound))
    (tc-macro-abstract-kind-literal expr-bases right)
    (if (tc-macro-abstract-type-kind-param? state expr-bases right bound)
      (tc-macro-abstract-kind-literal expr-bases left)
      No)))

(define (tc-macro-abstract-guard
  [state : TcMacroState]
  [expr-bases : i64]
  [cond-expr : ast.AstExpr]
  [bound : TcStringList]) : TcMacroAbstractGuard
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& cond-expr))
    [(Binary (Eq) left right)
      (tc-macro-abstract-kind-equality
        state
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases left)
        (ast.ast-expr-segment-bases-get expr-bases right)
        bound)]
    [(Call func args)
      (let
        [raw-id : i64
          (tc-expr-var-name-id
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases func))]
        (if (tc-macro-abstract-cleanup-owning-call?
          state
          expr-bases
          cond-expr
          (tc-global-shared-view bound))
          CleanupOwning
          (if (and
            (= args.len 2)
            (>= raw-id 0)
            (ctfe_support.ctfe-string-eq-helper-name-id?
              (tc-hygiene-name-text-id-for-session
                (tc-macro-state-structural-session state)
                raw-id)
              (macro-hygiene-global-source-name-id-or
                (tc-macro-state-structural-session state)
                raw-id
                raw-id)))
            (tc-macro-abstract-kind-equality
              state
              expr-bases
              (tc-macro-abstract-arg expr-bases (& args) 0)
              (tc-macro-abstract-arg expr-bases (& args) 1)
              bound)
            No)))]
    [_ No]))

(define (tc-macro-abstract-purity-node-with-mask
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [kind-mask : i64]
  [expr-id : i64]) : ResultTcUnit
  (let
    [state : TcMacroState (tc-context-macro-state ctx)]
    [abstract : TcMacroAbstractStateData (tc-macro-abstract-state-data state)]
    [saved : i64 abstract.kind-mask]
    (set! abstract.kind-mask kind-mask)
    (tc-macro-abstract-state-data-set! state (tc-global-shared-view abstract))
    (let
      [result : ResultTcUnit
        (tc-comptime-purity-node-mode
          ctx
          expr-bases
          env
          bound
          chain
          seen
          false
          expr-id)]
      (set! abstract.kind-mask saved)
      (tc-macro-abstract-state-data-set! state abstract)
      result)))

(define (tc-macro-abstract-purity-node-with-cleanup-mask
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [cleanup-owning-mask : i64]
  [expr-id : i64]) : ResultTcUnit
  (let
    [state : TcMacroState (tc-context-macro-state ctx)]
    [abstract : TcMacroAbstractStateData (tc-macro-abstract-state-data state)]
    [saved : i64 abstract.cleanup-owning-mask]
    (set! abstract.cleanup-owning-mask cleanup-owning-mask)
    (tc-macro-abstract-state-data-set! state (tc-global-shared-view abstract))
    (let
      [result : ResultTcUnit
        (tc-comptime-purity-node-mode
          ctx
          expr-bases
          env
          bound
          chain
          seen
          false
          expr-id)]
      (set! abstract.cleanup-owning-mask saved)
      (tc-macro-abstract-state-data-set! state abstract)
      result)))

(define (tc-comptime-purity-if-mode
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [cond-id : i64]
  [then-id : i64]
  [else-id : i64]) : ResultTcUnit
  (let
    [state : TcMacroState (tc-context-macro-state ctx)]
    [abstract : TcMacroAbstractStateData (tc-macro-abstract-state-data state)]
    (if (or (not abstract.active) template?)
      (tc-comptime-purity-node3-mode
        ctx
        expr-bases
        env
        bound
        chain
        seen
        template?
        cond-id
        then-id
        else-id)
      (let
        [_
          (try
            (tc-comptime-purity-node-mode
              ctx
              expr-bases
              env
              (tc-global-shared-view bound)
              (tc-global-shared-view chain)
              (tc-global-shared-view seen)
              false
              cond-id))]
        (match (tc-macro-abstract-guard
          state
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases cond-id)
          (tc-global-shared-view bound))
          [(No)
            (tc-comptime-purity-node2-mode
              ctx
              expr-bases
              env
              bound
              chain
              seen
              false
              then-id
              else-id)]
          [(Kind kind)
            (let
              [kind-bit : i64 (tc-macro-abstract-kind-bit kind)]
              [_
                (try
                  (tc-macro-abstract-purity-node-with-mask
                    ctx
                    expr-bases
                    env
                    (tc-global-shared-view bound)
                    (tc-global-shared-view chain)
                    (tc-global-shared-view seen)
                    (bit-and abstract.kind-mask kind-bit)
                    then-id))]
              (tc-macro-abstract-purity-node-with-mask
                ctx
                expr-bases
                env
                bound
                chain
                seen
                (bit-and abstract.kind-mask (bit-xor kind-bit -1))
                else-id))]
          [(CleanupOwning)
            (let
              [_
                (try
                  (tc-macro-abstract-purity-node-with-cleanup-mask
                    ctx
                    expr-bases
                    env
                    (tc-global-shared-view bound)
                    (tc-global-shared-view chain)
                    (tc-global-shared-view seen)
                    (bit-and abstract.cleanup-owning-mask 2)
                    then-id))]
              (tc-macro-abstract-purity-node-with-cleanup-mask
                ctx
                expr-bases
                env
                bound
                chain
                seen
                (bit-and abstract.cleanup-owning-mask 1)
                else-id))])))))

(define (tc-check-defmacro-abstract-param
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [macro-name : String]
  [param-name : String]
  [kinds : (& kinds ast.AstMacroTypeKindList)]
  [body : ast.AstExpr]) : ResultTcUnit
  (let
    [state : TcMacroState (tc-context-macro-state ctx)]
    [saved : TcMacroAbstractState (tc-macro-abstract-state-save state)]
    [abstract : (MutPtr TcMacroAbstractStateData)
      (tc-macro-abstract-state-ptr state)]
    (unsafe
      (set! (deref abstract).active true)
      (set! (deref abstract).macro-name (string.copy (& macro-name)))
      (set! (deref abstract).param-name (string.copy (& param-name)))
      (set! (deref abstract).kind-mask (tc-macro-abstract-kind-list-mask kinds))
      (set! (deref abstract).cleanup-owning-mask 3))
    (let
      [result : ResultTcUnit
        (tc-comptime-purity-expr
          ctx
          expr-bases
          env
          Nil
          (tc-comptime-purity-chain-push Nil (string.copy (& macro-name)))
          (tc-string-list-add Nil macro-name)
          body)]
      (tc-macro-abstract-state-restore! state saved)
      result)))

(define (tc-check-defmacro-abstract-type-params-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [macro-name : String]
  [params : (& params ast.AstMacroParamList)]
  [index : i64]
  [body : ast.AstExpr]) : ResultTcUnit
  (if (>= index (ast.ast-macro-param-list-len params))
    Ok
    (match (ast.ast-macro-param-list-get
      params
      index
      (ast.ast-macro-param-fallback))
      [(Param param-name ty _ type-kinds)
        (let
          [_
            (try
              (if (and
                (tc-macro-type-param-kind? ty)
                (not (ast.ast-macro-type-kind-list-empty? (& type-kinds))))
                (tc-check-defmacro-abstract-param
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view macro-name)
                  (tc-env-key-name-text param-name)
                  (& type-kinds)
                  (tc-global-shared-view body))
                ResultTcUnit.Ok))]
          (tc-check-defmacro-abstract-type-params-at
            ctx
            expr-bases
            env
            macro-name
            params
            (+ index 1)
            body))])))

(define (tc-check-defmacro-abstract-type-params
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [name : i64]
  [params : ast.AstMacroParamList]
  [body : ast.AstExpr]) : ResultTcUnit
  (tc-check-defmacro-abstract-type-params-at
    ctx
    expr-bases
    env
    (tc-env-key-name-text name)
    (& params)
    0
    body))

(define (tc-macro-param-list-needs-call-context?
  [params : (& params ast.AstMacroParamList)]) : bool
  (tc-macro-param-list-needs-call-context-at? (& params) 0))

(define (tc-macro-param-list-needs-call-context-at?
  [params : (& params ast.AstMacroParamList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-macro-param-list-len params))
    false
    (match (ast.ast-macro-param-list-get
      params
      index
      (ast.ast-macro-param-fallback))
      [(Param _ ty _ _)
        (if (or
          (tc-macro-type-param-kind? (tc-global-shared-view ty))
          (tc-macro-module-param-kind? ty))
          true
          (tc-macro-param-list-needs-call-context-at? params (+ index 1)))])))

(define (tc-check-comptime-decl-purity
  [ctx : TcContext]
  [env : TcTypeEnv]
  [template : ast.AstDecl]) : ResultTcUnit
  (tc-comptime-purity-decl
    ctx
    (tc-context-expr-bases ctx)
    env
    (tc-comptime-purity-chain-push Nil "comptime-decl")
    Nil
    template))

(define (tc-check-defmacro
  [name : i64]
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [params : ast.AstMacroParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]) : ResultTcUnit
  (let
    [expr-bases : i64 (tc-context-expr-bases ctx)]
    [macro-env : TcTypeEnv
      (tc-bind-macro-params
        ctx
        (tc-macro-helper-env-cached (tc-context-macro-state ctx) top-env)
        params)]
    [expr-result : ResultTcType
      (tc-expr ctx macro-env (tc-global-shared-view body))]
    [got (try expr-result)]
    [_
      (try
        (tc-check-defmacro-purity
          ctx
          expr-bases
          macro-env
          name
          (tc-global-shared-view params)
          (tc-global-shared-view body)))]
    (let
      [abstract-result : ResultTcUnit
        (tc-check-defmacro-abstract-type-params
          ctx
          expr-bases
          macro-env
          name
          (tc-global-shared-view params)
          (tc-global-shared-view body))]
      [_ (try abstract-result)]
      (let
        [_
          (try (tc-expect got (Expr) "typecheck: macro body must return Expr"))]
        [needs-context? : bool (tc-macro-param-list-needs-call-context? params)]
        [uses-expr-type? : bool
          (macro-expr-uses-expr-type?
            (tc-context-expr-bases ctx)
            (tc-global-shared-view body))]
        (if (or needs-context? uses-expr-type?)
          Ok
          (begin
            (tc-context-capture-active-pools! ctx)
            (let
              [base-definition-env : ctfe_support.CtfeEnv (tc-ctfe-env ctx)]
              [definition-env : ctfe_support.CtfeEnv
                (tc-ctfe-env-extend-macro-params ctx base-definition-env params)]
              [definition-result : ctfe_support.ResultCtfe
                (ctfe_support.compiler-ctfe-eval
                  body
                  definition-env
                  (ctfe_support.ctfe-fuel-limit))]
              ;; This probe runs the body on placeholder
              ;; operands (a `Var` per ordinary operand, empty
              ;; variadic lists), never on a caller's syntax, so
              ;; a failed run proves nothing about the macro:
              ;; its `comptime-error` or inspector rejection may
              ;; sit on the path real operands never take. Only
              ;; a completed run's produced type is checked here;
              ;; each expansion evaluates the real operands and
              ;; reports its own errors at the call.
              (tc-context-install-pools! ctx)
              (match definition-result
                [(Ok value _) (tc-check-defmacro-produced-type ctx ret value)]
                [(Err _) Ok]))))))))

;; --- whole-local move checker -----------------------------------------------
;;
;; Reject use-after-move for move-only whole locals/parameters in source
;; evaluation order. Copyable reads remain reusable; by-value move sites consume
;; every structurally move-only value, including closure environment captures.
;; Reads never move; branches
;; merge by union (a place moved on any arm is moved afterward). Loops reject
;; owner moves from values visible before the repeated body, then discard body
;; moves for the post-state because they may run zero times; lambdas still
;; discard their body's moves because they may be deferred. Reassigning a slot
;; with `set!` clears its moved mark. Owner-consuming struct fields, tuple
;; elements, and fixed-array literal elements are tracked as root paths so
;; unrelated entries remain usable. Nested direct-root struct/tuple/fixed-array
;; literal chains are represented by stable paths. Box and non-literal
;; aggregate projections stay rejected until their path/reinitialization policy
;; lands; dynamic arrays have a separate diagnostic because element ownership
;; cannot be made sound without an index policy.
(defstruct TcMovePathSegmentNode
  (parent i64)
  (kind i64)
  (value i64))

(defstruct TcMovePathSegmentStoreData
  (nodes (__tl_dyn-array TcMovePathSegmentNode))
  (len i64)
  (owner-arena i64))

(defstruct TcMovePathSegments
  ;; Empty roots carry address 0 and allocate nothing. The first projection
  ;; creates one stable store; every later append adds a dense tagged node whose
  ;; parent is the previous tail. Retained prefixes and siblings therefore share
  ;; immutable nodes without copying or per-segment boxes.
  (store-address i64)
  (tail i64)
  (len i64))

(defstruct TcMovePath
  (root i64)
  (segments TcMovePathSegments))

(defenum TcMovedPathKind
  (Move)
  (BorrowShared)
  (BorrowMut)
  (BorrowTwoPhaseMut)
  (BorrowLending i64)
  ;; Records that the lending binding has actually been evaluated. Existing
  ;; lexical compatibility keeps an otherwise-unused bound mutable reference
  ;; live; NLL shortening begins after a real source use.
  (BorrowLendingUsed i64)
  ;; A scoped liveness guard for a lending binding used after the expression
  ;; currently being checked. The scope id lets nested ordered walkers remove
  ;; only their own guard while preserving an outer pending-use horizon.
  (BorrowPending i64)
  ;; A direct local closure captures a value owned by this arena brand. This
  ;; checker-only fact lets destroy-safe! invalidate the closure binding even
  ;; though its source-level function type has no capture parameters.
  (OwnerDependency i64)
  ;; The cleanup obligation of an ordinary `let` owner rooted here left it
  ;; through an edge that discharges or transfers it (#6947). Its root is also
  ;; moved; a move without this fact lost the obligation.
  (ObligationDischarged))

(defstruct TcMovedPathFact
  (path TcMovePath)
  (kind TcMovedPathKind)
  (origin i64))

;; Moved-path facts are persistent snapshots over an append-only node store.
;; The singleton stays inline; larger snapshots carry only the stable store
;; address, their newest node, and their logical length.
(defstruct TcMovedPathFactNode
  (fact TcMovedPathFact)
  (parent i64))

(defstruct TcMovedPathFactStoreData
  (nodes (__tl_dyn-array TcMovedPathFactNode))
  (len i64)
  (owner-arena i64))

(defenum TcMovedPathFacts
  (Nil)
  (One TcMovedPathFact)
  (Dense (Box TcMovedPathFactStoreData) i64 i64))

(defenum TcMovedPathFactsRemove
  (Missing)
  (Removed TcMovedPathFacts))

(defenum TcMovedPathFactsFilter
  (Root i64)
  (Lending TcMovePath)
  (Pending i64))

(defstruct TcParamStorageOriginNode
  (name-id i64)
  (parameter-id i64)
  (parent i64))

(defstruct TcMovedSet
  (roots tc_i64_i64_map.Map)
  (partials tc_i64_i64_map.Map)
  (paths TcMovedPathFacts)
  (hidden-atomic-users tc_i64_i64_map.Map)
  ;; Persistent one-word head for the rare local aliases that still point into
  ;; a memory-class by-value parameter's ABI backing storage. Keeping this out
  ;; of the broad type environment avoids copying another hash-map value
  ;; through every move-check frame.
  (param-storage-origins i64))

(define (tc-moved-set-box-shared-view [value : (Box TcMovedSet)]) : TcMovedSet
  (let
    [address : i64
      (unsafe
        (ptr-read (ptr-cast (ptr-addr-of value) : (Ptr i64))))]
    (unsafe
      (ptr-read (int->ptr (cast address : u64) : (Ptr TcMovedSet))))))

(defenum TcMoveResult
  (Ok TcMovedSet)
  (Err String))

;; Bounded control-flow summary relative to one scalar loop. `normal` reaches
;; the expression's continuation, `repeat` reaches that loop's condition via
;; fallthrough/continue, `breaks` exits the loop, and `exit` leaves the
;; function. Nested loop controls are summarized by their enclosing loop before
;; returning here.
(defstruct TcMoveLoopFlow
  (normal bool)
  (repeat bool)
  (breaks bool)
  (exit bool))

;; Move states are only needed for paths that can continue after the current
;; expression or leave the current loop through `break`. Repeating paths are
;; checked against the loop-entry state, while function exits have no successor
;; in the current body.
(defenum TcMoveLoopResult
  (Ok bool (Box TcMovedSet) bool (Box TcMovedSet))
  (Err String))

;; The innermost open frame of `break` states collected for the loop walker
;; (#8575); `moved` is meaningful only once `seen`. See
;; `tc-body-move-breaks-swap!`.
(defstruct TcMoveBreakCollection
  (collecting bool)
  (seen bool)
  (moved TcMovedSet))

(define (tc-move-break-collection-new [collecting : bool]) : TcMoveBreakCollection
  (TcMoveBreakCollection collecting false (tc-moved-empty)))

(define (tc-move-break-collection-cell-new) : i64
  (let
    [cell : (__tl_dyn-array TcMoveBreakCollection)
      (__tl_make-array TcMoveBreakCollection 1)]
    (set! (array-ref cell 0) (tc-move-break-collection-new false))
    (cast
      (unsafe
        (ptr->int
          (ptr-cast (__tl_array-data cell) : (Ptr TcMoveBreakCollection))))
      : i64)))

;; The borrow checker's counterpart of TcMoveBreakCollection (#8671): the
;; innermost open frame of the borrow states at the `break`s and `continue`s
;; the non-loop walker reaches inside one loop-body form. Each state is
;; meaningful only once its flag is set. See `tc-body-borrow-exits-swap!`.
(defstruct TcBorrowLoopExits
  (collecting bool)
  (breaks bool)
  (break-borrowed TcMovedSet)
  (repeats bool)
  (repeat-borrowed TcMovedSet))

(define (tc-borrow-loop-exits-new [collecting : bool]) : TcBorrowLoopExits
  (TcBorrowLoopExits collecting false (tc-moved-empty) false (tc-moved-empty)))

(define (tc-borrow-loop-exits-cell-new) : i64
  (let
    [cell : (__tl_dyn-array TcBorrowLoopExits)
      (__tl_make-array TcBorrowLoopExits 1)]
    (set! (array-ref cell 0) (tc-borrow-loop-exits-new false))
    (cast
      (unsafe
        (ptr->int (ptr-cast (__tl_array-data cell) : (Ptr TcBorrowLoopExits))))
      : i64)))

(defenum TcMoveBindings
  (Ok TcTypeEnv TcMovedSet TcMovedSet TcMovedSet)
  (Err String))

(defstruct TcMoveCleanupOwner
  (name-id i64)
  (owner-origin-id i64)
  (move-aware bool))

;; One slot per resource binding, filled in binding order as the checked
;; recursion descends, so the exit scan walks the owners in binding order.
(defstruct TcMoveCleanupOwners
  (slots (__tl_dyn-array TcMoveCleanupOwner))
  (len i64))

(define (tc-move-cleanup-owners-new [count : i64]) : TcMoveCleanupOwners
  (TcMoveCleanupOwners (__tl_make-array TcMoveCleanupOwner count) count))

(define (tc-move-cleanup-owners-set
  [owners : TcMoveCleanupOwners]
  [index : i64]
  [name-id : i64]
  [owner-origin-id : i64]
  [move-aware : bool]) : TcMoveCleanupOwners
  (let
    [slots : (__tl_dyn-array TcMoveCleanupOwner) owners.slots]
    [len : i64 owners.len]
    (set!
      (array-ref slots index)
      (TcMoveCleanupOwner name-id owner-origin-id move-aware))
    (TcMoveCleanupOwners slots len)))

(defenum TcMoveMaybeIndex
  (No)
  (Some i64))

(defenum TcMaybeMovePath
  (No)
  (Some TcMovePath))

(defenum TcMaybeMoveName
  (No)
  (Some i64 String))

(defenum TcMaybeSliceSplitProjection
  (No)
  (Some i64 i64))

(defenum TcMoveConflict
  (No)
  (Some String i64))

;; --- shared empty moved-set id map -----------------------------------------
;;
;; Branch checking clones the moved-set at every arm/branch entry, and the
;; id-map copies are overwhelmingly empty. Allocating a private empty table for
;; each of those is pure waste, so an empty table is ALIASED instead of copied,
;; with copy-on-write at the writers.
;;
;; The sharing invariant has two halves, both checked locally:
;;
;;   1. Nothing ever writes through the shared map. Its full write surface is
;;      `tc-moved-add`, `tc-moved-add-value`, `tc-moved-add-partial-value`,
;;      `tc-moved-add-hidden-atomic-user`, `tc-moved-union-id-loop`,
;;      `tc-moved-clone-id-map` (which writes only into its own fresh map) and
;;      the two removers. Every inserting site takes private storage first via
;;      `tc-moved-id-map-own`. The removers need no guard: `remove-ref!` writes
;;      only after its probe finds an Occupied slot, and the shared map has
;;      none -- exactly how a freshly allocated empty copy would behave.
;;   2. The "is this the shared map?" test is exact. Every private moved-set map
;;      is born at `with-capacity 8` (from `tc-moved-id-map-own`) or copied at
;;      its source's capacity, and `grow!` only doubles, so private capacities
;;      are 8, 16, 32, ...; capacity 1 is the shared map and nothing else.
;;
;; This global is initialized in the program arena at startup, so it outlives
;; every per-function typecheck scratch arena that may hold sets pointing at it.
(define tc-moved-shared-empty-id-map : tc_i64_i64_map.Map
  (tc_i64_i64_map.with-capacity 1))

(define (tc-moved-id-map-shared-empty? [map : (& map tc_i64_i64_map.Map)]) : bool
  (= (tc_i64_i64_map.capacity map) 1))

;; Give an inserting writer private storage when it holds the shared empty map.
;; The replacement starts at the private-map birth capacity, so only the shared
;; alias pays an allocation here.
(define (tc-moved-id-map-own [map : tc_i64_i64_map.Map]) : tc_i64_i64_map.Map
  (if (tc-moved-id-map-shared-empty? (& map))
    (tc_i64_i64_map.with-capacity 8)
    map))

(define (tc-moved-empty) : TcMovedSet
  (TcMovedSet
    (tc-global-shared-view tc-moved-shared-empty-id-map)
    (tc-global-shared-view tc-moved-shared-empty-id-map)
    Nil
    (tc-global-shared-view tc-moved-shared-empty-id-map)
    0))

(define (tc-moved-roots [set : TcMovedSet]) : tc_i64_i64_map.Map
  set.roots)

(define (tc-moved-partials [set : TcMovedSet]) : tc_i64_i64_map.Map
  set.partials)

(define (tc-moved-paths [set : TcMovedSet]) : TcMovedPathFacts
  set.paths)

(define (tc-moved-path-fact-store-new [first : TcMovedPathFact]) : (Box
    TcMovedPathFactStoreData)
  (let
    [nodes : (__tl_dyn-array TcMovedPathFactNode)
      (__tl_make-array TcMovedPathFactNode 4)]
    [owner : i64 (arena.tl_arena_current)]
    (set! (array-ref nodes 0) (TcMovedPathFactNode first -1))
    (box (TcMovedPathFactStoreData nodes 1 owner))))

(define (tc-moved-path-fact-store-grow!
  [data : (&mut data TcMovedPathFactStoreData)]
  [required : i64]) : unit
  (let
    [old : (__tl_dyn-array TcMovedPathFactNode) data.nodes]
    [old-capacity : i64 (array-length old)]
    [next-capacity : i64 old-capacity]
    (unless
      (<= required old-capacity)
      (while (< next-capacity required)
        (set! next-capacity (* next-capacity 2)))
      (in-arena
        (arena.Arena data.owner-arena)
        (let
          [next : (__tl_dyn-array TcMovedPathFactNode)
            (__tl_make-array TcMovedPathFactNode next-capacity)]
          [index : i64 0]
          (while (< index data.len)
            (let
              [node : TcMovedPathFactNode (array-ref old index)]
              [kind : TcMovedPathKind
                (match node.fact.kind
                  [(Move) (Move)]
                  [(BorrowShared) (BorrowShared)]
                  [(BorrowMut) (BorrowMut)]
                  [(BorrowTwoPhaseMut) (BorrowTwoPhaseMut)]
                  [(BorrowLending binding-id) (BorrowLending binding-id)]
                  [(BorrowLendingUsed binding-id)
                    (BorrowLendingUsed binding-id)]
                  [(BorrowPending scope-id) (BorrowPending scope-id)]
                  [(OwnerDependency owner-id) (OwnerDependency owner-id)]
                  [(ObligationDischarged) (ObligationDischarged)])]
              (set!
                (array-ref next index)
                (TcMovedPathFactNode
                  (TcMovedPathFact
                    (TcMovePath
                      node.fact.path.root
                      (TcMovePathSegments
                        node.fact.path.segments.store-address
                        node.fact.path.segments.tail
                        node.fact.path.segments.len))
                    kind
                    node.fact.origin)
                  node.parent))
              (set! index (+ index 1))))
          (set! data.nodes next))))))

(define (tc-moved-path-fact-store-push!
  [data : (&mut data TcMovedPathFactStoreData)]
  [parent : i64]
  [fact : TcMovedPathFact]) : i64
  (let
    [index : i64 data.len]
    (tc-moved-path-fact-store-grow! data (+ index 1))
    (set! (array-ref data.nodes index) (TcMovedPathFactNode fact parent))
    (set! data.len (+ index 1))
    index))

(define (tc-moved-path-fact-store-node
  [data : (& data TcMovedPathFactStoreData)]
  [index : i64]) : TcMovedPathFactNode
  (unsafe
    (ptr-read (ptr-offset (__tl_array-data data.nodes) index))))

(define (tc-moved-path-facts-empty-impl [facts : TcMovedPathFacts]) : bool
  (match facts
    [(Nil) true]
    [_ false]))

(defmacro (tc-moved-path-facts-empty? [facts : Expr]) : Expr
  `(tc-moved-path-facts-empty-impl (tc-global-shared-view ,facts)))

(define (tc-moved-path-facts-len [facts : TcMovedPathFacts]) : i64
  (match facts
    [(Nil) 0]
    [(One _) 1]
    [(Dense _ _ len) len]))

(define (tc-moved-path-facts-head-impl [facts : TcMovedPathFacts]) : TcMovedPathFact
  (match facts
    [(Nil) (io.panic "typecheck: moved-path fact head of empty snapshot")]
    [(One fact) fact]
    [(Dense store tail _)
      (__tl-project-field
        (tc-moved-path-fact-store-node (& (__tl-box-place store)) tail)
        fact)]))

(defmacro (tc-moved-path-facts-head [facts : Expr]) : Expr
  `(tc-moved-path-facts-head-impl (tc-global-shared-view ,facts)))

(define (tc-moved-path-facts-rest-impl [facts : TcMovedPathFacts]) : TcMovedPathFacts
  (match facts
    [(or (Nil) (One _)) Nil]
    [(Dense store tail len)
      (let
        [parent : i64
          (__tl-project-field
            (tc-moved-path-fact-store-node (& (__tl-box-place store)) tail)
            parent)]
        (if (= len 2)
          (One
            (__tl-project-field
              (tc-moved-path-fact-store-node (& (__tl-box-place store)) parent)
              fact))
          (Dense store parent (- len 1))))]))

(defmacro (tc-moved-path-facts-rest [facts : Expr]) : Expr
  `(tc-moved-path-facts-rest-impl (tc-global-shared-view ,facts)))

(define (tc-moved-path-facts-cons
  [facts : TcMovedPathFacts]
  [fact : TcMovedPathFact]) : TcMovedPathFacts
  (match facts
    [(Nil) (One fact)]
    [(One previous)
      (let
        [store : (Box TcMovedPathFactStoreData)
          (tc-moved-path-fact-store-new previous)]
        [tail : i64
          (tc-moved-path-fact-store-push! (&mut (__tl-box-place store)) 0 fact)]
        (Dense store tail 2))]
    [(Dense store tail len)
      (let
        [next-tail : i64
          (tc-moved-path-fact-store-push!
            (&mut (__tl-box-place store))
            tail
            fact)]
        (Dense store next-tail (+ len 1)))]))

(define (tc-moved-hidden-atomic-users [set : TcMovedSet]) : tc_i64_i64_map.Map
  set.hidden-atomic-users)

(define (tc-moved-param-storage-origins [set : TcMovedSet]) : i64
  set.param-storage-origins)

(define (tc-param-storage-origin-node-read [address : i64]) : TcParamStorageOriginNode
  (unsafe
    (ptr-read (int->ptr (cast address : u64) : (Ptr TcParamStorageOriginNode)))))

(define (tc-param-storage-origin-node-new
  [name-id : i64]
  [parameter-id : i64]
  [parent : i64]) : i64
  (let
    [cell : (__tl_dyn-array TcParamStorageOriginNode)
      (__tl_make-array TcParamStorageOriginNode 1)]
    (set!
      (array-ref cell 0)
      (TcParamStorageOriginNode name-id parameter-id parent))
    (unsafe
      (cast
        (ptr->int
          (ptr-cast (__tl_array-data cell) : (Ptr TcParamStorageOriginNode)))
        : i64))))

(define (tc-param-storage-origin-lookup [head : i64] [name-id : i64]) : TcMaybeNameId
  (let
    [cursor : i64 head]
    [result : TcMaybeNameId No]
    [done : bool false]
    (while (and (not done) (not (= cursor 0)))
      (let
        [node : TcParamStorageOriginNode
          (tc-param-storage-origin-node-read cursor)]
        (if (= node.name-id name-id)
          (begin
            (if (>= node.parameter-id 0)
              (set! result (Some node.parameter-id))
              unit)
            (set! done true))
          (set! cursor node.parent))))
    result))

(define (tc-param-storage-origin-bind
  [head : i64]
  [name-id : i64]
  [parameter-id : i64]) : i64
  (tc-param-storage-origin-node-new name-id parameter-id head))

(define (tc-param-storage-origin-clear [head : i64] [name-id : i64]) : i64
  (match (tc-param-storage-origin-lookup head name-id)
    [(Some _) (tc-param-storage-origin-node-new name-id -1 head)]
    [(No) head]))

(define (tc-param-storage-origins-union-at
  [cursor : i64]
  [seen : TcNameIdList]
  [out : i64]) : i64
  (if (= cursor 0)
    out
    (let
      [node : TcParamStorageOriginNode
        (tc-param-storage-origin-node-read cursor)]
      [name-id : i64 node.name-id]
      (if (tc-name-id-list-contains seen name-id)
        (tc-param-storage-origins-union-at node.parent seen out)
        (tc-param-storage-origins-union-at
          node.parent
          (tc-name-id-list-cons seen name-id)
          (if (and
            (>= node.parameter-id 0)
            (match (tc-param-storage-origin-lookup out name-id)
              [(Some _) false]
              [(No) true]))
            (tc-param-storage-origin-bind out name-id node.parameter-id)
            out))))))

(define (tc-param-storage-origins-union [a : i64] [b : i64]) : i64
  (if (= a b)
    a
    (tc-param-storage-origins-union-at a Nil b)))

(define (tc-moved-with-param-storage-origins [set : TcMovedSet] [origins : i64]) : TcMovedSet
  (TcMovedSet
    (tc-moved-roots (tc-global-shared-view set))
    (tc-moved-partials (tc-global-shared-view set))
    (tc-moved-paths (tc-global-shared-view set))
    (tc-moved-hidden-atomic-users set)
    origins))

(define (tc-param-storage-origin-in-set [set : TcMovedSet] [name-id : i64]) : TcMaybeNameId
  (tc-param-storage-origin-lookup (tc-moved-param-storage-origins set) name-id))

(define (tc-param-storage-origin-bind-in-set
  [set : TcMovedSet]
  [name-id : i64]
  [parameter-id : i64]) : TcMovedSet
  (tc-moved-with-param-storage-origins
    (tc-global-shared-view set)
    (tc-param-storage-origin-bind
      (tc-moved-param-storage-origins set)
      name-id
      parameter-id)))

(define (tc-moved-len [set : (& set TcMovedSet)]) : i64
  (let
    [set : TcMovedSet (owned_view.compiler-owned-reference-shared-view set)]
    [roots : tc_i64_i64_map.Map (tc-moved-roots (tc-global-shared-view set))]
    [partials : tc_i64_i64_map.Map
      (tc-moved-partials (tc-global-shared-view set))]
    [paths : TcMovedPathFacts (tc-moved-paths (tc-global-shared-view set))]
    [hidden : tc_i64_i64_map.Map (tc-moved-hidden-atomic-users set)]
    (+
      (+ (tc_i64_i64_map.len (& roots)) (tc_i64_i64_map.len (& partials)))
      (+ (tc-moved-path-facts-len paths) (tc_i64_i64_map.len (& hidden))))))

(define (tc-moved-clone-id-map [src : (& src tc_i64_i64_map.Map)]) : tc_i64_i64_map.Map
  ;; Counting down the entry count skips the scan-to-capacity tail entirely;
  ;; branch moved-sets are usually empty or tiny, so a full-capacity walk
  ;; would be almost all empty slots.
  (let
    [remaining : i64 (tc_i64_i64_map.len src)]
    (if (= remaining 0)
      ;; An empty copy would have no content and no identity of its own -- it
      ;; would exist only so a later insert could not reach the
      ;; source's slots. `tc-moved-id-map-own` provides that separation at the
      ;; insert instead, so the empty case aliases the shared map and allocates
      ;; nothing. Lookups and removals see an empty table either way.
      (tc-global-shared-view tc-moved-shared-empty-id-map)
      (let
        [out : tc_i64_i64_map.Map
          (tc_i64_i64_map.with-capacity (tc_i64_i64_map.capacity src))]
        [index : i64 0]
        (while (> remaining 0)
          (set! index (tc_i64_i64_map.next-occupied src index))
          (match (tc_i64_i64_map.entry-at src index)
            [(EntrySome key value)
              (tc_i64_i64_map.insert-ref! (&mut out) key value)]
            [(EntryNone) unit])
          (set! index (+ index 1))
          (set! remaining (- remaining 1)))
        out))))

;; Hand the shared map straight back when the source already IS it. That is the
;; same value `tc-moved-clone-id-map` returns, and recognizing it here -- rather
;; than inside the call -- keeps the by-value map argument and return off the
;; common empty path.
(define (tc-moved-clone-id-map-or-shared [src : (& src tc_i64_i64_map.Map)]) : tc_i64_i64_map.Map
  (if (tc-moved-id-map-shared-empty? src)
    (tc-global-shared-view tc-moved-shared-empty-id-map)
    (tc-moved-clone-id-map src)))

(define (tc-moved-clone [set : (& set TcMovedSet)]) : TcMovedSet
  (let
    [set : TcMovedSet (owned_view.compiler-owned-reference-shared-view set)]
    [roots : tc_i64_i64_map.Map (tc-moved-roots (tc-global-shared-view set))]
    [partials : tc_i64_i64_map.Map
      (tc-moved-partials (tc-global-shared-view set))]
    [paths : TcMovedPathFacts (tc-moved-paths (tc-global-shared-view set))]
    [hidden : tc_i64_i64_map.Map
      (tc-moved-hidden-atomic-users (tc-global-shared-view set))]
    (TcMovedSet
      (tc-moved-clone-id-map-or-shared (& roots))
      (tc-moved-clone-id-map-or-shared (& partials))
      paths
      (tc-moved-clone-id-map-or-shared (& hidden))
      (tc-moved-param-storage-origins set))))

(define (tc-moved-contains? [set : (& set TcMovedSet)] [name-id : i64]) : bool
  (let
    [set : TcMovedSet (owned_view.compiler-owned-reference-shared-view set)]
    [map : tc_i64_i64_map.Map (tc-moved-roots set)]
    (tc_i64_i64_map.contains? (& map) name-id)))

(define (tc-moved-no-origin-id) : i64
  -1)

(define (tc-moved-add [set : TcMovedSet] [name-id : i64]) : TcMovedSet
  (let
    [out : tc_i64_i64_map.Map
      (tc-moved-id-map-own (tc-moved-roots (tc-global-shared-view set)))]
    (tc_i64_i64_map.insert-ref! (&mut out) name-id (tc-moved-no-origin-id))
    (TcMovedSet
      out
      (tc-moved-partials (tc-global-shared-view set))
      (tc-moved-paths (tc-global-shared-view set))
      (tc-moved-hidden-atomic-users (tc-global-shared-view set))
      (tc-moved-param-storage-origins set))))

(define (tc-moved-add-value [set : TcMovedSet] [name-id : i64] [value : i64]) : TcMovedSet
  (let
    [out : tc_i64_i64_map.Map
      (tc-moved-id-map-own (tc-moved-roots (tc-global-shared-view set)))]
    (tc_i64_i64_map.insert-ref! (&mut out) name-id value)
    (TcMovedSet
      out
      (tc-moved-partials (tc-global-shared-view set))
      (tc-moved-paths (tc-global-shared-view set))
      (tc-moved-hidden-atomic-users (tc-global-shared-view set))
      (tc-moved-param-storage-origins set))))

(define (tc-moved-add-origin
  [set : TcMovedSet]
  [name-id : i64]
  [origin : ast.AstExpr]) : TcMovedSet
  (tc-moved-add-value set name-id (ast.ast-node-push origin)))

(define (tc-moved-remove [set : TcMovedSet] [name-id : i64]) : TcMovedSet
  (let
    [out : tc_i64_i64_map.Map (tc-moved-roots (tc-global-shared-view set))]
    (if (tc-moved-id-map-shared-empty? (& out))
      ;; The shared map holds no Occupied slot, so `remove-ref!` would probe,
      ;; miss and leave everything -- including `len` -- untouched.
      set
      (begin
        (tc_i64_i64_map.remove-ref! (&mut out) name-id)
        (TcMovedSet
          out
          (tc-moved-partials (tc-global-shared-view set))
          (tc-moved-paths (tc-global-shared-view set))
          (tc-moved-hidden-atomic-users (tc-global-shared-view set))
          (tc-moved-param-storage-origins set))))))

(define (tc-moved-conflict [set : TcMovedSet] [name-id : i64]) : TcMoveConflict
  (let
    [map : tc_i64_i64_map.Map (tc-moved-roots set)]
    (match (tc_i64_i64_map.get (& map) name-id)
      [(LookupFound origin-id)
        (Some (tc-hygiene-name-text-id name-id) origin-id)]
      [(LookupMissing) No])))

(define (tc-move-use-message [name : String]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (MoveViolation))
    "typecheck: use of moved value `"
    name
    "`"))

(define (tc-move-loop-carried-message [name : String]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (ResourceOwnership))
    "typecheck: cannot move loop-carried owner value `"
    name
    "`"))

(define (tc-move-cleanup-owner-exit-message [name : String]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (ResourceOwnership))
    "typecheck: cleanup owner `"
    name
    "` moved before with scope exit"))

(define (tc-move-help) : String
  "clone the owner before moving it again, reinitialize the moved place before reuse, or keep the owner move inside a narrower scope")

(define (tc-move-path-root-id [path : TcMovePath]) : i64
  path.root)

(define tc-move-path-segment-kind-field : i64
  0)
(define tc-move-path-segment-kind-tuple : i64
  1)
(define tc-move-path-segment-kind-array : i64
  2)
(define tc-move-path-segment-kind-slice-split : i64
  3)
(define tc-move-path-segment-kind-slice-half : i64
  4)

(define (tc-move-path-segments-empty) : TcMovePathSegments
  (TcMovePathSegments 0 -1 0))

(define (tc-move-path-segment-store-read [address : i64]) : TcMovePathSegmentStoreData
  (unsafe
    (ptr-read
      (int->ptr (cast address : u64) : (Ptr TcMovePathSegmentStoreData)))))

(define (tc-move-path-segment-store-write!
  [address : i64]
  [data : TcMovePathSegmentStoreData]) : unit
  (unsafe
    (ptr-write!
      (int->ptr (cast address : u64) : (MutPtr TcMovePathSegmentStoreData))
      data)))

(define (tc-move-path-segment-store-new) : i64
  (let
    [cell : (__tl_dyn-array TcMovePathSegmentStoreData)
      (__tl_make-array TcMovePathSegmentStoreData 1)]
    [owner : i64 (arena.tl_arena_current)]
    (set!
      (array-ref cell 0)
      (TcMovePathSegmentStoreData
        (__tl_make-array TcMovePathSegmentNode 4)
        0
        owner))
    (unsafe
      (cast
        (ptr->int
          (ptr-cast (__tl_array-data cell) : (Ptr TcMovePathSegmentStoreData)))
        : i64))))

(define (tc-move-path-segment-store-grow!
  [data : (&mut data TcMovePathSegmentStoreData)]
  [required : i64]) : unit
  (let
    [old : (__tl_dyn-array TcMovePathSegmentNode) data.nodes]
    [old-capacity : i64 (array-length old)]
    [next-capacity : i64 old-capacity]
    (unless
      (<= required old-capacity)
      (while (< next-capacity required)
        (set! next-capacity (* next-capacity 2)))
      (in-arena
        (arena.Arena data.owner-arena)
        (let
          [next : (__tl_dyn-array TcMovePathSegmentNode)
            (__tl_make-array TcMovePathSegmentNode next-capacity)]
          [index : i64 0]
          (while (< index data.len)
            (let
              [node : TcMovePathSegmentNode (array-ref old index)]
              (set!
                (array-ref next index)
                (TcMovePathSegmentNode node.parent node.kind node.value))
              (set! index (+ index 1))))
          (set! data.nodes next))))))

(define (tc-move-path-segments-node
  [segments : TcMovePathSegments]
  [index : i64]) : TcMovePathSegmentNode
  (let
    [data : TcMovePathSegmentStoreData
      (tc-move-path-segment-store-read segments.store-address)]
    (array-ref data.nodes index)))

(define (tc-move-path-segments-eq?
  [a : TcMovePathSegments]
  [b : TcMovePathSegments]) : bool
  (let
    [remaining : i64 a.len]
    (if (not (= remaining b.len))
      false
      (if (and (= a.store-address b.store-address) (= a.tail b.tail))
        true
        (let
          [a-index : i64 a.tail]
          [b-index : i64 b.tail]
          [equal : bool true]
          (while (and equal (> remaining 0))
            (let
              [a-node : TcMovePathSegmentNode
                (tc-move-path-segments-node a a-index)]
              [b-node : TcMovePathSegmentNode
                (tc-move-path-segments-node b b-index)]
              (if (and
                (= a-node.kind b-node.kind)
                (= a-node.value b-node.value))
                unit
                (set! equal false))
              (set! a-index a-node.parent)
              (set! b-index b-node.parent)
              (set! remaining (- remaining 1))))
          equal)))))

(define (tc-move-path-segments-prefix?
  [prefix : TcMovePathSegments]
  [value : TcMovePathSegments]) : bool
  (let
    [prefix-len : i64 prefix.len]
    [value-len : i64 value.len]
    (if (= prefix-len 0)
      true
      (if (> prefix-len value-len)
        false
        (let
          [prefix-index : i64 prefix.tail]
          [value-index : i64 value.tail]
          [value-depth : i64 value-len]
          [remaining : i64 prefix-len]
          [equal : bool true]
          (while (> value-depth prefix-len)
            (let
              [node : TcMovePathSegmentNode
                (tc-move-path-segments-node value value-index)]
              (set! value-index node.parent)
              (set! value-depth (- value-depth 1))))
          (if (and
            (= prefix.store-address value.store-address)
            (= prefix-index value-index))
            true
            (begin
              (while (and equal (> remaining 0))
                (let
                  [prefix-node : TcMovePathSegmentNode
                    (tc-move-path-segments-node prefix prefix-index)]
                  [value-node : TcMovePathSegmentNode
                    (tc-move-path-segments-node value value-index)]
                  (if (and
                    (= prefix-node.kind value-node.kind)
                    (= prefix-node.value value-node.value))
                    unit
                    (set! equal false))
                  (set! prefix-index prefix-node.parent)
                  (set! value-index value-node.parent)
                  (set! remaining (- remaining 1))))
              equal)))))))

(define (tc-move-path-eq? [a : TcMovePath] [b : TcMovePath]) : bool
  (and (= a.root b.root) (tc-move-path-segments-eq? a.segments b.segments)))

(define (tc-move-path-conflicts? [a : TcMovePath] [b : TcMovePath]) : bool
  (and
    (= a.root b.root)
    (or
      (tc-move-path-segments-prefix? a.segments b.segments)
      (tc-move-path-segments-prefix? b.segments a.segments))))

;; Render a move/borrow place in user-facing source syntax: struct fields as
;; `.field`, tuple elements as `.N`, and array elements as `[N]`, so
;; diagnostics read like what the user wrote rather than internal place
;; encodings. Refs #5149.
(define (tc-move-path-segments-render [segments : TcMovePathSegments]) : String
  (let
    [length : i64 segments.len]
    (if (= length 0)
      ""
      (let
        [order : (__tl_dyn-array i64) (__tl_make-array i64 length)]
        [cursor : i64 segments.tail]
        [write-index : i64 (- length 1)]
        [read-index : i64 0]
        [out : String ""]
        (while (>= write-index 0)
          (let
            [node : TcMovePathSegmentNode
              (tc-move-path-segments-node segments cursor)]
            (set! (array-ref order write-index) cursor)
            (set! cursor node.parent)
            (set! write-index (- write-index 1))))
        (while (< read-index length)
          (let
            [node : TcMovePathSegmentNode
              (tc-move-path-segments-node segments (array-ref order read-index))]
            (cond
              [(= node.kind tc-move-path-segment-kind-field)
                (set!
                  out
                  (str_cat.str-cat out "." (tc-env-key-name-text node.value)))]
              [(= node.kind tc-move-path-segment-kind-tuple)
                (set!
                  out
                  (str_cat.str-cat out "." (string.int->string node.value)))]
              [(= node.kind tc-move-path-segment-kind-array)
                (set!
                  out
                  (str_cat.str-cat out "[" (string.int->string node.value) "]"))]
              [(= node.kind tc-move-path-segment-kind-slice-split)
                (set! out (str_cat.str-cat out ".<slice-split>"))]
              [else
                (set!
                  out
                  (str_cat.str-cat out "." (string.int->string node.value)))])
            (set! read-index (+ read-index 1))))
        out))))

(define (tc-move-path-render [path : TcMovePath]) : String
  (str_cat.str-cat
    (tc-env-key-name-text path.root)
    (tc-move-path-segments-render path.segments)))

(define (tc-moved-path-kind-eq? [a : TcMovedPathKind] [b : TcMovedPathKind]) : bool
  (match a
    [(Move)
      (match b
        [(Move) true]
        [_ false])]
    [(BorrowShared)
      (match b
        [(BorrowShared) true]
        [_ false])]
    [(BorrowMut)
      (match b
        [(BorrowMut) true]
        [_ false])]
    [(BorrowTwoPhaseMut)
      (match b
        [(BorrowTwoPhaseMut) true]
        [_ false])]
    [(BorrowLending a-id)
      (match b
        [(BorrowLending b-id) (= a-id b-id)]
        [_ false])]
    [(BorrowLendingUsed a-id)
      (match b
        [(BorrowLendingUsed b-id) (= a-id b-id)]
        [_ false])]
    [(BorrowPending a-id)
      (match b
        [(BorrowPending b-id) (= a-id b-id)]
        [_ false])]
    [(OwnerDependency a-id)
      (match b
        [(OwnerDependency b-id) (= a-id b-id)]
        [_ false])]
    [(ObligationDischarged)
      (match b
        [(ObligationDischarged) true]
        [_ false])]))

(define (tc-moved-path-fact-new
  [path : TcMovePath]
  [kind : TcMovedPathKind]
  [origin : i64]) : TcMovedPathFact
  (TcMovedPathFact path kind origin))

(define (tc-moved-path-fact-origin [fact : TcMovedPathFact]) : i64
  fact.origin)

(define (tc-moved-base-path-kind? [kind : TcMovedPathKind]) : bool
  (match kind
    [(or (Move) (BorrowShared)) true]
    [_ false]))

(define (tc-moved-partial? [set : (& set TcMovedSet)] [name-id : i64]) : bool
  (let
    [set : TcMovedSet (owned_view.compiler-owned-reference-shared-view set)]
    [partials : tc_i64_i64_map.Map (tc-moved-partials set)]
    (tc_i64_i64_map.contains? (& partials) name-id)))

(define (tc-moved-add-partial-value
  [set : TcMovedSet]
  [name-id : i64]
  [origin-id : i64]) : TcMovedSet
  (let
    [partials : tc_i64_i64_map.Map
      (tc-moved-id-map-own (tc-moved-partials (tc-global-shared-view set)))]
    (tc_i64_i64_map.insert-ref! (&mut partials) name-id origin-id)
    (TcMovedSet
      (tc-moved-roots (tc-global-shared-view set))
      partials
      (tc-moved-paths (tc-global-shared-view set))
      (tc-moved-hidden-atomic-users (tc-global-shared-view set))
      (tc-moved-param-storage-origins set))))

(define (tc-moved-remove-partial [set : TcMovedSet] [name-id : i64]) : TcMovedSet
  (let
    [partials : tc_i64_i64_map.Map
      (tc-moved-partials (tc-global-shared-view set))]
    (if (tc-moved-id-map-shared-empty? (& partials))
      ;; No Occupied slot to find, so the removal below is a no-op (see
      ;; `tc-moved-remove`).
      set
      (begin
        (tc_i64_i64_map.remove-ref! (&mut partials) name-id)
        (TcMovedSet
          (tc-moved-roots (tc-global-shared-view set))
          partials
          (tc-moved-paths (tc-global-shared-view set))
          (tc-moved-hidden-atomic-users (tc-global-shared-view set))
          (tc-moved-param-storage-origins set))))))

(define (tc-moved-partial-conflict [set : TcMovedSet] [name-id : i64]) : TcMoveConflict
  (let
    [partials : tc_i64_i64_map.Map (tc-moved-partials set)]
    (match (tc_i64_i64_map.get (& partials) name-id)
      [(LookupFound origin-id)
        (Some (tc-hygiene-name-text-id name-id) origin-id)]
      [(LookupMissing) No])))

(define (tc-moved-path-facts-remove-exact
  [facts : TcMovedPathFacts]
  [path : TcMovePath]
  [kind : TcMovedPathKind]) : TcMovedPathFactsRemove
  (if (tc-moved-path-facts-empty? facts)
    (Missing)
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      (if (and
        (tc-move-path-eq? fact.path path)
        (tc-moved-path-kind-eq? fact.kind kind))
        (Removed rest)
        (match (tc-moved-path-facts-remove-exact rest path kind)
          [(Missing) (Missing)]
          [(Removed tail) (Removed (tc-moved-path-facts-cons tail fact))])))))

(define (tc-moved-path-facts-contains-exact-kind?
  [facts : TcMovedPathFacts]
  [path : TcMovePath]
  [kind : TcMovedPathKind]) : bool
  (if (tc-moved-path-facts-empty? facts)
    false
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      (if (and
        (tc-move-path-eq? fact.path path)
        (tc-moved-path-kind-eq? fact.kind kind))
        true
        (tc-moved-path-facts-contains-exact-kind? rest path kind)))))

(define (tc-moved-add-path-fact
  [set : TcMovedSet]
  [path : TcMovePath]
  [kind : TcMovedPathKind]
  [origin : i64]) : TcMovedSet
  (if (tc-moved-path-facts-contains-exact-kind?
    (tc-moved-paths (tc-global-shared-view set))
    path
    kind)
    set
    (let
      [fact : TcMovedPathFact (tc-moved-path-fact-new path kind origin)]
      (TcMovedSet
        (tc-moved-roots (tc-global-shared-view set))
        (tc-moved-partials (tc-global-shared-view set))
        (tc-moved-path-facts-cons
          (tc-moved-paths (tc-global-shared-view set))
          fact)
        (tc-moved-hidden-atomic-users (tc-global-shared-view set))
        (tc-moved-param-storage-origins set)))))

(define (tc-moved-owner-dependency-at?
  [facts : TcMovedPathFacts]
  [local-id : i64]
  [owner-id : i64]) : bool
  (if (tc-moved-path-facts-empty? facts)
    false
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      (if (and
        (= fact.path.root local-id)
        (match fact.kind
          [(OwnerDependency dependency-owner-id)
            (= dependency-owner-id owner-id)]
          [_ false]))
        true
        (tc-moved-owner-dependency-at? rest local-id owner-id)))))

(define (tc-moved-owner-dependency?
  [set : TcMovedSet]
  [local-id : i64]
  [owner-id : i64]) : bool
  (tc-moved-owner-dependency-at? (tc-moved-paths set) local-id owner-id))

(define (tc-moved-add-owner-dependencies
  [moved : TcMovedSet]
  [local-id : i64]
  [owners : TcNameIdList]
  [origin : ast.AstExpr]) : TcMovedSet
  (let
    [cursor : TcNameIdList owners]
    [out : TcMovedSet moved]
    [path : TcMovePath (TcMovePath local-id (tc-move-path-segments-empty))]
    (while (not (tc-name-id-list-empty? cursor))
      (set!
        out
        (tc-moved-add-path-fact
          out
          path
          (OwnerDependency (tc-name-id-list-head cursor))
          (ast.ast-node-push (tc-global-shared-view origin))))
      (set! cursor (tc-name-id-list-rest cursor)))
    out))

(define (tc-moved-copy-owner-dependencies-at
  [facts : TcMovedPathFacts]
  [source-id : i64]
  [target-id : i64]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [out2 : TcMovedSet
        (if (= fact.path.root source-id)
          (match fact.kind
            [(OwnerDependency owner-id)
              (tc-moved-add-path-fact
                out
                (TcMovePath target-id (tc-move-path-segments-empty))
                (OwnerDependency owner-id)
                fact.origin)]
            [_ out])
          out)]
      (tc-moved-copy-owner-dependencies-at rest source-id target-id out2))))

(define (tc-move-rebind-lambda-owner-dependencies
  [expr-bases : i64]
  [env : TcTypeEnv]
  [moved : TcMovedSet]
  [local-id : i64]
  [init : ast.AstExpr]) : TcMovedSet
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& init))
    [(Lambda _)
      (tc-moved-add-owner-dependencies
        moved
        local-id
        (tc-thread-safe-spawn-direct-lambda-owner-regions
          expr-bases
          env
          (tc-global-shared-view init))
        init)]
    [(Var source-id)
      (tc-moved-copy-owner-dependencies-at
        (tc-moved-paths (tc-global-shared-view moved))
        source-id
        local-id
        moved)]
    [_ moved]))

(define (tc-moved-remove-path-kind
  [set : TcMovedSet]
  [path : TcMovePath]
  [kind : TcMovedPathKind]) : TcMovedSet
  (match (tc-moved-path-facts-remove-exact
    (tc-moved-paths (tc-global-shared-view set))
    path
    kind)
    [(Missing) set]
    [(Removed facts)
      (TcMovedSet
        (tc-moved-roots (tc-global-shared-view set))
        (tc-moved-partials (tc-global-shared-view set))
        facts
        (tc-moved-hidden-atomic-users (tc-global-shared-view set))
        (tc-moved-param-storage-origins set))]))

(define (tc-moved-path-exact-conflict-kind-at
  [facts : TcMovedPathFacts]
  [path : TcMovePath]
  [kind : TcMovedPathKind]) : TcMoveConflict
  (if (tc-moved-path-facts-empty? facts)
    No
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      (if (and
        (tc-move-path-eq? fact.path path)
        (tc-moved-path-kind-eq? fact.kind kind))
        (Some (tc-move-path-render fact.path) (tc-moved-path-fact-origin fact))
        (tc-moved-path-exact-conflict-kind-at rest path kind)))))

(define (tc-moved-path-exact-conflict-kind
  [set : (& set TcMovedSet)]
  [path : TcMovePath]
  [kind : TcMovedPathKind]) : TcMoveConflict
  (let
    [set : TcMovedSet (owned_view.compiler-owned-reference-shared-view set)]
    (tc-moved-path-exact-conflict-kind-at (tc-moved-paths set) path kind)))

(define (tc-moved-path-exact-conflict [set : TcMovedSet] [path : TcMovePath]) : TcMoveConflict
  (match (tc-moved-path-exact-conflict-kind set path (Move))
    [(Some key origin) (Some key origin)]
    [No (tc-moved-path-exact-conflict-kind set path (BorrowShared))]))

(define (tc-moved-conflict-display-path [key : String]) : String
  key)

(define (tc-move-origin-label [key : String]) : String
  (str_cat.str-cat
    "move of `"
    (tc-moved-conflict-display-path key)
    "` happened here"))

(define (tc-move-loop-carried-origin-label [name : String]) : String
  (str_cat.str-cat
    "owner value `"
    name
    "` is loop-carried into a repeated body"))

(define (tc-move-cleanup-owner-binding-label [name : String]) : String
  (str_cat.str-cat "cleanup owner `" name "` is bound for this with scope here"))

(define (tc-move-origin-span [expr-bases : i64] [origin-id : i64]) : TcMaybeAstSourceSpan
  (if (= origin-id (tc-moved-no-origin-id))
    No
    (tc-expr-maybe-span
      expr-bases
      (ast.ast-expr-segment-bases-get expr-bases origin-id))))

(define (tc-move-rich-origin-message
  [expr-bases : i64]
  [primary : ast.AstExpr]
  [message : String]
  [origin-id : i64]
  [origin-label : String]) : String
  (match (tc-expr-maybe-span expr-bases primary)
    [(Some primary-span)
      (match (tc-move-origin-span expr-bases origin-id)
        [(Some origin-span)
          (tc-rich-error-one-secondary
            primary-span
            message
            (tc-move-help)
            origin-span
            origin-label)]
        [(No)
          (tc-rich-error-one-secondary
            primary-span
            message
            (tc-move-help)
            primary-span
            origin-label)])]
    [(No)
      (match (tc-move-origin-span expr-bases origin-id)
        [(Some origin-span)
          (tc-rich-error-one-secondary
            origin-span
            message
            (tc-move-help)
            origin-span
            origin-label)]
        [(No) message])]))

(define (tc-move-rich-conflict-message
  [expr-bases : i64]
  [conflict : TcMoveConflict]
  [fallback-key : String]
  [primary : ast.AstExpr]
  [message : String]) : String
  (match conflict
    [(Some key origin-id)
      (tc-move-rich-origin-message
        expr-bases
        primary
        message
        origin-id
        (tc-move-origin-label key))]
    [No
      (tc-move-rich-origin-message
        expr-bases
        primary
        message
        (tc-moved-no-origin-id)
        (tc-move-origin-label fallback-key))]))

(define (tc-move-rich-loop-carried-message
  [expr-bases : i64]
  [name : String]
  [primary : ast.AstExpr]) : String
  (tc-move-rich-origin-message
    expr-bases
    primary
    (tc-move-loop-carried-message (tc-global-shared-view name))
    (tc-moved-no-origin-id)
    (tc-move-loop-carried-origin-label name)))

;; A move diagnostic about an owner place: the primary span is the scope or
;; edge the rule is checked at, with secondary labels for the conflicting move
;; (when there is one) and the owner's binding.
(define (tc-move-rich-owner-message
  [expr-bases : i64]
  [message : String]
  [help : String]
  [owner-label : String]
  [conflict : TcMoveConflict]
  [owner-origin-id : i64]
  [scope : ast.AstExpr]) : String
  (match (tc-expr-maybe-span expr-bases scope)
    [(Some primary-span)
      (match conflict
        [(Some key move-origin-id)
          (match (tc-move-origin-span expr-bases move-origin-id)
            [(Some move-span)
              (match (tc-move-origin-span expr-bases owner-origin-id)
                [(Some owner-span)
                  (tc-rich-error-two-secondaries
                    primary-span
                    message
                    help
                    move-span
                    (tc-move-origin-label key)
                    owner-span
                    owner-label)]
                [(No)
                  (tc-rich-error-two-secondaries
                    primary-span
                    message
                    help
                    move-span
                    (tc-move-origin-label key)
                    primary-span
                    owner-label)])]
            [(No)
              (match (tc-move-origin-span expr-bases owner-origin-id)
                [(Some owner-span)
                  (tc-rich-error-one-secondary
                    primary-span
                    message
                    help
                    owner-span
                    owner-label)]
                [(No)
                  (tc-rich-error-one-secondary
                    primary-span
                    message
                    help
                    primary-span
                    owner-label)])])]
        [No
          (match (tc-move-origin-span expr-bases owner-origin-id)
            [(Some owner-span)
              (tc-rich-error-one-secondary
                primary-span
                message
                help
                owner-span
                owner-label)]
            [(No)
              (tc-rich-error-one-secondary
                primary-span
                message
                help
                primary-span
                owner-label)])])]
    [(No)
      (match conflict
        [(Some key move-origin-id)
          (match (tc-move-origin-span expr-bases move-origin-id)
            [(Some move-span)
              (match (tc-move-origin-span expr-bases owner-origin-id)
                [(Some owner-span)
                  (tc-rich-error-two-secondaries
                    move-span
                    message
                    help
                    move-span
                    (tc-move-origin-label key)
                    owner-span
                    owner-label)]
                [(No)
                  (tc-rich-error-two-secondaries
                    move-span
                    message
                    help
                    move-span
                    (tc-move-origin-label key)
                    move-span
                    owner-label)])]
            [(No)
              (match (tc-move-origin-span expr-bases owner-origin-id)
                [(Some owner-span)
                  (tc-rich-error-one-secondary
                    owner-span
                    message
                    help
                    owner-span
                    owner-label)]
                [(No) message])])]
        [No
          (match (tc-move-origin-span expr-bases owner-origin-id)
            [(Some owner-span)
              (tc-rich-error-one-secondary
                owner-span
                message
                help
                owner-span
                owner-label)]
            [(No) message])])]))

(define (tc-move-rich-cleanup-owner-exit-message
  [expr-bases : i64]
  [conflict : TcMoveConflict]
  [name : String]
  [owner-origin-id : i64]
  [scope : ast.AstExpr]) : String
  (tc-move-rich-owner-message
    expr-bases
    (tc-move-cleanup-owner-exit-message (tc-global-shared-view name))
    (tc-move-help)
    (tc-move-cleanup-owner-binding-label name)
    conflict
    owner-origin-id
    scope))

(define (tc-move-rich-conflict-result
  [expr-bases : i64]
  [conflict : TcMoveConflict]
  [fallback-key : String]
  [primary : ast.AstExpr]
  [message : String]) : TcMoveResult
  (Err
    (tc-move-rich-conflict-message
      expr-bases
      conflict
      fallback-key
      primary
      message)))

(define (tc-move-rich-use-conflict-result
  [expr-bases : i64]
  [conflict : TcMoveConflict]
  [fallback-key : String]
  [primary : ast.AstExpr]
  [name : String]) : TcMoveResult
  (tc-move-rich-conflict-result
    expr-bases
    conflict
    fallback-key
    primary
    (tc-move-use-message name)))

(define (tc-move-rich-loop-carried-result
  [expr-bases : i64]
  [name : String]
  [primary : ast.AstExpr]) : TcMoveResult
  (Err (tc-move-rich-loop-carried-message expr-bases name primary)))

(define (tc-moved-path-conflict-at
  [facts : TcMovedPathFacts]
  [path : TcMovePath]) : TcMoveConflict
  (if (tc-moved-path-facts-empty? facts)
    No
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      (if (and
        (tc-moved-base-path-kind? fact.kind)
        (tc-move-path-conflicts? fact.path path))
        (Some (tc-move-path-render fact.path) (tc-moved-path-fact-origin fact))
        (tc-moved-path-conflict-at rest path)))))

(define (tc-moved-path-conflict-kind-at
  [facts : TcMovedPathFacts]
  [path : TcMovePath]
  [kind : TcMovedPathKind]) : TcMoveConflict
  (if (tc-moved-path-facts-empty? facts)
    No
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      (if (and
        (tc-moved-path-kind-eq? fact.kind kind)
        (tc-move-path-conflicts? fact.path path))
        (Some (tc-move-path-render fact.path) (tc-moved-path-fact-origin fact))
        (tc-moved-path-conflict-kind-at rest path kind)))))

(define (tc-moved-path-conflict-kind
  [set : TcMovedSet]
  [path : TcMovePath]
  [kind : TcMovedPathKind]) : TcMoveConflict
  (tc-moved-path-conflict-kind-at (tc-moved-paths set) path kind))

(define (tc-moved-path-conflict [set : TcMovedSet] [path : TcMovePath]) : TcMoveConflict
  (tc-moved-path-conflict-at (tc-moved-paths set) path))

(define (tc-moved-path-conflict? [set : TcMovedSet] [path : TcMovePath]) : bool
  (match (tc-moved-path-conflict set path)
    [(Some _ _) true]
    [No false]))

(define (tc-moved-path-fact-filter-remove?
  [fact : TcMovedPathFact]
  [filter : TcMovedPathFactsFilter]) : bool
  (match filter
    [(Root root-id) (= (tc-move-path-root-id fact.path) root-id)]
    [(Lending path)
      (and
        (tc-move-path-eq? fact.path path)
        (match fact.kind
          [(or (BorrowLending _) (BorrowLendingUsed _)) true]
          [_ false]))]
    [(Pending scope-id)
      (match fact.kind
        [(BorrowPending fact-scope-id) (= fact-scope-id scope-id)]
        [_ false])]))

(define (tc-moved-path-facts-filter-step
  [facts : TcMovedPathFacts]
  [filter : TcMovedPathFactsFilter]) : TcMovedPathFactsRemove
  (if (tc-moved-path-facts-empty? facts)
    (Missing)
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [remove : bool (tc-moved-path-fact-filter-remove? fact filter)]
      (match (tc-moved-path-facts-filter-step
        (tc-global-shared-view rest)
        filter)
        [(Missing)
          (if remove
            (Removed rest)
            (Missing))]
        [(Removed tail)
          (if remove
            (Removed tail)
            (Removed (tc-moved-path-facts-cons tail fact)))]))))

(define (tc-moved-path-facts-filter
  [facts : TcMovedPathFacts]
  [filter : TcMovedPathFactsFilter]) : TcMovedPathFacts
  (match (tc-moved-path-facts-filter-step (tc-global-shared-view facts) filter)
    [(Missing) facts]
    [(Removed tail) tail]))

(define (tc-moved-path-facts-remove-root
  [facts : TcMovedPathFacts]
  [root-id : i64]) : TcMovedPathFacts
  (tc-moved-path-facts-filter facts (Root root-id)))

(define (tc-moved-remove-root-state [set : TcMovedSet] [name-id : i64]) : TcMovedSet
  (let
    [without-root : TcMovedSet
      (tc-moved-remove-partial (tc-moved-remove set name-id) name-id)]
    [facts : TcMovedPathFacts
      (tc-moved-path-facts-remove-root
        (tc-moved-paths (tc-global-shared-view without-root))
        name-id)]
    (TcMovedSet
      (tc-moved-roots (tc-global-shared-view without-root))
      (tc-moved-partials (tc-global-shared-view without-root))
      facts
      (tc-moved-hidden-atomic-users (tc-global-shared-view without-root))
      (tc-param-storage-origin-clear
        (tc-moved-param-storage-origins without-root)
        name-id))))

;; Everything `tc-moved-remove-root-state` clears for one name. A binder that
;; shadows a local clears the name's state for its own binding, so it captures
;; the outer state first and restores it where its scope ends and the outer
;; local is visible again (#8266).
(defstruct TcMovedRootSnapshot
  (name-id i64)
  (moved? bool)
  (moved-origin i64)
  (partial? bool)
  (partial-origin i64)
  (paths TcMovedPathFacts)
  (parameter-id i64))

(define (tc-moved-root-paths-at
  [facts : TcMovedPathFacts]
  [root-id : i64]
  [out : TcMovedPathFacts]) : TcMovedPathFacts
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      (tc-moved-root-paths-at
        rest
        root-id
        (if (= (tc-move-path-root-id fact.path) root-id)
          (tc-moved-path-facts-cons out fact)
          out)))))

(define (tc-moved-root-snapshot [set : TcMovedSet] [name-id : i64]) : TcMovedRootSnapshot
  (let
    [roots : tc_i64_i64_map.Map (tc-moved-roots (tc-global-shared-view set))]
    [partials : tc_i64_i64_map.Map
      (tc-moved-partials (tc-global-shared-view set))]
    [root : tc_i64_i64_map.Lookup (tc_i64_i64_map.get (& roots) name-id)]
    [partial : tc_i64_i64_map.Lookup (tc_i64_i64_map.get (& partials) name-id)]
    (TcMovedRootSnapshot
      name-id
      (match root
        [(LookupFound _) true]
        [(LookupMissing) false])
      (match root
        [(LookupFound origin-id) origin-id]
        [(LookupMissing) (tc-moved-no-origin-id)])
      (match partial
        [(LookupFound _) true]
        [(LookupMissing) false])
      (match partial
        [(LookupFound origin-id) origin-id]
        [(LookupMissing) (tc-moved-no-origin-id)])
      (tc-moved-root-paths-at
        (tc-moved-paths (tc-global-shared-view set))
        name-id
        Nil)
      (match (tc-param-storage-origin-in-set set name-id)
        [(Some parameter-id) parameter-id]
        [(No) -1]))))

(define (tc-moved-restore-root-paths-at
  [set : TcMovedSet]
  [facts : TcMovedPathFacts]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    set
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      (tc-moved-restore-root-paths-at
        (tc-moved-add-path-fact
          set
          fact.path
          fact.kind
          (tc-moved-path-fact-origin fact))
        rest))))

;; Drops what the scope recorded about its own binding of the name and puts
;; back the captured state of the local it shadowed.
(define (tc-moved-restore-root-state
  [set : TcMovedSet]
  [snapshot : TcMovedRootSnapshot]) : TcMovedSet
  (let
    [name-id : i64 snapshot.name-id]
    [cleared : TcMovedSet (tc-moved-remove-root-state set name-id)]
    [with-root : TcMovedSet
      (if snapshot.moved?
        (tc-moved-add-value cleared name-id snapshot.moved-origin)
        cleared)]
    [with-partial : TcMovedSet
      (if snapshot.partial?
        (tc-moved-add-partial-value with-root name-id snapshot.partial-origin)
        with-root)]
    [with-paths : TcMovedSet
      (tc-moved-restore-root-paths-at with-partial snapshot.paths)]
    (if (< snapshot.parameter-id 0)
      with-paths
      (tc-param-storage-origin-bind-in-set
        with-paths
        name-id
        snapshot.parameter-id))))

;; --- ordinary `let` cleanup obligations (#6947) ---------------------------
;;
;; An ordinary `let` that binds a cleanup-owning struct or enum value owns it
;; under a must-discharge obligation: on every normal exit of the `let`'s scope
;; the value must have left the binding through an edge that discharges or
;; transfers it. Its `locals` entry records the binding's initializer in place
;; of the plain local marker, so an inner binding of the same name, which
;; rewrites the entry, hides the obligation exactly as it hides the local. The
;; entry also records the loop depth the binding was made at, so a `break` or
;; `continue` checks exactly the obligations it leaves.
;; Expression-pool indices fit 28 bits, and loop nesting cannot exceed the
;; expression count. Two 32-bit lanes therefore preserve the initializer and
;; exact depth without overflowing either signed owner-code domain.
(define (tc-move-scope-owner-depth-width) : i64
  4294967296)

(define (tc-move-let-obligation-code [origin-id : i64] [loop-depth : i64]) : i64
  (- -2 (+ (* origin-id (tc-move-scope-owner-depth-width)) loop-depth)))

(define (tc-move-let-obligation-code? [code : i64]) : bool
  (<= code -2))

(define (tc-move-let-obligation-origin [code : i64]) : i64
  (/ (- -2 code) (tc-move-scope-owner-depth-width)))

(define (tc-move-let-obligation-loop-depth [code : i64]) : i64
  (% (- -2 code) (tc-move-scope-owner-depth-width)))

;; An `(:invalidate r T)` parameter owns the same must-discharge obligation
;; (#6670). Its code carries the invalidated lifetime (a raw interner id, far
;; below 2^31) in the initializer lane and a depth no loop reaches, so a
;; `break` or `continue` never checks it while `return`, `try` and the end of
;; the body do. Only ending that lifetime's arena discharges it: a canonical
;; safe destroy of the brand or a call that invalidates it.
(define (tc-move-invalidate-obligation-depth) : i64
  2147483647)

(define (tc-move-invalidate-obligation-code? [code : i64]) : bool
  (and
    (tc-move-let-obligation-code? code)
    (=
      (tc-move-let-obligation-loop-depth code)
      (tc-move-invalidate-obligation-depth))))

(define (tc-move-invalidate-obligation-lifetime [code : i64]) : i64
  (tc-move-let-obligation-origin code))

;; The expression a cleanup obligation's diagnostic points back to, if any.
(define (tc-move-obligation-origin-id [code : i64]) : i64
  (if (tc-move-invalidate-obligation-code? code)
    (tc-moved-no-origin-id)
    (tc-move-let-obligation-origin code)))

(define (tc-move-bind-invalidate-obligation
  [locals : TcMovedSet]
  [name-id : i64]
  [lifetime : i64]) : TcMovedSet
  (set!
    tc-move-let-obligation-bind-count
    (+ tc-move-let-obligation-bind-count 1))
  (tc-move-bind-scope-owner
    locals
    name-id
    (tc-move-let-obligation-code lifetime (tc-move-invalidate-obligation-depth))))

;; A non-move-aware `with` owner's `locals` entry, with its initializer and
;; loop depth in the same packing: lowering runs the owner's cleanup on every
;; edge that leaves its scope, so no such edge may find it moved.
(define (tc-move-with-owner-code-base) : i64
  1099511627776)

(define (tc-move-with-owner-code [origin-id : i64] [loop-depth : i64]) : i64
  (+
    (tc-move-with-owner-code-base)
    (+ (* origin-id (tc-move-scope-owner-depth-width)) loop-depth)))

(define (tc-move-with-owner-code? [code : i64]) : bool
  (>= code (tc-move-with-owner-code-base)))

(define (tc-move-with-owner-origin [code : i64]) : i64
  (/ (- code (tc-move-with-owner-code-base)) (tc-move-scope-owner-depth-width)))

(define (tc-move-with-owner-loop-depth [code : i64]) : i64
  (% (- code (tc-move-with-owner-code-base)) (tc-move-scope-owner-depth-width)))

(define (tc-move-bind-with-owner
  [locals : TcMovedSet]
  [name-id : i64]
  [origin-id : i64]) : TcMovedSet
  (let
    [depth : i64 (tc-move-loop-depth (tc-global-shared-view locals))]
    (tc-move-bind-scope-owner
      locals
      name-id
      (tc-move-with-owner-code origin-id depth))))

;; Owners whose scope an exit edge can leave: obligated `let` bindings and
;; `with` owners. While neither has been bound, edges skip their scans.
(define (tc-move-scope-owners-possible?) : bool
  (or (tc-move-let-obligations-possible?) (tc-cleanup-owner-markers-possible?)))

;; `locals` counts the scope owners bound around the checked expression under
;; this private key, so an edge or a loop body with none skips its work. Name
;; identities are nonnegative; negative metadata keys cannot alias a binding
;; and remain valid when another job's intern pool is installed.
(define (tc-move-scope-owner-count-key) : i64
  -1)

(define (tc-move-owners-in-scope? [locals : TcMovedSet]) : bool
  (and
    (tc-move-scope-owners-possible?)
    (let
      [roots : tc_i64_i64_map.Map (tc-moved-roots locals)]
      (match (tc_i64_i64_map.get (& roots) (tc-move-scope-owner-count-key))
        [(LookupFound count) (> count 0)]
        [(LookupMissing) false]))))

;; `locals` with one more scope owner bound under `name-id` as `code`.
(define (tc-move-bind-scope-owner
  [locals : TcMovedSet]
  [name-id : i64]
  [code : i64]) : TcMovedSet
  (let
    [count : i64
      (let
        [roots : tc_i64_i64_map.Map
          (tc-moved-roots (tc-global-shared-view locals))]
        (match (tc_i64_i64_map.get (& roots) (tc-move-scope-owner-count-key))
          [(LookupFound count) count]
          [(LookupMissing) 0]))]
    (tc-moved-add-value
      (tc-moved-add-value locals name-id code)
      (tc-move-scope-owner-count-key)
      (+ count 1))))

;; `locals` records the depth of loop bodies around the checked expression
;; under a distinct non-name key. A lambda body starts from fresh locals and
;; therefore at depth 0.
(define (tc-move-loop-depth-key) : i64
  -2)

(define (tc-move-loop-depth [locals : TcMovedSet]) : i64
  (let
    [roots : tc_i64_i64_map.Map (tc-moved-roots locals)]
    (match (tc_i64_i64_map.get (& roots) (tc-move-loop-depth-key))
      [(LookupFound depth) depth]
      [(LookupMissing) 0])))

;; The locals of a loop body. The depth only matters to owners, so a loop
;; entered with no owner in scope keeps its depth: an owner bound inside it is
;; still told apart from every owner in scope at its `break`.
(define (tc-move-enter-loop-body [locals : TcMovedSet]) : TcMovedSet
  (if (tc-move-owners-in-scope? (tc-global-shared-view locals))
    (let
      [depth : i64 (tc-move-loop-depth (tc-global-shared-view locals))]
      (tc-moved-add-value locals (tc-move-loop-depth-key) (+ depth 1)))
    locals))

;; Monotone and process-wide like `tc-cleanup-owner-marker-bind-count`: while no
;; obligated `let` has been bound, no local carries an obligation and joins and
;; exit edges skip their scans.
(define tc-move-let-obligation-bind-count : i64
  0)

(define (tc-move-let-obligations-possible?) : bool
  (not (= tc-move-let-obligation-bind-count 0)))

(define (tc-move-let-obligated? [locals : TcMovedSet] [name-id : i64]) : bool
  (let
    [roots : tc_i64_i64_map.Map (tc-moved-roots locals)]
    (match (tc_i64_i64_map.get (& roots) name-id)
      [(LookupFound code)
        (and
          (tc-move-let-obligation-code? code)
          (not (tc-move-invalidate-obligation-code? code)))]
      [(LookupMissing) false])))

;; The `locals` of a `let` body whose binding owns a cleanup obligation.
(define (tc-move-bind-let-obligation
  [locals : TcMovedSet]
  [name-id : i64]
  [origin-id : i64]) : TcMovedSet
  (let
    [depth : i64 (tc-move-loop-depth (tc-global-shared-view locals))]
    (set!
      tc-move-let-obligation-bind-count
      (+ tc-move-let-obligation-bind-count 1))
    (tc-move-bind-scope-owner
      locals
      name-id
      (tc-move-let-obligation-code origin-id depth))))

(define (tc-move-obligation-path [name-id : i64]) : TcMovePath
  (TcMovePath name-id (tc-move-path-segments-empty)))

;; What a moved set records about an obligated local: 0 still owned, 1 moved
;; out through a discharging edge, 2 moved out through any other edge (the
;; obligation is lost), 3 partially moved.
(define (tc-move-obligation-status [moved : TcMovedSet] [name-id : i64]) : i64
  (cond
    [(tc-moved-contains? (& moved) name-id)
      (if (tc-moved-path-facts-contains-exact-kind?
        (tc-moved-paths moved)
        (tc-move-obligation-path name-id)
        (ObligationDischarged))
        1
        2)]
    [(tc-moved-partial? (& moved) name-id) 3]
    [else 0]))

;; The obligation checks are macros so that a program that has not bound an
;; owner pays one test at each site, not the evaluation of the arguments.
(defmacro (tc-move-discharge-direct
  [ctx : Expr]
  [expr-bases : Expr]
  [locals : Expr]
  [moved : Expr]
  [value-id : Expr]) : Expr
  `(if (tc-move-let-obligations-possible?)
    (tc-move-discharge-direct-impl ,ctx ,expr-bases ,locals ,moved ,value-id)
    ,moved))

(defmacro (tc-move-discharge-call-args
  [ctx : Expr]
  [expr-bases : Expr]
  [env : Expr]
  [locals : Expr]
  [moved : Expr]
  [func : Expr]
  [args : Expr]
  [params : Expr]) : Expr
  `(if (tc-move-let-obligations-possible?)
    (tc-move-discharge-call-args-impl
      ,ctx
      ,expr-bases
      ,env
      ,locals
      ,moved
      ,func
      ,args
      ,params)
    ,moved))

(defmacro (tc-move-check-obligations-agree
  [expr-bases : Expr]
  [locals : Expr]
  [a : Expr]
  [a-site : Expr]
  [b : Expr]
  [b-site : Expr]
  [where : Expr]) : Expr
  `(if (tc-move-let-obligations-possible?)
    (tc-move-check-obligations-agree-impl
      ,expr-bases
      ,locals
      ,a
      ,a-site
      ,b
      ,b-site
      ,where)
    ResultTcUnit.Ok))

(defmacro (tc-move-check-if-obligations
  [ctx : Expr]
  [expr-bases : Expr]
  [locals : Expr]
  [then-moved : Expr]
  [then-id : Expr]
  [else-moved : Expr]
  [else-id : Expr]) : Expr
  `(if (tc-move-let-obligations-possible?)
    (tc-move-check-if-obligations-impl
      ,ctx
      ,expr-bases
      ,locals
      ,then-moved
      ,then-id
      ,else-moved
      ,else-id)
    ResultTcUnit.Ok))

(defmacro (tc-move-loop-results-agree
  [expr-bases : Expr]
  [locals : Expr]
  [a : Expr]
  [b : Expr]
  [branch : Expr]) : Expr
  `(if (tc-move-let-obligations-possible?)
    (tc-move-loop-results-agree-impl ,expr-bases ,locals ,a ,b ,branch)
    ResultTcUnit.Ok))

(defmacro (tc-move-check-obligations-exit
  [expr-bases : Expr]
  [locals : Expr]
  [loop-depth : Expr]
  [moved : Expr]
  [edge : Expr]
  [where : Expr]) : Expr
  `(let
    [tc-move-exit-locals : TcMovedSet ,locals]
    (if (tc-move-owners-in-scope? (tc-global-shared-view tc-move-exit-locals))
      (tc-move-check-obligations-exit-impl
        ,expr-bases
        tc-move-exit-locals
        ,loop-depth
        ,moved
        ,edge
        ,where)
      (TcMoveResult.Ok ,moved))))

;; Records that every normal value is the same visible obligated local and
;; leaves through a discharging edge: its declared cleanup function, a `let` or `with`
;; initializer, a cleanup-owning constructor, or a `return`.
(define (tc-move-discharge-direct-impl
  [ctx : TcContext]
  [expr-bases : i64]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [value-id : i64]) : TcMovedSet
  (let
    [v-id : i64 (tc-move-direct-tail-var-id ctx expr-bases value-id)]
    (if (and
      (>= v-id 0)
      (tc-move-let-obligated? locals v-id)
      (tc-moved-contains? (& moved) v-id))
      (tc-moved-add-path-fact
        moved
        (tc-move-obligation-path v-id)
        (ObligationDischarged)
        value-id)
      moved)))

;; The same visible local must supply the value on every normally completing
;; arm before a consumer can discharge its root. -2 has no normal result;
;; -1 has a different result or shadows the local. This is a value-tail proof,
;; not a may-move union: selecting different live owners cannot discharge both.
(define (tc-move-direct-tail-join [a : i64] [b : i64]) : i64
  (cond [(= a -2) b] [(= b -2) a] [(= a b) a] [else -1]))

(define (tc-move-direct-tail-exprs-var-id
  [ctx : TcContext]
  [expr-bases : i64]
  [exprs : ast.AstExprList]) : i64
  (if (<= exprs.len 0)
    -1
    (tc-move-direct-tail-var-id
      ctx
      expr-bases
      (ast.ast-expr-list-get (& exprs) (- exprs.len 1) 0))))

(define (tc-move-direct-tail-arms-var-id
  [ctx : TcContext]
  [expr-bases : i64]
  [arms : ast.AstMatchArmList]) : i64
  (let
    [index : i64 0]
    [out : i64 -2]
    (while (< index arms.len)
      (match (ast.ast-match-arm-list-get
        (& arms)
        index
        (ast.ast-match-arm-fallback))
        [(Arm pattern body-box)
          (let
            [tail : i64 (tc-move-direct-tail-var-id ctx expr-bases body-box)]
            (set!
              out
              (tc-move-direct-tail-join
                out
                (if (tc-name-id-list-contains
                  (tc-pattern-add-bound-name-ids pattern Nil)
                  tail)
                  -1
                  tail))))])
      (set! index (+ index 1)))
    out))

(define (tc-move-direct-tail-var-id
  [ctx : TcContext]
  [expr-bases : i64]
  [expr-id : i64]) : i64
  (if (tc-move-arm-diverges? ctx expr-bases expr-id)
    -2
    (match (ast.ast-expr-unspan-with-segment-bases
      expr-bases
      (& (ast.ast-expr-segment-bases-get expr-bases expr-id)))
      [(Var name) name]
      [(Ann inner-box _) (tc-move-direct-tail-var-id ctx expr-bases inner-box)]
      [(or (Begin exprs) (Unsafe exprs) (WithRegion _ exprs)
           (WithEscape _ exprs) (WithScratch exprs) (InArena _ exprs))
        (tc-move-direct-tail-exprs-var-id ctx expr-bases exprs)]
      [(If _ then-box else-box)
        (tc-move-direct-tail-join
          (tc-move-direct-tail-var-id ctx expr-bases then-box)
          (tc-move-direct-tail-var-id ctx expr-bases else-box))]
      [(Match match-box)
        (match (ast.ast-match-box-shared-view match-box)
          [(Match _ arms) (tc-move-direct-tail-arms-var-id ctx expr-bases arms)])]
      [(Let let-box)
        (match (__tl-box-place let-box)
          [(Let bindings body-box)
            (let
              [tail : i64 (tc-move-direct-tail-var-id ctx expr-bases body-box)]
              (if (tc-name-id-list-contains
                (tc-let-binding-list-add-bound-name-ids bindings Nil)
                tail)
                -1
                tail))])]
      [(WithResource wr-box)
        (match (ast.ast-with-resource-box-shared-view wr-box)
          [(WithResource bindings exprs)
            (let
              [tail : i64
                (tc-move-direct-tail-exprs-var-id ctx expr-bases exprs)]
              (if (tc-name-id-list-contains
                (tc-move-add-resource-shadowed-names Nil bindings)
                tail)
                -1
                tail))])]
      [_ -1])))

(define (tc-move-invalidate-obligation-help) : String
  "destroy the parameter's arena with arena.destroy-safe! or pass it to another :invalidate parameter exactly once on every path")

;; An `:invalidate` parameter left undischarged on the edge `edge`.
(define (tc-move-invalidate-obligation-message
  [expr-bases : i64]
  [name-id : i64]
  [lifetime : i64]
  [edge : ast.AstExpr]
  [where : String]) : String
  (let
    [name : String (tc-hygiene-name-text-id name-id)]
    (tc-move-rich-owner-message
      expr-bases
      (str_cat.str-cat
        (cdiag.compiler-diagnostic-typecheck-tag (ResourceOwnership))
        "typecheck: invalidation obligation of `"
        (tc-global-shared-view name)
        "` (:invalidate "
        (tc-lifetime-name-render lifetime)
        ") is not discharged "
        where)
      (tc-move-invalidate-obligation-help)
      (tc-move-obligation-binding-label name)
      No
      (tc-moved-no-origin-id)
      edge)))

;; The normal end of a function or lambda body that binds `:invalidate`
;; parameters: every one of them must have been discharged.
(define (tc-move-check-invalidate-body-end
  [ctx : TcContext]
  [expr-bases : i64]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [body-id : i64]) : ResultTcUnit
  (if (or
    (not (tc-invalidate-types-present?))
    (not (tc-move-owners-in-scope? (tc-global-shared-view locals)))
    (tc-move-arm-diverges? ctx expr-bases body-id))
    Ok
    (let
      [roots : tc_i64_i64_map.Map (tc-moved-roots locals)]
      [remaining : i64 (tc_i64_i64_map.len (& roots))]
      [cursor : i64 0]
      [failure : String ""]
      [failed? : bool false]
      (while (and (not failed?) (> remaining 0))
        (set! cursor (tc_i64_i64_map.next-occupied (& roots) cursor))
        (match (tc_i64_i64_map.entry-at (& roots) cursor)
          [(EntrySome key value)
            (when
              (and
                (tc-move-invalidate-obligation-code? value)
                (not
                  (=
                    (tc-move-obligation-status
                      (tc-global-shared-view moved)
                      key)
                    1)))
              (set! failed? true)
              (set!
                failure
                (tc-move-invalidate-obligation-message
                  expr-bases
                  key
                  (tc-move-invalidate-obligation-lifetime value)
                  (ast.ast-expr-segment-bases-get expr-bases body-id)
                  "at the end of its function")))]
          [(EntryNone) unit])
        (set! cursor (+ cursor 1))
        (set! remaining (- remaining 1)))
      (if failed?
        (Err failure)
        Ok))))

;; Ending `brand` discharges the enclosing body's `:invalidate` parameter with
;; that lifetime once the parameter itself has left.
(define (tc-move-discharge-invalidate
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [brand : i64]) : TcMovedSet
  (if (not (tc-move-owners-in-scope? (tc-global-shared-view locals)))
    moved
    (let
      [roots : tc_i64_i64_map.Map (tc-moved-roots locals)]
      [remaining : i64 (tc_i64_i64_map.len (& roots))]
      [cursor : i64 0]
      [out : TcMovedSet moved]
      (while (> remaining 0)
        (set! cursor (tc_i64_i64_map.next-occupied (& roots) cursor))
        (match (tc_i64_i64_map.entry-at (& roots) cursor)
          [(EntrySome key value)
            (if (and
              (tc-move-invalidate-obligation-code? value)
              (= (tc-move-invalidate-obligation-lifetime value) brand)
              (tc-moved-contains? (& out) key))
              (set!
                out
                (tc-moved-add-path-fact
                  out
                  (tc-move-obligation-path key)
                  (ObligationDischarged)
                  (tc-moved-no-origin-id)))
              unit)]
          [(EntryNone) unit])
        (set! cursor (+ cursor 1))
        (set! remaining (- remaining 1)))
      out)))

(define (tc-move-obligation-help) : String
  "pass the value to its declared cleanup function, return it, or move it into another `let`, a `with` binding or a cleanup-owning aggregate on every path")

(define (tc-move-obligation-binding-label [name : String]) : String
  (str_cat.str-cat "cleanup obligation of `" name "` starts here"))

;; `where` names the edge, e.g. "at the end of its let scope".
(define (tc-move-obligation-message
  [expr-bases : i64]
  [moved : TcMovedSet]
  [name-id : i64]
  [origin-id : i64]
  [status : i64]
  [edge : ast.AstExpr]
  [where : String]) : String
  (let
    [name : String (tc-hygiene-name-text-id name-id)]
    (tc-move-rich-owner-message
      expr-bases
      (str_cat.str-cat
        (cdiag.compiler-diagnostic-typecheck-tag (ResourceOwnership))
        "typecheck: cleanup obligation of `"
        (tc-global-shared-view name)
        (cond
          [(= status 2) "` is lost where it is moved without being discharged"]
          [(= status 3) "` is only partly discharged "]
          [else "` is not discharged "])
        (if (= status 2)
          ""
          where))
      (tc-move-obligation-help)
      (tc-move-obligation-binding-label name)
      (if (= status 0)
        No
        (tc-moved-root-conflict moved name-id))
      origin-id
      edge)))

;; The end of an obligated `let` binding's scope: the value is discharged, or
;; the `let` evaluates to it directly and hands the obligation to its value.
(define (tc-move-check-let-obligation-end
  [ctx : TcContext]
  [expr-bases : i64]
  [moved : TcMovedSet]
  [name-id : i64]
  [origin-id : i64]
  [body-box : i64]) : TcMoveResult
  (let
    [status : i64
      (tc-move-obligation-status (tc-global-shared-view moved) name-id)]
    (if (or
      (= status 1)
      (tc-move-arm-diverges? ctx expr-bases body-box)
      (and
        (= status 0)
        (= (tc-move-direct-tail-var-id ctx expr-bases body-box) name-id)))
      (Ok moved)
      (Err
        (tc-move-obligation-message
          expr-bases
          (tc-global-shared-view moved)
          name-id
          origin-id
          status
          (ast.ast-expr-segment-bases-get expr-bases body-box)
          "at the end of its let scope")))))

;; An edge that leaves the scope of owners: every obligated `let` owner in
;; `locals` it leaves must be discharged in `moved`, and every `with` owner it
;; leaves must still be in place for its cleanup. A `return` or `try` passes
;; `loop-depth` -1 and leaves every owner of the function body; a `break` or
;; `continue` passes the current loop depth and leaves the owners bound inside
;; that loop.
(define (tc-move-check-obligations-exit-impl
  [expr-bases : i64]
  [locals : TcMovedSet]
  [loop-depth : i64]
  [moved : TcMovedSet]
  [edge : ast.AstExpr]
  [where : String]) : TcMoveResult
  (let
    [roots : tc_i64_i64_map.Map (tc-moved-roots locals)]
    [remaining : i64 (tc_i64_i64_map.len (& roots))]
    [cursor : i64 0]
    [failure : String ""]
    [failed? : bool false]
    (while (and (not failed?) (> remaining 0))
      (set! cursor (tc_i64_i64_map.next-occupied (& roots) cursor))
      (match (tc_i64_i64_map.entry-at (& roots) cursor)
        [(EntrySome key value)
          (cond
            [(and
                (tc-move-let-obligation-code? value)
                (or
                  (< loop-depth 0)
                  (= (tc-move-let-obligation-loop-depth value) loop-depth)))
              (let
                [status : i64
                  (tc-move-obligation-status (tc-global-shared-view moved) key)]
                (unless
                  (= status 1)
                  (set! failed? true)
                  (set!
                    failure
                    (if (tc-move-invalidate-obligation-code? value)
                      (tc-move-invalidate-obligation-message
                        expr-bases
                        key
                        (tc-move-invalidate-obligation-lifetime value)
                        (tc-global-shared-view edge)
                        (tc-global-shared-view where))
                      (tc-move-obligation-message
                        expr-bases
                        (tc-global-shared-view moved)
                        key
                        (tc-move-let-obligation-origin value)
                        status
                        (tc-global-shared-view edge)
                        (tc-global-shared-view where))))))]
            [(and
              (tc-move-with-owner-code? value)
              (or
                (< loop-depth 0)
                (= (tc-move-with-owner-loop-depth value) loop-depth))
              (or
                (tc-moved-contains? (& moved) key)
                (tc-moved-partial? (& moved) key)))
              (set! failed? true)
              (set!
                failure
                (tc-move-rich-cleanup-owner-exit-message
                  expr-bases
                  (tc-moved-root-conflict (tc-global-shared-view moved) key)
                  (tc-hygiene-name-text-id key)
                  (tc-move-with-owner-origin value)
                  (tc-global-shared-view edge)))]
            [else unit])]
        [(EntryNone) unit])
      (set! cursor (+ cursor 1))
      (set! remaining (- remaining 1)))
    (if failed?
      (Err failure)
      (Ok moved))))

;; The arms of an `if` join only when both complete normally.
(define (tc-move-check-if-obligations-impl
  [ctx : TcContext]
  [expr-bases : i64]
  [locals : TcMovedSet]
  [then-moved : TcMovedSet]
  [then-id : i64]
  [else-moved : TcMovedSet]
  [else-id : i64]) : ResultTcUnit
  (match (tc-move-check-obligations-agree
    expr-bases
    locals
    then-moved
    (ast.ast-expr-segment-bases-get expr-bases then-id)
    else-moved
    (ast.ast-expr-segment-bases-get expr-bases else-id)
    "through this branch")
    [(Ok) Ok]
    [(Err message)
      (if (or
        (tc-move-arm-diverges? ctx expr-bases then-id)
        (tc-move-arm-diverges? ctx expr-bases else-id))
        Ok
        (Err message))]))

;; A loop is left on the zero-trip path, with the state before the body, and
;; through its `break` edges.
(define (tc-move-join-loop-exit
  [expr-bases : i64]
  [locals : TcMovedSet]
  [entry : TcMovedSet]
  [breaks : TcMovedSet]
  [body : ast.AstExpr]) : TcMoveResult
  (let
    [_
      (try
        (tc-move-check-obligations-agree
          expr-bases
          locals
          (tc-global-shared-view entry)
          (tc-global-shared-view body)
          (tc-global-shared-view breaks)
          (tc-global-shared-view body)
          "out of this loop"))]
    (Ok (tc-moved-union entry breaks))))

;; Two normally completing paths that join must agree on every obligated local
;; visible at the join; the conservative union would otherwise count a
;; discharge on one of them as a discharge on both. The diagnostic points at
;; the path that does not discharge it.
(define (tc-move-check-obligations-agree-impl
  [expr-bases : i64]
  [locals : TcMovedSet]
  [a : TcMovedSet]
  [a-site : ast.AstExpr]
  [b : TcMovedSet]
  [b-site : ast.AstExpr]
  [where : String]) : ResultTcUnit
  (if (not (tc-move-let-obligations-possible?))
    Ok
    (let
      [roots : tc_i64_i64_map.Map (tc-moved-roots locals)]
      [remaining : i64 (tc_i64_i64_map.len (& roots))]
      [cursor : i64 0]
      [failure : String ""]
      [failed? : bool false]
      (while (and (not failed?) (> remaining 0))
        (set! cursor (tc_i64_i64_map.next-occupied (& roots) cursor))
        (match (tc_i64_i64_map.entry-at (& roots) cursor)
          [(EntrySome key value)
            (let
              [a-status : i64
                (if (tc-move-let-obligation-code? value)
                  (tc-move-obligation-status (tc-global-shared-view a) key)
                  0)]
              [b-status : i64
                (if (tc-move-let-obligation-code? value)
                  (tc-move-obligation-status (tc-global-shared-view b) key)
                  0)]
              (if (= a-status b-status)
                unit
                (let
                  [name : String (tc-hygiene-name-text-id key)]
                  [invalidate? : bool
                    (tc-move-invalidate-obligation-code? value)]
                  (set! failed? true)
                  (set!
                    failure
                    (tc-move-rich-owner-message
                      expr-bases
                      (str_cat.str-cat
                        (cdiag.compiler-diagnostic-typecheck-tag
                          (ResourceOwnership))
                        (if invalidate?
                          "typecheck: invalidation obligation of `"
                          "typecheck: cleanup obligation of `")
                        (tc-global-shared-view name)
                        "` is discharged on only some paths "
                        (tc-global-shared-view where))
                      (if invalidate?
                        (tc-move-invalidate-obligation-help)
                        (tc-move-obligation-help))
                      (tc-move-obligation-binding-label name)
                      No
                      (tc-move-obligation-origin-id value)
                      (if (= a-status 1)
                        (tc-global-shared-view b-site)
                        (tc-global-shared-view a-site)))))))]
          [(EntryNone) unit])
        (set! cursor (+ cursor 1))
        (set! remaining (- remaining 1)))
      (if failed?
        (Err failure)
        Ok))))

(define (tc-moved-any-root-path-at? [facts : TcMovedPathFacts] [root-id : i64]) : bool
  (if (tc-moved-path-facts-empty? facts)
    false
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      (if (and
        (match fact.kind
          [(Move) true]
          [_ false])
        (= (tc-move-path-root-id fact.path) root-id))
        true
        (tc-moved-any-root-path-at? rest root-id)))))

(define (tc-moved-any-root-path? [set : TcMovedSet] [root-id : i64]) : bool
  (tc-moved-any-root-path-at? (tc-moved-paths set) root-id))

(define (tc-moved-root-path-conflict-loop
  [facts : TcMovedPathFacts]
  [root-id : i64]) : TcMoveConflict
  (if (tc-moved-path-facts-empty? facts)
    No
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      (if (and
        (match fact.kind
          [(Move) true]
          [_ false])
        (= (tc-move-path-root-id fact.path) root-id))
        (Some (tc-move-path-render fact.path) (tc-moved-path-fact-origin fact))
        (tc-moved-root-path-conflict-loop rest root-id)))))

(define (tc-moved-root-path-conflict [set : TcMovedSet] [root-id : i64]) : TcMoveConflict
  (tc-moved-root-path-conflict-loop (tc-moved-paths set) root-id))

(define (tc-moved-root-conflict [set : TcMovedSet] [root-id : i64]) : TcMoveConflict
  (match (tc-moved-conflict (tc-global-shared-view set) root-id)
    [(Some key origin-id) (Some key origin-id)]
    [No
      (match (tc-moved-root-path-conflict (tc-global-shared-view set) root-id)
        [(Some key origin-id) (Some key origin-id)]
        [No (tc-moved-partial-conflict set root-id)])]))

(define (tc-moved-remove-exact-path
  [set : TcMovedSet]
  [root-id : i64]
  [path : TcMovePath]) : TcMovedSet
  (let
    [without-path : TcMovedSet (tc-moved-remove-path-kind set path (Move))]
    (if (tc-moved-any-root-path? (tc-global-shared-view without-path) root-id)
      without-path
      (tc-moved-remove-partial without-path root-id))))

(define (tc-moved-union-path-loop [a : TcMovedPathFacts] [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? a)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head a)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest a)]
      (tc-moved-union-path-loop
        rest
        (tc-moved-add-path-fact
          out
          fact.path
          fact.kind
          (tc-moved-path-fact-origin fact))))))

(define (tc-moved-union-id-loop
  [a : (& a tc_i64_i64_map.Map)]
  [index : i64]
  [out : tc_i64_i64_map.Map]) : tc_i64_i64_map.Map
  ;; Counting down the entry count skips the scan-to-capacity tail entirely;
  ;; branch moved-sets are usually empty or tiny.
  (let
    [remaining : i64 (tc_i64_i64_map.len a)]
    [cursor : i64 index]
    ;; Only take private storage when there is something to insert; a union with
    ;; an empty left side leaves the (possibly shared) right side untouched.
    [result : tc_i64_i64_map.Map
      (if (> remaining 0)
        (tc-moved-id-map-own out)
        out)]
    (while (> remaining 0)
      (set! cursor (tc_i64_i64_map.next-occupied a cursor))
      (match (tc_i64_i64_map.entry-at a cursor)
        [(EntrySome key value)
          (tc_i64_i64_map.insert-ref! (&mut result) key value)]
        [(EntryNone) unit])
      (set! cursor (+ cursor 1))
      (set! remaining (- remaining 1)))
    result))

;; Union keeps the left input's value for duplicate facts. Branch merging
;; therefore reports the origin from the first/left arm deterministically.
(define (tc-moved-union [a : (& a TcMovedSet)] [b : TcMovedSet]) : TcMovedSet
  (let
    [a : TcMovedSet (owned_view.compiler-owned-reference-shared-view a)]
    [a-roots : tc_i64_i64_map.Map (tc-moved-roots (tc-global-shared-view a))]
    [a-partials : tc_i64_i64_map.Map
      (tc-moved-partials (tc-global-shared-view a))]
    [a-paths : TcMovedPathFacts (tc-moved-paths (tc-global-shared-view a))]
    [a-hidden : tc_i64_i64_map.Map
      (tc-moved-hidden-atomic-users (tc-global-shared-view a))]
    [b-roots : tc_i64_i64_map.Map (tc-moved-roots (tc-global-shared-view b))]
    [b-partials : tc_i64_i64_map.Map
      (tc-moved-partials (tc-global-shared-view b))]
    [b-paths : TcMovedPathFacts (tc-moved-paths (tc-global-shared-view b))]
    [b-hidden : tc_i64_i64_map.Map
      (tc-moved-hidden-atomic-users (tc-global-shared-view b))]
    [origins : i64
      (tc-param-storage-origins-union
        (tc-moved-param-storage-origins a)
        (tc-moved-param-storage-origins b))]
    [with-a-paths : TcMovedSet
      (TcMovedSet
        (tc-global-shared-view b-roots)
        (tc-global-shared-view b-partials)
        a-paths
        (tc-global-shared-view b-hidden)
        origins)]
    [with-paths : TcMovedSet (tc-moved-union-path-loop b-paths with-a-paths)]
    (TcMovedSet
      (tc-moved-union-id-loop (& a-roots) 0 b-roots)
      (tc-moved-union-id-loop (& a-partials) 0 b-partials)
      (tc-moved-paths with-paths)
      (tc-moved-union-id-loop (& a-hidden) 0 b-hidden)
      origins)))

;; Branch joins compare an arm's state with the state at branch entry, and an
;; arm that cannot reach the join is dropped from it (see `tc-move-join-if`).
;; Origins are diagnostic payload, so only keys and exact path facts take part
;; in the comparison; equal sizes make the one-directional test an equality.
(define (tc-moved-id-map-keys-subset?
  [a : (& a tc_i64_i64_map.Map)]
  [b : (& b tc_i64_i64_map.Map)]) : bool
  (let
    [remaining : i64 (tc_i64_i64_map.len a)]
    [cursor : i64 0]
    [subset? : bool true]
    (while (and subset? (> remaining 0))
      (set! cursor (tc_i64_i64_map.next-occupied a cursor))
      (match (tc_i64_i64_map.entry-at a cursor)
        [(EntrySome key _)
          (if (tc_i64_i64_map.contains? b key)
            unit
            (set! subset? false))]
        [(EntryNone) unit])
      (set! cursor (+ cursor 1))
      (set! remaining (- remaining 1)))
    subset?))

(define (tc-moved-path-facts-subset?
  [a : TcMovedPathFacts]
  [b : TcMovedPathFacts]) : bool
  (if (tc-moved-path-facts-empty? a)
    true
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head a)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest a)]
      (if (tc-moved-path-facts-contains-exact-kind?
        (tc-global-shared-view b)
        fact.path
        fact.kind)
        (tc-moved-path-facts-subset? rest b)
        false))))

(define (tc-moved-id-map-same-keys?
  [a : (& a tc_i64_i64_map.Map)]
  [b : (& b tc_i64_i64_map.Map)]) : bool
  (let
    [len : i64 (tc_i64_i64_map.len a)]
    (and
      (= len (tc_i64_i64_map.len b))
      (or (= len 0) (tc-moved-id-map-keys-subset? a b)))))

;; Runs at every branch join, where both sides are nearly always empty. The sets
;; are borrowed so the comparison copies no map; the caller passes views of the
;; two path snapshots, which cannot be read through the borrow. Cheap components
;; are compared first and an empty component is never walked.
(define (tc-moved-same-facts?
  [a : (& a TcMovedSet)]
  [b : (& b TcMovedSet)]
  [a-paths : TcMovedPathFacts]
  [b-paths : TcMovedPathFacts]) : bool
  (let
    [path-len : i64 (tc-moved-path-facts-len (tc-global-shared-view a-paths))]
    (and
      (tc-moved-id-map-same-keys? (& a.roots) (& b.roots))
      (= path-len (tc-moved-path-facts-len (tc-global-shared-view b-paths)))
      (= a.param-storage-origins b.param-storage-origins)
      (tc-moved-id-map-same-keys? (& a.partials) (& b.partials))
      (tc-moved-id-map-same-keys?
        (& a.hidden-atomic-users)
        (& b.hidden-atomic-users))
      (or (= path-len 0) (tc-moved-path-facts-subset? a-paths b-paths)))))

;; Every fact of `a` is also in `b`: `b` removed nothing that `a` holds.
(define (tc-moved-facts-subset?
  [a : (& a TcMovedSet)]
  [b : (& b TcMovedSet)]
  [a-paths : TcMovedPathFacts]
  [b-paths : TcMovedPathFacts]) : bool
  (and
    (= a.param-storage-origins b.param-storage-origins)
    (tc-moved-id-map-keys-subset? (& a.roots) (& b.roots))
    (tc-moved-id-map-keys-subset? (& a.partials) (& b.partials))
    (tc-moved-id-map-keys-subset?
      (& a.hidden-atomic-users)
      (& b.hidden-atomic-users))
    (tc-moved-path-facts-subset? a-paths b-paths)))

(define (tc-move-var-move-only-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [name-id : i64]) : bool
  (match (tc-lookup-id env name-id)
    [(Ok ty)
      (or
        (tc-move-local-or-type-move-only?
          ctx
          locals
          name-id
          (tc-global-shared-view ty))
        (and (tc-arena-type? ctx ty) (tc-move-arena-owner-local? env name-id)))]
    [(Err _) false]))

;; A direct local owner tracked from `arena.make`/`arena.make-atomic`. A bare
;; `arena.Arena` handle is Copy, but a copy stored in another binding, an
;; aggregate or a result would outlive the owner's destroy or rewind, so storing
;; the owner moves it like a move-only value. Passing it to a bare-Arena
;; parameter stays a borrow: call arguments move only for move-only parameters.
(define (tc-move-arena-owner-local? [env : TcTypeEnv] [name-id : i64]) : bool
  (or
    (tc-ordinary-arena-owner-active-id? env name-id)
    (tc-atomic-arena-owner-active-id? env name-id)))

;; Whether `expr` is a bare reference to a tracked arena owner local.
(define (tc-move-arena-owner-var?
  [expr-bases : i64]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]) : bool
  (match (tc-move-bare-var expr-bases expr)
    [(Some v-id _) (tc-move-arena-owner-local? env v-id)]
    [(No) false]))

;; The bare variable named by an init/rhs expression, unwrapping spans and
;; annotations, or none if the expression is not a whole-variable reference.
(define (tc-move-bare-var [expr-bases : i64] [expr : ast.AstExpr]) : TcMaybeMoveName
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(Ann inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-move-bare-var expr-bases inner))]
    [(Var name) (Some name (tc-env-key-name-text name))]
    [_ (No)]))

;; The root local named by a projection chain. Keep its parser-owned ID through
;; recursive projection unwrapping; String path analysis renders only at its
;; compatibility boundary below.
(define (tc-move-root-projection-var-id [expr-bases : i64] [expr : ast.AstExpr]) : TcMaybeNameId
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(or (Ann inner-box _) (Cast inner-box _) (StructGet inner-box _)
         (TupleRef inner-box _) (BoxGet inner-box) (BoxTake inner-box))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-move-root-projection-var-id expr-bases inner))]
    [(ArrayRef array-box _)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        (tc-move-root-projection-var-id expr-bases array))]
    [(Var name) (Some name)]
    [_ (No)]))

(define (tc-move-dynamic-array-element-message) : String
  (tc-kind-message
    (ResourceOwnership)
    "typecheck: cannot move owner-consuming value out of dynamic array element"))

(define (tc-move-box-projection-message) : String
  (tc-kind-message
    (ResourceOwnership)
    "typecheck: cannot move owner-consuming value out of box"))

(define (tc-move-aggregate-path-message) : String
  (tc-kind-message
    (ResourceOwnership)
    "typecheck: cannot move owner-consuming value out of aggregate path"))

(define (tc-move-aggregate-path-projection?
  [expr-bases : i64]
  [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(or (Ann inner-box _) (Cast inner-box _))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-move-aggregate-path-projection? expr-bases inner))]
    [(or (StructGet _ _) (TupleRef _ _) (ArrayRef _ _) (BoxGet _)) true]
    [_ false]))

(define (tc-move-path-segments-append
  [segments : TcMovePathSegments]
  [kind : i64]
  [value : i64]) : TcMovePathSegments
  (let
    [address : i64
      (if (= segments.store-address 0)
        (tc-move-path-segment-store-new)
        segments.store-address)]
    [data : TcMovePathSegmentStoreData
      (tc-move-path-segment-store-read address)]
    [index : i64 data.len]
    (tc-move-path-segment-store-grow! (&mut data) (+ index 1))
    (set!
      (array-ref data.nodes index)
      (TcMovePathSegmentNode segments.tail kind value))
    (set! data.len (+ index 1))
    (tc-move-path-segment-store-write! address data)
    (TcMovePathSegments address index (+ segments.len 1))))

(define (tc-move-path-segments-append-field
  [segments : TcMovePathSegments]
  [field-id : i64]) : TcMovePathSegments
  (tc-move-path-segments-append
    segments
    tc-move-path-segment-kind-field
    field-id))

(define (tc-move-path-segments-append-tuple
  [segments : TcMovePathSegments]
  [tuple-index : i64]) : TcMovePathSegments
  (tc-move-path-segments-append
    segments
    tc-move-path-segment-kind-tuple
    tuple-index))

(define (tc-move-path-segments-append-array
  [segments : TcMovePathSegments]
  [array-index : i64]) : TcMovePathSegments
  (tc-move-path-segments-append
    segments
    tc-move-path-segment-kind-array
    array-index))

(define (tc-move-path-segments-append-slice-split
  [segments : TcMovePathSegments]
  [split-id : i64]) : TcMovePathSegments
  (tc-move-path-segments-append
    segments
    tc-move-path-segment-kind-slice-split
    split-id))

(define (tc-move-path-segments-append-slice-half
  [segments : TcMovePathSegments]
  [half : i64]) : TcMovePathSegments
  (tc-move-path-segments-append
    segments
    tc-move-path-segment-kind-slice-half
    half))

(define (tc-move-path-append [base : TcMovePath] [field-id : i64]) : TcMovePath
  (TcMovePath
    base.root
    (tc-move-path-segments-append-field base.segments field-id)))

(define (tc-move-tuple-index-path [base : TcMovePath] [index : i64]) : TcMovePath
  (TcMovePath
    base.root
    (tc-move-path-segments-append-tuple base.segments index)))

(define (tc-move-array-index-path [base : TcMovePath] [index : i64]) : TcMovePath
  (TcMovePath
    base.root
    (tc-move-path-segments-append-array base.segments index)))

(define (tc-move-slice-split-half-path
  [base : TcMovePath]
  [split-id : i64]
  [half : i64]) : TcMovePath
  (TcMovePath
    base.root
    (tc-move-path-segments-append-slice-half
      (tc-move-path-segments-append-slice-split base.segments split-id)
      half)))

(define (tc-move-path-slice-half? [path : TcMovePath] [half : i64]) : bool
  (let
    [segments : TcMovePathSegments path.segments]
    (if (< segments.len 2)
      false
      (let
        [half-node : TcMovePathSegmentNode
          (tc-move-path-segments-node segments segments.tail)]
        (if (and
          (= half-node.kind tc-move-path-segment-kind-slice-half)
          (= half-node.value half)
          (>= half-node.parent 0))
          (let
            [split-node : TcMovePathSegmentNode
              (tc-move-path-segments-node segments half-node.parent)]
            (= split-node.kind tc-move-path-segment-kind-slice-split))
          false)))))

(define (tc-move-literal-index [expr-bases : i64] [expr : ast.AstExpr]) : TcMoveMaybeIndex
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(or (Ann inner-box _) (Cast inner-box _))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-move-literal-index expr-bases inner))]
    [(Literal lit)
      (match lit
        [(Int index text)
          (Some (ast.ast-int-literal-value-or-payload index text))]
        [_ (No)])]
    [_ (No)]))

(define (tc-move-direct-root-base-path [expr-bases : i64] [expr : ast.AstExpr]) : TcMaybeMovePath
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(or (Ann inner-box _) (Cast inner-box _))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-move-direct-root-base-path expr-bases inner))]
    [(StructGet inner-box field)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (match (tc-move-direct-root-base-path expr-bases inner)
          [(Some base) (Some (tc-move-path-append base field))]
          [(No) (No)]))]
    [(TupleRef inner-box index)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (match (tc-move-direct-root-base-path expr-bases inner)
          [(Some base) (Some (tc-move-tuple-index-path base index))]
          [(No) (No)]))]
    [(ArrayRef array-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index-expr : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (match (tc-move-direct-root-base-path expr-bases array)
          [(Some base)
            (match (tc-move-literal-index expr-bases index-expr)
              [(Some index) (Some (tc-move-array-index-path base index))]
              [(No) (No)])]
          [(No) (No)]))]
    [(Var name) (Some (TcMovePath name (tc-move-path-segments-empty)))]
    [_ (No)]))

(define (tc-move-struct-field-path [expr-bases : i64] [expr : ast.AstExpr]) : TcMaybeMovePath
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(or (Ann inner-box _) (Cast inner-box _))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-move-struct-field-path expr-bases inner))]
    [(StructGet inner-box field)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (match (tc-move-direct-root-base-path expr-bases inner)
          [(Some base) (Some (tc-move-path-append base field))]
          [(No) (No)]))]
    [_ (No)]))

(define (tc-move-tuple-element-path [expr-bases : i64] [expr : ast.AstExpr]) : TcMaybeMovePath
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(or (Ann inner-box _) (Cast inner-box _))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-move-tuple-element-path expr-bases inner))]
    [(TupleRef inner-box index)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (match (tc-move-direct-root-base-path expr-bases inner)
          [(Some base) (Some (tc-move-tuple-index-path base index))]
          [(No) (No)]))]
    [_ (No)]))

(define (tc-move-array-element-path [expr-bases : i64] [expr : ast.AstExpr]) : TcMaybeMovePath
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(or (Ann inner-box _) (Cast inner-box _))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-move-array-element-path expr-bases inner))]
    [(ArrayRef array-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index-expr : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (tc-move-array-set-path expr-bases array index-expr))]
    [_ (No)]))

(define (tc-move-array-set-path
  [expr-bases : i64]
  [array : ast.AstExpr]
  [index-expr : ast.AstExpr]) : TcMaybeMovePath
  (match (tc-move-direct-root-base-path expr-bases array)
    [(Some base)
      (match (tc-move-literal-index expr-bases index-expr)
        [(Some index) (Some (tc-move-array-index-path base index))]
        [(No) (No)])]
    [(No) (No)]))

(define (tc-move-struct-set-path
  [expr-bases : i64]
  [receiver : ast.AstExpr]
  [field-id : i64]) : TcMaybeMovePath
  (match (tc-move-direct-root-base-path expr-bases receiver)
    [(Some base)
      (Some
        (if (ast.ast-tuple-set-field-id? field-id)
          (tc-move-tuple-index-path
            base
            (ast.ast-tuple-set-index-from-field-id field-id))
          (tc-move-path-append base field-id)))]
    [(No) (No)]))

(define (tc-move-reinitialize-array-set-path
  [expr-bases : i64]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [array : ast.AstExpr]
  [index : ast.AstExpr]) : TcMovedSet
  (match (tc-move-array-set-path expr-bases (tc-global-shared-view array) index)
    [(Some path)
      (match (tc-move-root-projection-var-id expr-bases array)
        [(Some root-id)
          (if (tc-moved-contains? locals root-id)
            (tc-moved-remove-exact-path moved root-id path)
            moved)]
        [(No) moved])]
    [(No) moved]))

(define (tc-move-reinitialize-struct-set-path
  [expr-bases : i64]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [receiver : ast.AstExpr]
  [field-id : i64]) : TcMovedSet
  (match (tc-move-struct-set-path
    expr-bases
    (tc-global-shared-view receiver)
    field-id)
    [(Some path)
      (match (tc-move-root-projection-var-id expr-bases receiver)
        [(Some root-id)
          (if (tc-moved-contains? locals root-id)
            (tc-moved-remove-exact-path moved root-id path)
            moved)]
        [(No) moved])]
    [(No) moved]))

(define (tc-move-reinitialize-place-path
  [expr-bases : i64]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [place : ast.AstExpr]) : TcMovedSet
  (match (tc-move-direct-root-base-path expr-bases place)
    [(Some path)
      (if (tc-moved-contains? locals path.root)
        (if (= path.segments.len 0)
          (tc-moved-remove-root-state moved path.root)
          (tc-moved-remove-exact-path moved path.root path))
        moved)]
    [(No) moved]))

;; replace! must snapshot an initialized old value. A whole root conflicts with
;; every outstanding partial move, a tracked projection conflicts with moved
;; ancestors/descendants, and a runtime-indexed place conservatively conflicts
;; with any moved path under the same root.
(define (tc-move-check-replace-place-initialized
  [expr-bases : i64]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [place : ast.AstExpr]) : TcMoveResult
  (match (tc-move-direct-root-base-path
    expr-bases
    (tc-global-shared-view place))
    [(Some path)
      (if (tc-moved-contains? locals path.root)
        (match (tc-moved-path-conflict (tc-global-shared-view moved) path)
          [(Some key origin-id)
            (tc-move-rich-use-conflict-result
              expr-bases
              (Some key origin-id)
              (tc-move-path-render path)
              place
              (tc-move-path-render path))]
          [No
            (if (and
              (= path.segments.len 0)
              (or
                (tc-moved-contains? moved path.root)
                (tc-moved-partial? moved path.root)))
              (tc-move-rich-use-conflict-result
                expr-bases
                (tc-moved-root-conflict moved path.root)
                (tc-move-path-render path)
                place
                (tc-move-path-render path))
              (Ok moved))])
        (Ok moved))]
    [(No)
      (match (tc-move-root-projection-var-id
        expr-bases
        (tc-global-shared-view place))
        [(Some root-id)
          (if (and
            (tc-moved-contains? locals root-id)
            (or
              (tc-moved-contains? moved root-id)
              (tc-moved-partial? moved root-id)))
            (tc-move-rich-use-conflict-result
              expr-bases
              (tc-moved-root-conflict moved root-id)
              (tc-hygiene-name-text-id root-id)
              place
              (tc-hygiene-name-text-id root-id))
            (Ok moved))]
        [(No) (Ok moved)])]))

(define (tc-move-projection-path [expr-bases : i64] [expr : ast.AstExpr]) : TcMaybeMovePath
  (match (tc-move-struct-field-path expr-bases (tc-global-shared-view expr))
    [(Some path) (Some path)]
    [(No)
      (match (tc-move-tuple-element-path
        expr-bases
        (tc-global-shared-view expr))
        [(Some path) (Some path)]
        [(No) (tc-move-array-element-path expr-bases expr)])]))

(define (tc-moved-add-projection-path
  [moved : TcMovedSet]
  [root-id : i64]
  [path : TcMovePath]
  [origin : ast.AstExpr]) : TcMovedSet
  (let
    [origin-id : i64 (ast.ast-node-push origin)]
    (tc-moved-add-partial-value
      (tc-moved-add-path-fact moved path (Move) origin-id)
      root-id
      origin-id)))

(define (tc-move-box-projection? [expr-bases : i64] [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(or (Ann inner-box _) (Cast inner-box _) (StructGet inner-box _)
         (TupleRef inner-box _))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-move-box-projection? expr-bases inner))]
    [(ArrayRef array-box _)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        (tc-move-box-projection? expr-bases array))]
    [(BoxGet _) true]
    [_ false]))

(define (tc-move-dynamic-array-element-projection?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(or (Ann inner-box _) (Cast inner-box _) (StructGet inner-box _)
         (TupleRef inner-box _) (BoxGet inner-box))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-move-dynamic-array-element-projection? ctx expr-bases env inner))]
    [(ArrayRef array-box _)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        (match (tc-expr ctx env (tc-global-shared-view array))
          [(Ok array-ty)
            (match (tc-type-strip-region (tc-resolve-type ctx array-ty))
              [(DynArray _) true]
              [_
                (tc-move-dynamic-array-element-projection?
                  ctx
                  expr-bases
                  env
                  array)])]
          [(Err _)
            (tc-move-dynamic-array-element-projection? ctx expr-bases env array)]))]
    [_ false]))

;; The names that are genuine local/parameter bindings, seeded from a function's
;; parameter list. Only these acquire moved state. Enum constructors and function
;; references share the variable syntax but are not places; ordinary value
;; globals are permanent places and are classified separately below so ownership
;; transfer from them can be rejected without ever marking the global moved.
(define (tc-move-params-locals
  [params : (& params ast.AstParamList)]
  [acc : TcMovedSet]) : TcMovedSet
  (tc-move-params-locals-at (& params) 0 acc))

(define (tc-move-params-locals-at
  [params : (& params ast.AstParamList)]
  [index : i64]
  [acc : TcMovedSet]) : TcMovedSet
  (if (>= index (ast.ast-param-list-len params))
    acc
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param name ty _)
        (tc-move-params-locals-at
          params
          (+ index 1)
          (if (tc-invalidate-types-present?)
            (match (tc-type-invalidate-lifetime (tc-global-shared-view ty))
              [(Some lifetime)
                (tc-move-bind-invalidate-obligation acc name lifetime)]
              [(No) (tc-moved-add acc name)])
            (tc-moved-add acc name)))])))

(define (tc-param-storage-type? [ctx : TcContext] [ty : ast.AstType]) : bool
  (let
    [unwrapped : ast.AstType ty]
    (if (tc-poison-type? (tc-global-shared-view unwrapped))
      false
      (tc-param-storage-resolved? ctx (tc-resolve-type ctx unwrapped)))))

;; Whether a by-value parameter or argument of resolved type needs private
;; storage (#7901): a memory-class struct or enum, which is passed as the
;; address of the caller's storage, that is also Copy. A move-only argument's
;; source is moved by the call, so no safe code can observe the callee write
;; to it, or a write to the source while the call runs; a Copy argument's
;; source stays usable. Every part of a Copy aggregate is Copy, so the places
;; that alias a seeded parameter pass this test too.
(define (tc-param-storage-resolved? [ctx : TcContext] [resolved : ast.AstType]) : bool
  (let
    [stripped : ast.AstType (tc-type-strip-region resolved)]
    (match (tc-global-shared-view stripped)
      [(or (Struct name) (StructArgs name _) (Enum name) (EnumArgs name _))
        (tc-body-param-storage-name? ctx name stripped)]
      [_ false])))

;; tc-param-storage-resolved? for nominal `name-id`, whose resolved type is
;; `ty`: memory-class (not register-resident) and Copy. Lifetime arguments
;; change neither. Every function's parameters ask, and a layout query walks
;; the type, so a resolved layout's answer is memoized in the arena the facts
;; started in; a layout not resolved yet counts as memory-class and is asked
;; again.
(define (tc-body-param-storage-name?
  [ctx : TcContext]
  [name-id : i64]
  [ty : ast.AstType]) : bool
  (let
    [state : TcBodyState (tc-context-body-state ctx)]
    [view : (Ptr TcBodyStateData) (tc-body-state-view state)]
    [ptr : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    [names : tc_i64_i64_map.Map
      (unsafe
        (deref view).param-facts)]
    (match (tc_i64_i64_map.get (& names) (tc-body-memory-class-key name-id))
      [(LookupFound known) (= known 1)]
      [(LookupMissing)
        (match (tc-inline-aggregate-layout-for-id ctx name-id)
          [(Ok layout)
            (let
              [memory? : bool
                (and
                  (not (tc-inline-aggregate-layout-register-resident? layout))
                  (tc-type-copyable? ctx ty))]
              [arena-id : i64
                (unsafe
                  (deref view).param-write-arena)]
              (when
                (!= arena-id 0)
                (in-arena
                  (arena.Arena arena-id)
                  (let
                    [grown : tc_i64_i64_map.Map
                      (unsafe
                        (deref view).param-facts)]
                    (tc_i64_i64_map.insert-ref!
                      (&mut grown)
                      (tc-body-memory-class-key name-id)
                      (if memory?
                        1
                        2))
                    (unsafe
                      (set! (deref ptr).param-facts grown)))))
              memory?)]
          [(Err _) (tc-type-copyable? ctx ty)])])))

(define (tc-param-storage-seed-params
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : (& params ast.AstParamList)]
  [moved : TcMovedSet]) : TcMovedSet
  ;; A by-value memory-class struct or enum parameter arrives as the address of
  ;; its caller's storage. Each starts as the origin of its own storage, so an
  ;; in-place write through it, or through a local that aliases part of it, is
  ;; noted against the parameter (tc-param-storage-note-write), and lowering
  ;; gives exactly the noted parameters private callee storage (#7901). Only
  ;; a declared type that names a type can be one; `env` binds the parameters
  ;; to their resolved types (tc-bind-params).
  (let
    [index : i64 0]
    [out : TcMovedSet moved]
    (while (< index (ast.ast-param-list-len params))
      (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
        [(Param name ty _)
          (when
            (and
              (match (tc-global-shared-view ty)
                [(or (Var _) (VarArgs _ _) (Struct _) (StructArgs _ _) (Enum _)
                     (EnumArgs _ _) (Region _ _) (Invalidate _ _))
                  true]
                [_ false])
              (match (tc-lookup-id env name)
                [(Ok bound) (tc-param-storage-resolved? ctx bound)]
                [(Err _) (tc-param-storage-type? ctx ty)]))
            (set! out (tc-param-storage-origin-bind-in-set out name name)))])
      (set! index (+ index 1)))
    out))

(define (tc-param-storage-fixed-array-type?
  [ctx : TcContext]
  [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(Array _ _) true]
    [_ false]))

(define (tc-param-storage-tuple-type? [ctx : TcContext] [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(Tuple _) true]
    [_ false]))

;; Return the original by-value memory-class nominal Struct/Enum parameter
;; whose ABI backing storage contains this place. Only those nominal
;; parameters are seeded/tracked here: by-value fixed arrays and tuples have
;; private callee storage. Tuple and fixed-array projections are inline and
;; inherit provenance only when rooted in a tracked nominal memory parameter;
;; dynamic-array/box/reference projections remain shallow handles and do not.
(define (tc-param-storage-place-origin
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [moved : TcMovedSet]
  [place : ast.AstExpr]) : TcMaybeNameId
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& place))
    [(Var name)
      (if (tc-dotted-place-name-id? ctx env name)
        (match (tc-dotted-local-field-expr-id-after-check
          (tc-context-structural-session ctx)
          name)
          [(Ok virtual-id)
            (tc-param-storage-place-origin
              ctx
              expr-bases
              env
              moved
              (ast.ast-expr-segment-bases-get expr-bases virtual-id))]
          [(Err _) No])
        (tc-param-storage-origin-in-set moved name))]
    [(or (Ann inner-box _) (Cast inner-box _))
      (tc-param-storage-place-origin
        ctx
        expr-bases
        env
        moved
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(StructGet receiver-box _)
      (let
        [receiver : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases receiver-box)]
        (match (tc-expr ctx env (tc-global-shared-view receiver))
          [(Ok receiver-ty)
            (if (tc-param-storage-type? ctx receiver-ty)
              (tc-param-storage-place-origin ctx expr-bases env moved receiver)
              No)]
          [(Err _) No]))]
    [(ArrayRef array-box _)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        (match (tc-expr ctx env (tc-global-shared-view array))
          [(Ok array-ty)
            (if (tc-param-storage-fixed-array-type? ctx array-ty)
              (tc-param-storage-place-origin ctx expr-bases env moved array)
              No)]
          [(Err _) No]))]
    [(TupleRef tuple-box _)
      (let
        [tuple : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases tuple-box)]
        (match (tc-expr ctx env (tc-global-shared-view tuple))
          [(Ok tuple-ty)
            (if (tc-param-storage-tuple-type? ctx tuple-ty)
              (tc-param-storage-place-origin ctx expr-bases env moved tuple)
              No)]
          [(Err _) No]))]
    [_ No]))

(define (tc-param-storage-origin-id
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [moved : TcMovedSet]
  [place : ast.AstExpr]) : i64
  (match (tc-param-storage-place-origin ctx expr-bases env moved place)
    [(Some parameter-id) parameter-id]
    [(No) -1]))

;; An in-place write through `place` -- a field, element or `replace!` write,
;; or a `&mut` borrow -- notes the by-value parameter whose storage it reaches,
;; if any.
(define (tc-param-storage-note-write
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [moved : TcMovedSet]
  [place : ast.AstExpr]) : unit
  (match (tc-param-storage-place-origin ctx expr-bases env moved place)
    [(Some parameter-id)
      (tc-body-param-write-note! (tc-context-body-state ctx) parameter-id)]
    [(No) unit]))

(define (tc-param-storage-note-array-write
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [moved : TcMovedSet]
  [array : ast.AstExpr]) : unit
  (match (tc-expr ctx env (tc-global-shared-view array))
    [(Ok array-ty)
      (when
        (tc-param-storage-fixed-array-type? ctx array-ty)
        (tc-param-storage-note-write ctx expr-bases env moved array))]
    [(Err _) unit]))

(define (tc-param-storage-rebind-from-init
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [moved : TcMovedSet]
  [name-id : i64]
  [binding-ty : ast.AstType]
  [init : ast.AstExpr]) : TcMovedSet
  (let
    [origin : TcMaybeNameId
      (if (tc-param-storage-type? ctx binding-ty)
        (tc-param-storage-place-origin
          ctx
          expr-bases
          env
          (tc-global-shared-view moved)
          init)
        No)]
    [cleared : TcMovedSet (tc-moved-remove-root-state moved name-id)]
    (match origin
      [(Some parameter-id)
        (tc-param-storage-origin-bind-in-set cleared name-id parameter-id)]
      [(No) cleared])))

(define (tc-param-storage-bind-pattern-names
  [ctx : TcContext]
  [env : TcTypeEnv]
  [moved : TcMovedSet]
  [names : TcNameIdList]
  [parameter-id : i64]) : TcMovedSet
  (if (< parameter-id 0)
    moved
    (let
      [cursor : TcNameIdList names]
      [out : TcMovedSet moved]
      (while (not (tc-name-id-list-empty? cursor))
        (let
          [name-id : i64 (tc-name-id-list-head cursor)]
          (match (tc-lookup-id env name-id)
            [(Ok ty)
              (if (tc-param-storage-type? ctx ty)
                (set!
                  out
                  (tc-param-storage-origin-bind-in-set out name-id parameter-id))
                unit)]
            [(Err _) unit])
          (set! cursor (tc-name-id-list-rest cursor))))
      out)))

;; Resolve source, hygiene, and qualified value names through the same immutable
;; symbol-table path used for direct calls. Extern values intentionally remain
;; outside this safe-global ownership rule; functions, dispatches, and enum
;; constructors are not global places either.
(define (tc-move-qualified-value-symbol-handle-id
  [ctx : TcContext]
  [name-id : i64]
  [fallback : i64]) : i64
  (let
    [alias-id : i64 (ci.intern-leading-dot-id name-id)]
    [base-id : i64 (ci.intern-dotted-final-id name-id)]
    [qualified-module-id : i64 (tc-qualified-name-module-id name-id)]
    [target-module-id : i64
      (match (tc-context-program ctx)
        [(Program decls-box)
          (match (tc-source-dotted-alias-target-id-in-context
            ctx
            (ast.ast-decl-list-box-shared-view decls-box)
            (tc-context-module-id ctx)
            alias-id)
            [(Some target-id) target-id]
            [(No) qualified-module-id])])]
    (if (or (< target-module-id 0) (< base-id 0))
      fallback
      (csym.compiler-symbols-lookup-value-in-module-id-or
        (tc-context-symbols ctx)
        target-module-id
        base-id
        fallback))))

(define (tc-move-value-symbol-handle-id
  [ctx : TcContext]
  [_env : TcTypeEnv]
  [name-id : i64]) : i64
  (let
    [lookup-id : i64
      (tc-env-name-key-id (tc-context-structural-session ctx) name-id)]
    (if (macro-hygiene-global-id? (tc-context-structural-session ctx) name-id)
      (csym.compiler-symbols-lookup-value-id-or
        (tc-context-symbols ctx)
        lookup-id
        (csym.compiler-symbols-missing-handle))
      (if (or
        (tc-name-qualified-id? (tc-context-structural-session ctx) name-id)
        (>=
          (tc-name-first-dot-id (tc-context-structural-session ctx) name-id)
          0))
        (let
          [direct : i64
            (csym.compiler-symbols-lookup-value-id-or
              (tc-context-symbols ctx)
              lookup-id
              (csym.compiler-symbols-missing-handle))]
          (if (csym.compiler-symbols-handle-found? direct)
            direct
            (tc-move-qualified-value-symbol-handle-id
              ctx
              name-id
              (csym.compiler-symbols-missing-handle))))
        (let
          [module-id : i64 (tc-context-module-id ctx)]
          (csym.compiler-symbols-lookup-value-in-module-id-or
            (tc-context-symbols ctx)
            module-id
            lookup-id
            (csym.compiler-symbols-missing-handle)))))))

(define (tc-move-ordinary-global-value-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (let
    [handle : i64 (tc-move-value-symbol-handle-id ctx env name-id)]
    (and
      (csym.compiler-symbols-handle-found? handle)
      (=
        (csym.compiler-symbol-handle-kind handle)
        (csym.compiler-symbol-kind-value-define)))))

(define (tc-move-global-source-name [name-id : i64]) : String
  (tc-hygiene-global-symbol-name (tc-hygiene-name-text-id name-id)))

(define (tc-move-global-source-message [name-id : i64]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (MoveViolation))
    "typecheck: cannot move out of global `"
    (tc-move-global-source-name name-id)
    "`; borrow the global instead"))

(define (tc-move-global-source-root?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [root-id : i64]) : bool
  (and
    (not (tc-moved-contains? locals root-id))
    (or
      (tc-env-key-has-name-id? root-id)
      (macro-hygiene-global-id? (tc-context-structural-session ctx) root-id))
    (tc-move-ordinary-global-value-id? ctx env root-id)))

;; A Copy projection may be read from a non-Copy global, so the value type gates
;; the root classification. Explicit/auto borrow expressions have no movable
;; root here and reference-typed targets call this with `move? = false`.
(define (tc-move-check-global-source
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [expr : ast.AstExpr]
  [move? : bool]) : TcMoveResult
  (if move?
    (match (tc-move-root-projection-var-id
      expr-bases
      (tc-global-shared-view expr))
      [(Some root-id)
        (if (tc-move-global-source-root? ctx env locals root-id)
          (tc-move-global-source-result ctx expr-bases env moved expr root-id)
          (Ok moved))]
      [(No) (Ok moved)])
    (Ok moved)))

(define (tc-move-global-source-result
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [moved : TcMovedSet]
  [expr : ast.AstExpr]
  [root-id : i64]) : TcMoveResult
  ;; A raw pointer held by the global is copied, not moved.
  (if (tc-raw-deref-place? ctx env (tc-global-shared-view expr))
    (Ok moved)
    (Err
      (tc-locate-error-at-expr
        expr-bases
        expr
        (tc-move-global-source-message root-id)))))

(define (tc-move-check-replace-global-source
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [place : ast.AstExpr]) : TcMoveResult
  (match (tc-replace-place-value-type ctx env (tc-global-shared-view place))
    [(Ok place-ty)
      (tc-move-check-global-source
        ctx
        expr-bases
        env
        locals
        moved
        place
        (tc-type-move-only? ctx (tc-resolve-type ctx place-ty)))]
    [(Err _) (Ok moved)]))

(define (tc-move-after-consuming-projection
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : ast.AstExpr]) : TcMoveResult
  (if (tc-move-dynamic-array-element-projection?
    ctx
    expr-bases
    env
    (tc-global-shared-view expr))
    (Err (tc-move-dynamic-array-element-message))
    (if (tc-move-box-projection? expr-bases (tc-global-shared-view expr))
      (Err (tc-move-box-projection-message))
      (match (tc-move-projection-path expr-bases (tc-global-shared-view expr))
        [(Some path)
          (match (tc-move-root-projection-var-id
            expr-bases
            (tc-global-shared-view expr))
            [(Some root-id)
              (if (tc-moved-contains? locals root-id)
                (match (tc-moved-path-conflict
                  (tc-global-shared-view moved)
                  path)
                  [(Some key origin-id)
                    (tc-move-rich-use-conflict-result
                      expr-bases
                      (Some key origin-id)
                      (tc-move-path-render path)
                      expr
                      (tc-move-path-render path))]
                  [No
                    (Ok (tc-moved-add-projection-path moved root-id path expr))])
                (Ok moved))]
            [(No) (Ok moved)])]
        [(No)
          (if (tc-move-aggregate-path-projection?
            expr-bases
            (tc-global-shared-view expr))
            ;; A read through a raw pointer copies the value's bits and moves
            ;; nothing, as `ptr-read` does; ownership is the caller's
            ;; obligation.
            (if (tc-raw-deref-place? ctx env (tc-global-shared-view expr))
              (Ok moved)
              (Err (tc-move-aggregate-path-message)))
            (match (tc-move-root-projection-var-id
              expr-bases
              (tc-global-shared-view expr))
              [(Some root-id)
                (let
                  [root : String (tc-env-key-name-text root-id)]
                  (if (tc-moved-contains? locals root-id)
                    (if (tc-moved-partial? moved root-id)
                      (tc-move-rich-use-conflict-result
                        expr-bases
                        (tc-moved-root-conflict moved root-id)
                        (tc-global-shared-view root)
                        expr
                        root)
                      (if (tc-moved-contains? loop-carried root-id)
                        (tc-move-rich-loop-carried-result expr-bases root expr)
                        (Ok (tc-moved-add-origin moved root-id expr))))
                    (Ok moved)))]
              [(No) (Ok moved)]))]))))

(define (tc-move-after-bind-typed
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [init : ast.AstExpr]
  [init-ty : ast.AstType]) : TcMoveResult
  (let
    [move? : bool
      (or
        (tc-type-move-only? ctx (tc-global-shared-view init-ty))
        (and
          (tc-move-value-move-only?
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            (tc-global-shared-view init)
            (tc-resolve-type ctx (tc-global-shared-view init-ty)))
          (match (tc-move-tuple-element-path
            expr-bases
            (tc-global-shared-view init))
            [(Some _) true]
            [(No) false])))]
    [moved1
      (try
        (tc-move-check-global-result-expr
          ctx
          expr-bases
          env
          (tc-global-shared-view locals)
          (tc-global-shared-view loop-carried)
          Nil
          moved
          (tc-global-shared-view init)
          init-ty
          ;; A place at the top is left to the consumer; the walk decides
          ;; at the first value form whether to move the leaves below it.
          (if move?
            -1
            1)))]
    (if move?
      (tc-move-after-consuming-projection
        ctx
        expr-bases
        env
        locals
        loop-carried
        moved1
        init)
      (Ok moved1))))

;; Mark the source variable moved when an init/rhs is a bare move-only variable
;; that names a tracked local/parameter. A bare non-Copy global is instead
;; rejected: its permanent place can be borrowed but cannot transfer ownership.
(define (tc-move-after-bind-id
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [init-id : i64]) : TcMoveResult
  (let
    [init : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases init-id)]
    (match (tc-move-bare-var expr-bases (tc-global-shared-view init))
      [(Some v-id v)
        (if (and
          (tc-move-var-move-only-id?
            ctx
            env
            (tc-global-shared-view locals)
            v-id)
          (tc-move-global-source-root?
            ctx
            env
            (tc-global-shared-view locals)
            v-id))
          (Err
            (tc-locate-error-at-expr
              expr-bases
              init
              (tc-move-global-source-message v-id)))
          (if (and
            (tc-moved-contains? locals v-id)
            (tc-move-var-move-only-id? ctx env locals v-id))
            (if (tc-moved-partial? moved v-id)
              (tc-move-rich-use-conflict-result
                expr-bases
                (tc-moved-root-conflict moved v-id)
                (tc-global-shared-view v)
                init
                v)
              (if (tc-moved-contains? loop-carried v-id)
                (tc-move-rich-loop-carried-result expr-bases v init)
                (Ok (tc-moved-add-origin moved v-id init))))
            (Ok moved)))]
      [(No)
        (match (tc-body-type-fact-expr-id "move.bind_init" ctx env init-id)
          [(Ok init-ty)
            (tc-move-after-bind-typed
              ctx
              expr-bases
              env
              locals
              loop-carried
              moved
              init
              init-ty)]
          [(Err _) (Ok moved)])])))

(define (tc-move-after-bind-known-type-id
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [init-id : i64]
  [init-ty : ast.AstType]) : TcMoveResult
  (let
    [init : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases init-id)]
    (match (tc-move-bare-var expr-bases (tc-global-shared-view init))
      [(Some v-id v)
        (if (and
          (tc-move-value-move-only?
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            (tc-global-shared-view init)
            (tc-resolve-type ctx init-ty))
          (tc-move-global-source-root?
            ctx
            env
            (tc-global-shared-view locals)
            v-id))
          (Err
            (tc-locate-error-at-expr
              expr-bases
              init
              (tc-move-global-source-message v-id)))
          (if (and
            (tc-moved-contains? locals v-id)
            (tc-move-var-move-only-id? ctx env locals v-id))
            (if (tc-moved-partial? moved v-id)
              (tc-move-rich-use-conflict-result
                expr-bases
                (tc-moved-root-conflict moved v-id)
                (tc-global-shared-view v)
                init
                v)
              (if (tc-moved-contains? loop-carried v-id)
                (tc-move-rich-loop-carried-result expr-bases v init)
                (Ok (tc-moved-add-origin moved v-id init))))
            (Ok moved)))]
      [(No)
        (tc-move-after-bind-typed
          ctx
          expr-bases
          env
          locals
          loop-carried
          moved
          init
          init-ty)])))

(define (tc-move-after-moving-value
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : ast.AstExpr]
  [move? : bool]
  [global-move? : bool]) : TcMoveResult
  (let
    [moved1
      (try
        (tc-move-check-global-source
          ctx
          expr-bases
          env
          (tc-global-shared-view locals)
          moved
          (tc-global-shared-view expr)
          global-move?))]
    (if move?
      (tc-move-after-consuming-projection
        ctx
        expr-bases
        env
        locals
        loop-carried
        moved1
        expr)
      (Ok moved1))))

(define (tc-move-global-source-target-move-only?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [expr : ast.AstExpr]
  [target-ty : ast.AstType]
  [value-ty : ast.AstType]) : bool
  (match (tc-global-shared-view target-ty)
    [(or (Ref _ _) (MutRef _ _)) false]
    [_
      (match (tc-move-root-projection-var-id
        expr-bases
        (tc-global-shared-view expr))
        [(Some root-id)
          (match (tc-move-bare-var expr-bases expr)
            [(Some _ _)
              (and
                (tc-move-global-source-root? ctx env locals root-id)
                (not
                  (or
                    (tc-move-global-target-shallow-copyable? ctx target-ty)
                    (tc-move-global-target-shallow-copyable? ctx value-ty))))]
            [(No)
              (and
                (tc-move-global-source-root? ctx env locals root-id)
                (not (tc-move-global-target-shallow-copyable? ctx value-ty)))])]
        [(No) false])]))

;; Global-place classification is deliberately allocation-free. In particular,
;; it must not instantiate nominal lifetime substitutions: those compatibility
;; types can otherwise escape a transient typecheck arena through persistent
;; layout caches. Ownership does not depend on the identity of a lifetime, so a
;; direct declaration walk is both sufficient and safer here.
(define (tc-move-global-copyable-type-list-at?
  [ctx : TcContext]
  [types : (& types ast.AstTypeList)]
  [depth : i64]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    true
    (and
      (tc-move-global-copyable-type?
        ctx
        (tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))
        depth)
      (tc-move-global-copyable-type-list-at? ctx types depth (+ index 1)))))

(define (tc-move-global-copyable-fields-at?
  [ctx : TcContext]
  [fields : (& fields ast.AstFieldDefList)]
  [depth : i64]
  [index : i64]) : bool
  (if (>= index (ast.ast-field-def-list-len fields))
    true
    (match (ast.ast-field-def-list-get
      fields
      index
      (ast.ast-field-def-fallback))
      [(Def _ ty _)
        (and
          (tc-move-global-copyable-type? ctx ty depth)
          (tc-move-global-copyable-fields-at? ctx fields depth (+ index 1)))])))

(define (tc-move-global-copyable-variants-at?
  [ctx : TcContext]
  [variants : (& variants ast.AstVariantDefList)]
  [depth : i64]
  [index : i64]) : bool
  (if (>= index variants.len)
    true
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(Def _ payloads _)
        (and
          (tc-move-global-copyable-type-list-at? ctx (& payloads) depth 0)
          (tc-move-global-copyable-variants-at? ctx variants depth (+ index 1)))])))

(define (tc-move-global-copyable-nominal?
  [ctx : TcContext]
  [name-id : i64]
  [depth : i64]) : bool
  (if (>= depth 64)
    false
    (let
      [handle : i64
        (csym.compiler-symbols-lookup-type-id-or
          (tc-context-symbols ctx)
          name-id
          (csym.compiler-symbols-missing-handle))]
      (if (not (csym.compiler-symbols-handle-found? handle))
        false
        (let
          [kind : i64 (csym.compiler-symbol-handle-kind handle)]
          [owner-ctx : TcContext
            (tc-context-with-nominal-owner-index-module
              ctx
              (csym.compiler-symbol-handle-index handle))]
          (if (not
            (or
              (= kind (csym.compiler-symbol-kind-defstruct))
              (= kind (csym.compiler-symbol-kind-defenum))))
            false
            (match (csym.compiler-symbols-decl-at-index
              (tc-context-symbols owner-ctx)
              (csym.compiler-symbol-handle-index handle))
              [(Ok decl)
                (match decl
                  [(or (DefStruct _ _ _ cleanup fields)
                       (DefStructLifetimes _ _ _ _ cleanup fields))
                    (and
                      (not (ast.ast-struct-cleanup? cleanup))
                      (tc-move-global-copyable-fields-at?
                        owner-ctx
                        (& fields)
                        (+ depth 1)
                        0))]
                  [(or (DefEnum _ _ cleanup variants)
                       (DefEnumLifetimes _ _ _ cleanup variants))
                    (and
                      (not (ast.ast-enum-cleanup? cleanup))
                      (tc-move-global-copyable-variants-at?
                        owner-ctx
                        (& variants)
                        (+ depth 1)
                        0))]
                  [_ false])]
              [(Err _) false])))))))

(define (tc-move-global-copyable-unresolved-name?
  [ctx : TcContext]
  [name-id : i64]
  [depth : i64]) : bool
  (if (< name-id 0)
    false
    (let
      [resolved : ast.AstType
        (tc-resolve-type-name
          ctx
          (tc-hygiene-name-text-id-for-session
            (tc-context-structural-session ctx)
            name-id)
          name-id)]
      (match (tc-global-shared-view resolved)
        [(or (Var resolved-id) (VarArgs resolved-id _))
          (if (= resolved-id name-id)
            false
            (tc-move-global-copyable-type? ctx resolved depth))]
        [_ (tc-move-global-copyable-type? ctx resolved depth)]))))

(define (tc-move-global-copyable-type?
  [ctx : TcContext]
  [target-ty : ast.AstType]
  [depth : i64]) : bool
  (match target-ty
    [(or (I64) (I32) (I16) (I8) (U64) (U32) (U16) (U8) (F64) (F32) (Bool) (Char)
         (Unit) (Never) (Expr) (ExprList) (CFunc _ _) (Func _ _) (Ptr _)
         (MutPtr _) (Ref _ _))
      true]
    [(MutRef _ _) false]
    [(or (Region _ inner) (Invalidate _ inner) (Array inner _))
      (tc-move-global-copyable-type? ctx (tc-context-type-get ctx inner) depth)]
    [(Tuple elems)
      (tc-move-global-copyable-type-list-at?
        ctx
        (& (__tl-box-place elems))
        depth
        0)]
    [(or (Enum name) (EnumArgs name _) (Struct name))
      (tc-move-global-copyable-nominal? ctx name depth)]
    [(StructArgs name lifetimes)
      (if (and
        (tc-arena-nominal-name-id? name)
        (> (tc-lifetime-list-count (deref lifetimes)) 0))
        false
        (tc-move-global-copyable-nominal? ctx name depth))]
    [(or (Var name) (VarArgs name _))
      (tc-move-global-copyable-unresolved-name? ctx name depth)]
    [_ false]))

(define (tc-move-global-target-shallow-copyable?
  [ctx : TcContext]
  [target-ty : ast.AstType]) : bool
  (tc-move-global-copyable-type? ctx target-ty 0))

(define (tc-move-after-consuming-value
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : ast.AstExpr]
  [target-ty : ast.AstType]) : TcMoveResult
  (let
    [closure-move-only : bool
      (tc-move-value-concrete-closure-move-only?
        ctx
        expr-bases
        env
        (tc-global-shared-view locals)
        (tc-global-shared-view expr))]
    (if closure-move-only
      (Err
        (tc-locate-error-at-expr
          expr-bases
          expr
          (tc-move-closure-escape-message)))
      (let
        [move? : bool
          (tc-call-param-moves-argument? ctx (tc-global-shared-view target-ty))]
        [moved1
          (try
            (tc-move-check-global-result-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view loop-carried)
              Nil
              moved
              (tc-global-shared-view expr)
              target-ty
              ;; A place at the top is left to the consumer; the walk decides
              ;; at the first value form whether to move the leaves below it.
              (if move?
                -1
                0)))]
        (tc-move-after-moving-value
          ctx
          expr-bases
          env
          locals
          loop-carried
          moved1
          expr
          move?
          false)))))

(define (tc-move-check-global-result
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [expr : ast.AstExpr]
  [target-ty : ast.AstType]) : TcMoveResult
  (tc-move-check-global-result-expr
    ctx
    expr-bases
    env
    locals
    (tc-moved-empty)
    Nil
    moved
    expr
    target-ty
    1))

(define (tc-move-after-move-only-value
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : ast.AstExpr]
  [target-ty : ast.AstType]) : TcMoveResult
  (let
    [closure-move-only : bool
      (tc-move-value-concrete-closure-move-only?
        ctx
        expr-bases
        env
        (tc-global-shared-view locals)
        (tc-global-shared-view expr))]
    (if closure-move-only
      (Err
        (tc-locate-error-at-expr
          expr-bases
          expr
          (tc-move-closure-escape-message)))
      (let
        [move? : bool
          (tc-type-move-only?
            ctx
            (tc-resolve-type ctx (tc-global-shared-view target-ty)))]
        [moved1
          (try
            (tc-move-check-global-result-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view loop-carried)
              Nil
              moved
              (tc-global-shared-view expr)
              target-ty
              ;; A place at the top is left to the consumer; the walk decides
              ;; at the first value form whether to move the leaves below it.
              (if move?
                -1
                1)))]
        (tc-move-after-moving-value
          ctx
          expr-bases
          env
          locals
          loop-carried
          moved1
          expr
          move?
          false)))))

(define (tc-move-after-match-scrutinee
  [ctx : TcContext]
  [expr-bases : i64]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [expr : ast.AstExpr]
  [scrut-ty : ast.AstType]) : TcMovedSet
  (match (tc-move-bare-var expr-bases (tc-global-shared-view expr))
    [(Some v-id _)
      (if (and
        (tc-moved-contains? locals v-id)
        (tc-type-move-only? ctx scrut-ty))
        (tc-moved-add-origin moved v-id expr)
        moved)]
    [(No) moved]))

(define (tc-move-consume-local
  [expr-bases : i64]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [name-id : i64]
  [origin : ast.AstExpr]) : TcMoveResult
  (if (tc-moved-contains? locals name-id)
    (if (or
      (tc-moved-contains? moved name-id)
      (tc-moved-partial? moved name-id))
      (let
        [name : String (tc-hygiene-name-text-id name-id)]
        (tc-move-rich-use-conflict-result
          expr-bases
          (tc-moved-root-conflict moved name-id)
          (tc-global-shared-view name)
          origin
          name))
      (if (tc-moved-contains? loop-carried name-id)
        (tc-move-rich-loop-carried-result
          expr-bases
          (tc-hygiene-name-text-id name-id)
          origin)
        (Ok (tc-moved-add-origin moved name-id origin))))
    (Ok moved)))

(define (tc-move-invalidate-local
  [expr-bases : i64]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [name-id : i64]
  [origin : ast.AstExpr]) : TcMoveResult
  (cond
    [(not (tc-moved-contains? locals name-id)) (Ok moved)]
    [(tc-moved-contains? moved name-id) (Ok moved)]
    [(tc-moved-partial? moved name-id)
      ;; Region invalidation does not read the remaining fields. Collapse an
      ;; already-partial local (including the owner field just consumed by
      ;; destroy-safe!) into one whole-root invalidation fact.
      (if (tc-moved-contains? loop-carried name-id)
        (tc-move-rich-loop-carried-result
          expr-bases
          (tc-hygiene-name-text-id name-id)
          origin)
        (Ok
          (tc-moved-add-origin
            (tc-moved-remove-root-state moved name-id)
            name-id
            origin)))]
    [(tc-moved-contains? loop-carried name-id)
      (tc-move-rich-loop-carried-result
        expr-bases
        (tc-hygiene-name-text-id name-id)
        origin)]
    [else (Ok (tc-moved-add-origin moved name-id origin))]))

(define (tc-move-mark-region-locals-scan
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [region : i64]
  [seen : TcNameIdList]
  [remaining : i64]
  [origin : ast.AstExpr]) : TcMoveResult
  (if (<= remaining 0)
    (Ok moved)
    (match (tc-type-env-marker-step env)
      [(Done) (Ok moved)]
      [(Cache rest-env)
        (tc-move-mark-region-locals-scan
          expr-bases
          rest-env
          locals
          loop-carried
          moved
          region
          seen
          remaining
          origin)]
      [(Bind key ty rest-env)
        (cond
          [(= key (tc-default-boundary-id)) (Ok moved)]
          [(tc-name-id-list-contains seen key)
            (tc-move-mark-region-locals-scan
              expr-bases
              rest-env
              locals
              loop-carried
              moved
              region
              seen
              remaining
              origin)]
          [(not (tc-moved-contains? locals key))
            (tc-move-mark-region-locals-scan
              expr-bases
              rest-env
              locals
              loop-carried
              moved
              region
              (tc-name-id-list-add seen key)
              remaining
              origin)]
          [(tc-type-contains-region ty region)
            (let
              [moved2
                (try
                  (tc-move-invalidate-local
                    expr-bases
                    (tc-global-shared-view locals)
                    (tc-global-shared-view loop-carried)
                    moved
                    key
                    (tc-global-shared-view origin)))]
              (tc-move-mark-region-locals-scan
                expr-bases
                rest-env
                locals
                loop-carried
                moved2
                region
                (tc-name-id-list-add seen key)
                (- remaining 1)
                origin))]
          [else
            (tc-move-mark-region-locals-scan
              expr-bases
              rest-env
              locals
              loop-carried
              moved
              region
              (tc-name-id-list-add seen key)
              (- remaining 1)
              origin)])])))

;; The innermost live `with` cleanup owner whose binding carries the brands
;; being invalidated, or -1: the brands `owner` owns when `owner` >= 0 (safe
;; destroy), otherwise the phase generation `region` (safe rewind). Such an
;; owner cannot simply be marked moved: its cleanup runs when its `with` scope
;; ends, after the arena is gone, whether or not the body mentions it again.
;; A marker directly follows its owner's binding, so `prev-key`/`prev-ty` is
;; the binding the marker belongs to. A shadowed owner is still live; a wholly
;; moved one is not, and a partially moved one still cleans up the rest.
(define (tc-move-live-cleanup-owner-in-region-scan
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [moved : TcMovedSet]
  [owner : i64]
  [region : i64]
  [prev-key : i64]
  [prev-ty : ast.AstType]
  [later : TcNameIdList]) : i64
  (match (tc-type-env-marker-step env)
    [(Done) -1]
    [(Cache rest-env)
      (tc-move-live-cleanup-owner-in-region-scan
        root
        rest-env
        moved
        owner
        region
        prev-key
        prev-ty
        later)]
    [(Bind key ty rest-env)
      (cond
        [(= key (tc-default-boundary-id)) -1]
        [(and
            (tc-cleanup-owner-marker-for?
              key
              (tc-global-shared-view ty)
              prev-key)
            (if (>= owner 0)
              (tc-type-contains-arena-owner-region?
                root
                (tc-global-shared-view prev-ty)
                owner)
              (tc-type-contains-region (tc-global-shared-view prev-ty) region))
            (or
              (tc-name-id-list-contains later prev-key)
              (not (tc-moved-contains? moved prev-key))))
          prev-key]
        [else
          (tc-move-live-cleanup-owner-in-region-scan
            root
            rest-env
            moved
            owner
            region
            key
            ty
            (if (>= prev-key 0)
              (tc-name-id-list-add later prev-key)
              later))])]))

(define (tc-move-live-cleanup-owner-in-region
  [env : TcTypeEnv]
  [moved : TcMovedSet]
  [owner : i64]
  [region : i64]) : i64
  (if (tc-cleanup-owner-markers-possible?)
    (tc-move-live-cleanup-owner-in-region-scan
      env
      env
      moved
      owner
      region
      -1
      (Unit)
      Nil)
    -1))

(define (tc-move-safe-invalidation-cleanup-owner-message
  [expr-bases : i64]
  [origin : ast.AstExpr]
  [operation : String]
  [arena : String]
  [name : String]) : String
  (let
    [message : String
      (str_cat.str-cat
        (cdiag.compiler-diagnostic-typecheck-tag (ArenaOwnership))
        "typecheck: "
        operation
        " cannot invalidate `"
        arena
        "` while `with` cleanup owner `"
        name
        "` holds values from it; the owner's cleanup runs when its `with` scope ends")]
    ;; A call node carries no span of its own; its arena argument does.
    (match (match (tc-expr-maybe-span expr-bases (tc-global-shared-view origin))
      [(Some span) (TcMaybeAstSourceSpan.Some span)]
      [(No)
        (match origin
          [(Call _ args)
            (if (ast.ast-expr-list-empty? (& args))
              TcMaybeAstSourceSpan.No
              (tc-expr-id-maybe-span
                expr-bases
                (ast.ast-expr-list-get (& args) 0 0)))]
          [_ TcMaybeAstSourceSpan.No])])
      [(Some span)
        (tc-rich-error-with-help
          span
          message
          "end the `with` scope before invalidating the arena, or allocate the owner in an arena that outlives the scope")]
      [(No) message])))

;; `arena` names the invalidated owner or phase in the diagnostic.
(define (tc-move-mark-region-locals
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [region : i64]
  [arena : String]
  [origin : ast.AstExpr]) : TcMoveResult
  (let
    [live-owner : i64
      (tc-move-live-cleanup-owner-in-region
        env
        (tc-global-shared-view moved)
        -1
        region)]
    (if (>= live-owner 0)
      (Err
        (tc-move-safe-invalidation-cleanup-owner-message
          expr-bases
          origin
          "arena.rewind-safe!"
          arena
          (tc-env-key-name-text live-owner)))
      (tc-move-mark-region-locals-scan
        expr-bases
        env
        (tc-global-shared-view locals)
        loop-carried
        moved
        region
        Nil
        (tc-moved-len locals)
        origin))))

(define (tc-move-mark-owner-region-locals-scan
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [owner : i64]
  [seen : TcNameIdList]
  [remaining : i64]
  [origin : ast.AstExpr]) : TcMoveResult
  (if (<= remaining 0)
    (Ok moved)
    (match (tc-type-env-marker-step env)
      [(Done) (Ok moved)]
      [(Cache rest-env)
        (tc-move-mark-owner-region-locals-scan
          expr-bases
          rest-env
          locals
          loop-carried
          moved
          owner
          seen
          remaining
          origin)]
      [(Bind key ty rest-env)
        (cond
          [(= key (tc-default-boundary-id)) (Ok moved)]
          [(tc-name-id-list-contains seen key)
            (tc-move-mark-owner-region-locals-scan
              expr-bases
              rest-env
              locals
              loop-carried
              moved
              owner
              seen
              remaining
              origin)]
          [(not (tc-moved-contains? locals key))
            (tc-move-mark-owner-region-locals-scan
              expr-bases
              rest-env
              locals
              loop-carried
              moved
              owner
              (tc-name-id-list-add seen key)
              remaining
              origin)]
          [(or
              (tc-type-contains-arena-owner-region? env ty owner)
              (tc-moved-owner-dependency?
                (tc-global-shared-view moved)
                key
                owner))
            (let
              [moved2
                (try
                  (tc-move-invalidate-local
                    expr-bases
                    (tc-global-shared-view locals)
                    (tc-global-shared-view loop-carried)
                    moved
                    key
                    (tc-global-shared-view origin)))]
              (tc-move-mark-owner-region-locals-scan
                expr-bases
                rest-env
                locals
                loop-carried
                moved2
                owner
                (tc-name-id-list-add seen key)
                (- remaining 1)
                origin))]
          [else
            (tc-move-mark-owner-region-locals-scan
              expr-bases
              rest-env
              locals
              loop-carried
              moved
              owner
              (tc-name-id-list-add seen key)
              (- remaining 1)
              origin)])])))

(define (tc-move-mark-owner-region-locals
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [owner : i64]
  [origin : ast.AstExpr]
  [operation : String]) : TcMoveResult
  (let
    [live-owner : i64
      (tc-move-live-cleanup-owner-in-region
        env
        (tc-global-shared-view moved)
        owner
        -1)]
    (if (>= live-owner 0)
      (Err
        (tc-move-safe-invalidation-cleanup-owner-message
          expr-bases
          origin
          operation
          (tc-env-key-name-text owner)
          (tc-env-key-name-text live-owner)))
      (let
        [marked
          (try
            (tc-move-mark-owner-region-locals-scan
              expr-bases
              env
              (tc-global-shared-view locals)
              loop-carried
              moved
              owner
              Nil
              (tc-moved-len locals)
              origin))]
        (Ok (tc-move-discharge-invalidate locals marked owner))))))

;; The brand an `(:invalidate r T)` formal ends at one call: `r` after
;; inferring `T`'s lifetimes from the argument's checked type (#6670).
(define (tc-invalidate-call-brand
  [ctx : TcContext]
  [env : TcTypeEnv]
  [formal : ast.AstType]
  [actual : ast.AstType]) : TcMaybeNameId
  (match (tc-global-shared-view formal)
    [(Invalidate lifetime inner)
      (let
        [inner-ty : ast.AstType (ast.ty-node-get inner)]
        [lifetimes : ast.AstLifetimeList
          (tc-name-id-list-to-lifetime-list
            (tc-type-collect-reference-lifetimes
              (tc-global-shared-view inner-ty)))]
        (match (tc-infer-lifetime-subst-from-type
          ctx
          env
          lifetimes
          Nil
          inner-ty
          actual
          (TcVarianceCovariant))
          [(Ok subst) (Some (tc-lifetime-subst-apply subst lifetime))]
          [(Err _) (No)]))]
    [_ (No)]))

;; A call's `:invalidate` arguments end their brands in the caller exactly as a
;; safe destroy does, after the arguments themselves have moved.
(define (tc-move-check-invalidate-call-effects
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [args : (& args ast.AstExprList)]
  [params : (& params ast.AstTypeList)]
  [index : i64]
  [origin : ast.AstExpr]) : TcMoveResult
  (if (or (>= index (ast.ast-type-list-len params)) (>= index args.len))
    (Ok moved)
    (let
      [formal : ast.AstType
        (ast.ty-node-get
          (ast.ast-type-list-get params index (ast.ast-type-id-fallback)))]
      [arg-box : i64 (ast.ast-expr-list-get args index 0)]
      [brand : TcMaybeNameId
        (match (tc-type-invalidate-lifetime (tc-global-shared-view formal))
          [(Some _)
            (match (tc-body-type-fact-expr-id
              "move.invalidate_argument"
              ctx
              env
              arg-box)
              [(Ok actual) (tc-invalidate-call-brand ctx env formal actual)]
              [(Err _) (No)])]
          [(No) (No)])]
      (match brand
        [(Some owner)
          (let
            [moved1
              (try
                (if (tc-atomic-arena-owner-active-id? env owner)
                  (tc-move-check-atomic-arena-users-released
                    ctx
                    env
                    (tc-global-shared-view locals)
                    moved
                    owner)
                  (TcMoveResult.Ok moved)))]
            [moved2
              (try
                (tc-move-mark-owner-region-locals
                  expr-bases
                  env
                  (tc-global-shared-view locals)
                  (tc-global-shared-view loop-carried)
                  moved1
                  owner
                  (ast.ast-expr-segment-bases-get expr-bases arg-box)
                  "an :invalidate call"))]
            (tc-move-check-invalidate-call-effects
              ctx
              expr-bases
              env
              locals
              loop-carried
              moved2
              args
              params
              (+ index 1)
              origin))]
        [(No)
          (tc-move-check-invalidate-call-effects
            ctx
            expr-bases
            env
            locals
            loop-carried
            moved
            args
            params
            (+ index 1)
            origin)]))))

(define (tc-moved-add-hidden-atomic-user [set : TcMovedSet] [owner-id : i64]) : TcMovedSet
  (let
    [hidden : tc_i64_i64_map.Map
      (tc-moved-id-map-own
        (tc-moved-hidden-atomic-users (tc-global-shared-view set)))]
    (tc_i64_i64_map.insert-ref! (&mut hidden) owner-id (tc-moved-no-origin-id))
    (TcMovedSet
      (tc-moved-roots (tc-global-shared-view set))
      (tc-moved-partials (tc-global-shared-view set))
      (tc-moved-paths (tc-global-shared-view set))
      hidden
      (tc-moved-param-storage-origins set))))

(define (tc-moved-hidden-atomic-user? [set : TcMovedSet] [owner-id : i64]) : bool
  (let
    [hidden : tc_i64_i64_map.Map (tc-moved-hidden-atomic-users set)]
    (tc_i64_i64_map.contains? (& hidden) owner-id)))

(define (tc-move-mark-hidden-atomic-arena-users
  [moved : TcMovedSet]
  [owners : TcNameIdList]) : TcMovedSet
  (let
    [cursor : TcNameIdList owners]
    [out : TcMovedSet moved]
    (while (not (tc-name-id-list-empty? cursor))
      (set!
        out
        (tc-moved-add-hidden-atomic-user out (tc-name-id-list-head cursor)))
      (set! cursor (tc-name-id-list-rest cursor)))
    out))

(define (tc-move-atomic-arena-hidden-user-message [owner : String]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (ArenaOwnership))
    "typecheck: arena.destroy-safe!/rewind-safe! cannot prove atomic arena `"
    owner
    "` is released after an owner-tagged value was sent to a channel"))

(define (tc-move-check-atomic-arena-hidden-users-released
  [moved : TcMovedSet]
  [owner-id : i64]) : TcMoveResult
  (if (tc-moved-hidden-atomic-user? (tc-global-shared-view moved) owner-id)
    (Err
      (tc-move-atomic-arena-hidden-user-message (tc-env-key-name-text owner-id)))
    (Ok moved)))

(define (tc-move-atomic-arena-live-user-message
  [owner : String]
  [name : String]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (ArenaOwnership))
    "typecheck: arena.destroy-safe!/rewind-safe! requires atomic arena user `"
    name
    "` to be joined or released before invalidating `"
    owner
    "`"))

(define (tc-move-check-atomic-arena-users-released-scan
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [owner : i64]
  [seen : TcNameIdList]
  [remaining : i64]) : TcMoveResult
  (if (<= remaining 0)
    (Ok moved)
    (match (tc-type-env-marker-step env)
      [(Done) (Ok moved)]
      [(Cache rest-env)
        (tc-move-check-atomic-arena-users-released-scan
          ctx
          rest-env
          locals
          moved
          owner
          seen
          remaining)]
      [(Bind key ty rest-env)
        (cond
          [(= key (tc-default-boundary-id)) (Ok moved)]
          [(tc-name-id-list-contains seen key)
            (tc-move-check-atomic-arena-users-released-scan
              ctx
              rest-env
              locals
              moved
              owner
              seen
              remaining)]
          [(not (tc-moved-contains? locals key))
            (tc-move-check-atomic-arena-users-released-scan
              ctx
              rest-env
              locals
              moved
              owner
              (tc-name-id-list-add seen key)
              remaining)]
          [(and
              (tc-type-contains-arena-owner-region?
                env
                (tc-global-shared-view ty)
                owner)
              (tc-thread-safe-user-type? ctx ty)
              (not (tc-moved-contains? moved key)))
            (Err
              (tc-move-atomic-arena-live-user-message
                (tc-env-key-name-text owner)
                (tc-env-key-name-text key)))]
          [else
            (tc-move-check-atomic-arena-users-released-scan
              ctx
              rest-env
              locals
              moved
              owner
              (tc-name-id-list-add seen key)
              (- remaining 1))])])))

(define (tc-move-check-atomic-arena-users-released
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [owner : i64]) : TcMoveResult
  (let
    [moved1 : TcMovedSet
      (try (tc-move-check-atomic-arena-hidden-users-released moved owner))]
    (tc-move-check-atomic-arena-users-released-scan
      ctx
      env
      (tc-global-shared-view locals)
      moved1
      owner
      Nil
      (tc-moved-len locals))))

(define (tc-move-safe-arena-rewind-effect
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [args : ast.AstExprList]
  [origin : ast.AstExpr]) : TcMoveResult
  (if (ast.ast-expr-list-empty? (& args))
    (Ok moved)
    (let
      [phase-box : i64 (ast.ast-expr-list-get (& args) 0 0)]
      [phase-expr : ast.AstExpr
        (ast.ast-expr-segment-bases-get expr-bases phase-box)]
      [pid : i64 (tc-expr-var-name-id expr-bases phase-expr)]
      (if (>= pid 0)
        (match (tc-arena-phase-token-region-active env pid)
          [(Some region)
            (match (tc-arena-phase-token-owner-active env pid)
              [(Some owner)
                (let
                  [moved1
                    (try
                      (if (tc-atomic-arena-owner-active-id? env owner)
                        (tc-move-check-atomic-arena-users-released
                          ctx
                          env
                          (tc-global-shared-view locals)
                          moved
                          owner)
                        (TcMoveResult.Ok moved)))]
                  [moved2
                    (try
                      (tc-move-consume-local
                        expr-bases
                        (tc-global-shared-view locals)
                        (tc-global-shared-view loop-carried)
                        moved1
                        pid
                        (tc-global-shared-view origin)))]
                  (tc-move-mark-region-locals
                    expr-bases
                    env
                    locals
                    loop-carried
                    moved2
                    region
                    (tc-env-key-name-text owner)
                    origin))]
              [(No)
                (let
                  [moved2
                    (try
                      (tc-move-consume-local
                        expr-bases
                        (tc-global-shared-view locals)
                        (tc-global-shared-view loop-carried)
                        moved
                        pid
                        (tc-global-shared-view origin)))]
                  (tc-move-mark-region-locals
                    expr-bases
                    env
                    locals
                    loop-carried
                    moved2
                    region
                    (tc-env-key-name-text pid)
                    origin))])]
          [(No) (Ok moved)])
        (Ok moved)))))

(define (tc-move-safe-arena-destroy-effect
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [args : ast.AstExprList]
  [origin : ast.AstExpr]) : TcMoveResult
  (if (ast.ast-expr-list-empty? (& args))
    (Ok moved)
    (let
      [owner-box : i64 (ast.ast-expr-list-get (& args) 0 0)]
      [owner-expr : ast.AstExpr
        (ast.ast-expr-segment-bases-get expr-bases owner-box)]
      (match (tc-body-type-fact-expr-id
        "move.safe_arena_destroy_owner"
        ctx
        env
        owner-box)
        [(Ok owner-ty)
          (match (tc-destroy-safe-owner-place-id
            ctx
            env
            (tc-global-shared-view owner-expr)
            owner-ty)
            [(Some owner-id)
              (match (tc-move-direct-root-base-path
                expr-bases
                (tc-global-shared-view owner-expr))
                [(Some owner-place)
                  (if (tc-moved-contains? loop-carried owner-place.root)
                    (tc-move-rich-loop-carried-result
                      expr-bases
                      (tc-move-path-render owner-place)
                      origin)
                    (let
                      [moved1
                        (try
                          (if (tc-atomic-arena-owner-active-id? env owner-id)
                            (tc-move-check-atomic-arena-users-released
                              ctx
                              env
                              (tc-global-shared-view locals)
                              moved
                              owner-id)
                            (TcMoveResult.Ok moved)))]
                      [moved2
                        (try
                          (tc-move-after-consuming-projection
                            ctx
                            expr-bases
                            env
                            (tc-global-shared-view locals)
                            (tc-global-shared-view loop-carried)
                            moved1
                            owner-expr))]
                      (tc-move-mark-owner-region-locals
                        expr-bases
                        env
                        locals
                        loop-carried
                        moved2
                        owner-id
                        origin
                        "arena.destroy-safe!")))]
                [(No) (Ok moved)])]
            [(No) (Ok moved)])]
        [(Err _) (Ok moved)]))))

(define (tc-move-check-safe-arena-call-effects
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [origin : ast.AstExpr]) : TcMoveResult
  (let
    [raw-id : i64 (tc-expr-var-name-id expr-bases func)]
    (if (>= raw-id 0)
      (let
        [raw-name : String
          (tc-hygiene-name-text-id-for-session
            (tc-context-structural-session ctx)
            raw-id)]
        [hygiene-global : bool
          (tc-hygiene-global-name-id?
            (tc-context-structural-session ctx)
            raw-id)]
        [name : String
          (if (and
            hygiene-global
            (not
              (macro-hygiene-global-id?
                (tc-context-structural-session ctx)
                raw-id)))
            (tc-hygiene-global-symbol-name raw-name)
            raw-name)]
        [name-id : i64
          (tc-builtin-symbol-name-id
            (tc-context-structural-session ctx)
            raw-id
            hygiene-global)]
        [lookup-id : i64 (tc-call-builtin-lookup-id ctx env name name-id)]
        [arena-call-kind : i64
          (tc-arena-safe-call-kind-id ctx env name-id lookup-id)]
        (cond
          [(= arena-call-kind (tc-arena-safe-call-kind-rewind))
            (tc-move-safe-arena-rewind-effect
              ctx
              expr-bases
              env
              locals
              loop-carried
              moved
              args
              origin)]
          [(= arena-call-kind (tc-arena-safe-call-kind-destroy))
            (tc-move-safe-arena-destroy-effect
              ctx
              expr-bases
              env
              locals
              loop-carried
              moved
              args
              origin)]
          [else (Ok moved)]))
      (Ok moved))))

(define (tc-move-check-lambda-owner-captures-scan
  [ctx : TcContext]
  [expr-bases : i64]
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [transfer-only : bool]
  [bound : TcStringList]
  [seen : TcStringList]
  [remaining : i64]
  [body : ast.AstExpr]) : TcMoveResult
  (if (<= remaining 0)
    (Ok moved)
    (match (tc-type-env-marker-step env)
      [(Done) (Ok moved)]
      [(Cache rest-env)
        (tc-move-check-lambda-owner-captures-scan
          ctx
          expr-bases
          root
          rest-env
          locals
          loop-carried
          moved
          transfer-only
          bound
          seen
          remaining
          body)]
      [(Bind key ty rest-env)
        (let
          [name : String (tc-env-key-name-text key)]
          (cond
            [(= key (tc-default-boundary-id)) (Ok moved)]
            [(or
                (= key (tc-region-marker-id))
                (tc-cleanup-owner-marker-entry? key ty))
              (tc-move-check-lambda-owner-captures-scan
                ctx
                expr-bases
                root
                rest-env
                locals
                loop-carried
                moved
                transfer-only
                bound
                seen
                remaining
                body)]
            [(tc-string-list-contains
                (tc-global-shared-view seen)
                (tc-global-shared-view name))
              (tc-move-check-lambda-owner-captures-scan
                ctx
                expr-bases
                root
                rest-env
                locals
                loop-carried
                moved
                transfer-only
                bound
                seen
                remaining
                body)]
            [(not (tc-moved-contains? locals key))
              (tc-move-check-lambda-owner-captures-scan
                ctx
                expr-bases
                root
                rest-env
                locals
                loop-carried
                moved
                transfer-only
                bound
                seen
                remaining
                body)]
            [(not
                (tc-expr-uses-free-name?
                  expr-bases
                  (tc-global-shared-view body)
                  (tc-global-shared-view name)
                  (tc-global-shared-view bound)))
              (tc-move-check-lambda-owner-captures-scan
                ctx
                expr-bases
                root
                rest-env
                locals
                loop-carried
                moved
                transfer-only
                bound
                (tc-string-list-add seen name)
                (- remaining 1)
                body)]
            [else
              (match (tc-lookup-id root key)
                [(Ok visible-ty)
                  (if (if transfer-only
                    (and
                      (not
                        (and
                          (tc-arena-type?
                            ctx
                            (tc-global-shared-view visible-ty))
                          (tc-move-arena-owner-local? root key)))
                      (not
                        (tc-type-move-only?
                          ctx
                          (tc-global-shared-view visible-ty)))
                      ;; Ordinary lambda capture already moves every move-only
                      ;; value. The thread-only pass handles the remaining
                      ;; Copyable aggregate transfer policy and must not report
                      ;; that same capture as a second move.
                      (not
                        (tc-move-local-or-type-move-only?
                          ctx
                          (tc-global-shared-view locals)
                          key
                          (tc-global-shared-view visible-ty)))
                      (match (tc-thread-transfer-classify-type-in-env
                        ctx
                        root
                        visible-ty)
                        [(Transferable) true]
                        [_ false]))
                    ;; A captured ordinary arena owner moves into the closure.
                    ;; A captured atomic owner instead becomes a tracked user
                    ;; that its destroy or rewind must see released.
                    (or
                      (tc-move-local-or-type-move-only?
                        ctx
                        (tc-global-shared-view locals)
                        key
                        (tc-global-shared-view visible-ty))
                      (and
                        (tc-arena-type? ctx (tc-global-shared-view visible-ty))
                        (tc-ordinary-arena-owner-active-id? root key))))
                    (if (or
                      (tc-moved-contains? moved key)
                      (tc-moved-partial? moved key))
                      (tc-move-rich-use-conflict-result
                        expr-bases
                        (tc-moved-root-conflict moved key)
                        (tc-global-shared-view name)
                        body
                        name)
                      (if (tc-moved-contains? loop-carried key)
                        (tc-move-rich-loop-carried-result expr-bases name body)
                        (tc-move-check-lambda-owner-captures-scan
                          ctx
                          expr-bases
                          root
                          rest-env
                          locals
                          loop-carried
                          (tc-moved-add-origin
                            moved
                            key
                            (tc-global-shared-view body))
                          transfer-only
                          bound
                          (tc-string-list-add seen name)
                          (- remaining 1)
                          body)))
                    (tc-move-check-lambda-owner-captures-scan
                      ctx
                      expr-bases
                      root
                      rest-env
                      locals
                      loop-carried
                      moved
                      transfer-only
                      bound
                      (tc-string-list-add seen name)
                      (- remaining 1)
                      body))]
                [(Err _)
                  (tc-move-check-lambda-owner-captures-scan
                    ctx
                    expr-bases
                    root
                    rest-env
                    locals
                    loop-carried
                    moved
                    transfer-only
                    bound
                    (tc-string-list-add seen name)
                    (- remaining 1)
                    body)])]))])))

(define (tc-move-check-lambda-owner-captures
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [params : ast.AstParamList]
  [body : ast.AstExpr]) : TcMoveResult
  (tc-move-check-lambda-owner-captures-scan
    ctx
    expr-bases
    env
    env
    (tc-global-shared-view locals)
    loop-carried
    moved
    false
    (tc-param-bound-names params)
    Nil
    (tc-moved-len locals)
    body))

(define (tc-move-check-thread-spawn-transferred-captures
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [params : ast.AstParamList]
  [body : ast.AstExpr]) : TcMoveResult
  (tc-move-check-lambda-owner-captures-scan
    ctx
    expr-bases
    env
    env
    (tc-global-shared-view locals)
    loop-carried
    moved
    true
    (tc-param-bound-names params)
    Nil
    (tc-moved-len locals)
    body))

;; Call arguments consumed in order. With `auto-borrow?` (the callee has an
;; immutable-reference formal) each argument is checked as the effective
;; expression the call passes, auto-borrow included.
(define (tc-move-check-exprs-with-types-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : (& exprs ast.AstExprList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [auto-borrow? : bool]) : TcMoveResult
  (if (>= index exprs.len)
    (if (>= index (ast.ast-type-list-len types))
      (Ok moved)
      (Err (tc-call-arity-invariant-message "move-check")))
    (if (>= index (ast.ast-type-list-len types))
      (Err (tc-call-arity-invariant-message "move-check"))
      (let
        [head : i64 (ast.ast-expr-list-get exprs index 0)]
        [head-expr : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases head)]
        [raw-ty : ast.AstType
          (ast.ty-node-get
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
        [effective-head
          (try
            (if auto-borrow?
              (tc-call-effective-arg-expr
                ctx
                env
                head-expr
                (tc-global-shared-view raw-ty))
              (ResultTcExpr.Ok head-expr)))]
        [moved1
          (try
            (tc-move-check-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view loop-carried)
              moved
              (tc-global-shared-view effective-head)))]
        [moved2
          (try
            (tc-move-after-consuming-value
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view loop-carried)
              moved1
              effective-head
              raw-ty))]
        (tc-move-check-exprs-with-types-at
          ctx
          expr-bases
          env
          locals
          loop-carried
          moved2
          exprs
          types
          (+ index 1)
          auto-borrow?)))))

(define (tc-move-check-exprs-with-types
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : ast.AstExprList]
  [types : ast.AstTypeList]) : TcMoveResult
  (let
    [auto-borrow? : bool
      (tc-call-type-list-has-immutable-ref-formal? ctx types)]
    (tc-move-check-exprs-with-types-at
      ctx
      expr-bases
      env
      locals
      loop-carried
      moved
      (& exprs)
      (& types)
      0
      auto-borrow?)))

;; Tuple and nominal-constructor expressions store each element by value.
;; Unlike an ordinary non-consuming function argument, a reference-bearing
;; MoveOnly element therefore transfers its exclusive handle into the aggregate.
;; In particular this prevents safe source code from duplicating one mutable
;; reference into two fields; trusted Slice splitting constructs its result in
;; the compiler instead of passing through this source-level aggregate path.
(define (tc-move-check-aggregate-exprs-with-types
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : ast.AstExprList]
  [types : ast.AstTypeList]) : TcMoveResult
  (tc-move-check-aggregate-exprs-with-types-at
    ctx
    expr-bases
    env
    locals
    loop-carried
    moved
    (& exprs)
    (& types)
    0))

(define (tc-move-check-aggregate-exprs-with-types-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : (& exprs ast.AstExprList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : TcMoveResult
  (if (>= index exprs.len)
    (if (>= index (ast.ast-type-list-len types))
      (Ok moved)
      (Err (tc-call-arity-invariant-message "move-check")))
    (if (>= index (ast.ast-type-list-len types))
      (Err (tc-call-arity-invariant-message "move-check"))
      (let
        [head : i64 (ast.ast-expr-list-get exprs index 0)]
        [head-expr : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases head)]
        [raw-ty : ast.AstType
          (ast.ty-node-get
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
        [effective-head
          (try
            (tc-call-effective-arg-expr
              ctx
              env
              head-expr
              (tc-global-shared-view raw-ty)))]
        [moved1
          (try
            (tc-move-check-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view loop-carried)
              moved
              (tc-global-shared-view effective-head)))]
        ;; Aggregate storage is a by-value transfer, including for a
        ;; mutable-reference handle. Ordinary calls implicitly
        ;; reborrow `&mut` arguments instead and use the consuming
        ;; helper above.
        [moved2
          (try
            (tc-move-after-move-only-value
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view loop-carried)
              moved1
              effective-head
              raw-ty))]
        (tc-move-check-aggregate-exprs-with-types-at
          ctx
          expr-bases
          env
          locals
          loop-carried
          moved2
          exprs
          types
          (+ index 1))))))

(define (tc-move-check-thread-channel-send-message
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]) : TcMoveResult
  (if (tc-thread-channel-send-call? ctx env (tc-global-shared-view func))
    (match (tc-thread-channel-send-call-name ctx func)
      [(Some _)
        (let
          [message-ty : ast.AstType
            (try (tc-thread-channel-send-message-param params))]
          [message-expr : ast.AstExpr
            (try (tc-thread-channel-send-message-arg expr-bases args))]
          [moved2
            (try
              (tc-move-after-move-only-value
                ctx
                expr-bases
                env
                locals
                loop-carried
                moved
                (tc-global-shared-view message-expr)
                (tc-global-shared-view message-ty)))]
          (Ok
            (tc-move-mark-hidden-atomic-arena-users
              moved2
              (match (tc-expr ctx env message-expr)
                [(Ok actual-message-ty)
                  (tc-type-atomic-arena-owner-regions env actual-message-ty)]
                [(Err _) (tc-type-atomic-arena-owner-regions env message-ty)]))))]
      [(No) (Ok moved)])
    (Ok moved)))

(define (tc-move-check-thread-safe-spawn-captures
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]) : TcMoveResult
  (if (and
    (tc-thread-safe-spawn-call-signature? ctx env func params)
    (= args.len 1))
    (let
      [arg : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& arg))
        [(Lambda lambda-box)
          (match (__tl-box-place lambda-box)
            [(Lambda lambda-params _ body-box)
              (if (= (ast.ast-param-list-len (& lambda-params)) 0)
                (tc-move-check-thread-spawn-transferred-captures
                  ctx
                  expr-bases
                  env
                  locals
                  loop-carried
                  moved
                  lambda-params
                  (ast.ast-expr-segment-bases-get expr-bases body-box))
                (Ok moved))])]
        [_ (Ok moved)]))
    (Ok moved)))

;; Core length/index inspectors take their receiver as a source-level place and
;; never transfer its owner handle. Their argument traversal is therefore an
;; implicit shared borrow; ordinary by-value calls get no such exemption.
(define (tc-move-global-place-inspector-call?
  [expr-bases : i64]
  [_ctx : TcContext]
  [_env : TcTypeEnv]
  [func : ast.AstExpr]) : bool
  (let
    [raw-id : i64 (tc-expr-var-name-id expr-bases func)]
    (if (>= raw-id 0)
      (let
        [hygiene-global : bool
          (tc-hygiene-global-name-id?
            (tc-context-structural-session _ctx)
            raw-id)]
        [name-id : i64
          (tc-builtin-call-name-id
            (tc-context-structural-session _ctx)
            raw-id
            hygiene-global)]
        (if (< name-id 0)
          false
          (or
            (cbi.compiler-builtin-typecheck-length-call-id? name-id)
            (cbi.compiler-builtin-typecheck-string-ref-call-id? name-id))))
      false)))

(define (tc-move-local-call-capability [locals : TcMovedSet] [name-id : i64]) : i64
  (tc-closure-local-fact-capability (tc-closure-local-fact-code locals name-id)))

(define (tc-move-after-known-closure-call
  [expr-bases : i64]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [func : ast.AstExpr]
  [origin : ast.AstExpr]) : TcMoveResult
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& func))
    [(Var name-id)
      (if (=
        (tc-move-local-call-capability locals name-id)
        (tc-closure-call-capability-once))
        (if (tc-moved-contains? loop-carried name-id)
          (tc-move-rich-loop-carried-result
            expr-bases
            (tc-hygiene-name-text-id name-id)
            origin)
          (Ok (tc-moved-add-origin moved name-id origin)))
        (Ok moved))]
    [_ (Ok moved)]))

(define (tc-move-check-constructor-call? [ctx : TcContext] [func : ast.AstExpr]) : bool
  (let
    [name-id : i64
      (tc-expr-var-name-id (tc-context-expr-segment-bases ctx) func)]
    (if (>= name-id 0)
      (tc-constructor-name-id? ctx name-id)
      false)))

;; The symbol handle of the value `value-name-id` declared in the module that
;; declares nominal type `nominal-id`, or the missing handle.
(define (tc-move-nominal-module-value-handle
  [ctx : TcContext]
  [nominal-id : i64]
  [value-name-id : i64]) : i64
  (let
    [type-handle : i64
      (csym.compiler-symbols-lookup-type-id-or
        (tc-context-symbols ctx)
        nominal-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? type-handle)
      (let
        ;; A declaration without an owner module belongs to the root module,
        ;; as in `tc-context-with-nominal-owner-handle-module`.
        [module-id : i64
          (csym.compiler-symbols-owner-module-id-at-index-or
            (tc-context-symbols ctx)
            (csym.compiler-symbol-handle-index type-handle)
            cbi.compiler-builtin-id-fix-empty)]
        (csym.compiler-symbols-lookup-value-in-module-id-or
          (tc-context-symbols ctx)
          (if (>= module-id 0)
            module-id
            cbi.compiler-builtin-id-fix-empty)
          (tc-env-name-key-id (tc-context-structural-session ctx) value-name-id)
          (csym.compiler-symbols-missing-handle)))
      (csym.compiler-symbols-missing-handle))))

;; The symbol handle of the cleanup function a cleanup-owning struct or enum
;; type declares, or the missing handle. Comparing handles resolves qualified
;; names and aliases to the declaration and keeps a same-named or same-typed
;; function from counting as the disposer.
(define (tc-move-declared-cleanup-handle [ctx : TcContext] [ty : ast.AstType]) : i64
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(or (Struct name) (StructArgs name _))
      (tc-move-struct-cleanup-handle ctx name)]
    [(or (Enum name) (EnumArgs name _)) (tc-move-enum-cleanup-handle ctx name)]
    [_ (csym.compiler-symbols-missing-handle)]))

(define (tc-move-struct-cleanup-handle [ctx : TcContext] [name : i64]) : i64
  (match (tc-struct-decl-id ctx name)
    [(Ok decl)
      (match decl
        [(TcStructDecl _ cleanup _)
          (match cleanup
            [(Fn cleanup-name)
              (tc-move-nominal-module-value-handle
                ctx
                name
                (ci.intern-syntax-id-value cleanup-name))]
            [(No) (csym.compiler-symbols-missing-handle)])])]
    [(Err _) (csym.compiler-symbols-missing-handle)]))

(define (tc-move-enum-cleanup-handle [ctx : TcContext] [name : i64]) : i64
  (match (tc-enum-decl-id ctx name)
    [(Ok decl)
      (match decl
        [(TcEnumDecl cleanup _)
          (match cleanup
            [(Fn cleanup-name)
              (tc-move-nominal-module-value-handle
                ctx
                name
                (ci.intern-syntax-id-value cleanup-name))]
            [(No) (csym.compiler-symbols-missing-handle)])])]
    [(Err _) (csym.compiler-symbols-missing-handle)]))

;; Discharges the obligated locals a call's arguments always yield when the
;; call takes them over: a cleanup-owning constructor, or the declared cleanup
;; function of the argument's type.
(define (tc-move-discharge-call-args-impl
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]) : TcMovedSet
  (if (not (tc-move-let-obligations-possible?))
    moved
    (let
      [constructor? : bool
        (tc-move-check-constructor-call? ctx (tc-global-shared-view func))]
      [callee-id : i64
        (tc-expr-var-name-id expr-bases (tc-global-shared-view func))]
      [callee : i64
        (if (>= callee-id 0)
          (tc-move-value-symbol-handle-id ctx env callee-id)
          (csym.compiler-symbols-missing-handle))]
      [out : TcMovedSet moved]
      [index : i64 0]
      (while (< index (ast.ast-expr-list-len (& args)))
        (let
          [arg-id : i64 (ast.ast-expr-list-get (& args) index 0)]
          (let
            [v-id : i64 (tc-move-direct-tail-var-id ctx expr-bases arg-id)]
            (if (and
              (>= v-id 0)
              (tc-move-let-obligated? (tc-global-shared-view locals) v-id)
              (or
                constructor?
                (and
                  (csym.compiler-symbols-handle-found? callee)
                  (< index (ast.ast-type-list-len (& params)))
                  (=
                    callee
                    (tc-move-declared-cleanup-handle
                      ctx
                      (tc-context-type-get
                        ctx
                        (ast.ast-type-list-get
                          (& params)
                          index
                          (ast.ast-type-id-fallback))))))))
              (set!
                out
                (tc-move-discharge-direct
                  ctx
                  expr-bases
                  (tc-global-shared-view locals)
                  out
                  arg-id))
              unit))
          (set! index (+ index 1))))
      out)))

(define (tc-move-check-call-args-with-types
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [call-expr : ast.AstExpr]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [foreign-boundary : bool]) : TcMoveResult
  (let
    [moved-args0
      (try
        (cond
          [foreign-boundary
            ;; Foreign declarations describe an ABI, not TypeLisp ownership transfer.
            ;; Validate each argument expression as a read while retaining the source
            ;; place for subsequent TypeLisp code.
            (tc-move-check-exprs
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view loop-carried)
              moved
              (tc-global-shared-view args))]
          [(tc-move-check-constructor-call? ctx (tc-global-shared-view func))
            (tc-move-check-aggregate-exprs-with-types
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view loop-carried)
              moved
              (tc-global-shared-view args)
              (tc-global-shared-view params))]
          [(or
              (tc-move-global-place-inspector-call?
                expr-bases
                ctx
                env
                (tc-global-shared-view func))
              ;; Safe thread spawn requires one direct lambda and separately validates
              ;; and transfers every capture below. Do not reject that intentional
              ;; one-way transfer merely because its public `(-> ...)` parameter cannot
              ;; encode the concrete environment's non-Copy fact.
              (tc-thread-safe-spawn-call-signature?
                ctx
                env
                (tc-global-shared-view func)
                (tc-global-shared-view params)))
            (tc-move-check-exprs
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view loop-carried)
              moved
              (tc-global-shared-view args))]
          [else
            (tc-move-check-exprs-with-types
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view loop-carried)
              moved
              (tc-global-shared-view args)
              (tc-global-shared-view params))]))]
    [moved-thread
      (try
        (tc-move-check-thread-channel-send-message
          ctx
          expr-bases
          env
          (tc-global-shared-view locals)
          (tc-global-shared-view loop-carried)
          (if foreign-boundary
            moved-args0
            (tc-move-discharge-call-args
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              moved-args0
              (tc-global-shared-view func)
              (tc-global-shared-view args)
              (tc-global-shared-view params)))
          (tc-global-shared-view func)
          (tc-global-shared-view args)
          (tc-global-shared-view params)))]
    [moved-spawn
      (try
        (tc-move-check-thread-safe-spawn-captures
          ctx
          expr-bases
          env
          (tc-global-shared-view locals)
          (tc-global-shared-view loop-carried)
          moved-thread
          (tc-global-shared-view func)
          (tc-global-shared-view args)
          (tc-global-shared-view params)))]
    [moved-call
      (try
        (match (if (tc-invalidate-types-present?)
          (tc-move-check-invalidate-call-effects
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            (tc-global-shared-view loop-carried)
            moved-spawn
            (& args)
            (& params)
            0
            (tc-global-shared-view call-expr))
          (TcMoveResult.Ok moved-spawn))
          [(Ok moved-invalidate)
            (tc-move-check-safe-arena-call-effects
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view loop-carried)
              moved-invalidate
              (tc-global-shared-view func)
              (tc-global-shared-view args)
              (tc-global-shared-view call-expr))]
          [(Err message) (TcMoveResult.Err message)]))]
    (tc-move-after-known-closure-call
      expr-bases
      locals
      loop-carried
      moved-call
      func
      call-expr)))

(define (tc-move-call-param-types-from-type [fn-ty : ast.AstType]) : ResultTcTypeList
  (match (tc-type-strip-region fn-ty)
    [(Func params _) (Ok (ast.ast-type-list-box-shared-view params))]
    [(or (Enum _) (EnumArgs _ _)) (Ok (ast.ast-type-list-new))]
    [_ (Err "typecheck: call target is not a function")]))

(define (tc-borrow-call-substituted-return-lifetimes
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [ret : ast.AstType]
  [result-lifetimes : TcNameIdList]) : TcBorrowCallReturnLifetimes
  (let
    [lifetimes : ast.AstLifetimeList
      (tc-call-function-lifetimes
        (tc-global-shared-view params)
        (tc-global-shared-view ret))]
    (if (ast.ast-lifetime-list-empty? (& lifetimes))
      (Known result-lifetimes)
      (match (tc-infer-call-lifetime-subst
        ctx
        env
        func
        args
        params
        lifetimes
        Nil)
        [(Ok subst)
          (Known
            (tc-type-collect-reference-lifetimes
              (tc-resolve-type ctx (tc-lifetime-subst-type subst ret))))]
        [(Err _) (Fallback)]))))

(define (tc-borrow-call-return-lifetimes-from-function
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [ret : ast.AstType]) : TcBorrowCallReturnLifetimes
  (if (tc-call-lifetime-constructor-for-func?
    ctx
    (tc-global-shared-view func)
    (tc-global-shared-view ret))
    (Fallback)
    (match (tc-call-constructor-target-for-func
      ctx
      env
      (tc-global-shared-view func)
      (tc-global-shared-view params)
      (tc-global-shared-view ret))
      [(Some _) (Fallback)]
      [(No)
        (let
          [result-lifetimes : TcNameIdList
            (tc-type-collect-reference-lifetimes
              (tc-resolve-type ctx (tc-global-shared-view ret)))]
          ;; Input-only lifetimes cannot affect post-call retention. Avoid
          ;; re-inferring borrowed inspector arguments when the scalar result
          ;; carries no lifetime at all.
          (match result-lifetimes
            [(Nil) (Known Nil)]
            [_
              (tc-borrow-call-substituted-return-lifetimes
                ctx
                env
                func
                args
                params
                ret
                result-lifetimes)]))])))

(define (tc-borrow-call-info-from-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [fn-ty : ast.AstType]) : ResultTcBorrowCallInfo
  (match (tc-type-strip-region fn-ty)
    [(Func params ret)
      (let
        [params-list : ast.AstTypeList
          (ast.ast-type-list-box-shared-view params)]
        [ret-ty : ast.AstType (ast.ty-node-get ret)]
        (Ok
          (tc-global-shared-view params-list)
          (tc-borrow-call-return-lifetimes-from-function
            ctx
            env
            func
            args
            params-list
            ret-ty)))]
    [(or (Enum _) (EnumArgs _ _)) (Ok (ast.ast-type-list-new) (Fallback))]
    [_ (Err "typecheck: call target is not a function")]))

(define (tc-borrow-call-info-id-raw
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [func-id : i64]
  [args : ast.AstExprList]) : ResultTcBorrowCallInfo
  (let
    [func : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases func-id)]
    (match (tc-expr-id ctx env func-id)
      [(Ok fn-ty) (tc-borrow-call-info-from-type ctx env func args fn-ty)]
      [(Err message)
        (match (tc-private-string-intrinsic-call-type
          ctx
          env
          (tc-global-shared-view func))
          [(Ok fn-ty) (tc-borrow-call-info-from-type ctx env func args fn-ty)]
          [(Err _) (Err message)])])))

(define (tc-borrow-call-info-id-with-facts
  [site : String]
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [func-id : i64]
  [args : ast.AstExprList]) : ResultTcBorrowCallInfo
  (let
    [func : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases func-id)]
    (match (tc-body-type-fact-lookup-profiled
      (tc-global-shared-view site)
      ctx
      func-id)
      [(Hit fn-ty) (tc-borrow-call-info-from-type ctx env func args fn-ty)]
      [(Miss)
        (compiler-tc-reinfer-profiled
          ctx
          site
          (tc-borrow-call-info-id-raw ctx expr-bases env func-id args))])))

(define (tc-move-call-param-types-id-raw
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]) : ResultTcTypeList
  (let
    [func : ast.AstExpr (tc-context-expr-get ctx func-id)]
    (match (tc-expr-id ctx env func-id)
      [(Ok fn-ty) (tc-move-call-param-types-from-type fn-ty)]
      [(Err message)
        (match (tc-private-string-intrinsic-call-type ctx env func)
          [(Ok fn-ty) (tc-move-call-param-types-from-type fn-ty)]
          [(Err _) (Err message)])])))

(define (tc-move-call-param-types-id-with-facts
  [site : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]) : ResultTcTypeList
  (match (tc-body-type-fact-lookup-profiled
    (tc-global-shared-view site)
    ctx
    func-id)
    [(Hit fn-ty) (tc-move-call-param-types-from-type fn-ty)]
    [(Miss)
      (compiler-tc-reinfer-profiled
        ctx
        site
        (tc-move-call-param-types-id-raw ctx env func-id))]))

(define (tc-move-check-exprs
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : ast.AstExprList]) : TcMoveResult
  (tc-move-check-exprs-at
    ctx
    expr-bases
    env
    locals
    loop-carried
    moved
    (& exprs)
    0))

(define (tc-move-check-exprs-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : TcMoveResult
  (if (>= index exprs.len)
    (Ok moved)
    (let
      [moved1
        (try
          (tc-move-check-expr-id
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            (tc-global-shared-view loop-carried)
            moved
            (ast.ast-expr-list-get exprs index 0)))]
      (tc-move-check-exprs-at
        ctx
        expr-bases
        env
        locals
        loop-carried
        moved1
        exprs
        (+ index 1)))))

(define (tc-move-check-let-bindings
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [bindings : ast.AstLetBindingList]
  [body-box : i64]) : TcMoveResult
  (tc-move-check-let-bindings-at
    ctx
    expr-bases
    env
    locals
    loop-carried
    moved
    (& bindings)
    0
    body-box))

(define (tc-move-add-local-binding
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [name-id : i64]
  [init : ast.AstExpr]) : TcMovedSet
  (let
    [fact : i64
      (tc-lambda-init-local-fact-code
        ctx
        expr-bases
        env
        (tc-global-shared-view locals)
        init)]
    (if (tc-closure-local-fact-code? fact)
      (tc-moved-add-value locals name-id fact)
      (tc-moved-add locals name-id))))

;; A binding is in scope for the later bindings and the body, so the body is
;; checked at the innermost level and each level restores the state of the
;; local its binding shadowed.
(define (tc-move-check-let-bindings-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]
  [body-box : i64]) : TcMoveResult
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (tc-move-check-expr-id
      ctx
      expr-bases
      env
      locals
      loop-carried
      moved
      body-box)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name maybe-ty init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [moved1
            (try
              (tc-move-check-expr-id
                ctx
                expr-bases
                env
                (tc-global-shared-view locals)
                (tc-global-shared-view loop-carried)
                moved
                init-box))]
          [binding-ty : ast.AstType
            (tc-move-binding-type-id "move.let_init" ctx env maybe-ty init-box)]
          [moved2
            (try
              (tc-move-after-bind-known-type-id
                ctx
                expr-bases
                env
                (tc-global-shared-view locals)
                (tc-global-shared-view loop-carried)
                moved1
                init-box
                (tc-global-shared-view binding-ty)))]
          [obligated? : bool
            (tc-cleanup-owning-aggregate-type?
              ctx
              (tc-global-shared-view binding-ty))]
          [moved3 : TcMovedSet
            (tc-move-discharge-direct
              ctx
              expr-bases
              (tc-global-shared-view locals)
              moved2
              init-box)]
          [shadowed : TcMovedRootSnapshot
            (tc-moved-root-snapshot (tc-global-shared-view moved3) name)]
          [body-moved
            (try
              (tc-move-check-let-bindings-at
                ctx
                expr-bases
                (tc-bind-initialized-value-id
                  ctx
                  env
                  name
                  (tc-global-shared-view binding-ty)
                  (tc-global-shared-view init))
                (if obligated?
                  (tc-move-bind-let-obligation locals name init-box)
                  (tc-move-add-local-binding
                    ctx
                    expr-bases
                    env
                    locals
                    name
                    (tc-global-shared-view init)))
                (tc-moved-remove-root-state loop-carried name)
                (tc-move-rebind-lambda-owner-dependencies
                  expr-bases
                  env
                  (tc-param-storage-rebind-from-init
                    ctx
                    expr-bases
                    env
                    moved3
                    name
                    binding-ty
                    (tc-global-shared-view init))
                  name
                  init)
                bindings
                (+ index 1)
                body-box))]
          [end-moved
            (try
              (if obligated?
                (tc-move-check-let-obligation-end
                  ctx
                  expr-bases
                  body-moved
                  name
                  init-box
                  body-box)
                (TcMoveResult.Ok body-moved)))]
          (Ok (tc-moved-restore-root-state end-moved shadowed)))])))

(define (tc-move-check-resource-bindings
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [bindings : ast.AstResourceBindingList]
  [exprs : ast.AstExprList]
  [scope : ast.AstExpr]) : TcMoveResult
  (tc-move-check-resource-bindings-at
    ctx
    expr-bases
    env
    locals
    loop-carried
    moved
    (& bindings)
    0
    (tc-move-cleanup-owners-new (ast.ast-resource-binding-list-len bindings))
    exprs
    scope))

;; Owners are recorded in binding order on the way down. The innermost level
;; checks the body and the owners' exit, and each level then restores the state
;; of the local its binding shadowed.
(define (tc-move-check-resource-bindings-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [index : i64]
  [roots : TcMoveCleanupOwners]
  [exprs : ast.AstExprList]
  [scope : ast.AstExpr]) : TcMoveResult
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    (let
      [body-moved
        (try
          (tc-move-check-exprs
            ctx
            expr-bases
            env
            locals
            loop-carried
            moved
            (tc-global-shared-view exprs)))]
      (if (and
        (> exprs.len 0)
        (tc-move-arm-diverges?
          ctx
          expr-bases
          (ast.ast-expr-list-get (& exprs) (- exprs.len 1) 0)))
        (Ok body-moved)
        (tc-move-check-cleanup-owner-exit expr-bases body-moved roots scope 0)))
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(Binding name init-box _ move-aware?)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [moved1
            (try
              (tc-move-check-expr-id
                ctx
                expr-bases
                env
                (tc-global-shared-view locals)
                (tc-global-shared-view loop-carried)
                moved
                init-box))]
          [moved-bound
            (try
              (tc-move-after-bind-id
                ctx
                expr-bases
                env
                (tc-global-shared-view locals)
                (tc-global-shared-view loop-carried)
                moved1
                init-box))]
          [init-ty
            (try
              (tc-body-type-fact-expr-id "move.resource_init" ctx env init-box))]
          ;; An obligated `let` value handed to a `with` owner
          ;; is cleaned by that owner.
          [moved2 : TcMovedSet
            (tc-move-discharge-direct
              ctx
              expr-bases
              (tc-global-shared-view locals)
              moved-bound
              init-box)]
          [shadowed : TcMovedRootSnapshot
            (tc-moved-root-snapshot (tc-global-shared-view moved2) name)]
          [exit-moved
            (try
              (tc-move-check-resource-bindings-at
                ctx
                expr-bases
                (tc-bind-id
                  (tc-bind-id env (tc-cleanup-owner-marker-id) (Var name))
                  name
                  ;; Keep the initializer's arena brands, as a `let`
                  ;; binding does: a safe destroy or rewind of that
                  ;; arena must find this owner.
                  (tc-global-shared-view init-ty))
                (if move-aware?
                  (tc-moved-add locals name)
                  (tc-move-bind-with-owner locals name init-box))
                (tc-moved-remove-root-state loop-carried name)
                (tc-param-storage-rebind-from-init
                  ctx
                  expr-bases
                  env
                  moved2
                  name
                  init-ty
                  init)
                bindings
                (+ index 1)
                (tc-move-cleanup-owners-set
                  roots
                  index
                  name
                  init-box
                  move-aware?)
                exprs
                scope))]
          (Ok (tc-moved-restore-root-state exit-moved shadowed)))])))

(define (tc-move-check-cleanup-owner-exit
  [expr-bases : i64]
  [moved : TcMovedSet]
  [roots : TcMoveCleanupOwners]
  [scope : ast.AstExpr]
  [index : i64]) : TcMoveResult
  (if (>= index roots.len)
    (Ok moved)
    (let
      [owner : TcMoveCleanupOwner (array-ref roots.slots index)]
      [name-id : i64 owner.name-id]
      (cond
        [owner.move-aware
          (tc-move-check-cleanup-owner-exit
            expr-bases
            (tc-moved-remove-root-state moved name-id)
            roots
            scope
            (+ index 1))]
        [(or
            (tc-moved-contains? moved name-id)
            (tc-moved-partial? moved name-id))
          (Err
            (tc-move-rich-cleanup-owner-exit-message
              expr-bases
              (tc-moved-root-conflict moved name-id)
              (tc-hygiene-name-text-id name-id)
              owner.owner-origin-id
              scope))]
        [else
          (tc-move-check-cleanup-owner-exit
            expr-bases
            moved
            roots
            scope
            (+ index 1))]))))

(define (tc-move-add-bound-names [locals : TcMovedSet] [names : TcNameIdList]) : TcMovedSet
  (let
    [cursor : TcNameIdList names]
    [out : TcMovedSet locals]
    (while (not (tc-name-id-list-empty? cursor))
      (set! out (tc-moved-add out (tc-name-id-list-head cursor)))
      (set! cursor (tc-name-id-list-rest cursor)))
    out))

(define (tc-move-remove-bound-root-states
  [moved : TcMovedSet]
  [names : TcNameIdList]) : TcMovedSet
  (let
    [cursor : TcNameIdList names]
    [out : TcMovedSet moved]
    (while (not (tc-name-id-list-empty? cursor))
      (set! out (tc-moved-remove-root-state out (tc-name-id-list-head cursor)))
      (set! cursor (tc-name-id-list-rest cursor)))
    out))

;; Each arm is checked from the same post-scrutinee state; results are unioned so
;; a place moved on any arm is considered moved after the match.
(define (tc-move-check-arms
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [parameter-id : i64]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]) : TcMoveResult
  (tc-move-check-arms-at
    ctx
    expr-bases
    env
    locals
    loop-carried
    moved
    parameter-id
    scrut-ty
    (& arms)
    0
    (tc-moved-empty)
    -1
    false))

;; An arm that never completes normally cannot reach the join, so its moves,
;; borrows and reinitializations say nothing about the code after it. That is
;; exactly an arm of type `never`: a `return`, `break`, `continue`, a call to a
;; `never` function, or a sequence or branch ending in those. The arm's recorded
;; body fact answers it with one lookup. Only an arm whose facts differ from the
;; facts at branch entry (or whose sibling reinitialized something) is asked:
;; every other arm leaves the join unchanged whether or not it diverges.
(define (tc-move-arm-diverges?
  [ctx : TcContext]
  [expr-bases : i64]
  [arm-id : i64]) : bool
  (match (tc-body-type-fact-lookup (tc-context-body-state ctx) arm-id)
    [(Hit ty) (tc-never-type? ty)]
    [(Miss) (tc-move-tail-diverges? ctx expr-bases arm-id)]))

;; Bodies checked without recorded facts (synthesized after source typecheck)
;; fall back to the arm's tail chain. Any shape it does not recognize answers
;; false, which keeps the arm in the join.
(define (tc-move-tail-diverges?
  [ctx : TcContext]
  [expr-bases : i64]
  [expr-id : i64]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases
    expr-bases
    (& (ast.ast-expr-segment-bases-get expr-bases expr-id)))
    [(or (Return _) (Break) (Continue)) true]
    [(Call func-box _) (tc-move-call-fact-diverges? ctx func-box)]
    [(or (Begin exprs) (Unsafe exprs))
      (tc-move-tail-diverges-last? ctx expr-bases (& exprs))]
    [(If _ then-box else-box)
      (and
        (tc-move-tail-diverges? ctx expr-bases then-box)
        (tc-move-tail-diverges? ctx expr-bases else-box))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let _ body-box) (tc-move-tail-diverges? ctx expr-bases body-box)])]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match _ arms)
          (and
            (> arms.len 0)
            (tc-move-tail-diverges-arms-at? ctx expr-bases (& arms) 0))])]
    [_ false]))

(define (tc-move-tail-diverges-last?
  [ctx : TcContext]
  [expr-bases : i64]
  [exprs : (& exprs ast.AstExprList)]) : bool
  (if (<= exprs.len 0)
    false
    (tc-move-tail-diverges?
      ctx
      expr-bases
      (ast.ast-expr-list-get exprs (- exprs.len 1) 0))))

(define (tc-move-tail-diverges-arms-at?
  [ctx : TcContext]
  [expr-bases : i64]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index arms.len)
    true
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm _ body-box)
        (if (tc-move-tail-diverges? ctx expr-bases body-box)
          (tc-move-tail-diverges-arms-at? ctx expr-bases arms (+ index 1))
          false)])))

;; Whether an `if` arm must be left out of the join. An arm that kept the entry
;; facts only matters when the other arm removed one (a reinitialization), since
;; the union would otherwise put that fact back; its tail is not walked in any
;; other case.
(define (tc-move-join-if-drops-arm?
  [ctx : TcContext]
  [expr-bases : i64]
  [entry : (& entry TcMovedSet)]
  [entry-paths : TcMovedPathFacts]
  [arm : (& arm TcMovedSet)]
  [arm-paths : TcMovedPathFacts]
  [arm-id : i64]
  [other : (& other TcMovedSet)]
  [other-paths : TcMovedPathFacts]) : bool
  (if (and
    (tc-moved-same-facts?
      arm
      entry
      arm-paths
      (tc-global-shared-view entry-paths))
    (tc-moved-facts-subset? entry other entry-paths other-paths))
    false
    (tc-move-arm-diverges? ctx expr-bases arm-id)))

;; Reached only when an arm changed the entry facts. An arm that cannot reach
;; the join is dropped: the edge it leaves through checked the owners whose
;; scope it leaves. The arms that remain keep the conservative may-move union,
;; so the one remaining arm of a pair also keeps its reinitializations. When
;; both arms are dropped the code after the `if` is unreachable and sees the
;; entry facts.
(define (tc-move-join-if
  [ctx : TcContext]
  [expr-bases : i64]
  [entry : TcMovedSet]
  [then-moved : TcMovedSet]
  [then-id : i64]
  [else-moved : TcMovedSet]
  [else-id : i64]) : TcMovedSet
  (let
    [drop-then? : bool
      (tc-move-join-if-drops-arm?
        ctx
        expr-bases
        (& entry)
        (tc-global-shared-view entry.paths)
        (& then-moved)
        (tc-global-shared-view then-moved.paths)
        then-id
        (& else-moved)
        (tc-global-shared-view else-moved.paths))]
    [drop-else? : bool
      (tc-move-join-if-drops-arm?
        ctx
        expr-bases
        (& entry)
        (tc-global-shared-view entry.paths)
        (& else-moved)
        (tc-global-shared-view else-moved.paths)
        else-id
        (& then-moved)
        (tc-global-shared-view then-moved.paths))]
    (cond
      [(and drop-then? drop-else?) entry]
      [drop-then? else-moved]
      [drop-else? then-moved]
      [else (tc-moved-union then-moved else-moved)])))

;; A match joins the entry state with every arm that completes normally.
;; `arm-visible` has the arm's pattern bindings already removed.
(define (tc-move-join-match-arm
  [ctx : TcContext]
  [expr-bases : i64]
  [entry : TcMovedSet]
  [arm-visible : TcMovedSet]
  [body-id : i64]) : TcMovedSet
  (cond
    ;; The arm kept the entry facts, so the union with it is the entry state.
    [(tc-moved-same-facts?
        (& arm-visible)
        (& entry)
        (tc-global-shared-view arm-visible.paths)
        (tc-global-shared-view entry.paths))
      entry]
    [(tc-move-arm-diverges? ctx expr-bases body-id) entry]
    [else (tc-moved-union entry arm-visible)]))

(define (tc-move-check-arms-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [parameter-id : i64]
  [scrut-ty : ast.AstType]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]
  [reference : TcMovedSet]
  [reference-body-box : i64]
  [reference? : bool]) : TcMoveResult
  (if (>= index arms.len)
    (Ok moved)
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          [bound : TcNameIdList
            (tc-borrow-check-pattern-bound-names
              ctx
              (tc-global-shared-view scrut-ty)
              (tc-global-shared-view pattern))]
          [arm-env
            (try
              (tc-bind-match-pattern
                ctx
                env
                (tc-global-shared-view scrut-ty)
                pattern))]
          [arm-moved
            (try
              (tc-move-check-expr
                ctx
                expr-bases
                arm-env
                (tc-move-add-bound-names (tc-moved-clone locals) bound)
                (tc-move-remove-bound-root-states
                  (tc-moved-clone loop-carried)
                  bound)
                (tc-param-storage-bind-pattern-names
                  ctx
                  arm-env
                  (tc-move-remove-bound-root-states
                    (tc-moved-clone moved)
                    bound)
                  bound
                  parameter-id)
                (tc-global-shared-view body)))]
          [arm-visible : TcMovedSet
            (tc-move-remove-bound-root-states arm-moved bound)]
          ;; Every arm that completes normally must leave the
          ;; obligated locals as the first such arm did.
          [normal? : bool
            (and
              (tc-move-let-obligations-possible?)
              (not (tc-move-arm-diverges? ctx expr-bases body-box)))]
          [_
            (try
              (if (and normal? reference?)
                (tc-move-check-obligations-agree
                  expr-bases
                  (tc-global-shared-view locals)
                  (tc-global-shared-view reference)
                  (ast.ast-expr-segment-bases-get expr-bases reference-body-box)
                  (tc-global-shared-view arm-visible)
                  (tc-global-shared-view body)
                  "through this match")
                ResultTcUnit.Ok))]
          [next-reference : TcMovedSet
            (if (and normal? (not reference?))
              (tc-moved-clone (& arm-visible))
              reference)]
          [next-reference? : bool (or reference? normal?)]
          [next-reference-body-box : i64
            (if reference?
              reference-body-box
              body-box)]
          [visible-arm-moved : TcMovedSet
            (tc-move-join-match-arm
              ctx
              expr-bases
              (tc-global-shared-view moved)
              arm-visible
              body-box)]
          [rest-moved : TcMovedSet
            (try
              (tc-move-check-arms-at
                ctx
                expr-bases
                env
                (tc-moved-clone locals)
                (tc-moved-clone loop-carried)
                (tc-moved-clone moved)
                parameter-id
                scrut-ty
                arms
                (+ index 1)
                next-reference
                next-reference-body-box
                next-reference?))]
          (Ok (tc-moved-union visible-arm-moved rest-moved)))])))

(define (tc-move-check-expr-id
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr-id : i64]) : TcMoveResult
  (tc-move-check-expr
    ctx
    expr-bases
    env
    locals
    loop-carried
    moved
    (ast.ast-expr-segment-bases-get expr-bases expr-id)))

(define (tc-move-check-ptr-addr-of-place
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [place : ast.AstExpr]
  [origin : ast.AstExpr]) : TcMoveResult
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& place))
    [(Var name)
      (let
        [name-text : String
          (tc-hygiene-name-text-id-for-session
            (tc-context-structural-session ctx)
            name)]
        (if (tc-moved-contains? moved name)
          (tc-move-rich-use-conflict-result
            expr-bases
            (tc-moved-conflict moved name)
            (tc-global-shared-view name-text)
            origin
            name-text)
          (Ok moved)))]
    [(StructGet receiver-box _)
      (let
        [receiver : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases receiver-box)]
        (tc-move-check-ptr-addr-of-place
          ctx
          expr-bases
          env
          locals
          loop-carried
          moved
          receiver
          origin))]
    [(ArrayRef array-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        [moved1
          (try
            (tc-move-check-ptr-addr-of-place
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view loop-carried)
              moved
              array
              origin))]
        (tc-move-check-expr ctx expr-bases env locals loop-carried moved1 index))]
    [_ (tc-move-check-expr ctx expr-bases env locals loop-carried moved place)]))

(define (tc-move-check-slice-view-call
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [call-expr : ast.AstExpr]
  [kind : TcSliceViewCallKind]
  [args : ast.AstExprList]) : TcMoveResult
  (if (=
    args.len
    (if (tc-slice-call-split? kind)
      2
      3))
    (let
      [source : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get (& args) 0 0))]
      [start : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get (& args) 1 0))]
      ;; Mutable direct owners are still places, so preserve the existing
      ;; by-value-parameter storage guard.  Reference sources (including
      ;; nested subview results) do not consume or rebind their source.
      [write-check : ResultTcUnit
        (if (tc-slice-call-mutable? kind)
          (match (tc-expr ctx env (tc-global-shared-view source))
            [(Ok source-ty)
              (match (tc-slice-view-source-info ctx source-ty)
                [(Direct _)
                  ;; A mutable view of a bare foreign global borrows it as
                  ;; mutably as `(&mut global)` does (#7976).
                  (match (tc-move-foreign-global-place-check
                    ctx
                    expr-bases
                    env
                    (tc-global-shared-view locals)
                    (ast.ast-expr-list-get (& args) 0 0)
                    "mutably borrow")
                    [(Ok)
                      (tc-param-storage-note-write
                        ctx
                        expr-bases
                        env
                        (tc-global-shared-view moved)
                        (tc-global-shared-view source))
                      (tc-move-note-mut-borrow-root
                        ctx
                        expr-bases
                        env
                        (tc-global-shared-view source))
                      Ok]
                    [(Err message) (Err message)])]
                [_ Ok])]
            [(Err _) Ok])
          Ok)]
      [_ (try write-check)]
      [moved1
        (try
          (tc-move-check-expr
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            (tc-global-shared-view loop-carried)
            moved
            source))]
      [moved2
        (try
          (tc-move-check-expr
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            (tc-global-shared-view loop-carried)
            moved1
            start))]
      (if (tc-slice-call-split? kind)
        (Ok moved2)
        (tc-move-check-expr
          ctx
          expr-bases
          env
          locals
          loop-carried
          moved2
          (ast.ast-expr-segment-bases-get
            expr-bases
            (ast.ast-expr-list-get (& args) 2 0)))))
    (Err
      (tc-locate-error-at-expr
        expr-bases
        call-expr
        (if (tc-slice-call-split? kind)
          "typecheck: slice-split-at expects exactly two arguments"
          "typecheck: slice-view expects exactly three arguments")))))

;; Borrowing a place observes every receiver and index but never performs the
;; by-value transfer represented by public `deref`. Rebuild only the place
;; spine with the seed's non-consuming BoxGet node, then reuse the ordinary
;; move checker for conflict diagnostics and index evaluation.
(define (tc-move-borrow-place-read-expr-id
  [expr-bases : i64]
  [expr : ast.AstExpr]) : i64
  (match (tc-global-shared-view expr)
    [(Spanned inner-box span)
      (ast.ast-expr-spanned
        (tc-move-borrow-place-read-expr-id
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases inner-box))
        span)]
    [(Ann inner-box ty-id)
      (ast.ast-expr-ann-id
        (tc-move-borrow-place-read-expr-id
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases inner-box))
        ty-id)]
    [(Cast inner-box ty-id)
      (ast.ast-expr-cast-id
        (tc-move-borrow-place-read-expr-id
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases inner-box))
        ty-id)]
    [(StructGet receiver-box field)
      (ast.ast-expr-struct-get-id
        (tc-move-borrow-place-read-expr-id
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases receiver-box))
        field)]
    [(TupleRef receiver-box index)
      (ast.ast-expr-tuple-ref
        (tc-move-borrow-place-read-expr-id
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases receiver-box))
        index)]
    [(ArrayRef receiver-box index-box)
      (ast.ast-expr-array-ref
        (tc-move-borrow-place-read-expr-id
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases receiver-box))
        index-box)]
    [(or (BoxGet receiver-box) (BoxTake receiver-box))
      (ast.ast-expr-box-get
        (tc-move-borrow-place-read-expr-id
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases receiver-box)))]
    [_ (ast.ast-node-push expr)]))

;; The `deref` operand at the root of a field and tuple-element projection
;; chain such as `(deref b).leaf.w`, or -1 when the chain has no `deref` root.
(define (tc-projection-deref-root-operand
  [expr-bases : i64]
  [receiver : ast.AstExpr]) : i64
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& receiver))
    [(or (ast.AstExpr.StructGet inner-box _) (ast.AstExpr.TupleRef inner-box _))
      (tc-projection-deref-root-operand
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.BoxTake inner-box) inner-box]
    [_ -1]))

;; The receiver a field or tuple-element projection reads. A Copy projection
;; through `(deref place)`, directly or through further projections, copies out
;; of the boxed or referenced storage in place, so `(deref b).v` and
;; `(deref b).leaf.w` check `b` as a read instead of consuming the box. A
;; non-Copy projection keeps the consuming `deref` and its diagnostics.
(define (tc-move-projection-receiver
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-bases : i64]
  [projection : ast.AstExpr]
  [receiver : ast.AstExpr]) : ast.AstExpr
  (let
    [operand-id : i64
      (tc-projection-deref-root-operand
        expr-bases
        (tc-global-shared-view receiver))]
    (if (< operand-id 0)
      receiver
      (match (match (tc-global-shared-view projection)
        [(ast.AstExpr.StructGet receiver-id field-id)
          ;; Consumption uses the intrinsic receiver type recorded for this
          ;; same body and node. Reuse the ordinary field-type resolver; a
          ;; missing fact keeps the full query, including raw-deref recovery.
          (match (tc-body-type-fact-lookup-profiled
            "projection.copy_receiver"
            ctx
            receiver-id)
            [(TcBodyTypeFact.Hit receiver-ty)
              (tc-struct-get-result-type-id ctx receiver-ty field-id)]
            [(TcBodyTypeFact.Miss) (tc-expr ctx env projection)])]
        [_ (tc-expr ctx env projection)])
        [(ResultTcType.Ok projected-ty)
          (if (tc-type-copyable? ctx projected-ty)
            (ast.ast-expr-segment-bases-get expr-bases operand-id)
            receiver)]
        [(ResultTcType.Err _) receiver]))))

(define (tc-move-check-borrow-place
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [place : ast.AstExpr]) : TcMoveResult
  (tc-move-check-expr-id
    ctx
    expr-bases
    env
    locals
    loop-carried
    moved
    (tc-move-borrow-place-read-expr-id expr-bases place)))

(define (tc-move-cleanup-overwrite-message) : String
  (tc-kind-message
    (ResourceOwnership)
    "typecheck: cannot overwrite initialized cleanup-owning place; move or clean up the old value first"))

(define (tc-move-place-definitely-uninitialized?
  [expr-bases : i64]
  [moved : TcMovedSet]
  [place : ast.AstExpr]) : bool
  (match (tc-move-direct-root-base-path expr-bases place)
    [(Some path)
      (if (= path.segments.len 0)
        (tc-moved-contains? moved path.root)
        (match (tc-moved-path-exact-conflict-kind moved path (Move))
          [(Some _ _) true]
          [No false]))]
    [(No) false]))

(define (tc-move-check-cleanup-overwrite
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [moved : TcMovedSet]
  [place : ast.AstExpr]) : ResultTcUnit
  (match (tc-expr ctx env (tc-global-shared-view place))
    [(Ok place-ty)
      (if (and
        (tc-cleanup-owning-aggregate-type? ctx place-ty)
        (not (tc-move-place-definitely-uninitialized? expr-bases moved place)))
        (Err (tc-move-cleanup-overwrite-message))
        Ok)]
    [(Err _) Ok]))

(define (tc-move-loop-flow-normal) : TcMoveLoopFlow
  (TcMoveLoopFlow true false false false))

(define (tc-move-loop-flow-exit) : TcMoveLoopFlow
  (TcMoveLoopFlow false false false true))

(define (tc-move-loop-flow-break) : TcMoveLoopFlow
  (TcMoveLoopFlow false false true false))

(define (tc-move-loop-flow-repeat) : TcMoveLoopFlow
  (TcMoveLoopFlow false true false false))

(define (tc-move-loop-flow-seq [first : TcMoveLoopFlow] [rest : TcMoveLoopFlow]) : TcMoveLoopFlow
  (TcMoveLoopFlow
    (and first.normal rest.normal)
    (or first.repeat (and first.normal rest.repeat))
    (or first.breaks (and first.normal rest.breaks))
    (or first.exit (and first.normal rest.exit))))

(define (tc-move-loop-flow-branches [a : TcMoveLoopFlow] [b : TcMoveLoopFlow]) : TcMoveLoopFlow
  (TcMoveLoopFlow
    (or a.normal b.normal)
    (or a.repeat b.repeat)
    (or a.breaks b.breaks)
    (or a.exit b.exit)))

(define (tc-move-loop-flow-reaches-repeat?
  [flow : TcMoveLoopFlow]
  [continuation-repeats : bool]) : bool
  (or flow.repeat (and flow.normal continuation-repeats)))

(define (tc-move-loop-flow-reaches-break?
  [flow : TcMoveLoopFlow]
  [continuation-breaks : bool]) : bool
  (or flow.breaks (and flow.normal continuation-breaks)))

(define (tc-move-loop-flow-exprs-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : TcMoveLoopFlow
  (if (>= index exprs.len)
    (tc-move-loop-flow-normal)
    (tc-move-loop-flow-seq
      (tc-move-loop-flow-expr
        ctx
        expr-bases
        env
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get exprs index 0)))
      (tc-move-loop-flow-exprs-at ctx expr-bases env exprs (+ index 1)))))

(define (tc-move-loop-flow-exprs
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]) : TcMoveLoopFlow
  (tc-move-loop-flow-exprs-at ctx expr-bases env (& exprs) 0))

(define (tc-move-loop-flow-let-bindings-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]
  [body-box : i64]) : TcMoveLoopFlow
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (tc-move-loop-flow-expr
      ctx
      expr-bases
      env
      (ast.ast-expr-segment-bases-get expr-bases body-box))
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding _ _ init-box)
        (tc-move-loop-flow-seq
          (tc-move-loop-flow-expr
            ctx
            expr-bases
            env
            (ast.ast-expr-segment-bases-get expr-bases init-box))
          (tc-move-loop-flow-let-bindings-at
            ctx
            expr-bases
            env
            bindings
            (+ index 1)
            body-box))])))

(define (tc-move-loop-flow-match-arms-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : TcMoveLoopFlow
  (if (>= index arms.len)
    (TcMoveLoopFlow false false false false)
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm _ body-box)
        (tc-move-loop-flow-branches
          (tc-move-loop-flow-expr
            ctx
            expr-bases
            env
            (ast.ast-expr-segment-bases-get expr-bases body-box))
          (tc-move-loop-flow-match-arms-at ctx expr-bases env arms (+ index 1)))])))

;; Flow summaries ask this for every call they walk, so the common concrete
;; function type is answered from its own result node: resolution runs only for
;; a callee or result type written through an alias.
(define (tc-move-func-result-diverges? [ctx : TcContext] [ret : ast.AstType]) : bool
  (match (tc-global-shared-view ret)
    [(Never) true]
    [(or (Var _) (VarArgs _ _)) (tc-never-type? (tc-resolve-type ctx ret))]
    [_ false]))

(define (tc-move-func-type-diverges? [ctx : TcContext] [func-ty : ast.AstType]) : bool
  (match (tc-global-shared-view func-ty)
    [(Func _ ret) (tc-move-func-result-diverges? ctx (ast.ty-node-get ret))]
    [(or (Var _) (VarArgs _ _))
      (match (tc-resolve-type ctx func-ty)
        [(Func _ ret) (tc-move-func-result-diverges? ctx (ast.ty-node-get ret))]
        [_ false])]
    [_ false]))

;; The callee's recorded body fact is the type of the expression actually
;; called, so it covers qualified and imported callees such as `io.panic`, which
;; the local environment does not bind, and cannot be misled by a shadowing
;; local. A miss answers "does not diverge", the conservative result.
(define (tc-move-call-fact-diverges? [ctx : TcContext] [func-box : i64]) : bool
  (match (tc-body-type-fact-lookup (tc-context-body-state ctx) func-box)
    [(Hit func-ty) (tc-move-func-type-diverges? ctx func-ty)]
    [(Miss) false]))

;; The loop summary extends `env` with the bindings it walks past, so a bare
;; local name without a fact may still be answered from the environment.
(define (tc-move-loop-direct-call-diverges?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [func-box : i64]) : bool
  (if (tc-move-call-fact-diverges? ctx func-box)
    true
    (match (ast.ast-expr-unspan-with-segment-bases
      expr-bases
      (& (ast.ast-expr-segment-bases-get expr-bases func-box)))
      [(Var name-id)
        (match (tc-lookup-id env name-id)
          [(Ok func-ty) (tc-move-func-type-diverges? ctx func-ty)]
          [(Err _) false])]
      [_ false])))

;; A form without its own arm in `tc-move-loop-flow-expr` (a call, operator,
;; `set!`, constructor, ...) continues as the form itself does, but a `break`,
;; `continue` or exit nested in one of its operands still takes that edge
;; (#8575). With `move-operand-edges` set, its flow is the form's own `normal`
;; with the operands' edges added; `normal` stays the form's, an
;; over-approximation, since an operand that always diverges is rare and only
;; costs precision. Without it the operands are not walked: every summary would
;; walk them again, and only a body whose first walk reached such a `break` or
;; `continue` needs them (`tc-move-check-body-walk`).
(define (tc-move-loop-flow-add-operand
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [flow : TcMoveLoopFlow]
  [id : i64]) : TcMoveLoopFlow
  (if (tc-body-move-operand-edges? (tc-context-body-state ctx))
    (let
      [edges : TcMoveLoopFlow
        (tc-move-loop-flow-expr
          ctx
          expr-bases
          env
          (ast.ast-expr-segment-bases-get expr-bases id))]
      (TcMoveLoopFlow
        flow.normal
        (or flow.repeat edges.repeat)
        (or flow.breaks edges.breaks)
        (or flow.exit edges.exit)))
    flow))

(define (tc-move-loop-flow-with-operands
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [own : TcMoveLoopFlow]) : TcMoveLoopFlow
  (if (tc-body-move-operand-edges? (tc-context-body-state ctx))
    (let
      [ids : ast.AstExprList
        (ast.ast-expr-child-ids
          (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr)))]
      [flow : TcMoveLoopFlow own]
      [index : i64 0]
      (while (< index (ast.ast-expr-list-len (& ids)))
        (set!
          flow
          (tc-move-loop-flow-add-operand
            ctx
            expr-bases
            env
            flow
            (ast.ast-expr-list-get (& ids) index 0)))
        (set! index (+ index 1)))
      flow)
    own))

(define (tc-move-loop-flow-expr
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]) : TcMoveLoopFlow
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(or (Begin exprs) (Unsafe exprs))
      (tc-move-loop-flow-exprs ctx expr-bases env exprs)]
    [(If cond-box then-box else-box)
      (tc-move-loop-flow-seq
        (tc-move-loop-flow-expr
          ctx
          expr-bases
          env
          (ast.ast-expr-segment-bases-get expr-bases cond-box))
        (tc-move-loop-flow-branches
          (tc-move-loop-flow-expr
            ctx
            expr-bases
            env
            (ast.ast-expr-segment-bases-get expr-bases then-box))
          (tc-move-loop-flow-expr
            ctx
            expr-bases
            env
            (ast.ast-expr-segment-bases-get expr-bases else-box))))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (tc-move-loop-flow-let-bindings-at
            ctx
            expr-bases
            env
            (& bindings)
            0
            body-box)])]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match scrut-box arms)
          (tc-move-loop-flow-seq
            (tc-move-loop-flow-expr
              ctx
              expr-bases
              env
              (ast.ast-expr-segment-bases-get expr-bases scrut-box))
            (tc-move-loop-flow-match-arms-at ctx expr-bases env (& arms) 0))])]
    [(Return inner-box)
      (let
        [inner-flow : TcMoveLoopFlow
          (tc-move-loop-flow-expr
            ctx
            expr-bases
            env
            (ast.ast-expr-segment-bases-get expr-bases inner-box))]
        (TcMoveLoopFlow
          false
          inner-flow.repeat
          inner-flow.breaks
          (or inner-flow.normal inner-flow.exit)))]
    [(Break) (tc-move-loop-flow-break)]
    [(Continue) (tc-move-loop-flow-repeat)]
    [(Try inner-box)
      (let
        [inner-flow : TcMoveLoopFlow
          (tc-move-loop-flow-expr
            ctx
            expr-bases
            env
            (ast.ast-expr-segment-bases-get expr-bases inner-box))]
        (TcMoveLoopFlow
          inner-flow.normal
          inner-flow.repeat
          inner-flow.breaks
          true))]
    ;; Nested loops own their body's break/continue edges and can execute zero
    ;; times, so they normally continue in the surrounding loop. Their header
    ;; (condition or bounds) runs in the surrounding loop, so its edges count.
    [(While cond-box _)
      (tc-move-loop-flow-add-operand
        ctx
        expr-bases
        env
        (tc-move-loop-flow-normal)
        cond-box)]
    [(Foreach fe-box)
      (match (__tl-box-place fe-box)
        [(Foreach _ _ start-box end-box _)
          (tc-move-loop-flow-add-operand
            ctx
            expr-bases
            env
            (tc-move-loop-flow-add-operand
              ctx
              expr-bases
              env
              (tc-move-loop-flow-normal)
              start-box)
            end-box)]
        [(Foreach2 _ _ a-box b-box _ _ c-box d-box _)
          (let
            [flow : TcMoveLoopFlow (tc-move-loop-flow-normal)]
            (set!
              flow
              (tc-move-loop-flow-add-operand ctx expr-bases env flow a-box))
            (set!
              flow
              (tc-move-loop-flow-add-operand ctx expr-bases env flow b-box))
            (set!
              flow
              (tc-move-loop-flow-add-operand ctx expr-bases env flow c-box))
            (tc-move-loop-flow-add-operand ctx expr-bases env flow d-box))])]
    [(or (ForeachActive _ _) (Lambda _)) (tc-move-loop-flow-normal)]
    ;; A lambda body's edges leave the lambda, not this loop.
    ;; Read the already-bound direct callee signature instead of recursively
    ;; re-running inference over every call in a loop body.
    [(Call func-box _)
      (tc-move-loop-flow-with-operands
        ctx
        expr-bases
        env
        expr
        (if (tc-move-loop-direct-call-diverges? ctx expr-bases env func-box)
          (tc-move-loop-flow-exit)
          (tc-move-loop-flow-normal)))]
    [_
      (tc-move-loop-flow-with-operands
        ctx
        expr-bases
        env
        expr
        (tc-move-loop-flow-normal))]))

(define (tc-move-loop-result-add-breaks
  [prior? : bool]
  [prior : TcMovedSet]
  [result : TcMoveLoopResult]) : TcMoveLoopResult
  (match result
    [(Ok normal? normal-moved-box breaks? break-moved-box)
      (Ok
        normal?
        normal-moved-box
        (or prior? breaks?)
        (cond
          [(and prior? breaks?)
            (box
              (tc-moved-union
                prior
                (tc-moved-set-box-shared-view break-moved-box)))]
          [prior? (box prior)]
          [else break-moved-box]))]
    [(Err message) (Err message)]))

;; The fallthrough states of two loop-walker results that a branch joins agree
;; on every obligated local when both complete normally.
(define (tc-move-loop-results-agree-impl
  [expr-bases : i64]
  [locals : TcMovedSet]
  [a : TcMoveLoopResult]
  [b : TcMoveLoopResult]
  [branch : ast.AstExpr]) : ResultTcUnit
  (if (not (tc-move-let-obligations-possible?))
    Ok
    (match a
      [(Ok a-normal? a-box _ _)
        (match b
          [(Ok b-normal? b-box _ _)
            (if (and a-normal? b-normal?)
              (tc-move-check-obligations-agree
                expr-bases
                locals
                (tc-moved-set-box-shared-view a-box)
                (tc-global-shared-view branch)
                (tc-moved-set-box-shared-view b-box)
                (tc-global-shared-view branch)
                "through this branch")
              Ok)]
          [(Err _) Ok])]
      [(Err _) Ok])))

;; The end of an obligated `let` binding's scope on the fallthrough path of a
;; loop body; its `break` edges were checked where they leave the loop.
(define (tc-move-loop-result-check-obligation-end
  [ctx : TcContext]
  [expr-bases : i64]
  [result : TcMoveLoopResult]
  [name-id : i64]
  [origin-id : i64]
  [body-box : i64]) : TcMoveLoopResult
  (match result
    [(Ok normal? normal-moved-box breaks? break-moved-box)
      (if normal?
        (let
          [_
            (try
              (tc-move-check-let-obligation-end
                ctx
                expr-bases
                (tc-moved-set-box-shared-view
                  (tc-global-shared-view normal-moved-box))
                name-id
                origin-id
                body-box))]
          (Ok normal? normal-moved-box breaks? break-moved-box))
        (Ok normal? normal-moved-box breaks? break-moved-box))]
    [(Err message) (Err message)]))

;; A `let` scope in a loop body ends both where its body falls through and
;; where it breaks out of the loop.
(define (tc-move-loop-result-restore-root-state
  [result : TcMoveLoopResult]
  [shadowed : TcMovedRootSnapshot]) : TcMoveLoopResult
  (match result
    [(Ok normal? normal-moved-box breaks? break-moved-box)
      (Ok
        normal?
        (if normal?
          (box
            (tc-moved-restore-root-state
              (tc-moved-set-box-shared-view normal-moved-box)
              (tc-global-shared-view shadowed)))
          normal-moved-box)
        breaks?
        (if breaks?
          (box
            (tc-moved-restore-root-state
              (tc-moved-set-box-shared-view break-moved-box)
              shadowed))
          break-moved-box))]
    [(Err message) (Err message)]))

(define (tc-move-loop-result-branches
  [fallback : TcMovedSet]
  [a : TcMoveLoopResult]
  [b : TcMoveLoopResult]) : TcMoveLoopResult
  (match a
    [(Err message) (Err message)]
    [(Ok normal-a? moved-a-box breaks-a? break-a-box)
      (match b
        [(Err message) (Err message)]
        [(Ok normal-b? moved-b-box breaks-b? break-b-box)
          (Ok
            (or normal-a? normal-b?)
            (cond
              [(and normal-a? normal-b?)
                (box
                  (let
                    [a (tc-moved-set-box-shared-view moved-a-box)]
                    (tc-moved-union
                      a
                      (tc-moved-set-box-shared-view moved-b-box))))]
              [normal-a? moved-a-box]
              [normal-b? moved-b-box]
              [else (box fallback)])
            (or breaks-a? breaks-b?)
            (cond
              [(and breaks-a? breaks-b?)
                (box
                  (let
                    [a (tc-moved-set-box-shared-view break-a-box)]
                    (tc-moved-union
                      a
                      (tc-moved-set-box-shared-view break-b-box))))]
              [breaks-a? break-a-box]
              [else break-b-box]))])]))

(define (tc-move-check-loop-exprs-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [outer-loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [continuation-repeats : bool]
  [continuation-breaks : bool]) : TcMoveLoopResult
  (if (>= index exprs.len)
    (Ok true (box moved) false (box (tc-moved-empty)))
    (let
      [expr-id : i64 (ast.ast-expr-list-get exprs index 0)]
      [rest-flow : TcMoveLoopFlow
        (tc-move-loop-flow-exprs-at ctx expr-bases env exprs (+ index 1))]
      [head-continuation-repeats : bool
        (tc-move-loop-flow-reaches-repeat? rest-flow continuation-repeats)]
      [head-continuation-breaks : bool
        (tc-move-loop-flow-reaches-break? rest-flow continuation-breaks)]
      (match (tc-move-check-loop-expr
        ctx
        expr-bases
        env
        (tc-global-shared-view locals)
        (tc-global-shared-view loop-carried)
        (tc-global-shared-view outer-loop-carried)
        moved
        (ast.ast-expr-segment-bases-get expr-bases expr-id)
        head-continuation-repeats
        head-continuation-breaks)
        [(Err message) (Err message)]
        [(Ok normal? moved1-box breaks? break-moved-box)
          (if normal?
            (tc-move-loop-result-add-breaks
              breaks?
              (tc-moved-set-box-shared-view break-moved-box)
              (tc-move-check-loop-exprs-at
                ctx
                expr-bases
                env
                locals
                loop-carried
                outer-loop-carried
                (tc-moved-set-box-shared-view moved1-box)
                exprs
                (+ index 1)
                continuation-repeats
                continuation-breaks))
            (Ok false moved1-box breaks? break-moved-box))]))))

(define (tc-move-check-loop-exprs
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [outer-loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : ast.AstExprList]
  [continuation-repeats : bool]
  [continuation-breaks : bool]) : TcMoveLoopResult
  (tc-move-check-loop-exprs-at
    ctx
    expr-bases
    env
    locals
    loop-carried
    outer-loop-carried
    moved
    (& exprs)
    0
    continuation-repeats
    continuation-breaks))

(define (tc-move-check-loop-let-bindings-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [outer-loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]
  [body-box : i64]
  [continuation-repeats : bool]
  [continuation-breaks : bool]) : TcMoveLoopResult
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (tc-move-check-loop-expr
      ctx
      expr-bases
      env
      locals
      loop-carried
      outer-loop-carried
      moved
      (ast.ast-expr-segment-bases-get expr-bases body-box)
      continuation-repeats
      continuation-breaks)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name maybe-ty init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [tail-flow : TcMoveLoopFlow
            (tc-move-loop-flow-let-bindings-at
              ctx
              expr-bases
              env
              bindings
              (+ index 1)
              body-box)]
          [tail-repeats : bool
            (tc-move-loop-flow-reaches-repeat? tail-flow continuation-repeats)]
          [tail-breaks : bool
            (tc-move-loop-flow-reaches-break? tail-flow continuation-breaks)]
          [active-loop-carried : TcMovedSet
            (cond
              [tail-repeats
                (owned_view.compiler-owned-shared-view loop-carried)]
              [tail-breaks
                (owned_view.compiler-owned-shared-view outer-loop-carried)]
              [else (tc-moved-empty)])]
          (match (tc-move-check-loop-expr
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            (tc-global-shared-view loop-carried)
            (tc-global-shared-view outer-loop-carried)
            moved
            (tc-global-shared-view init)
            tail-repeats
            tail-breaks)
            [(Err message) (Err message)]
            [(Ok normal? moved1-box breaks? break-moved-box)
              (if normal?
                (let
                  [binding-ty : ast.AstType
                    (tc-move-binding-type-id
                      "move.loop_let_init"
                      ctx
                      env
                      maybe-ty
                      init-box)]
                  [moved2
                    (try
                      (tc-move-after-bind-known-type-id
                        ctx
                        expr-bases
                        env
                        (tc-global-shared-view locals)
                        active-loop-carried
                        (tc-moved-set-box-shared-view moved1-box)
                        init-box
                        (tc-global-shared-view binding-ty)))]
                  [obligated? : bool
                    (tc-cleanup-owning-aggregate-type?
                      ctx
                      (tc-global-shared-view binding-ty))]
                  [moved3 : TcMovedSet
                    (tc-move-discharge-direct
                      ctx
                      expr-bases
                      (tc-global-shared-view locals)
                      moved2
                      init-box)]
                  [shadowed : TcMovedRootSnapshot
                    (tc-moved-root-snapshot (tc-global-shared-view moved3) name)]
                  [body-result : TcMoveLoopResult
                    (tc-move-check-loop-let-bindings-at
                      ctx
                      expr-bases
                      (tc-bind-initialized-value-id
                        ctx
                        env
                        name
                        (tc-global-shared-view binding-ty)
                        (tc-global-shared-view init))
                      (if obligated?
                        (tc-move-bind-let-obligation locals name init-box)
                        (tc-move-add-local-binding
                          ctx
                          expr-bases
                          env
                          locals
                          name
                          (tc-global-shared-view init)))
                      (tc-moved-remove-root-state loop-carried name)
                      (tc-moved-remove-root-state outer-loop-carried name)
                      (tc-param-storage-rebind-from-init
                        ctx
                        expr-bases
                        env
                        moved3
                        name
                        binding-ty
                        init)
                      bindings
                      (+ index 1)
                      body-box
                      continuation-repeats
                      continuation-breaks)]
                  (tc-move-loop-result-add-breaks
                    breaks?
                    (tc-moved-set-box-shared-view break-moved-box)
                    (tc-move-loop-result-restore-root-state
                      (if obligated?
                        (tc-move-loop-result-check-obligation-end
                          ctx
                          expr-bases
                          body-result
                          name
                          init-box
                          body-box)
                        body-result)
                      shadowed)))
                (Ok false moved1-box breaks? break-moved-box))]))])))

(define (tc-move-check-loop-match-arms-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [outer-loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [parameter-id : i64]
  [scrut-ty : ast.AstType]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]
  [continuation-repeats : bool]
  [continuation-breaks : bool]) : TcMoveLoopResult
  (if (>= index arms.len)
    (Ok false (box moved) false (box (tc-moved-empty)))
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          [bound : TcNameIdList
            (tc-borrow-check-pattern-bound-names
              ctx
              (tc-global-shared-view scrut-ty)
              (tc-global-shared-view pattern))]
          [arm-env
            (try
              (tc-bind-match-pattern
                ctx
                env
                (tc-global-shared-view scrut-ty)
                pattern))]
          (match (tc-move-check-loop-expr
            ctx
            expr-bases
            arm-env
            (tc-move-add-bound-names (tc-moved-clone locals) bound)
            (tc-move-remove-bound-root-states
              (tc-moved-clone loop-carried)
              bound)
            (tc-move-remove-bound-root-states
              (tc-moved-clone outer-loop-carried)
              bound)
            (tc-param-storage-bind-pattern-names
              ctx
              arm-env
              (tc-move-remove-bound-root-states (tc-moved-clone moved) bound)
              bound
              parameter-id)
            (tc-global-shared-view body)
            continuation-repeats
            continuation-breaks)
            [(Err message) (Err message)]
            [(Ok normal? arm-moved-box breaks? arm-break-box)
              (let
                [arm-result : TcMoveLoopResult
                  (Ok
                    normal?
                    (box
                      (tc-moved-union
                        moved
                        (tc-move-remove-bound-root-states
                          (tc-moved-set-box-shared-view arm-moved-box)
                          bound)))
                    breaks?
                    (box
                      (tc-moved-union
                        moved
                        (tc-move-remove-bound-root-states
                          (tc-moved-set-box-shared-view arm-break-box)
                          bound))))]
                [rest-result : TcMoveLoopResult
                  (tc-move-check-loop-match-arms-at
                    ctx
                    expr-bases
                    env
                    (tc-moved-clone locals)
                    (tc-moved-clone loop-carried)
                    (tc-moved-clone outer-loop-carried)
                    (tc-moved-clone moved)
                    parameter-id
                    scrut-ty
                    arms
                    (+ index 1)
                    continuation-repeats
                    continuation-breaks)]
                ;; The later arms were already checked among themselves,
                ;; so their joined fallthrough state stands for all of them.
                [_
                  (try
                    (tc-move-loop-results-agree
                      expr-bases
                      (tc-global-shared-view locals)
                      (tc-global-shared-view arm-result)
                      (tc-global-shared-view rest-result)
                      (tc-global-shared-view body)))]
                (tc-move-loop-result-branches
                  (tc-global-shared-view moved)
                  arm-result
                  rest-result))]))])))

(define (tc-move-check-loop-expr
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [outer-loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : ast.AstExpr]
  [continuation-repeats : bool]
  [continuation-breaks : bool]) : TcMoveLoopResult
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(or (Begin exprs) (Unsafe exprs) (BracketClause exprs))
      (tc-move-check-loop-exprs
        ctx
        expr-bases
        env
        locals
        loop-carried
        outer-loop-carried
        moved
        exprs
        continuation-repeats
        continuation-breaks)]
    [(If cond-box then-box else-box)
      (let
        [branch-flow : TcMoveLoopFlow
          (tc-move-loop-flow-branches
            (tc-move-loop-flow-expr
              ctx
              expr-bases
              env
              (ast.ast-expr-segment-bases-get expr-bases then-box))
            (tc-move-loop-flow-expr
              ctx
              expr-bases
              env
              (ast.ast-expr-segment-bases-get expr-bases else-box)))]
        [branch-repeats : bool
          (tc-move-loop-flow-reaches-repeat? branch-flow continuation-repeats)]
        [branch-breaks : bool
          (tc-move-loop-flow-reaches-break? branch-flow continuation-breaks)]
        (match (tc-move-check-loop-expr
          ctx
          expr-bases
          env
          (tc-global-shared-view locals)
          (tc-global-shared-view loop-carried)
          (tc-global-shared-view outer-loop-carried)
          moved
          (ast.ast-expr-segment-bases-get expr-bases cond-box)
          branch-repeats
          branch-breaks)
          [(Err message) (Err message)]
          [(Ok normal? movedc-box cond-breaks? cond-break-moved-box)
            (let
              [movedc : TcMovedSet (tc-moved-set-box-shared-view movedc-box)]
              [cond-break-moved : TcMovedSet
                (tc-moved-set-box-shared-view cond-break-moved-box)]
              (if normal?
                (let
                  [then-result : TcMoveLoopResult
                    (tc-move-check-loop-expr
                      ctx
                      expr-bases
                      env
                      (tc-moved-clone locals)
                      (tc-moved-clone loop-carried)
                      (tc-moved-clone outer-loop-carried)
                      (tc-moved-clone movedc)
                      (ast.ast-expr-segment-bases-get expr-bases then-box)
                      continuation-repeats
                      continuation-breaks)]
                  [else-result : TcMoveLoopResult
                    (tc-move-check-loop-expr
                      ctx
                      expr-bases
                      env
                      (tc-moved-clone locals)
                      (tc-moved-clone loop-carried)
                      (tc-moved-clone outer-loop-carried)
                      (tc-moved-clone movedc)
                      (ast.ast-expr-segment-bases-get expr-bases else-box)
                      continuation-repeats
                      continuation-breaks)]
                  [_
                    (try
                      (tc-move-loop-results-agree
                        expr-bases
                        (tc-global-shared-view locals)
                        (tc-global-shared-view then-result)
                        (tc-global-shared-view else-result)
                        (tc-global-shared-view expr)))]
                  (tc-move-loop-result-add-breaks
                    cond-breaks?
                    cond-break-moved
                    (tc-move-loop-result-branches
                      (tc-global-shared-view movedc)
                      then-result
                      else-result)))
                (Ok false (box movedc) cond-breaks? (box cond-break-moved))))]))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (tc-move-check-loop-let-bindings-at
            ctx
            expr-bases
            env
            (tc-moved-clone locals)
            (tc-moved-clone loop-carried)
            (tc-moved-clone outer-loop-carried)
            moved
            (& bindings)
            0
            body-box
            continuation-repeats
            continuation-breaks)])]
    [(Match match-box)
      (match (ast.ast-match-box-shared-view match-box)
        [(Match scrut-box arms)
          (let
            [scrut : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases scrut-box)]
            [arm-flow : TcMoveLoopFlow
              (tc-move-loop-flow-match-arms-at ctx expr-bases env (& arms) 0)]
            [arms-repeat : bool
              (tc-move-loop-flow-reaches-repeat? arm-flow continuation-repeats)]
            [arms-break : bool
              (tc-move-loop-flow-reaches-break? arm-flow continuation-breaks)]
            (match (tc-move-check-loop-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view loop-carried)
              (tc-global-shared-view outer-loop-carried)
              moved
              (tc-global-shared-view scrut)
              arms-repeat
              arms-break)
              [(Err message) (Err message)]
              [(Ok normal? moveds-box scrut-breaks? scrut-break-box)
                (if normal?
                  (let
                    [moveds : TcMovedSet
                      (tc-moved-set-box-shared-view moveds-box)]
                    (match (tc-body-type-fact-expr-id
                      "move.loop_match_scrutinee"
                      ctx
                      env
                      scrut-box)
                      [(Ok scrut-ty)
                        (let
                          [moveds1
                            (try
                              (tc-move-check-global-result
                                ctx
                                expr-bases
                                env
                                (tc-global-shared-view locals)
                                moveds
                                (tc-global-shared-view scrut)
                                (tc-global-shared-view scrut-ty)))]
                          (tc-move-loop-result-add-breaks
                            scrut-breaks?
                            (tc-moved-set-box-shared-view scrut-break-box)
                            (tc-move-check-loop-match-arms-at
                              ctx
                              expr-bases
                              env
                              (tc-global-shared-view locals)
                              loop-carried
                              outer-loop-carried
                              (tc-move-after-match-scrutinee
                                ctx
                                expr-bases
                                locals
                                (tc-global-shared-view moveds1)
                                (tc-global-shared-view scrut)
                                (tc-global-shared-view scrut-ty))
                              (tc-param-storage-origin-id
                                ctx
                                expr-bases
                                env
                                moveds1
                                scrut)
                              scrut-ty
                              (& arms)
                              0
                              continuation-repeats
                              continuation-breaks)))]
                      [(Err _)
                        (tc-move-loop-result-add-breaks
                          scrut-breaks?
                          (tc-moved-set-box-shared-view scrut-break-box)
                          (tc-move-check-loop-match-arms-at
                            ctx
                            expr-bases
                            env
                            locals
                            loop-carried
                            outer-loop-carried
                            (tc-global-shared-view moveds)
                            (tc-param-storage-origin-id
                              ctx
                              expr-bases
                              env
                              moveds
                              scrut)
                            (Unit)
                            (& arms)
                            0
                            continuation-repeats
                            continuation-breaks))]))
                  (Ok false moveds-box scrut-breaks? scrut-break-box))]))])]
    ;; `try` either continues with its operand's value or leaves the function,
    ;; so its operand keeps its own break, continue and return edges; the
    ;; error exit checks the obligations of the operand's fallthrough state.
    ;; Like the Try arm of `tc-move-check-expr`, it records no early-exit fact.
    [(Try inner-box)
      (match (tc-move-check-loop-expr
        ctx
        expr-bases
        env
        (tc-global-shared-view locals)
        loop-carried
        outer-loop-carried
        moved
        (ast.ast-expr-segment-bases-get expr-bases inner-box)
        continuation-repeats
        continuation-breaks)
        [(Ok normal? normal-box breaks? break-box)
          (if normal?
            (let
              [moved1
                (try
                  (tc-move-check-obligations-exit
                    expr-bases
                    locals
                    -1
                    (tc-moved-set-box-shared-view normal-box)
                    (tc-global-shared-view expr)
                    "before this try can propagate an error"))]
              (Ok true (box moved1) breaks? break-box))
            (Ok false normal-box breaks? break-box))]
        [(Err message) (Err message)])]
    [(Return _)
      (tc-move-check-loop-operand
        ctx
        expr-bases
        env
        locals
        (tc-moved-empty)
        moved
        expr
        false)]
    [(Break)
      (let
        [moved1
          (try
            (tc-move-check-obligations-exit
              expr-bases
              (tc-global-shared-view locals)
              (tc-move-loop-depth locals)
              moved
              (tc-global-shared-view expr)
              "before this break leaves its loop"))]
        (Ok false (box moved1) true (box moved1)))]
    [(Continue)
      (let
        [moved1
          (try
            (tc-move-check-obligations-exit
              expr-bases
              (tc-global-shared-view locals)
              (tc-move-loop-depth locals)
              moved
              (tc-global-shared-view expr)
              "before this continue leaves its loop iteration"))]
        (Ok false (box moved1) false (box (tc-moved-empty))))]
    [_
      (let
        [flow : TcMoveLoopFlow
          (tc-move-loop-flow-expr
            ctx
            expr-bases
            env
            (tc-global-shared-view expr))]
        [active-loop-carried : TcMovedSet
          (cond
            [(tc-move-loop-flow-reaches-repeat? flow continuation-repeats)
              loop-carried]
            [(tc-move-loop-flow-reaches-break? flow continuation-breaks)
              outer-loop-carried]
            [else (tc-moved-empty)])]
        (tc-move-check-loop-operand
          ctx
          expr-bases
          env
          locals
          active-loop-carried
          moved
          expr
          flow.normal))]))

;; A loop-body form the walker has no arm for, checked by the non-loop walker
;; inside a collecting frame: the moved sets at the `break`s nested in it are
;; its break state (#8575), as the walker's own `Break` arm reports them.
(define (tc-move-check-loop-operand
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : ast.AstExpr]
  [normal? : bool]) : TcMoveLoopResult
  (let
    [state : TcBodyState (tc-context-body-state ctx)]
    [outer : TcMoveBreakCollection
      (tc-body-move-breaks-swap! state (tc-move-break-collection-new true))]
    [result : TcMoveResult
      (tc-move-check-expr ctx expr-bases env locals loop-carried moved expr)]
    [breaks : TcMoveBreakCollection (tc-body-move-breaks-swap! state outer)]
    (match result
      [(Ok moved1) (Ok normal? (box moved1) breaks.seen (box breaks.moved))]
      [(Err message) (Err message)])))

;; A loop body entered from the non-loop walker; its `break`s belong to this
;; loop, so its frame keeps them out of an enclosing loop's collection.
(define (tc-move-check-loop-body
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [outer-loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [body : ast.AstExpr]) : TcMoveLoopResult
  (let
    [state : TcBodyState (tc-context-body-state ctx)]
    [outer : TcMoveBreakCollection
      (tc-body-move-breaks-swap! state (tc-move-break-collection-new false))]
    [result : TcMoveLoopResult
      (tc-move-check-loop-expr
        ctx
        expr-bases
        env
        locals
        loop-carried
        outer-loop-carried
        moved
        body
        true
        false)]
    [_ (tc-body-move-breaks-swap! state outer)]
    result))

;; #7976: the defining module owns writes to its globals. A safe
;; write-capable place operation (assignment, a field/tuple/element/deref
;; projection write, `replace!` or `&mut`) rooted at another module's global
;; is rejected once the root resolves to its declaration,
;; whatever import spelling, alias or macro expansion produced the name, and
;; even inside `unsafe`; raw pointer operations keep their own rules. Reads and
;; shared borrows stay valid, and the owner exposes a function for intentional
;; mutation. Code produced by a macro is checked as code of the module it
;; expands into, so an imported macro cannot carry its module's write authority.
(define (tc-module-ids-same? [left : i64] [right : i64]) : bool
  (or
    (= left right)
    (and
      (csym.compiler-symbol-root-module-id? left)
      (csym.compiler-symbol-root-module-id? right))))

(define (tc-module-display [module-id : i64]) : String
  (if (csym.compiler-symbol-root-module-id? module-id)
    "the entry module"
    (ci.intern-syntax-name-text-or module-id "<module>")))

;; `(:opaque)` representation authority (#6999). An opaque struct or enum's
;; representation belongs to its module family: the defining module and its
;; dotted descendants. Elsewhere the type is usable only behind Ptr, MutPtr, &
;; and &mut. Code a macro expands into a module is checked as that module's
;; code, like E0220.
;; Whether USE-MODULE is DEF-MODULE or one of its dotted descendants.
(define (tc-opaque-module-in-family? [use-module : i64] [def-module : i64]) : bool
  (if (tc-module-ids-same? use-module def-module)
    true
    (if (or
      (csym.compiler-symbol-root-module-id? use-module)
      (csym.compiler-symbol-root-module-id? def-module))
      false
      (let
        [def-text : String (ci.intern-syntax-name-text-or def-module "")]
        [use-text : String (ci.intern-syntax-name-text-or use-module "")]
        [def-length : i64 (string.string-length def-text)]
        (and
          (> def-length 0)
          (> (string.string-length use-text) def-length)
          (string.is-string-prefix-at use-text def-text 0)
          (= (string.string-ref use-text def-length) '.'))))))

;; The symbol index of the struct or enum NAME-ID when it is declared
;; (:opaque), else -1.
(define (tc-opaque-decl-index [ctx : TcContext] [name-id : i64]) : i64
  (let
    [symbols : (& ctx csym.CompilerSymbols) (tc-context-symbols ctx)]
    [handle : i64
      (csym.compiler-symbols-lookup-type-id-or
        symbols
        name-id
        (csym.compiler-symbols-missing-handle))]
    [kind : i64
      (if (csym.compiler-symbols-handle-found? handle)
        (csym.compiler-symbol-handle-kind handle)
        -1)]
    (if (or
      (= kind (csym.compiler-symbol-kind-defstruct))
      (= kind (csym.compiler-symbol-kind-defenum)))
      (let
        [index : i64 (csym.compiler-symbol-handle-index handle)]
        (match (csym.compiler-symbols-decl-at-index symbols index)
          [(Ok decl)
            (if (ast.ast-decl-opaque? (& decl))
              index
              -1)]
          [(Err _) -1]))
      -1)))

;; Whether the code CTX checks lies outside the module family of the opaque
;; aggregate at symbol INDEX.
(define (tc-opaque-foreign-index? [ctx : TcContext] [index : i64]) : bool
  (let
    [symbols : (& ctx csym.CompilerSymbols) (tc-context-symbols ctx)]
    [def-module : i64
      (csym.compiler-symbols-owner-module-id-at-index-or
        symbols
        index
        cbi.compiler-builtin-id-fix-empty)]
    (not (tc-opaque-module-in-family? (tc-context-module-id ctx) def-module))))

;; The name of TY when TY is a struct or enum declared (:opaque) whose module
;; family excludes the code CTX checks, else -1.
(define (tc-opaque-foreign-type-name [ctx : TcContext] [ty : ast.AstType]) : i64
  (if (not (tc-job-state-opaque-program? (tc-context-job-state ctx)))
    -1
    (let
      [name : i64
        (match (tc-global-shared-view ty)
          [(or (Struct name) (StructArgs name _) (Enum name) (EnumArgs name _))
            name]
          [_ -1])]
      [index : i64
        (if (< name 0)
          -1
          (tc-opaque-decl-index ctx name))]
      (if (and (>= index 0) (tc-opaque-foreign-index? ctx index))
        name
        -1))))

;; Whether DECLS, module bodies included, declare an (:opaque) aggregate. The
;; gates below cost nothing more than this flag for programs without one.
(define (tc-opaque-decls-declare? [decls : (& decls ast.AstDeclList)]) : bool
  (let
    [index : i64 0]
    [found : bool false]
    (while (and (not found) (< index (ast.ast-decl-list-len decls)))
      (let
        [decl : ast.AstDecl (ast.ast-decl-list-ref decls index)]
        (match (tc-global-shared-view decl)
          [(ModuleBody _ body-box)
            (set!
              found
              (tc-opaque-decls-declare?
                (& (ast.ast-decl-list-box-shared-view body-box))))]
          [_ (set! found (ast.ast-decl-opaque? (& decl)))]))
      (set! index (+ index 1)))
    found))

;; E0221 text for USE (such as "cannot construct") applied to opaque NAME.
(define (tc-opaque-representation-message [name : i64] [use : String]) : String
  (tc-kind-message
    (OpaqueRepresentation)
    (str_cat.str-cat
      "typecheck: "
      use
      " opaque type "
      (tc-nominal-name-id-display name)
      " outside its module family; there it is usable only behind Ptr, MutPtr, & or &mut")))

;; A written type that holds an opaque aggregate by value: outside its module
;; family only a pointer or reference referent may name it.
(define (tc-source-opaque-value-policy-ok
  [ctx : TcContext]
  [name : i64]
  [referent? : bool]) : ResultTcUnit
  (if referent?
    Ok
    (tc-opaque-name-representation-ok ctx name "cannot hold by value the")))

;; The first opaque aggregate foreign to CTX's module family that TY holds by
;; value, else -1. A Ptr, MutPtr, & or &mut referent is not held by value.
(define (tc-opaque-by-value-name [ctx : TcContext] [ty : ast.AstType]) : i64
  (let
    [resolved : ast.AstType (tc-resolve-type ctx ty)]
    (match (tc-global-shared-view resolved)
      [(or (Struct _) (StructArgs _ _) (Enum _) (EnumArgs _ _))
        (tc-opaque-foreign-type-name ctx resolved)]
      [(Tuple elems)
        (tc-opaque-by-value-name-in-list
          ctx
          (& (ast.ast-type-list-box-shared-view elems))
          0)]
      [(Func args ret)
        (let
          [in-args : i64
            (tc-opaque-by-value-name-in-list
              ctx
              (& (ast.ast-type-list-box-shared-view args))
              0)]
          (if (>= in-args 0)
            in-args
            (tc-opaque-by-value-name ctx (ast.ty-node-get ret))))]
      [(or (Array elem _) (DynArray elem) (Box elem) (Region _ elem))
        (tc-opaque-by-value-name ctx (ast.ty-node-get elem))]
      [_ -1])))

(define (tc-opaque-by-value-name-in-list
  [ctx : TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : i64
  (if (>= index (ast.ast-type-list-len types))
    -1
    (let
      [found : i64
        (tc-opaque-by-value-name
          ctx
          (ast.ty-node-get
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback))))]
      (if (>= found 0)
        found
        (tc-opaque-by-value-name-in-list ctx types (+ index 1))))))

;; Err with E0221 when TY holds an opaque aggregate foreign to CTX's module
;; family by value, such as an inferred `let` binding of a pointer read.
(define (tc-opaque-by-value-ok
  [ctx : TcContext]
  [ty : ast.AstType]
  [use : String]) : ResultTcUnit
  (if (not (tc-job-state-opaque-program? (tc-context-job-state ctx)))
    Ok
    (let
      [name : i64 (tc-opaque-by-value-name ctx ty)]
      (if (< name 0)
        Ok
        (Err (tc-opaque-representation-message name use))))))

;; TY, the value an operation yields, or E0221 when TY holds an opaque
;; aggregate foreign to CTX's module family by value. Gating the operations
;; that read through a pointer, reference or box (#8734) leaves no unwritten
;; source of such a value: the expressions that pass one along (if, match,
;; begin) only ever receive it from a gated operation.
(define (tc-opaque-by-value-result
  [ctx : TcContext]
  [ty : ast.AstType]
  [use : String]) : ResultTcType
  (match (tc-opaque-by-value-ok ctx (tc-global-shared-view ty) use)
    [(Ok) (Ok ty)]
    [(Err message) (Err message)]))

;; Err with E0221 when NAME is an opaque aggregate foreign to CTX's module
;; family, else Ok.
(define (tc-opaque-name-representation-ok
  [ctx : TcContext]
  [name : i64]
  [use : String]) : ResultTcUnit
  (if (not (tc-job-state-opaque-program? (tc-context-job-state ctx)))
    Ok
    (let
      [index : i64 (tc-opaque-decl-index ctx name)]
      (if (and (>= index 0) (tc-opaque-foreign-index? ctx index))
        (Err (tc-opaque-representation-message name use))
        Ok))))

;; Err with E0221 when TY is a foreign opaque aggregate, else Ok.
(define (tc-opaque-representation-ok
  [ctx : TcContext]
  [ty : ast.AstType]
  [use : String]) : ResultTcUnit
  (let
    [name : i64 (tc-opaque-foreign-type-name ctx ty)]
    (if (< name 0)
      Ok
      (Err (tc-opaque-representation-message name use)))))

(define (tc-move-global-owner-module-id [ctx : TcContext] [handle : i64]) : i64
  (csym.compiler-symbols-owner-module-id-at-index-or
    (tc-context-symbols ctx)
    (csym.compiler-symbol-handle-index handle)
    (csym.compiler-symbol-root-module-id)))

;; The handle of the global a place root names when another module owns it.
(define (tc-move-foreign-global-root-handle
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [root-id : i64]) : TcMaybeNameId
  (if (tc-move-global-source-root? ctx env locals root-id)
    (let
      [handle : i64 (tc-move-value-symbol-handle-id ctx env root-id)]
      (if (tc-module-ids-same?
        (tc-move-global-owner-module-id ctx handle)
        (tc-context-module-id ctx))
        (No)
        (Some handle)))
    (No)))

(define (tc-move-foreign-global-write-message
  [ctx : TcContext]
  [root-id : i64]
  [handle : i64]
  [operation : String]) : String
  (let
    [owner : String
      (tc-module-display (tc-move-global-owner-module-id ctx handle))]
    [decl-name-id : i64
      (csym.compiler-symbols-decl-name-id-at-index
        (tc-context-symbols ctx)
        (csym.compiler-symbol-handle-index handle))]
    [name : String
      (if (ci.intern-renderable-id? decl-name-id)
        (ci.intern-str decl-name-id)
        (tc-move-global-source-name root-id))]
    (str_cat.str-cat
      (cdiag.compiler-diagnostic-typecheck-tag (ForeignGlobalWrite))
      "typecheck: cannot "
      operation
      " global `"
      name
      "` owned by module `"
      (tc-global-shared-view owner)
      "` from module `"
      (tc-module-display (tc-context-module-id ctx))
      "`; only its defining module may write it, so call a function that `"
      owner
      "` defines instead")))

(define (tc-move-foreign-global-root-check
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [site : ast.AstExpr]
  [root-id : i64]
  [operation : String]) : ResultTcUnit
  (match (tc-move-foreign-global-root-handle ctx env locals root-id)
    [(Some handle)
      (Err
        (tc-locate-error-at-expr
          expr-bases
          site
          (tc-move-foreign-global-write-message ctx root-id handle operation)))]
    [(No) Ok]))

(define (tc-move-foreign-global-place-check
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [place-box : i64]
  [operation : String]) : ResultTcUnit
  (let
    [place : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases place-box)]
    (match (tc-move-root-projection-var-id
      expr-bases
      (tc-global-shared-view place))
      [(Some root-id)
        (tc-move-foreign-global-root-check
          ctx
          expr-bases
          env
          locals
          place
          root-id
          operation)]
      [(No) Ok])))

;; A plain or dotted `set!` reached without a spanned parent (a virtual node);
;; the value expression locates the diagnostic. Spanned `set!` nodes are
;; checked, and located, in the `Spanned` arm of `tc-move-check-expr` first.
(define (tc-move-foreign-global-set-check
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [name : i64]
  [rhs-box : i64]) : ResultTcUnit
  (tc-move-foreign-global-root-check
    ctx
    expr-bases
    env
    locals
    (ast.ast-expr-segment-bases-get expr-bases rhs-box)
    (if (tc-dotted-place-name-id? ctx env name)
      (ci.intern-leading-dot-id name)
      name)
    "assign to"))

;; Move-check FIRST then SECOND in one scope, threading the moved set.
(define (tc-move-check-expr-pair
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [first : ast.AstExpr]
  [second : ast.AstExpr]) : TcMoveResult
  (let
    [moved1
      (try
        (tc-move-check-expr
          ctx
          expr-bases
          env
          (tc-global-shared-view locals)
          (tc-global-shared-view loop-carried)
          moved
          first))]
    (tc-move-check-expr ctx expr-bases env locals loop-carried moved1 second)))

(define (tc-move-check-expr
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : ast.AstExpr]) : TcMoveResult
  (match (tc-global-shared-view expr)
    [(Spanned inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (match (tc-global-shared-view inner)
          ;; A `set!` target has no place node of its own, so the spanned
          ;; node locates its #7976 ownership diagnostic: the assignment, or
          ;; for an expansion the macro call site.
          [(Set name _)
            (let
              [_
                (try
                  (tc-move-foreign-global-root-check
                    ctx
                    expr-bases
                    env
                    (tc-global-shared-view locals)
                    expr
                    (if (tc-dotted-place-name-id? ctx env name)
                      (ci.intern-leading-dot-id name)
                      name)
                    "assign to"))]
              (tc-move-check-expr
                ctx
                expr-bases
                env
                locals
                loop-carried
                moved
                inner))]
          ;; An expanded `set!` keeps its template span; the call site that
          ;; wraps the expansion locates the diagnostic instead.
          [(MacroExpansion _ _ _)
            (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& inner))
              [(Set name _)
                (let
                  [_
                    (try
                      (tc-move-foreign-global-root-check
                        ctx
                        expr-bases
                        env
                        (tc-global-shared-view locals)
                        expr
                        (if (tc-dotted-place-name-id? ctx env name)
                          (ci.intern-leading-dot-id name)
                          name)
                        "assign to"))]
                  (tc-move-check-expr
                    ctx
                    expr-bases
                    env
                    locals
                    loop-carried
                    moved
                    inner))]
              [_
                (tc-move-check-expr
                  ctx
                  expr-bases
                  env
                  locals
                  loop-carried
                  moved
                  inner)])]
          [_
            (tc-move-check-expr
              ctx
              expr-bases
              env
              locals
              loop-carried
              moved
              inner)]))]
    [(or (MacroExpansion inner-box _ _) (Unary _ inner-box))
      (tc-move-check-expr-id
        ctx
        expr-bases
        env
        locals
        loop-carried
        moved
        inner-box)]
    [(ForOwnedState payload)
      (let
        [source-name-id : i64 (ast.ast-for-owned-state-source-name (& payload))]
        [index-name-id : i64 (ast.ast-for-owned-state-index-name (& payload))]
        [source-id : i64 (ast.ast-for-owned-state-source (& payload))]
        [body-id : i64 (ast.ast-for-owned-state-body (& payload))]
        [source-name : i64 (tc-for-owned-name-id expr-bases source-name-id)]
        [index-name : i64 (tc-for-owned-name-id expr-bases index-name-id)]
        (if (or (< source-name 0) (< index-name 0))
          (Err "typecheck: invalid internal scalar for owned-array state")
          (let
            [moved1
              (try
                (tc-move-check-expr-id
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view locals)
                  (tc-global-shared-view loop-carried)
                  moved
                  source-id))]
            [source-ty
              (try
                (tc-body-type-fact-expr-id
                  "move.for_owned_source"
                  ctx
                  env
                  source-id))]
            [moved2
              (try
                (tc-move-after-bind-known-type-id
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view locals)
                  (tc-global-shared-view loop-carried)
                  moved1
                  source-id
                  (tc-global-shared-view source-ty)))]
            [moved3
              (try
                (tc-move-check-expr-id
                  ctx
                  expr-bases
                  (tc-bind-id
                    (tc-bind-id env source-name source-ty)
                    index-name
                    (I64))
                  (tc-moved-add (tc-moved-add locals source-name) index-name)
                  (tc-moved-remove-root-state
                    (tc-moved-remove-root-state loop-carried source-name)
                    index-name)
                  (tc-moved-remove-root-state
                    (tc-moved-remove-root-state moved2 source-name)
                    index-name)
                  body-id))]
            (Ok
              (tc-moved-remove-root-state
                (tc-moved-remove-root-state moved3 source-name)
                index-name)))))]
    [(ForOwnedStep payload)
      (let
        [source-id : i64 (ast.ast-for-owned-step-source-name (& payload))]
        [index-id : i64 (ast.ast-for-owned-step-index-name (& payload))]
        [binding-id : i64 (ast.ast-for-owned-step-binding-name (& payload))]
        [done-id : i64 (ast.ast-for-owned-step-done-name (& payload))]
        [body-id : i64 (ast.ast-for-owned-step-body (& payload))]
        [binding-name : i64 (tc-for-owned-name-id expr-bases binding-id)]
        (if (< binding-name 0)
          (Err "typecheck: invalid internal scalar for item binding")
          (let
            [moved1
              (try
                (tc-move-check-expr-id
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view locals)
                  (tc-global-shared-view loop-carried)
                  moved
                  source-id))]
            [moved2
              (try
                (tc-move-check-expr-id
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view locals)
                  (tc-global-shared-view loop-carried)
                  moved1
                  index-id))]
            [moved3
              (try
                (tc-move-check-expr-id
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view locals)
                  (tc-global-shared-view loop-carried)
                  moved2
                  done-id))]
            [source-ty
              (try
                (tc-body-type-fact-expr-id
                  "move.for_owned_step_source"
                  ctx
                  env
                  source-id))]
            (match (tc-type-strip-region (tc-resolve-type ctx source-ty))
              [(Array elem-id _)
                (let
                  [moved4
                    (try
                      (tc-move-check-expr-id
                        ctx
                        expr-bases
                        (tc-bind-id
                          env
                          binding-name
                          (tc-context-type-get ctx elem-id))
                        (tc-moved-add locals binding-name)
                        (tc-moved-remove-root-state loop-carried binding-name)
                        (tc-moved-remove-root-state moved3 binding-name)
                        body-id))]
                  (Ok (tc-moved-remove-root-state moved4 binding-name)))]
              [_
                (Err
                  "typecheck: scalar for owned step requires fixed-array state")]))))]
    [(or (Literal _) (TypeLiteral _) (Init _) (Comptime _) (Quote _)
         (Quasiquote _) (Unquote _) (UnquoteSplicing _) (PtrNull _)
         (BinaryData _) (SpmdProgramIndex) (SpmdProgramCount) (ProgramArgc)
         (ProgramArgv) (ProgramEnvp))
      (Ok moved)]
    [(Var name)
      (let
        [name-text : String
          (tc-hygiene-name-text-id-for-session
            (tc-context-structural-session ctx)
            name)]
        (if (tc-dotted-place-name-id? ctx env name)
          (let
            [virtual-id
              (try
                (tc-dotted-local-field-expr-id-after-check
                  (tc-context-structural-session ctx)
                  name))]
            (tc-move-check-expr-id
              ctx
              expr-bases
              env
              locals
              loop-carried
              moved
              virtual-id))
          (if (tc-moved-contains? moved name)
            (tc-move-rich-use-conflict-result
              expr-bases
              (tc-moved-conflict moved name)
              (tc-global-shared-view name-text)
              expr
              name-text)
            (Ok moved))))]
    [(Binary op left-box right-box)
      (let
        [moved1
          (try
            (tc-move-check-expr-id
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view loop-carried)
              moved
              left-box))]
        ;; The right operand of `and` / `or` may be skipped, so it must
        ;; leave every obligated local as it found it.
        [short-circuit? : bool
          (and
            (tc-move-let-obligations-possible?)
            (match op
              [(or (And) (Or)) true]
              [_ false]))]
        [before : TcMovedSet
          (if short-circuit?
            (tc-moved-clone (& moved1))
            (tc-moved-empty))]
        [moved2
          (try
            (tc-move-check-expr-id
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              loop-carried
              moved1
              right-box))]
        (if (and
          short-circuit?
          (not (tc-move-arm-diverges? ctx expr-bases right-box)))
          (let
            [_
              (try
                (tc-move-check-obligations-agree
                  expr-bases
                  locals
                  before
                  (ast.ast-expr-segment-bases-get expr-bases right-box)
                  (tc-global-shared-view moved2)
                  (ast.ast-expr-segment-bases-get expr-bases right-box)
                  "through this operand"))]
            (Ok moved2))
          (Ok moved2)))]
    [(Call func-box args)
      (let
        [func : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases func-box)]
        [slice-kind : TcSliceViewCallKind
          (tc-slice-view-call-kind ctx env (tc-global-shared-view func))]
        (if (= slice-kind TcSliceViewCallKind.None)
          (let
            [moved1
              (try
                (tc-move-check-expr-id
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view locals)
                  (tc-global-shared-view loop-carried)
                  moved
                  func-box))]
            (match (tc-move-call-param-types-id-with-facts
              "move.call_func"
              ctx
              env
              func-box)
              [(Ok params)
                (match (tc-call-extern-abi ctx (tc-global-shared-view func))
                  [(Some abi)
                    (if (tc-call-dynamic-c-varargs-abi?
                      (tc-global-shared-view abi))
                      (let
                        [expanded-params
                          (try
                            (tc-call-extern-varargs-params
                              ctx
                              env
                              (tc-global-shared-view func)
                              (tc-global-shared-view args)
                              params
                              abi))]
                        (tc-move-check-call-args-with-types
                          ctx
                          expr-bases
                          env
                          locals
                          loop-carried
                          moved1
                          expr
                          func
                          args
                          expanded-params
                          true))
                      (tc-move-check-call-args-with-types
                        ctx
                        expr-bases
                        env
                        locals
                        loop-carried
                        moved1
                        expr
                        func
                        args
                        params
                        true))]
                  [(No)
                    (tc-move-check-call-args-with-types
                      ctx
                      expr-bases
                      env
                      locals
                      loop-carried
                      moved1
                      expr
                      func
                      args
                      params
                      false)])]
              [(Err _)
                (let
                  [moved-args
                    (try
                      (tc-move-check-exprs
                        ctx
                        expr-bases
                        env
                        (tc-global-shared-view locals)
                        (tc-global-shared-view loop-carried)
                        moved1
                        (tc-global-shared-view args)))]
                  (tc-move-check-safe-arena-call-effects
                    ctx
                    expr-bases
                    env
                    locals
                    loop-carried
                    moved-args
                    func
                    args
                    expr))]))
          (tc-move-check-slice-view-call
            ctx
            expr-bases
            env
            locals
            loop-carried
            moved
            expr
            slice-kind
            args)))]
    [(or (BracketClause items) (Begin items) (Unsafe items) (WithRegion _ items)
         (WithScratch items) (Syscall items))
      (tc-move-check-exprs ctx expr-bases env locals loop-carried moved items)]
    [(If cond-box then-branch-box else-branch-box)
      (let
        [movedc
          (try
            (tc-move-check-expr-id
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view loop-carried)
              moved
              cond-box))]
        [movedt
          (try
            (tc-move-check-expr-id
              ctx
              expr-bases
              env
              (tc-moved-clone locals)
              (tc-moved-clone loop-carried)
              (tc-moved-clone movedc)
              then-branch-box))]
        [movede
          (try
            (tc-move-check-expr-id
              ctx
              expr-bases
              env
              (tc-moved-clone locals)
              (tc-moved-clone loop-carried)
              (tc-moved-clone movedc)
              else-branch-box))]
        ;; Both arms kept the entry facts, so their union is either
        ;; of them and no arm needs a divergence summary.
        (if (and
          (tc-moved-same-facts?
            (& movedt)
            (& movedc)
            (tc-global-shared-view movedt.paths)
            (tc-global-shared-view movedc.paths))
          (tc-moved-same-facts?
            (& movede)
            (& movedc)
            (tc-global-shared-view movede.paths)
            (tc-global-shared-view movedc.paths)))
          (Ok movedt)
          (let
            [_
              (try
                (tc-move-check-if-obligations
                  ctx
                  expr-bases
                  (tc-global-shared-view locals)
                  (tc-global-shared-view movedt)
                  then-branch-box
                  (tc-global-shared-view movede)
                  else-branch-box))]
            (Ok
              (tc-move-join-if
                ctx
                expr-bases
                movedc
                movedt
                then-branch-box
                movede
                else-branch-box)))))]
    [(Let let-box)
      (match (ast.ast-let-box-shared-view let-box)
        [(Let bindings body-box)
          (tc-move-check-let-bindings
            ctx
            expr-bases
            env
            (tc-moved-clone locals)
            (tc-moved-clone loop-carried)
            moved
            bindings
            body-box)])]
    [(Lambda lambda-box)
      (match (ast.ast-lambda-box-shared-view lambda-box)
        [(Lambda params maybe-ret body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [lambda-env : TcTypeEnv (tc-bind-params ctx env params)]
            [lambda-locals : TcMovedSet
              (tc-move-params-locals
                params
                ;; A lambda's exits leave its own scopes, not the caller's.
                ;; Capture locals preserve closure facts without carrying the
                ;; caller's obligation, owner-count or loop-depth markers.
                (if (tc-move-owners-in-scope? (tc-global-shared-view locals))
                  (tc-lambda-capture-locals
                    expr-bases
                    env
                    (tc-global-shared-view locals)
                    (tc-global-shared-view params)
                    (tc-global-shared-view body))
                  (tc-moved-clone locals)))]
            [lambda-writes-mark : i64
              (tc-body-param-writes-mark (tc-context-body-state ctx))]
            [lambda-moved
              (try
                (tc-move-check-expr-id
                  ctx
                  expr-bases
                  lambda-env
                  (tc-global-shared-view lambda-locals)
                  (tc-moved-empty)
                  (tc-param-storage-seed-params
                    ctx
                    lambda-env
                    params
                    (tc-moved-clone moved))
                  body-box))]
            [_
              (tc-body-param-write-fact-record!
                (tc-context-body-state ctx)
                body-box
                lambda-writes-mark
                (& params))]
            [result-check : TcMoveResult
              (match (tc-move-check-invalidate-body-end
                ctx
                expr-bases
                (tc-global-shared-view lambda-locals)
                (tc-global-shared-view lambda-moved)
                body-box)
                [(Err message) (Err message)]
                [(Ok)
                  (match maybe-ret
                    [(Some ret)
                      (tc-move-check-global-result
                        ctx
                        expr-bases
                        lambda-env
                        lambda-locals
                        lambda-moved
                        (tc-global-shared-view body)
                        ret)]
                    [(No)
                      (match (tc-body-type-fact-expr-id
                        "move.lambda_result"
                        ctx
                        lambda-env
                        body-box)
                        [(Ok body-ty)
                          (tc-move-check-global-result
                            ctx
                            expr-bases
                            lambda-env
                            lambda-locals
                            lambda-moved
                            (tc-global-shared-view body)
                            body-ty)]
                        [(Err _) (Ok lambda-moved)])])])]
            [_ (try result-check)]
            (tc-move-check-lambda-owner-captures
              ctx
              expr-bases
              env
              locals
              loop-carried
              moved
              params
              body))])]
    [(SpmdCompact compact-box)
      (match (ast.ast-spmd-compact-box-shared-view compact-box)
        [(Compact
            index
            index-ty
            start-box
            end-box
            slot
            slot-ty
            init-box
            keep-box
            body-box)
          (let
            [keep-env : TcTypeEnv
              (tc-bind-id env index (tc-resolve-type ctx index-ty))]
            [body-env : TcTypeEnv
              (tc-bind-id keep-env slot (tc-resolve-type ctx slot-ty))]
            [keep-locals : TcMovedSet
              (tc-moved-add (tc-moved-clone locals) index)]
            [body-locals : TcMovedSet
              (tc-moved-add (tc-moved-clone keep-locals) slot)]
            [outer-moved
              (try
                (tc-move-check-exprs
                  ctx
                  expr-bases
                  env
                  locals
                  (tc-global-shared-view loop-carried)
                  moved
                  (ast.ast-expr-cons
                    start-box
                    (&
                      (ast.ast-expr-cons
                        end-box
                        (&
                          (ast.ast-expr-cons
                            init-box
                            (& (ast.ast-expr-list-new)))))))))]
            [keep-moved
              (try
                (tc-move-check-expr-id
                  ctx
                  expr-bases
                  keep-env
                  keep-locals
                  (tc-global-shared-view loop-carried)
                  outer-moved
                  keep-box))]
            [_
              (try
                (tc-move-check-expr-id
                  ctx
                  expr-bases
                  body-env
                  body-locals
                  loop-carried
                  (tc-global-shared-view keep-moved)
                  body-box))]
            (Ok keep-moved))])]
    [(Tuple exprs)
      (match (tc-body-type-fact-expr-list-types
        "move.tuple_list"
        ctx
        env
        (tc-global-shared-view exprs))
        [(Ok types)
          (tc-move-check-aggregate-exprs-with-types
            ctx
            expr-bases
            env
            locals
            loop-carried
            moved
            exprs
            types)]
        [(Err _)
          (tc-move-check-exprs
            ctx
            expr-bases
            env
            locals
            loop-carried
            moved
            exprs)])]
    [(TupleRef inner-box _)
      (let
        [inner : ast.AstExpr
          (tc-move-projection-receiver
            ctx
            env
            expr-bases
            (tc-global-shared-view expr)
            (ast.ast-expr-segment-bases-get expr-bases inner-box))]
        [moved1
          (try
            (tc-move-check-expr
              ctx
              expr-bases
              env
              locals
              loop-carried
              moved
              inner))]
        (match (tc-move-tuple-element-path
          expr-bases
          (tc-global-shared-view expr))
          [(Some path)
            (match (tc-moved-path-exact-conflict
              (tc-global-shared-view moved1)
              path)
              [(Some key origin-id)
                (tc-move-rich-use-conflict-result
                  expr-bases
                  (Some key origin-id)
                  (tc-move-path-render path)
                  expr
                  (tc-move-path-render path))]
              [No (Ok moved1)])]
          [(No) (Ok moved1)]))]
    [(Array exprs)
      (match (tc-body-type-fact-expr-list-types
        "move.array_list"
        ctx
        env
        (tc-global-shared-view exprs))
        [(Ok types)
          (tc-move-check-exprs-with-types
            ctx
            expr-bases
            env
            locals
            loop-carried
            moved
            exprs
            types)]
        [(Err _)
          (tc-move-check-exprs
            ctx
            expr-bases
            env
            locals
            loop-carried
            moved
            exprs)])]
    [(DynArray exprs)
      (match (tc-body-type-fact-expr-list-types
        "move.dyn_array_list"
        ctx
        env
        (tc-global-shared-view exprs))
        [(Ok types)
          (tc-move-check-exprs-with-types
            ctx
            expr-bases
            env
            locals
            loop-carried
            moved
            exprs
            types)]
        [(Err _)
          (tc-move-check-exprs
            ctx
            expr-bases
            env
            locals
            loop-carried
            moved
            exprs)])]
    [(or (FixedMakeArray _ inner-box) (MakeArray _ inner-box) (Ann inner-box _)
         (Cast inner-box _) (Box inner-box) (BoxGet inner-box)
         (PtrNullCheck inner-box) (PtrRead inner-box) (PtrCast inner-box _)
         (PtrToInt inner-box) (IntToPtr inner-box _) (StringData inner-box)
         (ArrayData inner-box))
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-move-check-expr ctx expr-bases env locals loop-carried moved inner))]
    [(ArrayRef array-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        [moved1
          (try
            (tc-move-check-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view loop-carried)
              moved
              array))]
        [moved2
          (try
            (tc-move-check-expr
              ctx
              expr-bases
              env
              locals
              loop-carried
              moved1
              index))]
