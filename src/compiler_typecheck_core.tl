(defenum TcPrefixSnapshotLookup
  (TcPrefixSnapshotMiss)
  (TcPrefixSnapshotHit i64 String CompilerTypecheckSummary))

(defenum TcPrefixSnapshotSlot
  (TcPrefixSnapshotEmpty)
  (TcPrefixSnapshotFull String i64 String CompilerTypecheckSummary))

(defenum TcPrefixCandidate
  (TcNoPrefixCandidate)
  (TcSomePrefixCandidate String i64 String))

(define tc-prefix-snapshot-cache-capacity : i64
  64)
(define tc-prefix-snapshot-cache : (Array TcPrefixSnapshotSlot)
  (make-array TcPrefixSnapshotSlot 64))
(define tc-prefix-snapshot-cache-ready : bool
  false)
(define tc-prefix-snapshot-cache-hit-count : i64
  0)
(define tc-prefix-snapshot-cache-miss-count : i64
  0)
(define tc-prefix-snapshot-cache-store-count : i64
  0)

(define (tc-prefix-snapshot-cache-fill! [index : i64]) : unit
  (if (>= index tc-prefix-snapshot-cache-capacity)
    unit
    (begin
      (array-set! tc-prefix-snapshot-cache index (TcPrefixSnapshotEmpty))
      (tc-prefix-snapshot-cache-fill! (+ index 1)))))

(define (tc-prefix-snapshot-cache-stats-reset!) : unit
  (begin
    (set! tc-prefix-snapshot-cache-hit-count 0)
    (set! tc-prefix-snapshot-cache-miss-count 0)
    (set! tc-prefix-snapshot-cache-store-count 0)))

(define (tc-prefix-snapshot-cache-clear!) : unit
  (begin
    (tc-prefix-snapshot-cache-fill! 0)
    (set! tc-prefix-snapshot-cache-ready true)
    (tc-prefix-snapshot-cache-stats-reset!)))

(define (tc-prefix-snapshot-cache-ensure!) : unit
  (if tc-prefix-snapshot-cache-ready
    unit
    (tc-prefix-snapshot-cache-clear!)))

(define (tc-prefix-snapshot-cache-note-hit!) : unit
  (set!
    tc-prefix-snapshot-cache-hit-count
    (+ tc-prefix-snapshot-cache-hit-count 1)))

(define (tc-prefix-snapshot-cache-note-miss!) : unit
  (set!
    tc-prefix-snapshot-cache-miss-count
    (+ tc-prefix-snapshot-cache-miss-count 1)))

(define (tc-prefix-snapshot-cache-note-store!) : unit
  (set!
    tc-prefix-snapshot-cache-store-count
    (+ tc-prefix-snapshot-cache-store-count 1)))

(define (tc-prefix-snapshot-cache-lookup-count) : i64
  (+ tc-prefix-snapshot-cache-hit-count tc-prefix-snapshot-cache-miss-count))

(define (tc-prefix-snapshot-cache-hit-rate-per-mille) : i64
  (let
    [lookups : i64 (tc-prefix-snapshot-cache-lookup-count)]
    (if (= lookups 0)
      0
      (/ (* tc-prefix-snapshot-cache-hit-count 1000) lookups))))

(define (tc-prefix-snapshot-cache-stats-line [label : String]) : String
  (str-cat
    "typecheck-prefix-cache|"
    label
    "|hits="
    (int->string tc-prefix-snapshot-cache-hit-count)
    "|misses="
    (int->string tc-prefix-snapshot-cache-miss-count)
    "|stores="
    (int->string tc-prefix-snapshot-cache-store-count)
    "|lookups="
    (int->string (tc-prefix-snapshot-cache-lookup-count))
    "|hit-rate-per-mille="
    (int->string (tc-prefix-snapshot-cache-hit-rate-per-mille))))

(define (tc-prefix-snapshot-cache-print-stats [label : String]) : unit
  (print-error (string-append (tc-prefix-snapshot-cache-stats-line label) "\n")))

(define (tc-prefix-snapshot-cache-lookup-from [key : String] [index : i64]) : TcPrefixSnapshotLookup
  (if (>= index tc-prefix-snapshot-cache-capacity)
    (TcPrefixSnapshotMiss)
    (match (array-ref tc-prefix-snapshot-cache index)
      [(TcPrefixSnapshotEmpty) (TcPrefixSnapshotMiss)]
      [(TcPrefixSnapshotFull slot-key count module summary)
        (if (string-eq slot-key key)
          (TcPrefixSnapshotHit count module summary)
          (tc-prefix-snapshot-cache-lookup-from key (+ index 1)))])))

(define (tc-prefix-snapshot-cache-lookup [key : String]) : TcPrefixSnapshotLookup
  (begin
    (tc-prefix-snapshot-cache-ensure!)
    (tc-prefix-snapshot-cache-lookup-from key 0)))

(define (tc-prefix-snapshot-cache-store-at
  [key : String]
  [count : i64]
  [module : String]
  [summary : CompilerTypecheckSummary]
  [index : i64]) : bool
  (if (>= index tc-prefix-snapshot-cache-capacity)
    false
    (match (array-ref tc-prefix-snapshot-cache index)
      [(TcPrefixSnapshotEmpty)
        (begin
          (array-set!
            tc-prefix-snapshot-cache
            index
            (TcPrefixSnapshotFull key count module summary))
          (tc-prefix-snapshot-cache-note-store!)
          true)]
      [(TcPrefixSnapshotFull slot-key _ _ _)
        (if (string-eq slot-key key)
          (begin
            (array-set!
              tc-prefix-snapshot-cache
              index
              (TcPrefixSnapshotFull key count module summary))
            (tc-prefix-snapshot-cache-note-store!)
            true)
          (tc-prefix-snapshot-cache-store-at
            key
            count
            module
            summary
            (+ index 1)))])))

(define (tc-prefix-snapshot-cache-store
  [key : String]
  [count : i64]
  [module : String]
  [summary : CompilerTypecheckSummary]) : bool
  (begin
    (tc-prefix-snapshot-cache-ensure!)
    (tc-prefix-snapshot-cache-store-at key count module summary 0)))

(define (tc-prefix-snapshot-cache-store-persistent
  [key : String]
  [count : i64]
  [module : String]
  [summary : CompilerTypecheckSummary]) : bool
  (let
    [prev-arena : i64 (arena-current)]
    [stored : bool
      (begin
        (unsafe
          (arena-set! node-pool-base-arena))
        (let
          [persistent-key : String (string-copy-borrowed (& key))]
          [persistent-module : String (string-copy-borrowed (& module))]
          (begin
            (unsafe
              (arena-set! prev-arena))
            (tc-prefix-snapshot-cache-store
              persistent-key
              count
              persistent-module
              summary))))]
    stored))

(define (tc-context-with-module [ctx : TcContext] [module : String]) : TcContext
  (match ctx
    [(TcContext program symbols registries _)
      (TcContext program symbols registries module)]))

(define (tc-context-module [ctx : TcContext]) : String
  (match ctx
    [(TcContext _ _ _ module) module]))

;; The typechecker receives an already-loaded program and so does not know the
;; source path; it builds diagnostics with an empty path (the CLI driver stamps
;; the real path before rendering). Synthetic/internal errors fall back to 1:1.
(define (tc-canonical-diagnostic [diag : CompilerDiagnostic]) : CompilerDiagnostic
  (compiler-diagnostic-with-category
    (compiler-diagnostic-with-code diag (compiler-diagnostic-code-typecheck))
    "typecheck"))

(define (tc-diag-at-start [message : String]) : CompilerDiagnostic
  (tc-canonical-diagnostic (compiler-diagnostic-at-start "" message)))

(define (tc-located-error-prefix) : String
  "__tl_tc_loc|")

(define (tc-rich-error-prefix) : String
  "__tl_tc_diag|")

(define (tc-diag-string-prefix? [text : String] [prefix : String]) : bool
  (let
    [text-len : i64 (string-length text)]
    [prefix-len : i64 (string-length prefix)]
    (if (< text-len prefix-len)
      false
      (string-eq (substring text 0 prefix-len) prefix))))

(define (tc-located-error? [message : String]) : bool
  (tc-diag-string-prefix? message (tc-located-error-prefix)))

(define (tc-rich-error? [message : String]) : bool
  (tc-diag-string-prefix? message (tc-rich-error-prefix)))

(define (tc-rich-error-span-fields [span : AstSourceSpan]) : String
  (str-cat
    (int->string (struct-get span start-line))
    "|"
    (int->string (struct-get span start-col))
    "|"
    (int->string (struct-get span end-line))
    "|"
    (int->string (struct-get span end-col))
    "|"))

(define (tc-rich-error-one-secondary
  [primary : AstSourceSpan]
  [message : String]
  [help : String]
  [secondary : AstSourceSpan]
  [secondary-label : String]) : String
  (str-cat
    (tc-rich-error-prefix)
    (tc-rich-error-span-fields primary)
    message
    "|"
    help
    "|1|"
    (tc-rich-error-span-fields secondary)
    secondary-label))

(define (tc-rich-error-two-secondaries
  [primary : AstSourceSpan]
  [message : String]
  [help : String]
  [first : AstSourceSpan]
  [first-label : String]
  [second : AstSourceSpan]
  [second-label : String]) : String
  (str-cat
    (tc-rich-error-prefix)
    (tc-rich-error-span-fields primary)
    message
    "|"
    help
    "|2|"
    (tc-rich-error-span-fields first)
    first-label
    "|"
    (tc-rich-error-span-fields second)
    second-label))

(define (tc-located-error-field-end [text : String] [start : i64]) : i64
  (let
    [i : i64 start]
    [n : i64 (string-length text)]
    [done : bool false]
    (begin
      (while (and (< i n) (not done))
        (if (= (cast (string-ref text i) : i64) 124)
          (set! done true)
          (set! i (+ i 1))))
      i)))

(define (tc-located-error-field [text : String] [start : i64] [end : i64]) : String
  (substring text start (- end start)))

(define (tc-rich-error-diag [message : String]) : CompilerDiagnostic
  (let
    [prefix-len : i64 (string-length (tc-rich-error-prefix))]
    [line-end : i64 (tc-located-error-field-end message prefix-len)]
    [col-start : i64 (+ line-end 1)]
    [col-end : i64 (tc-located-error-field-end message col-start)]
    [end-line-start : i64 (+ col-end 1)]
    [end-line-end : i64 (tc-located-error-field-end message end-line-start)]
    [end-col-start : i64 (+ end-line-end 1)]
    [end-col-end : i64 (tc-located-error-field-end message end-col-start)]
    [msg-start : i64 (+ end-col-end 1)]
    [msg-end : i64 (tc-located-error-field-end message msg-start)]
    [help-start : i64 (+ msg-end 1)]
    [help-end : i64 (tc-located-error-field-end message help-start)]
    [count-start : i64 (+ help-end 1)]
    [count-end : i64 (tc-located-error-field-end message count-start)]
    [clean-message : String (tc-located-error-field message msg-start msg-end)]
    [help : String (tc-located-error-field message help-start help-end)]
    [remaining : i64
      (string->int (tc-located-error-field message count-start count-end))]
    [idx : i64 (+ count-end 1)]
    [diag : CompilerDiagnostic
      (compiler-diagnostic-from-ast-span
        ""
        (AstSourceSpan
          (string->int (tc-located-error-field message prefix-len line-end))
          (string->int (tc-located-error-field message col-start col-end))
          (string->int
            (tc-located-error-field message end-line-start end-line-end))
          (string->int
            (tc-located-error-field message end-col-start end-col-end)))
        clean-message)]
    (begin
      (if (> (string-length help) 0)
        (set! diag (compiler-diagnostic-with-help diag help))
        unit)
      (while (> remaining 0)
        (let
          [sec-line-end : i64 (tc-located-error-field-end message idx)]
          [sec-col-start : i64 (+ sec-line-end 1)]
          [sec-col-end : i64 (tc-located-error-field-end message sec-col-start)]
          [sec-end-line-start : i64 (+ sec-col-end 1)]
          [sec-end-line-end : i64
            (tc-located-error-field-end message sec-end-line-start)]
          [sec-end-col-start : i64 (+ sec-end-line-end 1)]
          [sec-end-col-end : i64
            (tc-located-error-field-end message sec-end-col-start)]
          [label-start : i64 (+ sec-end-col-end 1)]
          [label-end : i64
            (if (= remaining 1)
              (string-length message)
              (tc-located-error-field-end message label-start))]
          [label : String
            (tc-located-error-field message label-start label-end)]
          (begin
            (set!
              diag
              (compiler-diagnostic-with-secondary
                diag
                (CompilerDiagnosticSpan
                  ""
                  (string->int
                    (tc-located-error-field message idx sec-line-end))
                  (string->int
                    (tc-located-error-field message sec-col-start sec-col-end))
                  (string->int
                    (tc-located-error-field
                      message
                      sec-end-line-start
                      sec-end-line-end))
                  (string->int
                    (tc-located-error-field
                      message
                      sec-end-col-start
                      sec-end-col-end)))
                (CompilerDiagnosticSomeString label)))
            (set! idx (+ label-end 1))
            (set! remaining (- remaining 1)))))
      (tc-canonical-diagnostic diag))))

(define (tc-located-error [span : AstSourceSpan] [message : String]) : String
  (string-append
    (tc-located-error-prefix)
    (string-append
      (int->string (struct-get span start-line))
      (string-append
        "|"
        (string-append
          (int->string (struct-get span start-col))
          (string-append
            "|"
            (string-append
              (int->string (struct-get span end-line))
              (string-append
                "|"
                (string-append
                  (int->string (struct-get span end-col))
                  (string-append "|" message))))))))))

(define (tc-located-error-diag [message : String]) : CompilerDiagnostic
  (let
    [prefix-len : i64 (string-length (tc-located-error-prefix))]
    [line-end : i64 (tc-located-error-field-end message prefix-len)]
    [col-start : i64 (+ line-end 1)]
    [col-end : i64 (tc-located-error-field-end message col-start)]
    [end-line-start : i64 (+ col-end 1)]
    [end-line-end : i64 (tc-located-error-field-end message end-line-start)]
    [end-col-start : i64 (+ end-line-end 1)]
    [end-col-end : i64 (tc-located-error-field-end message end-col-start)]
    [clean-start : i64 (+ end-col-end 1)]
    [clean-message : String
      (substring message clean-start (- (string-length message) clean-start))]
    (tc-canonical-diagnostic
      (compiler-diagnostic-from-ast-span
        ""
        (AstSourceSpan
          (string->int (tc-located-error-field message prefix-len line-end))
          (string->int (tc-located-error-field message col-start col-end))
          (string->int
            (tc-located-error-field message end-line-start end-line-end))
          (string->int
            (tc-located-error-field message end-col-start end-col-end)))
        clean-message))))

(define (tc-ty-node-pool-exhausted-diagnostic) : CompilerDiagnostic
  (tc-diag-at-start (ty-node-pool-exhausted-message)))

(define (tc-typecheck-result-with-pool-check [result : ResultCompilerTypecheck]) : ResultCompilerTypecheck
  (if (ty-node-pool-exhausted?)
    (ErrCompilerTypecheck (tc-ty-node-pool-exhausted-diagnostic))
    result))

(define (tc-typecheck-checked-result-with-pool-check
  [result : ResultCompilerTypecheckChecked]) : ResultCompilerTypecheckChecked
  (if (ty-node-pool-exhausted?)
    (ErrCompilerTypecheckChecked (tc-ty-node-pool-exhausted-diagnostic))
    result))

(cfg
  compile-profile
  (define compiler-tc-profile-start-ms : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-profile-start-total : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-profile-start-live : i64
    0))

(cfg
  compile-profile
  (define (compiler-tc-profile-field [value : i64]) : String
    (string-append "|" (int->string value))))

(cfg
  compile-profile
  (define (compiler-tc-profile-start) : unit
    (begin
      (set! compiler-tc-profile-start-ms (profile-now-ms))
      (set! compiler-tc-profile-start-total (profile-alloc-total))
      (set! compiler-tc-profile-start-live (profile-alloc-live))
      (profile-alloc-reset-peak))))

(cfg
  compile-profile
  (define (compiler-tc-profile-finish [phase : String]) : unit
    (let
      [end-ms : i64 (profile-now-ms)]
      [end-total : i64 (profile-alloc-total)]
      [end-live : i64 (profile-alloc-live)]
      [peak-delta : i64 (- (profile-alloc-peak) compiler-tc-profile-start-live)]
      (print-error
        (string-append
          "compile-profile|typecheck."
          (string-append
            phase
            (string-append
              (compiler-tc-profile-field
                (- end-ms compiler-tc-profile-start-ms))
              (string-append
                (compiler-tc-profile-field
                  (- end-total compiler-tc-profile-start-total))
                (string-append
                  (compiler-tc-profile-field
                    (- end-live compiler-tc-profile-start-live))
                  (string-append (compiler-tc-profile-field peak-delta) "\n"))))))))))

(cfg
  compile-profile
  (define compiler-tc-macro-profile-start-ms : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-macro-profile-entries : CompilerTcMacroProfileEntries
    (CompilerTcMacroProfileNil)))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-reset) : unit
    (begin
      (set! compiler-tc-macro-profile-start-ms 0)
      (set! compiler-tc-macro-profile-entries (CompilerTcMacroProfileNil)))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-start) : unit
    (set! compiler-tc-macro-profile-start-ms (profile-now-ms))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-arg-count [args : AstExprList]) : i64
    (match args
      [(AstExprNil) 0]
      [(AstExprCons _ rest)
        (+ 1 (compiler-tc-macro-profile-arg-count (box-get rest)))])))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-record-in
    [entries : CompilerTcMacroProfileEntries]
    [macro-name : String]
    [arity : i64]
    [elapsed-ms : i64]) : CompilerTcMacroProfileEntries
    (match entries
      [(CompilerTcMacroProfileNil)
        (CompilerTcMacroProfileCons
          macro-name
          arity
          1
          elapsed-ms
          (box (CompilerTcMacroProfileNil)))]
      [(CompilerTcMacroProfileCons entry-name entry-arity calls total-ms rest)
        (if (and (string-eq entry-name macro-name) (= entry-arity arity))
          (CompilerTcMacroProfileCons
            entry-name
            entry-arity
            (+ calls 1)
            (+ total-ms elapsed-ms)
            rest)
          (CompilerTcMacroProfileCons
            entry-name
            entry-arity
            calls
            total-ms
            (box
              (compiler-tc-macro-profile-record-in
                (box-get rest)
                macro-name
                arity
                elapsed-ms))))])))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-record
    [macro-name : String]
    [arity : i64]
    [elapsed-ms : i64]) : unit
    (set!
      compiler-tc-macro-profile-entries
      (compiler-tc-macro-profile-record-in
        compiler-tc-macro-profile-entries
        macro-name
        arity
        elapsed-ms))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-finish
    [macro-name : String]
    [args : AstExprList]) : unit
    (compiler-tc-macro-profile-record
      macro-name
      (compiler-tc-macro-profile-arg-count args)
      (- (profile-now-ms) compiler-tc-macro-profile-start-ms))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-detail
    [macro-name : String]
    [arity : i64]
    [calls : i64]) : String
    (string-append
      macro-name
      (string-append
        " arity="
        (string-append
          (int->string arity)
          (string-append " calls=" (int->string calls)))))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-emit-entry
    [macro-name : String]
    [arity : i64]
    [calls : i64]
    [total-ms : i64]) : unit
    (print-error
      (string-append
        "compile-profile-detail|typecheck.macro_expand|"
        (string-append
          (int->string total-ms)
          (string-append
            "|"
            (string-append
              (compiler-tc-macro-profile-detail macro-name arity calls)
              "\n")))))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-emit-entries
    [entries : CompilerTcMacroProfileEntries]) : unit
    (match entries
      [(CompilerTcMacroProfileNil) unit]
      [(CompilerTcMacroProfileCons macro-name arity calls total-ms rest)
        (begin
          (compiler-tc-macro-profile-emit-entry macro-name arity calls total-ms)
          (compiler-tc-macro-profile-emit-entries (box-get rest)))])))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-emit) : unit
    (compiler-tc-macro-profile-emit-entries compiler-tc-macro-profile-entries)))

