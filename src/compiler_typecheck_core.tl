(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-binding-type
    [site : String]
    [ctx : TcContext]
    [env : TcTypeEnv]
    [maybe-ty : AstMaybeType]
    [init : AstExpr]) : AstType
    (match maybe-ty
      [(AstMaybeType.Some t) (tc-resolve-type ctx t)]
      [(AstMaybeType.No)
        (match (compiler-tc-reinfer-profile-expr site ctx env init)
          [(ResultTcType.Ok t) t]
          [(ResultTcType.Err _) (AstType.I64)])])))

(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-line
    [site : String]
    [elapsed-ms : i64]
    [alloc-delta : i64]
    [live-delta : i64]) : unit
    (io.print-error
      (string.append
        "compile-profile|typecheck.reinfer."
        (string.append
          site
          (string.append
            (compiler-tc-profile-field elapsed-ms)
            (string.append
              (compiler-tc-profile-field alloc-delta)
              (string.append (compiler-tc-profile-field live-delta) "|0\n"))))))))

(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-emit-entry [index : i64]) : unit
    (begin
      (compiler-tc-reinfer-profile-line
        (compiler-tc-reinfer-profile-site-name index)
        (array-ref compiler-tc-reinfer-profile-ms index)
        (array-ref compiler-tc-reinfer-profile-alloc index)
        (array-ref compiler-tc-reinfer-profile-live index))
      (compiler-tc-reinfer-profile-line
        (string.append (compiler-tc-reinfer-profile-site-name index) ".calls")
        (array-ref compiler-tc-reinfer-profile-calls index)
        0
        0))))

(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-emit-at [index : i64]) : unit
    (if (< index compiler-tc-reinfer-profile-site-count)
      (begin
        (compiler-tc-reinfer-profile-emit-entry index)
        (compiler-tc-reinfer-profile-emit-at (+ index 1)))
      unit)))

(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-emit) : unit
    (compiler-tc-reinfer-profile-emit-at 0)))

(cfg
  compile-profile
  (define (compiler-tc-body-fact-profile-line
