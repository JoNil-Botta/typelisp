                                        (ResultTcType.Err message)])]
                                  [(ResultTcUnit.Err message)
                                    (ResultTcType.Err message)])]
                              [(ResultTcType.Err message)
                                (ResultTcType.Err message)]))
                          (ResultTcType.Err
