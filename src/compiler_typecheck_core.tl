(defmacro (tc-job-state-new-from-profile-metrics-address
  [_profile-metrics-address : Expr]) : Expr
  `(let
    [cell : (__tl_dyn-array TcJobStateData) (__tl_make-array TcJobStateData 1)]
    [owner : i64 (arena.tl_arena_current)]
    [macro-state-addresses : (__tl_dyn-array i64)
      (__tl_make-array i64 (cfg (any compile-profile test) 18 17))]
    (begin
      ;; The directory never grows, so TcMacroState may carry its data pointer
      ;; directly. Slots 0-10 hold the lazy macro substates and slot 11 is
      ;; unused. Slot 12 keeps the owner beside the lazy addresses, while
      ;; slot 13 carries the combined source-name/structural-intern session,
      ;; slot 14 lazily owns the non-macro lazy-import table, and slots 15-16
      ;; own the nominal/type-name and clone families. Profile/test builds use
      ;; slot 17 for the job-owned typecheck metrics view.
      (set! (array-ref macro-state-addresses 12) owner)
      (cfg
        (any compile-profile test)
        (set!
          (array-ref macro-state-addresses 17)
          (cast ,_profile-metrics-address : i64)))
      (set!
        (array-ref cell 0)
        (TcJobStateData
          owner
          macro-state-addresses
          (tc-source-key-cache-state-new)
          (tc-topenv-membership-state-new)
          (tc-thread-name-kind-state-new)
          (tc-inlay-hint-state-new)
          (tc-macro-call-site-state-new)
          (tc-checked-let-binding-fact-state-new)
          (tc-scratch-arena-state-new)
          (tc-unused-unsafe-state-new)
          (tc-spmd-traversal-state-new)
          (tc-type-resolution-cache-state-new)
          (tc-agg-scalar-cache-state-new)
          0
          0
          0
          0
          0
          (cdiag.compiler-advisory-sink-new)
          (TcSemanticObserver 0)))
      (TcJobState
        (cast
          (unsafe
            (ptr->int (ptr-cast (__tl_array-data cell) : (Ptr TcJobStateData))))
          : i64)))))

(cfg
  (any compile-profile test)
  (define (tc-job-state-new-with-profile-metrics-address
    [profile-metrics-address : u64]) : TcJobState
    (tc-job-state-new-from-profile-metrics-address profile-metrics-address)))

;; Preserve the exact ordinary constructor after cfg erasure. Profile builds
;; give serial compatibility callers a private view; production driver jobs
;; pass their CompilerProfileState-backed view through the explicit constructor.
(cfg
  (not (any compile-profile test))
  (define (tc-job-state-new) : TcJobState
    (tc-job-state-new-from-profile-metrics-address (cast 0 : u64))))

(cfg
  (any compile-profile test)
  (define (tc-job-state-new) : TcJobState
    (cfg
      compile-profile
      (let
        [metrics : (__tl_dyn-array i64)
          (__tl_make-array i64 compiler-tc-profile-metric-count)]
        (tc-job-state-new-with-profile-metrics-address
          (unsafe
            (ptr->int (ptr-cast (__tl_array-data metrics) : (Ptr i64))))))
      (tc-job-state-new-with-profile-metrics-address (cast 0 : u64)))))

(define (tc-job-state-view [state : TcJobState]) : (Ptr TcJobStateData)
  (tc-state-cell-view state.address TcJobStateData))

(define (tc-job-state-advisory-sink [state : TcJobState]) : cdiag.CompilerAdvisorySink
  (tc-job-state-field state advisory-sink cdiag.CompilerAdvisorySink))

(define (tc-job-state-reset-advisories! [state : TcJobState]) : unit
  (cdiag.compiler-advisory-sink-reset! (tc-job-state-advisory-sink state)))

(define (tc-job-state-macro-state [state : TcJobState]) : TcMacroState
  (TcMacroState
    (cast
      (unsafe
        (ptr->int
          (__tl_array-data
            (tc-job-state-field
              state
              macro-state-addresses
              (__tl_dyn-array i64)))))
      : i64)))

(defmacro (tc-job-state-field [state : Expr] [field : Expr] [_T : type]) : Expr
  `(unsafe
    (ptr-read
      (ptr-cast
        (ptr-offset
          (int->ptr
            (cast ,(comptime.expr-struct-get state "address") : u64)
            : (Ptr u8))
          (comptime (offset-of (type TcJobStateData) ,field)))
        : (Ptr ,_T)))))

(defmacro (tc-type-env-scoped-state-field
  [state : Expr]
  [field : Expr]
  [_T : type]) : Expr
  `(unsafe
    (ptr-read
      (ptr-cast
        (ptr-offset
          (int->ptr
            (cast ,(comptime.expr-struct-get state "address") : u64)
            : (Ptr u8))
          (comptime (offset-of (type TcTypeEnvScopedStateData) ,field)))
        : (Ptr ,_T)))))

(define (tc-macro-state-owner-arena [state : TcMacroState]) : i64
  (unsafe
    (ptr-read (ptr-offset (int->ptr (cast state.address : u64) : (Ptr i64)) 12))))

(define tc-macro-state-slot-module-env : i64
  0)
(define tc-macro-state-slot-helper : i64
  1)
(define tc-macro-state-slot-abstract : i64
  2)
(define tc-macro-state-slot-walk : i64
  3)
(define tc-macro-state-slot-generated-module : i64
  4)
(define tc-macro-state-slot-generated-decls : i64
  5)
(define tc-macro-state-slot-surface-call : i64
  6)
(define tc-macro-state-slot-hygiene-produced : i64
  7)
(define tc-macro-state-slot-import-index : i64
  8)
(define tc-macro-state-slot-result-identity : i64
  9)
(define tc-macro-state-slot-identity : i64
  10)
(define tc-macro-state-slot-lazy-import : i64
  14)
(define tc-macro-state-slot-nominal-cache : i64
  15)
(define tc-macro-state-slot-clone : i64
  16)
(cfg
  (any compile-profile test)
  (define tc-macro-state-slot-profile-metrics : i64
    17))

(define (tc-macro-state-slot-address [state : TcMacroState] [slot : i64]) : i64
  (unsafe
    (ptr-read
      (ptr-offset (int->ptr (cast state.address : u64) : (Ptr i64)) slot))))

(define (tc-macro-state-slot-address-set!
  [state : TcMacroState]
  [slot : i64]
  [address : i64]) : unit
  (unsafe
    (ptr-write!
      (ptr-offset (int->ptr (cast state.address : u64) : (MutPtr i64)) slot)
      address)))

;; Keep the initialized path small. If allocation lives in this function, the
;; backend gives every hot lookup the cold path's large frame and register-save
;; prologue even though each substate initializes only once per job.
(defmacro (tc-macro-state-address-fast
  [state : Expr]
  [slot : Expr]
  [initialize : Expr]) : Expr
  `(let
    [address : i64 (tc-macro-state-slot-address ,state ,slot)]
    (if (> address 0)
      address
      (,initialize ,state))))

;; Keep typed slot allocation in one expression template. Explicit wrappers
;; preserve the module's forward declarations and imported name bindings.
(defmacro (tc-macro-state-cell-initialize
  [state : Expr]
  [_payload : Expr]
  [slot : Expr]
  [initial : Expr]) : Expr
  `(let
    [address : i64 (tc-macro-state-slot-address ,state ,slot)]
    (if (> address 0)
      address
      (let
        [owner : i64 (tc-macro-state-owner-arena ,state)]
        (in-arena
          (arena.Arena owner)
          (let
            [cell : (__tl_dyn-array ,_payload) (__tl_make-array ,_payload 1)]
            [_init : unit (set! (array-ref cell 0) ,initial)]
            [next : i64
              (cast
                (unsafe
                  (ptr->int (ptr-cast (__tl_array-data cell) : (Ptr ,_payload))))
                : i64)]
            (tc-macro-state-slot-address-set! ,state ,slot next)
            next))))))

(defmacro (tc-state-cell-read [address : Expr] [_payload : Expr]) : Expr
  `(unsafe
    (ptr-read (int->ptr (cast ,address : u64) : (Ptr ,_payload)))))

(defmacro (tc-state-cell-ptr [address : Expr] [_payload : Expr]) : Expr
  `(unsafe
    (int->ptr (cast ,address : u64) : (MutPtr ,_payload))))

(defmacro (tc-state-cell-view [address : Expr] [_payload : Expr]) : Expr
  `(unsafe
    (int->ptr (cast ,address : u64) : (Ptr ,_payload))))

(defmacro (tc-state-cell-write!
  [address : Expr]
  [_payload : Expr]
  [data : Expr]) : Expr
  `(unsafe
    (ptr-write! (int->ptr (cast ,address : u64) : (MutPtr ,_payload)) ,data)))

(define (tc-nominal-cache-state-ptr [state : TcNominalCacheState]) : (MutPtr
    TcNominalCacheStateData)
  (tc-state-cell-ptr state.address TcNominalCacheStateData))

(define (tc-nominal-cache-state-view [state : TcNominalCacheState]) : (Ptr
    TcNominalCacheStateData)
  (tc-state-cell-view state.address TcNominalCacheStateData))

(define (tc-nominal-cache-state-data [state : TcNominalCacheState]) : TcNominalCacheStateData
  (tc-state-cell-read state.address TcNominalCacheStateData))

(define (tc-type-handle-cache-state-ptr [state : TcTypeHandleCacheState]) : (MutPtr
    TcTypeHandleCacheStateData)
  (tc-state-cell-ptr state.address TcTypeHandleCacheStateData))

(define (tc-type-handle-cache-state-data [state : TcTypeHandleCacheState]) : TcTypeHandleCacheStateData
  (tc-state-cell-read state.address TcTypeHandleCacheStateData))

(define (tc-clone-state-ptr [state : TcCloneState]) : (MutPtr TcCloneStateData)
  (tc-state-cell-ptr state.address TcCloneStateData))

(define (tc-clone-state-view [state : TcCloneState]) : (Ptr TcCloneStateData)
  (tc-state-cell-view state.address TcCloneStateData))

(define (tc-clone-state-data [state : TcCloneState]) : TcCloneStateData
  (tc-state-cell-read state.address TcCloneStateData))

(define (tc-clone-state-data-set!
  [state : TcCloneState]
  [data : TcCloneStateData]) : unit
  (tc-state-cell-write! state.address TcCloneStateData data))

(define (tc-type-handle-cache-state-new [owner : i64]) : TcTypeHandleCacheState
  (in-arena
    (arena.Arena owner)
    (let
      [cell : (__tl_dyn-array TcTypeHandleCacheStateData)
        (__tl_make-array TcTypeHandleCacheStateData 1)]
      (set! (array-ref cell 0) (TcTypeHandleCacheStateData owner 0 0 0 -1 -1))
      (TcTypeHandleCacheState
        (cast
          (unsafe
            (ptr->int
              (ptr-cast
                (__tl_array-data cell)
                : (Ptr TcTypeHandleCacheStateData))))
          : i64)))))

(define (tc-nominal-cache-state-new [owner : i64]) : TcNominalCacheState
  (in-arena
    (arena.Arena owner)
    (let
      [cell : (__tl_dyn-array TcNominalCacheStateData)
        (__tl_make-array TcNominalCacheStateData 1)]
      [handles : (__tl_dyn-array i64) (__tl_make-array i64 8)]
      [names : (__tl_dyn-array String) (__tl_make-array String 8)]
      [index : i64 0]
      (while (< index 8)
        (set! (array-ref handles index) -1)
        (set! (array-ref names index) "")
        (set! index (+ index 1)))
      (set!
        (array-ref cell 0)
        (TcNominalCacheStateData
          handles
          names
          false
          false
          -1
          0
          (tc-type-handle-cache-state-new owner)))
      (TcNominalCacheState
        (cast
          (unsafe
            (ptr->int
              (ptr-cast (__tl_array-data cell) : (Ptr TcNominalCacheStateData))))
          : i64)))))

(define (tc-clone-state-new [owner : i64]) : TcCloneState
  (in-arena
    (arena.Arena owner)
    (let
      [cell : (__tl_dyn-array TcCloneStateData)
        (__tl_make-array TcCloneStateData 1)]
      (set!
        (array-ref cell 0)
        (TcCloneStateData
          false
          (clone_support.clone-name-set-empty)
          false
          false
          (tc_i64_i64_map.with-capacity 8)
          (Empty)
          0))
      (TcCloneState
        (cast
          (unsafe
            (ptr->int
              (ptr-cast (__tl_array-data cell) : (Ptr TcCloneStateData))))
          : i64)))))

(define (tc-macro-state-nominal-cache-address-initialize [state : TcMacroState]) : i64
  (let
    [cache : TcNominalCacheState
      (tc-nominal-cache-state-new (tc-macro-state-owner-arena state))]
    (tc-macro-state-slot-address-set!
      state
      tc-macro-state-slot-nominal-cache
      cache.address)
    cache.address))

(define (tc-macro-state-clone-address-initialize [state : TcMacroState]) : i64
  (let
    [clone-state : TcCloneState
      (tc-clone-state-new (tc-macro-state-owner-arena state))]
    (tc-macro-state-slot-address-set!
      state
      tc-macro-state-slot-clone
      clone-state.address)
    clone-state.address))

(define (tc-macro-state-nominal-cache [state : TcMacroState]) : TcNominalCacheState
  (TcNominalCacheState
    (tc-macro-state-address-fast
      state
      tc-macro-state-slot-nominal-cache
      tc-macro-state-nominal-cache-address-initialize)))

(define (tc-macro-state-clone [state : TcMacroState]) : TcCloneState
  (TcCloneState
    (tc-macro-state-address-fast
      state
      tc-macro-state-slot-clone
      tc-macro-state-clone-address-initialize)))

(define (tc-job-state-nominal-cache [state : TcJobState]) : TcNominalCacheState
  (tc-macro-state-nominal-cache (tc-job-state-macro-state state)))

(define (tc-job-state-clone [state : TcJobState]) : TcCloneState
  (tc-macro-state-clone (tc-job-state-macro-state state)))

(define (tc-job-state-source-key-cache [state : TcJobState]) : TcSourceKeyCacheState
  (tc-job-state-field state source-key-cache TcSourceKeyCacheState))

(define (tc-job-state-topenv-membership [state : TcJobState]) : TcTopEnvMembershipState
  (tc-job-state-field state topenv-membership TcTopEnvMembershipState))

(define (tc-job-state-thread-name-kind [state : TcJobState]) : TcThreadNameKindState
  (tc-job-state-field state thread-name-kind TcThreadNameKindState))

(define (tc-job-state-inlay-hints [state : TcJobState]) : TcInlayHintState
