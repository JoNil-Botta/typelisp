              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view loop-carried)
              moved
              arena))]
        (tc-move-check-exprs
          ctx
          expr-bases
          env
          locals
          loop-carried
          moved1
          exprs))]
    [(WithResource wr-box)
      (match (ast.ast-with-resource-box-shared-view wr-box)
        [(WithResource bindings exprs)
          (tc-move-check-resource-bindings
            ctx
            expr-bases
            env
            locals
            loop-carried
            moved
            bindings
            exprs
            expr)])]
    [(BoxTake inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        [moved1
          (try
            (tc-move-check-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view loop-carried)
              moved
              (tc-global-shared-view inner)))]
        (match (tc-expr ctx env (tc-global-shared-view expr))
          [(Ok result-ty)
            (if (tc-type-move-only? ctx (tc-global-shared-view result-ty))
              (match (tc-expr ctx env (tc-global-shared-view inner))
                [(Ok receiver-ty)
                  (match (tc-type-strip-region
                    (tc-resolve-type ctx (tc-global-shared-view receiver-ty)))
                    [(Box _)
                      (tc-move-after-consuming-value
                        ctx
                        expr-bases
                        env
                        locals
                        loop-carried
                        moved1
                        inner
                        receiver-ty)]
                    [(Ref _ _)
                      (Err
                        (tc-move-out-of-reference-message
                          expr-bases
                          expr
                          result-ty
                          1
                          (tc-move-out-of-deref-help)))]
                    [(MutRef _ _)
                      (Err
                        (tc-move-out-of-reference-message
                          expr-bases
                          expr
                          result-ty
                          2
                          (tc-move-out-of-deref-help)))]
                    [_ (Ok moved1)])]
                [(Err _) (Ok moved1)])
              (Ok moved1))]
          [(Err _) (Ok moved1)]))]
    [(BoxSet box-box value-box)
      (let
        [_
          (try
            (tc-move-foreign-global-place-check
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              box-box
              "assign through"))]
        (let
          [box-expr : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases box-box)]
          [_value : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases value-box)]
          [moved1
            (try
              (tc-move-check-expr
                ctx
                expr-bases
                env
                (tc-global-shared-view locals)
                (tc-global-shared-view loop-carried)
                moved
                box-expr))]
          [_
            (try
              (tc-move-check-cleanup-overwrite
                ctx
                expr-bases
                env
                (tc-global-shared-view moved1)
                (BoxTake box-box)))]
          [moved2
            (try
              (tc-move-check-expr-id
                ctx
                expr-bases
                env
                (tc-global-shared-view locals)
                (tc-global-shared-view loop-carried)
                moved1
                value-box))]
          (Ok
            (try
              (tc-move-after-bind-id
                ctx
                expr-bases
                env
                locals
                loop-carried
                moved2
                value-box)))))]
    ;; The CTFE evaluator consumes this subtree before the runtime body exists.
    ;; Its source operands therefore cannot move runtime locals.
    ;; No early-exit fact: those only stop lowering from forwarding a caller's
    ;; sret slot into this body, and a try error exit builds its Err in that
    ;; slot (`lower-return-result-err`).
    [(Try inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        [moved1
          (try
            (tc-move-check-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              loop-carried
              moved
              inner))]
        (tc-move-check-obligations-exit
          expr-bases
          locals
          -1
          moved1
          (tc-global-shared-view expr)
          "before this try can propagate an error"))]
    [(Return inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-body-early-exit-note! (tc-context-body-state ctx))
        (let
          [moved1
            (try
              (tc-move-check-expr
                ctx
                expr-bases
                env
                (tc-global-shared-view locals)
                ;; Returning cannot reach a loop backedge, even when generated
                ;; scopes hide this node from the loop-aware outer walker.
                (tc-moved-empty)
                moved
                (tc-global-shared-view inner)))]
          [moved2
            (try
              (match (tc-current-return-type env)
                [(Ok return-ty)
                  (tc-move-after-consuming-value
                    ctx
                    expr-bases
                    env
                    (tc-global-shared-view locals)
                    (tc-moved-empty)
                    moved1
                    (tc-global-shared-view inner)
                    return-ty)]
                [(Err _) (TcMoveResult.Ok moved1)]))]
          (tc-move-check-obligations-exit
            expr-bases
            (tc-global-shared-view locals)
            -1
            (tc-move-discharge-direct ctx expr-bases locals moved2 inner-box)
            (tc-global-shared-view expr)
            "before this return")))]
    ;; Its moved set is the break state of the loop it leaves; the loop walker
    ;; collects it when the `break` sits inside a form it has no arm for.
    [(Break)
      (tc-body-early-exit-note! (tc-context-body-state ctx))
      (let
        [moved1
          (try
            (tc-move-check-obligations-exit
              expr-bases
              (tc-global-shared-view locals)
              (tc-move-loop-depth locals)
              moved
              (tc-global-shared-view expr)
              "before this break leaves its loop"))]
        (tc-body-move-loop-exit-note!
          (tc-context-body-state ctx)
          (& moved1)
          true)
        (Ok moved1))]
    [(Continue)
      (tc-body-early-exit-note! (tc-context-body-state ctx))
      (tc-body-move-loop-exit-note! (tc-context-body-state ctx) (& moved) false)
      (tc-move-check-obligations-exit
        expr-bases
        (tc-global-shared-view locals)
        (tc-move-loop-depth locals)
        moved
        (tc-global-shared-view expr)
        "before this continue leaves its loop iteration")]
    [(PtrAddrOf place-box)
      (let
        [place : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases place-box)]
        (tc-move-check-ptr-addr-of-place
          ctx
          expr-bases
          env
          locals
          loop-carried
          moved
          place
          expr))]
    [(PtrWrite ptr-box value-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [moved1
          (try
            (tc-move-check-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view loop-carried)
              moved
              ptr))]
        (tc-move-check-expr ctx expr-bases env locals loop-carried moved1 value))]
    [(PtrOffset ptr-box offset-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [offset : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases offset-box)]
        [moved1
          (try
            (tc-move-check-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view loop-carried)
              moved
              ptr))]
        (tc-move-check-expr
          ctx
          expr-bases
          env
          locals
          loop-carried
          moved1
          offset))]
    [(StringFromBytes ptr-box len-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [len : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases len-box)]
        [moved1
          (try
            (tc-move-check-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view loop-carried)
              moved
              ptr))]
        (tc-move-check-expr ctx expr-bases env locals loop-carried moved1 len))]
    [(or (CpuIdEax leaf-box subleaf-box) (CpuIdEbx leaf-box subleaf-box)
         (CpuIdEcx leaf-box subleaf-box) (CpuIdEdx leaf-box subleaf-box))
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        [moved1
          (try
            (tc-move-check-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view loop-carried)
              moved
              leaf))]
        (tc-move-check-expr
          ctx
          expr-bases
          env
          locals
          loop-carried
          moved1
          subleaf))]
    [(Xgetbv index-box)
      (let
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (tc-move-check-expr ctx expr-bases env locals loop-carried moved index))]
    ;; A foreach-active body runs once per active lane, so it is a loop body:
    ;; a value moved in it must not be one the next lane still needs.
    [(ForeachActive lane body-box)
      (let
        [body-loop-carried : TcMovedSet
          (tc-moved-union locals (tc-moved-clone loop-carried))]
        (match (tc-move-check-loop-body
          ctx
          expr-bases
          (tc-bind-id env lane (I64))
          (tc-moved-add (tc-move-enter-loop-body (tc-moved-clone locals)) lane)
          (tc-moved-remove-root-state body-loop-carried lane)
          (tc-moved-remove-root-state loop-carried lane)
          (tc-moved-clone moved)
          (ast.ast-expr-segment-bases-get expr-bases body-box))
          [(Ok _ _ breaks? break-moved-box)
            (if breaks?
              (tc-move-join-loop-exit
                expr-bases
                locals
                moved
                (tc-moved-set-box-shared-view break-moved-box)
                (ast.ast-expr-segment-bases-get expr-bases body-box))
              (Ok moved))]
          [(Err message) (Err message)]))]
    [(LaneValue value-box)
      (tc-move-check-expr
        ctx
        expr-bases
        env
        locals
        loop-carried
        moved
        (ast.ast-expr-segment-bases-get expr-bases value-box))]))

(define (tc-move-check-place-borrow
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [mutable : bool]
  [inner-box : i64]
  [inner : ast.AstExpr]) : TcMoveResult
  (let
    [_
      (try
        (if mutable
          (tc-move-foreign-global-place-check
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            inner-box
            "mutably borrow")
          ResultTcUnit.Ok))]
    (if mutable
      (let
        [_
          (tc-param-storage-note-write
            ctx
            expr-bases
            env
            (tc-global-shared-view moved)
            (tc-global-shared-view inner))]
        [_
          (tc-move-note-mut-borrow-root
            ctx
            expr-bases
            env
            (tc-global-shared-view inner))]
        (tc-move-check-borrow-place
          ctx
          expr-bases
          env
          locals
          loop-carried
          moved
          inner))
      (tc-move-check-borrow-place
        ctx
        expr-bases
        env
        locals
        loop-carried
        moved
        inner))))

;; A borrowed temporary (section 3.10) consumes its operand's value into hidden
;; storage, like a by-value argument of the operand's type; the borrow itself
;; moves nothing. Typecheck admits one only as a direct call argument.
(define (tc-move-check-temporary-borrow-operand
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [operand-box : i64]) : TcMoveResult
  (let
    [operand : ast.AstExpr
      (ast.ast-expr-segment-bases-get expr-bases operand-box)]
    [operand-ty : ast.AstType
      (match (tc-body-type-fact-expr-id
        "move.call_arg_temporary"
        ctx
        env
        operand-box)
        [(ResultTcType.Ok ty) ty]
        [(ResultTcType.Err _) (ast.AstType.Unit)])]
    [operand-moved
      (try
        (tc-move-check-expr
          ctx
          expr-bases
          env
          (tc-global-shared-view locals)
          (tc-global-shared-view loop-carried)
          moved
          (tc-global-shared-view operand)))]
    (tc-move-after-consuming-value
      ctx
      expr-bases
      env
      (tc-global-shared-view locals)
      (tc-global-shared-view loop-carried)
      operand-moved
      operand
      operand-ty)))

;; The move walk of a function body or global initializer. When it reached a
;; `break` or `continue` nested in an operand, it runs again with operand-aware
;; loop flow summaries (#8575); an error from the first walk stands, since
;; those summaries only add edges.
(define (tc-move-check-body-walk
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [params : (& params ast.AstParamList)]
  [expr-id : i64]) : TcMoveResult
  (let
    [state : TcBodyState (tc-context-body-state ctx)]
    [outer-control : bool (tc-body-move-operand-control? state)]
    [_ (tc-body-move-operand-control-set! state false)]
    [first : TcMoveResult
      (tc-move-check-expr-id
        ctx
        expr-bases
        env
        (tc-global-shared-view locals)
        (tc-moved-empty)
        (tc-param-storage-seed-params ctx env params (tc-moved-empty))
        expr-id)]
    [retry? : bool
      (and
        (tc-body-move-operand-control? state)
        (not (tc-body-move-operand-edges? state))
        (match (tc-global-shared-view first)
          [(Ok _) true]
          [(Err _) false]))]
    (tc-body-move-operand-control-set! state outer-control)
    (if retry?
      (let
        [_ (tc-body-move-operand-edges-set! state true)]
        [result : TcMoveResult
          (tc-move-check-expr-id
            ctx
            expr-bases
            env
            locals
            (tc-moved-empty)
            (tc-param-storage-seed-params ctx env params (tc-moved-empty))
            expr-id)]
        (tc-body-move-operand-edges-set! state false)
        result)
      first)))

(define (tc-move-check-body-id
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [params : (& params ast.AstParamList)]
  [body-id : i64]
  [return-ty : ast.AstType]) : ResultTcUnit
  (let
    [locals : TcMovedSet (tc-move-params-locals params (tc-moved-empty))]
    [body : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases body-id)]
    [state : TcBodyState (tc-context-body-state ctx)]
    [writes-mark : i64 (tc-body-param-writes-mark state)]
    [moved
      (try
        (tc-move-check-body-walk
          ctx
          expr-bases
          env
          (tc-global-shared-view locals)
          params
          body-id))]
    ;; The written parameters of this body (its lambdas recorded their own);
    ;; the noted names are not needed past this function.
    [_
      (begin
        (tc-body-param-write-fact-record! state body-id writes-mark params)
        (tc-body-param-writes-truncate! state writes-mark))]
    [_
      (try
        (match (tc-move-check-invalidate-body-end
          ctx
          expr-bases
          (tc-global-shared-view locals)
          (tc-global-shared-view moved)
          body-id)
          [(Ok)
            (tc-move-check-global-result
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              moved
              (tc-global-shared-view body)
              return-ty)]
          [(Err message) (TcMoveResult.Err message)]))]
    (let
      [_
        (try (tc-move-check-tail-closure-escape ctx expr-bases env locals body))]
      Ok)))

(define (tc-move-check-global-initializer-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]
  [target-ty : ast.AstType]) : ResultTcUnit
  (let
    [empty : TcMovedSet (tc-moved-empty)]
    [no-params : ast.AstParamList (ast.ast-param-list-new)]
    [expr-bases : i64 (tc-context-expr-bases ctx)]
    [expr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases expr-id)]
    [moved
      (try
        (tc-move-check-body-walk
          ctx
          expr-bases
          env
          (tc-global-shared-view empty)
          (& no-params)
          expr-id))]
    [_
      (try
        (tc-move-check-global-result
          ctx
          expr-bases
          env
          empty
          moved
          expr
          target-ty))]
    Ok))

(define (tc-move-add-resource-shadowed-names-at
  [shadowed : TcNameIdList]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [index : i64]) : TcNameIdList
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    shadowed
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(Binding name _ _ _)
        (tc-move-add-resource-shadowed-names-at
          (tc-name-id-list-add shadowed name)
          bindings
          (+ index 1))])))

(define (tc-move-add-resource-shadowed-names
  [shadowed : TcNameIdList]
  [bindings : ast.AstResourceBindingList]) : TcNameIdList
  (tc-move-add-resource-shadowed-names-at shadowed (& bindings) 0))

;; The consumption mode of an undecided walk at `expr`, which is unspanned: a
;; value form moves every local leaf (2); anywhere else the walk stays
;; undecided (-1). A consumer starts the walk undecided only when it moves a
;; place in its own position, which it does exactly for a move-only target, so
;; the value's type needs no second look here.
(define (tc-move-consume-mode [expr : ast.AstExpr]) : i64
  (match expr
    [(or (If _ _ _) (Let _) (Match _) (Begin _) (Unsafe _) (WithRegion _ _)
         (WithEscape _ _) (WithScratch _) (InArena _ _) (WithResource _))
      2]
    [_ -1]))

(define (tc-move-check-global-result-expr-list
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [shadowed : TcNameIdList]
  [moved : TcMovedSet]
  [exprs : ast.AstExprList]
  [result-ty : ast.AstType]
  [consume : i64]) : TcMoveResult
  (let
    [count : i64 (ast.ast-expr-list-len (& exprs))]
    (if (= count 0)
      (Ok moved)
      (tc-move-check-global-result-expr-id
        ctx
        expr-bases
        env
        locals
        loop-carried
        shadowed
        moved
        (ast.ast-expr-list-get (& exprs) (- count 1) 0)
        result-ty
        consume))))

(define (tc-move-check-global-result-match-arms-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [shadowed : TcNameIdList]
  [moved : TcMovedSet]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]
  [result-ty : ast.AstType]
  [consume : i64]) : TcMoveResult
  (if (>= index arms.len)
    (Ok moved)
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (let
          [moved1
            (try
              (tc-move-check-global-result-expr-id
                ctx
                expr-bases
                env
                (tc-global-shared-view locals)
                (tc-global-shared-view loop-carried)
                (tc-pattern-add-bound-name-ids pattern shadowed)
                moved
                body-box
                (tc-global-shared-view result-ty)
                consume))]
          (tc-move-check-global-result-match-arms-at
            ctx
            expr-bases
            env
            locals
            loop-carried
            shadowed
            moved1
            arms
            (+ index 1)
            result-ty
            consume))])))

(define (tc-move-check-global-result-expr-id
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [shadowed : TcNameIdList]
  [moved : TcMovedSet]
  [expr-id : i64]
  [result-ty : ast.AstType]
  [consume : i64]) : TcMoveResult
  (tc-move-check-global-result-expr
    ctx
    expr-bases
    env
    locals
    loop-carried
    shadowed
    moved
    (ast.ast-expr-segment-bases-get expr-bases expr-id)
    result-ty
    consume))

;; Ownership-transfer sites see the value-producing leaves of control-flow and
;; scoped expressions, not merely the outer AST node. Keep lexical binders in a
;; lightweight shadow spine while descending so a local that shadows a global
;; is never misclassified as that permanent global place. This deliberately
;; avoids cloning the full move-state maps at every result branch. A leaf that
;; names an unshadowed local place is also moved, as the consumer would move it
;; in its own position (#8268, #8269): `consume` 2 moves every such leaf, 0 none,
;; 1 only a leaf naming a tracked arena owner (a store of a Copy value, which
;; must still move the owner; a call argument walks with 0 and borrows it), and
;; -1 is decided by `tc-move-consume-mode` at the first value form. The operand
;; of a nested `return` or `try` is consumed by that form instead.
(define (tc-move-check-global-result-expr
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [shadowed : TcNameIdList]
  [moved : TcMovedSet]
  [expr : ast.AstExpr]
  [result-ty : ast.AstType]
  [consume : i64]) : TcMoveResult
  (tc-move-check-global-result-expr-unspanned
    ctx
    expr-bases
    env
    locals
    loop-carried
    shadowed
    moved
    (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    expr
    result-ty
    consume))

(define (tc-move-check-global-result-expr-unspanned
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [shadowed : TcNameIdList]
  [moved : TcMovedSet]
  [expr : ast.AstExpr]
  [origin : ast.AstExpr]
  [result-ty : ast.AstType]
  [consume : i64]) : TcMoveResult
  (let
    [consume-here : i64
      (if (>= consume 0)
        consume
        (tc-move-consume-mode (tc-global-shared-view expr)))]
    (match (tc-global-shared-view expr)
      [(If _ then-box else-box)
        (let
          [moved1
            (try
              (tc-move-check-global-result-expr-id
                ctx
                expr-bases
                env
                (tc-global-shared-view locals)
                (tc-global-shared-view loop-carried)
                shadowed
                moved
                then-box
                (tc-global-shared-view result-ty)
                consume-here))]
          (tc-move-check-global-result-expr-id
            ctx
            expr-bases
            env
            locals
            loop-carried
            shadowed
            moved1
            else-box
            result-ty
            consume-here))]
      [(Let let-box)
        (match (__tl-box-place let-box)
          [(Let bindings body-box)
            (tc-move-check-global-result-expr-id
              ctx
              expr-bases
              env
              locals
              loop-carried
              (tc-let-binding-list-add-bound-name-ids bindings shadowed)
              moved
              body-box
              result-ty
              consume-here)])]
      [(Match match-box)
        (match (ast.ast-match-box-shared-view match-box)
          [(Match _ arms)
            (tc-move-check-global-result-match-arms-at
              ctx
              expr-bases
              env
              locals
              loop-carried
              shadowed
              moved
              (& arms)
              0
              result-ty
              consume-here)])]
      [(or (Begin exprs) (Unsafe exprs) (WithRegion _ exprs)
           (WithEscape _ exprs) (WithScratch exprs) (InArena _ exprs))
        (tc-move-check-global-result-expr-list
          ctx
          expr-bases
          env
          locals
          loop-carried
          shadowed
          moved
          exprs
          result-ty
          consume-here)]
      [(WithResource resource-box)
        (match (__tl-box-place resource-box)
          [(WithResource bindings body)
            (tc-move-check-global-result-expr-list
              ctx
              expr-bases
              env
              locals
              loop-carried
              (tc-move-add-resource-shadowed-names shadowed bindings)
              moved
              body
              result-ty
              consume-here)])]
      [(or (Ann inner-box _) (Cast inner-box _) (Comptime inner-box)
           (SpmdBroadcast inner-box _) (SpmdShuffle inner-box _)
           (LaneValue inner-box))
        (tc-move-check-global-result-expr-id
          ctx
          expr-bases
          env
          locals
          loop-carried
          shadowed
          moved
          inner-box
          result-ty
          consume-here)]
      [(or (Try inner-box) (Return inner-box))
        (tc-move-check-global-result-expr-id
          ctx
          expr-bases
          env
          locals
          loop-carried
          shadowed
          moved
          inner-box
          result-ty
          0)]
      [(SpmdReduce reduce-box)
        (match (__tl-box-place reduce-box)
          [(Reduce _ index _ _ _ _ value-box)
            (tc-move-check-global-result-expr-id
              ctx
              expr-bases
              env
              locals
              loop-carried
              (tc-name-id-list-add shadowed index)
              moved
              value-box
              result-ty
              consume-here)])]
      [(SpmdScan scan-box)
        (match (__tl-box-place scan-box)
          [(Scan _ index _ _ _ prefix _ _ value-box body-box)
            (let
              [value-shadowed : TcNameIdList
                (tc-name-id-list-add shadowed index)]
              [moved1
                (try
                  (tc-move-check-global-result-expr-id
                    ctx
                    expr-bases
                    env
                    (tc-global-shared-view locals)
                    (tc-global-shared-view loop-carried)
                    value-shadowed
                    moved
                    value-box
                    (tc-global-shared-view result-ty)
                    consume-here))]
              (tc-move-check-global-result-expr-id
                ctx
                expr-bases
                env
                locals
                loop-carried
                (tc-name-id-list-add value-shadowed prefix)
                moved1
                body-box
                result-ty
                consume-here))])]
      [(SpmdCompact compact-box)
        (match (__tl-box-place compact-box)
          [(Compact index _ _ _ slot _ _ keep-box body-box)
            (let
              [keep-shadowed : TcNameIdList
                (tc-name-id-list-add shadowed index)]
              [moved1
                (try
                  (tc-move-check-global-result-expr-id
                    ctx
                    expr-bases
                    env
                    (tc-global-shared-view locals)
                    (tc-global-shared-view loop-carried)
                    keep-shadowed
                    moved
                    keep-box
                    (tc-global-shared-view result-ty)
                    consume-here))]
              (tc-move-check-global-result-expr-id
                ctx
                expr-bases
                env
                locals
                loop-carried
                (tc-name-id-list-add keep-shadowed slot)
                moved1
                body-box
                result-ty
                consume-here))])]
      [_
        (match (tc-move-root-projection-var-id
          expr-bases
          (tc-global-shared-view expr))
          [(Some root-id)
            (if (tc-name-id-list-contains shadowed root-id)
              (Ok moved)
              (let
                [moved1
                  (try
                    (tc-move-check-global-source
                      ctx
                      expr-bases
                      env
                      (tc-global-shared-view locals)
                      moved
                      (tc-global-shared-view expr)
                      (tc-move-global-source-target-move-only?
                        ctx
                        expr-bases
                        env
                        (tc-global-shared-view locals)
                        (tc-global-shared-view expr)
                        (tc-global-shared-view result-ty)
                        (tc-global-shared-view result-ty))))]
                (if (or
                  (= consume-here 2)
                  (and
                    (= consume-here 1)
                    (tc-arena-type? ctx (tc-global-shared-view result-ty))
                    (tc-move-arena-owner-var?
                      expr-bases
                      env
                      (tc-global-shared-view expr))))
                  ;; `origin` keeps the leaf's span for move diagnostics.
                  (match (tc-move-after-consuming-projection
                    ctx
                    expr-bases
                    env
                    locals
                    loop-carried
                    moved1
                    (tc-global-shared-view origin))
                    [(Ok moved2) (Ok moved2)]
                    [(Err message)
                      (Err (tc-locate-error-at-expr expr-bases origin message))])
                  (Ok moved1))))]
          [(No) (Ok moved)])])))

(define (tc-move-check-result-expr-list
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : ast.AstExprList]
  [result-ty : ast.AstType]) : TcMoveResult
  (let
    [count : i64 (ast.ast-expr-list-len (& exprs))]
    (if (= count 0)
      (Ok moved)
      (tc-move-check-result-expr-id
        ctx
        expr-bases
        env
        locals
        loop-carried
        moved
        (ast.ast-expr-list-get (& exprs) (- count 1) 0)
        result-ty))))

;; Reconstruct only the lexical type/local closure facts needed to classify a
;; tail result. The ordinary move walk has already checked every initializer;
;; replaying those moves here would report them twice.
(define (tc-move-result-let-binding-facts-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [loop-carried : TcMovedSet]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : TcMoveBindings
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (Ok env moved locals loop-carried)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name maybe-ty init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [binding-ty : ast.AstType
            (tc-move-binding-type-id
              "move.result_let_init"
              ctx
              env
              maybe-ty
              init-box)]
          (tc-move-result-let-binding-facts-at
            ctx
            expr-bases
            (tc-bind-initialized-value-id
              ctx
              env
              name
              binding-ty
              (tc-global-shared-view init))
            (tc-move-add-local-binding ctx expr-bases env locals name init)
            moved
            loop-carried
            bindings
            (+ index 1)))])))

(define (tc-move-check-tail-closure-expr-list
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [exprs : ast.AstExprList]) : ResultTcUnit
  (let
    [count : i64 (ast.ast-expr-list-len (& exprs))]
    (if (= count 0)
      Ok
      (tc-move-check-tail-closure-escape
        ctx
        expr-bases
        env
        locals
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get (& exprs) (- count 1) 0))))))

(define (tc-move-check-tail-closure-match-arms-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [scrut-ty : ast.AstType]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : ResultTcUnit
  (if (>= index arms.len)
    Ok
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (let
          [arm-env
            (try
              (tc-bind-match-pattern
                ctx
                env
                (tc-global-shared-view scrut-ty)
                (tc-global-shared-view pattern)))]
          [bound : TcNameIdList
            (tc-borrow-check-pattern-bound-names
              ctx
              (tc-global-shared-view scrut-ty)
              pattern)]
          [_
            (try
              (tc-move-check-tail-closure-escape
                ctx
                expr-bases
                arm-env
                (tc-move-add-bound-names (tc-moved-clone locals) bound)
                (ast.ast-expr-segment-bases-get expr-bases body-box)))]
          (tc-move-check-tail-closure-match-arms-at
            ctx
            expr-bases
            env
            locals
            scrut-ty
            arms
            (+ index 1)))])))

(define (tc-move-check-tail-closure-escape
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(If _ then-box else-box)
      (let
        [_
          (try
            (tc-move-check-tail-closure-escape
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (ast.ast-expr-segment-bases-get expr-bases then-box)))]
        (tc-move-check-tail-closure-escape
          ctx
          expr-bases
          env
          locals
          (ast.ast-expr-segment-bases-get expr-bases else-box)))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (match (tc-move-result-let-binding-facts-at
            ctx
            expr-bases
            env
            locals
            (tc-moved-empty)
            (tc-moved-empty)
            (& bindings)
            0)
            [(Ok env2 _ locals2 _)
              (tc-move-check-tail-closure-escape
                ctx
                expr-bases
                env2
                locals2
                (ast.ast-expr-segment-bases-get expr-bases body-box))]
            [(Err message) (Err message)])])]
    [(Match match-box)
      (match (ast.ast-match-box-shared-view match-box)
        [(Match scrut-box arms)
          (match (tc-body-type-fact-expr-id
            "move.result_closure_scrutinee"
            ctx
            env
            scrut-box)
            [(Ok scrut-ty)
              (tc-move-check-tail-closure-match-arms-at
                ctx
                expr-bases
                env
                locals
                scrut-ty
                (& arms)
                0)]
            [(Err _) Ok])])]
    [(or (Begin exprs) (Unsafe exprs) (WithRegion _ exprs) (WithEscape _ exprs)
         (WithScratch exprs) (InArena _ exprs))
      (tc-move-check-tail-closure-expr-list ctx expr-bases env locals exprs)]
    [(WithResource resource-box)
      (match (__tl-box-place resource-box)
        [(WithResource _ body)
          (tc-move-check-tail-closure-expr-list ctx expr-bases env locals body)])]
    [(or (Ann inner-box _) (Cast inner-box _) (Try inner-box)
         (Return inner-box))
      (tc-move-check-tail-closure-escape
        ctx
        expr-bases
        env
        locals
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [_
      (if (tc-move-value-concrete-closure-move-only?
        ctx
        expr-bases
        env
        locals
        (tc-global-shared-view expr))
        (Err
          (tc-locate-error-at-expr
            expr-bases
            expr
            (tc-move-closure-escape-message)))
        Ok)]))

(define (tc-move-check-result-match-arms-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]
  [result-ty : ast.AstType]
  [joined : TcMovedSet]) : TcMoveResult
  (if (>= index arms.len)
    (Ok joined)
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm _ body-box)
        (let
          [arm-moved
            (try
              (tc-move-check-result-expr-id
                ctx
                expr-bases
                env
                (tc-moved-clone locals)
                (tc-moved-clone loop-carried)
                (tc-moved-clone moved)
                body-box
                (tc-global-shared-view result-ty)))]
          (tc-move-check-result-match-arms-at
            ctx
            expr-bases
            env
            locals
            loop-carried
            moved
            arms
            (+ index 1)
            result-ty
            (tc-moved-union joined arm-moved)))])))

(define (tc-move-check-result-expr-id
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr-id : i64]
  [result-ty : ast.AstType]) : TcMoveResult
  (tc-move-check-result-expr
    ctx
    expr-bases
    env
    locals
    loop-carried
    moved
    (ast.ast-expr-segment-bases-get expr-bases expr-id)
    result-ty))

(define (tc-move-check-result-expr
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : ast.AstExpr]
  [result-ty : ast.AstType]) : TcMoveResult
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(If _ then-box else-box)
      (let
        [then-moved
          (try
            (tc-move-check-result-expr-id
              ctx
              expr-bases
              env
              (tc-moved-clone locals)
              (tc-moved-clone loop-carried)
              (tc-moved-clone moved)
              then-box
              (tc-global-shared-view result-ty)))]
        [else-moved : TcMovedSet
          (try
            (tc-move-check-result-expr-id
              ctx
              expr-bases
              env
              (tc-moved-clone locals)
              (tc-moved-clone loop-carried)
              (tc-moved-clone moved)
              else-box
              result-ty))]
        (Ok (tc-moved-union then-moved else-moved)))]
    [(Let let-box)
      (match (ast.ast-let-box-shared-view let-box)
        [(Let bindings body-box)
          (match (tc-move-result-let-binding-facts-at
            ctx
            expr-bases
            env
            locals
            moved
            loop-carried
            (& bindings)
            0)
            [(Ok env2 moved2 locals2 loop-carried2)
              (tc-move-check-result-expr-id
                ctx
                expr-bases
                env2
                locals2
                loop-carried2
                moved2
                body-box
                result-ty)]
            [(Err message) (Err message)])])]
    [(or (Begin exprs) (Unsafe exprs) (WithRegion _ exprs) (WithEscape _ exprs)
         (WithScratch exprs) (InArena _ exprs))
      (tc-move-check-result-expr-list
        ctx
        expr-bases
        env
        locals
        loop-carried
        moved
        exprs
        result-ty)]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match _ arms)
          (tc-move-check-result-match-arms-at
            ctx
            expr-bases
            env
            locals
            loop-carried
            (tc-global-shared-view moved)
            (& arms)
            0
            result-ty
            moved)])]
    [(or (Ann inner-box _) (Cast inner-box _) (Try inner-box))
      (tc-move-check-result-expr-id
        ctx
        expr-bases
        env
        locals
        loop-carried
        moved
        inner-box
        result-ty)]
    [_
      (tc-move-after-move-only-value
        ctx
        expr-bases
        env
        locals
        loop-carried
        moved
        (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
        result-ty)]))

;; Checker-only closure facts never enter AstType or the lowering ABI. Call
;; capabilities are 0 = shared/reusable, 1 = exclusive/reusable (FnMut), and
;; 2 = consuming (FnOnce). A local lambda binding stores that capability in a
;; disjoint Copy/non-Copy range inside the existing locals map; ordinary locals
;; keep the -1 sentinel. This keeps concrete environment
;; copyability available after a fact-preserving local alias without making a
;; plain `(-> ...)` type depend on one particular lambda value.
(define (tc-closure-call-capability-shared) : i64
  0)

(define (tc-closure-call-capability-mut) : i64
  1)

(define (tc-closure-call-capability-once) : i64
  2)

(define (tc-closure-local-fact-copy-base) : i64
  16)

(define (tc-closure-local-fact-move-base) : i64
  32)

(define (tc-closure-local-fact-code? [code : i64]) : bool
  (or
    (and
      (>= code (tc-closure-local-fact-copy-base))
      (<= code (+ (tc-closure-local-fact-copy-base) 2)))
    (and
      (>= code (tc-closure-local-fact-move-base))
      (<= code (+ (tc-closure-local-fact-move-base) 2)))))

(define (tc-closure-local-fact-code [locals : TcMovedSet] [name-id : i64]) : i64
  (let
    [roots : tc_i64_i64_map.Map (tc-moved-roots locals)]
    (match (tc_i64_i64_map.get (& roots) name-id)
      [(LookupFound code)
        (if (tc-closure-local-fact-code? code)
          code
          -1)]
      [(LookupMissing) -1])))

(define (tc-closure-local-fact-copyable-code? [code : i64]) : bool
  (and
    (>= code (tc-closure-local-fact-copy-base))
    (<= code (+ (tc-closure-local-fact-copy-base) 2))))

(define (tc-closure-local-fact-move-only-code? [code : i64]) : bool
  (and
    (>= code (tc-closure-local-fact-move-base))
    (<= code (+ (tc-closure-local-fact-move-base) 2))))

(define (tc-closure-local-fact-encode [copyable : bool] [capability : i64]) : i64
  (+
    (if copyable
      (tc-closure-local-fact-copy-base)
      (tc-closure-local-fact-move-base))
    capability))

(define (tc-closure-local-fact-capability [code : i64]) : i64
  (if (tc-closure-local-fact-copyable-code? code)
    (- code (tc-closure-local-fact-copy-base))
    (if (tc-closure-local-fact-move-only-code? code)
      (- code (tc-closure-local-fact-move-base))
      (tc-closure-call-capability-shared))))

(define (tc-move-local-or-type-move-only?
  [ctx : TcContext]
  [locals : TcMovedSet]
  [name-id : i64]
  [ty : ast.AstType]) : bool
  (let
    [code : i64 (tc-closure-local-fact-code locals name-id)]
    (if (tc-closure-local-fact-code? code)
      (tc-closure-local-fact-move-only-code? code)
      (tc-type-move-only? ctx ty))))

(define (tc-move-add-capture-local
  [source-locals : TcMovedSet]
  [capture-locals : TcMovedSet]
  [name-id : i64]) : TcMovedSet
  (let
    [code : i64 (tc-closure-local-fact-code source-locals name-id)]
    (if (tc-closure-local-fact-code? code)
      (tc-moved-add-value capture-locals name-id code)
      (tc-moved-add capture-locals name-id))))

(define (tc-lambda-capture-locals-scan
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [body : ast.AstExpr]
  [seen : TcStringList]
  [source-locals : TcMovedSet]
  [locals : TcMovedSet]) : TcMovedSet
  (match (tc-type-env-marker-step env)
    [(Done) locals]
    [(Cache rest-env)
      (tc-lambda-capture-locals-scan
        expr-bases
        rest-env
        bound
        body
        seen
        source-locals
        locals)]
    [(Bind key ty rest-env)
      (let
        [name : String (tc-env-key-name-text key)]
        (cond
          [(= key (tc-default-boundary-id)) locals]
          [(or
              (= key (tc-region-marker-id))
              (tc-cleanup-owner-marker-entry? key ty)
              (tc-ordinary-arena-owner-marker-entry?
                key
                (tc-global-shared-view ty))
              (tc-atomic-arena-owner-marker-entry? key ty)
              (tc-string-list-contains
                (tc-global-shared-view seen)
                (tc-global-shared-view name)))
            (tc-lambda-capture-locals-scan
              expr-bases
              rest-env
              bound
              body
              seen
              source-locals
              locals)]
          [else
            (tc-lambda-capture-locals-scan
              expr-bases
              rest-env
              (tc-global-shared-view bound)
              (tc-global-shared-view body)
              (tc-string-list-add seen (tc-global-shared-view name))
              (tc-global-shared-view source-locals)
              (if (tc-expr-uses-free-name? expr-bases body name bound)
                (tc-move-add-capture-local source-locals locals key)
                locals))]))]))

(define (tc-lambda-capture-locals
  [expr-bases : i64]
  [env : TcTypeEnv]
  [source-locals : TcMovedSet]
  [params : ast.AstParamList]
  [body : ast.AstExpr]) : TcMovedSet
  (tc-lambda-capture-locals-scan
    expr-bases
    (tc-type-env-marker-start env)
    (tc-param-bound-names params)
    body
    Nil
    source-locals
    (tc-moved-empty)))

;; What a captured-binding scan asks of each binding a lambda body names: does
;; its type hold a mutable reference, is it move-only (as a local fact or by
;; type), or is it move-only and already moved.
(defenum TcCaptureQuery
  (MutReference)
  (MoveOnly TcMovedSet)
  (Consumed TcMovedSet TcMovedSet))

(define (tc-capture-query-matches?
  [ctx : TcContext]
  [query : TcCaptureQuery]
  [key : i64]
  [ty : ast.AstType]) : bool
  (match query
    [(MutReference) (tc-type-contains-mut-reference? ty)]
    [(MoveOnly locals) (tc-move-local-or-type-move-only? ctx locals key ty)]
    [(Consumed locals moved)
      (and
        (tc-move-local-or-type-move-only? ctx locals key ty)
        (match (tc-moved-root-conflict moved key)
          [(Some _ _) true]
          [No false]))]))

;; Whether some binding the lambda captures answers `query`. Bindings are
;; visited innermost first up to the default boundary; a shadowed binding is
;; skipped.
(define (tc-lambda-capture-scan?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [body : ast.AstExpr]
  [query : TcCaptureQuery]
  [seen : TcStringList]) : bool
  (match (tc-type-env-marker-step env)
    [(Done) false]
    [(Cache rest-env)
      (tc-lambda-capture-scan? ctx expr-bases rest-env bound body query seen)]
    [(Bind key ty rest-env)
      (let
        [name : String (tc-env-key-name-text key)]
        (cond
          [(= key (tc-default-boundary-id)) false]
          [(or
              (= key (tc-region-marker-id))
              (tc-cleanup-owner-marker-entry? key ty)
              (tc-ordinary-arena-owner-marker-entry?
                key
                (tc-global-shared-view ty))
              (tc-atomic-arena-owner-marker-entry?
                key
                (tc-global-shared-view ty))
              (tc-string-list-contains
                (tc-global-shared-view seen)
                (tc-global-shared-view name)))
            (tc-lambda-capture-scan?
              ctx
              expr-bases
              rest-env
              bound
              body
              query
              seen)]
          [(and
              (tc-expr-uses-free-name?
                expr-bases
                (tc-global-shared-view body)
                (tc-global-shared-view name)
                (tc-global-shared-view bound))
              (tc-capture-query-matches?
                ctx
                (tc-global-shared-view query)
                key
                ty))
            true]
          [else
            (tc-lambda-capture-scan?
              ctx
              expr-bases
              rest-env
              bound
              body
              query
              (tc-string-list-add seen name))]))]))

(define (tc-lambda-capture-has-mut-reference?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [params : ast.AstParamList]
  [body : ast.AstExpr]) : bool
  (tc-lambda-capture-scan?
    ctx
    expr-bases
    (tc-type-env-marker-start env)
    (tc-param-bound-names params)
    body
    MutReference
    Nil))

(define (tc-lambda-capture-has-move-only-with-locals?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [params : ast.AstParamList]
  [body : ast.AstExpr]) : bool
  (tc-lambda-capture-scan?
    ctx
    expr-bases
    (tc-type-env-marker-start env)
    (tc-param-bound-names params)
    body
    (MoveOnly locals)
    Nil))

(define (tc-lambda-capture-has-move-only?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [params : ast.AstParamList]
  [body : ast.AstExpr]) : bool
  (tc-lambda-capture-has-move-only-with-locals?
    ctx
    expr-bases
    env
    (tc-moved-empty)
    params
    body))

(define (tc-move-value-concrete-closure-move-only?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(Var name-id)
      (tc-closure-local-fact-move-only-code?
        (tc-closure-local-fact-code locals name-id))]
    [(Lambda lambda-box)
      (match (ast.ast-lambda-box-shared-view lambda-box)
        [(Lambda params _ body-box)
          (tc-lambda-capture-has-move-only-with-locals?
            ctx
            expr-bases
            env
            locals
            params
            (ast.ast-expr-segment-bases-get expr-bases body-box))])]
    [_ false]))

(define (tc-move-value-move-only?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [expr : ast.AstExpr]
  [fallback-ty : ast.AstType]) : bool
  (or
    (tc-move-value-concrete-closure-move-only? ctx expr-bases env locals expr)
    (tc-type-move-only? ctx fallback-ty)))

(define (tc-lambda-call-capability-fallback-with-locals
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [params : ast.AstParamList]
  [body : ast.AstExpr]) : i64
  (if (tc-lambda-capture-has-move-only-with-locals?
    ctx
    expr-bases
    env
    locals
    (tc-global-shared-view params)
    (tc-global-shared-view body))
    (tc-closure-call-capability-once)
    (if (tc-lambda-capture-has-mut-reference? ctx expr-bases env params body)
      (tc-closure-call-capability-mut)
      (tc-closure-call-capability-shared))))

(define (tc-lambda-call-capability-with-locals
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [params : ast.AstParamList]
  [body-id : i64]) : i64
  (let
    [expr-bases : i64 (tc-context-expr-bases ctx)]
    [body : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases body-id)]
    [capture-locals : TcMovedSet
      (tc-lambda-capture-locals
        expr-bases
        env
        (tc-global-shared-view locals)
        (tc-global-shared-view params)
        (tc-global-shared-view body))]
    [lambda-env : TcTypeEnv (tc-bind-params ctx env params)]
    [lambda-locals : TcMovedSet (tc-move-params-locals params capture-locals)]
    (match (tc-move-check-expr-id
      ctx
      expr-bases
      lambda-env
      (tc-global-shared-view lambda-locals)
      (tc-moved-empty)
      (tc-moved-empty)
      body-id)
      [(Ok body-moved)
        (match (tc-expr-id ctx lambda-env body-id)
          [(Ok body-ty)
            (match (tc-move-check-result-expr
              ctx
              expr-bases
              lambda-env
              (tc-global-shared-view lambda-locals)
              (tc-moved-empty)
              body-moved
              (tc-global-shared-view body)
              body-ty)
              [(Ok final-moved)
                (if (tc-lambda-capture-scan?
                  ctx
                  expr-bases
                  (tc-type-env-marker-start env)
                  (tc-param-bound-names (tc-global-shared-view params))
                  (tc-global-shared-view body)
                  (Consumed lambda-locals final-moved)
                  Nil)
                  (tc-closure-call-capability-once)
                  (if (tc-lambda-capture-has-mut-reference?
                    ctx
                    expr-bases
                    env
                    params
                    body)
                    (tc-closure-call-capability-mut)
                    (tc-closure-call-capability-shared)))]
              [(Err _)
                (tc-lambda-call-capability-fallback-with-locals
                  ctx
                  expr-bases
                  env
                  locals
                  params
                  body)])]
          [(Err _)
            (tc-lambda-call-capability-fallback-with-locals
              ctx
              expr-bases
              env
              locals
              params
              body)])]
      [(Err _)
        (tc-lambda-call-capability-fallback-with-locals
          ctx
          expr-bases
          env
          locals
          params
          body)])))

(define (tc-lambda-call-capability
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : ast.AstParamList]
  [body-id : i64]) : i64
  (tc-lambda-call-capability-with-locals
    ctx
    env
    (tc-moved-empty)
    params
    body-id))

(define (tc-lambda-init-local-fact-code
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [init : ast.AstExpr]) : i64
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& init))
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda params _ body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [state : TcBodyState (tc-context-body-state ctx)]
            [cached : i64 (tc-body-closure-fact-code state body-box)]
            (if (tc-closure-local-fact-code? cached)
              cached
              (let
                [copyable : bool
                  (not
                    (tc-lambda-capture-has-move-only-with-locals?
                      ctx
                      expr-bases
                      env
                      (tc-global-shared-view locals)
                      (tc-global-shared-view params)
                      body))]
                [capability : i64
                  (tc-lambda-call-capability-with-locals
                    ctx
                    env
                    locals
                    params
                    body-box)]
                [code : i64 (tc-closure-local-fact-encode copyable capability)]
                (tc-body-closure-fact-record! state body-box code)
                code)))])]
    [_
      (match (tc-move-bare-var expr-bases init)
        [(Some name-id _) (tc-closure-local-fact-code locals name-id)]
        [(No) -1])]))

(define (tc-move-check-closure-assignment-facts
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [target-id : i64]
  [rhs : ast.AstExpr]) : ResultTcUnit
  (let
    [target-code : i64
      (tc-closure-local-fact-code (tc-global-shared-view locals) target-id)]
    [rhs-code : i64
      (tc-lambda-init-local-fact-code
        ctx
        expr-bases
        env
        locals
        (tc-global-shared-view rhs))]
    (if (or
      (tc-closure-local-fact-move-only-code? rhs-code)
      (and
        (tc-closure-local-fact-code? target-code)
        (tc-closure-local-fact-code? rhs-code)
        (not (= target-code rhs-code))))
      (Err
        (tc-locate-error-at-expr
          expr-bases
          rhs
          (tc-move-closure-escape-message)))
      Ok)))

;; --- lexical borrow conflict checker ---------------------------------------
;;
;; Borrows are lexical in this model: `begin` keeps borrows live, while
;; `let`, `with-arena`, resource `with`, lambdas, and individual match arms
;; bound their own borrow additions. Move and borrow facts share structural paths,
;; so whole roots, fields, tuple elements, and fixed-array literal elements use
;; the same ancestor/descendant conflict policy. Mutable borrows add shared and
;; exclusive facts for one path, allowing many immutable borrows but only one
;; exclusive mutable borrow.
(defenum TcBorrowCheckResult
  (Ok TcMovedSet)
  (Err String))

;; Borrow states are retained separately for ordinary continuation, the loop
;; backedge, and `break`; function exits have no successor in the current body.
(defenum TcBorrowLoopResult
  (Ok bool (Box TcMovedSet) bool (Box TcMovedSet) bool (Box TcMovedSet))
  (Err String))

(defenum TcBorrowCheckBindings
  (Ok TcTypeEnv TcMovedSet TcMovedSet)
  (Err String))

(defenum TcBorrowCheckResourceBindings
  (Ok TcTypeEnv TcMovedSet TcMovedSet)
  (Err String))

(defenum TcBorrowConflictOrigin
  (No)
  (Some i64))

(define (tc-borrow-check-move-message [path : String]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (BorrowViolation))
    "typecheck: cannot move borrowed place `"
    path
    "`"))

(define (tc-borrow-check-assign-message [path : String]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (BorrowViolation))
    "typecheck: cannot assign to borrowed place `"
    path
    "`"))

(define (tc-borrow-check-mutably-borrow-message [path : String]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (BorrowViolation))
    "typecheck: cannot mutably borrow borrowed place `"
    path
    "`"))

(define (tc-borrow-check-immutably-borrow-message [path : String]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (BorrowViolation))
    "typecheck: cannot immutably borrow mutably borrowed place `"
    path
    "`"))

(define (tc-borrow-check-read-message [path : String]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (BorrowViolation))
    "typecheck: cannot read mutably borrowed place `"
    path
    "`"))

(define (tc-borrow-check-help) : String
  "let the last reference use occur before this operation, shorten the borrow with a narrower lexical scope, clone the owner before borrowing when ownership must move later, or use an immutable borrow for non-mutating access")

(define (tc-borrow-check-origin-label [path : String]) : String
  (str_cat.str-cat
    "borrow of `"
    path
    "` remains live because a later reference use may still depend on it"))

(define (tc-borrow-check-conflict-origin
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [kind : TcMovedPathKind]) : TcBorrowConflictOrigin
  (match (tc-moved-path-conflict-kind borrowed path kind)
    [(Some _ origin-id) (Some origin-id)]
    [No No]))

(define (tc-borrow-check-rich-conflict-message
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [conflict-path : TcMovePath]
  [conflict-kind : TcMovedPathKind]
  [primary : ast.AstExpr]
  [message : String]) : String
  (match (tc-expr-maybe-span expr-bases primary)
    [(Some primary-span)
      (match (tc-borrow-check-conflict-origin
        borrowed
        conflict-path
        conflict-kind)
        [(Some origin-id)
          (match (tc-expr-maybe-span
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases origin-id))
            [(Some origin-span)
              (tc-rich-error-one-secondary
                primary-span
                message
                (tc-borrow-check-help)
                origin-span
                (tc-borrow-check-origin-label
                  (tc-move-path-render conflict-path)))]
            [(No)
              (tc-rich-error-one-secondary
                primary-span
                message
                (tc-borrow-check-help)
                primary-span
                (tc-borrow-check-origin-label
                  (tc-move-path-render conflict-path)))])]
        [(No)
          (tc-rich-error-one-secondary
            primary-span
            message
            (tc-borrow-check-help)
            primary-span
            (tc-borrow-check-origin-label (tc-move-path-render conflict-path)))])]
    [(No)
      (match (tc-borrow-check-conflict-origin
        borrowed
        conflict-path
        conflict-kind)
        [(Some origin-id)
          (match (tc-expr-maybe-span
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases origin-id))
            [(Some origin-span)
              (tc-rich-error-one-secondary
                origin-span
                message
                (tc-borrow-check-help)
                origin-span
                (tc-borrow-check-origin-label
                  (tc-move-path-render conflict-path)))]
            [(No) message])]
        [(No) message])]))

;; Lending borrows retain the ordinary place path for conflict checks and add
;; a non-conflicting marker that identifies the result binding for NLL pruning.
(define (tc-borrow-check-lending-binding-at
  [facts : TcMovedPathFacts]
  [path : TcMovePath]) : TcMaybeNameId
  (if (tc-moved-path-facts-empty? facts)
    (No)
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      (if (tc-move-path-eq? fact.path path)
        (match fact.kind
          [(BorrowLending binding-id) (Some binding-id)]
          [_ (tc-borrow-check-lending-binding-at rest path)])
        (tc-borrow-check-lending-binding-at rest path)))))

(define (tc-borrow-check-lending-binding
  [facts : TcMovedPathFacts]
  [path : TcMovePath]) : TcMaybeNameId
  (tc-borrow-check-lending-binding-at facts path))

(define (tc-borrow-check-lending-binding?
  [facts : TcMovedPathFacts]
  [path : TcMovePath]) : bool
  (match (tc-borrow-check-lending-binding facts path)
    [(Some _) true]
    [(No) false]))

(define (tc-borrow-check-has-lending-binding?
  [borrowed : TcMovedSet]
  [path : TcMovePath]) : bool
  (tc-borrow-check-lending-binding? (tc-moved-paths borrowed) path))

(define (tc-borrow-check-lending-binding-used-at?
  [facts : TcMovedPathFacts]
  [path : TcMovePath]
  [binding-id : i64]) : bool
  (if (tc-moved-path-facts-empty? facts)
    false
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      (if (and
        (tc-move-path-eq? fact.path path)
        (match fact.kind
          [(BorrowLendingUsed used-id) (= used-id binding-id)]
          [_ false]))
        true
        (tc-borrow-check-lending-binding-used-at? rest path binding-id)))))

(define (tc-borrow-check-note-lending-use-at
  [facts : TcMovedPathFacts]
  [binding-id : i64]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [out2 : TcMovedSet
        (match fact.kind
          [(BorrowLending fact-binding-id)
            (if (= fact-binding-id binding-id)
              (tc-moved-add-path-fact
                out
                fact.path
                (BorrowLendingUsed binding-id)
                (tc-moved-path-fact-origin fact))
              out)]
          [_ out])]
      (tc-borrow-check-note-lending-use-at rest binding-id out2))))

(define (tc-borrow-check-note-lending-use
  [borrowed : TcMovedSet]
  [binding-id : i64]) : TcMovedSet
  (tc-borrow-check-note-lending-use-at
    (tc-moved-paths (tc-global-shared-view borrowed))
    binding-id
    borrowed))

(define (tc-borrow-check-propagate-lending-uses-at
  [facts : TcMovedPathFacts]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [out2 : TcMovedSet
        (match fact.kind
          [(BorrowLendingUsed _)
            (let
              [path : TcMovePath fact.path]
              (match (tc-borrow-check-lending-binding
                (tc-moved-paths (tc-global-shared-view out))
                path)
                [(Some binding-id)
                  (tc-moved-add-path-fact
                    out
                    path
                    (BorrowLendingUsed binding-id)
                    (tc-moved-path-fact-origin fact))]
                [(No) out]))]
          [_ out])]
      (tc-borrow-check-propagate-lending-uses-at rest out2))))

(define (tc-borrow-check-propagate-lending-uses
  [from : TcMovedSet]
  [to : TcMovedSet]) : TcMovedSet
  (tc-borrow-check-propagate-lending-uses-at (tc-moved-paths from) to))

;; A directly called lambda is checked in its own borrow state, so free
;; reference reads in its body cannot update the enclosing lending markers by
;; ordinary state propagation. Record those captures at the call boundary;
;; unlike a stored closure, the direct call itself is the capture's use site.
(define (tc-borrow-check-note-called-lambda-capture-uses-at
  [expr-bases : i64]
  [body : ast.AstExpr]
  [bound : TcStringList]
  [facts : TcMovedPathFacts]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [out2 : TcMovedSet
        (match fact.kind
          [(BorrowLending binding-id)
            (if (tc-expr-uses-free-name?
              expr-bases
              (tc-global-shared-view body)
              (tc-env-key-name-text binding-id)
              (tc-global-shared-view bound))
              (tc-moved-add-path-fact
                out
                fact.path
                (BorrowLendingUsed binding-id)
                (tc-moved-path-fact-origin fact))
              out)]
          [_ out])]
      (tc-borrow-check-note-called-lambda-capture-uses-at
        expr-bases
        body
        bound
        rest
        out2))))

(define (tc-borrow-check-note-called-lambda-capture-uses
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [func : ast.AstExpr]) : TcMovedSet
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& func))
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda params _ body-box)
          (tc-borrow-check-note-called-lambda-capture-uses-at
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases body-box)
            (tc-param-bound-names params)
            (tc-moved-paths (tc-global-shared-view borrowed))
            borrowed)])]
    [_ borrowed]))

(define (tc-borrow-check-add-lending-marker
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [binding-id : i64]
  [origin : ast.AstExpr]) : TcMovedSet
  (tc-moved-add-path-fact
    borrowed
    path
    (BorrowLending binding-id)
    (ast.ast-node-push origin)))

(define (tc-borrow-check-split-provenance-for-binding-at
  [facts : TcMovedPathFacts]
  [binding-id : i64]
  [half : i64]
  [select-half : bool]) : TcMaybeMovePath
  (if (tc-moved-path-facts-empty? facts)
    (No)
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      (if (and
        (match fact.kind
          [(BorrowLending fact-binding-id) (= fact-binding-id binding-id)]
          [_ false])
        (if select-half
          (tc-move-path-slice-half? fact.path half)
          (or
            (tc-move-path-slice-half? fact.path 0)
            (tc-move-path-slice-half? fact.path 1))))
        (Some fact.path)
        (tc-borrow-check-split-provenance-for-binding-at
          rest
          binding-id
          half
          select-half)))))

(define (tc-borrow-check-split-provenance
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [source : ast.AstExpr]) : TcMaybeMovePath
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& source))
    [(Var binding-id)
      (match (tc-borrow-check-split-provenance-for-binding-at
        (tc-moved-paths borrowed)
        binding-id
        0
        false)
        [(Some path) (Some path)]
        [(No) (tc-borrow-check-place-path expr-bases source)])]
    [(TupleRef tuple-box half)
      (let
        [tuple-expr : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases tuple-box)]
        (match (ast.ast-expr-unspan-with-segment-bases
          expr-bases
          (& tuple-expr))
          [(Var binding-id)
            (match (tc-borrow-check-split-provenance-for-binding-at
              (tc-moved-paths borrowed)
              binding-id
              half
              true)
              [(Some path) (Some path)]
              [(No) (tc-borrow-check-place-path expr-bases source)])]
          [_ (tc-borrow-check-place-path expr-bases source)]))]
    [(or (Ann inner-box _) (Cast inner-box _))
      (tc-borrow-check-split-provenance
        expr-bases
        borrowed
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [_ (tc-borrow-check-place-path expr-bases source)]))

(define (tc-borrow-check-split-projection
  [expr-bases : i64]
  [expr : ast.AstExpr]) : TcMaybeSliceSplitProjection
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(TupleRef tuple-box half)
      (match (ast.ast-expr-unspan-with-segment-bases
        expr-bases
        (& (ast.ast-expr-segment-bases-get expr-bases tuple-box)))
        [(Var binding-id) (Some binding-id half)]
        [_ (No)])]
    [(or (Ann inner-box _) (Cast inner-box _))
      (tc-borrow-check-split-projection
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [_ (No)]))

(define (tc-borrow-check-rebind-split-projection-at
  [facts : TcMovedPathFacts]
  [source-binding-id : i64]
  [half : i64]
  [binding-id : i64]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [copy : bool
        (match fact.kind
          [(BorrowLending fact-binding-id)
            (and
              (= fact-binding-id source-binding-id)
              (or
                (and
                  (not (tc-move-path-slice-half? fact.path 0))
                  (not (tc-move-path-slice-half? fact.path 1)))
                (tc-move-path-slice-half? fact.path half)))]
          [_ false])]
      [out2 : TcMovedSet
        (if copy
          (tc-moved-add-path-fact
            out
            fact.path
            (BorrowLending binding-id)
            (tc-moved-path-fact-origin fact))
          out)]
      (tc-borrow-check-rebind-split-projection-at
        rest
        source-binding-id
        half
        binding-id
        out2))))

(define (tc-borrow-check-binding-has-split-provenance?
  [facts : TcMovedPathFacts]
  [binding-id : i64]) : bool
  (if (tc-moved-path-facts-empty? facts)
    false
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      (if (and
        (match fact.kind
          [(BorrowLending fact-binding-id) (= fact-binding-id binding-id)]
          [_ false])
        (or
          (tc-move-path-slice-half? fact.path 0)
          (tc-move-path-slice-half? fact.path 1)))
        true
        (tc-borrow-check-binding-has-split-provenance? rest binding-id)))))

(define (tc-borrow-check-rebind-split-projection
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [binding-id : i64]
  [init : ast.AstExpr]) : TcMovedSet
  (match (tc-borrow-check-split-projection expr-bases init)
    [(Some source-binding-id half)
      (if (tc-borrow-check-binding-has-split-provenance?
        (tc-moved-paths (tc-global-shared-view borrowed))
        source-binding-id)
        (tc-borrow-check-rebind-split-projection-at
          (tc-moved-paths (tc-global-shared-view borrowed))
          source-binding-id
          half
          binding-id
          borrowed)
        borrowed)]
    [(No) borrowed]))

(define (tc-moved-path-facts-remove-lending
  [facts : TcMovedPathFacts]
  [path : TcMovePath]) : TcMovedPathFacts
  (tc-moved-path-facts-filter facts (Lending path)))

(define (tc-borrow-check-remove-borrow-path
  [borrowed : TcMovedSet]
  [path : TcMovePath]) : TcMovedSet
  (let
    [without-shared : TcMovedSet
      (tc-moved-remove-path-kind borrowed path (BorrowShared))]
    [without-mut : TcMovedSet
      (tc-moved-remove-path-kind without-shared path (BorrowMut))]
    [without-two-phase : TcMovedSet
      (tc-moved-remove-path-kind without-mut path (BorrowTwoPhaseMut))]
    [facts : TcMovedPathFacts
      (tc-moved-path-facts-remove-lending
        (tc-moved-paths (tc-global-shared-view without-two-phase))
        path)]
    (TcMovedSet
      (tc-moved-roots (tc-global-shared-view without-two-phase))
      (tc-moved-partials (tc-global-shared-view without-two-phase))
      facts
      (tc-moved-hidden-atomic-users (tc-global-shared-view without-two-phase))
      (tc-moved-param-storage-origins without-two-phase))))

(define (tc-borrow-check-two-phase-mut-conflict
  [borrowed : TcMovedSet]
  [path : TcMovePath]) : TcMoveConflict
  (tc-moved-path-conflict-kind borrowed path (BorrowTwoPhaseMut)))

(define (tc-borrow-check-two-phase-mut-conflict-message
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [primary : ast.AstExpr]
  [message : String]) : String
  (tc-borrow-check-rich-conflict-message
    expr-bases
    borrowed
    path
    (BorrowTwoPhaseMut)
    primary
    message))

(define (tc-borrow-check-path-lifetime
  [ctx : TcContext]
  [env : TcTypeEnv]
  [path : TcMovePath]) : i64
  (let
    [root-id : i64 (tc-move-path-root-id path)]
    (match (tc-lookup-visible-id ctx env root-id)
      [(Ok ty)
        (let
          [resolved : ast.AstType (tc-resolve-type ctx ty)]
          (match (tc-type-strip-region (tc-global-shared-view resolved))
            [(or (Ref lifetime _) (MutRef lifetime _)) lifetime]
            [_
              (match (tc-type-outer-region resolved)
                [(Some region) region]
                [(No) root-id])]))]
      [(Err _) root-id])))

(define (tc-borrow-check-root-in-scope?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [root-id : i64]) : bool
  (or
    (tc-moved-contains? locals root-id)
    (match (tc-lookup-visible-id ctx env root-id)
      [(Ok _) true]
      [(Err _) false])))

(define (tc-borrow-check-type-contains-lifetime?
  [ctx : TcContext]
  [ty : ast.AstType]
  [lifetime : i64]) : bool
  ;; A primary body error can leave poison bindings in the diagnostic env.
  ;; Secondary borrow analysis must not try to intern the poison sentinel.
  (if (tc-poison-type? (tc-global-shared-view ty))
    false
    (tc-name-id-list-contains
      (tc-type-collect-reference-lifetimes (tc-resolve-type ctx ty))
      lifetime)))

(define (tc-borrow-check-binding-stores-lifetime?
  [ctx : TcContext]
  [ty : ast.AstType]
  [lifetime : i64]) : bool
  (if (tc-poison-type? (tc-global-shared-view ty))
    false
    (match (tc-type-strip-region
      (tc-resolve-type ctx (tc-global-shared-view ty)))
      [(Func _ ret)
        (tc-borrow-check-type-contains-lifetime?
          ctx
          (ast.ty-node-get ret)
          lifetime)]
      [_ (tc-borrow-check-type-contains-lifetime? ctx ty lifetime)])))

(define (tc-borrow-check-env-lifetime-used-in-exprs?
  [expr-bases : i64]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [exprs : ast.AstExprList]
  [lifetime : i64]
  [seen : TcStringList]
  [remaining : i64]) : bool
  ;; Only lexical bindings can carry this function-local lifetime. Follow
  ;; scan-through caches that compact a local prefix, but stop after every
  ;; live local has been seen instead of depending on the module cache shape.
  (if (<= remaining 0)
    false
    (match (tc-type-env-marker-step env)
      [(Done) false]
      [(Cache rest-env)
        (tc-borrow-check-env-lifetime-used-in-exprs?
          expr-bases
          ctx
          rest-env
          locals
          exprs
          lifetime
          seen
          remaining)]
      [(Bind name-id ty rest-env)
        (if (= name-id (tc-default-boundary-id))
          false
          (begin
            (cfg
              compile-profile
              (compiler-tc-env-profile-borrow-lifetime-scan-note-binding!))
            (let
              [name : String (tc-env-key-name-text name-id)]
              (cond
                [(tc-string-list-contains
                    (tc-global-shared-view seen)
                    (tc-global-shared-view name))
                  (tc-borrow-check-env-lifetime-used-in-exprs?
                    expr-bases
                    ctx
                    rest-env
                    locals
                    exprs
                    lifetime
                    seen
                    remaining)]
                [(not (tc-moved-contains? locals name-id))
                  (tc-borrow-check-env-lifetime-used-in-exprs?
                    expr-bases
                    ctx
                    rest-env
                    locals
                    exprs
                    lifetime
                    (tc-string-list-add seen name)
                    remaining)]
                [(and
                    (tc-borrow-check-binding-stores-lifetime? ctx ty lifetime)
                    (tc-expr-list-uses-free-name?
                      expr-bases
                      (tc-global-shared-view exprs)
                      (tc-global-shared-view name)
                      Nil))
                  true]
                [else
                  (tc-borrow-check-env-lifetime-used-in-exprs?
                    expr-bases
                    ctx
                    rest-env
                    locals
                    exprs
                    lifetime
                    (tc-string-list-add seen name)
                    (- remaining 1))]))))])))

(define (tc-borrow-check-lifetime-used-in-exprs?
  [expr-bases : i64]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [exprs : ast.AstExprList]
  [lifetime : i64]) : bool
  (begin
    (cfg compile-profile (compiler-tc-env-profile-borrow-lifetime-scan-start!))
    (let
      [used : bool
        (tc-borrow-check-env-lifetime-used-in-exprs?
          expr-bases
          ctx
          env
          (tc-global-shared-view locals)
          exprs
          lifetime
          Nil
          (tc-moved-len locals))]
      (begin
        (cfg
          compile-profile
          (compiler-tc-env-profile-borrow-lifetime-scan-finish!))
        used))))

;; A lexical child scope can return a reference whose source borrow was created
;; inside that scope. Retain the source path at the enclosing scope when its
;; lifetime appears in the result, while dropping child-local state and NLL
;; markers. This preserves the actual source projection instead of collapsing
;; it to the lifetime root.
(define (tc-borrow-check-result-expr-list-path
  [expr-bases : i64]
  [locals : TcMovedSet]
  [exprs : ast.AstExprList]) : TcMaybeMovePath
  (if (ast.ast-expr-list-empty? (& exprs))
    (No)
    (tc-borrow-check-result-direct-borrow-path
      expr-bases
      locals
      (ast.ast-expr-segment-bases-get
        expr-bases
        (ast.ast-expr-list-get (& exprs) (- exprs.len 1) 0)))))

;; Recover a direct place borrow from the value position of an expression.
;; Indirect call/aggregate results deliberately return No so their existing
;; lifetime-based propagation remains conservative.
(define (tc-borrow-check-result-direct-borrow-path
  [expr-bases : i64]
  [locals : TcMovedSet]
  [expr : ast.AstExpr]) : TcMaybeMovePath
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(Borrow _ _ place-box)
      (match (tc-borrow-check-place-path
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases place-box))
        [(Some path) (Some path)]
        [(No) (No)])]
    [(or (Begin exprs) (Unsafe exprs))
      (tc-borrow-check-result-expr-list-path expr-bases locals exprs)]
    [(or (Ann inner-box _) (Cast inner-box _) (Comptime inner-box)
         (Try inner-box))
      (tc-borrow-check-result-direct-borrow-path
        expr-bases
        locals
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [_ (No)]))

(define (tc-borrow-check-propagate-return-borrows-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [outer-locals : TcMovedSet]
  [facts : TcMovedPathFacts]
  [result-lifetimes : TcNameIdList]
  [direct-path : TcMaybeMovePath]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [path : TcMovePath fact.path]
      [kind : TcMovedPathKind fact.kind]
      [keep-kind : bool
        (match kind
          [(or (BorrowShared) (BorrowMut)) true]
          [_ false])]
      [keep-direct : bool
        (match direct-path
          [(Some direct) (tc-move-path-conflicts? path direct)]
          [(No) true])]
      [missing : bool
        (match (tc-moved-path-exact-conflict-kind out path kind)
          [(Some _ _) false]
          [No true])]
      [out2 : TcMovedSet
        (if (and
          keep-kind
          (tc-borrow-check-root-in-scope?
            ctx
            env
            (tc-global-shared-view outer-locals)
            (tc-move-path-root-id path))
          (tc-name-id-list-contains
            result-lifetimes
            (tc-borrow-check-path-lifetime ctx env path))
          keep-direct
          missing)
          (tc-moved-add-path-fact
            out
            path
            kind
            (tc-moved-path-fact-origin fact))
          out)]
      (tc-borrow-check-propagate-return-borrows-at
        ctx
        env
        outer-locals
        rest
        result-lifetimes
        direct-path
        out2))))

(define (tc-borrow-check-propagate-return-borrows
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [outer-locals : TcMovedSet]
  [outer-borrowed : TcMovedSet]
  [inner-borrowed : TcMovedSet]
  [result-ty : ast.AstType]
  [result-expr : ast.AstExpr]) : TcMovedSet
  ;; The protected outer state cannot be pruned while checking the child.
  ;; Therefore an unchanged entry count proves that the child introduced no
  ;; source borrow to propagate and avoids a result-type walk on ordinary lets.
  (if (<= (tc-moved-len inner-borrowed) (tc-moved-len outer-borrowed))
    outer-borrowed
    (let
      [result-lifetimes : TcNameIdList
        (tc-type-collect-reference-lifetimes (tc-resolve-type ctx result-ty))]
      (match result-lifetimes
        [Nil outer-borrowed]
        [_
          (tc-borrow-check-propagate-return-borrows-at
            ctx
            env
            (tc-global-shared-view outer-locals)
            (tc-moved-paths inner-borrowed)
            result-lifetimes
            (tc-borrow-check-result-direct-borrow-path
              expr-bases
              outer-locals
              result-expr)
            (tc-moved-clone outer-borrowed))]))))

(define (tc-borrow-check-mark-new-return-borrows-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [prior : TcMovedSet]
  [facts : TcMovedPathFacts]
  [binding-id : i64]
  [result-lifetimes : TcNameIdList]
  [origin : ast.AstExpr]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [path : TcMovePath fact.path]
      [shared : bool
        (match fact.kind
          [(BorrowShared) true]
          [_ false])]
      [new : bool
        (match (tc-moved-path-exact-conflict-kind prior path fact.kind)
          [(Some _ _) false]
          [No true])]
      [out2 : TcMovedSet
        (if (and
          shared
          new
          (tc-borrow-check-root-in-scope?
            ctx
            env
            (tc-global-shared-view locals)
            (tc-move-path-root-id path))
          (tc-name-id-list-contains
            result-lifetimes
            (tc-borrow-check-path-lifetime ctx env path)))
          (tc-borrow-check-add-lending-marker
            out
            path
            binding-id
            (tc-global-shared-view origin))
          out)]
      (tc-borrow-check-mark-new-return-borrows-at
        ctx
        env
        locals
        prior
        rest
        binding-id
        result-lifetimes
        origin
        out2))))

;; A propagated returned borrow needs an NLL marker for the outer result
;; binding. Mark only source paths newly introduced by the initializer; this
;; keeps pre-existing unrelated borrows untouched and removes both shared and
;; mutable source state after the binding's last use.
(define (tc-borrow-check-mark-new-return-borrows
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [prior : TcMovedSet]
  [borrowed : TcMovedSet]
  [binding-id : i64]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : TcMovedSet
  ;; Initializer checking protects the incoming state. Equal entry counts mean
  ;; there is no newly propagated source borrow that needs an NLL marker.
  (if (<= (tc-moved-len borrowed) (tc-moved-len prior))
    borrowed
    (let
      [result-lifetimes : TcNameIdList
        (tc-type-collect-reference-lifetimes (tc-resolve-type ctx result-ty))]
      (match result-lifetimes
        [Nil borrowed]
        [_
          (tc-borrow-check-mark-new-return-borrows-at
            ctx
            env
            locals
            prior
            (tc-moved-paths (tc-global-shared-view borrowed))
            binding-id
            result-lifetimes
            origin
            (tc-moved-clone borrowed))]))))

(define (tc-borrow-check-protected-path?
  [protected : TcMovedSet]
  [path : TcMovePath]) : bool
  (or
    (match (tc-moved-path-conflict-kind
      (tc-global-shared-view protected)
      path
      (BorrowShared))
      [(Some _ _) true]
      [No false])
    (match (tc-moved-path-conflict-kind protected path (BorrowMut))
      [(Some _ _) true]
      [No false])))

(define (tc-borrow-check-pending-path-at?
  [facts : TcMovedPathFacts]
  [path : TcMovePath]) : bool
  (if (tc-moved-path-facts-empty? facts)
    false
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      (if (and
        (tc-move-path-eq? fact.path path)
        (match fact.kind
          [(BorrowPending _) true]
          [_ false]))
        true
        (tc-borrow-check-pending-path-at? rest path)))))

;; Sequence walkers do not need to scan their full remaining syntax eagerly.
;; Guard every lending borrow while a later sibling exists; if the current
;; expression reports a conflict, the existing retry path performs the precise
;; free-name/lifetime scan before deciding whether the guard is still needed.
(define (tc-borrow-check-add-all-pending-markers-at
  [scope-id : i64]
  [facts : TcMovedPathFacts]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [out2 : TcMovedSet
        (match fact.kind
          [(BorrowLending _)
            (tc-moved-add-path-fact
              out
              fact.path
              (BorrowPending scope-id)
              (tc-moved-path-fact-origin fact))]
          [_ out])]
      (tc-borrow-check-add-all-pending-markers-at scope-id rest out2))))

(define (tc-borrow-check-add-all-pending-markers
  [borrowed : TcMovedSet]
  [pending-exprs : ast.AstExprList]
  [scope-id : i64]) : TcMovedSet
  (if (or
    (ast.ast-expr-list-empty? (& pending-exprs))
    (= (tc-moved-len borrowed) 0))
    borrowed
    (tc-borrow-check-add-all-pending-markers-at
      scope-id
      (tc-moved-paths (tc-global-shared-view borrowed))
      borrowed)))

(define (tc-moved-path-facts-remove-pending-scope
  [facts : TcMovedPathFacts]
  [scope-id : i64]) : TcMovedPathFacts
  (tc-moved-path-facts-filter facts (Pending scope-id)))

(define (tc-borrow-check-remove-pending-markers
  [borrowed : TcMovedSet]
  [scope-id : i64]) : TcMovedSet
  (TcMovedSet
    (tc-moved-roots (tc-global-shared-view borrowed))
    (tc-moved-partials (tc-global-shared-view borrowed))
    (tc-moved-path-facts-remove-pending-scope
      (tc-moved-paths (tc-global-shared-view borrowed))
      scope-id)
    (tc-moved-hidden-atomic-users (tc-global-shared-view borrowed))
    (tc-moved-param-storage-origins borrowed)))

(define (tc-borrow-check-prune-before-exprs-loop
  [expr-bases : i64]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [exprs : ast.AstExprList]
  [protected : TcMovedSet]
  [facts : TcMovedPathFacts]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [path : TcMovePath fact.path]
      [shared : bool
        (match fact.kind
          [(BorrowShared) true]
          [_ false])]
      [out2 : TcMovedSet
        (if (or
          (not shared)
          (tc-borrow-check-pending-path-at?
            (tc-moved-paths (tc-global-shared-view out))
            path)
          (and
            (not
              (tc-borrow-check-has-lending-binding?
                (tc-global-shared-view out)
                path))
            (tc-borrow-check-protected-path?
              (tc-global-shared-view protected)
              path)))
          out
          (match (tc-borrow-check-lending-binding
            (tc-moved-paths (tc-global-shared-view out))
            path)
            [(Some lending-binding-id)
              (cond
                [(not
                    (tc-borrow-check-lending-binding-used-at?
                      (tc-moved-paths (tc-global-shared-view out))
                      path
                      lending-binding-id))
                  out]
                [(tc-expr-list-uses-free-name?
                    expr-bases
                    (tc-global-shared-view exprs)
                    (tc-env-key-name-text lending-binding-id)
                    Nil)
                  out]
                [(tc-borrow-check-lifetime-used-in-exprs?
                    expr-bases
                    ctx
                    env
                    (tc-global-shared-view locals)
                    (tc-global-shared-view exprs)
                    (tc-borrow-check-path-lifetime ctx env path))
                  (tc-moved-remove-path-kind
                    out
                    path
                    (BorrowLending lending-binding-id))]
                [else (tc-borrow-check-remove-borrow-path out path)])]
            [(No)
              (if (tc-borrow-check-lifetime-used-in-exprs?
                expr-bases
                ctx
                env
                (tc-global-shared-view locals)
                (tc-global-shared-view exprs)
                (tc-borrow-check-path-lifetime ctx env path))
                out
                (tc-borrow-check-remove-borrow-path out path))]))]
      (tc-borrow-check-prune-before-exprs-loop
        expr-bases
        ctx
        env
        locals
        exprs
        protected
        rest
        out2))))

(define (tc-borrow-check-prune-before-exprs
  [expr-bases : i64]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : ast.AstExprList]) : TcMovedSet
  (if (or (ast.ast-expr-list-empty? (& exprs)) (= (tc-moved-len borrowed) 0))
    borrowed
    (tc-borrow-check-prune-before-exprs-loop
      expr-bases
      ctx
      env
      locals
      exprs
      protected
      (tc-moved-paths (tc-global-shared-view borrowed))
      borrowed)))

(define (tc-borrow-check-place-path [expr-bases : i64] [expr : ast.AstExpr]) : TcMaybeMovePath
  (match (tc-move-root-projection-var-id
    expr-bases
    (tc-global-shared-view expr))
    [(Some root-id)
      (match (tc-move-direct-root-base-path expr-bases expr)
        [(Some path) (Some path)]
        [(No) (Some (TcMovePath root-id (tc-move-path-segments-empty)))])]
    [(No) (No)]))

(define (tc-borrow-check-add-borrow-path
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [mutable : bool]
  [origin : ast.AstExpr]) : TcMovedSet
  (let
    [origin-id : i64 (ast.ast-node-push origin)]
    [borrowed1 : TcMovedSet
      (tc-moved-add-path-fact borrowed path (BorrowShared) origin-id)]
    (if mutable
      (tc-moved-add-path-fact borrowed1 path (BorrowMut) origin-id)
      borrowed1)))

(define (tc-borrow-check-add-two-phase-mut-borrow-path
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [origin : ast.AstExpr]) : TcMovedSet
  (tc-moved-add-path-fact
    borrowed
    path
    (BorrowTwoPhaseMut)
    (ast.ast-node-push origin)))

(define (tc-borrow-check-add-two-phase-mut-place
  [expr-bases : i64]
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [place : ast.AstExpr]
  [origin : ast.AstExpr]) : TcBorrowCheckResult
  (match (tc-borrow-check-place-path expr-bases place)
    [(Some path)
      (let
        [_
          (try
            (tc-borrow-check-mutably-borrow-conflict
              expr-bases
              (tc-global-shared-view borrowed)
              path
              (tc-global-shared-view origin)))]
        (Ok
          (tc-borrow-check-add-two-phase-mut-borrow-path borrowed path origin)))]
    [(No) (Ok borrowed)]))

(define (tc-borrow-check-remove-two-phase-mut-place
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [place : ast.AstExpr]) : TcMovedSet
  (match (tc-borrow-check-place-path expr-bases place)
    [(Some path) (tc-moved-remove-path-kind borrowed path (BorrowTwoPhaseMut))]
    [(No) borrowed]))

(define (tc-borrow-check-move-conflict
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [primary : ast.AstExpr]) : ResultTcUnit
  (if (tc-moved-path-conflict? (tc-global-shared-view borrowed) path)
    (Err
      (tc-borrow-check-rich-conflict-message
        expr-bases
        borrowed
        path
        (BorrowShared)
        primary
        (tc-borrow-check-move-message (tc-move-path-render path))))
    (match (tc-borrow-check-two-phase-mut-conflict
      (tc-global-shared-view borrowed)
      path)
      [(Some _ _)
        (Err
          (tc-borrow-check-two-phase-mut-conflict-message
            expr-bases
            borrowed
            path
            primary
            (tc-borrow-check-move-message (tc-move-path-render path))))]
      [No Ok])))

(define (tc-borrow-check-assign-conflict
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [primary : ast.AstExpr]) : ResultTcUnit
  (if (tc-moved-path-conflict? (tc-global-shared-view borrowed) path)
    (Err
      (tc-borrow-check-rich-conflict-message
        expr-bases
        borrowed
        path
        (BorrowShared)
        primary
        (tc-borrow-check-assign-message (tc-move-path-render path))))
    (match (tc-borrow-check-two-phase-mut-conflict
      (tc-global-shared-view borrowed)
      path)
      [(Some _ _)
        (Err
          (tc-borrow-check-two-phase-mut-conflict-message
            expr-bases
            borrowed
            path
            primary
            (tc-borrow-check-assign-message (tc-move-path-render path))))]
      [No Ok])))

(define (tc-borrow-check-mutably-borrow-conflict
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [primary : ast.AstExpr]) : ResultTcUnit
  (if (tc-moved-path-conflict? (tc-global-shared-view borrowed) path)
    (Err
      (tc-borrow-check-rich-conflict-message
        expr-bases
        borrowed
        path
        (BorrowShared)
        primary
        (tc-borrow-check-mutably-borrow-message (tc-move-path-render path))))
    (match (tc-borrow-check-two-phase-mut-conflict
      (tc-global-shared-view borrowed)
      path)
      [(Some _ _)
        (Err
          (tc-borrow-check-two-phase-mut-conflict-message
            expr-bases
            borrowed
            path
            primary
            (tc-borrow-check-mutably-borrow-message (tc-move-path-render path))))]
      [No Ok])))

(define (tc-borrow-check-immutably-borrow-conflict
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [primary : ast.AstExpr]) : ResultTcUnit
  (if (match (tc-moved-path-conflict-kind
    (tc-global-shared-view borrowed)
    path
    (BorrowMut))
    [(Some _ _) true]
    [No false])
    (Err
      (tc-borrow-check-rich-conflict-message
        expr-bases
        borrowed
        path
        (BorrowMut)
        primary
        (tc-borrow-check-immutably-borrow-message (tc-move-path-render path))))
    Ok))

(define (tc-borrow-check-read-conflict
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [primary : ast.AstExpr]) : ResultTcUnit
  (if (match (tc-moved-path-conflict-kind
    (tc-global-shared-view borrowed)
    path
    (BorrowMut))
    [(Some _ _) true]
    [No false])
    (Err
      (tc-borrow-check-rich-conflict-message
        expr-bases
        borrowed
        path
        (BorrowMut)
        primary
        (tc-borrow-check-read-message (tc-move-path-render path))))
    Ok))

(define (tc-borrow-check-place-read-conflict
  [expr-bases : i64]
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : ast.AstExpr]
  [primary : ast.AstExpr]) : TcBorrowCheckResult
  (if (= (tc-moved-len borrowed) 0)
    (Ok borrowed)
    (match (tc-borrow-check-place-path expr-bases expr)
      [(Some path)
        (let
          [_
            (try
              (tc-borrow-check-read-conflict
                expr-bases
                (tc-global-shared-view borrowed)
                path
                primary))]
          (Ok borrowed))]
      [(No) (Ok borrowed)])))

(define (tc-borrow-check-add-place-with-mutability
  [expr-bases : i64]
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [mutable : bool]
  [place : ast.AstExpr]
  [origin : ast.AstExpr]) : TcBorrowCheckResult
  (match (tc-borrow-check-place-path expr-bases place)
    [(Some path)
      (if mutable
        (let
          [_
            (try
              (tc-borrow-check-mutably-borrow-conflict
                expr-bases
                (tc-global-shared-view borrowed)
                path
                (tc-global-shared-view origin)))]
          (Ok (tc-borrow-check-add-borrow-path borrowed path true origin)))
        (let
          [_
            (try
              (tc-borrow-check-immutably-borrow-conflict
                expr-bases
                (tc-global-shared-view borrowed)
                path
                (tc-global-shared-view origin)))]
          (Ok (tc-borrow-check-add-borrow-path borrowed path false origin))))]
    [(No) (Ok borrowed)]))

(define (tc-borrow-check-after-consuming-place
  [expr-bases : i64]
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : ast.AstExpr]) : TcBorrowCheckResult
  (match (tc-borrow-check-place-path expr-bases (tc-global-shared-view expr))
    [(Some path)
      (let
        [_
          (try
            (tc-borrow-check-move-conflict
              expr-bases
              (tc-global-shared-view borrowed)
              path
              expr))]
        (Ok borrowed))]
    [(No) (Ok borrowed)]))

(define (tc-borrow-check-after-consuming-value
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : ast.AstExpr]
  [target-ty : ast.AstType]) : TcBorrowCheckResult
  (if (or
    (tc-call-param-moves-argument? ctx target-ty)
    (tc-move-value-concrete-closure-move-only?
      ctx
      expr-bases
      env
      (tc-global-shared-view locals)
      (tc-global-shared-view expr)))
    (tc-borrow-check-after-consuming-place expr-bases locals borrowed expr)
    (Ok borrowed)))

(define (tc-borrow-check-after-move-only-value
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : ast.AstExpr]
  [target-ty : ast.AstType]) : TcBorrowCheckResult
  (if (tc-move-value-move-only?
    ctx
    expr-bases
    env
    (tc-global-shared-view locals)
    (tc-global-shared-view expr)
    (tc-resolve-type ctx target-ty))
    (tc-borrow-check-after-consuming-place expr-bases locals borrowed expr)
    (Ok borrowed)))

(define (tc-borrow-check-after-reading-value
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : ast.AstExpr]
  [target-ty : ast.AstType]) : TcBorrowCheckResult
  (if (or
    (tc-call-param-moves-argument? ctx target-ty)
    (tc-move-value-concrete-closure-move-only?
      ctx
      expr-bases
      env
      (tc-global-shared-view locals)
      (tc-global-shared-view expr)))
    (Ok borrowed)
    (tc-borrow-check-place-read-conflict
      expr-bases
      locals
      borrowed
      (tc-global-shared-view expr)
      expr)))

(define (tc-borrow-check-after-bind-typed
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [init : ast.AstExpr]
  [init-ty : ast.AstType]) : TcBorrowCheckResult
  (if (or
    (tc-type-move-only? ctx init-ty)
    (tc-move-value-concrete-closure-move-only?
      ctx
      expr-bases
      env
      (tc-global-shared-view locals)
      (tc-global-shared-view init)))
    (tc-borrow-check-after-consuming-place expr-bases locals borrowed init)
    (Ok borrowed)))

(define (tc-borrow-check-after-bind-id
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [init-id : i64]) : TcBorrowCheckResult
  (let
    [init : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases init-id)]
    (match (tc-move-bare-var expr-bases (tc-global-shared-view init))
      [(Some name-id name)
        (if (and
          (tc-moved-contains? locals name-id)
          (tc-move-var-move-only-id? ctx env locals name-id))
          (let
            [_
              (try
                (tc-borrow-check-move-conflict
                  expr-bases
                  (tc-global-shared-view borrowed)
                  (TcMovePath name-id (tc-move-path-segments-empty))
                  init))]
            (Ok borrowed))
          (Ok borrowed))]
      [(No)
        ;; Only a place can conflict with a loan when its value moves, so the
        ;; value's type matters only for a place.
        (match (tc-borrow-check-place-path
          expr-bases
          (tc-global-shared-view init))
          [(Some _)
            (match (tc-body-type-fact-expr-id
              "borrow.bind_init"
              ctx
              env
              init-id)
              [(Ok init-ty)
                (tc-borrow-check-after-bind-typed
                  ctx
                  expr-bases
                  env
                  locals
                  borrowed
                  init
                  init-ty)]
              [(Err _) (Ok borrowed)])]
          [(No) (Ok borrowed)])])))

(define (tc-borrow-check-call-constructor?
  [ctx : TcContext]
  [func : ast.AstExpr]) : bool
  (let
    [name-id : i64
      (tc-expr-var-name-id (tc-context-expr-segment-bases ctx) func)]
    (if (>= name-id 0)
      (tc-constructor-name-id? ctx name-id)
      false)))

(define (tc-borrow-check-lending-result-type?
  [ctx : TcContext]
  [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(or (EnumArgs _ _) (StructArgs _ _)) true]
    [(Tuple elems)
      (tc-type-list-contains-reference?
        (ast.ast-type-list-box-shared-view elems))]
    [_ false]))

;; The ordinary returned-call effect uses the inferred result type, which can
;; retain a symbolic lifetime for a lending call. At an annotated binding we
;; have the concrete caller lifetime, so attach a result-binding marker to the
;; direct mutable borrow for precise NLL pruning.
(define (tc-borrow-check-first-overlapping-lifetime
  [type-lifetimes : TcNameIdList]
  [result-lifetimes : TcNameIdList]) : TcMaybeNameId
  (let
    [cursor : TcNameIdList result-lifetimes]
    [found : TcMaybeNameId No]
    [done : bool false]
    (while (and (not done) (not (tc-name-id-list-empty? cursor)))
      (let
        [lifetime : i64 (tc-name-id-list-head cursor)]
        (when
          (tc-name-id-list-contains type-lifetimes lifetime)
          (set! found (Some lifetime))
          (set! done true))
        (set! cursor (tc-name-id-list-rest cursor))))
    found))

;; A composite call argument returns one of its children (#7979). The loans
;; of every child that can produce the value may feed the stored lifetime; an
;; `if` condition and the forms before a `begin`'s last never do. `let` and
;; `match` children are checked in the environment that binds their locals.
;; An initializer or scrutinee contributes when a value bound from it reaches
;; the returned expression.
;; Each leaf applies its own lifetime-overlap test, so a child whose type
;; stores none of the result's lifetimes keeps nothing borrowed.
(define (tc-borrow-check-add-composite-arg-leaf
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [arg : ast.AstExpr]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (if bound?
    (tc-borrow-check-add-bound-returned-call-arg-borrow
      ctx
      expr-bases
      env
      locals
      borrowed
      binding-id
      arg
      result-lifetimes)
    (tc-borrow-check-add-returned-call-arg-borrow
      ctx
      expr-bases
      env
      locals
      borrowed
      arg
      result-lifetimes)))

(define (tc-borrow-check-add-composite-if-arg
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [cond-box : i64]
  [then-box : i64]
  [else-box : i64]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (let
    [branches : ast.AstExprList
      (tc-borrow-check-composite-pair-list then-box else-box)]
    [borrowed0
      (try
        (tc-borrow-check-add-composite-assignment-effect-before
          ctx
          expr-bases
          env
          (tc-global-shared-view locals)
          borrowed
          bound?
          binding-id
          (ast.ast-expr-segment-bases-get expr-bases cond-box)
          (& branches)
          0
          1
          (& branches)
          branches.len
          result-lifetimes))]
    [borrowed1
      (try
        (tc-borrow-check-add-composite-arg-leaf
          ctx
          expr-bases
          env
          (tc-global-shared-view locals)
          borrowed0
          bound?
          binding-id
          (ast.ast-expr-segment-bases-get expr-bases then-box)
          result-lifetimes))]
    (tc-borrow-check-add-composite-arg-leaf
      ctx
      expr-bases
      env
      locals
      borrowed1
      bound?
      binding-id
      (ast.ast-expr-segment-bases-get expr-bases else-box)
      result-lifetimes)))

(define (tc-borrow-check-add-composite-last-arg
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [exprs : ast.AstExprList]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (if (<= exprs.len 0)
    (Ok borrowed)
    (let
      [borrowed1
        (try
          (tc-borrow-check-add-composite-arg-leaf
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            borrowed
            bound?
            binding-id
            (ast.ast-expr-segment-bases-get
              expr-bases
              (ast.ast-expr-list-get (& exprs) (- exprs.len 1) 0))
            result-lifetimes))]
      (tc-borrow-check-add-composite-sequence-assignments-at
        ctx
        expr-bases
        env
        locals
        borrowed1
        bound?
        binding-id
        (& exprs)
        0
        result-lifetimes))))

;; A preceding assignment can feed the final form. Follow its right side only
;; when the assigned local can reach a later assignment or the final value.
(define (tc-borrow-check-add-composite-sequence-assignments-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (if (>= index (- exprs.len 1))
    (Ok borrowed)
    (let
      [borrowed1
        (try
          (tc-borrow-check-add-composite-assignment-effect
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            borrowed
            bound?
            binding-id
            (ast.ast-expr-segment-bases-get
              expr-bases
              (ast.ast-expr-list-get exprs index 0))
            exprs
            (+ index 1)
            result-lifetimes))]
      (tc-borrow-check-add-composite-sequence-assignments-at
        ctx
        expr-bases
        env
        locals
        borrowed1
        bound?
        binding-id
        exprs
        (+ index 1)
        result-lifetimes))))

(define (tc-borrow-check-add-composite-assignment-effects-in-list
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [items : (& items ast.AstExprList)]
  [index : i64]
  [later : (& later ast.AstExprList)]
  [later-index : i64]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (if (>= index items.len)
    (Ok borrowed)
    (let
      [next : ast.AstExprList
        (tc-borrow-check-composite-later-list
          items
          (+ index 1)
          0
          later
          later-index)]
      [borrowed1
        (try
          (tc-borrow-check-add-composite-assignment-effect
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            borrowed
            bound?
            binding-id
            (ast.ast-expr-segment-bases-get
              expr-bases
              (ast.ast-expr-list-get items index 0))
            (& next)
            0
            result-lifetimes))]
      (tc-borrow-check-add-composite-assignment-effects-in-list
        ctx
        expr-bases
        env
        locals
        borrowed1
        bound?
        binding-id
        items
        (+ index 1)
        later
        later-index
        result-lifetimes))))

;; Every item runs before the same later forms.
(define (tc-borrow-check-add-composite-assignment-effects-in-each
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [items : (& items ast.AstExprList)]
  [index : i64]
  [later : (& later ast.AstExprList)]
  [later-index : i64]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (if (>= index items.len)
    (Ok borrowed)
    (let
      [borrowed1
        (try
          (tc-borrow-check-add-composite-assignment-effect
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            borrowed
            bound?
            binding-id
            (ast.ast-expr-segment-bases-get
              expr-bases
              (ast.ast-expr-list-get items index 0))
            later
            later-index
            result-lifetimes))]
      (tc-borrow-check-add-composite-assignment-effects-in-each
        ctx
        expr-bases
        env
        locals
        borrowed1
        bound?
        binding-id
        items
        (+ index 1)
        later
        later-index
        result-lifetimes))))

;; Effects of `expr` when `ahead` from `start` runs next, then `later`.
(define (tc-borrow-check-add-composite-assignment-effect-before
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [expr : ast.AstExpr]
  [ahead : (& ahead ast.AstExprList)]
  [start : i64]
  [maybe-before : i64]
  [later : (& later ast.AstExprList)]
  [later-index : i64]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (if (tc-borrow-check-composite-has-store?
    expr-bases
    (tc-global-shared-view expr))
    (let
      [next : ast.AstExprList
        (tc-borrow-check-composite-later-list
          ahead
          start
          maybe-before
          later
          later-index)]
      (tc-borrow-check-add-composite-assignment-effect
        ctx
        expr-bases
        env
        locals
        borrowed
        bound?
        binding-id
        expr
        (& next)
        0
        result-lifetimes))
    (Ok borrowed)))

(define (tc-borrow-check-add-composite-assignment-effect
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [expr : ast.AstExpr]
  [later : (& later ast.AstExprList)]
  [later-index : i64]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(Set target value-box)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [borrowed1
          (try
            (tc-borrow-check-add-composite-assignment-effect
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed
              bound?
              binding-id
              (tc-global-shared-view value)
              later
              later-index
              result-lifetimes))]
        (if (tc-borrow-check-composite-value-uses-name-in-sequence-from?
          expr-bases
          later
          later-index
          target)
          (tc-borrow-check-add-composite-stored-value
            ctx
            expr-bases
            env
            locals
            borrowed1
            bound?
            binding-id
            (tc-lookup-visible-id ctx env target)
            value
            result-lifetimes)
          (Ok borrowed1)))]
    [(If cond-box then-box else-box)
      (let
        [branches : ast.AstExprList
          (tc-borrow-check-composite-pair-list then-box else-box)]
        [borrowed1
          (try
            (tc-borrow-check-add-composite-assignment-effect-before
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed
              bound?
              binding-id
              (ast.ast-expr-segment-bases-get expr-bases cond-box)
              (& branches)
              0
              branches.len
              later
              later-index
              result-lifetimes))]
        (tc-borrow-check-add-composite-assignment-effects-in-each
          ctx
          expr-bases
          env
          locals
          borrowed1
          bound?
          binding-id
          (& branches)
          0
          later
          later-index
          result-lifetimes))]
    ;; Binding a let or a match arm types its initializers, so skip forms
    ;; that cannot store anything.
    [(Let let-box)
      (if (tc-borrow-check-composite-has-store?
        expr-bases
        (tc-global-shared-view expr))
        (match (__tl-box-place let-box)
          [(Let bindings body-box)
            (tc-borrow-check-add-composite-let-assignment-effect-at
              ctx
              expr-bases
              env
              locals
              borrowed
              bound?
              binding-id
              (& bindings)
              body-box
              0
              later
              later-index
              result-lifetimes)])
        (Ok borrowed))]
    [(or (Begin items) (Unsafe items))
      (tc-borrow-check-add-composite-assignment-effects-in-list
        ctx
        expr-bases
        env
        locals
        borrowed
        bound?
        binding-id
        (& items)
        0
        later
        later-index
        result-lifetimes)]
    [(Match match-box)
      (if (tc-borrow-check-composite-has-store?
        expr-bases
        (tc-global-shared-view expr))
        (match (ast.ast-match-box-shared-view match-box)
          [(Match scrut-box arms)
            (tc-borrow-check-add-composite-match-effect
              ctx
              expr-bases
              env
              locals
              borrowed
              bound?
              binding-id
              scrut-box
              (& arms)
              later
              later-index
              result-lifetimes)])
        (Ok borrowed))]
    [_
      (let
        [unspanned : ast.AstExpr
          (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))]
        (cond
          [(>=
              (tc-borrow-check-composite-store-place-id
                (tc-global-shared-view unspanned))
              0)
            (tc-borrow-check-add-composite-place-store-effect
              ctx
              expr-bases
              env
              locals
              borrowed
              bound?
              binding-id
              unspanned
              later
              later-index
              result-lifetimes)]
          [(tc-borrow-check-composite-binding-form?
              (tc-global-shared-view unspanned))
            (if (tc-borrow-check-composite-untracked-store?
              ctx
              expr-bases
              env
              unspanned
              result-lifetimes)
              (Err (tc-borrow-check-untracked-store-message))
              (Ok borrowed))]
          [else
            (tc-borrow-check-add-composite-children-effects
              ctx
              expr-bases
              env
              locals
              borrowed
              bound?
              binding-id
              unspanned
              later
              later-index
              result-lifetimes)]))]))

;; Children of a form without its own rule may run in any order and any
;; number of times, so each runs before all of them and then `later`.
(define (tc-borrow-check-add-composite-children-effects
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [expr : ast.AstExpr]
  [later : (& later ast.AstExprList)]
  [later-index : i64]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (if (tc-borrow-check-composite-has-store?
    expr-bases
    (tc-global-shared-view expr))
    (let
      [children : ast.AstExprList (ast.ast-expr-child-ids expr)]
      [next : ast.AstExprList
        (tc-borrow-check-composite-later-list
          (& children)
          0
          children.len
          later
          later-index)]
      (tc-borrow-check-add-composite-assignment-effects-in-each
        ctx
        expr-bases
        env
        locals
        borrowed
        bound?
        binding-id
        (& children)
        0
        (& next)
        0
        result-lifetimes))
    (Ok borrowed)))

;; A place write can reach a later read through its root, a projection, or a
;; reference, so its value always counts as fed onward.
(define (tc-borrow-check-add-composite-place-store-effect
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [store : ast.AstExpr]
  [later : (& later ast.AstExprList)]
  [later-index : i64]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (let
    [place-id : i64
      (tc-borrow-check-composite-store-place-id (tc-global-shared-view store))]
    [value-id : i64
      (tc-borrow-check-composite-store-value-id (tc-global-shared-view store))]
    [borrowed1
      (try
        (tc-borrow-check-add-composite-children-effects
          ctx
          expr-bases
          env
          (tc-global-shared-view locals)
          borrowed
          bound?
          binding-id
          store
          later
          later-index
          result-lifetimes))]
    (tc-borrow-check-add-composite-stored-value
      ctx
      expr-bases
      env
      locals
      borrowed1
      bound?
      binding-id
      (tc-expr ctx env (ast.ast-expr-segment-bases-get expr-bases place-id))
      (ast.ast-expr-segment-bases-get expr-bases value-id)
      result-lifetimes)))

;; The written place and the stored value of a place write, or -1.
(define (tc-borrow-check-composite-store-place-id [expr : ast.AstExpr]) : i64
  (match expr
    [(or (Replace place-box _) (StructSet place-box _ _)
         (ArraySet place-box _ _) (BoxSet place-box _) (ArrayPush place-box _))
      place-box]
    [_ -1]))

(define (tc-borrow-check-composite-store-value-id [expr : ast.AstExpr]) : i64
  (match expr
    [(or (Replace _ value-box) (StructSet _ _ value-box)
         (ArraySet _ _ value-box) (BoxSet _ value-box) (ArrayPush _ value-box))
      value-box]
    [_ -1]))

(define (tc-borrow-check-add-composite-stored-value
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [destination-ty : ResultTcType]
  [value : ast.AstExpr]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (match (tc-expr ctx env (tc-global-shared-view value))
    [(Ok _)
      (tc-borrow-check-add-composite-arg-leaf
        ctx
        expr-bases
        env
        locals
        borrowed
        bound?
        binding-id
        value
        result-lifetimes)]
    [(Err _)
      (if (tc-borrow-check-composite-destination-holds?
        ctx
        destination-ty
        result-lifetimes)
        (Err (tc-borrow-check-untracked-store-message))
        (Ok borrowed))]))

(define (tc-borrow-check-composite-destination-holds?
  [ctx : TcContext]
  [destination-ty : ResultTcType]
  [result-lifetimes : TcNameIdList]) : bool
  (match destination-ty
    [(Ok ty)
      (tc-name-id-list-overlaps?
        (tc-type-collect-reference-lifetimes (tc-resolve-type ctx ty))
        result-lifetimes)]
    [(Err _) true]))

(define (tc-borrow-check-untracked-store-message) : String
  (tc-kind-message
    (BorrowViolation)
    "typecheck: a call argument stores a value the call result may borrow under bindings the borrow checker does not track (lambda, foreach, for over a fixed array, or with-resource); store it outside the argument"))

;; Forms that bind names the effect walker does not model.
(define (tc-borrow-check-composite-binding-form? [expr : ast.AstExpr]) : bool
  (match expr
    [(or (Lambda _) (Foreach _) (ForeachActive _ _) (ForOwnedState _)
         (ForOwnedStep _) (WithResource _) (SpmdReduce _) (SpmdScan _)
         (SpmdCompact _))
      true]
    [_ false]))

;; Inside an untracked binding form, a store is safe only when its
;; destination cannot hold the result's lifetimes. A local bound inside the
;; form ends with it, so only a later store can carry its value out.
(define (tc-borrow-check-composite-untracked-store?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [result-lifetimes : TcNameIdList]) : bool
  (let
    [unspanned : ast.AstExpr
      (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))]
    [here : bool
      (match (tc-global-shared-view unspanned)
        [(Set target _)
          (match (tc-lookup-visible-id ctx env target)
            [(Ok ty)
              (tc-borrow-check-composite-destination-holds?
                ctx
                (Ok ty)
                result-lifetimes)]
            [(Err _) false])]
        [_
          (let
            [place-id : i64
              (tc-borrow-check-composite-store-place-id
                (tc-global-shared-view unspanned))]
            (and
              (>= place-id 0)
              (tc-borrow-check-composite-destination-holds?
                ctx
                (tc-expr
                  ctx
                  env
                  (ast.ast-expr-segment-bases-get expr-bases place-id))
                result-lifetimes)))])]
    (if here
      true
      (let
        [children : ast.AstExprList (ast.ast-expr-child-ids unspanned)]
        [index : i64 0]
        [found : bool false]
        (while (and (not found) (< index children.len))
          (when
            (tc-borrow-check-composite-untracked-store?
              ctx
              expr-bases
              env
              (ast.ast-expr-segment-bases-get
                expr-bases
                (ast.ast-expr-list-get (& children) index 0))
              result-lifetimes)
            (set! found true))
          (set! index (+ index 1)))
        found))))

(define (tc-borrow-check-add-composite-match-effect
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [scrut-box : i64]
  [arms : (& arms ast.AstMatchArmList)]
  [later : (& later ast.AstExprList)]
  [later-index : i64]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (let
    [scrut : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases scrut-box)]
    [bodies : ast.AstExprList (tc-borrow-check-composite-match-arm-bodies arms)]
    [scrut-ty : ResultTcType (tc-expr ctx env (tc-global-shared-view scrut))]
    [borrowed1
      (try
        (tc-borrow-check-add-composite-assignment-effect-before
          ctx
          expr-bases
          env
          (tc-global-shared-view locals)
          borrowed
          bound?
          binding-id
          (tc-global-shared-view scrut)
          (& bodies)
          0
          bodies.len
          later
          later-index
          result-lifetimes))]
    [borrowed2
      (try
        (tc-borrow-check-add-composite-match-arm-effects-at
          ctx
          expr-bases
          env
          (tc-global-shared-view locals)
          borrowed1
          bound?
          binding-id
          (tc-global-shared-view scrut-ty)
          arms
          0
          later
          later-index
          result-lifetimes))]
    (if (tc-borrow-check-composite-match-arms-feed-pattern?
      expr-bases
      arms
      later
      later-index)
      (tc-borrow-check-add-composite-stored-value
        ctx
        expr-bases
        env
        locals
        borrowed2
        bound?
        binding-id
        scrut-ty
        scrut
        result-lifetimes)
      (Ok borrowed2))))

(define (tc-borrow-check-add-composite-match-arm-effects-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [scrut-ty : ResultTcType]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]
  [later : (& later ast.AstExprList)]
  [later-index : i64]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (if (>= index arms.len)
    (Ok borrowed)
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (let
          [borrowed1
            (try
              (tc-borrow-check-add-composite-assignment-effect
                ctx
                expr-bases
                (tc-borrow-check-composite-arm-env
                  ctx
                  env
                  (tc-global-shared-view scrut-ty)
                  pattern)
                (tc-global-shared-view locals)
                borrowed
                bound?
                binding-id
                (ast.ast-expr-segment-bases-get expr-bases body-box)
                later
                later-index
                result-lifetimes))]
          (tc-borrow-check-add-composite-match-arm-effects-at
            ctx
            expr-bases
            env
            locals
            borrowed1
            bound?
            binding-id
            scrut-ty
            arms
            (+ index 1)
            later
            later-index
            result-lifetimes))])))

;; Without a typed scrutinee the arm keeps the outer environment, so a store
;; of a pattern-bound value cannot be typed and fails as untracked.
(define (tc-borrow-check-composite-arm-env
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : ResultTcType]
  [pattern : ast.AstPattern]) : TcTypeEnv
  (match scrut-ty
    [(Ok ty)
      (match (tc-bind-match-pattern ctx env ty pattern)
        [(Ok arm-env) arm-env]
        [(Err _) env])]
    [(Err _) env]))

;; Children evaluate left to right, so a store in one child can feed only a
;; later child's value.
(define (tc-borrow-check-add-composite-sibling-effects-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [children : (& children ast.AstExprList)]
  [index : i64]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (if (>= (+ index 1) children.len)
    (Ok borrowed)
    (let
      [borrowed1
        (try
          (tc-borrow-check-add-composite-assignment-effect-before
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            borrowed
            bound?
            binding-id
            (ast.ast-expr-segment-bases-get
              expr-bases
              (ast.ast-expr-list-get children index 0))
            children
            (+ index 1)
            (- children.len 1)
            children
            children.len
            result-lifetimes))]
      (tc-borrow-check-add-composite-sibling-effects-at
        ctx
        expr-bases
        env
        locals
        borrowed1
        bound?
        binding-id
        children
        (+ index 1)
        result-lifetimes))))

(define (tc-borrow-check-add-composite-sibling-effects
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [expr : ast.AstExpr]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (if (tc-borrow-check-composite-has-store?
    expr-bases
    (tc-global-shared-view expr))
    (let
      [children : ast.AstExprList
        (ast.ast-expr-child-ids
          (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr)))]
      (tc-borrow-check-add-composite-sibling-effects-at
        ctx
        expr-bases
        env
        locals
        borrowed
        bound?
        binding-id
        (& children)
        0
        result-lifetimes))
    (Ok borrowed)))

(define (tc-borrow-check-add-composite-let-assignment-effect-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [body-box : i64]
  [index : i64]
  [later : (& later ast.AstExprList)]
  [later-index : i64]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (tc-borrow-check-add-composite-assignment-effect
      ctx
      expr-bases
      env
      locals
      borrowed
      bound?
      binding-id
      (ast.ast-expr-segment-bases-get expr-bases body-box)
      later
      later-index
      result-lifetimes)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name maybe-ty init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [borrowed0
            (try
              (tc-borrow-check-add-composite-let-init-effects
                ctx
                expr-bases
                env
                (tc-global-shared-view locals)
                borrowed
                bound?
                binding-id
                bindings
                body-box
                index
                (tc-global-shared-view init)
                later
                later-index
                result-lifetimes))]
          [borrowed1
            (try
              (if (tc-borrow-check-composite-let-effect-binding-feeds?
                expr-bases
                bindings
                body-box
                later
                later-index
                index
                name)
                (tc-borrow-check-add-composite-arg-leaf
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view locals)
                  borrowed0
                  bound?
                  binding-id
                  (tc-global-shared-view init)
                  result-lifetimes)
                (TcBorrowCheckResult.Ok borrowed0)))]
          [binding-ty : ast.AstType
            (tc-move-binding-type-id
              "borrow.return_arg_let_effect"
              ctx
              env
              (tc-global-shared-view maybe-ty)
              init-box)]
          (tc-borrow-check-add-composite-let-assignment-effect-at
            ctx
            expr-bases
            (tc-bind-initialized-value-id ctx env name binding-ty init)
            locals
            borrowed1
            bound?
            binding-id
            bindings
            body-box
            (+ index 1)
            later
            later-index
            result-lifetimes))])))

;; An initializer runs before the later initializers and the body, all of
;; which may still bind its stored names, then before `later`.
(define (tc-borrow-check-add-composite-let-init-effects
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [body-box : i64]
  [index : i64]
  [init : ast.AstExpr]
  [later : (& later ast.AstExprList)]
  [later-index : i64]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (if (tc-borrow-check-composite-has-store?
    expr-bases
    (tc-global-shared-view init))
    (let
      [ahead : ast.AstExprList
        (tc-borrow-check-composite-let-ahead bindings body-box (+ index 1))]
      [next : ast.AstExprList
        (tc-borrow-check-composite-later-list
          (& ahead)
          0
          ahead.len
          later
          later-index)]
      (tc-borrow-check-add-composite-assignment-effect
        ctx
        expr-bases
        env
        locals
        borrowed
        bound?
        binding-id
        init
        (& next)
        0
        result-lifetimes))
    (Ok borrowed)))

;; The value-position form: the body is the value the let returns.
(define (tc-borrow-check-add-composite-let-init-value-effects
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [body-box : i64]
  [index : i64]
  [init : ast.AstExpr]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (if (tc-borrow-check-composite-has-store?
    expr-bases
    (tc-global-shared-view init))
    (let
      [ahead : ast.AstExprList
        (tc-borrow-check-composite-let-ahead bindings body-box (+ index 1))]
      [next : ast.AstExprList
        (tc-borrow-check-composite-later-list
          (& ahead)
          0
          (- ahead.len 1)
          (& ahead)
          ahead.len)]
      (tc-borrow-check-add-composite-assignment-effect
        ctx
        expr-bases
        env
        locals
        borrowed
        bound?
        binding-id
        init
        (& next)
        0
        result-lifetimes))
    (Ok borrowed)))

;; A binding contributes to a composite argument only through a child whose
;; value reaches the argument. In particular, using a reference in a branch
;; condition or an earlier sequence form does not lend it to the call result.
(define (tc-borrow-check-composite-value-uses-name-in-list?
  [expr-bases : i64]
  [exprs : (& exprs ast.AstExprList)]
  [name : i64]
  [index : i64]) : bool
  (if (>= index exprs.len)
    false
    (or
      (tc-borrow-check-composite-value-uses-name?
        expr-bases
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get exprs index 0))
        name)
      (tc-borrow-check-composite-value-uses-name-in-list?
        expr-bases
        exprs
        name
        (+ index 1)))))

(define (tc-borrow-check-composite-selected-array-element-id
  [expr-bases : i64]
  [base : ast.AstExpr]
  [index-box : i64]) : i64
  (match (tc-move-literal-index
    expr-bases
    (ast.ast-expr-segment-bases-get expr-bases index-box))
    [(Some index)
      (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& base))
        [(Array items)
          (if (and (>= index 0) (< index items.len))
            (ast.ast-expr-list-get (& items) index 0)
            -1)]
        [(DynArray items)
          (if (and (>= index 0) (< index items.len))
            (ast.ast-expr-list-get (& items) index 0)
            -1)]
        [_ -1])]
    [(No) -1]))

(define (tc-borrow-check-composite-value-uses-name-in-last?
  [expr-bases : i64]
  [exprs : ast.AstExprList]
  [name : i64]) : bool
  (tc-borrow-check-composite-value-uses-name-in-sequence-from?
    expr-bases
    (& exprs)
    0
    name))

;; Later-list entries below -1 encode forms that may run zero or more times:
;; their uses count, but they never prove an earlier value overwritten.
(define (tc-borrow-check-composite-maybe-entry [id : i64]) : i64
  (- -2 id))

(define (tc-borrow-check-composite-entry-id [entry : i64]) : i64
  (if (< entry -1)
    (- -2 entry)
    entry))

;; `ahead` from `start`, with entries before `maybe-before` marked maybe,
;; followed by `later` from `later-index`.
(define (tc-borrow-check-composite-later-list
  [ahead : (& ahead ast.AstExprList)]
  [start : i64]
  [maybe-before : i64]
  [later : (& later ast.AstExprList)]
  [later-index : i64]) : ast.AstExprList
  (let
    [out : ast.AstExprList (ast.ast-expr-list-new)]
    [index : i64 start]
    (while (< index ahead.len)
      (ast.ast-expr-list-push
        (&mut out)
        (if (< index maybe-before)
          (tc-borrow-check-composite-maybe-entry
            (ast.ast-expr-list-get ahead index 0))
          (ast.ast-expr-list-get ahead index 0)))
      (set! index (+ index 1)))
    (ast.ast-expr-list-append-from (&mut out) later later-index)
    out))

(define (tc-borrow-check-composite-pair-list [first : i64] [second : i64]) : ast.AstExprList
  (let
    [out : ast.AstExprList (ast.ast-expr-list-new)]
    (ast.ast-expr-list-push (&mut out) first)
    (ast.ast-expr-list-push (&mut out) second)
    out))

(define (tc-borrow-check-composite-match-arm-bodies
  [arms : (& arms ast.AstMatchArmList)]) : ast.AstExprList
  (let
    [out : ast.AstExprList (ast.ast-expr-list-new)]
    [index : i64 0]
    (while (< index arms.len)
      (match (ast.ast-match-arm-list-get
        arms
        index
        (ast.ast-match-arm-fallback))
        [(Arm _ body-box) (ast.ast-expr-list-push (&mut out) body-box)])
      (set! index (+ index 1)))
    out))

;; The initializers from `index` on, then the body.
(define (tc-borrow-check-composite-let-ahead
  [bindings : (& bindings ast.AstLetBindingList)]
  [body-box : i64]
  [index : i64]) : ast.AstExprList
  (let
    [out : ast.AstExprList (ast.ast-expr-list-new)]
    [next : i64 index]
    (while (< next (ast.ast-let-binding-list-len bindings))
      (match (ast.ast-let-binding-list-get
        bindings
        next
        (ast.ast-let-binding-fallback))
        [(Binding _ _ init-box) (ast.ast-expr-list-push (&mut out) init-box)])
      (set! next (+ next 1)))
    (ast.ast-expr-list-push (&mut out) body-box)
    out))

(define (tc-borrow-check-composite-store? [expr : ast.AstExpr]) : bool
  (match (tc-global-shared-view expr)
    [(Set _ _) true]
    [_ (>= (tc-borrow-check-composite-store-place-id expr) 0)]))

(define (tc-borrow-check-composite-has-store?
  [expr-bases : i64]
  [expr : ast.AstExpr]) : bool
  (let
    [unspanned : ast.AstExpr
      (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))]
    (if (tc-borrow-check-composite-store? (tc-global-shared-view unspanned))
      true
      (let
        [children : ast.AstExprList (ast.ast-expr-child-ids unspanned)]
        [index : i64 0]
        [found : bool false]
        (while (and (not found) (< index children.len))
          (when
            (tc-borrow-check-composite-has-store?
              expr-bases
              (ast.ast-expr-segment-bases-get
                expr-bases
                (ast.ast-expr-list-get (& children) index 0)))
            (set! found true))
          (set! index (+ index 1)))
        found))))

;; `break` and `continue` skip the rest of a loop body.
(define (tc-borrow-check-composite-may-leave-loop?
  [expr-bases : i64]
  [expr : ast.AstExpr]) : bool
  (let
    [unspanned : ast.AstExpr
      (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))]
    (match (tc-global-shared-view unspanned)
      [(or (Break) (Continue)) true]
      [_
        (let
          [children : ast.AstExprList (ast.ast-expr-child-ids unspanned)]
          [index : i64 0]
          [found : bool false]
          (while (and (not found) (< index children.len))
            (when
              (tc-borrow-check-composite-may-leave-loop?
                expr-bases
                (ast.ast-expr-segment-bases-get
                  expr-bases
                  (ast.ast-expr-list-get (& children) index 0)))
              (set! found true))
            (set! index (+ index 1)))
          found)])))

(define (tc-borrow-check-composite-may-leave-loop-in?
  [expr-bases : i64]
  [exprs : (& exprs ast.AstExprList)]
  [start : i64]
  [end : i64]) : bool
  (let
    [index : i64 start]
    [found : bool false]
    (while (and (not found) (< index end))
      (when
        (tc-borrow-check-composite-may-leave-loop?
          expr-bases
          (ast.ast-expr-segment-bases-get
            expr-bases
            (tc-borrow-check-composite-entry-id
              (ast.ast-expr-list-get exprs index 0))))
        (set! found true))
      (set! index (+ index 1)))
    found))

;; Whether every normal completion of `expr` assigns the local `name`. Forms
;; without a rule here answer false, which only keeps more loans.
(define (tc-borrow-check-composite-assigns-name?
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [name : i64]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(Set target value-box)
      (or
        (= target name)
        (tc-borrow-check-composite-assigns-name?
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases value-box)
          name))]
    [(If cond-box then-box else-box)
      (or
        (tc-borrow-check-composite-assigns-name?
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases cond-box)
          name)
        (and
          (tc-borrow-check-composite-assigns-name?
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases then-box)
            name)
          (tc-borrow-check-composite-assigns-name?
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases else-box)
            name)))]
    [(or (Begin items) (Unsafe items))
      (tc-borrow-check-composite-assigns-name-in-list?
        expr-bases
        (& items)
        name)]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (tc-borrow-check-composite-let-assigns-name?
            expr-bases
            (& bindings)
            body-box
            name)])]
    [_ false]))

(define (tc-borrow-check-composite-assigns-name-in-list?
  [expr-bases : i64]
  [items : (& items ast.AstExprList)]
  [name : i64]) : bool
  (let
    [index : i64 0]
    [assigns : bool false]
    (while (and (not assigns) (< index items.len))
      (when
        (tc-borrow-check-composite-assigns-name?
          expr-bases
          (ast.ast-expr-segment-bases-get
            expr-bases
            (ast.ast-expr-list-get items index 0))
          name)
        (set! assigns true))
      (set! index (+ index 1)))
    assigns))

;; A binding of the same name hides the outer local from the forms after it.
(define (tc-borrow-check-composite-let-assigns-name?
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [body-box : i64]
  [name : i64]) : bool
  (let
    [index : i64 0]
    [assigns : bool false]
    [hidden : bool false]
    (while (and
      (not assigns)
      (not hidden)
      (< index (ast.ast-let-binding-list-len bindings)))
      (match (ast.ast-let-binding-list-get
        bindings
        index
        (ast.ast-let-binding-fallback))
        [(Binding binding-name _ init-box)
          (if (tc-borrow-check-composite-assigns-name?
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases init-box)
            name)
            (set! assigns true)
            (when (= binding-name name) (set! hidden true)))])
      (set! index (+ index 1)))
    (or
      assigns
      (and
        (not hidden)
        (tc-borrow-check-composite-assigns-name?
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases body-box)
          name)))))

;; Whether the last form, or a store before it, can carry `name` out of the
;; sequence. An assignment to `name` hides every later use unless it may run
;; zero times or a `break` or `continue` can skip it.
(define (tc-borrow-check-composite-value-uses-name-in-sequence-from?
  [expr-bases : i64]
  [exprs : (& exprs ast.AstExprList)]
  [start : i64]
  [name : i64]) : bool
  (if (>= start exprs.len)
    false
    (let
      [index : i64 start]
      [uses : bool false]
      [overwritten : bool false]
      (while (and (not uses) (not overwritten) (< index (- exprs.len 1)))
        (let
          [entry : i64 (ast.ast-expr-list-get exprs index 0)]
          [item : ast.AstExpr
            (ast.ast-expr-segment-bases-get
              expr-bases
              (tc-borrow-check-composite-entry-id entry))]
          (cond
            [(tc-borrow-check-composite-effect-uses-name?
                expr-bases
                (tc-global-shared-view item)
                exprs
                (+ index 1)
                name)
              (set! uses true)]
            [(< entry -1)
              (set!
                uses
                (tc-borrow-check-composite-value-uses-name?
                  expr-bases
                  (tc-global-shared-view item)
                  name))]
            [(and
                (tc-borrow-check-composite-assigns-name?
                  expr-bases
                  (tc-global-shared-view item)
                  name)
                (not
                  (tc-borrow-check-composite-may-leave-loop-in?
                    expr-bases
                    exprs
                    start
                    (+ index 1))))
              (set! overwritten true)]
            [else unit])
          (set! index (+ index 1))))
      (or
        uses
        (and
          (not overwritten)
          (tc-borrow-check-composite-value-uses-name?
            expr-bases
            (ast.ast-expr-segment-bases-get
              expr-bases
              (tc-borrow-check-composite-entry-id
                (ast.ast-expr-list-get exprs (- exprs.len 1) 0)))
            name))))))

(define (tc-borrow-check-composite-effect-uses-name-in-list?
  [expr-bases : i64]
  [items : (& items ast.AstExprList)]
  [index : i64]
  [later : (& later ast.AstExprList)]
  [later-index : i64]
  [name : i64]) : bool
  (if (>= index items.len)
    false
    (let
      [next : ast.AstExprList
        (tc-borrow-check-composite-later-list
          items
          (+ index 1)
          0
          later
          later-index)]
      (or
        (tc-borrow-check-composite-effect-uses-name?
          expr-bases
          (ast.ast-expr-segment-bases-get
            expr-bases
            (ast.ast-expr-list-get items index 0))
          (& next)
          0
          name)
        (tc-borrow-check-composite-effect-uses-name-in-list?
          expr-bases
          items
          (+ index 1)
          later
          later-index
          name)))))

(define (tc-borrow-check-composite-effect-uses-name-in-each?
  [expr-bases : i64]
  [items : (& items ast.AstExprList)]
  [later : (& later ast.AstExprList)]
  [later-index : i64]
  [name : i64]) : bool
  (let
    [index : i64 0]
    [uses : bool false]
    (while (and (not uses) (< index items.len))
      (when
        (tc-borrow-check-composite-effect-uses-name?
          expr-bases
          (ast.ast-expr-segment-bases-get
            expr-bases
            (ast.ast-expr-list-get items index 0))
          later
          later-index
          name)
        (set! uses true))
      (set! index (+ index 1)))
    uses))

(define (tc-borrow-check-composite-effect-uses-name-before?
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [ahead : (& ahead ast.AstExprList)]
  [start : i64]
  [maybe-before : i64]
  [later : (& later ast.AstExprList)]
  [later-index : i64]
  [name : i64]) : bool
  (and
    (tc-borrow-check-composite-has-store?
      expr-bases
      (tc-global-shared-view expr))
    (let
      [next : ast.AstExprList
        (tc-borrow-check-composite-later-list
          ahead
          start
          maybe-before
          later
          later-index)]
      (tc-borrow-check-composite-effect-uses-name?
        expr-bases
        expr
        (& next)
        0
        name))))

;; Whether `expr` stores a value that uses `name` somewhere `later` can read.
;; An untracked binding form answers false: the effect walker rejects any
;; store in one whose destination can hold the result's lifetimes.
(define (tc-borrow-check-composite-effect-uses-name?
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [later : (& later ast.AstExprList)]
  [later-index : i64]
  [name : i64]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(Set target value-box)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (or
          (and
            (tc-borrow-check-composite-value-uses-name?
              expr-bases
              (tc-global-shared-view value)
              name)
            (tc-borrow-check-composite-value-uses-name-in-sequence-from?
              expr-bases
              later
              later-index
              target))
          (tc-borrow-check-composite-effect-uses-name?
            expr-bases
            value
            later
            later-index
            name)))]
    [(If cond-box then-box else-box)
      (let
        [branches : ast.AstExprList
          (tc-borrow-check-composite-pair-list then-box else-box)]
        (or
          (tc-borrow-check-composite-effect-uses-name-before?
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases cond-box)
            (& branches)
            0
            branches.len
            later
            later-index
            name)
          (tc-borrow-check-composite-effect-uses-name-in-each?
            expr-bases
            (& branches)
            later
            later-index
            name)))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (tc-borrow-check-composite-effect-uses-name-in-let?
            expr-bases
            (& bindings)
            body-box
            later
            later-index
            name)])]
    [(or (Begin items) (Unsafe items))
      (tc-borrow-check-composite-effect-uses-name-in-list?
        expr-bases
        (& items)
        0
        later
        later-index
        name)]
    [(Match match-box)
      (match (ast.ast-match-box-shared-view match-box)
        [(Match scrut-box arms)
          (let
            [scrut : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases scrut-box)]
            [bodies : ast.AstExprList
              (tc-borrow-check-composite-match-arm-bodies (& arms))]
            (or
              (tc-borrow-check-composite-effect-uses-name-before?
                expr-bases
                (tc-global-shared-view scrut)
                (& bodies)
                0
                bodies.len
                later
                later-index
                name)
              (tc-borrow-check-composite-effect-uses-name-in-each?
                expr-bases
                (& bodies)
                later
                later-index
                name)
              (and
                (tc-borrow-check-composite-value-uses-name?
                  expr-bases
                  scrut
                  name)
                (tc-borrow-check-composite-match-arms-feed-pattern?
                  expr-bases
                  (& arms)
                  later
                  later-index))))])]
    [_
      (let
        [unspanned : ast.AstExpr
          (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))]
        [value-id : i64
          (tc-borrow-check-composite-store-value-id
            (tc-global-shared-view unspanned))]
        (cond
          [(>= value-id 0)
            (or
              (tc-borrow-check-composite-value-uses-name?
                expr-bases
                (ast.ast-expr-segment-bases-get expr-bases value-id)
                name)
              (tc-borrow-check-composite-children-effect-uses-name?
                expr-bases
                unspanned
                later
                later-index
                name))]
          [(tc-borrow-check-composite-binding-form?
              (tc-global-shared-view unspanned))
            false]
          [else
            (tc-borrow-check-composite-children-effect-uses-name?
              expr-bases
              unspanned
              later
              later-index
              name)]))]))

(define (tc-borrow-check-composite-children-effect-uses-name?
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [later : (& later ast.AstExprList)]
  [later-index : i64]
  [name : i64]) : bool
  (and
    (tc-borrow-check-composite-has-store?
      expr-bases
      (tc-global-shared-view expr))
    (let
      [children : ast.AstExprList (ast.ast-expr-child-ids expr)]
      [next : ast.AstExprList
        (tc-borrow-check-composite-later-list
          (& children)
          0
          children.len
          later
          later-index)]
      (tc-borrow-check-composite-effect-uses-name-in-each?
        expr-bases
        (& children)
        (& next)
        0
        name))))

(define (tc-borrow-check-composite-match-arms-feed-pattern?
  [expr-bases : i64]
  [arms : (& arms ast.AstMatchArmList)]
  [later : (& later ast.AstExprList)]
  [later-index : i64]) : bool
  (let
    [index : i64 0]
    [feeds : bool false]
    (while (and (not feeds) (< index arms.len))
      (match (ast.ast-match-arm-list-get
        arms
        index
        (ast.ast-match-arm-fallback))
        [(Arm pattern body-box)
          (let
            [names : TcNameIdList (tc-pattern-add-bound-name-ids pattern Nil)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (while (and (not feeds) (not (tc-name-id-list-empty? names)))
              (when
                (tc-borrow-check-composite-effect-uses-name?
                  expr-bases
                  (tc-global-shared-view body)
                  later
                  later-index
                  (tc-name-id-list-head names))
                (set! feeds true))
              (set! names (tc-name-id-list-rest names))))])
      (set! index (+ index 1)))
    feeds))

(define (tc-borrow-check-composite-let-effect-binding-feeds?
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [body-box : i64]
  [later : (& later ast.AstExprList)]
  [later-index : i64]
  [index : i64]
  [name : i64]) : bool
  (let
    [body : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases body-box)]
    [next : i64 (+ index 1)]
    [feeds : bool
      (tc-borrow-check-composite-effect-uses-name?
        expr-bases
        body
        later
        later-index
        name)]
    (while (and (not feeds) (< next (ast.ast-let-binding-list-len bindings)))
      (match (ast.ast-let-binding-list-get
        bindings
        next
        (ast.ast-let-binding-fallback))
        [(Binding later-name _ later-init-box)
          (let
            [later-init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases later-init-box)]
            (when
              (or
                (and
                  (tc-borrow-check-composite-value-uses-name?
                    expr-bases
                    (tc-global-shared-view later-init)
                    name)
                  (tc-borrow-check-composite-let-effect-binding-feeds?
                    expr-bases
                    bindings
                    body-box
                    later
                    later-index
                    next
                    later-name))
                (tc-borrow-check-composite-let-init-effect-uses-name?
                  expr-bases
                  bindings
                  body-box
                  next
                  later-init
                  later
                  later-index
                  name))
              (set! feeds true)))])
      (set! next (+ next 1)))
    feeds))

(define (tc-borrow-check-composite-effect-uses-name-in-let?
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [body-box : i64]
  [later : (& later ast.AstExprList)]
  [later-index : i64]
  [name : i64]) : bool
  (let
    [body : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases body-box)]
    [index : i64 0]
    [uses : bool
      (tc-borrow-check-composite-effect-uses-name?
        expr-bases
        body
        later
        later-index
        name)]
    (while (and (not uses) (< index (ast.ast-let-binding-list-len bindings)))
      (match (ast.ast-let-binding-list-get
        bindings
        index
        (ast.ast-let-binding-fallback))
        [(Binding binding-name _ init-box)
          (let
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            (when
              (or
                (and
                  (tc-borrow-check-composite-value-uses-name?
                    expr-bases
                    (tc-global-shared-view init)
                    name)
                  (tc-borrow-check-composite-let-effect-binding-feeds?
                    expr-bases
                    bindings
                    body-box
                    later
                    later-index
                    index
                    binding-name))
                (tc-borrow-check-composite-let-init-effect-uses-name?
                  expr-bases
                  bindings
                  body-box
                  index
                  init
                  later
                  later-index
                  name))
              (set! uses true)))])
      (set! index (+ index 1)))
    uses))

;; An initializer runs before the later initializers and the body, all of
;; which may still bind its stored names, then before `later`.
(define (tc-borrow-check-composite-let-init-effect-uses-name?
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [body-box : i64]
  [index : i64]
  [init : ast.AstExpr]
  [later : (& later ast.AstExprList)]
  [later-index : i64]
  [name : i64]) : bool
  (and
    (tc-borrow-check-composite-has-store?
      expr-bases
      (tc-global-shared-view init))
    (let
      [ahead : ast.AstExprList
        (tc-borrow-check-composite-let-ahead bindings body-box (+ index 1))]
      [next : ast.AstExprList
        (tc-borrow-check-composite-later-list
          (& ahead)
          0
          ahead.len
          later
          later-index)]
      (tc-borrow-check-composite-effect-uses-name?
        expr-bases
        init
        (& next)
        0
        name))))

;; The value-position form: the body is the value the let returns.
(define (tc-borrow-check-composite-let-init-value-effect-uses-name?
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [body-box : i64]
  [index : i64]
  [init : ast.AstExpr]
  [name : i64]) : bool
  (and
    (tc-borrow-check-composite-has-store?
      expr-bases
      (tc-global-shared-view init))
    (let
      [ahead : ast.AstExprList
        (tc-borrow-check-composite-let-ahead bindings body-box (+ index 1))]
      [next : ast.AstExprList
        (tc-borrow-check-composite-later-list
          (& ahead)
          0
          (- ahead.len 1)
          (& ahead)
          ahead.len)]
      (tc-borrow-check-composite-effect-uses-name?
        expr-bases
        init
        (& next)
        0
        name))))

(define (tc-borrow-check-composite-value-uses-name?
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [name : i64]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(Var var-name) (= var-name name)]
    [(If cond-box then-box else-box)
      (or
        (tc-borrow-check-composite-value-uses-name?
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases then-box)
          name)
        (tc-borrow-check-composite-value-uses-name?
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases else-box)
          name)
        (let
          [branches : ast.AstExprList
            (tc-borrow-check-composite-pair-list then-box else-box)]
          (tc-borrow-check-composite-effect-uses-name-before?
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases cond-box)
            (& branches)
            0
            1
            (& branches)
            branches.len
            name)))]
    [(or (Begin exprs) (Unsafe exprs) (WithRegion _ exprs) (WithEscape _ exprs)
         (InArena _ exprs) (WithScratch exprs))
      (tc-borrow-check-composite-value-uses-name-in-last? expr-bases exprs name)]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (tc-borrow-check-composite-value-uses-name-in-let?
            expr-bases
            (& bindings)
            body-box
            name)])]
    [(WithResource wr-box)
      (match (ast.ast-with-resource-box-shared-view wr-box)
        [(WithResource _ exprs)
          (tc-borrow-check-composite-value-uses-name-in-last?
            expr-bases
            exprs
            name)])]
    [(or (Ann inner-box _) (Cast inner-box _) (Try inner-box) (Box inner-box)
         (BoxGet inner-box) (BoxTake inner-box) (StructGet inner-box _))
      (tc-borrow-check-composite-value-uses-name?
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box)
        name)]
    [(ArrayRef base-box index-box)
      (let
        [base : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases base-box)]
        [selected : i64
          (tc-borrow-check-composite-selected-array-element-id
            expr-bases
            (tc-global-shared-view base)
            index-box)]
        (tc-borrow-check-composite-value-uses-name?
          expr-bases
          (if (>= selected 0)
            (ast.ast-expr-segment-bases-get expr-bases selected)
            base)
          name))]
    [(TupleRef base-box index)
      (let
        [base : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases base-box)]
        (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& base))
          [(Tuple items)
            (if (and (>= index 0) (< index items.len))
              (tc-borrow-check-composite-value-uses-name?
                expr-bases
                (ast.ast-expr-segment-bases-get
                  expr-bases
                  (ast.ast-expr-list-get (& items) index 0))
                name)
              (tc-borrow-check-composite-value-uses-name? expr-bases base name))]
          [_ (tc-borrow-check-composite-value-uses-name? expr-bases base name)]))]
    [(or (Tuple exprs) (Array exprs) (DynArray exprs))
      (tc-borrow-check-composite-value-uses-name-in-list?
        expr-bases
        (& exprs)
        name
        0)]
    [(Call func-box args)
      (or
        (tc-borrow-check-composite-value-uses-name?
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases func-box)
          name)
        (tc-borrow-check-composite-value-uses-name-in-list?
          expr-bases
          (& args)
          name
          0))]
    ;; Unsupported shapes remain conservative rather than dropping a loan.
    [_
      (tc-expr-uses-free-name? expr-bases expr (tc-env-key-name-text name) Nil)]))

(define (tc-borrow-check-composite-let-binding-feeds?
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [body-box : i64]
  [index : i64]
  [name : i64]) : bool
  (let
    [body : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases body-box)]
    [later : i64 (+ index 1)]
    [feeds : bool
      (tc-borrow-check-composite-value-uses-name? expr-bases body name)]
    (while (and (not feeds) (< later (ast.ast-let-binding-list-len bindings)))
      (match (ast.ast-let-binding-list-get
        bindings
        later
        (ast.ast-let-binding-fallback))
        [(Binding later-name _ later-init-box)
          (let
            [later-init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases later-init-box)]
            (when
              (or
                (and
                  (tc-borrow-check-composite-value-uses-name?
                    expr-bases
                    (tc-global-shared-view later-init)
                    name)
                  (tc-borrow-check-composite-let-binding-feeds?
                    expr-bases
                    bindings
                    body-box
                    later
                    later-name))
                (tc-borrow-check-composite-let-init-value-effect-uses-name?
                  expr-bases
                  bindings
                  body-box
                  later
                  later-init
                  name))
              (set! feeds true)))])
      (set! later (+ later 1)))
    feeds))

(define (tc-borrow-check-composite-value-uses-name-in-let?
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [body-box : i64]
  [name : i64]) : bool
  (let
    [body : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases body-box)]
    [index : i64 0]
    [uses : bool
      (tc-borrow-check-composite-value-uses-name? expr-bases body name)]
    (while (and (not uses) (< index (ast.ast-let-binding-list-len bindings)))
      (match (ast.ast-let-binding-list-get
        bindings
        index
        (ast.ast-let-binding-fallback))
        [(Binding binding-name _ init-box)
          (let
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            (when
              (or
                (and
                  (tc-borrow-check-composite-value-uses-name?
                    expr-bases
                    (tc-global-shared-view init)
                    name)
                  (tc-borrow-check-composite-let-binding-feeds?
                    expr-bases
                    bindings
                    body-box
                    index
                    binding-name))
                (tc-borrow-check-composite-let-init-value-effect-uses-name?
                  expr-bases
                  bindings
                  body-box
                  index
                  init
                  name))
              (set! uses true)))])
      (set! index (+ index 1)))
    uses))

(define (tc-borrow-check-add-composite-let-arg-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [body-box : i64]
  [index : i64]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (tc-borrow-check-add-composite-arg-leaf
      ctx
      expr-bases
      env
      locals
      borrowed
      bound?
      binding-id
      (ast.ast-expr-segment-bases-get expr-bases body-box)
      result-lifetimes)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name maybe-ty init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [borrowed0
            (try
              (tc-borrow-check-add-composite-let-init-value-effects
                ctx
                expr-bases
                env
                (tc-global-shared-view locals)
                borrowed
                bound?
                binding-id
                bindings
                body-box
                index
                (tc-global-shared-view init)
                result-lifetimes))]
          [borrowed1
            (try
              (if (tc-borrow-check-composite-let-binding-feeds?
                expr-bases
                bindings
                body-box
                index
                name)
                (tc-borrow-check-add-composite-arg-leaf
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view locals)
                  borrowed0
                  bound?
                  binding-id
                  (tc-global-shared-view init)
                  result-lifetimes)
                (TcBorrowCheckResult.Ok borrowed0)))]
          [binding-ty : ast.AstType
            (tc-move-binding-type-id
              "borrow.return_arg_let"
              ctx
              env
              maybe-ty
              init-box)]
          (tc-borrow-check-add-composite-let-arg-at
            ctx
            expr-bases
            (tc-bind-initialized-value-id ctx env name binding-ty init)
            locals
            borrowed1
            bound?
            binding-id
            bindings
            body-box
            (+ index 1)
            result-lifetimes))])))

(define (tc-borrow-check-composite-match-arm-uses-pattern?
  [ctx : TcContext]
  [expr-bases : i64]
  [scrut-ty : ast.AstType]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index arms.len)
    false
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (let
          [names : TcNameIdList
            (tc-borrow-check-pattern-bound-names
              ctx
              (tc-global-shared-view scrut-ty)
              pattern)]
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          [uses : bool false]
          (while (and (not uses) (not (tc-name-id-list-empty? names)))
            (when
              (tc-borrow-check-composite-value-uses-name?
                expr-bases
                (tc-global-shared-view body)
                (tc-name-id-list-head names))
              (set! uses true))
            (set! names (tc-name-id-list-rest names)))
          (or
            uses
            (tc-borrow-check-composite-match-arm-uses-pattern?
              ctx
              expr-bases
              scrut-ty
              arms
              (+ index 1))))])))

(define (tc-borrow-check-add-composite-match-arms-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [scrut-ty : ast.AstType]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (if (>= index arms.len)
    (Ok borrowed)
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (match (tc-bind-match-pattern
          ctx
          env
          (tc-global-shared-view scrut-ty)
          pattern)
          [(Ok arm-env)
            (let
              [borrowed1
                (try
                  (tc-borrow-check-add-composite-arg-leaf
                    ctx
                    expr-bases
                    arm-env
                    (tc-global-shared-view locals)
                    borrowed
                    bound?
                    binding-id
                    (ast.ast-expr-segment-bases-get expr-bases body-box)
                    result-lifetimes))]
              (tc-borrow-check-add-composite-match-arms-at
                ctx
                expr-bases
                env
                locals
                borrowed1
                bound?
                binding-id
                scrut-ty
                arms
                (+ index 1)
                result-lifetimes))]
          ;; An arm the checker cannot bind is already a type error.
          [(Err _)
            (tc-borrow-check-add-composite-match-arms-at
              ctx
              expr-bases
              env
              locals
              borrowed
              bound?
              binding-id
              scrut-ty
              arms
              (+ index 1)
              result-lifetimes)])])))

(define (tc-borrow-check-add-composite-match-arg
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [scrut-box : i64]
  [arms : ast.AstMatchArmList]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (let
    [scrut : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases scrut-box)]
    [bodies : ast.AstExprList
      (tc-borrow-check-composite-match-arm-bodies (& arms))]
    [borrowed0
      (try
        (tc-borrow-check-add-composite-assignment-effect-before
          ctx
          expr-bases
          env
          (tc-global-shared-view locals)
          borrowed
          bound?
          binding-id
          (tc-global-shared-view scrut)
          (& bodies)
          0
          (- bodies.len 1)
          (& bodies)
          bodies.len
          result-lifetimes))]
    (match (tc-expr ctx env (tc-global-shared-view scrut))
      [(Ok scrut-ty)
        (let
          [borrowed1
            (try
              (if (tc-borrow-check-composite-match-arm-uses-pattern?
                ctx
                expr-bases
                (tc-global-shared-view scrut-ty)
                (& arms)
                0)
                (tc-borrow-check-add-composite-arg-leaf
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view locals)
                  borrowed0
                  bound?
                  binding-id
                  scrut
                  result-lifetimes)
                (TcBorrowCheckResult.Ok borrowed0)))]
          (tc-borrow-check-add-composite-match-arms-at
            ctx
            expr-bases
            env
            locals
            borrowed1
            bound?
            binding-id
            scrut-ty
            (& arms)
            0
            result-lifetimes))]
      [(Err _) (Ok borrowed0)])))

;; Elements evaluate in order, so a store in one element can feed a later
;; element before every element keeps its own loans.
(define (tc-borrow-check-add-composite-elements
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [exprs : (& exprs ast.AstExprList)]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (let
    [borrowed1
      (try
        (tc-borrow-check-add-composite-sibling-effects-at
          ctx
          expr-bases
          env
          (tc-global-shared-view locals)
          borrowed
          bound?
          binding-id
          exprs
          0
          result-lifetimes))]
    (tc-borrow-check-add-composite-all-args-at
      ctx
      expr-bases
      env
      locals
      borrowed1
      bound?
      binding-id
      exprs
      0
      result-lifetimes)))

;; Every element of a constructed aggregate can reach the value a later
;; projection returns, so each keeps the loans its own type stores.
(define (tc-borrow-check-add-composite-all-args-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (if (>= index exprs.len)
    (Ok borrowed)
    (let
      [borrowed1
        (try
          (tc-borrow-check-add-composite-arg-leaf
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            borrowed
            bound?
            binding-id
            (ast.ast-expr-segment-bases-get
              expr-bases
              (ast.ast-expr-list-get exprs index 0))
            result-lifetimes))]
      (tc-borrow-check-add-composite-all-args-at
        ctx
        expr-bases
        env
        locals
        borrowed1
        bound?
        binding-id
        exprs
        (+ index 1)
        result-lifetimes))))

(define (tc-borrow-check-add-composite-arg
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bound? : bool]
  [binding-id : i64]
  [arg : ast.AstExpr]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& arg))
    [(If cond-box then-box else-box)
      (tc-borrow-check-add-composite-if-arg
        ctx
        expr-bases
        env
        locals
        borrowed
        bound?
        binding-id
        cond-box
        then-box
        else-box
        result-lifetimes)]
    [(or (Begin exprs) (Unsafe exprs) (WithRegion _ exprs) (WithEscape _ exprs)
         (InArena _ exprs) (WithScratch exprs))
      (tc-borrow-check-add-composite-last-arg
        ctx
        expr-bases
        env
        locals
        borrowed
        bound?
        binding-id
        exprs
        result-lifetimes)]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (tc-borrow-check-add-composite-let-arg-at
            ctx
            expr-bases
            env
            locals
            borrowed
            bound?
            binding-id
            (& bindings)
            body-box
            0
            result-lifetimes)])]
    [(Match match-box)
      (match (ast.ast-match-box-shared-view match-box)
        [(Match scrut-box arms)
          (tc-borrow-check-add-composite-match-arg
            ctx
            expr-bases
            env
            locals
            borrowed
            bound?
            binding-id
            scrut-box
            arms
            result-lifetimes)])]
    ;; Region blocks return their last form, like `begin`.
    [(WithResource wr-box)
      (match (ast.ast-with-resource-box-shared-view wr-box)
        [(WithResource bindings exprs)
          (match (tc-borrow-check-resource-bindings
            ctx
            expr-bases
            env
            locals
            (tc-moved-clone borrowed)
            bindings)
            [(Ok body-env body-locals _)
              (tc-borrow-check-add-composite-last-arg
                ctx
                expr-bases
                body-env
                body-locals
                borrowed
                bound?
                binding-id
                exprs
                result-lifetimes)]
            [(Err message) (Err message)])])]
    ;; A projection returns part of its base's value.
    [(TupleRef base-box index)
      (let
        [base : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases base-box)]
        (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& base))
          [(Tuple items)
            (if (and (>= index 0) (< index items.len))
              (let
                [borrowed1
                  (try
                    (tc-borrow-check-add-composite-sibling-effects-at
                      ctx
                      expr-bases
                      env
                      (tc-global-shared-view locals)
                      borrowed
                      bound?
                      binding-id
                      (& items)
                      0
                      result-lifetimes))]
                (tc-borrow-check-add-composite-arg-leaf
                  ctx
                  expr-bases
                  env
                  locals
                  borrowed1
                  bound?
                  binding-id
                  (ast.ast-expr-segment-bases-get
                    expr-bases
                    (ast.ast-expr-list-get (& items) index 0))
                  result-lifetimes))
              (tc-borrow-check-add-composite-arg-leaf
                ctx
                expr-bases
                env
                locals
                borrowed
                bound?
                binding-id
                base
                result-lifetimes))]
          [_
            (tc-borrow-check-add-composite-arg-leaf
              ctx
              expr-bases
              env
              locals
              borrowed
              bound?
              binding-id
              base
              result-lifetimes)]))]
    [(or (StructGet base-box _) (BoxTake base-box) (BoxGet base-box)
         (Try base-box) (Box base-box))
      (tc-borrow-check-add-composite-arg-leaf
        ctx
        expr-bases
        env
        locals
        borrowed
        bound?
        binding-id
        (ast.ast-expr-segment-bases-get expr-bases base-box)
        result-lifetimes)]
    [(ArrayRef base-box index-box)
      (let
        [base : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases base-box)]
        [selected : i64
          (tc-borrow-check-composite-selected-array-element-id
            expr-bases
            (tc-global-shared-view base)
            index-box)]
        (if (>= selected 0)
          (let
            [borrowed1
              (try
                (tc-borrow-check-add-composite-sibling-effects
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view locals)
                  borrowed
                  bound?
                  binding-id
                  base
                  result-lifetimes))]
            (tc-borrow-check-add-composite-arg-leaf
              ctx
              expr-bases
              env
              locals
              borrowed1
              bound?
              binding-id
              (ast.ast-expr-segment-bases-get expr-bases selected)
              result-lifetimes))
          (tc-borrow-check-add-composite-arg-leaf
            ctx
            expr-bases
            env
            locals
            borrowed
            bound?
            binding-id
            base
            result-lifetimes)))]
    ;; `try` returns the success payload of its operand. The error path exits
    ;; the function, so it cannot contribute to this call's result.
    [(or (Tuple exprs) (Array exprs) (DynArray exprs))
      (tc-borrow-check-add-composite-elements
        ctx
        expr-bases
        env
        locals
        borrowed
        bound?
        binding-id
        (& exprs)
        result-lifetimes)]
    [_
      (tc-borrow-check-add-composite-sibling-effects
        ctx
        expr-bases
        env
        locals
        borrowed
        bound?
        binding-id
        arg
        result-lifetimes)]))

(define (tc-borrow-check-add-bound-returned-call-arg-borrow
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [binding-id : i64]
  [arg : ast.AstExpr]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& arg))
    [(Borrow true _ place-box)
      (let
        [place : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases place-box)]
        (match (tc-borrow-check-place-path
          expr-bases
          (tc-global-shared-view place))
          [(Some path)
            (let
              [without-temporary
                : TcMovedSet
                ;; A second binding of the same lending borrow must not erase
                ;; the first binding's live marker while discarding its own
                ;; transient call effect. Keeping it makes the ordinary
                ;; mutable-borrow check report the aliasing conflict.
                (if (tc-borrow-check-has-lending-binding?
                  (tc-global-shared-view borrowed)
                  path)
                  (owned_view.compiler-owned-shared-view borrowed)
                  (tc-borrow-check-remove-borrow-path
                    (tc-global-shared-view borrowed)
                    path))]
              (match (tc-expr ctx env (tc-global-shared-view arg))
                [(Ok borrow-ty)
                  (match (tc-borrow-check-first-overlapping-lifetime
                    (tc-type-collect-reference-lifetimes
                      (tc-resolve-type ctx borrow-ty))
                    result-lifetimes)
                    [(Some _)
                      (let
                        [borrowed1
                          (try
                            (tc-borrow-check-add-place-with-mutability
                              expr-bases
                              locals
                              without-temporary
                              true
                              place
                              (tc-global-shared-view arg)))]
                        (Ok
                          (tc-borrow-check-add-lending-marker
                            borrowed1
                            path
                            binding-id
                            arg)))]
                    [(No) (Ok borrowed)])]
                [(Err _) (Ok borrowed)]))]
          [(No)
            (tc-borrow-check-add-returned-call-arg-borrow
              ctx
              expr-bases
              env
              locals
              borrowed
              arg
              result-lifetimes)]))]
    [(or (Ann inner-box _) (Cast inner-box _))
      (tc-borrow-check-add-bound-returned-call-arg-borrow
        ctx
        expr-bases
        env
        locals
        borrowed
        binding-id
        (ast.ast-expr-segment-bases-get expr-bases inner-box)
        result-lifetimes)]
    ;; A nested call lends what its own result stores. When that result carries
    ;; a lifetime this binding stores, the nested call's arguments keep their
    ;; borrows too: `(first (as-bytes (& wire)))` lends `wire` (#7968).
    [(Call _ inner-args)
      (match (tc-expr ctx env arg)
        [(Ok inner-ty)
          (let
            [inner-lifetimes : TcNameIdList
              (tc-name-id-list-intersection
                (tc-type-collect-reference-lifetimes
                  (tc-resolve-type ctx inner-ty))
                result-lifetimes)]
            (if (tc-name-id-list-empty? inner-lifetimes)
              (Ok borrowed)
              (tc-borrow-check-add-bound-returned-call-borrows
                ctx
                expr-bases
                env
                locals
                borrowed
                binding-id
                inner-args
                inner-lifetimes)))]
        [(Err _) (Ok borrowed)])]
    [_
      (tc-borrow-check-add-composite-arg
        ctx
        expr-bases
        env
        locals
        borrowed
        true
        binding-id
        arg
        result-lifetimes)]))

(define (tc-borrow-check-add-bound-returned-call-borrows-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [binding-id : i64]
  [args : (& args ast.AstExprList)]
  [index : i64]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (if (>= index args.len)
    (Ok borrowed)
    (let
      [borrowed1
        (try
          (tc-borrow-check-add-bound-returned-call-arg-borrow
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            borrowed
            binding-id
            (ast.ast-expr-segment-bases-get
              expr-bases
              (ast.ast-expr-list-get args index 0))
            result-lifetimes))]
      (tc-borrow-check-add-bound-returned-call-borrows-at
        ctx
        expr-bases
        env
        locals
        borrowed1
        binding-id
        args
        (+ index 1)
        result-lifetimes))))

(define (tc-borrow-check-add-bound-returned-call-borrows
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [binding-id : i64]
  [args : ast.AstExprList]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (let
    [borrowed1
      (try
        (tc-borrow-check-add-composite-sibling-effects-at
          ctx
          expr-bases
          env
          (tc-global-shared-view locals)
          borrowed
          true
          binding-id
          (& args)
          0
          result-lifetimes))]
    (tc-borrow-check-add-bound-returned-call-borrows-at
      ctx
      expr-bases
      env
      locals
      borrowed1
      binding-id
      (& args)
      0
      result-lifetimes)))

(define (tc-borrow-check-after-bind-known-type-id
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [binding-id : i64]
  [init-id : i64]
  [init-ty : ast.AstType]) : TcBorrowCheckResult
  (let
    [init : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases init-id)]
    (match (tc-move-bare-var expr-bases (tc-global-shared-view init))
      [(Some name-id name)
        (if (and
          (tc-moved-contains? locals name-id)
          (tc-move-var-move-only-id? ctx env locals name-id))
          (let
            [_
              (try
                (tc-borrow-check-move-conflict
                  expr-bases
                  (tc-global-shared-view borrowed)
                  (TcMovePath name-id (tc-move-path-segments-empty))
                  init))]
            (Ok borrowed))
          (Ok borrowed))]
      [(No)
        (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& init))
          [(Call func-box args)
            (let
              [func : ast.AstExpr
                (ast.ast-expr-segment-bases-get expr-bases func-box)]
              (if (or
                (tc-borrow-check-call-constructor? ctx func)
                (not
                  (tc-borrow-check-lending-result-type?
                    ctx
                    (tc-global-shared-view init-ty))))
                (tc-borrow-check-after-bind-typed
                  ctx
                  expr-bases
                  env
                  locals
                  borrowed
                  init
                  init-ty)
                (let
                  [borrowed1
                    (try
                      (tc-borrow-check-add-bound-returned-call-borrows
                        ctx
                        expr-bases
                        env
                        (tc-global-shared-view locals)
                        borrowed
                        binding-id
                        args
                        (tc-type-collect-reference-lifetimes
                          (tc-resolve-type ctx (tc-global-shared-view init-ty)))))]
                  (tc-borrow-check-after-bind-typed
                    ctx
                    expr-bases
                    env
                    locals
                    borrowed1
                    init
                    init-ty))))]
          [_
            (tc-borrow-check-after-bind-typed
              ctx
              expr-bases
              env
              locals
              borrowed
              init
              init-ty)])])))

(define (tc-borrow-check-prune-value-temporaries-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [prior : TcMovedSet]
  [facts : TcMovedPathFacts]
  [value : ast.AstExpr]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [path : TcMovePath fact.path]
      [kind : TcMovedPathKind fact.kind]
      [borrow-kind : bool
        (match kind
          [(or (BorrowShared) (BorrowMut) (BorrowTwoPhaseMut)) true]
          [_ false])]
      [new : bool
        (not
          (tc-moved-path-facts-contains-exact-kind?
            (tc-moved-paths (tc-global-shared-view prior))
            path
            kind))]
      [remove : bool
        (if (and borrow-kind new)
          (let
            [lifetime : i64 (tc-borrow-check-path-lifetime ctx env path)]
            (not
              (or
                (tc-borrow-check-expr-type-contains-lifetime?
                  ctx
                  env
                  (tc-global-shared-view value)
                  lifetime)
                (tc-borrow-check-expr-stores-lifetime?
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view value)
                  lifetime))))
          false)]
      [out2 : TcMovedSet
        (if remove
          (tc-moved-remove-path-kind out path kind)
          out)]
      (tc-borrow-check-prune-value-temporaries-at
        ctx
        expr-bases
        env
        prior
        rest
        value
        out2))))

;; Argument auto-borrows created while evaluating an assignment RHS end after
;; that value is produced unless the result or a nested store retains their
;; lifetime. Drop only newly introduced facts so pre-existing live borrows keep
;; protecting the assigned place.
(define (tc-borrow-check-prune-value-temporaries
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [prior : TcMovedSet]
  [borrowed : TcMovedSet]
  [value : ast.AstExpr]) : TcMovedSet
  (tc-borrow-check-prune-value-temporaries-at
    ctx
    expr-bases
    env
    prior
    (tc-moved-paths (tc-global-shared-view borrowed))
    value
    borrowed))

(define (tc-borrow-check-assignment
  [expr-bases : i64]
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [name-id : i64]
  [primary : ast.AstExpr]) : ResultTcUnit
  (tc-borrow-check-assign-conflict
    expr-bases
    borrowed
    (TcMovePath name-id (tc-move-path-segments-empty))
    primary))

(define (tc-borrow-check-array-set-conflict
  [expr-bases : i64]
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [array : ast.AstExpr]
  [index : ast.AstExpr]
  [primary : ast.AstExpr]) : ResultTcUnit
  (match (tc-move-root-projection-var-id
    expr-bases
    (tc-global-shared-view array))
    [(Some root-id)
      (match (tc-move-array-set-path expr-bases array index)
        [(Some path)
          (tc-borrow-check-assign-conflict expr-bases borrowed path primary)]
        [(No)
          (tc-borrow-check-assign-conflict
            expr-bases
            borrowed
            (TcMovePath root-id (tc-move-path-segments-empty))
            primary)])]
    [(No) Ok]))

(define (tc-borrow-check-struct-set-conflict
  [expr-bases : i64]
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [receiver : ast.AstExpr]
  [field-id : i64]
  [primary : ast.AstExpr]) : ResultTcUnit
  (match (tc-move-root-projection-var-id
    expr-bases
    (tc-global-shared-view receiver))
    [(Some root-id)
      (match (tc-move-struct-set-path expr-bases receiver field-id)
        [(Some path)
          (tc-borrow-check-assign-conflict expr-bases borrowed path primary)]
        [(No)
          (tc-borrow-check-assign-conflict
            expr-bases
            borrowed
            (TcMovePath root-id (tc-move-path-segments-empty))
            primary)])]
    [(No) Ok]))

(define (tc-borrow-check-root-mutation-conflict
  [expr-bases : i64]
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [place : ast.AstExpr]
  [primary : ast.AstExpr]) : ResultTcUnit
  (match (tc-move-root-projection-var-id expr-bases place)
    [(Some root-id)
      (tc-borrow-check-assign-conflict
        expr-bases
        borrowed
        (TcMovePath root-id (tc-move-path-segments-empty))
        primary)]
    [(No) Ok]))

(define (tc-borrow-check-region-invalidation-scan
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [region : i64]
  [seen : TcNameIdList]
  [remaining : i64]
  [primary : ast.AstExpr]) : TcBorrowCheckResult
  (if (<= remaining 0)
    (Ok borrowed)
    (match (tc-type-env-marker-step env)
      [(Done) (Ok borrowed)]
      [(Cache rest-env)
        (tc-borrow-check-region-invalidation-scan
          ctx
          expr-bases
          rest-env
          locals
          borrowed
          region
          seen
          remaining
          primary)]
      [(Bind key ty rest-env)
        (cond
          [(= key (tc-default-boundary-id)) (Ok borrowed)]
          [(tc-name-id-list-contains seen key)
            (tc-borrow-check-region-invalidation-scan
              ctx
              expr-bases
              rest-env
              locals
              borrowed
              region
              seen
              remaining
              primary)]
          [(not (tc-moved-contains? locals key))
            (tc-borrow-check-region-invalidation-scan
              ctx
              expr-bases
              rest-env
              locals
              borrowed
              region
              (tc-name-id-list-add seen key)
              remaining
              primary)]
          [(tc-type-contains-region ty region)
            (let
              [_
                (try
                  (tc-borrow-check-assign-conflict
                    expr-bases
                    (tc-global-shared-view borrowed)
                    (TcMovePath key (tc-move-path-segments-empty))
                    (tc-global-shared-view primary)))]
              (tc-borrow-check-region-invalidation-scan
                ctx
                expr-bases
                rest-env
                locals
                borrowed
                region
                (tc-name-id-list-add seen key)
                (- remaining 1)
                primary))]
          [else
            (tc-borrow-check-region-invalidation-scan
              ctx
              expr-bases
              rest-env
              locals
              borrowed
              region
              (tc-name-id-list-add seen key)
              (- remaining 1)
              primary)])])))

(define (tc-borrow-check-owner-invalidation-scan
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [owner : i64]
  [seen : TcNameIdList]
  [remaining : i64]
  [primary : ast.AstExpr]) : TcBorrowCheckResult
  (if (<= remaining 0)
    (Ok borrowed)
    (match (tc-type-env-marker-step env)
      [(Done) (Ok borrowed)]
      [(Cache rest-env)
        (tc-borrow-check-owner-invalidation-scan
          ctx
          expr-bases
          rest-env
          locals
          borrowed
          owner
          seen
          remaining
          primary)]
      [(Bind key ty rest-env)
        (cond
          [(= key (tc-default-boundary-id)) (Ok borrowed)]
          [(tc-name-id-list-contains seen key)
            (tc-borrow-check-owner-invalidation-scan
              ctx
              expr-bases
              rest-env
              locals
              borrowed
              owner
              seen
              remaining
              primary)]
          [(not (tc-moved-contains? locals key))
            (tc-borrow-check-owner-invalidation-scan
              ctx
              expr-bases
              rest-env
              locals
              borrowed
              owner
              (tc-name-id-list-add seen key)
              remaining
              primary)]
          [(tc-type-contains-arena-owner-region? env ty owner)
            (let
              [_
                (try
                  (tc-borrow-check-assign-conflict
                    expr-bases
                    (tc-global-shared-view borrowed)
                    (TcMovePath key (tc-move-path-segments-empty))
                    (tc-global-shared-view primary)))]
              (tc-borrow-check-owner-invalidation-scan
                ctx
                expr-bases
                rest-env
                locals
                borrowed
                owner
                (tc-name-id-list-add seen key)
                (- remaining 1)
                primary))]
          [else
            (tc-borrow-check-owner-invalidation-scan
              ctx
              expr-bases
              rest-env
              locals
              borrowed
              owner
              (tc-name-id-list-add seen key)
              (- remaining 1)
              primary)])])))

(define (tc-borrow-check-safe-arena-rewind-effect
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : ast.AstExprList]
  [primary : ast.AstExpr]) : TcBorrowCheckResult
  (if (ast.ast-expr-list-empty? (& args))
    (Ok borrowed)
    (let
      [phase-box : i64 (ast.ast-expr-list-get (& args) 0 0)]
      [phase-expr : ast.AstExpr
        (ast.ast-expr-segment-bases-get expr-bases phase-box)]
      [pid : i64 (tc-expr-var-name-id expr-bases phase-expr)]
      (if (>= pid 0)
        (let
          [_
            (try
              (tc-borrow-check-assign-conflict
                expr-bases
                (tc-global-shared-view borrowed)
                (TcMovePath pid (tc-move-path-segments-empty))
                (tc-global-shared-view primary)))]
          (match (tc-arena-phase-token-region-active env pid)
            [(Some region)
              (tc-borrow-check-region-invalidation-scan
                ctx
                expr-bases
                env
                (tc-global-shared-view locals)
                borrowed
                region
                Nil
                (tc-moved-len locals)
                primary)]
            [(No) (Ok borrowed)]))
        (Ok borrowed)))))

(define (tc-borrow-check-safe-arena-destroy-effect
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : ast.AstExprList]
  [primary : ast.AstExpr]) : TcBorrowCheckResult
  (if (ast.ast-expr-list-empty? (& args))
    (Ok borrowed)
    (let
      [owner-box : i64 (ast.ast-expr-list-get (& args) 0 0)]
      [owner-expr : ast.AstExpr
        (ast.ast-expr-segment-bases-get expr-bases owner-box)]
      (match (tc-body-type-fact-expr-id
        "borrow.safe_arena_destroy_owner"
        ctx
        env
        owner-box)
        [(Ok owner-ty)
          (match (tc-destroy-safe-owner-place-id
            ctx
            env
            (tc-global-shared-view owner-expr)
            owner-ty)
            [(Some owner-id)
              (match (tc-move-direct-root-base-path expr-bases owner-expr)
                [(Some owner-place)
                  (let
                    [_
                      (try
                        (tc-borrow-check-assign-conflict
                          expr-bases
                          (tc-global-shared-view borrowed)
                          owner-place
                          (tc-global-shared-view primary)))]
                    (tc-borrow-check-owner-invalidation-scan
                      ctx
                      expr-bases
                      env
                      (tc-global-shared-view locals)
                      borrowed
                      owner-id
                      Nil
                      (tc-moved-len locals)
                      primary))]
                [(No) (Ok borrowed)])]
            [(No) (Ok borrowed)])]
        [(Err _) (Ok borrowed)]))))

;; A call's `:invalidate` arguments end their brands exactly as a safe destroy
;; does: no live borrow of the argument place, and no live borrow of a value
;; tagged with the brand (#6670).
(define (tc-borrow-check-invalidate-call-effects
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : (& args ast.AstExprList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [primary : ast.AstExpr]) : TcBorrowCheckResult
  (if (or (>= index (ast.ast-type-list-len types)) (>= index args.len))
    (Ok borrowed)
    (let
      [formal : ast.AstType
        (ast.ty-node-get
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      [arg-box : i64 (ast.ast-expr-list-get args index 0)]
      [brand : TcMaybeNameId
        (match (tc-type-invalidate-lifetime (tc-global-shared-view formal))
          [(Some _)
            (match (tc-body-type-fact-expr-id
              "borrow.invalidate_argument"
              ctx
              env
              arg-box)
              [(Ok actual) (tc-invalidate-call-brand ctx env formal actual)]
              [(Err _) (No)])]
          [(No) (No)])]
      (match brand
        [(Some owner)
          (let
            [_
              (try
                (match (tc-move-direct-root-base-path
                  expr-bases
                  (ast.ast-expr-segment-bases-get expr-bases arg-box))
                  [(Some owner-place)
                    (tc-borrow-check-assign-conflict
                      expr-bases
                      (tc-global-shared-view borrowed)
                      owner-place
                      (tc-global-shared-view primary))]
                  [(No) ResultTcUnit.Ok]))]
            [borrowed1
              (try
                (tc-borrow-check-owner-invalidation-scan
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view locals)
                  borrowed
                  owner
                  Nil
                  (tc-moved-len locals)
                  (tc-global-shared-view primary)))]
            (tc-borrow-check-invalidate-call-effects
              ctx
              expr-bases
              env
              locals
              borrowed1
              args
              types
              (+ index 1)
              primary))]
        [(No)
          (tc-borrow-check-invalidate-call-effects
            ctx
            expr-bases
            env
            locals
            borrowed
            args
            types
            (+ index 1)
            primary)]))))

(define (tc-borrow-check-safe-arena-call-effects
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : ast.AstExpr]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : TcBorrowCheckResult
  (let
    [raw-id : i64 (tc-expr-var-name-id expr-bases func)]
    (if (>= raw-id 0)
      (let
        [raw-name : String
          (tc-hygiene-name-text-id-for-session
            (tc-context-structural-session ctx)
            raw-id)]
        [hygiene-global : bool
          (tc-hygiene-global-name-id?
            (tc-context-structural-session ctx)
            raw-id)]
        [name : String
          (if (and
            hygiene-global
            (not
              (macro-hygiene-global-id?
                (tc-context-structural-session ctx)
                raw-id)))
            (tc-hygiene-global-symbol-name raw-name)
            raw-name)]
        [name-id : i64
          (tc-builtin-symbol-name-id
            (tc-context-structural-session ctx)
            raw-id
            hygiene-global)]
        [lookup-id : i64 (tc-call-builtin-lookup-id ctx env name name-id)]
        [arena-call-kind : i64
          (tc-arena-safe-call-kind-id ctx env name-id lookup-id)]
        (cond
          [(= arena-call-kind (tc-arena-safe-call-kind-rewind))
            (tc-borrow-check-safe-arena-rewind-effect
              ctx
              expr-bases
              env
              locals
              borrowed
              args
              call-expr)]
          [(= arena-call-kind (tc-arena-safe-call-kind-destroy))
            (tc-borrow-check-safe-arena-destroy-effect
              ctx
              expr-bases
              env
              locals
              borrowed
              args
              call-expr)]
          [else (Ok borrowed)]))
      (Ok borrowed))))

(define (tc-string-has-suffix-at?
  [text : (& text str)]
  [suffix : String]
  [base : i64]
  [index : i64]
  [n : i64]) : bool
  (if (>= index n)
    true
    (if (=
      (cast (string.string-ref text (+ base index)) : i64)
      (cast (string.string-ref suffix index) : i64))
      (tc-string-has-suffix-at? text suffix base (+ index 1) n)
      false)))

(define (tc-string-has-suffix? [text : (& text str)] [suffix : String]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [suffix-len : i64 (string.string-length suffix)]
    (if (< text-len suffix-len)
      false
      (tc-string-has-suffix-at?
        text
        suffix
        (- text-len suffix-len)
        0
        suffix-len))))

(define (tc-borrow-check-after-call-effects
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : ast.AstExpr]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [types : ast.AstTypeList]
  [return-lifetimes : TcBorrowCallReturnLifetimes]) : TcBorrowCheckResult
  (let
    [borrowed0
      (try
        (match (if (tc-invalidate-types-present?)
          (tc-borrow-check-invalidate-call-effects
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            borrowed
            (& args)
            (& types)
            0
            (tc-global-shared-view call-expr))
          (TcBorrowCheckResult.Ok borrowed))
          [(Ok borrowed-invalidated)
            (tc-borrow-check-safe-arena-call-effects
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed-invalidated
              (tc-global-shared-view call-expr)
              func
              (tc-global-shared-view args))]
          [(Err message) (TcBorrowCheckResult.Err message)]))]
    (tc-borrow-check-after-returning-call
      ctx
      expr-bases
      env
      locals
      borrowed0
      call-expr
      args
      return-lifetimes)))

(define (tc-borrow-check-pattern-bound-names
  [ctx : TcContext]
  [scrut-ty : ast.AstType]
  [pattern : ast.AstPattern]) : TcNameIdList
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-match-coverage-type ctx scrut-ty)))
    [(or (ast.AstType.Enum _) (ast.AstType.EnumArgs _ _))
      (match (tc-global-shared-view pattern)
        [(ast.AstPattern.Variant _ patterns-box)
          (let
            [patterns : ast.AstPatternList
              (ast.ast-pattern-list-box-shared-view patterns-box)]
            (tc-pattern-list-add-bound-name-ids patterns TcNameIdList.Nil))]
        [(ast.AstPattern.Or _)
          (tc-enum-arm-pattern-bound-name-ids pattern TcNameIdList.Nil)]
        [_ TcNameIdList.Nil])]
    [_ (tc-pattern-add-bound-name-ids pattern TcNameIdList.Nil)]))

(define (tc-borrow-check-pattern-locals
  [ctx : TcContext]
  [scrut-ty : ast.AstType]
  [pattern : ast.AstPattern]
  [locals : TcMovedSet]) : TcMovedSet
  (tc-move-add-bound-names
    locals
    (tc-borrow-check-pattern-bound-names ctx scrut-ty pattern)))

;; A borrowed call-argument temporary (section 3.10) borrows storage that no
;; place names, so it adds no loan. Its operand's reads, and the value it
;; consumes into that storage, are checked like a by-value argument.
(define (tc-borrow-check-temporary-operand
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [operand-box : i64]) : TcBorrowCheckResult
  (let
    [operand : ast.AstExpr
      (ast.ast-expr-segment-bases-get expr-bases operand-box)]
    [borrowed1
      (try
        (tc-borrow-check-expr
          ctx
          expr-bases
          env
          (tc-global-shared-view locals)
          borrowed
          (tc-global-shared-view operand)))]
    (match (tc-body-type-fact-expr-id
      "borrow.call_arg_temporary"
      ctx
      env
      operand-box)
      [(ResultTcType.Ok operand-ty)
        (tc-borrow-check-after-consuming-value
          ctx
          expr-bases
          env
          locals
          borrowed1
          operand
          operand-ty)]
      [(ResultTcType.Err _) (TcBorrowCheckResult.Ok borrowed1)])))

(define (tc-borrow-check-effective-arg-with-type
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [arg : ast.AstExpr]
  [ty : ast.AstType]
  [foreign-boundary : bool]) : TcBorrowCheckResult
  (let
    [borrowed1
      (try
        (tc-borrow-check-expr
          ctx
          expr-bases
          env
          (tc-global-shared-view locals)
          borrowed
          (tc-global-shared-view arg)))]
    (if foreign-boundary
      (if (= (tc-moved-len borrowed1) 0)
        (Ok borrowed1)
        (tc-borrow-check-place-read-conflict
          expr-bases
          locals
          borrowed1
          (tc-global-shared-view arg)
          arg))
      (let
        [borrowed2
          (try
            (tc-borrow-check-after-consuming-value
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed1
              (tc-global-shared-view arg)
              (tc-global-shared-view ty)))]
        (if (= (tc-moved-len borrowed2) 0)
          (Ok borrowed2)
          (tc-borrow-check-after-reading-value
            ctx
            expr-bases
            env
            locals
            borrowed2
            arg
            ty))))))

(define (tc-borrow-check-arg-with-type
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [arg : ast.AstExpr]
  [ty : ast.AstType]) : TcBorrowCheckResult
  (match (compiler-tc-reinfer-profiled
    ctx
    "borrow.call_arg"
    (tc-call-effective-arg-expr
      ctx
      env
      (tc-global-shared-view arg)
      (tc-global-shared-view ty)))
    [(Ok effective)
      (tc-borrow-check-effective-arg-with-type
        ctx
        expr-bases
        env
        locals
        borrowed
        effective
        ty
        false)]
    [(Err message) (Err (tc-locate-error-at-expr expr-bases arg message))]))

(define (tc-borrow-check-exprs-with-types
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : ast.AstExprList]
  [types : ast.AstTypeList]) : TcBorrowCheckResult
  (tc-borrow-check-exprs-with-types-at
    ctx
    expr-bases
    env
    locals
    borrowed
    (& exprs)
    (& types)
    0))

(define (tc-borrow-check-exprs-with-types-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : (& exprs ast.AstExprList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index exprs.len)
    (if (>= index (ast.ast-type-list-len types))
      (Ok borrowed)
      (Err (tc-call-arity-invariant-message "borrow-check")))
    (if (>= index (ast.ast-type-list-len types))
      (Err (tc-call-arity-invariant-message "borrow-check"))
      (let
        [head-expr : ast.AstExpr
          (ast.ast-expr-segment-bases-get
            expr-bases
            (ast.ast-expr-list-get exprs index 0))]
        [ty : ast.AstType
          (ast.ty-node-get
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
        [borrowed1
          (try
            (tc-borrow-check-arg-with-type
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed
              head-expr
              ty))]
        (tc-borrow-check-exprs-with-types-at
          ctx
          expr-bases
          env
          locals
          borrowed1
          exprs
          types
          (+ index 1))))))

(define (tc-borrow-check-activate-two-phase-mut-borrows-loop
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [facts : TcMovedPathFacts]
  [primary : ast.AstExpr]) : TcBorrowCheckResult
  (if (tc-moved-path-facts-empty? facts)
    (Ok borrowed)
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      (match fact.kind
        [(BorrowTwoPhaseMut)
          (let
            [path : TcMovePath fact.path]
            (match (tc-moved-path-conflict
              (tc-global-shared-view borrowed)
              path)
              [(Some _ _)
                (Err
                  (tc-borrow-check-rich-conflict-message
                    expr-bases
                    borrowed
                    path
                    (BorrowShared)
                    primary
                    (tc-borrow-check-mutably-borrow-message
                      (tc-move-path-render path))))]
              [No
                (tc-borrow-check-activate-two-phase-mut-borrows-loop
                  expr-bases
                  borrowed
                  rest
                  primary)]))]
        [_
          (tc-borrow-check-activate-two-phase-mut-borrows-loop
            expr-bases
            borrowed
            rest
            primary)]))))

(define (tc-borrow-check-activate-two-phase-mut-borrows
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [primary : ast.AstExpr]) : TcBorrowCheckResult
  (tc-borrow-check-activate-two-phase-mut-borrows-loop
    expr-bases
    (tc-global-shared-view borrowed)
    (tc-moved-paths borrowed)
    primary))

(define (tc-borrow-check-reserve-two-phase-mut-call-arg
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [borrow-expr : ast.AstExpr]
  [place : ast.AstExpr]) : TcBorrowCheckResult
  (let
    [borrowed0
      (try
        (tc-borrow-check-place-read-conflict
          expr-bases
          (tc-global-shared-view locals)
          borrowed
          (tc-global-shared-view place)
          (tc-global-shared-view borrow-expr)))]
    [borrowed1
      (try
        (tc-borrow-check-expr
          ctx
          expr-bases
          env
          (tc-global-shared-view locals)
          borrowed0
          (tc-global-shared-view place)))]
    [_ (try (tc-borrow-place ctx expr-bases env (tc-global-shared-view place)))]
    (tc-borrow-check-add-two-phase-mut-place
      expr-bases
      locals
      borrowed1
      place
      borrow-expr)))

(define (tc-borrow-check-call-args-two-phase-with-types
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [reserved : bool]
  [call-expr : ast.AstExpr]
  [pending-scope-id : i64]
  [exprs : ast.AstExprList]
  [types : ast.AstTypeList]
  [foreign-boundary : bool]) : TcBorrowCheckResult
  (tc-borrow-check-call-args-two-phase-with-types-at
    ctx
    expr-bases
    env
    locals
    borrowed
    reserved
    call-expr
    pending-scope-id
    (& exprs)
    (& types)
    foreign-boundary
    0))

(define (tc-borrow-check-call-args-two-phase-retry-after-prune
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [reserved : bool]
  [call-expr : ast.AstExpr]
  [pending-scope-id : i64]
  [exprs : (& exprs ast.AstExprList)]
  [types : (& types ast.AstTypeList)]
  [foreign-boundary : bool]
  [index : i64]
  [message : String]) : TcBorrowCheckResult
  (let
    [current-and-pending : ast.AstExprList
      (ast.ast-expr-list-tail-from-ref exprs index)]
    [borrowed0 : TcMovedSet
      (tc-borrow-check-prune-before-exprs
        expr-bases
        ctx
        env
        (tc-global-shared-view locals)
        (tc-global-shared-view borrowed)
        (tc-global-shared-view borrowed)
        current-and-pending)]
    (if (= (tc-moved-len borrowed0) (tc-moved-len borrowed))
      (Err message)
      (tc-borrow-check-call-args-two-phase-with-types-at
        ctx
        expr-bases
        env
        locals
        borrowed0
        reserved
        call-expr
        pending-scope-id
        exprs
        types
        foreign-boundary
        index))))

(define (tc-borrow-check-call-args-two-phase-with-types-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [reserved : bool]
  [call-expr : ast.AstExpr]
  [pending-scope-id : i64]
  [exprs : (& exprs ast.AstExprList)]
  [types : (& types ast.AstTypeList)]
  [foreign-boundary : bool]
  [index : i64]) : TcBorrowCheckResult
  (when
    (>= index exprs.len)
    (return
      (if (>= index (ast.ast-type-list-len types))
        (if reserved
          (tc-borrow-check-activate-two-phase-mut-borrows
            expr-bases
            borrowed
            call-expr)
          (Ok borrowed))
        (Err (tc-call-arity-invariant-message "borrow-check")))))
  (when
    (>= index (ast.ast-type-list-len types))
    (return (Err (tc-call-arity-invariant-message "borrow-check"))))
  (let
    [pending-exprs : ast.AstExprList
      (ast.ast-expr-list-tail-from-ref exprs (+ index 1))]
    [scoped-borrowed : TcMovedSet
      (tc-borrow-check-add-all-pending-markers
        (tc-global-shared-view borrowed)
        pending-exprs
        pending-scope-id)]
    [head-expr : ast.AstExpr
      (ast.ast-expr-segment-bases-get
        expr-bases
        (ast.ast-expr-list-get exprs index 0))]
    [raw-ty : ast.AstType
      (ast.ty-node-get
        (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
    (match (compiler-tc-reinfer-profiled
      ctx
      "borrow.call_arg"
      (tc-call-effective-arg-expr
        ctx
        env
        (tc-global-shared-view head-expr)
        (tc-global-shared-view raw-ty)))
      [(Ok effective-head)
        (match (ast.ast-expr-unspan-with-segment-bases
          expr-bases
          (& effective-head))
          [(Borrow mutable _ place-box)
            (if (and
              mutable
              (tc-call-mutable-ref-formal? ctx (tc-global-shared-view raw-ty))
              ;; A borrowed temporary reserves no place.
              (not (tc-borrow-operand-id-temporary? expr-bases place-box)))
              (let
                [place : ast.AstExpr
                  (ast.ast-expr-segment-bases-get expr-bases place-box)]
                (match (tc-borrow-check-reserve-two-phase-mut-call-arg
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view locals)
                  scoped-borrowed
                  effective-head
                  place)
                  [(Ok borrowed1)
                    (tc-borrow-check-call-args-two-phase-with-types-at
                      ctx
                      expr-bases
                      env
                      locals
                      (tc-borrow-check-remove-pending-markers
                        borrowed1
                        pending-scope-id)
                      true
                      call-expr
                      pending-scope-id
                      exprs
                      types
                      foreign-boundary
                      (+ index 1))]
                  [(Err message)
                    (tc-borrow-check-call-args-two-phase-retry-after-prune
                      ctx
                      expr-bases
                      env
                      locals
                      borrowed
                      reserved
                      call-expr
                      pending-scope-id
                      exprs
                      types
                      foreign-boundary
                      index
                      message)]))
              (match (tc-borrow-check-effective-arg-with-type
                ctx
                expr-bases
                env
                (tc-global-shared-view locals)
                scoped-borrowed
                effective-head
                raw-ty
                foreign-boundary)
                [(Ok borrowed1)
                  (tc-borrow-check-call-args-two-phase-with-types-at
                    ctx
                    expr-bases
                    env
                    locals
                    (tc-borrow-check-remove-pending-markers
                      borrowed1
                      pending-scope-id)
                    reserved
                    call-expr
                    pending-scope-id
                    exprs
                    types
                    foreign-boundary
                    (+ index 1))]
                [(Err message)
                  (tc-borrow-check-call-args-two-phase-retry-after-prune
                    ctx
                    expr-bases
                    env
                    locals
                    borrowed
                    reserved
                    call-expr
                    pending-scope-id
                    exprs
                    types
                    foreign-boundary
                    index
                    message)]))]
          [_
            (match (tc-borrow-check-effective-arg-with-type
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              scoped-borrowed
              effective-head
              raw-ty
              foreign-boundary)
              [(Ok borrowed1)
                (tc-borrow-check-call-args-two-phase-with-types-at
                  ctx
                  expr-bases
                  env
                  locals
                  (tc-borrow-check-remove-pending-markers
                    borrowed1
                    pending-scope-id)
                  reserved
                  call-expr
                  pending-scope-id
                  exprs
                  types
                  foreign-boundary
                  (+ index 1))]
              [(Err message)
                (tc-borrow-check-call-args-two-phase-retry-after-prune
                  ctx
                  expr-bases
                  env
                  locals
                  borrowed
                  reserved
                  call-expr
                  pending-scope-id
                  exprs
                  types
                  foreign-boundary
                  index
                  message)])])]
      [(Err message)
        (Err (tc-locate-error-at-expr expr-bases head-expr message))])))

(define (tc-call-explicit-borrow-expr? [expr-bases : i64] [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(Borrow _ _ _) true]
    [_ false]))

(define (tc-borrow-check-add-call-arg-auto-borrow
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [arg : ast.AstExpr]
  [ty : ast.AstType]) : TcBorrowCheckResult
  (if (tc-call-explicit-borrow-expr? expr-bases (tc-global-shared-view arg))
    (Ok borrowed)
    (match (compiler-tc-reinfer-profiled
      ctx
      "borrow.call_arg"
      (tc-call-effective-arg-expr ctx env (tc-global-shared-view arg) ty))
      [(Ok effective)
        (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& effective))
          [(Borrow mutable _ place-box)
            (let
              [place : ast.AstExpr
                (ast.ast-expr-segment-bases-get expr-bases place-box)]
              (tc-borrow-check-add-place-with-mutability
                expr-bases
                locals
                borrowed
                mutable
                place
                arg))]
          [_ (Ok borrowed)])]
      [(Err message) (Err (tc-locate-error-at-expr expr-bases arg message))])))

(define (tc-borrow-check-auto-borrowed-call-args
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : ast.AstExprList]
  [types : ast.AstTypeList]) : TcBorrowCheckResult
  (tc-borrow-check-auto-borrowed-call-args-at
    ctx
    expr-bases
    env
    locals
    borrowed
    (& args)
    (& types)
    0))

(define (tc-borrow-check-auto-borrowed-call-args-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : (& args ast.AstExprList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index args.len)
    (if (>= index (ast.ast-type-list-len types))
      (Ok borrowed)
      (Err (tc-call-arity-invariant-message "borrow-check")))
    (if (>= index (ast.ast-type-list-len types))
      (Err (tc-call-arity-invariant-message "borrow-check"))
      (let
        [head-expr : ast.AstExpr
          (ast.ast-expr-segment-bases-get
            expr-bases
            (ast.ast-expr-list-get args index 0))]
        [ty : ast.AstType
          (ast.ty-node-get
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
        [borrowed1
          (try
            (tc-borrow-check-add-call-arg-auto-borrow
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed
              head-expr
              ty))]
        (tc-borrow-check-auto-borrowed-call-args-at
          ctx
          expr-bases
          env
          locals
          borrowed1
          args
          types
          (+ index 1))))))

(define (tc-borrow-check-thread-channel-send-message
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]) : TcBorrowCheckResult
  (if (tc-thread-channel-send-call? ctx env (tc-global-shared-view func))
    (match (tc-thread-channel-send-call-name ctx func)
      [(Some _)
        (let
          [message-ty : ast.AstType
            (try (tc-thread-channel-send-message-param params))]
          [message-expr : ast.AstExpr
            (try (tc-thread-channel-send-message-arg expr-bases args))]
          (tc-borrow-check-after-move-only-value
            ctx
            expr-bases
            env
            locals
            borrowed
            message-expr
            message-ty))]
      [(No) (Ok borrowed)])
    (Ok borrowed)))

(define (tc-borrow-check-call-args-with-types
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : ast.AstExpr]
  [pending-scope-id : i64]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [types : ast.AstTypeList]
  [foreign-boundary : bool]
  [return-lifetimes : TcBorrowCallReturnLifetimes]) : TcBorrowCheckResult
  (let
    [validation-borrowed : TcMovedSet (tc-moved-clone borrowed)]
    [validation-result : TcBorrowCheckResult
      (tc-borrow-check-call-args-two-phase-with-types
        ctx
        expr-bases
        env
        (tc-global-shared-view locals)
        validation-borrowed
        false
        (tc-global-shared-view call-expr)
        pending-scope-id
        (tc-global-shared-view args)
        (tc-global-shared-view types)
        foreign-boundary)]
    [checked-borrowed : TcMovedSet (try validation-result)]
    [borrowed-with-uses : TcMovedSet
      (tc-borrow-check-propagate-lending-uses checked-borrowed borrowed)]
    (if (tc-call-type-list-has-immutable-ref-formal? ctx types)
      (let
        [borrowed2
          (try
            (tc-borrow-check-auto-borrowed-call-args
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view borrowed-with-uses)
              (tc-global-shared-view args)
              (tc-global-shared-view types)))]
        [borrowed3
          (try
            (tc-borrow-check-thread-channel-send-message
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              (tc-global-shared-view borrowed2)
              (tc-global-shared-view func)
              (tc-global-shared-view args)
              (tc-global-shared-view types)))]
        [borrowed4
          (try
            (tc-borrow-check-after-call-effects
              ctx
              expr-bases
              env
              locals
              borrowed3
              (tc-global-shared-view call-expr)
              func
              args
              types
              return-lifetimes))]
        ;; Auto-borrows are call temporaries unless the resolved
        ;; result type retains their lifetime. This is the same
        ;; type-driven lifetime pruning used for assignment
        ;; values; it must not depend on the callee's spelling.
        (if (= (tc-moved-len borrowed2) (tc-moved-len borrowed-with-uses))
          (Ok borrowed4)
          (Ok
            (tc-borrow-check-prune-value-temporaries
              ctx
              expr-bases
              env
              borrowed-with-uses
              borrowed4
              call-expr))))
      (let
        [borrowed2
          (try
            (tc-borrow-check-thread-channel-send-message
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed-with-uses
              (tc-global-shared-view func)
              (tc-global-shared-view args)
              (tc-global-shared-view types)))]
        (tc-borrow-check-after-call-effects
          ctx
          expr-bases
          env
          locals
          borrowed2
          call-expr
          func
          args
          types
          return-lifetimes)))))

(define (tc-borrow-check-exprs-retry-after-prune
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [pending-scope-id : i64]
  [exprs : ast.AstExprList]
  [head : ast.AstExpr]
  [rest : ast.AstExprList]
  [message : String]) : TcBorrowCheckResult
  (if (= (tc-moved-len borrowed) 0)
    (Err message)
    (let
      [unscoped : TcMovedSet
        (tc-borrow-check-remove-pending-markers borrowed pending-scope-id)]
      [borrowed0 : TcMovedSet
        (tc-borrow-check-prune-before-exprs
          expr-bases
          ctx
          env
          (tc-global-shared-view locals)
          (tc-global-shared-view unscoped)
          (tc-global-shared-view protected)
          exprs)]
      (if (= (tc-moved-len borrowed0) (tc-moved-len unscoped))
        (Err message)
        (let
          [borrowed1
            (try
              (tc-borrow-check-expr
                ctx
                expr-bases
                env
                (tc-global-shared-view locals)
                borrowed0
                head))]
          (tc-borrow-check-exprs-with-protected
            ctx
            expr-bases
            env
            locals
            (tc-borrow-check-remove-pending-markers borrowed1 pending-scope-id)
            protected
            rest))))))

(define (tc-borrow-check-exprs-with-protected
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : ast.AstExprList]) : TcBorrowCheckResult
  (tc-borrow-check-exprs-with-protected-at
    ctx
    expr-bases
    env
    locals
    borrowed
    protected
    (& exprs)
    0))

(define (tc-borrow-check-exprs-with-protected-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index exprs.len)
    (Ok borrowed)
    (let
      [head : i64 (ast.ast-expr-list-get exprs index 0)]
      [rest : ast.AstExprList
        (ast.ast-expr-list-tail-from-ref exprs (+ index 1))]
      [scoped-borrowed : TcMovedSet
        (tc-borrow-check-add-all-pending-markers
          borrowed
          (tc-global-shared-view rest)
          head)]
      (match (tc-borrow-check-expr-id
        ctx
        expr-bases
        env
        (tc-global-shared-view locals)
        (tc-global-shared-view scoped-borrowed)
        head)
        [(Ok borrowed1)
          (tc-borrow-check-exprs-with-protected-at
            ctx
            expr-bases
            env
            locals
            (tc-borrow-check-remove-pending-markers borrowed1 head)
            protected
            exprs
            (+ index 1))]
        [(Err message)
          (let
            [head-expr : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases head)]
            [current : ast.AstExprList
              (ast.ast-expr-list-tail-from-ref exprs index)]
            (tc-borrow-check-exprs-retry-after-prune
              ctx
              expr-bases
              env
              locals
              scoped-borrowed
              protected
              head
              current
              head-expr
              rest
              message))]))))

(define (tc-borrow-check-exprs
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : ast.AstExprList]) : TcBorrowCheckResult
  (tc-borrow-check-exprs-with-protected
    ctx
    expr-bases
    env
    locals
    (tc-global-shared-view borrowed)
    borrowed
    exprs))

(define (tc-borrow-check-expr-with-protected-id
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [expr-id : i64]) : TcBorrowCheckResult
  (tc-borrow-check-expr-with-protected
    ctx
    expr-bases
    env
    locals
    borrowed
    protected
    (ast.ast-expr-segment-bases-get expr-bases expr-id)))

(define (tc-borrow-check-expr-with-protected
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [expr : ast.AstExpr]) : TcBorrowCheckResult
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(or (Begin exprs) (Unsafe exprs))
      (tc-borrow-check-exprs-with-protected
        ctx
        expr-bases
        env
        locals
        borrowed
        protected
        exprs)]
    [_
      (tc-borrow-check-expr
        ctx
        expr-bases
        env
        locals
        borrowed
        (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr)))]))

(define (tc-borrow-check-expr-id-retry-after-prune
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [expr-id : i64]
  [message : String]) : TcBorrowCheckResult
  (let
    [pending : ast.AstExprList (ast.ast-expr-list-with-capacity 1)]
    (ast.ast-expr-list-push (&mut pending) expr-id)
    (let
      [borrowed0 : TcMovedSet
        (tc-borrow-check-prune-before-exprs
          expr-bases
          ctx
          env
          (tc-global-shared-view locals)
          (tc-global-shared-view borrowed)
          (tc-global-shared-view protected)
          pending)]
      (if (= (tc-moved-len borrowed0) (tc-moved-len borrowed))
        (Err message)
        (tc-borrow-check-expr-with-protected-id
          ctx
          expr-bases
          env
          locals
          borrowed0
          protected
          expr-id)))))

(define (tc-borrow-check-expr-type-contains-lifetime?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [lifetime : i64]) : bool
  (match (tc-expr ctx env expr)
    [(Ok ty) (tc-borrow-check-type-contains-lifetime? ctx ty lifetime)]
    [(Err _) false]))

(define (tc-borrow-check-expr-list-stores-lifetime?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]
  [lifetime : i64]) : bool
  (tc-borrow-check-expr-list-stores-lifetime-at?
    ctx
    expr-bases
    env
    (& exprs)
    0
    lifetime))

(define (tc-borrow-check-expr-list-stores-lifetime-at?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [lifetime : i64]) : bool
  (if (>= index exprs.len)
    false
    (if (tc-borrow-check-expr-stores-lifetime?
      ctx
      expr-bases
      env
      (ast.ast-expr-segment-bases-get
        expr-bases
        (ast.ast-expr-list-get exprs index 0))
      lifetime)
      true
      (tc-borrow-check-expr-list-stores-lifetime-at?
        ctx
        expr-bases
        env
        exprs
        (+ index 1)
        lifetime))))

(define (tc-borrow-check-let-bindings-store-lifetime?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bindings : ast.AstLetBindingList]
  [lifetime : i64]) : bool
  (tc-borrow-check-let-bindings-store-lifetime-at?
    ctx
    expr-bases
    env
    (& bindings)
    lifetime
    0))

(define (tc-borrow-check-let-bindings-store-lifetime-at?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bindings : (& bindings ast.AstLetBindingList)]
  [lifetime : i64]
  [index : i64]) : bool
  (if (>= index (ast.ast-let-binding-list-len bindings))
    false
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding _ _ init-box)
        (if (tc-borrow-check-expr-stores-lifetime?
          ctx
          expr-bases
          env
          (ast.ast-expr-segment-bases-get expr-bases init-box)
          lifetime)
          true
          (tc-borrow-check-let-bindings-store-lifetime-at?
            ctx
            expr-bases
            env
            bindings
            lifetime
            (+ index 1)))])))

(define (tc-borrow-check-match-arms-store-lifetime?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [arms : ast.AstMatchArmList]
  [lifetime : i64]) : bool
  (tc-borrow-check-match-arms-store-lifetime-at?
    ctx
    expr-bases
    env
    (& arms)
    lifetime
    0))

(define (tc-borrow-check-match-arms-store-lifetime-at?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [arms : (& arms ast.AstMatchArmList)]
  [lifetime : i64]
  [index : i64]) : bool
  (if (>= index arms.len)
    false
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm _ body-box)
        (if (tc-borrow-check-expr-stores-lifetime?
          ctx
          expr-bases
          env
          (ast.ast-expr-segment-bases-get expr-bases body-box)
          lifetime)
          true
          (tc-borrow-check-match-arms-store-lifetime-at?
            ctx
            expr-bases
            env
            arms
            lifetime
            (+ index 1)))])))

(define (tc-borrow-check-expr-stores-lifetime?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [lifetime : i64]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(or (Ann inner-box _) (Cast inner-box _))
      (tc-borrow-check-expr-stores-lifetime?
        ctx
        expr-bases
        env
        (ast.ast-expr-segment-bases-get expr-bases inner-box)
        lifetime)]
    [(or (Begin exprs) (Unsafe exprs))
      (tc-borrow-check-expr-list-stores-lifetime?
        ctx
        expr-bases
        env
        exprs
        lifetime)]
    [(If cond-box then-box else-box)
      (or
        (tc-borrow-check-expr-stores-lifetime?
          ctx
          expr-bases
          env
          (ast.ast-expr-segment-bases-get expr-bases cond-box)
          lifetime)
        (tc-borrow-check-expr-stores-lifetime?
          ctx
          expr-bases
          env
          (ast.ast-expr-segment-bases-get expr-bases then-box)
          lifetime)
        (tc-borrow-check-expr-stores-lifetime?
          ctx
          expr-bases
          env
          (ast.ast-expr-segment-bases-get expr-bases else-box)
          lifetime))]
    [(Let let-box)
      (match (ast.ast-let-box-shared-view let-box)
        [(Let bindings body-box)
          (or
            (tc-borrow-check-let-bindings-store-lifetime?
              ctx
              expr-bases
              env
              bindings
              lifetime)
            (tc-borrow-check-expr-stores-lifetime?
              ctx
              expr-bases
              env
              (ast.ast-expr-segment-bases-get expr-bases body-box)
              lifetime))])]
    [(Match match-box)
      (match (ast.ast-match-box-shared-view match-box)
        [(Match scrut-box arms)
          (or
            (tc-borrow-check-expr-stores-lifetime?
              ctx
              expr-bases
              env
              (ast.ast-expr-segment-bases-get expr-bases scrut-box)
              lifetime)
            (tc-borrow-check-match-arms-store-lifetime?
              ctx
              expr-bases
              env
              arms
              lifetime))])]
    [(Set name rhs-box)
      (if (tc-dotted-place-name-id? ctx env name)
        (match (tc-dotted-local-field-set-expr-id-after-check
          expr-bases
          (tc-context-structural-session ctx)
          name
          rhs-box)
          [(Ok virtual-id)
            (tc-borrow-check-expr-stores-lifetime?
              ctx
              expr-bases
              env
              (ast.ast-expr-segment-bases-get expr-bases virtual-id)
              lifetime)]
          [(Err _) false])
        (match (tc-lookup-id env name)
          [(Ok ty) (tc-borrow-check-type-contains-lifetime? ctx ty lifetime)]
          [(Err _) false]))]
    [(or (ArraySet array-box _ _) (ArrayTake array-box _ _)
         (ArrayPush array-box _) (StructSet array-box _ _) (BoxSet array-box _))
      (tc-borrow-check-expr-type-contains-lifetime?
        ctx
        env
        (ast.ast-expr-segment-bases-get expr-bases array-box)
        lifetime)]
    [(Replace place-box _)
      (match (tc-replace-place-value-type
        ctx
        env
        (ast.ast-expr-segment-bases-get expr-bases place-box))
        [(Ok place-ty)
          (tc-borrow-check-type-contains-lifetime? ctx place-ty lifetime)]
        [(Err _) false])]
    [_ false]))

(define (tc-borrow-check-loop-protect-carried-facts-loop
  [ctx : TcContext]
  [loop-env : TcTypeEnv]
  [before : TcMovedSet]
  [facts : TcMovedPathFacts]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [path : TcMovePath fact.path]
      [kind : TcMovedPathKind fact.kind]
      [out2 : TcMovedSet
        (if (or
          (match (tc-moved-path-exact-conflict-kind before path kind)
            [(Some _ _) true]
            [No false])
          (match (tc-moved-path-exact-conflict-kind out path kind)
            [(Some _ _) true]
            [No false]))
          out
          (tc-moved-add-path-fact
            out
            path
            kind
            (tc-moved-path-fact-origin fact)))]
      (tc-borrow-check-loop-protect-carried-facts-loop
        ctx
        loop-env
        before
        rest
        out2))))

(define (tc-borrow-check-loop-protect-carried-facts
  [ctx : TcContext]
  [loop-env : TcTypeEnv]
  [before : TcMovedSet]
  [after : TcMovedSet]
  [protected : TcMovedSet]) : TcMovedSet
  (tc-borrow-check-loop-protect-carried-facts-loop
    ctx
    loop-env
    before
    (tc-moved-paths after)
    protected))

(define (tc-borrow-check-loop-protect-stored-facts-loop
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [facts : TcMovedPathFacts]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [path : TcMovePath fact.path]
      [kind : TcMovedPathKind fact.kind]
      [out2 : TcMovedSet
        (if (match (tc-moved-path-exact-conflict-kind out path kind)
          [(Some _ _) true]
          [No false])
          out
          (let
            [lifetime : i64 (tc-borrow-check-path-lifetime ctx env path)]
            (if (tc-borrow-check-expr-stores-lifetime?
              ctx
              expr-bases
              env
              (tc-global-shared-view expr)
              lifetime)
              (tc-moved-add-path-fact
                out
                path
                kind
                (tc-moved-path-fact-origin fact))
              out)))]
      (tc-borrow-check-loop-protect-stored-facts-loop
        ctx
        expr-bases
        env
        expr
        rest
        out2))))

(define (tc-borrow-check-loop-protect-stored-facts
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]) : TcMovedSet
  (tc-borrow-check-loop-protect-stored-facts-loop
    ctx
    expr-bases
    env
    expr
    (tc-moved-paths borrowed)
    protected))

(define (tc-borrow-check-loop-visible-body-borrows
  [ctx : TcContext]
  [loop-env : TcTypeEnv]
  [entry : TcMovedSet]
  [body-borrowed : TcMovedSet]) : TcMovedSet
  (let
    [a
      (tc-borrow-check-loop-protect-carried-facts
        ctx
        loop-env
        (tc-global-shared-view entry)
        body-borrowed
        (tc-moved-empty))]
    (tc-moved-union a entry)))

(define (tc-borrow-loop-result-branches
  [fallback : TcMovedSet]
  [a : TcBorrowLoopResult]
  [b : TcBorrowLoopResult]) : TcBorrowLoopResult
  (match a
    [(Err message) (Err message)]
    [(Ok normal-a? normal-a-box repeat-a? repeat-a-box breaks-a? break-a-box)
      (match b
        [(Err message) (Err message)]
        [(Ok
            normal-b?
            normal-b-box
            repeat-b?
            repeat-b-box
            breaks-b?
            break-b-box)
          (Ok
            (or normal-a? normal-b?)
            (cond
              [(and normal-a? normal-b?)
                (box
                  (let
                    [a (tc-moved-set-box-shared-view normal-a-box)]
                    (tc-moved-union
                      a
                      (tc-moved-set-box-shared-view normal-b-box))))]
              [normal-a? normal-a-box]
              [normal-b? normal-b-box]
              [else (box fallback)])
            (or repeat-a? repeat-b?)
            (cond
              [(and repeat-a? repeat-b?)
                (box
                  (let
                    [a (tc-moved-set-box-shared-view repeat-a-box)]
                    (tc-moved-union
                      a
                      (tc-moved-set-box-shared-view repeat-b-box))))]
              [repeat-a? repeat-a-box]
              [else repeat-b-box])
            (or breaks-a? breaks-b?)
            (cond
              [(and breaks-a? breaks-b?)
                (box
                  (let
                    [a (tc-moved-set-box-shared-view break-a-box)]
                    (tc-moved-union
                      a
                      (tc-moved-set-box-shared-view break-b-box))))]
              [breaks-a? break-a-box]
              [else break-b-box]))])]))

(define (tc-borrow-loop-result-add-edges
  [repeat-prior? : bool]
  [repeat-prior : TcMovedSet]
  [break-prior? : bool]
  [break-prior : TcMovedSet]
  [result : TcBorrowLoopResult]) : TcBorrowLoopResult
  (match result
    [(Err message) (Err message)]
    [(Ok normal? normal-box repeats? repeat-box breaks? break-box)
      (Ok
        normal?
        normal-box
        (or repeat-prior? repeats?)
        (cond
          [(and repeat-prior? repeats?)
            (box
              (tc-moved-union
                repeat-prior
                (tc-moved-set-box-shared-view repeat-box)))]
          [repeat-prior? (box repeat-prior)]
          [else repeat-box])
        (or break-prior? breaks?)
        (cond
          [(and break-prior? breaks?)
            (box
              (tc-moved-union
                break-prior
                (tc-moved-set-box-shared-view break-box)))]
          [break-prior? (box break-prior)]
          [else break-box]))]))

;; Adds the exit edges a collecting frame gathered to `result`.
(define (tc-borrow-loop-result-add-exits
  [exits : TcBorrowLoopExits]
  [result : TcBorrowLoopResult]) : TcBorrowLoopResult
  (tc-borrow-loop-result-add-edges
    exits.repeats
    exits.repeat-borrowed
    exits.breaks
    exits.break-borrowed
    result))

(define (tc-borrow-loop-visible-edge-state
  [ctx : TcContext]
  [loop-env : TcTypeEnv]
  [entry : TcMovedSet]
  [state : TcMovedSet]
  [remove-root-id : i64]) : TcMovedSet
  (tc-borrow-check-loop-visible-body-borrows
    ctx
    loop-env
    entry
    (if (>= remove-root-id 0)
      (tc-moved-remove-root-state state remove-root-id)
      state)))

;; Drop ROOT-ID's borrow state from every edge of RESULT, as an exit edge
;; does for a loop's own binder; a rank-2 foreach binds two such roots.
(define (tc-borrow-loop-result-remove-root
  [result : TcBorrowLoopResult]
  [root-id : i64]) : TcBorrowLoopResult
  (match result
    [(Err message) (Err message)]
    [(Ok normal? normal-box repeats? repeat-box breaks? break-box)
      (let
        [normal : TcMovedSet (tc-moved-set-box-shared-view normal-box)]
        [repeat : TcMovedSet (tc-moved-set-box-shared-view repeat-box)]
        [break : TcMovedSet (tc-moved-set-box-shared-view break-box)]
        (Ok
          normal?
          (box (tc-moved-remove-root-state (tc-moved-clone normal) root-id))
          repeats?
          (box (tc-moved-remove-root-state (tc-moved-clone repeat) root-id))
          breaks?
          (box (tc-moved-remove-root-state (tc-moved-clone break) root-id))))]))

(define (tc-borrow-loop-result-exit-state
  [ctx : TcContext]
  [loop-env : TcTypeEnv]
  [entry : TcMovedSet]
  [remove-root-id : i64]
  [result : TcBorrowLoopResult]) : TcBorrowCheckResult
  (match result
    [(Err message) (Err message)]
    [(Ok normal? normal-box repeats? repeat-box breaks? break-box)
      (let
        [out : TcMovedSet (tc-moved-clone entry)]
        (if normal?
          (set!
            out
            (tc-moved-union
              out
              (tc-borrow-loop-visible-edge-state
                ctx
                loop-env
                (tc-global-shared-view entry)
                (tc-moved-set-box-shared-view normal-box)
                remove-root-id)))
          unit)
        (if repeats?
          (set!
            out
            (tc-moved-union
              out
              (tc-borrow-loop-visible-edge-state
                ctx
                loop-env
                (tc-global-shared-view entry)
                (tc-moved-set-box-shared-view repeat-box)
                remove-root-id)))
          unit)
        (if breaks?
          (set!
            out
            (tc-moved-union
              out
              (tc-borrow-loop-visible-edge-state
                ctx
                loop-env
                entry
                (tc-moved-set-box-shared-view break-box)
                remove-root-id)))
          unit)
        (Ok out))]))

(define (tc-borrow-check-loop-path-exprs-retry-after-prune
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [pending-scope-id : i64]
  [exprs : ast.AstExprList]
  [head : ast.AstExpr]
  [rest : ast.AstExprList]
  [message : String]) : TcBorrowLoopResult
  (if (= (tc-moved-len borrowed) 0)
    (Err message)
    (let
      [unscoped : TcMovedSet
        (tc-borrow-check-remove-pending-markers borrowed pending-scope-id)]
      [borrowed0 : TcMovedSet
        (tc-borrow-check-prune-before-exprs
          expr-bases
          ctx
          env
          (tc-global-shared-view locals)
          (tc-global-shared-view unscoped)
          (tc-global-shared-view protected)
          exprs)]
      (if (= (tc-moved-len borrowed0) (tc-moved-len unscoped))
        (Err message)
        (match (tc-borrow-check-loop-path-expr
          ctx
          expr-bases
          env
          loop-env
          (tc-global-shared-view locals)
          (tc-global-shared-view borrowed0)
          (tc-global-shared-view protected)
          (tc-global-shared-view head))
          [(Err retry-message) (Err retry-message)]
          [(Ok normal? normal-box repeats? repeat-box breaks? break-box)
            (let
              [repeat-clean : TcMovedSet
                (tc-borrow-check-remove-pending-markers
                  (tc-moved-set-box-shared-view repeat-box)
                  pending-scope-id)]
              [break-clean : TcMovedSet
                (tc-borrow-check-remove-pending-markers
                  (tc-moved-set-box-shared-view break-box)
                  pending-scope-id)]
              (if normal?
                (let
                  [normal-clean : TcMovedSet
                    (tc-borrow-check-remove-pending-markers
                      (tc-moved-set-box-shared-view normal-box)
                      pending-scope-id)]
                  [protected1 : TcMovedSet
                    (tc-borrow-check-loop-protect-stored-facts
                      ctx
                      expr-bases
                      env
                      head
                      (tc-global-shared-view normal-clean)
                      (tc-borrow-check-loop-protect-carried-facts
                        ctx
                        loop-env
                        borrowed0
                        (tc-global-shared-view normal-clean)
                        protected))]
                  (tc-borrow-loop-result-add-edges
                    repeats?
                    repeat-clean
                    breaks?
                    break-clean
                    (tc-borrow-check-loop-path-exprs
                      ctx
                      expr-bases
                      env
                      loop-env
                      locals
                      normal-clean
                      protected1
                      rest)))
                (Ok
                  false
                  normal-box
                  repeats?
                  (box repeat-clean)
                  breaks?
                  (box break-clean))))])))))

(define (tc-borrow-check-loop-path-exprs
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : ast.AstExprList]) : TcBorrowLoopResult
  (tc-borrow-check-loop-path-exprs-at
    ctx
    expr-bases
    env
    loop-env
    locals
    borrowed
    protected
    (& exprs)
    0))

(define (tc-borrow-check-loop-path-exprs-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : TcBorrowLoopResult
  (if (>= index exprs.len)
    (Ok
      true
      (box borrowed)
      false
      (box (tc-moved-empty))
      false
      (box (tc-moved-empty)))
    (let
      [head-id : i64 (ast.ast-expr-list-get exprs index 0)]
      [head : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases head-id)]
      [rest : ast.AstExprList
        (ast.ast-expr-list-tail-from-ref exprs (+ index 1))]
      [scoped-borrowed : TcMovedSet
        (tc-borrow-check-add-all-pending-markers
          (tc-global-shared-view borrowed)
          (tc-global-shared-view rest)
          head-id)]
      (match (tc-borrow-check-loop-path-expr
        ctx
        expr-bases
        env
        loop-env
        (tc-global-shared-view locals)
        (tc-global-shared-view scoped-borrowed)
        (tc-global-shared-view protected)
        (tc-global-shared-view head))
        [(Err message)
          (let
            [current : ast.AstExprList
              (ast.ast-expr-list-tail-from-ref exprs index)]
            (tc-borrow-check-loop-path-exprs-retry-after-prune
              ctx
              expr-bases
              env
              loop-env
              locals
              scoped-borrowed
              protected
              head-id
              current
              head
              rest
              message))]
        [(Ok normal? normal-box repeats? repeat-box breaks? break-box)
          (let
            [repeat-clean : TcMovedSet
              (tc-borrow-check-remove-pending-markers
                (tc-moved-set-box-shared-view repeat-box)
                head-id)]
            [break-clean : TcMovedSet
              (tc-borrow-check-remove-pending-markers
                (tc-moved-set-box-shared-view break-box)
                head-id)]
            (if normal?
              (let
                [normal-clean : TcMovedSet
                  (tc-borrow-check-remove-pending-markers
                    (tc-moved-set-box-shared-view normal-box)
                    head-id)]
                [protected1 : TcMovedSet
                  (tc-borrow-check-loop-protect-stored-facts
                    ctx
                    expr-bases
                    env
                    head
                    (tc-global-shared-view normal-clean)
                    (tc-borrow-check-loop-protect-carried-facts
                      ctx
                      loop-env
                      borrowed
                      (tc-global-shared-view normal-clean)
                      protected))]
                (tc-borrow-loop-result-add-edges
                  repeats?
                  repeat-clean
                  breaks?
                  break-clean
                  (tc-borrow-check-loop-path-exprs-at
                    ctx
                    expr-bases
                    env
                    loop-env
                    locals
                    normal-clean
                    protected1
                    exprs
                    (+ index 1))))
              (Ok
                false
                normal-box
                repeats?
                (box repeat-clean)
                breaks?
                (box break-clean))))]))))

(define (tc-borrow-check-exprs-loop-retry-after-prune
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [pending-scope-id : i64]
  [exprs : ast.AstExprList]
  [head : ast.AstExpr]
  [rest : ast.AstExprList]
  [message : String]) : TcBorrowCheckResult
  (if (= (tc-moved-len borrowed) 0)
    (Err message)
    (let
      [unscoped : TcMovedSet
        (tc-borrow-check-remove-pending-markers borrowed pending-scope-id)]
      [borrowed0 : TcMovedSet
        (tc-borrow-check-prune-before-exprs
          expr-bases
          ctx
          env
          (tc-global-shared-view locals)
          (tc-global-shared-view unscoped)
          (tc-global-shared-view protected)
          exprs)]
      (if (= (tc-moved-len borrowed0) (tc-moved-len unscoped))
        (Err message)
        (let
          [borrowed1
            (try
              (tc-borrow-check-expr-loop
                ctx
                expr-bases
                env
                loop-env
                (tc-global-shared-view locals)
                (tc-global-shared-view borrowed0)
                (tc-global-shared-view protected)
                (tc-global-shared-view head)))]
          [borrowed2 : TcMovedSet
            (tc-borrow-check-remove-pending-markers borrowed1 pending-scope-id)]
          [protected1 : TcMovedSet
            (tc-borrow-check-loop-protect-stored-facts
              ctx
              expr-bases
              env
              head
              (tc-global-shared-view borrowed2)
              (tc-borrow-check-loop-protect-carried-facts
                ctx
                loop-env
                borrowed0
                (tc-global-shared-view borrowed2)
                protected))]
          (tc-borrow-check-exprs-loop
            ctx
            expr-bases
            env
            loop-env
            locals
            borrowed2
            protected1
            rest))))))

(define (tc-borrow-check-exprs-loop
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : ast.AstExprList]) : TcBorrowCheckResult
  (tc-borrow-check-exprs-loop-at
    ctx
    expr-bases
    env
    loop-env
    locals
    borrowed
    protected
    (& exprs)
    0))

(define (tc-borrow-check-exprs-loop-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index exprs.len)
    (Ok borrowed)
    (let
      [head-id : i64 (ast.ast-expr-list-get exprs index 0)]
      [head : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases head-id)]
      [rest : ast.AstExprList
        (ast.ast-expr-list-tail-from-ref exprs (+ index 1))]
      [scoped-borrowed : TcMovedSet
        (tc-borrow-check-add-all-pending-markers
          (tc-global-shared-view borrowed)
          (tc-global-shared-view rest)
          head-id)]
      (match (tc-borrow-check-expr-loop
        ctx
        expr-bases
        env
        loop-env
        (tc-global-shared-view locals)
        (tc-global-shared-view scoped-borrowed)
        (tc-global-shared-view protected)
        (tc-global-shared-view head))
        [(Ok borrowed1)
          (let
            [borrowed2 : TcMovedSet
              (tc-borrow-check-remove-pending-markers borrowed1 head-id)]
            [protected1 : TcMovedSet
              (tc-borrow-check-loop-protect-stored-facts
                ctx
                expr-bases
                env
                head
                (tc-global-shared-view borrowed2)
                (tc-borrow-check-loop-protect-carried-facts
                  ctx
                  loop-env
                  borrowed
                  (tc-global-shared-view borrowed2)
                  protected))]
            (tc-borrow-check-exprs-loop-at
              ctx
              expr-bases
              env
              loop-env
              locals
              borrowed2
              protected1
              exprs
              (+ index 1)))]
        [(Err message)
          (let
            [current : ast.AstExprList
              (ast.ast-expr-list-tail-from-ref exprs index)]
            (tc-borrow-check-exprs-loop-retry-after-prune
              ctx
              expr-bases
              env
              loop-env
              locals
              scoped-borrowed
              protected
              head-id
              current
              head
              rest
              message))]))))

(define (tc-borrow-check-arms-loop-join
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]
  [joined : TcMovedSet]) : TcBorrowCheckResult
  (tc-borrow-check-arms-loop-join-at
    ctx
    expr-bases
    env
    loop-env
    locals
    borrowed
    scrut-ty
    (& arms)
    joined
    0))

(define (tc-borrow-check-arms-loop-join-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : ast.AstType]
  [arms : (& arms ast.AstMatchArmList)]
  [joined : TcMovedSet]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index arms.len)
    (Ok joined)
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          [arm-env
            (try
              (tc-bind-match-pattern
                ctx
                env
                (tc-global-shared-view scrut-ty)
                (tc-global-shared-view pattern)))]
          [arm-borrowed
            (try
              (tc-borrow-check-expr-loop
                ctx
                expr-bases
                arm-env
                loop-env
                (tc-borrow-check-pattern-locals
                  ctx
                  (tc-global-shared-view scrut-ty)
                  (tc-global-shared-view pattern)
                  (tc-moved-clone locals))
                (tc-moved-clone borrowed)
                (tc-global-shared-view borrowed)
                body))]
          [visible-arm-borrowed : TcMovedSet
            (tc-move-remove-bound-root-states
              arm-borrowed
              (tc-borrow-check-pattern-bound-names
                ctx
                (tc-global-shared-view scrut-ty)
                pattern))]
          (tc-borrow-check-arms-loop-join-at
            ctx
            expr-bases
            env
            loop-env
            locals
            borrowed
            scrut-ty
            arms
            (tc-moved-union joined visible-arm-borrowed)
            (+ index 1)))])))

(define (tc-borrow-check-arms-loop
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]) : TcBorrowCheckResult
  (tc-borrow-check-arms-loop-join
    ctx
    expr-bases
    env
    loop-env
    locals
    (tc-global-shared-view borrowed)
    scrut-ty
    arms
    borrowed))

(define (tc-borrow-check-expr-loop
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [expr : ast.AstExpr]) : TcBorrowCheckResult
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(or (Begin exprs) (Unsafe exprs))
      (tc-borrow-check-exprs-loop
        ctx
        expr-bases
        env
        loop-env
        locals
        borrowed
        protected
        exprs)]
    [(If cond-box then-branch-box else-branch-box)
      (let
        [cond : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases cond-box)]
        [then-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases then-branch-box)]
        [else-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases else-branch-box)]
        [borrowedc
          (try
            (tc-borrow-check-expr
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed
              cond))]
        [borrowedt
          (try
            (tc-borrow-check-expr-loop
              ctx
              expr-bases
              env
              loop-env
              (tc-moved-clone locals)
              (tc-moved-clone borrowedc)
              (tc-global-shared-view borrowedc)
              then-branch))]
        [borrowede
          (try
            (tc-borrow-check-expr-loop
              ctx
              expr-bases
              env
              loop-env
              (tc-moved-clone locals)
              (tc-moved-clone borrowedc)
              borrowedc
              else-branch))]
        (Ok (tc-moved-union borrowedt borrowede)))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (match (tc-borrow-check-let-bindings
              ctx
              expr-bases
              env
              (tc-moved-clone locals)
              (tc-moved-clone borrowed)
              (tc-global-shared-view borrowed)
              bindings
              body-box)
              [(Ok env2 locals2 borrowed2)
                (let
                  [body-borrowed
                    (try
                      (tc-borrow-check-expr-loop
                        ctx
                        expr-bases
                        env2
                        loop-env
                        locals2
                        borrowed2
                        (tc-global-shared-view borrowed)
                        body))]
                  (Ok
                    (tc-borrow-check-loop-visible-body-borrows
                      ctx
                      loop-env
                      borrowed
                      body-borrowed)))]
              [(Err message) (Err message)]))])]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match scrut-box arms)
          (let
            [scrut : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases scrut-box)]
            [borroweds
              (try
                (tc-borrow-check-expr
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view locals)
                  borrowed
                  scrut))]
            [scrut-ty : ast.AstType
              (try
                (tc-body-type-fact-expr-id
                  "borrow.match_scrutinee"
                  ctx
                  env
                  scrut-box))]
            (tc-borrow-check-arms-loop
              ctx
              expr-bases
              env
              loop-env
              locals
              borroweds
              scrut-ty
              arms))])]
    [(SpmdCompact compact-box)
      (match (__tl-box-place compact-box)
        [(Compact
            index
            index-ty
            start-box
            end-box
            slot
            slot-ty
            init-box
            keep-box
            body-box)
          (let
            [keep : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases keep-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [keep-env : TcTypeEnv
              (tc-bind-id env index (tc-resolve-type ctx index-ty))]
            [body-env : TcTypeEnv
              (tc-bind-id keep-env slot (tc-resolve-type ctx slot-ty))]
            [keep-locals : TcMovedSet
              (tc-moved-add (tc-moved-clone locals) index)]
            [body-locals : TcMovedSet
              (tc-moved-add (tc-moved-clone keep-locals) slot)]
            [outer-borrowed : TcMovedSet
              (try
                (tc-borrow-check-exprs
                  ctx
                  expr-bases
                  env
                  locals
                  borrowed
                  (ast.ast-expr-cons
                    start-box
                    (&
                      (ast.ast-expr-cons
                        end-box
                        (&
                          (ast.ast-expr-cons
                            init-box
                            (& (ast.ast-expr-list-new)))))))))]
            [keep-entry : TcMovedSet
              (tc-moved-remove-root-state (tc-moved-clone outer-borrowed) index)]
            [keep-borrowed
              (try
                (tc-borrow-check-expr-loop
                  ctx
                  expr-bases
                  keep-env
                  env
                  keep-locals
                  (tc-global-shared-view keep-entry)
                  keep-entry
                  keep))]
            [body-entry : TcMovedSet
              (tc-moved-remove-root-state
                (tc-moved-remove-root-state
                  (tc-moved-clone keep-borrowed)
                  index)
                slot)]
            [body-borrowed
              (try
                (tc-borrow-check-expr-loop
                  ctx
                  expr-bases
                  body-env
                  env
                  body-locals
                  (tc-global-shared-view body-entry)
                  body-entry
                  body))]
            (Ok
              (tc-borrow-check-loop-visible-body-borrows
                ctx
                env
                keep-borrowed
                (tc-moved-remove-root-state
                  (tc-moved-remove-root-state body-borrowed index)
                  slot))))])]
    [_
      (tc-borrow-check-expr
        ctx
        expr-bases
        env
        locals
        borrowed
        (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr)))]))

(define (tc-borrow-check-loop-path-expr
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [expr : ast.AstExpr]) : TcBorrowLoopResult
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(or (Begin exprs) (Unsafe exprs) (BracketClause exprs))
      (tc-borrow-check-loop-path-exprs
        ctx
        expr-bases
        env
        loop-env
        locals
        borrowed
        protected
        exprs)]
    ;; The condition, `let` bindings and `return` operand are checked by the
    ;; non-loop walker, so each runs in a collecting frame (#8671).
    [(If cond-box then-box else-box)
      (let
        [state : TcBodyState (tc-context-body-state ctx)]
        [outer : TcBorrowLoopExits (tc-body-borrow-exits-collect! state)]
        [checked-cond : TcBorrowCheckResult
          (tc-borrow-check-expr-id
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            borrowed
            cond-box)]
        [exits : TcBorrowLoopExits (tc-body-borrow-exits-swap! state outer)]
        [borrowedc (try checked-cond)]
        (tc-borrow-loop-result-add-exits
          exits
          (tc-borrow-loop-result-branches
            (tc-global-shared-view borrowedc)
            (tc-borrow-check-loop-path-expr
              ctx
              expr-bases
              env
              loop-env
              (tc-moved-clone locals)
              (tc-moved-clone borrowedc)
              (tc-global-shared-view borrowedc)
              (ast.ast-expr-segment-bases-get expr-bases then-box))
            (tc-borrow-check-loop-path-expr
              ctx
              expr-bases
              env
              loop-env
              (tc-moved-clone locals)
              (tc-moved-clone borrowedc)
              borrowedc
              (ast.ast-expr-segment-bases-get expr-bases else-box)))))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (let
            [state : TcBodyState (tc-context-body-state ctx)]
            [outer : TcBorrowLoopExits (tc-body-borrow-exits-collect! state)]
            [bound
              (tc-borrow-check-let-bindings
                ctx
                expr-bases
                env
                (tc-moved-clone locals)
                (tc-moved-clone borrowed)
                (tc-global-shared-view borrowed)
                bindings
                body-box)]
            [exits : TcBorrowLoopExits (tc-body-borrow-exits-swap! state outer)]
            (match bound
              [(Err message) (Err message)]
              [(Ok env2 locals2 borrowed2)
                (match (tc-borrow-loop-result-add-exits
                  exits
                  (tc-borrow-check-loop-path-expr
                    ctx
                    expr-bases
                    env2
                    loop-env
                    locals2
                    borrowed2
                    (tc-global-shared-view borrowed)
                    (ast.ast-expr-segment-bases-get expr-bases body-box)))
                  [(Err message) (Err message)]
                  [(Ok normal? normal-box repeats? repeat-box breaks? break-box)
                    (Ok
                      normal?
                      (box
                        (tc-borrow-check-loop-visible-body-borrows
                          ctx
                          loop-env
                          (tc-global-shared-view borrowed)
                          (tc-moved-set-box-shared-view normal-box)))
                      repeats?
                      (box
                        (tc-borrow-check-loop-visible-body-borrows
                          ctx
                          loop-env
                          (tc-global-shared-view borrowed)
                          (tc-moved-set-box-shared-view repeat-box)))
                      breaks?
                      (box
                        (tc-borrow-check-loop-visible-body-borrows
                          ctx
                          loop-env
                          borrowed
                          (tc-moved-set-box-shared-view break-box))))])]))])]
    ;; `try` continues with its operand's value or leaves the function, so the
    ;; operand's own edges are the try's edges.
    [(Try inner-box)
      (tc-borrow-check-loop-path-expr
        ctx
        expr-bases
        env
        loop-env
        locals
        borrowed
        protected
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(Return _)
      (let
        [state : TcBodyState (tc-context-body-state ctx)]
        [outer : TcBorrowLoopExits (tc-body-borrow-exits-collect! state)]
        [checked : TcBorrowCheckResult
          (tc-borrow-check-expr ctx expr-bases env locals borrowed expr)]
        [exits : TcBorrowLoopExits (tc-body-borrow-exits-swap! state outer)]
        [borrowed1 (try checked)]
        (tc-borrow-loop-result-add-exits
          exits
          (Ok
            false
            (box borrowed1)
            false
            (box (tc-moved-empty))
            false
            (box (tc-moved-empty)))))]
    [(Break)
      (Ok false (box borrowed) false (box (tc-moved-empty)) true (box borrowed))]
    [(Continue)
      (Ok false (box borrowed) true (box borrowed) false (box (tc-moved-empty)))]
    ;; A form without its own arm is checked by the non-loop walker inside a
    ;; collecting frame, so a `break` or `continue` nested in an operand adds
    ;; its exit edge with the borrows live at it (#8671).
    [_
      (let
        [state : TcBodyState (tc-context-body-state ctx)]
        [outer : TcBorrowLoopExits (tc-body-borrow-exits-collect! state)]
        [result : TcBorrowCheckResult
          (tc-borrow-check-expr-loop
            ctx
            expr-bases
            env
            loop-env
            locals
            borrowed
            protected
            (tc-global-shared-view expr))]
        [exits : TcBorrowLoopExits (tc-body-borrow-exits-swap! state outer)]
        (match result
          [(Err message) (Err message)]
          [(Ok borrowed1)
            (let
              [flow : TcMoveLoopFlow
                (tc-move-loop-flow-expr ctx expr-bases env expr)]
              (tc-borrow-loop-result-add-exits
                exits
                (Ok
                  flow.normal
                  (box (tc-moved-clone (& borrowed1)))
                  flow.repeat
                  (box (tc-moved-clone (& borrowed1)))
                  flow.breaks
                  (box borrowed1))))]))]))

;; A loop body entered from the non-loop walker: its `break`s and `continue`s
;; belong to this loop, so its frame keeps them out of an enclosing loop-path
;; form's collection (#8671).
(define (tc-borrow-check-loop-body
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [body : ast.AstExpr]) : TcBorrowLoopResult
  (let
    [state : TcBodyState (tc-context-body-state ctx)]
    [outer : TcBorrowLoopExits
      (tc-body-borrow-exits-swap! state (tc-borrow-loop-exits-new false))]
    [result : TcBorrowLoopResult
      (tc-borrow-check-loop-path-expr
        ctx
        expr-bases
        env
        loop-env
        locals
        borrowed
        protected
        body)]
    [_ (tc-body-borrow-exits-swap! state outer)]
    result))

(define (tc-borrow-check-read-exprs
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : ast.AstExprList]) : TcBorrowCheckResult
  (tc-borrow-check-read-exprs-at ctx expr-bases env locals borrowed (& exprs) 0))

(define (tc-borrow-check-read-exprs-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index exprs.len)
    (Ok borrowed)
    (let
      [head : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get exprs index 0))]
      [borrowed1
        (try
          (tc-borrow-check-expr
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            borrowed
            (tc-global-shared-view head)))]
      (if (= (tc-moved-len borrowed1) 0)
        (tc-borrow-check-read-exprs-at
          ctx
          expr-bases
          env
          locals
          borrowed1
          exprs
          (+ index 1))
        (let
          [borrowed2
            (try
              (tc-borrow-check-place-read-conflict
                expr-bases
                (tc-global-shared-view locals)
                borrowed1
                (tc-global-shared-view head)
                head))]
          (tc-borrow-check-read-exprs-at
            ctx
            expr-bases
            env
            locals
            borrowed2
            exprs
            (+ index 1)))))))

(define (tc-borrow-check-add-returned-call-arg-borrow
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [arg : ast.AstExpr]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (match (tc-expr ctx env (tc-global-shared-view arg))
    [(Ok arg-ty)
      (if (tc-name-id-list-overlaps?
        (tc-type-collect-reference-lifetimes
          (tc-resolve-type ctx (tc-global-shared-view arg-ty)))
        result-lifetimes)
        (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& arg))
          [(Borrow mutable _ place-box)
            (let
              [place : ast.AstExpr
                (ast.ast-expr-segment-bases-get expr-bases place-box)]
              (tc-borrow-check-add-place-with-mutability
                expr-bases
                locals
                borrowed
                mutable
                place
                arg))]
          [(or (Ann inner-box _) (Cast inner-box _))
            (let
              [inner : ast.AstExpr
                (ast.ast-expr-segment-bases-get expr-bases inner-box)]
              (tc-borrow-check-add-returned-call-arg-borrow
                ctx
                expr-bases
                env
                locals
                borrowed
                inner
                result-lifetimes))]
          ;; A nested call lends what its own result stores (#7968).
          [(Call _ inner-args)
            (let
              [inner-lifetimes : TcNameIdList
                (tc-name-id-list-intersection
                  (tc-type-collect-reference-lifetimes
                    (tc-resolve-type ctx arg-ty))
                  result-lifetimes)]
              (tc-borrow-check-add-returned-call-borrows
                ctx
                expr-bases
                env
                locals
                borrowed
                inner-args
                inner-lifetimes))]
          [_
            (tc-borrow-check-add-composite-arg
              ctx
              expr-bases
              env
              locals
              borrowed
              false
              -1
              arg
              result-lifetimes)])
        (Ok borrowed))]
    [(Err _) (Ok borrowed)]))

(define (tc-borrow-check-add-returned-call-borrows
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : ast.AstExprList]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (let
    [borrowed1
      (try
        (tc-borrow-check-add-composite-sibling-effects-at
          ctx
          expr-bases
          env
          (tc-global-shared-view locals)
          borrowed
          false
          -1
          (& args)
          0
          result-lifetimes))]
    (tc-borrow-check-add-returned-call-borrows-at
      ctx
      expr-bases
      env
      locals
      borrowed1
      (& args)
      0
      result-lifetimes)))

(define (tc-borrow-check-add-returned-call-borrows-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : (& args ast.AstExprList)]
  [index : i64]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (if (>= index args.len)
    (Ok borrowed)
    (let
      [arg : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get args index 0))]
      [borrowed1
        (try
          (tc-borrow-check-add-returned-call-arg-borrow
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            borrowed
            arg
            result-lifetimes))]
      (tc-borrow-check-add-returned-call-borrows-at
        ctx
        expr-bases
        env
        locals
        borrowed1
        args
        (+ index 1)
        result-lifetimes))))

(define (tc-borrow-check-after-returning-call-lifetimes
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : ast.AstExprList]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (match result-lifetimes
    [(Nil) (Ok borrowed)]
    [_
      (tc-borrow-check-add-returned-call-borrows
        ctx
        expr-bases
        env
        locals
        borrowed
        args
        result-lifetimes)]))

(define (tc-borrow-check-after-returning-call
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : ast.AstExpr]
  [args : ast.AstExprList]
  [return-lifetimes : TcBorrowCallReturnLifetimes]) : TcBorrowCheckResult
  (match return-lifetimes
    [(Known result-lifetimes)
      (tc-borrow-check-after-returning-call-lifetimes
        ctx
        expr-bases
        env
        locals
        borrowed
        args
        result-lifetimes)]
    [(Fallback)
      (match (tc-expr ctx env call-expr)
        [(Ok result-ty)
          (tc-borrow-check-after-returning-call-lifetimes
            ctx
            expr-bases
            env
            locals
            borrowed
            args
            (tc-type-collect-reference-lifetimes
              (tc-resolve-type ctx result-ty)))]
        [(Err _) (Ok borrowed)])]))

;; A reference captured by a direct local closure is used when that closure is
;; called, not merely when its environment is created. Retarget the NLL lending
;; marker from the captured reference binding to the closure binding so the
;; referent stays borrowed through the last direct call. The ordinary borrow
;; path and its diagnostic origin remain unchanged.
(define (tc-borrow-check-rebind-lambda-lending-facts
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [bound : TcStringList]
  [body : ast.AstExpr]
  [closure-id : i64]
  [facts : TcMovedPathFacts]) : TcMovedPathFacts
  (if (tc-moved-path-facts-empty? facts)
    Nil
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [tail : TcMovedPathFacts
        (tc-borrow-check-rebind-lambda-lending-facts
          ctx
          expr-bases
          env
          (tc-global-shared-view locals)
          (tc-global-shared-view bound)
          (tc-global-shared-view body)
          closure-id
          rest)]
      (match fact.kind
        [(BorrowLending binding-id)
          (let
            [captured : bool
              (tc-expr-uses-free-name?
                expr-bases
                body
                (tc-env-key-name-text binding-id)
                bound)]
            (if captured
              (let
                [rebound : TcMovedPathFact
                  (TcMovedPathFact
                    fact.path
                    (BorrowLending closure-id)
                    fact.origin)]
                (if (tc-closure-local-fact-copyable-code?
                  (tc-closure-local-fact-code locals binding-id))
                  (tc-moved-path-facts-cons
                    (tc-moved-path-facts-cons tail rebound)
                    fact)
                  (tc-moved-path-facts-cons tail rebound)))
              (tc-moved-path-facts-cons tail fact)))]
        [_ (tc-moved-path-facts-cons tail fact)]))))

;; A Copy closure alias keeps the source closure live and gains the same
;; lending provenance. Duplicate only the checker-only lending marker; the
;; shared-borrow fact and its diagnostic origin remain single and unchanged.
(define (tc-borrow-check-copy-lambda-lending-facts
  [facts : TcMovedPathFacts]
  [source-id : i64]
  [closure-id : i64]) : TcMovedPathFacts
  (if (tc-moved-path-facts-empty? facts)
    Nil
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [tail : TcMovedPathFacts
        (tc-borrow-check-copy-lambda-lending-facts rest source-id closure-id)]
      (match fact.kind
        [(BorrowLending binding-id)
          (if (= binding-id source-id)
            (tc-moved-path-facts-cons
              (tc-moved-path-facts-cons
                tail
                (TcMovedPathFact
                  fact.path
                  (BorrowLending closure-id)
                  fact.origin))
              fact)
            (tc-moved-path-facts-cons tail fact))]
        [_ (tc-moved-path-facts-cons tail fact)]))))

(define (tc-borrow-check-add-closure-lending-for-lifetimes
  [ctx : TcContext]
  [env : TcTypeEnv]
  [facts : TcMovedPathFacts]
  [lifetimes : TcNameIdList]
  [closure-id : i64]
  [origin : ast.AstExpr]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [path : TcMovePath fact.path]
      [out2 : TcMovedSet
        (if (and
          (match fact.kind
            [(BorrowShared) true]
            [_ false])
          (tc-name-id-list-contains
            lifetimes
            (tc-borrow-check-path-lifetime ctx env path)))
          (tc-borrow-check-add-lending-marker
            out
            path
            closure-id
            (tc-global-shared-view origin))
          out)]
      (tc-borrow-check-add-closure-lending-for-lifetimes
        ctx
        env
        rest
        lifetimes
        closure-id
        origin
        out2))))

(define (tc-borrow-check-add-lambda-capture-lending-scan
  [ctx : TcContext]
  [expr-bases : i64]
  [root-env : TcTypeEnv]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [body : ast.AstExpr]
  [closure-id : i64]
  [origin : ast.AstExpr]
  [seen : TcStringList]
  [borrowed : TcMovedSet]) : TcMovedSet
  (match (tc-type-env-marker-step env)
    [(Done) borrowed]
    [(Cache rest-env)
      (tc-borrow-check-add-lambda-capture-lending-scan
        ctx
        expr-bases
        root-env
        rest-env
        bound
        body
        closure-id
        origin
        seen
        borrowed)]
    [(Bind key ty rest-env)
      (let
        [name : String (tc-env-key-name-text key)]
        (cond
          [(= key (tc-default-boundary-id)) borrowed]
          [(or
              (= key (tc-region-marker-id))
              (tc-cleanup-owner-marker-entry? key ty)
              (tc-ordinary-arena-owner-marker-entry?
                key
                (tc-global-shared-view ty))
              (tc-atomic-arena-owner-marker-entry?
                key
                (tc-global-shared-view ty))
              (tc-string-list-contains
                (tc-global-shared-view seen)
                (tc-global-shared-view name)))
            (tc-borrow-check-add-lambda-capture-lending-scan
              ctx
              expr-bases
              root-env
              rest-env
              bound
              body
              closure-id
              origin
              seen
              borrowed)]
          [else
            (tc-borrow-check-add-lambda-capture-lending-scan
              ctx
              expr-bases
              root-env
              rest-env
              (tc-global-shared-view bound)
              (tc-global-shared-view body)
              closure-id
              (tc-global-shared-view origin)
              (tc-string-list-add seen (tc-global-shared-view name))
              (if (and
                (tc-expr-uses-free-name? expr-bases body name bound)
                (tc-type-contains-reference?
                  (tc-resolve-type ctx (tc-global-shared-view ty))))
                (tc-borrow-check-add-closure-lending-for-lifetimes
                  ctx
                  root-env
                  (tc-moved-paths (tc-global-shared-view borrowed))
                  (tc-type-collect-reference-lifetimes (tc-resolve-type ctx ty))
                  closure-id
                  origin
                  borrowed)
                borrowed))]))]))

(define (tc-borrow-check-rebind-lambda-lending
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [closure-id : i64]
  [init : ast.AstExpr]) : TcMovedSet
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& init))
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda params _ body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [facts : TcMovedPathFacts
              (tc-borrow-check-rebind-lambda-lending-facts
                ctx
                expr-bases
                env
                locals
                (tc-param-bound-names (tc-global-shared-view params))
                (tc-global-shared-view body)
                closure-id
                (tc-moved-paths (tc-global-shared-view borrowed)))]
            [rebound : TcMovedSet
              (TcMovedSet
                (tc-moved-roots (tc-global-shared-view borrowed))
                (tc-moved-partials (tc-global-shared-view borrowed))
                facts
                (tc-moved-hidden-atomic-users (tc-global-shared-view borrowed))
                (tc-moved-param-storage-origins borrowed))]
            (tc-borrow-check-add-lambda-capture-lending-scan
              ctx
              expr-bases
              env
              (tc-type-env-marker-start env)
              (tc-param-bound-names params)
              body
              closure-id
              init
              Nil
              rebound))])]
    [_
      (match (tc-move-bare-var expr-bases init)
        [(Some source-id _)
          (let
            [code : i64 (tc-closure-local-fact-code locals source-id)]
            (if (tc-closure-local-fact-copyable-code? code)
              (let
                [facts : TcMovedPathFacts
                  (tc-borrow-check-copy-lambda-lending-facts
                    (tc-moved-paths (tc-global-shared-view borrowed))
                    source-id
                    closure-id)]
                (TcMovedSet
                  (tc-moved-roots (tc-global-shared-view borrowed))
                  (tc-moved-partials (tc-global-shared-view borrowed))
                  facts
                  (tc-moved-hidden-atomic-users
                    (tc-global-shared-view borrowed))
                  (tc-moved-param-storage-origins borrowed)))
              borrowed))]
        [(No) borrowed])]))

(define (tc-borrow-check-let-pending-exprs
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]
  [body-box : i64]) : ast.AstExprList
  (let
    [out : ast.AstExprList
      (ast.ast-expr-list-with-capacity
        (+ (- (ast.ast-let-binding-list-len bindings) index) 1))]
    [cursor : i64 index]
    (while (< cursor (ast.ast-let-binding-list-len bindings))
      (match (ast.ast-let-binding-list-get
        bindings
        cursor
        (ast.ast-let-binding-fallback))
        [(Binding _ _ init-box) (ast.ast-expr-list-push (&mut out) init-box)])
      (set! cursor (+ cursor 1)))
    (ast.ast-expr-list-push (&mut out) body-box)
    out))

(define (tc-borrow-check-let-bindings
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [bindings : ast.AstLetBindingList]
  [body-box : i64]) : TcBorrowCheckBindings
  (tc-borrow-check-let-bindings-at
    ctx
    expr-bases
    env
    locals
    borrowed
    protected
    (& bindings)
    body-box
    0))

(define (tc-borrow-check-let-bindings-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [bindings : (& bindings ast.AstLetBindingList)]
  [body-box : i64]
  [index : i64]) : TcBorrowCheckBindings
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (Ok env locals borrowed)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name maybe-ty init-box)
        (let
          [pending-exprs : ast.AstExprList
            (tc-borrow-check-let-pending-exprs bindings (+ index 1) body-box)]
          [scoped-borrowed : TcMovedSet
            (tc-borrow-check-add-all-pending-markers
              (tc-global-shared-view borrowed)
              pending-exprs
              body-box)]
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          (match (tc-borrow-check-expr-id
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            scoped-borrowed
            init-box)
            [(Ok borrowed1)
              (let
                [borrowed1-clean : TcMovedSet
                  (tc-borrow-check-remove-pending-markers borrowed1 body-box)]
                [binding-ty : ast.AstType
                  (tc-move-binding-type-id
                    "borrow.let_init"
                    ctx
                    env
                    maybe-ty
                    init-box)]
                [borrowed2
                  (try
                    (tc-borrow-check-after-bind-known-type-id
                      ctx
                      expr-bases
                      env
                      (tc-global-shared-view locals)
                      borrowed1-clean
                      name
                      init-box
                      (tc-global-shared-view binding-ty)))]
                [borrowed3 : TcMovedSet
                  (tc-borrow-check-mark-new-return-borrows
                    ctx
                    env
                    (tc-global-shared-view locals)
                    borrowed
                    borrowed2
                    name
                    (tc-global-shared-view binding-ty)
                    (tc-global-shared-view init))]
                [borrowed4 : TcMovedSet
                  (tc-borrow-check-rebind-split-projection
                    expr-bases
                    borrowed3
                    name
                    (tc-global-shared-view init))]
                [borrowed5 : TcMovedSet
                  (tc-borrow-check-rebind-lambda-lending
                    ctx
                    expr-bases
                    env
                    (tc-global-shared-view locals)
                    borrowed4
                    name
                    (tc-global-shared-view init))]
                (tc-borrow-check-let-bindings-at
                  ctx
                  expr-bases
                  (tc-bind-initialized-value-id
                    ctx
                    env
                    name
                    binding-ty
                    (tc-global-shared-view init))
                  (tc-move-add-local-binding
                    ctx
                    expr-bases
                    env
                    locals
                    name
                    init)
                  (tc-moved-remove-root-state borrowed5 name)
                  protected
                  bindings
                  body-box
                  (+ index 1)))]
            [(Err message)
              (let
                [current-and-pending : ast.AstExprList
                  (tc-borrow-check-let-pending-exprs bindings index body-box)]
                [borrowed0 : TcMovedSet
                  (tc-borrow-check-prune-before-exprs
                    expr-bases
                    ctx
                    env
                    (tc-global-shared-view locals)
                    (tc-global-shared-view borrowed)
                    (tc-global-shared-view protected)
                    current-and-pending)]
                (if (= (tc-moved-len borrowed0) (tc-moved-len borrowed))
                  (Err message)
                  (tc-borrow-check-let-bindings-at
                    ctx
                    expr-bases
                    env
                    locals
                    borrowed0
                    protected
                    bindings
                    body-box
                    index)))]))])))

(define (tc-borrow-check-let-exit
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [outer-locals : TcMovedSet]
  [outer-borrowed : TcMovedSet]
  [body-borrowed : TcMovedSet]
  [body-box : i64]) : TcBorrowCheckResult
  (let
    [outer-with-uses : TcMovedSet
      (tc-borrow-check-propagate-lending-uses
        (tc-global-shared-view body-borrowed)
        outer-borrowed)]
    (if (<= (tc-moved-len body-borrowed) (tc-moved-len outer-with-uses))
      (Ok outer-with-uses)
      (match (tc-body-type-fact-expr-id "borrow.let_return" ctx env body-box)
        [(Ok result-ty)
          (Ok
            (tc-borrow-check-propagate-return-borrows
              ctx
              expr-bases
              env
              outer-locals
              outer-with-uses
              body-borrowed
              result-ty
              (ast.ast-expr-segment-bases-get expr-bases body-box)))]
        [(Err _) (Ok outer-with-uses)]))))

(define (tc-borrow-check-resource-bindings
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bindings : ast.AstResourceBindingList]) : TcBorrowCheckResourceBindings
  (tc-borrow-check-resource-bindings-at
    ctx
    expr-bases
    env
    locals
    borrowed
    (& bindings)
    0))

(define (tc-borrow-check-resource-bindings-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [index : i64]) : TcBorrowCheckResourceBindings
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    (Ok env locals borrowed)
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(Binding name init-box _ _)
        (let
          [_init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [borrowed1
            (try
              (tc-borrow-check-expr-id
                ctx
                expr-bases
                env
                (tc-global-shared-view locals)
                borrowed
                init-box))]
          [borrowed2
            (try
              (tc-borrow-check-after-bind-id
                ctx
                expr-bases
                env
                (tc-global-shared-view locals)
                borrowed1
                init-box))]
          [init-ty
            (try
              (tc-body-type-fact-expr-id
                "borrow.resource_init"
                ctx
                env
                init-box))]
          (tc-borrow-check-resource-bindings-at
            ctx
            expr-bases
            (tc-bind-id
              (tc-bind-id env (tc-cleanup-owner-marker-id) (Var name))
              name
              (tc-type-without-regions init-ty))
            (tc-moved-add locals name)
            (tc-moved-remove-root-state borrowed2 name)
            bindings
            (+ index 1)))])))

(define (tc-borrow-check-arms-join
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]
  [joined : TcMovedSet]) : TcBorrowCheckResult
  (tc-borrow-check-arms-join-at
    ctx
    expr-bases
    env
    locals
    borrowed
    scrut-ty
    (& arms)
    joined
    0))

(define (tc-borrow-check-arms-join-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : ast.AstType]
  [arms : (& arms ast.AstMatchArmList)]
  [joined : TcMovedSet]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index arms.len)
    (Ok joined)
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (let
          [arm-env
            (try
              (tc-bind-match-pattern
                ctx
                env
                (tc-global-shared-view scrut-ty)
                (tc-global-shared-view pattern)))]
          [arm-borrowed
            (try
              (tc-borrow-check-expr-id
                ctx
                expr-bases
                arm-env
                (tc-borrow-check-pattern-locals
                  ctx
                  (tc-global-shared-view scrut-ty)
                  (tc-global-shared-view pattern)
                  (tc-moved-clone locals))
                (tc-moved-clone borrowed)
                body-box))]
          [visible-arm-borrowed : TcMovedSet
            (tc-move-remove-bound-root-states
              arm-borrowed
              (tc-borrow-check-pattern-bound-names
                ctx
                (tc-global-shared-view scrut-ty)
                pattern))]
          (tc-borrow-check-arms-join-at
            ctx
            expr-bases
            env
            locals
            borrowed
            scrut-ty
            arms
            (tc-moved-union joined visible-arm-borrowed)
            (+ index 1)))])))

(define (tc-borrow-check-arms
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]) : TcBorrowCheckResult
  (tc-borrow-check-arms-join
    ctx
    expr-bases
    env
    locals
    (tc-global-shared-view borrowed)
    scrut-ty
    arms
    borrowed))

(define (tc-borrow-check-expr-id
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr-id : i64]) : TcBorrowCheckResult
  (tc-borrow-check-expr
    ctx
    expr-bases
    env
    locals
    borrowed
    (ast.ast-expr-segment-bases-get expr-bases expr-id)))

(define (tc-borrow-check-slice-view-call
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : ast.AstExpr]
  [kind : TcSliceViewCallKind]
  [args : ast.AstExprList]) : TcBorrowCheckResult
  (if (= args.len 3)
    (let
      [source : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get (& args) 0 0))]
      [start : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get (& args) 1 0))]
      [len : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get (& args) 2 0))]
      ;; Evaluate the source first.  A direct place receives the same normal
      ;; shared/mutable borrow fact as an explicit `&`/`&mut`; nested view
      ;; calls and explicit borrow rvalues have no direct path, so their
      ;; recursive facts are intentionally retained unchanged.
      [borrowed1
        (try
          (tc-borrow-check-expr
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            borrowed
            (tc-global-shared-view source)))]
      [borrowed2
        (try
          (tc-borrow-check-add-place-with-mutability
            expr-bases
            (tc-global-shared-view locals)
            borrowed1
            (tc-slice-call-mutable? kind)
            source
            call-expr))]
      [borrowed3
        (try
          (tc-borrow-check-expr
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            borrowed2
            start))]
      (tc-borrow-check-expr ctx expr-bases env locals borrowed3 len))
    (Err
      (tc-locate-error-at-expr
        expr-bases
        call-expr
        "typecheck: slice-view expects exactly three arguments"))))

(define (tc-borrow-check-add-slice-split-provenance
  [borrowed : TcMovedSet]
  [base : TcMovePath]
  [mutable : bool]
  [split-id : i64]
  [origin : ast.AstExpr]) : TcMovedSet
  (tc-borrow-check-add-borrow-path
    (tc-borrow-check-add-borrow-path
      borrowed
      (tc-move-slice-split-half-path base split-id 0)
      mutable
      (tc-global-shared-view origin))
    (tc-move-slice-split-half-path base split-id 1)
    mutable
    origin))

(define (tc-borrow-check-slice-split-call
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : ast.AstExpr]
  [kind : TcSliceViewCallKind]
  [args : ast.AstExprList]) : TcBorrowCheckResult
  (if (= args.len 2)
    (let
      [source : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get (& args) 0 0))]
      [mid : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get (& args) 1 0))]
      [mutable : bool (tc-slice-call-mutable? kind)]
      [borrowed1
        (try
          (tc-borrow-check-expr
            ctx
            expr-bases
            env
            (tc-global-shared-view locals)
            borrowed
            (tc-global-shared-view source)))]
      [borrowed2
        (try
          (tc-borrow-check-add-place-with-mutability
            expr-bases
            (tc-global-shared-view locals)
            (tc-global-shared-view borrowed1)
            mutable
            (tc-global-shared-view source)
            (tc-global-shared-view call-expr)))]
      [with-provenance : TcMovedSet
        (if mutable
          (match (tc-borrow-check-split-provenance expr-bases borrowed1 source)
            [(Some base)
              (tc-borrow-check-add-slice-split-provenance
                borrowed2
                base
                mutable
                (ast.ast-node-push (tc-global-shared-view call-expr))
                call-expr)]
            [(No) borrowed2])
          borrowed2)]
      (tc-borrow-check-expr ctx expr-bases env locals with-provenance mid))
    (Err
      (tc-locate-error-at-expr
        expr-bases
        call-expr
        "typecheck: slice-split-at expects exactly two arguments"))))

(define (tc-borrow-check-expr
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : ast.AstExpr]) : TcBorrowCheckResult
  (match (tc-global-shared-view expr)
    [(or (Spanned inner-box _) (MacroExpansion inner-box _ _)
         (Unary _ inner-box))
      (tc-borrow-check-expr-id ctx expr-bases env locals borrowed inner-box)]
    [(ForOwnedState payload)
      (let
        [source-name-id : i64 (ast.ast-for-owned-state-source-name (& payload))]
        [index-name-id : i64 (ast.ast-for-owned-state-index-name (& payload))]
        [source-id : i64 (ast.ast-for-owned-state-source (& payload))]
        [body-id : i64 (ast.ast-for-owned-state-body (& payload))]
        [source-name : i64 (tc-for-owned-name-id expr-bases source-name-id)]
        [index-name : i64 (tc-for-owned-name-id expr-bases index-name-id)]
        (if (or (< source-name 0) (< index-name 0))
          (Err "typecheck: invalid internal scalar for owned-array state")
          (let
            [borrowed1
              (try
                (tc-borrow-check-expr-id
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view locals)
                  (tc-global-shared-view borrowed)
                  source-id))]
            [source-ty : ast.AstType
              (try
                (tc-body-type-fact-expr-id
                  "borrow.for_owned_source"
                  ctx
                  env
                  source-id))]
            [borrowed2
              (try
                (tc-borrow-check-after-bind-known-type-id
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view locals)
                  borrowed1
                  source-name
                  source-id
                  (tc-global-shared-view source-ty)))]
            [borrowed3 : TcMovedSet
              (try
                (tc-borrow-check-expr-with-protected-id
                  ctx
                  expr-bases
                  (tc-bind-id
                    (tc-bind-id env source-name source-ty)
                    index-name
                    (I64))
                  (tc-moved-add (tc-moved-add locals source-name) index-name)
                  (tc-moved-remove-root-state
                    (tc-moved-remove-root-state borrowed2 source-name)
                    index-name)
                  borrowed
                  body-id))]
            (Ok
              (tc-moved-remove-root-state
                (tc-moved-remove-root-state borrowed3 source-name)
                index-name)))))]
    [(ForOwnedStep payload)
      (let
        [source-id : i64 (ast.ast-for-owned-step-source-name (& payload))]
        [index-id : i64 (ast.ast-for-owned-step-index-name (& payload))]
        [binding-id : i64 (ast.ast-for-owned-step-binding-name (& payload))]
        [done-id : i64 (ast.ast-for-owned-step-done-name (& payload))]
        [body-id : i64 (ast.ast-for-owned-step-body (& payload))]
        [binding-name : i64 (tc-for-owned-name-id expr-bases binding-id)]
        (if (< binding-name 0)
          (Err "typecheck: invalid internal scalar for item binding")
          (let
            [borrowed1
              (try
                (tc-borrow-check-expr-id
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view locals)
                  (tc-global-shared-view borrowed)
                  source-id))]
            [borrowed2
              (try
                (tc-borrow-check-expr-id
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view locals)
                  borrowed1
                  index-id))]
            [borrowed3
              (try
                (tc-borrow-check-expr-id
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view locals)
                  borrowed2
                  done-id))]
            [source-ty : ast.AstType
              (try
                (tc-body-type-fact-expr-id
                  "borrow.for_owned_step_source"
                  ctx
                  env
                  source-id))]
            (match (tc-type-strip-region (tc-resolve-type ctx source-ty))
              [(Array elem-id _)
                (let
                  [borrowed4 : TcMovedSet
                    (try
                      (tc-borrow-check-expr-with-protected-id
                        ctx
                        expr-bases
                        (tc-bind-id
                          env
                          binding-name
                          (tc-context-type-get ctx elem-id))
                        (tc-moved-add locals binding-name)
                        (tc-moved-remove-root-state borrowed3 binding-name)
                        borrowed
                        body-id))]
                  (Ok (tc-moved-remove-root-state borrowed4 binding-name)))]
              [_
                (Err
                  "typecheck: scalar for owned step requires fixed-array state")]))))]
    [(or (Literal _) (TypeLiteral _) (Init _) (Comptime _) (Quote _)
         (Quasiquote _) (Unquote _) (UnquoteSplicing _) (PtrNull _)
         (BinaryData _) (SpmdProgramIndex) (SpmdProgramCount) (ProgramArgc)
         (ProgramArgv) (ProgramEnvp))
      (Ok borrowed)]
    [(Var name)
      (if (tc-dotted-place-name-id? ctx env name)
        (let
          [virtual-id
            (try
              (tc-dotted-local-field-expr-id-after-check
                (tc-context-structural-session ctx)
                name))]
          (tc-borrow-check-expr-id
            ctx
            expr-bases
            env
            locals
            borrowed
            virtual-id))
        (Ok (tc-borrow-check-note-lending-use borrowed name)))]
    [(Binary _ left-box right-box)
      (let
        [borrowed1
          (try
            (tc-borrow-check-expr-id
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed
              left-box))]
        (tc-borrow-check-expr-id ctx expr-bases env locals borrowed1 right-box))]
    [(Call func-box args)
      (let
        [func : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases func-box)]
        [slice-kind : TcSliceViewCallKind
          (tc-slice-view-call-kind ctx env (tc-global-shared-view func))]
        (if (= slice-kind TcSliceViewCallKind.None)
          (let
            [borrowed1
              (try
                (tc-borrow-check-expr-id
                  ctx
                  expr-bases
                  env
                  (tc-global-shared-view locals)
                  borrowed
                  func-box))]
            [borrowed2 : TcMovedSet
              (tc-borrow-check-note-called-lambda-capture-uses
                expr-bases
                borrowed1
                (tc-global-shared-view func))]
            (match (tc-borrow-call-info-id-with-facts
              "borrow.call_func"
              ctx
              expr-bases
              env
              func-box
              (tc-global-shared-view args))
              [(Ok params return-lifetimes)
                (match (tc-call-extern-abi ctx (tc-global-shared-view func))
                  [(Some abi)
                    (if (tc-call-dynamic-c-varargs-abi?
                      (tc-global-shared-view abi))
                      (let
                        [expanded-params
                          (try
                            (tc-call-extern-varargs-params
                              ctx
                              env
                              (tc-global-shared-view func)
                              (tc-global-shared-view args)
                              params
                              abi))]
                        (tc-borrow-check-call-args-with-types
                          ctx
                          expr-bases
                          env
                          locals
                          borrowed2
                          expr
                          func-box
                          func
                          args
                          expanded-params
                          true
                          (Fallback)))
                      (tc-borrow-check-call-args-with-types
                        ctx
                        expr-bases
                        env
                        locals
                        borrowed2
                        expr
                        func-box
                        func
                        args
                        params
                        true
                        return-lifetimes))]
                  [(No)
                    (tc-borrow-check-call-args-with-types
                      ctx
                      expr-bases
                      env
                      locals
                      borrowed2
                      expr
                      func-box
                      func
                      args
                      params
                      false
                      return-lifetimes)])]
              [(Err _)
                (let
                  [_
                    (try
                      (tc-borrow-check-read-exprs
                        ctx
                        expr-bases
                        env
                        (tc-global-shared-view locals)
                        (tc-moved-clone borrowed2)
                        (tc-global-shared-view args)))]
                  (tc-borrow-check-after-call-effects
                    ctx
                    expr-bases
                    env
                    locals
                    borrowed2
                    expr
                    func
                    args
                    (ast.ast-type-list-new)
                    (Fallback)))]))
          (if (tc-slice-call-split? slice-kind)
            (tc-borrow-check-slice-split-call
              ctx
              expr-bases
              env
              locals
              borrowed
              expr
              slice-kind
              args)
            (tc-borrow-check-slice-view-call
              ctx
              expr-bases
              env
              locals
              borrowed
              expr
              slice-kind
              args))))]
    [(or (BracketClause items) (Begin items) (Unsafe items))
      (tc-borrow-check-exprs ctx expr-bases env locals borrowed items)]
    [(If cond-box then-branch-box else-branch-box)
      (let
        [borrowedc
          (try
            (tc-borrow-check-expr-id
              ctx
              expr-bases
              env
              (tc-global-shared-view locals)
              borrowed
              cond-box))]
        [borrowedt
          (try
            (tc-borrow-check-expr-id
              ctx
              expr-bases
              env
              (tc-moved-clone locals)
              (tc-moved-clone borrowedc)
              then-branch-box))]
        [borrowede : TcMovedSet
          (try
            (tc-borrow-check-expr-id
              ctx
              expr-bases
              env
              (tc-moved-clone locals)
              (tc-moved-clone borrowedc)
              else-branch-box))]
        (Ok (tc-moved-union borrowedt borrowede)))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (match (tc-borrow-check-let-bindings
            ctx
            expr-bases
            env
            (tc-moved-clone locals)
            (tc-moved-clone borrowed)
            (tc-global-shared-view borrowed)
            bindings
            body-box)
            [(Ok env2 locals2 borrowed2)
              (match (tc-borrow-check-expr-with-protected-id
                ctx
                expr-bases
                env2
                (tc-global-shared-view locals2)
                (tc-global-shared-view borrowed2)
                (tc-global-shared-view borrowed)
                body-box)
                [(Ok body-borrowed)
                  (tc-borrow-check-let-exit
                    ctx
                    expr-bases
                    env2
                    locals
                    borrowed
                    body-borrowed
                    body-box)]
                [(Err message)
                  (let
                    [retried-borrowed
                      (try
                        (tc-borrow-check-expr-id-retry-after-prune
                          ctx
                          expr-bases
                          env2
                          locals2
                          borrowed2
                          (tc-global-shared-view borrowed)
                          body-box
                          message))]
                    (tc-borrow-check-let-exit
                      ctx
                      expr-bases
                      env2
                      locals
                      borrowed
                      retried-borrowed
                      body-box))])]
            [(Err message) (Err message)])])]
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda params _ body-box)
          (let
            [_
              (try
                (tc-borrow-check-expr-id
                  ctx
                  expr-bases
                  (tc-bind-params ctx env params)
                  (tc-move-params-locals params (tc-moved-clone locals))
                  (tc-moved-empty)
                  body-box))]
            (Ok borrowed))])]
    [(Tuple exprs)
      (match (tc-body-type-fact-expr-list-types
        "borrow.tuple_list"
        ctx
        env
        (tc-global-shared-view exprs))
        [(Ok types)
          (tc-borrow-check-exprs-with-types
            ctx
            expr-bases
            env
            locals
            borrowed
            exprs
            types)]
        [(Err _)
          (tc-borrow-check-exprs ctx expr-bases env locals borrowed exprs)])]
