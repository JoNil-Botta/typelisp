              [(TcSpmdExprInfo _ ptr-class ptr-env)
                (match (tc-spmd-expr ctx env ptr-env offset)
                  [(OkTcSpmdExprInfo offset-info)
                    (match offset-info
                      [(TcSpmdExprInfo _ offset-class offset-env)
                        (tc-spmd-finish
                          expr-ty
                          (tc-spmd-merge-class ptr-class offset-class)
                          offset-env)])]
                  [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)])])]
          [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)]))]
    [(AstExprPtrCast ptr-box _)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (match (tc-spmd-expr ctx env spmd-env ptr)
          [(OkTcSpmdExprInfo info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)]))]
    [(AstExprPtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (match (tc-spmd-expr ctx env spmd-env ptr)
          [(OkTcSpmdExprInfo info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)]))]
    [(AstExprIntToPtr value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-spmd-expr ctx env spmd-env value)
          [(OkTcSpmdExprInfo info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)]))]
    [(AstExprStringData str-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        (match (tc-spmd-expr ctx env spmd-env str)
          [(OkTcSpmdExprInfo info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)]))]
    [(AstExprStringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (match (tc-spmd-expr ctx env spmd-env ptr)
          [(OkTcSpmdExprInfo ptr-info)
            (match ptr-info
              [(TcSpmdExprInfo _ ptr-class ptr-env)
                (match (tc-spmd-expr ctx env ptr-env len)
                  [(OkTcSpmdExprInfo len-info)
                    (match len-info
                      [(TcSpmdExprInfo _ len-class len-env)
                        (tc-spmd-finish
                          expr-ty
                          (tc-spmd-merge-class ptr-class len-class)
                          len-env)])]
                  [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)])])]
          [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)]))]
    [(AstExprArrayData array-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (match (tc-spmd-expr ctx env spmd-env array)
          [(OkTcSpmdExprInfo info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)]))]
    [(AstExprBinaryData _) (tc-spmd-finish expr-ty TcSpmdUniform spmd-env)]
    [(AstExprProgramArgc) (tc-spmd-finish expr-ty TcSpmdUniform spmd-env)]
    [(AstExprProgramArgv) (tc-spmd-finish expr-ty TcSpmdUniform spmd-env)]
    [(AstExprProgramEnvp) (tc-spmd-finish expr-ty TcSpmdUniform spmd-env)]
    [(AstExprCpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-spmd-cpuid-like ctx env spmd-env expr-ty leaf subleaf))]
    [(AstExprCpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-spmd-cpuid-like ctx env spmd-env expr-ty leaf subleaf))]
    [(AstExprCpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-spmd-cpuid-like ctx env spmd-env expr-ty leaf subleaf))]
    [(AstExprCpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-spmd-cpuid-like ctx env spmd-env expr-ty leaf subleaf))]
    [(AstExprXgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-spmd-expr ctx env spmd-env index)
          [(OkTcSpmdExprInfo info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)]))]
    [(AstExprSyscall args)
      (match (tc-spmd-expr-list ctx env spmd-env args)
        [(OkTcSpmdExprListInfo args-info)
          (match args-info
            [(TcSpmdExprListInfo args-class args-env)
              (match (tc-spmd-require-uniform
                args-class
                "typecheck: foreach calls with varying arguments are not supported")
                [(OkTcUnit) (tc-spmd-finish expr-ty TcSpmdUniform args-env)]
                [(ErrTcUnit message) (ErrTcSpmdExprInfo message)])])]
        [(ErrTcSpmdExprListInfo message) (ErrTcSpmdExprInfo message)])]))

(define (tc-param-list-add-bound-names
  [params : AstParamList]
  [bound : TcStringList]) : TcStringList
  (match params
    [(AstParamNil) bound]
    [(AstParamCons param rest)
      (let
        [rest : AstParamList (box-get rest)]
        (match param
          [(AstParam name _ _)
            (tc-param-list-add-bound-names
              rest
              (tc-string-list-add bound (intern-str name)))]))]))

(define (tc-param-bound-names [params : AstParamList]) : TcStringList
  (tc-param-list-add-bound-names params TcStringNil))

(define (tc-pattern-add-bound-names
  [pattern : AstPattern]
  [bound : TcStringList]) : TcStringList
  (match pattern
    [(AstPatVar name _) (tc-string-list-add bound (intern-str name))]
    [(AstPatTuple patterns-box)
      (let
        [patterns : AstPatternList (box-get patterns-box)]
        (tc-pattern-list-add-bound-names patterns bound))]
    [(AstPatWildcard) bound]
    [(AstPatBinding name) (tc-string-list-add bound (intern-str name))]
    [(AstPatVariant _ patterns-box)
      (let
        [patterns : AstPatternList (box-get patterns-box)]
        (tc-pattern-list-add-bound-names patterns bound))]
    [(AstPatLiteral _) bound]))

(define (tc-pattern-list-add-bound-names
  [patterns : AstPatternList]
  [bound : TcStringList]) : TcStringList
  (match patterns
    [(AstPatternNil) bound]
    [(AstPatternCons pattern rest)
      (let
        [pattern : AstPattern (box-get pattern)]
        [rest : AstPatternList (box-get rest)]
        (tc-pattern-list-add-bound-names
          rest
          (tc-pattern-add-bound-names pattern bound)))]))

(define (tc-let-binding-list-add-bound-names
  [bindings : AstLetBindingList]
  [bound : TcStringList]) : TcStringList
  (match bindings
    [(AstLetBindingNil) bound]
    [(AstLetBindingCons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding name _ _)
            (tc-let-binding-list-add-bound-names
              rest
              (tc-string-list-add bound (intern-str name)))]))]))

(define (tc-resource-binding-list-add-bound-names
  [bindings : AstResourceBindingList]
  [bound : TcStringList]) : TcStringList
  (match bindings
    [(AstResourceBindingNil) bound]
    [(AstResourceBindingCons binding rest)
      (let
        [rest : AstResourceBindingList (box-get rest)]
        (match binding
          [(AstResourceBinding name _ _)
            (tc-resource-binding-list-add-bound-names
              rest
              (tc-string-list-add bound (intern-str name)))]))]))

(define (tc-expr-list-uses-free-name?
  [exprs : AstExprList]
  [name : String]
  [bound : TcStringList]) : bool
  (match exprs
    [(AstExprNil) false]
    [(AstExprCons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (or
          (tc-expr-uses-free-name? expr name bound)
          (tc-expr-list-uses-free-name? rest name bound)))]))

(define (tc-let-binding-list-uses-free-name?
  [bindings : AstLetBindingList]
  [name : String]
  [bound : TcStringList]) : bool
  (match bindings
    [(AstLetBindingNil) false]
    [(AstLetBindingCons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding bind-name _ init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (or
                (tc-expr-uses-free-name? init name bound)
                (tc-let-binding-list-uses-free-name?
                  rest
                  name
                  (tc-string-list-add bound (intern-str bind-name)))))]))]))

(define (tc-resource-binding-list-uses-free-name?
  [bindings : AstResourceBindingList]
  [name : String]
  [bound : TcStringList]) : bool
  (match bindings
    [(AstResourceBindingNil) false]
    [(AstResourceBindingCons binding rest)
      (let
        [rest : AstResourceBindingList (box-get rest)]
        (match binding
          [(AstResourceBinding bind-name init-box cleanup-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              [cleanup : AstExpr (ast-node-get cleanup-box)]
              (or
                (tc-expr-uses-free-name? init name bound)
                (tc-expr-uses-free-name? cleanup name bound)
                (tc-resource-binding-list-uses-free-name?
                  rest
                  name
                  (tc-string-list-add bound (intern-str bind-name)))))]))]))

(define (tc-match-arms-use-free-name?
  [arms : AstMatchArmList]
  [name : String]
  [bound : TcStringList]) : bool
  (match arms
    [(AstMatchArmNil) false]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm pattern body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (or
                (tc-expr-uses-free-name?
                  body
                  name
                  (tc-pattern-add-bound-names pattern bound))
                (tc-match-arms-use-free-name? rest name bound)))]))]))

(define (tc-expr-uses-free-name?
  [expr : AstExpr]
  [name : String]
  [bound : TcStringList]) : bool
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExprLiteral _) false]
    [(AstExprVar var-name)
      (and
        (string.string-eq (intern-str var-name) name)
        (not (tc-string-list-contains bound name)))]
    [(AstExprBinary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (or
          (tc-expr-uses-free-name? left name bound)
          (tc-expr-uses-free-name? right name bound)))]
    [(AstExprUnary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExprCall func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (or
          (tc-expr-uses-free-name? func name bound)
          (tc-expr-list-uses-free-name? args name bound)))]
    [(AstExprBracketClause items)
      (tc-expr-list-uses-free-name? items name bound)]
    [(AstExprTypeLiteral _) false]
    [(AstExprInit _) false]
    [(AstExprIf cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (or
          (tc-expr-uses-free-name? cond name bound)
          (tc-expr-uses-free-name? then-branch name bound)
          (tc-expr-uses-free-name? else-branch name bound)))]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (or
              (tc-let-binding-list-uses-free-name? bindings name bound)
              (tc-expr-uses-free-name?
                body
                name
                (tc-let-binding-list-add-bound-names bindings bound))))])]
    [(AstExprLambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda params _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (tc-expr-uses-free-name?
              body
              name
              (tc-param-list-add-bound-names params bound)))])]
    [(AstExprTuple exprs) (tc-expr-list-uses-free-name? exprs name bound)]
    [(AstExprTupleRef tuple-box _)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        (tc-expr-uses-free-name? tuple name bound))]
    [(AstExprArray exprs) (tc-expr-list-uses-free-name? exprs name bound)]
    [(AstExprMakeArray _ len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (tc-expr-uses-free-name? len name bound))]
    [(AstExprArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (or
          (tc-expr-uses-free-name? array name bound)
          (tc-expr-uses-free-name? index name bound)))]
    [(AstExprArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (tc-expr-uses-free-name? array name bound)
          (tc-expr-uses-free-name? index name bound)
          (tc-expr-uses-free-name? value name bound)))]
    [(AstExprArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (tc-expr-uses-free-name? array name bound)
          (tc-expr-uses-free-name? value name bound)))]
    [(AstExprStringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (or
          (tc-expr-uses-free-name? str name bound)
          (tc-expr-uses-free-name? index name bound)))]
    [(AstExprWhile cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (or
          (tc-expr-uses-free-name? cond name bound)
          (tc-expr-uses-free-name? body name bound)))]
    [(AstExprBegin exprs) (tc-expr-list-uses-free-name? exprs name bound)]
    [(AstExprUnsafe exprs) (tc-expr-list-uses-free-name? exprs name bound)]
    [(AstExprSet var-name value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (or
          (and
            (string.string-eq (intern-str var-name) name)
            (not (tc-string-list-contains bound name)))
          (tc-expr-uses-free-name? value name bound)))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExprBorrow _ _ place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (tc-expr-uses-free-name? place name bound))]
    [(AstExprBox inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExprBoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExprBoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExprBoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (tc-expr-uses-free-name? inner name bound)
          (tc-expr-uses-free-name? value name bound)))]
    [(AstExprMatch match-box)
      (match (box-get match-box)
        [(AstMatch scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            (or
              (tc-expr-uses-free-name? scrutinee name bound)
              (tc-match-arms-use-free-name? arms name bound)))])]
    [(AstExprForeach fe-box)
      (match (box-get fe-box)
        [(AstForeach index _ start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (or
              (tc-expr-uses-free-name? start name bound)
              (tc-expr-uses-free-name? end name bound)
              (tc-expr-uses-free-name?
                body
                name
                (tc-string-list-add bound (intern-str index)))))])]
    [(AstExprSpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce _ index _ start-box end-box init-box value-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            (or
              (tc-expr-uses-free-name? start name bound)
              (tc-expr-uses-free-name? end name bound)
              (tc-expr-uses-free-name? init name bound)
              (tc-expr-uses-free-name?
                value
                name
                (tc-string-list-add bound (intern-str index)))))])]
    [(AstExprSpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan
            _
            index
            _
            start-box
            end-box
            prefix
            _
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            [value-bound : TcStringList
              (tc-string-list-add bound (intern-str index))]
            [body-bound : TcStringList
              (tc-string-list-add value-bound (intern-str prefix))]
            (or
              (tc-expr-uses-free-name? start name bound)
              (tc-expr-uses-free-name? end name bound)
              (tc-expr-uses-free-name? init name bound)
              (tc-expr-uses-free-name? value name value-bound)
              (tc-expr-uses-free-name? body name body-bound)))])]
    [(AstExprSpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (or
          (tc-expr-uses-free-name? value name bound)
          (tc-expr-uses-free-name? lane name bound)))]
    [(AstExprSpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (or
          (tc-expr-uses-free-name? value name bound)
          (tc-expr-uses-free-name? lane name bound)))]
    [(AstExprStructGet receiver-box _)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (tc-expr-uses-free-name? receiver name bound))]
    [(AstExprStructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (tc-expr-uses-free-name? receiver name bound)
          (tc-expr-uses-free-name? value name bound)))]
    [(AstExprWithRegion _ body) (tc-expr-list-uses-free-name? body name bound)]
    [(AstExprWithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (or
          (tc-expr-uses-free-name? scratch name bound)
          (tc-expr-list-uses-free-name? body name bound)))]
    [(AstExprWithScratch body) (tc-expr-list-uses-free-name? body name bound)]
    [(AstExprInArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (or
          (tc-expr-uses-free-name? arena name bound)
          (tc-expr-list-uses-free-name? body name bound)))]
    [(AstExprWithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource bindings body)
          (or
            (tc-resource-binding-list-uses-free-name? bindings name bound)
            (tc-expr-list-uses-free-name?
              body
              name
              (tc-resource-binding-list-add-bound-names bindings bound)))])]
    [(AstExprTypeLiteral _) false]
    [(AstExprInit _) false]
    [(AstExprComptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExprQuote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExprQuasiquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExprUnquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExprUnquoteSplicing inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExprTry inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExprReturn inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExprPtrNull _) false]
    [(AstExprPtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExprPtrAddrOf var-name)
      (and
        (string.string-eq (intern-str var-name) name)
        (not (tc-string-list-contains bound name)))]
    [(AstExprPtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-expr-uses-free-name? ptr name bound))]
    [(AstExprPtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (tc-expr-uses-free-name? ptr name bound)
          (tc-expr-uses-free-name? value name bound)))]
    [(AstExprPtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (or
          (tc-expr-uses-free-name? ptr name bound)
          (tc-expr-uses-free-name? offset name bound)))]
    [(AstExprPtrCast ptr-box _)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-expr-uses-free-name? ptr name bound))]
    [(AstExprPtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-expr-uses-free-name? ptr name bound))]
    [(AstExprIntToPtr value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-expr-uses-free-name? value name bound))]
    [(AstExprStringData str-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        (tc-expr-uses-free-name? str name bound))]
    [(AstExprStringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (or
          (tc-expr-uses-free-name? ptr name bound)
          (tc-expr-uses-free-name? len name bound)))]
    [(AstExprArrayData array-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-expr-uses-free-name? array name bound))]
    [(AstExprBinaryData _) false]
    [(AstExprSpmdProgramIndex) false]
    [(AstExprSpmdProgramCount) false]
    [(AstExprProgramArgc) false]
    [(AstExprProgramArgv) false]
    [(AstExprProgramEnvp) false]
    [(AstExprCpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or
          (tc-expr-uses-free-name? leaf name bound)
          (tc-expr-uses-free-name? subleaf name bound)))]
    [(AstExprCpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or
          (tc-expr-uses-free-name? leaf name bound)
          (tc-expr-uses-free-name? subleaf name bound)))]
    [(AstExprCpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or
          (tc-expr-uses-free-name? leaf name bound)
          (tc-expr-uses-free-name? subleaf name bound)))]
    [(AstExprCpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or
          (tc-expr-uses-free-name? leaf name bound)
          (tc-expr-uses-free-name? subleaf name bound)))]
    [(AstExprXgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (tc-expr-uses-free-name? index name bound))]
    [(AstExprSyscall args) (tc-expr-list-uses-free-name? args name bound)]))

;; Same shadowing rules as `tc-expr-uses-free-name?`, but it only returns true
;; when the expression assigns to the free name. Lambda capture checks use this
;; to reject mutation of captured bindings while allowing local parameter/let
;; assignment inside the lambda.
(define (tc-expr-list-sets-free-name?
  [exprs : AstExprList]
  [name : String]
  [bound : TcStringList]) : bool
  (match exprs
    [(AstExprNil) false]
    [(AstExprCons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (or
          (tc-expr-sets-free-name? expr name bound)
          (tc-expr-list-sets-free-name? rest name bound)))]))

(define (tc-let-binding-list-sets-free-name?
  [bindings : AstLetBindingList]
  [name : String]
  [bound : TcStringList]) : bool
  (match bindings
    [(AstLetBindingNil) false]
    [(AstLetBindingCons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding bind-name _ init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (or
                (tc-expr-sets-free-name? init name bound)
                (tc-let-binding-list-sets-free-name?
                  rest
                  name
                  (tc-string-list-add bound (intern-str bind-name)))))]))]))

(define (tc-resource-binding-list-sets-free-name?
  [bindings : AstResourceBindingList]
  [name : String]
  [bound : TcStringList]) : bool
  (match bindings
    [(AstResourceBindingNil) false]
    [(AstResourceBindingCons binding rest)
      (let
        [rest : AstResourceBindingList (box-get rest)]
        (match binding
          [(AstResourceBinding bind-name init-box cleanup-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              [cleanup : AstExpr (ast-node-get cleanup-box)]
              (or
                (tc-expr-sets-free-name? init name bound)
                (tc-expr-sets-free-name? cleanup name bound)
                (tc-resource-binding-list-sets-free-name?
                  rest
                  name
                  (tc-string-list-add bound (intern-str bind-name)))))]))]))

(define (tc-match-arms-set-free-name?
  [arms : AstMatchArmList]
  [name : String]
  [bound : TcStringList]) : bool
  (match arms
    [(AstMatchArmNil) false]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm pattern body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (or
                (tc-expr-sets-free-name?
                  body
                  name
                  (tc-pattern-add-bound-names pattern bound))
                (tc-match-arms-set-free-name? rest name bound)))]))]))

(define (tc-expr-sets-free-name?
  [expr : AstExpr]
  [name : String]
  [bound : TcStringList]) : bool
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExprLiteral _) false]
    [(AstExprVar _) false]
    [(AstExprBinary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (or
          (tc-expr-sets-free-name? left name bound)
          (tc-expr-sets-free-name? right name bound)))]
    [(AstExprUnary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExprCall func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (or
          (tc-expr-sets-free-name? func name bound)
          (tc-expr-list-sets-free-name? args name bound)))]
    [(AstExprBracketClause items)
      (tc-expr-list-sets-free-name? items name bound)]
    [(AstExprIf cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (or
          (tc-expr-sets-free-name? cond name bound)
          (tc-expr-sets-free-name? then-branch name bound)
          (tc-expr-sets-free-name? else-branch name bound)))]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (or
              (tc-let-binding-list-sets-free-name? bindings name bound)
              (tc-expr-sets-free-name?
                body
                name
                (tc-let-binding-list-add-bound-names bindings bound))))])]
    [(AstExprLambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda params _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (tc-expr-sets-free-name?
              body
              name
              (tc-param-list-add-bound-names params bound)))])]
    [(AstExprTuple exprs) (tc-expr-list-sets-free-name? exprs name bound)]
    [(AstExprTupleRef tuple-box _)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        (tc-expr-sets-free-name? tuple name bound))]
    [(AstExprArray exprs) (tc-expr-list-sets-free-name? exprs name bound)]
    [(AstExprMakeArray _ len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (tc-expr-sets-free-name? len name bound))]
    [(AstExprArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (or
          (tc-expr-sets-free-name? array name bound)
          (tc-expr-sets-free-name? index name bound)))]
    [(AstExprArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (tc-expr-sets-free-name? array name bound)
          (tc-expr-sets-free-name? index name bound)
          (tc-expr-sets-free-name? value name bound)))]
    [(AstExprArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (tc-expr-sets-free-name? array name bound)
          (tc-expr-sets-free-name? value name bound)))]
    [(AstExprStringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (or
          (tc-expr-sets-free-name? str name bound)
          (tc-expr-sets-free-name? index name bound)))]
    [(AstExprWhile cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (or
          (tc-expr-sets-free-name? cond name bound)
          (tc-expr-sets-free-name? body name bound)))]
    [(AstExprBegin exprs) (tc-expr-list-sets-free-name? exprs name bound)]
    [(AstExprUnsafe exprs) (tc-expr-list-sets-free-name? exprs name bound)]
    [(AstExprSet var-name value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (or
          (and
            (string.string-eq (intern-str var-name) name)
            (not (tc-string-list-contains bound name)))
          (tc-expr-sets-free-name? value name bound)))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExprBorrow _ _ place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (tc-expr-sets-free-name? place name bound))]
    [(AstExprBox inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExprBoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExprBoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExprBoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (tc-expr-sets-free-name? inner name bound)
          (tc-expr-sets-free-name? value name bound)))]
    [(AstExprMatch match-box)
      (match (box-get match-box)
        [(AstMatch scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            (or
              (tc-expr-sets-free-name? scrutinee name bound)
              (tc-match-arms-set-free-name? arms name bound)))])]
    [(AstExprForeach fe-box)
      (match (box-get fe-box)
        [(AstForeach index _ start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (or
              (tc-expr-sets-free-name? start name bound)
              (tc-expr-sets-free-name? end name bound)
              (tc-expr-sets-free-name?
                body
                name
                (tc-string-list-add bound (intern-str index)))))])]
    [(AstExprSpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce _ index _ start-box end-box init-box value-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            (or
              (tc-expr-sets-free-name? start name bound)
              (tc-expr-sets-free-name? end name bound)
              (tc-expr-sets-free-name? init name bound)
              (tc-expr-sets-free-name?
                value
                name
                (tc-string-list-add bound (intern-str index)))))])]
    [(AstExprSpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan
            _
            index
            _
            start-box
            end-box
            prefix
            _
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            [value-bound : TcStringList
              (tc-string-list-add bound (intern-str index))]
            [body-bound : TcStringList
              (tc-string-list-add value-bound (intern-str prefix))]
            (or
              (tc-expr-sets-free-name? start name bound)
              (tc-expr-sets-free-name? end name bound)
              (tc-expr-sets-free-name? init name bound)
              (tc-expr-sets-free-name? value name value-bound)
              (tc-expr-sets-free-name? body name body-bound)))])]
    [(AstExprSpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (or
          (tc-expr-sets-free-name? value name bound)
          (tc-expr-sets-free-name? lane name bound)))]
    [(AstExprSpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (or
          (tc-expr-sets-free-name? value name bound)
          (tc-expr-sets-free-name? lane name bound)))]
    [(AstExprStructGet receiver-box _)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (tc-expr-sets-free-name? receiver name bound))]
    [(AstExprStructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (tc-expr-sets-free-name? receiver name bound)
          (tc-expr-sets-free-name? value name bound)))]
    [(AstExprWithRegion _ body) (tc-expr-list-sets-free-name? body name bound)]
    [(AstExprWithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (or
          (tc-expr-sets-free-name? scratch name bound)
          (tc-expr-list-sets-free-name? body name bound)))]
    [(AstExprWithScratch body) (tc-expr-list-sets-free-name? body name bound)]
    [(AstExprInArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (or
          (tc-expr-sets-free-name? arena name bound)
          (tc-expr-list-sets-free-name? body name bound)))]
    [(AstExprWithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource bindings body)
          (or
            (tc-resource-binding-list-sets-free-name? bindings name bound)
            (tc-expr-list-sets-free-name?
              body
              name
              (tc-resource-binding-list-add-bound-names bindings bound)))])]
    [(AstExprTypeLiteral _) false]
    [(AstExprInit _) false]
    [(AstExprComptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExprQuote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExprQuasiquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExprUnquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExprUnquoteSplicing inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExprTry inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExprReturn inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExprPtrNull _) false]
    [(AstExprPtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExprPtrAddrOf _) false]
    [(AstExprPtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-expr-sets-free-name? ptr name bound))]
    [(AstExprPtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (tc-expr-sets-free-name? ptr name bound)
          (tc-expr-sets-free-name? value name bound)))]
    [(AstExprPtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (or
          (tc-expr-sets-free-name? ptr name bound)
          (tc-expr-sets-free-name? offset name bound)))]
    [(AstExprPtrCast ptr-box _)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-expr-sets-free-name? ptr name bound))]
    [(AstExprPtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-expr-sets-free-name? ptr name bound))]
    [(AstExprIntToPtr value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-expr-sets-free-name? value name bound))]
    [(AstExprStringData str-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        (tc-expr-sets-free-name? str name bound))]
    [(AstExprStringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (or
          (tc-expr-sets-free-name? ptr name bound)
          (tc-expr-sets-free-name? len name bound)))]
    [(AstExprArrayData array-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-expr-sets-free-name? array name bound))]
    [(AstExprBinaryData _) false]
    [(AstExprSpmdProgramIndex) false]
    [(AstExprSpmdProgramCount) false]
    [(AstExprProgramArgc) false]
    [(AstExprProgramArgv) false]
    [(AstExprProgramEnvp) false]
    [(AstExprCpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or
          (tc-expr-sets-free-name? leaf name bound)
          (tc-expr-sets-free-name? subleaf name bound)))]
    [(AstExprCpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or
          (tc-expr-sets-free-name? leaf name bound)
          (tc-expr-sets-free-name? subleaf name bound)))]
    [(AstExprCpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or
          (tc-expr-sets-free-name? leaf name bound)
          (tc-expr-sets-free-name? subleaf name bound)))]
    [(AstExprCpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or
          (tc-expr-sets-free-name? leaf name bound)
          (tc-expr-sets-free-name? subleaf name bound)))]
    [(AstExprXgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (tc-expr-sets-free-name? index name bound))]
    [(AstExprSyscall args) (tc-expr-list-sets-free-name? args name bound)]))

(define (tc-name-is-free-cleanup-owner?
  [owners : TcStringList]
  [name : String]
  [bound : TcStringList]) : bool
  (and
    (tc-string-list-contains owners name)
    (not (tc-string-list-contains bound name))))

(define (tc-expr-list-result-uses-cleanup-owner?
  [exprs : AstExprList]
  [owners : TcStringList]
  [bound : TcStringList]) : bool
  (match exprs
    [(AstExprNil) false]
    [(AstExprCons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (match rest
          [(AstExprNil) (tc-expr-result-uses-cleanup-owner? expr owners bound)]
          [_ (tc-expr-list-result-uses-cleanup-owner? rest owners bound)]))]))

(define (tc-expr-list-any-result-uses-cleanup-owner?
  [exprs : AstExprList]
  [owners : TcStringList]
  [bound : TcStringList]) : bool
  (match exprs
    [(AstExprNil) false]
    [(AstExprCons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (or
          (tc-expr-result-uses-cleanup-owner? expr owners bound)
          (tc-expr-list-any-result-uses-cleanup-owner? rest owners bound)))]))

(define (tc-match-arms-result-use-cleanup-owner?
  [arms : AstMatchArmList]
  [owners : TcStringList]
  [bound : TcStringList]) : bool
  (match arms
    [(AstMatchArmNil) false]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm pattern body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (or
                (tc-expr-result-uses-cleanup-owner?
                  body
                  owners
                  (tc-pattern-add-bound-names pattern bound))
                (tc-match-arms-result-use-cleanup-owner? rest owners bound)))]))]))

(define (tc-expr-result-uses-cleanup-owner?
  [expr : AstExpr]
  [owners : TcStringList]
  [bound : TcStringList]) : bool
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-result-uses-cleanup-owner? inner owners bound))]
    [(AstExprVar name)
      (tc-name-is-free-cleanup-owner? owners (intern-str name) bound)]
    [(AstExprIf _ then-branch-box else-branch-box)
      (let
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (or
          (tc-expr-result-uses-cleanup-owner? then-branch owners bound)
          (tc-expr-result-uses-cleanup-owner? else-branch owners bound)))]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (tc-expr-result-uses-cleanup-owner?
              body
              owners
              (tc-let-binding-list-add-bound-names bindings bound)))])]
    [(AstExprMatch match-box)
      (match (box-get match-box)
        [(AstMatch _ arms)
          (tc-match-arms-result-use-cleanup-owner? arms owners bound)])]
    [(AstExprForeach fe-box)
      (match (box-get fe-box)
        [(AstForeach index _ _ _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (tc-expr-result-uses-cleanup-owner?
              body
              owners
              (tc-string-list-add bound (intern-str index))))])]
    [(AstExprSpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce _ index _ _ _ _ value-box)
          (let
            [value : AstExpr (ast-node-get value-box)]
            (tc-expr-result-uses-cleanup-owner?
              value
              owners
              (tc-string-list-add bound (intern-str index))))])]
    [(AstExprSpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan _ index _ _ _ prefix _ _ value-box body-box)
          (let
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            [value-bound : TcStringList
              (tc-string-list-add bound (intern-str index))]
            [body-bound : TcStringList
              (tc-string-list-add value-bound (intern-str prefix))]
            (or
              (tc-expr-result-uses-cleanup-owner? value owners value-bound)
              (tc-expr-result-uses-cleanup-owner? body owners body-bound)))])]
    [(AstExprSpmdBroadcast value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-expr-result-uses-cleanup-owner? value owners bound))]
    [(AstExprSpmdShuffle value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-expr-result-uses-cleanup-owner? value owners bound))]
    [(AstExprBegin exprs)
      (tc-expr-list-result-uses-cleanup-owner? exprs owners bound)]
    [(AstExprUnsafe exprs)
      (tc-expr-list-result-uses-cleanup-owner? exprs owners bound)]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-result-uses-cleanup-owner? inner owners bound))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-result-uses-cleanup-owner? inner owners bound))]
    [(AstExprComptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-result-uses-cleanup-owner? inner owners bound))]
    [(AstExprTry inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-result-uses-cleanup-owner? inner owners bound))]
    [(AstExprReturn inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-result-uses-cleanup-owner? inner owners bound))]
    [(AstExprBoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-result-uses-cleanup-owner? inner owners bound))]
    [(AstExprBoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-result-uses-cleanup-owner? inner owners bound))]
    [(AstExprBoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (tc-expr-result-uses-cleanup-owner? inner owners bound)
          (tc-expr-result-uses-cleanup-owner? value owners bound)))]
    [(AstExprWithRegion _ body)
      (tc-expr-list-result-uses-cleanup-owner? body owners bound)]
    [(AstExprWithEscape _ body)
      (tc-expr-list-result-uses-cleanup-owner? body owners bound)]
    [(AstExprWithScratch body)
      (tc-expr-list-result-uses-cleanup-owner? body owners bound)]
    [(AstExprInArena _ body)
      (tc-expr-list-result-uses-cleanup-owner? body owners bound)]
    [(AstExprWithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource bindings body)
          (tc-expr-list-result-uses-cleanup-owner?
            body
            owners
            (tc-resource-binding-list-add-bound-names bindings bound))])]
    [_ false]))

(define (tc-expr-result-uses-active-cleanup-owner?
  [env : TcTypeEnv]
  [expr : AstExpr]) : bool
  (tc-expr-result-uses-cleanup-owner?
    expr
    (tc-active-cleanup-owners env)
    TcStringNil))

(define (tc-expr-list-any-result-uses-active-cleanup-owner?
  [env : TcTypeEnv]
  [exprs : AstExprList]) : bool
  (tc-expr-list-any-result-uses-cleanup-owner?
    exprs
    (tc-active-cleanup-owners env)
    TcStringNil))

(define (tc-ensure-cleanup-resource-not-let-bound
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [ty : AstType]) : ResultTcUnit
  (if (or
    (tc-expr-result-uses-active-cleanup-owner? env expr)
    (tc-cleanup-owning-aggregate-type? ctx ty))
    (ErrTcUnit
      "typecheck: ordinary let cannot own cleanup-required resource; use with")
    OkTcUnit))

(define (tc-ensure-cleanup-resource-not-transferred
  [env : TcTypeEnv]
  [expr : AstExpr]) : ResultTcUnit
  (if (tc-expr-result-uses-active-cleanup-owner? env expr)
    (ErrTcUnit
      "typecheck: cleanup-required resource already has a cleanup owner")
    OkTcUnit))

(define (tc-ensure-cleanup-resource-not-stored-expr
  [env : TcTypeEnv]
  [expr : AstExpr]) : ResultTcUnit
  (if (tc-expr-result-uses-active-cleanup-owner? env expr)
    (ErrTcUnit
      "typecheck: cannot store cleanup-required resource in ordinary aggregate")
    OkTcUnit))

(define (tc-ensure-cleanup-resource-not-stored-list
  [env : TcTypeEnv]
  [exprs : AstExprList]) : ResultTcUnit
  (if (tc-expr-list-any-result-uses-active-cleanup-owner? env exprs)
    (ErrTcUnit
      "typecheck: cannot store cleanup-required resource in ordinary aggregate")
    OkTcUnit))

(define (tc-ensure-cleanup-resource-not-assigned
  [env : TcTypeEnv]
  [expr : AstExpr]) : ResultTcUnit
  (if (tc-expr-result-uses-active-cleanup-owner? env expr)
    (ErrTcUnit
      "typecheck: cannot store cleanup-required resource in longer-lived binding")
    OkTcUnit))

(define (tc-check-lambda-region-captures-scan-root
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [body : AstExpr]
  [allow-immutable-reference-captures : bool]) : ResultTcUnit
  (match env
    [(TcTypeNil) OkTcUnit]
    [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-check-lambda-region-captures-scan-root
          root
          (box-get rest)
          bound
          body
          allow-immutable-reference-captures)
        OkTcUnit)]
    [(TcTypeBind key ty rest)
      (let
        [name : String (intern-str key)]
        (cond
          [(or
              (= key (tc-region-marker-id))
              (= key (tc-default-boundary-id))
              (tc-cleanup-owner-marker-entry? key ty)
              (tc-ordinary-arena-owner-marker-entry? key ty)
              (tc-atomic-arena-owner-marker-entry? key ty))
            (tc-check-lambda-region-captures-scan-root
              root
              (box-get rest)
              bound
              body
              allow-immutable-reference-captures)]
          [(not (tc-expr-uses-free-name? body name bound))
            (tc-check-lambda-region-captures-scan-root
              root
              (box-get rest)
              bound
              body
              allow-immutable-reference-captures)]
          [(tc-expr-sets-free-name? body name bound)
            (ErrTcUnit "typecheck: lambda cannot assign captured binding")]
          [(tc-cleanup-owner-active? root name)
            (ErrTcUnit
              "typecheck: lambda cannot capture cleanup-required resource; resource value would escape")]
          [(tc-type-contains-mut-reference? ty)
            (ErrTcUnit
              "typecheck: lambda cannot capture mutable reference; reference value would escape lexical scope")]
          [(tc-type-contains-reference? ty)
            (if allow-immutable-reference-captures
              (tc-check-lambda-region-captures-scan-root
                root
                (box-get rest)
                bound
                body
                allow-immutable-reference-captures)
              (ErrTcUnit
                "typecheck: lambda cannot capture immutable reference; reference value would escape lexical scope"))]
          [(tc-type-contains-any-region ty)
            (if (tc-type-regions-all-atomic-arena-owners? root ty)
              (tc-check-lambda-region-captures-scan-root
                root
                (box-get rest)
                bound
                body
                allow-immutable-reference-captures)
              (ErrTcUnit
                "typecheck: lambda cannot capture region-tagged value; region value would escape"))]
          [else
            (tc-check-lambda-region-captures-scan-root
              root
              (box-get rest)
              bound
              body
              allow-immutable-reference-captures)]))]))

(define (tc-check-lambda-region-captures-scan
  [env : TcTypeEnv]
  [bound : TcStringList]
  [body : AstExpr]
  [allow-immutable-reference-captures : bool]) : ResultTcUnit
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match env
      [(TcTypeCache _ _ _ _ _ _ _ rest _)
        (tc-check-lambda-region-captures-scan-root
          env
          (box-get rest)
          bound
          body
          allow-immutable-reference-captures)]
      [_
        (tc-check-lambda-region-captures-scan-root
          env
          env
          bound
          body
          allow-immutable-reference-captures)])))

(define (tc-check-lambda-region-captures
  [env : TcTypeEnv]
  [params : AstParamList]
  [body : AstExpr]) : ResultTcUnit
  (tc-check-lambda-region-captures-scan
    env
    (tc-param-bound-names params)
    body
    false))

(define (tc-check-lambda-region-captures-allow-refs
  [env : TcTypeEnv]
  [params : AstParamList]
  [body : AstExpr]) : ResultTcUnit
  (tc-check-lambda-region-captures-scan
    env
    (tc-param-bound-names params)
    body
    true))

(define (tc-context-program [ctx : TcContext]) : AstProgram
  (match ctx
    [(TcContext program _ _ _ _) program]))

(define (tc-context-symbols [ctx : TcContext]) : CompilerSymbols
  (match ctx
    [(TcContext _ symbols _ _ _) symbols]))

(define (tc-context-registries [ctx : TcContext]) : CompilerRegistries
  (match ctx
    [(TcContext _ _ registries _ _) registries]))

(define (tc-program-enum-variants-list
  [decls : AstDeclList]
  [enum-name : String]) : ResultAstVariantDefList
  (tc-program-enum-variants-list-in-module decls enum-name ""))

(define (tc-program-enum-variants-list-in-module
  [decls : AstDeclList]
  [enum-name : String]
  [module : String]) : ResultAstVariantDefList
  (match decls
    [(AstDeclNil)
      (ErrAstVariantDefList
        (string.string-append "typecheck: unknown enum " enum-name))]
    [(AstDeclCons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDeclModule next-module)
            (tc-program-enum-variants-list-in-module
              rest
              enum-name
              (intern-str next-module))]
          [(AstDeclDefEnum name _ variants)
            (if (or
              (string.string-eq (intern-str name) enum-name)
              (string.string-eq
                (compiler-symbol-module-key module (intern-str name))
                enum-name))
              (OkAstVariantDefList variants)
              (tc-program-enum-variants-list-in-module rest enum-name module))]
          [(AstDeclDefEnumLifetimes name _ _ variants)
            (if (or
              (string.string-eq (intern-str name) enum-name)
              (string.string-eq
                (compiler-symbol-module-key module (intern-str name))
                enum-name))
              (OkAstVariantDefList variants)
              (tc-program-enum-variants-list-in-module rest enum-name module))]
          [(AstDeclComptimeDecl _ template-box)
            (let
              [template : AstDecl (box-get template-box)]
              (match template
                [(AstDeclDefEnum name _ variants)
                  (if (or
                    (string.string-eq (intern-str name) enum-name)
                    (string.string-eq
                      (compiler-symbol-module-key module (intern-str name))
                      enum-name))
                    (OkAstVariantDefList variants)
                    (tc-program-enum-variants-list-in-module
                      rest
                      enum-name
                      module))]
                [(AstDeclDefEnumLifetimes name _ _ variants)
                  (if (or
                    (string.string-eq (intern-str name) enum-name)
                    (string.string-eq
                      (compiler-symbol-module-key module (intern-str name))
                      enum-name))
                    (OkAstVariantDefList variants)
                    (tc-program-enum-variants-list-in-module
                      rest
                      enum-name
                      module))]
                [_
                  (tc-program-enum-variants-list-in-module
                    rest
                    enum-name
                    module)]))]
          [_ (tc-program-enum-variants-list-in-module rest enum-name module)]))]))

(define (tc-program-enum-variants [program : AstProgram] [enum-name : String]) : ResultAstVariantDefList
  (match program
    [(AstProgram decls-box)
      (let
        [decls : AstDeclList (box-get decls-box)]
        (tc-program-enum-variants-list decls enum-name))]))

(define (tc-context-enum-variants [ctx : TcContext] [enum-name : String]) : ResultAstVariantDefList
  (match (compiler-symbols-lookup-type (tc-context-symbols ctx) enum-name)
    [(SomeI64 handle)
      (if (=
        (compiler-symbol-handle-kind handle)
        (compiler-symbol-kind-defenum))
        (match (compiler-symbols-decl-at-index
          (tc-context-symbols ctx)
          (compiler-symbol-handle-index handle))
          [(OkAstDecl decl)
            (match decl
              [(AstDeclDefEnum _ _ variants) (OkAstVariantDefList variants)]
              [(AstDeclDefEnumLifetimes _ _ _ variants)
                (OkAstVariantDefList variants)]
              [_
                (ErrAstVariantDefList
                  (string.string-append "typecheck: unknown enum " enum-name))])]
          [(ErrAstDecl message) (ErrAstVariantDefList message)])
        (ErrAstVariantDefList
          (string.string-append "typecheck: unknown enum " enum-name)))]
    [(NoneI64) (tc-program-enum-variants (tc-context-program ctx) enum-name)]))

(define (tc-layout-info-size [info : TcLayoutInfo]) : i64
  (match info
    [(TcLayoutInfo size _) size]))

(define (tc-layout-info-align [info : TcLayoutInfo]) : i64
  (match info
    [(TcLayoutInfo _ align) align]))

(define (tc-repr-c-layout-size [layout : TcReprCLayout]) : i64
  (match layout
    [(TcReprCLayout size _ _) size]))

(define (tc-repr-c-layout-align [layout : TcReprCLayout]) : i64
  (match layout
    [(TcReprCLayout _ align _) align]))

(define (tc-repr-c-layout-fields [layout : TcReprCLayout]) : TcReprCFieldLayoutList
  (match layout
    [(TcReprCLayout _ _ fields) fields]))

(define (tc-repr-c-field-layout-name [field : TcReprCFieldLayout]) : String
  (match field
    [(TcReprCFieldLayout name _ _) name]))

(define (tc-repr-c-field-layout-type [field : TcReprCFieldLayout]) : AstType
  (match field
    [(TcReprCFieldLayout _ ty _) ty]))

(define (tc-repr-c-field-layout-offset [field : TcReprCFieldLayout]) : i64
  (match field
    [(TcReprCFieldLayout _ _ offset) offset]))

(define (tc-repr-c-layout-field-offset
  [fields : TcReprCFieldLayoutList]
  [name : String]) : i64
  (match fields
    [(TcReprCFieldLayoutNil) -1]
    [(TcReprCFieldLayoutCons field rest)
      (begin
        (cfg compile-profile (tc-lp-note 1))
        (if (string.string-eq (tc-repr-c-field-layout-name field) name)
          (tc-repr-c-field-layout-offset field)
          (tc-repr-c-layout-field-offset (box-get rest) name)))]))

(define (tc-inline-field-layout-name [field : TcInlineFieldLayout]) : String
  (match field
    [(TcInlineFieldLayout name _ _) name]))

(define (tc-inline-field-layout-type [field : TcInlineFieldLayout]) : AstType
  (match field
    [(TcInlineFieldLayout _ ty _) ty]))

(define (tc-inline-field-layout-offset [field : TcInlineFieldLayout]) : i64
  (match field
    [(TcInlineFieldLayout _ _ offset) offset]))

(define (tc-inline-field-layout-list-offset
  [fields : TcInlineFieldLayoutList]
  [name : String]) : i64
  (match fields
    [(TcInlineFieldLayoutNil) -1]
    [(TcInlineFieldLayoutCons field rest)
      (begin
        (cfg compile-profile (tc-lp-note 3))
        (if (string.string-eq (tc-inline-field-layout-name field) name)
          (tc-inline-field-layout-offset field)
          (tc-inline-field-layout-list-offset (box-get rest) name)))]))

;; #2601/#2855: register-resident aggregate eightbytes may be INTEGER (the
;; existing word-class data) or SSE. SSE admits exact aligned f64 fields and
;; packed f32 fields that share an eightbyte only with other SSE fields. Mixed
;; integer/float sub-word eightbytes intentionally stay memory-backed.
(define (tc-sse-eightbyte-field? [ty : AstType] [offset : i64]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyF64) (= (% offset 8) 0)]
    [(AstTyF32) (= (% offset 4) 0)]
    [_ false]))

(define (tc-register-field-class [ty : AstType] [offset : i64]) : i64
  (if (tc-word-class-type? ty)
    0
    (if (tc-sse-eightbyte-field? ty offset)
      1
      2)))

(define (tc-register-field-size [ty : AstType]) : i64
  (match (tc-type-strip-region ty)
    [(AstTyI64) 8]
    [(AstTyU64) 8]
    [(AstTyF64) 8]
    [(AstTyI32) 4]
    [(AstTyU32) 4]
    [(AstTyF32) 4]
    [(AstTyI16) 2]
    [(AstTyU16) 2]
    [(AstTyI8) 1]
    [(AstTyU8) 1]
    [(AstTyBool) 1]
    [(AstTyChar) 1]
    [(AstTyPtr _) 8]
    [(AstTyMutPtr _) 8]
    [_ 8]))

;; #2386: true when every struct field is word-class, so the aggregate can be
;; packed into general-purpose register words instead of a memory slot.
(define (tc-inline-fields-all-word-class? [fields : TcInlineFieldLayoutList]) : bool
  (match fields
    [(TcInlineFieldLayoutNil) true]
    [(TcInlineFieldLayoutCons field rest)
      (if (tc-word-class-type? (tc-inline-field-layout-type field))
        (tc-inline-fields-all-word-class? (box-get rest))
        false)]))

;; #2601/#2855: true when every struct field can be assigned to a supported
;; register eightbyte class and every occupied eightbyte has a single class.
;; This preserves every existing INTEGER case, exact f64 SSE eightbytes, and
;; homogeneous packed f32 SSE eightbytes while rejecting mixed int/float words.
(define (tc-inline-field-overlaps-word?
  [field : TcInlineFieldLayout]
  [word-index : i64]) : bool
  (let
    [offset : i64 (tc-inline-field-layout-offset field)]
    [size : i64 (tc-register-field-size (tc-inline-field-layout-type field))]
    [word-base : i64 (* word-index 8)]
    (and (< offset (+ word-base 8)) (> (+ offset size) word-base))))

(define (tc-inline-fields-word-register-class
  [fields : TcInlineFieldLayoutList]
  [word-index : i64]
  [found : i64]) : i64
  (match fields
    [(TcInlineFieldLayoutNil) found]
    [(TcInlineFieldLayoutCons field rest)
      (if (tc-inline-field-overlaps-word? field word-index)
        (let
          [class : i64
            (tc-register-field-class
              (tc-inline-field-layout-type field)
              (tc-inline-field-layout-offset field))]
          (cond
            [(= class 2) 2]
            [(= found -1)
              (tc-inline-fields-word-register-class
                (box-get rest)
                word-index
                class)]
            [(= found class)
              (tc-inline-fields-word-register-class
                (box-get rest)
                word-index
                found)]
            [else 2]))
        (tc-inline-fields-word-register-class (box-get rest) word-index found))]))

(define (tc-inline-fields-all-register-class?
  [fields : TcInlineFieldLayoutList]) : bool
  (and
    (< (tc-inline-fields-word-register-class fields 0 -1) 2)
    (< (tc-inline-fields-word-register-class fields 1 -1) 2)))

;; #2386: true when every payload field of a variant is word-class -- so a 16-byte
;; enum (tag in word0, the single word-class payload in word1) can be carried
;; register-resident.
(define (tc-inline-payloads-all-word-class?
  [payloads : TcInlinePayloadLayoutList]) : bool
  (match payloads
    [(TcInlinePayloadLayoutNil) true]
    [(TcInlinePayloadLayoutCons payload rest)
      (match payload
        [(TcInlinePayloadLayout _ ty _)
          (if (tc-word-class-type? ty)
            (tc-inline-payloads-all-word-class? (box-get rest))
            false)])]))

(define (tc-register-payload-class [payload : TcInlinePayloadLayout]) : i64
  (match payload
    [(TcInlinePayloadLayout _ ty offset) (tc-register-field-class ty offset)]))

;; Return -1 for an empty payload list, 0 for INTEGER, 1 for SSE, and 2 when the
;; payload fields cannot share one supported register eightbyte class.
(define (tc-inline-payloads-register-class
  [payloads : TcInlinePayloadLayoutList]
  [found : i64]) : i64
  (match payloads
    [(TcInlinePayloadLayoutNil) found]
    [(TcInlinePayloadLayoutCons payload rest)
      (let
        [class : i64 (tc-register-payload-class payload)]
        (cond
          [(= class 2) 2]
          [(= found -1)
            (tc-inline-payloads-register-class (box-get rest) class)]
          [(= found class)
            (tc-inline-payloads-register-class (box-get rest) found)]
          [else 2]))]))

(define (tc-inline-enum-register-payload-class
  [variants : TcInlineVariantLayoutList]
  [found : i64]) : i64
  (match variants
    [(TcInlineVariantLayoutNil) found]
    [(TcInlineVariantLayoutCons variant rest)
      (match variant
        [(TcInlineVariantLayout _ _ _ payloads)
          (let
            [class : i64 (tc-inline-payloads-register-class payloads -1)]
            (cond
              [(= class 2) 2]
              [(= class -1)
                (tc-inline-enum-register-payload-class (box-get rest) found)]
              [(= found -1)
                (tc-inline-enum-register-payload-class (box-get rest) class)]
              [(= found class)
                (tc-inline-enum-register-payload-class (box-get rest) found)]
              [else 2]))])]))

(define (tc-inline-enum-payloads-all-register-class?
  [variants : TcInlineVariantLayoutList]) : bool
  (< (tc-inline-enum-register-payload-class variants -1) 2))

(define (tc-inline-enum-payloads-all-word-class?
  [variants : TcInlineVariantLayoutList]) : bool
  (match variants
    [(TcInlineVariantLayoutNil) true]
    [(TcInlineVariantLayoutCons variant rest)
      (match variant
        [(TcInlineVariantLayout _ _ _ payloads)
          (if (tc-inline-payloads-all-word-class? payloads)
            (tc-inline-enum-payloads-all-word-class? (box-get rest))
            false)])]))

(define (tc-inline-payload-layout-list-empty?
  [payloads : TcInlinePayloadLayoutList]) : bool
  (match payloads
    [(TcInlinePayloadLayoutNil) true]
    [(TcInlinePayloadLayoutCons _ _) false]))

(define (tc-inline-enum-variants-tag-only?
  [variants : TcInlineVariantLayoutList]) : bool
  (match variants
    [(TcInlineVariantLayoutNil) true]
    [(TcInlineVariantLayoutCons variant rest)
      (match variant
        [(TcInlineVariantLayout _ size _ payloads)
          (if (and (= size 8) (tc-inline-payload-layout-list-empty? payloads))
            (tc-inline-enum-variants-tag-only? (box-get rest))
            false)])]))

(define (tc-inline-enum-layout-tag-only?
  [size : i64]
  [variants : TcInlineVariantLayoutList]) : bool
  (and (= size 8) (tc-inline-enum-variants-tag-only? variants)))

(define (tc-inline-aggregate-layout-tag-only-enum?
  [layout : TcInlineAggregateLayout]) : bool
  (match layout
    [(TcInlineEnumLayout size _ variants)
      (tc-inline-enum-layout-tag-only? size variants)]
    [(TcInlineStructLayout _ _ _) false]))

(define (tc-inline-payload-layout-index [payload : TcInlinePayloadLayout]) : i64
  (match payload
    [(TcInlinePayloadLayout index _ _) index]))

(define (tc-inline-payload-layout-type [payload : TcInlinePayloadLayout]) : AstType
  (match payload
    [(TcInlinePayloadLayout _ ty _) ty]))

(define (tc-inline-payload-layout-offset [payload : TcInlinePayloadLayout]) : i64
  (match payload
    [(TcInlinePayloadLayout _ _ offset) offset]))

(define (tc-inline-payload-layout-list-offset
  [payloads : TcInlinePayloadLayoutList]
  [index : i64]) : i64
  (match payloads
    [(TcInlinePayloadLayoutNil) -1]
    [(TcInlinePayloadLayoutCons payload rest)
      (begin
        (cfg compile-profile (tc-lp-note 5))
        (if (= (tc-inline-payload-layout-index payload) index)
          (tc-inline-payload-layout-offset payload)
          (tc-inline-payload-layout-list-offset (box-get rest) index)))]))

(define (tc-inline-variant-layout-name [variant : TcInlineVariantLayout]) : String
  (match variant
    [(TcInlineVariantLayout name _ _ _) name]))

(define (tc-inline-variant-layout-size [variant : TcInlineVariantLayout]) : i64
  (match variant
    [(TcInlineVariantLayout _ size _ _) size]))

(define (tc-inline-variant-layout-align [variant : TcInlineVariantLayout]) : i64
  (match variant
    [(TcInlineVariantLayout _ _ align _) align]))

(define (tc-inline-variant-layout-payloads [variant : TcInlineVariantLayout]) : TcInlinePayloadLayoutList
  (match variant
    [(TcInlineVariantLayout _ _ _ payloads) payloads]))

(define (tc-inline-variant-layout-member-name [name : String]) : String
  (let
    [source : String
      (if (tc-name-qualified? name)
        (tc-qualified-name-base name)
        name)]
    [i : i64 0]
    [last-dot : i64 -1]
    [n : i64 (string.string-length source)]
    (begin
      (while (< i n)
        (begin
          (if (string.char-eq (string.string-ref source i) '.')
            (set! last-dot i)
            unit)
          (set! i (+ i 1))))
      (if (and (>= last-dot 0) (< last-dot (- n 1)))
        (string.substring source (+ last-dot 1) (- n (+ last-dot 1)))
        source))))

(define (tc-inline-variant-layout-name-matches?
  [stored : String]
  [name : String]) : bool
  (or
    (string.string-eq stored name)
    (string.string-eq
      (tc-inline-variant-layout-member-name stored)
      (tc-inline-variant-layout-member-name name))))

(define (tc-inline-variant-layout-list-size-exact
  [variants : TcInlineVariantLayoutList]
  [name : String]) : i64
  (match variants
    [(TcInlineVariantLayoutNil) -1]
    [(TcInlineVariantLayoutCons variant rest)
      (begin
        (cfg compile-profile (tc-lp-note 7))
        (if (string.string-eq (tc-inline-variant-layout-name variant) name)
          (tc-inline-variant-layout-size variant)
          (tc-inline-variant-layout-list-size-exact (box-get rest) name)))]))

(define (tc-inline-variant-layout-list-size-fallback
  [variants : TcInlineVariantLayoutList]
  [name : String]) : i64
  (match variants
    [(TcInlineVariantLayoutNil) -1]
    [(TcInlineVariantLayoutCons variant rest)
      (begin
        (cfg compile-profile (tc-lp-note 7))
        (if (tc-inline-variant-layout-name-matches?
          (tc-inline-variant-layout-name variant)
          name)
          (tc-inline-variant-layout-size variant)
          (tc-inline-variant-layout-list-size-fallback (box-get rest) name)))]))

(define (tc-inline-variant-layout-list-size
  [variants : TcInlineVariantLayoutList]
  [name : String]) : i64
  (let
    [exact : i64 (tc-inline-variant-layout-list-size-exact variants name)]
    (if (>= exact 0)
      exact
      (tc-inline-variant-layout-list-size-fallback variants name))))

(define (tc-inline-variant-layout-list-payload-offset-exact
  [variants : TcInlineVariantLayoutList]
  [name : String]
  [index : i64]) : i64
  (match variants
    [(TcInlineVariantLayoutNil) -1]
    [(TcInlineVariantLayoutCons variant rest)
      (begin
        (cfg compile-profile (tc-lp-note 7))
        (if (string.string-eq (tc-inline-variant-layout-name variant) name)
          (tc-inline-payload-layout-list-offset
            (tc-inline-variant-layout-payloads variant)
            index)
          (tc-inline-variant-layout-list-payload-offset-exact
            (box-get rest)
            name
            index)))]))

(define (tc-inline-variant-layout-list-payload-offset-fallback
  [variants : TcInlineVariantLayoutList]
  [name : String]
  [index : i64]) : i64
  (match variants
    [(TcInlineVariantLayoutNil) -1]
    [(TcInlineVariantLayoutCons variant rest)
      (begin
        (cfg compile-profile (tc-lp-note 7))
        (if (tc-inline-variant-layout-name-matches?
          (tc-inline-variant-layout-name variant)
          name)
          (tc-inline-payload-layout-list-offset
            (tc-inline-variant-layout-payloads variant)
            index)
          (tc-inline-variant-layout-list-payload-offset-fallback
            (box-get rest)
            name
            index)))]))

(define (tc-inline-variant-layout-list-payload-offset
  [variants : TcInlineVariantLayoutList]
  [name : String]
  [index : i64]) : i64
  (let
    [exact : i64
      (tc-inline-variant-layout-list-payload-offset-exact variants name index)]
    (if (>= exact 0)
      exact
      (tc-inline-variant-layout-list-payload-offset-fallback
        variants
        name
        index))))

(define (tc-inline-aggregate-layout-size [layout : TcInlineAggregateLayout]) : i64
  (match layout
    [(TcInlineStructLayout size _ _) size]
    [(TcInlineEnumLayout size _ _) size]))

(define (tc-inline-aggregate-layout-align [layout : TcInlineAggregateLayout]) : i64
  (match layout
    [(TcInlineStructLayout _ align _) align]
    [(TcInlineEnumLayout _ align _) align]))

(define (tc-inline-aggregate-layout-field-offset
  [layout : TcInlineAggregateLayout]
  [name : String]) : i64
  (match layout
    [(TcInlineStructLayout _ _ fields)
      (tc-inline-field-layout-list-offset fields name)]
    [(TcInlineEnumLayout _ _ _) -1]))

(define (tc-inline-aggregate-layout-variant-size
  [layout : TcInlineAggregateLayout]
  [name : String]) : i64
  (match layout
    [(TcInlineStructLayout _ _ _) -1]
    [(TcInlineEnumLayout _ _ variants)
      (tc-inline-variant-layout-list-size variants name)]))

(define (tc-inline-aggregate-layout-variant-payload-offset
  [layout : TcInlineAggregateLayout]
  [name : String]
  [index : i64]) : i64
  (match layout
    [(TcInlineStructLayout _ _ _) -1]
    [(TcInlineEnumLayout _ _ variants)
      (tc-inline-variant-layout-list-payload-offset variants name index)]))

(define (tc-align-up [n : i64] [align : i64]) : i64
  (if (<= align 1)
    n
    (* (/ (+ n (- align 1)) align) align)))

(define (tc-max-i64 [a : i64] [b : i64]) : i64
  (if (> a b)
    a
    b))

(define (tc-struct-decl [ctx : TcContext] [struct-name : String]) : ResultTcStructDecl
  (match ctx
    [(TcContext _ symbols _ _ _)
      (match (compiler-symbols-lookup-type symbols struct-name)
        [(SomeI64 handle)
          (if (=
            (compiler-symbol-handle-kind handle)
            (compiler-symbol-kind-defstruct))
            (match (compiler-symbols-decl-at-index
              symbols
              (compiler-symbol-handle-index handle))
              [(OkAstDecl decl)
                (match decl
                  [(AstDeclDefStruct _ repr cleanup fields)
                    (OkTcStructDecl (TcStructDecl repr cleanup fields))]
                  [(AstDeclDefStructLifetimes _ _ repr cleanup fields)
                    (OkTcStructDecl (TcStructDecl repr cleanup fields))]
                  [_
                    (ErrTcStructDecl
                      "typecheck: struct symbol owner is not a struct")])]
              [(ErrAstDecl message) (ErrTcStructDecl message)])
            (ErrTcStructDecl
              (string.string-append "typecheck: unknown struct " struct-name)))]
        [(NoneI64)
          (ErrTcStructDecl
            (string.string-append "typecheck: unknown struct " struct-name))])]))

(define (tc-enum-decl [ctx : TcContext] [enum-name : String]) : ResultTcEnumDecl
  (match ctx
    [(TcContext _ symbols _ _ _)
      (match (compiler-symbols-lookup-type symbols enum-name)
        [(SomeI64 handle)
          (if (=
            (compiler-symbol-handle-kind handle)
            (compiler-symbol-kind-defenum))
            (match (compiler-symbols-decl-at-index
              symbols
              (compiler-symbol-handle-index handle))
              [(OkAstDecl decl)
                (match decl
                  [(AstDeclDefEnum _ cleanup variants)
                    (OkTcEnumDecl (TcEnumDecl cleanup variants))]
                  [(AstDeclDefEnumLifetimes _ _ cleanup variants)
                    (OkTcEnumDecl (TcEnumDecl cleanup variants))]
                  [_
                    (ErrTcEnumDecl
                      "typecheck: enum symbol owner is not an enum")])]
              [(ErrAstDecl message) (ErrTcEnumDecl message)])
            (ErrTcEnumDecl
              (string.string-append "typecheck: unknown enum " enum-name)))]
        [(NoneI64)
          (ErrTcEnumDecl
            (string.string-append "typecheck: unknown enum " enum-name))])]))

(define (tc-inline-aggregate-cycle-stack-render [stack : TcStringList]) : String
  (match stack
    [(TcStringNil) ""]
    [(TcStringCons head rest)
      (let
        [tail : String (tc-inline-aggregate-cycle-stack-render (box-get rest))]
        (if (string.string-eq tail "")
          head
          (str_cat.str-cat tail " -> " head)))]))

(define (tc-inline-aggregate-cycle-path [stack : TcStringList] [name : String]) : String
  (let
    [prefix : String (tc-inline-aggregate-cycle-stack-render stack)]
    (if (string.string-eq prefix "")
      name
      (str_cat.str-cat prefix " -> " name))))

(define (tc-inline-aggregate-cycle-message
  [name : String]
  [stack : TcStringList]) : String
  (str_cat.str-cat
    "typecheck: inline aggregate layout cycle "
    (tc-inline-aggregate-cycle-path stack name)
    "; insert (Box "
    name
    ") at the recursive edge"))

(define (tc-inline-aggregate-type-list-finite-ok
  [ctx : TcContext]
  [types : AstTypeList]
  [stack : TcStringList]) : ResultTcUnit
  (match types
    [(AstTypeNil) OkTcUnit]
    [(AstTypeCons head rest)
      (let
        [head : AstType (tc-context-type-get ctx head)]
        [rest : AstTypeList (box-get rest)]
        (match (tc-inline-aggregate-type-finite-ok ctx head stack)
          [(OkTcUnit) (tc-inline-aggregate-type-list-finite-ok ctx rest stack)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]))

(define (tc-inline-aggregate-fields-finite-ok
  [ctx : TcContext]
  [fields : AstFieldDefList]
  [stack : TcStringList]) : ResultTcUnit
  (match fields
    [(AstFieldDefNil) OkTcUnit]
    [(AstFieldDefCons field rest)
      (let
        [rest : AstFieldDefList (box-get rest)]
        (match field
          [(AstFieldDef _ ty _)
            (match (tc-inline-aggregate-type-finite-ok ctx ty stack)
              [(OkTcUnit) (tc-inline-aggregate-fields-finite-ok ctx rest stack)]
              [(ErrTcUnit message) (ErrTcUnit message)])]))]))

(define (tc-inline-aggregate-variants-finite-ok
  [ctx : TcContext]
  [variants : AstVariantDefList]
  [stack : TcStringList]) : ResultTcUnit
  (match variants
    [(AstVariantDefNil) OkTcUnit]
    [(AstVariantDefCons variant rest)
      (let
        [rest : AstVariantDefList (box-get rest)]
        (match variant
          [(AstVariantDef _ fields _)
            (match (tc-inline-aggregate-type-list-finite-ok ctx fields stack)
              [(OkTcUnit)
                (tc-inline-aggregate-variants-finite-ok ctx rest stack)]
              [(ErrTcUnit message) (ErrTcUnit message)])]))]))

(define (tc-inline-aggregate-nominal-finite-ok
  [ctx : TcContext]
  [name : String]
  [stack : TcStringList]) : ResultTcUnit
  (if (tc-string-list-contains stack name)
    (ErrTcUnit (tc-inline-aggregate-cycle-message name stack))
    (match (compiler-symbols-lookup-type (tc-context-symbols ctx) name)
      [(SomeI64 handle)
        (if (=
          (compiler-symbol-handle-kind handle)
          (compiler-symbol-kind-defenum))
          (match (tc-context-enum-variants ctx name)
            [(OkAstVariantDefList variants)
              (tc-inline-aggregate-variants-finite-ok
                ctx
                variants
                (TcStringCons name (box stack)))]
            [(ErrAstVariantDefList message) (ErrTcUnit message)])
          (if (=
            (compiler-symbol-handle-kind handle)
            (compiler-symbol-kind-defstruct))
            (match (tc-struct-decl ctx name)
              [(OkTcStructDecl decl)
                (match decl
                  [(TcStructDecl _ _ fields)
                    (tc-inline-aggregate-fields-finite-ok
                      ctx
                      fields
                      (TcStringCons name (box stack)))])]
              [(ErrTcStructDecl message) (ErrTcUnit message)])
            (ErrTcUnit
              (string.string-append "typecheck: unknown aggregate " name))))]
      [(NoneI64)
        (ErrTcUnit (string.string-append "typecheck: unknown aggregate " name))])))

(define (tc-inline-aggregate-type-finite-ok
  [ctx : TcContext]
  [ty : AstType]
  [stack : TcStringList]) : ResultTcUnit
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstTyTuple elems)
      (tc-inline-aggregate-type-list-finite-ok ctx (box-get elems) stack)]
    [(AstTyArray elem _)
      (tc-inline-aggregate-type-finite-ok
        ctx
        (tc-context-type-get ctx elem)
        stack)]
    [(AstTyEnum name)
      (tc-inline-aggregate-nominal-finite-ok ctx (intern-str name) stack)]
    [(AstTyEnumArgs name _)
      (tc-inline-aggregate-nominal-finite-ok ctx (intern-str name) stack)]
    [(AstTyStruct name)
      (tc-inline-aggregate-nominal-finite-ok ctx (intern-str name) stack)]
    [(AstTyStructArgs name _)
      (tc-inline-aggregate-nominal-finite-ok ctx (intern-str name) stack)]
    [_ OkTcUnit]))

(define (tc-inline-aggregate-layout-finite-ok [ctx : TcContext] [name : String]) : ResultTcUnit
  (tc-inline-aggregate-nominal-finite-ok ctx name TcStringNil))

(define (tc-inline-aggregate-layout-info [size : i64] [align : i64]) : TcLayoutInfo
  (TcLayoutInfo size align))

(define (tc-inline-aggregate-pointer-layout-info) : TcLayoutInfo
  (tc-inline-aggregate-layout-info 8 8))

(define (tc-inline-aggregate-zero-layout-info) : TcLayoutInfo
  (tc-inline-aggregate-layout-info 0 1))

(define (tc-inline-aggregate-finish-layout [cursor : i64] [max-align : i64]) : TcLayoutInfo
  (let
    [align : i64
      (if (= max-align 0)
        1
        max-align)]
    (tc-inline-aggregate-layout-info (tc-align-up cursor align) align)))

(define (tc-inline-aggregate-array-size
  [elem-size : i64]
  [elem-align : i64]
  [count : i64]) : i64
  (if (<= count 0)
    0
    (* (tc-align-up elem-size elem-align) count)))

(define (tc-inline-aggregate-type-list-layout-info
  [ctx : TcContext]
  [types : AstTypeList]
  [cursor : i64]
  [max-align : i64]
  [stack : TcStringList]) : ResultTcLayoutInfo
  (match types
    [(AstTypeNil)
      (OkTcLayoutInfo (tc-inline-aggregate-finish-layout cursor max-align))]
    [(AstTypeCons ty rest)
      (let
        [ty : AstType (tc-context-type-get ctx ty)]
        [rest : AstTypeList (box-get rest)]
        (match (tc-inline-aggregate-type-layout-with-stack ctx ty stack)
          [(OkTcLayoutInfo info)
            (let
              [field-align : i64 (tc-layout-info-align info)]
              [field-size : i64 (tc-layout-info-size info)]
              [offset : i64 (tc-align-up cursor field-align)]
              [next-cursor : i64 (+ offset field-size)]
              [next-align : i64 (tc-max-i64 max-align field-align)]
              (tc-inline-aggregate-type-list-layout-info
                ctx
                rest
                next-cursor
                next-align
                stack))]
          [(ErrTcLayoutInfo message) (ErrTcLayoutInfo message)]))]))

(define (tc-inline-aggregate-field-defs-layout
  [ctx : TcContext]
  [fields : AstFieldDefList]
  [cursor : i64]
  [max-align : i64]
  [stack : TcStringList]) : ResultTcInlineFieldsLayout
  (match fields
    [(AstFieldDefNil)
      (match (tc-inline-aggregate-finish-layout cursor max-align)
        [(TcLayoutInfo size align)
          (OkTcInlineFieldsLayout
            (TcInlineFieldsLayout size align TcInlineFieldLayoutNil))])]
    [(AstFieldDefCons field rest)
      (let
        [rest : AstFieldDefList (box-get rest)]
        (match field
          [(AstFieldDef name ty _)
            (let
              [resolved : AstType (tc-resolve-type ctx ty)]
              (match (tc-inline-aggregate-type-layout-with-stack
                ctx
                resolved
                stack)
                [(OkTcLayoutInfo info)
                  (let
                    [field-align : i64 (tc-layout-info-align info)]
                    [field-size : i64 (tc-layout-info-size info)]
                    [offset : i64 (tc-align-up cursor field-align)]
                    [next-cursor : i64 (+ offset field-size)]
                    [next-align : i64 (tc-max-i64 max-align field-align)]
                    (match (tc-inline-aggregate-field-defs-layout
                      ctx
                      rest
                      next-cursor
                      next-align
                      stack)
                      [(OkTcInlineFieldsLayout rest-layout)
                        (match rest-layout
                          [(TcInlineFieldsLayout size align rest-fields)
                            (begin
                              (cfg compile-profile (tc-lp-note 2))
                              (OkTcInlineFieldsLayout
                                (TcInlineFieldsLayout
                                  size
                                  align
                                  (TcInlineFieldLayoutCons
                                    (TcInlineFieldLayout
                                      (intern-str name)
                                      resolved
                                      offset)
                                    (box rest-fields)))))])]
                      [(ErrTcInlineFieldsLayout message)
                        (ErrTcInlineFieldsLayout message)]))]
                [(ErrTcLayoutInfo message) (ErrTcInlineFieldsLayout message)]))]))]))

(define (tc-inline-aggregate-payloads-layout
  [ctx : TcContext]
  [types : AstTypeList]
  [index : i64]
  [cursor : i64]
  [max-align : i64]
  [stack : TcStringList]) : ResultTcInlinePayloadFieldsLayout
  (match types
    [(AstTypeNil)
      (match (tc-inline-aggregate-finish-layout cursor max-align)
        [(TcLayoutInfo size align)
          (OkTcInlinePayloadFieldsLayout
            (TcInlinePayloadFieldsLayout size align TcInlinePayloadLayoutNil))])]
    [(AstTypeCons ty rest)
      (let
        [ty : AstType (tc-context-type-get ctx ty)]
        [rest : AstTypeList (box-get rest)]
        (match (tc-inline-aggregate-type-layout-with-stack ctx ty stack)
          [(OkTcLayoutInfo info)
            (let
              [field-align : i64 (tc-layout-info-align info)]
              [field-size : i64 (tc-layout-info-size info)]
              [offset : i64 (tc-align-up cursor field-align)]
              [next-cursor : i64 (+ offset field-size)]
              [next-align : i64 (tc-max-i64 max-align field-align)]
              (match (tc-inline-aggregate-payloads-layout
                ctx
                rest
                (+ index 1)
                next-cursor
                next-align
                stack)
                [(OkTcInlinePayloadFieldsLayout rest-layout)
                  (match rest-layout
                    [(TcInlinePayloadFieldsLayout size align rest-payloads)
                      (begin
                        (cfg compile-profile (tc-lp-note 4))
                        (OkTcInlinePayloadFieldsLayout
                          (TcInlinePayloadFieldsLayout
                            size
                            align
                            (TcInlinePayloadLayoutCons
                              (TcInlinePayloadLayout index ty offset)
                              (box rest-payloads)))))])]
                [(ErrTcInlinePayloadFieldsLayout message)
                  (ErrTcInlinePayloadFieldsLayout message)]))]
          [(ErrTcLayoutInfo message) (ErrTcInlinePayloadFieldsLayout message)]))]))

(define (tc-inline-aggregate-struct-layout-with-stack
  [ctx : TcContext]
  [struct-name : String]
  [stack : TcStringList]) : ResultTcInlineAggregateLayout
  (if (tc-string-list-contains stack struct-name)
    (ErrTcInlineAggregateLayout
      (tc-inline-aggregate-cycle-message struct-name stack))
    (match (tc-struct-decl ctx struct-name)
      [(OkTcStructDecl decl)
        (match decl
          [(TcStructDecl _ _ fields)
            (match (tc-inline-aggregate-field-defs-layout
              ctx
              fields
              0
              0
              (TcStringCons struct-name (box stack)))
              [(OkTcInlineFieldsLayout layout)
                (match layout
                  [(TcInlineFieldsLayout size align fields-layout)
                    (OkTcInlineAggregateLayout
                      (TcInlineStructLayout size align fields-layout))])]
              [(ErrTcInlineFieldsLayout message)
                (ErrTcInlineAggregateLayout message)])])]
      [(ErrTcStructDecl message) (ErrTcInlineAggregateLayout message)])))

(define (tc-inline-aggregate-variants-layout
  [ctx : TcContext]
  [variants : AstVariantDefList]
  [max-size : i64]
  [max-align : i64]
  [stack : TcStringList]) : ResultTcInlineAggregateLayout
  (match variants
    [(AstVariantDefNil)
      (OkTcInlineAggregateLayout
        (TcInlineEnumLayout
          (tc-align-up max-size max-align)
          max-align
          TcInlineVariantLayoutNil))]
    [(AstVariantDefCons variant rest)
      (let
        [rest : AstVariantDefList (box-get rest)]
        (match variant
          [(AstVariantDef variant-name fields _)
            (match (tc-inline-aggregate-payloads-layout ctx fields 0 8 8 stack)
              [(OkTcInlinePayloadFieldsLayout payload-layout)
                (match payload-layout
                  [(TcInlinePayloadFieldsLayout
                      variant-size
                      variant-align
                      payloads)
                    (let
                      [next-size : i64 (tc-max-i64 max-size variant-size)]
                      [next-align : i64 (tc-max-i64 max-align variant-align)]
                      (match (tc-inline-aggregate-variants-layout
                        ctx
                        rest
                        next-size
                        next-align
                        stack)
                        [(OkTcInlineAggregateLayout rest-layout)
                          (match rest-layout
                            [(TcInlineEnumLayout
                                enum-size
                                enum-align
                                rest-variants)
                              (begin
                                (cfg compile-profile (tc-lp-note 6))
                                (OkTcInlineAggregateLayout
                                  (TcInlineEnumLayout
                                    enum-size
                                    enum-align
                                    (TcInlineVariantLayoutCons
                                      (TcInlineVariantLayout
                                        (intern-str variant-name)
                                        variant-size
                                        variant-align
                                        payloads)
                                      (box rest-variants)))))]
                            [(TcInlineStructLayout _ _ _)
                              (ErrTcInlineAggregateLayout
                                "typecheck: internal inline enum layout mismatch")])]
                        [(ErrTcInlineAggregateLayout message)
                          (ErrTcInlineAggregateLayout message)]))])]
              [(ErrTcInlinePayloadFieldsLayout message)
                (ErrTcInlineAggregateLayout message)])]))]))

(define (tc-inline-aggregate-enum-layout-with-stack
  [ctx : TcContext]
  [enum-name : String]
  [stack : TcStringList]) : ResultTcInlineAggregateLayout
  (if (tc-string-list-contains stack enum-name)
    (ErrTcInlineAggregateLayout
      (tc-inline-aggregate-cycle-message enum-name stack))
    (match (tc-context-enum-variants ctx enum-name)
      [(OkAstVariantDefList variants)
        (tc-inline-aggregate-variants-layout
          ctx
          variants
          8
          8
          (TcStringCons enum-name (box stack)))]
      [(ErrAstVariantDefList message) (ErrTcInlineAggregateLayout message)])))

;; --- full inline-aggregate layout memo ---------------------------------------
;; The Superluminal profile of the stage2 self-compile shows ~18% of CPU inside
;; the tc-inline-aggregate-* layout walk: every struct-get field offset, enum
;; payload offset, and lower-type-size query on a nominal recomputes the whole
;; recursive layout (the #2386 caches only memoized the final size and the
;; register-word count as scalars). This cache memoizes the COMPLETE
;; TcInlineAggregateLayout per type name. Unlike the scalar handle-index caches,
;; this cache is keyed by the intern id of the nominal name: symbol handles can
;; be reassigned when specialization rebuilds the symbol table, while intern ids
;; are stable until intern-reset!. The cached value is deep-cloned into the
;; persistent program arena (node-pool-base-arena) before storing -- a layout
;; computed while a transient lowering scratch arena is active would otherwise
;; dangle after the arena rewinds (the #2441 hazard).
(defenum TcAggLayoutCacheSlot
  (TcAggLayoutCacheEmpty)
  (TcAggLayoutCacheFull TcInlineAggregateLayout))

(define tc-agg-layout-cache-capacity : i64
  65536)
(define tc-agg-layout-cache : (Array TcAggLayoutCacheSlot)
  (array.make-array TcAggLayoutCacheSlot 65536))
(define tc-agg-layout-cache-generation : i64
  -1)

;; `make-array` does not produce valid Empty enum slots, so the fill is
;; mandatory before the first probe; generation -1 forces it on first use.
(define (tc-agg-layout-cache-ensure!) : unit
  (if (= tc-agg-layout-cache-generation (intern-generation))
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i tc-agg-layout-cache-capacity)
          (begin
            (array.array-set! tc-agg-layout-cache i (TcAggLayoutCacheEmpty))
            (set! i (+ i 1))))
        (set! tc-agg-layout-cache-generation (intern-generation))))))

;; Cache key: the INTERN ID of the nominal type name. Unlike the symbol-handle
;; index used by the scalar #2386 caches, intern ids are stable for the whole
;; program: the intern table only appends, while the symbol table is rebuilt
;; after specialization inserts generated declarations, which shifts handle
;; indexes mid-compile (observed as a wrong cached layout under
;; --cfg compile-profile). Type names are unique program-wide in the flat
;; namespace, so the name id identifies exactly one layout per generation.
(define (tc-agg-layout-cache-slot-key [name : String]) : i64
  (let
    [id : i64 (intern name)]
    (if (>= id tc-agg-layout-cache-capacity)
      (- 0 1)
      id)))

;; Deep-clone the completed layout into the persistent program arena and store
;; it. Only fully-resolved Ok layouts reach this point, so a cached entry can
;; never participate in a cycle (its computation already terminated).
(define (tc-agg-layout-cache-store!
  [key : i64]
  [layout : TcInlineAggregateLayout]) : unit
  (let
    [prev : i64 (arena.tl_arena_current)]
    (begin
      (unsafe
        (arena.tl_arena_set node-pool-base-arena))
      (let
        [persistent : TcInlineAggregateLayout (clone layout)]
        (begin
          (unsafe
            (arena.tl_arena_set prev))
          (array.array-set!
            tc-agg-layout-cache
            key
            (TcAggLayoutCacheFull persistent)))))))

(define (tc-inline-aggregate-layout-kind-dispatch
  [ctx : TcContext]
  [name : String]
  [handle : i64]
  [stack : TcStringList]) : ResultTcInlineAggregateLayout
  (let
    [layout-ctx : TcContext
      (tc-context-with-nominal-owner-index-module
        ctx
        (compiler-symbol-handle-index handle))]
    (if (= (compiler-symbol-handle-kind handle) (compiler-symbol-kind-defenum))
      (tc-inline-aggregate-enum-layout-with-stack layout-ctx name stack)
      (if (=
        (compiler-symbol-handle-kind handle)
        (compiler-symbol-kind-defstruct))
        (tc-inline-aggregate-struct-layout-with-stack layout-ctx name stack)
        (ErrTcInlineAggregateLayout
          (string.string-append "typecheck: unknown aggregate " name))))))

(define (tc-inline-aggregate-layout-fill-cache
  [ctx : TcContext]
  [name : String]
  [handle : i64]
  [stack : TcStringList]
  [key : i64]) : ResultTcInlineAggregateLayout
  (match (tc-inline-aggregate-layout-kind-dispatch ctx name handle stack)
    [(OkTcInlineAggregateLayout layout)
      (begin
        (tc-agg-layout-cache-store! key layout)
        (match (array.array-ref tc-agg-layout-cache key)
          [(TcAggLayoutCacheFull cached) (OkTcInlineAggregateLayout cached)]
          [(TcAggLayoutCacheEmpty)
            ;; Unreachable: the slot was just stored. Recompute defensively.
            (tc-inline-aggregate-layout-kind-dispatch ctx name handle stack)]))]
    [(ErrTcInlineAggregateLayout message) (ErrTcInlineAggregateLayout message)]))

(define (tc-inline-aggregate-layout-for-with-stack
  [ctx : TcContext]
  [name : String]
  [stack : TcStringList]) : ResultTcInlineAggregateLayout
  (match (compiler-symbols-lookup-type (tc-context-symbols ctx) name)
    [(SomeI64 handle)
      (begin
        (tc-agg-layout-cache-ensure!)
        (let
          [key : i64 (tc-agg-layout-cache-slot-key name)]
          (if (< key 0)
            (begin
              (cfg compile-profile (tc-lp-note 14))
              (tc-inline-aggregate-layout-kind-dispatch ctx name handle stack))
            (match (array.array-ref tc-agg-layout-cache key)
              [(TcAggLayoutCacheFull layout)
                (begin
                  (cfg compile-profile (tc-lp-note 12))
                  (OkTcInlineAggregateLayout layout))]
              [(TcAggLayoutCacheEmpty)
                (begin
                  (cfg compile-profile (tc-lp-note 13))
                  (tc-inline-aggregate-layout-fill-cache
                    ctx
                    name
                    handle
                    stack
                    key))]))))]
    [(NoneI64)
      (ErrTcInlineAggregateLayout
        (string.string-append "typecheck: unknown aggregate " name))]))

(define (tc-inline-aggregate-type-layout-with-stack
  [ctx : TcContext]
  [ty : AstType]
  [stack : TcStringList]) : ResultTcLayoutInfo
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstTyI64) (OkTcLayoutInfo (tc-inline-aggregate-layout-info 8 8))]
    [(AstTyU64) (OkTcLayoutInfo (tc-inline-aggregate-layout-info 8 8))]
    [(AstTyF64) (OkTcLayoutInfo (tc-inline-aggregate-layout-info 8 8))]
    [(AstTyI32) (OkTcLayoutInfo (tc-inline-aggregate-layout-info 4 4))]
    [(AstTyU32) (OkTcLayoutInfo (tc-inline-aggregate-layout-info 4 4))]
    [(AstTyF32) (OkTcLayoutInfo (tc-inline-aggregate-layout-info 4 4))]
    [(AstTyI16) (OkTcLayoutInfo (tc-inline-aggregate-layout-info 2 2))]
    [(AstTyU16) (OkTcLayoutInfo (tc-inline-aggregate-layout-info 2 2))]
    [(AstTyI8) (OkTcLayoutInfo (tc-inline-aggregate-layout-info 1 1))]
    [(AstTyU8) (OkTcLayoutInfo (tc-inline-aggregate-layout-info 1 1))]
    [(AstTyBool) (OkTcLayoutInfo (tc-inline-aggregate-layout-info 1 1))]
    [(AstTyChar) (OkTcLayoutInfo (tc-inline-aggregate-layout-info 1 1))]
    [(AstTyUnit) (OkTcLayoutInfo (tc-inline-aggregate-zero-layout-info))]
    [(AstTyNever) (OkTcLayoutInfo (tc-inline-aggregate-zero-layout-info))]
    [(AstTyExpr) (OkTcLayoutInfo (tc-inline-aggregate-zero-layout-info))]
    [(AstTyExprList) (OkTcLayoutInfo (tc-inline-aggregate-zero-layout-info))]
    [(AstTyFunc _ _) (OkTcLayoutInfo (tc-inline-aggregate-pointer-layout-info))]
    [(AstTyDynArray _)
      (OkTcLayoutInfo (tc-inline-aggregate-pointer-layout-info))]
    [(AstTyBox _) (OkTcLayoutInfo (tc-inline-aggregate-pointer-layout-info))]
    [(AstTyPtr _) (OkTcLayoutInfo (tc-inline-aggregate-pointer-layout-info))]
    [(AstTyMutPtr _) (OkTcLayoutInfo (tc-inline-aggregate-pointer-layout-info))]
    [(AstTyRef _ _) (OkTcLayoutInfo (tc-inline-aggregate-pointer-layout-info))]
    [(AstTyMutRef _ _)
      (OkTcLayoutInfo (tc-inline-aggregate-pointer-layout-info))]
    [(AstTyRegion _ inner)
      (tc-inline-aggregate-type-layout-with-stack
        ctx
        (tc-context-type-get ctx inner)
        stack)]
    [(AstTyString) (OkTcLayoutInfo (tc-inline-aggregate-pointer-layout-info))]
    [(AstTyStr) (OkTcLayoutInfo (tc-inline-aggregate-pointer-layout-info))]
    [(AstTyBytes)
      (ErrTcLayoutInfo
        "typecheck: bytes has no by-value layout; use (& lifetime bytes) or (&mut lifetime bytes)")]
    [(AstTyVar _) (OkTcLayoutInfo (tc-inline-aggregate-pointer-layout-info))]
    [(AstTyVarArgs _ _)
      (OkTcLayoutInfo (tc-inline-aggregate-pointer-layout-info))]
    [(AstTyTuple elems)
      (tc-inline-aggregate-type-list-layout-info ctx (box-get elems) 0 0 stack)]
    [(AstTyArray elem count)
      (match (tc-inline-aggregate-type-layout-with-stack
        ctx
        (tc-context-type-get ctx elem)
        stack)
        [(OkTcLayoutInfo elem-info)
          (OkTcLayoutInfo
            (TcLayoutInfo
              (tc-inline-aggregate-array-size
                (tc-layout-info-size elem-info)
                (tc-layout-info-align elem-info)
                count)
              (tc-layout-info-align elem-info)))]
        [(ErrTcLayoutInfo message) (ErrTcLayoutInfo message)])]
    [(AstTyStruct name)
      (match (tc-inline-aggregate-layout-for-with-stack
        ctx
        (intern-str name)
        stack)
        [(OkTcInlineAggregateLayout layout)
          (OkTcLayoutInfo
            (TcLayoutInfo
              (tc-inline-aggregate-layout-size layout)
              (tc-inline-aggregate-layout-align layout)))]
        [(ErrTcInlineAggregateLayout message) (ErrTcLayoutInfo message)])]
    [(AstTyStructArgs name _)
      (match (tc-inline-aggregate-layout-for-with-stack
        ctx
        (intern-str name)
        stack)
        [(OkTcInlineAggregateLayout layout)
          (OkTcLayoutInfo
            (TcLayoutInfo
              (tc-inline-aggregate-layout-size layout)
              (tc-inline-aggregate-layout-align layout)))]
        [(ErrTcInlineAggregateLayout message) (ErrTcLayoutInfo message)])]
    [(AstTyEnum name)
      (match (tc-inline-aggregate-layout-for-with-stack
        ctx
        (intern-str name)
        stack)
        [(OkTcInlineAggregateLayout layout)
          (OkTcLayoutInfo
            (TcLayoutInfo
              (tc-inline-aggregate-layout-size layout)
              (tc-inline-aggregate-layout-align layout)))]
        [(ErrTcInlineAggregateLayout message) (ErrTcLayoutInfo message)])]
    [(AstTyEnumArgs name _)
      (match (tc-inline-aggregate-layout-for-with-stack
        ctx
        (intern-str name)
        stack)
        [(OkTcInlineAggregateLayout layout)
          (OkTcLayoutInfo
            (TcLayoutInfo
              (tc-inline-aggregate-layout-size layout)
              (tc-inline-aggregate-layout-align layout)))]
        [(ErrTcInlineAggregateLayout message) (ErrTcLayoutInfo message)])]))

(define (tc-inline-aggregate-type-layout [ctx : TcContext] [ty : AstType]) : ResultTcLayoutInfo
  (tc-inline-aggregate-type-layout-with-stack ctx ty TcStringNil))

(define (tc-inline-aggregate-layout-for [ctx : TcContext] [name : String]) : ResultTcInlineAggregateLayout
  (tc-inline-aggregate-layout-for-with-stack ctx name TcStringNil))

;; #2386 (compile-time): memoize the inline-aggregate SIZE. tc-inline-aggregate-
;; layout-for re-walks the whole layout on every lower-type-size query, which is
;; ~70% of the -O1 lower phase. The cache must do NO allocation during lowering
;; (the #2441 scratch-arena hazard makes a grown map / cached field-list dangle):
;; so it is a FIXED global i64 array, allocated once at startup (persistent, like
;; the AST node pool) and only read/written thereafter. Keyed by the intern id of
;; the nominal type name: symbol handles can be reassigned when specialization
;; rebuilds the symbol table, while intern ids are append-only until intern-reset!.
;; A size is encoded as size+1 (0 = uncached); only fully-resolved layouts are
;; cached (Err forward-refs stay uncached until their nested types resolve).
;; Entries are valid only for the current program; tc-agg-caches-reset! forces
;; the next query to clear them at lower boundaries.
(define tc-agg-scalar-cache-capacity : i64
  400000)
(define tc-agg-size-cache : (Array i64)
  (array.make-array i64 400000))

;; #2624: these scalar caches used to be keyed by symbol-handle INDEX, which is
;; only meaningful for one snapshot of a program's symbol table. Specialization
;; rebuilds that table after inserting generated declarations, so a cached value
;; under an old handle index could be returned for a different type whose new
;; handle reuses the same index. Intern ids are stable across that rebuild.
;; Intern generation remains the cheap clear token across programs, while
;; tc-agg-caches-reset! covers lower/test paths that reuse cache arrays without
;; resetting the intern table.
(define tc-agg-size-cache-generation : i64
  -1)

(define (tc-agg-size-cache-ensure!) : unit
  (if (= tc-agg-size-cache-generation (intern-generation))
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i tc-agg-scalar-cache-capacity)
          (begin
            (array.array-set! tc-agg-size-cache i 0)
            (set! i (+ i 1))))
        (set! tc-agg-size-cache-generation (intern-generation))))))

(define (tc-agg-scalar-cache-key-id [name-id : i64]) : i64
  (if (>= name-id tc-agg-scalar-cache-capacity)
    (- 0 1)
    name-id))

(define (tc-inline-aggregate-size-cached
  [ctx : TcContext]
  [name-id : i64]
  [fallback : i64]) : i64
  (begin
    (tc-agg-size-cache-ensure!)
    (let
      [key : i64 (tc-agg-scalar-cache-key-id name-id)]
      (if (< key 0)
        (match (tc-inline-aggregate-layout-for ctx (intern-str name-id))
          [(OkTcInlineAggregateLayout layout)
            (tc-inline-aggregate-layout-size layout)]
          [(ErrTcInlineAggregateLayout _) fallback])
        (let
          [cached : i64 (array.array-ref tc-agg-size-cache key)]
          (if (> cached 0)
            (- cached 1)
            (match (tc-inline-aggregate-layout-for ctx (intern-str name-id))
              [(OkTcInlineAggregateLayout layout)
                (let
                  [size : i64 (tc-inline-aggregate-layout-size layout)]
                  (begin
                    (array.array-set! tc-agg-size-cache key (+ size 1))
                    size))]
              [(ErrTcInlineAggregateLayout _) fallback])))))))

;; #2609: same arena-safe fixed cache for bare aggregate ALIGN queries. Lowering
;; asks for alignment on the same hot aggregate paths as size; rebuilding the full
;; layout here defeats the size/regword caches.
(define tc-agg-align-cache : (Array i64)
  (array.make-array i64 400000))
(define tc-agg-align-cache-generation : i64
  -1)

(define (tc-agg-align-cache-ensure!) : unit
  (if (= tc-agg-align-cache-generation (intern-generation))
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i tc-agg-scalar-cache-capacity)
          (begin
            (array.array-set! tc-agg-align-cache i 0)
            (set! i (+ i 1))))
        (set! tc-agg-align-cache-generation (intern-generation))))))

(define (tc-inline-aggregate-align-cached
  [ctx : TcContext]
  [name-id : i64]
  [fallback : i64]) : i64
  (begin
    (tc-agg-align-cache-ensure!)
    (let
      [key : i64 (tc-agg-scalar-cache-key-id name-id)]
      (if (< key 0)
        (match (tc-inline-aggregate-layout-for ctx (intern-str name-id))
          [(OkTcInlineAggregateLayout layout)
            (tc-inline-aggregate-layout-align layout)]
          [(ErrTcInlineAggregateLayout _) fallback])
        (let
          [cached : i64 (array.array-ref tc-agg-align-cache key)]
          (if (> cached 0)
            (- cached 1)
            (match (tc-inline-aggregate-layout-for ctx (intern-str name-id))
              [(OkTcInlineAggregateLayout layout)
                (let
                  [align : i64 (tc-inline-aggregate-layout-align layout)]
                  (begin
                    (array.array-set! tc-agg-align-cache key (+ align 1))
                    align))]
              [(ErrTcInlineAggregateLayout _) fallback])))))))

;; #2386 (compile-time): memoize a bare aggregate's register-resident word count
;; (0 = not register-resident, else 1 or 2). Same arena-safe intern-id keyed
;; fixed array as the size cache; this is the hot query for every aggregate
;; construct / struct-get / copy (lower-name-register-words). Encoded as
;; words+1 (0 = uncached). Only fully-resolved layouts are cached.
(define tc-agg-regwords-cache : (Array i64)
  (array.make-array i64 400000))

;; Same per-program keying as tc-agg-size-cache, so it is gated on
;; intern-generation and explicitly invalidated at lower boundaries.
(define tc-agg-regwords-cache-generation : i64
  -1)

(define (tc-agg-caches-reset!) : unit
  (begin
    (set! tc-agg-layout-cache-generation -1)
    (set! tc-agg-size-cache-generation -1)
    (set! tc-agg-align-cache-generation -1)
    (set! tc-agg-regwords-cache-generation -1)))

(define (tc-agg-regwords-cache-ensure!) : unit
  (if (= tc-agg-regwords-cache-generation (intern-generation))
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i tc-agg-scalar-cache-capacity)
          (begin
            (array.array-set! tc-agg-regwords-cache i 0)
            (set! i (+ i 1))))
        (set! tc-agg-regwords-cache-generation (intern-generation))))))

(define (tc-inline-aggregate-regwords-compute [ctx : TcContext] [name-id : i64]) : i64
  (match (tc-inline-aggregate-layout-for ctx (intern-str name-id))
    [(OkTcInlineAggregateLayout layout)
      (if (tc-inline-aggregate-layout-register-resident? layout)
        (/ (+ (tc-inline-aggregate-layout-size layout) 7) 8)
        0)]
    [(ErrTcInlineAggregateLayout _) 0]))

(define (tc-inline-aggregate-regwords-cached [ctx : TcContext] [name-id : i64]) : i64
  (begin
    (tc-agg-regwords-cache-ensure!)
    (let
      [key : i64 (tc-agg-scalar-cache-key-id name-id)]
      (if (< key 0)
        (tc-inline-aggregate-regwords-compute ctx name-id)
        (let
          [cached : i64 (array.array-ref tc-agg-regwords-cache key)]
          (if (> cached 0)
            (- cached 1)
            (match (tc-inline-aggregate-layout-for ctx (intern-str name-id))
              [(OkTcInlineAggregateLayout layout)
                (let
                  [words : i64
                    (if (tc-inline-aggregate-layout-register-resident? layout)
                      (/ (+ (tc-inline-aggregate-layout-size layout) 7) 8)
                      0)]
                  (begin
                    (array.array-set! tc-agg-regwords-cache key (+ words 1))
                    words))]
              [(ErrTcInlineAggregateLayout _) 0])))))))

;; #2386: a struct/enum layout is "register-resident (1-word)" when it fits in a
;; single 8-byte machine word and is built only of word-class data. Such a value
;; can live in a register end-to-end (packed/extracted by shift+mask) instead of
;; round-tripping through a memory slot.
;;
;; Scope (slice 2): single-word STRUCTs (all fields word-class) AND nullary
;; size-8 ENUMs. A size-8 enum is necessarily nullary -- the tag occupies the
;; whole first word at offset 0, so any variant payload would force size >= 16 --
;; hence its single register-resident word is just the discriminant tag.
;;
;; This makes `=` on a nullary enum a tag (structural) compare rather than the
;; old stack-slot handle compare: two separately-constructed values of the same
;; variant now compare equal, which is the intended value-semantics for a POD
;; tag (and matches what `match` already observes). Bootstrap fixpoint +
;; integration corpus are the canary that the compiler's own codegen does not
;; depend on the prior handle-identity behavior.
(define (tc-inline-aggregate-layout-register-resident?
  [layout : TcInlineAggregateLayout]) : bool
  (match layout
    [(TcInlineStructLayout size _ fields)
      ;; #2386: an integer-class struct of 1 word (8 B) or 2 words (16 B) whose
      ;; fields are all supported register classes is register-resident --
      ;; carried in one or two register-class words end-to-end. #2601 extends the
      ;; original INTEGER-only gate to exact f64 SSE eightbytes; #2855 admits
      ;; homogeneous packed f32 SSE eightbytes while mixed int/float words stay
      ;; memory-backed.
      (if (or (= size 8) (= size 16))
        (tc-inline-fields-all-register-class? fields)
        false)]
    ;; #2386: an enum is register-resident at 1 word (size 8 -- necessarily
    ;; nullary, the tag word) or 2 words (size 16 -- tag in word0, a single
    ;; supported register-class payload in word1). Larger or unsupported
    ;; aggregate-payload enums keep the memory path.
    [(TcInlineEnumLayout size _ variants)
      (if (or (= size 8) (= size 16))
        (tc-inline-enum-payloads-all-register-class? variants)
        false)]))

(define (tc-name-register-resident? [ctx : TcContext] [name : String]) : bool
  (match (tc-inline-aggregate-layout-for ctx name)
    [(OkTcInlineAggregateLayout layout)
      (tc-inline-aggregate-layout-register-resident? layout)]
    [(ErrTcInlineAggregateLayout _) false]))

(define (tc-repr-c-unsupported-field-message
  [owner : String]
  [field : String]
  [ty : AstType]) : String
  (str_cat.str-cat
    "typecheck: repr c struct "
    owner
    " field "
    field
    " has unsupported field type "
    (tc-type-render ty)))

(define (tc-repr-c-field-layout-info
  [ctx : TcContext]
  [owner : String]
  [field : String]
  [ty : AstType]
  [seen : TcStringList]) : ResultTcLayoutInfo
  (match (tc-resolve-type ctx ty)
    [(AstTyI64) (OkTcLayoutInfo (TcLayoutInfo 8 8))]
    [(AstTyU64) (OkTcLayoutInfo (TcLayoutInfo 8 8))]
    [(AstTyF64) (OkTcLayoutInfo (TcLayoutInfo 8 8))]
    [(AstTyF32) (OkTcLayoutInfo (TcLayoutInfo 4 4))]
    [(AstTyI32) (OkTcLayoutInfo (TcLayoutInfo 4 4))]
    [(AstTyU32) (OkTcLayoutInfo (TcLayoutInfo 4 4))]
    [(AstTyI16) (OkTcLayoutInfo (TcLayoutInfo 2 2))]
    [(AstTyU16) (OkTcLayoutInfo (TcLayoutInfo 2 2))]
    [(AstTyI8) (OkTcLayoutInfo (TcLayoutInfo 1 1))]
    [(AstTyU8) (OkTcLayoutInfo (TcLayoutInfo 1 1))]
    [(AstTyBool) (OkTcLayoutInfo (TcLayoutInfo 1 1))]
    [(AstTyChar) (OkTcLayoutInfo (TcLayoutInfo 1 1))]
    [(AstTyPtr _) (OkTcLayoutInfo (TcLayoutInfo 8 8))]
    [(AstTyMutPtr _) (OkTcLayoutInfo (TcLayoutInfo 8 8))]
    [(AstTyStruct nested)
      (let
        [nested-str : String (intern-str nested)]
        (match (tc-struct-decl ctx nested-str)
          [(OkTcStructDecl decl)
            (match decl
              [(TcStructDecl repr _ _)
                (if (ast-struct-repr-c? repr)
                  (match (tc-repr-c-struct-layout-with-seen ctx nested-str seen)
                    [(OkTcReprCLayout layout)
                      (OkTcLayoutInfo
                        (TcLayoutInfo
                          (tc-repr-c-layout-size layout)
                          (tc-repr-c-layout-align layout)))]
                    [(ErrTcReprCLayout message) (ErrTcLayoutInfo message)])
                  ;; #2296: embed a default-layout struct by value using its
                  ;; default inline C-rule layout (default layout now follows C
                  ;; layout per #1867). `seen` carries the repr-c owners so a
                  ;; cycle back through this struct is still detected.
                  (tc-inline-aggregate-type-layout-with-stack
                    ctx
                    (AstTyStruct nested)
                    seen))])]
          [(ErrTcStructDecl message) (ErrTcLayoutInfo message)]))]
    [(AstTyStructArgs nested lifetimes)
      (let
        [nested-str : String (intern-str nested)]
        (match (tc-struct-decl ctx nested-str)
          [(OkTcStructDecl decl)
            (match decl
              [(TcStructDecl repr _ _)
                (if (ast-struct-repr-c? repr)
                  (match (tc-repr-c-struct-layout-with-seen ctx nested-str seen)
                    [(OkTcReprCLayout layout)
                      (OkTcLayoutInfo
                        (TcLayoutInfo
                          (tc-repr-c-layout-size layout)
                          (tc-repr-c-layout-align layout)))]
                    [(ErrTcReprCLayout message) (ErrTcLayoutInfo message)])
                  ;; #2296: embed a default-layout struct (with type args) by value
                  ;; using its default inline C-rule layout.
                  (tc-inline-aggregate-type-layout-with-stack
                    ctx
                    (AstTyStructArgs nested lifetimes)
                    seen))])]
          [(ErrTcStructDecl message) (ErrTcLayoutInfo message)]))]
    ;; #2296: embed an enum by value using its default inline layout (tag +
    ;; payload). Enums have no separate repr-c layout; the inline engine threads
    ;; `seen` for cycle detection.
    [(AstTyEnum name)
      (tc-inline-aggregate-type-layout-with-stack ctx (AstTyEnum name) seen)]
    [(AstTyEnumArgs name lifetimes)
      (tc-inline-aggregate-type-layout-with-stack
        ctx
        (AstTyEnumArgs name lifetimes)
        seen)]
    [_ (ErrTcLayoutInfo (tc-repr-c-unsupported-field-message owner field ty))]))

(define (tc-repr-c-fields-layout
  [ctx : TcContext]
  [owner : String]
  [fields : AstFieldDefList]
  [cursor : i64]
  [max-align : i64]
  [seen : TcStringList]) : ResultTcReprCLayout
  (match fields
    [(AstFieldDefNil)
      (if (= max-align 0)
        (ErrTcReprCLayout "typecheck: repr c struct needs at least one field")
        (OkTcReprCLayout
          (TcReprCLayout
            (tc-align-up cursor max-align)
            max-align
            TcReprCFieldLayoutNil)))]
    [(AstFieldDefCons field rest)
      (let
        [rest : AstFieldDefList (box-get rest)]
        (match field
          [(AstFieldDef name ty _)
            (let
              [resolved : AstType (tc-resolve-type ctx ty)]
              (match (tc-repr-c-field-layout-info
                ctx
                owner
                (intern-str name)
                resolved
                seen)
                [(OkTcLayoutInfo info)
                  (let
                    [field-align : i64 (tc-layout-info-align info)]
                    [field-size : i64 (tc-layout-info-size info)]
                    [offset : i64 (tc-align-up cursor field-align)]
                    [next-cursor : i64 (+ offset field-size)]
                    [next-align : i64 (tc-max-i64 max-align field-align)]
                    (match (tc-repr-c-fields-layout
                      ctx
                      owner
                      rest
                      next-cursor
                      next-align
                      seen)
                      [(OkTcReprCLayout rest-layout)
                        (begin
                          (cfg compile-profile (tc-lp-note 0))
                          (OkTcReprCLayout
                            (TcReprCLayout
                              (tc-repr-c-layout-size rest-layout)
                              (tc-repr-c-layout-align rest-layout)
                              (TcReprCFieldLayoutCons
                                (TcReprCFieldLayout
                                  (intern-str name)
                                  resolved
                                  offset)
                                (box (tc-repr-c-layout-fields rest-layout))))))]
                      [(ErrTcReprCLayout message) (ErrTcReprCLayout message)]))]
                [(ErrTcLayoutInfo message) (ErrTcReprCLayout message)]))]))]))

(define (tc-repr-c-struct-layout-with-seen
  [ctx : TcContext]
  [struct-name : String]
  [seen : TcStringList]) : ResultTcReprCLayout
  (if (tc-string-list-contains seen struct-name)
    (ErrTcReprCLayout
      (string.string-append
        "typecheck: recursive repr c struct layout cycle involving "
        struct-name))
    (match (tc-struct-decl ctx struct-name)
      [(OkTcStructDecl decl)
        (match decl
          [(TcStructDecl repr _ fields)
            (if (ast-struct-repr-c? repr)
              (tc-repr-c-fields-layout
                ctx
                struct-name
                fields
                0
                0
                (tc-string-list-add seen struct-name))
              (ErrTcReprCLayout
                (string.string-append
                  "typecheck: struct is not repr c: "
                  struct-name)))])]
      [(ErrTcStructDecl message) (ErrTcReprCLayout message)])))

(define (tc-repr-c-struct-layout [ctx : TcContext] [struct-name : String]) : ResultTcReprCLayout
  (tc-repr-c-struct-layout-with-seen ctx struct-name TcStringNil))

(define (tc-ctfe-inline-layout-fields-into
  [fields : TcInlineFieldLayoutList]
  [out : CtfeLayoutFieldList]) : CtfeLayoutFieldList
  (match fields
    [(TcInlineFieldLayoutNil) out]
    [(TcInlineFieldLayoutCons field rest)
      (match field
        [(TcInlineFieldLayout name _ offset)
          (tc-ctfe-inline-layout-fields-into
            (box-get rest)
            (ctfe-layout-field-list-push out (CtfeLayoutField name offset)))])]))

(define (tc-ctfe-inline-layout-field-count [fields : TcInlineFieldLayoutList]) : i64
  (match fields
    [(TcInlineFieldLayoutNil) 0]
    [(TcInlineFieldLayoutCons _ rest)
      (+ 1 (tc-ctfe-inline-layout-field-count (box-get rest)))]))

(define (tc-ctfe-inline-layout-fields [fields : TcInlineFieldLayoutList]) : CtfeLayoutFieldList
  (tc-ctfe-inline-layout-fields-into
    fields
    (ctfe-layout-field-list-with-capacity
      (tc-ctfe-inline-layout-field-count fields))))

(define (tc-ctfe-inline-aggregate-layout-info
  [name : String]
  [layout : TcInlineAggregateLayout]) : CtfeLayoutInfo
  (match layout
    [(TcInlineStructLayout size align fields)
      (CtfeLayoutInfo
        name
        true
        size
        align
        (tc-ctfe-inline-layout-fields fields))]
    [(TcInlineEnumLayout size align _)
      (CtfeLayoutInfo name false size align (ctfe-layout-field-list-empty))]))

(define (tc-ctfe-struct-layout-info [ctx : TcContext] [struct-name : String]) : CtfeLayoutInfo
  (match (tc-inline-aggregate-layout-for ctx struct-name)
    [(OkTcInlineAggregateLayout layout)
      (tc-ctfe-inline-aggregate-layout-info struct-name layout)]
    [(ErrTcInlineAggregateLayout _)
      (CtfeLayoutInfo struct-name false 8 8 (ctfe-layout-field-list-empty))]))

(define (tc-ctfe-type-layout-info [ctx : TcContext] [type-name : String]) : CtfeLayoutInfo
  (match (tc-inline-aggregate-layout-for ctx type-name)
    [(OkTcInlineAggregateLayout layout)
      (tc-ctfe-inline-aggregate-layout-info type-name layout)]
    [(ErrTcInlineAggregateLayout _)
      (CtfeLayoutInfo type-name false 8 8 (ctfe-layout-field-list-empty))]))

(define (tc-ctfe-layout-add-alias
  [layouts : CtfeLayoutInfoList]
  [info : CtfeLayoutInfo]
  [alias : String]) : CtfeLayoutInfoList
  (match info
    [(CtfeLayoutInfo _ repr-c? size align fields)
      (ctfe-layout-info-list-add-if-missing
        layouts
        (CtfeLayoutInfo alias repr-c? size align fields))]))

(define (tc-ctfe-layout-add-names
  [layouts : CtfeLayoutInfoList]
  [info : CtfeLayoutInfo]
  [name : String]
  [module : String]) : CtfeLayoutInfoList
  (let
    [with-key : CtfeLayoutInfoList
      (ctfe-layout-info-list-add-if-missing layouts info)]
    (if (= (string.string-length module) 0)
      with-key
      (tc-ctfe-layout-add-alias with-key info name))))

(define (tc-ctfe-layouts-from-decls
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]
  [layouts : CtfeLayoutInfoList]) : CtfeLayoutInfoList
  (match decls
    [(AstDeclNil) layouts]
    [(AstDeclCons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDeclModule next-module)
            (tc-ctfe-layouts-from-decls
              ctx
              rest
              (intern-str next-module)
              layouts)]
          [(AstDeclDefStruct name _ _ _)
            (let
              [name-str : String (intern-str name)]
              [key : String (compiler-symbol-module-key module name-str)]
              [info : CtfeLayoutInfo (tc-ctfe-struct-layout-info ctx key)]
              (tc-ctfe-layouts-from-decls
                ctx
                rest
                module
                (tc-ctfe-layout-add-names layouts info name-str module)))]
          [(AstDeclDefStructLifetimes name _ _ _ _)
            (let
              [name-str : String (intern-str name)]
              [key : String (compiler-symbol-module-key module name-str)]
              [info : CtfeLayoutInfo (tc-ctfe-struct-layout-info ctx key)]
              (tc-ctfe-layouts-from-decls
                ctx
                rest
                module
                (tc-ctfe-layout-add-names layouts info name-str module)))]
          [(AstDeclDefEnum name _ _)
            (let
              [name-str : String (intern-str name)]
              [key : String (compiler-symbol-module-key module name-str)]
              [info : CtfeLayoutInfo (tc-ctfe-type-layout-info ctx key)]
              (tc-ctfe-layouts-from-decls
                ctx
                rest
                module
                (tc-ctfe-layout-add-names layouts info name-str module)))]
          [(AstDeclDefEnumLifetimes name _ _ _)
            (let
              [name-str : String (intern-str name)]
              [key : String (compiler-symbol-module-key module name-str)]
              [info : CtfeLayoutInfo (tc-ctfe-type-layout-info ctx key)]
              (tc-ctfe-layouts-from-decls
                ctx
                rest
                module
                (tc-ctfe-layout-add-names layouts info name-str module)))]
          [(AstDeclComptimeDecl _ template-box)
            (let
              [template : AstDecl (box-get template-box)]
              (match template
                [(AstDeclDefStruct name _ _ _)
                  (let
                    [name-str : String (intern-str name)]
                    [key : String (compiler-symbol-module-key module name-str)]
                    [info : CtfeLayoutInfo (tc-ctfe-struct-layout-info ctx key)]
                    (tc-ctfe-layouts-from-decls
                      ctx
                      rest
                      module
                      (tc-ctfe-layout-add-names layouts info name-str module)))]
                [(AstDeclDefStructLifetimes name _ _ _ _)
                  (let
                    [name-str : String (intern-str name)]
                    [key : String (compiler-symbol-module-key module name-str)]
                    [info : CtfeLayoutInfo (tc-ctfe-struct-layout-info ctx key)]
                    (tc-ctfe-layouts-from-decls
                      ctx
                      rest
                      module
                      (tc-ctfe-layout-add-names layouts info name-str module)))]
                [(AstDeclDefEnum name _ _)
                  (let
                    [name-str : String (intern-str name)]
                    [key : String (compiler-symbol-module-key module name-str)]
                    [info : CtfeLayoutInfo (tc-ctfe-type-layout-info ctx key)]
                    (tc-ctfe-layouts-from-decls
                      ctx
                      rest
                      module
                      (tc-ctfe-layout-add-names layouts info name-str module)))]
                [(AstDeclDefEnumLifetimes name _ _ _)
                  (let
                    [name-str : String (intern-str name)]
                    [key : String (compiler-symbol-module-key module name-str)]
                    [info : CtfeLayoutInfo (tc-ctfe-type-layout-info ctx key)]
                    (tc-ctfe-layouts-from-decls
                      ctx
                      rest
                      module
                      (tc-ctfe-layout-add-names layouts info name-str module)))]
                [_ (tc-ctfe-layouts-from-decls ctx rest module layouts)]))]
          [_ (tc-ctfe-layouts-from-decls ctx rest module layouts)]))]))

(define (tc-ctfe-layouts [ctx : TcContext]) : CtfeLayoutInfoList
  (match ctx
    [(TcContext program _ _ _ _)
      (match program
        [(AstProgram decls-box)
          (let
            [decls : AstDeclList (box-get decls-box)]
            (begin
              (ctfe-build-seen-reset!)
              (tc-ctfe-layouts-from-decls
                ctx
                decls
                ""
                (ctfe-layout-info-list-with-capacity
                  (ctfe-metadata-decl-capacity decls)))))])]))

;; CTFE base environment (reflection + layout metadata). This is invariant across
;; a single compile (same program/symbols/registries), but is requested up to ~8
;; times per compile -- once in macro expansion plus once per comptime evaluation
;; in the typecheck and lower passes -- and each `ctfe-reflections-from-program` /
;; `tc-ctfe-layouts` build walks the whole program (O(program), tens of MB). The
;; cache is populated eagerly in `macro-expand-program` (which always runs first,
;; in the enclosing program arena, so the cached value never dangles into a
;; rewound scratch arena) and reset per compile at the top of that function.
(define (tc-ctfe-env [ctx : TcContext]) : CtfeEnv
  (if macro-expand-ctfe-env-ready
    (ctfe-env-rebase-pools macro-expand-ctfe-env-value (tc-context-pools ctx))
    (if ctfe-needs-metadata
      (ctfe-env-with-metadata-and-pools
        (tc-ctfe-layouts ctx)
        (ctfe-reflections-from-program (tc-context-program ctx))
        (tc-context-pools ctx))
      (ctfe-env-empty-with-pools (tc-context-pools ctx)))))

(define (tc-string-prefix? [text : String] [prefix : String]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [prefix-len : i64 (string.string-length prefix)]
    (if (< text-len prefix-len)
      false
      (string.string-eq (string.substring text 0 prefix-len) prefix))))

(define (tc-result-info-enum-name [info : TcResultInfo]) : String
  (match info
    [(TcResultInfo _ enum-name _ _ _ _) enum-name]))

(define (tc-result-info-kind [info : TcResultInfo]) : TcTryKind
  (match info
    [(TcResultInfo kind _ _ _ _ _) kind]))

(define (tc-result-info-ok-name [info : TcResultInfo]) : String
  (match info
    [(TcResultInfo _ _ ok-name _ _ _) ok-name]))

(define (tc-result-info-ok-type [info : TcResultInfo]) : AstType
  (match info
    [(TcResultInfo _ _ _ ok-ty _ _) ok-ty]))

(define (tc-result-info-err-name [info : TcResultInfo]) : String
  (match info
    [(TcResultInfo _ _ _ _ err-name _) err-name]))

(define (tc-result-info-err-type [info : TcResultInfo]) : AstType
  (match info
    [(TcResultInfo _ _ _ _ _ err-ty) err-ty]))

(define (tc-ok-variant-name? [name : String]) : bool
  (tc-string-prefix? name "Ok"))

(define (tc-err-variant-name? [name : String]) : bool
  (tc-string-prefix? name "Err"))

(define (tc-some-variant-name? [name : String]) : bool
  (tc-string-prefix? name "Some"))

(define (tc-none-variant-name? [name : String]) : bool
  (tc-string-prefix? name "None"))

(define (tc-result-variant-payload-type
  [ctx : TcContext]
  [variant-name : String]
  [fields : AstTypeList]) : ResultTcType
  (match fields
    [(AstTypeCons field tail)
      (let
        [field : AstType (tc-context-type-get ctx field)]
        [tail : AstTypeList (box-get tail)]
        (match tail
          [(AstTypeNil) (OkTcType (tc-resolve-type ctx field))]
          [_
            (ErrTcType
              (string.string-append
                "typecheck: try requires Result-like variant with one payload "
                variant-name))]))]
    [_
      (ErrTcType
        (string.string-append
          "typecheck: try requires Result-like variant with one payload "
          variant-name))]))

(define (tc-result-info-build
  [ctx : TcContext]
  [try-kind : TcTryKind]
  [enum-name : String]
  [ok-name : String]
  [ok-fields : AstTypeList]
  [err-name : String]
  [err-fields : AstTypeList]) : ResultTcResultInfo
  (match (tc-result-variant-payload-type ctx ok-name ok-fields)
    [(OkTcType ok-ty)
      (match (tc-result-variant-payload-type ctx err-name err-fields)
        [(OkTcType err-ty)
          (OkTcResultInfo
            (TcResultInfo
              try-kind
              enum-name
              (tc-qualified-variant-name enum-name ok-name)
              ok-ty
              (tc-qualified-variant-name enum-name err-name)
              err-ty))]
        [(ErrTcType message) (ErrTcResultInfo message)])]
    [(ErrTcType message) (ErrTcResultInfo message)]))

(define (tc-option-none-variant-type
  [variant-name : String]
  [fields : AstTypeList]) : ResultTcType
  (match fields
    [(AstTypeNil) (OkTcType (AstTyUnit))]
    [_
      (ErrTcType
        (string.string-append
          "typecheck: try requires Option-like variant with no payload "
          variant-name))]))

(define (tc-option-info-build
  [ctx : TcContext]
  [enum-name : String]
  [some-name : String]
  [some-fields : AstTypeList]
  [none-name : String]
  [none-fields : AstTypeList]) : ResultTcResultInfo
  (match (tc-result-variant-payload-type ctx some-name some-fields)
    [(OkTcType some-ty)
      (match (tc-option-none-variant-type none-name none-fields)
        [(OkTcType none-ty)
          (OkTcResultInfo
            (TcResultInfo
              TcTryOption
              enum-name
              (tc-qualified-variant-name enum-name some-name)
              some-ty
              (tc-qualified-variant-name enum-name none-name)
              none-ty))]
        [(ErrTcType message) (ErrTcResultInfo message)])]
    [(ErrTcType message) (ErrTcResultInfo message)]))

(define (tc-result-info-two-variants
  [ctx : TcContext]
  [enum-name : String]
  [first-name : String]
  [first-fields : AstTypeList]
  [second-name : String]
  [second-fields : AstTypeList]) : ResultTcResultInfo
  (cond
    [(and (tc-ok-variant-name? first-name) (tc-err-variant-name? second-name))
      (tc-result-info-build
        ctx
        TcTryResult
        enum-name
        first-name
        first-fields
        second-name
        second-fields)]
    [(and (tc-err-variant-name? first-name) (tc-ok-variant-name? second-name))
      (tc-result-info-build
        ctx
        TcTryResult
        enum-name
        second-name
        second-fields
        first-name
        first-fields)]
    [(and
        (tc-some-variant-name? first-name)
        (tc-none-variant-name? second-name))
      (tc-option-info-build
        ctx
        enum-name
        first-name
        first-fields
        second-name
        second-fields)]
    [(and
        (tc-none-variant-name? first-name)
        (tc-some-variant-name? second-name))
      (tc-option-info-build
        ctx
        enum-name
        second-name
        second-fields
        first-name
        first-fields)]
    [else
      (ErrTcResultInfo
        "typecheck: try requires Result-like Ok*/Err* or Option-like Some*/None* variants")]))

(define (tc-result-info-from-variants
  [ctx : TcContext]
  [enum-name : String]
  [variants : AstVariantDefList]) : ResultTcResultInfo
  (match variants
    [(AstVariantDefCons first tail)
      (let
        [tail : AstVariantDefList (box-get tail)]
        (match tail
          [(AstVariantDefCons second AstVariantDefNil)
            (match first
              [(AstVariantDef first-name first-fields _)
                (match second
                  [(AstVariantDef second-name second-fields _)
                    (tc-result-info-two-variants
                      ctx
                      enum-name
                      (intern-str first-name)
                      first-fields
                      (intern-str second-name)
                      second-fields)])])]
          [_
            (ErrTcResultInfo
              "typecheck: try requires Result-like enum with exactly two variants")]))]
    [_
      (ErrTcResultInfo
        "typecheck: try requires Result-like enum with exactly two variants")]))

(define (tc-result-info [ctx : TcContext] [ty : AstType]) : ResultTcResultInfo
  (match (tc-type-strip-region ty)
    [(AstTyEnum enum-name)
      (let
        [enum-name-str : String (intern-str enum-name)]
        (match (tc-context-enum-variants ctx enum-name-str)
          [(OkAstVariantDefList variants)
            (tc-result-info-from-variants ctx enum-name-str variants)]
          [(ErrAstVariantDefList message) (ErrTcResultInfo message)]))]
    [(AstTyEnumArgs enum-name _)
      (let
        [enum-name-str : String (intern-str enum-name)]
        (match (tc-program-enum-variants (tc-context-program ctx) enum-name-str)
          [(OkAstVariantDefList variants)
            (tc-result-info-from-variants ctx enum-name-str variants)]
          [(ErrAstVariantDefList message) (ErrTcResultInfo message)]))]
    [_ (ErrTcResultInfo "typecheck: try requires Result-like enum")]))

(define (tc-try-infos-compatible
  [operand-info : TcResultInfo]
  [return-info : TcResultInfo]) : ResultTcUnit
  (match (tc-result-info-kind operand-info)
    [(TcTryResult)
      (match (tc-result-info-kind return-info)
        [(TcTryResult)
          (tc-expect
            (tc-result-info-err-type operand-info)
            (tc-result-info-err-type return-info)
            "typecheck: try error type mismatch")]
        [(TcTryOption) (ErrTcUnit "typecheck: try carrier mismatch")])]
    [(TcTryOption)
      (match (tc-result-info-kind return-info)
        [(TcTryOption) OkTcUnit]
        [(TcTryResult) (ErrTcUnit "typecheck: try carrier mismatch")])]))

(define (tc-try-expr [ctx : TcContext] [env : TcTypeEnv] [inner : AstExpr]) : ResultTcType
  (match (tc-expr ctx env inner)
    [(OkTcType operand-ty)
      (match (tc-result-info ctx operand-ty)
        [(OkTcResultInfo operand-info)
          (match (tc-current-return-type env)
            [(OkTcType return-ty)
              (match (tc-result-info ctx return-ty)
                [(OkTcResultInfo return-info)
                  (match (tc-try-infos-compatible operand-info return-info)
                    [(OkTcUnit)
                      (OkTcType (tc-result-info-ok-type operand-info))]
                    [(ErrTcUnit message) (ErrTcType message)])]
                [(ErrTcResultInfo _)
                  (ErrTcType
                    "typecheck: try requires enclosing Result-like function")])]
            [(ErrTcType _)
              (ErrTcType
                "typecheck: try requires enclosing Result-like function")])]
        [(ErrTcResultInfo _)
          (ErrTcType "typecheck: try operand must be Result-like enum")])]
    [(ErrTcType message) (ErrTcType message)]))

(define (tc-return-expr [ctx : TcContext] [env : TcTypeEnv] [value : AstExpr]) : ResultTcType
  (match (tc-current-return-type env)
    [(OkTcType return-ty)
      (match (tc-expr-with-expected-or-actual ctx env value return-ty)
        [(OkTcType value-ty)
          (match (tc-expect
            value-ty
            return-ty
            "typecheck: return type mismatch")
            [(OkTcUnit)
              (if (tc-expr-result-uses-active-cleanup-owner? env value)
                (ErrTcType
                  "typecheck: cleanup-required resource would escape with scope")
                (OkTcType (AstTyNever)))]
            [(ErrTcUnit message) (ErrTcType message)])]
        [(ErrTcType message) (ErrTcType message)])]
    [(ErrTcType _) (ErrTcType "typecheck: return requires enclosing function")]))

(define (tc-variant-owner-name [ctx : TcContext] [handle : i64]) : ResultTcString
  (match (compiler-symbols-owner-name-at-index
    (tc-context-symbols ctx)
    (compiler-registry-handle-owner-index handle))
    [(CompilerSomeString name) (OkTcString name)]
    [(CompilerNoString)
      (match (tc-context-program ctx)
        [(AstProgram decls-box)
          (let
            [decls : AstDeclList (box-get decls-box)]
            (tc-variant-owner-name-list
              decls
              (compiler-registry-handle-owner-index handle)
              0
              ""))])]))

(define (tc-variant-owner-name-list
  [decls : AstDeclList]
  [target : i64]
  [index : i64]
  [module : String]) : ResultTcString
  (match decls
    [(AstDeclNil) (ErrTcString "typecheck: variant owner is not enum")]
    [(AstDeclCons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDeclImport _)
            (tc-variant-owner-name-list rest target index module)]
          [(AstDeclIncludeStr _ _)
            (tc-variant-owner-name-list rest target index module)]
          [(AstDeclIncludeBin _ _)
            (tc-variant-owner-name-list rest target index module)]
          [(AstDeclModule next-module)
            (tc-variant-owner-name-list
              rest
              target
              index
              (intern-str next-module))]
          [(AstDeclTest _ _ _)
            (tc-variant-owner-name-list rest target index module)]
          [(AstDeclComptimeDecl _ template-box)
            (let
              [template : AstDecl (box-get template-box)]
              (if (= target index)
                (match template
                  [(AstDeclDefEnum name _ _)
                    (OkTcString
                      (compiler-symbol-module-key module (intern-str name)))]
                  [(AstDeclDefEnumLifetimes name _ _ _)
                    (OkTcString
                      (compiler-symbol-module-key module (intern-str name)))]
                  [_ (ErrTcString "typecheck: variant owner is not enum")])
                (tc-variant-owner-name-list rest target (+ index 1) module)))]
          [_
            (if (= target index)
              (match decl
                [(AstDeclDefEnum name _ _)
                  (OkTcString
                    (compiler-symbol-module-key module (intern-str name)))]
                [(AstDeclDefEnumLifetimes name _ _ _)
                  (OkTcString
                    (compiler-symbol-module-key module (intern-str name)))]
                [_ (ErrTcString "typecheck: variant owner is not enum")])
              (tc-variant-owner-name-list rest target (+ index 1) module))]))]))

(define (tc-variant-constructor-type-for-lookup-or
  [ctx : TcContext]
  [lookup-name : String]
  [_display-name : String]
  [not-found-message : String]) : ResultTcType
  (match (tc-enum-qualified-variant-lookup-key ctx lookup-name)
    [(OkTcString variant-key)
      (match (compiler-registries-lookup-variant
        (tc-context-registries ctx)
        variant-key)
        [(SomeI64 handle)
          (match (tc-variant-owner-name ctx handle)
            [(OkTcString owner)
              (match (compiler-registries-variant-fields-indexed
                (tc-context-symbols ctx)
                handle)
                [(OkAstTypeList fields)
                  (match (tc-nominal-lifetimes ctx owner)
                    [(OkTcLifetimeList lifetimes)
                      (OkTcType
                        (tc-enum-variant-constructor-type
                          ctx
                          owner
                          lifetimes
                          fields))]
                    [(ErrTcLifetimeList message) (ErrTcType message)])]
                [(ErrAstTypeList message) (ErrTcType message)])]
            [(ErrTcString message) (ErrTcType message)])]
        [(NoneI64) (ErrTcType not-found-message)])]
    [(ErrTcString _) (ErrTcType not-found-message)]))

(define (tc-struct-field-type
  [ctx : TcContext]
  [struct-name : String]
  [field : String]) : ResultTcType
  (match (compiler-registries-lookup-struct-field
    (tc-context-registries ctx)
    struct-name
    field)
    [(SomeI64 handle)
      (let
        [field-ctx : TcContext
          (tc-context-with-nominal-owner-index-module
            ctx
            (compiler-registry-handle-owner-index handle))]
        (match (compiler-registries-struct-field-type-indexed
          (tc-context-symbols ctx)
          handle)
          [(OkAstType ty) (OkTcType (tc-resolve-type field-ctx ty))]
          [(ErrAstType message) (ErrTcType message)]))]
    [(NoneI64)
      (ErrTcType
        (string.string-append
          "typecheck: unknown struct field "
          (compiler-struct-field-key struct-name field)))]))

(define (tc-lifetime-subst-from-nominal-args
  [ctx : TcContext]
  [name : String]
  [args : AstLifetimeList]) : ResultTcLifetimeSubst
  (match (tc-nominal-lifetimes ctx name)
    [(OkTcLifetimeList params)
      (tc-infer-lifetime-list params TcLifetimeSubstNil params args)]
    [(ErrTcLifetimeList message) (ErrTcLifetimeSubst message)]))

(define (tc-struct-field-type-with-args
  [ctx : TcContext]
  [struct-name : String]
  [lifetimes : AstLifetimeList]
  [field : String]) : ResultTcType
  (match (compiler-registries-lookup-struct-field
    (tc-context-registries ctx)
    struct-name
    field)
    [(SomeI64 handle)
      (let
        [field-ctx : TcContext
          (tc-context-with-nominal-owner-index-module
            ctx
            (compiler-registry-handle-owner-index handle))]
        (match (compiler-registries-struct-field-type
          (tc-context-program ctx)
          handle)
          [(OkAstType ty)
            (match (tc-lifetime-subst-from-nominal-args
              field-ctx
              struct-name
              lifetimes)
              [(OkTcLifetimeSubst subst)
                (OkTcType
                  (tc-resolve-type field-ctx (tc-lifetime-subst-type subst ty)))]
              [(ErrTcLifetimeSubst message) (ErrTcType message)])]
          [(ErrAstType message) (ErrTcType message)]))]
    [(NoneI64)
      (ErrTcType
        (string.string-append
          "typecheck: unknown struct field "
          (compiler-struct-field-key struct-name field)))]))

(define (tc-comptime-unknown-field [owner : String] [field : String]) : ResultTcType
  (ErrTcType
    (string.string-append
      "typecheck: unknown struct field "
      (compiler-struct-field-key owner field))))

(define (tc-comptime-sequence-field-type
  [owner : String]
  [elem-ty : AstType]
  [field : String]) : ResultTcType
  (cond
    [(string.string-eq field "items")
      (OkTcType (AstTyDynArray (ty-node-push elem-ty)))]
    [(string.string-eq field "len") (OkTcType (AstTyI64))]
    [else (tc-comptime-unknown-field owner field)]))

(define (tc-comptime-expr-clause-field-type [field : String]) : ResultTcType
  (cond
    [(string.string-eq field "first") (OkTcType (AstTyExpr))]
    [(string.string-eq field "second") (OkTcType (AstTyExpr))]
    [else (tc-comptime-unknown-field "ExprClause" field)]))

(define (tc-comptime-expr-binding-clause-field-type [field : String]) : ResultTcType
  (cond
    [(string.string-eq field "name") (OkTcType (AstTyString))]
    [(string.string-eq field "has-type") (OkTcType (AstTyBool))]
    [(string.string-eq field "ty") (OkTcType (AstTyExpr))]
    [(string.string-eq field "init") (OkTcType (AstTyExpr))]
    [else (tc-comptime-unknown-field "ExprBindingClause" field)]))

(define (tc-struct-get-result-type
  [ctx : TcContext]
  [receiver-ty : AstType]
  [field : String]) : ResultTcType
  (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
    [(AstTyStruct struct-name)
      (match (tc-struct-field-type ctx (intern-str struct-name) field)
        [(OkTcType field-ty)
          (OkTcType (tc-project-from-region-container receiver-ty field-ty))]
        [(ErrTcType message) (ErrTcType message)])]
    [(AstTyStructArgs struct-name lifetimes)
      (match (tc-struct-field-type-with-args
        ctx
        (intern-str struct-name)
        (box-get lifetimes)
        field)
        [(OkTcType field-ty)
          (OkTcType (tc-project-from-region-container receiver-ty field-ty))]
        [(ErrTcType message) (ErrTcType message)])]
    [(AstTyRef lifetime referent-ty)
      (match (tc-struct-get-result-type ctx (ty-node-get referent-ty) field)
        [(OkTcType field-ty) (OkTcType (tc-tag-region lifetime field-ty))]
        [(ErrTcType message) (ErrTcType message)])]
    [(AstTyMutRef lifetime referent-ty)
      (match (tc-struct-get-result-type ctx (ty-node-get referent-ty) field)
        [(OkTcType field-ty) (OkTcType (tc-tag-region lifetime field-ty))]
        [(ErrTcType message) (ErrTcType message)])]
    [(AstTyExprList)
      (tc-comptime-sequence-field-type "ExprList" (AstTyExpr) field)]
    [(AstTyVar name)
      (cond
        [(= name (intern "ExprClause"))
          (tc-comptime-expr-clause-field-type field)]
        [(= name (intern "ExprClauseList"))
          (tc-comptime-sequence-field-type
            "ExprClauseList"
            (tc-macro-expr-clause-type)
            field)]
        [(= name (intern "ExprBindingClause"))
          (tc-comptime-expr-binding-clause-field-type field)]
        [(= name (intern "ExprBindingClauseList"))
          (tc-comptime-sequence-field-type
            "ExprBindingClauseList"
            (tc-macro-expr-binding-clause-type)
            field)]
        [else (ErrTcType "typecheck: struct-get requires struct")])]
    [_ (ErrTcType "typecheck: struct-get requires struct")]))

(define (tc-borrow-place-var-by-value [name : String] [ty : AstType]) : ResultTcBorrowPlace
  (match (tc-type-outer-region ty)
    [(TcSomeString region)
      (OkTcBorrowPlace (TcBorrowPlace region (tc-borrow-referent-type ty)))]
    [(TcNoString)
      (OkTcBorrowPlace (TcBorrowPlace name (tc-borrow-referent-type ty)))]))

(define (tc-reference-containing-place-borrow-ok? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyEnumArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [(AstTyStructArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [(AstTyVarArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [_ false]))

(define (tc-borrow-place-var [name : String] [ty : AstType]) : ResultTcBorrowPlace
  (match (tc-type-strip-region ty)
    [(AstTyRef lifetime referent-ty)
      (OkTcBorrowPlace
        (TcBorrowPlace
          lifetime
          (tc-borrow-referent-type (ty-node-get referent-ty))))]
    [(AstTyMutRef lifetime referent-ty)
      (OkTcBorrowPlace
        (TcBorrowPlace
          lifetime
          (tc-borrow-referent-type (ty-node-get referent-ty))))]
    [_
      (if (and
        (tc-type-contains-reference? ty)
        (not (tc-reference-containing-place-borrow-ok? ty)))
        (ErrTcBorrowPlace
          "typecheck: borrowing places that contain references is not implemented")
        (tc-borrow-place-var-by-value name ty))]))

(define (tc-borrow-referent-type [ty : AstType]) : AstType
  (match (tc-type-without-regions ty)
    [(AstTyString) (AstTyStr)]
    [_ (tc-type-without-regions ty)]))

(define (tc-borrow-place-struct-field
  [ctx : TcContext]
  [place : TcBorrowPlace]
  [field : String]) : ResultTcBorrowPlace
  (match place
    [(TcBorrowPlace lifetime receiver-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
        [(AstTyStruct struct-name)
          (match (tc-struct-field-type ctx (intern-str struct-name) field)
            [(OkTcType field-ty)
              (OkTcBorrowPlace
                (TcBorrowPlace lifetime (tc-borrow-referent-type field-ty)))]
            [(ErrTcType message) (ErrTcBorrowPlace message)])]
        [(AstTyStructArgs struct-name lifetimes)
          (match (tc-struct-field-type-with-args
            ctx
            (intern-str struct-name)
            (box-get lifetimes)
            field)
            [(OkTcType field-ty)
              (OkTcBorrowPlace
                (TcBorrowPlace lifetime (tc-borrow-referent-type field-ty)))]
            [(ErrTcType message) (ErrTcBorrowPlace message)])]
        [_
          (ErrTcBorrowPlace
            "typecheck: struct-get borrow requires struct place")])]))

(define (tc-borrow-place-tuple-field
  [ctx : TcContext]
  [place : TcBorrowPlace]
  [index : i64]) : ResultTcBorrowPlace
  (match place
    [(TcBorrowPlace lifetime tuple-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx tuple-ty))
        [(AstTyTuple elems)
          (match (tc-type-list-ref (box-get elems) index)
            [(OkTcType elem-ty)
              (OkTcBorrowPlace
                (TcBorrowPlace lifetime (tc-borrow-referent-type elem-ty)))]
            [(ErrTcType message) (ErrTcBorrowPlace message)])]
        [_
          (ErrTcBorrowPlace "typecheck: tuple-ref borrow requires tuple place")])]))

(define (tc-borrow-place-array-element
  [ctx : TcContext]
  [place : TcBorrowPlace]) : ResultTcBorrowPlace
  (match place
    [(TcBorrowPlace lifetime array-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx array-ty))
        [(AstTyArray elem-ty _)
          (OkTcBorrowPlace
            (TcBorrowPlace
              lifetime
              (tc-borrow-referent-type (ty-node-get elem-ty))))]
        [(AstTyDynArray elem-ty)
          (OkTcBorrowPlace
            (TcBorrowPlace
              lifetime
              (tc-borrow-referent-type (ty-node-get elem-ty))))]
        [_
          (ErrTcBorrowPlace "typecheck: array-ref borrow requires array place")])]))

(define (tc-borrow-place-box-get [ctx : TcContext] [place : TcBorrowPlace]) : ResultTcBorrowPlace
  (match place
    [(TcBorrowPlace lifetime box-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx box-ty))
        [(AstTyBox inner-ty)
          (OkTcBorrowPlace
            (TcBorrowPlace
              lifetime
              (tc-borrow-referent-type (ty-node-get inner-ty))))]
        [_ (ErrTcBorrowPlace "typecheck: box-get borrow requires Box place")])]))

(define (tc-borrow-place [ctx : TcContext] [env : TcTypeEnv] [expr : AstExpr]) : ResultTcBorrowPlace
  (match (ast-expr-unspan expr)
    [(AstExprVar name)
      (let
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-expr-id env name-text)
            [(OkTcExprId virtual-id)
              (tc-borrow-place ctx env (ast-node-get virtual-id))]
            [(ErrTcExprId message) (ErrTcBorrowPlace message)])
          (match (tc-lookup-visible-id ctx env name)
            [(OkTcType ty) (tc-borrow-place-var name-text ty)]
            [(ErrTcType message) (ErrTcBorrowPlace message)])))]
    [(AstExprStructGet receiver-box field)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (match (tc-borrow-place ctx env receiver)
          [(OkTcBorrowPlace place)
            (tc-borrow-place-struct-field ctx place (intern-str field))]
          [(ErrTcBorrowPlace message) (ErrTcBorrowPlace message)]))]
    [(AstExprTupleRef tuple-box index)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        (match (tc-borrow-place ctx env tuple)
          [(OkTcBorrowPlace place)
            (tc-borrow-place-tuple-field ctx place index)]
          [(ErrTcBorrowPlace message) (ErrTcBorrowPlace message)]))]
    [(AstExprArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-expr ctx env index)
          [(OkTcType index-ty)
            (if (tc-integer-type? index-ty)
              (match (tc-borrow-place ctx env array)
                [(OkTcBorrowPlace place)
                  (tc-borrow-place-array-element ctx place)]
                [(ErrTcBorrowPlace message) (ErrTcBorrowPlace message)])
              (ErrTcBorrowPlace "typecheck: array index must be integer"))]
          [(ErrTcType message) (ErrTcBorrowPlace message)]))]
    [(AstExprBoxGet box-box)
      (let
        [box-expr : AstExpr (ast-node-get box-box)]
        (match (tc-borrow-place ctx env box-expr)
          [(OkTcBorrowPlace place) (tc-borrow-place-box-get ctx place)]
          [(ErrTcBorrowPlace message) (ErrTcBorrowPlace message)]))]
    [_
      (ErrTcBorrowPlace
        "typecheck: borrow requires a local, parameter, or aggregate place")]))

(define (tc-mut-borrow-by-value-place-message) : String
  "typecheck: mutable borrow of by-value place is only supported as an immediate call argument")

(define (tc-mut-borrow-storage-backed-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstTyRef _ _) true]
    [(AstTyMutRef _ _) true]
    [(AstTyTuple _) true]
    [(AstTyArray _ _) true]
    [(AstTyDynArray _) true]
    [(AstTyStruct name)
      (not (tc-name-register-resident? ctx (intern-str name)))]
    [(AstTyStructArgs name _)
      (not (tc-name-register-resident? ctx (intern-str name)))]
    [(AstTyEnum name) (not (tc-name-register-resident? ctx (intern-str name)))]
    [(AstTyEnumArgs name _)
      (not (tc-name-register-resident? ctx (intern-str name)))]
    [_ false]))

(define (tc-mut-borrow-non-call-place-ok
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]) : ResultTcUnit
  (match (ast-expr-unspan expr)
    [(AstExprVar name)
      (match (tc-lookup-visible-id ctx env name)
        [(OkTcType ty)
          (if (tc-mut-borrow-storage-backed-type? ctx ty)
            OkTcUnit
            (ErrTcUnit (tc-mut-borrow-by-value-place-message)))]
        [(ErrTcType message) (ErrTcUnit message)])]
    [(AstExprStructGet receiver-box _)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (tc-mut-borrow-non-call-place-ok ctx env receiver))]
    [(AstExprTupleRef tuple-box _)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        (tc-mut-borrow-non-call-place-ok ctx env tuple))]
    [(AstExprArrayRef array-box _)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-mut-borrow-non-call-place-ok ctx env array))]
    [(AstExprBoxGet box-box)
      (let
        [box-expr : AstExpr (ast-node-get box-box)]
        (match (tc-store-place-lifetime ctx env box-expr)
          [(OkTcString _)
            (match (tc-expr ctx env box-expr)
              [(OkTcType box-ty)
                (match (tc-box-set-inner-type ctx box-ty)
                  [(OkTcType _) OkTcUnit]
                  [(ErrTcType message) (ErrTcUnit message)])]
              [(ErrTcType message) (ErrTcUnit message)])]
          [(ErrTcString message) (ErrTcUnit message)]))]
    [_ OkTcUnit]))

(define (tc-store-place-lifetime-var [name : String] [ty : AstType]) : ResultTcString
  (match (tc-type-outer-region ty)
    [(TcSomeString region) (OkTcString region)]
    [(TcNoString) (OkTcString name)]))

(define (tc-store-place-lifetime
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]) : ResultTcString
  (match (ast-expr-unspan expr)
    [(AstExprVar name)
      (let
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-expr-id env name-text)
            [(OkTcExprId virtual-id)
              (tc-store-place-lifetime ctx env (ast-node-get virtual-id))]
            [(ErrTcExprId message) (ErrTcString message)])
          (match (tc-lookup-visible-id ctx env name)
            [(OkTcType ty) (tc-store-place-lifetime-var name-text ty)]
            [(ErrTcType message) (ErrTcString message)])))]
    [(AstExprStructGet receiver-box _)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (tc-store-place-lifetime ctx env receiver))]
    [(AstExprTupleRef tuple-box _)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        (tc-store-place-lifetime ctx env tuple))]
    [(AstExprArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-expr ctx env index)
          [(OkTcType index-ty)
            (if (tc-integer-type? index-ty)
              (tc-store-place-lifetime ctx env array)
              (ErrTcString "typecheck: array index must be integer"))]
          [(ErrTcType message) (ErrTcString message)]))]
    [(AstExprBoxGet box-box)
      (let
        [box-expr : AstExpr (ast-node-get box-box)]
        (match (tc-expr ctx env box-expr)
          [(OkTcType box-ty)
            (match (tc-box-set-inner-type ctx box-ty)
              [(OkTcType _) (tc-store-place-lifetime ctx env box-expr)]
              [(ErrTcType message) (ErrTcString message)])]
          [(ErrTcType message) (ErrTcString message)]))]
    [_ (ErrTcString "typecheck: expression is not a storage place")]))

(define (tc-ensure-reference-value-can-store-in-place
  [ctx : TcContext]
  [env : TcTypeEnv]
  [place-expr : AstExpr]
  [value-ty : AstType]
  [context : String]) : ResultTcUnit
  (let
    [lifetimes : TcStringList (tc-type-collect-reference-lifetimes value-ty)]
    (match lifetimes
      [(TcStringNil) OkTcUnit]
      [_
        (match (tc-store-place-lifetime ctx env place-expr)
          [(OkTcString target-lifetime)
            (if (tc-reference-lifetimes-outlive-lifetime?
              env
              lifetimes
              target-lifetime)
              OkTcUnit
              (ErrTcUnit
                (string.string-append
                  "typecheck: cannot store reference into longer-lived "
                  (string.string-append
                    context
                    "; reference value would escape lexical scope"))))]
          [(ErrTcString _)
            (ErrTcUnit
              (string.string-append
                "typecheck: cannot store reference into non-place "
                (string.string-append
                  context
                  "; reference value would escape lexical scope")))])])))

(define (tc-borrow-place-result-type
  [mutable : bool]
  [lifetime : AstBorrowLifetime]
  [place : TcBorrowPlace]) : ResultTcType
  (match place
    [(TcBorrowPlace inferred referent-ty)
      (match lifetime
        [(AstBorrowLifetimeInferred)
          (OkTcType
            (if mutable
              (ast-ty-mut-ref inferred referent-ty)
              (ast-ty-ref inferred referent-ty)))]
        [(AstBorrowLifetimeNamed requested)
          (if (string.string-eq requested inferred)
            (OkTcType
              (if mutable
                (ast-ty-mut-ref inferred referent-ty)
                (ast-ty-ref inferred referent-ty)))
            (ErrTcType "typecheck: borrow lifetime mismatch"))])]))

(define (tc-borrow-expr-with-policy
  [ctx : TcContext]
  [env : TcTypeEnv]
  [mutable : bool]
  [lifetime : AstBorrowLifetime]
  [place-expr : AstExpr]
  [allow-mut-by-value-borrow : bool]) : ResultTcType
  (match (tc-borrow-place ctx env place-expr)
    [(OkTcBorrowPlace place)
      (if (and mutable (not allow-mut-by-value-borrow))
        (match (tc-mut-borrow-non-call-place-ok ctx env place-expr)
          [(OkTcUnit) (tc-borrow-place-result-type mutable lifetime place)]
          [(ErrTcUnit message) (ErrTcType message)])
        (tc-borrow-place-result-type mutable lifetime place))]
    [(ErrTcBorrowPlace message) (ErrTcType message)]))

(define (tc-borrow-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [mutable : bool]
  [lifetime : AstBorrowLifetime]
  [place-expr : AstExpr]) : ResultTcType
  (tc-borrow-expr-with-policy ctx env mutable lifetime place-expr false))

(define (tc-literal-pattern-compatible? [lit : AstLiteral] [scrut-ty : AstType]) : bool
  (let
    [lit-ty : AstType (tc-literal-type lit)]
    (match lit
      [(AstLitInt _ _) (tc-integer-type? scrut-ty)]
      [_ (tc-type-eq lit-ty scrut-ty)])))

(define (tc-bind-literal-pattern
  [env : TcTypeEnv]
  [lit : AstLiteral]
  [scrut-ty : AstType]) : ResultTcEnv
  (match (tc-literal-type-checked lit)
    [(OkTcType _)
      (if (tc-literal-pattern-compatible? lit scrut-ty)
        (OkTcEnv env)
        (ErrTcEnv "typecheck: literal pattern type mismatch"))]
    [(ErrTcType message) (ErrTcEnv message)]))

(define (tc-bind-scalar-match-pattern
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [pattern : AstPattern]) : ResultTcEnv
  (match pattern
    [(AstPatWildcard) (OkTcEnv env)]
    [(AstPatBinding name) (OkTcEnv (tc-bind-id env name scrut-ty))]
    [(AstPatLiteral lit) (tc-bind-literal-pattern env lit scrut-ty)]
    [(AstPatVariant name _)
      (if (tc-box-pattern-name? name)
        (ErrTcEnv "typecheck: box pattern requires Box scrutinee")
        (ErrTcEnv
          "typecheck: scalar match only supports literal, binding, or wildcard patterns"))]
    [_
      (ErrTcEnv
        "typecheck: scalar match only supports literal, binding, or wildcard patterns")]))

(define (tc-bind-sub-pattern-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [patterns : AstPatternList]
  [types : AstTypeList]) : ResultTcEnv
  (match patterns
    [(AstPatternNil)
      (match types
        [(AstTypeNil) (OkTcEnv env)]
        [_ (ErrTcEnv "typecheck: pattern arity mismatch")])]
    [(AstPatternCons pattern rest-patterns)
      (let
        [pattern : AstPattern (box-get pattern)]
        [rest-patterns : AstPatternList (box-get rest-patterns)]
        (match types
          [(AstTypeCons ty rest-types)
            (let
              [ty : AstType (ty-node-get ty)]
              [rest-types : AstTypeList (box-get rest-types)]
              (match (tc-bind-sub-pattern ctx env pattern ty)
                [(OkTcEnv next-env)
                  (tc-bind-sub-pattern-list
                    ctx
                    next-env
                    rest-patterns
                    rest-types)]
                [(ErrTcEnv message) (ErrTcEnv message)]))]
          [(AstTypeNil) (ErrTcEnv "typecheck: pattern arity mismatch")]))]))

(define (tc-nominal-owner-context [ctx : TcContext] [owner-name : String]) : TcContext
  (if (tc-name-qualified? owner-name)
    (tc-context-with-module ctx (tc-qualified-name-module owner-name))
    ctx))

(defenum ResultTcVariantPayloadTypes
  (OkTcVariantPayloadTypes AstTypeList)
  (ErrTcVariantPayloadTypes String))

(define (tc-variant-pattern-payload-types
  [ctx : TcContext]
  [enum-name : String]
  [enum-lifetimes : AstLifetimeList]
  [fields : AstTypeList]) : ResultTcVariantPayloadTypes
  (let
    [field-ctx : TcContext (tc-nominal-owner-context ctx enum-name)]
    [resolved-fields : AstTypeList (tc-resolve-type-list field-ctx fields)]
    (match enum-lifetimes
      [(AstLifetimeNil) (OkTcVariantPayloadTypes resolved-fields)]
      [_
        (match (tc-lifetime-subst-from-nominal-args
          field-ctx
          enum-name
          enum-lifetimes)
          [(OkTcLifetimeSubst subst)
            (OkTcVariantPayloadTypes
              (tc-lifetime-subst-type-list subst resolved-fields))]
          [(ErrTcLifetimeSubst message) (ErrTcVariantPayloadTypes message)])])))

(define (tc-bind-variant-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [variant-name : String]
  [enum-lifetimes : AstLifetimeList]
  [args : AstPatternList]
  [payload-region : TcMaybeString]) : ResultTcEnv
  (let
    [lookup-name : String
      (tc-source-variant-name-for-enum ctx enum-name variant-name)]
    (match (compiler-registries-lookup-variant
      (tc-context-registries ctx)
      lookup-name)
      [(SomeI64 handle)
        (match (tc-variant-owner-name ctx handle)
          [(OkTcString owner)
            (if (string.string-eq owner enum-name)
              (match (compiler-registries-variant-fields-indexed
                (tc-context-symbols ctx)
                handle)
                [(OkAstTypeList fields)
                  (match (tc-variant-pattern-payload-types
                    ctx
                    enum-name
                    enum-lifetimes
                    fields)
                    [(OkTcVariantPayloadTypes payload-fields)
                      (tc-bind-sub-pattern-list
                        ctx
                        env
                        args
                        (match payload-region
                          [(TcSomeString region)
                            (tc-tag-type-list-region region payload-fields)]
                          [(TcNoString) payload-fields]))]
                    [(ErrTcVariantPayloadTypes message) (ErrTcEnv message)])]
                [(ErrAstTypeList message) (ErrTcEnv message)])
              (ErrTcEnv
                (string.string-append
                  "typecheck: variant "
                  (string.string-append
                    variant-name
                    (string.string-append
                      " belongs to enum "
                      (string.string-append
                        owner
                        (string.string-append ", not " enum-name)))))))]
          [(ErrTcString message) (ErrTcEnv message)])]
      [(NoneI64)
        (ErrTcEnv
          (string.string-append "typecheck: unknown variant " variant-name))])))

(define (tc-box-pattern-name? [name : i64]) : bool
  (string.string-eq (intern-str name) "box"))

(define (tc-box-pattern-args-supported?
  [ctx : TcContext]
  [args : AstPatternList]
  [inner-ty : AstType]) : bool
  (match args
    [(AstPatternCons inner rest-box)
      (let
        [inner : AstPattern (box-get inner)]
        [rest : AstPatternList (box-get rest-box)]
        (match rest
          [(AstPatternNil) (tc-box-pattern-inner-supported? ctx inner inner-ty)]
          [_ false]))]
    [_ false]))

(define (tc-box-pattern-inner-supported?
  [ctx : TcContext]
  [pattern : AstPattern]
  [inner-ty : AstType]) : bool
  (match pattern
    [(AstPatWildcard) true]
    [(AstPatBinding _) true]
    [(AstPatVariant name args-box)
      (if (tc-box-pattern-name? name)
        (match (tc-type-strip-region (tc-resolve-type ctx inner-ty))
          [(AstTyBox nested-inner)
            (tc-box-pattern-args-supported?
              ctx
              (box-get args-box)
              (ty-node-get nested-inner))]
          [_ false])
        false)]
    [_ false]))

(define (tc-bind-box-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstPatternList]
  [inner-ty : AstType]) : ResultTcEnv
  (match args
    [(AstPatternCons inner rest-box)
      (let
        [inner : AstPattern (box-get inner)]
        [rest : AstPatternList (box-get rest-box)]
        (match rest
          [(AstPatternNil)
            (if (tc-box-pattern-inner-supported? ctx inner inner-ty)
              (tc-bind-sub-pattern ctx env inner inner-ty)
              (ErrTcEnv
                "typecheck: box pattern only supports irrefutable binding, wildcard, or nested box patterns"))]
          [_
            (ErrTcEnv
              "typecheck: box pattern expects exactly one inner pattern")]))]
    [_ (ErrTcEnv "typecheck: box pattern expects exactly one inner pattern")]))

(define (tc-struct-pattern-name-in-scrut-module
  [ctx : TcContext]
  [struct-name : String]
  [name : String]) : String
  (if (tc-name-qualified? name)
    (let
      [qualifier : String (tc-qualified-name-module name)]
      [base : String (tc-qualified-name-base name)]
      [target-module : String (tc-qualified-access-target-module ctx qualifier)]
      (compiler-symbol-module-key target-module base))
    (let
      [module : String (tc-qualified-name-module struct-name)]
      (if (string.string-eq module "")
        name
        (compiler-symbol-module-key module name)))))

(define (tc-source-struct-name-for-pattern
  [ctx : TcContext]
  [struct-name : String]
  [pattern-name : String]) : ResultTcString
  (if (tc-name-qualified? pattern-name)
    (let
      [qualifier : String (tc-qualified-name-module pattern-name)]
      [base : String (tc-qualified-name-base pattern-name)]
      [target-module : String (tc-qualified-access-target-module ctx qualifier)]
      (OkTcString (compiler-symbol-module-key target-module base)))
    (match (tc-source-type-name-lookup-key ctx pattern-name)
      [(OkTcString lookup-name)
        (OkTcString
          (tc-struct-pattern-name-in-scrut-module ctx struct-name lookup-name))]
      [(ErrTcString message) (ErrTcString message)])))

(define (tc-struct-pattern-name-matches?
  [ctx : TcContext]
  [struct-name : String]
  [pattern-name : String]) : bool
  (match (tc-source-struct-name-for-pattern ctx struct-name pattern-name)
    [(OkTcString lookup-name) (string.string-eq lookup-name struct-name)]
    [(ErrTcString _) false]))

(define (tc-struct-pattern-head-message
  [pattern-name : String]
  [struct-name : String]) : String
  (str_cat.str-cat
    "typecheck: struct pattern head "
    pattern-name
    " does not match struct "
    struct-name))

(define (tc-struct-pattern-field-types-for-scrut
  [ctx : TcContext]
  [struct-name : String]
  [scrut-ty : AstType]
  [fields : AstFieldDefList]) : ResultTcTypeList
  (let
    [field-types : AstTypeList (tc-field-type-list ctx fields)]
    [resolved-scrut-ty : AstType
      (tc-type-strip-region (tc-resolve-type ctx scrut-ty))]
    (match resolved-scrut-ty
      [(AstTyStructArgs _ lifetimes)
        (match (tc-lifetime-subst-from-nominal-args
          ctx
          struct-name
          (box-get lifetimes))
          [(OkTcLifetimeSubst subst)
            (OkTcTypeList
              (tc-project-type-list-from-region-container
                scrut-ty
                (tc-lifetime-subst-type-list subst field-types)))]
          [(ErrTcLifetimeSubst message) (ErrTcTypeList message)])]
      [(AstTyVarArgs _ lifetimes)
        (match (tc-lifetime-subst-from-nominal-args
          ctx
          struct-name
          (box-get lifetimes))
          [(OkTcLifetimeSubst subst)
            (OkTcTypeList
              (tc-project-type-list-from-region-container
                scrut-ty
                (tc-lifetime-subst-type-list subst field-types)))]
          [(ErrTcLifetimeSubst message) (ErrTcTypeList message)])]
      [_
        (OkTcTypeList
          (tc-project-type-list-from-region-container scrut-ty field-types))])))

(define (tc-bind-struct-field-pattern-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [patterns : AstPatternList]
  [types : AstTypeList]) : ResultTcEnv
  (match patterns
    [(AstPatternNil)
      (match types
        [(AstTypeNil) (OkTcEnv env)]
        [_ (ErrTcEnv "typecheck: pattern arity mismatch")])]
    [(AstPatternCons pattern rest-patterns)
      (let
        [pattern : AstPattern (box-get pattern)]
        [rest-patterns : AstPatternList (box-get rest-patterns)]
        (match types
          [(AstTypeCons ty rest-types)
            (let
              [ty : AstType (ty-node-get ty)]
              [rest-types : AstTypeList (box-get rest-types)]
              (match (tc-bind-struct-field-pattern ctx env pattern ty)
                [(OkTcEnv next-env)
                  (tc-bind-struct-field-pattern-list
                    ctx
                    next-env
                    rest-patterns
                    rest-types)]
                [(ErrTcEnv message) (ErrTcEnv message)]))]
          [(AstTypeNil) (ErrTcEnv "typecheck: pattern arity mismatch")]))]))

(define (tc-bind-struct-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [scrut-ty : AstType]
  [pattern-name : String]
  [args : AstPatternList]) : ResultTcEnv
  (match (tc-source-struct-name-for-pattern ctx struct-name pattern-name)
    [(OkTcString lookup-name)
      (if (string.string-eq lookup-name struct-name)
        (match (tc-struct-decl ctx struct-name)
          [(OkTcStructDecl decl)
            (match decl
              [(TcStructDecl _ _ fields)
                (match (tc-struct-pattern-field-types-for-scrut
                  ctx
                  struct-name
                  scrut-ty
                  fields)
                  [(OkTcTypeList field-types)
                    (tc-bind-struct-field-pattern-list ctx env args field-types)]
                  [(ErrTcTypeList message) (ErrTcEnv message)])])]
          [(ErrTcStructDecl message) (ErrTcEnv message)])
        (ErrTcEnv (tc-struct-pattern-head-message pattern-name struct-name)))]
    [(ErrTcString message) (ErrTcEnv message)]))

(define (tc-bind-struct-field-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [pattern : AstPattern]
  [field-ty : AstType]) : ResultTcEnv
  (let
    [ty : AstType (tc-resolve-type ctx field-ty)]
    (match pattern
      [(AstPatVar name _) (OkTcEnv (tc-bind-id env name ty))]
      [(AstPatBinding name) (OkTcEnv (tc-bind-id env name ty))]
      [(AstPatWildcard) (OkTcEnv env)]
      [(AstPatVariant name args-box)
        (let
          [args : AstPatternList (box-get args-box)]
          (match (tc-type-strip-region ty)
            [(AstTyStruct struct-name)
              (tc-bind-struct-pattern
                ctx
                env
                (intern-str struct-name)
                ty
                (intern-str name)
                args)]
            [(AstTyStructArgs struct-name _)
              (tc-bind-struct-pattern
                ctx
                env
                (intern-str struct-name)
                ty
                (intern-str name)
                args)]
            [_
              (ErrTcEnv
                "typecheck: struct field pattern only supports binding, wildcard, or nested struct patterns")]))]
      [_
        (ErrTcEnv
          "typecheck: struct field pattern only supports binding, wildcard, or nested struct patterns")])))

(define (tc-bind-sub-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [pattern : AstPattern]
  [field-ty : AstType]) : ResultTcEnv
  (let
    [ty : AstType (tc-resolve-type ctx field-ty)]
    (match pattern
      [(AstPatBinding name) (OkTcEnv (tc-bind-id env name ty))]
      [(AstPatWildcard) (OkTcEnv env)]
      [(AstPatLiteral lit) (tc-bind-literal-pattern env lit ty)]
      [(AstPatVariant name args-box)
        (let
          [args : AstPatternList (box-get args-box)]
          (match (tc-type-strip-region ty)
            [(AstTyExpr)
              (tc-bind-expr-variant-pattern ctx env (intern-str name) args)]
            [(AstTyEnum enum-name)
              (tc-bind-variant-pattern
                ctx
                env
                (intern-str enum-name)
                (intern-str name)
                AstLifetimeNil
                args
                (tc-type-outer-region ty))]
            [(AstTyEnumArgs enum-name lifetimes)
              (tc-bind-variant-pattern
                ctx
                env
                (intern-str enum-name)
                (intern-str name)
                (box-get lifetimes)
                args
                (tc-type-outer-region ty))]
            [(AstTyStruct struct-name)
              (tc-bind-struct-pattern
                ctx
                env
                (intern-str struct-name)
                ty
                (intern-str name)
                args)]
            [(AstTyStructArgs struct-name _)
              (tc-bind-struct-pattern
                ctx
                env
                (intern-str struct-name)
                ty
                (intern-str name)
                args)]
            [(AstTyBox inner-ty)
              (if (tc-box-pattern-name? name)
                (tc-bind-box-pattern ctx env args (ty-node-get inner-ty))
                (ErrTcEnv
                  "typecheck: nested variant pattern requires enum field"))]
            [_
              (if (tc-box-pattern-name? name)
                (ErrTcEnv "typecheck: box pattern requires Box field")
                (ErrTcEnv
                  "typecheck: nested variant pattern requires enum field"))]))]
      [_ (ErrTcEnv "typecheck: unsupported nested match pattern")])))

(define (tc-borrowed-field-ref-type [lifetime : String] [field-ty : AstType]) : AstType
  (ast-ty-ref lifetime (tc-borrow-referent-type field-ty)))

(define (tc-bind-borrowed-sub-pattern-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [lifetime : String]
  [patterns : AstPatternList]
  [types : AstTypeList]) : ResultTcEnv
  (match patterns
    [(AstPatternNil)
      (match types
        [(AstTypeNil) (OkTcEnv env)]
        [_ (ErrTcEnv "typecheck: pattern arity mismatch")])]
    [(AstPatternCons pattern rest-patterns)
      (let
        [pattern : AstPattern (box-get pattern)]
        [rest-patterns : AstPatternList (box-get rest-patterns)]
        (match types
          [(AstTypeCons ty rest-types)
            (let
              [ty : AstType (ty-node-get ty)]
              [rest-types : AstTypeList (box-get rest-types)]
              (match (tc-bind-borrowed-sub-pattern ctx env lifetime pattern ty)
                [(OkTcEnv next-env)
                  (tc-bind-borrowed-sub-pattern-list
                    ctx
                    next-env
                    lifetime
                    rest-patterns
                    rest-types)]
                [(ErrTcEnv message) (ErrTcEnv message)]))]
          [(AstTypeNil) (ErrTcEnv "typecheck: pattern arity mismatch")]))]))

(define (tc-bind-borrowed-variant-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [lifetime : String]
  [enum-name : String]
  [variant-name : String]
  [enum-lifetimes : AstLifetimeList]
  [args : AstPatternList]) : ResultTcEnv
  (let
    [lookup-name : String
      (tc-source-variant-name-for-enum ctx enum-name variant-name)]
    (match (compiler-registries-lookup-variant
      (tc-context-registries ctx)
      lookup-name)
      [(SomeI64 handle)
        (match (tc-variant-owner-name ctx handle)
          [(OkTcString owner)
            (if (string.string-eq owner enum-name)
              (match (compiler-registries-variant-fields-indexed
                (tc-context-symbols ctx)
                handle)
                [(OkAstTypeList fields)
                  (match (tc-variant-pattern-payload-types
                    ctx
                    enum-name
                    enum-lifetimes
                    fields)
                    [(OkTcVariantPayloadTypes payload-fields)
                      (tc-bind-borrowed-sub-pattern-list
                        ctx
                        env
                        lifetime
                        args
                        payload-fields)]
                    [(ErrTcVariantPayloadTypes message) (ErrTcEnv message)])]
                [(ErrAstTypeList message) (ErrTcEnv message)])
              (ErrTcEnv
                (string.string-append
                  "typecheck: variant "
                  (string.string-append
                    variant-name
                    (string.string-append
                      " belongs to enum "
                      (string.string-append
                        owner
                        (string.string-append ", not " enum-name)))))))]
          [(ErrTcString message) (ErrTcEnv message)])]
      [(NoneI64)
        (ErrTcEnv
          (string.string-append "typecheck: unknown variant " variant-name))])))

(define (tc-bind-borrowed-sub-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [lifetime : String]
  [pattern : AstPattern]
  [field-ty : AstType]) : ResultTcEnv
  (let
    [ty : AstType (tc-resolve-type ctx field-ty)]
    (match pattern
      [(AstPatBinding name)
        (OkTcEnv (tc-bind-id env name (tc-borrowed-field-ref-type lifetime ty)))]
      [(AstPatWildcard) (OkTcEnv env)]
      [(AstPatLiteral lit) (tc-bind-literal-pattern env lit ty)]
      [(AstPatVariant name args-box)
        (let
          [args : AstPatternList (box-get args-box)]
          (match (tc-type-strip-region ty)
            [(AstTyEnum enum-name)
              (tc-bind-borrowed-variant-pattern
                ctx
                env
                lifetime
                (intern-str enum-name)
                (intern-str name)
                AstLifetimeNil
                args)]
            [(AstTyEnumArgs enum-name lifetimes)
              (tc-bind-borrowed-variant-pattern
                ctx
                env
                lifetime
                (intern-str enum-name)
                (intern-str name)
                (box-get lifetimes)
                args)]
            [(AstTyBox _)
              (if (tc-box-pattern-name? name)
                (ErrTcEnv "typecheck: borrowed box patterns are not supported")
                (ErrTcEnv
                  "typecheck: nested variant pattern requires enum field"))]
            [_
              (if (tc-box-pattern-name? name)
                (ErrTcEnv "typecheck: box pattern requires Box field")
                (ErrTcEnv
                  "typecheck: nested variant pattern requires enum field"))]))]
      [_ (ErrTcEnv "typecheck: unsupported nested match pattern")])))

(define (tc-bind-borrowed-enum-match-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [lifetime : String]
  [enum-name : String]
  [enum-lifetimes : AstLifetimeList]
  [pattern : AstPattern]) : ResultTcEnv
  (match pattern
    [(AstPatWildcard) (OkTcEnv env)]
    [(AstPatBinding variant-name)
      (tc-bind-borrowed-variant-pattern
        ctx
        env
        lifetime
        enum-name
        (intern-str variant-name)
        enum-lifetimes
        AstPatternNil)]
    [(AstPatVariant variant-name args-box)
      (let
        [args : AstPatternList (box-get args-box)]
        (tc-bind-borrowed-variant-pattern
          ctx
          env
          lifetime
          enum-name
          (intern-str variant-name)
          enum-lifetimes
          args))]
    [_ (ErrTcEnv "typecheck: unsupported enum match pattern")]))

(define (tc-bind-match-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [pattern : AstPattern]) : ResultTcEnv
  (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
    [(AstTyRef lifetime referent-box)
      (let
        [referent-ty : AstType
          (tc-type-strip-region
            (tc-resolve-type ctx (ty-node-get referent-box)))]
        (match referent-ty
          [(AstTyEnum enum-name)
            (tc-bind-borrowed-enum-match-pattern
              ctx
              env
              lifetime
              (intern-str enum-name)
              AstLifetimeNil
              pattern)]
          [(AstTyEnumArgs enum-name lifetimes)
            (tc-bind-borrowed-enum-match-pattern
              ctx
              env
              lifetime
              (intern-str enum-name)
              (box-get lifetimes)
              pattern)]
          [(AstTyBox _)
            (match pattern
              [(AstPatWildcard) (OkTcEnv env)]
              [(AstPatBinding name) (OkTcEnv (tc-bind-id env name scrut-ty))]
              [(AstPatLiteral lit) (tc-bind-literal-pattern env lit scrut-ty)]
              [(AstPatVariant name _)
                (if (tc-box-pattern-name? name)
                  (ErrTcEnv
                    "typecheck: borrowed box patterns are not supported")
                  (ErrTcEnv
                    "typecheck: scalar match only supports literal, binding, or wildcard patterns"))]
              [_
                (ErrTcEnv
                  "typecheck: scalar match only supports literal, binding, or wildcard patterns")])]
          [_ (tc-bind-scalar-match-pattern env scrut-ty pattern)]))]
    [(AstTyEnum enum-name)
      (match pattern
        [(AstPatWildcard) (OkTcEnv env)]
        [(AstPatBinding variant-name)
          (tc-bind-variant-pattern
            ctx
            env
            (intern-str enum-name)
            (intern-str variant-name)
            AstLifetimeNil
            AstPatternNil
            (tc-type-outer-region scrut-ty))]
        [(AstPatVariant variant-name args-box)
          (let
            [args : AstPatternList (box-get args-box)]
            (tc-bind-variant-pattern
              ctx
              env
              (intern-str enum-name)
              (intern-str variant-name)
              AstLifetimeNil
              args
              (tc-type-outer-region scrut-ty)))]
        [_ (ErrTcEnv "typecheck: unsupported enum match pattern")])]
    [(AstTyEnumArgs enum-name lifetimes)
      (match pattern
        [(AstPatWildcard) (OkTcEnv env)]
        [(AstPatBinding variant-name)
          (tc-bind-variant-pattern
            ctx
            env
            (intern-str enum-name)
            (intern-str variant-name)
            (box-get lifetimes)
            AstPatternNil
            (tc-type-outer-region scrut-ty))]
        [(AstPatVariant variant-name args-box)
          (let
            [args : AstPatternList (box-get args-box)]
            (tc-bind-variant-pattern
              ctx
              env
              (intern-str enum-name)
              (intern-str variant-name)
              (box-get lifetimes)
              args
              (tc-type-outer-region scrut-ty)))]
        [_ (ErrTcEnv "typecheck: unsupported enum match pattern")])]
    [(AstTyStruct struct-name)
      (match pattern
        [(AstPatWildcard) (OkTcEnv env)]
        [(AstPatBinding name) (OkTcEnv (tc-bind-id env name scrut-ty))]
        [(AstPatVariant pattern-name args-box)
          (tc-bind-struct-pattern
            ctx
            env
            (intern-str struct-name)
            scrut-ty
            (intern-str pattern-name)
            (box-get args-box))]
        [_
          (ErrTcEnv
            "typecheck: struct match only supports constructor-shaped, binding, or wildcard patterns")])]
    [(AstTyStructArgs struct-name _)
      (match pattern
        [(AstPatWildcard) (OkTcEnv env)]
        [(AstPatBinding name) (OkTcEnv (tc-bind-id env name scrut-ty))]
        [(AstPatVariant pattern-name args-box)
          (tc-bind-struct-pattern
            ctx
            env
            (intern-str struct-name)
            scrut-ty
            (intern-str pattern-name)
            (box-get args-box))]
        [_
          (ErrTcEnv
            "typecheck: struct match only supports constructor-shaped, binding, or wildcard patterns")])]
    [(AstTyExpr) (tc-bind-expr-match-pattern ctx env pattern)]
    [(AstTyVar name)
      (if (= name (intern "ExprClause"))
        (tc-bind-expr-clause-match-pattern ctx env pattern)
        (tc-bind-scalar-match-pattern env scrut-ty pattern))]
    [(AstTyBox inner-ty)
      (match pattern
        [(AstPatWildcard) (OkTcEnv env)]
        [(AstPatBinding name) (OkTcEnv (tc-bind-id env name scrut-ty))]
        [(AstPatLiteral lit) (tc-bind-literal-pattern env lit scrut-ty)]
        [(AstPatVariant name args-box)
          (let
            [args : AstPatternList (box-get args-box)]
            (if (tc-box-pattern-name? name)
              (tc-bind-box-pattern ctx env args (ty-node-get inner-ty))
              (ErrTcEnv
                "typecheck: Box match only supports (box ...), binding, or wildcard patterns")))]
        [_ (ErrTcEnv "typecheck: unsupported Box match pattern")])]
    [_ (tc-bind-scalar-match-pattern env scrut-ty pattern)]))

(define (tc-match-arm-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [arm : AstMatchArm]) : ResultTcType
  (match arm
    [(AstMatchArm pattern body-box)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (match (tc-bind-match-pattern ctx env scrut-ty pattern)
          [(OkTcEnv arm-env) (tc-expr ctx arm-env body)]
          [(ErrTcEnv message) (ErrTcType message)]))]))

(define (tc-match-arm-type-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [arm : AstMatchArm]
  [expected : AstType]) : ResultTcType
  (match arm
    [(AstMatchArm pattern body-box)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (match (tc-bind-match-pattern ctx env scrut-ty pattern)
          [(OkTcEnv arm-env)
            (match (tc-expr-with-expected-or-actual ctx arm-env body expected)
              [(OkTcType got)
                (match (tc-expect
                  got
                  expected
                  "typecheck: match arm result type mismatch")
                  [(OkTcUnit) (OkTcType expected)]
                  [(ErrTcUnit message) (ErrTcType message)])]
              [(ErrTcType message) (ErrTcType message)])]
          [(ErrTcEnv message) (ErrTcType message)]))]))

(define (tc-check-match-arm-types-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [expected : AstType]) : ResultTcType
  (match arms
    [(AstMatchArmNil) (ErrTcType "typecheck: match must have at least one arm")]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match (tc-match-arm-type-with-expected ctx env scrut-ty arm expected)
          [(OkTcType _)
            (match rest
              [(AstMatchArmNil) (OkTcType expected)]
              [_
                (tc-check-match-arm-types-with-expected
                  ctx
                  env
                  scrut-ty
                  rest
                  expected)])]
          [(ErrTcType message) (ErrTcType message)]))]))

(define (tc-match-rest-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [want : AstType]) : ResultTcType
  (match arms
    [(AstMatchArmNil) (OkTcType want)]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match (tc-match-arm-type-with-expected ctx env scrut-ty arm want)
          [(OkTcType _) (tc-match-rest-types ctx env scrut-ty rest want)]
          [(ErrTcType _)
            (match (tc-match-arm-type ctx env scrut-ty arm)
              [(OkTcType got)
                (match (tc-merge-branch-type want got)
                  [(OkTcType merged)
                    (tc-match-rest-types ctx env scrut-ty rest merged)]
                  [(ErrTcType _)
                    (ErrTcType (tc-match-arm-merge-message want got))])]
              [(ErrTcType message) (ErrTcType message)])]))]))

(define (tc-check-match-arm-types-from-first
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [first-arm : AstMatchArm]
  [rest : AstMatchArmList]
  [first-ty : AstType]) : ResultTcType
  (match rest
    [(AstMatchArmNil) (OkTcType first-ty)]
    [(AstMatchArmCons second-arm remaining-box)
      (let
        [remaining : AstMatchArmList (box-get remaining-box)]
        (match (tc-match-arm-type ctx env scrut-ty second-arm)
          [(OkTcType second-ty)
            (match (tc-merge-branch-type first-ty second-ty)
              [(OkTcType merged)
                (tc-match-rest-types ctx env scrut-ty remaining merged)]
              [(ErrTcType _)
                (match (tc-match-arm-type-with-expected
                  ctx
                  env
                  scrut-ty
                  first-arm
                  second-ty)
                  [(OkTcType _)
                    (tc-match-rest-types ctx env scrut-ty remaining second-ty)]
                  [(ErrTcType _)
                    (match (tc-match-arm-type-with-expected
                      ctx
                      env
                      scrut-ty
                      second-arm
                      first-ty)
                      [(OkTcType _)
                        (tc-match-rest-types
                          ctx
                          env
                          scrut-ty
                          remaining
                          first-ty)]
                      [(ErrTcType _)
                        (ErrTcType
                          (tc-match-arm-merge-message first-ty second-ty))])])])]
          [(ErrTcType message) (ErrTcType message)]))]))

(define (tc-check-match-arm-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : ResultTcType
  (match arms
    [(AstMatchArmNil) (ErrTcType "typecheck: match must have at least one arm")]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match (tc-match-arm-type ctx env scrut-ty arm)
          [(OkTcType first-ty)
            (tc-check-match-arm-types-from-first
              ctx
              env
              scrut-ty
              arm
              rest
              first-ty)]
          [(ErrTcType message) (ErrTcType message)]))]))

(define (tc-qualified-name-last-slash [name : String]) : i64
  (intern-name-last-slash name))

(define (tc-qualified-name-module [name : String]) : String
  (intern-name-module name))

(define (tc-qualified-name-base [name : String]) : String
  (intern-name-base name))

(define (tc-qualified-variant-name [enum-name : String] [variant-name : String]) : String
  (let
    [module : String (tc-qualified-name-module enum-name)]
    [enum-base : String (tc-qualified-name-base enum-name)]
    [qualified-variant : String
      (compiler-enum-qualified-variant-name enum-base variant-name)]
    (compiler-symbol-module-key module qualified-variant)))

(define (tc-variant-name-for-enum [enum-name : String] [variant-name : String]) : String
  (if (tc-name-qualified? variant-name)
    variant-name
    (tc-qualified-variant-name enum-name variant-name)))

(define (tc-source-variant-name-for-enum
  [ctx : TcContext]
  [enum-name : String]
  [variant-name : String]) : String
  (if (tc-name-qualified? variant-name)
    variant-name
    (if (>= (tc-name-first-dot variant-name) 0)
      (match (tc-dotted-type-name-lookup-key ctx variant-name)
        [(OkTcString lookup-name) lookup-name]
        [(ErrTcString _)
          (match (tc-enum-qualified-variant-lookup-key ctx variant-name)
            [(OkTcString lookup-name) lookup-name]
            [(ErrTcString _) variant-name])])
      (match (compiler-registries-lookup-variant
        (tc-context-registries ctx)
        variant-name)
        [(SomeI64 handle)
          (match (tc-variant-owner-name ctx handle)
            [(OkTcString owner)
              (if (string.string-eq owner enum-name)
                variant-name
                (tc-qualified-variant-name enum-name variant-name))]
            [(ErrTcString _) (tc-qualified-variant-name enum-name variant-name)])]
        [(NoneI64) (tc-qualified-variant-name enum-name variant-name)]))))

(define (tc-variant-name-matches?
  [ctx : TcContext]
  [enum-name : String]
  [pattern-name : String]
  [variant-name : String]) : bool
  (if (string.string-eq pattern-name variant-name)
    true
    (if (and
      (< (tc-name-first-dot pattern-name) 0)
      (not (tc-name-qualified? pattern-name)))
      false
      (let
        [pattern-key : String
          (tc-source-variant-name-for-enum ctx enum-name pattern-name)]
        [candidate-key : String
          (tc-source-variant-name-for-enum ctx enum-name variant-name)]
        (match (compiler-registries-lookup-variant
          (tc-context-registries ctx)
          pattern-key)
          [(SomeI64 pattern-handle)
            (match (compiler-registries-lookup-variant
              (tc-context-registries ctx)
              candidate-key)
              [(SomeI64 candidate-handle) (= pattern-handle candidate-handle)]
              [(NoneI64) false])]
          [(NoneI64) false])))))

(define (tc-expr-pattern-enum-name) : String
  (tc-stdlib-comptime-type-key "Expr"))

(define (tc-expr-variant-pattern-name?
  [ctx : TcContext]
  [pattern-name : String]
  [variant-name : String]) : bool
  (tc-variant-name-matches?
    ctx
    (tc-expr-pattern-enum-name)
    pattern-name
    variant-name))

(define (tc-expr-variant-payload-types
  [ctx : TcContext]
  [variant-name : String]) : ResultTcTypeList
  (cond
    [(tc-expr-variant-pattern-name? ctx variant-name "ExprBool")
      (OkTcTypeList (tc-type-list1 (AstTyBool)))]
    [(tc-expr-variant-pattern-name? ctx variant-name "ExprInt")
      (OkTcTypeList (tc-type-list1 (AstTyI64)))]
    [(tc-expr-variant-pattern-name? ctx variant-name "ExprVar")
      (OkTcTypeList (tc-type-list1 (AstTyString)))]
    [(tc-expr-variant-pattern-name? ctx variant-name "ExprSplice")
      (OkTcTypeList (tc-type-list1 (AstTyExpr)))]
    [(tc-expr-variant-pattern-name? ctx variant-name "ExprIf")
      (OkTcTypeList (tc-type-list3 (AstTyExpr) (AstTyExpr) (AstTyExpr)))]
    [(tc-expr-variant-pattern-name? ctx variant-name "ExprCall")
      (OkTcTypeList (tc-type-list2 (AstTyExpr) (AstTyExprList)))]
    [(tc-expr-variant-pattern-name? ctx variant-name "ExprBegin")
      (OkTcTypeList (tc-type-list1 (AstTyExprList)))]
    [(tc-expr-variant-pattern-name? ctx variant-name "ExprQuote")
      (OkTcTypeList (tc-type-list1 (AstTyExpr)))]
    [(tc-expr-variant-pattern-name? ctx variant-name "ExprQuasiquote")
      (OkTcTypeList (tc-type-list1 (AstTyExpr)))]
    [(tc-expr-variant-pattern-name? ctx variant-name "ExprUnquote")
      (OkTcTypeList (tc-type-list1 (AstTyExpr)))]
    [(tc-expr-variant-pattern-name? ctx variant-name "ExprUnquoteSplicing")
      (OkTcTypeList (tc-type-list1 (AstTyExpr)))]
    [else
      (ErrTcTypeList
        (str_cat.str-cat "typecheck: unknown Expr variant " variant-name))]))

(define (tc-bind-expr-variant-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [variant-name : String]
  [args : AstPatternList]) : ResultTcEnv
  (match (tc-expr-variant-payload-types ctx variant-name)
    [(OkTcTypeList payloads) (tc-bind-sub-pattern-list ctx env args payloads)]
    [(ErrTcTypeList message) (ErrTcEnv message)]))

(define (tc-bind-expr-match-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [pattern : AstPattern]) : ResultTcEnv
  (match pattern
    [(AstPatWildcard) (OkTcEnv env)]
    [(AstPatBinding name) (OkTcEnv (tc-bind-id env name (AstTyExpr)))]
    [(AstPatVariant variant-name args-box)
      (let
        [args : AstPatternList (box-get args-box)]
        (tc-bind-expr-variant-pattern ctx env (intern-str variant-name) args))]
    [_ (ErrTcEnv "typecheck: unsupported Expr match pattern")]))

(define (tc-expr-clause-pattern-name? [name : i64]) : bool
  (= name (intern "ExprClause")))

(define (tc-bind-expr-clause-match-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [pattern : AstPattern]) : ResultTcEnv
  (match pattern
    [(AstPatWildcard) (OkTcEnv env)]
    [(AstPatBinding name)
      (OkTcEnv (tc-bind-id env name (tc-macro-expr-clause-type)))]
    [(AstPatVariant variant-name args-box)
      (if (tc-expr-clause-pattern-name? variant-name)
        (tc-bind-sub-pattern-list
          ctx
          env
          (box-get args-box)
          (tc-type-list2 (AstTyExpr) (AstTyExpr)))
        (ErrTcEnv
          (str_cat.str-cat
            "typecheck: unknown ExprClause constructor "
            (intern-str variant-name))))]
    [_ (ErrTcEnv "typecheck: unsupported ExprClause match pattern")]))

(define (tc-expr-clause-pattern-irrefutable?
  [ctx : TcContext]
  [pattern : AstPattern]) : bool
  (match pattern
    [(AstPatWildcard) true]
    [(AstPatBinding _) true]
    [(AstPatVariant name args-box)
      (if (tc-expr-clause-pattern-name? name)
        (tc-pattern-list-irrefutable?
          ctx
          (box-get args-box)
          (tc-type-list2 (AstTyExpr) (AstTyExpr)))
        false)]
    [_ false]))

(define (tc-enum-has-single-variant?
  [ctx : TcContext]
  [variants : AstVariantDefList]
  [enum-name : String]
  [variant-name : String]) : bool
  (match variants
    [(AstVariantDefCons variant rest)
      (let
        [rest : AstVariantDefList (box-get rest)]
        (match rest
          [(AstVariantDefNil)
            (match variant
              [(AstVariantDef name _ _)
                (tc-variant-name-matches?
                  ctx
                  enum-name
                  variant-name
                  (intern-str name))])]
          [_ false]))]
    [_ false]))

(define (tc-enum-single-matching-variant-name
  [ctx : TcContext]
  [variants : AstVariantDefList]
  [enum-name : String]
  [pattern-name : String]) : TcMaybeString
  (match variants
    [(AstVariantDefCons variant rest)
      (let
        [rest : AstVariantDefList (box-get rest)]
        (match rest
          [(AstVariantDefNil)
            (match variant
              [(AstVariantDef name _ _)
                (let
                  [variant-name : String (intern-str name)]
                  (if (tc-variant-name-matches?
                    ctx
                    enum-name
                    pattern-name
                    variant-name)
                    (TcSomeString variant-name)
                    (TcNoString)))])]
          [_ (TcNoString)]))]
    [_ (TcNoString)]))

(define (tc-variant-pattern-irrefutable?
  [ctx : TcContext]
  [enum-name : String]
  [variant-name : String]
  [args : AstPatternList]) : bool
  (let
    [lookup-name : String
      (tc-source-variant-name-for-enum ctx enum-name variant-name)]
    (match (compiler-registries-lookup-variant
      (tc-context-registries ctx)
      lookup-name)
      [(SomeI64 handle)
        (match (compiler-registries-variant-fields-indexed
          (tc-context-symbols ctx)
          handle)
          [(OkAstTypeList fields)
            (tc-pattern-list-irrefutable? ctx args fields)]
          [(ErrAstTypeList _) false])]
      [(NoneI64) false])))

(define (tc-struct-pattern-irrefutable?
  [ctx : TcContext]
  [struct-name : String]
  [scrut-ty : AstType]
  [pattern-name : String]
  [args : AstPatternList]) : bool
  (if (tc-struct-pattern-name-matches? ctx struct-name pattern-name)
    (match (tc-struct-decl ctx struct-name)
      [(OkTcStructDecl decl)
        (match decl
          [(TcStructDecl _ _ fields)
            (match (tc-struct-pattern-field-types-for-scrut
              ctx
              struct-name
              scrut-ty
              fields)
              [(OkTcTypeList field-types)
                (tc-pattern-list-irrefutable? ctx args field-types)]
              [(ErrTcTypeList _) false])])]
      [(ErrTcStructDecl _) false])
    false))

(define (tc-sub-pattern-irrefutable?
  [ctx : TcContext]
  [pattern : AstPattern]
  [field-ty : AstType]) : bool
  (match pattern
    [(AstPatWildcard) true]
    [(AstPatVar _ _) true]
    [(AstPatBinding _) true]
    [(AstPatLiteral _) false]
    [(AstPatVariant name args-box)
      (let
        [args : AstPatternList (box-get args-box)]
        (match (tc-type-strip-region (tc-resolve-type ctx field-ty))
          [(AstTyEnum enum-name)
            (let
              [enum-name-str : String (intern-str enum-name)]
              (match (tc-context-enum-variants ctx enum-name-str)
                [(OkAstVariantDefList variants)
                  (match (tc-enum-single-matching-variant-name
                    ctx
                    variants
                    enum-name-str
                    (intern-str name))
                    [(TcSomeString variant-name)
                      (tc-variant-pattern-irrefutable?
                        ctx
                        enum-name-str
                        variant-name
                        args)]
                    [(TcNoString) false])]
                [(ErrAstVariantDefList _) false]))]
          [(AstTyEnumArgs enum-name _)
            (let
              [enum-name-str : String (intern-str enum-name)]
              (match (tc-program-enum-variants
                (tc-context-program ctx)
                enum-name-str)
                [(OkAstVariantDefList variants)
                  (match (tc-enum-single-matching-variant-name
                    ctx
                    variants
                    enum-name-str
                    (intern-str name))
                    [(TcSomeString variant-name)
                      (tc-variant-pattern-irrefutable?
                        ctx
                        enum-name-str
                        variant-name
                        args)]
                    [(TcNoString) false])]
                [(ErrAstVariantDefList _) false]))]
          [(AstTyStruct struct-name)
            (tc-struct-pattern-irrefutable?
              ctx
              (intern-str struct-name)
              field-ty
              (intern-str name)
              args)]
          [(AstTyStructArgs struct-name _)
            (tc-struct-pattern-irrefutable?
              ctx
              (intern-str struct-name)
              field-ty
              (intern-str name)
              args)]
          [(AstTyBox inner-ty)
            (if (tc-box-pattern-name? name)
              (tc-box-pattern-args-supported? ctx args (ty-node-get inner-ty))
              false)]
          [_ false]))]
    [_ false]))

(define (tc-pattern-list-irrefutable?
  [ctx : TcContext]
  [patterns : AstPatternList]
  [types : AstTypeList]) : bool
  (match patterns
    [(AstPatternNil)
      (match types
        [(AstTypeNil) true]
        [_ false])]
    [(AstPatternCons pattern rest)
      (let
        [pattern : AstPattern (box-get pattern)]
        [rest : AstPatternList (box-get rest)]
        (match types
          [(AstTypeCons ty rest-types)
            (let
              [ty : AstType (ty-node-get ty)]
              [rest-types : AstTypeList (box-get rest-types)]
              (if (tc-sub-pattern-irrefutable? ctx pattern ty)
                (tc-pattern-list-irrefutable? ctx rest rest-types)
                false))]
          [(AstTypeNil) false]))]))

(define (tc-pattern-covers-variant?
  [ctx : TcContext]
  [pattern : AstPattern]
  [enum-name : String]
  [variant-name : String]) : bool
  (match pattern
    [(AstPatWildcard) true]
    [(AstPatBinding name)
      (tc-variant-name-matches? ctx enum-name (intern-str name) variant-name)]
    [(AstPatVariant name args-box)
      (let
        [args : AstPatternList (box-get args-box)]
        (and
          (tc-variant-name-matches?
            ctx
            enum-name
            (intern-str name)
            variant-name)
          (tc-variant-pattern-irrefutable? ctx enum-name variant-name args)))]
    [_ false]))

(define (tc-match-arms-cover-variant?
  [ctx : TcContext]
  [arms : AstMatchArmList]
  [enum-name : String]
  [variant-name : String]) : bool
  (match arms
    [(AstMatchArmNil) false]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm pattern _)
            (if (tc-pattern-covers-variant? ctx pattern enum-name variant-name)
              true
              (tc-match-arms-cover-variant? ctx rest enum-name variant-name))]))]))

(define (tc-match-missing-variant-message [variant-name : String]) : String
  (string.string-append
    "typecheck: match missing arm for variant "
    variant-name))

(define (tc-pattern-mentions-variant?
  [ctx : TcContext]
  [pattern : AstPattern]
  [enum-name : String]
  [variant-name : String]) : bool
  (match pattern
    [(AstPatBinding name)
      (tc-variant-name-matches? ctx enum-name (intern-str name) variant-name)]
    [(AstPatVariant name _)
      (tc-variant-name-matches? ctx enum-name (intern-str name) variant-name)]
    [_ false]))

(define (tc-match-arms-mention-variant?
  [ctx : TcContext]
  [arms : AstMatchArmList]
  [enum-name : String]
  [variant-name : String]) : bool
  (match arms
    [(AstMatchArmNil) false]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm pattern _)
            (if (tc-pattern-mentions-variant?
              ctx
              pattern
              enum-name
              variant-name)
              true
              (tc-match-arms-mention-variant? ctx rest enum-name variant-name))]))]))

(define (tc-enum-variants-exhaustive-ok
  [ctx : TcContext]
  [enum-name : String]
  [variants : AstVariantDefList]
  [arms : AstMatchArmList]) : ResultTcUnit
  (match variants
    [(AstVariantDefNil) OkTcUnit]
    [(AstVariantDefCons variant rest)
      (let
        [rest : AstVariantDefList (box-get rest)]
        (match variant
          [(AstVariantDef name _ _)
            (let
              [variant-name : String (intern-str name)]
              (if (tc-match-arms-cover-variant? ctx arms enum-name variant-name)
                (tc-enum-variants-exhaustive-ok ctx enum-name rest arms)
                (if (tc-match-arms-mention-variant?
                  ctx
                  arms
                  enum-name
                  variant-name)
                  (ErrTcUnit "typecheck: non-exhaustive match")
                  (ErrTcUnit (tc-match-missing-variant-message variant-name)))))]))]))

(define (tc-match-arms-have-catchall? [arms : AstMatchArmList]) : bool
  (match arms
    [(AstMatchArmNil) false]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm pattern _)
            (match pattern
              [(AstPatWildcard) true]
              [(AstPatBinding _) true]
              [_ (tc-match-arms-have-catchall? rest)])]))]))

(define (tc-match-arms-have-catchall-for-type?
  [ctx : TcContext]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : bool
  (match arms
    [(AstMatchArmNil) false]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm pattern _)
            (if (tc-match-pattern-catchall-for-type? ctx scrut-ty pattern)
              true
              (tc-match-arms-have-catchall-for-type? ctx scrut-ty rest))]))]))

(define (tc-match-arms-cover-bool? [arms : AstMatchArmList] [want : bool]) : bool
  (match arms
    [(AstMatchArmNil) false]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm pattern _)
            (match pattern
              [(AstPatLiteral (AstLitBool value))
                (if (= value want)
                  true
                  (tc-match-arms-cover-bool? rest want))]
              [_ (tc-match-arms-cover-bool? rest want)])]))]))

(define (tc-match-pattern-catchall-for-type?
  [ctx : TcContext]
  [scrut-ty : AstType]
  [pattern : AstPattern]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
    [(AstTyEnum _)
      (match pattern
        [(AstPatWildcard) true]
        [_ false])]
    [(AstTyEnumArgs _ _)
      (match pattern
        [(AstPatWildcard) true]
        [_ false])]
    [(AstTyBox inner-ty)
      (match pattern
        [(AstPatWildcard) true]
        [(AstPatBinding _) true]
        [(AstPatVariant name args-box)
          (if (tc-box-pattern-name? name)
            (tc-box-pattern-args-supported?
              ctx
              (box-get args-box)
              (ty-node-get inner-ty))
            false)]
        [_ false])]
    [(AstTyStruct struct-name)
      (match pattern
        [(AstPatWildcard) true]
        [(AstPatBinding _) true]
        [(AstPatVariant name args-box)
          (tc-struct-pattern-irrefutable?
            ctx
            (intern-str struct-name)
            scrut-ty
            (intern-str name)
            (box-get args-box))]
        [_ false])]
    [(AstTyStructArgs struct-name _)
      (match pattern
        [(AstPatWildcard) true]
        [(AstPatBinding _) true]
        [(AstPatVariant name args-box)
          (tc-struct-pattern-irrefutable?
            ctx
            (intern-str struct-name)
            scrut-ty
            (intern-str name)
            (box-get args-box))]
        [_ false])]
    [(AstTyVar name)
      (if (= name (intern "ExprClause"))
        (tc-expr-clause-pattern-irrefutable? ctx pattern)
        (match pattern
          [(AstPatWildcard) true]
          [(AstPatBinding _) true]
          [_ false]))]
    [_
      (match pattern
        [(AstPatWildcard) true]
        [(AstPatBinding _) true]
        [_ false])]))

(define (tc-match-arm-reachability-loop
  [ctx : TcContext]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [seen-catchall : bool]) : ResultTcUnit
  (match arms
    [(AstMatchArmNil) OkTcUnit]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (if seen-catchall
          (ErrTcUnit "typecheck: unreachable match arm after wildcard `_`")
          (match arm
            [(AstMatchArm pattern _)
              (tc-match-arm-reachability-loop
                ctx
                scrut-ty
                rest
                (tc-match-pattern-catchall-for-type? ctx scrut-ty pattern))])))]))

(define (tc-match-arm-reachability-ok
  [ctx : TcContext]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : ResultTcUnit
  (tc-match-arm-reachability-loop ctx scrut-ty arms false))

(define (tc-match-coverage-type [ctx : TcContext] [scrut-ty : AstType]) : AstType
  (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
    [(AstTyRef _ referent-box)
      (let
        [referent-ty : AstType
          (tc-type-strip-region
            (tc-resolve-type ctx (ty-node-get referent-box)))]
        (match referent-ty
          [(AstTyEnum _) referent-ty]
          [(AstTyEnumArgs _ _) referent-ty]
          [_ scrut-ty]))]
    [_ scrut-ty]))

(define (tc-match-bool-exhaustive-ok [arms : AstMatchArmList]) : ResultTcUnit
  (if (tc-match-arms-have-catchall? arms)
    OkTcUnit
    (if (tc-match-arms-cover-bool? arms true)
      (if (tc-match-arms-cover-bool? arms false)
        OkTcUnit
        (ErrTcUnit "typecheck: match missing arm for false"))
      (ErrTcUnit "typecheck: match missing arm for true"))))

(define (tc-match-exhaustiveness-ok
  [ctx : TcContext]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : ResultTcUnit
  (match (tc-type-strip-region scrut-ty)
    [(AstTyEnum enum-name)
      (let
        [enum-name-str : String (intern-str enum-name)]
        (match (tc-context-enum-variants ctx enum-name-str)
          [(OkAstVariantDefList variants)
            (tc-enum-variants-exhaustive-ok ctx enum-name-str variants arms)]
          [(ErrAstVariantDefList _)
            (ErrTcUnit "typecheck: non-exhaustive match")]))]
    [(AstTyEnumArgs enum-name _)
      (let
        [enum-name-str : String (intern-str enum-name)]
        (match (tc-program-enum-variants (tc-context-program ctx) enum-name-str)
          [(OkAstVariantDefList variants)
            (tc-enum-variants-exhaustive-ok ctx enum-name-str variants arms)]
          [(ErrAstVariantDefList _)
            (ErrTcUnit "typecheck: non-exhaustive match")]))]
    [(AstTyBool) (tc-match-bool-exhaustive-ok arms)]
    [_
      (if (tc-match-arms-have-catchall-for-type? ctx scrut-ty arms)
        OkTcUnit
        (ErrTcUnit "typecheck: non-exhaustive match"))]))

(define (tc-match-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : ResultTcType
  (let
    [coverage-ty : AstType (tc-match-coverage-type ctx scrut-ty)]
    (match (tc-match-arm-reachability-ok ctx coverage-ty arms)
      [(OkTcUnit)
        (match (tc-check-match-arm-types ctx env scrut-ty arms)
          [(OkTcType result-ty)
            (match (tc-match-exhaustiveness-ok ctx coverage-ty arms)
              [(OkTcUnit) (OkTcType result-ty)]
              [(ErrTcUnit message) (ErrTcType message)])]
          [(ErrTcType message) (ErrTcType message)])]
      [(ErrTcUnit message) (ErrTcType message)])))

(define (tc-match-expr-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [expected : AstType]) : ResultTcType
  (let
    [coverage-ty : AstType (tc-match-coverage-type ctx scrut-ty)]
    (match (tc-match-arm-reachability-ok ctx coverage-ty arms)
      [(OkTcUnit)
        (match (tc-check-match-arm-types-with-expected
          ctx
          env
          scrut-ty
          arms
          expected)
          [(OkTcType result-ty)
            (match (tc-match-exhaustiveness-ok ctx coverage-ty arms)
              [(OkTcUnit) (OkTcType result-ty)]
              [(ErrTcUnit message) (ErrTcType message)])]
          [(ErrTcType message) (ErrTcType message)])]
      [(ErrTcUnit message) (ErrTcType message)])))

;; spmd-reduce operator/type rules (#1011, SPEC 5.15): the init/value/result type
;; must be in the operator's supported set -- `sum` over i32/i64/f64, `min`/`max`
;; over i32/i64, `all`/`any` over bool.
(define (tc-reduce-op-type-ok? [op : AstReduceOp] [ty : AstType]) : bool
  (match op
    [(AstReduceSum)
      (match ty
        [(AstTyI32) true]
        [(AstTyI64) true]
        [(AstTyF64) true]
        [_ false])]
    [(AstReduceMin)
      (match ty
        [(AstTyI32) true]
        [(AstTyI64) true]
        [_ false])]
    [(AstReduceMax)
      (match ty
        [(AstTyI32) true]
        [(AstTyI64) true]
        [_ false])]
    [(AstReduceAll)
      (match ty
        [(AstTyBool) true]
        [_ false])]
    [(AstReduceAny)
      (match ty
        [(AstTyBool) true]
        [_ false])]))

(define (tc-reduce-op-type-msg [op : AstReduceOp]) : String
  (match op
    [(AstReduceSum)
      "typecheck: spmd-reduce sum requires an i32, i64, or f64 type"]
    [(AstReduceMin) "typecheck: spmd-reduce min requires an i32 or i64 type"]
    [(AstReduceMax) "typecheck: spmd-reduce max requires an i32 or i64 type"]
    [(AstReduceAll) "typecheck: spmd-reduce all requires a bool type"]
    [(AstReduceAny) "typecheck: spmd-reduce any requires a bool type"]))

(define (tc-scan-op-type-ok? [op : AstReduceOp] [ty : AstType]) : bool
  (match op
    [(AstReduceSum)
      (match ty
        [(AstTyI32) true]
        [(AstTyI64) true]
        [_ false])]
    [(AstReduceMin)
      (match ty
        [(AstTyI32) true]
        [(AstTyI64) true]
        [_ false])]
    [(AstReduceMax)
      (match ty
        [(AstTyI32) true]
        [(AstTyI64) true]
        [_ false])]
    [(AstReduceAll)
      (match ty
        [(AstTyBool) true]
        [_ false])]
    [(AstReduceAny)
      (match ty
        [(AstTyBool) true]
        [_ false])]))

(define (tc-scan-op-type-msg [op : AstReduceOp]) : String
  (match op
    [(AstReduceSum)
      "typecheck: spmd-scan sum requires an i32 or i64 type; floating-point scan ordering is deferred"]
    [(AstReduceMin)
      "typecheck: spmd-scan min requires an i32 or i64 type; floating-point scan ordering is deferred"]
    [(AstReduceMax)
      "typecheck: spmd-scan max requires an i32 or i64 type; floating-point scan ordering is deferred"]
    [(AstReduceAll) "typecheck: spmd-scan all requires a bool type"]
    [(AstReduceAny) "typecheck: spmd-scan any requires a bool type"]))

;; spmd-reduce purity/effect rules (#1011, SPEC.md 5.15): mirror the Rust
;; typechecker's `check_spmd_reduce_value`. The first reduction slice accepts a
;; narrow, clearly-pure surface and rejects everything else with a focused
;; diagnostic rather than guessing at varying/uniform semantics not yet
;; implemented: the varying index, uniform variables, and literals;
;; arithmetic/comparison/boolean operators over those; `ann`/`cast` wrappers;
;; dynamic-array reads whose index is not itself another array read (direct,
;; non-gather indexing only); and local `let` bindings whose initializers obey
;; the same rules. Writes (`set!`, `array-set!`), function calls, nested
;; `foreach`/`spmd-reduce`, varying control flow (`if`/`while`/`match`),
;; sequencing, and aggregate constructors are rejected. The `in-index` flag is
;; set while walking an array-read index so a nested read (a gather) is
;; rejected. Uniformity of `start`/`end`/`init` is enforced by scoping: they are
;; typed outside the lane context, so referencing the index is an unbound error.
(define (tc-spmd-value-pure [expr : AstExpr]) : ResultTcUnit
  (tc-spmd-value-pure-at expr false))

(define (tc-spmd-value-pure-at [expr : AstExpr] [in-index : bool]) : ResultTcUnit
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-value-pure-at inner in-index))]
    [(AstExprLiteral _) OkTcUnit]
    [(AstExprSpmdProgramIndex) OkTcUnit]
    [(AstExprSpmdProgramCount) OkTcUnit]
    [(AstExprVar _) OkTcUnit]
    [(AstExprBinary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (match (tc-spmd-value-pure-at left in-index)
          [(OkTcUnit) (tc-spmd-value-pure-at right in-index)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprUnary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-value-pure-at inner in-index))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-value-pure-at inner in-index))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-value-pure-at inner in-index))]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-spmd-value-let-bindings-pure-at bindings in-index)
              [(OkTcUnit) (tc-spmd-value-pure-at body in-index)]
              [(ErrTcUnit message) (ErrTcUnit message)]))])]
    [(AstExprArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (if in-index
          (ErrTcUnit
            "indirect array indexing is not allowed inside a spmd-reduce value expression; gather/scatter is deferred in the first slice (SPEC.md 5.15)")
          (match (tc-spmd-value-pure-at array false)
            [(OkTcUnit) (tc-spmd-value-pure-at index true)]
            [(ErrTcUnit message) (ErrTcUnit message)])))]
    [(AstExprSet _ _)
      (ErrTcUnit
        "`set!` is not allowed inside a spmd-reduce value expression; reductions must use the explicit accumulator, not outer mutation (SPEC.md 5.15)")]
    [(AstExprArraySet _ _ _)
      (ErrTcUnit
        "`array-set!` is not allowed inside a spmd-reduce value expression; the value expression must be free of writes and other side effects (SPEC.md 5.15)")]
    [(AstExprStructSet _ _ _)
      (ErrTcUnit
        "struct field assignment is not allowed inside a spmd-reduce value expression; the value expression must be free of writes and other side effects (SPEC.md 5.15)")]
    [(AstExprArrayPush _ _)
      (ErrTcUnit
        "`array-push!` is not allowed inside a spmd-reduce value expression; the value expression must be free of writes and other side effects (SPEC.md 5.15)")]
    [(AstExprCall _ _)
      (ErrTcUnit
        "function calls are not allowed inside a spmd-reduce value expression; side-effecting builtins and user calls with varying arguments are deferred in the first slice (SPEC.md 5.15)")]
    [(AstExprForeach _)
      (ErrTcUnit
        "a nested foreach is not allowed inside a spmd-reduce value expression (SPEC.md 5.15)")]
    [(AstExprSpmdReduce _)
      (ErrTcUnit
        "a nested spmd-reduce is not allowed inside a spmd-reduce value expression (SPEC.md 5.15)")]
    [(AstExprSpmdScan _)
      (ErrTcUnit
        "a nested spmd-scan is not allowed inside a spmd-reduce value expression (SPEC.md 5.15)")]
    [(AstExprSpmdBroadcast value-box lane-box)
      (if in-index
        (ErrTcUnit
          "spmd-broadcast is not allowed inside an array index in a spmd-reduce value expression (SPEC.md 5.15)")
        (let
          [value : AstExpr (ast-node-get value-box)]
          [lane : AstExpr (ast-node-get lane-box)]
          (match (tc-spmd-value-pure-at value false)
            [(OkTcUnit) (tc-spmd-value-pure-at lane false)]
            [(ErrTcUnit message) (ErrTcUnit message)])))]
    [(AstExprSpmdShuffle value-box lane-box)
      (if in-index
        (ErrTcUnit
          "spmd-shuffle is not allowed inside an array index in a spmd-reduce value expression (SPEC.md 5.15)")
        (let
          [value : AstExpr (ast-node-get value-box)]
          [lane : AstExpr (ast-node-get lane-box)]
          (match (tc-spmd-value-pure-at value false)
            [(OkTcUnit) (tc-spmd-value-pure-at lane false)]
            [(ErrTcUnit message) (ErrTcUnit message)])))]
    [(AstExprIf _ _ _)
      (ErrTcUnit
        "varying control flow is not allowed inside a spmd-reduce value expression; the first slice has no varying if/while/match (SPEC.md 5.15)")]
    [(AstExprWhile _ _)
      (ErrTcUnit
        "varying control flow is not allowed inside a spmd-reduce value expression; the first slice has no varying if/while/match (SPEC.md 5.15)")]
    [(AstExprMatch _)
      (ErrTcUnit
        "varying control flow is not allowed inside a spmd-reduce value expression; the first slice has no varying if/while/match (SPEC.md 5.15)")]
    [_
      (ErrTcUnit
        "this expression is not allowed inside a spmd-reduce value expression; the first slice allows only the varying index, uniform variables, literals, arithmetic/comparison/boolean operators, dynamic-array reads, and local let bindings (SPEC.md 5.15)")]))

(define (tc-spmd-value-let-bindings-pure-at
  [bindings : AstLetBindingList]
  [in-index : bool]) : ResultTcUnit
  (match bindings
    [(AstLetBindingNil) OkTcUnit]
    [(AstLetBindingCons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding _ _ init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (match (tc-spmd-value-pure-at init in-index)
                [(OkTcUnit) (tc-spmd-value-let-bindings-pure-at rest in-index)]
                [(ErrTcUnit message) (ErrTcUnit message)]))]))]))

(define (tc-spmd-reduce-type-from-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [value-env : TcTypeEnv]
  [op : AstReduceOp]
  [init : AstExpr]
  [value : AstExpr]) : ResultTcType
  (match (tc-expr ctx value-env value)
    [(OkTcType value-ty)
      (if (tc-reduce-op-type-ok? op (tc-resolve-type ctx value-ty))
        (match (tc-expr-with-expected-or-actual ctx env init value-ty)
          [(OkTcType init-ty)
            (match (tc-expect
              init-ty
              value-ty
              "typecheck: spmd-reduce init and value type mismatch")
              [(OkTcUnit) (OkTcType value-ty)]
              [(ErrTcUnit message) (ErrTcType message)])]
          [(ErrTcType message) (ErrTcType message)])
        (ErrTcType (tc-reduce-op-type-msg op)))]
    [(ErrTcType message) (ErrTcType message)]))

(define (tc-spmd-reduce-type-from-value-or-message
  [ctx : TcContext]
  [env : TcTypeEnv]
  [value-env : TcTypeEnv]
  [op : AstReduceOp]
  [init : AstExpr]
  [value : AstExpr]
  [fallback-message : String]) : ResultTcType
  (match (tc-spmd-reduce-type-from-value ctx env value-env op init value)
    [(OkTcType ty) (OkTcType ty)]
    [(ErrTcType _) (ErrTcType fallback-message)]))

(define (tc-spmd-reduce-init-value-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [value-env : TcTypeEnv]
  [op : AstReduceOp]
  [init : AstExpr]
  [value : AstExpr]) : ResultTcType
  (match (tc-expr ctx env init)
    [(OkTcType init-ty)
      (if (tc-reduce-op-type-ok? op (tc-resolve-type ctx init-ty))
        (match (tc-spmd-value-pure value)
          [(OkTcUnit)
            (match (tc-expr-with-expected-or-actual ctx value-env value init-ty)
              [(OkTcType value-ty)
                (match (tc-expect
                  value-ty
                  init-ty
                  "typecheck: spmd-reduce init and value type mismatch")
                  [(OkTcUnit) (OkTcType init-ty)]
                  [(ErrTcUnit message)
                    (tc-spmd-reduce-type-from-value-or-message
                      ctx
                      env
                      value-env
                      op
                      init
                      value
                      message)])]
              [(ErrTcType message)
                (tc-spmd-reduce-type-from-value-or-message
                  ctx
                  env
                  value-env
                  op
                  init
                  value
                  message)])]
          [(ErrTcUnit message) (ErrTcType message)])
        (ErrTcType (tc-reduce-op-type-msg op)))]
    [(ErrTcType message) (ErrTcType message)]))

(define (tc-spmd-scan-init-value-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [value-env : TcTypeEnv]
  [op : AstReduceOp]
  [prefix-ty : AstType]
  [init : AstExpr]
  [value : AstExpr]) : ResultTcType
  (let
    [resolved-prefix-ty : AstType (tc-resolve-type ctx prefix-ty)]
    (if (tc-scan-op-type-ok? op resolved-prefix-ty)
      (match (tc-expr-with-expected-or-actual ctx env init resolved-prefix-ty)
        [(OkTcType init-ty)
          (match (tc-expect
            (tc-resolve-type ctx init-ty)
            resolved-prefix-ty
            "typecheck: spmd-scan prefix init type mismatch")
            [(OkTcUnit)
              (match (tc-spmd-value-pure value)
                [(OkTcUnit)
                  (match (tc-expr-with-expected-or-actual
                    ctx
                    value-env
                    value
                    resolved-prefix-ty)
                    [(OkTcType value-ty)
                      (match (tc-expect
                        (tc-resolve-type ctx value-ty)
                        resolved-prefix-ty
                        "typecheck: spmd-scan value type mismatch")
                        [(OkTcUnit) (OkTcType resolved-prefix-ty)]
                        [(ErrTcUnit message) (ErrTcType message)])]
                    [(ErrTcType message) (ErrTcType message)])]
                [(ErrTcUnit message) (ErrTcType message)])]
            [(ErrTcUnit message) (ErrTcType message)])]
        [(ErrTcType message) (ErrTcType message)])
      (ErrTcType (tc-scan-op-type-msg op)))))

(define (tc-ptr-addr-of-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]) : ResultTcType
  (match (tc-require-unsafe env "ptr-addr-of")
    [(OkTcUnit)
      (match (tc-ptr-addr-of-local-lookup env name)
        [(OkTcType ty)
          (let
            [resolved : AstType (tc-resolve-type ctx ty)]
            (if (tc-ptr-addr-of-cell-type-ok? resolved)
              (OkTcType (ast-ty-mut-ptr resolved))
              (ErrTcType
                "typecheck: ptr-addr-of supports local scalar cells only")))]
        [(ErrTcType message) (ErrTcType message)])]
    [(ErrTcUnit message) (ErrTcType message)]))

(define (tc-ptr-read-expr [ctx : TcContext] [env : TcTypeEnv] [ptr : AstExpr]) : ResultTcType
  (match (tc-require-unsafe env "ptr-read")
    [(OkTcUnit)
      (match (tc-expr ctx env ptr)
        [(OkTcType ptr-ty)
          (match (tc-raw-pointer-elem
            (tc-resolve-type ctx ptr-ty)
            "typecheck: ptr-read requires a raw pointer operand")
            [(OkTcType elem) (OkTcType (tc-resolve-type ctx elem))]
            [(ErrTcType message) (ErrTcType message)])]
        [(ErrTcType message) (ErrTcType message)])]
    [(ErrTcUnit message) (ErrTcType message)]))

(define (tc-ptr-write-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ptr : AstExpr]
  [value : AstExpr]) : ResultTcType
  (match (tc-require-unsafe env "ptr-write!")
    [(OkTcUnit)
      (match (tc-expr ctx env ptr)
        [(OkTcType ptr-ty)
          (match (tc-mut-pointer-elem
            (tc-resolve-type ctx ptr-ty)
            "typecheck: ptr-write! requires a MutPtr pointer operand")
            [(OkTcType elem)
              (match (tc-expr-with-expected-or-actual
                ctx
                env
                value
                (tc-resolve-type ctx elem))
                [(OkTcType value-ty)
                  (match (tc-expect
                    value-ty
                    (tc-resolve-type ctx elem)
                    "typecheck: ptr-write! value type mismatch")
                    [(OkTcUnit) (OkTcType (AstTyUnit))]
                    [(ErrTcUnit message) (ErrTcType message)])]
                [(ErrTcType message) (ErrTcType message)])]
            [(ErrTcType message) (ErrTcType message)])]
        [(ErrTcType message) (ErrTcType message)])]
    [(ErrTcUnit message) (ErrTcType message)]))

(define (tc-ptr-offset-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ptr : AstExpr]
  [offset : AstExpr]) : ResultTcType
  (match (tc-require-unsafe env "ptr-offset")
    [(OkTcUnit)
      (match (tc-expr ctx env ptr)
        [(OkTcType ptr-ty)
          (let
            [resolved-ptr : AstType (tc-resolve-type ctx ptr-ty)]
            (match (tc-raw-pointer-elem
              resolved-ptr
              "typecheck: ptr-offset requires a raw pointer operand")
              [(OkTcType _)
                (match (tc-expr-with-expected-or-actual
                  ctx
                  env
                  offset
                  (AstTyI64))
                  [(OkTcType offset-ty)
                    (if (tc-integer-type? offset-ty)
                      (OkTcType resolved-ptr)
                      (ErrTcType
                        "typecheck: ptr-offset requires an integer offset"))]
                  [(ErrTcType message) (ErrTcType message)])]
              [(ErrTcType message) (ErrTcType message)]))]
        [(ErrTcType message) (ErrTcType message)])]
    [(ErrTcUnit message) (ErrTcType message)]))

(define (tc-ptr-cast-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ptr : AstExpr]
  [target : AstType]) : ResultTcType
  (match (tc-require-unsafe env "ptr-cast")
    [(OkTcUnit)
      (let
        [resolved-target : AstType (tc-resolve-type ctx target)]
        (if (tc-raw-pointer-type? resolved-target)
          (match (tc-expr ctx env ptr)
            [(OkTcType ptr-ty)
              (if (tc-raw-pointer-type? (tc-resolve-type ctx ptr-ty))
                (OkTcType resolved-target)
                (ErrTcType "typecheck: ptr-cast requires a raw pointer operand"))]
            [(ErrTcType message) (ErrTcType message)])
          (ErrTcType "typecheck: ptr-cast target must be a raw pointer type")))]
    [(ErrTcUnit message) (ErrTcType message)]))

(define (tc-ptr-to-int-expr [ctx : TcContext] [env : TcTypeEnv] [ptr : AstExpr]) : ResultTcType
  (match (tc-require-unsafe env "ptr->int")
    [(OkTcUnit)
      (match (tc-expr ctx env ptr)
        [(OkTcType ptr-ty)
          (if (tc-raw-pointer-type? (tc-resolve-type ctx ptr-ty))
            (OkTcType (AstTyU64))
            (ErrTcType "typecheck: ptr->int requires a raw pointer operand"))]
        [(ErrTcType message) (ErrTcType message)])]
    [(ErrTcUnit message) (ErrTcType message)]))

(define (tc-int-to-ptr-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [value : AstExpr]
  [target : AstType]) : ResultTcType
  (match (tc-require-unsafe env "int->ptr")
    [(OkTcUnit)
      (let
        [resolved-target : AstType (tc-resolve-type ctx target)]
        (if (tc-raw-pointer-type? resolved-target)
          (match (tc-expr ctx env value)
            [(OkTcType value-ty)
              (if (tc-integer-type? value-ty)
                (OkTcType resolved-target)
                (ErrTcType "typecheck: int->ptr requires an integer operand"))]
            [(ErrTcType message) (ErrTcType message)])
          (ErrTcType "typecheck: int->ptr target must be a raw pointer type")))]
    [(ErrTcUnit message) (ErrTcType message)]))

(define (tc-string-data-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [str : AstExpr]) : ResultTcType
  (match (tc-require-unsafe env "string-data")
    [(OkTcUnit)
      (match (tc-expr ctx env str)
        [(OkTcType str-ty)
          (if (tc-length-handle-type? str-ty)
            (OkTcType (ast-ty-ptr (AstTyU8)))
            (ErrTcType "typecheck: string-data requires String or bytes"))]
        [(ErrTcType message) (ErrTcType message)])]
    [(ErrTcUnit message) (ErrTcType message)]))

(define (tc-string-from-bytes-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ptr : AstExpr]
  [len : AstExpr]) : ResultTcType
  (match (tc-require-unsafe env "string-from-bytes")
    [(OkTcUnit)
      (match (tc-expr ctx env ptr)
        [(OkTcType ptr-ty)
          (match (tc-type-strip-region (tc-resolve-type ctx ptr-ty))
            [(AstTyPtr elem)
              (if (tc-type-compatible? (ty-node-get elem) (AstTyU8))
                (match (tc-expr-with-expected-or-actual ctx env len (AstTyI64))
                  [(OkTcType len-ty)
                    (if (tc-integer-type? len-ty)
                      (OkTcType (AstTyString))
                      (ErrTcType
                        "typecheck: string-from-bytes length must be integer"))]
                  [(ErrTcType message) (ErrTcType message)])
                (ErrTcType
                  "typecheck: string-from-bytes pointer must point at u8"))]
            [(AstTyMutPtr elem)
              (if (tc-type-compatible? (ty-node-get elem) (AstTyU8))
                (match (tc-expr-with-expected-or-actual ctx env len (AstTyI64))
                  [(OkTcType len-ty)
                    (if (tc-integer-type? len-ty)
                      (OkTcType (AstTyString))
                      (ErrTcType
                        "typecheck: string-from-bytes length must be integer"))]
                  [(ErrTcType message) (ErrTcType message)])
                (ErrTcType
                  "typecheck: string-from-bytes pointer must point at u8"))]
            [_
              (ErrTcType
                "typecheck: string-from-bytes requires a raw u8 pointer")])]
        [(ErrTcType message) (ErrTcType message)])]
    [(ErrTcUnit message) (ErrTcType message)]))

(define (tc-array-data-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [array : AstExpr]) : ResultTcType
  (match (tc-require-unsafe env "array-data")
    [(OkTcUnit)
      (match (tc-expr ctx env array)
        [(OkTcType array-ty)
          (match (tc-type-strip-region (tc-resolve-type ctx array-ty))
            [(AstTyArray elem-ty _)
              (OkTcType (ast-ty-mut-ptr (ty-node-get elem-ty)))]
            [(AstTyDynArray elem-ty)
              (OkTcType (ast-ty-mut-ptr (ty-node-get elem-ty)))]
            [_ (ErrTcType "typecheck: array-data requires an array")])]
        [(ErrTcType message) (ErrTcType message)])]
    [(ErrTcUnit message) (ErrTcType message)]))

(define (tc-program-entry-ptr-expr [env : TcTypeEnv] [name : String]) : ResultTcType
  (match (tc-require-unsafe env name)
    [(OkTcUnit) (OkTcType (ast-ty-ptr (ast-ty-ptr (AstTyU8))))]
    [(ErrTcUnit message) (ErrTcType message)]))

(define (tc-cpuid-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [leaf : AstExpr]
  [subleaf : AstExpr]) : ResultTcType
  (match (tc-expr-with-expected-or-actual ctx env leaf (AstTyI64))
    [(OkTcType leaf-ty)
      (if (tc-integer-type? leaf-ty)
        (match (tc-expr-with-expected-or-actual ctx env subleaf (AstTyI64))
          [(OkTcType subleaf-ty)
            (if (tc-integer-type? subleaf-ty)
              (OkTcType (AstTyI64))
              (ErrTcType "typecheck: cpuid subleaf must be integer"))]
          [(ErrTcType message) (ErrTcType message)])
        (ErrTcType "typecheck: cpuid leaf must be integer"))]
    [(ErrTcType message) (ErrTcType message)]))

(define (tc-xgetbv-expr [ctx : TcContext] [env : TcTypeEnv] [index : AstExpr]) : ResultTcType
  (match (tc-expr-with-expected-or-actual ctx env index (AstTyI64))
    [(OkTcType index-ty)
      (if (tc-integer-type? index-ty)
        (OkTcType (AstTyI64))
        (ErrTcType "typecheck: xgetbv index must be integer"))]
    [(ErrTcType message) (ErrTcType message)]))

;; Each syscall operand (number and arguments) must be an integer; the raw
;; kernel result is an i64.
(define (tc-syscall-args
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]) : ResultTcUnit
  (match args
    [(AstExprNil) (OkTcUnit)]
    [(AstExprCons arg rest)
      (match (tc-expr ctx env (ast-node-get arg))
        [(OkTcType arg-ty)
          (if (tc-integer-type? arg-ty)
            (tc-syscall-args ctx env (box-get rest))
            (ErrTcUnit "typecheck: syscall operands must be integer"))]
        [(ErrTcType message) (ErrTcUnit message)])]))

(define (tc-syscall-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]) : ResultTcType
  (match (tc-require-unsafe env "syscall")
    [(OkTcUnit)
      (match (tc-syscall-args ctx env args)
        [(OkTcUnit) (OkTcType (AstTyI64))]
        [(ErrTcUnit message) (ErrTcType message)])]
    [(ErrTcUnit message) (ErrTcType message)]))

(define (tc-box-expr [ctx : TcContext] [env : TcTypeEnv] [inner : AstExpr]) : ResultTcType
  (match (tc-ensure-cleanup-resource-not-stored-expr env inner)
    [(OkTcUnit)
      (match (tc-expr ctx env inner)
        [(OkTcType inner-ty)
          (OkTcType (tc-tag-active-region env (ast-ty-box inner-ty)))]
        [(ErrTcType message) (ErrTcType message)])]
    [(ErrTcUnit message) (ErrTcType message)]))

(define (tc-box-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [inner : AstExpr]
  [expected : AstType]) : ResultTcType
  (match (tc-type-strip-region (tc-resolve-type ctx expected))
    [(AstTyBox expected-inner)
      (let
        [expected-inner-ty : AstType (ty-node-get expected-inner)]
        (match (tc-ensure-cleanup-resource-not-stored-expr env inner)
          [(OkTcUnit)
            (match (tc-expr-with-expected-or-actual
              ctx
              env
              inner
              expected-inner-ty)
              [(OkTcType inner-ty)
                (OkTcType
                  (tc-tag-active-region
                    env
                    (ast-ty-box
                      (tc-contextual-result-type expected-inner-ty inner-ty))))]
              [(ErrTcType message) (ErrTcType message)])]
          [(ErrTcUnit message) (ErrTcType message)]))]
    [_ (tc-box-expr ctx env inner)]))

(define (tc-box-get-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [box-expr : AstExpr]) : ResultTcType
  (match (tc-expr ctx env box-expr)
    [(OkTcType box-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx box-ty))
        [(AstTyBox inner-ty)
          (OkTcType
            (tc-project-from-region-container box-ty (ty-node-get inner-ty)))]
        [_ (ErrTcType "typecheck: box-get requires Box type")])]
    [(ErrTcType message) (ErrTcType message)]))

(define (tc-box-get-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [box-expr : AstExpr]
  [expected : AstType]) : ResultTcType
  (match (tc-expr-with-expected-or-actual
    ctx
    env
    box-expr
    (ast-ty-box expected))
    [(OkTcType box-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx box-ty))
        [(AstTyBox inner-ty)
          (let
            [projected : AstType
              (tc-project-from-region-container box-ty (ty-node-get inner-ty))]
            (if (tc-type-compatible? expected projected)
              (OkTcType (tc-contextual-result-type expected projected))
              (OkTcType projected)))]
        [_ (ErrTcType "typecheck: box-get requires Box type")])]
    [(ErrTcType message) (ErrTcType message)]))

(define (tc-box-take-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [box-expr : AstExpr]
  [expected : AstType]) : ResultTcType
  (match (tc-box-get-expr-with-expected-or-actual ctx env box-expr expected)
    [(OkTcType inner-ty) (OkTcType inner-ty)]
    [(ErrTcType message)
      (if (string.string-eq message "typecheck: box-get requires Box type")
        (ErrTcType "typecheck: box-take requires Box type")
        (ErrTcType message))]))

(define (tc-box-take-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [box-expr : AstExpr]) : ResultTcType
  (match (tc-box-get-expr ctx env box-expr)
    [(OkTcType inner-ty) (OkTcType inner-ty)]
    [(ErrTcType message)
      (if (string.string-eq message "typecheck: box-get requires Box type")
        (ErrTcType "typecheck: box-take requires Box type")
        (ErrTcType message))]))

(define (tc-box-set-inner-type [ctx : TcContext] [box-ty : AstType]) : ResultTcType
  (match (tc-type-strip-region (tc-resolve-type ctx box-ty))
    [(AstTyBox inner-ty)
      (OkTcType
        (tc-project-from-region-container box-ty (ty-node-get inner-ty)))]
    [(AstTyRef _ _)
      (ErrTcType "typecheck: set! box requires mutable Box access")]
    [_ (ErrTcType "typecheck: set! box requires Box type")]))

(define (tc-box-mutation-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [box-expr : AstExpr]
  [value : AstExpr]) : ResultTcType
  (match (tc-store-place-lifetime ctx env box-expr)
    [(OkTcString _)
      (match (tc-expr ctx env box-expr)
        [(OkTcType box-ty)
          (match (tc-box-set-inner-type ctx box-ty)
            [(OkTcType inner-ty)
              (match (tc-expr-with-expected-or-actual ctx env value inner-ty)
                [(OkTcType value-ty)
                  (match (tc-expect
                    value-ty
                    inner-ty
                    "typecheck: box assignment type mismatch")
                    [(OkTcUnit)
                      (match (tc-ensure-cleanup-resource-not-stored-expr
                        env
                        value)
                        [(OkTcUnit)
                          (match (tc-ensure-region-value-can-flow-into
                            env
                            inner-ty
                            value-ty
                            "box")
                            [(OkTcUnit)
                              (match (tc-ensure-reference-value-can-store-in-place
                                ctx
                                env
                                (ast-node-get
                                  (ast-expr-box-get (ast-node-push box-expr)))
                                value-ty
                                "box")
                                [(OkTcUnit) (OkTcType (AstTyUnit))]
                                [(ErrTcUnit message) (ErrTcType message)])]
                            [(ErrTcUnit message) (ErrTcType message)])]
                        [(ErrTcUnit message) (ErrTcType message)])]
                    [(ErrTcUnit message) (ErrTcType message)])]
                [(ErrTcType message) (ErrTcType message)])]
            [(ErrTcType message) (ErrTcType message)])]
        [(ErrTcType message) (ErrTcType message)])]
    [(ErrTcString message) (ErrTcType message)]))

(define (tc-init-unsupported-message [ctx : TcContext] [ty : AstType]) : String
  (string.string-append
    "typecheck: init unsupported type "
    (tc-type-render (tc-type-without-regions (tc-resolve-type ctx ty)))))

(define (tc-init-cleanup-owning-message [ctx : TcContext] [ty : AstType]) : String
  (string.string-append
    "typecheck: init does not support cleanup-owning aggregate "
    (tc-type-render (tc-type-without-regions (tc-resolve-type ctx ty)))))

(define (tc-init-aggregate-layout-ok [ctx : TcContext] [ty : AstType]) : ResultTcUnit
  (match (tc-inline-aggregate-type-layout ctx ty)
    [(OkTcLayoutInfo _) OkTcUnit]
    [(ErrTcLayoutInfo message) (ErrTcUnit message)]))

(define (tc-init-type-list-supported
  [ctx : TcContext]
  [env : TcTypeEnv]
  [types : AstTypeList]) : ResultTcUnit
  (match types
    [(AstTypeNil) OkTcUnit]
    [(AstTypeCons head rest)
      (let
        [head : AstType (ty-node-get head)]
        [rest : AstTypeList (box-get rest)]
        (match (tc-init-type-supported ctx env head)
          [(OkTcUnit) (tc-init-type-list-supported ctx env rest)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]))

(define (tc-init-struct-field-types-for-result
  [ctx : TcContext]
  [struct-name : String]
  [struct-ty : AstType]
  [fields : AstFieldDefList]) : AstTypeList
  (let
    [field-types : AstTypeList
      (tc-resolve-type-list ctx (tc-field-type-list ctx fields))]
    (match struct-ty
      [(AstTyStructArgs _ lifetimes)
        (match (tc-lifetime-subst-from-nominal-args
          ctx
          struct-name
          (box-get lifetimes))
          [(OkTcLifetimeSubst subst)
            (tc-lifetime-subst-type-list subst field-types)]
          [(ErrTcLifetimeSubst _) field-types])]
      [(AstTyVarArgs _ lifetimes)
        (match (tc-lifetime-subst-from-nominal-args
          ctx
          struct-name
          (box-get lifetimes))
          [(OkTcLifetimeSubst subst)
            (tc-lifetime-subst-type-list subst field-types)]
          [(ErrTcLifetimeSubst _) field-types])]
      [_ field-types])))

(define (tc-init-enum-fields-for-result
  [ctx : TcContext]
  [enum-name : String]
  [enum-ty : AstType]
  [fields : AstTypeList]) : AstTypeList
  (let
    [field-types : AstTypeList (tc-resolve-type-list ctx fields)]
    (match enum-ty
      [(AstTyEnumArgs _ lifetimes)
        (match (tc-lifetime-subst-from-nominal-args
          ctx
          enum-name
          (box-get lifetimes))
          [(OkTcLifetimeSubst subst)
            (tc-lifetime-subst-type-list subst field-types)]
          [(ErrTcLifetimeSubst _) field-types])]
      [(AstTyVarArgs _ lifetimes)
        (match (tc-lifetime-subst-from-nominal-args
          ctx
          enum-name
          (box-get lifetimes))
          [(OkTcLifetimeSubst subst)
            (tc-lifetime-subst-type-list subst field-types)]
          [(ErrTcLifetimeSubst _) field-types])]
      [_ field-types])))

(define (tc-context-with-nominal-owner-module
  [ctx : TcContext]
  [nominal-name : String]) : TcContext
  (if (tc-name-qualified? nominal-name)
    (tc-context-with-module ctx (tc-qualified-name-module nominal-name))
    ctx))

(define (tc-context-with-nominal-owner-handle-module
  [ctx : TcContext]
  [handle : i64]) : TcContext
  (match (tc-nominal-owner-name ctx handle)
    [(OkTcString owner-name)
      (if (tc-name-qualified? owner-name)
        (tc-context-with-module ctx (tc-qualified-name-module owner-name))
        (tc-context-with-module ctx ""))]
    [(ErrTcString _) ctx]))

(define (tc-init-nominal-field-context
  [ctx : TcContext]
  [nominal-name : String]) : TcContext
  (match (compiler-symbols-lookup-type (tc-context-symbols ctx) nominal-name)
    [(SomeI64 handle) (tc-context-with-nominal-owner-handle-module ctx handle)]
    [(NoneI64) (tc-context-with-nominal-owner-module ctx nominal-name)]))

(define (tc-init-struct-supported
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [struct-ty : AstType]) : ResultTcUnit
  (match (tc-struct-decl ctx struct-name)
    [(OkTcStructDecl decl)
      (match decl
        [(TcStructDecl repr cleanup fields)
          (let
            [field-ctx : TcContext
              (tc-init-nominal-field-context ctx struct-name)]
            (if (ast-struct-repr-c? repr)
              (ErrTcUnit "typecheck: init supports only default-layout structs")
              (if (ast-struct-cleanup? cleanup)
                (ErrTcUnit (tc-init-cleanup-owning-message ctx struct-ty))
                (match (tc-init-aggregate-layout-ok field-ctx struct-ty)
                  [(OkTcUnit)
                    (tc-init-type-list-supported
                      field-ctx
                      env
                      (tc-init-struct-field-types-for-result
                        field-ctx
                        struct-name
                        struct-ty
                        fields))]
                  [(ErrTcUnit message) (ErrTcUnit message)]))))])]
    [(ErrTcStructDecl message) (ErrTcUnit message)]))

(define (tc-init-enum-supported
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [enum-ty : AstType]) : ResultTcUnit
  (let
    [field-ctx : TcContext (tc-init-nominal-field-context ctx enum-name)]
    (match (tc-enum-decl ctx enum-name)
      [(OkTcEnumDecl decl)
        (match decl
          [(TcEnumDecl cleanup variants)
            (if (ast-enum-cleanup? cleanup)
              (ErrTcUnit (tc-init-cleanup-owning-message ctx enum-ty))
              (match (tc-init-aggregate-layout-ok field-ctx enum-ty)
                [(OkTcUnit)
                  (match variants
                    [(AstVariantDefNil)
                      (ErrTcUnit
                        "typecheck: init requires enum with at least one variant")]
                    [(AstVariantDefCons variant _)
                      (match variant
                        [(AstVariantDef _ fields _)
                          (tc-init-type-list-supported
                            field-ctx
                            env
                            (tc-init-enum-fields-for-result
                              field-ctx
                              enum-name
                              enum-ty
                              fields))])])]
                [(ErrTcUnit message) (ErrTcUnit message)]))])]
      [(ErrTcEnumDecl message) (ErrTcUnit message)])))

(define (tc-init-type-supported
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : AstType]) : ResultTcUnit
  (let
    [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (if (tc-integer-type? resolved)
      OkTcUnit
      (match resolved
        [(AstTyF64) OkTcUnit]
        [(AstTyF32) OkTcUnit]
        [(AstTyBool) OkTcUnit]
        [(AstTyChar) OkTcUnit]
        [(AstTyUnit) OkTcUnit]
        [(AstTyString) OkTcUnit]
        [(AstTyPtr _) OkTcUnit]
        [(AstTyMutPtr _) OkTcUnit]
        [(AstTyDynArray elem)
          (let
            [elem-ty : AstType
              (tc-type-without-regions (tc-resolve-type ctx (ty-node-get elem)))]
            (if (tc-dyn-array-elem-supported? env elem-ty)
              OkTcUnit
              (ErrTcUnit
                "typecheck: init dynamic array element type is not supported")))]
        [(AstTyBox elem) (tc-init-type-supported ctx env (ty-node-get elem))]
        [(AstTyTuple elems)
          (match (tc-init-aggregate-layout-ok ctx resolved)
            [(OkTcUnit) (tc-init-type-list-supported ctx env (box-get elems))]
            [(ErrTcUnit message) (ErrTcUnit message)])]
        [(AstTyArray elem count)
          (if (< count 0)
            (ErrTcUnit
              "typecheck: init fixed array length must be non-negative")
            (match (tc-init-aggregate-layout-ok ctx resolved)
              [(OkTcUnit) (tc-init-type-supported ctx env (ty-node-get elem))]
              [(ErrTcUnit message) (ErrTcUnit message)]))]
        [(AstTyStruct name)
          (tc-init-struct-supported ctx env (intern-str name) resolved)]
        [(AstTyStructArgs name _)
          (tc-init-struct-supported ctx env (intern-str name) resolved)]
        [(AstTyEnum name)
          (tc-init-enum-supported ctx env (intern-str name) resolved)]
        [(AstTyEnumArgs name _)
          (tc-init-enum-supported ctx env (intern-str name) resolved)]
        [_ (ErrTcUnit (tc-init-unsupported-message ctx resolved))]))))

(define (tc-init-expr [ctx : TcContext] [env : TcTypeEnv] [ty : AstType]) : ResultTcType
  (let
    [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (match (tc-init-type-supported ctx env resolved)
      [(OkTcUnit) (OkTcType (tc-tag-active-region env resolved))]
      [(ErrTcUnit message) (ErrTcType message)])))

(define (tc-make-array-zero-literal-length? [len : AstExpr]) : bool
  (match (ast-expr-unspan len)
    [(AstExprLiteral (AstLitInt value _)) (= value 0)]
    [_ false]))

(define (tc-make-array-requires-element-init? [elem : AstType] [len : AstExpr]) : bool
  (not
    (and
      (tc-make-array-zero-literal-length? len)
      (not (tc-type-contains-reference? elem)))))

(define (tc-quasiquote-template-list-ok
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]) : ResultTcUnit
  (match exprs
    [(AstExprNil) OkTcUnit]
    [(AstExprCons head rest)
      (let
        [head : AstExpr (ast-node-get head)]
        [rest : AstExprList (box-get rest)]
        (match (tc-quasiquote-template-ok ctx env head)
          [(OkTcUnit) (tc-quasiquote-template-list-ok ctx env rest)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]))

(define (tc-quasiquote-template-ok
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]) : ResultTcUnit
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-quasiquote-template-ok ctx env inner))]
    [(AstExprUnquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-expr ctx env inner)
          [(OkTcType ty)
            (tc-expect ty (AstTyExpr) "typecheck: unquote expects Expr")]
          [(ErrTcType message) (ErrTcUnit message)]))]
    [(AstExprUnquoteSplicing inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-expr ctx env inner)
          [(OkTcType ty)
            (tc-expect
              ty
              (AstTyExprList)
              "typecheck: unquote-splicing expects ExprList")]
          [(ErrTcType message) (ErrTcUnit message)]))]
    [(AstExprBinary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (match (tc-quasiquote-template-ok ctx env left)
          [(OkTcUnit) (tc-quasiquote-template-ok ctx env right)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprUnary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-quasiquote-template-ok ctx env inner))]
    [(AstExprCall func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (match (tc-quasiquote-template-ok ctx env func)
          [(OkTcUnit) (tc-quasiquote-template-list-ok ctx env args)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprBracketClause items)
      (tc-quasiquote-template-list-ok ctx env items)]
    [(AstExprIf cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (match (tc-quasiquote-template-ok ctx env cond)
          [(OkTcUnit)
            (match (tc-quasiquote-template-ok ctx env then-branch)
              [(OkTcUnit) (tc-quasiquote-template-ok ctx env else-branch)]
              [(ErrTcUnit message) (ErrTcUnit message)])]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprTuple exprs) (tc-quasiquote-template-list-ok ctx env exprs)]
    [(AstExprArray exprs) (tc-quasiquote-template-list-ok ctx env exprs)]
    [(AstExprBegin exprs) (tc-quasiquote-template-list-ok ctx env exprs)]
    [(AstExprUnsafe exprs) (tc-quasiquote-template-list-ok ctx env exprs)]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-quasiquote-template-ok ctx env inner))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-quasiquote-template-ok ctx env inner))]
    [(AstExprBox inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-quasiquote-template-ok ctx env inner))]
    [(AstExprBoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-quasiquote-template-ok ctx env inner))]
    [(AstExprBoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-quasiquote-template-ok ctx env inner))]
    [(AstExprBoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-quasiquote-template-ok ctx env inner)
          [(OkTcUnit) (tc-quasiquote-template-ok ctx env value)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprComptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-quasiquote-template-ok ctx env inner))]
    [(AstExprReturn inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-quasiquote-template-ok ctx env inner))]
    [(AstExprQuote _) OkTcUnit]
    [(AstExprQuasiquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-quasiquote-template-ok ctx env inner))]
    [_ OkTcUnit]))

(define (tc-clone-out-unsupported-message
  [ctx : TcContext]
  [form : String]
  [ty : AstType]) : String
  (str_cat.str-cat
    "typecheck: "
    form
    " result type is not clone-supported: "
    (tc-type-render (tc-type-without-regions (tc-resolve-type ctx ty)))))

(define (tc-with-escape-unsupported-message [ctx : TcContext] [ty : AstType]) : String
  (tc-clone-out-unsupported-message ctx "with-escape" ty))

(define (tc-with-scratch-unsupported-message [ctx : TcContext] [ty : AstType]) : String
  (tc-clone-out-unsupported-message ctx "with-scratch" ty))

(define (tc-with-region-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [region : String]
  [body : AstExprList]) : ResultTcType
  (let
    [region-env : TcTypeEnv (tc-push-region env region)]
    (match (tc-begin-list ctx region-env body)
      [(OkTcType body-ty)
        (if (tc-type-contains-region body-ty region)
          (ErrTcType
            (string.string-append
              "typecheck: region-tagged value cannot escape with-arena '"
              (string.string-append region "'")))
          (OkTcType body-ty))]
      [(ErrTcType message) (ErrTcType message)])))

(define (tc-with-region-expr-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [region : String]
  [body : AstExprList]
  [expected : AstType]) : ResultTcType
  (let
    [region-env : TcTypeEnv (tc-push-region env region)]
    (match (tc-begin-list-with-expected ctx region-env body expected)
      [(OkTcType body-ty)
        (if (tc-type-contains-region body-ty region)
          (ErrTcType
            (string.string-append
              "typecheck: region-tagged value cannot escape with-arena '"
              (string.string-append region "'")))
          (OkTcType body-ty))]
      [(ErrTcType message) (ErrTcType message)])))

;; with-escape is a first-class scratch-arena clone path, not a lexical
;; lifetime binder. The scratch expression is just an arena handle, and
;; supported results leave the form with scratch-region tags erased.
(define (tc-with-escape-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scratch : AstExpr]
  [body : AstExprList]) : ResultTcType
  (match (tc-expr ctx env scratch)
    [(OkTcType scratch-ty)
      (if (tc-arena-type? ctx scratch-ty)
        (match (tc-begin-list ctx env body)
          [(OkTcType body-ty)
            (if (tc-clone-able-type? ctx body-ty)
              (OkTcType (tc-type-without-regions body-ty))
              (ErrTcType (tc-with-escape-unsupported-message ctx body-ty)))]
          [(ErrTcType message) (ErrTcType message)])
        (ErrTcType "typecheck: with-escape arena must be Arena"))]
    [(ErrTcType message) (ErrTcType message)]))

(define (tc-with-escape-expr-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scratch : AstExpr]
  [body : AstExprList]
  [expected : AstType]) : ResultTcType
  (match (tc-expr ctx env scratch)
    [(OkTcType scratch-ty)
      (if (tc-arena-type? ctx scratch-ty)
        (match (tc-begin-list-with-expected ctx env body expected)
          [(OkTcType body-ty)
            (if (tc-clone-able-type? ctx body-ty)
              (OkTcType (tc-type-without-regions body-ty))
              (ErrTcType (tc-with-escape-unsupported-message ctx body-ty)))]
          [(ErrTcType message) (ErrTcType message)])
        (ErrTcType "typecheck: with-escape arena must be Arena"))]
    [(ErrTcType message) (ErrTcType message)]))

(define (tc-with-scratch-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [body : AstExprList]) : ResultTcType
  (match (tc-begin-list ctx env body)
    [(OkTcType body-ty)
      (if (tc-clone-able-type? ctx body-ty)
        (OkTcType (tc-type-without-regions body-ty))
        (ErrTcType (tc-with-scratch-unsupported-message ctx body-ty)))]
    [(ErrTcType message) (ErrTcType message)]))

(define (tc-with-scratch-expr-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [body : AstExprList]
  [expected : AstType]) : ResultTcType
  (match (tc-begin-list-with-expected ctx env body expected)
    [(OkTcType body-ty)
      (if (tc-clone-able-type? ctx body-ty)
        (OkTcType (tc-type-without-regions body-ty))
        (ErrTcType (tc-with-scratch-unsupported-message ctx body-ty)))]
    [(ErrTcType message) (ErrTcType message)]))

(define (tc-in-arena-owner [env : TcTypeEnv] [arena : AstExpr]) : TcMaybeString
  (match (tc-expr-var-name arena)
    [(TcSomeString name)
      (if (or
        (tc-ordinary-arena-owner-active? env name)
        (tc-atomic-arena-owner-active? env name))
        (TcSomeString name)
        (TcNoString))]
    [(TcNoString) (TcNoString)]))

(define (tc-in-arena-body-env [env : TcTypeEnv] [arena : AstExpr]) : TcTypeEnv
  (match (tc-in-arena-owner env arena)
    [(TcSomeString owner) (tc-push-region env owner)]
    [(TcNoString) env]))

(define (tc-in-arena-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arena : AstExpr]
  [body : AstExprList]) : ResultTcType
  (match (tc-expr ctx env arena)
    [(OkTcType arena-ty)
      (if (tc-arena-type? ctx arena-ty)
        (tc-begin-list ctx (tc-in-arena-body-env env arena) body)
        (ErrTcType "typecheck: in-arena arena must be Arena"))]
    [(ErrTcType message) (ErrTcType message)]))

(define (tc-in-arena-expr-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arena : AstExpr]
  [body : AstExprList]
  [expected : AstType]) : ResultTcType
  (match (tc-expr ctx env arena)
    [(OkTcType arena-ty)
      (if (tc-arena-type? ctx arena-ty)
        (tc-begin-list-with-expected
          ctx
          (tc-in-arena-body-env env arena)
          body
          expected)
        (ErrTcType "typecheck: in-arena arena must be Arena"))]
    [(ErrTcType message) (ErrTcType message)]))

(define (tc-with-resource-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : AstResourceBindingList]
  [body : AstExprList]) : ResultTcType
  (match (tc-resource-bindings ctx env bindings)
    [(OkTcEnv body-env)
      (match (tc-begin-list ctx body-env body)
        [(OkTcType body-ty)
          (if (tc-expr-list-result-uses-cleanup-owner?
            body
            (tc-resource-binding-list-add-bound-names bindings TcStringNil)
            TcStringNil)
            (ErrTcType
              "typecheck: cleanup-required resource would escape with scope")
            (OkTcType body-ty))]
        [(ErrTcType message) (ErrTcType message)])]
    [(ErrTcEnv message) (ErrTcType message)]))

(define (tc-with-resource-expr-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : AstResourceBindingList]
  [body : AstExprList]
  [expected : AstType]) : ResultTcType
  (match (tc-resource-bindings ctx env bindings)
    [(OkTcEnv body-env)
      (match (tc-begin-list-with-expected ctx body-env body expected)
        [(OkTcType body-ty)
          (if (tc-expr-list-result-uses-cleanup-owner?
            body
            (tc-resource-binding-list-add-bound-names bindings TcStringNil)
            TcStringNil)
            (ErrTcType
              "typecheck: cleanup-required resource would escape with scope")
            (OkTcType body-ty))]
        [(ErrTcType message) (ErrTcType message)])]
    [(ErrTcEnv message) (ErrTcType message)]))

(define (tc-lambda-expr-with-capture-check
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]
  [maybe-ret : AstMaybeType]
  [body : AstExpr]
  [allow-immutable-reference-captures : bool]) : ResultTcType
  (match (if allow-immutable-reference-captures
    (tc-check-lambda-region-captures-allow-refs env params body)
    (tc-check-lambda-region-captures env params body))
    [(OkTcUnit)
      (let
        [lambda-env : TcTypeEnv
          (match maybe-ret
            [(AstSomeType ret)
              (tc-bind-return-type
                (tc-bind-params ctx env params)
                (tc-resolve-type ctx ret))]
            [(AstNoType)
              (tc-bind-return-type (tc-bind-params ctx env params) (AstTyNever))])]
        (match (match maybe-ret
          [(AstSomeType ret)
            (tc-expr-with-expected-or-actual
              ctx
              lambda-env
              body
              (tc-resolve-type ctx ret))]
          [(AstNoType) (tc-expr ctx lambda-env body)])
          [(OkTcType body-ty)
            (if (and
              (tc-type-contains-any-region body-ty)
              (not
                (tc-type-regions-all-atomic-arena-owners? lambda-env body-ty)))
              (ErrTcType
                "typecheck: lambda return value has region-tagged type; region value would escape")
              (match maybe-ret
                [(AstSomeType ret)
                  (match (tc-expect
                    body-ty
                    (tc-resolve-type ctx ret)
                    "typecheck: lambda return type mismatch")
                    [(OkTcUnit)
                      (OkTcType
                        (ast-ty-func
                          (tc-param-type-list ctx params)
                          (tc-resolve-type ctx ret)))]
                    [(ErrTcUnit message) (ErrTcType message)])]
                [(AstNoType)
                  (OkTcType
                    (ast-ty-func (tc-param-type-list ctx params) body-ty))]))]
          [(ErrTcType message) (ErrTcType message)]))]
    [(ErrTcUnit message) (ErrTcType message)]))

(define (tc-lambda-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]
  [maybe-ret : AstMaybeType]
  [body : AstExpr]) : ResultTcType
  (tc-lambda-expr-with-capture-check ctx env params maybe-ret body false))

(define (tc-lambda-expr-allow-ref-captures
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]
  [maybe-ret : AstMaybeType]
  [body : AstExpr]) : ResultTcType
  (tc-lambda-expr-with-capture-check ctx env params maybe-ret body true))

(define (tc-array-readable-receiver [ctx : TcContext] [receiver-ty : AstType]) : ResultTcArrayReceiver
  (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
    [(AstTyArray elem-ty _)
      (OkTcArrayReceiver (TcArrayReceiver receiver-ty (ty-node-get elem-ty)))]
    [(AstTyDynArray elem-ty)
      (OkTcArrayReceiver (TcArrayReceiver receiver-ty (ty-node-get elem-ty)))]
    [(AstTyRef _ referent-ty)
      (tc-array-readable-receiver ctx (ty-node-get referent-ty))]
    [(AstTyMutRef _ referent-ty)
      (tc-array-readable-receiver ctx (ty-node-get referent-ty))]
    [_ (ErrTcArrayReceiver "typecheck: array-ref requires array type")]))

(define (tc-array-set-receiver [ctx : TcContext] [receiver-ty : AstType]) : ResultTcArrayReceiver
  (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
    [(AstTyArray elem-ty _)
      (OkTcArrayReceiver (TcArrayReceiver receiver-ty (ty-node-get elem-ty)))]
    [(AstTyDynArray elem-ty)
      (OkTcArrayReceiver (TcArrayReceiver receiver-ty (ty-node-get elem-ty)))]
    [(AstTyMutRef _ referent-ty)
      (tc-array-set-receiver ctx (ty-node-get referent-ty))]
    [(AstTyRef _ _)
      (ErrTcArrayReceiver "typecheck: array-set! requires mutable array access")]
    [_ (ErrTcArrayReceiver "typecheck: array-set! requires array type")]))

(define (tc-array-push-receiver [ctx : TcContext] [receiver-ty : AstType]) : ResultTcArrayReceiver
  (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
    [(AstTyDynArray elem-ty)
      (OkTcArrayReceiver (TcArrayReceiver receiver-ty (ty-node-get elem-ty)))]
    [(AstTyArray _ _)
      (ErrTcArrayReceiver "typecheck: array-push! requires dynamic array type")]
    [(AstTyMutRef _ referent-ty)
      (tc-array-push-receiver ctx (ty-node-get referent-ty))]
    [(AstTyRef _ _)
      (ErrTcArrayReceiver
        "typecheck: array-push! requires mutable dynamic array access")]
    [_
      (ErrTcArrayReceiver "typecheck: array-push! requires dynamic array type")]))

(define (tc-array-mutation-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [array : AstExpr]
  [array-ty : AstType]
  [elem-ty : AstType]
  [value : AstExpr]
  [mismatch-message : String]) : ResultTcType
  (match (tc-expr-with-expected-or-actual ctx env value elem-ty)
    [(OkTcType value-ty)
      (match (tc-expect value-ty elem-ty mismatch-message)
        [(OkTcUnit)
          (match (tc-ensure-cleanup-resource-not-stored-expr env value)
            [(OkTcUnit)
              (match (tc-ensure-region-value-can-flow-into
                env
                array-ty
                value-ty
                "array")
                [(OkTcUnit)
                  (match (tc-ensure-reference-value-can-store-in-place
                    ctx
                    env
                    array
                    value-ty
                    "array")
                    [(OkTcUnit) (OkTcType (AstTyUnit))]
                    [(ErrTcUnit message) (ErrTcType message)])]
                [(ErrTcUnit message) (ErrTcType message)])]
            [(ErrTcUnit message) (ErrTcType message)])]
        [(ErrTcUnit message) (ErrTcType message)])]
    [(ErrTcType message) (ErrTcType message)]))

(define (tc-struct-set-field-type
  [ctx : TcContext]
  [receiver-ty : AstType]
  [field : String]) : ResultTcType
  (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
    [(AstTyStruct _) (tc-struct-get-result-type ctx receiver-ty field)]
    [(AstTyStructArgs _ _) (tc-struct-get-result-type ctx receiver-ty field)]
    [(AstTyMutRef _ _) (tc-struct-get-result-type ctx receiver-ty field)]
    [(AstTyRef _ _)
      (ErrTcType "typecheck: set! struct field requires mutable struct access")]
    [_ (ErrTcType "typecheck: set! struct field requires struct")]))

(define (tc-struct-field-mutation-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [receiver : AstExpr]
  [field : String]
  [value : AstExpr]) : ResultTcType
  (match (tc-store-place-lifetime ctx env receiver)
    [(OkTcString _)
      (match (tc-expr ctx env receiver)
        [(OkTcType receiver-ty)
          (match (tc-struct-set-field-type ctx receiver-ty field)
            [(OkTcType field-ty)
              (match (tc-expr-with-expected-or-actual ctx env value field-ty)
                [(OkTcType value-ty)
                  (match (tc-expect
                    value-ty
                    field-ty
                    "typecheck: struct field assignment type mismatch")
                    [(OkTcUnit)
                      (match (tc-ensure-cleanup-resource-not-stored-expr
                        env
                        value)
                        [(OkTcUnit)
                          (match (tc-ensure-region-value-can-flow-into
                            env
                            field-ty
                            value-ty
                            "struct field")
                            [(OkTcUnit)
                              (match (tc-ensure-reference-value-can-store-in-place
                                ctx
                                env
                                receiver
                                value-ty
                                "struct field")
                                [(OkTcUnit) (OkTcType (AstTyUnit))]
                                [(ErrTcUnit message) (ErrTcType message)])]
                            [(ErrTcUnit message) (ErrTcType message)])]
                        [(ErrTcUnit message) (ErrTcType message)])]
                    [(ErrTcUnit message) (ErrTcType message)])]
                [(ErrTcType message) (ErrTcType message)])]
            [(ErrTcType message) (ErrTcType message)])]
        [(ErrTcType message) (ErrTcType message)])]
    [(ErrTcString message) (ErrTcType message)]))

(define (tc-expr [ctx : TcContext] [env : TcTypeEnv] [expr : AstExpr]) : ResultTcType
  (match expr
    [(AstExprSpanned inner-box span)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [result : ResultTcType
          (match inner
            [(AstExprUnsafe exprs)
              (tc-unsafe-begin-list ctx env exprs (TcSomeAstSourceSpan span))]
            [_ (tc-expr-id ctx env inner-box)])]
        (match result
          [(OkTcType ty) (OkTcType ty)]
          [(ErrTcType message) (tc-locate-spanned-error inner span message)]))]
    [(AstExprLiteral lit) (tc-literal-type-checked lit)]
    [(AstExprBinaryData _) (OkTcType (ast-ty-dyn-array (AstTyU8)))]
    [(AstExprVar name)
      (let
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-expr-id env name-text)
            [(OkTcExprId virtual-id) (tc-expr-id ctx env virtual-id)]
            [(ErrTcExprId message) (ErrTcType message)])
          (if (tc-hygiene-global-name? name-text)
            (match (tc-hygiene-global-decode name-text)
              [(TcHygieneLegacyGlobal global-name)
                (let
                  [global-id : i64 (tc-name-id global-name)]
                  (if (tc-hygiene-global-binding-unsafe? env global-name)
                    (match (tc-require-unsafe env global-name)
                      [(OkTcUnit)
                        (tc-lookup-hygiene-global-visible-id ctx env global-id)]
                      [(ErrTcUnit message) (ErrTcType message)])
                    (tc-lookup-hygiene-global-visible-id ctx env global-id)))]
              [(TcHygieneContextGlobal module global-name)
                (tc-lookup-hygiene-context-global-visible-id
                  ctx
                  env
                  module
                  (tc-name-id global-name))])
            (match (tc-source-name-lookup-key-after-local-field-check
              ctx
              env
              name-text)
              [(OkTcString lookup-name)
                (let
                  [lookup-id : i64 (tc-name-id lookup-name)]
                  (match (tc-lookup-unsafe-id env lookup-id)
                    [(OkTcTypeUnsafe ty unsafe)
                      (if unsafe
                        (match (tc-require-unsafe
                          env
                          (tc-source-lookup-display-name
                            ctx
                            name-text
                            lookup-name))
                          [(OkTcUnit)
                            (match (tc-unqualified-import-ambiguity-message
                              ctx
                              env
                              name)
                              [(TcNoString) (OkTcType ty)]
                              [(TcSomeString message) (ErrTcType message)])]
                          [(ErrTcUnit message) (ErrTcType message)])
                        (match (tc-unqualified-import-ambiguity-message
                          ctx
                          env
                          name)
                          [(TcNoString) (OkTcType ty)]
                          [(TcSomeString message) (ErrTcType message)]))]
                    [(ErrTcTypeUnsafe message)
                      (tc-variant-constructor-type-for-lookup-or
                        ctx
                        lookup-name
                        (tc-source-lookup-display-name
                          ctx
                          name-text
                          lookup-name)
                        (tc-source-unbound-display-message
                          ctx
                          name-text
                          lookup-name
                          message))]))]
              [(ErrTcString message) (ErrTcType message)]))))]
    [(AstExprTypeLiteral ty)
      (ErrTcType
        (string.string-append
          "type value "
          (string.string-append
            (tc-type-render (tc-resolve-type ctx ty))
            " is compile-time only")))]
    [(AstExprInit maybe-ty)
      (match maybe-ty
        [(AstSomeType ty) (tc-init-expr ctx env ty)]
        [(AstNoType)
          (ErrTcType
            "typecheck: contextual init requires an expected type; use (init : T) or add an annotation")])]
    [(AstExprAnn inner-box ty)
      (let
        [want-ty : AstType (tc-resolve-type ctx ty)]
        (match (tc-expr-with-expected-or-actual-id ctx env inner-box want-ty)
          [(OkTcType got)
            (match (tc-expect got want-ty "typecheck: annotation type mismatch")
              [(OkTcUnit)
                (OkTcType
                  (if (tc-type-contains-any-region got)
                    got
                    want-ty))]
              [(ErrTcUnit message) (ErrTcType message)])]
          [(ErrTcType message) (ErrTcType message)]))]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-let-bindings-for-body ctx env bindings body)
              [(OkTcEnv next-env)
                (match (tc-expr-id ctx next-env body-box)
                  [(OkTcType body-ty)
                    (match (tc-ensure-reference-type-does-not-escape-names
                      body-ty
                      (tc-let-binding-list-add-bound-names bindings TcStringNil))
                      [(OkTcUnit) (OkTcType body-ty)]
                      [(ErrTcUnit message) (ErrTcType message)])]
                  [(ErrTcType message) (ErrTcType message)])]
              [(ErrTcEnv message) (ErrTcType message)]))])]
    [(AstExprLambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda params maybe-ret body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (tc-lambda-expr ctx env params maybe-ret body))])]
    [(AstExprTuple exprs)
      (match (tc-ensure-cleanup-resource-not-stored-list env exprs)
        [(OkTcUnit)
          (match (tc-expr-list-types ctx env exprs)
            [(OkTcTypeList tys)
              (OkTcType (tc-tag-active-region env (ast-ty-tuple tys)))]
            [(ErrTcTypeList message) (ErrTcType message)])]
        [(ErrTcUnit message) (ErrTcType message)])]
    [(AstExprTupleRef tuple-box index)
      (match (tc-expr-id ctx env tuple-box)
        [(OkTcType tuple-ty)
          (match (tc-type-strip-region tuple-ty)
            [(AstTyTuple tys)
              (match (tc-type-list-ref (box-get tys) index)
                [(OkTcType elem-ty)
                  (OkTcType (tc-project-from-region-container tuple-ty elem-ty))]
                [(ErrTcType message) (ErrTcType message)])]
            [_ (ErrTcType "typecheck: tuple-ref requires tuple type")])]
        [(ErrTcType message) (ErrTcType message)])]
    [(AstExprArray exprs)
      (match (tc-ensure-cleanup-resource-not-stored-list env exprs)
        [(OkTcUnit)
          (match exprs
            [(AstExprNil)
              (ErrTcType "typecheck: cannot infer type of empty array")]
            [(AstExprCons first rest)
              (let
                [rest : AstExprList (box-get rest)]
                (match (tc-expr-id ctx env first)
                  [(OkTcType first-ty)
                    (match (tc-check-array-rest ctx env rest first-ty)
                      [(OkTcUnit)
                        (OkTcType
                          (ast-ty-array first-ty (tc-expr-list-len exprs)))]
                      [(ErrTcUnit message) (ErrTcType message)])]
                  [(ErrTcType message) (ErrTcType message)]))])]
        [(ErrTcUnit message) (ErrTcType message)])]
    [(AstExprMakeArray elem-ty len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        [elem : AstType (tc-resolve-type ctx elem-ty)]
        (match (tc-expr-with-expected-or-actual-id ctx env len-box (AstTyI64))
          [(OkTcType len-ty)
            (cond
              [(not (tc-integer-type? len-ty))
                (ErrTcType "typecheck: make-array length must be integer")]
              [(not (tc-dyn-array-elem-supported? env elem))
                (ErrTcType
                  "typecheck: make-array element type is not supported")]
              [(not (tc-make-array-requires-element-init? elem len))
                (OkTcType (tc-tag-active-region env (ast-ty-dyn-array elem)))]
              [else
                (match (tc-init-type-supported ctx env elem)
                  [(OkTcUnit)
                    (OkTcType
                      (tc-tag-active-region env (ast-ty-dyn-array elem)))]
                  [(ErrTcUnit message) (ErrTcType message)])])]
          [(ErrTcType message) (ErrTcType message)]))]
    [(AstExprArrayRef array-box index-box)
      (match (tc-expr-id ctx env array-box)
        [(OkTcType array-ty)
          (match (tc-expr-with-expected-or-actual-id
            ctx
            env
            index-box
            (AstTyI64))
            [(OkTcType index-ty)
              (if (tc-integer-type? index-ty)
                (match (tc-array-readable-receiver ctx array-ty)
                  [(OkTcArrayReceiver receiver)
                    (match receiver
                      [(TcArrayReceiver container-ty elem-ty)
                        (OkTcType
                          (tc-project-from-region-container
                            container-ty
                            elem-ty))])]
                  [(ErrTcArrayReceiver message) (ErrTcType message)])
                (ErrTcType "typecheck: array index must be integer"))]
            [(ErrTcType message) (ErrTcType message)])]
        [(ErrTcType message) (ErrTcType message)])]
    [(AstExprArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-expr-id ctx env array-box)
          [(OkTcType array-ty)
            (match (tc-expr-with-expected-or-actual-id
              ctx
              env
              index-box
              (AstTyI64))
              [(OkTcType index-ty)
                (if (tc-integer-type? index-ty)
                  (match (tc-array-set-receiver ctx array-ty)
                    [(OkTcArrayReceiver receiver)
                      (match receiver
                        [(TcArrayReceiver container-ty elem-ty)
                          (tc-array-mutation-value
                            ctx
                            env
                            array
                            container-ty
                            elem-ty
                            value
                            "typecheck: array-set! value type mismatch")])]
                    [(ErrTcArrayReceiver message) (ErrTcType message)])
                  (ErrTcType "typecheck: array index must be integer"))]
              [(ErrTcType message) (ErrTcType message)])]
          [(ErrTcType message) (ErrTcType message)]))]
    [(AstExprArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-expr-id ctx env array-box)
          [(OkTcType array-ty)
            (match (tc-array-push-receiver ctx array-ty)
              [(OkTcArrayReceiver receiver)
                (match receiver
                  [(TcArrayReceiver container-ty elem-ty)
                    (tc-array-mutation-value
                      ctx
                      env
                      array
                      container-ty
                      elem-ty
                      value
                      "typecheck: array-push! value type mismatch")])]
              [(ErrTcArrayReceiver message) (ErrTcType message)])]
          [(ErrTcType message) (ErrTcType message)]))]
    [(AstExprStringRef str-box index-box)
      (match (tc-expr-id ctx env str-box)
        [(OkTcType str-ty)
          (match (tc-expect
            str-ty
            (AstTyString)
            "typecheck: string-ref requires String")
            [(OkTcUnit)
              (match (tc-expr-with-expected-or-actual-id
                ctx
                env
                index-box
                (AstTyI64))
                [(OkTcType index-ty)
                  (if (tc-integer-type? index-ty)
                    (OkTcType (AstTyChar))
                    (ErrTcType "typecheck: string index must be integer"))]
                [(ErrTcType message) (ErrTcType message)])]
            [(ErrTcUnit message) (ErrTcType message)])]
        [(ErrTcType message) (ErrTcType message)])]
    [(AstExprBegin exprs) (tc-begin-list ctx env exprs)]
    ;; `(unsafe ...)` types like `begin` in v1; the unsafe-context flag for
    ;; raw-pointer ops is added with their checks (#955).
    [(AstExprUnsafe exprs)
      (tc-unsafe-begin-list ctx env exprs TcNoAstSourceSpan)]
    [(AstExprIf cond-box then-branch-box else-branch-box)
      (match (tc-expr-id ctx env cond-box)
        [(OkTcType cond-ty)
          (match (tc-expect
            cond-ty
            (AstTyBool)
            "typecheck: if condition must be bool")
            [(OkTcUnit)
              (match (tc-expr-id ctx env then-branch-box)
                [(OkTcType then-ty)
                  (match (tc-expr-id ctx env else-branch-box)
                    [(OkTcType else-ty) (tc-merge-branch-type then-ty else-ty)]
                    [(ErrTcType message) (ErrTcType message)])]
                [(ErrTcType message) (ErrTcType message)])]
            [(ErrTcUnit message) (ErrTcType message)])]
        [(ErrTcType message) (ErrTcType message)])]
    [(AstExprSet name value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-set-expr-id env name-text value-box)
            [(OkTcExprId virtual-id) (tc-expr-id ctx env virtual-id)]
            [(ErrTcExprId message) (ErrTcType message)])
          (match (tc-lookup-visible-id ctx env name)
            [(OkTcType var-ty)
              (match (tc-expr-with-expected-or-actual-id
                ctx
                env
                value-box
                var-ty)
                [(OkTcType value-ty)
                  (match (tc-expect
                    value-ty
                    var-ty
                    "typecheck: assignment type mismatch")
                    [(OkTcUnit)
                      (match (tc-ensure-cleanup-resource-not-assigned env value)
                        [(OkTcUnit)
                          (match (tc-ensure-region-value-can-flow-into
                            env
                            var-ty
                            value-ty
                            "assignment")
                            [(OkTcUnit)
                              (match (tc-ensure-reference-value-can-assign
                                env
                                name-text
                                value-ty)
                                [(OkTcUnit) (OkTcType (AstTyUnit))]
                                [(ErrTcUnit message) (ErrTcType message)])]
                            [(ErrTcUnit message) (ErrTcType message)])]
                        [(ErrTcUnit message) (ErrTcType message)])]
                    [(ErrTcUnit message) (ErrTcType message)])]
                [(ErrTcType message) (ErrTcType message)])]
            [(ErrTcType message) (ErrTcType message)])))]
    [(AstExprCast inner-box ty)
      (match (tc-expr-id ctx env inner-box)
        [(OkTcType inner-ty)
          (let
            [target-ty : AstType (tc-resolve-type ctx ty)]
            (if (and (tc-castable-type? inner-ty) (tc-castable-type? target-ty))
              (OkTcType target-ty)
              (if (tc-function-to-integer-cast? inner-ty target-ty)
                (match (tc-require-unsafe env "function-to-integer cast")
                  [(OkTcUnit) (OkTcType target-ty)]
                  [(ErrTcUnit message) (ErrTcType message)])
                (ErrTcType
                  "typecheck: cast requires scalar numeric (integer/char/float) source and target"))))]
        [(ErrTcType message) (ErrTcType message)])]
    [(AstExprBorrow mutable lifetime place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (tc-borrow-expr ctx env mutable lifetime place))]
    [(AstExprUnary op inner-box)
      (match (tc-expr-id ctx env inner-box)
        [(OkTcType ty) (tc-unop-type op ty)]
        [(ErrTcType message) (ErrTcType message)])]
    [(AstExprBinary op left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (match (tc-binop-expr-types ctx env op left right)
          [(OkTcBinOpTypes binop-types)
            (match binop-types
              [(TcBinOpTypes _ _ result-ty) (OkTcType result-ty)])]
          [(ErrTcBinOpTypes message) (ErrTcType message)]))]
    [(AstExprCall func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (tc-call-or-array-length ctx env func args))]
    [(AstExprBracketClause _)
      (ErrTcType
        "typecheck: bracket clause is only valid as an ExprClause or ExprBindingClause macro operand")]
    [(AstExprWhile cond-box body-box)
      (match (tc-expr-id ctx env cond-box)
        [(OkTcType cond-ty)
          (match (tc-expect
            cond-ty
            (AstTyBool)
            "typecheck: while condition must be bool")
            [(OkTcUnit)
              (match (tc-expr-id ctx env body-box)
                [(OkTcType body-ty)
                  (match (tc-expect
                    body-ty
                    (AstTyUnit)
                    "typecheck: while body must be unit")
                    [(OkTcUnit) (OkTcType (AstTyUnit))]
                    [(ErrTcUnit message) (ErrTcType message)])]
                [(ErrTcType message) (ErrTcType message)])]
            [(ErrTcUnit message) (ErrTcType message)])]
        [(ErrTcType message) (ErrTcType message)])]
    [(AstExprForeach fe-box)
      (match (box-get fe-box)
        [(AstForeach index index-ty start-box end-box body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            [resolved-index-ty : AstType (tc-resolve-type ctx index-ty)]
            (if (tc-integer-type? resolved-index-ty)
              (match (tc-expr-with-expected-or-actual-id
                ctx
                env
                start-box
                resolved-index-ty)
                [(OkTcType start-ty)
                  (if (tc-integer-type? start-ty)
                    (match (tc-expr-with-expected-or-actual-id
                      ctx
                      env
                      end-box
                      resolved-index-ty)
                      [(OkTcType end-ty)
                        (if (tc-integer-type? end-ty)
                          (let
                            [body-env : TcTypeEnv
                              (tc-bind-id env index resolved-index-ty)]
                            (match (tc-expr-id ctx body-env body-box)
                              [(OkTcType body-ty)
                                (match (tc-expect
                                  body-ty
                                  (AstTyUnit)
                                  "typecheck: foreach body must be unit")
                                  [(OkTcUnit)
                                    (match (tc-spmd-check-foreach-body
                                      ctx
                                      env
                                      (intern-str index)
                                      resolved-index-ty
                                      body)
                                      [(OkTcUnit) (OkTcType (AstTyUnit))]
                                      [(ErrTcUnit message) (ErrTcType message)])]
                                  [(ErrTcUnit message) (ErrTcType message)])]
                              [(ErrTcType message) (ErrTcType message)]))
                          (ErrTcType
                            "typecheck: foreach end expression must be integer"))]
                      [(ErrTcType message) (ErrTcType message)])
                    (ErrTcType
                      "typecheck: foreach start expression must be integer"))]
                [(ErrTcType message) (ErrTcType message)])
              (ErrTcType "typecheck: foreach index type must be integer")))])]
    [(AstExprSpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce op index index-ty start-box end-box init-box value-box)
          (let
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [resolved-index-ty : AstType (tc-resolve-type ctx index-ty)]
            (if (tc-integer-type? resolved-index-ty)
              (match (tc-expr-id ctx env start-box)
                [(OkTcType start-ty)
                  (if (tc-integer-type? start-ty)
                    (match (tc-expr-id ctx env end-box)
                      [(OkTcType end-ty)
                        (if (tc-integer-type? end-ty)
                          (let
                            [value-env : TcTypeEnv
                              (tc-bind-id env index resolved-index-ty)]
                            (match (tc-spmd-reduce-init-value-type
                              ctx
                              env
                              value-env
                              op
                              init
                              value)
                              [(OkTcType result-ty)
                                (match (tc-spmd-check-reduce-value-broadcasts
                                  ctx
                                  env
                                  (intern-str index)
                                  resolved-index-ty
                                  value)
                                  [(OkTcUnit) (OkTcType result-ty)]
                                  [(ErrTcUnit message) (ErrTcType message)])]
                              [(ErrTcType message) (ErrTcType message)]))
                          (ErrTcType
                            "typecheck: spmd-reduce end expression must be integer"))]
                      [(ErrTcType message) (ErrTcType message)])
                    (ErrTcType
                      "typecheck: spmd-reduce start expression must be integer"))]
                [(ErrTcType message) (ErrTcType message)])
              (ErrTcType "typecheck: spmd-reduce index type must be integer")))])]
    [(AstExprSpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan
            op
            index
            index-ty
            start-box
            end-box
            prefix
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            [resolved-index-ty : AstType (tc-resolve-type ctx index-ty)]
            [resolved-prefix-ty : AstType (tc-resolve-type ctx prefix-ty)]
            (if (tc-integer-type? resolved-index-ty)
              (match (tc-expr-with-expected-or-actual-id
                ctx
                env
                start-box
                resolved-index-ty)
                [(OkTcType start-ty)
                  (if (tc-integer-type? start-ty)
                    (match (tc-expr-with-expected-or-actual-id
                      ctx
                      env
                      end-box
                      resolved-index-ty)
                      [(OkTcType end-ty)
                        (if (tc-integer-type? end-ty)
                          (let
                            [value-env : TcTypeEnv
                              (tc-bind-id env index resolved-index-ty)]
                            [body-env : TcTypeEnv
                              (tc-bind-id value-env prefix resolved-prefix-ty)]
                            (match (tc-spmd-scan-init-value-type
                              ctx
                              env
                              value-env
                              op
                              resolved-prefix-ty
                              init
                              value)
                              [(OkTcType _)
                                (match (tc-expr-id ctx body-env body-box)
                                  [(OkTcType body-ty)
                                    (match (tc-expect
                                      body-ty
                                      (AstTyUnit)
                                      "typecheck: spmd-scan body must be unit")
                                      [(OkTcUnit)
                                        (match (tc-spmd-check-scan-body
                                          ctx
                                          env
                                          (intern-str index)
                                          resolved-index-ty
                                          (intern-str prefix)
                                          resolved-prefix-ty
                                          body)
                                          [(OkTcUnit) (OkTcType (AstTyUnit))]
                                          [(ErrTcUnit message)
                                            (ErrTcType message)])]
                                      [(ErrTcUnit message) (ErrTcType message)])]
                                  [(ErrTcType message) (ErrTcType message)])]
                              [(ErrTcType message) (ErrTcType message)]))
                          (ErrTcType
                            "typecheck: spmd-scan end expression must be integer"))]
                      [(ErrTcType message) (ErrTcType message)])
                    (ErrTcType
                      "typecheck: spmd-scan start expression must be integer"))]
                [(ErrTcType message) (ErrTcType message)])
              (ErrTcType "typecheck: spmd-scan index type must be integer")))])]
    [(AstExprSpmdBroadcast value-box lane-box)
      (match (tc-expr-with-expected-or-actual-id ctx env lane-box (AstTyI64))
        [(OkTcType lane-ty)
          (match (tc-expect
            (tc-resolve-type ctx lane-ty)
            (AstTyI64)
            "typecheck: spmd-broadcast lane must have type i64")
            [(OkTcUnit)
              (match (tc-expr-id ctx env value-box)
                [(OkTcType value-ty)
                  (if (tc-spmd-broadcast-type-supported?
                    (tc-resolve-type ctx value-ty))
                    (OkTcType value-ty)
                    (ErrTcType (tc-spmd-broadcast-type-message)))]
                [(ErrTcType message) (ErrTcType message)])]
            [(ErrTcUnit message) (ErrTcType message)])]
        [(ErrTcType message) (ErrTcType message)])]
    [(AstExprSpmdShuffle value-box lane-box)
      (match (tc-expr-with-expected-or-actual-id ctx env lane-box (AstTyI64))
        [(OkTcType lane-ty)
          (match (tc-expect
            (tc-resolve-type ctx lane-ty)
            (AstTyI64)
            "typecheck: spmd-shuffle lane must have type i64")
            [(OkTcUnit)
              (match (tc-expr-id ctx env value-box)
                [(OkTcType value-ty)
                  (if (tc-spmd-broadcast-type-supported?
                    (tc-resolve-type ctx value-ty))
                    (OkTcType value-ty)
                    (ErrTcType (tc-spmd-shuffle-type-message)))]
                [(ErrTcType message) (ErrTcType message)])]
            [(ErrTcUnit message) (ErrTcType message)])]
        [(ErrTcType message) (ErrTcType message)])]
    [(AstExprSpmdProgramIndex) (OkTcType (AstTyI64))]
    [(AstExprSpmdProgramCount) (OkTcType (AstTyI64))]
    [(AstExprMatch match-box)
      (match (box-get match-box)
        [(AstMatch scrutinee-box arms)
          (match (tc-expr-id ctx env scrutinee-box)
            [(OkTcType scrut-ty) (tc-match-expr ctx env scrut-ty arms)]
            [(ErrTcType message) (ErrTcType message)])])]
    [(AstExprStructGet receiver-box field)
      (match (tc-expr-id ctx env receiver-box)
        [(OkTcType receiver-ty)
          (tc-struct-get-result-type ctx receiver-ty (intern-str field))]
        [(ErrTcType message) (ErrTcType message)])]
    [(AstExprStructSet receiver-box field value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-struct-field-mutation-value
          ctx
          env
          receiver
          (intern-str field)
          value))]
    [(AstExprWithRegion region body) (tc-with-region-expr ctx env region body)]
    [(AstExprWithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (tc-with-escape-expr ctx env scratch body))]
    [(AstExprWithScratch body) (tc-with-scratch-expr ctx env body)]
    [(AstExprInArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (tc-in-arena-expr ctx env arena body))]
    [(AstExprWithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource bindings body)
          (tc-with-resource-expr ctx env bindings body)])]
    [(AstExprBox inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-box-expr ctx env inner))]
    [(AstExprBoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-box-get-expr ctx env inner))]
    [(AstExprBoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-box-take-expr ctx env inner))]
    [(AstExprBoxSet box-box value-box)
      (let
        [box-expr : AstExpr (ast-node-get box-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-box-mutation-value ctx env box-expr value))]
    [(AstExprComptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (compiler-ctfe-eval inner (tc-ctfe-env ctx) (ctfe-fuel-limit))
          [(OkCtfe value _) (tc-ctfe-value-type ctx value)]
          [(ErrCtfe diag)
            (ErrTcType (compiler-diagnostic-message (box-get diag)))]))]
    [(AstExprQuote _) (OkTcType (AstTyExpr))]
    [(AstExprQuasiquote template-box)
      (let
        [template : AstExpr (ast-node-get template-box)]
        (match (tc-quasiquote-template-ok ctx env template)
          [(OkTcUnit) (OkTcType (AstTyExpr))]
          [(ErrTcUnit message) (ErrTcType message)]))]
    [(AstExprUnquote _)
      (ErrTcType "typecheck: unquote is only valid inside quasiquote")]
    [(AstExprUnquoteSplicing _)
      (ErrTcType "typecheck: unquote-splicing is only valid inside quasiquote")]
    [(AstExprTry inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-try-expr ctx env inner))]
    [(AstExprReturn value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-return-expr ctx env value))]
    [(AstExprPtrNull ty)
      (let
        [resolved : AstType (tc-resolve-type ctx ty)]
        (match resolved
          [(AstTyPtr _) (OkTcType resolved)]
          [(AstTyMutPtr _) (OkTcType resolved)]
          [_
            (ErrTcType
              "typecheck: ptr-null requires a pointer type, e.g. (ptr-null : (Ptr i64))")]))]
    [(AstExprPtrNullCheck inner-box)
      (match (tc-expr-id ctx env inner-box)
        [(OkTcType inner-ty)
          (match (tc-type-strip-region inner-ty)
            [(AstTyPtr _) (OkTcType (AstTyBool))]
            [(AstTyMutPtr _) (OkTcType (AstTyBool))]
            [_
              (ErrTcType "typecheck: ptr-null? requires a raw pointer operand")])]
        [(ErrTcType message) (ErrTcType message)])]
    [(AstExprPtrAddrOf name) (tc-ptr-addr-of-expr ctx env (intern-str name))]
    [(AstExprPtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-ptr-read-expr ctx env ptr))]
    [(AstExprPtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-ptr-write-expr ctx env ptr value))]
    [(AstExprPtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (tc-ptr-offset-expr ctx env ptr offset))]
    [(AstExprPtrCast ptr-box target)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-ptr-cast-expr ctx env ptr target))]
    [(AstExprPtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-ptr-to-int-expr ctx env ptr))]
    [(AstExprIntToPtr value-box target)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-int-to-ptr-expr ctx env value target))]
    [(AstExprStringData str-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        (tc-string-data-expr ctx env str))]
    [(AstExprStringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (tc-string-from-bytes-expr ctx env ptr len))]
    [(AstExprArrayData array-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-array-data-expr ctx env array))]
    [(AstExprProgramArgc) (OkTcType (AstTyI64))]
    [(AstExprProgramArgv) (tc-program-entry-ptr-expr env "program-argv")]
    [(AstExprProgramEnvp) (tc-program-entry-ptr-expr env "program-envp")]
    [(AstExprCpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-cpuid-expr ctx env leaf subleaf))]
    [(AstExprCpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-cpuid-expr ctx env leaf subleaf))]
    [(AstExprCpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-cpuid-expr ctx env leaf subleaf))]
    [(AstExprCpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-cpuid-expr ctx env leaf subleaf))]
    [(AstExprXgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (tc-xgetbv-expr ctx env index))]
    [(AstExprSyscall args) (tc-syscall-expr ctx env args)]
    [_ (ErrTcType "typecheck: unsupported expression")]))

(define (tc-extern-abi-enum-aggregate-type? [ty : AstType]) : bool
  (match (tc-type-without-regions ty)
    [(AstTyEnum _) true]
    [(AstTyEnumArgs _ _) true]
    [_ false]))

(define (tc-extern-abi-inline-enum-type-ok? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-without-regions ty)
    [(AstTyEnum name)
      (match (tc-inline-aggregate-layout-for ctx (intern-str name))
        [(OkTcInlineAggregateLayout layout)
          (match layout
            [(TcInlineEnumLayout _ _ _) true]
            [_ false])]
        [(ErrTcInlineAggregateLayout _) false])]
    [(AstTyEnumArgs name _)
      (match (tc-inline-aggregate-layout-for ctx (intern-str name))
        [(OkTcInlineAggregateLayout layout)
          (match layout
            [(TcInlineEnumLayout _ _ _) true]
            [_ false])]
        [(ErrTcInlineAggregateLayout _) false])]
    [_ false]))

(define (tc-extern-abi-value-type-ok? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-without-regions ty)
    [(AstTyI64) true]
    [(AstTyI32) true]
    [(AstTyI16) true]
    [(AstTyI8) true]
    [(AstTyU64) true]
    [(AstTyU32) true]
    [(AstTyU16) true]
    [(AstTyU8) true]
    [(AstTyF64) true]
    [(AstTyF32) true]
    [(AstTyBool) true]
    [(AstTyChar) true]
    [(AstTyUnit) true]
    [(AstTyNever) true]
    [(AstTyFunc _ _) true]
    [(AstTyPtr _) true]
    [(AstTyMutPtr _) true]
    [(AstTyString) true]
    [(AstTyDynArray _) true]
    [(AstTyEnum _) (tc-extern-abi-inline-enum-type-ok? ctx ty)]
    [(AstTyEnumArgs _ _) (tc-extern-abi-inline-enum-type-ok? ctx ty)]
    [(AstTyStruct _) true]
    [(AstTyStructArgs _ _) true]
    [_ false]))

(define (tc-extern-abi-unsupported-message [position : String] [ty : AstType]) : String
  (if (tc-extern-abi-enum-aggregate-type? ty)
    (string.string-append
      "typecheck: extern ABI c does not support enum aggregate "
      (string.string-append
        position
        (string.string-append " type " (tc-type-render ty))))
    (string.string-append
      "typecheck: extern ABI c does not support "
      (string.string-append
        position
        (string.string-append " type " (tc-type-render ty))))))

(define (tc-check-extern-arg-abi [ctx : TcContext] [args : AstTypeList]) : ResultTcUnit
  (match args
    [(AstTypeNil) OkTcUnit]
    [(AstTypeCons head rest)
      (let
        [head : AstType (ty-node-get head)]
        [rest : AstTypeList (box-get rest)]
        (if (tc-extern-abi-value-type-ok? ctx head)
          (tc-check-extern-arg-abi ctx rest)
          (ErrTcUnit (tc-extern-abi-unsupported-message "parameter" head))))]))

(define (tc-check-extern-c-abi [ctx : TcContext] [ty : AstType]) : ResultTcUnit
  (match ty
    [(AstTyFunc args ret)
      (match (tc-check-extern-arg-abi ctx (box-get args))
        [(OkTcUnit)
          (if (tc-extern-abi-value-type-ok? ctx (ty-node-get ret))
            OkTcUnit
            (ErrTcUnit
              (tc-extern-abi-unsupported-message "return" (ty-node-get ret))))]
        [(ErrTcUnit message) (ErrTcUnit message)])]
    [_ (ErrTcUnit "typecheck: extern must have function type")]))

(define (tc-check-extern-value-c-abi [ctx : TcContext] [ty : AstType]) : ResultTcUnit
  (match ty
    [(AstTyFunc _ _) (tc-check-extern-c-abi ctx ty)]
    [_
      (if (tc-extern-abi-value-type-ok? ctx ty)
        OkTcUnit
        (ErrTcUnit (tc-extern-abi-unsupported-message "value" ty)))]))

(define (tc-check-extern-varargs-tail-type
  [ctx : TcContext]
  [abi : AstExternAbi]) : ResultTcUnit
  (if (ast-extern-abi-c-varargs-typed? abi)
    (let
      [tail-ty : AstType
        (tc-resolve-type ctx (ast-extern-abi-varargs-tail-type abi))]
      (if (tc-extern-abi-value-type-ok? ctx tail-ty)
        OkTcUnit
        (ErrTcUnit
          (tc-extern-abi-unsupported-message "variadic argument" tail-ty))))
    OkTcUnit))

(define (tc-check-extern-decl
  [ctx : TcContext]
  [kind : AstExternKind]
  [metadata : AstExternMetadata]
  [ty : AstType]) : ResultTcUnit
  (match metadata
    [(AstExternMetadata abi _ _ explicit-abi)
      (let
        [resolved : AstType (tc-resolve-type ctx ty)]
        (match kind
          [(AstExternFunction)
            (if (and
              (ast-extern-abi-c? abi)
              (or explicit-abi (ast-extern-abi-c-varargs? abi)))
              (match (tc-check-extern-c-abi ctx resolved)
                [(OkTcUnit)
                  (if (ast-extern-abi-c-varargs? abi)
                    (tc-check-extern-varargs-tail-type ctx abi)
                    OkTcUnit)]
                [(ErrTcUnit message) (ErrTcUnit message)])
              OkTcUnit)]
          [(AstExternValue)
            (if (ast-extern-abi-c-varargs? abi)
              (ErrTcUnit "typecheck: extern value cannot use c-varargs ABI")
              (tc-check-extern-value-c-abi ctx resolved))]))]))

(define (tc-summary-add-decl
  [summary : CompilerTypecheckSummary]
  [decl : AstDecl]) : CompilerTypecheckSummary
  (match summary
    [(CompilerTypecheckSummary values functions externs)
      (match decl
        [(AstDeclDef _ _ _)
          (CompilerTypecheckSummary (+ values 1) functions externs)]
        [(AstDeclDefFn _ _ _ _ _)
          (CompilerTypecheckSummary values (+ functions 1) externs)]
        [(AstDeclExtern _ _ _ _)
          (CompilerTypecheckSummary values functions (+ externs 1))]
        [(AstDeclComptimeDecl _ template-box)
          (let
            [template : AstDecl (box-get template-box)]
            (tc-summary-add-decl summary template))]
        [(AstDeclUnsafe inner-box)
          (let
            [inner : AstDecl (box-get inner-box)]
            (tc-summary-add-decl summary inner))]
        [_ summary])]))

(define (tc-macro-signature-type [ty : AstType]) : AstType
  (match ty
    [(AstTyVar name)
      (match (tc-stdlib-comptime-syntax-type (intern-str name))
        [(AstSomeType syntax-ty) syntax-ty]
        [(AstNoType)
          (cond
            [(= name (intern "Expr")) (AstTyExpr)]
            [(= name (intern "ExprList")) (AstTyExprList)]
            [(= name (intern "ExprClause")) (tc-macro-expr-clause-type)]
            [(= name (intern "ExprClauseList"))
              (tc-macro-expr-clause-list-type)]
            [(= name (intern "ExprBindingClause"))
              (tc-macro-expr-binding-clause-type)]
            [(= name (intern "ExprBindingClauseList"))
              (tc-macro-expr-binding-clause-list-type)]
            [else ty])])]
    [(AstTyVarArgs name _)
      (match (tc-stdlib-comptime-syntax-type (intern-str name))
        [(AstSomeType syntax-ty) syntax-ty]
        [(AstNoType) ty])]
    [(AstTyEnum name)
      (match (tc-stdlib-comptime-syntax-type (intern-str name))
        [(AstSomeType syntax-ty) syntax-ty]
        [(AstNoType) ty])]
    [(AstTyEnumArgs name _)
      (match (tc-stdlib-comptime-syntax-type (intern-str name))
        [(AstSomeType syntax-ty) syntax-ty]
        [(AstNoType) ty])]
    [(AstTyStruct name)
      (match (tc-stdlib-comptime-syntax-type (intern-str name))
        [(AstSomeType syntax-ty) syntax-ty]
        [(AstNoType) ty])]
    [(AstTyStructArgs name _)
      (match (tc-stdlib-comptime-syntax-type (intern-str name))
        [(AstSomeType syntax-ty) syntax-ty]
        [(AstNoType) ty])]
    [_ ty]))

(define (tc-macro-produced-type-compatible?
  [ctx : TcContext]
  [ret : AstType]
  [produced : AstType]) : bool
  (let
    [expected : AstType (tc-resolve-type ctx (tc-macro-signature-type ret))]
    (or
      (tc-type-eq expected (AstTyExpr))
      (tc-type-eq produced (AstTyExpr))
      (ctfe-untyped-expr-type? produced)
      (ctfe-captured-expr-type? produced)
      (tc-type-compatible? expected (tc-resolve-type ctx produced)))))

(define (tc-check-defmacro-produced-type
  [ctx : TcContext]
  [ret : AstType]
  [value : CompilerCtfeValue]) : ResultTcUnit
  (if (tc-macro-result-module? ret)
    (match value
      [(CtfeExpr _ _) OkTcUnit]
      [_ (ErrTcUnit "typecheck: Module macro body must return Expr")])
    (if (tc-macro-result-decls? ret)
      (match value
        [(CtfeExpr _ _) OkTcUnit]
        [_ (ErrTcUnit "typecheck: Decls macro body must return Expr")])
      (match value
        [(CtfeExpr _ produced)
          (if (tc-macro-produced-type-compatible? ctx ret produced)
            OkTcUnit
            (ErrTcUnit
              "typecheck: macro body produced type does not match declaration"))]
        [_ (ErrTcUnit "typecheck: macro body must return Expr")]))))

(define (tc-comptime-purity-chain-push [chain : TcStringList] [name : String]) : TcStringList
  (TcStringCons name (box chain)))

(define (tc-comptime-purity-chain-render [chain : TcStringList]) : String
  (match chain
    [(TcStringNil) ""]
    [(TcStringCons head rest)
      (let
        [tail : String (tc-comptime-purity-chain-render (box-get rest))]
        (if (string.string-eq tail "")
          head
          (str_cat.str-cat tail " -> " head)))]))

(define (tc-comptime-purity-chain-path [chain : TcStringList] [name : String]) : String
  (let
    [prefix : String (tc-comptime-purity-chain-render chain)]
    (if (string.string-eq prefix "")
      name
      (str_cat.str-cat prefix " -> " name))))

(define (tc-comptime-purity-error
  [expr : AstExpr]
  [chain : TcStringList]
  [name : String]
  [reason : String]) : ResultTcUnit
  (ErrTcUnit
    (tc-locate-error-at-expr
      expr
      (str_cat.str-cat
        "typecheck: comptime purity rejects "
        reason
        "; reference path: "
        (tc-comptime-purity-chain-path chain name)))))

(define (tc-comptime-purity-banned-module? [module : String]) : bool
  (cond
    [(string.string-eq module "io") true]
    [(string.string-eq module "stdlib.io") true]
    [(string.string-eq module "stdlib/io") true]
    [(string.string-eq module "fs") true]
    [(string.string-eq module "stdlib.fs") true]
    [(string.string-eq module "stdlib/fs") true]
    [(string.string-eq module "process") true]
    [(string.string-eq module "stdlib.process") true]
    [(string.string-eq module "stdlib/process") true]
    [(string.string-eq module "stdlib.process-runtime") true]
    [(string.string-eq module "stdlib/process_runtime") true]
    [(string.string-eq module "env") true]
    [(string.string-eq module "stdlib.env") true]
    [(string.string-eq module "stdlib/env") true]
    [else false]))

(define (tc-comptime-purity-banned-qualified? [ctx : TcContext] [name : String]) : bool
  (if (tc-name-qualified? name)
    (let
      [qualifier : String (tc-qualified-name-module name)]
      [target : String (tc-qualified-access-target-module ctx qualifier)]
      (or
        (tc-comptime-purity-banned-module? qualifier)
        (tc-comptime-purity-banned-module? target)))
    false))

(define (tc-comptime-purity-ctfe-builtin? [name : String]) : bool
  (let
    [lookup-name : String (tc-hygiene-global-call-name name)]
    [call-name : String (ctfe-comptime-helper-call-name lookup-name)]
    (cond
      [(string.string-eq lookup-name "size-of") true]
      [(string.string-eq lookup-name "align-of") true]
      [(string.string-eq lookup-name "offset-of") true]
      [(ctfe-reflection-query-name? lookup-name) true]
      [(ctfe-string-eq-helper-name? lookup-name) true]
      [(string.string-eq call-name "string-append") true]
      [(string.string-eq call-name "string-concat") true]
      [(ctfe-string-length-helper-name? lookup-name) true]
      [(ctfe-string-ref-helper-name? lookup-name) true]
      [(ctfe-string-to-int-helper-name? lookup-name) true]
      [(string.string-eq call-name "int->string") true]
      [(string.string-eq call-name "expr-bool") true]
      [(string.string-eq call-name "expr-int") true]
      [(string.string-eq call-name "expr-string") true]
      [(string.string-eq call-name "expr-var") true]
      [(string.string-eq call-name "expr-struct-get") true]
      [(string.string-eq call-name "expr-struct-set") true]
      [(string.string-eq call-name "expr-splice") true]
      [(string.string-eq call-name "expr-if") true]
      [(string.string-eq call-name "expr-type") true]
      [(ctfe-expr-inspector-name? call-name) true]
      [(ctfe-expr-list-inspector-name? call-name) true]
      [(ctfe-expr-clause-inspector-name? call-name) true]
      [(ctfe-expr-clause-list-inspector-name? call-name) true]
      [(ctfe-expr-binding-clause-inspector-name? call-name) true]
      [(ctfe-expr-binding-clause-list-inspector-name? call-name) true]
      [(string.string-eq call-name "comptime-error") true]
      [else false])))

(define (tc-macro-param-list-add-bound-names
  [params : AstMacroParamList]
  [bound : TcStringList]) : TcStringList
  (match params
    [(AstMacroParamNil) bound]
    [(AstMacroParamCons param rest)
      (let
        [rest : AstMacroParamList (box-get rest)]
        (match param
          [(AstMacroParam name _ _)
            (tc-macro-param-list-add-bound-names
              rest
              (tc-string-list-add bound (intern-str name)))]))]))

(define (tc-macro-param-bound-names [params : AstMacroParamList]) : TcStringList
  (tc-macro-param-list-add-bound-names params TcStringNil))

(define (tc-comptime-purity-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [expr : AstExpr]) : ResultTcUnit
  (tc-comptime-purity-expr-mode ctx env bound chain seen false expr))

(define (tc-comptime-purity-node-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [expr-id : i64]) : ResultTcUnit
  (tc-comptime-purity-expr-mode
    ctx
    env
    bound
    chain
    seen
    template?
    (ast-node-get expr-id)))

(define (tc-comptime-purity-node2-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [left : i64]
  [right : i64]) : ResultTcUnit
  (match (tc-comptime-purity-node-mode ctx env bound chain seen template? left)
    [(OkTcUnit)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? right)]
    [(ErrTcUnit message) (ErrTcUnit message)]))

(define (tc-comptime-purity-node3-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [first : i64]
  [second : i64]
  [third : i64]) : ResultTcUnit
  (match (tc-comptime-purity-node-mode ctx env bound chain seen template? first)
    [(OkTcUnit)
      (match (tc-comptime-purity-node-mode
        ctx
        env
        bound
        chain
        seen
        template?
        second)
        [(OkTcUnit)
          (tc-comptime-purity-node-mode
            ctx
            env
            bound
            chain
            seen
            template?
            third)]
        [(ErrTcUnit message) (ErrTcUnit message)])]
    [(ErrTcUnit message) (ErrTcUnit message)]))

(define (tc-comptime-purity-template-bound
  [template? : bool]
  [bound : TcStringList]
  [name : i64]) : TcStringList
  (if template?
    bound
    (tc-string-list-add bound (intern-str name))))

(define (tc-comptime-purity-reject-or-template-ok
  [expr : AstExpr]
  [chain : TcStringList]
  [template? : bool]
  [name : String]
  [reason : String]) : ResultTcUnit
  (if template?
    OkTcUnit
    (tc-comptime-purity-error expr chain name reason)))

(define (tc-comptime-purity-reject-or-template-node
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [expr : AstExpr]
  [name : String]
  [reason : String]
  [inner : i64]) : ResultTcUnit
  (if template?
    (tc-comptime-purity-node-mode ctx env bound chain seen true inner)
    (tc-comptime-purity-error expr chain name reason)))

(define (tc-comptime-purity-reject-or-template-node2
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [expr : AstExpr]
  [name : String]
  [reason : String]
  [left : i64]
  [right : i64]) : ResultTcUnit
  (if template?
    (tc-comptime-purity-node2-mode ctx env bound chain seen true left right)
    (tc-comptime-purity-error expr chain name reason)))

(define (tc-comptime-purity-expr-list-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [exprs : AstExprList]) : ResultTcUnit
  (match exprs
    [(AstExprNil) OkTcUnit]
    [(AstExprCons head rest)
      (let
        [rest : AstExprList (box-get rest)]
        (match (tc-comptime-purity-node-mode
          ctx
          env
          bound
          chain
          seen
          template?
          head)
          [(OkTcUnit)
            (tc-comptime-purity-expr-list-mode
              ctx
              env
              bound
              chain
              seen
              template?
              rest)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]))

(define (tc-comptime-purity-expr-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [exprs : AstExprList]) : ResultTcUnit
  (tc-comptime-purity-expr-list-mode ctx env bound chain seen false exprs))

(define (tc-comptime-purity-let-bindings-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [bindings : AstLetBindingList]) : ResultTcStringList
  (match bindings
    [(AstLetBindingNil) (OkTcStringList bound)]
    [(AstLetBindingCons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding name _ init-box)
            (match (tc-comptime-purity-node-mode
              ctx
              env
              bound
              chain
              seen
              template?
              init-box)
              [(OkTcUnit)
                (tc-comptime-purity-let-bindings-mode
                  ctx
                  env
                  (tc-comptime-purity-template-bound template? bound name)
                  chain
                  seen
                  template?
                  rest)]
              [(ErrTcUnit message) (ErrTcStringList message)])]))]))

(define (tc-comptime-purity-resource-bindings-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [bindings : AstResourceBindingList]) : ResultTcStringList
  (match bindings
    [(AstResourceBindingNil) (OkTcStringList bound)]
    [(AstResourceBindingCons binding rest)
      (let
        [rest : AstResourceBindingList (box-get rest)]
        (match binding
          [(AstResourceBinding name init-box cleanup-box)
            (match (tc-comptime-purity-node2-mode
              ctx
              env
              bound
              chain
              seen
              template?
              init-box
              cleanup-box)
              [(OkTcUnit)
                (tc-comptime-purity-resource-bindings-mode
                  ctx
                  env
                  (tc-comptime-purity-template-bound template? bound name)
                  chain
                  seen
                  template?
                  rest)]
              [(ErrTcUnit message) (ErrTcStringList message)])]))]))

(define (tc-comptime-purity-match-arms-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [arms : AstMatchArmList]) : ResultTcUnit
  (match arms
    [(AstMatchArmNil) OkTcUnit]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm pattern body-box)
            (match (tc-comptime-purity-node-mode
              ctx
              env
              (if template?
                bound
                (tc-pattern-add-bound-names pattern bound))
              chain
              seen
              template?
              body-box)
              [(OkTcUnit)
                (tc-comptime-purity-match-arms-mode
                  ctx
                  env
                  bound
                  chain
                  seen
                  template?
                  rest)]
              [(ErrTcUnit message) (ErrTcUnit message)])]))]))

(define (tc-comptime-purity-expr-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [expr : AstExpr]) : ResultTcUnit
  (match expr
    [(AstExprSpanned inner-box _)
      (tc-comptime-purity-node-mode
        ctx
        env
        bound
        chain
        seen
        template?
        inner-box)]
    [(AstExprLiteral _) OkTcUnit]
    [(AstExprVar name)
      (if template?
        OkTcUnit
        (tc-comptime-purity-var ctx env bound chain seen expr name))]
    [(AstExprBinary _ left right)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        left
        right)]
    [(AstExprUnary _ inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExprCall func args)
      (match (tc-comptime-purity-node-mode
        ctx
        env
        bound
        chain
        seen
        template?
        func)
        [(OkTcUnit)
          (tc-comptime-purity-expr-list-mode
            ctx
            env
            bound
            chain
            seen
            template?
            args)]
        [(ErrTcUnit message) (ErrTcUnit message)])]
    [(AstExprIf cond then-branch else-branch)
      (tc-comptime-purity-node3-mode
        ctx
        env
        bound
        chain
        seen
        template?
        cond
        then-branch
        else-branch)]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body)
          (match (tc-comptime-purity-let-bindings-mode
            ctx
            env
            bound
            chain
            seen
            template?
            bindings)
            [(OkTcStringList body-bound)
              (tc-comptime-purity-node-mode
                ctx
                env
                body-bound
                chain
                seen
                template?
                body)]
            [(ErrTcStringList message) (ErrTcUnit message)])])]
    [(AstExprLambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda params _ body)
          (tc-comptime-purity-node-mode
            ctx
            env
            (if template?
              bound
              (tc-param-list-add-bound-names params bound))
            chain
            seen
            template?
            body)])]
    [(AstExprTuple exprs)
      (tc-comptime-purity-expr-list-mode
        ctx
        env
        bound
        chain
        seen
        template?
        exprs)]
    [(AstExprTupleRef tuple _)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? tuple)]
    [(AstExprArray exprs)
      (tc-comptime-purity-expr-list-mode
        ctx
        env
        bound
        chain
        seen
        template?
        exprs)]
    [(AstExprMakeArray _ len)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? len)]
    [(AstExprArrayRef array index)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        array
        index)]
    [(AstExprArraySet array index value)
      (tc-comptime-purity-node3-mode
        ctx
        env
        bound
        chain
        seen
        template?
        array
        index
        value)]
    [(AstExprArrayPush array value)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        array
        value)]
    [(AstExprStringRef str index)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        str
        index)]
    [(AstExprWhile cond body)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        cond
        body)]
    [(AstExprBegin exprs)
      (tc-comptime-purity-expr-list-mode
        ctx
        env
        bound
        chain
        seen
        template?
        exprs)]
    [(AstExprUnsafe exprs)
      (if template?
        (tc-comptime-purity-expr-list-mode ctx env bound chain seen true exprs)
        (tc-comptime-purity-error expr chain "unsafe" "unsafe block"))]
    [(AstExprSet _ value)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? value)]
    [(AstExprAnn inner _)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExprCast inner _)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExprBorrow _ _ place)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? place)]
    [(AstExprMatch match-box)
      (match (box-get match-box)
        [(AstMatch scrut arms)
          (match (tc-comptime-purity-node-mode
            ctx
            env
            bound
            chain
            seen
            template?
            scrut)
            [(OkTcUnit)
              (tc-comptime-purity-match-arms-mode
                ctx
                env
                bound
                chain
                seen
                template?
                arms)]
            [(ErrTcUnit message) (ErrTcUnit message)])])]
    [(AstExprForeach fe-box)
      (match (box-get fe-box)
        [(AstForeach index _ start end body)
          (match (tc-comptime-purity-node2-mode
            ctx
            env
            bound
            chain
            seen
            template?
            start
            end)
            [(OkTcUnit)
              (tc-comptime-purity-node-mode
                ctx
                env
                (tc-comptime-purity-template-bound template? bound index)
                chain
                seen
                template?
                body)]
            [(ErrTcUnit message) (ErrTcUnit message)])])]
    [(AstExprSpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce _ index _ start end init value)
          (match (tc-comptime-purity-node3-mode
            ctx
            env
            bound
            chain
            seen
            template?
            start
            end
            init)
            [(OkTcUnit)
              (tc-comptime-purity-node-mode
                ctx
                env
                (tc-comptime-purity-template-bound template? bound index)
                chain
                seen
                template?
                value)]
            [(ErrTcUnit message) (ErrTcUnit message)])])]
    [(AstExprSpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan _ index _ start end prefix _ init value body)
          (match (tc-comptime-purity-node3-mode
            ctx
            env
            bound
            chain
            seen
            template?
            start
            end
            init)
            [(OkTcUnit)
              (let
                [index-bound : TcStringList
                  (tc-comptime-purity-template-bound template? bound index)]
                (match (tc-comptime-purity-node-mode
                  ctx
                  env
                  index-bound
                  chain
                  seen
                  template?
                  value)
                  [(OkTcUnit)
                    (tc-comptime-purity-node-mode
                      ctx
                      env
                      (tc-comptime-purity-template-bound
                        template?
                        index-bound
                        prefix)
                      chain
                      seen
                      template?
                      body)]
                  [(ErrTcUnit message) (ErrTcUnit message)]))]
            [(ErrTcUnit message) (ErrTcUnit message)])])]
    [(AstExprSpmdBroadcast value lane)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        value
        lane)]
    [(AstExprSpmdShuffle value lane)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        value
        lane)]
    [(AstExprStructGet receiver _)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? receiver)]
    [(AstExprStructSet receiver _ value)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        receiver
        value)]
    [(AstExprWithRegion _ body)
      (tc-comptime-purity-expr-list-mode
        ctx
        env
        bound
        chain
        seen
        template?
        body)]
    [(AstExprWithEscape scratch body)
      (match (tc-comptime-purity-node-mode
        ctx
        env
        bound
        chain
        seen
        template?
        scratch)
        [(OkTcUnit)
          (tc-comptime-purity-expr-list-mode
            ctx
            env
            bound
            chain
            seen
            template?
            body)]
        [(ErrTcUnit message) (ErrTcUnit message)])]
    [(AstExprWithScratch body)
      (tc-comptime-purity-expr-list-mode
        ctx
        env
        bound
        chain
        seen
        template?
        body)]
    [(AstExprInArena arena body)
      (match (tc-comptime-purity-node-mode
        ctx
        env
        bound
        chain
        seen
        template?
        arena)
        [(OkTcUnit)
          (tc-comptime-purity-expr-list-mode
            ctx
            env
            bound
            chain
            seen
            template?
            body)]
        [(ErrTcUnit message) (ErrTcUnit message)])]
    [(AstExprWithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource bindings body)
          (match (tc-comptime-purity-resource-bindings-mode
            ctx
            env
            bound
            chain
            seen
            template?
            bindings)
            [(OkTcStringList body-bound)
              (tc-comptime-purity-expr-list-mode
                ctx
                env
                body-bound
                chain
                seen
                template?
                body)]
            [(ErrTcStringList message) (ErrTcUnit message)])])]
    [(AstExprBox inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExprBoxGet inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExprBoxTake inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExprBoxSet inner value)
      (match (tc-comptime-purity-node-mode
        ctx
        env
        bound
        chain
        seen
        template?
        inner)
        [(OkTcUnit)
          (tc-comptime-purity-node-mode
            ctx
            env
            bound
            chain
            seen
            template?
            value)]
        [(ErrTcUnit message) (ErrTcUnit message)])]
    [(AstExprTypeLiteral _) OkTcUnit]
    [(AstExprInit _) OkTcUnit]
    [(AstExprComptime inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExprQuote _) OkTcUnit]
    [(AstExprQuasiquote inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen true inner)]
    [(AstExprUnquote inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen false inner)]
    [(AstExprUnquoteSplicing inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen false inner)]
    [(AstExprBracketClause items)
      (tc-comptime-purity-expr-list-mode
        ctx
        env
        bound
        chain
        seen
        template?
        items)]
    [(AstExprTry inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExprReturn inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExprPtrNull _)
      (tc-comptime-purity-reject-or-template-ok
        expr
        chain
        template?
        "ptr-null"
        "raw pointer operation")]
    [(AstExprPtrNullCheck inner)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "ptr-null?"
        "raw pointer operation"
        inner)]
    [(AstExprPtrAddrOf _)
      (tc-comptime-purity-reject-or-template-ok
        expr
        chain
        template?
        "ptr-addr-of"
        "raw pointer operation")]
    [(AstExprPtrRead ptr)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "ptr-read"
        "raw pointer operation"
        ptr)]
    [(AstExprPtrWrite ptr value)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "ptr-write!"
        "raw pointer operation"
        ptr
        value)]
    [(AstExprPtrOffset ptr offset)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "ptr-offset"
        "raw pointer operation"
        ptr
        offset)]
    [(AstExprPtrCast ptr _)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "ptr-cast"
        "raw pointer operation"
        ptr)]
    [(AstExprPtrToInt ptr)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "ptr->int"
        "raw pointer operation"
        ptr)]
    [(AstExprIntToPtr value _)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "int->ptr"
        "raw pointer operation"
        value)]
    [(AstExprStringData str)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "string-data"
        "unsafe FFI bridge"
        str)]
    [(AstExprStringFromBytes ptr len)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "string-from-bytes"
        "unsafe FFI bridge"
        ptr
        len)]
    [(AstExprArrayData array)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "array-data"
        "unsafe FFI bridge"
        array)]
    [(AstExprBinaryData _) OkTcUnit]
    [(AstExprSpmdProgramIndex) OkTcUnit]
    [(AstExprSpmdProgramCount) OkTcUnit]
    [(AstExprProgramArgc)
      (tc-comptime-purity-reject-or-template-ok
        expr
        chain
        template?
        "program-argc"
        "runtime process state")]
    [(AstExprProgramArgv)
      (tc-comptime-purity-reject-or-template-ok
        expr
        chain
        template?
        "program-argv"
        "runtime process state")]
    [(AstExprProgramEnvp)
      (tc-comptime-purity-reject-or-template-ok
        expr
        chain
        template?
        "program-envp"
        "runtime process state")]
    [(AstExprCpuIdEax leaf subleaf)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "cpuid"
        "host CPU query"
        leaf
        subleaf)]
    [(AstExprCpuIdEbx leaf subleaf)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "cpuid"
        "host CPU query"
        leaf
        subleaf)]
    [(AstExprCpuIdEcx leaf subleaf)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "cpuid"
        "host CPU query"
        leaf
        subleaf)]
    [(AstExprCpuIdEdx leaf subleaf)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "cpuid"
        "host CPU query"
        leaf
        subleaf)]
    [(AstExprXgetbv index)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "xgetbv"
        "host CPU query"
        index)]
    [(AstExprSyscall args)
      (if template?
        (tc-comptime-purity-expr-list-mode ctx env bound chain seen true args)
        (tc-comptime-purity-error expr chain "syscall" "host syscall"))]))

(define (tc-comptime-purity-var
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [expr : AstExpr]
  [name-id : i64]) : ResultTcUnit
  (let
    [name : String (intern-str name-id)]
    (cond
      [(tc-string-list-contains bound name) OkTcUnit]
      [(tc-comptime-purity-banned-qualified? ctx name)
        (tc-comptime-purity-error
          expr
          chain
          name
          (str_cat.str-cat
            "import from module "
            (tc-qualified-name-module name)))]
      [(tc-comptime-purity-ctfe-builtin? name) OkTcUnit]
      [else
        (match (tc-lookup-unsafe-id env name-id)
          [(OkTcTypeUnsafe _ unsafe?)
            (if unsafe?
              (tc-comptime-purity-error
                expr
                chain
                name
                (str_cat.str-cat "unsafe declaration " name))
              (tc-comptime-purity-var-handle
                ctx
                env
                bound
                chain
                seen
                expr
                name-id))]
          [(ErrTcTypeUnsafe _)
            (tc-comptime-purity-var-handle
              ctx
              env
              bound
              chain
              seen
              expr
              name-id)])])))

(define (tc-comptime-purity-var-handle
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [expr : AstExpr]
  [name-id : i64]) : ResultTcUnit
  (match (compiler-symbols-lookup-value-id (tc-context-symbols ctx) name-id)
    [(SomeI64 handle)
      (let
        [name : String (intern-str name-id)]
        [kind : i64 (compiler-symbol-handle-kind handle)]
        (cond
          [(= kind (compiler-symbol-kind-extern))
            (tc-comptime-purity-error
              expr
              chain
              name
              (str_cat.str-cat "extern reference " name))]
          [(= kind (compiler-symbol-kind-defdispatch))
            (tc-comptime-purity-error
              expr
              chain
              name
              (str_cat.str-cat "runtime dispatch reference " name))]
          [(or
              (= kind (compiler-symbol-kind-value-define))
              (= kind (compiler-symbol-kind-function-define)))
            (tc-comptime-purity-handle-decl
              ctx
              env
              bound
              chain
              seen
              expr
              name
              handle)]
          [else OkTcUnit]))]
    [(NoneI64) OkTcUnit]))

(define (tc-comptime-purity-handle-decl
  [ctx : TcContext]
  [env : TcTypeEnv]
  [_bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [_expr : AstExpr]
  [name : String]
  [handle : i64]) : ResultTcUnit
  (if (tc-string-list-contains seen name)
    OkTcUnit
    (let
      [index : i64 (compiler-symbol-handle-index handle)]
      [decls : (Array AstDecl)
        (compiler-symbols-decls (tc-context-symbols ctx))]
      (if (or (< index 0) (>= index (array.array-length decls)))
        OkTcUnit
        (tc-comptime-purity-decl
          ctx
          env
          (tc-comptime-purity-chain-push chain name)
          (tc-string-list-add seen name)
          (array.array-ref decls index))))))

(define (tc-comptime-purity-decl
  [ctx : TcContext]
  [env : TcTypeEnv]
  [chain : TcStringList]
  [seen : TcStringList]
  [decl : AstDecl]) : ResultTcUnit
  (match decl
    [(AstDeclDef _ _ expr-box)
      (let
        [expr : AstExpr (ast-node-get expr-box)]
        (tc-comptime-purity-expr ctx env TcStringNil chain seen expr))]
    [(AstDeclDefFn _ params _ body-box _)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (tc-comptime-purity-expr
          ctx
          env
          (tc-param-bound-names params)
          chain
          seen
          body))]
    [(AstDeclDefMacro _ _ _ _) OkTcUnit]
    [(AstDeclExtern name _ _ _)
      (tc-comptime-purity-error
        (AstExprVar name)
        chain
        (intern-str name)
        (str_cat.str-cat "extern reference " (intern-str name)))]
    [(AstDeclDefDispatch name _)
      (tc-comptime-purity-error
        (AstExprVar name)
        chain
        (intern-str name)
        (str_cat.str-cat "runtime dispatch reference " (intern-str name)))]
    [(AstDeclUnsafe _)
      (ErrTcUnit
        (str_cat.str-cat
          "typecheck: comptime purity rejects unsafe declaration; reference path: "
          (tc-comptime-purity-chain-render chain)))]
    [(AstDeclComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (tc-comptime-purity-decl ctx env chain seen template))]
    [_ OkTcUnit]))

(define (tc-check-defmacro-purity
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [params : AstMacroParamList]
  [body : AstExpr]) : ResultTcUnit
  (tc-comptime-purity-expr
    ctx
    env
    (tc-macro-param-bound-names params)
    (tc-comptime-purity-chain-push TcStringNil (intern-str name))
    (tc-string-list-add TcStringNil (intern-str name))
    body))

(define (tc-macro-param-list-needs-call-context? [params : AstMacroParamList]) : bool
  (match params
    [(AstMacroParamNil) false]
    [(AstMacroParamCons param rest)
      (match param
        [(AstMacroParam _ ty _)
          (if (or
            (tc-macro-type-param-kind? ty)
            (tc-macro-module-param-kind? ty))
            true
            (tc-macro-param-list-needs-call-context? (box-get rest)))])]))

(define (tc-check-comptime-decl-purity
  [ctx : TcContext]
  [env : TcTypeEnv]
  [template : AstDecl]) : ResultTcUnit
  (tc-comptime-purity-decl
    ctx
    env
    (tc-comptime-purity-chain-push TcStringNil "comptime-decl")
    TcStringNil
    template))

(define (tc-check-defmacro
  [name : i64]
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [params : AstMacroParamList]
  [ret : AstType]
  [body : AstExpr]) : ResultTcUnit
  (let
    [macro-env : TcTypeEnv
      (tc-bind-macro-params ctx (tc-macro-helper-env-cached top-env) params)]
    (match (tc-expr ctx macro-env body)
      [(OkTcType got)
        (match (tc-check-defmacro-purity ctx macro-env name params body)
          [(OkTcUnit)
            (match (tc-expect
              got
              (AstTyExpr)
              "typecheck: macro body must return Expr")
              [(OkTcUnit)
                (if (tc-macro-param-list-needs-call-context? params)
                  OkTcUnit
                  (begin
                    (tc-context-capture-active-pools! ctx)
                    (match (compiler-ctfe-eval
                      body
                      (tc-ctfe-env-extend-macro-params
                        ctx
                        (tc-ctfe-env ctx)
                        params)
                      (ctfe-fuel-limit))
                      [(OkCtfe value _)
                        (begin
                          (ast-node-pool-context-install!
                            (tc-context-pools ctx))
                          (tc-check-defmacro-produced-type ctx ret value))]
                      [(ErrCtfe diag)
                        (ErrTcUnit (compiler-diagnostic-message (box-get diag)))])))]
              [(ErrTcUnit message) (ErrTcUnit message)])]
          [(ErrTcUnit message) (ErrTcUnit message)])]
      [(ErrTcType message) (ErrTcUnit message)])))

;; --- whole-local move checker (#1048/#1049) ---------------------------------
;;
;; Reject use-after-move for move-only whole locals/parameters in source
;; evaluation order. The staged owner-only policy keeps ordinary aggregate
;; sharing compatible, while consuming only by-value sites whose target is an
;; owner today: cleanup-owning structs and Box values. Reads never move; branches
;; merge by union (a place moved on any arm is moved afterward). Loops reject
;; owner moves from values visible before the repeated body, then discard body
;; moves for the post-state because they may run zero times; lambdas still
;; discard their body's moves because they may be deferred. Reassigning a slot
;; with `set!` clears its moved mark. Owner-consuming struct fields, tuple
;; elements, and fixed-array literal elements are tracked as root paths so
;; unrelated entries remain usable. Nested direct-root struct/tuple/fixed-array
;; literal chains are represented by stable path strings. Box and non-literal
;; aggregate projections stay rejected until their path/reinitialization policy
;; lands; dynamic arrays have a separate diagnostic because element ownership
;; cannot be made sound without an index policy.
(defstruct TcMovedSet
  (map hashmap.StringI64Map))

(defenum TcMoveResult
  (OkTcMove TcMovedSet)
  (ErrTcMove String))

(defenum TcMoveBindings
  (OkTcMoveBindings TcTypeEnv TcMovedSet TcMovedSet TcMovedSet)
  (ErrTcMoveBindings String))

(defenum TcMoveCleanupOwners
  (TcMoveCleanupOwnersNil)
  (TcMoveCleanupOwnersCons String i64 (Box TcMoveCleanupOwners)))

(defenum TcMoveResourceBindings
  (OkTcMoveResourceBindings
    TcTypeEnv
    TcMovedSet
    TcMovedSet
    TcMovedSet
    TcMoveCleanupOwners)
  (ErrTcMoveResourceBindings String))

(defenum TcMoveMaybeIndex
  (TcMoveNoIndex)
  (TcMoveSomeIndex i64))

(defenum TcMoveConflict
  (TcNoMoveConflict)
  (TcSomeMoveConflict String i64))

(define (tc-moved-empty) : TcMovedSet
  (TcMovedSet (hashmap.string-i64-map-with-capacity 8)))

(define (tc-moved-map [set : TcMovedSet]) : hashmap.StringI64Map
  (struct-get set map))

(define (tc-moved-len [set : TcMovedSet]) : i64
  (hashmap.string-i64-map-len (tc-moved-map set)))

(define (tc-moved-capacity [set : TcMovedSet]) : i64
  (hashmap.string-i64-map-capacity (tc-moved-map set)))

(define (tc-moved-clone [set : TcMovedSet]) : TcMovedSet
  (let
    [map : hashmap.StringI64Map (tc-moved-map set)]
    (TcMovedSet
      (hashmap.string-i64-map-resized map (hashmap.string-i64-map-capacity map)))))

(define (tc-moved-contains? [set : TcMovedSet] [name : String]) : bool
  (hashmap.string-i64-map-contains? (tc-moved-map set) name))

(define (tc-moved-no-origin-id) : i64
  -1)

(define (tc-moved-add [set : TcMovedSet] [name : String]) : TcMovedSet
  (TcMovedSet
    (hashmap.string-i64-map-put (tc-moved-map set) name (tc-moved-no-origin-id))))

(define (tc-moved-add-value [set : TcMovedSet] [name : String] [value : i64]) : TcMovedSet
  (TcMovedSet (hashmap.string-i64-map-put (tc-moved-map set) name value)))

(define (tc-moved-add-origin
  [set : TcMovedSet]
  [name : String]
  [origin : AstExpr]) : TcMovedSet
  (tc-moved-add-value set name (ast-node-push origin)))

(define (tc-moved-remove [set : TcMovedSet] [name : String]) : TcMovedSet
  (match (hashmap.string-i64-map-remove (tc-moved-map set) name)
    [(hashmap.StringI64MapRemoveOk map) (TcMovedSet map)]
    [(hashmap.StringI64MapRemoveMissing map) (TcMovedSet map)]))

(define (tc-moved-conflict [set : TcMovedSet] [name : String]) : TcMoveConflict
  (match (hashmap.string-i64-map-get (tc-moved-map set) name)
    [(hashmap.StringI64MapFound origin-id) (TcSomeMoveConflict name origin-id)]
    [(hashmap.StringI64MapMissing) TcNoMoveConflict]))

(define (tc-move-use-message [name : String]) : String
  (string.string-append
    (string.string-append "typecheck: use of moved value `" name)
    "`"))

(define (tc-move-loop-carried-message [name : String]) : String
  (string.string-append
    (string.string-append
      "typecheck: cannot move loop-carried owner value `"
      name)
    "`"))

(define (tc-move-cleanup-owner-exit-message [name : String]) : String
  (string.string-append
    (string.string-append "typecheck: cleanup owner `" name)
    "` moved before with scope exit"))

(define (tc-move-help) : String
  "clone the owner before moving it again, reinitialize the moved place before reuse, or keep the owner move inside a narrower scope")

(define (tc-moved-path-key [path : String]) : String
  (string.string-append "\npath:" path))

(define (tc-moved-partial-key [name : String]) : String
  (string.string-append "\npartial:" name))

(define (tc-moved-partial? [set : TcMovedSet] [name : String]) : bool
  (tc-moved-contains? set (tc-moved-partial-key name)))

(define (tc-move-string-prefix? [text : String] [prefix : String]) : bool
  (string.is-string-prefix-at (& text) (& prefix) 0))

(define (tc-moved-path-key? [key : String]) : bool
  (tc-move-string-prefix? key (tc-moved-path-key "")))

(define (tc-moved-conflict-display-path [key : String]) : String
  (let
    [path-prefix : String (tc-moved-path-key "")]
    [partial-prefix : String (tc-moved-partial-key "")]
    [key-len : i64 (string.string-length key)]
    (if (tc-move-string-prefix? key path-prefix)
      (string.substring
        key
        (string.string-length path-prefix)
        (- key-len (string.string-length path-prefix)))
      (if (tc-move-string-prefix? key partial-prefix)
        (string.substring
          key
          (string.string-length partial-prefix)
          (- key-len (string.string-length partial-prefix)))
        key))))

(define (tc-move-origin-label [key : String]) : String
  (str_cat.str-cat
    "move of `"
    (tc-moved-conflict-display-path key)
    "` happened here"))

(define (tc-move-loop-carried-origin-label [name : String]) : String
  (str_cat.str-cat
    "owner value `"
    name
    "` is loop-carried into a repeated body"))

(define (tc-move-cleanup-owner-binding-label [name : String]) : String
  (str_cat.str-cat "cleanup owner `" name "` is bound for this with scope here"))

(define (tc-move-origin-span [origin-id : i64]) : TcMaybeAstSourceSpan
  (if (= origin-id (tc-moved-no-origin-id))
    TcNoAstSourceSpan
    (tc-expr-maybe-span (ast-node-get origin-id))))

(define (tc-move-rich-origin-message
  [primary : AstExpr]
  [message : String]
  [origin-id : i64]
  [origin-label : String]) : String
  (match (tc-expr-maybe-span primary)
    [(TcSomeAstSourceSpan primary-span)
      (match (tc-move-origin-span origin-id)
        [(TcSomeAstSourceSpan origin-span)
          (tc-rich-error-one-secondary
            primary-span
            message
            (tc-move-help)
            origin-span
            origin-label)]
        [(TcNoAstSourceSpan)
          (tc-rich-error-one-secondary
            primary-span
            message
            (tc-move-help)
            primary-span
            origin-label)])]
    [(TcNoAstSourceSpan)
      (match (tc-move-origin-span origin-id)
        [(TcSomeAstSourceSpan origin-span)
          (tc-rich-error-one-secondary
            origin-span
            message
            (tc-move-help)
            origin-span
            origin-label)]
        [(TcNoAstSourceSpan) message])]))

(define (tc-move-rich-conflict-message
  [conflict : TcMoveConflict]
  [fallback-key : String]
  [primary : AstExpr]
  [message : String]) : String
  (match conflict
    [(TcSomeMoveConflict key origin-id)
      (tc-move-rich-origin-message
        primary
        message
        origin-id
        (tc-move-origin-label key))]
    [TcNoMoveConflict
      (tc-move-rich-origin-message
        primary
        message
        (tc-moved-no-origin-id)
        (tc-move-origin-label fallback-key))]))

(define (tc-move-rich-loop-carried-message [name : String] [primary : AstExpr]) : String
  (tc-move-rich-origin-message
    primary
    (tc-move-loop-carried-message name)
    (tc-moved-no-origin-id)
    (tc-move-loop-carried-origin-label name)))

(define (tc-move-rich-cleanup-owner-exit-message
  [conflict : TcMoveConflict]
  [name : String]
  [owner-origin-id : i64]
  [scope : AstExpr]) : String
  (let
    [message : String (tc-move-cleanup-owner-exit-message name)]
    [owner-label : String (tc-move-cleanup-owner-binding-label name)]
    (match (tc-expr-maybe-span scope)
      [(TcSomeAstSourceSpan primary-span)
        (match conflict
          [(TcSomeMoveConflict key move-origin-id)
            (match (tc-move-origin-span move-origin-id)
              [(TcSomeAstSourceSpan move-span)
                (match (tc-move-origin-span owner-origin-id)
                  [(TcSomeAstSourceSpan owner-span)
                    (tc-rich-error-two-secondaries
                      primary-span
                      message
                      (tc-move-help)
                      move-span
                      (tc-move-origin-label key)
                      owner-span
                      owner-label)]
                  [(TcNoAstSourceSpan)
                    (tc-rich-error-two-secondaries
                      primary-span
                      message
                      (tc-move-help)
                      move-span
                      (tc-move-origin-label key)
                      primary-span
                      owner-label)])]
              [(TcNoAstSourceSpan)
                (match (tc-move-origin-span owner-origin-id)
                  [(TcSomeAstSourceSpan owner-span)
                    (tc-rich-error-one-secondary
                      primary-span
                      message
                      (tc-move-help)
                      owner-span
                      owner-label)]
                  [(TcNoAstSourceSpan)
                    (tc-rich-error-one-secondary
                      primary-span
                      message
                      (tc-move-help)
                      primary-span
                      owner-label)])])]
          [TcNoMoveConflict
            (match (tc-move-origin-span owner-origin-id)
              [(TcSomeAstSourceSpan owner-span)
                (tc-rich-error-one-secondary
                  primary-span
                  message
                  (tc-move-help)
                  owner-span
                  owner-label)]
              [(TcNoAstSourceSpan)
                (tc-rich-error-one-secondary
                  primary-span
                  message
                  (tc-move-help)
                  primary-span
                  owner-label)])])]
      [(TcNoAstSourceSpan)
        (match conflict
          [(TcSomeMoveConflict key move-origin-id)
            (match (tc-move-origin-span move-origin-id)
              [(TcSomeAstSourceSpan move-span)
                (match (tc-move-origin-span owner-origin-id)
                  [(TcSomeAstSourceSpan owner-span)
                    (tc-rich-error-two-secondaries
                      move-span
                      message
                      (tc-move-help)
                      move-span
                      (tc-move-origin-label key)
                      owner-span
                      owner-label)]
                  [(TcNoAstSourceSpan)
                    (tc-rich-error-two-secondaries
                      move-span
                      message
                      (tc-move-help)
                      move-span
                      (tc-move-origin-label key)
                      move-span
                      owner-label)])]
              [(TcNoAstSourceSpan)
                (match (tc-move-origin-span owner-origin-id)
                  [(TcSomeAstSourceSpan owner-span)
                    (tc-rich-error-one-secondary
                      owner-span
                      message
                      (tc-move-help)
                      owner-span
                      owner-label)]
                  [(TcNoAstSourceSpan) message])])]
          [TcNoMoveConflict
            (match (tc-move-origin-span owner-origin-id)
              [(TcSomeAstSourceSpan owner-span)
                (tc-rich-error-one-secondary
                  owner-span
                  message
                  (tc-move-help)
                  owner-span
                  owner-label)]
              [(TcNoAstSourceSpan) message])])])))

(define (tc-move-rich-conflict-result
  [conflict : TcMoveConflict]
  [fallback-key : String]
  [primary : AstExpr]
  [message : String]) : TcMoveResult
  (ErrTcMove
    (tc-move-rich-conflict-message conflict fallback-key primary message)))

(define (tc-move-rich-use-conflict-result
  [conflict : TcMoveConflict]
  [fallback-key : String]
  [primary : AstExpr]
  [name : String]) : TcMoveResult
  (tc-move-rich-conflict-result
    conflict
    fallback-key
    primary
    (tc-move-use-message name)))

(define (tc-move-rich-loop-carried-result [name : String] [primary : AstExpr]) : TcMoveResult
  (ErrTcMove (tc-move-rich-loop-carried-message name primary)))

(define (tc-moved-path-key-conflicts? [key : String] [path : String]) : bool
  (let
    [new-key : String (tc-moved-path-key path)]
    [descendant-prefix : String
      (tc-moved-path-key (string.string-append path "."))]
    [ancestor-prefix : String (string.string-append key ".")]
    (if (tc-moved-path-key? key)
      (or
        (string.string-eq key new-key)
        (tc-move-string-prefix? key descendant-prefix)
        (tc-move-string-prefix? new-key ancestor-prefix))
      false)))

(define (tc-moved-path-conflict-loop
  [map : hashmap.StringI64Map]
  [path : String]
  [index : i64]) : TcMoveConflict
  (if (>= index (hashmap.string-i64-map-capacity map))
    TcNoMoveConflict
    (match (hashmap.string-i64-map-entry-at map index)
      [(hashmap.StringI64MapEntrySome key value)
        (if (tc-moved-path-key-conflicts? key path)
          (TcSomeMoveConflict key value)
          (tc-moved-path-conflict-loop
            map
            path
            (hashmap.string-i64-map-next-occupied map (+ index 1))))]
      [(hashmap.StringI64MapEntryNone)
        (tc-moved-path-conflict-loop
          map
          path
          (hashmap.string-i64-map-next-occupied map (+ index 1)))])))

(define (tc-moved-path-conflict [set : TcMovedSet] [path : String]) : TcMoveConflict
  (tc-moved-path-conflict-loop
    (tc-moved-map set)
    path
    (hashmap.string-i64-map-next-occupied (tc-moved-map set) 0)))

(define (tc-moved-path-conflict? [set : TcMovedSet] [path : String]) : bool
  (match (tc-moved-path-conflict set path)
    [(TcSomeMoveConflict _ _) true]
    [TcNoMoveConflict false]))

(define (tc-moved-remove-prefix-loop
  [map : hashmap.StringI64Map]
  [prefix : String]
  [index : i64]
  [out : TcMovedSet]) : TcMovedSet
  (if (>= index (hashmap.string-i64-map-capacity map))
    out
    (match (hashmap.string-i64-map-entry-at map index)
      [(hashmap.StringI64MapEntrySome key _)
        (let
          [next : i64 (hashmap.string-i64-map-next-occupied map (+ index 1))]
          [out2 : TcMovedSet
            (if (tc-move-string-prefix? key prefix)
              (tc-moved-remove out key)
              out)]
          (tc-moved-remove-prefix-loop map prefix next out2))]
      [(hashmap.StringI64MapEntryNone)
        (tc-moved-remove-prefix-loop
          map
          prefix
          (hashmap.string-i64-map-next-occupied map (+ index 1))
          out)])))

(define (tc-moved-remove-prefix [set : TcMovedSet] [prefix : String]) : TcMovedSet
  (tc-moved-remove-prefix-loop
    (tc-moved-map set)
    prefix
    (hashmap.string-i64-map-next-occupied (tc-moved-map set) 0)
    set))

(define (tc-moved-remove-root-state [set : TcMovedSet] [name : String]) : TcMovedSet
  (tc-moved-remove-prefix
    (tc-moved-remove
      (tc-moved-remove (tc-moved-remove set name) (tc-moved-partial-key name))
      (tc-moved-path-key name))
    (tc-moved-path-key (string.string-append name "."))))

(define (tc-moved-any-path-with-prefix-loop?
  [map : hashmap.StringI64Map]
  [prefix : String]
  [index : i64]) : bool
  (if (>= index (hashmap.string-i64-map-capacity map))
    false
    (match (hashmap.string-i64-map-entry-at map index)
      [(hashmap.StringI64MapEntrySome key _)
        (if (and (tc-moved-path-key? key) (tc-move-string-prefix? key prefix))
          true
          (tc-moved-any-path-with-prefix-loop?
            map
            prefix
            (hashmap.string-i64-map-next-occupied map (+ index 1))))]
      [(hashmap.StringI64MapEntryNone)
        (tc-moved-any-path-with-prefix-loop?
          map
          prefix
          (hashmap.string-i64-map-next-occupied map (+ index 1)))])))

(define (tc-moved-any-root-path? [set : TcMovedSet] [root : String]) : bool
  (tc-moved-any-path-with-prefix-loop?
    (tc-moved-map set)
    (tc-moved-path-key (string.string-append root "."))
    (hashmap.string-i64-map-next-occupied (tc-moved-map set) 0)))

(define (tc-moved-root-path-conflict-loop
  [map : hashmap.StringI64Map]
  [prefix : String]
  [index : i64]) : TcMoveConflict
  (if (>= index (hashmap.string-i64-map-capacity map))
    TcNoMoveConflict
    (match (hashmap.string-i64-map-entry-at map index)
      [(hashmap.StringI64MapEntrySome key value)
        (if (and (tc-moved-path-key? key) (tc-move-string-prefix? key prefix))
          (TcSomeMoveConflict key value)
          (tc-moved-root-path-conflict-loop
            map
            prefix
            (hashmap.string-i64-map-next-occupied map (+ index 1))))]
      [(hashmap.StringI64MapEntryNone)
        (tc-moved-root-path-conflict-loop
          map
          prefix
          (hashmap.string-i64-map-next-occupied map (+ index 1)))])))

(define (tc-moved-root-path-conflict [set : TcMovedSet] [root : String]) : TcMoveConflict
  (tc-moved-root-path-conflict-loop
    (tc-moved-map set)
    (tc-moved-path-key (string.string-append root "."))
    (hashmap.string-i64-map-next-occupied (tc-moved-map set) 0)))

(define (tc-moved-root-conflict [set : TcMovedSet] [root : String]) : TcMoveConflict
  (match (tc-moved-conflict set root)
    [(TcSomeMoveConflict key origin-id) (TcSomeMoveConflict key origin-id)]
    [TcNoMoveConflict
      (match (tc-moved-root-path-conflict set root)
        [(TcSomeMoveConflict key origin-id) (TcSomeMoveConflict key origin-id)]
        [TcNoMoveConflict (tc-moved-conflict set (tc-moved-partial-key root))])]))

(define (tc-moved-remove-exact-path
  [set : TcMovedSet]
  [root : String]
  [path : String]) : TcMovedSet
  (let
    [without-path : TcMovedSet (tc-moved-remove set (tc-moved-path-key path))]
    (if (tc-moved-any-root-path? without-path root)
      without-path
      (tc-moved-remove without-path (tc-moved-partial-key root)))))

(define (tc-moved-union-loop
  [a : hashmap.StringI64Map]
  [index : i64]
  [out : TcMovedSet]) : TcMovedSet
  (if (>= index (hashmap.string-i64-map-capacity a))
    out
    (match (hashmap.string-i64-map-entry-at a index)
      [(hashmap.StringI64MapEntrySome key value)
        (tc-moved-union-loop
          a
          (hashmap.string-i64-map-next-occupied a (+ index 1))
          (tc-moved-add-value out key value))]
      [(hashmap.StringI64MapEntryNone)
        (tc-moved-union-loop
          a
          (hashmap.string-i64-map-next-occupied a (+ index 1))
          out)])))

;; Union keeps the left input's value for duplicate facts. Branch merging
;; therefore reports the origin from the first/left arm deterministically.
(define (tc-moved-union [a : TcMovedSet] [b : TcMovedSet]) : TcMovedSet
  (tc-moved-union-loop
    (tc-moved-map a)
    (hashmap.string-i64-map-next-occupied (tc-moved-map a) 0)
    b))

(define (tc-move-var-move-only? [env : TcTypeEnv] [name : String]) : bool
  (match (tc-lookup env name)
    [(OkTcType ty) (tc-type-move-only? ty)]
    [(ErrTcType _) false]))

(define (tc-type-consuming-by-value-now? [ctx : TcContext] [ty : AstType]) : bool
  (let
    [resolved : AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
    (match resolved
      [(AstTyBox _) true]
      [(AstTyStruct name)
        (if (tc-thread-safe-handle-type-name? (intern-str name))
          true
          (tc-cleanup-owning-struct-type? ctx resolved))]
      [(AstTyStructArgs name _)
        (if (tc-thread-safe-handle-type-name? (intern-str name))
          true
          (tc-cleanup-owning-struct-type? ctx resolved))]
      [_ false])))

;; Matching a cleanup-owning enum consumes the whole scrutinee value. Ordinary
;; enums stay compatibility-non-consuming for existing AST/IR-style sharing.
(define (tc-type-consuming-match-scrutinee-now?
  [ctx : TcContext]
  [ty : AstType]) : bool
  (tc-cleanup-owning-enum-type? ctx ty))

;; The bare variable named by an init/rhs expression, unwrapping spans and
;; annotations, or none if the expression is not a whole-variable reference.
(define (tc-move-bare-var [expr : AstExpr]) : TcMaybeString
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-bare-var inner))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-bare-var inner))]
    [(AstExprVar name) (TcSomeString (intern-str name))]
    [_ (TcNoString)]))

;; The root local named by a projection chain. This intentionally returns bare
;; variables too so consuming sites can share one helper for whole values and
;; projected owner fields/elements.
(define (tc-move-root-projection-var [expr : AstExpr]) : TcMaybeString
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-root-projection-var inner))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-root-projection-var inner))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-root-projection-var inner))]
    [(AstExprStructGet inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-root-projection-var inner))]
    [(AstExprTupleRef inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-root-projection-var inner))]
    [(AstExprArrayRef array-box _)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-move-root-projection-var array))]
    [(AstExprBoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-root-projection-var inner))]
    [(AstExprVar name) (TcSomeString (intern-str name))]
    [_ (TcNoString)]))

(define (tc-move-dynamic-array-element-message) : String
  "typecheck: cannot move owner-consuming value out of dynamic array element")

(define (tc-move-box-projection-message) : String
  "typecheck: cannot move owner-consuming value out of box")

(define (tc-move-aggregate-path-message) : String
  "typecheck: cannot move owner-consuming value out of aggregate path")

(define (tc-move-aggregate-path-projection? [expr : AstExpr]) : bool
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-aggregate-path-projection? inner))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-aggregate-path-projection? inner))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-aggregate-path-projection? inner))]
    [(AstExprStructGet _ _) true]
    [(AstExprTupleRef _ _) true]
    [(AstExprArrayRef _ _) true]
    [(AstExprBoxGet _) true]
    [_ false]))

(define (tc-move-path-append [base : String] [field : String]) : String
  (string.string-append (string.string-append base ".") field))

(define (tc-move-tuple-index-path [base : String] [index : i64]) : String
  (string.string-append
    (string.string-append base ".#tuple.")
    (string.int->string index)))

(define (tc-move-array-index-path [base : String] [index : i64]) : String
  (string.string-append
    (string.string-append base ".#array.")
    (string.int->string index)))

(define (tc-move-literal-index [expr : AstExpr]) : TcMoveMaybeIndex
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-literal-index inner))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-literal-index inner))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-literal-index inner))]
    [(AstExprLiteral lit)
      (match lit
        [(AstLitInt index _) (TcMoveSomeIndex index)]
        [_ (TcMoveNoIndex)])]
    [_ (TcMoveNoIndex)]))

(define (tc-move-direct-root-base-path [expr : AstExpr]) : TcMaybeString
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-direct-root-base-path inner))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-direct-root-base-path inner))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-direct-root-base-path inner))]
    [(AstExprStructGet inner-box field)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-move-direct-root-base-path inner)
          [(TcSomeString base)
            (TcSomeString (tc-move-path-append base (intern-str field)))]
          [(TcNoString) (TcNoString)]))]
    [(AstExprTupleRef inner-box index)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-move-direct-root-base-path inner)
          [(TcSomeString base)
            (TcSomeString (tc-move-tuple-index-path base index))]
          [(TcNoString) (TcNoString)]))]
    [(AstExprArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index-expr : AstExpr (ast-node-get index-box)]
        (match (tc-move-direct-root-base-path array)
          [(TcSomeString base)
            (match (tc-move-literal-index index-expr)
              [(TcMoveSomeIndex index)
                (TcSomeString (tc-move-array-index-path base index))]
              [(TcMoveNoIndex) (TcNoString)])]
          [(TcNoString) (TcNoString)]))]
    [(AstExprVar name) (TcSomeString (intern-str name))]
    [_ (TcNoString)]))

(define (tc-move-struct-field-path [expr : AstExpr]) : TcMaybeString
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-struct-field-path inner))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-struct-field-path inner))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-struct-field-path inner))]
    [(AstExprStructGet inner-box field)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-move-direct-root-base-path inner)
          [(TcSomeString base)
            (TcSomeString (tc-move-path-append base (intern-str field)))]
          [(TcNoString) (TcNoString)]))]
    [_ (TcNoString)]))

(define (tc-move-tuple-element-path [expr : AstExpr]) : TcMaybeString
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-tuple-element-path inner))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-tuple-element-path inner))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-tuple-element-path inner))]
    [(AstExprTupleRef inner-box index)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-move-direct-root-base-path inner)
          [(TcSomeString base)
            (TcSomeString (tc-move-tuple-index-path base index))]
          [(TcNoString) (TcNoString)]))]
    [_ (TcNoString)]))

(define (tc-move-array-element-path [expr : AstExpr]) : TcMaybeString
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-array-element-path inner))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-array-element-path inner))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-array-element-path inner))]
    [(AstExprArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index-expr : AstExpr (ast-node-get index-box)]
        (tc-move-array-set-path array index-expr))]
    [_ (TcNoString)]))

(define (tc-move-array-set-path [array : AstExpr] [index-expr : AstExpr]) : TcMaybeString
  (match (tc-move-direct-root-base-path array)
    [(TcSomeString base)
      (match (tc-move-literal-index index-expr)
        [(TcMoveSomeIndex index)
          (TcSomeString (tc-move-array-index-path base index))]
        [(TcMoveNoIndex) (TcNoString)])]
    [(TcNoString) (TcNoString)]))

(define (tc-move-struct-set-path [receiver : AstExpr] [field : String]) : TcMaybeString
  (match (tc-move-direct-root-base-path receiver)
    [(TcSomeString base) (TcSomeString (tc-move-path-append base field))]
    [(TcNoString) (TcNoString)]))

(define (tc-move-reinitialize-array-set-path
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [array : AstExpr]
  [index : AstExpr]) : TcMovedSet
  (match (tc-move-array-set-path array index)
    [(TcSomeString path)
      (match (tc-move-root-projection-var array)
        [(TcSomeString root)
          (if (tc-moved-contains? locals root)
            (tc-moved-remove-exact-path moved root path)
            moved)]
        [(TcNoString) moved])]
    [(TcNoString) moved]))

(define (tc-move-reinitialize-struct-set-path
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [receiver : AstExpr]
  [field : String]) : TcMovedSet
  (match (tc-move-struct-set-path receiver field)
    [(TcSomeString path)
      (match (tc-move-root-projection-var receiver)
        [(TcSomeString root)
          (if (tc-moved-contains? locals root)
            (tc-moved-remove-exact-path moved root path)
            moved)]
        [(TcNoString) moved])]
    [(TcNoString) moved]))

(define (tc-move-projection-path [expr : AstExpr]) : TcMaybeString
  (match (tc-move-struct-field-path expr)
    [(TcSomeString path) (TcSomeString path)]
    [(TcNoString)
      (match (tc-move-tuple-element-path expr)
        [(TcSomeString path) (TcSomeString path)]
        [(TcNoString) (tc-move-array-element-path expr)])]))

(define (tc-moved-add-projection-path
  [moved : TcMovedSet]
  [root : String]
  [path : String]
  [origin : AstExpr]) : TcMovedSet
  (let
    [origin-id : i64 (ast-node-push origin)]
    (tc-moved-add-value
      (tc-moved-add-value moved (tc-moved-path-key path) origin-id)
      (tc-moved-partial-key root)
      origin-id)))

(define (tc-move-box-projection? [expr : AstExpr]) : bool
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-box-projection? inner))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-box-projection? inner))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-box-projection? inner))]
    [(AstExprStructGet inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-box-projection? inner))]
    [(AstExprTupleRef inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-box-projection? inner))]
    [(AstExprArrayRef array-box _)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-move-box-projection? array))]
    [(AstExprBoxGet _) true]
    [_ false]))

(define (tc-move-dynamic-array-element-projection?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]) : bool
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-dynamic-array-element-projection? ctx env inner))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-dynamic-array-element-projection? ctx env inner))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-dynamic-array-element-projection? ctx env inner))]
    [(AstExprStructGet inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-dynamic-array-element-projection? ctx env inner))]
    [(AstExprTupleRef inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-dynamic-array-element-projection? ctx env inner))]
    [(AstExprArrayRef array-box _)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (match (tc-expr ctx env array)
          [(OkTcType array-ty)
            (match (tc-type-strip-region (tc-resolve-type ctx array-ty))
              [(AstTyDynArray _) true]
              [_ (tc-move-dynamic-array-element-projection? ctx env array)])]
          [(ErrTcType _)
            (tc-move-dynamic-array-element-projection? ctx env array)]))]
    [(AstExprBoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-dynamic-array-element-projection? ctx env inner))]
    [_ false]))

(define (tc-move-binding-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [maybe-ty : AstMaybeType]
  [init : AstExpr]) : AstType
  (match maybe-ty
    [(AstSomeType t) (tc-resolve-type ctx t)]
    [(AstNoType)
      (match (tc-expr ctx env init)
        [(OkTcType t) t]
        [(ErrTcType _) (AstTyI64)])]))

;; The names that are genuine local/parameter bindings, seeded from a function's
;; parameter list. Only these are tracked as movable places; enum constructors,
;; globals, and function references share the variable syntax but are never moved.
(define (tc-move-params-locals [params : AstParamList] [acc : TcMovedSet]) : TcMovedSet
  (match params
    [(AstParamNil) acc]
    [(AstParamCons param rest)
      (let
        [rest : AstParamList (box-get rest)]
        (match param
          [(AstParam name _ _)
            (tc-move-params-locals rest (tc-moved-add acc (intern-str name)))]))]))

(define (tc-move-after-consuming-projection
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : AstExpr]) : TcMoveResult
  (if (tc-move-dynamic-array-element-projection? ctx env expr)
    (ErrTcMove (tc-move-dynamic-array-element-message))
    (if (tc-move-box-projection? expr)
      (ErrTcMove (tc-move-box-projection-message))
      (match (tc-move-projection-path expr)
        [(TcSomeString path)
          (match (tc-move-root-projection-var expr)
            [(TcSomeString root)
              (if (tc-moved-contains? locals root)
                (match (tc-moved-path-conflict moved path)
                  [(TcSomeMoveConflict key origin-id)
                    (tc-move-rich-use-conflict-result
                      (TcSomeMoveConflict key origin-id)
                      (tc-moved-path-key path)
                      expr
                      path)]
                  [TcNoMoveConflict
                    (OkTcMove
                      (tc-moved-add-projection-path moved root path expr))])
                (OkTcMove moved))]
            [(TcNoString) (OkTcMove moved)])]
        [(TcNoString)
          (if (tc-move-aggregate-path-projection? expr)
            (ErrTcMove (tc-move-aggregate-path-message))
            (match (tc-move-root-projection-var expr)
              [(TcSomeString root)
                (if (tc-moved-contains? locals root)
                  (if (tc-moved-partial? moved root)
                    (tc-move-rich-use-conflict-result
                      (tc-moved-root-conflict moved root)
                      root
                      expr
                      root)
                    (if (tc-moved-contains? loop-carried root)
                      (tc-move-rich-loop-carried-result root expr)
                      (OkTcMove (tc-moved-add-origin moved root expr))))
                  (OkTcMove moved))]
              [(TcNoString) (OkTcMove moved)]))]))))

;; Mark the source variable moved when an init/rhs is a bare move-only variable
;; that names a tracked local/parameter (not an enum constructor or global).
(define (tc-move-after-bind
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [init : AstExpr]) : TcMoveResult
  (match (tc-move-bare-var init)
    [(TcSomeString v)
      (if (and (tc-moved-contains? locals v) (tc-move-var-move-only? env v))
        (if (tc-moved-partial? moved v)
          (tc-move-rich-use-conflict-result
            (tc-moved-root-conflict moved v)
            v
            init
            v)
          (if (tc-moved-contains? loop-carried v)
            (tc-move-rich-loop-carried-result v init)
            (OkTcMove (tc-moved-add-origin moved v init))))
        (OkTcMove moved))]
    [(TcNoString)
      (match (cfg
        compile-profile
        (compiler-tc-reinfer-profile-expr "move.bind_init" ctx env init)
        (tc-expr ctx env init))
        [(OkTcType init-ty)
          (if (tc-type-consuming-by-value-now? ctx init-ty)
            (tc-move-after-consuming-projection
              ctx
              env
              locals
              loop-carried
              moved
              init)
            (OkTcMove moved))]
        [(ErrTcType _) (OkTcMove moved)])]))

(define (tc-move-after-moving-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : AstExpr]
  [move? : bool]) : TcMoveResult
  (if move?
    (tc-move-after-consuming-projection ctx env locals loop-carried moved expr)
    (OkTcMove moved)))

(define (tc-move-after-consuming-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : AstExpr]
  [target-ty : AstType]) : TcMoveResult
  (tc-move-after-moving-value
    ctx
    env
    locals
    loop-carried
    moved
    expr
    (tc-type-consuming-by-value-now? ctx target-ty)))

(define (tc-move-after-move-only-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : AstExpr]
  [target-ty : AstType]) : TcMoveResult
  (tc-move-after-moving-value
    ctx
    env
    locals
    loop-carried
    moved
    expr
    (tc-type-move-only? (tc-resolve-type ctx target-ty))))

(define (tc-move-after-match-scrutinee
  [ctx : TcContext]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [expr : AstExpr]
  [scrut-ty : AstType]) : TcMovedSet
  (match (tc-move-bare-var expr)
    [(TcSomeString v)
      (if (and
        (tc-moved-contains? locals v)
        (tc-type-consuming-match-scrutinee-now? ctx scrut-ty))
        (tc-moved-add-origin moved v expr)
        moved)]
    [(TcNoString) moved]))

(define (tc-move-check-lambda-owner-captures-scan
  [ctx : TcContext]
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [bound : TcStringList]
  [seen : TcStringList]
  [remaining : i64]
  [body : AstExpr]) : TcMoveResult
  (if (<= remaining 0)
    (OkTcMove moved)
    (match env
      [(TcTypeNil) (OkTcMove moved)]
      [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
        (if scan-through
          (tc-move-check-lambda-owner-captures-scan
            ctx
            root
            (box-get rest)
            locals
            loop-carried
            moved
            bound
            seen
            remaining
            body)
          (OkTcMove moved))]
      [(TcTypeBind key ty rest)
        (let
          [rest-env : TcTypeEnv (box-get rest)]
          [name : String (intern-str key)]
          (cond
            [(= key (tc-default-boundary-id)) (OkTcMove moved)]
            [(or
                (= key (tc-region-marker-id))
                (tc-cleanup-owner-marker-entry? key ty))
              (tc-move-check-lambda-owner-captures-scan
                ctx
                root
                rest-env
                locals
                loop-carried
                moved
                bound
                seen
                remaining
                body)]
            [(tc-string-list-contains seen name)
              (tc-move-check-lambda-owner-captures-scan
                ctx
                root
                rest-env
                locals
                loop-carried
                moved
                bound
                seen
                remaining
                body)]
            [(not (tc-moved-contains? locals name))
              (tc-move-check-lambda-owner-captures-scan
                ctx
                root
                rest-env
                locals
                loop-carried
                moved
                bound
                seen
                remaining
                body)]
            [(not (tc-expr-uses-free-name? body name bound))
              (tc-move-check-lambda-owner-captures-scan
                ctx
                root
                rest-env
                locals
                loop-carried
                moved
                bound
                (tc-string-list-add seen name)
                (- remaining 1)
                body)]
            [else
              (match (tc-lookup-id root key)
                [(OkTcType visible-ty)
                  (if (tc-type-consuming-by-value-now? ctx visible-ty)
                    (if (or
                      (tc-moved-contains? moved name)
                      (tc-moved-partial? moved name))
                      (tc-move-rich-use-conflict-result
                        (tc-moved-root-conflict moved name)
                        name
                        body
                        name)
                      (if (tc-moved-contains? loop-carried name)
                        (tc-move-rich-loop-carried-result name body)
                        (tc-move-check-lambda-owner-captures-scan
                          ctx
                          root
                          rest-env
                          locals
                          loop-carried
                          (tc-moved-add-origin moved name body)
                          bound
                          (tc-string-list-add seen name)
                          (- remaining 1)
                          body)))
                    (tc-move-check-lambda-owner-captures-scan
                      ctx
                      root
                      rest-env
                      locals
                      loop-carried
                      moved
                      bound
                      (tc-string-list-add seen name)
                      (- remaining 1)
                      body))]
                [(ErrTcType _)
                  (tc-move-check-lambda-owner-captures-scan
                    ctx
                    root
                    rest-env
                    locals
                    loop-carried
                    moved
                    bound
                    (tc-string-list-add seen name)
                    (- remaining 1)
                    body)])]))])))

(define (tc-move-check-lambda-owner-captures
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [params : AstParamList]
  [body : AstExpr]) : TcMoveResult
  (tc-move-check-lambda-owner-captures-scan
    ctx
    env
    env
    locals
    loop-carried
    moved
    (tc-param-bound-names params)
    TcStringNil
    (tc-moved-len locals)
    body))

(define (tc-move-check-exprs-with-types-no-auto
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : AstExprList]
  [types : AstTypeList]) : TcMoveResult
  (match exprs
    [(AstExprNil)
      (match types
        [(AstTypeNil) (OkTcMove moved)]
        [_ (ErrTcMove "typecheck: arity mismatch")])]
    [(AstExprCons head rest)
      (let
        [head-expr : AstExpr (ast-node-get head)]
        [rest : AstExprList (box-get rest)]
        (match types
          [(AstTypeCons ty rest-types)
            (let
              [ty : AstType (ty-node-get ty)]
              [rest-types : AstTypeList (box-get rest-types)]
              (match (tc-move-check-expr-id
                ctx
                env
                locals
                loop-carried
                moved
                head)
                [(OkTcMove moved1)
                  (match (tc-move-after-consuming-value
                    ctx
                    env
                    locals
                    loop-carried
                    moved1
                    head-expr
                    ty)
                    [(OkTcMove moved2)
                      (tc-move-check-exprs-with-types-no-auto
                        ctx
                        env
                        locals
                        loop-carried
                        moved2
                        rest
                        rest-types)]
                    [(ErrTcMove message) (ErrTcMove message)])]
                [(ErrTcMove message) (ErrTcMove message)]))]
          [(AstTypeNil) (ErrTcMove "typecheck: arity mismatch")]))]))

(define (tc-move-check-exprs-with-types-auto
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : AstExprList]
  [types : AstTypeList]) : TcMoveResult
  (match exprs
    [(AstExprNil)
      (match types
        [(AstTypeNil) (OkTcMove moved)]
        [_ (ErrTcMove "typecheck: arity mismatch")])]
    [(AstExprCons head rest)
      (let
        [head-expr : AstExpr (ast-node-get head)]
        [rest : AstExprList (box-get rest)]
        (match types
          [(AstTypeCons ty rest-types)
            (let
              [ty : AstType (ty-node-get ty)]
              [rest-types : AstTypeList (box-get rest-types)]
              (match (cfg
                compile-profile
                (compiler-tc-reinfer-profile-effective-arg-expr
                  "move.call_arg"
                  ctx
                  env
                  head-expr
                  ty)
                (tc-call-effective-arg-expr ctx env head-expr ty))
                [(OkTcExpr effective-head)
                  (match (tc-move-check-expr
                    ctx
                    env
                    locals
                    loop-carried
                    moved
                    effective-head)
                    [(OkTcMove moved1)
                      (match (tc-move-after-consuming-value
                        ctx
                        env
                        locals
                        loop-carried
                        moved1
                        effective-head
                        ty)
                        [(OkTcMove moved2)
                          (tc-move-check-exprs-with-types-auto
                            ctx
                            env
                            locals
                            loop-carried
                            moved2
                            rest
                            rest-types)]
                        [(ErrTcMove message) (ErrTcMove message)])]
                    [(ErrTcMove message) (ErrTcMove message)])]
                [(ErrTcExpr message) (ErrTcMove message)]))]
          [(AstTypeNil) (ErrTcMove "typecheck: arity mismatch")]))]))

(define (tc-move-check-exprs-with-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : AstExprList]
  [types : AstTypeList]) : TcMoveResult
  (if (tc-call-type-list-has-immutable-ref-formal? ctx types)
    (tc-move-check-exprs-with-types-auto
      ctx
      env
      locals
      loop-carried
      moved
      exprs
      types)
    (tc-move-check-exprs-with-types-no-auto
      ctx
      env
      locals
      loop-carried
      moved
      exprs
      types)))

(define (tc-move-check-thread-channel-send-message
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]) : TcMoveResult
  (if (tc-thread-channel-send-call? ctx env func)
    (match (tc-thread-channel-send-call-name func)
      [(TcSomeString _)
        (match (tc-thread-channel-send-message-param params)
          [(OkTcType message-ty)
            (match (tc-thread-channel-send-message-arg args)
              [(OkTcExpr message-expr)
                (tc-move-after-move-only-value
                  ctx
                  env
                  locals
                  loop-carried
                  moved
                  message-expr
                  message-ty)]
              [(ErrTcExpr message) (ErrTcMove message)])]
          [(ErrTcType message) (ErrTcMove message)])]
      [(TcNoString) (OkTcMove moved)])
    (OkTcMove moved)))

(define (tc-move-check-call-args-with-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]) : TcMoveResult
  (match (tc-move-check-exprs-with-types
    ctx
    env
    locals
    loop-carried
    moved
    args
    params)
    [(OkTcMove moved-args)
      (tc-move-check-thread-channel-send-message
        ctx
        env
        locals
        loop-carried
        moved-args
        func
        args
        params)]
    [(ErrTcMove message) (ErrTcMove message)]))

(define (tc-move-call-param-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]) : ResultTcTypeList
  (match (tc-expr ctx env func)
    [(OkTcType fn-ty)
      (match (tc-type-strip-region fn-ty)
        [(AstTyFunc params _) (OkTcTypeList (box-get params))]
        [(AstTyEnum _) (OkTcTypeList AstTypeNil)]
        [(AstTyEnumArgs _ _) (OkTcTypeList AstTypeNil)]
        [_ (ErrTcTypeList "typecheck: call target is not a function")])]
    [(ErrTcType message) (ErrTcTypeList message)]))

(define (tc-move-call-param-types-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]) : ResultTcTypeList
  (match (tc-expr-id ctx env func-id)
    [(OkTcType fn-ty)
      (match (tc-type-strip-region fn-ty)
        [(AstTyFunc params _) (OkTcTypeList (box-get params))]
        [(AstTyEnum _) (OkTcTypeList AstTypeNil)]
        [(AstTyEnumArgs _ _) (OkTcTypeList AstTypeNil)]
        [_ (ErrTcTypeList "typecheck: call target is not a function")])]
    [(ErrTcType message) (ErrTcTypeList message)]))

(define (tc-move-check-exprs
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : AstExprList]) : TcMoveResult
  (match exprs
    [(AstExprNil) (OkTcMove moved)]
    [(AstExprCons head rest)
      (let
        [rest : AstExprList (box-get rest)]
        (match (tc-move-check-expr-id ctx env locals loop-carried moved head)
          [(OkTcMove moved1)
            (tc-move-check-exprs ctx env locals loop-carried moved1 rest)]
          [(ErrTcMove message) (ErrTcMove message)]))]))

(define (tc-move-check-let-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [bindings : AstLetBindingList]) : TcMoveBindings
  (match bindings
    [(AstLetBindingNil) (OkTcMoveBindings env moved locals loop-carried)]
    [(AstLetBindingCons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding name maybe-ty init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (match (tc-move-check-expr-id
                ctx
                env
                locals
                loop-carried
                moved
                init-box)
                [(OkTcMove moved1)
                  (match (tc-move-after-bind
                    ctx
                    env
                    locals
                    loop-carried
                    moved1
                    init)
                    [(OkTcMove moved2)
                      (tc-move-check-let-bindings
                        ctx
                        (let
                          [binding-ty : AstType
                            (cfg
                              compile-profile
                              (compiler-tc-reinfer-profile-binding-type
                                "move.let_init"
                                ctx
                                env
                                maybe-ty
                                init)
                              (tc-move-binding-type ctx env maybe-ty init))]
                          (tc-bind-c-abi-fnptr-if-needed-id
                            ctx
                            env
                            name
                            binding-ty
                            init))
                        (tc-moved-add locals (intern-str name))
                        (tc-moved-remove-root-state
                          loop-carried
                          (intern-str name))
                        (tc-moved-remove-root-state moved2 (intern-str name))
                        rest)]
                    [(ErrTcMove message) (ErrTcMoveBindings message)])]
                [(ErrTcMove message) (ErrTcMoveBindings message)]))]))]))

(define (tc-move-check-resource-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [bindings : AstResourceBindingList]) : TcMoveResourceBindings
  (match bindings
    [(AstResourceBindingNil)
      (OkTcMoveResourceBindings
        env
        moved
        locals
        loop-carried
        TcMoveCleanupOwnersNil)]
    [(AstResourceBindingCons binding rest)
      (let
        [rest : AstResourceBindingList (box-get rest)]
        (match binding
          [(AstResourceBinding name init-box _)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (match (tc-move-check-expr-id
                ctx
                env
                locals
                loop-carried
                moved
                init-box)
                [(OkTcMove moved1)
                  (match (tc-move-after-bind
                    ctx
                    env
                    locals
                    loop-carried
                    moved1
                    init)
                    [(OkTcMove moved2)
                      (match (cfg
                        compile-profile
                        (compiler-tc-reinfer-profile-expr
                          "move.resource_init"
                          ctx
                          env
                          init)
                        (tc-expr-id ctx env init-box))
                        [(OkTcType init-ty)
                          (match (tc-move-check-resource-bindings
                            ctx
                            (tc-bind-id
                              (tc-bind-cleanup-owner env (intern-str name))
                              name
                              (tc-type-without-regions init-ty))
                            (tc-moved-add locals (intern-str name))
                            (tc-moved-remove-root-state
                              loop-carried
                              (intern-str name))
                            (tc-moved-remove-root-state
                              moved2
                              (intern-str name))
                            rest)
                            [(OkTcMoveResourceBindings
                                env2
                                moved3
                                locals2
                                loop-carried2
                                roots)
                              (OkTcMoveResourceBindings
                                env2
                                moved3
                                locals2
                                loop-carried2
                                (TcMoveCleanupOwnersCons
                                  (intern-str name)
                                  init-box
                                  (box roots)))]
                            [(ErrTcMoveResourceBindings message)
                              (ErrTcMoveResourceBindings message)])]
                        [(ErrTcType message)
                          (ErrTcMoveResourceBindings message)])]
                    [(ErrTcMove message) (ErrTcMoveResourceBindings message)])]
                [(ErrTcMove message) (ErrTcMoveResourceBindings message)]))]))]))

(define (tc-move-check-cleanup-owner-exit
  [moved : TcMovedSet]
  [roots : TcMoveCleanupOwners]
  [scope : AstExpr]) : TcMoveResult
  (match roots
    [(TcMoveCleanupOwnersNil) (OkTcMove moved)]
    [(TcMoveCleanupOwnersCons name owner-origin-id rest)
      (if (or (tc-moved-contains? moved name) (tc-moved-partial? moved name))
        (ErrTcMove
          (tc-move-rich-cleanup-owner-exit-message
            (tc-moved-root-conflict moved name)
            name
            owner-origin-id
            scope))
        (tc-move-check-cleanup-owner-exit moved (box-get rest) scope))]))

(define (tc-move-add-bound-names [locals : TcMovedSet] [names : TcStringList]) : TcMovedSet
  (match names
    [(TcStringNil) locals]
    [(TcStringCons name rest)
      (tc-move-add-bound-names (tc-moved-add locals name) (box-get rest))]))

(define (tc-move-remove-bound-root-states
  [moved : TcMovedSet]
  [names : TcStringList]) : TcMovedSet
  (match names
    [(TcStringNil) moved]
    [(TcStringCons name rest)
      (tc-move-remove-bound-root-states
        (tc-moved-remove-root-state moved name)
        (box-get rest))]))

(define (tc-move-pattern-bound-names
  [ctx : TcContext]
  [scrut-ty : AstType]
  [pattern : AstPattern]) : TcStringList
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-match-coverage-type ctx scrut-ty)))
    [(AstTyEnum _)
      (match pattern
        [(AstPatVariant _ patterns-box)
          (let
            [patterns : AstPatternList (box-get patterns-box)]
            (tc-pattern-list-add-bound-names patterns TcStringNil))]
        [_ TcStringNil])]
    [(AstTyEnumArgs _ _)
      (match pattern
        [(AstPatVariant _ patterns-box)
          (let
            [patterns : AstPatternList (box-get patterns-box)]
            (tc-pattern-list-add-bound-names patterns TcStringNil))]
        [_ TcStringNil])]
    [_ (tc-pattern-add-bound-names pattern TcStringNil)]))

;; Each arm is checked from the same post-scrutinee state; results are unioned so
;; a place moved on any arm is considered moved after the match.
(define (tc-move-check-arms
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : TcMoveResult
  (match arms
    [(AstMatchArmNil) (OkTcMove moved)]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm pattern body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              [bound : TcStringList
                (tc-move-pattern-bound-names ctx scrut-ty pattern)]
              (match (tc-bind-match-pattern ctx env scrut-ty pattern)
                [(OkTcEnv arm-env)
                  (match (tc-move-check-expr
                    ctx
                    arm-env
                    (tc-move-add-bound-names (tc-moved-clone locals) bound)
                    (tc-move-remove-bound-root-states
                      (tc-moved-clone loop-carried)
                      bound)
                    (tc-move-remove-bound-root-states
                      (tc-moved-clone moved)
                      bound)
                    body)
                    [(OkTcMove arm-moved)
                      (let
                        [visible-arm-moved : TcMovedSet
                          (tc-moved-union
                            moved
                            (tc-move-remove-bound-root-states arm-moved bound))]
                        (match (tc-move-check-arms
                          ctx
                          env
                          (tc-moved-clone locals)
                          (tc-moved-clone loop-carried)
                          (tc-moved-clone moved)
                          scrut-ty
                          rest)
                          [(OkTcMove rest-moved)
                            (OkTcMove
                              (tc-moved-union visible-arm-moved rest-moved))]
                          [(ErrTcMove message) (ErrTcMove message)]))]
                    [(ErrTcMove message) (ErrTcMove message)])]
                [(ErrTcEnv message) (ErrTcMove message)]))]))]))

(define (tc-move-check-expr-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr-id : i64]) : TcMoveResult
  (tc-move-check-expr ctx env locals loop-carried moved (ast-node-get expr-id)))

(define (tc-move-check-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : AstExpr]) : TcMoveResult
  (match expr
    [(AstExprSpanned inner-box _)
      (tc-move-check-expr-id ctx env locals loop-carried moved inner-box)]
    [(AstExprLiteral _) (OkTcMove moved)]
    [(AstExprVar name)
      (let
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-expr-id env name-text)
            [(OkTcExprId virtual-id)
              (tc-move-check-expr-id
                ctx
                env
                locals
                loop-carried
                moved
                virtual-id)]
            [(ErrTcExprId message) (ErrTcMove message)])
          (if (tc-moved-contains? moved name-text)
            (tc-move-rich-use-conflict-result
              (tc-moved-conflict moved name-text)
              name-text
              expr
              name-text)
            (OkTcMove moved))))]
    [(AstExprBinary _ left-box right-box)
      (match (tc-move-check-expr-id ctx env locals loop-carried moved left-box)
        [(OkTcMove moved1)
          (tc-move-check-expr-id ctx env locals loop-carried moved1 right-box)]
        [(ErrTcMove message) (ErrTcMove message)])]
    [(AstExprUnary _ inner-box)
      (tc-move-check-expr-id ctx env locals loop-carried moved inner-box)]
    [(AstExprCall func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (match (tc-move-check-expr-id
          ctx
          env
          locals
          loop-carried
          moved
          func-box)
          [(OkTcMove moved1)
            (match (cfg
              compile-profile
              (compiler-tc-reinfer-profile-call-param-types
                "move.call_func"
                ctx
                env
                func)
              (tc-move-call-param-types-id ctx env func-box))
              [(OkTcTypeList params)
                (match (tc-call-extern-abi ctx func)
                  [(TcSomeExternAbi abi)
                    (if (tc-call-dynamic-c-varargs-abi? abi)
                      (match (tc-call-extern-varargs-params
                        ctx
                        env
                        args
                        params
                        abi)
                        [(OkTcTypeList expanded-params)
                          (tc-move-check-call-args-with-types
                            ctx
                            env
                            locals
                            loop-carried
                            moved1
                            func
                            args
                            expanded-params)]
                        [(ErrTcTypeList message) (ErrTcMove message)])
                      (tc-move-check-call-args-with-types
                        ctx
                        env
                        locals
                        loop-carried
                        moved1
                        func
                        args
                        params))]
                  [(TcNoExternAbi)
                    (tc-move-check-call-args-with-types
                      ctx
                      env
                      locals
                      loop-carried
                      moved1
                      func
                      args
                      params)])]
              [(ErrTcTypeList _)
                (tc-move-check-exprs ctx env locals loop-carried moved1 args)])]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprBracketClause items)
      (tc-move-check-exprs ctx env locals loop-carried moved items)]
    [(AstExprIf cond-box then-branch-box else-branch-box)
      (match (tc-move-check-expr-id ctx env locals loop-carried moved cond-box)
        [(OkTcMove movedc)
          (match (tc-move-check-expr-id
            ctx
            env
            (tc-moved-clone locals)
            (tc-moved-clone loop-carried)
            (tc-moved-clone movedc)
            then-branch-box)
            [(OkTcMove movedt)
              (match (tc-move-check-expr-id
                ctx
                env
                (tc-moved-clone locals)
                (tc-moved-clone loop-carried)
                (tc-moved-clone movedc)
                else-branch-box)
                [(OkTcMove movede) (OkTcMove (tc-moved-union movedt movede))]
                [(ErrTcMove message) (ErrTcMove message)])]
            [(ErrTcMove message) (ErrTcMove message)])]
        [(ErrTcMove message) (ErrTcMove message)])]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body-box)
          (match (tc-move-check-let-bindings
            ctx
            env
            (tc-moved-clone locals)
            (tc-moved-clone loop-carried)
            moved
            bindings)
            [(OkTcMoveBindings env2 moved2 locals2 loop-carried2)
              (tc-move-check-expr-id
                ctx
                env2
                locals2
                loop-carried2
                moved2
                body-box)]
            [(ErrTcMoveBindings message) (ErrTcMove message)])])]
    [(AstExprLambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda params _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            [lambda-env : TcTypeEnv (tc-bind-params ctx env params)]
            [lambda-locals : TcMovedSet
              (tc-move-params-locals params (tc-moved-clone locals))]
            (match (tc-move-check-expr-id
              ctx
              lambda-env
              lambda-locals
              (tc-moved-empty)
              (tc-moved-clone moved)
              body-box)
              [(OkTcMove _)
                (tc-move-check-lambda-owner-captures
                  ctx
                  env
                  locals
                  loop-carried
                  moved
                  params
                  body)]
              [(ErrTcMove message) (ErrTcMove message)]))])]
    [(AstExprTuple exprs)
      (match (cfg
        compile-profile
        (compiler-tc-reinfer-profile-expr-list-types
          "move.tuple_list"
          ctx
          env
          exprs)
        (tc-expr-list-types ctx env exprs))
        [(OkTcTypeList types)
          (tc-move-check-exprs-with-types
            ctx
            env
            locals
            loop-carried
            moved
            exprs
            types)]
        [(ErrTcTypeList _)
          (tc-move-check-exprs ctx env locals loop-carried moved exprs)])]
    [(AstExprTupleRef inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved inner)
          [(OkTcMove moved1)
            (match (tc-move-tuple-element-path expr)
              [(TcSomeString path)
                (if (tc-moved-contains? moved1 (tc-moved-path-key path))
                  (tc-move-rich-use-conflict-result
                    (tc-moved-conflict moved1 (tc-moved-path-key path))
                    (tc-moved-path-key path)
                    expr
                    path)
                  (OkTcMove moved1))]
              [(TcNoString) (OkTcMove moved1)])]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprArray exprs)
      (match (cfg
        compile-profile
        (compiler-tc-reinfer-profile-expr-list-types
          "move.array_list"
          ctx
          env
          exprs)
        (tc-expr-list-types ctx env exprs))
        [(OkTcTypeList types)
          (tc-move-check-exprs-with-types
            ctx
            env
            locals
            loop-carried
            moved
            exprs
            types)]
        [(ErrTcTypeList _)
          (tc-move-check-exprs ctx env locals loop-carried moved exprs)])]
    [(AstExprMakeArray _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExprArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved array)
          [(OkTcMove moved1)
            (match (tc-move-check-expr ctx env locals loop-carried moved1 index)
              [(OkTcMove moved2)
                (match (tc-move-array-element-path expr)
                  [(TcSomeString path)
                    (if (tc-moved-contains? moved2 (tc-moved-path-key path))
                      (tc-move-rich-use-conflict-result
                        (tc-moved-conflict moved2 (tc-moved-path-key path))
                        (tc-moved-path-key path)
                        expr
                        path)
                      (OkTcMove moved2))]
                  [(TcNoString) (OkTcMove moved2)])]
              [(ErrTcMove message) (ErrTcMove message)])]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved array)
          [(OkTcMove moved1)
            (match (tc-move-check-expr ctx env locals loop-carried moved1 index)
              [(OkTcMove moved2)
                (match (tc-move-check-expr
                  ctx
                  env
                  locals
                  loop-carried
                  moved2
                  value)
                  [(OkTcMove moved3)
                    (OkTcMove
                      (tc-move-reinitialize-array-set-path
                        locals
                        moved3
                        array
                        index))]
                  [(ErrTcMove message) (ErrTcMove message)])]
              [(ErrTcMove message) (ErrTcMove message)])]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprStructSet receiver-box field value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved receiver)
          [(OkTcMove moved1)
            (match (tc-move-check-expr ctx env locals loop-carried moved1 value)
              [(OkTcMove moved2)
                (OkTcMove
                  (tc-move-reinitialize-struct-set-path
                    locals
                    moved2
                    receiver
                    (intern-str field)))]
              [(ErrTcMove message) (ErrTcMove message)])]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved array)
          [(OkTcMove moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 value)]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprStringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved str)
          [(OkTcMove moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 index)]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprWhile cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved cond)
          [(OkTcMove movedc)
            (let
              [body-loop-carried : TcMovedSet
                (tc-moved-union locals (tc-moved-clone loop-carried))]
              (match (tc-move-check-expr
                ctx
                env
                (tc-moved-clone locals)
                body-loop-carried
                (tc-moved-clone movedc)
                body)
                [(OkTcMove _) (OkTcMove movedc)]
                [(ErrTcMove message) (ErrTcMove message)]))]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprBegin exprs)
      (tc-move-check-exprs ctx env locals loop-carried moved exprs)]
    [(AstExprUnsafe exprs)
      (tc-move-check-exprs ctx env locals loop-carried moved exprs)]
    [(AstExprSet name rhs-box)
      (let
        [rhs : AstExpr (ast-node-get rhs-box)]
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-set-expr-id env name-text rhs-box)
            [(OkTcExprId virtual-id)
              (tc-move-check-expr
                ctx
                env
                locals
                loop-carried
                moved
                (ast-node-get virtual-id))]
            [(ErrTcExprId message) (ErrTcMove message)])
          (match (tc-move-check-expr ctx env locals loop-carried moved rhs)
            [(OkTcMove moved1)
              (match (tc-move-after-bind ctx env locals loop-carried moved1 rhs)
                [(OkTcMove moved2)
                  (OkTcMove (tc-moved-remove-root-state moved2 name-text))]
                [(ErrTcMove message) (ErrTcMove message)])]
            [(ErrTcMove message) (ErrTcMove message)])))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExprBorrow _ _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExprMatch match-box)
      (match (box-get match-box)
        [(AstMatch scrut-box arms)
          (let
            [scrut : AstExpr (ast-node-get scrut-box)]
            (match (tc-move-check-expr ctx env locals loop-carried moved scrut)
              [(OkTcMove moveds)
                (match (cfg
                  compile-profile
                  (compiler-tc-reinfer-profile-expr
                    "move.match_scrutinee"
                    ctx
                    env
                    scrut)
                  (tc-expr ctx env scrut))
                  [(OkTcType scrut-ty)
                    (tc-move-check-arms
                      ctx
                      env
                      locals
                      loop-carried
                      (tc-move-after-match-scrutinee
                        ctx
                        locals
                        moveds
                        scrut
                        scrut-ty)
                      scrut-ty
                      arms)]
                  [(ErrTcType _)
                    (tc-move-check-arms
                      ctx
                      env
                      locals
                      loop-carried
                      moveds
                      (AstTyUnit)
                      arms)])]
              [(ErrTcMove message) (ErrTcMove message)]))])]
    [(AstExprForeach fe-box)
      (match (box-get fe-box)
        [(AstForeach index index-ty start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-move-check-expr ctx env locals loop-carried moved start)
              [(OkTcMove moved1)
                (match (tc-move-check-expr
                  ctx
                  env
                  locals
                  loop-carried
                  moved1
                  end)
                  [(OkTcMove moved2)
                    (let
                      [body-loop-carried : TcMovedSet
                        (tc-moved-union locals (tc-moved-clone loop-carried))]
                      (match (tc-move-check-expr
                        ctx
                        (tc-bind-id env index (tc-resolve-type ctx index-ty))
                        (tc-moved-add
                          (tc-moved-clone locals)
                          (intern-str index))
                        (tc-moved-remove-root-state
                          body-loop-carried
                          (intern-str index))
                        (tc-moved-clone moved2)
                        body)
                        [(OkTcMove _) (OkTcMove moved2)]
                        [(ErrTcMove message) (ErrTcMove message)]))]
                  [(ErrTcMove message) (ErrTcMove message)])]
              [(ErrTcMove message) (ErrTcMove message)]))])]
    [(AstExprSpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce _ _ _ a-box b-box c-box d-box)
          (let
            [a : AstExpr (ast-node-get a-box)]
            [b : AstExpr (ast-node-get b-box)]
            [c : AstExpr (ast-node-get c-box)]
            [d : AstExpr (ast-node-get d-box)]
            (match (tc-move-check-expr ctx env locals loop-carried moved a)
              [(OkTcMove m1)
                (match (tc-move-check-expr ctx env locals loop-carried m1 b)
                  [(OkTcMove m2)
                    (match (tc-move-check-expr ctx env locals loop-carried m2 c)
                      [(OkTcMove m3)
                        (tc-move-check-expr ctx env locals loop-carried m3 d)]
                      [(ErrTcMove message) (ErrTcMove message)])]
                  [(ErrTcMove message) (ErrTcMove message)])]
              [(ErrTcMove message) (ErrTcMove message)]))])]
    [(AstExprSpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan
            _
            index
            index-ty
            start-box
            end-box
            prefix
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-move-check-expr ctx env locals loop-carried moved start)
              [(OkTcMove m1)
                (match (tc-move-check-expr ctx env locals loop-carried m1 end)
                  [(OkTcMove m2)
                    (match (tc-move-check-expr
                      ctx
                      env
                      locals
                      loop-carried
                      m2
                      init)
                      [(OkTcMove m3)
                        (match (tc-move-check-expr
                          ctx
                          (tc-bind-id env index (tc-resolve-type ctx index-ty))
                          (tc-moved-add
                            (tc-moved-clone locals)
                            (intern-str index))
                          loop-carried
                          m3
                          value)
                          [(OkTcMove m4)
                            (let
                              [scan-env : TcTypeEnv
                                (tc-bind-id
                                  (tc-bind-id
                                    env
                                    index
                                    (tc-resolve-type ctx index-ty))
                                  prefix
                                  (tc-resolve-type ctx prefix-ty))]
                              [scan-locals : TcMovedSet
                                (tc-moved-add
                                  (tc-moved-add
                                    (tc-moved-clone locals)
                                    (intern-str index))
                                  (intern-str prefix))]
                              (match (tc-move-check-expr
                                ctx
                                scan-env
                                scan-locals
                                loop-carried
                                m4
                                body)
                                [(OkTcMove _) (OkTcMove m4)]
                                [(ErrTcMove message) (ErrTcMove message)]))]
                          [(ErrTcMove message) (ErrTcMove message)])]
                      [(ErrTcMove message) (ErrTcMove message)])]
                  [(ErrTcMove message) (ErrTcMove message)])]
              [(ErrTcMove message) (ErrTcMove message)]))])]
    [(AstExprSpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved value)
          [(OkTcMove moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 lane)]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprSpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved value)
          [(OkTcMove moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 lane)]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprStructGet inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved inner)
          [(OkTcMove moved1)
            (match (tc-move-struct-field-path expr)
              [(TcSomeString path)
                (if (tc-moved-contains? moved1 (tc-moved-path-key path))
                  (tc-move-rich-use-conflict-result
                    (tc-moved-conflict moved1 (tc-moved-path-key path))
                    (tc-moved-path-key path)
                    expr
                    path)
                  (OkTcMove moved1))]
              [(TcNoString) (OkTcMove moved1)])]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprWithRegion _ exprs)
      (tc-move-check-exprs ctx env locals loop-carried moved exprs)]
    [(AstExprWithEscape scratch-box exprs)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved scratch)
          [(OkTcMove moved1)
            (tc-move-check-exprs ctx env locals loop-carried moved1 exprs)]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprWithScratch exprs)
      (tc-move-check-exprs ctx env locals loop-carried moved exprs)]
    [(AstExprInArena arena-box exprs)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved arena)
          [(OkTcMove moved1)
            (tc-move-check-exprs ctx env locals loop-carried moved1 exprs)]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprWithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource bindings exprs)
          (match (tc-move-check-resource-bindings
            ctx
            env
            locals
            loop-carried
            moved
            bindings)
            [(OkTcMoveResourceBindings
                body-env
                moved1
                body-locals
                body-loop
                roots)
              (match (tc-move-check-exprs
                ctx
                body-env
                body-locals
                body-loop
                moved1
                exprs)
                [(OkTcMove moved2)
                  (tc-move-check-cleanup-owner-exit moved2 roots expr)]
                [(ErrTcMove message) (ErrTcMove message)])]
            [(ErrTcMoveResourceBindings message) (ErrTcMove message)])])]
    [(AstExprBox inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExprBoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExprBoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved inner)
          [(OkTcMove moved1)
            (match (tc-expr ctx env inner)
              [(OkTcType box-ty)
                (tc-move-after-consuming-value
                  ctx
                  env
                  locals
                  loop-carried
                  moved1
                  inner
                  box-ty)]
              [(ErrTcType _) (OkTcMove moved1)])]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprBoxSet box-box value-box)
      (let
        [box-expr : AstExpr (ast-node-get box-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved box-expr)
          [(OkTcMove moved1)
            (match (tc-move-check-expr ctx env locals loop-carried moved1 value)
              [(OkTcMove moved2)
                (match (tc-move-after-bind
                  ctx
                  env
                  locals
                  loop-carried
                  moved2
                  value)
                  [(OkTcMove moved3) (OkTcMove moved3)]
                  [(ErrTcMove message) (ErrTcMove message)])]
              [(ErrTcMove message) (ErrTcMove message)])]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprTypeLiteral _) (OkTcMove moved)]
    [(AstExprInit _) (OkTcMove moved)]
    [(AstExprComptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExprQuote _) (OkTcMove moved)]
    [(AstExprQuasiquote _) (OkTcMove moved)]
    [(AstExprUnquote _) (OkTcMove moved)]
    [(AstExprUnquoteSplicing _) (OkTcMove moved)]
    [(AstExprTry inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExprReturn inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved inner)
          [(OkTcMove moved1)
            (match (tc-current-return-type env)
              [(OkTcType return-ty)
                (tc-move-after-consuming-value
                  ctx
                  env
                  locals
                  loop-carried
                  moved1
                  inner
                  return-ty)]
              [(ErrTcType _) (OkTcMove moved1)])]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprPtrNull _) (OkTcMove moved)]
    [(AstExprPtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExprPtrAddrOf name)
      (if (tc-moved-contains? moved (intern-str name))
        (tc-move-rich-use-conflict-result
          (tc-moved-conflict moved (intern-str name))
          (intern-str name)
          expr
          (intern-str name))
        (OkTcMove moved))]
    [(AstExprPtrRead inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExprPtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved ptr)
          [(OkTcMove moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 value)]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprPtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved ptr)
          [(OkTcMove moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 offset)]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprPtrCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExprPtrToInt inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExprIntToPtr inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExprStringData inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExprStringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved ptr)
          [(OkTcMove moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 len)]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprArrayData inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExprBinaryData _) (OkTcMove moved)]
    [(AstExprSpmdProgramIndex) (OkTcMove moved)]
    [(AstExprSpmdProgramCount) (OkTcMove moved)]
    [(AstExprProgramArgc) (OkTcMove moved)]
    [(AstExprProgramArgv) (OkTcMove moved)]
    [(AstExprProgramEnvp) (OkTcMove moved)]
    [(AstExprCpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved leaf)
          [(OkTcMove moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 subleaf)]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprCpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved leaf)
          [(OkTcMove moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 subleaf)]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprCpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved leaf)
          [(OkTcMove moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 subleaf)]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprCpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved leaf)
          [(OkTcMove moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 subleaf)]
          [(ErrTcMove message) (ErrTcMove message)]))]
    [(AstExprXgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (tc-move-check-expr ctx env locals loop-carried moved index))]
    [(AstExprSyscall args)
      (tc-move-check-exprs ctx env locals loop-carried moved args)]))

(define (tc-move-check-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]
  [body : AstExpr]) : ResultTcUnit
  (match (tc-move-check-expr
    ctx
    env
    (tc-move-params-locals params (tc-moved-empty))
    (tc-moved-empty)
    (tc-moved-empty)
    body)
    [(OkTcMove _) OkTcUnit]
    [(ErrTcMove message) (ErrTcUnit message)]))

(define (tc-move-check-body-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]
  [body-id : i64]) : ResultTcUnit
  (match (tc-move-check-expr-id
    ctx
    env
    (tc-move-params-locals params (tc-moved-empty))
    (tc-moved-empty)
    (tc-moved-empty)
    body-id)
    [(OkTcMove _) OkTcUnit]
    [(ErrTcMove message) (ErrTcUnit message)]))

;; --- lexical borrow conflict checker (#1050/#806) --------------------------
;;
;; Borrows are lexical in this staged model: `begin` keeps borrows live, while
;; `let`, `with-arena`, resource `with`, lambdas, and individual match arms
;; bound their own borrow additions. The checker reuses the move path encoding
;; so whole roots, fields, tuple elements, and fixed-array literal elements share
;; the same ancestor/descendant conflict policy as moved paths. Mutable borrows
;; add both the ordinary borrowed path and a namespaced mutable marker, allowing
;; many immutable borrows but only one exclusive mutable borrow.
(defenum TcBorrowCheckResult
  (OkTcBorrowCheck TcMovedSet)
  (ErrTcBorrowCheck String))

(defenum TcBorrowCheckBindings
  (OkTcBorrowCheckBindings TcTypeEnv TcMovedSet TcMovedSet)
  (ErrTcBorrowCheckBindings String))

(defenum TcBorrowCheckResourceBindings
  (OkTcBorrowCheckResourceBindings TcTypeEnv TcMovedSet TcMovedSet)
  (ErrTcBorrowCheckResourceBindings String))

(defenum TcBorrowConflictOrigin
  (TcNoBorrowConflictOrigin)
  (TcSomeBorrowConflictOrigin i64))

(define (tc-borrow-check-move-message [path : String]) : String
  (string.string-append
    (string.string-append "typecheck: cannot move borrowed place `" path)
    "`"))

(define (tc-borrow-check-assign-message [path : String]) : String
  (string.string-append
    (string.string-append "typecheck: cannot assign to borrowed place `" path)
    "`"))

(define (tc-borrow-check-mutably-borrow-message [path : String]) : String
  (string.string-append
    (string.string-append
      "typecheck: cannot mutably borrow borrowed place `"
      path)
    "`"))

(define (tc-borrow-check-immutably-borrow-message [path : String]) : String
  (string.string-append
    (string.string-append
      "typecheck: cannot immutably borrow mutably borrowed place `"
      path)
    "`"))

(define (tc-borrow-check-read-message [path : String]) : String
  (string.string-append
    (string.string-append
      "typecheck: cannot read mutably borrowed place `"
      path)
    "`"))

(define (tc-borrow-check-help) : String
  "let the last reference use occur before this operation, shorten the borrow with a narrower lexical scope, clone the owner before borrowing when ownership must move later, or use an immutable borrow for non-mutating access")

(define (tc-borrow-check-origin-label [path : String]) : String
  (str_cat.str-cat
    "borrow of `"
    path
    "` remains live because a later reference use may still depend on it"))

(define (tc-borrow-check-conflict-origin-loop
  [map : hashmap.StringI64Map]
  [path : String]
  [index : i64]) : TcBorrowConflictOrigin
  (if (>= index (hashmap.string-i64-map-capacity map))
    TcNoBorrowConflictOrigin
    (match (hashmap.string-i64-map-entry-at map index)
      [(hashmap.StringI64MapEntrySome key value)
        (if (tc-moved-path-key-conflicts? key path)
          (TcSomeBorrowConflictOrigin value)
          (tc-borrow-check-conflict-origin-loop
            map
            path
            (hashmap.string-i64-map-next-occupied map (+ index 1))))]
      [(hashmap.StringI64MapEntryNone)
        (tc-borrow-check-conflict-origin-loop
          map
          path
          (hashmap.string-i64-map-next-occupied map (+ index 1)))])))

(define (tc-borrow-check-conflict-origin
  [borrowed : TcMovedSet]
  [path : String]) : TcBorrowConflictOrigin
  (tc-borrow-check-conflict-origin-loop
    (tc-moved-map borrowed)
    path
    (hashmap.string-i64-map-next-occupied (tc-moved-map borrowed) 0)))

(define (tc-borrow-check-rich-conflict-message
  [borrowed : TcMovedSet]
  [conflict-path : String]
  [display-path : String]
  [primary : AstExpr]
  [message : String]) : String
  (match (tc-expr-maybe-span primary)
    [(TcSomeAstSourceSpan primary-span)
      (match (tc-borrow-check-conflict-origin borrowed conflict-path)
        [(TcSomeBorrowConflictOrigin origin-id)
          (match (tc-expr-maybe-span (ast-node-get origin-id))
            [(TcSomeAstSourceSpan origin-span)
              (tc-rich-error-one-secondary
                primary-span
                message
                (tc-borrow-check-help)
                origin-span
                (tc-borrow-check-origin-label display-path))]
            [(TcNoAstSourceSpan)
              (tc-rich-error-one-secondary
                primary-span
                message
                (tc-borrow-check-help)
                primary-span
                (tc-borrow-check-origin-label display-path))])]
        [(TcNoBorrowConflictOrigin)
          (tc-rich-error-one-secondary
            primary-span
            message
            (tc-borrow-check-help)
            primary-span
            (tc-borrow-check-origin-label display-path))])]
    [(TcNoAstSourceSpan)
      (match (tc-borrow-check-conflict-origin borrowed conflict-path)
        [(TcSomeBorrowConflictOrigin origin-id)
          (match (tc-expr-maybe-span (ast-node-get origin-id))
            [(TcSomeAstSourceSpan origin-span)
              (tc-rich-error-one-secondary
                origin-span
                message
                (tc-borrow-check-help)
                origin-span
                (tc-borrow-check-origin-label display-path))]
            [(TcNoAstSourceSpan) message])]
        [(TcNoBorrowConflictOrigin) message])]))

(define (tc-borrow-check-mut-path [path : String]) : String
  (string.string-append "#mut." path))

(define (tc-borrow-check-two-phase-mut-prefix) : String
  "#two-phase-mut.")

(define (tc-borrow-check-two-phase-mut-path [path : String]) : String
  (string.string-append (tc-borrow-check-two-phase-mut-prefix) path))

(define (tc-borrow-check-two-phase-mut-path? [path : String]) : bool
  (tc-move-string-prefix? path (tc-borrow-check-two-phase-mut-prefix)))

(define (tc-borrow-check-two-phase-mut-original-path [path : String]) : String
  (let
    [prefix : String (tc-borrow-check-two-phase-mut-prefix)]
    [prefix-len : i64 (string.string-length prefix)]
    [path-len : i64 (string.string-length path)]
    (string.substring path prefix-len (- path-len prefix-len))))

(define (tc-borrow-check-remove-root-state
  [borrowed : TcMovedSet]
  [name : String]) : TcMovedSet
  (tc-moved-remove-root-state
    (tc-moved-remove-root-state
      (tc-moved-remove-root-state borrowed name)
      (tc-borrow-check-mut-path name))
    (tc-borrow-check-two-phase-mut-path name)))

(define (tc-borrow-check-remove-borrow-path
  [borrowed : TcMovedSet]
  [path : String]) : TcMovedSet
  (tc-moved-remove
    (tc-moved-remove
      (tc-moved-remove borrowed (tc-moved-path-key path))
      (tc-moved-path-key (tc-borrow-check-mut-path path)))
    (tc-moved-path-key (tc-borrow-check-two-phase-mut-path path))))

(define (tc-borrow-check-two-phase-mut-conflict
  [borrowed : TcMovedSet]
  [path : String]) : TcMoveConflict
  (tc-moved-path-conflict borrowed (tc-borrow-check-two-phase-mut-path path)))

(define (tc-borrow-check-two-phase-mut-conflict-message
  [borrowed : TcMovedSet]
  [path : String]
  [primary : AstExpr]
  [message : String]) : String
  (tc-borrow-check-rich-conflict-message
    borrowed
    (tc-borrow-check-two-phase-mut-path path)
    path
    primary
    message))

(define (tc-borrow-check-path-root-end [path : String] [index : i64] [n : i64]) : i64
  (if (>= index n)
    n
    (if (string.char-eq (string.string-ref path index) '.')
      index
      (tc-borrow-check-path-root-end path (+ index 1) n))))

(define (tc-borrow-check-path-root [path : String]) : String
  (let
    [n : i64 (string.string-length path)]
    [end : i64 (tc-borrow-check-path-root-end path 0 n)]
    (string.substring path 0 end)))

(define (tc-borrow-check-path-lifetime
  [ctx : TcContext]
  [env : TcTypeEnv]
  [path : String]) : String
  (let
    [root : String (tc-borrow-check-path-root path)]
    (match (tc-lookup env root)
      [(OkTcType ty)
        (let
          [resolved : AstType (tc-resolve-type ctx ty)]
          (match (tc-type-strip-region resolved)
            [(AstTyRef lifetime _) lifetime]
            [(AstTyMutRef lifetime _) lifetime]
            [_
              (match (tc-type-outer-region resolved)
                [(TcSomeString region) region]
                [(TcNoString) root])]))]
      [(ErrTcType _) root])))

(define (tc-borrow-check-type-contains-lifetime?
  [ctx : TcContext]
  [ty : AstType]
  [lifetime : String]) : bool
  (tc-string-list-contains
    (tc-type-collect-reference-lifetimes (tc-resolve-type ctx ty))
    lifetime))

(define (tc-borrow-check-binding-stores-lifetime?
  [ctx : TcContext]
  [ty : AstType]
  [lifetime : String]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstTyFunc _ ret)
      (tc-borrow-check-type-contains-lifetime? ctx (ty-node-get ret) lifetime)]
    [_ (tc-borrow-check-type-contains-lifetime? ctx ty lifetime)]))

(define (tc-borrow-check-env-lifetime-used-in-exprs?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [lifetime : String]
  [seen : TcStringList]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache _ _ _ _ _ _ _ rest _)
      (tc-borrow-check-env-lifetime-used-in-exprs?
        ctx
        (box-get rest)
        exprs
        lifetime
        seen)]
    [(TcTypeBind name-id ty rest)
      (let
        [name : String (intern-str name-id)]
        [rest-env : TcTypeEnv (box-get rest)]
        (if (tc-string-list-contains seen name)
          (tc-borrow-check-env-lifetime-used-in-exprs?
            ctx
            rest-env
            exprs
            lifetime
            seen)
          (if (and
            (tc-borrow-check-binding-stores-lifetime? ctx ty lifetime)
            (tc-expr-list-uses-free-name? exprs name TcStringNil))
            true
            (tc-borrow-check-env-lifetime-used-in-exprs?
              ctx
              rest-env
              exprs
              lifetime
              (tc-string-list-add seen name)))))]))

(define (tc-borrow-check-lifetime-used-in-exprs?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [lifetime : String]) : bool
  (tc-borrow-check-env-lifetime-used-in-exprs?
    ctx
    env
    exprs
    lifetime
    TcStringNil))

(define (tc-borrow-check-mut-path? [path : String]) : bool
  (tc-move-string-prefix? path "#mut."))

(define (tc-borrow-check-protected-path?
  [protected : TcMovedSet]
  [path : String]) : bool
  (or
    (tc-moved-path-conflict? protected path)
    (tc-moved-path-conflict? protected (tc-borrow-check-mut-path path))))

(define (tc-borrow-check-prune-before-exprs-loop
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [protected : TcMovedSet]
  [map : hashmap.StringI64Map]
  [index : i64]
  [out : TcMovedSet]) : TcMovedSet
  (if (>= index (hashmap.string-i64-map-capacity map))
    out
    (match (hashmap.string-i64-map-entry-at map index)
      [(hashmap.StringI64MapEntrySome key _)
        (let
          [next : i64 (hashmap.string-i64-map-next-occupied map (+ index 1))]
          [out2 : TcMovedSet
            (if (tc-moved-path-key? key)
              (let
                [path : String (tc-moved-conflict-display-path key)]
                (if (or
                  (tc-borrow-check-mut-path? path)
                  (tc-borrow-check-protected-path? protected path))
                  out
                  (let
                    [lifetime : String
                      (tc-borrow-check-path-lifetime ctx env path)]
                    (if (tc-borrow-check-lifetime-used-in-exprs?
                      ctx
                      env
                      exprs
                      lifetime)
                      out
                      (tc-borrow-check-remove-borrow-path out path)))))
              out)]
          (tc-borrow-check-prune-before-exprs-loop
            ctx
            env
            exprs
            protected
            map
            next
            out2))]
      [(hashmap.StringI64MapEntryNone)
        (tc-borrow-check-prune-before-exprs-loop
          ctx
          env
          exprs
          protected
          map
          (hashmap.string-i64-map-next-occupied map (+ index 1))
          out)])))

(define (tc-borrow-check-prune-before-exprs
  [ctx : TcContext]
  [env : TcTypeEnv]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : AstExprList]) : TcMovedSet
  (match exprs
    [(AstExprNil) borrowed]
    [_
      (if (= (tc-moved-len borrowed) 0)
        borrowed
        (let
          [map : hashmap.StringI64Map (tc-moved-map borrowed)]
          (tc-borrow-check-prune-before-exprs-loop
            ctx
            env
            exprs
            protected
            map
            (hashmap.string-i64-map-next-occupied map 0)
            borrowed)))]))

(define (tc-borrow-check-local-place-path
  [locals : TcMovedSet]
  [expr : AstExpr]) : TcMaybeString
  (match (tc-move-root-projection-var expr)
    [(TcSomeString root)
      (if (tc-moved-contains? locals root)
        (match (tc-move-direct-root-base-path expr)
          [(TcSomeString path) (TcSomeString path)]
          [(TcNoString) (TcSomeString root)])
        (TcNoString))]
    [(TcNoString) (TcNoString)]))

(define (tc-borrow-check-add-borrow-path
  [borrowed : TcMovedSet]
  [path : String]
  [mutable : bool]
  [origin : AstExpr]) : TcMovedSet
  (let
    [origin-id : i64 (ast-node-push origin)]
    [borrowed1 : TcMovedSet
      (tc-moved-add-value borrowed (tc-moved-path-key path) origin-id)]
    (if mutable
      (tc-moved-add-value
        borrowed1
        (tc-moved-path-key (tc-borrow-check-mut-path path))
        origin-id)
      borrowed1)))

(define (tc-borrow-check-add-two-phase-mut-borrow-path
  [borrowed : TcMovedSet]
  [path : String]
  [origin : AstExpr]) : TcMovedSet
  (tc-moved-add-value
    borrowed
    (tc-moved-path-key (tc-borrow-check-two-phase-mut-path path))
    (ast-node-push origin)))

(define (tc-borrow-check-add-two-phase-mut-place
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [place : AstExpr]
  [origin : AstExpr]) : TcBorrowCheckResult
  (match (tc-borrow-check-local-place-path locals place)
    [(TcSomeString path)
      (match (tc-borrow-check-mutably-borrow-conflict borrowed path origin)
        [(OkTcUnit)
          (OkTcBorrowCheck
            (tc-borrow-check-add-two-phase-mut-borrow-path borrowed path origin))]
        [(ErrTcUnit message) (ErrTcBorrowCheck message)])]
    [(TcNoString) (OkTcBorrowCheck borrowed)]))

(define (tc-borrow-check-move-conflict
  [borrowed : TcMovedSet]
  [path : String]
  [primary : AstExpr]) : ResultTcUnit
  (if (tc-moved-path-conflict? borrowed path)
    (ErrTcUnit
      (tc-borrow-check-rich-conflict-message
        borrowed
        path
        path
        primary
        (tc-borrow-check-move-message path)))
    (match (tc-borrow-check-two-phase-mut-conflict borrowed path)
      [(TcSomeMoveConflict _ _)
        (ErrTcUnit
          (tc-borrow-check-two-phase-mut-conflict-message
            borrowed
            path
            primary
            (tc-borrow-check-move-message path)))]
      [TcNoMoveConflict OkTcUnit])))

(define (tc-borrow-check-assign-conflict
  [borrowed : TcMovedSet]
  [path : String]
  [primary : AstExpr]) : ResultTcUnit
  (if (tc-moved-path-conflict? borrowed path)
    (ErrTcUnit
      (tc-borrow-check-rich-conflict-message
        borrowed
        path
        path
        primary
        (tc-borrow-check-assign-message path)))
    (match (tc-borrow-check-two-phase-mut-conflict borrowed path)
      [(TcSomeMoveConflict _ _)
        (ErrTcUnit
          (tc-borrow-check-two-phase-mut-conflict-message
            borrowed
            path
            primary
            (tc-borrow-check-assign-message path)))]
      [TcNoMoveConflict OkTcUnit])))

(define (tc-borrow-check-mutably-borrow-conflict
  [borrowed : TcMovedSet]
  [path : String]
  [primary : AstExpr]) : ResultTcUnit
  (if (tc-moved-path-conflict? borrowed path)
    (ErrTcUnit
      (tc-borrow-check-rich-conflict-message
        borrowed
        path
        path
        primary
        (tc-borrow-check-mutably-borrow-message path)))
    (match (tc-borrow-check-two-phase-mut-conflict borrowed path)
      [(TcSomeMoveConflict _ _)
        (ErrTcUnit
          (tc-borrow-check-two-phase-mut-conflict-message
            borrowed
            path
            primary
            (tc-borrow-check-mutably-borrow-message path)))]
      [TcNoMoveConflict OkTcUnit])))

(define (tc-borrow-check-immutably-borrow-conflict
  [borrowed : TcMovedSet]
  [path : String]
  [primary : AstExpr]) : ResultTcUnit
  (if (tc-moved-path-conflict? borrowed (tc-borrow-check-mut-path path))
    (ErrTcUnit
      (tc-borrow-check-rich-conflict-message
        borrowed
        (tc-borrow-check-mut-path path)
        path
        primary
        (tc-borrow-check-immutably-borrow-message path)))
    OkTcUnit))

(define (tc-borrow-check-read-conflict
  [borrowed : TcMovedSet]
  [path : String]
  [primary : AstExpr]) : ResultTcUnit
  (if (tc-moved-path-conflict? borrowed (tc-borrow-check-mut-path path))
    (ErrTcUnit
      (tc-borrow-check-rich-conflict-message
        borrowed
        (tc-borrow-check-mut-path path)
        path
        primary
        (tc-borrow-check-read-message path)))
    OkTcUnit))

(define (tc-borrow-check-place-read-conflict
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : AstExpr]
  [primary : AstExpr]) : TcBorrowCheckResult
  (if (= (tc-moved-len borrowed) 0)
    (OkTcBorrowCheck borrowed)
    (match (tc-borrow-check-local-place-path locals expr)
      [(TcSomeString path)
        (match (tc-borrow-check-read-conflict borrowed path primary)
          [(OkTcUnit) (OkTcBorrowCheck borrowed)]
          [(ErrTcUnit message) (ErrTcBorrowCheck message)])]
      [(TcNoString) (OkTcBorrowCheck borrowed)])))

(define (tc-borrow-check-add-place-with-mutability
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [mutable : bool]
  [place : AstExpr]
  [origin : AstExpr]) : TcBorrowCheckResult
  (match (tc-borrow-check-local-place-path locals place)
    [(TcSomeString path)
      (if mutable
        (match (tc-borrow-check-mutably-borrow-conflict borrowed path origin)
          [(OkTcUnit)
            (OkTcBorrowCheck
              (tc-borrow-check-add-borrow-path borrowed path true origin))]
          [(ErrTcUnit message) (ErrTcBorrowCheck message)])
        (match (tc-borrow-check-immutably-borrow-conflict borrowed path origin)
          [(OkTcUnit)
            (OkTcBorrowCheck
              (tc-borrow-check-add-borrow-path borrowed path false origin))]
          [(ErrTcUnit message) (ErrTcBorrowCheck message)]))]
    [(TcNoString) (OkTcBorrowCheck borrowed)]))

(define (tc-borrow-check-after-consuming-place
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : AstExpr]) : TcBorrowCheckResult
  (match (tc-borrow-check-local-place-path locals expr)
    [(TcSomeString path)
      (match (tc-borrow-check-move-conflict borrowed path expr)
        [(OkTcUnit) (OkTcBorrowCheck borrowed)]
        [(ErrTcUnit message) (ErrTcBorrowCheck message)])]
    [(TcNoString) (OkTcBorrowCheck borrowed)]))

(define (tc-borrow-check-after-consuming-value
  [ctx : TcContext]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : AstExpr]
  [target-ty : AstType]) : TcBorrowCheckResult
  (if (tc-type-consuming-by-value-now? ctx target-ty)
    (tc-borrow-check-after-consuming-place locals borrowed expr)
    (OkTcBorrowCheck borrowed)))

(define (tc-borrow-check-after-move-only-value
  [ctx : TcContext]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : AstExpr]
  [target-ty : AstType]) : TcBorrowCheckResult
  (if (tc-type-move-only? (tc-resolve-type ctx target-ty))
    (tc-borrow-check-after-consuming-place locals borrowed expr)
    (OkTcBorrowCheck borrowed)))

(define (tc-borrow-check-after-reading-value
  [ctx : TcContext]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : AstExpr]
  [target-ty : AstType]) : TcBorrowCheckResult
  (if (tc-type-consuming-by-value-now? ctx target-ty)
    (OkTcBorrowCheck borrowed)
    (tc-borrow-check-place-read-conflict locals borrowed expr expr)))

(define (tc-borrow-check-after-bind
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [init : AstExpr]) : TcBorrowCheckResult
  (match (tc-move-bare-var init)
    [(TcSomeString name)
      (if (and
        (tc-moved-contains? locals name)
        (tc-move-var-move-only? env name))
        (match (tc-borrow-check-move-conflict borrowed name init)
          [(OkTcUnit) (OkTcBorrowCheck borrowed)]
          [(ErrTcUnit message) (ErrTcBorrowCheck message)])
        (OkTcBorrowCheck borrowed))]
    [(TcNoString)
      (match (cfg
        compile-profile
        (compiler-tc-reinfer-profile-expr "borrow.bind_init" ctx env init)
        (tc-expr ctx env init))
        [(OkTcType init-ty)
          (if (tc-type-consuming-by-value-now? ctx init-ty)
            (tc-borrow-check-after-consuming-place locals borrowed init)
            (OkTcBorrowCheck borrowed))]
        [(ErrTcType _) (OkTcBorrowCheck borrowed)])]))

(define (tc-borrow-check-assignment
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [name : String]
  [primary : AstExpr]) : ResultTcUnit
  (if (tc-moved-contains? locals name)
    (tc-borrow-check-assign-conflict borrowed name primary)
    OkTcUnit))

(define (tc-borrow-check-array-set-conflict
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [array : AstExpr]
  [index : AstExpr]
  [primary : AstExpr]) : ResultTcUnit
  (match (tc-move-root-projection-var array)
    [(TcSomeString root)
      (if (tc-moved-contains? locals root)
        (match (tc-move-array-set-path array index)
          [(TcSomeString path)
            (tc-borrow-check-assign-conflict borrowed path primary)]
          [(TcNoString) (tc-borrow-check-assign-conflict borrowed root primary)])
        OkTcUnit)]
    [(TcNoString) OkTcUnit]))

(define (tc-borrow-check-struct-set-conflict
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [receiver : AstExpr]
  [field : String]
  [primary : AstExpr]) : ResultTcUnit
  (match (tc-move-root-projection-var receiver)
    [(TcSomeString root)
      (if (tc-moved-contains? locals root)
        (match (tc-move-struct-set-path receiver field)
          [(TcSomeString path)
            (tc-borrow-check-assign-conflict borrowed path primary)]
          [(TcNoString) (tc-borrow-check-assign-conflict borrowed root primary)])
        OkTcUnit)]
    [(TcNoString) OkTcUnit]))

(define (tc-borrow-check-root-mutation-conflict
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [place : AstExpr]
  [primary : AstExpr]) : ResultTcUnit
  (match (tc-move-root-projection-var place)
    [(TcSomeString root)
      (if (tc-moved-contains? locals root)
        (tc-borrow-check-assign-conflict borrowed root primary)
        OkTcUnit)]
    [(TcNoString) OkTcUnit]))

(define (tc-string-has-suffix-at?
  [text : String]
  [suffix : String]
  [base : i64]
  [index : i64]
  [n : i64]) : bool
  (if (>= index n)
    true
    (if (=
      (cast (string.string-ref text (+ base index)) : i64)
      (cast (string.string-ref suffix index) : i64))
      (tc-string-has-suffix-at? text suffix base (+ index 1) n)
      false)))

(define (tc-string-has-suffix? [text : String] [suffix : String]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [suffix-len : i64 (string.string-length suffix)]
    (if (< text-len suffix-len)
      false
      (tc-string-has-suffix-at?
        text
        suffix
        (- text-len suffix-len)
        0
        suffix-len))))

(define (tc-hashmap-mutating-call-name? [name : String]) : bool
  (cond
    [(tc-string-has-suffix? name "-map-insert") true]
    [(tc-string-has-suffix? name "-map-put") true]
    [(tc-string-has-suffix? name "-map-remove") true]
    [(tc-string-has-suffix? name "-map-remove-borrowed") true]
    [(tc-string-has-suffix? name "-map-update-if-present") true]
    [(tc-string-has-suffix? name "-map-update-borrowed-if-present") true]
    [(tc-string-has-suffix? name "-map-insert-or-update") true]
    [(tc-string-has-suffix? name "-map-entry-or-insert") true]
    [(tc-string-has-suffix? name "-map-resized") true]
    [(tc-string-has-suffix? name "-map-grow") true]
    [else false]))

(define (tc-borrow-check-first-call-arg-root-mutation
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : AstExprList]) : TcBorrowCheckResult
  (match args
    [(AstExprCons arg _)
      (let
        [arg : AstExpr (ast-node-get arg)]
        (match (tc-borrow-check-root-mutation-conflict locals borrowed arg arg)
          [(OkTcUnit) (OkTcBorrowCheck borrowed)]
          [(ErrTcUnit message) (ErrTcBorrowCheck message)]))]
    [(AstExprNil) (OkTcBorrowCheck borrowed)]))

(define (tc-borrow-check-after-call-effects
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : AstExpr]
  [func : AstExpr]
  [args : AstExprList]) : TcBorrowCheckResult
  (match (tc-expr-var-name func)
    [(TcSomeString name)
      (if (tc-hashmap-mutating-call-name? name)
        (match (tc-borrow-check-first-call-arg-root-mutation
          locals
          borrowed
          args)
          [(OkTcBorrowCheck _)
            (tc-borrow-check-after-returning-call
              ctx
              env
              locals
              borrowed
              call-expr
              args)]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])
        (tc-borrow-check-after-returning-call
          ctx
          env
          locals
          borrowed
          call-expr
          args))]
    [(TcNoString)
      (tc-borrow-check-after-returning-call
        ctx
        env
        locals
        borrowed
        call-expr
        args)]))

(define (tc-borrow-check-add-names [locals : TcMovedSet] [names : TcStringList]) : TcMovedSet
  (match names
    [(TcStringNil) locals]
    [(TcStringCons name rest)
      (tc-borrow-check-add-names (tc-moved-add locals name) (box-get rest))]))

(define (tc-borrow-check-remove-root-states
  [borrowed : TcMovedSet]
  [names : TcStringList]) : TcMovedSet
  (match names
    [(TcStringNil) borrowed]
    [(TcStringCons name rest)
      (tc-borrow-check-remove-root-states
        (tc-borrow-check-remove-root-state borrowed name)
        (box-get rest))]))

(define (tc-borrow-check-pattern-bound-names
  [ctx : TcContext]
  [scrut-ty : AstType]
  [pattern : AstPattern]) : TcStringList
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-match-coverage-type ctx scrut-ty)))
    [(AstTyEnum _)
      (match pattern
        [(AstPatVariant _ patterns-box)
          (let
            [patterns : AstPatternList (box-get patterns-box)]
            (tc-pattern-list-add-bound-names patterns TcStringNil))]
        [_ TcStringNil])]
    [(AstTyEnumArgs _ _)
      (match pattern
        [(AstPatVariant _ patterns-box)
          (let
            [patterns : AstPatternList (box-get patterns-box)]
            (tc-pattern-list-add-bound-names patterns TcStringNil))]
        [_ TcStringNil])]
    [_ (tc-pattern-add-bound-names pattern TcStringNil)]))

(define (tc-borrow-check-pattern-locals
  [ctx : TcContext]
  [scrut-ty : AstType]
  [pattern : AstPattern]
  [locals : TcMovedSet]) : TcMovedSet
  (tc-borrow-check-add-names
    locals
    (tc-borrow-check-pattern-bound-names ctx scrut-ty pattern)))

(define (tc-borrow-check-effective-arg-with-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [arg : AstExpr]
  [ty : AstType]) : TcBorrowCheckResult
  (match (tc-borrow-check-expr ctx env locals borrowed arg)
    [(OkTcBorrowCheck borrowed1)
      (match (tc-borrow-check-after-consuming-value ctx locals borrowed1 arg ty)
        [(OkTcBorrowCheck borrowed2)
          (if (= (tc-moved-len borrowed2) 0)
            (OkTcBorrowCheck borrowed2)
            (tc-borrow-check-after-reading-value ctx locals borrowed2 arg ty))]
        [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
    [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))

(define (tc-borrow-check-arg-with-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [arg : AstExpr]
  [ty : AstType]) : TcBorrowCheckResult
  (match (cfg
    compile-profile
    (compiler-tc-reinfer-profile-effective-arg-expr
      "borrow.call_arg"
      ctx
      env
      arg
      ty)
    (tc-call-effective-arg-expr ctx env arg ty))
    [(OkTcExpr effective)
      (tc-borrow-check-effective-arg-with-type
        ctx
        env
        locals
        borrowed
        effective
        ty)]
    [(ErrTcExpr message)
      (ErrTcBorrowCheck (tc-locate-error-at-expr arg message))]))

(define (tc-borrow-check-exprs-with-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : AstExprList]
  [types : AstTypeList]) : TcBorrowCheckResult
  (match exprs
    [(AstExprNil)
      (match types
        [(AstTypeNil) (OkTcBorrowCheck borrowed)]
        [_ (ErrTcBorrowCheck "typecheck: arity mismatch")])]
    [(AstExprCons head rest)
      (let
        [head-expr : AstExpr (ast-node-get head)]
        [rest : AstExprList (box-get rest)]
        (match types
          [(AstTypeCons ty rest-types)
            (let
              [ty : AstType (ty-node-get ty)]
              [rest-types : AstTypeList (box-get rest-types)]
              (match (tc-borrow-check-arg-with-type
                ctx
                env
                locals
                borrowed
                head-expr
                ty)
                [(OkTcBorrowCheck borrowed1)
                  (tc-borrow-check-exprs-with-types
                    ctx
                    env
                    locals
                    borrowed1
                    rest
                    rest-types)]
                [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
          [(AstTypeNil) (ErrTcBorrowCheck "typecheck: arity mismatch")]))]))

(define (tc-borrow-check-activate-two-phase-mut-borrows-loop
  [borrowed : TcMovedSet]
  [map : hashmap.StringI64Map]
  [index : i64]
  [primary : AstExpr]) : TcBorrowCheckResult
  (if (>= index (hashmap.string-i64-map-capacity map))
    (OkTcBorrowCheck borrowed)
    (match (hashmap.string-i64-map-entry-at map index)
      [(hashmap.StringI64MapEntrySome key _)
        (let
          [next : i64 (hashmap.string-i64-map-next-occupied map (+ index 1))]
          (if (tc-moved-path-key? key)
            (let
              [path : String (tc-moved-conflict-display-path key)]
              (if (tc-borrow-check-two-phase-mut-path? path)
                (let
                  [display-path : String
                    (tc-borrow-check-two-phase-mut-original-path path)]
                  (match (tc-moved-path-conflict borrowed display-path)
                    [(TcSomeMoveConflict _ _)
                      (ErrTcBorrowCheck
                        (tc-borrow-check-rich-conflict-message
                          borrowed
                          display-path
                          display-path
                          primary
                          (tc-borrow-check-mutably-borrow-message display-path)))]
                    [TcNoMoveConflict
                      (tc-borrow-check-activate-two-phase-mut-borrows-loop
                        borrowed
                        map
                        next
                        primary)]))
                (tc-borrow-check-activate-two-phase-mut-borrows-loop
                  borrowed
                  map
                  next
                  primary)))
            (tc-borrow-check-activate-two-phase-mut-borrows-loop
              borrowed
              map
              next
              primary)))]
      [(hashmap.StringI64MapEntryNone)
        (tc-borrow-check-activate-two-phase-mut-borrows-loop
          borrowed
          map
          (hashmap.string-i64-map-next-occupied map (+ index 1))
          primary)])))

(define (tc-borrow-check-activate-two-phase-mut-borrows
  [borrowed : TcMovedSet]
  [primary : AstExpr]) : TcBorrowCheckResult
  (tc-borrow-check-activate-two-phase-mut-borrows-loop
    borrowed
    (tc-moved-map borrowed)
    (hashmap.string-i64-map-next-occupied (tc-moved-map borrowed) 0)
    primary))

(define (tc-borrow-check-reserve-two-phase-mut-call-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [borrow-expr : AstExpr]
  [place : AstExpr]) : TcBorrowCheckResult
  (match (tc-borrow-check-place-read-conflict locals borrowed place borrow-expr)
    [(OkTcBorrowCheck borrowed0)
      (match (tc-borrow-check-expr ctx env locals borrowed0 place)
        [(OkTcBorrowCheck borrowed1)
          (match (tc-borrow-place ctx env place)
            [(OkTcBorrowPlace _)
              (tc-borrow-check-add-two-phase-mut-place
                locals
                borrowed1
                place
                borrow-expr)]
            [(ErrTcBorrowPlace message) (ErrTcBorrowCheck message)])]
        [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
    [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))

(define (tc-borrow-check-call-args-two-phase-with-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [reserved : bool]
  [call-expr : AstExpr]
  [exprs : AstExprList]
  [types : AstTypeList]) : TcBorrowCheckResult
  (match exprs
    [(AstExprNil)
      (match types
        [(AstTypeNil)
          (if reserved
            (tc-borrow-check-activate-two-phase-mut-borrows borrowed call-expr)
            (OkTcBorrowCheck borrowed))]
        [_ (ErrTcBorrowCheck "typecheck: arity mismatch")])]
    [(AstExprCons head rest)
      (let
        [head-expr : AstExpr (ast-node-get head)]
        [rest : AstExprList (box-get rest)]
        (match types
          [(AstTypeCons ty rest-types)
            (let
              [ty : AstType (ty-node-get ty)]
              [rest-types : AstTypeList (box-get rest-types)]
              (match (cfg
                compile-profile
                (compiler-tc-reinfer-profile-effective-arg-expr
                  "borrow.call_arg"
                  ctx
                  env
                  head-expr
                  ty)
                (tc-call-effective-arg-expr ctx env head-expr ty))
                [(OkTcExpr effective-head)
                  (match (ast-expr-unspan effective-head)
                    [(AstExprBorrow mutable _ place-box)
                      (if (and mutable (tc-call-mutable-ref-formal? ctx ty))
                        (let
                          [place : AstExpr (ast-node-get place-box)]
                          (match (tc-borrow-check-reserve-two-phase-mut-call-arg
                            ctx
                            env
                            locals
                            borrowed
                            effective-head
                            place)
                            [(OkTcBorrowCheck borrowed1)
                              (tc-borrow-check-call-args-two-phase-with-types
                                ctx
                                env
                                locals
                                borrowed1
                                true
                                call-expr
                                rest
                                rest-types)]
                            [(ErrTcBorrowCheck message)
                              (ErrTcBorrowCheck message)]))
                        (match (tc-borrow-check-effective-arg-with-type
                          ctx
                          env
                          locals
                          borrowed
                          effective-head
                          ty)
                          [(OkTcBorrowCheck borrowed1)
                            (tc-borrow-check-call-args-two-phase-with-types
                              ctx
                              env
                              locals
                              borrowed1
                              reserved
                              call-expr
                              rest
                              rest-types)]
                          [(ErrTcBorrowCheck message)
                            (ErrTcBorrowCheck message)]))]
                    [_
                      (match (tc-borrow-check-effective-arg-with-type
                        ctx
                        env
                        locals
                        borrowed
                        effective-head
                        ty)
                        [(OkTcBorrowCheck borrowed1)
                          (tc-borrow-check-call-args-two-phase-with-types
                            ctx
                            env
                            locals
                            borrowed1
                            reserved
                            call-expr
                            rest
                            rest-types)]
                        [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])])]
                [(ErrTcExpr message)
                  (ErrTcBorrowCheck (tc-locate-error-at-expr head-expr message))]))]
          [(AstTypeNil) (ErrTcBorrowCheck "typecheck: arity mismatch")]))]))

(define (tc-call-explicit-borrow-expr? [expr : AstExpr]) : bool
  (match (ast-expr-unspan expr)
    [(AstExprBorrow _ _ _) true]
    [_ false]))

(define (tc-borrow-check-add-call-arg-auto-borrow
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [arg : AstExpr]
  [ty : AstType]) : TcBorrowCheckResult
  (if (tc-call-explicit-borrow-expr? arg)
    (OkTcBorrowCheck borrowed)
    (match (cfg
      compile-profile
      (compiler-tc-reinfer-profile-effective-arg-expr
        "borrow.call_arg"
        ctx
        env
        arg
        ty)
      (tc-call-effective-arg-expr ctx env arg ty))
      [(OkTcExpr effective)
        (match (ast-expr-unspan effective)
          [(AstExprBorrow mutable _ place-box)
            (let
              [place : AstExpr (ast-node-get place-box)]
              (tc-borrow-check-add-place-with-mutability
                locals
                borrowed
                mutable
                place
                arg))]
          [_ (OkTcBorrowCheck borrowed)])]
      [(ErrTcExpr message)
        (ErrTcBorrowCheck (tc-locate-error-at-expr arg message))])))

(define (tc-borrow-check-auto-borrowed-call-args
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : AstExprList]
  [types : AstTypeList]) : TcBorrowCheckResult
  (match args
    [(AstExprNil)
      (match types
        [(AstTypeNil) (OkTcBorrowCheck borrowed)]
        [_ (ErrTcBorrowCheck "typecheck: arity mismatch")])]
    [(AstExprCons head rest)
      (let
        [head-expr : AstExpr (ast-node-get head)]
        [rest : AstExprList (box-get rest)]
        (match types
          [(AstTypeCons ty rest-types)
            (let
              [ty : AstType (ty-node-get ty)]
              [rest-types : AstTypeList (box-get rest-types)]
              (match (tc-borrow-check-add-call-arg-auto-borrow
                ctx
                env
                locals
                borrowed
                head-expr
                ty)
                [(OkTcBorrowCheck borrowed1)
                  (tc-borrow-check-auto-borrowed-call-args
                    ctx
                    env
                    locals
                    borrowed1
                    rest
                    rest-types)]
                [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
          [(AstTypeNil) (ErrTcBorrowCheck "typecheck: arity mismatch")]))]))

(define (tc-borrow-check-thread-channel-send-message
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]) : TcBorrowCheckResult
  (if (tc-thread-channel-send-call? ctx env func)
    (match (tc-thread-channel-send-call-name func)
      [(TcSomeString _)
        (match (tc-thread-channel-send-message-param params)
          [(OkTcType message-ty)
            (match (tc-thread-channel-send-message-arg args)
              [(OkTcExpr message-expr)
                (tc-borrow-check-after-move-only-value
                  ctx
                  locals
                  borrowed
                  message-expr
                  message-ty)]
              [(ErrTcExpr message) (ErrTcBorrowCheck message)])]
          [(ErrTcType message) (ErrTcBorrowCheck message)])]
      [(TcNoString) (OkTcBorrowCheck borrowed)])
    (OkTcBorrowCheck borrowed)))

(define (tc-borrow-check-string-helper-intrinsic-call?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]) : bool
  (match (ast-expr-unspan func)
    [(AstExprVar raw-name)
      (let
        [name : String (tc-hygiene-global-call-name (intern-str raw-name))]
        [name-id : i64 (tc-builtin-name-id name)]
        [lookup-id : i64 (tc-call-builtin-lookup-id ctx env name name-id)]
        (or
          (tc-string-length-helper-call-id? ctx env name-id lookup-id)
          (tc-string-ref-helper-call-id? ctx env name-id lookup-id)))]
    [_ false]))

(define (tc-borrow-check-call-args-with-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : AstExpr]
  [func : AstExpr]
  [args : AstExprList]
  [types : AstTypeList]) : TcBorrowCheckResult
  (if (tc-borrow-check-string-helper-intrinsic-call? ctx env func)
    (match (tc-borrow-check-read-exprs
      ctx
      env
      locals
      (tc-moved-clone borrowed)
      args)
      [(OkTcBorrowCheck _)
        (tc-borrow-check-after-call-effects
          ctx
          env
          locals
          borrowed
          call-expr
          func
          args)]
      [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])
    (let
      [validation-borrowed : TcMovedSet (tc-moved-clone borrowed)]
      [validation-result : TcBorrowCheckResult
        (tc-borrow-check-call-args-two-phase-with-types
          ctx
          env
          locals
          validation-borrowed
          false
          call-expr
          args
          types)]
      (match validation-result
        [(OkTcBorrowCheck _)
          (if (tc-call-type-list-has-immutable-ref-formal? ctx types)
            (match (tc-borrow-check-auto-borrowed-call-args
              ctx
              env
              locals
              borrowed
              args
              types)
              [(OkTcBorrowCheck borrowed2)
                (match (tc-borrow-check-thread-channel-send-message
                  ctx
                  env
                  locals
                  borrowed2
                  func
                  args
                  types)
                  [(OkTcBorrowCheck borrowed3)
                    (tc-borrow-check-after-call-effects
                      ctx
                      env
                      locals
                      borrowed3
                      call-expr
                      func
                      args)]
                  [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
              [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])
            (match (tc-borrow-check-thread-channel-send-message
              ctx
              env
              locals
              borrowed
              func
              args
              types)
              [(OkTcBorrowCheck borrowed2)
                (tc-borrow-check-after-call-effects
                  ctx
                  env
                  locals
                  borrowed2
                  call-expr
                  func
                  args)]
              [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
        [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))))

(define (tc-borrow-check-exprs-retry-after-prune
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : AstExprList]
  [head : AstExpr]
  [rest : AstExprList]
  [message : String]) : TcBorrowCheckResult
  (if (= (tc-moved-len borrowed) 0)
    (ErrTcBorrowCheck message)
    (let
      [borrowed0 : TcMovedSet
        (tc-borrow-check-prune-before-exprs ctx env borrowed protected exprs)]
      (if (= (tc-moved-len borrowed0) (tc-moved-len borrowed))
        (ErrTcBorrowCheck message)
        (match (tc-borrow-check-expr ctx env locals borrowed0 head)
          [(OkTcBorrowCheck borrowed1)
            (tc-borrow-check-exprs-with-protected
              ctx
              env
              locals
              borrowed1
              protected
              rest)]
          [(ErrTcBorrowCheck retry-message) (ErrTcBorrowCheck retry-message)])))))

(define (tc-borrow-check-exprs-with-protected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : AstExprList]) : TcBorrowCheckResult
  (match exprs
    [(AstExprNil) (OkTcBorrowCheck borrowed)]
    [(AstExprCons head rest)
      (let
        [head-expr : AstExpr (ast-node-get head)]
        [rest : AstExprList (box-get rest)]
        (match (tc-borrow-check-expr-id ctx env locals borrowed head)
          [(OkTcBorrowCheck borrowed1)
            (tc-borrow-check-exprs-with-protected
              ctx
              env
              locals
              borrowed1
              protected
              rest)]
          [(ErrTcBorrowCheck message)
            (tc-borrow-check-exprs-retry-after-prune
              ctx
              env
              locals
              borrowed
              protected
              exprs
              head-expr
              rest
              message)]))]))

(define (tc-borrow-check-exprs
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : AstExprList]) : TcBorrowCheckResult
  (tc-borrow-check-exprs-with-protected ctx env locals borrowed borrowed exprs))

(define (tc-borrow-check-expr-with-protected-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [expr-id : i64]) : TcBorrowCheckResult
  (tc-borrow-check-expr-with-protected
    ctx
    env
    locals
    borrowed
    protected
    (ast-node-get expr-id)))

(define (tc-borrow-check-expr-with-protected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [expr : AstExpr]) : TcBorrowCheckResult
  (match expr
    [(AstExprSpanned inner-box _)
      (tc-borrow-check-expr-with-protected-id
        ctx
        env
        locals
        borrowed
        protected
        inner-box)]
    [(AstExprBegin exprs)
      (tc-borrow-check-exprs-with-protected
        ctx
        env
        locals
        borrowed
        protected
        exprs)]
    [(AstExprUnsafe exprs)
      (tc-borrow-check-exprs-with-protected
        ctx
        env
        locals
        borrowed
        protected
        exprs)]
    [_ (tc-borrow-check-expr ctx env locals borrowed expr)]))

(define (tc-borrow-check-expr-type-contains-lifetime?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [lifetime : String]) : bool
  (match (tc-expr ctx env expr)
    [(OkTcType ty) (tc-borrow-check-type-contains-lifetime? ctx ty lifetime)]
    [(ErrTcType _) false]))

(define (tc-borrow-check-expr-list-stores-lifetime?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [lifetime : String]) : bool
  (match exprs
    [(AstExprNil) false]
    [(AstExprCons head rest)
      (if (tc-borrow-check-expr-stores-lifetime?
        ctx
        env
        (ast-node-get head)
        lifetime)
        true
        (tc-borrow-check-expr-list-stores-lifetime?
          ctx
          env
          (box-get rest)
          lifetime))]))

(define (tc-borrow-check-let-bindings-store-lifetime?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : AstLetBindingList]
  [lifetime : String]) : bool
  (match bindings
    [(AstLetBindingNil) false]
    [(AstLetBindingCons binding rest)
      (match binding
        [(AstLetBinding _ _ init-box)
          (if (tc-borrow-check-expr-stores-lifetime?
            ctx
            env
            (ast-node-get init-box)
            lifetime)
            true
            (tc-borrow-check-let-bindings-store-lifetime?
              ctx
              env
              (box-get rest)
              lifetime))])]))

(define (tc-borrow-check-match-arms-store-lifetime?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arms : AstMatchArmList]
  [lifetime : String]) : bool
  (match arms
    [(AstMatchArmNil) false]
    [(AstMatchArmCons arm rest)
      (match arm
        [(AstMatchArm _ body-box)
          (if (tc-borrow-check-expr-stores-lifetime?
            ctx
            env
            (ast-node-get body-box)
            lifetime)
            true
            (tc-borrow-check-match-arms-store-lifetime?
              ctx
              env
              (box-get rest)
              lifetime))])]))

(define (tc-borrow-check-expr-stores-lifetime?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [lifetime : String]) : bool
  (match expr
    [(AstExprSpanned inner-box _)
      (tc-borrow-check-expr-stores-lifetime?
        ctx
        env
        (ast-node-get inner-box)
        lifetime)]
    [(AstExprAnn inner-box _)
      (tc-borrow-check-expr-stores-lifetime?
        ctx
        env
        (ast-node-get inner-box)
        lifetime)]
    [(AstExprCast inner-box _)
      (tc-borrow-check-expr-stores-lifetime?
        ctx
        env
        (ast-node-get inner-box)
        lifetime)]
    [(AstExprBegin exprs)
      (tc-borrow-check-expr-list-stores-lifetime? ctx env exprs lifetime)]
    [(AstExprUnsafe exprs)
      (tc-borrow-check-expr-list-stores-lifetime? ctx env exprs lifetime)]
    [(AstExprIf cond-box then-box else-box)
      (or
        (tc-borrow-check-expr-stores-lifetime?
          ctx
          env
          (ast-node-get cond-box)
          lifetime)
        (tc-borrow-check-expr-stores-lifetime?
          ctx
          env
          (ast-node-get then-box)
          lifetime)
        (tc-borrow-check-expr-stores-lifetime?
          ctx
          env
          (ast-node-get else-box)
          lifetime))]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body-box)
          (or
            (tc-borrow-check-let-bindings-store-lifetime?
              ctx
              env
              bindings
              lifetime)
            (tc-borrow-check-expr-stores-lifetime?
              ctx
              env
              (ast-node-get body-box)
              lifetime))])]
    [(AstExprMatch match-box)
      (match (box-get match-box)
        [(AstMatch scrut-box arms)
          (or
            (tc-borrow-check-expr-stores-lifetime?
              ctx
              env
              (ast-node-get scrut-box)
              lifetime)
            (tc-borrow-check-match-arms-store-lifetime? ctx env arms lifetime))])]
    [(AstExprSet name rhs-box)
      (let
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-set-expr-id env name-text rhs-box)
            [(OkTcExprId virtual-id)
              (tc-borrow-check-expr-stores-lifetime?
                ctx
                env
                (ast-node-get virtual-id)
                lifetime)]
            [(ErrTcExprId _) false])
          (match (tc-lookup env name-text)
            [(OkTcType ty)
              (tc-borrow-check-type-contains-lifetime? ctx ty lifetime)]
            [(ErrTcType _) false])))]
    [(AstExprArraySet array-box _ _)
      (tc-borrow-check-expr-type-contains-lifetime?
        ctx
        env
        (ast-node-get array-box)
        lifetime)]
    [(AstExprArrayPush array-box _)
      (tc-borrow-check-expr-type-contains-lifetime?
        ctx
        env
        (ast-node-get array-box)
        lifetime)]
    [(AstExprStructSet receiver-box _ _)
      (tc-borrow-check-expr-type-contains-lifetime?
        ctx
        env
        (ast-node-get receiver-box)
        lifetime)]
    [(AstExprBoxSet box-box _)
      (tc-borrow-check-expr-type-contains-lifetime?
        ctx
        env
        (ast-node-get box-box)
        lifetime)]
    [_ false]))

(define (tc-borrow-check-loop-protect-carried-facts-loop
  [ctx : TcContext]
  [loop-env : TcTypeEnv]
  [before : TcMovedSet]
  [after-map : hashmap.StringI64Map]
  [index : i64]
  [out : TcMovedSet]) : TcMovedSet
  (if (>= index (hashmap.string-i64-map-capacity after-map))
    out
    (match (hashmap.string-i64-map-entry-at after-map index)
      [(hashmap.StringI64MapEntrySome key value)
        (let
          [next : i64
            (hashmap.string-i64-map-next-occupied after-map (+ index 1))]
          [out2 : TcMovedSet
            (if (or
              (not (tc-moved-path-key? key))
              (tc-moved-contains? before key)
              (tc-moved-contains? out key))
              out
              (tc-moved-add-value out key value))]
          (tc-borrow-check-loop-protect-carried-facts-loop
            ctx
            loop-env
            before
            after-map
            next
            out2))]
      [(hashmap.StringI64MapEntryNone)
        (tc-borrow-check-loop-protect-carried-facts-loop
          ctx
          loop-env
          before
          after-map
          (hashmap.string-i64-map-next-occupied after-map (+ index 1))
          out)])))

(define (tc-borrow-check-loop-protect-carried-facts
  [ctx : TcContext]
  [loop-env : TcTypeEnv]
  [before : TcMovedSet]
  [after : TcMovedSet]
  [protected : TcMovedSet]) : TcMovedSet
  (tc-borrow-check-loop-protect-carried-facts-loop
    ctx
    loop-env
    before
    (tc-moved-map after)
    (hashmap.string-i64-map-next-occupied (tc-moved-map after) 0)
    protected))

(define (tc-borrow-check-loop-protect-stored-facts-loop
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [map : hashmap.StringI64Map]
  [index : i64]
  [out : TcMovedSet]) : TcMovedSet
  (if (>= index (hashmap.string-i64-map-capacity map))
    out
    (match (hashmap.string-i64-map-entry-at map index)
      [(hashmap.StringI64MapEntrySome key value)
        (let
          [next : i64 (hashmap.string-i64-map-next-occupied map (+ index 1))]
          [out2 : TcMovedSet
            (if (or (not (tc-moved-path-key? key)) (tc-moved-contains? out key))
              out
              (let
                [path : String (tc-moved-conflict-display-path key)]
                [lifetime : String (tc-borrow-check-path-lifetime ctx env path)]
                (if (tc-borrow-check-expr-stores-lifetime?
                  ctx
                  env
                  expr
                  lifetime)
                  (tc-moved-add-value out key value)
                  out)))]
          (tc-borrow-check-loop-protect-stored-facts-loop
            ctx
            env
            expr
            map
            next
            out2))]
      [(hashmap.StringI64MapEntryNone)
        (tc-borrow-check-loop-protect-stored-facts-loop
          ctx
          env
          expr
          map
          (hashmap.string-i64-map-next-occupied map (+ index 1))
          out)])))

(define (tc-borrow-check-loop-protect-stored-facts
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]) : TcMovedSet
  (tc-borrow-check-loop-protect-stored-facts-loop
    ctx
    env
    expr
    (tc-moved-map borrowed)
    (hashmap.string-i64-map-next-occupied (tc-moved-map borrowed) 0)
    protected))

(define (tc-borrow-check-loop-visible-body-borrows
  [ctx : TcContext]
  [loop-env : TcTypeEnv]
  [entry : TcMovedSet]
  [body-borrowed : TcMovedSet]) : TcMovedSet
  (tc-moved-union
    (tc-borrow-check-loop-protect-carried-facts
      ctx
      loop-env
      entry
      body-borrowed
      (tc-moved-empty))
    entry))

(define (tc-borrow-check-exprs-loop-retry-after-prune
  [ctx : TcContext]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : AstExprList]
  [head : AstExpr]
  [rest : AstExprList]
  [message : String]) : TcBorrowCheckResult
  (if (= (tc-moved-len borrowed) 0)
    (ErrTcBorrowCheck message)
    (let
      [borrowed0 : TcMovedSet
        (tc-borrow-check-prune-before-exprs ctx env borrowed protected exprs)]
      (if (= (tc-moved-len borrowed0) (tc-moved-len borrowed))
        (ErrTcBorrowCheck message)
        (match (tc-borrow-check-expr-loop
          ctx
          env
          loop-env
          locals
          borrowed0
          protected
          head)
          [(OkTcBorrowCheck borrowed1)
            (let
              [protected1 : TcMovedSet
                (tc-borrow-check-loop-protect-stored-facts
                  ctx
                  env
                  head
                  borrowed1
                  (tc-borrow-check-loop-protect-carried-facts
                    ctx
                    loop-env
                    borrowed0
                    borrowed1
                    protected))]
              (tc-borrow-check-exprs-loop
                ctx
                env
                loop-env
                locals
                borrowed1
                protected1
                rest))]
          [(ErrTcBorrowCheck retry-message) (ErrTcBorrowCheck retry-message)])))))

(define (tc-borrow-check-exprs-loop
  [ctx : TcContext]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : AstExprList]) : TcBorrowCheckResult
  (match exprs
    [(AstExprNil) (OkTcBorrowCheck borrowed)]
    [(AstExprCons head rest)
      (let
        [head : AstExpr (ast-node-get head)]
        [rest : AstExprList (box-get rest)]
        (match (tc-borrow-check-expr-loop
          ctx
          env
          loop-env
          locals
          borrowed
          protected
          head)
          [(OkTcBorrowCheck borrowed1)
            (let
              [protected1 : TcMovedSet
                (tc-borrow-check-loop-protect-stored-facts
                  ctx
                  env
                  head
                  borrowed1
                  (tc-borrow-check-loop-protect-carried-facts
                    ctx
                    loop-env
                    borrowed
                    borrowed1
                    protected))]
              (tc-borrow-check-exprs-loop
                ctx
                env
                loop-env
                locals
                borrowed1
                protected1
                rest))]
          [(ErrTcBorrowCheck message)
            (tc-borrow-check-exprs-loop-retry-after-prune
              ctx
              env
              loop-env
              locals
              borrowed
              protected
              exprs
              head
              rest
              message)]))]))

(define (tc-borrow-check-arms-loop-join
  [ctx : TcContext]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [joined : TcMovedSet]) : TcBorrowCheckResult
  (match arms
    [(AstMatchArmNil) (OkTcBorrowCheck joined)]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm pattern body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (match (tc-bind-match-pattern ctx env scrut-ty pattern)
                [(OkTcEnv arm-env)
                  (match (tc-borrow-check-expr-loop
                    ctx
                    arm-env
                    loop-env
                    (tc-borrow-check-pattern-locals
                      ctx
                      scrut-ty
                      pattern
                      (tc-moved-clone locals))
                    (tc-moved-clone borrowed)
                    borrowed
                    body)
                    [(OkTcBorrowCheck arm-borrowed)
                      (let
                        [visible-arm-borrowed : TcMovedSet
                          (tc-borrow-check-remove-root-states
                            arm-borrowed
                            (tc-borrow-check-pattern-bound-names
                              ctx
                              scrut-ty
                              pattern))]
                        (tc-borrow-check-arms-loop-join
                          ctx
                          env
                          loop-env
                          locals
                          borrowed
                          scrut-ty
                          rest
                          (tc-moved-union joined visible-arm-borrowed)))]
                    [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
                [(ErrTcEnv message) (ErrTcBorrowCheck message)]))]))]))

(define (tc-borrow-check-arms-loop
  [ctx : TcContext]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : TcBorrowCheckResult
  (tc-borrow-check-arms-loop-join
    ctx
    env
    loop-env
    locals
    borrowed
    scrut-ty
    arms
    borrowed))

(define (tc-borrow-check-expr-loop
  [ctx : TcContext]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [expr : AstExpr]) : TcBorrowCheckResult
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr-loop
          ctx
          env
          loop-env
          locals
          borrowed
          protected
          inner))]
    [(AstExprBegin exprs)
      (tc-borrow-check-exprs-loop
        ctx
        env
        loop-env
        locals
        borrowed
        protected
        exprs)]
    [(AstExprUnsafe exprs)
      (tc-borrow-check-exprs-loop
        ctx
        env
        loop-env
        locals
        borrowed
        protected
        exprs)]
    [(AstExprIf cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed cond)
          [(OkTcBorrowCheck borrowedc)
            (match (tc-borrow-check-expr-loop
              ctx
              env
              loop-env
              (tc-moved-clone locals)
              (tc-moved-clone borrowedc)
              borrowedc
              then-branch)
              [(OkTcBorrowCheck borrowedt)
                (match (tc-borrow-check-expr-loop
                  ctx
                  env
                  loop-env
                  (tc-moved-clone locals)
                  (tc-moved-clone borrowedc)
                  borrowedc
                  else-branch)
                  [(OkTcBorrowCheck borrowede)
                    (OkTcBorrowCheck (tc-moved-union borrowedt borrowede))]
                  [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
              [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-borrow-check-let-bindings
              ctx
              env
              (tc-moved-clone locals)
              (tc-moved-clone borrowed)
              bindings)
              [(OkTcBorrowCheckBindings env2 locals2 borrowed2)
                (match (tc-borrow-check-expr-loop
                  ctx
                  env2
                  loop-env
                  locals2
                  borrowed2
                  borrowed
                  body)
                  [(OkTcBorrowCheck body-borrowed)
                    (OkTcBorrowCheck
                      (tc-borrow-check-loop-visible-body-borrows
                        ctx
                        loop-env
                        borrowed
                        body-borrowed))]
                  [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
              [(ErrTcBorrowCheckBindings message) (ErrTcBorrowCheck message)]))])]
    [(AstExprMatch match-box)
      (match (box-get match-box)
        [(AstMatch scrut-box arms)
          (let
            [scrut : AstExpr (ast-node-get scrut-box)]
            (match (tc-borrow-check-expr ctx env locals borrowed scrut)
              [(OkTcBorrowCheck borroweds)
                (match (cfg
                  compile-profile
                  (compiler-tc-reinfer-profile-expr
                    "borrow.match_scrutinee"
                    ctx
                    env
                    scrut)
                  (tc-expr ctx env scrut))
                  [(OkTcType scrut-ty)
                    (tc-borrow-check-arms-loop
                      ctx
                      env
                      loop-env
                      locals
                      borroweds
                      scrut-ty
                      arms)]
                  [(ErrTcType message) (ErrTcBorrowCheck message)])]
              [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))])]
    [_ (tc-borrow-check-expr ctx env locals borrowed expr)]))

(define (tc-borrow-check-read-exprs
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : AstExprList]) : TcBorrowCheckResult
  (match exprs
    [(AstExprNil) (OkTcBorrowCheck borrowed)]
    [(AstExprCons head rest)
      (let
        [head : AstExpr (ast-node-get head)]
        [rest : AstExprList (box-get rest)]
        (match (tc-borrow-check-expr ctx env locals borrowed head)
          [(OkTcBorrowCheck borrowed1)
            (if (= (tc-moved-len borrowed1) 0)
              (tc-borrow-check-read-exprs ctx env locals borrowed1 rest)
              (match (tc-borrow-check-place-read-conflict
                locals
                borrowed1
                head
                head)
                [(OkTcBorrowCheck borrowed2)
                  (tc-borrow-check-read-exprs ctx env locals borrowed2 rest)]
                [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]))

(define (tc-borrow-check-add-returned-call-arg-borrow
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [arg : AstExpr]
  [result-lifetimes : TcStringList]) : TcBorrowCheckResult
  (match (cfg
    compile-profile
    (compiler-tc-reinfer-profile-expr "borrow.return_arg" ctx env arg)
    (tc-expr ctx env arg))
    [(OkTcType arg-ty)
      (if (tc-string-list-overlaps?
        (tc-type-collect-reference-lifetimes (tc-resolve-type ctx arg-ty))
        result-lifetimes)
        (match (ast-expr-unspan arg)
          [(AstExprBorrow mutable _ place-box)
            (let
              [place : AstExpr (ast-node-get place-box)]
              (tc-borrow-check-add-place-with-mutability
                locals
                borrowed
                mutable
                place
                arg))]
          [(AstExprAnn inner-box _)
            (let
              [inner : AstExpr (ast-node-get inner-box)]
              (tc-borrow-check-add-returned-call-arg-borrow
                ctx
                env
                locals
                borrowed
                inner
                result-lifetimes))]
          [(AstExprCast inner-box _)
            (let
              [inner : AstExpr (ast-node-get inner-box)]
              (tc-borrow-check-add-returned-call-arg-borrow
                ctx
                env
                locals
                borrowed
                inner
                result-lifetimes))]
          [_ (OkTcBorrowCheck borrowed)])
        (OkTcBorrowCheck borrowed))]
    [(ErrTcType _) (OkTcBorrowCheck borrowed)]))

(define (tc-borrow-check-add-returned-call-borrows
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : AstExprList]
  [result-lifetimes : TcStringList]) : TcBorrowCheckResult
  (match args
    [(AstExprNil) (OkTcBorrowCheck borrowed)]
    [(AstExprCons arg rest)
      (let
        [arg : AstExpr (ast-node-get arg)]
        [rest : AstExprList (box-get rest)]
        (match (tc-borrow-check-add-returned-call-arg-borrow
          ctx
          env
          locals
          borrowed
          arg
          result-lifetimes)
          [(OkTcBorrowCheck borrowed1)
            (tc-borrow-check-add-returned-call-borrows
              ctx
              env
              locals
              borrowed1
              rest
              result-lifetimes)]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]))

(define (tc-borrow-check-after-returning-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : AstExpr]
  [args : AstExprList]) : TcBorrowCheckResult
  (match (cfg
    compile-profile
    (compiler-tc-reinfer-profile-expr "borrow.return_call" ctx env call-expr)
    (tc-expr ctx env call-expr))
    [(OkTcType result-ty)
      (let
        [result-lifetimes : TcStringList
          (tc-type-collect-reference-lifetimes (tc-resolve-type ctx result-ty))]
        (match result-lifetimes
          [(TcStringNil) (OkTcBorrowCheck borrowed)]
          [_
            (tc-borrow-check-add-returned-call-borrows
              ctx
              env
              locals
              borrowed
              args
              result-lifetimes)]))]
    [(ErrTcType _) (OkTcBorrowCheck borrowed)]))

(define (tc-borrow-check-let-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bindings : AstLetBindingList]) : TcBorrowCheckBindings
  (match bindings
    [(AstLetBindingNil) (OkTcBorrowCheckBindings env locals borrowed)]
    [(AstLetBindingCons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding name maybe-ty init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (match (tc-borrow-check-expr-id ctx env locals borrowed init-box)
                [(OkTcBorrowCheck borrowed1)
                  (match (tc-borrow-check-after-bind
                    ctx
                    env
                    locals
                    borrowed1
                    init)
                    [(OkTcBorrowCheck borrowed2)
                      (tc-borrow-check-let-bindings
                        ctx
                        (let
                          [binding-ty : AstType
                            (cfg
                              compile-profile
                              (compiler-tc-reinfer-profile-binding-type
                                "borrow.let_init"
                                ctx
                                env
                                maybe-ty
                                init)
                              (tc-move-binding-type ctx env maybe-ty init))]
                          (tc-bind-c-abi-fnptr-if-needed-id
                            ctx
                            env
                            name
                            binding-ty
                            init))
                        (tc-moved-add locals (intern-str name))
                        (tc-borrow-check-remove-root-state
                          borrowed2
                          (intern-str name))
                        rest)]
                    [(ErrTcBorrowCheck message)
                      (ErrTcBorrowCheckBindings message)])]
                [(ErrTcBorrowCheck message) (ErrTcBorrowCheckBindings message)]))]))]))

(define (tc-borrow-check-resource-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bindings : AstResourceBindingList]) : TcBorrowCheckResourceBindings
  (match bindings
    [(AstResourceBindingNil)
      (OkTcBorrowCheckResourceBindings env locals borrowed)]
    [(AstResourceBindingCons binding rest)
      (let
        [rest : AstResourceBindingList (box-get rest)]
        (match binding
          [(AstResourceBinding name init-box _)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (match (tc-borrow-check-expr-id ctx env locals borrowed init-box)
                [(OkTcBorrowCheck borrowed1)
                  (match (tc-borrow-check-after-bind
                    ctx
                    env
                    locals
                    borrowed1
                    init)
                    [(OkTcBorrowCheck borrowed2)
                      (match (cfg
                        compile-profile
                        (compiler-tc-reinfer-profile-expr
                          "borrow.resource_init"
                          ctx
                          env
                          init)
                        (tc-expr-id ctx env init-box))
                        [(OkTcType init-ty)
                          (tc-borrow-check-resource-bindings
                            ctx
                            (tc-bind-id
                              (tc-bind-cleanup-owner env (intern-str name))
                              name
                              (tc-type-without-regions init-ty))
                            (tc-moved-add locals (intern-str name))
                            (tc-borrow-check-remove-root-state
                              borrowed2
                              (intern-str name))
                            rest)]
                        [(ErrTcType message)
                          (ErrTcBorrowCheckResourceBindings message)])]
                    [(ErrTcBorrowCheck message)
                      (ErrTcBorrowCheckResourceBindings message)])]
                [(ErrTcBorrowCheck message)
                  (ErrTcBorrowCheckResourceBindings message)]))]))]))

(define (tc-borrow-check-arms-join
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [joined : TcMovedSet]) : TcBorrowCheckResult
  (match arms
    [(AstMatchArmNil) (OkTcBorrowCheck joined)]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm pattern body-box)
            (match (tc-bind-match-pattern ctx env scrut-ty pattern)
              [(OkTcEnv arm-env)
                (match (tc-borrow-check-expr-id
                  ctx
                  arm-env
                  (tc-borrow-check-pattern-locals
                    ctx
                    scrut-ty
                    pattern
                    (tc-moved-clone locals))
                  (tc-moved-clone borrowed)
                  body-box)
                  [(OkTcBorrowCheck arm-borrowed)
                    (let
                      [visible-arm-borrowed : TcMovedSet
                        (tc-borrow-check-remove-root-states
                          arm-borrowed
                          (tc-borrow-check-pattern-bound-names
                            ctx
                            scrut-ty
                            pattern))]
                      (tc-borrow-check-arms-join
                        ctx
                        env
                        locals
                        borrowed
                        scrut-ty
                        rest
                        (tc-moved-union joined visible-arm-borrowed)))]
                  [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
              [(ErrTcEnv message) (ErrTcBorrowCheck message)])]))]))

(define (tc-borrow-check-arms
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : TcBorrowCheckResult
  (tc-borrow-check-arms-join ctx env locals borrowed scrut-ty arms borrowed))

(define (tc-borrow-check-expr-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr-id : i64]) : TcBorrowCheckResult
  (tc-borrow-check-expr ctx env locals borrowed (ast-node-get expr-id)))

(define (tc-borrow-check-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : AstExpr]) : TcBorrowCheckResult
  (match expr
    [(AstExprSpanned inner-box _)
      (tc-borrow-check-expr-id ctx env locals borrowed inner-box)]
    [(AstExprLiteral _) (OkTcBorrowCheck borrowed)]
    [(AstExprVar name)
      (let
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-expr-id env name-text)
            [(OkTcExprId virtual-id)
              (tc-borrow-check-expr-id ctx env locals borrowed virtual-id)]
            [(ErrTcExprId message) (ErrTcBorrowCheck message)])
          (OkTcBorrowCheck borrowed)))]
    [(AstExprBinary _ left-box right-box)
      (match (tc-borrow-check-expr-id ctx env locals borrowed left-box)
        [(OkTcBorrowCheck borrowed1)
          (tc-borrow-check-expr-id ctx env locals borrowed1 right-box)]
        [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
    [(AstExprUnary _ inner-box)
      (tc-borrow-check-expr-id ctx env locals borrowed inner-box)]
    [(AstExprCall func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (match (tc-borrow-check-expr-id ctx env locals borrowed func-box)
          [(OkTcBorrowCheck borrowed1)
            (match (cfg
              compile-profile
              (compiler-tc-reinfer-profile-call-param-types
                "borrow.call_func"
                ctx
                env
                func)
              (tc-move-call-param-types ctx env func))
              [(OkTcTypeList params)
                (match (tc-call-extern-abi ctx func)
                  [(TcSomeExternAbi abi)
                    (if (tc-call-dynamic-c-varargs-abi? abi)
                      (match (tc-call-extern-varargs-params
                        ctx
                        env
                        args
                        params
                        abi)
                        [(OkTcTypeList expanded-params)
                          (tc-borrow-check-call-args-with-types
                            ctx
                            env
                            locals
                            borrowed1
                            expr
                            func
                            args
                            expanded-params)]
                        [(ErrTcTypeList message) (ErrTcBorrowCheck message)])
                      (tc-borrow-check-call-args-with-types
                        ctx
                        env
                        locals
                        borrowed1
                        expr
                        func
                        args
                        params))]
                  [(TcNoExternAbi)
                    (tc-borrow-check-call-args-with-types
                      ctx
                      env
                      locals
                      borrowed1
                      expr
                      func
                      args
                      params)])]
              [(ErrTcTypeList _)
                (match (tc-borrow-check-read-exprs
                  ctx
                  env
                  locals
                  (tc-moved-clone borrowed1)
                  args)
                  [(OkTcBorrowCheck _)
                    (tc-borrow-check-after-call-effects
                      ctx
                      env
                      locals
                      borrowed1
                      expr
                      func
                      args)]
                  [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])])]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprBracketClause items)
      (tc-borrow-check-exprs ctx env locals borrowed items)]
    [(AstExprIf cond-box then-branch-box else-branch-box)
      (match (tc-borrow-check-expr-id ctx env locals borrowed cond-box)
        [(OkTcBorrowCheck borrowedc)
          (match (tc-borrow-check-expr-id
            ctx
            env
            (tc-moved-clone locals)
            (tc-moved-clone borrowedc)
            then-branch-box)
            [(OkTcBorrowCheck borrowedt)
              (match (tc-borrow-check-expr-id
                ctx
                env
                (tc-moved-clone locals)
                (tc-moved-clone borrowedc)
                else-branch-box)
                [(OkTcBorrowCheck borrowede)
                  (OkTcBorrowCheck (tc-moved-union borrowedt borrowede))]
                [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
            [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
        [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body-box)
          (match (tc-borrow-check-let-bindings
            ctx
            env
            (tc-moved-clone locals)
            (tc-moved-clone borrowed)
            bindings)
            [(OkTcBorrowCheckBindings env2 locals2 borrowed2)
              (match (tc-borrow-check-expr-with-protected-id
                ctx
                env2
                locals2
                borrowed2
                borrowed
                body-box)
                [(OkTcBorrowCheck _) (OkTcBorrowCheck borrowed)]
                [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
            [(ErrTcBorrowCheckBindings message) (ErrTcBorrowCheck message)])])]
    [(AstExprLambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda params _ body-box)
          (match (tc-borrow-check-expr-id
            ctx
            (tc-bind-params ctx env params)
            (tc-move-params-locals params (tc-moved-clone locals))
            (tc-moved-empty)
            body-box)
            [(OkTcBorrowCheck _) (OkTcBorrowCheck borrowed)]
            [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])])]
    [(AstExprTuple exprs)
      (match (cfg
        compile-profile
        (compiler-tc-reinfer-profile-expr-list-types
          "borrow.tuple_list"
          ctx
          env
          exprs)
        (tc-expr-list-types ctx env exprs))
        [(OkTcTypeList types)
          (tc-borrow-check-exprs-with-types ctx env locals borrowed exprs types)]
        [(ErrTcTypeList _)
          (tc-borrow-check-exprs ctx env locals borrowed exprs)])]
    [(AstExprTupleRef inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed inner)
          [(OkTcBorrowCheck borrowed1)
            (tc-borrow-check-place-read-conflict locals borrowed1 expr expr)]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprArray exprs)
      (match (cfg
        compile-profile
        (compiler-tc-reinfer-profile-expr-list-types
          "borrow.array_list"
          ctx
          env
          exprs)
        (tc-expr-list-types ctx env exprs))
        [(OkTcTypeList types)
          (tc-borrow-check-exprs-with-types ctx env locals borrowed exprs types)]
        [(ErrTcTypeList _)
          (tc-borrow-check-exprs ctx env locals borrowed exprs)])]
    [(AstExprMakeArray _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExprArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed array)
          [(OkTcBorrowCheck borrowed1)
            (match (tc-borrow-check-expr ctx env locals borrowed1 index)
              [(OkTcBorrowCheck borrowed2)
                (tc-borrow-check-place-read-conflict locals borrowed2 expr expr)]
              [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed array)
          [(OkTcBorrowCheck borrowed1)
            (match (tc-borrow-check-expr ctx env locals borrowed1 index)
              [(OkTcBorrowCheck borrowed2)
                (match (tc-borrow-check-expr ctx env locals borrowed2 value)
                  [(OkTcBorrowCheck borrowed3)
                    (match (tc-borrow-check-after-bind
                      ctx
                      env
                      locals
                      borrowed3
                      value)
                      [(OkTcBorrowCheck borrowed4)
                        (match (tc-borrow-check-array-set-conflict
                          locals
                          borrowed4
                          array
                          index
                          array)
                          [(OkTcUnit) (OkTcBorrowCheck borrowed4)]
                          [(ErrTcUnit message) (ErrTcBorrowCheck message)])]
                      [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
                  [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
              [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprStructSet receiver-box field value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed receiver)
          [(OkTcBorrowCheck borrowed1)
            (match (tc-borrow-check-expr ctx env locals borrowed1 value)
              [(OkTcBorrowCheck borrowed2)
                (match (tc-borrow-check-after-bind
                  ctx
                  env
                  locals
                  borrowed2
                  value)
                  [(OkTcBorrowCheck borrowed3)
                    (match (tc-borrow-check-struct-set-conflict
                      locals
                      borrowed3
                      receiver
                      (intern-str field)
                      receiver)
                      [(OkTcUnit) (OkTcBorrowCheck borrowed3)]
                      [(ErrTcUnit message) (ErrTcBorrowCheck message)])]
                  [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
              [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed array)
          [(OkTcBorrowCheck borrowed1)
            (match (tc-borrow-check-expr ctx env locals borrowed1 value)
              [(OkTcBorrowCheck borrowed2)
                (match (tc-borrow-check-after-bind
                  ctx
                  env
                  locals
                  borrowed2
                  value)
                  [(OkTcBorrowCheck borrowed3)
                    (match (tc-borrow-check-root-mutation-conflict
                      locals
                      borrowed3
                      array
                      array)
                      [(OkTcUnit) (OkTcBorrowCheck borrowed3)]
                      [(ErrTcUnit message) (ErrTcBorrowCheck message)])]
                  [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
              [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprStringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed str)
          [(OkTcBorrowCheck borrowed1)
            (match (tc-borrow-check-expr ctx env locals borrowed1 index)
              [(OkTcBorrowCheck borrowed2)
                (tc-borrow-check-place-read-conflict locals borrowed2 expr expr)]
              [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprWhile cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed cond)
          [(OkTcBorrowCheck borrowedc)
            (match (tc-borrow-check-expr-loop
              ctx
              env
              env
              (tc-moved-clone locals)
              (tc-moved-clone borrowedc)
              borrowedc
              body)
              [(OkTcBorrowCheck body-borrowed)
                (OkTcBorrowCheck
                  (tc-borrow-check-loop-visible-body-borrows
                    ctx
                    env
                    borrowedc
                    body-borrowed))]
              [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprBegin exprs) (tc-borrow-check-exprs ctx env locals borrowed exprs)]
    [(AstExprUnsafe exprs)
      (tc-borrow-check-exprs ctx env locals borrowed exprs)]
    [(AstExprSet name rhs-box)
      (let
        [rhs : AstExpr (ast-node-get rhs-box)]
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-set-expr-id env name-text rhs-box)
            [(OkTcExprId virtual-id)
              (tc-borrow-check-expr
                ctx
                env
                locals
                borrowed
                (ast-node-get virtual-id))]
            [(ErrTcExprId message) (ErrTcBorrowCheck message)])
          (match (tc-borrow-check-expr ctx env locals borrowed rhs)
            [(OkTcBorrowCheck borrowed1)
              (match (tc-borrow-check-after-bind ctx env locals borrowed1 rhs)
                [(OkTcBorrowCheck borrowed2)
                  (match (tc-borrow-check-assignment
                    locals
                    borrowed2
                    name-text
                    rhs)
                    [(OkTcUnit) (OkTcBorrowCheck borrowed2)]
                    [(ErrTcUnit message) (ErrTcBorrowCheck message)])]
                [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
            [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExprBorrow mutable _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (if (= (tc-moved-len borrowed) 0)
          (match (tc-borrow-check-expr ctx env locals borrowed inner)
            [(OkTcBorrowCheck borrowed1)
              (match (tc-borrow-place ctx env inner)
                [(OkTcBorrowPlace _)
                  (tc-borrow-check-add-place-with-mutability
                    locals
                    borrowed1
                    mutable
                    inner
                    inner)]
                [(ErrTcBorrowPlace message) (ErrTcBorrowCheck message)])]
            [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])
          (match (tc-borrow-check-place-read-conflict
            locals
            borrowed
            inner
            expr)
            [(OkTcBorrowCheck borrowed0)
              (match (tc-borrow-check-expr ctx env locals borrowed0 inner)
                [(OkTcBorrowCheck borrowed1)
                  (match (tc-borrow-place ctx env inner)
                    [(OkTcBorrowPlace _)
                      (tc-borrow-check-add-place-with-mutability
                        locals
                        borrowed1
                        mutable
                        inner
                        inner)]
                    [(ErrTcBorrowPlace message) (ErrTcBorrowCheck message)])]
                [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
            [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])))]
    [(AstExprMatch match-box)
      (match (box-get match-box)
        [(AstMatch scrut-box arms)
          (let
            [scrut : AstExpr (ast-node-get scrut-box)]
            (match (tc-borrow-check-expr ctx env locals borrowed scrut)
              [(OkTcBorrowCheck borroweds)
                (match (cfg
                  compile-profile
                  (compiler-tc-reinfer-profile-expr
                    "borrow.match_scrutinee"
                    ctx
                    env
                    scrut)
                  (tc-expr ctx env scrut))
                  [(OkTcType scrut-ty)
                    (tc-borrow-check-arms
                      ctx
                      env
                      locals
                      borroweds
                      scrut-ty
                      arms)]
                  [(ErrTcType message) (ErrTcBorrowCheck message)])]
              [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))])]
    [(AstExprForeach fe-box)
      (match (box-get fe-box)
        [(AstForeach index index-ty start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-borrow-check-expr ctx env locals borrowed start)
              [(OkTcBorrowCheck borrowed1)
                (match (tc-borrow-check-expr ctx env locals borrowed1 end)
                  [(OkTcBorrowCheck borrowed2)
                    (let
                      [index-name : String (intern-str index)]
                      [body-env : TcTypeEnv
                        (tc-bind-id env index (tc-resolve-type ctx index-ty))]
                      [body-locals : TcMovedSet
                        (tc-moved-add (tc-moved-clone locals) index-name)]
                      [body-entry : TcMovedSet
                        (tc-borrow-check-remove-root-state
                          (tc-moved-clone borrowed2)
                          index-name)]
                      (match (tc-borrow-check-expr-loop
                        ctx
                        body-env
                        env
                        body-locals
                        body-entry
                        body-entry
                        body)
                        [(OkTcBorrowCheck body-borrowed)
                          (OkTcBorrowCheck
                            (tc-borrow-check-loop-visible-body-borrows
                              ctx
                              env
                              body-entry
                              (tc-borrow-check-remove-root-state
                                body-borrowed
                                index-name)))]
                        [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
                  [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
              [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))])]
    [(AstExprSpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce _ _ _ a-box b-box c-box d-box)
          (let
            [a : AstExpr (ast-node-get a-box)]
            [b : AstExpr (ast-node-get b-box)]
            [c : AstExpr (ast-node-get c-box)]
            [d : AstExpr (ast-node-get d-box)]
            (match (tc-borrow-check-expr ctx env locals borrowed a)
              [(OkTcBorrowCheck borrowed1)
                (match (tc-borrow-check-expr ctx env locals borrowed1 b)
                  [(OkTcBorrowCheck borrowed2)
                    (match (tc-borrow-check-expr ctx env locals borrowed2 c)
                      [(OkTcBorrowCheck borrowed3)
                        (tc-borrow-check-expr ctx env locals borrowed3 d)]
                      [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
                  [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
              [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))])]
    [(AstExprSpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan
            _
            index
            index-ty
            start-box
            end-box
            prefix
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            [index-name : String (intern-str index)]
            [prefix-name : String (intern-str prefix)]
            [value-env : TcTypeEnv
              (tc-bind-id env index (tc-resolve-type ctx index-ty))]
            [body-env : TcTypeEnv
              (tc-bind-id value-env prefix (tc-resolve-type ctx prefix-ty))]
            [value-locals : TcMovedSet
              (tc-moved-add (tc-moved-clone locals) index-name)]
            [body-locals : TcMovedSet
              (tc-moved-add (tc-moved-clone value-locals) prefix-name)]
            (match (tc-borrow-check-expr ctx env locals borrowed start)
              [(OkTcBorrowCheck borrowed1)
                (match (tc-borrow-check-expr ctx env locals borrowed1 end)
                  [(OkTcBorrowCheck borrowed2)
                    (match (tc-borrow-check-expr ctx env locals borrowed2 init)
                      [(OkTcBorrowCheck borrowed3)
                        (match (tc-borrow-check-expr-loop
                          ctx
                          value-env
                          env
                          value-locals
                          (tc-borrow-check-remove-root-state
                            (tc-moved-clone borrowed3)
                            index-name)
                          (tc-borrow-check-remove-root-state
                            (tc-moved-clone borrowed3)
                            index-name)
                          value)
                          [(OkTcBorrowCheck borrowed4)
                            (let
                              [body-entry : TcMovedSet
                                (tc-borrow-check-remove-root-state
                                  (tc-borrow-check-remove-root-state
                                    (tc-moved-clone borrowed4)
                                    index-name)
                                  prefix-name)]
                              (match (tc-borrow-check-expr-loop
                                ctx
                                body-env
                                env
                                body-locals
                                body-entry
                                body-entry
                                body)
                                [(OkTcBorrowCheck body-borrowed)
                                  (OkTcBorrowCheck
                                    (tc-borrow-check-loop-visible-body-borrows
                                      ctx
                                      env
                                      borrowed4
                                      (tc-borrow-check-remove-root-state
                                        (tc-borrow-check-remove-root-state
                                          body-borrowed
                                          index-name)
                                        prefix-name)))]
                                [(ErrTcBorrowCheck message)
                                  (ErrTcBorrowCheck message)]))]
                          [(ErrTcBorrowCheck message)
                            (ErrTcBorrowCheck message)])]
                      [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
                  [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
              [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))])]
    [(AstExprSpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed value)
          [(OkTcBorrowCheck borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 lane)]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprSpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed value)
          [(OkTcBorrowCheck borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 lane)]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprStructGet inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed inner)
          [(OkTcBorrowCheck borrowed1)
            (tc-borrow-check-place-read-conflict locals borrowed1 expr expr)]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprWithRegion _ exprs)
      (match (tc-borrow-check-exprs
        ctx
        env
        locals
        (tc-moved-clone borrowed)
        exprs)
        [(OkTcBorrowCheck _) (OkTcBorrowCheck borrowed)]
        [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
    [(AstExprWithEscape scratch-box exprs)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed scratch)
          [(OkTcBorrowCheck borrowed1)
            (match (tc-borrow-check-exprs
              ctx
              env
              locals
              (tc-moved-clone borrowed1)
              exprs)
              [(OkTcBorrowCheck _) (OkTcBorrowCheck borrowed1)]
              [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprWithScratch exprs)
      (match (tc-borrow-check-exprs
        ctx
        env
        locals
        (tc-moved-clone borrowed)
        exprs)
        [(OkTcBorrowCheck _) (OkTcBorrowCheck borrowed)]
        [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
    [(AstExprInArena arena-box exprs)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed arena)
          [(OkTcBorrowCheck borrowed1)
            (match (tc-borrow-check-exprs
              ctx
              env
              locals
              (tc-moved-clone borrowed1)
              exprs)
              [(OkTcBorrowCheck _) (OkTcBorrowCheck borrowed1)]
              [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprWithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource bindings exprs)
          (match (tc-borrow-check-resource-bindings
            ctx
            env
            locals
            (tc-moved-clone borrowed)
            bindings)
            [(OkTcBorrowCheckResourceBindings
                body-env
                body-locals
                body-borrowed)
              (match (tc-borrow-check-exprs-with-protected
                ctx
                body-env
                body-locals
                body-borrowed
                borrowed
                exprs)
                [(OkTcBorrowCheck _) (OkTcBorrowCheck borrowed)]
                [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
            [(ErrTcBorrowCheckResourceBindings message)
              (ErrTcBorrowCheck message)])])]
    [(AstExprBox inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExprBoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed inner)
          [(OkTcBorrowCheck borrowed1)
            (tc-borrow-check-place-read-conflict locals borrowed1 expr expr)]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprBoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed inner)
          [(OkTcBorrowCheck borrowed1)
            (match (tc-expr ctx env inner)
              [(OkTcType box-ty)
                (tc-borrow-check-after-consuming-value
                  ctx
                  locals
                  borrowed1
                  inner
                  box-ty)]
              [(ErrTcType _) (OkTcBorrowCheck borrowed1)])]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprBoxSet box-box value-box)
      (let
        [box-expr : AstExpr (ast-node-get box-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed box-expr)
          [(OkTcBorrowCheck borrowed1)
            (match (tc-borrow-check-expr ctx env locals borrowed1 value)
              [(OkTcBorrowCheck borrowed2)
                (match (tc-borrow-check-after-bind
                  ctx
                  env
                  locals
                  borrowed2
                  value)
                  [(OkTcBorrowCheck borrowed3)
                    (match (tc-borrow-check-root-mutation-conflict
                      locals
                      borrowed3
                      (ast-node-get (ast-expr-box-get box-box))
                      box-expr)
                      [(OkTcUnit) (OkTcBorrowCheck borrowed3)]
                      [(ErrTcUnit message) (ErrTcBorrowCheck message)])]
                  [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
              [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)])]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprTypeLiteral _) (OkTcBorrowCheck borrowed)]
    [(AstExprInit _) (OkTcBorrowCheck borrowed)]
    [(AstExprComptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExprQuote _) (OkTcBorrowCheck borrowed)]
    [(AstExprQuasiquote _) (OkTcBorrowCheck borrowed)]
    [(AstExprUnquote _) (OkTcBorrowCheck borrowed)]
    [(AstExprUnquoteSplicing _) (OkTcBorrowCheck borrowed)]
    [(AstExprTry inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExprReturn inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed inner)
          [(OkTcBorrowCheck borrowed1)
            (match (tc-current-return-type env)
              [(OkTcType return-ty)
                (tc-borrow-check-after-consuming-value
                  ctx
                  locals
                  borrowed1
                  inner
                  return-ty)]
              [(ErrTcType _) (OkTcBorrowCheck borrowed1)])]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprPtrNull _) (OkTcBorrowCheck borrowed)]
    [(AstExprPtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExprPtrAddrOf _) (OkTcBorrowCheck borrowed)]
    [(AstExprPtrRead inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExprPtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed ptr)
          [(OkTcBorrowCheck borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 value)]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprPtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed ptr)
          [(OkTcBorrowCheck borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 offset)]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprPtrCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExprPtrToInt inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExprIntToPtr inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExprStringData inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExprStringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed ptr)
          [(OkTcBorrowCheck borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 len)]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprArrayData inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExprBinaryData _) (OkTcBorrowCheck borrowed)]
    [(AstExprSpmdProgramIndex) (OkTcBorrowCheck borrowed)]
    [(AstExprSpmdProgramCount) (OkTcBorrowCheck borrowed)]
    [(AstExprProgramArgc) (OkTcBorrowCheck borrowed)]
    [(AstExprProgramArgv) (OkTcBorrowCheck borrowed)]
    [(AstExprProgramEnvp) (OkTcBorrowCheck borrowed)]
    [(AstExprCpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed leaf)
          [(OkTcBorrowCheck borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 subleaf)]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprCpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed leaf)
          [(OkTcBorrowCheck borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 subleaf)]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprCpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed leaf)
          [(OkTcBorrowCheck borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 subleaf)]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprCpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed leaf)
          [(OkTcBorrowCheck borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 subleaf)]
          [(ErrTcBorrowCheck message) (ErrTcBorrowCheck message)]))]
    [(AstExprXgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (tc-borrow-check-expr ctx env locals borrowed index))]
    [(AstExprSyscall args)
      (tc-borrow-check-read-exprs ctx env locals borrowed args)]))

(define (tc-borrow-check-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]
  [body : AstExpr]) : ResultTcUnit
  (match (tc-borrow-check-expr-with-protected
    ctx
    env
    (tc-move-params-locals params (tc-moved-empty))
    (tc-moved-empty)
    (tc-moved-empty)
    body)
    [(OkTcBorrowCheck _) OkTcUnit]
    [(ErrTcBorrowCheck message) (ErrTcUnit message)]))

(define (tc-borrow-check-body-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]
  [body-id : i64]) : ResultTcUnit
  (match (tc-borrow-check-expr-with-protected-id
    ctx
    env
    (tc-move-params-locals params (tc-moved-empty))
    (tc-moved-empty)
    (tc-moved-empty)
    body-id)
    [(OkTcBorrowCheck _) OkTcUnit]
    [(ErrTcBorrowCheck message) (ErrTcUnit message)]))

;; --- macro expansion phase (#1139) ------------------------------------------
;;
;; Pipeline: parse -> EXPAND -> typecheck. When a call head names a `defmacro`,
;; the unevaluated operand forms are passed as `Expr` values (CtfeExpr) to the
;; transformer, which is run via CTFE; the produced `Expr` is spliced at the
;; call site and re-expanded to a fixpoint (depth-limited). Macro calls in
;; ordinary evaluated positions are expanded; quoted/quasiquoted code is left
;; as data. Programs without macro calls pass through unchanged. The normal
;; typechecker then runs over the expanded program as the post-expansion safety
;; net. Call-site arity and operand signature checks run before the transformer
;; so obvious operand type errors are reported at the macro call site.
(defenum MacroMaybeDecl
  (No)
  (Some String String AstMacroParamList AstType AstExpr))

(defenum ResultMacroCallDecl
  (Ok MacroMaybeDecl)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroCallDeclModule
  (Ok MacroMaybeDecl String)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroExpr
  (Ok i64)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroCompatCall
  (Ok i64)
  (No)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroExprList
  (Ok AstExprList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroArms
  (Ok AstMatchArmList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroLetBindings
  (Ok AstLetBindingList TcTypeEnv)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroEnv
  (Ok CtfeEnv)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroCheck
  (Ok)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroModuleArg
  (Ok String)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroClause
  (Ok AstExprClause)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroClauseList
  (Ok AstExprClauseList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroBindingClause
  (Ok AstExprBindingClause)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroBindingClauseList
  (Ok AstExprBindingClauseList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroDecl
  (Ok AstDecl)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroDecls
  (Ok AstDeclList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroDeclExpansion
  (Ok AstDeclList AstDeclPathList)
  (Err (Box CompilerDiagnostic)))

(defenum MacroFollowupCause
  (MacroFollowupImportPlaceholder)
  (MacroFollowupExpandedDecl)
  (MacroFollowupBlockedAfterInertSplice)
  (MacroFollowupGeneratedImport)
  (MacroFollowupModulePlaceholder))

(defstruct MacroFollowupWork
  (start-index i64)
  (end-index i64)
  (start-path String)
  (end-path String)
  (module String)
  (cause MacroFollowupCause))

(defenum MacroFollowupWorkList
  (MacroFollowupWorkNil)
  (MacroFollowupWorkCons MacroFollowupWork (Box MacroFollowupWorkList)))

(defenum ResultMacroDeclsWithPaths
  (Ok AstDeclList AstDeclPathList MacroFollowupWorkList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroExpand
  (Ok AstProgram AstDeclPathList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroExpandPass
  (Ok AstProgram AstDeclPathList MacroFollowupWorkList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroValue
  (Ok CompilerCtfeValue)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroValueEnv
  (Ok CompilerCtfeValue CtfeEnv)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroTypeArg
  (Ok AstType)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroSexpr
  (Ok SpannedSexpr)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroParsedDecls
  (Ok AstDeclList)
  (Err (Box CompilerDiagnostic)))

(defenum MacroMaybeModuleName
  (No)
  (Some String))

(defenum MacroMaybeDeclList
  (No)
  (Some AstDeclList))

(defenum MacroHygieneEnv
  (Nil)
  (Bind String String (Box MacroHygieneEnv)))

(defenum MacroHygieneName
  (Name String MacroHygieneEnv))

(defenum MacroHygieneParams
  (Params AstParamList MacroHygieneEnv))

(defenum MacroHygieneLetBindings
  (LetBindings AstLetBindingList MacroHygieneEnv))

(defenum MacroHygieneResourceBindings
  (ResourceBindings AstResourceBindingList MacroHygieneEnv))

(defenum MacroHygienePattern
  (Pattern AstPattern MacroHygieneEnv))

(defenum MacroHygienePatternList
  (PatternList AstPatternList MacroHygieneEnv))

(define macro-expand-active-module : String
  "")

;; Set of macro (and compat-guard) names callable in the program. Used as a
;; cheap, allocation-free pre-filter in the macro-use detector so the common
;; case (a plain function call whose name is not a macro) avoids the allocating
;; module-key lookup in `macro-call-decl`. Populated once per expansion run.
(define macro-expand-macro-names : TcStringList
  (TcStringNil))

;; Macro names whose transformer bodies can call `expr-type`. Only those macros
;; need fixed `Expr` operands to carry produced type metadata.
(define macro-expand-expr-type-macro-names : TcStringList
  (TcStringNil))

;; Cached CTFE base environment (reflection + layout metadata) for the current
;; expansion run. `macro-expand-call` rebuilt this via `tc-ctfe-env` -- which runs
;; `ctfe-reflections-from-program` over the WHOLE program (O(program)) -- on EVERY
;; macro call, costing ~150MB per call on a self-compile. The metadata is
;; invariant across an expansion run, so build it once per run and reuse.
(define macro-expand-ctfe-env-ready : bool
  false)
(define macro-expand-ctfe-env-value : CtfeEnv
  (ctfe-env-empty))

;; Whether the current compile needs the CTFE reflection/layout metadata at all
;; (i.e. the program contains a `(type T)` literal). Set per compile at the top of
;; macro-expand-program; when false, tc-ctfe-env returns an empty env and skips
;; the whole-program metadata build. Defaults true (build) for safety.
(define ctfe-needs-metadata : bool
  true)

(define (macro-zero-source-span) : SourceSpan
  (SourceSpan 1 1 1 1))

(define (macro-source-span-from-ast [span : AstSourceSpan]) : SourceSpan
  (SourceSpan
    (struct-get span start-line)
    (struct-get span start-col)
    (struct-get span end-line)
    (struct-get span end-col)))

(define (macro-output-syntax-diag [origin : AstExpr] [message : String]) : CompilerDiagnostic
  (ctfe-diagnostic-at-expr origin message))

(define (macro-output-syntax-name [name : String]) : String
  (if (tc-hygiene-template-name? name)
    (tc-hygiene-template-base name)
    name))

(define (macro-output-source-name [name : String]) : String
  (let
    [source-name : String
      (if (tc-hygiene-template-name? name)
        (tc-hygiene-template-base name)
        (tc-hygiene-global-symbol-name name))]
    (if (tc-source-slash-qualified? source-name)
      (tc-name-slashes-to-dots source-name)
      source-name)))

(define (macro-decl-list-reverse-into [items : AstDeclList] [out : AstDeclList]) : AstDeclList
  (let
    [cursor : AstDeclList items]
    [result : AstDeclList out]
    [done : bool false]
    (begin
      (while (not done)
        (match cursor
          [(AstDeclNil) (set! done true)]
          [(AstDeclCons head rest)
            (begin
              (set! result (ast-decl-cons head result))
              (set! cursor (box-get rest)))]))
      result)))

(define (macro-decl-list-reverse [items : AstDeclList]) : AstDeclList
  (macro-decl-list-reverse-into items AstDeclNil))

(define (macro-decl-list-append [left : AstDeclList] [right : AstDeclList]) : AstDeclList
  (macro-decl-list-reverse-into (macro-decl-list-reverse left) right))

(define (macro-decl-path-list-reverse-into
  [items : AstDeclPathList]
  [out : AstDeclPathList]) : AstDeclPathList
  (let
    [cursor : AstDeclPathList items]
    [result : AstDeclPathList out]
    [done : bool false]
    (begin
      (while (not done)
        (match cursor
          [(AstDeclPathNil) (set! done true)]
          [(AstDeclPathCons head rest)
            (begin
              (set! result (ast-decl-path-cons head result))
              (set! cursor (box-get rest)))]))
      result)))

(define (macro-decl-path-list-reverse [items : AstDeclPathList]) : AstDeclPathList
  (macro-decl-path-list-reverse-into items AstDeclPathNil))

(define (macro-decl-path-list-append
  [left : AstDeclPathList]
  [right : AstDeclPathList]) : AstDeclPathList
  (macro-decl-path-list-reverse-into (macro-decl-path-list-reverse left) right))

(define (macro-followup-work-list-empty? [items : MacroFollowupWorkList]) : bool
  (match items
    [(MacroFollowupWorkNil) true]
    [(MacroFollowupWorkCons _ _) false]))

(define (macro-followup-work-cons
  [head : MacroFollowupWork]
  [rest : MacroFollowupWorkList]) : MacroFollowupWorkList
  (MacroFollowupWorkCons head (box rest)))

(define (macro-followup-work-list-reverse-into
  [items : MacroFollowupWorkList]
  [out : MacroFollowupWorkList]) : MacroFollowupWorkList
  (let
    [cursor : MacroFollowupWorkList items]
    [result : MacroFollowupWorkList out]
    [done : bool false]
    (begin
      (while (not done)
        (match cursor
          [(MacroFollowupWorkNil) (set! done true)]
          [(MacroFollowupWorkCons head rest)
            (begin
              (set! result (macro-followup-work-cons head result))
              (set! cursor (box-get rest)))]))
      result)))

(define (macro-followup-work-list-reverse [items : MacroFollowupWorkList]) : MacroFollowupWorkList
  (macro-followup-work-list-reverse-into items MacroFollowupWorkNil))

(define (macro-followup-path-list-first
  [paths : AstDeclPathList]
  [fallback : String]) : String
  (match paths
    [(AstDeclPathNil) fallback]
    [(AstDeclPathCons path _) path]))

(define (macro-followup-path-list-last
  [paths : AstDeclPathList]
  [fallback : String]) : String
  (match paths
    [(AstDeclPathNil) fallback]
    [(AstDeclPathCons path rest)
      (macro-followup-path-list-last (box-get rest) path)]))

(define (macro-followup-work-at
  [start-index : i64]
  [end-index : i64]
  [start-path : String]
  [end-path : String]
  [module : String]
  [cause : MacroFollowupCause]) : MacroFollowupWorkList
  (macro-followup-work-cons
    (MacroFollowupWork start-index end-index start-path end-path module cause)
    MacroFollowupWorkNil))

(define (macro-followup-work-for-decls
  [start-index : i64]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [module : String]
  [cause : MacroFollowupCause]) : MacroFollowupWorkList
  (let
    [start-path : String (macro-followup-path-list-first paths "")]
    [end-path : String (macro-followup-path-list-last paths start-path)]
    [end-index : i64 (+ start-index (ast-decl-list-count decls))]
    (macro-followup-work-at
      start-index
      end-index
      start-path
      end-path
      module
      cause)))

(cfg
  test
  (define (macro-followup-test-cause-code [cause : MacroFollowupCause]) : i64
    (match cause
      [(MacroFollowupImportPlaceholder) 1]
      [(MacroFollowupExpandedDecl) 2]
      [(MacroFollowupBlockedAfterInertSplice) 3]
      [(MacroFollowupGeneratedImport) 4]
      [(MacroFollowupModulePlaceholder) 5])))

(cfg
  test
  (define (macro-followup-test-head [items : MacroFollowupWorkList]) : MacroFollowupWork
    (match items
      [(MacroFollowupWorkCons work _) work]
      [(MacroFollowupWorkNil)
        (begin
          (test.assert-true false "expected follow-up work")
          (MacroFollowupWork 0 0 "" "" "" MacroFollowupGeneratedImport))])))

(cfg
  test
  (test
    macro-followup-generated-import-work-metadata
    (let
      [decls : AstDeclList
        (ast-decl-cons (ast-decl-module "generated.module") AstDeclNil)]
      [paths : AstDeclPathList
        (ast-decl-path-cons "generated.tl" AstDeclPathNil)]
      [items : MacroFollowupWorkList
        (macro-followup-work-for-decls
          2
          decls
          paths
          "owner.module"
          MacroFollowupGeneratedImport)]
      [work : MacroFollowupWork (macro-followup-test-head items)]
      [actual-start-path : String (struct-get work start-path)]
      [actual-end-path : String (struct-get work end-path)]
      [expected-path : String "generated.tl"]
      [actual-module : String (struct-get work module)]
      [expected-module : String "owner.module"]
      (begin
        (test.assert-false
          (macro-followup-work-list-empty? items)
          "generated import work should be present")
        (test.assert-i64-eq
          (struct-get work start-index)
          2
          "generated import work start")
        (test.assert-i64-eq
          (struct-get work end-index)
          3
          "generated import work end")
        (test.assert-string-eq
          (& actual-start-path)
          (& expected-path)
          "generated import start path")
        (test.assert-string-eq
          (& actual-end-path)
          (& expected-path)
          "generated import end path")
        (test.assert-string-eq
          (& actual-module)
          (& expected-module)
          "generated import module")
        (test.assert-i64-eq
          (macro-followup-test-cause-code (struct-get work cause))
          4
          "generated import cause")))))

(cfg
  test
  (test
    macro-followup-module-placeholder-work-metadata
    (let
      [span : AstSourceSpan (AstSourceSpan 1 1 1 1)]
      [placeholder : AstDecl
        (AstDeclImport
          (AstImportSpec
            (AstImportMacroDecls 0 AstNoModuleName)
            "stdlib/vector.tl"
            AstNoModuleName
            AstNoImportAlias
            span))]
      [decls : AstDeclList
        (ast-decl-cons
          (ast-decl-module "owner.module")
          (ast-decl-cons placeholder AstDeclNil))]
      [paths : AstDeclPathList
        (ast-decl-path-cons
          "owner.tl"
          (ast-decl-path-cons "owner.tl" AstDeclPathNil))]
      [items : MacroFollowupWorkList
        (macro-module-placeholder-followup-work-list decls paths)]
      [work : MacroFollowupWork (macro-followup-test-head items)]
      [actual-path : String (struct-get work start-path)]
      [expected-path : String "owner.tl"]
      [actual-module : String (struct-get work module)]
      [expected-module : String "owner.module"]
      (begin
        (test.assert-false
          (macro-followup-work-list-empty? items)
          "module placeholder work should be present")
        (test.assert-i64-eq
          (struct-get work start-index)
          1
          "module placeholder work start")
        (test.assert-i64-eq
          (struct-get work end-index)
          2
          "module placeholder work end")
        (test.assert-string-eq
          (& actual-path)
          (& expected-path)
          "module placeholder path")
        (test.assert-string-eq
          (& actual-module)
          (& expected-module)
          "module placeholder module")
        (test.assert-i64-eq
          (macro-followup-test-cause-code (struct-get work cause))
          5
          "module placeholder cause")))))

(define (macro-paths-for-decls [decls : AstDeclList] [path : String]) : AstDeclPathList
  (match decls
    [(AstDeclNil) AstDeclPathNil]
    [(AstDeclCons _ rest)
      (ast-decl-path-cons path (macro-paths-for-decls (box-get rest) path))]))

(define (macro-decls-final-module [decls : AstDeclList] [module : String]) : String
  (match decls
    [(AstDeclNil) module]
    [(AstDeclCons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDeclModule next-module)
            (macro-decls-final-module rest (intern-str next-module))]
          [_ (macro-decls-final-module rest module)]))]))

(define (macro-decls-module-count [decls : AstDeclList]) : i64
  (match decls
    [(AstDeclNil) 0]
    [(AstDeclCons decl rest)
      (let
        [rest-count : i64 (macro-decls-module-count (box-get rest))]
        (match decl
          [(AstDeclModule _) (+ rest-count 1)]
          [_ rest-count]))]))

(define (macro-identity-key-join [head : String] [tail : String]) : String
  (if (> (string.string-length tail) 0)
    (str_cat.str-cat head ";" tail)
    head))

(define (macro-identity-key-string-expr
  [expr : AstExpr]
  [env : CtfeEnv]
  [fuel : i64]) : ResultGenKey
  (match (compiler-ctfe-eval expr env fuel)
    [(OkCtfe value next-fuel)
      (match value
        [(CtfeString text) (OkGenKey (spec-string-key text) next-fuel)]
        [(CtfeI64 n)
          (OkGenKey (str_cat.str-cat "i64:" (string.int->string n)) next-fuel)]
        [_
          (ErrGenKey
            (box
              (ctfe-diagnostic-at-expr
                expr
                "typecheck: Module macro identity key expression must evaluate to String or i64")))])]
    [(ErrCtfe diag) (ErrGenKey diag)]))

(define (macro-identity-key-string-exprs
  [exprs : AstExprList]
  [env : CtfeEnv]
  [fuel : i64]) : ResultGenKey
  (match exprs
    [(AstExprNil) (OkGenKey "" fuel)]
    [(AstExprCons head rest)
      (let
        [head-expr : AstExpr (ast-node-get head)]
        (match (macro-identity-key-string-expr head-expr env fuel)
          [(OkGenKey head-key head-fuel)
            (match (macro-identity-key-string-exprs
              (box-get rest)
              env
              head-fuel)
              [(OkGenKey tail tail-fuel)
                (OkGenKey (macro-identity-key-join head-key tail) tail-fuel)]
              [(ErrGenKey diag) (ErrGenKey diag)])]
          [(ErrGenKey diag) (ErrGenKey diag)]))]))

(define (macro-identity-key-sexpr [sexpr : SpannedSexpr]) : String
  (match sexpr
    [(SpannedSexpr.Int _ text _)
      (str_cat.str-cat "int:" (spec-string-key text))]
    [(SpannedSexpr.Sym name _) (str_cat.str-cat "sym:" (spec-string-key name))]
    [(SpannedSexpr.Nil _) "nil"]
    [(SpannedSexpr.Cons head tail _)
      (str_cat.str-cat
        "cons:"
        (spec-string-key (macro-identity-key-sexpr (sp-node-get head)))
        ":"
        (spec-string-key (macro-identity-key-sexpr (sp-node-get tail))))]
    [(SpannedSexpr.Str text _) (str_cat.str-cat "str:" (spec-string-key text))]
    [(SpannedSexpr.Char c _)
      (str_cat.str-cat "char:" (string.int->string (cast c : i64)))]
    [(SpannedSexpr.Float text _)
      (str_cat.str-cat "float:" (spec-string-key text))]
    [(SpannedSexpr.BracketList items _)
      (str_cat.str-cat
        "bracket:"
        (spec-string-key (macro-identity-key-sexpr (sp-node-get items))))]))

(define (macro-identity-key-syntax-expr
  [expr : AstExpr]
  [origin : AstExpr]
  [fuel : i64]) : ResultGenKey
  (match (macro-expr-to-spanned-sexpr expr origin)
    [(ResultMacroSexpr.Ok sexpr)
      (OkGenKey
        (str_cat.str-cat "syntax:" (macro-identity-key-sexpr sexpr))
        fuel)]
    [(ResultMacroSexpr.Err diag) (ErrGenKey diag)]))

(define (macro-identity-syntax-param-type? [ctx : TcContext] [ty : AstType]) : bool
  (let
    [resolved : AstType (tc-resolve-type ctx (tc-macro-signature-type ty))]
    (or
      (tc-type-eq resolved (AstTyExpr))
      (tc-type-eq resolved (AstTyExprList))
      (tc-macro-expr-clause-type? resolved)
      (tc-macro-expr-clause-list-type? resolved)
      (tc-macro-expr-binding-clause-type? resolved)
      (tc-macro-expr-binding-clause-list-type? resolved))))

(define (macro-identity-key-param-expr
  [ctx : TcContext]
  [ty : AstType]
  [expr : AstExpr]
  [env : CtfeEnv]
  [fuel : i64]
  [call-expr : AstExpr]) : ResultGenKey
  (if (macro-identity-syntax-param-type? ctx ty)
    (match (macro-identity-key-string-expr expr env fuel)
      [(OkGenKey key next-fuel) (OkGenKey key next-fuel)]
      [(ErrGenKey _) (macro-identity-key-syntax-expr expr call-expr fuel)])
    (macro-identity-key-string-expr expr env fuel)))

(define (macro-identity-key-param-exprs
  [ctx : TcContext]
  [ty : AstType]
  [exprs : AstExprList]
  [env : CtfeEnv]
  [fuel : i64]
  [call-expr : AstExpr]) : ResultGenKey
  (match exprs
    [(AstExprNil) (OkGenKey "" fuel)]
    [(AstExprCons head rest)
      (let
        [head-expr : AstExpr (ast-node-get head)]
        (match (macro-identity-key-param-expr
          ctx
          ty
          head-expr
          env
          fuel
          call-expr)
          [(OkGenKey head-key head-fuel)
            (match (macro-identity-key-param-exprs
              ctx
              ty
              (box-get rest)
              env
              head-fuel
              call-expr)
              [(OkGenKey tail tail-fuel)
                (OkGenKey (macro-identity-key-join head-key tail) tail-fuel)]
              [(ErrGenKey diag) (ErrGenKey diag)])]
          [(ErrGenKey diag) (ErrGenKey diag)]))]))

(define (macro-identity-key-params
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [params : AstMacroParamList]
  [args : AstExprList]
  [env : CtfeEnv]
  [fuel : i64]
  [call-expr : AstExpr]) : ResultGenKey
  (match params
    [(AstMacroParamNil)
      (match args
        [(AstExprNil) (OkGenKey "" fuel)]
        [(AstExprCons head _)
          (ErrGenKey
            (box
              (ctfe-diagnostic-at-expr
                (ast-node-get head)
                "macro call has too many arguments")))])]
    [(AstMacroParamCons param rest-params)
      (let
        [rest-params : AstMacroParamList (box-get rest-params)]
        (match param
          [(AstMacroParam _ ty variadic)
            (if variadic
              (cond
                [(tc-macro-type-param-kind? ty)
                  (ErrGenKey
                    (box
                      (ctfe-diagnostic-at-expr
                        call-expr
                        "typecheck: type macro operand cannot be variadic")))]
                [(tc-macro-module-param-kind? ty)
                  (ErrGenKey
                    (box
                      (ctfe-diagnostic-at-expr
                        call-expr
                        "typecheck: Module macro operand cannot be variadic")))]
                [(macro-identity-syntax-param-type? ctx ty)
                  (macro-identity-key-param-exprs
                    ctx
                    ty
                    args
                    env
                    fuel
                    call-expr)]
                [else (macro-identity-key-string-exprs args env fuel)])
              (match args
                [(AstExprNil)
                  (ErrGenKey
                    (box
                      (ctfe-diagnostic-at-expr
                        call-expr
                        "macro call has too few arguments")))]
                [(AstExprCons head rest-args)
                  (let
                    [head-expr : AstExpr (ast-node-get head)]
                    [rest-args : AstExprList (box-get rest-args)]
                    (match (if (tc-macro-type-param-kind? ty)
                      (match (macro-type-arg-with-fallback
                        ctx
                        decls
                        fallback-module
                        head-expr)
                        [(ResultMacroTypeArg.Ok resolved-ty)
                          (OkGenKey
                            (str_cat.str-cat
                              "type_"
                              (ctfe-type-key resolved-ty))
                            fuel)]
                        [(ResultMacroTypeArg.Err diag) (ErrGenKey diag)])
                      (if (tc-macro-module-param-kind? ty)
                        (match (macro-module-strategy-arg-with-fallback
                          ctx
                          fallback-module
                          head-expr)
                          [(ResultMacroModuleArg.Ok module)
                            (OkGenKey
                              (str_cat.str-cat
                                "module_"
                                (spec-string-key module))
                              fuel)]
                          [(ResultMacroModuleArg.Err diag) (ErrGenKey diag)])
                        (macro-identity-key-param-expr
                          ctx
                          ty
                          head-expr
                          env
                          fuel
                          call-expr)))
                      [(OkGenKey head-key head-fuel)
                        (match (macro-identity-key-params
                          ctx
                          decls
                          fallback-module
                          rest-params
                          rest-args
                          env
                          head-fuel
                          call-expr)
                          [(OkGenKey tail tail-fuel)
                            (OkGenKey
                              (macro-identity-key-join head-key tail)
                              tail-fuel)]
                          [(ErrGenKey diag) (ErrGenKey diag)])]
                      [(ErrGenKey diag) (ErrGenKey diag)]))]))]))]))

(define (macro-module-identity
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [macro-name : String]
  [definition-module : String]
  [params : AstMacroParamList]
  [args : AstExprList]
  [env : CtfeEnv]
  [call-expr : AstExpr]) : ResultGenKey
  (match (macro-identity-key-params
    ctx
    decls
    fallback-module
    params
    args
    env
    (ctfe-fuel-limit)
    call-expr)
    [(OkGenKey arg-key fuel)
      (OkGenKey
        (str_cat.str-cat definition-module ":" macro-name "(" arg-key ")")
        fuel)]
    [(ErrGenKey diag) (ErrGenKey diag)]))

(define (macro-decls-generated-key [identity : String]) : String
  (string.string-append "decls:" identity))

(define (macro-generated-meta
  [generator : String]
  [item : String]
  [key : String]) : AstGeneratedDeclMeta
  (AstSomeGeneratedDeclMeta generator item AstExprNil key))

(define (macro-import-placeholder-kind? [kind : AstImportKind]) : bool
  (match kind
    [(AstImportMacro _ _) true]
    [(AstImportMacroDecls _ _) true]
    [_ false]))

(define (macro-decl-import-placeholder? [decl : AstDecl]) : bool
  (match decl
    [(AstDeclImport (AstImportSpec kind _ _ _ _))
      (macro-import-placeholder-kind? kind)]
    [(AstDeclComptimeDecl _ template-box)
      (macro-decl-import-placeholder? (box-get template-box))]
    [_ false]))

(define (macro-wrap-generated-decl
  [decl : AstDecl]
  [generator : String]
  [key : String]) : AstDecl
  (match decl
    [(AstDeclModule _) decl]
    [(AstDeclImport _)
      (ast-decl-comptime-decl-with-meta
        (macro-generated-meta generator "import" key)
        decl)]
    [_
      (match (gen-decl-visible-name decl)
        [(SpecSomeString item)
          (ast-decl-comptime-decl-with-meta
            (macro-generated-meta generator item key)
            decl)]
        [(SpecNoString) decl])]))

(define (macro-wrap-generated-decls
  [decls : AstDeclList]
  [generator : String]
  [key : String]) : AstDeclList
  (match decls
    [(AstDeclNil) AstDeclNil]
    [(AstDeclCons decl rest)
      (ast-decl-cons
        (macro-wrap-generated-decl decl generator key)
        (macro-wrap-generated-decls (box-get rest) generator key))]))

(define (macro-wrap-generated-decl-decls
  [decl : AstDecl]
  [generator : String]
  [key : String]) : AstDecl
  (match (gen-decl-visible-name decl)
    [(SpecSomeString item)
      (ast-decl-comptime-decl-with-meta
        (macro-generated-meta generator item key)
        decl)]
    [(SpecNoString) decl]))

(define (macro-wrap-generated-decls-decls
  [decls : AstDeclList]
  [generator : String]
  [key : String]) : AstDeclList
  (match decls
    [(AstDeclNil) AstDeclNil]
    [(AstDeclCons decl rest)
      (ast-decl-cons
        (macro-wrap-generated-decl-decls decl generator key)
        (macro-wrap-generated-decls-decls (box-get rest) generator key))]))

(define (macro-generated-context-import-kind
  [kind : AstImportKind]
  [definition-module : String]) : AstImportKind
  (match kind
    [(AstImportMacro call-id context)
      (match context
        [(AstNoModuleName)
          (AstImportMacro call-id (AstSomeModuleName definition-module))]
        [_ kind])]
    [(AstImportMacroDecls call-id context)
      (match context
        [(AstNoModuleName)
          (AstImportMacroDecls call-id (AstSomeModuleName definition-module))]
        [_ kind])]
    [_ kind]))

(define (macro-generated-context-decl
  [decl : AstDecl]
  [definition-module : String]) : AstDecl
  (match decl
    [(AstDeclImport (AstImportSpec kind path target alias span))
      (AstDeclImport
        (AstImportSpec
          (macro-generated-context-import-kind kind definition-module)
          path
          target
          alias
          span))]
    [(AstDeclUnsafe inner-box)
      (ast-decl-unsafe
        (macro-generated-context-decl (box-get inner-box) definition-module))]
    [(AstDeclComptimeDecl meta inner-box)
      (ast-decl-comptime-decl-with-meta
        meta
        (macro-generated-context-decl (box-get inner-box) definition-module))]
    [_ decl]))

(define (macro-generated-context-decls
  [decls : AstDeclList]
  [definition-module : String]) : AstDeclList
  (match decls
    [(AstDeclNil) AstDeclNil]
    [(AstDeclCons decl rest)
      (ast-decl-cons
        (macro-generated-context-decl decl definition-module)
        (macro-generated-context-decls (box-get rest) definition-module))]))

(define (macro-decl-generated-key? [decl : AstDecl] [key : String]) : bool
  (match decl
    [(AstDeclComptimeDecl meta template-box)
      (match meta
        [(AstSomeGeneratedDeclMeta _ _ _ meta-key)
          (if (string.string-eq meta-key key)
            true
            (macro-decl-generated-key? (box-get template-box) key))]
        [(AstNoGeneratedDeclMeta)
          (macro-decl-generated-key? (box-get template-box) key)])]
    [(AstDeclUnsafe inner-box)
      (macro-decl-generated-key? (box-get inner-box) key)]
    [_ false]))

(define (macro-decl-generated-import-placeholder?
  [decl : AstDecl]
  [key : String]) : bool
  (match decl
    [(AstDeclComptimeDecl meta template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (match meta
          [(AstSomeGeneratedDeclMeta _ _ _ meta-key)
            (if (string.string-eq meta-key key)
              (macro-decl-import-placeholder? template)
              (macro-decl-generated-import-placeholder? template key))]
          [(AstNoGeneratedDeclMeta)
            (macro-decl-generated-import-placeholder? template key)]))]
    [(AstDeclUnsafe inner-box)
      (macro-decl-generated-import-placeholder? (box-get inner-box) key)]
    [_ false]))

(define (macro-decl-import? [decl : AstDecl]) : bool
  (match decl
    [(AstDeclImport _) true]
    [(AstDeclComptimeDecl _ template-box)
      (macro-decl-import? (box-get template-box))]
    [(AstDeclUnsafe inner-box) (macro-decl-import? (box-get inner-box))]
    [_ false]))

(define (macro-decls-contain-generated-key?
  [decls : AstDeclList]
  [key : String]) : bool
  (match decls
    [(AstDeclNil) false]
    [(AstDeclCons decl rest)
      (or
        (macro-decl-generated-key? decl key)
        (macro-decls-contain-generated-key? (box-get rest) key))]))

(define (macro-decls-filter-generated-key [decls : AstDeclList] [key : String]) : AstDeclList
  (match decls
    [(AstDeclNil) AstDeclNil]
    [(AstDeclCons decl rest)
      (let
        [filtered-rest : AstDeclList
          (macro-decls-filter-generated-key (box-get rest) key)]
        (if (and
          (macro-decl-generated-key? decl key)
          (not (macro-decl-import? decl)))
          (ast-decl-cons decl filtered-rest)
          filtered-rest))]))

(define (macro-decl-list-structural-eq? [a : AstDeclList] [b : AstDeclList]) : bool
  (match a
    [(AstDeclNil)
      (match b
        [(AstDeclNil) true]
        [_ false])]
    [(AstDeclCons a-head a-rest)
      (let
        [a-rest : AstDeclList (box-get a-rest)]
        (match b
          [(AstDeclCons b-head b-rest)
            (let
              [b-rest : AstDeclList (box-get b-rest)]
              (and
                (gen-decl-eq? a-head b-head)
                (macro-decl-list-structural-eq? a-rest b-rest)))]
          [_ false]))]))

(defenum MacroGeneratedFingerprintCacheLookup
  (Miss)
  (TooLarge)
  (Hit String))

(defenum MacroGeneratedFingerprintKey
  (Key String i64)
  (TooLarge))

(define macro-generated-fingerprint-cache-capacity : i64
  4096)
(define macro-generated-fingerprint-cache-module-keys : (Array i64)
  (array.make-array i64 4096))
(define macro-generated-fingerprint-cache-identity-keys : (Array i64)
  (array.make-array i64 4096))
(define macro-generated-fingerprint-cache-values : (Array String)
  (array.make-array String 4096))
(define macro-generated-fingerprint-cache-count : i64
  0)
(define macro-generated-fingerprint-cache-generation : i64
  -1)
(define macro-generated-fingerprint-cache-ready : bool
  false)
(define macro-generated-fingerprint-cache-too-large-value : String
  "__typelisp_macro_generated_fingerprint_too_large__")

(define (macro-generated-fingerprint-cache-reset!) : unit
  (set! macro-generated-fingerprint-cache-ready false))

(define (macro-generated-fingerprint-cache-ensure!) : unit
  (if (if macro-generated-fingerprint-cache-ready
    (= macro-generated-fingerprint-cache-generation (intern-generation))
    false)
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i macro-generated-fingerprint-cache-capacity)
          (begin
            (array.array-set! macro-generated-fingerprint-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set! macro-generated-fingerprint-cache-count 0)
        (set! macro-generated-fingerprint-cache-generation (intern-generation))
        (set! macro-generated-fingerprint-cache-ready true)))))

(define (macro-generated-fingerprint-cache-bucket
  [module-id : i64]
  [identity-id : i64]) : i64
  (bit-and
    (+ (* module-id 2654435761) (* identity-id 40503))
    (- macro-generated-fingerprint-cache-capacity 1)))

(define (macro-generated-fingerprint-cache-get
  [target-module : String]
  [identity : String]) : MacroGeneratedFingerprintCacheLookup
  (let
    [module-id : i64 (intern target-module)]
    [identity-id : i64 (intern identity)]
    (begin
      (macro-generated-fingerprint-cache-ensure!)
      (let
        [cursor : i64
          (macro-generated-fingerprint-cache-bucket module-id identity-id)]
        [module-key : i64 (+ module-id 1)]
        [identity-key : i64 (+ identity-id 1)]
        [steps : i64 0]
        [out : MacroGeneratedFingerprintCacheLookup
          (MacroGeneratedFingerprintCacheLookup.Miss)]
        [done : bool false]
        (begin
          (while (if done
            false
            (< steps macro-generated-fingerprint-cache-capacity))
            (let
              [slot : i64
                (array.array-ref
                  macro-generated-fingerprint-cache-module-keys
                  cursor)]
              (if (= slot 0)
                (set! done true)
                (if (and
                  (= slot module-key)
                  (=
                    (array.array-ref
                      macro-generated-fingerprint-cache-identity-keys
                      cursor)
                    identity-key))
                  (begin
                    (set!
                      out
                      (let
                        [value : String
                          (array.array-ref
                            macro-generated-fingerprint-cache-values
                            cursor)]
                        (if (string.string-eq
                          value
                          macro-generated-fingerprint-cache-too-large-value)
                          (MacroGeneratedFingerprintCacheLookup.TooLarge)
                          (MacroGeneratedFingerprintCacheLookup.Hit value))))
                    (set! done true))
                  (begin
                    (set!
                      cursor
                      (bit-and
                        (+ cursor 1)
                        (- macro-generated-fingerprint-cache-capacity 1)))
                    (set! steps (+ steps 1)))))))
          out)))))

(define (macro-generated-fingerprint-cache-put!
  [target-module : String]
  [identity : String]
  [value : String]) : unit
  (let
    [module-id : i64 (intern target-module)]
    [identity-id : i64 (intern identity)]
    (begin
      (macro-generated-fingerprint-cache-ensure!)
      (if (>=
        (* macro-generated-fingerprint-cache-count 2)
        macro-generated-fingerprint-cache-capacity)
        unit
        (let
          [cursor : i64
            (macro-generated-fingerprint-cache-bucket module-id identity-id)]
          [module-key : i64 (+ module-id 1)]
          [identity-key : i64 (+ identity-id 1)]
          [stored : String (intern-persistent-copy value)]
          [steps : i64 0]
          [done : bool false]
          (begin
            (while (if done
              false
              (< steps macro-generated-fingerprint-cache-capacity))
              (let
                [slot : i64
                  (array.array-ref
                    macro-generated-fingerprint-cache-module-keys
                    cursor)]
                (if (= slot 0)
                  (begin
                    (array.array-set!
                      macro-generated-fingerprint-cache-module-keys
                      cursor
                      module-key)
                    (array.array-set!
                      macro-generated-fingerprint-cache-identity-keys
                      cursor
                      identity-key)
                    (array.array-set!
                      macro-generated-fingerprint-cache-values
                      cursor
                      stored)
                    (set!
                      macro-generated-fingerprint-cache-count
                      (+ macro-generated-fingerprint-cache-count 1))
                    (set! done true))
                  (if (and
                    (= slot module-key)
                    (=
                      (array.array-ref
                        macro-generated-fingerprint-cache-identity-keys
                        cursor)
                      identity-key))
                    (begin
                      (array.array-set!
                        macro-generated-fingerprint-cache-values
                        cursor
                        stored)
                      (set! done true))
                    (begin
                      (set!
                        cursor
                        (bit-and
                          (+ cursor 1)
                          (- macro-generated-fingerprint-cache-capacity 1)))
                      (set! steps (+ steps 1)))))))
            unit))))))

(define (macro-generated-fingerprint-join
  [tag : String]
  [left : String]
  [right : String]) : String
  (str_cat.str-cat tag ":" (spec-string-key left) ":" (spec-string-key right)))

(define (macro-generated-fingerprint-join3
  [tag : String]
  [a : String]
  [b : String]
  [c : String]) : String
  (str_cat.str-cat
    tag
    ":"
    (spec-string-key a)
    ":"
    (spec-string-key b)
    ":"
    (spec-string-key c)))

(define (macro-generated-fingerprint-bool [value : bool]) : String
  (if value
    "1"
    "0"))

(define (macro-generated-fingerprint-maybe-type [ty : AstMaybeType]) : String
  (match ty
    [(AstNoType) "type:none"]
    [(AstSomeType actual)
      (macro-generated-fingerprint-join "type:some" (spec-type-key actual) "")]))

(define (macro-generated-fingerprint-lifetimes [items : AstLifetimeList]) : String
  (spec-lifetime-list-key items))

(define (macro-generated-fingerprint-param [param : AstParam]) : String
  (match param
    [(AstParam name ty comptime?)
      (macro-generated-fingerprint-join3
        "param"
        (intern-str name)
        (spec-type-key ty)
        (macro-generated-fingerprint-bool comptime?))]))

(define (macro-generated-fingerprint-param-list [params : AstParamList]) : String
  (match params
    [(AstParamNil) "params:nil"]
    [(AstParamCons head rest)
      (macro-generated-fingerprint-join
        "params:cons"
        (macro-generated-fingerprint-param head)
        (macro-generated-fingerprint-param-list (box-get rest)))]))

(define (macro-generated-fingerprint-macro-param [param : AstMacroParam]) : String
  (match param
    [(AstMacroParam name ty variadic?)
      (macro-generated-fingerprint-join3
        "macro-param"
        (intern-str name)
        (spec-type-key ty)
        (macro-generated-fingerprint-bool variadic?))]))

(define (macro-generated-fingerprint-macro-param-list
  [params : AstMacroParamList]) : String
  (match params
    [(AstMacroParamNil) "macro-params:nil"]
    [(AstMacroParamCons head rest)
      (macro-generated-fingerprint-join
        "macro-params:cons"
        (macro-generated-fingerprint-macro-param head)
        (macro-generated-fingerprint-macro-param-list (box-get rest)))]))

(define (macro-generated-fingerprint-field-cleanup [cleanup : AstFieldCleanup]) : String
  (match cleanup
    [(AstFieldNoCleanup) "field-cleanup:none"]
    [(AstFieldCleanupFn name)
      (macro-generated-fingerprint-join "field-cleanup:fn" (intern-str name) "")]
    [(AstFieldOwnedCleanup) "field-cleanup:owned"]))

(define (macro-generated-fingerprint-field [field : AstFieldDef]) : String
  (match field
    [(AstFieldDef name ty cleanup)
      (macro-generated-fingerprint-join3
        "field"
        (intern-str name)
        (spec-type-key ty)
        (macro-generated-fingerprint-field-cleanup cleanup))]))

(define (macro-generated-fingerprint-field-list [fields : AstFieldDefList]) : String
  (match fields
    [(AstFieldDefNil) "fields:nil"]
    [(AstFieldDefCons head rest)
      (macro-generated-fingerprint-join
        "fields:cons"
        (macro-generated-fingerprint-field head)
        (macro-generated-fingerprint-field-list (box-get rest)))]))

(define (macro-generated-fingerprint-struct-repr [repr : AstStructRepr]) : String
  (match repr
    [(AstStructReprDefault) "repr:default"]
    [(AstStructReprC) "repr:c"]))

(define (macro-generated-fingerprint-struct-cleanup
  [cleanup : AstStructCleanup]) : String
  (match cleanup
    [(AstStructNoCleanup) "struct-cleanup:none"]
    [(AstStructCleanupFn name)
      (macro-generated-fingerprint-join
        "struct-cleanup:fn"
        (intern-str name)
        "")]))

(define (macro-generated-fingerprint-enum-cleanup [cleanup : AstEnumCleanup]) : String
  (match cleanup
    [(AstEnumNoCleanup) "enum-cleanup:none"]
    [(AstEnumCleanupFn name)
      (macro-generated-fingerprint-join "enum-cleanup:fn" (intern-str name) "")]))

(define (macro-generated-fingerprint-payload-cleanup
  [cleanup : AstVariantPayloadCleanup]) : String
  (match cleanup
    [(AstVariantPayloadNoCleanup) "payload-cleanup:none"]
    [(AstVariantPayloadCleanupFn name)
      (macro-generated-fingerprint-join
        "payload-cleanup:fn"
        (intern-str name)
        "")]
    [(AstVariantPayloadOwnedCleanup) "payload-cleanup:owned"]))

(define (macro-generated-fingerprint-payload-cleanup-list
  [cleanups : AstVariantPayloadCleanupList]) : String
  (match cleanups
    [(AstVariantPayloadCleanupNil) "payload-cleanups:nil"]
    [(AstVariantPayloadCleanupCons head rest)
      (macro-generated-fingerprint-join
        "payload-cleanups:cons"
        (macro-generated-fingerprint-payload-cleanup head)
        (macro-generated-fingerprint-payload-cleanup-list (box-get rest)))]))

(define (macro-generated-fingerprint-variant [variant : AstVariantDef]) : String
  (match variant
    [(AstVariantDef name payloads cleanups)
      (macro-generated-fingerprint-join3
        "variant"
        (intern-str name)
        (spec-type-list-key payloads)
        (macro-generated-fingerprint-payload-cleanup-list cleanups))]))

(define (macro-generated-fingerprint-variant-list
  [variants : AstVariantDefList]) : String
  (match variants
    [(AstVariantDefNil) "variants:nil"]
    [(AstVariantDefCons head rest)
      (macro-generated-fingerprint-join
        "variants:cons"
        (macro-generated-fingerprint-variant head)
        (macro-generated-fingerprint-variant-list (box-get rest)))]))

(define (macro-generated-fingerprint-fn-export [export : AstFnExport]) : String
  (match export
    [(AstFnNoExport) "export:none"]
    [(AstFnExport symbol)
      (macro-generated-fingerprint-join "export:symbol" (intern-str symbol) "")]))

(define macro-generated-fingerprint-sexpr-fuel : i64
  128)

;; Bound allocation before AST -> sexpr conversion; oversized generated bodies
;; use the structural fallback instead of materializing huge temporary syntax.
(define (macro-generated-fingerprint-budget-tick [fuel : i64]) : i64
  (if (<= fuel 0)
    -1
    (- fuel 1)))

(define (macro-generated-fingerprint-expr-id-budget
  [expr-id : i64]
  [fuel : i64]) : i64
  (macro-generated-fingerprint-expr-budget (ast-node-get expr-id) fuel))

(define (macro-generated-fingerprint-two-exprs-budget
  [first-id : i64]
  [second-id : i64]
  [fuel : i64]) : i64
  (let
    [remaining : i64 (macro-generated-fingerprint-expr-id-budget first-id fuel)]
    (if (< remaining 0)
      -1
      (macro-generated-fingerprint-expr-id-budget second-id remaining))))

(define (macro-generated-fingerprint-three-exprs-budget
  [first-id : i64]
  [second-id : i64]
  [third-id : i64]
  [fuel : i64]) : i64
  (let
    [remaining : i64
      (macro-generated-fingerprint-two-exprs-budget first-id second-id fuel)]
    (if (< remaining 0)
      -1
      (macro-generated-fingerprint-expr-id-budget third-id remaining))))

(define (macro-generated-fingerprint-expr-list-budget
  [exprs : AstExprList]
  [fuel : i64]) : i64
  (let
    [cur : AstExprList exprs]
    [remaining : i64 fuel]
    [done : bool false]
    [ok : bool true]
    (begin
      (while (if done
        false
        ok)
        (match cur
          [(AstExprNil) (set! done true)]
          [(AstExprCons head rest)
            (let
              [next-remaining : i64
                (macro-generated-fingerprint-expr-id-budget head remaining)]
              (if (< next-remaining 0)
                (set! ok false)
                (begin
                  (set! remaining next-remaining)
                  (set! cur (box-get rest)))))]))
      (if ok
        remaining
        -1))))

(define (macro-generated-fingerprint-let-binding-budget
  [binding : AstLetBinding]
  [fuel : i64]) : i64
  (match binding
    [(AstLetBinding _ _ value-id)
      (macro-generated-fingerprint-expr-id-budget value-id fuel)]))

(define (macro-generated-fingerprint-let-bindings-budget
  [bindings : AstLetBindingList]
  [fuel : i64]) : i64
  (let
    [cur : AstLetBindingList bindings]
    [remaining : i64 fuel]
    [done : bool false]
    [ok : bool true]
    (begin
      (while (if done
        false
        ok)
        (match cur
          [(AstLetBindingNil) (set! done true)]
          [(AstLetBindingCons head rest)
            (let
              [next-remaining : i64
                (macro-generated-fingerprint-let-binding-budget head remaining)]
              (if (< next-remaining 0)
                (set! ok false)
                (begin
                  (set! remaining next-remaining)
                  (set! cur (box-get rest)))))]))
      (if ok
        remaining
        -1))))

(define (macro-generated-fingerprint-expr-budget [expr : AstExpr] [fuel : i64]) : i64
  (let
    [next : i64 (macro-generated-fingerprint-budget-tick fuel)]
    (if (< next 0)
      -1
      (match expr
        [(AstExprSpanned inner-id _)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExprLiteral _) next]
        [(AstExprVar _) next]
        [(AstExprBinary _ left-id right-id)
          (macro-generated-fingerprint-two-exprs-budget left-id right-id next)]
        [(AstExprUnary _ inner-id)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExprCall func-id args)
          (let
            [remaining : i64
              (macro-generated-fingerprint-expr-id-budget func-id next)]
            (if (< remaining 0)
              -1
              (macro-generated-fingerprint-expr-list-budget args remaining)))]
        [(AstExprIf cond-id then-id else-id)
          (macro-generated-fingerprint-three-exprs-budget
            cond-id
            then-id
            else-id
            next)]
        [(AstExprLet let-box)
          (match (box-get let-box)
            [(AstLet bindings body-id)
              (let
                [remaining : i64
                  (macro-generated-fingerprint-let-bindings-budget
                    bindings
                    next)]
                (if (< remaining 0)
                  -1
                  (macro-generated-fingerprint-expr-id-budget body-id remaining)))])]
        [(AstExprTuple exprs)
          (macro-generated-fingerprint-expr-list-budget exprs next)]
        [(AstExprTupleRef tuple-id _)
          (macro-generated-fingerprint-expr-id-budget tuple-id next)]
        [(AstExprArray exprs)
          (macro-generated-fingerprint-expr-list-budget exprs next)]
        [(AstExprMakeArray _ len-id)
          (macro-generated-fingerprint-expr-id-budget len-id next)]
        [(AstExprArrayRef array-id index-id)
          (macro-generated-fingerprint-two-exprs-budget array-id index-id next)]
        [(AstExprArraySet array-id index-id value-id)
          (macro-generated-fingerprint-three-exprs-budget
            array-id
            index-id
            value-id
            next)]
        [(AstExprArrayPush array-id value-id)
          (macro-generated-fingerprint-two-exprs-budget array-id value-id next)]
        [(AstExprStringRef string-id index-id)
          (macro-generated-fingerprint-two-exprs-budget string-id index-id next)]
        [(AstExprWhile cond-id body-id)
          (macro-generated-fingerprint-two-exprs-budget cond-id body-id next)]
        [(AstExprBegin exprs)
          (macro-generated-fingerprint-expr-list-budget exprs next)]
        [(AstExprUnsafe exprs)
          (macro-generated-fingerprint-expr-list-budget exprs next)]
        [(AstExprSet _ value-id)
          (macro-generated-fingerprint-expr-id-budget value-id next)]
        [(AstExprAnn inner-id _)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExprCast inner-id _)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExprBorrow _ _ place-id)
          (macro-generated-fingerprint-expr-id-budget place-id next)]
        [(AstExprStructGet receiver-id _)
          (macro-generated-fingerprint-expr-id-budget receiver-id next)]
        [(AstExprStructSet receiver-id _ value-id)
          (macro-generated-fingerprint-two-exprs-budget
            receiver-id
            value-id
            next)]
        [(AstExprBox inner-id)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExprBoxGet inner-id)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExprBoxTake inner-id)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExprBoxSet receiver-id value-id)
          (macro-generated-fingerprint-two-exprs-budget
            receiver-id
            value-id
            next)]
        [(AstExprTypeLiteral _) next]
        [(AstExprInit _) next]
        [(AstExprQuote inner-id)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExprQuasiquote inner-id)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExprUnquote inner-id)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExprUnquoteSplicing inner-id)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExprBracketClause exprs)
          (macro-generated-fingerprint-expr-list-budget exprs next)]
        [(AstExprTry inner-id)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExprReturn inner-id)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [_ -1]))))

(define (macro-generated-fingerprint-sexpr [sexpr : SpannedSexpr] [fuel : i64]) : MacroGeneratedFingerprintKey
  (if (<= fuel 0)
    (MacroGeneratedFingerprintKey.TooLarge)
    (match sexpr
      [(SpannedSexpr.Int _ text _)
        (MacroGeneratedFingerprintKey.Key
          (str_cat.str-cat "int:" (spec-string-key text))
          (- fuel 1))]
      [(SpannedSexpr.Sym name _)
        (MacroGeneratedFingerprintKey.Key
          (str_cat.str-cat "sym:" (spec-string-key name))
          (- fuel 1))]
      [(SpannedSexpr.Nil _) (MacroGeneratedFingerprintKey.Key "nil" (- fuel 1))]
      [(SpannedSexpr.Cons head tail _)
        (match (macro-generated-fingerprint-sexpr (sp-node-get head) (- fuel 1))
          [(MacroGeneratedFingerprintKey.Key head-key head-fuel)
            (match (macro-generated-fingerprint-sexpr
              (sp-node-get tail)
              head-fuel)
              [(MacroGeneratedFingerprintKey.Key tail-key tail-fuel)
                (MacroGeneratedFingerprintKey.Key
                  (str_cat.str-cat
                    "cons:"
                    (spec-string-key head-key)
                    ":"
                    (spec-string-key tail-key))
                  tail-fuel)]
              [(MacroGeneratedFingerprintKey.TooLarge)
                (MacroGeneratedFingerprintKey.TooLarge)])]
          [(MacroGeneratedFingerprintKey.TooLarge)
            (MacroGeneratedFingerprintKey.TooLarge)])]
      [(SpannedSexpr.Str text _)
        (MacroGeneratedFingerprintKey.Key
          (str_cat.str-cat "str:" (spec-string-key text))
          (- fuel 1))]
      [(SpannedSexpr.Char c _)
        (MacroGeneratedFingerprintKey.Key
          (str_cat.str-cat "char:" (string.int->string (cast c : i64)))
          (- fuel 1))]
      [(SpannedSexpr.Float text _)
        (MacroGeneratedFingerprintKey.Key
          (str_cat.str-cat "float:" (spec-string-key text))
          (- fuel 1))]
      [(SpannedSexpr.BracketList items _)
        (match (macro-generated-fingerprint-sexpr
          (sp-node-get items)
          (- fuel 1))
          [(MacroGeneratedFingerprintKey.Key items-key items-fuel)
            (MacroGeneratedFingerprintKey.Key
              (str_cat.str-cat "bracket:" (spec-string-key items-key))
              items-fuel)]
          [(MacroGeneratedFingerprintKey.TooLarge)
            (MacroGeneratedFingerprintKey.TooLarge)])])))

(define (macro-generated-fingerprint-expr [expr : AstExpr]) : TcMaybeString
  (if (<
    (macro-generated-fingerprint-expr-budget
      expr
      macro-generated-fingerprint-sexpr-fuel)
    0)
    (TcNoString)
    (let
      [mark : i64 (sp-node-pool-len)]
      (match (macro-expr-to-spanned-sexpr expr expr)
        [(ResultMacroSexpr.Ok sexpr)
          (match (macro-generated-fingerprint-sexpr
            sexpr
            macro-generated-fingerprint-sexpr-fuel)
            [(MacroGeneratedFingerprintKey.Key key _)
              (begin
                (sp-node-pool-truncate! mark)
                (TcSomeString key))]
            [(MacroGeneratedFingerprintKey.TooLarge)
              (begin
                (sp-node-pool-truncate! mark)
                (TcNoString))])]
        [(ResultMacroSexpr.Err _)
          (begin
            (sp-node-pool-truncate! mark)
            (TcNoString))]))))

(define (macro-generated-fingerprint-decl [decl : AstDecl]) : TcMaybeString
  (match decl
    [(AstDeclModule name)
      (TcSomeString
        (macro-generated-fingerprint-join "decl:module" (intern-str name) ""))]
    [(AstDeclDef name ty value-box)
      (match (macro-generated-fingerprint-expr (ast-node-get value-box))
        [(TcSomeString value-key)
          (TcSomeString
            (macro-generated-fingerprint-join3
              "decl:def"
              (intern-str name)
              (macro-generated-fingerprint-maybe-type ty)
              value-key))]
        [(TcNoString) (TcNoString)])]
    [(AstDeclDefFn name params ret body-box export)
      (match (macro-generated-fingerprint-expr (ast-node-get body-box))
        [(TcSomeString body-key)
          (TcSomeString
            (macro-generated-fingerprint-join3
              "decl:fn"
              (intern-str name)
              (macro-generated-fingerprint-param-list params)
              (macro-generated-fingerprint-join3
                "fn-tail"
                (spec-type-key ret)
                body-key
                (macro-generated-fingerprint-fn-export export))))]
        [(TcNoString) (TcNoString)])]
    [(AstDeclDefEnum name cleanup variants)
      (TcSomeString
        (macro-generated-fingerprint-join3
          "decl:enum"
          (intern-str name)
          (macro-generated-fingerprint-enum-cleanup cleanup)
          (macro-generated-fingerprint-variant-list variants)))]
    [(AstDeclDefEnumLifetimes name lifetimes cleanup variants)
      (TcSomeString
        (macro-generated-fingerprint-join3
          "decl:enum-lifetimes"
          (intern-str name)
          (macro-generated-fingerprint-lifetimes lifetimes)
          (macro-generated-fingerprint-join
            "enum-tail"
            (macro-generated-fingerprint-enum-cleanup cleanup)
            (macro-generated-fingerprint-variant-list variants))))]
    [(AstDeclDefStruct name repr cleanup fields)
      (TcSomeString
        (macro-generated-fingerprint-join3
          "decl:struct"
          (intern-str name)
          (macro-generated-fingerprint-struct-repr repr)
          (macro-generated-fingerprint-join
            "struct-tail"
            (macro-generated-fingerprint-struct-cleanup cleanup)
            (macro-generated-fingerprint-field-list fields))))]
    [(AstDeclDefStructLifetimes name lifetimes repr cleanup fields)
      (TcSomeString
        (macro-generated-fingerprint-join3
          "decl:struct-lifetimes"
          (intern-str name)
          (macro-generated-fingerprint-lifetimes lifetimes)
          (macro-generated-fingerprint-join3
            "struct-tail"
            (macro-generated-fingerprint-struct-repr repr)
            (macro-generated-fingerprint-struct-cleanup cleanup)
            (macro-generated-fingerprint-field-list fields))))]
    [(AstDeclDefMacro name params ret body-box)
      (match (macro-generated-fingerprint-expr (ast-node-get body-box))
        [(TcSomeString body-key)
          (TcSomeString
            (macro-generated-fingerprint-join3
              "decl:macro"
              (intern-str name)
              (macro-generated-fingerprint-macro-param-list params)
              (macro-generated-fingerprint-join
                "macro-tail"
                (spec-type-key ret)
                body-key)))]
        [(TcNoString) (TcNoString)])]
    [(AstDeclIncludeStr name path)
      (TcSomeString
        (macro-generated-fingerprint-join "decl:include-str" name path))]
    [(AstDeclIncludeBin name path)
      (TcSomeString
        (macro-generated-fingerprint-join "decl:include-bin" name path))]
    [(AstDeclTest name body-box _)
      (match (macro-generated-fingerprint-expr (ast-node-get body-box))
        [(TcSomeString body-key)
          (TcSomeString
            (macro-generated-fingerprint-join
              "decl:test"
              (intern-str name)
              body-key))]
        [(TcNoString) (TcNoString)])]
    [(AstDeclUnsafe inner-box)
      (macro-generated-fingerprint-decl (box-get inner-box))]
    [(AstDeclComptimeDecl _ inner-box)
      (macro-generated-fingerprint-decl (box-get inner-box))]
    [_ (TcNoString)]))

(define (macro-generated-fingerprint-decl-list [decls : AstDeclList]) : TcMaybeString
  (match decls
    [(AstDeclNil) (TcSomeString "decls:nil")]
    [(AstDeclCons decl rest)
      (match (macro-generated-fingerprint-decl decl)
        [(TcSomeString head-key)
          (match (macro-generated-fingerprint-decl-list (box-get rest))
            [(TcSomeString rest-key)
              (TcSomeString
                (macro-generated-fingerprint-join
                  "decls:cons"
                  head-key
                  rest-key))]
            [(TcNoString) (TcNoString)])]
        [(TcNoString) (TcNoString)])]))

(define (macro-generated-key-body-for-compare
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [target-module : String]
  [decl-path : String]
  [identity : String]
  [body : AstDeclList]
  [fuel : i64]) : AstDeclList
  (begin
    (cfg
      compile-profile
      (compiler-tc-macro-profile-note-generated-compare-pass))
    (if (<= fuel 0)
      (macro-decls-filter-generated-key body identity)
      (match (macro-expand-decls
        ctx
        top-env
        orig-decls
        body
        (macro-paths-for-decls body decl-path)
        target-module
        false)
        [(ResultMacroDeclsWithPaths.Ok expanded _ followup-work)
          (if (not (macro-followup-work-list-empty? followup-work))
            (macro-generated-key-body-for-compare
              ctx
              top-env
              orig-decls
              target-module
              decl-path
              identity
              expanded
              (- fuel 1))
            (macro-decls-filter-generated-key expanded identity))]
        [(ResultMacroDeclsWithPaths.Err _)
          (macro-decls-filter-generated-key body identity)]))))

(define (macro-generated-key-body-normalized-fingerprint
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [target-module : String]
  [decl-path : String]
  [identity : String]
  [body : AstDeclList]) : TcMaybeString
  (macro-generated-fingerprint-decl-list
    (macro-generated-key-body-for-compare
      ctx
      top-env
      orig-decls
      target-module
      decl-path
      identity
      body
      (macro-expand-fixed-point-limit))))

(define (macro-generated-key-body-cached-existing-fingerprint
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [target-module : String]
  [decl-path : String]
  [identity : String]
  [body : AstDeclList]) : TcMaybeString
  (match (macro-generated-fingerprint-cache-get target-module identity)
    [(MacroGeneratedFingerprintCacheLookup.Hit fingerprint)
      (begin
        (cfg
          compile-profile
          (compiler-tc-macro-profile-note-generated-fingerprint-cache-hit))
        (TcSomeString fingerprint))]
    [(MacroGeneratedFingerprintCacheLookup.TooLarge)
      (begin
        (cfg
          compile-profile
          (compiler-tc-macro-profile-note-generated-fingerprint-cache-hit))
        (TcNoString))]
    [(MacroGeneratedFingerprintCacheLookup.Miss)
      (begin
        (cfg
          compile-profile
          (compiler-tc-macro-profile-note-generated-fingerprint-cache-miss))
        (match (macro-generated-key-body-normalized-fingerprint
          ctx
          top-env
          orig-decls
          target-module
          decl-path
          identity
          body)
          [(TcSomeString fingerprint)
            (begin
              (macro-generated-fingerprint-cache-put!
                target-module
                identity
                fingerprint)
              (TcSomeString fingerprint))]
          [(TcNoString)
            (begin
              (macro-generated-fingerprint-cache-put!
                target-module
                identity
                macro-generated-fingerprint-cache-too-large-value)
              (TcNoString))]))]))

(define (macro-generated-key-body-normalized-structural-eq?
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [target-module : String]
  [decl-path : String]
  [identity : String]
  [existing-body : AstDeclList]
  [generated-body : AstDeclList]) : bool
  (let
    [compare-existing-body : AstDeclList
      (macro-generated-key-body-for-compare
        ctx
        top-env
        orig-decls
        target-module
        decl-path
        identity
        existing-body
        (macro-expand-fixed-point-limit))]
    [compare-generated-body : AstDeclList
      (macro-generated-key-body-for-compare
        ctx
        top-env
        orig-decls
        target-module
        decl-path
        identity
        generated-body
        (macro-expand-fixed-point-limit))]
    (macro-decl-list-structural-eq?
      compare-existing-body
      compare-generated-body)))

(define (macro-generated-key-body-replay-compatible?
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [target-module : String]
  [decl-path : String]
  [identity : String]
  [existing-body : AstDeclList]
  [generated-body : AstDeclList]) : bool
  (match (macro-generated-key-body-cached-existing-fingerprint
    ctx
    top-env
    orig-decls
    target-module
    decl-path
    identity
    existing-body)
    [(TcSomeString existing-fingerprint)
      (match (macro-generated-key-body-normalized-fingerprint
        ctx
        top-env
        orig-decls
        target-module
        decl-path
        identity
        generated-body)
        [(TcSomeString generated-fingerprint)
          (if (string.string-eq existing-fingerprint generated-fingerprint)
            (macro-generated-key-body-normalized-structural-eq?
              ctx
              top-env
              orig-decls
              target-module
              decl-path
              identity
              existing-body
              generated-body)
            false)]
        [(TcNoString)
          (macro-generated-key-body-normalized-structural-eq?
            ctx
            top-env
            orig-decls
            target-module
            decl-path
            identity
            existing-body
            generated-body)])]
    [(TcNoString)
      (macro-generated-key-body-normalized-structural-eq?
        ctx
        top-env
        orig-decls
        target-module
        decl-path
        identity
        existing-body
        generated-body)]))

(define (macro-module-exists? [decls : AstDeclList] [target-module : String]) : bool
  (match decls
    [(AstDeclNil) false]
    [(AstDeclCons decl rest)
      (match decl
        [(AstDeclModule module-name)
          (if (string.string-eq (intern-str module-name) target-module)
            true
            (macro-module-exists? (box-get rest) target-module))]
        [_ (macro-module-exists? (box-get rest) target-module)])]))

(define (macro-collect-module-body-decls
  [decls : AstDeclList]
  [target-module : String]
  [current-module : String]) : AstDeclList
  (match decls
    [(AstDeclNil) AstDeclNil]
    [(AstDeclCons decl rest)
      (match decl
        [(AstDeclModule module-name)
          (macro-collect-module-body-decls
            (box-get rest)
            target-module
            (intern-str module-name))]
        [_
          (let
            [collected-rest : AstDeclList
              (macro-collect-module-body-decls
                (box-get rest)
                target-module
                current-module)]
            (if (string.string-eq current-module target-module)
              (ast-decl-cons decl collected-rest)
              collected-rest))])]))

(define (macro-find-module-body-decls
  [decls : AstDeclList]
  [target-module : String]) : MacroMaybeDeclList
  (if (macro-module-exists? decls target-module)
    (MacroMaybeDeclList.Some
      (macro-collect-module-body-decls decls target-module ""))
    (MacroMaybeDeclList.No)))

(define (macro-expr-list-with-head-symbol
  [name : String]
  [exprs : AstExprList]
  [span : SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match (macro-expr-list-to-spanned-sexpr exprs span origin)
    [(ResultMacroSexpr.Ok tail)
      (ResultMacroSexpr.Ok
        (spanned-sexpr-cons (SpannedSexpr.Sym name span) tail span))]
    [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)]))

;; Serialize a child expression node (referenced by node-pool id) back to a
;; spanned sexpr. Used by the declaration-emitting macro output serializer to
;; rebuild non-trivial function bodies (arithmetic, struct/array access, let,
;; while, set!, ...) that the quasiquote evaluator stores as typed AST nodes.
(define (macro-child-to-spanned-sexpr
  [id : i64]
  [span : SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (macro-expr-to-spanned-sexpr-with-span (ast-node-get id) span origin))

(define (macro-form1 [name : String] [a : SpannedSexpr] [span : SourceSpan]) : SpannedSexpr
  (spanned-sexpr-cons
    (SpannedSexpr.Sym name span)
    (spanned-sexpr-cons a (SpannedSexpr.Nil span) span)
    span))

(define (macro-form2
  [name : String]
  [a : SpannedSexpr]
  [b : SpannedSexpr]
  [span : SourceSpan]) : SpannedSexpr
  (spanned-sexpr-cons
    (SpannedSexpr.Sym name span)
    (spanned-sexpr-cons
      a
      (spanned-sexpr-cons b (SpannedSexpr.Nil span) span)
      span)
    span))

(define (macro-form3
  [name : String]
  [a : SpannedSexpr]
  [b : SpannedSexpr]
  [c : SpannedSexpr]
  [span : SourceSpan]) : SpannedSexpr
  (spanned-sexpr-cons
    (SpannedSexpr.Sym name span)
    (spanned-sexpr-cons
      a
      (spanned-sexpr-cons
        b
        (spanned-sexpr-cons c (SpannedSexpr.Nil span) span)
        span)
      span)
    span))

(define (macro-binop-symbol [op : AstBinOp]) : String
  (match op
    [(AstBinAdd) "+"]
    [(AstBinSub) "-"]
    [(AstBinMul) "*"]
    [(AstBinDiv) "/"]
    [(AstBinMod) "%"]
    [(AstBinEq) "="]
    [(AstBinNe) "!="]
    [(AstBinLt) "<"]
    [(AstBinLe) "<="]
    [(AstBinGt) ">"]
    [(AstBinGe) ">="]
    [(AstBinAnd) "and"]
    [(AstBinOr) "or"]
    [(AstBinBitAnd) "bit-and"]
    [(AstBinBitOr) "bit-or"]
    [(AstBinBitXor) "bit-xor"]
    [(AstBinShl) "shl"]
    [(AstBinShr) "shr"]))

(define (macro-unop-symbol [op : AstUnOp]) : String
  (match op
    [(AstUnNeg) "-"]
    [(AstUnNot) "not"]
    [(AstUnBitNot) "bit-not"]))

(define (macro-lifetime-list-to-spanned-sexpr
  [items : AstLifetimeList]
  [span : SourceSpan]) : SpannedSexpr
  (match items
    [(AstLifetimeNil) (SpannedSexpr.Nil span)]
    [(AstLifetimeCons name rest)
      (spanned-sexpr-cons
        (SpannedSexpr.Sym name span)
        (macro-lifetime-list-to-spanned-sexpr (box-get rest) span)
        span)]))

(define (macro-internal-resolved-struct-type-marker) : String
  "__typelisp internal resolved struct type")

(define (macro-internal-resolved-enum-type-marker) : String
  "__typelisp internal resolved enum type")

(define (macro-resolved-nominal-type-sexpr
  [marker : String]
  [name : String]
  [lifetimes : AstLifetimeList]
  [span : SourceSpan]) : SpannedSexpr
  (spanned-sexpr-cons
    (SpannedSexpr.Sym marker span)
    (spanned-sexpr-cons
      (SpannedSexpr.Str name span)
      (macro-lifetime-list-to-spanned-sexpr lifetimes span)
      span)
    span))

(define (macro-type-list-to-spanned-sexpr
  [items : AstTypeList]
  [span : SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match items
    [(AstTypeNil) (ResultMacroSexpr.Ok (SpannedSexpr.Nil span))]
    [(AstTypeCons head-id rest)
      (match (macro-type-to-spanned-sexpr (ty-node-get head-id) span origin)
        [(ResultMacroSexpr.Ok shead)
          (match (macro-type-list-to-spanned-sexpr (box-get rest) span origin)
            [(ResultMacroSexpr.Ok stail)
              (ResultMacroSexpr.Ok (spanned-sexpr-cons shead stail span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]))

(define (macro-type-unary-sexpr
  [name : String]
  [inner-id : i64]
  [span : SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match (macro-type-to-spanned-sexpr (ty-node-get inner-id) span origin)
    [(ResultMacroSexpr.Ok sinner)
      (ResultMacroSexpr.Ok (macro-form1 name sinner span))]
    [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)]))

(define (macro-type-named-args-sexpr
  [name : String]
  [lifetimes : AstLifetimeList]
  [span : SourceSpan]) : ResultMacroSexpr
  (ResultMacroSexpr.Ok
    (spanned-sexpr-cons
      (SpannedSexpr.Sym name span)
      (macro-lifetime-list-to-spanned-sexpr lifetimes span)
      span)))

;; Serialize an AstType back to a spanned sexpr so type positions embedded in
;; expression nodes (array.make-array, cast, ann, typed let bindings) round-trip.
(define (macro-type-to-spanned-sexpr
  [ty : AstType]
  [span : SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match ty
    [(AstTyI64) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "i64" span))]
    [(AstTyI32) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "i32" span))]
    [(AstTyI16) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "i16" span))]
    [(AstTyI8) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "i8" span))]
    [(AstTyU64) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "u64" span))]
    [(AstTyU32) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "u32" span))]
    [(AstTyU16) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "u16" span))]
    [(AstTyU8) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "u8" span))]
    [(AstTyF64) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "f64" span))]
    [(AstTyF32) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "f32" span))]
    [(AstTyBool) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "bool" span))]
    [(AstTyChar) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "char" span))]
    [(AstTyString) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "String" span))]
    [(AstTyStr) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "str" span))]
    [(AstTyBytes) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "bytes" span))]
    [(AstTyUnit) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "unit" span))]
    [(AstTyNever) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "never" span))]
    [(AstTyExpr) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "Expr" span))]
    [(AstTyExprList) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "ExprList" span))]
    [(AstTyDynArray elem) (macro-type-unary-sexpr "Array" elem span origin)]
    [(AstTyArray elem count)
      (match (macro-type-to-spanned-sexpr (ty-node-get elem) span origin)
        [(ResultMacroSexpr.Ok selem)
          (ResultMacroSexpr.Ok
            (macro-form2
              "Array"
              selem
              (SpannedSexpr.Int count (string.int->string count) span)
              span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstTyBox inner) (macro-type-unary-sexpr "Box" inner span origin)]
    [(AstTyPtr inner) (macro-type-unary-sexpr "Ptr" inner span origin)]
    [(AstTyMutPtr inner) (macro-type-unary-sexpr "MutPtr" inner span origin)]
    [(AstTyTuple items)
      (match (macro-type-list-to-spanned-sexpr (box-get items) span origin)
        [(ResultMacroSexpr.Ok stail)
          (ResultMacroSexpr.Ok
            (spanned-sexpr-cons (SpannedSexpr.Sym "Tuple" span) stail span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstTyFunc args ret)
      (match (macro-type-list-to-spanned-sexpr (box-get args) span origin)
        [(ResultMacroSexpr.Ok sargs)
          (match (macro-type-to-spanned-sexpr (ty-node-get ret) span origin)
            [(ResultMacroSexpr.Ok sret)
              (ResultMacroSexpr.Ok
                (spanned-sexpr-cons
                  (SpannedSexpr.Sym "->" span)
                  (macro-spanned-sexpr-append
                    sargs
                    (spanned-sexpr-cons sret (SpannedSexpr.Nil span) span)
                    span)
                  span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstTyStruct name)
      (ResultMacroSexpr.Ok
        (macro-resolved-nominal-type-sexpr
          (macro-internal-resolved-struct-type-marker)
          (intern-str name)
          AstLifetimeNil
          span))]
    [(AstTyEnum name)
      (ResultMacroSexpr.Ok
        (macro-resolved-nominal-type-sexpr
          (macro-internal-resolved-enum-type-marker)
          (intern-str name)
          AstLifetimeNil
          span))]
    [(AstTyVar name)
      (ResultMacroSexpr.Ok
        (SpannedSexpr.Sym (macro-output-source-name (intern-str name)) span))]
    [(AstTyStructArgs name lifetimes)
      (ResultMacroSexpr.Ok
        (macro-resolved-nominal-type-sexpr
          (macro-internal-resolved-struct-type-marker)
          (intern-str name)
          (box-get lifetimes)
          span))]
    [(AstTyEnumArgs name lifetimes)
      (ResultMacroSexpr.Ok
        (macro-resolved-nominal-type-sexpr
          (macro-internal-resolved-enum-type-marker)
          (intern-str name)
          (box-get lifetimes)
          span))]
    [(AstTyVarArgs name lifetimes)
      (macro-type-named-args-sexpr
        (macro-output-source-name (intern-str name))
        (box-get lifetimes)
        span)]
    [(AstTyRef region inner)
      (match (macro-type-to-spanned-sexpr (ty-node-get inner) span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok
            (if (= (string.string-length region) 0)
              (macro-form1 "&" sinner span)
              (macro-form2 "&" (SpannedSexpr.Sym region span) sinner span)))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstTyMutRef region inner)
      (match (macro-type-to-spanned-sexpr (ty-node-get inner) span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok
            (if (= (string.string-length region) 0)
              (macro-form1 "&mut" sinner span)
              (macro-form2 "&mut" (SpannedSexpr.Sym region span) sinner span)))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstTyRegion region inner)
      (match (macro-type-to-spanned-sexpr (ty-node-get inner) span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok
            (macro-form2 "in" (SpannedSexpr.Sym region span) sinner span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]))

(define (macro-spanned-sexpr-append
  [left : SpannedSexpr]
  [right : SpannedSexpr]
  [span : SourceSpan]) : SpannedSexpr
  (match left
    [(SpannedSexpr.Cons head tail _)
      (spanned-sexpr-cons
        (sp-node-get head)
        (macro-spanned-sexpr-append (sp-node-get tail) right span)
        span)]
    [_ right]))

(define (macro-literal-to-spanned-sexpr [lit : AstLiteral] [span : SourceSpan]) : SpannedSexpr
  (match lit
    [(AstLitInt n text) (SpannedSexpr.Int n text span)]
    [(AstLitFloat text) (SpannedSexpr.Float text span)]
    [(AstLitBool value)
      (SpannedSexpr.Sym
        (if value
          "true"
          "false")
        span)]
    [(AstLitChar c) (SpannedSexpr.Char c span)]
    [(AstLitString text) (SpannedSexpr.Str text span)]
    [(AstLitUnit) (SpannedSexpr.Sym "unit" span)]))

(define (macro-pattern-list-to-spanned-sexpr
  [patterns : AstPatternList]
  [span : SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match patterns
    [(AstPatternNil) (ResultMacroSexpr.Ok (SpannedSexpr.Nil span))]
    [(AstPatternCons head rest)
      (match (macro-pattern-to-spanned-sexpr (box-get head) span origin)
        [(ResultMacroSexpr.Ok shead)
          (match (macro-pattern-list-to-spanned-sexpr
            (box-get rest)
            span
            origin)
            [(ResultMacroSexpr.Ok stail)
              (ResultMacroSexpr.Ok (spanned-sexpr-cons shead stail span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]))

(define (macro-pattern-to-spanned-sexpr
  [pattern : AstPattern]
  [span : SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match pattern
    [(AstPatBinding name)
      (ResultMacroSexpr.Ok
        (SpannedSexpr.Sym (macro-output-syntax-name (intern-str name)) span))]
    [(AstPatWildcard) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "_" span))]
    [(AstPatLiteral lit)
      (ResultMacroSexpr.Ok (macro-literal-to-spanned-sexpr lit span))]
    [(AstPatVariant name args-box)
      (match (macro-pattern-list-to-spanned-sexpr
        (box-get args-box)
        span
        origin)
        [(ResultMacroSexpr.Ok args)
          (ResultMacroSexpr.Ok
            (spanned-sexpr-cons
              (SpannedSexpr.Sym
                (macro-output-syntax-name (intern-str name))
                span)
              args
              span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstPatTuple _)
      (ResultMacroSexpr.Err
        (box
          (macro-output-syntax-diag
            origin
            "typecheck: module macro output tuple patterns cannot be parsed as source declarations")))]
    [(AstPatVar _ _)
      (ResultMacroSexpr.Err
        (box
          (macro-output-syntax-diag
            origin
            "typecheck: module macro output typed patterns cannot be parsed as source declarations")))]))

(define (macro-match-arm-bracket
  [arm : AstMatchArm]
  [span : SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match arm
    [(AstMatchArm pattern body-id)
      (match (macro-pattern-to-spanned-sexpr pattern span origin)
        [(ResultMacroSexpr.Ok spattern)
          (match (macro-child-to-spanned-sexpr body-id span origin)
            [(ResultMacroSexpr.Ok sbody)
              (ResultMacroSexpr.Ok
                (spanned-sexpr-bracket-list
                  (spanned-sexpr-cons
                    spattern
                    (spanned-sexpr-cons sbody (SpannedSexpr.Nil span) span)
                    span)
                  span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]))

(define (macro-match-arm-list-to-spanned-sexpr
  [arms : AstMatchArmList]
  [span : SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match arms
    [(AstMatchArmNil) (ResultMacroSexpr.Ok (SpannedSexpr.Nil span))]
    [(AstMatchArmCons head rest)
      (match (macro-match-arm-bracket head span origin)
        [(ResultMacroSexpr.Ok shead)
          (match (macro-match-arm-list-to-spanned-sexpr
            (box-get rest)
            span
            origin)
            [(ResultMacroSexpr.Ok stail)
              (ResultMacroSexpr.Ok (spanned-sexpr-cons shead stail span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]))

(define (macro-let-binding-bracket
  [binding : AstLetBinding]
  [span : SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match binding
    [(AstLetBinding name maybe-ty value-id)
      (match (macro-child-to-spanned-sexpr value-id span origin)
        [(ResultMacroSexpr.Ok svalue)
          (match maybe-ty
            [(AstNoType)
              (ResultMacroSexpr.Ok
                (spanned-sexpr-bracket-list
                  (spanned-sexpr-cons
                    (SpannedSexpr.Sym
                      (macro-output-syntax-name (intern-str name))
                      span)
                    (spanned-sexpr-cons svalue (SpannedSexpr.Nil span) span)
                    span)
                  span))]
            [(AstSomeType ty)
              (match (macro-type-to-spanned-sexpr ty span origin)
                [(ResultMacroSexpr.Ok sty)
                  (ResultMacroSexpr.Ok
                    (spanned-sexpr-bracket-list
                      (spanned-sexpr-cons
                        (SpannedSexpr.Sym
                          (macro-output-syntax-name (intern-str name))
                          span)
                        (spanned-sexpr-cons
                          (SpannedSexpr.Sym ":" span)
                          (spanned-sexpr-cons
                            sty
                            (spanned-sexpr-cons
                              svalue
                              (SpannedSexpr.Nil span)
                              span)
                            span)
                          span)
                        span)
                      span))]
                [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]))

(define (macro-let-tail
  [bindings : AstLetBindingList]
  [body : SpannedSexpr]
  [span : SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match bindings
    [(AstLetBindingNil)
      (ResultMacroSexpr.Ok
        (spanned-sexpr-cons body (SpannedSexpr.Nil span) span))]
    [(AstLetBindingCons head rest)
      (match (macro-let-binding-bracket head span origin)
        [(ResultMacroSexpr.Ok sbracket)
          (match (macro-let-tail (box-get rest) body span origin)
            [(ResultMacroSexpr.Ok stail)
              (ResultMacroSexpr.Ok (spanned-sexpr-cons sbracket stail span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]))

(define (macro-expr-list-to-spanned-sexpr
  [exprs : AstExprList]
  [span : SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match exprs
    [(AstExprNil) (ResultMacroSexpr.Ok (SpannedSexpr.Nil span))]
    [(AstExprCons head rest)
      (let
        [head-expr : AstExpr (ast-node-get head)]
        [rest : AstExprList (box-get rest)]
        (match (macro-expr-to-spanned-sexpr-with-span head-expr span origin)
          [(ResultMacroSexpr.Ok shead)
            (match (macro-expr-list-to-spanned-sexpr rest span origin)
              [(ResultMacroSexpr.Ok stail)
                (ResultMacroSexpr.Ok (spanned-sexpr-cons shead stail span))]
              [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
          [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)]))]))

(define (macro-expr-to-spanned-sexpr-with-span
  [expr : AstExpr]
  [span : SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match expr
    [(AstExprSpanned inner-box ast-span)
      (macro-expr-to-spanned-sexpr-with-span
        (ast-node-get inner-box)
        (macro-source-span-from-ast ast-span)
        origin)]
    [(AstExprLiteral lit)
      (match lit
        [(AstLitInt n text)
          (ResultMacroSexpr.Ok (SpannedSexpr.Int n text span))]
        [(AstLitFloat text)
          (ResultMacroSexpr.Ok (SpannedSexpr.Float text span))]
        [(AstLitBool value)
          (ResultMacroSexpr.Ok
            (SpannedSexpr.Sym
              (if value
                "true"
                "false")
              span))]
        [(AstLitChar c) (ResultMacroSexpr.Ok (SpannedSexpr.Char c span))]
        [(AstLitString text) (ResultMacroSexpr.Ok (SpannedSexpr.Str text span))]
        [(AstLitUnit) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "unit" span))])]
    [(AstExprVar name)
      (ResultMacroSexpr.Ok
        (SpannedSexpr.Sym (macro-output-syntax-name (intern-str name)) span))]
    [(AstExprCall func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (match (macro-expr-to-spanned-sexpr-with-span func span origin)
          [(ResultMacroSexpr.Ok head)
            (match (macro-expr-list-to-spanned-sexpr args span origin)
              [(ResultMacroSexpr.Ok tail)
                (ResultMacroSexpr.Ok (spanned-sexpr-cons head tail span))]
              [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
          [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)]))]
    [(AstExprBracketClause items)
      (match (macro-expr-list-to-spanned-sexpr items span origin)
        [(ResultMacroSexpr.Ok list)
          (ResultMacroSexpr.Ok (spanned-sexpr-bracket-list list span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExprIf cond-box then-box else-box)
      (macro-expr-list-with-head-symbol
        "if"
        (ast-expr-cons
          cond-box
          (ast-expr-cons then-box (ast-expr-cons else-box AstExprNil)))
        span
        origin)]
    [(AstExprBegin exprs)
      (macro-expr-list-with-head-symbol "begin" exprs span origin)]
    [(AstExprUnsafe exprs)
      (macro-expr-list-with-head-symbol "unsafe" exprs span origin)]
    [(AstExprTuple exprs)
      (macro-expr-list-with-head-symbol "tuple" exprs span origin)]
    [(AstExprArray exprs)
      (macro-expr-list-with-head-symbol "array" exprs span origin)]
    [(AstExprQuote inner-box)
      (macro-expr-list-with-head-symbol
        "quote"
        (ast-expr-cons inner-box AstExprNil)
        span
        origin)]
    [(AstExprQuasiquote inner-box)
      (macro-expr-list-with-head-symbol
        "quasiquote"
        (ast-expr-cons inner-box AstExprNil)
        span
        origin)]
    [(AstExprUnquote inner-box)
      (macro-expr-list-with-head-symbol
        "unquote"
        (ast-expr-cons inner-box AstExprNil)
        span
        origin)]
    [(AstExprUnquoteSplicing inner-box)
      (macro-expr-list-with-head-symbol
        "unquote-splicing"
        (ast-expr-cons inner-box AstExprNil)
        span
        origin)]
    [(AstExprBinary op left-id right-id)
      (match (macro-child-to-spanned-sexpr left-id span origin)
        [(ResultMacroSexpr.Ok sleft)
          (match (macro-child-to-spanned-sexpr right-id span origin)
            [(ResultMacroSexpr.Ok sright)
              (ResultMacroSexpr.Ok
                (macro-form2 (macro-binop-symbol op) sleft sright span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExprUnary op inner-id)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok (macro-form1 (macro-unop-symbol op) sinner span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body-id)
          (match (macro-child-to-spanned-sexpr body-id span origin)
            [(ResultMacroSexpr.Ok sbody)
              (match (macro-let-tail bindings sbody span origin)
                [(ResultMacroSexpr.Ok stail)
                  (ResultMacroSexpr.Ok
                    (spanned-sexpr-cons
                      (SpannedSexpr.Sym "let" span)
                      stail
                      span))]
                [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])])]
    [(AstExprWhile cond-id body-id)
      (match (macro-child-to-spanned-sexpr cond-id span origin)
        [(ResultMacroSexpr.Ok scond)
          (match (macro-child-to-spanned-sexpr body-id span origin)
            [(ResultMacroSexpr.Ok sbody)
              (ResultMacroSexpr.Ok (macro-form2 "while" scond sbody span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExprMatch match-box)
      (match (box-get match-box)
        [(AstMatch scrutinee-id arms)
          (match (macro-child-to-spanned-sexpr scrutinee-id span origin)
            [(ResultMacroSexpr.Ok sscrutinee)
              (match (macro-match-arm-list-to-spanned-sexpr arms span origin)
                [(ResultMacroSexpr.Ok sarms)
                  (ResultMacroSexpr.Ok
                    (spanned-sexpr-cons
                      (SpannedSexpr.Sym "match" span)
                      (spanned-sexpr-cons sscrutinee sarms span)
                      span))]
                [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])])]
    [(AstExprSet name value-id)
      (match (macro-child-to-spanned-sexpr value-id span origin)
        [(ResultMacroSexpr.Ok svalue)
          (ResultMacroSexpr.Ok
            (macro-form2
              "set!"
              (SpannedSexpr.Sym
                (macro-output-syntax-name (intern-str name))
                span)
              svalue
              span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExprMakeArray ty len-id)
      (match (macro-type-to-spanned-sexpr ty span origin)
        [(ResultMacroSexpr.Ok sty)
          (match (macro-child-to-spanned-sexpr len-id span origin)
            [(ResultMacroSexpr.Ok slen)
              (ResultMacroSexpr.Ok (macro-form2 "make-array" sty slen span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExprArrayRef array-id index-id)
      (match (macro-child-to-spanned-sexpr array-id span origin)
        [(ResultMacroSexpr.Ok sarray)
          (match (macro-child-to-spanned-sexpr index-id span origin)
            [(ResultMacroSexpr.Ok sindex)
              (ResultMacroSexpr.Ok (macro-form2 "array-ref" sarray sindex span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExprArraySet array-id index-id value-id)
      (match (macro-child-to-spanned-sexpr array-id span origin)
        [(ResultMacroSexpr.Ok sarray)
          (match (macro-child-to-spanned-sexpr index-id span origin)
            [(ResultMacroSexpr.Ok sindex)
              (match (macro-child-to-spanned-sexpr value-id span origin)
                [(ResultMacroSexpr.Ok svalue)
                  (ResultMacroSexpr.Ok
                    (macro-form3 "array-set!" sarray sindex svalue span))]
                [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExprArrayPush array-id value-id)
      (match (macro-child-to-spanned-sexpr array-id span origin)
        [(ResultMacroSexpr.Ok sarray)
          (match (macro-child-to-spanned-sexpr value-id span origin)
            [(ResultMacroSexpr.Ok svalue)
              (ResultMacroSexpr.Ok
                (macro-form2 "array-push!" sarray svalue span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExprStringRef string-id index-id)
      (match (macro-child-to-spanned-sexpr string-id span origin)
        [(ResultMacroSexpr.Ok sstring)
          (match (macro-child-to-spanned-sexpr index-id span origin)
            [(ResultMacroSexpr.Ok sindex)
              (ResultMacroSexpr.Ok
                (macro-form2 "string-ref" sstring sindex span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExprStructGet receiver-id field)
      (match (macro-child-to-spanned-sexpr receiver-id span origin)
        [(ResultMacroSexpr.Ok sreceiver)
          (ResultMacroSexpr.Ok
            (macro-form2
              "struct-get"
              sreceiver
              (SpannedSexpr.Sym (intern-str field) span)
              span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExprStructSet receiver-id field value-id)
      (match (macro-child-to-spanned-sexpr receiver-id span origin)
        [(ResultMacroSexpr.Ok sreceiver)
          (match (macro-child-to-spanned-sexpr value-id span origin)
            [(ResultMacroSexpr.Ok svalue)
              (ResultMacroSexpr.Ok
                (macro-form2
                  "set!"
                  (macro-form2
                    "struct-get"
                    sreceiver
                    (SpannedSexpr.Sym (intern-str field) span)
                    span)
                  svalue
                  span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExprCast inner-id ty)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (match (macro-type-to-spanned-sexpr ty span origin)
            [(ResultMacroSexpr.Ok sty)
              (ResultMacroSexpr.Ok
                (macro-form3 "cast" sinner (SpannedSexpr.Sym ":" span) sty span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExprAnn inner-id ty)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (match (macro-type-to-spanned-sexpr ty span origin)
            [(ResultMacroSexpr.Ok sty)
              (ResultMacroSexpr.Ok
                (macro-form3 "ann" sinner (SpannedSexpr.Sym ":" span) sty span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExprBorrow mutable lifetime place-id)
      (match (macro-child-to-spanned-sexpr place-id span origin)
        [(ResultMacroSexpr.Ok splace)
          (let
            [head : String
              (if mutable
                "&mut"
                "&")]
            (match lifetime
              [(AstBorrowLifetimeInferred)
                (ResultMacroSexpr.Ok (macro-form1 head splace span))]
              [(AstBorrowLifetimeNamed name)
                (ResultMacroSexpr.Ok
                  (macro-form2 head (SpannedSexpr.Sym name span) splace span))]))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExprReturn inner-id)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok (macro-form1 "return" sinner span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExprTry inner-id)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok (macro-form1 "try" sinner span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExprBox inner-id)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok (macro-form1 "box" sinner span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExprBoxGet inner-id)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok (macro-form1 "box-get" sinner span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExprBoxTake inner-id)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok (macro-form1 "box-take" sinner span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExprBoxSet receiver-id value-id)
      (match (macro-child-to-spanned-sexpr receiver-id span origin)
        [(ResultMacroSexpr.Ok sreceiver)
          (match (macro-child-to-spanned-sexpr value-id span origin)
            [(ResultMacroSexpr.Ok svalue)
              (ResultMacroSexpr.Ok
                (macro-form2
                  "set!"
                  (macro-form1 "box-get" sreceiver span)
                  svalue
                  span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExprTupleRef tuple-id index)
      (match (macro-child-to-spanned-sexpr tuple-id span origin)
        [(ResultMacroSexpr.Ok stuple)
          (ResultMacroSexpr.Ok
            (macro-form2
              "tuple-ref"
              stuple
              (SpannedSexpr.Int index (string.int->string index) span)
              span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExprInit maybe-ty)
      (match maybe-ty
        [(AstNoType)
          (ResultMacroSexpr.Ok
            (spanned-sexpr-cons
              (SpannedSexpr.Sym "init" span)
              (SpannedSexpr.Nil span)
              span))]
        [(AstSomeType ty)
          (match (macro-type-to-spanned-sexpr ty span origin)
            [(ResultMacroSexpr.Ok sty)
              (ResultMacroSexpr.Ok
                (macro-form2 "init" (SpannedSexpr.Sym ":" span) sty span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])])]
    [(AstExprTypeLiteral ty)
      (match (macro-type-to-spanned-sexpr ty span origin)
        [(ResultMacroSexpr.Ok sty)
          (ResultMacroSexpr.Ok (macro-form1 "type" sty span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [_
      (ResultMacroSexpr.Err
        (box
          (macro-output-syntax-diag
            origin
            "typecheck: module macro output contains syntax that cannot be parsed as a declaration")))]))

(define (macro-expr-to-spanned-sexpr [expr : AstExpr] [origin : AstExpr]) : ResultMacroSexpr
  (macro-expr-to-spanned-sexpr-with-span expr (macro-zero-source-span) origin))

(define (macro-stdlib-private-dynamic-buffer-macro?
  [macro-name : String]
  [definition-module : String]) : bool
  (or
    (and
      (string.string-eq definition-module "stdlib.vector")
      (string.string-eq macro-name "stdlib.vector/vector"))
    (and
      (string.string-eq definition-module "stdlib.vector")
      (string.string-eq macro-name "stdlib.vector/vector-family"))))

(define (macro-parse-dispatch-for-macro
  [macro-name : String]
  [definition-module : String]) : SymI64Env
  (if (macro-stdlib-private-dynamic-buffer-macro? macro-name definition-module)
    (compiler-parse-dispatch-private-types (compiler-parse-dispatch-env))
    (compiler-parse-dispatch-env)))

(define (macro-parse-decl-sexpr
  [dispatch : SymI64Env]
  [form : SpannedSexpr]
  [origin : AstExpr]) : ResultMacroParsedDecls
  (match (parse-ast-decl-maybe dispatch form)
    [(OkAstSomeDecl decl)
      (ResultMacroParsedDecls.Ok (ast-decl-cons decl AstDeclNil))]
    [(OkAstDecls decls) (ResultMacroParsedDecls.Ok decls)]
    [(OkAstNoDecl) (ResultMacroParsedDecls.Ok AstDeclNil)]
    [(ErrAstMaybeDecl message)
      (ResultMacroParsedDecls.Err
        (box (macro-output-syntax-diag origin message)))]))

(define (macro-parse-decls-from-one-expr
  [dispatch : SymI64Env]
  [expr : AstExpr]
  [origin : AstExpr]) : ResultMacroParsedDecls
  (let
    [mark : i64 (sp-node-pool-len)]
    (match (macro-expr-to-spanned-sexpr expr origin)
      [(ResultMacroSexpr.Ok form)
        (match (macro-parse-decl-sexpr dispatch form origin)
          [(ResultMacroParsedDecls.Ok decls)
            (begin
              (sp-node-pool-truncate! mark)
              (ResultMacroParsedDecls.Ok decls))]
          [(ResultMacroParsedDecls.Err diag)
            (begin
              (sp-node-pool-truncate! mark)
              (ResultMacroParsedDecls.Err diag))])]
      [(ResultMacroSexpr.Err diag)
        (begin
          (sp-node-pool-truncate! mark)
          (ResultMacroParsedDecls.Err diag))])))

(define (macro-parse-decls-from-exprs
  [dispatch : SymI64Env]
  [exprs : AstExprList]
  [origin : AstExpr]) : ResultMacroParsedDecls
  (match exprs
    [(AstExprNil) (ResultMacroParsedDecls.Ok AstDeclNil)]
    [(AstExprCons head rest)
      (let
        [head-expr : AstExpr (ast-node-get head)]
        [rest : AstExprList (box-get rest)]
        (match (macro-parse-decls-from-expr dispatch head-expr origin)
          [(ResultMacroParsedDecls.Ok head-decls)
            (match (macro-parse-decls-from-exprs dispatch rest origin)
              [(ResultMacroParsedDecls.Ok rest-decls)
                (ResultMacroParsedDecls.Ok
                  (macro-decl-list-append head-decls rest-decls))]
              [(ResultMacroParsedDecls.Err diag)
                (ResultMacroParsedDecls.Err diag)])]
          [(ResultMacroParsedDecls.Err diag) (ResultMacroParsedDecls.Err diag)]))]))

(define (macro-parse-decls-from-expr
  [dispatch : SymI64Env]
  [expr : AstExpr]
  [origin : AstExpr]) : ResultMacroParsedDecls
  (match (ast-expr-unspan expr)
    [(AstExprBegin exprs) (macro-parse-decls-from-exprs dispatch exprs origin)]
    [(AstExprCall func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (match (ast-expr-unspan func)
          [(AstExprVar name)
            (if (string.string-eq
              (macro-output-syntax-name (intern-str name))
              "begin")
              (macro-parse-decls-from-exprs dispatch args origin)
              (macro-parse-decls-from-one-expr dispatch expr origin))]
          [_ (macro-parse-decls-from-one-expr dispatch expr origin)]))]
    [_ (macro-parse-decls-from-one-expr dispatch expr origin)]))

(define (macro-module-decls-from-ctfe-value
  [value : CompilerCtfeValue]
  [origin : AstExpr]
  [dispatch : SymI64Env]) : ResultMacroParsedDecls
  (match value
    [(CtfeExpr node _)
      (macro-parse-decls-from-expr dispatch (ast-node-get node) origin)]
    [_
      (ResultMacroParsedDecls.Err
        (box
          (macro-output-syntax-diag
            origin
            "typecheck: Module macro transformer did not produce Expr")))]))

(define (macro-decls-from-ctfe-value
  [value : CompilerCtfeValue]
  [origin : AstExpr]
  [dispatch : SymI64Env]) : ResultMacroParsedDecls
  (match value
    [(CtfeExpr node _)
      (macro-parse-decls-from-expr dispatch (ast-node-get node) origin)]
    [_
      (ResultMacroParsedDecls.Err
        (box
          (macro-output-syntax-diag
            origin
            "typecheck: Decls macro transformer did not produce Expr")))]))

(define (macro-collect-decl-name
  [decl : AstDecl]
  [module : String]
  [acc : TcStringList]) : TcStringList
  (match decl
    [(AstDeclDefMacro name _ _ _)
      (begin
        (ctfe-module-macro-export-add! module (intern-str name))
        (tc-string-list-add acc (intern-str name)))]
    [(AstDeclUnsafe inner-box)
      (macro-collect-decl-name (box-get inner-box) module acc)]
    [(AstDeclComptimeDecl _ template-box)
      (macro-collect-decl-name (box-get template-box) module acc)]
    [_ acc]))

(define (macro-collect-macro-names [decls : AstDeclList] [acc : TcStringList]) : TcStringList
  (let
    [cur : AstDeclList decls]
    [cur-module : String ""]
    [out : TcStringList acc]
    (begin
      (while (match cur
        [(AstDeclNil) false]
        [_ true])
        (match cur
          [(AstDeclNil) unit]
          [(AstDeclCons decl rest)
            (begin
              (match decl
                [(AstDeclModule next-module)
                  (set! cur-module (intern-str next-module))]
                [_ (set! out (macro-collect-decl-name decl cur-module out))])
              (set! cur (box-get rest)))]))
      out)))

(define (macro-collect-surface-decl-name
  [decl : CompilerLoadSurfaceDecl]
  [acc : TcStringList]) : TcStringList
  (match (struct-get decl kind)
    [(CompilerLoadSurfaceMacro)
      (let
        [module : String (struct-get decl module)]
        [name : String (struct-get decl name)]
        (begin
          (ctfe-module-macro-export-add! module name)
          (tc-string-list-add acc name)))]
    [_ acc]))

(define (macro-collect-surface-decl-names
  [decls : CompilerLoadSurfaceDeclList]
  [acc : TcStringList]) : TcStringList
  (match decls
    [(CompilerLoadSurfaceDeclNil) acc]
    [(CompilerLoadSurfaceDeclCons decl rest)
      (macro-collect-surface-decl-names
        (box-get rest)
        (macro-collect-surface-decl-name decl acc))]))

(define (macro-collect-surface-summary-macro-names
  [summaries : CompilerLoadSurfaceSummaryList]
  [acc : TcStringList]) : TcStringList
  (match summaries
    [(CompilerLoadSurfaceSummaryNil) acc]
    [(CompilerLoadSurfaceSummaryCons summary rest)
      (macro-collect-surface-summary-macro-names
        (box-get rest)
        (macro-collect-surface-decl-names (struct-get summary decls) acc))]))

(define (macro-collect-visible-macro-names [decls : AstDeclList]) : TcStringList
  (macro-collect-surface-summary-macro-names
    (compiler-load-surface-summaries)
    (macro-collect-macro-names
      decls
      (tc-string-list-add (tc-string-list-add (TcStringNil) "when") "unless"))))

(define (macro-surface-decl-macro-in-module?
  [decl : CompilerLoadSurfaceDecl]
  [target-module : String]
  [base : String]) : bool
  (and
    (string.string-eq (struct-get decl module) target-module)
    (string.string-eq (struct-get decl name) base)
    (match (struct-get decl kind)
      [(CompilerLoadSurfaceMacro) true]
      [_ false])))

(define (macro-surface-decls-macro-in-module?
  [decls : CompilerLoadSurfaceDeclList]
  [target-module : String]
  [base : String]) : bool
  (match decls
    [(CompilerLoadSurfaceDeclNil) false]
    [(CompilerLoadSurfaceDeclCons decl rest)
      (or
        (macro-surface-decl-macro-in-module? decl target-module base)
        (macro-surface-decls-macro-in-module? (box-get rest) target-module base))]))

(define (macro-surface-summaries-macro-in-module?
  [summaries : CompilerLoadSurfaceSummaryList]
  [target-module : String]
  [base : String]) : bool
  (match summaries
    [(CompilerLoadSurfaceSummaryNil) false]
    [(CompilerLoadSurfaceSummaryCons summary rest)
      (or
        (macro-surface-decls-macro-in-module?
          (struct-get summary decls)
          target-module
          base)
        (macro-surface-summaries-macro-in-module?
          (box-get rest)
          target-module
          base))]))

(define (macro-surface-macro-in-module?
  [target-module : String]
  [base : String]) : bool
  (macro-surface-summaries-macro-in-module?
    (compiler-load-surface-summaries)
    target-module
    base))

(define (macro-surface-decls-module-has-macro?
  [decls : CompilerLoadSurfaceDeclList]
  [target-module : String]) : bool
  (match decls
    [(CompilerLoadSurfaceDeclNil) false]
    [(CompilerLoadSurfaceDeclCons decl rest)
      (or
        (and
          (string.string-eq (struct-get decl module) target-module)
          (match (struct-get decl kind)
            [(CompilerLoadSurfaceMacro) true]
            [_ false]))
        (macro-surface-decls-module-has-macro? (box-get rest) target-module))]))

(define (macro-surface-summaries-module-has-macro?
  [summaries : CompilerLoadSurfaceSummaryList]
  [target-module : String]) : bool
  (match summaries
    [(CompilerLoadSurfaceSummaryNil) false]
    [(CompilerLoadSurfaceSummaryCons summary rest)
      (or
        (macro-surface-decls-module-has-macro?
          (struct-get summary decls)
          target-module)
        (macro-surface-summaries-module-has-macro? (box-get rest) target-module))]))

(define (macro-surface-module-has-macro? [target-module : String]) : bool
  (macro-surface-summaries-module-has-macro?
    (compiler-load-surface-summaries)
    target-module))

(defenum MacroSurfaceCallDeclCacheLookup
  (Miss)
  (Hit MacroMaybeDecl))

(define macro-surface-call-decl-cache-capacity : i64
  8192)
(define macro-surface-call-decl-cache-module-keys : (Array i64)
  (array.make-array i64 8192))
(define macro-surface-call-decl-cache-base-keys : (Array i64)
  (array.make-array i64 8192))
(define macro-surface-call-decl-cache-values : (Array MacroMaybeDecl)
  (array.make-array MacroMaybeDecl 8192))
(define macro-surface-call-decl-cache-count : i64
  0)
(define macro-surface-call-decl-cache-generation : i64
  -1)
(define macro-surface-call-decl-cache-ready : bool
  false)

(define (macro-surface-call-decl-cache-reset!) : unit
  (set! macro-surface-call-decl-cache-ready false))

(define (macro-surface-call-decl-cache-ensure!) : unit
  (if (if macro-surface-call-decl-cache-ready
    (= macro-surface-call-decl-cache-generation (intern-generation))
    false)
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i macro-surface-call-decl-cache-capacity)
          (begin
            (array.array-set! macro-surface-call-decl-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set! macro-surface-call-decl-cache-count 0)
        (set! macro-surface-call-decl-cache-generation (intern-generation))
        (set! macro-surface-call-decl-cache-ready true)))))

(define (macro-surface-call-decl-cache-bucket [module-id : i64] [base-id : i64]) : i64
  (bit-and
    (+ (* module-id 2654435761) (* base-id 40503))
    (- macro-surface-call-decl-cache-capacity 1)))

(define (macro-surface-call-decl-cache-get [module-id : i64] [base-id : i64]) : MacroSurfaceCallDeclCacheLookup
  (let
    [cursor : i64 (macro-surface-call-decl-cache-bucket module-id base-id)]
    [module-key : i64 (+ module-id 1)]
    [base-key : i64 (+ base-id 1)]
    [steps : i64 0]
    [out : MacroSurfaceCallDeclCacheLookup
      (MacroSurfaceCallDeclCacheLookup.Miss)]
    [done : bool false]
    (begin
      (while (if done
        false
        (< steps macro-surface-call-decl-cache-capacity))
        (let
          [slot : i64
            (array.array-ref macro-surface-call-decl-cache-module-keys cursor)]
          (if (= slot 0)
            (set! done true)
            (if (and
              (= slot module-key)
              (=
                (array.array-ref macro-surface-call-decl-cache-base-keys cursor)
                base-key))
              (begin
                (set!
                  out
                  (MacroSurfaceCallDeclCacheLookup.Hit
                    (array.array-ref
                      macro-surface-call-decl-cache-values
                      cursor)))
                (set! done true))
              (begin
                (set!
                  cursor
                  (bit-and
                    (+ cursor 1)
                    (- macro-surface-call-decl-cache-capacity 1)))
                (set! steps (+ steps 1)))))))
      out)))

(define (macro-surface-call-decl-cache-put!
  [module-id : i64]
  [base-id : i64]
  [value : MacroMaybeDecl]) : unit
  (if (>=
    (* macro-surface-call-decl-cache-count 2)
    macro-surface-call-decl-cache-capacity)
    unit
    (let
      [cursor : i64 (macro-surface-call-decl-cache-bucket module-id base-id)]
      [module-key : i64 (+ module-id 1)]
      [base-key : i64 (+ base-id 1)]
      [steps : i64 0]
      [done : bool false]
      (begin
        (while (if done
          false
          (< steps macro-surface-call-decl-cache-capacity))
          (let
            [slot : i64
              (array.array-ref macro-surface-call-decl-cache-module-keys cursor)]
            (if (= slot 0)
              (begin
                (array.array-set!
                  macro-surface-call-decl-cache-module-keys
                  cursor
                  module-key)
                (array.array-set!
                  macro-surface-call-decl-cache-base-keys
                  cursor
                  base-key)
                (array.array-set!
                  macro-surface-call-decl-cache-values
                  cursor
                  value)
                (set!
                  macro-surface-call-decl-cache-count
                  (+ macro-surface-call-decl-cache-count 1))
                (set! done true))
              (if (and
                (= slot module-key)
                (=
                  (array.array-ref
                    macro-surface-call-decl-cache-base-keys
                    cursor)
                  base-key))
                (begin
                  (array.array-set!
                    macro-surface-call-decl-cache-values
                    cursor
                    value)
                  (set! done true))
                (begin
                  (set!
                    cursor
                    (bit-and
                      (+ cursor 1)
                      (- macro-surface-call-decl-cache-capacity 1)))
                  (set! steps (+ steps 1)))))))
        unit))))

(define (macro-surface-decl-call-decl-in-module
  [decl : CompilerLoadSurfaceDecl]
  [target-module : String]
  [base : String]) : MacroMaybeDecl
  (if (and
    (string.string-eq (struct-get decl module) target-module)
    (string.string-eq (struct-get decl name) base)
    (match (struct-get decl kind)
      [(CompilerLoadSurfaceMacro) true]
      [_ false]))
    (match (struct-get decl signature)
      [(CompilerLoadSurfaceMacroSignature params ret body-box)
        (begin
          (tc-lazy-import-summary-macro-force-record!)
          (MacroMaybeDecl.Some
            (compiler-symbol-module-key target-module base)
            target-module
            params
            ret
            (ast-node-get body-box)))]
      [_ (MacroMaybeDecl.No)])
    (MacroMaybeDecl.No)))

(define (macro-surface-decls-call-decl-in-module
  [decls : CompilerLoadSurfaceDeclList]
  [target-module : String]
  [base : String]) : MacroMaybeDecl
  (match decls
    [(CompilerLoadSurfaceDeclNil) (MacroMaybeDecl.No)]
    [(CompilerLoadSurfaceDeclCons decl rest)
      (match (macro-surface-decl-call-decl-in-module decl target-module base)
        [(MacroMaybeDecl.Some macro-name def-module params ret body)
          (MacroMaybeDecl.Some macro-name def-module params ret body)]
        [(MacroMaybeDecl.No)
          (macro-surface-decls-call-decl-in-module
            (box-get rest)
            target-module
            base)])]))

(define (macro-surface-summaries-call-decl-in-module
  [summaries : CompilerLoadSurfaceSummaryList]
  [target-module : String]
  [base : String]) : MacroMaybeDecl
  (match summaries
    [(CompilerLoadSurfaceSummaryNil) (MacroMaybeDecl.No)]
    [(CompilerLoadSurfaceSummaryCons summary rest)
      (match (macro-surface-decls-call-decl-in-module
        (struct-get summary decls)
        target-module
        base)
        [(MacroMaybeDecl.Some macro-name def-module params ret body)
          (MacroMaybeDecl.Some macro-name def-module params ret body)]
        [(MacroMaybeDecl.No)
          (macro-surface-summaries-call-decl-in-module
            (box-get rest)
            target-module
            base)])]))

(define (macro-surface-call-decl-in-module
  [target-module : String]
  [base : String]) : MacroMaybeDecl
  (let
    [module-id : i64 (intern target-module)]
    [base-id : i64 (intern base)]
    (begin
      (macro-surface-call-decl-cache-ensure!)
      (match (macro-surface-call-decl-cache-get module-id base-id)
        [(MacroSurfaceCallDeclCacheLookup.Hit cached) cached]
        [(MacroSurfaceCallDeclCacheLookup.Miss)
          (let
            [result : MacroMaybeDecl
              (macro-surface-summaries-call-decl-in-module
                (compiler-load-surface-summaries)
                target-module
                base)]
            (begin
              (macro-surface-call-decl-cache-put! module-id base-id result)
              result))]))))

(define (macro-expr-uses-expr-type? [expr : AstExpr]) : bool
  (or
    (tc-expr-uses-free-name? expr "expr-type" TcStringNil)
    (tc-expr-uses-free-name? expr "comptime.expr-type" TcStringNil)
    (tc-expr-uses-free-name? expr "comptime/expr-type" TcStringNil)
    (tc-expr-uses-free-name? expr "stdlib.comptime.expr-type" TcStringNil)
    (tc-expr-uses-free-name? expr "stdlib.comptime/expr-type" TcStringNil)
    (tc-expr-uses-free-name? expr "stdlib/comptime.expr-type" TcStringNil)
    (tc-expr-uses-free-name? expr "stdlib/comptime/expr-type" TcStringNil)))

(define (macro-collect-expr-type-decl-name
  [decl : AstDecl]
  [module : String]
  [acc : TcStringList]) : TcStringList
  (match decl
    [(AstDeclDefMacro name _ _ body-box)
      (let
        [body : AstExpr (ast-node-get body-box)]
        [name-str : String (intern-str name)]
        (if (macro-expr-uses-expr-type? body)
          (tc-string-list-add acc (compiler-symbol-module-key module name-str))
          acc))]
    [(AstDeclUnsafe inner-box)
      (macro-collect-expr-type-decl-name (box-get inner-box) module acc)]
    [(AstDeclComptimeDecl _ template-box)
      (macro-collect-expr-type-decl-name (box-get template-box) module acc)]
    [_ acc]))

(define (macro-collect-expr-type-macro-names-in
  [decls : AstDeclList]
  [module : String]
  [acc : TcStringList]) : TcStringList
  (let
    [cur : AstDeclList decls]
    [cur-module-id : i64 (intern module)]
    [out : TcStringList acc]
    (begin
      (while (match cur
        [(AstDeclNil) false]
        [_ true])
        (match cur
          [(AstDeclNil) unit]
          [(AstDeclCons decl rest)
            (begin
              (match decl
                [(AstDeclModule next-module) (set! cur-module-id next-module)]
                [_
                  (set!
                    out
                    (macro-collect-expr-type-decl-name
                      decl
                      (intern-str cur-module-id)
                      out))])
              (set! cur (box-get rest)))]))
      out)))

(define (macro-collect-expr-type-macro-names [decls : AstDeclList]) : TcStringList
  (macro-collect-expr-type-macro-names-in decls "" TcStringNil))

(define (macro-hygiene-env-lookup [env : MacroHygieneEnv] [name : String]) : TcMaybeString
  (match env
    [(MacroHygieneEnv.Nil) (TcNoString)]
    [(MacroHygieneEnv.Bind key value rest)
      (if (string.string-eq key name)
        (TcSomeString value)
        (macro-hygiene-env-lookup (box-get rest) name))]))

(define (macro-canonical-name [module : String] [name : String]) : String
  (compiler-symbol-module-key module name))

(define (macro-hygiene-definition-module [macro-name : String]) : String
  (if (tc-name-qualified? macro-name)
    (tc-qualified-name-module macro-name)
    ""))

(define (macro-hygiene-definition-base [macro-name : String]) : String
  (if (tc-name-qualified? macro-name)
    (tc-qualified-name-base macro-name)
    macro-name))

(define (macro-hygiene-context-macro-name
  [macro-name : String]
  [module : String]) : String
  (if (tc-name-qualified? macro-name)
    macro-name
    (if (string.string-eq module "")
      macro-name
      (compiler-symbol-module-key module macro-name))))

(define (macro-hygiene-global-name-for [macro-name : String] [base : String]) : String
  (let
    [definition-module : String (macro-hygiene-definition-module macro-name)]
    [macro-base : String (macro-hygiene-definition-base macro-name)]
    (if (and (not (tc-name-qualified? base)) (string.string-eq base macro-base))
      (tc-hygiene-global-name
        (compiler-symbol-module-key definition-module base))
      (tc-hygiene-global-context-name definition-module base))))

(define (macro-hygiene-fresh-local
  [macro-name : String]
  [depth : i64]
  [base : String]) : String
  (string.string-append
    (tc-hygiene-local-prefix)
    (string.string-append
      (string.int->string depth)
      (string.string-append
        "$"
        (string.string-append macro-name (string.string-append "$" base))))))

(define (macro-hygiene-rename-var
  [env : MacroHygieneEnv]
  [macro-name : String]
  [name : String]) : String
  (if (tc-hygiene-template-name? name)
    (let
      [base : String (tc-hygiene-template-base name)]
      (match (macro-hygiene-env-lookup env base)
        [(TcSomeString renamed) renamed]
        [(TcNoString) (macro-hygiene-global-name-for macro-name base)]))
    name))

(define (macro-hygiene-bind-name
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]
  [name : String]) : MacroHygieneName
  (if (tc-hygiene-template-name? name)
    (let
      [base : String (tc-hygiene-template-base name)]
      [renamed : String (macro-hygiene-fresh-local macro-name depth base)]
      (MacroHygieneName.Name
        renamed
        (MacroHygieneEnv.Bind base renamed (box env))))
    (MacroHygieneName.Name name env)))

(define (macro-hygiene-expr-list
  [exprs : AstExprList]
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]) : AstExprList
  (match exprs
    [(AstExprNil) AstExprNil]
    [(AstExprCons head rest)
      (let
        [head : AstExpr (ast-node-get head)]
        [rest : AstExprList (box-get rest)]
        (ast-expr-cons
          (macro-hygiene-expr head env macro-name depth)
          (macro-hygiene-expr-list rest env macro-name depth)))]))

(define (macro-hygiene-param-list
  [params : AstParamList]
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]) : MacroHygieneParams
  (match params
    [(AstParamNil) (MacroHygieneParams.Params AstParamNil env)]
    [(AstParamCons param rest)
      (let
        [rest : AstParamList (box-get rest)]
        (match param
          [(AstParam name ty comptime?)
            (match (macro-hygiene-bind-name
              env
              macro-name
              depth
              (intern-str name))
              [(MacroHygieneName.Name renamed next-env)
                (match (macro-hygiene-param-list rest next-env macro-name depth)
                  [(MacroHygieneParams.Params nrest final-env)
                    (MacroHygieneParams.Params
                      (ast-param-cons (ast-param renamed ty comptime?) nrest)
                      final-env)])])]))]))

(define (macro-hygiene-pattern-list
  [patterns : AstPatternList]
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]) : MacroHygienePatternList
  (match patterns
    [(AstPatternNil) (MacroHygienePatternList.PatternList AstPatternNil env)]
    [(AstPatternCons pattern rest)
      (let
        [pattern : AstPattern (box-get pattern)]
        [rest : AstPatternList (box-get rest)]
        (match (macro-hygiene-pattern pattern env macro-name depth)
          [(MacroHygienePattern.Pattern npattern next-env)
            (match (macro-hygiene-pattern-list rest next-env macro-name depth)
              [(MacroHygienePatternList.PatternList nrest final-env)
                (MacroHygienePatternList.PatternList
                  (ast-pattern-cons npattern nrest)
                  final-env)])]))]))

(define (macro-hygiene-pattern
  [pattern : AstPattern]
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]) : MacroHygienePattern
  (match pattern
    [(AstPatVar name maybe-ty)
      (match (macro-hygiene-bind-name env macro-name depth (intern-str name))
        [(MacroHygieneName.Name renamed next-env)
          (MacroHygienePattern.Pattern
            (AstPatVar (intern renamed) maybe-ty)
            next-env)])]
    [(AstPatTuple patterns-box)
      (let
        [patterns : AstPatternList (box-get patterns-box)]
        (match (macro-hygiene-pattern-list patterns env macro-name depth)
          [(MacroHygienePatternList.PatternList npatterns next-env)
            (MacroHygienePattern.Pattern (ast-pat-tuple npatterns) next-env)]))]
    [(AstPatWildcard) (MacroHygienePattern.Pattern AstPatWildcard env)]
    [(AstPatBinding name)
      (match (macro-hygiene-bind-name env macro-name depth (intern-str name))
        [(MacroHygieneName.Name renamed next-env)
          (MacroHygienePattern.Pattern (ast-pat-binding renamed) next-env)])]
    [(AstPatVariant name args-box)
      (let
        [args : AstPatternList (box-get args-box)]
        (match (macro-hygiene-pattern-list args env macro-name depth)
          [(MacroHygienePatternList.PatternList nargs next-env)
            (MacroHygienePattern.Pattern
              (ast-pat-variant-id name nargs)
              next-env)]))]
    [(AstPatLiteral lit) (MacroHygienePattern.Pattern (AstPatLiteral lit) env)]))

(define (macro-hygiene-let-bindings
  [bindings : AstLetBindingList]
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]) : MacroHygieneLetBindings
  (match bindings
    [(AstLetBindingNil)
      (MacroHygieneLetBindings.LetBindings AstLetBindingNil env)]
    [(AstLetBindingCons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding name maybe-ty init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              [ninit : i64 (macro-hygiene-expr init env macro-name depth)]
              (match (macro-hygiene-bind-name
                env
                macro-name
                depth
                (intern-str name))
                [(MacroHygieneName.Name renamed next-env)
                  (match (macro-hygiene-let-bindings
                    rest
                    next-env
                    macro-name
                    depth)
                    [(MacroHygieneLetBindings.LetBindings nrest final-env)
                      (MacroHygieneLetBindings.LetBindings
                        (ast-let-binding-cons
                          (ast-let-binding renamed maybe-ty ninit)
                          nrest)
                        final-env)])]))]))]))

(define (macro-hygiene-resource-bindings
  [bindings : AstResourceBindingList]
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]) : MacroHygieneResourceBindings
  (match bindings
    [(AstResourceBindingNil)
      (MacroHygieneResourceBindings.ResourceBindings AstResourceBindingNil env)]
    [(AstResourceBindingCons binding rest)
      (let
        [rest : AstResourceBindingList (box-get rest)]
        (match binding
          [(AstResourceBinding name init-box cleanup-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              [cleanup : AstExpr (ast-node-get cleanup-box)]
              [ninit : i64 (macro-hygiene-expr init env macro-name depth)]
              [ncleanup : i64 (macro-hygiene-expr cleanup env macro-name depth)]
              (match (macro-hygiene-bind-name
                env
                macro-name
                depth
                (intern-str name))
                [(MacroHygieneName.Name renamed next-env)
                  (match (macro-hygiene-resource-bindings
                    rest
                    next-env
                    macro-name
                    depth)
                    [(MacroHygieneResourceBindings.ResourceBindings
                        nrest
                        final-env)
                      (MacroHygieneResourceBindings.ResourceBindings
                        (ast-resource-binding-cons
                          (ast-resource-binding renamed ninit ncleanup)
                          nrest)
                        final-env)])]))]))]))

(define (macro-hygiene-arm-list
  [arms : AstMatchArmList]
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]) : AstMatchArmList
  (match arms
    [(AstMatchArmNil) AstMatchArmNil]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm pattern body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (match (macro-hygiene-pattern pattern env macro-name depth)
                [(MacroHygienePattern.Pattern npattern arm-env)
                  (ast-match-arm-cons
                    (ast-match-arm
                      npattern
                      (macro-hygiene-expr body arm-env macro-name depth))
                    (macro-hygiene-arm-list rest env macro-name depth))]))]))]))

(define (macro-hygiene-expr
  [expr : AstExpr]
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]) : i64
  (match expr
    [(AstExprSpanned inner-box span)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-spanned (macro-hygiene-expr inner env macro-name depth) span))]
    [(AstExprVar name)
      (ast-node-push
        (AstExprVar
          (intern (macro-hygiene-rename-var env macro-name (intern-str name)))))]
    [(AstExprBinary op left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (ast-expr-binary
          op
          (macro-hygiene-expr left env macro-name depth)
          (macro-hygiene-expr right env macro-name depth)))]
    [(AstExprUnary op inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-unary op (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExprCall func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (ast-expr-call
          (macro-hygiene-expr func env macro-name depth)
          (macro-hygiene-expr-list args env macro-name depth)))]
    [(AstExprBracketClause items)
      (ast-expr-bracket-clause
        (macro-hygiene-expr-list items env macro-name depth))]
    [(AstExprIf cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (ast-expr-if
          (macro-hygiene-expr cond env macro-name depth)
          (macro-hygiene-expr then-branch env macro-name depth)
          (macro-hygiene-expr else-branch env macro-name depth)))]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (macro-hygiene-let-bindings bindings env macro-name depth)
              [(MacroHygieneLetBindings.LetBindings nbindings body-env)
                (ast-expr-let
                  nbindings
                  (macro-hygiene-expr body body-env macro-name depth))]))])]
    [(AstExprLambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda params maybe-ret body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (macro-hygiene-param-list params env macro-name depth)
              [(MacroHygieneParams.Params nparams body-env)
                (ast-expr-lambda
                  nparams
                  maybe-ret
                  (macro-hygiene-expr body body-env macro-name depth))]))])]
    [(AstExprTuple exprs)
      (ast-node-push
        (AstExprTuple (macro-hygiene-expr-list exprs env macro-name depth)))]
    [(AstExprTupleRef tuple-expr-box index)
      (let
        [tuple-expr : AstExpr (ast-node-get tuple-expr-box)]
        (ast-expr-tuple-ref
          (macro-hygiene-expr tuple-expr env macro-name depth)
          index))]
    [(AstExprArray exprs)
      (ast-node-push
        (AstExprArray (macro-hygiene-expr-list exprs env macro-name depth)))]
    [(AstExprMakeArray ty len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (ast-expr-make-array ty (macro-hygiene-expr len env macro-name depth)))]
    [(AstExprArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (ast-expr-array-ref
          (macro-hygiene-expr array env macro-name depth)
          (macro-hygiene-expr index env macro-name depth)))]
    [(AstExprArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (ast-expr-array-set
          (macro-hygiene-expr array env macro-name depth)
          (macro-hygiene-expr index env macro-name depth)
          (macro-hygiene-expr value env macro-name depth)))]
    [(AstExprArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (ast-expr-array-push
          (macro-hygiene-expr array env macro-name depth)
          (macro-hygiene-expr value env macro-name depth)))]
    [(AstExprStringRef text-box index-box)
      (let
        [text : AstExpr (ast-node-get text-box)]
        [index : AstExpr (ast-node-get index-box)]
        (ast-expr-string-ref
          (macro-hygiene-expr text env macro-name depth)
          (macro-hygiene-expr index env macro-name depth)))]
    [(AstExprWhile cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (ast-expr-while
          (macro-hygiene-expr cond env macro-name depth)
          (macro-hygiene-expr body env macro-name depth)))]
    [(AstExprBegin exprs)
      (ast-node-push
        (AstExprBegin (macro-hygiene-expr-list exprs env macro-name depth)))]
    [(AstExprUnsafe exprs)
      (ast-node-push
        (AstExprUnsafe (macro-hygiene-expr-list exprs env macro-name depth)))]
    [(AstExprSet name rhs-box)
      (let
        [rhs : AstExpr (ast-node-get rhs-box)]
        (ast-expr-set
          (macro-hygiene-rename-var env macro-name (intern-str name))
          (macro-hygiene-expr rhs env macro-name depth)))]
    [(AstExprAnn inner-box ty)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-ann (macro-hygiene-expr inner env macro-name depth) ty))]
    [(AstExprCast inner-box ty)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-cast (macro-hygiene-expr inner env macro-name depth) ty))]
    [(AstExprBorrow mutable lifetime place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (ast-expr-borrow
          mutable
          lifetime
          (macro-hygiene-expr place env macro-name depth)))]
    [(AstExprMatch match-box)
      (match (box-get match-box)
        [(AstMatch scrut-box arms)
          (let
            [scrut : AstExpr (ast-node-get scrut-box)]
            (ast-expr-match
              (macro-hygiene-expr scrut env macro-name depth)
              (macro-hygiene-arm-list arms env macro-name depth)))])]
    [(AstExprForeach fe-box)
      (match (box-get fe-box)
        [(AstForeach index index-ty start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (macro-hygiene-bind-name
              env
              macro-name
              depth
              (intern-str index))
              [(MacroHygieneName.Name nindex body-env)
                (ast-expr-foreach
                  nindex
                  index-ty
                  (macro-hygiene-expr start env macro-name depth)
                  (macro-hygiene-expr end env macro-name depth)
                  (macro-hygiene-expr body body-env macro-name depth))]))])]
    [(AstExprSpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce op index index-ty start-box end-box init-box value-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            (match (macro-hygiene-bind-name
              env
              macro-name
              depth
              (intern-str index))
              [(MacroHygieneName.Name nindex body-env)
                (ast-expr-spmd-reduce
                  op
                  nindex
                  index-ty
                  (macro-hygiene-expr start env macro-name depth)
                  (macro-hygiene-expr end env macro-name depth)
                  (macro-hygiene-expr init env macro-name depth)
                  (macro-hygiene-expr value body-env macro-name depth))]))])]
    [(AstExprSpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan
            op
            index
            index-ty
            start-box
            end-box
            prefix
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (macro-hygiene-bind-name
              env
              macro-name
              depth
              (intern-str index))
              [(MacroHygieneName.Name nindex value-env)
                (match (macro-hygiene-bind-name
                  value-env
                  macro-name
                  depth
                  (intern-str prefix))
                  [(MacroHygieneName.Name nprefix body-env)
                    (ast-expr-spmd-scan
                      op
                      nindex
                      index-ty
                      (macro-hygiene-expr start env macro-name depth)
                      (macro-hygiene-expr end env macro-name depth)
                      nprefix
                      prefix-ty
                      (macro-hygiene-expr init env macro-name depth)
                      (macro-hygiene-expr value value-env macro-name depth)
                      (macro-hygiene-expr body body-env macro-name depth))])]))])]
    [(AstExprSpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (ast-expr-spmd-broadcast
          (macro-hygiene-expr value env macro-name depth)
          (macro-hygiene-expr lane env macro-name depth)))]
    [(AstExprSpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (ast-expr-spmd-shuffle
          (macro-hygiene-expr value env macro-name depth)
          (macro-hygiene-expr lane env macro-name depth)))]
    [(AstExprStructGet inner-box field)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-struct-get
          (macro-hygiene-expr inner env macro-name depth)
          (intern-str field)))]
    [(AstExprStructSet inner-box field value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (ast-expr-struct-set-id
          (macro-hygiene-expr inner env macro-name depth)
          field
          (macro-hygiene-expr value env macro-name depth)))]
    [(AstExprWithRegion name body)
      (match (macro-hygiene-bind-name env macro-name depth name)
        [(MacroHygieneName.Name nname body-env)
          (ast-node-push
            (AstExprWithRegion
              nname
              (macro-hygiene-expr-list body body-env macro-name depth)))])]
    [(AstExprWithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (ast-expr-with-escape
          (macro-hygiene-expr scratch env macro-name depth)
          (macro-hygiene-expr-list body env macro-name depth)))]
    [(AstExprWithScratch body)
      (ast-expr-with-scratch
        (macro-hygiene-expr-list body env macro-name depth))]
    [(AstExprInArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (ast-expr-in-arena
          (macro-hygiene-expr arena env macro-name depth)
          (macro-hygiene-expr-list body env macro-name depth)))]
    [(AstExprWithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource bindings body)
          (match (macro-hygiene-resource-bindings bindings env macro-name depth)
            [(MacroHygieneResourceBindings.ResourceBindings nbindings body-env)
              (ast-node-push
                (AstExprWithResource
                  (box
                    (AstWithResource
                      nbindings
                      (macro-hygiene-expr-list body body-env macro-name depth)))))])])]
    [(AstExprBox inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-box (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExprBoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-box-get (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExprBoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-box-take (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExprBoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (ast-expr-box-set
          (macro-hygiene-expr inner env macro-name depth)
          (macro-hygiene-expr value env macro-name depth)))]
    [(AstExprTypeLiteral ty) (ast-node-push (AstExprTypeLiteral ty))]
    [(AstExprInit maybe-ty) (ast-expr-init-maybe maybe-ty)]
    [(AstExprComptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-comptime (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExprReturn inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-return (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExprTry inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-try (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExprPtrNull ty) (ast-node-push (AstExprPtrNull ty))]
    [(AstExprPtrNullCheck ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (ast-expr-ptr-null-check (macro-hygiene-expr ptr env macro-name depth)))]
    [(AstExprPtrAddrOf name)
      (ast-expr-ptr-addr-of
        (macro-hygiene-rename-var env macro-name (intern-str name)))]
    [(AstExprPtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (ast-expr-ptr-read (macro-hygiene-expr ptr env macro-name depth)))]
    [(AstExprPtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (ast-expr-ptr-write
          (macro-hygiene-expr ptr env macro-name depth)
          (macro-hygiene-expr value env macro-name depth)))]
    [(AstExprPtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (ast-expr-ptr-offset
          (macro-hygiene-expr ptr env macro-name depth)
          (macro-hygiene-expr offset env macro-name depth)))]
    [(AstExprPtrCast ptr-box ty)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (ast-expr-ptr-cast (macro-hygiene-expr ptr env macro-name depth) ty))]
    [(AstExprPtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (ast-expr-ptr-to-int (macro-hygiene-expr ptr env macro-name depth)))]
    [(AstExprIntToPtr value-box ty)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (ast-expr-int-to-ptr (macro-hygiene-expr value env macro-name depth) ty))]
    [(AstExprStringData inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-string-data (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExprStringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (ast-expr-string-from-bytes
          (macro-hygiene-expr ptr env macro-name depth)
          (macro-hygiene-expr len env macro-name depth)))]
    [(AstExprArrayData inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-array-data (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExprBinaryData bytes) (ast-node-push (AstExprBinaryData bytes))]
    [(AstExprSpmdProgramIndex) (ast-expr-spmd-program-index)]
    [(AstExprSpmdProgramCount) (ast-expr-spmd-program-count)]
    [(AstExprCpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (ast-expr-cpuid-eax
          (macro-hygiene-expr leaf env macro-name depth)
          (macro-hygiene-expr subleaf env macro-name depth)))]
    [(AstExprCpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (ast-expr-cpuid-ebx
          (macro-hygiene-expr leaf env macro-name depth)
          (macro-hygiene-expr subleaf env macro-name depth)))]
    [(AstExprCpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (ast-expr-cpuid-ecx
          (macro-hygiene-expr leaf env macro-name depth)
          (macro-hygiene-expr subleaf env macro-name depth)))]
    [(AstExprCpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (ast-expr-cpuid-edx
          (macro-hygiene-expr leaf env macro-name depth)
          (macro-hygiene-expr subleaf env macro-name depth)))]
    [(AstExprXgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (ast-expr-xgetbv (macro-hygiene-expr index env macro-name depth)))]
    [(AstExprSyscall args)
      (ast-expr-syscall (macro-hygiene-expr-list args env macro-name depth))]
    [(AstExprQuote _) (ast-node-push expr)]
    [(AstExprQuasiquote _) (ast-node-push expr)]
    [(AstExprUnquote _) (ast-node-push expr)]
    [(AstExprUnquoteSplicing _) (ast-node-push expr)]
    [_ (ast-node-push expr)]))

(define (macro-expand-depth-limit) : i64
  64)

(define (macro-find-decl-in-module
  [decls : AstDeclList]
  [name : String]
  [module : String]) : MacroMaybeDecl
  (match decls
    [(AstDeclNil) (MacroMaybeDecl.No)]
    [(AstDeclCons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDeclModule next-module)
            (macro-find-decl-in-module rest name (intern-str next-module))]
          [(AstDeclDefMacro mname params ret body-box)
            (let
              [mname-str : String (intern-str mname)]
              [body : AstExpr (ast-node-get body-box)]
              (if (string.string-eq mname-str name)
                (MacroMaybeDecl.Some
                  (compiler-symbol-module-key module mname-str)
                  module
                  params
                  ret
                  body)
                (macro-find-decl-in-module rest name module)))]
          [_ (macro-find-decl-in-module rest name module)]))]))

(define (macro-find-decl [decls : AstDeclList] [name : String]) : MacroMaybeDecl
  (macro-find-decl-in-module decls name ""))

(define (macro-decl-from-decl [decl : AstDecl] [module : String]) : MacroMaybeDecl
  (match decl
    [(AstDeclDefMacro name params ret body-box)
      (let
        [name-str : String (intern-str name)]
        [body : AstExpr (ast-node-get body-box)]
        (MacroMaybeDecl.Some
          (compiler-symbol-module-key module name-str)
          module
          params
          ret
          body))]
    [(AstDeclUnsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (macro-decl-from-decl inner module))]
    [(AstDeclComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (macro-decl-from-decl template module))]
    [_ (MacroMaybeDecl.No)]))

;; Resolve a macro decl from its symbol-table index in O(1). The symbols decls
;; array is populated (compiler-symbols-index-decl!) at the SAME index that
;; compiler-symbol-handle-index returns: build-compiler-symbol-list-in-module
;; writes the array slot and registers the handle with one shared `index`,
;; skipping the identical Import/IncludeStr/IncludeBin/Export/Module/Test set
;; that the old linear scan skipped. The array already stores the unwrapped decl
;; (compiler-symbol-indexed-decl peels AstDeclUnsafe/AstDeclComptimeDecl the same
;; way macro-decl-from-decl does), so direct module lookups return the identical
;; MacroMaybeDecl.Some the previous O(decls) macro-find-decl-by-index walk produced.
(define (macro-decl-owner-module-or
  [symbols : CompilerSymbols]
  [target : i64]
  [fallback : String]) : String
  (match (compiler-symbols-owner-name-at-index symbols target)
    [(CompilerSomeString owner-name)
      (if (tc-name-qualified? owner-name)
        (tc-qualified-name-module owner-name)
        fallback)]
    [(CompilerNoString) fallback]))

(define (macro-decl-at-index-in-module
  [symbols : CompilerSymbols]
  [target : i64]
  [module : String]) : MacroMaybeDecl
  (match (compiler-symbols-decl-at-index symbols target)
    [(OkAstDecl decl) (macro-decl-from-decl decl module)]
    [(ErrAstDecl _) (MacroMaybeDecl.No)]))

;; Imported macro aliases can be looked up from the importing module. In that
;; path, recover the indexed owner module so the transformer still runs as its
;; original definition module.
(define (macro-decl-at-index-with-owner-module
  [symbols : CompilerSymbols]
  [target : i64]
  [module : String]) : MacroMaybeDecl
  (match (compiler-symbols-decl-at-index symbols target)
    [(OkAstDecl decl)
      (macro-decl-from-decl
        decl
        (macro-decl-owner-module-or symbols target module))]
    [(ErrAstDecl _) (MacroMaybeDecl.No)]))

;; The module accumulator and the current module compare as INTERN IDS: the
;; previous String-based walk converted every AstDeclModule's interned name
;; back to a fresh String (`intern-str` allocates) and string-compared it, for
;; every declaration walked, on every qualified-alias resolution -- 11.6% of
;; the stage2 self-compile CPU profile. Import aliases still compare by
;; content, but only for imports declared in the current module.
(define (macro-import-alias-target-ids
  [decls : AstDeclList]
  [current-module-id : i64]
  [alias : String]
  [module-id : i64]) : TcMaybeString
  (match decls
    [(AstDeclNil) (TcNoString)]
    [(AstDeclCons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDeclModule next-module)
            (macro-import-alias-target-ids
              rest
              current-module-id
              alias
              next-module)]
          [(AstDeclImport (AstImportSpec _ _ expected maybe-alias _))
            (match maybe-alias
              [(AstSomeImportAlias import-alias)
                (if (and
                  (= module-id current-module-id)
                  (string.string-eq import-alias alias))
                  (match expected
                    [(AstSomeModuleName target) (TcSomeString target)]
                    [(AstNoModuleName) (TcSomeString alias)])
                  (macro-import-alias-target-ids
                    rest
                    current-module-id
                    alias
                    module-id))]
              [(AstNoImportAlias)
                (macro-import-alias-target-ids
                  rest
                  current-module-id
                  alias
                  module-id)])]
          [_
            (macro-import-alias-target-ids
              rest
              current-module-id
              alias
              module-id)]))]))

;; --- import-aware macro resolution caches -------------------------------------
;;
;; Qualified-alias lookup and unqualified flat-import lookup both derive from the
;; program's AstDeclModule/AstDeclImport declarations. Cache them at the same
;; per-program boundary so generated macro bodies do not repeatedly rescan the
;; whole declaration list.
(defenum MacroFlatImportTargetList
  (Nil)
  (Cons i64 (Box MacroFlatImportTargetList)))

(defenum MacroFlatImportTargetCacheLookup
  (Missing)
  (Hit MacroFlatImportTargetList))

;; Even with id compares, each resolution walks the ENTIRE declaration list
;; (most declarations are neither modules nor imports), and the same
;; (current-module, qualifier) pair resolves identically for the whole
;; program: the mapping is derived only from AstDeclModule/AstDeclImport
;; declarations, which macro expansion, comptime generation, and
;; specialization never insert or reorder mid-compile. Memoize per
;; generation (same idiom as the marker name-id memos), open-addressed and
;; keyed by the two intern ids. Module key slots store module-id+1 so the zeroed
;; table is empty; qualifier slots store qualifier-id+1, and values store the
;; resolved target's intern id, or -1 for "no alias import" (return the
;; qualifier unchanged). Inserts stop at half load -- only memoization, never
;; correctness, degrades.
(define macro-alias-cache-capacity : i64
  4096)
(define macro-alias-cache-module-keys : (Array i64)
  (array.make-array i64 4096))
(define macro-alias-cache-qualifier-keys : (Array i64)
  (array.make-array i64 4096))
(define macro-alias-cache-values : (Array i64)
  (array.make-array i64 4096))
(define macro-alias-cache-count : i64
  0)
(define macro-alias-cache-generation : i64
  -1)
(define macro-alias-cache-ready : bool
  false)
(define macro-unqualified-import-cache-capacity : i64
  65536)
(define macro-unqualified-import-cache-module-keys : (Array i64)
  (array.make-array i64 65536))
(define macro-unqualified-import-cache-name-keys : (Array i64)
  (array.make-array i64 65536))
(define macro-unqualified-import-cache-values : (Array i64)
  (array.make-array i64 65536))
(define macro-unqualified-import-cache-count : i64
  0)
(define macro-unqualified-import-cache-generation : i64
  -1)
(define macro-unqualified-import-cache-ready : bool
  false)
(define macro-flat-import-target-cache-capacity : i64
  1024)
(define macro-flat-import-target-cache-module-keys : (Array i64)
  (array.make-array i64 1024))
(define macro-flat-import-target-cache-values : (Array
    MacroFlatImportTargetList)
  (array.make-array MacroFlatImportTargetList 1024))
(define macro-flat-import-target-cache-count : i64
  0)
(define macro-flat-import-target-cache-generation : i64
  -1)
(define macro-flat-import-target-cache-ready : bool
  false)

;; The mapping is program-derived, so the cache must not survive into the next
;; program of a multi-program process (smoke batteries, REPL, LSP, package
;; builds). macro-expand-program and the REPL typecheck entry reset it at the
;; same per-program boundary that resets the CTFE-env and clone-able caches;
;; the intern generation gate additionally covers intern-reset! boundaries.
(define (macro-alias-derived-cache-reset!) : unit
  (begin
    (set! macro-alias-cache-ready false)
    (set! macro-unqualified-import-cache-ready false)
    (set! macro-flat-import-target-cache-ready false)
    (macro-surface-call-decl-cache-reset!)
    (macro-generated-fingerprint-cache-reset!)
    (tc-source-dotted-alias-key-cache-reset!)
    (tc-imported-module-identity-cache-reset!)))

(define (macro-alias-cache-reset!) : unit
  (begin
    (macro-alias-derived-cache-reset!)
    (tc-lazy-import-stubs-reset!)))

(define (macro-unqualified-import-cache-ensure!) : unit
  (if (if macro-unqualified-import-cache-ready
    (= macro-unqualified-import-cache-generation (intern-generation))
    false)
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i macro-unqualified-import-cache-capacity)
          (begin
            (array.array-set! macro-unqualified-import-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set! macro-unqualified-import-cache-count 0)
        (set! macro-unqualified-import-cache-generation (intern-generation))
        (set! macro-unqualified-import-cache-ready true)))))

(define (macro-unqualified-import-cache-bucket
  [module-id : i64]
  [name-id : i64]) : i64
  (bit-and
    (+ (* module-id 2654435761) (* name-id 40503))
    (- macro-unqualified-import-cache-capacity 1)))

;; Returns the cached target module id, -1 for "no imported macro", or -2 when
;; absent.
(define (macro-unqualified-import-cache-get [module-id : i64] [name-id : i64]) : i64
  (let
    [cursor : i64 (macro-unqualified-import-cache-bucket module-id name-id)]
    [module-key : i64 (+ module-id 1)]
    [name-key : i64 (+ name-id 1)]
    [steps : i64 0]
    [out : i64 -2]
    [done : bool false]
    (begin
      (while (if done
        false
        (< steps macro-unqualified-import-cache-capacity))
        (let
          [slot : i64
            (array.array-ref macro-unqualified-import-cache-module-keys cursor)]
          (if (= slot 0)
            (set! done true)
            (if (and
              (= slot module-key)
              (=
                (array.array-ref
                  macro-unqualified-import-cache-name-keys
                  cursor)
                name-key))
              (begin
                (set!
                  out
                  (array.array-ref macro-unqualified-import-cache-values cursor))
                (set! done true))
              (begin
                (set!
                  cursor
                  (bit-and
                    (+ cursor 1)
                    (- macro-unqualified-import-cache-capacity 1)))
                (set! steps (+ steps 1)))))))
      out)))

(define (macro-unqualified-import-cache-put!
  [module-id : i64]
  [name-id : i64]
  [value : i64]) : unit
  (if (>=
    (* macro-unqualified-import-cache-count 2)
    macro-unqualified-import-cache-capacity)
    unit
    (let
      [cursor : i64 (macro-unqualified-import-cache-bucket module-id name-id)]
      [module-key : i64 (+ module-id 1)]
      [name-key : i64 (+ name-id 1)]
      [steps : i64 0]
      [done : bool false]
      (begin
        (while (if done
          false
          (< steps macro-unqualified-import-cache-capacity))
          (let
            [slot : i64
              (array.array-ref
                macro-unqualified-import-cache-module-keys
                cursor)]
            (if (= slot 0)
              (begin
                (array.array-set!
                  macro-unqualified-import-cache-module-keys
                  cursor
                  module-key)
                (array.array-set!
                  macro-unqualified-import-cache-name-keys
                  cursor
                  name-key)
                (array.array-set!
                  macro-unqualified-import-cache-values
                  cursor
                  value)
                (set!
                  macro-unqualified-import-cache-count
                  (+ macro-unqualified-import-cache-count 1))
                (set! done true))
              (if (and
                (= slot module-key)
                (=
                  (array.array-ref
                    macro-unqualified-import-cache-name-keys
                    cursor)
                  name-key))
                (set! done true)
                (begin
                  (set!
                    cursor
                    (bit-and
                      (+ cursor 1)
                      (- macro-unqualified-import-cache-capacity 1)))
                  (set! steps (+ steps 1)))))))
        unit))))

(define (macro-flat-import-target-cache-ensure!) : unit
  (if (if macro-flat-import-target-cache-ready
    (= macro-flat-import-target-cache-generation (intern-generation))
    false)
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i macro-flat-import-target-cache-capacity)
          (begin
            (array.array-set! macro-flat-import-target-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set! macro-flat-import-target-cache-count 0)
        (set! macro-flat-import-target-cache-generation (intern-generation))
        (set! macro-flat-import-target-cache-ready true)))))

(define (macro-flat-import-target-cache-bucket [module-id : i64]) : i64
  (bit-and
    (* module-id 2654435761)
    (- macro-flat-import-target-cache-capacity 1)))

(define (macro-flat-import-target-cache-get [module-id : i64]) : MacroFlatImportTargetCacheLookup
  (let
    [cursor : i64 (macro-flat-import-target-cache-bucket module-id)]
    [module-key : i64 (+ module-id 1)]
    [steps : i64 0]
    [out : MacroFlatImportTargetCacheLookup
      (MacroFlatImportTargetCacheLookup.Missing)]
    [done : bool false]
    (begin
      (while (if done
        false
        (< steps macro-flat-import-target-cache-capacity))
        (let
          [slot : i64
            (array.array-ref macro-flat-import-target-cache-module-keys cursor)]
          (if (= slot 0)
            (set! done true)
            (if (= slot module-key)
              (begin
                (set!
                  out
                  (MacroFlatImportTargetCacheLookup.Hit
                    (array.array-ref
                      macro-flat-import-target-cache-values
                      cursor)))
                (set! done true))
              (begin
                (set!
                  cursor
                  (bit-and
                    (+ cursor 1)
                    (- macro-flat-import-target-cache-capacity 1)))
                (set! steps (+ steps 1)))))))
      out)))

(define (macro-flat-import-target-cache-put!
  [module-id : i64]
  [targets : MacroFlatImportTargetList]) : unit
  (if (>=
    (* macro-flat-import-target-cache-count 2)
    macro-flat-import-target-cache-capacity)
    unit
    (let
      [cursor : i64 (macro-flat-import-target-cache-bucket module-id)]
      [module-key : i64 (+ module-id 1)]
      [steps : i64 0]
      [done : bool false]
      (begin
        (while (if done
          false
          (< steps macro-flat-import-target-cache-capacity))
          (let
            [slot : i64
              (array.array-ref
                macro-flat-import-target-cache-module-keys
                cursor)]
            (if (= slot 0)
              (begin
                (array.array-set!
                  macro-flat-import-target-cache-module-keys
                  cursor
                  module-key)
                (array.array-set!
                  macro-flat-import-target-cache-values
                  cursor
                  targets)
                (set!
                  macro-flat-import-target-cache-count
                  (+ macro-flat-import-target-cache-count 1))
                (set! done true))
              (if (= slot module-key)
                (set! done true)
                (begin
                  (set!
                    cursor
                    (bit-and
                      (+ cursor 1)
                      (- macro-flat-import-target-cache-capacity 1)))
                  (set! steps (+ steps 1)))))))
        unit))))

(define (macro-flat-import-target-list-contains?
  [targets : MacroFlatImportTargetList]
  [target-id : i64]) : bool
  (match targets
    [(MacroFlatImportTargetList.Nil) false]
    [(MacroFlatImportTargetList.Cons target rest)
      (if (= target target-id)
        true
        (macro-flat-import-target-list-contains? (box-get rest) target-id))]))

(define (macro-flat-import-target-list-add
  [targets : MacroFlatImportTargetList]
  [target-id : i64]) : MacroFlatImportTargetList
  (if (macro-flat-import-target-list-contains? targets target-id)
    targets
    (MacroFlatImportTargetList.Cons target-id (box targets))))

(define (macro-flat-import-target-list-reverse-into
  [targets : MacroFlatImportTargetList]
  [out : MacroFlatImportTargetList]) : MacroFlatImportTargetList
  (match targets
    [(MacroFlatImportTargetList.Nil) out]
    [(MacroFlatImportTargetList.Cons target rest)
      (macro-flat-import-target-list-reverse-into
        (box-get rest)
        (MacroFlatImportTargetList.Cons target (box out)))]))

(define (macro-flat-import-target-list-reverse
  [targets : MacroFlatImportTargetList]) : MacroFlatImportTargetList
  (macro-flat-import-target-list-reverse-into
    targets
    (MacroFlatImportTargetList.Nil)))

(define (macro-flat-import-targets-from-list
  [decls : AstDeclList]
  [current-module-id : i64]
  [module-id : i64]
  [targets : MacroFlatImportTargetList]) : MacroFlatImportTargetList
  (match decls
    [(AstDeclNil) (macro-flat-import-target-list-reverse targets)]
    [(AstDeclCons decl rest-box)
      (let
        [rest : AstDeclList (box-get rest-box)]
        (match decl
          [(AstDeclModule next-module)
            (macro-flat-import-targets-from-list
              rest
              current-module-id
              next-module
              targets)]
          [(AstDeclImport (AstImportSpec _ _ expected maybe-alias _))
            (match maybe-alias
              [(AstSomeImportAlias alias)
                (if (and
                  (= module-id current-module-id)
                  (string.string-eq alias ""))
                  (match expected
                    [(AstSomeModuleName target-module)
                      (let
                        [target-id : i64 (intern target-module)]
                        (macro-flat-import-targets-from-list
                          rest
                          current-module-id
                          module-id
                          (if (= target-id current-module-id)
                            targets
                            (macro-flat-import-target-list-add
                              targets
                              target-id))))]
                    [(AstNoModuleName)
                      (macro-flat-import-targets-from-list
                        rest
                        current-module-id
                        module-id
                        targets)])
                  (macro-flat-import-targets-from-list
                    rest
                    current-module-id
                    module-id
                    targets))]
              [(AstNoImportAlias)
                (macro-flat-import-targets-from-list
                  rest
                  current-module-id
                  module-id
                  targets)])]
          [_
            (macro-flat-import-targets-from-list
              rest
              current-module-id
              module-id
              targets)]))]))

(define (macro-flat-import-targets
  [decls : AstDeclList]
  [current-module-id : i64]) : MacroFlatImportTargetList
  (begin
    (macro-flat-import-target-cache-ensure!)
    (match (macro-flat-import-target-cache-get current-module-id)
      [(MacroFlatImportTargetCacheLookup.Hit targets) targets]
      [(MacroFlatImportTargetCacheLookup.Missing)
        (let
          [targets : MacroFlatImportTargetList
            (macro-flat-import-targets-from-list
              decls
              current-module-id
              (intern "")
              (MacroFlatImportTargetList.Nil))]
          (begin
            (macro-flat-import-target-cache-put! current-module-id targets)
            targets))])))

(define (macro-alias-cache-ensure!) : unit
  (if (if macro-alias-cache-ready
    (= macro-alias-cache-generation (intern-generation))
    false)
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i macro-alias-cache-capacity)
          (begin
            (array.array-set! macro-alias-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set! macro-alias-cache-count 0)
        (set! macro-alias-cache-generation (intern-generation))
        (set! macro-alias-cache-ready true)))))

(define (macro-alias-cache-bucket [module-id : i64] [qualifier-id : i64]) : i64
  (bit-and
    (+ (* module-id 2654435761) qualifier-id)
    (- macro-alias-cache-capacity 1)))

;; Returns the cached value for `(module-id, qualifier-id)`, or -2 when absent.
(define (macro-alias-cache-get [module-id : i64] [qualifier-id : i64]) : i64
  (let
    [cursor : i64 (macro-alias-cache-bucket module-id qualifier-id)]
    [module-key : i64 (+ module-id 1)]
    [qualifier-key : i64 (+ qualifier-id 1)]
    [steps : i64 0]
    [out : i64 -2]
    [done : bool false]
    (begin
      (while (if done
        false
        (< steps macro-alias-cache-capacity))
        (let
          [slot : i64 (array.array-ref macro-alias-cache-module-keys cursor)]
          (if (= slot 0)
            (set! done true)
            (if (and
              (= slot module-key)
              (=
                (array.array-ref macro-alias-cache-qualifier-keys cursor)
                qualifier-key))
              (begin
                (set! out (array.array-ref macro-alias-cache-values cursor))
                (set! done true))
              (begin
                (set!
                  cursor
                  (bit-and (+ cursor 1) (- macro-alias-cache-capacity 1)))
                (set! steps (+ steps 1)))))))
      out)))

(define (macro-alias-cache-put!
  [module-id : i64]
  [qualifier-id : i64]
  [value : i64]) : unit
  (if (>= (* macro-alias-cache-count 2) macro-alias-cache-capacity)
    unit
    (let
      [cursor : i64 (macro-alias-cache-bucket module-id qualifier-id)]
      [module-key : i64 (+ module-id 1)]
      [qualifier-key : i64 (+ qualifier-id 1)]
      [steps : i64 0]
      [done : bool false]
      (begin
        (while (if done
          false
          (< steps macro-alias-cache-capacity))
          (let
            [slot : i64 (array.array-ref macro-alias-cache-module-keys cursor)]
            (if (= slot 0)
              (begin
                (array.array-set!
                  macro-alias-cache-module-keys
                  cursor
                  module-key)
                (array.array-set!
                  macro-alias-cache-qualifier-keys
                  cursor
                  qualifier-key)
                (array.array-set! macro-alias-cache-values cursor value)
                (set! macro-alias-cache-count (+ macro-alias-cache-count 1))
                (set! done true))
              (if (and
                (= slot module-key)
                (=
                  (array.array-ref macro-alias-cache-qualifier-keys cursor)
                  qualifier-key))
                (set! done true)
                (begin
                  (set!
                    cursor
                    (bit-and (+ cursor 1) (- macro-alias-cache-capacity 1)))
                  (set! steps (+ steps 1)))))))
        unit))))

(define (macro-import-alias-target-cached
  [decls : AstDeclList]
  [current-module-id : i64]
  [qualifier : String]) : TcMaybeString
  (begin
    (macro-alias-cache-ensure!)
    (let
      [qualifier-id : i64 (intern qualifier)]
      [cached : i64 (macro-alias-cache-get current-module-id qualifier-id)]
      (if (= cached -2)
        (match (macro-import-alias-target-ids
          decls
          current-module-id
          qualifier
          (intern ""))
          [(TcSomeString target)
            (let
              [target-id : i64 (intern target)]
              (begin
                (macro-alias-cache-put!
                  current-module-id
                  qualifier-id
                  target-id)
                (TcSomeString target)))]
          [(TcNoString)
            (begin
              (macro-alias-cache-put! current-module-id qualifier-id -1)
              (TcNoString))])
        (if (< cached 0)
          (TcNoString)
          (TcSomeString (intern-str cached)))))))

(define (macro-resolve-qualified-module
  [decls : AstDeclList]
  [current-module : String]
  [qualifier : String]) : String
  (match (macro-import-alias-target-cached
    decls
    (intern current-module)
    qualifier)
    [(TcSomeString target) target]
    [(TcNoString) qualifier]))

(define (macro-missing-macro-message [name : String]) : String
  (string.string-append "typecheck: missing macro " name))

(define (macro-qualified-call-decl-in-module
  [ctx : TcContext]
  [_decls : AstDeclList]
  [target-module : String]
  [base : String]
  [name : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (match (compiler-symbols-lookup-macro-in-module-id
    (tc-context-symbols ctx)
    (intern target-module)
    (intern base))
    ;; A macro that exists in the target module resolves directly from the
    ;; symbol table.
    [(SomeI64 handle)
      (match (macro-decl-at-index-in-module
        (tc-context-symbols ctx)
        (compiler-symbol-handle-index handle)
        target-module)
        [(MacroMaybeDecl.Some macro-name def-module params ret body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some macro-name def-module params ret body))]
        [(MacroMaybeDecl.No)
          (ResultMacroCallDecl.Err
            (box
              (ctfe-diagnostic-at-expr
                call-expr
                (macro-missing-macro-message name))))])]
    [(NoneI64)
      (match (macro-surface-call-decl-in-module target-module base)
        [(MacroMaybeDecl.Some macro-name def-module params ret body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some macro-name def-module params ret body))]
        [(MacroMaybeDecl.No)
          (match (compiler-symbols-lookup-value-in-module-id
            (tc-context-symbols ctx)
            (intern target-module)
            (intern base))
            [(SomeI64 _) (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))]
            [(NoneI64)
              (ResultMacroCallDecl.Err
                (box
                  (ctfe-diagnostic-at-expr
                    call-expr
                    (macro-missing-macro-message name))))])])]))

(define (macro-qualified-call-decl
  [ctx : TcContext]
  [decls : AstDeclList]
  [name : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (let
    [qualifier : String (tc-qualified-name-module name)]
    [base : String (tc-qualified-name-base name)]
    [target-module : String
      (macro-resolve-qualified-module decls (tc-context-module ctx) qualifier)]
    (macro-qualified-call-decl-in-module
      ctx
      decls
      target-module
      base
      name
      call-expr)))

;; The implicit core macro prelude module (stdlib/core_macros.tl). A bare name
;; that is not bound as a macro in the current module falls back to this module's
;; available macros, so `and`/`or`/`when`/`unless`/`cond` resolve without an
;; explicit import (#2060). Local macros and explicit imports therefore take
;; precedence over the prelude. Returns MacroMaybeDecl.No (an ordinary call, not an
;; error) when the name is not a prelude macro, leaving plain calls unaffected.
(define (macro-prelude-resolve-module
  [symbols : CompilerSymbols]
  [module-name : String]
  [lookup-name : String]) : ResultMacroCallDecl
  ;; The implicit core_macros prelude resolves its macros straight from the
  ;; module's symbol table. core_macros declares exactly the prelude macros, so
  ;; this resolves the same set (`and`, `or`, `when`, `unless`, `cond`).
  (match (compiler-symbols-lookup-macro-in-module-id
    symbols
    (intern module-name)
    (intern lookup-name))
    [(SomeI64 handle)
      (match (macro-decl-at-index-in-module
        symbols
        (compiler-symbol-handle-index handle)
        module-name)
        [(MacroMaybeDecl.Some macro-name def-module params ret body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some macro-name def-module params ret body))]
        [(MacroMaybeDecl.No) (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))])]
    [(NoneI64) (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))]))

(define (macro-prelude-resolve
  [symbols : CompilerSymbols]
  [lookup-name : String]) : ResultMacroCallDecl
  (match (macro-prelude-resolve-module symbols "stdlib.core_macros" lookup-name)
    [(ResultMacroCallDecl.Ok maybe-decl)
      (match maybe-decl
        [(MacroMaybeDecl.No)
          ;; Compatibility fallback for sources loaded with the old module
          ;; identity before the core_macros spelling migration.
          (macro-prelude-resolve-module
            symbols
            "stdlib.core-macros"
            lookup-name)]
        [_ (ResultMacroCallDecl.Ok maybe-decl)])]
    [(ResultMacroCallDecl.Err diag) (ResultMacroCallDecl.Err diag)]))

(define (macro-prelude-call-decl
  [ctx : TcContext]
  [_decls : AstDeclList]
  [lookup-name : String]
  [_call-expr : AstExpr]) : ResultMacroCallDecl
  (macro-prelude-resolve (tc-context-symbols ctx) lookup-name))

(define (macro-unqualified-imported-target-call-decl
  [ctx : TcContext]
  [target-module : String]
  [lookup-name : String]
  [_call-expr : AstExpr]) : ResultMacroCallDecl
  (match (compiler-symbols-lookup-macro-in-module-id
    (tc-context-symbols ctx)
    (intern target-module)
    (intern lookup-name))
    ;; Resolve an imported macro that exists in the target module directly from
    ;; the symbol table.
    [(SomeI64 handle)
      (match (macro-decl-at-index-in-module
        (tc-context-symbols ctx)
        (compiler-symbol-handle-index handle)
        target-module)
        [(MacroMaybeDecl.Some macro-name def-module params ret body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some macro-name def-module params ret body))]
        [(MacroMaybeDecl.No) (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))])]
    [(NoneI64)
      (match (macro-surface-call-decl-in-module target-module lookup-name)
        [(MacroMaybeDecl.Some macro-name def-module params ret body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some macro-name def-module params ret body))]
        [(MacroMaybeDecl.No) (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))])]))

(define (macro-unqualified-imported-call-target
  [ctx : TcContext]
  [target-module-id : i64]
  [lookup-name-id : i64]) : i64
  (match (compiler-symbols-lookup-macro-in-module-id
    (tc-context-symbols ctx)
    target-module-id
    lookup-name-id)
    ;; Any macro present in the target module is a resolution candidate.
    [(SomeI64 _) target-module-id]
    [(NoneI64)
      (if (macro-surface-macro-in-module?
        (intern-str target-module-id)
        (intern-str lookup-name-id))
        target-module-id
        -1)]))

(define (macro-unqualified-imported-call-target-from-imports
  [ctx : TcContext]
  [targets : MacroFlatImportTargetList]
  [lookup-name-id : i64]) : i64
  (match targets
    [(MacroFlatImportTargetList.Nil) -1]
    [(MacroFlatImportTargetList.Cons target-module-id rest-box)
      (let
        [target : i64
          (macro-unqualified-imported-call-target
            ctx
            target-module-id
            lookup-name-id)]
        (if (= target -1)
          (macro-unqualified-imported-call-target-from-imports
            ctx
            (box-get rest-box)
            lookup-name-id)
          target))]))

(define (macro-unqualified-imported-call-decl-from-target
  [ctx : TcContext]
  [target : i64]
  [lookup-name : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (if (>= target 0)
    (macro-unqualified-imported-target-call-decl
      ctx
      (intern-str target)
      lookup-name
      call-expr)
    (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))))

(define (macro-unqualified-imported-call-decl-cached
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]
  [lookup-name : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (let
    [module-id : i64 (intern module)]
    [lookup-name-id : i64 (intern lookup-name)]
    (begin
      (macro-unqualified-import-cache-ensure!)
      (let
        [cached : i64
          (macro-unqualified-import-cache-get module-id lookup-name-id)]
        [target : i64
          (if (= cached -2)
            (let
              [resolved : i64
                (macro-unqualified-imported-call-target-from-imports
                  ctx
                  (macro-flat-import-targets decls module-id)
                  lookup-name-id)]
              (begin
                (macro-unqualified-import-cache-put!
                  module-id
                  lookup-name-id
                  resolved)
                resolved))
            cached)]
        (macro-unqualified-imported-call-decl-from-target
          ctx
          target
          lookup-name
          call-expr)))))

(define (macro-unqualified-imported-call-decl
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]
  [lookup-name : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (macro-unqualified-imported-call-decl-cached
    ctx
    decls
    module
    lookup-name
    call-expr))

(define (macro-alias-self-call-decl
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]
  [lookup-name : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  ;; `(import stdlib.vector)` binds alias `vector`; module-scope `(vector T)`
  ;; should resolve to macro `vector` in that aliased module.
  (match (macro-import-alias-target-cached decls (intern module) lookup-name)
    [(TcSomeString target-module)
      (macro-unqualified-imported-target-call-decl
        ctx
        target-module
        lookup-name
        call-expr)]
    [(TcNoString) (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))]))

(define (macro-unqualified-call-decl-in-module
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]
  [lookup-name : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (match (compiler-symbols-lookup-macro-in-module-id
    (tc-context-symbols ctx)
    (intern module)
    (intern lookup-name))
    [(SomeI64 handle)
      (match (macro-decl-at-index-with-owner-module
        (tc-context-symbols ctx)
        (compiler-symbol-handle-index handle)
        module)
        [(MacroMaybeDecl.Some macro-name def-module params ret body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some macro-name def-module params ret body))]
        [(MacroMaybeDecl.No) (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))])]
    [(NoneI64)
      (match (macro-surface-call-decl-in-module module lookup-name)
        [(MacroMaybeDecl.Some macro-name def-module params ret body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some macro-name def-module params ret body))]
        [(MacroMaybeDecl.No)
          (match (macro-unqualified-imported-call-decl
            ctx
            decls
            module
            lookup-name
            call-expr)
            [(ResultMacroCallDecl.Ok imported-decl)
              (match imported-decl
                [(MacroMaybeDecl.No)
                  (macro-prelude-call-decl
                    (tc-context-with-module ctx module)
                    decls
                    lookup-name
                    call-expr)]
                [_ (ResultMacroCallDecl.Ok imported-decl)])]
            [(ResultMacroCallDecl.Err diag) (ResultMacroCallDecl.Err diag)])])]))

(define (macro-call-decl-from-name
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]
  [lookup-name : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (if (or
    (tc-name-qualified? lookup-name)
    (tc-source-slash-qualified? lookup-name))
    (macro-qualified-call-decl
      (tc-context-with-module ctx module)
      decls
      lookup-name
      call-expr)
    (macro-unqualified-call-decl-in-module
      ctx
      decls
      module
      lookup-name
      call-expr)))

(define (macro-call-decl-from-source-name
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]
  [lookup-name : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (if (tc-source-legacy-core-macro-compat? lookup-name)
    (macro-call-decl-from-name ctx decls module lookup-name call-expr)
    (let
      [source-ctx : TcContext (tc-context-with-module ctx module)]
      (match (tc-source-type-name-lookup-key source-ctx lookup-name)
        [(OkTcString resolved-name)
          (macro-call-decl-from-name ctx decls module resolved-name call-expr)]
        [(ErrTcString message)
          (ResultMacroCallDecl.Err
            (box (ctfe-diagnostic-at-expr call-expr message)))]))))

(define (macro-call-decl-from-hygiene-name
  [ctx : TcContext]
  [decls : AstDeclList]
  [definition-module : String]
  [lookup-name : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (if (and
    (>= (tc-name-first-dot lookup-name) 0)
    (not (tc-name-qualified? lookup-name))
    (not (tc-source-slash-qualified? lookup-name)))
    (macro-call-decl-from-source-name
      ctx
      decls
      definition-module
      lookup-name
      call-expr)
    (macro-call-decl-from-name
      ctx
      decls
      definition-module
      lookup-name
      call-expr)))

;; If `func` names a visible macro, return that macro's decl. Bare local macros
;; are module-scope visible regardless of source order; qualified macro calls
;; must pass the export table. A bare name not bound locally falls back to the
;; implicit core macro prelude.
(define (macro-call-decl
  [ctx : TcContext]
  [func : AstExpr]
  [decls : AstDeclList]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (match func
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-call-decl ctx inner decls call-expr))]
    [(AstExprVar name)
      (if (tc-hygiene-global-name? (intern-str name))
        (match (tc-hygiene-global-decode (intern-str name))
          [(TcHygieneLegacyGlobal lookup-name)
            (macro-call-decl-from-hygiene-name
              ctx
              decls
              (tc-context-module ctx)
              lookup-name
              call-expr)]
          [(TcHygieneContextGlobal module lookup-name)
            (macro-call-decl-from-hygiene-name
              ctx
              decls
              module
              lookup-name
              call-expr)])
        (macro-call-decl-from-source-name
          ctx
          decls
          (tc-context-module ctx)
          (intern-str name)
          call-expr))]
    [_ (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))]))

(define (macro-call-decl-with-self-alias
  [ctx : TcContext]
  [func : AstExpr]
  [decls : AstDeclList]
  [module : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (match (macro-call-decl
    (tc-context-with-module ctx module)
    func
    decls
    call-expr)
    [(ResultMacroCallDecl.Ok maybe-decl)
      (match maybe-decl
        [(MacroMaybeDecl.No)
          (match (ast-expr-unspan func)
            [(AstExprVar name)
              (let
                [lookup-name : String (intern-str name)]
                (if (or
                  (tc-hygiene-global-name? lookup-name)
                  (tc-name-qualified? lookup-name)
                  (>= (tc-name-first-dot lookup-name) 0))
                  (ResultMacroCallDecl.Ok maybe-decl)
                  (macro-alias-self-call-decl
                    ctx
                    decls
                    module
                    lookup-name
                    call-expr)))]
            [_ (ResultMacroCallDecl.Ok maybe-decl)])]
        [_ (ResultMacroCallDecl.Ok maybe-decl)])]
    [(ResultMacroCallDecl.Err diag) (ResultMacroCallDecl.Err diag)]))

(define (macro-call-decl-with-context
  [ctx : TcContext]
  [func : AstExpr]
  [decls : AstDeclList]
  [module : String]
  [context : AstMaybeModuleName]
  [call-expr : AstExpr]) : ResultMacroCallDeclModule
  (match (macro-call-decl-with-self-alias ctx func decls module call-expr)
    [(ResultMacroCallDecl.Ok maybe-decl)
      (match maybe-decl
        [(MacroMaybeDecl.No)
          (match context
            [(AstSomeModuleName context-module)
              (if (string.string-eq context-module module)
                (ResultMacroCallDeclModule.Ok maybe-decl module)
                (match (macro-call-decl-with-self-alias
                  ctx
                  func
                  decls
                  context-module
                  call-expr)
                  [(ResultMacroCallDecl.Ok context-decl)
                    (match context-decl
                      [(MacroMaybeDecl.No)
                        (ResultMacroCallDeclModule.Ok maybe-decl module)]
                      [_
                        (ResultMacroCallDeclModule.Ok
                          context-decl
                          context-module)])]
                  [(ResultMacroCallDecl.Err diag)
                    (ResultMacroCallDeclModule.Err diag)]))]
            [(AstNoModuleName) (ResultMacroCallDeclModule.Ok maybe-decl module)])]
        [_ (ResultMacroCallDeclModule.Ok maybe-decl module)])]
    [(ResultMacroCallDecl.Err primary-diag)
      (match context
        [(AstSomeModuleName context-module)
          (if (string.string-eq context-module module)
            (ResultMacroCallDeclModule.Err primary-diag)
            (match (macro-call-decl-with-self-alias
              ctx
              func
              decls
              context-module
              call-expr)
              [(ResultMacroCallDecl.Ok context-decl)
                (match context-decl
                  [(MacroMaybeDecl.No)
                    (ResultMacroCallDeclModule.Err primary-diag)]
                  [_ (ResultMacroCallDeclModule.Ok context-decl context-module)])]
              [(ResultMacroCallDecl.Err _)
                (ResultMacroCallDeclModule.Err primary-diag)]))]
        [(AstNoModuleName) (ResultMacroCallDeclModule.Err primary-diag)])]))

(define (macro-operand-mismatch-message [expected : AstType] [actual : AstType]) : String
  (str_cat.str-cat
    "typecheck: macro operand type mismatch: expected "
    (tc-type-render expected)
    ", got "
    (tc-type-render actual)))

(define (macro-clause-shape-message) : String
  "typecheck: ExprClause macro operand expects bracket clause [expr expr]")

(define (macro-binding-clause-shape-message) : String
  "typecheck: ExprBindingClause macro operand expects bracket clause [name expr] or [name : Type expr]")

(define (macro-clause-operand-mismatch-message [expected : AstType]) : String
  (str_cat.str-cat
    "typecheck: macro operand type mismatch: expected "
    (tc-type-render expected)
    ", got bracket clause"))

(define (macro-type-arg-module-qualify-name [ctx : TcContext] [name : i64]) : String
  (let
    [name-str : String (intern-str name)]
    [module : String (tc-context-module ctx)]
    (if (and
      (> (string.string-length module) 0)
      (not (tc-name-qualified? name-str))
      (not (tc-source-slash-qualified? name-str)))
      (str_cat.str-cat (tc-name-slashes-to-dots module) "." name-str)
      name-str)))

(define (macro-type-arg-module-qualify-list
  [ctx : TcContext]
  [types : AstTypeList]) : AstTypeList
  (match types
    [(AstTypeNil) AstTypeNil]
    [(AstTypeCons head rest)
      (ast-type-cons
        (macro-type-arg-module-qualify ctx (ty-node-get head))
        (macro-type-arg-module-qualify-list ctx (box-get rest)))]))

(define (macro-type-arg-module-qualify [ctx : TcContext] [ty : AstType]) : AstType
  (match ty
    [(AstTyFunc args ret)
      (ast-ty-func
        (macro-type-arg-module-qualify-list ctx (box-get args))
        (macro-type-arg-module-qualify ctx (ty-node-get ret)))]
    [(AstTyTuple elems)
      (ast-ty-tuple (macro-type-arg-module-qualify-list ctx (box-get elems)))]
    [(AstTyArray elem len)
      (ast-ty-array (macro-type-arg-module-qualify ctx (ty-node-get elem)) len)]
    [(AstTyDynArray elem)
      (ast-ty-dyn-array (macro-type-arg-module-qualify ctx (ty-node-get elem)))]
    [(AstTyBox elem)
      (ast-ty-box (macro-type-arg-module-qualify ctx (ty-node-get elem)))]
    [(AstTyPtr elem)
      (ast-ty-ptr (macro-type-arg-module-qualify ctx (ty-node-get elem)))]
    [(AstTyMutPtr elem)
      (ast-ty-mut-ptr (macro-type-arg-module-qualify ctx (ty-node-get elem)))]
    [(AstTyRef region inner)
      (ast-ty-ref
        region
        (macro-type-arg-module-qualify ctx (ty-node-get inner)))]
    [(AstTyMutRef region inner)
      (ast-ty-mut-ref
        region
        (macro-type-arg-module-qualify ctx (ty-node-get inner)))]
    [(AstTyRegion region inner)
      (ast-ty-region
        region
        (macro-type-arg-module-qualify ctx (ty-node-get inner)))]
    [(AstTyVar name)
      (AstTyVar (intern (macro-type-arg-module-qualify-name ctx name)))]
    [(AstTyVarArgs name lifetimes)
      (ast-ty-var-args
        (intern (macro-type-arg-module-qualify-name ctx name))
        (box-get lifetimes))]
    [_ ty]))

(define (macro-type-arg-reflections-from-decls [decls : AstDeclList]) : CtfeReflectInfoList
  (begin
    (ctfe-build-seen-reset!)
    (ctfe-reflections-from-decls
      decls
      ""
      (ctfe-reflect-info-list-with-capacity (ctfe-metadata-decl-capacity decls)))))

(define (macro-type-arg-reflect-resolve
  [ctx : TcContext]
  [decls : AstDeclList]
  [ty : AstType]) : AstType
  (let
    [infos : CtfeReflectInfoList (macro-type-arg-reflections-from-decls decls)]
    [reflected : AstType
      (ctfe-reflect-resolve-type-with-pools (tc-context-pools ctx) infos ty)]
    (if (tc-type-needs-resolution? reflected)
      (let
        [qualified-reflected : AstType
          (ctfe-reflect-resolve-type-with-pools
            (tc-context-pools ctx)
            infos
            (macro-type-arg-module-qualify ctx reflected))]
        (if (tc-type-needs-resolution? qualified-reflected)
          reflected
          qualified-reflected))
      reflected)))

(define (macro-type-arg-resolve
  [ctx : TcContext]
  [decls : AstDeclList]
  [ty : AstType]) : AstType
  (let
    [resolved : AstType (tc-resolve-type ctx ty)]
    (if (tc-type-needs-resolution? resolved)
      (let
        [reflected : AstType
          (macro-type-arg-reflect-resolve ctx decls resolved)]
        (if (tc-type-needs-resolution? reflected)
          (macro-type-arg-module-qualify ctx reflected)
          reflected))
      resolved)))

(define (macro-type-arg [ctx : TcContext] [decls : AstDeclList] [arg : AstExpr]) : ResultMacroTypeArg
  (match (ctfe-expr-to-type
    arg
    arg
    (ctfe-env-empty-with-pools (tc-context-pools ctx))
    (ctfe-fuel-limit))
    [(OkCtfeQuoteType ty _)
      (match (tc-source-type-policy-ok ctx ty)
        [(OkTcUnit)
          (ResultMacroTypeArg.Ok (macro-type-arg-resolve ctx decls ty))]
        [(ErrTcUnit message)
          (ResultMacroTypeArg.Err (box (ctfe-diagnostic-at-expr arg message)))])]
    [(ErrCtfeQuoteType diag) (ResultMacroTypeArg.Err diag)]))

(define (macro-type-arg-with-fallback
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [arg : AstExpr]) : ResultMacroTypeArg
  (match (macro-type-arg ctx decls arg)
    [(ResultMacroTypeArg.Ok resolved-ty) (ResultMacroTypeArg.Ok resolved-ty)]
    [(ResultMacroTypeArg.Err primary-diag)
      (if (string.string-eq fallback-module (tc-context-module ctx))
        (ResultMacroTypeArg.Err primary-diag)
        (match (macro-type-arg
          (tc-context-with-module ctx fallback-module)
          decls
          arg)
          [(ResultMacroTypeArg.Ok resolved-ty)
            (ResultMacroTypeArg.Ok resolved-ty)]
          [(ResultMacroTypeArg.Err _) (ResultMacroTypeArg.Err primary-diag)]))]))

(define (macro-module-strategy-unknown-message [name : String]) : String
  (str_cat.str-cat
    "typecheck: unknown module strategy "
    name
    "; import the module or use a visible dotted module alias"))

(define (macro-module-strategy-arg [ctx : TcContext] [arg : AstExpr]) : ResultMacroModuleArg
  (match (ast-expr-unspan arg)
    [(AstExprVar name-id)
      (let
        [name : String (intern-str name-id)]
        (if (tc-source-slash-qualified-id? name name-id)
          (ResultMacroModuleArg.Err
            (box
              (ctfe-diagnostic-at-expr
                arg
                (tc-source-slash-qualified-message name))))
          (match ctx
            [(TcContext program _ _ current-module _)
              (match program
                [(AstProgram decls-box)
                  (match (macro-import-alias-target-cached
                    (box-get decls-box)
                    (intern current-module)
                    name)
                    [(TcSomeString target) (ResultMacroModuleArg.Ok target)]
                    [(TcNoString)
                      (if (or
                        (string.string-eq name current-module)
                        (tc-imported-module-identity? ctx name))
                        (ResultMacroModuleArg.Ok name)
                        (ResultMacroModuleArg.Err
                          (box
                            (ctfe-diagnostic-at-expr
                              arg
                              (macro-module-strategy-unknown-message name)))))])])])))]
    [_
      (ResultMacroModuleArg.Err
        (box
          (ctfe-diagnostic-at-expr
            arg
            "typecheck: Module macro operand expects a module name")))]))

(define (macro-module-strategy-arg-with-fallback
  [ctx : TcContext]
  [fallback-module : String]
  [arg : AstExpr]) : ResultMacroModuleArg
  (match (macro-module-strategy-arg ctx arg)
    [(ResultMacroModuleArg.Ok module) (ResultMacroModuleArg.Ok module)]
    [(ResultMacroModuleArg.Err primary-diag)
      (if (string.string-eq fallback-module (tc-context-module ctx))
        (ResultMacroModuleArg.Err primary-diag)
        (match (macro-module-strategy-arg
          (tc-context-with-module ctx fallback-module)
          arg)
          [(ResultMacroModuleArg.Ok module) (ResultMacroModuleArg.Ok module)]
          [(ResultMacroModuleArg.Err _) (ResultMacroModuleArg.Err primary-diag)]))]))

(define (macro-expr-clause-from-items [arg : AstExpr] [items : AstExprList]) : ResultMacroClause
  (match items
    [(AstExprCons first rest1)
      (let
        [rest1 : AstExprList (box-get rest1)]
        (match rest1
          [(AstExprCons second rest2)
            (match (box-get rest2)
              [(AstExprNil)
                (ResultMacroClause.Ok (ast-expr-clause first second))]
              [_
                (ResultMacroClause.Err
                  (box
                    (ctfe-diagnostic-at-expr arg (macro-clause-shape-message))))])]
          [_
            (ResultMacroClause.Err
              (box (ctfe-diagnostic-at-expr arg (macro-clause-shape-message))))]))]
    [_
      (ResultMacroClause.Err
        (box (ctfe-diagnostic-at-expr arg (macro-clause-shape-message))))]))

(define (macro-expr-clause-from-arg [arg : AstExpr]) : ResultMacroClause
  (match (ast-expr-unspan arg)
    [(AstExprBracketClause items) (macro-expr-clause-from-items arg items)]
    [_
      (ResultMacroClause.Err
        (box
          (ctfe-diagnostic-at-expr
            arg
            "typecheck: ExprClause macro operand expects bracket syntax")))]))

(define (macro-expr-clause-list-from-args [args : AstExprList]) : ResultMacroClauseList
  (match args
    [(AstExprNil) (ResultMacroClauseList.Ok AstExprClauseNil)]
    [(AstExprCons head rest)
      (let
        [head-expr : AstExpr (ast-node-get head)]
        [rest : AstExprList (box-get rest)]
        (match (macro-expr-clause-from-arg head-expr)
          [(ResultMacroClause.Ok clause)
            (match (macro-expr-clause-list-from-args rest)
              [(ResultMacroClauseList.Ok clauses)
                (ResultMacroClauseList.Ok (ast-expr-clause-cons clause clauses))]
              [(ResultMacroClauseList.Err diag)
                (ResultMacroClauseList.Err diag)])]
          [(ResultMacroClause.Err diag) (ResultMacroClauseList.Err diag)]))]))

(define (macro-expr-span-or-zero [arg : AstExpr]) : AstSourceSpan
  (match arg
    [(AstExprSpanned _ span) span]
    [_ (AstSourceSpan 0 0 0 0)]))

(define (macro-expr-colon? [expr-id : i64]) : bool
  (match (ast-expr-unspan (ast-node-get expr-id))
    [(AstExprVar name) (= name (intern ":"))]
    [_ false]))

(define (macro-expr-binding-clause-shape-error [arg : AstExpr]) : ResultMacroBindingClause
  (ResultMacroBindingClause.Err
    (box (ctfe-diagnostic-at-expr arg (macro-binding-clause-shape-message)))))

(define (macro-expr-binding-clause-from-name
  [arg : AstExpr]
  [name : i64]
  [rest : AstExprList]) : ResultMacroBindingClause
  (match rest
    [(AstExprCons first rest1)
      (let
        [rest1 : AstExprList (box-get rest1)]
        (if (macro-expr-colon? first)
          (match rest1
            [(AstExprCons ty rest2)
              (let
                [rest2 : AstExprList (box-get rest2)]
                (match rest2
                  [(AstExprCons init rest3)
                    (match (box-get rest3)
                      [(AstExprNil)
                        (ResultMacroBindingClause.Ok
                          (ast-expr-binding-clause-id
                            name
                            true
                            ty
                            init
                            (macro-expr-span-or-zero arg)))]
                      [_ (macro-expr-binding-clause-shape-error arg)])]
                  [_ (macro-expr-binding-clause-shape-error arg)]))]
            [_ (macro-expr-binding-clause-shape-error arg)])
          (match rest1
            [(AstExprNil)
              (ResultMacroBindingClause.Ok
                (ast-expr-binding-clause-id
                  name
                  false
                  (ast-node-push (AstExprLiteral (AstLitUnit)))
                  first
                  (macro-expr-span-or-zero arg)))]
            [_ (macro-expr-binding-clause-shape-error arg)])))]
    [_ (macro-expr-binding-clause-shape-error arg)]))

(define (macro-expr-binding-clause-from-items
  [arg : AstExpr]
  [items : AstExprList]) : ResultMacroBindingClause
  (match items
    [(AstExprCons name-expr rest)
      (match (ast-expr-unspan (ast-node-get name-expr))
        [(AstExprVar name)
          (macro-expr-binding-clause-from-name arg name (box-get rest))]
        [_ (macro-expr-binding-clause-shape-error arg)])]
    [_ (macro-expr-binding-clause-shape-error arg)]))

(define (macro-expr-binding-clause-from-arg [arg : AstExpr]) : ResultMacroBindingClause
  (match (ast-expr-unspan arg)
    [(AstExprBracketClause items)
      (macro-expr-binding-clause-from-items arg items)]
    [_
      (ResultMacroBindingClause.Err
        (box
          (ctfe-diagnostic-at-expr
            arg
            "typecheck: ExprBindingClause macro operand expects bracket syntax")))]))

(define (macro-expr-binding-clause-list-from-args [args : AstExprList]) : ResultMacroBindingClauseList
  (match args
    [(AstExprNil) (ResultMacroBindingClauseList.Ok AstExprBindingClauseNil)]
    [(AstExprCons head rest)
      (let
        [head-expr : AstExpr (ast-node-get head)]
        [rest : AstExprList (box-get rest)]
        (match (macro-expr-binding-clause-from-arg head-expr)
          [(ResultMacroBindingClause.Ok clause)
            (match (macro-expr-binding-clause-list-from-args rest)
              [(ResultMacroBindingClauseList.Ok clauses)
                (ResultMacroBindingClauseList.Ok
                  (ast-expr-binding-clause-cons clause clauses))]
              [(ResultMacroBindingClauseList.Err diag)
                (ResultMacroBindingClauseList.Err diag)])]
          [(ResultMacroBindingClause.Err diag)
            (ResultMacroBindingClauseList.Err diag)]))]))

(define (macro-check-ordinary-operand
  [ctx : TcContext]
  [env : TcTypeEnv]
  [resolved-expected : AstType]
  [arg : AstExpr]) : ResultMacroCheck
  (if (tc-type-eq resolved-expected (AstTyExpr))
    ResultMacroCheck.Ok
    (match (tc-expr-with-expected-or-actual ctx env arg resolved-expected)
      [(OkTcType actual)
        (if (tc-type-compatible? resolved-expected actual)
          ResultMacroCheck.Ok
          (ResultMacroCheck.Err
            (box
              (tc-expr-diag
                arg
                (macro-operand-mismatch-message resolved-expected actual)))))]
      [(ErrTcType message)
        (ResultMacroCheck.Err
          (box
            (tc-expr-diag
              arg
              (string.string-append
                "typecheck: macro operand typecheck failed: "
                message))))])))

(define (macro-operand-bracket-clause? [arg : AstExpr]) : bool
  (match (ast-expr-unspan arg)
    [(AstExprBracketClause _) true]
    [_ false]))

(define (macro-check-operand
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expected : AstType]
  [arg : AstExpr]) : ResultMacroCheck
  (if (tc-macro-type-param-kind? expected)
    (match (macro-type-arg
      ctx
      (match (tc-context-program ctx)
        [(AstProgram decls-box) (box-get decls-box)])
      arg)
      [(ResultMacroTypeArg.Ok _) ResultMacroCheck.Ok]
      [(ResultMacroTypeArg.Err diag) (ResultMacroCheck.Err diag)])
    (let
      [resolved-expected : AstType
        (tc-resolve-type ctx (tc-macro-signature-type expected))]
      (cond
        [(tc-macro-expr-clause-type? resolved-expected)
          (match (macro-expr-clause-from-arg arg)
            [(ResultMacroClause.Ok _) ResultMacroCheck.Ok]
            [(ResultMacroClause.Err diag) (ResultMacroCheck.Err diag)])]
        [(tc-macro-expr-binding-clause-type? resolved-expected)
          (match (macro-expr-binding-clause-from-arg arg)
            [(ResultMacroBindingClause.Ok _) ResultMacroCheck.Ok]
            [(ResultMacroBindingClause.Err diag) (ResultMacroCheck.Err diag)])]
        [(macro-operand-bracket-clause? arg)
          (ResultMacroCheck.Err
            (box
              (ctfe-diagnostic-at-expr
                arg
                (macro-clause-operand-mismatch-message resolved-expected))))]
        [else (macro-check-ordinary-operand ctx env resolved-expected arg)]))))

(define (macro-check-variadic-operands
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expected : AstType]
  [args : AstExprList]) : ResultMacroCheck
  (match args
    [(AstExprNil) ResultMacroCheck.Ok]
    [(AstExprCons head rest)
      (let
        [head : AstExpr (ast-node-get head)]
        [rest : AstExprList (box-get rest)]
        (match (macro-check-operand ctx env expected head)
          [(ResultMacroCheck.Ok)
            (macro-check-variadic-operands ctx env expected rest)]
          [(ResultMacroCheck.Err diag) (ResultMacroCheck.Err diag)]))]))

(define (macro-param-expr-clause? [ctx : TcContext] [ty : AstType]) : bool
  (tc-macro-expr-clause-type?
    (tc-resolve-type ctx (tc-macro-signature-type ty))))

(define (macro-param-expr-binding-clause? [ctx : TcContext] [ty : AstType]) : bool
  (tc-macro-expr-binding-clause-type?
    (tc-resolve-type ctx (tc-macro-signature-type ty))))

(define (macro-captured-expr-produced-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [resolved-expected : AstType]
  [capture-expr-types : bool]
  [arg : AstExpr]) : AstType
  (if (tc-type-eq resolved-expected (AstTyExpr))
    (if capture-expr-types
      (match (tc-expr ctx env arg)
        [(OkTcType actual)
          (ctfe-captured-expr-type-with-pools
            (tc-context-pools ctx)
            (tc-resolve-type ctx actual))]
        [(ErrTcType _) (ctfe-untyped-expr-type)])
      (ctfe-untyped-expr-type))
    resolved-expected))

(define (macro-bind-variadic-param
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [name : i64]
  [ty : AstType]
  [args : AstExprList]
  [env : CtfeEnv]) : ResultMacroEnv
  (cond
    [(tc-macro-type-param-kind? ty)
      (ResultMacroEnv.Err
        (box
          (ctfe-diagnostic-at-expr
            (AstExprVar name)
            "typecheck: type macro operand cannot be variadic")))]
    [(tc-macro-module-param-kind? ty)
      (ResultMacroEnv.Err
        (box
          (ctfe-diagnostic-at-expr
            (AstExprVar name)
            "typecheck: Module macro operand cannot be variadic")))]
    [(macro-param-expr-clause? ctx ty)
      (match (macro-expr-clause-list-from-args args)
        [(ResultMacroClauseList.Ok clauses)
          (ResultMacroEnv.Ok
            (ctfe-env-extend env (intern-str name) (CtfeExprClauseList clauses)))]
        [(ResultMacroClauseList.Err diag) (ResultMacroEnv.Err diag)])]
    [(macro-param-expr-binding-clause? ctx ty)
      (match (macro-expr-binding-clause-list-from-args args)
        [(ResultMacroBindingClauseList.Ok clauses)
          (ResultMacroEnv.Ok
            (ctfe-env-extend
              env
              (intern-str name)
              (CtfeExprBindingClauseList clauses)))]
        [(ResultMacroBindingClauseList.Err diag) (ResultMacroEnv.Err diag)])]
    [else
      (match (macro-check-variadic-operands ctx type-env ty args)
        [(ResultMacroCheck.Ok)
          (ResultMacroEnv.Ok
            (ctfe-env-extend env (intern-str name) (CtfeExprList args)))]
        [(ResultMacroCheck.Err diag) (ResultMacroEnv.Err diag)])]))

(define (macro-bind-fixed-param
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [type-env : TcTypeEnv]
  [name : i64]
  [ty : AstType]
  [arg-id : i64]
  [arg-expr : AstExpr]
  [capture-expr-types : bool]
  [env : CtfeEnv]) : ResultMacroEnv
  (cond
    [(tc-macro-type-param-kind? ty)
      (match (macro-type-arg-with-fallback ctx decls fallback-module arg-expr)
        [(ResultMacroTypeArg.Ok resolved-ty)
          (ResultMacroEnv.Ok
            (ctfe-env-extend env (intern-str name) (CtfeType resolved-ty)))]
        [(ResultMacroTypeArg.Err diag) (ResultMacroEnv.Err diag)])]
    [(tc-macro-module-param-kind? ty)
      (match (macro-module-strategy-arg-with-fallback
        ctx
        fallback-module
        arg-expr)
        [(ResultMacroModuleArg.Ok module)
          (ResultMacroEnv.Ok
            (ctfe-env-extend-typed
              env
              (intern-str name)
              (CtfeString module)
              (AstTyString)))]
        [(ResultMacroModuleArg.Err diag) (ResultMacroEnv.Err diag)])]
    [(macro-param-expr-clause? ctx ty)
      (match (macro-expr-clause-from-arg arg-expr)
        [(ResultMacroClause.Ok clause)
          (ResultMacroEnv.Ok
            (ctfe-env-extend env (intern-str name) (CtfeExprClause clause)))]
        [(ResultMacroClause.Err diag) (ResultMacroEnv.Err diag)])]
    [(macro-param-expr-binding-clause? ctx ty)
      (match (macro-expr-binding-clause-from-arg arg-expr)
        [(ResultMacroBindingClause.Ok clause)
          (ResultMacroEnv.Ok
            (ctfe-env-extend
              env
              (intern-str name)
              (CtfeExprBindingClause clause)))]
        [(ResultMacroBindingClause.Err diag) (ResultMacroEnv.Err diag)])]
    [else
      (let
        [resolved-expected : AstType
          (tc-resolve-type ctx (tc-macro-signature-type ty))]
        (match (macro-check-operand ctx type-env ty arg-expr)
          [(ResultMacroCheck.Ok)
            (ResultMacroEnv.Ok
              (ctfe-env-extend
                env
                (intern-str name)
                (CtfeExpr
                  arg-id
                  (macro-captured-expr-produced-type
                    ctx
                    type-env
                    resolved-expected
                    capture-expr-types
                    arg-expr))))]
          [(ResultMacroCheck.Err diag) (ResultMacroEnv.Err diag)]))]))

;; Bind the unevaluated operand forms to the macro parameters as `Expr` values.
;; A trailing variadic parameter collects the remaining operands as an ExprList.
(define (macro-bind-params
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [type-env : TcTypeEnv]
  [params : AstMacroParamList]
  [args : AstExprList]
  [env : CtfeEnv]
  [capture-expr-types : bool]
  [call-expr : AstExpr]) : ResultMacroEnv
  (match params
    [(AstMacroParamNil)
      (match args
        [(AstExprNil) (ResultMacroEnv.Ok env)]
        [_
          (ResultMacroEnv.Err
            (box
              (ctfe-diagnostic-at-expr
                call-expr
                "macro call has too many arguments")))])]
    [(AstMacroParamCons param rest-params)
      (let
        [rest-params : AstMacroParamList (box-get rest-params)]
        (match param
          [(AstMacroParam pname pty variadic)
            (if variadic
              (macro-bind-variadic-param ctx type-env pname pty args env)
              (match args
                [(AstExprNil)
                  (ResultMacroEnv.Err
                    (box
                      (ctfe-diagnostic-at-expr
                        call-expr
                        "macro call has too few arguments")))]
                [(AstExprCons arg rest-args)
                  (let
                    [arg-expr : AstExpr (ast-node-get arg)]
                    [rest-args : AstExprList (box-get rest-args)]
                    (match (macro-bind-fixed-param
                      ctx
                      decls
                      fallback-module
                      type-env
                      pname
                      pty
                      arg
                      arg-expr
                      capture-expr-types
                      env)
                      [(ResultMacroEnv.Ok next-env)
                        (macro-bind-params
                          ctx
                          decls
                          fallback-module
                          type-env
                          rest-params
                          rest-args
                          next-env
                          capture-expr-types
                          call-expr)]
                      [(ResultMacroEnv.Err diag) (ResultMacroEnv.Err diag)]))]))]))]))

;; Run a macro transformer via CTFE. Module/declaration macro expansion also
;; needs the bound CTFE environment while normalizing generated import operands.
(define (macro-eval-transformer-expanded-with-env
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [type-env : TcTypeEnv]
  [macro-name : String]
  [params : AstMacroParamList]
  [body : AstExpr]
  [expanded-args : AstExprList]
  [call-expr : AstExpr]) : ResultMacroValueEnv
  (begin
    (tc-context-capture-active-pools! ctx)
    (match (macro-bind-params
      ctx
      decls
      fallback-module
      type-env
      params
      expanded-args
      (tc-ctfe-env ctx)
      (tc-string-list-contains macro-expand-expr-type-macro-names macro-name)
      call-expr)
      [(ResultMacroEnv.Ok env)
        (begin
          (cfg compile-profile (compiler-tc-macro-profile-start))
          (match (ctfe-eval-node
            body
            (ctfe-env-extend env (ctfe-hygiene-enabled-name) (CtfeBool true))
            (ctfe-fuel-limit))
            [(OkCtfe value _)
              (begin
                (ast-node-pool-context-install! (tc-context-pools ctx))
                (cfg
                  compile-profile
                  (compiler-tc-macro-profile-finish macro-name expanded-args))
                (ResultMacroValueEnv.Ok value env))]
            [(ErrCtfe diag)
              (begin
                (cfg
                  compile-profile
                  (compiler-tc-macro-profile-finish macro-name expanded-args))
                (ResultMacroValueEnv.Err diag))]))]
      [(ResultMacroEnv.Err diag) (ResultMacroValueEnv.Err diag)])))

;; Run a macro transformer via CTFE. Callers decide how to interpret the
;; returned syntax value for expression, module, or declaration positions.
(define (macro-eval-transformer-expanded
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [type-env : TcTypeEnv]
  [macro-name : String]
  [params : AstMacroParamList]
  [body : AstExpr]
  [expanded-args : AstExprList]
  [call-expr : AstExpr]) : ResultMacroValue
  (match (macro-eval-transformer-expanded-with-env
    ctx
    decls
    fallback-module
    type-env
    macro-name
    params
    body
    expanded-args
    call-expr)
    [(ResultMacroValueEnv.Ok value _) (ResultMacroValue.Ok value)]
    [(ResultMacroValueEnv.Err diag) (ResultMacroValue.Err diag)]))

(define (macro-eval-transformer
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [macro-name : String]
  [params : AstMacroParamList]
  [body : AstExpr]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]) : ResultMacroValue
  ;; Expand the operands first so a macro call passed as an argument (e.g. a
  ;; nested `str_cat.str-cat`) is reduced to a plain expression before it is typechecked
  ;; and bound; otherwise the operand typecheck sees the inner macro name as an
  ;; unbound value.
  (match (macro-expand-exprs ctx type-env decls depth args)
    [(ResultMacroExprList.Ok expanded-args)
      (macro-eval-transformer-expanded
        ctx
        decls
        (tc-context-module ctx)
        type-env
        macro-name
        params
        body
        expanded-args
        call-expr)]
    [(ResultMacroExprList.Err diag) (ResultMacroValue.Err diag)]))

(define (macro-generated-type-param-expr-list
  [env : CtfeEnv]
  [exprs : AstExprList]) : AstExprList
  (match exprs
    [(AstExprNil) AstExprNil]
    [(AstExprCons head rest)
      (let
        [head-expr : AstExpr (ast-node-get head)]
        [rest-exprs : AstExprList (box-get rest)]
        (ast-expr-cons
          (macro-generated-type-param-expr env head-expr)
          (macro-generated-type-param-expr-list env rest-exprs)))]))

(define (macro-generated-type-param-expr [env : CtfeEnv] [expr : AstExpr]) : i64
  (match expr
    [(AstExprSpanned inner-box span)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-spanned (macro-generated-type-param-expr env inner) span))]
    [(AstExprVar name)
      (let
        [lookup-name : String (macro-output-source-name (intern-str name))]
        (match (ctfe-env-lookup env lookup-name)
          [(CtfeSomeValue value)
            (match value
              [(CtfeType ty) (ast-node-push (AstExprTypeLiteral ty))]
              [_ (ast-node-push expr)])]
          [(CtfeNoValue) (ast-node-push expr)]))]
    [(AstExprCall func-box args)
      (ast-expr-call func-box (macro-generated-type-param-expr-list env args))]
    [_ (ast-node-push expr)]))

(define (macro-generated-call-func-for-lookup [expr : AstExpr]) : AstExpr
  (match (ast-expr-unspan expr)
    [(AstExprVar name)
      (AstExprVar (intern (macro-output-source-name (intern-str name))))]
    [_ expr]))

(define (macro-generated-import-type-arg
  [ty : AstType]
  [arg : i64]
  [env : CtfeEnv]) : i64
  (if (tc-macro-type-param-kind? ty)
    (macro-generated-type-param-expr env (ast-node-get arg))
    arg))

(define (macro-generated-import-type-args-for-param
  [param : AstMacroParam]
  [head : i64]
  [rest-args : AstExprList]
  [rest-params : AstMacroParamList]
  [args : AstExprList]
  [env : CtfeEnv]) : AstExprList
  (match param
    [(AstMacroParam _ ty variadic)
      (if variadic
        (if (tc-macro-type-param-kind? ty)
          (macro-generated-type-param-expr-list env args)
          args)
        (ast-expr-cons
          (macro-generated-import-type-arg ty head env)
          (macro-generated-import-type-args rest-params rest-args env)))]))

(define (macro-generated-import-type-args
  [params : AstMacroParamList]
  [args : AstExprList]
  [env : CtfeEnv]) : AstExprList
  (match params
    [(AstMacroParamNil) args]
    [(AstMacroParamCons param rest-params-box)
      (match args
        [(AstExprNil) AstExprNil]
        [(AstExprCons head rest-args-box)
          (macro-generated-import-type-args-for-param
            param
            head
            (box-get rest-args-box)
            (box-get rest-params-box)
            args
            env)])]))

(define (macro-rewrite-generated-import-call-with-decl
  [func-box : i64]
  [args : AstExprList]
  [env : CtfeEnv]
  [fallback : i64]
  [maybe-decl : MacroMaybeDecl]) : i64
  (match maybe-decl
    [(MacroMaybeDecl.Some _ _ params _ _)
      (ast-expr-call
        func-box
        (macro-generated-import-type-args params args env))]
    [(MacroMaybeDecl.No) fallback]))

(define (macro-rewrite-generated-import-direct-call
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]
  [func : AstExpr]
  [call-expr : AstExpr]
  [func-box : i64]
  [args : AstExprList]
  [env : CtfeEnv]
  [fallback : i64]) : i64
  (match (ast-expr-unspan func)
    [(AstExprVar name)
      (let
        [lookup-name : String (macro-output-source-name (intern-str name))]
        (if (or
          (tc-name-qualified? lookup-name)
          (tc-source-slash-qualified? lookup-name)
          (>= (tc-name-first-dot lookup-name) 0))
          fallback
          (match (macro-import-alias-target-cached
            decls
            (intern module)
            lookup-name)
            [(TcSomeString target)
              (match (macro-unqualified-imported-target-call-decl
                ctx
                target
                lookup-name
                call-expr)
                [(ResultMacroCallDecl.Ok maybe-decl)
                  (match maybe-decl
                    [(MacroMaybeDecl.Some _ _ _ _ _)
                      (macro-rewrite-generated-import-call-with-decl
                        func-box
                        args
                        env
                        fallback
                        maybe-decl)]
                    [(MacroMaybeDecl.No)
                      (ast-expr-call
                        func-box
                        (macro-generated-type-param-expr-list env args))])]
                [(ResultMacroCallDecl.Err _) fallback])]
            [(TcNoString) fallback])))]
    [_ fallback]))

(define (macro-rewrite-generated-import-call-id
  [ctx : TcContext]
  [orig-decls : AstDeclList]
  [module : String]
  [definition-module : String]
  [env : CtfeEnv]
  [call-id : i64]) : i64
  (let
    [call-expr : AstExpr (ast-node-get call-id)]
    (match (ast-expr-unspan call-expr)
      [(AstExprCall func-box args)
        (let
          [func : AstExpr (ast-node-get func-box)]
          [lookup-func : AstExpr (macro-generated-call-func-for-lookup func)]
          (match (macro-call-decl-with-context
            ctx
            lookup-func
            orig-decls
            module
            (AstSomeModuleName definition-module)
            call-expr)
            [(ResultMacroCallDeclModule.Ok maybe-decl _)
              (match maybe-decl
                [(MacroMaybeDecl.Some _ _ _ _ _)
                  (macro-rewrite-generated-import-call-with-decl
                    func-box
                    args
                    env
                    call-id
                    maybe-decl)]
                [(MacroMaybeDecl.No)
                  (macro-rewrite-generated-import-direct-call
                    ctx
                    orig-decls
                    module
                    lookup-func
                    call-expr
                    func-box
                    args
                    env
                    call-id)])]
            [(ResultMacroCallDeclModule.Err _)
              (macro-rewrite-generated-import-direct-call
                ctx
                orig-decls
                module
                lookup-func
                call-expr
                func-box
                args
                env
                call-id)]))]
      [_ call-id])))

(define (macro-rewrite-generated-import-kind
  [ctx : TcContext]
  [orig-decls : AstDeclList]
  [module : String]
  [definition-module : String]
  [env : CtfeEnv]
  [kind : AstImportKind]) : AstImportKind
  (match kind
    [(AstImportMacro call-id context)
      (AstImportMacro
        (macro-rewrite-generated-import-call-id
          ctx
          orig-decls
          module
          definition-module
          env
          call-id)
        context)]
    [(AstImportMacroDecls call-id context)
      (AstImportMacroDecls
        (macro-rewrite-generated-import-call-id
          ctx
          orig-decls
          module
          definition-module
          env
          call-id)
        context)]
    [_ kind]))

(define (macro-rewrite-generated-import-decl
  [ctx : TcContext]
  [orig-decls : AstDeclList]
  [module : String]
  [definition-module : String]
  [env : CtfeEnv]
  [decl : AstDecl]) : AstDecl
  (match decl
    [(AstDeclImport (AstImportSpec kind path expected alias span))
      (AstDeclImport
        (AstImportSpec
          (macro-rewrite-generated-import-kind
            ctx
            orig-decls
            module
            definition-module
            env
            kind)
          path
          expected
          alias
          span))]
    [(AstDeclUnsafe inner-box)
      (ast-decl-unsafe
        (macro-rewrite-generated-import-decl
          ctx
          orig-decls
          module
          definition-module
          env
          (box-get inner-box)))]
    [(AstDeclComptimeDecl meta inner-box)
      (ast-decl-comptime-decl-with-meta
        meta
        (macro-rewrite-generated-import-decl
          ctx
          orig-decls
          module
          definition-module
          env
          (box-get inner-box)))]
    [_ decl]))

(define (macro-rewrite-generated-import-decls-with-env
  [ctx : TcContext]
  [orig-decls : AstDeclList]
  [module : String]
  [definition-module : String]
  [env : CtfeEnv]
  [decls : AstDeclList]) : AstDeclList
  (match decls
    [(AstDeclNil) AstDeclNil]
    [(AstDeclCons decl rest)
      (ast-decl-cons
        (macro-rewrite-generated-import-decl
          ctx
          orig-decls
          module
          definition-module
          env
          decl)
        (macro-rewrite-generated-import-decls-with-env
          ctx
          orig-decls
          module
          definition-module
          env
          (box-get rest)))]))

(define (macro-rewrite-generated-import-decls
  [ctx : TcContext]
  [orig-decls : AstDeclList]
  [module : String]
  [definition-module : String]
  [env : CtfeEnv]
  [decls : AstDeclList]) : AstDeclList
  (let
    [rewrite-env : CtfeEnv
      (ctfe-env-extend
        (ctfe-env-rebase-pools env (tc-context-pools ctx))
        (ctfe-hygiene-enabled-name)
        (CtfeBool true))]
    (macro-rewrite-generated-import-decls-with-env
      ctx
      orig-decls
      module
      definition-module
      rewrite-env
      decls)))

;; Fast path for the hot stdlib.vector declaration macro. The macro body
;; is a deterministic quasiquote that emits a fixed growable-vector declaration
;; family, so building the AST directly avoids CTFE plus macro-output parsing.
(define (macro-vector-family-decls-macro?
  [macro-name : String]
  [definition-module : String]) : bool
  (and
    (string.string-eq definition-module "stdlib.vector")
    (tc-name-base-eq? macro-name "vector-family")))

(define (macro-vf-name-expr [expr : AstExpr]) : TcMaybeString
  (match (ast-expr-unspan expr)
    [(AstExprVar name) (TcSomeString (intern-str name))]
    [_ (TcNoString)]))

(define (macro-vf-var [name : String]) : i64
  (ast-node-push (AstExprVar (intern name))))

(define (macro-vf-lit-i64 [value : i64]) : i64
  (ast-node-push (AstExprLiteral (ast-lit-int value))))

(define (macro-vf-lit-bool [value : bool]) : i64
  (ast-node-push (AstExprLiteral (AstLitBool value))))

(define (macro-vf-unit) : i64
  (ast-node-push (AstExprLiteral AstLitUnit)))

(define (macro-vf-expr-list1 [a : i64]) : AstExprList
  (ast-expr-cons a AstExprNil))

(define (macro-vf-expr-list2 [a : i64] [b : i64]) : AstExprList
  (ast-expr-cons a (macro-vf-expr-list1 b)))

(define (macro-vf-expr-list3 [a : i64] [b : i64] [c : i64]) : AstExprList
  (ast-expr-cons a (macro-vf-expr-list2 b c)))

(define (macro-vf-expr-list4 [a : i64] [b : i64] [c : i64] [d : i64]) : AstExprList
  (ast-expr-cons a (macro-vf-expr-list3 b c d)))

(define (macro-vf-param [name : String] [ty : AstType]) : AstParam
  (ast-param name ty false))

(define (macro-vf-param-list1 [a : AstParam]) : AstParamList
  (ast-param-cons a AstParamNil))

(define (macro-vf-param-list2 [a : AstParam] [b : AstParam]) : AstParamList
  (ast-param-cons a (macro-vf-param-list1 b)))

(define (macro-vf-param-list3 [a : AstParam] [b : AstParam] [c : AstParam]) : AstParamList
  (ast-param-cons a (macro-vf-param-list2 b c)))

(define (macro-vf-param-list4
  [a : AstParam]
  [b : AstParam]
  [c : AstParam]
  [d : AstParam]) : AstParamList
  (ast-param-cons a (macro-vf-param-list3 b c d)))

(define (macro-vf-call [name : String] [args : AstExprList]) : i64
  (ast-expr-call (macro-vf-var name) args))

(define (macro-vf-call0 [name : String]) : i64
  (macro-vf-call name AstExprNil))

(define (macro-vf-call1 [name : String] [a : i64]) : i64
  (macro-vf-call name (macro-vf-expr-list1 a)))

(define (macro-vf-call2 [name : String] [a : i64] [b : i64]) : i64
  (macro-vf-call name (macro-vf-expr-list2 a b)))

(define (macro-vf-array-length [value : i64]) : i64
  (macro-vf-call1 "__tl_array-length" value))

(define (macro-vf-array-ty [elem-ty : AstType]) : AstType
  (ast-ty-dyn-array elem-ty))

(define (macro-vf-vec-ty [vec-name : String]) : AstType
  (AstTyVar (intern vec-name)))

(define (macro-vf-ref-ty [region : String] [inner : AstType]) : AstType
  (ast-ty-ref region inner))

(define (macro-vf-mut-ref-ty [region : String] [inner : AstType]) : AstType
  (ast-ty-mut-ref region inner))

(define (macro-vf-borrow [mutable : bool] [expr : i64]) : i64
  (ast-expr-borrow mutable (AstBorrowLifetimeInferred) expr))

(define (macro-vf-struct-get [target : String] [field : String]) : i64
  (ast-expr-struct-get-id (macro-vf-var target) (intern field)))

(define (macro-vf-struct-set [target : String] [field : String] [value : i64]) : i64
  (ast-expr-struct-set-id (macro-vf-var target) (intern field) value))

(define (macro-vf-begin2 [a : i64] [b : i64]) : i64
  (ast-node-push (AstExprBegin (macro-vf-expr-list2 a b))))

(define (macro-vf-struct-decl [vec-name : String] [elem-ty : AstType]) : AstDecl
  (let
    [slots-field : AstFieldDef
      (ast-field-def "slots" (macro-vf-array-ty elem-ty) AstFieldNoCleanup)]
    [len-field : AstFieldDef (ast-field-def "len" (AstTyI64) AstFieldNoCleanup)]
    (ast-decl-def-struct
      vec-name
      (AstStructReprDefault)
      (AstStructNoCleanup)
      (ast-field-def-cons
        slots-field
        (ast-field-def-cons len-field AstFieldDefNil)))))

(define (macro-vf-slots-decl
  [slots-name : String]
  [vec-name : String]
  [elem-ty : AstType]) : AstDecl
  (ast-decl-def-fn
    slots-name
    (macro-vf-param-list1
      (macro-vf-param "v" (macro-vf-ref-ty "v" (macro-vf-vec-ty vec-name))))
    (macro-vf-ref-ty "v" (macro-vf-array-ty elem-ty))
    (macro-vf-borrow false (macro-vf-struct-get "v" "slots"))))

(define (macro-vf-len-decl [len-name : String] [vec-name : String]) : AstDecl
  (ast-decl-def-fn
    len-name
    (macro-vf-param-list1
      (macro-vf-param "v" (macro-vf-ref-ty "v" (macro-vf-vec-ty vec-name))))
    (AstTyI64)
    (macro-vf-struct-get "v" "len")))

(define (macro-vf-capacity-decl
  [capacity-name : String]
  [slots-name : String]
  [vec-name : String]) : AstDecl
  (ast-decl-def-fn
    capacity-name
    (macro-vf-param-list1
      (macro-vf-param "v" (macro-vf-ref-ty "v" (macro-vf-vec-ty vec-name))))
    (AstTyI64)
    (macro-vf-array-length (macro-vf-call1 slots-name (macro-vf-var "v")))))

(define (macro-vf-with-capacity-decl
  [with-capacity-name : String]
  [vec-name : String]
  [elem-ty : AstType]) : AstDecl
  (let
    [capacity-var : i64 (macro-vf-var "capacity")]
    [cap-var : i64 (macro-vf-var "cap")]
    [cap-init : i64
      (ast-expr-if
        (ast-expr-binary (AstBinLt) capacity-var (macro-vf-lit-i64 1))
        (macro-vf-lit-i64 1)
        (macro-vf-var "capacity"))]
    [make-slots : i64 (ast-expr-make-array elem-ty cap-var)]
    [body : i64
      (macro-vf-call
        vec-name
        (macro-vf-expr-list2 make-slots (macro-vf-lit-i64 0)))]
    (ast-decl-def-fn
      with-capacity-name
      (macro-vf-param-list1 (macro-vf-param "capacity" (AstTyI64)))
      (macro-vf-vec-ty vec-name)
      (ast-expr-let
        (ast-let-binding-cons
          (ast-let-binding "cap" (AstSomeType (AstTyI64)) cap-init)
          AstLetBindingNil)
        body))))

(define (macro-vf-new-decl
  [new-name : String]
  [with-capacity-name : String]
  [vec-name : String]) : AstDecl
  (ast-decl-def-fn
    new-name
    AstParamNil
    (macro-vf-vec-ty vec-name)
    (macro-vf-call1 with-capacity-name (macro-vf-lit-i64 4))))

(define (macro-vf-bounds-check [len-expr : i64]) : i64
  (ast-expr-if
    (ast-expr-binary (AstBinGe) (macro-vf-var "index") (macro-vf-lit-i64 0))
    (ast-expr-binary (AstBinLt) (macro-vf-var "index") len-expr)
    (macro-vf-lit-bool false)))

(define (macro-vf-get-decl
  [get-name : String]
  [slots-name : String]
  [len-name : String]
  [vec-name : String]
  [elem-ty : AstType]) : AstDecl
  (ast-decl-def-fn
    get-name
    (macro-vf-param-list3
      (macro-vf-param "v" (macro-vf-ref-ty "v" (macro-vf-vec-ty vec-name)))
      (macro-vf-param "index" (AstTyI64))
      (macro-vf-param "fallback" elem-ty))
    elem-ty
    (ast-expr-if
      (macro-vf-bounds-check (macro-vf-call1 len-name (macro-vf-var "v")))
      (ast-expr-array-ref
        (macro-vf-call1 slots-name (macro-vf-var "v"))
        (macro-vf-var "index"))
      (macro-vf-var "fallback"))))

(define (macro-vf-set-decl
  [set-name : String]
  [vec-name : String]
  [elem-ty : AstType]) : AstDecl
  (ast-decl-def-fn
    set-name
    (macro-vf-param-list3
      (macro-vf-param "v" (macro-vf-mut-ref-ty "v" (macro-vf-vec-ty vec-name)))
      (macro-vf-param "index" (AstTyI64))
      (macro-vf-param "value" elem-ty))
    (AstTyUnit)
    (ast-expr-if
      (macro-vf-bounds-check (macro-vf-struct-get "v" "len"))
      (ast-expr-array-set
        (macro-vf-struct-get "v" "slots")
        (macro-vf-var "index")
        (macro-vf-var "value"))
      (macro-vf-unit))))

(define (macro-vf-copy-range-decl
  [copy-range-name : String]
  [elem-ty : AstType]) : AstDecl
  (ast-decl-def-fn
    copy-range-name
    (macro-vf-param-list4
      (macro-vf-param
        "dst"
        (macro-vf-mut-ref-ty "dst" (macro-vf-array-ty elem-ty)))
      (macro-vf-param "src" (macro-vf-ref-ty "src" (macro-vf-array-ty elem-ty)))
      (macro-vf-param "index" (AstTyI64))
      (macro-vf-param "count" (AstTyI64)))
    (AstTyUnit)
    (ast-expr-if
      (ast-expr-binary (AstBinGe) (macro-vf-var "index") (macro-vf-var "count"))
      (macro-vf-unit)
      (macro-vf-begin2
        (ast-expr-array-set
          (macro-vf-var "dst")
          (macro-vf-var "index")
          (ast-expr-array-ref (macro-vf-var "src") (macro-vf-var "index")))
        (macro-vf-call
          copy-range-name
          (macro-vf-expr-list4
            (macro-vf-var "dst")
            (macro-vf-var "src")
            (ast-expr-binary
              (AstBinAdd)
              (macro-vf-var "index")
              (macro-vf-lit-i64 1))
            (macro-vf-var "count")))))))

(define (macro-vf-grow-decl
  [grow-name : String]
  [copy-range-name : String]
  [vec-name : String]
  [elem-ty : AstType]) : AstDecl
  (let
    [n-init : i64 (macro-vf-struct-get "v" "len")]
    [old-cap-init : i64
      (macro-vf-array-length (macro-vf-struct-get "v" "slots"))]
    [new-cap-init : i64
      (ast-expr-if
        (ast-expr-binary
          (AstBinLt)
          (macro-vf-var "old-cap")
          (macro-vf-lit-i64 1))
        (macro-vf-lit-i64 1)
        (ast-expr-binary
          (AstBinMul)
          (macro-vf-var "old-cap")
          (macro-vf-lit-i64 2)))]
    [bigger-init : i64 (ast-expr-make-array elem-ty (macro-vf-var "new-cap"))]
    [copy-call : i64
      (macro-vf-call
        copy-range-name
        (macro-vf-expr-list4
          (macro-vf-borrow true (macro-vf-var "bigger"))
          (macro-vf-borrow false (macro-vf-struct-get "v" "slots"))
          (macro-vf-lit-i64 0)
          (macro-vf-var "n")))]
    [body : i64
      (macro-vf-begin2
        copy-call
        (macro-vf-struct-set "v" "slots" (macro-vf-var "bigger")))]
    (ast-decl-def-fn
      grow-name
      (macro-vf-param-list1
        (macro-vf-param
          "v"
          (macro-vf-mut-ref-ty "v" (macro-vf-vec-ty vec-name))))
      (AstTyUnit)
      (ast-expr-let
        (ast-let-binding-cons
          (ast-let-binding "n" (AstSomeType (AstTyI64)) n-init)
          (ast-let-binding-cons
            (ast-let-binding "old-cap" (AstSomeType (AstTyI64)) old-cap-init)
            (ast-let-binding-cons
              (ast-let-binding "new-cap" (AstSomeType (AstTyI64)) new-cap-init)
              (ast-let-binding-cons
                (ast-let-binding
                  "bigger"
                  (AstSomeType (macro-vf-array-ty elem-ty))
                  bigger-init)
                AstLetBindingNil))))
        body))))

(define (macro-vf-push-decl
  [push-name : String]
  [grow-name : String]
  [vec-name : String]
  [elem-ty : AstType]) : AstDecl
  (let
    [ensure-capacity : i64
      (ast-expr-if
        (ast-expr-binary
          (AstBinLt)
          (macro-vf-struct-get "v" "len")
          (macro-vf-array-length (macro-vf-struct-get "v" "slots")))
        (macro-vf-unit)
        (macro-vf-call1 grow-name (macro-vf-var "v")))]
    [push-body : i64
      (ast-expr-let
        (ast-let-binding-cons
          (ast-let-binding
            "index"
            (AstSomeType (AstTyI64))
            (macro-vf-struct-get "v" "len"))
          AstLetBindingNil)
        (macro-vf-begin2
          (ast-expr-array-set
            (macro-vf-struct-get "v" "slots")
            (macro-vf-var "index")
            (macro-vf-var "value"))
          (macro-vf-struct-set
            "v"
            "len"
            (ast-expr-binary
              (AstBinAdd)
              (macro-vf-var "index")
              (macro-vf-lit-i64 1)))))]
    (ast-decl-def-fn
      push-name
      (macro-vf-param-list2
        (macro-vf-param
          "v"
          (macro-vf-mut-ref-ty "v" (macro-vf-vec-ty vec-name)))
        (macro-vf-param "value" elem-ty))
      (AstTyUnit)
      (macro-vf-begin2 ensure-capacity push-body))))

(define (macro-vf-decls [elem-ty : AstType] [vec-name : String] [base : String]) : AstDeclList
  (let
    [slots-name : String (string.string-append base "-slots")]
    [len-name : String (string.string-append base "-len")]
    [capacity-name : String (string.string-append base "-capacity")]
    [with-capacity-name : String (string.string-append base "-with-capacity")]
    [new-name : String (string.string-append base "-new")]
    [get-name : String (string.string-append base "-get")]
    [set-name : String (string.string-append base "-set!")]
    [copy-range-name : String (string.string-append base "-copy-range")]
    [grow-name : String (string.string-append base "-grow")]
    [push-name : String (string.string-append base "-push")]
    (ast-decl-cons
      (macro-vf-struct-decl vec-name elem-ty)
      (ast-decl-cons
        (macro-vf-slots-decl slots-name vec-name elem-ty)
        (ast-decl-cons
          (macro-vf-len-decl len-name vec-name)
          (ast-decl-cons
            (macro-vf-capacity-decl capacity-name slots-name vec-name)
            (ast-decl-cons
              (macro-vf-with-capacity-decl with-capacity-name vec-name elem-ty)
              (ast-decl-cons
                (macro-vf-new-decl new-name with-capacity-name vec-name)
                (ast-decl-cons
                  (macro-vf-get-decl
                    get-name
                    slots-name
                    len-name
                    vec-name
                    elem-ty)
                  (ast-decl-cons
                    (macro-vf-set-decl set-name vec-name elem-ty)
                    (ast-decl-cons
                      (macro-vf-copy-range-decl copy-range-name elem-ty)
                      (ast-decl-cons
                        (macro-vf-grow-decl
                          grow-name
                          copy-range-name
                          vec-name
                          elem-ty)
                        (ast-decl-cons
                          (macro-vf-push-decl
                            push-name
                            grow-name
                            vec-name
                            elem-ty)
                          AstDeclNil)))))))))))))

(define (macro-vector-family-fast-arity-error [call-expr : AstExpr]) : ResultMacroParsedDecls
  (ResultMacroParsedDecls.Err
    (box
      (ctfe-diagnostic-at-expr
        call-expr
        "typecheck: vector-family expects exactly three arguments"))))

(define (macro-vector-family-fast-decls
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [args : AstExprList]
  [call-expr : AstExpr]) : ResultMacroParsedDecls
  (match args
    [(AstExprCons type-id rest1-box)
      (let
        [type-expr : AstExpr (ast-node-get type-id)]
        [rest1 : AstExprList (box-get rest1-box)]
        (match rest1
          [(AstExprCons vec-id rest2-box)
            (let
              [vec-expr : AstExpr (ast-node-get vec-id)]
              [rest2 : AstExprList (box-get rest2-box)]
              (match rest2
                [(AstExprCons prefix-id rest3-box)
                  (match (box-get rest3-box)
                    [(AstExprNil)
                      (match (macro-type-arg-with-fallback
                        ctx
                        decls
                        fallback-module
                        type-expr)
                        [(ResultMacroTypeArg.Ok elem-ty)
                          (match (macro-vf-name-expr vec-expr)
                            [(TcSomeString vec-name)
                              (match (macro-vf-name-expr
                                (ast-node-get prefix-id))
                                [(TcSomeString base)
                                  (ResultMacroParsedDecls.Ok
                                    (macro-vf-decls elem-ty vec-name base))]
                                [(TcNoString)
                                  (ResultMacroParsedDecls.Ok AstDeclNil)])]
                            [(TcNoString)
                              (ResultMacroParsedDecls.Ok AstDeclNil)])]
                        [(ResultMacroTypeArg.Err diag)
                          (ResultMacroParsedDecls.Err diag)])]
                    [_ (macro-vector-family-fast-arity-error call-expr)])]
                [_ (macro-vector-family-fast-arity-error call-expr)]))]
          [_ (macro-vector-family-fast-arity-error call-expr)]))]
    [_ (macro-vector-family-fast-arity-error call-expr)]))

;; The core prelude macros below are deterministic syntax rewrites. Expanding
;; them in the compiler avoids running the CTFE evaluator for thousands of hot
;; self-compile calls while preserving normal CTFE for user-defined macros.
(define (macro-core-prelude-module? [definition-module : String]) : bool
  (or
    (string-eq definition-module "stdlib.core_macros")
    (string-eq definition-module "stdlib.core-macros")))

(define (macro-core-fast-path-base [macro-name : String]) : String
  (if (tc-name-qualified? macro-name)
    (tc-qualified-name-base macro-name)
    macro-name))

(define (macro-core-fast-path-base-known? [base : String]) : bool
  (or
    (string-eq base "and")
    (string-eq base "or")
    (string-eq base "when")
    (string-eq base "unless")
    (string-eq base "cond")))

(define (macro-str-cat-module? [definition-module : String]) : bool
  (or
    (string-eq definition-module "stdlib.str_cat")
    (string-eq definition-module "stdlib.str-cat")))

(define (macro-str-cat-fast-path?
  [macro-name : String]
  [definition-module : String]) : bool
  (and
    (macro-str-cat-module? definition-module)
    (string-eq (macro-core-fast-path-base macro-name) "str-cat")))

(define (macro-core-fast-bool [value : bool]) : i64
  (ast-node-push (AstExprLiteral (AstLitBool value))))

(define (macro-core-fast-unit) : i64
  (ast-node-push (AstExprLiteral AstLitUnit)))

(define (macro-core-fast-var [name : String]) : i64
  (ast-node-push (AstExprVar (intern name))))

(define (macro-core-fast-string [value : String]) : i64
  (ast-node-push (AstExprLiteral (AstLitString value))))

(define (macro-core-fast-int [value : i64]) : i64
  (ast-node-push (AstExprLiteral (ast-lit-int value))))

(define (macro-core-fast-and [args : AstExprList]) : i64
  (match args
    [(AstExprNil) (macro-core-fast-bool true)]
    [(AstExprCons head rest)
      (ast-expr-if
        head
        (macro-core-fast-and (box-get rest))
        (macro-core-fast-bool false))]))

(define (macro-core-fast-or [args : AstExprList]) : i64
  (match args
    [(AstExprNil) (macro-core-fast-bool false)]
    [(AstExprCons head rest)
      (ast-expr-if
        head
        (macro-core-fast-bool true)
        (macro-core-fast-or (box-get rest)))]))

(define (macro-core-fast-arity-error [call-expr : AstExpr] [message : String]) : ResultMacroCompatCall
  (ResultMacroCompatCall.Err (box (ctfe-diagnostic-at-expr call-expr message))))

(define (macro-core-fast-guard
  [args : AstExprList]
  [is-unless : bool]
  [call-expr : AstExpr]) : ResultMacroCompatCall
  (match args
    [(AstExprCons cond rest)
      (match (box-get rest)
        [(AstExprCons body tail)
          (match (box-get tail)
            [(AstExprNil)
              (let
                [unit-expr : i64 (macro-core-fast-unit)]
                (if is-unless
                  (ResultMacroCompatCall.Ok (ast-expr-if cond unit-expr body))
                  (ResultMacroCompatCall.Ok (ast-expr-if cond body unit-expr))))]
            [_
              (macro-core-fast-arity-error
                call-expr
                "macro call has too many arguments")])]
        [(AstExprNil)
          (macro-core-fast-arity-error
            call-expr
            "macro call has too few arguments")])]
    [(AstExprNil)
      (macro-core-fast-arity-error call-expr "macro call has too few arguments")]))

(define (macro-core-fast-cond-else? [test : i64]) : bool
  (match (ast-expr-unspan (ast-node-get test))
    [(AstExprVar name) (string-eq (intern-str name) "else")]
    [_ false]))

(define (macro-core-fast-cond [clauses : AstExprClauseList]) : i64
  (match clauses
    [(AstExprClauseNil) (macro-core-fast-var "core-cond-missing-else")]
    [(AstExprClauseCons clause rest)
      (let
        [test : i64 (struct-get clause first)]
        [result : i64 (struct-get clause second)]
        [rest : AstExprClauseList (box-get rest)]
        (if (macro-core-fast-cond-else? test)
          (match rest
            [(AstExprClauseNil) result]
            [_ (macro-core-fast-var "core-cond-else-must-be-final")])
          (match rest
            [(AstExprClauseNil) (macro-core-fast-var "core-cond-missing-else")]
            [_ (ast-expr-if test result (macro-core-fast-cond rest))])))]))

(define (macro-core-fast-cond-call [args : AstExprList]) : ResultMacroCompatCall
  (match (macro-expr-clause-list-from-args args)
    [(ResultMacroClauseList.Ok clauses)
      (ResultMacroCompatCall.Ok (macro-core-fast-cond clauses))]
    [(ResultMacroClauseList.Err diag) (ResultMacroCompatCall.Err diag)]))

(define (macro-str-cat-fast-length [args : AstExprList]) : i64
  (match args
    [(AstExprNil) 0]
    [(AstExprCons _ rest) (+ 1 (macro-str-cat-fast-length (box-get rest)))]))

(define (macro-str-cat-fast-call
  [definition-module : String]
  [name : String]
  [args : AstExprList]) : i64
  (ast-expr-call
    (macro-core-fast-var
      (tc-hygiene-global-context-name definition-module name))
    args))

(define (macro-str-cat-fast-list1 [a : i64]) : AstExprList
  (ast-expr-cons a AstExprNil))

(define (macro-str-cat-fast-list2 [a : i64] [b : i64]) : AstExprList
  (ast-expr-cons a (macro-str-cat-fast-list1 b)))

(define (macro-str-cat-fast-list3 [a : i64] [b : i64] [c : i64]) : AstExprList
  (ast-expr-cons a (macro-str-cat-fast-list2 b c)))

(define (macro-str-cat-fast-list4 [a : i64] [b : i64] [c : i64] [d : i64]) : AstExprList
  (ast-expr-cons a (macro-str-cat-fast-list3 b c d)))

(define (macro-str-cat-fast-list5
  [a : i64]
  [b : i64]
  [c : i64]
  [d : i64]
  [e : i64]) : AstExprList
  (ast-expr-cons a (macro-str-cat-fast-list4 b c d e)))

(define (macro-array-module? [definition-module : String]) : bool
  (or
    (string-eq definition-module "stdlib.array")
    (string-eq definition-module "stdlib/array")))

(define (macro-array-fast-path-base-known? [base : String]) : bool
  (or
    (string-eq base "make-array")
    (string-eq base "array-length")
    (string-eq base "array-ref")
    (string-eq base "array-set!")
    (string-eq base "array-push!")))

(define (macro-array-fast-path?
  [macro-name : String]
  [definition-module : String]) : bool
  (and
    (macro-array-module? definition-module)
    (macro-array-fast-path-base-known? (macro-core-fast-path-base macro-name))))

(define (macro-array-fast-private-call [name : String] [args : AstExprList]) : i64
  (ast-expr-call (macro-core-fast-var name) args))

(define (macro-array-fast-make-array
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [macro-name : String]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]) : ResultMacroCompatCall
  (match args
    [(AstExprCons type-id rest1-box)
      (let
        [type-expr : AstExpr (ast-node-get type-id)]
        [rest1 : AstExprList (box-get rest1-box)]
        (match rest1
          [(AstExprCons count-id rest2-box)
            (match (box-get rest2-box)
              [(AstExprNil)
                (match (macro-type-arg-with-fallback
                  ctx
                  decls
                  (tc-context-module ctx)
                  type-expr)
                  [(ResultMacroTypeArg.Ok elem-ty)
                    (match (macro-expand-expr
                      ctx
                      type-env
                      decls
                      depth
                      (ast-node-get count-id))
                      [(ResultMacroExpr.Ok ncount)
                        (begin
                          (tc-context-capture-active-pools! ctx)
                          (macro-core-fast-profile-ok
                            macro-name
                            args
                            (ast-expr-make-array elem-ty ncount)))]
                      [(ResultMacroExpr.Err diag)
                        (ResultMacroCompatCall.Err diag)])]
                  [(ResultMacroTypeArg.Err diag)
                    (ResultMacroCompatCall.Err diag)])]
              [_
                (macro-core-fast-arity-error
                  call-expr
                  "typecheck: make-array expects exactly two arguments")])]
          [_
            (macro-core-fast-arity-error
              call-expr
              "typecheck: make-array expects exactly two arguments")]))]
    [_
      (macro-core-fast-arity-error
        call-expr
        "typecheck: make-array expects exactly two arguments")]))

(define (macro-array-fast-array-length
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [macro-name : String]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]) : ResultMacroCompatCall
  (match args
    [(AstExprCons items-id rest-box)
      (match (box-get rest-box)
        [(AstExprNil)
          (match (macro-expand-expr
            ctx
            type-env
            decls
            depth
            (ast-node-get items-id))
            [(ResultMacroExpr.Ok nitems)
              (begin
                (tc-context-capture-active-pools! ctx)
                (macro-core-fast-profile-ok
                  macro-name
                  args
                  (macro-array-fast-private-call
                    "__tl_array-length"
                    (macro-str-cat-fast-list1 nitems))))]
            [(ResultMacroExpr.Err diag) (ResultMacroCompatCall.Err diag)])]
        [_
          (macro-core-fast-arity-error
            call-expr
            "typecheck: array-length expects exactly one argument")])]
    [_
      (macro-core-fast-arity-error
        call-expr
        "typecheck: array-length expects exactly one argument")]))

(define (macro-array-fast-array-ref
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [macro-name : String]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]) : ResultMacroCompatCall
  (match args
    [(AstExprCons items-id rest1-box)
      (let
        [rest1 : AstExprList (box-get rest1-box)]
        (match rest1
          [(AstExprCons index-id rest2-box)
            (match (box-get rest2-box)
              [(AstExprNil)
                (match (macro-expand-expr
                  ctx
                  type-env
                  decls
                  depth
                  (ast-node-get items-id))
                  [(ResultMacroExpr.Ok nitems)
                    (match (macro-expand-expr
                      ctx
                      type-env
                      decls
                      depth
                      (ast-node-get index-id))
                      [(ResultMacroExpr.Ok nindex)
                        (begin
                          (tc-context-capture-active-pools! ctx)
                          (macro-core-fast-profile-ok
                            macro-name
                            args
                            (ast-expr-array-ref nitems nindex)))]
                      [(ResultMacroExpr.Err diag)
                        (ResultMacroCompatCall.Err diag)])]
                  [(ResultMacroExpr.Err diag) (ResultMacroCompatCall.Err diag)])]
              [_
                (macro-core-fast-arity-error
                  call-expr
                  "typecheck: array-ref expects exactly two arguments")])]
          [_
            (macro-core-fast-arity-error
              call-expr
              "typecheck: array-ref expects exactly two arguments")]))]
    [_
      (macro-core-fast-arity-error
        call-expr
        "typecheck: array-ref expects exactly two arguments")]))

(define (macro-array-fast-array-set
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [macro-name : String]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]) : ResultMacroCompatCall
  (match args
    [(AstExprCons items-id rest1-box)
      (let
        [rest1 : AstExprList (box-get rest1-box)]
        (match rest1
          [(AstExprCons index-id rest2-box)
            (let
              [rest2 : AstExprList (box-get rest2-box)]
              (match rest2
                [(AstExprCons value-id rest3-box)
                  (match (box-get rest3-box)
                    [(AstExprNil)
                      (match (macro-expand-expr
                        ctx
                        type-env
                        decls
                        depth
                        (ast-node-get items-id))
                        [(ResultMacroExpr.Ok nitems)
                          (match (macro-expand-expr
                            ctx
                            type-env
                            decls
                            depth
                            (ast-node-get index-id))
                            [(ResultMacroExpr.Ok nindex)
                              (match (macro-expand-expr
                                ctx
                                type-env
                                decls
                                depth
                                (ast-node-get value-id))
                                [(ResultMacroExpr.Ok nvalue)
                                  (begin
                                    (tc-context-capture-active-pools! ctx)
                                    (macro-core-fast-profile-ok
                                      macro-name
                                      args
                                      (ast-expr-array-set nitems nindex nvalue)))]
                                [(ResultMacroExpr.Err diag)
                                  (ResultMacroCompatCall.Err diag)])]
                            [(ResultMacroExpr.Err diag)
                              (ResultMacroCompatCall.Err diag)])]
                        [(ResultMacroExpr.Err diag)
                          (ResultMacroCompatCall.Err diag)])]
                    [_
                      (macro-core-fast-arity-error
                        call-expr
                        "typecheck: array-set! expects exactly three arguments")])]
                [_
                  (macro-core-fast-arity-error
                    call-expr
                    "typecheck: array-set! expects exactly three arguments")]))]
          [_
            (macro-core-fast-arity-error
              call-expr
              "typecheck: array-set! expects exactly three arguments")]))]
    [_
      (macro-core-fast-arity-error
        call-expr
        "typecheck: array-set! expects exactly three arguments")]))

(define (macro-array-fast-array-push
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [macro-name : String]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]) : ResultMacroCompatCall
  (match args
    [(AstExprCons items-id rest1-box)
      (let
        [rest1 : AstExprList (box-get rest1-box)]
        (match rest1
          [(AstExprCons value-id rest2-box)
            (match (box-get rest2-box)
              [(AstExprNil)
                (match (macro-expand-expr
                  ctx
                  type-env
                  decls
                  depth
                  (ast-node-get items-id))
                  [(ResultMacroExpr.Ok nitems)
                    (match (macro-expand-expr
                      ctx
                      type-env
                      decls
                      depth
                      (ast-node-get value-id))
                      [(ResultMacroExpr.Ok nvalue)
                        (begin
                          (tc-context-capture-active-pools! ctx)
                          (macro-core-fast-profile-ok
                            macro-name
                            args
                            (ast-expr-array-push nitems nvalue)))]
                      [(ResultMacroExpr.Err diag)
                        (ResultMacroCompatCall.Err diag)])]
                  [(ResultMacroExpr.Err diag) (ResultMacroCompatCall.Err diag)])]
              [_
                (macro-core-fast-arity-error
                  call-expr
                  "typecheck: array-push! expects exactly two arguments")])]
          [_
            (macro-core-fast-arity-error
              call-expr
              "typecheck: array-push! expects exactly two arguments")]))]
    [_
      (macro-core-fast-arity-error
        call-expr
        "typecheck: array-push! expects exactly two arguments")]))

(define (macro-array-fast-expand
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [macro-name : String]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]) : ResultMacroCompatCall
  (let
    [base : String (macro-core-fast-path-base macro-name)]
    (cond
      [(string-eq base "make-array")
        (macro-array-fast-make-array
          ctx
          type-env
          decls
          macro-name
          args
          depth
          call-expr)]
      [(string-eq base "array-length")
        (macro-array-fast-array-length
          ctx
          type-env
          decls
          macro-name
          args
          depth
          call-expr)]
      [(string-eq base "array-ref")
        (macro-array-fast-array-ref
          ctx
          type-env
          decls
          macro-name
          args
          depth
          call-expr)]
      [(string-eq base "array-set!")
        (macro-array-fast-array-set
          ctx
          type-env
          decls
          macro-name
          args
          depth
          call-expr)]
      [else
        (macro-array-fast-array-push
          ctx
          type-env
          decls
          macro-name
          args
          depth
          call-expr)])))

(define (macro-str-cat-fast-pack
  [definition-module : String]
  [parts : i64]
  [index : i64]
  [args : AstExprList]) : i64
  (match args
    [(AstExprNil) parts]
    [(AstExprCons head rest)
      (macro-str-cat-fast-pack
        definition-module
        (macro-str-cat-fast-call
          definition-module
          "stdlib.string.string-concat-all-pack-part"
          (macro-str-cat-fast-list3 parts (macro-core-fast-int index) head))
        (+ index 1)
        (box-get rest))]))

(define (macro-str-cat-fast-nth [args : AstExprList] [index : i64]) : i64
  (match args
    [(AstExprCons head rest)
      (if (= index 0)
        head
        (macro-str-cat-fast-nth (box-get rest) (- index 1)))]
    [(AstExprNil) (macro-core-fast-string "")]))

(define (macro-str-cat-fast-expand
  [definition-module : String]
  [args : AstExprList]) : i64
  (let
    [arity : i64 (macro-str-cat-fast-length args)]
    (cond
      [(= arity 0) (macro-core-fast-string "")]
      [(= arity 1) (macro-str-cat-fast-nth args 0)]
      [(= arity 2)
        (macro-str-cat-fast-call
          definition-module
          "stdlib.string.string-concat3"
          (macro-str-cat-fast-list3
            (macro-str-cat-fast-nth args 0)
            (macro-str-cat-fast-nth args 1)
            (macro-core-fast-string "")))]
      [(= arity 3)
        (macro-str-cat-fast-call
          definition-module
          "stdlib.string.string-concat3"
          (macro-str-cat-fast-list3
            (macro-str-cat-fast-nth args 0)
            (macro-str-cat-fast-nth args 1)
            (macro-str-cat-fast-nth args 2)))]
      [(= arity 4)
        (macro-str-cat-fast-call
          definition-module
          "stdlib.string.string-concat4"
          (macro-str-cat-fast-list4
            (macro-str-cat-fast-nth args 0)
            (macro-str-cat-fast-nth args 1)
            (macro-str-cat-fast-nth args 2)
            (macro-str-cat-fast-nth args 3)))]
      [(= arity 5)
        (macro-str-cat-fast-call
          definition-module
          "stdlib.string.string-concat5"
          (macro-str-cat-fast-list5
            (macro-str-cat-fast-nth args 0)
            (macro-str-cat-fast-nth args 1)
            (macro-str-cat-fast-nth args 2)
            (macro-str-cat-fast-nth args 3)
            (macro-str-cat-fast-nth args 4)))]
      [else
        (macro-str-cat-fast-call
          definition-module
          "stdlib.string.string-concat-all"
          (macro-str-cat-fast-list1
            (macro-str-cat-fast-pack
              definition-module
              (ast-expr-make-array (AstTyString) (macro-core-fast-int arity))
              0
              args)))])))

(define (macro-core-fast-profile-ok
  [_macro-name : String]
  [_args : AstExprList]
  [expanded : i64]) : ResultMacroCompatCall
  (begin
    (cfg compile-profile (compiler-tc-macro-profile-start))
    (cfg compile-profile (compiler-tc-macro-profile-finish _macro-name _args))
    (ResultMacroCompatCall.Ok expanded)))

(define (macro-core-fast-profile-result
  [macro-name : String]
  [args : AstExprList]
  [result : ResultMacroCompatCall]) : ResultMacroCompatCall
  (match result
    [(ResultMacroCompatCall.Ok expanded)
      (macro-core-fast-profile-ok macro-name args expanded)]
    [(ResultMacroCompatCall.Err diag) (ResultMacroCompatCall.Err diag)]
    [(ResultMacroCompatCall.No) (ResultMacroCompatCall.No)]))

(define (macro-core-fast-expand
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [macro-name : String]
  [definition-module : String]
  [params : AstMacroParamList]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]) : ResultMacroCompatCall
  (cond
    [(macro-array-fast-path? macro-name definition-module)
      (macro-array-fast-expand
        ctx
        type-env
        decls
        macro-name
        args
        depth
        call-expr)]
    [(macro-str-cat-fast-path? macro-name definition-module)
      (match (macro-expand-exprs ctx type-env decls depth args)
        [(ResultMacroExprList.Ok expanded-args)
          (begin
            (tc-context-capture-active-pools! ctx)
            (match (macro-bind-params
              ctx
              decls
              (tc-context-module ctx)
              type-env
              params
              expanded-args
              (tc-ctfe-env ctx)
              (tc-string-list-contains
                macro-expand-expr-type-macro-names
                macro-name)
              call-expr)
              [(ResultMacroEnv.Ok _)
                (macro-core-fast-profile-ok
                  macro-name
                  expanded-args
                  (macro-str-cat-fast-expand definition-module expanded-args))]
              [(ResultMacroEnv.Err diag) (ResultMacroCompatCall.Err diag)]))]
        [(ResultMacroExprList.Err diag) (ResultMacroCompatCall.Err diag)])]
    [(macro-core-prelude-module? definition-module)
      (let
        [base : String (macro-core-fast-path-base macro-name)]
        (if (macro-core-fast-path-base-known? base)
          (match (macro-expand-exprs ctx type-env decls depth args)
            [(ResultMacroExprList.Ok expanded-args)
              (begin
                (tc-context-capture-active-pools! ctx)
                (match (macro-bind-params
                  ctx
                  decls
                  (tc-context-module ctx)
                  type-env
                  params
                  expanded-args
                  (tc-ctfe-env ctx)
                  (tc-string-list-contains
                    macro-expand-expr-type-macro-names
                    macro-name)
                  call-expr)
                  [(ResultMacroEnv.Ok _)
                    (cond
                      [(string-eq base "and")
                        (macro-core-fast-profile-ok
                          macro-name
                          expanded-args
                          (macro-core-fast-and expanded-args))]
                      [(string-eq base "or")
                        (macro-core-fast-profile-ok
                          macro-name
                          expanded-args
                          (macro-core-fast-or expanded-args))]
                      [(string-eq base "when")
                        (macro-core-fast-profile-result
                          macro-name
                          expanded-args
                          (macro-core-fast-guard expanded-args false call-expr))]
                      [(string-eq base "unless")
                        (macro-core-fast-profile-result
                          macro-name
                          expanded-args
                          (macro-core-fast-guard expanded-args true call-expr))]
                      [else
                        (macro-core-fast-profile-result
                          macro-name
                          expanded-args
                          (macro-core-fast-cond-call expanded-args))])]
                  [(ResultMacroEnv.Err diag) (ResultMacroCompatCall.Err diag)]))]
            [(ResultMacroExprList.Err diag) (ResultMacroCompatCall.Err diag)])
          (ResultMacroCompatCall.No)))]
    [else (ResultMacroCompatCall.No)]))

;; Run an expression-position macro transformer via CTFE and re-expand its
;; produced form to a fixpoint.
(define (macro-expand-call
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [macro-name : String]
  [definition-module : String]
  [params : AstMacroParamList]
  [ret : AstType]
  [body : AstExpr]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]) : ResultMacroExpr
  (if (tc-macro-result-module? ret)
    (ResultMacroExpr.Err
      (box
        (ctfe-diagnostic-at-expr
          call-expr
          "typecheck: Module macro can only be used in import position")))
    (if (tc-macro-result-decls? ret)
      (ResultMacroExpr.Err
        (box
          (ctfe-diagnostic-at-expr
            call-expr
            "typecheck: Decls macro can only be used at module scope")))
      (match (macro-core-fast-expand
        ctx
        type-env
        decls
        macro-name
        definition-module
        params
        args
        depth
        call-expr)
        [(ResultMacroCompatCall.Ok expanded) (ResultMacroExpr.Ok expanded)]
        [(ResultMacroCompatCall.Err diag) (ResultMacroExpr.Err diag)]
        [(ResultMacroCompatCall.No)
          (match (macro-eval-transformer
            ctx
            type-env
            decls
            macro-name
            params
            body
            args
            depth
            call-expr)
            [(ResultMacroValue.Ok value)
              (match value
                [(CtfeExpr expanded produced)
                  (if (tc-macro-produced-type-compatible? ctx ret produced)
                    (macro-expand-expr
                      ctx
                      type-env
                      decls
                      (+ depth 1)
                      (ast-node-get
                        (macro-hygiene-expr
                          (ast-node-get expanded)
                          MacroHygieneEnv.Nil
                          (macro-hygiene-context-macro-name
                            macro-name
                            definition-module)
                          (+ depth 1))))
                    (ResultMacroExpr.Err
                      (box
                        (ctfe-diagnostic-at-expr
                          call-expr
                          "typecheck: macro expansion produced type does not match declaration"))))]
                [_
                  (ResultMacroExpr.Err
                    (box
                      (ctfe-diagnostic-at-expr
                        call-expr
                        "macro transformer did not produce an Expr")))])]
            [(ResultMacroValue.Err diag) (ResultMacroExpr.Err diag)])]))))

(define (macro-expand-exprs
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [exprs : AstExprList]) : ResultMacroExprList
  (match exprs
    [(AstExprNil) (ResultMacroExprList.Ok (AstExprNil))]
    [(AstExprCons head rest)
      (let
        [head : AstExpr (ast-node-get head)]
        [rest : AstExprList (box-get rest)]
        (match (macro-expand-expr ctx env decls depth head)
          [(ResultMacroExpr.Ok nhead)
            (match (macro-expand-exprs ctx env decls depth rest)
              [(ResultMacroExprList.Ok nrest)
                (ResultMacroExprList.Ok (ast-expr-cons nhead nrest))]
              [(ResultMacroExprList.Err diag) (ResultMacroExprList.Err diag)])]
          [(ResultMacroExpr.Err diag) (ResultMacroExprList.Err diag)]))]))

(define (macro-expand-arms
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : ResultMacroArms
  (match arms
    [(AstMatchArmNil) (ResultMacroArms.Ok (AstMatchArmNil))]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm pattern body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (match (tc-bind-match-pattern ctx env scrut-ty pattern)
                [(OkTcEnv arm-env)
                  (match (macro-expand-expr ctx arm-env decls depth body)
                    [(ResultMacroExpr.Ok nbody)
                      (match (macro-expand-arms
                        ctx
                        env
                        decls
                        depth
                        scrut-ty
                        rest)
                        [(ResultMacroArms.Ok nrest)
                          (ResultMacroArms.Ok
                            (ast-match-arm-cons
                              (ast-match-arm pattern nbody)
                              nrest))]
                        [(ResultMacroArms.Err diag) (ResultMacroArms.Err diag)])]
                    [(ResultMacroExpr.Err diag) (ResultMacroArms.Err diag)])]
                [(ErrTcEnv message)
                  (ResultMacroArms.Err (box (tc-expr-diag body message)))]))]))]))

(define (macro-expand-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [bindings : AstLetBindingList]) : ResultMacroLetBindings
  (match bindings
    [(AstLetBindingNil) (ResultMacroLetBindings.Ok (AstLetBindingNil) env)]
    [(AstLetBindingCons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding name maybe-ty init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (match (macro-expand-expr ctx env decls depth init)
                [(ResultMacroExpr.Ok ninit)
                  (match (tc-let-bindings
                    ctx
                    env
                    (ast-let-binding-cons
                      (ast-let-binding-id name maybe-ty ninit)
                      AstLetBindingNil))
                    [(OkTcEnv next-env)
                      (match (macro-expand-bindings
                        ctx
                        next-env
                        decls
                        depth
                        rest)
                        [(ResultMacroLetBindings.Ok nrest final-env)
                          (ResultMacroLetBindings.Ok
                            (ast-let-binding-cons
                              (ast-let-binding-id name maybe-ty ninit)
                              nrest)
                            final-env)]
                        [(ResultMacroLetBindings.Err diag)
                          (ResultMacroLetBindings.Err diag)])]
                    [(ErrTcEnv message)
                      (ResultMacroLetBindings.Err
                        (box (tc-expr-diag (ast-node-get ninit) message)))])]
                [(ResultMacroExpr.Err diag) (ResultMacroLetBindings.Err diag)]))]))]))

(define (macro-compat-unit-expr) : i64
  (ast-node-push (AstExprLiteral AstLitUnit)))

(define (macro-compat-append-unit [exprs : AstExprList]) : AstExprList
  (match exprs
    [(AstExprNil) (ast-expr-cons (macro-compat-unit-expr) AstExprNil)]
    [(AstExprCons head rest)
      (let
        [rest : AstExprList (box-get rest)]
        (ast-expr-cons head (macro-compat-append-unit rest)))]))

(define (macro-compat-call-name [func : AstExpr]) : TcMaybeString
  (match (ast-expr-unspan func)
    [(AstExprVar name) (TcSomeString (intern-str name))]
    [_ (TcNoString)]))

(define (macro-compat-guard-message [name : String]) : String
  (if (string.string-eq name "unless")
    "parse: unless expects a condition and at least one body expression"
    "parse: when expects a condition and at least one body expression"))

(define (macro-expand-compat-guard-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [cond : AstExpr]
  [body : AstExprList]
  [is-unless : bool]) : ResultMacroCompatCall
  (match (macro-expand-expr ctx env decls depth cond)
    [(ResultMacroExpr.Ok ncond)
      (match (macro-expand-exprs ctx env decls depth body)
        [(ResultMacroExprList.Ok nbody)
          (let
            [unit-expr : i64 (macro-compat-unit-expr)]
            [body-expr : i64
              (ast-node-push (AstExprBegin (macro-compat-append-unit nbody)))]
            (if is-unless
              (ResultMacroCompatCall.Ok (ast-expr-if ncond unit-expr body-expr))
              (ResultMacroCompatCall.Ok (ast-expr-if ncond body-expr unit-expr))))]
        [(ResultMacroExprList.Err diag) (ResultMacroCompatCall.Err diag)])]
    [(ResultMacroExpr.Err diag) (ResultMacroCompatCall.Err diag)]))

(define (macro-expand-compat-guard-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [name : String]
  [args : AstExprList]
  [is-unless : bool]
  [call-expr : AstExpr]) : ResultMacroCompatCall
  (match args
    [(AstExprCons cond body)
      (let
        [cond : AstExpr (ast-node-get cond)]
        [body : AstExprList (box-get body)]
        (match body
          [(AstExprNil)
            (ResultMacroCompatCall.Err
              (box
                (ctfe-diagnostic-at-expr
                  call-expr
                  (macro-compat-guard-message name))))]
          [_
            (macro-expand-compat-guard-body
              ctx
              env
              decls
              depth
              cond
              body
              is-unless)]))]
    [_
      (ResultMacroCompatCall.Err
        (box
          (ctfe-diagnostic-at-expr call-expr (macro-compat-guard-message name))))]))

(define (macro-expand-compat-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [func : AstExpr]
  [args : AstExprList]
  [call-expr : AstExpr]) : ResultMacroCompatCall
  (match (macro-compat-call-name func)
    [(TcSomeString name)
      (if (string.string-eq name "when")
        (macro-expand-compat-guard-call
          ctx
          env
          decls
          depth
          name
          args
          false
          call-expr)
        (if (string.string-eq name "unless")
          (macro-expand-compat-guard-call
            ctx
            env
            decls
            depth
            name
            args
            true
            call-expr)
          (ResultMacroCompatCall.No)))]
    [(TcNoString) (ResultMacroCompatCall.No)]))

(define (macro-expand-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [expr : AstExpr]) : ResultMacroExpr
  (if (< (macro-expand-depth-limit) depth)
    (ResultMacroExpr.Err
      (box
        (ctfe-diagnostic-at-expr expr "macro expansion exceeded depth limit")))
    (match expr
      [(AstExprSpanned inner-box span)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-spanned ninner span))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprCall func-box args)
        (let
          [func : AstExpr (ast-node-get func-box)]
          (if (macro-call-callee-maybe-macro? func)
            (match (macro-call-decl ctx func decls expr)
              [(ResultMacroCallDecl.Ok maybe-decl)
                (match maybe-decl
                  [(MacroMaybeDecl.Some
                      macro-name
                      definition-module
                      params
                      ret
                      body)
                    (macro-expand-call
                      ctx
                      env
                      decls
                      macro-name
                      definition-module
                      params
                      ret
                      body
                      args
                      depth
                      expr)]
                  [(MacroMaybeDecl.No)
                    (match (macro-expand-compat-call
                      ctx
                      env
                      decls
                      depth
                      func
                      args
                      expr)
                      [(ResultMacroCompatCall.Ok expanded)
                        (ResultMacroExpr.Ok expanded)]
                      [(ResultMacroCompatCall.No)
                        (match (macro-expand-expr ctx env decls depth func)
                          [(ResultMacroExpr.Ok nfunc)
                            (match (macro-expand-exprs ctx env decls depth args)
                              [(ResultMacroExprList.Ok nargs)
                                (ResultMacroExpr.Ok (ast-expr-call nfunc nargs))]
                              [(ResultMacroExprList.Err diag)
                                (ResultMacroExpr.Err diag)])]
                          [(ResultMacroExpr.Err diag)
                            (ResultMacroExpr.Err diag)])]
                      [(ResultMacroCompatCall.Err diag)
                        (ResultMacroExpr.Err diag)])])]
              [(ResultMacroCallDecl.Err diag) (ResultMacroExpr.Err diag)])
            (match (macro-expand-expr ctx env decls depth func)
              [(ResultMacroExpr.Ok nfunc)
                (match (macro-expand-exprs ctx env decls depth args)
                  [(ResultMacroExprList.Ok nargs)
                    (ResultMacroExpr.Ok (ast-expr-call nfunc nargs))]
                  [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
              [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])))]
      [(AstExprBracketClause items)
        (match (macro-expand-exprs ctx env decls depth items)
          [(ResultMacroExprList.Ok nitems)
            (ResultMacroExpr.Ok (ast-expr-bracket-clause nitems))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [(AstExprBinary op left-box right-box)
        (let
          [left : AstExpr (ast-node-get left-box)]
          [right : AstExpr (ast-node-get right-box)]
          (match (macro-expand-expr ctx env decls depth left)
            [(ResultMacroExpr.Ok nleft)
              (match (macro-expand-expr ctx env decls depth right)
                [(ResultMacroExpr.Ok nright)
                  (ResultMacroExpr.Ok (ast-expr-binary op nleft nright))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprUnary op inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-unary op ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprIf cond-box then-branch-box else-branch-box)
        (let
          [cond : AstExpr (ast-node-get cond-box)]
          [then-branch : AstExpr (ast-node-get then-branch-box)]
          [else-branch : AstExpr (ast-node-get else-branch-box)]
          (match (macro-expand-expr ctx env decls depth cond)
            [(ResultMacroExpr.Ok ncond)
              (match (macro-expand-expr ctx env decls depth then-branch)
                [(ResultMacroExpr.Ok nthen)
                  (match (macro-expand-expr ctx env decls depth else-branch)
                    [(ResultMacroExpr.Ok nelse)
                      (ResultMacroExpr.Ok (ast-expr-if ncond nthen nelse))]
                    [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprLet let-box)
        (match (box-get let-box)
          [(AstLet bindings body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (match (macro-expand-bindings ctx env decls depth bindings)
                [(ResultMacroLetBindings.Ok nbindings body-env)
                  (match (macro-expand-expr ctx body-env decls depth body)
                    [(ResultMacroExpr.Ok nbody)
                      (ResultMacroExpr.Ok (ast-expr-let nbindings nbody))]
                    [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
                [(ResultMacroLetBindings.Err diag) (ResultMacroExpr.Err diag)]))])]
      [(AstExprBegin exprs)
        (match (macro-expand-exprs ctx env decls depth exprs)
          [(ResultMacroExprList.Ok nexprs)
            (ResultMacroExpr.Ok (ast-node-push (AstExprBegin nexprs)))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [(AstExprUnsafe exprs)
        ;; Expansion typechecks some sub-expressions (e.g. `match` scrutinees) via
        ;; `tc-expr`; descend with the unsafe marker set so those checks see the
        ;; enclosing `unsafe` context, matching the real typecheck pass. Without
        ;; this, an `unsafe`-only primitive under an `(unsafe ...)` reachable here
        ;; is wrongly rejected once the program defines a macro.
        (match (macro-expand-exprs ctx (tc-enter-unsafe env) decls depth exprs)
          [(ResultMacroExprList.Ok nexprs)
            (ResultMacroExpr.Ok (ast-node-push (AstExprUnsafe nexprs)))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [(AstExprTuple exprs)
        (match (macro-expand-exprs ctx env decls depth exprs)
          [(ResultMacroExprList.Ok nexprs)
            (ResultMacroExpr.Ok (ast-node-push (AstExprTuple nexprs)))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [(AstExprArray exprs)
        (match (macro-expand-exprs ctx env decls depth exprs)
          [(ResultMacroExprList.Ok nexprs)
            (ResultMacroExpr.Ok (ast-node-push (AstExprArray nexprs)))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [(AstExprMatch match-box)
        (match (box-get match-box)
          [(AstMatch scrut-box arms)
            (let
              [scrut : AstExpr (ast-node-get scrut-box)]
              (match (macro-expand-expr ctx env decls depth scrut)
                [(ResultMacroExpr.Ok nscrut)
                  (match (tc-expr ctx env (ast-node-get nscrut))
                    [(OkTcType scrut-ty)
                      (match (macro-expand-arms
                        ctx
                        env
                        decls
                        depth
                        scrut-ty
                        arms)
                        [(ResultMacroArms.Ok narms)
                          (ResultMacroExpr.Ok (ast-expr-match nscrut narms))]
                        [(ResultMacroArms.Err diag) (ResultMacroExpr.Err diag)])]
                    [(ErrTcType message)
                      (ResultMacroExpr.Err
                        (box (tc-expr-diag (ast-node-get nscrut) message)))])]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))])]
      [(AstExprWhile cond-box body-box)
        (let
          [cond : AstExpr (ast-node-get cond-box)]
          [body : AstExpr (ast-node-get body-box)]
          (match (macro-expand-expr ctx env decls depth cond)
            [(ResultMacroExpr.Ok ncond)
              (match (macro-expand-expr ctx env decls depth body)
                [(ResultMacroExpr.Ok nbody)
                  (ResultMacroExpr.Ok (ast-expr-while ncond nbody))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprForeach fe-box)
        (match (box-get fe-box)
          [(AstForeach index index-ty start-box end-box body-box)
            (let
              [start : AstExpr (ast-node-get start-box)]
              [end : AstExpr (ast-node-get end-box)]
              [body : AstExpr (ast-node-get body-box)]
              (match (macro-expand-expr ctx env decls depth start)
                [(ResultMacroExpr.Ok nstart)
                  (match (macro-expand-expr ctx env decls depth end)
                    [(ResultMacroExpr.Ok nend)
                      (match (macro-expand-expr
                        ctx
                        (tc-bind-id env index (tc-resolve-type ctx index-ty))
                        decls
                        depth
                        body)
                        [(ResultMacroExpr.Ok nbody)
                          (ResultMacroExpr.Ok
                            (ast-expr-foreach-id
                              index
                              index-ty
                              nstart
                              nend
                              nbody))]
                        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
                    [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))])]
      [(AstExprLambda lambda-box)
        (match (box-get lambda-box)
          [(AstLambda params maybe-ret body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (match (macro-expand-expr
                ctx
                (match maybe-ret
                  [(AstSomeType ret)
                    (tc-bind-return-type
                      (tc-bind-params ctx env params)
                      (tc-resolve-type ctx ret))]
                  [(AstNoType)
                    (tc-bind-return-type
                      (tc-bind-params ctx env params)
                      (AstTyNever))])
                decls
                depth
                body)
                [(ResultMacroExpr.Ok nbody)
                  (ResultMacroExpr.Ok (ast-expr-lambda params maybe-ret nbody))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))])]
      [(AstExprAnn inner-box ty)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-ann ninner ty))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprCast inner-box ty)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-cast ninner ty))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprBorrow mutable lifetime place-box)
        (let
          [place : AstExpr (ast-node-get place-box)]
          (match (macro-expand-expr ctx env decls depth place)
            [(ResultMacroExpr.Ok nplace)
              (ResultMacroExpr.Ok (ast-expr-borrow mutable lifetime nplace))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprStructGet inner-box field)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-struct-get-id ninner field))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprStructSet inner-box field value-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          [value : AstExpr (ast-node-get value-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (match (macro-expand-expr ctx env decls depth value)
                [(ResultMacroExpr.Ok nvalue)
                  (ResultMacroExpr.Ok
                    (ast-expr-struct-set-id ninner field nvalue))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprWithRegion region body)
        (match (macro-expand-exprs
          ctx
          (tc-push-region env region)
          decls
          depth
          body)
          [(ResultMacroExprList.Ok nbody)
            (ResultMacroExpr.Ok
              (ast-node-push (AstExprWithRegion region nbody)))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [(AstExprWithEscape scratch-box body)
        (let
          [scratch : AstExpr (ast-node-get scratch-box)]
          (match (macro-expand-expr ctx env decls depth scratch)
            [(ResultMacroExpr.Ok nscratch)
              (match (macro-expand-exprs ctx env decls depth body)
                [(ResultMacroExprList.Ok nbody)
                  (ResultMacroExpr.Ok (ast-expr-with-escape nscratch nbody))]
                [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprWithScratch body)
        (match (macro-expand-exprs ctx env decls depth body)
          [(ResultMacroExprList.Ok nbody)
            (ResultMacroExpr.Ok (ast-expr-with-scratch nbody))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [(AstExprInArena arena-box body)
        (let
          [arena : AstExpr (ast-node-get arena-box)]
          (match (macro-expand-expr ctx env decls depth arena)
            [(ResultMacroExpr.Ok narena)
              (match (macro-expand-exprs ctx env decls depth body)
                [(ResultMacroExprList.Ok nbody)
                  (ResultMacroExpr.Ok (ast-expr-in-arena narena nbody))]
                [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprArrayRef array-box index-box)
        (let
          [array : AstExpr (ast-node-get array-box)]
          [index : AstExpr (ast-node-get index-box)]
          (match (macro-expand-expr ctx env decls depth array)
            [(ResultMacroExpr.Ok narray)
              (match (macro-expand-expr ctx env decls depth index)
                [(ResultMacroExpr.Ok nindex)
                  (ResultMacroExpr.Ok (ast-expr-array-ref narray nindex))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprArraySet array-box index-box value-box)
        (let
          [array : AstExpr (ast-node-get array-box)]
          [index : AstExpr (ast-node-get index-box)]
          [value : AstExpr (ast-node-get value-box)]
          (match (macro-expand-expr ctx env decls depth array)
            [(ResultMacroExpr.Ok narray)
              (match (macro-expand-expr ctx env decls depth index)
                [(ResultMacroExpr.Ok nindex)
                  (match (macro-expand-expr ctx env decls depth value)
                    [(ResultMacroExpr.Ok nvalue)
                      (ResultMacroExpr.Ok
                        (ast-expr-array-set narray nindex nvalue))]
                    [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprBox inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-box ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprBoxGet inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-box-get ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprBoxTake inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-box-take ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprBoxSet inner-box value-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          [value : AstExpr (ast-node-get value-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (match (macro-expand-expr ctx env decls depth value)
                [(ResultMacroExpr.Ok nvalue)
                  (ResultMacroExpr.Ok (ast-expr-box-set ninner nvalue))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprComptime inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-comptime ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprReturn inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-return ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprSet name rhs-box)
        (let
          [rhs : AstExpr (ast-node-get rhs-box)]
          (match (macro-expand-expr ctx env decls depth rhs)
            [(ResultMacroExpr.Ok nrhs)
              (ResultMacroExpr.Ok (ast-expr-set-id name nrhs))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprStringData inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-string-data ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprStringFromBytes ptr-box len-box)
        (let
          [ptr : AstExpr (ast-node-get ptr-box)]
          [len : AstExpr (ast-node-get len-box)]
          (match (macro-expand-expr ctx env decls depth ptr)
            [(ResultMacroExpr.Ok nptr)
              (match (macro-expand-expr ctx env decls depth len)
                [(ResultMacroExpr.Ok nlen)
                  (ResultMacroExpr.Ok (ast-expr-string-from-bytes nptr nlen))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprArrayData inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-array-data ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprBinaryData bytes)
        (ResultMacroExpr.Ok (ast-node-push (AstExprBinaryData bytes)))]
      [(AstExprSpmdProgramIndex)
        (ResultMacroExpr.Ok (ast-expr-spmd-program-index))]
      [(AstExprSpmdProgramCount)
        (ResultMacroExpr.Ok (ast-expr-spmd-program-count))]
      [(AstExprCpuIdEax leaf-box subleaf-box)
        (let
          [leaf : AstExpr (ast-node-get leaf-box)]
          [subleaf : AstExpr (ast-node-get subleaf-box)]
          (match (macro-expand-expr ctx env decls depth leaf)
            [(ResultMacroExpr.Ok nleaf)
              (match (macro-expand-expr ctx env decls depth subleaf)
                [(ResultMacroExpr.Ok nsubleaf)
                  (ResultMacroExpr.Ok (ast-expr-cpuid-eax nleaf nsubleaf))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprCpuIdEbx leaf-box subleaf-box)
        (let
          [leaf : AstExpr (ast-node-get leaf-box)]
          [subleaf : AstExpr (ast-node-get subleaf-box)]
          (match (macro-expand-expr ctx env decls depth leaf)
            [(ResultMacroExpr.Ok nleaf)
              (match (macro-expand-expr ctx env decls depth subleaf)
                [(ResultMacroExpr.Ok nsubleaf)
                  (ResultMacroExpr.Ok (ast-expr-cpuid-ebx nleaf nsubleaf))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprCpuIdEcx leaf-box subleaf-box)
        (let
          [leaf : AstExpr (ast-node-get leaf-box)]
          [subleaf : AstExpr (ast-node-get subleaf-box)]
          (match (macro-expand-expr ctx env decls depth leaf)
            [(ResultMacroExpr.Ok nleaf)
              (match (macro-expand-expr ctx env decls depth subleaf)
                [(ResultMacroExpr.Ok nsubleaf)
                  (ResultMacroExpr.Ok (ast-expr-cpuid-ecx nleaf nsubleaf))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprCpuIdEdx leaf-box subleaf-box)
        (let
          [leaf : AstExpr (ast-node-get leaf-box)]
          [subleaf : AstExpr (ast-node-get subleaf-box)]
          (match (macro-expand-expr ctx env decls depth leaf)
            [(ResultMacroExpr.Ok nleaf)
              (match (macro-expand-expr ctx env decls depth subleaf)
                [(ResultMacroExpr.Ok nsubleaf)
                  (ResultMacroExpr.Ok (ast-expr-cpuid-edx nleaf nsubleaf))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprXgetbv index-box)
        (let
          [index : AstExpr (ast-node-get index-box)]
          (match (macro-expand-expr ctx env decls depth index)
            [(ResultMacroExpr.Ok nindex)
              (ResultMacroExpr.Ok (ast-expr-xgetbv nindex))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExprSyscall args)
        (match (macro-expand-exprs ctx env decls depth args)
          [(ResultMacroExprList.Ok nargs)
            (ResultMacroExpr.Ok (ast-expr-syscall nargs))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [_ (ResultMacroExpr.Ok (ast-node-push expr))])))

(define (macro-expand-module-call-position
  [ctx : TcContext]
  [decls : AstDeclList]
  [call-id : i64]
  [import-position : bool]) : ResultMacroDecl
  (let
    [call-expr : AstExpr (ast-node-get call-id)]
    (match (ast-expr-unspan call-expr)
      [(AstExprCall func-box _)
        (let
          [func : AstExpr (ast-node-get func-box)]
          (match (macro-call-decl ctx func decls call-expr)
            [(ResultMacroCallDecl.Ok maybe-decl)
              (match maybe-decl
                [(MacroMaybeDecl.Some _ _ _ ret _)
                  (cond
                    [(and import-position (tc-macro-result-module? ret))
                      (ResultMacroDecl.Err
                        (box
                          (ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: Module macro expansion is not implemented yet (#3153)")))]
                    [(and import-position (tc-macro-result-decls? ret))
                      (ResultMacroDecl.Err
                        (box
                          (ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: Decls macro cannot be used in import position")))]
                    [import-position
                      (ResultMacroDecl.Err
                        (box
                          (ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: expression macro cannot be used as module import")))]
                    [(tc-macro-result-decls? ret)
                      (ResultMacroDecl.Err
                        (box
                          (ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: Decls macro expansion is not implemented yet (#3153)")))]
                    [(tc-macro-result-module? ret)
                      (ResultMacroDecl.Err
                        (box
                          (ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: Module macro can only be used in import position")))]
                    [else
                      (ResultMacroDecl.Err
                        (box
                          (ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: expression macro cannot be used at module scope")))])]
                [(MacroMaybeDecl.No)
                  (ResultMacroDecl.Err
                    (box
                      (ctfe-diagnostic-at-expr
                        call-expr
                        "typecheck: module-scope macro call must resolve to defmacro")))])]
            [(ResultMacroCallDecl.Err diag) (ResultMacroDecl.Err diag)]))]
      [_
        (ResultMacroDecl.Err
          (box
            (ctfe-diagnostic-at-expr
              call-expr
              "typecheck: module-scope macro placeholder must be a call")))])))

(define (macro-expand-decl
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [decl : AstDecl]) : ResultMacroDecl
  (let
    [global-env : TcTypeEnv (tc-hygiene-global-env top-env)]
    (match decl
      [(AstDeclDef name maybe-ty expr-box)
        (let
          [expr : AstExpr (ast-node-get expr-box)]
          (match (macro-expand-expr ctx global-env decls 0 expr)
            [(ResultMacroExpr.Ok nexpr)
              (ResultMacroDecl.Ok (ast-decl-def-id name maybe-ty nexpr))]
            [(ResultMacroExpr.Err diag) (ResultMacroDecl.Err diag)]))]
      [(AstDeclDefFn name params ret body-box export)
        (let
          [body : AstExpr (ast-node-get body-box)]
          (match (macro-expand-expr
            ctx
            (tc-bind-return-type
              (tc-bind-params ctx global-env params)
              (tc-resolve-type ctx ret))
            decls
            0
            body)
            [(ResultMacroExpr.Ok nbody)
              (ResultMacroDecl.Ok
                (ast-decl-def-fn-export-id name params ret nbody export))]
            [(ResultMacroExpr.Err diag) (ResultMacroDecl.Err diag)]))]
      [(AstDeclTest _ _ _) (ResultMacroDecl.Ok decl)]
      [(AstDeclImport (AstImportSpec kind _ _ _ _))
        (match kind
          [(AstImportMacro call-id _)
            (macro-expand-module-call-position ctx decls call-id true)]
          [(AstImportMacroDecls call-id _)
            (macro-expand-module-call-position ctx decls call-id false)]
          [_ (ResultMacroDecl.Ok decl)])]
      [(AstDeclUnsafe inner-box)
        (let
          [inner : AstDecl (box-get inner-box)]
          (match (macro-expand-decl ctx top-env decls inner)
            [(ResultMacroDecl.Ok ninner)
              (ResultMacroDecl.Ok (ast-decl-unsafe ninner))]
            [(ResultMacroDecl.Err diag) (ResultMacroDecl.Err diag)]))]
      [_ (ResultMacroDecl.Ok decl)])))

(define (macro-single-decl-expansion [decl : AstDecl] [path : String]) : ResultMacroDeclExpansion
  (ResultMacroDeclExpansion.Ok
    (ast-decl-cons decl AstDeclNil)
    (ast-decl-path-cons path AstDeclPathNil)))

(define (macro-module-import-marker-decls
  [target-module : String]
  [alias : AstMaybeImportAlias]
  [span : AstSourceSpan]) : AstDeclList
  (let
    [binding-alias : AstMaybeImportAlias
      (match alias
        [(AstNoImportAlias) (AstSomeImportAlias "")]
        [_ alias])]
    (ast-decl-cons
      (AstDeclImport
        (AstImportSpec
          (AstImportModule)
          target-module
          (AstSomeModuleName target-module)
          binding-alias
          span))
      AstDeclNil)))

(define (macro-call-not-macro-diag [call-expr : AstExpr]) : CompilerDiagnostic
  (ctfe-diagnostic-at-expr
    call-expr
    "typecheck: module-scope macro call does not name a macro"))

(define (macro-module-existing-collision-diag
  [call-expr : AstExpr]
  [target-module : String]
  [identity : String]) : CompilerDiagnostic
  (ctfe-diagnostic-at-expr
    call-expr
    (str_cat.str-cat
      "typecheck: Module macro output collides with existing module "
      target-module
      " for generated identity "
      identity)))

(define (macro-module-incompatible-output-diag
  [call-expr : AstExpr]
  [identity : String]) : CompilerDiagnostic
  (ctfe-diagnostic-at-expr
    call-expr
    (str_cat.str-cat
      "typecheck: Module macro output for generated identity "
      identity
      " has incompatible payload")))

(define (macro-expand-module-materialized
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [target-module : String]
  [alias : AstMaybeImportAlias]
  [span : AstSourceSpan]
  [decl-path : String]
  [macro-name : String]
  [identity : String]
  [body-rest : AstDeclList]
  [call-expr : AstExpr]) : ResultMacroDeclExpansion
  (let
    [generated-body : AstDeclList
      (macro-wrap-generated-decls body-rest macro-name identity)]
    [materialized : AstDeclList
      (ast-decl-cons (ast-decl-module target-module) generated-body)]
    (match (macro-find-module-body-decls orig-decls target-module)
      [(MacroMaybeDeclList.Some existing-body)
        (if (macro-decls-contain-generated-key? existing-body identity)
          (let
            [same-identity-body : AstDeclList
              (macro-decls-filter-generated-key existing-body identity)]
            ;: Exports/imports in generated module bodies are unkeyed scaffolding,
            ;: so replay compatibility compares only declarations owned by this
            ;: generated identity. Other identities may share the same module.
            [generated-key-body : AstDeclList
              (macro-decls-filter-generated-key generated-body identity)]
            [same-body? : bool
              (if (macro-decl-list-structural-eq?
                same-identity-body
                generated-key-body)
                true
                (macro-generated-key-body-replay-compatible?
                  ctx
                  top-env
                  orig-decls
                  target-module
                  decl-path
                  identity
                  same-identity-body
                  generated-key-body))]
            (if same-body?
              (match (macro-check-generated-import-collisions
                orig-decls
                generated-body
                module
                alias
                identity)
                [CompilerNoString
                  (let
                    [expanded : AstDeclList
                      (macro-module-import-marker-decls
                        target-module
                        alias
                        span)]
                    (ResultMacroDeclExpansion.Ok
                      expanded
                      (macro-paths-for-decls expanded decl-path)))]
                [(CompilerSomeString message)
                  (ResultMacroDeclExpansion.Err
                    (box (macro-generated-import-diag span message)))])
              (ResultMacroDeclExpansion.Err
                (box (macro-module-incompatible-output-diag call-expr identity)))))
          (match (macro-check-generated-import-collisions
            orig-decls
            generated-body
            module
            alias
            identity)
            [CompilerNoString
              (let
                [expanded : AstDeclList
                  (macro-decl-list-append
                    materialized
                    (ast-decl-cons
                      (ast-decl-module module)
                      (macro-module-import-marker-decls
                        target-module
                        alias
                        span)))]
                (ResultMacroDeclExpansion.Ok
                  expanded
                  (macro-paths-for-decls expanded decl-path)))]
            [(CompilerSomeString message)
              (ResultMacroDeclExpansion.Err
                (box (macro-generated-import-diag span message)))]))]
      [(MacroMaybeDeclList.No)
        (match (macro-check-generated-import-collisions
          orig-decls
          generated-body
          module
          alias
          identity)
          [CompilerNoString
            (let
              [expanded : AstDeclList
                (macro-decl-list-append
                  materialized
                  (ast-decl-cons
                    (ast-decl-module module)
                    (macro-module-import-marker-decls target-module alias span)))]
              (ResultMacroDeclExpansion.Ok
                expanded
                (macro-paths-for-decls expanded decl-path)))]
          [(CompilerSomeString message)
            (ResultMacroDeclExpansion.Err
              (box (macro-generated-import-diag span message)))])])))

(define (macro-expand-module-generated-decls
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [alias : AstMaybeImportAlias]
  [span : AstSourceSpan]
  [decl-path : String]
  [macro-name : String]
  [identity : String]
  [definition-module : String]
  [macro-env : CtfeEnv]
  [rewrite-imports? : bool]
  [generated : AstDeclList]
  [call-expr : AstExpr]) : ResultMacroDeclExpansion
  (let
    [module-count : i64 (macro-decls-module-count generated)]
    (if (= module-count 0)
      (ResultMacroDeclExpansion.Err
        (box
          (ctfe-diagnostic-at-expr
            call-expr
            "typecheck: Module macro output must include a module declaration")))
      (if (> module-count 1)
        (ResultMacroDeclExpansion.Err
          (box
            (ctfe-diagnostic-at-expr
              call-expr
              "typecheck: Module macro output must include exactly one module declaration")))
        (match generated
          [(AstDeclCons first body-rest-box)
            (match first
              [(AstDeclModule target-module-id)
                (let
                  [target-module : String (intern-str target-module-id)]
                  [body-rest : AstDeclList (box-get body-rest-box)]
                  [contextual-body : AstDeclList
                    (macro-generated-context-decls body-rest definition-module)]
                  [final-body : AstDeclList
                    (if rewrite-imports?
                      (let
                        [rewrite-decls : AstDeclList
                          (ast-decl-cons
                            (ast-decl-module target-module)
                            contextual-body)]
                        [lookup-decls : AstDeclList
                          (macro-decl-list-append orig-decls rewrite-decls)]
                        (macro-rewrite-generated-import-decls
                          (tc-context-with-module ctx target-module)
                          lookup-decls
                          target-module
                          definition-module
                          macro-env
                          contextual-body))
                      contextual-body)]
                  (macro-expand-module-materialized
                    ctx
                    top-env
                    orig-decls
                    module
                    target-module
                    alias
                    span
                    decl-path
                    macro-name
                    identity
                    final-body
                    call-expr))]
              [_
                (ResultMacroDeclExpansion.Err
                  (box
                    (ctfe-diagnostic-at-expr
                      call-expr
                      "typecheck: Module macro output must start with a module declaration")))])]
          [(AstDeclNil)
            (ResultMacroDeclExpansion.Err
              (box
                (ctfe-diagnostic-at-expr
                  call-expr
                  "typecheck: Module macro output must include a module declaration")))])))))

(define (macro-expand-decls-splice
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [call-id : i64]
  [context : AstMaybeModuleName]
  [decl-path : String]) : ResultMacroDeclExpansion
  (let
    [call-expr : AstExpr (ast-node-get call-id)]
    (match (ast-expr-unspan call-expr)
      [(AstExprCall func-box args)
        (let
          [func : AstExpr (ast-node-get func-box)]
          [global-env : TcTypeEnv (tc-hygiene-global-env top-env)]
          (match (macro-call-decl-with-context
            ctx
            func
            orig-decls
            module
            context
            call-expr)
            [(ResultMacroCallDeclModule.Ok maybe-decl call-module)
              (let
                [call-ctx : TcContext (tc-context-with-module ctx module)]
                (match maybe-decl
                  [(MacroMaybeDecl.Some
                      macro-name
                      definition-module
                      params
                      ret
                      body)
                    (if (tc-macro-result-decls? ret)
                      (match (macro-expand-exprs
                        call-ctx
                        global-env
                        orig-decls
                        0
                        args)
                        [(ResultMacroExprList.Ok expanded-args)
                          (match (macro-module-identity
                            call-ctx
                            orig-decls
                            call-module
                            macro-name
                            definition-module
                            params
                            expanded-args
                            (tc-ctfe-env call-ctx)
                            call-expr)
                            [(OkGenKey identity _)
                              (if (macro-vector-family-decls-macro?
                                macro-name
                                definition-module)
                                (let
                                  [fast-result : ResultMacroParsedDecls
                                    (begin
                                      (cfg
                                        compile-profile
                                        (compiler-tc-macro-profile-start))
                                      (macro-vector-family-fast-decls
                                        call-ctx
                                        orig-decls
                                        call-module
                                        expanded-args
                                        call-expr))]
                                  (begin
                                    (cfg
                                      compile-profile
                                      (compiler-tc-macro-profile-finish
                                        macro-name
                                        expanded-args))
                                    (match fast-result
                                      [(ResultMacroParsedDecls.Ok generated)
                                        (let
                                          [contextual-generated : AstDeclList
                                            (macro-generated-context-decls
                                              generated
                                              definition-module)]
                                          [wrapped : AstDeclList
                                            (macro-wrap-generated-decls-decls
                                              contextual-generated
                                              macro-name
                                              (macro-decls-generated-key
                                                identity))]
                                          (ResultMacroDeclExpansion.Ok
                                            wrapped
                                            (macro-paths-for-decls
                                              wrapped
                                              decl-path)))]
                                      [(ResultMacroParsedDecls.Err diag)
                                        (ResultMacroDeclExpansion.Err diag)])))
                                (match (macro-eval-transformer-expanded-with-env
                                  call-ctx
                                  orig-decls
                                  call-module
                                  global-env
                                  macro-name
                                  params
                                  body
                                  expanded-args
                                  call-expr)
                                  [(ResultMacroValueEnv.Ok value macro-env)
                                    (let
                                      [parse-dispatch : SymI64Env
                                        (macro-parse-dispatch-for-macro
                                          macro-name
                                          definition-module)]
                                      (match (macro-decls-from-ctfe-value
                                        value
                                        call-expr
                                        parse-dispatch)
                                        [(ResultMacroParsedDecls.Ok generated)
                                          (let
                                            [generated : AstDeclList
                                              (if (tc-macro-param-list-needs-call-context?
                                                params)
                                                (macro-rewrite-generated-import-decls
                                                  call-ctx
                                                  orig-decls
                                                  module
                                                  definition-module
                                                  macro-env
                                                  generated)
                                                generated)]
                                            [contextual-generated : AstDeclList
                                              (macro-generated-context-decls
                                                generated
                                                definition-module)]
                                            [wrapped : AstDeclList
                                              (macro-wrap-generated-decls-decls
                                                contextual-generated
                                                macro-name
                                                (macro-decls-generated-key
                                                  identity))]
                                            (ResultMacroDeclExpansion.Ok
                                              wrapped
                                              (macro-paths-for-decls
                                                wrapped
                                                decl-path)))]
                                        [(ResultMacroParsedDecls.Err diag)
                                          (ResultMacroDeclExpansion.Err diag)]))]
                                  [(ResultMacroValueEnv.Err diag)
                                    (ResultMacroDeclExpansion.Err diag)]))]
                            [(ErrGenKey diag)
                              (ResultMacroDeclExpansion.Err diag)])]
                        [(ResultMacroExprList.Err diag)
                          (ResultMacroDeclExpansion.Err diag)])
                      (if (tc-macro-result-module? ret)
                        (ResultMacroDeclExpansion.Err
                          (box
                            (ctfe-diagnostic-at-expr
                              call-expr
                              "typecheck: Module macro can only be used in import position")))
                        (ResultMacroDeclExpansion.Err
                          (box
                            (ctfe-diagnostic-at-expr
                              call-expr
                              "typecheck: expression macro cannot be used at module scope")))))]
                  [(MacroMaybeDecl.No)
                    (ResultMacroDeclExpansion.Err
                      (box (macro-call-not-macro-diag call-expr)))]))]
            [(ResultMacroCallDeclModule.Err diag)
              (ResultMacroDeclExpansion.Err diag)]))]
      [_
        (ResultMacroDeclExpansion.Err
          (box
            (ctfe-diagnostic-at-expr
              call-expr
              "typecheck: module-scope macro placeholder must be a call")))])))

(define (macro-expand-module-import
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [call-id : i64]
  [context : AstMaybeModuleName]
  [alias : AstMaybeImportAlias]
  [span : AstSourceSpan]
  [decl-path : String]) : ResultMacroDeclExpansion
  (let
    [call-expr : AstExpr (ast-node-get call-id)]
    (match (ast-expr-unspan call-expr)
      [(AstExprCall func-box args)
        (let
          [func : AstExpr (ast-node-get func-box)]
          [global-env : TcTypeEnv (tc-hygiene-global-env top-env)]
          (match (macro-call-decl-with-context
            ctx
            func
            orig-decls
            module
            context
            call-expr)
            [(ResultMacroCallDeclModule.Ok maybe-decl call-module)
              (let
                [call-ctx : TcContext (tc-context-with-module ctx module)]
                (match maybe-decl
                  [(MacroMaybeDecl.Some
                      macro-name
                      definition-module
                      params
                      ret
                      body)
                    (if (tc-macro-result-module? ret)
                      (match (macro-expand-exprs
                        call-ctx
                        global-env
                        orig-decls
                        0
                        args)
                        [(ResultMacroExprList.Ok expanded-args)
                          (match (macro-module-identity
                            call-ctx
                            orig-decls
                            call-module
                            macro-name
                            definition-module
                            params
                            expanded-args
                            (tc-ctfe-env call-ctx)
                            call-expr)
                            [(OkGenKey identity _)
                              (match (macro-eval-transformer-expanded-with-env
                                call-ctx
                                orig-decls
                                call-module
                                global-env
                                macro-name
                                params
                                body
                                expanded-args
                                call-expr)
                                [(ResultMacroValueEnv.Ok value macro-env)
                                  (let
                                    [parse-dispatch : SymI64Env
                                      (macro-parse-dispatch-for-macro
                                        macro-name
                                        definition-module)]
                                    (match (macro-module-decls-from-ctfe-value
                                      value
                                      call-expr
                                      parse-dispatch)
                                      [(ResultMacroParsedDecls.Ok generated)
                                        (macro-expand-module-generated-decls
                                          ctx
                                          top-env
                                          orig-decls
                                          module
                                          alias
                                          span
                                          decl-path
                                          macro-name
                                          identity
                                          definition-module
                                          macro-env
                                          (tc-macro-param-list-needs-call-context?
                                            params)
                                          generated
                                          call-expr)]
                                      [(ResultMacroParsedDecls.Err diag)
                                        (ResultMacroDeclExpansion.Err diag)]))]
                                [(ResultMacroValueEnv.Err diag)
                                  (ResultMacroDeclExpansion.Err diag)])]
                            [(ErrGenKey diag)
                              (ResultMacroDeclExpansion.Err diag)])]
                        [(ResultMacroExprList.Err diag)
                          (ResultMacroDeclExpansion.Err diag)])
                      (if (tc-macro-result-decls? ret)
                        (ResultMacroDeclExpansion.Err
                          (box
                            (ctfe-diagnostic-at-expr
                              call-expr
                              "typecheck: Decls macro cannot be used in import position")))
                        (ResultMacroDeclExpansion.Err
                          (box
                            (ctfe-diagnostic-at-expr
                              call-expr
                              "typecheck: expression macro cannot be used as module import")))))]
                  [(MacroMaybeDecl.No)
                    (ResultMacroDeclExpansion.Err
                      (box (macro-call-not-macro-diag call-expr)))]))]
            [(ResultMacroCallDeclModule.Err diag)
              (ResultMacroDeclExpansion.Err diag)]))]
      [_
        (ResultMacroDeclExpansion.Err
          (box
            (ctfe-diagnostic-at-expr
              call-expr
              "typecheck: import macro placeholder must contain a call")))])))

(define (macro-expand-decl-with-path
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [decl : AstDecl]
  [decl-path : String]) : ResultMacroDeclExpansion
  (match decl
    [(AstDeclComptimeDecl meta template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (match template
          [(AstDeclImport (AstImportSpec kind _ _ alias span))
            (if (macro-import-placeholder-kind? kind)
              (match kind
                [(AstImportMacro call-id context)
                  (macro-expand-module-import
                    ctx
                    top-env
                    orig-decls
                    module
                    call-id
                    context
                    alias
                    span
                    decl-path)]
                [(AstImportMacroDecls call-id context)
                  (macro-expand-decls-splice
                    ctx
                    top-env
                    orig-decls
                    module
                    call-id
                    context
                    decl-path)]
                [_ (macro-single-decl-expansion decl decl-path)])
              (macro-single-decl-expansion decl decl-path))]
          [_
            (let
              [decl-ctx : TcContext (tc-context-with-module ctx module)]
              (if (not (macro-decl-uses-macro? decl-ctx orig-decls template))
                (macro-single-decl-expansion decl decl-path)
                (match (macro-expand-decl decl-ctx top-env orig-decls template)
                  [(ResultMacroDecl.Ok expanded)
                    (macro-single-decl-expansion
                      (ast-decl-comptime-decl-with-meta meta expanded)
                      decl-path)]
                  [(ResultMacroDecl.Err diag)
                    (ResultMacroDeclExpansion.Err diag)])))]))]
    [(AstDeclImport (AstImportSpec kind _ _ alias span))
      (match kind
        [(AstImportMacro call-id context)
          (macro-expand-module-import
            ctx
            top-env
            orig-decls
            module
            call-id
            context
            alias
            span
            decl-path)]
        [(AstImportMacroDecls call-id context)
          (macro-expand-decls-splice
            ctx
            top-env
            orig-decls
            module
            call-id
            context
            decl-path)]
        [_ (macro-single-decl-expansion decl decl-path)])]
    [_
      (let
        [decl-ctx : TcContext (tc-context-with-module ctx module)]
        (if (not (macro-decl-uses-macro? decl-ctx orig-decls decl))
          (macro-single-decl-expansion decl decl-path)
          (match (macro-expand-decl decl-ctx top-env orig-decls decl)
            [(ResultMacroDecl.Ok expanded)
              (macro-single-decl-expansion expanded decl-path)]
            [(ResultMacroDecl.Err diag) (ResultMacroDeclExpansion.Err diag)])))]))

(define (macro-module-generated-key? [key : String]) : bool
  (and
    (> (string.string-length key) 0)
    (not (tc-string-prefix? key "generated:"))))

(define (macro-decl-generated-identity [decl : AstDecl]) : CompilerMaybeString
  (match decl
    [(AstDeclComptimeDecl meta template-box)
      (match meta
        [(AstSomeGeneratedDeclMeta _ _ _ key)
          (if (macro-module-generated-key? key)
            (CompilerSomeString key)
            (macro-decl-generated-identity (box-get template-box)))]
        [(AstNoGeneratedDeclMeta)
          (macro-decl-generated-identity (box-get template-box))])]
    [(AstDeclUnsafe inner-box)
      (macro-decl-generated-identity (box-get inner-box))]
    [_ CompilerNoString]))

(define (macro-module-generated-identity-in
  [decls : AstDeclList]
  [target-module : String]
  [module : String]) : CompilerMaybeString
  (match decls
    [(AstDeclNil) CompilerNoString]
    [(AstDeclCons decl rest-box)
      (match decl
        [(AstDeclModule next-module)
          (macro-module-generated-identity-in
            (box-get rest-box)
            target-module
            (intern-str next-module))]
        [_
          (if (string.string-eq module target-module)
            (match (macro-decl-generated-identity decl)
              [(CompilerSomeString identity) (CompilerSomeString identity)]
              [CompilerNoString
                (macro-module-generated-identity-in
                  (box-get rest-box)
                  target-module
                  module)])
            (macro-module-generated-identity-in
              (box-get rest-box)
              target-module
              module))])]))

(define (macro-module-generated-identity
  [decls : AstDeclList]
  [target-module : String]) : CompilerMaybeString
  (macro-module-generated-identity-in decls target-module ""))

(define (macro-import-unqualified? [alias : AstMaybeImportAlias]) : bool
  (match alias
    [(AstSomeImportAlias alias-name) (string.string-eq alias-name "")]
    [(AstNoImportAlias) false]))

(define (macro-module-import-request-unqualified? [alias : AstMaybeImportAlias]) : bool
  (match alias
    [(AstSomeImportAlias alias-name) (string.string-eq alias-name "")]
    [(AstNoImportAlias) true]))

(define (macro-generated-import-diag [span : AstSourceSpan] [message : String]) : CompilerDiagnostic
  (tc-canonical-diagnostic (compiler-diagnostic-from-ast-span "" span message)))

(define (macro-check-generated-import-collisions-in
  [all-decls : AstDeclList]
  [generated-body : AstDeclList]
  [import-module : String]
  [identity : String]) : CompilerMaybeString
  (match generated-body
    [(AstDeclNil) CompilerNoString]
    [(AstDeclCons decl rest-box)
      (match decl
        [_
          (macro-check-generated-import-collisions-in
            all-decls
            (box-get rest-box)
            import-module
            identity)])]))

(define (macro-check-generated-import-collisions
  [_all-decls : AstDeclList]
  [_generated-body : AstDeclList]
  [_import-module : String]
  [_alias : AstMaybeImportAlias]
  [_identity : String]) : CompilerMaybeString
  CompilerNoString)

;; Macro-expansion skip analysis (#2350-regression fix). Once any module defines
;; a macro, `has-defmacro` forces the full macro-expand walk over EVERY decl in
;; the program (all imported modules), which redundantly re-typechecks match
;; scrutinees / let bindings and rebuilds the entire AST -- ~1.7GB and >1s on a
;; self-compile. The vast majority of decls call no macro at all, so this work is
;; pure waste. These predicates detect whether a decl actually contains a macro
;; (or `when`/`unless` compat) call using the SAME resolution as the expander
;; (`macro-call-decl`), so a decl with none can be shared unchanged. They are
;; conservative: any unrecognized expression variant returns `true` (expand), so
;; a future AST node that could host a macro call is never silently skipped.
;; The callee name of a call after hygiene-stripping (but keeping any module
;; qualifier), mirroring `macro-call-decl`'s name resolution. Returns nothing for
;; non-variable callees (which `macro-call-decl` also treats as non-macro).
;; Allocation-free for plain unqualified names -- the hot path for the pre-filter.
(define (macro-call-callee-name [func : AstExpr]) : TcMaybeString
  (match func
    [(AstExprSpanned inner-box _)
      (macro-call-callee-name (ast-node-get inner-box))]
    [(AstExprVar name)
      (TcSomeString
        (if (tc-hygiene-global-name? (intern-str name))
          (match (tc-hygiene-global-decode (intern-str name))
            [(TcHygieneLegacyGlobal lookup-name) lookup-name]
            [(TcHygieneContextGlobal _ lookup-name) lookup-name])
          (intern-str name)))]
    [_ (TcNoString)]))

(define (macro-call-callee-last-dot [name : String]) : i64
  (let
    [i : i64 0]
    [last-dot : i64 -1]
    [n : i64 (string.string-length name)]
    (begin
      (while (< i n)
        (begin
          (if (or
            (string.char-eq (string.string-ref name i) '.')
            (string.char-eq (string.string-ref name i) '/'))
            (set! last-dot i)
            unit)
          (set! i (+ i 1))))
      last-dot)))

(define (macro-call-callee-base-name [name : String]) : String
  (let
    [lookup : String
      (if (tc-hygiene-global-name? name)
        (tc-hygiene-global-call-name name)
        name)]
    [source : String lookup]
    [last-dot : i64 (macro-call-callee-last-dot source)]
    [n : i64 (string.string-length source)]
    (if (and (>= last-dot 0) (< last-dot (- n 1)))
      (string.substring source (+ last-dot 1) (- n (+ last-dot 1)))
      source)))

(define (macro-call-name-maybe-macro? [name : String]) : bool
  (let
    [base : String (macro-call-callee-base-name name)]
    (or
      (tc-string-list-contains macro-expand-macro-names base)
      (string.string-eq base "when")
      (string.string-eq base "unless"))))

(define (macro-call-callee-maybe-macro? [func : AstExpr]) : bool
  (match (macro-call-callee-name func)
    [(TcSomeString name) (macro-call-name-maybe-macro? name)]
    [(TcNoString) false]))

(define (macro-call-is-expandable?
  [ctx : TcContext]
  [decls : AstDeclList]
  [func : AstExpr]
  [call-expr : AstExpr]) : bool
  (match (macro-call-callee-name func)
    [(TcSomeString name)
      ;; Only callees whose base name matches a declared macro need precise
      ;; alias/module resolution. This keeps value-heavy dotted imports such as
      ;; `string.length` on the cheap path while still resolving qualified macro
      ;; calls through `macro-call-decl`.
      (if (macro-call-name-maybe-macro? name)
        (match (macro-call-decl ctx func decls call-expr)
          [(ResultMacroCallDecl.Ok maybe)
            (match maybe
              [(MacroMaybeDecl.Some _ _ _ _ _) true]
              [(MacroMaybeDecl.No)
                (or
                  (string.string-eq name "when")
                  (string.string-eq name "unless"))])]
          [(ResultMacroCallDecl.Err _) true])
        false)]
    [(TcNoString) false]))

(define (macro-node-uses-macro?
  [ctx : TcContext]
  [decls : AstDeclList]
  [id : i64]) : bool
  (macro-expr-uses-macro? ctx decls (ast-node-get id)))

(define (macro-exprs-use-macro?
  [ctx : TcContext]
  [decls : AstDeclList]
  [exprs : AstExprList]) : bool
  (match exprs
    [(AstExprNil) false]
    [(AstExprCons head rest)
      (or
        (macro-node-uses-macro? ctx decls head)
        (macro-exprs-use-macro? ctx decls (box-get rest)))]))

(define (macro-arms-use-macro?
  [ctx : TcContext]
  [decls : AstDeclList]
  [arms : AstMatchArmList]) : bool
  (match arms
    [(AstMatchArmNil) false]
    [(AstMatchArmCons arm rest)
      (or
        (match arm
          [(AstMatchArm _ body-box) (macro-node-uses-macro? ctx decls body-box)])
        (macro-arms-use-macro? ctx decls (box-get rest)))]))

(define (macro-bindings-use-macro?
  [ctx : TcContext]
  [decls : AstDeclList]
  [bindings : AstLetBindingList]) : bool
  (match bindings
    [(AstLetBindingNil) false]
    [(AstLetBindingCons binding rest)
      (or
        (match binding
          [(AstLetBinding _ _ init-box)
            (macro-node-uses-macro? ctx decls init-box)])
        (macro-bindings-use-macro? ctx decls (box-get rest)))]))

(define (macro-expr-uses-macro?
  [ctx : TcContext]
  [decls : AstDeclList]
  [expr : AstExpr]) : bool
  (match expr
    [(AstExprSpanned inner-box _) (macro-node-uses-macro? ctx decls inner-box)]
    [(AstExprLiteral _) false]
    [(AstExprVar _) false]
    [(AstExprCall func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (or
          (macro-call-is-expandable? ctx decls func expr)
          (macro-expr-uses-macro? ctx decls func)
          (macro-exprs-use-macro? ctx decls args)))]
    [(AstExprBracketClause items) (macro-exprs-use-macro? ctx decls items)]
    [(AstExprBinary _ l r)
      (or
        (macro-node-uses-macro? ctx decls l)
        (macro-node-uses-macro? ctx decls r))]
    [(AstExprUnary _ i) (macro-node-uses-macro? ctx decls i)]
    [(AstExprIf c t e)
      (or
        (macro-node-uses-macro? ctx decls c)
        (macro-node-uses-macro? ctx decls t)
        (macro-node-uses-macro? ctx decls e))]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body)
          (or
            (macro-bindings-use-macro? ctx decls bindings)
            (macro-node-uses-macro? ctx decls body))])]
    [(AstExprLambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda _ _ body) (macro-node-uses-macro? ctx decls body)])]
    [(AstExprTuple exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(AstExprTupleRef a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExprArray exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(AstExprMakeArray _ len) (macro-node-uses-macro? ctx decls len)]
    [(AstExprArrayRef a i)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls i))]
    [(AstExprArraySet a i v)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls i)
        (macro-node-uses-macro? ctx decls v))]
    [(AstExprArrayPush a v)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls v))]
    [(AstExprStringRef a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExprWhile c b)
      (or
        (macro-node-uses-macro? ctx decls c)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExprBegin exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(AstExprUnsafe exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(AstExprSet _ rhs) (macro-node-uses-macro? ctx decls rhs)]
    [(AstExprAnn i _) (macro-node-uses-macro? ctx decls i)]
    [(AstExprCast i _) (macro-node-uses-macro? ctx decls i)]
    [(AstExprBorrow _ _ i) (macro-node-uses-macro? ctx decls i)]
    [(AstExprMatch match-box)
      (match (box-get match-box)
        [(AstMatch scrut arms)
          (or
            (macro-node-uses-macro? ctx decls scrut)
            (macro-arms-use-macro? ctx decls arms))])]
    [(AstExprForeach fe-box)
      (match (box-get fe-box)
        [(AstForeach _ _ s e b)
          (or
            (macro-node-uses-macro? ctx decls s)
            (macro-node-uses-macro? ctx decls e)
            (macro-node-uses-macro? ctx decls b))])]
    [(AstExprStructGet i _) (macro-node-uses-macro? ctx decls i)]
    [(AstExprStructSet i _ v)
      (or
        (macro-node-uses-macro? ctx decls i)
        (macro-node-uses-macro? ctx decls v))]
    [(AstExprWithEscape i exprs)
      (or
        (macro-node-uses-macro? ctx decls i)
        (macro-exprs-use-macro? ctx decls exprs))]
    [(AstExprWithScratch exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(AstExprInArena i exprs)
      (or
        (macro-node-uses-macro? ctx decls i)
        (macro-exprs-use-macro? ctx decls exprs))]
    [(AstExprBox i) (macro-node-uses-macro? ctx decls i)]
    [(AstExprBoxGet i) (macro-node-uses-macro? ctx decls i)]
    [(AstExprBoxTake i) (macro-node-uses-macro? ctx decls i)]
    [(AstExprBoxSet i v)
      (or
        (macro-node-uses-macro? ctx decls i)
        (macro-node-uses-macro? ctx decls v))]
    [(AstExprComptime i) (macro-node-uses-macro? ctx decls i)]
    [(AstExprTry i) (macro-node-uses-macro? ctx decls i)]
    [(AstExprReturn i) (macro-node-uses-macro? ctx decls i)]
    [(AstExprPtrNullCheck i) (macro-node-uses-macro? ctx decls i)]
    [(AstExprPtrRead i) (macro-node-uses-macro? ctx decls i)]
    [(AstExprPtrWrite a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExprPtrOffset a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExprPtrCast i _) (macro-node-uses-macro? ctx decls i)]
    [(AstExprPtrToInt i) (macro-node-uses-macro? ctx decls i)]
    [(AstExprIntToPtr i _) (macro-node-uses-macro? ctx decls i)]
    [(AstExprStringData i) (macro-node-uses-macro? ctx decls i)]
    [(AstExprStringFromBytes a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExprArrayData i) (macro-node-uses-macro? ctx decls i)]
    [(AstExprBinaryData _) false]
    [(AstExprSpmdProgramIndex) false]
    [(AstExprSpmdProgramCount) false]
    [(AstExprCpuIdEax a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExprCpuIdEbx a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExprCpuIdEcx a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExprCpuIdEdx a b)
      (or
        (macro-node-uses-macro? ctx decls a)
        (macro-node-uses-macro? ctx decls b))]
    [(AstExprXgetbv i) (macro-node-uses-macro? ctx decls i)]
    [(AstExprSyscall exprs) (macro-exprs-use-macro? ctx decls exprs)]
    [(AstExprTypeLiteral _) false]
    [(AstExprInit _) false]
    [(AstExprPtrNull _) false]
    [(AstExprPtrAddrOf _) false]
    [(AstExprSpmdProgramIndex) false]
    [(AstExprSpmdProgramCount) false]
    [(AstExprProgramArgc) false]
    [(AstExprProgramArgv) false]
    [(AstExprProgramEnvp) false]
    [_ true]))

(define (macro-decl-uses-macro?
  [ctx : TcContext]
  [decls : AstDeclList]
  [decl : AstDecl]) : bool
  (match decl
    [(AstDeclDef _ _ expr-box) (macro-node-uses-macro? ctx decls expr-box)]
    [(AstDeclDefFn _ _ _ body-box _)
      (macro-node-uses-macro? ctx decls body-box)]
    [(AstDeclTest _ _ _) false]
    [(AstDeclImport (AstImportSpec kind _ _ _ _))
      (match kind
        [(AstImportMacro _ _) true]
        [(AstImportMacroDecls _ _) true]
        [_ false])]
    [(AstDeclUnsafe inner-box)
      (macro-decl-uses-macro? ctx decls (box-get inner-box))]
    [(AstDeclComptimeDecl _ template-box)
      (macro-decl-uses-macro? ctx decls (box-get template-box))]
    [_ false]))

;; Cheap, ctx-free, allocation-free over-approximation of "could the expander
;; fire a macro/compat call anywhere inside this expression". It is used as a
;; decl-level pre-filter in `macro-expand-decls`: a decl whose body cannot fire
;; is pushed to the output unchanged (shared, never copied through the expander),
;; skipping the per-decl `tc-context-with-module` allocation and the precise
;; `macro-decl-uses-macro?` walk (which resolves candidate calls via
;; `macro-call-decl`).
;;
;; SAFE BY CONSTRUCTION (must guarantee: if the expander could rewrite a child
;; expression, `macro-expr-might-fire? = true`, i.e. we never share what the
;; expander would expand). This is achieved by following child expressions that
;; can syntactically contain calls, with explicit false leaves for non-call
;; forms.
;;   - At `AstExprCall` it uses `macro-call-callee-maybe-macro?` -- the registry
;;     gate the expander itself checks before attempting expansion -- which is a
;;     superset of `macro-call-is-expandable?` (it skips the `macro-call-decl`
;;     resolution and treats any registry-name callee as a possible fire). So at
;;     every call mine flags at least whatever the precise walk flags.
;;   - Scoped/container forms (for example WithRegion, WithResource, and SPMD)
;;     recurse into their child expressions here as well, so ordinary
;;     scoped/resource/vector code without macro calls does not force the full
;;     macro setup path.
;; A bare `AstExprVar`/`AstExprSet` target/`AstExprPtrAddrOf` is never a call ->
;; false (matching the gate). This walk covers expr/compat macros only; the call
;; site additionally gates on `has-expr-type-macros` being false (type macros
;; expand from type positions the gate does not see).
(define (macro-expr-list-might-fire? [exprs : AstExprList]) : bool
  (match exprs
    [(AstExprNil) false]
    [(AstExprCons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (or (macro-expr-might-fire? expr) (macro-expr-list-might-fire? rest)))]))

(define (macro-let-binding-list-might-fire? [bindings : AstLetBindingList]) : bool
  (match bindings
    [(AstLetBindingNil) false]
    [(AstLetBindingCons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding _ _ init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (or
                (macro-expr-might-fire? init)
                (macro-let-binding-list-might-fire? rest)))]))]))

(define (macro-match-arms-might-fire? [arms : AstMatchArmList]) : bool
  (match arms
    [(AstMatchArmNil) false]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm _ body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (or
                (macro-expr-might-fire? body)
                (macro-match-arms-might-fire? rest)))]))]))

(define (macro-resource-binding-list-might-fire?
  [bindings : AstResourceBindingList]) : bool
  (match bindings
    [(AstResourceBindingNil) false]
    [(AstResourceBindingCons binding rest)
      (let
        [rest : AstResourceBindingList (box-get rest)]
        (match binding
          [(AstResourceBinding _ init-box cleanup-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              [cleanup : AstExpr (ast-node-get cleanup-box)]
              (or
                (macro-expr-might-fire? init)
                (macro-expr-might-fire? cleanup)
                (macro-resource-binding-list-might-fire? rest)))]))]))

(define (macro-expr-might-fire? [expr : AstExpr]) : bool
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExprLiteral _) false]
    [(AstExprVar _) false]
    [(AstExprCall func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (or
          (macro-call-callee-maybe-macro? func)
          (macro-expr-might-fire? func)
          (macro-expr-list-might-fire? args)))]
    [(AstExprBracketClause items) (macro-expr-list-might-fire? items)]
    [(AstExprBinary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (or (macro-expr-might-fire? left) (macro-expr-might-fire? right)))]
    [(AstExprUnary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExprIf cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (or
          (macro-expr-might-fire? cond)
          (macro-expr-might-fire? then-branch)
          (macro-expr-might-fire? else-branch)))]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (or
              (macro-let-binding-list-might-fire? bindings)
              (macro-expr-might-fire? body)))])]
    [(AstExprLambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda _ _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (macro-expr-might-fire? body))])]
    [(AstExprTuple exprs) (macro-expr-list-might-fire? exprs)]
    [(AstExprTupleRef tuple-box index-box)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        [index : AstExpr (ast-node-get index-box)]
        (or (macro-expr-might-fire? tuple) (macro-expr-might-fire? index)))]
    [(AstExprArray exprs) (macro-expr-list-might-fire? exprs)]
    [(AstExprMakeArray _ len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (macro-expr-might-fire? len))]
    [(AstExprArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (or (macro-expr-might-fire? array) (macro-expr-might-fire? index)))]
    [(AstExprArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (macro-expr-might-fire? array)
          (macro-expr-might-fire? index)
          (macro-expr-might-fire? value)))]
    [(AstExprArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or (macro-expr-might-fire? array) (macro-expr-might-fire? value)))]
    [(AstExprStringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (or (macro-expr-might-fire? str) (macro-expr-might-fire? index)))]
    [(AstExprWhile cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (or (macro-expr-might-fire? cond) (macro-expr-might-fire? body)))]
    [(AstExprBegin exprs) (macro-expr-list-might-fire? exprs)]
    [(AstExprUnsafe exprs) (macro-expr-list-might-fire? exprs)]
    [(AstExprSet _ value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (macro-expr-might-fire? value))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExprBorrow _ _ place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (macro-expr-might-fire? place))]
    [(AstExprMatch match-box)
      (match (box-get match-box)
        [(AstMatch scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            (or
              (macro-expr-might-fire? scrutinee)
              (macro-match-arms-might-fire? arms)))])]
    [(AstExprForeach fe-box)
      (match (box-get fe-box)
        [(AstForeach _ _ start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (or
              (macro-expr-might-fire? start)
              (macro-expr-might-fire? end)
              (macro-expr-might-fire? body)))])]
    [(AstExprSpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce _ _ _ start-box end-box init-box value-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            (or
              (macro-expr-might-fire? start)
              (macro-expr-might-fire? end)
              (macro-expr-might-fire? init)
              (macro-expr-might-fire? value)))])]
    [(AstExprSpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan _ _ _ start-box end-box _ _ init-box value-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            (or
              (macro-expr-might-fire? start)
              (macro-expr-might-fire? end)
              (macro-expr-might-fire? init)
              (macro-expr-might-fire? value)
              (macro-expr-might-fire? body)))])]
    [(AstExprSpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (or (macro-expr-might-fire? value) (macro-expr-might-fire? lane)))]
    [(AstExprSpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (or (macro-expr-might-fire? value) (macro-expr-might-fire? lane)))]
    [(AstExprStructGet receiver-box _)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (macro-expr-might-fire? receiver))]
    [(AstExprStructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or (macro-expr-might-fire? receiver) (macro-expr-might-fire? value)))]
    [(AstExprWithRegion _ body) (macro-expr-list-might-fire? body)]
    [(AstExprWithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (or (macro-expr-might-fire? scratch) (macro-expr-list-might-fire? body)))]
    [(AstExprWithScratch body) (macro-expr-list-might-fire? body)]
    [(AstExprInArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (or (macro-expr-might-fire? arena) (macro-expr-list-might-fire? body)))]
    [(AstExprWithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource bindings body)
          (or
            (macro-resource-binding-list-might-fire? bindings)
            (macro-expr-list-might-fire? body))])]
    [(AstExprBox inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExprBoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExprBoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExprBoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or (macro-expr-might-fire? inner) (macro-expr-might-fire? value)))]
    [(AstExprComptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExprTry inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExprReturn inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExprPtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-expr-might-fire? inner))]
    [(AstExprPtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (macro-expr-might-fire? ptr))]
    [(AstExprPtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or (macro-expr-might-fire? ptr) (macro-expr-might-fire? value)))]
    [(AstExprPtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (or (macro-expr-might-fire? ptr) (macro-expr-might-fire? offset)))]
    [(AstExprPtrCast ptr-box _)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (macro-expr-might-fire? ptr))]
    [(AstExprPtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (macro-expr-might-fire? ptr))]
    [(AstExprIntToPtr value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (macro-expr-might-fire? value))]
    [(AstExprStringData str-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        (macro-expr-might-fire? str))]
    [(AstExprStringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (or (macro-expr-might-fire? ptr) (macro-expr-might-fire? len)))]
    [(AstExprArrayData array-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (macro-expr-might-fire? array))]
    [(AstExprBinaryData _) false]
    [(AstExprSpmdProgramIndex) false]
    [(AstExprSpmdProgramCount) false]
    [(AstExprCpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or (macro-expr-might-fire? leaf) (macro-expr-might-fire? subleaf)))]
    [(AstExprCpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or (macro-expr-might-fire? leaf) (macro-expr-might-fire? subleaf)))]
    [(AstExprCpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or (macro-expr-might-fire? leaf) (macro-expr-might-fire? subleaf)))]
    [(AstExprCpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or (macro-expr-might-fire? leaf) (macro-expr-might-fire? subleaf)))]
    [(AstExprXgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (macro-expr-might-fire? index))]
    [(AstExprSyscall args) (macro-expr-list-might-fire? args)]
    [(AstExprTypeLiteral _) false]
    [(AstExprInit _) false]
    [(AstExprPtrNull _) false]
    [(AstExprPtrAddrOf _) false]
    [(AstExprProgramArgc) false]
    [(AstExprProgramArgv) false]
    [(AstExprProgramEnvp) false]
    [_ true]))

;; Decl-level companion to `macro-expr-might-fire?`. Returns true only for the
;; value-bearing decl kinds whose entire macro-expandable surface is a single
;; body expression that provably contains no fireable call -- such a decl can be
;; pushed to the macro-expand output unchanged (shared). Every other decl kind
;; returns false so it falls through to the precise `macro-expand-decl-with-path`
;; path (which shares or expands import placeholders, splices, defmacro, unsafe,
;; comptime templates, etc. correctly). Consulted only when the program has no
;; expr-type macros.
(define (macro-decl-cannot-fire? [decl : AstDecl]) : bool
  (match decl
    [(AstDeclDef _ _ expr-box)
      (not (macro-expr-might-fire? (ast-node-get expr-box)))]
    [(AstDeclDefFn _ _ _ body-box _)
      (not (macro-expr-might-fire? (ast-node-get body-box)))]
    [(AstDeclTest _ _ _) true]
    [_ false]))

;; After an inert Decls splice, the next arbitrary macro expansion needs a
;; rebuilt top env so generated symbols are visible. Core prelude macros are
;; deterministic syntax rewrites handled by `macro-core-fast-expand`; they do
;; not inspect the top env beyond the expressions already being expanded. Let
;; the same macro pass continue through declarations whose remaining macro work
;; is limited to those fast-path rewrites (or legacy bare when/unless guards),
;; while still stopping before user CTFE/Decls/Module macros.
(define (macro-call-safe-after-inert-splice?
  [ctx : TcContext]
  [decls : AstDeclList]
  [func : AstExpr]
  [call-expr : AstExpr]) : bool
  (match (macro-call-callee-name func)
    [(TcSomeString name)
      (if (macro-call-name-maybe-macro? name)
        (match (macro-call-decl ctx func decls call-expr)
          [(ResultMacroCallDecl.Ok maybe-decl)
            (match maybe-decl
              [(MacroMaybeDecl.Some macro-name definition-module _ ret _)
                (and
                  (not (tc-macro-result-decls? ret))
                  (not (tc-macro-result-module? ret))
                  (or
                    (and
                      (macro-core-prelude-module? definition-module)
                      (macro-core-fast-path-base-known?
                        (macro-core-fast-path-base macro-name)))
                    (macro-str-cat-fast-path? macro-name definition-module)))]
              [(MacroMaybeDecl.No)
                (or (string-eq name "when") (string-eq name "unless"))])]
          [(ResultMacroCallDecl.Err _) false])
        true)]
    [(TcNoString) true]))

(define (macro-expr-list-safe-after-inert-splice?
  [ctx : TcContext]
  [decls : AstDeclList]
  [exprs : AstExprList]) : bool
  (match exprs
    [(AstExprNil) true]
    [(AstExprCons expr rest)
      (and
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get expr))
        (macro-expr-list-safe-after-inert-splice? ctx decls (box-get rest)))]))

(define (macro-let-bindings-safe-after-inert-splice?
  [ctx : TcContext]
  [decls : AstDeclList]
  [bindings : AstLetBindingList]) : bool
  (match bindings
    [(AstLetBindingNil) true]
    [(AstLetBindingCons binding rest)
      (and
        (match binding
          [(AstLetBinding _ _ init-box)
            (macro-expr-safe-after-inert-splice?
              ctx
              decls
              (ast-node-get init-box))])
        (macro-let-bindings-safe-after-inert-splice? ctx decls (box-get rest)))]))

(define (macro-match-arms-safe-after-inert-splice?
  [ctx : TcContext]
  [decls : AstDeclList]
  [arms : AstMatchArmList]) : bool
  (match arms
    [(AstMatchArmNil) true]
    [(AstMatchArmCons arm rest)
      (and
        (match arm
          [(AstMatchArm _ body-box)
            (macro-expr-safe-after-inert-splice?
              ctx
              decls
              (ast-node-get body-box))])
        (macro-match-arms-safe-after-inert-splice? ctx decls (box-get rest)))]))

(define (macro-expr-safe-after-inert-splice?
  [ctx : TcContext]
  [decls : AstDeclList]
  [expr : AstExpr]) : bool
  (if (not (macro-expr-might-fire? expr))
    true
    (match expr
      [(AstExprSpanned inner-box _)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get inner-box))]
      [(AstExprLiteral _) true]
      [(AstExprVar _) true]
      [(AstExprCall func-box args)
        (let
          [func : AstExpr (ast-node-get func-box)]
          (and
            (macro-call-safe-after-inert-splice? ctx decls func expr)
            (macro-expr-safe-after-inert-splice? ctx decls func)
            (macro-expr-list-safe-after-inert-splice? ctx decls args)))]
      [(AstExprBracketClause items)
        (macro-expr-list-safe-after-inert-splice? ctx decls items)]
      [(AstExprBinary _ left-box right-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get left-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get right-box)))]
      [(AstExprUnary _ inner-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get inner-box))]
      [(AstExprIf cond-box then-box else-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get cond-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get then-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get else-box)))]
      [(AstExprLet let-box)
        (match (box-get let-box)
          [(AstLet bindings body-box)
            (and
              (macro-let-bindings-safe-after-inert-splice? ctx decls bindings)
              (macro-expr-safe-after-inert-splice?
                ctx
                decls
                (ast-node-get body-box)))])]
      [(AstExprLambda lambda-box)
        (match (box-get lambda-box)
          [(AstLambda _ _ body-box)
            (macro-expr-safe-after-inert-splice?
              ctx
              decls
              (ast-node-get body-box))])]
      [(AstExprTuple exprs)
        (macro-expr-list-safe-after-inert-splice? ctx decls exprs)]
      [(AstExprTupleRef tuple-box index-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get tuple-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get index-box)))]
      [(AstExprArray exprs)
        (macro-expr-list-safe-after-inert-splice? ctx decls exprs)]
      [(AstExprMakeArray _ len-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get len-box))]
      [(AstExprArrayRef array-box index-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get array-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get index-box)))]
      [(AstExprArraySet array-box index-box value-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get array-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get index-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get value-box)))]
      [(AstExprArrayPush array-box value-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get array-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get value-box)))]
      [(AstExprStringRef str-box index-box)
        (and
          (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get str-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get index-box)))]
      [(AstExprWhile cond-box body-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get cond-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get body-box)))]
      [(AstExprBegin exprs)
        (macro-expr-list-safe-after-inert-splice? ctx decls exprs)]
      [(AstExprUnsafe exprs)
        (macro-expr-list-safe-after-inert-splice? ctx decls exprs)]
      [(AstExprSet _ value-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get value-box))]
      [(AstExprAnn inner-box _)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get inner-box))]
      [(AstExprCast inner-box _)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get inner-box))]
      [(AstExprBorrow _ _ place-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get place-box))]
      [(AstExprMatch match-box)
        (match (box-get match-box)
          [(AstMatch scrutinee-box arms)
            (and
              (macro-expr-safe-after-inert-splice?
                ctx
                decls
                (ast-node-get scrutinee-box))
              (macro-match-arms-safe-after-inert-splice? ctx decls arms))])]
      [(AstExprForeach fe-box)
        (match (box-get fe-box)
          [(AstForeach _ _ start-box end-box body-box)
            (and
              (macro-expr-safe-after-inert-splice?
                ctx
                decls
                (ast-node-get start-box))
              (macro-expr-safe-after-inert-splice?
                ctx
                decls
                (ast-node-get end-box))
              (macro-expr-safe-after-inert-splice?
                ctx
                decls
                (ast-node-get body-box)))])]
      [(AstExprStructGet receiver-box _)
        (macro-expr-safe-after-inert-splice?
          ctx
          decls
          (ast-node-get receiver-box))]
      [(AstExprStructSet receiver-box _ value-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get receiver-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get value-box)))]
      [(AstExprWithEscape scratch-box body)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get scratch-box))
          (macro-expr-list-safe-after-inert-splice? ctx decls body))]
      [(AstExprWithScratch body)
        (macro-expr-list-safe-after-inert-splice? ctx decls body)]
      [(AstExprInArena arena-box body)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get arena-box))
          (macro-expr-list-safe-after-inert-splice? ctx decls body))]
      [(AstExprBox inner-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get inner-box))]
      [(AstExprBoxGet inner-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get inner-box))]
      [(AstExprBoxTake inner-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get inner-box))]
      [(AstExprBoxSet inner-box value-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get inner-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get value-box)))]
      [(AstExprComptime inner-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get inner-box))]
      [(AstExprTry inner-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get inner-box))]
      [(AstExprReturn inner-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get inner-box))]
      [(AstExprPtrNullCheck inner-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get inner-box))]
      [(AstExprPtrRead ptr-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get ptr-box))]
      [(AstExprPtrWrite ptr-box value-box)
        (and
          (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get ptr-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get value-box)))]
      [(AstExprPtrOffset ptr-box offset-box)
        (and
          (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get ptr-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get offset-box)))]
      [(AstExprPtrCast ptr-box _)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get ptr-box))]
      [(AstExprPtrToInt ptr-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get ptr-box))]
      [(AstExprIntToPtr value-box _)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get value-box))]
      [(AstExprStringData str-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get str-box))]
      [(AstExprStringFromBytes ptr-box len-box)
        (and
          (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get ptr-box))
          (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get len-box)))]
      [(AstExprArrayData array-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get array-box))]
      [(AstExprBinaryData _) true]
      [(AstExprSpmdProgramIndex) true]
      [(AstExprSpmdProgramCount) true]
      [(AstExprCpuIdEax leaf-box subleaf-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get leaf-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get subleaf-box)))]
      [(AstExprCpuIdEbx leaf-box subleaf-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get leaf-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get subleaf-box)))]
      [(AstExprCpuIdEcx leaf-box subleaf-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get leaf-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get subleaf-box)))]
      [(AstExprCpuIdEdx leaf-box subleaf-box)
        (and
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get leaf-box))
          (macro-expr-safe-after-inert-splice?
            ctx
            decls
            (ast-node-get subleaf-box)))]
      [(AstExprXgetbv index-box)
        (macro-expr-safe-after-inert-splice? ctx decls (ast-node-get index-box))]
      [(AstExprSyscall args)
        (macro-expr-list-safe-after-inert-splice? ctx decls args)]
      [(AstExprTypeLiteral _) true]
      [(AstExprInit _) true]
      [(AstExprPtrNull _) true]
      [(AstExprPtrAddrOf _) true]
      [(AstExprProgramArgc) true]
      [(AstExprProgramArgv) true]
      [(AstExprProgramEnvp) true]
      [_ false])))

(define (macro-decl-safe-after-inert-splice?
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]
  [decl : AstDecl]
  [can-share : bool]) : bool
  (cond
    [(macro-expanded-decl-inert? decl can-share) true]
    [(not can-share) false]
    [else
      (let
        [decl-ctx : TcContext (tc-context-with-module ctx module)]
        (match decl
          [(AstDeclDef _ _ expr-box)
            (macro-expr-safe-after-inert-splice?
              decl-ctx
              decls
              (ast-node-get expr-box))]
          [(AstDeclDefFn _ _ _ body-box _)
            (macro-expr-safe-after-inert-splice?
              decl-ctx
              decls
              (ast-node-get body-box))]
          [(AstDeclTest _ _ _) true]
          [(AstDeclImport (AstImportSpec kind _ _ _ _))
            (not (macro-import-placeholder-kind? kind))]
          [(AstDeclUnsafe inner-box)
            (macro-decl-safe-after-inert-splice?
              ctx
              decls
              module
              (box-get inner-box)
              can-share)]
          [(AstDeclComptimeDecl _ template-box)
            (macro-decl-safe-after-inert-splice?
              ctx
              decls
              module
              (box-get template-box)
              can-share)]
          [_ false]))]))

;; Whether the program contains any `(type T)` literal (AstExprTypeLiteral). ALL
;; CTFE reflection/layout queries (ctfe-reflect-resolve-type for a `(type T)`,
;; and every reflection/layout builtin -- size-of/struct-field-*/enum-variant-*/
;; ...) take a type-literal argument, and type literals are comptime-only (they
;; can't appear in runtime code). So a program with no type literal never queries
;; the CTFE metadata, and `tc-ctfe-env` can hand back an empty env instead of
;; building the whole-program reflection + layout tables (tens of MB, O(types^2)).
;; Macro `expr-type` calls also need metadata, but macro expansion tracks those
;; from defmacro bodies instead of making this whole-program scan normalize every
;; call head.
;; Conservative: any unrecognized expression returns `true` (build), so a future
;; node that could host a type literal is never silently skipped.
(define (ctfe-node-has-type-literal? [id : i64]) : bool
  (ctfe-expr-has-type-literal? (ast-node-get id)))

(define (ctfe-exprs-have-type-literal? [exprs : AstExprList]) : bool
  (match exprs
    [(AstExprNil) false]
    [(AstExprCons head rest)
      (or
        (ctfe-node-has-type-literal? head)
        (ctfe-exprs-have-type-literal? (box-get rest)))]))

(define (ctfe-arms-have-type-literal? [arms : AstMatchArmList]) : bool
  (match arms
    [(AstMatchArmNil) false]
    [(AstMatchArmCons arm rest)
      (or
        (match arm
          [(AstMatchArm _ body-box) (ctfe-node-has-type-literal? body-box)])
        (ctfe-arms-have-type-literal? (box-get rest)))]))

(define (ctfe-bindings-have-type-literal? [bindings : AstLetBindingList]) : bool
  (match bindings
    [(AstLetBindingNil) false]
    [(AstLetBindingCons binding rest)
      (or
        (match binding
          [(AstLetBinding _ _ init-box) (ctfe-node-has-type-literal? init-box)])
        (ctfe-bindings-have-type-literal? (box-get rest)))]))

(define (ctfe-expr-has-type-literal? [expr : AstExpr]) : bool
  (match expr
    [(AstExprTypeLiteral _) true]
    [(AstExprLiteral _) false]
    [(AstExprVar _) false]
    [(AstExprInit _) false]
    [(AstExprPtrNull _) false]
    [(AstExprPtrAddrOf _) false]
    [(AstExprProgramArgc) false]
    [(AstExprProgramArgv) false]
    [(AstExprProgramEnvp) false]
    [(AstExprSpanned inner-box _) (ctfe-node-has-type-literal? inner-box)]
    [(AstExprCall func-box args)
      (or
        (ctfe-node-has-type-literal? func-box)
        (ctfe-exprs-have-type-literal? args))]
    [(AstExprBracketClause items) (ctfe-exprs-have-type-literal? items)]
    [(AstExprBinary _ l r)
      (or (ctfe-node-has-type-literal? l) (ctfe-node-has-type-literal? r))]
    [(AstExprUnary _ i) (ctfe-node-has-type-literal? i)]
    [(AstExprIf c t e)
      (or
        (ctfe-node-has-type-literal? c)
        (ctfe-node-has-type-literal? t)
        (ctfe-node-has-type-literal? e))]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body)
          (or
            (ctfe-bindings-have-type-literal? bindings)
            (ctfe-node-has-type-literal? body))])]
    [(AstExprLambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda _ _ body) (ctfe-node-has-type-literal? body)])]
    [(AstExprTuple exprs) (ctfe-exprs-have-type-literal? exprs)]
    [(AstExprTupleRef a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExprArray exprs) (ctfe-exprs-have-type-literal? exprs)]
    [(AstExprMakeArray _ len) (ctfe-node-has-type-literal? len)]
    [(AstExprArrayRef a i)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? i))]
    [(AstExprArraySet a i v)
      (or
        (ctfe-node-has-type-literal? a)
        (ctfe-node-has-type-literal? i)
        (ctfe-node-has-type-literal? v))]
    [(AstExprArrayPush a v)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? v))]
    [(AstExprStringRef a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExprWhile c b)
      (or (ctfe-node-has-type-literal? c) (ctfe-node-has-type-literal? b))]
    [(AstExprBegin exprs) (ctfe-exprs-have-type-literal? exprs)]
    [(AstExprUnsafe exprs) (ctfe-exprs-have-type-literal? exprs)]
    [(AstExprSet _ rhs) (ctfe-node-has-type-literal? rhs)]
    [(AstExprAnn i _) (ctfe-node-has-type-literal? i)]
    [(AstExprCast i _) (ctfe-node-has-type-literal? i)]
    [(AstExprBorrow _ _ i) (ctfe-node-has-type-literal? i)]
    [(AstExprMatch match-box)
      (match (box-get match-box)
        [(AstMatch scrut arms)
          (or
            (ctfe-node-has-type-literal? scrut)
            (ctfe-arms-have-type-literal? arms))])]
    [(AstExprForeach fe-box)
      (match (box-get fe-box)
        [(AstForeach _ _ s e b)
          (or
            (ctfe-node-has-type-literal? s)
            (ctfe-node-has-type-literal? e)
            (ctfe-node-has-type-literal? b))])]
    [(AstExprStructGet i _) (ctfe-node-has-type-literal? i)]
    [(AstExprStructSet i _ v)
      (or (ctfe-node-has-type-literal? i) (ctfe-node-has-type-literal? v))]
    [(AstExprWithRegion _ exprs) (ctfe-exprs-have-type-literal? exprs)]
    [(AstExprWithEscape i exprs)
      (or (ctfe-node-has-type-literal? i) (ctfe-exprs-have-type-literal? exprs))]
    [(AstExprWithScratch exprs) (ctfe-exprs-have-type-literal? exprs)]
    [(AstExprInArena i exprs)
      (or (ctfe-node-has-type-literal? i) (ctfe-exprs-have-type-literal? exprs))]
    [(AstExprBox i) (ctfe-node-has-type-literal? i)]
    [(AstExprBoxGet i) (ctfe-node-has-type-literal? i)]
    [(AstExprBoxTake i) (ctfe-node-has-type-literal? i)]
    [(AstExprBoxSet i v)
      (or (ctfe-node-has-type-literal? i) (ctfe-node-has-type-literal? v))]
    [(AstExprComptime i) (ctfe-node-has-type-literal? i)]
    [(AstExprQuote i) (ctfe-node-has-type-literal? i)]
    [(AstExprQuasiquote i) (ctfe-node-has-type-literal? i)]
    [(AstExprUnquote i) (ctfe-node-has-type-literal? i)]
    [(AstExprUnquoteSplicing i) (ctfe-node-has-type-literal? i)]
    [(AstExprTry i) (ctfe-node-has-type-literal? i)]
    [(AstExprReturn i) (ctfe-node-has-type-literal? i)]
    [(AstExprPtrNullCheck i) (ctfe-node-has-type-literal? i)]
    [(AstExprPtrRead i) (ctfe-node-has-type-literal? i)]
    [(AstExprPtrWrite a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExprPtrOffset a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExprPtrCast i _) (ctfe-node-has-type-literal? i)]
    [(AstExprPtrToInt i) (ctfe-node-has-type-literal? i)]
    [(AstExprIntToPtr i _) (ctfe-node-has-type-literal? i)]
    [(AstExprStringData i) (ctfe-node-has-type-literal? i)]
    [(AstExprStringFromBytes a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExprArrayData i) (ctfe-node-has-type-literal? i)]
    [(AstExprBinaryData _) false]
    [(AstExprSpmdProgramIndex) false]
    [(AstExprSpmdProgramCount) false]
    [(AstExprCpuIdEax a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExprCpuIdEbx a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExprCpuIdEcx a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExprCpuIdEdx a b)
      (or (ctfe-node-has-type-literal? a) (ctfe-node-has-type-literal? b))]
    [(AstExprXgetbv i) (ctfe-node-has-type-literal? i)]
    [(AstExprSyscall exprs) (ctfe-exprs-have-type-literal? exprs)]
    [_ true]))

(define (ctfe-decl-has-type-literal? [decl : AstDecl]) : bool
  (match decl
    [(AstDeclDef _ _ expr-box) (ctfe-node-has-type-literal? expr-box)]
    [(AstDeclDefFn _ _ _ body-box _) (ctfe-node-has-type-literal? body-box)]
    [(AstDeclTest _ expr-box _) (ctfe-node-has-type-literal? expr-box)]
    [(AstDeclDefMacro _ _ _ body-box) (ctfe-node-has-type-literal? body-box)]
    [(AstDeclUnsafe inner-box)
      (ctfe-decl-has-type-literal? (box-get inner-box))]
    [(AstDeclComptimeDecl _ template-box)
      (ctfe-decl-has-type-literal? (box-get template-box))]
    [_ false]))

(define (ctfe-program-has-type-literal? [decls : AstDeclList]) : bool
  (match decls
    [(AstDeclNil) false]
    [(AstDeclCons decl rest)
      (or
        (ctfe-decl-has-type-literal? decl)
        (ctfe-program-has-type-literal? (box-get rest)))]))

(define (macro-expanded-decl-inert? [decl : AstDecl] [can-share : bool]) : bool
  (match decl
    [(AstDeclModule _) true]
    [(AstDeclDef _ _ _) (and can-share (macro-decl-cannot-fire? decl))]
    [(AstDeclDefFn _ _ _ _ _) (and can-share (macro-decl-cannot-fire? decl))]
    [(AstDeclTest _ _ _) (and can-share (macro-decl-cannot-fire? decl))]
    [(AstDeclExtern _ _ _ _) true]
    [(AstDeclDefEnum _ _ _) true]
    [(AstDeclDefEnumLifetimes _ _ _ _) true]
    [(AstDeclDefStruct _ _ _ _) true]
    [(AstDeclDefStructLifetimes _ _ _ _ _) true]
    [(AstDeclIncludeStr _ _) true]
    [(AstDeclIncludeBin _ _) true]
    [(AstDeclDefDispatch _ _) true]
    [(AstDeclUnsafe inner-box)
      (macro-expanded-decl-inert? (box-get inner-box) can-share)]
    [(AstDeclComptimeDecl _ template-box)
      (macro-expanded-decl-inert? (box-get template-box) can-share)]
    [_ false]))

(define (macro-expanded-decls-inert? [decls : AstDeclList] [can-share : bool]) : bool
  (match decls
    [(AstDeclNil) true]
    [(AstDeclCons decl rest)
      (and
        (macro-expanded-decl-inert? decl can-share)
        (macro-expanded-decls-inert? (box-get rest) can-share))]))

(define (macro-decl-vector-family-placeholder-call?
  [ctx : TcContext]
  [orig-decls : AstDeclList]
  [module : String]
  [call-id : i64]
  [context : AstMaybeModuleName]) : bool
  (let
    [call-expr : AstExpr (ast-node-get call-id)]
    (match (ast-expr-unspan call-expr)
      [(AstExprCall func-box _)
        (let
          [func : AstExpr (ast-node-get func-box)]
          (match (macro-call-decl-with-context
            ctx
            func
            orig-decls
            module
            context
            call-expr)
            [(ResultMacroCallDeclModule.Ok maybe-decl _)
              (match maybe-decl
                [(MacroMaybeDecl.Some macro-name definition-module _ ret _)
                  (and
                    (tc-macro-result-decls? ret)
                    (macro-vector-family-decls-macro?
                      macro-name
                      definition-module))]
                [(MacroMaybeDecl.No) false])]
            [(ResultMacroCallDeclModule.Err _) false]))]
      [_ false])))

(define (macro-decl-vector-family-placeholder?
  [ctx : TcContext]
  [orig-decls : AstDeclList]
  [module : String]
  [decl : AstDecl]) : bool
  (match decl
    [(AstDeclImport (AstImportSpec kind _ _ _ _))
      (match kind
        [(AstImportMacroDecls call-id context)
          (macro-decl-vector-family-placeholder-call?
            ctx
            orig-decls
            module
            call-id
            context)]
        [_ false])]
    [(AstDeclComptimeDecl _ template-box)
      (macro-decl-vector-family-placeholder?
        ctx
        orig-decls
        module
        (box-get template-box))]
    [_ false]))

(define (macro-expand-decls
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [module : String]
  [can-share : bool]) : ResultMacroDeclsWithPaths
  (let
    [cur-decls : AstDeclList decls]
    [cur-paths : AstDeclPathList paths]
    [cur-module : String module]
    [cur-index : i64 0]
    [cur-top-env : TcTypeEnv top-env]
    [out-rev : AstDeclList AstDeclNil]
    [out-paths-rev : AstDeclPathList AstDeclPathNil]
    ;; After an inert generated splice, continue across inert declarations,
    ;; vector-family splices, and core fast-path macros. Arbitrary macro work
    ;; needs a rebuilt top env so generated symbols are visible.
    [batched-inert-splice? : bool false]
    [result : ResultMacroDeclsWithPaths
      (ResultMacroDeclsWithPaths.Err
        (box (tc-diag-at-start "macro: internal decl expansion walk")))]
    [done : bool false]
    (begin
      (while (not done)
        (match cur-decls
          [(AstDeclNil)
            (begin
              (set!
                result
                (ResultMacroDeclsWithPaths.Ok
                  (macro-decl-list-reverse out-rev)
                  (macro-decl-path-list-reverse out-paths-rev)
                  MacroFollowupWorkNil))
              (set! done true))]
          [(AstDeclCons decl rest)
            (let
              [rest : AstDeclList (box-get rest)]
              [decl-path : String
                (match cur-paths
                  [(AstDeclPathCons path _) path]
                  [(AstDeclPathNil) ""])]
              [rest-paths : AstDeclPathList
                (match cur-paths
                  [(AstDeclPathCons _ path-rest)
                    (let
                      [path-rest : AstDeclPathList (box-get path-rest)]
                      path-rest)]
                  [(AstDeclPathNil) AstDeclPathNil])]
              (match decl
                [(AstDeclModule next-module)
                  (begin
                    (set! out-rev (ast-decl-cons decl out-rev))
                    (set!
                      out-paths-rev
                      (ast-decl-path-cons decl-path out-paths-rev))
                    (set! cur-decls rest)
                    (set! cur-paths rest-paths)
                    (set! cur-index (+ cur-index 1))
                    (set! cur-module (intern-str next-module)))]
                [_
                  (cond
                    [(and
                        (macro-decl-import-placeholder? decl)
                        batched-inert-splice?
                        (not
                          (macro-decl-vector-family-placeholder?
                            ctx
                            orig-decls
                            cur-module
                            decl)))
                      (begin
                        (set!
                          result
                          (ResultMacroDeclsWithPaths.Ok
                            (macro-decl-list-append
                              (macro-decl-list-reverse out-rev)
                              cur-decls)
                            (macro-decl-path-list-append
                              (macro-decl-path-list-reverse out-paths-rev)
                              cur-paths)
                            (macro-followup-work-at
                              cur-index
                              (+ cur-index 1)
                              decl-path
                              decl-path
                              cur-module
                              MacroFollowupImportPlaceholder)))
                        (set! done true))]
                    [(macro-decl-import-placeholder? decl)
                      (match (macro-expand-decl-with-path
                        ctx
                        cur-top-env
                        orig-decls
                        cur-module
                        decl
                        decl-path)
                        [(ResultMacroDeclExpansion.Ok expanded expanded-paths)
                          (let
                            [next-module : String
                              (macro-decls-final-module expanded cur-module)]
                            (if (macro-expanded-decls-inert? expanded can-share)
                              (match (tc-build-top-env-list-in-module
                                ctx
                                expanded
                                cur-top-env
                                cur-module)
                                [(OkTcEnv next-top-env)
                                  (begin
                                    (tc-hygiene-reset-active-top-env!
                                      next-top-env)
                                    (set! cur-top-env next-top-env)
                                    (set!
                                      out-rev
                                      (macro-decl-list-reverse-into
                                        expanded
                                        out-rev))
                                    (set!
                                      out-paths-rev
                                      (macro-decl-path-list-reverse-into
                                        expanded-paths
                                        out-paths-rev))
                                    (set! cur-module next-module)
                                    (set! cur-decls rest)
                                    (set! cur-paths rest-paths)
                                    (set!
                                      cur-index
                                      (+
                                        cur-index
                                        (ast-decl-list-count expanded)))
                                    (set! batched-inert-splice? true))]
                                [(ErrTcEnv message)
                                  (begin
                                    (set!
                                      result
                                      (ResultMacroDeclsWithPaths.Err
                                        (box (tc-diag-at-start message))))
                                    (set! done true))])
                              (begin
                                (set!
                                  result
                                  (ResultMacroDeclsWithPaths.Ok
                                    (macro-decl-list-append
                                      (macro-decl-list-reverse out-rev)
                                      (macro-decl-list-append expanded rest))
                                    (macro-decl-path-list-append
                                      (macro-decl-path-list-reverse
                                        out-paths-rev)
                                      (macro-decl-path-list-append
                                        expanded-paths
                                        rest-paths))
                                    (macro-followup-work-for-decls
                                      cur-index
                                      expanded
                                      expanded-paths
                                      cur-module
                                      MacroFollowupExpandedDecl)))
                                (set! done true))))]
                        [(ResultMacroDeclExpansion.Err diag)
                          (begin
                            (set! result (ResultMacroDeclsWithPaths.Err diag))
                            (set! done true))])]
                    [(and
                        batched-inert-splice?
                        (not
                          (macro-decl-safe-after-inert-splice?
                            ctx
                            orig-decls
                            cur-module
                            decl
                            can-share)))
                      (begin
                        (set!
                          result
                          (ResultMacroDeclsWithPaths.Ok
                            (macro-decl-list-append
                              (macro-decl-list-reverse out-rev)
                              cur-decls)
                            (macro-decl-path-list-append
                              (macro-decl-path-list-reverse out-paths-rev)
                              cur-paths)
                            (macro-followup-work-at
                              cur-index
                              (+ cur-index 1)
                              decl-path
                              decl-path
                              cur-module
                              MacroFollowupBlockedAfterInertSplice)))
                        (set! done true))]
                    [(and can-share (macro-decl-cannot-fire? decl))
                      ;; Predict-skip: a macro-free value decl can never fire a
                      ;; macro, so share it unchanged (like the AstDeclModule
                      ;; arm) instead of copying it through the expander. This
                      ;; avoids the per-decl `tc-context-with-module` allocation
                      ;; and the single-element relist that
                      ;; `macro-expand-decl-with-path` would otherwise retain in
                      ;; the installed pools. A non-module value decl never
                      ;; changes the active module, so `cur-module` is unchanged.
                      (begin
                        (set! out-rev (ast-decl-cons decl out-rev))
                        (set!
                          out-paths-rev
                          (ast-decl-path-cons decl-path out-paths-rev))
                        (set! cur-decls rest)
                        (set! cur-paths rest-paths)
                        (set! cur-index (+ cur-index 1)))]
                    [else
                      (match (macro-expand-decl-with-path
                        ctx
                        cur-top-env
                        orig-decls
                        cur-module
                        decl
                        decl-path)
                        [(ResultMacroDeclExpansion.Ok expanded expanded-paths)
                          (begin
                            (set!
                              out-rev
                              (macro-decl-list-reverse-into expanded out-rev))
                            (set!
                              out-paths-rev
                              (macro-decl-path-list-reverse-into
                                expanded-paths
                                out-paths-rev))
                            (set!
                              cur-module
                              (macro-decls-final-module expanded cur-module))
                            (set! cur-decls rest)
                            (set! cur-paths rest-paths)
                            (set!
                              cur-index
                              (+ cur-index (ast-decl-list-count expanded))))]
                        [(ResultMacroDeclExpansion.Err diag)
                          (begin
                            (set! result (ResultMacroDeclsWithPaths.Err diag))
                            (set! done true))])])]))]))
      result)))

(define (macro-expr-needs-compat-expansion? [expr : AstExpr]) : bool
  (or
    (tc-expr-uses-free-name? expr "when" TcStringNil)
    (tc-expr-uses-free-name? expr "unless" TcStringNil)))

(define (macro-decl-needs-expansion? [decl : AstDecl]) : bool
  (match decl
    [(AstDeclDef _ _ expr-box)
      (let
        [expr : AstExpr (ast-node-get expr-box)]
        (macro-expr-needs-compat-expansion? expr))]
    [(AstDeclDefFn _ _ _ body-box _)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (macro-expr-needs-compat-expansion? body))]
    [(AstDeclDefMacro _ _ _ _) true]
    [(AstDeclTest _ _ _) false]
    [(AstDeclImport (AstImportSpec kind _ _ _ _))
      (match kind
        [(AstImportMacro _ _) true]
        [(AstImportMacroDecls _ _) true]
        [_ false])]
    [(AstDeclUnsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (macro-decl-needs-expansion? inner))]
    [(AstDeclComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (macro-decl-needs-expansion? template))]
    [_ false]))

(define (macro-decl-has-defmacro? [decl : AstDecl]) : bool
  (match decl
    [(AstDeclDefMacro _ _ _ _) true]
    [(AstDeclUnsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (macro-decl-has-defmacro? inner))]
    [(AstDeclComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (macro-decl-has-defmacro? template))]
    [_ false]))

;; Whether a program needs the macro expansion pass.
(define (macro-program-needs-expansion? [decls : AstDeclList]) : bool
  (match decls
    [(AstDeclNil) false]
    [(AstDeclCons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (or
          (macro-decl-needs-expansion? decl)
          (macro-program-needs-expansion? rest)))]))

(define (macro-program-has-defmacro? [decls : AstDeclList]) : bool
  (match decls
    [(AstDeclNil) false]
    [(AstDeclCons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (or (macro-decl-has-defmacro? decl) (macro-program-has-defmacro? rest)))]))

(define (macro-decl-might-fire-expression-macro? [decl : AstDecl]) : bool
  (match decl
    [(AstDeclDef _ _ expr-box) (macro-expr-might-fire? (ast-node-get expr-box))]
    [(AstDeclDefFn _ _ _ body-box _)
      (macro-expr-might-fire? (ast-node-get body-box))]
    [(AstDeclUnsafe inner-box)
      (macro-decl-might-fire-expression-macro? (box-get inner-box))]
    [(AstDeclComptimeDecl _ template-box)
      (macro-decl-might-fire-expression-macro? (box-get template-box))]
    [_ false]))

(define (macro-program-might-fire-expression-macro? [decls : AstDeclList]) : bool
  (match decls
    [(AstDeclNil) false]
    [(AstDeclCons decl rest)
      (or
        (macro-decl-might-fire-expression-macro? decl)
        (macro-program-might-fire-expression-macro? (box-get rest)))]))

(define (macro-import-kind-summary-backed? [kind : AstImportKind]) : bool
  (match kind
    [(AstImportPath) true]
    [(AstImportModule) true]
    [_ false]))

(define (macro-import-target-has-summary-macro?
  [kind : AstImportKind]
  [target : AstMaybeModuleName]) : bool
  (if (macro-import-kind-summary-backed? kind)
    (match target
      [(AstSomeModuleName target-module)
        (macro-surface-module-has-macro? target-module)]
      [(AstNoModuleName) false])
    false))

(define (macro-decl-has-summary-macro-import? [decl : AstDecl]) : bool
  (match decl
    [(AstDeclImport (AstImportSpec kind _ target _ _))
      (macro-import-target-has-summary-macro? kind target)]
    [(AstDeclUnsafe inner-box)
      (macro-decl-has-summary-macro-import? (box-get inner-box))]
    [(AstDeclComptimeDecl _ template-box)
      (macro-decl-has-summary-macro-import? (box-get template-box))]
    [_ false]))

(define (macro-program-has-summary-macro-import? [decls : AstDeclList]) : bool
  (match decls
    [(AstDeclNil) false]
    [(AstDeclCons decl rest)
      (or
        (macro-decl-has-summary-macro-import? decl)
        (macro-program-has-summary-macro-import? (box-get rest)))]))

(define (macro-decl-has-module-placeholder? [decl : AstDecl]) : bool
  (match decl
    [(AstDeclImport (AstImportSpec kind _ _ _ _))
      (match kind
        [(AstImportMacro _ _) true]
        [(AstImportMacroDecls _ _) true]
        [_ false])]
    [(AstDeclUnsafe inner-box)
      (macro-decl-has-module-placeholder? (box-get inner-box))]
    [(AstDeclComptimeDecl _ template-box)
      (macro-decl-has-module-placeholder? (box-get template-box))]
    [_ false]))

(define (macro-program-has-module-placeholder? [decls : AstDeclList]) : bool
  (match decls
    [(AstDeclNil) false]
    [(AstDeclCons decl rest)
      (or
        (macro-decl-has-module-placeholder? decl)
        (macro-program-has-module-placeholder? (box-get rest)))]))

(define (macro-module-placeholder-followup-work-list-in
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [module : String]
  [index : i64]) : MacroFollowupWorkList
  (match decls
    [(AstDeclNil) MacroFollowupWorkNil]
    [(AstDeclCons decl rest-box)
      (let
        [rest : AstDeclList (box-get rest-box)]
        [decl-path : String
          (match paths
            [(AstDeclPathCons path _) path]
            [(AstDeclPathNil) ""])]
        [rest-paths : AstDeclPathList
          (match paths
            [(AstDeclPathCons _ path-rest)
              (let
                [path-rest : AstDeclPathList (box-get path-rest)]
                path-rest)]
            [(AstDeclPathNil) AstDeclPathNil])]
        [next-module : String
          (match decl
            [(AstDeclModule name) (intern-str name)]
            [_ module])]
        [tail : MacroFollowupWorkList
          (macro-module-placeholder-followup-work-list-in
            rest
            rest-paths
            next-module
            (+ index 1))]
        (if (macro-decl-has-module-placeholder? decl)
          (macro-followup-work-cons
            (MacroFollowupWork
              index
              (+ index 1)
              decl-path
              decl-path
              module
              MacroFollowupModulePlaceholder)
            tail)
          tail))]))

(define (macro-module-placeholder-followup-work-list
  [decls : AstDeclList]
  [paths : AstDeclPathList]) : MacroFollowupWorkList
  (macro-module-placeholder-followup-work-list-in decls paths "" 0))

(define (macro-decl-module-placeholder-count [decl : AstDecl]) : i64
  (match decl
    [(AstDeclImport (AstImportSpec kind _ _ _ _))
      (match kind
        [(AstImportMacro _ _) 1]
        [(AstImportMacroDecls _ _) 1]
        [_ 0])]
    [(AstDeclUnsafe inner-box)
      (macro-decl-module-placeholder-count (box-get inner-box))]
    [(AstDeclComptimeDecl _ template-box)
      (macro-decl-module-placeholder-count (box-get template-box))]
    [_ 0]))

(define (macro-program-module-placeholder-count [decls : AstDeclList]) : i64
  (match decls
    [(AstDeclNil) 0]
    [(AstDeclCons decl rest)
      (+
        (macro-decl-module-placeholder-count decl)
        (macro-program-module-placeholder-count (box-get rest)))]))

;; Expand all macro calls in a parsed program before typechecking. Programs that
;; need no macro or guard-compatibility expansion are returned unchanged without
;; rebuilding the AST, so the expansion phase adds no allocation for the common
;; case.
(define (macro-expand-program-pass-with-paths-and-pools-with-followup
  [program : AstProgram]
  [paths : AstDeclPathList]
  [pools : AstNodePoolContext]) : ResultMacroExpandPass
  (begin
    (ast-node-pool-context-install! pools)
    (match program
      [(AstProgram decls-box)
        (let
          [decls : AstDeclList (box-get decls-box)]
          [has-defmacro : bool (macro-program-has-defmacro? decls)]
          [expr-type-macro-names : TcStringList
            (if has-defmacro
              (macro-collect-expr-type-macro-names decls)
              TcStringNil)]
          [has-expr-type-macros : bool
            (match expr-type-macro-names
              [(TcStringNil) false]
              [_ true])]
          [program-needs-expansion : bool
            (macro-program-needs-expansion? decls)]
          [has-summary-macro-import : bool
            (and
              (not has-defmacro)
              (not program-needs-expansion)
              (macro-program-has-summary-macro-import? decls))]
          [prescan-macro-names : TcStringList
            (if has-summary-macro-import
              (macro-collect-visible-macro-names decls)
              TcStringNil)]
          [has-visible-macro-call : bool
            (if has-summary-macro-import
              (begin
                (set! macro-expand-macro-names prescan-macro-names)
                (macro-program-might-fire-expression-macro? decls))
              false)]
          (begin
            ;; Reset the per-compile CTFE-env cache so a later comptime evaluation
            ;; (or the next program in a multi-program process) never reuses a stale
            ;; or another program's metadata. The cache is repopulated eagerly below.
            (set! macro-expand-ctfe-env-ready false)
            (cfg compile-profile (compiler-tc-macro-profile-reset))
            ;; Same per-compile reset for the clone-able type set cache.
            (tc-clone-able-cache-reset!)
            ;; Type-name misses are keyed only by lookup text. Each macro
            ;; fixed-point pass rebuilds symbols from a different expanded
            ;; program, so a miss from an earlier pass must not hide generated
            ;; module-local types introduced by that pass.
            (tc-nominal-owner-cache-reset!)
            ;; Same per-compile reset for the qualified-alias resolution cache:
            ;; the (module, qualifier) -> target mapping is derived from this
            ;; program's declarations.
            (macro-alias-derived-cache-reset!)
            (ctfe-module-macro-export-reset!)
            (set! macro-expand-expr-type-macro-names expr-type-macro-names)
            ;; Only build the (tens-of-MB, O(types^2)) reflection/layout metadata if
            ;; the program actually contains a `(type T)` literal -- the sole entry
            ;; point for every CTFE reflection/layout query.
            (set!
              ctfe-needs-metadata
              (or
                has-defmacro
                has-visible-macro-call
                (ctfe-program-has-type-literal? decls)
                has-expr-type-macros))
            (if (or has-defmacro has-visible-macro-call program-needs-expansion)
              (begin
                (cfg compile-profile (compiler-tc-profile-start))
                (match (build-compiler-symbols-with-paths program paths)
                  [(ResultCompilerSymbols.Ok symbols)
                    (match (build-compiler-registries-with-symbols
                      program
                      symbols)
                      [(ResultCompilerRegistries.Ok registries)
                        (begin
                          (set! macro-expand-active-module "")
                          (set!
                            macro-expand-macro-names
                            (macro-collect-visible-macro-names decls))
                          (let
                            [ctx : TcContext
                              (TcContext program symbols registries "" pools)]
                            (match (tc-stdlib-comptime-surface-ok ctx)
                              [(OkTcUnit)
                                (match (tc-build-top-env ctx program)
                                  [(OkTcEnv top-env)
                                    (begin
                                      (tc-hygiene-reset-active-top-env! top-env)
                                      (tc-context-capture-active-pools! ctx)
                                      (cfg
                                        compile-profile
                                        (compiler-tc-profile-finish
                                          "macro_setup"))
                                      (set!
                                        macro-expand-ctfe-env-value
                                        (tc-ctfe-env ctx))
                                      (set! macro-expand-ctfe-env-ready true)
                                      (cfg
                                        compile-profile
                                        (compiler-tc-profile-start))
                                      (match (macro-expand-decls
                                        ctx
                                        top-env
                                        decls
                                        decls
                                        paths
                                        ""
                                        (not has-expr-type-macros))
                                        [(ResultMacroDeclsWithPaths.Ok
                                            ndecls
                                            npaths
                                            followup-work)
                                          (begin
                                            (tc-context-capture-active-pools!
                                              ctx)
                                            (cfg
                                              compile-profile
                                              (compiler-tc-profile-finish
                                                "macro_walk"))
                                            (cfg
                                              compile-profile
                                              (compiler-tc-macro-profile-emit))
                                            (ResultMacroExpandPass.Ok
                                              (ast-program ndecls)
                                              npaths
                                              followup-work))]
                                        [(ResultMacroDeclsWithPaths.Err diag)
                                          (begin
                                            (tc-context-capture-active-pools!
                                              ctx)
                                            (cfg
                                              compile-profile
                                              (compiler-tc-profile-finish
                                                "macro_walk"))
                                            (cfg
                                              compile-profile
                                              (compiler-tc-macro-profile-emit))
                                            (ResultMacroExpandPass.Err diag))]))]
                                  [(ErrTcEnv message)
                                    (ResultMacroExpandPass.Err
                                      (box (tc-diag-at-start message)))])]
                              [(ErrTcUnit message)
                                (ResultMacroExpandPass.Err
                                  (box (tc-diag-at-start message)))])))]
                      [(ResultCompilerRegistries.Err message)
                        (ResultMacroExpandPass.Err
                          (box (tc-diag-at-start message)))])]
                  [(ResultCompilerSymbols.Err message)
                    (ResultMacroExpandPass.Err (box (tc-diag-at-start message)))]))
              (ResultMacroExpandPass.Ok program paths MacroFollowupWorkNil))))])))

(define (macro-expand-program-pass-with-paths-and-pools
  [program : AstProgram]
  [paths : AstDeclPathList]
  [pools : AstNodePoolContext]) : ResultMacroExpand
  (match (macro-expand-program-pass-with-paths-and-pools-with-followup
    program
    paths
    pools)
    [(ResultMacroExpandPass.Ok expanded expanded-paths _)
      (ResultMacroExpand.Ok expanded expanded-paths)]
    [(ResultMacroExpandPass.Err diag) (ResultMacroExpand.Err diag)]))

(define (macro-expand-program-pass-with-paths
  [program : AstProgram]
  [paths : AstDeclPathList]) : ResultMacroExpand
  (macro-expand-program-pass-with-paths-and-pools
    program
    paths
    (ast-node-pool-context-capture-active)))

(define (macro-expand-fixed-point-limit) : i64
  8)

;; Generated modules can introduce their own import placeholders for the next
;; pass. Keep a fixed guard, but scale it with loaded placeholder volume so
;; legitimate nested module families converge under `test` cfg stdlib imports.
(define (macro-expand-fixed-point-limit-for-program [program : AstProgram]) : i64
  (match program
    [(AstProgram decls-box)
      (+
        (macro-expand-fixed-point-limit)
        (*
          (macro-expand-fixed-point-limit)
          (macro-program-module-placeholder-count (box-get decls-box))))]))

(defenum MacroMaybeGeneratedNormalImport
  (No)
  (Some
    AstImportKind
    String
    AstMaybeModuleName
    AstMaybeImportAlias
    AstSourceSpan
    AstDecl))

(defenum ResultMacroMaterializeImport
  (Ok AstDeclList AstDeclPathList SymI64Env MacroFollowupWorkList)
  (Err (Box CompilerDiagnostic)))

(define (macro-generated-normal-import [decl : AstDecl]) : MacroMaybeGeneratedNormalImport
  (match decl
    [(AstDeclComptimeDecl meta template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (match meta
          [(AstSomeGeneratedDeclMeta _ _ _ _)
            (match template
              [(AstDeclImport
                  (AstImportSpec kind import-path expected alias span))
                (if (macro-import-placeholder-kind? kind)
                  (MacroMaybeGeneratedNormalImport.No)
                  (MacroMaybeGeneratedNormalImport.Some
                    kind
                    import-path
                    expected
                    alias
                    span
                    template))]
              [_ (MacroMaybeGeneratedNormalImport.No)])]
          [(AstNoGeneratedDeclMeta) (macro-generated-normal-import template)]))]
    [(AstDeclUnsafe inner-box)
      (macro-generated-normal-import (box-get inner-box))]
    [_ (MacroMaybeGeneratedNormalImport.No)]))

(define (macro-materialize-seen-from
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [seen : SymI64Env]) : SymI64Env
  (match decls
    [(AstDeclNil) seen]
    [(AstDeclCons decl rest-box)
      (let
        [rest : AstDeclList (box-get rest-box)]
        [decl-path : String
          (match paths
            [(AstDeclPathCons path _) path]
            [(AstDeclPathNil) ""])]
        [rest-paths : AstDeclPathList
          (match paths
            [(AstDeclPathCons _ path-rest)
              (let
                [path-rest : AstDeclPathList (box-get path-rest)]
                path-rest)]
            [(AstDeclPathNil) AstDeclPathNil])]
        [seen-path : SymI64Env
          (if (> (string.string-length decl-path) 0)
            (sym-i64-bind seen (compiler-load-seen-path-key decl-path) 1)
            seen)]
        [seen-decl : SymI64Env
          (match decl
            [(AstDeclModule name)
              (let
                [module-name : String (intern-str name)]
                (if (> (string.string-length module-name) 0)
                  (sym-i64-bind seen-path module-name 1)
                  seen-path))]
            [_ seen-path])]
        (macro-materialize-seen-from rest rest-paths seen-decl))]))

(define (macro-materialize-import-diagnostic
  [path : String]
  [span : AstSourceSpan]
  [message : String]) : CompilerDiagnostic
  (tc-canonical-diagnostic
    (compiler-diagnostic-from-ast-span path span message)))

(define (macro-materialize-generated-import
  [decl : AstDecl]
  [decl-path : String]
  [module : String]
  [decl-index : i64]
  [seen : SymI64Env]
  [stdlib-roots : vector.StringVec]
  [cfgs : SymI64Env]
  [pools : AstNodePoolContext]) : ResultMacroMaterializeImport
  (match (macro-generated-normal-import decl)
    [(MacroMaybeGeneratedNormalImport.No)
      (ResultMacroMaterializeImport.Ok
        (ast-decl-cons decl AstDeclNil)
        (ast-decl-path-cons decl-path AstDeclPathNil)
        seen
        MacroFollowupWorkNil)]
    [(MacroMaybeGeneratedNormalImport.Some
        kind
        import-path
        expected
        alias
        span
        _)
      (let
        [import-root : String (compiler-load-dirname decl-path)]
        (match (compiler-load-resolve-import-spec-with-roots
          decl-path
          import-root
          kind
          import-path
          stdlib-roots)
          [(ResultPkgResolve.Ok resolved)
            (match (compiler-load-file-with-paths-and-roots-expect-cfg-root-with-pools
              resolved
              seen
              stdlib-roots
              expected
              import-root
              cfgs
              pools)
              [(ResultCompilerLoadWithPaths.Ok
                  imported-decls
                  imported-paths
                  _
                  next-seen)
                (let
                  [after-import-expected : AstMaybeModuleName
                    (compiler-load-after-import-expected-module
                      kind
                      expected
                      alias
                      imported-decls)]
                  [after-import-alias : AstMaybeImportAlias
                    (compiler-load-after-import-alias
                      kind
                      expected
                      alias
                      imported-decls)]
                  [tail-decls : AstDeclList
                    (compiler-load-decls-after-import
                      kind
                      resolved
                      after-import-expected
                      after-import-alias
                      module
                      imported-decls
                      AstDeclNil)]
                  [tail-paths : AstDeclPathList
                    (compiler-load-paths-after-import
                      decl-path
                      after-import-alias
                      imported-decls
                      AstDeclPathNil)]
                  [materialized-decls : AstDeclList
                    (macro-decl-list-append imported-decls tail-decls)]
                  [materialized-paths : AstDeclPathList
                    (macro-decl-path-list-append imported-paths tail-paths)]
                  (ResultMacroMaterializeImport.Ok
                    materialized-decls
                    materialized-paths
                    next-seen
                    (macro-followup-work-for-decls
                      decl-index
                      materialized-decls
                      materialized-paths
                      module
                      MacroFollowupGeneratedImport)))]
              [(ResultCompilerLoadWithPaths.Err diag)
                (ResultMacroMaterializeImport.Err diag)])]
          [(ResultPkgResolve.Err message)
            (ResultMacroMaterializeImport.Err
              (box (macro-materialize-import-diagnostic decl-path span message)))]))]))

(define (macro-materialize-generated-imports-in
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [stdlib-roots : vector.StringVec]
  [cfgs : SymI64Env]
  [pools : AstNodePoolContext]) : ResultMacroMaterializeImport
  (let
    [seen : SymI64Env (macro-materialize-seen-from decls paths (sym-i64-empty))]
    [cur-decls : AstDeclList decls]
    [cur-paths : AstDeclPathList paths]
    [cur-module : String ""]
    [cur-index : i64 0]
    [out-rev : AstDeclList AstDeclNil]
    [out-paths-rev : AstDeclPathList AstDeclPathNil]
    [work-rev : MacroFollowupWorkList MacroFollowupWorkNil]
    [result : ResultMacroMaterializeImport
      (ResultMacroMaterializeImport.Err
        (box
          (tc-diag-at-start "macro: internal generated import materialization")))]
    [done : bool false]
    (begin
      (while (not done)
        (match cur-decls
          [(AstDeclNil)
            (begin
              (set!
                result
                (ResultMacroMaterializeImport.Ok
                  (macro-decl-list-reverse out-rev)
                  (macro-decl-path-list-reverse out-paths-rev)
                  seen
                  (macro-followup-work-list-reverse work-rev)))
              (set! done true))]
          [(AstDeclCons decl rest-box)
            (let
              [rest : AstDeclList (box-get rest-box)]
              [decl-path : String
                (match cur-paths
                  [(AstDeclPathCons path _) path]
                  [(AstDeclPathNil) ""])]
              [rest-paths : AstDeclPathList
                (match cur-paths
                  [(AstDeclPathCons _ path-rest)
                    (let
                      [path-rest : AstDeclPathList (box-get path-rest)]
                      path-rest)]
                  [(AstDeclPathNil) AstDeclPathNil])]
              (match decl
                [(AstDeclModule next-module)
                  (begin
                    (set! out-rev (ast-decl-cons decl out-rev))
                    (set!
                      out-paths-rev
                      (ast-decl-path-cons decl-path out-paths-rev))
                    (set! cur-module (intern-str next-module))
                    (set! cur-decls rest)
                    (set! cur-paths rest-paths)
                    (set! cur-index (+ cur-index 1)))]
                [_
                  (match (macro-materialize-generated-import
                    decl
                    decl-path
                    cur-module
                    cur-index
                    seen
                    stdlib-roots
                    cfgs
                    pools)
                    [(ResultMacroMaterializeImport.Ok
                        materialized-decls
                        materialized-paths
                        next-seen
                        materialized-work)
                      (begin
                        (set!
                          out-rev
                          (macro-decl-list-reverse-into
                            materialized-decls
                            out-rev))
                        (set!
                          out-paths-rev
                          (macro-decl-path-list-reverse-into
                            materialized-paths
                            out-paths-rev))
                        (set! seen next-seen)
                        (set!
                          work-rev
                          (macro-followup-work-list-reverse-into
                            materialized-work
                            work-rev))
                        (set!
                          cur-module
                          (macro-decls-final-module
                            materialized-decls
                            cur-module))
                        (set! cur-decls rest)
                        (set! cur-paths rest-paths)
                        (set!
                          cur-index
                          (+ cur-index (ast-decl-list-count materialized-decls))))]
                    [(ResultMacroMaterializeImport.Err diag)
                      (begin
                        (set! result (ResultMacroMaterializeImport.Err diag))
                        (set! done true))])]))]))
      result)))

(define (macro-materialize-generated-imports
  [program : AstProgram]
  [paths : AstDeclPathList]
  [stdlib-roots : vector.StringVec]
  [cfgs : SymI64Env]
  [pools : AstNodePoolContext]) : ResultMacroMaterializeImport
  (match program
    [(AstProgram decls-box)
      (macro-materialize-generated-imports-in
        (box-get decls-box)
        paths
        stdlib-roots
        cfgs
        pools)]))

(define (macro-expand-program-with-paths-loop-and-pools
  [program : AstProgram]
  [paths : AstDeclPathList]
  [pools : AstNodePoolContext]
  [stdlib-roots : vector.StringVec]
  [cfgs : SymI64Env]
  [fuel : i64]) : ResultMacroExpand
  (if (< fuel 0)
    (ResultMacroExpand.Err
      (box
        (tc-diag-at-start
          "typecheck: module macro expansion exceeded fixed-point limit")))
    (begin
      (cfg compile-profile (compiler-tc-macro-profile-note-fixed-point-pass))
      (match (macro-expand-program-pass-with-paths-and-pools-with-followup
        program
        paths
        pools)
        [(ResultMacroExpandPass.Ok expanded expanded-paths pass-followup-work)
          (match (macro-materialize-generated-imports
            expanded
            expanded-paths
            stdlib-roots
            cfgs
            pools)
            [(ResultMacroMaterializeImport.Ok
                materialized-decls
                materialized-paths
                _
                materialized-followup-work)
              (let
                [materialized : AstProgram (ast-program materialized-decls)]
                [normalized-result : ResultGenProgramWithPaths
                  (if (compiler-specialize-needed? materialized)
                    (gen-normalize-program-with-paths-and-pools
                      materialized
                      materialized-paths
                      (tc-decl-path-list-last materialized-paths "")
                      pools)
                    (OkGenProgramWithPaths materialized materialized-paths))]
                (match normalized-result
                  [(OkGenProgramWithPaths normalized normalized-paths)
                    (match normalized
                      [(AstProgram decls-box)
                        (let
                          [decls : AstDeclList (box-get decls-box)]
                          [module-placeholder-work : MacroFollowupWorkList
                            (macro-module-placeholder-followup-work-list
                              decls
                              normalized-paths)]
                          [has-pass-followup : bool
                            (not
                              (macro-followup-work-list-empty?
                                pass-followup-work))]
                          [has-materialized-followup : bool
                            (not
                              (macro-followup-work-list-empty?
                                materialized-followup-work))]
                          [has-module-placeholder-followup : bool
                            (not
                              (macro-followup-work-list-empty?
                                module-placeholder-work))]
                          (if (or
                            has-pass-followup
                            has-materialized-followup
                            has-module-placeholder-followup)
                            (begin
                              (if has-pass-followup
                                (cfg
                                  compile-profile
                                  (compiler-tc-macro-profile-note-followup-needs-followup))
                                unit)
                              (if has-materialized-followup
                                (cfg
                                  compile-profile
                                  (compiler-tc-macro-profile-note-followup-generated-imports))
                                unit)
                              (if has-module-placeholder-followup
                                (cfg
                                  compile-profile
                                  (compiler-tc-macro-profile-note-followup-module-placeholders))
                                unit)
                              (macro-expand-program-with-paths-loop-and-pools
                                normalized
                                normalized-paths
                                pools
                                stdlib-roots
                                cfgs
                                (- fuel 1)))
                            (ResultMacroExpand.Ok normalized normalized-paths)))])]
                  [(ErrGenProgramWithPaths diag) (ResultMacroExpand.Err diag)]))]
            [(ResultMacroMaterializeImport.Err diag)
              (ResultMacroExpand.Err diag)])]
        [(ResultMacroExpandPass.Err diag) (ResultMacroExpand.Err diag)]))))

(define (macro-expand-program-with-paths-loop
  [program : AstProgram]
  [paths : AstDeclPathList]
  [fuel : i64]) : ResultMacroExpand
  (begin
    (cfg compile-profile (compiler-tc-macro-profile-reset-loop-counters))
    (macro-expand-program-with-paths-loop-and-pools
      program
      paths
      (ast-node-pool-context-capture-active)
      (vector.string-vec-new)
      (compiler-cfg-empty)
      fuel)))

(define (macro-expand-program-with-paths-and-pools-roots-cfg
  [program : AstProgram]
  [paths : AstDeclPathList]
  [pools : AstNodePoolContext]
  [stdlib-roots : vector.StringVec]
  [cfgs : SymI64Env]) : ResultMacroExpand
  (begin
    (cfg compile-profile (compiler-tc-macro-profile-reset-loop-counters))
    (macro-expand-program-with-paths-loop-and-pools
      program
      paths
      pools
      stdlib-roots
      cfgs
      (macro-expand-fixed-point-limit-for-program program))))

(define (macro-expand-program-with-paths-and-pools
  [program : AstProgram]
  [paths : AstDeclPathList]
  [pools : AstNodePoolContext]) : ResultMacroExpand
  (macro-expand-program-with-paths-and-pools-roots-cfg
    program
    paths
    pools
    (vector.string-vec-new)
    (compiler-cfg-empty)))

(define (macro-expand-program-with-paths
  [program : AstProgram]
  [paths : AstDeclPathList]) : ResultMacroExpand
  (macro-expand-program-with-paths-and-pools
    program
    paths
    (ast-node-pool-context-capture-active)))

(define (macro-expand-program [program : AstProgram]) : ResultMacroExpand
  (macro-expand-program-with-paths program AstDeclPathNil))

(define (tc-cleanup-owning-struct-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstTyStruct struct-name)
      (match (tc-struct-decl ctx (intern-str struct-name))
        [(OkTcStructDecl decl)
          (match decl
            [(TcStructDecl _ cleanup _) (ast-struct-cleanup? cleanup)])]
        [(ErrTcStructDecl _) false])]
    [(AstTyStructArgs struct-name _)
      (match (tc-struct-decl ctx (intern-str struct-name))
        [(OkTcStructDecl decl)
          (match decl
            [(TcStructDecl _ cleanup _) (ast-struct-cleanup? cleanup)])]
        [(ErrTcStructDecl _) false])]
    [_ false]))

(define (tc-cleanup-owning-enum-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstTyEnum enum-name)
      (match (tc-enum-decl ctx (intern-str enum-name))
        [(OkTcEnumDecl decl)
          (match decl
            [(TcEnumDecl cleanup _) (ast-enum-cleanup? cleanup)])]
        [(ErrTcEnumDecl _) false])]
    [(AstTyEnumArgs enum-name _)
      (match (tc-enum-decl ctx (intern-str enum-name))
        [(OkTcEnumDecl decl)
          (match decl
            [(TcEnumDecl cleanup _) (ast-enum-cleanup? cleanup)])]
        [(ErrTcEnumDecl _) false])]
    [_ false]))

(define (tc-cleanup-owning-aggregate-type? [ctx : TcContext] [ty : AstType]) : bool
  (or
    (tc-cleanup-owning-struct-type? ctx ty)
    (tc-cleanup-owning-enum-type? ctx ty)))

(define (tc-struct-field-cleanup-outside-message
  [struct-name : String]
  [field-name : String]) : String
  (str_cat.str-cat
    "typecheck: struct "
    struct-name
    " field "
    field-name
    " has cleanup metadata but struct is not cleanup-owning"))

(define (tc-struct-field-cleanup-owning-without-owned-message
  [struct-name : String]
  [field-name : String]
  [ty : AstType]) : String
  (str_cat.str-cat
    "typecheck: struct "
    struct-name
    " field "
    field-name
    " stores cleanup-owning type "
    (tc-type-render ty)
    " without :owned"))

(define (tc-struct-field-owned-non-cleanup-message
  [struct-name : String]
  [field-name : String]
  [ty : AstType]) : String
  (str_cat.str-cat
    "typecheck: struct "
    struct-name
    " field "
    field-name
    " uses :owned but type "
    (tc-type-render ty)
    " is not cleanup-owning"))

(define (tc-struct-field-cleanup-fn-mismatch-message
  [struct-name : String]
  [field-name : String]
  [cleanup-name : String]) : String
  (str_cat.str-cat
    "typecheck: struct "
    struct-name
    " field "
    field-name
    " cleanup function "
    cleanup-name
    " type mismatch"))

(define (tc-cleanup-source-slash-alias-helper-name
  [ctx : TcContext]
  [cleanup-str : String]
  [cleanup-name : i64]) : i64
  (let
    [qualifier : String (tc-qualified-name-module cleanup-str)]
    [base : String (tc-qualified-name-base cleanup-str)]
    (match (tc-context-program ctx)
      [(AstProgram decls-box)
        (match (macro-import-alias-target-cached
          (box-get decls-box)
          (intern (tc-context-module ctx))
          qualifier)
          [(TcSomeString target-module)
            (intern (compiler-symbol-module-key target-module base))]
          [(TcNoString) cleanup-name])])))

(define (tc-cleanup-field-helper-name
  [ctx : TcContext]
  [owner-name : String]
  [cleanup-name : i64]) : i64
  (let
    [cleanup-str : String (intern-str cleanup-name)]
    (if (tc-source-slash-qualified-id? cleanup-str cleanup-name)
      (tc-cleanup-source-slash-alias-helper-name ctx cleanup-str cleanup-name)
      (intern
        (if (tc-name-qualified? cleanup-str)
          cleanup-str
          (compiler-symbol-module-key
            (tc-qualified-name-module owner-name)
            cleanup-str))))))

(define (tc-check-struct-field-cleanup-fn
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [field-name : String]
  [cleanup-name : i64]
  [field-ty : AstType]) : ResultTcUnit
  (let
    [lookup-name : i64
      (tc-cleanup-field-helper-name ctx struct-name cleanup-name)]
    (match (tc-lookup-visible-id ctx env lookup-name)
      [(OkTcType cleanup-ty)
        (tc-expect
          cleanup-ty
          (tc-fn1 (tc-type-without-regions field-ty) (AstTyUnit))
          (tc-struct-field-cleanup-fn-mismatch-message
            struct-name
            field-name
            (intern-str cleanup-name)))]
      [(ErrTcType message) (ErrTcUnit message)])))

(define (tc-check-cleanup-struct-field
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [struct-cleanup : AstStructCleanup]
  [field : AstFieldDef]) : ResultTcUnit
  (match field
    [(AstFieldDef field-name ty field-cleanup)
      (let
        [field-name-str : String (intern-str field-name)]
        [resolved-ty : AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
        [field-cleanup-owning : bool
          (tc-cleanup-owning-aggregate-type? ctx resolved-ty)]
        (if (not (ast-struct-cleanup? struct-cleanup))
          (if (ast-field-cleanup? field-cleanup)
            (ErrTcUnit
              (tc-struct-field-cleanup-outside-message
                struct-name
                field-name-str))
            (if field-cleanup-owning
              (ErrTcUnit
                (tc-struct-field-cleanup-owning-without-owned-message
                  struct-name
                  field-name-str
                  resolved-ty))
              OkTcUnit))
          (match field-cleanup
            [(AstFieldOwnedCleanup)
              (if field-cleanup-owning
                OkTcUnit
                (ErrTcUnit
                  (tc-struct-field-owned-non-cleanup-message
                    struct-name
                    field-name-str
                    resolved-ty)))]
            [(AstFieldCleanupFn cleanup-name)
              (if field-cleanup-owning
                (ErrTcUnit
                  (tc-struct-field-cleanup-owning-without-owned-message
                    struct-name
                    field-name-str
                    resolved-ty))
                (tc-check-struct-field-cleanup-fn
                  ctx
                  env
                  struct-name
                  field-name-str
                  cleanup-name
                  resolved-ty))]
            [(AstFieldNoCleanup)
              (if field-cleanup-owning
                (ErrTcUnit
                  (tc-struct-field-cleanup-owning-without-owned-message
                    struct-name
                    field-name-str
                    resolved-ty))
                OkTcUnit)])))]))

(define (tc-check-cleanup-struct-fields
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [cleanup : AstStructCleanup]
  [fields : AstFieldDefList]) : ResultTcUnit
  (match fields
    [(AstFieldDefNil) OkTcUnit]
    [(AstFieldDefCons field rest)
      (let
        [rest : AstFieldDefList (box-get rest)]
        (match (tc-check-cleanup-struct-field ctx env struct-name cleanup field)
          [(OkTcUnit)
            (tc-check-cleanup-struct-fields ctx env struct-name cleanup rest)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]))

(define (tc-check-cleanup-struct-decl
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [repr : AstStructRepr]
  [cleanup : AstStructCleanup]
  [fields : AstFieldDefList]) : ResultTcUnit
  (let
    [struct-name : String name]
    (if (and (ast-struct-repr-c? repr) (ast-struct-cleanup? cleanup))
      (ErrTcUnit (tc-struct-cleanup-repr-c-message struct-name))
      (tc-check-cleanup-struct-fields ctx env struct-name cleanup fields))))

(define (tc-enum-cleanup-fn-mismatch-message
  [enum-name : String]
  [cleanup-name : String]) : String
  (str_cat.str-cat
    "typecheck: enum "
    enum-name
    " cleanup function "
    cleanup-name
    " type mismatch"))

(define (tc-enum-payload-cleanup-outside-message
  [enum-name : String]
  [variant-name : String]) : String
  (str_cat.str-cat
    "typecheck: enum "
    enum-name
    " variant "
    variant-name
    " has payload cleanup metadata but enum is not cleanup-owning"))

(define (tc-enum-payload-cleanup-owning-without-owned-message
  [enum-name : String]
  [variant-name : String]
  [ty : AstType]) : String
  (str_cat.str-cat
    "typecheck: enum "
    enum-name
    " variant "
    variant-name
    " stores cleanup-owning type "
    (tc-type-render ty)
    " without :owned"))

(define (tc-enum-payload-owned-non-cleanup-message
  [enum-name : String]
  [variant-name : String]
  [ty : AstType]) : String
  (str_cat.str-cat
    "typecheck: enum "
    enum-name
    " variant "
    variant-name
    " uses :owned but type "
    (tc-type-render ty)
    " is not cleanup-owning"))

(define (tc-enum-payload-cleanup-fn-mismatch-message
  [enum-name : String]
  [variant-name : String]
  [cleanup-name : String]) : String
  (str_cat.str-cat
    "typecheck: enum "
    enum-name
    " variant "
    variant-name
    " cleanup function "
    cleanup-name
    " type mismatch"))

(define (tc-check-enum-cleanup-fn
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [cleanup : AstEnumCleanup]
  [enum-ty : AstType]) : ResultTcUnit
  (match cleanup
    [(AstEnumNoCleanup) OkTcUnit]
    [(AstEnumCleanupFn cleanup-name)
      (match (tc-lookup-visible-id ctx env cleanup-name)
        [(OkTcType cleanup-ty)
          (tc-expect
            cleanup-ty
            (tc-fn1 (tc-type-without-regions enum-ty) (AstTyUnit))
            (tc-enum-cleanup-fn-mismatch-message
              enum-name
              (intern-str cleanup-name)))]
        [(ErrTcType message) (ErrTcUnit message)])]))

(define (tc-check-enum-payload-cleanup-fn
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [variant-name : String]
  [cleanup-name : i64]
  [payload-ty : AstType]) : ResultTcUnit
  (let
    [lookup-name : i64
      (tc-cleanup-field-helper-name ctx enum-name cleanup-name)]
    (match (tc-lookup-visible-id ctx env lookup-name)
      [(OkTcType cleanup-ty)
        (tc-expect
          cleanup-ty
          (tc-fn1 (tc-type-without-regions payload-ty) (AstTyUnit))
          (tc-enum-payload-cleanup-fn-mismatch-message
            enum-name
            variant-name
            (intern-str cleanup-name)))]
      [(ErrTcType message) (ErrTcUnit message)])))

(define (tc-check-cleanup-enum-payloads
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [variant-name : String]
  [enum-cleanup : AstEnumCleanup]
  [payloads : AstTypeList]
  [payload-cleanups : AstVariantPayloadCleanupList]) : ResultTcUnit
  (match payloads
    [(AstTypeNil)
      (match payload-cleanups
        [(AstVariantPayloadCleanupNil) OkTcUnit]
        [_ (ErrTcUnit "typecheck: malformed enum payload cleanup metadata")])]
    [(AstTypeCons payload-box rest-payloads-box)
      (match payload-cleanups
        [(AstVariantPayloadCleanupCons payload-cleanup rest-cleanups-box)
          (let
            [payload-ty : AstType (ty-node-get payload-box)]
            [resolved-ty : AstType
              (tc-type-strip-region (tc-resolve-type ctx payload-ty))]
            [rest-payloads : AstTypeList (box-get rest-payloads-box)]
            [rest-cleanups : AstVariantPayloadCleanupList
              (box-get rest-cleanups-box)]
            [payload-cleanup-owning : bool
              (tc-cleanup-owning-aggregate-type? ctx resolved-ty)]
            [step : ResultTcUnit
              (if (not (ast-enum-cleanup? enum-cleanup))
                (if (ast-variant-payload-cleanup? payload-cleanup)
                  (ErrTcUnit
                    (tc-enum-payload-cleanup-outside-message
                      enum-name
                      variant-name))
                  (if payload-cleanup-owning
                    (ErrTcUnit
                      (tc-enum-payload-cleanup-owning-without-owned-message
                        enum-name
                        variant-name
                        resolved-ty))
                    OkTcUnit))
                (match payload-cleanup
                  [(AstVariantPayloadOwnedCleanup)
                    (if payload-cleanup-owning
                      OkTcUnit
                      (ErrTcUnit
                        (tc-enum-payload-owned-non-cleanup-message
                          enum-name
                          variant-name
                          resolved-ty)))]
                  [(AstVariantPayloadCleanupFn cleanup-name)
                    (if payload-cleanup-owning
                      (ErrTcUnit
                        (tc-enum-payload-cleanup-owning-without-owned-message
                          enum-name
                          variant-name
                          resolved-ty))
                      (tc-check-enum-payload-cleanup-fn
                        ctx
                        env
                        enum-name
                        variant-name
                        cleanup-name
                        resolved-ty))]
                  [(AstVariantPayloadNoCleanup)
                    (if payload-cleanup-owning
                      (ErrTcUnit
                        (tc-enum-payload-cleanup-owning-without-owned-message
                          enum-name
                          variant-name
                          resolved-ty))
                      OkTcUnit)]))]
            (match step
              [(OkTcUnit)
                (tc-check-cleanup-enum-payloads
                  ctx
                  env
                  enum-name
                  variant-name
                  enum-cleanup
                  rest-payloads
                  rest-cleanups)]
              [(ErrTcUnit message) (ErrTcUnit message)]))]
        [_ (ErrTcUnit "typecheck: malformed enum payload cleanup metadata")])]))

(define (tc-check-cleanup-enum-variant
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [cleanup : AstEnumCleanup]
  [variant : AstVariantDef]) : ResultTcUnit
  (match variant
    [(AstVariantDef variant-name payloads payload-cleanups)
      (tc-check-cleanup-enum-payloads
        ctx
        env
        enum-name
        (intern-str variant-name)
        cleanup
        payloads
        payload-cleanups)]))

(define (tc-check-cleanup-enum-variants
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [cleanup : AstEnumCleanup]
  [variants : AstVariantDefList]) : ResultTcUnit
  (match variants
    [(AstVariantDefNil) OkTcUnit]
    [(AstVariantDefCons variant rest)
      (let
        [rest : AstVariantDefList (box-get rest)]
        (match (tc-check-cleanup-enum-variant ctx env enum-name cleanup variant)
          [(OkTcUnit)
            (tc-check-cleanup-enum-variants ctx env enum-name cleanup rest)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]))

(define (tc-check-cleanup-enum-decl
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [lifetimes : AstLifetimeList]
  [cleanup : AstEnumCleanup]
  [variants : AstVariantDefList]) : ResultTcUnit
  (let
    [enum-name : String name]
    [enum-ty : AstType
      (match lifetimes
        [(AstLifetimeNil) (AstTyEnum (intern enum-name))]
        [_ (ast-ty-enum-args (intern enum-name) lifetimes)])]
    (match (tc-check-enum-cleanup-fn ctx env enum-name cleanup enum-ty)
      [(OkTcUnit)
        (tc-check-cleanup-enum-variants ctx env enum-name cleanup variants)]
      [(ErrTcUnit message) (ErrTcUnit message)])))

;: Check one function declaration's body against its signature.
(define (tc-check-fn-decl-body
  [ctx : TcContext]
  [global-env : TcTypeEnv]
  [params : AstParamList]
  [ret : AstType]
  [body-box : i64]) : ResultTcUnit
  (let
    [body : AstExpr (ast-node-get body-box)]
    [env : TcTypeEnv
      (tc-bind-return-type
        (tc-bind-params ctx global-env params)
        (tc-resolve-type ctx ret))]
    (match (tc-expr-with-expected-or-actual-id
      ctx
      env
      body-box
      (tc-resolve-type ctx ret))
      [(OkTcType got)
        (match (tc-expect
          got
          (tc-resolve-type ctx ret)
          "typecheck: return type mismatch")
          [(OkTcUnit)
            (match (tc-ensure-region-value-can-flow-into
              env
              (tc-resolve-type ctx ret)
              got
              "return value")
              [(OkTcUnit)
                (match (tc-move-check-body-id ctx env params body-box)
                  [(OkTcUnit) (tc-borrow-check-body-id ctx env params body-box)]
                  [(ErrTcUnit message) (ErrTcUnit message)])]
              [(ErrTcUnit message)
                (ErrTcUnit
                  (tc-rich-escape-at-expr
                    body
                    message
                    "function return type rejects this escaping value"))])]
          [(ErrTcUnit message) (ErrTcUnit message)])]
      [(ErrTcType message) (ErrTcUnit message)])))

;; Reusable scratch arena for per-function-body typechecks. Mirrors
;; lower-scratch-arena: created lazily, shared by every check (the body walk
;; is never re-entrant into another function-decl check), reclaimed by
;; mark/rewind per check.
(define tc-fn-scratch-arena : i64
  0)

(define (tc-fn-scratch-arena-get) : i64
  (if (= tc-fn-scratch-arena 0)
    (let
      [scratch : i64 (arena.tl_arena_make)]
      (begin
        (set! tc-fn-scratch-arena scratch)
        scratch))
    tc-fn-scratch-arena))

(define (tc-fn-scratch-arena-release!) : unit
  (if (= tc-fn-scratch-arena 0)
    unit
    (begin
      (if (= (arena.tl_arena_current) tc-fn-scratch-arena)
        (unsafe
          (arena.tl_arena_set node-pool-base-arena))
        unit)
      (unsafe
        (arena.tl_arena_destroy tc-fn-scratch-arena))
      (set! tc-fn-scratch-arena 0))))

;; Function bodies dominate typecheck allocation (~96% of the phase's live
;; delta; #2596) and the check returns only unit -- everything it allocates
;; is garbage once the body is checked, but the program-lifetime arena never
;; frees it. Run each body check in the shared scratch arena and rewind it
;; afterwards, cloning the error diagnostic out first (the mark/rewind/
;; clone-out shape of lower-function-escaping; do NOT re-run the check to
;; regenerate the message -- the body check is not idempotent and a second
;; run can surface a different diagnostic). New intern entries made while
;; the scratch is active must outlive it, so persistent intern storage is
;; forced on for the scope (the intern pool copies new strings into its
;; global-init base arena; see compiler_intern). Synthetic marker names use
;; tc-marker-name-id, which routes them to file-state storage instead.
;; Node pools already grow in the persistent base arena (#2357).
(define (tc-check-fn-decl-scoped
  [ctx : TcContext]
  [global-env : TcTypeEnv]
  [params : AstParamList]
  [ret : AstType]
  [body-box : i64]) : ResultTcUnit
  (let
    [prev-persist : bool (intern-persistent-storage-on?)]
    [enclosing : i64 (arena.tl_arena_current)]
    [scratch : i64 (tc-fn-scratch-arena-get)]
    (begin
      (intern-persistent-storage-enable!)
      (unsafe
        (arena.tl_arena_set scratch))
      (let
        [mark : i64 (arena.tl_region_mark)]
        [raw : ResultTcUnit
          (tc-check-fn-decl-body ctx global-env params ret body-box)]
        [scratch-head : i64 (arena.tl_arena_current)]
        (begin
          (unsafe
            (arena.tl_arena_set enclosing))
          (let
            [escaped : ResultTcUnit
              (match raw
                [(OkTcUnit) OkTcUnit]
                [(ErrTcUnit message) (ErrTcUnit (clone message))])]
            [new-enclosing : i64 (arena.tl_arena_current)]
            (begin
              (unsafe
                (arena.tl_arena_set scratch-head)
                (arena.tl_region_reset mark)
                (arena.tl_arena_set new-enclosing))
              (if prev-persist
                unit
                (intern-persistent-storage-disable!))
              ;; Single-entry name caches may hold strings allocated in the
              ;; scratch that was just rewound; invalidate them before
              ;; anything can compare against freed memory.
              (tc-nominal-owner-cache-reset!)
              escaped)))))))

(define (tc-check-decl-with-global-env
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [global-env : TcTypeEnv]
  [decl : AstDecl]) : ResultTcUnit
  (begin
    ;; Type-name and owner caches are keyed by text/handle only. Helper passes
    ;; may typecheck with short-lived symbol tables before the final declaration
    ;; walk, so keep cache entries scoped to one checked declaration.
    (tc-nominal-owner-cache-reset!)
    (match decl
      [(AstDeclDef _ maybe-ty expr-box)
        (match maybe-ty
          [(AstSomeType want)
            (match (tc-expr-with-expected-or-actual-id
              ctx
              global-env
              expr-box
              (tc-resolve-type ctx want))
              [(OkTcType got)
                (match (tc-expect
                  got
                  (tc-resolve-type ctx want)
                  "typecheck: value definition type mismatch")
                  [(OkTcUnit)
                    (tc-ensure-region-value-can-flow-into
                      global-env
                      (tc-resolve-type ctx want)
                      got
                      "top-level value")]
                  [(ErrTcUnit message) (ErrTcUnit message)])]
              [(ErrTcType message) (ErrTcUnit message)])]
          [(AstNoType)
            (match (tc-expr-id ctx global-env expr-box)
              [(OkTcType _) OkTcUnit]
              [(ErrTcType message) (ErrTcUnit message)])])]
      [(AstDeclDefFn _ params ret body-box _)
        (tc-check-fn-decl-scoped ctx global-env params ret body-box)]
      [(AstDeclDefMacro name params ret body-box)
        (let
          [body : AstExpr (ast-node-get body-box)]
          (tc-check-defmacro name ctx top-env params ret body))]
      [(AstDeclExtern _ kind metadata ty)
        (tc-check-extern-decl ctx kind metadata ty)]
      [(AstDeclDefDispatch name variants)
        (match (tc-dispatch-decl-type ctx (intern-str name) variants)
          [(OkTcType _) OkTcUnit]
          [(ErrTcType message) (ErrTcUnit message)])]
      [(AstDeclDefEnum name cleanup variants)
        (tc-check-cleanup-enum-decl
          ctx
          top-env
          (tc-check-decl-scoped-name ctx name)
          AstLifetimeNil
          cleanup
          variants)]
      [(AstDeclDefEnumLifetimes name lifetimes cleanup variants)
        (tc-check-cleanup-enum-decl
          ctx
          top-env
          (tc-check-decl-scoped-name ctx name)
          lifetimes
          cleanup
          variants)]
      [(AstDeclDefStruct name repr cleanup fields)
        (tc-check-cleanup-struct-decl
          ctx
          top-env
          (tc-check-decl-scoped-name ctx name)
          repr
          cleanup
          fields)]
      [(AstDeclDefStructLifetimes name _ repr cleanup fields)
        (tc-check-cleanup-struct-decl
          ctx
          top-env
          (tc-check-decl-scoped-name ctx name)
          repr
          cleanup
          fields)]
      [(AstDeclComptimeDecl _ template-box)
        (let
          [template : AstDecl (box-get template-box)]
          (match (tc-check-comptime-decl-purity ctx top-env template)
            [(OkTcUnit)
              (tc-check-decl-with-global-env ctx top-env global-env template)]
            [(ErrTcUnit message) (ErrTcUnit message)]))]
      [(AstDeclUnsafe inner-box)
        (let
          [inner : AstDecl (box-get inner-box)]
          (tc-check-decl-with-global-env ctx top-env global-env inner))]
      [_ OkTcUnit])))

(define (tc-check-decl [ctx : TcContext] [top-env : TcTypeEnv] [decl : AstDecl]) : ResultTcUnit
  (tc-check-decl-with-global-env
    ctx
    top-env
    (tc-hygiene-global-env top-env)
    decl))

(define (tc-check-decl-scoped-name [ctx : TcContext] [name : i64]) : String
  (let
    [text : String (intern-str name)]
    [module : String (tc-context-module ctx)]
    (if (and
      (> (string.string-length module) 0)
      (not (tc-name-qualified? text)))
      (compiler-symbol-module-key module text)
      text)))

(define (tc-check-decls
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [summary : CompilerTypecheckSummary]) : ResultCompilerTypecheck
  (tc-check-decls-in-module ctx top-env decls summary ""))

(define (tc-check-decls-in-module
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [summary : CompilerTypecheckSummary]
  [module : String]) : ResultCompilerTypecheck
  (match decls
    [(AstDeclNil) (OkCompilerTypecheck summary)]
    [(AstDeclCons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDeclModule next-module)
            (tc-check-decls-in-module
              ctx
              top-env
              rest
              summary
              (intern-str next-module))]
          [_
            (match (tc-module-local-env ctx top-env module)
              [(OkTcEnv local-env)
                (let
                  [decl-ctx : TcContext (tc-context-with-module ctx module)]
                  (match (tc-check-decl decl-ctx local-env decl)
                    [(OkTcUnit)
                      (tc-check-decls-in-module
                        ctx
                        top-env
                        rest
                        (tc-summary-add-decl summary decl)
                        module)]
                    [(ErrTcUnit message)
                      (ErrCompilerTypecheck (box (tc-decl-diag decl message)))]))]
              [(ErrTcEnv message)
                (ErrCompilerTypecheck (box (tc-decl-diag decl message)))])]))]))

(define (tc-decl-path-list-last [paths : AstDeclPathList] [last : String]) : String
  (match paths
    [(AstDeclPathNil) last]
    [(AstDeclPathCons path rest)
      (let
        [rest : AstDeclPathList (box-get rest)]
        (tc-decl-path-list-last rest path))]))

(define (tc-prefix-decl-key [decl : AstDecl]) : String
  (match decl
    [(AstDeclModule name) (str_cat.str-cat "module:" (intern-str name))]
    [(AstDeclDef name _ _) (str_cat.str-cat "def:" (intern-str name))]
    [(AstDeclDefFn name _ _ _ _) (str_cat.str-cat "fn:" (intern-str name))]
    [(AstDeclDefMacro name _ _ _) (str_cat.str-cat "macro:" (intern-str name))]
    [(AstDeclExtern name _ _ _) (str_cat.str-cat "extern:" (intern-str name))]
    [(AstDeclDefEnum name _ _) (str_cat.str-cat "enum:" (intern-str name))]
    [(AstDeclDefEnumLifetimes name _ _ _)
      (str_cat.str-cat "enum-lifetimes:" (intern-str name))]
    [(AstDeclDefStruct name _ _ _)
      (str_cat.str-cat "struct:" (intern-str name))]
    [(AstDeclDefStructLifetimes name _ _ _ _)
      (str_cat.str-cat "struct-lifetimes:" (intern-str name))]
    [(AstDeclImport _) "import"]
    [(AstDeclIncludeStr name _) (str_cat.str-cat "include-str:" name)]
    [(AstDeclIncludeBin name _) (str_cat.str-cat "include-bin:" name)]
    [(AstDeclDefDispatch name _)
      (str_cat.str-cat "dispatch:" (intern-str name))]
    [(AstDeclTest name _ _) (str_cat.str-cat "test:" (intern-str name))]
    [(AstDeclUnsafe inner)
      (str_cat.str-cat "unsafe:" (tc-prefix-decl-key (box-get inner)))]
    [(AstDeclComptimeDecl _ inner)
      (str_cat.str-cat "comptime:" (tc-prefix-decl-key (box-get inner)))]))

(define (tc-prefix-key-add [key : String] [decl-path : String] [decl : AstDecl]) : String
  (str_cat.str-cat
    key
    (string.int->string (string.string-length decl-path))
    ":"
    decl-path
    ":"
    (tc-prefix-decl-key decl)
    ";"))

(define (tc-prefix-key-start [scope : String]) : String
  (str_cat.str-cat
    "tc-prefix-v3;"
    (string.int->string (string.string-length scope))
    ":"
    scope
    ";"))

(define (tc-prefix-default-cache-scope) : String
  "direct")

(define (tc-prefix-cache-stdlib-path?
  [path : String]
  [stdlib-roots : vector.StringVec]) : bool
  (if (compiler-load-stdlib-import? path)
    true
    (let
      [normalized : String (compiler-load-normalize-path path)]
      (if (compiler-load-stdlib-import? normalized)
        true
        (compiler-load-path-under-roots-from?
          normalized
          stdlib-roots
          0
          (vector.string-vec-len stdlib-roots))))))

(define (tc-prefix-cache-module-marker? [decl : AstDecl]) : bool
  (match decl
    [(AstDeclModule name) (> (string.string-length (intern-str name)) 0)]
    [_ false]))

(define (tc-prefix-cache-decl-safe?
  [decl-path : String]
  [decl : AstDecl]
  [stdlib-roots : vector.StringVec]
  [same-path-module-safe : bool]) : bool
  (if (tc-prefix-cache-stdlib-path? decl-path stdlib-roots)
    true
    (or same-path-module-safe (tc-prefix-cache-module-marker? decl))))

(define (tc-prefix-candidate-from
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [stdlib-roots : vector.StringVec]
  [entry-path : String]
  [count : i64]
  [module : String]
  [active-path : String]
  [active-path-module-safe : bool]
  [key : String]) : TcPrefixCandidate
  (match decls
    [(AstDeclNil) (TcNoPrefixCandidate)]
    [(AstDeclCons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        [decl-path : String
          (match paths
            [(AstDeclPathCons path _) path]
            [(AstDeclPathNil) ""])]
        [rest-paths : AstDeclPathList
          (match paths
            [(AstDeclPathCons _ path-rest)
              (let
                [path-rest : AstDeclPathList (box-get path-rest)]
                path-rest)]
            [(AstDeclPathNil) AstDeclPathNil])]
        [same-path : bool (string.string-eq active-path decl-path)]
        [same-path-module-safe : bool
          (if same-path
            active-path-module-safe
            false)]
        [decl-module-safe : bool
          (or same-path-module-safe (tc-prefix-cache-module-marker? decl))]
        (cond
          [(string.string-eq decl-path entry-path)
            (if (> count 0)
              (TcSomePrefixCandidate key count module)
              (TcNoPrefixCandidate))]
          [(tc-prefix-cache-decl-safe?
              decl-path
              decl
              stdlib-roots
              same-path-module-safe)
            (let
              [next-module : String
                (match decl
                  [(AstDeclModule next-module) (intern-str next-module)]
                  [_ module])]
              (tc-prefix-candidate-from
                rest
                rest-paths
                stdlib-roots
                entry-path
                (+ count 1)
                next-module
                decl-path
                decl-module-safe
                (tc-prefix-key-add key decl-path decl)))]
          [(> count 0) (TcSomePrefixCandidate key count module)]
          [else (TcNoPrefixCandidate)]))]))

(define (tc-prefix-candidate
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [stdlib-roots : vector.StringVec]
  [cache-scope : String]) : TcPrefixCandidate
  (let
    [entry-path : String (tc-decl-path-list-last paths "")]
    [effective-roots : vector.StringVec
      (compiler-load-roots-with-env stdlib-roots)]
    (if (string.string-eq entry-path "")
      (TcNoPrefixCandidate)
      (tc-prefix-candidate-from
        decls
        paths
        effective-roots
        entry-path
        0
        ""
        ""
        false
        (tc-prefix-key-start cache-scope)))))

(define (tc-decl-list-take [decls : AstDeclList] [count : i64]) : AstDeclList
  (if (<= count 0)
    AstDeclNil
    (match decls
      [(AstDeclNil) AstDeclNil]
      [(AstDeclCons decl rest)
        (let
          [rest : AstDeclList (box-get rest)]
          (AstDeclCons decl (box (tc-decl-list-take rest (- count 1)))))])))

(define (tc-decl-path-list-take [paths : AstDeclPathList] [count : i64]) : AstDeclPathList
  (if (<= count 0)
    AstDeclPathNil
    (match paths
      [(AstDeclPathNil) AstDeclPathNil]
      [(AstDeclPathCons path rest)
        (let
          [rest : AstDeclPathList (box-get rest)]
          (AstDeclPathCons path (box (tc-decl-path-list-take rest (- count 1)))))])))

(define (tc-decl-list-drop [decls : AstDeclList] [count : i64]) : AstDeclList
  (if (<= count 0)
    decls
    (match decls
      [(AstDeclNil) AstDeclNil]
      [(AstDeclCons _ rest)
        (let
          [rest : AstDeclList (box-get rest)]
          (tc-decl-list-drop rest (- count 1)))])))

(define (tc-decl-path-list-drop [paths : AstDeclPathList] [count : i64]) : AstDeclPathList
  (if (<= count 0)
    paths
    (match paths
      [(AstDeclPathNil) AstDeclPathNil]
      [(AstDeclPathCons _ rest)
        (let
          [rest : AstDeclPathList (box-get rest)]
          (tc-decl-path-list-drop rest (- count 1)))])))

(define (tc-check-decls-with-paths-cold
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [summary : CompilerTypecheckSummary]) : ResultCompilerTypecheck
  (begin
    (cfg compile-profile (compiler-tc-decl-profile-reset))
    (tc-check-decls-with-paths-in-module
      ctx
      top-env
      decls
      paths
      summary
      ""
      (TcModuleLocalEnvNil))))

(define (tc-check-decls-with-prefix-hit
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [count : i64]
  [module : String]
  [summary : CompilerTypecheckSummary]) : ResultCompilerTypecheck
  (begin
    (tc-prefix-snapshot-cache-note-hit!)
    (cfg compile-profile (compiler-tc-decl-profile-reset))
    (tc-check-decls-with-paths-in-module
      ctx
      top-env
      (tc-decl-list-drop decls count)
      (tc-decl-path-list-drop paths count)
      summary
      module
      (TcModuleLocalEnvNil))))

(define (tc-check-decls-with-prefix-miss
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [key : String]
  [count : i64]
  [module : String]) : ResultCompilerTypecheck
  (begin
    (tc-prefix-snapshot-cache-note-miss!)
    (cfg compile-profile (compiler-tc-decl-profile-reset))
    (match (tc-check-decls-with-paths-in-module
      ctx
      top-env
      (tc-decl-list-take decls count)
      (tc-decl-path-list-take paths count)
      (CompilerTypecheckSummary 0 0 0)
      ""
      (TcModuleLocalEnvNil))
      [(OkCompilerTypecheck prefix-summary)
        (begin
          (tc-prefix-snapshot-cache-store-persistent
            key
            count
            module
            prefix-summary)
          (cfg compile-profile (compiler-tc-decl-profile-reset))
          (tc-check-decls-with-paths-in-module
            ctx
            top-env
            (tc-decl-list-drop decls count)
            (tc-decl-path-list-drop paths count)
            prefix-summary
            module
            (TcModuleLocalEnvNil)))]
      [(ErrCompilerTypecheck diag) (ErrCompilerTypecheck diag)])))

(define (tc-check-decls-with-paths
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [summary : CompilerTypecheckSummary]
  [stdlib-roots : vector.StringVec]
  [cache-scope : String]) : ResultCompilerTypecheck
  (if (tc-prefix-snapshot-cache-active?)
    (match (tc-prefix-candidate decls paths stdlib-roots cache-scope)
      [(TcSomePrefixCandidate key count module)
        (match (tc-prefix-snapshot-cache-lookup key)
          [(TcPrefixSnapshotHit cached-count cached-module cached-summary)
            (tc-check-decls-with-prefix-hit
              ctx
              top-env
              decls
              paths
              cached-count
              cached-module
              cached-summary)]
          [(TcPrefixSnapshotMiss)
            (tc-check-decls-with-prefix-miss
              ctx
              top-env
              decls
              paths
              key
              count
              module)])]
      [(TcNoPrefixCandidate)
        (tc-check-decls-with-paths-cold ctx top-env decls paths summary)])
    (tc-check-decls-with-paths-cold ctx top-env decls paths summary)))

(define (tc-generated-clone-name? [name : String]) : bool
  (if (>= (string.string-length name) 6)
    (string.string-eq (string.substring name 0 6) "clone$")
    false))

(define (tc-generated-clone-decl-with-path? [decl : AstDecl] [path : String]) : bool
  (if (string.string-eq path "")
    (match decl
      [(AstDeclDefFn name _ _ _ _) (tc-generated-clone-name? (intern-str name))]
      [_ false])
    false))

(define (tc-typecheck-diag-with-path
  [decl : AstDecl]
  [path : String]
  [message : String]) : CompilerDiagnostic
  (let
    [diag : CompilerDiagnostic (tc-decl-diag decl message)]
    (if (string.string-eq path "")
      diag
      (compiler-diagnostic-with-path diag path))))

;; Direct declaration typechecking stays below the self-build memory budget and
;; avoids the per-declaration scratch arena overhead.
(define (tc-check-decl-escaping
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decl : AstDecl]) : ResultTcUnit
  (tc-check-decl ctx top-env decl))

(define (tc-check-one-decl-with-module
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decl : AstDecl]
  [module : String]) : ResultTcUnit
  (match (tc-module-local-env ctx top-env module)
    [(OkTcEnv local-env)
      (let
        [decl-ctx : TcContext (tc-context-with-module ctx module)]
        (tc-check-decl-escaping decl-ctx local-env decl))]
    [(ErrTcEnv message) (ErrTcUnit message)]))

(define (tc-check-decls-with-paths-in-module
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [summary : CompilerTypecheckSummary]
  [module : String]
  [cache : TcModuleLocalEnvCache]) : ResultCompilerTypecheck
  (begin
    (cfg compile-profile (compiler-tc-decl-profile-start-section))
    (match (tc-module-local-env-cached ctx top-env module cache)
      [(OkTcModuleLocalEnv local-env next-cache)
        (begin
          (cfg compile-profile (compiler-tc-decl-profile-add-local-env))
          (tc-check-decls-with-paths-in-module-env
            ctx
            top-env
            decls
            paths
            summary
            module
            next-cache
            local-env
            (tc-hygiene-global-env local-env)))]
      [(ErrTcModuleLocalEnv message)
        (begin
          (cfg compile-profile (compiler-tc-decl-profile-add-local-env))
          (ErrCompilerTypecheck (box (tc-diag-at-start message))))])))

(define (tc-check-decls-with-paths-in-module-env
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [summary : CompilerTypecheckSummary]
  [module : String]
  [cache : TcModuleLocalEnvCache]
  [local-env : TcTypeEnv]
  [global-env : TcTypeEnv]) : ResultCompilerTypecheck
  ;; #2599: this walks every expanded top-level declaration during self-compile.
  ;; Keep it iterative so a large program does not consume one native stack frame
  ;; per declaration on Windows selfhost binaries.
  (let
    [cur-decls : AstDeclList decls]
    [cur-paths : AstDeclPathList paths]
    [cur-summary : CompilerTypecheckSummary summary]
    [cur-module : String module]
    [cur-cache : TcModuleLocalEnvCache cache]
    [cur-local-env : TcTypeEnv local-env]
    [cur-global-env : TcTypeEnv global-env]
    [result : ResultCompilerTypecheck
      (ErrCompilerTypecheck
        (box (tc-diag-at-start "typecheck: internal decls walk")))]
    [done : bool false]
    (begin
      (while (not done)
        (match cur-decls
          [(AstDeclNil)
            (begin
              (cfg compile-profile (compiler-tc-decl-profile-finish))
              (set! result (OkCompilerTypecheck cur-summary))
              (set! done true))]
          [(AstDeclCons decl rest)
            (let
              [rest : AstDeclList (box-get rest)]
              [decl-path : String
                (match cur-paths
                  [(AstDeclPathCons path _) path]
                  [(AstDeclPathNil) ""])]
              [rest-paths : AstDeclPathList
                (match cur-paths
                  [(AstDeclPathCons _ path-rest)
                    (let
                      [path-rest : AstDeclPathList (box-get path-rest)]
                      path-rest)]
                  [(AstDeclPathNil) AstDeclPathNil])]
              (match decl
                [(AstDeclModule next-module)
                  (begin
                    (cfg
                      compile-profile
                      (compiler-tc-decl-profile-start-section))
                    (tc-context-capture-active-pools! ctx)
                    (match (tc-module-local-env-cached
                      ctx
                      top-env
                      (intern-str next-module)
                      cur-cache)
                      [(OkTcModuleLocalEnv next-local-env next-cache)
                        (match (tc-module-local-env-cached
                          ctx
                          top-env
                          (intern-str next-module)
                          cur-cache)
                          [(OkTcModuleLocalEnv next-local-env-copy _)
                            (begin
                              (cfg
                                compile-profile
                                (compiler-tc-decl-profile-add-local-env))
                              (set! cur-decls rest)
                              (set! cur-paths rest-paths)
                              (set! cur-module (intern-str next-module))
                              (set! cur-cache next-cache)
                              (set!
                                cur-global-env
                                (tc-hygiene-global-env next-local-env))
                              (set! cur-local-env next-local-env-copy))]
                          [(ErrTcModuleLocalEnv message)
                            (begin
                              (cfg
                                compile-profile
                                (compiler-tc-decl-profile-add-local-env))
                              (set!
                                result
                                (ErrCompilerTypecheck
                                  (box
                                    (tc-typecheck-diag-with-path
                                      decl
                                      decl-path
                                      message))))
                              (set! done true))])]
                      [(ErrTcModuleLocalEnv message)
                        (begin
                          (cfg
                            compile-profile
                            (compiler-tc-decl-profile-add-local-env))
                          (set!
                            result
                            (ErrCompilerTypecheck
                              (box
                                (tc-typecheck-diag-with-path
                                  decl
                                  decl-path
                                  message))))
                          (set! done true))]))]
                [_
                  (if (tc-generated-clone-decl-with-path? decl decl-path)
                    (begin
                      (set! cur-decls rest)
                      (set! cur-paths rest-paths)
                      (set! cur-summary (tc-summary-add-decl cur-summary decl)))
                    (let
                      [decl-ctx : TcContext
                        (tc-context-with-module ctx cur-module)]
                      [prev-path : String
                        (tc-unused-unsafe-set-current-path! decl-path)]
                      (begin
                        (cfg
                          compile-profile
                          (compiler-tc-decl-profile-start-section))
                        (tc-context-capture-active-pools! decl-ctx)
                        (match (tc-check-decl-with-global-env
                          decl-ctx
                          cur-local-env
                          cur-global-env
                          decl)
                          [(OkTcUnit)
                            (begin
                              (tc-unused-unsafe-restore-current-path! prev-path)
                              (cfg
                                compile-profile
                                (compiler-tc-decl-profile-record decl))
                              (set! cur-decls rest)
                              (set! cur-paths rest-paths)
                              (set!
                                cur-summary
                                (tc-summary-add-decl cur-summary decl)))]
                          [(ErrTcUnit message)
                            (begin
                              (tc-unused-unsafe-restore-current-path! prev-path)
                              (set!
                                result
                                (ErrCompilerTypecheck
                                  (box
                                    (tc-typecheck-diag-with-path
                                      decl
                                      decl-path
                                      message))))
                              (set! done true))]))))]))]))
      result)))

(define (typecheck-compiler-specialized-program-with-paths-checked-inner-with-pools
  [program : AstProgram]
  [paths : AstDeclPathList]
  [stdlib-roots : vector.StringVec]
  [cache-scope : String]
  [pools : AstNodePoolContext]) : ResultCompilerTypecheckChecked
  (begin
    (tc-nominal-owner-cache-reset!)
    (ast-node-pool-context-install! pools)
    (match (build-compiler-symbols-with-paths program paths)
      [(ResultCompilerSymbols.Ok symbols)
        (match (build-compiler-registries-with-symbols program symbols)
          [(ResultCompilerRegistries.Ok registries)
            (let
              [ctx : TcContext (TcContext program symbols registries "" pools)]
              (match (tc-stdlib-comptime-surface-ok ctx)
                [(OkTcUnit)
                  (match (tc-program-source-types-policy-ok ctx program)
                    [(OkTcUnit)
                      (match (tc-build-top-env ctx program)
                        [(OkTcEnv top-env)
                          (match program
                            [(AstProgram decls-box)
                              (let
                                [decls : AstDeclList (box-get decls-box)]
                                (begin
                                  (tc-hygiene-reset-active-top-env! top-env)
                                  (tc-context-capture-active-pools! ctx)
                                  (tc-clone-able-cache-populate! ctx)
                                  (tc-macro-helper-env-cache-reset!)
                                  (match (tc-check-decls-with-paths
                                    ctx
                                    top-env
                                    decls
                                    paths
                                    (CompilerTypecheckSummary 0 0 0)
                                    stdlib-roots
                                    cache-scope)
                                    [(OkCompilerTypecheck summary)
                                      (begin
                                        (tc-context-capture-active-pools! ctx)
                                        (OkCompilerTypecheckChecked
                                          summary
                                          ctx
                                          top-env))]
                                    [(ErrCompilerTypecheck diag)
                                      (ErrCompilerTypecheckChecked diag)])))])]
                        [(ErrTcEnv message)
                          (ErrCompilerTypecheckChecked
                            (box (tc-diag-at-start message)))])]
                    [(ErrTcUnit message)
                      (ErrCompilerTypecheckChecked
                        (box (tc-diag-at-start message)))])]
                [(ErrTcUnit message)
                  (ErrCompilerTypecheckChecked (box (tc-diag-at-start message)))]))]
          [(ResultCompilerRegistries.Err message)
            (ErrCompilerTypecheckChecked (box (tc-diag-at-start message)))])]
      [(ResultCompilerSymbols.Err message)
        (ErrCompilerTypecheckChecked (box (tc-diag-at-start message)))])))

(define (typecheck-compiler-specialized-program-with-paths-checked-inner
  [program : AstProgram]
  [paths : AstDeclPathList]
  [stdlib-roots : vector.StringVec]
  [cache-scope : String]) : ResultCompilerTypecheckChecked
  (typecheck-compiler-specialized-program-with-paths-checked-inner-with-pools
    program
    paths
    stdlib-roots
    cache-scope
    (ast-node-pool-context-capture-active)))

(define (typecheck-compiler-specialized-program-with-paths-checked-cache
  [program : AstProgram]
  [paths : AstDeclPathList]
  [stdlib-roots : vector.StringVec]
  [cache-scope : String]) : ResultCompilerTypecheckChecked
  (tc-typecheck-checked-result-with-pool-check
    (typecheck-compiler-specialized-program-with-paths-checked-inner
      program
      paths
      stdlib-roots
      cache-scope)))

(define (typecheck-compiler-specialized-program-with-paths-checked-cache-with-pools
  [program : AstProgram]
  [paths : AstDeclPathList]
  [stdlib-roots : vector.StringVec]
  [cache-scope : String]
  [pools : AstNodePoolContext]) : ResultCompilerTypecheckChecked
  (tc-typecheck-checked-result-with-pool-check
    (typecheck-compiler-specialized-program-with-paths-checked-inner-with-pools
      program
      paths
      stdlib-roots
      cache-scope
      pools)))

(define (typecheck-compiler-specialized-program-with-paths-checked
  [program : AstProgram]
  [paths : AstDeclPathList]) : ResultCompilerTypecheckChecked
  (typecheck-compiler-specialized-program-with-paths-checked-cache
    program
    paths
    (vector.string-vec-new)
    (tc-prefix-default-cache-scope)))

(define (typecheck-compiler-specialized-program-with-paths-cache
  [program : AstProgram]
  [paths : AstDeclPathList]
  [stdlib-roots : vector.StringVec]
  [cache-scope : String]) : ResultCompilerTypecheck
  (match (typecheck-compiler-specialized-program-with-paths-checked-cache
    program
    paths
    stdlib-roots
    cache-scope)
    [(OkCompilerTypecheckChecked summary _ _) (OkCompilerTypecheck summary)]
    [(ErrCompilerTypecheckChecked diag) (ErrCompilerTypecheck diag)]))

(define (typecheck-compiler-specialized-program-with-paths-cache-with-pools
  [program : AstProgram]
  [paths : AstDeclPathList]
  [stdlib-roots : vector.StringVec]
  [cache-scope : String]
  [pools : AstNodePoolContext]) : ResultCompilerTypecheck
  (match (typecheck-compiler-specialized-program-with-paths-checked-cache-with-pools
    program
    paths
    stdlib-roots
    cache-scope
    pools)
    [(OkCompilerTypecheckChecked summary _ _) (OkCompilerTypecheck summary)]
    [(ErrCompilerTypecheckChecked diag) (ErrCompilerTypecheck diag)]))

(define (typecheck-compiler-specialized-program-with-paths
  [program : AstProgram]
  [paths : AstDeclPathList]) : ResultCompilerTypecheck
  (typecheck-compiler-specialized-program-with-paths-cache
    program
    paths
    (vector.string-vec-new)
    (tc-prefix-default-cache-scope)))

(define (compiler-typecheck-reset-file-state!) : unit
  (begin
    (tc-fn-scratch-arena-release!)
    (tc-clone-able-cache-reset!)
    (tc-macro-helper-env-cache-reset!)
    (tc-spmd-inline-helper-stack-reset!)
    (tc-agg-caches-reset!)
    (tc-nominal-owner-cache-reset!)
    (tc-unqualified-import-ambiguity-reset!)
    (macro-alias-cache-reset!)
    (compiler-load-surface-summaries-reset!)
    (ctfe-build-seen-reset!)
    (set! tc-hygiene-active-top-env-ready false)
    (set! tc-hygiene-active-top-env (tc-empty-type-env))
    (set! tc-hygiene-module-env-cache (tc-empty-module-local-env-cache))
    (if (= tc-hygiene-module-env-cache-arena 0)
      unit
      (begin
        (unsafe
          (arena.tl_arena_destroy tc-hygiene-module-env-cache-arena))
        (set! tc-hygiene-module-env-cache-arena 0)))
    (set! macro-expand-active-module "")
    (set! macro-expand-macro-names (TcStringNil))
    (set! macro-expand-expr-type-macro-names (TcStringNil))
    (set! macro-expand-ctfe-env-ready false)
    (set! macro-expand-ctfe-env-value (ctfe-env-empty))
    (set! tc-lazy-import-summary-macro-force-record-count 0)
    (ctfe-module-macro-export-reset!)
    (set! ctfe-needs-metadata true)))

(define (compiler-typecheck-reset-intern-owned-state!) : unit
  (tc-marker-name-id-arena-reset!))