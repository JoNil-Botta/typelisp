          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-source-expr-policy-ok ctx expr-bases inner))]
    [(ast.AstExpr.BoxSet inner-box value-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases inner value))]
    [(ast.AstExpr.Match match-box)
      (match (__tl-box-place match-box)
        [(ast.AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases scrutinee-box)]
            (match (tc-source-expr-policy-ok ctx expr-bases scrutinee)
              [(ResultTcUnit.Ok)
                (tc-source-match-arm-list-policy-ok ctx expr-bases arms)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(ast.AstExpr.Foreach fe-box)
      (match (__tl-box-place fe-box)
        [(ast.AstForeach.Foreach _ index-ty start-box end-box body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (match (tc-source-type-policy-ok ctx index-ty)
              [(ResultTcUnit.Ok)
                (tc-source-expr-triple-policy-ok ctx expr-bases start end body)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(ast.AstExpr.SpmdReduce reduce-box)
      (match (__tl-box-place reduce-box)
        [(ast.AstSpmdReduce.Reduce
            _
            _
            index-ty
            start-box
            end-box
            init-box
            value-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [value : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases value-box)]
            (match (tc-source-type-policy-ok ctx index-ty)
              [(ResultTcUnit.Ok)
                (match (tc-source-expr-triple-policy-ok
                  ctx
                  expr-bases
                  start
                  end
                  init)
                  [(ResultTcUnit.Ok)
                    (tc-source-expr-policy-ok ctx expr-bases value)]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(ast.AstExpr.SpmdScan scan-box)
      (match (__tl-box-place scan-box)
        [(ast.AstSpmdScan.Scan
            _
            _
            index-ty
            start-box
            end-box
            _
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [value : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases value-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (match (tc-source-type-policy-ok ctx index-ty)
              [(ResultTcUnit.Ok)
                (match (tc-source-type-policy-ok ctx prefix-ty)
                  [(ResultTcUnit.Ok)
                    (match (tc-source-expr-triple-policy-ok
                      ctx
                      expr-bases
                      start
                      end
                      init)
                      [(ResultTcUnit.Ok)
                        (match (tc-source-expr-policy-ok ctx expr-bases value)
                          [(ResultTcUnit.Ok)
                            (tc-source-expr-policy-ok ctx expr-bases body)]
                          [(ResultTcUnit.Err message)
                            (ResultTcUnit.Err message)])]
                      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(ast.AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [lane : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases lane-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases value lane))]
    [(ast.AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [lane : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases lane-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases value lane))]
    [(ast.AstExpr.StructGet receiver-box _)
      (let
        [receiver : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases receiver-box)]
        (tc-source-expr-policy-ok ctx expr-bases receiver))]
    [(ast.AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases receiver-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases receiver value))]
    [(ast.AstExpr.WithRegion _ body)
      (tc-source-expr-list-policy-ok ctx expr-bases body)]
    [(ast.AstExpr.WithEscape scratch-box body)
      (let
        [scratch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases scratch-box)]
        (match (tc-source-expr-policy-ok ctx expr-bases scratch)
          [(ResultTcUnit.Ok)
            (tc-source-expr-list-policy-ok ctx expr-bases body)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(ast.AstExpr.WithScratch body)
      (tc-source-expr-list-policy-ok ctx expr-bases body)]
    [(ast.AstExpr.InArena arena-box body)
      (let
        [arena : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases arena-box)]
        (match (tc-source-expr-policy-ok ctx expr-bases arena)
          [(ResultTcUnit.Ok)
            (tc-source-expr-list-policy-ok ctx expr-bases body)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(ast.AstExpr.WithResource wr-box)
      (match (__tl-box-place wr-box)
        [(ast.AstWithResource.WithResource bindings body)
          (match (tc-source-resource-binding-list-policy-ok
            ctx
            expr-bases
            bindings)
            [(ResultTcUnit.Ok)
              (tc-source-expr-list-policy-ok ctx expr-bases body)]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
    [(ast.AstExpr.Comptime inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-source-expr-policy-ok ctx expr-bases inner))]
    [(ast.AstExpr.Quote _) ResultTcUnit.Ok]
    [(ast.AstExpr.Quasiquote _) ResultTcUnit.Ok]
    [(ast.AstExpr.Unquote inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-source-expr-policy-ok ctx expr-bases inner))]
    [(ast.AstExpr.UnquoteSplicing inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-source-expr-policy-ok ctx expr-bases inner))]
    [(ast.AstExpr.Try inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-source-expr-policy-ok ctx expr-bases inner))]
    [(ast.AstExpr.Return inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-source-expr-policy-ok ctx expr-bases inner))]
    [(ast.AstExpr.PtrNullCheck inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-source-expr-policy-ok ctx expr-bases inner))]
    [(ast.AstExpr.PtrAddrOf place-box)
      (let
        [place : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases place-box)]
        (tc-source-expr-policy-ok ctx expr-bases place))]
    [(ast.AstExpr.PtrRead ptr-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        (tc-source-expr-policy-ok ctx expr-bases ptr))]
    [(ast.AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases ptr value))]
    [(ast.AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [offset : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases offset-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases ptr offset))]
    [(ast.AstExpr.PtrCast ptr-box ty-id)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        (match (tc-source-expr-policy-ok ctx expr-bases ptr)
          [(ResultTcUnit.Ok)
            (tc-source-type-policy-ok ctx (ast.ty-node-get ty-id))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(ast.AstExpr.PtrToInt ptr-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        (tc-source-expr-policy-ok ctx expr-bases ptr))]
    [(ast.AstExpr.IntToPtr value-box ty-id)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (match (tc-source-expr-policy-ok ctx expr-bases value)
          [(ResultTcUnit.Ok)
            (tc-source-type-policy-ok ctx (ast.ty-node-get ty-id))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(ast.AstExpr.StringData str-box)
      (let
        [str : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases str-box)]
        (tc-source-expr-policy-ok ctx expr-bases str))]
    [(ast.AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [len : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases len-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases ptr len))]
    [(ast.AstExpr.ArrayData array-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        (tc-source-expr-policy-ok ctx expr-bases array))]
    [(ast.AstExpr.BinaryData _) ResultTcUnit.Ok]
    [(ast.AstExpr.SpmdProgramIndex) ResultTcUnit.Ok]
    [(ast.AstExpr.SpmdProgramCount) ResultTcUnit.Ok]
    [(ast.AstExpr.ProgramArgc) ResultTcUnit.Ok]
    [(ast.AstExpr.ProgramArgv) ResultTcUnit.Ok]
    [(ast.AstExpr.ProgramEnvp) ResultTcUnit.Ok]
    [(ast.AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases leaf subleaf))]
    [(ast.AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases leaf subleaf))]
    [(ast.AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases leaf subleaf))]
    [(ast.AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (tc-source-expr-pair-policy-ok ctx expr-bases leaf subleaf))]
    [(ast.AstExpr.Xgetbv index-box)
      (let
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (tc-source-expr-policy-ok ctx expr-bases index))]
    [(ast.AstExpr.Syscall args)
      (tc-source-expr-list-policy-ok ctx expr-bases args)]
    [_ ResultTcUnit.Ok]))

(define (tc-source-decl-policy-ok [ctx : TcContext] [decl : ast.AstDecl]) : ResultTcUnit
  (let
    [expr-bases : i64 (tc-context-expr-bases ctx)]
    (match decl
      [(ast.AstDecl.Def decl-meta _ maybe-ty expr-box)
        (let
          [expr : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases expr-box)]
          (match (tc-source-maybe-type-policy-ok ctx maybe-ty)
            [(ResultTcUnit.Ok)
              (if (tc-maybe-type-contains-reference? maybe-ty)
                (ResultTcUnit.Err
                  "typecheck: storing references in top-level values requires lifetime support")
                (match (tc-source-expr-policy-ok ctx expr-bases expr)
                  [(ResultTcUnit.Ok)
                    (tc-source-expr-spmd-broadcast-scope-ok
                      expr-bases
                      expr
                      false)]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
      [(ast.AstDecl.DefFn decl-meta _ params ret body-box _)
        (match (tc-elide-function-signature
          (tc-context-type-bases ctx)
          params
          ret)
          [(ResultTcElidedSignature.Ok signature)
            (let
              [signature-params : ast.AstParamList signature.params]
              [signature-ret : ast.AstType signature.ret]
              [body : ast.AstExpr
                (ast.ast-expr-segment-bases-get expr-bases body-box)]
              (match (tc-source-param-list-policy-ok ctx signature-params)
                [(ResultTcUnit.Ok)
                  (match (tc-source-type-policy-ok ctx signature-ret)
                    [(ResultTcUnit.Ok)
                      (match (tc-reference-return-policy-ok
                        ctx
                        signature-params
                        signature-ret)
                        [(ResultTcUnit.Ok)
                          (match (tc-source-expr-policy-ok ctx expr-bases body)
                            [(ResultTcUnit.Ok)
                              (tc-source-expr-spmd-broadcast-scope-ok
                                expr-bases
                                body
                                false)]
                            [(ResultTcUnit.Err message)
                              (ResultTcUnit.Err message)])]
                        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
                    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
                [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
          [(ResultTcElidedSignature.Err message) (ResultTcUnit.Err message)])]
      [(ast.AstDecl.DefMacro decl-meta _ params ret body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          (match (tc-source-macro-param-list-policy-ok ctx params)
            [(ResultTcUnit.Ok)
              (match (tc-source-macro-result-policy-ok ctx ret)
                [(ResultTcUnit.Ok)
                  (match (tc-source-expr-policy-ok ctx expr-bases body)
                    [(ResultTcUnit.Ok)
                      (tc-source-expr-spmd-broadcast-scope-ok
                        expr-bases
                        body
                        false)]
                    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
                [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
      [(ast.AstDecl.Extern decl-meta _ _ _ ty)
        (tc-source-type-policy-ok ctx ty)]
      [(ast.AstDecl.DefEnum decl-meta name _ variants)
        (match (tc-source-variant-list-policy-ok ctx variants)
          [(ResultTcUnit.Ok)
            (tc-source-default-aggregate-layout-finite-ok ctx name)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
      [(ast.AstDecl.DefEnumLifetimes decl-meta name lifetimes _ variants)
        (if (tc-lifetime-list-duplicates? lifetimes)
          (ResultTcUnit.Err "typecheck: duplicate lifetime parameter")
          (match (tc-source-variant-list-lifetimes-policy-ok
            ctx
            lifetimes
            variants)
            [(ResultTcUnit.Ok)
              (tc-source-default-aggregate-layout-finite-ok ctx name)]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
      [(ast.AstDecl.DefStruct decl-meta name repr cleanup fields)
        (match (tc-source-field-list-policy-ok ctx fields)
          [(ResultTcUnit.Ok)
            (if (and
              (ast.ast-struct-repr-c? repr)
              (ast.ast-struct-cleanup? cleanup))
              (ResultTcUnit.Err
                (tc-struct-cleanup-repr-c-message
                  (csym.compiler-symbol-module-key
                    (tc-context-module ctx)
                    (tc-env-key-name-text name))))
              (tc-source-default-struct-layout-finite-ok ctx name repr))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
      [(ast.AstDecl.DefStructLifetimes
          decl-meta
          name
          lifetimes
          repr
          cleanup
          fields)
        (if (tc-lifetime-list-duplicates? lifetimes)
          (ResultTcUnit.Err "typecheck: duplicate lifetime parameter")
          (match (tc-source-field-list-lifetimes-policy-ok ctx lifetimes fields)
            [(ResultTcUnit.Ok)
              (if (and
                (ast.ast-struct-repr-c? repr)
                (ast.ast-struct-cleanup? cleanup))
                (ResultTcUnit.Err
                  (tc-struct-cleanup-repr-c-message
                    (csym.compiler-symbol-module-key
                      (tc-context-module ctx)
                      (tc-env-key-name-text name))))
                (tc-source-default-struct-layout-finite-ok ctx name repr))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
      [(ast.AstDecl.DefDispatch decl-meta _ variants)
        (if (!= (tc-dispatch-variant-list-scalar-count variants) 1)
          (ResultTcUnit.Err
            "typecheck: defdispatch requires exactly one scalar variant")
          (if (tc-dispatch-variant-list-duplicate-isa? variants)
            (ResultTcUnit.Err "typecheck: duplicate defdispatch ISA variant")
            ResultTcUnit.Ok))]
      [(ast.AstDecl.IncludeStr _ _)
        (ResultTcUnit.Err
          "typecheck: include-str must be expanded by compiler loader")]
      [(ast.AstDecl.IncludeStrComptime _ _)
        (ResultTcUnit.Err
          "typecheck: include-str-comptime must be expanded by compiler loader")]
      [(ast.AstDecl.IncludeStrLzss _ _)
        (ResultTcUnit.Err
          "typecheck: include-str-lzss must be expanded by compiler loader")]
      [(ast.AstDecl.IncludeBin _ _)
        (ResultTcUnit.Err
          "typecheck: include-bin must be expanded by compiler loader")]
      [(ast.AstDecl.Import decl-meta _) ResultTcUnit.Ok]
      [(ast.AstDecl.Module _) ResultTcUnit.Ok]
      ;; Module bodies are traversed by the declaration-list diagnostic adapter,
      ;; which retains their nested list origin and owning path.
      [(ast.AstDecl.ModuleBody _ _) ResultTcUnit.Ok]
      [(ast.AstDecl.Test _ body-box _)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          (tc-source-expr-policy-ok ctx expr-bases body))]
      [(ast.AstDecl.Unsafe inner-box)
        (let
          [inner : ast.AstDecl (__tl-box-place inner-box)]
          (tc-source-decl-policy-ok ctx inner))])))

(defenum ResultTcSourcePolicyDiagnostic
  (Ok)
  (Err (Box cdiag.CompilerDiagnostic)))

(define (tc-source-decl-shape-origin-message? [message : String]) : bool
  (or
    (string.eq
      message
      "typecheck: defdispatch requires exactly one scalar variant")
    (string.eq message "typecheck: duplicate defdispatch ISA variant")
    (string.eq message "typecheck: duplicate lifetime parameter")
    (string.contains message " cannot use repr c")))

(define (tc-source-decl-list-policy-diagnostic-in-module
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [fallback-path : String]
  [module-id : i64]) : ResultTcSourcePolicyDiagnostic
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) ResultTcSourcePolicyDiagnostic.Ok]
    [(ast.AstDeclListStep.Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        [decl-path : String
          (match (ast.ast-decl-path-list-step paths)
            [(ast.AstDeclPathListStep.Cons path _) path]
            [(ast.AstDeclPathListStep.Nil) fallback-path])]
        [rest-paths : ast.AstDeclPathList
          (match (ast.ast-decl-path-list-step paths)
            [(ast.AstDeclPathListStep.Cons _ path-rest) path-rest]
            [(ast.AstDeclPathListStep.Nil) (ast.ast-decl-path-list-new)])]
        (match decl
          [(ast.AstDecl.Module next-module)
            (tc-source-decl-list-policy-diagnostic-in-module
              ctx
              rest
              rest-paths
              fallback-path
              next-module)]
          [(ast.AstDecl.ModuleBody target-module body-box)
            (match (tc-source-decl-list-policy-diagnostic-in-module
              (tc-context-with-module-id
                ctx
                (tc-env-key-name-text target-module)
                target-module)
              (__tl-box-place body-box)
              (ast.ast-decl-path-list-new)
              decl-path
              target-module)
              [(ResultTcSourcePolicyDiagnostic.Ok)
                (tc-source-decl-list-policy-diagnostic-in-module
                  ctx
                  rest
                  rest-paths
                  fallback-path
                  module-id)]
              [(ResultTcSourcePolicyDiagnostic.Err diag)
                (ResultTcSourcePolicyDiagnostic.Err diag)])]
          [_
            (match (tc-source-decl-policy-ok
              (tc-context-with-module-id
                ctx
                (if (csym.compiler-symbol-root-module-id? module-id)
                  ""
                  (tc-env-key-name-text module-id))
                module-id)
              decl)
              [(ResultTcUnit.Ok)
                (tc-source-decl-list-policy-diagnostic-in-module
                  ctx
                  rest
                  rest-paths
                  fallback-path
                  module-id)]
              [(ResultTcUnit.Err message)
                (ResultTcSourcePolicyDiagnostic.Err
                  (box
                    (if (tc-source-decl-shape-origin-message? message)
                      (tc-typecheck-diag-with-path
                        (& decls)
                        decl
                        decl-path
                        message)
                      (tc-diag-at-start message))))])]))]))

(define (tc-program-source-types-policy-ok
  [ctx : TcContext]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]) : ResultTcSourcePolicyDiagnostic
  (begin
    (tc-nominal-owner-cache-reset!)
    (match program
      [(ast.AstProgram.Program decls-box)
        (let
          [decls : ast.AstDeclList (__tl-box-place decls-box)]
          (tc-source-decl-list-policy-diagnostic-in-module
            ctx
            decls
            paths
            ""
            (csym.compiler-symbol-root-module-id)))])))

(define (tc-type-list-eq [a : ast.AstTypeList] [b : ast.AstTypeList]) : bool
  (and
    (= (ast.ast-type-list-len (& a)) (ast.ast-type-list-len (& b)))
    (tc-type-list-eq-at? (& a) (& b) 0)))

(define (tc-type-list-eq-at?
  [a : (& a ast.AstTypeList)]
  [b : (& b ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len a))
    true
    (and
      (tc-type-eq
        (ast.ty-node-get
          (ast.ast-type-list-get a index (ast.ast-type-id-fallback)))
        (ast.ty-node-get
          (ast.ast-type-list-get b index (ast.ast-type-id-fallback))))
      (tc-type-list-eq-at? a b (+ index 1)))))

(define (tc-nominal-name-id-eq? [a : i64] [b : i64]) : bool
  (= (csym.compiler-symbol-name-id-key a) (csym.compiler-symbol-name-id-key b)))

(define (tc-type-eq-core [a : ast.AstType] [b : ast.AstType]) : bool
  (match a
    [(ast.AstType.I64)
      (match b
        [(ast.AstType.I64) true]
        [_ false])]
    [(ast.AstType.I32)
      (match b
        [(ast.AstType.I32) true]
        [_ false])]
    [(ast.AstType.I16)
      (match b
        [(ast.AstType.I16) true]
        [_ false])]
    [(ast.AstType.I8)
      (match b
        [(ast.AstType.I8) true]
        [_ false])]
    [(ast.AstType.U64)
      (match b
        [(ast.AstType.U64) true]
        [_ false])]
    [(ast.AstType.U32)
      (match b
        [(ast.AstType.U32) true]
        [_ false])]
    [(ast.AstType.U16)
      (match b
        [(ast.AstType.U16) true]
        [_ false])]
    [(ast.AstType.U8)
      (match b
        [(ast.AstType.U8) true]
        [_ false])]
    [(ast.AstType.F64)
      (match b
        [(ast.AstType.F64) true]
        [_ false])]
    [(ast.AstType.F32)
      (match b
        [(ast.AstType.F32) true]
        [_ false])]
    [(ast.AstType.Bool)
      (match b
        [(ast.AstType.Bool) true]
        [_ false])]
    [(ast.AstType.Char)
      (match b
        [(ast.AstType.Char) true]
        [_ false])]
    [(ast.AstType.String)
      (match b
        [(ast.AstType.String) true]
        [_ false])]
    [(ast.AstType.Str)
      (match b
        [(ast.AstType.Str) true]
        [_ false])]
    [(ast.AstType.Bytes)
      (match b
        [(ast.AstType.Bytes) true]
        [_ false])]
    [(ast.AstType.Unit)
      (match b
        [(ast.AstType.Unit) true]
        [_ false])]
    [(ast.AstType.Never)
      (match b
        [(ast.AstType.Never) true]
        [_ false])]
    [(ast.AstType.Expr)
      (match b
        [(ast.AstType.Expr) true]
        [_ false])]
    [(ast.AstType.ExprList)
      (match b
        [(ast.AstType.ExprList) true]
        [_ false])]
    [(ast.AstType.Func a-args a-ret)
      (match b
        [(ast.AstType.Func b-args b-ret)
          (and
            (tc-type-list-eq (__tl-box-place a-args) (__tl-box-place b-args))
            (tc-type-eq (ast.ty-node-get a-ret) (ast.ty-node-get b-ret)))]
        [_ false])]
    [(ast.AstType.Tuple a-elems)
      (match b
        [(ast.AstType.Tuple b-elems)
          (tc-type-list-eq (__tl-box-place a-elems) (__tl-box-place b-elems))]
        [_ false])]
    [(ast.AstType.Array a-elem a-len)
      (match b
        [(ast.AstType.Array b-elem b-len)
          (and
            (= a-len b-len)
            (tc-type-eq (ast.ty-node-get a-elem) (ast.ty-node-get b-elem)))]
        [_ false])]
    [(ast.AstType.DynArray a-elem)
      (match b
        [(ast.AstType.DynArray b-elem)
          (tc-type-eq (ast.ty-node-get a-elem) (ast.ty-node-get b-elem))]
        [_ false])]
    [(ast.AstType.Slice a-elem)
      (match b
        [(ast.AstType.Slice b-elem)
          (tc-type-eq (ast.ty-node-get a-elem) (ast.ty-node-get b-elem))]
        [_ false])]
    [(ast.AstType.Box a-elem)
      (match b
        [(ast.AstType.Box b-elem)
          (tc-type-eq (ast.ty-node-get a-elem) (ast.ty-node-get b-elem))]
        [_ false])]
    [(ast.AstType.Ptr a-elem)
      (match b
        [(ast.AstType.Ptr b-elem)
          (tc-type-eq (ast.ty-node-get a-elem) (ast.ty-node-get b-elem))]
        [_ false])]
    [(ast.AstType.MutPtr a-elem)
      (match b
        [(ast.AstType.MutPtr b-elem)
          (tc-type-eq (ast.ty-node-get a-elem) (ast.ty-node-get b-elem))]
        [_ false])]
    [(ast.AstType.Ref a-region a-inner)
      (match b
        [(ast.AstType.Ref b-region b-inner)
          (and
            (= a-region b-region)
            (tc-type-eq (ast.ty-node-get a-inner) (ast.ty-node-get b-inner)))]
        [_ false])]
    [(ast.AstType.MutRef a-region a-inner)
      (match b
        [(ast.AstType.MutRef b-region b-inner)
          (and
            (= a-region b-region)
            (tc-type-eq (ast.ty-node-get a-inner) (ast.ty-node-get b-inner)))]
        [_ false])]
    [(ast.AstType.Region _ inner)
      (tc-type-eq-core
        (tc-type-without-regions (ast.ty-node-get inner))
        (tc-type-without-regions b))]
    [(ast.AstType.Enum a-name)
      (match b
        [(ast.AstType.Enum b-name) (tc-nominal-name-id-eq? a-name b-name)]
        [_ false])]
    [(ast.AstType.EnumArgs a-name a-lifetimes)
      (match b
        [(ast.AstType.EnumArgs b-name b-lifetimes)
          (and
            (tc-nominal-name-id-eq? a-name b-name)
            (tc-lifetime-list-eq
              (__tl-box-place a-lifetimes)
              (__tl-box-place b-lifetimes)))]
        [_ false])]
    [(ast.AstType.Struct a-name)
      (match b
        [(ast.AstType.Struct b-name) (tc-nominal-name-id-eq? a-name b-name)]
        [_ false])]
    [(ast.AstType.StructArgs a-name a-lifetimes)
      (match b
        [(ast.AstType.StructArgs b-name b-lifetimes)
          (and
            (tc-nominal-name-id-eq? a-name b-name)
            (tc-lifetime-list-eq
              (__tl-box-place a-lifetimes)
              (__tl-box-place b-lifetimes)))]
        [_ false])]
    [(ast.AstType.Var a-name)
      (match b
        [(ast.AstType.Var b-name) (tc-nominal-name-id-eq? a-name b-name)]
        [_ false])]
    [(ast.AstType.VarArgs a-name a-lifetimes)
      (match b
        [(ast.AstType.VarArgs b-name b-lifetimes)
          (and
            (tc-nominal-name-id-eq? a-name b-name)
            (tc-lifetime-list-eq
              (__tl-box-place a-lifetimes)
              (__tl-box-place b-lifetimes)))]
        [_ false])]
    [(ast.AstType.Consume a-inner)
      (match b
        [(ast.AstType.Consume b-inner)
          (tc-type-eq (ast.ty-node-get a-inner) (ast.ty-node-get b-inner))]
        [_ false])]))

(define (tc-type-eq [a : ast.AstType] [b : ast.AstType]) : bool
  (if (or (tc-poison-type? a) (tc-poison-type? b))
    true
    (match a
      [(ast.AstType.Region _ inner) (tc-type-eq (ast.ty-node-get inner) b)]
      [_
        (match b
          [(ast.AstType.Region _ inner) (tc-type-eq a (ast.ty-node-get inner))]
          [_ (tc-type-eq-core a b)])])))

(define (tc-never-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.Never) true]
    [_ false]))

(define (tc-f32-to-f64-compatible?
  [expected : ast.AstType]
  [actual : ast.AstType]) : bool
  (match (tc-type-strip-region expected)
    [(ast.AstType.F64)
      (match (tc-type-strip-region actual)
        [(ast.AstType.F32) true]
        [_ false])]
    [_ false]))

(define (tc-variance-flip [variance : TcVariance]) : TcVariance
  (match variance
    [(TcVariance.TcVarianceBivariant) (TcVariance.TcVarianceBivariant)]
    [(TcVariance.TcVarianceCovariant) (TcVariance.TcVarianceContravariant)]
    [(TcVariance.TcVarianceContravariant) (TcVariance.TcVarianceCovariant)]
    [(TcVariance.TcVarianceInvariant) (TcVariance.TcVarianceInvariant)]))

(define (tc-variance-compose [outer : TcVariance] [inner : TcVariance]) : TcVariance
  (match outer
    [(TcVariance.TcVarianceBivariant) (TcVariance.TcVarianceBivariant)]
    [(TcVariance.TcVarianceInvariant) (TcVariance.TcVarianceInvariant)]
    [(TcVariance.TcVarianceCovariant) inner]
    [(TcVariance.TcVarianceContravariant) (tc-variance-flip inner)]))

(define (tc-variance-merge [left : TcVariance] [right : TcVariance]) : TcVariance
  (match left
    [(TcVariance.TcVarianceBivariant) right]
    [(TcVariance.TcVarianceInvariant) (TcVariance.TcVarianceInvariant)]
    [(TcVariance.TcVarianceCovariant)
      (match right
        [(TcVariance.TcVarianceBivariant) left]
        [(TcVariance.TcVarianceCovariant) left]
        [_ (TcVariance.TcVarianceInvariant)])]
    [(TcVariance.TcVarianceContravariant)
      (match right
        [(TcVariance.TcVarianceBivariant) left]
        [(TcVariance.TcVarianceContravariant) left]
        [_ (TcVariance.TcVarianceInvariant)])]))

(define (tc-type-list-lifetime-variance-at
  [ctx : TcContext]
  [types : (& types ast.AstTypeList)]
  [lifetime-id : i64]
  [stack : TcNameIdList]
  [position : TcVariance]
  [index : i64]) : TcVariance
  (if (>= index (ast.ast-type-list-len types))
    (TcVariance.TcVarianceBivariant)
    (tc-variance-merge
      (tc-type-lifetime-variance
        ctx
        (ast.ty-node-get
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))
        lifetime-id
        stack
        position)
      (tc-type-list-lifetime-variance-at
        ctx
        types
        lifetime-id
        stack
        position
        (+ index 1)))))

(define (tc-type-list-lifetime-variance
  [ctx : TcContext]
  [types : ast.AstTypeList]
  [lifetime-id : i64]
  [stack : TcNameIdList]
  [position : TcVariance]) : TcVariance
  (tc-type-list-lifetime-variance-at ctx (& types) lifetime-id stack position 0))

(define (tc-field-list-lifetime-variance-at
  [ctx : TcContext]
  [fields : (& fields ast.AstFieldDefList)]
  [lifetime-id : i64]
  [stack : TcNameIdList]
  [index : i64]) : TcVariance
  (if (>= index fields.len)
    (TcVariance.TcVarianceBivariant)
    (match (ast.ast-field-def-list-get
      fields
      index
      (ast.ast-field-def-fallback))
      [(ast.AstFieldDef.Def _ ty _)
        (tc-variance-merge
          (tc-type-lifetime-variance
            ctx
            ty
            lifetime-id
            stack
            (TcVariance.TcVarianceCovariant))
          (tc-field-list-lifetime-variance-at
            ctx
            fields
            lifetime-id
            stack
            (+ index 1)))])))

(define (tc-variant-list-lifetime-variance-at
  [ctx : TcContext]
  [variants : (& variants ast.AstVariantDefList)]
  [lifetime-id : i64]
  [stack : TcNameIdList]
  [index : i64]) : TcVariance
  (if (>= index variants.len)
    (TcVariance.TcVarianceBivariant)
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(ast.AstVariantDef.Def _ payloads _)
        (tc-variance-merge
          (tc-type-list-lifetime-variance
            ctx
            payloads
            lifetime-id
            stack
            (TcVariance.TcVarianceCovariant))
          (tc-variant-list-lifetime-variance-at
            ctx
            variants
            lifetime-id
            stack
            (+ index 1)))])))

(define (tc-nominal-lifetime-variance-at
  [ctx : TcContext]
  [name-id : i64]
  [index : i64]
  [stack : TcNameIdList]) : TcVariance
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-type-id-or
        (tc-context-symbols ctx)
        name-id
        (csym.compiler-symbols-missing-handle))]
    (if (not (csym.compiler-symbols-handle-found? handle))
      (TcVariance.TcVarianceInvariant)
      (let
        [nominal-id : i64 (tc-nominal-owner-id-or ctx handle name-id)]
        (if (or (< nominal-id 0) (tc-name-id-list-contains stack nominal-id))
          ;; A recursive occurrence transmits its surrounding polarity. Using
          ;; covariance here is the conservative one-step fixed point: a
          ;; mutable-pointer/invariant wrapper still turns the cycle invariant.
          (TcVariance.TcVarianceCovariant)
          (let
            [owner-ctx : TcContext
              (tc-context-with-nominal-owner-index-module
                ctx
                (csym.compiler-symbol-handle-index handle))]
            [next-stack : TcNameIdList (tc-name-id-list-add stack nominal-id)]
            (match (csym.compiler-symbols-decl-at-index
              (tc-context-symbols owner-ctx)
              (csym.compiler-symbol-handle-index handle))
              [(parser.ResultAstDecl.Ok decl)
                (match decl
                  [(ast.AstDecl.DefStructLifetimes _ _ lifetimes _ _ fields)
                    (if (>= index (tc-lifetime-list-count lifetimes))
                      (TcVariance.TcVarianceInvariant)
                      (tc-field-list-lifetime-variance-at
                        owner-ctx
                        (& fields)
                        (ast.ast-lifetime-list-get
                          (& lifetimes)
                          index
                          (ast.ast-lifetime-fallback))
                        next-stack
                        0))]
                  [(ast.AstDecl.DefEnumLifetimes _ _ lifetimes _ variants)
                    (if (>= index (tc-lifetime-list-count lifetimes))
                      (TcVariance.TcVarianceInvariant)
                      (tc-variant-list-lifetime-variance-at
                        owner-ctx
                        (& variants)
                        (ast.ast-lifetime-list-get
                          (& lifetimes)
                          index
                          (ast.ast-lifetime-fallback))
                        next-stack
                        0))]
                  [_ (TcVariance.TcVarianceInvariant)])]
              [(parser.ResultAstDecl.Err _) (TcVariance.TcVarianceInvariant)])))))))

(define (tc-nominal-args-lifetime-variance-at
  [ctx : TcContext]
  [name-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [lifetime-id : i64]
  [stack : TcNameIdList]
  [position : TcVariance]
  [index : i64]) : TcVariance
  (if (>= index (ast.ast-lifetime-list-len (& lifetimes)))
    (TcVariance.TcVarianceBivariant)
    (let
      [argument : i64
        (ast.ast-lifetime-list-get
          (& lifetimes)
          index
          (ast.ast-lifetime-fallback))]
      [head : TcVariance
        (if (= argument lifetime-id)
          ;; Arena's brand is a capability identity, not a borrowed view. Its
          ;; phantom lifetime stays invariant even though the unchanged runtime
          ;; declaration has no field that ordinary inference could inspect.
          (if (and (tc-arena-nominal-name-id? name-id) (= index 0))
            (TcVariance.TcVarianceInvariant)
            (tc-variance-compose
              position
              (tc-nominal-lifetime-variance-at ctx name-id index stack)))
          (TcVariance.TcVarianceBivariant))]
      (tc-variance-merge
        head
        (tc-nominal-args-lifetime-variance-at
          ctx
          name-id
          lifetimes
          lifetime-id
          stack
          position
          (+ index 1))))))

(define (tc-type-lifetime-variance
  [ctx : TcContext]
  [ty : ast.AstType]
  [lifetime-id : i64]
  [stack : TcNameIdList]
  [position : TcVariance]) : TcVariance
  (match (tc-resolve-type ctx ty)
    [(ast.AstType.Func params ret)
      (tc-variance-merge
        (tc-type-list-lifetime-variance
          ctx
          (__tl-box-place params)
          lifetime-id
          stack
          (tc-variance-flip position))
        (tc-type-lifetime-variance
          ctx
          (ast.ty-node-get ret)
          lifetime-id
          stack
          position))]
    [(ast.AstType.Tuple elems)
      (tc-type-list-lifetime-variance
        ctx
        (__tl-box-place elems)
        lifetime-id
        stack
        position)]
    [(ast.AstType.Array elem _)
      (tc-type-lifetime-variance
        ctx
        (ast.ty-node-get elem)
        lifetime-id
        stack
        position)]
    ;; Compatibility dynamic arrays expose mutable element storage and are
    ;; therefore invariant. Native Slice is a view and follows its context.
    [(ast.AstType.DynArray elem)
      (tc-type-lifetime-variance
        ctx
        (ast.ty-node-get elem)
        lifetime-id
        stack
        (TcVariance.TcVarianceInvariant))]
    [(ast.AstType.Slice elem)
      (tc-type-lifetime-variance
        ctx
        (ast.ty-node-get elem)
        lifetime-id
        stack
        position)]
    [(ast.AstType.Box elem)
      (tc-type-lifetime-variance
        ctx
        (ast.ty-node-get elem)
        lifetime-id
        stack
        position)]
    [(ast.AstType.Ptr elem)
      (tc-type-lifetime-variance
        ctx
        (ast.ty-node-get elem)
        lifetime-id
        stack
        position)]
    [(ast.AstType.MutPtr elem)
      (tc-type-lifetime-variance
        ctx
        (ast.ty-node-get elem)
        lifetime-id
        stack
        (TcVariance.TcVarianceInvariant))]
    [(ast.AstType.Ref lifetime inner)
      (tc-variance-merge
        (if (= lifetime lifetime-id)
          position
          (TcVariance.TcVarianceBivariant))
        (tc-type-lifetime-variance
          ctx
          (ast.ty-node-get inner)
          lifetime-id
          stack
          position))]
    [(ast.AstType.MutRef lifetime inner)
      (tc-variance-merge
        (if (= lifetime lifetime-id)
          position
          (TcVariance.TcVarianceBivariant))
        (tc-type-lifetime-variance
          ctx
          (ast.ty-node-get inner)
          lifetime-id
          stack
          (TcVariance.TcVarianceInvariant)))]
    [(ast.AstType.Region lifetime inner)
      (tc-variance-merge
        (if (= lifetime lifetime-id)
          position
          (TcVariance.TcVarianceBivariant))
        (tc-type-lifetime-variance
          ctx
          (ast.ty-node-get inner)
          lifetime-id
          stack
          position))]
    [(ast.AstType.EnumArgs name lifetimes)
      (tc-nominal-args-lifetime-variance-at
        ctx
        name
        (__tl-box-place lifetimes)
        lifetime-id
        stack
        position
        0)]
    [(ast.AstType.StructArgs name lifetimes)
      (tc-nominal-args-lifetime-variance-at
        ctx
        name
        (__tl-box-place lifetimes)
        lifetime-id
        stack
        position
        0)]
    [(ast.AstType.VarArgs _ lifetimes)
      (if (tc-lifetime-list-contains (__tl-box-place lifetimes) lifetime-id)
        (TcVariance.TcVarianceInvariant)
        (TcVariance.TcVarianceBivariant))]
    [(ast.AstType.Consume inner)
      (tc-type-lifetime-variance
        ctx
        (ast.ty-node-get inner)
        lifetime-id
        stack
        position)]
    [_ (TcVariance.TcVarianceBivariant)]))

(define (tc-lifetime-coercible-for-variance?
  [env : TcTypeEnv]
  [variance : TcVariance]
  [expected : i64]
  [actual : i64]) : bool
  (if (= expected actual)
    true
    (match variance
      [(TcVariance.TcVarianceBivariant) true]
      [(TcVariance.TcVarianceCovariant)
        (tc-lifetime-outlives-lifetime-id? env actual expected)]
      [(TcVariance.TcVarianceContravariant)
        (tc-lifetime-outlives-lifetime-id? env expected actual)]
      [(TcVariance.TcVarianceInvariant) false])))

(define (tc-nominal-lifetime-coercion-variance-at
  [ctx : TcContext]
  [name-id : i64]
  [index : i64]) : TcVariance
  (if (and (tc-arena-nominal-name-id? name-id) (= index 0))
    (TcVariance.TcVarianceInvariant)
    (tc-nominal-lifetime-variance-at ctx name-id index TcNameIdList.Nil)))

(define (tc-nominal-lifetime-args-coercible-at?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [expected : (& expected ast.AstLifetimeList)]
  [actual : (& actual ast.AstLifetimeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-lifetime-list-len expected))
    true
    (and
      (tc-lifetime-coercible-for-variance?
        env
        (tc-nominal-lifetime-coercion-variance-at ctx name-id index)
        (ast.ast-lifetime-list-get expected index (ast.ast-lifetime-fallback))
        (ast.ast-lifetime-list-get actual index (ast.ast-lifetime-fallback)))
      (tc-nominal-lifetime-args-coercible-at?
        ctx
        env
        name-id
        expected
        actual
        (+ index 1)))))

(define (tc-nominal-lifetime-args-coercible?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [expected : ast.AstLifetimeList]
  [actual : ast.AstLifetimeList]) : bool
  (and
    (=
      (ast.ast-lifetime-list-len (& expected))
      (ast.ast-lifetime-list-len (& actual)))
    (tc-nominal-lifetime-args-coercible-at?
      ctx
      env
      name-id
      (& expected)
      (& actual)
      0)))

(define (tc-type-list-coercible-at?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expected : (& expected ast.AstTypeList)]
  [actual : (& actual ast.AstTypeList)]
  [contravariant : bool]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len expected))
    true
    (let
      [want : ast.AstType
        (ast.ty-node-get
          (ast.ast-type-list-get expected index (ast.ast-type-id-fallback)))]
      [got : ast.AstType
        (ast.ty-node-get
          (ast.ast-type-list-get actual index (ast.ast-type-id-fallback)))]
      (and
        (if contravariant
          (tc-type-coercible-core? ctx env got want)
          (tc-type-coercible-core? ctx env want got))
        (tc-type-list-coercible-at?
          ctx
          env
          expected
          actual
          contravariant
          (+ index 1))))))

(define (tc-type-list-coercible?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expected : ast.AstTypeList]
  [actual : ast.AstTypeList]
  [contravariant : bool]) : bool
  (and
    (= (ast.ast-type-list-len (& expected)) (ast.ast-type-list-len (& actual)))
    (tc-type-list-coercible-at? ctx env (& expected) (& actual) contravariant 0)))

(define (tc-type-coercible-core?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expected : ast.AstType]
  [actual : ast.AstType]) : bool
  ;; Region allocation tags are not part of type identity, but when both sides
  ;; carry one, changing the tag must be a proven shortening.
  (match expected
    [(ast.AstType.Region expected-region expected-inner)
      (match actual
        [(ast.AstType.Region actual-region actual-inner)
          (and
            (tc-lifetime-outlives-lifetime-id?
              env
              actual-region
              expected-region)
            (tc-type-coercible-core?
              ctx
              env
              (ast.ty-node-get expected-inner)
              (ast.ty-node-get actual-inner)))]
        [_
          (tc-type-coercible-core?
            ctx
            env
            (ast.ty-node-get expected-inner)
            actual)])]
    [_
      (match actual
        [(ast.AstType.Region _ actual-inner)
          (tc-type-coercible-core?
            ctx
            env
            expected
            (ast.ty-node-get actual-inner))]
        [_
          (if (tc-type-eq expected actual)
            true
            (match expected
              [(ast.AstType.Func expected-params expected-ret)
                (match actual
                  [(ast.AstType.Func actual-params actual-ret)
                    (and
                      (tc-type-list-coercible?
                        ctx
                        env
                        (__tl-box-place expected-params)
                        (__tl-box-place actual-params)
                        true)
                      (tc-type-coercible-core?
                        ctx
                        env
                        (ast.ty-node-get expected-ret)
                        (ast.ty-node-get actual-ret)))]
                  [_ false])]
              [(ast.AstType.Tuple expected-elems)
                (match actual
                  [(ast.AstType.Tuple actual-elems)
                    (tc-type-list-coercible?
                      ctx
                      env
                      (__tl-box-place expected-elems)
                      (__tl-box-place actual-elems)
                      false)]
                  [_ false])]
              [(ast.AstType.Array expected-elem expected-len)
                (match actual
                  [(ast.AstType.Array actual-elem actual-len)
                    (and
                      (= expected-len actual-len)
                      (tc-type-coercible-core?
                        ctx
                        env
                        (ast.ty-node-get expected-elem)
                        (ast.ty-node-get actual-elem)))]
                  [_ false])]
              [(ast.AstType.Slice expected-elem)
                (match actual
                  [(ast.AstType.Slice actual-elem)
                    (tc-type-coercible-core?
                      ctx
                      env
                      (ast.ty-node-get expected-elem)
                      (ast.ty-node-get actual-elem))]
                  [_ false])]
              [(ast.AstType.Box expected-elem)
                (match actual
                  [(ast.AstType.Box actual-elem)
                    (tc-type-coercible-core?
                      ctx
                      env
                      (ast.ty-node-get expected-elem)
                      (ast.ty-node-get actual-elem))]
                  [_ false])]
              [(ast.AstType.Ptr expected-elem)
                (match actual
                  [(ast.AstType.Ptr actual-elem)
                    (tc-type-coercible-core?
                      ctx
                      env
                      (ast.ty-node-get expected-elem)
                      (ast.ty-node-get actual-elem))]
                  [_ false])]
              [(ast.AstType.Ref expected-lifetime expected-inner)
                (match actual
                  [(ast.AstType.Ref actual-lifetime actual-inner)
                    (and
                      (tc-lifetime-outlives-lifetime-id?
                        env
                        actual-lifetime
                        expected-lifetime)
                      (tc-type-coercible-core?
                        ctx
                        env
                        (ast.ty-node-get expected-inner)
                        (ast.ty-node-get actual-inner)))]
                  [_ false])]
              [(ast.AstType.MutRef expected-lifetime expected-inner)
                (match actual
                  [(ast.AstType.MutRef actual-lifetime actual-inner)
                    (and
                      (tc-lifetime-outlives-lifetime-id?
                        env
                        actual-lifetime
                        expected-lifetime)
                      (tc-type-eq
                        (ast.ty-node-get expected-inner)
                        (ast.ty-node-get actual-inner)))]
                  [_ false])]
              [(ast.AstType.EnumArgs expected-name expected-lifetimes)
                (match actual
                  [(ast.AstType.EnumArgs actual-name actual-lifetimes)
                    (and
                      (tc-nominal-name-id-eq? expected-name actual-name)
                      (tc-nominal-lifetime-args-coercible?
                        ctx
                        env
                        expected-name
                        (__tl-box-place expected-lifetimes)
                        (__tl-box-place actual-lifetimes)))]
                  [_ false])]
              ;; A branded Arena may be deliberately erased to the legacy bare
              ;; handle for read-only/compatibility helpers. This is one-way:
              ;; the converse case remains unmatched, so a copied bare handle
              ;; can never regain authority over a generated brand.
              [(ast.AstType.Struct expected-name)
                (match actual
                  [(ast.AstType.StructArgs actual-name actual-lifetimes)
                    (tc-branded-arena-erases-to-bare?
                      expected-name
                      actual-name
                      (__tl-box-place actual-lifetimes))]
                  [_ false])]
              [(ast.AstType.StructArgs expected-name expected-lifetimes)
                (match actual
                  [(ast.AstType.StructArgs actual-name actual-lifetimes)
                    (and
                      (tc-nominal-name-id-eq? expected-name actual-name)
                      (tc-nominal-lifetime-args-coercible?
                        ctx
                        env
                        expected-name
                        (__tl-box-place expected-lifetimes)
                        (__tl-box-place actual-lifetimes)))]
                  [_ false])]
              [(ast.AstType.Consume expected-inner)
                (match actual
                  [(ast.AstType.Consume actual-inner)
                    (tc-type-coercible-core?
                      ctx
                      env
                      (ast.ty-node-get expected-inner)
                      (ast.ty-node-get actual-inner))]
                  [_ false])]
              [_ false]))])]))

(define (tc-type-coercible?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expected : ast.AstType]
  [actual : ast.AstType]) : bool
  (if (tc-never-type? actual)
    true
    (if (tc-type-coercible-core? ctx env expected actual)
      true
      ;; Preserve the existing scalar-only contextual numeric conversion. The
      ;; structural recursion above deliberately does not lift it into arrays,
      ;; pointers, references, or nominal aggregates.
      (tc-f32-to-f64-compatible? expected actual))))

(define (tc-lifetime-coercion-outlives-detail [source : i64] [required : i64]) : String
  (str_cat.str-cat
    "; source lifetime `"
    (ci.intern-str source)
    "` does not outlive required lifetime `"
    (ci.intern-str required)
    "`"))

(define (tc-lifetime-coercion-invariant-detail
  [label : String]
  [expected : ast.AstType]
  [actual : ast.AstType]) : String
  (let
    [source-lifetimes : TcNameIdList
      (tc-type-collect-reference-lifetimes actual)]
    [required-lifetimes : TcNameIdList
      (tc-type-collect-reference-lifetimes expected)]
    (if (or
      (tc-name-id-list-empty? source-lifetimes)
      (tc-name-id-list-empty? required-lifetimes))
      (str_cat.str-cat "; " label " is invariant")
      (str_cat.str-cat
        "; source lifetime `"
        (ci.intern-str (tc-name-id-list-head source-lifetimes))
        "` cannot satisfy required lifetime `"
        (ci.intern-str (tc-name-id-list-head required-lifetimes))
        "` because "
        label
        " is invariant"))))

(define (tc-lifetime-coercion-variance-detail
  [label : String]
  [expected : ast.AstType]
  [actual : ast.AstType]) : String
  (let
    [source-lifetimes : TcNameIdList
      (tc-type-collect-reference-lifetimes actual)]
    [required-lifetimes : TcNameIdList
      (tc-type-collect-reference-lifetimes expected)]
    (if (or
      (tc-name-id-list-empty? source-lifetimes)
      (tc-name-id-list-empty? required-lifetimes))
      (str_cat.str-cat "; " label " failed")
      (str_cat.str-cat
        "; source lifetime `"
        (ci.intern-str (tc-name-id-list-head source-lifetimes))
        "` cannot satisfy required lifetime `"
        (ci.intern-str (tc-name-id-list-head required-lifetimes))
        "` because "
        label
        " failed"))))

(define (tc-nominal-lifetime-coercion-failure-detail-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [expected : ast.AstLifetimeList]
  [actual : ast.AstLifetimeList]
  [index : i64]) : String
  (if (>= index (ast.ast-lifetime-list-len (& expected)))
    ""
    (let
      [required : i64
        (ast.ast-lifetime-list-get
          (& expected)
          index
          (ast.ast-lifetime-fallback))]
      [source : i64
        (ast.ast-lifetime-list-get (& actual) index (ast.ast-lifetime-fallback))]
      [variance : TcVariance
        (tc-nominal-lifetime-coercion-variance-at ctx name-id index)]
      (if (= required source)
        (tc-nominal-lifetime-coercion-failure-detail-at
          ctx
          env
          name-id
          expected
          actual
          (+ index 1))
        (match variance
          [(TcVariance.TcVarianceBivariant) ""]
          [(TcVariance.TcVarianceCovariant)
            (if (tc-lifetime-outlives-lifetime-id? env source required)
              ""
              (tc-lifetime-coercion-outlives-detail source required))]
          [(TcVariance.TcVarianceContravariant)
            (if (tc-lifetime-outlives-lifetime-id? env required source)
              ""
              (str_cat.str-cat
                "; required lifetime `"
                (ci.intern-str required)
                "` does not outlive source lifetime `"
                (ci.intern-str source)
                "` for contravariant lifetime parameter "
                (string.int->string (+ index 1))
                " of `"
                (tc-nominal-name-id-display name-id)
                "`"))]
          [(TcVariance.TcVarianceInvariant)
            (str_cat.str-cat
              "; source lifetime `"
              (ci.intern-str source)
              "` cannot satisfy required lifetime `"
              (ci.intern-str required)
              "` because lifetime parameter "
              (string.int->string (+ index 1))
              " of `"
              (tc-nominal-name-id-display name-id)
              "` is invariant")])))))

(define (tc-type-coercion-failure-detail
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expected : ast.AstType]
  [actual : ast.AstType]) : String
  (let
    [want : ast.AstType (tc-type-strip-region (tc-resolve-type ctx expected))]
    [got : ast.AstType (tc-type-strip-region (tc-resolve-type ctx actual))]
    (match want
      [(ast.AstType.Ref required want-inner)
        (match got
          [(ast.AstType.Ref source got-inner)
            (let
              [want-inner-ty : ast.AstType (ast.ty-node-get want-inner)]
              [got-inner-ty : ast.AstType (ast.ty-node-get got-inner)]
              [inner-detail : String
                (tc-type-coercion-failure-detail
                  ctx
                  env
                  want-inner-ty
                  got-inner-ty)]
              (cond
                [(not
                    (tc-type-coercible-core? ctx env want-inner-ty got-inner-ty))
                  inner-detail]
                [(tc-lifetime-outlives-lifetime-id? env source required) ""]
                [else (tc-lifetime-coercion-outlives-detail source required)]))]
          [_ ""])]
      [(ast.AstType.MutRef required want-inner)
        (match got
          [(ast.AstType.MutRef source got-inner)
            (if (tc-type-eq
              (ast.ty-node-get want-inner)
              (ast.ty-node-get got-inner))
              (if (tc-lifetime-outlives-lifetime-id? env source required)
                ""
                (tc-lifetime-coercion-outlives-detail source required))
              (tc-lifetime-coercion-invariant-detail
                "mutable reference referent type"
                (ast.ty-node-get want-inner)
                (ast.ty-node-get got-inner)))]
          [_ ""])]
      [(ast.AstType.MutPtr want-inner)
        (match got
          [(ast.AstType.MutPtr got-inner)
            (tc-lifetime-coercion-invariant-detail
              "mutable raw pointer referent type"
              (ast.ty-node-get want-inner)
              (ast.ty-node-get got-inner))]
          [_ ""])]
      [(ast.AstType.DynArray want-inner)
        (match got
          [(ast.AstType.DynArray got-inner)
            (tc-lifetime-coercion-invariant-detail
              "dynamic array element type"
              (ast.ty-node-get want-inner)
              (ast.ty-node-get got-inner))]
          [_ ""])]
      [(ast.AstType.Func _ _)
        (match got
          [(ast.AstType.Func _ _)
            (tc-lifetime-coercion-variance-detail
              "function parameter/result variance"
              want
              got)]
          [_ ""])]
      [(ast.AstType.EnumArgs want-name want-lifetimes)
        (match got
          [(ast.AstType.EnumArgs got-name got-lifetimes)
            (if (tc-nominal-name-id-eq? want-name got-name)
              (tc-nominal-lifetime-coercion-failure-detail-at
                ctx
                env
                want-name
                (__tl-box-place want-lifetimes)
                (__tl-box-place got-lifetimes)
                0)
              "")]
          [_ ""])]
      [(ast.AstType.StructArgs want-name want-lifetimes)
        (match got
          [(ast.AstType.StructArgs got-name got-lifetimes)
            (if (tc-nominal-name-id-eq? want-name got-name)
              (tc-nominal-lifetime-coercion-failure-detail-at
                ctx
                env
                want-name
                (__tl-box-place want-lifetimes)
                (__tl-box-place got-lifetimes)
                0)
              "")]
          [_ ""])]
      [_ ""])))

(define (tc-type-mismatch-message-in-context
  [ctx : TcContext]
  [env : TcTypeEnv]
  [actual : ast.AstType]
  [expected : ast.AstType]
  [message : String]) : String
  (str_cat.str-cat
    (tc-type-mismatch-message actual expected message)
    (tc-type-coercion-failure-detail ctx env expected actual)))

(define (tc-type-compatible? [expected : ast.AstType] [actual : ast.AstType]) : bool
  (if (tc-never-type? actual)
    true
    (if (tc-type-eq expected actual)
      true
      (tc-f32-to-f64-compatible? expected actual))))

(define (tc-match-canonicalized-inferred-type-for-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [canonical : ast.AstType]
  [expected : ast.AstType]) : TcInferredTypeMatch
  (let
    [canonical-expected : ast.AstType
      (tc-canonicalize-inferred-type ctx expected)]
    (if (tc-type-coercible? ctx env canonical-expected canonical)
      (TcInferredTypeMatch.Compatible canonical)
      (TcInferredTypeMatch.Mismatch canonical))))

(define (tc-match-inferred-type-for-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : ast.AstType]
  [expected : ast.AstType]) : TcInferredTypeMatch
  (if (tc-type-coercible? ctx env expected ty)
    (TcInferredTypeMatch.Compatible ty)
    (let
      [canonical : ast.AstType (tc-canonicalize-inferred-type ctx ty)]
      (if (tc-type-coercible? ctx env expected canonical)
        (TcInferredTypeMatch.Compatible canonical)
        (tc-match-canonicalized-inferred-type-for-expected
          ctx
          env
          canonical
          expected)))))

(define (tc-nominal-name-id-canonical-eq?
  [ctx : TcContext]
  [actual : i64]
  [expected : i64]) : bool
  (let
    [actual-base : i64 (tc-qualified-name-base-id actual)]
    [expected-base : i64 (tc-qualified-name-base-id expected)]
    (cond
      [(not (tc-nominal-name-id-eq? actual-base expected-base)) false]
      [else
        (let
          [canonical-actual : i64 (tc-source-owned-nominal-name-id ctx actual)]
          (cond
            [(tc-nominal-name-id-eq? canonical-actual expected) true]
            [else
              (tc-nominal-name-id-eq?
                canonical-actual
                (tc-source-owned-nominal-name-id ctx expected))]))])))

(define (tc-merge-branch-type-raw
  [ctx : TcContext]
  [env : TcTypeEnv]
  [a : ast.AstType]
  [b : ast.AstType]) : ResultTcType
  (cond
    [(tc-never-type? a) (ResultTcType.Ok b)]
    [(tc-never-type? b) (ResultTcType.Ok a)]
    [(tc-type-eq a b)
      (let
        [a-regions : TcNameIdList (tc-type-collect-regions a)]
        [b-regions : TcNameIdList (tc-type-collect-regions b)]
        (if (tc-name-id-list-eq a-regions b-regions)
          (ResultTcType.Ok a)
          (match a-regions
            [(TcNameIdList.Nil) (ResultTcType.Ok b)]
            [_
              (match b-regions
                [(TcNameIdList.Nil) (ResultTcType.Ok a)]
                [_ (ResultTcType.Err "typecheck: if branches must match")])])))]
    [(tc-type-coercible? ctx env a b) (ResultTcType.Ok a)]
    [(tc-type-coercible? ctx env b a) (ResultTcType.Ok b)]
    [else (ResultTcType.Err "typecheck: if branches must match")]))

(define (tc-merge-branch-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [a : ast.AstType]
  [b : ast.AstType]) : ResultTcType
  (match (tc-merge-branch-type-raw ctx env a b)
    [(ResultTcType.Ok merged) (ResultTcType.Ok merged)]
    [(ResultTcType.Err _)
      (tc-merge-branch-type-raw
        ctx
        env
        (tc-canonicalize-inferred-type ctx a)
        (tc-canonicalize-inferred-type ctx b))]))

(define (tc-match-arm-merge-message
  [previous : ast.AstType]
  [current : ast.AstType]) : String
  (str_cat.str-cat
    "typecheck: match arms must agree: previous arm type "
    (tc-type-render previous)
    ", current arm type "
    (tc-type-render current)))

(define (tc-integer-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(ast.AstType.I64) true]
    [(ast.AstType.I32) true]
    [(ast.AstType.I16) true]
    [(ast.AstType.I8) true]
    [(ast.AstType.U64) true]
    [(ast.AstType.U32) true]
    [(ast.AstType.U16) true]
    [(ast.AstType.U8) true]
    [_ false]))

(define (tc-repeat-text [piece : String] [count : i64]) : String
  (let
    [out : String ""]
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (set! out (str_cat.str-cat out piece ""))
          (set! i (+ i 1))))
      out)))

(define (tc-binary-ones [bits : i64]) : String
  (tc-repeat-text "1" bits))

(define (tc-binary-min-signed [bits : i64]) : String
  (str_cat.str-cat "1" (tc-repeat-text "0" (- bits 1))))

(define (tc-integer-literal-fits-positive-type?
  [text : String]
  [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(ast.AstType.I8)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "127"
        "7f"
        (tc-binary-ones 7))]
    [(ast.AstType.I16)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "32767"
        "7fff"
        (tc-binary-ones 15))]
    [(ast.AstType.I32)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "2147483647"
        "7fffffff"
        (tc-binary-ones 31))]
    [(ast.AstType.I64)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "9223372036854775807"
        "7fffffffffffffff"
        (tc-binary-ones 63))]
    [(ast.AstType.U8)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "255"
        "ff"
        (tc-binary-ones 8))]
    [(ast.AstType.U16)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "65535"
        "ffff"
        (tc-binary-ones 16))]
    [(ast.AstType.U32)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "4294967295"
        "ffffffff"
        (tc-binary-ones 32))]
    [(ast.AstType.U64)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "18446744073709551615"
        "ffffffffffffffff"
        (tc-binary-ones 64))]
    [_ false]))

(define (tc-integer-literal-fits-negative-type?
  [text : String]
  [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(ast.AstType.I8)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "128"
        "80"
        (tc-binary-min-signed 8))]
    [(ast.AstType.I16)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "32768"
        "8000"
        (tc-binary-min-signed 16))]
    [(ast.AstType.I32)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "2147483648"
        "80000000"
        (tc-binary-min-signed 32))]
    [(ast.AstType.I64)
      (ast.ast-int-literal-magnitude-fits-limit?
        text
        "9223372036854775808"
        "8000000000000000"
        (tc-binary-min-signed 64))]
    [_ false]))

(define (tc-integer-literal-fits-type? [text : String] [ty : ast.AstType]) : bool
  (if (ast.ast-int-literal-negative? text)
    (tc-integer-literal-fits-negative-type? text ty)
    (tc-integer-literal-fits-positive-type? text ty)))

(define (tc-integer-literal-value-fits-type? [value : i64] [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(ast.AstType.I8) (and (>= value -128) (<= value 127))]
    [(ast.AstType.I16) (and (>= value -32768) (<= value 32767))]
    [(ast.AstType.I32) (and (>= value -2147483648) (<= value 2147483647))]
    [(ast.AstType.I64) true]
    [(ast.AstType.U8) (and (>= value 0) (<= value 255))]
    [(ast.AstType.U16) (and (>= value 0) (<= value 65535))]
    [(ast.AstType.U32) (and (>= value 0) (<= value 4294967295))]
    [(ast.AstType.U64) (>= value 0)]
    [_ false]))

(define (tc-integer-literal-fits-value-or-text?
  [value : i64]
  [text : String]
  [ty : ast.AstType]) : bool
  (if (> (string.string-length text) 0)
    (tc-integer-literal-fits-type? text ty)
    (tc-integer-literal-value-fits-type? value ty)))

(define (tc-integer-literal-render [value : i64] [text : String]) : String
  (if (> (string.string-length text) 0)
    text
    (string.int->string value)))

(define (tc-integer-literal-range-message
  [ctx : TcContext]
  [value : i64]
  [text : String]
  [expected : ast.AstType]) : String
  (str_cat.str-cat
    "typecheck: integer literal "
    (tc-integer-literal-render value text)
    " does not fit expected type "
    (tc-type-render (tc-type-without-regions (tc-resolve-type ctx expected)))))

(define (tc-integer-literal-type-with-expected
  [ctx : TcContext]
  [value : i64]
  [text : String]
  [expected : ast.AstType]) : ResultTcType
  (let
    [resolved : ast.AstType
      (tc-type-without-regions (tc-resolve-type ctx expected))]
    (if (tc-integer-type? resolved)
      (if (tc-integer-literal-fits-value-or-text? value text resolved)
        (ResultTcType.Ok resolved)
        (ResultTcType.Err
          (tc-integer-literal-range-message ctx value text expected)))
      (ResultTcType.Ok (ast.AstType.I32)))))

(define (tc-float-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(ast.AstType.F64) true]
    [(ast.AstType.F32) true]
    [_ false]))

;; Word-class for register-resident aggregates: a POD type that occupies
;; at most one machine word and is trivially copyable by value. Integers, bool,
;; char, and raw pointers qualify. Floats are excluded (a register-resident
;; aggregate is packed into general-purpose words). Owning handles (Box, String,
;; Array, DynArray), references, closures, tuples, and nested struct/enum fields
;; are excluded too: they would need deep-clone or multi-word handling that the
;; word-copy representation does not provide.
(define (tc-word-class-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(ast.AstType.I64) true]
    [(ast.AstType.U64) true]
    [(ast.AstType.I32) true]
    [(ast.AstType.U32) true]
    [(ast.AstType.I16) true]
    [(ast.AstType.U16) true]
    [(ast.AstType.I8) true]
    [(ast.AstType.U8) true]
    [(ast.AstType.Bool) true]
    [(ast.AstType.Char) true]
    [(ast.AstType.Ptr _) true]
    [(ast.AstType.MutPtr _) true]
    [_ false]))

(define (tc-ordered-comparison-type? [ty : ast.AstType]) : bool
  (if (tc-integer-type? ty)
    true
    (if (tc-float-type? ty)
      true
      (match (tc-type-strip-region ty)
        [(ast.AstType.Char) true]
        [_ false]))))

(define (tc-castable-type? [ty : ast.AstType]) : bool
  (if (tc-integer-type? ty)
    true
    (match (tc-type-strip-region ty)
      [(ast.AstType.Char) true]
      [(ast.AstType.F64) true]
      [(ast.AstType.F32) true]
      [_ false])))

(define (tc-function-to-integer-cast?
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : bool
  (match (tc-type-strip-region from-ty)
    [(ast.AstType.Func _ _) (tc-integer-type? (tc-type-strip-region to-ty))]
    [_ false]))

(define (tc-raw-pointer-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(ast.AstType.Ptr _) true]
    [(ast.AstType.MutPtr _) true]
    [_ false]))

(define (tc-type-move-kind-copyable-type-list-at
  [ctx : TcContext]
  [types : (& types ast.AstTypeList)]
  [stack : TcNameIdList]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    true
    (and
      (tc-move-kind-copyable?
        (tc-type-move-kind-with-stack
          ctx
          (tc-context-type-get
            ctx
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))
          stack))
      (tc-type-move-kind-copyable-type-list-at ctx types stack (+ index 1)))))

(define (tc-type-move-kind-copyable-type-list?
  [ctx : TcContext]
  [types : ast.AstTypeList]
  [stack : TcNameIdList]) : bool
  (tc-type-move-kind-copyable-type-list-at ctx (& types) stack 0))

(define (tc-type-move-kind-copyable-nominal-types?
  [ctx : TcContext]
  [nominal-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [types : ast.AstTypeList]
  [stack : TcNameIdList]) : bool
  ;; Resolve declaration fields/payloads in the declaration owner's module,
  ;; then apply the use-site lifetime arguments positionally. A failed
  ;; substitution is an invalid type and therefore conservatively MoveOnly.
  (match (tc-lifetime-subst-from-nominal-args-id ctx nominal-id lifetimes)
    [(ResultTcLifetimeSubst.Ok subst)
      (tc-type-move-kind-copyable-type-list?
        ctx
        (tc-lifetime-subst-type-list subst types)
        stack)]
    [(ResultTcLifetimeSubst.Err _) false]))

(define (tc-type-move-kind-copyable-struct-fields?
  [ctx : TcContext]
  [nominal-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [fields : ast.AstFieldDefList]
  [stack : TcNameIdList]) : bool
  (tc-type-move-kind-copyable-nominal-types?
    ctx
    nominal-id
    lifetimes
    (tc-field-type-list ctx fields)
    stack))

(define (tc-type-move-kind-copyable-enum-variants-at
  [ctx : TcContext]
  [nominal-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [variants : (& variants ast.AstVariantDefList)]
  [stack : TcNameIdList]
  [index : i64]) : bool
  (if (>= index variants.len)
    true
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(ast.AstVariantDef.Def _ payloads _)
        (and
          (tc-type-move-kind-copyable-nominal-types?
            ctx
            nominal-id
            lifetimes
            (tc-resolve-type-list ctx payloads)
            stack)
          (tc-type-move-kind-copyable-enum-variants-at
            ctx
            nominal-id
            lifetimes
            variants
            stack
            (+ index 1)))])))

(define (tc-type-move-kind-copyable-enum-variants?
  [ctx : TcContext]
  [nominal-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [variants : ast.AstVariantDefList]
  [stack : TcNameIdList]) : bool
  (tc-type-move-kind-copyable-enum-variants-at
    ctx
    nominal-id
    lifetimes
    (& variants)
    stack
    0))

(define (tc-type-move-kind-nominal-with-stack
  [ctx : TcContext]
  [name-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [stack : TcNameIdList]) : TcMoveKind
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-type-id-or
        (tc-context-symbols ctx)
        name-id
        (csym.compiler-symbols-missing-handle))]
    (if (not (csym.compiler-symbols-handle-found? handle))
      (TcMoveKind.MoveOnly)
      (let
        [kind : i64 (csym.compiler-symbol-handle-kind handle)]
        [nominal-id : i64 (tc-nominal-owner-id-or ctx handle name-id)]
        (if (or
          (< nominal-id 0)
          (not
            (or
              (= kind (csym.compiler-symbol-kind-defstruct))
              (= kind (csym.compiler-symbol-kind-defenum)))))
          (TcMoveKind.MoveOnly)
          (if (tc-name-id-list-contains stack nominal-id)
            ;; Recursive by-value declarations are invalid layouts, but the
            ;; classifier remains total and conservative instead of recursing
            ;; forever.
            (TcMoveKind.MoveOnly)
            (let
              [owner-ctx : TcContext
                (tc-context-with-nominal-owner-index-module
                  ctx
                  (csym.compiler-symbol-handle-index handle))]
              (match (csym.compiler-symbols-decl-at-index
                (tc-context-symbols owner-ctx)
                (csym.compiler-symbol-handle-index handle))
                [(parser.ResultAstDecl.Ok decl)
                  (let
                    [next-stack : TcNameIdList
                      (tc-name-id-list-add stack nominal-id)]
                    (match decl
                      [(ast.AstDecl.DefStruct _ _ _ cleanup fields)
                        (if (ast.ast-struct-cleanup? cleanup)
                          (TcMoveKind.MoveOnly)
                          (if (tc-type-move-kind-copyable-struct-fields?
                            owner-ctx
                            nominal-id
                            lifetimes
                            fields
                            next-stack)
                            (TcMoveKind.Copyable)
                            (TcMoveKind.MoveOnly)))]
                      [(ast.AstDecl.DefStructLifetimes _ _ _ _ cleanup fields)
                        (if (ast.ast-struct-cleanup? cleanup)
                          (TcMoveKind.MoveOnly)
                          (if (tc-type-move-kind-copyable-struct-fields?
                            owner-ctx
                            nominal-id
                            lifetimes
                            fields
                            next-stack)
                            (TcMoveKind.Copyable)
                            (TcMoveKind.MoveOnly)))]
                      [(ast.AstDecl.DefEnum _ _ cleanup variants)
                        (if (ast.ast-enum-cleanup? cleanup)
                          (TcMoveKind.MoveOnly)
                          (if (tc-type-move-kind-copyable-enum-variants?
                            owner-ctx
                            nominal-id
                            lifetimes
                            variants
                            next-stack)
                            (TcMoveKind.Copyable)
                            (TcMoveKind.MoveOnly)))]
                      [(ast.AstDecl.DefEnumLifetimes _ _ _ cleanup variants)
                        (if (ast.ast-enum-cleanup? cleanup)
                          (TcMoveKind.MoveOnly)
                          (if (tc-type-move-kind-copyable-enum-variants?
                            owner-ctx
                            nominal-id
                            lifetimes
                            variants
                            next-stack)
                            (TcMoveKind.Copyable)
                            (TcMoveKind.MoveOnly)))]
                      [_ (TcMoveKind.MoveOnly)]))]
                [(parser.ResultAstDecl.Err _) (TcMoveKind.MoveOnly)]))))))))

(define (tc-type-move-kind-with-stack
  [ctx : TcContext]
  [ty : ast.AstType]
  [stack : TcNameIdList]) : TcMoveKind
  (match (tc-resolve-type ctx ty)
    [(ast.AstType.I64) (TcMoveKind.Copyable)]
    [(ast.AstType.I32) (TcMoveKind.Copyable)]
    [(ast.AstType.I16) (TcMoveKind.Copyable)]
    [(ast.AstType.I8) (TcMoveKind.Copyable)]
    [(ast.AstType.U64) (TcMoveKind.Copyable)]
    [(ast.AstType.U32) (TcMoveKind.Copyable)]
    [(ast.AstType.U16) (TcMoveKind.Copyable)]
    [(ast.AstType.U8) (TcMoveKind.Copyable)]
    [(ast.AstType.F64) (TcMoveKind.Copyable)]
    [(ast.AstType.F32) (TcMoveKind.Copyable)]
    [(ast.AstType.Bool) (TcMoveKind.Copyable)]
    [(ast.AstType.Char) (TcMoveKind.Copyable)]
    [(ast.AstType.Unit) (TcMoveKind.Copyable)]
    [(ast.AstType.Never) (TcMoveKind.Copyable)]
    [(ast.AstType.Expr) (TcMoveKind.Copyable)]
    [(ast.AstType.ExprList) (TcMoveKind.Copyable)]
    ;; Function values are represented by the function type only. Capturing
    ;; closures carry a separate environment and remain a later issue.
    [(ast.AstType.Func _ _) (TcMoveKind.Copyable)]
    [(ast.AstType.Ptr _) (TcMoveKind.Copyable)]
    [(ast.AstType.MutPtr _) (TcMoveKind.Copyable)]
    ;; Shared references are handles and remain Copyable independent of their
    ;; referent. Mutable references are unique and therefore MoveOnly.
    [(ast.AstType.Ref _ _) (TcMoveKind.Copyable)]
    [(ast.AstType.MutRef _ _) (TcMoveKind.MoveOnly)]
    [(ast.AstType.Region _ inner)
      (tc-type-move-kind-with-stack ctx (tc-context-type-get ctx inner) stack)]
    [(ast.AstType.Consume inner)
      (tc-type-move-kind-with-stack ctx (tc-context-type-get ctx inner) stack)]
    [(ast.AstType.Tuple elems)
      (if (tc-type-move-kind-copyable-type-list?
        ctx
        (__tl-box-place elems)
        stack)
        (TcMoveKind.Copyable)
        (TcMoveKind.MoveOnly))]
    [(ast.AstType.Array elem _)
      (tc-type-move-kind-with-stack ctx (tc-context-type-get ctx elem) stack)]
    ;; These are owning handles or unsized/compatibility views. Their element
    ;; types do not make the value shallowly Copyable.
    [(ast.AstType.String) (TcMoveKind.MoveOnly)]
    [(ast.AstType.Str) (TcMoveKind.MoveOnly)]
    [(ast.AstType.Bytes) (TcMoveKind.MoveOnly)]
    [(ast.AstType.DynArray _) (TcMoveKind.MoveOnly)]
    [(ast.AstType.Slice _) (TcMoveKind.MoveOnly)]
    [(ast.AstType.Box _) (TcMoveKind.MoveOnly)]
    [(ast.AstType.Enum name)
      (tc-type-move-kind-nominal-with-stack
        ctx
        name
        (ast.ast-lifetime-list-new)
        stack)]
    [(ast.AstType.EnumArgs name lifetimes)
      (tc-type-move-kind-nominal-with-stack
        ctx
        name
        (__tl-box-place lifetimes)
        stack)]
    [(ast.AstType.Struct name)
      (tc-type-move-kind-nominal-with-stack
        ctx
        name
        (ast.ast-lifetime-list-new)
        stack)]
    [(ast.AstType.StructArgs name lifetimes)
      (if (and
        (tc-arena-nominal-name-id? name)
        (> (tc-lifetime-list-count (__tl-box-place lifetimes)) 0))
        (TcMoveKind.MoveOnly)
        (tc-type-move-kind-nominal-with-stack
          ctx
          name
          (__tl-box-place lifetimes)
          stack))]
    ;; Unresolved names and invalid type variables must never accidentally
    ;; become Copyable.
    [(ast.AstType.Var _) (TcMoveKind.MoveOnly)]
    [(ast.AstType.VarArgs _ _) (TcMoveKind.MoveOnly)]))

(define (tc-type-move-kind [ctx : TcContext] [ty : ast.AstType]) : TcMoveKind
  (tc-type-move-kind-with-stack ctx ty TcNameIdList.Nil))

(define (tc-move-kind-copyable? [kind : TcMoveKind]) : bool
  (match kind
    [(TcMoveKind.Copyable) true]
    [(TcMoveKind.MoveOnly) false]))

(define (tc-type-copyable? [ctx : TcContext] [ty : ast.AstType]) : bool
  (tc-move-kind-copyable? (tc-type-move-kind ctx ty)))

(define (tc-type-move-only? [ctx : TcContext] [ty : ast.AstType]) : bool
  (not (tc-type-copyable? ctx ty)))

(define (tc-raw-pointer-elem [ty : ast.AstType] [message : String]) : ResultTcType
  (match (tc-type-strip-region ty)
    [(ast.AstType.Ptr elem) (ResultTcType.Ok (ast.ty-node-get elem))]
    [(ast.AstType.MutPtr elem) (ResultTcType.Ok (ast.ty-node-get elem))]
    [_ (ResultTcType.Err message)]))

(define (tc-mut-pointer-elem [ty : ast.AstType] [message : String]) : ResultTcType
  (match (tc-type-strip-region ty)
    [(ast.AstType.MutPtr elem) (ResultTcType.Ok (ast.ty-node-get elem))]
    [_ (ResultTcType.Err message)]))

(define (tc-atomic-pointer-name? [name : String]) : bool
  (cbi.compiler-builtin-typecheck-atomic-pointer-name? name))

(define (tc-atomic-load-name? [name : String]) : bool
  (or (string.eq name "atomic-load") (string.eq name "volatile-load")))

(define (tc-atomic-store-name? [name : String]) : bool
  (or (string.eq name "atomic-store!") (string.eq name "volatile-store!")))

(define (tc-atomic-cas-name? [name : String]) : bool
  (string.eq name "atomic-cas!"))

(define (tc-atomic-elem-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(ast.AstType.I64) true]
    [(ast.AstType.U64) true]
    [(ast.AstType.I32) true]
    [(ast.AstType.U32) true]
    [_ false]))

(define (tc-atomic-kind-volatile? [name : String]) : bool
  (or (string.eq name "volatile-load") (string.eq name "volatile-store!")))

(define (tc-atomic-check-elem [name : String] [elem : ast.AstType]) : ResultTcType
  (let
    [resolved : ast.AstType (tc-type-strip-region elem)]
    (if (tc-atomic-elem-type? resolved)
      (ResultTcType.Ok resolved)
      (ResultTcType.Err
        (if (tc-atomic-kind-volatile? name)
          "typecheck: volatile pointer element must be i32, i64, u32, or u64"
          "typecheck: atomic pointer element must be i32, i64, u32, or u64")))))

(define (tc-atomic-pointer-elem
  [ctx : TcContext]
  [name : String]
  [ptr-ty : ast.AstType]) : ResultTcType
  (if (tc-atomic-load-name? name)
    (match (tc-raw-pointer-elem
      (tc-resolve-type ctx ptr-ty)
      (str_cat.str-cat "typecheck: " name " requires a raw pointer operand"))
      [(ResultTcType.Ok elem)
        (tc-atomic-check-elem name (tc-resolve-type ctx elem))]
      [(ResultTcType.Err message) (ResultTcType.Err message)])
    (match (tc-mut-pointer-elem
      (tc-resolve-type ctx ptr-ty)
      (str_cat.str-cat "typecheck: " name " requires a MutPtr pointer operand"))
      [(ResultTcType.Ok elem)
        (tc-atomic-check-elem name (tc-resolve-type ctx elem))]
      [(ResultTcType.Err message) (ResultTcType.Err message)])))

(define (tc-atomic-value-mismatch-message [name : String]) : String
  (if (tc-atomic-kind-volatile? name)
    "typecheck: volatile value type mismatch"
    "typecheck: atomic value type mismatch"))

(define (tc-atomic-load-arity-message [name : String]) : String
  (str_cat.str-cat "typecheck: " name " expects exactly one argument"))

(define (tc-atomic-update-arity-message [name : String]) : String
  (if (tc-atomic-kind-volatile? name)
    "typecheck: volatile-store! expects exactly two arguments"
    "typecheck: atomic update expects exactly two arguments"))

(define (tc-atomic-check-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [value : ast.AstExpr]
  [elem : ast.AstType]
  [message : String]) : ResultTcUnit
  (match (tc-expr-with-expected-or-actual ctx env value elem)
    [(ResultTcType.Ok value-ty) (tc-expect value-ty elem message)]
    [(ResultTcType.Err message) (ResultTcUnit.Err message)]))

(define (tc-atomic-one-arg-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [ptr : ast.AstExpr]
  [rest : ast.AstExprList]) : ResultTcType
  (if (ast.ast-expr-list-empty? (& rest))
    (match (tc-expr ctx env ptr)
      [(ResultTcType.Ok ptr-ty)
        (match (tc-atomic-pointer-elem ctx name ptr-ty)
          [(ResultTcType.Ok elem) (ResultTcType.Ok elem)]
          [(ResultTcType.Err message) (ResultTcType.Err message)])]
      [(ResultTcType.Err message) (ResultTcType.Err message)])
    (ResultTcType.Err (tc-atomic-load-arity-message name))))

(define (tc-atomic-two-arg-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [ptr : ast.AstExpr]
  [value : ast.AstExpr]
  [rest : ast.AstExprList]) : ResultTcType
  (if (ast.ast-expr-list-empty? (& rest))
    (match (tc-expr ctx env ptr)
      [(ResultTcType.Ok ptr-ty)
        (match (tc-atomic-pointer-elem ctx name ptr-ty)
          [(ResultTcType.Ok elem)
            (match (tc-atomic-check-value
              ctx
              env
              value
              elem
              (tc-atomic-value-mismatch-message name))
              [(ResultTcUnit.Ok)
                (if (tc-atomic-store-name? name)
                  (ResultTcType.Ok (ast.AstType.Unit))
                  (if (string.eq name "atomic-add!")
                    (ResultTcType.Ok (ast.AstType.Unit))
                    (ResultTcType.Ok elem)))]
              [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
          [(ResultTcType.Err message) (ResultTcType.Err message)])]
      [(ResultTcType.Err message) (ResultTcType.Err message)])
    (ResultTcType.Err (tc-atomic-update-arity-message name))))

(define (tc-atomic-cas-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ptr : ast.AstExpr]
  [expected : ast.AstExpr]
  [new-value : ast.AstExpr]
  [rest : ast.AstExprList]) : ResultTcType
  (if (ast.ast-expr-list-empty? (& rest))
    (match (tc-expr ctx env ptr)
      [(ResultTcType.Ok ptr-ty)
        (match (tc-atomic-pointer-elem ctx "atomic-cas!" ptr-ty)
          [(ResultTcType.Ok elem)
            (match (tc-atomic-check-value
              ctx
              env
              expected
              elem
              "typecheck: atomic expected value type mismatch")
              [(ResultTcUnit.Ok)
                (match (tc-atomic-check-value
                  ctx
                  env
                  new-value
                  elem
                  "typecheck: atomic new value type mismatch")
                  [(ResultTcUnit.Ok) (ResultTcType.Ok elem)]
                  [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
          [(ResultTcType.Err message) (ResultTcType.Err message)])]
      [(ResultTcType.Err message) (ResultTcType.Err message)])
    (ResultTcType.Err "typecheck: atomic-cas! expects exactly three arguments")))

(define (tc-atomic-nonload-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [ptr : ast.AstExpr]
  [tail0 : ast.AstExprList]) : ResultTcType
  (if (> tail0.len 0)
    (let
      [value : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& tail0) 0 0))]
      [tail1 : ast.AstExprList (ast.ast-expr-list-tail-from-ref (& tail0) 1)]
      (if (tc-atomic-cas-name? name)
        (if (> tail1.len 0)
          (tc-atomic-cas-call
            ctx
            env
            ptr
            value
            (tc-context-expr-get ctx (ast.ast-expr-list-get (& tail1) 0 0))
            (ast.ast-expr-list-tail-from-ref (& tail1) 1))
          (ResultTcType.Err
            "typecheck: atomic-cas! expects exactly three arguments"))
        (tc-atomic-two-arg-call ctx env name ptr value tail1)))
    (ResultTcType.Err
      (if (tc-atomic-cas-name? name)
        "typecheck: atomic-cas! expects exactly three arguments"
        (tc-atomic-update-arity-message name)))))

(define (tc-atomic-pointer-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [args : ast.AstExprList]) : ResultTcType
  (match (tc-require-unsafe ctx env name)
    [(ResultTcUnit.Ok)
      (if (> args.len 0)
        (let
          [ptr : ast.AstExpr
            (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
          [tail0 : ast.AstExprList (ast.ast-expr-list-tail-from-ref (& args) 1)]
          (if (tc-atomic-load-name? name)
            (tc-atomic-one-arg-call ctx env name ptr tail0)
            (tc-atomic-nonload-call ctx env name ptr tail0)))
        (ResultTcType.Err
          (if (tc-atomic-load-name? name)
            (tc-atomic-load-arity-message name)
            (if (tc-atomic-cas-name? name)
              "typecheck: atomic-cas! expects exactly three arguments"
              (tc-atomic-update-arity-message name)))))]
    [(ResultTcUnit.Err message) (ResultTcType.Err message)]))

(define (tc-ptr-addr-of-local-lookup [env : TcTypeEnv] [name-id : i64]) : ResultTcType
  (match (tc-type-env-spine-step env)
    [(TcTypeEnvSpineStep.Done)
      (ResultTcType.Err
        "typecheck: ptr-addr-of requires a local or parameter name")]
    [(TcTypeEnvSpineStep.Cache rest-env)
      (tc-ptr-addr-of-local-lookup rest-env name-id)]
    [(TcTypeEnvSpineStep.Bind key ty rest-env)
      (if (= key (tc-hygiene-global-boundary-id))
        (ResultTcType.Err
          "typecheck: ptr-addr-of requires a local, parameter, or global name")
        (if (= key name-id)
          (ResultTcType.Ok ty)
          (tc-ptr-addr-of-local-lookup rest-env name-id)))]))

(define (tc-ptr-addr-of-root-type [ctx : TcContext] [ty : ast.AstType]) : ResultTcType
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(ast.AstType.Ref _ _)
      (ResultTcType.Err
        "typecheck: ptr-addr-of reference roots are not addressable")]
    [(ast.AstType.MutRef _ _)
      (ResultTcType.Err
        "typecheck: ptr-addr-of reference roots are not addressable")]
    [_ (ResultTcType.Ok ty)]))

(define (tc-ptr-addr-of-place
  [ctx : TcContext]
  [env : TcTypeEnv]
  [place : ast.AstExpr]) : ResultTcType
  (match (ast.ast-expr-unspan place)
    [(ast.AstExpr.Var name)
      (match (tc-ptr-addr-of-local-lookup env name)
        [(ResultTcType.Ok ty) (tc-ptr-addr-of-root-type ctx ty)]
        [(ResultTcType.Err _)
          (match (tc-expr ctx env place)
            [(ResultTcType.Ok ty) (tc-ptr-addr-of-root-type ctx ty)]
            [(ResultTcType.Err message) (ResultTcType.Err message)])])]
    [(ast.AstExpr.StructGet receiver-box field)
      (let
        [receiver : ast.AstExpr (tc-context-expr-get ctx receiver-box)]
        (match (tc-ptr-addr-of-place ctx env receiver)
          [(ResultTcType.Ok receiver-ty)
            (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
              [(ast.AstType.Struct _)
                (tc-struct-get-result-type-id ctx receiver-ty field)]
              [(ast.AstType.StructArgs _ _)
                (tc-struct-get-result-type-id ctx receiver-ty field)]
              [_
                (ResultTcType.Err
                  "typecheck: ptr-addr-of requires a local/parameter, dotted field, or fixed-array array-ref place")])]
          [(ResultTcType.Err message) (ResultTcType.Err message)]))]
    [(ast.AstExpr.ArrayRef array-box index-box)
      (match (tc-expr-with-expected-or-actual-id
        ctx
        env
        index-box
        (ast.AstType.I64))
        [(ResultTcType.Ok index-ty)
          (if (tc-integer-type? index-ty)
            (let
              [array : ast.AstExpr (tc-context-expr-get ctx array-box)]
              (match (tc-ptr-addr-of-place ctx env array)
                [(ResultTcType.Ok array-ty)
                  (match (tc-type-strip-region (tc-resolve-type ctx array-ty))
                    [(ast.AstType.Array elem-ty _)
                      (ResultTcType.Ok (ast.ty-node-get elem-ty))]
                    [(ast.AstType.DynArray _)
                      (ResultTcType.Err
                        "typecheck: ptr-addr-of dynamic array elements are not addressable; use array-data plus ptr-offset")]
                    [_
                      (ResultTcType.Err
                        "typecheck: ptr-addr-of requires a local/parameter, dotted field, or fixed-array array-ref place")])]
                [(ResultTcType.Err message) (ResultTcType.Err message)]))
            (ResultTcType.Err "typecheck: array index must be integer"))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [_
      (ResultTcType.Err
        "typecheck: ptr-addr-of requires a local/parameter, dotted field, or fixed-array array-ref place")]))

(define (tc-require-unsafe [ctx : TcContext] [env : TcTypeEnv] [name : String]) : ResultTcUnit
  (if (tc-in-unsafe? env)
    (begin
      (tc-unused-unsafe-mark-current-used!
        (tc-job-state-unused-unsafe (tc-context-job-state ctx)))
      ResultTcUnit.Ok)
    (ResultTcUnit.Err
      (str_cat.str-cat "typecheck: " name " requires unsafe context"))))

(define (tc-dyn-array-elem-list-supported?
  [env : TcTypeEnv]
  [types : ast.AstTypeList]) : bool
  (tc-dyn-array-elem-list-supported-at? env (& types) 0))

(define (tc-dyn-array-elem-list-supported-at?
  [env : TcTypeEnv]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    true
    (if (tc-dyn-array-elem-supported?
      env
      (ast.ty-node-get
        (ast.ast-type-list-get types index (ast.ast-type-id-fallback))))
      (tc-dyn-array-elem-list-supported-at? env types (+ index 1))
      false)))

(define (tc-dyn-array-elem-supported? [env : TcTypeEnv] [ty : ast.AstType]) : bool
  (if (tc-integer-type? ty)
    true
    (match (tc-type-strip-region ty)
      [(ast.AstType.Bool) true]
      [(ast.AstType.Char) true]
      [(ast.AstType.F64) true]
      [(ast.AstType.F32) true]
      [(ast.AstType.String) true]
      [(ast.AstType.Enum _) true]
      [(ast.AstType.EnumArgs _ _) true]
      [(ast.AstType.Struct _) true]
      [(ast.AstType.StructArgs _ _) true]
      [(ast.AstType.DynArray _) true]
      [(ast.AstType.Tuple elems)
        (tc-dyn-array-elem-list-supported? env (__tl-box-place elems))]
      [(ast.AstType.Ref _ _)
        (tc-reference-lifetimes-visible?
          env
          (tc-type-collect-reference-lifetimes ty))]
      [_ false])))

(define (tc-spmd-varying? [class : TcSpmdClass]) : bool
  (match class
    [(TcSpmdClass.Uniform) false]
    [(TcSpmdClass.Varying) true]))

(define (tc-spmd-merge-class [a : TcSpmdClass] [b : TcSpmdClass]) : TcSpmdClass
  (if (tc-spmd-varying? a)
    TcSpmdClass.Varying
    (if (tc-spmd-varying? b)
      TcSpmdClass.Varying
      TcSpmdClass.Uniform)))

(define (tc-spmd-varying-value-type-supported? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(ast.AstType.I64) true]
    [(ast.AstType.U64) true]
    [(ast.AstType.I32) true]
    [(ast.AstType.U32) true]
    [(ast.AstType.I16) true]
    [(ast.AstType.U16) true]
    [(ast.AstType.I8) true]
    [(ast.AstType.U8) true]
    [(ast.AstType.F64) true]
    [(ast.AstType.F32) true]
    [(ast.AstType.Bool) true]
    [_ false]))

(define (tc-spmd-varying-expr-type-supported? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(ast.AstType.Enum _) true]
    [(ast.AstType.EnumArgs _ _) true]
    [_ (tc-spmd-varying-value-type-supported? ty)]))

(define (tc-spmd-varying-enum-type-supported?
  [ctx : TcContext]
  [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(ast.AstType.Enum _) true]
    [(ast.AstType.EnumArgs _ _) true]
    [(ast.AstType.Var name)
      (match (tc-context-enum-variants-id ctx name (tc-env-key-name-text name))
        [(parser.ResultAstVariantDefList.Ok _) true]
        [(parser.ResultAstVariantDefList.Err _) false])]
    [_ false]))

(define (tc-spmd-lane-type-supported? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(ast.AstType.I64) true]
    [(ast.AstType.U64) true]
    [(ast.AstType.I32) true]
    [(ast.AstType.U32) true]
    [(ast.AstType.I16) true]
    [(ast.AstType.U16) true]
    [(ast.AstType.I8) true]
    [(ast.AstType.U8) true]
    [(ast.AstType.F64) true]
    [(ast.AstType.F32) true]
    [(ast.AstType.Bool) true]
    [_ false]))

(define (tc-spmd-broadcast-type-supported? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(ast.AstType.I64) true]
    [(ast.AstType.U64) true]
    [(ast.AstType.I32) true]
    [(ast.AstType.U32) true]
    [(ast.AstType.F64) true]
    [(ast.AstType.F32) true]
    [_ false]))

(define (tc-spmd-broadcast-type-message) : String
  "typecheck: spmd-broadcast value must have type i32, u32, i64, u64, f32, or f64; bool broadcast remains deferred")

(define (tc-spmd-shuffle-type-message) : String
  "typecheck: spmd-shuffle value must have type i32, u32, i64, u64, f32, or f64; bool shuffle remains deferred")

(define (tc-spmd-broadcast-finish
  [ctx : TcContext]
  [expr-ty : ast.AstType]
  [value-class : TcSpmdClass]
  [lane-ty : ast.AstType]
  [lane-class : TcSpmdClass]
  [lane-env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (if (tc-spmd-broadcast-type-supported? (tc-resolve-type ctx expr-ty))
    (match (tc-spmd-require-uniform
      lane-class
      "typecheck: spmd-broadcast lane must be uniform")
      [(ResultTcUnit.Ok)
        (match (tc-expect
          (tc-resolve-type ctx lane-ty)
          (ast.AstType.I64)
          "typecheck: spmd-broadcast lane must have type i64")
          [(ResultTcUnit.Ok) (tc-spmd-finish expr-ty value-class lane-env)]
          [(ResultTcUnit.Err message) (ResultTcSpmdExprInfo.Err message)])]
      [(ResultTcUnit.Err message) (ResultTcSpmdExprInfo.Err message)])
    (ResultTcSpmdExprInfo.Err (tc-spmd-broadcast-type-message))))

(define (tc-spmd-shuffle-finish
  [ctx : TcContext]
  [expr-ty : ast.AstType]
  [value-class : TcSpmdClass]
  [lane-ty : ast.AstType]
  [lane-env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (if (tc-spmd-broadcast-type-supported? (tc-resolve-type ctx expr-ty))
    (match (tc-expect
      (tc-resolve-type ctx lane-ty)
      (ast.AstType.I64)
      "typecheck: spmd-shuffle lane must have type i64")
      [(ResultTcUnit.Ok) (tc-spmd-finish expr-ty value-class lane-env)]
      [(ResultTcUnit.Err message) (ResultTcSpmdExprInfo.Err message)])
    (ResultTcSpmdExprInfo.Err (tc-spmd-shuffle-type-message))))

(define (tc-spmd-finish
  [ty : ast.AstType]
  [class : TcSpmdClass]
  [env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (if (and
    (tc-spmd-varying? class)
    (not (tc-spmd-varying-expr-type-supported? ty)))
    (ResultTcSpmdExprInfo.Err
      (str_cat.str-cat
        "typecheck: foreach varying value type is not supported: "
        (tc-type-render (tc-type-strip-region ty))))
    (ResultTcSpmdExprInfo.Ok (TcSpmdExprInfo ty class env))))

(define (tc-spmd-finish-ctx
  [ctx : TcContext]
  [ty : ast.AstType]
  [class : TcSpmdClass]
  [env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (let
    [resolved : ast.AstType (tc-resolve-type ctx ty)]
    (if (and
      (tc-spmd-varying? class)
      (tc-spmd-varying-enum-type-supported? ctx resolved))
      (ResultTcSpmdExprInfo.Ok (TcSpmdExprInfo resolved class env))
      (tc-spmd-finish resolved class env))))

(define (tc-spmd-finish-lane
  [ctx : TcContext]
  [ty : ast.AstType]
  [class : TcSpmdClass]
  [env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (let
    [resolved : ast.AstType (tc-resolve-type ctx ty)]
    [supported-enum : bool (tc-spmd-varying-enum-type-supported? ctx resolved)]
    (if (and
      (tc-spmd-varying? class)
      (not (tc-spmd-lane-type-supported? resolved))
      (not supported-enum))
      (ResultTcSpmdExprInfo.Err
        (str_cat.str-cat
          "typecheck: foreach varying array lane type is not supported: "
          (tc-type-render (tc-type-strip-region resolved))))
      (if (and (tc-spmd-varying? class) supported-enum)
        (ResultTcSpmdExprInfo.Ok (TcSpmdExprInfo resolved class env))
        (tc-spmd-finish-ctx ctx resolved class env)))))

(define (tc-spmd-cpuid-like
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : ast.AstType]
  [leaf : ast.AstExpr]
  [subleaf : ast.AstExpr]) : ResultTcSpmdExprInfo
  (match (tc-spmd-expr ctx expr-bases env spmd-env leaf)
    [(ResultTcSpmdExprInfo.Ok leaf-info)
      (match leaf-info
        [(TcSpmdExprInfo _ leaf-class leaf-env)
          (match (tc-spmd-expr ctx expr-bases env leaf-env subleaf)
            [(ResultTcSpmdExprInfo.Ok subleaf-info)
              (match subleaf-info
                [(TcSpmdExprInfo _ subleaf-class subleaf-env)
                  (tc-spmd-finish
                    expr-ty
                    (tc-spmd-merge-class leaf-class subleaf-class)
                    subleaf-env)])]
            [(ResultTcSpmdExprInfo.Err message)
              (ResultTcSpmdExprInfo.Err message)])])]
    [(ResultTcSpmdExprInfo.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-binding
  [name-id : i64]
  [ty : ast.AstType]
  [class : TcSpmdClass]
  [scope : TcSpmdScope]
  [role : TcSpmdRole]) : TcSpmdBinding
  (TcSpmdBinding name-id ty class scope role))

(define (tc-spmd-env-binding-count [env : TcTypeEnv]) : i64
  (match (tc-type-env-spine-step env)
    [(TcTypeEnvSpineStep.Done) 0]
    [(TcTypeEnvSpineStep.Cache rest-env) (tc-spmd-env-binding-count rest-env)]
    [(TcTypeEnvSpineStep.Bind _ _ rest-env)
      (+ 1 (tc-spmd-env-binding-count rest-env))]))

(define (tc-spmd-env-fill-from-type-env
  [env : TcTypeEnv]
  [bindings : (__tl_dyn-array TcSpmdBinding)]
  [index : i64]) : unit
  (match (tc-type-env-spine-step env)
    [(TcTypeEnvSpineStep.Done) unit]
    [(TcTypeEnvSpineStep.Cache rest-env)
      (tc-spmd-env-fill-from-type-env rest-env bindings index)]
    [(TcTypeEnvSpineStep.Bind name-id ty rest-env)
      (begin
        (set!
          (array-ref bindings index)
          (tc-spmd-binding
            name-id
            ty
            TcSpmdClass.Uniform
            TcSpmdScope.Outer
            TcSpmdRole.Value))
        (tc-spmd-env-fill-from-type-env rest-env bindings (- index 1)))]))

(define (tc-spmd-env-from-type-env [env : TcTypeEnv]) : TcSpmdEnv
  (let
    [count : i64 (tc-spmd-env-binding-count env)]
    [bindings : (__tl_dyn-array TcSpmdBinding)
      (array.make-array TcSpmdBinding count)]
    (begin
      (tc-spmd-env-fill-from-type-env env bindings (- count 1))
      (TcSpmdEnv bindings count))))

(define (tc-spmd-env-bindings [env : TcSpmdEnv]) : (__tl_dyn-array
    TcSpmdBinding)
  env.bindings)

(define (tc-spmd-env-len [env : TcSpmdEnv]) : i64
  env.len)

(define (tc-spmd-env-mark [env : TcSpmdEnv]) : TcSpmdEnvMark
  (TcSpmdEnvMark (tc-spmd-env-len env)))

(define (tc-spmd-env-restore [env : TcSpmdEnv] [mark : TcSpmdEnvMark]) : TcSpmdEnv
  (let
    [mark-len : i64 mark.len]
    [current-len : i64 (tc-spmd-env-len env)]
    [restored-len : i64
      (if (< mark-len 0)
        0
        (if (> mark-len current-len)
          current-len
          mark-len))]
    (TcSpmdEnv (tc-spmd-env-bindings env) restored-len)))

(define (tc-spmd-env-copy-bindings
  [dst : (__tl_dyn-array TcSpmdBinding)]
  [src : (__tl_dyn-array TcSpmdBinding)]
  [index : i64]
  [count : i64]) : unit
  (if (>= index count)
    unit
    (begin
      (set! (array-ref dst index) (array-ref src index))
      (tc-spmd-env-copy-bindings dst src (+ index 1) count))))

(define (tc-spmd-env-bind-id
  [env : TcSpmdEnv]
  [name-id : i64]
  [ty : ast.AstType]
  [class : TcSpmdClass]
  [scope : TcSpmdScope]) : TcSpmdEnv
  (tc-spmd-env-bind-role-id env name-id ty class scope TcSpmdRole.Value))

(define (tc-spmd-env-bind-role-id
  [env : TcSpmdEnv]
  [name-id : i64]
  [ty : ast.AstType]
  [class : TcSpmdClass]
  [scope : TcSpmdScope]
  [role : TcSpmdRole]) : TcSpmdEnv
  (let
    [old-len : i64 (tc-spmd-env-len env)]
    [old-bindings : (__tl_dyn-array TcSpmdBinding) (tc-spmd-env-bindings env)]
    [new-len : i64 (+ old-len 1)]
    [new-bindings : (__tl_dyn-array TcSpmdBinding)
      (array.make-array TcSpmdBinding new-len)]
    (begin
      (tc-spmd-env-copy-bindings new-bindings old-bindings 0 old-len)
      (set!
        (array-ref new-bindings old-len)
        (tc-spmd-binding name-id ty class scope role))
      (TcSpmdEnv new-bindings new-len))))

(define (tc-spmd-env-lookup-from
  [bindings : (__tl_dyn-array TcSpmdBinding)]
  [index : i64]
  [name-id : i64]) : TcSpmdLookup
  (if (< index 0)
    TcSpmdLookup.Missing
    (let
      [binding : TcSpmdBinding (array-ref bindings index)]
      (if (= binding.name name-id)
        (TcSpmdLookup.Found binding.ty binding.class binding.scope binding.role)
        (tc-spmd-env-lookup-from bindings (- index 1) name-id)))))

(define (tc-spmd-env-lookup-id [env : TcSpmdEnv] [name-id : i64]) : TcSpmdLookup
  (tc-spmd-env-lookup-from
    (tc-spmd-env-bindings env)
    (- (tc-spmd-env-len env) 1)
    name-id))

(define (tc-spmd-env-has-local-from?
  [bindings : (__tl_dyn-array TcSpmdBinding)]
  [index : i64]
  [name-id : i64]) : bool
  (if (< index 0)
    false
    (let
      [binding : TcSpmdBinding (array-ref bindings index)]
      (if (= binding.name name-id)
        (match binding.scope
          [(TcSpmdScope.Local) true]
          [(TcSpmdScope.Outer)
            (tc-spmd-env-has-local-from? bindings (- index 1) name-id)])
        (tc-spmd-env-has-local-from? bindings (- index 1) name-id)))))

(define (tc-spmd-env-has-local-id? [env : TcSpmdEnv] [name-id : i64]) : bool
  (tc-spmd-env-has-local-from?
    (tc-spmd-env-bindings env)
    (- (tc-spmd-env-len env) 1)
    name-id))

(define (tc-spmd-env-has-outer-from?
  [bindings : (__tl_dyn-array TcSpmdBinding)]
  [index : i64]
  [name-id : i64]) : bool
  (if (< index 0)
    false
    (let
      [binding : TcSpmdBinding (array-ref bindings index)]
      (if (= binding.name name-id)
        (match binding.scope
          [(TcSpmdScope.Outer) true]
          [(TcSpmdScope.Local)
            (tc-spmd-env-has-outer-from? bindings (- index 1) name-id)])
        (tc-spmd-env-has-outer-from? bindings (- index 1) name-id)))))

(define (tc-spmd-env-has-outer-id? [env : TcSpmdEnv] [name-id : i64]) : bool
  (tc-spmd-env-has-outer-from?
    (tc-spmd-env-bindings env)
    (- (tc-spmd-env-len env) 1)
    name-id))

(define (tc-spmd-env-local-index
  [bindings : (__tl_dyn-array TcSpmdBinding)]
  [index : i64]
  [name-id : i64]) : i64
  (if (< index 0)
    -1
    (let
      [binding : TcSpmdBinding (array-ref bindings index)]
      (if (= binding.name name-id)
        (match binding.scope
          [(TcSpmdScope.Local) index]
          [(TcSpmdScope.Outer)
            (tc-spmd-env-local-index bindings (- index 1) name-id)])
        (tc-spmd-env-local-index bindings (- index 1) name-id)))))

(define (tc-spmd-env-set-local-class-id
  [env : TcSpmdEnv]
  [name-id : i64]
  [class : TcSpmdClass]) : TcSpmdEnv
  (let
    [old-len : i64 (tc-spmd-env-len env)]
    [old-bindings : (__tl_dyn-array TcSpmdBinding) (tc-spmd-env-bindings env)]
    [local-index : i64
      (tc-spmd-env-local-index old-bindings (- old-len 1) name-id)]
    (if (< local-index 0)
      env
      (let
        [new-bindings : (__tl_dyn-array TcSpmdBinding)
          (array.make-array TcSpmdBinding old-len)]
        [old-binding : TcSpmdBinding (array-ref old-bindings local-index)]
        (begin
          (tc-spmd-env-copy-bindings new-bindings old-bindings 0 old-len)
          (set!
            (array-ref new-bindings local-index)
            (tc-spmd-binding
              old-binding.name
              old-binding.ty
              class
              old-binding.scope
              old-binding.role))
          (TcSpmdEnv new-bindings old-len))))))

(define (tc-spmd-env-pop [env : TcSpmdEnv] [count : i64]) : TcSpmdEnv
  (if (<= count 0)
    env
    (tc-spmd-env-restore env (TcSpmdEnvMark (- (tc-spmd-env-len env) count)))))

(define (tc-spmd-env-mark-outer-into
  [dst : (__tl_dyn-array TcSpmdBinding)]
  [src : (__tl_dyn-array TcSpmdBinding)]
  [index : i64]
  [count : i64]) : unit
  (if (>= index count)
    unit
    (let
      [binding : TcSpmdBinding (array-ref src index)]
      (begin
        (set!
          (array-ref dst index)
          (tc-spmd-binding
            binding.name
            binding.ty
            binding.class
            TcSpmdScope.Outer
            binding.role))
        (tc-spmd-env-mark-outer-into dst src (+ index 1) count)))))

(define (tc-spmd-env-mark-outer [env : TcSpmdEnv]) : TcSpmdEnv
  (let
    [old-len : i64 (tc-spmd-env-len env)]
    [old-bindings : (__tl_dyn-array TcSpmdBinding) (tc-spmd-env-bindings env)]
    [new-bindings : (__tl_dyn-array TcSpmdBinding)
      (array.make-array TcSpmdBinding old-len)]
    (begin
      (tc-spmd-env-mark-outer-into new-bindings old-bindings 0 old-len)
      (TcSpmdEnv new-bindings old-len))))

(define (tc-spmd-env-merge-binding-class
  [left : TcSpmdBinding]
  [right-bindings : (__tl_dyn-array TcSpmdBinding)]
  [right-len : i64]
  [index : i64]) : TcSpmdClass
  (if (>= index right-len)
    left.class
    (let
      [right : TcSpmdBinding (array-ref right-bindings index)]
      (tc-spmd-merge-class left.class right.class))))

(define (tc-spmd-env-merge-classes-into
  [dst : (__tl_dyn-array TcSpmdBinding)]
  [left-bindings : (__tl_dyn-array TcSpmdBinding)]
  [right-bindings : (__tl_dyn-array TcSpmdBinding)]
  [left-len : i64]
  [right-len : i64]
  [index : i64]) : unit
  (if (>= index left-len)
    unit
    (let
      [left : TcSpmdBinding (array-ref left-bindings index)]
      (begin
        (set!
          (array-ref dst index)
          (tc-spmd-binding
            left.name
            left.ty
            (tc-spmd-env-merge-binding-class
              left
              right-bindings
              right-len
              index)
            left.scope
            left.role))
        (tc-spmd-env-merge-classes-into
          dst
          left-bindings
          right-bindings
          left-len
          right-len
          (+ index 1))))))

(define (tc-spmd-env-merge-classes [left : TcSpmdEnv] [right : TcSpmdEnv]) : TcSpmdEnv
  (let
    [left-len : i64 (tc-spmd-env-len left)]
    [right-len : i64 (tc-spmd-env-len right)]
    [left-bindings : (__tl_dyn-array TcSpmdBinding) (tc-spmd-env-bindings left)]
    [right-bindings : (__tl_dyn-array TcSpmdBinding)
      (tc-spmd-env-bindings right)]
    [merged : (__tl_dyn-array TcSpmdBinding)
      (array.make-array TcSpmdBinding left-len)]
    (begin
      ;; Branch merge is index-aligned: both branches start from the same
      ;; snapshot and local lets restore to that mark before the merge.
      (tc-spmd-env-merge-classes-into
        merged
        left-bindings
        right-bindings
        left-len
        right-len
        0)
      (TcSpmdEnv merged left-len))))

(define (tc-type-env-raw-layout-smoke?) : bool
  (and
    (= (comptime (offset-of (type TcTypeEnvBinding) name-id)) 0)
    (= (comptime (offset-of (type TcTypeEnvBinding) ty)) 8)
    (= (comptime (offset-of (type TcTypeEnvBinding) parent)) 32)
    (= (comptime (offset-of (type TcTypeEnvStore) bindings)) 0)
    (= (comptime (offset-of (type TcTypeEnvStore) binding-capacity)) 8)
    (= (comptime (offset-of (type TcTypeEnvStore) binding-len)) 16)
    (=
      (comptime
        (offset-of (type TcTypeEnvStore) topenv-membership-state-address))
      56)
    (= (comptime (offset-of (type TcTypeEnvStore) chain-state)) 64)
    (=
      (comptime (offset-of (type TcTypeEnvStore) structural-session-address))
      72)
    ;; The structural top-env index reads these four through raw word offsets,
    ;; so they must stay first and stay one word wide.
    (= (comptime (offset-of (type TcTypeEnvCache) chain-depth)) 0)
    (= (comptime (offset-of (type TcTypeEnvCache) chain-seq)) 8)
    (= (comptime (offset-of (type TcTypeEnvCache) chain-jumps)) 16)
    (= (comptime (offset-of (type TcTypeEnvCache) chain-prev)) 24)))

(define (tc-type-env-owner-arena-smoke?) : bool
  (let
    [base-id : i64 (ci.intern "owner-arena-base")]
    [filler-id : i64 (ci.intern "owner-arena-filler")]
    [home : i64 (arena.tl_arena_current)]
    [owner : i64 (arena.tl_arena_make_small)]
    [scratch : i64 (arena.tl_arena_make_small)]
    [_owner-current : unit
      (unsafe
        (arena.tl_arena_set owner))]
    [base : TcTypeEnv (tc-bind-id (tc-empty-env) base-id (ast.AstType.String))]
    [first-cache : TcTypeEnv (tc-env-with-cache base)]
    [grown : TcTypeEnv (TcTypeEnv base.store base.head 0)]
    [latest-cache : TcTypeEnv (TcTypeEnv first-cache.store first-cache.head 0)]
    [index : i64 0]
    [cache-index : i64 0]
    [binding-restored? : bool false]
    [latest-cache-valid? : bool false]
    (begin
      (unsafe
        (arena.tl_arena_set scratch))
      ;; Extend a store created in `owner` while an unrelated scratch arena is
      ;; current. Segment allocation must use the store owner and restore the
      ;; scratch arena before returning.
      (while (< index (+ (tc-type-env-binding-segment-capacity) 8))
        (begin
          (set! grown (tc-bind-id grown filler-id (ast.AstType.I64)))
          (set! index (+ index 1))))
      (set! binding-restored? (= (arena.tl_arena_current) scratch))
      ;; Exercise cache-segment rollover through the same owner switch. The
      ;; newer cache payloads intentionally live only until scratch is
      ;; destroyed; `first-cache` was built in owner and must remain valid.
      (while (< cache-index (+ (tc-type-env-cache-segment-capacity) 2))
        (begin
          (set! latest-cache (tc-env-with-cache grown))
          (set! cache-index (+ cache-index 1))))
      (set!
        latest-cache-valid?
        (match (tc-lookup-id latest-cache base-id)
          [(ResultTcType.Ok (ast.AstType.String)) true]
          [_ false]))
      (let
        [scratch-restored? : bool (= (arena.tl_arena_current) scratch)]
        (begin
          (unsafe
            (begin
              (arena.tl_arena_set home)
              (arena.tl_arena_destroy scratch)))
          ;; Destroying scratch must not invalidate either the retained
          ;; first-segment snapshot or the head in the later owner segment.
          (let
            [base-alive? : bool
              (match (tc-lookup-id base base-id)
                [(ResultTcType.Ok (ast.AstType.String)) true]
                [_ false])]
            [grown-alive? : bool
              (match (tc-lookup-id grown base-id)
                [(ResultTcType.Ok (ast.AstType.String)) true]
                [_ false])]
            [first-cache-alive? : bool
              (match (tc-lookup-id first-cache base-id)
                [(ResultTcType.Ok (ast.AstType.String)) true]
                [_ false])]
            (begin
              (unsafe
                (begin
                  (arena.tl_arena_set home)
                  (arena.tl_arena_destroy owner)))
              (and
                binding-restored?
                scratch-restored?
                latest-cache-valid?
                base-alive?
                grown-alive?
                first-cache-alive?))))))))

(define (tc-type-env-segmented-snapshot-smoke?) : bool
  (let
    [branch-id : i64 (ci.intern "branch")]
    [base : TcTypeEnv
      (tc-bind-id (tc-empty-env) (ci.intern "base") (ast.AstType.String))]
    [left : TcTypeEnv (tc-bind-id base branch-id (ast.AstType.I64))]
    [right : TcTypeEnv (tc-bind-id base branch-id (ast.AstType.Bool))]
    [left-cached : TcTypeEnv (tc-env-with-cache left)]
    [right-cached : TcTypeEnv (tc-env-with-cache right)]
    [segment-id : i64 (ci.intern "segment-base")]
    [segment-base : TcTypeEnv
      (tc-bind-id (tc-empty-env) segment-id (ast.AstType.String))]
    [segment-grown : TcTypeEnv
      (TcTypeEnv segment-base.store segment-base.head 0)]
    [segment-index : i64 0]
    [cache-segment-id : i64 (ci.intern "cache-segment-base")]
    [cache-segment-base : TcTypeEnv
      (tc-bind-id (tc-empty-env) cache-segment-id (ast.AstType.String))]
    [cache-segment-first : TcTypeEnv (tc-env-with-cache cache-segment-base)]
    [cache-segment-latest : TcTypeEnv
      (TcTypeEnv cache-segment-first.store cache-segment-first.head 0)]
    [cache-segment-index : i64 0]
    [env : TcTypeEnv
      (tc-bind-return-type
        (tc-bind-id
          (tc-bind-id
            (tc-push-region-id (tc-empty-env) (ci.intern "arena"))
            (ci.intern "x")
            (ast.AstType.I64))
          (ci.intern "x")
          (ast.AstType.Bool))
        (ast.AstType.I64))]
    [cached : TcTypeEnv (tc-env-with-cache env)]
    (begin
      ;; Force more than one binding segment, then branch from the retained
      ;; first-segment snapshot after the store has advanced.
      (while (< segment-index (+ (tc-type-env-binding-segment-capacity) 8))
        (begin
          (set!
            segment-grown
            (tc-bind-id
              segment-grown
              (ci.intern
                (str_cat.str-cat "segment-" (string.int->string segment-index)))
              (ast.AstType.I64)))
          (set! segment-index (+ segment-index 1))))
      (while (< cache-segment-index (+ (tc-type-env-cache-segment-capacity) 2))
        (begin
          (set!
            cache-segment-latest
            (tc-env-with-cache
              (tc-bind-id
                cache-segment-base
                (ci.intern
                  (str_cat.str-cat
                    "cache-segment-"
                    (string.int->string cache-segment-index)))
                (ast.AstType.I64))))
          (set! cache-segment-index (+ cache-segment-index 1))))
      (let
        [segment-sibling : TcTypeEnv
          (tc-bind-id segment-base segment-id (ast.AstType.Bool))]
        (and
          (tc-type-env-raw-layout-smoke?)
          (tc-type-env-owner-arena-smoke?)
          (match (tc-lookup-id base branch-id)
            [(ResultTcType.Err _) true]
            [_ false])
          (match (tc-lookup-id left branch-id)
            [(ResultTcType.Ok (ast.AstType.I64)) true]
            [_ false])
          (match (tc-lookup-id right branch-id)
            [(ResultTcType.Ok (ast.AstType.Bool)) true]
            [_ false])
          (match (tc-lookup-id left-cached branch-id)
            [(ResultTcType.Ok (ast.AstType.I64)) true]
            [_ false])
          (match (tc-lookup-id right-cached branch-id)
            [(ResultTcType.Ok (ast.AstType.Bool)) true]
            [_ false])
          (match (tc-lookup-id segment-base segment-id)
            [(ResultTcType.Ok (ast.AstType.String)) true]
            [_ false])
          (match (tc-lookup-id segment-grown segment-id)
            [(ResultTcType.Ok (ast.AstType.String)) true]
            [_ false])
          (match (tc-lookup-id segment-sibling segment-id)
            [(ResultTcType.Ok (ast.AstType.Bool)) true]
            [_ false])
          (match (tc-lookup-id cache-segment-first cache-segment-id)
            [(ResultTcType.Ok (ast.AstType.String)) true]
            [_ false])
          (match (tc-lookup-id cache-segment-latest cache-segment-id)
            [(ResultTcType.Ok (ast.AstType.String)) true]
            [_ false])
          (= (tc-env-cache-count cached) 4)
          (match (tc-lookup-id cached (ci.intern "x"))
            [(ResultTcType.Ok (ast.AstType.Bool)) true]
            [_ false])
          (match (tc-current-return-type env)
            [(ResultTcType.Ok (ast.AstType.I64)) true]
            [_ false])
          (match (tc-active-region env)
            [(TcMaybeNameId.Some region) (= region (ci.intern "arena"))]
            [_ false])
          (tc-lifetime-visible-id? env (ci.intern "arena")))))))

(test
  tc-type-env-segmented-snapshots
  (if (tc-type-env-segmented-snapshot-smoke?)
    unit
    (io.panic "typecheck: segmented environment snapshot smoke failed")))

(define (tc-type-env-cache-head? [env : TcTypeEnv]) : bool
  (match (tc-type-env-view env)
    [(TcTypeEnvView.Cache _ _ _ _ _) true]
    [_ false]))

(define (tc-type-env-cache-partial-head? [env : TcTypeEnv]) : bool
  (match (tc-type-env-view env)
    [(TcTypeEnvView.Cache _ _ partial _ _) partial]
    [_ false]))

(define (tc-type-env-bind-many [env : TcTypeEnv] [count : i64]) : TcTypeEnv
  (let
    [i : i64 0]
    [out : TcTypeEnv env]
    (begin
      (while (< i count)
        (begin
          (set!
            out
            (tc-bind-id
              out
              (ci.intern (str_cat.str-cat "local" (string.int->string i)))
              (ast.AstType.I64)))
          (set! i (+ i 1))))
      out)))

(defstruct TcTypeEnvBindManyEndpoints
  (env TcTypeEnv)
  (first-id i64)
  (last-id i64))

(define (tc-type-env-bind-many-endpoints [env : TcTypeEnv] [count : i64]) : TcTypeEnvBindManyEndpoints
  (let
    [i : i64 0]
    [out : TcTypeEnv env]
    [first-id : i64 -1]
    [last-id : i64 -1]
    (begin
      (while (< i count)
        (let
          [name-id : i64
            (ci.intern (str_cat.str-cat "local" (string.int->string i)))]
          (begin
            (if (= i 0)
              (set! first-id name-id)
              unit)
            (set! last-id name-id)
            (set! out (tc-bind-id out name-id (ast.AstType.I64)))
            (set! i (+ i 1)))))
      (TcTypeEnvBindManyEndpoints out first-id last-id))))

(define (tc-type-env-local-cache-behavior-smoke?) : bool
  (let
    [base : TcTypeEnv
      (tc-env-with-cache
        (tc-bind-id (tc-empty-env) (ci.intern "global") (ast.AstType.String)))]
    [marked : TcTypeEnv
      (tc-bind-return-type
        (tc-bind-unsafe-id
          (tc-push-region-id base (ci.intern "arena"))
          (ci.intern "danger")
          (ast.AstType.I64))
        (ast.AstType.I64))]
    [shadowed : TcTypeEnv
      (tc-bind-id
        (tc-bind-id marked (ci.intern "shadow") (ast.AstType.I64))
        (ci.intern "shadow")
        (ast.AstType.Bool))]
    [cached : TcTypeEnv
      (tc-type-env-bind-many shadowed (- (tc-local-cache-threshold) 6))]
    (and
      (tc-type-env-cache-head? cached)
      (match (tc-lookup-id cached (ci.intern "shadow"))
        [(ResultTcType.Ok (ast.AstType.Bool)) true]
        [_ false])
      (match (tc-lookup-id cached (ci.intern "global"))
        [(ResultTcType.Ok (ast.AstType.String)) true]
        [_ false])
      (match (tc-lookup-unsafe-id cached (ci.intern "danger"))
        [(ResultTcTypeUnsafe.Ok (ast.AstType.I64) unsafe) unsafe]
        [_ false])
      (match (tc-lookup-id cached (ci.intern "missing"))
        [(ResultTcType.Err message)
          (string.eq message "typecheck: unbound name missing")]
        [_ false])
      (match (tc-current-return-type cached)
        [(ResultTcType.Ok (ast.AstType.I64)) true]
        [_ false])
      (match (tc-active-region cached)
        [(TcMaybeNameId.Some region) (= region (ci.intern "arena"))]
        [_ false])
      (tc-lifetime-visible-id? cached (ci.intern "shadow")))))

(define (tc-type-env-local-cache-default-shadow-smoke?) : bool
  (let
    [base : TcTypeEnv (tc-env-with-cache (tc-default-env))]
    [shadowed : TcTypeEnv
      (tc-bind-id
        base
        (ci.intern "__tl_string_length")
        (tc-fn1 (ast.AstType.I64) (ast.AstType.I64)))]
    [cached : TcTypeEnv
      (tc-type-env-bind-many shadowed (- (tc-local-cache-threshold) 1))]
    (and
      (tc-type-env-cache-head? cached)
      (not
        (tc-default-builtin-unshadowed-id?
          cached
          cbi.compiler-builtin-id-tl-private-string-length)))))

(define (tc-type-env-local-cache-partial-layer-smoke?) : bool
  (let
    [base : TcTypeEnv
      (tc-env-with-cache
        (tc-bind-id (tc-empty-env) (ci.intern "global") (ast.AstType.String)))]
    [layer1 : TcTypeEnv (tc-type-env-bind-many base (tc-local-cache-threshold))]
    [older-shadow : TcTypeEnv
      (tc-bind-id layer1 (ci.intern "shadow") (ast.AstType.I64))]
    [layer2 : TcTypeEnv
      (tc-type-env-bind-many older-shadow (- (tc-local-cache-threshold) 1))]
    [newer-shadow : TcTypeEnv
      (tc-bind-id layer2 (ci.intern "shadow") (ast.AstType.Bool))]
    [layer3 : TcTypeEnv
      (tc-type-env-bind-many newer-shadow (- (tc-local-cache-threshold) 1))]
    (and
      (tc-type-env-cache-partial-head? layer1)
      (tc-type-env-cache-partial-head? layer2)
      (tc-type-env-cache-partial-head? layer3)
      (= (tc-env-partial-layer-depth layer3) 3)
      (match (tc-lookup-id layer3 (ci.intern "global"))
        [(ResultTcType.Ok (ast.AstType.String)) true]
        [_ false])
      (match (tc-lookup-id layer2 (ci.intern "shadow"))
        [(ResultTcType.Ok (ast.AstType.I64)) true]
        [_ false])
      (match (tc-lookup-id layer3 (ci.intern "shadow"))
        [(ResultTcType.Ok (ast.AstType.Bool)) true]
        [_ false]))))

(define (tc-type-env-local-cache-default-shadow-partial-miss-smoke?) : bool
  (let
    [base : TcTypeEnv (tc-env-with-cache (tc-default-env))]
    [shadowed : TcTypeEnv
      (tc-bind-id
        base
        (ci.intern "__tl_string_length")
        (tc-fn1 (ast.AstType.I64) (ast.AstType.I64)))]
    [shadow-layer : TcTypeEnv
      (tc-type-env-bind-many shadowed (- (tc-local-cache-threshold) 1))]
    [miss-layer : TcTypeEnv
      (tc-type-env-bind-many shadow-layer (tc-local-cache-threshold))]
    [clear-layer : TcTypeEnv
      (tc-type-env-bind-many base (tc-local-cache-threshold))]
    (and
      (tc-type-env-cache-partial-head? shadow-layer)
      (tc-type-env-cache-partial-head? miss-layer)
      (tc-type-env-cache-partial-head? clear-layer)
      (not
        (tc-default-builtin-unshadowed-id?
          shadow-layer
          cbi.compiler-builtin-id-tl-private-string-length))
      (not
        (tc-default-builtin-unshadowed-id?
          miss-layer
          cbi.compiler-builtin-id-tl-private-string-length))
      (tc-default-builtin-unshadowed-id?
        clear-layer
        cbi.compiler-builtin-id-tl-private-string-length))))

(define (tc-type-env-local-cache-depth-cap-smoke?) : bool
  (let
    [global-id : i64 (ci.intern "global")]
    [base : TcTypeEnv
      (tc-env-with-cache
        (tc-bind-id (tc-empty-env) global-id (ast.AstType.String)))]
    [bound : TcTypeEnvBindManyEndpoints
      (tc-type-env-bind-many-endpoints
        base
        (* (tc-local-cache-threshold) (+ (tc-local-cache-partial-layer-cap) 1)))]
    [deep : TcTypeEnv bound.env]
    [layered : TcTypeEnv (tc-env-with-cache-layer-over-explicit deep)]
    (and
      (tc-type-env-cache-head? deep)
      (tc-type-env-cache-partial-head? deep)
      (= (tc-env-partial-layer-depth deep) 1)
      (=
        (tc-env-partial-local-covered-count deep)
        (* (tc-local-cache-threshold) (+ (tc-local-cache-partial-layer-cap) 1)))
      (match (tc-type-env-view (tc-env-partial-local-base deep))
        [(TcTypeEnvView.Cache _ scan-through _ _ _) (not scan-through)]
        [_ false])
      (match (tc-lookup-id deep global-id)
        [(ResultTcType.Ok (ast.AstType.String)) true]
        [_ false])
      (match (tc-lookup-id deep bound.first-id)
        [(ResultTcType.Ok (ast.AstType.I64)) true]
        [_ false])
      (match (tc-lookup-id deep bound.last-id)
        [(ResultTcType.Ok (ast.AstType.I64)) true]
        [_ false])
      ;; Explicitly layering a module-sized prefix must flatten all partial
      ;; windows without absorbing the global cache below them.
      (match (tc-type-env-view layered)
        [(TcTypeEnvView.Cache _ scan-through _ _ _) (not scan-through)]
        [_ false])
      (tc-type-env-cache-partial-head? layered)
      (match (tc-lookup-id layered global-id)
        [(ResultTcType.Ok (ast.AstType.String)) true]
        [_ false])
      (match (tc-lookup-id layered bound.first-id)
        [(ResultTcType.Ok (ast.AstType.I64)) true]
        [_ false])
      (match (tc-lookup-id layered bound.last-id)
        [(ResultTcType.Ok (ast.AstType.I64)) true]
        [_ false]))))

;; Markers buried below MORE THAN ONE compaction window. The behavior
;; smoke above only crosses one threshold, so the head cache is unwrapped and
;; the markers are reached by the plain bind walk; with two stacked
;; compaction caches the scans must recurse through scan-through cache nodes
;; or the markers disappear (with-arena escape checking was silently disabled
;; past 32 local binds). Scans must still terminate at the explicit
;; non-scan-through base cache.
(define (tc-arena-phase-nested-structural-record-smoke?) : bool
  (let
    [owner-a : i64 (ci.intern "arena-phase-owner-a")]
    [owner-b : i64 (ci.intern "arena-phase-owner-b")]
    [token-a : i64 (ci.intern "arena-phase-token-a")]
    [token-b : i64 (ci.intern "arena-phase-token-b")]
    [base : TcTypeEnv (tc-empty-env)]
    [outer-markers : TcTypeEnv (tc-bind-arena-phase-token base token-a owner-a)]
    [outer : TcTypeEnv (tc-bind-id outer-markers token-a (ast.AstType.I64))]
    [outer-region : i64 (tc-arena-phase-region-id base owner-a token-a)]
    ;; Shadow the same phase token under a different owner, then nest a second
    ;; token under that owner. Persistent snapshots model the rewind boundary:
    ;; querying `outer` after constructing `inner` must recover outer records.
    [shadow-markers : TcTypeEnv
      (tc-bind-arena-phase-token outer token-a owner-b)]
    [shadow : TcTypeEnv (tc-bind-id shadow-markers token-a (ast.AstType.I64))]
    [shadow-region : i64 (tc-arena-phase-region-id base owner-b token-a)]
    [inner-markers : TcTypeEnv
      (tc-bind-arena-phase-token shadow token-b owner-b)]
    [inner : TcTypeEnv (tc-bind-id inner-markers token-b (ast.AstType.I64))]
    [inner-region : i64 (tc-arena-phase-region-id base owner-b token-b)]
    [deep : TcTypeEnv
      (tc-type-env-bind-many inner (+ (* (tc-local-cache-threshold) 2) 8))]
    [current-marker : i64
      (tc-arena-phase-current-region-marker-id base owner-b)]
    [owner-marker : i64 (tc-arena-phase-token-owner-marker-id base token-b)]
    [region-marker : i64 (tc-arena-phase-token-region-marker-id base token-b)]
    (and
      (not (= inner-region shadow-region))
      (not (= inner-region current-marker))
      (not (= current-marker owner-marker))
      (not (= owner-marker region-marker))
      (tc-arena-region-owned-by-id? deep owner-b inner-region)
      (not (tc-arena-region-owned-by-id? deep owner-a inner-region))
      (= (tc-current-arena-owner-region outer owner-a) outer-region)
      (= (tc-current-arena-owner-region shadow owner-b) shadow-region)
      (= (tc-current-arena-owner-region deep owner-b) inner-region)
      (match (tc-arena-phase-token-owner-active deep token-a)
        [(TcMaybeNameId.Some owner) (= owner owner-b)]
        [_ false])
      (match (tc-arena-phase-token-region-active deep token-a)
        [(TcMaybeNameId.Some region) (= region shadow-region)]
        [_ false])
      (match (tc-arena-phase-token-owner-active deep token-b)
        [(TcMaybeNameId.Some owner) (= owner owner-b)]
        [_ false])
      (match (tc-arena-phase-token-region-active deep token-b)
        [(TcMaybeNameId.Some region) (= region inner-region)]
        [_ false]))))

(define (tc-type-env-local-cache-deep-scan-smoke?) : bool
  (let
    [global-id : i64 (ci.intern "global")]
    [arena-id : i64 (ci.intern "arena")]
    [atomic-arena-id : i64 (ci.intern "atomic-arena")]
    [phase-id : i64 (ci.intern "phase")]
    [resource-id : i64 (ci.intern "resource")]
    [base : TcTypeEnv
      (tc-env-with-cache
        (tc-bind-id (tc-empty-env) global-id (ast.AstType.String)))]
    [phase-region-id : i64 (tc-arena-phase-region-id base arena-id phase-id)]
    [marked : TcTypeEnv
      (tc-bind-id
        (tc-bind-cleanup-owner
          (tc-bind-id
            (tc-bind-arena-phase-token
              (tc-bind-id
                (tc-bind-atomic-arena-owner
                  (tc-bind-id
                    (tc-bind-ordinary-arena-owner
                      (tc-bind-return-type
                        (tc-enter-unsafe (tc-push-region-id base arena-id))
                        (ast.AstType.I64))
                      arena-id)
                    arena-id
                    (ast.AstType.I64))
                  atomic-arena-id)
                atomic-arena-id
                (ast.AstType.I64))
              phase-id
              arena-id)
            phase-id
            (ast.AstType.I64))
          resource-id)
        resource-id
        (ast.AstType.String))]
    [deep : TcTypeEnv
      (tc-type-env-bind-many marked (+ (* (tc-local-cache-threshold) 2) 8))]
    [resource-shadow : TcTypeEnv
      (tc-bind-id deep resource-id (ast.AstType.Bool))]
    [shadow-layer : TcTypeEnv
      (tc-type-env-bind-many resource-shadow (- (tc-local-cache-threshold) 1))]
    [below-base : TcTypeEnv
      (tc-type-env-bind-many base (+ (* (tc-local-cache-threshold) 2) 8))]
    (and
      (match (tc-active-region deep)
        [(TcMaybeNameId.Some region) (= region arena-id)]
        [_ false])
      (match (tc-current-return-type deep)
        [(ResultTcType.Ok (ast.AstType.I64)) true]
        [_ false])
      (tc-in-unsafe? deep)
      (tc-ordinary-arena-owner-active-id? deep arena-id)
      (tc-atomic-arena-owner-active-id? deep atomic-arena-id)
      (match (tc-arena-phase-token-region-active deep phase-id)
        [(TcMaybeNameId.Some region) (= region phase-region-id)]
        [_ false])
      (match (tc-arena-phase-token-owner-active deep phase-id)
        [(TcMaybeNameId.Some owner) (= owner arena-id)]
        [_ false])
      (tc-string-list-contains (tc-active-cleanup-owners deep) "resource")
      (tc-lifetime-visible-id? deep arena-id)
      (tc-lifetime-visible-id? deep resource-id)
      (tc-lifetime-outlives-binding-id? deep arena-id resource-id)
      (not (tc-lifetime-outlives-binding-id? deep resource-id arena-id))
      (tc-lifetime-outlives-lifetime-id? deep arena-id resource-id)
      (not (tc-lifetime-outlives-lifetime-id? deep resource-id arena-id))
      (not (tc-cleanup-owner-active-id? shadow-layer resource-id))
      (tc-ordinary-arena-owner-active-id? shadow-layer arena-id)
      (tc-atomic-arena-owner-active-id? shadow-layer atomic-arena-id)
      (tc-region-outlives-or-matches deep arena-id arena-id)
      (match (tc-active-region below-base)
        [(TcMaybeNameId.No) true]
        [_ false])
      (not (tc-lifetime-visible-id? below-base (ci.intern "global"))))))

(define (tc-type-env-local-cache-c-abi-fnptr-smoke?) : bool
  (let
    [base : TcTypeEnv (tc-env-with-cache (tc-empty-env))]
    [callback-ty : ast.AstType (tc-fn0 (ast.AstType.I64))]
    [marked : TcTypeEnv
      (tc-bind-c-abi-fnptr-id base (ci.intern "callback") callback-ty)]
    [both : TcTypeEnv
      (tc-bind-unsafe-c-abi-fnptr-id
        marked
        (ci.intern "danger-callback")
        callback-ty)]
    [deep : TcTypeEnv
      (tc-type-env-bind-many both (+ (* (tc-local-cache-threshold) 2) 8))]
    (and
      (tc-binding-c-abi-fnptr-id? deep (ci.intern "callback"))
      (not (tc-binding-unsafe-id? deep (ci.intern "callback")))
      (tc-binding-c-abi-fnptr-id? deep (ci.intern "danger-callback"))
      (tc-binding-unsafe-id? deep (ci.intern "danger-callback"))
      (match (tc-lookup-unsafe-id deep (ci.intern "danger-callback"))
        [(ResultTcTypeUnsafe.Ok (ast.AstType.Func _ _) unsafe) unsafe]
        [_ false]))))

(cfg
  test
  (define (tc-source-leading-segment-scoped-result-is?
    [carrier : TcTypeEnvScopedCarrier]
    [name-id : i64]
    [prefix-id : i64]
    [expected : bool]) : bool
    (let
      [env : TcTypeEnv (tc-type-env-scoped-carrier-env carrier)]
      [runtime-save : TcTypeEnvScopedRuntimeSave
        (tc-type-env-scoped-runtime-enter! carrier)]
      [actual : bool
        (tc-source-leading-segment-wins-over-exact-id? env name-id prefix-id)]
      (begin
        (tc-type-env-scoped-runtime-restore! runtime-save)
        (= actual expected)))))

(cfg
  test
  (define (tc-source-leading-segment-raw-ordering-smoke?) : bool
    (let
      [module-id : i64 (ci.intern "dotted-order-module")]
      [base-name-id : i64 (ci.intern "dotted-order-a.b")]
      [name-id : i64 (ci.intern "dotted-order-module/dotted-order-a.b")]
      [prefix-id : i64 (ci.intern "dotted-order-module/dotted-order-a")]
      [structural-name-id : i64 (tc-env-name-key-id name-id)]
      [structural-prefix-id : i64 (tc-env-name-key-id prefix-id)]
      [layer-id : i64 (ci.intern "dotted-order-layer")]
      [exact-below : TcTypeEnv
        (tc-env-with-cache
          (tc-bind-id (tc-empty-env) name-id (ast.AstType.I64)))]
      [prefix-above : TcTypeEnv
        (tc-env-with-cache-layer-over-explicit
          (tc-bind-id exact-below prefix-id (ast.AstType.Bool)))]
      [prefix-below : TcTypeEnv
        (tc-env-with-cache
          (tc-bind-id (tc-empty-env) prefix-id (ast.AstType.Bool)))]
      [exact-above : TcTypeEnv
        (tc-env-with-cache-layer-over-explicit
          (tc-bind-id prefix-below name-id (ast.AstType.I64)))]
      [prefix-wins-tail : TcTypeEnv
        (tc-env-with-cache
          (tc-bind-id
            (tc-bind-id (tc-empty-env) name-id (ast.AstType.I64))
            prefix-id
            (ast.AstType.Bool)))]
      [prefix-wins-recursive-layer : TcTypeEnv
        (tc-env-with-cache-prefix-layer
          (tc-bind-id prefix-wins-tail layer-id (ast.AstType.Unit))
          1
          true
          prefix-wins-tail)]
      [exact-wins-tail : TcTypeEnv
        (tc-env-with-cache
          (tc-bind-id
            (tc-bind-id (tc-empty-env) prefix-id (ast.AstType.Bool))
            name-id
            (ast.AstType.I64)))]
      [exact-wins-recursive-layer : TcTypeEnv
        (tc-env-with-cache-prefix-layer
          (tc-bind-id exact-wins-tail layer-id (ast.AstType.Unit))
          1
          true
          exact-wins-tail)]
      [structural-exact-only : TcTypeEnv
        (tc-env-with-cache
          (tc-bind-id
            (tc-bind-id (tc-empty-env) prefix-id (ast.AstType.Bool))
            structural-name-id
            (ast.AstType.I64)))]
      [scoped-prefix-wins : TcTypeEnvScopedCarrier
        (tc-type-env-scoped-carrier-bind-id
          (tc-type-env-scoped-carrier-bind-id
            (tc-type-env-scoped-carrier-new)
            name-id
            (ast.AstType.I64))
          prefix-id
          (ast.AstType.Bool))]
      [scoped-exact-wins : TcTypeEnvScopedCarrier
        (tc-type-env-scoped-carrier-bind-id
          (tc-type-env-scoped-carrier-bind-id
            (tc-type-env-scoped-carrier-new)
            prefix-id
            (ast.AstType.Bool))
          name-id
          (ast.AstType.I64))]
      (and
        (ci.intern-qualified? name-id)
        (= (ci.intern-qualified-module-id name-id) module-id)
        (= (ci.intern-qualified-base-id name-id) base-name-id)
        (= (ci.intern-leading-dot-id name-id) prefix-id)
        (not (= structural-name-id name-id))
        (not (= structural-prefix-id prefix-id))
        (= structural-name-id (tc-module-name-id-by-id module-id base-name-id))
        (tc-type-env-cache-partial-head? prefix-above)
        (tc-type-env-cache-partial-head? exact-above)
        (tc-env-cache-explicit-head? prefix-above)
        (tc-env-cache-explicit-head? exact-above)
        (tc-source-leading-segment-wins-over-exact-persistent-id?
          prefix-above
          name-id
          prefix-id)
        (not
          (tc-source-leading-segment-wins-over-exact-persistent-id?
            exact-above
            name-id
            prefix-id))
        (tc-type-env-cache-partial-head? prefix-wins-recursive-layer)
        (tc-type-env-cache-partial-head? exact-wins-recursive-layer)
        (tc-source-leading-segment-wins-over-exact-persistent-id?
          prefix-wins-recursive-layer
          name-id
          prefix-id)
        (not
          (tc-source-leading-segment-wins-over-exact-persistent-id?
            exact-wins-recursive-layer
            name-id
            prefix-id))
        ;; This structural top-env key has the same source spelling as the raw
        ;; exact candidate, but it must not participate in local ordering.
        (tc-source-leading-segment-wins-over-exact-persistent-id?
          structural-exact-only
          name-id
          prefix-id)
        (tc-source-leading-segment-scoped-result-is?
          scoped-prefix-wins
          name-id
          prefix-id
          true)
        (tc-source-leading-segment-scoped-result-is?
          scoped-exact-wins
          name-id
          prefix-id
          false)
        ;; With no scoped candidates, ordering falls back to the persistent
        ;; tail, including its older partial-cache recursion path.
        (tc-source-leading-segment-scoped-result-is?
          (tc-type-env-scoped-carrier-from-env prefix-wins-recursive-layer)
          name-id
          prefix-id
          true)
        (tc-source-leading-segment-scoped-result-is?
          (tc-type-env-scoped-carrier-from-env exact-wins-recursive-layer)
          name-id
          prefix-id
          false)))))

(cfg
  test
  (define (tc-type-env-c-abi-fnptr-selected-key-smoke?) : bool
    (let
      [module-id : i64 (ci.intern "selected-key-module")]
      [name-id : i64 (ci.intern "selected-key-callback")]
      [qualified-id : i64
        (ci.intern "selected-key-module/selected-key-callback")]
      [structural-key : i64 (tc-module-name-id-by-id module-id name-id)]
      [normalized-key : i64 (tc-env-name-key-id qualified-id)]
      [local-id : i64 (ci.intern "selected-key-local")]
      [layer-id : i64 (ci.intern "selected-key-layer")]
      [callback-ty : ast.AstType (tc-fn0 (ast.AstType.I64))]
      [structural-base : TcTypeEnv
        (tc-env-with-cache
          (tc-bind-c-abi-fnptr-id (tc-empty-env) structural-key callback-ty))]
      [structural-layer : TcTypeEnv
        (tc-env-with-cache-layer-over-explicit
          (tc-bind-id structural-base layer-id (ast.AstType.Bool)))]
      [qualified-raw : TcTypeEnv
        (tc-env-with-cache
          (tc-bind-c-abi-fnptr-id (tc-empty-env) qualified-id callback-ty))]
      [local-raw : TcTypeEnv
        (tc-env-with-cache
          (tc-bind-c-abi-fnptr-id (tc-empty-env) local-id callback-ty))]
      [tail-carrier : TcTypeEnvScopedCarrier
        (tc-type-env-scoped-carrier-from-env structural-layer)]
      [scoped-carrier : TcTypeEnvScopedCarrier
        (tc-type-env-scoped-carrier-bind-unsafe-c-abi-fnptr-id
          (tc-type-env-scoped-carrier-from-env (tc-empty-env))
          structural-key
          callback-ty)]
      [was-active : bool (tc-type-env-scoped-runtime-active?)]
      [runtime-save : TcTypeEnvScopedRuntimeSave
        (tc-type-env-scoped-runtime-enter! tail-carrier)]
      [runtime-ok : bool
        (and
          (tc-binding-c-abi-fnptr-id? structural-layer structural-key)
          (not (tc-binding-c-abi-fnptr-id? structural-layer qualified-id)))]
      (begin
        (tc-type-env-scoped-runtime-restore! runtime-save)
        (and
          (not was-active)
          (ci.intern-qualified? qualified-id)
          (= structural-key normalized-key)
          (not (= structural-key qualified-id))
          (tc-env-cache-explicit-head? structural-layer)
          (tc-type-env-cache-partial-head? structural-layer)
          (tc-binding-c-abi-fnptr-id? structural-layer structural-key)
          (not (tc-binding-c-abi-fnptr-id? structural-layer qualified-id))
          (tc-binding-c-abi-fnptr-id? qualified-raw qualified-id)
          (not (tc-binding-c-abi-fnptr-id? qualified-raw normalized-key))
          (tc-binding-c-abi-fnptr-id? local-raw local-id)
          (tc-type-env-scoped-carrier-binding-c-abi-fnptr-id?
            tail-carrier
            structural-key)
          (not
            (tc-type-env-scoped-carrier-binding-c-abi-fnptr-id?
              tail-carrier
              qualified-id))
          (tc-type-env-scoped-carrier-binding-c-abi-fnptr-id?
            scoped-carrier
            structural-key)
          (not
            (tc-type-env-scoped-carrier-binding-c-abi-fnptr-id?
              scoped-carrier
              qualified-id))
          runtime-ok)))))

(cfg
  test
  (define (tc-type-env-explicit-cache-layering-lookup-smoke?) : bool
    (let
      [base-id : i64 (ci.intern "base")]
      [dup-id : i64 (ci.intern "dup")]
      [missing-id : i64 (ci.intern "missing")]
      [base : TcTypeEnv
        (tc-env-with-cache
          (tc-bind-id (tc-empty-env) base-id (ast.AstType.I64)))]
      [older : TcTypeEnv (tc-bind-id base dup-id (ast.AstType.I64))]
      [newer : TcTypeEnv (tc-bind-id older dup-id (ast.AstType.Bool))]
      [layer : TcTypeEnv (tc-env-with-cache-layer-over-explicit newer)]
      (and
        (= (tc-env-uncached-prefix-to-explicit-cache-count newer) 2)
        (tc-env-cache-explicit-head? layer)
        (tc-type-env-cache-partial-head? layer)
        (match (tc-lookup-id layer dup-id)
          [(ResultTcType.Ok (ast.AstType.Bool)) true]
          [_ false])
        (match (tc-lookup-id layer base-id)
          [(ResultTcType.Ok (ast.AstType.I64)) true]
          [_ false])
        (match (tc-lookup-id layer missing-id)
          [(ResultTcType.Err message)
            (string.eq message "typecheck: unbound name missing")]
          [_ false])))))

(cfg
  test
  (define (tc-type-env-explicit-cache-layering-flags-smoke?) : bool
    (let
      [callback-ty : ast.AstType (tc-fn0 (ast.AstType.I64))]
      [base-callback-id : i64 (ci.intern "base-callback")]
      [danger-callback-id : i64 (ci.intern "danger-callback")]
      [base : TcTypeEnv
        (tc-env-with-cache
          (tc-bind-c-abi-fnptr-id (tc-empty-env) base-callback-id callback-ty))]
      [layer-source : TcTypeEnv
        (tc-bind-unsafe-c-abi-fnptr-id base danger-callback-id callback-ty)]
      [layer : TcTypeEnv (tc-env-with-cache-layer-over-explicit layer-source)]
      (and
        (tc-env-cache-explicit-head? layer)
        (tc-type-env-cache-partial-head? layer)
        (tc-binding-c-abi-fnptr-id? layer base-callback-id)
        (not (tc-binding-unsafe-id? layer base-callback-id))
        (tc-binding-c-abi-fnptr-id? layer danger-callback-id)
        (tc-binding-unsafe-id? layer danger-callback-id)
        (match (tc-lookup-unsafe-id layer danger-callback-id)
          [(ResultTcTypeUnsafe.Ok (ast.AstType.Func _ _) unsafe) unsafe]
          [_ false])))))

(cfg
  test
  (define (tc-type-env-explicit-cache-layering-marker-smoke?) : bool
    (let
      [base : TcTypeEnv
        (tc-env-with-cache
          (tc-push-region (tc-default-env) (ci.intern "hidden")))]
      [shadowed : TcTypeEnv
        (tc-bind-id
          base
          (ci.intern "__tl_string_length")
          (tc-fn1 (ast.AstType.I64) (ast.AstType.I64)))]
      [layer : TcTypeEnv (tc-env-with-cache-layer-over-explicit shadowed)]
      (and
        (tc-env-cache-explicit-head? layer)
        (tc-type-env-cache-partial-head? layer)
        (tc-default-builtin-unshadowed-id?
          base
          cbi.compiler-builtin-id-tl-private-string-length)
        (not
          (tc-default-builtin-unshadowed-id?
            layer
            cbi.compiler-builtin-id-tl-private-string-length))
        (match (tc-active-region layer)
          [(TcMaybeNameId.No) true]
          [_ false])
        (not (tc-lifetime-visible-id? layer (ci.intern "hidden")))))))

(define (tc-type-env-local-cache-lambda-capture-smoke?) : bool
  (let
    [expr-bases : i64 (ast.ast-node-pool-active-expr-segment-bases)]
    [body : ast.AstExpr (ast.AstExpr.Var (ci.intern "captured"))]
    [base : TcTypeEnv (tc-env-with-cache (tc-empty-env))]
    [env : TcTypeEnv
      (tc-bind-id
        (tc-push-region-id base (ci.intern "outer"))
        (ci.intern "captured")
        (ast.ast-ty-ref (ci.intern "outer") (ast.AstType.I64)))]
    [deep : TcTypeEnv
      (tc-type-env-bind-many env (+ (* (tc-local-cache-threshold) 2) 8))]
    [scoped : TcTypeEnvScopedCarrier
      (tc-type-env-scoped-carrier-from-marker-visible-env deep)]
    (and
      (tc-lambda-captures-reference?
        expr-bases
        deep
        (ast.ast-param-list-new)
        body)
      (tc-type-env-scoped-carrier-lambda-captures-reference?
        expr-bases
        scoped
        (ast.ast-param-list-new)
        body)
      (match (tc-check-lambda-region-captures
        expr-bases
        deep
        (ast.ast-param-list-new)
        body)
        [(ResultTcUnit.Err message)
          (string.eq
            message
            "typecheck: lambda cannot capture immutable reference; reference value would escape lexical scope")]
        [_ false])
      (match (tc-check-lambda-region-captures-allow-refs
        expr-bases
        deep
        (ast.ast-param-list-new)
        body)
        [(ResultTcUnit.Ok) true]
        [_ false]))))

(define (tc-type-env-scoped-stack-grow-smoke?) : bool
  (let
    [stack : TcTypeEnvScopedStack (tc-type-env-scoped-stack-with-capacity 1 1)]
    [a-id : i64 (ci.intern "scoped-grow-a")]
    [b-id : i64 (ci.intern "scoped-grow-b")]
    [c-id : i64 (ci.intern "scoped-grow-c")]
    (begin
      (tc-type-env-scoped-stack-bind-id! (&mut stack) a-id (ast.AstType.I64))
      (let
        [outer : TcTypeEnvScopedMark
          (tc-type-env-scoped-stack-save! (&mut stack))]
        (begin
          (tc-type-env-scoped-stack-bind-id!
            (&mut stack)
            b-id
            (ast.AstType.Bool))
          (let
            [inner : TcTypeEnvScopedMark
              (tc-type-env-scoped-stack-save! (&mut stack))]
            (begin
              (tc-type-env-scoped-stack-bind-id!
                (&mut stack)
                c-id
                (ast.AstType.String))
              (tc-type-env-scoped-stack-restore! (&mut stack) inner)
              (let
                [after-inner : bool
                  (and
                    (= (tc-type-env-scoped-stack-len stack) 2)
                    (= (tc-type-env-scoped-stack-mark-count stack) 1)
                    (= (tc-type-env-scoped-stack-scope-depth stack) 1)
                    (match (tc-type-env-scoped-stack-lookup-id stack c-id)
                      [(TcTypeEnvScopedLookup.Missing) true]
                      [_ false])
                    (match (tc-type-env-scoped-stack-lookup-id stack b-id)
                      [(TcTypeEnvScopedLookup.Found
                          (ast.AstType.Bool)
                          unsafe
                          c-abi-fnptr
                          _
                          depth
                          _)
                        (and (not unsafe) (not c-abi-fnptr) (= depth 1))]
                      [_ false]))]
                (begin
                  (tc-type-env-scoped-stack-restore! (&mut stack) outer)
                  (and
                    after-inner
                    (= (tc-type-env-scoped-stack-len stack) 1)
                    (= (tc-type-env-scoped-stack-mark-count stack) 0)
                    (= (tc-type-env-scoped-stack-scope-depth stack) 0)
                    (match (tc-type-env-scoped-stack-lookup-id stack b-id)
                      [(TcTypeEnvScopedLookup.Missing) true]
                      [_ false])
                    (match (tc-type-env-scoped-stack-lookup-id stack a-id)
                      [(TcTypeEnvScopedLookup.Found
                          (ast.AstType.I64)
                          unsafe
                          c-abi-fnptr
                          marker-kind
                          depth
                          _)
                        (and
                          (not unsafe)
                          (not c-abi-fnptr)
                          (tc-type-env-scoped-marker-kind-same?
                            marker-kind
                            TcTypeEnvScopedMarkerKind.None)
                          (= depth 0))]
                      [_ false])))))))))))

(define (tc-type-env-scoped-stack-sparse-cache-repair-smoke?) : bool
  (let
    [stack : TcTypeEnvScopedStack (tc-type-env-scoped-stack-with-capacity 1 1)]
    [name-id : i64 (+ tc-type-env-scoped-dense-lookup-capacity 17)]
    (begin
      (tc-type-env-scoped-stack-bind-id! (&mut stack) name-id (ast.AstType.I64))
      (let
        [mark : TcTypeEnvScopedMark
          (tc-type-env-scoped-stack-save! (&mut stack))]
        (begin
          (tc-type-env-scoped-stack-bind-id!
            (&mut stack)
            name-id
            (ast.AstType.Bool))
          (let
            [shadowed : bool
              (match (tc-type-env-scoped-stack-lookup-id stack name-id)
                [(TcTypeEnvScopedLookup.Found (ast.AstType.Bool) _ _ _ _ _)
                  true]
                [_ false])]
            (begin
              (tc-type-env-scoped-stack-restore! (&mut stack) mark)
              (let
                [restored : bool
                  (match (tc-type-env-scoped-stack-lookup-id stack name-id)
                    [(TcTypeEnvScopedLookup.Found (ast.AstType.I64) _ _ _ _ _)
                      true]
                    [_ false])]
                [repaired-index : i64
                  (match (tc_i64_i64_map.get
                    (& (__tl-box-place stack.lookup-cache))
                    name-id)
                    [(tc_i64_i64_map.LookupFound index) index]
                    [(tc_i64_i64_map.LookupMissing) -1])]
                [restored-again : bool
                  (match (tc-type-env-scoped-stack-lookup-id stack name-id)
                    [(TcTypeEnvScopedLookup.Found (ast.AstType.I64) _ _ _ _ _)
                      true]
                    [_ false])]
                (and shadowed restored (= repaired-index 0) restored-again)))))))))

(define (tc-type-env-scoped-sidecar-smoke?) : bool
  (let
    [sidecar : TcTypeEnvScopedSidecar (tc-type-env-scoped-sidecar-new)]
    [value-id : i64 (ci.intern "scoped-value")]
    [fn-id : i64 (ci.intern "scoped-callback")]
    (begin
      (set!
        sidecar
        (tc-type-env-scoped-sidecar-bind-id sidecar value-id (ast.AstType.I64)))
      (let
        [stack-mark : TcTypeEnvScopedMark
          (tc-type-env-scoped-sidecar-save! (&mut sidecar))]
        [mark : TcTypeEnvScopedSidecarMark
          (tc-type-env-scoped-sidecar-mark sidecar stack-mark)]
        [generation-before : i64
          (tc-type-env-scoped-stack-cache-generation sidecar.stack)]
        (begin
          (set!
            sidecar
            (tc-type-env-scoped-sidecar-bind-id
              sidecar
              value-id
              (ast.AstType.Bool)))
          (set!
            sidecar
            (tc-type-env-scoped-sidecar-bind-unsafe-c-abi-fnptr-id
              sidecar
              fn-id
              (ast.AstType.I64)))
          (let
            [before-restore : bool
              (and
                (match (tc-type-env-scoped-sidecar-lookup-id sidecar value-id)
                  [(TcTypeEnvScopedLookup.Found
                      (ast.AstType.Bool)
                      unsafe
                      c-abi-fnptr
                      marker-kind
                      depth
                      generation)
                    (and
                      (not unsafe)
                      (not c-abi-fnptr)
                      (tc-type-env-scoped-marker-kind-same?
                        marker-kind
                        TcTypeEnvScopedMarkerKind.None)
                      (= depth 1)
                      (= generation generation-before))]
                  [_ false])
                (match (tc-type-env-scoped-sidecar-lookup-id sidecar fn-id)
                  [(TcTypeEnvScopedLookup.Found
                      (ast.AstType.I64)
                      unsafe
                      c-abi-fnptr
                      _
                      depth
                      generation)
                    (and
                      unsafe
                      c-abi-fnptr
                      (= depth 1)
                      (= generation generation-before))]
                  [_ false])
                (match (tc-type-env-scoped-stack-marker-lookup
                  sidecar.stack
                  TcTypeEnvScopedMarkerKind.UnsafeDecl)
                  [(TcTypeEnvScopedMarkerLookup.Found
                      marker-id
                      (ast.AstType.Unit)
                      depth
                      generation)
                    (and
                      (= marker-id (tc-unsafe-decl-marker-id fn-id))
                      (= depth 1)
                      (= generation generation-before))]
                  [_ false])
                (match (tc-lookup-id
                  (tc-type-env-scoped-sidecar-persistent sidecar)
                  value-id)
                  [(ResultTcType.Err _) true]
                  [_ false])
                (match (tc-lookup-unsafe-id
                  (tc-type-env-scoped-sidecar-materialize sidecar)
                  fn-id)
                  [(ResultTcTypeUnsafe.Ok (ast.AstType.I64) unsafe) unsafe]
                  [_ false])
                (tc-binding-c-abi-fnptr-id?
                  (tc-type-env-scoped-sidecar-materialize sidecar)
                  fn-id)
                (match (tc-lookup-id
                  (tc-type-env-scoped-sidecar-materialize sidecar)
                  value-id)
                  [(ResultTcType.Ok (ast.AstType.Bool)) true]
                  [_ false]))]
            (begin
              (tc-type-env-scoped-sidecar-restore! (&mut sidecar) mark)
              (and
                before-restore
                (= (tc-type-env-scoped-stack-len sidecar.stack) 1)
                (= (tc-type-env-scoped-stack-mark-count sidecar.stack) 0)
                (=
                  (tc-type-env-scoped-stack-cache-generation sidecar.stack)
                  (+ generation-before 1))
                (match (tc-type-env-scoped-sidecar-lookup-id sidecar fn-id)
                  [(TcTypeEnvScopedLookup.Missing) true]
                  [_ false])
                (match (tc-type-env-scoped-sidecar-lookup-id sidecar value-id)
                  [(TcTypeEnvScopedLookup.Found
                      (ast.AstType.I64)
                      unsafe
                      c-abi-fnptr
                      marker-kind
                      depth
                      _)
                    (and
                      (not unsafe)
                      (not c-abi-fnptr)
                      (tc-type-env-scoped-marker-kind-same?
                        marker-kind
                        TcTypeEnvScopedMarkerKind.None)
                      (= depth 0))]
                  [_ false])
                (match (tc-lookup-id
                  (tc-type-env-scoped-sidecar-materialize sidecar)
                  value-id)
                  [(ResultTcType.Ok (ast.AstType.I64)) true]
                  [_ false])
                (match (tc-lookup-id
                  (tc-type-env-scoped-sidecar-materialize sidecar)
                  fn-id)
                  [(ResultTcType.Err _) true]
                  [_ false])))))))))

(define (tc-type-env-scoped-carrier-bind-many
  [carrier : TcTypeEnvScopedCarrier]
  [count : i64]) : TcTypeEnvScopedCarrier
  (let
    [i : i64 0]
    [out : TcTypeEnvScopedCarrier carrier]
    (begin
      (while (< i count)
        (let
          [name : String
            (str_cat.str-cat "carrier-local" (string.int->string i))]
          (begin
            (set!
              out
              (tc-type-env-scoped-carrier-bind-id
                out
                (tc-generated-name-id name)
                (ast.AstType.I64)))
            (set! i (+ i 1)))))
      out)))

(define (tc-type-env-scoped-carrier-region-matches-env?
  [carrier : TcTypeEnvScopedCarrier]) : bool
  (match (tc-type-env-scoped-carrier-active-region carrier)
    [(TcMaybeNameId.Some sidecar-region)
      (match (tc-active-region (tc-type-env-scoped-carrier-env carrier))
        [(TcMaybeNameId.Some env-region) (= sidecar-region env-region)]
        [_ false])]
    [(TcMaybeNameId.No)
      (match (tc-active-region (tc-type-env-scoped-carrier-env carrier))
        [(TcMaybeNameId.No) true]
        [_ false])]))

(define (tc-type-env-scoped-carrier-return-matches-env?
  [carrier : TcTypeEnvScopedCarrier]) : bool
  (match (tc-type-env-scoped-carrier-current-return-type carrier)
    [(ResultTcType.Ok carrier-ty)
      (match (tc-current-return-type (tc-type-env-scoped-carrier-env carrier))
        [(ResultTcType.Ok env-ty) (tc-type-eq carrier-ty env-ty)]
        [_ false])]
    [(ResultTcType.Err _)
      (match (tc-current-return-type (tc-type-env-scoped-carrier-env carrier))
        [(ResultTcType.Err _) true]
        [_ false])]))

(define (tc-type-env-scoped-carrier-smoke?) : bool
  (let
    [_outer-id : i64 (ci.intern "outer")]
    [_inner-id : i64 (ci.intern "inner")]
    [_resource-id : i64 (ci.intern "resource")]
    [_arena-id : i64 (ci.intern "arena")]
    [_atomic-id : i64 (ci.intern "atomic")]
    [base : TcTypeEnv
      (tc-env-with-cache
        (tc-push-region-id (tc-empty-env) (ci.intern "cached-base")))]
    [carrier : TcTypeEnvScopedCarrier
      (tc-type-env-scoped-carrier-from-env base)]
    [fn-id : i64 (ci.intern "carrier-callback")]
    [callback-ty : ast.AstType (tc-fn0 (ast.AstType.I64))]
    (begin
      (set! carrier (tc-type-env-scoped-carrier-bind-default-boundary carrier))
      (set! carrier (tc-type-env-scoped-carrier-push-region carrier _outer-id))
      (set! carrier (tc-type-env-scoped-carrier-enter-unsafe carrier))
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-return-type carrier (ast.AstType.I64)))
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-cleanup-owner carrier _resource-id))
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-id
          carrier
          _resource-id
          (ast.AstType.String)))
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-ordinary-arena-owner carrier _arena-id))
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-id carrier _arena-id (ast.AstType.I64)))
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-atomic-arena-owner carrier _atomic-id))
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-id
          carrier
          _atomic-id
          (ast.AstType.I64)))
      (let
        [outer-save : TcTypeEnvScopedCarrierSave
          (tc-type-env-scoped-carrier-save carrier)]
        [outer-mark : TcTypeEnvScopedCarrierMark outer-save.mark]
        (begin
          (set! carrier outer-save.carrier)
          (set!
            carrier
            (tc-type-env-scoped-carrier-push-region carrier _inner-id))
          (set!
            carrier
            (tc-type-env-scoped-carrier-bind-unsafe-c-abi-fnptr-id
              carrier
              fn-id
              callback-ty))
          (let
            [deep : TcTypeEnvScopedCarrier
              (tc-type-env-scoped-carrier-bind-many
                carrier
                (+ (* (tc-local-cache-threshold) 2) 8))]
            [snapshot : TcTypeEnvScopedCarrier
              (tc-type-env-scoped-carrier-from-marker-visible-env
                (tc-type-env-scoped-carrier-env deep))]
            [before-restore : bool
              (and
                (tc-type-env-scoped-carrier-region-matches-env? deep)
                (tc-type-env-scoped-carrier-return-matches-env? deep)
                (tc-type-env-scoped-carrier-in-unsafe? deep)
                (tc-in-unsafe? (tc-type-env-scoped-carrier-env deep))
                (match (tc-type-env-scoped-carrier-active-region deep)
                  [(TcMaybeNameId.Some region) (= region _inner-id)]
                  [_ false])
                (tc-cleanup-owner-active-id?
                  (tc-type-env-scoped-carrier-env deep)
                  _resource-id)
                (tc-ordinary-arena-owner-active-id?
                  (tc-type-env-scoped-carrier-env deep)
                  _arena-id)
                (tc-atomic-arena-owner-active-id?
                  (tc-type-env-scoped-carrier-env deep)
                  _atomic-id)
                (tc-type-env-scoped-carrier-in-unsafe? snapshot)
                (match (tc-type-env-scoped-carrier-active-region snapshot)
                  [(TcMaybeNameId.Some region) (= region _inner-id)]
                  [_ false])
                (match (tc-type-env-scoped-carrier-current-return-type snapshot)
                  [(ResultTcType.Ok (ast.AstType.I64)) true]
                  [_ false])
                (tc-type-env-scoped-carrier-cleanup-owner-active?
                  snapshot
                  _resource-id)
                (tc-type-env-scoped-carrier-ordinary-arena-owner-active?
                  snapshot
                  _arena-id)
                (tc-type-env-scoped-carrier-atomic-arena-owner-active?
                  snapshot
                  _atomic-id)
                (tc-type-env-scoped-carrier-lifetime-visible-id?
                  snapshot
                  _arena-id)
                (tc-type-env-scoped-carrier-lifetime-visible-id?
                  snapshot
                  _resource-id)
                (tc-type-env-scoped-carrier-lifetime-outlives-binding-id?
                  snapshot
                  _resource-id
                  _arena-id)
                (not
                  (tc-type-env-scoped-carrier-lifetime-outlives-binding-id?
                    snapshot
                    _arena-id
                    _resource-id))
                (tc-type-env-scoped-carrier-lifetime-outlives-lifetime-id?
                  snapshot
                  _resource-id
                  _arena-id)
                (not
                  (tc-type-env-scoped-carrier-lifetime-outlives-lifetime-id?
                    snapshot
                    _arena-id
                    _resource-id))
                (tc-binding-unsafe-id?
                  (tc-type-env-scoped-carrier-env deep)
                  fn-id)
                (tc-binding-c-abi-fnptr-id?
                  (tc-type-env-scoped-carrier-env deep)
                  fn-id)
                (match (tc-type-env-scoped-sidecar-lookup-id
                  (tc-type-env-scoped-carrier-sidecar deep)
                  fn-id)
                  [(TcTypeEnvScopedLookup.Found
                      (ast.AstType.Func _ _)
                      unsafe
                      c-abi-fnptr
                      _
                      _
                      _)
                    (and unsafe c-abi-fnptr)]
                  [_ false])
                (match (tc-type-env-scoped-stack-marker-lookup
                  (__tl-project-field
                    (tc-type-env-scoped-carrier-sidecar deep)
                    stack)
                  TcTypeEnvScopedMarkerKind.DefaultBoundary)
                  [(TcTypeEnvScopedMarkerLookup.Found
                      marker-id
                      (ast.AstType.Unit)
                      _
                      _)
                    (= marker-id (tc-default-boundary-id))]
                  [_ false])
                (match (tc-type-env-scoped-stack-marker-lookup
                  (__tl-project-field
                    (tc-type-env-scoped-carrier-sidecar deep)
                    stack)
                  TcTypeEnvScopedMarkerKind.CleanupOwner)
                  [(TcTypeEnvScopedMarkerLookup.Found
                      marker-id
                      (ast.AstType.Var owner)
                      _
                      _)
                    (and
                      (= marker-id (tc-cleanup-owner-marker-id))
                      (string.eq (ci.intern-str owner) "resource"))]
                  [_ false])
                (match (tc-type-env-scoped-stack-marker-lookup
                  (__tl-project-field
                    (tc-type-env-scoped-carrier-sidecar deep)
                    stack)
                  TcTypeEnvScopedMarkerKind.OrdinaryArenaOwner)
                  [(TcTypeEnvScopedMarkerLookup.Found
                      marker-id
                      (ast.AstType.Var owner)
                      _
                      _)
                    (and
                      (= marker-id (tc-ordinary-arena-owner-marker-id))
                      (string.eq (ci.intern-str owner) "arena"))]
                  [_ false])
                (match (tc-type-env-scoped-stack-marker-lookup
                  (__tl-project-field
                    (tc-type-env-scoped-carrier-sidecar deep)
                    stack)
                  TcTypeEnvScopedMarkerKind.AtomicArenaOwner)
                  [(TcTypeEnvScopedMarkerLookup.Found
                      marker-id
                      (ast.AstType.Var owner)
                      _
                      _)
                    (and
                      (= marker-id (tc-atomic-arena-owner-marker-id))
                      (string.eq (ci.intern-str owner) "atomic"))]
                  [_ false]))]
            (begin
              (set!
                carrier
                (tc-type-env-scoped-carrier-restore carrier outer-mark))
              (and
                before-restore
                (tc-type-env-scoped-carrier-region-matches-env? carrier)
                (tc-type-env-scoped-carrier-return-matches-env? carrier)
                (match (tc-type-env-scoped-carrier-active-region carrier)
                  [(TcMaybeNameId.Some region) (= region _outer-id)]
                  [_ false])
                (match (tc-type-env-scoped-sidecar-lookup-id
                  (tc-type-env-scoped-carrier-sidecar carrier)
                  fn-id)
                  [(TcTypeEnvScopedLookup.Missing) true]
                  [_ false])
                (not
                  (tc-binding-c-abi-fnptr-id?
                    (tc-type-env-scoped-carrier-env carrier)
                    fn-id))))))))))

(cfg
  test
  (define (tc-type-env-scoped-runtime-smoke?) : bool
    (let
      [was-active : bool (tc-type-env-scoped-runtime-active?)]
      [outer-id : i64 (ci.intern "outer")]
      [inner-id : i64 (ci.intern "inner")]
      [resource-id : i64 (ci.intern "resource")]
      [runtime-tail-id : i64 (ci.intern "runtime-tail")]
      [runtime-unsafe-id : i64 (ci.intern "runtime-unsafe")]
      [runtime-callback-id : i64 (ci.intern "runtime-callback")]
      [base-env : TcTypeEnv
        (tc-bind-return-type
          (tc-push-region-id
            (tc-enter-unsafe
              (tc-bind-id (tc-default-env) runtime-tail-id (ast.AstType.String)))
            outer-id)
          (ast.AstType.I64))]
      [carrier : TcTypeEnvScopedCarrier
        (tc-type-env-scoped-carrier-from-env base-env)]
      [outer-save : TcTypeEnvScopedRuntimeSave
        (tc-type-env-scoped-runtime-enter! carrier)]
      [runtime-env : TcTypeEnv
        (tc-bind-id
          (tc-bind-cleanup-owner base-env resource-id)
          resource-id
          (ast.AstType.String))]
      [scope-save : TcTypeEnvScopedRuntimeSave
        (tc-type-env-scoped-runtime-save)]
      [unsafe-env : TcTypeEnv
        (tc-bind-unsafe-id runtime-env runtime-unsafe-id (ast.AstType.I64))]
      [c-abi-env : TcTypeEnv
        (tc-bind-c-abi-fnptr-id
          unsafe-env
          runtime-callback-id
          (tc-fn0 (ast.AstType.I64)))]
      [shadow-env : TcTypeEnv
        (tc-bind-id
          c-abi-env
          cbi.compiler-builtin-id-tl-private-string-length
          (tc-fn1 (ast.AstType.I64) (ast.AstType.I64)))]
      [inner-env : TcTypeEnv (tc-push-region-id shadow-env inner-id)]
      [inner-ok : bool
        (and
          (match (tc-active-region inner-env)
            [(TcMaybeNameId.Some region) (= region inner-id)]
            [_ false])
          (match (tc-lookup-id inner-env runtime-tail-id)
            [(ResultTcType.Ok (ast.AstType.String)) true]
            [_ false])
          (match (tc-lookup-id inner-env runtime-unsafe-id)
            [(ResultTcType.Ok (ast.AstType.I64)) true]
            [_ false])
          (tc-name-bound-id? inner-env runtime-unsafe-id)
          (match (tc-lookup-unsafe-id inner-env runtime-unsafe-id)
            [(ResultTcTypeUnsafe.Ok (ast.AstType.I64) unsafe) unsafe]
            [_ false])
          (tc-binding-c-abi-fnptr-id? inner-env runtime-callback-id)
          (not
            (tc-default-builtin-unshadowed-id?
              inner-env
              cbi.compiler-builtin-id-tl-private-string-length)))]
      (begin
        (tc-type-env-scoped-runtime-restore! scope-save)
        (let
          [restored-ok : bool
            (and
              (match (tc-active-region runtime-env)
                [(TcMaybeNameId.Some region) (= region outer-id)]
                [_ false])
              (match (tc-current-return-type runtime-env)
                [(ResultTcType.Ok (ast.AstType.I64)) true]
                [_ false])
              (tc-in-unsafe? runtime-env)
              (tc-cleanup-owner-active-id? runtime-env resource-id)
              (match (tc-lookup-id runtime-env runtime-tail-id)
                [(ResultTcType.Ok (ast.AstType.String)) true]
                [_ false])
              (match (tc-lookup-id runtime-env runtime-unsafe-id)
                [(ResultTcType.Err _) true]
                [_ false])
              (not (tc-name-bound-id? runtime-env runtime-unsafe-id))
              (not (tc-binding-c-abi-fnptr-id? runtime-env runtime-callback-id))
              (tc-default-builtin-unshadowed-id?
                runtime-env
                cbi.compiler-builtin-id-tl-private-string-length))]
          (begin
            (tc-type-env-scoped-runtime-restore! outer-save)
            (and
              (not was-active)
              (not (tc-type-env-scoped-runtime-active?))
              inner-ok
              restored-ok)))))))

(define (tc-type-env-scoped-primary-storage-smoke?) : bool
  (let
    [tail-only-id : i64 (tc-generated-name-id "tail-only")]
    [shadow-id : i64 (tc-generated-name-id "shadow")]
    [alias-id : i64 (tc-generated-name-id "alias")]
    [hygiene-id : i64 (tc-generated-name-id "hygiene-value")]
    [mirrored-id : i64 (tc-generated-name-id "mirrored")]
    [fresh-id : i64 (tc-generated-name-id "fresh")]
    [base : TcTypeEnv
      (tc-env-with-cache
        (tc-bind-id (tc-empty-env) tail-only-id (ast.AstType.String)))]
    [carrier : TcTypeEnvScopedCarrier
      (tc-type-env-scoped-carrier-from-env base)]
    [fn-id : i64 (tc-generated-name-id "scoped-primary-fn")]
    (begin
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-id carrier shadow-id (ast.AstType.I64)))
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-id
          carrier
          shadow-id
          (ast.AstType.Bool)))
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-alias-id-if-free
          carrier
          shadow-id
          (ast.AstType.String)))
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-alias-id-if-free
          carrier
          alias-id
          (ast.AstType.I64)))
      (set!
        carrier
        (tc-type-env-scoped-carrier-bind-unsafe-c-abi-fnptr-id
          carrier
          fn-id
          (tc-fn0 (ast.AstType.I64))))
      (let
        [snapshot : TcTypeEnv (tc-type-env-scoped-carrier-env carrier)]
        [default-carrier : TcTypeEnvScopedCarrier
          (tc-type-env-scoped-carrier-bind-id
            (tc-type-env-scoped-carrier-from-env
              (tc-env-with-cache (tc-default-env)))
            cbi.compiler-builtin-id-tl-private-string-length
            (tc-fn1 (ast.AstType.I64) (ast.AstType.I64)))]
        [hygiene-carrier : TcTypeEnvScopedCarrier
          (tc-type-env-scoped-carrier-bind-id
            (tc-type-env-scoped-carrier-from-env
              (tc-hygiene-global-env
                (tc-bind-id (tc-empty-env) hygiene-id (ast.AstType.I64))))
            hygiene-id
            (ast.AstType.Bool))]
        [mirrored-carrier : TcTypeEnvScopedCarrier
          (tc-type-env-scoped-carrier-bind-id
            (tc-type-env-scoped-carrier-from-marker-visible-env
              (tc-bind-id (tc-empty-env) mirrored-id (ast.AstType.I64)))
            fresh-id
            (ast.AstType.Bool))]
        [mirrored-snapshot : TcTypeEnv
          (tc-type-env-scoped-carrier-env mirrored-carrier)]
        (and
          (match (tc-type-env-scoped-carrier-lookup-id carrier tail-only-id)
            [(ResultTcType.Ok (ast.AstType.String)) true]
            [_ false])
          (match (tc-type-env-scoped-carrier-lookup-id carrier shadow-id)
            [(ResultTcType.Ok (ast.AstType.Bool)) true]
            [_ false])
          (match (tc-type-env-scoped-carrier-lookup-id carrier alias-id)
            [(ResultTcType.Ok (ast.AstType.I64)) true]
            [_ false])
          (tc-type-env-scoped-carrier-binding-unsafe-id? carrier fn-id)
          (tc-type-env-scoped-carrier-binding-c-abi-fnptr-id? carrier fn-id)
          (match (tc-lookup-id snapshot tail-only-id)
            [(ResultTcType.Ok (ast.AstType.String)) true]
            [_ false])
          (match (tc-lookup-id snapshot shadow-id)
            [(ResultTcType.Ok (ast.AstType.Bool)) true]
            [_ false])
          (tc-binding-unsafe-id? snapshot fn-id)
          (tc-binding-c-abi-fnptr-id? snapshot fn-id)
          (not
            (tc-default-builtin-unshadowed-id?
              (tc-type-env-scoped-carrier-env default-carrier)
              cbi.compiler-builtin-id-tl-private-string-length))
          (match (tc-lookup-hygiene-global-id
            (tc-type-env-scoped-carrier-env hygiene-carrier)
            hygiene-id)
            [(ResultTcType.Ok (ast.AstType.I64)) true]
            [_ false])
          (= (tc-ordinary-binding-rank-id-from mirrored-snapshot fresh-id 0) 0)
          (=
            (tc-ordinary-binding-rank-id-from mirrored-snapshot mirrored-id 0)
            1))))))

(define (tc-type-env-scoped-stack-smoke?) : bool
  (begin
    (cbi.compiler-builtin-initialize-for-parse!)
    (and
      (tc-type-env-scoped-stack-grow-smoke?)
      (tc-type-env-scoped-stack-sparse-cache-repair-smoke?)
      (tc-type-env-scoped-sidecar-smoke?)
      (tc-type-env-scoped-carrier-smoke?)
      (tc-type-env-scoped-primary-storage-smoke?)
      (cfg test (tc-type-env-scoped-runtime-smoke?) true))))

(test
  tc-type-env-scoped-stack
  (if (tc-type-env-scoped-stack-smoke?)
    unit
    (io.panic "typecheck: scoped type env smoke failed")))

(define (tc-type-env-walker-api-smoke?) : bool
  (let
    [lookup-base : TcTypeEnv
      (tc-env-with-cache
        (tc-bind-id (tc-empty-env) (ci.intern "global") (ast.AstType.String)))]
    [lookup-local : TcTypeEnv
      (tc-bind-id lookup-base (ci.intern "local") (ast.AstType.I64))]
    [lookup-deep : TcTypeEnv
      (tc-type-env-bind-many lookup-local (+ (tc-local-cache-threshold) 4))]
    [marker-base : TcTypeEnv
      (tc-env-with-cache (tc-push-region-id (tc-empty-env) (ci.intern "outer")))]
    [inner-id : i64 (ci.intern "inner")]
    [marker-local : TcTypeEnv (tc-push-region-id marker-base inner-id)]
    [marker-deep : TcTypeEnv
      (tc-type-env-bind-many
        marker-local
        (+ (* (tc-local-cache-threshold) 2) 8))]
    [marker-scoped : TcTypeEnvScopedCarrier
      (tc-type-env-scoped-carrier-from-marker-visible-env marker-deep)]
    [unsafe-env : TcTypeEnv
      (tc-bind-unsafe-id
        (tc-empty-env)
        (ci.intern "unsafe-value")
        (ast.AstType.I64))]
    [hygiene-top : TcTypeEnv
      (tc-bind-id (tc-empty-env) (ci.intern "visible") (ast.AstType.I64))]
    [hygiene-root : TcTypeEnv (tc-hygiene-global-env hygiene-top)]
    [hygiene-env : TcTypeEnv
      (tc-bind-id hygiene-root (ci.intern "visible") (ast.AstType.Bool))]
    (and
      (match (tc-type-env-lookup-step lookup-local (ci.intern "local"))
        [(TcTypeEnvLookupStep.Found (ast.AstType.I64)) true]
        [_ false])
      (match (tc-type-env-lookup-step lookup-local (ci.intern "global"))
        [(TcTypeEnvLookupStep.Miss rest-env)
          (match (tc-type-env-lookup-step rest-env (ci.intern "global"))
            [(TcTypeEnvLookupStep.Found (ast.AstType.String)) true]
            [_ false])]
        [_ false])
      (match (tc-type-env-marker-step (tc-type-env-marker-start marker-local))
        [(TcTypeEnvMarkerStep.Bind key (ast.AstType.Var region) _)
          (and (= key (tc-region-marker-id)) (= region inner-id))]
        [_ false])
      (match (tc-type-env-scoped-marker-step
        (tc-type-env-scoped-carrier-marker-cursor marker-scoped))
        [(TcTypeEnvScopedMarkerStep.Bind key (ast.AstType.I64) _)
          (=
            key
            (ci.intern
              (str_cat.str-cat
                "local"
                (string.int->string
                  (- (+ (* (tc-local-cache-threshold) 2) 8) 1)))))]
        [_ false])
      (match (tc-type-env-unsafe-lookup-step
        unsafe-env
        (ci.intern "unsafe-value"))
        [(TcTypeEnvUnsafeLookupStep.Found (ast.AstType.I64) unsafe) unsafe]
        [_ false])
      (match (tc-ptr-addr-of-local-lookup hygiene-env (ci.intern "visible"))
        [(ResultTcType.Ok (ast.AstType.Bool)) true]
        [_ false])
      (match (tc-ptr-addr-of-local-lookup hygiene-root (ci.intern "visible"))
        [(ResultTcType.Err _) true]
        [_ false])
      (match (tc-lookup-id lookup-deep (ci.intern "global"))
        [(ResultTcType.Ok (ast.AstType.String)) true]
        [_ false])
      (match (tc-lookup-id lookup-deep (ci.intern "local"))
        [(ResultTcType.Ok (ast.AstType.I64)) true]
        [_ false])
      (match (tc-active-region marker-deep)
        [(TcMaybeNameId.Some region) (= region (ci.intern "inner"))]
        [_ false])
      (tc-lifetime-visible-id? marker-deep (ci.intern "inner"))
      (not (tc-lifetime-visible-id? marker-deep (ci.intern "outer")))
      (match (tc-lookup-id hygiene-env (ci.intern "visible"))
        [(ResultTcType.Ok (ast.AstType.Bool)) true]
        [_ false])
      (match (tc-lookup-hygiene-global-id hygiene-env (ci.intern "visible"))
        [(ResultTcType.Ok (ast.AstType.I64)) true]
        [_ false]))))

