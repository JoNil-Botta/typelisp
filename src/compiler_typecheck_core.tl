(defstruct TcStringListNode
  (value String)
  (parent i64))

(defstruct TcStringListStoreData
  (nodes (__tl_dyn-array TcStringListNode))
  (len i64)
  (owner-arena i64))

;; Persistent scoped strings use an allocation-free singleton and then an
;; append-only dense node store. A list snapshot is only a stable store handle,
;; tail index, and length; appending a sibling never rewrites either branch.
(defenum TcStringList
  (Nil)
  (One String)
  (Dense i64 i64 i64))

(defstruct TcNameIdListNode
  (value i64)
  (parent i64))

(defstruct TcNameIdListStoreData
  (nodes (__tl_dyn-array TcNameIdListNode))
  (len i64)
  (owner-arena i64))

;; Name-id sets, stacks, and ordered paths share the same persistent dense
;; spine representation as strings. Membership policy stays with each caller;
;; `tc-name-id-list-cons` preserves duplicates while `-add` deduplicates.
(defenum TcNameIdList
  (Nil)
  (One i64)
  (Dense i64 i64 i64))

;; Where a store lands: the lifetime its references must outlive, and the
;; lifetimes known to outlive that target. A place reached through
;; `(&mut m T)` targets `m`, and the well-formedness of that reference implies
;; every lifetime in `T` outlives `m` (#8584).
(defenum ResultTcStorePlaceTarget
  (Ok i64 TcNameIdList)
  (Err String))

(defstruct TcSpmdTraversalStateData
  (owner-arena i64)
  (inline-helper-stack TcNameIdList))

(define (tc-spmd-traversal-state-new) : TcSpmdTraversalState
  (let
    [cell : (__tl_dyn-array TcSpmdTraversalStateData)
      (__tl_make-array TcSpmdTraversalStateData 1)]
    (set!
      (array-ref cell 0)
      (TcSpmdTraversalStateData (arena.tl_arena_current) Nil))
    (TcSpmdTraversalState
      (cast
        (unsafe
          (ptr->int
            (ptr-cast (__tl_array-data cell) : (Ptr TcSpmdTraversalStateData))))
        : i64))))

(define (tc-spmd-traversal-state-ptr [state : TcSpmdTraversalState]) : (MutPtr
    TcSpmdTraversalStateData)
  (tc-state-cell-ptr state.address TcSpmdTraversalStateData))

(define (tc-spmd-traversal-state-view [state : TcSpmdTraversalState]) : (Ptr
    TcSpmdTraversalStateData)
  (tc-state-cell-view state.address TcSpmdTraversalStateData))

;; Lazy import aliases and their summary-use counters are mutable, intern-owned
;; typecheck state. Keep one lazily allocated table per compiler job so a reset
;; or lookup in one job cannot observe or clear another job's aliases.
(defstruct TcLazyImportStateData
  (owner-arena i64)
  (module-ids (__tl_dyn-array i64))
  (alias-ids (__tl_dyn-array i64))
  (target-ids (__tl_dyn-array i64))
  (summary-backed (__tl_dyn-array bool))
  (index-slots (__tl_dyn-array i64))
  (alias-slots (__tl_dyn-array i64))
  (alias-previous (__tl_dyn-array i64))
  (record-count i64)
  (intern-table-id i64)
  (intern-generation i64)
  (summary-backed-count i64)
  (summary-macro-force-count i64))

(defstruct TcLazyImportState
  (address i64))

