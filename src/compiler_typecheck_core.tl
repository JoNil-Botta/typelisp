        [_value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (match (tc-move-check-expr
          ctx
          expr-bases
          env
          locals
          loop-carried
          moved
          box-expr)
          [(TcMoveResult.Ok moved1)
            (match (tc-move-check-cleanup-overwrite
              ctx
              expr-bases
              env
              moved1
              (ast.AstExpr.BoxTake box-box))
              [(ResultTcUnit.Ok)
                (match (tc-move-check-expr-id
                  ctx
                  expr-bases
                  env
                  locals
                  loop-carried
                  moved1
                  value-box)
                  [(TcMoveResult.Ok moved2)
                    (match (tc-move-after-bind-id
                      ctx
                      expr-bases
                      env
                      locals
                      loop-carried
                      moved2
                      value-box)
                      [(TcMoveResult.Ok moved3) (TcMoveResult.Ok moved3)]
                      [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
                  [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
              [(ResultTcUnit.Err message) (TcMoveResult.Err message)])]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(ast.AstExpr.TypeLiteral _) (TcMoveResult.Ok moved)]
    [(ast.AstExpr.Init _) (TcMoveResult.Ok moved)]
    ;; The CTFE evaluator consumes this subtree before the runtime body exists.
    ;; Its source operands therefore cannot move runtime locals.
    [(ast.AstExpr.Comptime _) (TcMoveResult.Ok moved)]
    [(ast.AstExpr.Quote _) (TcMoveResult.Ok moved)]
    [(ast.AstExpr.Quasiquote _) (TcMoveResult.Ok moved)]
    [(ast.AstExpr.Unquote _) (TcMoveResult.Ok moved)]
    [(ast.AstExpr.UnquoteSplicing _) (TcMoveResult.Ok moved)]
    [(ast.AstExpr.Try inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (begin
          (tc-body-early-exit-note! (tc-context-body-state ctx))
          (tc-move-check-expr
            ctx
            expr-bases
            env
            locals
            loop-carried
            moved
            inner)))]
    [(ast.AstExpr.Return inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (begin
          (tc-body-early-exit-note! (tc-context-body-state ctx))
          (match (tc-move-check-expr
            ctx
            expr-bases
            env
            locals
            loop-carried
            moved
            inner)
            [(TcMoveResult.Ok moved1)
              (match (tc-current-return-type env)
                [(ResultTcType.Ok return-ty)
                  (tc-move-after-consuming-value
                    ctx
                    expr-bases
                    env
                    locals
                    loop-carried
                    moved1
                    inner
                    return-ty
                    return-ty)]
                [(ResultTcType.Err _) (TcMoveResult.Ok moved1)])]
            [(TcMoveResult.Err message) (TcMoveResult.Err message)])))]
    [(ast.AstExpr.Break)
      (begin
        (tc-body-early-exit-note! (tc-context-body-state ctx))
        (TcMoveResult.Ok moved))]
    [(ast.AstExpr.Continue)
      (begin
        (tc-body-early-exit-note! (tc-context-body-state ctx))
        (TcMoveResult.Ok moved))]
    [(ast.AstExpr.PtrNull _) (TcMoveResult.Ok moved)]
    [(ast.AstExpr.PtrNullCheck inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-move-check-expr ctx expr-bases env locals loop-carried moved inner))]
    [(ast.AstExpr.PtrAddrOf place-box)
      (let
        [place : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases place-box)]
        (tc-move-check-ptr-addr-of-place
          ctx
          expr-bases
          env
          locals
          loop-carried
          moved
          place
          expr))]
    [(ast.AstExpr.PtrRead inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-move-check-expr ctx expr-bases env locals loop-carried moved inner))]
    [(ast.AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (match (tc-move-check-expr
          ctx
          expr-bases
          env
          locals
          loop-carried
          moved
          ptr)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr
              ctx
              expr-bases
              env
              locals
              loop-carried
              moved1
              value)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(ast.AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [offset : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases offset-box)]
        (match (tc-move-check-expr
          ctx
          expr-bases
          env
          locals
          loop-carried
          moved
          ptr)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr
              ctx
              expr-bases
              env
              locals
              loop-carried
              moved1
              offset)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(ast.AstExpr.PtrCast inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-move-check-expr ctx expr-bases env locals loop-carried moved inner))]
    [(ast.AstExpr.PtrToInt inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-move-check-expr ctx expr-bases env locals loop-carried moved inner))]
    [(ast.AstExpr.IntToPtr inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-move-check-expr ctx expr-bases env locals loop-carried moved inner))]
    [(ast.AstExpr.StringData inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-move-check-expr ctx expr-bases env locals loop-carried moved inner))]
    [(ast.AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [len : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases len-box)]
        (match (tc-move-check-expr
          ctx
          expr-bases
          env
          locals
          loop-carried
          moved
          ptr)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr
              ctx
              expr-bases
              env
              locals
              loop-carried
              moved1
              len)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(ast.AstExpr.ArrayData inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-move-check-expr ctx expr-bases env locals loop-carried moved inner))]
    [(ast.AstExpr.BinaryData _) (TcMoveResult.Ok moved)]
    [(ast.AstExpr.SpmdProgramIndex) (TcMoveResult.Ok moved)]
    [(ast.AstExpr.SpmdProgramCount) (TcMoveResult.Ok moved)]
    [(ast.AstExpr.ProgramArgc) (TcMoveResult.Ok moved)]
    [(ast.AstExpr.ProgramArgv) (TcMoveResult.Ok moved)]
    [(ast.AstExpr.ProgramEnvp) (TcMoveResult.Ok moved)]
    [(ast.AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (match (tc-move-check-expr
          ctx
          expr-bases
          env
          locals
          loop-carried
          moved
          leaf)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr
              ctx
              expr-bases
              env
              locals
              loop-carried
              moved1
              subleaf)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(ast.AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (match (tc-move-check-expr
          ctx
          expr-bases
          env
          locals
          loop-carried
          moved
          leaf)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr
              ctx
              expr-bases
              env
              locals
              loop-carried
              moved1
              subleaf)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(ast.AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (match (tc-move-check-expr
          ctx
          expr-bases
          env
          locals
          loop-carried
          moved
          leaf)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr
              ctx
              expr-bases
              env
              locals
              loop-carried
              moved1
              subleaf)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(ast.AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (match (tc-move-check-expr
          ctx
          expr-bases
          env
          locals
          loop-carried
          moved
          leaf)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr
              ctx
              expr-bases
              env
              locals
              loop-carried
              moved1
              subleaf)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(ast.AstExpr.Xgetbv index-box)
      (let
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (tc-move-check-expr ctx expr-bases env locals loop-carried moved index))]
    [(ast.AstExpr.Syscall args)
      (tc-move-check-exprs ctx expr-bases env locals loop-carried moved args)]))

(define (tc-move-check-body-id
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [params : ast.AstParamList]
  [body-id : i64]
  [return-ty : ast.AstType]) : ResultTcUnit
  (let
    [locals : TcMovedSet (tc-move-params-locals params (tc-moved-empty))]
    [body : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases body-id)]
    (match (tc-move-check-expr-id
      ctx
      expr-bases
      env
      locals
      (tc-moved-empty)
      (tc-param-storage-seed-params ctx params (tc-moved-empty))
      body-id)
      [(TcMoveResult.Ok moved)
        (match (tc-move-check-global-result
          ctx
          expr-bases
          env
          locals
          moved
          body
          return-ty)
          [(TcMoveResult.Ok _)
            (match (tc-move-check-tail-closure-escape
              ctx
              expr-bases
              env
              locals
              body)
              [(ResultTcUnit.Ok) ResultTcUnit.Ok]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [(TcMoveResult.Err message) (ResultTcUnit.Err message)])]
      [(TcMoveResult.Err message) (ResultTcUnit.Err message)])))

(define (tc-move-check-global-initializer-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]
  [target-ty : ast.AstType]) : ResultTcUnit
  (let
    [empty : TcMovedSet (tc-moved-empty)]
    [expr-bases : i64 (tc-context-expr-bases ctx)]
    [expr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases expr-id)]
    (match (tc-move-check-expr-id ctx expr-bases env empty empty empty expr-id)
      [(TcMoveResult.Ok moved)
        (match (tc-move-check-global-result
          ctx
          expr-bases
          env
          empty
          moved
          expr
          target-ty)
          [(TcMoveResult.Ok _) ResultTcUnit.Ok]
          [(TcMoveResult.Err message) (ResultTcUnit.Err message)])]
      [(TcMoveResult.Err message) (ResultTcUnit.Err message)])))

(define (tc-move-add-resource-shadowed-names-at
  [shadowed : TcNameIdList]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [index : i64]) : TcNameIdList
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    shadowed
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(ast.AstResourceBinding.Binding name _ _ _)
        (tc-move-add-resource-shadowed-names-at
          (tc-name-id-list-add shadowed name)
          bindings
          (+ index 1))])))

(define (tc-move-add-resource-shadowed-names
  [shadowed : TcNameIdList]
  [bindings : ast.AstResourceBindingList]) : TcNameIdList
  (tc-move-add-resource-shadowed-names-at shadowed (& bindings) 0))

(define (tc-move-check-global-result-expr-list
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [shadowed : TcNameIdList]
  [moved : TcMovedSet]
  [exprs : ast.AstExprList]
  [result-ty : ast.AstType]) : TcMoveResult
  (let
    [count : i64 (ast.ast-expr-list-len (& exprs))]
    (if (= count 0)
      (TcMoveResult.Ok moved)
      (tc-move-check-global-result-expr-id
        ctx
        expr-bases
        env
        locals
        shadowed
        moved
        (ast.ast-expr-list-get (& exprs) (- count 1) 0)
        result-ty))))

(define (tc-move-check-global-result-match-arms-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [shadowed : TcNameIdList]
  [moved : TcMovedSet]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]
  [result-ty : ast.AstType]) : TcMoveResult
  (if (>= index arms.len)
    (TcMoveResult.Ok moved)
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm pattern body-box)
        (match (tc-move-check-global-result-expr-id
          ctx
          expr-bases
          env
          locals
          (tc-pattern-add-bound-name-ids pattern shadowed)
          moved
          body-box
          result-ty)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-global-result-match-arms-at
              ctx
              expr-bases
              env
              locals
              shadowed
              moved1
              arms
              (+ index 1)
              result-ty)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)])])))

(define (tc-move-check-global-result-expr-id
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [shadowed : TcNameIdList]
  [moved : TcMovedSet]
  [expr-id : i64]
  [result-ty : ast.AstType]) : TcMoveResult
  (tc-move-check-global-result-expr
    ctx
    expr-bases
    env
    locals
    shadowed
    moved
    (ast.ast-expr-segment-bases-get expr-bases expr-id)
    result-ty))

;; Ownership-transfer sites see the value-producing leaves of control-flow and
;; scoped expressions, not merely the outer AST node. Keep lexical binders in a
;; lightweight shadow spine while descending so a local that shadows a global
;; is never misclassified as that permanent global place. This deliberately
;; avoids cloning the full move-state maps at every result branch.
(define (tc-move-check-global-result-expr
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [shadowed : TcNameIdList]
  [moved : TcMovedSet]
  [expr : ast.AstExpr]
  [result-ty : ast.AstType]) : TcMoveResult
  (tc-move-check-global-result-expr-unspanned
    ctx
    expr-bases
    env
    locals
    shadowed
    moved
    (ast.ast-expr-unspan-with-segment-bases expr-bases expr)
    result-ty))

(define (tc-move-check-global-result-expr-unspanned
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [shadowed : TcNameIdList]
  [moved : TcMovedSet]
  [expr : ast.AstExpr]
  [result-ty : ast.AstType]) : TcMoveResult
  (match expr
    [(ast.AstExpr.If _ then-box else-box)
      (match (tc-move-check-global-result-expr-id
        ctx
        expr-bases
        env
        locals
        shadowed
        moved
        then-box
        result-ty)
        [(TcMoveResult.Ok moved1)
          (tc-move-check-global-result-expr-id
            ctx
            expr-bases
            env
            locals
            shadowed
            moved1
            else-box
            result-ty)]
        [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
    [(ast.AstExpr.Let let-box)
      (match (__tl-box-place let-box)
        [(ast.AstLet.Let bindings body-box)
          (tc-move-check-global-result-expr-id
            ctx
            expr-bases
            env
            locals
            (tc-let-binding-list-add-bound-name-ids bindings shadowed)
            moved
            body-box
            result-ty)])]
    [(ast.AstExpr.Match match-box)
      (match (__tl-box-place match-box)
        [(ast.AstMatch.Match _ arms)
          (tc-move-check-global-result-match-arms-at
            ctx
            expr-bases
            env
            locals
            shadowed
            moved
            (& arms)
            0
            result-ty)])]
    [(ast.AstExpr.Begin exprs)
      (tc-move-check-global-result-expr-list
        ctx
        expr-bases
        env
        locals
        shadowed
        moved
        exprs
        result-ty)]
    [(ast.AstExpr.Unsafe exprs)
      (tc-move-check-global-result-expr-list
        ctx
        expr-bases
        env
        locals
        shadowed
        moved
        exprs
        result-ty)]
    [(ast.AstExpr.WithRegion _ exprs)
      (tc-move-check-global-result-expr-list
        ctx
        expr-bases
        env
        locals
        shadowed
        moved
        exprs
        result-ty)]
    [(ast.AstExpr.WithEscape _ exprs)
      (tc-move-check-global-result-expr-list
        ctx
        expr-bases
        env
        locals
        shadowed
        moved
        exprs
        result-ty)]
    [(ast.AstExpr.WithScratch exprs)
      (tc-move-check-global-result-expr-list
        ctx
        expr-bases
        env
        locals
        shadowed
        moved
        exprs
        result-ty)]
    [(ast.AstExpr.InArena _ exprs)
      (tc-move-check-global-result-expr-list
        ctx
        expr-bases
        env
        locals
        shadowed
        moved
        exprs
        result-ty)]
    [(ast.AstExpr.WithResource resource-box)
      (match (__tl-box-place resource-box)
        [(ast.AstWithResource.WithResource bindings body)
          (tc-move-check-global-result-expr-list
            ctx
            expr-bases
            env
            locals
            (tc-move-add-resource-shadowed-names shadowed bindings)
            moved
            body
            result-ty)])]
    [(ast.AstExpr.Ann inner-box _)
      (tc-move-check-global-result-expr-id
        ctx
        expr-bases
        env
        locals
        shadowed
        moved
        inner-box
        result-ty)]
    [(ast.AstExpr.Cast inner-box _)
      (tc-move-check-global-result-expr-id
        ctx
        expr-bases
        env
        locals
        shadowed
        moved
        inner-box
        result-ty)]
    [(ast.AstExpr.Comptime inner-box)
      (tc-move-check-global-result-expr-id
        ctx
        expr-bases
        env
        locals
        shadowed
        moved
        inner-box
        result-ty)]
    [(ast.AstExpr.Try inner-box)
      (tc-move-check-global-result-expr-id
        ctx
        expr-bases
        env
        locals
        shadowed
        moved
        inner-box
        result-ty)]
    [(ast.AstExpr.Return inner-box)
      (tc-move-check-global-result-expr-id
        ctx
        expr-bases
        env
        locals
        shadowed
        moved
        inner-box
        result-ty)]
    [(ast.AstExpr.SpmdReduce reduce-box)
      (match (__tl-box-place reduce-box)
        [(ast.AstSpmdReduce.Reduce _ index _ _ _ _ value-box)
          (tc-move-check-global-result-expr-id
            ctx
            expr-bases
            env
            locals
            (tc-name-id-list-add shadowed index)
            moved
            value-box
            result-ty)])]
    [(ast.AstExpr.SpmdScan scan-box)
      (match (__tl-box-place scan-box)
        [(ast.AstSpmdScan.Scan _ index _ _ _ prefix _ _ value-box body-box)
          (let
            [value-shadowed : TcNameIdList (tc-name-id-list-add shadowed index)]
            (match (tc-move-check-global-result-expr-id
              ctx
              expr-bases
              env
              locals
              value-shadowed
              moved
              value-box
              result-ty)
              [(TcMoveResult.Ok moved1)
                (tc-move-check-global-result-expr-id
                  ctx
                  expr-bases
                  env
                  locals
                  (tc-name-id-list-add value-shadowed prefix)
                  moved1
                  body-box
                  result-ty)]
              [(TcMoveResult.Err message) (TcMoveResult.Err message)]))])]
    [(ast.AstExpr.SpmdBroadcast value-box _)
      (tc-move-check-global-result-expr-id
        ctx
        expr-bases
        env
        locals
        shadowed
        moved
        value-box
        result-ty)]
    [(ast.AstExpr.SpmdShuffle value-box _)
      (tc-move-check-global-result-expr-id
        ctx
        expr-bases
        env
        locals
        shadowed
        moved
        value-box
        result-ty)]
    [_
      (match (tc-move-root-projection-var-id expr-bases expr)
        [(TcMaybeNameId.Some root-id)
          (if (tc-name-id-list-contains shadowed root-id)
            (TcMoveResult.Ok moved)
            (tc-move-check-global-source
              ctx
              expr-bases
              env
              locals
              moved
              expr
              (tc-move-global-source-target-move-only?
                ctx
                expr-bases
                env
                locals
                expr
                result-ty
                result-ty)))]
        [(TcMaybeNameId.No) (TcMoveResult.Ok moved)])]))

(define (tc-move-check-result-expr-list
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : ast.AstExprList]
  [result-ty : ast.AstType]) : TcMoveResult
  (let
    [count : i64 (ast.ast-expr-list-len (& exprs))]
    (if (= count 0)
      (TcMoveResult.Ok moved)
      (tc-move-check-result-expr-id
        ctx
        expr-bases
        env
        locals
        loop-carried
        moved
        (ast.ast-expr-list-get (& exprs) (- count 1) 0)
        result-ty))))

;; Reconstruct only the lexical type/local closure facts needed to classify a
;; tail result. The ordinary move walk has already checked every initializer;
;; replaying those moves here would report them twice.
(define (tc-move-result-let-binding-facts-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [loop-carried : TcMovedSet]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : TcMoveBindings
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (TcMoveBindings.Ok env moved locals loop-carried)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [binding-ty : ast.AstType
            (tc-move-binding-type-id
              "move.result_let_init"
              ctx
              env
              maybe-ty
              init-box)]
          (tc-move-result-let-binding-facts-at
            ctx
            expr-bases
            (tc-bind-c-abi-fnptr-if-needed-id ctx env name binding-ty init)
            (tc-move-add-local-binding ctx expr-bases env locals name init)
            moved
            loop-carried
            bindings
            (+ index 1)))])))

(define (tc-move-check-tail-closure-expr-list
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [exprs : ast.AstExprList]) : ResultTcUnit
  (let
    [count : i64 (ast.ast-expr-list-len (& exprs))]
    (if (= count 0)
      ResultTcUnit.Ok
      (tc-move-check-tail-closure-escape
        ctx
        expr-bases
        env
        locals
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get (& exprs) (- count 1) 0))))))

(define (tc-move-check-tail-closure-match-arms-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [scrut-ty : ast.AstType]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : ResultTcUnit
  (if (>= index arms.len)
    ResultTcUnit.Ok
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm pattern body-box)
        (match (tc-bind-match-pattern ctx env scrut-ty pattern)
          [(ResultTcEnv.Ok arm-env)
            (let
              [bound : TcNameIdList
                (tc-move-pattern-bound-names ctx scrut-ty pattern)]
              (match (tc-move-check-tail-closure-escape
                ctx
                expr-bases
                arm-env
                (tc-move-add-bound-names (tc-moved-clone locals) bound)
                (ast.ast-expr-segment-bases-get expr-bases body-box))
                [(ResultTcUnit.Ok)
                  (tc-move-check-tail-closure-match-arms-at
                    ctx
                    expr-bases
                    env
                    locals
                    scrut-ty
                    arms
                    (+ index 1))]
                [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
          [(ResultTcEnv.Err message) (ResultTcUnit.Err message)])])))

(define (tc-move-check-tail-closure-escape
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases expr)
    [(ast.AstExpr.If _ then-box else-box)
      (match (tc-move-check-tail-closure-escape
        ctx
        expr-bases
        env
        locals
        (ast.ast-expr-segment-bases-get expr-bases then-box))
        [(ResultTcUnit.Ok)
          (tc-move-check-tail-closure-escape
            ctx
            expr-bases
            env
            locals
            (ast.ast-expr-segment-bases-get expr-bases else-box))]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [(ast.AstExpr.Let let-box)
      (match (__tl-box-place let-box)
        [(ast.AstLet.Let bindings body-box)
          (match (tc-move-result-let-binding-facts-at
            ctx
            expr-bases
            env
            locals
            (tc-moved-empty)
            (tc-moved-empty)
            (& bindings)
            0)
            [(TcMoveBindings.Ok env2 _ locals2 _)
              (tc-move-check-tail-closure-escape
                ctx
                expr-bases
                env2
                locals2
                (ast.ast-expr-segment-bases-get expr-bases body-box))]
            [(TcMoveBindings.Err message) (ResultTcUnit.Err message)])])]
    [(ast.AstExpr.Match match-box)
      (match (__tl-box-place match-box)
        [(ast.AstMatch.Match scrut-box arms)
          (match (tc-body-type-fact-expr-id
            "move.result_closure_scrutinee"
            ctx
            env
            scrut-box)
            [(ResultTcType.Ok scrut-ty)
              (tc-move-check-tail-closure-match-arms-at
                ctx
                expr-bases
                env
                locals
                scrut-ty
                (& arms)
                0)]
            [(ResultTcType.Err _) ResultTcUnit.Ok])])]
    [(ast.AstExpr.Begin exprs)
      (tc-move-check-tail-closure-expr-list ctx expr-bases env locals exprs)]
    [(ast.AstExpr.Unsafe exprs)
      (tc-move-check-tail-closure-expr-list ctx expr-bases env locals exprs)]
    [(ast.AstExpr.WithRegion _ exprs)
      (tc-move-check-tail-closure-expr-list ctx expr-bases env locals exprs)]
    [(ast.AstExpr.WithEscape _ exprs)
      (tc-move-check-tail-closure-expr-list ctx expr-bases env locals exprs)]
    [(ast.AstExpr.WithScratch exprs)
      (tc-move-check-tail-closure-expr-list ctx expr-bases env locals exprs)]
    [(ast.AstExpr.InArena _ exprs)
      (tc-move-check-tail-closure-expr-list ctx expr-bases env locals exprs)]
    [(ast.AstExpr.WithResource resource-box)
      (match (__tl-box-place resource-box)
        [(ast.AstWithResource.WithResource _ body)
          (tc-move-check-tail-closure-expr-list ctx expr-bases env locals body)])]
    [(ast.AstExpr.Ann inner-box _)
      (tc-move-check-tail-closure-escape
        ctx
        expr-bases
        env
        locals
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.Cast inner-box _)
      (tc-move-check-tail-closure-escape
        ctx
        expr-bases
        env
        locals
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.Try inner-box)
      (tc-move-check-tail-closure-escape
        ctx
        expr-bases
        env
        locals
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.Return inner-box)
      (tc-move-check-tail-closure-escape
        ctx
        expr-bases
        env
        locals
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [_
      (if (tc-move-value-concrete-closure-move-only?
        ctx
        expr-bases
        env
        locals
        expr)
        (ResultTcUnit.Err
          (tc-locate-error-at-expr expr (tc-move-closure-escape-message)))
        ResultTcUnit.Ok)]))

(define (tc-move-check-result-match-arms-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]
  [result-ty : ast.AstType]
  [joined : TcMovedSet]) : TcMoveResult
  (if (>= index arms.len)
    (TcMoveResult.Ok joined)
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm _ body-box)
        (match (tc-move-check-result-expr-id
          ctx
          expr-bases
          env
          (tc-moved-clone locals)
          (tc-moved-clone loop-carried)
          (tc-moved-clone moved)
          body-box
          result-ty)
          [(TcMoveResult.Ok arm-moved)
            (tc-move-check-result-match-arms-at
              ctx
              expr-bases
              env
              locals
              loop-carried
              moved
              arms
              (+ index 1)
              result-ty
              (tc-moved-union joined arm-moved))]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)])])))

(define (tc-move-check-result-expr-id
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr-id : i64]
  [result-ty : ast.AstType]) : TcMoveResult
  (tc-move-check-result-expr
    ctx
    expr-bases
    env
    locals
    loop-carried
    moved
    (ast.ast-expr-segment-bases-get expr-bases expr-id)
    result-ty))

(define (tc-move-check-result-expr
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : ast.AstExpr]
  [result-ty : ast.AstType]) : TcMoveResult
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases expr)
    [(ast.AstExpr.If _ then-box else-box)
      (match (tc-move-check-result-expr-id
        ctx
        expr-bases
        env
        (tc-moved-clone locals)
        (tc-moved-clone loop-carried)
        (tc-moved-clone moved)
        then-box
        result-ty)
        [(TcMoveResult.Ok then-moved)
          (match (tc-move-check-result-expr-id
            ctx
            expr-bases
            env
            (tc-moved-clone locals)
            (tc-moved-clone loop-carried)
            (tc-moved-clone moved)
            else-box
            result-ty)
            [(TcMoveResult.Ok else-moved)
              (TcMoveResult.Ok (tc-moved-union then-moved else-moved))]
            [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
        [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
    [(ast.AstExpr.Let let-box)
      (match (__tl-box-place let-box)
        [(ast.AstLet.Let bindings body-box)
          (match (tc-move-result-let-binding-facts-at
            ctx
            expr-bases
            env
            locals
            moved
            loop-carried
            (& bindings)
            0)
            [(TcMoveBindings.Ok env2 moved2 locals2 loop-carried2)
              (tc-move-check-result-expr-id
                ctx
                expr-bases
                env2
                locals2
                loop-carried2
                moved2
                body-box
                result-ty)]
            [(TcMoveBindings.Err message) (TcMoveResult.Err message)])])]
    [(ast.AstExpr.Begin exprs)
      (tc-move-check-result-expr-list
        ctx
        expr-bases
        env
        locals
        loop-carried
        moved
        exprs
        result-ty)]
    [(ast.AstExpr.Unsafe exprs)
      (tc-move-check-result-expr-list
        ctx
        expr-bases
        env
        locals
        loop-carried
        moved
        exprs
        result-ty)]
    [(ast.AstExpr.WithRegion _ exprs)
      (tc-move-check-result-expr-list
        ctx
        expr-bases
        env
        locals
        loop-carried
        moved
        exprs
        result-ty)]
    [(ast.AstExpr.WithEscape _ exprs)
      (tc-move-check-result-expr-list
        ctx
        expr-bases
        env
        locals
        loop-carried
        moved
        exprs
        result-ty)]
    [(ast.AstExpr.WithScratch exprs)
      (tc-move-check-result-expr-list
        ctx
        expr-bases
        env
        locals
        loop-carried
        moved
        exprs
        result-ty)]
    [(ast.AstExpr.InArena _ exprs)
      (tc-move-check-result-expr-list
        ctx
        expr-bases
        env
        locals
        loop-carried
        moved
        exprs
        result-ty)]
    [(ast.AstExpr.Match match-box)
      (match (__tl-box-place match-box)
        [(ast.AstMatch.Match _ arms)
          (tc-move-check-result-match-arms-at
            ctx
            expr-bases
            env
            locals
            loop-carried
            moved
            (& arms)
            0
            result-ty
            moved)])]
    [(ast.AstExpr.Ann inner-box _)
      (tc-move-check-result-expr-id
        ctx
        expr-bases
        env
        locals
        loop-carried
        moved
        inner-box
        result-ty)]
    [(ast.AstExpr.Cast inner-box _)
      (tc-move-check-result-expr-id
        ctx
        expr-bases
        env
        locals
        loop-carried
        moved
        inner-box
        result-ty)]
    [(ast.AstExpr.Try inner-box)
      (tc-move-check-result-expr-id
        ctx
        expr-bases
        env
        locals
        loop-carried
        moved
        inner-box
        result-ty)]
    [_
      (tc-move-after-move-only-value
        ctx
        expr-bases
        env
        locals
        loop-carried
        moved
        (ast.ast-expr-unspan-with-segment-bases expr-bases expr)
        result-ty)]))

;; Checker-only closure facts never enter AstType or the lowering ABI. Call
;; capabilities are 0 = shared/reusable, 1 = exclusive/reusable (FnMut), and
;; 2 = consuming (FnOnce). A local lambda binding stores that capability in a
;; disjoint Copy/non-Copy range inside the existing locals map; ordinary locals
;; retain the historical -1 sentinel. This keeps concrete environment
;; copyability available after a fact-preserving local alias without making a
;; plain `(-> ...)` type depend on one particular lambda value.
(define (tc-closure-call-capability-shared) : i64
  0)

(define (tc-closure-call-capability-mut) : i64
  1)

(define (tc-closure-call-capability-once) : i64
  2)

(define (tc-closure-local-fact-copy-base) : i64
  16)

(define (tc-closure-local-fact-move-base) : i64
  32)

(define (tc-closure-local-fact-code? [code : i64]) : bool
  (or
    (and
      (>= code (tc-closure-local-fact-copy-base))
      (<= code (+ (tc-closure-local-fact-copy-base) 2)))
    (and
      (>= code (tc-closure-local-fact-move-base))
      (<= code (+ (tc-closure-local-fact-move-base) 2)))))

(define (tc-closure-local-fact-code [locals : TcMovedSet] [name-id : i64]) : i64
  (let
    [roots : tc_i64_i64_map.Map (tc-moved-roots locals)]
    (match (tc_i64_i64_map.get (& roots) name-id)
      [(tc_i64_i64_map.LookupFound code)
        (if (tc-closure-local-fact-code? code)
          code
          -1)]
      [(tc_i64_i64_map.LookupMissing) -1])))

(define (tc-closure-local-fact-copyable-code? [code : i64]) : bool
  (and
    (>= code (tc-closure-local-fact-copy-base))
    (<= code (+ (tc-closure-local-fact-copy-base) 2))))

(define (tc-closure-local-fact-move-only-code? [code : i64]) : bool
  (and
    (>= code (tc-closure-local-fact-move-base))
    (<= code (+ (tc-closure-local-fact-move-base) 2))))

(define (tc-closure-local-fact-encode [copyable : bool] [capability : i64]) : i64
  (+
    (if copyable
      (tc-closure-local-fact-copy-base)
      (tc-closure-local-fact-move-base))
    capability))

(define (tc-closure-local-fact-capability [code : i64]) : i64
  (if (tc-closure-local-fact-copyable-code? code)
    (- code (tc-closure-local-fact-copy-base))
    (if (tc-closure-local-fact-move-only-code? code)
      (- code (tc-closure-local-fact-move-base))
      (tc-closure-call-capability-shared))))

(define (tc-move-local-or-type-move-only?
  [ctx : TcContext]
  [locals : TcMovedSet]
  [name-id : i64]
  [ty : ast.AstType]) : bool
  (let
    [code : i64 (tc-closure-local-fact-code locals name-id)]
    (if (tc-closure-local-fact-code? code)
      (tc-closure-local-fact-move-only-code? code)
      (tc-type-move-only? ctx ty))))

(define (tc-move-add-capture-local
  [source-locals : TcMovedSet]
  [capture-locals : TcMovedSet]
  [name-id : i64]) : TcMovedSet
  (let
    [code : i64 (tc-closure-local-fact-code source-locals name-id)]
    (if (tc-closure-local-fact-code? code)
      (tc-moved-add-value capture-locals name-id code)
      (tc-moved-add capture-locals name-id))))

(define (tc-lambda-capture-locals-scan
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [body : ast.AstExpr]
  [seen : TcStringList]
  [source-locals : TcMovedSet]
  [locals : TcMovedSet]) : TcMovedSet
  (match (tc-type-env-marker-step env)
    [(TcTypeEnvMarkerStep.Done) locals]
    [(TcTypeEnvMarkerStep.Cache rest-env)
      (tc-lambda-capture-locals-scan
        expr-bases
        rest-env
        bound
        body
        seen
        source-locals
        locals)]
    [(TcTypeEnvMarkerStep.Bind key ty rest-env)
      (let
        [name : String (tc-env-key-name-text key)]
        (cond
          [(= key (tc-default-boundary-id)) locals]
          [(or
              (= key (tc-region-marker-id))
              (tc-cleanup-owner-marker-entry? key ty)
              (tc-ordinary-arena-owner-marker-entry? key ty)
              (tc-atomic-arena-owner-marker-entry? key ty)
              (tc-string-list-contains seen name))
            (tc-lambda-capture-locals-scan
              expr-bases
              rest-env
              bound
              body
              seen
              source-locals
              locals)]
          [else
            (tc-lambda-capture-locals-scan
              expr-bases
              rest-env
              bound
              body
              (tc-string-list-add seen name)
              source-locals
              (if (tc-expr-uses-free-name? expr-bases body name bound)
                (tc-move-add-capture-local source-locals locals key)
                locals))]))]))

(define (tc-lambda-capture-locals
  [expr-bases : i64]
  [env : TcTypeEnv]
  [source-locals : TcMovedSet]
  [params : ast.AstParamList]
  [body : ast.AstExpr]) : TcMovedSet
  (tc-lambda-capture-locals-scan
    expr-bases
    (tc-type-env-marker-start env)
    (tc-param-bound-names params)
    body
    TcStringList.Nil
    source-locals
    (tc-moved-empty)))

(define (tc-lambda-capture-has-mut-reference-scan?
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [body : ast.AstExpr]
  [seen : TcStringList]) : bool
  (match (tc-type-env-marker-step env)
    [(TcTypeEnvMarkerStep.Done) false]
    [(TcTypeEnvMarkerStep.Cache rest-env)
      (tc-lambda-capture-has-mut-reference-scan?
        expr-bases
        rest-env
        bound
        body
        seen)]
    [(TcTypeEnvMarkerStep.Bind key ty rest-env)
      (let
        [name : String (tc-env-key-name-text key)]
        (cond
          [(= key (tc-default-boundary-id)) false]
          [(or
              (= key (tc-region-marker-id))
              (tc-cleanup-owner-marker-entry? key ty)
              (tc-ordinary-arena-owner-marker-entry? key ty)
              (tc-atomic-arena-owner-marker-entry? key ty)
              (tc-string-list-contains seen name))
            (tc-lambda-capture-has-mut-reference-scan?
              expr-bases
              rest-env
              bound
              body
              seen)]
          [(and
              (tc-expr-uses-free-name? expr-bases body name bound)
              (tc-type-contains-mut-reference? ty))
            true]
          [else
            (tc-lambda-capture-has-mut-reference-scan?
              expr-bases
              rest-env
              bound
              body
              (tc-string-list-add seen name))]))]))

(define (tc-lambda-capture-has-mut-reference?
  [expr-bases : i64]
  [env : TcTypeEnv]
  [params : ast.AstParamList]
  [body : ast.AstExpr]) : bool
  (tc-lambda-capture-has-mut-reference-scan?
    expr-bases
    (tc-type-env-marker-start env)
    (tc-param-bound-names params)
    body
    TcStringList.Nil))

(define (tc-lambda-capture-has-move-only-scan?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [body : ast.AstExpr]
  [locals : TcMovedSet]
  [seen : TcStringList]) : bool
  (match (tc-type-env-marker-step env)
    [(TcTypeEnvMarkerStep.Done) false]
    [(TcTypeEnvMarkerStep.Cache rest-env)
      (tc-lambda-capture-has-move-only-scan?
        ctx
        expr-bases
        rest-env
        bound
        body
        locals
        seen)]
    [(TcTypeEnvMarkerStep.Bind key ty rest-env)
      (let
        [name : String (tc-env-key-name-text key)]
        (cond
          [(= key (tc-default-boundary-id)) false]
          [(or
              (= key (tc-region-marker-id))
              (tc-cleanup-owner-marker-entry? key ty)
              (tc-ordinary-arena-owner-marker-entry? key ty)
              (tc-atomic-arena-owner-marker-entry? key ty)
              (tc-string-list-contains seen name))
            (tc-lambda-capture-has-move-only-scan?
              ctx
              expr-bases
              rest-env
              bound
              body
              locals
              seen)]
          [(and
              (tc-expr-uses-free-name? expr-bases body name bound)
              (tc-move-local-or-type-move-only? ctx locals key ty))
            true]
          [else
            (tc-lambda-capture-has-move-only-scan?
              ctx
              expr-bases
              rest-env
              bound
              body
              locals
              (tc-string-list-add seen name))]))]))

(define (tc-lambda-capture-has-move-only-with-locals?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [params : ast.AstParamList]
  [body : ast.AstExpr]) : bool
  (tc-lambda-capture-has-move-only-scan?
    ctx
    expr-bases
    (tc-type-env-marker-start env)
    (tc-param-bound-names params)
    body
    locals
    TcStringList.Nil))

(define (tc-lambda-capture-has-move-only?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [params : ast.AstParamList]
  [body : ast.AstExpr]) : bool
  (tc-lambda-capture-has-move-only-with-locals?
    ctx
    expr-bases
    env
    (tc-moved-empty)
    params
    body))

(define (tc-move-value-concrete-closure-move-only?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases expr)
    [(ast.AstExpr.Var name-id)
      (tc-closure-local-fact-move-only-code?
        (tc-closure-local-fact-code locals name-id))]
    [(ast.AstExpr.Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(ast.AstLambda.Lambda params _ body-box)
          (tc-lambda-capture-has-move-only-with-locals?
            ctx
            expr-bases
            env
            locals
            params
            (ast.ast-expr-segment-bases-get expr-bases body-box))])]
    [_ false]))

(define (tc-move-value-move-only?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [expr : ast.AstExpr]
  [fallback-ty : ast.AstType]) : bool
  (or
    (tc-move-value-concrete-closure-move-only? ctx expr-bases env locals expr)
    (tc-type-move-only? ctx fallback-ty)))

(define (tc-lambda-capture-consumed-scan?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [body : ast.AstExpr]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [seen : TcStringList]) : bool
  (match (tc-type-env-marker-step env)
    [(TcTypeEnvMarkerStep.Done) false]
    [(TcTypeEnvMarkerStep.Cache rest-env)
      (tc-lambda-capture-consumed-scan?
        ctx
        expr-bases
        rest-env
        bound
        body
        locals
        moved
        seen)]
    [(TcTypeEnvMarkerStep.Bind key ty rest-env)
      (let
        [name : String (tc-env-key-name-text key)]
        (cond
          [(= key (tc-default-boundary-id)) false]
          [(or
              (= key (tc-region-marker-id))
              (tc-cleanup-owner-marker-entry? key ty)
              (tc-ordinary-arena-owner-marker-entry? key ty)
              (tc-atomic-arena-owner-marker-entry? key ty)
              (tc-string-list-contains seen name))
            (tc-lambda-capture-consumed-scan?
              ctx
              expr-bases
              rest-env
              bound
              body
              locals
              moved
              seen)]
          [(and
              (tc-expr-uses-free-name? expr-bases body name bound)
              (tc-move-local-or-type-move-only? ctx locals key ty)
              (match (tc-moved-root-conflict moved key)
                [(TcMoveConflict.Some _ _) true]
                [TcMoveConflict.No false]))
            true]
          [else
            (tc-lambda-capture-consumed-scan?
              ctx
              expr-bases
              rest-env
              bound
              body
              locals
              moved
              (tc-string-list-add seen name))]))]))

(define (tc-lambda-call-capability-fallback-with-locals
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [params : ast.AstParamList]
  [body : ast.AstExpr]) : i64
  (if (tc-lambda-capture-has-move-only-with-locals?
    ctx
    expr-bases
    env
    locals
    params
    body)
    (tc-closure-call-capability-once)
    (if (tc-lambda-capture-has-mut-reference? expr-bases env params body)
      (tc-closure-call-capability-mut)
      (tc-closure-call-capability-shared))))

(define (tc-lambda-call-capability-with-locals
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [params : ast.AstParamList]
  [body-id : i64]) : i64
  (let
    [expr-bases : i64 (tc-context-expr-bases ctx)]
    [body : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases body-id)]
    [capture-locals : TcMovedSet
      (tc-lambda-capture-locals expr-bases env locals params body)]
    [lambda-env : TcTypeEnv (tc-bind-params ctx env params)]
    [lambda-locals : TcMovedSet (tc-move-params-locals params capture-locals)]
    (match (tc-move-check-expr-id
      ctx
      expr-bases
      lambda-env
      lambda-locals
      (tc-moved-empty)
      (tc-moved-empty)
      body-id)
      [(TcMoveResult.Ok body-moved)
        (match (tc-expr-id ctx lambda-env body-id)
          [(ResultTcType.Ok body-ty)
            (match (tc-move-check-result-expr
              ctx
              expr-bases
              lambda-env
              lambda-locals
              (tc-moved-empty)
              body-moved
              body
              body-ty)
              [(TcMoveResult.Ok final-moved)
                (if (tc-lambda-capture-consumed-scan?
                  ctx
                  expr-bases
                  (tc-type-env-marker-start env)
                  (tc-param-bound-names params)
                  body
                  lambda-locals
                  final-moved
                  TcStringList.Nil)
                  (tc-closure-call-capability-once)
                  (if (tc-lambda-capture-has-mut-reference?
                    expr-bases
                    env
                    params
                    body)
                    (tc-closure-call-capability-mut)
                    (tc-closure-call-capability-shared)))]
              [(TcMoveResult.Err _)
                (tc-lambda-call-capability-fallback-with-locals
                  ctx
                  expr-bases
                  env
                  locals
                  params
                  body)])]
          [(ResultTcType.Err _)
            (tc-lambda-call-capability-fallback-with-locals
              ctx
              expr-bases
              env
              locals
              params
              body)])]
      [(TcMoveResult.Err _)
        (tc-lambda-call-capability-fallback-with-locals
          ctx
          expr-bases
          env
          locals
          params
          body)])))

(define (tc-lambda-call-capability
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : ast.AstParamList]
  [body-id : i64]) : i64
  (tc-lambda-call-capability-with-locals
    ctx
    env
    (tc-moved-empty)
    params
    body-id))

(define (tc-lambda-init-local-fact-code
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [init : ast.AstExpr]) : i64
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases init)
    [(ast.AstExpr.Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(ast.AstLambda.Lambda params _ body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [state : TcBodyState (tc-context-body-state ctx)]
            [cached : i64 (tc-body-closure-fact-code state body-box)]
            (if (tc-closure-local-fact-code? cached)
              cached
              (let
                [copyable : bool
                  (not
                    (tc-lambda-capture-has-move-only-with-locals?
                      ctx
                      expr-bases
                      env
                      locals
                      params
                      body))]
                [capability : i64
                  (tc-lambda-call-capability-with-locals
                    ctx
                    env
                    locals
                    params
                    body-box)]
                [code : i64 (tc-closure-local-fact-encode copyable capability)]
                (begin
                  (tc-body-closure-fact-record! state body-box code)
                  code))))])]
    [_
      (match (tc-move-bare-var expr-bases init)
        [(TcMaybeMoveName.Some name-id _)
          (tc-closure-local-fact-code locals name-id)]
        [(TcMaybeMoveName.No) -1])]))

(define (tc-move-check-closure-assignment-facts
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [target-id : i64]
  [rhs : ast.AstExpr]) : ResultTcUnit
  (let
    [target-code : i64 (tc-closure-local-fact-code locals target-id)]
    [rhs-code : i64
      (tc-lambda-init-local-fact-code ctx expr-bases env locals rhs)]
    (if (or
      (tc-closure-local-fact-move-only-code? rhs-code)
      (and
        (tc-closure-local-fact-code? target-code)
        (tc-closure-local-fact-code? rhs-code)
        (not (= target-code rhs-code))))
      (ResultTcUnit.Err
        (tc-locate-error-at-expr rhs (tc-move-closure-escape-message)))
      ResultTcUnit.Ok)))

;; --- lexical borrow conflict checker ---------------------------------------
;;
;; Borrows are lexical in this model: `begin` keeps borrows live, while
;; `let`, `with-arena`, resource `with`, lambdas, and individual match arms
;; bound their own borrow additions. Move and borrow facts share structural paths,
;; so whole roots, fields, tuple elements, and fixed-array literal elements use
;; the same ancestor/descendant conflict policy. Mutable borrows add shared and
;; exclusive facts for one path, allowing many immutable borrows but only one
;; exclusive mutable borrow.
(defenum TcBorrowCheckResult
  (Ok TcMovedSet)
  (Err String))

;; Borrow states are retained separately for ordinary continuation, the loop
;; backedge, and `break`; function exits have no successor in the current body.
(defenum TcBorrowLoopResult
  (Ok bool (Box TcMovedSet) bool (Box TcMovedSet) bool (Box TcMovedSet))
  (Err String))

(defenum TcBorrowCheckBindings
  (Ok TcTypeEnv TcMovedSet TcMovedSet)
  (Err String))

(defenum TcBorrowCheckResourceBindings
  (Ok TcTypeEnv TcMovedSet TcMovedSet)
  (Err String))

(defenum TcBorrowConflictOrigin
  (No)
  (Some i64))

(define (tc-borrow-check-move-message [path : String]) : String
  (str_cat.str-cat "typecheck: cannot move borrowed place `" path "`"))

(define (tc-borrow-check-assign-message [path : String]) : String
  (str_cat.str-cat "typecheck: cannot assign to borrowed place `" path "`"))

(define (tc-borrow-check-mutably-borrow-message [path : String]) : String
  (str_cat.str-cat "typecheck: cannot mutably borrow borrowed place `" path "`"))

(define (tc-borrow-check-immutably-borrow-message [path : String]) : String
  (str_cat.str-cat
    "typecheck: cannot immutably borrow mutably borrowed place `"
    path
    "`"))

(define (tc-borrow-check-read-message [path : String]) : String
  (str_cat.str-cat "typecheck: cannot read mutably borrowed place `" path "`"))

(define (tc-borrow-check-help) : String
  "let the last reference use occur before this operation, shorten the borrow with a narrower lexical scope, clone the owner before borrowing when ownership must move later, or use an immutable borrow for non-mutating access")

(define (tc-borrow-check-origin-label [path : String]) : String
  (str_cat.str-cat
    "borrow of `"
    path
    "` remains live because a later reference use may still depend on it"))

(define (tc-borrow-check-conflict-origin
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [kind : TcMovedPathKind]) : TcBorrowConflictOrigin
  (match (tc-moved-path-conflict-kind borrowed path kind)
    [(TcMoveConflict.Some _ origin-id) (TcBorrowConflictOrigin.Some origin-id)]
    [TcMoveConflict.No TcBorrowConflictOrigin.No]))

(define (tc-borrow-check-rich-conflict-message
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [conflict-path : TcMovePath]
  [conflict-kind : TcMovedPathKind]
  [primary : ast.AstExpr]
  [message : String]) : String
  (match (tc-expr-maybe-span primary)
    [(TcMaybeAstSourceSpan.Some primary-span)
      (match (tc-borrow-check-conflict-origin
        borrowed
        conflict-path
        conflict-kind)
        [(TcBorrowConflictOrigin.Some origin-id)
          (match (tc-expr-maybe-span
            (ast.ast-expr-segment-bases-get expr-bases origin-id))
            [(TcMaybeAstSourceSpan.Some origin-span)
              (tc-rich-error-one-secondary
                primary-span
                message
                (tc-borrow-check-help)
                origin-span
                (tc-borrow-check-origin-label
                  (tc-move-path-render conflict-path)))]
            [(TcMaybeAstSourceSpan.No)
              (tc-rich-error-one-secondary
                primary-span
                message
                (tc-borrow-check-help)
                primary-span
                (tc-borrow-check-origin-label
                  (tc-move-path-render conflict-path)))])]
        [(TcBorrowConflictOrigin.No)
          (tc-rich-error-one-secondary
            primary-span
            message
            (tc-borrow-check-help)
            primary-span
            (tc-borrow-check-origin-label (tc-move-path-render conflict-path)))])]
    [(TcMaybeAstSourceSpan.No)
      (match (tc-borrow-check-conflict-origin
        borrowed
        conflict-path
        conflict-kind)
        [(TcBorrowConflictOrigin.Some origin-id)
          (match (tc-expr-maybe-span
            (ast.ast-expr-segment-bases-get expr-bases origin-id))
            [(TcMaybeAstSourceSpan.Some origin-span)
              (tc-rich-error-one-secondary
                origin-span
                message
                (tc-borrow-check-help)
                origin-span
                (tc-borrow-check-origin-label
                  (tc-move-path-render conflict-path)))]
            [(TcMaybeAstSourceSpan.No) message])]
        [(TcBorrowConflictOrigin.No) message])]))

;; Lending borrows retain the ordinary place path for conflict checks and add
;; a non-conflicting marker that identifies the result binding for NLL pruning.
(define (tc-borrow-check-lending-binding-at
  [facts : TcMovedPathFacts]
  [path : TcMovePath]) : TcMaybeNameId
  (if (tc-moved-path-facts-empty? facts)
    (TcMaybeNameId.No)
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      (if (tc-move-path-eq? fact.path path)
        (match fact.kind
          [(TcMovedPathKind.BorrowLending binding-id)
            (TcMaybeNameId.Some binding-id)]
          [_ (tc-borrow-check-lending-binding-at rest path)])
        (tc-borrow-check-lending-binding-at rest path)))))

(define (tc-borrow-check-lending-binding
  [facts : TcMovedPathFacts]
  [path : TcMovePath]) : TcMaybeNameId
  (tc-borrow-check-lending-binding-at facts path))

(define (tc-borrow-check-lending-binding?
  [facts : TcMovedPathFacts]
  [path : TcMovePath]) : bool
  (match (tc-borrow-check-lending-binding facts path)
    [(TcMaybeNameId.Some _) true]
    [(TcMaybeNameId.No) false]))

(define (tc-borrow-check-has-lending-binding?
  [borrowed : TcMovedSet]
  [path : TcMovePath]) : bool
  (tc-borrow-check-lending-binding? (tc-moved-paths borrowed) path))

(define (tc-borrow-check-lending-binding-used-at?
  [facts : TcMovedPathFacts]
  [path : TcMovePath]
  [binding-id : i64]) : bool
  (if (tc-moved-path-facts-empty? facts)
    false
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      (if (and
        (tc-move-path-eq? fact.path path)
        (match fact.kind
          [(TcMovedPathKind.BorrowLendingUsed used-id) (= used-id binding-id)]
          [_ false]))
        true
        (tc-borrow-check-lending-binding-used-at? rest path binding-id)))))

(define (tc-borrow-check-note-lending-use-at
  [facts : TcMovedPathFacts]
  [binding-id : i64]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [out2 : TcMovedSet
        (match fact.kind
          [(TcMovedPathKind.BorrowLending fact-binding-id)
            (if (= fact-binding-id binding-id)
              (tc-moved-add-path-fact
                out
                fact.path
                (TcMovedPathKind.BorrowLendingUsed binding-id)
                (tc-moved-path-fact-origin fact))
              out)]
          [_ out])]
      (tc-borrow-check-note-lending-use-at rest binding-id out2))))

(define (tc-borrow-check-note-lending-use
  [borrowed : TcMovedSet]
  [binding-id : i64]) : TcMovedSet
  (tc-borrow-check-note-lending-use-at
    (tc-moved-paths borrowed)
    binding-id
    borrowed))

(define (tc-borrow-check-propagate-lending-uses-at
  [facts : TcMovedPathFacts]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [out2 : TcMovedSet
        (match fact.kind
          [(TcMovedPathKind.BorrowLendingUsed _)
            (let
              [path : TcMovePath fact.path]
              (match (tc-borrow-check-lending-binding (tc-moved-paths out) path)
                [(TcMaybeNameId.Some binding-id)
                  (tc-moved-add-path-fact
                    out
                    path
                    (TcMovedPathKind.BorrowLendingUsed binding-id)
                    (tc-moved-path-fact-origin fact))]
                [(TcMaybeNameId.No) out]))]
          [_ out])]
      (tc-borrow-check-propagate-lending-uses-at rest out2))))

(define (tc-borrow-check-propagate-lending-uses
  [from : TcMovedSet]
  [to : TcMovedSet]) : TcMovedSet
  (tc-borrow-check-propagate-lending-uses-at (tc-moved-paths from) to))

;; A directly called lambda is checked in its own borrow state, so free
;; reference reads in its body cannot update the enclosing lending markers by
;; ordinary state propagation. Record those captures at the call boundary;
;; unlike a stored closure, the direct call itself is the capture's use site.
(define (tc-borrow-check-note-called-lambda-capture-uses-at
  [expr-bases : i64]
  [body : ast.AstExpr]
  [bound : TcStringList]
  [facts : TcMovedPathFacts]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [out2 : TcMovedSet
        (match fact.kind
          [(TcMovedPathKind.BorrowLending binding-id)
            (if (tc-expr-uses-free-name?
              expr-bases
              body
              (tc-env-key-name-text binding-id)
              bound)
              (tc-moved-add-path-fact
                out
                fact.path
                (TcMovedPathKind.BorrowLendingUsed binding-id)
                (tc-moved-path-fact-origin fact))
              out)]
          [_ out])]
      (tc-borrow-check-note-called-lambda-capture-uses-at
        expr-bases
        body
        bound
        rest
        out2))))

(define (tc-borrow-check-note-called-lambda-capture-uses
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [func : ast.AstExpr]) : TcMovedSet
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases func)
    [(ast.AstExpr.Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(ast.AstLambda.Lambda params _ body-box)
          (tc-borrow-check-note-called-lambda-capture-uses-at
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases body-box)
            (tc-param-bound-names params)
            (tc-moved-paths borrowed)
            borrowed)])]
    [_ borrowed]))

(define (tc-borrow-check-add-lending-marker
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [binding-id : i64]
  [origin : ast.AstExpr]) : TcMovedSet
  (tc-moved-add-path-fact
    borrowed
    path
    (TcMovedPathKind.BorrowLending binding-id)
    (ast.ast-node-push origin)))

(define (tc-borrow-check-split-provenance-for-binding-at
  [facts : TcMovedPathFacts]
  [binding-id : i64]
  [half : i64]
  [select-half : bool]) : TcMaybeMovePath
  (if (tc-moved-path-facts-empty? facts)
    (TcMaybeMovePath.No)
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      (if (and
        (match fact.kind
          [(TcMovedPathKind.BorrowLending fact-binding-id)
            (= fact-binding-id binding-id)]
          [_ false])
        (if select-half
          (tc-move-path-slice-half? fact.path half)
          (or
            (tc-move-path-slice-half? fact.path 0)
            (tc-move-path-slice-half? fact.path 1))))
        (TcMaybeMovePath.Some fact.path)
        (tc-borrow-check-split-provenance-for-binding-at
          rest
          binding-id
          half
          select-half)))))

(define (tc-borrow-check-split-provenance
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [source : ast.AstExpr]) : TcMaybeMovePath
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases source)
    [(ast.AstExpr.Var binding-id)
      (match (tc-borrow-check-split-provenance-for-binding-at
        (tc-moved-paths borrowed)
        binding-id
        0
        false)
        [(TcMaybeMovePath.Some path) (TcMaybeMovePath.Some path)]
        [(TcMaybeMovePath.No) (tc-borrow-check-place-path expr-bases source)])]
    [(ast.AstExpr.TupleRef tuple-box half)
      (let
        [tuple-expr : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases tuple-box)]
        (match (ast.ast-expr-unspan-with-segment-bases expr-bases tuple-expr)
          [(ast.AstExpr.Var binding-id)
            (match (tc-borrow-check-split-provenance-for-binding-at
              (tc-moved-paths borrowed)
              binding-id
              half
              true)
              [(TcMaybeMovePath.Some path) (TcMaybeMovePath.Some path)]
              [(TcMaybeMovePath.No)
                (tc-borrow-check-place-path expr-bases source)])]
          [_ (tc-borrow-check-place-path expr-bases source)]))]
    [(ast.AstExpr.Ann inner-box _)
      (tc-borrow-check-split-provenance
        expr-bases
        borrowed
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.Cast inner-box _)
      (tc-borrow-check-split-provenance
        expr-bases
        borrowed
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [_ (tc-borrow-check-place-path expr-bases source)]))

(define (tc-borrow-check-split-projection
  [expr-bases : i64]
  [expr : ast.AstExpr]) : TcMaybeSliceSplitProjection
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases expr)
    [(ast.AstExpr.TupleRef tuple-box half)
      (match (ast.ast-expr-unspan-with-segment-bases
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases tuple-box))
        [(ast.AstExpr.Var binding-id)
          (TcMaybeSliceSplitProjection.Some binding-id half)]
        [_ (TcMaybeSliceSplitProjection.No)])]
    [(ast.AstExpr.Ann inner-box _)
      (tc-borrow-check-split-projection
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.Cast inner-box _)
      (tc-borrow-check-split-projection
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [_ (TcMaybeSliceSplitProjection.No)]))

(define (tc-borrow-check-rebind-split-projection-at
  [facts : TcMovedPathFacts]
  [source-binding-id : i64]
  [half : i64]
  [binding-id : i64]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [copy : bool
        (match fact.kind
          [(TcMovedPathKind.BorrowLending fact-binding-id)
            (and
              (= fact-binding-id source-binding-id)
              (or
                (and
                  (not (tc-move-path-slice-half? fact.path 0))
                  (not (tc-move-path-slice-half? fact.path 1)))
                (tc-move-path-slice-half? fact.path half)))]
          [_ false])]
      [out2 : TcMovedSet
        (if copy
          (tc-moved-add-path-fact
            out
            fact.path
            (TcMovedPathKind.BorrowLending binding-id)
            (tc-moved-path-fact-origin fact))
          out)]
      (tc-borrow-check-rebind-split-projection-at
        rest
        source-binding-id
        half
        binding-id
        out2))))

(define (tc-borrow-check-binding-has-split-provenance?
  [facts : TcMovedPathFacts]
  [binding-id : i64]) : bool
  (if (tc-moved-path-facts-empty? facts)
    false
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      (if (and
        (match fact.kind
          [(TcMovedPathKind.BorrowLending fact-binding-id)
            (= fact-binding-id binding-id)]
          [_ false])
        (or
          (tc-move-path-slice-half? fact.path 0)
          (tc-move-path-slice-half? fact.path 1)))
        true
        (tc-borrow-check-binding-has-split-provenance? rest binding-id)))))

(define (tc-borrow-check-rebind-split-projection
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [binding-id : i64]
  [init : ast.AstExpr]) : TcMovedSet
  (match (tc-borrow-check-split-projection expr-bases init)
    [(TcMaybeSliceSplitProjection.Some source-binding-id half)
      (if (tc-borrow-check-binding-has-split-provenance?
        (tc-moved-paths borrowed)
        source-binding-id)
        (tc-borrow-check-rebind-split-projection-at
          (tc-moved-paths borrowed)
          source-binding-id
          half
          binding-id
          borrowed)
        borrowed)]
    [(TcMaybeSliceSplitProjection.No) borrowed]))

(define (tc-borrow-check-remove-root-state
  [borrowed : TcMovedSet]
  [name-id : i64]) : TcMovedSet
  (tc-moved-remove-root-state borrowed name-id))

(define (tc-moved-path-facts-remove-lending
  [facts : TcMovedPathFacts]
  [path : TcMovePath]) : TcMovedPathFacts
  (tc-moved-path-facts-filter facts (TcMovedPathFactsFilter.Lending path)))

(define (tc-borrow-check-remove-borrow-path
  [borrowed : TcMovedSet]
  [path : TcMovePath]) : TcMovedSet
  (let
    [without-shared : TcMovedSet
      (tc-moved-remove-path-kind borrowed path (TcMovedPathKind.BorrowShared))]
    [without-mut : TcMovedSet
      (tc-moved-remove-path-kind
        without-shared
        path
        (TcMovedPathKind.BorrowMut))]
    [without-two-phase : TcMovedSet
      (tc-moved-remove-path-kind
        without-mut
        path
        (TcMovedPathKind.BorrowTwoPhaseMut))]
    [facts : TcMovedPathFacts
      (tc-moved-path-facts-remove-lending
        (tc-moved-paths without-two-phase)
        path)]
    (TcMovedSet
      (tc-moved-roots without-two-phase)
      (tc-moved-partials without-two-phase)
      facts
      (tc-moved-hidden-atomic-users without-two-phase)
      (tc-moved-param-storage-origins without-two-phase))))

(define (tc-borrow-check-two-phase-mut-conflict
  [borrowed : TcMovedSet]
  [path : TcMovePath]) : TcMoveConflict
  (tc-moved-path-conflict-kind
    borrowed
    path
    (TcMovedPathKind.BorrowTwoPhaseMut)))

(define (tc-borrow-check-two-phase-mut-conflict-message
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [primary : ast.AstExpr]
  [message : String]) : String
  (tc-borrow-check-rich-conflict-message
    expr-bases
    borrowed
    path
    (TcMovedPathKind.BorrowTwoPhaseMut)
    primary
    message))

(define (tc-borrow-check-path-lifetime
  [ctx : TcContext]
  [env : TcTypeEnv]
  [path : TcMovePath]) : i64
  (let
    [root-id : i64 (tc-move-path-root-id path)]
    (match (tc-lookup-visible-id ctx env root-id)
      [(ResultTcType.Ok ty)
        (let
          [resolved : ast.AstType (tc-resolve-type ctx ty)]
          (match (tc-type-strip-region resolved)
            [(ast.AstType.Ref lifetime _) lifetime]
            [(ast.AstType.MutRef lifetime _) lifetime]
            [_
              (match (tc-type-outer-region resolved)
                [(TcMaybeNameId.Some region) region]
                [(TcMaybeNameId.No) root-id])]))]
      [(ResultTcType.Err _) root-id])))

(define (tc-borrow-check-root-in-scope?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [root-id : i64]) : bool
  (or
    (tc-moved-contains? locals root-id)
    (match (tc-lookup-visible-id ctx env root-id)
      [(ResultTcType.Ok _) true]
      [(ResultTcType.Err _) false])))

(define (tc-borrow-check-type-contains-lifetime?
  [ctx : TcContext]
  [ty : ast.AstType]
  [lifetime : i64]) : bool
  ;; A primary body error can leave poison bindings in the diagnostic env.
  ;; Secondary borrow analysis must not try to intern the poison sentinel.
  (if (tc-poison-type? ty)
    false
    (tc-name-id-list-contains
      (tc-type-collect-reference-lifetimes (tc-resolve-type ctx ty))
      lifetime)))

(define (tc-borrow-check-binding-stores-lifetime?
  [ctx : TcContext]
  [ty : ast.AstType]
  [lifetime : i64]) : bool
  (if (tc-poison-type? ty)
    false
    (match (tc-type-strip-region (tc-resolve-type ctx ty))
      [(ast.AstType.Func _ ret)
        (tc-borrow-check-type-contains-lifetime?
          ctx
          (ast.ty-node-get ret)
          lifetime)]
      [_ (tc-borrow-check-type-contains-lifetime? ctx ty lifetime)])))

(define (tc-borrow-check-env-lifetime-used-in-exprs?
  [expr-bases : i64]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [exprs : ast.AstExprList]
  [lifetime : i64]
  [seen : TcStringList]
  [remaining : i64]) : bool
  ;; Only lexical bindings can carry this function-local lifetime. Follow
  ;; scan-through caches that compact a local prefix, but stop after every
  ;; live local has been seen instead of depending on the module cache shape.
  (if (<= remaining 0)
    false
    (match (tc-type-env-marker-step env)
      [(TcTypeEnvMarkerStep.Done) false]
      [(TcTypeEnvMarkerStep.Cache rest-env)
        (tc-borrow-check-env-lifetime-used-in-exprs?
          expr-bases
          ctx
          rest-env
          locals
          exprs
          lifetime
          seen
          remaining)]
      [(TcTypeEnvMarkerStep.Bind name-id ty rest-env)
        (if (= name-id (tc-default-boundary-id))
          false
          (begin
            (cfg
              compile-profile
              (compiler-tc-env-profile-borrow-lifetime-scan-note-binding!))
            (let
              [name : String (tc-env-key-name-text name-id)]
              (cond
                [(tc-string-list-contains seen name)
                  (tc-borrow-check-env-lifetime-used-in-exprs?
                    expr-bases
                    ctx
                    rest-env
                    locals
                    exprs
                    lifetime
                    seen
                    remaining)]
                [(not (tc-moved-contains? locals name-id))
                  (tc-borrow-check-env-lifetime-used-in-exprs?
                    expr-bases
                    ctx
                    rest-env
                    locals
                    exprs
                    lifetime
                    (tc-string-list-add seen name)
                    remaining)]
                [(and
                    (tc-borrow-check-binding-stores-lifetime? ctx ty lifetime)
                    (tc-expr-list-uses-free-name?
                      expr-bases
                      exprs
                      name
                      TcStringList.Nil))
                  true]
                [else
                  (tc-borrow-check-env-lifetime-used-in-exprs?
                    expr-bases
                    ctx
                    rest-env
                    locals
                    exprs
                    lifetime
                    (tc-string-list-add seen name)
                    (- remaining 1))]))))])))

(define (tc-borrow-check-lifetime-used-in-exprs?
  [expr-bases : i64]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [exprs : ast.AstExprList]
  [lifetime : i64]) : bool
  (begin
    (cfg compile-profile (compiler-tc-env-profile-borrow-lifetime-scan-start!))
    (let
      [used : bool
        (tc-borrow-check-env-lifetime-used-in-exprs?
          expr-bases
          ctx
          env
          locals
          exprs
          lifetime
          TcStringList.Nil
          (tc-moved-len locals))]
      (begin
        (cfg
          compile-profile
          (compiler-tc-env-profile-borrow-lifetime-scan-finish!))
        used))))

;; A lexical child scope can return a reference whose source borrow was created
;; inside that scope. Retain the source path at the enclosing scope when its
;; lifetime appears in the result, while dropping child-local state and NLL
;; markers. This preserves the actual source projection instead of collapsing
;; it to the lifetime root.
(define (tc-borrow-check-result-expr-list-path
  [expr-bases : i64]
  [locals : TcMovedSet]
  [exprs : ast.AstExprList]) : TcMaybeMovePath
  (if (ast.ast-expr-list-empty? (& exprs))
    (TcMaybeMovePath.No)
    (tc-borrow-check-result-direct-borrow-path
      expr-bases
      locals
      (ast.ast-expr-segment-bases-get
        expr-bases
        (ast.ast-expr-list-get (& exprs) (- exprs.len 1) 0)))))

;; Recover a direct place borrow from the value position of an expression.
;; Indirect call/aggregate results deliberately return No so their existing
;; lifetime-based propagation remains conservative.
(define (tc-borrow-check-result-direct-borrow-path
  [expr-bases : i64]
  [locals : TcMovedSet]
  [expr : ast.AstExpr]) : TcMaybeMovePath
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases expr)
    [(ast.AstExpr.Borrow _ _ place-box)
      (match (tc-borrow-check-place-path
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases place-box))
        [(TcMaybeMovePath.Some path) (TcMaybeMovePath.Some path)]
        [(TcMaybeMovePath.No) (TcMaybeMovePath.No)])]
    [(ast.AstExpr.Begin exprs)
      (tc-borrow-check-result-expr-list-path expr-bases locals exprs)]
    [(ast.AstExpr.Unsafe exprs)
      (tc-borrow-check-result-expr-list-path expr-bases locals exprs)]
    [(ast.AstExpr.Ann inner-box _)
      (tc-borrow-check-result-direct-borrow-path
        expr-bases
        locals
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.Cast inner-box _)
      (tc-borrow-check-result-direct-borrow-path
        expr-bases
        locals
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.Comptime inner-box)
      (tc-borrow-check-result-direct-borrow-path
        expr-bases
        locals
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.Try inner-box)
      (tc-borrow-check-result-direct-borrow-path
        expr-bases
        locals
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [_ (TcMaybeMovePath.No)]))

(define (tc-borrow-check-propagate-return-borrows-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [outer-locals : TcMovedSet]
  [facts : TcMovedPathFacts]
  [result-lifetimes : TcNameIdList]
  [direct-path : TcMaybeMovePath]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [path : TcMovePath fact.path]
      [kind : TcMovedPathKind fact.kind]
      [keep-kind : bool
        (match kind
          [(TcMovedPathKind.BorrowShared) true]
          [(TcMovedPathKind.BorrowMut) true]
          [_ false])]
      [keep-direct : bool
        (match direct-path
          [(TcMaybeMovePath.Some direct) (tc-move-path-conflicts? path direct)]
          [(TcMaybeMovePath.No) true])]
      [missing : bool
        (match (tc-moved-path-exact-conflict-kind out path kind)
          [(TcMoveConflict.Some _ _) false]
          [TcMoveConflict.No true])]
      [out2 : TcMovedSet
        (if (and
          keep-kind
          (tc-borrow-check-root-in-scope?
            ctx
            env
            outer-locals
            (tc-move-path-root-id path))
          (tc-name-id-list-contains
            result-lifetimes
            (tc-borrow-check-path-lifetime ctx env path))
          keep-direct
          missing)
          (tc-moved-add-path-fact
            out
            path
            kind
            (tc-moved-path-fact-origin fact))
          out)]
      (tc-borrow-check-propagate-return-borrows-at
        ctx
        env
        outer-locals
        rest
        result-lifetimes
        direct-path
        out2))))

(define (tc-borrow-check-propagate-return-borrows
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [outer-locals : TcMovedSet]
  [outer-borrowed : TcMovedSet]
  [inner-borrowed : TcMovedSet]
  [result-ty : ast.AstType]
  [result-expr : ast.AstExpr]) : TcMovedSet
  ;; The protected outer state cannot be pruned while checking the child.
  ;; Therefore an unchanged entry count proves that the child introduced no
  ;; source borrow to propagate and avoids a result-type walk on ordinary lets.
  (if (<= (tc-moved-len inner-borrowed) (tc-moved-len outer-borrowed))
    outer-borrowed
    (let
      [result-lifetimes : TcNameIdList
        (tc-type-collect-reference-lifetimes (tc-resolve-type ctx result-ty))]
      (match result-lifetimes
        [TcNameIdList.Nil outer-borrowed]
        [_
          (tc-borrow-check-propagate-return-borrows-at
            ctx
            env
            outer-locals
            (tc-moved-paths inner-borrowed)
            result-lifetimes
            (tc-borrow-check-result-direct-borrow-path
              expr-bases
              outer-locals
              result-expr)
            (tc-moved-clone outer-borrowed))]))))

(define (tc-borrow-check-mark-new-return-borrows-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [prior : TcMovedSet]
  [facts : TcMovedPathFacts]
  [binding-id : i64]
  [result-lifetimes : TcNameIdList]
  [origin : ast.AstExpr]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [path : TcMovePath fact.path]
      [shared : bool
        (match fact.kind
          [(TcMovedPathKind.BorrowShared) true]
          [_ false])]
      [new : bool
        (match (tc-moved-path-exact-conflict-kind prior path fact.kind)
          [(TcMoveConflict.Some _ _) false]
          [TcMoveConflict.No true])]
      [out2 : TcMovedSet
        (if (and
          shared
          new
          (tc-borrow-check-root-in-scope?
            ctx
            env
            locals
            (tc-move-path-root-id path))
          (tc-name-id-list-contains
            result-lifetimes
            (tc-borrow-check-path-lifetime ctx env path)))
          (tc-borrow-check-add-lending-marker out path binding-id origin)
          out)]
      (tc-borrow-check-mark-new-return-borrows-at
        ctx
        env
        locals
        prior
        rest
        binding-id
        result-lifetimes
        origin
        out2))))

;; A propagated returned borrow needs an NLL marker for the outer result
;; binding. Mark only source paths newly introduced by the initializer; this
;; keeps pre-existing unrelated borrows untouched and removes both shared and
;; mutable source state after the binding's last use.
(define (tc-borrow-check-mark-new-return-borrows
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [prior : TcMovedSet]
  [borrowed : TcMovedSet]
  [binding-id : i64]
  [result-ty : ast.AstType]
  [origin : ast.AstExpr]) : TcMovedSet
  ;; Initializer checking protects the incoming state. Equal entry counts mean
  ;; there is no newly propagated source borrow that needs an NLL marker.
  (if (<= (tc-moved-len borrowed) (tc-moved-len prior))
    borrowed
    (let
      [result-lifetimes : TcNameIdList
        (tc-type-collect-reference-lifetimes (tc-resolve-type ctx result-ty))]
      (match result-lifetimes
        [TcNameIdList.Nil borrowed]
        [_
          (tc-borrow-check-mark-new-return-borrows-at
            ctx
            env
            locals
            prior
            (tc-moved-paths borrowed)
            binding-id
            result-lifetimes
            origin
            (tc-moved-clone borrowed))]))))

(define (tc-borrow-check-protected-path?
  [protected : TcMovedSet]
  [path : TcMovePath]) : bool
  (or
    (match (tc-moved-path-conflict-kind
      protected
      path
      (TcMovedPathKind.BorrowShared))
      [(TcMoveConflict.Some _ _) true]
      [TcMoveConflict.No false])
    (match (tc-moved-path-conflict-kind
      protected
      path
      (TcMovedPathKind.BorrowMut))
      [(TcMoveConflict.Some _ _) true]
      [TcMoveConflict.No false])))

(define (tc-borrow-check-pending-path-at?
  [facts : TcMovedPathFacts]
  [path : TcMovePath]) : bool
  (if (tc-moved-path-facts-empty? facts)
    false
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      (if (and
        (tc-move-path-eq? fact.path path)
        (match fact.kind
          [(TcMovedPathKind.BorrowPending _) true]
          [_ false]))
        true
        (tc-borrow-check-pending-path-at? rest path)))))

;; Sequence walkers do not need to scan their full remaining syntax eagerly.
;; Guard every lending borrow while a later sibling exists; if the current
;; expression reports a conflict, the existing retry path performs the precise
;; free-name/lifetime scan before deciding whether the guard is still needed.
(define (tc-borrow-check-add-all-pending-markers-at
  [scope-id : i64]
  [facts : TcMovedPathFacts]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [out2 : TcMovedSet
        (match fact.kind
          [(TcMovedPathKind.BorrowLending _)
            (tc-moved-add-path-fact
              out
              fact.path
              (TcMovedPathKind.BorrowPending scope-id)
              (tc-moved-path-fact-origin fact))]
          [_ out])]
      (tc-borrow-check-add-all-pending-markers-at scope-id rest out2))))

(define (tc-borrow-check-add-all-pending-markers
  [borrowed : TcMovedSet]
  [pending-exprs : ast.AstExprList]
  [scope-id : i64]) : TcMovedSet
  (if (or
    (ast.ast-expr-list-empty? (& pending-exprs))
    (= (tc-moved-len borrowed) 0))
    borrowed
    (tc-borrow-check-add-all-pending-markers-at
      scope-id
      (tc-moved-paths borrowed)
      borrowed)))

(define (tc-moved-path-facts-remove-pending-scope
  [facts : TcMovedPathFacts]
  [scope-id : i64]) : TcMovedPathFacts
  (tc-moved-path-facts-filter facts (TcMovedPathFactsFilter.Pending scope-id)))

(define (tc-borrow-check-remove-pending-markers
  [borrowed : TcMovedSet]
  [scope-id : i64]) : TcMovedSet
  (TcMovedSet
    (tc-moved-roots borrowed)
    (tc-moved-partials borrowed)
    (tc-moved-path-facts-remove-pending-scope
      (tc-moved-paths borrowed)
      scope-id)
    (tc-moved-hidden-atomic-users borrowed)
    (tc-moved-param-storage-origins borrowed)))

(define (tc-borrow-check-prune-before-exprs-loop
  [expr-bases : i64]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [exprs : ast.AstExprList]
  [protected : TcMovedSet]
  [facts : TcMovedPathFacts]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [path : TcMovePath fact.path]
      [shared : bool
        (match fact.kind
          [(TcMovedPathKind.BorrowShared) true]
          [_ false])]
      [out2 : TcMovedSet
        (if (or
          (not shared)
          (tc-borrow-check-pending-path-at? (tc-moved-paths out) path)
          (and
            (not (tc-borrow-check-has-lending-binding? out path))
            (tc-borrow-check-protected-path? protected path)))
          out
          (match (tc-borrow-check-lending-binding (tc-moved-paths out) path)
            [(TcMaybeNameId.Some lending-binding-id)
              (cond
                [(not
                    (tc-borrow-check-lending-binding-used-at?
                      (tc-moved-paths out)
                      path
                      lending-binding-id))
                  out]
                [(tc-expr-list-uses-free-name?
                    expr-bases
                    exprs
                    (tc-env-key-name-text lending-binding-id)
                    TcStringList.Nil)
                  out]
                [(tc-borrow-check-lifetime-used-in-exprs?
                    expr-bases
                    ctx
                    env
                    locals
                    exprs
                    (tc-borrow-check-path-lifetime ctx env path))
                  (tc-moved-remove-path-kind
                    out
                    path
                    (TcMovedPathKind.BorrowLending lending-binding-id))]
                [else (tc-borrow-check-remove-borrow-path out path)])]
            [(TcMaybeNameId.No)
              (if (tc-borrow-check-lifetime-used-in-exprs?
                expr-bases
                ctx
                env
                locals
                exprs
                (tc-borrow-check-path-lifetime ctx env path))
                out
                (tc-borrow-check-remove-borrow-path out path))]))]
      (tc-borrow-check-prune-before-exprs-loop
        expr-bases
        ctx
        env
        locals
        exprs
        protected
        rest
        out2))))

(define (tc-borrow-check-prune-before-exprs
  [expr-bases : i64]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : ast.AstExprList]) : TcMovedSet
  (if (or (ast.ast-expr-list-empty? (& exprs)) (= (tc-moved-len borrowed) 0))
    borrowed
    (tc-borrow-check-prune-before-exprs-loop
      expr-bases
      ctx
      env
      locals
      exprs
      protected
      (tc-moved-paths borrowed)
      borrowed)))

(define (tc-borrow-check-place-path [expr-bases : i64] [expr : ast.AstExpr]) : TcMaybeMovePath
  (match (tc-move-root-projection-var-id expr-bases expr)
    [(TcMaybeNameId.Some root-id)
      (match (tc-move-direct-root-base-path expr-bases expr)
        [(TcMaybeMovePath.Some path) (TcMaybeMovePath.Some path)]
        [(TcMaybeMovePath.No)
          (TcMaybeMovePath.Some
            (TcMovePath root-id (tc-move-path-segments-empty)))])]
    [(TcMaybeNameId.No) (TcMaybeMovePath.No)]))

(define (tc-borrow-check-add-borrow-path
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [mutable : bool]
  [origin : ast.AstExpr]) : TcMovedSet
  (let
    [origin-id : i64 (ast.ast-node-push origin)]
    [borrowed1 : TcMovedSet
      (tc-moved-add-path-fact
        borrowed
        path
        (TcMovedPathKind.BorrowShared)
        origin-id)]
    (if mutable
      (tc-moved-add-path-fact
        borrowed1
        path
        (TcMovedPathKind.BorrowMut)
        origin-id)
      borrowed1)))

(define (tc-borrow-check-add-two-phase-mut-borrow-path
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [origin : ast.AstExpr]) : TcMovedSet
  (tc-moved-add-path-fact
    borrowed
    path
    (TcMovedPathKind.BorrowTwoPhaseMut)
    (ast.ast-node-push origin)))

(define (tc-borrow-check-add-two-phase-mut-place
  [expr-bases : i64]
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [place : ast.AstExpr]
  [origin : ast.AstExpr]) : TcBorrowCheckResult
  (match (tc-borrow-check-place-path expr-bases place)
    [(TcMaybeMovePath.Some path)
      (match (tc-borrow-check-mutably-borrow-conflict
        expr-bases
        borrowed
        path
        origin)
        [(ResultTcUnit.Ok)
          (TcBorrowCheckResult.Ok
            (tc-borrow-check-add-two-phase-mut-borrow-path borrowed path origin))]
        [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])]
    [(TcMaybeMovePath.No) (TcBorrowCheckResult.Ok borrowed)]))

(define (tc-borrow-check-remove-two-phase-mut-place
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [place : ast.AstExpr]) : TcMovedSet
  (match (tc-borrow-check-place-path expr-bases place)
    [(TcMaybeMovePath.Some path)
      (tc-moved-remove-path-kind
        borrowed
        path
        (TcMovedPathKind.BorrowTwoPhaseMut))]
    [(TcMaybeMovePath.No) borrowed]))

(define (tc-borrow-check-move-conflict
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [primary : ast.AstExpr]) : ResultTcUnit
  (if (tc-moved-path-conflict? borrowed path)
    (ResultTcUnit.Err
      (tc-borrow-check-rich-conflict-message
        expr-bases
        borrowed
        path
        (TcMovedPathKind.BorrowShared)
        primary
        (tc-borrow-check-move-message (tc-move-path-render path))))
    (match (tc-borrow-check-two-phase-mut-conflict borrowed path)
      [(TcMoveConflict.Some _ _)
        (ResultTcUnit.Err
          (tc-borrow-check-two-phase-mut-conflict-message
            expr-bases
            borrowed
            path
            primary
            (tc-borrow-check-move-message (tc-move-path-render path))))]
      [TcMoveConflict.No ResultTcUnit.Ok])))

(define (tc-borrow-check-assign-conflict
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [primary : ast.AstExpr]) : ResultTcUnit
  (if (tc-moved-path-conflict? borrowed path)
    (ResultTcUnit.Err
      (tc-borrow-check-rich-conflict-message
        expr-bases
        borrowed
        path
        (TcMovedPathKind.BorrowShared)
        primary
        (tc-borrow-check-assign-message (tc-move-path-render path))))
    (match (tc-borrow-check-two-phase-mut-conflict borrowed path)
      [(TcMoveConflict.Some _ _)
        (ResultTcUnit.Err
          (tc-borrow-check-two-phase-mut-conflict-message
            expr-bases
            borrowed
            path
            primary
            (tc-borrow-check-assign-message (tc-move-path-render path))))]
      [TcMoveConflict.No ResultTcUnit.Ok])))

(define (tc-borrow-check-mutably-borrow-conflict
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [primary : ast.AstExpr]) : ResultTcUnit
  (if (tc-moved-path-conflict? borrowed path)
    (ResultTcUnit.Err
      (tc-borrow-check-rich-conflict-message
        expr-bases
        borrowed
        path
        (TcMovedPathKind.BorrowShared)
        primary
        (tc-borrow-check-mutably-borrow-message (tc-move-path-render path))))
    (match (tc-borrow-check-two-phase-mut-conflict borrowed path)
      [(TcMoveConflict.Some _ _)
        (ResultTcUnit.Err
          (tc-borrow-check-two-phase-mut-conflict-message
            expr-bases
            borrowed
            path
            primary
            (tc-borrow-check-mutably-borrow-message (tc-move-path-render path))))]
      [TcMoveConflict.No ResultTcUnit.Ok])))

(define (tc-borrow-check-immutably-borrow-conflict
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [primary : ast.AstExpr]) : ResultTcUnit
  (if (match (tc-moved-path-conflict-kind
    borrowed
    path
    (TcMovedPathKind.BorrowMut))
    [(TcMoveConflict.Some _ _) true]
    [TcMoveConflict.No false])
    (ResultTcUnit.Err
      (tc-borrow-check-rich-conflict-message
        expr-bases
        borrowed
        path
        (TcMovedPathKind.BorrowMut)
        primary
        (tc-borrow-check-immutably-borrow-message (tc-move-path-render path))))
    ResultTcUnit.Ok))

(define (tc-borrow-check-read-conflict
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [path : TcMovePath]
  [primary : ast.AstExpr]) : ResultTcUnit
  (if (match (tc-moved-path-conflict-kind
    borrowed
    path
    (TcMovedPathKind.BorrowMut))
    [(TcMoveConflict.Some _ _) true]
    [TcMoveConflict.No false])
    (ResultTcUnit.Err
      (tc-borrow-check-rich-conflict-message
        expr-bases
        borrowed
        path
        (TcMovedPathKind.BorrowMut)
        primary
        (tc-borrow-check-read-message (tc-move-path-render path))))
    ResultTcUnit.Ok))

(define (tc-borrow-check-place-read-conflict
  [expr-bases : i64]
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : ast.AstExpr]
  [primary : ast.AstExpr]) : TcBorrowCheckResult
  (if (= (tc-moved-len borrowed) 0)
    (TcBorrowCheckResult.Ok borrowed)
    (match (tc-borrow-check-place-path expr-bases expr)
      [(TcMaybeMovePath.Some path)
        (match (tc-borrow-check-read-conflict expr-bases borrowed path primary)
          [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed)]
          [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])]
      [(TcMaybeMovePath.No) (TcBorrowCheckResult.Ok borrowed)])))

(define (tc-borrow-check-add-place-with-mutability
  [expr-bases : i64]
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [mutable : bool]
  [place : ast.AstExpr]
  [origin : ast.AstExpr]) : TcBorrowCheckResult
  (match (tc-borrow-check-place-path expr-bases place)
    [(TcMaybeMovePath.Some path)
      (if mutable
        (match (tc-borrow-check-mutably-borrow-conflict
          expr-bases
          borrowed
          path
          origin)
          [(ResultTcUnit.Ok)
            (TcBorrowCheckResult.Ok
              (tc-borrow-check-add-borrow-path borrowed path true origin))]
          [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])
        (match (tc-borrow-check-immutably-borrow-conflict
          expr-bases
          borrowed
          path
          origin)
          [(ResultTcUnit.Ok)
            (TcBorrowCheckResult.Ok
              (tc-borrow-check-add-borrow-path borrowed path false origin))]
          [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)]))]
    [(TcMaybeMovePath.No) (TcBorrowCheckResult.Ok borrowed)]))

(define (tc-borrow-check-after-consuming-place
  [expr-bases : i64]
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : ast.AstExpr]) : TcBorrowCheckResult
  (match (tc-borrow-check-place-path expr-bases expr)
    [(TcMaybeMovePath.Some path)
      (match (tc-borrow-check-move-conflict expr-bases borrowed path expr)
        [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed)]
        [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])]
    [(TcMaybeMovePath.No) (TcBorrowCheckResult.Ok borrowed)]))

(define (tc-borrow-check-after-consuming-value
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : ast.AstExpr]
  [target-ty : ast.AstType]) : TcBorrowCheckResult
  (if (or
    (tc-call-param-consuming-now? ctx target-ty)
    (tc-move-value-concrete-closure-move-only? ctx expr-bases env locals expr))
    (tc-borrow-check-after-consuming-place expr-bases locals borrowed expr)
    (TcBorrowCheckResult.Ok borrowed)))

(define (tc-borrow-check-after-move-only-value
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : ast.AstExpr]
  [target-ty : ast.AstType]) : TcBorrowCheckResult
  (if (tc-move-value-move-only?
    ctx
    expr-bases
    env
    locals
    expr
    (tc-resolve-type ctx target-ty))
    (tc-borrow-check-after-consuming-place expr-bases locals borrowed expr)
    (TcBorrowCheckResult.Ok borrowed)))

(define (tc-borrow-check-after-reading-value
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : ast.AstExpr]
  [target-ty : ast.AstType]) : TcBorrowCheckResult
  (if (or
    (tc-call-param-consuming-now? ctx target-ty)
    (tc-move-value-concrete-closure-move-only? ctx expr-bases env locals expr))
    (TcBorrowCheckResult.Ok borrowed)
    (tc-borrow-check-place-read-conflict expr-bases locals borrowed expr expr)))

(define (tc-borrow-check-after-bind-typed
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [init : ast.AstExpr]
  [init-ty : ast.AstType]) : TcBorrowCheckResult
  (if (or
    (tc-type-consuming-by-value-now? ctx init-ty)
    (tc-move-value-concrete-closure-move-only? ctx expr-bases env locals init))
    (tc-borrow-check-after-consuming-place expr-bases locals borrowed init)
    (TcBorrowCheckResult.Ok borrowed)))

(define (tc-borrow-check-after-bind-id
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [init-id : i64]) : TcBorrowCheckResult
  (let
    [init : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases init-id)]
    (match (tc-move-bare-var expr-bases init)
      [(TcMaybeMoveName.Some name-id name)
        (if (and
          (tc-moved-contains? locals name-id)
          (tc-move-var-move-only-id? ctx env locals name-id))
          (match (tc-borrow-check-move-conflict
            expr-bases
            borrowed
            (TcMovePath name-id (tc-move-path-segments-empty))
            init)
            [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed)]
            [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])
          (TcBorrowCheckResult.Ok borrowed))]
      [(TcMaybeMoveName.No)
        (match (tc-body-type-fact-expr-id "borrow.bind_init" ctx env init-id)
          [(ResultTcType.Ok init-ty)
            (tc-borrow-check-after-bind-typed
              ctx
              expr-bases
              env
              locals
              borrowed
              init
              init-ty)]
          [(ResultTcType.Err _) (TcBorrowCheckResult.Ok borrowed)])])))

(define (tc-borrow-check-call-constructor?
  [ctx : TcContext]
  [func : ast.AstExpr]) : bool
  (let
    [name-id : i64 (tc-expr-var-name-id func)]
    (if (>= name-id 0)
      (tc-constructor-name-id? ctx name-id)
      false)))

(define (tc-borrow-check-lending-result-type?
  [ctx : TcContext]
  [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(ast.AstType.EnumArgs _ _) true]
    [(ast.AstType.StructArgs _ _) true]
    [(ast.AstType.Tuple elems)
      (tc-type-list-contains-reference? (__tl-box-place elems))]
    [_ false]))

;; The ordinary returned-call effect uses the inferred result type, which can
;; retain a symbolic lifetime for a lending call. At an annotated binding we
;; have the concrete caller lifetime, so attach a result-binding marker to the
;; direct mutable borrow for precise NLL pruning.
(define (tc-borrow-check-first-overlapping-lifetime
  [type-lifetimes : TcNameIdList]
  [result-lifetimes : TcNameIdList]) : TcMaybeNameId
  (let
    [cursor : TcNameIdList result-lifetimes]
    [found : TcMaybeNameId TcMaybeNameId.No]
    [done : bool false]
    (begin
      (while (and (not done) (not (tc-name-id-list-empty? cursor)))
        (let
          [lifetime : i64 (tc-name-id-list-head cursor)]
          (begin
            (if (tc-name-id-list-contains type-lifetimes lifetime)
              (begin
                (set! found (TcMaybeNameId.Some lifetime))
                (set! done true))
              unit)
            (set! cursor (tc-name-id-list-rest cursor)))))
      found)))

(define (tc-borrow-check-add-bound-returned-call-arg-borrow
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [binding-id : i64]
  [arg : ast.AstExpr]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (match (ast.ast-expr-unspan arg)
    [(ast.AstExpr.Borrow true _ place-box)
      (let
        [place : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases place-box)]
        (match (tc-borrow-check-place-path expr-bases place)
          [(TcMaybeMovePath.Some path)
            (let
              [without-temporary
                : TcMovedSet
                ;; A second binding of the same lending borrow must not erase
                ;; the first binding's live marker while discarding its own
                ;; transient call effect. Keeping it makes the ordinary
                ;; mutable-borrow check report the aliasing conflict.
                (if (tc-borrow-check-has-lending-binding? borrowed path)
                  borrowed
                  (tc-borrow-check-remove-borrow-path borrowed path))]
              (match (tc-expr ctx env arg)
                [(ResultTcType.Ok borrow-ty)
                  (match (tc-borrow-check-first-overlapping-lifetime
                    (tc-type-collect-reference-lifetimes
                      (tc-resolve-type ctx borrow-ty))
                    result-lifetimes)
                    [(TcMaybeNameId.Some _)
                      (match (tc-borrow-check-add-place-with-mutability
                        expr-bases
                        locals
                        without-temporary
                        true
                        place
                        arg)
                        [(TcBorrowCheckResult.Ok borrowed1)
                          (TcBorrowCheckResult.Ok
                            (tc-borrow-check-add-lending-marker
                              borrowed1
                              path
                              binding-id
                              arg))]
                        [(TcBorrowCheckResult.Err message)
                          (TcBorrowCheckResult.Err message)])]
                    [(TcMaybeNameId.No) (TcBorrowCheckResult.Ok borrowed)])]
                [(ResultTcType.Err _) (TcBorrowCheckResult.Ok borrowed)]))]
          [(TcMaybeMovePath.No)
            (tc-borrow-check-add-returned-call-arg-borrow
              ctx
              expr-bases
              env
              locals
              borrowed
              arg
              result-lifetimes)]))]
    [(ast.AstExpr.Ann inner-box _)
      (tc-borrow-check-add-bound-returned-call-arg-borrow
        ctx
        expr-bases
        env
        locals
        borrowed
        binding-id
        (ast.ast-expr-segment-bases-get expr-bases inner-box)
        result-lifetimes)]
    [(ast.AstExpr.Cast inner-box _)
      (tc-borrow-check-add-bound-returned-call-arg-borrow
        ctx
        expr-bases
        env
        locals
        borrowed
        binding-id
        (ast.ast-expr-segment-bases-get expr-bases inner-box)
        result-lifetimes)]
    [_ (TcBorrowCheckResult.Ok borrowed)]))

(define (tc-borrow-check-add-bound-returned-call-borrows-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [binding-id : i64]
  [args : (& args ast.AstExprList)]
  [index : i64]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (if (>= index args.len)
    (TcBorrowCheckResult.Ok borrowed)
    (match (tc-borrow-check-add-bound-returned-call-arg-borrow
      ctx
      expr-bases
      env
      locals
      borrowed
      binding-id
      (ast.ast-expr-segment-bases-get
        expr-bases
        (ast.ast-expr-list-get args index 0))
      result-lifetimes)
      [(TcBorrowCheckResult.Ok borrowed1)
        (tc-borrow-check-add-bound-returned-call-borrows-at
          ctx
          expr-bases
          env
          locals
          borrowed1
          binding-id
          args
          (+ index 1)
          result-lifetimes)]
      [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])))

(define (tc-borrow-check-add-bound-returned-call-borrows
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [binding-id : i64]
  [args : ast.AstExprList]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (tc-borrow-check-add-bound-returned-call-borrows-at
    ctx
    expr-bases
    env
    locals
    borrowed
    binding-id
    (& args)
    0
    result-lifetimes))

(define (tc-borrow-check-after-bind-known-type-id
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [binding-id : i64]
  [init-id : i64]
  [init-ty : ast.AstType]) : TcBorrowCheckResult
  (let
    [init : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases init-id)]
    (match (tc-move-bare-var expr-bases init)
      [(TcMaybeMoveName.Some name-id name)
        (if (and
          (tc-moved-contains? locals name-id)
          (tc-move-var-move-only-id? ctx env locals name-id))
          (match (tc-borrow-check-move-conflict
            expr-bases
            borrowed
            (TcMovePath name-id (tc-move-path-segments-empty))
            init)
            [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed)]
            [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])
          (TcBorrowCheckResult.Ok borrowed))]
      [(TcMaybeMoveName.No)
        (match (ast.ast-expr-unspan init)
          [(ast.AstExpr.Call func-box args)
            (let
              [func : ast.AstExpr
                (ast.ast-expr-segment-bases-get expr-bases func-box)]
              (if (or
                (tc-borrow-check-call-constructor? ctx func)
                (not (tc-borrow-check-lending-result-type? ctx init-ty)))
                (tc-borrow-check-after-bind-typed
                  ctx
                  expr-bases
                  env
                  locals
                  borrowed
                  init
                  init-ty)
                (match (tc-borrow-check-add-bound-returned-call-borrows
                  ctx
                  expr-bases
                  env
                  locals
                  borrowed
                  binding-id
                  args
                  (tc-type-collect-reference-lifetimes
                    (tc-resolve-type ctx init-ty)))
                  [(TcBorrowCheckResult.Ok borrowed1)
                    (tc-borrow-check-after-bind-typed
                      ctx
                      expr-bases
                      env
                      locals
                      borrowed1
                      init
                      init-ty)]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])))]
          [_
            (tc-borrow-check-after-bind-typed
              ctx
              expr-bases
              env
              locals
              borrowed
              init
              init-ty)])])))

(define (tc-borrow-check-prune-value-temporaries-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [prior : TcMovedSet]
  [facts : TcMovedPathFacts]
  [value : ast.AstExpr]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [path : TcMovePath fact.path]
      [kind : TcMovedPathKind fact.kind]
      [borrow-kind : bool
        (match kind
          [(TcMovedPathKind.BorrowShared) true]
          [(TcMovedPathKind.BorrowMut) true]
          [(TcMovedPathKind.BorrowTwoPhaseMut) true]
          [_ false])]
      [new : bool
        (not
          (tc-moved-path-facts-contains-exact-kind?
            (tc-moved-paths prior)
            path
            kind))]
      [remove : bool
        (if (and borrow-kind new)
          (let
            [lifetime : i64 (tc-borrow-check-path-lifetime ctx env path)]
            (not
              (or
                (tc-borrow-check-expr-type-contains-lifetime?
                  ctx
                  env
                  value
                  lifetime)
                (tc-borrow-check-expr-stores-lifetime?
                  ctx
                  expr-bases
                  env
                  value
                  lifetime))))
          false)]
      [out2 : TcMovedSet
        (if remove
          (tc-moved-remove-path-kind out path kind)
          out)]
      (tc-borrow-check-prune-value-temporaries-at
        ctx
        expr-bases
        env
        prior
        rest
        value
        out2))))

;; Argument auto-borrows created while evaluating an assignment RHS end after
;; that value is produced unless the result or a nested store retains their
;; lifetime. Drop only newly introduced facts so pre-existing live borrows keep
;; protecting the assigned place.
(define (tc-borrow-check-prune-value-temporaries
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [prior : TcMovedSet]
  [borrowed : TcMovedSet]
  [value : ast.AstExpr]) : TcMovedSet
  (tc-borrow-check-prune-value-temporaries-at
    ctx
    expr-bases
    env
    prior
    (tc-moved-paths borrowed)
    value
    borrowed))

(define (tc-borrow-check-assignment
  [expr-bases : i64]
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [name-id : i64]
  [primary : ast.AstExpr]) : ResultTcUnit
  (tc-borrow-check-assign-conflict
    expr-bases
    borrowed
    (TcMovePath name-id (tc-move-path-segments-empty))
    primary))

(define (tc-borrow-check-array-set-conflict
  [expr-bases : i64]
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [array : ast.AstExpr]
  [index : ast.AstExpr]
  [primary : ast.AstExpr]) : ResultTcUnit
  (match (tc-move-root-projection-var-id expr-bases array)
    [(TcMaybeNameId.Some root-id)
      (match (tc-move-array-set-path expr-bases array index)
        [(TcMaybeMovePath.Some path)
          (tc-borrow-check-assign-conflict expr-bases borrowed path primary)]
        [(TcMaybeMovePath.No)
          (tc-borrow-check-assign-conflict
            expr-bases
            borrowed
            (TcMovePath root-id (tc-move-path-segments-empty))
            primary)])]
    [(TcMaybeNameId.No) ResultTcUnit.Ok]))

(define (tc-borrow-check-struct-set-conflict
  [expr-bases : i64]
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [receiver : ast.AstExpr]
  [field-id : i64]
  [primary : ast.AstExpr]) : ResultTcUnit
  (match (tc-move-root-projection-var-id expr-bases receiver)
    [(TcMaybeNameId.Some root-id)
      (match (tc-move-struct-set-path expr-bases receiver field-id)
        [(TcMaybeMovePath.Some path)
          (tc-borrow-check-assign-conflict expr-bases borrowed path primary)]
        [(TcMaybeMovePath.No)
          (tc-borrow-check-assign-conflict
            expr-bases
            borrowed
            (TcMovePath root-id (tc-move-path-segments-empty))
            primary)])]
    [(TcMaybeNameId.No) ResultTcUnit.Ok]))

(define (tc-borrow-check-root-mutation-conflict
  [expr-bases : i64]
  [_locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [place : ast.AstExpr]
  [primary : ast.AstExpr]) : ResultTcUnit
  (match (tc-move-root-projection-var-id expr-bases place)
    [(TcMaybeNameId.Some root-id)
      (tc-borrow-check-assign-conflict
        expr-bases
        borrowed
        (TcMovePath root-id (tc-move-path-segments-empty))
        primary)]
    [(TcMaybeNameId.No) ResultTcUnit.Ok]))

(define (tc-borrow-check-region-invalidation-scan
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [region : i64]
  [seen : TcNameIdList]
  [remaining : i64]
  [primary : ast.AstExpr]) : TcBorrowCheckResult
  (if (<= remaining 0)
    (TcBorrowCheckResult.Ok borrowed)
    (match (tc-type-env-marker-step env)
      [(TcTypeEnvMarkerStep.Done) (TcBorrowCheckResult.Ok borrowed)]
      [(TcTypeEnvMarkerStep.Cache rest-env)
        (tc-borrow-check-region-invalidation-scan
          ctx
          expr-bases
          rest-env
          locals
          borrowed
          region
          seen
          remaining
          primary)]
      [(TcTypeEnvMarkerStep.Bind key ty rest-env)
        (cond
          [(= key (tc-default-boundary-id)) (TcBorrowCheckResult.Ok borrowed)]
          [(tc-name-id-list-contains seen key)
            (tc-borrow-check-region-invalidation-scan
              ctx
              expr-bases
              rest-env
              locals
              borrowed
              region
              seen
              remaining
              primary)]
          [(not (tc-moved-contains? locals key))
            (tc-borrow-check-region-invalidation-scan
              ctx
              expr-bases
              rest-env
              locals
              borrowed
              region
              (tc-name-id-list-add seen key)
              remaining
              primary)]
          [(tc-type-contains-region ty region)
            (match (tc-borrow-check-assign-conflict
              expr-bases
              borrowed
              (TcMovePath key (tc-move-path-segments-empty))
              primary)
              [(ResultTcUnit.Ok)
                (tc-borrow-check-region-invalidation-scan
                  ctx
                  expr-bases
                  rest-env
                  locals
                  borrowed
                  region
                  (tc-name-id-list-add seen key)
                  (- remaining 1)
                  primary)]
              [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])]
          [else
            (tc-borrow-check-region-invalidation-scan
              ctx
              expr-bases
              rest-env
              locals
              borrowed
              region
              (tc-name-id-list-add seen key)
              (- remaining 1)
              primary)])])))

(define (tc-borrow-check-owner-invalidation-scan
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [owner : i64]
  [seen : TcNameIdList]
  [remaining : i64]
  [primary : ast.AstExpr]) : TcBorrowCheckResult
  (if (<= remaining 0)
    (TcBorrowCheckResult.Ok borrowed)
    (match (tc-type-env-marker-step env)
      [(TcTypeEnvMarkerStep.Done) (TcBorrowCheckResult.Ok borrowed)]
      [(TcTypeEnvMarkerStep.Cache rest-env)
        (tc-borrow-check-owner-invalidation-scan
          ctx
          expr-bases
          rest-env
          locals
          borrowed
          owner
          seen
          remaining
          primary)]
      [(TcTypeEnvMarkerStep.Bind key ty rest-env)
        (cond
          [(= key (tc-default-boundary-id)) (TcBorrowCheckResult.Ok borrowed)]
          [(tc-name-id-list-contains seen key)
            (tc-borrow-check-owner-invalidation-scan
              ctx
              expr-bases
              rest-env
              locals
              borrowed
              owner
              seen
              remaining
              primary)]
          [(not (tc-moved-contains? locals key))
            (tc-borrow-check-owner-invalidation-scan
              ctx
              expr-bases
              rest-env
              locals
              borrowed
              owner
              (tc-name-id-list-add seen key)
              remaining
              primary)]
          [(tc-type-contains-arena-owner-region? env ty owner)
            (match (tc-borrow-check-assign-conflict
              expr-bases
              borrowed
              (TcMovePath key (tc-move-path-segments-empty))
              primary)
              [(ResultTcUnit.Ok)
                (tc-borrow-check-owner-invalidation-scan
                  ctx
                  expr-bases
                  rest-env
                  locals
                  borrowed
                  owner
                  (tc-name-id-list-add seen key)
                  (- remaining 1)
                  primary)]
              [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])]
          [else
            (tc-borrow-check-owner-invalidation-scan
              ctx
              expr-bases
              rest-env
              locals
              borrowed
              owner
              (tc-name-id-list-add seen key)
              (- remaining 1)
              primary)])])))

(define (tc-borrow-check-safe-arena-rewind-effect
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : ast.AstExprList]
  [primary : ast.AstExpr]) : TcBorrowCheckResult
  (if (ast.ast-expr-list-empty? (& args))
    (TcBorrowCheckResult.Ok borrowed)
    (let
      [phase-box : i64 (ast.ast-expr-list-get (& args) 0 0)]
      [phase-expr : ast.AstExpr
        (ast.ast-expr-segment-bases-get expr-bases phase-box)]
      [pid : i64 (tc-expr-var-name-id phase-expr)]
      (if (>= pid 0)
        (match (tc-borrow-check-assign-conflict
          expr-bases
          borrowed
          (TcMovePath pid (tc-move-path-segments-empty))
          primary)
          [(ResultTcUnit.Ok)
            (match (tc-arena-phase-token-region-active env pid)
              [(TcMaybeNameId.Some region)
                (tc-borrow-check-region-invalidation-scan
                  ctx
                  expr-bases
                  env
                  locals
                  borrowed
                  region
                  TcNameIdList.Nil
                  (tc-moved-len locals)
                  primary)]
              [(TcMaybeNameId.No) (TcBorrowCheckResult.Ok borrowed)])]
          [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])
        (TcBorrowCheckResult.Ok borrowed)))))

(define (tc-borrow-check-safe-arena-destroy-effect
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : ast.AstExprList]
  [primary : ast.AstExpr]) : TcBorrowCheckResult
  (if (ast.ast-expr-list-empty? (& args))
    (TcBorrowCheckResult.Ok borrowed)
    (let
      [owner-box : i64 (ast.ast-expr-list-get (& args) 0 0)]
      [owner-expr : ast.AstExpr
        (ast.ast-expr-segment-bases-get expr-bases owner-box)]
      [oid : i64 (tc-expr-var-name-id owner-expr)]
      (if (>= oid 0)
        (if (or
          (tc-ordinary-arena-owner-active-id? env oid)
          (tc-atomic-arena-owner-active-id? env oid))
          (match (tc-borrow-check-assign-conflict
            expr-bases
            borrowed
            (TcMovePath oid (tc-move-path-segments-empty))
            primary)
            [(ResultTcUnit.Ok)
              (tc-borrow-check-owner-invalidation-scan
                ctx
                expr-bases
                env
                locals
                borrowed
                oid
                TcNameIdList.Nil
                (tc-moved-len locals)
                primary)]
            [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])
          (TcBorrowCheckResult.Ok borrowed))
        (TcBorrowCheckResult.Ok borrowed)))))

(define (tc-borrow-check-safe-arena-call-effects
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : ast.AstExpr]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : TcBorrowCheckResult
  (let
    [raw-id : i64 (tc-expr-var-name-id func)]
    (if (>= raw-id 0)
      (let
        [raw-name : String (tc-hygiene-name-text-id raw-id)]
        [hygiene-global : bool (tc-hygiene-global-name-id? raw-id)]
        [name : String
          (if (and hygiene-global (not (macro-hygiene-global-id? raw-id)))
            (tc-hygiene-global-symbol-name raw-name)
            raw-name)]
        [name-id : i64 (tc-builtin-symbol-name-id raw-id hygiene-global)]
        [lookup-id : i64 (tc-call-builtin-lookup-id ctx env name name-id)]
        [arena-call-kind : i64
          (tc-arena-safe-call-kind-id ctx env name-id lookup-id)]
        (cond
          [(= arena-call-kind (tc-arena-safe-call-kind-rewind))
            (tc-borrow-check-safe-arena-rewind-effect
              ctx
              expr-bases
              env
              locals
              borrowed
              args
              call-expr)]
          [(= arena-call-kind (tc-arena-safe-call-kind-destroy))
            (tc-borrow-check-safe-arena-destroy-effect
              ctx
              expr-bases
              env
              locals
              borrowed
              args
              call-expr)]
          [else (TcBorrowCheckResult.Ok borrowed)]))
      (TcBorrowCheckResult.Ok borrowed))))

(define (tc-string-has-suffix-at?
  [text : String]
  [suffix : String]
  [base : i64]
  [index : i64]
  [n : i64]) : bool
  (if (>= index n)
    true
    (if (=
      (cast (string.string-ref text (+ base index)) : i64)
      (cast (string.string-ref suffix index) : i64))
      (tc-string-has-suffix-at? text suffix base (+ index 1) n)
      false)))

(define (tc-string-has-suffix? [text : String] [suffix : String]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [suffix-len : i64 (string.string-length suffix)]
    (if (< text-len suffix-len)
      false
      (tc-string-has-suffix-at?
        text
        suffix
        (- text-len suffix-len)
        0
        suffix-len))))

(define (tc-borrow-check-after-call-effects
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : ast.AstExpr]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [return-lifetimes : TcBorrowCallReturnLifetimes]) : TcBorrowCheckResult
  (match (tc-borrow-check-safe-arena-call-effects
    ctx
    expr-bases
    env
    locals
    borrowed
    call-expr
    func
    args)
    [(TcBorrowCheckResult.Ok borrowed0)
      (tc-borrow-check-after-returning-call
        ctx
        expr-bases
        env
        locals
        borrowed0
        call-expr
        args
        return-lifetimes)]
    [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))

(define (tc-borrow-check-add-names [locals : TcMovedSet] [names : TcNameIdList]) : TcMovedSet
  (tc-move-add-bound-names locals names))

(define (tc-borrow-check-remove-root-states
  [borrowed : TcMovedSet]
  [names : TcNameIdList]) : TcMovedSet
  (let
    [cursor : TcNameIdList names]
    [out : TcMovedSet borrowed]
    (begin
      (while (not (tc-name-id-list-empty? cursor))
        (begin
          (set!
            out
            (tc-borrow-check-remove-root-state
              out
              (tc-name-id-list-head cursor)))
          (set! cursor (tc-name-id-list-rest cursor))))
      out)))

(define (tc-borrow-check-pattern-bound-names
  [ctx : TcContext]
  [scrut-ty : ast.AstType]
  [pattern : ast.AstPattern]) : TcNameIdList
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-match-coverage-type ctx scrut-ty)))
    [(ast.AstType.Enum _)
      (match pattern
        [(ast.AstPattern.Variant _ patterns-box)
          (let
            [patterns : ast.AstPatternList (__tl-box-place patterns-box)]
            (tc-pattern-list-add-bound-name-ids patterns TcNameIdList.Nil))]
        [_ TcNameIdList.Nil])]
    [(ast.AstType.EnumArgs _ _)
      (match pattern
        [(ast.AstPattern.Variant _ patterns-box)
          (let
            [patterns : ast.AstPatternList (__tl-box-place patterns-box)]
            (tc-pattern-list-add-bound-name-ids patterns TcNameIdList.Nil))]
        [_ TcNameIdList.Nil])]
    [_ (tc-pattern-add-bound-name-ids pattern TcNameIdList.Nil)]))

(define (tc-borrow-check-pattern-locals
  [ctx : TcContext]
  [scrut-ty : ast.AstType]
  [pattern : ast.AstPattern]
  [locals : TcMovedSet]) : TcMovedSet
  (tc-borrow-check-add-names
    locals
    (tc-borrow-check-pattern-bound-names ctx scrut-ty pattern)))

(define (tc-borrow-check-effective-arg-with-type
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [arg : ast.AstExpr]
  [ty : ast.AstType]) : TcBorrowCheckResult
  (let
    [want : ast.AstType
      (ast.ast-type-strip-consuming-param-with-pools (tc-context-pools ctx) ty)]
    (match (tc-borrow-check-expr ctx expr-bases env locals borrowed arg)
      [(TcBorrowCheckResult.Ok borrowed1)
        (match (tc-borrow-check-after-consuming-value
          ctx
          expr-bases
          env
          locals
          borrowed1
          arg
          ty)
          [(TcBorrowCheckResult.Ok borrowed2)
            (if (= (tc-moved-len borrowed2) 0)
              (TcBorrowCheckResult.Ok borrowed2)
              (tc-borrow-check-after-reading-value
                ctx
                expr-bases
                env
                locals
                borrowed2
                arg
                want))]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])]
      [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])))

(define (tc-borrow-check-arg-with-type
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [arg : ast.AstExpr]
  [ty : ast.AstType]) : TcBorrowCheckResult
  (let
    [want : ast.AstType
      (ast.ast-type-strip-consuming-param-with-pools (tc-context-pools ctx) ty)]
    (match (cfg
      compile-profile
      (compiler-tc-reinfer-profile-effective-arg-expr
        "borrow.call_arg"
        ctx
        env
        arg
        want)
      (tc-call-effective-arg-expr ctx env arg want))
      [(ResultTcExpr.Ok effective)
        (tc-borrow-check-effective-arg-with-type
          ctx
          expr-bases
          env
          locals
          borrowed
          effective
          ty)]
      [(ResultTcExpr.Err message)
        (TcBorrowCheckResult.Err (tc-locate-error-at-expr arg message))])))

(define (tc-borrow-check-exprs-with-types
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : ast.AstExprList]
  [types : ast.AstTypeList]) : TcBorrowCheckResult
  (tc-borrow-check-exprs-with-types-at
    ctx
    expr-bases
    env
    locals
    borrowed
    (& exprs)
    (& types)
    0))

(define (tc-borrow-check-exprs-with-types-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : (& exprs ast.AstExprList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index exprs.len)
    (if (>= index (ast.ast-type-list-len types))
      (TcBorrowCheckResult.Ok borrowed)
      (TcBorrowCheckResult.Err (tc-call-arity-invariant-message "borrow-check")))
    (if (>= index (ast.ast-type-list-len types))
      (TcBorrowCheckResult.Err (tc-call-arity-invariant-message "borrow-check"))
      (let
        [head-expr : ast.AstExpr
          (ast.ast-expr-segment-bases-get
            expr-bases
            (ast.ast-expr-list-get exprs index 0))]
        [ty : ast.AstType
          (ast.ty-node-get
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
        (match (tc-borrow-check-arg-with-type
          ctx
          expr-bases
          env
          locals
          borrowed
          head-expr
          ty)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-exprs-with-types-at
              ctx
              expr-bases
              env
              locals
              borrowed1
              exprs
              types
              (+ index 1))]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])))))

(define (tc-borrow-check-activate-two-phase-mut-borrows-loop
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [facts : TcMovedPathFacts]
  [primary : ast.AstExpr]) : TcBorrowCheckResult
  (if (tc-moved-path-facts-empty? facts)
    (TcBorrowCheckResult.Ok borrowed)
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      (match fact.kind
        [(TcMovedPathKind.BorrowTwoPhaseMut)
          (let
            [path : TcMovePath fact.path]
            (match (tc-moved-path-conflict borrowed path)
              [(TcMoveConflict.Some _ _)
                (TcBorrowCheckResult.Err
                  (tc-borrow-check-rich-conflict-message
                    expr-bases
                    borrowed
                    path
                    (TcMovedPathKind.BorrowShared)
                    primary
                    (tc-borrow-check-mutably-borrow-message
                      (tc-move-path-render path))))]
              [TcMoveConflict.No
                (tc-borrow-check-activate-two-phase-mut-borrows-loop
                  expr-bases
                  borrowed
                  rest
                  primary)]))]
        [_
          (tc-borrow-check-activate-two-phase-mut-borrows-loop
            expr-bases
            borrowed
            rest
            primary)]))))

(define (tc-borrow-check-activate-two-phase-mut-borrows
  [expr-bases : i64]
  [borrowed : TcMovedSet]
  [primary : ast.AstExpr]) : TcBorrowCheckResult
  (tc-borrow-check-activate-two-phase-mut-borrows-loop
    expr-bases
    borrowed
    (tc-moved-paths borrowed)
    primary))

(define (tc-borrow-check-reserve-two-phase-mut-call-arg
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [borrow-expr : ast.AstExpr]
  [place : ast.AstExpr]) : TcBorrowCheckResult
  (match (tc-borrow-check-place-read-conflict
    expr-bases
    locals
    borrowed
    place
    borrow-expr)
    [(TcBorrowCheckResult.Ok borrowed0)
      (match (tc-borrow-check-expr ctx expr-bases env locals borrowed0 place)
        [(TcBorrowCheckResult.Ok borrowed1)
          (match (tc-borrow-place ctx expr-bases env place)
            [(ResultTcBorrowPlace.Ok _)
              (tc-borrow-check-add-two-phase-mut-place
                expr-bases
                locals
                borrowed1
                place
                borrow-expr)]
            [(ResultTcBorrowPlace.Err message)
              (TcBorrowCheckResult.Err message)])]
        [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])]
    [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))

(define (tc-borrow-check-call-args-two-phase-with-types
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [reserved : bool]
  [call-expr : ast.AstExpr]
  [pending-scope-id : i64]
  [exprs : ast.AstExprList]
  [types : ast.AstTypeList]) : TcBorrowCheckResult
  (tc-borrow-check-call-args-two-phase-with-types-at
    ctx
    expr-bases
    env
    locals
    borrowed
    reserved
    call-expr
    pending-scope-id
    (& exprs)
    (& types)
    0))

(define (tc-borrow-check-call-args-two-phase-retry-after-prune
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [reserved : bool]
  [call-expr : ast.AstExpr]
  [pending-scope-id : i64]
  [exprs : (& exprs ast.AstExprList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [message : String]) : TcBorrowCheckResult
  (let
    [current-and-pending : ast.AstExprList
      (ast.ast-expr-list-tail-from-ref exprs index)]
    [borrowed0 : TcMovedSet
      (tc-borrow-check-prune-before-exprs
        expr-bases
        ctx
        env
        locals
        borrowed
        borrowed
        current-and-pending)]
    (if (= (tc-moved-len borrowed0) (tc-moved-len borrowed))
      (TcBorrowCheckResult.Err message)
      (tc-borrow-check-call-args-two-phase-with-types-at
        ctx
        expr-bases
        env
        locals
        borrowed0
        reserved
        call-expr
        pending-scope-id
        exprs
        types
        index))))

(define (tc-borrow-check-call-args-two-phase-with-types-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [reserved : bool]
  [call-expr : ast.AstExpr]
  [pending-scope-id : i64]
  [exprs : (& exprs ast.AstExprList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : TcBorrowCheckResult
  (begin
    (when
      (>= index exprs.len)
      (return
        (if (>= index (ast.ast-type-list-len types))
          (if reserved
            (tc-borrow-check-activate-two-phase-mut-borrows
              expr-bases
              borrowed
              call-expr)
            (TcBorrowCheckResult.Ok borrowed))
          (TcBorrowCheckResult.Err
            (tc-call-arity-invariant-message "borrow-check")))))
    (when
      (>= index (ast.ast-type-list-len types))
      (return
        (TcBorrowCheckResult.Err
          (tc-call-arity-invariant-message "borrow-check"))))
    (let
      [pending-exprs : ast.AstExprList
        (ast.ast-expr-list-tail-from-ref exprs (+ index 1))]
      [scoped-borrowed : TcMovedSet
        (tc-borrow-check-add-all-pending-markers
          borrowed
          pending-exprs
          pending-scope-id)]
      [head-expr : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get exprs index 0))]
      [raw-ty : ast.AstType
        (ast.ty-node-get
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      [ty : ast.AstType
        (ast.ast-type-strip-consuming-param-with-pools
          (tc-context-pools ctx)
          raw-ty)]
      (match (cfg
        compile-profile
        (compiler-tc-reinfer-profile-effective-arg-expr
          "borrow.call_arg"
          ctx
          env
          head-expr
          ty)
        (tc-call-effective-arg-expr ctx env head-expr ty))
        [(ResultTcExpr.Ok effective-head)
          (match (ast.ast-expr-unspan effective-head)
            [(ast.AstExpr.Borrow mutable _ place-box)
              (if (and mutable (tc-call-mutable-ref-formal? ctx ty))
                (let
                  [place : ast.AstExpr
                    (ast.ast-expr-segment-bases-get expr-bases place-box)]
                  (match (tc-borrow-check-reserve-two-phase-mut-call-arg
                    ctx
                    expr-bases
                    env
                    locals
                    scoped-borrowed
                    effective-head
                    place)
                    [(TcBorrowCheckResult.Ok borrowed1)
                      (tc-borrow-check-call-args-two-phase-with-types-at
                        ctx
                        expr-bases
                        env
                        locals
                        (tc-borrow-check-remove-pending-markers
                          borrowed1
                          pending-scope-id)
                        true
                        call-expr
                        pending-scope-id
                        exprs
                        types
                        (+ index 1))]
                    [(TcBorrowCheckResult.Err message)
                      (tc-borrow-check-call-args-two-phase-retry-after-prune
                        ctx
                        expr-bases
                        env
                        locals
                        borrowed
                        reserved
                        call-expr
                        pending-scope-id
                        exprs
                        types
                        index
                        message)]))
                (match (tc-borrow-check-effective-arg-with-type
                  ctx
                  expr-bases
                  env
                  locals
                  scoped-borrowed
                  effective-head
                  raw-ty)
                  [(TcBorrowCheckResult.Ok borrowed1)
                    (tc-borrow-check-call-args-two-phase-with-types-at
                      ctx
                      expr-bases
                      env
                      locals
                      (tc-borrow-check-remove-pending-markers
                        borrowed1
                        pending-scope-id)
                      reserved
                      call-expr
                      pending-scope-id
                      exprs
                      types
                      (+ index 1))]
                  [(TcBorrowCheckResult.Err message)
                    (tc-borrow-check-call-args-two-phase-retry-after-prune
                      ctx
                      expr-bases
                      env
                      locals
                      borrowed
                      reserved
                      call-expr
                      pending-scope-id
                      exprs
                      types
                      index
                      message)]))]
            [_
              (match (tc-borrow-check-effective-arg-with-type
                ctx
                expr-bases
                env
                locals
                scoped-borrowed
                effective-head
                raw-ty)
                [(TcBorrowCheckResult.Ok borrowed1)
                  (tc-borrow-check-call-args-two-phase-with-types-at
                    ctx
                    expr-bases
                    env
                    locals
                    (tc-borrow-check-remove-pending-markers
                      borrowed1
                      pending-scope-id)
                    reserved
                    call-expr
                    pending-scope-id
                    exprs
                    types
                    (+ index 1))]
                [(TcBorrowCheckResult.Err message)
                  (tc-borrow-check-call-args-two-phase-retry-after-prune
                    ctx
                    expr-bases
                    env
                    locals
                    borrowed
                    reserved
                    call-expr
                    pending-scope-id
                    exprs
                    types
                    index
                    message)])])]
        [(ResultTcExpr.Err message)
          (TcBorrowCheckResult.Err (tc-locate-error-at-expr head-expr message))]))))

(define (tc-call-explicit-borrow-expr? [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan expr)
    [(ast.AstExpr.Borrow _ _ _) true]
    [_ false]))

(define (tc-borrow-check-add-call-arg-auto-borrow
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [arg : ast.AstExpr]
  [ty : ast.AstType]) : TcBorrowCheckResult
  (if (tc-call-explicit-borrow-expr? arg)
    (TcBorrowCheckResult.Ok borrowed)
    (match (cfg
      compile-profile
      (compiler-tc-reinfer-profile-effective-arg-expr
        "borrow.call_arg"
        ctx
        env
        arg
        ty)
      (tc-call-effective-arg-expr ctx env arg ty))
      [(ResultTcExpr.Ok effective)
        (match (ast.ast-expr-unspan effective)
          [(ast.AstExpr.Borrow mutable _ place-box)
            (let
              [place : ast.AstExpr
                (ast.ast-expr-segment-bases-get expr-bases place-box)]
              (tc-borrow-check-add-place-with-mutability
                expr-bases
                locals
                borrowed
                mutable
                place
                arg))]
          [_ (TcBorrowCheckResult.Ok borrowed)])]
      [(ResultTcExpr.Err message)
        (TcBorrowCheckResult.Err (tc-locate-error-at-expr arg message))])))

(define (tc-borrow-check-auto-borrowed-call-args
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : ast.AstExprList]
  [types : ast.AstTypeList]) : TcBorrowCheckResult
  (tc-borrow-check-auto-borrowed-call-args-at
    ctx
    expr-bases
    env
    locals
    borrowed
    (& args)
    (& types)
    0))

(define (tc-borrow-check-auto-borrowed-call-args-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : (& args ast.AstExprList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index args.len)
    (if (>= index (ast.ast-type-list-len types))
      (TcBorrowCheckResult.Ok borrowed)
      (TcBorrowCheckResult.Err (tc-call-arity-invariant-message "borrow-check")))
    (if (>= index (ast.ast-type-list-len types))
      (TcBorrowCheckResult.Err (tc-call-arity-invariant-message "borrow-check"))
      (let
        [head-expr : ast.AstExpr
          (ast.ast-expr-segment-bases-get
            expr-bases
            (ast.ast-expr-list-get args index 0))]
        [ty : ast.AstType
          (ast.ty-node-get
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
        (match (tc-borrow-check-add-call-arg-auto-borrow
          ctx
          expr-bases
          env
          locals
          borrowed
          head-expr
          ty)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-auto-borrowed-call-args-at
              ctx
              expr-bases
              env
              locals
              borrowed1
              args
              types
              (+ index 1))]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])))))

(define (tc-borrow-check-thread-channel-send-message
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]) : TcBorrowCheckResult
  (if (tc-thread-channel-send-call? ctx env func)
    (match (tc-thread-channel-send-call-name ctx func)
      [(TcMaybeString.Some _)
        (match (tc-thread-channel-send-message-param params)
          [(ResultTcType.Ok message-ty)
            (match (tc-thread-channel-send-message-arg args)
              [(ResultTcExpr.Ok message-expr)
                (tc-borrow-check-after-move-only-value
                  ctx
                  expr-bases
                  env
                  locals
                  borrowed
                  message-expr
                  message-ty)]
              [(ResultTcExpr.Err message) (TcBorrowCheckResult.Err message)])]
          [(ResultTcType.Err message) (TcBorrowCheckResult.Err message)])]
      [(TcMaybeString.No) (TcBorrowCheckResult.Ok borrowed)])
    (TcBorrowCheckResult.Ok borrowed)))

(define (tc-borrow-check-call-args-with-types
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : ast.AstExpr]
  [pending-scope-id : i64]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [types : ast.AstTypeList]
  [return-lifetimes : TcBorrowCallReturnLifetimes]) : TcBorrowCheckResult
  (let
    [validation-borrowed : TcMovedSet (tc-moved-clone borrowed)]
    [validation-result : TcBorrowCheckResult
      (tc-borrow-check-call-args-two-phase-with-types
        ctx
        expr-bases
        env
        locals
        validation-borrowed
        false
        call-expr
        pending-scope-id
        args
        types)]
    (match validation-result
      [(TcBorrowCheckResult.Ok checked-borrowed)
        (let
          [borrowed-with-uses : TcMovedSet
            (tc-borrow-check-propagate-lending-uses checked-borrowed borrowed)]
          (if (tc-call-type-list-has-immutable-ref-formal? ctx types)
            (match (tc-borrow-check-auto-borrowed-call-args
              ctx
              expr-bases
              env
              locals
              borrowed-with-uses
              args
              types)
              [(TcBorrowCheckResult.Ok borrowed2)
                (match (tc-borrow-check-thread-channel-send-message
                  ctx
                  expr-bases
                  env
                  locals
                  borrowed2
                  func
                  args
                  types)
                  [(TcBorrowCheckResult.Ok borrowed3)
                    (match (tc-borrow-check-after-call-effects
                      ctx
                      expr-bases
                      env
                      locals
                      borrowed3
                      call-expr
                      func
                      args
                      return-lifetimes)
                      [(TcBorrowCheckResult.Ok borrowed4)
                        ;; Auto-borrows are call temporaries unless the resolved
                        ;; result type retains their lifetime. This is the same
                        ;; type-driven lifetime pruning used for assignment
                        ;; values; it must not depend on the callee's spelling.
                        (if (=
                          (tc-moved-len borrowed2)
                          (tc-moved-len borrowed-with-uses))
                          (TcBorrowCheckResult.Ok borrowed4)
                          (TcBorrowCheckResult.Ok
                            (tc-borrow-check-prune-value-temporaries
                              ctx
                              expr-bases
                              env
                              borrowed-with-uses
                              borrowed4
                              call-expr)))]
                      [(TcBorrowCheckResult.Err message)
                        (TcBorrowCheckResult.Err message)])]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])
            (match (tc-borrow-check-thread-channel-send-message
              ctx
              expr-bases
              env
              locals
              borrowed-with-uses
              func
              args
              types)
              [(TcBorrowCheckResult.Ok borrowed2)
                (tc-borrow-check-after-call-effects
                  ctx
                  expr-bases
                  env
                  locals
                  borrowed2
                  call-expr
                  func
                  args
                  return-lifetimes)]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])))]
      [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])))

(define (tc-borrow-check-exprs-retry-after-prune
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [pending-scope-id : i64]
  [exprs : ast.AstExprList]
  [head : ast.AstExpr]
  [rest : ast.AstExprList]
  [message : String]) : TcBorrowCheckResult
  (if (= (tc-moved-len borrowed) 0)
    (TcBorrowCheckResult.Err message)
    (let
      [unscoped : TcMovedSet
        (tc-borrow-check-remove-pending-markers borrowed pending-scope-id)]
      [borrowed0 : TcMovedSet
        (tc-borrow-check-prune-before-exprs
          expr-bases
          ctx
          env
          locals
          unscoped
          protected
          exprs)]
      (if (= (tc-moved-len borrowed0) (tc-moved-len unscoped))
        (TcBorrowCheckResult.Err message)
        (match (tc-borrow-check-expr ctx expr-bases env locals borrowed0 head)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-exprs-with-protected
              ctx
              expr-bases
              env
              locals
              (tc-borrow-check-remove-pending-markers
                borrowed1
                pending-scope-id)
              protected
              rest)]
          [(TcBorrowCheckResult.Err retry-message)
            (TcBorrowCheckResult.Err retry-message)])))))

(define (tc-borrow-check-exprs-with-protected
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : ast.AstExprList]) : TcBorrowCheckResult
  (tc-borrow-check-exprs-with-protected-at
    ctx
    expr-bases
    env
    locals
    borrowed
    protected
    (& exprs)
    0))

(define (tc-borrow-check-exprs-with-protected-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index exprs.len)
    (TcBorrowCheckResult.Ok borrowed)
    (let
      [head : i64 (ast.ast-expr-list-get exprs index 0)]
      [rest : ast.AstExprList
        (ast.ast-expr-list-tail-from-ref exprs (+ index 1))]
      [scoped-borrowed : TcMovedSet
        (tc-borrow-check-add-all-pending-markers borrowed rest head)]
      (match (tc-borrow-check-expr-id
        ctx
        expr-bases
        env
        locals
        scoped-borrowed
        head)
        [(TcBorrowCheckResult.Ok borrowed1)
          (tc-borrow-check-exprs-with-protected-at
            ctx
            expr-bases
            env
            locals
            (tc-borrow-check-remove-pending-markers borrowed1 head)
            protected
            exprs
            (+ index 1))]
        [(TcBorrowCheckResult.Err message)
          (let
            [head-expr : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases head)]
            [current : ast.AstExprList
              (ast.ast-expr-list-tail-from-ref exprs index)]
            (tc-borrow-check-exprs-retry-after-prune
              ctx
              expr-bases
              env
              locals
              scoped-borrowed
              protected
              head
              current
              head-expr
              rest
              message))]))))

(define (tc-borrow-check-exprs
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : ast.AstExprList]) : TcBorrowCheckResult
  (tc-borrow-check-exprs-with-protected
    ctx
    expr-bases
    env
    locals
    borrowed
    borrowed
    exprs))

(define (tc-borrow-check-expr-with-protected-id
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [expr-id : i64]) : TcBorrowCheckResult
  (tc-borrow-check-expr-with-protected
    ctx
    expr-bases
    env
    locals
    borrowed
    protected
    (ast.ast-expr-segment-bases-get expr-bases expr-id)))

(define (tc-borrow-check-expr-with-protected
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [expr : ast.AstExpr]) : TcBorrowCheckResult
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases expr)
    [(ast.AstExpr.Begin exprs)
      (tc-borrow-check-exprs-with-protected
        ctx
        expr-bases
        env
        locals
        borrowed
        protected
        exprs)]
    [(ast.AstExpr.Unsafe exprs)
      (tc-borrow-check-exprs-with-protected
        ctx
        expr-bases
        env
        locals
        borrowed
        protected
        exprs)]
    [_
      (tc-borrow-check-expr
        ctx
        expr-bases
        env
        locals
        borrowed
        (ast.ast-expr-unspan-with-segment-bases expr-bases expr))]))

(define (tc-borrow-check-expr-id-retry-after-prune
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [expr-id : i64]
  [message : String]) : TcBorrowCheckResult
  (let
    [pending : ast.AstExprList (ast.ast-expr-list-with-capacity 1)]
    (begin
      (ast.ast-expr-list-push (&mut pending) expr-id)
      (let
        [borrowed0 : TcMovedSet
          (tc-borrow-check-prune-before-exprs
            expr-bases
            ctx
            env
            locals
            borrowed
            protected
            pending)]
        (if (= (tc-moved-len borrowed0) (tc-moved-len borrowed))
          (TcBorrowCheckResult.Err message)
          (tc-borrow-check-expr-with-protected-id
            ctx
            expr-bases
            env
            locals
            borrowed0
            protected
            expr-id))))))

(define (tc-borrow-check-expr-type-contains-lifetime?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [lifetime : i64]) : bool
  (match (tc-expr ctx env expr)
    [(ResultTcType.Ok ty)
      (tc-borrow-check-type-contains-lifetime? ctx ty lifetime)]
    [(ResultTcType.Err _) false]))

(define (tc-borrow-check-expr-list-stores-lifetime?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]
  [lifetime : i64]) : bool
  (tc-borrow-check-expr-list-stores-lifetime-at?
    ctx
    expr-bases
    env
    (& exprs)
    0
    lifetime))

(define (tc-borrow-check-expr-list-stores-lifetime-at?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [lifetime : i64]) : bool
  (if (>= index exprs.len)
    false
    (if (tc-borrow-check-expr-stores-lifetime?
      ctx
      expr-bases
      env
      (ast.ast-expr-segment-bases-get
        expr-bases
        (ast.ast-expr-list-get exprs index 0))
      lifetime)
      true
      (tc-borrow-check-expr-list-stores-lifetime-at?
        ctx
        expr-bases
        env
        exprs
        (+ index 1)
        lifetime))))

(define (tc-borrow-check-let-bindings-store-lifetime?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bindings : ast.AstLetBindingList]
  [lifetime : i64]) : bool
  (tc-borrow-check-let-bindings-store-lifetime-at?
    ctx
    expr-bases
    env
    (& bindings)
    lifetime
    0))

(define (tc-borrow-check-let-bindings-store-lifetime-at?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [bindings : (& bindings ast.AstLetBindingList)]
  [lifetime : i64]
  [index : i64]) : bool
  (if (>= index (ast.ast-let-binding-list-len bindings))
    false
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding _ _ init-box)
        (if (tc-borrow-check-expr-stores-lifetime?
          ctx
          expr-bases
          env
          (ast.ast-expr-segment-bases-get expr-bases init-box)
          lifetime)
          true
          (tc-borrow-check-let-bindings-store-lifetime-at?
            ctx
            expr-bases
            env
            bindings
            lifetime
            (+ index 1)))])))

(define (tc-borrow-check-match-arms-store-lifetime?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [arms : ast.AstMatchArmList]
  [lifetime : i64]) : bool
  (tc-borrow-check-match-arms-store-lifetime-at?
    ctx
    expr-bases
    env
    (& arms)
    lifetime
    0))

(define (tc-borrow-check-match-arms-store-lifetime-at?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [arms : (& arms ast.AstMatchArmList)]
  [lifetime : i64]
  [index : i64]) : bool
  (if (>= index arms.len)
    false
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm _ body-box)
        (if (tc-borrow-check-expr-stores-lifetime?
          ctx
          expr-bases
          env
          (ast.ast-expr-segment-bases-get expr-bases body-box)
          lifetime)
          true
          (tc-borrow-check-match-arms-store-lifetime-at?
            ctx
            expr-bases
            env
            arms
            lifetime
            (+ index 1)))])))

(define (tc-borrow-check-expr-stores-lifetime?
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [lifetime : i64]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases expr)
    [(ast.AstExpr.Ann inner-box _)
      (tc-borrow-check-expr-stores-lifetime?
        ctx
        expr-bases
        env
        (ast.ast-expr-segment-bases-get expr-bases inner-box)
        lifetime)]
    [(ast.AstExpr.Cast inner-box _)
      (tc-borrow-check-expr-stores-lifetime?
        ctx
        expr-bases
        env
        (ast.ast-expr-segment-bases-get expr-bases inner-box)
        lifetime)]
    [(ast.AstExpr.Begin exprs)
      (tc-borrow-check-expr-list-stores-lifetime?
        ctx
        expr-bases
        env
        exprs
        lifetime)]
    [(ast.AstExpr.Unsafe exprs)
      (tc-borrow-check-expr-list-stores-lifetime?
        ctx
        expr-bases
        env
        exprs
        lifetime)]
    [(ast.AstExpr.If cond-box then-box else-box)
      (or
        (tc-borrow-check-expr-stores-lifetime?
          ctx
          expr-bases
          env
          (ast.ast-expr-segment-bases-get expr-bases cond-box)
          lifetime)
        (tc-borrow-check-expr-stores-lifetime?
          ctx
          expr-bases
          env
          (ast.ast-expr-segment-bases-get expr-bases then-box)
          lifetime)
        (tc-borrow-check-expr-stores-lifetime?
          ctx
          expr-bases
          env
          (ast.ast-expr-segment-bases-get expr-bases else-box)
          lifetime))]
    [(ast.AstExpr.Let let-box)
      (match (__tl-box-place let-box)
        [(ast.AstLet.Let bindings body-box)
          (or
            (tc-borrow-check-let-bindings-store-lifetime?
              ctx
              expr-bases
              env
              bindings
              lifetime)
            (tc-borrow-check-expr-stores-lifetime?
              ctx
              expr-bases
              env
              (ast.ast-expr-segment-bases-get expr-bases body-box)
              lifetime))])]
    [(ast.AstExpr.Match match-box)
      (match (__tl-box-place match-box)
        [(ast.AstMatch.Match scrut-box arms)
          (or
            (tc-borrow-check-expr-stores-lifetime?
              ctx
              expr-bases
              env
              (ast.ast-expr-segment-bases-get expr-bases scrut-box)
              lifetime)
            (tc-borrow-check-match-arms-store-lifetime?
              ctx
              expr-bases
              env
              arms
              lifetime))])]
    [(ast.AstExpr.Set name rhs-box)
      (if (tc-dotted-place-name-id? ctx env name)
        (match (tc-dotted-local-field-set-expr-id-after-check name rhs-box)
          [(ResultTcExprId.Ok virtual-id)
            (tc-borrow-check-expr-stores-lifetime?
              ctx
              expr-bases
              env
              (ast.ast-expr-segment-bases-get expr-bases virtual-id)
              lifetime)]
          [(ResultTcExprId.Err _) false])
        (match (tc-lookup-id env name)
          [(ResultTcType.Ok ty)
            (tc-borrow-check-type-contains-lifetime? ctx ty lifetime)]
          [(ResultTcType.Err _) false]))]
    [(ast.AstExpr.ArraySet array-box _ _)
      (tc-borrow-check-expr-type-contains-lifetime?
        ctx
        env
        (ast.ast-expr-segment-bases-get expr-bases array-box)
        lifetime)]
    [(ast.AstExpr.ArrayTake array-box _ _)
      (tc-borrow-check-expr-type-contains-lifetime?
        ctx
        env
        (ast.ast-expr-segment-bases-get expr-bases array-box)
        lifetime)]
    [(ast.AstExpr.FixedArrayTake array-box _)
      (tc-borrow-check-expr-type-contains-lifetime?
        ctx
        env
        (ast.ast-expr-segment-bases-get expr-bases array-box)
        lifetime)]
    [(ast.AstExpr.Replace place-box _)
      (match (tc-replace-place-value-type
        ctx
        env
        (ast.ast-expr-segment-bases-get expr-bases place-box))
        [(ResultTcType.Ok place-ty)
          (tc-borrow-check-type-contains-lifetime? ctx place-ty lifetime)]
        [(ResultTcType.Err _) false])]
    [(ast.AstExpr.ArrayPush array-box _)
      (tc-borrow-check-expr-type-contains-lifetime?
        ctx
        env
        (ast.ast-expr-segment-bases-get expr-bases array-box)
        lifetime)]
    [(ast.AstExpr.StructSet receiver-box _ _)
      (tc-borrow-check-expr-type-contains-lifetime?
        ctx
        env
        (ast.ast-expr-segment-bases-get expr-bases receiver-box)
        lifetime)]
    [(ast.AstExpr.BoxSet box-box _)
      (tc-borrow-check-expr-type-contains-lifetime?
        ctx
        env
        (ast.ast-expr-segment-bases-get expr-bases box-box)
        lifetime)]
    [_ false]))

(define (tc-borrow-check-loop-protect-carried-facts-loop
  [ctx : TcContext]
  [loop-env : TcTypeEnv]
  [before : TcMovedSet]
  [facts : TcMovedPathFacts]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [path : TcMovePath fact.path]
      [kind : TcMovedPathKind fact.kind]
      [out2 : TcMovedSet
        (if (or
          (match (tc-moved-path-exact-conflict-kind before path kind)
            [(TcMoveConflict.Some _ _) true]
            [TcMoveConflict.No false])
          (match (tc-moved-path-exact-conflict-kind out path kind)
            [(TcMoveConflict.Some _ _) true]
            [TcMoveConflict.No false]))
          out
          (tc-moved-add-path-fact
            out
            path
            kind
            (tc-moved-path-fact-origin fact)))]
      (tc-borrow-check-loop-protect-carried-facts-loop
        ctx
        loop-env
        before
        rest
        out2))))

(define (tc-borrow-check-loop-protect-carried-facts
  [ctx : TcContext]
  [loop-env : TcTypeEnv]
  [before : TcMovedSet]
  [after : TcMovedSet]
  [protected : TcMovedSet]) : TcMovedSet
  (tc-borrow-check-loop-protect-carried-facts-loop
    ctx
    loop-env
    before
    (tc-moved-paths after)
    protected))

(define (tc-borrow-check-loop-protect-stored-facts-loop
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [facts : TcMovedPathFacts]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [path : TcMovePath fact.path]
      [kind : TcMovedPathKind fact.kind]
      [out2 : TcMovedSet
        (if (match (tc-moved-path-exact-conflict-kind out path kind)
          [(TcMoveConflict.Some _ _) true]
          [TcMoveConflict.No false])
          out
          (let
            [lifetime : i64 (tc-borrow-check-path-lifetime ctx env path)]
            (if (tc-borrow-check-expr-stores-lifetime?
              ctx
              expr-bases
              env
              expr
              lifetime)
              (tc-moved-add-path-fact
                out
                path
                kind
                (tc-moved-path-fact-origin fact))
              out)))]
      (tc-borrow-check-loop-protect-stored-facts-loop
        ctx
        expr-bases
        env
        expr
        rest
        out2))))

(define (tc-borrow-check-loop-protect-stored-facts
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]) : TcMovedSet
  (tc-borrow-check-loop-protect-stored-facts-loop
    ctx
    expr-bases
    env
    expr
    (tc-moved-paths borrowed)
    protected))

(define (tc-borrow-check-loop-visible-body-borrows
  [ctx : TcContext]
  [loop-env : TcTypeEnv]
  [entry : TcMovedSet]
  [body-borrowed : TcMovedSet]) : TcMovedSet
  (tc-moved-union
    (tc-borrow-check-loop-protect-carried-facts
      ctx
      loop-env
      entry
      body-borrowed
      (tc-moved-empty))
    entry))

(define (tc-borrow-loop-result-branches
  [fallback : TcMovedSet]
  [a : TcBorrowLoopResult]
  [b : TcBorrowLoopResult]) : TcBorrowLoopResult
  (match a
    [(TcBorrowLoopResult.Err message) (TcBorrowLoopResult.Err message)]
    [(TcBorrowLoopResult.Ok
        normal-a?
        normal-a-box
        repeat-a?
        repeat-a-box
        breaks-a?
        break-a-box)
      (match b
        [(TcBorrowLoopResult.Err message) (TcBorrowLoopResult.Err message)]
        [(TcBorrowLoopResult.Ok
            normal-b?
            normal-b-box
            repeat-b?
            repeat-b-box
            breaks-b?
            break-b-box)
          (TcBorrowLoopResult.Ok
            (or normal-a? normal-b?)
            (cond
              [(and normal-a? normal-b?)
                (box
                  (tc-moved-union
                    (__tl-box-place normal-a-box)
                    (__tl-box-place normal-b-box)))]
              [normal-a? normal-a-box]
              [normal-b? normal-b-box]
              [else (box fallback)])
            (or repeat-a? repeat-b?)
            (cond
              [(and repeat-a? repeat-b?)
                (box
                  (tc-moved-union
                    (__tl-box-place repeat-a-box)
                    (__tl-box-place repeat-b-box)))]
              [repeat-a? repeat-a-box]
              [else repeat-b-box])
            (or breaks-a? breaks-b?)
            (cond
              [(and breaks-a? breaks-b?)
                (box
                  (tc-moved-union
                    (__tl-box-place break-a-box)
                    (__tl-box-place break-b-box)))]
              [breaks-a? break-a-box]
              [else break-b-box]))])]))

(define (tc-borrow-loop-result-add-edges
  [repeat-prior? : bool]
  [repeat-prior : TcMovedSet]
  [break-prior? : bool]
  [break-prior : TcMovedSet]
  [result : TcBorrowLoopResult]) : TcBorrowLoopResult
  (match result
    [(TcBorrowLoopResult.Err message) (TcBorrowLoopResult.Err message)]
    [(TcBorrowLoopResult.Ok
        normal?
        normal-box
        repeats?
        repeat-box
        breaks?
        break-box)
      (TcBorrowLoopResult.Ok
        normal?
        normal-box
        (or repeat-prior? repeats?)
        (cond
          [(and repeat-prior? repeats?)
            (box (tc-moved-union repeat-prior (__tl-box-place repeat-box)))]
          [repeat-prior? (box repeat-prior)]
          [else repeat-box])
        (or break-prior? breaks?)
        (cond
          [(and break-prior? breaks?)
            (box (tc-moved-union break-prior (__tl-box-place break-box)))]
          [break-prior? (box break-prior)]
          [else break-box]))]))

(define (tc-borrow-loop-visible-edge-state
  [ctx : TcContext]
  [loop-env : TcTypeEnv]
  [entry : TcMovedSet]
  [state : TcMovedSet]
  [remove-root-id : i64]) : TcMovedSet
  (tc-borrow-check-loop-visible-body-borrows
    ctx
    loop-env
    entry
    (if (>= remove-root-id 0)
      (tc-borrow-check-remove-root-state state remove-root-id)
      state)))

(define (tc-borrow-loop-result-exit-state
  [ctx : TcContext]
  [loop-env : TcTypeEnv]
  [entry : TcMovedSet]
  [remove-root-id : i64]
  [result : TcBorrowLoopResult]) : TcBorrowCheckResult
  (match result
    [(TcBorrowLoopResult.Err message) (TcBorrowCheckResult.Err message)]
    [(TcBorrowLoopResult.Ok
        normal?
        normal-box
        repeats?
        repeat-box
        breaks?
        break-box)
      (let
        [out : TcMovedSet (tc-moved-clone entry)]
        (begin
          (if normal?
            (set!
              out
              (tc-moved-union
                out
                (tc-borrow-loop-visible-edge-state
                  ctx
                  loop-env
                  entry
                  (__tl-box-place normal-box)
                  remove-root-id)))
            unit)
          (if repeats?
            (set!
              out
              (tc-moved-union
                out
                (tc-borrow-loop-visible-edge-state
                  ctx
                  loop-env
                  entry
                  (__tl-box-place repeat-box)
                  remove-root-id)))
            unit)
          (if breaks?
            (set!
              out
              (tc-moved-union
                out
                (tc-borrow-loop-visible-edge-state
                  ctx
                  loop-env
                  entry
                  (__tl-box-place break-box)
                  remove-root-id)))
            unit)
          (TcBorrowCheckResult.Ok out)))]))

(define (tc-borrow-check-loop-path-exprs-retry-after-prune
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [pending-scope-id : i64]
  [exprs : ast.AstExprList]
  [head : ast.AstExpr]
  [rest : ast.AstExprList]
  [message : String]) : TcBorrowLoopResult
  (if (= (tc-moved-len borrowed) 0)
    (TcBorrowLoopResult.Err message)
    (let
      [unscoped : TcMovedSet
        (tc-borrow-check-remove-pending-markers borrowed pending-scope-id)]
      [borrowed0 : TcMovedSet
        (tc-borrow-check-prune-before-exprs
          expr-bases
          ctx
          env
          locals
          unscoped
          protected
          exprs)]
      (if (= (tc-moved-len borrowed0) (tc-moved-len unscoped))
        (TcBorrowLoopResult.Err message)
        (match (tc-borrow-check-loop-path-expr
          ctx
          expr-bases
          env
          loop-env
          locals
          borrowed0
          protected
          head)
          [(TcBorrowLoopResult.Err retry-message)
            (TcBorrowLoopResult.Err retry-message)]
          [(TcBorrowLoopResult.Ok
              normal?
              normal-box
              repeats?
              repeat-box
              breaks?
              break-box)
            (let
              [repeat-clean : TcMovedSet
                (tc-borrow-check-remove-pending-markers
                  (__tl-box-place repeat-box)
                  pending-scope-id)]
              [break-clean : TcMovedSet
                (tc-borrow-check-remove-pending-markers
                  (__tl-box-place break-box)
                  pending-scope-id)]
              (if normal?
                (let
                  [normal-clean : TcMovedSet
                    (tc-borrow-check-remove-pending-markers
                      (__tl-box-place normal-box)
                      pending-scope-id)]
                  [protected1 : TcMovedSet
                    (tc-borrow-check-loop-protect-stored-facts
                      ctx
                      expr-bases
                      env
                      head
                      normal-clean
                      (tc-borrow-check-loop-protect-carried-facts
                        ctx
                        loop-env
                        borrowed0
                        normal-clean
                        protected))]
                  (tc-borrow-loop-result-add-edges
                    repeats?
                    repeat-clean
                    breaks?
                    break-clean
                    (tc-borrow-check-loop-path-exprs
                      ctx
                      expr-bases
                      env
                      loop-env
                      locals
                      normal-clean
                      protected1
                      rest)))
                (TcBorrowLoopResult.Ok
                  false
                  normal-box
                  repeats?
                  (box repeat-clean)
                  breaks?
                  (box break-clean))))])))))

(define (tc-borrow-check-loop-path-exprs
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : ast.AstExprList]) : TcBorrowLoopResult
  (tc-borrow-check-loop-path-exprs-at
    ctx
    expr-bases
    env
    loop-env
    locals
    borrowed
    protected
    (& exprs)
    0))

(define (tc-borrow-check-loop-path-exprs-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : TcBorrowLoopResult
  (if (>= index exprs.len)
    (TcBorrowLoopResult.Ok
      true
      (box borrowed)
      false
      (box (tc-moved-empty))
      false
      (box (tc-moved-empty)))
    (let
      [head-id : i64 (ast.ast-expr-list-get exprs index 0)]
      [head : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases head-id)]
      [rest : ast.AstExprList
        (ast.ast-expr-list-tail-from-ref exprs (+ index 1))]
      [scoped-borrowed : TcMovedSet
        (tc-borrow-check-add-all-pending-markers borrowed rest head-id)]
      (match (tc-borrow-check-loop-path-expr
        ctx
        expr-bases
        env
        loop-env
        locals
        scoped-borrowed
        protected
        head)
        [(TcBorrowLoopResult.Err message)
          (let
            [current : ast.AstExprList
              (ast.ast-expr-list-tail-from-ref exprs index)]
            (tc-borrow-check-loop-path-exprs-retry-after-prune
              ctx
              expr-bases
              env
              loop-env
              locals
              scoped-borrowed
              protected
              head-id
              current
              head
              rest
              message))]
        [(TcBorrowLoopResult.Ok
            normal?
            normal-box
            repeats?
            repeat-box
            breaks?
            break-box)
          (let
            [repeat-clean : TcMovedSet
              (tc-borrow-check-remove-pending-markers
                (__tl-box-place repeat-box)
                head-id)]
            [break-clean : TcMovedSet
              (tc-borrow-check-remove-pending-markers
                (__tl-box-place break-box)
                head-id)]
            (if normal?
              (let
                [normal-clean : TcMovedSet
                  (tc-borrow-check-remove-pending-markers
                    (__tl-box-place normal-box)
                    head-id)]
                [protected1 : TcMovedSet
                  (tc-borrow-check-loop-protect-stored-facts
                    ctx
                    expr-bases
                    env
                    head
                    normal-clean
                    (tc-borrow-check-loop-protect-carried-facts
                      ctx
                      loop-env
                      borrowed
                      normal-clean
                      protected))]
                (tc-borrow-loop-result-add-edges
                  repeats?
                  repeat-clean
                  breaks?
                  break-clean
                  (tc-borrow-check-loop-path-exprs-at
                    ctx
                    expr-bases
                    env
                    loop-env
                    locals
                    normal-clean
                    protected1
                    exprs
                    (+ index 1))))
              (TcBorrowLoopResult.Ok
                false
                normal-box
                repeats?
                (box repeat-clean)
                breaks?
                (box break-clean))))]))))

(define (tc-borrow-check-exprs-loop-retry-after-prune
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [pending-scope-id : i64]
  [exprs : ast.AstExprList]
  [head : ast.AstExpr]
  [rest : ast.AstExprList]
  [message : String]) : TcBorrowCheckResult
  (if (= (tc-moved-len borrowed) 0)
    (TcBorrowCheckResult.Err message)
    (let
      [unscoped : TcMovedSet
        (tc-borrow-check-remove-pending-markers borrowed pending-scope-id)]
      [borrowed0 : TcMovedSet
        (tc-borrow-check-prune-before-exprs
          expr-bases
          ctx
          env
          locals
          unscoped
          protected
          exprs)]
      (if (= (tc-moved-len borrowed0) (tc-moved-len unscoped))
        (TcBorrowCheckResult.Err message)
        (match (tc-borrow-check-expr-loop
          ctx
          expr-bases
          env
          loop-env
          locals
          borrowed0
          protected
          head)
          [(TcBorrowCheckResult.Ok borrowed1)
            (let
              [borrowed2 : TcMovedSet
                (tc-borrow-check-remove-pending-markers
                  borrowed1
                  pending-scope-id)]
              [protected1 : TcMovedSet
                (tc-borrow-check-loop-protect-stored-facts
                  ctx
                  expr-bases
                  env
                  head
                  borrowed2
                  (tc-borrow-check-loop-protect-carried-facts
                    ctx
                    loop-env
                    borrowed0
                    borrowed2
                    protected))]
              (tc-borrow-check-exprs-loop
                ctx
                expr-bases
                env
                loop-env
                locals
                borrowed2
                protected1
                rest))]
          [(TcBorrowCheckResult.Err retry-message)
            (TcBorrowCheckResult.Err retry-message)])))))

(define (tc-borrow-check-exprs-loop
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : ast.AstExprList]) : TcBorrowCheckResult
  (tc-borrow-check-exprs-loop-at
    ctx
    expr-bases
    env
    loop-env
    locals
    borrowed
    protected
    (& exprs)
    0))

(define (tc-borrow-check-exprs-loop-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index exprs.len)
    (TcBorrowCheckResult.Ok borrowed)
    (let
      [head-id : i64 (ast.ast-expr-list-get exprs index 0)]
      [head : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases head-id)]
      [rest : ast.AstExprList
        (ast.ast-expr-list-tail-from-ref exprs (+ index 1))]
      [scoped-borrowed : TcMovedSet
        (tc-borrow-check-add-all-pending-markers borrowed rest head-id)]
      (match (tc-borrow-check-expr-loop
        ctx
        expr-bases
        env
        loop-env
        locals
        scoped-borrowed
        protected
        head)
        [(TcBorrowCheckResult.Ok borrowed1)
          (let
            [borrowed2 : TcMovedSet
              (tc-borrow-check-remove-pending-markers borrowed1 head-id)]
            [protected1 : TcMovedSet
              (tc-borrow-check-loop-protect-stored-facts
                ctx
                expr-bases
                env
                head
                borrowed2
                (tc-borrow-check-loop-protect-carried-facts
                  ctx
                  loop-env
                  borrowed
                  borrowed2
                  protected))]
            (tc-borrow-check-exprs-loop-at
              ctx
              expr-bases
              env
              loop-env
              locals
              borrowed2
              protected1
              exprs
              (+ index 1)))]
        [(TcBorrowCheckResult.Err message)
          (let
            [current : ast.AstExprList
              (ast.ast-expr-list-tail-from-ref exprs index)]
            (tc-borrow-check-exprs-loop-retry-after-prune
              ctx
              expr-bases
              env
              loop-env
              locals
              scoped-borrowed
              protected
              head-id
              current
              head
              rest
              message))]))))

(define (tc-borrow-check-arms-loop-join
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]
  [joined : TcMovedSet]) : TcBorrowCheckResult
  (tc-borrow-check-arms-loop-join-at
    ctx
    expr-bases
    env
    loop-env
    locals
    borrowed
    scrut-ty
    (& arms)
    joined
    0))

(define (tc-borrow-check-arms-loop-join-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : ast.AstType]
  [arms : (& arms ast.AstMatchArmList)]
  [joined : TcMovedSet]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index arms.len)
    (TcBorrowCheckResult.Ok joined)
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm pattern body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          (match (tc-bind-match-pattern ctx env scrut-ty pattern)
            [(ResultTcEnv.Ok arm-env)
              (match (tc-borrow-check-expr-loop
                ctx
                expr-bases
                arm-env
                loop-env
                (tc-borrow-check-pattern-locals
                  ctx
                  scrut-ty
                  pattern
                  (tc-moved-clone locals))
                (tc-moved-clone borrowed)
                borrowed
                body)
                [(TcBorrowCheckResult.Ok arm-borrowed)
                  (let
                    [visible-arm-borrowed : TcMovedSet
                      (tc-borrow-check-remove-root-states
                        arm-borrowed
                        (tc-borrow-check-pattern-bound-names
                          ctx
                          scrut-ty
                          pattern))]
                    (tc-borrow-check-arms-loop-join-at
                      ctx
                      expr-bases
                      env
                      loop-env
                      locals
                      borrowed
                      scrut-ty
                      arms
                      (tc-moved-union joined visible-arm-borrowed)
                      (+ index 1)))]
                [(TcBorrowCheckResult.Err message)
                  (TcBorrowCheckResult.Err message)])]
            [(ResultTcEnv.Err message) (TcBorrowCheckResult.Err message)]))])))

(define (tc-borrow-check-arms-loop
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]) : TcBorrowCheckResult
  (tc-borrow-check-arms-loop-join
    ctx
    expr-bases
    env
    loop-env
    locals
    borrowed
    scrut-ty
    arms
    borrowed))

(define (tc-borrow-check-expr-loop
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [expr : ast.AstExpr]) : TcBorrowCheckResult
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases expr)
    [(ast.AstExpr.Begin exprs)
      (tc-borrow-check-exprs-loop
        ctx
        expr-bases
        env
        loop-env
        locals
        borrowed
        protected
        exprs)]
    [(ast.AstExpr.Unsafe exprs)
      (tc-borrow-check-exprs-loop
        ctx
        expr-bases
        env
        loop-env
        locals
        borrowed
        protected
        exprs)]
    [(ast.AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases cond-box)]
        [then-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases then-branch-box)]
        [else-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases else-branch-box)]
        (match (tc-borrow-check-expr ctx expr-bases env locals borrowed cond)
          [(TcBorrowCheckResult.Ok borrowedc)
            (match (tc-borrow-check-expr-loop
              ctx
              expr-bases
              env
              loop-env
              (tc-moved-clone locals)
              (tc-moved-clone borrowedc)
              borrowedc
              then-branch)
              [(TcBorrowCheckResult.Ok borrowedt)
                (match (tc-borrow-check-expr-loop
                  ctx
                  expr-bases
                  env
                  loop-env
                  (tc-moved-clone locals)
                  (tc-moved-clone borrowedc)
                  borrowedc
                  else-branch)
                  [(TcBorrowCheckResult.Ok borrowede)
                    (TcBorrowCheckResult.Ok
                      (tc-moved-union borrowedt borrowede))]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(ast.AstExpr.Let let-box)
      (match (__tl-box-place let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (match (tc-borrow-check-let-bindings
              ctx
              expr-bases
              env
              (tc-moved-clone locals)
              (tc-moved-clone borrowed)
              borrowed
              bindings
              body-box)
              [(TcBorrowCheckBindings.Ok env2 locals2 borrowed2)
                (match (tc-borrow-check-expr-loop
                  ctx
                  expr-bases
                  env2
                  loop-env
                  locals2
                  borrowed2
                  borrowed
                  body)
                  [(TcBorrowCheckResult.Ok body-borrowed)
                    (TcBorrowCheckResult.Ok
                      (tc-borrow-check-loop-visible-body-borrows
                        ctx
                        loop-env
                        borrowed
                        body-borrowed))]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckBindings.Err message)
                (TcBorrowCheckResult.Err message)]))])]
    [(ast.AstExpr.Match match-box)
      (match (__tl-box-place match-box)
        [(ast.AstMatch.Match scrut-box arms)
          (let
            [scrut : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases scrut-box)]
            (match (tc-borrow-check-expr
              ctx
              expr-bases
              env
              locals
              borrowed
              scrut)
              [(TcBorrowCheckResult.Ok borroweds)
                (match (tc-body-type-fact-expr-id
                  "borrow.match_scrutinee"
                  ctx
                  env
                  scrut-box)
                  [(ResultTcType.Ok scrut-ty)
                    (tc-borrow-check-arms-loop
                      ctx
                      expr-bases
                      env
                      loop-env
                      locals
                      borroweds
                      scrut-ty
                      arms)]
                  [(ResultTcType.Err message) (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)]))])]
    [_
      (tc-borrow-check-expr
        ctx
        expr-bases
        env
        locals
        borrowed
        (ast.ast-expr-unspan-with-segment-bases expr-bases expr))]))

(define (tc-borrow-check-loop-path-expr
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [expr : ast.AstExpr]) : TcBorrowLoopResult
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases expr)
    [(ast.AstExpr.Begin exprs)
      (tc-borrow-check-loop-path-exprs
        ctx
        expr-bases
        env
        loop-env
        locals
        borrowed
        protected
        exprs)]
    [(ast.AstExpr.Unsafe exprs)
      (tc-borrow-check-loop-path-exprs
        ctx
        expr-bases
        env
        loop-env
        locals
        borrowed
        protected
        exprs)]
    [(ast.AstExpr.BracketClause exprs)
      (tc-borrow-check-loop-path-exprs
        ctx
        expr-bases
        env
        loop-env
        locals
        borrowed
        protected
        exprs)]
    [(ast.AstExpr.If cond-box then-box else-box)
      (match (tc-borrow-check-expr-id
        ctx
        expr-bases
        env
        locals
        borrowed
        cond-box)
        [(TcBorrowCheckResult.Err message) (TcBorrowLoopResult.Err message)]
        [(TcBorrowCheckResult.Ok borrowedc)
          (tc-borrow-loop-result-branches
            borrowedc
            (tc-borrow-check-loop-path-expr
              ctx
              expr-bases
              env
              loop-env
              (tc-moved-clone locals)
              (tc-moved-clone borrowedc)
              borrowedc
              (ast.ast-expr-segment-bases-get expr-bases then-box))
            (tc-borrow-check-loop-path-expr
              ctx
              expr-bases
              env
              loop-env
              (tc-moved-clone locals)
              (tc-moved-clone borrowedc)
              borrowedc
              (ast.ast-expr-segment-bases-get expr-bases else-box)))])]
    [(ast.AstExpr.Let let-box)
      (match (__tl-box-place let-box)
        [(ast.AstLet.Let bindings body-box)
          (match (tc-borrow-check-let-bindings
            ctx
            expr-bases
            env
            (tc-moved-clone locals)
            (tc-moved-clone borrowed)
            borrowed
            bindings
            body-box)
            [(TcBorrowCheckBindings.Err message)
              (TcBorrowLoopResult.Err message)]
            [(TcBorrowCheckBindings.Ok env2 locals2 borrowed2)
              (match (tc-borrow-check-loop-path-expr
                ctx
                expr-bases
                env2
                loop-env
                locals2
                borrowed2
                borrowed
                (ast.ast-expr-segment-bases-get expr-bases body-box))
                [(TcBorrowLoopResult.Err message)
                  (TcBorrowLoopResult.Err message)]
                [(TcBorrowLoopResult.Ok
                    normal?
                    normal-box
                    repeats?
                    repeat-box
                    breaks?
                    break-box)
                  (TcBorrowLoopResult.Ok
                    normal?
                    (box
                      (tc-borrow-check-loop-visible-body-borrows
                        ctx
                        loop-env
                        borrowed
                        (__tl-box-place normal-box)))
                    repeats?
                    (box
                      (tc-borrow-check-loop-visible-body-borrows
                        ctx
                        loop-env
                        borrowed
                        (__tl-box-place repeat-box)))
                    breaks?
                    (box
                      (tc-borrow-check-loop-visible-body-borrows
                        ctx
                        loop-env
                        borrowed
                        (__tl-box-place break-box))))])])])]
    [(ast.AstExpr.Return _)
      (match (tc-borrow-check-expr ctx expr-bases env locals borrowed expr)
        [(TcBorrowCheckResult.Ok borrowed1)
          (TcBorrowLoopResult.Ok
            false
            (box borrowed1)
            false
            (box (tc-moved-empty))
            false
            (box (tc-moved-empty)))]
        [(TcBorrowCheckResult.Err message) (TcBorrowLoopResult.Err message)])]
    [(ast.AstExpr.Break)
      (TcBorrowLoopResult.Ok
        false
        (box borrowed)
        false
        (box (tc-moved-empty))
        true
        (box borrowed))]
    [(ast.AstExpr.Continue)
      (TcBorrowLoopResult.Ok
        false
        (box borrowed)
        true
        (box borrowed)
        false
        (box (tc-moved-empty)))]
    [_
      (match (tc-borrow-check-expr-loop
        ctx
        expr-bases
        env
        loop-env
        locals
        borrowed
        protected
        expr)
        [(TcBorrowCheckResult.Err message) (TcBorrowLoopResult.Err message)]
        [(TcBorrowCheckResult.Ok borrowed1)
          (let
            [flow : TcMoveLoopFlow
              (tc-move-loop-flow-expr ctx expr-bases env expr)]
            (TcBorrowLoopResult.Ok
              flow.normal
              (box borrowed1)
              flow.repeat
              (box borrowed1)
              flow.breaks
              (box borrowed1)))])]))

(define (tc-borrow-check-read-exprs
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : ast.AstExprList]) : TcBorrowCheckResult
  (tc-borrow-check-read-exprs-at ctx expr-bases env locals borrowed (& exprs) 0))

(define (tc-borrow-check-read-exprs-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index exprs.len)
    (TcBorrowCheckResult.Ok borrowed)
    (let
      [head : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get exprs index 0))]
      (match (tc-borrow-check-expr ctx expr-bases env locals borrowed head)
        [(TcBorrowCheckResult.Ok borrowed1)
          (if (= (tc-moved-len borrowed1) 0)
            (tc-borrow-check-read-exprs-at
              ctx
              expr-bases
              env
              locals
              borrowed1
              exprs
              (+ index 1))
            (match (tc-borrow-check-place-read-conflict
              expr-bases
              locals
              borrowed1
              head
              head)
              [(TcBorrowCheckResult.Ok borrowed2)
                (tc-borrow-check-read-exprs-at
                  ctx
                  expr-bases
                  env
                  locals
                  borrowed2
                  exprs
                  (+ index 1))]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)]))]
        [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))))

(define (tc-borrow-check-add-returned-call-arg-borrow
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [arg : ast.AstExpr]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (match (cfg
    compile-profile
    (compiler-tc-reinfer-profile-expr "borrow.return_arg" ctx env arg)
    (tc-expr ctx env arg))
    [(ResultTcType.Ok arg-ty)
      (if (tc-name-id-list-overlaps?
        (tc-type-collect-reference-lifetimes (tc-resolve-type ctx arg-ty))
        result-lifetimes)
        (match (ast.ast-expr-unspan arg)
          [(ast.AstExpr.Borrow mutable _ place-box)
            (let
              [place : ast.AstExpr
                (ast.ast-expr-segment-bases-get expr-bases place-box)]
              (tc-borrow-check-add-place-with-mutability
                expr-bases
                locals
                borrowed
                mutable
                place
                arg))]
          [(ast.AstExpr.Ann inner-box _)
            (let
              [inner : ast.AstExpr
                (ast.ast-expr-segment-bases-get expr-bases inner-box)]
              (tc-borrow-check-add-returned-call-arg-borrow
                ctx
                expr-bases
                env
                locals
                borrowed
                inner
                result-lifetimes))]
          [(ast.AstExpr.Cast inner-box _)
            (let
              [inner : ast.AstExpr
                (ast.ast-expr-segment-bases-get expr-bases inner-box)]
              (tc-borrow-check-add-returned-call-arg-borrow
                ctx
                expr-bases
                env
                locals
                borrowed
                inner
                result-lifetimes))]
          [_ (TcBorrowCheckResult.Ok borrowed)])
        (TcBorrowCheckResult.Ok borrowed))]
    [(ResultTcType.Err _) (TcBorrowCheckResult.Ok borrowed)]))

(define (tc-borrow-check-add-returned-call-borrows
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : ast.AstExprList]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (tc-borrow-check-add-returned-call-borrows-at
    ctx
    expr-bases
    env
    locals
    borrowed
    (& args)
    0
    result-lifetimes))

(define (tc-borrow-check-add-returned-call-borrows-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : (& args ast.AstExprList)]
  [index : i64]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (if (>= index args.len)
    (TcBorrowCheckResult.Ok borrowed)
    (let
      [arg : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get args index 0))]
      (match (tc-borrow-check-add-returned-call-arg-borrow
        ctx
        expr-bases
        env
        locals
        borrowed
        arg
        result-lifetimes)
        [(TcBorrowCheckResult.Ok borrowed1)
          (tc-borrow-check-add-returned-call-borrows-at
            ctx
            expr-bases
            env
            locals
            borrowed1
            args
            (+ index 1)
            result-lifetimes)]
        [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))))

(define (tc-borrow-check-after-returning-call-lifetimes
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : ast.AstExprList]
  [result-lifetimes : TcNameIdList]) : TcBorrowCheckResult
  (match result-lifetimes
    [(TcNameIdList.Nil) (TcBorrowCheckResult.Ok borrowed)]
    [_
      (tc-borrow-check-add-returned-call-borrows
        ctx
        expr-bases
        env
        locals
        borrowed
        args
        result-lifetimes)]))

(define (tc-borrow-check-after-returning-call
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : ast.AstExpr]
  [args : ast.AstExprList]
  [return-lifetimes : TcBorrowCallReturnLifetimes]) : TcBorrowCheckResult
  (match return-lifetimes
    [(TcBorrowCallReturnLifetimes.Known result-lifetimes)
      (tc-borrow-check-after-returning-call-lifetimes
        ctx
        expr-bases
        env
        locals
        borrowed
        args
        result-lifetimes)]
    [(TcBorrowCallReturnLifetimes.Fallback)
      (match (cfg
        compile-profile
        (compiler-tc-reinfer-profile-expr
          "borrow.return_call"
          ctx
          env
          call-expr)
        (tc-expr ctx env call-expr))
        [(ResultTcType.Ok result-ty)
          (tc-borrow-check-after-returning-call-lifetimes
            ctx
            expr-bases
            env
            locals
            borrowed
            args
            (tc-type-collect-reference-lifetimes
              (tc-resolve-type ctx result-ty)))]
        [(ResultTcType.Err _) (TcBorrowCheckResult.Ok borrowed)])]))

;; A reference captured by a direct local closure is used when that closure is
;; called, not merely when its environment is created. Retarget the NLL lending
;; marker from the captured reference binding to the closure binding so the
;; referent stays borrowed through the last direct call. The ordinary borrow
;; path and its diagnostic origin remain unchanged.
(define (tc-borrow-check-rebind-lambda-lending-facts
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [bound : TcStringList]
  [body : ast.AstExpr]
  [closure-id : i64]
  [facts : TcMovedPathFacts]) : TcMovedPathFacts
  (if (tc-moved-path-facts-empty? facts)
    TcMovedPathFacts.Nil
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [tail : TcMovedPathFacts
        (tc-borrow-check-rebind-lambda-lending-facts
          ctx
          expr-bases
          env
          locals
          bound
          body
          closure-id
          rest)]
      (match fact.kind
        [(TcMovedPathKind.BorrowLending binding-id)
          (let
            [captured : bool
              (tc-expr-uses-free-name?
                expr-bases
                body
                (tc-env-key-name-text binding-id)
                bound)]
            (if captured
              (let
                [rebound : TcMovedPathFact
                  (TcMovedPathFact
                    fact.path
                    (TcMovedPathKind.BorrowLending closure-id)
                    fact.origin)]
                (if (tc-closure-local-fact-copyable-code?
                  (tc-closure-local-fact-code locals binding-id))
                  (tc-moved-path-facts-cons
                    (tc-moved-path-facts-cons tail rebound)
                    fact)
                  (tc-moved-path-facts-cons tail rebound)))
              (tc-moved-path-facts-cons tail fact)))]
        [_ (tc-moved-path-facts-cons tail fact)]))))

;; A Copy closure alias keeps the source closure live and gains the same
;; lending provenance. Duplicate only the checker-only lending marker; the
;; shared-borrow fact and its diagnostic origin remain single and unchanged.
(define (tc-borrow-check-copy-lambda-lending-facts
  [facts : TcMovedPathFacts]
  [source-id : i64]
  [closure-id : i64]) : TcMovedPathFacts
  (if (tc-moved-path-facts-empty? facts)
    TcMovedPathFacts.Nil
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [tail : TcMovedPathFacts
        (tc-borrow-check-copy-lambda-lending-facts rest source-id closure-id)]
      (match fact.kind
        [(TcMovedPathKind.BorrowLending binding-id)
          (if (= binding-id source-id)
            (tc-moved-path-facts-cons
              (tc-moved-path-facts-cons
                tail
                (TcMovedPathFact
                  fact.path
                  (TcMovedPathKind.BorrowLending closure-id)
                  fact.origin))
              fact)
            (tc-moved-path-facts-cons tail fact))]
        [_ (tc-moved-path-facts-cons tail fact)]))))

(define (tc-borrow-check-add-closure-lending-for-lifetimes
  [ctx : TcContext]
  [env : TcTypeEnv]
  [facts : TcMovedPathFacts]
  [lifetimes : TcNameIdList]
  [closure-id : i64]
  [origin : ast.AstExpr]
  [out : TcMovedSet]) : TcMovedSet
  (if (tc-moved-path-facts-empty? facts)
    out
    (let
      [fact : TcMovedPathFact (tc-moved-path-facts-head facts)]
      [rest : TcMovedPathFacts (tc-moved-path-facts-rest facts)]
      [path : TcMovePath fact.path]
      [out2 : TcMovedSet
        (if (and
          (match fact.kind
            [(TcMovedPathKind.BorrowShared) true]
            [_ false])
          (tc-name-id-list-contains
            lifetimes
            (tc-borrow-check-path-lifetime ctx env path)))
          (tc-borrow-check-add-lending-marker out path closure-id origin)
          out)]
      (tc-borrow-check-add-closure-lending-for-lifetimes
        ctx
        env
        rest
        lifetimes
        closure-id
        origin
        out2))))

(define (tc-borrow-check-add-lambda-capture-lending-scan
  [ctx : TcContext]
  [expr-bases : i64]
  [root-env : TcTypeEnv]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [body : ast.AstExpr]
  [closure-id : i64]
  [origin : ast.AstExpr]
  [seen : TcStringList]
  [borrowed : TcMovedSet]) : TcMovedSet
  (match (tc-type-env-marker-step env)
    [(TcTypeEnvMarkerStep.Done) borrowed]
    [(TcTypeEnvMarkerStep.Cache rest-env)
      (tc-borrow-check-add-lambda-capture-lending-scan
        ctx
        expr-bases
        root-env
        rest-env
        bound
        body
        closure-id
        origin
        seen
        borrowed)]
    [(TcTypeEnvMarkerStep.Bind key ty rest-env)
      (let
        [name : String (tc-env-key-name-text key)]
        (cond
          [(= key (tc-default-boundary-id)) borrowed]
          [(or
              (= key (tc-region-marker-id))
              (tc-cleanup-owner-marker-entry? key ty)
              (tc-ordinary-arena-owner-marker-entry? key ty)
              (tc-atomic-arena-owner-marker-entry? key ty)
              (tc-string-list-contains seen name))
            (tc-borrow-check-add-lambda-capture-lending-scan
              ctx
              expr-bases
              root-env
              rest-env
              bound
              body
              closure-id
              origin
              seen
              borrowed)]
          [else
            (tc-borrow-check-add-lambda-capture-lending-scan
              ctx
              expr-bases
              root-env
              rest-env
              bound
              body
              closure-id
              origin
              (tc-string-list-add seen name)
              (if (and
                (tc-expr-uses-free-name? expr-bases body name bound)
                (tc-type-contains-reference? (tc-resolve-type ctx ty)))
                (tc-borrow-check-add-closure-lending-for-lifetimes
                  ctx
                  root-env
                  (tc-moved-paths borrowed)
                  (tc-type-collect-reference-lifetimes (tc-resolve-type ctx ty))
                  closure-id
                  origin
                  borrowed)
                borrowed))]))]))

(define (tc-borrow-check-rebind-lambda-lending
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [closure-id : i64]
  [init : ast.AstExpr]) : TcMovedSet
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases init)
    [(ast.AstExpr.Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(ast.AstLambda.Lambda params _ body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [facts : TcMovedPathFacts
              (tc-borrow-check-rebind-lambda-lending-facts
                ctx
                expr-bases
                env
                locals
                (tc-param-bound-names params)
                body
                closure-id
                (tc-moved-paths borrowed))]
            [rebound : TcMovedSet
              (TcMovedSet
                (tc-moved-roots borrowed)
                (tc-moved-partials borrowed)
                facts
                (tc-moved-hidden-atomic-users borrowed)
                (tc-moved-param-storage-origins borrowed))]
            (tc-borrow-check-add-lambda-capture-lending-scan
              ctx
              expr-bases
              env
              (tc-type-env-marker-start env)
              (tc-param-bound-names params)
              body
              closure-id
              init
              TcStringList.Nil
              rebound))])]
    [_
      (match (tc-move-bare-var expr-bases init)
        [(TcMaybeMoveName.Some source-id _)
          (let
            [code : i64 (tc-closure-local-fact-code locals source-id)]
            (if (tc-closure-local-fact-copyable-code? code)
              (let
                [facts : TcMovedPathFacts
                  (tc-borrow-check-copy-lambda-lending-facts
                    (tc-moved-paths borrowed)
                    source-id
                    closure-id)]
                (TcMovedSet
                  (tc-moved-roots borrowed)
                  (tc-moved-partials borrowed)
                  facts
                  (tc-moved-hidden-atomic-users borrowed)
                  (tc-moved-param-storage-origins borrowed)))
              borrowed))]
        [(TcMaybeMoveName.No) borrowed])]))

(define (tc-borrow-check-let-pending-exprs
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]
  [body-box : i64]) : ast.AstExprList
  (let
    [out : ast.AstExprList
      (ast.ast-expr-list-with-capacity
        (+ (- (ast.ast-let-binding-list-len bindings) index) 1))]
    [cursor : i64 index]
    (begin
      (while (< cursor (ast.ast-let-binding-list-len bindings))
        (begin
          (match (ast.ast-let-binding-list-get
            bindings
            cursor
            (ast.ast-let-binding-fallback))
            [(ast.AstLetBinding.Binding _ _ init-box)
              (ast.ast-expr-list-push (&mut out) init-box)])
          (set! cursor (+ cursor 1))))
      (ast.ast-expr-list-push (&mut out) body-box)
      out)))

(define (tc-borrow-check-let-bindings
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [bindings : ast.AstLetBindingList]
  [body-box : i64]) : TcBorrowCheckBindings
  (tc-borrow-check-let-bindings-at
    ctx
    expr-bases
    env
    locals
    borrowed
    protected
    (& bindings)
    body-box
    0))

(define (tc-borrow-check-let-bindings-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [bindings : (& bindings ast.AstLetBindingList)]
  [body-box : i64]
  [index : i64]) : TcBorrowCheckBindings
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (TcBorrowCheckBindings.Ok env locals borrowed)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding name maybe-ty init-box)
        (let
          [pending-exprs : ast.AstExprList
            (tc-borrow-check-let-pending-exprs bindings (+ index 1) body-box)]
          [scoped-borrowed : TcMovedSet
            (tc-borrow-check-add-all-pending-markers
              borrowed
              pending-exprs
              body-box)]
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          (match (tc-borrow-check-expr-id
            ctx
            expr-bases
            env
            locals
            scoped-borrowed
            init-box)
            [(TcBorrowCheckResult.Ok borrowed1)
              (let
                [borrowed1-clean : TcMovedSet
                  (tc-borrow-check-remove-pending-markers borrowed1 body-box)]
                [binding-ty : ast.AstType
                  (tc-move-binding-type-id
                    "borrow.let_init"
                    ctx
                    env
                    maybe-ty
                    init-box)]
                (match (tc-borrow-check-after-bind-known-type-id
                  ctx
                  expr-bases
                  env
                  locals
                  borrowed1-clean
                  name
                  init-box
                  binding-ty)
                  [(TcBorrowCheckResult.Ok borrowed2)
                    (let
                      [borrowed3 : TcMovedSet
                        (tc-borrow-check-mark-new-return-borrows
                          ctx
                          env
                          locals
                          borrowed
                          borrowed2
                          name
                          binding-ty
                          init)]
                      [borrowed4 : TcMovedSet
                        (tc-borrow-check-rebind-split-projection
                          expr-bases
                          borrowed3
                          name
                          init)]
                      [borrowed5 : TcMovedSet
                        (tc-borrow-check-rebind-lambda-lending
                          ctx
                          expr-bases
                          env
                          locals
                          borrowed4
                          name
                          init)]
                      (tc-borrow-check-let-bindings-at
                        ctx
                        expr-bases
                        (tc-bind-c-abi-fnptr-if-needed-id
                          ctx
                          env
                          name
                          binding-ty
                          init)
                        (tc-move-add-local-binding
                          ctx
                          expr-bases
                          env
                          locals
                          name
                          init)
                        (tc-borrow-check-remove-root-state borrowed5 name)
                        protected
                        bindings
                        body-box
                        (+ index 1)))]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckBindings.Err message)]))]
            [(TcBorrowCheckResult.Err message)
              (let
                [current-and-pending : ast.AstExprList
                  (tc-borrow-check-let-pending-exprs bindings index body-box)]
                [borrowed0 : TcMovedSet
                  (tc-borrow-check-prune-before-exprs
                    expr-bases
                    ctx
                    env
                    locals
                    borrowed
                    protected
                    current-and-pending)]
                (if (= (tc-moved-len borrowed0) (tc-moved-len borrowed))
                  (TcBorrowCheckBindings.Err message)
                  (tc-borrow-check-let-bindings-at
                    ctx
                    expr-bases
                    env
                    locals
                    borrowed0
                    protected
                    bindings
                    body-box
                    index)))]))])))

(define (tc-borrow-check-let-exit
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [outer-locals : TcMovedSet]
  [outer-borrowed : TcMovedSet]
  [body-borrowed : TcMovedSet]
  [body-box : i64]) : TcBorrowCheckResult
  (let
    [outer-with-uses : TcMovedSet
      (tc-borrow-check-propagate-lending-uses body-borrowed outer-borrowed)]
    (if (<= (tc-moved-len body-borrowed) (tc-moved-len outer-with-uses))
      (TcBorrowCheckResult.Ok outer-with-uses)
      (match (tc-body-type-fact-expr-id "borrow.let_return" ctx env body-box)
        [(ResultTcType.Ok result-ty)
          (TcBorrowCheckResult.Ok
            (tc-borrow-check-propagate-return-borrows
              ctx
              expr-bases
              env
              outer-locals
              outer-with-uses
              body-borrowed
              result-ty
              (ast.ast-expr-segment-bases-get expr-bases body-box)))]
        [(ResultTcType.Err _) (TcBorrowCheckResult.Ok outer-with-uses)]))))

(define (tc-borrow-check-resource-bindings
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bindings : ast.AstResourceBindingList]) : TcBorrowCheckResourceBindings
  (tc-borrow-check-resource-bindings-at
    ctx
    expr-bases
    env
    locals
    borrowed
    (& bindings)
    0))

(define (tc-borrow-check-resource-bindings-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [index : i64]) : TcBorrowCheckResourceBindings
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    (TcBorrowCheckResourceBindings.Ok env locals borrowed)
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(ast.AstResourceBinding.Binding name init-box _ _)
        (let
          [_init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          (match (tc-borrow-check-expr-id
            ctx
            expr-bases
            env
            locals
            borrowed
            init-box)
            [(TcBorrowCheckResult.Ok borrowed1)
              (match (tc-borrow-check-after-bind-id
                ctx
                expr-bases
                env
                locals
                borrowed1
                init-box)
                [(TcBorrowCheckResult.Ok borrowed2)
                  (match (tc-body-type-fact-expr-id
                    "borrow.resource_init"
                    ctx
                    env
                    init-box)
                    [(ResultTcType.Ok init-ty)
                      (tc-borrow-check-resource-bindings-at
                        ctx
                        expr-bases
                        (tc-bind-id
                          (tc-bind-id
                            env
                            (tc-cleanup-owner-marker-id)
                            (ast.AstType.Var name))
                          name
                          (tc-type-without-regions init-ty))
                        (tc-moved-add locals name)
                        (tc-borrow-check-remove-root-state borrowed2 name)
                        bindings
                        (+ index 1))]
                    [(ResultTcType.Err message)
                      (TcBorrowCheckResourceBindings.Err message)])]
                [(TcBorrowCheckResult.Err message)
                  (TcBorrowCheckResourceBindings.Err message)])]
            [(TcBorrowCheckResult.Err message)
              (TcBorrowCheckResourceBindings.Err message)]))])))

(define (tc-borrow-check-arms-join
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]
  [joined : TcMovedSet]) : TcBorrowCheckResult
  (tc-borrow-check-arms-join-at
    ctx
    expr-bases
    env
    locals
    borrowed
    scrut-ty
    (& arms)
    joined
    0))

(define (tc-borrow-check-arms-join-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : ast.AstType]
  [arms : (& arms ast.AstMatchArmList)]
  [joined : TcMovedSet]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index arms.len)
    (TcBorrowCheckResult.Ok joined)
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm pattern body-box)
        (match (tc-bind-match-pattern ctx env scrut-ty pattern)
          [(ResultTcEnv.Ok arm-env)
            (match (tc-borrow-check-expr-id
              ctx
              expr-bases
              arm-env
              (tc-borrow-check-pattern-locals
                ctx
                scrut-ty
                pattern
                (tc-moved-clone locals))
              (tc-moved-clone borrowed)
              body-box)
              [(TcBorrowCheckResult.Ok arm-borrowed)
                (let
                  [visible-arm-borrowed : TcMovedSet
                    (tc-borrow-check-remove-root-states
                      arm-borrowed
                      (tc-borrow-check-pattern-bound-names ctx scrut-ty pattern))]
                  (tc-borrow-check-arms-join-at
                    ctx
                    expr-bases
                    env
                    locals
                    borrowed
                    scrut-ty
                    arms
                    (tc-moved-union joined visible-arm-borrowed)
                    (+ index 1)))]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(ResultTcEnv.Err message) (TcBorrowCheckResult.Err message)])])))

(define (tc-borrow-check-arms
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]) : TcBorrowCheckResult
  (tc-borrow-check-arms-join
    ctx
    expr-bases
    env
    locals
    borrowed
    scrut-ty
    arms
    borrowed))

(define (tc-borrow-check-expr-id
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr-id : i64]) : TcBorrowCheckResult
  (tc-borrow-check-expr
    ctx
    expr-bases
    env
    locals
    borrowed
    (ast.ast-expr-segment-bases-get expr-bases expr-id)))

(define (tc-borrow-check-slice-view-call
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : ast.AstExpr]
  [kind : TcSliceViewCallKind]
  [args : ast.AstExprList]) : TcBorrowCheckResult
  (if (= args.len 3)
    (let
      [source : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get (& args) 0 0))]
      [start : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get (& args) 1 0))]
      [len : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get (& args) 2 0))]
      ;; Evaluate the source first.  A direct place receives the same normal
      ;; shared/mutable borrow fact as an explicit `&`/`&mut`; nested view
      ;; calls and explicit borrow rvalues have no direct path, so their
      ;; recursive facts are intentionally retained unchanged.
      (match (tc-borrow-check-expr ctx expr-bases env locals borrowed source)
        [(TcBorrowCheckResult.Ok borrowed1)
          (match (tc-borrow-check-add-place-with-mutability
            expr-bases
            locals
            borrowed1
            (= kind TcSliceViewCallKind.Mutable)
            source
            call-expr)
            [(TcBorrowCheckResult.Ok borrowed2)
              (match (tc-borrow-check-expr
                ctx
                expr-bases
                env
                locals
                borrowed2
                start)
                [(TcBorrowCheckResult.Ok borrowed3)
                  (tc-borrow-check-expr ctx expr-bases env locals borrowed3 len)]
                [(TcBorrowCheckResult.Err message)
                  (TcBorrowCheckResult.Err message)])]
            [(TcBorrowCheckResult.Err message)
              (TcBorrowCheckResult.Err message)])]
        [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))
    (TcBorrowCheckResult.Err
      (tc-locate-error-at-expr
        call-expr
        "typecheck: slice-view expects exactly three arguments"))))

(define (tc-borrow-check-add-slice-split-provenance
  [borrowed : TcMovedSet]
  [base : TcMovePath]
  [mutable : bool]
  [split-id : i64]
  [origin : ast.AstExpr]) : TcMovedSet
  (tc-borrow-check-add-borrow-path
    (tc-borrow-check-add-borrow-path
      borrowed
      (tc-move-slice-split-half-path base split-id 0)
      mutable
      origin)
    (tc-move-slice-split-half-path base split-id 1)
    mutable
    origin))

(define (tc-borrow-check-slice-split-call
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : ast.AstExpr]
  [kind : TcSliceViewCallKind]
  [args : ast.AstExprList]) : TcBorrowCheckResult
  (if (= args.len 2)
    (let
      [source : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get (& args) 0 0))]
      [mid : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get (& args) 1 0))]
      [mutable : bool (tc-slice-call-mutable? kind)]
      (match (tc-borrow-check-expr ctx expr-bases env locals borrowed source)
        [(TcBorrowCheckResult.Ok borrowed1)
          (match (tc-borrow-check-add-place-with-mutability
            expr-bases
            locals
            borrowed1
            mutable
            source
            call-expr)
            [(TcBorrowCheckResult.Ok borrowed2)
              (let
                [with-provenance : TcMovedSet
                  (if mutable
                    (match (tc-borrow-check-split-provenance
                      expr-bases
                      borrowed1
                      source)
                      [(TcMaybeMovePath.Some base)
                        (tc-borrow-check-add-slice-split-provenance
                          borrowed2
                          base
                          mutable
                          (ast.ast-node-push call-expr)
                          call-expr)]
                      [(TcMaybeMovePath.No) borrowed2])
                    borrowed2)]
                (tc-borrow-check-expr
                  ctx
                  expr-bases
                  env
                  locals
                  with-provenance
                  mid))]
            [(TcBorrowCheckResult.Err message)
              (TcBorrowCheckResult.Err message)])]
        [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))
    (TcBorrowCheckResult.Err
      (tc-locate-error-at-expr
        call-expr
        "typecheck: slice-split-at expects exactly two arguments"))))

(define (tc-borrow-check-expr
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : ast.AstExpr]) : TcBorrowCheckResult
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (tc-borrow-check-expr-id ctx expr-bases env locals borrowed inner-box)]
    [(ast.AstExpr.MacroExpansion inner-box _ _)
      (tc-borrow-check-expr-id ctx expr-bases env locals borrowed inner-box)]
    [(ast.AstExpr.ForOwnedState payload)
      (let
        [source-name-id : i64 (ast.ast-for-owned-state-source-name (& payload))]
        [index-name-id : i64 (ast.ast-for-owned-state-index-name (& payload))]
        [source-id : i64 (ast.ast-for-owned-state-source (& payload))]
        [body-id : i64 (ast.ast-for-owned-state-body (& payload))]
        [source-name : i64 (tc-for-owned-name-id expr-bases source-name-id)]
        [index-name : i64 (tc-for-owned-name-id expr-bases index-name-id)]
        (if (or (< source-name 0) (< index-name 0))
          (TcBorrowCheckResult.Err
            "typecheck: invalid internal scalar for owned-array state")
          (match (tc-borrow-check-expr-id
            ctx
            expr-bases
            env
            locals
            borrowed
            source-id)
            [(TcBorrowCheckResult.Ok borrowed1)
              (match (tc-body-type-fact-expr-id
                "borrow.for_owned_source"
                ctx
                env
                source-id)
                [(ResultTcType.Ok source-ty)
                  (match (tc-borrow-check-after-bind-known-type-id
                    ctx
                    expr-bases
                    env
                    locals
                    borrowed1
                    source-name
                    source-id
                    source-ty)
                    [(TcBorrowCheckResult.Ok borrowed2)
                      (match (tc-borrow-check-expr-with-protected-id
                        ctx
                        expr-bases
                        (tc-bind-id
                          (tc-bind-id env source-name source-ty)
                          index-name
                          (ast.AstType.I64))
                        (tc-moved-add
                          (tc-moved-add locals source-name)
                          index-name)
                        (tc-borrow-check-remove-root-state
                          (tc-borrow-check-remove-root-state
                            borrowed2
                            source-name)
                          index-name)
                        borrowed
                        body-id)
                        [(TcBorrowCheckResult.Ok borrowed3)
                          (TcBorrowCheckResult.Ok
                            (tc-borrow-check-remove-root-state
                              (tc-borrow-check-remove-root-state
                                borrowed3
                                source-name)
                              index-name))]
                        [(TcBorrowCheckResult.Err message)
                          (TcBorrowCheckResult.Err message)])]
                    [(TcBorrowCheckResult.Err message)
                      (TcBorrowCheckResult.Err message)])]
                [(ResultTcType.Err message) (TcBorrowCheckResult.Err message)])]
            [(TcBorrowCheckResult.Err message)
              (TcBorrowCheckResult.Err message)])))]
    [(ast.AstExpr.ForOwnedStep payload)
      (let
        [source-id : i64 (ast.ast-for-owned-step-source-name (& payload))]
        [index-id : i64 (ast.ast-for-owned-step-index-name (& payload))]
        [binding-id : i64 (ast.ast-for-owned-step-binding-name (& payload))]
        [done-id : i64 (ast.ast-for-owned-step-done-name (& payload))]
        [body-id : i64 (ast.ast-for-owned-step-body (& payload))]
        [binding-name : i64 (tc-for-owned-name-id expr-bases binding-id)]
        (if (< binding-name 0)
          (TcBorrowCheckResult.Err
            "typecheck: invalid internal scalar for item binding")
          (match (tc-borrow-check-expr-id
            ctx
            expr-bases
            env
            locals
            borrowed
            source-id)
            [(TcBorrowCheckResult.Ok borrowed1)
              (match (tc-borrow-check-expr-id
                ctx
                expr-bases
                env
                locals
                borrowed1
                index-id)
                [(TcBorrowCheckResult.Ok borrowed2)
                  (match (tc-borrow-check-expr-id
                    ctx
                    expr-bases
                    env
                    locals
                    borrowed2
                    done-id)
                    [(TcBorrowCheckResult.Ok borrowed3)
                      (match (tc-body-type-fact-expr-id
                        "borrow.for_owned_step_source"
                        ctx
                        env
                        source-id)
                        [(ResultTcType.Ok source-ty)
                          (match (tc-type-strip-region
                            (tc-resolve-type ctx source-ty))
                            [(ast.AstType.Array elem-id _)
                              (match (tc-borrow-check-expr-with-protected-id
                                ctx
                                expr-bases
                                (tc-bind-id
                                  env
                                  binding-name
                                  (tc-context-type-get ctx elem-id))
                                (tc-moved-add locals binding-name)
                                (tc-borrow-check-remove-root-state
                                  borrowed3
                                  binding-name)
                                borrowed
                                body-id)
                                [(TcBorrowCheckResult.Ok borrowed4)
                                  (TcBorrowCheckResult.Ok
                                    (tc-borrow-check-remove-root-state
                                      borrowed4
                                      binding-name))]
                                [(TcBorrowCheckResult.Err message)
                                  (TcBorrowCheckResult.Err message)])]
                            [_
                              (TcBorrowCheckResult.Err
