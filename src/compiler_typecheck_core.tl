(define (tc-expr-diag [expr : AstExpr] [message : String]) : CompilerDiagnostic
  (if (tc-rich-error? message)
    (tc-rich-error-diag message)
    (if (tc-located-error? message)
      (tc-located-error-diag message)
      (match (tc-expr-maybe-span expr)
        [(TcMaybeAstSourceSpan.Some span)
          (tc-canonical-diagnostic
            (compiler-diagnostic-from-ast-span "" span message))]
        [(TcMaybeAstSourceSpan.No) (tc-diag-at-start message)]))))

;; Locate an error at the nearest available declaration body span. A top-level
;; `define` body is wrapped in `AstExpr.Spanned`, so its span points the
;; diagnostic at the offending declaration's expression; otherwise fall back 1:1.
(define (tc-generated-decl-diag
  [meta : AstGeneratedDeclMeta]
  [diag : CompilerDiagnostic]) : CompilerDiagnostic
  (match meta
    [(AstGeneratedDeclMeta.Some generator item _ key)
      (let
        [with-context : CompilerDiagnostic
          (compiler-diagnostic-with-note
            diag
            (string.append
              "generated declaration: "
              (string.append item (string.append " from " generator))))]
        (if (> (string.string-length key) 0)
          (compiler-diagnostic-with-note
            with-context
            (string.append "generated identity: " key))
          with-context))]
    [(AstGeneratedDeclMeta.No) diag]))

(define (tc-decl-location-diag [decl : AstDecl] [message : String]) : CompilerDiagnostic
  (match decl
    [(AstDecl.Def decl-meta _ _ expr-box)
      (let
        [expr : AstExpr (ast-node-get expr-box)]
        (tc-expr-diag expr message))]
    [(AstDecl.DefFn decl-meta _ _ _ body-box _)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (tc-expr-diag body message))]
    [(AstDecl.DefMacro decl-meta _ _ _ body-box)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (tc-expr-diag body message))]
    [(AstDecl.Test _ _ span)
      (tc-canonical-diagnostic
        (compiler-diagnostic-from-ast-span "" span message))]
    [(AstDecl.Unsafe inner-box)
      (tc-decl-location-diag (box-get inner-box) message)]
    [_ (tc-diag-at-start message)]))

(define (tc-decl-diag [decl : AstDecl] [message : String]) : CompilerDiagnostic
  (if (tc-rich-error? message)
    (tc-rich-error-diag message)
    (if (tc-located-error? message)
      (tc-located-error-diag message)
      (tc-generated-decl-diag
        (ast-decl-generated-meta decl)
        (tc-decl-location-diag decl message)))))

(define (tc-decl-diag-with-maybe-origin
  [origin : CompilerParseMaybeDeclSpan]
  [decl : AstDecl]
  [message : String]) : CompilerDiagnostic
  (let
    [diag : CompilerDiagnostic (tc-decl-diag decl message)]
    (if (and
      (= (compiler-diagnostic-line diag) 1)
      (= (compiler-diagnostic-col diag) 1)
      (= (compiler-diagnostic-end-line diag) 1)
      (= (compiler-diagnostic-end-col diag) 1))
      (match origin
        [(CompilerParseMaybeDeclSpan.Some span)
          (compiler-diagnostic-with-primary-span
            diag
            (CompilerDiagnosticSpan
              ""
              (ast-source-span-start-line span)
              (ast-source-span-start-col span)
              (ast-source-span-end-line span)
              (ast-source-span-end-col span)))]
        [(CompilerParseMaybeDeclSpan.None) diag])
      diag)))

(define (tc-decl-diag-with-origin
  [decls : (& decls AstDeclList)]
  [decl : AstDecl]
  [message : String]) : CompilerDiagnostic
  (tc-decl-diag-with-maybe-origin
    (compiler-parse-decl-origin-span decls 0)
    decl
    message))

(define (tc-locate-error-at-expr [expr : AstExpr] [message : String]) : String
  (if (or (tc-rich-error? message) (tc-located-error? message))
    message
    (match (tc-expr-maybe-span expr)
      [(TcMaybeAstSourceSpan.Some span)
        (if (tc-borrow-place-error-message? message)
          (tc-rich-borrow-place-error span message)
          (tc-located-error span message))]
      [(TcMaybeAstSourceSpan.No) message])))

(define (tc-expr-id-maybe-span [expr-id : i64]) : TcMaybeAstSourceSpan
  (tc-expr-maybe-span (ast-node-get expr-id)))

(define (tc-expr-maybe-span [expr : AstExpr]) : TcMaybeAstSourceSpan
  (match expr
    [(AstExpr.Spanned _ span) (TcMaybeAstSourceSpan.Some span)]
    [(AstExpr.Unary _ inner) (tc-expr-id-maybe-span inner)]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda _ _ body) (tc-expr-id-maybe-span body)])]
    [(AstExpr.TupleRef target _) (tc-expr-id-maybe-span target)]
    [(AstExpr.MakeArray _ size) (tc-expr-id-maybe-span size)]
    [(AstExpr.Set _ value) (tc-expr-id-maybe-span value)]
    [(AstExpr.Ann inner _) (tc-expr-id-maybe-span inner)]
    [(AstExpr.Cast inner _) (tc-expr-id-maybe-span inner)]
    [(AstExpr.Borrow _ _ inner) (tc-expr-id-maybe-span inner)]
    [(AstExpr.Box value) (tc-expr-id-maybe-span value)]
    [(AstExpr.BoxGet value) (tc-expr-id-maybe-span value)]
    [(AstExpr.BoxTake value) (tc-expr-id-maybe-span value)]
    [(AstExpr.Comptime inner) (tc-expr-id-maybe-span inner)]
    [(AstExpr.Quote inner) (tc-expr-id-maybe-span inner)]
    [(AstExpr.Quasiquote inner) (tc-expr-id-maybe-span inner)]
    [(AstExpr.Unquote inner) (tc-expr-id-maybe-span inner)]
    [(AstExpr.UnquoteSplicing inner) (tc-expr-id-maybe-span inner)]
    [(AstExpr.Try inner) (tc-expr-id-maybe-span inner)]
    [(AstExpr.Return inner) (tc-expr-id-maybe-span inner)]
    [(AstExpr.PtrNullCheck inner) (tc-expr-id-maybe-span inner)]
    [(AstExpr.PtrAddrOf inner) (tc-expr-id-maybe-span inner)]
    [(AstExpr.PtrRead inner) (tc-expr-id-maybe-span inner)]
    [(AstExpr.PtrCast inner _) (tc-expr-id-maybe-span inner)]
    [(AstExpr.PtrToInt inner) (tc-expr-id-maybe-span inner)]
    [(AstExpr.IntToPtr inner _) (tc-expr-id-maybe-span inner)]
    [(AstExpr.StringData inner) (tc-expr-id-maybe-span inner)]
    [(AstExpr.ArrayData inner) (tc-expr-id-maybe-span inner)]
    [(AstExpr.Xgetbv inner) (tc-expr-id-maybe-span inner)]
    [_ (TcMaybeAstSourceSpan.No)]))

(define (tc-expr-list-last-maybe-span [exprs : AstExprList]) : TcMaybeAstSourceSpan
  (if (ast-expr-list-empty? (& exprs))
    (TcMaybeAstSourceSpan.No)
    (tc-expr-maybe-span
      (ast-node-get
        (ast-expr-list-get (& exprs) (- (struct-get (& exprs) len) 1) 0)))))

(define (tc-reference-escape-help) : String
  "return an owned clone, keep the reference inside its scope, or tie the returned reference lifetime to a parameter")

(define (tc-borrow-place-error-message) : String
  "typecheck: borrow requires a local, parameter, or aggregate place")

(define (tc-borrow-place-error-message? [message : String]) : bool
  (string.eq message (tc-borrow-place-error-message)))

(define (tc-borrow-place-help) : String
  "bind the value to a local before borrowing it, or borrow a field or array element from a local aggregate")

(define (tc-rich-borrow-place-error [span : AstSourceSpan] [message : String]) : String
  (tc-rich-error-one-secondary
    span
    message
    (tc-borrow-place-help)
    span
    "this expression produces a temporary value, not a borrowable place"))

(define (tc-assignment-escape-help [target : String]) : String
  (str_cat.str-cat
    "store an owned value instead, or keep `"
    target
    "` inside the borrowed value's lifetime"))

(define (tc-arena-escape-help [region : String]) : String
  (str_cat.str-cat
    "use with-escape to clone one supported result out of `"
    region
    "`, or keep the value inside the with-arena scope"))

(define (tc-closure-escape-help) : String
  "move owned data into the closure or keep the closure inside the borrowed/arena scope")

(define (tc-region-call-escape-help) : String
  "pass an owned clone, keep the call inside the value's arena/scope, or use with-escape to clone out a supported arena result before passing it")

(define (tc-reference-escape-message? [message : String]) : bool
  (or
    (string.eq message "typecheck: reference value would escape lexical scope")
    (tc-diag-string-prefix?
      message
      "typecheck: cannot store reference into longer-lived")
    (tc-diag-string-prefix?
      message
      "typecheck: cannot store reference into non-place")
    (string.eq
      message
      "typecheck: lambda cannot capture mutable reference; reference value would escape lexical scope")
    (string.eq
      message
      "typecheck: lambda cannot capture immutable reference; reference value would escape lexical scope")
    (string.eq
      message
      "typecheck: reference-capturing closure value would escape lexical scope")))

(define (tc-region-escape-message? [message : String]) : bool
  (or
    (tc-diag-string-prefix?
      message
      "typecheck: region-tagged value cannot escape with-arena '")
    (tc-diag-string-prefix?
      message
      "typecheck: cannot store region-tagged value into ")
    (string.eq
      message
      "typecheck: lambda cannot capture region-tagged value; region value would escape")
    (string.eq
      message
      "typecheck: lambda return value has region-tagged type; region value would escape")
    (string.eq
      message
      "typecheck: cannot pass region-tagged value to function parameter; region value would escape")))

(define (tc-cleanup-escape-message? [message : String]) : bool
  (or
    (string.eq
      message
      "typecheck: cleanup-required resource would escape with scope")
    (string.eq
      message
      "typecheck: lambda cannot capture cleanup-required resource; resource value would escape")
    (string.eq
      message
      "typecheck: cannot store cleanup-required resource in longer-lived binding")))

(define (tc-escape-message? [message : String]) : bool
  (or
    (tc-reference-escape-message? message)
    (tc-region-escape-message? message)
    (tc-cleanup-escape-message? message)))

(define (tc-escape-help [message : String]) : String
  (if (tc-region-escape-message? message)
    "return an owned clone, keep the value inside the arena/scope, or use with-escape for supported clone-out"
    (if (tc-cleanup-escape-message? message)
      "keep the cleanup-required value inside its resource scope or return a non-resource result"
      (tc-reference-escape-help))))

(define (tc-rich-error-with-maybe-secondary
  [primary : AstSourceSpan]
  [message : String]
  [help : String]
  [maybe-secondary : TcMaybeAstSourceSpan]
  [secondary-label : String]) : String
  (match maybe-secondary
    [(TcMaybeAstSourceSpan.Some secondary)
      (tc-rich-error-one-secondary
        primary
        message
        help
        secondary
        secondary-label)]
    [(TcMaybeAstSourceSpan.No)
      (tc-rich-error-one-secondary primary message help primary secondary-label)]))

(define (tc-rich-escape-at-expr
  [expr : AstExpr]
  [message : String]
  [secondary-label : String]) : String
  (match (tc-expr-maybe-span expr)
    [(TcMaybeAstSourceSpan.Some span)
      (tc-rich-error-one-secondary
        span
        message
        (tc-escape-help message)
        span
        secondary-label)]
    [(TcMaybeAstSourceSpan.No) message]))

;; Macros that read a vector element directly often expand to
;; `(array-ref (struct-get vec slots) index)`.  The outer generated nodes do
;; not carry a source span, but the unquoted vector expression does.  Use that
;; span so this diagnostic points to the user's borrowed-vector argument, not
;; only the macro's quasiquote body.
(define (tc-vector-ref-rvalue-source-span [arg : AstExpr]) : TcMaybeAstSourceSpan
  (match (ast-expr-unspan arg)
    [(AstExpr.ArrayRef array-box _)
      (match (ast-expr-unspan (ast-node-get array-box))
        [(AstExpr.StructGet receiver-box field)
          (if (= field cbi.compiler-builtin-id-fix-slots)
            (tc-expr-maybe-span (ast-node-get receiver-box))
            (TcMaybeAstSourceSpan.No))]
        [_ (TcMaybeAstSourceSpan.No)])]
    [_ (TcMaybeAstSourceSpan.No)]))

;; A direct array read through a reference rvalue can produce a region-tagged
;; move-only aggregate. Keep the sound confinement rejection, but make this
;; frequent vector-iteration shape actionable without changing diagnostics for
;; unrelated region values crossing a call boundary.
(define (tc-region-call-arg-error [arg : AstExpr]) : String
  (let
    [message : String
      "typecheck: cannot pass region-tagged value to function parameter; region value would escape"]
    (match (tc-vector-ref-rvalue-source-span arg)
      [(TcMaybeAstSourceSpan.Some span)
        (tc-rich-error-one-secondary
          span
          (string.append
            message
            "; direct aggregate reads through a shared vector borrow are not owned values; borrow slots from a vector place or use the generated vector get helper")
          "a direct aggregate read through this shared vector reference is not an owned value; borrow slots from a vector place or use the generated vector get helper"
          span
          "this by-value argument reads an aggregate through a shared reference")]
      [(TcMaybeAstSourceSpan.No)
        (match (tc-expr-maybe-span arg)
          [(TcMaybeAstSourceSpan.Some span)
            (tc-rich-error-one-secondary
              span
              message
              (tc-region-call-escape-help)
              span
              "this argument carries an arena region that the parameter does not accept")]
          [(TcMaybeAstSourceSpan.No) message])])))

(define (tc-spanned-escape-error
  [inner : AstExpr]
  [span : AstSourceSpan]
  [message : String]) : TcMaybeString
  (if (or (tc-rich-error? message) (tc-located-error? message))
    (TcMaybeString.No)
    (match inner
      [(AstExpr.WithRegion region body)
        (if (tc-diag-string-prefix?
          message
          "typecheck: region-tagged value cannot escape with-arena '")
          (match (tc-expr-list-last-maybe-span body)
            [(TcMaybeAstSourceSpan.Some value-span)
              (TcMaybeString.Some
                (tc-rich-error-one-secondary
                  value-span
                  message
                  (tc-arena-escape-help (intern-str region))
                  span
                  (str_cat.str-cat
                    "with-arena `"
                    (intern-str region)
                    "` scope resets before this value can escape")))]
            [(TcMaybeAstSourceSpan.No)
              (TcMaybeString.Some
                (tc-rich-error-one-secondary
                  span
                  message
                  (tc-arena-escape-help (intern-str region))
                  span
                  "with-arena scope boundary"))])
          (TcMaybeString.No))]
      [(AstExpr.Return value-box)
        (if (tc-escape-message? message)
          (let
            [value : AstExpr (ast-node-get value-box)]
            (TcMaybeString.Some
              (tc-rich-error-with-maybe-secondary
                span
                message
                (tc-escape-help message)
                (tc-expr-maybe-span value)
                "returned value carries a lifetime or arena that cannot cross this boundary")))
          (TcMaybeString.No))]
      [(AstExpr.Set name value-box)
        (if (tc-escape-message? message)
          (let
            [value : AstExpr (ast-node-get value-box)]
            [target : String (tc-env-key-name-text name)]
            (match (tc-expr-maybe-span value)
              [(TcMaybeAstSourceSpan.Some value-span)
                (TcMaybeString.Some
                  (tc-rich-error-two-secondaries
                    span
                    message
                    (tc-assignment-escape-help target)
                    value-span
                    "assigned value carries a shorter lifetime"
                    span
                    (str_cat.str-cat
                      "target binding `"
                      target
                      "` lives longer than the assigned value")))]
              [(TcMaybeAstSourceSpan.No)
                (TcMaybeString.Some
                  (tc-rich-error-one-secondary
                    span
                    message
                    (tc-assignment-escape-help target)
                    span
                    (str_cat.str-cat
                      "target binding `"
                      target
                      "` lives longer than the assigned value")))]))
          (TcMaybeString.No))]
      [(AstExpr.Let let-box)
        (match (box-get let-box)
          [(AstLet.Let _ body-box)
            (if (tc-escape-message? message)
              (let
                [body : AstExpr (ast-node-get body-box)]
                (TcMaybeString.Some
                  (tc-rich-error-with-maybe-secondary
                    span
                    message
                    (tc-escape-help message)
                    (tc-expr-maybe-span body)
                    "let result carries a lifetime that cannot outlive this binding scope")))
              (TcMaybeString.No))])]
      [(AstExpr.Lambda lambda-box)
        (match (box-get lambda-box)
          [(AstLambda.Lambda _ _ body-box)
            (if (tc-escape-message? message)
              (let
                [body : AstExpr (ast-node-get body-box)]
                (TcMaybeString.Some
                  (tc-rich-error-with-maybe-secondary
                    span
                    message
                    (tc-closure-escape-help)
                    (tc-expr-maybe-span body)
                    "closure body captures a value whose lifetime cannot escape")))
              (TcMaybeString.No))])]
      [_ (TcMaybeString.No)])))

(define (tc-expect-at-expr
  [expr : AstExpr]
  [actual : AstType]
  [expected : AstType]
  [message : String]) : ResultTcUnit
  (if (tc-type-compatible? expected actual)
    ResultTcUnit.Ok
    (ResultTcUnit.Err
      (tc-locate-error-at-expr
        expr
        (tc-type-mismatch-message actual expected message)))))

(define (tc-empty-env) : TcTypeEnv
  TcTypeEnv.Nil)

(define (tc-type-env-spine-step [env : TcTypeEnv]) : TcTypeEnvSpineStep
  (match env
    [(TcTypeEnv.Nil) (TcTypeEnvSpineStep.Done)]
    [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
      (TcTypeEnvSpineStep.Cache (box-get rest))]
    [(TcTypeEnv.Bind key ty rest)
      (TcTypeEnvSpineStep.Bind key ty (box-get rest))]))

(define (tc-type-env-marker-start [env : TcTypeEnv]) : TcTypeEnv
  (match env
    [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _) (box-get rest)]
    [_ env]))

(define (tc-type-env-marker-step [env : TcTypeEnv]) : TcTypeEnvMarkerStep
  (match env
    [(TcTypeEnv.Nil) (TcTypeEnvMarkerStep.Done)]
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (TcTypeEnvMarkerStep.Cache (box-get rest))
        (TcTypeEnvMarkerStep.Done))]
    [(TcTypeEnv.Bind key ty rest)
      (TcTypeEnvMarkerStep.Bind key ty (box-get rest))]))

(define (tc-type-env-lookup-step [env : TcTypeEnv] [name-id : i64]) : TcTypeEnvLookupStep
  (match env
    [(TcTypeEnv.Nil) (TcTypeEnvLookupStep.Missing)]
    [(TcTypeEnv.Cache ids values _ _ _ _ partial _ below)
      (match (tc_i64_i64_map.get (& ids) name-id)
        [(tc_i64_i64_map.LookupFound index)
          ;; AstType reads must stay `array-ref` because inline-by-value
          ;; AstType values are multi-word.
          (TcTypeEnvLookupStep.Found (array-ref values index))]
        [(tc_i64_i64_map.LookupMissing)
          (if partial
            (TcTypeEnvLookupStep.Miss (box-get below))
            (TcTypeEnvLookupStep.Missing))])]
    [(TcTypeEnv.Bind key ty rest)
      (if (= key name-id)
        (TcTypeEnvLookupStep.Found ty)
        (TcTypeEnvLookupStep.Miss (box-get rest)))]))

(define (tc-type-env-unsafe-lookup-step [env : TcTypeEnv] [name-id : i64]) : TcTypeEnvUnsafeLookupStep
  (match env
    [(TcTypeEnv.Nil) (TcTypeEnvUnsafeLookupStep.Missing)]
    [(TcTypeEnv.Cache ids values unsafe-flags _ _ _ partial _ below)
      (match (tc_i64_i64_map.get (& ids) name-id)
        [(tc_i64_i64_map.LookupFound index)
          ;; AstType read must stay `array-ref`; the unsafe flag is a
          ;; scalar i64 and keeps the previous raw read path.
          (TcTypeEnvUnsafeLookupStep.Found
            (array-ref values index)
            (=
              (unsafe
                (ptr-read
                  (ptr-offset
                    (ptr-cast (array-data unsafe-flags) : (Ptr i64))
                    index)))
              1))]
        [(tc_i64_i64_map.LookupMissing)
          (if partial
            (TcTypeEnvUnsafeLookupStep.Miss (box-get below))
            (TcTypeEnvUnsafeLookupStep.Missing))])]
    [(TcTypeEnv.Bind key ty rest)
      (if (= key name-id)
        (TcTypeEnvUnsafeLookupStep.Found
          ty
          (tc-binding-unsafe-marker-head-id? (box-get rest) name-id))
        (TcTypeEnvUnsafeLookupStep.Miss (box-get rest)))]))

(define (tc-local-cache-threshold) : i64
  32)

(define (tc-local-cache-partial-layer-cap) : i64
  8)

(define (tc-builtin-symbol-name-id [raw-name-id : i64] [hygiene-global : bool]) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    (if hygiene-global
      (macro-hygiene-global-source-name-id-or raw-name-id -1)
      raw-name-id)))

(define (tc-builtin-call-name-id [raw-name-id : i64] [hygiene-global : bool]) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    (if hygiene-global
      (let
        [source-id : i64
          (macro-hygiene-global-source-name-id-or raw-name-id -1)]
        source-id)
      raw-name-id)))

;; --- top-env build membership side table ------------------------------------
;; The whole-program top-level env is an UNCACHED spine of ~46K binds. The
;; threshold-compaction machinery (tc-env-compact-local-if-threshold) is for
;; single-bind function scopes and does not fire here: unsafe/c-abi decls
;; prepend two binds at once, breaking the exact-"32 binds above a cache"
;; alignment it needs, so the top env stays a plain list. The enum-variant
;; binder uses `tc-bind-alias-id-if-free`, whose guard `tc-name-bound-id?`
;; rescans that whole spine per variant -> O(decls^2) (measured: 46.4M node
;; visits, ~120ms of the top-env build of a self-compile, with the guard never
;; once finding a name already bound).
;;
;; This is a membership bloom keyed by name-id: every name bound during the
;; build (plus the seeded base env) is stamped with the current generation. An
;; UNMARKED id is provably absent from the env, so the guard binds directly
;; with no scan. A MARKED id (a real prior binding, or a transient local bind
;; from an un-annotated top-level `define` initializer) falls back to the exact
;; spine scan -- the bloom only ever SKIPS the scan when the name is definitely
;; unbound, so the bound env, lookups, and diagnostics are identical to the
;; unconditional scan. Generation stamps avoid clearing the array between
;; builds; the array never grows, so out-of-range ids (>= capacity)
;; conservatively report "maybe" and take the exact scan.
;;
;; The bound-slots twin is the EXACT complement for the guard's other verdict:
;; it is stamped only by binds that provably join the accumulated top-env spine
;; (the seeded base env, tc-bind-alias-id-if-free's own binds, and top-env alias
;; fanout binds -- never the transient inference binds that make the bloom
;; conservative). A stamped id is therefore definitely bound, so the guard can
;; skip without the O(spine) scan.
;; Self-compiles repeat enum-variant names (Ok/Err/None/Nil/...) across
;; hundreds of enums; every repeat after the first used to rescan the whole
;; spine from the head down to the first binding. Ids that are bloom-marked but
;; not bound-stamped (e.g. spine binds made outside the alias binder) still
;; take the exact scan, so results are identical either way.
(define tc-topenv-membership-slots : (Array i64)
  (array.make-array i64 (intern-capacity)))
(define tc-topenv-membership-bound-slots : (Array i64)
  (array.make-array i64 (intern-capacity)))

;; Qualified and generated structural ids live above the direct-slot range.
;; Keep their maybe/bound bits in one bounded open-addressed table (bit 0 =
;; maybe, bit 1 = definitely bound) so the reinterning migration does not send
;; them back to an O(top-env) compatibility scan. This hot side table avoids
;; the allocation and generic-map dispatch cost paid by every top-level bind.
(define tc-topenv-membership-overflow-capacity : i64
  65536)
(define tc-topenv-membership-overflow-keys : (Array i64)
  (array.make-array i64 65536))
(define tc-topenv-membership-overflow-flags : (Array i64)
  (array.make-array i64 65536))
(define tc-topenv-membership-overflow-complete : bool
  true)
(define tc-topenv-membership-gen : i64
  0)
(define tc-topenv-membership-active : bool
  false)
(define tc-topenv-alias-fanout-active : bool
  false)
(define tc-topenv-explicit-build-active : bool
  false)

(define (tc-topenv-membership-overflow-probe
  [name-id : i64]
  [slot : i64]
  [probes : i64]) : i64
  (if (>= probes tc-topenv-membership-overflow-capacity)
    -1
    (let
      [flags : i64 (array-ref tc-topenv-membership-overflow-flags slot)]
      (if (or
        (= flags 0)
        (= (array-ref tc-topenv-membership-overflow-keys slot) name-id))
        slot
        (tc-topenv-membership-overflow-probe
          name-id
          (bit-and (+ slot 1) (- tc-topenv-membership-overflow-capacity 1))
          (+ probes 1))))))

(define (tc-topenv-membership-overflow-slot [name-id : i64]) : i64
  (tc-topenv-membership-overflow-probe
    name-id
    (bit-and
      (* name-id 2654435761)
      (- tc-topenv-membership-overflow-capacity 1))
    0))

(define (tc-topenv-membership-overflow-flags-for [name-id : i64]) : i64
  (let
    [slot : i64 (tc-topenv-membership-overflow-slot name-id)]
    (if (< slot 0)
      0
      (let
        [flags : i64 (array-ref tc-topenv-membership-overflow-flags slot)]
        (if (and
          (not (= flags 0))
          (= (array-ref tc-topenv-membership-overflow-keys slot) name-id))
          flags
          0)))))

(define (tc-topenv-membership-overflow-mark! [name-id : i64] [bits : i64]) : unit
  (let
    [slot : i64 (tc-topenv-membership-overflow-slot name-id)]
    (if (< slot 0)
      (set! tc-topenv-membership-overflow-complete false)
      (begin
        (array-set! tc-topenv-membership-overflow-keys slot name-id)
        (array-set!
          tc-topenv-membership-overflow-flags
          slot
          (bit-or (array-ref tc-topenv-membership-overflow-flags slot) bits))))))

(define (tc-topenv-membership-overflow-reset!) : unit
  (let
    [slot : i64 0]
    (begin
      (while (< slot tc-topenv-membership-overflow-capacity)
        (begin
          (array-set! tc-topenv-membership-overflow-flags slot 0)
          (set! slot (+ slot 1))))
      (set! tc-topenv-membership-overflow-complete true))))

(define (tc-topenv-membership-mark! [name-id : i64]) : unit
  (if (and (>= name-id 0) (< name-id (intern-capacity)))
    (array-set! tc-topenv-membership-slots name-id tc-topenv-membership-gen)
    (tc-topenv-membership-overflow-mark! name-id 1)))

(define (tc-topenv-membership-mark-bound! [name-id : i64]) : unit
  (if (and
    tc-topenv-membership-active
    (>= name-id 0)
    (< name-id (intern-capacity)))
    (array-set!
      tc-topenv-membership-bound-slots
      name-id
      tc-topenv-membership-gen)
    (if tc-topenv-membership-active
      (tc-topenv-membership-overflow-mark! name-id 3)
      unit)))

;; True when the id is PROVABLY bound in the accumulated top-env spine (stamped
;; by a spine-joining bind this generation); false means "unknown", not
;; "unbound".
(define (tc-topenv-membership-bound? [name-id : i64]) : bool
  (if (and (>= name-id 0) (< name-id (intern-capacity)))
    (=
      (array-ref tc-topenv-membership-bound-slots name-id)
      tc-topenv-membership-gen)
    (not (= (bit-and (tc-topenv-membership-overflow-flags-for name-id) 2) 0))))

;; True when the id MIGHT be in the env (marked this generation, or out of
;; range); false only when it is provably absent.
(define (tc-topenv-membership-maybe? [name-id : i64]) : bool
  (if (and (>= name-id 0) (< name-id (intern-capacity)))
    (= (array-ref tc-topenv-membership-slots name-id) tc-topenv-membership-gen)
    (let
      [flags : i64 (tc-topenv-membership-overflow-flags-for name-id)]
      (if (= flags 0)
        (not tc-topenv-membership-overflow-complete)
        (not (= (bit-and flags 1) 0))))))

(define (tc-topenv-membership-seed! [env : TcTypeEnv]) : unit
  (match (tc-type-env-spine-step env)
    [(TcTypeEnvSpineStep.Done) unit]
    [(TcTypeEnvSpineStep.Cache rest-env) (tc-topenv-membership-seed! rest-env)]
    [(TcTypeEnvSpineStep.Bind key _ rest-env)
      (begin
        (tc-topenv-membership-mark! key)
        (tc-topenv-membership-mark-bound! key)
        (tc-topenv-membership-seed! rest-env))]))

(define (tc-topenv-membership-begin! [env : TcTypeEnv]) : unit
  (begin
    (set! tc-topenv-membership-gen (+ tc-topenv-membership-gen 1))
    (tc-topenv-membership-overflow-reset!)
    (set! tc-topenv-membership-active true)
    (tc-topenv-membership-seed! env)))

(define (tc-topenv-membership-end!) : unit
  (set! tc-topenv-membership-active false))

(define (tc-bind-raw-id [env : TcTypeEnv] [name-id : i64] [ty : AstType]) : TcTypeEnv
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-bind))
    (if tc-topenv-membership-active
      (tc-topenv-membership-mark! name-id)
      unit)
    (if tc-topenv-alias-fanout-active
      (tc-topenv-membership-mark-bound! name-id)
      unit)
    (let
      [next-env : TcTypeEnv (TcTypeEnv.Bind name-id ty (box env))]
      (begin
        (if tc-type-env-scoped-runtime-active
          (tc-type-env-scoped-runtime-note-bind-id! next-env name-id ty env)
          unit)
        next-env))))

(define (tc-env-uncached-prefix-reaches-cache?
  [env : TcTypeEnv]
  [remaining : i64]) : bool
  (if (<= remaining 0)
    (match env
      [(TcTypeEnv.Cache _ _ _ _ _ _ _ _ _) true]
      [_ false])
    (match env
      [(TcTypeEnv.Bind _ _ rest)
        (tc-env-uncached-prefix-reaches-cache? (box-get rest) (- remaining 1))]
      [_ false])))

(define (tc-env-after-prefix [env : TcTypeEnv] [remaining : i64]) : TcTypeEnv
  (if (<= remaining 0)
    env
    (match env
      [(TcTypeEnv.Bind _ _ rest)
        (tc-env-after-prefix (box-get rest) (- remaining 1))]
      [_ env])))

(define (tc-env-partial-layer-depth [env : TcTypeEnv]) : i64
  (match env
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through partial _ below)
      (if (and scan-through partial)
        (+ 1 (tc-env-partial-layer-depth (box-get below)))
        0)]
    [_ 0]))

;; Local partial caches allocate their value arrays at exactly twice the number
;; of covered spine binds (the local threshold is well above the tiny-cache
;; minimum). This lets a collapsed layer retain its exact coverage without
;; widening TcTypeEnv: later collapses can sum old layers and stop at the
;; immutable explicit top-env boundary.
(define (tc-env-partial-local-covered-count [env : TcTypeEnv]) : i64
  (match env
    [(TcTypeEnv.Cache _ values _ _ _ scan-through partial _ below)
      (if (and scan-through partial)
        (+
          (/ (array.length values) 2)
          (tc-env-partial-local-covered-count (box-get below)))
        0)]
    [_ 0]))

(define (tc-env-partial-local-base [env : TcTypeEnv]) : TcTypeEnv
  (match env
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through partial _ below)
      (if (and scan-through partial)
        (tc-env-partial-local-base (box-get below))
        env)]
    [_ env]))

(cfg
  test
  (define (tc-env-cache-explicit-head? [env : TcTypeEnv]) : bool
    (match env
      [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ _ _) (not scan-through)]
      [_ false])))

(define (tc-env-uncached-prefix-to-explicit-cache-count [env : TcTypeEnv]) : i64
  (let
    [cur : TcTypeEnv env]
    [count : i64 0]
    [found : bool false]
    [done : bool false]
    (begin
      (while (not done)
        (match cur
          [(TcTypeEnv.Bind _ _ rest)
            (begin
              (set! count (+ count 1))
              (set! cur (box-get rest)))]
          [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ _ _)
            (begin
              (if scan-through
                unit
                (set! found true))
              (set! done true))]
          [(TcTypeEnv.Nil) (set! done true)]))
      (if found
        count
        -1))))

(define (tc-env-compact-local-if-threshold [env : TcTypeEnv]) : TcTypeEnv
  (if (or tc-topenv-explicit-build-active tc-topenv-alias-fanout-active)
    env
    (if (tc-env-uncached-prefix-reaches-cache? env (tc-local-cache-threshold))
      (let
        [below : TcTypeEnv (tc-env-after-prefix env (tc-local-cache-threshold))]
        (if (>=
          (tc-env-partial-layer-depth below)
          (tc-local-cache-partial-layer-cap))
          (tc-env-with-collapsed-local-cache env)
          (tc-env-with-local-cache env)))
      env)))

(define (tc-bind-id [env : TcTypeEnv] [name-id : i64] [ty : AstType]) : TcTypeEnv
  (tc-env-compact-local-if-threshold (tc-bind-raw-id env name-id ty)))

(define (tc-unsafe-decl-marker-key-id? [key : i64] [name-id : i64]) : bool
  (= key (tc-unsafe-decl-marker-id name-id)))

;; Environment keys are either interner ids or packed nonnegative composite
;; ids. Negative odd/even ids form disjoint, allocation-free marker namespaces.
(define (tc-unsafe-decl-marker-id [name-id : i64]) : i64
  (- 0 (+ (* name-id 2) 1)))

(define (tc-bind-unsafe-id [env : TcTypeEnv] [name-id : i64] [ty : AstType]) : TcTypeEnv
  (let
    [next-env : TcTypeEnv
      (tc-env-compact-local-if-threshold
        (tc-bind-raw-id
          (tc-bind-raw-id env (tc-unsafe-decl-marker-id name-id) (AstType.Unit))
          name-id
          ty))]
    (begin
      (if tc-type-env-scoped-runtime-active
        (tc-type-env-scoped-runtime-mark-latest-flags-id!
          name-id
          tc-type-env-scoped-flag-unsafe)
        unit)
      next-env)))

(define (tc-c-abi-fnptr-marker-key-id? [key : i64] [name-id : i64]) : bool
  (= key (tc-c-abi-fnptr-marker-id name-id)))

(define (tc-c-abi-fnptr-marker-id [name-id : i64]) : i64
  (- 0 (+ (* name-id 2) 2)))

(define (tc-bind-c-abi-fnptr-id
  [env : TcTypeEnv]
  [name-id : i64]
  [ty : AstType]) : TcTypeEnv
  (let
    [next-env : TcTypeEnv
      (tc-env-compact-local-if-threshold
        (tc-bind-raw-id
          (tc-bind-raw-id env (tc-c-abi-fnptr-marker-id name-id) (AstType.Unit))
          name-id
          ty))]
    (begin
      (if tc-type-env-scoped-runtime-active
        (tc-type-env-scoped-runtime-mark-latest-flags-id!
          name-id
          tc-type-env-scoped-flag-c-abi-fnptr)
        unit)
      next-env)))

(define (tc-bind-unsafe-c-abi-fnptr-id
  [env : TcTypeEnv]
  [name-id : i64]
  [ty : AstType]) : TcTypeEnv
  (let
    [next-env : TcTypeEnv
      (tc-env-compact-local-if-threshold
        (tc-bind-raw-id
          (tc-bind-raw-id
            (tc-bind-raw-id
              env
              (tc-c-abi-fnptr-marker-id name-id)
              (AstType.Unit))
            (tc-unsafe-decl-marker-id name-id)
            (AstType.Unit))
          name-id
          ty))]
    (begin
      (if tc-type-env-scoped-runtime-active
        (tc-type-env-scoped-runtime-mark-latest-flags-id!
          name-id
          (bit-or
            tc-type-env-scoped-flag-unsafe
            tc-type-env-scoped-flag-c-abi-fnptr))
        unit)
      next-env)))

(define tc-type-env-scoped-flag-unsafe : i64
  1)
(define tc-type-env-scoped-flag-c-abi-fnptr : i64
  2)
(define tc-type-env-scoped-flag-marker : i64
  4)

(define (tc-type-env-scoped-capacity [capacity : i64]) : i64
  (if (< capacity 1)
    1
    capacity))

(define (tc-type-env-scoped-marker-kind-tag [kind : TcTypeEnvScopedMarkerKind]) : i64
  (match kind
    [(TcTypeEnvScopedMarkerKind.None) 0]
    [(TcTypeEnvScopedMarkerKind.UnsafeDecl) 1]
    [(TcTypeEnvScopedMarkerKind.CAbiFnptr) 2]
    [(TcTypeEnvScopedMarkerKind.DefaultBoundary) 3]
    [(TcTypeEnvScopedMarkerKind.Region) 4]
    [(TcTypeEnvScopedMarkerKind.UnsafeContext) 5]
    [(TcTypeEnvScopedMarkerKind.CleanupOwner) 6]
    [(TcTypeEnvScopedMarkerKind.OrdinaryArenaOwner) 7]
    [(TcTypeEnvScopedMarkerKind.AtomicArenaOwner) 8]
    [(TcTypeEnvScopedMarkerKind.Other) 9]))

(define (tc-type-env-scoped-marker-kind-from-tag [tag : i64]) : TcTypeEnvScopedMarkerKind
  (cond
    [(= tag 0) TcTypeEnvScopedMarkerKind.None]
    [(= tag 1) TcTypeEnvScopedMarkerKind.UnsafeDecl]
    [(= tag 2) TcTypeEnvScopedMarkerKind.CAbiFnptr]
    [(= tag 3) TcTypeEnvScopedMarkerKind.DefaultBoundary]
    [(= tag 4) TcTypeEnvScopedMarkerKind.Region]
    [(= tag 5) TcTypeEnvScopedMarkerKind.UnsafeContext]
    [(= tag 6) TcTypeEnvScopedMarkerKind.CleanupOwner]
    [(= tag 7) TcTypeEnvScopedMarkerKind.OrdinaryArenaOwner]
    [(= tag 8) TcTypeEnvScopedMarkerKind.AtomicArenaOwner]
    [else TcTypeEnvScopedMarkerKind.Other]))

(define (tc-type-env-scoped-marker-kind-same?
  [left : TcTypeEnvScopedMarkerKind]
  [right : TcTypeEnvScopedMarkerKind]) : bool
  (=
    (tc-type-env-scoped-marker-kind-tag left)
    (tc-type-env-scoped-marker-kind-tag right)))

(define (tc-type-env-scoped-flag? [flags : i64] [flag : i64]) : bool
  (not (= (bit-and flags flag) 0)))

(define (tc-type-env-scoped-slot-c-abi-fnptr? [slot : TcTypeEnvScopedSlot]) : bool
  (tc-type-env-scoped-flag?
    (struct-get slot flags)
    tc-type-env-scoped-flag-c-abi-fnptr))

;; One dense latest-slot table is shared by every scoped stack. Each stack has
;; a unique epoch, so nested carriers can overwrite entries safely; restoring
;; an older carrier lazily repairs only the names it queries.
(define tc-type-env-scoped-dense-lookup-capacity : i64
  262144)
(define tc-type-env-scoped-dense-lookup-indices : (Array i64)
  (array.make-array i64 tc-type-env-scoped-dense-lookup-capacity))
(define tc-type-env-scoped-dense-lookup-epochs : (Array i64)
  (array.make-array i64 tc-type-env-scoped-dense-lookup-capacity))
(define tc-type-env-scoped-next-lookup-epoch : i64
  1)

(define (tc-type-env-scoped-stack-with-capacity
  [slot-capacity : i64]
  [mark-capacity : i64]) : TcTypeEnvScopedStack
  (let
    [lookup-epoch : i64 tc-type-env-scoped-next-lookup-epoch]
    (begin
      (set!
        tc-type-env-scoped-next-lookup-epoch
        (+ tc-type-env-scoped-next-lookup-epoch 1))
      (TcTypeEnvScopedStack
        (array.make-array
          TcTypeEnvScopedSlot
          (tc-type-env-scoped-capacity slot-capacity))
        0
        (tc_i64_i64_map.with-capacity
          (tc-type-env-scoped-capacity slot-capacity))
        lookup-epoch
        (array.make-array
          TcTypeEnvScopedMark
          (tc-type-env-scoped-capacity mark-capacity))
        0
        0
        0))))

(define (tc-type-env-scoped-stack-new) : TcTypeEnvScopedStack
  (tc-type-env-scoped-stack-with-capacity 16 8))

(define (tc-type-env-scoped-stack-len [stack : TcTypeEnvScopedStack]) : i64
  (struct-get stack slot-count))

(define (tc-type-env-scoped-stack-mark-count [stack : TcTypeEnvScopedStack]) : i64
  (struct-get stack mark-count))

(define (tc-type-env-scoped-stack-scope-depth [stack : TcTypeEnvScopedStack]) : i64
  (struct-get stack scope-depth))

(define (tc-type-env-scoped-stack-cache-generation
  [stack : TcTypeEnvScopedStack]) : i64
  (struct-get stack cache-generation))

(define (tc-type-env-scoped-empty-slot) : TcTypeEnvScopedSlot
  (TcTypeEnvScopedSlot 0 (AstType.Unit) 0 0 0 0))

(define (tc-type-env-scoped-empty-mark) : TcTypeEnvScopedMark
  (TcTypeEnvScopedMark 0 0 0 0))

(define (tc-type-env-scoped-stack-reserve-slots!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [min-capacity : i64]) : unit
  (begin
    (while (< (array-length (struct-get stack slots)) min-capacity)
      (array-push! (struct-get stack slots) (tc-type-env-scoped-empty-slot)))
    unit))

(define (tc-type-env-scoped-stack-reserve-marks!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [min-capacity : i64]) : unit
  (begin
    (while (< (array-length (struct-get stack marks)) min-capacity)
      (array-push! (struct-get stack marks) (tc-type-env-scoped-empty-mark)))
    unit))

(define (tc-type-env-scoped-stack-push-slot!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [name-id : i64]
  [ty : AstType]
  [flags : i64]
  [marker-kind : TcTypeEnvScopedMarkerKind]) : unit
  (let
    [index : i64 (struct-get stack slot-count)]
    (begin
      (tc-type-env-scoped-stack-reserve-slots! stack (+ index 1))
      ;; A restored stack reuses array storage. Invalidate the overwritten
      ;; name's cached index so an in-range hit always names this slot.
      (let
        [old-name-id : i64
          (struct-get (array-ref (struct-get stack slots) index) name-id)]
        (if (and
          (>= old-name-id 0)
          (< old-name-id tc-type-env-scoped-dense-lookup-capacity))
          (if (and
            (=
              (array-ref tc-type-env-scoped-dense-lookup-epochs old-name-id)
              (struct-get stack lookup-epoch))
            (=
              (array-ref tc-type-env-scoped-dense-lookup-indices old-name-id)
              index))
            (array-set! tc-type-env-scoped-dense-lookup-epochs old-name-id 0)
            unit)
          (match (tc_i64_i64_map.get
            (& (struct-get stack lookup-cache))
            old-name-id)
            [(tc_i64_i64_map.LookupFound old-index)
              (if (= old-index index)
                (tc_i64_i64_map.insert-ref!
                  (&mut (struct-get stack lookup-cache))
                  old-name-id
                  -1)
                unit)]
            [(tc_i64_i64_map.LookupMissing) unit])))
      (array-set!
        (struct-get stack slots)
        index
        (TcTypeEnvScopedSlot
          name-id
          ty
          flags
          (tc-type-env-scoped-marker-kind-tag marker-kind)
          (struct-get stack scope-depth)
          (struct-get stack cache-generation)))
      (if (and
        (>= name-id 0)
        (< name-id tc-type-env-scoped-dense-lookup-capacity))
        (begin
          (array-set! tc-type-env-scoped-dense-lookup-indices name-id index)
          (array-set!
            tc-type-env-scoped-dense-lookup-epochs
            name-id
            (struct-get stack lookup-epoch)))
        (tc_i64_i64_map.insert-ref!
          (&mut (struct-get stack lookup-cache))
          name-id
          index))
      (cfg compile-profile (compiler-tc-env-profile-note-scoped-bind))
      (set! (struct-get stack slot-count) (+ index 1)))))

(define (tc-type-env-scoped-stack-bind-id!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [name-id : i64]
  [ty : AstType]) : unit
  (tc-type-env-scoped-stack-push-slot!
    stack
    name-id
    ty
    0
    TcTypeEnvScopedMarkerKind.None))

(define (tc-type-env-scoped-stack-bind-flags-id!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [name-id : i64]
  [ty : AstType]
  [flags : i64]) : unit
  (tc-type-env-scoped-stack-push-slot!
    stack
    name-id
    ty
    flags
    TcTypeEnvScopedMarkerKind.None))

(define (tc-type-env-scoped-stack-bind-marker-id!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [name-id : i64]
  [ty : AstType]
  [marker-kind : TcTypeEnvScopedMarkerKind]) : unit
  (tc-type-env-scoped-stack-push-slot!
    stack
    name-id
    ty
    tc-type-env-scoped-flag-marker
    marker-kind))

(define (tc-type-env-scoped-clamp-count [value : i64] [current : i64]) : i64
  (if (< value 0)
    0
    (if (> value current)
      current
      value)))

(define (tc-type-env-scoped-stack-save!
  [stack : (&mut stack TcTypeEnvScopedStack)]) : TcTypeEnvScopedMark
  (let
    [index : i64 (struct-get stack mark-count)]
    [mark : TcTypeEnvScopedMark
      (TcTypeEnvScopedMark
        (struct-get stack slot-count)
        index
        (struct-get stack scope-depth)
        (struct-get stack cache-generation))]
    (begin
      (tc-type-env-scoped-stack-reserve-marks! stack (+ index 1))
      (array-set! (struct-get stack marks) index mark)
      (set! (struct-get stack mark-count) (+ index 1))
      (set! (struct-get stack scope-depth) (+ (struct-get stack scope-depth) 1))
      mark)))

(define (tc-type-env-scoped-stack-restore!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [mark : TcTypeEnvScopedMark]) : unit
  (begin
    (set!
      (struct-get stack slot-count)
      (tc-type-env-scoped-clamp-count
        (struct-get mark slot-count)
        (struct-get stack slot-count)))
    (set!
      (struct-get stack mark-count)
      (tc-type-env-scoped-clamp-count
        (struct-get mark mark-count)
        (struct-get stack mark-count)))
    (set!
      (struct-get stack scope-depth)
      (tc-type-env-scoped-clamp-count
        (struct-get mark scope-depth)
        (struct-get stack scope-depth)))
    (set!
      (struct-get stack cache-generation)
      (+ (struct-get stack cache-generation) 1))))

(define (tc-type-env-scoped-stack-lookup-id-at
  [stack : TcTypeEnvScopedStack]
  [index : i64]) : TcTypeEnvScopedLookup
  (if (< index 0)
    TcTypeEnvScopedLookup.Missing
    (let
      [slot : TcTypeEnvScopedSlot (array-ref (struct-get stack slots) index)]
      (TcTypeEnvScopedLookup.Found
        (struct-get slot ty)
        (tc-type-env-scoped-flag?
          (struct-get slot flags)
          tc-type-env-scoped-flag-unsafe)
        (tc-type-env-scoped-flag?
          (struct-get slot flags)
          tc-type-env-scoped-flag-c-abi-fnptr)
        (tc-type-env-scoped-marker-kind-from-tag
          (struct-get slot marker-kind-tag))
        (struct-get slot scope-depth)
        (struct-get slot generation)))))

(define (tc-type-env-scoped-stack-dense-lookup-id-refresh
  [stack : (& stack TcTypeEnvScopedStack)]
  [name-id : i64]) : i64
  (let
    [index : i64
      (tc-type-env-scoped-stack-find-id-index-from
        stack
        name-id
        (- (struct-get stack slot-count) 1))]
    (begin
      (array-set! tc-type-env-scoped-dense-lookup-indices name-id index)
      (array-set!
        tc-type-env-scoped-dense-lookup-epochs
        name-id
        (struct-get stack lookup-epoch))
      (cfg compile-profile (compiler-tc-env-profile-note-scoped-cache-miss))
      index)))

(define (tc-type-env-scoped-stack-map-cached-index
  [lookup-cache : (& lookup-cache tc_i64_i64_map.Map)]
  [name-id : i64]) : i64
  (match (tc_i64_i64_map.get lookup-cache name-id)
    [(tc_i64_i64_map.LookupFound index) index]
    [(tc_i64_i64_map.LookupMissing) -2]))

(define (tc-type-env-scoped-stack-map-lookup-id
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [name-id : i64]) : i64
  (let
    [lookup-cache : tc_i64_i64_map.Map (struct-get stack lookup-cache)]
    [index : i64
      (tc-type-env-scoped-stack-map-cached-index (& lookup-cache) name-id)]
    (if (= index -2)
      (begin
        (cfg compile-profile (compiler-tc-env-profile-note-scoped-cache-miss))
        -1)
      (if (and
        (>= index 0)
        (< index (struct-get stack slot-count))
        (=
          (struct-get (array-ref (struct-get stack slots) index) name-id)
          name-id))
        (begin
          (cfg compile-profile (compiler-tc-env-profile-note-scoped-cache-hit))
          index)
        (begin
          (cfg compile-profile (compiler-tc-env-profile-note-scoped-cache-miss))
          (let
            [repaired-index : i64
              (tc-type-env-scoped-stack-find-id-index-from
                stack
                name-id
                (- (struct-get stack slot-count) 1))]
            (begin
              (tc_i64_i64_map.insert-ref!
                (&mut lookup-cache)
                name-id
                repaired-index)
              repaired-index)))))))

(define (tc-type-env-scoped-stack-lookup-index
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [name-id : i64]) : i64
  (if (and (>= name-id 0) (< name-id tc-type-env-scoped-dense-lookup-capacity))
    (if (=
      (array-ref tc-type-env-scoped-dense-lookup-epochs name-id)
      (struct-get stack lookup-epoch))
      (let
        [index : i64
          (array-ref tc-type-env-scoped-dense-lookup-indices name-id)]
        (if (< index 0)
          (begin
            (cfg
              compile-profile
              (compiler-tc-env-profile-note-scoped-cache-hit))
            -1)
          (if (< index (struct-get stack slot-count))
            (begin
              (cfg
                compile-profile
                (compiler-tc-env-profile-note-scoped-cache-hit))
              index)
            (tc-type-env-scoped-stack-dense-lookup-id-refresh stack name-id))))
      (tc-type-env-scoped-stack-dense-lookup-id-refresh stack name-id))
    (tc-type-env-scoped-stack-map-lookup-id stack name-id)))

(define (tc-type-env-scoped-stack-lookup-id
  [stack : TcTypeEnvScopedStack]
  [name-id : i64]) : TcTypeEnvScopedLookup
  (tc-type-env-scoped-stack-lookup-id-at
    stack
    (tc-type-env-scoped-stack-lookup-index (&mut stack) name-id)))

(define (tc-type-env-scoped-stack-marker-lookup-from
  [stack : TcTypeEnvScopedStack]
  [marker-kind : TcTypeEnvScopedMarkerKind]
  [index : i64]) : TcTypeEnvScopedMarkerLookup
  (if (< index 0)
    TcTypeEnvScopedMarkerLookup.Missing
    (let
      [slot : TcTypeEnvScopedSlot (array-ref (struct-get stack slots) index)]
      (if (and
        (tc-type-env-scoped-flag?
          (struct-get slot flags)
          tc-type-env-scoped-flag-marker)
        (=
          (struct-get slot marker-kind-tag)
          (tc-type-env-scoped-marker-kind-tag marker-kind)))
        (TcTypeEnvScopedMarkerLookup.Found
          (struct-get slot name-id)
          (struct-get slot ty)
          (struct-get slot scope-depth)
          (struct-get slot generation))
        (tc-type-env-scoped-stack-marker-lookup-from
          stack
          marker-kind
          (- index 1))))))

(define (tc-type-env-scoped-stack-marker-lookup
  [stack : TcTypeEnvScopedStack]
  [marker-kind : TcTypeEnvScopedMarkerKind]) : TcTypeEnvScopedMarkerLookup
  (tc-type-env-scoped-stack-marker-lookup-from
    stack
    marker-kind
    (- (struct-get stack slot-count) 1)))

(define (tc-type-env-scoped-stack-owner-marker-before?
  [stack : TcTypeEnvScopedStack]
  [index : i64]
  [name-id : i64]
  [marker-id : i64]) : bool
  (if (<= index 0)
    false
    (let
      [slot : TcTypeEnvScopedSlot
        (array-ref (struct-get stack slots) (- index 1))]
      (tc-arena-owner-marker-for?
        marker-id
        (struct-get slot name-id)
        (struct-get slot ty)
        name-id))))

(define (tc-type-env-scoped-stack-cleanup-owner-before?
  [stack : TcTypeEnvScopedStack]
  [index : i64]
  [name-id : i64]) : bool
  (if (<= index 0)
    false
    (let
      [slot : TcTypeEnvScopedSlot
        (array-ref (struct-get stack slots) (- index 1))]
      (tc-cleanup-owner-marker-for?
        (struct-get slot name-id)
        (struct-get slot ty)
        name-id))))

(define (tc-type-env-scoped-marker-cursor [stack : TcTypeEnvScopedStack]) : TcTypeEnvScopedMarkerCursor
  (TcTypeEnvScopedMarkerCursor stack (- (tc-type-env-scoped-stack-len stack) 1)))

(define (tc-type-env-scoped-marker-step [cursor : TcTypeEnvScopedMarkerCursor]) : TcTypeEnvScopedMarkerStep
  (let
    [index : i64 (struct-get cursor index)]
    (if (< index 0)
      TcTypeEnvScopedMarkerStep.Done
      (let
        [slot : TcTypeEnvScopedSlot
          (array-ref (struct-get (struct-get cursor stack) slots) index)]
        (TcTypeEnvScopedMarkerStep.Bind
          (struct-get slot name-id)
          (struct-get slot ty)
          (TcTypeEnvScopedMarkerCursor (struct-get cursor stack) (- index 1)))))))

(define (tc-type-env-scoped-stack-find-id-index-from
  [stack : (& stack TcTypeEnvScopedStack)]
  [name-id : i64]
  [index : i64]) : i64
  (if (< index 0)
    -1
    (let
      [slot : TcTypeEnvScopedSlot (array-ref (struct-get stack slots) index)]
      (if (= (struct-get slot name-id) name-id)
        index
        (tc-type-env-scoped-stack-find-id-index-from stack name-id (- index 1))))))

(define (tc-type-env-scoped-stack-find-id-index
  [stack : (& stack TcTypeEnvScopedStack)]
  [name-id : i64]) : i64
  (tc-type-env-scoped-stack-find-id-index-from
    stack
    name-id
    (- (struct-get stack slot-count) 1)))

(define (tc-type-env-scoped-stack-find-lifetime-index-from
  [stack : TcTypeEnvScopedStack]
  [lifetime-id : i64]
  [index : i64]) : i64
  (if (< index 0)
    -1
    (let
      [slot : TcTypeEnvScopedSlot (array-ref (struct-get stack slots) index)]
      (if (tc-env-binding-matches-lifetime-id?
        (struct-get slot name-id)
        (struct-get slot ty)
        lifetime-id)
        index
        (tc-type-env-scoped-stack-find-lifetime-index-from
          stack
          lifetime-id
          (- index 1))))))

(define (tc-type-env-scoped-stack-find-lifetime-index
  [stack : TcTypeEnvScopedStack]
  [lifetime-id : i64]) : i64
  (tc-type-env-scoped-stack-find-lifetime-index-from
    stack
    lifetime-id
    (- (tc-type-env-scoped-stack-len stack) 1)))

(define (tc-type-env-scoped-visible-marker-kind [name-id : i64] [ty : AstType]) : TcTypeEnvScopedMarkerKind
  (cond
    [(= name-id (tc-unsafe-marker-id)) TcTypeEnvScopedMarkerKind.UnsafeContext]
    [(= name-id (tc-return-type-id)) TcTypeEnvScopedMarkerKind.Other]
    [(= name-id (tc-loop-target-id)) TcTypeEnvScopedMarkerKind.Other]
    [(= name-id (tc-default-boundary-id))
      TcTypeEnvScopedMarkerKind.DefaultBoundary]
    [(= name-id (tc-region-marker-id)) TcTypeEnvScopedMarkerKind.Region]
    [(tc-cleanup-owner-marker-entry? name-id ty)
      TcTypeEnvScopedMarkerKind.CleanupOwner]
    [(tc-ordinary-arena-owner-marker-entry? name-id ty)
      TcTypeEnvScopedMarkerKind.OrdinaryArenaOwner]
    [(tc-atomic-arena-owner-marker-entry? name-id ty)
      TcTypeEnvScopedMarkerKind.AtomicArenaOwner]
    [else TcTypeEnvScopedMarkerKind.None]))

(define (tc-type-env-scoped-visible-bind-flags
  [rest-env : TcTypeEnv]
  [name-id : i64]) : i64
  (bit-or
    (if (tc-binding-unsafe-marker-head-id? rest-env name-id)
      tc-type-env-scoped-flag-unsafe
      0)
    (if (tc-c-abi-fnptr-marker-near-id? rest-env name-id 3)
      tc-type-env-scoped-flag-c-abi-fnptr
      0)))

(define (tc-type-env-scoped-stack-push-visible-bind!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [name-id : i64]
  [ty : AstType]
  [rest-env : TcTypeEnv]) : unit
  (let
    [marker-kind : TcTypeEnvScopedMarkerKind
      (tc-type-env-scoped-visible-marker-kind name-id ty)]
    [flags : i64 (tc-type-env-scoped-visible-bind-flags rest-env name-id)]
    [slot-flags : i64
      (if (tc-type-env-scoped-marker-kind-same?
        marker-kind
        TcTypeEnvScopedMarkerKind.None)
        flags
        (bit-or flags tc-type-env-scoped-flag-marker))]
    (tc-type-env-scoped-stack-push-slot!
      stack
      name-id
      ty
      slot-flags
      marker-kind)))

(define (tc-type-env-scoped-sidecar-fill-visible-env!
  [sidecar : (&mut sidecar TcTypeEnvScopedSidecar)]
  [env : TcTypeEnv]) : unit
  (match (tc-type-env-marker-step env)
    [(TcTypeEnvMarkerStep.Done) unit]
    [(TcTypeEnvMarkerStep.Cache rest-env)
      (tc-type-env-scoped-sidecar-fill-visible-env! sidecar rest-env)]
    [(TcTypeEnvMarkerStep.Bind key ty rest-env)
      (begin
        (tc-type-env-scoped-sidecar-fill-visible-env! sidecar rest-env)
        (tc-type-env-scoped-stack-push-visible-bind!
          (&mut (struct-get sidecar stack))
          key
          ty
          rest-env))]))

(define (tc-type-env-scoped-sidecar-from-marker-visible-env [env : TcTypeEnv]) : TcTypeEnvScopedSidecar
  (let
    [sidecar : TcTypeEnvScopedSidecar (tc-type-env-scoped-sidecar-from-env env)]
    (begin
      (tc-type-env-scoped-sidecar-fill-visible-env!
        (&mut sidecar)
        (tc-type-env-marker-start env))
      (set!
        (struct-get sidecar materialize-start)
        (tc-type-env-scoped-stack-len (struct-get sidecar stack)))
      sidecar)))

(define (tc-type-env-scoped-sidecar-from-env [env : TcTypeEnv]) : TcTypeEnvScopedSidecar
  (TcTypeEnvScopedSidecar env (tc-type-env-scoped-stack-new) 0))

(define (tc-type-env-scoped-sidecar-new) : TcTypeEnvScopedSidecar
  (tc-type-env-scoped-sidecar-from-env (tc-empty-env)))

(define (tc-type-env-scoped-sidecar-marker-cursor
  [sidecar : TcTypeEnvScopedSidecar]) : TcTypeEnvScopedMarkerCursor
  (tc-type-env-scoped-marker-cursor (struct-get sidecar stack)))

(define (tc-type-env-scoped-sidecar-persistent
  [sidecar : TcTypeEnvScopedSidecar]) : TcTypeEnv
  (struct-get sidecar persistent))

(define (tc-type-env-scoped-sidecar-lookup-id
  [sidecar : TcTypeEnvScopedSidecar]
  [name-id : i64]) : TcTypeEnvScopedLookup
  (tc-type-env-scoped-stack-lookup-id (struct-get sidecar stack) name-id))

(define (tc-type-env-scoped-sidecar-save!
  [sidecar : (&mut sidecar TcTypeEnvScopedSidecar)]) : TcTypeEnvScopedMark
  (tc-type-env-scoped-stack-save! (&mut (struct-get sidecar stack))))

(define (tc-type-env-scoped-sidecar-mark
  [sidecar : TcTypeEnvScopedSidecar]
  [stack-mark : TcTypeEnvScopedMark]) : TcTypeEnvScopedSidecarMark
  (TcTypeEnvScopedSidecarMark
    (struct-get sidecar persistent)
    stack-mark
    (struct-get sidecar materialize-start)))

(define (tc-type-env-scoped-sidecar-restore!
  [sidecar : (&mut sidecar TcTypeEnvScopedSidecar)]
  [mark : TcTypeEnvScopedSidecarMark]) : unit
  (begin
    (set! (struct-get sidecar persistent) (struct-get mark persistent))
    (set!
      (struct-get sidecar materialize-start)
      (struct-get mark materialize-start))
    (tc-type-env-scoped-stack-restore!
      (&mut (struct-get sidecar stack))
      (struct-get mark stack-mark))))

(define (tc-type-env-scoped-sidecar-bind-id
  [sidecar : TcTypeEnvScopedSidecar]
  [name-id : i64]
  [ty : AstType]) : TcTypeEnvScopedSidecar
  (let
    [next : TcTypeEnvScopedSidecar sidecar]
    (begin
      (tc-type-env-scoped-stack-bind-id!
        (&mut (struct-get next stack))
        name-id
        ty)
      next)))

(define (tc-type-env-scoped-sidecar-bind-marker-id
  [sidecar : TcTypeEnvScopedSidecar]
  [name-id : i64]
  [ty : AstType]
  [marker-kind : TcTypeEnvScopedMarkerKind]) : TcTypeEnvScopedSidecar
  (let
    [next : TcTypeEnvScopedSidecar sidecar]
    (begin
      (tc-type-env-scoped-stack-bind-marker-id!
        (&mut (struct-get next stack))
        name-id
        ty
        marker-kind)
      next)))

(define (tc-type-env-scoped-sidecar-enter-unsafe
  [sidecar : TcTypeEnvScopedSidecar]) : TcTypeEnvScopedSidecar
  (tc-type-env-scoped-sidecar-bind-marker-id
    sidecar
    (tc-unsafe-marker-id)
    (AstType.Unit)
    TcTypeEnvScopedMarkerKind.UnsafeContext))

(define (tc-type-env-scoped-sidecar-bind-return-type
  [sidecar : TcTypeEnvScopedSidecar]
  [ty : AstType]) : TcTypeEnvScopedSidecar
  (tc-type-env-scoped-sidecar-bind-marker-id
    sidecar
    (tc-return-type-id)
    ty
    TcTypeEnvScopedMarkerKind.Other))

(define (tc-type-env-scoped-sidecar-bind-default-boundary
  [sidecar : TcTypeEnvScopedSidecar]) : TcTypeEnvScopedSidecar
  (tc-type-env-scoped-sidecar-bind-marker-id
    sidecar
    (tc-default-boundary-id)
    (AstType.Unit)
    TcTypeEnvScopedMarkerKind.DefaultBoundary))

(define (tc-type-env-scoped-sidecar-push-region
  [sidecar : TcTypeEnvScopedSidecar]
  [region : i64]) : TcTypeEnvScopedSidecar
  (tc-type-env-scoped-sidecar-bind-marker-id
    sidecar
    (tc-region-marker-id)
    (AstType.Var region)
    TcTypeEnvScopedMarkerKind.Region))

(define (tc-type-env-scoped-sidecar-bind-cleanup-owner
  [sidecar : TcTypeEnvScopedSidecar]
  [name-id : i64]) : TcTypeEnvScopedSidecar
  (tc-type-env-scoped-sidecar-bind-marker-id
    sidecar
    (tc-cleanup-owner-marker-id)
    (AstType.Var name-id)
    TcTypeEnvScopedMarkerKind.CleanupOwner))

(define (tc-type-env-scoped-sidecar-bind-ordinary-arena-owner
  [sidecar : TcTypeEnvScopedSidecar]
  [name-id : i64]) : TcTypeEnvScopedSidecar
  (tc-type-env-scoped-sidecar-bind-marker-id
    sidecar
    (tc-ordinary-arena-owner-marker-id)
    (AstType.Var name-id)
    TcTypeEnvScopedMarkerKind.OrdinaryArenaOwner))

(define (tc-type-env-scoped-sidecar-bind-atomic-arena-owner
  [sidecar : TcTypeEnvScopedSidecar]
  [name-id : i64]) : TcTypeEnvScopedSidecar
  (tc-type-env-scoped-sidecar-bind-marker-id
    sidecar
    (tc-atomic-arena-owner-marker-id)
    (AstType.Var name-id)
    TcTypeEnvScopedMarkerKind.AtomicArenaOwner))

(define (tc-type-env-scoped-sidecar-bind-unsafe-c-abi-fnptr-id
  [sidecar : TcTypeEnvScopedSidecar]
  [name-id : i64]
  [ty : AstType]) : TcTypeEnvScopedSidecar
  (let
    [next : TcTypeEnvScopedSidecar sidecar]
    (begin
      (tc-type-env-scoped-stack-bind-marker-id!
        (&mut (struct-get next stack))
        (tc-c-abi-fnptr-marker-id name-id)
        (AstType.Unit)
        TcTypeEnvScopedMarkerKind.CAbiFnptr)
      (tc-type-env-scoped-stack-bind-marker-id!
        (&mut (struct-get next stack))
        (tc-unsafe-decl-marker-id name-id)
        (AstType.Unit)
        TcTypeEnvScopedMarkerKind.UnsafeDecl)
      (tc-type-env-scoped-stack-bind-flags-id!
        (&mut (struct-get next stack))
        name-id
        ty
        (bit-or
          tc-type-env-scoped-flag-unsafe
          tc-type-env-scoped-flag-c-abi-fnptr))
      next)))

;; The scoped stack owns local bindings. The persistent env is an immutable
;; module/top-level tail and is materialized only when an older TcTypeEnv API
;; explicitly asks for a snapshot. Walking slots from oldest to newest rebuilds
;; the same head-first lexical order without putting a persistent node on every
;; carrier bind.
(define (tc-type-env-scoped-stack-materialize-at
  [stack : TcTypeEnvScopedStack]
  [index : i64]
  [env : TcTypeEnv]) : TcTypeEnv
  (if (>= index (tc-type-env-scoped-stack-len stack))
    env
    (let
      [slot : TcTypeEnvScopedSlot (array-ref (struct-get stack slots) index)]
      (tc-type-env-scoped-stack-materialize-at
        stack
        (+ index 1)
        (begin
          (cfg compile-profile (compiler-tc-env-profile-note-bind))
          (TcTypeEnv.Bind
            (struct-get slot name-id)
            (struct-get slot ty)
            (box env)))))))

(define (tc-type-env-scoped-sidecar-materialize
  [sidecar : TcTypeEnvScopedSidecar]) : TcTypeEnv
  (begin
    (cfg
      compile-profile
      (compiler-tc-env-profile-note-scoped-materialization
        (-
          (tc-type-env-scoped-stack-len (struct-get sidecar stack))
          (struct-get sidecar materialize-start))))
    (tc-type-env-scoped-stack-materialize-at
      (struct-get sidecar stack)
      (struct-get sidecar materialize-start)
      (struct-get sidecar persistent))))

(define (tc-type-env-scoped-carrier-from-env [env : TcTypeEnv]) : TcTypeEnvScopedCarrier
  (TcTypeEnvScopedCarrier env (tc-type-env-scoped-sidecar-from-env env) false))

(define (tc-type-env-scoped-carrier-from-marker-visible-env [env : TcTypeEnv]) : TcTypeEnvScopedCarrier
  (TcTypeEnvScopedCarrier
    env
    (tc-type-env-scoped-sidecar-from-marker-visible-env env)
    false))

(define (tc-type-env-scoped-carrier-new) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-from-env (tc-empty-env)))

(define (tc-type-env-scoped-carrier-env [carrier : TcTypeEnvScopedCarrier]) : TcTypeEnv
  (if (struct-get carrier dirty)
    (tc-type-env-scoped-sidecar-materialize (struct-get carrier sidecar))
    (struct-get carrier env)))

(define (tc-type-env-scoped-carrier-sidecar [carrier : TcTypeEnvScopedCarrier]) : TcTypeEnvScopedSidecar
  (struct-get carrier sidecar))

(define (tc-type-env-scoped-carrier-persistent
  [carrier : TcTypeEnvScopedCarrier]) : TcTypeEnv
  (tc-type-env-scoped-sidecar-persistent (struct-get carrier sidecar)))

(define (tc-type-env-scoped-carrier-marker-cursor
  [carrier : TcTypeEnvScopedCarrier]) : TcTypeEnvScopedMarkerCursor
  (tc-type-env-scoped-sidecar-marker-cursor (struct-get carrier sidecar)))

(define (tc-type-env-scoped-carrier-with-sidecar
  [carrier : TcTypeEnvScopedCarrier]
  [sidecar : TcTypeEnvScopedSidecar]) : TcTypeEnvScopedCarrier
  (TcTypeEnvScopedCarrier (struct-get carrier env) sidecar true))

(define (tc-type-env-scoped-carrier-save [carrier : TcTypeEnvScopedCarrier]) : TcTypeEnvScopedCarrierSave
  (let
    [sidecar : TcTypeEnvScopedSidecar (struct-get carrier sidecar)]
    [stack-mark : TcTypeEnvScopedMark
      (tc-type-env-scoped-sidecar-save! (&mut sidecar))]
    (TcTypeEnvScopedCarrierSave
      (TcTypeEnvScopedCarrier
        (struct-get carrier env)
        sidecar
        (struct-get carrier dirty))
      (TcTypeEnvScopedCarrierMark
        (struct-get carrier env)
        (tc-type-env-scoped-sidecar-mark sidecar stack-mark)
        (struct-get carrier dirty)))))

(define (tc-type-env-scoped-carrier-snapshot-mark
  [carrier : TcTypeEnvScopedCarrier]) : TcTypeEnvScopedCarrierMark
  (let
    [sidecar : TcTypeEnvScopedSidecar (struct-get carrier sidecar)]
    [stack : TcTypeEnvScopedStack (struct-get sidecar stack)]
    (TcTypeEnvScopedCarrierMark
      (struct-get carrier env)
      (tc-type-env-scoped-sidecar-mark
        sidecar
        (TcTypeEnvScopedMark
          (struct-get stack slot-count)
          (struct-get stack mark-count)
          (struct-get stack scope-depth)
          (struct-get stack cache-generation)))
      (struct-get carrier dirty))))

(define (tc-type-env-scoped-carrier-restore
  [carrier : TcTypeEnvScopedCarrier]
  [mark : TcTypeEnvScopedCarrierMark]) : TcTypeEnvScopedCarrier
  (let
    [sidecar : TcTypeEnvScopedSidecar (struct-get carrier sidecar)]
    (begin
      (tc-type-env-scoped-sidecar-restore!
        (&mut sidecar)
        (struct-get mark sidecar-mark))
      (TcTypeEnvScopedCarrier
        (struct-get mark env)
        sidecar
        (struct-get mark dirty)))))

(define (tc-type-env-scoped-carrier-bind-id
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]
  [ty : AstType]) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-with-sidecar
    carrier
    (tc-type-env-scoped-sidecar-bind-id (struct-get carrier sidecar) name-id ty)))

(define (tc-type-env-scoped-carrier-enter-unsafe
  [carrier : TcTypeEnvScopedCarrier]) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-with-sidecar
    carrier
    (tc-type-env-scoped-sidecar-enter-unsafe (struct-get carrier sidecar))))

(define (tc-type-env-scoped-carrier-bind-return-type
  [carrier : TcTypeEnvScopedCarrier]
  [ty : AstType]) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-with-sidecar
    carrier
    (tc-type-env-scoped-sidecar-bind-return-type
      (struct-get carrier sidecar)
      ty)))

(define (tc-type-env-scoped-carrier-bind-default-boundary
  [carrier : TcTypeEnvScopedCarrier]) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-with-sidecar
    carrier
    (tc-type-env-scoped-sidecar-bind-default-boundary
      (struct-get carrier sidecar))))

(define (tc-type-env-scoped-carrier-push-region
  [carrier : TcTypeEnvScopedCarrier]
  [region : i64]) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-with-sidecar
    carrier
    (tc-type-env-scoped-sidecar-push-region (struct-get carrier sidecar) region)))

(define (tc-type-env-scoped-carrier-bind-cleanup-owner
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-with-sidecar
    carrier
    (tc-type-env-scoped-sidecar-bind-cleanup-owner
      (struct-get carrier sidecar)
      name-id)))

(define (tc-type-env-scoped-carrier-bind-ordinary-arena-owner
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-with-sidecar
    carrier
    (tc-type-env-scoped-sidecar-bind-ordinary-arena-owner
      (struct-get carrier sidecar)
      name-id)))

(define (tc-type-env-scoped-carrier-bind-atomic-arena-owner
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-with-sidecar
    carrier
    (tc-type-env-scoped-sidecar-bind-atomic-arena-owner
      (struct-get carrier sidecar)
      name-id)))

(define (tc-type-env-scoped-carrier-bind-unsafe-c-abi-fnptr-id
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]
  [ty : AstType]) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-with-sidecar
    carrier
    (tc-type-env-scoped-sidecar-bind-unsafe-c-abi-fnptr-id
      (struct-get carrier sidecar)
      name-id
      ty)))

(define (tc-type-env-scoped-carrier-lookup-id
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : ResultTcType
  (let
    [sidecar : TcTypeEnvScopedSidecar (struct-get carrier sidecar)]
    [stack : TcTypeEnvScopedStack (struct-get sidecar stack)]
    [index : i64 (tc-type-env-scoped-stack-lookup-index (&mut stack) name-id)]
    (if (>= index 0)
      (ResultTcType.Ok
        (struct-get (array-ref (struct-get stack slots) index) ty))
      (begin
        (cfg
          compile-profile
          (compiler-tc-env-profile-note-scoped-tail-fallback))
        (tc-lookup-persistent-id
          (tc-type-env-scoped-sidecar-persistent sidecar)
          name-id)))))

(define (tc-type-env-scoped-carrier-name-bound-id?
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : bool
  (let
    [sidecar : TcTypeEnvScopedSidecar (struct-get carrier sidecar)]
    [stack : TcTypeEnvScopedStack (struct-get sidecar stack)]
    (if (>= (tc-type-env-scoped-stack-lookup-index (&mut stack) name-id) 0)
      true
      (begin
        (cfg
          compile-profile
          (compiler-tc-env-profile-note-scoped-tail-fallback))
        (tc-name-bound-persistent-id?
          (tc-type-env-scoped-sidecar-persistent sidecar)
          name-id)))))

(define (tc-type-env-scoped-carrier-bind-alias-id-if-free
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]
  [ty : AstType]) : TcTypeEnvScopedCarrier
  (if (tc-type-env-scoped-carrier-name-bound-id? carrier name-id)
    carrier
    (tc-type-env-scoped-carrier-bind-id carrier name-id ty)))

(define (tc-type-env-scoped-carrier-lookup-unsafe-id
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : ResultTcTypeUnsafe
  (let
    [sidecar : TcTypeEnvScopedSidecar (struct-get carrier sidecar)]
    [stack : TcTypeEnvScopedStack (struct-get sidecar stack)]
    [index : i64 (tc-type-env-scoped-stack-lookup-index (&mut stack) name-id)]
    (if (>= index 0)
      (let
        [slot : TcTypeEnvScopedSlot (array-ref (struct-get stack slots) index)]
        (ResultTcTypeUnsafe.Ok
          (struct-get slot ty)
          (tc-type-env-scoped-flag?
            (struct-get slot flags)
            tc-type-env-scoped-flag-unsafe)))
      (begin
        (cfg
          compile-profile
          (compiler-tc-env-profile-note-scoped-tail-fallback))
        (tc-lookup-unsafe-persistent-id
          (tc-type-env-scoped-sidecar-persistent sidecar)
          name-id)))))

(define (tc-type-env-scoped-carrier-binding-unsafe-id?
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : bool
  (match (tc-type-env-scoped-carrier-lookup-unsafe-id carrier name-id)
    [(ResultTcTypeUnsafe.Ok _ unsafe) unsafe]
    [(ResultTcTypeUnsafe.Err _) false]))

(define (tc-type-env-scoped-carrier-binding-c-abi-fnptr-id?
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : bool
  (let
    [sidecar : TcTypeEnvScopedSidecar (struct-get carrier sidecar)]
    [stack : TcTypeEnvScopedStack (struct-get sidecar stack)]
    [index : i64 (tc-type-env-scoped-stack-lookup-index (&mut stack) name-id)]
    (if (>= index 0)
      (tc-type-env-scoped-slot-c-abi-fnptr?
        (array-ref (struct-get stack slots) index))
      (begin
        (cfg
          compile-profile
          (compiler-tc-env-profile-note-scoped-tail-fallback))
        (tc-binding-c-abi-fnptr-persistent-id?
          (tc-type-env-scoped-sidecar-persistent sidecar)
          name-id)))))

(define (tc-type-env-scoped-carrier-marker-type
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : AstMaybeType
  (match (tc-type-env-scoped-sidecar-lookup-id
    (struct-get carrier sidecar)
    name-id)
    [(TcTypeEnvScopedLookup.Found ty _ _ _ _ _) (AstMaybeType.Some ty)]
    [(TcTypeEnvScopedLookup.Missing)
      (tc-env-marker-type
        (tc-type-env-scoped-sidecar-persistent (struct-get carrier sidecar))
        name-id)]))

(define (tc-type-env-scoped-carrier-in-unsafe?
  [carrier : TcTypeEnvScopedCarrier]) : bool
  (match (tc-type-env-scoped-carrier-marker-type carrier (tc-unsafe-marker-id))
    [(AstMaybeType.Some _) true]
    [(AstMaybeType.No) false]))

(define (tc-type-env-scoped-carrier-current-return-type
  [carrier : TcTypeEnvScopedCarrier]) : ResultTcType
  (match (tc-type-env-scoped-carrier-marker-type carrier (tc-return-type-id))
    [(AstMaybeType.Some ty) (ResultTcType.Ok ty)]
    [(AstMaybeType.No)
      (ResultTcType.Err
        "typecheck: try requires enclosing Result-like function")]))

(define (tc-type-env-scoped-carrier-active-region
  [carrier : TcTypeEnvScopedCarrier]) : TcMaybeNameId
  (match (tc-type-env-scoped-carrier-marker-type carrier (tc-region-marker-id))
    [(AstMaybeType.Some (AstType.Var region)) (TcMaybeNameId.Some region)]
    [(AstMaybeType.Some _) (tc-active-region (struct-get carrier env))]
    [(AstMaybeType.No) (TcMaybeNameId.No)]))

;; Fully materialized marker-visible snapshots and the active function-body
;; runtime use stack indexes here. A miss falls back only to the carrier's
;; immutable module/top-level tail; inactive passes keep using TcTypeEnv's
;; relevance-indexed owner cache below.
(define (tc-type-env-scoped-carrier-cleanup-owner-active?
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : bool
  (let
    [stack : TcTypeEnvScopedStack
      (struct-get (struct-get carrier sidecar) stack)]
    [index : i64 (tc-type-env-scoped-stack-find-id-index (& stack) name-id)]
    (if (>= index 0)
      (tc-type-env-scoped-stack-cleanup-owner-before? stack index name-id)
      (tc-cleanup-owner-active-persistent-id?
        (tc-type-env-scoped-carrier-persistent carrier)
        name-id))))

(define (tc-type-env-scoped-carrier-arena-owner-active?
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]
  [marker-id : i64]) : bool
  (let
    [stack : TcTypeEnvScopedStack
      (struct-get (struct-get carrier sidecar) stack)]
    [index : i64 (tc-type-env-scoped-stack-find-id-index (& stack) name-id)]
    (if (>= index 0)
      (tc-type-env-scoped-stack-owner-marker-before?
        stack
        index
        name-id
        marker-id)
      (tc-arena-owner-active-persistent-id?
        (tc-type-env-scoped-carrier-persistent carrier)
        name-id
        marker-id))))

(define (tc-type-env-scoped-carrier-ordinary-arena-owner-active?
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : bool
  (tc-type-env-scoped-carrier-arena-owner-active?
    carrier
    name-id
    (tc-ordinary-arena-owner-marker-id)))

(define (tc-type-env-scoped-carrier-atomic-arena-owner-active?
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : bool
  (tc-type-env-scoped-carrier-arena-owner-active?
    carrier
    name-id
    (tc-atomic-arena-owner-marker-id)))

(define tc-type-env-scoped-cache-visible-valid : bool
  false)
(define tc-type-env-scoped-cache-visible-len : i64
  -1)
(define tc-type-env-scoped-cache-visible-generation : i64
  -1)
(define tc-type-env-scoped-cache-visible-lifetime-id : i64
  -1)
(define tc-type-env-scoped-cache-visible-result : bool
  false)
(define tc-type-env-scoped-cache-outlives-binding-valid : bool
  false)
(define tc-type-env-scoped-cache-outlives-binding-len : i64
  -1)
(define tc-type-env-scoped-cache-outlives-binding-generation : i64
  -1)
(define tc-type-env-scoped-cache-outlives-binding-lifetime-id : i64
  -1)
(define tc-type-env-scoped-cache-outlives-binding-target-id : i64
  -1)
(define tc-type-env-scoped-cache-outlives-binding-result : bool
  false)
(define tc-type-env-scoped-cache-outlives-lifetime-valid : bool
  false)
(define tc-type-env-scoped-cache-outlives-lifetime-len : i64
  -1)
(define tc-type-env-scoped-cache-outlives-lifetime-generation : i64
  -1)
(define tc-type-env-scoped-cache-outlives-lifetime-value-id : i64
  -1)
(define tc-type-env-scoped-cache-outlives-lifetime-target-id : i64
  -1)
(define tc-type-env-scoped-cache-outlives-lifetime-result : bool
  false)

(define (tc-type-env-scoped-cache-clear!) : unit
  (begin
    (set! tc-type-env-scoped-cache-visible-valid false)
    (set! tc-type-env-scoped-cache-outlives-binding-valid false)
    (set! tc-type-env-scoped-cache-outlives-lifetime-valid false)))

(define (tc-type-env-scoped-carrier-lifetime-visible-id?
  [carrier : TcTypeEnvScopedCarrier]
  [lifetime-id : i64]) : bool
  (let
    [stack : TcTypeEnvScopedStack
      (struct-get (struct-get carrier sidecar) stack)]
    [slot-count : i64 (tc-type-env-scoped-stack-len stack)]
    [generation : i64 (tc-type-env-scoped-stack-cache-generation stack)]
    (if (and
      tc-type-env-scoped-cache-visible-valid
      (= tc-type-env-scoped-cache-visible-len slot-count)
      (= tc-type-env-scoped-cache-visible-generation generation)
      (= tc-type-env-scoped-cache-visible-lifetime-id lifetime-id))
      tc-type-env-scoped-cache-visible-result
      (let
        [result : bool
          (if (>=
            (tc-type-env-scoped-stack-find-lifetime-index stack lifetime-id)
            0)
            true
            (tc-lifetime-visible-persistent-id?
              (tc-type-env-scoped-carrier-persistent carrier)
              lifetime-id))]
        (begin
          (set! tc-type-env-scoped-cache-visible-valid true)
          (set! tc-type-env-scoped-cache-visible-len slot-count)
          (set! tc-type-env-scoped-cache-visible-generation generation)
          (set! tc-type-env-scoped-cache-visible-lifetime-id lifetime-id)
          (set! tc-type-env-scoped-cache-visible-result result)
          result)))))

(define (tc-type-env-scoped-carrier-lifetime-outlives-binding-id?
  [carrier : TcTypeEnvScopedCarrier]
  [lifetime-id : i64]
  [target-id : i64]) : bool
  (let
    [stack : TcTypeEnvScopedStack
      (struct-get (struct-get carrier sidecar) stack)]
    [slot-count : i64 (tc-type-env-scoped-stack-len stack)]
    [generation : i64 (tc-type-env-scoped-stack-cache-generation stack)]
    (if (and
      tc-type-env-scoped-cache-outlives-binding-valid
      (= tc-type-env-scoped-cache-outlives-binding-len slot-count)
      (= tc-type-env-scoped-cache-outlives-binding-generation generation)
      (= tc-type-env-scoped-cache-outlives-binding-lifetime-id lifetime-id)
      (= tc-type-env-scoped-cache-outlives-binding-target-id target-id))
      tc-type-env-scoped-cache-outlives-binding-result
      (let
        [lifetime-index : i64
          (tc-type-env-scoped-stack-find-lifetime-index stack lifetime-id)]
        [target-index : i64
          (tc-type-env-scoped-stack-find-id-index (& stack) target-id)]
        [result : bool
          (cond
            [(>= lifetime-index 0)
              (and (>= target-index 0) (< lifetime-index target-index))]
            [(>= target-index 0)
              (tc-lifetime-visible-persistent-id?
                (tc-type-env-scoped-carrier-persistent carrier)
                lifetime-id)]
            [else
              (tc-lifetime-outlives-binding-persistent-id?
                (tc-type-env-scoped-carrier-persistent carrier)
                lifetime-id
                target-id)])]
        (begin
          (set! tc-type-env-scoped-cache-outlives-binding-valid true)
          (set! tc-type-env-scoped-cache-outlives-binding-len slot-count)
          (set! tc-type-env-scoped-cache-outlives-binding-generation generation)
          (set!
            tc-type-env-scoped-cache-outlives-binding-lifetime-id
            lifetime-id)
          (set! tc-type-env-scoped-cache-outlives-binding-target-id target-id)
          (set! tc-type-env-scoped-cache-outlives-binding-result result)
          result)))))

(define (tc-type-env-scoped-carrier-lifetime-outlives-lifetime-id?
  [carrier : TcTypeEnvScopedCarrier]
  [value-lifetime-id : i64]
  [target-lifetime-id : i64]) : bool
  (if (= value-lifetime-id target-lifetime-id)
    true
    (let
      [stack : TcTypeEnvScopedStack
        (struct-get (struct-get carrier sidecar) stack)]
      [slot-count : i64 (tc-type-env-scoped-stack-len stack)]
      [generation : i64 (tc-type-env-scoped-stack-cache-generation stack)]
      (if (and
        tc-type-env-scoped-cache-outlives-lifetime-valid
        (= tc-type-env-scoped-cache-outlives-lifetime-len slot-count)
        (= tc-type-env-scoped-cache-outlives-lifetime-generation generation)
        (=
          tc-type-env-scoped-cache-outlives-lifetime-value-id
          value-lifetime-id)
        (=
          tc-type-env-scoped-cache-outlives-lifetime-target-id
          target-lifetime-id))
        tc-type-env-scoped-cache-outlives-lifetime-result
        (let
          [value-index : i64
            (tc-type-env-scoped-stack-find-lifetime-index
              stack
              value-lifetime-id)]
          [target-index : i64
            (tc-type-env-scoped-stack-find-lifetime-index
              stack
              target-lifetime-id)]
          [result : bool
            (cond
              [(>= value-index 0)
                (and (>= target-index 0) (< value-index target-index))]
              [(>= target-index 0)
                (tc-lifetime-visible-persistent-id?
                  (tc-type-env-scoped-carrier-persistent carrier)
                  value-lifetime-id)]
              [else
                (tc-lifetime-outlives-lifetime-persistent-id?
                  (tc-type-env-scoped-carrier-persistent carrier)
                  value-lifetime-id
                  target-lifetime-id)])]
          (begin
            (set! tc-type-env-scoped-cache-outlives-lifetime-valid true)
            (set! tc-type-env-scoped-cache-outlives-lifetime-len slot-count)
            (set!
              tc-type-env-scoped-cache-outlives-lifetime-generation
              generation)
            (set!
              tc-type-env-scoped-cache-outlives-lifetime-value-id
              value-lifetime-id)
            (set!
              tc-type-env-scoped-cache-outlives-lifetime-target-id
              target-lifetime-id)
            (set! tc-type-env-scoped-cache-outlives-lifetime-result result)
            result))))))

(define tc-type-env-scoped-runtime-active : bool
  false)
(define tc-type-env-scoped-runtime-carrier : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-new))

;; Entering scoped runtime eagerly interns these stable marker names. Keeping
;; their cached ids also makes the ordering explicit across intern resets.
(define tc-type-env-scoped-runtime-marker-id-generation : i64
  -1)
(define tc-type-env-scoped-runtime-marker-id-unsafe : i64
  -1)
(define tc-type-env-scoped-runtime-marker-id-return : i64
  -1)
(define tc-type-env-scoped-runtime-marker-id-region : i64
  -1)

(define (tc-type-env-scoped-runtime-active?) : bool
  tc-type-env-scoped-runtime-active)

(define (tc-type-env-scoped-runtime-current) : TcTypeEnvScopedCarrier
  tc-type-env-scoped-runtime-carrier)

(define (tc-type-env-scoped-runtime-lookup-index [name-id : i64]) : i64
  (if (and (>= name-id 0) (< name-id tc-type-env-scoped-dense-lookup-capacity))
    (if (=
      (array-ref tc-type-env-scoped-dense-lookup-epochs name-id)
      (struct-get
        (struct-get
          (struct-get tc-type-env-scoped-runtime-carrier sidecar)
          stack)
        lookup-epoch))
      (let
        [index : i64
          (array-ref tc-type-env-scoped-dense-lookup-indices name-id)]
        (if (< index 0)
          (begin
            (cfg
              compile-profile
              (compiler-tc-env-profile-note-scoped-cache-hit))
            -1)
          (if (<
            index
            (struct-get
              (struct-get
                (struct-get tc-type-env-scoped-runtime-carrier sidecar)
                stack)
              slot-count))
            (begin
              (cfg
                compile-profile
                (compiler-tc-env-profile-note-scoped-cache-hit))
              index)
            (let
              [stack : TcTypeEnvScopedStack
                (struct-get
                  (struct-get tc-type-env-scoped-runtime-carrier sidecar)
                  stack)]
              (tc-type-env-scoped-stack-dense-lookup-id-refresh
                (& stack)
                name-id)))))
      (let
        [stack : TcTypeEnvScopedStack
          (struct-get
            (struct-get tc-type-env-scoped-runtime-carrier sidecar)
            stack)]
        (tc-type-env-scoped-stack-dense-lookup-id-refresh (& stack) name-id)))
    (let
      [stack : TcTypeEnvScopedStack
        (struct-get
          (struct-get tc-type-env-scoped-runtime-carrier sidecar)
          stack)]
      (tc-type-env-scoped-stack-map-lookup-id (&mut stack) name-id))))

(define (tc-type-env-scoped-runtime-save) : TcTypeEnvScopedRuntimeSave
  (if tc-type-env-scoped-runtime-active
    (TcTypeEnvScopedRuntimeSave.Scope
      (tc-type-env-scoped-carrier-snapshot-mark
        tc-type-env-scoped-runtime-carrier))
    (TcTypeEnvScopedRuntimeSave.Inactive)))

(define (tc-type-env-scoped-runtime-suspend!) : TcTypeEnvScopedRuntimeSave
  (let
    [saved : TcTypeEnvScopedRuntimeSave (tc-type-env-scoped-runtime-save)]
    (begin
      (set! tc-type-env-scoped-runtime-active false)
      saved)))

(define (tc-type-env-scoped-runtime-restore!
  [saved : TcTypeEnvScopedRuntimeSave]) : unit
  (match saved
    [(TcTypeEnvScopedRuntimeSave.Inactive)
      (begin
        (tc-type-env-scoped-cache-clear!)
        (set! tc-type-env-scoped-runtime-active false))]
    [(TcTypeEnvScopedRuntimeSave.Scope mark)
      (begin
        (set!
          tc-type-env-scoped-runtime-carrier
          (tc-type-env-scoped-carrier-restore
            tc-type-env-scoped-runtime-carrier
            mark))
        (set! tc-type-env-scoped-runtime-active true))]
    [(TcTypeEnvScopedRuntimeSave.Replaced carrier)
      (begin
        (tc-type-env-scoped-cache-clear!)
        (set! tc-type-env-scoped-runtime-carrier carrier)
        (set! tc-type-env-scoped-runtime-active true))]))

(define (tc-type-env-scoped-runtime-enter! [carrier : TcTypeEnvScopedCarrier]) : TcTypeEnvScopedRuntimeSave
  (let
    [saved : TcTypeEnvScopedRuntimeSave
      (if tc-type-env-scoped-runtime-active
        (TcTypeEnvScopedRuntimeSave.Replaced tc-type-env-scoped-runtime-carrier)
        (TcTypeEnvScopedRuntimeSave.Inactive))]
    (begin
      (tc-type-env-scoped-runtime-marker-ids-ensure!)
      (tc-type-env-scoped-cache-clear!)
      (set! tc-type-env-scoped-runtime-carrier carrier)
      (set! tc-type-env-scoped-runtime-active true)
      saved)))

(define (tc-type-env-scoped-runtime-slot-flags
  [marker-kind : TcTypeEnvScopedMarkerKind]) : i64
  (if (tc-type-env-scoped-marker-kind-same?
    marker-kind
    TcTypeEnvScopedMarkerKind.None)
    0
    tc-type-env-scoped-flag-marker))

(define (tc-type-env-scoped-runtime-marker-ids-ensure!) : unit
  (if (= tc-type-env-scoped-runtime-marker-id-generation (intern-generation))
    unit
    (begin
      (set! tc-type-env-scoped-runtime-marker-id-generation (intern-generation))
      (set! tc-type-env-scoped-runtime-marker-id-unsafe (tc-unsafe-marker-id))
      (set! tc-type-env-scoped-runtime-marker-id-return (tc-return-type-id))
      (set! tc-type-env-scoped-runtime-marker-id-region (tc-region-marker-id)))))

(define (tc-type-env-scoped-runtime-note-bind-id!
  [_next-env : TcTypeEnv]
  [name-id : i64]
  [ty : AstType]
  [_rest-env : TcTypeEnv]) : unit
  (begin
    (tc-type-env-scoped-stack-push-slot!
      (&mut
        (struct-get
          (struct-get tc-type-env-scoped-runtime-carrier sidecar)
          stack))
      name-id
      ty
      0
      TcTypeEnvScopedMarkerKind.None)
    (set! (struct-get tc-type-env-scoped-runtime-carrier dirty) true)))

(define (tc-type-env-scoped-runtime-mark-latest-flags-id!
  [name-id : i64]
  [flags : i64]) : unit
  (let
    [stack : TcTypeEnvScopedStack
      (struct-get (struct-get tc-type-env-scoped-runtime-carrier sidecar) stack)]
    [index : i64 (- (struct-get stack slot-count) 1)]
    (if (and
      (>= index 0)
      (=
        (struct-get (array-ref (struct-get stack slots) index) name-id)
        name-id))
      (let
        [slot : TcTypeEnvScopedSlot (array-ref (struct-get stack slots) index)]
        (array-set!
          (struct-get stack slots)
          index
          (TcTypeEnvScopedSlot
            (struct-get slot name-id)
            (struct-get slot ty)
            (bit-or (struct-get slot flags) flags)
            (struct-get slot marker-kind-tag)
            (struct-get slot scope-depth)
            (struct-get slot generation))))
      unit)))

(define (tc-type-env-scoped-runtime-mark-latest-marker-id!
  [name-id : i64]
  [marker-kind : TcTypeEnvScopedMarkerKind]) : unit
  (let
    [stack : TcTypeEnvScopedStack
      (struct-get (struct-get tc-type-env-scoped-runtime-carrier sidecar) stack)]
    [index : i64 (- (struct-get stack slot-count) 1)]
    (if (and
      (>= index 0)
      (=
        (struct-get (array-ref (struct-get stack slots) index) name-id)
        name-id))
      (let
        [slot : TcTypeEnvScopedSlot (array-ref (struct-get stack slots) index)]
        (array-set!
          (struct-get stack slots)
          index
          (TcTypeEnvScopedSlot
            (struct-get slot name-id)
            (struct-get slot ty)
            (bit-or
              (struct-get slot flags)
              (tc-type-env-scoped-runtime-slot-flags marker-kind))
            (tc-type-env-scoped-marker-kind-tag marker-kind)
            (struct-get slot scope-depth)
            (struct-get slot generation))))
      unit)))

(define (tc-type-env-scoped-runtime-enter-env! [env : TcTypeEnv]) : TcTypeEnvScopedRuntimeSave
  (if tc-type-env-scoped-runtime-active
    (tc-type-env-scoped-runtime-save)
    (tc-type-env-scoped-runtime-enter!
      (tc-type-env-scoped-carrier-from-env env))))

(define (tc-bind-runtime-marker-id
  [env : TcTypeEnv]
  [name-id : i64]
  [ty : AstType]
  [marker-kind : TcTypeEnvScopedMarkerKind]) : TcTypeEnv
  (let
    [next-env : TcTypeEnv (tc-bind-id env name-id ty)]
    (begin
      (if tc-type-env-scoped-runtime-active
        (tc-type-env-scoped-runtime-mark-latest-marker-id! name-id marker-kind)
        unit)
      next-env)))

(define (tc-c-abi-fnptr-marker-near-id?
  [env : TcTypeEnv]
  [name-id : i64]
  [remaining : i64]) : bool
  (if (<= remaining 0)
    false
    (match env
      [(TcTypeEnv.Nil) false]
      [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
        (tc-c-abi-fnptr-marker-near-id? (box-get rest) name-id remaining)]
      [(TcTypeEnv.Bind key _ rest)
        (if (tc-c-abi-fnptr-marker-key-id? key name-id)
          true
          (if (= key name-id)
            false
            (tc-c-abi-fnptr-marker-near-id?
              (box-get rest)
              name-id
              (- remaining 1))))])))

(define (tc-binding-c-abi-fnptr-persistent-id?
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (match env
    [(TcTypeEnv.Nil) false]
    [(TcTypeEnv.Cache ids _ _ c-abi-fnptr-flags _ _ partial _ below)
      (let
        [index : i64 (tc_i64_i64_map.get-value-or (& ids) name-id -1)]
        (if (>= index 0)
          (= (array-ref c-abi-fnptr-flags index) 1)
          (if partial
            (tc-binding-c-abi-fnptr-persistent-id? (box-get below) name-id)
            false)))]
    [(TcTypeEnv.Bind key _ rest)
      (if (= key name-id)
        (tc-c-abi-fnptr-marker-near-id? (box-get rest) name-id 3)
        (tc-binding-c-abi-fnptr-persistent-id? (box-get rest) name-id))]))

(define (tc-binding-c-abi-fnptr-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (if tc-type-env-scoped-runtime-active
    (let
      [index : i64 (tc-type-env-scoped-runtime-lookup-index name-id)]
      [scoped : bool
        (if (>= index 0)
          (tc-type-env-scoped-slot-c-abi-fnptr?
            (array-ref
              (struct-get
                (struct-get
                  (struct-get tc-type-env-scoped-runtime-carrier sidecar)
                  stack)
                slots)
              index))
          (begin
            (cfg
              compile-profile
              (compiler-tc-env-profile-note-scoped-tail-fallback))
            (tc-binding-c-abi-fnptr-persistent-id?
              (struct-get
                (struct-get tc-type-env-scoped-runtime-carrier sidecar)
                persistent)
              name-id)))]
      (begin
        (cfg
          tc-env-scoped-dual-verify
          (if (= scoped (tc-binding-c-abi-fnptr-persistent-id? env name-id))
            unit
            (io.panic
              "typecheck: scoped C ABI fnptr lookup diverged from persistent env")))
        scoped))
    (tc-binding-c-abi-fnptr-persistent-id? env name-id)))

(define (tc-binding-unsafe-marker-head-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (match env
    [(TcTypeEnv.Bind key _ _) (tc-unsafe-decl-marker-key-id? key name-id)]
    [_ false]))

(define (tc-binding-unsafe-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (match env
    [(TcTypeEnv.Nil) false]
    [(TcTypeEnv.Cache ids _ unsafe-flags _ _ _ partial _ below)
      (let
        [index : i64 (tc_i64_i64_map.get-value-or (& ids) name-id -1)]
        (if (>= index 0)
          (= (array-ref unsafe-flags index) 1)
          (if partial
            (tc-binding-unsafe-id? (box-get below) name-id)
            false)))]
    [(TcTypeEnv.Bind key _ rest)
      (if (= key name-id)
        (tc-binding-unsafe-marker-head-id? (box-get rest) name-id)
        (tc-binding-unsafe-id? (box-get rest) name-id))]))

(define (tc-env-cache-count [env : TcTypeEnv]) : i64
  (let
    [cur : TcTypeEnv env]
    [count : i64 0]
    [done : bool false]
    (begin
      (while (not done)
        (match cur
          [(TcTypeEnv.Nil) (set! done true)]
          [(TcTypeEnv.Bind _ _ rest)
            (begin
              (set! count (+ count 1))
              (set! cur (box-get rest)))]
          [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _) (set! cur (box-get rest))]))
      count)))

(define (tc-env-cache-count-prefix [env : TcTypeEnv] [remaining : i64]) : i64
  (let
    [cur : TcTypeEnv env]
    [left : i64 remaining]
    [count : i64 0]
    [done : bool false]
    (begin
      (while (and (not done) (> left 0))
        (match cur
          [(TcTypeEnv.Bind _ _ rest)
            (begin
              (set! count (+ count 1))
              (set! left (- left 1))
              (set! cur (box-get rest)))]
          [_ (set! done true)]))
      count)))

(define (tc-env-cache-capacity [count : i64]) : i64
  (if (< count 4)
    8
    (* count 2)))

(define tc-env-cache-flag-default-shadow : i64
  1)
(define tc-env-cache-flag-cleanup-owner : i64
  2)
(define tc-env-cache-flag-ordinary-arena-owner : i64
  4)
(define tc-env-cache-flag-atomic-arena-owner : i64
  8)
(define tc-env-cache-sidecar-position-scale : i64
  16)

(define (tc-env-cache-binding-sidecar-flags
  [rest-env : TcTypeEnv]
  [name-id : i64]
  [default-shadow : bool]
  [cleanup-marker-id : i64]
  [ordinary-arena-marker-id : i64]
  [atomic-arena-marker-id : i64]) : i64
  (let
    [base : i64
      (if default-shadow
        tc-env-cache-flag-default-shadow
        0)]
    (match rest-env
      [(TcTypeEnv.Bind marker-id marker-ty _)
        (let
          [marker-flag : i64
            (cond
              [(= marker-id cleanup-marker-id) tc-env-cache-flag-cleanup-owner]
              [(= marker-id ordinary-arena-marker-id)
                tc-env-cache-flag-ordinary-arena-owner]
              [(= marker-id atomic-arena-marker-id)
                tc-env-cache-flag-atomic-arena-owner]
              [else 0])]
          (if (= marker-flag 0)
            base
            (match marker-ty
              [(AstType.Var owner)
                (if (= owner name-id)
                  (+ base marker-flag)
                  base)]
              [_ base])))]
      [_ base])))

(define (tc-env-cache-owner-marker-head-id?
  [env : TcTypeEnv]
  [name-id : i64]
  [marker-id : i64]) : bool
  (match env
    [(TcTypeEnv.Bind key (AstType.Var owner) _)
      (and (= key marker-id) (= owner name-id))]
    [_ false]))

;; Cache construction is the dominant i64 map workload of a self-compile
;; (~16% of stage2 CPU before this change): the previous shape walked the
;; spine FOUR times per compaction (entry count, shadow count, entry fill,
;; shadow fill) and built a second whole-env map just to answer "is this
;; default builtin shadowed?". Default-shadow membership is now a per-entry
;; flag array parallel to `values`/`unsafe-flags`, computed during the single
;; entry fill walk: an entry's low bit is set when its head-most binding sits
;; above the first default-boundary marker. Head-first walk order means a
;; name bound both above and below the boundary keeps its head-most (above)
;; occurrence, which matches the old any-occurrence-above map exactly.
(define (tc-env-cache-add!
  [ids : (&mut ids tc_i64_i64_map.Map)]
  [values : (Array AstType)]
  [unsafe-flags : (Array i64)]
  [c-abi-fnptr-flags : (Array i64)]
  [shadow-flags : (Array i64)]
  [name-id : i64]
  [next : i64]
  [ty : AstType]
  [unsafe : bool]
  [c-abi-fnptr : bool]
  [sidecar-flags : i64]
  [position : i64]) : bool
  (if (tc_i64_i64_map.insert-if-absent-ref! ids name-id next)
    (begin
      (cfg compile-profile (compiler-tc-env-profile-note-cache-entry))
      (array-set! values next ty)
      (array-set!
        unsafe-flags
        next
        (if unsafe
          1
          0))
      (array-set!
        c-abi-fnptr-flags
        next
        (if c-abi-fnptr
          1
          0))
      (array-set!
        shadow-flags
        next
        (+ sidecar-flags (* position tc-env-cache-sidecar-position-scale)))
      true)
    false))

(define (tc-env-cache-fill
  [env : TcTypeEnv]
  [ids : tc_i64_i64_map.Map]
  [values : (Array AstType)]
  [unsafe-flags : (Array i64)]
  [c-abi-fnptr-flags : (Array i64)]
  [shadow-flags : (Array i64)]
  [above-boundary : bool]) : tc_i64_i64_map.Map
  (let
    [cur : TcTypeEnv env]
    [cur-ids : tc_i64_i64_map.Map ids]
    [next : i64 0]
    [position : i64 0]
    [cleanup-marker-id : i64 (tc-cleanup-owner-marker-id)]
    [ordinary-arena-marker-id : i64 (tc-ordinary-arena-owner-marker-id)]
    [atomic-arena-marker-id : i64 (tc-atomic-arena-owner-marker-id)]
    [cur-above-boundary : bool above-boundary]
    [done : bool false]
    (begin
      (while (not done)
        (match cur
          [(TcTypeEnv.Nil) (set! done true)]
          [(TcTypeEnv.Bind name-id ty rest)
            (let
              [rest-env : TcTypeEnv (box-get rest)]
              ;; The boundary bind itself and everything below it are not
              ;; default shadows.
              [still-above : bool
                (if cur-above-boundary
                  (not (= name-id (tc-default-boundary-id)))
                  false)]
              (begin
                (if (tc-env-cache-add!
                  (&mut cur-ids)
                  values
                  unsafe-flags
                  c-abi-fnptr-flags
                  shadow-flags
                  name-id
                  next
                  ty
                  (tc-binding-unsafe-marker-head-id? rest-env name-id)
                  (tc-c-abi-fnptr-marker-near-id? rest-env name-id 3)
                  (tc-env-cache-binding-sidecar-flags
                    rest-env
                    name-id
                    still-above
                    cleanup-marker-id
                    ordinary-arena-marker-id
                    atomic-arena-marker-id)
                  position)
                  (set! next (+ next 1))
                  unit)
                (set! cur rest-env)
                (set! position (+ position 1))
                (set! cur-above-boundary still-above)))]
          [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _) (set! cur (box-get rest))]))
      cur-ids)))

(define (tc-env-cache-fill-prefix
  [env : TcTypeEnv]
  [remaining : i64]
  [ids : tc_i64_i64_map.Map]
  [values : (Array AstType)]
  [unsafe-flags : (Array i64)]
  [c-abi-fnptr-flags : (Array i64)]
  [shadow-flags : (Array i64)]
  [above-boundary : bool]) : tc_i64_i64_map.Map
  (let
    [cur : TcTypeEnv env]
    [left : i64 remaining]
    [cur-ids : tc_i64_i64_map.Map ids]
    [next : i64 0]
    [position : i64 0]
    [cleanup-marker-id : i64 (tc-cleanup-owner-marker-id)]
    [ordinary-arena-marker-id : i64 (tc-ordinary-arena-owner-marker-id)]
    [atomic-arena-marker-id : i64 (tc-atomic-arena-owner-marker-id)]
    [cur-above-boundary : bool above-boundary]
    [done : bool false]
    (begin
      (while (and (not done) (> left 0))
        (match cur
          [(TcTypeEnv.Bind name-id ty rest)
            (let
              [rest-env : TcTypeEnv (box-get rest)]
              [still-above : bool
                (if cur-above-boundary
                  (not (= name-id (tc-default-boundary-id)))
                  false)]
              (begin
                (if (tc-env-cache-add!
                  (&mut cur-ids)
                  values
                  unsafe-flags
                  c-abi-fnptr-flags
                  shadow-flags
                  name-id
                  next
                  ty
                  (tc-binding-unsafe-marker-head-id? rest-env name-id)
                  (tc-c-abi-fnptr-marker-near-id? rest-env name-id 3)
                  (tc-env-cache-binding-sidecar-flags
                    rest-env
                    name-id
                    still-above
                    cleanup-marker-id
                    ordinary-arena-marker-id
                    atomic-arena-marker-id)
                  position)
                  (set! next (+ next 1))
                  unit)
                (set! left (- left 1))
                (set! cur rest-env)
                (set! position (+ position 1))
                (set! cur-above-boundary still-above)))]
          [(TcTypeEnv.Cache _ _ _ _ _ scan-through partial rest _)
            (if (and scan-through partial)
              ;; The cache's `rest` starts at the first bind it covers. Walk
              ;; that layer, then the next partial layer, but stop before an
              ;; explicit/global cache; `left` is the exact covered-bind sum.
              (set! cur (box-get rest))
              (set! done true))]
          [_ (set! done true)]))
      cur-ids)))

(define (tc-env-with-cache-mode [env : TcTypeEnv] [scan-through : bool]) : TcTypeEnv
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-cache-build))
    (let
      [count : i64 (tc-env-cache-count env)]
      [capacity : i64 (tc-env-cache-capacity count)]
      [values : (Array AstType) (array.make-array AstType capacity)]
      [unsafe-flags : (Array i64) (array.make-array i64 capacity)]
      [c-abi-fnptr-flags : (Array i64) (array.make-array i64 capacity)]
      [shadow-flags : (Array i64) (array.make-array i64 capacity)]
      [ids : tc_i64_i64_map.Map
        (tc-env-cache-fill
          env
          (tc_i64_i64_map.with-capacity capacity)
          values
          unsafe-flags
          c-abi-fnptr-flags
          shadow-flags
          true)]
      (begin
        (array-set! shadow-flags (- capacity 1) count)
        (TcTypeEnv.Cache
          ids
          values
          unsafe-flags
          c-abi-fnptr-flags
          shadow-flags
          scan-through
          false
          (box env)
          (box env))))))

(define (tc-env-with-partial-local-cache [env : TcTypeEnv]) : TcTypeEnv
  (tc-env-with-cache-prefix-layer
    env
    (tc-env-cache-count-prefix env (tc-local-cache-threshold))
    true
    (tc-env-after-prefix env (tc-local-cache-threshold))))

(define (tc-env-with-cache-prefix-layer
  [env : TcTypeEnv]
  [count : i64]
  [scan-through : bool]
  [below : TcTypeEnv]) : TcTypeEnv
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-cache-build))
    (let
      [capacity : i64 (tc-env-cache-capacity count)]
      [values : (Array AstType) (array.make-array AstType capacity)]
      [unsafe-flags : (Array i64) (array.make-array i64 capacity)]
      [c-abi-fnptr-flags : (Array i64) (array.make-array i64 capacity)]
      [shadow-flags : (Array i64) (array.make-array i64 capacity)]
      [ids : tc_i64_i64_map.Map
        (tc-env-cache-fill-prefix
          env
          count
          (tc_i64_i64_map.with-capacity capacity)
          values
          unsafe-flags
          c-abi-fnptr-flags
          shadow-flags
          true)]
      (begin
        (array-set! shadow-flags (- capacity 1) count)
        (TcTypeEnv.Cache
          ids
          values
          unsafe-flags
          c-abi-fnptr-flags
          shadow-flags
          scan-through
          true
          (box env)
          (box below))))))

(define (tc-env-with-cache-layer-over-explicit [env : TcTypeEnv]) : TcTypeEnv
  (let
    [prefix-count : i64 (tc-env-uncached-prefix-to-explicit-cache-count env)]
    (cond
      [(= prefix-count 0) env]
      [(> prefix-count 0)
        (tc-env-with-cache-prefix-layer
          env
          prefix-count
          false
          (tc-env-after-prefix env prefix-count))]
      [else (tc-env-with-cache-mode env false)])))

;; Explicit top-env/module caches: marker scans terminate here.
(define (tc-env-with-cache [env : TcTypeEnv]) : TcTypeEnv
  (tc-env-with-cache-mode env false))

;; Collapse a deep stack of local windows into one wider partial cache. Lookup
;; misses jump directly to the existing explicit/global cache, while `rest`
;; keeps the original spine available to marker scans. This avoids rebuilding
;; tens of thousands of immutable top-level bindings for a few hundred locals.
(define (tc-env-with-collapsed-local-cache [env : TcTypeEnv]) : TcTypeEnv
  (let
    [threshold : i64 (tc-local-cache-threshold)]
    [layers : TcTypeEnv (tc-env-after-prefix env threshold)]
    [count : i64
      (+
        (tc-env-cache-count-prefix env threshold)
        (tc-env-partial-local-covered-count layers))]
    (tc-env-with-cache-prefix-layer
      env
      count
      true
      (tc-env-partial-local-base layers))))

;; Threshold-compaction caches inside function-body spines: partial lookup
;; cache for the newest bind window; marker scans keep scanning the full spine.
(define (tc-env-with-local-cache [env : TcTypeEnv]) : TcTypeEnv
  (tc-env-with-partial-local-cache env))

(define (tc-name-bound-id-with-top-env-membership?
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (cond
    [(and
        tc-topenv-membership-active
        (not (tc-topenv-membership-maybe? name-id)))
      false]
    [(and tc-topenv-membership-active (tc-topenv-membership-bound? name-id))
      true]
    [else (tc-name-bound-id? env name-id)]))

(define (tc-bind-alias-id-if-free
  [env : TcTypeEnv]
  [name-id : i64]
  [ty : AstType]) : TcTypeEnv
  (cond
    [(and
        tc-topenv-membership-active
        (not (tc-topenv-membership-maybe? name-id)))
      ;; Provably unbound in the top-env spine: bind without the O(spine) scan.
      (begin
        (tc-topenv-membership-mark-bound! name-id)
        (tc-bind-id env name-id ty))]
    [(and tc-topenv-membership-active (tc-topenv-membership-bound? name-id))
      ;; Provably bound by an earlier spine-joining bind this build: skip
      ;; without the O(spine) scan (the scan would find that binding).
      env]
    [(tc-name-bound-id? env name-id) env]
    [else
      (begin
        (tc-topenv-membership-mark-bound! name-id)
        (tc-bind-id env name-id ty))]))

(define (tc-module-name-id-by-id [module-id : i64] [name-id : i64]) : i64
  (compiler-symbol-module-key-id-by-id module-id name-id))

(define (tc-env-key-has-name-id? [key : i64]) : bool
  (and
    (>= key 0)
    (< key (intern-capacity))
    (or (< key (intern-pool-len)) (intern-generated-id-active? key))))

(define (tc-env-name-key-id [name-id : i64]) : i64
  (cond
    [(macro-hygiene-global-id? name-id)
      (compiler-symbol-module-key-id-by-id
        (macro-hygiene-global-module-id name-id)
        (macro-hygiene-structural-source-name-id name-id))]
    [(and
        (tc-env-key-has-name-id? name-id)
        (intern-qualified? name-id)
        (not (tc-hygiene-local-name-id? name-id)))
      (compiler-symbol-name-id-key name-id)]
    [else name-id]))

(define tc-unqualified-import-owner-modules : sym_i64_env.SymI64Env
  (sym_i64_env.sym-i64-empty))
(define tc-unqualified-import-ambiguous-first-modules : sym_i64_env.SymI64Env
  (sym_i64_env.sym-i64-empty))
(define tc-unqualified-import-ambiguous-second-modules : sym_i64_env.SymI64Env
  (sym_i64_env.sym-i64-empty))
(define tc-unqualified-import-has-ambiguity : bool
  false)

(define (tc-unqualified-import-ambiguity-reset!) : unit
  (begin
    (set! tc-unqualified-import-owner-modules (sym_i64_env.sym-i64-empty))
    (set!
      tc-unqualified-import-ambiguous-first-modules
      (sym_i64_env.sym-i64-empty))
    (set!
      tc-unqualified-import-ambiguous-second-modules
      (sym_i64_env.sym-i64-empty))
    (set! tc-unqualified-import-has-ambiguity false)))

(define (tc-unqualified-import-key-id
  [importer-module-id : i64]
  [name-id : i64]) : i64
  (tc-module-name-id-by-id importer-module-id name-id))

(define (tc-unqualified-import-note-value!
  [_ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [name-id : i64]) : unit
  (if import-unqualified
    (let
      [key-id : i64 (tc-unqualified-import-key-id importer-module-id name-id)]
      [source-id : i64 source-module-id]
      [binding-id : i64 (tc-module-name-id-by-id alias-id name-id)]
      [owner-id : i64
        (sym_i64_env.sym-i64-lookup-id-or
          tc-unqualified-import-owner-modules
          key-id
          (compiler-symbols-missing-handle))]
      (if (compiler-symbols-handle-found? owner-id)
        (if (= owner-id source-id)
          unit
          (if (sym_i64_env.sym-i64-contains-id
            tc-unqualified-import-ambiguous-first-modules
            key-id)
            unit
            (begin
              (set! tc-unqualified-import-has-ambiguity true)
              (set!
                tc-unqualified-import-ambiguous-first-modules
                (sym_i64_env.sym-i64-bind-id
                  tc-unqualified-import-ambiguous-first-modules
                  key-id
                  owner-id))
              (set!
                tc-unqualified-import-ambiguous-second-modules
                (sym_i64_env.sym-i64-bind-id
                  tc-unqualified-import-ambiguous-second-modules
                  key-id
                  source-id)))))
        (if (tc-name-bound-id-with-top-env-membership? env binding-id)
          unit
          (set!
            tc-unqualified-import-owner-modules
            (sym_i64_env.sym-i64-bind-id
              tc-unqualified-import-owner-modules
              key-id
              source-id)))))
    unit))

(define (tc-bind-import-alias-value-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [name-id : i64]
  [ty : AstType]) : TcTypeEnv
  (begin
    (tc-unqualified-import-note-value!
      ctx
      env
      alias-id
      importer-module-id
      source-module-id
      import-unqualified
      name-id)
    (tc-bind-id env (tc-module-name-id-by-id alias-id name-id) ty)))

(define (tc-bind-import-alias-value-unsafe-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [name-id : i64]
  [ty : AstType]) : TcTypeEnv
  (begin
    (tc-unqualified-import-note-value!
      ctx
      env
      alias-id
      importer-module-id
      source-module-id
      import-unqualified
      name-id)
    (tc-bind-unsafe-id env (tc-module-name-id-by-id alias-id name-id) ty)))

(define (tc-bind-import-alias-value-c-abi-fnptr-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [name-id : i64]
  [ty : AstType]) : TcTypeEnv
  (begin
    (tc-unqualified-import-note-value!
      ctx
      env
      alias-id
      importer-module-id
      source-module-id
      import-unqualified
      name-id)
    (tc-bind-c-abi-fnptr-id env (tc-module-name-id-by-id alias-id name-id) ty)))

(define (tc-bind-import-alias-value-unsafe-c-abi-fnptr-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [name-id : i64]
  [ty : AstType]) : TcTypeEnv
  (begin
    (tc-unqualified-import-note-value!
      ctx
      env
      alias-id
      importer-module-id
      source-module-id
      import-unqualified
      name-id)
    (tc-bind-unsafe-c-abi-fnptr-id
      env
      (tc-module-name-id-by-id alias-id name-id)
      ty)))

(define (tc-struct-cleanup-function-type [struct-ty : AstType]) : AstType
  (tc-fn1 struct-ty (AstType.Unit)))

(define (tc-enum-cleanup-function-type [enum-ty : AstType]) : AstType
  (tc-fn1 enum-ty (AstType.Unit)))

(define (tc-bind-struct-cleanup-module-id
  [env : TcTypeEnv]
  [module-id : i64]
  [cleanup : AstStructCleanup]
  [struct-ty : AstType]) : TcTypeEnv
  (match cleanup
    [(AstStructCleanup.No) env]
    [(AstStructCleanup.Fn cleanup-name)
      (tc-bind-id
        env
        (tc-module-name-id-by-id module-id cleanup-name)
        (tc-struct-cleanup-function-type struct-ty))]))

(define (tc-bind-enum-cleanup-module-id
  [env : TcTypeEnv]
  [module-id : i64]
  [cleanup : AstEnumCleanup]
  [enum-ty : AstType]) : TcTypeEnv
  (match cleanup
    [(AstEnumCleanup.No) env]
    [(AstEnumCleanup.Fn cleanup-name)
      (tc-bind-id
        env
        (tc-module-name-id-by-id module-id cleanup-name)
        (tc-enum-cleanup-function-type enum-ty))]))

(define (tc-bind-struct-cleanup-local
  [env : TcTypeEnv]
  [cleanup : AstStructCleanup]
  [struct-ty : AstType]) : TcTypeEnv
  (match cleanup
    [(AstStructCleanup.No) env]
    [(AstStructCleanup.Fn cleanup-name)
      (tc-bind-id env cleanup-name (tc-struct-cleanup-function-type struct-ty))]))

(define (tc-bind-enum-cleanup-local
  [env : TcTypeEnv]
  [cleanup : AstEnumCleanup]
  [enum-ty : AstType]) : TcTypeEnv
  (match cleanup
    [(AstEnumCleanup.No) env]
    [(AstEnumCleanup.Fn cleanup-name)
      (tc-bind-id env cleanup-name (tc-enum-cleanup-function-type enum-ty))]))

(define (tc-bind-struct-cleanup-import-alias
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [cleanup : AstStructCleanup]
  [struct-ty : AstType]) : TcTypeEnv
  (match cleanup
    [(AstStructCleanup.No) env]
    [(AstStructCleanup.Fn cleanup-name)
      (tc-bind-import-alias-value-id
        ctx
        env
        alias-id
        importer-module-id
        source-module-id
        import-unqualified
        cleanup-name
        (tc-struct-cleanup-function-type struct-ty))]))

(define (tc-bind-enum-cleanup-import-alias
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [cleanup : AstEnumCleanup]
  [enum-ty : AstType]) : TcTypeEnv
  (match cleanup
    [(AstEnumCleanup.No) env]
    [(AstEnumCleanup.Fn cleanup-name)
      (tc-bind-import-alias-value-id
        ctx
        env
        alias-id
        importer-module-id
        source-module-id
        import-unqualified
        cleanup-name
        (tc-enum-cleanup-function-type enum-ty))]))

(define (tc-default-boundary-id) : i64
  cbi.compiler-builtin-id-tc-default-boundary)

(define (tc-region-marker-id) : i64
  cbi.compiler-builtin-id-tc-active-region)

(define (tc-cleanup-owner-marker-id) : i64
  cbi.compiler-builtin-id-tc-cleanup-owner)

(define (tc-ordinary-arena-owner-marker-id) : i64
  cbi.compiler-builtin-id-tc-ordinary-arena-owner)

(define (tc-atomic-arena-owner-marker-id) : i64
  cbi.compiler-builtin-id-tc-atomic-arena-owner)

(define (tc-return-type-id) : i64
  cbi.compiler-builtin-id-tc-return-type)

(define (tc-loop-target-id) : i64
  cbi.compiler-builtin-id-tc-loop-target)

(define (tc-hygiene-global-boundary-id) : i64
  cbi.compiler-builtin-id-tc-hygiene-global-boundary)

(define (tc-hygiene-template-prefix) : String
  "__tl_macro_template$")

(define (tc-hygiene-global-prefix) : String
  "__tl_macro_global$")

(define (tc-hygiene-local-prefix) : String
  "__tl_macro_local$")

(defenum TcHygieneGlobalName
  (Legacy String)
  (Context String String))

(define tc-hygiene-active-top-env-ready : bool
  false)

(define (tc-empty-type-env) : TcTypeEnv
  TcTypeEnv.Nil)

(define (tc-empty-module-local-env-cache) : TcModuleLocalEnvCache
  TcModuleLocalEnvCache.Nil)

(define tc-hygiene-active-top-env : TcTypeEnv
  (tc-empty-type-env))
(define tc-hygiene-module-env-cache : TcModuleLocalEnvCache
  (tc-empty-module-local-env-cache))

;; Arena that owns the module-local env cache chain. The cache lives in
;; the GLOBAL above, but hygiene lookups fire deep inside per-decl typechecking
;; whose allocations land in scratch arenas; the cache's (box ...) cells and
;; cached env internals would dangle once the scratch arena is reclaimed. Build
;; cache entries inside this dedicated persistent arena (same idiom as the node
;; pools' base arena). Module identity itself is the stable intern ID.
(define tc-hygiene-module-env-cache-arena : i64
  0)

(define (tc-hygiene-module-env-cache-arena-handle) : i64
  (begin
    (if (= tc-hygiene-module-env-cache-arena 0)
      (set! tc-hygiene-module-env-cache-arena (arena.tl_arena_make))
      unit)
    tc-hygiene-module-env-cache-arena))

(define (tc-hygiene-string-prefix? [text : String] [prefix : String]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [prefix-len : i64 (string.string-length prefix)]
    [text-data : (Ptr u8)
      (unsafe
        (string-data (& text)))]
    [prefix-data : (Ptr u8)
      (unsafe
        (string-data (& prefix)))]
    [i : i64 0]
    [word-end : i64 (- prefix-len 7)]
    (if (< text-len prefix-len)
      false
      (begin
        (while (< i word-end)
          (if (=
            (unsafe
              (ptr-read (ptr-cast (ptr-offset text-data i) : (Ptr i64))))
            (unsafe
              (ptr-read (ptr-cast (ptr-offset prefix-data i) : (Ptr i64)))))
            (set! i (+ i 8))
            (return false)))
        (while (< i prefix-len)
          (if (=
            (unsafe
              (ptr-read (ptr-offset text-data i)))
            (unsafe
              (ptr-read (ptr-offset prefix-data i))))
            (set! i (+ i 1))
            (return false)))
        true))))

(define (tc-hygiene-name-base [name : String] [prefix : String]) : String
  (string.substring
    name
    (string.string-length prefix)
    (- (string.string-length name) (string.string-length prefix))))

(define (tc-hygiene-template-name? [name : String]) : bool
  (tc-hygiene-string-prefix? name (tc-hygiene-template-prefix)))

(define (tc-hygiene-template-name-id? [name-id : i64]) : bool
  (or
    (ci.intern-template-source-id? name-id)
    (and
      (>= name-id 0)
      (< name-id (intern-capacity))
      (tc-hygiene-template-name? (intern-str name-id)))))

(define (tc-hygiene-template-source-id-or [name-id : i64] [fallback : i64]) : i64
  (if (ci.intern-template-source-id? name-id)
    (ci.intern-template-source-name-id name-id)
    fallback))

(define (tc-hygiene-template-base [name : String]) : String
  (tc-hygiene-name-base name (tc-hygiene-template-prefix)))

(define (tc-hygiene-global-name? [name : String]) : bool
  (tc-hygiene-string-prefix? name (tc-hygiene-global-prefix)))

(define (tc-hygiene-local-name? [name : String]) : bool
  (tc-hygiene-string-prefix? name (tc-hygiene-local-prefix)))

(define (tc-hygiene-global-name-id? [name-id : i64]) : bool
  (or
    (macro-hygiene-global-id? name-id)
    (and
      (>= name-id 0)
      (< name-id (intern-capacity))
      (tc-hygiene-global-name? (intern-str name-id)))))

(define (tc-structural-local-name-id? [name-id : i64]) : bool
  (if (< name-id (intern-capacity))
    false
    (or
      (macro-hygiene-local-id? name-id)
      (ci.intern-structural-local-id? name-id))))

(define (tc-hygiene-local-name-id? [name-id : i64]) : bool
  (or
    (tc-structural-local-name-id? name-id)
    (and
      (>= name-id 0)
      (< name-id (intern-capacity))
      (tc-hygiene-local-name? (intern-str name-id)))))

(define (tc-hygiene-name-text-id [name-id : i64]) : String
  (cond
    [(and (>= name-id 0) (< name-id (intern-capacity))) (intern-str name-id)]
    [(ci.intern-structural-local-id? name-id)
      (intern-str (ci.intern-structural-local-source-name-id name-id))]
    [(or (macro-hygiene-global-id? name-id) (macro-hygiene-local-id? name-id))
      (intern-str (macro-hygiene-structural-source-name-id name-id))]
    [(or
        (compiler-composite-pair-key-id? name-id)
        (compiler-composite-triple-key-id? name-id))
      (ast-nominal-name-id-display name-id)]
    [else (intern-str name-id)]))

(define (tc-hygiene-global-base [name : String]) : String
  (tc-hygiene-name-base name (tc-hygiene-global-prefix)))

(define (tc-hygiene-global-name [name : String]) : String
  (string.append (tc-hygiene-global-prefix) name))

(define (tc-hygiene-global-context-name [module : String] [name : String]) : String
  (tc-hygiene-global-name (str_cat.str-cat module "|" name)))

(define (tc-hygiene-context-separator-index [payload : String]) : i64
  (let
    [i : i64 0]
    [n : i64 (string.string-length payload)]
    [found : i64 -1]
    (begin
      (while (and (< i n) (< found 0))
        (if (= (cast (string.string-ref payload i) : i64) 124)
          (set! found i)
          (set! i (+ i 1))))
      found)))

(define (tc-hygiene-global-decode [name : String]) : TcHygieneGlobalName
  (let
    [payload : String (tc-hygiene-global-base name)]
    [sep : i64 (tc-hygiene-context-separator-index payload)]
    (if (< sep 0)
      (TcHygieneGlobalName.Legacy payload)
      (let
        [start : i64 (+ sep 1)]
        (TcHygieneGlobalName.Context
          (string.substring payload 0 sep)
          (string.substring
            payload
            start
            (- (string.string-length payload) start)))))))

(define (tc-hygiene-global-call-name [name : String]) : String
  (if (tc-hygiene-global-name? name)
    (match (tc-hygiene-global-decode name)
      [(TcHygieneGlobalName.Legacy lookup-name) lookup-name]
      [(TcHygieneGlobalName.Context _ lookup-name) lookup-name])
    name))

(define (tc-hygiene-global-symbol-name [name : String]) : String
  (if (tc-hygiene-global-name? name)
    (match (tc-hygiene-global-decode name)
      [(TcHygieneGlobalName.Legacy lookup-name) lookup-name]
      [(TcHygieneGlobalName.Context module lookup-name)
        (if (tc-name-qualified? lookup-name)
          lookup-name
          (compiler-symbol-module-key module lookup-name))])
    name))

(define (tc-hygiene-global-env [top-env : TcTypeEnv]) : TcTypeEnv
  (tc-bind-id top-env (tc-hygiene-global-boundary-id) (AstType.Unit)))

(define (tc-hygiene-reset-active-top-env! [top-env : TcTypeEnv]) : unit
  (begin
    (set! tc-hygiene-active-top-env top-env)
    (set! tc-hygiene-active-top-env-ready true)
    (set! tc-hygiene-module-env-cache (tc-empty-module-local-env-cache))
    ;; Release the persistent cache arena with the chain it owns; the
    ;; next cache miss creates a fresh one (keeps batch compiles from leaking
    ;; one arena's worth of dead cache entries per program).
    (if (= tc-hygiene-module-env-cache-arena 0)
      unit
      (begin
        (unsafe
          (arena.tl_arena_destroy tc-hygiene-module-env-cache-arena))
        (set! tc-hygiene-module-env-cache-arena 0)))))

(define (tc-unsafe-marker-id) : i64
  cbi.compiler-builtin-id-tc-unsafe-context)

(define (tc-enter-unsafe [env : TcTypeEnv]) : TcTypeEnv
  (tc-bind-runtime-marker-id
    env
    (tc-unsafe-marker-id)
    (AstType.Unit)
    TcTypeEnvScopedMarkerKind.UnsafeContext))

(define (tc-env-marker-type-scan [env : TcTypeEnv] [name-id : i64]) : AstMaybeType
  (match env
    [(TcTypeEnv.Nil) (AstMaybeType.No)]
    [(TcTypeEnv.Cache ids values _ _ _ scan-through partial _ below)
      (if scan-through
        (match (tc_i64_i64_map.get (& ids) name-id)
          [(tc_i64_i64_map.LookupFound index)
            (AstMaybeType.Some (array-ref values index))]
          [(tc_i64_i64_map.LookupMissing)
            (if partial
              (tc-env-marker-type-scan (box-get below) name-id)
              (AstMaybeType.No))])
        (AstMaybeType.No))]
    [(TcTypeEnv.Bind key ty rest)
      (if (= key name-id)
        (AstMaybeType.Some ty)
        (tc-env-marker-type-scan (box-get rest) name-id))]))

(define (tc-env-marker-type [env : TcTypeEnv] [name-id : i64]) : AstMaybeType
  (match env
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-env-marker-type-scan env name-id)
        (tc-env-marker-type-scan (box-get rest) name-id))]
    [_ (tc-env-marker-type-scan env name-id)]))

(define (tc-in-unsafe? [env : TcTypeEnv]) : bool
  (if tc-type-env-scoped-runtime-active
    (tc-type-env-scoped-carrier-in-unsafe? (tc-type-env-scoped-runtime-current))
    (begin
      (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
      (match (tc-env-marker-type env (tc-unsafe-marker-id))
        [(AstMaybeType.Some _) true]
        [(AstMaybeType.No) false]))))

(define tc-unused-unsafe-tracking-enabled : bool
  false)
(define tc-unused-unsafe-current-block : i64
  -1)
(define tc-unused-unsafe-current-path : String
  "")
(define tc-unused-unsafe-target-path : String
  "")
(define tc-unused-unsafe-block-spans : (Array AstSourceSpan)
  (array.make-array AstSourceSpan 128))
(define tc-unused-unsafe-block-paths : (Array String)
  (array.make-array String 128))
(define tc-unused-unsafe-block-used : (Array bool)
  (array.make-array bool 128))
(define tc-unused-unsafe-block-len : i64
  0)

(define (tc-unused-unsafe-no-span) : AstSourceSpan
  (ast-source-span 0 0 0 0))

(define (tc-unused-unsafe-tracking-reset! [path : String]) : unit
  (begin
    (set! tc-unused-unsafe-current-block -1)
    (set! tc-unused-unsafe-current-path "")
    (set! tc-unused-unsafe-target-path path)
    (set! tc-unused-unsafe-block-len 0)
    (set! tc-unused-unsafe-tracking-enabled true)))

(define (tc-unused-unsafe-tracking-disable!) : unit
  (begin
    (set! tc-unused-unsafe-tracking-enabled false)
    (set! tc-unused-unsafe-current-block -1)
    (set! tc-unused-unsafe-current-path "")
    (set! tc-unused-unsafe-target-path "")))

(define (tc-unused-unsafe-tracking-clear!) : unit
  (begin
    (tc-unused-unsafe-tracking-disable!)
    (set! tc-unused-unsafe-block-spans (array.make-array AstSourceSpan 128))
    (set! tc-unused-unsafe-block-paths (array.make-array String 128))
    (set! tc-unused-unsafe-block-used (array.make-array bool 128))
    (set! tc-unused-unsafe-block-len 0)))

(define (tc-unused-unsafe-block-count) : i64
  tc-unused-unsafe-block-len)

(define (tc-unused-unsafe-block-path [index : i64]) : String
  (if (and (>= index 0) (< index tc-unused-unsafe-block-len))
    (array-ref tc-unused-unsafe-block-paths index)
    ""))

(define (tc-unused-unsafe-block-span [index : i64]) : AstSourceSpan
  (if (and (>= index 0) (< index tc-unused-unsafe-block-len))
    (array-ref tc-unused-unsafe-block-spans index)
    (tc-unused-unsafe-no-span)))

(define (tc-unused-unsafe-block-used? [index : i64]) : bool
  (if (and (>= index 0) (< index tc-unused-unsafe-block-len))
    (array-ref tc-unused-unsafe-block-used index)
    false))

(define (tc-unused-unsafe-set-current-path! [path : String]) : String
  (let
    [prev : String tc-unused-unsafe-current-path]
    (begin
      (if tc-unused-unsafe-tracking-enabled
        (set! tc-unused-unsafe-current-path path)
        unit)
      prev)))

(define (tc-unused-unsafe-restore-current-path! [path : String]) : unit
  (if tc-unused-unsafe-tracking-enabled
    (set! tc-unused-unsafe-current-path path)
    unit))

(define (tc-unused-unsafe-span-eq? [a : AstSourceSpan] [b : AstSourceSpan]) : bool
  (and
    (= (ast-source-span-start-line a) (ast-source-span-start-line b))
    (= (ast-source-span-start-col a) (ast-source-span-start-col b))
    (= (ast-source-span-end-line a) (ast-source-span-end-line b))
    (= (ast-source-span-end-col a) (ast-source-span-end-col b))))

(define (tc-unused-unsafe-find-existing
  [path : String]
  [span : AstSourceSpan]
  [index : i64]) : i64
  (if (>= index tc-unused-unsafe-block-len)
    -1
    (if (and
      (string.eq (array-ref tc-unused-unsafe-block-paths index) path)
      (tc-unused-unsafe-span-eq?
        (array-ref tc-unused-unsafe-block-spans index)
        span))
      index
      (tc-unused-unsafe-find-existing path span (+ index 1)))))

(define (tc-unused-unsafe-grow-copy
  [new-spans : (Array AstSourceSpan)]
  [new-paths : (Array String)]
  [new-used : (Array bool)]
  [index : i64]) : unit
  (if (>= index tc-unused-unsafe-block-len)
    unit
    (begin
      (array-set!
        new-spans
        index
        (array-ref tc-unused-unsafe-block-spans index))
      (array-set!
        new-paths
        index
        (array-ref tc-unused-unsafe-block-paths index))
      (array-set! new-used index (array-ref tc-unused-unsafe-block-used index))
      (tc-unused-unsafe-grow-copy new-spans new-paths new-used (+ index 1)))))

(define (tc-unused-unsafe-grow!) : unit
  (let
    [old-cap : i64 (array.length tc-unused-unsafe-block-spans)]
    [new-cap : i64 (* old-cap 2)]
    [new-spans : (Array AstSourceSpan) (array.make-array AstSourceSpan new-cap)]
    [new-paths : (Array String) (array.make-array String new-cap)]
    [new-used : (Array bool) (array.make-array bool new-cap)]
    (begin
      (tc-unused-unsafe-grow-copy new-spans new-paths new-used 0)
      (set! tc-unused-unsafe-block-spans new-spans)
      (set! tc-unused-unsafe-block-paths new-paths)
      (set! tc-unused-unsafe-block-used new-used))))

(define (tc-unused-unsafe-push [span : AstSourceSpan]) : i64
  (let
    [existing : i64
      (tc-unused-unsafe-find-existing tc-unused-unsafe-current-path span 0)]
    (if (>= existing 0)
      existing
      (let
        [slot : i64 tc-unused-unsafe-block-len]
        (begin
          (if (>= slot (array.length tc-unused-unsafe-block-spans))
            (tc-unused-unsafe-grow!)
            unit)
          (array-set! tc-unused-unsafe-block-spans slot span)
          (array-set!
            tc-unused-unsafe-block-paths
            slot
            tc-unused-unsafe-current-path)
          (array-set! tc-unused-unsafe-block-used slot false)
          (set! tc-unused-unsafe-block-len (+ tc-unused-unsafe-block-len 1))
          slot)))))

(define (tc-unused-unsafe-enter-block [span : TcMaybeAstSourceSpan]) : i64
  (let
    [prev : i64 tc-unused-unsafe-current-block]
    (begin
      (if tc-unused-unsafe-tracking-enabled
        (if (string.eq
          tc-unused-unsafe-current-path
          tc-unused-unsafe-target-path)
          (match span
            [(TcMaybeAstSourceSpan.Some real-span)
              (set!
                tc-unused-unsafe-current-block
                (tc-unused-unsafe-push real-span))]
            [(TcMaybeAstSourceSpan.No) unit])
          unit)
        unit)
      prev)))

(define (tc-unused-unsafe-restore-block! [prev : i64]) : unit
  (if tc-unused-unsafe-tracking-enabled
    (set! tc-unused-unsafe-current-block prev)
    unit))

(define (tc-unused-unsafe-mark-current-used!) : unit
  (if (and
    tc-unused-unsafe-tracking-enabled
    (>= tc-unused-unsafe-current-block 0)
    (< tc-unused-unsafe-current-block tc-unused-unsafe-block-len))
    (array-set! tc-unused-unsafe-block-used tc-unused-unsafe-current-block true)
    unit))

(define (tc-unsafe-begin-list-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [expected : AstType]
  [span : TcMaybeAstSourceSpan]) : ResultTcType
  (let
    [prev : i64 (tc-unused-unsafe-enter-block span)]
    [result : ResultTcType
      (tc-begin-list-with-expected ctx (tc-enter-unsafe env) exprs expected)]
    (begin
      (tc-unused-unsafe-restore-block! prev)
      result)))

(define (tc-unsafe-begin-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [span : TcMaybeAstSourceSpan]) : ResultTcType
  (let
    [prev : i64 (tc-unused-unsafe-enter-block span)]
    [result : ResultTcType (tc-begin-list ctx (tc-enter-unsafe env) exprs)]
    (begin
      (tc-unused-unsafe-restore-block! prev)
      result)))

(define (tc-bind-return-type [env : TcTypeEnv] [ty : AstType]) : TcTypeEnv
  (tc-bind-runtime-marker-id
    env
    (tc-return-type-id)
    ty
    TcTypeEnvScopedMarkerKind.Other))

(define (tc-current-return-type [env : TcTypeEnv]) : ResultTcType
  (if tc-type-env-scoped-runtime-active
    (tc-type-env-scoped-carrier-current-return-type
      (tc-type-env-scoped-runtime-current))
    (begin
      (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
      (match (tc-env-marker-type env (tc-return-type-id))
        [(AstMaybeType.Some ty) (ResultTcType.Ok ty)]
        [(AstMaybeType.No)
          (ResultTcType.Err
            "typecheck: try requires enclosing Result-like function")]))))

(define (tc-enter-loop-target [env : TcTypeEnv]) : TcTypeEnv
  (tc-bind-runtime-marker-id
    env
    (tc-loop-target-id)
    (AstType.Unit)
    TcTypeEnvScopedMarkerKind.Other))

(define (tc-clear-loop-target [env : TcTypeEnv]) : TcTypeEnv
  (tc-bind-runtime-marker-id
    env
    (tc-loop-target-id)
    (AstType.Never)
    TcTypeEnvScopedMarkerKind.Other))

(define (tc-in-loop-target? [env : TcTypeEnv]) : bool
  (match (tc-env-marker-type env (tc-loop-target-id))
    [(AstMaybeType.Some ty) (not (tc-never-type? ty))]
    [(AstMaybeType.No) false]))

(define (tc-loop-control-expr [env : TcTypeEnv] [form : String]) : ResultTcType
  (if (tc-in-loop-target? env)
    (ResultTcType.Ok (AstType.Never))
    (ResultTcType.Err
      (string.append
        "typecheck: "
        (string.append form " requires enclosing scalar while")))))

(define (tc-type-list1 [a : AstType]) : AstTypeList
  (ast-type-cons a (ast-type-list-new)))

(define (tc-type-list2 [a : AstType] [b : AstType]) : AstTypeList
  (ast-type-cons a (ast-type-cons b (ast-type-list-new))))

(define (tc-type-list3 [a : AstType] [b : AstType] [c : AstType]) : AstTypeList
  (ast-type-cons a (ast-type-cons b (ast-type-cons c (ast-type-list-new)))))

(define (tc-fn0 [ret : AstType]) : AstType
  (ast-ty-func (ast-type-list-new) ret))

(define (tc-fn1 [a : AstType] [ret : AstType]) : AstType
  (ast-ty-func (tc-type-list1 a) ret))

(define (tc-fn2 [a : AstType] [b : AstType] [ret : AstType]) : AstType
  (ast-ty-func (tc-type-list2 a b) ret))

(define (tc-fn3 [a : AstType] [b : AstType] [c : AstType] [ret : AstType]) : AstType
  (ast-ty-func (tc-type-list3 a b c) ret))

(define (tc-fn4
  [a : AstType]
  [b : AstType]
  [c : AstType]
  [d : AstType]
  [ret : AstType]) : AstType
  (ast-ty-func
    (ast-type-cons
      a
      (ast-type-cons b (ast-type-cons c (ast-type-cons d (ast-type-list-new)))))
    ret))

(define (tc-type-list-render [types : AstTypeList]) : String
  (tc-type-list-render-at (& types) 0))

(define (tc-type-list-render-at [types : (& types AstTypeList)] [index : i64]) : String
  (if (>= index (ast-type-list-len types))
    ""
    (let
      [head : AstType
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))]
      (str_cat.str-cat
        (tc-type-render head)
        (if (>= (+ index 1) (ast-type-list-len types))
          ""
          (str_cat.str-cat " " (tc-type-list-render-at types (+ index 1))))))))

(define (tc-lifetime-list-render [lifetimes : AstLifetimeList]) : String
  (tc-lifetime-list-render-at (& lifetimes) 0))

(define (tc-lifetime-list-render-at
  [lifetimes : (& lifetimes AstLifetimeList)]
  [index : i64]) : String
  (if (>= index (ast-lifetime-list-len lifetimes))
    ""
    (let
      [head : i64
        (ast-lifetime-list-get lifetimes index (ast-lifetime-fallback))]
      (str_cat.str-cat
        (intern-str head)
        (if (>= (+ index 1) (ast-lifetime-list-len lifetimes))
          ""
          (str_cat.str-cat
            " "
            (tc-lifetime-list-render-at lifetimes (+ index 1))))))))

(define (tc-render-nominal-lifetime-type
  [name : String]
  [lifetimes : AstLifetimeList]) : String
  (str_cat.str-cat "(" name " " (tc-lifetime-list-render lifetimes) ")"))

(define (tc-elided-lifetime-name-prefix) : String
  "\n__typelisp_signature_elided_lifetime_")

(define (tc-elaborated-lifetime-hidden? [name : i64]) : bool
  (or
    (= name cbi.compiler-builtin-id-fix-empty)
    (tc-diag-string-prefix? (intern-str name) (tc-elided-lifetime-name-prefix))))

(define (tc-type-render [ty : AstType]) : String
  (match ty
    [(AstType.I64) "i64"]
    [(AstType.I32) "i32"]
    [(AstType.I16) "i16"]
    [(AstType.I8) "i8"]
    [(AstType.U64) "u64"]
    [(AstType.U32) "u32"]
    [(AstType.U16) "u16"]
    [(AstType.U8) "u8"]
    [(AstType.F64) "f64"]
    [(AstType.F32) "f32"]
    [(AstType.Bool) "bool"]
    [(AstType.Char) "char"]
    [(AstType.String) "String"]
    [(AstType.Str) "str"]
    [(AstType.Bytes) "bytes"]
    [(AstType.Unit) "unit"]
    [(AstType.Never) "never"]
    [(AstType.Expr) "Expr"]
    [(AstType.ExprList) "ExprList"]
    [(AstType.Func args ret)
      (str_cat.str-cat
        "(-> "
        (tc-type-list-render (box-get args))
        " "
        (tc-type-render (ty-node-get ret))
        ")")]
    [(AstType.Tuple elems)
      (str_cat.str-cat "(Tuple " (tc-type-list-render (box-get elems)) ")")]
    [(AstType.Array elem count)
      (str_cat.str-cat
        "(Array "
        (tc-type-render (ty-node-get elem))
        " "
        (string.int->string count)
        ")")]
    [(AstType.DynArray elem)
      (str_cat.str-cat "(Array " (tc-type-render (ty-node-get elem)) ")")]
    [(AstType.Box elem)
      (str_cat.str-cat "(Box " (tc-type-render (ty-node-get elem)) ")")]
    [(AstType.Ptr elem)
      (str_cat.str-cat "(Ptr " (tc-type-render (ty-node-get elem)) ")")]
    [(AstType.MutPtr elem)
      (str_cat.str-cat "(MutPtr " (tc-type-render (ty-node-get elem)) ")")]
    [(AstType.Ref region inner)
      (if (tc-elaborated-lifetime-hidden? region)
        (str_cat.str-cat "(& " (tc-type-render (ty-node-get inner)) ")")
        (str_cat.str-cat
          "(& "
          (intern-str region)
          " "
          (tc-type-render (ty-node-get inner))
          ")"))]
    [(AstType.MutRef region inner)
      (if (tc-elaborated-lifetime-hidden? region)
        (str_cat.str-cat "(&mut " (tc-type-render (ty-node-get inner)) ")")
        (str_cat.str-cat
          "(&mut "
          (intern-str region)
          " "
          (tc-type-render (ty-node-get inner))
          ")"))]
    [(AstType.Region region inner)
      (str_cat.str-cat
        "(Region "
        (intern-str region)
        " "
        (tc-type-render (ty-node-get inner))
        ")")]
    [(AstType.Enum name) (tc-nominal-name-id-display name)]
    [(AstType.EnumArgs name lifetimes)
      (tc-render-nominal-lifetime-type
        (tc-nominal-name-id-display name)
        (box-get lifetimes))]
    [(AstType.Struct name) (tc-nominal-name-id-display name)]
    [(AstType.StructArgs name lifetimes)
      (tc-render-nominal-lifetime-type
        (tc-nominal-name-id-display name)
        (box-get lifetimes))]
    [(AstType.Var name) (tc-nominal-name-id-display name)]
    [(AstType.VarArgs name lifetimes)
      (tc-render-nominal-lifetime-type
        (tc-nominal-name-id-display name)
        (box-get lifetimes))]
    [(AstType.Consume inner)
      (str_cat.str-cat "(:consume " (tc-type-render (ty-node-get inner)) ")")]))

(define (tc-type-mismatch-message
  [actual : AstType]
  [expected : AstType]
  [message : String]) : String
  (str_cat.str-cat
    message
    ": expected "
    (tc-type-render (tc-type-without-regions expected))
    ", found "
    (tc-type-render (tc-type-without-regions actual))))

(define (tc-default-env) : TcTypeEnv
  (tc-bind-id (tc-default-env-base) (tc-default-boundary-id) (AstType.Unit)))

(define (tc-default-env-base) : TcTypeEnv
  (let
    [e0 : TcTypeEnv (tc-empty-env)]
    [e1 : TcTypeEnv
      (tc-bind-id
        e0
        cbi.compiler-builtin-id-cpuid
        (tc-fn2
          (AstType.I64)
          (AstType.I64)
          (ast-ty-tuple
            (ast-type-cons
              (AstType.I32)
              (ast-type-cons
                (AstType.I32)
                (ast-type-cons
                  (AstType.I32)
                  (ast-type-cons (AstType.I32) (ast-type-list-new))))))))]
    [e2 : TcTypeEnv
      (tc-bind-id
        e1
        cbi.compiler-builtin-id-xgetbv
        (tc-fn1 (AstType.I64) (AstType.I64)))]
    (tc-bind-id e2 (tc-default-boundary-id) (AstType.Unit))))

(define (tc-macro-expr-clause-type) : AstType
  (AstType.Var cbi.compiler-builtin-id-fix-ExprClause))

(define (tc-macro-expr-clause-list-type) : AstType
  (AstType.Var cbi.compiler-builtin-id-fix-ExprClauseList))

(define (tc-macro-expr-binding-clause-type) : AstType
  (AstType.Var cbi.compiler-builtin-id-fix-ExprBindingClause))

(define (tc-macro-expr-binding-clause-list-type) : AstType
  (AstType.Var cbi.compiler-builtin-id-fix-ExprBindingClauseList))

(define (tc-macro-pattern-type) : AstType
  (AstType.Var cbi.compiler-builtin-id-fix-Pattern))

(define (tc-macro-pattern-list-type) : AstType
  (AstType.Var cbi.compiler-builtin-id-fix-PatternList))

(define (tc-macro-match-arm-type) : AstType
  (AstType.Var cbi.compiler-builtin-id-fix-MatchArm))

(define (tc-macro-match-arm-list-type) : AstType
  (AstType.Var cbi.compiler-builtin-id-fix-MatchArmList))

(define (tc-macro-expr-clause-type? [ty : AstType]) : bool
  (match ty
    [(AstType.Var name)
      (or
        (= name cbi.compiler-builtin-id-fix-ExprClause)
        (=
          name
          cbi.compiler-builtin-id-fix-stdlib_dot_comptime_slash_ExprClause))]
    [_ false]))

(define (tc-macro-expr-clause-list-type? [ty : AstType]) : bool
  (match ty
    [(AstType.Var name)
      (or
        (= name cbi.compiler-builtin-id-fix-ExprClauseList)
        (=
          name
          cbi.compiler-builtin-id-fix-stdlib_dot_comptime_slash_ExprClauseList))]
    [_ false]))

(define (tc-macro-expr-binding-clause-type? [ty : AstType]) : bool
  (match ty
    [(AstType.Var name)
      (or
        (= name cbi.compiler-builtin-id-fix-ExprBindingClause)
        (=
          name
          cbi.compiler-builtin-id-fix-stdlib_dot_comptime_slash_ExprBindingClause))]
    [_ false]))

(define (tc-macro-expr-binding-clause-list-type? [ty : AstType]) : bool
  (match ty
    [(AstType.Var name)
      (or
        (= name cbi.compiler-builtin-id-fix-ExprBindingClauseList)
        (=
          name
          cbi.compiler-builtin-id-fix-stdlib_dot_comptime_slash_ExprBindingClauseList))]
    [_ false]))

(define (tc-macro-type-param-kind? [ty : AstType]) : bool
  (match ty
    [(AstType.Var name) (= name cbi.compiler-builtin-id-fix-type)]
    [_ false]))

(define (tc-macro-module-param-kind? [ty : AstType]) : bool
  (match ty
    [(AstType.Var name)
      (or
        (= name cbi.compiler-builtin-id-fix-Module)
        (= name cbi.compiler-builtin-id-fix-module))]
    [_ false]))

(define (tc-type-unquote-marker? [ty : AstType]) : bool
  (match ty
    [(AstType.VarArgs name _) (= name cbi.compiler-builtin-id-fix-unquote)]
    [_ false]))

(define (tc-stdlib-comptime-module-name) : String
  "stdlib.comptime")

(define (tc-stdlib-comptime-type-key [name : String]) : String
  (compiler-symbol-module-key (tc-stdlib-comptime-module-name) name))

(define (tc-stdlib-comptime-type-key-id [_ : String] [name-id : i64]) : i64
  (tc-qualified-name-key-id
    cbi.compiler-builtin-id-fix-stdlib_dot_comptime
    name-id))

(define (tc-stdlib-comptime-type-display-name [name : String]) : String
  (str_cat.str-cat (tc-stdlib-comptime-module-name) "." name))

(define tc-stdlib-comptime-syntax-type-cache-generation : i64
  -1)
(define tc-stdlib-comptime-expr-key-id-cache : i64
  -1)
(define tc-stdlib-comptime-expr-list-key-id-cache : i64
  -1)
(define tc-stdlib-comptime-expr-clause-key-id-cache : i64
  -1)
(define tc-stdlib-comptime-expr-clause-list-key-id-cache : i64
  -1)
(define tc-stdlib-comptime-expr-binding-clause-key-id-cache : i64
  -1)
(define tc-stdlib-comptime-expr-binding-clause-list-key-id-cache : i64
  -1)
(define tc-stdlib-comptime-pattern-key-id-cache : i64
  -1)
(define tc-stdlib-comptime-pattern-list-key-id-cache : i64
  -1)
(define tc-stdlib-comptime-match-arm-key-id-cache : i64
  -1)
(define tc-stdlib-comptime-match-arm-list-key-id-cache : i64
  -1)

(define (tc-stdlib-comptime-syntax-type-cache-refresh!) : unit
  (begin
    (set!
      tc-stdlib-comptime-expr-key-id-cache
      (tc-stdlib-comptime-type-key-id "Expr" cbi.compiler-builtin-id-fix-Expr))
    (set!
      tc-stdlib-comptime-expr-list-key-id-cache
      (tc-stdlib-comptime-type-key-id
        "ExprList"
        cbi.compiler-builtin-id-fix-ExprList))
    (set!
      tc-stdlib-comptime-expr-clause-key-id-cache
      (tc-stdlib-comptime-type-key-id
        "ExprClause"
        cbi.compiler-builtin-id-fix-ExprClause))
    (set!
      tc-stdlib-comptime-expr-clause-list-key-id-cache
      (tc-stdlib-comptime-type-key-id
        "ExprClauseList"
        cbi.compiler-builtin-id-fix-ExprClauseList))
    (set!
      tc-stdlib-comptime-expr-binding-clause-key-id-cache
      (tc-stdlib-comptime-type-key-id
        "ExprBindingClause"
        cbi.compiler-builtin-id-fix-ExprBindingClause))
    (set!
      tc-stdlib-comptime-expr-binding-clause-list-key-id-cache
      (tc-stdlib-comptime-type-key-id
        "ExprBindingClauseList"
        cbi.compiler-builtin-id-fix-ExprBindingClauseList))
    (set!
      tc-stdlib-comptime-pattern-key-id-cache
      (tc-stdlib-comptime-type-key-id
        "Pattern"
        cbi.compiler-builtin-id-fix-Pattern))
    (set!
      tc-stdlib-comptime-pattern-list-key-id-cache
      (tc-stdlib-comptime-type-key-id
        "PatternList"
        cbi.compiler-builtin-id-fix-PatternList))
    (set!
      tc-stdlib-comptime-match-arm-key-id-cache
      (tc-stdlib-comptime-type-key-id
        "MatchArm"
        cbi.compiler-builtin-id-fix-MatchArm))
    (set!
      tc-stdlib-comptime-match-arm-list-key-id-cache
      (tc-stdlib-comptime-type-key-id
        "MatchArmList"
        cbi.compiler-builtin-id-fix-MatchArmList))
    (set! tc-stdlib-comptime-syntax-type-cache-generation (intern-generation))))

(define (tc-stdlib-comptime-syntax-type-cache-ensure!) : unit
  (begin
    (cbi.compiler-builtin-refresh!)
    (if (= tc-stdlib-comptime-syntax-type-cache-generation (intern-generation))
      unit
      (tc-stdlib-comptime-syntax-type-cache-refresh!))))

(define (tc-stdlib-comptime-syntax-type-id [canonical-id : i64]) : AstMaybeType
  (let
    [_ : unit (tc-stdlib-comptime-syntax-type-cache-ensure!)]
    (cond
      [(= canonical-id tc-stdlib-comptime-expr-key-id-cache)
        (AstMaybeType.Some (AstType.Expr))]
      [(= canonical-id tc-stdlib-comptime-expr-list-key-id-cache)
        (AstMaybeType.Some (AstType.ExprList))]
      [(= canonical-id tc-stdlib-comptime-expr-clause-key-id-cache)
        (AstMaybeType.Some (tc-macro-expr-clause-type))]
      [(= canonical-id tc-stdlib-comptime-expr-clause-list-key-id-cache)
        (AstMaybeType.Some (tc-macro-expr-clause-list-type))]
      [(= canonical-id tc-stdlib-comptime-expr-binding-clause-key-id-cache)
        (AstMaybeType.Some (tc-macro-expr-binding-clause-type))]
      [(= canonical-id tc-stdlib-comptime-expr-binding-clause-list-key-id-cache)
        (AstMaybeType.Some (tc-macro-expr-binding-clause-list-type))]
      [(= canonical-id tc-stdlib-comptime-pattern-key-id-cache)
        (AstMaybeType.Some (tc-macro-pattern-type))]
      [(= canonical-id tc-stdlib-comptime-pattern-list-key-id-cache)
        (AstMaybeType.Some (tc-macro-pattern-list-type))]
      [(= canonical-id tc-stdlib-comptime-match-arm-key-id-cache)
        (AstMaybeType.Some (tc-macro-match-arm-type))]
      [(= canonical-id tc-stdlib-comptime-match-arm-list-key-id-cache)
        (AstMaybeType.Some (tc-macro-match-arm-list-type))]
      [else (AstMaybeType.No)])))

(define (tc-stdlib-comptime-syntax-alias?
  [canonical-name : String]
  [type-name : String]) : bool
  (or
    (string.eq canonical-name type-name)
    (string.eq canonical-name (str_cat.str-cat "comptime." type-name))
    (string.eq
      canonical-name
      (str_cat.str-cat (tc-stdlib-comptime-module-name) "." type-name))
    (string.eq canonical-name (str_cat.str-cat "stdlib/comptime." type-name))
    (string.eq canonical-name (compiler-symbol-module-key "comptime" type-name))
    (string.eq
      canonical-name
      (compiler-symbol-module-key "stdlib/comptime" type-name))))

(define (tc-stdlib-comptime-syntax-alias-type [canonical-name : String]) : AstMaybeType
  (cond
    [(tc-stdlib-comptime-syntax-alias? canonical-name "Expr")
      (AstMaybeType.Some (AstType.Expr))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "ExprList")
      (AstMaybeType.Some (AstType.ExprList))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "ExprClause")
      (AstMaybeType.Some (tc-macro-expr-clause-type))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "ExprClauseList")
      (AstMaybeType.Some (tc-macro-expr-clause-list-type))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "ExprBindingClause")
      (AstMaybeType.Some (tc-macro-expr-binding-clause-type))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "ExprBindingClauseList")
      (AstMaybeType.Some (tc-macro-expr-binding-clause-list-type))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "Pattern")
      (AstMaybeType.Some (tc-macro-pattern-type))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "PatternList")
      (AstMaybeType.Some (tc-macro-pattern-list-type))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "MatchArm")
      (AstMaybeType.Some (tc-macro-match-arm-type))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "MatchArmList")
      (AstMaybeType.Some (tc-macro-match-arm-list-type))]
    [else (AstMaybeType.No)]))

(define (tc-macro-signature-stdlib-comptime-type-id [name : i64]) : AstMaybeType
  (match (tc-stdlib-comptime-syntax-type-id name)
    [(AstMaybeType.Some ty) (AstMaybeType.Some ty)]
    [(AstMaybeType.No)
      (tc-stdlib-comptime-syntax-alias-type (tc-env-key-name-text name))]))

(defenum TcStdlibTypeSpec
  (I64)
  (Bool)
  (String)
  (Name i64)
  (BoxName i64)
  (ArrayName i64))

(defenum TcStdlibTypeSpecList
  (Nil)
  (Cons TcStdlibTypeSpec (Box TcStdlibTypeSpecList)))

(defenum TcStdlibFieldSpecList
  (Nil)
  (Cons i64 TcStdlibTypeSpec (Box TcStdlibFieldSpecList)))

(defenum TcStdlibVariantSpecList
  (Nil)
  (Cons i64 TcStdlibTypeSpecList (Box TcStdlibVariantSpecList)))

(define (tc-stdlib-type-spec-list1 [a : TcStdlibTypeSpec]) : TcStdlibTypeSpecList
  (TcStdlibTypeSpecList.Cons a (box (TcStdlibTypeSpecList.Nil))))

(define (tc-stdlib-type-spec-list2
  [a : TcStdlibTypeSpec]
  [b : TcStdlibTypeSpec]) : TcStdlibTypeSpecList
  (TcStdlibTypeSpecList.Cons
    a
    (box (TcStdlibTypeSpecList.Cons b (box (TcStdlibTypeSpecList.Nil))))))

(define (tc-stdlib-type-spec-list3
  [a : TcStdlibTypeSpec]
  [b : TcStdlibTypeSpec]
  [c : TcStdlibTypeSpec]) : TcStdlibTypeSpecList
  (TcStdlibTypeSpecList.Cons
    a
    (box
      (TcStdlibTypeSpecList.Cons
        b
        (box (TcStdlibTypeSpecList.Cons c (box (TcStdlibTypeSpecList.Nil))))))))

(define (tc-stdlib-field-spec-cons
  [name : i64]
  [ty : TcStdlibTypeSpec]
  [rest : TcStdlibFieldSpecList]) : TcStdlibFieldSpecList
  (begin
    (cfg compile-profile (tc-lp-note 8))
    (TcStdlibFieldSpecList.Cons name ty (box rest))))

(define (tc-stdlib-variant-spec-cons
  [name : i64]
  [payloads : TcStdlibTypeSpecList]
  [rest : TcStdlibVariantSpecList]) : TcStdlibVariantSpecList
  (begin
    (cfg compile-profile (tc-lp-note 10))
    (TcStdlibVariantSpecList.Cons name payloads (box rest))))

(define (tc-stdlib-well-known-mismatch [type-name : String] [detail : String]) : ResultTcUnit
  (ResultTcUnit.Err
    (str_cat.str-cat
      "typecheck: stdlib well-known type mismatch for "
      (tc-stdlib-comptime-type-display-name type-name)
      ": "
      detail)))

(define (tc-stdlib-comptime-plain-declaration-message) : String
  "expected plain stdlib.comptime well-known declaration")

(define (tc-stdlib-comptime-well-known-type? [type-name : String]) : bool
  (or
    (string.eq type-name "Expr")
    (string.eq type-name "ExprList")
    (string.eq type-name "ExprClause")
    (string.eq type-name "ExprClauseList")
    (string.eq type-name "ExprBindingClause")
    (string.eq type-name "ExprBindingClauseList")
    (string.eq type-name "Pattern")
    (string.eq type-name "PatternList")
    (string.eq type-name "MatchArm")
    (string.eq type-name "MatchArmList")
    (string.eq type-name "TypeInfo")
    (string.eq type-name "TypeInfoList")
    (string.eq type-name "TypeField")
    (string.eq type-name "TypeFieldList")
    (string.eq type-name "TypeVariantPayload")
    (string.eq type-name "TypeVariantPayloadList")
    (string.eq type-name "TypeVariant")
    (string.eq type-name "TypeVariantList")
    (string.eq type-name "TypeParam")
    (string.eq type-name "TypeParamList")))

(define (tc-stdlib-comptime-raw-type-name [decl : AstDecl]) : TcMaybeString
  (match decl
    [(AstDecl.Unsafe inner-box)
      (tc-stdlib-comptime-raw-type-name (box-get inner-box))]
    [(AstDecl.DefEnum decl-meta name _ _)
      (TcMaybeString.Some (tc-env-key-name-text name))]
    [(AstDecl.DefEnumLifetimes decl-meta name _ _ _)
      (TcMaybeString.Some (tc-env-key-name-text name))]
    [(AstDecl.DefStruct decl-meta name _ _ _)
      (TcMaybeString.Some (tc-env-key-name-text name))]
    [(AstDecl.DefStructLifetimes decl-meta name _ _ _ _)
      (TcMaybeString.Some (tc-env-key-name-text name))]
    [_ (TcMaybeString.No)]))

(define (tc-stdlib-comptime-raw-comptime-decl? [decl : AstDecl]) : bool
  (ast-decl-comptime-only? decl))

(define (tc-stdlib-check-comptime-declaration-surface-decl
  [module : String]
  [decl : AstDecl]) : ResultTcUnit
  (if (not (string.eq module (tc-stdlib-comptime-module-name)))
    ResultTcUnit.Ok
    (match (tc-stdlib-comptime-raw-type-name decl)
      [(TcMaybeString.No) ResultTcUnit.Ok]
      [(TcMaybeString.Some type-name)
        (if (tc-stdlib-comptime-raw-comptime-decl? decl)
          (if (tc-stdlib-comptime-well-known-type? type-name)
            (tc-stdlib-well-known-mismatch
              type-name
              (tc-stdlib-comptime-plain-declaration-message))
            ResultTcUnit.Ok)
          ResultTcUnit.Ok)])))

(define (tc-stdlib-check-comptime-declaration-surface-list
  [decls : AstDeclList]
  [module : String]) : ResultTcUnit
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) ResultTcUnit.Ok]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        (match decl
          [(AstDecl.Module module-id)
            (tc-stdlib-check-comptime-declaration-surface-list
              rest
              (intern-str module-id))]
          [_
            (match (tc-stdlib-check-comptime-declaration-surface-decl
              module
              decl)
              [(ResultTcUnit.Ok)
                (tc-stdlib-check-comptime-declaration-surface-list rest module)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]))]))

(define (tc-stdlib-check-comptime-declaration-surface [ctx : TcContext]) : ResultTcUnit
  (match (tc-context-program ctx)
    [(AstProgram.Program decls-box)
      (tc-stdlib-check-comptime-declaration-surface-list (box-get decls-box) "")]))

(define (tc-stdlib-type-normalize-name [ctx : TcContext] [ty : AstType]) : AstType
  (match ty
    [(AstType.Var name)
      (tc-resolve-type-name ctx (tc-hygiene-name-text-id name) name)]
    [_ ty]))

(define (tc-stdlib-type-match-normalized?
  [ctx : TcContext]
  [actual : AstType]
  [expected : AstType]) : bool
  (match actual
    [(AstType.I64)
      (match expected
        [(AstType.I64) true]
        [_ false])]
    [(AstType.I32)
      (match expected
        [(AstType.I32) true]
        [_ false])]
    [(AstType.Bool)
      (match expected
        [(AstType.Bool) true]
        [_ false])]
    [(AstType.String)
      (match expected
        [(AstType.String) true]
        [_ false])]
    [(AstType.Expr)
      (match expected
        [(AstType.Expr) true]
        [_ false])]
    [(AstType.ExprList)
      (match expected
        [(AstType.ExprList) true]
        [_ false])]
    [(AstType.Box actual-inner)
      (match expected
        [(AstType.Box expected-inner)
          (tc-stdlib-type-match?
            ctx
            (tc-context-type-get ctx actual-inner)
            (ty-node-get expected-inner))]
        [_ false])]
    [(AstType.DynArray actual-inner)
      (match expected
        [(AstType.DynArray expected-inner)
          (tc-stdlib-type-match?
            ctx
            (tc-context-type-get ctx actual-inner)
            (ty-node-get expected-inner))]
        [_ false])]
    [(AstType.Struct actual-name)
      (match expected
        [(AstType.Struct expected-name)
          (tc-nominal-name-id-eq? actual-name expected-name)]
        [_ false])]
    [(AstType.Enum actual-name)
      (match expected
        [(AstType.Enum expected-name)
          (tc-nominal-name-id-eq? actual-name expected-name)]
        [_ false])]
    [(AstType.Var actual-name)
      (match expected
        [(AstType.Var expected-name)
          (tc-nominal-name-id-eq? actual-name expected-name)]
        [_ false])]
    [_ false]))

(define (tc-stdlib-type-match?
  [ctx : TcContext]
  [actual : AstType]
  [expected : AstType]) : bool
  (tc-stdlib-type-match-normalized?
    ctx
    (tc-stdlib-type-normalize-name ctx actual)
    (tc-stdlib-type-normalize-name ctx expected)))

(define (tc-stdlib-type-name-match?
  [ctx : TcContext]
  [actual : AstType]
  [name : i64]) : bool
  (tc-stdlib-type-match? ctx actual (AstType.Var name)))

(define (tc-stdlib-type-spec-match?
  [ctx : TcContext]
  [actual : AstType]
  [expected : TcStdlibTypeSpec]) : bool
  (match expected
    [(TcStdlibTypeSpec.I64)
      (match actual
        [(AstType.I64) true]
        [_ false])]
    [(TcStdlibTypeSpec.Bool)
      (match actual
        [(AstType.Bool) true]
        [_ false])]
    [(TcStdlibTypeSpec.String)
      (match actual
        [(AstType.String) true]
        [_ false])]
    [(TcStdlibTypeSpec.Name name) (tc-stdlib-type-name-match? ctx actual name)]
    [(TcStdlibTypeSpec.BoxName name)
      (match actual
        [(AstType.Box inner)
          (tc-stdlib-type-name-match? ctx (tc-context-type-get ctx inner) name)]
        [_ false])]
    [(TcStdlibTypeSpec.ArrayName name)
      (match actual
        [(AstType.DynArray inner)
          (tc-stdlib-type-name-match? ctx (tc-context-type-get ctx inner) name)]
        [_ false])]))

(define (tc-stdlib-type-spec-render [expected : TcStdlibTypeSpec]) : String
  (match expected
    [(TcStdlibTypeSpec.I64) "i64"]
    [(TcStdlibTypeSpec.Bool) "bool"]
    [(TcStdlibTypeSpec.String) "String"]
    [(TcStdlibTypeSpec.Name name) (tc-env-key-name-text name)]
    [(TcStdlibTypeSpec.BoxName name)
      (str_cat.str-cat "(Box " (tc-env-key-name-text name) ")")]
    [(TcStdlibTypeSpec.ArrayName name)
      (str_cat.str-cat "(Array " (tc-env-key-name-text name) ")")]))

(define (tc-stdlib-check-field-specs
  [ctx : TcContext]
  [type-name : String]
  [fields : AstFieldDefList]
  [specs : TcStdlibFieldSpecList]
  [index : i64]) : ResultTcUnit
  (match specs
    [(TcStdlibFieldSpecList.Nil)
      (if (>= index (struct-get (& fields) len))
        ResultTcUnit.Ok
        (tc-stdlib-well-known-mismatch type-name "unexpected extra field"))]
    [(TcStdlibFieldSpecList.Cons expected-name expected-ty rest-specs)
      (let
        [expected-name-text : String (intern-str expected-name)]
        (begin
          (cfg compile-profile (tc-lp-note 9))
          (if (>= index (struct-get (& fields) len))
            (tc-stdlib-well-known-mismatch
              type-name
              (str_cat.str-cat "missing field " expected-name-text))
            (let
              [rest-specs : TcStdlibFieldSpecList (box-get rest-specs)]
              (match (ast-field-def-list-get
                (& fields)
                index
                (ast-field-def-fallback))
                [(AstFieldDef.Def actual-name actual-ty _)
                  (cond
                    [(not (= actual-name expected-name))
                      (tc-stdlib-well-known-mismatch
                        type-name
                        (str_cat.str-cat
                          "expected field "
                          expected-name-text
                          " at index "
                          (string.int->string index)))]
                    [(tc-stdlib-type-spec-match? ctx actual-ty expected-ty)
                      (tc-stdlib-check-field-specs
                        ctx
                        type-name
                        fields
                        rest-specs
                        (+ index 1))]
                    [else
                      (tc-stdlib-well-known-mismatch
                        type-name
                        (str_cat.str-cat
                          "expected field "
                          expected-name-text
                          " type "
                          (tc-stdlib-type-spec-render expected-ty)))])])))))]))

(define (tc-stdlib-check-payload-specs
  [ctx : TcContext]
  [type-name : String]
  [variant-name : String]
  [actual : AstTypeList]
  [expected : TcStdlibTypeSpecList]
  [index : i64]) : ResultTcUnit
  (match expected
    [(TcStdlibTypeSpecList.Nil)
      (if (>= index (ast-type-list-len (& actual)))
        ResultTcUnit.Ok
        (tc-stdlib-well-known-mismatch
          type-name
          (str_cat.str-cat "payload arity mismatch for variant " variant-name)))]
    [(TcStdlibTypeSpecList.Cons expected-ty rest-expected)
      (if (>= index (ast-type-list-len (& actual)))
        (tc-stdlib-well-known-mismatch
          type-name
          (str_cat.str-cat "payload arity mismatch for variant " variant-name))
        (let
          [actual-id : i64
            (ast-type-list-get (& actual) index (ast-type-id-fallback))]
          [actual-ty : AstType (tc-context-type-get ctx actual-id)]
          [rest-expected : TcStdlibTypeSpecList (box-get rest-expected)]
          (if (tc-stdlib-type-spec-match? ctx actual-ty expected-ty)
            (tc-stdlib-check-payload-specs
              ctx
              type-name
              variant-name
              actual
              rest-expected
              (+ index 1))
            (tc-stdlib-well-known-mismatch
              type-name
              (str_cat.str-cat
                "payload type mismatch for variant "
                variant-name
                " at index "
                (string.int->string index))))))]))

(define (tc-stdlib-check-variant-specs
  [ctx : TcContext]
  [type-name : String]
  [variants : AstVariantDefList]
  [specs : TcStdlibVariantSpecList]
  [index : i64]) : ResultTcUnit
  (match specs
    [(TcStdlibVariantSpecList.Nil)
      (if (>= index (struct-get (& variants) len))
        ResultTcUnit.Ok
        (tc-stdlib-well-known-mismatch type-name "unexpected extra variant"))]
    [(TcStdlibVariantSpecList.Cons expected-name expected-payloads rest-specs)
      (let
        [expected-name-text : String (intern-str expected-name)]
        (begin
          (cfg compile-profile (tc-lp-note 11))
          (if (>= index (struct-get (& variants) len))
            (tc-stdlib-well-known-mismatch
              type-name
              (str_cat.str-cat "missing variant " expected-name-text))
            (let
              [variant : AstVariantDef
                (ast-variant-def-list-get
                  (& variants)
                  index
                  (ast-variant-def-fallback))]
              [rest-specs : TcStdlibVariantSpecList (box-get rest-specs)]
              (match variant
                [(AstVariantDef.Def actual-name actual-payloads _)
                  (if (not (= actual-name expected-name))
                    (tc-stdlib-well-known-mismatch
                      type-name
                      (str_cat.str-cat
                        "expected variant "
                        expected-name-text
                        " at index "
                        (string.int->string index)))
                    (match (tc-stdlib-check-payload-specs
                      ctx
                      type-name
                      expected-name-text
                      actual-payloads
                      expected-payloads
                      0)
                      [(ResultTcUnit.Ok)
                        (tc-stdlib-check-variant-specs
                          ctx
                          type-name
                          variants
                          rest-specs
                          (+ index 1))]
                      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])))))]))

(define (tc-stdlib-check-struct
  [ctx : TcContext]
  [type-name : String]
  [type-name-id : i64]
  [specs : TcStdlibFieldSpecList]) : ResultTcUnit
  (let
    [handle : i64
      (compiler-symbols-lookup-type-in-module-id-or
        (tc-context-symbols ctx)
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime
        type-name-id
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (match (compiler-symbols-decl-at-index
        (tc-context-symbols ctx)
        (compiler-symbol-handle-index handle))
        [(ResultAstDecl.Ok decl)
          (match decl
            [(AstDecl.DefStruct decl-meta _ _ _ fields)
              (tc-stdlib-check-field-specs
                (tc-context-with-module-id
                  ctx
                  (tc-stdlib-comptime-module-name)
                  cbi.compiler-builtin-id-fix-stdlib_dot_comptime)
                type-name
                fields
                specs
                0)]
            [_ (tc-stdlib-well-known-mismatch type-name "expected defstruct")])]
        [(ResultAstDecl.Err message)
          (tc-stdlib-well-known-mismatch type-name message)])
      (tc-stdlib-well-known-mismatch type-name "missing declaration"))))

(define (tc-stdlib-check-enum
  [ctx : TcContext]
  [type-name : String]
  [type-name-id : i64]
  [specs : TcStdlibVariantSpecList]) : ResultTcUnit
  (let
    [handle : i64
      (compiler-symbols-lookup-type-in-module-id-or
        (tc-context-symbols ctx)
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime
        type-name-id
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (match (compiler-symbols-decl-at-index
        (tc-context-symbols ctx)
        (compiler-symbol-handle-index handle))
        [(ResultAstDecl.Ok decl)
          (match decl
            [(AstDecl.DefEnum decl-meta _ _ variants)
              (tc-stdlib-check-variant-specs
                (tc-context-with-module-id
                  ctx
                  (tc-stdlib-comptime-module-name)
                  cbi.compiler-builtin-id-fix-stdlib_dot_comptime)
                type-name
                variants
                specs
                0)]
            [_ (tc-stdlib-well-known-mismatch type-name "expected defenum")])]
        [(ResultAstDecl.Err message)
          (tc-stdlib-well-known-mismatch type-name message)])
      (tc-stdlib-well-known-mismatch type-name "missing declaration"))))

(define (tc-stdlib-comptime-present? [ctx : TcContext]) : bool
  (or
    (compiler-symbols-handle-found?
      (compiler-symbols-lookup-type-in-module-id-or
        (tc-context-symbols ctx)
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime
        cbi.compiler-builtin-id-fix-Expr
        (compiler-symbols-missing-handle)))
    (compiler-symbols-handle-found?
      (compiler-symbols-lookup-type-in-module-id-or
        (tc-context-symbols ctx)
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime
        cbi.compiler-builtin-id-fix-TypeInfo
        (compiler-symbols-missing-handle)))))

(define (tc-stdlib-expr-specs [_ctx : TcContext]) : TcStdlibVariantSpecList
  (tc-stdlib-variant-spec-cons
    cbi.compiler-builtin-id-fix-ExprBool
    (tc-stdlib-type-spec-list1 (TcStdlibTypeSpec.Bool))
    (tc-stdlib-variant-spec-cons
      cbi.compiler-builtin-id-fix-ExprInt
      (tc-stdlib-type-spec-list1 (TcStdlibTypeSpec.I64))
      (tc-stdlib-variant-spec-cons
        cbi.compiler-builtin-id-fix-ExprVar
        (tc-stdlib-type-spec-list1 (TcStdlibTypeSpec.String))
        (tc-stdlib-variant-spec-cons
          cbi.compiler-builtin-id-fix-ExprSplice
          (tc-stdlib-type-spec-list1
            (TcStdlibTypeSpec.BoxName cbi.compiler-builtin-id-fix-Expr))
          (tc-stdlib-variant-spec-cons
            cbi.compiler-builtin-id-fix-ExprIf
            (tc-stdlib-type-spec-list3
              (TcStdlibTypeSpec.BoxName cbi.compiler-builtin-id-fix-Expr)
              (TcStdlibTypeSpec.BoxName cbi.compiler-builtin-id-fix-Expr)
              (TcStdlibTypeSpec.BoxName cbi.compiler-builtin-id-fix-Expr))
            (tc-stdlib-variant-spec-cons
              cbi.compiler-builtin-id-fix-ExprCall
              (tc-stdlib-type-spec-list2
                (TcStdlibTypeSpec.BoxName cbi.compiler-builtin-id-fix-Expr)
                (TcStdlibTypeSpec.Name cbi.compiler-builtin-id-fix-ExprList))
              (tc-stdlib-variant-spec-cons
                cbi.compiler-builtin-id-fix-ExprBegin
                (tc-stdlib-type-spec-list1
                  (TcStdlibTypeSpec.Name cbi.compiler-builtin-id-fix-ExprList))
                (tc-stdlib-variant-spec-cons
                  cbi.compiler-builtin-id-fix-ExprQuote
                  (tc-stdlib-type-spec-list1
                    (TcStdlibTypeSpec.BoxName cbi.compiler-builtin-id-fix-Expr))
                  (tc-stdlib-variant-spec-cons
                    cbi.compiler-builtin-id-fix-ExprQuasiquote
                    (tc-stdlib-type-spec-list1
                      (TcStdlibTypeSpec.BoxName
                        cbi.compiler-builtin-id-fix-Expr))
                    (tc-stdlib-variant-spec-cons
                      cbi.compiler-builtin-id-fix-ExprUnquote
                      (tc-stdlib-type-spec-list1
                        (TcStdlibTypeSpec.BoxName
                          cbi.compiler-builtin-id-fix-Expr))
                      (tc-stdlib-variant-spec-cons
                        cbi.compiler-builtin-id-fix-ExprUnquoteSplicing
                        (tc-stdlib-type-spec-list1
                          (TcStdlibTypeSpec.BoxName
                            cbi.compiler-builtin-id-fix-Expr))
                        (TcStdlibVariantSpecList.Nil)))))))))))))

(define (tc-stdlib-sequence-fields [_ctx : TcContext] [elem-name : i64]) : TcStdlibFieldSpecList
  (tc-stdlib-field-spec-cons
    cbi.compiler-builtin-id-fix-items
    (TcStdlibTypeSpec.ArrayName elem-name)
    (tc-stdlib-field-spec-cons
      cbi.compiler-builtin-id-fix-len
      (TcStdlibTypeSpec.I64)
      (TcStdlibFieldSpecList.Nil))))

(define (tc-stdlib-pattern-specs [_ctx : TcContext]) : TcStdlibVariantSpecList
  (tc-stdlib-variant-spec-cons
    cbi.compiler-builtin-id-fix-PatternWildcard
    (TcStdlibTypeSpecList.Nil)
    (tc-stdlib-variant-spec-cons
      cbi.compiler-builtin-id-fix-PatternBinding
      (tc-stdlib-type-spec-list1 (TcStdlibTypeSpec.String))
      (tc-stdlib-variant-spec-cons
        cbi.compiler-builtin-id-fix-PatternVariant
        (tc-stdlib-type-spec-list2
          (TcStdlibTypeSpec.String)
          (TcStdlibTypeSpec.Name cbi.compiler-builtin-id-fix-PatternList))
        (TcStdlibVariantSpecList.Nil)))))

(define (tc-stdlib-match-arm-fields) : TcStdlibFieldSpecList
