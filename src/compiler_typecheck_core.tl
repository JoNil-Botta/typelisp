(defstruct TcLifetimeSubstNode
  (from i64)
  (to i64)
  (parent i64))

(defstruct TcLifetimeSubstStoreData
  (nodes (__tl_dyn-array TcLifetimeSubstNode))
  (len i64)
  (owner-arena i64))

;; Lifetime inference is functional: a failed structural match may retry from
;; an earlier substitution, while successful recursion extends the newest
;; snapshot. Keep zero/one mappings allocation-free and publish wider snapshots
;; as stable tail indexes into one append-only dense node store. Sibling
;; extensions append separate nodes and never rewrite their shared prefix.
(defenum TcLifetimeSubst
  (Nil)
  (One i64 i64)
  (Dense i64 i64 i64))

(defenum ResultTcLifetimeSubst
  (Ok TcLifetimeSubst)
  (Err String))

(defenum TcMaybeTypeEnv
  (No)
  (Some TcTypeEnv))

(defstruct TcModuleLocalEnvEntry
  (module-id i64)
  (env TcTypeEnv))

;; Value semantics matter here: every insert publishes a fresh right-sized array
;; so a caller still holding the shorter cache never observes a later branch's
;; entry (tc-check-decls-with-paths-in-module-env deliberately re-resolves from
;; the pre-insert cache to obtain a second owned env). Inserts only happen on a
;; miss, so the copy is bounded by the distinct module count, not program size.
(defstruct TcModuleLocalEnvCache
  (slots (__tl_dyn-array TcModuleLocalEnvEntry))
  (len i64))

(defenum ResultTcModuleLocalEnv
  (Ok TcTypeEnv TcModuleLocalEnvCache)
  (Err String))

(defenum ResultTcEnv
  (Ok TcTypeEnv)
