    [_
      (not
        (tc-expr-uses-free-name?
          expr-bases
          (ast.ast-expr-unspan-with-segment-bases expr-bases expr)
          name
          bound))]))

(define (tc-reference-closure-escape-message) : String
  "typecheck: reference-capturing closure value would escape lexical scope")

(define (tc-capability-closure-escape-message) : String
  "typecheck: closure capability would be erased by escaping the direct local binding")

(define (tc-move-closure-escape-message) : String
  "typecheck: non-Copy closure ownership would be erased by escaping the direct local binding")

(define (tc-let-binding-ref-closure-scope-ok-at
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]
  [body : ast.AstExpr]
  [name : String]
  [allow-copy-alias : bool]) : ResultTcUnit
  (if (tc-ref-closure-let-rest-and-body-local-uses-ok-at?
    expr-bases
    bindings
    body
    name
    TcStringList.Nil
    allow-copy-alias
    index)
    ResultTcUnit.Ok
    (ResultTcUnit.Err (tc-reference-closure-escape-message))))

(define (tc-let-binding-capability-closure-scope-ok-at
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]
  [body : ast.AstExpr]
  [name : String]) : ResultTcUnit
  (if (tc-ref-closure-let-rest-and-body-local-uses-ok-at?
    expr-bases
    bindings
    body
    name
    TcStringList.Nil
    false
    index)
    ResultTcUnit.Ok
    (ResultTcUnit.Err (tc-capability-closure-escape-message))))

(define (tc-let-binding-move-closure-scope-ok-at
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]
  [body : ast.AstExpr]
  [name : String]) : ResultTcUnit
  (if (tc-ref-closure-let-rest-and-body-local-uses-ok-at?
    expr-bases
    bindings
    body
    name
    TcStringList.Nil
    true
    index)
    ResultTcUnit.Ok
    (ResultTcUnit.Err (tc-move-closure-escape-message))))

;; --------------------------------------------------------------------------
;; Inferred-type hint collection (used by the LSP for inlay hints).
;;
;; Disabled by default so normal and bootstrap compiles are byte-for-byte
;; unaffected. When enabled, the typechecker records the rendered inferred type
;; and 1-based source position of each un-annotated `let` binding value. A ring
;; buffer keeps the most recent records, so the entry document (whose decls are
;; checked last) is always retained even when imported modules are re-checked.
;; Records are not file-attributed; the LSP filters them against the open
;; document's text before turning them into hints.
;; Each TcJobState owns one collector: fixed arrays are lazy and live in the
;; state creation arena, while copied rendered strings live in a disposable
;; per-generation arena. The stdio LSP is serialized, but independent jobs can
;; interleave without resetting one another's records.
;; --------------------------------------------------------------------------
(define (tc-inlay-hint-state-enabled? [state : TcInlayHintState]) : bool
  (__tl-project-field (tc-inlay-hint-state-data state) enabled))

(define (tc-inlay-hint-storage-ensure-for-state! [state : TcInlayHintState]) : unit
  (let
    [data : TcInlayHintStateData (tc-inlay-hint-state-data state)]
    (if (= (array-length data.lines) tc-inlay-hint-capacity)
      unit
      (in-arena
        (arena.Arena data.fixed-storage-arena)
        (begin
          (set! data.lines (array.make-array i64 tc-inlay-hint-capacity))
          (set! data.cols (array.make-array i64 tc-inlay-hint-capacity))
          (set! data.types (array.make-array String tc-inlay-hint-capacity))
          (tc-inlay-hint-state-data-set! state data))))))

(define (tc-inlay-hint-string-arena-ensure-for-state!
  [state : TcInlayHintState]) : i64
  (let
    [data : TcInlayHintStateData (tc-inlay-hint-state-data state)]
    (if (= data.string-arena 0)
      (let
        [owner : i64 (arena.tl_arena_make_small)]
        (begin
          (set! data.string-arena owner)
          (tc-inlay-hint-state-data-set! state data)
          data.string-arena))
      data.string-arena)))

;; Destroying any segment of the chain frees the complete generation arena.
(define (tc-inlay-hint-string-arena-release-for-state!
  [state : TcInlayHintState]) : unit
  (let
    [data : TcInlayHintStateData (tc-inlay-hint-state-data state)]
    [string-arena : i64 data.string-arena]
    (begin
      (if (= string-arena 0)
        unit
        (unsafe
          (arena.tl_arena_destroy string-arena)))
      (set! data.string-arena 0)
      (tc-inlay-hint-state-data-set! state data))))

(define (tc-inlay-hints-reset-for-state! [state : TcInlayHintState]) : unit
  (let
    [data : TcInlayHintStateData (tc-inlay-hint-state-data state)]
    (begin
      ;; Make any strings held in fixed slots unreachable before freeing them.
      (set! data.enabled false)
      (set! data.count 0)
      (tc-inlay-hint-state-data-set! state data)
      (tc-inlay-hint-string-arena-release-for-state! state))))

(define (tc-inlay-hints-enable-for-state! [state : TcInlayHintState]) : unit
  (begin
    (tc-inlay-hint-storage-ensure-for-state! state)
    (let
      [data : TcInlayHintStateData (tc-inlay-hint-state-data state)]
      (begin
        ;; Clear the logical range before destroying the prior generation.
        (set! data.count 0)
        (tc-inlay-hint-state-data-set! state data)
        (tc-inlay-hint-string-arena-release-for-state! state)
        (let
          [latest : TcInlayHintStateData (tc-inlay-hint-state-data state)]
          (set! latest.enabled true)
          (tc-inlay-hint-state-data-set! state latest))))))

(define (tc-inlay-hints-disable-for-state! [state : TcInlayHintState]) : unit
  (let
    [data : TcInlayHintStateData (tc-inlay-hint-state-data state)]
    (begin
      (set! data.enabled false)
      (tc-inlay-hint-state-data-set! state data))))

(define (tc-inlay-hints-size-for-state [state : TcInlayHintState]) : i64
  (let
    [count : i64 (__tl-project-field (tc-inlay-hint-state-data state) count)]
    (if (< count tc-inlay-hint-capacity)
      count
      tc-inlay-hint-capacity)))

(define (tc-inlay-hint-line-at-for-state [state : TcInlayHintState] [i : i64]) : i64
  (array-ref (__tl-project-field (tc-inlay-hint-state-data state) lines) i))

(define (tc-inlay-hint-col-at-for-state [state : TcInlayHintState] [i : i64]) : i64
  (array-ref (__tl-project-field (tc-inlay-hint-state-data state) cols) i))

(define (tc-inlay-hint-type-at-for-state [state : TcInlayHintState] [i : i64]) : String
  (array-ref (__tl-project-field (tc-inlay-hint-state-data state) types) i))

(define (tc-inlay-hint-record-for-state!
  [state : TcInlayHintState]
  [line : i64]
  [col : i64]
  [ty : String]) : unit
  ;; Copy rendered text into this state generation so it survives destruction
  ;; of a transient typecheck/tool arena.
  (let
    [data : TcInlayHintStateData (tc-inlay-hint-state-data state)]
    [slot : i64 (% data.count tc-inlay-hint-capacity)]
    [owner : i64 (tc-inlay-hint-string-arena-ensure-for-state! state)]
    (begin
      (in-arena
        (arena.Arena owner)
        (begin
          (set! (array-ref data.lines slot) line)
          (set! (array-ref data.cols slot) col)
          (set! (array-ref data.types slot) (string.copy (& ty)))))
      (let
        [latest : TcInlayHintStateData (tc-inlay-hint-state-data state)]
        (begin
          (set! latest.count (+ latest.count 1))
          (tc-inlay-hint-state-data-set! state latest))))))

;; Serial/test adapters retain the historical no-state surface.
(define (tc-inlay-hints-enable!) : unit
  (tc-inlay-hints-enable-for-state!
    (tc-job-state-inlay-hints (tc-serial-job-state))))

(define (tc-inlay-hints-disable!) : unit
  (tc-inlay-hints-disable-for-state!
    (tc-job-state-inlay-hints (tc-serial-job-state))))

(define (tc-inlay-hints-size) : i64
  (tc-inlay-hints-size-for-state
    (tc-job-state-inlay-hints (tc-serial-job-state))))

(define (tc-inlay-hint-line-at [i : i64]) : i64
  (tc-inlay-hint-line-at-for-state
    (tc-job-state-inlay-hints (tc-serial-job-state))
    i))

(define (tc-inlay-hint-col-at [i : i64]) : i64
  (tc-inlay-hint-col-at-for-state
    (tc-job-state-inlay-hints (tc-serial-job-state))
    i))

(define (tc-inlay-hint-type-at [i : i64]) : String
  (tc-inlay-hint-type-at-for-state
    (tc-job-state-inlay-hints (tc-serial-job-state))
    i))

(define (tc-inlay-hint-record! [line : i64] [col : i64] [ty : String]) : unit
  (tc-inlay-hint-record-for-state!
    (tc-job-state-inlay-hints (tc-serial-job-state))
    line
    col
    ty))

;; Record the inferred type of an un-annotated let binding value. The explicit
;; form is used by body hot paths; the no-state form remains a test adapter.
(define (tc-inlay-hint-maybe-record-for-state
  [state : TcInlayHintState]
  [maybe-ty : ast.AstMaybeType]
  [init : ast.AstExpr]
  [init-ty : ast.AstType]) : unit
  (match maybe-ty
    [(ast.AstMaybeType.No)
      (match init
        [(ast.AstExpr.Spanned _ span)
          (tc-inlay-hint-record-for-state!
            state
            (ast.ast-source-span-start-line span)
            (ast.ast-source-span-start-col span)
            (tc-type-render init-ty))]
        [_ unit])]
    [(ast.AstMaybeType.Some _) unit]))

;; Record the inferred type of any spanned expression for tl/getType.
(define (tc-inlay-hint-maybe-record-expr-for-state
  [state : TcInlayHintState]
  [expr : ast.AstExpr]
  [ty : ast.AstType]) : unit
  (match expr
    [(ast.AstExpr.Spanned _ span)
      (tc-inlay-hint-record-for-state!
        state
        (ast.ast-source-span-start-line span)
        (ast.ast-source-span-start-col span)
        (tc-type-render ty))]
    [_ unit]))

(define (tc-let-binding-init-type-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [maybe-ty : ast.AstMaybeType]
  [init-id : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]
  [body : ast.AstExpr]) : ResultTcType
  (let
    [expr-bases : i64 (tc-context-expr-bases ctx)]
    [init : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases init-id)]
    [ref-capturing-lambda : bool
      (tc-ref-capturing-lambda-init? expr-bases env init)]
    [copyable-ref-capturing-lambda : bool
      (and
        ref-capturing-lambda
        (not (tc-move-only-capturing-lambda-init? ctx env init)))]
    [move-only-capturing-lambda : bool
      (tc-move-only-capturing-lambda-init? ctx env init)]
    [consuming-capturing-lambda : bool
      (tc-consuming-capturing-lambda-init? ctx env init)]
    [capability-capturing-lambda : bool
      (or
        ref-capturing-lambda
        move-only-capturing-lambda
        consuming-capturing-lambda)]
    (match maybe-ty
      [(ast.AstMaybeType.Some want)
        (let
          [resolved-want : ast.AstType (tc-resolve-type ctx want)]
          (if capability-capturing-lambda
            (match (cond
              [ref-capturing-lambda
                (tc-let-binding-ref-closure-scope-ok-at
                  expr-bases
                  bindings
                  index
                  body
                  name
                  copyable-ref-capturing-lambda)]
              [consuming-capturing-lambda
                (tc-let-binding-capability-closure-scope-ok-at
                  expr-bases
                  bindings
                  index
                  body
                  name)]
              [else
                (tc-let-binding-move-closure-scope-ok-at
                  expr-bases
                  bindings
                  index
                  body
                  name)])
              [(ResultTcUnit.Ok)
                (match (ast.ast-expr-unspan init)
                  [(ast.AstExpr.Lambda lambda-box)
                    (match (__tl-box-place lambda-box)
                      [(ast.AstLambda.Lambda params maybe-ret lambda-body-box)
                        (let
                          [lambda-body : ast.AstExpr
                            (tc-context-expr-get ctx lambda-body-box)]
                          (tc-lambda-expr-allow-ref-captures
                            ctx
                            env
                            params
                            maybe-ret
                            lambda-body))])]
                  [_
                    (tc-expr-with-expected-or-actual-id
                      ctx
                      env
                      init-id
                      resolved-want)])]
              [(ResultTcUnit.Err message) (ResultTcType.Err message)])
            (tc-expr-with-expected-or-actual-id ctx env init-id resolved-want)))]
      [(ast.AstMaybeType.No)
        (if capability-capturing-lambda
          (match (cond
            [ref-capturing-lambda
              (tc-let-binding-ref-closure-scope-ok-at
                expr-bases
                bindings
                index
                body
                name
                copyable-ref-capturing-lambda)]
            [consuming-capturing-lambda
              (tc-let-binding-capability-closure-scope-ok-at
                expr-bases
                bindings
                index
                body
                name)]
            [else
              (tc-let-binding-move-closure-scope-ok-at
                expr-bases
                bindings
                index
                body
                name)])
            [(ResultTcUnit.Ok)
              (match (ast.ast-expr-unspan init)
                [(ast.AstExpr.Lambda lambda-box)
                  (match (__tl-box-place lambda-box)
                    [(ast.AstLambda.Lambda params maybe-ret lambda-body-box)
                      (let
                        [lambda-body : ast.AstExpr
                          (tc-context-expr-get ctx lambda-body-box)]
                        (tc-lambda-expr-allow-ref-captures
                          ctx
                          env
                          params
                          maybe-ret
                          lambda-body))])]
                [_ (tc-expr-id ctx env init-id)])]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)])
          (tc-expr-id ctx env init-id))])))

(define (tc-let-bindings-for-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : ast.AstLetBindingList]
  [body : ast.AstExpr]) : ResultTcEnv
  (tc-let-bindings-for-body-at ctx env (& bindings) body 0))

(define (tc-let-bindings-for-body-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : (& bindings ast.AstLetBindingList)]
  [body : ast.AstExpr]
  [index : i64]) : ResultTcEnv
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (ResultTcEnv.Ok env)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : ast.AstExpr (tc-context-expr-get ctx init-box)]
          (match (tc-let-binding-init-type-at
            ctx
            env
            (tc-env-key-name-text name)
            maybe-ty
            init-box
            bindings
            (+ index 1)
            body)
            [(ResultTcType.Ok init-ty)
              (let
                [body-state : TcBodyState (tc-context-body-state ctx)]
                (begin
                  (if body-state.inlay-hint-enabled
                    (tc-inlay-hint-maybe-record-for-state
                      body-state.inlay-hint-state
                      maybe-ty
                      init
                      init-ty)
                    unit)
                  (match maybe-ty
                    [(ast.AstMaybeType.Some want)
                      (let
                        [resolved-want : ast.AstType (tc-resolve-type ctx want)]
                        (match (tc-let-binding-plain-expected-ok
                          ctx
                          env
                          (tc-env-key-name-text name)
                          (ast.AstMaybeType.Some resolved-want)
                          init
                          init-ty)
                          [(ResultTcUnit.Ok)
                            (match (tc-ensure-cleanup-resource-not-let-bound
                              ctx
                              env
                              init
                              init-ty)
                              [(ResultTcUnit.Ok)
                                (match (tc-ensure-reference-value-can-bind
                                  env
                                  init-ty)
                                  [(ResultTcUnit.Ok)
                                    (tc-let-bindings-for-body-at
                                      ctx
                                      (let
                                        [binding-ty : ast.AstType
                                          (if (tc-type-contains-any-region
                                            init-ty)
                                            init-ty
                                            resolved-want)]
                                        (tc-bind-c-abi-fnptr-if-needed-id
                                          ctx
                                          env
                                          name
                                          binding-ty
                                          init))
                                      bindings
                                      body
                                      (+ index 1))]
                                  [(ResultTcUnit.Err message)
                                    (ResultTcEnv.Err message)])]
                              [(ResultTcUnit.Err message)
                                (ResultTcEnv.Err message)])]
                          [(ResultTcUnit.Err message) (ResultTcEnv.Err message)]))]
                    [(ast.AstMaybeType.No)
                      (match (tc-ensure-cleanup-resource-not-let-bound
                        ctx
                        env
                        init
                        init-ty)
                        [(ResultTcUnit.Ok)
                          (match (tc-ensure-reference-value-can-bind
                            env
                            init-ty)
                            [(ResultTcUnit.Ok)
                              (tc-let-bindings-for-body-at
                                ctx
                                (tc-bind-c-abi-fnptr-if-needed-id
                                  ctx
                                  env
                                  name
                                  init-ty
                                  init)
                                bindings
                                body
                                (+ index 1))]
                            [(ResultTcUnit.Err message)
                              (ResultTcEnv.Err message)])]
                        [(ResultTcUnit.Err message) (ResultTcEnv.Err message)])])))]
            [(ResultTcType.Err message) (ResultTcEnv.Err message)]))])))

(define (tc-resource-cleanup-direct-name-ok [cleanup : ast.AstExpr]) : ResultTcUnit
  (match (ast.ast-expr-unspan cleanup)
    [(ast.AstExpr.Var _) ResultTcUnit.Ok]
    [_
      (ResultTcUnit.Err
        "typecheck: with cleanup must be a direct function name")]))

(define (tc-resource-cleanup-resource-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [cleanup : ast.AstExpr]) : ResultTcType
  (match (tc-resource-cleanup-direct-name-ok cleanup)
    [(ResultTcUnit.Ok)
      (match (tc-expr ctx env cleanup)
        [(ResultTcType.Ok cleanup-ty)
          (match (tc-type-strip-region (tc-resolve-type ctx cleanup-ty))
            [(ast.AstType.Func args ret)
              (let
                [ret-ty : ast.AstType (ast.ty-node-get ret)]
                [args : ast.AstTypeList (__tl-box-place args)]
                (if (= (ast.ast-type-list-len (& args)) 1)
                  (let
                    [arg-ty : ast.AstType
                      (ast.ty-node-get
                        (ast.ast-type-list-get
                          (& args)
                          0
                          (ast.ast-type-id-fallback)))]
                    (if (tc-type-eq ret-ty (ast.AstType.Unit))
                      (ResultTcType.Ok arg-ty)
                      (ResultTcType.Err
                        "typecheck: with cleanup function type mismatch")))
                  (ResultTcType.Err
                    "typecheck: with cleanup function type mismatch")))]
            [_
              (ResultTcType.Err
                "typecheck: with cleanup function type mismatch")])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcUnit.Err message) (ResultTcType.Err message)]))

(define (tc-resource-cleanup-ok
  [ctx : TcContext]
  [env : TcTypeEnv]
  [cleanup : ast.AstExpr]
  [resource-ty : ast.AstType]) : ResultTcUnit
  (match (tc-resource-cleanup-resource-type ctx env cleanup)
    [(ResultTcType.Ok cleanup-resource-ty)
      (tc-expect
        cleanup-resource-ty
        (tc-type-without-regions resource-ty)
        "typecheck: with cleanup function type mismatch")]
    [(ResultTcType.Err message) (ResultTcUnit.Err message)]))

(define (tc-resource-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : ast.AstResourceBindingList]) : ResultTcEnv
  (tc-resource-bindings-at ctx env (& bindings) 0))

(define (tc-resource-bindings-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [index : i64]) : ResultTcEnv
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    (ResultTcEnv.Ok env)
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(ast.AstResourceBinding.Binding name init-box cleanup-box _)
        (let
          [init : ast.AstExpr (tc-context-expr-get ctx init-box)]
          [cleanup : ast.AstExpr (tc-context-expr-get ctx cleanup-box)]
          (match (tc-resource-cleanup-resource-type ctx env cleanup)
            [(ResultTcType.Ok expected-init-ty)
              (match (tc-expr-with-expected-or-actual-id
                ctx
                env
                init-box
                expected-init-ty)
                [(ResultTcType.Ok init-ty)
                  (match (tc-ensure-cleanup-resource-not-transferred env init)
                    [(ResultTcUnit.Ok)
                      (match (tc-resource-cleanup-ok ctx env cleanup init-ty)
                        [(ResultTcUnit.Ok)
                          (tc-resource-bindings-at
                            ctx
                            (tc-bind-id
                              (tc-bind-id
                                env
                                (tc-cleanup-owner-marker-id)
                                (ast.AstType.Var name))
                              name
                              (tc-type-without-regions init-ty))
                            bindings
                            (+ index 1))]
                        [(ResultTcUnit.Err message) (ResultTcEnv.Err message)])]
                    [(ResultTcUnit.Err message) (ResultTcEnv.Err message)])]
                [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
            [(ResultTcType.Err message) (ResultTcEnv.Err message)]))])))

(define (tc-begin-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]) : ResultTcType
  (tc-begin-list-at ctx env (& exprs) 0))

(define (tc-begin-list-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : ResultTcType
  (if (>= index exprs.len)
    (ResultTcType.Ok (ast.AstType.Unit))
    (if (= (+ index 1) exprs.len)
      (tc-expr-id ctx env (ast.ast-expr-list-get exprs index 0))
      (match (tc-expr-id ctx env (ast.ast-expr-list-get exprs index 0))
        [(ResultTcType.Ok _) (tc-begin-list-at ctx env exprs (+ index 1))]
        [(ResultTcType.Err message) (ResultTcType.Err message)]))))

(define (tc-spmd-require-uniform [class : TcSpmdClass] [message : String]) : ResultTcUnit
  (if (tc-spmd-varying? class)
    (ResultTcUnit.Err message)
    ResultTcUnit.Ok))

(define (tc-spmd-inline-helper-empty-stack) : TcNameIdList
  TcNameIdList.Nil)

(define tc-spmd-inline-helper-stack : TcNameIdList
  (tc-spmd-inline-helper-empty-stack))

(define (tc-spmd-inline-helper-stack-reset!) : unit
  (set! tc-spmd-inline-helper-stack (tc-spmd-inline-helper-empty-stack)))

(define (tc-spmd-inline-helper-recursive-message) : String
  "typecheck: recursive SPMD helper call is not supported")

(define (tc-spmd-inline-helper-resolve-name
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [func : ast.AstExpr]) : TcNameLookup
  (match (ast.ast-expr-unspan func)
    [(ast.AstExpr.Var raw-name)
      (let
        [raw-text : String (tc-hygiene-name-text-id raw-name)]
        [source-name-id : i64
          (macro-hygiene-global-source-name-id-or raw-name raw-name)]
        (cond
          [(tc-spmd-env-has-local-id? spmd-env raw-name) (TcNameLookup.Err "")]
          [(tc-hygiene-global-name-id? raw-name)
            (TcNameLookup.Ok raw-text source-name-id)]
          [(tc-name-qualified-id? raw-name) (TcNameLookup.Ok raw-text raw-name)]
          [else
            (tc-source-name-lookup-key-with-field-check-lookup
              ctx
              env
              raw-text
              raw-name
              true)]))]
    [_ (TcNameLookup.Err "")]))

(define (tc-spmd-inline-helper-from-decl
  [expr-bases : i64]
  [name-id : i64]
  [module-id : i64]
  [decl : ast.AstDecl]) : ResultTcSpmdInlineHelper
  (match decl
    [(ast.AstDecl.DefFn decl-meta _ params ret body-box _)
      (let
        [body : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases body-box)]
        (ResultTcSpmdInlineHelper.Ok
          (TcSpmdInlineHelper.Some name-id module-id params ret body)))]
    [(ast.AstDecl.Extern _ _ (ast.AstExternKind.Function) metadata ty)
      (match (ast.ast-extern-metadata-imported-spmd (__tl-box-place metadata))
        [(ast.AstImportedSpmdMetadata.No)
          (ResultTcSpmdInlineHelper.Ok (TcSpmdInlineHelper.No))]
        [(ast.AstImportedSpmdMetadata.Package _ callables)
          (ResultTcSpmdInlineHelper.Ok
            (TcSpmdInlineHelper.Imported ty callables))])]
    [(ast.AstDecl.Unsafe inner-box)
      (let
        [inner : ast.AstDecl (__tl-box-place inner-box)]
        (tc-spmd-inline-helper-from-decl expr-bases name-id module-id inner))]
    [_ (ResultTcSpmdInlineHelper.Ok (TcSpmdInlineHelper.No))]))

(define (tc-spmd-inline-helper-lookup
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [func : ast.AstExpr]) : ResultTcSpmdInlineHelper
  (match (tc-spmd-inline-helper-resolve-name ctx env spmd-env func)
    [(TcNameLookup.Ok _ lookup-id)
      (if (tc-name-id-list-contains tc-spmd-inline-helper-stack lookup-id)
        (ResultTcSpmdInlineHelper.Err (tc-spmd-inline-helper-recursive-message))
        (let
          [handle : i64
            (csym.compiler-symbols-lookup-value-id-or
              (tc-context-symbols ctx)
              lookup-id
              (csym.compiler-symbols-missing-handle))]
          (if (csym.compiler-symbols-handle-found? handle)
            (if (or
              (=
                (csym.compiler-symbol-handle-kind handle)
                (csym.compiler-symbol-kind-function-define))
              (=
                (csym.compiler-symbol-handle-kind handle)
                (csym.compiler-symbol-kind-extern)))
              (let
                [declaration-id : i64
                  (csym.compiler-symbol-handle-index handle)]
                [module-id : i64
                  (csym.compiler-symbols-owner-module-id-at-index-or
                    (tc-context-symbols ctx)
                    declaration-id
                    (tc-context-module-id ctx))]
                (match (csym.compiler-symbols-decl-at-index
                  (tc-context-symbols ctx)
                  declaration-id)
                  [(parser.ResultAstDecl.Ok decl)
                    (tc-spmd-inline-helper-from-decl
                      expr-bases
                      lookup-id
                      module-id
                      decl)]
                  [(parser.ResultAstDecl.Err message)
                    (ResultTcSpmdInlineHelper.Err message)]))
              (ResultTcSpmdInlineHelper.Ok (TcSpmdInlineHelper.No)))
            (ResultTcSpmdInlineHelper.Ok (TcSpmdInlineHelper.No)))))]
    [(TcNameLookup.Err message)
      (if (string.eq message "")
        (ResultTcSpmdInlineHelper.Ok (TcSpmdInlineHelper.No))
        (ResultTcSpmdInlineHelper.Err message))]))

(define (tc-spmd-inline-helper-module [module-id : i64]) : String
  (if (csym.compiler-symbol-root-module-id? module-id)
    ""
    (tc-env-key-name-text module-id)))

(define (tc-spmd-inline-helper-env
  [ctx : TcContext]
  [fallback : TcTypeEnv]
  [module : String]
  [module-id : i64]) : TcTypeEnv
  (match (tc-hygiene-definition-env-id ctx module module-id)
    [(ResultTcEnv.Ok helper-env) helper-env]
    [(ResultTcEnv.Err _) fallback]))

(define (tc-spmd-inline-helper-arg-role
  [expr-bases : i64]
  [spmd-env : TcSpmdEnv]
  [arg : ast.AstExpr]) : TcSpmdRole
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases arg)
    [(ast.AstExpr.Ann inner-box _)
      (tc-spmd-inline-helper-arg-role
        expr-bases
        spmd-env
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.Cast inner-box _)
      (tc-spmd-inline-helper-arg-role
        expr-bases
        spmd-env
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.Var name)
      (match (tc-spmd-env-lookup-id spmd-env name)
        [(TcSpmdLookup.Found _ _ _ role) role]
        [(TcSpmdLookup.Missing) TcSpmdRole.Value])]
    [_ TcSpmdRole.Value]))

(define (tc-spmd-inline-helper-bind-args
  [ctx : TcContext]
  [expr-bases : i64]
  [caller-env : TcTypeEnv]
  [caller-spmd-env : TcSpmdEnv]
  [func : ast.AstExpr]
  [helper-ctx : TcContext]
  [helper-env : TcTypeEnv]
  [helper-spmd-env : TcSpmdEnv]
  [params : ast.AstParamList]
  [args : ast.AstExprList]
  [seen-class : TcSpmdClass]) : ResultTcSpmdInlineCallState
  (tc-spmd-inline-helper-bind-args-at
    ctx
    expr-bases
    caller-env
    caller-spmd-env
    func
    helper-ctx
    helper-env
    helper-spmd-env
    (& params)
    (& args)
    0
    seen-class))

(define (tc-spmd-inline-helper-bind-args-at
  [ctx : TcContext]
  [expr-bases : i64]
  [caller-env : TcTypeEnv]
  [caller-spmd-env : TcSpmdEnv]
  [func : ast.AstExpr]
  [helper-ctx : TcContext]
  [helper-env : TcTypeEnv]
  [helper-spmd-env : TcSpmdEnv]
  [params : (& params ast.AstParamList)]
  [args : (& args ast.AstExprList)]
  [index : i64]
  [seen-class : TcSpmdClass]) : ResultTcSpmdInlineCallState
  (cond
    [(>= index (ast.ast-param-list-len params))
      (if (>= index args.len)
        (ResultTcSpmdInlineCallState.Ok
          (TcSpmdInlineCallState
            caller-spmd-env
            helper-env
            helper-spmd-env
            seen-class))
        (ResultTcSpmdInlineCallState.Err
          (tc-call-arity-count-message
            func
            (ast.ast-param-list-len params)
            args.len)))]
    [(>= index args.len)
      (ResultTcSpmdInlineCallState.Err
        (tc-call-arity-count-message
          func
          (ast.ast-param-list-len params)
          args.len))]
    [else
      (let
        [arg : ast.AstExpr
          (ast.ast-expr-segment-bases-get
            expr-bases
            (ast.ast-expr-list-get args index 0))]
        (match (tc-spmd-expr ctx expr-bases caller-env caller-spmd-env arg)
          [(ResultTcSpmdExprInfo.Ok arg-info)
            (match arg-info
              [(TcSpmdExprInfo _ arg-class next-caller-spmd-env)
                (match (ast.ast-param-list-get
                  params
                  index
                  (ast.ast-param-fallback))
                  [(ast.AstParam.Param param-name param-ty _ _)
                    (let
                      [bound-ty : ast.AstType
                        (tc-resolve-type helper-ctx param-ty)]
                      (if (and
                        (tc-spmd-varying? arg-class)
                        (not (tc-spmd-varying-value-type-supported? bound-ty)))
                        (ResultTcSpmdInlineCallState.Err
                          (str_cat.str-cat
                            "typecheck: SPMD helper varying parameter type is not supported: "
                            (tc-type-render (tc-type-strip-region bound-ty))))
                        (tc-spmd-inline-helper-bind-args-at
                          ctx
                          expr-bases
                          caller-env
                          next-caller-spmd-env
                          func
                          helper-ctx
                          (tc-bind-id helper-env param-name bound-ty)
                          (tc-spmd-env-bind-role-id
                            helper-spmd-env
                            param-name
                            bound-ty
                            arg-class
                            TcSpmdScope.Local
                            (tc-spmd-inline-helper-arg-role
                              expr-bases
                              caller-spmd-env
                              arg))
                          params
                          args
                          (+ index 1)
                          (tc-spmd-merge-class seen-class arg-class))))])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdInlineCallState.Err message)]))]))

(define (tc-spmd-inline-helper-body
  [ctx : TcContext]
  [expr-bases : i64]
  [helper-env : TcTypeEnv]
  [helper-spmd-env : TcSpmdEnv]
  [name-id : i64]
  [body : ast.AstExpr]) : ResultTcSpmdExprInfo
  (let
    [previous : TcNameIdList tc-spmd-inline-helper-stack]
    [result : ResultTcSpmdExprInfo
      (ResultTcSpmdExprInfo.Err (tc-spmd-inline-helper-recursive-message))]
    (begin
      (set! tc-spmd-inline-helper-stack (tc-name-id-list-add previous name-id))
      (set!
        result
        (tc-spmd-expr ctx expr-bases helper-env helper-spmd-env body))
      (set! tc-spmd-inline-helper-stack previous)
      result)))

(define (tc-spmd-call-uniform-only
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : ast.AstType]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcSpmdExprInfo
  (match (tc-spmd-expr ctx expr-bases env spmd-env func)
    [(ResultTcSpmdExprInfo.Ok func-info)
      (match func-info
        [(TcSpmdExprInfo _ _ func-env)
          (match (tc-spmd-expr-list ctx expr-bases env func-env args)
            [(ResultTcSpmdExprListInfo.Ok args-info)
              (match args-info
                [(TcSpmdExprListInfo args-class args-env)
                  (match (tc-spmd-require-uniform
                    args-class
                    "typecheck: foreach calls with varying arguments are not supported")
                    [(ResultTcUnit.Ok)
                      (tc-spmd-finish expr-ty TcSpmdClass.Uniform args-env)]
                    [(ResultTcUnit.Err message)
                      (ResultTcSpmdExprInfo.Err message)])])]
            [(ResultTcSpmdExprListInfo.Err message)
              (ResultTcSpmdExprInfo.Err message)])])]
    [(ResultTcSpmdExprInfo.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-imported-callable-has-specialization-at?
  [callables : (& callables ast.AstImportedSpmdCallableList)]
  [signature : String]
  [index : i64]) : bool
  (if (>= index (ast.ast-imported-spmd-callable-list-len callables))
    false
    (let
      [callable : ast.AstImportedSpmdCallable
        (ast.ast-imported-spmd-callable-list-get
          callables
          index
          (ast.ast-imported-spmd-callable-fallback))]
      [specializations : ast.AstImportedSpmdSpecializationList
        callable.specializations]
      (or
        (and
          (string.eq (ci.intern-str callable.signature) signature)
          (>
            (ast.ast-imported-spmd-specialization-list-len (& specializations))
            0))
        (tc-spmd-imported-callable-has-specialization-at?
          callables
          signature
          (+ index 1))))))

(define (tc-spmd-imported-specializations-have-varying-result-at?
  [specializations : (& specializations ast.AstImportedSpmdSpecializationList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-imported-spmd-specialization-list-len specializations))
    false
    (let
      [item : ast.AstImportedSpmdSpecialization
        (ast.ast-imported-spmd-specialization-list-get
          specializations
          index
          (ast.ast-imported-spmd-specialization-fallback))]
      (or
        (string.eq (ci.intern-str item.result) "v")
        (tc-spmd-imported-specializations-have-varying-result-at?
          specializations
          (+ index 1))))))

(define (tc-spmd-imported-callable-has-varying-result-at?
  [callables : (& callables ast.AstImportedSpmdCallableList)]
  [signature : String]
  [index : i64]) : bool
  (if (>= index (ast.ast-imported-spmd-callable-list-len callables))
    false
    (let
      [callable : ast.AstImportedSpmdCallable
        (ast.ast-imported-spmd-callable-list-get
          callables
          index
          (ast.ast-imported-spmd-callable-fallback))]
      [specializations : ast.AstImportedSpmdSpecializationList
        callable.specializations]
      (or
        (and
          (string.eq (ci.intern-str callable.signature) signature)
          (tc-spmd-imported-specializations-have-varying-result-at?
            (& specializations)
            0))
        (tc-spmd-imported-callable-has-varying-result-at?
          callables
          signature
          (+ index 1))))))

(define (tc-spmd-imported-call-result-class
  [expr-ty : ast.AstType]
  [fn-ty : ast.AstType]
  [callables : (& callables ast.AstImportedSpmdCallableList)]
  [args-class : TcSpmdClass]) : TcSpmdClass
  (cond
    [(not (tc-spmd-varying? args-class)) TcSpmdClass.Uniform]
    [(tc-type-eq (tc-type-without-regions expr-ty) (ast.AstType.Unit))
      TcSpmdClass.Uniform]
    [else
      (let
        [signature : String (tc-type-render (tc-type-without-regions fn-ty))]
        (cond
          [(tc-spmd-imported-callable-has-varying-result-at?
              callables
              signature
              0)
            TcSpmdClass.Varying]
          [(tc-spmd-imported-callable-has-specialization-at?
              callables
              signature
              0)
            TcSpmdClass.Uniform]
          [else TcSpmdClass.Varying]))]))

(define (tc-spmd-imported-call
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : ast.AstType]
  [fn-ty : ast.AstType]
  [callables : (& callables ast.AstImportedSpmdCallableList)]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcSpmdExprInfo
  (match (tc-spmd-expr ctx expr-bases env spmd-env func)
    [(ResultTcSpmdExprInfo.Ok func-info)
      (match func-info
        [(TcSpmdExprInfo _ _ func-env)
          (match (tc-spmd-expr-list ctx expr-bases env func-env args)
            [(ResultTcSpmdExprListInfo.Ok args-info)
              (match args-info
                [(TcSpmdExprListInfo args-class args-env)
                  (tc-spmd-finish-ctx
                    ctx
                    expr-ty
                    (tc-spmd-imported-call-result-class
                      expr-ty
                      fn-ty
                      callables
                      args-class)
                    args-env)])]
            [(ResultTcSpmdExprListInfo.Err message)
              (ResultTcSpmdExprInfo.Err message)])])]
    [(ResultTcSpmdExprInfo.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-atomic-public-symbol? [symbol : String]) : bool
  (or
    (string.eq symbol "tl_atomic_i64_load")
    (string.eq symbol "tl_atomic_i64_store")
    (string.eq symbol "tl_atomic_i64_add")
    (string.eq symbol "tl_atomic_i64_fetch_add")
    (string.eq symbol "tl_atomic_i32_load")
    (string.eq symbol "tl_atomic_i32_store")
    (string.eq symbol "tl_atomic_i32_add")
    (string.eq symbol "tl_atomic_i32_fetch_add")))

(define (tc-spmd-atomic-public-name? [name : String]) : bool
  (or
    (string.eq name "atomic-i64-load")
    (string.eq name "atomic-i64-store!")
    (string.eq name "atomic-i64-add!")
    (string.eq name "atomic-i64-fetch-add!")
    (string.eq name "atomic-i32-load")
    (string.eq name "atomic-i32-store!")
    (string.eq name "atomic-i32-add!")
    (string.eq name "atomic-i32-fetch-add!")))

(define (tc-spmd-atomic-name-candidate? [name : String]) : bool
  (or
    (tc-spmd-atomic-public-name? name)
    (tc-spmd-atomic-public-symbol? name)
    (and
      (tc-name-qualified? name)
      (tc-spmd-atomic-public-name? (tc-qualified-name-base name)))))

(define (tc-spmd-atomic-symbol-for-name [name : String]) : String
  (cond
    [(string.eq name "atomic-i64-load") "tl_atomic_i64_load"]
    [(string.eq name "atomic-i64-store!") "tl_atomic_i64_store"]
    [(string.eq name "atomic-i64-add!") "tl_atomic_i64_add"]
    [(string.eq name "atomic-i64-fetch-add!") "tl_atomic_i64_fetch_add"]
    [(string.eq name "atomic-i32-load") "tl_atomic_i32_load"]
    [(string.eq name "atomic-i32-store!") "tl_atomic_i32_store"]
    [(string.eq name "atomic-i32-add!") "tl_atomic_i32_add"]
    [(string.eq name "atomic-i32-fetch-add!") "tl_atomic_i32_fetch_add"]
    [else ""]))

(define (tc-spmd-atomic-import-path? [path : String]) : bool
  (or (string.eq path "stdlib/atomic.tl") (string.eq path "atomic.tl")))

(define (tc-spmd-program-imports-atomic? [decls : ast.AstDeclList]) : bool
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) false]
    [(ast.AstDeclListStep.Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        (match decl
          [(ast.AstDecl.Import decl-meta (ast.AstImportSpec.Spec _ path _ _ _))
            (or
              (tc-spmd-atomic-import-path? path)
              (tc-spmd-program-imports-atomic? rest))]
          [_ (tc-spmd-program-imports-atomic? rest)]))]))

(define (tc-spmd-context-imports-atomic? [ctx : TcContext]) : bool
  (match ctx
    [(TcContext program _ _ _ _ _ _ _ _)
      (match program
        [(ast.AstProgram.Program decls-box)
          (tc-spmd-program-imports-atomic? (__tl-box-place decls-box))])]))

(define (tc-spmd-atomic-imported-symbol-for-name
  [ctx : TcContext]
  [name : String]) : TcMaybeString
  (if (and
    (tc-spmd-atomic-public-name? name)
    (tc-spmd-context-imports-atomic? ctx))
    (TcMaybeString.Some (tc-spmd-atomic-symbol-for-name name))
    (TcMaybeString.No)))

(define (tc-spmd-atomic-value-result? [symbol : String]) : bool
  (or
    (string.eq symbol "tl_atomic_i64_load")
    (string.eq symbol "tl_atomic_i64_fetch_add")
    (string.eq symbol "tl_atomic_i32_load")
    (string.eq symbol "tl_atomic_i32_fetch_add")))

(define (tc-spmd-atomic-extern-symbol-from-handle
  [symbols : csym.CompilerSymbols]
  [handle : i64]) : TcMaybeString
  (if (=
    (csym.compiler-symbol-handle-kind handle)
    (csym.compiler-symbol-kind-extern))
    (match (csym.compiler-symbols-decl-at-index
      symbols
      (csym.compiler-symbol-handle-index handle))
      [(parser.ResultAstDecl.Ok decl)
        (match decl
          [(ast.AstDecl.Extern decl-meta _ kind metadata _)
            (match kind
              [(ast.AstExternKind.Function)
                (let
                  [symbol : String
                    (ast.ast-extern-metadata-symbol (__tl-box-place metadata))]
                  (if (tc-spmd-atomic-public-symbol? symbol)
                    (TcMaybeString.Some symbol)
                    (TcMaybeString.No)))]
              [(ast.AstExternKind.Value) (TcMaybeString.No)])]
          [_ (TcMaybeString.No)])]
      [(parser.ResultAstDecl.Err _) (TcMaybeString.No)])
    (TcMaybeString.No)))

(define (tc-spmd-atomic-extern-symbol-lookup-id
  [symbols : csym.CompilerSymbols]
  [lookup-id : i64]) : TcMaybeString
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-value-id-or
        symbols
        lookup-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (tc-spmd-atomic-extern-symbol-from-handle symbols handle)
      (TcMaybeString.No))))

(define (tc-spmd-atomic-extern-symbol-for-name-id
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : TcMaybeString
  (if (not (tc-spmd-atomic-name-candidate? name))
    (TcMaybeString.No)
    (let
      [symbols : csym.CompilerSymbols (tc-context-symbols ctx)]
      [direct : TcMaybeString
        (tc-spmd-atomic-extern-symbol-lookup-id symbols name-id)]
      [source-name : String (tc-hygiene-global-symbol-name name)]
      (match direct
        [(TcMaybeString.Some symbol) (TcMaybeString.Some symbol)]
        [(TcMaybeString.No)
          (tc-spmd-atomic-imported-symbol-for-name ctx source-name)]))))

(define (tc-spmd-atomic-call-symbol
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [func : ast.AstExpr]) : ResultTcString
  (match (tc-spmd-inline-helper-resolve-name ctx env spmd-env func)
    [(TcNameLookup.Ok lookup-name lookup-id)
      (if (string.eq lookup-name "")
        (ResultTcString.Ok "")
        (match (tc-spmd-atomic-extern-symbol-for-name-id
          ctx
          lookup-name
          lookup-id)
          [(TcMaybeString.Some symbol) (ResultTcString.Ok symbol)]
          [(TcMaybeString.No) (ResultTcString.Ok "")]))]
    [(TcNameLookup.Err message)
      (if (string.eq message "")
        (ResultTcString.Ok "")
        (ResultTcString.Err message))]))

(define (tc-spmd-atomic-call-with-symbol
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : ast.AstType]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [symbol : String]) : ResultTcSpmdExprInfo
  (match (tc-spmd-expr ctx expr-bases env spmd-env func)
    [(ResultTcSpmdExprInfo.Ok func-info)
      (match func-info
        [(TcSpmdExprInfo _ _ func-env)
          (match (tc-spmd-expr-list ctx expr-bases env func-env args)
            [(ResultTcSpmdExprListInfo.Ok args-info)
              (match args-info
                [(TcSpmdExprListInfo args-class args-env)
                  (tc-spmd-finish
                    expr-ty
                    (if (tc-spmd-atomic-value-result? symbol)
                      args-class
                      TcSpmdClass.Uniform)
                    args-env)])]
            [(ResultTcSpmdExprListInfo.Err message)
              (ResultTcSpmdExprInfo.Err message)])])]
    [(ResultTcSpmdExprInfo.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-atomic-call
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : ast.AstType]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcSpmdExprInfo
  (match (tc-spmd-atomic-call-symbol ctx env spmd-env func)
    [(ResultTcString.Ok symbol)
      (if (string.eq symbol "")
        (tc-spmd-inline-call ctx expr-bases env spmd-env expr-ty func args)
        (tc-spmd-atomic-call-with-symbol
          ctx
          expr-bases
          env
          spmd-env
          expr-ty
          func
          args
          symbol))]
    [(ResultTcString.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-inline-call-inner
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : ast.AstType]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcSpmdExprInfo
  (match (tc-spmd-inline-helper-lookup ctx expr-bases env spmd-env func)
    [(ResultTcSpmdInlineHelper.Ok helper)
      (match helper
        [(TcSpmdInlineHelper.Some name-id module-id params _ body)
          (let
            [module : String (tc-spmd-inline-helper-module module-id)]
            [helper-ctx : TcContext
              (tc-context-with-module-id ctx module module-id)]
            [base-env : TcTypeEnv
              (tc-spmd-inline-helper-env ctx env module module-id)]
            [base-spmd-env : TcSpmdEnv
              (tc-spmd-env-mark-outer (tc-spmd-env-from-type-env base-env))]
            (match (tc-spmd-inline-helper-bind-args
              ctx
              expr-bases
              env
              spmd-env
              func
              helper-ctx
              base-env
              base-spmd-env
              params
              args
              TcSpmdClass.Uniform)
              [(ResultTcSpmdInlineCallState.Ok call-state)
                (match call-state
                  [(TcSpmdInlineCallState
                      caller-next
                      helper-env
                      helper-spmd-env
                      args-class)
                    (if (tc-spmd-varying? args-class)
                      (match (tc-spmd-inline-helper-body
                        helper-ctx
                        expr-bases
                        helper-env
                        helper-spmd-env
                        name-id
                        body)
                        [(ResultTcSpmdExprInfo.Ok body-info)
                          (match body-info
                            [(TcSpmdExprInfo _ body-class _)
                              (tc-spmd-finish expr-ty body-class caller-next)])]
                        [(ResultTcSpmdExprInfo.Err message)
                          (ResultTcSpmdExprInfo.Err message)])
                      (tc-spmd-finish expr-ty TcSpmdClass.Uniform caller-next))])]
              [(ResultTcSpmdInlineCallState.Err message)
                (ResultTcSpmdExprInfo.Err message)]))]
        [(TcSpmdInlineHelper.Imported fn-ty callables)
          (let
            [callable-items : ast.AstImportedSpmdCallableList
              (__tl-box-place callables)]
            (tc-spmd-imported-call
              ctx
              expr-bases
              env
              spmd-env
              expr-ty
              fn-ty
              (& callable-items)
              func
              args))]
        [(TcSpmdInlineHelper.No)
          (tc-spmd-call-uniform-only
            ctx
            expr-bases
            env
            spmd-env
            expr-ty
            func
            args)])]
    [(ResultTcSpmdInlineHelper.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-inline-call
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : ast.AstType]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcSpmdExprInfo
  (if (tc-type-env-scoped-runtime-active?)
    (let
      [saved : TcTypeEnvScopedRuntimeSave (tc-type-env-scoped-runtime-suspend!)]
      [result : ResultTcSpmdExprInfo
        (tc-spmd-inline-call-inner
          ctx
          expr-bases
          env
          spmd-env
          expr-ty
          func
          args)]
      (begin
        (tc-type-env-scoped-runtime-restore! saved)
        result))
    (tc-spmd-inline-call-inner ctx expr-bases env spmd-env expr-ty func args)))

(define (tc-spmd-masked-if-inline-helper-body
  [ctx : TcContext]
  [expr-bases : i64]
  [helper-env : TcTypeEnv]
  [helper-spmd-env : TcSpmdEnv]
  [name-id : i64]
  [body : ast.AstExpr]) : ResultTcUnit
  (let
    [previous : TcNameIdList tc-spmd-inline-helper-stack]
    [result : ResultTcUnit
      (ResultTcUnit.Err (tc-spmd-inline-helper-recursive-message))]
    (begin
      (set! tc-spmd-inline-helper-stack (tc-name-id-list-add previous name-id))
      (set!
        result
        (tc-spmd-masked-if-expr ctx expr-bases helper-env helper-spmd-env body))
      (set! tc-spmd-inline-helper-stack previous)
      result)))

(define (tc-spmd-masked-if-inline-call-inner
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcUnit
  (match (tc-spmd-inline-helper-lookup ctx expr-bases env spmd-env func)
    [(ResultTcSpmdInlineHelper.Ok helper)
      (match helper
        [(TcSpmdInlineHelper.Some name-id module-id params _ body)
          (let
            [module : String (tc-spmd-inline-helper-module module-id)]
            [helper-ctx : TcContext
              (tc-context-with-module-id ctx module module-id)]
            [base-env : TcTypeEnv
              (tc-spmd-inline-helper-env ctx env module module-id)]
            [base-spmd-env : TcSpmdEnv
              (tc-spmd-env-mark-outer (tc-spmd-env-from-type-env base-env))]
            (match (tc-spmd-inline-helper-bind-args
              ctx
              expr-bases
              env
              spmd-env
              func
              helper-ctx
              base-env
              base-spmd-env
              params
              args
              TcSpmdClass.Uniform)
              [(ResultTcSpmdInlineCallState.Ok call-state)
                (match call-state
                  [(TcSpmdInlineCallState _ helper-env helper-spmd-env _)
                    (tc-spmd-masked-if-inline-helper-body
                      helper-ctx
                      expr-bases
                      helper-env
                      helper-spmd-env
                      name-id
                      body)])]
              [(ResultTcSpmdInlineCallState.Err message)
                (ResultTcUnit.Err message)]))]
        [(TcSpmdInlineHelper.Imported _ _)
          (tc-spmd-masked-if-expr-list ctx expr-bases env spmd-env args)]
        [(TcSpmdInlineHelper.No)
          (tc-spmd-masked-if-unsupported "varying calls inside masked branches")])]
    [(ResultTcSpmdInlineHelper.Err message) (ResultTcUnit.Err message)]))

(define (tc-spmd-masked-if-inline-call
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcUnit
  (if (tc-type-env-scoped-runtime-active?)
    (let
      [saved : TcTypeEnvScopedRuntimeSave (tc-type-env-scoped-runtime-suspend!)]
      [result : ResultTcUnit
        (tc-spmd-masked-if-inline-call-inner
          ctx
          expr-bases
          env
          spmd-env
          func
          args)]
      (begin
        (tc-type-env-scoped-runtime-restore! saved)
        result))
    (tc-spmd-masked-if-inline-call-inner ctx expr-bases env spmd-env func args)))

(define (tc-spmd-masked-if-call
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match (tc-spmd-atomic-call-symbol ctx env spmd-env func)
    [(ResultTcString.Ok symbol)
      (if (string.eq symbol "")
        (tc-spmd-masked-if-inline-call ctx expr-bases env spmd-env func args)
        (match (tc-spmd-atomic-call-with-symbol
          ctx
          expr-bases
          env
          spmd-env
          (match (tc-expr ctx env expr)
            [(ResultTcType.Ok ty) ty]
            [(ResultTcType.Err _) (ast.AstType.Unit)])
          func
          args
          symbol)
          [(ResultTcSpmdExprInfo.Ok _) ResultTcUnit.Ok]
          [(ResultTcSpmdExprInfo.Err message) (ResultTcUnit.Err message)]))]
    [(ResultTcString.Err message) (ResultTcUnit.Err message)]))

(define (tc-spmd-masked-if-unsupported [detail : String]) : ResultTcUnit
  (ResultTcUnit.Err
    (str_cat.str-cat "typecheck: SPMD masked if does not support " detail)))

(define (tc-spmd-masked-if-result-type-supported? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(ast.AstType.Unit) true]
    [_ (tc-spmd-varying-value-type-supported? ty)]))

(define (tc-spmd-masked-if-result-type-ok [ty : ast.AstType]) : ResultTcUnit
  (if (tc-spmd-masked-if-result-type-supported? ty)
    ResultTcUnit.Ok
    (ResultTcUnit.Err
      (str_cat.str-cat
        "typecheck: SPMD masked if result type is not supported: "
        (tc-type-render (tc-type-strip-region ty))))))

(define (tc-spmd-masked-if-index-var? [spmd-env : TcSpmdEnv] [name-id : i64]) : bool
  (match (tc-spmd-env-lookup-id spmd-env name-id)
    [(TcSpmdLookup.Found
        _
        (TcSpmdClass.Varying)
        (TcSpmdScope.Local)
        (TcSpmdRole.ForeachIndex))
      true]
    [_ false]))

(define (tc-spmd-foreach-index-unsupported) : ResultTcUnit
  (ResultTcUnit.Err
    "typecheck: foreach does not support non-contiguous array element destination indexes; use the foreach index plus a uniform offset"))

(define (tc-spmd-foreach-uniform-offset
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match (tc-spmd-expr ctx expr-bases env spmd-env expr)
    [(ResultTcSpmdExprInfo.Ok info)
      (match info
        [(TcSpmdExprInfo _ class _)
          (if (tc-spmd-varying? class)
            (tc-spmd-foreach-index-unsupported)
            ResultTcUnit.Ok)])]
    [(ResultTcSpmdExprInfo.Err message) (ResultTcUnit.Err message)]))

(define (tc-spmd-foreach-direct-index
  [expr-bases : i64]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases expr)
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-spmd-foreach-direct-index expr-bases spmd-env inner))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-spmd-foreach-direct-index expr-bases spmd-env inner))]
    [(ast.AstExpr.Var name)
      (if (tc-spmd-masked-if-index-var? spmd-env name)
        ResultTcUnit.Ok
        (tc-spmd-foreach-index-unsupported))]
    [_ (tc-spmd-foreach-index-unsupported)]))

(define (tc-spmd-foreach-index
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases expr)
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-spmd-foreach-index ctx expr-bases env spmd-env inner))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-spmd-foreach-index ctx expr-bases env spmd-env inner))]
    [(ast.AstExpr.Binary op left-box right-box)
      (let
        [left : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases left-box)]
        [right : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases right-box)]
        (match op
          [(ast.AstBinOp.Add)
            (match (tc-spmd-foreach-direct-index expr-bases spmd-env left)
              [(ResultTcUnit.Ok)
                (tc-spmd-foreach-uniform-offset
                  ctx
                  expr-bases
                  env
                  spmd-env
                  right)]
              [(ResultTcUnit.Err _)
                (match (tc-spmd-foreach-direct-index expr-bases spmd-env right)
                  [(ResultTcUnit.Ok)
                    (tc-spmd-foreach-uniform-offset
                      ctx
                      expr-bases
                      env
                      spmd-env
                      left)]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
          [(ast.AstBinOp.Sub)
            (match (tc-spmd-foreach-direct-index expr-bases spmd-env left)
              [(ResultTcUnit.Ok)
                (tc-spmd-foreach-uniform-offset
                  ctx
                  expr-bases
                  env
                  spmd-env
                  right)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [_ (tc-spmd-foreach-index-unsupported)]))]
    [_
      (tc-spmd-foreach-direct-index
        expr-bases
        spmd-env
        (ast.ast-expr-unspan-with-segment-bases expr-bases expr))]))

(define (tc-spmd-masked-if-uniform-offset
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match (tc-spmd-expr ctx expr-bases env spmd-env expr)
    [(ResultTcSpmdExprInfo.Ok info)
      (match info
        [(TcSpmdExprInfo _ class _)
          (if (tc-spmd-varying? class)
            (tc-spmd-masked-if-unsupported
              "gather/scatter-like array indexes; use the foreach index plus a uniform offset")
            ResultTcUnit.Ok)])]
    [(ResultTcSpmdExprInfo.Err message) (ResultTcUnit.Err message)]))

(define (tc-spmd-masked-if-direct-index
  [expr-bases : i64]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases expr)
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-spmd-masked-if-direct-index expr-bases spmd-env inner))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-spmd-masked-if-direct-index expr-bases spmd-env inner))]
    [(ast.AstExpr.Var name)
      (if (tc-spmd-masked-if-index-var? spmd-env name)
        ResultTcUnit.Ok
        (tc-spmd-masked-if-unsupported
          "gather/scatter-like array indexes; use the foreach index plus a uniform offset"))]
    [_
      (tc-spmd-masked-if-unsupported
        "gather/scatter-like array indexes; use the foreach index plus a uniform offset")]))

(define (tc-spmd-masked-if-index
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases expr)
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-spmd-masked-if-index ctx expr-bases env spmd-env inner))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-spmd-masked-if-index ctx expr-bases env spmd-env inner))]
    [(ast.AstExpr.Binary op left-box right-box)
      (let
        [left : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases left-box)]
        [right : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases right-box)]
        (match op
          [(ast.AstBinOp.Add)
            (match (tc-spmd-masked-if-direct-index expr-bases spmd-env left)
              [(ResultTcUnit.Ok)
                (tc-spmd-masked-if-uniform-offset
                  ctx
                  expr-bases
                  env
                  spmd-env
                  right)]
              [(ResultTcUnit.Err _)
                (match (tc-spmd-masked-if-direct-index
                  expr-bases
                  spmd-env
                  right)
                  [(ResultTcUnit.Ok)
                    (tc-spmd-masked-if-uniform-offset
                      ctx
                      expr-bases
                      env
                      spmd-env
                      left)]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
          [(ast.AstBinOp.Sub)
            (match (tc-spmd-masked-if-direct-index expr-bases spmd-env left)
              [(ResultTcUnit.Ok)
                (tc-spmd-masked-if-uniform-offset
                  ctx
                  expr-bases
                  env
                  spmd-env
                  right)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [_
            (tc-spmd-masked-if-unsupported
              "gather/scatter-like array indexes; use the foreach index plus a uniform offset")]))]
    [_
      (tc-spmd-masked-if-direct-index
        expr-bases
        spmd-env
        (ast.ast-expr-unspan-with-segment-bases expr-bases expr))]))

(define (tc-spmd-masked-if-lane-type-ok [ty : ast.AstType]) : ResultTcUnit
  (if (tc-spmd-lane-type-supported? ty)
    ResultTcUnit.Ok
    (ResultTcUnit.Err
      (str_cat.str-cat
        "typecheck: SPMD masked if lane type is not supported: "
        (tc-type-render (tc-type-strip-region ty))))))

(define (tc-spmd-masked-if-expr-list
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [exprs : ast.AstExprList]) : ResultTcUnit
  (tc-spmd-masked-if-expr-list-at ctx expr-bases env spmd-env (& exprs) 0))

(define (tc-spmd-masked-if-expr-list-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : ResultTcUnit
  (if (>= index exprs.len)
    ResultTcUnit.Ok
    (match (tc-spmd-masked-if-expr
      ctx
      expr-bases
      env
      spmd-env
      (ast.ast-expr-segment-bases-get
        expr-bases
        (ast.ast-expr-list-get exprs index 0)))
      [(ResultTcUnit.Ok)
        (tc-spmd-masked-if-expr-list-at
          ctx
          expr-bases
          env
          spmd-env
          exprs
          (+ index 1))]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

(define (tc-spmd-masked-if-let-bindings
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [bindings : ast.AstLetBindingList]
  [mark : TcSpmdEnvMark]) : ResultTcSpmdLetState
  (tc-spmd-masked-if-let-bindings-at
    ctx
    expr-bases
    env
    spmd-env
    (& bindings)
    mark
    0))

(define (tc-spmd-masked-if-let-bindings-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [bindings : (& bindings ast.AstLetBindingList)]
  [mark : TcSpmdEnvMark]
  [index : i64]) : ResultTcSpmdLetState
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (ResultTcSpmdLetState.Ok (TcSpmdLetState env spmd-env mark))
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          (match (tc-spmd-masked-if-expr ctx expr-bases env spmd-env init)
            [(ResultTcUnit.Ok)
              (match (tc-spmd-expr ctx expr-bases env spmd-env init)
                [(ResultTcSpmdExprInfo.Ok info)
                  (match info
                    [(TcSpmdExprInfo init-ty init-class next-spmd-env)
                      (let
                        [bound-ty : ast.AstType
                          (match maybe-ty
                            [(ast.AstMaybeType.Some want)
                              (if (tc-type-contains-any-region init-ty)
                                init-ty
                                (tc-resolve-type ctx want))]
                            [(ast.AstMaybeType.No) init-ty])]
                        (tc-spmd-masked-if-let-bindings-at
                          ctx
                          expr-bases
                          (tc-bind-id env name bound-ty)
                          (tc-spmd-env-bind-id
                            next-spmd-env
                            name
                            bound-ty
                            init-class
                            TcSpmdScope.Local)
                          bindings
                          mark
                          (+ index 1)))])]
                [(ResultTcSpmdExprInfo.Err message)
                  (ResultTcSpmdLetState.Err message)])]
            [(ResultTcUnit.Err message) (ResultTcSpmdLetState.Err message)]))])))

(define (tc-spmd-masked-if-expr
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (tc-spmd-masked-if-expr-unspanned
    ctx
    expr-bases
    env
    spmd-env
    (ast.ast-expr-unspan-with-segment-bases expr-bases expr)))

(define (tc-spmd-masked-if-expr-unspanned
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match expr
    [(ast.AstExpr.Literal _) ResultTcUnit.Ok]
    [(ast.AstExpr.Var _) ResultTcUnit.Ok]
    [(ast.AstExpr.TypeLiteral _) ResultTcUnit.Ok]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-spmd-masked-if-expr ctx expr-bases env spmd-env inner))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-spmd-masked-if-expr ctx expr-bases env spmd-env inner))]
    [(ast.AstExpr.Unary _ inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-spmd-masked-if-expr ctx expr-bases env spmd-env inner))]
    [(ast.AstExpr.Binary _ left-box right-box)
      (let
        [left : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases left-box)]
        [right : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases right-box)]
        (match (tc-spmd-masked-if-expr ctx expr-bases env spmd-env left)
          [(ResultTcUnit.Ok)
            (tc-spmd-masked-if-expr ctx expr-bases env spmd-env right)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(ast.AstExpr.Let let-box)
      (match (__tl-box-place let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (match (tc-spmd-masked-if-let-bindings
              ctx
              expr-bases
              env
              spmd-env
              bindings
              (tc-spmd-env-mark spmd-env))
              [(ResultTcSpmdLetState.Ok state)
                (match state
                  [(TcSpmdLetState body-env body-spmd-env _)
                    (tc-spmd-masked-if-expr
                      ctx
                      expr-bases
                      body-env
                      body-spmd-env
                      body)])]
              [(ResultTcSpmdLetState.Err message) (ResultTcUnit.Err message)]))])]
    [(ast.AstExpr.If cond-box then-box else-box)
      (let
        [cond : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases cond-box)]
        [then-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases then-box)]
        [else-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases else-box)]
        (match (tc-spmd-masked-if-expr ctx expr-bases env spmd-env cond)
          [(ResultTcUnit.Ok)
            (match (tc-spmd-masked-if-expr
              ctx
              expr-bases
              env
              spmd-env
              then-branch)
              [(ResultTcUnit.Ok)
                (tc-spmd-masked-if-expr ctx expr-bases env spmd-env else-branch)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(ast.AstExpr.Begin exprs)
      (tc-spmd-masked-if-expr-list ctx expr-bases env spmd-env exprs)]
    [(ast.AstExpr.ArrayRef array-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (match (tc-spmd-masked-if-expr ctx expr-bases env spmd-env array)
          [(ResultTcUnit.Ok)
            (match (tc-spmd-masked-if-index ctx expr-bases env spmd-env index)
              [(ResultTcUnit.Ok)
                (match (tc-expr ctx env expr)
                  [(ResultTcType.Ok ty) (tc-spmd-masked-if-lane-type-ok ty)]
                  [(ResultTcType.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(ast.AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (match (tc-spmd-masked-if-expr ctx expr-bases env spmd-env array)
          [(ResultTcUnit.Ok)
            (match (tc-spmd-masked-if-index ctx expr-bases env spmd-env index)
              [(ResultTcUnit.Ok)
                (match (tc-spmd-masked-if-expr
                  ctx
                  expr-bases
                  env
                  spmd-env
                  value)
                  [(ResultTcUnit.Ok)
                    (match (tc-expr ctx env value)
                      [(ResultTcType.Ok ty) (tc-spmd-masked-if-lane-type-ok ty)]
                      [(ResultTcType.Err message) (ResultTcUnit.Err message)])]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(ast.AstExpr.ArrayTake _ _ _)
      (ResultTcUnit.Err
        "typecheck: array-take! is not supported in masked spmd control flow")]
    [(ast.AstExpr.FixedArrayTake _ _)
      (ResultTcUnit.Err
        "typecheck: array-take! is not supported in masked spmd control flow")]
    [(ast.AstExpr.Replace _ _)
      (ResultTcUnit.Err
        "typecheck: replace! is not supported in masked spmd control flow")]
    [(ast.AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases receiver-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (match (tc-spmd-masked-if-expr ctx expr-bases env spmd-env receiver)
          [(ResultTcUnit.Ok)
            (match (tc-spmd-masked-if-expr ctx expr-bases env spmd-env value)
              [(ResultTcUnit.Ok)
                (match (tc-expr ctx env value)
                  [(ResultTcType.Ok ty) (tc-spmd-masked-if-lane-type-ok ty)]
                  [(ResultTcType.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(ast.AstExpr.Call func-box args)
      (let
        [func : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases func-box)]
        (tc-spmd-masked-if-call ctx expr-bases env spmd-env func args expr))]
    [(ast.AstExpr.Syscall _)
      (tc-spmd-masked-if-unsupported "varying calls inside masked branches")]
    [(ast.AstExpr.While cond-box body-box)
      (let
        [cond : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases cond-box)]
        [body : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases body-box)]
        (match (tc-spmd-masked-if-expr ctx expr-bases env spmd-env cond)
          [(ResultTcUnit.Ok)
            (match (tc-spmd-expr ctx expr-bases env spmd-env cond)
              [(ResultTcSpmdExprInfo.Ok cond-info)
                (match cond-info
                  [(TcSpmdExprInfo _ cond-class cond-env)
                    (if (tc-spmd-varying? cond-class)
                      (tc-spmd-masked-if-expr ctx expr-bases env cond-env body)
                      (tc-spmd-masked-if-unsupported
                        "uniform while inside masked branches"))])]
              [(ResultTcSpmdExprInfo.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(ast.AstExpr.Match match-box)
      (match (__tl-box-place match-box)
        [(ast.AstMatch.Match scrutinee-box arms)
          (tc-spmd-masked-if-match
            ctx
            expr-bases
            env
            spmd-env
            (ast.ast-expr-segment-bases-get expr-bases scrutinee-box)
            arms)])]
    [(ast.AstExpr.Foreach _)
      (tc-spmd-masked-if-unsupported "nested foreach inside masked branches")]
    [(ast.AstExpr.SpmdReduce _)
      (tc-spmd-masked-if-unsupported
        "nested spmd-reduce inside masked branches")]
    [(ast.AstExpr.SpmdScan _)
      (tc-spmd-masked-if-unsupported "nested spmd-scan inside masked branches")]
    [(ast.AstExpr.SpmdBroadcast _ _)
      (tc-spmd-masked-if-unsupported "spmd-broadcast inside masked branches")]
    [(ast.AstExpr.SpmdShuffle _ _)
      (tc-spmd-masked-if-unsupported "spmd-shuffle inside masked branches")]
    [(ast.AstExpr.SpmdProgramIndex) ResultTcUnit.Ok]
    [(ast.AstExpr.SpmdProgramCount) ResultTcUnit.Ok]
    [(ast.AstExpr.Set _ _)
      (tc-spmd-masked-if-unsupported
        "side effects other than contiguous array writes inside masked branches")]
    [(ast.AstExpr.ArrayPush _ _)
      (tc-spmd-masked-if-unsupported
        "side effects other than contiguous array writes inside masked branches")]
    [(ast.AstExpr.BoxSet _ _)
      (tc-spmd-masked-if-unsupported
        "side effects other than contiguous array writes inside masked branches")]
    [(ast.AstExpr.PtrWrite _ _)
      (tc-spmd-masked-if-unsupported
        "side effects other than contiguous array writes inside masked branches")]
    [(ast.AstExpr.MakeArray _ _)
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [(ast.AstExpr.Array _)
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [(ast.AstExpr.DynArray _)
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [(ast.AstExpr.Box _)
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [(ast.AstExpr.BoxTake _)
      (tc-spmd-masked-if-unsupported "move from Box inside masked branches")]
    [(ast.AstExpr.WithRegion _ _)
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [(ast.AstExpr.WithEscape _ _)
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [(ast.AstExpr.WithScratch _)
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [(ast.AstExpr.InArena _ _)
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [_
      (tc-spmd-masked-if-unsupported
        "this branch shape in the masked-control-flow subset")]))

(define (tc-spmd-masked-if
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : ast.AstType]
  [then-branch : ast.AstExpr]
  [else-branch : ast.AstExpr]) : ResultTcSpmdExprInfo
  (match (tc-spmd-masked-if-result-type-ok expr-ty)
    [(ResultTcUnit.Ok)
      (match (tc-spmd-masked-if-expr ctx expr-bases env spmd-env then-branch)
        [(ResultTcUnit.Ok)
          (match (tc-spmd-masked-if-expr
            ctx
            expr-bases
            env
            spmd-env
            else-branch)
            [(ResultTcUnit.Ok)
              (match (tc-type-strip-region expr-ty)
                [(ast.AstType.Unit)
                  (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
                [_ (tc-spmd-finish expr-ty TcSpmdClass.Varying spmd-env)])]
            [(ResultTcUnit.Err message) (ResultTcSpmdExprInfo.Err message)])]
        [(ResultTcUnit.Err message) (ResultTcSpmdExprInfo.Err message)])]
    [(ResultTcUnit.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-let-bindings
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [bindings : ast.AstLetBindingList]
  [mark : TcSpmdEnvMark]) : ResultTcSpmdLetState
  (tc-spmd-let-bindings-at ctx expr-bases env spmd-env (& bindings) mark 0))

(define (tc-spmd-let-bindings-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [bindings : (& bindings ast.AstLetBindingList)]
  [mark : TcSpmdEnvMark]
  [index : i64]) : ResultTcSpmdLetState
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (ResultTcSpmdLetState.Ok (TcSpmdLetState env spmd-env mark))
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          (match (tc-spmd-expr ctx expr-bases env spmd-env init)
            [(ResultTcSpmdExprInfo.Ok info)
              (match info
                [(TcSpmdExprInfo init-ty init-class next-spmd-env)
                  (let
                    [bound-ty : ast.AstType
                      (match maybe-ty
                        [(ast.AstMaybeType.Some want)
                          (if (tc-type-contains-any-region init-ty)
                            init-ty
                            (tc-resolve-type ctx want))]
                        [(ast.AstMaybeType.No) init-ty])]
                    (tc-spmd-let-bindings-at
                      ctx
                      expr-bases
                      (tc-bind-id env name bound-ty)
                      (tc-spmd-env-bind-id
                        next-spmd-env
                        name
                        bound-ty
                        init-class
                        TcSpmdScope.Local)
                      bindings
                      mark
                      (+ index 1)))])]
            [(ResultTcSpmdExprInfo.Err message)
              (ResultTcSpmdLetState.Err message)]))])))

(define (tc-spmd-expr-list
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [exprs : ast.AstExprList]) : ResultTcSpmdExprListInfo
  (tc-spmd-expr-list-at ctx expr-bases env spmd-env (& exprs) 0))

(define (tc-spmd-expr-list-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : ResultTcSpmdExprListInfo
  (if (>= index exprs.len)
    (ResultTcSpmdExprListInfo.Ok
      (TcSpmdExprListInfo TcSpmdClass.Uniform spmd-env))
    (let
      [expr : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get exprs index 0))]
      (match (tc-spmd-expr ctx expr-bases env spmd-env expr)
        [(ResultTcSpmdExprInfo.Ok info)
          (match info
            [(TcSpmdExprInfo _ class next-spmd-env)
              (match (tc-spmd-expr-list-at
                ctx
                expr-bases
                env
                next-spmd-env
                exprs
                (+ index 1))
                [(ResultTcSpmdExprListInfo.Ok rest-info)
                  (match rest-info
                    [(TcSpmdExprListInfo rest-class rest-env)
                      (ResultTcSpmdExprListInfo.Ok
                        (TcSpmdExprListInfo
                          (tc-spmd-merge-class class rest-class)
                          rest-env))])]
                [(ResultTcSpmdExprListInfo.Err message)
                  (ResultTcSpmdExprListInfo.Err message)])])]
        [(ResultTcSpmdExprInfo.Err message)
          (ResultTcSpmdExprListInfo.Err message)]))))

(define (tc-spmd-begin-list
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [exprs : ast.AstExprList]) : ResultTcSpmdExprInfo
  (tc-spmd-begin-list-at ctx expr-bases env spmd-env (& exprs) 0))

(define (tc-spmd-begin-list-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : ResultTcSpmdExprInfo
  (if (>= index exprs.len)
    (ResultTcSpmdExprInfo.Ok
      (TcSpmdExprInfo (ast.AstType.Unit) TcSpmdClass.Uniform spmd-env))
    (let
      [expr : ast.AstExpr
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get exprs index 0))]
      (if (= (+ index 1) exprs.len)
        (tc-spmd-expr ctx expr-bases env spmd-env expr)
        (match (tc-spmd-expr ctx expr-bases env spmd-env expr)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ _ next-spmd-env)
                (tc-spmd-begin-list-at
                  ctx
                  expr-bases
                  env
                  next-spmd-env
                  exprs
                  (+ index 1))])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)])))))

(define (tc-spmd-match-pattern-binding-supported?
  [class : TcSpmdClass]
  [ty : ast.AstType]) : bool
  (if (tc-spmd-varying? class)
    (tc-spmd-lane-type-supported? ty)
    true))

(define (tc-spmd-match-pattern-binding-diagnostic [ty : ast.AstType]) : String
  (str_cat.str-cat
    "typecheck: foreach varying match pattern binding type is not supported: "
    (tc-type-render (tc-type-strip-region ty))))

(define (tc-spmd-pattern-bound-names
  [ctx : TcContext]
  [scrut-ty : ast.AstType]
  [pattern : ast.AstPattern]) : TcNameIdList
  (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
    [(ast.AstType.Enum _)
      (match pattern
        [(ast.AstPattern.Variant _ args-box)
          (tc-pattern-list-add-bound-name-ids
            (__tl-box-place args-box)
            TcNameIdList.Nil)]
        [_ TcNameIdList.Nil])]
    [(ast.AstType.EnumArgs _ _)
      (match pattern
        [(ast.AstPattern.Variant _ args-box)
          (tc-pattern-list-add-bound-name-ids
            (__tl-box-place args-box)
            TcNameIdList.Nil)]
        [_ TcNameIdList.Nil])]
    [_ (tc-pattern-add-bound-name-ids pattern TcNameIdList.Nil)]))

(define (tc-spmd-match-bind-pattern-names
  [arm-env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [names : TcNameIdList]
  [class : TcSpmdClass]) : ResultTcSpmdEnv
  (if (tc-name-id-list-empty? names)
    (ResultTcSpmdEnv.Ok spmd-env)
    (let
      [name-id : i64 (tc-name-id-list-head names)]
      (match (tc-lookup-id arm-env name-id)
        [(ResultTcType.Ok ty)
          (if (tc-spmd-match-pattern-binding-supported? class ty)
            (tc-spmd-match-bind-pattern-names
              arm-env
              (tc-spmd-env-bind-id spmd-env name-id ty class TcSpmdScope.Local)
              (tc-name-id-list-rest names)
              class)
            (ResultTcSpmdEnv.Err (tc-spmd-match-pattern-binding-diagnostic ty)))]
        [(ResultTcType.Err message) (ResultTcSpmdEnv.Err message)]))))

(define (tc-spmd-masked-if-match-arms
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [scrut-ty : ast.AstType]
  [scrut-class : TcSpmdClass]
  [arms : ast.AstMatchArmList]) : ResultTcUnit
  (tc-spmd-masked-if-match-arms-at
    ctx
    expr-bases
    env
    spmd-env
    scrut-ty
    scrut-class
    (& arms)
    0))

(define (tc-spmd-masked-if-match-arms-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [scrut-ty : ast.AstType]
  [scrut-class : TcSpmdClass]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : ResultTcUnit
  (if (>= index arms.len)
    ResultTcUnit.Ok
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm pattern body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          (match (tc-bind-match-pattern ctx env scrut-ty pattern)
            [(ResultTcEnv.Ok arm-env)
              (match (tc-spmd-match-bind-pattern-names
                arm-env
                spmd-env
                (tc-spmd-pattern-bound-names ctx scrut-ty pattern)
                scrut-class)
                [(ResultTcSpmdEnv.Ok arm-spmd-env)
                  (match (tc-spmd-masked-if-expr
                    ctx
                    expr-bases
                    arm-env
                    arm-spmd-env
                    body)
                    [(ResultTcUnit.Ok)
                      (tc-spmd-masked-if-match-arms-at
                        ctx
                        expr-bases
                        env
                        spmd-env
                        scrut-ty
                        scrut-class
                        arms
                        (+ index 1))]
                    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
                [(ResultTcSpmdEnv.Err message) (ResultTcUnit.Err message)])]
            [(ResultTcEnv.Err message) (ResultTcUnit.Err message)]))])))

(define (tc-spmd-masked-if-match
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [scrutinee : ast.AstExpr]
  [arms : ast.AstMatchArmList]) : ResultTcUnit
  (match (tc-spmd-masked-if-expr ctx expr-bases env spmd-env scrutinee)
    [(ResultTcUnit.Ok)
      (match (tc-spmd-expr ctx expr-bases env spmd-env scrutinee)
        [(ResultTcSpmdExprInfo.Ok scrut-info)
          (match scrut-info
            [(TcSpmdExprInfo scrut-ty scrut-class scrut-env)
              (tc-spmd-masked-if-match-arms
                ctx
                expr-bases
                env
                scrut-env
                scrut-ty
                scrut-class
                arms)])]
        [(ResultTcSpmdExprInfo.Err message) (ResultTcUnit.Err message)])]
    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))

(define (tc-spmd-match-arms
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [scrut-ty : ast.AstType]
  [scrut-class : TcSpmdClass]
  [arms : ast.AstMatchArmList]
  [class : TcSpmdClass]) : ResultTcSpmdExprListInfo
  (tc-spmd-match-arms-at
    ctx
    expr-bases
    env
    spmd-env
    scrut-ty
    scrut-class
    (& arms)
    class
    0))

(define (tc-spmd-match-arms-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [scrut-ty : ast.AstType]
  [scrut-class : TcSpmdClass]
  [arms : (& arms ast.AstMatchArmList)]
  [class : TcSpmdClass]
  [index : i64]) : ResultTcSpmdExprListInfo
  (if (>= index arms.len)
    (ResultTcSpmdExprListInfo.Ok (TcSpmdExprListInfo class spmd-env))
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm pattern body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          [mark : TcSpmdEnvMark (tc-spmd-env-mark spmd-env)]
          (match (tc-bind-match-pattern ctx env scrut-ty pattern)
            [(ResultTcEnv.Ok arm-env)
              (match (tc-spmd-match-bind-pattern-names
                arm-env
                spmd-env
                (tc-spmd-pattern-bound-names ctx scrut-ty pattern)
                scrut-class)
                [(ResultTcSpmdEnv.Ok arm-spmd-env)
                  (match (tc-spmd-expr ctx expr-bases arm-env arm-spmd-env body)
                    [(ResultTcSpmdExprInfo.Ok body-info)
                      (match body-info
                        [(TcSpmdExprInfo _ body-class body-env)
                          (match (tc-spmd-match-arms-at
                            ctx
                            expr-bases
                            env
                            spmd-env
                            scrut-ty
                            scrut-class
                            arms
                            (tc-spmd-merge-class class body-class)
                            (+ index 1))
                            [(ResultTcSpmdExprListInfo.Ok rest-info)
                              (match rest-info
                                [(TcSpmdExprListInfo rest-class rest-env)
                                  (ResultTcSpmdExprListInfo.Ok
                                    (TcSpmdExprListInfo
                                      rest-class
                                      (tc-spmd-env-merge-classes
                                        (tc-spmd-env-restore body-env mark)
                                        rest-env)))])]
                            [(ResultTcSpmdExprListInfo.Err message)
                              (ResultTcSpmdExprListInfo.Err message)])])]
                    [(ResultTcSpmdExprInfo.Err message)
                      (ResultTcSpmdExprListInfo.Err message)])]
                [(ResultTcSpmdEnv.Err message)
                  (ResultTcSpmdExprListInfo.Err message)])]
            [(ResultTcEnv.Err message) (ResultTcSpmdExprListInfo.Err message)]))])))

(define (tc-spmd-check-foreach-body-with-env
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [index-id : i64]
  [index-ty : ast.AstType]
  [body : ast.AstExpr]) : ResultTcUnit
  (let
    [body-env : TcTypeEnv (tc-bind-id env index-id index-ty)]
    [body-spmd-env : TcSpmdEnv
      (tc-spmd-env-bind-role-id
        (tc-spmd-env-mark-outer spmd-env)
        index-id
        index-ty
        TcSpmdClass.Varying
        TcSpmdScope.Local
        TcSpmdRole.ForeachIndex)]
    [result : ResultTcUnit ResultTcUnit.Ok]
    (begin
      (tc-spmd-inline-helper-stack-reset!)
      (set!
        result
        (match (tc-spmd-expr ctx expr-bases body-env body-spmd-env body)
          [(ResultTcSpmdExprInfo.Ok _) ResultTcUnit.Ok]
          [(ResultTcSpmdExprInfo.Err message) (ResultTcUnit.Err message)]))
      (tc-spmd-inline-helper-stack-reset!)
      result)))

(define (tc-spmd-check-foreach-body
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [index-id : i64]
  [index-ty : ast.AstType]
  [body : ast.AstExpr]) : ResultTcUnit
  (tc-spmd-check-foreach-body-with-env
    ctx
    expr-bases
    env
    (tc-spmd-env-from-type-env env)
    index-id
    index-ty
    body))

(define (tc-spmd-scan-body-no-nested-list
  [expr-bases : i64]
  [exprs : ast.AstExprList]) : ResultTcUnit
  (tc-spmd-scan-body-no-nested-list-at expr-bases (& exprs) 0))

(define (tc-spmd-scan-body-no-nested-list-at
  [expr-bases : i64]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : ResultTcUnit
  (if (>= index exprs.len)
    ResultTcUnit.Ok
    (match (tc-spmd-scan-body-no-nested-spmd
      expr-bases
      (ast.ast-expr-segment-bases-get
        expr-bases
        (ast.ast-expr-list-get exprs index 0)))
      [(ResultTcUnit.Ok)
        (tc-spmd-scan-body-no-nested-list-at expr-bases exprs (+ index 1))]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

(define (tc-spmd-scan-body-no-nested-pair
  [expr-bases : i64]
  [left : ast.AstExpr]
  [right : ast.AstExpr]) : ResultTcUnit
  (match (tc-spmd-scan-body-no-nested-spmd expr-bases left)
    [(ResultTcUnit.Ok) (tc-spmd-scan-body-no-nested-spmd expr-bases right)]
    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))

(define (tc-spmd-scan-body-no-nested-triple
  [expr-bases : i64]
  [first : ast.AstExpr]
  [second : ast.AstExpr]
  [third : ast.AstExpr]) : ResultTcUnit
  (match (tc-spmd-scan-body-no-nested-pair expr-bases first second)
    [(ResultTcUnit.Ok) (tc-spmd-scan-body-no-nested-spmd expr-bases third)]
    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))

(define (tc-spmd-scan-body-no-nested-let-bindings
  [expr-bases : i64]
  [bindings : ast.AstLetBindingList]) : ResultTcUnit
  (tc-spmd-scan-body-no-nested-let-bindings-at expr-bases (& bindings) 0))

(define (tc-spmd-scan-body-no-nested-let-bindings-at
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast.ast-let-binding-list-len bindings))
    ResultTcUnit.Ok
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding _ _ init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          (match (tc-spmd-scan-body-no-nested-spmd expr-bases init)
            [(ResultTcUnit.Ok)
              (tc-spmd-scan-body-no-nested-let-bindings-at
                expr-bases
                bindings
                (+ index 1))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])))

(define (tc-spmd-scan-body-no-nested-resource-bindings
  [expr-bases : i64]
  [bindings : ast.AstResourceBindingList]) : ResultTcUnit
  (tc-spmd-scan-body-no-nested-resource-bindings-at expr-bases (& bindings) 0))

(define (tc-spmd-scan-body-no-nested-resource-bindings-at
  [expr-bases : i64]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    ResultTcUnit.Ok
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(ast.AstResourceBinding.Binding _ init-box cleanup-box _)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [cleanup : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases cleanup-box)]
          (match (tc-spmd-scan-body-no-nested-pair expr-bases init cleanup)
            [(ResultTcUnit.Ok)
              (tc-spmd-scan-body-no-nested-resource-bindings-at
                expr-bases
                bindings
                (+ index 1))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])))

(define (tc-spmd-scan-body-no-nested-arms
  [expr-bases : i64]
  [arms : ast.AstMatchArmList]) : ResultTcUnit
  (tc-spmd-scan-body-no-nested-arms-at expr-bases (& arms) 0))

(define (tc-spmd-scan-body-no-nested-arms-at
  [expr-bases : i64]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : ResultTcUnit
  (if (>= index arms.len)
    ResultTcUnit.Ok
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm _ body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          (match (tc-spmd-scan-body-no-nested-spmd expr-bases body)
            [(ResultTcUnit.Ok)
              (tc-spmd-scan-body-no-nested-arms-at expr-bases arms (+ index 1))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])))

(define (tc-spmd-scan-body-no-nested-spmd
  [expr-bases : i64]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases expr)
    [(ast.AstExpr.Binary _ left-box right-box)
      (tc-spmd-scan-body-no-nested-pair
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases left-box)
        (ast.ast-expr-segment-bases-get expr-bases right-box))]
    [(ast.AstExpr.Unary _ inner-box)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.Call func-box args)
      (match (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases func-box))
        [(ResultTcUnit.Ok) (tc-spmd-scan-body-no-nested-list expr-bases args)]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [(ast.AstExpr.If cond-box then-box else-box)
      (tc-spmd-scan-body-no-nested-triple
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases cond-box)
        (ast.ast-expr-segment-bases-get expr-bases then-box)
        (ast.ast-expr-segment-bases-get expr-bases else-box))]
    [(ast.AstExpr.Let let-box)
      (match (__tl-box-place let-box)
        [(ast.AstLet.Let bindings body-box)
          (match (tc-spmd-scan-body-no-nested-let-bindings expr-bases bindings)
            [(ResultTcUnit.Ok)
              (tc-spmd-scan-body-no-nested-spmd
                expr-bases
                (ast.ast-expr-segment-bases-get expr-bases body-box))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
    [(ast.AstExpr.Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(ast.AstLambda.Lambda _ _ body-box)
          (tc-spmd-scan-body-no-nested-spmd
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases body-box))])]
    [(ast.AstExpr.Tuple exprs)
      (tc-spmd-scan-body-no-nested-list expr-bases exprs)]
    [(ast.AstExpr.TupleRef tuple-box index-box)
      (tc-spmd-scan-body-no-nested-pair
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases tuple-box)
        (ast.ast-expr-segment-bases-get expr-bases index-box))]
    [(ast.AstExpr.Array exprs)
      (tc-spmd-scan-body-no-nested-list expr-bases exprs)]
    [(ast.AstExpr.DynArray exprs)
      (tc-spmd-scan-body-no-nested-list expr-bases exprs)]
    [(ast.AstExpr.MakeArray _ len-box)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases len-box))]
    [(ast.AstExpr.ArrayRef array-box index-box)
      (tc-spmd-scan-body-no-nested-pair
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases array-box)
        (ast.ast-expr-segment-bases-get expr-bases index-box))]
    [(ast.AstExpr.ArraySet array-box index-box value-box)
      (tc-spmd-scan-body-no-nested-triple
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases array-box)
        (ast.ast-expr-segment-bases-get expr-bases index-box)
        (ast.ast-expr-segment-bases-get expr-bases value-box))]
    [(ast.AstExpr.ArrayTake array-box live-box index-box)
      (tc-spmd-scan-body-no-nested-triple
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases array-box)
        (ast.ast-expr-segment-bases-get expr-bases live-box)
        (ast.ast-expr-segment-bases-get expr-bases index-box))]
    [(ast.AstExpr.FixedArrayTake array-box index-box)
      (tc-spmd-scan-body-no-nested-pair
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases array-box)
        (ast.ast-expr-segment-bases-get expr-bases index-box))]
    [(ast.AstExpr.Replace place-box replacement-box)
      (tc-spmd-scan-body-no-nested-pair
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases place-box)
        (ast.ast-expr-segment-bases-get expr-bases replacement-box))]
    [(ast.AstExpr.ArrayPush array-box value-box)
      (tc-spmd-scan-body-no-nested-pair
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases array-box)
        (ast.ast-expr-segment-bases-get expr-bases value-box))]
    [(ast.AstExpr.StringRef str-box index-box)
      (tc-spmd-scan-body-no-nested-pair
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases str-box)
        (ast.ast-expr-segment-bases-get expr-bases index-box))]
    [(ast.AstExpr.While cond-box body-box)
      (tc-spmd-scan-body-no-nested-pair
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases cond-box)
        (ast.ast-expr-segment-bases-get expr-bases body-box))]
    [(ast.AstExpr.Begin exprs)
      (tc-spmd-scan-body-no-nested-list expr-bases exprs)]
    [(ast.AstExpr.Unsafe exprs)
      (tc-spmd-scan-body-no-nested-list expr-bases exprs)]
    [(ast.AstExpr.Set _ value-box)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases value-box))]
    [(ast.AstExpr.Ann inner-box _)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.Cast inner-box _)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.Borrow _ _ place-box)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases place-box))]
    [(ast.AstExpr.Match match-box)
      (match (__tl-box-place match-box)
        [(ast.AstMatch.Match scrutinee-box arms)
          (match (tc-spmd-scan-body-no-nested-spmd
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases scrutinee-box))
            [(ResultTcUnit.Ok)
              (tc-spmd-scan-body-no-nested-arms expr-bases arms)]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
    [(ast.AstExpr.Foreach _)
      (ResultTcUnit.Err
        "typecheck: nested foreach inside spmd-scan is not supported")]
    [(ast.AstExpr.SpmdReduce _)
      (ResultTcUnit.Err
        "typecheck: nested spmd-reduce inside spmd-scan is not supported")]
    [(ast.AstExpr.SpmdScan _)
      (ResultTcUnit.Err
        "typecheck: nested spmd-scan inside spmd-scan is not supported")]
    [(ast.AstExpr.SpmdBroadcast value-box lane-box)
      (tc-spmd-scan-body-no-nested-pair
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases value-box)
        (ast.ast-expr-segment-bases-get expr-bases lane-box))]
    [(ast.AstExpr.SpmdShuffle value-box lane-box)
      (tc-spmd-scan-body-no-nested-pair
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases value-box)
        (ast.ast-expr-segment-bases-get expr-bases lane-box))]
    [(ast.AstExpr.SpmdProgramIndex)
      (ResultTcUnit.Err
        "typecheck: program-index is not supported inside spmd-scan body")]
    [(ast.AstExpr.SpmdProgramCount)
      (ResultTcUnit.Err
        "typecheck: program-count is not supported inside spmd-scan body")]
    [(ast.AstExpr.StructGet receiver-box _)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases receiver-box))]
    [(ast.AstExpr.StructSet receiver-box _ value-box)
      (tc-spmd-scan-body-no-nested-pair
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases receiver-box)
        (ast.ast-expr-segment-bases-get expr-bases value-box))]
    [(ast.AstExpr.WithRegion _ body)
      (tc-spmd-scan-body-no-nested-list expr-bases body)]
    [(ast.AstExpr.WithEscape scratch-box body)
      (match (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases scratch-box))
        [(ResultTcUnit.Ok) (tc-spmd-scan-body-no-nested-list expr-bases body)]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [(ast.AstExpr.WithScratch body)
      (tc-spmd-scan-body-no-nested-list expr-bases body)]
    [(ast.AstExpr.InArena arena-box body)
      (match (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases arena-box))
        [(ResultTcUnit.Ok) (tc-spmd-scan-body-no-nested-list expr-bases body)]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [(ast.AstExpr.WithResource wr-box)
      (match (__tl-box-place wr-box)
        [(ast.AstWithResource.WithResource bindings body)
          (match (tc-spmd-scan-body-no-nested-resource-bindings
            expr-bases
            bindings)
            [(ResultTcUnit.Ok)
              (tc-spmd-scan-body-no-nested-list expr-bases body)]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
    [(ast.AstExpr.Box inner-box)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.BoxGet inner-box)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.BoxTake inner-box)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.BoxSet inner-box value-box)
      (tc-spmd-scan-body-no-nested-pair
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box)
        (ast.ast-expr-segment-bases-get expr-bases value-box))]
    [(ast.AstExpr.Comptime inner-box)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.Quote _) ResultTcUnit.Ok]
    [(ast.AstExpr.Quasiquote _) ResultTcUnit.Ok]
    [(ast.AstExpr.Unquote inner-box)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.UnquoteSplicing inner-box)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.BracketClause items)
      (tc-spmd-scan-body-no-nested-list expr-bases items)]
    [(ast.AstExpr.Try inner-box)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.Return inner-box)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.PtrNullCheck inner-box)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(ast.AstExpr.PtrRead ptr-box)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases ptr-box))]
    [(ast.AstExpr.PtrWrite ptr-box value-box)
      (tc-spmd-scan-body-no-nested-pair
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases ptr-box)
        (ast.ast-expr-segment-bases-get expr-bases value-box))]
    [(ast.AstExpr.PtrOffset ptr-box offset-box)
      (tc-spmd-scan-body-no-nested-pair
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases ptr-box)
        (ast.ast-expr-segment-bases-get expr-bases offset-box))]
    [(ast.AstExpr.PtrCast ptr-box _)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases ptr-box))]
    [(ast.AstExpr.PtrToInt ptr-box)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases ptr-box))]
    [(ast.AstExpr.IntToPtr value-box _)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases value-box))]
    [(ast.AstExpr.StringData str-box)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases str-box))]
    [(ast.AstExpr.StringFromBytes ptr-box len-box)
      (tc-spmd-scan-body-no-nested-pair
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases ptr-box)
        (ast.ast-expr-segment-bases-get expr-bases len-box))]
    [(ast.AstExpr.ArrayData array-box)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases array-box))]
    [(ast.AstExpr.CpuIdEax leaf-box subleaf-box)
      (tc-spmd-scan-body-no-nested-pair
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases leaf-box)
        (ast.ast-expr-segment-bases-get expr-bases subleaf-box))]
    [(ast.AstExpr.CpuIdEbx leaf-box subleaf-box)
      (tc-spmd-scan-body-no-nested-pair
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases leaf-box)
        (ast.ast-expr-segment-bases-get expr-bases subleaf-box))]
    [(ast.AstExpr.CpuIdEcx leaf-box subleaf-box)
      (tc-spmd-scan-body-no-nested-pair
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases leaf-box)
        (ast.ast-expr-segment-bases-get expr-bases subleaf-box))]
    [(ast.AstExpr.CpuIdEdx leaf-box subleaf-box)
      (tc-spmd-scan-body-no-nested-pair
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases leaf-box)
        (ast.ast-expr-segment-bases-get expr-bases subleaf-box))]
    [(ast.AstExpr.Xgetbv index-box)
      (tc-spmd-scan-body-no-nested-spmd
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases index-box))]
    [(ast.AstExpr.Syscall args)
      (tc-spmd-scan-body-no-nested-list expr-bases args)]
    [_ ResultTcUnit.Ok]))

(define (tc-spmd-check-scan-body
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [index-id : i64]
  [index-ty : ast.AstType]
  [prefix-id : i64]
  [prefix-ty : ast.AstType]
  [body : ast.AstExpr]) : ResultTcUnit
  (let
    [index-env : TcTypeEnv (tc-bind-id env index-id index-ty)]
    [body-env : TcTypeEnv (tc-bind-id index-env prefix-id prefix-ty)]
    [base-spmd-env : TcSpmdEnv
      (tc-spmd-env-mark-outer (tc-spmd-env-from-type-env env))]
    [index-spmd-env : TcSpmdEnv
      (tc-spmd-env-bind-role-id
        base-spmd-env
        index-id
        index-ty
        TcSpmdClass.Varying
        TcSpmdScope.Local
        TcSpmdRole.ForeachIndex)]
    [body-spmd-env : TcSpmdEnv
      (tc-spmd-env-bind-id
        index-spmd-env
        prefix-id
        prefix-ty
        TcSpmdClass.Varying
        TcSpmdScope.Local)]
    [result : ResultTcUnit ResultTcUnit.Ok]
    (match (tc-spmd-scan-body-no-nested-spmd expr-bases body)
      [(ResultTcUnit.Ok)
        (begin
          (tc-spmd-inline-helper-stack-reset!)
          (set!
            result
            (match (tc-spmd-expr ctx expr-bases body-env body-spmd-env body)
              [(ResultTcSpmdExprInfo.Ok _) ResultTcUnit.Ok]
              [(ResultTcSpmdExprInfo.Err message) (ResultTcUnit.Err message)]))
          (tc-spmd-inline-helper-stack-reset!)
          result)]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

;; `spmd-reduce` allows varying bool values for `all`/`any`, so it cannot reuse
;; the full foreach body checker: that checker applies foreach array-lane
;; restrictions to the entire expression. This path only classifies the reduce
;; value enough to enforce nested cross-lane value/lane rules.
(define (tc-spmd-reduce-class-finish
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]
  [class : TcSpmdClass]) : ResultTcSpmdExprInfo
  (match (tc-expr ctx env expr)
    [(ResultTcType.Ok ty) (tc-spmd-finish ty class spmd-env)]
    [(ResultTcType.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-reduce-class-with-expected-or-actual
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcSpmdExprInfo
  (match (tc-spmd-reduce-class ctx expr-bases env spmd-env expr)
    [(ResultTcSpmdExprInfo.Ok info)
      (match info
        [(TcSpmdExprInfo _ class next-spmd-env)
          (match (tc-expr-with-expected-or-actual ctx env expr expected)
            [(ResultTcType.Ok ty) (tc-spmd-finish ty class next-spmd-env)]
            [(ResultTcType.Err message) (ResultTcSpmdExprInfo.Err message)])])]
    [(ResultTcSpmdExprInfo.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-reduce-let-bindings
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [bindings : ast.AstLetBindingList]
  [mark : TcSpmdEnvMark]) : ResultTcSpmdLetState
  (tc-spmd-reduce-let-bindings-at
    ctx
    expr-bases
    env
    spmd-env
    (& bindings)
    mark
    0))

(define (tc-spmd-reduce-let-bindings-at
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [bindings : (& bindings ast.AstLetBindingList)]
  [mark : TcSpmdEnvMark]
  [index : i64]) : ResultTcSpmdLetState
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (ResultTcSpmdLetState.Ok (TcSpmdLetState env spmd-env mark))
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          (match (tc-spmd-reduce-class ctx expr-bases env spmd-env init)
            [(ResultTcSpmdExprInfo.Ok info)
              (match info
                [(TcSpmdExprInfo init-ty init-class next-spmd-env)
                  (let
                    [bound-ty : ast.AstType
                      (match maybe-ty
                        [(ast.AstMaybeType.Some want)
                          (if (tc-type-contains-any-region init-ty)
                            init-ty
                            (tc-resolve-type ctx want))]
                        [(ast.AstMaybeType.No) init-ty])]
                    (tc-spmd-reduce-let-bindings-at
                      ctx
                      expr-bases
                      (tc-bind-id env name bound-ty)
                      (tc-spmd-env-bind-id
                        next-spmd-env
                        name
                        bound-ty
                        init-class
                        TcSpmdScope.Local)
                      bindings
                      mark
                      (+ index 1)))])]
            [(ResultTcSpmdExprInfo.Err message)
              (ResultTcSpmdLetState.Err message)]))])))

(define (tc-spmd-reduce-class
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcSpmdExprInfo
  (tc-spmd-reduce-class-unspanned
    ctx
    expr-bases
    env
    spmd-env
    (ast.ast-expr-unspan-with-segment-bases expr-bases expr)))

(define (tc-spmd-reduce-class-unspanned
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcSpmdExprInfo
  (match expr
    [(ast.AstExpr.Literal _)
      (tc-spmd-reduce-class-finish ctx env spmd-env expr TcSpmdClass.Uniform)]
    [(ast.AstExpr.SpmdProgramIndex)
      (tc-spmd-reduce-class-finish ctx env spmd-env expr TcSpmdClass.Varying)]
    [(ast.AstExpr.SpmdProgramCount)
      (tc-spmd-reduce-class-finish ctx env spmd-env expr TcSpmdClass.Uniform)]
    [(ast.AstExpr.Var name)
      (if (tc-dotted-place-name-id? ctx env name)
        (match (tc-dotted-local-field-expr-id-after-check name)
          [(ResultTcExprId.Ok virtual-id)
            (tc-spmd-reduce-class
              ctx
              expr-bases
              env
              spmd-env
              (ast.ast-expr-segment-bases-get expr-bases virtual-id))]
          [(ResultTcExprId.Err message) (ResultTcSpmdExprInfo.Err message)])
        (match (tc-spmd-env-lookup-id spmd-env name)
          [(TcSpmdLookup.Found _ class _ _)
            (tc-spmd-reduce-class-finish ctx env spmd-env expr class)]
          [(TcSpmdLookup.Missing)
            (tc-spmd-reduce-class-finish
              ctx
              env
              spmd-env
              expr
              TcSpmdClass.Uniform)]))]
    [(ast.AstExpr.Binary _ left-box right-box)
      (let
        [left : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases left-box)]
        [right : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases right-box)]
        (match (tc-spmd-reduce-class ctx expr-bases env spmd-env left)
          [(ResultTcSpmdExprInfo.Ok left-info)
            (match left-info
              [(TcSpmdExprInfo _ left-class left-env)
                (match (tc-spmd-reduce-class ctx expr-bases env left-env right)
                  [(ResultTcSpmdExprInfo.Ok right-info)
                    (match right-info
                      [(TcSpmdExprInfo _ right-class right-env)
                        (tc-spmd-reduce-class-finish
                          ctx
                          env
                          right-env
                          expr
                          (tc-spmd-merge-class left-class right-class))])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.Unary _ inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (match (tc-spmd-reduce-class ctx expr-bases env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-reduce-class-finish ctx env next-spmd-env expr class)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (match (tc-spmd-reduce-class ctx expr-bases env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-reduce-class-finish ctx env next-spmd-env expr class)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (match (tc-spmd-reduce-class ctx expr-bases env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-reduce-class-finish ctx env next-spmd-env expr class)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.Let let-box)
      (match (__tl-box-place let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (match (tc-spmd-reduce-let-bindings
              ctx
              expr-bases
              env
              spmd-env
              bindings
              (tc-spmd-env-mark spmd-env))
              [(ResultTcSpmdLetState.Ok state)
                (match state
                  [(TcSpmdLetState body-env body-spmd-env mark)
                    (match (tc-spmd-reduce-class
                      ctx
                      expr-bases
                      body-env
                      body-spmd-env
                      body)
                      [(ResultTcSpmdExprInfo.Ok body-info)
                        (match body-info
                          [(TcSpmdExprInfo _ body-class final-spmd-env)
                            (tc-spmd-reduce-class-finish
                              ctx
                              env
                              (tc-spmd-env-restore final-spmd-env mark)
                              expr
                              body-class)])]
                      [(ResultTcSpmdExprInfo.Err message)
                        (ResultTcSpmdExprInfo.Err message)])])]
              [(ResultTcSpmdLetState.Err message)
                (ResultTcSpmdExprInfo.Err message)]))])]
    [(ast.AstExpr.ArrayRef array-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (match (tc-spmd-reduce-class ctx expr-bases env spmd-env array)
          [(ResultTcSpmdExprInfo.Ok array-info)
            (match array-info
              [(TcSpmdExprInfo _ array-class array-env)
                (match (tc-spmd-reduce-class ctx expr-bases env array-env index)
                  [(ResultTcSpmdExprInfo.Ok index-info)
                    (match index-info
                      [(TcSpmdExprInfo _ index-class index-env)
                        (tc-spmd-reduce-class-finish
                          ctx
                          env
                          index-env
                          expr
                          (tc-spmd-merge-class array-class index-class))])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [lane : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases lane-box)]
        (match (tc-spmd-reduce-class ctx expr-bases env spmd-env value)
          [(ResultTcSpmdExprInfo.Ok value-info)
            (match value-info
              [(TcSpmdExprInfo _ value-class value-env)
                (match (tc-spmd-reduce-class-with-expected-or-actual
                  ctx
                  expr-bases
                  env
                  value-env
                  lane
                  (ast.AstType.I64))
                  [(ResultTcSpmdExprInfo.Ok lane-info)
                    (match lane-info
                      [(TcSpmdExprInfo lane-ty lane-class lane-env)
                        (match (tc-expr ctx env expr)
                          [(ResultTcType.Ok expr-ty)
                            (tc-spmd-broadcast-finish
                              ctx
                              expr-ty
                              value-class
                              lane-ty
                              lane-class
                              lane-env)]
                          [(ResultTcType.Err message)
                            (ResultTcSpmdExprInfo.Err message)])])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [lane : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases lane-box)]
        (match (tc-spmd-reduce-class ctx expr-bases env spmd-env value)
          [(ResultTcSpmdExprInfo.Ok value-info)
            (match value-info
              [(TcSpmdExprInfo _ value-class value-env)
                (match (tc-spmd-reduce-class-with-expected-or-actual
                  ctx
                  expr-bases
                  env
                  value-env
                  lane
                  (ast.AstType.I64))
                  [(ResultTcSpmdExprInfo.Ok lane-info)
                    (match lane-info
                      [(TcSpmdExprInfo lane-ty _ lane-env)
                        (match (tc-expr ctx env expr)
                          [(ResultTcType.Ok expr-ty)
                            (tc-spmd-shuffle-finish
                              ctx
                              expr-ty
                              value-class
                              lane-ty
                              lane-env)]
                          [(ResultTcType.Err message)
                            (ResultTcSpmdExprInfo.Err message)])])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [_ (tc-spmd-reduce-class-finish ctx env spmd-env expr TcSpmdClass.Uniform)]))

(define (tc-spmd-check-reduce-value-broadcasts
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [index-id : i64]
  [index-ty : ast.AstType]
  [value : ast.AstExpr]) : ResultTcUnit
  (let
    [value-env : TcTypeEnv (tc-bind-id env index-id index-ty)]
    [value-spmd-env : TcSpmdEnv
      (tc-spmd-env-bind-role-id
        (tc-spmd-env-mark-outer (tc-spmd-env-from-type-env env))
        index-id
        index-ty
        TcSpmdClass.Varying
        TcSpmdScope.Local
        TcSpmdRole.ForeachIndex)]
    (match (tc-spmd-reduce-class ctx expr-bases value-env value-spmd-env value)
      [(ResultTcSpmdExprInfo.Ok _) ResultTcUnit.Ok]
      [(ResultTcSpmdExprInfo.Err message) (ResultTcUnit.Err message)])))

(define (tc-spmd-expr
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]) : ResultTcSpmdExprInfo
  (match (tc-expr ctx env expr)
    [(ResultTcType.Ok ty)
      (tc-spmd-expr-typed ctx expr-bases env spmd-env expr ty)]
    [(ResultTcType.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-expr-with-expected-or-actual
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcSpmdExprInfo
  (match (tc-expr-with-expected-or-actual ctx env expr expected)
    [(ResultTcType.Ok ty)
      (tc-spmd-expr-typed ctx expr-bases env spmd-env expr ty)]
    [(ResultTcType.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-array-value-expr
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [array-ty : ast.AstType]
  [value : ast.AstExpr]) : ResultTcSpmdExprInfo
  (match (tc-type-strip-region (tc-resolve-type ctx array-ty))
    [(ast.AstType.Array elem-ty _)
      (tc-spmd-expr-with-expected-or-actual
        ctx
        expr-bases
        env
        spmd-env
        value
        (ast.ty-node-get elem-ty))]
    [(ast.AstType.DynArray elem-ty)
      (tc-spmd-expr-with-expected-or-actual
        ctx
        expr-bases
        env
        spmd-env
        value
        (ast.ty-node-get elem-ty))]
    [_ (tc-spmd-expr ctx expr-bases env spmd-env value)]))

(define (tc-spmd-array-length-call? [func : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan func)
    [(ast.AstExpr.Var raw-name)
      (let
        [hygiene-global : bool (tc-hygiene-global-name-id? raw-name)]
        [name-id : i64 (tc-builtin-call-name-id raw-name hygiene-global)]
        (cbi.compiler-builtin-typecheck-array-length-id? name-id))]
    [_ false]))

(define (tc-spmd-array-length-call
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : ast.AstType]
  [args : ast.AstExprList]) : ResultTcSpmdExprInfo
  (match (tc-spmd-expr-list ctx expr-bases env spmd-env args)
    [(ResultTcSpmdExprListInfo.Ok info)
      (match info
        [(TcSpmdExprListInfo class next-env)
          (tc-spmd-finish expr-ty class next-env)])]
    [(ResultTcSpmdExprListInfo.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-for-owned-state
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [source-name : i64]
  [index-name : i64]
  [source : i64]
  [body : i64]
  [expr-ty : ast.AstType]) : ResultTcSpmdExprInfo
  (let
    [source-expr : ast.AstExpr
      (ast.ast-expr-segment-bases-get expr-bases source)]
    [body-expr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases body)]
    [source-name-id : i64 (tc-for-owned-name-id expr-bases source-name)]
    [index-name-id : i64 (tc-for-owned-name-id expr-bases index-name)]
    (match (tc-spmd-expr ctx expr-bases env spmd-env source-expr)
      [(ResultTcSpmdExprInfo.Ok source-info)
        (match source-info
          [(TcSpmdExprInfo source-ty source-class source-env)
            (let
              [mark : TcSpmdEnvMark (tc-spmd-env-mark source-env)]
              [body-env : TcTypeEnv
                (tc-bind-id
                  (tc-bind-id env source-name-id source-ty)
                  index-name-id
                  (ast.AstType.I64))]
              [body-spmd-env : TcSpmdEnv
                (tc-spmd-env-bind-id
                  (tc-spmd-env-bind-id
                    source-env
                    source-name-id
                    source-ty
                    source-class
                    TcSpmdScope.Local)
                  index-name-id
                  (ast.AstType.I64)
                  TcSpmdClass.Uniform
                  TcSpmdScope.Local)]
              (match (tc-spmd-expr
                ctx
                expr-bases
                body-env
                body-spmd-env
                body-expr)
                [(ResultTcSpmdExprInfo.Ok body-info)
                  (match body-info
                    [(TcSpmdExprInfo _ body-class final-env)
                      (tc-spmd-finish
                        expr-ty
                        body-class
                        (tc-spmd-env-restore final-env mark))])]
                [(ResultTcSpmdExprInfo.Err message)
                  (ResultTcSpmdExprInfo.Err message)]))])]
      [(ResultTcSpmdExprInfo.Err message) (ResultTcSpmdExprInfo.Err message)])))

(define (tc-spmd-for-owned-step-body
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [binding-name : i64]
  [body : i64]
  [elem-ty : ast.AstType]
  [item-class : TcSpmdClass]
  [expr-ty : ast.AstType]) : ResultTcSpmdExprInfo
  (let
    [binding-name-id : i64 (tc-for-owned-name-id expr-bases binding-name)]
    [mark : TcSpmdEnvMark (tc-spmd-env-mark spmd-env)]
    [body-env : TcTypeEnv (tc-bind-id env binding-name-id elem-ty)]
    [body-spmd-env : TcSpmdEnv
      (tc-spmd-env-bind-id
        spmd-env
        binding-name-id
        elem-ty
        item-class
        TcSpmdScope.Local)]
    [body-expr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases body)]
    (match (tc-spmd-expr ctx expr-bases body-env body-spmd-env body-expr)
      [(ResultTcSpmdExprInfo.Ok body-info)
        (match body-info
          [(TcSpmdExprInfo _ body-class final-env)
            (tc-spmd-finish
              expr-ty
              body-class
              (tc-spmd-env-restore final-env mark))])]
      [(ResultTcSpmdExprInfo.Err message) (ResultTcSpmdExprInfo.Err message)])))

(define (tc-spmd-for-owned-step
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [source-name : i64]
  [index-name : i64]
  [binding-name : i64]
  [done-name : i64]
  [body : i64]
  [expr-ty : ast.AstType]) : ResultTcSpmdExprInfo
  (let
    [source-expr : ast.AstExpr
      (ast.ast-expr-segment-bases-get expr-bases source-name)]
    [index-expr : ast.AstExpr
      (ast.ast-expr-segment-bases-get expr-bases index-name)]
    [done-expr : ast.AstExpr
      (ast.ast-expr-segment-bases-get expr-bases done-name)]
    (match (tc-spmd-expr ctx expr-bases env spmd-env source-expr)
      [(ResultTcSpmdExprInfo.Ok source-info)
        (match source-info
          [(TcSpmdExprInfo source-ty source-class source-env)
            (match (tc-spmd-expr ctx expr-bases env source-env index-expr)
              [(ResultTcSpmdExprInfo.Ok index-info)
                (match index-info
                  [(TcSpmdExprInfo _ index-class index-env)
                    (match (tc-spmd-expr ctx expr-bases env index-env done-expr)
                      [(ResultTcSpmdExprInfo.Ok done-info)
                        (match done-info
                          [(TcSpmdExprInfo _ done-class done-env)
                            (match (tc-type-strip-region
                              (tc-resolve-type ctx source-ty))
                              [(ast.AstType.Array elem-id _)
                                (tc-spmd-for-owned-step-body
                                  ctx
                                  expr-bases
                                  env
                                  done-env
                                  binding-name
                                  body
                                  (tc-context-type-get ctx elem-id)
                                  (tc-spmd-merge-class
                                    source-class
                                    (tc-spmd-merge-class index-class done-class))
                                  expr-ty)]
                              [_
                                (ResultTcSpmdExprInfo.Err
                                  "typecheck: scalar for owned step requires fixed-array state")])])]
                      [(ResultTcSpmdExprInfo.Err message)
                        (ResultTcSpmdExprInfo.Err message)])])]
              [(ResultTcSpmdExprInfo.Err message)
                (ResultTcSpmdExprInfo.Err message)])])]
      [(ResultTcSpmdExprInfo.Err message) (ResultTcSpmdExprInfo.Err message)])))

(define (tc-spmd-expr-typed
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : ast.AstExpr]
  [expr-ty : ast.AstType]) : ResultTcSpmdExprInfo
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-spmd-expr-typed ctx expr-bases env spmd-env inner expr-ty))]
    [(ast.AstExpr.MacroExpansion inner-box _ _)
      (tc-spmd-expr-typed
        ctx
        expr-bases
        env
        spmd-env
        (ast.ast-expr-segment-bases-get expr-bases inner-box)
        expr-ty)]
    [(ast.AstExpr.ForOwnedState payload)
      (tc-spmd-for-owned-state
        ctx
        expr-bases
        env
        spmd-env
        (ast.ast-for-owned-state-source-name (& payload))
        (ast.ast-for-owned-state-index-name (& payload))
        (ast.ast-for-owned-state-source (& payload))
        (ast.ast-for-owned-state-body (& payload))
        expr-ty)]
    [(ast.AstExpr.ForOwnedStep payload)
      (tc-spmd-for-owned-step
        ctx
        expr-bases
        env
        spmd-env
        (ast.ast-for-owned-step-source-name (& payload))
        (ast.ast-for-owned-step-index-name (& payload))
        (ast.ast-for-owned-step-binding-name (& payload))
        (ast.ast-for-owned-step-done-name (& payload))
        (ast.ast-for-owned-step-body (& payload))
        expr-ty)]
    [(ast.AstExpr.Literal _)
      (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(ast.AstExpr.SpmdProgramIndex)
      (tc-spmd-finish expr-ty TcSpmdClass.Varying spmd-env)]
    [(ast.AstExpr.SpmdProgramCount)
      (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(ast.AstExpr.Var name)
      (if (tc-dotted-place-name-id? ctx env name)
        (match (tc-dotted-local-field-expr-id-after-check name)
          [(ResultTcExprId.Ok virtual-id)
            (tc-spmd-expr-typed
              ctx
              expr-bases
              env
              spmd-env
              (ast.ast-expr-segment-bases-get expr-bases virtual-id)
              expr-ty)]
          [(ResultTcExprId.Err message) (ResultTcSpmdExprInfo.Err message)])
        (match (tc-spmd-env-lookup-id spmd-env name)
          [(TcSpmdLookup.Found _ class _ _)
            (tc-spmd-finish-ctx ctx expr-ty class spmd-env)]
          [(TcSpmdLookup.Missing)
            (tc-spmd-finish-ctx ctx expr-ty TcSpmdClass.Uniform spmd-env)]))]
    [(ast.AstExpr.TypeLiteral _)
      (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(ast.AstExpr.Init _) (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish-ctx ctx expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish-ctx ctx expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.Unary _ inner-box)
      (let
