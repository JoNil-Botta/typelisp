(define (tc-spmd-env-box-smoke?) : bool
  (let
    [lane-id : i64 (ci.intern "lane")]
    [idx-id : i64 (ci.intern "idx")]
    [x-id : i64 (ci.intern "x")]
    [flag-id : i64 (ci.intern "flag")]
    [env : TcTypeEnv
      (tc-bind-id
        (tc-bind-id (tc-empty-env) x-id (ast.AstType.I64))
        flag-id
        (ast.AstType.Bool))]
    [shadow-env : TcTypeEnv
      (tc-bind-id
        (tc-bind-id (tc-empty-env) x-id (ast.AstType.I64))
        x-id
        (ast.AstType.Bool))]
    [shadow-spmd : TcSpmdEnv (tc-spmd-env-from-type-env shadow-env)]
    [outer : TcSpmdEnv (tc-spmd-env-from-type-env env)]
    [local : TcSpmdEnv
      (tc-spmd-env-bind-id
        outer
        lane-id
        (ast.AstType.I64)
        TcSpmdClass.Varying
        TcSpmdScope.Local)]
    [updated : TcSpmdEnv
      (tc-spmd-env-set-local-class-id local lane-id TcSpmdClass.Uniform)]
    [indexed : TcSpmdEnv
      (tc-spmd-env-bind-role-id
        updated
        idx-id
        (ast.AstType.I64)
        TcSpmdClass.Uniform
        TcSpmdScope.Local
        TcSpmdRole.ForeachIndex)]
    [marked-outer : TcSpmdEnv (tc-spmd-env-mark-outer indexed)]
    [branch-right : TcSpmdEnv
      (tc-spmd-env-set-local-class-id indexed lane-id TcSpmdClass.Varying)]
    [merged : TcSpmdEnv (tc-spmd-env-merge-classes indexed branch-right)]
    [restore-mark : TcSpmdEnvMark (tc-spmd-env-mark outer)]
    [restored : TcSpmdEnv (tc-spmd-env-restore updated restore-mark)]
    (and
      (match (tc-spmd-env-lookup-id updated lane-id)
        [(TcSpmdLookup.Found
            (ast.AstType.I64)
            (TcSpmdClass.Uniform)
            (TcSpmdScope.Local)
            (TcSpmdRole.Value))
          true]
        [_ false])
      (tc-spmd-env-has-local-id? updated lane-id)
      (tc-spmd-env-has-outer-id? updated x-id)
      (match (tc-spmd-env-lookup-id shadow-spmd x-id)
        [(TcSpmdLookup.Found
            (ast.AstType.Bool)
            (TcSpmdClass.Uniform)
            (TcSpmdScope.Outer)
            (TcSpmdRole.Value))
          true]
        [_ false])
      (match (tc-spmd-env-lookup-id marked-outer idx-id)
        [(TcSpmdLookup.Found
            (ast.AstType.I64)
            (TcSpmdClass.Uniform)
            (TcSpmdScope.Outer)
            (TcSpmdRole.ForeachIndex))
          true]
        [_ false])
      (not (tc-spmd-env-has-local-id? marked-outer lane-id))
      (tc-spmd-env-has-outer-id? marked-outer lane-id)
      (match (tc-spmd-env-lookup-id merged lane-id)
        [(TcSpmdLookup.Found
            (ast.AstType.I64)
            (TcSpmdClass.Varying)
            (TcSpmdScope.Local)
            (TcSpmdRole.Value))
          true]
        [_ false])
      (match (tc-spmd-env-lookup-id merged idx-id)
        [(TcSpmdLookup.Found
            (ast.AstType.I64)
            (TcSpmdClass.Uniform)
            (TcSpmdScope.Local)
            (TcSpmdRole.ForeachIndex))
          true]
        [_ false])
      (match (tc-spmd-env-lookup-id (tc-spmd-env-pop updated 1) lane-id)
        [(TcSpmdLookup.Missing) true]
        [_ false])
      (match (tc-spmd-env-lookup-id restored lane-id)
        [(TcSpmdLookup.Missing) true]
        [_ false]))))

(define (tc-literal-type [lit : ast.AstLiteral]) : ast.AstType
  (match lit
    [(ast.AstLiteral.Int _ _) (ast.AstType.I32)]
    [(ast.AstLiteral.Float _) (ast.AstType.F64)]
    [(ast.AstLiteral.Bool _) (ast.AstType.Bool)]
    [(ast.AstLiteral.Char _) (ast.AstType.Char)]
    [(ast.AstLiteral.String _) (ast.AstType.String)]
    [(ast.AstLiteral.Unit) (ast.AstType.Unit)]))

(define (tc-param-type-list-into
  [ctx : TcContext]
  [params : (& params ast.AstParamList)]
  [index : i64]
  [out : (&mut out ast.AstTypeList)]) : unit
  (if (>= index (ast.ast-param-list-len params))
    unit
    (begin
      (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
        [(ast.AstParam.Param _ ty _ consume?)
          (let
            [resolved : ast.AstType (tc-resolve-type ctx ty)]
            (ast.ast-type-list-push
              out
              (ast.ast-node-pool-reader-type-push
                (if consume?
                  (ast.ast-ty-consume resolved)
                  resolved))))])
      (tc-param-type-list-into ctx params (+ index 1) out))))

(define (tc-param-type-list [ctx : TcContext] [params : ast.AstParamList]) : ast.AstTypeList
  (let
    [out : ast.AstTypeList
      (ast.ast-type-list-with-capacity (ast.ast-param-list-len (& params)))]
    (begin
      (tc-param-type-list-into ctx (& params) 0 (&mut out))
      out)))

(define (tc-macro-param-type-list-into
  [ctx : TcContext]
  [params : (& params ast.AstMacroParamList)]
  [index : i64]
  [out : (&mut out ast.AstTypeList)]) : unit
  (if (>= index (ast.ast-macro-param-list-len params))
    unit
    (begin
      (match (ast.ast-macro-param-list-get
        params
        index
        (ast.ast-macro-param-fallback))
        [(ast.AstMacroParam.Param _ ty _ _)
          (ast.ast-type-list-push
            out
            (ast.ast-node-pool-reader-type-push
              (tc-resolve-type ctx (tc-macro-signature-type ty))))])
      (tc-macro-param-type-list-into ctx params (+ index 1) out))))

(define (tc-macro-param-type-list
  [ctx : TcContext]
  [params : ast.AstMacroParamList]) : ast.AstTypeList
  (let
    [out : ast.AstTypeList
      (ast.ast-type-list-with-capacity
        (ast.ast-macro-param-list-len (& params)))]
    (begin
      (tc-macro-param-type-list-into ctx (& params) 0 (&mut out))
      out)))

(define (tc-type-list-ref [types : ast.AstTypeList] [index : i64]) : ResultTcType
  (if (or (< index 0) (>= index (ast.ast-type-list-len (& types))))
    (ResultTcType.Err "typecheck: tuple index out of bounds")
    (ResultTcType.Ok
      (ast.ty-node-get
        (ast.ast-type-list-get (& types) index (ast.ast-type-id-fallback))))))

(define (tc-expr-list-len [exprs : ast.AstExprList]) : i64
  exprs.len)

(define (tc-expr-list-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]) : ResultTcTypeList
  (let
    [out : ast.AstTypeList (ast.ast-type-list-new)]
    (match (tc-expr-list-types-into-at ctx env (& exprs) 0 (&mut out))
      [(ResultTcUnit.Ok) (ResultTcTypeList.Ok out)]
      [(ResultTcUnit.Err message) (ResultTcTypeList.Err message)])))

(define (tc-expr-list-types-into-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [out : (&mut out ast.AstTypeList)]) : ResultTcUnit
  (if (>= index exprs.len)
    ResultTcUnit.Ok
    (match (tc-expr-id ctx env (ast.ast-expr-list-get exprs index 0))
      [(ResultTcType.Ok ty)
        (begin
          (ast.ast-type-list-push out (ast.ast-node-pool-reader-type-push ty))
          (tc-expr-list-types-into-at ctx env exprs (+ index 1) out))]
      [(ResultTcType.Err message) (ResultTcUnit.Err message)])))

(define (tc-check-array-rest
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]
  [elem-ty : ast.AstType]) : ResultTcUnit
  (tc-check-array-rest-at ctx env (& exprs) 0 elem-ty))

(define (tc-check-array-rest-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [elem-ty : ast.AstType]) : ResultTcUnit
  (if (>= index exprs.len)
    ResultTcUnit.Ok
    (match (tc-expr-with-expected-or-actual-id
      ctx
      env
      (ast.ast-expr-list-get exprs index 0)
      elem-ty)
      [(ResultTcType.Ok ty)
        (match (tc-expect
          ty
          elem-ty
          "typecheck: array elements must have same type")
          [(ResultTcUnit.Ok)
            (tc-check-array-rest-at ctx env exprs (+ index 1) elem-ty)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
      [(ResultTcType.Err message) (ResultTcUnit.Err message)])))

(define (tc-signature-lifetime-type-list-collect-into
  [types : ast.AstTypeList]
  [skip-id : i64]
  [out : TcNameIdList]) : TcNameIdList
  (tc-signature-lifetime-type-list-collect-at (& types) skip-id 0 out))

(define (tc-signature-lifetime-type-list-collect-at
  [types : (& types ast.AstTypeList)]
  [skip-id : i64]
  [index : i64]
  [out : TcNameIdList]) : TcNameIdList
  (if (>= index (ast.ast-type-list-len types))
    out
    (tc-signature-lifetime-type-list-collect-at
      types
      skip-id
      (+ index 1)
      (tc-signature-lifetime-type-collect-into
        (ast.ty-node-get
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))
        skip-id
        out))))

(define (tc-signature-lifetime-type-collect-into
  [ty : ast.AstType]
  [skip-id : i64]
  [out : TcNameIdList]) : TcNameIdList
  ;; Nested function types introduce their own signature lifetime scope.
  (match ty
    [(ast.AstType.Func _ _) out]
    [(ast.AstType.Tuple elems)
      (tc-signature-lifetime-type-list-collect-into
        (__tl-box-place elems)
        skip-id
        out)]
    [(ast.AstType.Array elem _)
      (tc-signature-lifetime-type-collect-into
        (ast.ty-node-get elem)
        skip-id
        out)]
    [(ast.AstType.DynArray elem)
      (tc-signature-lifetime-type-collect-into
        (ast.ty-node-get elem)
        skip-id
        out)]
    [(ast.AstType.Box elem)
      (tc-signature-lifetime-type-collect-into
        (ast.ty-node-get elem)
        skip-id
        out)]
    [(ast.AstType.Ptr elem)
      (tc-signature-lifetime-type-collect-into
        (ast.ty-node-get elem)
        skip-id
        out)]
    [(ast.AstType.MutPtr elem)
      (tc-signature-lifetime-type-collect-into
        (ast.ty-node-get elem)
        skip-id
        out)]
    [(ast.AstType.Ref lifetime inner)
      (tc-signature-lifetime-type-collect-into
        (ast.ty-node-get inner)
        skip-id
        (if (= lifetime skip-id)
          out
          (tc-name-id-list-add out lifetime)))]
    [(ast.AstType.MutRef lifetime inner)
      (tc-signature-lifetime-type-collect-into
        (ast.ty-node-get inner)
        skip-id
        (if (= lifetime skip-id)
          out
          (tc-name-id-list-add out lifetime)))]
    [(ast.AstType.Region _ inner)
      (tc-signature-lifetime-type-collect-into
        (ast.ty-node-get inner)
        skip-id
        out)]
    [(ast.AstType.EnumArgs _ lifetimes)
      (tc-lifetime-list-to-name-id-list-into (__tl-box-place lifetimes) out)]
    [(ast.AstType.StructArgs _ lifetimes)
      (tc-lifetime-list-to-name-id-list-into (__tl-box-place lifetimes) out)]
    [(ast.AstType.VarArgs _ lifetimes)
      (tc-lifetime-list-to-name-id-list-into (__tl-box-place lifetimes) out)]
    [(ast.AstType.Consume inner)
      (tc-signature-lifetime-type-collect-into
        (ast.ty-node-get inner)
        skip-id
        out)]
    [_ out]))

(define (tc-param-list-has-name-id-at?
  [params : (& params ast.AstParamList)]
  [name-id : i64]
  [index : i64]) : bool
  (if (>= index (ast.ast-param-list-len params))
    false
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(ast.AstParam.Param name _ _ _)
        (or
          (= name name-id)
          (tc-param-list-has-name-id-at? params name-id (+ index 1)))])))

(define (tc-signature-lifetime-needs-marker?
  [params : (& params ast.AstParamList)]
  [lifetime-id : i64]) : bool
  (and
    (>= lifetime-id 0)
    (not (tc-elaborated-lifetime-hidden? lifetime-id))
    (not
      (and
        (ci.intern-renderable-id? lifetime-id)
        (string.eq (ci.intern-str lifetime-id) "program")))
    (not (tc-param-list-has-name-id-at? params lifetime-id 0))))

(define (tc-bind-signature-lifetime-markers
  [env : TcTypeEnv]
  [params : (& params ast.AstParamList)]
  [lifetimes : TcNameIdList]) : TcTypeEnv
  (let
    [cursor : TcNameIdList lifetimes]
    [out : TcTypeEnv env]
    (begin
      (while (not (tc-name-id-list-empty? cursor))
        (let
          [lifetime : i64 (tc-name-id-list-head cursor)]
          (begin
            (if (tc-signature-lifetime-needs-marker? params lifetime)
              (set!
                out
                (tc-bind-runtime-marker-id
                  out
                  (tc-signature-lifetime-marker-id)
                  (ast.AstType.Var lifetime)
                  TcTypeEnvScopedMarkerKind.Other))
              unit)
            (set! cursor (tc-name-id-list-rest cursor)))))
      out)))

(define (tc-type-env-scoped-carrier-bind-signature-lifetime-markers
  [carrier : TcTypeEnvScopedCarrier (:consume)]
  [params : (& params ast.AstParamList)]
  [lifetimes : TcNameIdList]) : TcTypeEnvScopedCarrier
  (let
    [cursor : TcNameIdList lifetimes]
    [out : TcTypeEnvScopedCarrier carrier]
    (begin
      (while (not (tc-name-id-list-empty? cursor))
        (let
          [lifetime : i64 (tc-name-id-list-head cursor)]
          (begin
            (if (tc-signature-lifetime-needs-marker? params lifetime)
              (set!
                out
                (tc-type-env-scoped-carrier-with-sidecar
                  out
                  (tc-type-env-scoped-sidecar-bind-marker-id
                    out.sidecar
                    (tc-signature-lifetime-marker-id)
                    (ast.AstType.Var lifetime)
                    TcTypeEnvScopedMarkerKind.Other)))
              unit)
            (set! cursor (tc-name-id-list-rest cursor)))))
      out)))

(define (tc-bind-params
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : ast.AstParamList]) : TcTypeEnv
  (tc-bind-params-at ctx env (& params) 0 TcNameIdList.Nil))

(define (tc-bind-params-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : (& params ast.AstParamList)]
  [index : i64]
  [lifetimes : TcNameIdList]) : TcTypeEnv
  (if (>= index (ast.ast-param-list-len params))
    (tc-bind-signature-lifetime-markers env params lifetimes)
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(ast.AstParam.Param name ty _ _)
        (tc-bind-params-at
          ctx
          (tc-bind-id env name (tc-resolve-type ctx ty))
          params
          (+ index 1)
          (tc-signature-lifetime-type-collect-into ty name lifetimes))])))

(define (tc-type-env-scoped-carrier-bind-params
  [ctx : TcContext]
  [carrier : TcTypeEnvScopedCarrier (:consume)]
  [params : ast.AstParamList]) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-bind-params-at
    ctx
    carrier
    (& params)
    0
    TcNameIdList.Nil))

(define (tc-type-env-scoped-carrier-bind-params-at
  [ctx : TcContext]
  [carrier : TcTypeEnvScopedCarrier (:consume)]
  [params : (& params ast.AstParamList)]
  [index : i64]
  [lifetimes : TcNameIdList]) : TcTypeEnvScopedCarrier
  (if (>= index (ast.ast-param-list-len params))
    (tc-type-env-scoped-carrier-bind-signature-lifetime-markers
      carrier
      params
      lifetimes)
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(ast.AstParam.Param name ty _ _)
        (tc-type-env-scoped-carrier-bind-params-at
          ctx
          (tc-type-env-scoped-carrier-bind-id
            carrier
            name
            (tc-resolve-type ctx ty))
          params
          (+ index 1)
          (tc-signature-lifetime-type-collect-into ty name lifetimes))])))

(cfg
  tc-env-scoped-dual-verify
  (define (tc-type-env-scoped-dual-type-kind [ty : ast.AstType]) : String
    (match ty
      [(ast.AstType.I64) "i64"]
      [(ast.AstType.I32) "i32"]
      [(ast.AstType.U64) "u64"]
      [(ast.AstType.U32) "u32"]
      [(ast.AstType.Bool) "bool"]
      [(ast.AstType.String) "String"]
      [(ast.AstType.Func _ _) "function"]
      [(ast.AstType.Ref _ _) "reference"]
      [(ast.AstType.MutRef _ _) "mutable-reference"]
      [(ast.AstType.Var _) "variable"]
      [_ "other"])))

(cfg
  tc-env-scoped-dual-verify
  (define (tc-type-env-scoped-dual-result-type-matches?
    [scoped : ResultTcType]
    [env : TcTypeEnv]
    [persistent-id : i64]
    [display-id : i64]) : bool
    (match scoped
      [(ResultTcType.Ok scoped-ty)
        (match (tc-lookup-persistent-key-id env persistent-id display-id)
          [(ResultTcType.Ok persistent-ty) (tc-type-eq scoped-ty persistent-ty)]
          [(ResultTcType.Err _) false])]
      [(ResultTcType.Err _)
        (not (tc-name-bound-persistent-key-id? env persistent-id))])))

(cfg
  tc-env-scoped-dual-verify
  (define (tc-type-env-scoped-dual-result-unsafe-matches?
    [scoped : ResultTcTypeUnsafe]
    [env : TcTypeEnv]
    [persistent-id : i64]
    [display-id : i64]) : bool
    (match scoped
      [(ResultTcTypeUnsafe.Ok scoped-ty scoped-unsafe)
        (match (tc-lookup-unsafe-persistent-key-id env persistent-id display-id)
          [(ResultTcTypeUnsafe.Ok persistent-ty persistent-unsafe)
            (if (tc-type-eq scoped-ty persistent-ty)
              (if (= scoped-unsafe persistent-unsafe)
                true
                (io.panic
                  (str_cat.str-cat
                    "typecheck: scoped unsafe flag diverged for "
                    (tc-env-key-display display-id))))
              (io.panic
                (str_cat.str-cat
                  "typecheck: scoped unsafe type diverged for "
                  (tc-env-key-display display-id)
                  ": scoped="
                  (tc-type-env-scoped-dual-type-kind scoped-ty)
                  " persistent="
                  (tc-type-env-scoped-dual-type-kind persistent-ty))))]
          [(ResultTcTypeUnsafe.Err _)
            (io.panic
              (str_cat.str-cat
                "typecheck: scoped unsafe lookup found persistent miss for "
                (tc-env-key-display display-id)))])]
      [(ResultTcTypeUnsafe.Err _)
        (if (tc-name-bound-persistent-key-id? env persistent-id)
          (io.panic
            (str_cat.str-cat
              "typecheck: scoped unsafe lookup missed persistent binding for "
              (tc-env-key-display display-id)))
          true)])))

(cfg
  tc-env-scoped-dual-verify
  (define (tc-type-env-scoped-carrier-params-match-persistent-at?
    [carrier : TcTypeEnvScopedCarrier]
    [persistent : TcTypeEnv]
    [params : (& params ast.AstParamList)]
    [index : i64]) : bool
    (if (>= index (ast.ast-param-list-len params))
      true
      (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
        [(ast.AstParam.Param name _ _ _)
          (match (tc-type-env-scoped-carrier-lookup-id carrier name)
            [(ResultTcType.Ok stack-ty)
              (match (tc-lookup-persistent-id persistent name)
                [(ResultTcType.Ok persistent-ty)
                  (and
                    (tc-type-eq stack-ty persistent-ty)
                    (tc-type-env-scoped-carrier-params-match-persistent-at?
                      carrier
                      persistent
                      params
                      (+ index 1)))]
                [(ResultTcType.Err _) false])]
            [(ResultTcType.Err _) false])]))))

(cfg
  tc-env-scoped-dual-verify
  (define (tc-type-env-scoped-carrier-fn-entry-matches-persistent?
    [carrier : TcTypeEnvScopedCarrier]
    [persistent : TcTypeEnv]
    [params : ast.AstParamList]) : bool
    (and
      (tc-type-env-scoped-carrier-params-match-persistent-at?
        carrier
        persistent
        (& params)
        0)
      (match (tc-type-env-scoped-carrier-current-return-type carrier)
        [(ResultTcType.Ok stack-ret)
          (match (tc-env-marker-type persistent (tc-return-type-id))
            [(ast.AstMaybeType.Some persistent-ret)
              (tc-type-eq stack-ret persistent-ret)]
            [(ast.AstMaybeType.No) false])]
        [(ResultTcType.Err _) false]))))

(define (tc-bind-macro-params
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : ast.AstMacroParamList]) : TcTypeEnv
  (tc-bind-macro-params-at ctx env (& params) 0))

(define (tc-bind-macro-params-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : (& params ast.AstMacroParamList)]
  [index : i64]) : TcTypeEnv
  (if (>= index (ast.ast-macro-param-list-len params))
    env
    (match (ast.ast-macro-param-list-get
      params
      index
      (ast.ast-macro-param-fallback))
      [(ast.AstMacroParam.Param name ty variadic _)
        (tc-bind-macro-params-at
          ctx
          (tc-bind-id
            env
            name
            (cond
              [(tc-macro-type-param-kind? ty) (ast.AstType.Expr)]
              [(tc-macro-module-param-kind? ty) (ast.AstType.String)]
              [(and
                  variadic
                  (tc-macro-expr-clause-type?
                    (tc-resolve-type ctx (tc-macro-signature-type ty))))
                (tc-macro-expr-clause-list-type)]
              [(and
                  variadic
                  (tc-macro-expr-binding-clause-type?
                    (tc-resolve-type ctx (tc-macro-signature-type ty))))
                (tc-macro-expr-binding-clause-list-type)]
              [(tc-macro-expr-clause-type?
                  (tc-resolve-type ctx (tc-macro-signature-type ty)))
                (tc-macro-expr-clause-type)]
              [(tc-macro-expr-binding-clause-type?
                  (tc-resolve-type ctx (tc-macro-signature-type ty)))
                (tc-macro-expr-binding-clause-type)]
              [variadic (ast.AstType.ExprList)]
              [else (ast.AstType.Expr)]))
          params
          (+ index 1))])))

(define (tc-ctfe-env-extend-macro-params
  [ctx : TcContext]
  [env : ctfe_support.CtfeEnv]
  [params : ast.AstMacroParamList]) : ctfe_support.CtfeEnv
  (tc-ctfe-env-extend-macro-params-at ctx env (& params) 0))

(define (tc-ctfe-env-extend-macro-params-at
  [ctx : TcContext]
  [env : ctfe_support.CtfeEnv]
  [params : (& params ast.AstMacroParamList)]
  [index : i64]) : ctfe_support.CtfeEnv
  (if (>= index (ast.ast-macro-param-list-len params))
    env
    (match (ast.ast-macro-param-list-get
      params
      index
      (ast.ast-macro-param-fallback))
      [(ast.AstMacroParam.Param name ty variadic _)
        (tc-ctfe-env-extend-macro-params-at
          ctx
          (ctfe_support.ctfe-env-extend-id
            env
            name
            (cond
              [(tc-macro-type-param-kind? ty)
                (ctfe_support.CompilerCtfeValue.Type (ast.AstType.Var name))]
              [(tc-macro-module-param-kind? ty)
                (ctfe_support.CompilerCtfeValue.String
                  ""
                  cbi.compiler-builtin-id-fix-empty)]
              [(and
                  variadic
                  (tc-macro-expr-clause-type?
                    (tc-resolve-type ctx (tc-macro-signature-type ty))))
                (ctfe_support.CompilerCtfeValue.ExprClauseList
                  (ast.ast-expr-clause-list-new))]
              [(and
                  variadic
                  (tc-macro-expr-binding-clause-type?
                    (tc-resolve-type ctx (tc-macro-signature-type ty))))
                (ctfe_support.CompilerCtfeValue.ExprBindingClauseList
                  (ast.ast-expr-binding-clause-list-new))]
              [variadic
                (ctfe_support.CompilerCtfeValue.ExprList
                  (ast.ast-expr-list-new))]
              [(tc-macro-expr-clause-type?
                  (tc-resolve-type ctx (tc-macro-signature-type ty)))
                (ctfe_support.CompilerCtfeValue.ExprClause
                  (ast.ast-expr-clause
                    (ast.ast-node-pool-context-expr-push
                      (tc-context-pools ctx)
                      (ast.AstExpr.Var
                        (tc-generated-name-id
                          (str_cat.str-cat (tc-env-key-name-text name) "$first"))))
                    (ast.ast-node-pool-context-expr-push
                      (tc-context-pools ctx)
                      (ast.AstExpr.Var
                        (tc-generated-name-id
                          (str_cat.str-cat
                            (tc-env-key-name-text name)
                            "$second"))))))]
              [(tc-macro-expr-binding-clause-type?
                  (tc-resolve-type ctx (tc-macro-signature-type ty)))
                (let
                  [unit-expr : i64
                    (ast.ast-node-pool-context-expr-push
                      (tc-context-pools ctx)
                      (ast.AstExpr.Literal (ast.AstLiteral.Unit)))]
                  (ctfe_support.CompilerCtfeValue.ExprBindingClause
                    (ast.ast-expr-binding-clause-id
                      name
                      false
                      unit-expr
                      (ast.ast-node-pool-context-expr-push
                        (tc-context-pools ctx)
                        (ast.AstExpr.Var
                          (tc-generated-name-id
                            (str_cat.str-cat
                              (tc-env-key-name-text name)
                              "$init"))))
                      (ctfe_support.ctfe-untyped-expr-type)
                      (ast.ast-source-span 0 0 0 0))))]
              [else
                (ctfe_support.CompilerCtfeValue.Expr
                  (ast.ast-node-pool-context-expr-push
                    (tc-context-pools ctx)
                    (ast.AstExpr.Var name))
                  (tc-resolve-type ctx (tc-macro-signature-type ty)))]))
          params
          (+ index 1))])))

(define (tc-dispatch-isa-eq? [a : ast.AstDispatchIsa] [b : ast.AstDispatchIsa]) : bool
  (match a
    [(ast.AstDispatchIsa.Scalar)
      (match b
        [(ast.AstDispatchIsa.Scalar) true]
        [_ false])]
    [(ast.AstDispatchIsa.Avx2)
      (match b
        [(ast.AstDispatchIsa.Avx2) true]
        [_ false])]
    [(ast.AstDispatchIsa.Avx512)
      (match b
        [(ast.AstDispatchIsa.Avx512) true]
        [_ false])]))

(define (tc-dispatch-variant-list-contains-isa-from?
  [variants : (& variants ast.AstDispatchVariantList)]
  [index : i64]
  [isa : ast.AstDispatchIsa]) : bool
  (if (>= index variants.len)
    false
    (match (ast.ast-dispatch-variant-list-get
      variants
      index
      (ast.ast-dispatch-variant-fallback))
      [(ast.AstDispatchVariant.Variant found-isa _)
        (if (tc-dispatch-isa-eq? found-isa isa)
          true
          (tc-dispatch-variant-list-contains-isa-from? variants (+ index 1) isa))])))

(define (tc-dispatch-variant-list-duplicate-isa-from?
  [variants : (& variants ast.AstDispatchVariantList)]
  [index : i64]) : bool
  (if (>= index variants.len)
    false
    (match (ast.ast-dispatch-variant-list-get
      variants
      index
      (ast.ast-dispatch-variant-fallback))
      [(ast.AstDispatchVariant.Variant isa _)
        (or
          (tc-dispatch-variant-list-contains-isa-from? variants (+ index 1) isa)
          (tc-dispatch-variant-list-duplicate-isa-from? variants (+ index 1)))])))

(define (tc-dispatch-variant-list-duplicate-isa?
  [variants : ast.AstDispatchVariantList]) : bool
  (tc-dispatch-variant-list-duplicate-isa-from? (& variants) 0))

(define (tc-dispatch-variant-list-scalar-count-from
  [variants : (& variants ast.AstDispatchVariantList)]
  [index : i64]
  [count : i64]) : i64
  (if (>= index variants.len)
    count
    (match (ast.ast-dispatch-variant-list-get
      variants
      index
      (ast.ast-dispatch-variant-fallback))
      [(ast.AstDispatchVariant.Variant isa _)
        (tc-dispatch-variant-list-scalar-count-from
          variants
          (+ index 1)
          (+
            count
            (match isa
              [(ast.AstDispatchIsa.Scalar) 1]
              [_ 0])))])))

(define (tc-dispatch-variant-list-scalar-count
  [variants : ast.AstDispatchVariantList]) : i64
  (tc-dispatch-variant-list-scalar-count-from (& variants) 0 0))

(define (tc-dispatch-symbol-key-id [ctx : TcContext] [name : i64]) : i64
  (if (tc-name-qualified-id? name)
    (csym.compiler-symbol-name-id-key name)
    (csym.compiler-symbol-module-key-id-by-id (tc-context-module-id ctx) name)))

(define (tc-dispatch-variant-non-function-message [name : i64]) : String
  (str_cat.str-cat
    "typecheck: defdispatch variant is not a function "
    (tc-env-key-name-text name)))

(define (tc-dispatch-variant-type
  [ctx : TcContext]
  [dispatch-name : i64]
  [variant-name : i64]) : ResultTcType
  (let
    [logical-key : i64 (tc-dispatch-symbol-key-id ctx dispatch-name)]
    [lookup-key : i64 (tc-dispatch-symbol-key-id ctx variant-name)]
    (if (= lookup-key logical-key)
      (ResultTcType.Err "typecheck: defdispatch cannot use itself as a variant")
      (let
        [handle : i64
          (if (tc-name-qualified-id? variant-name)
            (csym.compiler-symbols-lookup-value-id-or
              (tc-context-symbols ctx)
              variant-name
              (csym.compiler-symbols-missing-handle))
            (csym.compiler-symbols-lookup-value-in-module-id-or
              (tc-context-symbols ctx)
              (tc-context-module-id ctx)
              variant-name
              (csym.compiler-symbols-missing-handle)))]
        (if (csym.compiler-symbols-handle-found? handle)
          (let
            [kind : i64 (csym.compiler-symbol-handle-kind handle)]
            (if (= kind (csym.compiler-symbol-kind-defdispatch))
              (ResultTcType.Err
                "typecheck: defdispatch variant cannot be another dispatch")
              (if (or
                (= kind (csym.compiler-symbol-kind-function-define))
                (= kind (csym.compiler-symbol-kind-extern)))
                (match (csym.compiler-program-decl-at-index
                  (tc-context-program ctx)
                  (csym.compiler-symbol-handle-index handle))
                  [(parser.ResultAstDecl.Ok decl)
                    (match (tc-top-decl-type ctx decl)
                      [(ResultTcType.Ok ty)
                        (match ty
                          [(ast.AstType.Func _ _) (ResultTcType.Ok ty)]
                          [_
                            (ResultTcType.Err
                              (tc-dispatch-variant-non-function-message
                                variant-name))])]
                      [(ResultTcType.Err message) (ResultTcType.Err message)])]
                  [(parser.ResultAstDecl.Err message)
                    (ResultTcType.Err message)])
                (ResultTcType.Err
                  (tc-dispatch-variant-non-function-message variant-name)))))
          (ResultTcType.Err
            (str_cat.str-cat
              "typecheck: unknown defdispatch variant "
              (ci.intern-str variant-name))))))))

(define (tc-dispatch-variant-signatures-from
  [ctx : TcContext]
  [dispatch-name : i64]
  [variants : (& variants ast.AstDispatchVariantList)]
  [index : i64]
  [expected : ast.AstMaybeType]) : ResultTcType
  (if (>= index variants.len)
    (match expected
      [(ast.AstMaybeType.Some ty) (ResultTcType.Ok ty)]
      [(ast.AstMaybeType.No)
        (ResultTcType.Err "typecheck: defdispatch has no variants")])
    (match (ast.ast-dispatch-variant-list-get
      variants
      index
      (ast.ast-dispatch-variant-fallback))
      [(ast.AstDispatchVariant.Variant _ variant-name)
        (match (tc-dispatch-variant-type ctx dispatch-name variant-name)
          [(ResultTcType.Ok ty)
            (match expected
              [(ast.AstMaybeType.No)
                (tc-dispatch-variant-signatures-from
                  ctx
                  dispatch-name
                  variants
                  (+ index 1)
                  (ast.AstMaybeType.Some ty))]
              [(ast.AstMaybeType.Some want)
                (if (tc-type-eq ty want)
                  (tc-dispatch-variant-signatures-from
                    ctx
                    dispatch-name
                    variants
                    (+ index 1)
                    expected)
                  (ResultTcType.Err
                    "typecheck: defdispatch variant signatures must match"))])]
          [(ResultTcType.Err message) (ResultTcType.Err message)])])))

(define (tc-dispatch-variant-signatures
  [ctx : TcContext]
  [dispatch-name : i64]
  [variants : ast.AstDispatchVariantList]
  [expected : ast.AstMaybeType]) : ResultTcType
  (tc-dispatch-variant-signatures-from
    ctx
    dispatch-name
    (& variants)
    0
    expected))

(define (tc-dispatch-decl-type
  [ctx : TcContext]
  [name : i64]
  [variants : ast.AstDispatchVariantList]) : ResultTcType
  (if (!= (tc-dispatch-variant-list-scalar-count variants) 1)
    (ResultTcType.Err
      "typecheck: defdispatch requires exactly one scalar variant")
    (if (tc-dispatch-variant-list-duplicate-isa? variants)
      (ResultTcType.Err "typecheck: duplicate defdispatch ISA variant")
      (tc-dispatch-variant-signatures ctx name variants ast.AstMaybeType.No))))

(define (tc-top-decl-type [ctx : TcContext] [decl : ast.AstDecl]) : ResultTcType
  (match decl
    [(ast.AstDecl.Def decl-meta _ maybe-ty expr-box)
      (let
        [expr : ast.AstExpr (tc-context-expr-get ctx expr-box)]
        (match maybe-ty
          [(ast.AstMaybeType.Some ty)
            (ResultTcType.Ok (tc-resolve-type ctx ty))]
          [(ast.AstMaybeType.No)
            (match (ast.ast-expr-unspan expr)
              [(ast.AstExpr.Literal lit)
                (ResultTcType.Ok (tc-literal-type lit))]
              [(ast.AstExpr.Ann _ ty-id)
                (ResultTcType.Ok (tc-resolve-type ctx (ast.ty-node-get ty-id)))]
              [_
                (ResultTcType.Err
                  "typecheck: top-level value requires annotation")])]))]
    [(ast.AstDecl.DefFn decl-meta _ params ret _ _)
      (match (tc-elide-function-signature
        (tc-context-type-bases ctx)
        params
        ret)
        [(ResultTcElidedSignature.Ok signature)
          (ResultTcType.Ok
            (ast.ast-ty-func
              (tc-param-type-list ctx signature.params)
              (tc-resolve-type ctx signature.ret)))]
        [(ResultTcElidedSignature.Err message) (ResultTcType.Err message)])]
    [(ast.AstDecl.Extern decl-meta _ _ _ ty)
      (ResultTcType.Ok (tc-resolve-type ctx ty))]
    [(ast.AstDecl.DefDispatch decl-meta name variants)
      (tc-dispatch-decl-type ctx name variants)]
    [(ast.AstDecl.Unsafe inner-box)
      (let
        [inner : ast.AstDecl (__tl-box-place inner-box)]
        (tc-top-decl-type ctx inner))]
    [_ (ResultTcType.Err "typecheck: declaration has no value type")]))

;; Like `tc-top-decl-type`, but infers an un-annotated top-level `define`'s type
;; from its initializer expression when it is neither a literal nor an annotated
;; expression. The `env` carries the bindings of all preceding declarations
;; (functions, enum/struct constructors, earlier globals), so a global such as
;; `(define result (factorial 5))` or `(define pair (Pair 10 11))` resolves
;; through the ordinary expression typechecker instead of demanding an
;; annotation. This mirrors the former Rust typechecker, whose first pass over
;; the declarations runs `check_expr(value)` for an un-annotated `Decl::Def`.
(define (tc-top-decl-type-with-env
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decl : ast.AstDecl]) : ResultTcType
  (match decl
    [(ast.AstDecl.Def decl-meta _ maybe-ty expr-box)
      (let
        [expr : ast.AstExpr (tc-context-expr-get ctx expr-box)]
        (match maybe-ty
          [(ast.AstMaybeType.Some ty)
            (ResultTcType.Ok (tc-resolve-type ctx ty))]
          [(ast.AstMaybeType.No)
            (match (ast.ast-expr-unspan expr)
              [(ast.AstExpr.Literal lit)
                (ResultTcType.Ok (tc-literal-type lit))]
              [(ast.AstExpr.Ann _ ty-id)
                (ResultTcType.Ok (tc-resolve-type ctx (ast.ty-node-get ty-id)))]
              [_ (tc-expr ctx env expr)])]))]
    [_ (tc-top-decl-type ctx decl)]))

(define (tc-field-type-list [ctx : TcContext] [fields : ast.AstFieldDefList]) : ast.AstTypeList
  (tc-field-type-list-at ctx (& fields) 0))

(define (tc-field-type-list-at
  [ctx : TcContext]
  [fields : (& fields ast.AstFieldDefList)]
  [index : i64]) : ast.AstTypeList
  (if (>= index (ast.ast-field-def-list-len fields))
    (ast.ast-type-list-new)
    (match (ast.ast-field-def-list-get
      fields
      index
      (ast.ast-field-def-fallback))
      [(ast.AstFieldDef.Def _ ty _)
        (ast.ast-type-cons
          (tc-resolve-type ctx ty)
          (tc-field-type-list-at ctx fields (+ index 1)))])))

(define (tc-tag-regions [regions : TcNameIdList] [ty : ast.AstType]) : ast.AstType
  (if (tc-name-id-list-empty? regions)
    ty
    (tc-tag-region
      (tc-name-id-list-head regions)
      (tc-tag-regions (tc-name-id-list-rest regions) ty))))

(define (tc-tag-type-list-regions
  [regions : TcNameIdList]
  [types : ast.AstTypeList]) : ast.AstTypeList
  (tc-tag-type-list-regions-at regions (& types) 0))

(define (tc-tag-type-list-regions-at
  [regions : TcNameIdList]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ast.AstTypeList
  (if (>= index (ast.ast-type-list-len types))
    (ast.ast-type-list-new)
    (ast.ast-type-cons
      (tc-tag-regions
        regions
        (ast.ty-node-get
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback))))
      (tc-tag-type-list-regions-at regions types (+ index 1)))))

(define (tc-project-type-list-from-region-container
  [container-ty : ast.AstType]
  [types : ast.AstTypeList]) : ast.AstTypeList
  (tc-project-type-list-from-region-container-at container-ty (& types) 0))

(define (tc-project-type-list-from-region-container-at
  [container-ty : ast.AstType]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ast.AstTypeList
  (if (>= index (ast.ast-type-list-len types))
    (ast.ast-type-list-new)
    (ast.ast-type-cons
      (tc-project-from-region-container
        container-ty
        (ast.ty-node-get
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback))))
      (tc-project-type-list-from-region-container-at
        container-ty
        types
        (+ index 1)))))

(define (tc-enum-variant-constructor-type-id
  [ctx : TcContext]
  [enum-name-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [fields : ast.AstTypeList]) : ast.AstType
  (let
    [ret : ast.AstType
      (if (ast.ast-lifetime-list-empty? (& lifetimes))
        (ast.AstType.Enum enum-name-id)
        (ast.ast-ty-enum-args enum-name-id lifetimes))]
    (if (ast.ast-type-list-empty? (& fields))
      ret
      ;; Variant field spellings belong to the enum declaration's module.
      ;; Generated modules can construct an imported enum, so resolving in the
      ;; caller would give nominal payloads a different canonical identity than
      ;; the same fields used by match-pattern binding.
      (ast.ast-ty-func
        (tc-resolve-type-list
          (tc-context-with-owner-name-module ctx enum-name-id)
          fields)
        ret))))

(define (tc-bind-enum-variants-in-module-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [module-id : i64]
  [enum-name-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [variants : ast.AstVariantDefList]) : ResultTcEnv
  (tc-bind-enum-variants-in-module-id-at
    ctx
    env
    module-id
    enum-name-id
    lifetimes
    (& variants)
    0))

(define (tc-bind-enum-variants-in-module-id-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [module-id : i64]
  [enum-name-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [variants : (& variants ast.AstVariantDefList)]
  [index : i64]) : ResultTcEnv
  (if (>= index variants.len)
    (ResultTcEnv.Ok env)
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(ast.AstVariantDef.Def name fields _)
        (let
          [scoped-enum-id : i64
            (tc-module-name-id-by-id module-id enum-name-id)]
          [constructor-ty : ast.AstType
            (tc-enum-variant-constructor-type-id
              ctx
              scoped-enum-id
              lifetimes
              fields)]
          (begin
            (ctfe_support.ctfe-module-value-add-id-for-state!
              (tc-context-ctfe-macro-state ctx)
              module-id
              name
              constructor-ty)
            (tc-bind-enum-variants-in-module-id-at
              ctx
              (tc-bind-alias-id-if-free
                env
                (tc-module-name-id-by-id module-id name)
                constructor-ty)
              module-id
              enum-name-id
              lifetimes
              variants
              (+ index 1))))])))

(define (tc-build-top-env-list
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [env : TcTypeEnv]) : ResultTcEnv
  (tc-build-top-env-list-explicit-in-module
    ctx
    decls
    env
    ""
    cbi.compiler-builtin-id-fix-empty))

;; An explicit top-env build creates one cache at its result boundary. Applying
;; the function-body 32-bind compaction policy while the spine is still growing
;; repeatedly copies the whole prefix (and every cache payload array), turning a
;; large package top-env build into quadratic work. Nested module bodies call the
;; raw list helper and inherit this outer scope.
(define (tc-build-top-env-list-explicit-in-module
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [env : TcTypeEnv]
  [module : String]
  [module-id : i64]) : ResultTcEnv
  (let
    [state : TcTopEnvMembershipState
      (tc-job-state-topenv-membership (tc-context-job-state ctx))]
    [saved-env-state : TcTopEnvMembershipState
      (tc-type-env-topenv-membership-state env)]
    [saved : bool (tc-topenv-explicit-build-active? state)]
    (begin
      (tc-type-env-set-topenv-membership-state! env state)
      (tc-topenv-membership-set-explicit-build-active! state true)
      (match (tc-build-top-env-list-in-module ctx decls env module module-id)
        [(ResultTcEnv.Ok next-env)
          (begin
            (tc-topenv-membership-set-explicit-build-active! state saved)
            (tc-type-env-set-topenv-membership-state! next-env saved-env-state)
            (ResultTcEnv.Ok next-env))]
        [(ResultTcEnv.Err message)
          (begin
            (tc-topenv-membership-set-explicit-build-active! state saved)
            (tc-type-env-set-topenv-membership-state! env saved-env-state)
            (ResultTcEnv.Err message))]))))

(define (tc-build-top-env-bind-decl-in-module
  [ctx : TcContext]
  [env : TcTypeEnv]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]) : ResultTcEnv
  (match decl
    [(ast.AstDecl.Module _) (ResultTcEnv.Ok env)]
    [(ast.AstDecl.ModuleBody name body-box)
      (let
        [module : String (tc-env-key-name-text name)]
        (tc-build-top-env-list-in-module
          ctx
          (__tl-box-place body-box)
          env
          module
          name))]
    [(ast.AstDecl.Unsafe inner-box)
      (let
        [inner : ast.AstDecl (__tl-box-place inner-box)]
        (match inner
          [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
            (match (tc-top-decl-type
              (tc-context-with-module-id ctx module module-id)
              inner)
              [(ResultTcType.Ok ty)
                (begin
                  (ctfe_support.ctfe-module-value-add-id-for-state!
                    (tc-context-ctfe-macro-state ctx)
                    module-id
                    name
                    ty)
                  (ResultTcEnv.Ok
                    (tc-bind-unsafe-id
                      env
                      (tc-module-name-id-by-id module-id name)
                      ty)))]
              [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
          [(ast.AstDecl.Extern decl-meta name kind _ _)
            (let
              [extern-ctx : TcContext
                (tc-context-with-module-id ctx module module-id)]
              (match (tc-top-decl-type extern-ctx inner)
                [(ResultTcType.Ok ty)
                  (begin
                    (ctfe_support.ctfe-module-value-add-id-for-state!
                      (tc-context-ctfe-macro-state ctx)
                      module-id
                      name
                      ty)
                    (ResultTcEnv.Ok
                      (if (tc-extern-value-c-abi-fnptr? extern-ctx kind ty)
                        (tc-bind-unsafe-c-abi-fnptr-id
                          env
                          (tc-module-name-id-by-id module-id name)
                          ty)
                        (tc-bind-unsafe-id
                          env
                          (tc-module-name-id-by-id module-id name)
                          ty))))]
                [(ResultTcType.Err message) (ResultTcEnv.Err message)]))]
          [_ (ResultTcEnv.Ok env)]))]
    [(ast.AstDecl.Def decl-meta name _ _)
      (match (tc-top-decl-type-with-env
        (tc-context-with-module-id ctx module module-id)
        env
        decl)
        [(ResultTcType.Ok ty)
          (begin
            (ctfe_support.ctfe-module-value-add-id-for-state!
              (tc-context-ctfe-macro-state ctx)
              module-id
              name
              ty)
            (ResultTcEnv.Ok
              (tc-bind-id env (tc-module-name-id-by-id module-id name) ty)))]
        [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
    [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
      (match (tc-top-decl-type
        (tc-context-with-module-id ctx module module-id)
        decl)
        [(ResultTcType.Ok ty)
          (begin
            (ctfe_support.ctfe-module-value-add-id-for-state!
              (tc-context-ctfe-macro-state ctx)
              module-id
              name
              ty)
            (ResultTcEnv.Ok
              (tc-bind-id env (tc-module-name-id-by-id module-id name) ty)))]
        [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
    [(ast.AstDecl.DefDispatch decl-meta name _)
      (match (tc-top-decl-type
        (tc-context-with-module-id ctx module module-id)
        decl)
        [(ResultTcType.Ok ty)
          (begin
            (ctfe_support.ctfe-module-value-add-id-for-state!
              (tc-context-ctfe-macro-state ctx)
              module-id
              name
              ty)
            (ResultTcEnv.Ok
              (tc-bind-id env (tc-module-name-id-by-id module-id name) ty)))]
        [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
    [(ast.AstDecl.DefMacro decl-meta _ _ _ _) (ResultTcEnv.Ok env)]
    [(ast.AstDecl.Extern decl-meta name kind _ _)
      (let
        [extern-ctx : TcContext
          (tc-context-with-module-id ctx module module-id)]
        (match (tc-top-decl-type extern-ctx decl)
          [(ResultTcType.Ok ty)
            (begin
              (ctfe_support.ctfe-module-value-add-id-for-state!
                (tc-context-ctfe-macro-state ctx)
                module-id
                name
                ty)
              (ResultTcEnv.Ok
                (if (tc-extern-value-c-abi-fnptr? extern-ctx kind ty)
                  (tc-bind-c-abi-fnptr-id
                    env
                    (tc-module-name-id-by-id module-id name)
                    ty)
                  (tc-bind-id env (tc-module-name-id-by-id module-id name) ty))))]
          [(ResultTcType.Err message) (ResultTcEnv.Err message)]))]
    [(ast.AstDecl.DefEnum decl-meta name cleanup variants)
      (let
        [enum-ty : ast.AstType
          (ast.AstType.Enum (tc-module-name-id-by-id module-id name))]
        (match (tc-bind-enum-variants-in-module-id
          (tc-context-with-module-id ctx module module-id)
          env
          module-id
          name
          (ast.ast-lifetime-list-new)
          variants)
          [(ResultTcEnv.Ok with-variants)
            (ResultTcEnv.Ok
              (tc-bind-enum-cleanup-module-id
                with-variants
                module-id
                cleanup
                enum-ty))]
          [(ResultTcEnv.Err message) (ResultTcEnv.Err message)]))]
    [(ast.AstDecl.DefEnumLifetimes decl-meta name lifetimes cleanup variants)
      (let
        [enum-ty : ast.AstType
          (ast.ast-ty-enum-args
            (tc-module-name-id-by-id module-id name)
            lifetimes)]
        (match (tc-bind-enum-variants-in-module-id
          (tc-context-with-module-id ctx module module-id)
          env
          module-id
          name
          lifetimes
          variants)
          [(ResultTcEnv.Ok with-variants)
            (ResultTcEnv.Ok
              (tc-bind-enum-cleanup-module-id
                with-variants
                module-id
                cleanup
                enum-ty))]
          [(ResultTcEnv.Err message) (ResultTcEnv.Err message)]))]
    [(ast.AstDecl.DefStruct decl-meta name _ cleanup fields)
      (let
        [struct-ty : ast.AstType
          (ast.AstType.Struct (tc-module-name-id-by-id module-id name))]
        [constructor-ty : ast.AstType
          (ast.ast-ty-func
            (tc-field-type-list
              (tc-context-with-module-id ctx module module-id)
              fields)
            struct-ty)]
        (begin
          (ctfe_support.ctfe-module-value-add-id-for-state!
            (tc-context-ctfe-macro-state ctx)
            module-id
            name
            constructor-ty)
          (ResultTcEnv.Ok
            (tc-bind-struct-cleanup-module-id
              (tc-bind-id
                env
                (tc-module-name-id-by-id module-id name)
                constructor-ty)
              module-id
              cleanup
              struct-ty))))]
    [(ast.AstDecl.DefStructLifetimes decl-meta name lifetimes _ cleanup fields)
      (let
        [struct-ty : ast.AstType
          (ast.ast-ty-struct-args
            (tc-module-name-id-by-id module-id name)
            lifetimes)]
        [constructor-ty : ast.AstType
          (ast.ast-ty-func
            (tc-field-type-list
              (tc-context-with-module-id ctx module module-id)
              fields)
            struct-ty)]
        (begin
          (ctfe_support.ctfe-module-value-add-id-for-state!
            (tc-context-ctfe-macro-state ctx)
            module-id
            name
            constructor-ty)
          (ResultTcEnv.Ok
            (tc-bind-struct-cleanup-module-id
              (tc-bind-id
                env
                (tc-module-name-id-by-id module-id name)
                constructor-ty)
              module-id
              cleanup
              struct-ty))))]
    [(ast.AstDecl.Import decl-meta _) (ResultTcEnv.Ok env)]
    [(ast.AstDecl.IncludeStr _ _) (ResultTcEnv.Ok env)]
    [(ast.AstDecl.IncludeStrComptime _ _) (ResultTcEnv.Ok env)]
    [(ast.AstDecl.IncludeStrLzss _ _) (ResultTcEnv.Ok env)]
    [(ast.AstDecl.IncludeBin _ _) (ResultTcEnv.Ok env)]
    [(ast.AstDecl.Test _ _ _) (ResultTcEnv.Ok env)]))

(define (tc-build-top-env-list-in-module
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [env : TcTypeEnv]
  [module : String]
  [module-id : i64]) : ResultTcEnv
  ;; Index cursor rather than `ast-decl-list-step`: the module arm reads one id
  ;; out of the row and the bind arm hands the row on, so the step result's
  ;; 144 B and its row copy are pure overhead. The early exit on the first Err
  ;; is preserved by stopping the loop with `ok`.
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [decl-offset : i64 decls.offset]
    [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
    [index : i64 0]
    [current-env : TcTypeEnv env]
    [current-module : String module]
    [current-module-id : i64 module-id]
    [message : String ""]
    [ok : bool true]
    (begin
      (while (and ok (< index count))
        (begin
          (match (ast.ast-decl-list-ref-borrowed (& decls) index)
            [(ast.AstDecl.Module _)
              (let
                [next-module : i64
                  (ast.ast-decl-list-module-id-at
                    (& decls)
                    index
                    cbi.compiler-builtin-id-fix-empty)]
                (begin
                  (set! current-module (tc-env-key-name-text next-module))
                  (set! current-module-id next-module)))]
            [_
              (match (tc-build-top-env-bind-decl-in-module
                ctx
                current-env
                current-module
                current-module-id
                (array-ref decl-slots (+ decl-offset index)))
                [(ResultTcEnv.Ok next-env) (set! current-env next-env)]
                [(ResultTcEnv.Err step-message)
                  (begin
                    (set! message step-message)
                    (set! ok false))])])
          (set! index (+ index 1))))
      (if (string.eq message "")
        (ResultTcEnv.Ok current-env)
        (ResultTcEnv.Err message)))))

(define (tc-bind-enum-variant-aliases
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [enum-name-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [variants : ast.AstVariantDefList]) : TcTypeEnv
  (tc-bind-enum-variant-aliases-at
    ctx
    env
    alias-id
    importer-module-id
    source-module-id
    import-unqualified
    enum-name-id
    lifetimes
    (& variants)
    0))

(define (tc-bind-enum-variant-aliases-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [enum-name-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [variants : (& variants ast.AstVariantDefList)]
  [index : i64]) : TcTypeEnv
  (if (>= index variants.len)
    env
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(ast.AstVariantDef.Def name fields _)
        (let
          [constructor-ty : ast.AstType
            (tc-enum-variant-constructor-type-id
              ctx
              enum-name-id
              lifetimes
              fields)]
          (tc-bind-enum-variant-aliases-at
            ctx
            (let
              [_note : unit
                (tc-unqualified-import-note-value!
                  ctx
                  env
                  alias-id
                  importer-module-id
                  source-module-id
                  import-unqualified
                  name)]
              (tc-bind-alias-id-if-free
                env
                (tc-module-name-id-by-id alias-id name)
                constructor-ty))
            alias-id
            importer-module-id
            source-module-id
            import-unqualified
            enum-name-id
            lifetimes
            variants
            (+ index 1)))])))

;; Alias construction runs after the canonical top env is built, so reuse the
;; existing `module/name` type instead of recomputing each imported decl type.
(define (tc-import-alias-source-value-type
  [env : TcTypeEnv]
  [module-id : i64]
  [name-id : i64]) : ResultTcType
  (tc-lookup-id env (tc-module-name-id-by-id module-id name-id)))

(define (tc-import-alias-summary-index-build-current
  [all-decls : ast.AstDeclList]) : TcImportAliasSummaryIndex
  (let
    [capacity : i64 (+ (parser.ast-decl-list-count all-decls) 1)]
    [decls : (__tl_dyn-array ast.AstDeclList)
      (array.make-array ast.AstDeclList capacity)]
    [modules : tc_i64_i64_map.Map (tc_i64_i64_map.with-capacity capacity)]
    [slot-count : i64 0]
    [count : i64 (ast.ast-decl-list-len (& all-decls))]
    [index : i64 0]
    [cur-module-id : i64 cbi.compiler-builtin-id-fix-empty]
    (begin
      (while (< index count)
        (begin
          (let
            [decl : ast.AstDecl (ast.ast-decl-list-ref all-decls index)]
            (match decl
              [(ast.AstDecl.Module next-module)
                (set! cur-module-id next-module)]
              [_
                (match (tc_i64_i64_map.get (& modules) cur-module-id)
                  [(tc_i64_i64_map.LookupFound slot)
                    (ast.ast-decl-list-push (&mut (array-ref decls slot)) decl)]
                  [(tc_i64_i64_map.LookupMissing)
                    (begin
                      (tc_i64_i64_map.insert-ref!
                        (&mut modules)
                        cur-module-id
                        slot-count)
                      (set!
                        (array-ref decls slot-count)
                        (ast.ast-decl-list-new))
                      (ast.ast-decl-list-push
                        (&mut (array-ref decls slot-count))
                        decl)
                      (set! slot-count (+ slot-count 1)))])]))
          (set! index (+ index 1))))
      (TcImportAliasSummaryIndex modules decls slot-count))))

(define (tc-import-alias-summary-index-build [all-decls : ast.AstDeclList]) : TcImportAliasSummaryIndex
  (tc-import-alias-summary-index-build-current all-decls))

(define (tc-import-alias-summary-index-lookup
  [index : TcImportAliasSummaryIndex]
  [target-module-id : i64]) : TcImportAliasSummaryLookup
  (match (tc_i64_i64_map.get index.modules target-module-id)
    [(tc_i64_i64_map.LookupFound slot)
      (if (and (>= slot 0) (< slot index.count))
        (TcImportAliasSummaryLookup.Found (array-ref index.decls slot))
        (TcImportAliasSummaryLookup.Missing))]
    [(tc_i64_i64_map.LookupMissing) (TcImportAliasSummaryLookup.Missing)]))

(define (tc-import-alias-surface-summary-backed-in?
  [summaries : cload.CompilerLoadSurfaceSummaryList]
  [target-module-id : i64]) : bool
  (let
    [index : i64 0]
    (begin
      (while (<
        index
        (cload.compiler-load-surface-summary-list-count summaries))
        (if (=
          (__tl-project-field
            (cload.compiler-load-surface-summary-list-at summaries index)
            module-id)
          target-module-id)
          (return true)
          (set! index (+ index 1))))
      false)))

(define (tc-import-alias-surface-summary-backed? [target-module-id : i64]) : bool
  (tc-import-alias-surface-summary-backed-in?
    (cload.compiler-load-surface-summaries)
    target-module-id))

(define (tc-import-alias-summary-backed?
  [index : TcImportAliasSummaryIndex]
  [target-module-id : i64]) : bool
  (match (tc-import-alias-summary-index-lookup index target-module-id)
    [(TcImportAliasSummaryLookup.Found _) true]
    [(TcImportAliasSummaryLookup.Missing)
      (tc-import-alias-surface-summary-backed? target-module-id)]))

(define (tc-bind-import-alias-decl-in-module
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias : i64]
  [importer-module : i64]
  [import-unqualified : bool]
  [module : i64]
  [decl : ast.AstDecl]) : ResultTcEnv
  (match decl
    [(ast.AstDecl.Unsafe inner-box)
      (let
        [inner : ast.AstDecl (__tl-box-place inner-box)]
        (match inner
          [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
            (match (tc-import-alias-source-value-type env module name)
              [(ResultTcType.Ok ty)
                (ResultTcEnv.Ok
                  (tc-bind-import-alias-value-unsafe-id
                    ctx
                    env
                    alias
                    importer-module
                    module
                    import-unqualified
                    name
                    ty))]
              [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
          [(ast.AstDecl.Extern decl-meta name kind _ _)
            (let
              [extern-ctx : TcContext
                (tc-context-with-module-id
                  ctx
                  (tc-env-key-name-text module)
                  module)]
              (match (tc-import-alias-source-value-type env module name)
                [(ResultTcType.Ok ty)
                  (ResultTcEnv.Ok
                    (if (tc-extern-value-c-abi-fnptr? extern-ctx kind ty)
                      (tc-bind-import-alias-value-unsafe-c-abi-fnptr-id
                        ctx
                        env
                        alias
                        importer-module
                        module
                        import-unqualified
                        name
                        ty)
                      (tc-bind-import-alias-value-unsafe-id
                        ctx
                        env
                        alias
                        importer-module
                        module
                        import-unqualified
                        name
                        ty)))]
                [(ResultTcType.Err message) (ResultTcEnv.Err message)]))]
          [_ (ResultTcEnv.Ok env)]))]
    [(ast.AstDecl.Def decl-meta name _ _)
      (match (tc-import-alias-source-value-type env module name)
        [(ResultTcType.Ok ty)
          (ResultTcEnv.Ok
            (tc-bind-import-alias-value-id
              ctx
              env
              alias
              importer-module
              module
              import-unqualified
              name
              ty))]
        [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
    [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
      (match (tc-import-alias-source-value-type env module name)
        [(ResultTcType.Ok ty)
          (ResultTcEnv.Ok
            (tc-bind-import-alias-value-id
              ctx
              env
              alias
              importer-module
              module
              import-unqualified
              name
              ty))]
        [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
    [(ast.AstDecl.DefDispatch decl-meta name _)
      (match (tc-import-alias-source-value-type env module name)
        [(ResultTcType.Ok ty)
          (ResultTcEnv.Ok
            (tc-bind-import-alias-value-id
              ctx
              env
              alias
              importer-module
              module
              import-unqualified
              name
              ty))]
        [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
    [(ast.AstDecl.Extern decl-meta name kind _ _)
      (let
        [extern-ctx : TcContext
          (tc-context-with-module-id ctx (tc-env-key-name-text module) module)]
        (match (tc-import-alias-source-value-type env module name)
          [(ResultTcType.Ok ty)
            (ResultTcEnv.Ok
              (if (tc-extern-value-c-abi-fnptr? extern-ctx kind ty)
                (tc-bind-import-alias-value-c-abi-fnptr-id
                  ctx
                  env
                  alias
                  importer-module
                  module
                  import-unqualified
                  name
                  ty)
                (tc-bind-import-alias-value-id
                  ctx
                  env
                  alias
                  importer-module
                  module
                  import-unqualified
                  name
                  ty)))]
          [(ResultTcType.Err message) (ResultTcEnv.Err message)]))]
    [(ast.AstDecl.DefEnum decl-meta name cleanup variants)
      (let
        [scoped-name-id : i64 (tc-module-name-id-by-id module name)]
        [enum-ty : ast.AstType (ast.AstType.Enum scoped-name-id)]
        (ResultTcEnv.Ok
          (tc-bind-enum-cleanup-import-alias
            ctx
            (tc-bind-enum-variant-aliases
              (tc-context-with-module-id
                ctx
                (tc-env-key-name-text module)
                module)
              env
              alias
              importer-module
              module
              import-unqualified
              scoped-name-id
              (ast.ast-lifetime-list-new)
              variants)
            alias
            importer-module
            module
            import-unqualified
            cleanup
            enum-ty)))]
    [(ast.AstDecl.DefEnumLifetimes decl-meta name lifetimes cleanup variants)
      (let
        [scoped-name-id : i64 (tc-module-name-id-by-id module name)]
        [enum-ty : ast.AstType (ast.ast-ty-enum-args scoped-name-id lifetimes)]
        (ResultTcEnv.Ok
          (tc-bind-enum-cleanup-import-alias
            ctx
            (tc-bind-enum-variant-aliases
              (tc-context-with-module-id
                ctx
                (tc-env-key-name-text module)
                module)
              env
              alias
              importer-module
              module
              import-unqualified
              scoped-name-id
              lifetimes
              variants)
            alias
            importer-module
            module
            import-unqualified
            cleanup
            enum-ty)))]
    [(ast.AstDecl.DefStruct decl-meta name _ cleanup fields)
      (let
        [struct-ty : ast.AstType
          (ast.AstType.Struct (tc-module-name-id-by-id module name))]
        (match (tc-import-alias-source-value-type env module name)
          [(ResultTcType.Ok constructor-ty)
            (ResultTcEnv.Ok
              (tc-bind-struct-cleanup-import-alias
                ctx
                (tc-bind-import-alias-value-id
                  ctx
                  env
                  alias
                  importer-module
                  module
                  import-unqualified
                  name
                  constructor-ty)
                alias
                importer-module
                module
                import-unqualified
                cleanup
                struct-ty))]
          [(ResultTcType.Err message) (ResultTcEnv.Err message)]))]
    [(ast.AstDecl.DefStructLifetimes decl-meta name lifetimes _ cleanup fields)
      (let
        [struct-ty : ast.AstType
          (ast.ast-ty-struct-args
            (tc-module-name-id-by-id module name)
            lifetimes)]
        (match (tc-import-alias-source-value-type env module name)
          [(ResultTcType.Ok constructor-ty)
            (ResultTcEnv.Ok
              (tc-bind-struct-cleanup-import-alias
                ctx
                (tc-bind-import-alias-value-id
                  ctx
                  env
                  alias
                  importer-module
                  module
                  import-unqualified
                  name
                  constructor-ty)
                alias
                importer-module
                module
                import-unqualified
                cleanup
                struct-ty))]
          [(ResultTcType.Err message) (ResultTcEnv.Err message)]))]
    [_ (ResultTcEnv.Ok env)]))

(define (tc-bind-import-alias-module-list
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [env : TcTypeEnv]
  [target-module : i64]
  [alias : i64]
  [importer-module : i64]
  [import-unqualified : bool]
  [module : i64]) : ResultTcEnv
  ;; Index cursor rather than `ast-decl-list-step`. Only the module marker and
  ;; the fallback arm touch the row, and the fallback hands the backing slot to
  ;; the binder directly, so the step's 104 B copy and 144 B result are gone.
  (let
    [cur-env : TcTypeEnv env]
    [target-module-id : i64 target-module]
    [cur-module-id : i64 module]
    [message : String ""]
    [ok : bool true]
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
    [decl-offset : i64 decls.offset]
    [index : i64 0]
    (begin
      (while (and ok (< index count))
        (begin
          (match (array-ref decl-slots (+ decl-offset index))
            [(ast.AstDecl.Module next-module) (set! cur-module-id next-module)]
            [(ast.AstDecl.Import decl-meta _) unit]
            [(ast.AstDecl.IncludeStr _ _) unit]
            [(ast.AstDecl.IncludeStrComptime _ _) unit]
            [(ast.AstDecl.IncludeStrLzss _ _) unit]
            [(ast.AstDecl.IncludeBin _ _) unit]
            [(ast.AstDecl.Test _ _ _) unit]
            [_
              (if (= cur-module-id target-module-id)
                (match (tc-bind-import-alias-decl-in-module
                  ctx
                  cur-env
                  alias
                  importer-module
                  import-unqualified
                  cur-module-id
                  (array-ref decl-slots (+ decl-offset index)))
                  [(ResultTcEnv.Ok next-env) (set! cur-env next-env)]
                  [(ResultTcEnv.Err step-message)
                    (begin
                      (set! message step-message)
                      (set! ok false))])
                unit)])
          (set! index (+ index 1))))
      (if (string.eq message "")
        (ResultTcEnv.Ok cur-env)
        (ResultTcEnv.Err message)))))

(define (tc-bind-import-alias-module
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [env : TcTypeEnv]
  [target-module : i64]
  [alias : i64]
  [importer-module : i64]
  [import-unqualified : bool]) : ResultTcEnv
  (tc-bind-import-alias-module-list
    ctx
    decls
    env
    target-module
    alias
    importer-module
    import-unqualified
    cbi.compiler-builtin-id-fix-empty))

(define (tc-bind-import-alias-module-with-index
  [ctx : TcContext]
  [summary-index : TcImportAliasSummaryIndex]
  [decls : ast.AstDeclList]
  [env : TcTypeEnv]
  [target-module : i64]
  [alias : i64]
  [importer-module : i64]
  [import-unqualified : bool]) : ResultTcEnv
  (match (tc-import-alias-summary-index-lookup summary-index target-module)
    [(TcImportAliasSummaryLookup.Found target-decls)
      (match (tc-bind-import-alias-module-list
        ctx
        target-decls
        env
        target-module
        alias
        importer-module
        import-unqualified
        target-module)
        [(ResultTcEnv.Ok next-env) (ResultTcEnv.Ok next-env)]
        [(ResultTcEnv.Err _)
          (tc-bind-import-alias-module
            ctx
            decls
            env
            target-module
            alias
            importer-module
            import-unqualified)])]
    [(TcImportAliasSummaryLookup.Missing)
      (tc-bind-import-alias-module
        ctx
        decls
        env
        target-module
        alias
        importer-module
        import-unqualified)]))

(define (tc-import-alias-materialized-key-id
  [alias-key : i64]
  [target-module : i64]) : i64
  (csym.compiler-composite-pair-key-id alias-key target-module))

(define (tc-import-alias-materialized? [seen : tc_i64_i64_map.Map] [key : i64]) : bool
  (match (tc_i64_i64_map.get (& seen) key)
    [(tc_i64_i64_map.LookupFound _) true]
    [(tc_i64_i64_map.LookupMissing) false]))

(define (tc-bind-selected-import-item
  [ctx : TcContext]
  [env : TcTypeEnv]
  [importer-module : i64]
  [target-module : i64]
  [item : i64]
  [alias : i64]) : ResultTcEnv
  (match (tc-import-alias-source-value-type env target-module item)
    [(ResultTcType.Ok ty)
      (let
        [source-name : i64 (tc-module-name-id-by-id target-module item)]
        [unsafe-binding : bool (tc-binding-unsafe-id? env source-name)]
        [c-abi-fnptr-binding : bool
          (tc-binding-c-abi-fnptr-id? env source-name)]
        (ResultTcEnv.Ok
          (if unsafe-binding
            (if c-abi-fnptr-binding
              (tc-bind-import-alias-value-unsafe-c-abi-fnptr-id
                ctx
                env
                importer-module
                importer-module
                target-module
                true
                alias
                ty)
              (tc-bind-import-alias-value-unsafe-id
                ctx
                env
                importer-module
                importer-module
                target-module
                true
                alias
                ty))
            (if c-abi-fnptr-binding
              (tc-bind-import-alias-value-c-abi-fnptr-id
                ctx
                env
                importer-module
                importer-module
                target-module
                true
                alias
                ty)
              (tc-bind-import-alias-value-id
                ctx
                env
                importer-module
                importer-module
                target-module
                true
                alias
                ty)))))]
    [(ResultTcType.Err _)
      (let
        [symbols : csym.CompilerSymbols (tc-context-symbols ctx)]
        (if (or
          (csym.compiler-symbols-handle-found?
            (csym.compiler-symbols-lookup-type-in-module-id-or
              symbols
              target-module
              item
              (csym.compiler-symbols-missing-handle)))
          (csym.compiler-symbols-handle-found?
            (csym.compiler-symbols-lookup-macro-in-module-id-or
              symbols
              target-module
              item
              (csym.compiler-symbols-missing-handle))))
          (ResultTcEnv.Ok env)
          (ResultTcEnv.Err
            (str_cat.str-cat
              "typecheck: selected import "
              (str_cat.str-cat
                (tc-env-key-name-text target-module)
                (str_cat.str-cat " has no item " (tc-env-key-name-text item)))))))]))

(define (tc-build-top-env-aliases-list
  [ctx : TcContext]
  [all-decls : ast.AstDeclList]
  [decls : ast.AstDeclList]
  [env : TcTypeEnv]
  [module-id : i64]) : ResultTcEnv
  ;; Index cursor rather than `ast-decl-list-step`. The wrapper peel still runs
  ;; by value (it needs owned `Box` storage to walk an `AstDecl.Unsafe` chain),
  ;; but it now reads the backing slot directly instead of a stepped-out copy,
  ;; so the 104 B row copy and the 144 B step result are gone.
  (let
    [cur-env : TcTypeEnv env]
    [cur-module-id : i64 module-id]
    [message : String ""]
    [ok : bool true]
    [summary-index : TcImportAliasSummaryIndex
      (tc-import-alias-summary-index-build all-decls)]
    [seen-aliases : tc_i64_i64_map.Map (tc_i64_i64_map.with-capacity 512)]
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
    [decl-offset : i64 decls.offset]
    [index : i64 0]
    (begin
      (while (and ok (< index count))
        (begin
          (match (ast.ast-decl-unwrapped
            (array-ref decl-slots (+ decl-offset index)))
            [(ast.AstDecl.Module next-module) (set! cur-module-id next-module)]
            [(ast.AstDecl.Import
                decl-meta
                (ast.AstImportSpec.Spec
                  (ast.AstImportKind.ModuleItem item)
                  _
                  (ast.AstMaybeModuleName.Some target-module)
                  (ast.AstMaybeImportAlias.Some alias)
                  _))
              (let
                [alias-key : i64
                  (csym.compiler-symbols-import-alias-key-id
                    cur-module-id
                    alias)]
                [seen-key : i64
                  (tc-import-alias-materialized-key-id alias-key target-module)]
                (if (tc-import-alias-materialized? seen-aliases seen-key)
                  unit
                  (begin
                    (tc_i64_i64_map.insert-ref! (&mut seen-aliases) seen-key 1)
                    (match (tc-bind-selected-import-item
                      ctx
                      cur-env
                      cur-module-id
                      target-module
                      item
                      alias)
                      [(ResultTcEnv.Ok next-env) (set! cur-env next-env)]
                      [(ResultTcEnv.Err step-message)
                        (begin
                          (set! message step-message)
                          (set! ok false))]))))]
            [(ast.AstDecl.Import
                decl-meta
                (ast.AstImportSpec.Spec
                  _
                  _
                  (ast.AstMaybeModuleName.Some target-module)
                  (ast.AstMaybeImportAlias.Some alias)
                  _))
              (let
                [alias-key : i64
                  (csym.compiler-symbols-import-alias-key-id
                    cur-module-id
                    alias)]
                [seen-key : i64
                  (tc-import-alias-materialized-key-id alias-key target-module)]
                (if (tc-import-alias-materialized? seen-aliases seen-key)
                  unit
                  (begin
                    (tc_i64_i64_map.insert-ref! (&mut seen-aliases) seen-key 1)
                    (if (= alias cbi.compiler-builtin-id-fix-empty)
                      (match (tc-bind-import-alias-module-with-index
                        ctx
                        summary-index
                        all-decls
                        cur-env
                        target-module
                        alias-key
                        cur-module-id
                        true)
                        [(ResultTcEnv.Ok next-env) (set! cur-env next-env)]
                        [(ResultTcEnv.Err step-message)
                          (begin
                            (set! message step-message)
                            (set! ok false))])
                      (begin
                        (let
                          [summary-backed : bool
                            (tc-import-alias-summary-backed?
                              summary-index
                              target-module)]
                          (tc-lazy-import-stub-record-for-job!
                            (tc-context-job-state ctx)
                            cur-module-id
                            alias
                            target-module
                            summary-backed))
                        unit)))))]
            [_ unit])
          (set! index (+ index 1))))
      (if (string.eq message "")
        (ResultTcEnv.Ok cur-env)
        (ResultTcEnv.Err message)))))

(define (tc-build-top-env [ctx : TcContext] [program : ast.AstProgram]) : ResultTcEnv
  (begin
    (tc-nominal-owner-cache-reset!)
    (tc-unqualified-import-ambiguity-reset!)
    ;; A whole-program rebuild replaces the active declaration view. Rebuild
    ;; the compact value-signature index from that same view so declarations
    ;; removed by a non-inert splice cannot survive as stale reflection hits.
    ;; Incremental Extend plans bypass this entry and update the index
    ;; as they bind only their additive/refreshed declarations.
    (ctfe_support.ctfe-module-value-reset-for-state!
      (tc-context-ctfe-macro-state ctx))
    ;; Expanded declarations retain their source aliases after lazy imports are
    ;; removed. Keep the expansion-time alias -> generated-module identities;
    ;; compile-start reset already prevents them leaking between programs.
    (match program
      [(ast.AstProgram.Program decls-box)
        (let
          [decls : ast.AstDeclList (__tl-box-place decls-box)]
          [body-state : TcBodyState (tc-context-body-state ctx)]
          [job-state : TcJobState body-state.job-state]
          [_surface-import-stubs : unit
            (tc-lazy-import-surface-stubs-record-for-job! job-state)]
          [membership-state : TcTopEnvMembershipState
            (tc-job-state-topenv-membership job-state)]
          [base-env : TcTypeEnv (tc-default-env-with-job-state job-state)]
          ;; Activate the membership bloom across the bind-list so the
          ;; enum-variant alias-if-free guard is O(1) instead of rescanning the
          ;; whole top-env spine per variant.
          [_membership-begin : unit
            (tc-topenv-membership-begin!
              membership-state
              base-env
              body-state.intern-table-id
              body-state.intern-generation)]
          (match (tc-build-top-env-list ctx decls base-env)
            [(ResultTcEnv.Ok env)
              (let
                [cached-env : TcTypeEnv (tc-env-with-cache env)]
                [_alias-fanout-begin : unit
                  (tc-topenv-membership-set-alias-fanout-active!
                    membership-state
                    true)]
                ;; Alias fanout copies canonical entries by lookup; cache the
                ;; source env before adding aliases so that copy is O(1).
                (match (tc-build-top-env-aliases-list
                  ctx
                  decls
                  decls
                  cached-env
                  cbi.compiler-builtin-id-fix-empty)
                  [(ResultTcEnv.Ok aliases)
                    (begin
                      (tc-topenv-membership-set-alias-fanout-active!
                        membership-state
                        false)
                      (tc-topenv-membership-end! membership-state)
                      ;; Membership is only needed while constructing the
                      ;; explicit top env. Detach the capability from the
                      ;; shared store so ordinary body binds pay only the
                      ;; zero-address check; incremental explicit builders
                      ;; reattach it for their scoped operation.
                      (tc-type-env-set-topenv-membership-state!
                        aliases
                        (TcTopEnvMembershipState 0))
                      (let
                        [out : TcTypeEnv
                          (tc-env-with-cache-layer-over-explicit aliases)]
                        (ResultTcEnv.Ok out)))]
                  [(ResultTcEnv.Err message)
                    (begin
                      (tc-topenv-membership-set-alias-fanout-active!
                        membership-state
                        false)
                      (tc-topenv-membership-end! membership-state)
                      (ResultTcEnv.Err message))]))]
            [(ResultTcEnv.Err message)
              (begin
                (tc-topenv-membership-end! membership-state)
                (ResultTcEnv.Err message))]))])))

;; Append-only env extension (plan P2). Given the live top-env and a materialized
;; module's export-summary (its decl list: `(module NAME)` header + generated
;; body, as recorded in the P1 memo), fold that module's exported symbols into the
;; env without a whole-program rebuild. The caller folds the generated module's
;; import marker into the same raw prefix and publishes one cache layer for the
;; combined delta. This is the incremental counterpart of
;; tc-build-top-env: because generated splices are additive/inert (they introduce
;; new names in their own module namespace and never redefine existing ones, see
;; macro-decl-cannot-fire? / the inert-splice arm), extending the env with a module
;; reproduces the same resolutions the whole-program env would compute. The summary
;; list carries its own `(module NAME)` header, which tc-build-top-env-list-in-module
;; honors, so the caller need not thread the module name separately.
(define (env-extend-with-module
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [summary : ast.AstDeclList]) : ResultTcEnv
  (match (ast.ast-decl-list-step summary)
    [(ast.AstDeclListStep.Nil) (ResultTcEnv.Ok top-env)]
    [(ast.AstDeclListStep.Cons _ _)
      (match (tc-build-top-env-list-explicit-in-module
        ctx
        summary
        top-env
        ""
        cbi.compiler-builtin-id-fix-empty)
        [(ResultTcEnv.Ok next-env) (ResultTcEnv.Ok next-env)]
        [(ResultTcEnv.Err message) (ResultTcEnv.Err message)])]))

;; Most module-owned values are uniquely named and can resolve through their
;; canonical module-qualified top-env key. Keep bindings whose source spelling
;; cannot be recovered from that key (root/dotted names), plus bindings whose
;; source name must preserve module-overlay shadowing order.
;;
;; Seed the existing per-module `seen` set with compile-root value names once.
;; A collision then takes the same LookupFound path as a repeated local name,
;; avoiding a second symbol-table lookup for every imported declaration.
(define (tc-module-local-root-shadow-name-note!
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [name-id : i64]) : unit
  (tc_i64_i64_map.insert-ref! seen (tc-env-name-key-id name-id) 1))

(define (tc-module-local-root-shadow-variants-note-at!
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [variants : (& variants ast.AstVariantDefList)]
  [index : i64]) : unit
  (if (>= index variants.len)
    unit
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(ast.AstVariantDef.Def name _ _)
        (begin
          (tc-module-local-root-shadow-name-note! seen name)
          (tc-module-local-root-shadow-variants-note-at!
            seen
            variants
            (+ index 1)))])))

(define (tc-module-local-root-shadow-cleanup-note!
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [cleanup-name : ast.AstStructCleanup]) : unit
  (match cleanup-name
    [(ast.AstStructCleanup.No) unit]
    [(ast.AstStructCleanup.Fn name)
      (tc-module-local-root-shadow-name-note! seen name)]))

(define (tc-module-local-root-shadow-enum-cleanup-note!
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [cleanup-name : ast.AstEnumCleanup]) : unit
  (match cleanup-name
    [(ast.AstEnumCleanup.No) unit]
    [(ast.AstEnumCleanup.Fn name)
      (tc-module-local-root-shadow-name-note! seen name)]))

(define (tc-module-local-root-shadow-decl-note!
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [decl : ast.AstDecl]) : unit
  (match decl
    [(ast.AstDecl.Unsafe inner-box)
      (tc-module-local-root-shadow-decl-note! seen (__tl-box-place inner-box))]
    [(ast.AstDecl.Def _ name _ _)
      (tc-module-local-root-shadow-name-note! seen name)]
    [(ast.AstDecl.DefFn _ name _ _ _ _)
      (tc-module-local-root-shadow-name-note! seen name)]
    [(ast.AstDecl.DefDispatch _ name _)
      (tc-module-local-root-shadow-name-note! seen name)]
    [(ast.AstDecl.Extern _ name _ _ _)
      (tc-module-local-root-shadow-name-note! seen name)]
    [(ast.AstDecl.DefEnum _ _ cleanup variants)
      (begin
        (tc-module-local-root-shadow-enum-cleanup-note! seen cleanup)
        (tc-module-local-root-shadow-variants-note-at! seen (& variants) 0))]
    [(ast.AstDecl.DefEnumLifetimes _ _ _ cleanup variants)
      (begin
        (tc-module-local-root-shadow-enum-cleanup-note! seen cleanup)
        (tc-module-local-root-shadow-variants-note-at! seen (& variants) 0))]
    [(ast.AstDecl.DefStruct _ name _ cleanup _)
      (begin
        (tc-module-local-root-shadow-name-note! seen name)
        (tc-module-local-root-shadow-cleanup-note! seen cleanup))]
    [(ast.AstDecl.DefStructLifetimes _ name _ _ cleanup _)
      (begin
        (tc-module-local-root-shadow-name-note! seen name)
        (tc-module-local-root-shadow-cleanup-note! seen cleanup))]
    [_ unit]))

(define (tc-module-local-root-shadow-names-note!
  [decls : ast.AstDeclList]
  [seen : (&mut seen tc_i64_i64_map.Map)]) : unit
  (let
    [slot : i64 (tc-module-decl-index-slot cbi.compiler-builtin-id-fix-empty)]
    (if (< slot 0)
      unit
      (let
        [j : i64 (array-ref tc-module-decl-index-starts slot)]
        [end : i64 (array-ref tc-module-decl-index-ends slot)]
        (while (< j end)
          (begin
            (tc-module-local-root-shadow-decl-note!
              seen
              (array-ref
                decls.slots
                (+ decls.offset (array-ref tc-module-decl-index-positions j))))
            (set! j (+ j 1))))))))

(define (tc-module-local-name-should-bind!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [name-id : i64]) : bool
  (if (or
    (csym.compiler-symbol-root-module-id? (tc-context-module-id ctx))
    (ci.intern-dotted? name-id))
    true
    (let
      [key-id : i64 (tc-env-name-key-id name-id)]
      (match (tc_i64_i64_map.get seen key-id)
        [(tc_i64_i64_map.LookupFound _) true]
        [(tc_i64_i64_map.LookupMissing)
          (begin
            (tc_i64_i64_map.insert-ref! seen key-id 1)
            (tc-name-bound-before-hygiene-global-boundary-id? env key-id))]))))

(define (tc-bind-struct-cleanup-local-shadowed!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [cleanup : ast.AstStructCleanup]
  [struct-ty : ast.AstType]) : TcTypeEnv
  (match cleanup
    [(ast.AstStructCleanup.No) env]
    [(ast.AstStructCleanup.Fn cleanup-name)
      (if (tc-module-local-name-should-bind! ctx env seen cleanup-name)
        (tc-bind-id
          env
          cleanup-name
          (tc-struct-cleanup-function-type struct-ty))
        env)]))

(define (tc-bind-enum-cleanup-local-shadowed!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [cleanup : ast.AstEnumCleanup]
  [enum-ty : ast.AstType]) : TcTypeEnv
  (match cleanup
    [(ast.AstEnumCleanup.No) env]
    [(ast.AstEnumCleanup.Fn cleanup-name)
      (if (tc-module-local-name-should-bind! ctx env seen cleanup-name)
        (tc-bind-id env cleanup-name (tc-enum-cleanup-function-type enum-ty))
        env)]))

(define (tc-bind-enum-variants-local-shadowed-at!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [scoped-enum-id : i64]
  [lifetimes : ast.AstLifetimeList]
  [variants : (& variants ast.AstVariantDefList)]
  [index : i64]) : TcTypeEnv
  (if (>= index variants.len)
    env
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(ast.AstVariantDef.Def name fields _)
        (tc-bind-enum-variants-local-shadowed-at!
          ctx
          (if (tc-module-local-name-should-bind! ctx env seen name)
            (tc-bind-id
              env
              name
              (tc-enum-variant-constructor-type-id
                ctx
                scoped-enum-id
                lifetimes
                fields))
            env)
          seen
          scoped-enum-id
          lifetimes
          variants
          (+ index 1))])))

(define (tc-module-local-env-add-decl
  [ctx : TcContext]
  [env : TcTypeEnv]
  [seen : (&mut seen tc_i64_i64_map.Map)]
  [decl : ast.AstDecl]) : ResultTcEnv
  (match decl
    [(ast.AstDecl.Unsafe inner-box)
      (let
        [inner : ast.AstDecl (__tl-box-place inner-box)]
        ;; Unsafety is carried by the local env binding, not the canonical
        ;; top-env key, so unsafe value declarations must always be overlaid.
        (match inner
          [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
            (match (tc-top-decl-type ctx inner)
              [(ResultTcType.Ok ty)
                (ResultTcEnv.Ok (tc-bind-unsafe-id env name ty))]
              [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
          [(ast.AstDecl.Extern decl-meta name kind _ _)
            (match (tc-top-decl-type ctx inner)
              [(ResultTcType.Ok ty)
                (ResultTcEnv.Ok
                  (if (tc-extern-value-c-abi-fnptr? ctx kind ty)
                    (tc-bind-unsafe-c-abi-fnptr-id env name ty)
                    (tc-bind-unsafe-id env name ty)))]
              [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
          [_ (ResultTcEnv.Ok env)]))]
    [(ast.AstDecl.Def decl-meta name _ _)
      (if (tc-module-local-name-should-bind! ctx env seen name)
        (match (tc-top-decl-type-with-env ctx env decl)
          [(ResultTcType.Ok ty) (ResultTcEnv.Ok (tc-bind-id env name ty))]
          [(ResultTcType.Err message) (ResultTcEnv.Err message)])
        (ResultTcEnv.Ok env))]
    [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
      (if (tc-module-local-name-should-bind! ctx env seen name)
        (match (tc-top-decl-type ctx decl)
          [(ResultTcType.Ok ty) (ResultTcEnv.Ok (tc-bind-id env name ty))]
          [(ResultTcType.Err message) (ResultTcEnv.Err message)])
        (ResultTcEnv.Ok env))]
    [(ast.AstDecl.DefDispatch decl-meta name _)
      (if (tc-module-local-name-should-bind! ctx env seen name)
        (match (tc-top-decl-type ctx decl)
          [(ResultTcType.Ok ty) (ResultTcEnv.Ok (tc-bind-id env name ty))]
          [(ResultTcType.Err message) (ResultTcEnv.Err message)])
        (ResultTcEnv.Ok env))]
    [(ast.AstDecl.Extern decl-meta name kind _ _)
      (if (tc-module-local-name-should-bind! ctx env seen name)
        (match (tc-top-decl-type ctx decl)
          [(ResultTcType.Ok ty)
            (ResultTcEnv.Ok
              (if (tc-extern-value-c-abi-fnptr? ctx kind ty)
                (tc-bind-c-abi-fnptr-id env name ty)
                (tc-bind-id env name ty)))]
          [(ResultTcType.Err message) (ResultTcEnv.Err message)])
        (ResultTcEnv.Ok env))]
    [(ast.AstDecl.DefEnum decl-meta name cleanup variants)
      (let
        [scoped-name : i64
          (tc-module-name-id-by-id (tc-context-module-id ctx) name)]
        [enum-ty : ast.AstType (ast.AstType.Enum scoped-name)]
        (ResultTcEnv.Ok
          (tc-bind-enum-cleanup-local-shadowed!
            ctx
            (tc-bind-enum-variants-local-shadowed-at!
              ctx
              env
              seen
              scoped-name
              (ast.ast-lifetime-list-new)
              (& variants)
              0)
            seen
            cleanup
            enum-ty)))]
    [(ast.AstDecl.DefEnumLifetimes decl-meta name lifetimes cleanup variants)
      (let
        [scoped-name : i64
          (tc-module-name-id-by-id (tc-context-module-id ctx) name)]
        [enum-ty : ast.AstType (ast.ast-ty-enum-args scoped-name lifetimes)]
        (ResultTcEnv.Ok
          (tc-bind-enum-cleanup-local-shadowed!
            ctx
            (tc-bind-enum-variants-local-shadowed-at!
              ctx
              env
              seen
              scoped-name
              lifetimes
              (& variants)
              0)
            seen
            cleanup
            enum-ty)))]
    [(ast.AstDecl.DefStruct decl-meta name _ cleanup fields)
      (let
        [struct-ty : ast.AstType
          (ast.AstType.Struct
            (tc-module-name-id-by-id (tc-context-module-id ctx) name))]
        [constructor-ty : ast.AstType
          (ast.ast-ty-func (tc-field-type-list ctx fields) struct-ty)]
        (ResultTcEnv.Ok
          (tc-bind-struct-cleanup-local-shadowed!
            ctx
            (if (tc-module-local-name-should-bind! ctx env seen name)
              (tc-bind-id env name constructor-ty)
              env)
            seen
            cleanup
            struct-ty)))]
    [(ast.AstDecl.DefStructLifetimes decl-meta name lifetimes _ cleanup fields)
      (let
        [struct-ty : ast.AstType
          (ast.ast-ty-struct-args
            (tc-module-name-id-by-id (tc-context-module-id ctx) name)
            lifetimes)]
        [constructor-ty : ast.AstType
          (ast.ast-ty-func (tc-field-type-list ctx fields) struct-ty)]
        (ResultTcEnv.Ok
          (tc-bind-struct-cleanup-local-shadowed!
            ctx
            (if (tc-module-local-name-should-bind! ctx env seen name)
              (tc-bind-id env name constructor-ty)
              env)
            seen
            cleanup
            struct-ty)))]
    [(ast.AstDecl.Import
        decl-meta
        (ast.AstImportSpec.Spec
          _
          _
          (ast.AstMaybeModuleName.Some target-module)
          (ast.AstMaybeImportAlias.Some alias)
          _))
      (if (= alias cbi.compiler-builtin-id-fix-empty)
        (match (tc-context-program ctx)
          [(ast.AstProgram.Program decls-box)
            (tc-bind-import-alias-module
              ctx
              (__tl-box-place decls-box)
              env
              target-module
              cbi.compiler-builtin-id-fix-empty
              (tc-context-module-id ctx)
              true)])
        (ResultTcEnv.Ok env))]
    [_ (ResultTcEnv.Ok env)]))

(define (tc-module-local-env-list
  [ctx : TcContext]
  [decls : ast.AstDeclList]
  [env : TcTypeEnv]
  [_ : String]
  [target-module-id : i64]
  [_module : String]) : ResultTcEnv
  (let
    [_ensure : unit (tc-module-decl-index-ensure! decls)]
    [slot : i64 (tc-module-decl-index-slot target-module-id)]
    [root-slot : i64
      (tc-module-decl-index-slot cbi.compiler-builtin-id-fix-empty)]
    (if (< slot 0)
      (ResultTcEnv.Ok env)
      (let
        [j : i64 (array-ref tc-module-decl-index-starts slot)]
        [end : i64 (array-ref tc-module-decl-index-ends slot)]
        [root-count : i64
          (if (< root-slot 0)
            0
            (-
              (array-ref tc-module-decl-index-ends root-slot)
              (array-ref tc-module-decl-index-starts root-slot)))]
        [cur-env : TcTypeEnv env]
        [seen : tc_i64_i64_map.Map
          (tc_i64_i64_map.with-capacity (+ (+ (- end j) root-count) 1))]
        [_root-shadows : unit
          (tc-module-local-root-shadow-names-note! decls (&mut seen))]
        [message : String ""]
        [ok : bool true]
        (begin
          (while (and ok (< j end))
            (let
              [decl : ast.AstDecl
                (array-ref
                  decls.slots
                  (+ decls.offset (array-ref tc-module-decl-index-positions j)))]
              (begin
                (match decl
                  [(ast.AstDecl.Module _) unit]
                  [_
                    (match (tc-module-local-env-add-decl
                      ctx
                      cur-env
                      (&mut seen)
                      decl)
                      [(ResultTcEnv.Ok next-env) (set! cur-env next-env)]
                      [(ResultTcEnv.Err step-message)
                        (begin
                          (set! message step-message)
                          (set! ok false))])])
                (set! j (+ j 1)))))
          (if ok
            (ResultTcEnv.Ok cur-env)
            (ResultTcEnv.Err message)))))))

(define (tc-module-local-env-id
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [module : String]
  [module-id : i64]) : ResultTcEnv
  (if (= module-id cbi.compiler-builtin-id-fix-empty)
    (ResultTcEnv.Ok top-env)
    (match (if (macro-segmented-program-active? (tc-context-job-state ctx))
      (macro-segmented-module-local-env-id
        (tc-context-with-module-id ctx module module-id)
        top-env
        module-id)
      (match (tc-context-program ctx)
        [(ast.AstProgram.Program decls-box)
          (tc-module-local-env-list
            (tc-context-with-module-id ctx module module-id)
            (__tl-box-place decls-box)
            top-env
            module
            module-id
            "")]))
      [(ResultTcEnv.Ok env)
        ;; A module view is immutable once built. Publish its local bindings as
        ;; one explicit cache layer so every function-local cache falls through
        ;; to it instead of copying the complete module prefix again.
        (ResultTcEnv.Ok (tc-env-with-cache-layer-over-explicit env))]
      [(ResultTcEnv.Err message) (ResultTcEnv.Err message)])))

(define (tc-module-local-env-cache-lookup-at
  [cache : TcModuleLocalEnvCache]
  [module-id : i64]
  [index : i64]) : TcMaybeTypeEnv
  (if (>= index cache.len)
    (TcMaybeTypeEnv.No)
    (let
      [entry : TcModuleLocalEnvEntry (array-ref cache.slots index)]
      (if (= entry.module-id module-id)
        (TcMaybeTypeEnv.Some entry.env)
        (tc-module-local-env-cache-lookup-at cache module-id (+ index 1))))))

(define (tc-module-local-env-cache-lookup
  [cache : TcModuleLocalEnvCache]
  [module-id : i64]) : TcMaybeTypeEnv
  (tc-module-local-env-cache-lookup-at cache module-id 0))

(define (tc-module-local-env-cache-insert
  [cache : TcModuleLocalEnvCache]
  [module-id : i64]
  [env : TcTypeEnv]) : TcModuleLocalEnvCache
  (let
    [n : i64 cache.len]
    [src : (__tl_dyn-array TcModuleLocalEnvEntry) cache.slots]
    [slots : (__tl_dyn-array TcModuleLocalEnvEntry)
      (array.make-array TcModuleLocalEnvEntry (+ n 1))]
    [i : i64 0]
    (begin
      (while (< i n)
        (begin
          (set! (array-ref slots i) (array-ref src i))
          (set! i (+ i 1))))
      (set! (array-ref slots n) (TcModuleLocalEnvEntry module-id env))
      (TcModuleLocalEnvCache slots (+ n 1)))))

(define (tc-module-local-env-cached-id
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [module : String]
  [module-id : i64]
  [cache : TcModuleLocalEnvCache]) : ResultTcModuleLocalEnv
  (if (= module-id cbi.compiler-builtin-id-fix-empty)
    (ResultTcModuleLocalEnv.Ok top-env cache)
    (match (tc-module-local-env-cache-lookup cache module-id)
      [(TcMaybeTypeEnv.Some env)
        (begin
          (cfg compile-profile (compiler-tc-env-profile-note-module-local-hit))
          (ResultTcModuleLocalEnv.Ok env cache))]
      [(TcMaybeTypeEnv.No)
        (begin
          (cfg compile-profile (compiler-tc-env-profile-note-module-local-miss))
          (match (tc-module-local-env-id ctx top-env module module-id)
            [(ResultTcEnv.Ok env)
              (ResultTcModuleLocalEnv.Ok
                env
                (tc-module-local-env-cache-insert cache module-id env))]
            [(ResultTcEnv.Err message) (ResultTcModuleLocalEnv.Err message)]))])))

(define (tc-expect
  [actual : ast.AstType]
  [expected : ast.AstType]
  [message : String]) : ResultTcUnit
  (if (tc-type-compatible? expected actual)
    ResultTcUnit.Ok
    (ResultTcUnit.Err (tc-type-mismatch-message actual expected message))))

(define (tc-expect-in-context
  [ctx : TcContext]
  [env : TcTypeEnv]
  [actual : ast.AstType]
  [expected : ast.AstType]
  [message : String]) : ResultTcUnit
  (cond
    [(tc-type-coercible? ctx env expected actual) ResultTcUnit.Ok]
    [else
      (let
        [canonical-actual : ast.AstType
          (tc-canonicalize-inferred-type ctx actual)]
        (cond
          [(tc-type-coercible? ctx env expected canonical-actual)
            ResultTcUnit.Ok]
          [else
            (let
              [canonical-expected : ast.AstType
                (tc-canonicalize-inferred-type ctx expected)]
              (cond
                [(tc-type-coercible?
                    ctx
                    env
                    canonical-expected
                    canonical-actual)
                  ResultTcUnit.Ok]
                [else
                  (ResultTcUnit.Err
                    (tc-type-mismatch-message-in-context
                      ctx
                      env
                      canonical-actual
                      expected
                      message))]))]))]))

(define (tc-contextual-result-type
  [expected : ast.AstType]
  [actual : ast.AstType]) : ast.AstType
  ;; Preserve active allocation-owner tags, but let a successful checker-only
  ;; lifetime coercion expose the required shorter reference/nominal lifetime.
  (if (tc-type-contains-region-tag? actual)
    actual
    expected))

(define (tc-float-literal-non-finite-message [ty-name : String]) : String
  (str_cat.str-cat "typecheck: non-finite " ty-name " literal is not supported"))

(define (tc-float-literal-f64-type [text : String]) : ResultTcType
  (match (cfloat.compiler-float-parse-f64 text)
    [(CompilerFloatSomeF64 value)
      (if (cfloat.compiler-float-f64-finite? value)
        (ResultTcType.Ok (ast.AstType.F64))
        (ResultTcType.Err (tc-float-literal-non-finite-message "f64")))]
    [(CompilerFloatNoF64)
      (if (cfloat.compiler-float-decimal-syntax? text)
        (ResultTcType.Err (tc-float-literal-non-finite-message "f64"))
        (ResultTcType.Err "typecheck: invalid f64 literal"))]))

(define (tc-float-literal-f32-type [text : String] [expected : ast.AstType]) : ResultTcType
  (match (cfloat.compiler-float-parse-f64 text)
    [(CompilerFloatSomeF64 value)
      (let
        [rounded : f64 (cfloat.compiler-float-round-f32-as-f64 value)]
        (if (and
          (cfloat.compiler-float-f64-finite? value)
          (cfloat.compiler-float-f64-finite? rounded))
          (ResultTcType.Ok expected)
          (ResultTcType.Err (tc-float-literal-non-finite-message "f32"))))]
    [(CompilerFloatNoF64)
      (if (cfloat.compiler-float-decimal-syntax? text)
        (ResultTcType.Err (tc-float-literal-non-finite-message "f32"))
        (ResultTcType.Err "typecheck: invalid f64 literal"))]))

(define (tc-float-literal-type-with-expected
  [text : String]
  [expected : ast.AstType]) : ResultTcType
  (if (tc-type-eq (tc-type-strip-region expected) (ast.AstType.F32))
    (tc-float-literal-f32-type text expected)
    (match (tc-float-literal-f64-type text)
      [(ResultTcType.Ok actual)
        (if (tc-type-compatible? expected actual)
          (ResultTcType.Ok (tc-contextual-result-type expected actual))
          (ResultTcType.Ok actual))]
      [(ResultTcType.Err message) (ResultTcType.Err message)])))

(define (tc-literal-type-checked [lit : ast.AstLiteral]) : ResultTcType
  (match lit
    [(ast.AstLiteral.Float text) (tc-float-literal-f64-type text)]
    [_ (ResultTcType.Ok (tc-literal-type lit))]))

(define (tc-float-literal-expr? [expr : ast.AstExpr]) : bool
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (ast.ast-node-get inner-box)]
        (tc-float-literal-expr? inner))]
    [(ast.AstExpr.MacroExpansion inner-box _ _)
      (tc-float-literal-expr? (ast.ast-node-get inner-box))]
    [(ast.AstExpr.Literal lit)
      (match lit
        [(ast.AstLiteral.Float _) true]
        [_ false])]
    [_ false]))

(define (tc-float-literal-expr-with-expected
  [expr : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcType
  (match expr
    [(ast.AstExpr.Spanned inner-box span)
      (let
        [inner : ast.AstExpr (ast.ast-node-get inner-box)]
        (match (tc-float-literal-expr-with-expected inner expected)
          [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
          [(ResultTcType.Err message)
            (tc-locate-spanned-error inner span message)]))]
    [(ast.AstExpr.MacroExpansion inner-box _ _)
      (tc-float-literal-expr-with-expected
        (ast.ast-node-get inner-box)
        expected)]
    [(ast.AstExpr.Literal lit)
      (match lit
        [(ast.AstLiteral.Float text)
          (tc-float-literal-type-with-expected text expected)]
        [_ (ResultTcType.Ok (tc-literal-type lit))])]
    [_ (ResultTcType.Ok (ast.AstType.F64))]))

(define (tc-integer-literal-expr? [expr : ast.AstExpr]) : bool
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (ast.ast-node-get inner-box)]
        (tc-integer-literal-expr? inner))]
    [(ast.AstExpr.MacroExpansion inner-box _ _)
      (tc-integer-literal-expr? (ast.ast-node-get inner-box))]
    [(ast.AstExpr.Literal lit)
      (match lit
        [(ast.AstLiteral.Int _ _) true]
        [_ false])]
    [_ false]))

(define (tc-integer-literal-expr-with-expected
  [ctx : TcContext]
  [expr : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcType
  (match expr
    [(ast.AstExpr.Spanned inner-box span)
      (let
        [inner : ast.AstExpr (ast.ast-node-get inner-box)]
        (match (tc-integer-literal-expr-with-expected ctx inner expected)
          [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
          [(ResultTcType.Err message)
            (tc-locate-spanned-error inner span message)]))]
    [(ast.AstExpr.MacroExpansion inner-box _ _)
      (tc-integer-literal-expr-with-expected
        ctx
        (ast.ast-node-get inner-box)
        expected)]
    [(ast.AstExpr.Literal lit)
      (match lit
        [(ast.AstLiteral.Int value text)
          (tc-integer-literal-type-with-expected ctx value text expected)]
        [_ (ResultTcType.Ok (tc-literal-type lit))])]
    [_ (ResultTcType.Ok (ast.AstType.I32))]))

(define (tc-binop-types-from-left
  [ctx : TcContext]
  [env : TcTypeEnv]
  [op : ast.AstBinOp]
  [left-ty : ast.AstType]
  [right : ast.AstExpr]) : ResultTcBinOpTypes
  (match (tc-expr-with-expected-or-actual ctx env right left-ty)
    [(ResultTcType.Ok right-ty)
      (match (tc-binop-type op left-ty right-ty)
        [(ResultTcType.Ok result-ty)
          (ResultTcBinOpTypes.Ok (TcBinOpTypes left-ty right-ty result-ty))]
        [(ResultTcType.Err message) (ResultTcBinOpTypes.Err message)])]
    [(ResultTcType.Err message) (ResultTcBinOpTypes.Err message)]))

(define (tc-binop-types-from-right
  [ctx : TcContext]
  [op : ast.AstBinOp]
  [left : ast.AstExpr]
  [right-ty : ast.AstType]) : ResultTcBinOpTypes
  (match (tc-integer-literal-expr-with-expected ctx left right-ty)
    [(ResultTcType.Ok left-ty)
      (match (tc-binop-type op left-ty right-ty)
        [(ResultTcType.Ok result-ty)
          (ResultTcBinOpTypes.Ok (TcBinOpTypes left-ty right-ty result-ty))]
        [(ResultTcType.Err message) (ResultTcBinOpTypes.Err message)])]
    [(ResultTcType.Err message) (ResultTcBinOpTypes.Err message)]))

(define (tc-binop-types-with-same-operands
  [op : ast.AstBinOp]
  [operand-ty : ast.AstType]) : ResultTcBinOpTypes
  (match (tc-binop-type op operand-ty operand-ty)
    [(ResultTcType.Ok result-ty)
      (ResultTcBinOpTypes.Ok (TcBinOpTypes operand-ty operand-ty result-ty))]
    [(ResultTcType.Err message) (ResultTcBinOpTypes.Err message)]))

(define (tc-binop-expr-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [op : ast.AstBinOp]
  [left : ast.AstExpr]
  [right : ast.AstExpr]) : ResultTcBinOpTypes
  (match (tc-expr ctx env left)
    [(ResultTcType.Ok left-ty)
      (if (tc-float-literal-expr? left)
        (match (tc-expr ctx env right)
          [(ResultTcType.Ok right-actual)
            (if (tc-type-eq
              (tc-type-strip-region right-actual)
              (ast.AstType.F32))
              (match (tc-float-literal-expr-with-expected
                left
                (ast.AstType.F32))
                [(ResultTcType.Ok _)
                  (tc-binop-types-with-same-operands op (ast.AstType.F32))]
                [(ResultTcType.Err message) (ResultTcBinOpTypes.Err message)])
              (tc-binop-types-from-left ctx env op left-ty right))]
          [(ResultTcType.Err message) (ResultTcBinOpTypes.Err message)])
        (if (tc-integer-literal-expr? left)
          (match (tc-expr ctx env right)
            [(ResultTcType.Ok right-actual)
              (if (tc-integer-type? right-actual)
                (tc-binop-types-from-right ctx op left right-actual)
                (tc-binop-types-from-left ctx env op left-ty right))]
            [(ResultTcType.Err message) (ResultTcBinOpTypes.Err message)])
          (tc-binop-types-from-left ctx env op left-ty right)))]
    [(ResultTcType.Err message) (ResultTcBinOpTypes.Err message)]))

(define (tc-binop-contextual-operand-type
  [op : ast.AstBinOp]
  [expected : ast.AstType]) : ast.AstMaybeType
  (match op
    [(ast.AstBinOp.Add)
      (if (or (tc-integer-type? expected) (tc-float-type? expected))
        (ast.AstMaybeType.Some expected)
        (ast.AstMaybeType.No))]
    [(ast.AstBinOp.Sub)
      (if (or (tc-integer-type? expected) (tc-float-type? expected))
        (ast.AstMaybeType.Some expected)
        (ast.AstMaybeType.No))]
    [(ast.AstBinOp.Mul)
      (if (or (tc-integer-type? expected) (tc-float-type? expected))
        (ast.AstMaybeType.Some expected)
        (ast.AstMaybeType.No))]
    [(ast.AstBinOp.Div)
      (if (or (tc-integer-type? expected) (tc-float-type? expected))
        (ast.AstMaybeType.Some expected)
        (ast.AstMaybeType.No))]
    [(ast.AstBinOp.Mod)
      (if (tc-integer-type? expected)
        (ast.AstMaybeType.Some expected)
        (ast.AstMaybeType.No))]
    [(ast.AstBinOp.BitAnd)
      (if (tc-integer-type? expected)
        (ast.AstMaybeType.Some expected)
        (ast.AstMaybeType.No))]
    [(ast.AstBinOp.BitOr)
      (if (tc-integer-type? expected)
        (ast.AstMaybeType.Some expected)
        (ast.AstMaybeType.No))]
    [(ast.AstBinOp.BitXor)
      (if (tc-integer-type? expected)
        (ast.AstMaybeType.Some expected)
        (ast.AstMaybeType.No))]
    [(ast.AstBinOp.Shl)
      (if (tc-integer-type? expected)
        (ast.AstMaybeType.Some expected)
        (ast.AstMaybeType.No))]
    [(ast.AstBinOp.Shr)
      (if (tc-integer-type? expected)
        (ast.AstMaybeType.Some expected)
        (ast.AstMaybeType.No))]
    [(ast.AstBinOp.And)
      (if (tc-type-eq expected (ast.AstType.Bool))
        (ast.AstMaybeType.Some expected)
        (ast.AstMaybeType.No))]
    [(ast.AstBinOp.Or)
      (if (tc-type-eq expected (ast.AstType.Bool))
        (ast.AstMaybeType.Some expected)
        (ast.AstMaybeType.No))]
    [_ (ast.AstMaybeType.No)]))

(define (tc-binary-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [op : ast.AstBinOp]
  [left : ast.AstExpr]
  [right : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcType
  (let
    [operand-expected : ast.AstType
      (tc-type-without-regions (tc-resolve-type ctx expected))]
    (match (tc-binop-contextual-operand-type op operand-expected)
      [(ast.AstMaybeType.No) (tc-expr ctx env expr)]
      [(ast.AstMaybeType.Some operand-ty)
        (match (tc-expr-with-expected-or-actual ctx env left operand-ty)
          [(ResultTcType.Ok left-ty)
            (match (tc-expr-with-expected-or-actual ctx env right operand-ty)
              [(ResultTcType.Ok right-ty)
                (match (tc-binop-type op left-ty right-ty)
                  [(ResultTcType.Ok result-ty)
                    (if (tc-type-compatible? expected result-ty)
                      (ResultTcType.Ok
                        (tc-contextual-result-type expected result-ty))
                      (ResultTcType.Ok result-ty))]
                  [(ResultTcType.Err _) (tc-expr ctx env expr)])]
              [(ResultTcType.Err message) (ResultTcType.Err message)])]
          [(ResultTcType.Err message) (ResultTcType.Err message)])])))

(define (tc-unop-contextual-operand-type
  [op : ast.AstUnOp]
  [expected : ast.AstType]) : ast.AstMaybeType
  (match op
    [(ast.AstUnOp.Neg)
      (if (or (tc-integer-type? expected) (tc-float-type? expected))
        (ast.AstMaybeType.Some expected)
        (ast.AstMaybeType.No))]
    [(ast.AstUnOp.BitNot)
      (if (tc-integer-type? expected)
        (ast.AstMaybeType.Some expected)
        (ast.AstMaybeType.No))]
    [(ast.AstUnOp.Not)
      (if (tc-type-eq expected (ast.AstType.Bool))
        (ast.AstMaybeType.Some expected)
        (ast.AstMaybeType.No))]))

(define (tc-unary-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [op : ast.AstUnOp]
  [inner : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcType
  (let
    [operand-expected : ast.AstType
      (tc-type-without-regions (tc-resolve-type ctx expected))]
    (match (tc-unop-contextual-operand-type op operand-expected)
      [(ast.AstMaybeType.No) (tc-expr ctx env expr)]
      [(ast.AstMaybeType.Some operand-ty)
        (match (tc-expr-with-expected-or-actual ctx env inner operand-ty)
          [(ResultTcType.Ok inner-ty)
            (match (tc-unop-type op inner-ty)
              [(ResultTcType.Ok result-ty)
                (if (tc-type-compatible? expected result-ty)
                  (ResultTcType.Ok
                    (tc-contextual-result-type expected result-ty))
                  (ResultTcType.Ok result-ty))]
              [(ResultTcType.Err _) (tc-expr ctx env expr)])]
          [(ResultTcType.Err message) (ResultTcType.Err message)])])))

(define (tc-expr-list-with-expected-elements
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]
  [elem-ty : ast.AstType]) : ResultTcUnit
  (tc-expr-list-with-expected-elements-at ctx env (& exprs) 0 elem-ty))

(define (tc-expr-list-with-expected-elements-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [elem-ty : ast.AstType]) : ResultTcUnit
  (if (>= index exprs.len)
    ResultTcUnit.Ok
    (match (tc-expr-with-expected-or-actual-id
      ctx
      env
      (ast.ast-expr-list-get exprs index 0)
      elem-ty)
      [(ResultTcType.Ok got)
        (match (tc-expect
          got
          elem-ty
          "typecheck: array elements must have same type")
          [(ResultTcUnit.Ok)
            (tc-expr-list-with-expected-elements-at
              ctx
              env
              exprs
              (+ index 1)
              elem-ty)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
      [(ResultTcType.Err message) (ResultTcUnit.Err message)])))

(define (tc-expr-array-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]
  [elem-ty : ast.AstType]
  [expected-len : i64]) : ResultTcType
  (if (= (tc-expr-list-len exprs) expected-len)
    (match (tc-ensure-cleanup-resource-not-stored-list env exprs)
      [(ResultTcUnit.Ok)
        (match (tc-expr-list-with-expected-elements ctx env exprs elem-ty)
          [(ResultTcUnit.Ok)
            (ResultTcType.Ok (ast.ast-ty-array elem-ty expected-len))]
          [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
      [(ResultTcUnit.Err message) (ResultTcType.Err message)])
    (tc-expr ctx env (ast.AstExpr.Array exprs))))

(define (tc-dyn-array-literal-element-supported
  [env : TcTypeEnv]
  [elem-ty : ast.AstType]) : ResultTcUnit
  (if (tc-dyn-array-elem-supported? env elem-ty)
    ResultTcUnit.Ok
    (ResultTcUnit.Err
      "typecheck: dynamic array literal element type is not supported")))

(define (tc-expr-dyn-array-literal-with-elem
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]
  [elem-ty : ast.AstType]) : ResultTcType
  (let
    [resolved-elem : ast.AstType (tc-resolve-type ctx elem-ty)]
    (match (tc-ensure-cleanup-resource-not-stored-list env exprs)
      [(ResultTcUnit.Ok)
        (match (tc-dyn-array-literal-element-supported env resolved-elem)
          [(ResultTcUnit.Ok)
            (match (tc-expr-list-with-expected-elements
              ctx
              env
              exprs
              resolved-elem)
              [(ResultTcUnit.Ok)
                (ResultTcType.Ok
                  (tc-tag-active-region
                    env
                    (ast.ast-ty-dyn-array resolved-elem)))]
              [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
          [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
      [(ResultTcUnit.Err message) (ResultTcType.Err message)])))

(define (tc-expr-dyn-array-literal-infer
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]) : ResultTcType
  (match (tc-ensure-cleanup-resource-not-stored-list env exprs)
    [(ResultTcUnit.Ok)
      (if (ast.ast-expr-list-empty? (& exprs))
        (ResultTcType.Err
          "typecheck: cannot infer element type of empty dynamic array literal")
        (let
          [first : i64 (ast.ast-expr-list-get (& exprs) 0 0)]
          [rest : ast.AstExprList (ast.ast-expr-list-tail-from-ref (& exprs) 1)]
          (match (tc-expr-id ctx env first)
            [(ResultTcType.Ok first-ty)
              (match (tc-dyn-array-literal-element-supported env first-ty)
                [(ResultTcUnit.Ok)
                  (match (tc-check-array-rest ctx env rest first-ty)
                    [(ResultTcUnit.Ok)
                      (ResultTcType.Ok
                        (tc-tag-active-region
                          env
                          (ast.ast-ty-dyn-array first-ty)))]
                    [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
            [(ResultTcType.Err message) (ResultTcType.Err message)])))]
    [(ResultTcUnit.Err message) (ResultTcType.Err message)]))

(define (tc-expr-dyn-array-literal-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]
  [expected : ast.AstType]) : ResultTcType
  (match (tc-type-strip-region (tc-resolve-type ctx expected))
    [(ast.AstType.DynArray elem-ty)
      (tc-expr-dyn-array-literal-with-elem
        ctx
        env
        exprs
        (tc-context-type-get ctx elem-ty))]
    [_ (tc-expr-dyn-array-literal-infer ctx env exprs)]))

(define (tc-expr-if-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [cond : ast.AstExpr]
  [then-branch : ast.AstExpr]
  [else-branch : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcType
  (match (tc-expr ctx env cond)
    [(ResultTcType.Ok cond-ty)
      (match (tc-expect
        cond-ty
        (ast.AstType.Bool)
        "typecheck: if condition must be bool")
        [(ResultTcUnit.Ok)
          (match (tc-expr-with-expected-or-actual ctx env then-branch expected)
            [(ResultTcType.Ok then-ty)
              (match (tc-expr-with-expected-or-actual
                ctx
                env
                else-branch
                expected)
                [(ResultTcType.Ok else-ty)
                  (if (and
                    (tc-type-coercible? ctx env expected then-ty)
                    (tc-type-coercible? ctx env expected else-ty))
                    (ResultTcType.Ok expected)
                    (tc-merge-branch-type ctx env then-ty else-ty))]
                [(ResultTcType.Err message) (ResultTcType.Err message)])]
            [(ResultTcType.Err message) (ResultTcType.Err message)])]
        [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (tc-type-list-len [types : ast.AstTypeList]) : i64
  (ast.ast-type-list-len (& types)))

;; Flow each tuple element into its expected element type so contextual
;; literals (e.g. f32 floats) resolve against the tuple's declared element
;; type instead of their default. Returns the resolved element types.
(define (tc-check-tuple-elements-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]
  [types : ast.AstTypeList]) : ResultTcTypeList
  (let
    [out : ast.AstTypeList (ast.ast-type-list-new)]
    (match (tc-check-tuple-elements-with-expected-into-at
      ctx
      env
      (& exprs)
      (& types)
      0
      (&mut out))
      [(ResultTcUnit.Ok) (ResultTcTypeList.Ok out)]
      [(ResultTcUnit.Err message) (ResultTcTypeList.Err message)])))

(define (tc-check-tuple-elements-with-expected-into-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [out : (&mut out ast.AstTypeList)]) : ResultTcUnit
  (if (>= index exprs.len)
    (if (>= index (ast.ast-type-list-len types))
      ResultTcUnit.Ok
      (ResultTcUnit.Err "typecheck: tuple element type mismatch"))
    (if (>= index (ast.ast-type-list-len types))
      (ResultTcUnit.Err "typecheck: tuple element type mismatch")
      (let
        [expr-id : i64 (ast.ast-expr-list-get exprs index 0)]
        [want : ast.AstType
          (ast.ty-node-get
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
        (match (tc-expr-with-expected-or-actual-id ctx env expr-id want)
          [(ResultTcType.Ok got)
            (match (tc-expect got want "typecheck: tuple element type mismatch")
              [(ResultTcUnit.Ok)
                (begin
                  (ast.ast-type-list-push
                    out
                    (ast.ast-node-pool-reader-type-push
                      (tc-contextual-result-type want got)))
                  (tc-check-tuple-elements-with-expected-into-at
                    ctx
                    env
                    exprs
                    types
                    (+ index 1)
                    out))]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcType.Err message) (ResultTcUnit.Err message)])))))

(define (tc-expr-tuple-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]
  [expected-elems : ast.AstTypeList]) : ResultTcType
  (if (= (tc-expr-list-len exprs) (tc-type-list-len expected-elems))
    (match (tc-ensure-cleanup-resource-not-stored-list env exprs)
      [(ResultTcUnit.Ok)
        (match (tc-check-tuple-elements-with-expected
          ctx
          env
          exprs
          expected-elems)
          [(ResultTcTypeList.Ok result-elems)
            (ResultTcType.Ok (ast.ast-ty-tuple result-elems))]
          [(ResultTcTypeList.Err message) (ResultTcType.Err message)])]
      [(ResultTcUnit.Err message) (ResultTcType.Err message)])
    (tc-expr ctx env (ast.AstExpr.Tuple exprs))))

;; Flow the expected type into a begin's final expression so a contextual
;; literal in tail position resolves against it; non-final expressions keep
;; the non-contextual policy (any type is allowed).
(define (tc-begin-list-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]
  [expected : ast.AstType]) : ResultTcType
  (tc-begin-list-with-expected-at ctx env (& exprs) 0 expected))

(define (tc-begin-list-with-expected-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [expected : ast.AstType]) : ResultTcType
  (if (>= index exprs.len)
    (ResultTcType.Ok (ast.AstType.Unit))
    (if (= (+ index 1) exprs.len)
      (tc-expr-with-expected-or-actual-id
        ctx
        env
        (ast.ast-expr-list-get exprs index 0)
        expected)
      (match (tc-expr-id ctx env (ast.ast-expr-list-get exprs index 0))
        [(ResultTcType.Ok _)
          (tc-begin-list-with-expected-at ctx env exprs (+ index 1) expected)]
        [(ResultTcType.Err message) (ResultTcType.Err message)]))))

(define (tc-ctfe-value-type
  [ctx : TcContext]
  [value : ctfe_support.CompilerCtfeValue]) : ResultTcType
  (match value
    [(ctfe_support.CompilerCtfeValue.I64 _) (ResultTcType.Ok (ast.AstType.I64))]
    [(ctfe_support.CompilerCtfeValue.F64 _) (ResultTcType.Ok (ast.AstType.F64))]
    [(ctfe_support.CompilerCtfeValue.F32 _) (ResultTcType.Ok (ast.AstType.F32))]
    [(ctfe_support.CompilerCtfeValue.Bool _)
      (ResultTcType.Ok (ast.AstType.Bool))]
    [(ctfe_support.CompilerCtfeValue.Char _)
      (ResultTcType.Ok (ast.AstType.Char))]
    [(ctfe_support.CompilerCtfeValue.String _ _)
      (ResultTcType.Err "String value is compile-time only")]
    [(ctfe_support.CompilerCtfeValue.Name _ _)
      (ResultTcType.Err "String value is compile-time only")]
    [(ctfe_support.CompilerCtfeValue.Unit) (ResultTcType.Ok (ast.AstType.Unit))]
    [(ctfe_support.CompilerCtfeValue.Expr _ _)
      (ResultTcType.Ok (ast.AstType.Expr))]
    [(ctfe_support.CompilerCtfeValue.CapturedExpr _ _ _)
      (ResultTcType.Ok (ast.AstType.Expr))]
    [(ctfe_support.CompilerCtfeValue.Type ty)
      (ResultTcType.Err
        (str_cat.str-cat
          "type value "
          (tc-type-render (tc-resolve-type ctx ty))
          " is compile-time only"))]
    [(ctfe_support.CompilerCtfeValue.ExprList _)
      (ResultTcType.Ok (ast.AstType.ExprList))]
    [(ctfe_support.CompilerCtfeValue.CapturedExprList _ _)
      (ResultTcType.Ok (ast.AstType.ExprList))]
    [(ctfe_support.CompilerCtfeValue.ExprClause _)
      (ResultTcType.Ok (tc-macro-expr-clause-type))]
    [(ctfe_support.CompilerCtfeValue.CapturedExprClause _ _)
      (ResultTcType.Ok (tc-macro-expr-clause-type))]
    [(ctfe_support.CompilerCtfeValue.ExprClauseList _)
      (ResultTcType.Ok (tc-macro-expr-clause-list-type))]
    [(ctfe_support.CompilerCtfeValue.CapturedExprClauseList _ _)
      (ResultTcType.Ok (tc-macro-expr-clause-list-type))]
    [(ctfe_support.CompilerCtfeValue.ExprBindingClause _)
      (ResultTcType.Ok (tc-macro-expr-binding-clause-type))]
    [(ctfe_support.CompilerCtfeValue.ExprBindingClauseList _)
      (ResultTcType.Ok (tc-macro-expr-binding-clause-list-type))]
    [(ctfe_support.CompilerCtfeValue.Pattern _)
      (ResultTcType.Ok (tc-macro-pattern-type))]
    [(ctfe_support.CompilerCtfeValue.PatternList _)
      (ResultTcType.Ok (tc-macro-pattern-list-type))]
    [(ctfe_support.CompilerCtfeValue.MatchArm _)
      (ResultTcType.Ok (tc-macro-match-arm-type))]
    [(ctfe_support.CompilerCtfeValue.MatchArmList _)
      (ResultTcType.Ok (tc-macro-match-arm-list-type))]
    [(ctfe_support.CompilerCtfeValue.LetBinding _)
      (ResultTcType.Err "LetBinding value is compile-time only")]
    [(ctfe_support.CompilerCtfeValue.LetBindingList _)
      (ResultTcType.Err "LetBindingList value is compile-time only")]
    [(ctfe_support.CompilerCtfeValue.TypeInfo _)
      (ResultTcType.Err "TypeInfo value is compile-time only")]
    [(ctfe_support.CompilerCtfeValue.TypeInfoBox _)
      (ResultTcType.Err "TypeInfo box value is compile-time only")]
    [(ctfe_support.CompilerCtfeValue.TypeInfoList _)
      (ResultTcType.Err "TypeInfoList value is compile-time only")]
    [(ctfe_support.CompilerCtfeValue.TypeField _ _)
      (ResultTcType.Err "TypeField value is compile-time only")]
    [(ctfe_support.CompilerCtfeValue.TypeFieldList _)
      (ResultTcType.Err "TypeFieldList value is compile-time only")]
    [(ctfe_support.CompilerCtfeValue.TypeVariantPayload _)
      (ResultTcType.Err "TypeVariantPayload value is compile-time only")]
    [(ctfe_support.CompilerCtfeValue.TypeVariantPayloadList _)
      (ResultTcType.Err "TypeVariantPayloadList value is compile-time only")]
    [(ctfe_support.CompilerCtfeValue.TypeVariant _ _)
      (ResultTcType.Err "TypeVariant value is compile-time only")]
    [(ctfe_support.CompilerCtfeValue.TypeVariantList _)
      (ResultTcType.Err "TypeVariantList value is compile-time only")]))

(define (tc-ctfe-float-value? [value : ctfe_support.CompilerCtfeValue]) : bool
  (match value
    [(ctfe_support.CompilerCtfeValue.F64 _) true]
    [(ctfe_support.CompilerCtfeValue.F32 _) true]
    [_ false]))

(define (tc-ctfe-value-type-with-expected
  [ctx : TcContext]
  [value : ctfe_support.CompilerCtfeValue]
  [expected : ast.AstType]) : ResultTcType
  (match (tc-ctfe-value-type ctx value)
    [(ResultTcType.Ok actual)
      (if (and
        (tc-ctfe-float-value? value)
        (tc-type-eq (tc-type-strip-region expected) (ast.AstType.F32)))
        (ResultTcType.Ok expected)
        (if (tc-type-compatible? expected actual)
          (ResultTcType.Ok (tc-contextual-result-type expected actual))
          (ResultTcType.Ok actual)))]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (tc-expr-result-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expected : ast.AstType]
  [allow-mut-by-value-borrow : bool]
  [result : ResultTcType]) : ResultTcType
  (match result
    [(ResultTcType.Ok actual)
      (cond
        [(tc-type-coercible? ctx env expected actual)
          (ResultTcType.Ok (tc-contextual-result-type expected actual))]
        [(and
            allow-mut-by-value-borrow
            (tc-call-string-temporary-ref-compatible? ctx expected actual))
          (ResultTcType.Ok expected)]
        [else
          (match (tc-match-inferred-type-for-expected ctx env actual expected)
            [(TcInferredTypeMatch.Compatible matched)
              (ResultTcType.Ok (tc-contextual-result-type expected matched))]
            [(TcInferredTypeMatch.Mismatch _) (ResultTcType.Ok actual)])])]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (tc-macro-expansion-result-with-frame
  [inner : ast.AstExpr]
  [path-id : i64]
  [origin-path-id : i64]
  [macro-name-id : i64]
  [span : ast.AstSourceSpan]
  [result : ResultTcType]) : ResultTcType
  (match result
    [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
    [(ResultTcType.Err message)
      (let
        [located : String
          (if (tc-encoded-error? message)
            message
            (match (tc-expr-maybe-span inner)
              [(TcMaybeAstSourceSpan.Some primary)
                (tc-located-error primary message)]
              [(TcMaybeAstSourceSpan.No) (tc-located-error span message)]))]
        (ResultTcType.Err
          (tc-macro-framed-error
            path-id
            span
            origin-path-id
            macro-name-id
            (tc-unbound-finalize-located-error located))))]))

(define (tc-expr-with-expected-or-actual-core-inner
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [expected : ast.AstType]
  [allow-mut-by-value-borrow : bool]) : ResultTcType
  (match expr
    [(ast.AstExpr.Spanned inner-box span)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        (match inner
          [(ast.AstExpr.MacroExpansion expanded provenance-id macro-name-id)
            (tc-macro-expansion-result-with-frame
              (tc-context-expr-get ctx expanded)
              (macro-expansion-invocation-path-id provenance-id)
              (macro-expansion-origin-path-id provenance-id)
              macro-name-id
              span
              (tc-expr-with-expected-or-actual-core-id
                ctx
                env
                expanded
                expected
                allow-mut-by-value-borrow))]
          [_
            (let
              [result : ResultTcType
                (match inner
                  [(ast.AstExpr.Unsafe exprs)
                    (tc-unsafe-begin-list-with-expected-scoped
                      ctx
                      env
                      exprs
                      expected
                      (TcMaybeAstSourceSpan.Some span))]
                  [_
                    (tc-expr-with-expected-or-actual-core-id
                      ctx
                      env
                      inner-box
                      expected
                      allow-mut-by-value-borrow)])]
              (match result
                [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
                [(ResultTcType.Err message)
                  (tc-locate-spanned-error-with-context
                    ctx
                    env
                    inner
                    span
                    message)]))]))]
    [(ast.AstExpr.MacroExpansion inner _ _)
      (tc-expr-with-expected-or-actual-core-id
        ctx
        env
        inner
        expected
        allow-mut-by-value-borrow)]
    [(ast.AstExpr.Binary op left-box right-box)
      (let
        [left : ast.AstExpr (tc-context-expr-get ctx left-box)]
        [right : ast.AstExpr (tc-context-expr-get ctx right-box)]
        (tc-binary-expr-with-expected-or-actual
          ctx
          env
          expr
          op
          left
          right
          expected))]
    [(ast.AstExpr.Unary op inner-box)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        (tc-unary-expr-with-expected-or-actual ctx env expr op inner expected))]
    [(ast.AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : ast.AstExpr (tc-context-expr-get ctx cond-box)]
        [then-branch : ast.AstExpr (tc-context-expr-get ctx then-branch-box)]
        [else-branch : ast.AstExpr (tc-context-expr-get ctx else-branch-box)]
        (tc-expr-if-with-expected-or-actual
          ctx
          env
          cond
          then-branch
          else-branch
          expected))]
    [(ast.AstExpr.Match match-box)
      (match (__tl-box-place match-box)
        [(ast.AstMatch.Match scrutinee-box arms)
          (match (tc-expr-id ctx env scrutinee-box)
            [(ResultTcType.Ok scrut-ty)
              (tc-match-expr-with-expected ctx env scrut-ty arms expected)]
            [(ResultTcType.Err message) (ResultTcType.Err message)])])]
    [(ast.AstExpr.Array exprs)
      (match (tc-type-strip-region expected)
        [(ast.AstType.Array elem-ty len)
          (tc-expr-array-with-expected-or-actual
            ctx
            env
            exprs
            (ast.ty-node-get elem-ty)
            len)]
        [_ (tc-expr ctx env expr)])]
    [(ast.AstExpr.DynArray exprs)
      (tc-expr-dyn-array-literal-with-expected-or-actual ctx env exprs expected)]
    [(ast.AstExpr.Tuple exprs)
      (match (tc-type-strip-region expected)
        [(ast.AstType.Tuple expected-elems)
          (tc-expr-tuple-with-expected-or-actual
            ctx
            env
            exprs
            (__tl-box-place expected-elems))]
        [_ (tc-expr ctx env expr)])]
    [(ast.AstExpr.Begin exprs)
      (tc-begin-list-with-expected ctx env exprs expected)]
    [(ast.AstExpr.Unsafe exprs)
      (tc-unsafe-begin-list-with-expected-scoped
        ctx
        env
        exprs
        expected
        TcMaybeAstSourceSpan.No)]
    [(ast.AstExpr.Let let-box)
      (match (__tl-box-place let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : ast.AstExpr (tc-context-expr-get ctx body-box)]
            (match (tc-let-bindings-for-body ctx env bindings body)
              [(ResultTcEnv.Ok next-env)
                (match (tc-expr-with-expected-or-actual-id
                  ctx
                  next-env
                  body-box
                  expected)
                  [(ResultTcType.Ok body-ty)
                    (match (tc-ensure-reference-type-does-not-escape-names
                      body-ty
                      (tc-let-binding-list-add-bound-name-ids
                        bindings
                        TcNameIdList.Nil))
                      [(ResultTcUnit.Ok) (ResultTcType.Ok body-ty)]
                      [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                  [(ResultTcType.Err message) (ResultTcType.Err message)])]
              [(ResultTcEnv.Err message) (ResultTcType.Err message)]))])]
    [(ast.AstExpr.WithRegion region body)
      (tc-with-region-expr-with-expected-scoped ctx env region body expected)]
    [(ast.AstExpr.WithEscape scratch-box body)
      (let
        [scratch : ast.AstExpr (tc-context-expr-get ctx scratch-box)]
        (tc-with-escape-expr-with-expected ctx env scratch body expected))]
    [(ast.AstExpr.WithScratch body)
      (tc-with-scratch-expr-with-expected ctx env body expected)]
    [(ast.AstExpr.InArena arena-box body)
      (let
        [arena : ast.AstExpr (tc-context-expr-get ctx arena-box)]
        (tc-in-arena-expr-with-expected-scoped ctx env arena body expected))]
    [(ast.AstExpr.WithResource wr-box)
      (match (__tl-box-place wr-box)
        [(ast.AstWithResource.WithResource bindings body)
          (tc-with-resource-expr-with-expected ctx env bindings body expected)])]
    [(ast.AstExpr.Borrow mutable lifetime-id place-box)
      (match (tc-normalize-dotted-local-field-node! ctx env place-box)
        [(ResultTcUnit.Ok)
          (let
            [lifetime : ast.AstBorrowLifetime
              (ast.ast-borrow-lifetime-from-id lifetime-id)]
            [place : ast.AstExpr (tc-context-expr-get ctx place-box)]
            (if (and mutable allow-mut-by-value-borrow)
              (tc-borrow-expr-with-policy
                ctx
                (tc-context-expr-bases ctx)
                env
                mutable
                lifetime
                place
                true)
              (tc-expr ctx env expr)))]
        [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
    [(ast.AstExpr.Box inner-box)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        (tc-box-expr-with-expected-or-actual ctx env inner expected))]
    [(ast.AstExpr.BoxGet inner-box)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        (tc-box-get-expr-with-expected-or-actual ctx env inner expected))]
    [(ast.AstExpr.BoxTake inner-box)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        (tc-deref-expr-with-expected-or-actual ctx env inner expected))]
    [(ast.AstExpr.Comptime inner-box)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        (match (ctfe_support.compiler-ctfe-eval
          inner
          (tc-ctfe-env ctx)
          (ctfe_support.ctfe-fuel-limit))
          [(ctfe_support.ResultCtfe.Ok value _)
            (tc-ctfe-value-type-with-expected ctx value expected)]
          [(ctfe_support.ResultCtfe.Err diag)
            (ResultTcType.Err
              (cdiag.compiler-diagnostic-message (__tl-box-place diag)))]))]
    [(ast.AstExpr.Init maybe-ty-id)
      (match (ast.ast-maybe-type-from-id maybe-ty-id)
        [(ast.AstMaybeType.No) (tc-init-expr ctx env expected)]
        [(ast.AstMaybeType.Some ty)
          (match (tc-init-expr ctx env ty)
            [(ResultTcType.Ok actual)
              (if (tc-type-compatible? expected actual)
                (ResultTcType.Ok (tc-contextual-result-type expected actual))
                (ResultTcType.Ok actual))]
            [(ResultTcType.Err message) (ResultTcType.Err message)])])]
    [(ast.AstExpr.Box inner-box)
      (match (tc-type-strip-region (tc-resolve-type ctx expected))
        [(ast.AstType.Box inner-ty)
          (let
            [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
            [want : ast.AstType (ast.ty-node-get inner-ty)]
            (match (tc-ensure-cleanup-resource-not-stored-expr env inner)
              [(ResultTcUnit.Ok)
                (match (tc-expr-with-expected-or-actual ctx env inner want)
                  [(ResultTcType.Ok got)
                    (match (tc-expect
                      got
                      want
                      "typecheck: box inner type mismatch")
                      [(ResultTcUnit.Ok)
                        (ResultTcType.Ok
                          (tc-tag-active-region
                            env
                            (ast.ast-ty-box
                              (tc-contextual-result-type want got))))]
                      [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                  [(ResultTcType.Err message) (ResultTcType.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcType.Err message)]))]
        [_ (tc-expr ctx env expr)])]
    [_
      (if (tc-integer-literal-expr? expr)
        (tc-integer-literal-expr-with-expected ctx expr expected)
        (if (tc-float-literal-expr? expr)
          (tc-float-literal-expr-with-expected expr expected)
          (tc-expr-result-with-expected-or-actual
            ctx
            env
            expected
            allow-mut-by-value-borrow
            (tc-expr ctx env expr))))]))

(define (tc-expr-scoped-bindings? [expr : ast.AstExpr]) : bool
  (match expr
    [(ast.AstExpr.Let _) true]
    [(ast.AstExpr.While _ _) true]
    [(ast.AstExpr.ForOwnedState _) true]
    [(ast.AstExpr.ForOwnedStep _) true]
    [(ast.AstExpr.Foreach _) true]
    [(ast.AstExpr.SpmdReduce _) true]
    [(ast.AstExpr.SpmdScan _) true]
    [(ast.AstExpr.WithResource _) true]
    [_ false]))

(define (tc-expr-with-expected-or-actual-core
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [expected : ast.AstType]
  [allow-mut-by-value-borrow : bool]) : ResultTcType
  (if (and (tc-type-env-scoped-runtime-active?) (tc-expr-scoped-bindings? expr))
    (let
      [saved : TcTypeEnvScopedRuntimeSave (tc-type-env-scoped-runtime-save)]
      [result : ResultTcType
        (tc-expr-with-expected-or-actual-core-inner
          ctx
          env
          expr
          expected
          allow-mut-by-value-borrow)]
      (begin
        (tc-type-env-scoped-runtime-restore! saved)
        result))
    (tc-expr-with-expected-or-actual-core-inner
      ctx
      env
      expr
      expected
      allow-mut-by-value-borrow)))

(define (tc-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcType
  (tc-expr-with-expected-or-actual-core ctx env expr expected false))

(define (tc-expr-with-expected-or-actual-call-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcType
  (tc-expr-with-expected-or-actual-core ctx env expr expected true))

;; Safe thread spawns deliberately consume a direct lambda across the thread
;; boundary. Their dedicated capture checker validates that transfer after
;; ordinary argument typing, so admit only the top-level lambda here; nested
;; closures in its body still take the normal fail-closed path.
(define (tc-expr-with-expected-or-actual-thread-spawn-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [expected : ast.AstType]) : ResultTcType
  (match (ast.ast-expr-unspan expr)
    [(ast.AstExpr.Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(ast.AstLambda.Lambda params maybe-ret body-box)
          (tc-expr-result-with-expected-or-actual
            ctx
            env
            expected
            true
            (tc-lambda-expr-with-capture-check
              ctx
              env
              params
              maybe-ret
              (tc-context-expr-get ctx body-box)
              false))])]
    [_ (tc-expr-with-expected-or-actual-call-arg ctx env expr expected)]))

;; Id entrypoints keep the original AST node identity available to future
;; body-local type caches. The value-based forms above remain necessary for
;; synthetic expressions that were never pushed into the node pool.
(define (tc-expr-id-after-dotted-local-field-normalization
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]) : ResultTcType
  (let
    [expr : ast.AstExpr (tc-context-expr-get ctx expr-id)]
    [result : ResultTcType
      (match expr
        [(ast.AstExpr.Var name)
          (tc-var-expr-after-local-field-check
            ctx
            env
            name
            (tc-hygiene-name-text-id name))]
        [(ast.AstExpr.Set name value-box)
          (tc-set-expr-after-local-field-check ctx env name value-box)]
        [_ (tc-expr ctx env expr)])]
    (begin
      (match result
        [(ResultTcType.Ok ty)
          (let
            [body-state : TcBodyState (tc-context-body-state ctx)]
            (begin
              (tc-body-type-fact-record! body-state expr-id ty)
              (if body-state.inlay-hint-enabled
                (tc-inlay-hint-maybe-record-expr-for-state
                  body-state.inlay-hint-state
                  expr
                  ty)
                unit)))]
        [(ResultTcType.Err _) unit])
      result)))

(define (tc-expr-id [ctx : TcContext] [env : TcTypeEnv] [expr-id : i64]) : ResultTcType
  (let
    [expr : ast.AstExpr (tc-context-expr-get ctx expr-id)]
    (match expr
      [(ast.AstExpr.Var name)
        (if (< (tc-dotted-name-first-dot-id name) 0)
          (tc-expr-id-after-dotted-local-field-normalization ctx env expr-id)
          (match (tc-normalize-dotted-local-field-direct-node!
            ctx
            env
            expr-id
            expr)
            [(ResultTcUnit.Ok)
              (tc-expr-id-after-dotted-local-field-normalization
                ctx
                env
                expr-id)]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)]))]
      [(ast.AstExpr.Set name _)
        (if (< (tc-dotted-name-first-dot-id name) 0)
          (tc-expr-id-after-dotted-local-field-normalization ctx env expr-id)
          (match (tc-normalize-dotted-local-field-direct-node!
            ctx
            env
            expr-id
            expr)
            [(ResultTcUnit.Ok)
              (tc-expr-id-after-dotted-local-field-normalization
                ctx
                env
                expr-id)]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)]))]
      [_ (tc-expr-id-after-dotted-local-field-normalization ctx env expr-id)])))

(define (tc-body-type-fact-lookup-profiled
  [_site : String]
  [ctx : TcContext]
  [expr-id : i64]) : TcBodyTypeFact
  (match (tc-body-type-fact-lookup (tc-context-body-state ctx) expr-id)
    [(TcBodyTypeFact.Hit ty)
      (begin
        (cfg compile-profile (compiler-tc-body-fact-profile-hit _site))
        (TcBodyTypeFact.Hit ty))]
    [(TcBodyTypeFact.Miss)
      (begin
        (cfg compile-profile (compiler-tc-body-fact-profile-miss _site))
        (TcBodyTypeFact.Miss))]))

(define (tc-body-type-fact-expr-id
  [site : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]) : ResultTcType
  (match (tc-body-type-fact-lookup-profiled site ctx expr-id)
    [(TcBodyTypeFact.Hit ty) (ResultTcType.Ok ty)]
    [(TcBodyTypeFact.Miss)
      (cfg
        compile-profile
        (compiler-tc-reinfer-profile-expr-id site ctx env expr-id)
        (tc-expr-id ctx env expr-id))]))

(define (tc-body-type-fact-list-types-into-at
  [state : TcBodyState]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [out : (&mut out ast.AstTypeList)]) : ResultTcUnit
  (if (>= index exprs.len)
    ResultTcUnit.Ok
    (match (tc-body-type-fact-lookup
      state
      (ast.ast-expr-list-get exprs index 0))
      [(TcBodyTypeFact.Hit ty)
        (begin
          (ast.ast-type-list-push out (ast.ast-node-pool-reader-type-push ty))
          (tc-body-type-fact-list-types-into-at state exprs (+ index 1) out))]
      [(TcBodyTypeFact.Miss) (ResultTcUnit.Err "")])))

(define (tc-body-type-fact-list-types
  [state : TcBodyState]
  [exprs : ast.AstExprList]) : ResultTcTypeList
  (if (__tl-project-field (tc-body-state-data-value state) type-facts-consuming)
    (let
      [out : ast.AstTypeList (ast.ast-type-list-new)]
      (match (tc-body-type-fact-list-types-into-at state (& exprs) 0 (&mut out))
        [(ResultTcUnit.Ok) (ResultTcTypeList.Ok out)]
        [(ResultTcUnit.Err message) (ResultTcTypeList.Err message)]))
    (ResultTcTypeList.Err "")))

(define (tc-body-type-fact-expr-list-types
  [_site : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]) : ResultTcTypeList
  (match (tc-body-type-fact-list-types (tc-context-body-state ctx) exprs)
    [(ResultTcTypeList.Ok types)
      (begin
        (cfg compile-profile (compiler-tc-body-fact-profile-hit _site))
        (ResultTcTypeList.Ok types))]
    [(ResultTcTypeList.Err _)
      (begin
        (cfg compile-profile (compiler-tc-body-fact-profile-miss _site))
        (cfg
          compile-profile
          (compiler-tc-reinfer-profile-expr-list-types _site ctx env exprs)
          (tc-expr-list-types ctx env exprs)))]))

(define (tc-move-binding-type-id
  [site : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [maybe-ty : ast.AstMaybeType]
  [init-id : i64]) : ast.AstType
  (match maybe-ty
    [(ast.AstMaybeType.Some t)
      (let
        [resolved : ast.AstType (tc-resolve-type ctx t)]
        (match (tc-expr-with-expected-or-actual-id ctx env init-id resolved)
          [(ResultTcType.Ok init-ty)
            (if (tc-type-contains-any-region init-ty)
              init-ty
              resolved)]
          [(ResultTcType.Err _) resolved]))]
    [(ast.AstMaybeType.No)
      (match (tc-body-type-fact-expr-id site ctx env init-id)
        [(ResultTcType.Ok t) t]
        [(ResultTcType.Err _) (ast.AstType.I64)])]))

;; Contextual typing is deliberately separate from non-contextual `tc-expr-id`:
;; the same node can produce a different result type when an expected type
;; guides literal, array, tuple, borrow, or call-argument typing.
(define (tc-expr-with-expected-or-actual-after-dotted-local-field-normalization
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [expected : ast.AstType]
  [allow-mut-by-value-borrow : bool]) : ResultTcType
  (match expr
    [(ast.AstExpr.Var name)
      (tc-expr-result-with-expected-or-actual
        ctx
        env
        expected
        allow-mut-by-value-borrow
        (tc-var-expr-after-local-field-check
          ctx
          env
          name
          (tc-hygiene-name-text-id name)))]
    [(ast.AstExpr.Set name value-box)
      (tc-expr-result-with-expected-or-actual
        ctx
        env
        expected
        allow-mut-by-value-borrow
        (tc-set-expr-after-local-field-check ctx env name value-box))]
    [_
      (tc-expr-with-expected-or-actual-core
        ctx
        env
        expr
        expected
        allow-mut-by-value-borrow)]))

(define (tc-expr-with-expected-or-actual-core-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]
  [expected : ast.AstType]
  [allow-mut-by-value-borrow : bool]) : ResultTcType
  (let
    [expr : ast.AstExpr (tc-context-expr-get ctx expr-id)]
    (match expr
      [(ast.AstExpr.Var name)
        (if (or
          (macro-hygiene-global-id? name)
          (< (tc-dotted-name-first-dot-id name) 0))
          (tc-expr-with-expected-or-actual-after-dotted-local-field-normalization
            ctx
            env
            expr
            expected
            allow-mut-by-value-borrow)
          (match (tc-normalize-dotted-local-field-direct-node!
            ctx
            env
            expr-id
            expr)
            [(ResultTcUnit.Ok)
              (tc-expr-with-expected-or-actual-after-dotted-local-field-normalization
                ctx
                env
                (tc-context-expr-get ctx expr-id)
                expected
                allow-mut-by-value-borrow)]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)]))]
      [(ast.AstExpr.Set name _)
        (if (or
          (macro-hygiene-global-id? name)
          (< (tc-dotted-name-first-dot-id name) 0))
          (tc-expr-with-expected-or-actual-after-dotted-local-field-normalization
            ctx
            env
            expr
            expected
            allow-mut-by-value-borrow)
          (match (tc-normalize-dotted-local-field-direct-node!
            ctx
            env
            expr-id
            expr)
            [(ResultTcUnit.Ok)
              (tc-expr-with-expected-or-actual-after-dotted-local-field-normalization
                ctx
                env
                (tc-context-expr-get ctx expr-id)
                expected
                allow-mut-by-value-borrow)]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)]))]
      [_
        (tc-expr-with-expected-or-actual-core
          ctx
          env
          expr
          expected
          allow-mut-by-value-borrow)])))

(define (tc-expr-with-expected-or-actual-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]
  [expected : ast.AstType]) : ResultTcType
  (tc-expr-with-expected-or-actual-core-id ctx env expr-id expected false))

(define (tc-binop-type
  [op : ast.AstBinOp]
  [left : ast.AstType]
  [right : ast.AstType]) : ResultTcType
  (match op
    [(ast.AstBinOp.And)
      (if (and
        (tc-type-eq left (ast.AstType.Bool))
        (tc-type-eq right (ast.AstType.Bool)))
        (ResultTcType.Ok (ast.AstType.Bool))
        (ResultTcType.Err "typecheck: boolean operator expects bool operands"))]
    [(ast.AstBinOp.Or)
      (if (and
        (tc-type-eq left (ast.AstType.Bool))
        (tc-type-eq right (ast.AstType.Bool)))
        (ResultTcType.Ok (ast.AstType.Bool))
        (ResultTcType.Err "typecheck: boolean operator expects bool operands"))]
    [(ast.AstBinOp.Eq)
      (if (tc-type-eq left right)
        (ResultTcType.Ok (ast.AstType.Bool))
        (ResultTcType.Err "typecheck: equality operands must match"))]
    [(ast.AstBinOp.Ne)
      (if (tc-type-eq left right)
        (ResultTcType.Ok (ast.AstType.Bool))
        (ResultTcType.Err "typecheck: equality operands must match"))]
    [(ast.AstBinOp.Lt) (tc-compare-binop-type left right)]
    [(ast.AstBinOp.Le) (tc-compare-binop-type left right)]
    [(ast.AstBinOp.Gt) (tc-compare-binop-type left right)]
    [(ast.AstBinOp.Ge) (tc-compare-binop-type left right)]
    [(ast.AstBinOp.Add) (tc-arithmetic-binop-type left right)]
    [(ast.AstBinOp.Sub) (tc-arithmetic-binop-type left right)]
    [(ast.AstBinOp.Mul) (tc-arithmetic-binop-type left right)]
    [(ast.AstBinOp.Div) (tc-arithmetic-binop-type left right)]
    [(ast.AstBinOp.Shl) (tc-shift-binop-type left right)]
    [(ast.AstBinOp.Shr) (tc-shift-binop-type left right)]
    [_ (tc-integer-binop-type left right)]))

(define (tc-integer-binop-type [left : ast.AstType] [right : ast.AstType]) : ResultTcType
  (if (and (tc-integer-type? left) (tc-type-eq left right))
    (ResultTcType.Ok left)
    (ResultTcType.Err
      "typecheck: integer operator expects matching integer operands")))

(define (tc-arithmetic-binop-type [left : ast.AstType] [right : ast.AstType]) : ResultTcType
  (if (and (tc-float-type? left) (tc-type-eq left right))
    (ResultTcType.Ok left)
    (tc-integer-binop-type left right)))

(define (tc-shift-binop-type [left : ast.AstType] [right : ast.AstType]) : ResultTcType
  (if (tc-integer-type? left)
    (if (tc-integer-type? right)
      (ResultTcType.Ok left)
      (ResultTcType.Err "typecheck: shift count must be integer"))
    (ResultTcType.Err "typecheck: shift left operand must be integer")))

(define (tc-compare-binop-type [left : ast.AstType] [right : ast.AstType]) : ResultTcType
  (if (and (tc-ordered-comparison-type? left) (tc-type-eq left right))
    (ResultTcType.Ok (ast.AstType.Bool))
    (ResultTcType.Err
      (str_cat.str-cat
        "typecheck: comparison expects matching ordered scalar operands, got "
        (tc-type-render left)
        " and "
        (tc-type-render right)))))

(define (tc-unop-type [op : ast.AstUnOp] [ty : ast.AstType]) : ResultTcType
  (match op
    [(ast.AstUnOp.Not)
      (if (tc-type-eq ty (ast.AstType.Bool))
        (ResultTcType.Ok (ast.AstType.Bool))
        (ResultTcType.Err "typecheck: not expects bool"))]
    [(ast.AstUnOp.Neg)
      (if (or (tc-integer-type? ty) (tc-float-type? ty))
        (ResultTcType.Ok ty)
        (ResultTcType.Err "typecheck: neg expects integer"))]
    [(ast.AstUnOp.BitNot)
      (if (tc-integer-type? ty)
        (ResultTcType.Ok ty)
        (ResultTcType.Err "typecheck: bit-not expects integer"))]))

(define (tc-default-builtin-unshadowed-scan-id?
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (match (tc-type-env-view env)
    [(TcTypeEnvView.Nil) false]
    [(TcTypeEnvView.Cache cache-ptr _ partial _ below)
      (let
        [ids : tc_i64_i64_map.Map
          (tc-type-env-cache-field-at cache-ptr 32 tc_i64_i64_map.Map)]
        [shadow-flags : (__tl_dyn-array i64)
          (tc-type-env-cache-field-at cache-ptr 80 (__tl_dyn-array i64))]
        (match (tc_i64_i64_map.get (& ids) name-id)
          [(tc_i64_i64_map.LookupFound index)
            (=
              (bit-and
                (array-ref shadow-flags index)
                tc-env-cache-flag-default-shadow)
              0)]
          [(tc_i64_i64_map.LookupMissing)
            (if partial
              (tc-default-builtin-unshadowed-scan-id? below name-id)
              true)]))]
    [(TcTypeEnvView.Bind key _ rest)
      (if (= key name-id)
        false
        (if (= key (tc-default-boundary-id))
          true
          (tc-default-builtin-unshadowed-scan-id? rest name-id)))]))

(define (tc-name-local-bound-before-module-scan-id?
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (match (tc-type-env-view env)
    [(TcTypeEnvView.Nil) false]
    [(TcTypeEnvView.Cache _ scan-through _ rest _)
      (if scan-through
        (tc-name-local-bound-before-module-scan-id? rest name-id)
        false)]
    [(TcTypeEnvView.Bind key _ rest)
      (if (= key name-id)
        true
        (tc-name-local-bound-before-module-scan-id? rest name-id))]))

(define (tc-top-level-value-owned-by-module-id?
  [ctx : TcContext]
  [module-id : i64]
  [name-id : i64]) : bool
  (let
    [symbols : csym.CompilerSymbols (tc-context-symbols ctx)]
    [handle : i64
      (csym.compiler-symbols-lookup-value-in-module-id-or
        symbols
        module-id
        name-id
        (csym.compiler-symbols-missing-handle))]
    (and
      (csym.compiler-symbols-handle-found? handle)
      ;; Module-qualified alias entries can point at declarations owned by a
      ;; different module.  Those aliases must not count as a definition-site
      ;; shadow of a compiler-private intrinsic.
      (=
        (csym.compiler-symbols-owner-module-id-at-index-or
          symbols
          (csym.compiler-symbol-handle-index handle)
          -2)
        module-id))))

(define (tc-private-intrinsic-unshadowed-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (and
    (cbi.compiler-builtin-private-intrinsic-id? name-id)
    ;; Function parameters and lexical bindings always shadow, including in an
    ;; imported body.  The scoped runtime holds the hot local stack separately;
    ;; the persistent scan covers callers that materialized that stack.
    (not
      (or
        (and
          tc-type-env-scoped-runtime-active
          (>= (tc-type-env-scoped-runtime-lookup-index name-id) 0))
        (tc-name-local-bound-before-module-scan-id? env name-id)))
    ;; A top-level definition shadows only in the module that owns this body.
    ;; In an imported aggregate, the ordinary value env belongs to the caller,
    ;; while type-module-id retains the declaration's defining module.
    (not
      (let
        [module-id : i64 (tc-context-type-module-id ctx)]
        (if (csym.compiler-symbol-root-module-id? module-id)
          ;; Root-module probes used by the compiler's in-process source tests
          ;; rebuild the type env repeatedly while sharing symbol storage.  The
          ;; env is authoritative for an unqualified root definition.
          (tc-name-bound-id? env name-id)
          (tc-top-level-value-owned-by-module-id? ctx module-id name-id))))))

;; Compiler-private text inspectors expose ordinary callable signatures to
;; move/borrow analysis even though their direct calls still use intrinsic
;; result checking below. Keeping these signatures out of general expression
;; lookup preserves normal shadowing and avoids making CTFE evaluate the private
;; implementation functions while it is constructing their definitions.
(define (tc-private-string-intrinsic-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : ResultTcType
  (if (tc-private-intrinsic-unshadowed-id? ctx env name-id)
    (let
      [text : ast.AstType
        (ast.ast-ty-ref cbi.compiler-builtin-id-fix-value (ast.AstType.Str))]
      [left : ast.AstType
        (ast.ast-ty-ref cbi.compiler-builtin-id-fix-left (ast.AstType.Str))]
      [right : ast.AstType
        (ast.ast-ty-ref cbi.compiler-builtin-id-fix-right (ast.AstType.Str))]
      (cond
        [(= name-id cbi.compiler-builtin-id-tl-private-string-length)
          (ResultTcType.Ok (tc-fn1 text (ast.AstType.I64)))]
        [(= name-id cbi.compiler-builtin-id-tl-private-string-ref)
          (ResultTcType.Ok (tc-fn2 text (ast.AstType.I64) (ast.AstType.Char)))]
        [(= name-id cbi.compiler-builtin-id-tl-private-string-eq)
          (ResultTcType.Ok (tc-fn2 left right (ast.AstType.Bool)))]
        [(= name-id cbi.compiler-builtin-id-tl-private-string-to-int)
          (ResultTcType.Ok (tc-fn1 text (ast.AstType.I64)))]
        [else (ResultTcType.Err "")]))
    (ResultTcType.Err "")))

(define (tc-private-string-intrinsic-call-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]) : ResultTcType
  (match (ast.ast-expr-unspan func)
    [(ast.AstExpr.Var raw-name)
      (let
        [raw-text : String (tc-hygiene-name-text-id raw-name)]
        [hygiene-global : bool (tc-hygiene-global-name-id? raw-name)]
        [name : String
          (if (and hygiene-global (not (macro-hygiene-global-id? raw-name)))
            (tc-hygiene-global-call-name raw-text)
            raw-text)]
        [name-id : i64 (tc-builtin-call-name-id raw-name hygiene-global)]
        [lookup-id : i64 (tc-call-builtin-lookup-id ctx env name name-id)]
        (tc-private-string-intrinsic-type ctx env lookup-id))]
    [_ (ResultTcType.Err "")]))

;; Source-level builtin dispatch historically observed module-local declaration
;; copies through `tc-name-bound-id?`. Dotted modules keep the authoritative
;; declaration under its qualified top-env key instead, so consult symbol
;; ownership when the exact environment lookup misses. Lexical and imported
;; bindings remain the first, cheap test.
(define (tc-source-value-bound-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (or
    (tc-name-bound-id? env name-id)
    (let
      [module-id : i64 (tc-context-type-module-id ctx)]
      (and
        (not (csym.compiler-symbol-root-module-id? module-id))
        (tc-top-level-value-owned-by-module-id? ctx module-id name-id)))))

(define (tc-default-builtin-unshadowed-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (if (cbi.compiler-builtin-typecheck-region-arg-id? name-id)
    (if tc-type-env-scoped-runtime-active
      (let
        [name-index : i64 (tc-type-env-scoped-runtime-lookup-index name-id)]
        [boundary-index : i64
          (tc-type-env-scoped-runtime-lookup-index (tc-default-boundary-id))]
        [scoped : bool
          (cond
            [(>= name-index 0)
              (and (>= boundary-index 0) (> boundary-index name-index))]
            [(>= boundary-index 0) true]
            [else
              (begin
                (cfg
                  compile-profile
                  (compiler-tc-env-profile-note-scoped-tail-fallback))
                (tc-default-builtin-unshadowed-scan-id?
                  (__tl-project-field
                    (__tl-project-field
                      tc-type-env-scoped-runtime-carrier
                      sidecar)
                    persistent)
                  name-id))])]
        (begin
          (cfg
            tc-env-scoped-dual-verify
            (if (= scoped (tc-default-builtin-unshadowed-scan-id? env name-id))
              unit
              (io.panic
                "typecheck: scoped default-shadow lookup diverged from persistent env")))
          scoped))
      (tc-default-builtin-unshadowed-scan-id? env name-id))
    false))

;; The type-handle flat lookup keys by the real intern id (so it misses non-root
;; names as intended -- the add path binds those under a
;; pair-key only the in-module probes reach). The variant registry keys by
;; name-id-key(intern "module/name") = composite-pair-key-id module-id name-id
;; for a non-root bare name; we compute that pair-key directly from the ids
;; instead of building and interning the qualified string.
(define (tc-constructor-non-root-bare-name-id?
  [module : String]
  [name-id : i64]) : bool
  (and
    (> (string.string-length module) 0)
    (not (tc-name-qualified-id? name-id))
    ;; Dotted enum variants use the qualified-variant cache domain below.
    ;; Treating one as a bare module-local name probes the wrong registry key
    ;; and can overwrite that same cache entry with a false miss.
    (< (tc-name-first-dot-id name-id) 0)))

(define (tc-constructor-name-id? [ctx : TcContext] [name-id : i64]) : bool
  (match ctx
    [(TcContext _ symbols registries module ctx-module-id _ _ _ _)
      (let
        [module-id : i64
          (if (> (string.string-length module) 0)
            ctx-module-id
            -1)]
        [non-root-bare? : bool
          (tc-constructor-non-root-bare-name-id? module name-id)]
        [variant-key : i64
          (if non-root-bare?
            (csym.compiler-composite-pair-key-id module-id name-id)
            name-id)]
        [handle : i64
          (csym.compiler-symbols-lookup-type-id-or
            symbols
            name-id
            (csym.compiler-symbols-missing-handle))]
        [variant-found : bool
          (if (and
            (not non-root-bare?)
            (tc-enum-qualified-variant-lookup-name-id? name-id))
            (match (tc-enum-qualified-variant-lookup-handle ctx name-id)
              [(option_i64.Some _) true]
              [(option_i64.None) false])
            (let
              [registry-id : i64 (csym.compiler-registries-identity registries)]
              [cached : i64
                (tc-context-source-qualified-variant-key-cache-get
                  ctx
                  registry-id
                  ctx-module-id
                  name-id)]
              (if (= cached -2)
                (match (csym.compiler-registries-lookup-variant-key-id
                  registries
                  (csym.compiler-symbol-name-id-key variant-key))
                  [(option_i64.Some variant-handle)
                    (begin
                      (tc-context-source-qualified-variant-key-cache-put!
                        ctx
                        registry-id
                        ctx-module-id
                        name-id
                        variant-key
                        variant-handle)
                      true)]
                  [(option_i64.None)
                    (begin
                      (tc-context-source-qualified-variant-key-cache-put!
                        ctx
                        registry-id
                        ctx-module-id
                        name-id
                        -1
                        -1)
                      false)])
                (>= cached 0))))]
        (if (csym.compiler-symbols-handle-found? handle)
          (if (=
            (csym.compiler-symbol-handle-kind handle)
            (csym.compiler-symbol-kind-defstruct))
            true
            variant-found)
          variant-found))]))

(define (tc-call-allows-region-args-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (if (tc-default-builtin-unshadowed-id? env name-id)
    true
    (match (tc-active-region env)
      [(TcMaybeNameId.Some _) (tc-constructor-name-id? ctx name-id)]
      [(TcMaybeNameId.No) false])))

;; id-returning variant: AstExpr.Var already carries the interned i64 name id,
;; so callers that only need the id avoid the id->String (intern-str) round trip.
(define (tc-expr-var-name-id [expr : ast.AstExpr]) : i64
  (match (ast.ast-expr-unspan expr)
    [(ast.AstExpr.Var name) name]
    [_ -1]))

(define (tc-call-arity-message-prefix) : String
  "typecheck: call arity mismatch: ")

(define (tc-call-arity-message? [message : String]) : bool
  (tc-diag-string-prefix? message (tc-call-arity-message-prefix)))

(define (tc-call-expr? [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan expr)
    [(ast.AstExpr.Call _ _) true]
    [_ false]))

(define (tc-locate-call-arity-error
  [inner : ast.AstExpr]
  [span : ast.AstSourceSpan]
  [message : String]) : ResultTcType
  (if (and
    (tc-call-expr? inner)
    (tc-call-arity-message? message)
    (not (tc-encoded-error? message)))
    (ResultTcType.Err (tc-located-error span message))
    (ResultTcType.Err message)))

(define (tc-locate-spanned-error
  [inner : ast.AstExpr]
  [span : ast.AstSourceSpan]
  [message : String]) : ResultTcType
  (if (tc-borrow-place-error-message? message)
    (ResultTcType.Err (tc-rich-borrow-place-error span message))
    (match (tc-spanned-escape-error inner span message)
      [(TcMaybeString.Some rich) (ResultTcType.Err rich)]
      [(TcMaybeString.No) (tc-locate-call-arity-error inner span message)])))

(define (tc-unbound-name-message-prefix) : String
  "typecheck: unbound name ")

(define (tc-unbound-name-message? [message : String]) : bool
  (tc-diag-string-prefix? message (tc-unbound-name-message-prefix)))

(define (tc-unbound-suggestion-scope-module-id
  [ctx : TcContext]
  [name-id : i64]) : i64
  (if (< (tc-name-first-dot-id name-id) 0)
    (tc-context-module-id ctx)
    (let
      [alias-id : i64 (ci.intern-leading-dot-id name-id)]
      (match (tc-context-program ctx)
        [(ast.AstProgram.Program decls-box)
          (match (tc-source-dotted-alias-target-id-in-context
            ctx
            (__tl-box-place decls-box)
            (tc-context-module-id ctx)
            alias-id)
            [(TcMaybeNameId.Some target-id) target-id]
            [(TcMaybeNameId.No) -1])]))))

;; These are compiler-recognized unqualified public names whose definitions
;; live in stdlib modules. Keep this catalog beside the typecheck suggestion
;; policy so a missing import can be diagnosed without loading or parsing
;; unrelated stdlib modules on an error path.
(define (tc-unbound-stdlib-provider [name : String]) : String
  (cond
    [(or
        (string.eq name "print-error")
        (string.eq name "print-format")
        (string.eq name "println")
        (string.eq name "panic")
        (string.eq name "error")
        (string.eq name "flush-stdout"))
      "stdlib.io"]
    [(or
        (string.eq name "string-length")
        (string.eq name "string-ref")
        (string.eq name "char-at")
        (string.eq name "string-eq")
        (string.eq name "string=?")
        (string.eq name "string-append")
        (string.eq name "string-concat"))
      "stdlib.string"]
    [else ""]))

(define (tc-unbound-import-help [name : String] [module : String]) : String
  (str_cat.str-cat
    name
    " is provided by "
    module
    " — add (import "
    module
    ")"))

;; Removed public spellings can still receive migration help without becoming
;; compatibility aliases or pretending that an import makes them available.
(define (tc-unbound-migration-help [name : String]) : String
  (if (string.eq name "string->int")
    "string->int was removed — add (import stdlib.string) and use string.>int"
    ""))

(define (tc-unbound-suggestion-max-distance [name-len : i64]) : i64
  (cond [(<= name-len 4) 1] [(<= name-len 12) 2] [else 3]))

(define (tc-unbound-suggestion-candidate-name? [name : String]) : bool
  (let
    [n : i64 (string.string-length name)]
    [i : i64 0]
    [ok : bool (> n 0)]
    (begin
      ;; Compiler-private names are implementation details, not useful fixes.
      (if (and
        (> n 1)
        (string.char-eq (string.string-ref name 0) '_')
        (string.char-eq (string.string-ref name 1) '_'))
        (set! ok false)
        unit)
      (while (and ok (< i n))
        (let
          [ch : char (string.string-ref name i)]
          (if (or
            (string.char-eq ch '.')
            (string.char-eq ch '/')
            (string.char-eq ch '\\'))
            (set! ok false)
            (set! i (+ i 1)))))
      ok)))

(define (tc-unbound-string-less? [left : String] [right : String]) : bool
  (let
    [left-len : i64 (string.string-length left)]
    [right-len : i64 (string.string-length right)]
    [limit : i64
      (if (< left-len right-len)
        left-len
        right-len)]
    [i : i64 0]
    (begin
      (while (< i limit)
        (let
          [left-byte : i64 (cast (string.string-ref left i) : i64)]
          [right-byte : i64 (cast (string.string-ref right i) : i64)]
          (cond
            [(< left-byte right-byte) (return true)]
            [(> left-byte right-byte) (return false)]
            [else (set! i (+ i 1))])))
      (< left-len right-len))))

;; Reuse two rows for every candidate. Suggestions run only after lookup has
;; failed, and this keeps the rare error path bounded to O(length(name)) storage.
(define (tc-unbound-edit-distance
  [wanted : String]
  [candidate : String]
  [first-row : (__tl_dyn-array i64)]
  [second-row : (__tl_dyn-array i64)]) : i64
  (let
    [wanted-len : i64 (string.string-length wanted)]
    [candidate-len : i64 (string.string-length candidate)]
    [j : i64 0]
    [i : i64 1]
    (begin
      (while (<= j wanted-len)
        (begin
          (set! (array-ref first-row j) j)
          (set! j (+ j 1))))
      (while (<= i candidate-len)
        (begin
          (set! (array-ref second-row 0) i)
          (set! j 1)
          (while (<= j wanted-len)
            (let
              [deletion : i64 (+ (array-ref first-row j) 1)]
              [insertion : i64 (+ (array-ref second-row (- j 1)) 1)]
              [substitution : i64
                (+
                  (array-ref first-row (- j 1))
                  (if (string.char-eq
                    (string.string-ref candidate (- i 1))
                    (string.string-ref wanted (- j 1)))
                    0
                    1))]
              [best : i64
                (if (< deletion insertion)
                  deletion
                  insertion)]
              (begin
                (if (< substitution best)
                  (set! best substitution)
                  unit)
                (set! (array-ref second-row j) best)
                (set! j (+ j 1)))))
          (set! j 0)
          (while (<= j wanted-len)
            (begin
              (set! (array-ref first-row j) (array-ref second-row j))
              (set! j (+ j 1))))
          (set! i (+ i 1))))
      (array-ref first-row wanted-len))))

(define (tc-unbound-candidate-visible-id?
  [module-qualified : bool]
  [module-id : i64]
  [wanted-qualifier-id : i64]
  [env : TcTypeEnv]
  [candidate-id : i64]) : bool
  (if (>= wanted-qualifier-id 0)
    (tc-name-bound-id?
      env
      (tc-module-name-id-by-id wanted-qualifier-id candidate-id))
    (or
      (tc-name-bound-id? env candidate-id)
      (and
        module-qualified
        (tc-name-bound-id? env (tc-module-name-id-by-id module-id candidate-id))))))

(define (tc-unbound-better-candidate?
  [distance : i64]
  [best-distance : i64]
  [candidate : String]
  [best : String]) : bool
  (or
    (< distance best-distance)
    (and
      (= distance best-distance)
      (or (string.eq best "") (tc-unbound-string-less? candidate best)))))

(define (tc-unbound-near-miss
  [module-qualified : bool]
  [module-id : i64]
  [env : TcTypeEnv]
  [wanted : String]
  [wanted-id : i64]) : String
  (let
    [wanted-separator : i64 (tc-name-first-char wanted '.')]
    [wanted-qualified : bool (>= wanted-separator 0)]
    [wanted-qualifier : String
      (if wanted-qualified
        (string.substring wanted 0 wanted-separator)
        "")]
    [wanted-qualifier-id : i64
      (if wanted-qualified
        (if (>= module-id 0)
          module-id
          (ci.intern wanted-qualifier))
        -1)]
    [wanted-text : String
      (if wanted-qualified
        (string.substring
          wanted
          (+ wanted-separator 1)
          (- (string.string-length wanted) (+ wanted-separator 1)))
        wanted)]
    [wanted-len : i64 (string.string-length wanted-text)]
    [max-distance : i64 (tc-unbound-suggestion-max-distance wanted-len)]
    [first-row : (__tl_dyn-array i64) (array.make-array i64 (+ wanted-len 1))]
    [second-row : (__tl_dyn-array i64) (array.make-array i64 (+ wanted-len 1))]
    [candidate-id : i64 0]
    [candidate-limit : i64 (ci.intern-pool-len)]
    [best-distance : i64 (+ max-distance 1)]
    [best : String ""]
    (begin
      (while (< candidate-id candidate-limit)
        (if (= candidate-id wanted-id)
          (set! candidate-id (+ candidate-id 1))
          (let
            [candidate : String (ci.intern-str candidate-id)]
            [candidate-len : i64 (string.string-length candidate)]
            (begin
              (if (and
                (or
                  (not wanted-qualified)
                  (not (ci.intern-qualified? candidate-id)))
                (<=
                  (if (> candidate-len wanted-len)
                    (- candidate-len wanted-len)
                    (- wanted-len candidate-len))
                  max-distance)
                (tc-unbound-suggestion-candidate-name? candidate)
                (tc-unbound-candidate-visible-id?
                  module-qualified
                  module-id
                  wanted-qualifier-id
                  env
                  candidate-id))
                (let
                  [distance : i64
                    (tc-unbound-edit-distance
                      wanted-text
                      candidate
                      first-row
                      second-row)]
                  [better : bool
                    (and
                      (<= distance max-distance)
                      (tc-unbound-better-candidate?
                        distance
                        best-distance
                        candidate
                        best))]
                  (if better
                    (begin
                      (set! best-distance distance)
                      (set!
                        best
                        (if wanted-qualified
                          (tc-name-slashes-to-dots
                            (csym.compiler-symbol-module-key
                              wanted-qualifier
                              candidate))
                          (clone candidate))))
                    unit))
                unit)
              (set! candidate-id (+ candidate-id 1))))))
      best)))

(defenum TcUnboundSuggestion
  (No)
  (Help String)
  (Replace String String))

(define (tc-unbound-suggestion
  [module-qualified : bool]
  [module-id : i64]
  [env : TcTypeEnv]
  [name : String]
  [name-id : i64]) : TcUnboundSuggestion
  (let
    [migration : String (tc-unbound-migration-help name)]
    (if (> (string.string-length migration) 0)
      (TcUnboundSuggestion.Help migration)
      (let
        [provider : String (tc-unbound-stdlib-provider name)]
        (if (> (string.string-length provider) 0)
          (TcUnboundSuggestion.Help (tc-unbound-import-help name provider))
          (let
            [near-miss : String
              (tc-unbound-near-miss module-qualified module-id env name name-id)]
            (if (> (string.string-length near-miss) 0)
              (TcUnboundSuggestion.Replace
                (str_cat.str-cat "did you mean " near-miss "?")
                near-miss)
              (TcUnboundSuggestion.No))))))))

(define (tc-unbound-finalize-located-error [message : String]) : String
  (if (and (tc-located-error? message) (not (tc-rich-error? message)))
    (let
      [prefix-len : i64 (string.string-length (tc-located-error-prefix))]
      [line-end : i64 (tc-located-error-field-end message prefix-len)]
      [col-start : i64 (+ line-end 1)]
      [col-end : i64 (tc-located-error-field-end message col-start)]
      [end-line-start : i64 (+ col-end 1)]
      [end-line-end : i64 (tc-located-error-field-end message end-line-start)]
      [end-col-start : i64 (+ end-line-end 1)]
      [end-col-end : i64 (tc-located-error-field-end message end-col-start)]
      [clean-start : i64 (+ end-col-end 1)]
      [clean-message : String
        (string.substring
          message
          clean-start
          (- (string.string-length message) clean-start))]
      (if (tc-unbound-name-message? clean-message)
        (match tc-unbound-suggestion-snapshot
          [(TcUnboundSuggestionSnapshot.Some
              module-qualified
              module-id
              env
              name-id)
            (let
              [name : String
                (tc-name-slashes-to-dots (tc-hygiene-name-text-id name-id))]
              [clean-name : String
                (string.substring
                  clean-message
                  (string.string-length (tc-unbound-name-message-prefix))
                  (-
                    (string.string-length clean-message)
                    (string.string-length (tc-unbound-name-message-prefix))))]
              [display-message : String
                (str_cat.str-cat (tc-unbound-name-message-prefix) name)]
              (if (string.eq (tc-name-slashes-to-dots clean-name) name)
                (let
                  [span : ast.AstSourceSpan
                    (ast.ast-source-span
                      (string.>int
                        (tc-located-error-field message prefix-len line-end))
                      (string.>int
                        (tc-located-error-field message col-start col-end))
                      (string.>int
                        (tc-located-error-field
                          message
                          end-line-start
                          end-line-end))
                      (string.>int
                        (tc-located-error-field
                          message
                          end-col-start
                          end-col-end)))]
                  (match (tc-unbound-suggestion
                    module-qualified
                    module-id
                    env
                    name
                    name-id)
                    [(TcUnboundSuggestion.Help help)
                      (tc-rich-error-with-help span display-message help)]
                    [(TcUnboundSuggestion.Replace help replacement)
                      (tc-rich-error-with-machine-fix
                        span
                        (ast.ast-source-span
                          (ast.ast-source-span-start-line span)
                          (ast.ast-source-span-start-col span)
                          (ast.ast-source-span-start-line span)
                          (+
                            (ast.ast-source-span-start-col span)
                            (string.string-length name)))
                        display-message
                        help
                        replacement)]
                    [(TcUnboundSuggestion.No)
                      (tc-located-error span display-message)]))
                message))]
          [(TcUnboundSuggestionSnapshot.No) message])
        message))
    message))

(define (tc-locate-integer-binop-error
  [ctx : TcContext]
  [env : TcTypeEnv]
  [left-id : i64]
  [right-id : i64]
  [fallback : ast.AstSourceSpan]
  [message : String]) : ResultTcType
  (let
    [saved : TcTypeEnvScopedRuntimeSave (tc-type-env-scoped-runtime-save)]
    [left : ast.AstExpr (tc-context-expr-get ctx left-id)]
    [right : ast.AstExpr (tc-context-expr-get ctx right-id)]
    [result : ResultTcType
      (match (tc-expr ctx env left)
        [(ResultTcType.Ok left-ty)
          (match (tc-expr ctx env right)
            [(ResultTcType.Ok right-ty)
              (if (and
                (or (tc-integer-type? left-ty) (tc-float-type? left-ty))
                (not (tc-type-eq left-ty right-ty)))
                (ResultTcType.Err
                  (tc-located-error
                    (match right
                      [(ast.AstExpr.Spanned _ right-span) right-span]
                      [_ fallback])
                    (tc-type-mismatch-message right-ty left-ty message)))
                (ResultTcType.Err (tc-located-error fallback message)))]
            [(ResultTcType.Err _)
              (ResultTcType.Err (tc-located-error fallback message))])]
        [(ResultTcType.Err _)
          (ResultTcType.Err (tc-located-error fallback message))])]
    (begin
      (tc-type-env-scoped-runtime-restore! saved)
      result)))

(define (tc-locate-spanned-error-with-context
  [ctx : TcContext]
  [env : TcTypeEnv]
  [inner : ast.AstExpr]
  [span : ast.AstSourceSpan]
  [message : String]) : ResultTcType
  (cond
    [(and (tc-unbound-name-message? message) (not (tc-encoded-error? message)))
      (match inner
        [(ast.AstExpr.Var name-id)
          (begin
            (tc-unbound-suggestion-snapshot-record! ctx env name-id)
            (ResultTcType.Err (tc-located-error span message)))]
        [_ (tc-locate-spanned-error inner span message)])]
    [(and
        (string.eq
          message
          "typecheck: integer operator expects matching integer operands")
        (not (tc-encoded-error? message)))
      (match inner
        [(ast.AstExpr.Binary _ left-id right-id)
          (tc-locate-integer-binop-error ctx env left-id right-id span message)]
        [_ (tc-locate-spanned-error inner span message)])]
    [(and
        (tc-diag-string-prefix? message "typecheck: unknown struct field ")
        (not (tc-encoded-error? message)))
      (match inner
        [(ast.AstExpr.Set _ _)
          (ResultTcType.Err (tc-located-error span message))]
        [(ast.AstExpr.StructSet _ _ _)
          (ResultTcType.Err (tc-located-error span message))]
        [(ast.AstExpr.StructGet _ _)
          (ResultTcType.Err (tc-located-error span message))]
        [_ (tc-locate-spanned-error inner span message)])]
    [else
      (match inner
        [(ast.AstExpr.Set _ _) (ResultTcType.Err message)]
        [(ast.AstExpr.Spanned nested-box _)
          (tc-locate-spanned-error
            (tc-context-expr-get ctx nested-box)
            span
            message)]
        [_ (tc-locate-spanned-error inner span message)])]))

(define (tc-call-arity-callee-name [func : ast.AstExpr]) : String
  (let
    [nid : i64 (tc-expr-var-name-id func)]
    (if (>= nid 0)
      (tc-hygiene-name-text-id nid)
      (match (ast.ast-expr-unspan func)
        [(ast.AstExpr.Lambda _) "lambda"]
        [_ "call target"]))))

(define (tc-call-arity-argument-word [count : i64]) : String
  (if (= count 1)
    " argument"
    " arguments"))

(define (tc-call-arity-count-message
  [func : ast.AstExpr]
  [expected : i64]
  [actual : i64]) : String
  (str_cat.str-cat
    (tc-call-arity-message-prefix)
    (tc-call-arity-callee-name func)
    " expected "
    (string.int->string expected)
    (tc-call-arity-argument-word expected)
    ", got "
    (string.int->string actual)
    (tc-call-arity-argument-word actual)))

(define (tc-call-arity-message
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]) : String
  (tc-call-arity-count-message
    func
    (tc-type-list-len params)
    (tc-expr-list-len args)))

(define (tc-call-fixed-arity-message
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [expected : i64]) : String
  (tc-call-arity-count-message func expected (tc-expr-list-len args)))

(define (tc-call-arity-invariant-message [phase : String]) : String
  (str_cat.str-cat "typecheck: internal " phase " call arity invariant failed"))

(define (tc-call-direct-value-handle [ctx : TcContext] [func : ast.AstExpr]) : i64
  (let
    [name-id : i64 (tc-expr-var-name-id func)]
    (if (< name-id 0)
      (csym.compiler-symbols-missing-handle)
      (let
        [lookup-id : i64 (tc-env-name-key-id name-id)]
        (if (or
          (macro-hygiene-global-id? name-id)
          (tc-name-qualified-id? name-id))
          (csym.compiler-symbols-lookup-value-id-or
            (tc-context-symbols ctx)
            lookup-id
            (csym.compiler-symbols-missing-handle))
          (csym.compiler-symbols-lookup-value-in-module-id-or
            (tc-context-symbols ctx)
            (tc-context-module-id ctx)
            lookup-id
            (csym.compiler-symbols-missing-handle)))))))

(define (tc-call-param-list-name-at
  [params : (& params ast.AstParamList)]
  [index : i64]) : TcMaybeNameId
  (if (or (< index 0) (>= index (ast.ast-param-list-len params)))
    TcMaybeNameId.No
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(ast.AstParam.Param name _ _ _) (TcMaybeNameId.Some name)])))

(define (tc-call-field-list-name-at
  [fields : (& fields ast.AstFieldDefList)]
  [index : i64]) : TcMaybeNameId
  (if (or (< index 0) (>= index (ast.ast-field-def-list-len fields)))
    TcMaybeNameId.No
    (match (ast.ast-field-def-list-get
      fields
      index
      (ast.ast-field-def-fallback))
      [(ast.AstFieldDef.Def name _ _) (TcMaybeNameId.Some name)])))

(define (tc-call-decl-param-name-at [decl : ast.AstDecl] [index : i64]) : TcMaybeNameId
  (match decl
    [(ast.AstDecl.DefFn decl-meta _ params _ _ _)
      (tc-call-param-list-name-at (& params) index)]
    [(ast.AstDecl.DefStruct decl-meta _ _ _ fields)
      (tc-call-field-list-name-at (& fields) index)]
    [(ast.AstDecl.DefStructLifetimes decl-meta _ _ _ _ fields)
      (tc-call-field-list-name-at (& fields) index)]
    [(ast.AstDecl.Unsafe inner-box)
      (tc-call-decl-param-name-at (__tl-box-place inner-box) index)]
    [_ TcMaybeNameId.No]))

(define (tc-call-parameter-name-at
  [ctx : TcContext]
  [func : ast.AstExpr]
  [index : i64]) : TcMaybeNameId
  (match (ast.ast-expr-unspan func)
    [(ast.AstExpr.Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(ast.AstLambda.Lambda params _ _)
          (tc-call-param-list-name-at (& params) index)])]
    [_
      (let
        [handle : i64 (tc-call-direct-value-handle ctx func)]
        (if (csym.compiler-symbols-handle-found? handle)
          (match (csym.compiler-symbols-decl-at-index
            (tc-context-symbols ctx)
            (csym.compiler-symbol-handle-index handle))
            [(parser.ResultAstDecl.Ok decl)
              (tc-call-decl-param-name-at decl index)]
            [(parser.ResultAstDecl.Err _) TcMaybeNameId.No])
          TcMaybeNameId.No))]))

(define (tc-call-argument-message-prefix
  [ctx : TcContext]
  [func : ast.AstExpr]
  [index : i64]) : String
  (str_cat.str-cat
    "typecheck: call `"
    (tc-call-arity-callee-name func)
    "` argument "
    (string.int->string (+ index 1))
    (match (tc-call-parameter-name-at ctx func index)
      [(TcMaybeNameId.Some name-id)
        (str_cat.str-cat " (parameter `" (tc-hygiene-name-text-id name-id) "`)")]
      [(TcMaybeNameId.No) ""])
    " type mismatch"))

(define (tc-call-argument-expected-text-message
  [ctx : TcContext]
  [func : ast.AstExpr]
  [index : i64]
  [actual : ast.AstType]
  [expected : String]) : String
  (str_cat.str-cat
    (tc-call-argument-message-prefix ctx func index)
    ": expected "
    expected
    ", found "
    (tc-type-render (tc-type-without-regions actual))))

;; Deferred arity-mismatch message. tc-call-arity-message is real work (two
;; list-length walks, callee-name unspan/intern, two string.int->string division loops,
;; seven string-appends) but it is only ever consumed on the arity-mismatch error
;; path, which never fires while typechecking well-formed code (the self-compile).
;; Carrying the ingredients in this enum and materializing the text only at the
;; error arms keeps the success path -- the overwhelmingly common one -- free of
;; that build, with byte-identical output for accepted programs and identical
;; diagnostics for rejected ones.
(defenum TcArityMessage
  (Detailed ast.AstExpr ast.AstExprList ast.AstTypeList))

(define (tc-arity-message-text [arity-msg : TcArityMessage]) : String
  (match arity-msg
    [(TcArityMessage.Detailed func args params)
      (tc-call-arity-message func args params)]))

(define (tc-argument-message-prefix-text
  [ctx : TcContext]
  [arity-msg : TcArityMessage]
  [index : i64]) : String
  (match arity-msg
    [(TcArityMessage.Detailed func _ _)
      (tc-call-argument-message-prefix ctx func index)]))

(define (tc-nullary-variant-call-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [enum-name-id : i64]
  [ret : ast.AstType]) : ResultTcType
  (let
    [nid : i64 (tc-expr-var-name-id func)]
    (if (>= nid 0)
      (let
        [handle : i64
          (tc-source-variant-handle-for-enum-id-or
            ctx
            enum-name-id
            nid
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? handle)
          (if (tc-nominal-name-id-eq?
            (tc-variant-owner-id-or ctx handle -1)
            enum-name-id)
            (match (csym.compiler-registries-variant-fields-indexed
              (tc-context-symbols ctx)
              handle)
              [(parser.ResultAstTypeList.Ok fields)
                (if (ast.ast-type-list-empty? (& fields))
                  (ResultTcType.Ok (tc-tag-active-region env ret))
                  (ResultTcType.Err
                    (tc-call-arity-count-message
                      func
                      (ast.ast-type-list-len (& fields))
                      0)))]
              [(parser.ResultAstTypeList.Err message)
                (ResultTcType.Err message)])
            (ResultTcType.Err "typecheck: call target is not a function"))
          (if (tc-name-qualified-id? enum-name-id)
            (ResultTcType.Ok (tc-tag-active-region env ret))
            (ResultTcType.Err "typecheck: call target is not a function"))))
      (ResultTcType.Err "typecheck: call target is not a function"))))

(define (tc-call-region-args-allowed-for-func
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]) : bool
  (let
    [name-id : i64 (tc-expr-var-name-id func)]
    (if (>= name-id 0)
      (tc-call-allows-region-args-id? ctx env name-id)
      false)))

(define (tc-call-constructor-target-for-func
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [params : ast.AstTypeList]
  [ret : ast.AstType]) : ast.AstMaybeType
  (let
    [name-id : i64 (tc-expr-var-name-id func)]
    (if (>= name-id 0)
      (if (tc-constructor-name-id? ctx name-id)
        (ast.AstMaybeType.Some (tc-constructor-target-type env params ret))
        (ast.AstMaybeType.No))
      (ast.AstMaybeType.No))))

(define (tc-lifetime-constructor-ret? [ret : ast.AstType]) : bool
  (match ret
    [(ast.AstType.StructArgs _ lifetimes)
      (> (tc-lifetime-list-count (__tl-box-place lifetimes)) 0)]
    [(ast.AstType.EnumArgs _ lifetimes)
      (> (tc-lifetime-list-count (__tl-box-place lifetimes)) 0)]
    [_ false]))

(define (tc-call-lifetime-constructor-for-func?
  [ctx : TcContext]
  [func : ast.AstExpr]
  [ret : ast.AstType]) : bool
  (if (tc-lifetime-constructor-ret? ret)
    (let
      [name-id : i64 (tc-expr-var-name-id func)]
      (if (>= name-id 0)
        (tc-constructor-name-id? ctx name-id)
        false))
    false))

(define (tc-lifetime-subst-type-list
  [subst : TcLifetimeSubst]
  [types : ast.AstTypeList]) : ast.AstTypeList
  (let
    [out : ast.AstTypeList
      (ast.ast-type-list-with-capacity (ast.ast-type-list-len (& types)))]
    (begin
      (tc-lifetime-subst-type-list-into subst (& types) (&mut out) 0)
      out)))

(define (tc-lifetime-subst-type-list-into
  [subst : TcLifetimeSubst]
  [types : (& types ast.AstTypeList)]
  [out : (&mut out ast.AstTypeList)]
  [index : i64]) : unit
  (if (>= index (ast.ast-type-list-len types))
    unit
    (begin
      (ast.ast-type-list-push
        out
        (ast.ast-node-pool-reader-type-push
          (tc-lifetime-subst-type
            subst
            (ast.ty-node-get
              (ast.ast-type-list-get types index (ast.ast-type-id-fallback))))))
      (tc-lifetime-subst-type-list-into subst types out (+ index 1)))))

(define (tc-lifetime-subst-type [subst : TcLifetimeSubst] [ty : ast.AstType]) : ast.AstType
  (match ty
    [(ast.AstType.Func args ret)
      (ast.ast-ty-func
        (tc-lifetime-subst-type-list subst (__tl-box-place args))
        (tc-lifetime-subst-type subst (ast.ty-node-get ret)))]
    [(ast.AstType.Tuple elems)
      (ast.ast-ty-tuple
        (tc-lifetime-subst-type-list subst (__tl-box-place elems)))]
    [(ast.AstType.Array elem len)
      (ast.ast-ty-array
        (tc-lifetime-subst-type subst (ast.ty-node-get elem))
        len)]
    [(ast.AstType.DynArray elem)
      (ast.ast-ty-dyn-array
        (tc-lifetime-subst-type subst (ast.ty-node-get elem)))]
    [(ast.AstType.Slice elem)
      (ast.ast-ty-slice (tc-lifetime-subst-type subst (ast.ty-node-get elem)))]
    [(ast.AstType.Box elem)
      (ast.ast-ty-box (tc-lifetime-subst-type subst (ast.ty-node-get elem)))]
    [(ast.AstType.Ptr elem)
      (ast.ast-ty-ptr (tc-lifetime-subst-type subst (ast.ty-node-get elem)))]
    [(ast.AstType.MutPtr elem)
      (ast.ast-ty-mut-ptr (tc-lifetime-subst-type subst (ast.ty-node-get elem)))]
    [(ast.AstType.Ref lifetime inner)
      (ast.ast-ty-ref
        (tc-lifetime-subst-apply subst lifetime)
        (tc-lifetime-subst-type subst (ast.ty-node-get inner)))]
    [(ast.AstType.MutRef lifetime inner)
      (ast.ast-ty-mut-ref
        (tc-lifetime-subst-apply subst lifetime)
        (tc-lifetime-subst-type subst (ast.ty-node-get inner)))]
    [(ast.AstType.Region region inner)
      (ast.ast-ty-region
        region
        (tc-lifetime-subst-type subst (ast.ty-node-get inner)))]
    [(ast.AstType.EnumArgs name lifetimes)
      (ast.ast-ty-enum-args
        name
        (tc-lifetime-subst-list subst (__tl-box-place lifetimes)))]
    [(ast.AstType.StructArgs name lifetimes)
      (ast.ast-ty-struct-args
        name
        (tc-lifetime-subst-list subst (__tl-box-place lifetimes)))]
    [(ast.AstType.VarArgs name lifetimes)
      (ast.ast-ty-var-args
        name
        (tc-lifetime-subst-list subst (__tl-box-place lifetimes)))]
    [(ast.AstType.Consume inner)
      (ast.ast-ty-consume
        (tc-lifetime-subst-type subst (ast.ty-node-get inner)))]
    [_ ty]))

(define (tc-call-lifetime-subst-mismatch-message) : String
  "typecheck: internal call lifetime substitution mismatch")

(define (tc-infer-lifetime-name
  [params : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : i64]
  [actual : i64]) : ResultTcLifetimeSubst
  (if (tc-lifetime-list-contains params formal)
    (tc-lifetime-subst-bind subst formal actual)
    (if (= formal actual)
      (ResultTcLifetimeSubst.Ok subst)
      (ResultTcLifetimeSubst.Err (tc-call-lifetime-subst-mismatch-message)))))

;; Call inference follows the formal occurrence's structural variance. A
;; covariant occurrence contributes an upper bound and therefore keeps the
;; shortest comparable actual lifetime; a contravariant occurrence contributes
;; a lower bound and keeps the longest. Invariant occurrences must agree
;; exactly. Shadowing is safe because substitution lookup returns the newest
;; binding first, and the fully substituted call is validated afterwards.
(define (tc-lifetime-subst-bind-for-variance
  [env : TcTypeEnv]
  [subst : TcLifetimeSubst]
  [from : i64]
  [to : i64]
  [variance : TcVariance]) : ResultTcLifetimeSubst
  (match (tc-lifetime-subst-lookup subst from)
    [(TcMaybeNameId.Some existing)
      (if (= existing to)
        (ResultTcLifetimeSubst.Ok subst)
        (match variance
          [(TcVariance.TcVarianceBivariant) (ResultTcLifetimeSubst.Ok subst)]
          [(TcVariance.TcVarianceCovariant)
            (cond
              [(tc-lifetime-outlives-lifetime-id? env existing to)
                (ResultTcLifetimeSubst.Ok
                  (tc-lifetime-subst-push subst from to))]
              [(tc-lifetime-outlives-lifetime-id? env to existing)
                (ResultTcLifetimeSubst.Ok subst)]
              [else
                (ResultTcLifetimeSubst.Err
                  (tc-call-lifetime-subst-mismatch-message))])]
          [(TcVariance.TcVarianceContravariant)
            (cond
              [(tc-lifetime-outlives-lifetime-id? env existing to)
                (ResultTcLifetimeSubst.Ok subst)]
              [(tc-lifetime-outlives-lifetime-id? env to existing)
                (ResultTcLifetimeSubst.Ok
                  (tc-lifetime-subst-push subst from to))]
              [else
                (ResultTcLifetimeSubst.Err
                  (tc-call-lifetime-subst-mismatch-message))])]
          [(TcVariance.TcVarianceInvariant)
            (ResultTcLifetimeSubst.Err
              (tc-call-lifetime-subst-mismatch-message))]))]
    [(TcMaybeNameId.No)
      (ResultTcLifetimeSubst.Ok (tc-lifetime-subst-push subst from to))]))

(define (tc-infer-call-lifetime-name
  [env : TcTypeEnv]
  [params : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : i64]
  [actual : i64]
  [variance : TcVariance]) : ResultTcLifetimeSubst
  (if (tc-lifetime-list-contains params formal)
    (tc-lifetime-subst-bind-for-variance env subst formal actual variance)
    (if (tc-lifetime-coercible-for-variance? env variance formal actual)
      (ResultTcLifetimeSubst.Ok subst)
      (ResultTcLifetimeSubst.Err (tc-call-lifetime-subst-mismatch-message)))))

(define (tc-infer-call-nominal-lifetime-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]
  [name-id : i64]
  [formal : ast.AstLifetimeList]
  [actual : ast.AstLifetimeList]
  [position : TcVariance]) : ResultTcLifetimeSubst
  (if (=
    (ast.ast-lifetime-list-len (& formal))
    (ast.ast-lifetime-list-len (& actual)))
    (tc-infer-call-nominal-lifetime-list-at
      ctx
      env
      params
      subst
      name-id
      (& formal)
      (& actual)
      position
      0)
    (ResultTcLifetimeSubst.Err (tc-call-lifetime-subst-mismatch-message))))

(define (tc-infer-call-nominal-lifetime-list-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]
  [name-id : i64]
  [formal : (& formal ast.AstLifetimeList)]
  [actual : (& actual ast.AstLifetimeList)]
  [position : TcVariance]
  [index : i64]) : ResultTcLifetimeSubst
  (if (>= index (ast.ast-lifetime-list-len formal))
    (ResultTcLifetimeSubst.Ok subst)
    (match (tc-infer-call-lifetime-name
      env
      params
      subst
      (ast.ast-lifetime-list-get formal index (ast.ast-lifetime-fallback))
      (ast.ast-lifetime-list-get actual index (ast.ast-lifetime-fallback))
      (tc-variance-compose
        position
        (tc-nominal-lifetime-variance-at ctx name-id index TcNameIdList.Nil)))
      [(ResultTcLifetimeSubst.Ok next-subst)
        (tc-infer-call-nominal-lifetime-list-at
          ctx
          env
          params
          next-subst
          name-id
          formal
          actual
          position
          (+ index 1))]
      [(ResultTcLifetimeSubst.Err message) (ResultTcLifetimeSubst.Err message)])))

(define (tc-infer-lifetime-list
  [params : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : ast.AstLifetimeList]
  [actual : ast.AstLifetimeList]) : ResultTcLifetimeSubst
  (if (=
    (ast.ast-lifetime-list-len (& formal))
    (ast.ast-lifetime-list-len (& actual)))
    (tc-infer-lifetime-list-at params subst (& formal) (& actual) 0)
    (ResultTcLifetimeSubst.Err (tc-call-lifetime-subst-mismatch-message))))

(define (tc-infer-lifetime-list-at
  [params : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : (& formal ast.AstLifetimeList)]
  [actual : (& actual ast.AstLifetimeList)]
  [index : i64]) : ResultTcLifetimeSubst
  (if (>= index (ast.ast-lifetime-list-len formal))
    (ResultTcLifetimeSubst.Ok subst)
    (match (tc-infer-lifetime-name
      params
      subst
      (ast.ast-lifetime-list-get formal index (ast.ast-lifetime-fallback))
      (ast.ast-lifetime-list-get actual index (ast.ast-lifetime-fallback)))
      [(ResultTcLifetimeSubst.Ok next-subst)
        (tc-infer-lifetime-list-at params next-subst formal actual (+ index 1))]
      [(ResultTcLifetimeSubst.Err message) (ResultTcLifetimeSubst.Err message)])))

(define (tc-infer-lifetime-subst-from-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : ast.AstType]
  [actual : ast.AstType]
  [position : TcVariance]) : ResultTcLifetimeSubst
  (let
    [want : ast.AstType (tc-resolve-type ctx formal)]
    [got : ast.AstType (tc-resolve-type ctx actual)]
    (match want
      [(ast.AstType.Ref formal-lifetime formal-inner)
        (match got
          [(ast.AstType.Ref actual-lifetime actual-inner)
            (match (tc-infer-call-lifetime-name
              env
              params
              subst
              formal-lifetime
              actual-lifetime
              position)
              [(ResultTcLifetimeSubst.Ok next-subst)
                (let
                  [formal-inner-ty : ast.AstType
                    (tc-type-strip-region
                      (tc-resolve-type
                        ctx
                        (tc-context-type-get ctx formal-inner)))]
                  [actual-inner-ty : ast.AstType
                    (tc-type-strip-region
                      (tc-resolve-type
                        ctx
                        (tc-context-type-get ctx actual-inner)))]
                  (match formal-inner-ty
                    [(ast.AstType.Slice formal-elem)
                      (match actual-inner-ty
                        [(ast.AstType.Slice actual-elem)
                          (tc-infer-lifetime-subst-from-type
                            ctx
                            env
                            params
                            next-subst
                            (ast.ty-node-get formal-elem)
                            (ast.ty-node-get actual-elem)
                            position)]
                        [(ast.AstType.Array actual-elem _)
                          (tc-infer-lifetime-subst-from-type
                            ctx
                            env
                            params
                            next-subst
                            (ast.ty-node-get formal-elem)
                            (ast.ty-node-get actual-elem)
                            position)]
                        [_
                          (ResultTcLifetimeSubst.Err
                            (tc-call-lifetime-subst-mismatch-message))])]
                    [_
                      (tc-infer-lifetime-subst-from-type
                        ctx
                        env
                        params
                        next-subst
                        (ast.ty-node-get formal-inner)
                        (ast.ty-node-get actual-inner)
                        position)]))]
              [(ResultTcLifetimeSubst.Err message)
                (ResultTcLifetimeSubst.Err message)])]
          [_
            (ResultTcLifetimeSubst.Err
              (tc-call-lifetime-subst-mismatch-message))])]
      [(ast.AstType.MutRef formal-lifetime formal-inner)
        (match got
          [(ast.AstType.MutRef actual-lifetime actual-inner)
            (match (tc-infer-call-lifetime-name
              env
              params
              subst
              formal-lifetime
              actual-lifetime
              position)
              [(ResultTcLifetimeSubst.Ok next-subst)
                (let
                  [formal-inner-ty : ast.AstType
                    (tc-type-strip-region
                      (tc-resolve-type
                        ctx
                        (tc-context-type-get ctx formal-inner)))]
                  [actual-inner-ty : ast.AstType
                    (tc-type-strip-region
                      (tc-resolve-type
                        ctx
                        (tc-context-type-get ctx actual-inner)))]
                  (match formal-inner-ty
                    [(ast.AstType.Slice formal-elem)
                      (match actual-inner-ty
                        [(ast.AstType.Slice actual-elem)
                          (tc-infer-lifetime-subst-from-type
                            ctx
                            env
                            params
                            next-subst
                            (ast.ty-node-get formal-elem)
                            (ast.ty-node-get actual-elem)
                            (TcVariance.TcVarianceInvariant))]
                        [(ast.AstType.Array actual-elem _)
                          (tc-infer-lifetime-subst-from-type
                            ctx
                            env
                            params
                            next-subst
                            (ast.ty-node-get formal-elem)
                            (ast.ty-node-get actual-elem)
                            (TcVariance.TcVarianceInvariant))]
                        [_
                          (ResultTcLifetimeSubst.Err
                            (tc-call-lifetime-subst-mismatch-message))])]
                    [_
                      (tc-infer-lifetime-subst-from-type
                        ctx
                        env
                        params
                        next-subst
                        (ast.ty-node-get formal-inner)
                        (ast.ty-node-get actual-inner)
                        (TcVariance.TcVarianceInvariant))]))]
              [(ResultTcLifetimeSubst.Err message)
                (ResultTcLifetimeSubst.Err message)])]
          [_
            (ResultTcLifetimeSubst.Err
              (tc-call-lifetime-subst-mismatch-message))])]
      [(ast.AstType.Region formal-lifetime formal-inner)
        (match got
          [(ast.AstType.Region actual-lifetime actual-inner)
            (match (tc-infer-call-lifetime-name
              env
              params
              subst
              formal-lifetime
              actual-lifetime
              position)
              [(ResultTcLifetimeSubst.Ok next-subst)
                (tc-infer-lifetime-subst-from-type
                  ctx
                  env
                  params
                  next-subst
                  (ast.ty-node-get formal-inner)
                  (ast.ty-node-get actual-inner)
                  position)]
              [(ResultTcLifetimeSubst.Err message)
                (ResultTcLifetimeSubst.Err message)])]
          [_
            (ResultTcLifetimeSubst.Err
              (tc-call-lifetime-subst-mismatch-message))])]
      [(ast.AstType.EnumArgs formal-name formal-lifetimes)
        (match got
          [(ast.AstType.EnumArgs actual-name actual-lifetimes)
            (if (tc-nominal-name-id-eq? formal-name actual-name)
              (tc-infer-call-nominal-lifetime-list
                ctx
                env
                params
                subst
                formal-name
                (__tl-box-place formal-lifetimes)
                (__tl-box-place actual-lifetimes)
                position)
              (ResultTcLifetimeSubst.Err
                (tc-call-lifetime-subst-mismatch-message)))]
          [_
            (ResultTcLifetimeSubst.Err
              (tc-call-lifetime-subst-mismatch-message))])]
      [(ast.AstType.StructArgs formal-name formal-lifetimes)
        (match got
          [(ast.AstType.StructArgs actual-name actual-lifetimes)
            (if (tc-nominal-name-id-eq? formal-name actual-name)
              (tc-infer-call-nominal-lifetime-list
                ctx
                env
                params
                subst
                formal-name
                (__tl-box-place formal-lifetimes)
                (__tl-box-place actual-lifetimes)
                position)
              (ResultTcLifetimeSubst.Err
                (tc-call-lifetime-subst-mismatch-message)))]
          [_
            (ResultTcLifetimeSubst.Err
              (tc-call-lifetime-subst-mismatch-message))])]
      [(ast.AstType.Func formal-params formal-ret)
        (match got
          [(ast.AstType.Func actual-params actual-ret)
            (match (tc-infer-lifetime-subst-from-type-list
              ctx
              env
              params
              subst
              (__tl-box-place formal-params)
              (__tl-box-place actual-params)
              (tc-variance-flip position))
              [(ResultTcLifetimeSubst.Ok next-subst)
                (tc-infer-lifetime-subst-from-type
                  ctx
                  env
                  params
                  next-subst
                  (ast.ty-node-get formal-ret)
                  (ast.ty-node-get actual-ret)
                  position)]
              [(ResultTcLifetimeSubst.Err message)
                (ResultTcLifetimeSubst.Err message)])]
          [_
            (ResultTcLifetimeSubst.Err
              (tc-call-lifetime-subst-mismatch-message))])]
      [(ast.AstType.Tuple formal-elems)
        (match got
          [(ast.AstType.Tuple actual-elems)
            (tc-infer-lifetime-subst-from-type-list
              ctx
              env
              params
              subst
              (__tl-box-place formal-elems)
              (__tl-box-place actual-elems)
              position)]
          [_
            (ResultTcLifetimeSubst.Err
              (tc-call-lifetime-subst-mismatch-message))])]
      [(ast.AstType.Array formal-elem formal-len)
        (match got
          [(ast.AstType.Array actual-elem actual-len)
            (if (= formal-len actual-len)
              (tc-infer-lifetime-subst-from-type
                ctx
                env
                params
                subst
                (ast.ty-node-get formal-elem)
                (ast.ty-node-get actual-elem)
                position)
              (ResultTcLifetimeSubst.Err
                (tc-call-lifetime-subst-mismatch-message)))]
          [_
            (ResultTcLifetimeSubst.Err
              (tc-call-lifetime-subst-mismatch-message))])]
      [(ast.AstType.DynArray formal-elem)
        (match got
          [(ast.AstType.DynArray actual-elem)
            (tc-infer-lifetime-subst-from-type
              ctx
              env
              params
              subst
              (ast.ty-node-get formal-elem)
              (ast.ty-node-get actual-elem)
              (TcVariance.TcVarianceInvariant))]
          [_
            (ResultTcLifetimeSubst.Err
              (tc-call-lifetime-subst-mismatch-message))])]
      [(ast.AstType.Slice formal-elem)
        (match got
          [(ast.AstType.Slice actual-elem)
            (tc-infer-lifetime-subst-from-type
              ctx
              env
              params
              subst
              (ast.ty-node-get formal-elem)
              (ast.ty-node-get actual-elem)
              position)]
          [_
            (ResultTcLifetimeSubst.Err
              (tc-call-lifetime-subst-mismatch-message))])]
      [(ast.AstType.Box formal-elem)
        (match got
          [(ast.AstType.Box actual-elem)
            (tc-infer-lifetime-subst-from-type
              ctx
              env
              params
              subst
              (ast.ty-node-get formal-elem)
              (ast.ty-node-get actual-elem)
              position)]
          [_
            (ResultTcLifetimeSubst.Err
              (tc-call-lifetime-subst-mismatch-message))])]
      [(ast.AstType.Ptr formal-elem)
        (match got
          [(ast.AstType.Ptr actual-elem)
            (tc-infer-lifetime-subst-from-type
              ctx
              env
              params
              subst
              (ast.ty-node-get formal-elem)
              (ast.ty-node-get actual-elem)
              position)]
          [_
            (ResultTcLifetimeSubst.Err
              (tc-call-lifetime-subst-mismatch-message))])]
      [(ast.AstType.MutPtr formal-elem)
        (match got
          [(ast.AstType.MutPtr actual-elem)
            (tc-infer-lifetime-subst-from-type
              ctx
              env
              params
              subst
              (ast.ty-node-get formal-elem)
              (ast.ty-node-get actual-elem)
              (TcVariance.TcVarianceInvariant))]
          [_
            (ResultTcLifetimeSubst.Err
              (tc-call-lifetime-subst-mismatch-message))])]
      [(ast.AstType.Consume formal-inner)
        (match got
          [(ast.AstType.Consume actual-inner)
            (tc-infer-lifetime-subst-from-type
              ctx
              env
              params
              subst
              (ast.ty-node-get formal-inner)
              (ast.ty-node-get actual-inner)
              position)]
          [_
            (ResultTcLifetimeSubst.Err
              (tc-call-lifetime-subst-mismatch-message))])]
      [_
        (if (tc-type-coercible? ctx env want got)
          (ResultTcLifetimeSubst.Ok subst)
          (ResultTcLifetimeSubst.Err (tc-call-lifetime-subst-mismatch-message)))])))

(define (tc-infer-lifetime-subst-from-type-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : ast.AstTypeList]
  [actual : ast.AstTypeList]
  [position : TcVariance]) : ResultTcLifetimeSubst
  (if (= (ast.ast-type-list-len (& formal)) (ast.ast-type-list-len (& actual)))
    (tc-infer-lifetime-subst-from-type-list-at
      ctx
      env
      params
      subst
      (& formal)
      (& actual)
      position
      0)
    (ResultTcLifetimeSubst.Err (tc-call-lifetime-subst-mismatch-message))))

(define (tc-infer-lifetime-subst-from-type-list-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : (& formal ast.AstTypeList)]
  [actual : (& actual ast.AstTypeList)]
  [position : TcVariance]
  [index : i64]) : ResultTcLifetimeSubst
  (if (>= index (ast.ast-type-list-len formal))
    (ResultTcLifetimeSubst.Ok subst)
    (match (tc-infer-lifetime-subst-from-type
      ctx
      env
      params
      subst
      (ast.ty-node-get
        (ast.ast-type-list-get formal index (ast.ast-type-id-fallback)))
      (ast.ty-node-get
        (ast.ast-type-list-get actual index (ast.ast-type-id-fallback)))
      position)
      [(ResultTcLifetimeSubst.Ok next-subst)
        (tc-infer-lifetime-subst-from-type-list-at
          ctx
          env
          params
          next-subst
          formal
          actual
          position
          (+ index 1))]
      [(ResultTcLifetimeSubst.Err message) (ResultTcLifetimeSubst.Err message)])))

(define (tc-call-immutable-ref-formal? [ctx : TcContext] [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(ast.AstType.Ref _ _) true]
    [(ast.AstType.Var _)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(ast.AstType.Ref _ _) true]
        [_ false])]
    [(ast.AstType.VarArgs _ _)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(ast.AstType.Ref _ _) true]
        [_ false])]
    [_ false]))

;; A Slice is an unsized view, so only a borrowed Slice referent is a legal
;; call formal.  Keep this predicate deliberately shallow: Slice nested inside
;; another owning/container type must not activate call unsizing.
(define (tc-call-slice-ref-formal? [ctx : TcContext] [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(ast.AstType.Ref _ inner)
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-context-type-get ctx inner)))
        [(ast.AstType.Slice _) true]
        [_ false])]
    [(ast.AstType.MutRef _ inner)
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-context-type-get ctx inner)))
        [(ast.AstType.Slice _) true]
        [_ false])]
    [_ false]))

;; Closed, call-local whole-array unsizing.  This is intentionally separate
;; from tc-type-compatible?/tc-match-inferred-type-for-expected: a fixed Array
;; reference can become a Slice reference only at a typed call boundary, with
;; exact element type and matching mutability.
(define (tc-call-array-ref-to-slice-ref-compatible?
  [ctx : TcContext]
  [expected : ast.AstType]
  [actual : ast.AstType]) : bool
  (let
    [want : ast.AstType (tc-type-strip-region (tc-resolve-type ctx expected))]
    [got : ast.AstType (tc-type-strip-region (tc-resolve-type ctx actual))]
    (match want
      [(ast.AstType.Ref _ want-inner)
        (match got
          [(ast.AstType.Ref _ got-inner)
            (match (tc-type-strip-region
              (tc-resolve-type ctx (tc-context-type-get ctx want-inner)))
              [(ast.AstType.Slice want-elem)
                (match (tc-type-strip-region
                  (tc-resolve-type ctx (tc-context-type-get ctx got-inner)))
                  [(ast.AstType.Array got-elem _)
                    (tc-type-eq
                      (tc-resolve-type ctx (ast.ty-node-get want-elem))
                      (tc-resolve-type ctx (ast.ty-node-get got-elem)))]
                  [_ false])]
              [_ false])]
          [_ false])]
      [(ast.AstType.MutRef _ want-inner)
        (match got
          [(ast.AstType.MutRef _ got-inner)
            (match (tc-type-strip-region
              (tc-resolve-type ctx (tc-context-type-get ctx want-inner)))
              [(ast.AstType.Slice want-elem)
                (match (tc-type-strip-region
                  (tc-resolve-type ctx (tc-context-type-get ctx got-inner)))
                  [(ast.AstType.Array got-elem _)
                    (tc-type-eq
                      (tc-resolve-type ctx (ast.ty-node-get want-elem))
                      (tc-resolve-type ctx (ast.ty-node-get got-elem)))]
                  [_ false])]
              [_ false])]
          [_ false])]
      [_ false])))

(define (tc-call-mutable-ref-formal? [ctx : TcContext] [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(ast.AstType.MutRef _ _) true]
    [(ast.AstType.Var _)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(ast.AstType.MutRef _ _) true]
        [_ false])]
    [(ast.AstType.VarArgs _ _)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(ast.AstType.MutRef _ _) true]
        [_ false])]
    [_ false]))

(define (tc-call-actual-immutable-reference?
  [ctx : TcContext]
  [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(ast.AstType.Ref _ _) true]
    [(ast.AstType.Var _)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(ast.AstType.Ref _ _) true]
        [_ false])]
    [(ast.AstType.VarArgs _ _)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(ast.AstType.Ref _ _) true]
        [_ false])]
    [_ false]))

(define (tc-call-string-temporary-ref-compatible?
  [ctx : TcContext]
  [want : ast.AstType]
  [got : ast.AstType]) : bool
  (and
    (tc-str-ref-type? (tc-resolve-type ctx want))
    (match (tc-type-strip-region got)
      [(ast.AstType.String) true]
      [_ false])))

(define (tc-call-type-list-has-immutable-ref-formal?
  [ctx : TcContext]
  [types : ast.AstTypeList]) : bool
  (tc-call-type-list-has-immutable-ref-formal-at? ctx (& types) 0))

(define (tc-call-type-list-has-immutable-ref-formal-at?
  [ctx : TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    false
    (if (tc-call-immutable-ref-formal?
      ctx
      (ast.ty-node-get
        (ast.ast-type-list-get types index (ast.ast-type-id-fallback))))
      true
      (tc-call-type-list-has-immutable-ref-formal-at? ctx types (+ index 1)))))

(define (tc-call-auto-borrow-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : ast.AstExpr]) : ResultTcType
  (match (tc-borrow-place ctx (tc-context-expr-bases ctx) env arg)
    [(ResultTcBorrowPlace.Ok place)
      (match place
        [(TcBorrowPlace lifetime referent-ty)
          (ResultTcType.Ok (ast.ast-ty-ref lifetime referent-ty))])]
    [(ResultTcBorrowPlace.Err message) (ResultTcType.Err message)]))

(define (tc-call-auto-borrow-expr [arg : ast.AstExpr]) : ast.AstExpr
  (ast.ast-node-get
    (ast.ast-expr-borrow
      false
      ast.AstBorrowLifetime.Inferred
      (ast.ast-node-push arg))))

(define (tc-call-effective-var-arg-type
  [ctx : TcContext]
  [name : i64]
  [got : ast.AstType]) : ResultTcType
  ;; An existing shared reference already has the effective call shape. An
  ;; existing mutable reference must still pass through tc-borrow-place-var so
  ;; the call gets a tracked shared reborrow with the referent's lifetime.
  (if (tc-call-actual-immutable-reference? ctx got)
    (ResultTcType.Ok got)
    (match (tc-borrow-place-var name got)
      [(ResultTcBorrowPlace.Ok place)
        (match place
          [(TcBorrowPlace lifetime referent-ty)
            (ResultTcType.Ok (ast.ast-ty-ref lifetime referent-ty))])]
      [(ResultTcBorrowPlace.Err message) (ResultTcType.Err message)])))

;; Body-local memo for a call argument's non-contextual inferred type, keyed by
;; the argument's Spanned payload node id. Call arguments are re-inferred by the
;; lifetime-substitution pass, the effective-arg (auto-borrow) rewrite, and the
;; move/borrow-check passes; without a memo each nesting level of a call chain
;; re-walks its whole argument subtree, which is exponential in nesting depth.
;; The facts live in the per-function-body tc-body-type-fact table (populated
;; while recording, dropped by tc-body-type-facts-clear!), so entries never leak
;; across bodies. Unlike tc-body-type-fact-lookup this lookup also hits during
;; the recording phase: the redundant walks it collapses run at the same program
;; point with the same environment as the walk that recorded the fact, so the
;; recorded type is exactly the type a re-walk would recompute.
(define (tc-call-arg-fact-key [arg : ast.AstExpr]) : i64
  (match arg
    [(ast.AstExpr.Spanned inner-box _) inner-box]
    [(ast.AstExpr.MacroExpansion inner-box _ _)
      (tc-call-arg-fact-key (ast.ast-node-get inner-box))]
    [_ -1]))

(define (tc-call-arg-fact-lookup [state : TcBodyState] [key : i64]) : TcBodyTypeFact
  (let
    [data : TcBodyStateData (tc-body-state-data-value state)]
    (if (and
      (>= key 0)
      (or data.type-facts-recording data.type-facts-consuming))
      (let
        [slot : i64 (tc-body-type-fact-slot state key)]
        (if (and (>= slot 0) (< slot data.type-fact-count))
          (TcBodyTypeFact.Hit (array.ref data.type-fact-types slot))
          (TcBodyTypeFact.Miss)))
      (TcBodyTypeFact.Miss))))

(define (tc-call-arg-expr-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : ast.AstExpr]) : ResultTcType
  (let
    [key : i64 (tc-call-arg-fact-key arg)]
    [state : TcBodyState (tc-context-body-state ctx)]
    (match (tc-call-arg-fact-lookup state key)
      [(TcBodyTypeFact.Hit ty) (ResultTcType.Ok ty)]
      [(TcBodyTypeFact.Miss)
        (match (tc-expr ctx env arg)
          [(ResultTcType.Ok ty)
            (begin
              (if (>= key 0)
                (tc-body-type-fact-record! state key ty)
                unit)
              (ResultTcType.Ok ty))]
          [(ResultTcType.Err message) (ResultTcType.Err message)])])))

;; A formal that resolves to a type with no reference lifetimes and no
;; struct/enum lifetime arguments cannot contribute lifetime bindings to the
;; call substitution, so the substitution pass may skip inferring that
;; argument's type entirely (tc-check-call-args typechecks every argument right
;; after). tc-resolve-type resolves aliases structurally, so lifetimes hidden
;; behind an alias are still seen.
(define (tc-lifetime-subst-formal-inert? [ctx : TcContext] [want : ast.AstType]) : bool
  (match (tc-type-collect-reference-lifetimes-into
    (tc-resolve-type ctx want)
    TcNameIdList.Nil)
    [(TcNameIdList.Nil) true]
    [_ false]))

(define (tc-call-effective-arg-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : ast.AstExpr]
  [want : ast.AstType]) : ResultTcType
  ;; Slice formals require an already-borrowed argument.  Do not run the
  ;; ordinary immutable-reference auto-borrow path for them.
  (if (tc-call-slice-ref-formal? ctx want)
    (tc-call-arg-expr-type ctx env arg)
    (if (tc-call-immutable-ref-formal? ctx want)
      (match (ast.ast-expr-unspan arg)
        [(ast.AstExpr.Var name)
          (if (tc-dotted-place-name-id? ctx env name)
            (match (tc-call-arg-expr-type ctx env arg)
              [(ResultTcType.Ok got)
                (if (tc-call-actual-immutable-reference? ctx got)
                  (ResultTcType.Ok got)
                  (tc-call-auto-borrow-type ctx env arg))]
              [(ResultTcType.Err message) (ResultTcType.Err message)])
            (match (tc-lookup-visible-id ctx env name)
              [(ResultTcType.Ok got)
                (tc-call-effective-var-arg-type ctx name got)]
              [(ResultTcType.Err message)
                ;; Qualified module values are ordinary variable expressions,
                ;; but are not stored under their surface dotted id in the
                ;; lexical env. Let normal expression lookup resolve them
                ;; before deciding whether the typed reference formal can
                ;; auto-borrow the resulting place.
                (match (tc-call-arg-expr-type ctx env arg)
                  [(ResultTcType.Ok got)
                    (if (tc-call-actual-immutable-reference? ctx got)
                      (ResultTcType.Ok got)
                      (tc-call-auto-borrow-type ctx env arg))]
                  [(ResultTcType.Err _) (ResultTcType.Err message)])]))]
        [_
          (match (tc-call-arg-expr-type ctx env arg)
            [(ResultTcType.Ok got)
              (if (tc-call-actual-immutable-reference? ctx got)
                (ResultTcType.Ok got)
                (match (tc-call-auto-borrow-type ctx env arg)
                  [(ResultTcType.Ok borrowed) (ResultTcType.Ok borrowed)]
                  [(ResultTcType.Err message)
                    (if (tc-call-string-temporary-ref-compatible? ctx want got)
                      (ResultTcType.Ok want)
                      (ResultTcType.Err message))]))]
            [(ResultTcType.Err message) (ResultTcType.Err message)])])
      (tc-expr-with-expected-or-actual-call-arg ctx env arg want))))

(define (tc-call-effective-var-arg-expr
  [ctx : TcContext]
  [name : i64]
  [got : ast.AstType]
  [arg : ast.AstExpr]) : ResultTcExpr
  (if (tc-call-actual-immutable-reference? ctx got)
    (ResultTcExpr.Ok arg)
    (match (tc-borrow-place-var name got)
      [(ResultTcBorrowPlace.Ok _)
        (ResultTcExpr.Ok (tc-call-auto-borrow-expr arg))]
      [(ResultTcBorrowPlace.Err message) (ResultTcExpr.Err message)])))

(define (tc-call-effective-arg-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : ast.AstExpr]
  [want : ast.AstType]) : ResultTcExpr
  (if (tc-call-slice-ref-formal? ctx want)
    (ResultTcExpr.Ok arg)
    (if (tc-call-immutable-ref-formal? ctx want)
      (if (tc-call-explicit-borrow-expr? arg)
        (ResultTcExpr.Ok arg)
        (match (ast.ast-expr-unspan arg)
          [(ast.AstExpr.Var name)
            (if (tc-dotted-place-name-id? ctx env name)
              (match (tc-call-arg-expr-type ctx env arg)
                [(ResultTcType.Ok got)
                  (if (tc-call-actual-immutable-reference? ctx got)
                    (ResultTcExpr.Ok arg)
                    (match (tc-call-auto-borrow-type ctx env arg)
                      [(ResultTcType.Ok _)
                        (ResultTcExpr.Ok (tc-call-auto-borrow-expr arg))]
                      [(ResultTcType.Err message) (ResultTcExpr.Err message)]))]
                [(ResultTcType.Err message) (ResultTcExpr.Err message)])
              (match (tc-lookup-visible-id ctx env name)
                [(ResultTcType.Ok got)
                  (tc-call-effective-var-arg-expr ctx name got arg)]
                [(ResultTcType.Err message)
                  (match (tc-call-arg-expr-type ctx env arg)
                    [(ResultTcType.Ok got)
                      (if (tc-call-actual-immutable-reference? ctx got)
                        (ResultTcExpr.Ok arg)
                        (match (tc-call-auto-borrow-type ctx env arg)
                          [(ResultTcType.Ok _)
                            (ResultTcExpr.Ok (tc-call-auto-borrow-expr arg))]
                          [(ResultTcType.Err borrow-message)
                            (ResultTcExpr.Err borrow-message)]))]
                    [(ResultTcType.Err _) (ResultTcExpr.Err message)])]))]
          [_
            (match (tc-call-arg-expr-type ctx env arg)
              [(ResultTcType.Ok got)
                (if (tc-call-actual-immutable-reference? ctx got)
                  (ResultTcExpr.Ok arg)
                  (match (tc-call-auto-borrow-type ctx env arg)
                    [(ResultTcType.Ok _)
                      (ResultTcExpr.Ok (tc-call-auto-borrow-expr arg))]
                    [(ResultTcType.Err message)
                      (if (tc-call-string-temporary-ref-compatible?
                        ctx
                        want
                        got)
                        (ResultTcExpr.Ok arg)
                        (ResultTcExpr.Err message))]))]
              [(ResultTcType.Err message) (ResultTcExpr.Err message)])]))
      (ResultTcExpr.Ok arg))))

(define (tc-infer-call-lifetime-subst
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [lifetimes : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]) : ResultTcLifetimeSubst
  (tc-infer-call-lifetime-subst-at
    ctx
    env
    func
    args
    params
    (& args)
    (& params)
    0
    lifetimes
    subst))

(define (tc-infer-lifetime-subst-from-mixed-source-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [lifetimes : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]
  [want : ast.AstType]
  [got : ast.AstType]) : ResultTcLifetimeSubst
  (let
    [canonical-got : ast.AstType (tc-canonicalize-inferred-type ctx got)]
    (match (tc-infer-lifetime-subst-from-type
      ctx
      env
      lifetimes
      subst
      want
      canonical-got
      (TcVariance.TcVarianceCovariant))
      [(ResultTcLifetimeSubst.Ok next-subst)
        (ResultTcLifetimeSubst.Ok next-subst)]
      [(ResultTcLifetimeSubst.Err _)
        (let
          [canonical-want : ast.AstType
            (tc-canonicalize-inferred-type ctx want)]
          (match (tc-infer-lifetime-subst-from-type
            ctx
            env
            lifetimes
            subst
            canonical-want
            got
            (TcVariance.TcVarianceCovariant))
            [(ResultTcLifetimeSubst.Ok next-subst)
              (ResultTcLifetimeSubst.Ok next-subst)]
            [(ResultTcLifetimeSubst.Err _)
              (tc-infer-lifetime-subst-from-type
                ctx
                env
                lifetimes
                subst
                canonical-want
                canonical-got
                (TcVariance.TcVarianceCovariant))]))])))

(define (tc-infer-call-lifetime-subst-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [all-args : ast.AstExprList]
  [all-params : ast.AstTypeList]
  [args : (& args ast.AstExprList)]
  [params : (& params ast.AstTypeList)]
  [index : i64]
  [lifetimes : ast.AstLifetimeList]
  [subst : TcLifetimeSubst]) : ResultTcLifetimeSubst
  (if (>= index args.len)
    (if (>= index (ast.ast-type-list-len params))
      (ResultTcLifetimeSubst.Ok subst)
      (ResultTcLifetimeSubst.Err
        (tc-call-arity-message func all-args all-params)))
    (if (>= index (ast.ast-type-list-len params))
      (ResultTcLifetimeSubst.Err
        (tc-call-arity-message func all-args all-params))
      (let
        [arg : ast.AstExpr
          (tc-context-expr-get ctx (ast.ast-expr-list-get args index 0))]
        [want : ast.AstType
          (ast.ast-type-strip-consuming-param-with-pools
            (tc-context-pools ctx)
            (ast.ty-node-get
              (ast.ast-type-list-get params index (ast.ast-type-id-fallback))))]
        (if (tc-lifetime-subst-formal-inert? ctx want)
          (tc-infer-call-lifetime-subst-at
            ctx
            env
            func
            all-args
            all-params
            args
            params
            (+ index 1)
            lifetimes
            subst)
          (match (tc-call-effective-arg-type ctx env arg want)
            [(ResultTcType.Ok got)
              (match (tc-infer-lifetime-subst-from-type
                ctx
                env
                lifetimes
                subst
                want
                got
                (TcVariance.TcVarianceCovariant))
                [(ResultTcLifetimeSubst.Ok next-subst)
                  (tc-infer-call-lifetime-subst-at
                    ctx
                    env
                    func
                    all-args
                    all-params
                    args
                    params
                    (+ index 1)
                    lifetimes
                    next-subst)]
                [(ResultTcLifetimeSubst.Err _message)
                  (match (tc-infer-lifetime-subst-from-mixed-source-type
                    ctx
                    env
                    lifetimes
                    subst
                    want
                    got)
                    [(ResultTcLifetimeSubst.Ok next-subst)
                      (tc-infer-call-lifetime-subst-at
                        ctx
                        env
                        func
                        all-args
                        all-params
                        args
                        params
                        (+ index 1)
                        lifetimes
                        next-subst)]
                    [(ResultTcLifetimeSubst.Err _)
                      (let
                        [canonical-want : ast.AstType
                          (tc-canonicalize-inferred-type ctx want)]
                        [canonical-got : ast.AstType
                          (tc-canonicalize-inferred-type ctx got)]
                        [required-want : ast.AstType
                          (tc-lifetime-subst-type subst canonical-want)]
                        (ResultTcLifetimeSubst.Err
                          (tc-locate-error-at-expr
                            arg
                            (tc-type-mismatch-message-in-context
                              ctx
                              env
                              canonical-got
                              required-want
                              (tc-call-argument-message-prefix ctx func index)))))])])]
            [(ResultTcType.Err message)
              (ResultTcLifetimeSubst.Err (tc-locate-error-at-expr arg message))]))))))

(define (tc-call-lifetime-constructor-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [ret : ast.AstType]
  [allow-region-args : bool]) : ResultTcType
  (let
    [lifetimes : ast.AstLifetimeList
      (match ret
        [(ast.AstType.StructArgs _ params-lifetimes)
          (__tl-box-place params-lifetimes)]
        [(ast.AstType.EnumArgs _ params-lifetimes)
          (__tl-box-place params-lifetimes)]
        [_ (ast.ast-lifetime-list-new)])]
    (match (tc-infer-call-lifetime-subst
      ctx
      env
      func
      args
      params
      lifetimes
      TcLifetimeSubst.Nil)
      [(ResultTcLifetimeSubst.Ok subst)
        (let
          [target : ast.AstType
            (tc-tag-active-region env (tc-lifetime-subst-type subst ret))]
          [resolved-params : ast.AstTypeList
            (tc-lifetime-subst-type-list subst params)]
          (match (tc-check-call-args
            ctx
            env
            func
            args
            resolved-params
            allow-region-args
            (ast.AstMaybeType.Some target)
            false)
            [(ResultTcUnit.Ok) (ResultTcType.Ok target)]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)]))]
      [(ResultTcLifetimeSubst.Err message) (ResultTcType.Err message)])))

(define (tc-call-function-lifetimes
  [params : ast.AstTypeList]
  [ret : ast.AstType]) : ast.AstLifetimeList
  (tc-name-id-list-to-lifetime-list
    (tc-type-collect-reference-lifetimes-into
      ret
      (tc-type-list-collect-reference-lifetimes params TcNameIdList.Nil))))

(define (tc-call-lifetime-function-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [ret : ast.AstType]
  [lifetimes : ast.AstLifetimeList]
  [allow-region-args : bool]
  [c-abi-args : bool]) : ResultTcType
  (match (tc-infer-call-lifetime-subst
    ctx
    env
    func
    args
    params
    lifetimes
    TcLifetimeSubst.Nil)
    [(ResultTcLifetimeSubst.Ok subst)
      (let
        [resolved-ret : ast.AstType (tc-lifetime-subst-type subst ret)]
        [resolved-params : ast.AstTypeList
          (tc-lifetime-subst-type-list subst params)]
        (match (tc-check-call-args
          ctx
          env
          func
          args
          resolved-params
          allow-region-args
          (ast.AstMaybeType.No)
          c-abi-args)
          [(ResultTcUnit.Ok)
            (ResultTcType.Ok (tc-tag-active-region env resolved-ret))]
          [(ResultTcUnit.Err message) (ResultTcType.Err message)]))]
    [(ResultTcLifetimeSubst.Err message) (ResultTcType.Err message)]))

(define (tc-call-dynamic-c-varargs-abi? [abi : ast.AstExternAbi]) : bool
  (or
    (ast.ast-extern-abi-c-varargs-open? abi)
    (ast.ast-extern-abi-c-varargs-typed? abi)))

(define (tc-call-extern-abi-for-name-id [ctx : TcContext] [name-id : i64]) : TcMaybeExternAbi
  (let
    [lookup-id : i64 (tc-env-name-key-id name-id)]
    [handle : i64
      (if (or
        (macro-hygiene-global-id? name-id)
        (tc-name-qualified-id? name-id))
        (csym.compiler-symbols-lookup-value-id-or
          (tc-context-symbols ctx)
          lookup-id
          (csym.compiler-symbols-missing-handle))
        (csym.compiler-symbols-lookup-value-in-module-id-or
          (tc-context-symbols ctx)
          (tc-context-module-id ctx)
          lookup-id
          (csym.compiler-symbols-missing-handle)))]
    (if (and
      (csym.compiler-symbols-handle-found? handle)
      (=
        (csym.compiler-symbol-handle-kind handle)
        (csym.compiler-symbol-kind-extern)))
      (match (csym.compiler-symbols-decl-at-index
        (tc-context-symbols ctx)
        (csym.compiler-symbol-handle-index handle))
        [(parser.ResultAstDecl.Ok
            (ast.AstDecl.Extern decl-meta _ kind metadata _))
          (match kind
            [(ast.AstExternKind.Function)
              (TcMaybeExternAbi.Some
                (ast.ast-extern-metadata-abi (__tl-box-place metadata)))]
            [(ast.AstExternKind.Value) (TcMaybeExternAbi.No)])]
        [_ (TcMaybeExternAbi.No)])
      (TcMaybeExternAbi.No))))

(define (tc-call-extern-abi [ctx : TcContext] [func : ast.AstExpr]) : TcMaybeExternAbi
  (match (ast.ast-expr-unspan func)
    [(ast.AstExpr.Var name) (tc-call-extern-abi-for-name-id ctx name)]
    [_ (TcMaybeExternAbi.No)]))

(define (tc-c-abi-fnptr-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(ast.AstType.Func _ _) true]
    [_ false]))

(define (tc-extern-value-c-abi-fnptr?
  [ctx : TcContext]
  [kind : ast.AstExternKind]
  [ty : ast.AstType]) : bool
  (match kind
    [(ast.AstExternKind.Value) (tc-c-abi-fnptr-type? (tc-resolve-type ctx ty))]
    [(ast.AstExternKind.Function) false]))

(define (tc-expr-list-last-c-abi-fnptr?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]) : bool
  (if (ast.ast-expr-list-empty? (& exprs))
    false
    (tc-expr-c-abi-fnptr?
      ctx
      env
      (tc-context-expr-get
        ctx
        (ast.ast-expr-list-get (& exprs) (- exprs.len 1) 0)))))

(define (tc-hygiene-c-abi-fnptr-binding?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (let
    [source-name-id : i64 (macro-hygiene-global-source-name-id-or name-id -1)]
    [module-id : i64
      (if (macro-hygiene-global-id? name-id)
        (macro-hygiene-global-module-id name-id)
        (let
          [qualified-module-id : i64 (ci.intern-qualified-module-id name-id)]
          (if (< qualified-module-id 0)
            cbi.compiler-builtin-id-fix-empty
            qualified-module-id)))]
    (if (< source-name-id 0)
      false
      (if (and
        (macro-hygiene-global-legacy-id? name-id)
        (csym.compiler-symbol-root-module-id? module-id))
        (tc-binding-c-abi-fnptr-id? env source-name-id)
        (match (tc-hygiene-definition-env-id
          ctx
          (macro-decl-module-display module-id)
          module-id)
          [(ResultTcEnv.Ok def-env)
            (tc-binding-c-abi-fnptr-persistent-id? def-env source-name-id)]
          [(ResultTcEnv.Err _) false])))))

(define (tc-expr-c-abi-fnptr?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan expr)
    [(ast.AstExpr.Var name)
      (if (tc-hygiene-global-name-id? name)
        (tc-hygiene-c-abi-fnptr-binding? ctx env name)
        (tc-binding-c-abi-fnptr-id? env name))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-box)]
        (tc-expr-c-abi-fnptr? ctx env inner))]
    [(ast.AstExpr.Let let-box)
      (match (__tl-box-place let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : ast.AstExpr (tc-context-expr-get ctx body-box)]
            (match (tc-let-bindings-for-body ctx env bindings body)
              [(ResultTcEnv.Ok next-env)
                (tc-expr-c-abi-fnptr? ctx next-env body)]
              [(ResultTcEnv.Err _) false]))])]
    [(ast.AstExpr.Begin exprs) (tc-expr-list-last-c-abi-fnptr? ctx env exprs)]
    [(ast.AstExpr.If _ then-box else-box)
      (let
        [then-branch : ast.AstExpr (tc-context-expr-get ctx then-box)]
        [else-branch : ast.AstExpr (tc-context-expr-get ctx else-box)]
        (and
          (tc-expr-c-abi-fnptr? ctx env then-branch)
          (tc-expr-c-abi-fnptr? ctx env else-branch)))]
    [_ false]))

(define (tc-name-base-eq? [name : String] [base : String]) : bool
  (if (string.eq name base)
    true
    (if (tc-name-qualified? name)
      (string.eq (tc-qualified-name-base name) base)
      false)))

(define (tc-nominal-struct-type-id-eq?
  [ctx : TcContext]
  [ty : ast.AstType]
  [expected-id : i64]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(ast.AstType.Struct actual) (tc-nominal-name-id-eq? actual expected-id)]
    [(ast.AstType.StructArgs actual _)
      (tc-nominal-name-id-eq? actual expected-id)]
    [_ false]))

(define (tc-arena-type? [ctx : TcContext] [ty : ast.AstType]) : bool
  (tc-nominal-struct-type-id-eq? ctx ty cbi.compiler-builtin-id-arena-type))

(define (tc-arena-phase-type? [ctx : TcContext] [ty : ast.AstType]) : bool
  (tc-nominal-struct-type-id-eq?
    ctx
    ty
    cbi.compiler-builtin-id-arena-phase-type))

(define (tc-arena-source-call-base-id?
  [ctx : TcContext]
  [_env : TcTypeEnv]
  [name-id : i64]
  [base-id : i64]) : bool
  (if (tc-name-qualified-id? name-id)
    (and
      (=
        (tc-qualified-name-module-id name-id)
        cbi.compiler-builtin-id-arena-module)
      (= (tc-qualified-name-base-id name-id) base-id))
    (and
      (= name-id base-id)
      (= (tc-context-module-id ctx) cbi.compiler-builtin-id-arena-module))))

(define (tc-arena-canonical-call-base-id? [lookup-id : i64] [base-id : i64]) : bool
  (and
    (tc-name-qualified-id? lookup-id)
    (=
      (tc-qualified-name-module-id lookup-id)
      cbi.compiler-builtin-id-arena-module)
    (= (tc-qualified-name-base-id lookup-id) base-id)))

(define (tc-arena-safe-call-kind-none) : i64
  0)

(define (tc-arena-safe-call-kind-phase) : i64
  1)

(define (tc-arena-safe-call-kind-rewind) : i64
  2)

(define (tc-arena-safe-call-kind-destroy) : i64
  3)

(define (tc-arena-safe-call-base-kind-id [base-id : i64]) : i64
  (cond
    [(= base-id cbi.compiler-builtin-id-arena-phase-base)
      (tc-arena-safe-call-kind-phase)]
    [(= base-id cbi.compiler-builtin-id-arena-rewind-safe-base)
      (tc-arena-safe-call-kind-rewind)]
    [(= base-id cbi.compiler-builtin-id-arena-destroy-safe-base)
      (tc-arena-safe-call-kind-destroy)]
    [else (tc-arena-safe-call-kind-none)]))

;; Call dispatch has already resolved dotted module aliases into `lookup-id`.
;; Classify that canonical id once, then check the source-name owner fallback
;; once.  The old per-builtin predicates repeated the same environment name
;; resolution for phase, rewind-safe!, and destroy-safe! in sequence.
(define (tc-arena-safe-call-kind-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [lookup-id : i64]) : i64
  (let
    [canonical-module-id : i64 (tc-qualified-name-module-id lookup-id)]
    [canonical-kind : i64
      (if (= canonical-module-id cbi.compiler-builtin-id-arena-module)
        (tc-arena-safe-call-base-kind-id (tc-qualified-name-base-id lookup-id))
        (tc-arena-safe-call-kind-none))]
    (if (not (= canonical-kind (tc-arena-safe-call-kind-none)))
      canonical-kind
      (let
        [qualified : bool (tc-name-qualified-id? name-id)]
        [source-base-id : i64
          (if qualified
            (tc-qualified-name-base-id name-id)
            name-id)]
        [source-kind : i64 (tc-arena-safe-call-base-kind-id source-base-id)]
        (cond
          [(= source-kind (tc-arena-safe-call-kind-none)) source-kind]
          [(and
              qualified
              (=
                (tc-qualified-name-module-id name-id)
                cbi.compiler-builtin-id-arena-module)
              (tc-source-name-bound-exact-id? env name-id))
            source-kind]
          [qualified (tc-arena-safe-call-kind-none)]
          [(= (tc-context-module-id ctx) cbi.compiler-builtin-id-arena-module)
            source-kind]
          [else (tc-arena-safe-call-kind-none)])))))

(define (tc-arena-owner-kind-none) : i64
  0)

(define (tc-arena-owner-kind-ordinary) : i64
  1)

(define (tc-arena-owner-kind-atomic) : i64
  2)

(define (tc-arena-owner-call-kind-ids
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-id : i64]
  [lookup-id : i64]
  [arg-count : i64]) : i64
  (if (= arg-count 0)
    (cond
      [(or
          (tc-arena-source-call-base-id?
            ctx
            env
            source-id
            cbi.compiler-builtin-id-arena-make-atomic)
          (tc-arena-canonical-call-base-id?
            lookup-id
            cbi.compiler-builtin-id-arena-make-atomic-base))
        (tc-arena-owner-kind-atomic)]
      [(or
          (tc-arena-source-call-base-id?
            ctx
            env
            source-id
            cbi.compiler-builtin-id-arena-make)
          (tc-arena-canonical-call-base-id?
            lookup-id
            cbi.compiler-builtin-id-arena-make-base))
        (tc-arena-owner-kind-ordinary)]
      [else (tc-arena-owner-kind-none)])
    (tc-arena-owner-kind-none)))

(define (tc-arena-brand-id [kind : i64] [call-site-id : i64]) : i64
  (ci.intern-generated-canonical-name
    (str_cat.str-cat
      (if (= kind (tc-arena-owner-kind-atomic))
        (tc-arena-brand-atomic-prefix)
        (tc-arena-brand-ordinary-prefix))
      (string.int->string call-site-id))))

(define (tc-arena-branded-type [kind : i64] [call-site-id : i64]) : ast.AstType
  (ast.ast-ty-struct-args
    cbi.compiler-builtin-id-arena-type
    (ast.ast-lifetime-cons
      (tc-arena-brand-id kind call-site-id)
      (ast.ast-lifetime-list-new))))

(cfg
  test
  (define (tc-arena-classifier-identity-ids-ok?) : bool
    (begin
      (cbi.compiler-builtin-initialize-for-parse!)
      (let
        [generated-module : i64
          (ci.intern-generated-canonical-name "stdlib.arena")]
        [generated-type : i64
          (ci.intern-generated-canonical-name "stdlib.arena/Arena")]
        [generated-phase : i64 (ci.intern-generated-canonical-name "phase")]
        [canonical-phase : i64
          (tc-qualified-name-key-id
            cbi.compiler-builtin-id-arena-module
            cbi.compiler-builtin-id-arena-phase-base)]
        [generated-module-phase : i64
          (tc-qualified-name-key-id
            generated-module
            cbi.compiler-builtin-id-arena-phase-base)]
        [generated-base-phase : i64
          (tc-qualified-name-key-id
            cbi.compiler-builtin-id-arena-module
            generated-phase)]
        (and
          (tc-nominal-name-id-eq?
            cbi.compiler-builtin-id-arena-type
            cbi.compiler-builtin-id-arena-type)
          (not
            (tc-nominal-name-id-eq?
              generated-type
              cbi.compiler-builtin-id-arena-type))
          (=
            (tc-arena-safe-call-base-kind-id
              cbi.compiler-builtin-id-arena-phase-base)
            (tc-arena-safe-call-kind-phase))
          (=
            (tc-arena-safe-call-base-kind-id
              cbi.compiler-builtin-id-arena-rewind-safe-base)
            (tc-arena-safe-call-kind-rewind))
          (=
            (tc-arena-safe-call-base-kind-id
              cbi.compiler-builtin-id-arena-destroy-safe-base)
            (tc-arena-safe-call-kind-destroy))
          (=
            (tc-arena-safe-call-base-kind-id generated-phase)
            (tc-arena-safe-call-kind-none))
          (tc-arena-canonical-call-base-id?
            canonical-phase
            cbi.compiler-builtin-id-arena-phase-base)
          (not
            (tc-arena-canonical-call-base-id?
              generated-module-phase
              cbi.compiler-builtin-id-arena-phase-base))
          (not
            (tc-arena-canonical-call-base-id?
              generated-base-phase
              cbi.compiler-builtin-id-arena-phase-base)))))))

(cfg
  test
  (test
    tc-arena-classifier-identity-ids
    (if (tc-arena-classifier-identity-ids-ok?)
      unit
      (io.panic "typecheck: arena classifier identity ID test failed"))))

(cfg
  test
  (define (tc-arena-generated-brand-ids-ok?) : bool
    (begin
      (cbi.compiler-builtin-initialize-for-parse!)
      (let
        [ordinary-a : i64
          (tc-arena-brand-id (tc-arena-owner-kind-ordinary) 101)]
        [ordinary-a-again : i64
          (tc-arena-brand-id (tc-arena-owner-kind-ordinary) 101)]
        [ordinary-b : i64
          (tc-arena-brand-id (tc-arena-owner-kind-ordinary) 102)]
        [atomic-a : i64 (tc-arena-brand-id (tc-arena-owner-kind-atomic) 101)]
        [ordinary-ty : ast.AstType
          (tc-arena-branded-type (tc-arena-owner-kind-ordinary) 101)]
        [atomic-ty : ast.AstType
          (tc-arena-branded-type (tc-arena-owner-kind-atomic) 101)]
        [rendered : String (tc-type-render ordinary-ty)]
        [ordinary-prefix : String (tc-arena-brand-ordinary-prefix)]
        [env : TcTypeEnv (tc-empty-env)]
        (and
          (= ordinary-a ordinary-a-again)
          (not (= ordinary-a ordinary-b))
          (not (= ordinary-a atomic-a))
          (tc-generated-ordinary-arena-brand-id? ordinary-a)
          (tc-generated-atomic-arena-brand-id? atomic-a)
          (tc-lifetime-visible-id? env ordinary-a)
          (tc-ordinary-arena-owner-active-id? env ordinary-a)
          (tc-atomic-arena-owner-active-id? env atomic-a)
          (not (tc-atomic-arena-owner-active-id? env ordinary-a))
          (not (tc-type-regions-all-atomic-arena-owners? env ordinary-ty))
          (tc-type-regions-all-atomic-arena-owners? env atomic-ty)
          (string.contains (& rendered) (& ordinary-prefix)))))))

(cfg
  test
  (test
    tc-arena-generated-brand-ids
    (if (tc-arena-generated-brand-ids-ok?)
      unit
      (io.panic "typecheck: generated Arena brand ID test failed"))))

(define (tc-arena-call-lookup-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-id : i64]) : i64
  (if (or (< source-id 0) (tc-name-qualified-id? source-id))
    source-id
    (let
      [first-dot : i64 (tc-name-first-dot-id source-id)]
      (if (or
        (< first-dot 0)
        (tc-source-leading-segment-wins-over-exact-id-from-dot?
          env
          source-id
          first-dot))
        source-id
        (let
          [current-module-id : i64 (tc-context-module-id ctx)]
          [alias-id : i64 (ci.intern-leading-dot-id source-id)]
          [module-id : i64 (ci.intern-dotted-prefix-id source-id)]
          [base-id : i64 (ci.intern-dotted-final-id source-id)]
          [alias-target-id : i64
            (match (tc-context-program ctx)
              [(ast.AstProgram.Program decls-box)
                (match (tc-source-dotted-alias-target-id-in-context
                  ctx
                  (__tl-box-place decls-box)
                  current-module-id
                  alias-id)
                  [(TcMaybeNameId.Some target-id) target-id]
                  [(TcMaybeNameId.No) -1])])]
          (if (= alias-target-id cbi.compiler-builtin-id-arena-module)
            (tc-qualified-name-key-id alias-target-id base-id)
            (if (and
              (= module-id cbi.compiler-builtin-id-arena-module)
              (or
                (= current-module-id module-id)
                (tc-imported-module-identity-id? ctx module-id)))
              (tc-qualified-name-key-id module-id base-id)
              source-id)))))))

(define (tc-arena-owner-call-kind
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]) : i64
  (match (ast.ast-expr-unspan expr)
    [(ast.AstExpr.Call func-box args)
      (let
        [nid : i64 (tc-expr-var-name-id (tc-context-expr-get ctx func-box))]
        (if (>= nid 0)
          (let
            [source-id : i64 (macro-hygiene-global-source-name-id-or nid nid)]
            [lookup-id : i64 (tc-arena-call-lookup-id ctx env source-id)]
            (tc-arena-owner-call-kind-ids ctx env source-id lookup-id args.len))
          (tc-arena-owner-kind-none)))]
    [_ (tc-arena-owner-kind-none)]))

(define (tc-phase-call-owner
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]) : TcMaybeNameId
  (match (ast.ast-expr-unspan expr)
    [(ast.AstExpr.Call func-box args)
      (if (= args.len 1)
        (let
          [owner-expr : ast.AstExpr
            (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
          [nid : i64 (tc-expr-var-name-id (tc-context-expr-get ctx func-box))]
          (if (>= nid 0)
            (let
              [source-id : i64 (macro-hygiene-global-source-name-id-or nid nid)]
              [lookup-id : i64 (tc-arena-call-lookup-id ctx env source-id)]
              (if (=
                (tc-arena-safe-call-kind-id ctx env source-id lookup-id)
                (tc-arena-safe-call-kind-phase))
                (let
                  [oid : i64 (tc-expr-var-name-id owner-expr)]
                  (if (>= oid 0)
                    (if (or
                      (tc-ordinary-arena-owner-active-id? env oid)
                      (tc-atomic-arena-owner-active-id? env oid))
                      (TcMaybeNameId.Some oid)
                      (TcMaybeNameId.No))
                    (TcMaybeNameId.No)))
                (TcMaybeNameId.No)))
            (TcMaybeNameId.No)))
        (TcMaybeNameId.No))]
    [_ (TcMaybeNameId.No)]))

(define (tc-bind-arena-owner-if-needed-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [ty : ast.AstType]
  [init : ast.AstExpr]) : TcTypeEnv
  (let
    [kind : i64 (tc-arena-owner-call-kind ctx env init)]
    [brand-env : TcTypeEnv
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(ast.AstType.StructArgs arena-name lifetimes)
          (if (and
            (tc-arena-nominal-name-id? arena-name)
            (= (tc-lifetime-list-count (__tl-box-place lifetimes)) 1))
            (let
              [brand : i64
                (ast.ast-lifetime-list-get
                  (& (__tl-box-place lifetimes))
                  0
                  (ast.ast-lifetime-fallback))]
              [brand-kind : i64
                (if (tc-generated-atomic-arena-brand-id? brand)
                  (tc-arena-owner-kind-atomic)
                  (if (tc-generated-ordinary-arena-brand-id? brand)
                    (tc-arena-owner-kind-ordinary)
                    kind))]
              (tc-bind-id
                (if (= brand-kind (tc-arena-owner-kind-atomic))
                  (tc-bind-atomic-arena-owner env brand)
                  (tc-bind-ordinary-arena-owner env brand))
                brand
                (ast.AstType.Var brand)))
            env)]
        [_ env])]
    (cond
      [(= kind (tc-arena-owner-kind-atomic))
        (tc-bind-atomic-arena-owner brand-env name)]
      [(= kind (tc-arena-owner-kind-ordinary))
        (tc-bind-ordinary-arena-owner brand-env name)]
      [else brand-env])))

(define (tc-bind-arena-phase-if-needed-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [init : ast.AstExpr]) : TcTypeEnv
  (match (tc-phase-call-owner ctx env init)
    [(TcMaybeNameId.Some owner-id)
      (tc-bind-arena-phase-token env name owner-id)]
    [(TcMaybeNameId.No) env]))

(define (tc-bind-c-abi-fnptr-if-needed-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [ty : ast.AstType]
  [init : ast.AstExpr]) : TcTypeEnv
  (let
    [owner-env : TcTypeEnv
      (if (or
        (tc-type-eq (tc-type-strip-region ty) (ast.AstType.I64))
        (tc-arena-type? ctx ty))
        (tc-bind-arena-owner-if-needed-id ctx env name ty init)
        env)]
    [phase-env : TcTypeEnv
      (tc-bind-arena-phase-if-needed-id ctx owner-env name init)]
    (if (and (tc-c-abi-fnptr-type? ty) (tc-expr-c-abi-fnptr? ctx env init))
      (tc-bind-c-abi-fnptr-id phase-env name ty)
      (tc-bind-id phase-env name ty))))

(define (tc-raw-c-fnptr-flow-ok
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [expected : ast.AstType]
  [c-abi-position : bool]) : ResultTcUnit
  (if (and
    (not c-abi-position)
    (tc-c-abi-fnptr-type? expected)
    (tc-expr-c-abi-fnptr? ctx env expr))
    (ResultTcUnit.Err
      (tc-locate-error-at-expr
        expr
        "typecheck: raw C function pointer cannot be used as a TypeLisp function value"))
    ResultTcUnit.Ok))

(define (tc-call-varargs-tail-args
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]) : ResultTcExprList
  (tc-call-varargs-tail-args-at func (& args) (& params) 0))

(define (tc-call-varargs-tail-args-at
  [func : ast.AstExpr]
  [args : (& args ast.AstExprList)]
  [params : (& params ast.AstTypeList)]
  [index : i64]) : ResultTcExprList
  (if (>= index (ast.ast-type-list-len params))
    (ResultTcExprList.Ok (ast.ast-expr-list-tail-from-ref args index))
    (if (< index args.len)
      (tc-call-varargs-tail-args-at func args params (+ index 1))
      (ResultTcExprList.Err
        (tc-call-arity-count-message
          func
          (ast.ast-type-list-len params)
          args.len)))))

(define (tc-type-list-append [a : ast.AstTypeList] [b : ast.AstTypeList]) : ast.AstTypeList
  (let
    [out : ast.AstTypeList
      (ast.ast-type-list-with-capacity
        (+ (ast.ast-type-list-len (& a)) (ast.ast-type-list-len (& b))))]
    (begin
      (ast.ast-type-list-append-from (&mut out) (& a) 0)
      (ast.ast-type-list-append-from (&mut out) (& b) 0)
      out)))

(define (tc-type-list-repeat [ty : ast.AstType] [count : i64]) : ast.AstTypeList
  (let
    [out : ast.AstTypeList (ast.ast-type-list-with-capacity count)]
    [id : i64 (ast.ast-node-pool-reader-type-push ty)]
    (begin
      (tc-type-list-repeat-into (&mut out) id count)
      out)))

(define (tc-type-list-repeat-into
  [out : (&mut out ast.AstTypeList)]
  [id : i64]
  [count : i64]) : unit
  (if (<= count 0)
    unit
    (begin
      (ast.ast-type-list-push out id)
      (tc-type-list-repeat-into out id (- count 1)))))

(define (tc-call-open-varargs-tail-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : ast.AstExprList]) : ResultTcTypeList
  (let
    [out : ast.AstTypeList (ast.ast-type-list-new)]
    (match (tc-call-open-varargs-tail-types-into-at
      ctx
      env
      (& args)
      0
      (&mut out))
      [(ResultTcUnit.Ok) (ResultTcTypeList.Ok out)]
      [(ResultTcUnit.Err message) (ResultTcTypeList.Err message)])))

(define (tc-call-open-varargs-tail-types-into-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [index : i64]
  [out : (&mut out ast.AstTypeList)]) : ResultTcUnit
  (if (>= index args.len)
    ResultTcUnit.Ok
    (let
      [arg : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get args index 0))]
      (match (tc-expr ctx env arg)
        [(ResultTcType.Ok ty)
          (let
            [resolved : ast.AstType (tc-resolve-type ctx ty)]
            (if (tc-extern-abi-value-type-ok? ctx resolved)
              (begin
                (ast.ast-type-list-push
                  out
                  (ast.ast-node-pool-reader-type-push ty))
                (tc-call-open-varargs-tail-types-into-at
                  ctx
                  env
                  args
                  (+ index 1)
                  out))
              (ResultTcUnit.Err
                (tc-extern-abi-unsupported-message "variadic argument" resolved))))]
        [(ResultTcType.Err message) (ResultTcUnit.Err message)]))))

(define (tc-call-extern-varargs-params
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [abi : ast.AstExternAbi]) : ResultTcTypeList
  (match (tc-call-varargs-tail-args func args params)
    [(ResultTcExprList.Ok tail-args)
      (if (ast.ast-extern-abi-c-varargs-open? abi)
        (match (tc-call-open-varargs-tail-types ctx env tail-args)
          [(ResultTcTypeList.Ok tail-types)
            (ResultTcTypeList.Ok (tc-type-list-append params tail-types))]
          [(ResultTcTypeList.Err message) (ResultTcTypeList.Err message)])
        (if (ast.ast-extern-abi-c-varargs-typed? abi)
          (let
            [tail-ty : ast.AstType
              (tc-resolve-type ctx (ast.ast-extern-abi-varargs-tail-type abi))]
            (ResultTcTypeList.Ok
              (tc-type-list-append
                params
                (tc-type-list-repeat tail-ty (tc-expr-list-len tail-args)))))
          (ResultTcTypeList.Ok params)))]
    [(ResultTcExprList.Err message) (ResultTcTypeList.Err message)]))

(define (tc-call-function-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [ret : ast.AstType]) : ResultTcType
  (match (tc-call-extern-abi ctx func)
    [(TcMaybeExternAbi.Some abi)
      (if (tc-call-dynamic-c-varargs-abi? abi)
        (match (tc-call-extern-varargs-params ctx env func args params abi)
          [(ResultTcTypeList.Ok expanded-params)
            (tc-call-function-type-normal
              ctx
              env
              func
              args
              expanded-params
              ret
              true)]
          [(ResultTcTypeList.Err message) (ResultTcType.Err message)])
        (tc-call-function-type-normal ctx env func args params ret true))]
    [(TcMaybeExternAbi.No)
      (tc-call-function-type-normal
        ctx
        env
        func
        args
        params
        ret
        (tc-expr-c-abi-fnptr? ctx env func))]))

(define (tc-thread-name-last-dot [name : String]) : i64
  (let
    [first : i64 (tc-name-first-dot name)]
    (if (< first 0)
      -1
      (let
        [i : i64 (+ first 1)]
        [n : i64 (string.string-length name)]
        [last : i64 first]
        (begin
          (while (< i n)
            (begin
              (if (string.char-eq (string.string-ref name i) '.')
                (set! last i)
                unit)
              (set! i (+ i 1))))
          last)))))

(define (tc-thread-name-base [name : String]) : String
  (if (tc-name-qualified? name)
    (tc-qualified-name-base name)
    name))

(define (tc-thread-source-name-base [name : String]) : String
  (if (tc-name-qualified? name)
    (tc-qualified-name-base name)
    (let
      [dot : i64 (tc-thread-name-last-dot name)]
      (if (and (>= dot 0) (< dot (- (string.string-length name) 1)))
        (string.substring
          name
          (+ dot 1)
          (- (string.string-length name) (+ dot 1)))
        name))))

(define (tc-thread-name-base-eq? [name : String] [base : String]) : bool
  (tc-name-base-eq? name base))

(define (tc-thread-generated-module-prefix) : String
  "stdlib.thread.generated.")

(define (tc-thread-generated-module? [module : String]) : bool
  (tc-string-prefix? module (tc-thread-generated-module-prefix)))

(define (tc-thread-generated-module-type-key [module : String]) : String
  (let
    [prefix-len : i64
      (string.string-length (tc-thread-generated-module-prefix))]
    [module-len : i64 (string.string-length module)]
    (if (tc-thread-generated-module? module)
      (string.substring module prefix-len (- module-len prefix-len))
      "")))

(define (tc-thread-generated-name-module [name : String] [base : String]) : TcMaybeString
  (if (tc-name-qualified? name)
    (let
      [module : String (tc-qualified-name-module name)]
      (if (and
        (tc-thread-generated-module? module)
        (string.eq (tc-qualified-name-base name) base))
        (TcMaybeString.Some module)
        (TcMaybeString.No)))
    (TcMaybeString.No)))

(define (tc-thread-generated-name? [name : String] [base : String]) : bool
  (match (tc-thread-generated-name-module name base)
    [(TcMaybeString.Some _) true]
    [(TcMaybeString.No) false]))

(define (tc-thread-type-name-base? [name : String] [base : String]) : bool
  (string.eq (tc-thread-name-base name) base))

(define (tc-thread-generated-handle-type-name? [name : String]) : bool
  (or
    (tc-thread-generated-name? name "Handle")
    (and
      (not (tc-name-qualified? name))
      (>= (tc-thread-name-last-dot name) 0)
      (string.eq (tc-thread-source-name-base name) "Handle"))))

(define (tc-spawn-string-name? [name : String]) : bool
  (string.eq (tc-thread-source-name-base name) "spawn-string"))

(define (tc-spawn-i64-vec-name? [name : String]) : bool
  (string.eq (tc-thread-source-name-base name) "spawn-i64-vec"))

(define (tc-spawn-box-i64-name? [name : String]) : bool
  (string.eq (tc-thread-source-name-base name) "spawn-box-i64"))

(define (tc-thread-legacy-safe-spawn-base? [base : String]) : bool
  (or
    (string.eq base "spawn-string")
    (string.eq base "spawn-i64-vec")
    (string.eq base "spawn-box-i64")))

(define (tc-thread-legacy-safe-spawn-name? [name : String]) : bool
  (tc-thread-legacy-safe-spawn-base? (tc-thread-source-name-base name)))

(define (tc-thread-safe-handle-type-name? [name : String]) : bool
  (let
    [base : String (tc-thread-name-base name)]
    (or
      (tc-thread-generated-handle-type-name? name)
      (string.eq base "ThreadString")
      (string.eq base "ThreadI64Vec")
      (string.eq base "ThreadBoxI64"))))

(define (tc-thread-spawn-lookup-name
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-name : String]
  [source-id : i64]) : String
  (match (tc-source-name-lookup-key-with-field-check
    ctx
    env
    source-name
    source-id
    true)
    [(ResultTcString.Ok lookup-name) lookup-name]
    [(ResultTcString.Err _) source-name]))

(define (tc-thread-potential-safe-spawn-name?
  [source-name : String]
  [lookup-name : String]) : bool
  (or
    (tc-thread-legacy-safe-spawn-name? source-name)
    (tc-thread-legacy-safe-spawn-name? lookup-name)
    (tc-thread-generated-name? lookup-name "spawn")
    (string.eq (tc-thread-source-name-base source-name) "spawn")
    (string.eq (tc-thread-name-base lookup-name) "spawn")))

(define (tc-thread-potential-safe-spawn-source-name? [source-name : String]) : bool
  (let
    [base : String (tc-thread-source-name-base source-name)]
    (or (string.eq base "spawn") (tc-thread-legacy-safe-spawn-base? base))))

(define (tc-thread-channel-send-name? [name : String]) : bool
  (let
    [base : String (tc-thread-source-name-base name)]
    (and
      (tc-string-prefix? base "channel-")
      (tc-string-has-suffix? base "-send"))))

;; Classifying a call name for the thread-safety checks costs a qualified?
;; scan plus a last-dot scan over the rendered name, and both checks run for
;; every call expression in the program. The answers depend only on a typed
;; renderable source-name ID and its immutable intern-session owner. A job-owned
;; sparse epoch map avoids allocating `intern-capacity` slots and never consults
;; the active process-global intern selector.
(define (tc-thread-name-kind-ensure-owner!
  [state : TcThreadNameKindState]
  [table-id : i64]
  [generation : i64]) : TcThreadNameKindStateData
  (let
    [data : TcThreadNameKindStateData (tc-thread-name-kind-state-data state)]
    (begin
      (if (and
        (= data.intern-generation generation)
        (= data.intern-table-id table-id))
        unit
        (begin
          (tc-cache-map-clear! (&mut data.kinds))
          (set! data.epoch (+ data.epoch 1))
          (set! data.intern-generation generation)
          (set! data.intern-table-id table-id)
          (tc-thread-name-kind-state-data-set! state data)))
      data)))

(define (tc-thread-name-kind-compute [name : String]) : i64
  (bit-or
    (if (tc-thread-channel-send-name? name)
      1
      0)
    (if (tc-thread-potential-safe-spawn-source-name? name)
      2
      0)))

(define (tc-thread-name-kind-owned
  [state : TcThreadNameKindState]
  [table-id : i64]
  [generation : i64]
  [source-name-id : ci.InternId]
  [name : String]) : i64
  (let
    [data : TcThreadNameKindStateData
      (tc-thread-name-kind-ensure-owner! state table-id generation)]
    [key : i64 (ci.intern-id-value source-name-id)]
    (if (not data.accelerator-enabled)
      (tc-thread-name-kind-compute name)
      (let
        [packed : i64 (tc_i64_i64_map.get-value-or (& data.kinds) key 0)]
        (if (= (shr packed 2) data.epoch)
          (bit-and packed 3)
          (let
            [kind : i64 (tc-thread-name-kind-compute name)]
            (begin
              (tc-cache-map-grow-in-owner! (&mut data.kinds) data.owner-arena)
              (tc_i64_i64_map.insert-ref!
                (&mut data.kinds)
                key
                (bit-or (shl data.epoch 2) kind))
              (tc-thread-name-kind-state-data-set! state data)
              kind)))))))

(cfg
  test
  (define (tc-thread-name-kind-job-owned-smoke?) : bool
    (let
      [job-a : TcJobState (tc-job-state-new)]
      [job-b : TcJobState (tc-job-state-new)]
      [state-a : TcThreadNameKindState (tc-job-state-thread-name-kind job-a)]
      [state-b : TcThreadNameKindState (tc-job-state-thread-name-kind job-b)]
      [name-id : ci.InternId
        (ci.intern-id-from-renderable (ci.intern "thread-kind-owned"))]
      [a-channel : i64
        (tc-thread-name-kind-owned
          state-a
          301
          401
          name-id
          "channel-worker-send")]
      [b-spawn : i64
        (tc-thread-name-kind-owned state-b 301 401 name-id "spawn")]
      [a-cached : i64
        (tc-thread-name-kind-owned state-a 301 401 name-id "spawn")]
      ;; Reusing a numeric ID under a different owner must invalidate A's entry.
      [a-new-owner : i64
        (tc-thread-name-kind-owned state-a 302 402 name-id "ordinary")]
      (begin
        (tc-job-state-set-thread-name-kind-enabled! job-a false)
        (let
          [uncached : i64
            (tc-thread-name-kind-owned state-a 302 402 name-id "spawn")]
          [data : TcThreadNameKindStateData
            (tc-thread-name-kind-state-data state-a)]
          (and
            (= a-channel 1)
            (= b-spawn 2)
            (= a-cached 1)
            (= a-new-owner 0)
            (= uncached 2)
            (= (tc_i64_i64_map.len (& data.kinds)) 1)
            (< (tc_i64_i64_map.capacity (& data.kinds)) (ci.intern-capacity))))))))

(cfg
  test
  (test
    tc-thread-name-kind-job-owned
    (if (tc-thread-name-kind-job-owned-smoke?)
      unit
      (io.panic "typecheck: job-owned thread-name kind smoke failed"))))

(define (tc-thread-name-kind
  [ctx : TcContext]
  [source-name-id : i64]
  [name : String]) : i64
  (let
    [session : ci.InternSourceNameSession
      (ci.intern-source-name-session-handle-session
        (tc-context-source-names ctx))]
    [identity : ci.InternSyntaxTextIdentity
      (ci.intern-source-name-session-identity session source-name-id)]
    (match (ci.intern-source-name-session-resolve session identity name)
      [(ci.InternSourceNameResolution.ParsedIdentity owned-id)
        (tc-thread-name-kind-owned
          (tc-job-state-thread-name-kind (tc-context-job-state ctx))
          session.table-id
          session.reset-generation
          (ci.intern-id-from-renderable owned-id)
          name)]
      [(ci.InternSourceNameResolution.GeneratedIdentity owned-id lookup)
        (match lookup
          [(ci.InternLookupFound resolved-id)
            (if (= owned-id resolved-id)
              (tc-thread-name-kind-owned
                (tc-job-state-thread-name-kind (tc-context-job-state ctx))
                session.table-id
                session.reset-generation
                (ci.intern-id-from-renderable owned-id)
                name)
              (tc-thread-name-kind-compute name))]
          [_ (tc-thread-name-kind-compute name)])]
      [_ (tc-thread-name-kind-compute name)])))

(define (tc-thread-safe-spawn-call-name
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]) : TcMaybeString
  (let
    [nid : i64 (tc-expr-var-name-id func)]
    (if (>= nid 0)
      (let
        [source-id : i64 (macro-hygiene-global-source-name-id-or nid nid)]
        [name : String (ci.intern-str source-id)]
        (if (= (bit-and (tc-thread-name-kind ctx source-id name) 2) 2)
          (if (tc-thread-potential-safe-spawn-name?
            name
            (tc-thread-spawn-lookup-name ctx env name source-id))
            (TcMaybeString.Some name)
            (TcMaybeString.No))
          (TcMaybeString.No)))
      (TcMaybeString.No))))

(define (tc-thread-channel-send-call-name
  [ctx : TcContext]
  [func : ast.AstExpr]) : TcMaybeString
  (let
    [nid : i64 (tc-expr-var-name-id func)]
    (if (>= nid 0)
      (let
        [source-id : i64 (macro-hygiene-global-source-name-id-or nid nid)]
        [name : String (ci.intern-str source-id)]
        (if (= (bit-and (tc-thread-name-kind ctx source-id name) 1) 1)
          (TcMaybeString.Some name)
          (TcMaybeString.No)))
      (TcMaybeString.No))))

(define (tc-thread-channel-send-result-name? [name : String]) : bool
  (tc-string-has-suffix? (tc-thread-name-base name) "SendResult"))

(define (tc-thread-channel-send-result-type?
  [ctx : TcContext]
  [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(ast.AstType.Enum name)
      (tc-thread-channel-send-result-name? (tc-nominal-name-id-display name))]
    [(ast.AstType.EnumArgs name _)
      (tc-thread-channel-send-result-name? (tc-nominal-name-id-display name))]
    [_ false]))

(define (tc-thread-channel-send-message-param [params : ast.AstTypeList]) : ResultTcType
  (if (= (ast.ast-type-list-len (& params)) 2)
    (ResultTcType.Ok
      (ast.ty-node-get
        (ast.ast-type-list-get (& params) 1 (ast.ast-type-id-fallback))))
    (ResultTcType.Err
      "typecheck: channel send expects channel and message parameters")))

(define (tc-thread-channel-send-message-arg [args : ast.AstExprList]) : ResultTcExpr
  (if (= args.len 2)
    (ResultTcExpr.Ok (ast.ast-node-get (ast.ast-expr-list-get (& args) 1 0)))
    (ResultTcExpr.Err
      "typecheck: channel send expects channel and message arguments")))

(define (tc-thread-generated-spawn-result-module
  [ctx : TcContext]
  [ty : ast.AstType]) : TcMaybeString
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(ast.AstType.Enum name)
      (tc-thread-generated-name-module
        (tc-nominal-name-id-display name)
        "SpawnResult")]
    [(ast.AstType.EnumArgs name _)
      (tc-thread-generated-name-module
        (tc-nominal-name-id-display name)
        "SpawnResult")]
    [_ (TcMaybeString.No)]))

(define (tc-thread-spawn-result-type-base? [ctx : TcContext] [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(ast.AstType.Enum name)
      (tc-thread-type-name-base?
        (tc-nominal-name-id-display name)
        "SpawnResult")]
    [(ast.AstType.EnumArgs name _)
      (tc-thread-type-name-base?
        (tc-nominal-name-id-display name)
        "SpawnResult")]
    [_ false]))

(define (tc-thread-safe-spawn-result-type-name? [name : String]) : bool
  (let
    [base : String (tc-thread-name-base name)]
    (or
      (string.eq base "SpawnResult")
      (string.eq base "ThreadStringSpawnResult")
      (string.eq base "ThreadI64VecSpawnResult")
      (string.eq base "ThreadBoxI64SpawnResult"))))

(define (tc-thread-safe-user-type? [ctx : TcContext] [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(ast.AstType.Struct name)
      (tc-thread-safe-handle-type-name? (tc-nominal-name-id-display name))]
    [(ast.AstType.StructArgs name _)
      (tc-thread-safe-handle-type-name? (tc-nominal-name-id-display name))]
    [(ast.AstType.Enum name)
      (tc-thread-safe-spawn-result-type-name? (tc-nominal-name-id-display name))]
    [(ast.AstType.EnumArgs name _)
      (tc-thread-safe-spawn-result-type-name? (tc-nominal-name-id-display name))]
    [_ false]))

(define (tc-thread-generated-spawn-module
  [ctx : TcContext]
  [source-name : String]
  [lookup-name : String]
  [ret : ast.AstType]) : TcMaybeString
  (match (tc-thread-generated-name-module lookup-name "spawn")
    [(TcMaybeString.Some module) (TcMaybeString.Some module)]
    [(TcMaybeString.No)
      (if (or
        (string.eq (tc-thread-source-name-base source-name) "spawn")
        (string.eq (tc-thread-name-base lookup-name) "spawn"))
        (match (tc-thread-generated-spawn-result-module ctx ret)
          [(TcMaybeString.Some module) (TcMaybeString.Some module)]
          [(TcMaybeString.No)
            (if (tc-thread-spawn-result-type-base? ctx ret)
              (TcMaybeString.Some "")
              (TcMaybeString.No))])
        (TcMaybeString.No))]))

(define (tc-thread-generated-spawn-result-type?
  [ctx : TcContext]
  [module : String]
  [ty : ast.AstType]) : bool
  (if (string.eq module "")
    (tc-thread-spawn-result-type-base? ctx ty)
    (match (tc-thread-generated-spawn-result-module ctx ty)
      [(TcMaybeString.Some result-module) (string.eq result-module module)]
      [(TcMaybeString.No) false])))

(define (tc-thread-legacy-safe-spawn-result-type-name?
  [spawn-name : String]
  [result-name : String]) : bool
  (cond
    [(tc-spawn-string-name? spawn-name)
      (tc-thread-name-base-eq? result-name "ThreadStringSpawnResult")]
    [(tc-spawn-i64-vec-name? spawn-name)
      (tc-thread-name-base-eq? result-name "ThreadI64VecSpawnResult")]
    [(tc-spawn-box-i64-name? spawn-name)
      (tc-thread-name-base-eq? result-name "ThreadBoxI64SpawnResult")]
    [else false]))

(define (tc-thread-safe-spawn-result-type?
  [ctx : TcContext]
  [source-name : String]
  [lookup-name : String]
  [generated-module : TcMaybeString]
  [ty : ast.AstType]) : bool
  (match generated-module
    [(TcMaybeString.Some module)
      (tc-thread-generated-spawn-result-type? ctx module ty)]
    [(TcMaybeString.No)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(ast.AstType.Enum name)
          (or
            (tc-thread-legacy-safe-spawn-result-type-name?
              source-name
              (tc-nominal-name-id-display name))
            (tc-thread-legacy-safe-spawn-result-type-name?
              lookup-name
              (tc-nominal-name-id-display name)))]
        [(ast.AstType.EnumArgs name _)
          (or
            (tc-thread-legacy-safe-spawn-result-type-name?
              source-name
              (tc-nominal-name-id-display name))
            (tc-thread-legacy-safe-spawn-result-type-name?
              lookup-name
              (tc-nominal-name-id-display name)))]
        [_ false])]))

(define (tc-thread-generated-spawn-task-ret-type?
  [ctx : TcContext]
  [module : String]
  [ty : ast.AstType]) : bool
  (let
    [type-key : String (tc-thread-generated-module-type-key module)]
    [resolved : ast.AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
    (cond
      [(string.eq module "")
        (match resolved
          [(ast.AstType.I64) true]
          [(ast.AstType.Bool) true]
          [(ast.AstType.Unit) true]
          [_ false])]
      [(string.eq type-key "i64")
        (match resolved
          [(ast.AstType.I64) true]
          [_ false])]
      [(string.eq type-key "bool")
        (match resolved
          [(ast.AstType.Bool) true]
          [_ false])]
      [(string.eq type-key "unit")
        (match resolved
          [(ast.AstType.Unit) true]
          [_ false])]
      [else false])))

(define (tc-thread-safe-spawn-task-ret-type?
  [ctx : TcContext]
  [source-name : String]
  [lookup-name : String]
  [generated-module : TcMaybeString]
  [ty : ast.AstType]) : bool
  (match generated-module
    [(TcMaybeString.Some module)
      (tc-thread-generated-spawn-task-ret-type? ctx module ty)]
    [(TcMaybeString.No)
      (let
        [resolved : ast.AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
        (cond
          [(or
              (tc-spawn-string-name? source-name)
              (tc-spawn-string-name? lookup-name))
            (match resolved
              [(ast.AstType.String) true]
              [_ false])]
          [(or
              (tc-spawn-i64-vec-name? source-name)
              (tc-spawn-i64-vec-name? lookup-name))
            (match resolved
              [(ast.AstType.Struct name)
                (let
                  [display : String (tc-nominal-name-id-display name)]
                  (and
                    (tc-name-qualified? display)
                    (string.eq
                      (tc-qualified-name-module display)
                      "stdlib.vector.generated.i64")
                    (string.eq (tc-qualified-name-base display) "Vec")))]
              [_ false])]
          [(or
              (tc-spawn-box-i64-name? source-name)
              (tc-spawn-box-i64-name? lookup-name))
            (match resolved
              [(ast.AstType.Box elem)
                (match (tc-type-strip-region
                  (tc-resolve-type ctx (ast.ty-node-get elem)))
                  [(ast.AstType.I64) true]
                  [_ false])]
              [_ false])]
          [else false]))]))

(define (tc-thread-safe-spawn-task-type?
  [ctx : TcContext]
  [source-name : String]
  [lookup-name : String]
  [generated-module : TcMaybeString]
  [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(ast.AstType.Func task-params task-ret-box)
      (if (ast.ast-type-list-empty? (__tl-box-place task-params))
        (tc-thread-safe-spawn-task-ret-type?
          ctx
          source-name
          lookup-name
          generated-module
          (ast.ty-node-get task-ret-box))
        false)]
    [_ false]))

(define (tc-thread-safe-spawn-signature?
  [ctx : TcContext]
  [source-name : String]
  [lookup-name : String]
  [params : ast.AstTypeList]
  [ret : ast.AstType]) : bool
  (let
    [generated-module : TcMaybeString
      (tc-thread-generated-spawn-module ctx source-name lookup-name ret)]
    (and
      (tc-thread-safe-spawn-result-type?
        ctx
        source-name
        lookup-name
        generated-module
        ret)
      (if (= (ast.ast-type-list-len (& params)) 1)
        (tc-thread-safe-spawn-task-type?
          ctx
          source-name
          lookup-name
          generated-module
          (ast.ty-node-get
            (ast.ast-type-list-get (& params) 0 (ast.ast-type-id-fallback))))
        false))))

(define (tc-thread-transfer-class-merge
  [left : TcThreadTransferClass]
  [right : TcThreadTransferClass]) : TcThreadTransferClass
  (match left
    [(TcThreadTransferClass.Rejected _) left]
    [(TcThreadTransferClass.Transferable)
      (match right
        [(TcThreadTransferClass.Rejected _) right]
        [_ (TcThreadTransferClass.Transferable)])]
    [(TcThreadTransferClass.Shareable)
      (match right
        [(TcThreadTransferClass.Rejected _) right]
        [(TcThreadTransferClass.Transferable)
          (TcThreadTransferClass.Transferable)]
        [(TcThreadTransferClass.Shareable) (TcThreadTransferClass.Shareable)])]))

(define (tc-thread-transfer-reject [message : String]) : TcThreadTransferClass
  (TcThreadTransferClass.Rejected message))

(define (tc-thread-transfer-aggregate-class [class : TcThreadTransferClass]) : TcThreadTransferClass
  (match class
    [(TcThreadTransferClass.Rejected _) class]
    [_ (TcThreadTransferClass.Transferable)]))

(define (tc-thread-transfer-region-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "scoped-region and lifetime-parameterized values cannot cross thread boundaries"))

(define (tc-thread-transfer-reference-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "borrowed references cannot cross thread boundaries"))

(define (tc-thread-transfer-mut-reference-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "mutable references cannot cross thread boundaries"))

(define (tc-thread-transfer-raw-pointer-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "raw pointers cannot cross thread boundaries in safe code"))

(define (tc-thread-transfer-owned-heap-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "owned heap storage needs a static/program or spanning atomic owner proof"))

(define (tc-thread-transfer-cleanup-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "cleanup-required resources cannot cross thread boundaries"))

(define (tc-thread-transfer-type-list-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [types : ast.AstTypeList]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (tc-thread-transfer-type-list-class-at ctx env (& types) stack owner-proof 0))

(define (tc-thread-transfer-type-list-class-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [types : (& types ast.AstTypeList)]
  [stack : TcStringList]
  [owner-proof : bool]
  [index : i64]) : TcThreadTransferClass
  (if (>= index (ast.ast-type-list-len types))
    (TcThreadTransferClass.Shareable)
    (tc-thread-transfer-class-merge
      (tc-thread-transfer-type-class
        ctx
        env
        (ast.ty-node-get
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))
        stack
        owner-proof)
      (tc-thread-transfer-type-list-class-at
        ctx
        env
        types
        stack
        owner-proof
        (+ index 1)))))

(define (tc-thread-transfer-field-list-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [fields : ast.AstFieldDefList]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (tc-thread-transfer-field-list-class-at
    ctx
    env
    (& fields)
    stack
    owner-proof
    0))

(define (tc-thread-transfer-field-list-class-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [fields : (& fields ast.AstFieldDefList)]
  [stack : TcStringList]
  [owner-proof : bool]
  [index : i64]) : TcThreadTransferClass
  (if (>= index fields.len)
    (TcThreadTransferClass.Shareable)
    (match (ast.ast-field-def-list-get
      fields
      index
      (ast.ast-field-def-fallback))
      [(ast.AstFieldDef.Def _ ty _)
        (tc-thread-transfer-class-merge
          (tc-thread-transfer-type-class ctx env ty stack owner-proof)
          (tc-thread-transfer-field-list-class-at
            ctx
            env
            fields
            stack
            owner-proof
            (+ index 1)))])))

(define (tc-thread-transfer-variant-list-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [variants : ast.AstVariantDefList]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (tc-thread-transfer-variant-list-class-at
    ctx
    env
    (& variants)
    stack
    owner-proof
    0))

(define (tc-thread-transfer-variant-list-class-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [variants : (& variants ast.AstVariantDefList)]
  [stack : TcStringList]
  [owner-proof : bool]
  [index : i64]) : TcThreadTransferClass
  (if (>= index variants.len)
    (TcThreadTransferClass.Shareable)
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(ast.AstVariantDef.Def _ payloads _)
        (tc-thread-transfer-class-merge
          (tc-thread-transfer-type-list-class
            ctx
            env
            payloads
            stack
            owner-proof)
          (tc-thread-transfer-variant-list-class-at
            ctx
            env
            variants
            stack
            owner-proof
            (+ index 1)))])))

(define (tc-thread-transfer-struct-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [struct-name-id : i64]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (if (tc-string-list-contains stack struct-name)
    (tc-thread-transfer-reject
      (str_cat.str-cat
        "recursive aggregate "
        struct-name
        " needs an explicit spanning owner proof"))
    (match (tc-struct-decl-id ctx struct-name-id)
      [(ResultTcStructDecl.Ok decl)
        (match decl
          [(TcStructDecl _ cleanup fields)
            (if (ast.ast-struct-cleanup? cleanup)
              (tc-thread-transfer-cleanup-reject)
              (tc-thread-transfer-aggregate-class
                (tc-thread-transfer-field-list-class
                  ctx
                  env
                  fields
                  (tc-string-list-add stack struct-name)
                  owner-proof)))])]
      [(ResultTcStructDecl.Err message) (tc-thread-transfer-reject message)])))

(define (tc-thread-transfer-enum-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [enum-name-id : i64]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (if (tc-string-list-contains stack enum-name)
    (tc-thread-transfer-reject
      (str_cat.str-cat
        "recursive aggregate "
        enum-name
        " needs an explicit spanning owner proof"))
    (match (tc-enum-decl-id ctx enum-name-id)
      [(ResultTcEnumDecl.Ok decl)
        (match decl
          [(TcEnumDecl cleanup variants)
            (if (ast.ast-enum-cleanup? cleanup)
              (tc-thread-transfer-cleanup-reject)
              (tc-thread-transfer-aggregate-class
                (tc-thread-transfer-variant-list-class
                  ctx
                  env
                  variants
                  (tc-string-list-add stack enum-name)
                  owner-proof)))])]
      [(ResultTcEnumDecl.Err message) (tc-thread-transfer-reject message)])))

(define (tc-thread-transfer-type-class-with-stack
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : ast.AstType]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (let
    [resolved : ast.AstType (tc-resolve-type ctx ty)]
    (match resolved
      [(ast.AstType.Region region inner)
        (cond
          [(tc-atomic-arena-owner-active-id? env region)
            (tc-thread-transfer-type-class
              ctx
              env
              (ast.ty-node-get inner)
              stack
              true)]
          [(tc-ordinary-arena-owner-active-id? env region)
            (tc-thread-transfer-owned-heap-reject)]
          [else (tc-thread-transfer-region-reject)])]
      [(ast.AstType.Ref _ _) (tc-thread-transfer-reference-reject)]
      [(ast.AstType.MutRef _ _) (tc-thread-transfer-mut-reference-reject)]
      [(ast.AstType.Ptr _) (tc-thread-transfer-raw-pointer-reject)]
      [(ast.AstType.MutPtr _) (tc-thread-transfer-raw-pointer-reject)]
      [(ast.AstType.String)
        (if owner-proof
          (TcThreadTransferClass.Shareable)
          (tc-thread-transfer-owned-heap-reject))]
      [(ast.AstType.Str) (tc-thread-transfer-reference-reject)]
      [(ast.AstType.Bytes) (tc-thread-transfer-reference-reject)]
      [(ast.AstType.Slice _) (tc-thread-transfer-reference-reject)]
      [(ast.AstType.DynArray elem)
        (if owner-proof
          (tc-thread-transfer-aggregate-class
            (tc-thread-transfer-type-class
              ctx
              env
              (ast.ty-node-get elem)
              stack
              owner-proof))
          (tc-thread-transfer-owned-heap-reject))]
      [(ast.AstType.Box elem)
        (if owner-proof
          (tc-thread-transfer-aggregate-class
            (tc-thread-transfer-type-class
              ctx
              env
              (ast.ty-node-get elem)
              stack
              owner-proof))
          (tc-thread-transfer-owned-heap-reject))]
      [(ast.AstType.Tuple elems)
        (tc-thread-transfer-aggregate-class
          (tc-thread-transfer-type-list-class
            ctx
            env
            (__tl-box-place elems)
            stack
            owner-proof))]
      [(ast.AstType.Array elem _)
        (tc-thread-transfer-aggregate-class
          (tc-thread-transfer-type-class
            ctx
            env
            (ast.ty-node-get elem)
            stack
            owner-proof))]
      [(ast.AstType.Struct name)
        (tc-thread-transfer-struct-class
          ctx
          env
          (tc-nominal-name-id-display name)
          name
          stack
          owner-proof)]
      [(ast.AstType.StructArgs name lifetimes)
        (if (and
          (> (tc-lifetime-list-count (__tl-box-place lifetimes)) 0)
          (not owner-proof)
          (not (tc-type-regions-all-atomic-arena-owners? env resolved)))
          (tc-thread-transfer-region-reject)
          (tc-thread-transfer-struct-class
            ctx
            env
            (tc-nominal-name-id-display name)
            name
            stack
            (or
              owner-proof
              (tc-type-regions-all-atomic-arena-owners? env resolved))))]
      [(ast.AstType.Enum name)
        (tc-thread-transfer-enum-class
          ctx
          env
          (tc-nominal-name-id-display name)
          name
          stack
          owner-proof)]
      [(ast.AstType.EnumArgs name lifetimes)
        (if (and
          (> (tc-lifetime-list-count (__tl-box-place lifetimes)) 0)
          (not owner-proof)
          (not (tc-type-regions-all-atomic-arena-owners? env resolved)))
          (tc-thread-transfer-region-reject)
          (tc-thread-transfer-enum-class
            ctx
            env
            (tc-nominal-name-id-display name)
            name
            stack
            (or
              owner-proof
              (tc-type-regions-all-atomic-arena-owners? env resolved))))]
      [(ast.AstType.Func _ _)
        (tc-thread-transfer-reject
          "function value transfer requires a direct no-capture function symbol")]
      [(ast.AstType.Expr)
        (tc-thread-transfer-reject
          "compile-time expression values cannot cross thread boundaries")]
      [(ast.AstType.ExprList)
        (tc-thread-transfer-reject
          "compile-time expression values cannot cross thread boundaries")]
      [(ast.AstType.Var _)
        (tc-thread-transfer-reject
          "unresolved type variable cannot cross thread boundaries")]
      [(ast.AstType.VarArgs _ _)
        (tc-thread-transfer-reject
          "unresolved lifetime-parameterized type cannot cross thread boundaries")]
      [_ (TcThreadTransferClass.Shareable)])))

(define (tc-thread-transfer-type-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : ast.AstType]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (tc-thread-transfer-type-class-with-stack ctx env ty stack owner-proof))

(define (tc-thread-transfer-classify-type-in-env
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : ast.AstType]) : TcThreadTransferClass
  (tc-thread-transfer-type-class ctx env ty TcStringList.Nil false))

(define (tc-region-list-atomic-arena-owners
  [env : TcTypeEnv]
  [regions : TcNameIdList]
  [out : TcNameIdList]) : TcNameIdList
  (let
    [cursor : TcNameIdList regions]
    [owners : TcNameIdList out]
    (begin
      (while (not (tc-name-id-list-empty? cursor))
        (let
          [region : i64 (tc-name-id-list-head cursor)]
          (begin
            (if (tc-atomic-arena-owner-active-id? env region)
              (set! owners (tc-name-id-list-add owners region))
              unit)
            (set! cursor (tc-name-id-list-rest cursor)))))
      owners)))

(define (tc-type-atomic-arena-owner-regions
  [env : TcTypeEnv]
  [ty : ast.AstType]) : TcNameIdList
  (tc-region-list-atomic-arena-owners
    env
    (tc-type-collect-regions ty)
    TcNameIdList.Nil))

(define (tc-thread-safe-spawn-capture-message
  [spawn-name : String]
  [ctx : TcContext]
  [name : String]
  [ty : ast.AstType]
  [reason : String]) : String
  (str_cat.str-cat
    "typecheck: "
    spawn-name
    " cannot capture `"
    name
    "` of type "
    (tc-type-render (tc-type-without-regions (tc-resolve-type ctx ty)))
    "; "
    reason))

(define (tc-check-thread-safe-spawn-captures-scan-root
  [expr-bases : i64]
  [spawn-name : String]
  [ctx : TcContext]
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [body : ast.AstExpr]) : ResultTcUnit
  (match (tc-type-env-marker-step env)
    [(TcTypeEnvMarkerStep.Done) ResultTcUnit.Ok]
    [(TcTypeEnvMarkerStep.Cache rest-env)
      (tc-check-thread-safe-spawn-captures-scan-root
        expr-bases
        spawn-name
        ctx
        root
        rest-env
        bound
        body)]
    [(TcTypeEnvMarkerStep.Bind key ty rest-env)
      (let
        [name : String
          (if (tc-env-key-has-name-id? key)
            (ci.intern-str key)
            "")]
        (cond
          [(or
              (= key (tc-region-marker-id))
              (= key (tc-default-boundary-id))
              (tc-cleanup-owner-marker-entry? key ty)
              (tc-ordinary-arena-owner-marker-entry? key ty)
              (tc-atomic-arena-owner-marker-entry? key ty)
              (not (tc-env-key-has-name-id? key)))
            (tc-check-thread-safe-spawn-captures-scan-root
              expr-bases
              spawn-name
              ctx
              root
              rest-env
              bound
              body)]
          [(not (tc-expr-uses-free-name? expr-bases body name bound))
            (tc-check-thread-safe-spawn-captures-scan-root
              expr-bases
              spawn-name
              ctx
              root
              rest-env
              bound
              body)]
          [(tc-expr-sets-free-name? expr-bases body name bound)
            (ResultTcUnit.Err
              (str_cat.str-cat
                "typecheck: "
                spawn-name
                " lambda cannot assign captured binding"))]
          [(tc-ordinary-arena-owner-active-id? root key)
            (ResultTcUnit.Err
              (str_cat.str-cat
                "typecheck: "
                spawn-name
                " cannot capture ordinary arena handle `"
                name
                "`; use arena-make-atomic for a spanning owner"))]
          [(tc-cleanup-owner-active-id? root key)
            (ResultTcUnit.Err
              (str_cat.str-cat
                "typecheck: "
                spawn-name
                " cannot capture cleanup-required resource"))]
          [else
            (match (tc-thread-transfer-classify-type-in-env ctx root ty)
              [(TcThreadTransferClass.Rejected reason)
                (ResultTcUnit.Err
                  (tc-thread-safe-spawn-capture-message
                    spawn-name
                    ctx
                    name
                    ty
                    reason))]
              [_
                (tc-check-thread-safe-spawn-captures-scan-root
                  expr-bases
                  spawn-name
                  ctx
                  root
                  rest-env
                  bound
                  body)])]))]))

(define (tc-check-thread-safe-spawn-captures
  [spawn-name : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : ast.AstParamList]
  [body : ast.AstExpr]) : ResultTcUnit
  (tc-check-thread-safe-spawn-captures-scan-root
    (tc-context-expr-bases ctx)
    spawn-name
    ctx
    env
    (tc-type-env-marker-start env)
    (tc-param-bound-names params)
    body))

(define (tc-thread-safe-spawn-captured-owner-regions-scan-root
  [expr-bases : i64]
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [body : ast.AstExpr]
  [owners : TcNameIdList]) : TcNameIdList
  (match (tc-type-env-marker-step env)
    [(TcTypeEnvMarkerStep.Done) owners]
    [(TcTypeEnvMarkerStep.Cache rest-env)
      (tc-thread-safe-spawn-captured-owner-regions-scan-root
        expr-bases
        root
        rest-env
        bound
        body
        owners)]
    [(TcTypeEnvMarkerStep.Bind key ty rest-env)
      (let
        [name : String
          (if (tc-env-key-has-name-id? key)
            (ci.intern-str key)
            "")]
        (cond
          [(or
              (= key (tc-region-marker-id))
              (= key (tc-default-boundary-id))
              (tc-cleanup-owner-marker-entry? key ty)
              (tc-ordinary-arena-owner-marker-entry? key ty)
              (tc-atomic-arena-owner-marker-entry? key ty)
              (not (tc-env-key-has-name-id? key)))
            (tc-thread-safe-spawn-captured-owner-regions-scan-root
              expr-bases
              root
              rest-env
              bound
              body
              owners)]
          [(not (tc-expr-uses-free-name? expr-bases body name bound))
            (tc-thread-safe-spawn-captured-owner-regions-scan-root
              expr-bases
              root
              rest-env
              bound
              body
              owners)]
          [else
            (tc-thread-safe-spawn-captured-owner-regions-scan-root
              expr-bases
              root
              rest-env
              bound
              body
              (tc-name-id-list-add-all
                (if (tc-atomic-arena-owner-active-id? root key)
                  (tc-name-id-list-add owners key)
                  owners)
                (tc-type-atomic-arena-owner-regions root ty)))]))]))

(define (tc-thread-safe-spawn-captured-owner-regions
  [expr-bases : i64]
  [env : TcTypeEnv]
  [params : ast.AstParamList]
  [body : ast.AstExpr]) : TcNameIdList
  (tc-thread-safe-spawn-captured-owner-regions-scan-root
    expr-bases
    env
    (tc-type-env-marker-start env)
    (tc-param-bound-names params)
    body
    TcNameIdList.Nil))

(define (tc-thread-safe-spawn-direct-lambda-owner-regions
  [expr-bases : i64]
  [env : TcTypeEnv]
  [arg : ast.AstExpr]) : TcNameIdList
  (match (ast.ast-expr-unspan arg)
    [(ast.AstExpr.Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(ast.AstLambda.Lambda params _ body-box)
          (if (= (ast.ast-param-list-len (& params)) 0)
            (tc-thread-safe-spawn-captured-owner-regions
              expr-bases
              env
              params
              (ast.ast-expr-segment-bases-get expr-bases body-box))
            TcNameIdList.Nil)])]
    [_ TcNameIdList.Nil]))

(define (tc-check-thread-safe-spawn-direct-lambda-arg
  [spawn-name : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : ast.AstExpr]) : ResultTcUnit
  (match (ast.ast-expr-unspan arg)
    [(ast.AstExpr.Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(ast.AstLambda.Lambda params _ body-box)
          (if (= (ast.ast-param-list-len (& params)) 0)
            (tc-check-thread-safe-spawn-captures
              spawn-name
              ctx
              env
              params
              (tc-context-expr-get ctx body-box))
            (ResultTcUnit.Err
              (str_cat.str-cat
                "typecheck: "
                spawn-name
                " requires a direct nullary lambda argument so captures can be checked")))])]
    [_
      (ResultTcUnit.Err
        (str_cat.str-cat
          "typecheck: "
          spawn-name
          " requires a direct nullary lambda argument so captures can be checked"))]))

(define (tc-check-thread-safe-spawn-direct-lambda
  [spawn-name : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : ast.AstExpr]) : ResultTcUnit
  (match (tc-active-region env)
    [(TcMaybeNameId.Some region)
      (if (tc-atomic-arena-owner-active-id? env region)
        (tc-check-thread-safe-spawn-direct-lambda-arg spawn-name ctx env arg)
        (ResultTcUnit.Err
          (str_cat.str-cat
            "typecheck: "
            spawn-name
            " cannot spawn from scoped arena; closure storage would not outlive the worker")))]
    [(TcMaybeNameId.No)
      (tc-check-thread-safe-spawn-direct-lambda-arg spawn-name ctx env arg)]))

(define (tc-check-thread-safe-spawn-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [ret : ast.AstType]) : ResultTcNameIdList
  (match (tc-thread-safe-spawn-call-name ctx env func)
    [(TcMaybeString.Some source-name)
      (let
        [source-id : i64
          (macro-hygiene-global-source-name-id-or
            (tc-expr-var-name-id func)
            (tc-expr-var-name-id func))]
        [lookup-name : String
          (tc-thread-spawn-lookup-name ctx env source-name source-id)]
        (if (tc-thread-safe-spawn-signature?
          ctx
          source-name
          lookup-name
          params
          ret)
          (if (= args.len 1)
            (let
              [arg : ast.AstExpr
                (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
              (match (tc-check-thread-safe-spawn-direct-lambda
                source-name
                ctx
                env
                arg)
                [(ResultTcUnit.Ok)
                  (ResultTcNameIdList.Ok
                    (tc-thread-safe-spawn-direct-lambda-owner-regions
                      (tc-context-expr-bases ctx)
                      env
                      arg))]
                [(ResultTcUnit.Err message) (ResultTcNameIdList.Err message)]))
            (ResultTcNameIdList.Err
              (str_cat.str-cat
                "typecheck: "
                source-name
                " expects one argument")))
          (ResultTcNameIdList.Ok TcNameIdList.Nil)))]
    [(TcMaybeString.No) (ResultTcNameIdList.Ok TcNameIdList.Nil)]))

(define (tc-thread-channel-send-message
  [send-name : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [message-ty : ast.AstType]) : ResultTcUnit
  (match (tc-thread-transfer-classify-type-in-env ctx env message-ty)
    [(TcThreadTransferClass.Rejected reason)
      (ResultTcUnit.Err
        (str_cat.str-cat
          "typecheck: "
          send-name
          " cannot send value of type "
          (tc-type-render
            (tc-type-without-regions (tc-resolve-type ctx message-ty)))
          "; "
          reason))]
    [_ ResultTcUnit.Ok]))

(define (tc-check-thread-channel-send-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [ret : ast.AstType]) : ResultTcUnit
  (match (tc-thread-channel-send-call-name ctx func)
    [(TcMaybeString.Some send-name)
      (if (tc-thread-channel-send-result-type? ctx ret)
        (match (tc-thread-channel-send-message-param params)
          [(ResultTcType.Ok _)
            (match (tc-thread-channel-send-message-arg args)
              [(ResultTcExpr.Ok message-expr)
                (match (tc-expr ctx env message-expr)
                  [(ResultTcType.Ok message-ty)
                    (tc-thread-channel-send-message
                      send-name
                      ctx
                      env
                      message-ty)]
                  [(ResultTcType.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcExpr.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcType.Err message) (ResultTcUnit.Err message)])
        ResultTcUnit.Ok)]
    [(TcMaybeString.No) ResultTcUnit.Ok]))

(define (tc-thread-channel-send-function-result?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]) : bool
  (match (tc-expr ctx env func)
    [(ResultTcType.Ok fn-ty)
      (match (tc-type-strip-region fn-ty)
        [(ast.AstType.Func _ ret-box)
          (tc-thread-channel-send-result-type? ctx (ast.ty-node-get ret-box))]
        [_ false])]
    [(ResultTcType.Err _) false]))

(define (tc-thread-channel-send-call?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]) : bool
  (match (tc-thread-channel-send-call-name ctx func)
    [(TcMaybeString.Some _)
      (tc-thread-channel-send-function-result? ctx env func)]
    [(TcMaybeString.No) false]))

(define (tc-thread-safe-spawn-call-signature?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [params : ast.AstTypeList]) : bool
  (match (tc-thread-safe-spawn-call-name ctx env func)
    [(TcMaybeString.Some source-name)
      (let
        [source-id : i64
          (macro-hygiene-global-source-name-id-or
            (tc-expr-var-name-id func)
            (tc-expr-var-name-id func))]
        [lookup-name : String
          (tc-thread-spawn-lookup-name ctx env source-name source-id)]
        (match (tc-expr ctx env func)
          [(ResultTcType.Ok fn-ty)
            (match (tc-type-strip-region fn-ty)
              [(ast.AstType.Func _ ret-box)
                (tc-thread-safe-spawn-signature?
                  ctx
                  source-name
                  lookup-name
                  params
                  (ast.ty-node-get ret-box))]
              [_ false])]
          [(ResultTcType.Err _) false]))]
    [(TcMaybeString.No) false]))

(define (tc-call-function-type-normal
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [ret : ast.AstType]
  [c-abi-args : bool]) : ResultTcType
  (let
    [allow-region-args : bool
      (tc-call-region-args-allowed-for-func ctx env func)]
    (if (tc-call-lifetime-constructor-for-func? ctx func ret)
      (tc-call-lifetime-constructor-type
        ctx
        env
        func
        args
        params
        ret
        allow-region-args)
      (let
        [constructor-target : ast.AstMaybeType
          (tc-call-constructor-target-for-func ctx env func params ret)]
        (match constructor-target
          [(ast.AstMaybeType.Some _)
            (match (tc-check-call-args
              ctx
              env
              func
              args
              params
              allow-region-args
              constructor-target
              c-abi-args)
              [(ResultTcUnit.Ok)
                (match constructor-target
                  [(ast.AstMaybeType.Some target) (ResultTcType.Ok target)]
                  [(ast.AstMaybeType.No)
                    (ResultTcType.Ok (tc-tag-active-region env ret))])]
              [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
          [(ast.AstMaybeType.No)
            (let
              [lifetimes : ast.AstLifetimeList
                (tc-call-function-lifetimes params ret)]
              [thread-spawn-args : bool
                (tc-thread-safe-spawn-call-signature? ctx env func params)]
              (if (ast.ast-lifetime-list-empty? (& lifetimes))
                (match (if thread-spawn-args
                  (tc-check-thread-spawn-args-with-message
                    ctx
                    env
                    args
                    params
                    allow-region-args
                    constructor-target
                    (TcArityMessage.Detailed func args params)
                    c-abi-args)
                  (tc-check-call-args-with-message
                    ctx
                    env
                    args
                    params
                    allow-region-args
                    constructor-target
                    (TcArityMessage.Detailed func args params)
                    c-abi-args))
                  [(ResultTcUnit.Ok)
                    (match (tc-check-thread-safe-spawn-call
                      ctx
                      env
                      func
                      args
                      params
                      ret)
                      [(ResultTcNameIdList.Ok spawn-owner-regions)
                        (match (tc-check-thread-channel-send-call
                          ctx
                          env
                          func
                          args
                          params
                          ret)
                          [(ResultTcUnit.Ok)
                            (ResultTcType.Ok
                              (tc-tag-regions
                                spawn-owner-regions
                                (tc-tag-active-region env ret)))]
                          [(ResultTcUnit.Err message)
                            (ResultTcType.Err message)])]
                      [(ResultTcNameIdList.Err message)
                        (ResultTcType.Err message)])]
                  [(ResultTcUnit.Err message) (ResultTcType.Err message)])
                (tc-call-lifetime-function-type
                  ctx
                  env
                  func
                  args
                  params
                  ret
                  lifetimes
                  allow-region-args
                  c-abi-args)))])))))

(define (tc-check-call-args-with-message
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [allow-region-args : bool]
  [constructor-target : ast.AstMaybeType]
  [arity-msg : TcArityMessage]
  [c-abi-args : bool]) : ResultTcUnit
  (match (tc-normalize-dotted-local-field-expr-list! ctx env args)
    [(ResultTcUnit.Ok)
      (tc-check-call-args-with-message-at
        ctx
        env
        (& args)
        (& params)
        0
        allow-region-args
        constructor-target
        arity-msg
        c-abi-args
        false)]
    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))

(define (tc-check-thread-spawn-args-with-message
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [allow-region-args : bool]
  [constructor-target : ast.AstMaybeType]
  [arity-msg : TcArityMessage]
  [c-abi-args : bool]) : ResultTcUnit
  (match (tc-normalize-dotted-local-field-expr-list! ctx env args)
    [(ResultTcUnit.Ok)
      (tc-check-call-args-with-message-at
        ctx
        env
        (& args)
        (& params)
        0
        allow-region-args
        constructor-target
        arity-msg
        c-abi-args
        true)]
    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))

;; Call-only compatibility extensions. Keep ordinary inferred-type matching
;; unchanged, then admit the closed whole-array reference unsize and an owned
;; String temporary passed to a borrowed str formal. The effective-argument
;; pass has already rejected non-place values of every other referent type.
(define (tc-match-call-type-for-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [actual : ast.AstType]
  [expected : ast.AstType]) : TcInferredTypeMatch
  (match (tc-match-inferred-type-for-expected ctx env actual expected)
    [(TcInferredTypeMatch.Compatible matched)
      (TcInferredTypeMatch.Compatible matched)]
    [(TcInferredTypeMatch.Mismatch mismatched)
      (if (or
        (tc-call-array-ref-to-slice-ref-compatible? ctx expected actual)
        (tc-call-string-temporary-ref-compatible? ctx expected actual))
        (TcInferredTypeMatch.Compatible actual)
        (TcInferredTypeMatch.Mismatch mismatched))]))

(define (tc-check-call-args-with-message-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [params : (& params ast.AstTypeList)]
  [index : i64]
  [allow-region-args : bool]
  [constructor-target : ast.AstMaybeType]
  [arity-msg : TcArityMessage]
  [c-abi-args : bool]
  [thread-spawn-args : bool]) : ResultTcUnit
  (if (>= index args.len)
    (if (>= index (ast.ast-type-list-len params))
      ResultTcUnit.Ok
      (ResultTcUnit.Err (tc-arity-message-text arity-msg)))
    (if (>= index (ast.ast-type-list-len params))
      (ResultTcUnit.Err (tc-arity-message-text arity-msg))
      (let
        [arg : ast.AstExpr
          (tc-context-expr-get ctx (ast.ast-expr-list-get args index 0))]
        [want : ast.AstType
          (ast.ast-type-strip-consuming-param-with-pools
            (tc-context-pools ctx)
            (ast.ty-node-get
              (ast.ast-type-list-get params index (ast.ast-type-id-fallback))))]
        (match (tc-call-effective-arg-expr ctx env arg want)
          [(ResultTcExpr.Ok effective-arg)
            (let
              [typed-arg : ResultTcType
                (match constructor-target
                  [(ast.AstMaybeType.No)
                    (if thread-spawn-args
                      (tc-expr-with-expected-or-actual-thread-spawn-arg
                        ctx
                        env
                        effective-arg
                        want)
                      (tc-expr-with-expected-or-actual-call-arg
                        ctx
                        env
                        effective-arg
                        want))]
                  [(ast.AstMaybeType.Some _)
                    (tc-expr-with-expected-or-actual ctx env effective-arg want)])]
              (match typed-arg
                [(ResultTcType.Ok got)
                  (let
                    [matched-got : TcInferredTypeMatch
                      (tc-match-call-type-for-expected ctx env got want)]
                    [expect-result : ResultTcUnit
                      (match matched-got
                        [(TcInferredTypeMatch.Compatible _) ResultTcUnit.Ok]
                        [(TcInferredTypeMatch.Mismatch actual)
                          (ResultTcUnit.Err
                            (tc-locate-error-at-expr
                              arg
                              (tc-type-mismatch-message-in-context
                                ctx
                                env
                                actual
                                want
                                (tc-argument-message-prefix-text
                                  ctx
                                  arity-msg
                                  index))))])]
                    (match expect-result
                      [(ResultTcUnit.Ok)
                        (match (tc-raw-c-fnptr-flow-ok
                          ctx
                          env
                          effective-arg
                          want
                          c-abi-args)
                          [(ResultTcUnit.Ok)
                            (if (and
                              (tc-type-contains-any-region got)
                              (not allow-region-args)
                              (not
                                (tc-type-regions-all-atomic-arena-owners?
                                  env
                                  got))
                              (not (tc-type-contains-reference? got)))
                              (ResultTcUnit.Err
                                (tc-region-call-arg-error effective-arg))
                              (match constructor-target
                                [(ast.AstMaybeType.Some target)
                                  (match (tc-ensure-cleanup-resource-not-stored-expr
                                    env
                                    effective-arg)
                                    [(ResultTcUnit.Ok)
                                      (match (tc-ensure-region-value-can-flow-into
                                        env
                                        target
                                        got
                                        "constructor result")
                                        [(ResultTcUnit.Ok)
                                          (tc-check-call-args-with-message-at
                                            ctx
                                            env
                                            args
                                            params
                                            (+ index 1)
                                            allow-region-args
                                            constructor-target
                                            arity-msg
                                            c-abi-args
                                            thread-spawn-args)]
                                        [(ResultTcUnit.Err message)
                                          (ResultTcUnit.Err message)])]
                                    [(ResultTcUnit.Err message)
                                      (ResultTcUnit.Err message)])]
                                [(ast.AstMaybeType.No)
                                  (tc-check-call-args-with-message-at
                                    ctx
                                    env
                                    args
                                    params
                                    (+ index 1)
                                    allow-region-args
                                    constructor-target
                                    arity-msg
                                    c-abi-args
                                    thread-spawn-args)]))]
                          [(ResultTcUnit.Err message)
                            (ResultTcUnit.Err message)])]
                      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
                [(ResultTcType.Err message) (ResultTcUnit.Err message)]))]
          [(ResultTcExpr.Err message)
            (ResultTcUnit.Err (tc-locate-error-at-expr arg message))])))))

(define (tc-check-call-args
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [allow-region-args : bool]
  [constructor-target : ast.AstMaybeType]
  [c-abi-args : bool]) : ResultTcUnit
  (tc-check-call-args-with-message
    ctx
    env
    args
    params
    allow-region-args
    constructor-target
    (TcArityMessage.Detailed func args params)
    c-abi-args))

(define (tc-call-expr-ordinary
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcType
  (match (ast.ast-expr-unspan func)
    [(ast.AstExpr.Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(ast.AstLambda.Lambda params maybe-ret body-box)
          (let
            [body : ast.AstExpr (tc-context-expr-get ctx body-box)]
            (match (tc-lambda-expr-allow-ref-captures
              ctx
              env
              params
              maybe-ret
              body)
              [(ResultTcType.Ok fn-ty)
                (match fn-ty
                  [(ast.AstType.Func params ret)
                    (tc-call-function-type
                      ctx
                      env
                      func
                      args
                      (__tl-box-place params)
                      (ast.ty-node-get ret))]
                  [_
                    (ResultTcType.Err
                      "typecheck: call target is not a function")])]
              [(ResultTcType.Err message) (ResultTcType.Err message)]))])]
    [_
      (match (tc-expr ctx env func)
        [(ResultTcType.Ok fn-ty)
          (match fn-ty
            [(ast.AstType.Func params ret)
              (tc-call-function-type
                ctx
                env
                func
                args
                (__tl-box-place params)
                (ast.ty-node-get ret))]
            [(ast.AstType.Region _ inner)
              (match (ast.ty-node-get inner)
                [(ast.AstType.Func params ret)
                  (match (tc-check-call-args-with-message
                    ctx
                    env
                    args
                    (__tl-box-place params)
                    false
                    (ast.AstMaybeType.No)
                    (TcArityMessage.Detailed func args (__tl-box-place params))
                    (tc-expr-c-abi-fnptr? ctx env func))
                    [(ResultTcUnit.Ok)
                      (ResultTcType.Ok
                        (tc-tag-active-region env (ast.ty-node-get ret)))]
                    [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                [(ast.AstType.Enum enum-name)
                  (if (ast.ast-expr-list-empty? (& args))
                    (tc-nullary-variant-call-expr
                      ctx
                      env
                      func
                      enum-name
                      (ast.ty-node-get inner))
                    (ResultTcType.Err (tc-call-fixed-arity-message func args 0)))]
                [(ast.AstType.EnumArgs enum-name _)
                  (if (ast.ast-expr-list-empty? (& args))
                    (tc-nullary-variant-call-expr
                      ctx
                      env
                      func
                      enum-name
                      (ast.ty-node-get inner))
                    (ResultTcType.Err (tc-call-fixed-arity-message func args 0)))]
                [_
                  (ResultTcType.Err "typecheck: call target is not a function")])]
            [(ast.AstType.Enum enum-name)
              (if (ast.ast-expr-list-empty? (& args))
                (tc-nullary-variant-call-expr ctx env func enum-name fn-ty)
                (ResultTcType.Err (tc-call-fixed-arity-message func args 0)))]
            [(ast.AstType.EnumArgs enum-name _)
              (if (ast.ast-expr-list-empty? (& args))
                (tc-nullary-variant-call-expr ctx env func enum-name fn-ty)
                (ResultTcType.Err (tc-call-fixed-arity-message func args 0)))]
            [_ (ResultTcType.Err "typecheck: call target is not a function")])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]))

(define (tc-phase-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 1)
    (let
      [owner-expr : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      (match (tc-expr ctx env owner-expr)
        [(ResultTcType.Ok owner-ty)
          (if (tc-arena-type? ctx owner-ty)
            (let
              [oid : i64 (tc-expr-var-name-id owner-expr)]
              (if (>= oid 0)
                (if (or
                  (tc-ordinary-arena-owner-active-id? env oid)
                  (tc-atomic-arena-owner-active-id? env oid))
                  (match (tc-expr ctx env func)
                    [(ResultTcType.Ok (ast.AstType.Func _ ret))
                      (ResultTcType.Ok (ast.ty-node-get ret))]
                    [(ResultTcType.Ok _)
                      (ResultTcType.Err
                        "typecheck: arena.phase target is not a function")]
                    [(ResultTcType.Err message) (ResultTcType.Err message)])
                  (ResultTcType.Err
                    (tc-locate-error-at-expr
                      owner-expr
                      "typecheck: arena.phase requires a direct arena owner")))
                (ResultTcType.Err
                  (tc-locate-error-at-expr
                    owner-expr
                    "typecheck: arena.phase requires a direct arena owner"))))
            (ResultTcType.Err
              (tc-locate-error-at-expr
                owner-expr
                "typecheck: arena.phase arena must be Arena")))]
        [(ResultTcType.Err message) (ResultTcType.Err message)]))
    (ResultTcType.Err "typecheck: arena.phase expects exactly one argument")))

(define (tc-rewind-safe-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 1)
    (let
      [phase-expr : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      (match (tc-expr ctx env phase-expr)
        [(ResultTcType.Ok phase-ty)
          (if (tc-arena-phase-type? ctx phase-ty)
            (let
              [pid : i64 (tc-expr-var-name-id phase-expr)]
              (if (>= pid 0)
                (match (tc-arena-phase-token-region-active env pid)
                  [(TcMaybeNameId.Some _)
                    (match (tc-arena-phase-token-owner-active env pid)
                      [(TcMaybeNameId.Some owner)
                        (if (tc-active-region-owned-by-arena-id? env owner)
                          (ResultTcType.Err
                            (tc-locate-error-at-expr
                              phase-expr
                              "typecheck: arena.rewind-safe! cannot run inside the arena it rewinds"))
                          (ResultTcType.Ok (ast.AstType.Unit)))]
                      [(TcMaybeNameId.No) (ResultTcType.Ok (ast.AstType.Unit))])]
                  [(TcMaybeNameId.No)
                    (ResultTcType.Err
                      (tc-locate-error-at-expr
                        phase-expr
                        "typecheck: arena.rewind-safe! requires a direct arena phase token"))])
                (ResultTcType.Err
                  (tc-locate-error-at-expr
                    phase-expr
                    "typecheck: arena.rewind-safe! requires a direct arena phase token"))))
            (ResultTcType.Err
              (tc-locate-error-at-expr
                phase-expr
                "typecheck: arena.rewind-safe! phase must be ArenaPhase")))]
        [(ResultTcType.Err message) (ResultTcType.Err message)]))
    (ResultTcType.Err
      "typecheck: arena.rewind-safe! expects exactly one argument")))

(define (tc-destroy-safe-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : ast.AstExprList]) : ResultTcType
  (unless
    (= args.len 1)
    (return
      (ResultTcType.Err
        "typecheck: arena.destroy-safe! expects exactly one argument")))
  (let
    [owner-expr : ast.AstExpr
      (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
    (match (tc-expr ctx env owner-expr)
      [(ResultTcType.Ok owner-ty)
        (begin
          (unless
            (tc-arena-type? ctx owner-ty)
            (return
              (ResultTcType.Err
                (tc-locate-error-at-expr
                  owner-expr
                  "typecheck: arena.destroy-safe! arena must be Arena"))))
          (let
            [oid : i64 (tc-expr-var-name-id owner-expr)]
            (unless
              (and
                (>= oid 0)
                (or
                  (tc-ordinary-arena-owner-active-id? env oid)
                  (tc-atomic-arena-owner-active-id? env oid)))
              (return
                (ResultTcType.Err
                  (tc-locate-error-at-expr
                    owner-expr
                    "typecheck: arena.destroy-safe! requires a direct arena owner"))))
            (if (tc-active-region-owned-by-arena-id? env oid)
              (ResultTcType.Err
                (tc-locate-error-at-expr
                  owner-expr
                  "typecheck: arena.destroy-safe! cannot run inside the arena it destroys"))
              (ResultTcType.Ok (ast.AstType.Unit)))))]
      [(ResultTcType.Err message) (ResultTcType.Err message)])))

(define (tc-call-expr-ordinary-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]
  [args : ast.AstExprList]) : ResultTcType
  (let
    [func : ast.AstExpr (tc-context-expr-get ctx func-id)]
    (match (ast.ast-expr-unspan func)
      [(ast.AstExpr.Lambda lambda-box)
        (match (__tl-box-place lambda-box)
          [(ast.AstLambda.Lambda params maybe-ret body-box)
            (let
              [body : ast.AstExpr (tc-context-expr-get ctx body-box)]
              (match (tc-lambda-expr-allow-ref-captures
                ctx
                env
                params
                maybe-ret
                body)
                [(ResultTcType.Ok fn-ty)
                  (begin
                    (tc-body-type-fact-record!
                      (tc-context-body-state ctx)
                      func-id
                      fn-ty)
                    (match fn-ty
                      [(ast.AstType.Func params ret)
                        (tc-call-function-type
                          ctx
                          env
                          func
                          args
                          (__tl-box-place params)
                          (ast.ty-node-get ret))]
                      [_
                        (ResultTcType.Err
                          "typecheck: call target is not a function")]))]
                [(ResultTcType.Err message) (ResultTcType.Err message)]))])]
      [_
        (match (tc-expr-id ctx env func-id)
          [(ResultTcType.Ok fn-ty)
            (match fn-ty
              [(ast.AstType.Func params ret)
                (tc-call-function-type
                  ctx
                  env
                  func
                  args
                  (__tl-box-place params)
                  (ast.ty-node-get ret))]
              [(ast.AstType.Region _ inner)
                (match (ast.ty-node-get inner)
                  [(ast.AstType.Func params ret)
                    (match (tc-check-call-args-with-message
                      ctx
                      env
                      args
                      (__tl-box-place params)
                      false
                      (ast.AstMaybeType.No)
                      (TcArityMessage.Detailed
                        func
                        args
                        (__tl-box-place params))
                      (tc-expr-c-abi-fnptr? ctx env func))
                      [(ResultTcUnit.Ok)
                        (ResultTcType.Ok
                          (tc-tag-active-region env (ast.ty-node-get ret)))]
                      [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                  [(ast.AstType.Enum enum-name)
                    (if (ast.ast-expr-list-empty? (& args))
                      (tc-nullary-variant-call-expr
                        ctx
                        env
                        func
                        enum-name
                        (ast.ty-node-get inner))
                      (ResultTcType.Err
                        (tc-call-fixed-arity-message func args 0)))]
                  [(ast.AstType.EnumArgs enum-name _)
                    (if (ast.ast-expr-list-empty? (& args))
                      (tc-nullary-variant-call-expr
                        ctx
                        env
                        func
                        enum-name
                        (ast.ty-node-get inner))
                      (ResultTcType.Err
                        (tc-call-fixed-arity-message func args 0)))]
                  [_
                    (ResultTcType.Err
                      "typecheck: call target is not a function")])]
              [(ast.AstType.Enum enum-name)
                (if (ast.ast-expr-list-empty? (& args))
                  (tc-nullary-variant-call-expr ctx env func enum-name fn-ty)
                  (ResultTcType.Err (tc-call-fixed-arity-message func args 0)))]
              [(ast.AstType.EnumArgs enum-name _)
                (if (ast.ast-expr-list-empty? (& args))
                  (tc-nullary-variant-call-expr ctx env func enum-name fn-ty)
                  (ResultTcType.Err (tc-call-fixed-arity-message func args 0)))]
              [_ (ResultTcType.Err "typecheck: call target is not a function")])]
          [(ResultTcType.Err message) (ResultTcType.Err message)])])))

(define (tc-arena-owner-call-type-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]
  [args : ast.AstExprList]
  [kind : i64]) : ResultTcType
  ;; Preserve ordinary lookup, arity, and shadowing diagnostics. Only a call
  ;; that really resolves to the canonical zero-argument constructor gets its
  ;; otherwise-bare result refined with the call-site brand.
  (match (tc-call-expr-ordinary-id ctx env func-id args)
    [(ResultTcType.Ok ty)
      (if (tc-arena-type? ctx ty)
        (ResultTcType.Ok (tc-arena-branded-type kind func-id))
        (ResultTcType.Ok ty))]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (tc-str-ref-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(ast.AstType.Ref _ inner)
      (match (tc-type-strip-region (ast.ty-node-get inner))
        [(ast.AstType.Str) true]
        [_ false])]
    [_ false]))

(define (tc-string-handle-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(ast.AstType.String) true]
    [_ (tc-str-ref-type? ty)]))

(define (tc-bytes-ref-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(ast.AstType.Ref _ inner)
      (match (tc-type-strip-region (ast.ty-node-get inner))
        [(ast.AstType.Bytes) true]
        [_ false])]
    [(ast.AstType.MutRef _ inner)
      (match (tc-type-strip-region (ast.ty-node-get inner))
        [(ast.AstType.Bytes) true]
        [_ false])]
    [_ false]))

(define (tc-bytes-handle-type? [ty : ast.AstType]) : bool
  (tc-bytes-ref-type? ty))

(define (tc-length-handle-type? [ty : ast.AstType]) : bool
  (or (tc-string-handle-type? ty) (tc-bytes-handle-type? ty)))

(define (tc-check-string-handle-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [index : i64]
  [arg : ast.AstExpr]) : ResultTcUnit
  (match (tc-expr ctx env arg)
    [(ResultTcType.Ok arg-ty)
      (if (tc-string-handle-type? arg-ty)
        ResultTcUnit.Ok
        (ResultTcUnit.Err
          (tc-locate-error-at-expr
            arg
            (tc-call-argument-expected-text-message
              ctx
              func
              index
              arg-ty
              "String or (& str)"))))]
    [(ResultTcType.Err message) (ResultTcUnit.Err message)]))

(define (tc-check-length-handle-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [index : i64]
  [arg : ast.AstExpr]) : ResultTcUnit
  (match (tc-expr ctx env arg)
    [(ResultTcType.Ok arg-ty)
      (if (tc-length-handle-type? arg-ty)
        ResultTcUnit.Ok
        (ResultTcUnit.Err
          (tc-locate-error-at-expr
            arg
            (tc-call-argument-expected-text-message
              ctx
              func
              index
              arg-ty
              "String, (& str), (& bytes), or (&mut bytes)"))))]
    [(ResultTcType.Err message) (ResultTcUnit.Err message)]))

(define (tc-check-exact-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : ast.AstExpr]
  [want : ast.AstType]
  [message : String]) : ResultTcUnit
  (match (tc-expr-with-expected-or-actual ctx env arg want)
    [(ResultTcType.Ok arg-ty) (tc-expect-at-expr arg arg-ty want message)]
    [(ResultTcType.Err message) (ResultTcUnit.Err message)]))

(define (tc-one-string-handle-builtin-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [ret : ast.AstType]) : ResultTcType
  (if (= args.len 1)
    (let
      [arg : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      (match (tc-check-string-handle-arg ctx env func 0 arg)
        [(ResultTcUnit.Ok) (ResultTcType.Ok (tc-tag-active-region env ret))]
        [(ResultTcUnit.Err message) (ResultTcType.Err message)]))
    (ResultTcType.Err (tc-call-fixed-arity-message func args 1))))

(define (tc-one-length-handle-builtin-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [ret : ast.AstType]) : ResultTcType
  (if (= args.len 1)
    (let
      [arg : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      (match (tc-check-length-handle-arg ctx env func 0 arg)
        [(ResultTcUnit.Ok) (ResultTcType.Ok (tc-tag-active-region env ret))]
        [(ResultTcUnit.Err message) (ResultTcType.Err message)]))
    (ResultTcType.Err (tc-call-fixed-arity-message func args 1))))

(define (tc-two-string-handle-builtin-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [ret : ast.AstType]) : ResultTcType
  (if (= args.len 2)
    (let
      [left : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [right : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 1 0))]
      (match (tc-check-string-handle-arg ctx env func 0 left)
        [(ResultTcUnit.Ok)
          (match (tc-check-string-handle-arg ctx env func 1 right)
            [(ResultTcUnit.Ok) (ResultTcType.Ok (tc-tag-active-region env ret))]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
        [(ResultTcUnit.Err message) (ResultTcType.Err message)]))
    (ResultTcType.Err (tc-call-fixed-arity-message func args 2))))

(define (tc-string-length-helper-call-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-id : i64]
  [lookup-id : i64]) : bool
  (or
    (and
      (cbi.compiler-builtin-typecheck-string-length-id? lookup-id)
      (tc-private-intrinsic-unshadowed-id?
        ctx
        env
        (tc-env-name-key-id lookup-id)))
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      source-id
      (cbi.compiler-builtin-typecheck-public-string-length-id? source-id)
      lookup-id
      cbi.compiler-builtin-id-string-length
      "string-length")))

(define (tc-string-ref-helper-call-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-id : i64]
  [lookup-id : i64]) : bool
  (or
    (and
      (cbi.compiler-builtin-typecheck-string-ref-call-id? lookup-id)
      (tc-private-intrinsic-unshadowed-id?
        ctx
        env
        (tc-env-name-key-id lookup-id)))
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      source-id
      (and
        (cbi.compiler-builtin-typecheck-public-string-ref-id? source-id)
        (not (cbi.compiler-builtin-typecheck-public-char-at-id? source-id)))
      lookup-id
      cbi.compiler-builtin-id-string-ref
      "string-ref")
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      source-id
      (cbi.compiler-builtin-typecheck-public-char-at-id? source-id)
      lookup-id
      cbi.compiler-builtin-id-char-at
      "char-at")))

(define (tc-string-eq-helper-call-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-id : i64]
  [lookup-id : i64]) : bool
  (or
    (and
      (cbi.compiler-builtin-typecheck-string-eq-id? lookup-id)
      (tc-private-intrinsic-unshadowed-id? ctx env lookup-id))
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      source-id
      (= source-id cbi.compiler-builtin-id-eq)
      lookup-id
      cbi.compiler-builtin-id-eq
      "eq")
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      source-id
      (and
        (cbi.compiler-builtin-typecheck-public-string-eq-id? source-id)
        (not
          (cbi.compiler-builtin-typecheck-public-string-eq-question-id?
            source-id)))
      lookup-id
      cbi.compiler-builtin-id-string-eq
      "string-eq")
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      source-id
      (cbi.compiler-builtin-typecheck-public-string-eq-question-id? source-id)
      lookup-id
      cbi.compiler-builtin-id-string-eq-question
      "string=?")))

(define (tc-string-copy-helper-call-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-id : i64]
  [lookup-id : i64]) : bool
  (or
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      source-id
      (= source-id cbi.compiler-builtin-id-string-append)
      lookup-id
      cbi.compiler-builtin-id-string-append
      "string-append")
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      source-id
      (= source-id cbi.compiler-builtin-id-string-concat)
      lookup-id
      cbi.compiler-builtin-id-string-concat
      "string-concat")))

(define (tc-string-to-int-helper-call-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [lookup-id : i64]) : bool
  (and
    (cbi.compiler-builtin-typecheck-string-to-int-id? lookup-id)
    (tc-private-intrinsic-unshadowed-id? ctx env lookup-id)))

(define (tc-borrowed-string-builtin-id? [name-id : i64]) : bool
  (cbi.compiler-builtin-typecheck-borrowed-string-id? name-id))

(define (tc-borrowed-string-builtin-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [name-id : i64]
  [args : ast.AstExprList]) : ResultTcType
  (if (cbi.compiler-builtin-typecheck-string-eq-id? name-id)
    (tc-two-string-handle-builtin-call ctx env func args (ast.AstType.Bool))
    (if (cbi.compiler-builtin-typecheck-string-to-int-id? name-id)
      (tc-one-string-handle-builtin-call ctx env func args (ast.AstType.I64))
      (ResultTcType.Err "typecheck: unknown borrowed string builtin"))))

;; Typecheck the private `(__tl_string_ref s i)` intrinsic: a String plus any
;; integer index, yielding `char`. Public `string-ref` and `char-at` live in
;; stdlib/string.tl and lower through this private operation.
(define (tc-string-ref-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 2)
    (let
      [str : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [index : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 1 0))]
      (match (tc-expr ctx env str)
        [(ResultTcType.Ok str-ty)
          (if (tc-string-handle-type? str-ty)
            (match (tc-expr ctx env index)
              [(ResultTcType.Ok index-ty)
                (if (tc-integer-type? index-ty)
                  (ResultTcType.Ok (ast.AstType.Char))
                  (ResultTcType.Err
                    (tc-locate-error-at-expr
                      index
                      (tc-call-argument-expected-text-message
                        ctx
                        func
                        1
                        index-ty
                        "integer"))))]
              [(ResultTcType.Err message) (ResultTcType.Err message)])
            (ResultTcType.Err
              (tc-locate-error-at-expr
                str
                (tc-call-argument-expected-text-message
                  ctx
                  func
                  0
                  str-ty
                  "String or (& str)"))))]
        [(ResultTcType.Err message) (ResultTcType.Err message)]))
    (ResultTcType.Err (tc-call-fixed-arity-message func args 2))))

(define (tc-length-string-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [arg-ty : ast.AstType]) : ResultTcType
  (let
    [public-helper : bool
      (tc-string-length-helper-call-id? ctx env name-id name-id)]
    [private-helper : bool
      (cbi.compiler-builtin-typecheck-string-length-id? name-id)]
    [unshadowed : bool (tc-default-builtin-unshadowed-id? env name-id)]
    (begin
      (when
        (and (or public-helper unshadowed) (tc-length-handle-type? arg-ty))
        (return (ResultTcType.Ok (ast.AstType.I64))))
      (unless private-helper (return (tc-call-expr-ordinary ctx env func args)))
      (unless
        (or public-helper unshadowed)
        (return (tc-call-expr-ordinary ctx env func args)))
      (if (tc-length-handle-type? arg-ty)
        (ResultTcType.Ok (ast.AstType.I64))
        (let
          [arg : ast.AstExpr
            (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
          (ResultTcType.Err
            (tc-locate-error-at-expr
              arg
              (tc-call-argument-expected-text-message
                ctx
                func
                0
                arg-ty
                "String, (& str), (& bytes), or (&mut bytes)"))))))))

(define (tc-array-length-non-array-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [arg-ty : ast.AstType]) : ResultTcType
  (if (cbi.compiler-builtin-typecheck-array-length-id? name-id)
    (if (and
      (tc-type-eq (tc-type-strip-region arg-ty) (ast.AstType.Expr))
      (tc-source-value-bound-id? ctx env name-id))
      (ResultTcType.Ok (ast.AstType.I64))
      (ResultTcType.Err
        "typecheck: array-length requires dynamic array or borrowed Slice"))
    (tc-length-string-call ctx env name-id func args arg-ty)))

(define (tc-array-length-array-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [arg-ty : ast.AstType]) : ResultTcType
  (if (cbi.compiler-builtin-typecheck-string-length-id? name-id)
    (if (tc-default-builtin-unshadowed-id? env name-id)
      (let
        [arg : ast.AstExpr
          (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
        (ResultTcType.Err
          (tc-locate-error-at-expr
            arg
            (tc-call-argument-expected-text-message
              ctx
              func
              0
              arg-ty
              "String or (& str)"))))
      (tc-call-expr-ordinary ctx env func args))
    (ResultTcType.Ok (ast.AstType.I64))))

(define (tc-array-length-receiver [ctx : TcContext] [receiver-ty : ast.AstType]) : ResultTcArrayReceiver
  (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
    [(ast.AstType.DynArray elem-ty)
      (ResultTcArrayReceiver.Ok
        (TcArrayReceiver receiver-ty (ast.ty-node-get elem-ty)))]
    [(ast.AstType.Ref _ referent-ty)
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-context-type-get ctx referent-ty)))
        [(ast.AstType.Slice elem-ty)
          (ResultTcArrayReceiver.Ok
            (TcArrayReceiver receiver-ty (ast.ty-node-get elem-ty)))]
        [_ (tc-array-length-receiver ctx (ast.ty-node-get referent-ty))])]
    [(ast.AstType.MutRef _ referent-ty)
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-context-type-get ctx referent-ty)))
        [(ast.AstType.Slice elem-ty)
          (ResultTcArrayReceiver.Ok
            (TcArrayReceiver receiver-ty (ast.ty-node-get elem-ty)))]
        [_ (tc-array-length-receiver ctx (ast.ty-node-get referent-ty))])]
    [_
      (ResultTcArrayReceiver.Err
        "typecheck: array-length requires dynamic array or borrowed Slice")]))

;; Runtime `array-length` remains dynamic-array-only. Macro helper environments
;; bind `array-length` for Expr operands so CTFE can validate fixed-array type
;; reflection.
;; Core `length` accepts arrays and string/bytes handles. The stdlib
;; `string-length` wrapper uses the private `__tl_string_length` intrinsic.
(define (tc-array-length-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 1)
    (let
      [arg : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      (match (tc-expr ctx env arg)
        [(ResultTcType.Ok arg-ty)
          (match (tc-array-length-receiver ctx arg-ty)
            [(ResultTcArrayReceiver.Ok _)
              (tc-array-length-array-call ctx env name-id func args arg-ty)]
            [(ResultTcArrayReceiver.Err _)
              (tc-array-length-non-array-call ctx env name-id func args arg-ty)])]
        [(ResultTcType.Err message) (ResultTcType.Err message)]))
    (if (cbi.compiler-builtin-typecheck-array-length-id? name-id)
      (ResultTcType.Err (tc-call-fixed-arity-message func args 1))
      (tc-call-expr-ordinary ctx env func args))))

(define (tc-layout-query-name? [name : String]) : bool
  (if (string.eq name "size-of")
    true
    (if (string.eq name "align-of")
      true
      (string.eq name "offset-of"))))

;; Layout queries are CTFE-only. Inside `(comptime ...)` the typechecker gets the
;; folded value from `compiler-ctfe-eval`; if an unshadowed query reaches normal
;; expression typing, it is a runtime use and must be rejected.
(define (tc-one-arg-layout-query-runtime-call
  [name : String]
  [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 1)
    (ResultTcType.Err
      (str_cat.str-cat
        "typecheck: "
        name
        " is compile-time only; wrap it in (comptime ...)"))
    (ResultTcType.Err
      (str_cat.str-cat "typecheck: " name " expects exactly one type argument"))))

(define (tc-offset-layout-query-runtime-call [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 2)
    (ResultTcType.Err
      "typecheck: offset-of is compile-time only; wrap it in (comptime ...)")
    (ResultTcType.Err
      "typecheck: offset-of expects exactly one type argument and one field name")))

(define (tc-layout-query-runtime-call [name : String] [args : ast.AstExprList]) : ResultTcType
  (if (string.eq name "offset-of")
    (tc-offset-layout-query-runtime-call args)
    (tc-one-arg-layout-query-runtime-call name args)))

(define (tc-reflection-query-runtime-call [name : String]) : ResultTcType
  (ResultTcType.Err
    (str_cat.str-cat
      "typecheck: "
      name
      " is compile-time only; wrap it in (comptime ...)")))

;; The clone-able type set is a whole-program fixpoint (O(types*fields) plus a
;; type-name map build). It is invariant across a compile, but `tc-clone-able-
;; type?` is invoked once per `(clone ...)` / `with-escape` body in the program,
;; so recomputing it each time was a large repeated cost. Cache it per compile:
;; populated eagerly in the typecheck entry (program arena, so the cached map
;; never dangles into a scratch arena) and reset per compile in macro-expand-
;; program / the REPL entry. When not yet populated (e.g. REPL one-shot checks)
;; the set is rebuilt without caching, preserving correctness.
(define tc-clone-able-cache-ready : bool
  false)
(define tc-clone-able-cache : clone_support.CloneNameSet
  (clone_support.clone-name-set-empty))

;; Clone helper discovery is a semantic observation of the real declaration
;; typecheck, not a reason to run a second partial typechecker. Lowering installs
;; the reachability pass's retained value/function names before checking the
;; specialized source program. Stable canonical names, rather than declaration
;; positions, survive pool compaction and generated-module reshaping. While a
;; retained declaration is checked, clone/with-scratch forms fold their resolved
;; result type directly into the nominal root closure. The root list and name set
;; live in a dedicated arena because function bodies use rewindable scratch.
(define tc-clone-root-collection-active : bool
  false)
(define tc-clone-root-collection-current-decl : bool
  false)
(define tc-clone-root-collection-selected : tc_i64_i64_map.Map
  (tc_i64_i64_map.with-capacity 8))
(define tc-clone-root-collection-roots : clone_support.CloneRootEntries
  (clone_support.CloneRootEntries.Empty))
(define tc-clone-root-collection-arena : i64
  0)

(define (tc-clone-root-collection-decl-key
  [module-id : i64]
  [decl : ast.AstDecl]) : i64
  (match (ast.ast-decl-unwrapped decl)
    [(ast.AstDecl.Def decl-meta name _ _)
      (csym.compiler-symbol-module-key-id-by-id module-id name)]
    [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
      (csym.compiler-symbol-module-key-id-by-id module-id name)]
    [_ -1]))

(define (tc-clone-root-collection-selected-from-program
  [program : ast.AstProgram]) : tc_i64_i64_map.Map
  (match program
    [(ast.AstProgram.Program decls-box)
      (let
        [decls : ast.AstDeclList (__tl-box-place decls-box)]
        [selected : tc_i64_i64_map.Map
          (tc_i64_i64_map.with-capacity
            (if (< (ast.ast-decl-list-len (& decls)) 8)
              8
              (ast.ast-decl-list-len (& decls))))]
        [module-id : i64 cbi.compiler-builtin-id-fix-empty]
        [index : i64 0]
        [count : i64 (ast.ast-decl-list-len (& decls))]
        ;; The row was read by value and then peeled twice more (once inside
        ;; `-decl-key`, once here) -- three 104 B copies per declaration to read
        ;; a name id and a module id. The backing slot is matched in place, and
        ;; the wrapper peel now runs only on an `AstDecl.Unsafe` row.
        [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
        [decl-offset : i64 decls.offset]
        (begin
          (while (< index count)
            (let
              [key : i64
                (tc-clone-root-collection-decl-key
                  module-id
                  (array-ref decl-slots (+ decl-offset index)))]
              (begin
                (if (>= key 0)
                  (tc_i64_i64_map.insert-ref! (&mut selected) key 1)
                  unit)
                (match (array-ref decl-slots (+ decl-offset index))
                  [(ast.AstDecl.Module next-module)
                    (set! module-id next-module)]
                  [(ast.AstDecl.Unsafe _)
                    (match (ast.ast-decl-unwrapped
                      (array-ref decl-slots (+ decl-offset index)))
                      [(ast.AstDecl.Module next-module)
                        (set! module-id next-module)]
                      [_ unit])]
                  [_ unit])
                (set! index (+ index 1)))))
          selected))]))

(define (tc-clone-root-collection-use! [retained : ast.AstProgram]) : unit
  (let
    [arena-handle : i64 (arena.tl_arena_make)]
    (begin
      (in-arena
        (arena.Arena arena-handle)
        (set!
          tc-clone-root-collection-selected
          (tc-clone-root-collection-selected-from-program retained)))
      (set!
        tc-clone-root-collection-roots
        (clone_support.CloneRootEntries.Empty))
      (set! tc-clone-root-collection-current-decl false)
      (set! tc-clone-root-collection-arena arena-handle)
      (set! tc-clone-root-collection-active true))))

(define (tc-clone-root-collection-select-decl!
  [decl : ast.AstDecl]
  [module-id : i64]) : unit
  (if tc-clone-root-collection-active
    (let
      [key : i64 (tc-clone-root-collection-decl-key module-id decl)]
      [selected : bool
        (and
          (>= key 0)
          (tc_i64_i64_map.contains? (& tc-clone-root-collection-selected) key))]
      (begin
        (set! tc-clone-root-collection-current-decl selected)
        (cfg
          (any
            compiler-surface-producer
            compiler-build-identity
            embedded-stdlib-tlci)
          (surface_facts.surface-typecheck-facts-recording-select-decl! key)
          unit)))
    unit))

(cfg
  (any compiler-surface-producer compiler-build-identity embedded-stdlib-tlci)
  (define (tc-clone-root-collection-record-surface-roots!
    [roots : clone_support.CloneRootEntries]) : unit
    (let
      [index : i64 0]
      [count : i64 (clone_support.clone-root-entries-len roots)]
      (begin
        (surface_facts.surface-typecheck-facts-recording-start-clone-call!)
        (while (< index count)
          (begin
            (surface_facts.surface-typecheck-facts-recording-note-clone-root!
              (clone_support.clone-root-entries-key-id-at-or roots index -1))
            (set! index (+ index 1))))))))

(define (tc-clone-root-collection-note! [ctx : TcContext] [ty : ast.AstType]) : unit
  (if (and
    tc-clone-root-collection-active
    tc-clone-root-collection-current-decl)
    (match (tc-context-program ctx)
      [(ast.AstProgram.Program decls-box)
        (in-arena
          (arena.Arena tc-clone-root-collection-arena)
          (let
            [resolved : ast.AstType
              (tc-type-without-regions (tc-resolve-type ctx ty))]
            (begin
              (cfg
                (any
                  compiler-surface-producer
                  compiler-build-identity
                  embedded-stdlib-tlci)
                (tc-clone-root-collection-record-surface-roots!
                  (if (surface_facts.surface-typecheck-facts-recording?)
                    (clone_support.clone-root-add-type
                      (tc-context-pools ctx)
                      (__tl-box-place decls-box)
                      (tc-clone-able-set ctx)
                      (clone_support.CloneRootEntries.Empty)
                      resolved
                      cbi.compiler-builtin-id-fix-empty)
                    (clone_support.CloneRootEntries.Empty)))
                unit)
              ;; Resolve the nominal closure while `ty` and all nested type-pool
              ;; ids are still live in this function's semantic scratch scope.
              ;; Retaining the shallow AstType until the declaration walk ends
              ;; would leave those nested ids pointing past a pool rewind.
              (set!
                tc-clone-root-collection-roots
                (clone_support.clone-root-add-type
                  (tc-context-pools ctx)
                  (__tl-box-place decls-box)
                  (tc-clone-able-set ctx)
                  (tc-global-shared-view tc-clone-root-collection-roots)
                  resolved
                  cbi.compiler-builtin-id-fix-empty)))))])
    unit))

(define (tc-clone-root-collection-copy-roots
  [roots : clone_support.CloneRootEntries]) : clone_support.CloneRootEntries
  (clone_support.clone-root-entries-copy roots))

(define (tc-clone-root-collection-clear-state!) : unit
  (begin
    (set! tc-clone-root-collection-active false)
    (set! tc-clone-root-collection-current-decl false)
    (set! tc-clone-root-collection-roots (clone_support.CloneRootEntries.Empty))))

(define (tc-clone-root-collection-finish! [_ctx : TcContext]) : clone_support.CloneRootEntries
  (if tc-clone-root-collection-active
    (let
      [roots : clone_support.CloneRootEntries
        (tc-clone-root-collection-copy-roots
          (tc-global-shared-view tc-clone-root-collection-roots))]
      [arena-handle : i64 tc-clone-root-collection-arena]
      (begin
        (tc-clone-root-collection-clear-state!)
        (set! tc-clone-root-collection-arena 0)
        (unsafe
          (arena.tl_arena_destroy arena-handle))
        roots))
    (clone_support.CloneRootEntries.Empty)))

(define (tc-clone-root-collection-abort!) : unit
  (if tc-clone-root-collection-active
    (let
      [arena-handle : i64 tc-clone-root-collection-arena]
      (begin
        (tc-clone-root-collection-clear-state!)
        (set! tc-clone-root-collection-arena 0)
        (unsafe
          (arena.tl_arena_destroy arena-handle))))
    unit))

(define (tc-clone-root-collection-apply-surface-facts!) : unit
  (if (and
    tc-clone-root-collection-active
    (surface_facts.surface-typecheck-facts-active?))
    (let
      [facts : surface_facts.SurfaceTypecheckFacts
        (surface_facts.surface-typecheck-facts-current)]
      [decl-keys : (__tl_dyn-array i64) facts.clone-decl-keys]
      [root-keys : (__tl_dyn-array i64) facts.clone-root-keys]
      [call-indices : (__tl_dyn-array i64) facts.clone-call-indices]
      [count : i64 (array-length decl-keys)]
      [index : i64 0]
      (in-arena
        (arena.Arena tc-clone-root-collection-arena)
        (while (< index count)
          (let
            [call-index : i64 (array-ref call-indices index)]
            [decl-key : i64 (array-ref decl-keys index)]
            [end : i64 (+ index 1)]
            (begin
              (while (and
                (< end count)
                (= (array-ref call-indices end) call-index))
                (set! end (+ end 1)))
              (if (tc_i64_i64_map.contains?
                (& tc-clone-root-collection-selected)
                decl-key)
                (let
                  [cursor : i64 (- end 1)]
                  (while (>= cursor index)
                    (let
                      [root-key : i64 (array-ref root-keys cursor)]
                      (begin
                        (if (clone_support.clone-root-entries-contains-id?
                          (tc-global-shared-view tc-clone-root-collection-roots)
                          root-key)
                          unit
                          (set!
                            tc-clone-root-collection-roots
                            (clone_support.clone-root-entries-add-id
                              (tc-global-shared-view
                                tc-clone-root-collection-roots)
                              root-key)))
                        (set! cursor (- cursor 1))))))
                unit)
              (set! index end))))))
    unit))

(define (tc-clone-able-cache-reset!) : unit
  (begin
    (set! tc-clone-able-cache-ready false)
    (set! tc-clone-able-cache (clone_support.clone-name-set-empty))))

(define (tc-clone-able-set-build [ctx : TcContext]) : clone_support.CloneNameSet
  (if (macro-segmented-program-active? (tc-context-job-state ctx))
    (macro-segmented-clone-able-set-build
      (tc-context-job-state ctx)
      (tc-context-pools ctx))
    (match (tc-context-program ctx)
      [(ast.AstProgram.Program decls-box)
        (let
          [decls : ast.AstDeclList (__tl-box-place decls-box)]
          [pools : ast.AstNodePoolContext (tc-context-pools ctx)]
          (clone_support.clone-fixpoint
            pools
            decls
            (clone_support.clone-all-type-names
              decls
              (clone_support.clone-name-set-for-decls decls))))])))

(define (tc-clone-able-cache-populate! [ctx : TcContext]) : unit
  (begin
    (set! tc-clone-able-cache (tc-clone-able-set-build ctx))
    (set! tc-clone-able-cache-ready true)))

(define (tc-clone-able-set [ctx : TcContext]) : clone_support.CloneNameSet
  (if tc-clone-able-cache-ready
    (tc-global-shared-view tc-clone-able-cache)
    (tc-clone-able-set-build ctx)))

(define (tc-clone-able-type? [ctx : TcContext] [ty : ast.AstType]) : bool
  (let
    [resolved : ast.AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    [able-set : clone_support.CloneNameSet (tc-clone-able-set ctx)]
    (clone_support.clone-field-type-able-id?
      (tc-context-pools ctx)
      resolved
      able-set
      (tc-context-module-id ctx))))

;; `(clone x)` deep-copies x into the current arena. Type-directed: the
;; result is the argument's type, stripped of any inner-region tag (the copy
;; lands in the enclosing arena, not the source's region). Unsupported types are
;; rejected here so no heap-backed value silently lowers as a shallow handle copy.
(define (tc-clone-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 1)
    (let
      [arg : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      (match (tc-expr ctx env arg)
        [(ResultTcType.Ok arg-ty)
          (let
            [clone-ty : ast.AstType (tc-type-without-regions arg-ty)]
            (if (tc-clone-able-type? ctx clone-ty)
              (begin
                (tc-clone-root-collection-note! ctx clone-ty)
                (ResultTcType.Ok clone-ty))
              (ResultTcType.Err
                (str_cat.str-cat
                  "typecheck: clone unsupported type "
                  (tc-type-render
                    (tc-type-without-regions (tc-resolve-type ctx arg-ty)))))))]
        [(ResultTcType.Err message) (ResultTcType.Err message)]))
    (ResultTcType.Err "typecheck: clone expects exactly one argument")))

(define (tc-float-sqrt-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 1)
    (let
      [arg : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      (match (tc-expr ctx env arg)
        [(ResultTcType.Ok arg-ty)
          (match (tc-type-strip-region (tc-resolve-type ctx arg-ty))
            [(ast.AstType.F64) (ResultTcType.Ok (ast.AstType.F64))]
            [(ast.AstType.F32) (ResultTcType.Ok (ast.AstType.F32))]
            [_
              (ResultTcType.Err
                (tc-locate-error-at-expr
                  arg
                  "typecheck: __tl_float_sqrt expects f64 or f32"))])]
        [(ResultTcType.Err message) (ResultTcType.Err message)]))
    (ResultTcType.Err "typecheck: __tl_float_sqrt expects exactly one argument")))

(define (tc-float-bitcast-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 1)
    (let
      [arg : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      (match (tc-expr ctx env arg)
        [(ResultTcType.Ok arg-ty)
          (if (cbi.compiler-builtin-lower-float-to-bits-id? name-id)
            (match (tc-type-strip-region (tc-resolve-type ctx arg-ty))
              [(ast.AstType.F64) (ResultTcType.Ok (ast.AstType.U64))]
              [(ast.AstType.F32) (ResultTcType.Ok (ast.AstType.U32))]
              [_
                (ResultTcType.Err
                  (tc-locate-error-at-expr
                    arg
                    "typecheck: __tl_float_to_bits expects f64 or f32"))])
            (match (tc-type-strip-region (tc-resolve-type ctx arg-ty))
              [(ast.AstType.U64) (ResultTcType.Ok (ast.AstType.F64))]
              [(ast.AstType.U32) (ResultTcType.Ok (ast.AstType.F32))]
              [_
                (ResultTcType.Err
                  (tc-locate-error-at-expr
                    arg
                    "typecheck: __tl_float_from_bits expects u64 or u32"))]))]
        [(ResultTcType.Err message) (ResultTcType.Err message)]))
    (ResultTcType.Err "typecheck: float bitcast expects exactly one argument")))

(define (tc-tls-current-arena-read-call [args : ast.AstExprList]) : ResultTcType
  (if (ast.ast-expr-list-empty? (& args))
    (ResultTcType.Ok (ast.AstType.I64))
    (ResultTcType.Err "typecheck: tls-current-arena expects no arguments")))

(define (tc-tls-current-arena-set-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : ast.AstExprList]) : ResultTcType
  (match (tc-require-unsafe ctx env "tls-current-arena-set!")
    [(ResultTcUnit.Ok)
      (if (= args.len 1)
        (let
          [value : ast.AstExpr
            (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
          (match (tc-check-exact-arg
            ctx
            env
            value
            (ast.AstType.I64)
            "typecheck: tls-current-arena-set! value type mismatch")
            [(ResultTcUnit.Ok) (ResultTcType.Ok (ast.AstType.Unit))]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)]))
        (ResultTcType.Err
          "typecheck: tls-current-arena-set! expects exactly one argument"))]
    [(ResultTcUnit.Err message) (ResultTcType.Err message)]))

(define (tc-tls-current-arena-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [args : ast.AstExprList]) : ResultTcType
  (if (cbi.compiler-builtin-typecheck-tls-current-arena-read-id? name-id)
    (tc-tls-current-arena-read-call args)
    (tc-tls-current-arena-set-call ctx env args)))

(define (tc-slice-view-call-kind-name
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [name : String]) : TcSliceViewCallKind
  ;; Source-level definitions (including imported stdlib wrappers) shadow the
  ;; unqualified core spellings.  Keep this check identical to the other
  ;; source builtins: private/compiler names use their own policy, while these
  ;; public compatibility operations consult the authoritative source-value
  ;; membership table.
  (if (tc-source-value-bound-id? ctx env name-id)
    (TcSliceViewCallKind.None)
    (cond
      [(string.eq name "slice-view") TcSliceViewCallKind.Shared]
      [(string.eq name "slice-mut-view") TcSliceViewCallKind.Mutable]
      [(string.eq name "slice-split-at") TcSliceViewCallKind.SplitShared]
      [(string.eq name "slice-split-at-mut") TcSliceViewCallKind.SplitMutable]
      [else TcSliceViewCallKind.None])))

(define (tc-slice-view-call-kind
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]) : TcSliceViewCallKind
  (match (ast.ast-expr-unspan func)
    [(ast.AstExpr.Var raw-name)
      (let
        [raw-text : String (tc-hygiene-name-text-id raw-name)]
        [hygiene-global : bool (tc-hygiene-global-name-id? raw-name)]
        [name : String
          (if (and hygiene-global (not (macro-hygiene-global-id? raw-name)))
            (tc-hygiene-global-call-name raw-text)
            raw-text)]
        [name-id : i64 (tc-builtin-call-name-id raw-name hygiene-global)]
        (tc-slice-view-call-kind-name ctx env name-id name))]
    [_ (TcSliceViewCallKind.None)]))

(define (tc-slice-view-call-spelling? [func : ast.AstExpr]) : bool
  ;; Borrow gating runs before a complete type environment is available.  It
  ;; therefore recognizes the raw spelling conservatively; the real
  ;; classifier above still performs shadowing checks before interception.
  (match (ast.ast-expr-unspan func)
    [(ast.AstExpr.Var raw-name)
      (let
        [raw-text : String (tc-hygiene-name-text-id raw-name)]
        [name : String
          (if (tc-hygiene-global-name-id? raw-name)
            (tc-hygiene-global-call-name raw-text)
            raw-text)]
        (or
          (string.eq name "slice-view")
          (string.eq name "slice-mut-view")
          (string.eq name "slice-split-at")
          (string.eq name "slice-split-at-mut")))]
    [_ false]))

(define (tc-slice-call-mutable? [kind : TcSliceViewCallKind]) : bool
  (or
    (= kind TcSliceViewCallKind.Mutable)
    (= kind TcSliceViewCallKind.SplitMutable)))

(define (tc-slice-call-split? [kind : TcSliceViewCallKind]) : bool
  (or
    (= kind TcSliceViewCallKind.SplitShared)
    (= kind TcSliceViewCallKind.SplitMutable)))

(define (tc-slice-view-source-info [ctx : TcContext] [source-ty : ast.AstType]) : TcSliceViewSourceInfo
  (match (tc-type-strip-region (tc-resolve-type ctx source-ty))
    [(ast.AstType.Array _ _)
      (TcSliceViewSourceInfo.Direct
        (tc-type-strip-region (tc-resolve-type ctx source-ty)))]
    [(ast.AstType.DynArray _)
      (TcSliceViewSourceInfo.Direct
        (tc-type-strip-region (tc-resolve-type ctx source-ty)))]
    [(ast.AstType.Ref lifetime referent-id)
      (let
        [referent : ast.AstType
          (tc-type-strip-region
            (tc-resolve-type ctx (tc-context-type-get ctx referent-id)))]
        (match referent
          [(ast.AstType.Array _ _)
            (TcSliceViewSourceInfo.Borrow lifetime false referent)]
          [(ast.AstType.DynArray _)
            (TcSliceViewSourceInfo.Borrow lifetime false referent)]
          [(ast.AstType.Slice _)
            (TcSliceViewSourceInfo.Borrow lifetime false referent)]
          [_ (TcSliceViewSourceInfo.Invalid)]))]
    [(ast.AstType.MutRef lifetime referent-id)
      (let
        [referent : ast.AstType
          (tc-type-strip-region
            (tc-resolve-type ctx (tc-context-type-get ctx referent-id)))]
        (match referent
          [(ast.AstType.Array _ _)
            (TcSliceViewSourceInfo.Borrow lifetime true referent)]
          [(ast.AstType.DynArray _)
            (TcSliceViewSourceInfo.Borrow lifetime true referent)]
          [(ast.AstType.Slice _)
            (TcSliceViewSourceInfo.Borrow lifetime true referent)]
          [_ (TcSliceViewSourceInfo.Invalid)]))]
    [_ (TcSliceViewSourceInfo.Invalid)]))

(define (tc-slice-view-source-element
  [ctx : TcContext]
  [source : TcSliceViewSourceInfo]) : ast.AstType
  (match source
    [(TcSliceViewSourceInfo.Direct direct-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx direct-ty))
        [(ast.AstType.Array elem _) (ast.ty-node-get elem)]
        [(ast.AstType.DynArray elem) (ast.ty-node-get elem)]
        [_ (ast.AstType.Unit)])]
    [(TcSliceViewSourceInfo.Borrow _ _ referent)
      (match (tc-type-strip-region (tc-resolve-type ctx referent))
        [(ast.AstType.Array elem _) (ast.ty-node-get elem)]
        [(ast.AstType.DynArray elem) (ast.ty-node-get elem)]
        [(ast.AstType.Slice elem) (ast.ty-node-get elem)]
        [_ (ast.AstType.Unit)])]
    [_ (ast.AstType.Unit)]))

(define (tc-slice-view-result-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [kind : TcSliceViewCallKind]
  [source : ast.AstExpr]
  [source-ty : ast.AstType]) : ResultTcType
  (let
    [source-info : TcSliceViewSourceInfo
      (tc-slice-view-source-info ctx source-ty)]
    (match source-info
      [(TcSliceViewSourceInfo.Invalid)
        (ResultTcType.Err
          (tc-locate-error-at-expr
            source
            "typecheck: slice-view source must be a fixed array, dynamic array, or borrowed reference to one"))]
      [(TcSliceViewSourceInfo.Direct _)
        (begin
          (when
            (tc-slice-call-mutable? kind)
            (match (tc-mut-borrow-non-call-place-ok ctx env source)
              [(ResultTcUnit.Ok) unit]
              [(ResultTcUnit.Err message)
                (return
                  (ResultTcType.Err (tc-locate-error-at-expr source message)))]))
          (match (tc-borrow-place ctx (tc-context-expr-bases ctx) env source)
            [(ResultTcBorrowPlace.Ok place)
              (match place
                [(TcBorrowPlace lifetime _)
                  (ResultTcType.Ok
                    (if (tc-slice-call-mutable? kind)
                      (ast.ast-ty-mut-ref-with-pools
                        (tc-context-pools ctx)
                        lifetime
                        (ast.ast-ty-slice-with-pools
                          (tc-context-pools ctx)
                          (tc-slice-view-source-element ctx source-info)))
                      (ast.ast-ty-ref-with-pools
                        (tc-context-pools ctx)
                        lifetime
                        (ast.ast-ty-slice-with-pools
                          (tc-context-pools ctx)
                          (tc-slice-view-source-element ctx source-info)))))])]
            [(ResultTcBorrowPlace.Err message)
              (ResultTcType.Err (tc-locate-error-at-expr source message))]))]
      [(TcSliceViewSourceInfo.Borrow lifetime source-mutable _)
        (if (and (tc-slice-call-mutable? kind) (not source-mutable))
          (ResultTcType.Err
            (tc-locate-error-at-expr
              source
              "typecheck: slice-mut-view requires a mutable borrowed source"))
          (ResultTcType.Ok
            (if (tc-slice-call-mutable? kind)
              (ast.ast-ty-mut-ref-with-pools
                (tc-context-pools ctx)
                lifetime
                (ast.ast-ty-slice-with-pools
                  (tc-context-pools ctx)
                  (tc-slice-view-source-element ctx source-info)))
              (ast.ast-ty-ref-with-pools
                (tc-context-pools ctx)
                lifetime
                (ast.ast-ty-slice-with-pools
                  (tc-context-pools ctx)
                  (tc-slice-view-source-element ctx source-info))))))])))

(define (tc-slice-split-result-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [kind : TcSliceViewCallKind]
  [source : ast.AstExpr]
  [source-ty : ast.AstType]) : ResultTcType
  (match (tc-slice-view-source-info ctx source-ty)
    [(TcSliceViewSourceInfo.Borrow _ source-mutable referent)
      (match (tc-type-strip-region (tc-resolve-type ctx referent))
        [(ast.AstType.Slice _)
          (if (and (tc-slice-call-mutable? kind) (not source-mutable))
            (ResultTcType.Err
              (tc-locate-error-at-expr
                source
                "typecheck: slice-split-at-mut requires a mutable borrowed Slice"))
            (begin
              (when
                (tc-slice-call-mutable? kind)
                (match (tc-mut-borrow-non-call-place-ok ctx env source)
                  [(ResultTcUnit.Ok) unit]
                  [(ResultTcUnit.Err message)
                    (return
                      (ResultTcType.Err
                        (tc-locate-error-at-expr source message)))]))
              (match (tc-slice-view-result-type ctx env kind source source-ty)
                [(ResultTcType.Ok half-ty)
                  (ResultTcType.Ok
                    (ast.ast-ty-tuple
                      (ast.ast-type-cons-with-pools
                        (tc-context-pools ctx)
                        half-ty
                        (ast.ast-type-cons-with-pools
                          (tc-context-pools ctx)
                          half-ty
                          (ast.ast-type-list-new)))))]
                [(ResultTcType.Err message) (ResultTcType.Err message)])))]
        [_
          (ResultTcType.Err
            (tc-locate-error-at-expr
              source
              "typecheck: slice-split-at source must be a borrowed Slice"))])]
    [_
      (ResultTcType.Err
        (tc-locate-error-at-expr
          source
          "typecheck: slice-split-at source must be a borrowed Slice"))]))

(define (tc-slice-split-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [kind : TcSliceViewCallKind]
  [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 2)
    (let
      [source : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [mid : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 1 0))]
      (match (tc-expr ctx env source)
        [(ResultTcType.Ok source-ty)
          (match (tc-slice-split-result-type ctx env kind source source-ty)
            [(ResultTcType.Ok result-ty)
              (match (tc-expr ctx env mid)
                [(ResultTcType.Ok mid-ty)
                  (if (tc-integer-type? mid-ty)
                    (ResultTcType.Ok result-ty)
                    (ResultTcType.Err
                      (tc-locate-error-at-expr
                        mid
                        (tc-call-argument-expected-text-message
                          ctx
                          func
                          1
                          mid-ty
                          "integer"))))]
                [(ResultTcType.Err message) (ResultTcType.Err message)])]
            [(ResultTcType.Err message) (ResultTcType.Err message)])]
        [(ResultTcType.Err message) (ResultTcType.Err message)]))
    (ResultTcType.Err (tc-call-fixed-arity-message func args 2))))

(define (tc-slice-view-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [kind : TcSliceViewCallKind]
  [args : ast.AstExprList]) : ResultTcType
  (if (= args.len 3)
    (let
      [source : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 0 0))]
      [start : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 1 0))]
      [len : ast.AstExpr
        (tc-context-expr-get ctx (ast.ast-expr-list-get (& args) 2 0))]
      (match (tc-expr ctx env source)
        [(ResultTcType.Ok source-ty)
          (match (tc-slice-view-result-type ctx env kind source source-ty)
            [(ResultTcType.Ok result-ty)
              (match (tc-expr ctx env start)
                [(ResultTcType.Ok start-ty)
                  (if (tc-integer-type? start-ty)
                    (match (tc-expr ctx env len)
                      [(ResultTcType.Ok len-ty)
                        (if (tc-integer-type? len-ty)
                          (ResultTcType.Ok result-ty)
                          (ResultTcType.Err
                            (tc-locate-error-at-expr
                              len
                              (tc-call-argument-expected-text-message
                                ctx
                                func
                                2
                                len-ty
                                "integer"))))]
                      [(ResultTcType.Err message) (ResultTcType.Err message)])
                    (ResultTcType.Err
                      (tc-locate-error-at-expr
                        start
                        (tc-call-argument-expected-text-message
                          ctx
                          func
                          1
                          start-ty
                          "integer"))))]
                [(ResultTcType.Err message) (ResultTcType.Err message)])]
            [(ResultTcType.Err message) (ResultTcType.Err message)])]
        [(ResultTcType.Err message) (ResultTcType.Err message)]))
    (ResultTcType.Err (tc-call-fixed-arity-message func args 3))))

(define (tc-call-or-array-length-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]
  [args : ast.AstExprList]) : ResultTcType
  (let
    [func : ast.AstExpr (tc-context-expr-get ctx func-id)]
    (match (ast.ast-expr-unspan func)
      [(ast.AstExpr.Var raw-name)
        ;; Keep builtin dispatch identical to the string-name call path; only
        ;; the ordinary fallback needs the pooled function expression id.
        (let
          [raw-text : String (tc-hygiene-name-text-id raw-name)]
          [hygiene-global : bool (tc-hygiene-global-name-id? raw-name)]
          [name : String
            (if (and hygiene-global (not (macro-hygiene-global-id? raw-name)))
              (tc-hygiene-global-call-name raw-text)
              raw-text)]
          [name-id : i64 (tc-builtin-call-name-id raw-name hygiene-global)]
          [lookup-id : i64 (tc-call-builtin-lookup-id ctx env name name-id)]
          (if (or
            (< name-id 0)
            (csym.compiler-composite-triple-key-id? lookup-id)
            (tc-call-variant-name-id? ctx name-id))
            (tc-call-expr-ordinary-id ctx env func-id args)
            (let
              [arena-call-kind : i64
                (tc-arena-safe-call-kind-id ctx env name-id lookup-id)]
              [arena-owner-kind : i64
                (tc-arena-owner-call-kind-ids
                  ctx
                  env
                  name-id
                  lookup-id
                  args.len)]
              [slice-call-kind : TcSliceViewCallKind
                (tc-slice-view-call-kind-name ctx env name-id name)]
              (cond
                [(and
                    (tc-layout-query-name? name)
                    (not (tc-source-value-bound-id? ctx env name-id)))
                  (tc-layout-query-runtime-call name args)]
                [(tc-string-length-helper-call-id? ctx env name-id lookup-id)
                  (tc-one-length-handle-builtin-call
                    ctx
                    env
                    func
                    args
                    (ast.AstType.I64))]
                [(tc-slice-call-split? slice-call-kind)
                  (tc-slice-split-call ctx env func slice-call-kind args)]
                [(not (= slice-call-kind TcSliceViewCallKind.None))
                  (tc-slice-view-call ctx env func slice-call-kind args)]
                [(cbi.compiler-builtin-typecheck-length-call-id? name-id)
                  (tc-array-length-call ctx env name-id func args)]
                [(and
                    (cbi.compiler-builtin-typecheck-string-ref-call-id? name-id)
                    (not (tc-source-value-bound-id? ctx env name-id)))
                  (tc-string-ref-call ctx env func args)]
                [(tc-string-ref-helper-call-id? ctx env name-id lookup-id)
                  (tc-string-ref-call ctx env func args)]
                [(and
                    (tc-atomic-pointer-name? name)
                    (not (tc-source-value-bound-id? ctx env name-id)))
                  (tc-atomic-pointer-call ctx env name args)]
                [(not (= arena-owner-kind (tc-arena-owner-kind-none)))
                  (tc-arena-owner-call-type-id
                    ctx
                    env
                    func-id
                    args
                    arena-owner-kind)]
                [(= arena-call-kind (tc-arena-safe-call-kind-phase))
                  (tc-phase-call ctx env func args)]
                [(= arena-call-kind (tc-arena-safe-call-kind-rewind))
                  (tc-rewind-safe-call ctx env args)]
                [(= arena-call-kind (tc-arena-safe-call-kind-destroy))
                  (tc-destroy-safe-call ctx env args)]
                [(and
                    (cbi.compiler-builtin-typecheck-tls-current-arena-id?
                      name-id)
                    (not (tc-source-value-bound-id? ctx env name-id)))
                  (tc-tls-current-arena-call ctx env name-id args)]
                [(and
                    (tc-borrowed-string-builtin-id? name-id)
                    (tc-default-builtin-unshadowed-id? env name-id))
                  (tc-borrowed-string-builtin-call ctx env func name-id args)]
                [(tc-string-eq-helper-call-id? ctx env name-id lookup-id)
                  (tc-borrowed-string-builtin-call
                    ctx
                    env
                    func
                    cbi.compiler-builtin-id-tl-private-string-eq
                    args)]
                [(tc-string-copy-helper-call-id? ctx env name-id lookup-id)
                  (tc-two-string-handle-builtin-call
                    ctx
                    env
                    func
                    args
                    (ast.AstType.String))]
                [(tc-string-to-int-helper-call-id? ctx env lookup-id)
                  (tc-borrowed-string-builtin-call
                    ctx
                    env
                    func
                    cbi.compiler-builtin-id-tl-private-string-to-int
                    args)]
                [(and
                    (ctfe_support.ctfe-builtin-reflection-id? name-id)
                    (not (tc-source-value-bound-id? ctx env name-id)))
                  (tc-reflection-query-runtime-call name)]
                [(and
                    (ctfe_support.ctfe-builtin-module-value-id? name-id)
                    (not (tc-source-value-bound-id? ctx env name-id)))
                  (tc-reflection-query-runtime-call name)]
                [(and
                    (cbi.compiler-builtin-typecheck-float-sqrt-id? name-id)
                    (tc-private-intrinsic-unshadowed-id? ctx env name-id))
                  (tc-float-sqrt-call ctx env args)]
                [(and
                    (cbi.compiler-builtin-typecheck-float-bitcast-id? name-id)
                    (tc-private-intrinsic-unshadowed-id? ctx env name-id))
                  (tc-float-bitcast-call ctx env name-id args)]
                [(and
                    (cbi.compiler-builtin-typecheck-clone-id? name-id)
                    (not (tc-source-value-bound-id? ctx env name-id)))
                  (tc-clone-call ctx env args)]
                [else (tc-call-expr-ordinary-id ctx env func-id args)]))))]
      [_ (tc-call-expr-ordinary-id ctx env func-id args)])))

(define (tc-let-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : ast.AstLetBindingList]) : ResultTcEnv
  (tc-let-bindings-at ctx env (& bindings) 0))

(define (tc-let-binding-resolve-maybe-type
  [ctx : TcContext]
  [maybe-ty : ast.AstMaybeType]) : ast.AstMaybeType
  (match maybe-ty
    [(ast.AstMaybeType.Some want)
      (ast.AstMaybeType.Some (tc-resolve-type ctx want))]
    [(ast.AstMaybeType.No) ast.AstMaybeType.No]))

(define (tc-let-binding-plain-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [maybe-ty : ast.AstMaybeType]
  [init : ast.AstExpr]) : ResultTcType
  (match maybe-ty
    [(ast.AstMaybeType.Some want)
      (tc-expr-with-expected-or-actual ctx env init want)]
    [(ast.AstMaybeType.No) (tc-expr ctx env init)]))

(define (tc-let-binding-plain-expected-ok
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [maybe-ty : ast.AstMaybeType]
  [init : ast.AstExpr]
  [init-ty : ast.AstType]) : ResultTcUnit
  (match maybe-ty
    [(ast.AstMaybeType.Some want)
      (match (tc-expect-in-context
        ctx
        env
        init-ty
        want
        (str_cat.str-cat "typecheck: let binding `" name "` type mismatch"))
        [(ResultTcUnit.Ok) ResultTcUnit.Ok]
        [(ResultTcUnit.Err message)
          (ResultTcUnit.Err (tc-locate-error-at-expr init message))])]
    [(ast.AstMaybeType.No) ResultTcUnit.Ok]))

(define (tc-let-binding-plain-bind-type
  [_ctx : TcContext]
  [maybe-ty : ast.AstMaybeType]
  [init-ty : ast.AstType]) : ast.AstType
  (match maybe-ty
    [(ast.AstMaybeType.Some want)
      (if (tc-type-contains-region-tag? init-ty)
        init-ty
        want)]
    [(ast.AstMaybeType.No) init-ty]))

(define (tc-let-bindings-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : ResultTcEnv
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (ResultTcEnv.Ok env)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : ast.AstExpr (tc-context-expr-get ctx init-box)]
          [resolved-maybe-ty : ast.AstMaybeType
            (tc-let-binding-resolve-maybe-type ctx maybe-ty)]
          (match (tc-let-binding-plain-type ctx env resolved-maybe-ty init)
            [(ResultTcType.Ok init-ty)
              (match (tc-let-binding-plain-expected-ok
                ctx
                env
                (tc-env-key-name-text name)
                resolved-maybe-ty
                init
                init-ty)
                [(ResultTcUnit.Ok)
                  (match (tc-ensure-cleanup-resource-not-let-bound
                    ctx
                    env
                    init
                    init-ty)
                    [(ResultTcUnit.Ok)
                      (match (tc-ensure-reference-value-can-bind env init-ty)
                        [(ResultTcUnit.Ok)
                          (tc-let-bindings-at
                            ctx
                            (tc-bind-c-abi-fnptr-if-needed-id
                              ctx
                              env
                              name
                              (tc-let-binding-plain-bind-type
                                ctx
                                resolved-maybe-ty
                                init-ty)
                              init)
                            bindings
                            (+ index 1))]
                        [(ResultTcUnit.Err message) (ResultTcEnv.Err message)])]
                    [(ResultTcUnit.Err message) (ResultTcEnv.Err message)])]
                [(ResultTcUnit.Err message) (ResultTcEnv.Err message)])]
            [(ResultTcType.Err message) (ResultTcEnv.Err message)]))])))

(define (tc-lambda-captures-reference?
  [expr-bases : i64]
  [env : TcTypeEnv]
  [params : ast.AstParamList]
  [body : ast.AstExpr]) : bool
  (tc-type-env-scoped-carrier-lambda-captures-reference?
    expr-bases
    (tc-type-env-scoped-carrier-from-marker-visible-env env)
    params
    body))

(define (tc-type-env-scoped-lambda-captures-reference-scan
  [expr-bases : i64]
  [cursor : TcTypeEnvScopedMarkerCursor]
  [bound : TcStringList]
  [body : ast.AstExpr]) : bool
  (match (tc-type-env-scoped-marker-step cursor)
    [(TcTypeEnvScopedMarkerStep.Done) false]
    [(TcTypeEnvScopedMarkerStep.Bind key ty rest-cursor)
      (if (or
        (= key (tc-region-marker-id))
        (= key (tc-default-boundary-id))
        (tc-cleanup-owner-marker-entry? key ty)
        (tc-ordinary-arena-owner-marker-entry? key ty)
        (tc-atomic-arena-owner-marker-entry? key ty))
        (tc-type-env-scoped-lambda-captures-reference-scan
          expr-bases
          rest-cursor
          bound
          body)
        (if (and
          (tc-expr-uses-free-name?
            expr-bases
            body
            (tc-env-key-name-text key)
            bound)
          (tc-type-contains-reference? ty))
          true
          (tc-type-env-scoped-lambda-captures-reference-scan
            expr-bases
            rest-cursor
            bound
            body)))]))

(define (tc-type-env-scoped-carrier-lambda-captures-reference?
  [expr-bases : i64]
  [carrier : TcTypeEnvScopedCarrier]
  [params : ast.AstParamList]
  [body : ast.AstExpr]) : bool
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (tc-type-env-scoped-lambda-captures-reference-scan
      expr-bases
      (tc-type-env-scoped-carrier-marker-cursor carrier)
      (tc-param-bound-names params)
      body)))

(define (tc-ref-capturing-lambda-init?
  [expr-bases : i64]
  [env : TcTypeEnv]
  [init : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan init)
    [(ast.AstExpr.Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(ast.AstLambda.Lambda params _ body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (tc-lambda-captures-reference? expr-bases env params body))])]
    [_ false]))

;; Concrete closure facts are deliberately not part of AstType.Func: literals
;; and fact-preserving local aliases may retain them, while wider value flows
;; fail closed when they would erase required ownership or lifetime facts. The
;; move checker computes the capability from the literal's captures/body; this
;; early query lets the ordinary let escape proof reject unsafe widening.
(define (tc-move-only-capturing-lambda-init?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [init : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan init)
    [(ast.AstExpr.Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(ast.AstLambda.Lambda params _ body-box)
          (let
            [expr-bases : i64 (tc-context-expr-bases ctx)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (tc-lambda-capture-has-move-only? ctx expr-bases env params body))])]
    [_ false]))

(define (tc-consuming-capturing-lambda-init?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [init : ast.AstExpr]) : bool
  (and
    (tc-move-only-capturing-lambda-init? ctx env init)
    (match (ast.ast-expr-unspan init)
      [(ast.AstExpr.Lambda lambda-box)
        (match (__tl-box-place lambda-box)
          [(ast.AstLambda.Lambda params _ body-box)
            (=
              (tc-lambda-call-capability ctx env params body-box)
              (tc-closure-call-capability-once))])]
      [_ false])))

(define (tc-ref-closure-expr-list-local-uses-ok?
  [expr-bases : i64]
  [exprs : ast.AstExprList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-ref-closure-expr-list-local-uses-ok-at? expr-bases (& exprs) 0 name bound))

(define (tc-ref-closure-expr-list-local-uses-ok-at?
  [expr-bases : i64]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [name : String]
  [bound : TcStringList]) : bool
  (if (>= index exprs.len)
    true
    (and
      (tc-ref-closure-local-uses-ok?
        expr-bases
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get exprs index 0))
        name
        bound)
      (tc-ref-closure-expr-list-local-uses-ok-at?
        expr-bases
        exprs
        (+ index 1)
        name
        bound))))

(define (tc-ref-closure-let-binding-list-local-uses-ok?
  [expr-bases : i64]
  [bindings : ast.AstLetBindingList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-ref-closure-let-binding-list-local-uses-ok-at?
    expr-bases
    (& bindings)
    name
    bound
    0))

(define (tc-ref-closure-let-binding-list-local-uses-ok-at?
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [name : String]
  [bound : TcStringList]
  [index : i64]) : bool
  (if (>= index (ast.ast-let-binding-list-len bindings))
    true
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding bind-name _ init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          (and
            (tc-ref-closure-local-uses-ok? expr-bases init name bound)
            (tc-ref-closure-let-binding-list-local-uses-ok-at?
              expr-bases
              bindings
              name
              (tc-string-list-add bound (ci.intern-str bind-name))
              (+ index 1))))])))

(define (tc-ref-closure-let-rest-and-body-local-uses-ok-at?
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [body : ast.AstExpr]
  [name : String]
  [bound : TcStringList]
  [allow-copy-alias : bool]
  [index : i64]) : bool
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (tc-ref-closure-local-uses-ok? expr-bases body name bound)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding bind-name _ init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [bind-name-text : String (tc-env-key-name-text bind-name)]
          [direct-copy-alias : bool
            (and
              allow-copy-alias
              (match (ast.ast-expr-unspan init)
                [(ast.AstExpr.Var source-name)
                  (and
                    (string.eq (tc-env-key-name-text source-name) name)
                    (not (tc-string-list-contains bound name)))]
                [_ false]))]
          [nested-fact-capture : bool
            (and
              allow-copy-alias
              (match (ast.ast-expr-unspan init)
                [(ast.AstExpr.Lambda lambda-box)
                  (match (__tl-box-place lambda-box)
                    [(ast.AstLambda.Lambda params _ lambda-body-box)
                      (tc-expr-uses-free-name?
                        expr-bases
                        (ast.ast-expr-segment-bases-get
                          expr-bases
                          lambda-body-box)
                        name
                        (tc-param-list-add-bound-names params bound))])]
                [_ false]))]
          (if (or direct-copy-alias nested-fact-capture)
            (and
              (tc-ref-closure-let-rest-and-body-local-uses-ok-at?
                expr-bases
                bindings
                body
                bind-name-text
                TcStringList.Nil
                true
                (+ index 1))
              (tc-ref-closure-let-rest-and-body-local-uses-ok-at?
                expr-bases
                bindings
                body
                name
                (tc-string-list-add bound (ci.intern-str bind-name))
                true
                (+ index 1)))
            (and
              (tc-ref-closure-local-uses-ok? expr-bases init name bound)
              (tc-ref-closure-let-rest-and-body-local-uses-ok-at?
                expr-bases
                bindings
                body
                name
                (tc-string-list-add bound (ci.intern-str bind-name))
                allow-copy-alias
                (+ index 1)))))])))

(define (tc-ref-closure-resource-binding-list-local-uses-ok?
  [expr-bases : i64]
  [bindings : ast.AstResourceBindingList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-ref-closure-resource-binding-list-local-uses-ok-at?
    expr-bases
    (& bindings)
    name
    bound
    0))

(define (tc-ref-closure-resource-binding-list-local-uses-ok-at?
  [expr-bases : i64]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [name : String]
  [bound : TcStringList]
  [index : i64]) : bool
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    true
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(ast.AstResourceBinding.Binding bind-name init-box cleanup-box _)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [cleanup : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases cleanup-box)]
          (and
            (tc-ref-closure-local-uses-ok? expr-bases init name bound)
            (tc-ref-closure-local-uses-ok? expr-bases cleanup name bound)
            (tc-ref-closure-resource-binding-list-local-uses-ok-at?
              expr-bases
              bindings
              name
              (tc-string-list-add bound (ci.intern-str bind-name))
              (+ index 1))))])))

(define (tc-ref-closure-match-arms-local-uses-ok?
  [expr-bases : i64]
  [arms : ast.AstMatchArmList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-ref-closure-match-arms-local-uses-ok-at? expr-bases (& arms) name bound 0))

(define (tc-ref-closure-match-arms-local-uses-ok-at?
  [expr-bases : i64]
  [arms : (& arms ast.AstMatchArmList)]
  [name : String]
  [bound : TcStringList]
  [index : i64]) : bool
  (if (>= index arms.len)
    true
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm pattern body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          (and
            (tc-ref-closure-local-uses-ok?
              expr-bases
              body
              name
              (tc-pattern-add-bound-names pattern bound))
            (tc-ref-closure-match-arms-local-uses-ok-at?
              expr-bases
              arms
              name
              bound
              (+ index 1))))])))

(define (tc-ref-closure-direct-call?
  [func : ast.AstExpr]
  [name : String]
  [bound : TcStringList]) : bool
  (match (ast.ast-expr-unspan func)
    [(ast.AstExpr.Var var-name)
      (and
        (string.eq (tc-env-key-name-text var-name) name)
        (not (tc-string-list-contains bound name)))]
    [_ false]))

(define (tc-ref-closure-local-uses-ok?
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [name : String]
  [bound : TcStringList]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases expr)
    [(ast.AstExpr.Var var-name)
      (not
        (and
          (string.eq (tc-env-key-name-text var-name) name)
          (not (tc-string-list-contains bound name))))]
    [(ast.AstExpr.Binary _ left-box right-box)
      (let
        [left : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases left-box)]
        [right : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases right-box)]
        (and
          (tc-ref-closure-local-uses-ok? expr-bases left name bound)
          (tc-ref-closure-local-uses-ok? expr-bases right name bound)))]
    [(ast.AstExpr.Unary _ inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-ref-closure-local-uses-ok? expr-bases inner name bound))]
    [(ast.AstExpr.Call func-box args)
      (let
        [func : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases func-box)]
        (if (tc-ref-closure-direct-call? func name bound)
          (tc-ref-closure-expr-list-local-uses-ok? expr-bases args name bound)
          (and
            (tc-ref-closure-local-uses-ok? expr-bases func name bound)
            (tc-ref-closure-expr-list-local-uses-ok? expr-bases args name bound))))]
    [(ast.AstExpr.BracketClause items)
      (tc-ref-closure-expr-list-local-uses-ok? expr-bases items name bound)]
    [(ast.AstExpr.If cond-box then-box else-box)
      (let
        [cond : ast.AstExpr
