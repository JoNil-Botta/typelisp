(define (tc-stdlib-comptime-surface-ok-impl [ctx : TcContext]) : ResultTcUnit
  (if (not (tc-stdlib-comptime-present? ctx))
    ResultTcUnit.Ok
    (let
      [result : ResultTcUnit (tc-stdlib-check-comptime-declaration-surface ctx)]
      (begin
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-enum
              ctx
              "Expr"
              cbi.compiler-builtin-id-fix-Expr
              (tc-stdlib-expr-specs ctx))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "ExprList"
              cbi.compiler-builtin-id-fix-ExprList
              (tc-stdlib-sequence-fields ctx cbi.compiler-builtin-id-fix-Expr))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "ExprClause"
              cbi.compiler-builtin-id-fix-ExprClause
              (tc-stdlib-expr-clause-fields))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "ExprClauseList"
              cbi.compiler-builtin-id-fix-ExprClauseList
              (tc-stdlib-sequence-fields
                ctx
                cbi.compiler-builtin-id-fix-ExprClause))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "ExprBindingClause"
              cbi.compiler-builtin-id-fix-ExprBindingClause
              (tc-stdlib-expr-binding-clause-fields))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "ExprBindingClauseList"
              cbi.compiler-builtin-id-fix-ExprBindingClauseList
              (tc-stdlib-sequence-fields
                ctx
                cbi.compiler-builtin-id-fix-ExprBindingClause))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-enum
              ctx
              "Pattern"
              cbi.compiler-builtin-id-fix-Pattern
              (tc-stdlib-pattern-specs ctx))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "PatternList"
              cbi.compiler-builtin-id-fix-PatternList
              (tc-stdlib-sequence-fields
                ctx
                cbi.compiler-builtin-id-fix-Pattern))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "MatchArm"
              cbi.compiler-builtin-id-fix-MatchArm
              (tc-stdlib-match-arm-fields))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "MatchArmList"
              cbi.compiler-builtin-id-fix-MatchArmList
              (tc-stdlib-sequence-fields
                ctx
                cbi.compiler-builtin-id-fix-MatchArm))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "TypeInfoList"
              cbi.compiler-builtin-id-fix-TypeInfoList
              (tc-stdlib-sequence-fields
                ctx
                cbi.compiler-builtin-id-fix-TypeInfo))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "TypeField"
              cbi.compiler-builtin-id-fix-TypeField
              (tc-stdlib-type-field-fields))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "TypeFieldList"
              cbi.compiler-builtin-id-fix-TypeFieldList
              (tc-stdlib-sequence-fields
                ctx
                cbi.compiler-builtin-id-fix-TypeField))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "TypeVariantPayload"
              cbi.compiler-builtin-id-fix-TypeVariantPayload
              (tc-stdlib-type-variant-payload-fields))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "TypeVariantPayloadList"
              cbi.compiler-builtin-id-fix-TypeVariantPayloadList
              (tc-stdlib-sequence-fields
                ctx
                cbi.compiler-builtin-id-fix-TypeVariantPayload))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "TypeVariant"
              cbi.compiler-builtin-id-fix-TypeVariant
              (tc-stdlib-type-variant-fields))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "TypeVariantList"
              cbi.compiler-builtin-id-fix-TypeVariantList
              (tc-stdlib-sequence-fields
                ctx
                cbi.compiler-builtin-id-fix-TypeVariant))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "TypeParam"
              cbi.compiler-builtin-id-fix-TypeParam
              (tc-stdlib-type-param-fields))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-struct
              ctx
              "TypeParamList"
              cbi.compiler-builtin-id-fix-TypeParamList
              (tc-stdlib-sequence-fields
                ctx
                cbi.compiler-builtin-id-fix-TypeParam))))
        (set!
          result
          (tc-stdlib-comptime-surface-step
            result
            (tc-stdlib-check-enum
              ctx
              "TypeInfo"
              cbi.compiler-builtin-id-fix-TypeInfo
              (tc-stdlib-type-info-specs ctx))))
        result))))

(define (tc-stdlib-comptime-surface-ok [ctx : TcContext]) : ResultTcUnit
  (let
    [prev : AstNodePoolContext (ast-node-pool-context-capture-active)]
    [_install : unit (tc-context-install-pools! ctx)]
    ;; The well-known spec builder pushes fresh type nodes (e.g. the
    ;; `(Box Expr)` payload of ExprSplice) into this context's type-node pool.
    ;; In a long-lived `test --check --batch` process the captured pool snapshot
    ;; inherits a dedup index whose entries can point at slot ids that a later
    ;; batch entry's nodes now occupy, so a deduped spec push would resolve to a
    ;; slot holding an unrelated node and the well-known compare spuriously
    ;; mismatches. Drop the dedup index here (no live nodes are truncated) so
    ;; spec pushes rebuild it against the current entry's nodes only.
    [_dedup : unit
      (ast-node-pool-context-type-dedup-clear! (tc-context-pools ctx))]
    [result : ResultTcUnit (tc-stdlib-comptime-surface-ok-impl ctx)]
    (begin
      (tc-install-pools! prev)
      result)))

(define tc-stdlib-comptime-macro-surface-ok-ready : bool
  false)

(define (tc-stdlib-comptime-macro-surface-ok-reset!) : unit
  (set! tc-stdlib-comptime-macro-surface-ok-ready false))

(define (tc-stdlib-comptime-surface-ok-for-macro [ctx : TcContext]) : ResultTcUnit
  (if tc-stdlib-comptime-macro-surface-ok-ready
    ResultTcUnit.Ok
    (match (tc-stdlib-comptime-surface-ok ctx)
      [(ResultTcUnit.Ok)
        (begin
          (if (tc-stdlib-comptime-present? ctx)
            (set! tc-stdlib-comptime-macro-surface-ok-ready true)
            unit)
          ResultTcUnit.Ok)]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

(define (tc-bind-comptime-helper-aliases
  [env : TcTypeEnv]
  [name-id : i64]
  [ty : AstType]) : TcTypeEnv
  ;; Qualified `stdlib.comptime` helper calls are normalized to the legacy
  ;; helper key in name lookup. Keep one compatibility binding instead of
  ;; growing every macro helper environment with duplicate qualified aliases.
  (if (tc-source-name-bound-exact-id? env name-id)
    env
    (tc-bind-id env name-id ty)))

(define (tc-macro-helper-env [env : TcTypeEnv]) : TcTypeEnv
  (let
    [expr : AstType (AstType.Expr)]
    [clause : AstType (tc-macro-expr-clause-type)]
    [clause-list : AstType (tc-macro-expr-clause-list-type)]
    [binding-clause : AstType (tc-macro-expr-binding-clause-type)]
    [binding-clause-list : AstType (tc-macro-expr-binding-clause-list-type)]
    [pattern : AstType (tc-macro-pattern-type)]
    [pattern-list : AstType (tc-macro-pattern-list-type)]
    [match-arm : AstType (tc-macro-match-arm-type)]
    [match-arm-list : AstType (tc-macro-match-arm-list-type)]
    [type-info : AstType
      (AstType.Var
        (tc-stdlib-comptime-type-key-id
          "TypeInfo"
          cbi.compiler-builtin-id-fix-TypeInfo))]
    [out : TcTypeEnv env]
    (begin
      ;; Legacy bridge for unqualified macro helper names. New stdlib macro
      ;; code imports `stdlib.comptime` and calls the public helpers via that
      ;; module; keep only the old names still covered by compatibility tests
      ;; and by the legacy type-query surface.
      (set!
        out
        (tc-bind-id
          out
          (cbi.compiler-builtin-ctfe-ref 14)
          (tc-fn2 (AstType.String) (AstType.String) (AstType.String))))
      (set!
        out
        (tc-bind-comptime-helper-aliases
          out
          (cbi.compiler-builtin-ctfe-ref 14)
          (tc-fn2 (AstType.String) (AstType.String) (AstType.String))))
      (set!
        out
        (tc-bind-id
          out
          (cbi.compiler-builtin-ctfe-ref 15)
          (tc-fn2 (AstType.String) (AstType.String) (AstType.String))))
      (set!
        out
        (tc-bind-comptime-helper-aliases
          out
          (cbi.compiler-builtin-ctfe-ref 15)
          (tc-fn2 (AstType.String) (AstType.String) (AstType.String))))
      (set!
        out
        (tc-bind-id
          out
          (cbi.compiler-builtin-ctfe-ref 7)
          (tc-fn1 (AstType.String) (AstType.I64))))
      (set!
        out
        (tc-bind-id
          out
          (cbi.compiler-builtin-ctfe-ref 8)
          (tc-fn1 (AstType.String) (AstType.I64))))
      (set!
        out
        (tc-bind-id
          out
          (cbi.compiler-builtin-ctfe-ref 10)
          (tc-fn2 (AstType.String) (AstType.I64) (AstType.Char))))
      (set!
        out
        (tc-bind-id
          out
          (cbi.compiler-builtin-ctfe-ref 11)
          (tc-fn2 (AstType.String) (AstType.I64) (AstType.Char))))
      (set!
        out
        (tc-bind-id
          out
          (cbi.compiler-builtin-ctfe-ref 4)
          (tc-fn2 (AstType.String) (AstType.String) (AstType.Bool))))
      (set!
        out
        (tc-bind-id
          out
          (cbi.compiler-builtin-ctfe-ref 5)
          (tc-fn2 (AstType.String) (AstType.String) (AstType.Bool))))
      (set!
        out
        (tc-bind-id
          out
          (cbi.compiler-builtin-ctfe-ref 13)
          (tc-fn1 (AstType.String) (AstType.I64))))
      (set!
        out
        (tc-bind-comptime-helper-aliases
          out
          (cbi.compiler-builtin-ctfe-ref 105)
          (tc-fn1 (AstType.String) (AstType.I64))))
      (set!
        out
        (tc-bind-id
          out
          (cbi.compiler-builtin-ctfe-ref 16)
          (tc-fn1 (AstType.I64) (AstType.String))))
      (set!
        out
        (tc-bind-comptime-helper-aliases
          out
          (cbi.compiler-builtin-ctfe-ref 16)
          (tc-fn1 (AstType.I64) (AstType.String))))
      (set!
        out
        (tc-bind-id
          out
          (cbi.compiler-builtin-ctfe-ref 27)
          (tc-fn1 (AstType.Bool) expr)))
      (set!
        out
        (tc-bind-comptime-helper-aliases
          out
          (cbi.compiler-builtin-ctfe-ref 27)
          (tc-fn1 (AstType.Bool) expr)))
      (set!
        out
        (tc-bind-id
          out
          (cbi.compiler-builtin-ctfe-ref 28)
          (tc-fn1 (AstType.I64) expr)))
      (set!
        out
        (tc-bind-comptime-helper-aliases
