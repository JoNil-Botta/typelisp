(cfg
  compile-profile
  (define compiler-tc-macro-profile-start-ms : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-macro-walk-eval-alloc-start : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-macro-walk-eval-alloc-bytes : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-macro-walk-eval-live-start : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-macro-walk-eval-live-bytes : i64
    0))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-entries-empty) : CompilerTcMacroProfileEntries
    (CompilerTcMacroProfileEntries
      (array.make-array CompilerTcMacroProfileEntry 0)
      0
      (tc_i64_i64_map.with-capacity 1))))

(cfg
  compile-profile
  (define compiler-tc-macro-profile-entries : CompilerTcMacroProfileEntries
    (compiler-tc-macro-profile-entries-empty)))
(cfg
  compile-profile
  (define compiler-tc-macro-profile-active : bool
    false))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-reset) : unit
    (begin
      (set! compiler-tc-macro-profile-start-ms 0)
      (set! compiler-tc-macro-profile-active true)
      (set!
        compiler-tc-macro-profile-entries
        (compiler-tc-macro-profile-entries-empty)))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-clear) : unit
    (begin
      (set! compiler-tc-macro-profile-active false)
      (set!
        compiler-tc-macro-profile-entries
        (compiler-tc-macro-profile-entries-empty)))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-start) : unit
    (begin
      (set! compiler-tc-macro-profile-start-ms (profile.now-ms))
      (set! compiler-tc-macro-walk-eval-alloc-start (profile.alloc-total))
      (set! compiler-tc-macro-walk-eval-live-start (profile.alloc-live)))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-arg-count [args : ast.AstExprList]) : i64
    args.len))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-copy-prefix!
    [src : (& src (__tl_dyn-array CompilerTcMacroProfileEntry))]
    [dst : (&mut dst (__tl_dyn-array CompilerTcMacroProfileEntry))]
    [len : i64]) : unit
    (let
      [cursor : i64 0]
      (while (< cursor len)
        (begin
          (set! (array-ref dst cursor) (array-ref src cursor))
          (set! cursor (+ cursor 1)))))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-ensure-capacity!
    [entries : (&mut entries CompilerTcMacroProfileEntries)]) : unit
    (let
      [len : i64 entries.len]
      [old-capacity : i64 (array-length entries.slots)]
      (if (< len old-capacity)
        unit
        (let
          [next-capacity : i64
            (if (< old-capacity 1)
              16
              (* old-capacity 2))]
          [next : (__tl_dyn-array CompilerTcMacroProfileEntry)
            (array.make-array CompilerTcMacroProfileEntry next-capacity)]
          (begin
            (compiler-tc-macro-profile-copy-prefix!
              (& entries.slots)
              (&mut next)
              len)
            (set! entries.slots next)))))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-key-id [macro-id : i64] [arity : i64]) : i64
    (ci.intern-composite-pair-id macro-id arity)))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-record-in!
    [entries : (&mut entries CompilerTcMacroProfileEntries)]
    [macro-id : i64]
    [macro-name : String]
    [arity : i64]
    [elapsed-ms : i64]) : unit
    (let
      [key-id : i64 (compiler-tc-macro-profile-key-id macro-id arity)]
      (match (tc_i64_i64_map.get (& entries.index) key-id)
        [(tc_i64_i64_map.LookupFound entry-index)
          (let
            [entry : (&mut entries CompilerTcMacroProfileEntry)
              (&mut (array-ref entries.slots entry-index))]
            (begin
              (set! entry.calls (+ entry.calls 1))
              (set! entry.total-ms (+ entry.total-ms elapsed-ms))))]
        [(tc_i64_i64_map.LookupMissing)
          (begin
            (compiler-tc-macro-profile-ensure-capacity! entries)
            (let
              [entry-index : i64 entries.len]
              (begin
                (set!
                  (array-ref entries.slots entry-index)
                  (CompilerTcMacroProfileEntry
                    macro-id
                    (string.copy (& macro-name))
                    arity
                    1
                    elapsed-ms))
                (tc_i64_i64_map.insert-ref!
                  (&mut entries.index)
                  key-id
                  entry-index)
                (set! entries.len (+ entry-index 1)))))]))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-record
    [state : TcMacroState]
    [macro-id : i64]
    [macro-name : String]
    [arity : i64]
    [elapsed-ms : i64]) : unit
    (begin
      (set!
        compiler-tc-macro-walk-eval-alloc-bytes
        (+
          compiler-tc-macro-walk-eval-alloc-bytes
          (- (profile.alloc-total) compiler-tc-macro-walk-eval-alloc-start)))
      (set!
        compiler-tc-macro-walk-eval-live-bytes
        (+
          compiler-tc-macro-walk-eval-live-bytes
          (- (profile.alloc-live) compiler-tc-macro-walk-eval-live-start)))
      (if compiler-tc-macro-profile-active
        (compiler-tc-macro-profile-record-entry!
          state
          macro-id
          macro-name
          arity
          elapsed-ms)
        unit))))

;; The dense entry arrays and pair index outlive the declaration whose
;; expansion first appends to them. Under a per-declaration macro generation,
;; grow and insert in the macro-expansion scratch arena rather than in that
;; declaration's ambient generation. `compiler-tc-macro-profile-clear` drops
;; every handle immediately before `macro-expand-scratch-release!` destroys the
;; owner. Profile builds only; the shipped compiler compiles none of this.
(cfg
  compile-profile
  (define (compiler-tc-macro-profile-record-entry!
    [state : TcMacroState]
    [macro-id : i64]
    [macro-name : String]
    [arity : i64]
    [elapsed-ms : i64]) : unit
    (if (not (macro-generation-any-live? state))
      (compiler-tc-macro-profile-record-in!
        (&mut compiler-tc-macro-profile-entries)
        macro-id
        macro-name
        arity
        elapsed-ms)
      (in-arena
        (arena.Arena (macro-expand-scratch-arena-get state))
        (compiler-tc-macro-profile-record-in!
          (&mut compiler-tc-macro-profile-entries)
          macro-id
          macro-name
          arity
          elapsed-ms)))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-finish
    [state : TcMacroState]
    [macro-id : i64]
    [macro-name : String]
    [args : ast.AstExprList]) : unit
    (compiler-tc-macro-profile-record
      state
      macro-id
      macro-name
      (compiler-tc-macro-profile-arg-count args)
      (- (profile.now-ms) compiler-tc-macro-profile-start-ms))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-detail
    [macro-name : (& macro-name str)]
    [arity : i64]
    [calls : i64]) : String
    (let
      [arity-text : String (string.int->string arity)]
      [calls-text : String (string.int->string calls)]
      (str_cat.str-cat-scoped
        macro-name
        " arity="
        arity-text
        " calls="
        calls-text))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-emit-entry
    [macro-name : (& macro-name str)]
    [arity : i64]
    [calls : i64]
    [total-ms : i64]) : unit
    (cfg
      compile-profile-summary
      unit
      (io.print-error
        (str_cat.str-cat
          "compile-profile-detail|typecheck.macro_expand|"
          (string.int->string total-ms)
          "|"
          (compiler-tc-macro-profile-detail macro-name arity calls)
          "\n")))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-entry-index
    [entries : (& entries CompilerTcMacroProfileEntries)]
    [macro-id : i64]
    [arity : i64]) : i64
    (match (tc_i64_i64_map.get
      (& entries.index)
      (compiler-tc-macro-profile-key-id macro-id arity))
      [(tc_i64_i64_map.LookupFound entry-index) entry-index]
      [(tc_i64_i64_map.LookupMissing) -1])))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-count) : i64
    compiler-tc-macro-profile-entries.len))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-active?) : bool
    compiler-tc-macro-profile-active))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-current-entry-index
    [macro-id : i64]
    [arity : i64]) : i64
    (compiler-tc-macro-profile-entry-index
      (& compiler-tc-macro-profile-entries)
      macro-id
      arity)))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-current-entry [index : i64]) : CompilerTcMacroProfileEntry
    (array-ref
      (__tl-project-field
        (tc-global-shared-view compiler-tc-macro-profile-entries)
        slots)
      index)))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-emit-entries
    [entries : (& entries CompilerTcMacroProfileEntries)]) : unit
    (let
      [cursor : i64 0]
      (while (< cursor entries.len)
        (let
          [entry : CompilerTcMacroProfileEntry (array-ref entries.slots cursor)]
          (begin
            (compiler-tc-macro-profile-emit-entry
              (& entry.macro-name)
              entry.arity
              entry.calls
              entry.total-ms)
            (set! cursor (+ cursor 1))))))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-emit) : unit
    (begin
      (compiler-tc-macro-profile-emit-entries
        (& compiler-tc-macro-profile-entries))
      (set! compiler-tc-macro-profile-active false))))

(cfg
  compile-profile
  (define compiler-tc-reinfer-profile-site-count : i64
    18))
(cfg
  compile-profile
  (define compiler-tc-reinfer-profile-calls : (__tl_dyn-array i64)
    (array.make-array i64 18)))
(cfg
  compile-profile
  (define compiler-tc-reinfer-profile-ms : (__tl_dyn-array i64)
    (array.make-array i64 18)))
(cfg
  compile-profile
  (define compiler-tc-reinfer-profile-alloc : (__tl_dyn-array i64)
    (array.make-array i64 18)))
(cfg
  compile-profile
  (define compiler-tc-reinfer-profile-live : (__tl_dyn-array i64)
    (array.make-array i64 18)))
(cfg
  compile-profile
  (define compiler-tc-body-fact-profile-hits : (__tl_dyn-array i64)
    (array.make-array i64 18)))
(cfg
  compile-profile
  (define compiler-tc-body-fact-profile-misses : (__tl_dyn-array i64)
    (array.make-array i64 18)))

(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-site-index [site : String]) : i64
    (cond
      [(string.eq site "move.call_func") 0]
      [(string.eq site "move.call_arg") 1]
      [(string.eq site "move.let_init") 2]
      [(string.eq site "move.resource_init") 3]
      [(string.eq site "move.match_scrutinee") 4]
      [(string.eq site "move.tuple_list") 5]
      [(string.eq site "move.array_list") 6]
      [(string.eq site "move.bind_init") 7]
      [(string.eq site "borrow.call_func") 8]
      [(string.eq site "borrow.call_arg") 9]
      [(string.eq site "borrow.let_init") 10]
      [(string.eq site "borrow.resource_init") 11]
      [(string.eq site "borrow.match_scrutinee") 12]
      [(string.eq site "borrow.tuple_list") 13]
      [(string.eq site "borrow.array_list") 14]
      [(string.eq site "borrow.bind_init") 15]
      [(string.eq site "borrow.return_arg") 16]
      [(string.eq site "borrow.return_call") 17]
      [else -1])))

(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-site-name [index : i64]) : String
    (cond
      [(= index 0) "move.call_func"]
      [(= index 1) "move.call_arg"]
      [(= index 2) "move.let_init"]
      [(= index 3) "move.resource_init"]
      [(= index 4) "move.match_scrutinee"]
      [(= index 5) "move.tuple_list"]
      [(= index 6) "move.array_list"]
      [(= index 7) "move.bind_init"]
      [(= index 8) "borrow.call_func"]
      [(= index 9) "borrow.call_arg"]
      [(= index 10) "borrow.let_init"]
      [(= index 11) "borrow.resource_init"]
      [(= index 12) "borrow.match_scrutinee"]
      [(= index 13) "borrow.tuple_list"]
      [(= index 14) "borrow.array_list"]
      [(= index 15) "borrow.bind_init"]
      [(= index 16) "borrow.return_arg"]
      [(= index 17) "borrow.return_call"]
      [else "unknown"])))

(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-reset-at [index : i64]) : unit
    (if (< index compiler-tc-reinfer-profile-site-count)
      (begin
        (set! (array-ref compiler-tc-reinfer-profile-calls index) 0)
        (set! (array-ref compiler-tc-reinfer-profile-ms index) 0)
        (set! (array-ref compiler-tc-reinfer-profile-alloc index) 0)
        (set! (array-ref compiler-tc-reinfer-profile-live index) 0)
        (compiler-tc-reinfer-profile-reset-at (+ index 1)))
      unit)))

(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-reset) : unit
    (compiler-tc-reinfer-profile-reset-at 0)))

(cfg
  compile-profile
  (define (compiler-tc-body-fact-profile-reset-at [index : i64]) : unit
    (if (< index compiler-tc-reinfer-profile-site-count)
      (begin
        (set! (array-ref compiler-tc-body-fact-profile-hits index) 0)
        (set! (array-ref compiler-tc-body-fact-profile-misses index) 0)
        (compiler-tc-body-fact-profile-reset-at (+ index 1)))
      unit)))

(cfg
  compile-profile
  (define (compiler-tc-body-fact-profile-reset) : unit
    (compiler-tc-body-fact-profile-reset-at 0)))

(cfg
  compile-profile
  (define (compiler-tc-body-fact-profile-hit [site : String]) : unit
    (let
      [index : i64 (compiler-tc-reinfer-profile-site-index site)]
      (if (< index 0)
        unit
        (set!
          (array-ref compiler-tc-body-fact-profile-hits index)
          (+ (array.ref compiler-tc-body-fact-profile-hits index) 1))))))

(cfg
  compile-profile
  (define (compiler-tc-body-fact-profile-miss [site : String]) : unit
    (let
      [index : i64 (compiler-tc-reinfer-profile-site-index site)]
      (if (< index 0)
        unit
        (set!
          (array-ref compiler-tc-body-fact-profile-misses index)
          (+ (array.ref compiler-tc-body-fact-profile-misses index) 1))))))

(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-record
    [site : String]
    [start-ms : i64]
    [start-total : i64]
    [start-live : i64]) : unit
    (let
      [index : i64 (compiler-tc-reinfer-profile-site-index site)]
      (if (or (< index 0) (>= index compiler-tc-reinfer-profile-site-count))
        unit
        (begin
          (set!
            (array-ref compiler-tc-reinfer-profile-calls index)
            (+ (array-ref compiler-tc-reinfer-profile-calls index) 1))
          (set!
            (array-ref compiler-tc-reinfer-profile-ms index)
            (+
              (array-ref compiler-tc-reinfer-profile-ms index)
              (- (profile.now-ms) start-ms)))
          (set!
            (array-ref compiler-tc-reinfer-profile-alloc index)
            (+
              (array-ref compiler-tc-reinfer-profile-alloc index)
              (- (profile.alloc-total) start-total)))
          (set!
            (array-ref compiler-tc-reinfer-profile-live index)
            (+
              (array-ref compiler-tc-reinfer-profile-live index)
              (- (profile.alloc-live) start-live))))))))

(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-expr
    [site : String]
    [ctx : TcContext]
    [env : TcTypeEnv]
    [expr : ast.AstExpr]) : ResultTcType
    (let
      [start-ms : i64 (profile.now-ms)]
      [start-total : i64 (profile.alloc-total)]
      [start-live : i64 (profile.alloc-live)]
      [result : ResultTcType (tc-expr ctx env expr)]
      (begin
        (compiler-tc-reinfer-profile-record
          site
          start-ms
          start-total
          start-live)
        result))))

