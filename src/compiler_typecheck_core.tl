        [(ast.AstLiteral.Int n text)
          (ResultMacroSexpr.Ok (reader.SpannedSexpr.Int n text span))]
        [(ast.AstLiteral.Float text)
          (ResultMacroSexpr.Ok (reader.SpannedSexpr.Float text span))]
        [(ast.AstLiteral.Bool value)
