    (tc-profile-segment-splits "typecheck.macro.walk_segment_splits")
    (tc-profile-segment-delta-decls "typecheck.macro.walk_segment_delta_decls")
    (tc-profile-segment-fallback-flattens
      "typecheck.macro.walk_segment_fallback_flattens")
    (tc-profile-segment-fallback-alias-flattens
      "typecheck.macro.walk_segment_fallback_alias_flattens")
    (tc-profile-segment-fallback-file-flattens
      "typecheck.macro.walk_segment_fallback_file_flattens")
    (tc-profile-segment-final-flattens
      "typecheck.macro.walk_segment_final_flattens")))

(cfg
  (any compile-profile test)
  (define compiler-tc-splice-profile-first : i64
    tc-profile-splice-registry-invalidated))

;; Marker-path probes. Every marker batch flushes a delta cache, so the bounded
;; fallback environment build never runs and its rows stay zero.
(cfg
  compile-profile
  (counters.defcounters
    compiler-tc-walk-probe-profile
    (tc-profile-envbuild-alloc "typecheck.macro.walk_sp_envbuild_alloc_kb" kb)
    (tc-profile-envbuild-calls "typecheck.macro.walk_sp_envbuild_calls")
    (tc-profile-reresolve-alloc "typecheck.macro.walk_sp_reresolve_alloc_kb" kb)
    (tc-profile-reresolve-calls "typecheck.macro.walk_sp_reresolve_calls")))

(cfg
  compile-profile
  (counters.defcounters
    compiler-tc-layout-profile
    (tc-profile-layout-repr-c-field-builds
      "typecheck.layout.repr_c_field_builds")
    (tc-profile-layout-repr-c-field-visits
      "typecheck.layout.repr_c_field_visits")
    (tc-profile-layout-inline-field-builds
      "typecheck.layout.inline_field_builds")
    (tc-profile-layout-inline-field-visits
      "typecheck.layout.inline_field_visits")
    (tc-profile-layout-inline-payload-builds
      "typecheck.layout.inline_payload_builds")
    (tc-profile-layout-inline-payload-visits
      "typecheck.layout.inline_payload_visits")
    (tc-profile-layout-inline-variant-builds
      "typecheck.layout.inline_variant_builds")
    (tc-profile-layout-inline-variant-visits
      "typecheck.layout.inline_variant_visits")
    (tc-profile-layout-stdlib-field-spec-builds
      "typecheck.layout.stdlib_field_spec_builds")
    (tc-profile-layout-stdlib-field-spec-visits
      "typecheck.layout.stdlib_field_spec_visits")
    (tc-profile-layout-stdlib-variant-spec-builds
      "typecheck.layout.stdlib_variant_spec_builds")
    (tc-profile-layout-stdlib-variant-spec-visits
      "typecheck.layout.stdlib_variant_spec_visits")
    (tc-profile-layout-cache-hits "typecheck.layout.cache_hits")
    (tc-profile-layout-cache-misses "typecheck.layout.cache_misses")
    (tc-profile-layout-cache-bypasses "typecheck.layout.cache_bypasses")))

;; Walk-region interval starts. An operand capture is either a bound
;; interpreted parameter list or a direct native marshal; a decl-loop
;; iteration that captured operands fired a macro.
(cfg
  compile-profile
  (define compiler-tc-walk-operand-captures : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-walk-direct-marshal-start-ns : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-walk-direct-marshal-start-alloc : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-walk-direct-marshal-start-live : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-walk-reresolve-start-alloc : i64
    0))

(cfg
  compile-profile
  (define (compiler-tc-walk-direct-marshal-start!) : unit
    (set! compiler-tc-walk-direct-marshal-start-ns (compiler-tc-walk-now-ns))
    (set! compiler-tc-walk-direct-marshal-start-alloc (profile.alloc-total))
    (set! compiler-tc-walk-direct-marshal-start-live (profile.alloc-live))))

(cfg
  compile-profile
  (define (compiler-tc-walk-direct-marshal-finish!) : unit
    (counters.add!
      tc-profile-direct-marshal-ns
      (- (compiler-tc-walk-now-ns) compiler-tc-walk-direct-marshal-start-ns))
    (counters.add!
      tc-profile-direct-marshal-alloc
      (- (profile.alloc-total) compiler-tc-walk-direct-marshal-start-alloc))
    (counters.add!
      tc-profile-direct-marshal-live
      (- (profile.alloc-live) compiler-tc-walk-direct-marshal-start-live))
    (counters.bump! tc-profile-direct-marshal-calls)
    (counters.bump! compiler-tc-walk-operand-captures)))

(cfg
  compile-profile
  (define (compiler-tc-stdlib-tlci-entry-timer-start!
    [state : TcMacroState]
    [start-metric : i64]) : unit
    (compiler-tc-profile-metric-set!
      (compiler-tc-macro-profile-metrics-address state)
      start-metric
      (compiler-tc-walk-now-ns))))

(cfg
  compile-profile
  (define (compiler-tc-stdlib-tlci-entry-timer-finish!
    [state : TcMacroState]
    [start-metric : i64]
    [ns-metric : i64]
    [calls-metric : i64]) : unit
    (compiler-tc-macro-profile-metric-add!
      state
      ns-metric
      (-
        (compiler-tc-walk-now-ns)
        (compiler-tc-profile-metric-value
          (compiler-tc-macro-profile-metrics-address state)
          start-metric)))
    (compiler-tc-macro-profile-metric-add! state calls-metric 1)))

(cfg
  compile-profile
  (define (compiler-tc-walk-reresolve-start!) : unit
    (set! compiler-tc-walk-reresolve-start-alloc (profile.alloc-total))))

(cfg
  compile-profile
  (define (compiler-tc-walk-reresolve-finish!) : unit
    (counters.add!
      tc-profile-reresolve-alloc
      (- (profile.alloc-total) compiler-tc-walk-reresolve-start-alloc))
    (counters.bump! tc-profile-reresolve-calls)))

;; An intermediate segmented-program flatten names its conservative reason:
;; 1 = an alias import, 2 = a file import.
(cfg
  (any compile-profile test)
  (define (compiler-tc-walk-segment-fallback-flatten-note!
    [state : TcMacroState]
    [reason : i64]) : unit
    (compiler-tc-macro-profile-metric-add!
      state
      tc-profile-segment-fallback-flattens
      1)
    (cond
      [(= reason 1)
        (compiler-tc-macro-profile-metric-add!
          state
          tc-profile-segment-fallback-alias-flattens
          1)]
      [(= reason 2)
        (compiler-tc-macro-profile-metric-add!
          state
          tc-profile-segment-fallback-file-flattens
          1)]
      [else unit])))

;; Per-decl sampler for the expansion walk's decl loop. Each iteration notes
;; its arm (2 = walked decl, 7 = generated-normal-import materialization; the
;; other arms are bookkeeping and splices), and a walked decl that captured
;; macro operands adds its time and live bytes to the fired bucket.
(cfg
  compile-profile
  (define compiler-tc-walk-decl-sample-kind : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-walk-decl-sample-start-ns : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-walk-decl-sample-start-live : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-walk-decl-sample-start-captures : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-walk-decl-sample-start-pool-contexts : i64
    0))

(cfg
  compile-profile
  (define (compiler-tc-walk-decl-sample-note! [kind : i64]) : unit
    (set! compiler-tc-walk-decl-sample-kind kind)))

(cfg
  compile-profile
  (define compiler-tc-walk-decl-fire-boundary-live : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-walk-decl-fire-boundary-pending : bool
    false))

;; Union of the two nested fired-decl lanes.  Hygiene can run inside a
;; produced-node rewalk, so subtracting the two lanes independently
;; double-counts their overlap.  This depth counts outer lane activations and
;; times their union once; fired self time is fire total minus this value.
(cfg
  compile-profile
  (define compiler-tc-walk-decl-fire-child-depth : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-walk-decl-fire-child-start-ns : i64
    0))

(cfg
  compile-profile
  (define (compiler-tc-walk-decl-fire-child-enter!) : unit
    (when
      (= compiler-tc-walk-decl-sample-kind 2)
      (if (= compiler-tc-walk-decl-fire-child-depth 0)
        (set!
          compiler-tc-walk-decl-fire-child-start-ns
          (compiler-tc-walk-now-ns))
        unit)
      (set!
        compiler-tc-walk-decl-fire-child-depth
        (+ compiler-tc-walk-decl-fire-child-depth 1)))))

(cfg
  compile-profile
  (define (compiler-tc-walk-decl-fire-child-leave!) : unit
    (when
      (> compiler-tc-walk-decl-fire-child-depth 0)
      (set!
        compiler-tc-walk-decl-fire-child-depth
        (- compiler-tc-walk-decl-fire-child-depth 1))
      (if (= compiler-tc-walk-decl-fire-child-depth 0)
        (counters.add!
          tc-profile-fire-nested-ns
          (-
            (compiler-tc-walk-now-ns)
            compiler-tc-walk-decl-fire-child-start-ns))
        unit))))

;; Return bytes allocated in an arena since a cursor mark.  The active chain is
;; newest-first, so the common case (one declaration stays in its current
;; segment) is one iteration.  Unlike a whole-arena census this work is bounded
;; by segments grown by this declaration and runs only after a macro actually
;; fired, keeping the profiler from becoming a material compiler workload.
(cfg
  compile-profile
  (define (compiler-tc-profile-arena-bytes-since
    [arena-handle : i64]
    [mark : i64]) : i64
    (if (or (= arena-handle 0) (= mark 0))
      0
      (let
        [root-candidate : i64
          (unsafe
            (ptr-read (ptr-offset (int->ptr arena-handle : (Ptr i64)) 5)))]
        [root : i64
          (if (= root-candidate 0)
            arena-handle
            root-candidate)]
        [active : i64
          (let
            [current : i64
              (unsafe
                (ptr-read (ptr-offset (int->ptr root : (Ptr i64)) 7)))]
            (if (= current 0)
              root
              current))]
        [used : i64 0]
        [cursor : i64 active]
        [done : bool false]
        (while (and (not done) (not (= cursor 0)))
          (let
            [base : i64
              (unsafe
                (ptr-read (ptr-offset (int->ptr cursor : (Ptr i64)) 1)))]
            [end : i64
              (unsafe
                (ptr-read (ptr-offset (int->ptr cursor : (Ptr i64)) 2)))]
            (begin
              (if (and (>= mark base) (<= mark end))
                (begin
                  (set! used (+ used (- end mark)))
                  (set! done true))
                (begin
                  (if (> end base)
                    (set! used (+ used (- end base)))
                    unit)
                  (set!
                    cursor
                    (unsafe
                      (ptr-read (ptr-offset (int->ptr cursor : (Ptr i64)) 0)))))))))
        used))))

(cfg
  compile-profile
  (define (compiler-tc-walk-decl-fire-attribution-note!
    [survivor-alloc : i64]
    [survivor-live : i64]
    [superseded-alloc : i64]
    [superseded-released : i64]
    [committed-live : i64]
    [boundary-live : i64]
    [source-expr-refs : i64]
    [source-type-refs : i64]
    [survivor-expr-nodes : i64]
    [survivor-type-nodes : i64]) : unit
    (counters.bump! tc-profile-fire-attributed-calls)
    (counters.add! tc-profile-fire-survivor-alloc survivor-alloc)
    (counters.add! tc-profile-fire-survivor-live survivor-live)
    (counters.add! tc-profile-fire-superseded-alloc superseded-alloc)
    (counters.add! tc-profile-fire-superseded-released superseded-released)
    (counters.add! tc-profile-fire-committed-live committed-live)
    (set! compiler-tc-walk-decl-fire-boundary-live boundary-live)
    (set! compiler-tc-walk-decl-fire-boundary-pending true)
    (counters.add! tc-profile-fire-source-shared-expr-refs source-expr-refs)
    (counters.add! tc-profile-fire-source-shared-type-refs source-type-refs)
    (counters.add! tc-profile-fire-survivor-expr-nodes survivor-expr-nodes)
    (counters.add! tc-profile-fire-survivor-type-nodes survivor-type-nodes)))

;; Called at the top of every decl-loop iteration: flush the previous
;; iteration's sample (its arm noted a kind), then restart the sample
;; window for the coming one.
(cfg
  compile-profile
  (define (compiler-tc-walk-decl-sample-flush!) : unit
    (let
      [fired : bool
        (>
          compiler-tc-walk-operand-captures
          compiler-tc-walk-decl-sample-start-captures)]
      [kind : i64 compiler-tc-walk-decl-sample-kind]
      (if (and fired compiler-tc-walk-decl-fire-boundary-pending)
        (counters.add!
          tc-profile-fire-post-boundary-live
          (- (profile.alloc-live) compiler-tc-walk-decl-fire-boundary-live))
        unit)
      (set! compiler-tc-walk-decl-fire-boundary-pending false)
      (cond
        [(= kind 7) (counters.bump! tc-profile-materialized-splices)]
        [(and fired (= kind 2))
          (counters.add!
            tc-profile-fire-ns
            (- (compiler-tc-walk-now-ns) compiler-tc-walk-decl-sample-start-ns))
          (counters.add!
            tc-profile-fire-live
            (- (profile.alloc-live) compiler-tc-walk-decl-sample-start-live))
          (counters.add!
            tc-profile-fire-pool-contexts
            (-
              ast.ast-node-pool-context-profile-allocations
              compiler-tc-walk-decl-sample-start-pool-contexts))
          (counters.bump! tc-profile-fire-count)]
        [else unit])
      (set! compiler-tc-walk-decl-sample-kind 0)
      (set! compiler-tc-walk-decl-sample-start-ns (compiler-tc-walk-now-ns))
      (set! compiler-tc-walk-decl-sample-start-live (profile.alloc-live))
      (set!
        compiler-tc-walk-decl-sample-start-pool-contexts
        ast.ast-node-pool-context-profile-allocations)
      (set!
        compiler-tc-walk-decl-sample-start-captures
        compiler-tc-walk-operand-captures))))

;; Hygiene-rebuild and transformer-output-rewalk regions. Both re-enter
;; themselves (hygiene through its own recursion, the output re-walk through
;; nested expansions), so a depth counter times only the outermost activation.
(cfg
  compile-profile
  (define compiler-tc-walk-hygiene-depth : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-walk-rewalk-depth : i64
    0))

(cfg
  compile-profile
  (define (compiler-tc-walk-hygiene-start!) : unit
    (set! compiler-tc-walk-hygiene-depth (+ compiler-tc-walk-hygiene-depth 1))
    (if (= compiler-tc-walk-hygiene-depth 1)
      (compiler-tc-walk-decl-fire-child-enter!)
      unit)))

(cfg
  compile-profile
  (define (compiler-tc-walk-hygiene-finish!) : unit
    (if (= compiler-tc-walk-hygiene-depth 1)
      (compiler-tc-walk-decl-fire-child-leave!)
      unit)
    (set! compiler-tc-walk-hygiene-depth (- compiler-tc-walk-hygiene-depth 1))))

(cfg
  compile-profile
  (define (compiler-tc-walk-rewalk-start!) : unit
    (set! compiler-tc-walk-rewalk-depth (+ compiler-tc-walk-rewalk-depth 1))
    (if (= compiler-tc-walk-rewalk-depth 1)
      (compiler-tc-walk-decl-fire-child-enter!)
      unit)))

(cfg
  compile-profile
  (define (compiler-tc-walk-rewalk-finish!) : unit
    (if (= compiler-tc-walk-rewalk-depth 1)
      (compiler-tc-walk-decl-fire-child-leave!)
      unit)
    (set! compiler-tc-walk-rewalk-depth (- compiler-tc-walk-rewalk-depth 1))))

(cfg
  compile-profile
  (define compiler-tc-macro-profile-start-ms : i64
    0))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-entries-empty) : CompilerTcMacroProfileEntries
    (CompilerTcMacroProfileEntries
      (__tl_make-array CompilerTcMacroProfileEntry 0)
      0
      (tc_i64_i64_map.with-capacity 1))))

(cfg
  compile-profile
  (define compiler-tc-macro-profile-entries : CompilerTcMacroProfileEntries
    (compiler-tc-macro-profile-entries-empty)))
(cfg
  compile-profile
  (define compiler-tc-macro-profile-active : bool
    false))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-reset) : unit
    (set! compiler-tc-macro-profile-start-ms 0)
    (set! compiler-tc-macro-profile-active true)
    (set!
      compiler-tc-macro-profile-entries
      (compiler-tc-macro-profile-entries-empty))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-clear) : unit
    (set! compiler-tc-macro-profile-active false)
    (set!
      compiler-tc-macro-profile-entries
      (compiler-tc-macro-profile-entries-empty))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-start) : unit
    (set! compiler-tc-macro-profile-start-ms (profile.now-ms))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-arg-count [args : ast.AstExprList]) : i64
    args.len))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-copy-prefix!
    [src : (& src (__tl_dyn-array CompilerTcMacroProfileEntry))]
    [dst : (&mut dst (__tl_dyn-array CompilerTcMacroProfileEntry))]
    [len : i64]) : unit
    (let
      [cursor : i64 0]
      (while (< cursor len)
        (set! (array-ref dst cursor) (array-ref src cursor))
        (set! cursor (+ cursor 1))))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-ensure-capacity!
    [entries : (&mut entries CompilerTcMacroProfileEntries)]) : unit
    (let
      [len : i64 entries.len]
      [old-capacity : i64 (array-length entries.slots)]
      (if (< len old-capacity)
        unit
        (let
          [next-capacity : i64
            (if (< old-capacity 1)
              16
              (* old-capacity 2))]
          [next : (__tl_dyn-array CompilerTcMacroProfileEntry)
            (__tl_make-array CompilerTcMacroProfileEntry next-capacity)]
          (compiler-tc-macro-profile-copy-prefix!
            (& entries.slots)
            (&mut next)
            len)
          (set! entries.slots next))))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-key-id [macro-id : i64] [arity : i64]) : i64
    (ci.intern-composite-pair-id macro-id arity)))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-record-in!
    [entries : (&mut entries CompilerTcMacroProfileEntries)]
    [macro-id : i64]
    [macro-name : String]
    [arity : i64]
    [elapsed-ms : i64]) : unit
    (let
      [key-id : i64 (compiler-tc-macro-profile-key-id macro-id arity)]
      (match (tc_i64_i64_map.get (& entries.index) key-id)
        [(LookupFound entry-index)
          (let
            [entry : (&mut entries CompilerTcMacroProfileEntry)
              (&mut (array-ref entries.slots entry-index))]
            (set! entry.calls (+ entry.calls 1))
            (set! entry.total-ms (+ entry.total-ms elapsed-ms)))]
        [(LookupMissing)
          (compiler-tc-macro-profile-ensure-capacity! entries)
          (let
            [entry-index : i64 entries.len]
            (set!
              (array-ref entries.slots entry-index)
              (CompilerTcMacroProfileEntry
                macro-id
                (string.copy (& macro-name))
                arity
                1
                elapsed-ms))
            (tc_i64_i64_map.insert-ref! (&mut entries.index) key-id entry-index)
            (set! entries.len (+ entry-index 1)))]))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-record
    [state : TcMacroState]
    [macro-id : i64]
    [macro-name : String]
    [arity : i64]
    [elapsed-ms : i64]) : unit
    (if compiler-tc-macro-profile-active
      (compiler-tc-macro-profile-record-entry!
        state
        macro-id
        macro-name
        arity
        elapsed-ms)
      unit)))

;; The dense entry arrays and pair index outlive the declaration whose
;; expansion first appends to them. Under a per-declaration macro generation,
;; grow and insert in the macro-expansion scratch arena rather than in that
;; declaration's ambient generation. `compiler-tc-macro-profile-clear` drops
;; every handle immediately before `macro-expand-scratch-release!` destroys the
;; owner. Profile builds only; the shipped compiler compiles none of this.
(cfg
  compile-profile
  (define (compiler-tc-macro-profile-record-entry!
    [state : TcMacroState]
    [macro-id : i64]
    [macro-name : String]
    [arity : i64]
    [elapsed-ms : i64]) : unit
    (if (not (macro-generation-any-live? state))
      (compiler-tc-macro-profile-record-in!
        (&mut compiler-tc-macro-profile-entries)
        macro-id
        macro-name
        arity
        elapsed-ms)
      (in-arena
        (arena.Arena (macro-expand-scratch-arena-get state))
        (compiler-tc-macro-profile-record-in!
          (&mut compiler-tc-macro-profile-entries)
          macro-id
          macro-name
          arity
          elapsed-ms)))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-finish
    [state : TcMacroState]
    [macro-id : i64]
    [macro-name : String]
    [args : ast.AstExprList]) : unit
    (compiler-tc-macro-profile-record
      state
      macro-id
      macro-name
      (compiler-tc-macro-profile-arg-count args)
      (- (profile.now-ms) compiler-tc-macro-profile-start-ms))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-detail
    [macro-name : (& macro-name str)]
    [arity : i64]
    [calls : i64]) : String
    (let
      [arity-text : String (string.int->string arity)]
      [calls-text : String (string.int->string calls)]
      (str_cat.str-cat-scoped
        macro-name
        " arity="
        arity-text
        " calls="
        calls-text))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-emit-entry
    [macro-name : (& macro-name str)]
    [arity : i64]
    [calls : i64]
    [total-ms : i64]) : unit
    (cfg
      compile-profile-summary
      unit
      (io.print-error
        (str_cat.str-cat
          "compile-profile-detail|typecheck.macro_expand|"
          (string.int->string total-ms)
          "|"
          (compiler-tc-macro-profile-detail macro-name arity calls)
          "\n")))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-entry-index
    [entries : (& entries CompilerTcMacroProfileEntries)]
    [macro-id : i64]
    [arity : i64]) : i64
    (match (tc_i64_i64_map.get
      (& entries.index)
      (compiler-tc-macro-profile-key-id macro-id arity))
      [(LookupFound entry-index) entry-index]
      [(LookupMissing) -1])))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-count) : i64
    compiler-tc-macro-profile-entries.len))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-active?) : bool
    compiler-tc-macro-profile-active))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-current-entry-index
    [macro-id : i64]
    [arity : i64]) : i64
    (compiler-tc-macro-profile-entry-index
      (& compiler-tc-macro-profile-entries)
      macro-id
      arity)))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-current-entry [index : i64]) : CompilerTcMacroProfileEntry
    (clone
      (array-ref
        (__tl-project-field compiler-tc-macro-profile-entries slots)
        index))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-emit-entries
    [entries : (& entries CompilerTcMacroProfileEntries)]) : unit
    (let
      [cursor : i64 0]
      (while (< cursor entries.len)
        (let
          [entry : (& entries CompilerTcMacroProfileEntry)
            (& (array-ref entries.slots cursor))]
          (compiler-tc-macro-profile-emit-entry
            (& entry.macro-name)
            entry.arity
            entry.calls
            entry.total-ms)
          (set! cursor (+ cursor 1)))))))

(cfg
  compile-profile
  (define (compiler-tc-macro-profile-emit) : unit
    (compiler-tc-macro-profile-emit-entries
      (& compiler-tc-macro-profile-entries))
    (set! compiler-tc-macro-profile-active false)))

;; Packed job-owned view (CompilerProfileState slots 242-373): four reinference
;; columns followed by the body-fact hit/miss columns, one slot per profiled
;; site, then the macro walk's splice counters (compiler-tc-splice-profile,
;; relative 18-35). Relative slots 108-118 and 126-127 map to the driver/loader
;; lifetime ledger; relative slots 120-125 and 128-131 retain macro lifetime
;; boundary starts. Keeping the six equal-width families contiguous makes reset/render
;; order deterministic without reintroducing array owners in this leaf module.
(cfg
  (any compile-profile test)
  (define compiler-tc-reinfer-profile-site-count : i64
    3))
(cfg
  (any compile-profile test)
  (define compiler-tc-reinfer-profile-calls-start : i64
    0))
(cfg
  (any compile-profile test)
  (define compiler-tc-reinfer-profile-ms-start : i64
    3))
(cfg
  (any compile-profile test)
  (define compiler-tc-reinfer-profile-alloc-start : i64
    6))
(cfg
  (any compile-profile test)
  (define compiler-tc-reinfer-profile-live-start : i64
    9))
(cfg
  (any compile-profile test)
  (define compiler-tc-body-fact-profile-hits-start : i64
    12))
(cfg
  (any compile-profile test)
  (define compiler-tc-body-fact-profile-misses-start : i64
    15))
(cfg
  (any compile-profile test)
  (define compiler-tc-profile-metric-count : i64
    133))

(cfg
  (any compile-profile test)
  (counters.defslots
    compiler-tc-macro-lifetime-starts
    120
    (compiler-tc-macro-lifetime-start-total-metric)
    (compiler-tc-macro-lifetime-start-live-metric)
    (compiler-tc-macro-lifetime-start-peak-metric)
    (compiler-tc-macro-lifetime-start-pool-base-metric)
    (compiler-tc-macro-lifetime-start-expr-pool-metric)
    (compiler-tc-macro-lifetime-start-type-pool-metric)))

(cfg
  (any compile-profile test)
  (counters.defslots
    compiler-tc-macro-lifetime-owner-starts
    128
    (compiler-tc-macro-lifetime-start-enclosing-handle-metric)
    (compiler-tc-macro-lifetime-start-enclosing-bytes-metric)
    (compiler-tc-macro-lifetime-start-job-owner-bytes-metric)
    (compiler-tc-macro-lifetime-start-scoped-env-bytes-metric)
    (compiler-tc-macro-lifetime-start-intern-bytes-metric)))

(cfg
  (any compile-profile test)
  (define (compiler-tc-macro-profile-metrics-address [state : TcMacroState]) : u64
    (cast
      (tc-macro-state-slot-address state tc-macro-state-slot-profile-metrics)
      : u64)))

(cfg
  (any compile-profile test)
  (define (compiler-tc-profile-metrics-address [state : TcJobState]) : u64
    (compiler-tc-macro-profile-metrics-address (tc-job-state-macro-state state))))

(cfg
  (any compile-profile test)
  (define (compiler-tc-profile-metric-value
    [metrics-address : u64]
    [metric : i64]) : i64
    (if (= metrics-address (cast 0 : u64))
      0
      (unsafe
        (ptr-read (ptr-offset (int->ptr metrics-address : (Ptr i64)) metric))))))

(cfg
  (any compile-profile test)
  (define (compiler-tc-profile-metric-set!
    [metrics-address : u64]
    [metric : i64]
    [value : i64]) : unit
    (if (= metrics-address (cast 0 : u64))
      unit
      (unsafe
        (ptr-write!
          (ptr-offset (int->ptr metrics-address : (MutPtr i64)) metric)
          value)))))

(cfg
  (any compile-profile test)
  (define (compiler-tc-profile-metric-add!
    [metrics-address : u64]
    [metric : i64]
    [value : i64]) : unit
    (compiler-tc-profile-metric-set!
      metrics-address
      metric
      (+ (compiler-tc-profile-metric-value metrics-address metric) value))))

(cfg
  (any compile-profile test)
  (define (compiler-tc-macro-profile-metric-add!
    [state : TcMacroState]
    [metric : i64]
    [value : i64]) : unit
    (compiler-tc-profile-metric-add!
      (compiler-tc-macro-profile-metrics-address state)
      metric
      value)))

(cfg
  (any compile-profile test)
  (define (compiler-tc-profile-metric-reset-range!
    [metrics-address : u64]
    [start : i64]
    [end : i64]) : unit
    (let
      [metric : i64 start]
      (while (< metric end)
        (compiler-tc-profile-metric-set! metrics-address metric 0)
        (set! metric (+ metric 1))))))

;; Raise a counter of the job's view to `value` when that is larger.
(cfg
  (any compile-profile test)
  (define (compiler-tc-macro-profile-metric-max!
    [state : TcMacroState]
    [metric : i64]
    [value : i64]) : unit
    (let
      [metrics-address : u64 (compiler-tc-macro-profile-metrics-address state)]
      (if (> value (compiler-tc-profile-metric-value metrics-address metric))
        (compiler-tc-profile-metric-set! metrics-address metric value)
        unit))))

;; The splice counters reset with each macro-expansion program.
(cfg
  (any compile-profile test)
  (define (compiler-tc-splice-profile-reset [state : TcJobState]) : unit
    (compiler-tc-profile-metric-reset-range!
      (compiler-tc-profile-metrics-address state)
      compiler-tc-splice-profile-first
      compiler-tc-splice-profile-end)))

;; The macro-program counters reset with each macro-expansion program.
(cfg
  (any compile-profile test)
  (define (compiler-tc-macro-program-profile-reset [state : TcJobState]) : unit
    (compiler-tc-profile-metric-reset-range!
      (compiler-tc-profile-metrics-address state)
      compiler-tc-macro-program-profile-first
      compiler-tc-macro-program-profile-end)))

(cfg
  (any compile-profile test)
  (define (compiler-tc-reinfer-profile-site-index [site : String]) : i64
    (cond
      [(string.eq site "move.call_func") 0]
      [(string.eq site "borrow.call_func") 1]
      [(string.eq site "borrow.call_arg") 2]
      [else -1])))

(cfg
  (any compile-profile test)
  (define (compiler-tc-reinfer-profile-site-name [index : i64]) : String
    (cond
      [(= index 0) "move.call_func"]
      [(= index 1) "borrow.call_func"]
      [else "borrow.call_arg"])))

(cfg
  (any compile-profile test)
  (define (compiler-tc-reinfer-profile-reset-at
    [metrics-address : u64]
    [index : i64]) : unit
    (if (< index compiler-tc-reinfer-profile-site-count)
      (begin
        (compiler-tc-profile-metric-set!
          metrics-address
          (+ compiler-tc-reinfer-profile-calls-start index)
          0)
        (compiler-tc-profile-metric-set!
          metrics-address
          (+ compiler-tc-reinfer-profile-ms-start index)
          0)
        (compiler-tc-profile-metric-set!
          metrics-address
          (+ compiler-tc-reinfer-profile-alloc-start index)
          0)
        (compiler-tc-profile-metric-set!
          metrics-address
          (+ compiler-tc-reinfer-profile-live-start index)
          0)
        (compiler-tc-reinfer-profile-reset-at metrics-address (+ index 1)))
      unit)))

(cfg
  (any compile-profile test)
  (define (compiler-tc-reinfer-profile-reset [state : TcJobState]) : unit
    (compiler-tc-reinfer-profile-reset-at
      (compiler-tc-profile-metrics-address state)
      0)))

(cfg
  (any compile-profile test)
  (define (compiler-tc-body-fact-profile-reset-at
    [metrics-address : u64]
    [index : i64]) : unit
    (if (< index compiler-tc-reinfer-profile-site-count)
      (begin
        (compiler-tc-profile-metric-set!
          metrics-address
          (+ compiler-tc-body-fact-profile-hits-start index)
          0)
        (compiler-tc-profile-metric-set!
          metrics-address
          (+ compiler-tc-body-fact-profile-misses-start index)
          0)
        (compiler-tc-body-fact-profile-reset-at metrics-address (+ index 1)))
      unit)))

(cfg
  (any compile-profile test)
  (define (compiler-tc-body-fact-profile-reset [state : TcJobState]) : unit
    (compiler-tc-body-fact-profile-reset-at
      (compiler-tc-profile-metrics-address state)
      0)))

(cfg
  (any compile-profile test)
  (define (compiler-tc-body-fact-profile-hit
    [state : TcJobState]
    [site : String]) : unit
    (let
      [index : i64 (compiler-tc-reinfer-profile-site-index site)]
      (if (< index 0)
        unit
        (compiler-tc-profile-metric-add!
          (compiler-tc-profile-metrics-address state)
          (+ compiler-tc-body-fact-profile-hits-start index)
          1)))))

(cfg
  (any compile-profile test)
  (define (compiler-tc-body-fact-profile-miss
    [state : TcJobState]
    [site : String]) : unit
    (let
      [index : i64 (compiler-tc-reinfer-profile-site-index site)]
      (if (< index 0)
        unit
        (compiler-tc-profile-metric-add!
          (compiler-tc-profile-metrics-address state)
          (+ compiler-tc-body-fact-profile-misses-start index)
          1)))))

(cfg
  (any compile-profile test)
  (define (compiler-tc-reinfer-profile-note
    [state : TcJobState]
    [site : String]
    [elapsed-ms : i64]
    [alloc-delta : i64]
    [live-delta : i64]) : unit
    (let
      [index : i64 (compiler-tc-reinfer-profile-site-index site)]
      [metrics-address : u64 (compiler-tc-profile-metrics-address state)]
      (if (or (< index 0) (>= index compiler-tc-reinfer-profile-site-count))
        unit
        (begin
          (compiler-tc-profile-metric-add!
            metrics-address
            (+ compiler-tc-reinfer-profile-calls-start index)
            1)
          (compiler-tc-profile-metric-add!
            metrics-address
            (+ compiler-tc-reinfer-profile-ms-start index)
            elapsed-ms)
          (compiler-tc-profile-metric-add!
            metrics-address
            (+ compiler-tc-reinfer-profile-alloc-start index)
            alloc-delta)
          (compiler-tc-profile-metric-add!
            metrics-address
            (+ compiler-tc-reinfer-profile-live-start index)
            live-delta))))))

(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-record
    [state : TcJobState]
    [site : String]
    [start-ms : i64]
    [start-total : i64]
    [start-live : i64]) : unit
    (compiler-tc-reinfer-profile-note
      state
      site
      (- (profile.now-ms) start-ms)
      (- (profile.alloc-total) start-total)
      (- (profile.alloc-live) start-live))))

;; Time `body`, the re-inference at `site`, into that site's reinference row.
(defmacro (compiler-tc-reinfer-profiled
  [_ctx : Expr]
  [_site : Expr]
  [body : Expr]) : Expr
  (cfg
    compile-profile
    `(let
      [start-ms : i64 (profile.now-ms)]
      [start-total : i64 (profile.alloc-total)]
      [start-live : i64 (profile.alloc-live)]
      [result ,body]
      (compiler-tc-reinfer-profile-record
        (tc-context-job-state ,_ctx)
        ,_site
        start-ms
        start-total
        start-live)
      result)
    body))

(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-line
    [site : String]
    [elapsed-ms : i64]
    [alloc-delta : i64]
    [live-delta : i64]) : unit
    (io.print-error
      (str_cat.str-cat
        "compile-profile|typecheck.reinfer."
        site
        (compiler-tc-profile-field elapsed-ms)
        (compiler-tc-profile-field alloc-delta)
        (compiler-tc-profile-field live-delta)
        "|0\n"))))

(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-emit-entry
    [metrics-address : u64]
    [index : i64]) : unit
    (compiler-tc-reinfer-profile-line
      (compiler-tc-reinfer-profile-site-name index)
      (compiler-tc-profile-metric-value
        metrics-address
        (+ compiler-tc-reinfer-profile-ms-start index))
      (compiler-tc-profile-metric-value
        metrics-address
        (+ compiler-tc-reinfer-profile-alloc-start index))
      (compiler-tc-profile-metric-value
        metrics-address
        (+ compiler-tc-reinfer-profile-live-start index)))
    (compiler-tc-reinfer-profile-line
      (str_cat.str-cat (compiler-tc-reinfer-profile-site-name index) ".calls")
      (compiler-tc-profile-metric-value
        metrics-address
        (+ compiler-tc-reinfer-profile-calls-start index))
      0
      0)))

(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-emit-at
    [metrics-address : u64]
    [index : i64]) : unit
    (if (< index compiler-tc-reinfer-profile-site-count)
      (begin
        (compiler-tc-reinfer-profile-emit-entry metrics-address index)
        (compiler-tc-reinfer-profile-emit-at metrics-address (+ index 1)))
      unit)))

(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-emit [state : TcJobState]) : unit
    (compiler-tc-reinfer-profile-emit-at
      (compiler-tc-profile-metrics-address state)
      0)))

(cfg
  compile-profile
  (define (compiler-tc-body-fact-profile-line
    [site : String]
    [kind : String]
    [value : i64]) : unit
    (io.print-error
      (str_cat.str-cat
        "compile-profile|typecheck.body_fact."
        site
        "."
        kind
        (compiler-tc-profile-field value)
        "|0|0|0\n"))))

(cfg
  compile-profile
  (define (compiler-tc-body-fact-profile-emit-entry
    [metrics-address : u64]
    [index : i64]) : unit
    (let
      [site : String (compiler-tc-reinfer-profile-site-name index)]
      (compiler-tc-body-fact-profile-line
        (clone site)
        "hits"
        (compiler-tc-profile-metric-value
          metrics-address
          (+ compiler-tc-body-fact-profile-hits-start index)))
      (compiler-tc-body-fact-profile-line
        site
        "misses"
        (compiler-tc-profile-metric-value
          metrics-address
          (+ compiler-tc-body-fact-profile-misses-start index))))))

(cfg
  compile-profile
  (define (compiler-tc-body-fact-profile-emit-at
    [metrics-address : u64]
    [index : i64]) : unit
    (if (< index compiler-tc-reinfer-profile-site-count)
      (begin
        (compiler-tc-body-fact-profile-emit-entry metrics-address index)
        (compiler-tc-body-fact-profile-emit-at metrics-address (+ index 1)))
      unit)))

(cfg
  compile-profile
  (define (compiler-tc-body-fact-profile-emit [state : TcJobState]) : unit
    (compiler-tc-body-fact-profile-emit-at
      (compiler-tc-profile-metrics-address state)
      0)))

(define tc-type-handle-lookup-caller-resolver : i64
  0)
(define tc-type-handle-lookup-caller-nominal-lifetime : i64
  1)
(define tc-type-handle-lookup-caller-constructor : i64
  2)
(define tc-type-handle-lookup-caller-aggregate-layout : i64
  3)
(define tc-type-handle-lookup-caller-move-kind : i64
  4)
(define tc-type-handle-lookup-caller-qualified-owner : i64
  5)
(define tc-type-handle-lookup-caller-lazy-unique : i64
  6)

(cfg
  compile-profile
  (define (compiler-tc-type-handle-profile-note-lookup [caller : i64]) : unit
    (counters.bump! tc-profile-type-handle-lookups)
    (cond
      [(= caller tc-type-handle-lookup-caller-resolver)
        (counters.bump! tc-profile-type-handle-resolver-lookups)]
      [(= caller tc-type-handle-lookup-caller-nominal-lifetime)
        (counters.bump! tc-profile-type-handle-nominal-lifetime-lookups)]
      [(= caller tc-type-handle-lookup-caller-constructor)
        (counters.bump! tc-profile-type-handle-constructor-lookups)]
      [(= caller tc-type-handle-lookup-caller-aggregate-layout)
        (counters.bump! tc-profile-type-handle-aggregate-layout-lookups)]
      [(= caller tc-type-handle-lookup-caller-move-kind)
        (counters.bump! tc-profile-type-handle-move-kind-lookups)]
      [(= caller tc-type-handle-lookup-caller-qualified-owner)
        (counters.bump! tc-profile-type-handle-qualified-owner-lookups)]
      [else (counters.bump! tc-profile-type-handle-lazy-unique-lookups)])))

(cfg
  compile-profile
  (define (compiler-tc-resolution-profile-composite? [ty : (& ty ast.AstType)]) : bool
    (match ty
      [(or (Func _ _) (Tuple _) (Array _ _) (DynArray _) (Slice _) (Box _)
           (Ptr _) (MutPtr _) (Ref _ _) (MutRef _ _) (Region _ _))
        true]
      [_ false])))

(cfg
  compile-profile
  (define (compiler-tc-resolution-profile-note-input
    [ty : (& ty ast.AstType)]
    [needs-resolution : bool]) : unit
    (counters.bump! tc-profile-resolve-ordinary-calls)
    (match ty
      [(Var _) (counters.bump! tc-profile-resolve-unresolved-var-calls)]
      [(VarArgs _ _)
        (counters.bump! tc-profile-resolve-unresolved-varargs-calls)]
      [_
        (cond
          [(not (compiler-tc-resolution-profile-composite? ty))
            (counters.bump! tc-profile-resolve-concrete-leaf-calls)]
          [needs-resolution
            (counters.bump! tc-profile-resolve-unresolved-composite-calls)]
          [else (counters.bump! tc-profile-resolve-concrete-composite-calls)])])))

(cfg
  compile-profile
  (define compiler-tc-env-profile-borrow-lifetime-scan-current : i64
    0))

(cfg
  compile-profile
  (define (compiler-tc-env-profile-borrow-lifetime-scan-start!) : unit
    (counters.bump! tc-profile-env-borrow-lifetime-scans)
    (set! compiler-tc-env-profile-borrow-lifetime-scan-current 0)))

(cfg
  compile-profile
  (define (compiler-tc-env-profile-borrow-lifetime-scan-note-binding!) : unit
    (counters.bump! tc-profile-env-borrow-lifetime-scan-bindings)
    (counters.bump! compiler-tc-env-profile-borrow-lifetime-scan-current)))

(cfg
  compile-profile
  (define (compiler-tc-env-profile-borrow-lifetime-scan-finish!) : unit
    (counters.max!
      tc-profile-env-borrow-lifetime-scan-max
      compiler-tc-env-profile-borrow-lifetime-scan-current)))

(cfg
  compile-profile
  (define (compiler-tc-env-profile-reset) : unit
    (compiler-tc-env-profile-reset!)
    (set! compiler-tc-env-profile-borrow-lifetime-scan-current 0)))

;; The macro-expansion program's counters; the walk tables keep accumulating.
(cfg
  compile-profile
  (define (compiler-tc-macro-profile-reset-program-counters
    [state : TcJobState]) : unit
    (compiler-tc-resolve-profile-reset!)
    (compiler-tc-unbound-profile-reset!)
    (compiler-tc-macro-program-profile-reset state)
    (compiler-tc-splice-profile-reset state)))

(cfg
  compile-profile
  (define (compiler-tc-decl-profile-reset [state : TcJobState]) : unit
    (compiler-tc-env-profile-reset)
    (compiler-tc-reinfer-profile-reset state)
    (compiler-tc-body-fact-profile-reset state)
    (compiler-tc-layout-profile-reset!)))

(cfg
  compile-profile
  (define (compiler-tc-decl-profile-record
    [state : TcMacroState]
    [decl : ast.AstDecl]) : unit
    (match (ast.ast-decl-generated-meta decl)
      [(Some _ _ _ _)
        (compiler-tc-macro-profile-metric-add!
          state
          tc-profile-generated-decl-checks
          1)]
      [(No) unit])))

(cfg
  compile-profile
  (define (compiler-tc-env-profile-emit-macro-cache-entries) : unit
    (counters.profile-counter-row!
      "typecheck.env.macro_cache_entries"
      tc-profile-env-cache-entries)))

;; Set the rows derived from other counters. Fired self time excludes the
;; nested lanes; the survivor pool nodes are priced at their pool node size.
(cfg
  compile-profile
  (define (compiler-tc-walk-profile-derive! [state : TcJobState]) : unit
    (let
      [nonoutput : i64
        (- tc-profile-fire-superseded-alloc tc-profile-fire-superseded-released)]
      [pool-node-bytes : i64
        (+
          (* tc-profile-fire-survivor-expr-nodes (ast.ast-expr-node-bytes))
          (* tc-profile-fire-survivor-type-nodes (ast.ast-type-node-bytes)))]
      (compiler-tc-profile-metric-set!
        (compiler-tc-profile-metrics-address state)
        tc-profile-active-generation-rotations
        (+
          tc-profile-decl-generation-rotations
          (compiler-tc-profile-metric-value
            (compiler-tc-profile-metrics-address state)
            tc-profile-splice-generation-rotations)))
      (set!
        tc-profile-fire-self-ns
        (if (> tc-profile-fire-ns tc-profile-fire-nested-ns)
          (- tc-profile-fire-ns tc-profile-fire-nested-ns)
          0))
      (set! tc-profile-fire-survivor-pool-node-bytes pool-node-bytes)
      (set!
        tc-profile-fire-survivor-bytes
        (+ tc-profile-fire-survivor-alloc pool-node-bytes))
      (set! tc-profile-fire-nonoutput-live nonoutput)
      (set!
        tc-profile-fire-residual-live
        (- tc-profile-fire-live (+ tc-profile-fire-survivor-live nonoutput)))
      (set!
        tc-profile-fire-unattributed-live
        (-
          tc-profile-fire-live
          (+
            tc-profile-fire-survivor-live
            (+
              nonoutput
              (+
                tc-profile-fire-committed-live
                tc-profile-fire-post-boundary-live))))))))

(cfg
  compile-profile
  (define (compiler-tc-decl-profile-finish [state : TcJobState]) : unit
    (compiler-tc-walk-profile-derive! state)
    (compiler-tc-resolve-profile-emit!)
    (compiler-tc-env-profile-emit!)
    (compiler-tc-unbound-profile-emit!)
    (compiler-tc-macro-program-profile-emit!
      (compiler-tc-profile-metrics-address state))
    (compiler-tc-walk-profile-emit!)
    (compiler-tc-splice-profile-emit!
      (compiler-tc-profile-metrics-address state))
    (compiler-tc-walk-probe-profile-emit!)
    (compiler-tc-reinfer-profile-emit state)
    (compiler-tc-body-fact-profile-emit state)
    (compiler-tc-layout-profile-emit!)))

(define (tc-expr-diag
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [message : String]) : cdiag.CompilerDiagnostic
  (cond
    [(tc-macro-framed-error? message) (tc-macro-framed-error-diag message)]
    [(tc-rich-error? message) (tc-rich-error-diag message)]
    [(tc-located-error? message) (tc-located-error-diag message)]
    [else
      (match (tc-macro-framed-error-from-root
        expr-bases
        (tc-global-shared-view expr)
        (tc-global-shared-view message))
        [(Some framed) (tc-macro-framed-error-diag framed)]
        [(No)
          (match (tc-expr-maybe-span expr-bases expr)
            [(Some span)
              (tc-canonical-diagnostic
                (cdiag.compiler-diagnostic-from-ast-span "" span message))]
            [(No) (tc-diag-at-start message)])])]))

;; Locate an error at the nearest available declaration body span. A top-level
;; `define` body is wrapped in `AstExpr.Spanned`, so its span points the
;; diagnostic at the offending declaration's expression; otherwise fall back 1:1.
(define (tc-generated-decl-diag
  [meta : ast.AstGeneratedDeclMeta]
  [diag : cdiag.CompilerDiagnostic]) : cdiag.CompilerDiagnostic
  (match meta
    [(Some generator item _ key)
      (let
        [with-context : cdiag.CompilerDiagnostic
          (cdiag.compiler-diagnostic-with-note
            diag
            (str_cat.str-cat "generated declaration: " item " from " generator))]
        (if (> (string.string-length key) 0)
          (cdiag.compiler-diagnostic-with-note
            with-context
            (str_cat.str-cat "generated identity: " key))
          with-context))]
    [(No) diag]))

(define (tc-decl-location-diag
  [expr-bases : i64]
  [decl : ast.AstDecl]
  [message : String]) : cdiag.CompilerDiagnostic
  (match decl
    [(Def decl-meta _ _ expr-box)
      (let
        [expr : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases expr-box)]
        (tc-expr-diag expr-bases expr message))]
    [(or (DefFn _ _ _ _ body-box _) (DefMacro _ _ _ _ body-box))
      (let
        [body : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases body-box)]
        (tc-expr-diag expr-bases body message))]
    [(Test _ _ _ span)
      (tc-canonical-diagnostic
        (cdiag.compiler-diagnostic-from-ast-span "" span message))]
    [(Unsafe inner-box)
      (tc-decl-location-diag
        expr-bases
        (ast.ast-decl-box-shared-view inner-box)
        message)]
    [_ (tc-diag-at-start message)]))

(define (tc-decl-diag
  [expr-bases : i64]
  [decl : ast.AstDecl]
  [message : String]) : cdiag.CompilerDiagnostic
  (cond
    [(tc-macro-framed-error? message) (tc-macro-framed-error-diag message)]
    [(tc-rich-error? message) (tc-rich-error-diag message)]
    [(tc-located-error? message) (tc-located-error-diag message)]
    [else
      (tc-generated-decl-diag
        (ast.ast-decl-generated-meta decl)
        (tc-decl-location-diag expr-bases decl message))]))

(define (tc-decl-diag-with-maybe-origin
  [expr-bases : i64]
  [origin : parser.CompilerParseMaybeDeclSpan]
  [decl : ast.AstDecl]
  [message : String]) : cdiag.CompilerDiagnostic
  (let
    [diag : cdiag.CompilerDiagnostic (tc-decl-diag expr-bases decl message)]
    (if (and
      (= (cdiag.compiler-diagnostic-line diag) 1)
      (= (cdiag.compiler-diagnostic-col diag) 1)
      (= (cdiag.compiler-diagnostic-end-line diag) 1)
      (= (cdiag.compiler-diagnostic-end-col diag) 1))
      (match origin
        [(Some span)
          (cdiag.compiler-diagnostic-with-primary-span
            (& diag)
            (cdiag.CompilerDiagnosticSpan
              ""
              (ast.ast-source-span-start-line span)
              (ast.ast-source-span-start-col span)
              (ast.ast-source-span-end-line span)
              (ast.ast-source-span-end-col span)))]
        [(None) diag])
      diag)))

(define (tc-locate-error-at-expr
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [message : String]) : String
  (if (tc-encoded-error? message)
    message
    (match (tc-expr-maybe-span expr-bases expr)
      [(Some span)
        (if (tc-borrow-place-error-message? message)
          (tc-rich-borrow-place-error span message)
          (tc-located-error span message))]
      [(No) message])))

;; Diagnostic span resolution is a read-only walk: it cannot expand a macro or
;; install a pool, so one expression segment-bases token covers the whole
;; descent. Callers derive the token on their error path from the owning
;; `TcContext` (`tc-context-expr-bases`) or reuse the token their own walk was
;; given; a span must come from the pool that owns the failing node, never from
;; whichever pool happens to be installed.
(define (tc-expr-id-maybe-span [expr-bases : i64] [expr-id : i64]) : TcMaybeAstSourceSpan
  (tc-expr-maybe-span
    expr-bases
    (ast.ast-expr-segment-bases-get expr-bases expr-id)))

;; Serial compatibility adapter for consumers that still walk the installed
;; pool (the semantic index). Compile-job typecheck paths pass their owner's
;; token to `tc-expr-id-maybe-span` instead.
(define (tc-expr-id-maybe-span-installed [expr-id : i64]) : TcMaybeAstSourceSpan
  (tc-expr-id-maybe-span (ast.ast-node-pool-active-expr-segment-bases) expr-id))

(define (tc-expr-maybe-span [expr-bases : i64] [expr : ast.AstExpr]) : TcMaybeAstSourceSpan
  (match expr
    [(Spanned _ span) (Some span)]
    [(or (MacroExpansion inner _ _) (Unary _ inner) (TupleRef inner _)
         (FixedMakeArray _ inner) (MakeArray _ inner) (Set _ inner)
         (Ann inner _) (Cast inner _) (Borrow _ _ inner) (Box inner)
         (BoxGet inner) (BoxTake inner) (Comptime inner) (Quote inner)
         (Quasiquote inner) (Unquote inner) (UnquoteSplicing inner) (Try inner)
         (Return inner) (PtrNullCheck inner) (PtrAddrOf inner) (PtrRead inner)
         (PtrCast inner _) (PtrToInt inner) (IntToPtr inner _)
         (StringData inner) (ArrayData inner) (Xgetbv inner))
      (tc-expr-id-maybe-span expr-bases inner)]
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda _ _ body) (tc-expr-id-maybe-span expr-bases body)])]
    [_ (No)]))

(define (tc-expr-list-last-maybe-span
  [expr-bases : i64]
  [exprs : ast.AstExprList]) : TcMaybeAstSourceSpan
  (if (ast.ast-expr-list-empty? (& exprs))
    (No)
    (tc-expr-maybe-span
      expr-bases
      (ast.ast-expr-segment-bases-get
        expr-bases
        (ast.ast-expr-list-get (& exprs) (- exprs.len 1) 0)))))

(define (tc-reference-escape-help) : String
  "return an owned clone, keep the reference inside its scope, or tie the returned reference lifetime to a parameter")

(define (tc-borrow-place-error-message) : String
  (tc-kind-message
    (BorrowViolation)
    "typecheck: borrow requires a local, parameter, or aggregate place"))

(define (tc-borrow-place-error-message? [message : (& message str)]) : bool
  (or
    (string.eq message (tc-borrow-place-error-message))
    (tc-temporary-borrow-position-message? message)))

(define (tc-borrow-place-help) : String
  "bind the value to a local before borrowing it, borrow a field or array element from a local aggregate, or pass a borrowed temporary `(& value)` directly as a call argument")

(define (tc-rich-borrow-place-error
  [span : ast.AstSourceSpan]
  [message : String]) : String
  (if (tc-temporary-borrow-position-message? message)
    (tc-rich-error-one-secondary
      span
      message
      "pass the borrow directly as a function-call argument, or bind the value to a local before borrowing it"
      span
      "this borrow of a temporary is not a call argument")
    (tc-rich-error-one-secondary
      span
      message
      (tc-borrow-place-help)
      span
      "this expression produces a temporary value, not a borrowable place")))

;; A borrowed temporary outside a direct call-argument position (section 3.10).
(define (tc-temporary-borrow-position-message) : String
  (tc-kind-message
    (cdiag.CompilerTypecheckKind.BorrowViolation)
    "typecheck: a borrowed temporary must be a direct function-call argument"))

(define (tc-temporary-borrow-position-message? [message : (& message str)]) : bool
  (string.eq message (tc-temporary-borrow-position-message)))

(define (tc-temporary-borrow-escape-message) : String
  (tc-kind-message
    (cdiag.CompilerTypecheckKind.BorrowViolation)
    "typecheck: temporary dropped while still borrowed"))

(define (tc-temporary-borrow-escape-help) : String
  "the call's result or a mutable argument can keep this borrow after the call returns and the temporary is dropped; bind the value to a local before the call")

(define (tc-arena-escape-help [region : String]) : String
  (str_cat.str-cat
    "use with-escape to clone one supported result out of `"
    region
    "`, or keep the value inside the with-arena scope"))

(define (tc-closure-escape-help) : String
  "move owned data into the closure or keep the closure inside the borrowed/arena scope")

(define (tc-region-call-escape-help) : String
  "pass an owned clone, keep the call inside the value's arena/scope, or use with-escape to clone out a supported arena result before passing it")

(define (tc-reference-escape-message? [message : (& message str)]) : bool
  (let
    [text : String (tc-message-text message)]
    (or
      (string.eq text "typecheck: reference value would escape lexical scope")
      (tc-diag-string-prefix?
        (& text)
        "typecheck: cannot store reference into longer-lived")
      (tc-diag-string-prefix?
        (& text)
        "typecheck: cannot store reference into non-place")
      (string.eq
        text
        "typecheck: lambda cannot capture mutable reference; reference value would escape lexical scope")
      (string.eq
        text
        "typecheck: lambda cannot capture immutable reference; reference value would escape lexical scope")
      (string.eq
        text
        "typecheck: reference-capturing closure value would escape lexical scope"))))

(define (tc-region-escape-message? [message : (& message str)]) : bool
  (let
    [text : String (tc-message-text message)]
    (or
      (tc-diag-string-prefix?
        (& text)
        "typecheck: region-tagged value cannot escape with-arena '")
      (tc-diag-string-prefix?
        (& text)
        "typecheck: cannot store region-tagged value into ")
      (string.eq
        text
        "typecheck: lambda cannot capture region-tagged value; region value would escape")
      (string.eq
        text
        "typecheck: lambda return value has region-tagged type; region value would escape")
      (string.eq
        text
        "typecheck: cannot pass region-tagged value to function parameter; region value would escape"))))

(define (tc-cleanup-escape-message? [message : (& message str)]) : bool
  (let
    [text : String (tc-message-text message)]
    (or
      (string.eq
        text
        "typecheck: cleanup-required resource would escape with scope")
      (string.eq
        text
        "typecheck: lambda cannot capture cleanup-required resource; resource value would escape")
      (string.eq
        text
        "typecheck: cannot store cleanup-required resource in longer-lived binding"))))

(define (tc-escape-message? [message : (& message str)]) : bool
  (or
    (tc-reference-escape-message? message)
    (tc-region-escape-message? message)
    (tc-cleanup-escape-message? message)))

(define (tc-escape-help [message : (& message str)]) : String
  (if (tc-region-escape-message? message)
    "return an owned clone, keep the value inside the arena/scope, or use with-escape for supported clone-out"
    (if (tc-cleanup-escape-message? message)
      "keep the cleanup-required value inside its resource scope or return a non-resource result"
      (tc-reference-escape-help))))

(define (tc-rich-error-with-maybe-secondary
  [primary : ast.AstSourceSpan]
  [message : String]
  [help : String]
  [maybe-secondary : TcMaybeAstSourceSpan]
  [secondary-label : String]) : String
  (match maybe-secondary
    [(Some secondary)
      (tc-rich-error-one-secondary
        primary
        message
        help
        secondary
        secondary-label)]
    [(No)
      (tc-rich-error-one-secondary primary message help primary secondary-label)]))

(define (tc-rich-escape-at-expr
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [message : String]
  [secondary-label : String]) : String
  (match (tc-expr-maybe-span expr-bases expr)
    [(Some span)
      (let
        [help : String (tc-escape-help message)]
        (tc-rich-error-one-secondary span message help span secondary-label))]
    [(No) message]))

;; Macros that read a vector element directly often expand to
;; `(array-ref vec.slots index)`. The outer generated nodes do
;; not carry a source span, but the unquoted vector expression does.  Use that
;; span so this diagnostic points to the user's borrowed-vector argument, not
;; only the macro's quasiquote body.
(define (tc-vector-ref-rvalue-source-span
  [expr-bases : i64]
  [arg : ast.AstExpr]) : TcMaybeAstSourceSpan
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& arg))
    [(ArrayRef array-box _)
      (match (ast.ast-expr-unspan-with-segment-bases
        expr-bases
        (& (ast.ast-expr-segment-bases-get expr-bases array-box)))
        [(StructGet receiver-box field)
          (if (= field cbi.compiler-builtin-id-fix-slots)
            (tc-expr-maybe-span
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases receiver-box))
            (No))]
        [_ (No)])]
    [_ (No)]))

;; How a by-value expression reads its value: 1 through a shared reference, 2
;; through a mutable reference, 0 otherwise. Such a read is a `deref` of a
;; reference-typed name, or a field, tuple or element projection whose receiver
;; is one or is itself a reference-typed name, which a projection dereferences
;; implicitly. A dotted local field name reads its expansion (#8554).
(define (tc-reference-read-kind
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]) : i64
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(BoxTake inner-box)
      (tc-reference-name-kind
        ctx
        expr-bases
        env
        (ast.ast-expr-segment-bases-get expr-bases inner-box))]
    [(or (StructGet receiver-box _) (TupleRef receiver-box _)
         (ArrayRef receiver-box _))
      (tc-reference-receiver-kind ctx expr-bases env receiver-box)]
    [(Var name)
      (if (tc-dotted-local-field-name-id? env name)
        (match (tc-dotted-local-field-expr-id env name)
          [(Ok virtual-id)
            (tc-reference-read-kind
              ctx
              expr-bases
              env
              (ast.ast-expr-segment-bases-get expr-bases virtual-id))]
          [(Err _) 0])
        0)]
    [_ 0]))

(define (tc-reference-receiver-kind
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [receiver-id : i64]) : i64
  (let
    [receiver : ast.AstExpr
      (ast.ast-expr-segment-bases-get expr-bases receiver-id)]
    [named : i64
      (tc-reference-name-kind
        ctx
        expr-bases
        env
        (tc-global-shared-view receiver))]
    (if (> named 0)
      named
      (tc-reference-read-kind ctx expr-bases env receiver))))

;; 1 for a name bound to a shared reference, 2 for a mutable one, else 0.
(define (tc-reference-name-kind
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]) : i64
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(Var name)
      (match (tc-lookup-id env name)
        [(Ok ty)
          (match (tc-type-strip-region (tc-resolve-type ctx ty))
            [(Ref _ _) 1]
            [(MutRef _ _) 2]
            [_ 0])]
        [(Err _) 0])]
    [_ 0]))

;; A by-value use of a non-Copy value read through a reference would move it
;; out of the reference. The region and reference escape checks reject that
;; use before the move check sees it, and their arena advice does not fit, so
;; they report this instead (#8554). Returns "" when `expr` reads no non-Copy
;; value through a reference; `help` names the fix for the use's position.
(define (tc-move-out-of-reference-error
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [ty : ast.AstType]
  [help : String]) : String
  (let
    [kind : i64
      (tc-reference-read-kind ctx expr-bases env (tc-global-shared-view expr))]
    (if (or
      (= kind 0)
      (tc-type-copyable?
        ctx
        (tc-type-without-regions (tc-global-shared-view ty))))
      ""
      (tc-move-out-of-reference-message expr-bases expr ty kind help))))

;; A `deref` the move check sees consuming a non-Copy referent has no single
;; use position, so its help names both fixes.
(define (tc-move-out-of-deref-help) : String
  "borrow it with `(& ...)` instead, or use an owned clone")

;; The E0208 for a by-value use of non-Copy `ty` read through a reference:
;; `kind` 1 for a shared reference, 2 for a mutable one.
(define (tc-move-out-of-reference-message
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [ty : ast.AstType]
  [kind : i64]
  [help : String]) : String
  (let
    [type-text : String (tc-type-render (tc-type-without-regions ty))]
    [message : String
      (str_cat.str-cat
        (cdiag.compiler-diagnostic-typecheck-tag (MoveViolation))
        "typecheck: cannot move a `"
        (string.copy (& type-text))
        "` out of a "
        (if (= kind 2)
          "mutable"
          "shared")
        " reference; `"
        type-text
        "` is not Copy")]
    (match (tc-expr-maybe-span expr-bases expr)
      [(Some span)
        (tc-rich-error-one-secondary
          span
          message
          help
          span
          "this reads the value through a reference")]
      [(No) message])))

;; The binding check of a `let` initializer, reporting a non-Copy value read
;; through a reference as the move it would be (#8554).
(define (tc-ensure-let-value-can-bind
  [ctx : TcContext]
  [env : TcTypeEnv]
  [init : ast.AstExpr]
  [init-ty : ast.AstType]) : ResultTcUnit
  (match (tc-ensure-reference-value-can-bind
    env
    (tc-global-shared-view init-ty))
    [(Ok) Ok]
    [(Err message)
      (let
        [moved : String
          (tc-move-out-of-reference-error
            ctx
            (tc-context-expr-bases ctx)
            env
            init
            init-ty
            "bind a borrow `(& ...)` of it instead, or an owned clone")]
        (Err
          (if (> (string.string-length moved) 0)
            moved
            message)))]))

;; The expression a body's value comes from: a `let` body's or `begin`'s last
;; form, through any nesting.
(define (tc-body-tail-expr [expr-bases : i64] [expr : ast.AstExpr]) : ast.AstExpr
  (match (ast.ast-expr-unspan-with-segment-bases expr-bases (& expr))
    [(Let let-box)
      (match (ast.ast-let-box-shared-view let-box)
        [(Let _ body-id)
          (tc-body-tail-expr
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases body-id))])]
    [(Begin items)
      (if (> (ast.ast-expr-list-len (& items)) 0)
        (tc-body-tail-expr
          expr-bases
          (ast.ast-expr-segment-bases-get
            expr-bases
            (ast.ast-expr-list-get
              (& items)
              (- (ast.ast-expr-list-len (& items)) 1)
              0)))
        expr)]
    [_ expr]))

;; A direct array read through a reference rvalue can produce a region-tagged
;; move-only aggregate. Keep the sound confinement rejection, but make this
;; frequent vector-iteration shape actionable without changing diagnostics for
;; unrelated region values crossing a call boundary.
(define (tc-region-call-arg-error [expr-bases : i64] [arg : ast.AstExpr]) : String
  (let
    [message : String
      (tc-kind-message
        (RegionEscape)
        "typecheck: cannot pass region-tagged value to function parameter; region value would escape")]
    (match (tc-vector-ref-rvalue-source-span
      expr-bases
      (tc-global-shared-view arg))
      [(Some span)
        (tc-rich-error-one-secondary
          span
          (str_cat.str-cat
            message
            "; direct aggregate reads through a shared vector borrow are not owned values; borrow slots from a vector place or use the generated vector get helper")
          "a direct aggregate read through this shared vector reference is not an owned value; borrow slots from a vector place or use the generated vector get helper"
          span
          "this by-value argument reads an aggregate through a shared reference")]
      [(No)
        (match (tc-expr-maybe-span expr-bases arg)
          [(Some span)
            (tc-rich-error-one-secondary
              span
              message
              (tc-region-call-escape-help)
              span
              "this argument carries an arena region that the parameter does not accept")]
          [(No) message])])))

;; Ordinary lifetime names stay on the direct intern lookup. Legacy diagnostics
;; without a TcContext may render fresh/template identities only from the
;; validated active owner; malformed and foreign ids take the total fallback.
(defmacro (tc-lifetime-name-render [name : comptime.Expr]) : comptime.Expr
  `(let
    [lifetime-name-id : i64 ,name]
    (if (ci.intern-renderable-id? lifetime-name-id)
      (ci.intern-str lifetime-name-id)
      (let
        [source-name-id : i64
          (ci.intern-active-syntax-source-name-id-or lifetime-name-id -1)]
        (if (>= source-name-id 0)
          (ci.intern-str source-name-id)
          (str_cat.str-cat "<id:" (string.int->string lifetime-name-id) ">"))))))

(define (tc-spanned-escape-error
  [expr-bases : i64]
  [session : cis.InternStructuralSessionHandle]
  [inner : ast.AstExpr]
  [span : ast.AstSourceSpan]
  [message : String]) : TcMaybeString
  (if (tc-encoded-error? message)
    (No)
    (match inner
      [(WithRegion region body)
        (if (tc-message-text-prefix?
          (& message)
          "typecheck: region-tagged value cannot escape with-arena '")
          (match (tc-expr-list-last-maybe-span expr-bases body)
            [(Some value-span)
              (Some
                (tc-rich-error-one-secondary
                  value-span
                  message
                  (tc-arena-escape-help (tc-lifetime-name-render region))
                  span
                  (str_cat.str-cat
                    "with-arena `"
                    (tc-lifetime-name-render region)
                    "` scope resets before this value can escape")))]
            [(No)
              (Some
                (tc-rich-error-one-secondary
                  span
                  message
                  (tc-arena-escape-help (tc-lifetime-name-render region))
                  span
                  "with-arena scope boundary"))])
          (No))]
      [(Return value-box)
        (if (tc-escape-message? message)
          (let
            [value : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases value-box)]
            [help : String (tc-escape-help message)]
            (Some
              (tc-rich-error-with-maybe-secondary
                span
                message
                help
                (tc-expr-maybe-span expr-bases value)
                "returned value carries a lifetime or arena that cannot cross this boundary")))
          (No))]
      [(Set name value-box)
        (if (tc-escape-message? message)
          (let
            [value : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases value-box)]
            [target : String (tc-env-key-name-text-for-session session name)]
            [help : String (tc-escape-help message)]
            (match (tc-expr-maybe-span expr-bases value)
              [(Some value-span)
                (Some
                  (tc-rich-error-two-secondaries
                    span
                    message
                    help
                    value-span
                    "assigned value carries a shorter lifetime"
                    span
                    (str_cat.str-cat
                      "target binding `"
                      target
                      "` lives longer than the assigned value")))]
              [(No)
                (Some
                  (tc-rich-error-one-secondary
                    span
                    message
                    help
                    span
                    (str_cat.str-cat
                      "target binding `"
                      target
                      "` lives longer than the assigned value")))]))
          (No))]
      [(Let let-box)
        (match (__tl-box-place let-box)
          [(Let _ body-box)
            (if (tc-escape-message? message)
              (let
                [body : ast.AstExpr
                  (ast.ast-expr-segment-bases-get expr-bases body-box)]
                [help : String (tc-escape-help message)]
                (Some
                  (tc-rich-error-with-maybe-secondary
                    span
                    message
                    help
                    (tc-expr-maybe-span expr-bases body)
                    "let result carries a lifetime that cannot outlive this binding scope")))
              (No))])]
      [(Lambda lambda-box)
        (match (__tl-box-place lambda-box)
          [(Lambda _ _ body-box)
            (if (tc-escape-message? message)
              (let
                [body : ast.AstExpr
                  (ast.ast-expr-segment-bases-get expr-bases body-box)]
                (Some
                  (tc-rich-error-with-maybe-secondary
                    span
                    message
                    (tc-closure-escape-help)
                    (tc-expr-maybe-span expr-bases body)
                    "closure body captures a value whose lifetime cannot escape")))
              (No))])]
      [_ (No)])))

(define (tc-expect-at-expr
  [ctx : TcContext]
  [expr : ast.AstExpr]
  [actual : ast.AstType]
  [expected : ast.AstType]
  [message : String]) : ResultTcUnit
  (if (tc-type-compatible?
    (tc-global-shared-view expected)
    (tc-global-shared-view actual))
    Ok
    (Err
      (tc-locate-error-at-expr
        (tc-context-expr-bases ctx)
        expr
        (tc-type-mismatch-message actual expected message)))))

(define (tc-type-env-binding-segment-capacity) : i64
  64)

(define (tc-type-env-cache-segment-capacity) : i64
  8)

;; Monotone counter of every event that can hand out a persistent-env node
;; address: a new store cell, a new binding segment, or a new cache segment.
;; Node addresses are stable while a store lives, because segments are only
;; appended to the store's owner arena, so a cached (store handle, node
;; address) pair can only ever be invalidated by a teardown that is followed by
;; one of those three allocations. Caches over persistent chains therefore stay
;; exact by dropping themselves whenever this counter moves.
(define tc-type-env-store-epoch : i64
  0)

(define (tc-type-env-store-new-with-topenv-state-address
  [topenv-state-address : i64]
  [structural-session-address : i64]
  [type-resolution-cache-state-address : i64]) : TcTypeEnvStore
  (TcTypeEnvStore
    (__tl_make-array TcTypeEnvBinding 1)
    0
    0
    (__tl_make-array TcTypeEnvCache 1)
    0
    0
    (arena.tl_arena_current)
    topenv-state-address
    0
    structural-session-address
    type-resolution-cache-state-address))

(define (tc-type-env-store-handle-new-with-topenv-state-address
  [topenv-state-address : i64]
  [structural-session-address : i64]
  [type-resolution-cache-state-address : i64]) : i64
  (let
    [cell : (__tl_dyn-array TcTypeEnvStore) (__tl_make-array TcTypeEnvStore 1)]
    (set! tc-type-env-store-epoch (+ tc-type-env-store-epoch 1))
    (set!
      (array-ref cell 0)
      (tc-type-env-store-new-with-topenv-state-address
        topenv-state-address
        structural-session-address
        type-resolution-cache-state-address))
    (unsafe
      (cast (ptr->int (ptr-cast (__tl_array-data cell) : (Ptr u8))) : i64))))

(define (tc-type-env-store-handle-new) : i64
  (let
    [job-state : TcJobState (tc-serial-job-state)]
    [source-names : ci.InternSourceNameSessionHandle
      (ci.intern-source-name-session-capture-active-handle)]
    [resolution-state : TcTypeResolutionCacheState
      (tc-job-state-type-resolution-cache job-state)]
    (tc-type-env-store-handle-new-with-topenv-state-address
      0
      source-names.address
      resolution-state.address)))

(define (tc-type-env-store-read [handle : i64]) : TcTypeEnvStore
  (unsafe
    (ptr-read (int->ptr (cast handle : u64) : (Ptr TcTypeEnvStore)))))

(define (tc-type-env-store-write! [handle : i64] [store : TcTypeEnvStore]) : unit
  (unsafe
    (ptr-write! (int->ptr (cast handle : u64) : (MutPtr TcTypeEnvStore)) store)))

(define (tc-type-env-new) : TcTypeEnv
  (let
    [scoped-state : TcTypeEnvScopedState
      (tc-job-state-type-env-scoped-state (tc-serial-job-state))]
    [store : i64 (tc-type-env-store-handle-new)]
    (TcTypeEnv store -1 scoped-state.address)))

(define (tc-type-env-new-with-job-state [state : TcJobState]) : TcTypeEnv
  (let
    [source-names : ci.InternSourceNameSessionHandle
      (tc-macro-state-source-names (tc-job-state-macro-state state))]
    [scoped-state : TcTypeEnvScopedState
      (tc-job-state-type-env-scoped-state state)]
    (TcTypeEnv
      (tc-type-env-store-handle-new-with-topenv-state-address
        (__tl-project-field (tc-job-state-topenv-membership state) address)
        source-names.address
        (__tl-project-field (tc-job-state-type-resolution-cache state) address))
      -1
      scoped-state.address)))

(define (tc-type-env-structural-session [env : TcTypeEnv]) : cis.InternStructuralSessionHandle
  (cis.InternStructuralSessionHandle
    (unsafe
      (ptr-read (ptr-offset (int->ptr env.store : (Ptr i64)) 9)))))

(define (tc-type-env-topenv-membership-state [env : TcTypeEnv]) : TcTopEnvMembershipState
  (TcTopEnvMembershipState
    (unsafe
      (ptr-read (ptr-offset (int->ptr env.store : (Ptr i64)) 7)))))

(define (tc-type-env-type-resolution-cache-state [env : TcTypeEnv]) : TcTypeResolutionCacheState
  (TcTypeResolutionCacheState
    (unsafe
      (ptr-read (ptr-offset (int->ptr env.store : (Ptr i64)) 10)))))

(defmacro (tc-type-env-scoped-state [env : Expr]) : Expr
  `(TcTypeEnvScopedState ,(comptime.expr-struct-get env "abi-pad")))

(define (tc-type-env-set-topenv-membership-state!
  [env : TcTypeEnv]
  [state : TcTopEnvMembershipState]) : unit
  (unsafe
    (ptr-write!
      (ptr-offset (int->ptr env.store : (MutPtr i64)) 7)
      state.address)))

(define (tc-type-env-store-grow-bindings!
  [store : (&mut store TcTypeEnvStore)]
  [required : i64]) : unit
  (let
    [next-capacity : i64
      (if (< required (tc-type-env-binding-segment-capacity))
        (tc-type-env-binding-segment-capacity)
        required)]
    [owner : i64 store.owner-arena]
    (set! tc-type-env-store-epoch (+ tc-type-env-store-epoch 1))
    (in-arena
      (arena.Arena owner)
      (let
        [bigger : (__tl_dyn-array TcTypeEnvBinding)
          (__tl_make-array TcTypeEnvBinding next-capacity)]
        (set! store.bindings bigger)
        (set! store.binding-capacity next-capacity)
        (set! store.binding-len 0)))))

(define (tc-type-env-store-grow-caches!
  [store : (&mut store TcTypeEnvStore)]
  [required : i64]) : unit
  (let
    [next-capacity : i64
      (if (< required (tc-type-env-cache-segment-capacity))
        (tc-type-env-cache-segment-capacity)
        required)]
    [owner : i64 store.owner-arena]
    (set! tc-type-env-store-epoch (+ tc-type-env-store-epoch 1))
    (in-arena
      (arena.Arena owner)
      (let
        [bigger : (__tl_dyn-array TcTypeEnvCache)
          (__tl_make-array TcTypeEnvCache next-capacity)]
        (set! store.caches bigger)
        (set! store.cache-capacity next-capacity)
        (set! store.cache-len 0)))))

(define (tc-type-env-store-write-cache!
  [store : (&mut store TcTypeEnvStore)]
  [index : i64]
  [cache : TcTypeEnvCache]) : unit
  (set! (array-ref store.caches index) cache))

;; Hot persistent-env walkers expand these address/field reads at their direct
;; match sites. Returning an enum-shaped view per node is expensive here: it
;; copies the store and the largest cache payload even when a walker only
;; needs the binding key and parent. Arena segments are never moved, so a
;; snapshot head remains a valid element address after later segments are added.
;; `tc-type-env-raw-layout-smoke?` pins the word offsets used by these hot
;; accessors without adding byte-offset conversion work to each expansion.
(defmacro (tc-type-env-binding-ptr
  [_store-handle : comptime.Expr]
  [index : comptime.Expr]) : comptime.Expr
  `(unsafe
    (int->ptr (cast ,index : u64) : (Ptr TcTypeEnvBinding))))

(defmacro (tc-type-env-cache-ptr
  [_store-handle : comptime.Expr]
  [index : comptime.Expr]) : comptime.Expr
  `(unsafe
    (int->ptr (cast ,index : u64) : (Ptr TcTypeEnvCache))))

(defmacro (tc-type-env-binding-name-at [binding-ptr : comptime.Expr]) : comptime.Expr
  `(unsafe
    (ptr-read (ptr-cast ,binding-ptr : (Ptr i64)))))

(defmacro (tc-type-env-binding-type-at [binding-ptr : comptime.Expr]) : comptime.Expr
  `(unsafe
    (ptr-read
      (ptr-cast
        (ptr-offset (ptr-cast ,binding-ptr : (Ptr i64)) 1)
        : (Ptr ast.AstType)))))

(defmacro (tc-type-env-binding-parent-at [binding-ptr : comptime.Expr]) : comptime.Expr
  `(unsafe
    (ptr-read (ptr-offset (ptr-cast ,binding-ptr : (Ptr i64)) 4))))

(defmacro (tc-type-env-cache-at [cache-ptr : comptime.Expr]) : comptime.Expr
  `(unsafe
    (ptr-read ,cache-ptr)))

;; Physical byte offsets in TcTypeEnvCache after the four-word chain prefix:
;; ids=32 (the map is inline and 24 bytes), values=56, sidecar arrays=64/72,
;; flags=80/81, and rest/below=88/96. Keep these literals paired with the
;; raw-layout smoke and
;; cache behavior tests; `offset-of` currently treats the inline map as one word
;; and therefore under-reports every following field.
(defmacro (tc-type-env-cache-field-at
  [cache-ptr : comptime.Expr]
  [byte-offset : comptime.Expr]
  [_T : type]) : comptime.Expr
  `(unsafe
    (ptr-read
      (ptr-cast
        (ptr-offset (ptr-cast ,cache-ptr : (Ptr u8)) ,byte-offset)
        : (Ptr ,_T)))))

(define (tc-type-env-store-push-binding!
  [store-handle : i64]
  [binding : TcTypeEnvBinding]) : i64
  (let
    [store-words : (MutPtr i64)
      (unsafe
        (int->ptr (cast store-handle : u64) : (MutPtr i64)))]
    [index : i64
      (unsafe
        (ptr-read (ptr-offset store-words 2)))]
    (if (<
      index
      (unsafe
        (ptr-read (ptr-offset store-words 1))))
      unit
      (let
        [store : TcTypeEnvStore (tc-type-env-store-read store-handle)]
        (tc-type-env-store-grow-bindings! (&mut store) (+ index 1))
        (tc-type-env-store-write! store-handle store)
        (set! index 0)))
    (let
      [items : (__tl_dyn-array TcTypeEnvBinding)
        (unsafe
          (ptr-read
            (ptr-cast store-words : (Ptr (__tl_dyn-array TcTypeEnvBinding)))))]
      (set! (array-ref items index) binding)
      (unsafe
        (ptr-write! (ptr-offset store-words 2) (+ index 1)))
      (unsafe
        (cast
          (ptr->int
            (ptr-cast (ptr-offset (__tl_array-data items) index) : (Ptr u8)))
          : i64)))))

(define (tc-type-env-store-push-cache!
  [store : (&mut store TcTypeEnvStore)]
  [cache : TcTypeEnvCache]) : i64
  (let
    [index : i64 store.cache-len]
    (unless
      (< index store.cache-capacity)
      (tc-type-env-store-grow-caches! store (+ index 1))
      (set! index 0))
    (tc-type-env-store-write-cache! store index cache)
    (set! store.cache-len (+ index 1))
    (unsafe
      (cast
        (ptr->int
          (ptr-cast
            (ptr-offset (__tl_array-data store.caches) index)
            : (Ptr u8)))
        : i64))))

;; Cleanup-owner markers are only ever introduced by `with`-resource bindings, so
;; most programs never create one. `tc-active-cleanup-owners` has to walk the
;; whole persistent binding spine to prove that, once per checked let/store/
;; transfer expression. Counting marker binds at the single persistent-bind choke
;; point turns that proof into one load: a marker can only be observed by the
;; scan if some binding record carries `tc-cleanup-owner-marker-id` as its key,
;; and every binding record is created here, so a zero count means every spine in
;; every store is marker-free and the scan is provably empty. The count is
;; monotone and process-wide, i.e. conservative in the safe direction: it can
;; only ever disable the fast path, never enable it wrongly.
(define tc-cleanup-owner-marker-bind-count : i64
  0)

(define (tc-cleanup-owner-markers-possible?) : bool
  (not (= tc-cleanup-owner-marker-bind-count 0)))

(define (tc-type-env-cache-head [index : i64]) : i64
  (- 0 index))

(define (tc-type-env-cache-index [head : i64]) : i64
  (- 0 head))

(define (tc-type-env-bind-node
  [env : TcTypeEnv]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnv
  (let
    [store-handle : i64 env.store]
    [_note-marker : unit
      (if (= name-id (tc-cleanup-owner-marker-id))
        (set!
          tc-cleanup-owner-marker-bind-count
          (+ tc-cleanup-owner-marker-bind-count 1))
        unit)]
    [index : i64
      (tc-type-env-store-push-binding!
        store-handle
        (TcTypeEnvBinding name-id ty env.head))]
    (TcTypeEnv store-handle index env.abi-pad)))

(define (tc-type-env-cache-node [env : TcTypeEnv] [cache : TcTypeEnvCache]) : TcTypeEnv
  (let
    [store-handle : i64 env.store]
    [store : TcTypeEnvStore (tc-type-env-store-read store-handle)]
    [index : i64 (tc-type-env-store-push-cache! (&mut store) cache)]
    (tc-type-env-store-write! store-handle store)
    (TcTypeEnv store-handle (tc-type-env-cache-head index) env.abi-pad)))

(define (tc-type-env-view [env : TcTypeEnv]) : TcTypeEnvView
  (let
    [head : i64 env.head]
    (cond
      [(= head -1) Nil]
      [(>= head 0)
        (let
          [store-handle : i64 env.store]
          [binding-ptr : (Ptr TcTypeEnvBinding)
            (tc-type-env-binding-ptr store-handle head)]
          (Bind
            (tc-type-env-binding-name-at binding-ptr)
            (tc-type-env-binding-type-at binding-ptr)
            (TcTypeEnv
              store-handle
              (tc-type-env-binding-parent-at binding-ptr)
              env.abi-pad)))]
      [else
        (let
          [store-handle : i64 env.store]
          [cache-ptr : (Ptr TcTypeEnvCache)
            (tc-type-env-cache-ptr store-handle (tc-type-env-cache-index head))]
          (Cache
            cache-ptr
            (tc-type-env-cache-field-at cache-ptr 80 bool)
            (tc-type-env-cache-field-at cache-ptr 81 bool)
            (TcTypeEnv
              store-handle
              (tc-type-env-cache-field-at cache-ptr 88 i64)
              env.abi-pad)
            (TcTypeEnv
              store-handle
              (tc-type-env-cache-field-at cache-ptr 96 i64)
              env.abi-pad)))])))

(define (tc-empty-env) : TcTypeEnv
  (tc-type-env-new))

(define (tc-empty-env-with-job-state [state : TcJobState]) : TcTypeEnv
  (tc-type-env-new-with-job-state state))

(define (tc-type-env-spine-step [env : TcTypeEnv]) : TcTypeEnvSpineStep
  (match (tc-type-env-view env)
    [(Nil) (Done)]
    [(Cache _ _ _ rest _) (Cache rest)]
    [(Bind key ty rest) (Bind key ty rest)]))

(define (tc-type-env-marker-start [env : TcTypeEnv]) : TcTypeEnv
  (match (tc-type-env-view env)
    [(Cache _ _ _ rest _) rest]
    [_ env]))

(define (tc-type-env-marker-step [env : TcTypeEnv]) : TcTypeEnvMarkerStep
  (match (tc-type-env-view env)
    [(Nil) (Done)]
    [(Cache _ scan-through _ rest _)
      (if scan-through
        (Cache rest)
        (Done))]
    [(Bind key ty rest) (Bind key ty rest)]))

(define (tc-local-cache-threshold) : i64
  32)

(define (tc-local-cache-partial-layer-cap) : i64
  8)

(define (tc-builtin-symbol-name-id
  [session : cis.InternStructuralSessionHandle]
  [raw-name-id : i64]
  [hygiene-global : bool]) : i64
  (tc-builtin-call-name-id session raw-name-id hygiene-global))

;; The spelling builtin and string-helper dispatch sees for a call head, or -1
;; for none. A macro-hygiene global that names another module's own binding
;; (`macro-hygiene-global-user-binding-id?`) is an ordinary call of that
;; binding, as the same `m.f` written directly is, so it names no builtin.
(define (tc-builtin-call-name-id
  [session : cis.InternStructuralSessionHandle]
  [raw-name-id : i64]
  [hygiene-global : bool]) : i64
  (cbi.compiler-builtin-refresh!)
  (cond
    [(not hygiene-global) raw-name-id]
    [(macro-hygiene-global-user-binding-id? session raw-name-id) -1]
    [else (macro-hygiene-global-source-name-id-or session raw-name-id -1)]))

;; --- top-env build membership side table ------------------------------------
;; The whole-program top-level env is an UNCACHED spine of every top bind. The
;; threshold-compaction machinery (tc-env-compact-local-if-threshold) is for
;; single-bind function scopes and does not fire here: unsafe/c-abi decls
;; prepend two binds at once, breaking the exact-"32 binds above a cache"
;; alignment it needs, so the top env stays a plain list. The enum-variant
;; binder uses `tc-bind-alias-id-if-free`, whose guard `tc-name-bound-id?`
;; rescans that whole spine per variant -> O(decls^2).
;;
;; This is a job-owned membership bloom keyed by name identity: every name
;; bound during the build (plus the seeded base env) is stamped with the
;; current ownership epoch. An UNMARKED id is provably absent from the env, so
;; the guard binds directly with no scan. A MARKED id (a real prior binding, or
;; a transient local bind from an un-annotated top-level `define` initializer)
;; falls back to the exact spine scan -- the bloom only ever SKIPS the scan when
;; the name is definitely unbound, so the bound env, lookups, and diagnostics
;; are identical to the unconditional scan.
;;
;; Bit 1 is the EXACT complement for the guard's other verdict: it is stamped
;; only by binds that provably join the accumulated top-env spine
;; (the seeded base env, tc-bind-alias-id-if-free's own binds, and top-env alias
;; fanout binds -- never the transient inference binds that make the bloom
;; conservative). A stamped id is therefore definitely bound, so the guard can
;; skip without the O(spine) scan.
;; Self-compiles repeat enum-variant names (Ok/Err/None/Nil/...) across
;; hundreds of enums; without bit 1 every repeat after the first would rescan
;; the spine from the head down to the first binding. Ids that are bloom-marked but
;; not bound-stamped (e.g. spine binds made outside the alias binder) still
;; take the exact scan, so results are identical either way.
(define (tc-topenv-membership-state-present? [state : TcTopEnvMembershipState]) : bool
  (not (= state.address 0)))

(define (tc-topenv-membership-map-needs-grow?
  [map : (& map tc_i64_i64_map.Map)]) : bool
  (let
    [capacity : i64 (tc_i64_i64_map.capacity map)]
    (or
      (<= capacity 0)
      (>=
        (* (+ (tc_i64_i64_map.len map) (tc_i64_i64_map.deleted map)) 4)
        (* capacity 3)))))

(define (tc-cache-map-clear! [map : (&mut map tc_i64_i64_map.Map)]) : unit
  (let
    [index : i64 0]
    (while (< index (array-length map.slots))
      (__tl-project-set-field
        (array-ref map.slots index)
        state
        (tc_i64_i64_map.GeneratedHashmapSlotState.Empty))
      (set! index (+ index 1)))
    (set! map.len 0)
    (set!
      map.growth-limit
      (tc_i64_i64_map.growth-limit-for (tc_i64_i64_map.capacity (& map))))))

(define (tc-cache-map-grow-in-owner!
  [map : (&mut map tc_i64_i64_map.Map)]
  [owner : i64]) : unit
  (if (tc-topenv-membership-map-needs-grow? (& map))
    (in-arena (arena.Arena owner) (tc_i64_i64_map.grow! map))
    unit))

(define (tc-topenv-membership-renderable-overflow-flags-for
  [data : (& data TcTopEnvMembershipStateData)]
  [name-id : ci.InternId]) : i64
  (let
    [packed : i64
      (tc_i64_i64_map.get-value-or
        (& data.structural-flags)
        (ci.intern-id-value name-id)
        0)]
    (if (= (shr packed 3) data.epoch)
      (bit-and packed 3)
      0)))

(define (tc-topenv-membership-structural-flags-for
  [data : (& data TcTopEnvMembershipStateData)]
  [name-id : i64]) : i64
  (let
    [packed : i64
      (tc_i64_i64_map.get-value-or (& data.structural-flags) name-id 0)]
    (if (= (shr packed 2) data.epoch)
      (bit-and packed 3)
      0)))

(define (tc-topenv-membership-mark-structural-data!
  [data : (&mut data TcTopEnvMembershipStateData)]
  [name-id : i64]
  [bits : i64]) : unit
  (let
    [current : i64 (tc-topenv-membership-structural-flags-for (& data) name-id)]
    (tc-cache-map-grow-in-owner! (&mut data.structural-flags) data.owner-arena)
    (tc_i64_i64_map.insert-ref!
      (&mut data.structural-flags)
      name-id
      (bit-or (shl data.epoch 2) (bit-or current bits)))))

(define (tc-topenv-membership-mark-renderable-data!
  [data : (&mut data TcTopEnvMembershipStateData)]
  [name-id : ci.InternId]
  [bound : bool]) : unit
  (let
    [index : i64 (ci.intern-id-value name-id)]
    (if (< index (array-length data.renderable-slots))
      (begin
        (set! (array-ref data.renderable-slots index) data.epoch)
        (if bound
          (set! (array-ref data.renderable-bound-slots index) data.epoch)
          unit))
      (let
        [current : i64
          (tc-topenv-membership-renderable-overflow-flags-for (& data) name-id)]
        (tc-cache-map-grow-in-owner!
          (&mut data.structural-flags)
          data.owner-arena)
        (tc_i64_i64_map.insert-ref!
          (&mut data.structural-flags)
          index
          (bit-or
            (shl data.epoch 3)
            (bit-or
              current
              (if bound
                3
                1))))))))

;; TcTypeEnv still carries raw name keys during the typed-ID migration. Keep
;; this one compatibility boundary explicit: valid renderable IDs become
;; InternId before entering dense storage; every other raw identity takes the
;; structural map path.
(define (tc-topenv-membership-mark-key-data!
  [data : (&mut data TcTopEnvMembershipStateData)]
  [name-id : i64]
  [bound : bool]) : unit
  (if (ci.intern-renderable-id? name-id)
    (tc-topenv-membership-mark-renderable-data!
      data
      (ci.intern-id-from-renderable name-id)
      bound)
    (tc-topenv-membership-mark-structural-data!
      data
      name-id
      (if bound
        3
        1))))

(define (tc-topenv-membership-mark!
  [state : TcTopEnvMembershipState]
  [name-id : i64]) : unit
  (if (tc-topenv-membership-state-present? state)
    (let
      [data : TcTopEnvMembershipStateData
        (tc-topenv-membership-state-data state)]
      (when
        (and (not (= (bit-and data.mode 1) 0)) data.accelerator-enabled)
        (tc-topenv-membership-mark-key-data! (&mut data) name-id false)
        (tc-topenv-membership-state-data-set! state data)))
    unit))

(define (tc-topenv-membership-mark-bound!
  [state : TcTopEnvMembershipState]
  [name-id : i64]) : unit
  (if (tc-topenv-membership-state-present? state)
    (let
      [data : TcTopEnvMembershipStateData
        (tc-topenv-membership-state-data state)]
      (when
        (and (not (= (bit-and data.mode 1) 0)) data.accelerator-enabled)
        (tc-topenv-membership-mark-key-data! (&mut data) name-id true)
        (tc-topenv-membership-state-data-set! state data)))
    unit))

(define (tc-topenv-explicit-build-active? [state : TcTopEnvMembershipState]) : bool
  (and
    (tc-topenv-membership-state-present? state)
    (not (= (bit-and (tc-topenv-membership-mode state) 4) 0))))

(define (tc-topenv-membership-mode [state : TcTopEnvMembershipState]) : i64
  (if (tc-topenv-membership-state-present? state)
    (unsafe
      (ptr-read (int->ptr (cast state.address : u64) : (Ptr i64))))
    0))

(define (tc-topenv-membership-set-alias-fanout-active!
  [state : TcTopEnvMembershipState]
  [active : bool]) : unit
  (let
    [data : (MutPtr TcTopEnvMembershipStateData)
      (tc-topenv-membership-state-ptr state)]
    (unsafe
      (set!
        (deref data).mode
        (if active
          (bit-or (deref data).mode 2)
          (bit-and (deref data).mode -3))))))

(define (tc-topenv-membership-set-explicit-build-active!
  [state : TcTopEnvMembershipState]
  [active : bool]) : unit
  (let
    [data : (MutPtr TcTopEnvMembershipStateData)
      (tc-topenv-membership-state-ptr state)]
    (unsafe
      (set!
        (deref data).mode
        (if active
          (bit-or (deref data).mode 4)
          (bit-and (deref data).mode -5))))))

;; True when the id is PROVABLY bound in the accumulated top-env spine (stamped
;; by a spine-joining bind this generation); false means "unknown", not
;; "unbound".
(define (tc-topenv-membership-bound?
  [state : TcTopEnvMembershipState]
  [name-id : i64]) : bool
  (if (tc-topenv-membership-state-present? state)
    (let
      [data : TcTopEnvMembershipStateData
        (tc-topenv-membership-state-data state)]
      (if (not data.accelerator-enabled)
        false
        (if (ci.intern-renderable-id? name-id)
          (let
            [renderable : ci.InternId (ci.intern-id-from-renderable name-id)]
            [index : i64 (ci.intern-id-value renderable)]
            (if (< index (array-length data.renderable-bound-slots))
              (= (array-ref data.renderable-bound-slots index) data.epoch)
              (not
                (=
                  (bit-and
                    (tc-topenv-membership-renderable-overflow-flags-for
                      (& data)
                      renderable)
                    2)
                  0))))
          (not
            (=
              (bit-and
                (tc-topenv-membership-structural-flags-for (& data) name-id)
                2)
              0)))))
    false))

;; True when the id MIGHT be in the env; false only when the accelerator has
;; recorded enough state to prove absence. Disabling the accelerator preserves
;; the exact-scan behavior for differential tests.
(define (tc-topenv-membership-maybe?
  [state : TcTopEnvMembershipState]
  [name-id : i64]) : bool
  (if (tc-topenv-membership-state-present? state)
    (let
      [data : TcTopEnvMembershipStateData
        (tc-topenv-membership-state-data state)]
      (if (not data.accelerator-enabled)
        true
        (if (ci.intern-renderable-id? name-id)
          (let
            [renderable : ci.InternId (ci.intern-id-from-renderable name-id)]
            [index : i64 (ci.intern-id-value renderable)]
            (if (< index (array-length data.renderable-slots))
              (= (array-ref data.renderable-slots index) data.epoch)
              (not
                (=
                  (bit-and
                    (tc-topenv-membership-renderable-overflow-flags-for
                      (& data)
                      renderable)
                    1)
                  0))))
          (not
            (=
              (bit-and
                (tc-topenv-membership-structural-flags-for (& data) name-id)
                1)
              0)))))
    true))

(define (tc-topenv-membership-seed!
  [state : TcTopEnvMembershipState]
  [env : TcTypeEnv]) : unit
  (match (tc-type-env-spine-step env)
    [(Done) unit]
    [(Cache rest-env) (tc-topenv-membership-seed! state rest-env)]
    [(Bind key _ rest-env)
      (tc-topenv-membership-mark! state key)
      (tc-topenv-membership-mark-bound! state key)
      (tc-topenv-membership-seed! state rest-env)]))

(define (tc-topenv-membership-begin!
  [state : TcTopEnvMembershipState]
  [env : TcTypeEnv]
  [intern-table-id : i64]
  [intern-generation : i64]) : unit
  (let
    [data : TcTopEnvMembershipStateData (tc-topenv-membership-state-data state)]
    (if (or
      (not (= data.intern-table-id intern-table-id))
      (not (= data.intern-generation intern-generation)))
      (tc-cache-map-clear! (&mut data.structural-flags))
      unit)
    ;; Every build gets a fresh stamp. Recording the immutable source-name
    ;; owner here prevents equal numeric IDs in two intern sessions from
    ;; sharing accelerator facts.
    (set! data.epoch (+ data.epoch 1))
    (set! data.intern-table-id intern-table-id)
    (set! data.intern-generation intern-generation)
    (set! data.mode 1)
    (tc-topenv-membership-state-data-set! state data)
    (tc-topenv-membership-seed! state env)))

(define (tc-topenv-membership-end! [state : TcTopEnvMembershipState]) : unit
  (unsafe
    (set! (deref (tc-topenv-membership-state-ptr state)).mode 0)))

(define (tc-bind-raw-id [env : TcTypeEnv] [name-id : i64] [ty : ast.AstType]) : TcTypeEnv
  (let
    [topenv-state : TcTopEnvMembershipState
      (tc-type-env-topenv-membership-state env)]
    [topenv-mode : i64 (tc-topenv-membership-mode topenv-state)]
    (begin
      (cfg compile-profile (counters.bump! tc-profile-env-binds))
      (if (not (= (bit-and topenv-mode 2) 0))
        (tc-topenv-membership-mark-bound! topenv-state name-id)
        (if (not (= (bit-and topenv-mode 1) 0))
          (tc-topenv-membership-mark! topenv-state name-id)
          unit))
      (let
        [next-env : TcTypeEnv
          (tc-type-env-bind-node env name-id (tc-global-shared-view ty))]
        (if (tc-type-env-scoped-runtime-active? next-env)
          (tc-type-env-scoped-runtime-note-bind-id! next-env name-id ty env)
          unit)
        next-env))))

(define (tc-env-uncached-prefix-reaches-cache?
  [env : TcTypeEnv]
  [remaining : i64]) : bool
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    [left : i64 remaining]
    (while (and (> left 0) (>= head 0))
      (let
        [binding-ptr : (Ptr TcTypeEnvBinding)
          (tc-type-env-binding-ptr store-handle head)]
        (set! head (tc-type-env-binding-parent-at binding-ptr))
        (set! left (- left 1))))
    (and (<= left 0) (< head -1))))

(define (tc-env-after-prefix [env : TcTypeEnv] [remaining : i64]) : TcTypeEnv
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    [left : i64 remaining]
    (while (and (> left 0) (>= head 0))
      (let
        [binding-ptr : (Ptr TcTypeEnvBinding)
          (tc-type-env-binding-ptr store-handle head)]
        (set! head (tc-type-env-binding-parent-at binding-ptr))
        (set! left (- left 1))))
    (TcTypeEnv store-handle head env.abi-pad)))

(define (tc-env-partial-layer-depth [env : TcTypeEnv]) : i64
  (match (tc-type-env-view env)
    [(Cache _ scan-through partial _ below)
      (if (and scan-through partial)
        (+ 1 (tc-env-partial-layer-depth below))
        0)]
    [_ 0]))

;; Local partial caches allocate their value arrays at exactly twice the number
;; of covered spine binds (the local threshold is well above the tiny-cache
;; minimum). This lets a collapsed layer retain its exact coverage without
;; widening TcTypeEnv: later collapses can sum old layers and stop at the
;; immutable explicit top-env boundary.
(define (tc-env-partial-local-covered-count [env : TcTypeEnv]) : i64
  (match (tc-type-env-view env)
    [(Cache cache-ptr scan-through partial _ below)
      (let
        [values : (__tl_dyn-array ast.AstType)
          (tc-type-env-cache-field-at cache-ptr 56 (__tl_dyn-array ast.AstType))]
        (if (and scan-through partial)
          (+
            (/ (array-length values) 2)
            (tc-env-partial-local-covered-count below))
          0))]
    [_ 0]))

(define (tc-env-partial-local-base [env : TcTypeEnv]) : TcTypeEnv
  (match (tc-type-env-view env)
    [(Cache _ scan-through partial _ below)
      (if (and scan-through partial)
        (tc-env-partial-local-base below)
        env)]
    [_ env]))

(define (tc-env-uncached-prefix-to-explicit-cache-count [env : TcTypeEnv]) : i64
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    [count : i64 0]
    [found : bool false]
    [done : bool false]
    (while (not done)
      (cond
        [(>= head 0)
          (let
            [binding-ptr : (Ptr TcTypeEnvBinding)
              (tc-type-env-binding-ptr store-handle head)]
            (set! count (+ count 1))
            (set! head (tc-type-env-binding-parent-at binding-ptr)))]
        [(< head -1)
          (let
            [cache : TcTypeEnvCache
              (tc-type-env-cache-at
                (tc-type-env-cache-ptr
                  store-handle
                  (tc-type-env-cache-index head)))]
            (if cache.scan-through
              (if cache.partial
                (let
                  [shadow-flags : (__tl_dyn-array i64) cache.shadow-flags]
                  [capacity : i64 (array-length shadow-flags)]
                  [covered : i64 (array-ref shadow-flags (- capacity 1))]
                  (set! count (+ count covered))
                  (set! head cache.below))
                (set! done true))
              (begin
                (set! found true)
                (set! done true))))]
        [else (set! done true)]))
    (if found
      count
      -1)))

;; Walk an exact binding count through both ordinary spine nodes and partial
;; cache nodes. `rest` is the original covered spine, so it is the authoritative
;; route when the requested boundary lies inside or immediately after a partial
;; layer.
(define (tc-env-after-cache-expanded-prefix [env : TcTypeEnv] [remaining : i64]) : TcTypeEnv
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    [left : i64 remaining]
    [done : bool false]
    (while (and (not done) (> left 0))
      (cond
        [(>= head 0)
          (let
            [binding-ptr : (Ptr TcTypeEnvBinding)
              (tc-type-env-binding-ptr store-handle head)]
            (set! head (tc-type-env-binding-parent-at binding-ptr))
            (set! left (- left 1)))]
        [(< head -1)
          (let
            [cache : TcTypeEnvCache
              (tc-type-env-cache-at
                (tc-type-env-cache-ptr
                  store-handle
                  (tc-type-env-cache-index head)))]
            (if (and cache.scan-through cache.partial)
              (set! head cache.rest)
              (set! done true)))]
        [else (set! done true)]))
    (TcTypeEnv store-handle head env.abi-pad)))

(define (tc-env-compact-local-if-threshold [env : TcTypeEnv]) : TcTypeEnv
  (let
    [topenv-state : TcTopEnvMembershipState
      (tc-type-env-topenv-membership-state env)]
    [topenv-mode : i64 (tc-topenv-membership-mode topenv-state)]
    (if (not (= (bit-and topenv-mode 6) 0))
      env
      (if (tc-env-uncached-prefix-reaches-cache? env (tc-local-cache-threshold))
        (let
          [below : TcTypeEnv
            (tc-env-after-prefix env (tc-local-cache-threshold))]
          (if (>=
            (tc-env-partial-layer-depth below)
            (tc-local-cache-partial-layer-cap))
            (tc-env-with-collapsed-local-cache env)
            (tc-env-with-local-cache env)))
        env))))

(define (tc-bind-id [env : TcTypeEnv] [name-id : i64] [ty : ast.AstType]) : TcTypeEnv
  (tc-env-compact-local-if-threshold (tc-bind-raw-id env name-id ty)))

(define (tc-unsafe-decl-marker-key-id? [key : i64] [name-id : i64]) : bool
  (= key (tc-unsafe-decl-marker-id name-id)))

;; Environment keys are either interner ids or packed nonnegative composite
;; ids. Negative odd ids form an allocation-free unsafe declaration marker namespace.
(define (tc-unsafe-decl-marker-id [name-id : i64]) : i64
  (- 0 (+ (* name-id 2) 1)))

(define (tc-bind-unsafe-id [env : TcTypeEnv] [name-id : i64] [ty : ast.AstType]) : TcTypeEnv
  (let
    [next-env : TcTypeEnv
      (tc-env-compact-local-if-threshold
        (tc-bind-raw-id
          (tc-bind-raw-id env (tc-unsafe-decl-marker-id name-id) (Unit))
          name-id
          ty))]
    (if (tc-type-env-scoped-runtime-active? next-env)
      (tc-type-env-scoped-runtime-mark-latest-flags-id!
        next-env
        name-id
        tc-type-env-scoped-flag-unsafe)
      unit)
    next-env))

(define tc-type-env-scoped-flag-unsafe : i64
  1)
(define tc-type-env-scoped-flag-marker : i64
  4)

(define (tc-type-env-scoped-capacity [capacity : i64]) : i64
  (if (< capacity 1)
    1
    capacity))

(define (tc-type-env-scoped-marker-kind-tag [kind : TcTypeEnvScopedMarkerKind]) : i64
  (match kind
    [(None) 0]
    [(UnsafeDecl) 1]
    [(DefaultBoundary) 3]
    [(Region) 4]
    [(UnsafeContext) 5]
    [(CleanupOwner) 6]
    [(OrdinaryArenaOwner) 7]
    [(AtomicArenaOwner) 8]
    [(Other) 9]))

(define (tc-type-env-scoped-marker-kind-from-tag [tag : i64]) : TcTypeEnvScopedMarkerKind
  (cond
    [(= tag 0) None]
    [(= tag 1) UnsafeDecl]
    [(= tag 3) DefaultBoundary]
    [(= tag 4) Region]
    [(= tag 5) UnsafeContext]
    [(= tag 6) CleanupOwner]
    [(= tag 7) OrdinaryArenaOwner]
    [(= tag 8) AtomicArenaOwner]
    [else Other]))

(define (tc-type-env-scoped-marker-kind-same?
  [left : TcTypeEnvScopedMarkerKind]
  [right : TcTypeEnvScopedMarkerKind]) : bool
  (=
    (tc-type-env-scoped-marker-kind-tag left)
    (tc-type-env-scoped-marker-kind-tag right)))

(define (tc-type-env-scoped-flag? [flags : i64] [flag : i64]) : bool
  (not (= (bit-and flags flag) 0)))

;; Each scoped stack has a unique per-job epoch, so nested carriers can
;; overwrite that job's dense entries safely; restoring an older carrier lazily
;; repairs only queried names.
(define (tc-type-env-scoped-state-next-lookup-epoch!
  [state : TcTypeEnvScopedState]) : i64
  (unsafe
    (let
      [data : (MutPtr TcTypeEnvScopedStateData)
        (tc-type-env-scoped-state-ptr state)]
      [epoch : i64 (deref data).next-lookup-epoch]
      (set! (deref data).next-lookup-epoch (+ epoch 1))
      epoch)))

(define (tc-type-env-scoped-stack-state [stack : TcTypeEnvScopedStack]) : TcTypeEnvScopedState
  (TcTypeEnvScopedState stack.state-address))

(define (tc-type-env-scoped-state-dense-lookup-indices [state-address : i64]) : (__tl_dyn-array
    i64)
  (tc-type-env-scoped-state-field
    (TcTypeEnvScopedState state-address)
    dense-lookup-indices
    (__tl_dyn-array i64)))

(define (tc-type-env-scoped-state-dense-lookup-epochs [state-address : i64]) : (__tl_dyn-array
    i64)
  (tc-type-env-scoped-state-field
    (TcTypeEnvScopedState state-address)
    dense-lookup-epochs
    (__tl_dyn-array i64)))

(define (tc-type-env-scoped-stack-with-capacity-for-state
  [state : TcTypeEnvScopedState]
  [slot-capacity : i64]
  [mark-capacity : i64]) : TcTypeEnvScopedStack
  (let
    [lookup-epoch : i64 (tc-type-env-scoped-state-next-lookup-epoch! state)]
    ;; The state owns only the fixed carrier, dense lanes, and memo cells.
    ;; Scoped stacks are transient pass data and must follow the caller's
    ;; current scratch arena; retaining every function's stack in the state
    ;; arena would keep them all alive for the whole compile.
    (TcTypeEnvScopedStack
      state.address
      (__tl_make-array
        TcTypeEnvScopedSlot
        (tc-type-env-scoped-capacity slot-capacity))
      0
      (box
        (tc_i64_i64_map.with-capacity
          (tc-type-env-scoped-capacity slot-capacity)))
      lookup-epoch
      (__tl_make-array
        TcTypeEnvScopedMark
        (tc-type-env-scoped-capacity mark-capacity))
      0
      0
      0)))

(define (tc-type-env-scoped-stack-new-for-state [state : TcTypeEnvScopedState]) : TcTypeEnvScopedStack
  (tc-type-env-scoped-stack-with-capacity-for-state state 16 8))

(define (tc-type-env-scoped-stack-len [stack : (& stack TcTypeEnvScopedStack)]) : i64
  stack.slot-count)

(define (tc-type-env-scoped-stack-cache-generation
  [stack : (& stack TcTypeEnvScopedStack)]) : i64
  stack.cache-generation)

(define (tc-type-env-scoped-empty-slot) : TcTypeEnvScopedSlot
  (TcTypeEnvScopedSlot 0 (Unit) 0 0 0 0))

(define (tc-type-env-scoped-stack-reserve-slots!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [min-capacity : i64]) : unit
  (while (< (array-length stack.slots) min-capacity)
    (__tl_array-push! stack.slots (tc-type-env-scoped-empty-slot)))
  unit)

(define (tc-type-env-scoped-stack-push-slot!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [name-id : i64]
  [ty : ast.AstType]
  [flags : i64]
  [marker-kind : TcTypeEnvScopedMarkerKind]) : unit
  (let
    [index : i64 stack.slot-count]
    [dense-indices : (__tl_dyn-array i64)
      (tc-type-env-scoped-state-dense-lookup-indices stack.state-address)]
    [dense-epochs : (__tl_dyn-array i64)
      (tc-type-env-scoped-state-dense-lookup-epochs stack.state-address)]
    (begin
      (tc-type-env-scoped-stack-reserve-slots! stack (+ index 1))
      ;; A restored stack reuses array storage. Invalidate the overwritten
      ;; name's cached index so an in-range hit always names this slot.
      (let
        [old-name-id : i64
          (__tl-project-field (array-ref stack.slots index) name-id)]
        (if (and
          (>= old-name-id 0)
          (< old-name-id tc-type-env-scoped-dense-lookup-capacity))
          (if (and
            (= (array-ref dense-epochs old-name-id) stack.lookup-epoch)
            (= (array-ref dense-indices old-name-id) index))
            (set! (array-ref dense-epochs old-name-id) 0)
            unit)
          (match (tc_i64_i64_map.get
            (& (__tl-box-place stack.lookup-cache))
            old-name-id)
            [(LookupFound old-index)
              (if (= old-index index)
                (tc_i64_i64_map.insert-ref!
                  (&mut (__tl-box-place stack.lookup-cache))
                  old-name-id
                  -1)
                unit)]
            [(LookupMissing) unit])))
      (set!
        (array-ref stack.slots index)
        (TcTypeEnvScopedSlot
          name-id
          ty
          flags
          (tc-type-env-scoped-marker-kind-tag marker-kind)
          stack.scope-depth
          stack.cache-generation))
      (if (and
        (>= name-id 0)
        (< name-id tc-type-env-scoped-dense-lookup-capacity))
        (begin
          (set! (array-ref dense-indices name-id) index)
          (set! (array-ref dense-epochs name-id) stack.lookup-epoch))
        (tc_i64_i64_map.insert-ref!
          (&mut (__tl-box-place stack.lookup-cache))
          name-id
          index))
      (cfg compile-profile (counters.bump! tc-profile-env-scoped-binds))
      (set! stack.slot-count (+ index 1))
      unit)))

(define (tc-semantic-observe-binding-site!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [initializer : i64]) : unit
  (when
    (and
      (> tc-semantic-observed-jobs 0)
      (!= (tc-context-semantic-observer ctx).address 0))
    (tc-semantic-observer-send!
      (tc-context-semantic-observer ctx)
      ctx
      env
      (BindingSite
        (tc-expr-id-maybe-span (tc-context-expr-bases ctx) initializer)))))

(defmacro (tc-semantic-observe-binding! [stack : Expr]) : Expr
  `(when
    (> tc-semantic-observed-jobs 0)
    (tc-semantic-observe-binding-active! ,stack)))

(define (tc-semantic-observe-binding-active!
  [stack : (& stack TcTypeEnvScopedStack)]) : unit
  (let
    [observer : TcSemanticObserver
      (tc-state-cell-read
        (+
          stack.state-address
          (comptime
            (offset-of (type TcTypeEnvScopedStateData) semantic-observer)))
        TcSemanticObserver)]
    (when
      (!= observer.address 0)
      (let
        [index : i64 (- stack.slot-count 1)]
        [slot : TcTypeEnvScopedSlot
          (tc-global-array-element-shared-view stack.slots index)]
        (when
          (and
            (= slot.flags 0)
            (match (tc-type-env-scoped-visible-marker-kind
              slot.name-id
              (tc-global-shared-view slot.ty))
              [(None) true]
              [_ false]))
          (let
            [data : TcSemanticObserverData
              (tc-state-cell-read observer.address TcSemanticObserverData)]
            (data.callback
              data.context
              data.active-context
              (TcTypeEnv 0 -1 0)
              (Binding
                stack.lookup-epoch
                index
                slot.generation
                slot.name-id
                stack.scope-depth
                (tc-global-shared-view slot.ty)))))))))

(defmacro (tc-semantic-observe-binding-transfer!
  [stack : Expr]
  [index : Expr]
  [env : Expr]
  [imported : Expr]) : Expr
  `(when
    (> tc-semantic-observed-jobs 0)
    (tc-semantic-observe-binding-transfer-active! ,stack ,index ,env ,imported)))

(define (tc-semantic-observe-binding-transfer-active!
  [stack : (& stack TcTypeEnvScopedStack)]
  [index : i64]
  [env : TcTypeEnv]
  [imported : bool]) : unit
  (let
    [observer : TcSemanticObserver
      (tc-state-cell-read
        (+
          stack.state-address
          (comptime
            (offset-of (type TcTypeEnvScopedStateData) semantic-observer)))
        TcSemanticObserver)]
    (when
      (!= observer.address 0)
      (let
        [data : TcSemanticObserverData
          (tc-state-cell-read observer.address TcSemanticObserverData)]
        (data.callback
          data.context
          data.active-context
          env
          (if imported
            (BindingImported
              stack.lookup-epoch
              index
              (array-ref stack.slots index).generation
              env.store
              env.head)
            (BindingMaterialized
              stack.lookup-epoch
              index
              (array-ref stack.slots index).generation
              env.store
              env.head)))))))

(define (tc-type-env-scoped-stack-bind-id!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [name-id : i64]
  [ty : ast.AstType]) : unit
  (tc-type-env-scoped-stack-push-slot! stack name-id ty 0 None)
  (tc-semantic-observe-binding! stack))

(define (tc-type-env-scoped-stack-bind-marker-id!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [name-id : i64]
  [ty : ast.AstType]
  [marker-kind : TcTypeEnvScopedMarkerKind]) : unit
  (tc-type-env-scoped-stack-push-slot!
    stack
    name-id
    ty
    tc-type-env-scoped-flag-marker
    marker-kind))

(define (tc-type-env-scoped-clamp-count [value : i64] [current : i64]) : i64
  (if (< value 0)
    0
    (if (> value current)
      current
      value)))

(define (tc-type-env-scoped-stack-restore!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [mark : TcTypeEnvScopedMark]) : unit
  (set!
    stack.slot-count
    (tc-type-env-scoped-clamp-count mark.slot-count stack.slot-count))
  (set!
    stack.mark-count
    (tc-type-env-scoped-clamp-count mark.mark-count stack.mark-count))
  (set!
    stack.scope-depth
    (tc-type-env-scoped-clamp-count mark.scope-depth stack.scope-depth))
  (set! stack.cache-generation (+ stack.cache-generation 1)))

(define (tc-type-env-scoped-stack-slot-at
  [stack : (& stack TcTypeEnvScopedStack)]
  [index : i64]) : TcTypeEnvScopedSlot
  (let
    [address : u64
      (unsafe
        (ptr->int (ptr-offset (__tl_array-data stack.slots) index)))]
    (unsafe
      (ptr-read (int->ptr address : (Ptr TcTypeEnvScopedSlot))))))

(define (tc-type-env-scoped-stack-lookup-id-at
  [stack : (& stack TcTypeEnvScopedStack)]
  [index : i64]) : TcTypeEnvScopedLookup
  (if (< index 0)
    Missing
    (let
      [slot : TcTypeEnvScopedSlot
        (tc-type-env-scoped-stack-slot-at stack index)]
      (Found
        slot.ty
        (tc-type-env-scoped-flag? slot.flags tc-type-env-scoped-flag-unsafe)
        (tc-type-env-scoped-marker-kind-from-tag slot.marker-kind-tag)
        slot.scope-depth
        slot.generation))))

(define (tc-type-env-scoped-stack-dense-lookup-id-refresh
  [stack : (& stack TcTypeEnvScopedStack)]
  [name-id : i64]) : i64
  (let
    [dense-indices : (__tl_dyn-array i64)
      (tc-type-env-scoped-state-dense-lookup-indices stack.state-address)]
    [dense-epochs : (__tl_dyn-array i64)
      (tc-type-env-scoped-state-dense-lookup-epochs stack.state-address)]
    [index : i64
      (tc-type-env-scoped-stack-find-id-index-from
        stack
        name-id
        (- stack.slot-count 1))]
    (begin
      (set! (array-ref dense-indices name-id) index)
      (set! (array-ref dense-epochs name-id) stack.lookup-epoch)
      (cfg compile-profile (counters.bump! tc-profile-env-scoped-cache-misses))
      index)))

(define (tc-type-env-scoped-stack-map-cached-index
  [lookup-cache : (& lookup-cache tc_i64_i64_map.Map)]
  [name-id : i64]) : i64
  (match (tc_i64_i64_map.get lookup-cache name-id)
    [(LookupFound index) index]
    [(LookupMissing) -2]))

(define (tc-type-env-scoped-stack-map-lookup-id
  [stack : (& stack TcTypeEnvScopedStack)]
  [name-id : i64]) : i64
  (let
    [lookup-cache : (Box tc_i64_i64_map.Map) stack.lookup-cache]
    [index : i64
      (tc-type-env-scoped-stack-map-cached-index
        (& (__tl-box-place lookup-cache))
        name-id)]
    (if (= index -2)
      (begin
        (cfg
          compile-profile
          (counters.bump! tc-profile-env-scoped-cache-misses))
        -1)
      (if (and
        (>= index 0)
        (< index stack.slot-count)
        (= (__tl-project-field (array-ref stack.slots index) name-id) name-id))
        (begin
          (cfg
            compile-profile
            (counters.bump! tc-profile-env-scoped-cache-hits))
          index)
        (begin
          (cfg
            compile-profile
            (counters.bump! tc-profile-env-scoped-cache-misses))
          (let
            [repaired-index : i64
              (tc-type-env-scoped-stack-find-id-index-from
                stack
                name-id
                (- stack.slot-count 1))]
            (tc_i64_i64_map.insert-ref!
              (&mut (__tl-box-place lookup-cache))
              name-id
              repaired-index)
            repaired-index))))))

(define (tc-type-env-scoped-stack-lookup-index
  [stack : (& stack TcTypeEnvScopedStack)]
  [name-id : i64]) : i64
  (if (and (>= name-id 0) (< name-id tc-type-env-scoped-dense-lookup-capacity))
    (let
      [dense-indices : (__tl_dyn-array i64)
        (tc-type-env-scoped-state-dense-lookup-indices stack.state-address)]
      [dense-epochs : (__tl_dyn-array i64)
        (tc-type-env-scoped-state-dense-lookup-epochs stack.state-address)]
      (if (= (array-ref dense-epochs name-id) stack.lookup-epoch)
        (let
          [index : i64 (array-ref dense-indices name-id)]
          (if (< index 0)
            (begin
              (cfg
                compile-profile
                (counters.bump! tc-profile-env-scoped-cache-hits))
              -1)
            (if (< index stack.slot-count)
              (begin
                (cfg
                  compile-profile
                  (counters.bump! tc-profile-env-scoped-cache-hits))
                index)
              (tc-type-env-scoped-stack-dense-lookup-id-refresh
                (& stack)
                name-id))))
        (tc-type-env-scoped-stack-dense-lookup-id-refresh (& stack) name-id)))
    (tc-type-env-scoped-stack-map-lookup-id stack name-id)))

(define (tc-type-env-scoped-stack-lookup-id
  [stack : (& stack TcTypeEnvScopedStack)]
  [name-id : i64]) : TcTypeEnvScopedLookup
  (let
    [index : i64 (tc-type-env-scoped-stack-lookup-index stack name-id)]
    (tc-type-env-scoped-stack-lookup-id-at stack index)))

(define (tc-type-env-scoped-stack-owner-marker-before?
  [stack : TcTypeEnvScopedStack]
  [index : i64]
  [name-id : i64]
  [marker-id : i64]) : bool
  (if (<= index 0)
    false
    (let
      [slot : TcTypeEnvScopedSlot
        (tc-global-array-element-shared-view stack.slots (- index 1))]
      (tc-arena-owner-marker-for? marker-id slot.name-id slot.ty name-id))))

(define (tc-type-env-scoped-stack-cleanup-owner-before?
  [stack : TcTypeEnvScopedStack]
  [index : i64]
  [name-id : i64]) : bool
  (if (<= index 0)
    false
    (let
      [slot : TcTypeEnvScopedSlot
        (tc-global-array-element-shared-view stack.slots (- index 1))]
      (tc-cleanup-owner-marker-for? slot.name-id slot.ty name-id))))

(define (tc-type-env-scoped-marker-cursor [stack : TcTypeEnvScopedStack]) : TcTypeEnvScopedMarkerCursor
  (let
    [index : i64 (- (tc-type-env-scoped-stack-len stack) 1)]
    (TcTypeEnvScopedMarkerCursor stack index)))

(define (tc-type-env-scoped-marker-step [cursor : TcTypeEnvScopedMarkerCursor]) : TcTypeEnvScopedMarkerStep
  (let
    [index : i64 cursor.index]
    (if (< index 0)
      Done
      (let
        [slot : TcTypeEnvScopedSlot
          (tc-global-array-element-shared-view cursor.stack.slots index)]
        (Bind
          slot.name-id
          slot.ty
          (TcTypeEnvScopedMarkerCursor cursor.stack (- index 1)))))))

(define (tc-type-env-scoped-stack-find-id-index-from
  [stack : (& stack TcTypeEnvScopedStack)]
  [name-id : i64]
  [index : i64]) : i64
  (if (< index 0)
    -1
    (if (= (__tl-project-field (array-ref stack.slots index) name-id) name-id)
      index
      (tc-type-env-scoped-stack-find-id-index-from stack name-id (- index 1)))))

(define (tc-type-env-scoped-stack-find-id-index
  [stack : (& stack TcTypeEnvScopedStack)]
  [name-id : i64]) : i64
  (tc-type-env-scoped-stack-find-id-index-from
    stack
    name-id
    (- stack.slot-count 1)))

(define (tc-type-env-scoped-stack-find-lifetime-index-from
  [stack : (& stack TcTypeEnvScopedStack)]
  [session : cis.InternStructuralSessionHandle]
  [lifetime-id : i64]
  [signature-marker-id : i64]
  [index : i64]) : i64
  (if (< index 0)
    -1
    (let
      [slot : TcTypeEnvScopedSlot
        (tc-global-array-element-shared-view stack.slots index)]
      (if (tc-env-binding-matches-lifetime-id?
        session
        slot.name-id
        slot.ty
        lifetime-id
        signature-marker-id)
        index
        (tc-type-env-scoped-stack-find-lifetime-index-from
          stack
          session
          lifetime-id
          signature-marker-id
          (- index 1))))))

(define (tc-type-env-scoped-stack-find-lifetime-index
  [stack : (& stack TcTypeEnvScopedStack)]
  [session : cis.InternStructuralSessionHandle]
  [lifetime-id : i64]) : i64
  (tc-type-env-scoped-stack-find-lifetime-index-from
    stack
    session
    lifetime-id
    (tc-signature-lifetime-marker-id)
    (- (tc-type-env-scoped-stack-len stack) 1)))

(define (tc-type-env-scoped-stack-signature-lifetime-index?
  [stack : (& stack TcTypeEnvScopedStack)]
  [index : i64]
  [lifetime-id : i64]) : bool
  (if (< index 0)
    false
    (let
      [slot : TcTypeEnvScopedSlot
        (tc-global-array-element-shared-view stack.slots index)]
      (tc-signature-lifetime-marker-entry-id?
        slot.name-id
        slot.ty
        lifetime-id
        (tc-signature-lifetime-marker-id)))))

(define (tc-type-env-scoped-visible-marker-kind
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnvScopedMarkerKind
  (cond
    [(= name-id (tc-unsafe-marker-id)) UnsafeContext]
    [(= name-id (tc-return-type-id)) Other]
    [(= name-id (tc-loop-target-id)) Other]
    [(= name-id (tc-default-boundary-id)) DefaultBoundary]
    [(= name-id (tc-region-marker-id)) Region]
    [(= name-id (tc-signature-lifetime-marker-id)) Other]
    [(tc-cleanup-owner-marker-entry? name-id ty) CleanupOwner]
    [(tc-ordinary-arena-owner-marker-entry? name-id (tc-global-shared-view ty))
      OrdinaryArenaOwner]
    [(tc-atomic-arena-owner-marker-entry? name-id ty) AtomicArenaOwner]
    [else None]))

(define (tc-type-env-scoped-visible-bind-flags
  [rest-env : TcTypeEnv]
  [name-id : i64]) : i64
  (if (tc-binding-unsafe-marker-head-id? rest-env name-id)
    tc-type-env-scoped-flag-unsafe
    0))

(define (tc-type-env-scoped-stack-push-visible-bind!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [name-id : i64]
  [ty : ast.AstType]
  [rest-env : TcTypeEnv]) : unit
  (let
    [marker-kind : TcTypeEnvScopedMarkerKind
      (tc-type-env-scoped-visible-marker-kind
        name-id
        (tc-global-shared-view ty))]
    [flags : i64 (tc-type-env-scoped-visible-bind-flags rest-env name-id)]
    [slot-flags : i64
      (if (tc-type-env-scoped-marker-kind-same? marker-kind None)
        flags
        (bit-or flags tc-type-env-scoped-flag-marker))]
    (tc-type-env-scoped-stack-push-slot!
      stack
      name-id
      ty
      slot-flags
      marker-kind)))

(define (tc-type-env-scoped-sidecar-fill-visible-env!
  [sidecar : (&mut sidecar TcTypeEnvScopedSidecar)]
  [env : TcTypeEnv]) : unit
  (match (tc-type-env-marker-step env)
    [(Done) unit]
    [(Cache rest-env)
      (tc-type-env-scoped-sidecar-fill-visible-env! sidecar rest-env)]
    [(Bind key ty rest-env)
      (tc-type-env-scoped-sidecar-fill-visible-env! sidecar rest-env)
      (tc-type-env-scoped-stack-push-visible-bind!
        (&mut sidecar.stack)
        key
        ty
        rest-env)
      (tc-semantic-observe-binding-transfer!
        (& sidecar.stack)
        (- sidecar.stack.slot-count 1)
        env
        true)]))

(define (tc-type-env-scoped-sidecar-from-marker-visible-env [env : TcTypeEnv]) : TcTypeEnvScopedSidecar
  (let
    [sidecar : TcTypeEnvScopedSidecar (tc-type-env-scoped-sidecar-from-env env)]
    (tc-type-env-scoped-sidecar-fill-visible-env!
      (&mut sidecar)
      (tc-type-env-marker-start env))
    (set!
      sidecar.materialize-start
      (tc-type-env-scoped-stack-len sidecar.stack))
    sidecar))

(define (tc-type-env-scoped-sidecar-from-env [env : TcTypeEnv]) : TcTypeEnvScopedSidecar
  (TcTypeEnvScopedSidecar
    env
    (tc-type-env-scoped-stack-new-for-state (tc-type-env-scoped-state env))
    0))

(define (tc-type-env-scoped-sidecar-marker-cursor
  [sidecar : TcTypeEnvScopedSidecar]) : TcTypeEnvScopedMarkerCursor
  (tc-type-env-scoped-marker-cursor sidecar.stack))

(define (tc-type-env-scoped-sidecar-persistent
  [sidecar : TcTypeEnvScopedSidecar]) : TcTypeEnv
  sidecar.persistent)

(define (tc-type-env-scoped-sidecar-lookup-id
  [sidecar : TcTypeEnvScopedSidecar]
  [name-id : i64]) : TcTypeEnvScopedLookup
  (tc-type-env-scoped-stack-lookup-id sidecar.stack name-id))

(define (tc-type-env-scoped-sidecar-mark
  [sidecar : TcTypeEnvScopedSidecar]
  [stack-mark : TcTypeEnvScopedMark]) : TcTypeEnvScopedSidecarMark
  (TcTypeEnvScopedSidecarMark
    sidecar.persistent
    stack-mark
    sidecar.materialize-start))

(define (tc-type-env-scoped-sidecar-restore!
  [sidecar : (&mut sidecar TcTypeEnvScopedSidecar)]
  [mark : TcTypeEnvScopedSidecarMark]) : unit
  (set! sidecar.persistent mark.persistent)
  (set! sidecar.materialize-start mark.materialize-start)
  (tc-type-env-scoped-stack-restore! (&mut sidecar.stack) mark.stack-mark))

(define (tc-type-env-scoped-sidecar-bind-id
  [sidecar : TcTypeEnvScopedSidecar]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnvScopedSidecar
  (let
    [next : TcTypeEnvScopedSidecar sidecar]
    (tc-type-env-scoped-stack-bind-id! (&mut next.stack) name-id ty)
    next))

(define (tc-type-env-scoped-sidecar-bind-marker-id
  [sidecar : TcTypeEnvScopedSidecar]
  [name-id : i64]
  [ty : ast.AstType]
  [marker-kind : TcTypeEnvScopedMarkerKind]) : TcTypeEnvScopedSidecar
  (let
    [next : TcTypeEnvScopedSidecar sidecar]
    (tc-type-env-scoped-stack-bind-marker-id!
      (&mut next.stack)
      name-id
      ty
      marker-kind)
    next))

(define (tc-type-env-scoped-sidecar-bind-return-type
  [sidecar : TcTypeEnvScopedSidecar]
  [ty : ast.AstType]) : TcTypeEnvScopedSidecar
  (tc-type-env-scoped-sidecar-bind-marker-id
    sidecar
    (tc-return-type-id)
    ty
    Other))

;; The scoped stack owns local bindings. The persistent env is an immutable
;; module/top-level tail and is materialized only when an older TcTypeEnv API
;; explicitly asks for a snapshot. Walking slots from oldest to newest rebuilds
;; the same head-first lexical order without putting a persistent node on every
;; carrier bind.
(define (tc-type-env-scoped-stack-materialize-at
  [stack : TcTypeEnvScopedStack]
  [index : i64]
  [env : TcTypeEnv]) : TcTypeEnv
  (if (>= index (tc-type-env-scoped-stack-len stack))
    env
    (let
      [slot : TcTypeEnvScopedSlot
        (tc-global-array-element-shared-view stack.slots index)]
      (tc-type-env-scoped-stack-materialize-at
        (tc-global-shared-view stack)
        (+ index 1)
        (begin
          (cfg compile-profile (counters.bump! tc-profile-env-binds))
          (let
            [next : TcTypeEnv (tc-type-env-bind-node env slot.name-id slot.ty)]
            (tc-semantic-observe-binding-transfer! (& stack) index next false)
            next))))))

(define (tc-type-env-scoped-sidecar-materialize
  [sidecar : TcTypeEnvScopedSidecar]) : TcTypeEnv
  (begin
    (cfg
      compile-profile
      (begin
        (counters.bump! tc-profile-env-scoped-materializations)
        (counters.add!
          tc-profile-env-scoped-materialized-slots
          (-
            (tc-type-env-scoped-stack-len sidecar.stack)
            sidecar.materialize-start))))
    (tc-type-env-scoped-stack-materialize-at
      sidecar.stack
      sidecar.materialize-start
      sidecar.persistent)))

(define (tc-type-env-scoped-carrier-from-env [env : TcTypeEnv]) : TcTypeEnvScopedCarrier
  (TcTypeEnvScopedCarrier env (tc-type-env-scoped-sidecar-from-env env) false))

(define (tc-type-env-scoped-carrier-from-marker-visible-env [env : TcTypeEnv]) : TcTypeEnvScopedCarrier
  (TcTypeEnvScopedCarrier
    env
    (tc-type-env-scoped-sidecar-from-marker-visible-env env)
    false))

(define (tc-type-env-scoped-carrier-env
  [carrier : (& carrier TcTypeEnvScopedCarrier)]) : TcTypeEnv
  (let
    [carrier : TcTypeEnvScopedCarrier
      (owned_view.compiler-owned-reference-shared-view carrier)]
    (if carrier.dirty
      (tc-type-env-scoped-sidecar-materialize carrier.sidecar)
      carrier.env)))

(define (tc-type-env-scoped-carrier-persistent
  [carrier : TcTypeEnvScopedCarrier]) : TcTypeEnv
  (tc-type-env-scoped-sidecar-persistent carrier.sidecar))

(define (tc-type-env-scoped-carrier-marker-cursor
  [carrier : TcTypeEnvScopedCarrier]) : TcTypeEnvScopedMarkerCursor
  (tc-type-env-scoped-sidecar-marker-cursor carrier.sidecar))

(define (tc-type-env-scoped-carrier-with-sidecar
  [carrier : TcTypeEnvScopedCarrier]
  [sidecar : TcTypeEnvScopedSidecar]) : TcTypeEnvScopedCarrier
  (TcTypeEnvScopedCarrier carrier.env sidecar true))

(define (tc-type-env-scoped-carrier-snapshot-mark
  [carrier : TcTypeEnvScopedCarrier]) : TcTypeEnvScopedCarrierMark
  (let
    [sidecar : TcTypeEnvScopedSidecar carrier.sidecar]
    [stack : TcTypeEnvScopedStack (tc-global-shared-view sidecar.stack)]
    (TcTypeEnvScopedCarrierMark
      carrier.env
      (tc-type-env-scoped-sidecar-mark
        sidecar
        (TcTypeEnvScopedMark
          stack.slot-count
          stack.mark-count
          stack.scope-depth
          stack.cache-generation))
      carrier.dirty)))

(define (tc-type-env-scoped-carrier-restore
  [carrier : TcTypeEnvScopedCarrier]
  [mark : TcTypeEnvScopedCarrierMark]) : TcTypeEnvScopedCarrier
  (let
    [sidecar : TcTypeEnvScopedSidecar carrier.sidecar]
    (tc-type-env-scoped-sidecar-restore! (&mut sidecar) mark.sidecar-mark)
    (TcTypeEnvScopedCarrier mark.env sidecar mark.dirty)))

(define (tc-type-env-scoped-carrier-bind-id
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-with-sidecar
    (tc-global-shared-view carrier)
    (tc-type-env-scoped-sidecar-bind-id carrier.sidecar name-id ty)))

(define (tc-type-env-scoped-carrier-bind-return-type
  [carrier : TcTypeEnvScopedCarrier]
  [ty : ast.AstType]) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-with-sidecar
    (tc-global-shared-view carrier)
    (tc-type-env-scoped-sidecar-bind-return-type carrier.sidecar ty)))

(define (tc-type-env-scoped-carrier-marker-type
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : ast.AstMaybeType
  (match (tc-type-env-scoped-sidecar-lookup-id
    (tc-global-shared-view carrier.sidecar)
    name-id)
    [(Found ty _ _ _ _) (Some ty)]
    [(Missing)
      (tc-env-marker-type
        (tc-type-env-scoped-sidecar-persistent carrier.sidecar)
        name-id)]))

(define (tc-type-env-scoped-carrier-in-unsafe?
  [carrier : TcTypeEnvScopedCarrier]) : bool
  (match (tc-type-env-scoped-carrier-marker-type carrier (tc-unsafe-marker-id))
    [(Some (Unit)) true]
    [(or (Some _) (No)) false]))

(define (tc-type-env-scoped-carrier-current-return-type
  [carrier : TcTypeEnvScopedCarrier]) : ResultTcType
  (match (tc-type-env-scoped-carrier-marker-type carrier (tc-return-type-id))
    [(Some ty) (Ok ty)]
    [(No) (Err "typecheck: try requires enclosing Result-like function")]))

(define (tc-type-env-scoped-carrier-active-region
  [carrier : TcTypeEnvScopedCarrier]) : TcMaybeNameId
  (match (tc-type-env-scoped-carrier-marker-type
    (tc-global-shared-view carrier)
    (tc-region-marker-id))
    [(Some (Var region)) (Some region)]
    [(Some _) (tc-active-region carrier.env)]
    [(No) (No)]))

;; Fully materialized marker-visible snapshots and the active function-body
;; runtime use stack indexes here. A miss falls back only to the carrier's
;; immutable module/top-level tail; inactive passes keep using TcTypeEnv's
;; relevance-indexed owner cache below.
(define (tc-type-env-scoped-carrier-cleanup-owner-active?
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : bool
  (let
    [stack : TcTypeEnvScopedStack (tc-global-shared-view carrier.sidecar.stack)]
    [index : i64 (tc-type-env-scoped-stack-find-id-index (& stack) name-id)]
    (if (>= index 0)
      (tc-type-env-scoped-stack-cleanup-owner-before? stack index name-id)
      (tc-cleanup-owner-active-persistent-id?
        (tc-type-env-scoped-carrier-persistent carrier)
        name-id))))

(define (tc-type-env-scoped-carrier-arena-owner-active?
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]
  [marker-id : i64]) : bool
  (let
    [stack : TcTypeEnvScopedStack (tc-global-shared-view carrier.sidecar.stack)]
    [index : i64 (tc-type-env-scoped-stack-find-id-index (& stack) name-id)]
    (if (>= index 0)
      (tc-type-env-scoped-stack-owner-marker-before?
        stack
        index
        name-id
        marker-id)
      (tc-arena-owner-active-persistent-id?
        (tc-type-env-scoped-carrier-persistent carrier)
        name-id
        marker-id))))

(define (tc-type-env-scoped-carrier-state [carrier : TcTypeEnvScopedCarrier]) : TcTypeEnvScopedState
  (tc-type-env-scoped-stack-state carrier.sidecar.stack))

(define (tc-type-env-scoped-cache-clear! [state : TcTypeEnvScopedState]) : unit
  (let
    [visible : TcTypeEnvScopedVisibleCache
      (tc-type-env-scoped-cache-read
        state
        visible-cache-address
        TcTypeEnvScopedVisibleCache)]
    [binding : TcTypeEnvScopedOutlivesBindingCache
      (tc-type-env-scoped-cache-read
        state
        outlives-binding-cache-address
        TcTypeEnvScopedOutlivesBindingCache)]
    [lifetime : TcTypeEnvScopedOutlivesLifetimeCache
      (tc-type-env-scoped-cache-read
        state
        outlives-lifetime-cache-address
        TcTypeEnvScopedOutlivesLifetimeCache)]
    (set! visible.valid false)
    (set! binding.valid false)
    (set! lifetime.valid false)
    (tc-type-env-scoped-cache-write!
      state
      visible-cache-address
      visible
      TcTypeEnvScopedVisibleCache)
    (tc-type-env-scoped-cache-write!
      state
      outlives-binding-cache-address
      binding
      TcTypeEnvScopedOutlivesBindingCache)
    (tc-type-env-scoped-cache-write!
      state
      outlives-lifetime-cache-address
      lifetime
      TcTypeEnvScopedOutlivesLifetimeCache)))

(define (tc-type-env-scoped-carrier-lifetime-visible-id?
  [carrier : TcTypeEnvScopedCarrier]
  [lifetime-id : i64]) : bool
  (let
    [state : TcTypeEnvScopedState
      (tc-type-env-scoped-carrier-state (tc-global-shared-view carrier))]
    [cache : TcTypeEnvScopedVisibleCache
      (tc-type-env-scoped-cache-read
        state
        visible-cache-address
        TcTypeEnvScopedVisibleCache)]
    [stack : TcTypeEnvScopedStack (tc-global-shared-view carrier.sidecar.stack)]
    [session : cis.InternStructuralSessionHandle
      (tc-type-env-structural-session carrier.env)]
    [session-owner : i64 (cis.intern-structural-session-owner session)]
    [session-generation : i64
      (cis.intern-structural-session-current-reset-generation session)]
    [slot-count : i64 (tc-type-env-scoped-stack-len stack)]
    [generation : i64 (tc-type-env-scoped-stack-cache-generation stack)]
    (if (and
      cache.valid
      (= cache.len slot-count)
      (= cache.generation generation)
      (= cache.session-owner session-owner)
      (= cache.session-generation session-generation)
      (= cache.lifetime-id lifetime-id))
      cache.result
      (let
        [result : bool
          (if (>=
            (tc-type-env-scoped-stack-find-lifetime-index
              stack
              session
              lifetime-id)
            0)
            true
            (tc-lifetime-visible-persistent-id?
              (tc-type-env-scoped-carrier-persistent carrier)
              lifetime-id))]
        (set! cache.valid true)
        (set! cache.len slot-count)
        (set! cache.generation generation)
        (set! cache.session-owner session-owner)
        (set! cache.session-generation session-generation)
        (set! cache.lifetime-id lifetime-id)
        (set! cache.result result)
        (tc-type-env-scoped-cache-write!
          state
          visible-cache-address
          cache
          TcTypeEnvScopedVisibleCache)
        result))))

(define (tc-type-env-scoped-carrier-lifetime-outlives-binding-id?
  [carrier : TcTypeEnvScopedCarrier]
  [lifetime-id : i64]
  [target-id : i64]) : bool
  (let
    [state : TcTypeEnvScopedState
      (tc-type-env-scoped-carrier-state (tc-global-shared-view carrier))]
    [cache : TcTypeEnvScopedOutlivesBindingCache
      (tc-type-env-scoped-cache-read
        state
        outlives-binding-cache-address
        TcTypeEnvScopedOutlivesBindingCache)]
    [stack : TcTypeEnvScopedStack (tc-global-shared-view carrier.sidecar.stack)]
    [session : cis.InternStructuralSessionHandle
      (tc-type-env-structural-session carrier.env)]
    [session-owner : i64 (cis.intern-structural-session-owner session)]
    [session-generation : i64
      (cis.intern-structural-session-current-reset-generation session)]
    [slot-count : i64 (tc-type-env-scoped-stack-len stack)]
    [generation : i64 (tc-type-env-scoped-stack-cache-generation stack)]
    (if (and
      cache.valid
      (= cache.len slot-count)
      (= cache.generation generation)
      (= cache.session-owner session-owner)
      (= cache.session-generation session-generation)
      (= cache.lifetime-id lifetime-id)
      (= cache.target-id target-id))
      cache.result
      (let
        [lifetime-index : i64
          (tc-type-env-scoped-stack-find-lifetime-index
            stack
            session
            lifetime-id)]
        [target-index : i64
          (tc-type-env-scoped-stack-find-id-index (& stack) target-id)]
        [result : bool
          (cond
            [(>= lifetime-index 0)
              (and (>= target-index 0) (< lifetime-index target-index))]
            [(>= target-index 0)
              (tc-lifetime-visible-persistent-id?
                (tc-type-env-scoped-carrier-persistent carrier)
                lifetime-id)]
            [else
              (tc-lifetime-outlives-binding-persistent-id?
                (tc-type-env-scoped-carrier-persistent carrier)
                lifetime-id
                target-id)])]
        (set! cache.valid true)
        (set! cache.len slot-count)
        (set! cache.generation generation)
        (set! cache.session-owner session-owner)
        (set! cache.session-generation session-generation)
        (set! cache.lifetime-id lifetime-id)
        (set! cache.target-id target-id)
        (set! cache.result result)
        (tc-type-env-scoped-cache-write!
          state
          outlives-binding-cache-address
          cache
          TcTypeEnvScopedOutlivesBindingCache)
        result))))

(define (tc-type-env-scoped-carrier-lifetime-outlives-lifetime-id?
  [carrier : TcTypeEnvScopedCarrier]
  [value-lifetime-id : i64]
  [target-lifetime-id : i64]) : bool
  (if (= value-lifetime-id target-lifetime-id)
    true
    (let
      [state : TcTypeEnvScopedState
        (tc-type-env-scoped-carrier-state (tc-global-shared-view carrier))]
      [cache : TcTypeEnvScopedOutlivesLifetimeCache
        (tc-type-env-scoped-cache-read
          state
          outlives-lifetime-cache-address
          TcTypeEnvScopedOutlivesLifetimeCache)]
      [stack : TcTypeEnvScopedStack
        (tc-global-shared-view carrier.sidecar.stack)]
      [session : cis.InternStructuralSessionHandle
        (tc-type-env-structural-session carrier.env)]
      [session-owner : i64 (cis.intern-structural-session-owner session)]
      [session-generation : i64
        (cis.intern-structural-session-current-reset-generation session)]
      [slot-count : i64 (tc-type-env-scoped-stack-len stack)]
      [generation : i64 (tc-type-env-scoped-stack-cache-generation stack)]
      (if (and
        cache.valid
        (= cache.len slot-count)
        (= cache.generation generation)
        (= cache.session-owner session-owner)
        (= cache.session-generation session-generation)
        (= cache.value-id value-lifetime-id)
        (= cache.target-id target-lifetime-id))
        cache.result
        (let
          [value-index : i64
            (tc-type-env-scoped-stack-find-lifetime-index
              stack
              session
              value-lifetime-id)]
          [target-index : i64
            (tc-type-env-scoped-stack-find-lifetime-index
              stack
              session
              target-lifetime-id)]
          [value-signature : bool
            (tc-type-env-scoped-stack-signature-lifetime-index?
              stack
              value-index
              value-lifetime-id)]
          [target-signature : bool
            (tc-type-env-scoped-stack-signature-lifetime-index?
              stack
              target-index
              target-lifetime-id)]
          [result : bool
            (cond
              [(and value-signature target-signature) false]
              [(>= value-index 0)
                (and (>= target-index 0) (< value-index target-index))]
              [(>= target-index 0)
                (tc-lifetime-visible-persistent-id?
                  (tc-type-env-scoped-carrier-persistent carrier)
                  value-lifetime-id)]
              [else
                (tc-lifetime-outlives-lifetime-persistent-id?
                  (tc-type-env-scoped-carrier-persistent carrier)
                  value-lifetime-id
                  target-lifetime-id)])]
          (set! cache.valid true)
          (set! cache.len slot-count)
          (set! cache.generation generation)
          (set! cache.session-owner session-owner)
          (set! cache.session-generation session-generation)
          (set! cache.value-id value-lifetime-id)
          (set! cache.target-id target-lifetime-id)
          (set! cache.result result)
          (tc-type-env-scoped-cache-write!
            state
            outlives-lifetime-cache-address
            cache
            TcTypeEnvScopedOutlivesLifetimeCache)
          result)))))

;; This private marker is stable only within an intern generation.  Remember its
;; canonical ID without carrying it through every recursive environment walk.
(define tc-signature-lifetime-marker-id-generation : i64
  -1)
(define tc-signature-lifetime-marker-id-cache : i64
  -1)
(define tc-call-temporary-lifetime-id-generation : i64
  -1)
(define tc-call-temporary-lifetime-id-cache : i64
  -1)

;; Set when a call argument is typed as a borrowed temporary, so the call can
;; check its temporaries afterwards without classifying every argument
;; (`tc-call-temporary-borrow-scope-exit`).
(define tc-call-temporary-borrow-typed : bool
  false)

(defmacro (tc-type-env-scoped-runtime-active? [env : Expr]) : Expr
  `(tc-type-env-scoped-state-field
    (tc-type-env-scoped-state ,env)
    runtime-active
    bool))

(defmacro (tc-type-env-scoped-runtime-current [env : Expr]) : Expr
  `(tc-type-env-scoped-state-carrier (tc-type-env-scoped-state ,env)))

(define (tc-type-env-scoped-carrier-lookup-index
  [carrier : (& carrier TcTypeEnvScopedCarrier)]
  [name-id : i64]) : i64
  (tc-type-env-scoped-stack-lookup-index carrier.sidecar.stack name-id))

(define (tc-type-env-scoped-runtime-lookup-index
  [env : TcTypeEnv]
  [name-id : i64]) : i64
  (let
    [carrier (tc-type-env-scoped-runtime-current env)]
    (tc-type-env-scoped-carrier-lookup-index carrier name-id)))

(define (tc-type-env-scoped-runtime-slot-generation
  [env : TcTypeEnv]
  [index : i64]) : i64
  (let
    [carrier : TcTypeEnvScopedCarrier (tc-type-env-scoped-runtime-current env)]
    (if (and (>= index 0) (< index carrier.sidecar.stack.slot-count))
      (array-ref carrier.sidecar.stack.slots index).generation
      -1)))

(define (tc-type-env-scoped-runtime-lookup-epoch [env : TcTypeEnv]) : i64
  (let
    [carrier : TcTypeEnvScopedCarrier (tc-type-env-scoped-runtime-current env)]
    carrier.sidecar.stack.lookup-epoch))

(define (tc-type-env-scoped-runtime-save [env : TcTypeEnv]) : TcTypeEnvScopedRuntimeSave
  (let
    [state : TcTypeEnvScopedState (tc-type-env-scoped-state env)]
    (if (tc-type-env-scoped-state-active? state)
      (Scope
        state
        (tc-type-env-scoped-carrier-snapshot-mark
          (tc-type-env-scoped-state-carrier state)))
      (Inactive state))))

(define (tc-type-env-scoped-runtime-suspend! [env : TcTypeEnv]) : TcTypeEnvScopedRuntimeSave
  (let
    [saved : TcTypeEnvScopedRuntimeSave (tc-type-env-scoped-runtime-save env)]
    (tc-type-env-scoped-state-set-active! (tc-type-env-scoped-state env) false)
    saved))

(define (tc-type-env-scoped-runtime-restore!
  [saved : TcTypeEnvScopedRuntimeSave]) : unit
  (match saved
    [(Inactive state)
      (tc-type-env-scoped-cache-clear! state)
      (tc-type-env-scoped-state-set-active! state false)]
    [(Scope state mark)
      (tc-type-env-scoped-state-carrier-set!
        state
        (tc-type-env-scoped-carrier-restore
          (tc-type-env-scoped-state-carrier state)
          mark))
      (tc-type-env-scoped-state-set-active! state true)]
    [(Replaced state carrier)
      (tc-type-env-scoped-cache-clear! state)
      (tc-type-env-scoped-state-carrier-set! state carrier)
      (tc-type-env-scoped-state-set-active! state true)]))

(define (tc-type-env-scoped-runtime-enter! [carrier : TcTypeEnvScopedCarrier]) : TcTypeEnvScopedRuntimeSave
  (let
    [state : TcTypeEnvScopedState
      (tc-type-env-scoped-carrier-state (tc-global-shared-view carrier))]
    [saved : TcTypeEnvScopedRuntimeSave
      (if (tc-type-env-scoped-state-active? state)
        (Replaced state (tc-type-env-scoped-state-carrier state))
        (Inactive state))]
    (tc-type-env-scoped-cache-clear! state)
    (tc-type-env-scoped-state-carrier-set! state carrier)
    (tc-type-env-scoped-state-set-active! state true)
    saved))

(define (tc-type-env-scoped-runtime-slot-flags
  [marker-kind : TcTypeEnvScopedMarkerKind]) : i64
  (if (tc-type-env-scoped-marker-kind-same? marker-kind None)
    0
    tc-type-env-scoped-flag-marker))

(define (tc-type-env-scoped-runtime-note-bind-id!
  [next-env : TcTypeEnv]
  [name-id : i64]
  [ty : ast.AstType]
  [_rest-env : TcTypeEnv]) : unit
  (let
    [state : TcTypeEnvScopedState (tc-type-env-scoped-state next-env)]
    [carrier : TcTypeEnvScopedCarrier (tc-type-env-scoped-state-carrier state)]
    (tc-type-env-scoped-stack-push-slot!
      (&mut (__tl-project-field (__tl-project-field carrier sidecar) stack))
      name-id
      ty
      0
      None)
    (tc-semantic-observe-binding! (& carrier.sidecar.stack))
    (tc-semantic-observe-binding-transfer!
      (& carrier.sidecar.stack)
      (- carrier.sidecar.stack.slot-count 1)
      next-env
      false)
    (set! carrier.dirty true)
    (tc-type-env-scoped-state-carrier-set! state carrier)))

(define (tc-type-env-scoped-stack-mark-latest-flags-id!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [name-id : i64]
  [flags : i64]) : unit
  (let
    [index : i64 (- stack.slot-count 1)]
    (if (and
      (>= index 0)
      (= (__tl-project-field (array-ref stack.slots index) name-id) name-id))
      (let
        [slot : TcTypeEnvScopedSlot (clone (array-ref stack.slots index))]
        (set!
          (array-ref stack.slots index)
          (TcTypeEnvScopedSlot
            slot.name-id
            slot.ty
            (bit-or slot.flags flags)
            slot.marker-kind-tag
            slot.scope-depth
            slot.generation)))
      unit)))

(define (tc-type-env-scoped-runtime-mark-latest-flags-id!
  [env : TcTypeEnv]
  [name-id : i64]
  [flags : i64]) : unit
  (let
    [state : TcTypeEnvScopedState (tc-type-env-scoped-state env)]
    [carrier : TcTypeEnvScopedCarrier (tc-type-env-scoped-state-carrier state)]
    (tc-type-env-scoped-stack-mark-latest-flags-id!
      (&mut (__tl-project-field (__tl-project-field carrier sidecar) stack))
      name-id
      flags)
    (tc-type-env-scoped-state-carrier-set! state carrier)))

(define (tc-type-env-scoped-stack-mark-latest-marker-id!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [name-id : i64]
  [marker-kind : TcTypeEnvScopedMarkerKind]) : unit
  (let
    [index : i64 (- stack.slot-count 1)]
    (if (and
      (>= index 0)
      (= (__tl-project-field (array-ref stack.slots index) name-id) name-id))
      (let
        [slot : TcTypeEnvScopedSlot (clone (array-ref stack.slots index))]
        (set!
          (array-ref stack.slots index)
          (TcTypeEnvScopedSlot
            slot.name-id
            slot.ty
            (bit-or
              slot.flags
              (tc-type-env-scoped-runtime-slot-flags marker-kind))
            (tc-type-env-scoped-marker-kind-tag marker-kind)
            slot.scope-depth
            slot.generation)))
      unit)))

(define (tc-type-env-scoped-runtime-mark-latest-marker-id!
  [env : TcTypeEnv]
  [name-id : i64]
  [marker-kind : TcTypeEnvScopedMarkerKind]) : unit
  (let
    [state : TcTypeEnvScopedState (tc-type-env-scoped-state env)]
    [carrier : TcTypeEnvScopedCarrier (tc-type-env-scoped-state-carrier state)]
    (tc-type-env-scoped-stack-mark-latest-marker-id!
      (&mut (__tl-project-field (__tl-project-field carrier sidecar) stack))
      name-id
      marker-kind)
    (tc-type-env-scoped-state-carrier-set! state carrier)))

(define (tc-type-env-scoped-runtime-enter-env! [env : TcTypeEnv]) : TcTypeEnvScopedRuntimeSave
  (if (tc-type-env-scoped-runtime-active? env)
    (tc-type-env-scoped-runtime-save env)
    (tc-type-env-scoped-runtime-enter!
      (tc-type-env-scoped-carrier-from-env env))))

(define (tc-bind-runtime-marker-id
  [env : TcTypeEnv]
  [name-id : i64]
  [ty : ast.AstType]
  [marker-kind : TcTypeEnvScopedMarkerKind]) : TcTypeEnv
  (let
    [next-env : TcTypeEnv (tc-bind-id env name-id ty)]
    (if (tc-type-env-scoped-runtime-active? next-env)
      (tc-type-env-scoped-runtime-mark-latest-marker-id!
        next-env
        name-id
        marker-kind)
      unit)
    next-env))

;; `name-id` is the lookup key already selected by the caller. Module/import
;; bindings use structural keys, while local bindings use raw interner ids.
;; Do not normalize it with `tc-env-name-key-id` here: a qualified raw id and
;; its structural key are distinct storage domains, and the marker is stored
;; beside the value under the selected domain.
(define (tc-binding-unsafe-marker-head-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (let
    [head : i64 env.head]
    (if (>= head 0)
      (let
        [binding-ptr : (Ptr TcTypeEnvBinding)
          (tc-type-env-binding-ptr env.store head)]
        (tc-unsafe-decl-marker-key-id?
          (tc-type-env-binding-name-at binding-ptr)
          name-id))
      false)))

(define (tc-binding-unsafe-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    (cond
      [(= head -1) false]
      [(< head -1)
        (let
          [node-addr : i64 (tc-type-env-cache-index head)]
          (if (>= (tc-chain-node-depth node-addr) 0)
            (let
              [ref : i64 (tc-chain-resolve store-handle node-addr name-id)]
              (if (>= ref 0)
                (=
                  (array-ref
                    (__tl-project-field
                      (tc-chain-ref-cache store-handle ref)
                      unsafe-flags)
                    (tc-chain-ref-slot ref))
                  1)
                false))
            (let
              [cache : TcTypeEnvCache
                (tc-type-env-cache-at
                  (tc-type-env-cache-ptr store-handle node-addr))]
              [ids : tc_i64_i64_map.Map cache.ids]
              [index : i64 (tc_i64_i64_map.get-value-or (& ids) name-id -1)]
              (if (>= index 0)
                (= (array-ref cache.unsafe-flags index) 1)
                (if cache.partial
                  (tc-binding-unsafe-id?
                    (TcTypeEnv store-handle cache.below env.abi-pad)
                    name-id)
                  false)))))]
      [else
        (let
          [binding-ptr : (Ptr TcTypeEnvBinding)
            (tc-type-env-binding-ptr store-handle head)]
          [rest : TcTypeEnv
            (TcTypeEnv
              store-handle
              (tc-type-env-binding-parent-at binding-ptr)
              env.abi-pad)]
          (if (= (tc-type-env-binding-name-at binding-ptr) name-id)
            (tc-binding-unsafe-marker-head-id? rest name-id)
            (tc-binding-unsafe-id? rest name-id)))])))

(define (tc-env-cache-count [env : TcTypeEnv]) : i64
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    [count : i64 0]
    [done : bool false]
    (while (not done)
      (cond
        [(= head -1) (set! done true)]
        [(>= head 0)
          (let
            [binding-ptr : (Ptr TcTypeEnvBinding)
              (tc-type-env-binding-ptr store-handle head)]
            (set! count (+ count 1))
            (set! head (tc-type-env-binding-parent-at binding-ptr)))]
        [else
          (let
            [cache : TcTypeEnvCache
              (tc-type-env-cache-at
                (tc-type-env-cache-ptr
                  store-handle
                  (tc-type-env-cache-index head)))]
            (set! head cache.rest))]))
    count))

(define (tc-env-cache-count-prefix [env : TcTypeEnv] [remaining : i64]) : i64
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    [left : i64 remaining]
    [count : i64 0]
    (while (and (> left 0) (>= head 0))
      (let
        [binding-ptr : (Ptr TcTypeEnvBinding)
          (tc-type-env-binding-ptr store-handle head)]
        (set! count (+ count 1))
        (set! left (- left 1))
        (set! head (tc-type-env-binding-parent-at binding-ptr))))
    count))

(define (tc-env-cache-capacity [count : i64]) : i64
  (if (< count 5)
    16
    (* count 2)))

(define tc-env-cache-flag-default-shadow : i64
  1)
(define tc-env-cache-flag-cleanup-owner : i64
  2)
(define tc-env-cache-flag-ordinary-arena-owner : i64
  4)
(define tc-env-cache-flag-atomic-arena-owner : i64
  8)
(define tc-env-cache-flag-signature-lifetime : i64
  16)
(define tc-env-cache-sidecar-position-scale : i64
  32)

;; Environment name IDs are non-negative.  Negative derived keys let the
;; existing relevance map index marker-owned lifetime spellings without
;; colliding with ordinary bindings or allocating a second map per cache.
(define (tc-env-cache-lifetime-marker-key [lifetime-id : i64]) : i64
  (- -2 (* lifetime-id 2)))

(define (tc-env-cache-arena-lifetime-marker-key [owner-id : i64]) : i64
  (- -3 (* owner-id 2)))

(define (tc-env-cache-lifetime-marker-lifetime-id
  [name-id : i64]
  [ty : ast.AstType]
  [signature-marker-id : i64]
  [region-marker-id : i64]
  [ordinary-arena-marker-id : i64]
  [atomic-arena-marker-id : i64]) : i64
  (if (or
    (= name-id signature-marker-id)
    (= name-id region-marker-id)
    (= name-id ordinary-arena-marker-id)
    (= name-id atomic-arena-marker-id))
    (match ty
      [(Var lifetime-id) lifetime-id]
      [_ -1])
    -1))

(define (tc-env-cache-binding-sidecar-flags
  [rest-env : TcTypeEnv]
  [name-id : i64]
  [default-shadow : bool]
  [cleanup-marker-id : i64]
  [ordinary-arena-marker-id : i64]
  [atomic-arena-marker-id : i64]) : i64
  (let
    [base : i64
      (if default-shadow
        tc-env-cache-flag-default-shadow
        0)]
    [head : i64 rest-env.head]
    (if (>= head 0)
      (let
        [binding-ptr : (Ptr TcTypeEnvBinding)
          (tc-type-env-binding-ptr rest-env.store head)]
        [marker-id : i64 (tc-type-env-binding-name-at binding-ptr)]
        [marker-ty : ast.AstType (tc-type-env-binding-type-at binding-ptr)]
        [marker-flag : i64
          (cond
            [(= marker-id cleanup-marker-id) tc-env-cache-flag-cleanup-owner]
            [(= marker-id ordinary-arena-marker-id)
              tc-env-cache-flag-ordinary-arena-owner]
            [(= marker-id atomic-arena-marker-id)
              tc-env-cache-flag-atomic-arena-owner]
            [else 0])]
        (if (= marker-flag 0)
          base
          (match marker-ty
            [(Var owner)
              (if (= owner name-id)
                (+ base marker-flag)
                base)]
            [_ base])))
      base)))

(define (tc-env-cache-owner-marker-head-id?
  [env : TcTypeEnv]
  [name-id : i64]
  [marker-id : i64]) : bool
  (let
    [head : i64 env.head]
    (if (>= head 0)
      (let
        [binding-ptr : (Ptr TcTypeEnvBinding)
          (tc-type-env-binding-ptr env.store head)]
        (if (= (tc-type-env-binding-name-at binding-ptr) marker-id)
          (match (tc-type-env-binding-type-at binding-ptr)
            [(Var owner) (= owner name-id)]
            [_ false])
          false))
      false)))

;; Cache construction is the dominant i64 map workload of a self-compile, so
;; it walks the spine once per compaction and builds no second whole-env map
;; to answer "is this default builtin shadowed?". Default-shadow membership is
;; a per-entry flag array parallel to `values`/`unsafe-flags`, computed during
;; the single entry fill walk: an entry's low bit is set when its head-most
;; binding sits above the first default-boundary marker. Head-first walk order
;; means a name bound both above and below the boundary keeps its head-most
;; (above) occurrence, so the bit is set exactly when any occurrence is above.
(define (tc-env-cache-add!
  [ids : (&mut ids tc_i64_i64_map.Map)]
  [values : (&mut values (__tl_dyn-array ast.AstType))]
  [unsafe-flags : (&mut unsafe-flags (__tl_dyn-array i64))]
  [shadow-flags : (&mut shadow-flags (__tl_dyn-array i64))]
  [name-id : i64]
  [next : i64]
  [ty : ast.AstType]
  [unsafe : bool]
  [sidecar-flags : i64]
  [position : i64]) : bool
  (if (tc_i64_i64_map.insert-if-absent-ref! ids name-id next)
    (begin
      (cfg compile-profile (counters.bump! tc-profile-env-cache-entries))
      (set! (array-ref values next) ty)
      (set!
        (array-ref unsafe-flags next)
        (if unsafe
          1
          0))
      (set!
        (array-ref shadow-flags next)
        (+ sidecar-flags (* position tc-env-cache-sidecar-position-scale)))
      true)
    false))

(define (tc-env-cache-add-lifetime-marker!
  [ids : (&mut ids tc_i64_i64_map.Map)]
  [values : (&mut values (__tl_dyn-array ast.AstType))]
  [unsafe-flags : (&mut unsafe-flags (__tl_dyn-array i64))]
  [shadow-flags : (&mut shadow-flags (__tl_dyn-array i64))]
  [lifetime-id : i64]
  [next : i64]
  [ty : ast.AstType]
  [signature : bool]
  [arena-owner : bool]
  [position : i64]) : bool
  (if (< lifetime-id 0)
    false
    (let
      [general-added : bool
        (tc_i64_i64_map.insert-if-absent-ref!
          ids
          (tc-env-cache-lifetime-marker-key lifetime-id)
          next)]
      [arena-added : bool
        (if arena-owner
          (tc_i64_i64_map.insert-if-absent-ref!
            ids
            (tc-env-cache-arena-lifetime-marker-key lifetime-id)
            next)
          false)]
      (if (or general-added arena-added)
        (begin
          (set! (array-ref values next) ty)
          (set! (array-ref unsafe-flags next) 0)
          (set!
            (array-ref shadow-flags next)
            (+
              (if signature
                tc-env-cache-flag-signature-lifetime
                0)
              (* position tc-env-cache-sidecar-position-scale)))
          true)
        false))))

(define (tc-env-cache-fill
  [env : TcTypeEnv]
  [ids : tc_i64_i64_map.Map]
  [values : (&mut values (__tl_dyn-array ast.AstType))]
  [track-resolution : bool]
  [unsafe-flags : (&mut unsafe-flags (__tl_dyn-array i64))]
  [shadow-flags : (&mut shadow-flags (__tl_dyn-array i64))]
  [above-boundary : bool]) : tc_i64_i64_map.Map
  (let
    [store-handle : i64 env.store]
    [resolution-state : TcTypeResolutionCacheState
      (tc-type-env-type-resolution-cache-state env)]
    [_resolution-owner : unit
      (if track-resolution
        (tc-type-resolution-cache-ensure-bound-for-state! resolution-state)
        unit)]
    [head : i64 env.head]
    [cur-ids : tc_i64_i64_map.Map ids]
    [next : i64 0]
    [resolution-next : i64 0]
    [position : i64 0]
    [signature-marker-id : i64 (tc-signature-lifetime-marker-id)]
    [region-marker-id : i64 (tc-region-marker-id)]
    [cleanup-marker-id : i64 (tc-cleanup-owner-marker-id)]
    [ordinary-arena-marker-id : i64 (tc-ordinary-arena-owner-marker-id)]
    [atomic-arena-marker-id : i64 (tc-atomic-arena-owner-marker-id)]
    [cur-above-boundary : bool above-boundary]
    [done : bool false]
    (while (not done)
      (cond
        [(= head -1) (set! done true)]
        [(>= head 0)
          (let
            [binding-ptr : (Ptr TcTypeEnvBinding)
              (tc-type-env-binding-ptr store-handle head)]
            [name-id : i64 (tc-type-env-binding-name-at binding-ptr)]
            [ty : ast.AstType (tc-type-env-binding-type-at binding-ptr)]
            [rest-env : TcTypeEnv
              (TcTypeEnv
                store-handle
                (tc-type-env-binding-parent-at binding-ptr)
                env.abi-pad)]
            ;; The boundary bind itself and everything below it are not
            ;; default shadows.
            [still-above : bool
              (if cur-above-boundary
                (not (= name-id (tc-default-boundary-id)))
                false)]
            (when
              (tc-env-cache-add!
                (&mut cur-ids)
                values
                unsafe-flags
                shadow-flags
                name-id
                next
                (tc-global-shared-view ty)
                (tc-binding-unsafe-marker-head-id? rest-env name-id)
                (tc-env-cache-binding-sidecar-flags
                  rest-env
                  name-id
                  still-above
                  cleanup-marker-id
                  ordinary-arena-marker-id
                  atomic-arena-marker-id)
                position)
              (when
                (and
                  track-resolution
                  (tc-type-needs-resolution-for-state?
                    resolution-state
                    (tc-global-shared-view ty)))
                (set!
                  (array-ref
                    unsafe-flags
                    (+ (array-length values) 1 resolution-next))
                  name-id)
                (set! resolution-next (+ resolution-next 1)))
              (set! next (+ next 1)))
            (let
              [marker-lifetime-id : i64
                (tc-env-cache-lifetime-marker-lifetime-id
                  name-id
                  (tc-global-shared-view ty)
                  signature-marker-id
                  region-marker-id
                  ordinary-arena-marker-id
                  atomic-arena-marker-id)]
              (if (tc-env-cache-add-lifetime-marker!
                (&mut cur-ids)
                values
                unsafe-flags
                shadow-flags
                marker-lifetime-id
                next
                ty
                (= name-id signature-marker-id)
                (or
                  (= name-id ordinary-arena-marker-id)
                  (= name-id atomic-arena-marker-id))
                position)
                (set! next (+ next 1))
                unit))
            (set! head rest-env.head)
            (set! position (+ position 1))
            (set! cur-above-boundary still-above))]
        [else
          (let
            [cache : TcTypeEnvCache
              (tc-type-env-cache-at
                (tc-type-env-cache-ptr
                  store-handle
                  (tc-type-env-cache-index head)))]
            (set! head cache.rest))]))
    ;; The final slot is a construction-only handoff to the cache node. It
    ;; avoids a second result aggregate around the consuming map.
    (if track-resolution
      (set! (array-ref unsafe-flags (array-length values)) resolution-next)
      unit)
    cur-ids))

(define (tc-env-cache-fill-prefix
  [env : TcTypeEnv]
  [remaining : i64]
  [ids : tc_i64_i64_map.Map]
  [values : (&mut values (__tl_dyn-array ast.AstType))]
  [track-resolution : bool]
  [unsafe-flags : (&mut unsafe-flags (__tl_dyn-array i64))]
  [shadow-flags : (&mut shadow-flags (__tl_dyn-array i64))]
  [above-boundary : bool]) : tc_i64_i64_map.Map
  (let
    [store-handle : i64 env.store]
    [resolution-state : TcTypeResolutionCacheState
      (tc-type-env-type-resolution-cache-state env)]
    [_resolution-owner : unit
      (if track-resolution
        (tc-type-resolution-cache-ensure-bound-for-state! resolution-state)
        unit)]
    [head : i64 env.head]
    [left : i64 remaining]
    [cur-ids : tc_i64_i64_map.Map ids]
    [next : i64 0]
    [resolution-next : i64 0]
    [position : i64 0]
    [signature-marker-id : i64 (tc-signature-lifetime-marker-id)]
    [region-marker-id : i64 (tc-region-marker-id)]
    [cleanup-marker-id : i64 (tc-cleanup-owner-marker-id)]
    [ordinary-arena-marker-id : i64 (tc-ordinary-arena-owner-marker-id)]
    [atomic-arena-marker-id : i64 (tc-atomic-arena-owner-marker-id)]
    [cur-above-boundary : bool above-boundary]
    [done : bool false]
    (while (and (not done) (> left 0))
      (cond
        [(>= head 0)
          (let
            [binding-ptr : (Ptr TcTypeEnvBinding)
              (tc-type-env-binding-ptr store-handle head)]
            [name-id : i64 (tc-type-env-binding-name-at binding-ptr)]
            [ty : ast.AstType (tc-type-env-binding-type-at binding-ptr)]
            [rest-env : TcTypeEnv
              (TcTypeEnv
                store-handle
                (tc-type-env-binding-parent-at binding-ptr)
                env.abi-pad)]
            [still-above : bool
              (if cur-above-boundary
                (not (= name-id (tc-default-boundary-id)))
                false)]
            (when
              (tc-env-cache-add!
                (&mut cur-ids)
                values
                unsafe-flags
                shadow-flags
                name-id
                next
                (tc-global-shared-view ty)
                (tc-binding-unsafe-marker-head-id? rest-env name-id)
                (tc-env-cache-binding-sidecar-flags
                  rest-env
                  name-id
                  still-above
                  cleanup-marker-id
                  ordinary-arena-marker-id
                  atomic-arena-marker-id)
                position)
              (when
                (and
                  track-resolution
                  (tc-type-needs-resolution-for-state?
                    resolution-state
                    (tc-global-shared-view ty)))
                (set!
                  (array-ref
                    unsafe-flags
                    (+ (array-length values) 1 resolution-next))
                  name-id)
                (set! resolution-next (+ resolution-next 1)))
              (set! next (+ next 1)))
            (let
              [marker-lifetime-id : i64
                (tc-env-cache-lifetime-marker-lifetime-id
                  name-id
                  (tc-global-shared-view ty)
                  signature-marker-id
                  region-marker-id
                  ordinary-arena-marker-id
                  atomic-arena-marker-id)]
              (if (tc-env-cache-add-lifetime-marker!
                (&mut cur-ids)
                values
                unsafe-flags
                shadow-flags
                marker-lifetime-id
                next
                ty
                (= name-id signature-marker-id)
                (or
                  (= name-id ordinary-arena-marker-id)
                  (= name-id atomic-arena-marker-id))
                position)
                (set! next (+ next 1))
                unit))
            (set! left (- left 1))
            (set! head rest-env.head)
            (set! position (+ position 1))
            (set! cur-above-boundary still-above))]
        [(< head -1)
          (let
            [cache : TcTypeEnvCache
              (tc-type-env-cache-at
                (tc-type-env-cache-ptr
                  store-handle
                  (tc-type-env-cache-index head)))]
            (if (and cache.scan-through cache.partial)
              ;; The cache's `rest` starts at the first bind it covers. Walk
              ;; that layer, then the next partial layer, but stop before an
              ;; explicit/global cache; `left` is the exact covered-bind sum.
              (set! head cache.rest)
              (set! done true)))]
        [else (set! done true)]))
    (if track-resolution
      (set! (array-ref unsafe-flags (array-length values)) resolution-next)
      unit)
    cur-ids))

;; --- structural index over the explicit top-env layer forest -----------------
;;
;; `tc-env-with-cache-layer-over-explicit` pushes one explicit layer per module
;; extension / additive splice, each layer's `below` being the layer
;; it extends. A self-compile builds hundreds of such layers, and because
;; splices and module extensions re-extend older base snapshots the result is
;; a deep FOREST, not a stack. Every layer is a correct non-membership filter,
;; so without the index lookups fall through them one map probe at a time,
;; most of them many layers deep.
;;
;; The index replaces that per-layer fall-through with one probe. Per store it
;; keeps a single map from binding key to the packed reference of the NEWEST
;; layer that binds it; each layer carries a `chain-prev` array parallel to its
;; `values`, threading the older versions of the same key in strictly
;; decreasing `seq`. A lookup starting at layer S takes the first version whose
;; layer is an ancestor-or-self of S, which is exactly the layer the `below`
;; walk would have stopped at:
;;
;;   * a version's layer is visited by the walk from S iff it is an
;;     ancestor-or-self of S (the walk follows `below` and stops at the root);
;;   * `seq` strictly increases along any root-to-node path, so among the
;;     ancestors of S greater `seq` means greater depth means closer to S, and
;;     the decreasing-`seq` version list therefore hands back the top-most
;;     binding first;
;;   * `seq` greater than S's own `seq` proves non-ancestry without any test.
;;
;; No value is ever copied into the index: a reference is (layer node address,
;; slot), and every payload read goes to that layer's live arrays. This is what
;; keeps `tc-top-env-reresolve-cache-node!` (issue #5493) sound -- it rewrites
;; `values` in place and never touches `ids`, so a re-resolved signature is
;; observed identically through the index and through the walk. The index is
;; append-only and is extended only where a layer is created, so nothing has to
;; be invalidated.
(define tc-chain-empty-i64-array : (__tl_dyn-array i64)
  (__tl_make-array i64 0))

;; A reference packs the layer node address (8-byte aligned, so the low three
;; bits are free) above an 18-bit slot. Layers wider than the slot field, or
;; sitting above the addressable range, are left unindexed and keep the walk.
(define (tc-chain-ref-slot-limit) : i64
  262144)

(define (tc-chain-ref-addr-limit) : i64
  140737488355328)

(define (tc-chain-ref-pack [addr : i64] [slot : i64]) : i64
  (bit-or (shl (shr addr 3) 18) slot))

(define (tc-chain-ref-addr [ref : i64]) : i64
  (shl (shr ref 18) 3))

(define (tc-chain-ref-slot [ref : i64]) : i64
  (bit-and ref 262143))

;; Word offsets 0..3 of TcTypeEnvCache. The four chain fields lead the record
;; and are one word each, so the version walk and the ancestor test read them
;; without materializing the whole cache.
(defmacro (tc-chain-node-depth [addr : comptime.Expr]) : comptime.Expr
  `(unsafe
    (ptr-read (int->ptr (cast ,addr : u64) : (Ptr i64)))))

(defmacro (tc-chain-node-seq [addr : comptime.Expr]) : comptime.Expr
  `(unsafe
    (ptr-read (ptr-offset (int->ptr (cast ,addr : u64) : (Ptr i64)) 1))))

(defmacro (tc-chain-node-array-address
  [addr : comptime.Expr]
  [word-offset : comptime.Expr]) : comptime.Expr
  `(unsafe
    (ptr-read
      (ptr-offset (int->ptr (cast ,addr : u64) : (Ptr u64)) ,word-offset))))

(define (tc-chain-array-length [array-address : u64]) : i64
  (unsafe
    (ptr-read (ptr-offset (int->ptr array-address : (Ptr i64)) 1))))

(define (tc-chain-array-ref [array-address : u64] [index : i64]) : i64
  (let
    [data-address : u64
      (unsafe
        (ptr-read (int->ptr array-address : (Ptr u64))))]
    (unsafe
      (ptr-read (ptr-offset (int->ptr data-address : (Ptr i64)) index)))))

(define (tc-chain-node-set-fields!
  [addr : i64]
  [depth : i64]
  [seq : i64]
  [jumps-address : u64]
  [prev-address : u64]) : unit
  (let
    [words : (MutPtr i64)
      (unsafe
        (int->ptr (cast addr : u64) : (MutPtr i64)))]
    (unsafe
      (ptr-write! (ptr-offset words 1) seq))
    (unsafe
      (ptr-write! (ptr-cast (ptr-offset words 2) : (MutPtr u64)) jumps-address))
    (unsafe
      (ptr-write! (ptr-cast (ptr-offset words 3) : (MutPtr u64)) prev-address))
    ;; Depth last: it is the published "this layer is indexed" flag, and the
    ;; three fields above must be visible before any walker reads it.
    (unsafe
      (ptr-write! words depth))))

(define (tc-chain-store-owner [store-handle : i64]) : i64
  (unsafe
    (ptr-read (ptr-offset (int->ptr (cast store-handle : u64) : (Ptr i64)) 6))))

(define (tc-chain-state-address [store-handle : i64]) : i64
  (unsafe
    (ptr-read (ptr-offset (int->ptr (cast store-handle : u64) : (Ptr i64)) 8))))

(define (tc-chain-state-set! [store-handle : i64] [addr : i64]) : unit
  (unsafe
    (ptr-write!
      (ptr-offset (int->ptr (cast store-handle : u64) : (MutPtr i64)) 8)
      addr)))

(define (tc-chain-state-read [addr : i64]) : TcChainIndex
  (unsafe
    (ptr-read (int->ptr (cast addr : u64) : (Ptr TcChainIndex)))))

(define (tc-chain-state-write! [addr : i64] [state : TcChainIndex]) : unit
  (unsafe
    (ptr-write! (int->ptr (cast addr : u64) : (MutPtr TcChainIndex)) state)))

;; The index cell and everything it points at live in the store's owner arena,
;; exactly like the cache nodes whose addresses it records. A function-local
;; store inherits its parent's index read-only; before its first write the
;; index is copied into the local owner, so the parent's map never names a
;; local layer.
(define (tc-chain-state-ensure! [store-handle : i64]) : i64
  (let
    [existing : i64 (tc-chain-state-address store-handle)]
    [owner : i64 (tc-chain-store-owner store-handle)]
    (if (and
      (> existing 0)
      (= (__tl-project-field (tc-chain-state-read existing) owner-arena) owner))
      existing
      (let
        [parent-len : i64
          (if (> existing 0)
            (let
              [parent : TcChainIndex (tc-chain-state-read existing)]
              (tc_i64_i64_map.len (& parent.map)))
            0)]
        [cell : i64
          (in-arena
            (arena.Arena owner)
            (let
              [slots : (__tl_dyn-array TcChainIndex)
                (__tl_make-array TcChainIndex 1)]
              (set!
                (array-ref slots 0)
                (TcChainIndex
                  (if (> parent-len 0)
                    (let
                      [parent : TcChainIndex (tc-chain-state-read existing)]
                      (tc-moved-clone-id-map (& parent.map)))
                    (tc_i64_i64_map.with-capacity 1024))
                  (if (> existing 0)
                    (__tl-project-field (tc-chain-state-read existing) next-seq)
                    0)
                  owner))
              (unsafe
                (cast
                  (ptr->int (ptr-cast (__tl_array-data slots) : (Ptr u8)))
                  : i64))))]
        (tc-chain-state-set! store-handle cell)
        cell))))

(define (tc-chain-jump-levels [depth : i64]) : i64
  (if (< depth 1)
    0
    (let
      [levels : i64 1]
      [span : i64 2]
      (while (<= span depth)
        (set! levels (+ levels 1))
        (set! span (* span 2)))
      levels)))

(define (tc-chain-jump-at [addr : i64] [k : i64]) : i64
  (if (= addr 0)
    0
    (let
      [jumps-address : u64 (tc-chain-node-array-address addr 2)]
      (if (< k (tc-chain-array-length jumps-address))
        (tc-chain-array-ref jumps-address k)
        0))))

;; True when `x-addr` is `s-addr` or one of its `below` ancestors. Lifts S by
;; the depth difference through the binary-lifting table; entry k is only read
;; when bit k of the remaining difference is set, and the remaining difference
;; never exceeds the current node's depth, so the entry always exists.
(define (tc-chain-ancestor? [x-addr : i64] [s-addr : i64] [s-depth : i64]) : bool
  (let
    [x-depth : i64 (tc-chain-node-depth x-addr)]
    (cond
      [(> x-depth s-depth) false]
      [(= x-depth s-depth) (= x-addr s-addr)]
      [else
        (let
          [cur : i64 s-addr]
          [delta : i64 (- s-depth x-depth)]
          [k : i64 0]
          (while (> delta 0)
            (if (= (bit-and delta 1) 1)
              (set! cur (tc-chain-jump-at cur k))
              unit)
            (set! delta (shr delta 1))
            (set! k (+ k 1)))
          (= cur x-addr))])))

;; Packed reference of the layer the plain `below` walk from the indexed layer
;; at `s-addr` would have stopped at for `key`, or -1 when no ancestor of that
;; layer binds it.
(define (tc-chain-resolve [store-handle : i64] [s-addr : i64] [key : i64]) : i64
  (let
    [state-addr : i64 (tc-chain-state-address store-handle)]
    (if (<= state-addr 0)
      -1
      (let
        [state : TcChainIndex (tc-chain-state-read state-addr)]
        [s-depth : i64 (tc-chain-node-depth s-addr)]
        [s-seq : i64 (tc-chain-node-seq s-addr)]
        [ref : i64 (tc_i64_i64_map.get-value-or (& state.map) key -1)]
        [answer : i64 -1]
        [done : bool false]
        (while (not done)
          (if (< ref 0)
            (set! done true)
            (let
              [addr : i64 (tc-chain-ref-addr ref)]
              (if (and
                (<= (tc-chain-node-seq addr) s-seq)
                (tc-chain-ancestor? addr s-addr s-depth))
                (begin
                  (set! answer ref)
                  (set! done true))
                (set!
                  ref
                  (-
                    (tc-chain-array-ref
                      (tc-chain-node-array-address addr 3)
                      (tc-chain-ref-slot ref))
                    2))))))
        answer))))

(define (tc-chain-ref-cache [store-handle : i64] [ref : i64]) : TcTypeEnvCache
  (tc-type-env-cache-at
    (tc-type-env-cache-ptr store-handle (tc-chain-ref-addr ref))))

;; Threads every key this layer binds onto its per-key version list. `ids`
;; already holds the head-most slot per key, so the traversal only has to
;; reproduce the covered-bind walk of `tc-env-cache-fill{,-prefix}` and take
;; the first occurrence of each slot (`chain-prev` still zero).
(define (tc-chain-register-layer!
  [store-handle : i64]
  [state-addr : i64]
  [node-addr : i64]
  [prev : (__tl_dyn-array i64)]
  [rest-head : i64]
  [count : i64]
  [full : bool]) : unit
  (let
    [cache : TcTypeEnvCache
      (tc-type-env-cache-at (tc-type-env-cache-ptr store-handle node-addr))]
    [ids : tc_i64_i64_map.Map cache.ids]
    [state : TcChainIndex (tc-chain-state-read state-addr)]
    [owner : i64 state.owner-arena]
    [head : i64 rest-head]
    [left : i64 count]
    [done : bool false]
    (while (not done)
      (cond
        [(= head -1) (set! done true)]
        [(and (not full) (<= left 0)) (set! done true)]
        [(>= head 0)
          (let
            [binding-ptr : (Ptr TcTypeEnvBinding)
              (tc-type-env-binding-ptr store-handle head)]
            [name-id : i64 (tc-type-env-binding-name-at binding-ptr)]
            [slot : i64 (tc_i64_i64_map.get-value-or (& ids) name-id -1)]
            (when
              (and
                (>= slot 0)
                (< slot (array-length prev))
                (= (array-ref prev slot) 0))
              (set!
                (array-ref prev slot)
                (+ (tc_i64_i64_map.get-value-or (& state.map) name-id -1) 2))
              (tc-cache-map-grow-in-owner! (&mut state.map) owner)
              (tc_i64_i64_map.insert-ref!
                (&mut state.map)
                name-id
                (tc-chain-ref-pack node-addr slot)))
            (set! head (tc-type-env-binding-parent-at binding-ptr))
            (set! left (- left 1)))]
        [else
          (set!
            head
            (__tl-project-field
              (tc-type-env-cache-at
                (tc-type-env-cache-ptr
                  store-handle
                  (tc-type-env-cache-index head)))
              rest))]))
    (tc-chain-state-write! state-addr state)))

;; Publishes a freshly pushed explicit (scan-through = false) layer into its
;; store's index. `below-head` is the layer this one extends for a partial
;; link, or -1 for a root, whose `partial = false` already terminates the walk.
(define (tc-chain-attach-layer!
  [store-handle : i64]
  [node-head : i64]
  [below-head : i64]
  [count : i64]
  [capacity : i64]
  [rest-head : i64]
  [full : bool]) : unit
  (let
    [node-addr : i64 (tc-type-env-cache-index node-head)]
    [below-addr : i64
      (if (< below-head -1)
        (tc-type-env-cache-index below-head)
        0)]
    [below-depth : i64
      (if (= below-addr 0)
        -1
        (tc-chain-node-depth below-addr))]
    [depth : i64
      (if full
        0
        (+ below-depth 1))]
    (if (or
      (>= count (tc-chain-ref-slot-limit))
      (>= capacity (tc-chain-ref-slot-limit))
      (>= node-addr (tc-chain-ref-addr-limit))
      (and (not full) (< below-depth 0)))
      unit
      (let
        [state-addr : i64 (tc-chain-state-ensure! store-handle)]
        [owner : i64 (tc-chain-store-owner store-handle)]
        [levels : i64 (tc-chain-jump-levels depth)]
        ;; The jump and version arrays are reached from the index by node
        ;; address, so they must live exactly as long as the node: allocate
        ;; them in the store's owner arena, not the ambient one.
        (in-arena
          (arena.Arena owner)
          (let
            [jumps : (__tl_dyn-array i64)
              (if (= levels 0)
                (tc-global-shared-view tc-chain-empty-i64-array)
                (__tl_make-array i64 levels))]
            [prev : (__tl_dyn-array i64) (__tl_make-array i64 capacity)]
            [jumps-address : u64 (tc-array-address jumps)]
            [prev-address : u64 (tc-array-address prev)]
            [seq : i64
              (let
                [state : TcChainIndex (tc-chain-state-read state-addr)]
                [next : i64 state.next-seq]
                (tc-chain-state-write!
                  state-addr
                  (TcChainIndex state.map (+ next 1) state.owner-arena))
                next)]
            (if (= levels 0)
              unit
              (let
                [k : i64 1]
                (set! (array-ref jumps 0) below-addr)
                (while (< k levels)
                  (set!
                    (array-ref jumps k)
                    (tc-chain-jump-at (array-ref jumps (- k 1)) (- k 1)))
                  (set! k (+ k 1)))))
            (tc-chain-node-set-fields!
              node-addr
              depth
              seq
              jumps-address
              prev-address)
            (tc-chain-register-layer!
              store-handle
              state-addr
              node-addr
              prev
              rest-head
              count
              full)))))))

(define (tc-env-with-cache-mode [env : TcTypeEnv] [scan-through : bool]) : TcTypeEnv
  (begin
    (cfg compile-profile (counters.bump! tc-profile-env-cache-builds))
    (let
      [count : i64 (tc-env-cache-count env)]
      [capacity : i64 (tc-env-cache-capacity count)]
      [values : (__tl_dyn-array ast.AstType)
        (__tl_make-array ast.AstType capacity)]
      [unsafe-flags : (__tl_dyn-array i64)
        (__tl_make-array
          i64
          (if scan-through
            capacity
            (+ (* capacity 2) 2)))]
      [shadow-flags : (__tl_dyn-array i64) (__tl_make-array i64 capacity)]
      [ids : tc_i64_i64_map.Map
        (tc-env-cache-fill
          env
          (tc_i64_i64_map.with-capacity capacity)
          (&mut values)
          (not scan-through)
          (&mut unsafe-flags)
          (&mut shadow-flags)
          true)]
      [node : TcTypeEnv
        (begin
          (set! (array-ref shadow-flags (- capacity 1)) count)
          (tc-type-env-cache-node
            env
            (TcTypeEnvCache
              -1
              -1
              0
              0
              ids
              values
              unsafe-flags
              shadow-flags
              scan-through
              false
              env.head
              env.head)))]
      (if scan-through
        unit
        (tc-chain-attach-layer!
          env.store
          node.head
          -1
          count
          capacity
          env.head
          true))
      node)))

(define (tc-env-with-partial-local-cache [env : TcTypeEnv]) : TcTypeEnv
  (tc-env-with-cache-prefix-layer
    env
    (tc-env-cache-count-prefix env (tc-local-cache-threshold))
    true
    (tc-env-after-prefix env (tc-local-cache-threshold))))

(define (tc-env-with-cache-prefix-layer
  [env : TcTypeEnv]
  [count : i64]
  [scan-through : bool]
  [below : TcTypeEnv]) : TcTypeEnv
  (begin
    (cfg compile-profile (counters.bump! tc-profile-env-cache-builds))
    (let
      [capacity : i64 (tc-env-cache-capacity count)]
      [values : (__tl_dyn-array ast.AstType)
        (__tl_make-array ast.AstType capacity)]
      [unsafe-flags : (__tl_dyn-array i64)
        (__tl_make-array
          i64
          (if scan-through
            capacity
            (+ (* capacity 2) 2)))]
      [shadow-flags : (__tl_dyn-array i64) (__tl_make-array i64 capacity)]
      [ids : tc_i64_i64_map.Map
        (tc-env-cache-fill-prefix
          env
          count
          (tc_i64_i64_map.with-capacity capacity)
          (&mut values)
          (not scan-through)
          (&mut unsafe-flags)
          (&mut shadow-flags)
          true)]
      [node : TcTypeEnv
        (begin
          (set! (array-ref shadow-flags (- capacity 1)) count)
          (tc-type-env-cache-node
            env
            (TcTypeEnvCache
              -1
              -1
              0
              0
              ids
              values
              unsafe-flags
              shadow-flags
              scan-through
              true
              env.head
              below.head)))]
      (if scan-through
        unit
        (tc-chain-attach-layer!
          env.store
          node.head
          below.head
          count
          capacity
          env.head
          false))
      node)))

(define (tc-env-with-cache-layer-over-explicit [env : TcTypeEnv]) : TcTypeEnv
  (let
    [prefix-count : i64 (tc-env-uncached-prefix-to-explicit-cache-count env)]
    (cond
      [(= prefix-count 0) env]
      [(> prefix-count 0)
        (tc-env-with-cache-prefix-layer
          env
          prefix-count
          false
          (tc-env-after-cache-expanded-prefix env prefix-count))]
      [else (tc-env-with-cache-mode env false)])))

;; Explicit top-env/module caches: marker scans terminate here.
(define (tc-env-with-cache [env : TcTypeEnv]) : TcTypeEnv
  (tc-env-with-cache-mode env false))

;; Collapse a deep stack of local windows into one wider partial cache. Lookup
;; misses jump directly to the existing explicit/global cache, while `rest`
;; keeps the original spine available to marker scans. This avoids rebuilding
;; tens of thousands of immutable top-level bindings for a few hundred locals.
(define (tc-env-with-collapsed-local-cache [env : TcTypeEnv]) : TcTypeEnv
  (let
    [threshold : i64 (tc-local-cache-threshold)]
    [layers : TcTypeEnv (tc-env-after-prefix env threshold)]
    [count : i64
      (+
        (tc-env-cache-count-prefix env threshold)
        (tc-env-partial-local-covered-count layers))]
    (tc-env-with-cache-prefix-layer
      env
      count
      true
      (tc-env-partial-local-base layers))))

;; Threshold-compaction caches inside function-body spines: partial lookup
;; cache for the newest bind window; marker scans keep scanning the full spine.
(define (tc-env-with-local-cache [env : TcTypeEnv]) : TcTypeEnv
  (tc-env-with-partial-local-cache env))

(define (tc-name-bound-id-with-top-env-membership?
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (let
    [state : TcTopEnvMembershipState (tc-type-env-topenv-membership-state env)]
    [active : bool (not (= (bit-and (tc-topenv-membership-mode state) 1) 0))]
    (cond
      [(and active (not (tc-topenv-membership-maybe? state name-id))) false]
      [(and active (tc-topenv-membership-bound? state name-id)) true]
      [else (tc-name-bound-id? env name-id)])))

(define (tc-bind-alias-id-if-free
  [env : TcTypeEnv]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnv
  (let
    [state : TcTopEnvMembershipState (tc-type-env-topenv-membership-state env)]
    [active : bool (not (= (bit-and (tc-topenv-membership-mode state) 1) 0))]
    (cond
      [(and active (not (tc-topenv-membership-maybe? state name-id)))
        ;; Provably unbound in the top-env spine: bind without the O(spine) scan.
        (tc-topenv-membership-mark-bound! state name-id)
        (tc-bind-id env name-id ty)]
      [(and active (tc-topenv-membership-bound? state name-id))
        ;; Provably bound by an earlier spine-joining bind this build: skip
        ;; without the O(spine) scan (the scan would find that binding).
        env]
      [(tc-name-bound-id? env name-id) env]
      [else
        (tc-topenv-membership-mark-bound! state name-id)
        (tc-bind-id env name-id ty)])))

(define (tc-module-name-id-by-id [module-id : i64] [name-id : i64]) : i64
  (csym.compiler-symbol-module-key-id-by-id module-id name-id))

(define (tc-module-name-id-by-id-for-session
  [session : cis.InternStructuralSessionHandle]
  [module-id : i64]
  [name-id : i64]) : i64
  (cond
    [(csym.compiler-symbol-root-module-id? module-id) name-id]
    [(and
        (ci.intern-renderable-id? name-id)
        (ci.intern-qualified? name-id)
        (= (ci.intern-qualified-module-id name-id) module-id))
      (let
        [qualified-module-id : i64 (ci.intern-qualified-module-id name-id)]
        [qualified-base-id : i64 (ci.intern-qualified-base-id name-id)]
        (if (csym.compiler-symbol-root-module-id? qualified-module-id)
          qualified-base-id
          (cis.intern-structural-key-raw
            (cis.intern-structural-session-composite-pair-key
              session
              qualified-module-id
              qualified-base-id))))]
    [else
      (match (cis.intern-structural-session-record-for-raw session name-id)
        [(Some record)
          (if (= record.kind (ci.intern-structural-kind-pair))
            (cis.intern-structural-key-raw
              (cis.intern-structural-session-composite-triple-key
                session
                module-id
                record.left-id
                record.right-id))
            (cis.intern-structural-key-raw
              (cis.intern-structural-session-composite-pair-key
                session
                module-id
                name-id)))]
        [(No)
          (cis.intern-structural-key-raw
            (cis.intern-structural-session-composite-pair-key
              session
              module-id
              name-id))])]))

(define (tc-env-key-has-name-id? [key : i64]) : bool
  (and
    (>= key 0)
    (< key (ci.intern-capacity))
    (or (< key (ci.intern-pool-len)) (ci.intern-generated-id-active? key))))

(define (tc-env-name-key-id
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : i64
  (cond
    [(and
        (tc-env-key-has-name-id? name-id)
        (ci.intern-qualified? name-id)
        (not (tc-hygiene-local-name-id? session name-id)))
      (csym.compiler-symbol-name-id-key name-id)]
    [(>= name-id (ci.intern-structural-key-base))
      ;; The table-backed branch is uncommon. Decode a possible macro global
      ;; once instead of classifying it and then reopening the same record for
      ;; its module and source-name lanes.
      (match (cis.intern-structural-session-macro-global-record-for-raw
        session
        name-id)
        [(Some record)
          (tc-module-name-id-by-id-for-session
            session
            record.definition-module-id
            record.source-name-id)]
        [(No) name-id])]
    [else name-id]))

(define tc-unqualified-import-owner-modules : sym_i64_env.SymI64Env
  (sym_i64_env.sym-i64-empty))
(define tc-unqualified-import-ambiguous-first-modules : sym_i64_env.SymI64Env
  (sym_i64_env.sym-i64-empty))
(define tc-unqualified-import-ambiguous-second-modules : sym_i64_env.SymI64Env
  (sym_i64_env.sym-i64-empty))
(define tc-unqualified-import-has-ambiguity : bool
  false)

(define (tc-unqualified-import-ambiguity-reset!) : unit
  (set! tc-unqualified-import-owner-modules (sym_i64_env.sym-i64-empty))
  (set!
    tc-unqualified-import-ambiguous-first-modules
    (sym_i64_env.sym-i64-empty))
  (set!
    tc-unqualified-import-ambiguous-second-modules
    (sym_i64_env.sym-i64-empty))
  (set! tc-unqualified-import-has-ambiguity false))

(define (tc-unqualified-import-key-id
  [importer-module-id : i64]
  [name-id : i64]) : i64
  (tc-module-name-id-by-id importer-module-id name-id))

(define (tc-unqualified-import-note-value!
  [_ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [name-id : i64]) : unit
  (if import-unqualified
    (let
      [key-id : i64 (tc-unqualified-import-key-id importer-module-id name-id)]
      [source-id : i64 source-module-id]
      [binding-id : i64 (tc-module-name-id-by-id alias-id name-id)]
      [owner-modules : sym_i64_env.SymI64Env
        tc-unqualified-import-owner-modules]
      [ambiguous-first-modules : sym_i64_env.SymI64Env
        tc-unqualified-import-ambiguous-first-modules]
      [ambiguous-second-modules : sym_i64_env.SymI64Env
        tc-unqualified-import-ambiguous-second-modules]
      [owner-id : i64
        (sym_i64_env.sym-i64-lookup-id-or
          owner-modules
          key-id
          (csym.compiler-symbols-missing-handle))]
      (if (csym.compiler-symbols-handle-found? owner-id)
        (if (= owner-id source-id)
          unit
          (unless
            (sym_i64_env.sym-i64-contains-id ambiguous-first-modules key-id)
            (set! tc-unqualified-import-has-ambiguity true)
            (set!
              tc-unqualified-import-ambiguous-first-modules
              (sym_i64_env.sym-i64-bind-id
                ambiguous-first-modules
                key-id
                owner-id))
            (set!
              tc-unqualified-import-ambiguous-second-modules
              (sym_i64_env.sym-i64-bind-id
                ambiguous-second-modules
                key-id
                source-id))))
        (if (tc-name-bound-id-with-top-env-membership? env binding-id)
          unit
          (set!
            tc-unqualified-import-owner-modules
            (sym_i64_env.sym-i64-bind-id owner-modules key-id source-id)))))
    unit))

(define (tc-bind-import-alias-value-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnv
  (tc-unqualified-import-note-value!
    ctx
    env
    alias-id
    importer-module-id
    source-module-id
    import-unqualified
    name-id)
  (tc-bind-id env (tc-module-name-id-by-id alias-id name-id) ty))

(define (tc-bind-import-alias-value-unsafe-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnv
  (tc-unqualified-import-note-value!
    ctx
    env
    alias-id
    importer-module-id
    source-module-id
    import-unqualified
    name-id)
  (tc-bind-unsafe-id env (tc-module-name-id-by-id alias-id name-id) ty))

(define (tc-struct-cleanup-function-type [struct-ty : ast.AstType]) : ast.AstType
  (tc-fn1 struct-ty (Unit)))

(define (tc-enum-cleanup-function-type [enum-ty : ast.AstType]) : ast.AstType
  (tc-fn1 enum-ty (Unit)))

(define (tc-bind-struct-cleanup-module-id
  [env : TcTypeEnv]
  [module-id : i64]
  [cleanup : ast.AstStructCleanup]
  [struct-ty : ast.AstType]) : TcTypeEnv
  (match cleanup
    [(No) env]
    [(Fn cleanup-name)
      (tc-bind-id
        env
        (tc-module-name-id-by-id
          module-id
          (ci.intern-syntax-id-value cleanup-name))
        (tc-struct-cleanup-function-type struct-ty))]))

(define (tc-bind-enum-cleanup-module-id
  [env : TcTypeEnv]
  [module-id : i64]
  [cleanup : ast.AstEnumCleanup]
  [enum-ty : ast.AstType]) : TcTypeEnv
  (match cleanup
    [(No) env]
    [(Fn cleanup-name)
      (tc-bind-id
        env
        (tc-module-name-id-by-id
          module-id
          (ci.intern-syntax-id-value cleanup-name))
        (tc-enum-cleanup-function-type enum-ty))]))

(define (tc-bind-struct-cleanup-import-alias
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [cleanup : ast.AstStructCleanup]
  [struct-ty : ast.AstType]) : TcTypeEnv
  (match cleanup
    [(No) env]
    [(Fn cleanup-name)
      (tc-bind-import-alias-value-id
        ctx
        env
        alias-id
        importer-module-id
        source-module-id
        import-unqualified
        (ci.intern-syntax-id-value cleanup-name)
        (tc-struct-cleanup-function-type struct-ty))]))

(define (tc-bind-enum-cleanup-import-alias
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [cleanup : ast.AstEnumCleanup]
  [enum-ty : ast.AstType]) : TcTypeEnv
  (match cleanup
    [(No) env]
    [(Fn cleanup-name)
      (tc-bind-import-alias-value-id
        ctx
        env
        alias-id
        importer-module-id
        source-module-id
        import-unqualified
        (ci.intern-syntax-id-value cleanup-name)
        (tc-enum-cleanup-function-type enum-ty))]))

(define (tc-default-boundary-id) : i64
  cbi.compiler-builtin-id-tc-default-boundary)

(define (tc-region-marker-id) : i64
  cbi.compiler-builtin-id-tc-active-region)

(define (tc-signature-lifetime-marker-id) : i64
  (let
    [generation : i64 (ci.intern-generation)]
    (if (= tc-signature-lifetime-marker-id-generation generation)
      tc-signature-lifetime-marker-id-cache
      (let
        [marker-id : i64 (ci.intern "\n__typelisp_signature_lifetime_marker")]
        (set! tc-signature-lifetime-marker-id-cache marker-id)
        (set! tc-signature-lifetime-marker-id-generation generation)
        marker-id))))

;; The lifetime of a temporary borrowed as a direct call argument (section
;; 3.10). It is not a source identifier, so no written lifetime can name it.
(define (tc-call-temporary-lifetime-id) : i64
  (let
    [generation : i64 (ci.intern-generation)]
    (if (= tc-call-temporary-lifetime-id-generation generation)
      tc-call-temporary-lifetime-id-cache
      (let
        [lifetime-id : i64 (ci.intern "<temporary>")]
        (set! tc-call-temporary-lifetime-id-cache lifetime-id)
        (set! tc-call-temporary-lifetime-id-generation generation)
        lifetime-id))))

(define (tc-cleanup-owner-marker-id) : i64
  cbi.compiler-builtin-id-tc-cleanup-owner)

(define (tc-ordinary-arena-owner-marker-id) : i64
  cbi.compiler-builtin-id-tc-ordinary-arena-owner)

(define (tc-atomic-arena-owner-marker-id) : i64
  cbi.compiler-builtin-id-tc-atomic-arena-owner)

;; First-class Arena brands live in the generated-name lane, so source text can
;; render them for diagnostics/reflection but can never name or forge them. The
;; call expression's pooled function-node id is unique within the compile job;
;; canonical generated interning makes repeated checker passes over that call
;; recover the same identity.
(define (tc-arena-brand-ordinary-prefix) : String
  "arena-brand/ordinary#")

(define (tc-arena-brand-atomic-prefix) : String
  "arena-brand/atomic#")

(define (tc-generated-arena-brand-with-prefix-id?
  [name-id : i64]
  [prefix : String]) : bool
  (and
    (ci.intern-generated-id-active? name-id)
    (tc-diag-string-prefix? (ci.intern-str name-id) prefix)))

(define (tc-generated-ordinary-arena-brand-id? [name-id : i64]) : bool
  (tc-generated-arena-brand-with-prefix-id?
    name-id
    (tc-arena-brand-ordinary-prefix)))

(define (tc-generated-atomic-arena-brand-id? [name-id : i64]) : bool
  (tc-generated-arena-brand-with-prefix-id?
    name-id
    (tc-arena-brand-atomic-prefix)))

(define (tc-generated-arena-brand-id? [name-id : i64]) : bool
  (or
    (tc-generated-ordinary-arena-brand-id? name-id)
    (tc-generated-atomic-arena-brand-id? name-id)))

(define (tc-return-type-id) : i64
  cbi.compiler-builtin-id-tc-return-type)

(define (tc-loop-target-id) : i64
  cbi.compiler-builtin-id-tc-loop-target)

(define (tc-hygiene-global-boundary-id) : i64
  cbi.compiler-builtin-id-tc-hygiene-global-boundary)

;; One spelling per prefix, owned by the interner: it classifies every pool
;; entry against these strings when the entry is recorded, so a second copy here
;; would let the stored class and the string test disagree.
(define (tc-hygiene-template-prefix) : String
  (ci.intern-macro-template-prefix))

(define (tc-hygiene-global-prefix) : String
  (ci.intern-macro-global-prefix))

(define (tc-hygiene-local-prefix) : String
  (ci.intern-macro-local-prefix))

(defenum TcHygieneGlobalName
  (Legacy String)
  (Context String String))

(define (tc-empty-type-env) : TcTypeEnv
  (tc-empty-env))

(define (tc-empty-module-local-env-cache) : TcModuleLocalEnvCache
  (TcModuleLocalEnvCache (__tl_make-array TcModuleLocalEnvEntry 0) 0))

(defstruct TcMacroModuleEnvStateData
  (hygiene-active-top-env-ready bool)
  (hygiene-active-top-env TcTypeEnv)
  (hygiene-module-env-cache TcModuleLocalEnvCache)
  (macro-cache-store i64)
  (macro-cache-head i64)
  (macro-cache-capacity i64)
  (macro-cache-module-ids (__tl_dyn-array i64))
  (macro-cache-values (__tl_dyn-array TcTypeEnv))
  (macro-cache-len i64)
  (hygiene-cache-arena i64)
  (hygiene-cache-arena-root i64)
  (hygiene-cache-arena-mark i64)
  ;; Per cached view: an `alias.Name` type its bindings still name unresolved,
  ;; or -1 (see tc-module-view-pending-name), and the type-resolution
  ;; generation at which it was last seen unresolved.
  (macro-cache-pending-names (__tl_dyn-array i64))
  (macro-cache-pending-generations (__tl_dyn-array i64)))

(define (tc-macro-module-env-state-new) : TcMacroModuleEnvStateData
  (TcMacroModuleEnvStateData
    false
    (tc-empty-type-env)
    (tc-empty-module-local-env-cache)
    0
    -1
    256
    (__tl_make-array i64 0)
    (__tl_make-array TcTypeEnv 0)
    0
    0
    0
    0
    (__tl_make-array i64 0)
    (__tl_make-array i64 0)))

(define (tc-macro-module-env-state-address-initialize [state : TcMacroState]) : i64
  (tc-macro-state-cell-initialize
    state
    TcMacroModuleEnvStateData
    tc-macro-state-slot-module-env
    (tc-macro-module-env-state-new)))

(define (tc-macro-module-env-state-address [state : TcMacroState]) : i64
  (tc-macro-state-address-fast
    state
    0
    tc-macro-module-env-state-address-initialize))

(define (tc-macro-module-env-state-ptr [state : TcMacroState]) : (MutPtr
    TcMacroModuleEnvStateData)
  (tc-state-cell-ptr
    (tc-macro-module-env-state-address state)
    TcMacroModuleEnvStateData))

(define (tc-macro-module-env-state-view [state : TcMacroState]) : (Ptr
    TcMacroModuleEnvStateData)
  (tc-state-cell-view
    (tc-macro-module-env-state-address state)
    TcMacroModuleEnvStateData))

(define (tc-macro-module-env-state-data [state : TcMacroState]) : TcMacroModuleEnvStateData
  (tc-state-cell-read
    (tc-macro-module-env-state-address state)
    TcMacroModuleEnvStateData))

(define (tc-macro-module-env-state-data-set!
  [state : TcMacroState]
  [data : TcMacroModuleEnvStateData]) : unit
  (tc-state-cell-write!
    (tc-macro-module-env-state-address state)
    TcMacroModuleEnvStateData
    data))

;; Arena that owns the module-local env cache chain. The cache lives in
;; the GLOBAL above, but hygiene lookups fire deep inside per-decl typechecking
;; whose allocations land in scratch arenas; the cache entries and cached env
;; internals would dangle once the scratch arena is reclaimed. Build cache
;; entries inside this dedicated persistent arena (same idiom as the node
;; pools' base arena). Linux starts small for tiny compiles; if a large cache
;; spills, reset promotes it once to a reusable general root. Module identity
;; itself is the stable intern ID.
(define (tc-hygiene-module-env-cache-arena-install!
  [state : TcMacroState]
  [root : i64]) : unit
  (let
    [data : (MutPtr TcMacroModuleEnvStateData)
      (tc-macro-module-env-state-ptr state)]
    (unsafe
      (set! (deref data).hygiene-cache-arena-root root)
      (set! (deref data).hygiene-cache-arena root)
      (in-arena
        (arena.Arena root)
        (set! (deref data).hygiene-cache-arena-mark (arena.tl_region_mark))))))

(define (tc-hygiene-module-env-cache-arena-handle [state : TcMacroState]) : i64
  (if (=
    (unsafe
      (deref (tc-macro-module-env-state-view state)).hygiene-cache-arena-root)
    0)
    (tc-hygiene-module-env-cache-arena-install!
      state
      (cfg windows (arena.tl_arena_make) (arena.tl_arena_make_small)))
    unit)
  (unsafe
    (deref (tc-macro-module-env-state-view state)).hygiene-cache-arena))

;; Installing the owner publishes three ownership fields into the job state.
;; Return a post-install snapshot so callers can safely update another field
;; and write the aggregate back without erasing that newly published state.
(define (tc-hygiene-module-env-cache-owned-data [state : TcMacroState]) : TcMacroModuleEnvStateData
  (tc-hygiene-module-env-cache-arena-handle state)
  (tc-macro-module-env-state-data state))

(define (tc-hygiene-module-env-cache-arena-reset! [state : TcMacroState]) : unit
  (let
    [data : (Ptr TcMacroModuleEnvStateData)
      (tc-macro-module-env-state-view state)]
    (unsafe
      (if (= (deref data).hygiene-cache-arena-root 0)
        unit
        ;; Growth appends segments behind the stable root, so the original mark
        ;; can reset the complete chain without recapturing or replacing a head.
        (in-arena
          (arena.Arena (deref data).hygiene-cache-arena-root)
          (arena.tl_region_reset (deref data).hygiene-cache-arena-mark))))))

(define (tc-macro-module-env-cache-clear! [state : TcMacroState]) : unit
  (let
    [data : (MutPtr TcMacroModuleEnvStateData)
      (tc-macro-module-env-state-ptr state)]
    (unsafe
      (set! (deref data).macro-cache-store 0)
      (set! (deref data).macro-cache-head -1)
      (set! (deref data).macro-cache-len 0))))

(define (tc-hygiene-clear-active-top-env! [state : TcMacroState]) : unit
  (let
    [data : (MutPtr TcMacroModuleEnvStateData)
      (tc-macro-module-env-state-ptr state)]
    (unsafe
      (set! (deref data).hygiene-active-top-env-ready false)
      (set! (deref data).hygiene-active-top-env (tc-empty-type-env))
      (set!
        (deref data).hygiene-module-env-cache
        (tc-empty-module-local-env-cache)))
    (tc-hygiene-module-env-cache-arena-reset! state)))

(define (tc-hygiene-module-env-cache-release! [state : TcMacroState]) : unit
  (unsafe
    (let
      [data : (MutPtr TcMacroModuleEnvStateData)
        (tc-macro-module-env-state-ptr state)]
      [head : i64 (deref data).hygiene-cache-arena]
      (set! (deref data).hygiene-active-top-env-ready false)
      (set! (deref data).hygiene-active-top-env (tc-empty-type-env))
      (set!
        (deref data).hygiene-module-env-cache
        (tc-empty-module-local-env-cache))
      (unless
        (= head 0)
        (if (= (arena.tl_arena_current) head)
          (arena.tl_arena_set ast.node-pool-base-arena)
          unit)
        (arena.tl_arena_destroy head))
      (set! (deref data).hygiene-cache-arena 0)
      (set! (deref data).hygiene-cache-arena-root 0)
      (set! (deref data).hygiene-cache-arena-mark 0))))

(define (tc-hygiene-string-prefix? [text : (& text str)] [prefix : String]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [prefix-len : i64 (string.string-length prefix)]
    [text-data : (Ptr u8)
      (unsafe
        (string-data (& text)))]
    [prefix-data : (Ptr u8)
      (unsafe
        (string-data (& prefix)))]
    [i : i64 0]
    [word-end : i64 (- prefix-len 7)]
    (if (< text-len prefix-len)
      false
      (begin
        (while (< i word-end)
          (if (=
            (unsafe
              (ptr-read (ptr-cast (ptr-offset text-data i) : (Ptr i64))))
            (unsafe
              (ptr-read (ptr-cast (ptr-offset prefix-data i) : (Ptr i64)))))
            (set! i (+ i 8))
            (return false)))
        (while (< i prefix-len)
          (if (=
            (unsafe
              (ptr-read (ptr-offset text-data i)))
            (unsafe
              (ptr-read (ptr-offset prefix-data i))))
            (set! i (+ i 1))
            (return false)))
        true))))

(define (tc-hygiene-name-base [name : String] [prefix : String]) : String
  (string.substring
    name
    (string.string-length prefix)
    (- (string.string-length name) (string.string-length prefix))))

(define (tc-hygiene-template-name? [name : (& name str)]) : bool
  (tc-hygiene-string-prefix? name (tc-hygiene-template-prefix)))

;; Pool ids and the structural families partition the id space: every
;; structural base is at least stride^2 above the pool range, so a pool id can
;; never be a template-source id. Testing the pool range first therefore keeps
;; the same answer while skipping the structural predicate on the common path,
;; and the prefix answer comes from the class the interner already recorded.
(define (tc-hygiene-template-name-id?
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : bool
  (if (and (>= name-id 0) (< name-id (ci.intern-capacity)))
    (ci.intern-macro-template-name-id? name-id)
    (cis.intern-structural-session-template-source-id? session name-id)))

(define (tc-hygiene-template-source-id-or
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]
  [fallback : i64]) : i64
  (cis.intern-structural-session-template-source-name-id-or
    session
    name-id
    fallback))

(define (tc-hygiene-template-base [name : String]) : String
  (tc-hygiene-name-base name (tc-hygiene-template-prefix)))

(define (tc-hygiene-global-name? [name : (& name str)]) : bool
  (tc-hygiene-string-prefix? name (tc-hygiene-global-prefix)))

(define (tc-hygiene-local-name? [name : (& name str)]) : bool
  (tc-hygiene-string-prefix? name (tc-hygiene-local-prefix)))

(define (tc-hygiene-global-name-id?
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : bool
  (if (and (>= name-id 0) (< name-id (ci.intern-capacity)))
    (ci.intern-macro-global-name-id? name-id)
    (macro-hygiene-global-id? session name-id)))

(define (tc-structural-local-name-id?
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : bool
  ;; Fresh and hygienic macro locals are both table-backed. One owner-checked
  ;; kind read classifies the two local families without probing fresh first
  ;; and reopening the same record as a macro local on every miss.
  (if (< name-id (ci.intern-structural-key-base))
    false
    (let
      [kind : i64
        (cis.intern-structural-session-record-kind-for-structural-or
          session
          name-id
          -1)]
      (or
        (= kind (ci.intern-structural-kind-fresh-local))
        (= kind (ci.intern-structural-kind-macro-local))))))

(define (tc-hygiene-local-name-id?
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : bool
  (if (and (>= name-id 0) (< name-id (ci.intern-capacity)))
    (ci.intern-macro-local-name-id? name-id)
    (tc-structural-local-name-id? session name-id)))

(define (tc-hygiene-name-text-id-for-session
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : String
  (cond
    [(and (>= name-id 0) (< name-id (ci.intern-capacity)))
      (ci.intern-str name-id)]
    [(>= name-id (ci.intern-structural-key-base))
      ;; One authoritative lookup classifies the table record. In particular,
      ;; do not probe template, fresh, global, local, ownership, and then the
      ;; generic record in succession: composite environment keys dominate
      ;; diagnostic display.
      (match (cis.intern-structural-session-record-for-raw session name-id)
        [(Some record)
          (let
            [source-id : i64
              (macro-hygiene-record-source-name-id-or session record -1)]
            (cond
              [(>= source-id 0) (ci.intern-str source-id)]
              [(= record.kind (ci.intern-structural-kind-pair))
                (let
                  [cached : String
                    (cis.intern-structural-session-composite-rendered-name-unchecked
                      session
                      name-id)]
                  (if (> (string.string-length cached) 0)
                    cached
                    (cis.intern-structural-session-composite-rendered-name-record-unchecked!
                      session
                      name-id
                      (str_cat.str-cat
                        (tc-hygiene-name-text-id-for-session
                          session
                          record.left-id)
                        "/"
                        (tc-hygiene-name-text-id-for-session
                          session
                          record.right-id)))))]
              [(= record.kind (ci.intern-structural-kind-triple))
                (let
                  [cached : String
                    (cis.intern-structural-session-composite-rendered-name-unchecked
                      session
                      name-id)]
                  (if (> (string.string-length cached) 0)
                    cached
                    (cis.intern-structural-session-composite-rendered-name-record-unchecked!
                      session
                      name-id
                      (str_cat.str-cat
                        (tc-hygiene-name-text-id-for-session
                          session
                          record.left-id)
                        "/"
                        (tc-hygiene-name-text-id-for-session
                          session
                          record.middle-id)
                        "."
                        (tc-hygiene-name-text-id-for-session
                          session
                          record.right-id)))))]
              [else
                (str_cat.str-cat
                  "<structural-id:"
                  (string.int->string name-id)
                  ">")]))]
        [(No)
          (str_cat.str-cat "<structural-id:" (string.int->string name-id) ">")])]
    [else
      (ci.intern-syntax-name-text-or
        name-id
        (str_cat.str-cat "<id:" (string.int->string name-id) ">"))]))

(define (tc-hygiene-name-text-id [name-id : i64]) : String
  (let
    [intern-state : ci.InternCompatState
      (ci.intern-compat-state-capture-active)]
    [session : cis.InternStructuralSessionHandle
      (cis.intern-structural-session-handle-from-source-names
        (ci.intern-source-name-session-handle-from-state intern-state))]
    (tc-hygiene-name-text-id-for-session session name-id)))

(define (tc-hygiene-global-base [name : String]) : String
  (tc-hygiene-name-base name (tc-hygiene-global-prefix)))

(define (tc-hygiene-global-name [name : String]) : String
  (str_cat.str-cat (tc-hygiene-global-prefix) name))

(define (tc-hygiene-global-context-name [module : String] [name : String]) : String
  (tc-hygiene-global-name (str_cat.str-cat module "|" name)))

(define (tc-hygiene-context-separator-index [payload : (& payload str)]) : i64
  (let
    [i : i64 0]
    [n : i64 (string.string-length payload)]
    [found : i64 -1]
    (while (and (< i n) (< found 0))
      (if (= (cast (string.string-ref payload i) : i64) 124)
        (set! found i)
        (set! i (+ i 1))))
    found))

(define (tc-hygiene-global-decode [name : String]) : TcHygieneGlobalName
  (let
    [payload : String (tc-hygiene-global-base name)]
    [sep : i64 (tc-hygiene-context-separator-index payload)]
    (if (< sep 0)
      (Legacy payload)
      (let
        [start : i64 (+ sep 1)]
        (Context
          (string.substring payload 0 sep)
          (string.substring
            payload
            start
            (- (string.string-length payload) start)))))))

(define (tc-hygiene-global-call-name [name : String]) : String
  (if (tc-hygiene-global-name? name)
    (match (tc-hygiene-global-decode name)
      [(Legacy lookup-name) lookup-name]
      [(Context _ lookup-name) lookup-name])
    name))

(define (tc-hygiene-global-symbol-name [name : String]) : String
  (if (tc-hygiene-global-name? name)
    (match (tc-hygiene-global-decode name)
      [(Legacy lookup-name) lookup-name]
      [(Context module lookup-name)
        (if (tc-name-qualified? lookup-name)
          lookup-name
          (csym.compiler-symbol-module-key module lookup-name))])
    name))

(define (tc-hygiene-global-env [top-env : TcTypeEnv]) : TcTypeEnv
  (tc-bind-id top-env (tc-hygiene-global-boundary-id) (Unit)))

(define (tc-hygiene-reset-active-top-env!
  [state : TcMacroState]
  [top-env : TcTypeEnv]) : unit
  (let
    [data : (MutPtr TcMacroModuleEnvStateData)
      (tc-macro-module-env-state-ptr state)]
    (unsafe
      (set! (deref data).hygiene-active-top-env top-env)
      (set! (deref data).hygiene-active-top-env-ready true)
      (set!
        (deref data).hygiene-module-env-cache
        (tc-empty-module-local-env-cache)))
    (tc-hygiene-module-env-cache-arena-reset! state)))

(define (tc-unsafe-marker-id) : i64
  cbi.compiler-builtin-id-tc-unsafe-context)

(define (tc-enter-unsafe [env : TcTypeEnv]) : TcTypeEnv
  (tc-bind-runtime-marker-id env (tc-unsafe-marker-id) (Unit) UnsafeContext))

;; Deferred bodies do not inherit permission from the expression that creates
;; them. A Never marker shadows an enclosing Unit marker while retaining the
;; same scoped-runtime marker identity; a nested explicit unsafe re-enters with
;; Unit as usual.
(define (tc-clear-unsafe-context [env : TcTypeEnv]) : TcTypeEnv
  (tc-bind-runtime-marker-id env (tc-unsafe-marker-id) (Never) UnsafeContext))

(define (tc-env-marker-type-scan [env : TcTypeEnv] [name-id : i64]) : ast.AstMaybeType
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    (cond
      [(= head -1) (No)]
      [(< head -1)
        (let
          [cache : TcTypeEnvCache
            (tc-type-env-cache-at
              (tc-type-env-cache-ptr
                store-handle
                (tc-type-env-cache-index head)))]
          [ids : tc_i64_i64_map.Map cache.ids]
          (if cache.scan-through
            (match (tc_i64_i64_map.get (& ids) name-id)
              [(LookupFound index)
                (Some (ast.ast-array-shared-view cache.values index))]
              [(LookupMissing)
                (if cache.partial
                  (tc-env-marker-type-scan
                    (TcTypeEnv store-handle cache.below env.abi-pad)
                    name-id)
                  (No))])
            (No)))]
      [else
        (let
          [binding-ptr : (Ptr TcTypeEnvBinding)
            (tc-type-env-binding-ptr store-handle head)]
          (if (= (tc-type-env-binding-name-at binding-ptr) name-id)
            (Some (tc-type-env-binding-type-at binding-ptr))
            (tc-env-marker-type-scan
              (TcTypeEnv
                store-handle
                (tc-type-env-binding-parent-at binding-ptr)
                env.abi-pad)
              name-id)))])))

(define (tc-env-marker-type [env : TcTypeEnv] [name-id : i64]) : ast.AstMaybeType
  (let
    [head : i64 env.head]
    (if (< head -1)
      (let
        [store-handle : i64 env.store]
        [cache : TcTypeEnvCache
          (tc-type-env-cache-at
            (tc-type-env-cache-ptr store-handle (tc-type-env-cache-index head)))]
        (if cache.scan-through
          (tc-env-marker-type-scan env name-id)
          (tc-env-marker-type-scan
            (TcTypeEnv store-handle cache.rest env.abi-pad)
            name-id)))
      (tc-env-marker-type-scan env name-id))))

(define (tc-in-unsafe? [env : TcTypeEnv]) : bool
  (if (tc-type-env-scoped-runtime-active? env)
    (tc-type-env-scoped-carrier-in-unsafe?
      (tc-type-env-scoped-runtime-current env))
    (begin
      (cfg compile-profile (counters.bump! tc-profile-env-marker-scans))
      (match (tc-env-marker-type env (tc-unsafe-marker-id))
        [(Some (Unit)) true]
        [(or (Some _) (No)) false]))))

(define (tc-unused-unsafe-no-span) : ast.AstSourceSpan
  (ast.ast-source-span 0 0 0 0))

(define (tc-unused-unsafe-state-storage-ensure! [state : TcUnusedUnsafeState]) : unit
  (let
    [data : (MutPtr TcUnusedUnsafeStateData) (tc-unused-unsafe-state-ptr state)]
    (unsafe
      (if (> (array-length (deref data).block-spans) 0)
        unit
        (in-arena
          (arena.Arena (deref data).fixed-storage-arena)
          (set!
            (deref data).block-spans
            (__tl_make-array ast.AstSourceSpan 128))
          (set! (deref data).block-paths (__tl_make-array String 128))
          (set! (deref data).block-used (__tl_make-array bool 128)))))))

(define (tc-unused-unsafe-tracking-reset!
  [state : TcUnusedUnsafeState]
  [path : String]) : unit
  (tc-unused-unsafe-state-storage-ensure! state)
  (let
    [data : (MutPtr TcUnusedUnsafeStateData) (tc-unused-unsafe-state-ptr state)]
    (unsafe
      (set! (deref data).current-block -1)
      (set! (deref data).current-path "")
      (set! (deref data).target-path path)
      (set! (deref data).block-len 0)
      (set! (deref data).enabled true))))

(define (tc-unused-unsafe-tracking-disable! [state : TcUnusedUnsafeState]) : unit
  (let
    [data : (MutPtr TcUnusedUnsafeStateData) (tc-unused-unsafe-state-ptr state)]
    (unsafe
      (set! (deref data).enabled false)
      (set! (deref data).current-block -1)
      (set! (deref data).current-path "")
      (set! (deref data).target-path ""))))

(define (tc-unused-unsafe-tracking-clear! [state : TcUnusedUnsafeState]) : unit
  (tc-unused-unsafe-tracking-disable! state)
  (unsafe
    (set! (deref (tc-unused-unsafe-state-ptr state)).block-len 0)))

(define (tc-unused-unsafe-block-count [state : TcUnusedUnsafeState]) : i64
  (unsafe
    (deref (tc-unused-unsafe-state-view state)).block-len))

(define (tc-unused-unsafe-block-path
  [state : TcUnusedUnsafeState]
  [index : i64]) : String
  (let
    [data : (Ptr TcUnusedUnsafeStateData) (tc-unused-unsafe-state-view state)]
    (unsafe
      (if (and (>= index 0) (< index (deref data).block-len))
        (array-ref (deref data).block-paths index)
        ""))))

(define (tc-unused-unsafe-block-span
  [state : TcUnusedUnsafeState]
  [index : i64]) : ast.AstSourceSpan
  (let
    [data : (Ptr TcUnusedUnsafeStateData) (tc-unused-unsafe-state-view state)]
    (unsafe
      (if (and (>= index 0) (< index (deref data).block-len))
        (array-ref (deref data).block-spans index)
        (tc-unused-unsafe-no-span)))))

(define (tc-unused-unsafe-block-used?
  [state : TcUnusedUnsafeState]
  [index : i64]) : bool
  (let
    [data : (Ptr TcUnusedUnsafeStateData) (tc-unused-unsafe-state-view state)]
    (unsafe
      (if (and (>= index 0) (< index (deref data).block-len))
        (array-ref (deref data).block-used index)
        false))))

(define (tc-unused-unsafe-set-current-path!
  [state : TcUnusedUnsafeState]
  [path : String]) : String
  (unsafe
    (let
      [data : (MutPtr TcUnusedUnsafeStateData)
        (tc-unused-unsafe-state-ptr state)]
      [current : String (deref data).current-path]
      [prev : String (string.copy (& current))]
      (if (deref data).enabled
        (set! (deref data).current-path path)
        unit)
      prev)))

(define (tc-unused-unsafe-restore-current-path!
  [state : TcUnusedUnsafeState]
  [path : String]) : unit
  (let
    [data : (MutPtr TcUnusedUnsafeStateData) (tc-unused-unsafe-state-ptr state)]
    (unsafe
      (if (deref data).enabled
        (set! (deref data).current-path path)
        unit))))

(define (tc-unused-unsafe-span-eq?
  [a : ast.AstSourceSpan]
  [b : ast.AstSourceSpan]) : bool
  (and
    (= (ast.ast-source-span-start-line a) (ast.ast-source-span-start-line b))
    (= (ast.ast-source-span-start-col a) (ast.ast-source-span-start-col b))
    (= (ast.ast-source-span-end-line a) (ast.ast-source-span-end-line b))
    (= (ast.ast-source-span-end-col a) (ast.ast-source-span-end-col b))))

(define (tc-unused-unsafe-find-existing
  [state : TcUnusedUnsafeState]
  [path : String]
  [span : ast.AstSourceSpan]
  [index : i64]) : i64
  (let
    [data : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
    (if (>= index data.block-len)
      -1
      (if (and
        (string.eq (array-ref data.block-paths index) path)
        (tc-unused-unsafe-span-eq? (array-ref data.block-spans index) span))
        index
        (tc-unused-unsafe-find-existing state path span (+ index 1))))))

(define (tc-unused-unsafe-grow-copy
  [data : (& data TcUnusedUnsafeStateData)]
  [new-spans : (&mut new-spans (__tl_dyn-array ast.AstSourceSpan))]
  [new-paths : (&mut new-paths (__tl_dyn-array String))]
  [new-used : (&mut new-used (__tl_dyn-array bool))]
  [index : i64]) : unit
  (unless
    (>= index data.block-len)
    (let
      [span : ast.AstSourceSpan (array-ref data.block-spans index)]
      (set!
        (array-ref new-spans index)
        (ast.AstSourceSpan
          span.start-line
          span.start-col
          span.end-line
          span.end-col)))
    (set!
      (array-ref new-paths index)
      (string.copy (& (array-ref data.block-paths index))))
    (set! (array-ref new-used index) (array-ref data.block-used index))
    (tc-unused-unsafe-grow-copy data new-spans new-paths new-used (+ index 1))))

(define (tc-unused-unsafe-grow! [state : TcUnusedUnsafeState]) : unit
  (let
    [data : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
    [old-cap : i64 (array-length data.block-spans)]
    [new-cap : i64 (* old-cap 2)]
    ;; The job-owned fixed-storage arena outlives every tracking pass. Publish
    ;; all replacement arrays into state before the lexical extent restores.
    [owner : arena.Arena (arena.Arena data.fixed-storage-arena)]
    (in-arena
      owner
      (let
        [new-spans : (__tl_dyn-array ast.AstSourceSpan)
          (__tl_make-array ast.AstSourceSpan new-cap)]
        [new-paths : (__tl_dyn-array String) (__tl_make-array String new-cap)]
        [new-used : (__tl_dyn-array bool) (__tl_make-array bool new-cap)]
        (tc-unused-unsafe-grow-copy
          data
          (&mut new-spans)
          (&mut new-paths)
          (&mut new-used)
          0)
        (set! data.block-spans new-spans)
        (set! data.block-paths new-paths)
        (set! data.block-used new-used)
        (tc-unused-unsafe-state-data-set! state data)))))

(define (tc-unused-unsafe-push
  [state : TcUnusedUnsafeState]
  [span : ast.AstSourceSpan]) : i64
  (unsafe
    (let
      [data : (Ptr TcUnusedUnsafeStateData) (tc-unused-unsafe-state-view state)]
      [existing : i64
        (tc-unused-unsafe-find-existing state (deref data).current-path span 0)]
      (if (>= existing 0)
        existing
        (let
          [slot : i64 (deref data).block-len]
          (if (>= slot (array-length (deref data).block-spans))
            (tc-unused-unsafe-grow! state)
            unit)
          (let
            [next : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
            (set! (array-ref next.block-spans slot) span)
            (set! (array-ref next.block-paths slot) next.current-path)
            (set! (array-ref next.block-used slot) false)
            (set! next.block-len (+ slot 1))
            (tc-unused-unsafe-state-data-set! state next)
            slot))))))

(define (tc-unused-unsafe-enter-block
  [state : TcUnusedUnsafeState]
  [span : TcMaybeAstSourceSpan]) : i64
  (let
    [data : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
    [prev : i64 data.current-block]
    (if data.enabled
      (if (string.eq data.current-path data.target-path)
        (match span
          [(Some real-span)
            (let
              [slot : i64 (tc-unused-unsafe-push state real-span)]
              [next : (MutPtr TcUnusedUnsafeStateData)
                (tc-unused-unsafe-state-ptr state)]
              (unsafe
                (set! (deref next).current-block slot)))]
          [(No) unit])
        unit)
      unit)
    prev))

(define (tc-unused-unsafe-restore-block!
  [state : TcUnusedUnsafeState]
  [prev : i64]) : unit
  (let
    [data : (MutPtr TcUnusedUnsafeStateData) (tc-unused-unsafe-state-ptr state)]
    (unsafe
      (if (deref data).enabled
        (set! (deref data).current-block prev)
        unit))))

(define (tc-unused-unsafe-mark-current-used! [state : TcUnusedUnsafeState]) : unit
  (let
    [data : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
    [current : i64 data.current-block]
    (if (and data.enabled (>= current 0) (< current data.block-len))
      (set! (array-ref data.block-used current) true)
      unit)))

(define (tc-unsafe-begin-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]
  [expected : ast.AstMaybeType]
  [span : TcMaybeAstSourceSpan]) : ResultTcType
  (let
    [unused-unsafe : TcUnusedUnsafeState
      (tc-job-state-unused-unsafe (tc-context-job-state ctx))]
    [prev : i64 (tc-unused-unsafe-enter-block unused-unsafe span)]
    [result : ResultTcType
      (tc-begin-list-maybe-expected ctx (tc-enter-unsafe env) exprs expected)]
    (tc-unused-unsafe-restore-block! unused-unsafe prev)
    result))

(define (tc-bind-return-type [env : TcTypeEnv] [ty : ast.AstType]) : TcTypeEnv
  (tc-bind-runtime-marker-id env (tc-return-type-id) ty Other))

(define (tc-current-return-type [env : TcTypeEnv]) : ResultTcType
  (if (tc-type-env-scoped-runtime-active? env)
    (tc-type-env-scoped-carrier-current-return-type
      (tc-type-env-scoped-runtime-current env))
    (begin
      (cfg compile-profile (counters.bump! tc-profile-env-marker-scans))
      (match (tc-env-marker-type env (tc-return-type-id))
        [(Some ty) (Ok ty)]
        [(No) (Err "typecheck: try requires enclosing Result-like function")]))))

(define (tc-enter-loop-target [env : TcTypeEnv]) : TcTypeEnv
  (tc-bind-runtime-marker-id env (tc-loop-target-id) (Unit) Other))

(define (tc-clear-loop-target [env : TcTypeEnv]) : TcTypeEnv
  (tc-bind-runtime-marker-id env (tc-loop-target-id) (Never) Other))

(define (tc-in-loop-target? [env : TcTypeEnv]) : bool
  (match (tc-env-marker-type env (tc-loop-target-id))
    [(Some ty) (not (tc-never-type? ty))]
    [(No) false]))

(define (tc-loop-control-expr [env : TcTypeEnv] [form : String]) : ResultTcType
  (if (tc-in-loop-target? env)
    (Ok (Never))
    (Err
      (str_cat.str-cat
        (cdiag.compiler-diagnostic-typecheck-tag (ControlFlow))
        "typecheck: "
        form
        " requires enclosing scalar while"))))

(define (tc-type-list1 [a : ast.AstType]) : ast.AstTypeList
  (ast.ast-type-cons (& a) (& (ast.ast-type-list-new))))

(define (tc-type-list2 [a : ast.AstType] [b : ast.AstType]) : ast.AstTypeList
  (ast.ast-type-cons
    (& a)
    (& (ast.ast-type-cons (& b) (& (ast.ast-type-list-new))))))

(define (tc-type-list3 [a : ast.AstType] [b : ast.AstType] [c : ast.AstType]) : ast.AstTypeList
  (ast.ast-type-cons
    (& a)
    (&
      (ast.ast-type-cons
        (& b)
        (& (ast.ast-type-cons (& c) (& (ast.ast-type-list-new))))))))

(define (tc-fn0 [ret : ast.AstType]) : ast.AstType
  (ast.ast-ty-func (ast.ast-type-list-new) (& ret)))

(define (tc-fn1 [a : ast.AstType] [ret : ast.AstType]) : ast.AstType
  (ast.ast-ty-func (tc-type-list1 a) (& ret)))

(define (tc-fn2 [a : ast.AstType] [b : ast.AstType] [ret : ast.AstType]) : ast.AstType
  (ast.ast-ty-func (tc-type-list2 a b) (& ret)))

(define (tc-fn3
  [a : ast.AstType]
  [b : ast.AstType]
  [c : ast.AstType]
  [ret : ast.AstType]) : ast.AstType
  (ast.ast-ty-func (tc-type-list3 a b c) (& ret)))

(define (tc-fn4
  [a : ast.AstType]
  [b : ast.AstType]
  [c : ast.AstType]
  [d : ast.AstType]
  [ret : ast.AstType]) : ast.AstType
  (ast.ast-ty-func
    (ast.ast-type-cons
      (& a)
      (&
        (ast.ast-type-cons
          (& b)
          (&
            (ast.ast-type-cons
              (& c)
              (& (ast.ast-type-cons (& d) (& (ast.ast-type-list-new)))))))))
    (& ret)))

(define (tc-type-list-render [types : ast.AstTypeList]) : String
  (tc-type-list-render-at (& types) 0))

(define (tc-type-list-render-at
  [types : (& types ast.AstTypeList)]
  [index : i64]) : String
  (if (>= index (ast.ast-type-list-len types))
    ""
    (let
      [head : ast.AstType
        (ast.ty-node-get
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      (str_cat.str-cat
        (tc-type-render head)
        (if (>= (+ index 1) (ast.ast-type-list-len types))
          ""
          (str_cat.str-cat " " (tc-type-list-render-at types (+ index 1))))))))

(define (tc-lifetime-list-render [lifetimes : ast.AstLifetimeList]) : String
  (tc-lifetime-list-render-at (& lifetimes) 0))

(define (tc-lifetime-list-render-at
  [lifetimes : (& lifetimes ast.AstLifetimeList)]
  [index : i64]) : String
  (if (>= index (ast.ast-lifetime-list-len lifetimes))
    ""
    (let
      [head : i64
        (ast.ast-lifetime-list-get lifetimes index (ast.ast-lifetime-fallback))]
      (str_cat.str-cat
        (tc-lifetime-name-render head)
        (if (>= (+ index 1) (ast.ast-lifetime-list-len lifetimes))
          ""
          (str_cat.str-cat
            " "
            (tc-lifetime-list-render-at lifetimes (+ index 1))))))))

(define (tc-render-nominal-lifetime-type
  [name : String]
  [lifetimes : ast.AstLifetimeList]) : String
  (str_cat.str-cat "(" name " " (tc-lifetime-list-render lifetimes) ")"))

(define (tc-elided-lifetime-name-prefix) : String
  "\n__typelisp_signature_elided_lifetime_")

(define (tc-elaborated-lifetime-hidden? [name : i64]) : bool
  (or
    (= name cbi.compiler-builtin-id-fix-empty)
    (and
      (ci.intern-renderable-id? name)
      (tc-diag-string-prefix?
        (ci.intern-str name)
        (tc-elided-lifetime-name-prefix)))))

(define (tc-type-render [ty : ast.AstType]) : String
  (match ty
    [(I64) "i64"]
    [(I32) "i32"]
    [(I16) "i16"]
    [(I8) "i8"]
    [(U64) "u64"]
    [(U32) "u32"]
    [(U16) "u16"]
    [(U8) "u8"]
    [(F64) "f64"]
    [(F32) "f32"]
    [(Bool) "bool"]
    [(Char) "char"]
    [(String) "String"]
    [(Str) "str"]
    [(Bytes) "bytes"]
    [(Unit) "unit"]
    [(Never) "never"]
    [(Expr) "Expr"]
    [(ExprList) "ExprList"]
    [(Func args ret)
      (str_cat.str-cat
        "(-> "
        (tc-type-list-render (ast.ast-type-list-box-shared-view args))
        " "
        (tc-type-render (ast.ty-node-get ret))
        ")")]
    [(CFunc signature mode)
      (str_cat.str-cat
        "(CFunc "
        (ast.ast-c-function-mode-name mode)
        " "
        (tc-type-render (ast.ty-node-get signature))
        ")")]
    [(Tuple elems)
      (str_cat.str-cat
        "(Tuple "
        (tc-type-list-render (ast.ast-type-list-box-shared-view elems))
        ")")]
    [(Array elem count)
      (str_cat.str-cat
        "(Array "
        (tc-type-render (ast.ty-node-get elem))
        " "
        (string.int->string count)
        ")")]
    [(DynArray elem)
      (str_cat.str-cat
        "(__tl_dyn-array "
        (tc-type-render (ast.ty-node-get elem))
        ")")]
    [(Slice elem)
      (str_cat.str-cat "(Slice " (tc-type-render (ast.ty-node-get elem)) ")")]
    [(Box elem)
      (str_cat.str-cat "(Box " (tc-type-render (ast.ty-node-get elem)) ")")]
    [(Ptr elem)
      (str_cat.str-cat "(Ptr " (tc-type-render (ast.ty-node-get elem)) ")")]
    [(MutPtr elem)
      (str_cat.str-cat "(MutPtr " (tc-type-render (ast.ty-node-get elem)) ")")]
    [(Ref region inner)
      (if (tc-elaborated-lifetime-hidden? region)
        (str_cat.str-cat "(& " (tc-type-render (ast.ty-node-get inner)) ")")
        (str_cat.str-cat
          "(& "
          (tc-lifetime-name-render region)
          " "
          (tc-type-render (ast.ty-node-get inner))
          ")"))]
    [(MutRef region inner)
      (if (tc-elaborated-lifetime-hidden? region)
        (str_cat.str-cat "(&mut " (tc-type-render (ast.ty-node-get inner)) ")")
        (str_cat.str-cat
          "(&mut "
          (tc-lifetime-name-render region)
          " "
          (tc-type-render (ast.ty-node-get inner))
          ")"))]
    [(Region region inner)
      (str_cat.str-cat
        "(Region "
        (tc-lifetime-name-render region)
        " "
        (tc-type-render (ast.ty-node-get inner))
        ")")]
    [(Invalidate lifetime inner)
      (str_cat.str-cat
        "(:invalidate "
        (tc-lifetime-name-render lifetime)
        " "
        (tc-type-render (ast.ty-node-get inner))
        ")")]
    [(or (Enum name) (Struct name) (Var name))
      (tc-nominal-name-id-display name)]
    [(or (EnumArgs name lifetimes) (StructArgs name lifetimes)
         (VarArgs name lifetimes))
      (tc-render-nominal-lifetime-type
        (tc-nominal-name-id-display name)
        (ast.ast-lifetime-list-box-shared-view lifetimes))]))

;; A type mismatch unless `message`, the context, already carries a kind.
(define (tc-type-mismatch-message
  [actual : ast.AstType]
  [expected : ast.AstType]
  [message : String]) : String
  (let
    [context-kind : bool
      (cdiag.compiler-diagnostic-typecheck-tagged? (& message))]
    [text : String
      (str_cat.str-cat
        message
        ": expected "
        (tc-type-render (tc-type-without-regions expected))
        ", found "
        (tc-type-render (tc-type-without-regions actual)))]
    (if context-kind
      text
      (tc-kind-message (TypeMismatch) text))))

(define (tc-default-env) : TcTypeEnv
  (tc-bind-id (tc-default-env-base) (tc-default-boundary-id) (Unit)))

(define (tc-default-env-with-job-state [state : TcJobState]) : TcTypeEnv
  (tc-bind-id
    (tc-default-env-base-with-job-state state)
    (tc-default-boundary-id)
    (Unit)))

(define (tc-default-env-base) : TcTypeEnv
  (let
    [e0 : TcTypeEnv (tc-empty-env)]
    [e1 : TcTypeEnv
      (tc-bind-id
        e0
        cbi.compiler-builtin-id-cpuid
        (tc-fn2
          (I64)
          (I64)
          (ast.ast-ty-tuple
            (ast.ast-type-cons
              (& (I32))
              (&
                (ast.ast-type-cons
                  (& (I32))
                  (&
                    (ast.ast-type-cons
                      (& (I32))
                      (&
                        (ast.ast-type-cons
                          (& (I32))
                          (& (ast.ast-type-list-new))))))))))))]
    [e2 : TcTypeEnv
      (tc-bind-id e1 cbi.compiler-builtin-id-xgetbv (tc-fn1 (I64) (I64)))]
    (tc-bind-id e2 (tc-default-boundary-id) (Unit))))

(define (tc-default-env-base-with-job-state [state : TcJobState]) : TcTypeEnv
  (let
    [e0 : TcTypeEnv (tc-empty-env-with-job-state state)]
    [e1 : TcTypeEnv
      (tc-bind-id
        e0
        cbi.compiler-builtin-id-cpuid
        (tc-fn2
          (I64)
          (I64)
          (ast.ast-ty-tuple
            (ast.ast-type-cons
              (& (I32))
              (&
                (ast.ast-type-cons
                  (& (I32))
                  (&
                    (ast.ast-type-cons
                      (& (I32))
                      (&
                        (ast.ast-type-cons
                          (& (I32))
                          (& (ast.ast-type-list-new))))))))))))]
    [e2 : TcTypeEnv
      (tc-bind-id e1 cbi.compiler-builtin-id-xgetbv (tc-fn1 (I64) (I64)))]
    (tc-bind-id e2 (tc-default-boundary-id) (Unit))))

(define (tc-macro-expr-clause-type) : ast.AstType
  (Var cbi.compiler-builtin-id-fix-ExprClause))

(define (tc-macro-expr-clause-list-type) : ast.AstType
  (Var cbi.compiler-builtin-id-fix-ExprClauseList))

(define (tc-macro-expr-binding-clause-type) : ast.AstType
  (Var cbi.compiler-builtin-id-fix-ExprBindingClause))

(define (tc-macro-expr-binding-clause-list-type) : ast.AstType
  (Var cbi.compiler-builtin-id-fix-ExprBindingClauseList))

(define (tc-macro-pattern-type) : ast.AstType
  (Var cbi.compiler-builtin-id-fix-Pattern))

(define (tc-macro-pattern-list-type) : ast.AstType
  (Var cbi.compiler-builtin-id-fix-PatternList))

(define (tc-macro-match-arm-type) : ast.AstType
  (Var cbi.compiler-builtin-id-fix-MatchArm))

(define (tc-macro-match-arm-list-type) : ast.AstType
  (Var cbi.compiler-builtin-id-fix-MatchArmList))

(define (tc-macro-expr-clause-type? [ty : ast.AstType]) : bool
  (match ty
    [(Var name)
      (or
        (= name cbi.compiler-builtin-id-fix-ExprClause)
        (=
          name
          cbi.compiler-builtin-id-fix-stdlib_dot_comptime_slash_ExprClause))]
    [_ false]))

(define (tc-macro-expr-clause-list-type? [ty : ast.AstType]) : bool
  (match ty
    [(Var name)
      (or
        (= name cbi.compiler-builtin-id-fix-ExprClauseList)
        (=
          name
          cbi.compiler-builtin-id-fix-stdlib_dot_comptime_slash_ExprClauseList))]
    [_ false]))

(define (tc-macro-expr-binding-clause-type? [ty : ast.AstType]) : bool
  (match ty
    [(Var name)
      (or
        (= name cbi.compiler-builtin-id-fix-ExprBindingClause)
        (=
          name
          cbi.compiler-builtin-id-fix-stdlib_dot_comptime_slash_ExprBindingClause))]
    [_ false]))

(define (tc-macro-expr-binding-clause-list-type? [ty : ast.AstType]) : bool
  (match ty
    [(Var name)
      (or
        (= name cbi.compiler-builtin-id-fix-ExprBindingClauseList)
        (=
          name
          cbi.compiler-builtin-id-fix-stdlib_dot_comptime_slash_ExprBindingClauseList))]
    [_ false]))

(define (tc-macro-type-param-kind? [ty : ast.AstType]) : bool
  (match ty
    [(Var name) (= name cbi.compiler-builtin-id-fix-type)]
    [_ false]))

(define (tc-macro-module-param-kind? [ty : ast.AstType]) : bool
  (match ty
    [(Var name)
      (or
        (= name cbi.compiler-builtin-id-fix-Module)
        (= name cbi.compiler-builtin-id-fix-module))]
    [_ false]))

(define (tc-type-unquote-marker? [ty : ast.AstType]) : bool
  (match ty
    [(VarArgs name _) (= name cbi.compiler-builtin-id-fix-unquote)]
    [_ false]))

(define (tc-stdlib-comptime-module-name) : String
  "stdlib.comptime")

(define (tc-stdlib-comptime-type-key-id [_ : String] [name-id : i64]) : i64
  (tc-qualified-name-key-id
    cbi.compiler-builtin-id-fix-stdlib_dot_comptime
    name-id))

(define (tc-stdlib-comptime-type-display-name [name : String]) : String
  (str_cat.str-cat (tc-stdlib-comptime-module-name) "." name))

;; A stdlib comptime syntax type is named by the module-qualified key of two
;; builtin ids. That key is a structural composite pair, so its module and base
;; are read straight back out of `canonical-id`: there is no table to look up and
;; nothing to cache per intern generation or per job.
(define (tc-stdlib-comptime-syntax-base-type [base-id : i64]) : ast.AstMaybeType
  (cond
    [(= base-id cbi.compiler-builtin-id-fix-Expr) (Some (Expr))]
    [(= base-id cbi.compiler-builtin-id-fix-ExprList) (Some (ExprList))]
    [(= base-id cbi.compiler-builtin-id-fix-ExprClause)
      (Some (tc-macro-expr-clause-type))]
    [(= base-id cbi.compiler-builtin-id-fix-ExprClauseList)
      (Some (tc-macro-expr-clause-list-type))]
    [(= base-id cbi.compiler-builtin-id-fix-ExprBindingClause)
      (Some (tc-macro-expr-binding-clause-type))]
    [(= base-id cbi.compiler-builtin-id-fix-ExprBindingClauseList)
      (Some (tc-macro-expr-binding-clause-list-type))]
    [(= base-id cbi.compiler-builtin-id-fix-Pattern)
      (Some (tc-macro-pattern-type))]
    [(= base-id cbi.compiler-builtin-id-fix-PatternList)
      (Some (tc-macro-pattern-list-type))]
    [(= base-id cbi.compiler-builtin-id-fix-MatchArm)
      (Some (tc-macro-match-arm-type))]
    [(= base-id cbi.compiler-builtin-id-fix-MatchArmList)
      (Some (tc-macro-match-arm-list-type))]
    [else (No)]))

(define (tc-stdlib-comptime-syntax-type-id [canonical-id : i64]) : ast.AstMaybeType
  (let
    [_ : unit (cbi.compiler-builtin-refresh!)]
    (if (and
      (csym.compiler-composite-pair-key-id? canonical-id)
      (=
        (csym.compiler-composite-pair-left-id canonical-id)
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime))
      (tc-stdlib-comptime-syntax-base-type
        (csym.compiler-composite-pair-right-id canonical-id))
      (No))))

(define (tc-stdlib-comptime-syntax-alias?
  [canonical-name : (& canonical-name str)]
  [type-name : String]) : bool
  (or
    (string.eq canonical-name type-name)
    (string.eq
      canonical-name
      (str_cat.str-cat "comptime." (tc-global-shared-view type-name)))
    (string.eq
      canonical-name
      (str_cat.str-cat
        (tc-stdlib-comptime-module-name)
        "."
        (tc-global-shared-view type-name)))
    (string.eq
      canonical-name
      (str_cat.str-cat "stdlib/comptime." (tc-global-shared-view type-name)))
    (string.eq
      canonical-name
      (csym.compiler-symbol-module-key
        "comptime"
        (tc-global-shared-view type-name)))
    (string.eq
      canonical-name
      (csym.compiler-symbol-module-key "stdlib/comptime" type-name))))

(define (tc-stdlib-comptime-syntax-alias-type [canonical-name : String]) : ast.AstMaybeType
  (cond
    [(tc-stdlib-comptime-syntax-alias? canonical-name "Expr") (Some (Expr))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "ExprList")
      (Some (ExprList))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "ExprClause")
      (Some (tc-macro-expr-clause-type))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "ExprClauseList")
      (Some (tc-macro-expr-clause-list-type))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "ExprBindingClause")
      (Some (tc-macro-expr-binding-clause-type))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "ExprBindingClauseList")
      (Some (tc-macro-expr-binding-clause-list-type))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "Pattern")
      (Some (tc-macro-pattern-type))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "PatternList")
      (Some (tc-macro-pattern-list-type))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "MatchArm")
      (Some (tc-macro-match-arm-type))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "MatchArmList")
      (Some (tc-macro-match-arm-list-type))]
    [else (No)]))

(define (tc-macro-signature-stdlib-comptime-type-id [name : i64]) : ast.AstMaybeType
  (match (tc-stdlib-comptime-syntax-type-id name)
    [(Some ty) (Some ty)]
    [(No) (tc-stdlib-comptime-syntax-alias-type (tc-env-key-name-text name))]))

(defenum TcStdlibTypeSpec
  (I64)
  (Bool)
  (String)
  (Name i64)
  (BoxName i64)
  (ArrayName i64))

;; The expected-surface spec tables are fixed, tiny (at most twelve entries) and
;; rebuilt once per stdlib surface check, so they are dense arrays and the
;; `-cons` spellings prepend by copy rather than chaining cells.
(defstruct TcStdlibTypeSpecList
  (slots (__tl_dyn-array TcStdlibTypeSpec))
  (len i64))

(defenum TcStdlibFieldSpec
  (Spec i64 TcStdlibTypeSpec))

(defstruct TcStdlibFieldSpecList
  (slots (__tl_dyn-array TcStdlibFieldSpec))
  (len i64))

(defenum TcStdlibVariantSpec
  (Spec i64 TcStdlibTypeSpecList))

(defstruct TcStdlibVariantSpecList
  (slots (__tl_dyn-array TcStdlibVariantSpec))
  (len i64))

(define (tc-stdlib-type-spec-list0) : TcStdlibTypeSpecList
  (TcStdlibTypeSpecList (__tl_make-array TcStdlibTypeSpec 0) 0))

(define (tc-stdlib-type-spec-list1 [a : TcStdlibTypeSpec]) : TcStdlibTypeSpecList
  (let
    [slots : (__tl_dyn-array TcStdlibTypeSpec)
      (__tl_make-array TcStdlibTypeSpec 1)]
    (set! (array-ref slots 0) a)
    (TcStdlibTypeSpecList slots 1)))

(define (tc-stdlib-type-spec-list2
  [a : TcStdlibTypeSpec]
  [b : TcStdlibTypeSpec]) : TcStdlibTypeSpecList
  (let
    [slots : (__tl_dyn-array TcStdlibTypeSpec)
      (__tl_make-array TcStdlibTypeSpec 2)]
    (set! (array-ref slots 0) a)
    (set! (array-ref slots 1) b)
    (TcStdlibTypeSpecList slots 2)))

(define (tc-stdlib-type-spec-list3
  [a : TcStdlibTypeSpec]
  [b : TcStdlibTypeSpec]
  [c : TcStdlibTypeSpec]) : TcStdlibTypeSpecList
  (let
    [slots : (__tl_dyn-array TcStdlibTypeSpec)
      (__tl_make-array TcStdlibTypeSpec 3)]
    (set! (array-ref slots 0) a)
    (set! (array-ref slots 1) b)
    (set! (array-ref slots 2) c)
    (TcStdlibTypeSpecList slots 3)))

(define (tc-stdlib-field-spec-nil) : TcStdlibFieldSpecList
  (TcStdlibFieldSpecList (__tl_make-array TcStdlibFieldSpec 0) 0))

(define (tc-stdlib-field-spec-cons
  [name : i64]
  [ty : TcStdlibTypeSpec]
  [rest : TcStdlibFieldSpecList]) : TcStdlibFieldSpecList
  (let
    [n : i64 rest.len]
    [src : (__tl_dyn-array TcStdlibFieldSpec) rest.slots]
    [slots : (__tl_dyn-array TcStdlibFieldSpec)
      (__tl_make-array TcStdlibFieldSpec (+ n 1))]
    [i : i64 0]
    (begin
      (cfg
        compile-profile
        (counters.bump! tc-profile-layout-stdlib-field-spec-builds))
      (set! (array-ref slots 0) (TcStdlibFieldSpec.Spec name ty))
      (while (< i n)
        (set! (array-ref slots (+ i 1)) (array-ref src i))
        (set! i (+ i 1)))
      (TcStdlibFieldSpecList slots (+ n 1)))))

(define (tc-stdlib-variant-spec-nil) : TcStdlibVariantSpecList
  (TcStdlibVariantSpecList (__tl_make-array TcStdlibVariantSpec 0) 0))

(define (tc-stdlib-variant-spec-cons
  [name : i64]
  [payloads : TcStdlibTypeSpecList]
  [rest : TcStdlibVariantSpecList]) : TcStdlibVariantSpecList
  (let
    [n : i64 rest.len]
    [src : (__tl_dyn-array TcStdlibVariantSpec) rest.slots]
    [slots : (__tl_dyn-array TcStdlibVariantSpec)
      (__tl_make-array TcStdlibVariantSpec (+ n 1))]
    [i : i64 0]
    (begin
      (cfg
        compile-profile
        (counters.bump! tc-profile-layout-stdlib-variant-spec-builds))
      (set! (array-ref slots 0) (TcStdlibVariantSpec.Spec name payloads))
      (while (< i n)
        (set! (array-ref slots (+ i 1)) (array-ref src i))
        (set! i (+ i 1)))
      (TcStdlibVariantSpecList slots (+ n 1)))))

(define (tc-stdlib-well-known-mismatch [type-name : String] [detail : String]) : ResultTcUnit
  (Err
    (str_cat.str-cat
      (cdiag.compiler-diagnostic-typecheck-tag (TypeMismatch))
      "typecheck: stdlib well-known type mismatch for "
      (tc-stdlib-comptime-type-display-name type-name)
      ": "
      detail)))

(define (tc-stdlib-comptime-plain-declaration-message) : String
  "expected plain stdlib.comptime well-known declaration")

(define (tc-stdlib-comptime-well-known-type? [type-name : (& type-name str)]) : bool
  (or
    (string.eq type-name "Expr")
    (string.eq type-name "ExprList")
    (string.eq type-name "ExprClause")
    (string.eq type-name "ExprClauseList")
    (string.eq type-name "ExprBindingClause")
    (string.eq type-name "ExprBindingClauseList")
    (string.eq type-name "Pattern")
    (string.eq type-name "PatternList")
    (string.eq type-name "MatchArm")
    (string.eq type-name "MatchArmList")
    (string.eq type-name "TypeInfo")
    (string.eq type-name "TypeInfoList")
    (string.eq type-name "TypeField")
    (string.eq type-name "TypeFieldList")
    (string.eq type-name "TypeVariantPayload")
    (string.eq type-name "TypeVariantPayloadList")
    (string.eq type-name "TypeVariant")
    (string.eq type-name "TypeVariantList")
    (string.eq type-name "TypeParam")
    (string.eq type-name "TypeParamList")))

(define (tc-stdlib-comptime-raw-type-name [decl : ast.AstDecl]) : TcMaybeString
  (match decl
    [(Unsafe inner-box)
      (tc-stdlib-comptime-raw-type-name
        (ast.ast-decl-box-shared-view inner-box))]
    [(or (DefEnum _ name _ _) (DefEnumLifetimes _ name _ _ _)
         (DefStruct _ name _ _ _) (DefStructLifetimes _ name _ _ _ _))
      (Some (tc-env-key-name-text name))]
    [_ (No)]))

(define (tc-stdlib-comptime-raw-comptime-decl? [decl : ast.AstDecl]) : bool
  (ast.ast-decl-comptime-only? decl))

(define (tc-stdlib-check-comptime-declaration-surface-decl
  [module : (& module str)]
  [decl : ast.AstDecl]) : ResultTcUnit
  (if (not (string.eq module (tc-stdlib-comptime-module-name)))
    Ok
    (match (tc-stdlib-comptime-raw-type-name (tc-global-shared-view decl))
      [(No) Ok]
      [(Some type-name)
        (if (tc-stdlib-comptime-raw-comptime-decl? decl)
          (if (tc-stdlib-comptime-well-known-type? type-name)
            (tc-stdlib-well-known-mismatch
              type-name
              (tc-stdlib-comptime-plain-declaration-message))
            Ok)
          Ok)])))

;; Index cursor rather than `ast-decl-list-step`; the first `Err` still stops
;; the walk, now through `ok` instead of by not recursing.
(define (tc-stdlib-check-comptime-declaration-surface-list
  [decls : ast.AstDeclList]
  [module : String]) : ResultTcUnit
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
    [decl-offset : i64 decls.offset]
    [index : i64 0]
    [current-module : String module]
    [message : String ""]
    [ok : bool true]
    (while (and ok (< index count))
      (let
        [decl : ast.AstDecl
          (ast.ast-array-shared-view decl-slots (+ decl-offset index))]
        (match (tc-global-shared-view decl)
          [(Module module-id)
            (set! current-module (tc-env-key-name-text module-id))]
          [_
            (match (tc-stdlib-check-comptime-declaration-surface-decl
              current-module
              decl)
              [(Ok) unit]
              [(Err step-message)
                (set! message step-message)
                (set! ok false)])])
        (set! index (+ index 1))))
    (if ok
      Ok
      (Err message))))

(define (tc-stdlib-check-comptime-declaration-surface [ctx : TcContext]) : ResultTcUnit
  (match (tc-context-program ctx)
    [(Program decls-box)
      (tc-stdlib-check-comptime-declaration-surface-list
        (ast.ast-decl-list-box-shared-view decls-box)
        "")]))

(define (tc-stdlib-type-normalize-name [ctx : TcContext] [ty : ast.AstType]) : ast.AstType
  (match (tc-global-shared-view ty)
    [(Var name)
      (tc-resolve-type-name
        ctx
        (tc-hygiene-name-text-id-for-session
          (tc-context-structural-session ctx)
          name)
        name)]
    [_ ty]))

(define (tc-stdlib-type-match-normalized?
  [ctx : TcContext]
  [actual : ast.AstType]
  [expected : ast.AstType]) : bool
  (match actual
    [(I64)
      (match expected
        [(I64) true]
        [_ false])]
    [(I32)
      (match expected
        [(I32) true]
        [_ false])]
    [(Bool)
      (match expected
        [(Bool) true]
        [_ false])]
    [(String)
      (match expected
        [(String) true]
        [_ false])]
    [(Expr)
      (match expected
        [(Expr) true]
        [_ false])]
    [(ExprList)
      (match expected
        [(ExprList) true]
        [_ false])]
    [(Box actual-inner)
      (match expected
        [(Box expected-inner)
          (tc-stdlib-type-match?
            ctx
            (tc-context-type-get ctx actual-inner)
            (ast.ty-node-get expected-inner))]
        [_ false])]
    [(DynArray actual-inner)
      (match expected
        [(DynArray expected-inner)
          (tc-stdlib-type-match?
            ctx
            (tc-context-type-get ctx actual-inner)
            (ast.ty-node-get expected-inner))]
        [_ false])]
    [(Struct actual-name)
      (match expected
        [(Struct expected-name)
          (tc-nominal-name-id-eq? actual-name expected-name)]
        [_ false])]
    [(Enum actual-name)
      (match expected
        [(Enum expected-name)
          (tc-nominal-name-id-eq? actual-name expected-name)]
        [_ false])]
    [(Var actual-name)
      (match expected
        [(Var expected-name) (tc-nominal-name-id-eq? actual-name expected-name)]
        [_ false])]
    [_ false]))

(define (tc-stdlib-type-match?
  [ctx : TcContext]
  [actual : ast.AstType]
  [expected : ast.AstType]) : bool
  (let
    [normalized-actual : ast.AstType (tc-stdlib-type-normalize-name ctx actual)]
    [normalized-expected : ast.AstType
      (tc-stdlib-type-normalize-name ctx expected)]
    (tc-stdlib-type-match-normalized? ctx normalized-actual normalized-expected)))

(define (tc-stdlib-type-name-match?
  [ctx : TcContext]
  [actual : ast.AstType]
  [name : i64]) : bool
  (tc-stdlib-type-match? ctx actual (Var name)))

(define (tc-stdlib-type-spec-match?
  [ctx : TcContext]
  [actual : ast.AstType]
  [expected : TcStdlibTypeSpec]) : bool
  (match expected
    [(I64)
      (match actual
        [(I64) true]
        [_ false])]
    [(Bool)
      (match actual
        [(Bool) true]
        [_ false])]
    [(String)
      (match actual
        [(String) true]
        [_ false])]
    [(Name name) (tc-stdlib-type-name-match? ctx actual name)]
    [(BoxName name)
      (match actual
        [(Box inner)
          (tc-stdlib-type-name-match? ctx (tc-context-type-get ctx inner) name)]
        [_ false])]
    [(ArrayName name)
      (match actual
        [(DynArray inner)
          (tc-stdlib-type-name-match? ctx (tc-context-type-get ctx inner) name)]
        [_ false])]))

(define (tc-stdlib-type-spec-render
  [ctx : TcContext]
  [expected : TcStdlibTypeSpec]) : String
  (match expected
    [(I64) "i64"]
    [(Bool) "bool"]
    [(String) "String"]
    [(Name name)
      (tc-env-key-name-text-for-session
        (tc-context-structural-session ctx)
        name)]
    [(BoxName name)
      (str_cat.str-cat
        "(Box "
        (tc-env-key-name-text-for-session
          (tc-context-structural-session ctx)
          name)
        ")")]
    [(ArrayName name)
      (str_cat.str-cat
        "(__tl_dyn-array "
        (tc-env-key-name-text-for-session
          (tc-context-structural-session ctx)
          name)
        ")")]))

(define (tc-stdlib-check-field-specs
  [ctx : TcContext]
  [type-name : String]
  [fields : ast.AstFieldDefList]
  [specs : TcStdlibFieldSpecList]
  [index : i64]) : ResultTcUnit
  (if (>= index specs.len)
    (if (>= index fields.len)
      Ok
      (tc-stdlib-well-known-mismatch type-name "unexpected extra field"))
    (match (array-ref specs.slots index)
      [(Spec expected-name expected-ty)
        (let
          [expected-name-text : String (ci.intern-str expected-name)]
          (begin
            (cfg
              compile-profile
              (counters.bump! tc-profile-layout-stdlib-field-spec-visits))
            (if (>= index fields.len)
              (tc-stdlib-well-known-mismatch
                type-name
                (str_cat.str-cat "missing field " expected-name-text))
              (match (ast.ast-field-def-list-get
                (& fields)
                index
                (ast.ast-field-def-fallback))
                [(Def actual-name actual-ty _)
                  (cond
                    [(not
                        (=
                          (ci.intern-syntax-id-value actual-name)
                          expected-name))
                      (tc-stdlib-well-known-mismatch
                        type-name
                        (str_cat.str-cat
                          "expected field "
                          expected-name-text
                          " at index "
                          (string.int->string index)))]
                    [(tc-stdlib-type-spec-match? ctx actual-ty expected-ty)
                      (tc-stdlib-check-field-specs
                        ctx
                        type-name
                        fields
                        specs
                        (+ index 1))]
                    [else
                      (tc-stdlib-well-known-mismatch
                        type-name
                        (str_cat.str-cat
                          "expected field "
                          expected-name-text
                          " type "
                          (tc-stdlib-type-spec-render ctx expected-ty)))])]))))])))

(define (tc-stdlib-check-payload-specs
  [ctx : TcContext]
  [type-name : String]
  [variant-name : String]
  [actual : ast.AstTypeList]
  [expected : TcStdlibTypeSpecList]
  [index : i64]) : ResultTcUnit
  (if (>= index expected.len)
    (if (>= index (ast.ast-type-list-len (& actual)))
      Ok
      (tc-stdlib-well-known-mismatch
        type-name
        (str_cat.str-cat "payload arity mismatch for variant " variant-name)))
    (if (>= index (ast.ast-type-list-len (& actual)))
      (tc-stdlib-well-known-mismatch
        type-name
        (str_cat.str-cat "payload arity mismatch for variant " variant-name))
      (let
        [actual-id : i64
          (ast.ast-type-list-get (& actual) index (ast.ast-type-id-fallback))]
        [actual-ty : ast.AstType (tc-context-type-get ctx actual-id)]
        [expected-ty : TcStdlibTypeSpec (array-ref expected.slots index)]
        (if (tc-stdlib-type-spec-match? ctx actual-ty expected-ty)
          (tc-stdlib-check-payload-specs
            ctx
            type-name
            variant-name
            actual
            expected
            (+ index 1))
          (tc-stdlib-well-known-mismatch
            type-name
            (str_cat.str-cat
              "payload type mismatch for variant "
              variant-name
              " at index "
              (string.int->string index))))))))

(define (tc-stdlib-check-variant-specs
  [ctx : TcContext]
  [type-name : String]
  [variants : ast.AstVariantDefList]
  [specs : TcStdlibVariantSpecList]
  [index : i64]) : ResultTcUnit
  (if (>= index specs.len)
    (if (>= index variants.len)
      Ok
      (tc-stdlib-well-known-mismatch type-name "unexpected extra variant"))
    (match (array-ref specs.slots index)
      [(Spec expected-name expected-payloads)
        (let
          [expected-name-text : String (ci.intern-str expected-name)]
          (begin
            (cfg
              compile-profile
              (counters.bump! tc-profile-layout-stdlib-variant-spec-visits))
            (if (>= index variants.len)
              (tc-stdlib-well-known-mismatch
                type-name
                (str_cat.str-cat "missing variant " expected-name-text))
              (let
                [variant : ast.AstVariantDef
                  (ast.ast-variant-def-list-get
                    (& variants)
                    index
                    (ast.ast-variant-def-fallback))]
                (match variant
                  [(Def actual-name actual-payloads _)
                    (if (not (= actual-name expected-name))
                      (tc-stdlib-well-known-mismatch
                        type-name
                        (str_cat.str-cat
                          "expected variant "
                          expected-name-text
                          " at index "
                          (string.int->string index)))
                      (let
                        [_
                          (try
                            (tc-stdlib-check-payload-specs
                              ctx
                              (string.copy (& type-name))
                              expected-name-text
                              actual-payloads
                              expected-payloads
                              0))]
                        (tc-stdlib-check-variant-specs
                          ctx
                          type-name
                          variants
                          specs
                          (+ index 1))))])))))])))

(define (tc-stdlib-check-struct
  [ctx : TcContext]
  [type-name : String]
  [type-name-id : i64]
  [specs : TcStdlibFieldSpecList]) : ResultTcUnit
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-type-in-module-id-or
        (tc-context-symbols ctx)
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime
        type-name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (match (csym.compiler-symbols-decl-at-index
        (tc-context-symbols ctx)
        (csym.compiler-symbol-handle-index handle))
        [(Ok decl)
          (match decl
            [(DefStruct decl-meta _ _ _ fields)
              (tc-stdlib-check-field-specs
                (tc-context-with-module-id
                  ctx
                  (tc-stdlib-comptime-module-name)
                  cbi.compiler-builtin-id-fix-stdlib_dot_comptime)
                type-name
                fields
                specs
                0)]
            [_ (tc-stdlib-well-known-mismatch type-name "expected defstruct")])]
        [(Err message) (tc-stdlib-well-known-mismatch type-name message)])
      (tc-stdlib-well-known-mismatch type-name "missing declaration"))))

(define (tc-stdlib-check-enum
  [ctx : TcContext]
  [type-name : String]
  [type-name-id : i64]
  [specs : TcStdlibVariantSpecList]) : ResultTcUnit
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-type-in-module-id-or
        (tc-context-symbols ctx)
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime
        type-name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (match (csym.compiler-symbols-decl-at-index
        (tc-context-symbols ctx)
        (csym.compiler-symbol-handle-index handle))
        [(Ok decl)
          (match decl
            [(DefEnum decl-meta _ _ variants)
              (tc-stdlib-check-variant-specs
                (tc-context-with-module-id
                  ctx
                  (tc-stdlib-comptime-module-name)
                  cbi.compiler-builtin-id-fix-stdlib_dot_comptime)
                type-name
                variants
                specs
                0)]
            [_ (tc-stdlib-well-known-mismatch type-name "expected defenum")])]
        [(Err message) (tc-stdlib-well-known-mismatch type-name message)])
      (tc-stdlib-well-known-mismatch type-name "missing declaration"))))

(define (tc-stdlib-comptime-present? [ctx : TcContext]) : bool
  (let
    [symbols (tc-context-symbols ctx)]
    (or
      (csym.compiler-symbols-handle-found?
        (csym.compiler-symbols-lookup-type-in-module-id-or
          symbols
          cbi.compiler-builtin-id-fix-stdlib_dot_comptime
          cbi.compiler-builtin-id-fix-Expr
          (csym.compiler-symbols-missing-handle)))
      (csym.compiler-symbols-handle-found?
        (csym.compiler-symbols-lookup-type-in-module-id-or
          symbols
          cbi.compiler-builtin-id-fix-stdlib_dot_comptime
          cbi.compiler-builtin-id-fix-TypeInfo
          (csym.compiler-symbols-missing-handle))))))

(define (tc-stdlib-expr-specs [_ctx : TcContext]) : TcStdlibVariantSpecList
  (tc-stdlib-variant-spec-cons
    cbi.compiler-builtin-id-comptime-expr-bool-variant
    (tc-stdlib-type-spec-list1 (Bool))
    (tc-stdlib-variant-spec-cons
      cbi.compiler-builtin-id-comptime-expr-int-variant
      (tc-stdlib-type-spec-list1 (I64))
      (tc-stdlib-variant-spec-cons
        cbi.compiler-builtin-id-comptime-expr-var-variant
        (tc-stdlib-type-spec-list1 (String))
        (tc-stdlib-variant-spec-cons
          cbi.compiler-builtin-id-comptime-expr-splice-variant
          (tc-stdlib-type-spec-list1 (BoxName cbi.compiler-builtin-id-fix-Expr))
          (tc-stdlib-variant-spec-cons
            cbi.compiler-builtin-id-comptime-expr-if-variant
            (tc-stdlib-type-spec-list3
              (BoxName cbi.compiler-builtin-id-fix-Expr)
              (BoxName cbi.compiler-builtin-id-fix-Expr)
              (BoxName cbi.compiler-builtin-id-fix-Expr))
            (tc-stdlib-variant-spec-cons
              cbi.compiler-builtin-id-comptime-expr-call-variant
              (tc-stdlib-type-spec-list2
                (BoxName cbi.compiler-builtin-id-fix-Expr)
                (Name cbi.compiler-builtin-id-fix-ExprList))
              (tc-stdlib-variant-spec-cons
                cbi.compiler-builtin-id-comptime-expr-begin-variant
                (tc-stdlib-type-spec-list1
                  (Name cbi.compiler-builtin-id-fix-ExprList))
                (tc-stdlib-variant-spec-cons
                  cbi.compiler-builtin-id-comptime-expr-quote-variant
                  (tc-stdlib-type-spec-list1
                    (BoxName cbi.compiler-builtin-id-fix-Expr))
                  (tc-stdlib-variant-spec-cons
                    cbi.compiler-builtin-id-comptime-expr-quasiquote-variant
                    (tc-stdlib-type-spec-list1
                      (BoxName cbi.compiler-builtin-id-fix-Expr))
                    (tc-stdlib-variant-spec-cons
                      cbi.compiler-builtin-id-comptime-expr-unquote-variant
                      (tc-stdlib-type-spec-list1
                        (BoxName cbi.compiler-builtin-id-fix-Expr))
                      (tc-stdlib-variant-spec-cons
                        cbi.compiler-builtin-id-comptime-expr-unquote-splicing-variant
                        (tc-stdlib-type-spec-list1
                          (BoxName cbi.compiler-builtin-id-fix-Expr))
                        (tc-stdlib-variant-spec-nil)))))))))))))

(define (tc-stdlib-sequence-fields [_ctx : TcContext] [elem-name : i64]) : TcStdlibFieldSpecList
  (tc-stdlib-field-spec-cons
    cbi.compiler-builtin-id-fix-items
    (ArrayName elem-name)
    (tc-stdlib-field-spec-cons
      cbi.compiler-builtin-id-fix-len
      (I64)
      (tc-stdlib-field-spec-nil))))

(define (tc-stdlib-pattern-specs [_ctx : TcContext]) : TcStdlibVariantSpecList
  (tc-stdlib-variant-spec-cons
    cbi.compiler-builtin-id-comptime-pattern-wildcard-variant
    (tc-stdlib-type-spec-list0)
    (tc-stdlib-variant-spec-cons
      cbi.compiler-builtin-id-comptime-pattern-binding-variant
      (tc-stdlib-type-spec-list1 (String))
      (tc-stdlib-variant-spec-cons
        cbi.compiler-builtin-id-comptime-pattern-variant-variant
        (tc-stdlib-type-spec-list2
          (String)
          (Name cbi.compiler-builtin-id-fix-PatternList))
        (tc-stdlib-variant-spec-nil)))))

(define (tc-stdlib-match-arm-fields) : TcStdlibFieldSpecList
  (tc-stdlib-field-spec-cons
    cbi.compiler-builtin-id-fix-pattern
    (Name cbi.compiler-builtin-id-fix-Pattern)
    (tc-stdlib-field-spec-cons
      cbi.compiler-builtin-id-fix-body
      (Name cbi.compiler-builtin-id-fix-Expr)
      (tc-stdlib-field-spec-nil))))

(define (tc-stdlib-type-info-specs [_ctx : TcContext]) : TcStdlibVariantSpecList
  (tc-stdlib-variant-spec-cons
    cbi.compiler-builtin-id-comptime-type-info-builtin-variant
    (tc-stdlib-type-spec-list1 (String))
    (tc-stdlib-variant-spec-cons
      cbi.compiler-builtin-id-comptime-type-info-array-variant
      (tc-stdlib-type-spec-list2
        (BoxName cbi.compiler-builtin-id-fix-TypeInfo)
        (I64))
      (tc-stdlib-variant-spec-cons
        cbi.compiler-builtin-id-comptime-type-info-dyn-array-variant
        (tc-stdlib-type-spec-list1
          (BoxName cbi.compiler-builtin-id-fix-TypeInfo))
        (tc-stdlib-variant-spec-cons
          cbi.compiler-builtin-id-comptime-type-info-function-variant
          (tc-stdlib-type-spec-list2
            (Name cbi.compiler-builtin-id-fix-TypeInfoList)
            (BoxName cbi.compiler-builtin-id-fix-TypeInfo))
          (tc-stdlib-variant-spec-cons
            cbi.compiler-builtin-id-comptime-type-info-tuple-variant
            (tc-stdlib-type-spec-list1
              (Name cbi.compiler-builtin-id-fix-TypeInfoList))
            (tc-stdlib-variant-spec-cons
              cbi.compiler-builtin-id-comptime-type-info-struct-variant
              (tc-stdlib-type-spec-list2
                (String)
                (Name cbi.compiler-builtin-id-fix-TypeFieldList))
              (tc-stdlib-variant-spec-cons
                cbi.compiler-builtin-id-comptime-type-info-enum-variant
                (tc-stdlib-type-spec-list2
                  (String)
                  (Name cbi.compiler-builtin-id-fix-TypeVariantList))
                (tc-stdlib-variant-spec-cons
                  cbi.compiler-builtin-id-comptime-type-info-opaque-variant
                  (tc-stdlib-type-spec-list1 (String))
                  (tc-stdlib-variant-spec-cons
                    cbi.compiler-builtin-id-comptime-type-info-slice-variant
                    (tc-stdlib-type-spec-list1
                      (BoxName cbi.compiler-builtin-id-fix-TypeInfo))
                    (tc-stdlib-variant-spec-nil)))))))))))

(define (tc-stdlib-comptime-surface-step
  [current : ResultTcUnit]
  [next : ResultTcUnit]) : ResultTcUnit
  (match (& current)
    [(Ok) next]
    [(Err _) current]))

(define (tc-stdlib-expr-clause-fields) : TcStdlibFieldSpecList
  (tc-stdlib-field-spec-cons
    cbi.compiler-builtin-id-fix-first
    (Name cbi.compiler-builtin-id-fix-Expr)
    (tc-stdlib-field-spec-cons
      cbi.compiler-builtin-id-fix-second
      (Name cbi.compiler-builtin-id-fix-Expr)
      (tc-stdlib-field-spec-nil))))

(define (tc-stdlib-expr-binding-clause-fields) : TcStdlibFieldSpecList
  (tc-stdlib-field-spec-cons
    cbi.compiler-builtin-id-fix-name
    (String)
    (tc-stdlib-field-spec-cons
      cbi.compiler-builtin-id-fix-has_type
      (Bool)
      (tc-stdlib-field-spec-cons
        cbi.compiler-builtin-id-fix-ty
        (Name cbi.compiler-builtin-id-fix-Expr)
        (tc-stdlib-field-spec-cons
          cbi.compiler-builtin-id-fix-init
          (Name cbi.compiler-builtin-id-fix-Expr)
          (tc-stdlib-field-spec-nil))))))

(define (tc-stdlib-type-field-fields) : TcStdlibFieldSpecList
  (tc-stdlib-field-spec-cons
    cbi.compiler-builtin-id-fix-name
    (String)
    (tc-stdlib-field-spec-cons
      cbi.compiler-builtin-id-fix-ty
      (Name cbi.compiler-builtin-id-fix-TypeInfo)
      (tc-stdlib-field-spec-nil))))

(define (tc-stdlib-type-variant-payload-fields) : TcStdlibFieldSpecList
  (tc-stdlib-field-spec-cons
    cbi.compiler-builtin-id-fix-ty
    (Name cbi.compiler-builtin-id-fix-TypeInfo)
    (tc-stdlib-field-spec-nil)))

(define (tc-stdlib-type-variant-fields) : TcStdlibFieldSpecList
  (tc-stdlib-field-spec-cons
    cbi.compiler-builtin-id-fix-name
    (String)
    (tc-stdlib-field-spec-cons
      cbi.compiler-builtin-id-fix-payloads
      (Name cbi.compiler-builtin-id-fix-TypeVariantPayloadList)
      (tc-stdlib-field-spec-nil))))

(define (tc-stdlib-type-param-fields) : TcStdlibFieldSpecList
  (tc-stdlib-field-spec-cons
    cbi.compiler-builtin-id-fix-name
    (String)
    (tc-stdlib-field-spec-cons
      cbi.compiler-builtin-id-fix-ty
      (Name cbi.compiler-builtin-id-fix-TypeInfo)
      (tc-stdlib-field-spec-nil))))

(define (tc-stdlib-comptime-surface-ok-impl [ctx : TcContext]) : ResultTcUnit
  (if (not (tc-stdlib-comptime-present? ctx))
    Ok
    (let
      [result : ResultTcUnit (tc-stdlib-check-comptime-declaration-surface ctx)]
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-enum
            ctx
            "Expr"
            cbi.compiler-builtin-id-fix-Expr
            (tc-stdlib-expr-specs ctx))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "ExprList"
            cbi.compiler-builtin-id-fix-ExprList
            (tc-stdlib-sequence-fields ctx cbi.compiler-builtin-id-fix-Expr))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "ExprClause"
            cbi.compiler-builtin-id-fix-ExprClause
            (tc-stdlib-expr-clause-fields))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "ExprClauseList"
            cbi.compiler-builtin-id-fix-ExprClauseList
            (tc-stdlib-sequence-fields
              ctx
              cbi.compiler-builtin-id-fix-ExprClause))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "ExprBindingClause"
            cbi.compiler-builtin-id-fix-ExprBindingClause
            (tc-stdlib-expr-binding-clause-fields))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "ExprBindingClauseList"
            cbi.compiler-builtin-id-fix-ExprBindingClauseList
            (tc-stdlib-sequence-fields
              ctx
              cbi.compiler-builtin-id-fix-ExprBindingClause))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-enum
            ctx
            "Pattern"
            cbi.compiler-builtin-id-fix-Pattern
            (tc-stdlib-pattern-specs ctx))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "PatternList"
            cbi.compiler-builtin-id-fix-PatternList
            (tc-stdlib-sequence-fields ctx cbi.compiler-builtin-id-fix-Pattern))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "MatchArm"
            cbi.compiler-builtin-id-fix-MatchArm
            (tc-stdlib-match-arm-fields))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "MatchArmList"
            cbi.compiler-builtin-id-fix-MatchArmList
            (tc-stdlib-sequence-fields ctx cbi.compiler-builtin-id-fix-MatchArm))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "TypeInfoList"
            cbi.compiler-builtin-id-fix-TypeInfoList
            (tc-stdlib-sequence-fields ctx cbi.compiler-builtin-id-fix-TypeInfo))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "TypeField"
            cbi.compiler-builtin-id-fix-TypeField
            (tc-stdlib-type-field-fields))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "TypeFieldList"
            cbi.compiler-builtin-id-fix-TypeFieldList
            (tc-stdlib-sequence-fields
              ctx
              cbi.compiler-builtin-id-fix-TypeField))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "TypeVariantPayload"
            cbi.compiler-builtin-id-fix-TypeVariantPayload
            (tc-stdlib-type-variant-payload-fields))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "TypeVariantPayloadList"
            cbi.compiler-builtin-id-fix-TypeVariantPayloadList
            (tc-stdlib-sequence-fields
              ctx
              cbi.compiler-builtin-id-fix-TypeVariantPayload))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "TypeVariant"
            cbi.compiler-builtin-id-fix-TypeVariant
            (tc-stdlib-type-variant-fields))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "TypeVariantList"
            cbi.compiler-builtin-id-fix-TypeVariantList
            (tc-stdlib-sequence-fields
              ctx
              cbi.compiler-builtin-id-fix-TypeVariant))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "TypeParam"
            cbi.compiler-builtin-id-fix-TypeParam
            (tc-stdlib-type-param-fields))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "TypeParamList"
            cbi.compiler-builtin-id-fix-TypeParamList
            (tc-stdlib-sequence-fields
              ctx
              cbi.compiler-builtin-id-fix-TypeParam))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-enum
            ctx
            "TypeInfo"
            cbi.compiler-builtin-id-fix-TypeInfo
            (tc-stdlib-type-info-specs ctx))))
      result)))

(define (tc-stdlib-comptime-surface-ok [ctx : TcContext]) : ResultTcUnit
  (let
    [prev : ast.AstNodePoolContext (ast.ast-node-pool-context-capture-active)]
    [_install : unit (tc-context-install-pools! ctx)]
    ;; The well-known spec builder pushes fresh type nodes (e.g. the
    ;; `(Box Expr)` payload of Expr.Splice) into this context's type-node pool.
    ;; In a long-lived `test --check --batch` process the captured pool snapshot
    ;; inherits a dedup index whose entries can point at slot ids that a later
    ;; batch entry's nodes now occupy, so a deduped spec push would resolve to a
    ;; slot holding an unrelated node and the well-known compare spuriously
    ;; mismatches. Drop the dedup index here (no live nodes are truncated) so
    ;; spec pushes rebuild it against the current entry's nodes only.
    [_dedup : unit
      (ast.ast-node-pool-context-type-dedup-clear! (tc-context-pools ctx))]
    [result : ResultTcUnit (tc-stdlib-comptime-surface-ok-impl ctx)]
    (tc-install-pools! prev)
    result))

(define (tc-stdlib-comptime-macro-surface-ok-reset! [state : TcMacroState]) : unit
  (unsafe
    (set! (deref (tc-macro-helper-state-ptr state)).stdlib-surface-ready false)))

(define (tc-stdlib-comptime-surface-ok-for-macro [ctx : TcContext]) : ResultTcUnit
  (let
    [state : TcMacroState (tc-context-macro-state ctx)]
    [cache : (MutPtr TcMacroHelperStateData) (tc-macro-helper-state-ptr state)]
    (unsafe
      (if (deref cache).stdlib-surface-ready
        Ok
        (let
          [_ (try (tc-stdlib-comptime-surface-ok ctx))]
          (if (tc-stdlib-comptime-present? ctx)
            (set! (deref cache).stdlib-surface-ready true)
            unit)
          Ok)))))

(define (tc-bind-comptime-helper-aliases
  [env : TcTypeEnv]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnv
  ;; Qualified `stdlib.comptime` helper calls are normalized to the legacy
  ;; helper key in name lookup. Keep one compatibility binding instead of
  ;; growing every macro helper environment with duplicate qualified aliases.
  (if (tc-source-name-bound-exact-id? env name-id)
    env
    (tc-bind-id env name-id ty)))

;; The legacy unqualified macro helper signatures. New stdlib macro code
;; imports `stdlib.comptime` and calls the public helpers via that module; keep
;; only the old names still covered by compatibility tests and by the legacy
;; type-query surface.
;;
;; Row k binds builtin slot k of `tc-macro-helper-slots` to the k-th
;; `|`-terminated code of `tc-macro-helper-signatures`: a binder (`i` binds the
;; id, `a` also its comptime helper aliases), then one type per parameter and
;; the result type, each one character of `tc-macro-helper-type-codes`. A table
;; instead of one binding call per row keeps this cold, cached setup small.
