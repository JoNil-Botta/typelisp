(define (tc-checked-let-binding-fact-state-ptr
  [state : TcCheckedLetBindingFactState]) : (MutPtr
    TcCheckedLetBindingFactStateData)
  (tc-state-cell-ptr state.address TcCheckedLetBindingFactStateData))

(define (tc-checked-let-binding-fact-state-view
  [state : TcCheckedLetBindingFactState]) : (Ptr
    TcCheckedLetBindingFactStateData)
  (tc-state-cell-view state.address TcCheckedLetBindingFactStateData))

(define (tc-checked-let-binding-fact-state-data
  [state : TcCheckedLetBindingFactState]) : TcCheckedLetBindingFactStateData
  (tc-state-cell-read state.address TcCheckedLetBindingFactStateData))

(define (tc-checked-let-binding-fact-state-data-set!
  [state : TcCheckedLetBindingFactState]
  [data : TcCheckedLetBindingFactStateData]) : unit
  (tc-state-cell-write! state.address TcCheckedLetBindingFactStateData data))

(define (tc-checked-let-binding-key-hash
  [declaration-ordinal : i64]
  [body-id : i64]
  [binding-ordinal : i64]
  [name-id : i64]
  [init-id : i64]) : i64
  (hash.combine
    (hash.combine
      (hash.combine
        (hash.combine (hash.i64 declaration-ordinal) (hash.i64 body-id))
        (hash.i64 binding-ordinal))
      (hash.i64 name-id))
    (hash.i64 init-id)))

(define (tc-checked-let-binding-fact-key-eq?
  [fact : (& fact TcCheckedLetBindingFact)]
  [declaration-ordinal : i64]
  [body-id : i64]
  [binding-ordinal : i64]
  [name-id : i64]
  [init-id : i64]) : bool
  (and
    (= fact.declaration-ordinal declaration-ordinal)
    (= fact.body-id body-id)
    (= fact.binding-ordinal binding-ordinal)
    (= fact.name-id name-id)
    (= fact.init-id init-id)))

(define (tc-checked-let-binding-transition-eq?
  [left : TcCheckedLetBindingTransition]
  [right : TcCheckedLetBindingTransition]) : bool
  (and
    (= left.arena-owner-kind right.arena-owner-kind)
    (= left.phase-owner-id right.phase-owner-id)))

(define (tc-checked-let-binding-fact-state-release-storage!
  [state : TcCheckedLetBindingFactState]) : unit
  (unsafe
    (let
      [data : (MutPtr TcCheckedLetBindingFactStateData)
        (tc-checked-let-binding-fact-state-ptr state)]
      [payload : i64 (deref data).payload-arena]
      (if (= payload 0)
        (begin
          (set! (deref data).enabled false)
          (set! (deref data).complete-required false)
          (set! (deref data).recording false)
          (set! (deref data).current-declaration-ordinal -1)
          (set! (deref data).len 0))
        (begin
          (if (= (arena.tl_arena_current) payload)
            (arena.tl_arena_set (deref data).return-arena)
            unit)
          ;; Detach every payload-owned carrier before destroying the generation.
          (in-arena
            (arena.Arena (deref data).owner-arena)
            (set!
              (deref data).facts
              (__tl_make-array TcCheckedLetBindingFact 0))
            (set! (deref data).by-hash (tc_i64_i64_map.with-capacity 1))
            (set!
              (deref data).declaration-ordinals
              (tc_i64_i64_map.with-capacity 1)))
          (set! (deref data).enabled false)
          (set! (deref data).complete-required false)
          (set! (deref data).recording false)
          (set! (deref data).current-declaration-ordinal -1)
          (set! (deref data).capacity 0)
          (set! (deref data).len 0)
          (set! (deref data).payload-arena 0)
          (set! (deref data).return-arena 0)
          (arena.tl_arena_destroy payload))))))

(define (tc-checked-let-binding-facts-begin!
  [state : TcCheckedLetBindingFactState]
  [complete-required : bool]) : unit
  (tc-checked-let-binding-fact-state-release-storage! state)
  (let
    [return-arena : i64 (arena.tl_arena_current)]
    [payload : i64 (arena.tl_arena_make)]
    (in-arena
      (unsafe
        (arena.Arena payload))
      (let
        [data : (MutPtr TcCheckedLetBindingFactStateData)
          (tc-checked-let-binding-fact-state-ptr state)]
        (unsafe
          (set! (deref data).enabled true)
          (set! (deref data).complete-required complete-required)
          (set! (deref data).recording true)
          (set! (deref data).current-declaration-ordinal -1)
          (set! (deref data).facts (__tl_make-array TcCheckedLetBindingFact 64))
          (set! (deref data).capacity 64)
          (set! (deref data).len 0)
          (set! (deref data).by-hash (tc_i64_i64_map.with-capacity 128))
          (set!
            (deref data).declaration-ordinals
            (tc_i64_i64_map.with-capacity 128))
          (set! (deref data).payload-arena payload)
          (set! (deref data).return-arena return-arena))))))

(define (tc-checked-let-binding-facts-finish!
  [state : TcCheckedLetBindingFactState]) : unit
  (tc-checked-let-binding-fact-state-release-storage! state))

(define (tc-checked-let-binding-facts-enabled?
  [state : TcCheckedLetBindingFactState]) : bool
  (unsafe
    (deref (tc-checked-let-binding-fact-state-view state)).enabled))

;; Semantic indexing requires complete proofs. Lowering can infer missing
;; bindings, so retaining its proofs must not disable trusted surface hydration.
(define (tc-checked-let-binding-facts-complete-required?
  [state : TcCheckedLetBindingFactState]) : bool
  (let
    [data : TcCheckedLetBindingFactStateData
      (tc-checked-let-binding-fact-state-data state)]
    (and data.enabled data.complete-required)))

;; Recording grows the fact array and both maps by doubling inside the payload
;; generation, so every superseded copy stays there next to the live one.
;; Copy the live facts (exactly sized), their persisted types and both maps
;; into a fresh generation and destroy the old one; lowering then retains only
;; the proofs it may look up.
(define (tc-checked-let-binding-facts-compact!
  [state : TcCheckedLetBindingFactState]) : unit
  (let
    [data : TcCheckedLetBindingFactStateData
      (tc-checked-let-binding-fact-state-data state)]
    (unless
      (or (not data.enabled) (= data.payload-arena 0))
      (let
        [fresh : i64 (arena.tl_arena_make)]
        [compacted : TcCheckedLetBindingFactStateData
          (in-arena
            (unsafe
              (arena.Arena fresh))
            (let
              [count : i64 data.len]
              [facts : (__tl_dyn-array TcCheckedLetBindingFact)
                (__tl_make-array
                  TcCheckedLetBindingFact
                  (if (< count 1)
                    1
                    count))]
              (for [index (iterator.range 0 count)]
                (let
                  [fact (& (array-ref data.facts index))]
                  (set!
                    (array-ref facts index)
                    (TcCheckedLetBindingFact
                      fact.declaration-ordinal
                      fact.body-id
                      fact.binding-ordinal
                      fact.name-id
                      fact.init-id
                      (ast.ty-node-persist (& fact.binding-ty))
                      fact.inconsistent
                      (TcCheckedLetBindingTransition
                        fact.transition.arena-owner-kind
                        fact.transition.phase-owner-id)
                      fact.hash-next))))
              (TcCheckedLetBindingFactStateData
                data.enabled
                data.complete-required
                data.recording
                data.current-declaration-ordinal
                facts
                (if (< count 1)
                  1
                  count)
                count
                (clone data.by-hash)
                (clone data.declaration-ordinals)
                fresh
                data.return-arena
                data.owner-arena)))]
        (tc-checked-let-binding-fact-state-data-set! state compacted)
        (unsafe
          (arena.tl_arena_destroy data.payload-arena))))))

(define (tc-checked-let-binding-facts-freeze!
  [state : TcCheckedLetBindingFactState]) : unit
  (tc-checked-let-binding-facts-compact! state)
  (unsafe
    (let
      [data : (MutPtr TcCheckedLetBindingFactStateData)
        (tc-checked-let-binding-fact-state-ptr state)]
      (set! (deref data).recording false)
      (set! (deref data).current-declaration-ordinal -1))))

;; Declaration positions change when checked lowering prunes unreachable
;; declarations. Resolve the original ordinal from the source module/name;
;; an overloaded or repeated name is ambiguous and must use inference instead.
(define (tc-checked-let-binding-declaration-key
  [module-id : i64]
  [decl : (& decl ast.AstDecl)]) : i64
  (let
    [value : ast.AstDecl (owned_view.compiler-owned-reference-shared-view decl)]
    (match value
      [(DefFn _ name _ _ _ _)
        (csym.compiler-symbol-module-key-id-by-id module-id name)]
      [(Unsafe inner)
        (tc-checked-let-binding-declaration-key
          module-id
          (& (__tl-box-place inner)))]
      [_ -1])))

(define (tc-checked-let-binding-facts-record-declaration!
  [state : TcCheckedLetBindingFactState]
  [module-id : i64]
  [decl : (& decl ast.AstDecl)]) : unit
  (let
    [data : TcCheckedLetBindingFactStateData
      (tc-checked-let-binding-fact-state-data state)]
    (when
      (and data.enabled data.recording)
      (let
        [key : i64 (tc-checked-let-binding-declaration-key module-id decl)]
        (when
          (>= key 0)
          (let
            [ordinal : i64 data.current-declaration-ordinal]
            [value : i64
              (match (tc_i64_i64_map.get (& data.declaration-ordinals) key)
                [(LookupFound previous)
                  (if (= previous ordinal)
                    ordinal
                    -1)]
                [(LookupMissing) ordinal])]
            (in-arena
              (unsafe
                (arena.Arena data.payload-arena))
              (tc_i64_i64_map.insert-ref!
                (&mut data.declaration-ordinals)
                key
                value))
            (tc-checked-let-binding-fact-state-data-set! state data)))))))

(define (tc-checked-let-binding-facts-declaration-ordinal
  [state : TcCheckedLetBindingFactState]
  [module-id : i64]
  [decl : (& decl ast.AstDecl)]) : i64
  (let
    [data : TcCheckedLetBindingFactStateData
      (tc-checked-let-binding-fact-state-data state)]
    (if data.enabled
      (tc_i64_i64_map.get-value-or
        (& data.declaration-ordinals)
        (tc-checked-let-binding-declaration-key module-id decl)
        -1)
      -1)))

(define (tc-checked-let-binding-facts-set-current-declaration!
  [state : TcCheckedLetBindingFactState]
  [ordinal : i64]) : unit
  (let
    [data : (MutPtr TcCheckedLetBindingFactStateData)
      (tc-checked-let-binding-fact-state-ptr state)]
    (unsafe
      (if (deref data).enabled
        (set! (deref data).current-declaration-ordinal ordinal)
        unit))))

(define (tc-checked-let-binding-fact-grow!
  [state : TcCheckedLetBindingFactState]) : unit
  (unsafe
    (let
      [data : (MutPtr TcCheckedLetBindingFactStateData)
        (tc-checked-let-binding-fact-state-ptr state)]
      [old : (__tl_dyn-array TcCheckedLetBindingFact) (deref data).facts]
      [next-capacity : i64
        (if (< (deref data).capacity 1)
          64
          (* (deref data).capacity 2))]
      (in-arena
        (unsafe
          (arena.Arena (deref data).payload-arena))
        (let
          [next : (__tl_dyn-array TcCheckedLetBindingFact)
            (__tl_make-array TcCheckedLetBindingFact next-capacity)]
          [index : i64 0]
          (while (< index (deref data).len)
            (set!
              (array-ref next index)
              (owned_view.compiler-owned-element-view old index))
            (set! index (+ index 1)))
          (set! (deref data).facts next)
          (set! (deref data).capacity next-capacity))))))

(define (tc-checked-let-binding-fact-record!
  [state : TcCheckedLetBindingFactState]
  [body-id : i64]
  [binding-ordinal : i64]
  [name-id : i64]
  [init-id : i64]
  [binding-ty : ast.AstType]
  [transition : TcCheckedLetBindingTransition]) : unit
  (let
    [data : TcCheckedLetBindingFactStateData
      (tc-checked-let-binding-fact-state-data state)]
    [declaration-ordinal : i64 data.current-declaration-ordinal]
    (if (and data.enabled data.recording (>= declaration-ordinal 0))
      (let
        [key-hash : i64
          (tc-checked-let-binding-key-hash
            declaration-ordinal
            body-id
            binding-ordinal
            name-id
            init-id)]
        [head : i64 (tc_i64_i64_map.get-value-or (& data.by-hash) key-hash -1)]
        [cursor : i64 head]
        (while (>= cursor 0)
          (let
            [fact : TcCheckedLetBindingFact
              (tc-global-array-element-shared-view data.facts cursor)]
            (if (tc-checked-let-binding-fact-key-eq?
              fact
              declaration-ordinal
              body-id
              binding-ordinal
              name-id
              init-id)
              (begin
                ;; Repeated contextual checks are allowed only when they prove
                ;; the same final binding and transition.
                (unless
                  (and
                    ;; Proof identity includes allocation-region wrappers.
                    (ast.ast-type-eq? fact.binding-ty binding-ty)
                    (tc-checked-let-binding-transition-eq?
                      fact.transition
                      transition))
                  (set! (array-ref data.facts cursor).inconsistent true))
                (return unit))
              (set! cursor fact.hash-next))))
        (if (>= data.len data.capacity)
          (tc-checked-let-binding-fact-grow! state)
          unit)
        (let
          [ready : TcCheckedLetBindingFactStateData
            (tc-checked-let-binding-fact-state-data state)]
          [slot : i64 ready.len]
          [persisted : ast.AstType
            (in-arena
              (unsafe
                (arena.Arena ready.payload-arena))
              (ast.ty-node-persist (& binding-ty)))]
          (set!
            (array-ref ready.facts slot)
            (TcCheckedLetBindingFact
              declaration-ordinal
              body-id
              binding-ordinal
              name-id
              init-id
              persisted
              false
              transition
              head))
          ;; Hashmap growth allocates in the active arena. Force it into the
          ;; retained generation rather than the function/decl scratch that
          ;; happened to check this binding.
          (in-arena
            (unsafe
              (arena.Arena ready.payload-arena))
            (tc_i64_i64_map.insert-ref! (&mut ready.by-hash) key-hash slot))
          (set! ready.len (+ slot 1))
          (tc-checked-let-binding-fact-state-data-set! state ready)))
      unit)))

(define (tc-checked-let-binding-fact-lookup
  [state : TcCheckedLetBindingFactState]
  [declaration-ordinal : i64]
  [body-id : i64]
  [binding-ordinal : i64]
  [name-id : i64]
  [init-id : i64]) : TcMaybeCheckedLetBindingFact
  (let
    [data : TcCheckedLetBindingFactStateData
      (tc-checked-let-binding-fact-state-data state)]
    (if (not data.enabled)
      (Missing)
      (let
        [key-hash : i64
          (tc-checked-let-binding-key-hash
            declaration-ordinal
            body-id
            binding-ordinal
            name-id
            init-id)]
        [cursor : i64
          (tc_i64_i64_map.get-value-or (& data.by-hash) key-hash -1)]
        (while (>= cursor 0)
          (let
            [fact : TcCheckedLetBindingFact
              (tc-global-array-element-shared-view data.facts cursor)]
            (if (tc-checked-let-binding-fact-key-eq?
              fact
              declaration-ordinal
              body-id
              binding-ordinal
              name-id
              init-id)
              (return
                (if fact.inconsistent
                  (Inconsistent)
                  (Hit fact.binding-ty fact.transition)))
              (set! cursor fact.hash-next))))
        (Missing)))))

(define (tc-macro-call-site-state-enabled? [state : TcMacroCallSiteState]) : bool
  (unsafe
    (deref (tc-macro-call-site-state-view state)).enabled))

(define (tc-macro-call-site-state-set-enabled!
  [state : TcMacroCallSiteState]
  [enabled : bool]) : unit
  (unsafe
    (set! (deref (tc-macro-call-site-state-ptr state)).enabled enabled)))

(define (tc-topenv-membership-state-ptr [state : TcTopEnvMembershipState]) : (MutPtr
    TcTopEnvMembershipStateData)
  (tc-state-cell-ptr state.address TcTopEnvMembershipStateData))

(define (tc-topenv-membership-state-data [state : TcTopEnvMembershipState]) : TcTopEnvMembershipStateData
  (tc-state-cell-read state.address TcTopEnvMembershipStateData))

(define (tc-topenv-membership-state-data-set!
  [state : TcTopEnvMembershipState]
  [data : TcTopEnvMembershipStateData]) : unit
  (tc-state-cell-write! state.address TcTopEnvMembershipStateData data))

(define (tc-thread-name-kind-state-ptr [state : TcThreadNameKindState]) : (MutPtr
    TcThreadNameKindStateData)
  (tc-state-cell-ptr state.address TcThreadNameKindStateData))

(define (tc-thread-name-kind-state-data [state : TcThreadNameKindState]) : TcThreadNameKindStateData
  (tc-state-cell-read state.address TcThreadNameKindStateData))

(define (tc-thread-name-kind-state-data-set!
  [state : TcThreadNameKindState]
  [data : TcThreadNameKindStateData]) : unit
  (tc-state-cell-write! state.address TcThreadNameKindStateData data))

(define (tc-type-resolution-cache-state-ptr
  [state : TcTypeResolutionCacheState]) : (MutPtr
    TcTypeResolutionCacheStateData)
  (tc-state-cell-ptr state.address TcTypeResolutionCacheStateData))

(define (tc-type-resolution-cache-state-view
  [state : TcTypeResolutionCacheState]) : (Ptr TcTypeResolutionCacheStateData)
  (tc-state-cell-view state.address TcTypeResolutionCacheStateData))

(define (tc-type-resolution-cache-state-data
  [state : TcTypeResolutionCacheState]) : TcTypeResolutionCacheStateData
  (tc-state-cell-read state.address TcTypeResolutionCacheStateData))

(define (tc-agg-scalar-cache-state-ptr [state : TcAggScalarCacheState]) : (MutPtr
    TcAggScalarCacheStateData)
  (tc-state-cell-ptr state.address TcAggScalarCacheStateData))

(define (tc-agg-scalar-cache-state-view [state : TcAggScalarCacheState]) : (Ptr
    TcAggScalarCacheStateData)
  (tc-state-cell-view state.address TcAggScalarCacheStateData))

(define (tc-agg-scalar-cache-state-data [state : TcAggScalarCacheState]) : TcAggScalarCacheStateData
  (tc-state-cell-read state.address TcAggScalarCacheStateData))

(define (tc-agg-scalar-cache-state-data-set!
  [state : TcAggScalarCacheState]
  [data : TcAggScalarCacheStateData]) : unit
  (tc-state-cell-write! state.address TcAggScalarCacheStateData data))

(define (tc-topenv-membership-state-reset! [state : TcTopEnvMembershipState]) : unit
  (let
    [data : (MutPtr TcTopEnvMembershipStateData)
      (tc-topenv-membership-state-ptr state)]
    (unsafe
      (set! (deref data).epoch (+ (deref data).epoch 1))
      (set! (deref data).intern-table-id -1)
      (set! (deref data).intern-generation -1)
      (set! (deref data).mode 0))))

(define (tc-thread-name-kind-state-reset! [state : TcThreadNameKindState]) : unit
  (let
    [data : (MutPtr TcThreadNameKindStateData)
      (tc-thread-name-kind-state-ptr state)]
    (unsafe
      (set! (deref data).epoch (+ (deref data).epoch 1))
      (set! (deref data).intern-table-id -1)
      (set! (deref data).intern-generation -1))))

(define (tc-type-resolution-cache-state-reset!
  [state : TcTypeResolutionCacheState]) : unit
  (let
    [data : (MutPtr TcTypeResolutionCacheStateData)
      (tc-type-resolution-cache-state-ptr state)]
    (unsafe
      (set! (deref data).epoch (+ (deref data).epoch 1))
      (set! (deref data).type-pool-owner-id 0)
      (set! (deref data).type-segment-bases 0)
      ;; A job reset also retires every `tc-selected-holds-memo-bind!` entry:
      ;; a new generation (header word 0) matches none of them.
      (when
        (> (deref data).holds-memo-address 0)
        (let
          [generation : (MutPtr i64)
            (int->ptr
              (cast (deref data).holds-memo-address : u64)
              : (MutPtr i64))]
          (ptr-write! generation (+ (ptr-read generation) 1)))))))

(define (tc-source-key-cache-state-reset! [state : TcSourceKeyCacheState]) : unit
  (set! (array-ref state.control 2) 0)
  (set! (array-ref state.control 5) 0)
  (set! (array-ref state.control 9) 0))

(define tc-macro-call-site-record-stride : i64
  12)

(define (tc-macro-call-site-record-slot [index : i64] [field : i64]) : i64
  (+ (* index tc-macro-call-site-record-stride) field))

(define (tc-macro-call-site-state-storage-grow! [state : TcMacroCallSiteState]) : unit
  (unsafe
    (let
      [data : (MutPtr TcMacroCallSiteStateData)
        (tc-macro-call-site-state-ptr state)]
      [old-records : (__tl_dyn-array i64) (deref data).records]
      [old-capacity : i64 (deref data).capacity]
      [new-capacity : i64
        (if (< old-capacity 1)
          16
          (* old-capacity 2))]
      (in-arena
        (unsafe
          (arena.Arena (deref data).fixed-storage-arena))
        (let
          [new-records : (__tl_dyn-array i64)
            (__tl_make-array
              i64
              (* new-capacity tc-macro-call-site-record-stride))]
          [index : i64 0]
          (while (< index (* (deref data).len tc-macro-call-site-record-stride))
            (set! (array-ref new-records index) (array-ref old-records index))
            (set! index (+ index 1)))
          (set! (deref data).records new-records)
          (set! (deref data).capacity new-capacity))))))

(define (tc-macro-call-site-record-key-eq?
  [data : (& data TcMacroCallSiteStateData)]
  [index : i64]
  [path-id : i64]
  [definition-module-id : i64]
  [declaration-id : i64]
  [span : ast.AstSourceSpan]) : bool
  (let
    [base : i64 (tc-macro-call-site-record-slot index 0)]
    (and
      (= (array-ref data.records base) path-id)
      (= (array-ref data.records (+ base 2)) definition-module-id)
      (= (array-ref data.records (+ base 3)) declaration-id)
      (=
        (array-ref data.records (+ base 4))
        (ast.ast-source-span-start-line span))
      (=
        (array-ref data.records (+ base 5))
        (ast.ast-source-span-start-col span))
      (=
        (array-ref data.records (+ base 6))
        (ast.ast-source-span-end-line span))
      (= (array-ref data.records (+ base 7)) (ast.ast-source-span-end-col span)))))

(define (tc-macro-call-site-key-hash
  [path-id : i64]
  [definition-module-id : i64]
  [declaration-id : i64]
  [span : ast.AstSourceSpan]) : i64
  (hash.combine
    (hash.combine
      (hash.combine
        (hash.combine
          (hash.combine
            (hash.combine (hash.i64 path-id) (hash.i64 definition-module-id))
            (hash.i64 declaration-id))
          (hash.i64 (ast.ast-source-span-start-line span)))
        (hash.i64 (ast.ast-source-span-start-col span)))
      (hash.i64 (ast.ast-source-span-end-line span)))
    (hash.i64 (ast.ast-source-span-end-col span))))

(define (tc-macro-call-site-state-contains-key?
  [data : (& data TcMacroCallSiteStateData)]
  [path-id : i64]
  [definition-module-id : i64]
  [declaration-id : i64]
  [span : ast.AstSourceSpan]) : bool
  (let
    [index : i64 0]
    [found : bool false]
    (while (and (not found) (< index data.len))
      (if (tc-macro-call-site-record-key-eq?
        data
        index
        path-id
        definition-module-id
        declaration-id
        span)
        (set! found true)
        unit)
      (+= index 1))
    found))

(define (tc-macro-call-site-state-contains?
  [state : TcMacroCallSiteState]
  [site-hash : i64]
  [path-id : i64]
  [definition-module-id : i64]
  [declaration-id : i64]
  [span : ast.AstSourceSpan]) : bool
  (let
    [data : TcMacroCallSiteStateData (tc-macro-call-site-state-data state)]
    (match (tc_i64_i64_map.get (& data.seen-sites) site-hash)
      [(LookupFound index)
        (if (and (>= index 0) (< index data.len))
          (if (tc-macro-call-site-record-key-eq?
            data
            index
            path-id
            definition-module-id
            declaration-id
            span)
            true
            ;; Pool-generation node-ID reuse is rare. Preserve exactness by
            ;; falling back to the full key only on that collision path.
            (tc-macro-call-site-state-contains-key?
              data
              path-id
              definition-module-id
              declaration-id
              span))
          (tc-macro-call-site-state-contains-key?
            data
            path-id
            definition-module-id
            declaration-id
            span))]
      [(LookupMissing) false])))

(define (tc-macro-call-site-state-seen-note!
  [state : TcMacroCallSiteState]
  [site-hash : i64]
  [record-index : i64]) : unit
  (let
    [data : TcMacroCallSiteStateData (tc-macro-call-site-state-data state)]
    (match (tc_i64_i64_map.get (& data.seen-sites) site-hash)
      [(LookupFound _) unit]
      [(LookupMissing)
        (in-arena
          (unsafe
            (arena.Arena data.fixed-storage-arena))
          (tc_i64_i64_map.insert-ref!
            (&mut data.seen-sites)
            site-hash
            record-index)
          (tc-macro-call-site-state-data-set! state data))])))

(define (tc-macro-call-site-state-record!
  [state : TcMacroCallSiteState]
  [macro-name-id : i64]
  [definition-module-id : i64]
  [declaration-id : i64]
  [span : ast.AstSourceSpan]) : unit
  (let
    [active : TcMacroCallSiteStateData (tc-macro-call-site-state-data state)]
    [path-id : i64 active.active-path-id]
    [site-hash : i64
      (tc-macro-call-site-key-hash
        path-id
        definition-module-id
        declaration-id
        span)]
    (unless
      (tc-macro-call-site-state-contains?
        state
        site-hash
        path-id
        definition-module-id
        declaration-id
        span)
      (if (>= active.len active.capacity)
        (tc-macro-call-site-state-storage-grow! state)
        unit)
      (let
        [latest : (MutPtr TcMacroCallSiteStateData)
          (tc-macro-call-site-state-ptr state)]
        [index : i64
          (unsafe
            (deref latest).len)]
        [base : i64 (tc-macro-call-site-record-slot index 0)]
        (unsafe
          (set! (array-ref (deref latest).records base) path-id)
          (set! (array-ref (deref latest).records (+ base 1)) macro-name-id)
          (set!
            (array-ref (deref latest).records (+ base 2))
            definition-module-id)
          (set! (array-ref (deref latest).records (+ base 3)) declaration-id)
          (set!
            (array-ref (deref latest).records (+ base 4))
            (ast.ast-source-span-start-line span))
          (set!
            (array-ref (deref latest).records (+ base 5))
            (ast.ast-source-span-start-col span))
          (set!
            (array-ref (deref latest).records (+ base 6))
            (ast.ast-source-span-end-line span))
          (set!
            (array-ref (deref latest).records (+ base 7))
            (ast.ast-source-span-end-col span))
          (set!
            (array-ref (deref latest).records (+ base 8))
            (if active.active-editable
              1
              0))
          (set!
            (array-ref (deref latest).records (+ base 9))
            active.active-generator-id)
          (set!
            (array-ref (deref latest).records (+ base 10))
            active.active-item-id)
          (set!
            (array-ref (deref latest).records (+ base 11))
            active.active-key-id)
          (set! (deref latest).len (+ index 1)))
        (tc-macro-call-site-state-seen-note! state site-hash index)))))

(define (tc-macro-call-site-state-set-active-decl!
  [state : TcMacroCallSiteState]
  [path : String]
  [meta : ast.AstGeneratedDeclMeta]) : unit
  (let
    [data : (MutPtr TcMacroCallSiteStateData)
      (tc-macro-call-site-state-ptr state)]
    (unsafe
      (set! (deref data).active-path-id (ci.intern path))
      (match meta
        [(No)
          (set! (deref data).active-editable true)
          (set! (deref data).active-generator-id -1)
          (set! (deref data).active-item-id -1)
          (set! (deref data).active-key-id -1)]
        [(Some generator item _ key)
          (set! (deref data).active-editable false)
          (set! (deref data).active-generator-id (ci.intern generator))
          (set! (deref data).active-item-id (ci.intern item))
          (set! (deref data).active-key-id (ci.intern key))]))))

(define (tc-macro-call-site-state-active-decl [state : TcMacroCallSiteState]) : TcMacroCallSiteActiveDecl
  (let
    [data : (Ptr TcMacroCallSiteStateData)
      (tc-macro-call-site-state-view state)]
    (unsafe
      (TcMacroCallSiteActiveDecl
        (deref data).active-path-id
        (deref data).active-editable
        (deref data).active-generator-id
        (deref data).active-item-id
        (deref data).active-key-id))))

(define (tc-macro-call-site-state-restore-active-decl!
  [state : TcMacroCallSiteState]
  [active : TcMacroCallSiteActiveDecl]) : unit
  (let
    [data : (MutPtr TcMacroCallSiteStateData)
      (tc-macro-call-site-state-ptr state)]
    (unsafe
      (set! (deref data).active-path-id active.path-id)
      (set! (deref data).active-editable active.editable)
      (set! (deref data).active-generator-id active.generator-id)
      (set! (deref data).active-item-id active.item-id)
      (set! (deref data).active-key-id active.key-id))))

(define (tc-macro-call-site-state-expansion-path-id
  [state : TcMacroCallSiteState]) : i64
  (let
    [data : (Ptr TcMacroCallSiteStateData)
      (tc-macro-call-site-state-view state)]
    (unsafe
      (deref data).expansion-path-id)))

(define (tc-macro-call-site-state-set-expansion-path-id!
  [state : TcMacroCallSiteState]
  [path-id : i64]) : unit
  (let
    [data : (MutPtr TcMacroCallSiteStateData)
      (tc-macro-call-site-state-ptr state)]
    (unsafe
      (set! (deref data).expansion-path-id path-id))))

(define (tc-macro-call-site-state-reset! [state : TcMacroCallSiteState]) : unit
  (let
    [data : TcMacroCallSiteStateData (tc-macro-call-site-state-data state)]
    (set! data.len 0)
    (set! data.active-path-id -1)
    (set! data.active-editable false)
    (set! data.active-generator-id -1)
    (set! data.active-item-id -1)
    (set! data.active-key-id -1)
    (set! data.expansion-path-id -1)
    (tc-cache-map-clear! (&mut data.seen-sites))
    (tc-cache-map-clear! (&mut data.definition-paths))
    (tc-macro-call-site-state-data-set! state data)))

(define (tc-macro-call-site-text [id : i64]) : String
  (if (< id 0)
    ""
    (ci.intern-str id)))

(define (tc-macro-call-site-count-for-state [state : TcMacroCallSiteState]) : i64
  (unsafe
    (deref (tc-macro-call-site-state-view state)).len))

(define (tc-macro-call-site-field-for-state
  [state : TcMacroCallSiteState]
  [index : i64]
  [field : i64]
  [fallback : i64]) : i64
  (let
    [data : (Ptr TcMacroCallSiteStateData)
      (tc-macro-call-site-state-view state)]
    (unsafe
      (if (and (>= index 0) (< index (deref data).len))
        (array-ref
          (deref data).records
          (tc-macro-call-site-record-slot index field))
        fallback))))

(define (tc-macro-call-site-path-for-state
  [state : TcMacroCallSiteState]
  [index : i64]) : String
  (tc-macro-call-site-text
    (tc-macro-call-site-field-for-state state index 0 -1)))

(define (tc-macro-call-site-macro-name-id-for-state
  [state : TcMacroCallSiteState]
  [index : i64]) : i64
  (tc-macro-call-site-field-for-state state index 1 -1))

(define (tc-macro-call-site-definition-module-id-for-state
  [state : TcMacroCallSiteState]
  [index : i64]) : i64
  (tc-macro-call-site-field-for-state
    state
    index
    2
    cbi.compiler-builtin-id-fix-empty))

(define (tc-macro-call-site-declaration-id-for-state
  [state : TcMacroCallSiteState]
  [index : i64]) : i64
  (tc-macro-call-site-field-for-state state index 3 -1))

(define (tc-macro-call-site-span-for-state
  [state : TcMacroCallSiteState]
  [index : i64]) : ast.AstSourceSpan
  (ast.ast-source-span
    (tc-macro-call-site-field-for-state state index 4 0)
    (tc-macro-call-site-field-for-state state index 5 0)
    (tc-macro-call-site-field-for-state state index 6 0)
    (tc-macro-call-site-field-for-state state index 7 0)))

(define (tc-macro-call-site-editable-for-state?
  [state : TcMacroCallSiteState]
  [index : i64]) : bool
  (= (tc-macro-call-site-field-for-state state index 8 0) 1))

(define (tc-macro-call-site-generator-for-state
  [state : TcMacroCallSiteState]
  [index : i64]) : String
  (tc-macro-call-site-text
    (tc-macro-call-site-field-for-state state index 9 -1)))

(define (tc-macro-call-site-item-for-state
  [state : TcMacroCallSiteState]
  [index : i64]) : String
  (tc-macro-call-site-text
    (tc-macro-call-site-field-for-state state index 10 -1)))

(define (tc-macro-call-site-key-for-state
  [state : TcMacroCallSiteState]
  [index : i64]) : String
  (tc-macro-call-site-text
    (tc-macro-call-site-field-for-state state index 11 -1)))

;; Internal macro/typecheck pass boundaries reset file lookup carriers but must
;; not tear down caller-owned inlay or retained-let-fact generations active for
;; the whole request. The explicit compiler file reset releases both.
(define (tc-job-state-reset-derived-caches! [state : TcJobState]) : unit
  (tc-global-call-effects-finish! state)
  (tc-source-key-cache-state-reset! (tc-job-state-source-key-cache state))
  (tc-topenv-membership-state-reset! (tc-job-state-topenv-membership state))
  (tc-thread-name-kind-state-reset! (tc-job-state-thread-name-kind state))
  (let
    [scoped-address : i64 (tc-job-state-type-env-scoped-state-address state)]
    (if (> scoped-address 0)
      (let
        [scoped-state : TcTypeEnvScopedState
          (TcTypeEnvScopedState scoped-address)]
        (tc-type-env-scoped-state-set-active! scoped-state false)
        (tc-type-env-scoped-cache-clear! scoped-state))
      unit))
  (tc-type-resolution-cache-state-reset!
    (tc-job-state-type-resolution-cache state)))

(define (tc-job-state-reset-file-state! [state : TcJobState]) : unit
  (tc-job-state-reset-advisories! state)
  (tc-job-state-reset-derived-caches! state)
  (tc-module-decl-index-reset! (tc-job-state-macro-state state))
  (tc-inlay-hints-reset-for-state! (tc-job-state-inlay-hints state))
  (tc-unused-unsafe-tracking-clear! (tc-job-state-unused-unsafe state))
  (tc-spmd-inline-helper-stack-reset-for-job! state))

;; Terminal job boundary. Every checked result and macro snapshot has already
;; been consumed. Unlike a reusable file reset, this releases storage whose
;; lazy replacement would otherwise wait for a next lookup that never occurs.
(define (tc-job-state-retire-owned-storage! [job : TcJobState]) : unit
  (let
    [state : TcMacroState (tc-job-state-macro-state job)]
    [layout-address : i64 (tc-job-state-agg-layout-cache-address job)]
    (when
      (> (tc-macro-state-slot-address state tc-macro-state-slot-walk) 0)
      (unless
        (= (tc-macro-walk-field state macro-hygiene-env-root-depth) 0)
        (io.panic "typecheck: cannot retire an active macro hygiene owner")))
    (tc-global-call-effects-finish! job)
    (tc-job-state-release-selected-file-storage! job)
    (tc-job-state-reset-advisories! job)
    (tc-job-state-release-scratch-arenas! job)
    (tc-checked-let-binding-facts-finish!
      (tc-job-state-checked-let-binding-facts job))
    (tc-inlay-hint-string-arena-release-for-state!
      (tc-job-state-inlay-hints job))
    (if (> layout-address 0)
      (tc-agg-layout-cache-storage-reset-for-state!
        (TcAggLayoutCacheState layout-address))
      unit)
    (if (> (tc-macro-state-slot-address state tc-macro-state-slot-clone) 0)
      (tc-clone-root-collection-abort! job)
      unit)
    (if (> (tc-macro-state-slot-address state tc-macro-state-slot-module-env) 0)
      (tc-hygiene-module-env-cache-release! state)
      unit)
    (when
      (> (tc-macro-state-slot-address state tc-macro-state-slot-walk) 0)
      (macro-live-symbols-clear! state)
      (macro-hygiene-env-storage-retire! state))
    ;; Empty-env construction in the preceding cache clears can lazily
    ;; recreate this owner. It must be the final typechecker operation.
    (tc-module-decl-index-release! state)
    (tc-job-state-release-type-env-scoped-state! job)))

;; Scratch destruction is a lifetime boundary, not a generic cache reset.
;; Lowering performs internal file-state resets while a caller still owns an
;; outer region mark, so result boundaries invoke this operation explicitly.
(define (tc-job-state-release-scratch-arenas! [state : TcJobState]) : unit
  (tc-scratch-arena-state-release! (tc-job-state-scratch-arenas state)))

;; Scoped environments carry the state's address as a capability, so internal
;; pass resets may only clear it. A compiler result boundary has retired every
;; such environment and may destroy the dedicated dense-lane arena outright.
(define (tc-job-state-release-type-env-scoped-state! [state : TcJobState]) : unit
  (let
    [state-address : i64 (tc-job-state-type-env-scoped-state-address state)]
    [storage : i64 (tc-job-state-type-env-scoped-state-arena state)]
    (when
      (> state-address 0)
      ;; Invalidate the persistent job capability before releasing the memory
      ;; it names. The next environment lazily installs a fresh state/arena.
      (tc-job-state-set-type-env-scoped-state-address! state 0)
      (tc-job-state-set-type-env-scoped-state-arena! state 0)
      (if (> storage 0)
        (unsafe
          (arena.tl_arena_destroy storage))
        unit))))

;; Standalone source APIs and direct tests are serial compatibility surfaces.
;; The removed global scoped carrier initialized this adapter during startup;
;; do so explicitly to preserve that stable memory/profile boundary, while all
;; mutable cells—including scoped lookup/runtime state—remain owned by this
;; TcJobState. Production compiler jobs always pass their driver-owned state.
(define tc-serial-job-state-arena : i64
  (arena.tl_arena_make_small))
(define tc-serial-job-state-cell : (__tl_dyn-array TcJobState)
  (in-arena
    (unsafe
      (arena.Arena tc-serial-job-state-arena))
    (let
      [cell : (__tl_dyn-array TcJobState) (__tl_make-array TcJobState 1)]
      [state : TcJobState (tc-job-state-new)]
      (set! (array-ref cell 0) state)
      (tc-job-state-type-env-scoped-state state)
      cell)))

(define (tc-serial-job-state) : TcJobState
  (array-ref tc-serial-job-state-cell 0))

;; Replace the serial compatibility job state. Only this module writes its
;; globals; harnesses that nest a job restore the parent through this function.
(define (tc-serial-job-state-set! [state : TcJobState]) : unit
  (set! (array-ref tc-serial-job-state-cell 0) state))

(define (tc-serial-job-state-reset-if-ready!) : unit
  (tc-job-state-reset-file-state! (array-ref tc-serial-job-state-cell 0)))

(defstruct TcSelectedCertificate
  (module i64)
  (name i64)
  (expression i64)
  (body ownership.OwnershipBodyId)
  (expr-pool u64)
  (type-pool u64)
  (pool-owner i64)
  (type-stamp ast.AstTypePoolStamp)
  (intern-table i64)
  (intern-generation i64)
  ;; Zero: an explicitly checked body lowered by the ordinary lowerer.
  (address u64))

(defenum TcSelectedLookup
  (Legacy)
  (Err String))

(defenum TcSelectedAdmission
  (Ok bool)
  (Err String))

(defstruct TcBodyStateData
  (type-facts-recording bool)
  (type-facts-consuming bool)
  (type-fact-index (__tl_dyn-array i64))
  (type-fact-expr-ids (__tl_dyn-array i64))
  (type-fact-types (__tl_dyn-array ast.AstType))
  (type-fact-count i64)
  (type-fact-storage-arena i64)
  (type-fact-enclosing-arena i64)
  (early-exit-facts-collecting bool)
  (early-exit-facts-ready bool)
  (early-exit-current bool)
  (early-exit-suppress-depth i64)
  (early-exit-source-expr-limit i64)
  (early-exit-facts (__tl_dyn-array i64))
  (early-exit-known (__tl_dyn-array i64))
  ;; By-value parameters written in place (#7901). `param-facts` holds what
  ;; each checked body recorded: under its node id, the mask of written
  ;; parameter positions that lowering reads (tc-body-param-write-fact); under
  ;; tc-body-mut-borrow-key, each root it borrows `&mut`; under
  ;; tc-body-memory-class-key, whether a nominal name needs private parameter
  ;; storage (tc-body-param-storage-name?).
  (param-facts tc_i64_i64_map.Map)
  ;; These outlive every function's scratch arena, so they grow in the arena
  ;; the facts started in; 0 until then, when nothing is recorded.
  (param-write-arena i64)
  (selected-owner u64)
  (selected-revision u64)
  (selected-source-path String)
  (selected-lowering? bool)
  (selected-ready? bool)
  (selected-failed? bool)
  (selected-certificates (__tl_dyn-array TcSelectedCertificate))
  (selected-certificate-count i64)
  (selected-certificate-index tc_i64_i64_map.Map)
  (selected-retained-records i64)
  ;; Cumulative retained-copy and exact-witness reconstruction/comparison work.
  ;; Inference/normalization has a separate checked per-body work budget; this
  ;; counter does not claim to account for unsupported legacy analysis.
  (selected-certificate-work i64)
  (selected-retained-bytes i64)
  ;; The module and expression of each view read or copied where a write
  ;; through the view made it a mutable view (`mutable-views` of a normalized
  ;; body): lowering binds it to the viewed storage.
  (mutable-view-modules (__tl_dyn-array i64))
  (mutable-view-exprs (__tl_dyn-array i64)))

;; Serialized identity allocation, not a registry of bodies or payloads.
;; Structural interner owners use a packed-key range and cannot supply this
;; full-width namespace. Exhaustion returns an invalid capability, never wraps.
(define tc-selected-next-body-owner : u64
  (cast 1 : u64))

(define (tc-selected-body-owner-allocate!) : u64
  (if (= tc-selected-next-body-owner (cast 18446744073709551615 : u64))
    (cast 0 : u64)
    (let
      [owner : u64 tc-selected-next-body-owner]
      (set! tc-selected-next-body-owner (+ owner (cast 1 : u64)))
      owner)))

;; TcContext values are copied while resolving modules and rebuilding macro
;; views. Keep the mutable body analysis behind a shared one-slot cell so every
;; derived context for one job observes the same state without consulting a
;; process-global selector.
(defstruct TcBodyState
  ;; The one-slot TcBodyStateData cell; see tc-state-cell-read.
  (address i64)
  (job-state TcJobState)
  ;; Cache the inlay capability and enabled bit at body construction. The
  ;; ordinary disabled path then pays only this body-local flag check.
  (inlay-hint-state TcInlayHintState)
  (inlay-hint-enabled bool)
  ;; The source-name owner is immutable for one typecheck body. Cache it here
  ;; so hot source-key lookups do not repeatedly traverse TcContext and the
  ;; intern session handle just to validate the job-owned tables.
  (intern-table-id i64)
  (intern-generation i64))

;; The part of a typecheck context that every context derived from one root
;; shares. Only the root constructors allocate it, in the owning job's
;; lifetime arena; the `tc-context-with-*` derivations reuse it. The leading
;; words hold the addresses of the three fields that accessors hand out by
;; reference, so each is one load at a constant offset (an address-taken local
;; would keep the accessor from being inlined); `symbols-address` comes first.
(defstruct TcContextShared
  (symbols-address u64)
  (registries-address u64)
  (pools-address u64)
  (symbols csym.CompilerSymbols)
  (registries csym.CompilerRegistries)
  (pools ast.AstNodePoolContext)
  (source-names ci.InternSourceNameSessionHandle)
  (body-state TcBodyState)
  (semantic-observer TcSemanticObserver))

;; A typecheck context is a Copy handle: the address of its TcContextShared
;; block, the body's job state (the most frequently read capability) and the
;; fields that differ between derived contexts, so deriving a context for
;; another module or program allocates nothing. `module` and `program-decls`
;; hold the bits of the module-name String and of the program's
;; declaration-list Box; their owners keep them alive, as they did for the
;; shallow copies of the former by-value context. A reference to a String or
;; a Box is represented as the handle itself, so `tc-context-string-bits` and
;; `tc-context-program-bits` read those bits from a `(& str)` and from a
;; borrowed Box.
(defstruct TcContext
  (shared u64)
  (job-state TcJobState)
  (module-id i64)
  (type-module-id i64)
  (module u64)
  (program-decls u64))

;; Observations borrow the exact checked context and environment only for the
;; callback. Consumers copy payloads before function scratch or pools retire.
;; Only the final checked-program body installs an observer; macro probes and
;; compatibility contexts retain the zero capability.
(defstruct TcSemanticObserver
  (address i64))

(defenum TcSemanticEvent
  (ExpansionEnter i64 i64 ast.AstSourceSpan)
  (ExpansionLeave)
  (ResolvedMember i64)
  (Reference i64 bool)
  (ScopeEnter i64)
  (ScopeLeave)
  (SpmdEnter)
  (SpmdLeave)
  (ExpressionEnter i64)
  (Expression i64 ResultTcType bool)
  (Declaration i64 i64 String ast.AstDecl)
  (FunctionEnter i64 i64 ast.AstParamList ast.AstMaybeType)
  (FunctionLeave ResultTcType)
  (Binding i64 i64 i64 i64 i64 ast.AstType)
  (BindingSite TcMaybeAstSourceSpan)
  (BindingMaterialized i64 i64 i64 i64 i64)
  (BindingImported i64 i64 i64 i64 i64)
  (PersistentReference i64 i64))

;; Expansion wrappers can be checked by value. Publish their provenance around
;; the existing evaluation, before the transparent wrapper is discarded.
(defmacro (tc-semantic-expansion
  [ctx : Expr]
  [env : Expr]
  [origin : Expr]
  [name : Expr]
  [span : Expr]
  [body : Expr]) : Expr
  `(if (or
    (= tc-semantic-observed-jobs 0)
    (= (tc-context-semantic-observer ,ctx).address 0))
    ,body
    (let
      [_enter : unit
        (tc-semantic-observer-send!
          (tc-context-semantic-observer ,ctx)
          ,ctx
          ,env
          (TcSemanticEvent.ExpansionEnter ,origin ,name ,span))]
      [result : ResultTcType ,body]
      (tc-semantic-observer-send!
        (tc-context-semantic-observer ,ctx)
        ,ctx
        ,env
        TcSemanticEvent.ExpansionLeave)
      result)))

;; SPMD classification rechecks source operands by value. Keep its policy scope
;; around the existing calls even when those operands have no source wrapper.
(defmacro (tc-semantic-spmd [ctx : Expr] [env : Expr] [body : Expr]) : Expr
  `(let
    [observer : TcSemanticObserver
      (if (= tc-semantic-observed-jobs 0)
        (TcSemanticObserver 0)
        (tc-context-semantic-observer ,ctx))]
    [_enter : unit
      (when
        (!= observer.address 0)
        (tc-semantic-observer-send!
          observer
          ,ctx
          ,env
          TcSemanticEvent.SpmdEnter))]
    [result ,body]
    (when
      (!= observer.address 0)
      (tc-semantic-observer-send! observer ,ctx ,env TcSemanticEvent.SpmdLeave))
    result))

(defstruct TcSemanticObserverData
  (context i64)
  (callback (-> i64 TcContext TcTypeEnv TcSemanticEvent unit))
  (active-context TcContext))

(define (tc-semantic-observer-new
  [context : i64]
  [callback : (-> i64 TcContext TcTypeEnv TcSemanticEvent unit)]) : TcSemanticObserver
  (let
    [cell : (__tl_dyn-array i64)
      (__tl_make-array
        i64
        (/ (+ (comptime (size-of (type TcSemanticObserverData))) 7) 8))]
    (unsafe
      (ptr-write!
        (ptr-cast (__tl_array-data cell) : (MutPtr TcSemanticObserverData))
        (TcSemanticObserverData
          context
          callback
          (TcContext 0 (TcJobState 0) 0 0 0 0))))
    (TcSemanticObserver
      (cast
        (unsafe
          (ptr->int (__tl_array-data cell)))
        : i64))))

(define (tc-semantic-observer-send!
  [observer : TcSemanticObserver]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [event : TcSemanticEvent]) : unit
  (let
    [data : TcSemanticObserverData
      (tc-state-cell-read observer.address TcSemanticObserverData)]
    (set! data.active-context ctx)
    (unsafe
      (ptr-write!
        (int->ptr
          (cast observer.address : u64)
          : (MutPtr TcSemanticObserverData))
        data))
    (data.callback data.context ctx env event)))

(define (tc-context-set-semantic-observer!
  [ctx : TcContext]
  [observer : TcSemanticObserver]) : unit
  (unsafe
    (ptr-write!
      (ptr-cast
        (ptr-offset
          (int->ptr ctx.shared : (MutPtr u8))
          (comptime (offset-of (type TcContextShared) semantic-observer)))
        : (MutPtr TcSemanticObserver))
      observer)))

(define (tc-scoped-state-set-semantic-observer!
  [state : TcTypeEnvScopedState]
  [observer : TcSemanticObserver]) : unit
  (unless
    (= state.address 0)
    (unsafe
      (ptr-write!
        (ptr-cast
          (ptr-offset
            (int->ptr (cast state.address : u64) : (MutPtr u8))
            (comptime
              (offset-of (type TcTypeEnvScopedStateData) semantic-observer)))
          : (MutPtr TcSemanticObserver))
        observer))))

(define (tc-scoped-state-semantic-observer [state : TcTypeEnvScopedState]) : TcSemanticObserver
  (if (= state.address 0)
    (TcSemanticObserver 0)
    (tc-state-cell-read
      (+
        state.address
        (comptime (offset-of (type TcTypeEnvScopedStateData) semantic-observer)))
      TcSemanticObserver)))

;; Evaluate `body` with the semantic observer unpublished: a query, or a check
;; repeated for a decision, whose expressions the observed walk publishes once
;; where it checks them.
(defmacro (tc-semantic-unobserved [ctx : Expr] [body : Expr]) : Expr
  `(if (= tc-semantic-observed-jobs 0)
    ,body
    (let
      [observer : TcSemanticObserver (tc-context-semantic-observer ,ctx)]
      [scoped-state : TcTypeEnvScopedState
        (tc-job-state-type-env-scoped-state (tc-context-job-state ,ctx))]
      [scoped : TcSemanticObserver
        (tc-scoped-state-semantic-observer scoped-state)]
      (tc-context-set-semantic-observer! ,ctx (TcSemanticObserver 0))
      (tc-scoped-state-set-semantic-observer!
        scoped-state
        (TcSemanticObserver 0))
      (let
        [result ,body]
        (tc-context-set-semantic-observer! ,ctx observer)
        (tc-scoped-state-set-semantic-observer! scoped-state scoped)
        result))))

;; Whether the checked walk publishes to an active semantic observer: only a
;; Capture walk checks the body; a Query computes a type for a decision.
(define (tc-semantic-capture-observed?
  [ctx : TcContext]
  [sink : (& sink (TcSelectedSink store lease intern bind))]) : bool
  (and
    (> tc-semantic-observed-jobs 0)
    (!= (tc-context-semantic-observer ctx).address 0)
    (match sink
      [(TcSelectedSink.Capture _ _ _) true]
      [(TcSelectedSink.Query) false])))

;; Keep the disabled reference path in its caller, before callback arguments
;; or event storage become live. The shared send function is reached only for
;; the final checked body that owns an observer.
(defmacro (tc-semantic-observe-reference!
  [ctx : Expr]
  [env : Expr]
  [key : Expr]
  [global : Expr]) : Expr
  `(when
    (> tc-semantic-observed-jobs 0)
    (tc-semantic-observe-reference-active! ,ctx ,env ,key ,global)))

(define (tc-semantic-observe-reference-active!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [key : i64]
  [global : bool]) : unit
  (let
    [observer : TcSemanticObserver (tc-context-semantic-observer ctx)]
    (when
      (!= observer.address 0)
      (tc-semantic-observer-send! observer ctx env (Reference key global)))))

(define (tc-semantic-observe-enter!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expression : i64]) : unit
  (tc-semantic-observer-send!
    (tc-context-semantic-observer ctx)
    ctx
    env
    (ExpressionEnter expression)))

(define (tc-job-state-parser-control [state : TcJobState]) : i64
  (tc-job-state-field state parser-control i64))

(define (tc-job-state-set-parser-control! [state : TcJobState] [control : i64]) : unit
  (unsafe
    (ptr-write!
      (ptr-cast
        (ptr-offset
          (int->ptr state.address : (MutPtr u8))
          (comptime (offset-of (type TcJobStateData) parser-control)))
        : (MutPtr i64))
      control)))

(define (tc-job-state-semantic-observer [state : TcJobState]) : TcSemanticObserver
  (tc-job-state-field state semantic-observer TcSemanticObserver))

(define tc-semantic-observed-jobs : i64
  0)

;; Job scopes bracket observation even when a discarded nested check clears
;; its context observer. Nested jobs cannot disable an outer requested job.
(define (tc-job-state-set-semantic-observer!
  [state : TcJobState]
  [observer : TcSemanticObserver]) : unit
  (let
    [previous : TcSemanticObserver (tc-job-state-semantic-observer state)]
    (unless
      (= previous.address observer.address)
      (when (= previous.address 0) (+= tc-semantic-observed-jobs 1))
      (when (= observer.address 0) (-= tc-semantic-observed-jobs 1))
      (unsafe
        (ptr-write!
          (ptr-cast
            (ptr-offset
              (int->ptr (cast state.address : u64) : (MutPtr u8))
              (comptime (offset-of (type TcJobStateData) semantic-observer)))
            : (MutPtr TcSemanticObserver))
          observer)))))

(define (tc-semantic-observe-expression!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]
  [result : ResultTcType]) : unit
  (tc-semantic-observer-send!
    (tc-context-semantic-observer ctx)
    ctx
    env
    (Expression expr-id result tc-poison-observed)))

;; Read one field of the shared block with a single load at its offset;
;; accessors never copy the whole block.
(defmacro (tc-context-shared-field [ctx : Expr] [field : Expr] [_T : type]) : Expr
  `(unsafe
    (ptr-read
      (int->ptr
        (+
          ,(comptime.expr-struct-get ctx "shared")
          (cast (comptime (offset-of (type TcContextShared) ,field)) : u64))
        : (Ptr ,_T)))))

(define (tc-context-symbols [ctx : (& ctx TcContext)]) : (&
    ctx
    csym.CompilerSymbols)
  (unsafe
    (ptr-read (int->ptr ctx.shared : (Ptr (& ctx csym.CompilerSymbols))))))

(define (tc-context-symbols-ref [ctx : (& ctx TcContext)]) : (&
    ctx
    csym.CompilerSymbols)
  (tc-context-symbols ctx))

(define (tc-context-registries [ctx : (& ctx TcContext)]) : (&
    ctx
    csym.CompilerRegistries)
  (unsafe
    (ptr-read
      (int->ptr
        (+
          ctx.shared
          (cast
            (comptime (offset-of (type TcContextShared) registries-address))
            : u64))
        : (Ptr (& ctx csym.CompilerRegistries))))))

(define (tc-context-pools-ref [ctx : (& ctx TcContext)]) : (&
    ctx
    ast.AstNodePoolContext)
  (unsafe
    (ptr-read
      (int->ptr
        (+
          ctx.shared
          (cast
            (comptime (offset-of (type TcContextShared) pools-address))
            : u64))
        : (Ptr (& ctx ast.AstNodePoolContext))))))

;; By-value shallow view for helpers that still take CompilerSymbols by value.
(define (tc-context-symbols-view [ctx : TcContext]) : csym.CompilerSymbols
  (tc-context-shared-field ctx symbols csym.CompilerSymbols))

(define (tc-context-module [ctx : TcContext]) : String
  (unsafe
    (ptr-read (ptr-cast (ptr-addr-of ctx.module) : (Ptr String)))))

(define (tc-context-module-id [ctx : TcContext]) : i64
  ctx.module-id)

(define (tc-context-type-module-id [ctx : TcContext]) : i64
  ctx.type-module-id)

(define (tc-context-program [ctx : TcContext]) : ast.AstProgram
  (Program
    (unsafe
      (ptr-read
        (ptr-cast (ptr-addr-of ctx.program-decls) : (Ptr (Box ast.AstDeclList)))))))

(define (tc-context-source-names [ctx : TcContext]) : ci.InternSourceNameSessionHandle
  (tc-context-shared-field ctx source-names ci.InternSourceNameSessionHandle))

(define (tc-context-body-state [ctx : TcContext]) : TcBodyState
  (tc-context-shared-field ctx body-state TcBodyState))

(define (tc-context-semantic-observer [ctx : TcContext]) : TcSemanticObserver
  (tc-context-shared-field ctx semantic-observer TcSemanticObserver))

(define (tc-context-job-state [ctx : TcContext]) : TcJobState
  ctx.job-state)

(define (tc-context-string-bits [text : (& str)]) : u64
  (unsafe
    (ptr-read (ptr-cast (ptr-addr-of text) : (Ptr u64)))))

(define (tc-context-program-bits [program : (& ast.AstProgram)]) : u64
  (match program
    [(Program decls-box)
      (unsafe
        (ptr-read (ptr-cast (ptr-addr-of decls-box) : (Ptr u64))))]))

;; Typechecker pool reads follow the context's own pools and ignore a
;; compatibility pool context, so none may be active when a root context is
;; created. Lint, the only production user, clears its compatibility context
;; around the checks it runs. Empty when creation is allowed.
(define (tc-context-compat-guard-message) : String
  (if (ast.ast-node-pool-compat-context-active?)
    "typecheck: a typecheck context was created while a compatibility pool context is active"
    ""))

;; Allocate a root context's shared block in the job's lifetime arena, which
;; outlives every context of the job (a caller's scratch arena might not).
(define (tc-context-shared-new
  [job-state : TcJobState]
  [shared : TcContextShared]) : u64
  (let
    [guard : String (tc-context-compat-guard-message)]
    [_guard : unit (when (> (string.string-length guard) 0) (io.panic guard))]
    [owner : i64 (tc-job-state-field job-state owner-arena i64)]
    [home : i64 (arena.tl_arena_current)]
    [_enter : unit
      (if (= owner 0)
        unit
        (unsafe
          (arena.tl_arena_set owner)))]
    [block : (Box TcContextShared) (box shared)]
    [_leave : unit
      (if (= owner 0)
        unit
        (unsafe
          (arena.tl_arena_set home)))]
    [address : u64
      (unsafe
        (ptr-read (ptr-cast (ptr-addr-of block) : (Ptr u64))))]
    (tc-context-shared-address-set!
      address
      (comptime (offset-of (type TcContextShared) symbols-address))
      (comptime (offset-of (type TcContextShared) symbols)))
    (tc-context-shared-address-set!
      address
      (comptime (offset-of (type TcContextShared) registries-address))
      (comptime (offset-of (type TcContextShared) registries)))
    (tc-context-shared-address-set!
      address
      (comptime (offset-of (type TcContextShared) pools-address))
      (comptime (offset-of (type TcContextShared) pools)))
    address))

(define (tc-context-shared-address-set!
  [address : u64]
  [slot-offset : i64]
  [field-offset : i64]) : unit
  (unsafe
    (ptr-write!
      (int->ptr (+ address (cast slot-offset : u64)) : (MutPtr u64))
      (+ address (cast field-offset : u64)))))

(define (tc-context-expr-cell-address-live [ctx : TcContext]) : u64
  (let
    [pools : ast.AstNodePoolContext
      (tc-context-shared-field ctx pools ast.AstNodePoolContext)]
    (ast.ast-pool-cell-data pools.expr-pool)))

(define (tc-context-type-cell-address-live [ctx : TcContext]) : u64
  (let
    [pools : ast.AstNodePoolContext
      (tc-context-shared-field ctx pools ast.AstNodePoolContext)]
    (ast.ast-pool-cell-data pools.type-pool)))

(define (tc-context-expr-push-cell-addresses
  [expr-cell-address : u64]
  [type-cell-address : u64]
  [node : ast.AstExpr]) : i64
  (ast.ast-node-pool-context-expr-push-cells
    expr-cell-address
    type-cell-address
    (& node)))

(defenum TcUnboundSuggestionSnapshot
  (No)
  (Some bool i64 TcTypeEnv i64))

;; Only the latest diagnostic snapshot is live. Mutate one stable container so
;; recording and clearing names do not retain a new global container each time.
(define tc-unbound-suggestion-snapshot : (Array TcUnboundSuggestionSnapshot 1)
  (array (No)))

(define (tc-unbound-suggestion-snapshot-reset!) : unit
  (set!
    (array-ref tc-unbound-suggestion-snapshot 0)
    (TcUnboundSuggestionSnapshot.No)))

(define (tc-unbound-suggestion-snapshot-record!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : unit
  (set!
    (array-ref tc-unbound-suggestion-snapshot 0)
    (TcUnboundSuggestionSnapshot.Some
      (> (string.string-length (tc-context-module ctx)) 0)
      (tc-unbound-suggestion-scope-module-id ctx name-id)
      env
      name-id)))

(define (tc-context-new-with-source-names-and-job-state
  [program : ast.AstProgram]
  [symbols : csym.CompilerSymbols]
  [registries : csym.CompilerRegistries]
  [module : String]
  [module-id : i64]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [job-state : TcJobState]) : TcContext
  (tc-type-resolution-cache-bind-pools-for-job! job-state pools)
  (TcContext
    (tc-context-shared-new
      job-state
      (TcContextShared
        0
        0
        0
        symbols
        registries
        pools
        source-names
        (tc-body-state-new-with-job-state-and-source-names
          job-state
          source-names)
        (TcSemanticObserver 0)))
    job-state
    module-id
    module-id
    (tc-context-string-bits module)
    (tc-context-program-bits program)))

(define (tc-context-new-with-source-names
  [program : ast.AstProgram]
  [symbols : csym.CompilerSymbols]
  [registries : csym.CompilerRegistries]
  [module : String]
  [module-id : i64]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]) : TcContext
  (tc-context-new-with-source-names-and-job-state
    program
    symbols
    registries
    module
    module-id
    pools
    source-names
    (tc-serial-job-state)))

(define (tc-context-new-with-source-names-and-body-state
  [program : (& ast.AstProgram)]
  [symbols : csym.CompilerSymbols]
  [registries : csym.CompilerRegistries]
  [module : String]
  [module-id : i64]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [body-state : TcBodyState]
  [observer : TcSemanticObserver]) : TcContext
  (let
    [job-state : TcJobState body-state.job-state]
    [_bind : unit
      (tc-type-resolution-cache-bind-pools-for-job! job-state pools)]
    (TcContext
      (tc-context-shared-new
        job-state
        (TcContextShared
          0
          0
          0
          symbols
          registries
          pools
          source-names
          body-state
          observer))
      job-state
      module-id
      module-id
      (tc-context-string-bits module)
      (tc-context-program-bits program))))

(define (tc-context-new
  [program : ast.AstProgram]
  [symbols : csym.CompilerSymbols]
  [registries : csym.CompilerRegistries]
  [module : String]
  [module-id : i64]
  [pools : ast.AstNodePoolContext]) : TcContext
  (tc-context-new-with-source-names
    program
    symbols
    registries
    module
    module-id
    pools
    (ci.intern-source-name-session-capture-active-handle)))

(defenum ResultTcType
  (Ok ast.AstType)
  (Err String))

(defstruct TcSelectedBinding
  (coordinate TcScopedBindingCoordinate)
  (binder typed.TypedBinderId))

;; One owned association table travels with the selected capability. It is not
;; indexed by source syntax or by names. Entries are introduced only by the
;; canonical successful bind operation, and are scoped independently from the
;; retained binder records in TypedStore.
(defstruct TcSelectedBindings
  (body-owner u64)
  (body-generation u64)
  (body-revision u64)
  (pinned? bool)
  (env-store i64)
  (scoped-state i64)
  (lookup-epoch i64)
  (entries (__tl_dyn-array TcSelectedBinding))
  ;; Visible slot bound, including marker gaps. The canonical ordinal indexes
  ;; storage only; all owner/epoch/generation components still validate identity.
  (len i64)
  ;; Module values another module owns, by binder: only their defining module
  ;; may write them (#7976, `tc-selected-foreign-write`).
  (foreign-globals (__tl_dyn-array TcSelectedForeignGlobal))
  ;; A store or push form's write, named for its target operand's mutable
  ;; borrow (the first one published after it is set), or "".
  (write-verb String)
  ;; The tails of the control-flow store receivers being inferred (see
  ;; `tc-selected-receiver-tails!`): each expression id (-1 once inferred)
  ;; and whether it names a place outside its receiver.
  (receiver-tails (__tl_dyn-array i64))
  (receiver-places (__tl_dyn-array bool))
  ;; The forms a `clone` operand reads through (see `tc-infer-selected-read`),
  ;; by expression id, while the operand is inferred.
  (read-spines (__tl_dyn-array i64))
  ;; Early exits whose declared-result flow waits for the body's complete
  ;; arena regions (`tc-selected-early-exit-flow`): each exit's region count,
  ;; then every region with its flow bits; and its located diagnostic.
  (exit-flow-regions (__tl_dyn-array i64))
  (exit-flow-messages (__tl_dyn-array String))
  ;; Arena ends inside a loop, re-checked when the loop is inferred
  ;; (`tc-selected-loop-end-failure`): each end's phase region and brand,
  ;; owner count and owners, then its live binders' word count and, per binder, its
  ;; message index, region count and regions.
  (loop-ends (__tl_dyn-array i64))
  (loop-end-messages (__tl_dyn-array String)))

;; A foreign module value's binder and the legacy write diagnostic around the
;; operation it names (`tc-move-foreign-global-write-message`).
(defstruct TcSelectedForeignGlobal
  (binder i64)
  (head String)
  (tail String))

(define (tc-selected-bindings-new
  [lease : (& lease (typed.TypedBodyLease intern))]) : TcSelectedBindings
  (TcSelectedBindings
    lease.body.owner
    lease.body.generation
    lease.body.revision
    false
    0
    0
    0
    (__tl_make-array TcSelectedBinding 0)
    0
    (__tl_make-array TcSelectedForeignGlobal 0)
    ""
    (tc-selected-no-i64s)
    (tc-selected-no-bools)
    (tc-selected-no-i64s)
    (tc-selected-no-i64s)
    (__tl_make-array String 0)
    (tc-selected-no-i64s)
    (__tl_make-array String 0)))

;; Fresh empty arrays and pushes for the selected producer. `__tl_make-array`
;; and `__tl_array-push!` expand to an allocation (and, for a push, a copy
;; loop) wherever they are written; a call to one of these keeps that code
;; once.
(define (tc-selected-no-i64s) : (__tl_dyn-array i64)
  (__tl_make-array i64 0))

(define (tc-selected-no-bools) : (__tl_dyn-array bool)
  (__tl_make-array bool 0))

(define (tc-selected-no-occurrences) : (__tl_dyn-array typed.TypedOccurrenceId)
  (__tl_make-array typed.TypedOccurrenceId 0))

(define (tc-selected-no-binders) : (__tl_dyn-array typed.TypedBinderId)
  (__tl_make-array typed.TypedBinderId 0))

(define (tc-selected-no-types) : (__tl_dyn-array ast.AstType)
  (__tl_make-array ast.AstType 0))

(define (tc-selected-no-type-classes) : (__tl_dyn-array
    ownership_normalize.OwnershipNormalizeTypeClass)
  (__tl_make-array ownership_normalize.OwnershipNormalizeTypeClass 0))

(define (tc-selected-i64s-push!
  [items : (&mut items (__tl_dyn-array i64))]
  [item : i64]) : unit
  (__tl_array-push! items item))

(define (tc-selected-bools-push!
  [items : (&mut items (__tl_dyn-array bool))]
  [item : bool]) : unit
  (__tl_array-push! items item))

(define (tc-selected-occurrences-push!
  [items : (&mut items (__tl_dyn-array typed.TypedOccurrenceId))]
  [item : typed.TypedOccurrenceId]) : unit
  (__tl_array-push! items item))

(define (tc-selected-binders-push!
  [items : (&mut items (__tl_dyn-array typed.TypedBinderId))]
  [item : typed.TypedBinderId]) : unit
  (__tl_array-push! items item))

(define (tc-selected-types-push!
  [items : (&mut items (__tl_dyn-array ast.AstType))]
  [item : ast.AstType]) : unit
  (__tl_array-push! items item))

(define (tc-selected-products-push!
  [items
    : (&mut
      items
      (__tl_dyn-array ownership_normalize.OwnershipNormalizeProduct))]
  [item : ownership_normalize.OwnershipNormalizeProduct]) : unit
  (__tl_array-push! items item))

;; A selected inference capability is linear: every result, including an error,
;; returns it to the caller. Query clients cannot publish executable records.
;; Unrepresented is a migration result, never an ownership certificate.
(defenum TcSelectedSink
  (:lifetimes store lease intern bind)
  (Query)
  (Capture
    (&mut store typed.TypedStore)
    (& lease (typed.TypedBodyLease intern))
    ;; Borrowed from the body's owner: a sink copy is three words.
    (&mut bind TcSelectedBindings)))

;; A value read from a sink handed back with it (a borrowed sink cannot lend
;; out its `&mut` bindings).
(defenum TcSelectedCounted
  (:lifetimes store lease intern bind)
  (Counted i64 (TcSelectedSink store lease intern bind)))

;; The number of visible binding slots, and the sink.
(define (tc-selected-sink-count
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedCounted
    store
    lease
    intern
    bind)
  (match sink
    [(TcSelectedSink.Query) (TcSelectedCounted.Counted 0 TcSelectedSink.Query)]
    [(TcSelectedSink.Capture store lease bindings)
      (TcSelectedCounted.Counted
        bindings.len
        (TcSelectedSink.Capture store lease bindings))]))

(define (tc-selected-counted-value
  [counted : (& counted (TcSelectedCounted store lease intern bind))]) : i64
  (match counted
    [(TcSelectedCounted.Counted value _) value]))

(define (tc-selected-counted-sink
  [counted : (TcSelectedCounted store lease intern bind)]) : (TcSelectedSink
    store
    lease
    intern
    bind)
  (match counted
    [(TcSelectedCounted.Counted _ sink) sink]))

(define (tc-selected-capture
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [bindings : (&mut bind TcSelectedBindings)]) : (TcSelectedSink
    store
    lease
    intern
    bind)
  (TcSelectedSink.Capture store lease bindings))

(defenum TcSelectedOccurrence
  (Unrepresented)
  (Selected typed.TypedOccurrenceId))

(define (tc-selected-no-selected) : (__tl_dyn-array TcSelectedOccurrence)
  (__tl_make-array TcSelectedOccurrence 0))

(define (tc-selected-selected-push!
  [items : (&mut items (__tl_dyn-array TcSelectedOccurrence))]
  [item : TcSelectedOccurrence]) : unit
  (__tl_array-push! items item))

(defenum TcSelectedPlace
  (Unrepresented)
  (Selected typed.TypedPlaceId (__tl_dyn-array typed.TypedOccurrenceId)))

(defenum TcSelectedPlaceResult
  (:lifetimes store lease intern bind)
  (Ok ast.AstType TcSelectedPlace (TcSelectedSink store lease intern bind))
  (Err String (TcSelectedSink store lease intern bind)))

(defenum TcSelectedResult
  (:lifetimes store lease intern bind)
  (Ok ast.AstType TcSelectedOccurrence (TcSelectedSink store lease intern bind))
  (Err String (TcSelectedSink store lease intern bind)))

;; Operand types and selected execution children come from one binary inference
;; implementation. Legacy clients project the types and cannot publish nodes.
(defenum TcSelectedBinOpResult
  (:lifetimes store lease intern bind)
  (Ok
    TcBinOpTypes
    TcSelectedOccurrence
    TcSelectedOccurrence
    (TcSelectedSink store lease intern bind))
  (Err String (TcSelectedSink store lease intern bind)))

(defenum TcSelectedLiteralCandidate
  (No)
  (Some ast.AstLiteral typed.TypedSyntax ownership.OwnershipSource))

(defenum TcSelectedLiteralCandidateResult
  (:lifetimes store lease intern bind)
  (Ok TcSelectedLiteralCandidate (TcSelectedSink store lease intern bind))
  (Err String (TcSelectedSink store lease intern bind)))

(defenum TcSelectedProbe
  (Query)
  (Attempt typed.TypedAttemptId i64))

(defenum TcSelectedProbeStart
  (:lifetimes store lease intern bind)
  (Ok TcSelectedProbe (TcSelectedSink store lease intern bind))
  (Err String (TcSelectedSink store lease intern bind)))

(defenum TcSelectedClosedResult
  (Ok ast.AstType TcSelectedOccurrence)
  (Err String))

(define (tc-selected-close
  [result : (TcSelectedResult store lease intern bind)]) : TcSelectedClosedResult
  (match result
    [(TcSelectedResult.Err message _) (TcSelectedClosedResult.Err message)]
    [(TcSelectedResult.Ok ty root sink)
      (match sink
        [(TcSelectedSink.Query)
          (TcSelectedClosedResult.Err
            "typecheck: selected body lost its capability")]
        [(TcSelectedSink.Capture _ _ _) (TcSelectedClosedResult.Ok ty root)])]))

(defenum TcSelectedBodyLeaseResult
  (:lifetimes intern)
  (Ok (typed.TypedBodyLease intern))
  (Err typed.TypedError))

(define (tc-selected-error [error : typed.TypedError]) : String
  (match error
    [(typed.TypedError.Lease) "typecheck: selected inference lease mismatch"]
    [(typed.TypedError.Stale) "typecheck: stale selected inference occurrence"]
    [(typed.TypedError.Unknown)
      "typecheck: unknown selected inference identity"]
    [(typed.TypedError.Query)
      "typecheck: query attempted selected inference publication"]
    [(typed.TypedError.Order) "typecheck: selected inference transaction order"]
    [(typed.TypedError.Shape)
      "typecheck: malformed selected inference operation"]
    [(typed.TypedError.Budget)
      "typecheck: selected inference work budget exhausted"]
    [(typed.TypedError.Exhausted)
      "typecheck: selected inference identity exhausted"]))

;; A typed-store failure as a selected result, handing the sink back. Built
;; at a return site, the result is built in a temporary and copied out whole;
;; built here, a site is one call.
(define (tc-selected-failed
  [error : typed.TypedError]
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [bindings : (&mut bind TcSelectedBindings)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (TcSelectedResult.Err
    (tc-selected-error error)
    (TcSelectedSink.Capture store lease bindings)))

(define (tc-selected-place-failed
  [error : typed.TypedError]
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [bindings : (&mut bind TcSelectedBindings)]) : (TcSelectedPlaceResult
    store
    lease
    intern
    bind)
  (TcSelectedPlaceResult.Err
    (tc-selected-error error)
    (TcSelectedSink.Capture store lease bindings)))

(define (tc-selected-project
  [result : (TcSelectedResult store lease intern bind)]) : ResultTcType
  (match result
    [(TcSelectedResult.Ok ty _ _) (ResultTcType.Ok ty)]
    [(TcSelectedResult.Err message _) (ResultTcType.Err message)]))

(defenum ResultTcSelectedUnit
  (Ok unit)
  (Err String))

(define (tc-selected-unit [result : typed.TypedResult]) : ResultTcSelectedUnit
  (match result
    [(typed.TypedResult.Ok _) (ResultTcSelectedUnit.Ok unit)]
    [(typed.TypedResult.Err error)
      (ResultTcSelectedUnit.Err (tc-selected-error error))]))

(define (tc-selected-unrepresented
  [result : ResultTcType]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match result
    [(ResultTcType.Ok ty)
      (TcSelectedResult.Ok ty TcSelectedOccurrence.Unrepresented sink)]
    [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]))

;; Preserve contextual result selection without pretending an implicit coercion
;; is an executable operation. The owning occurrence attempt discards its
;; children when contextual adaptation makes the result unrepresented. A value
;; of a plain type where its region-tagged type `(in r T)` is expected (an
;; explicit read through a reference, typed by its place) is that value read
;; under `r`: it is converted, as a widening is, so the read keeps its own
;; occurrence (a move out of the reference stays one) and the form takes the
;; expected type.
(define (tc-selected-contextual-result
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expected : ast.AstMaybeType]
  [result : (TcSelectedResult store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match result
    [(TcSelectedResult.Err message sink) (TcSelectedResult.Err message sink)]
    [(TcSelectedResult.Ok actual occurrence sink)
      (match expected
        [(ast.AstMaybeType.No) (TcSelectedResult.Ok actual occurrence sink)]
        [(ast.AstMaybeType.Some want)
          (match (tc-expr-result-with-expected-or-actual
            ctx
            env
            want
            false
            (ResultTcType.Ok (tc-global-shared-view actual)))
            [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
            [(ResultTcType.Ok ty)
              (let
                ;; A scalar numeric widening (an `f32` value where an `f64` is
                ;; expected) is the cast it performs; it moves nothing.
                [widening? : bool
                  (and
                    (tc-castable-type? (tc-global-shared-view actual))
                    (tc-castable-type? (tc-global-shared-view ty)))]
                ;; Whether each carries an outer region tag; the types compare
                ;; beneath them.
                [expected-tagged? : bool
                  (match (& ty)
                    [(ast.AstType.Region _ _) true]
                    [_ false])]
                [actual-tagged? : bool
                  (match (& actual)
                    [(ast.AstType.Region _ _) true]
                    [_ false])]
                [never? : bool
                  (match (& actual)
                    [(ast.AstType.Never) true]
                    [_ false])]
                [beneath? : bool
                  (tc-selected-same-type?
                    (tc-selected-strip-regions actual)
                    (tc-selected-strip-regions (tc-global-shared-view ty)))]
                (cond
                  [(or
                      never?
                      (and beneath? (= expected-tagged? actual-tagged?)))
                    (TcSelectedResult.Ok ty occurrence sink)]
                  [(or widening? (and beneath? expected-tagged?))
                    (tc-selected-widening ty occurrence sink)]
                  [else
                    (TcSelectedResult.Ok
                      ty
                      TcSelectedOccurrence.Unrepresented
                      sink)]))])])]))

;; The implicit cast of a selected scalar to its contextual type `ty`, at the
;; scalar's own source.
(define (tc-selected-widening
  [ty : ast.AstType]
  [occurrence : TcSelectedOccurrence]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match occurrence
    [(TcSelectedOccurrence.Unrepresented)
      (TcSelectedResult.Ok ty TcSelectedOccurrence.Unrepresented sink)]
    [(TcSelectedOccurrence.Selected child)
      (match sink
        [(TcSelectedSink.Query)
          (TcSelectedResult.Ok
            ty
            TcSelectedOccurrence.Unrepresented
            TcSelectedSink.Query)]
        [(TcSelectedSink.Capture store lease bindings)
          (match (tc-selected-occurrence-origin-copy!
            store
            lease
            (typed.TypedOccurrenceId (typed.typed-handle-copy (& child.handle))))
            [(TcSelectedOriginResult.Err error)
              (tc-selected-failed error store lease bindings)]
            [(TcSelectedOriginResult.Ok source)
              (tc-selected-publish-primitive
                (ResultTcType.Ok ty)
                typed.TypedSyntax.Generated
                source
                typed.TypedPrimitive.Cast
                (tc-selected-children1 (TcSelectedOccurrence.Selected child))
                (TcSelectedSink.Capture store lease bindings))])])]))

(defenum TcSelectedBoolResult
  (Ok bool)
  (Err typed.TypedError))

(define (tc-selected-occurrence-never!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [id : typed.TypedOccurrenceId]) : TcSelectedBoolResult
  (let
    [type : typed.TypedTypeId
      (match (typed.typed-occurrence-get! store lease id)
        [(typed.TypedNodeResult.Err error)
          (return (TcSelectedBoolResult.Err error))]
        [(typed.TypedNodeResult.Ok node)
          (typed.TypedTypeId (typed.typed-handle-copy (& node.type.handle)))])]
    (match (typed.typed-type-get! store lease type)
      [(typed.TypedTypeResult.Err error) (TcSelectedBoolResult.Err error)]
      [(typed.TypedTypeResult.Ok value)
        (TcSelectedBoolResult.Ok
          (match value
            [(ast.AstType.Never) true]
            [_ false]))])))

;; Whether occurrence `id` diverges (its own type is Never), with the sink
;; handed back; a query knows nothing and says no.
(defenum TcSelectedNeverCheck
  (:lifetimes store lease intern bind)
  (Checked bool (TcSelectedSink store lease intern bind)))

(define (tc-selected-sink-never!
  [sink : (TcSelectedSink store lease intern bind)]
  [id : typed.TypedOccurrenceId]) : (TcSelectedNeverCheck
    store
    lease
    intern
    bind)
  (match sink
    [(TcSelectedSink.Query)
      (TcSelectedNeverCheck.Checked false TcSelectedSink.Query)]
    [(TcSelectedSink.Capture store lease bindings)
      (TcSelectedNeverCheck.Checked
        (match (tc-selected-occurrence-never! store lease id)
          [(TcSelectedBoolResult.Ok diverges) diverges]
          [(TcSelectedBoolResult.Err _) false])
        (TcSelectedSink.Capture store lease bindings))]))

;; Contextual Never coercion affects the checker's result, not control flow.
;; Every published occurrence takes its intrinsic result from its actual
;; chosen child records, while the canonical inferred type is retained
;; separately (`tc-selected-publish`). A diverging operand is an exit: a form
;; that evaluates its operands in order, an operand of type Never among them,
;; never completes (the operands after it are unreachable). A conditional
;; form diverges only when its condition or scrutinee does, or every branch.
(define (tc-selected-flow-never!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [operation : (& operation typed.TypedOperation)]
  [children : (& children (__tl_dyn-array typed.TypedOccurrenceId))]) : TcSelectedBoolResult
  (match operation
    [(typed.TypedOperation.If)
      (unless
        (= (array-length children) 3)
        (return (TcSelectedBoolResult.Err typed.TypedError.Shape)))
      (let
        [condition : bool
          (try (tc-selected-child-never! store lease children 0))]
        [left : bool (try (tc-selected-child-never! store lease children 1))]
        [right : bool (try (tc-selected-child-never! store lease children 2))]
        (TcSelectedBoolResult.Ok (or condition (and left right))))]
    ;; A match diverges when its scrutinee does, or every arm's body: no arm
    ;; reaches its join (`normalize-match!`). Child 0 is the scrutinee; an
    ;; arm's child 1 is its body.
    [(typed.TypedOperation.Match _)
      (if (or
        (= (array-length children) 0)
        (try (tc-selected-child-never! store lease children 0)))
        (TcSelectedBoolResult.Ok (> (array-length children) 0))
        (let
          [index : i64 1]
          [never? : bool (> (array-length children) 1)]
          (while (and never? (< index (array-length children)))
            (let
              [body : typed.TypedOccurrenceId
                (try
                  (typed.typed-child-get!
                    store
                    lease
                    (typed.TypedOccurrenceId
                      (typed.typed-handle-copy
                        (& (array-ref children index).handle)))
                    1))]
              (set!
                never?
                (try (tc-selected-occurrence-never! store lease body)))
              (set! index (+ index 1))))
          (TcSelectedBoolResult.Ok never?)))]
    ;; A loop diverges when its condition does; its body may break out.
    [(typed.TypedOperation.While)
      (tc-selected-child-never! store lease children 0)]
    ;; A short-circuit operator evaluates its right operand conditionally.
    [(typed.TypedOperation.Binary (ast.AstBinOp.And))
      (tc-selected-child-never! store lease children 0)]
    [(typed.TypedOperation.Binary (ast.AstBinOp.Or))
      (tc-selected-child-never! store lease children 0)]
    ;; An arm or pattern is entered only through its match.
    [(typed.TypedOperation.Arm) (TcSelectedBoolResult.Ok false)]
    [(typed.TypedOperation.Pattern _) (TcSelectedBoolResult.Ok false)]
    [_
      (let
        [index : i64 0]
        [never? : bool false]
        (while (and (not never?) (< index (array-length children)))
          (set!
            never?
            (try (tc-selected-child-never! store lease children index)))
          (set! index (+ index 1)))
        (TcSelectedBoolResult.Ok never?))]))

;; Whether child `index` of `children` diverges (its own type is Never).
(define (tc-selected-child-never!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [children : (& children (__tl_dyn-array typed.TypedOccurrenceId))]
  [index : i64]) : TcSelectedBoolResult
  (if (or (< index 0) (>= index (array-length children)))
    (TcSelectedBoolResult.Err typed.TypedError.Shape)
    (tc-selected-occurrence-never!
      store
      lease
      (typed.TypedOccurrenceId
        (typed.typed-handle-copy (& (array-ref children index).handle))))))

;; Whether `syntax` names a form a `clone` operand reads through
;; (`tc-infer-selected-read`).
(define (tc-selected-read-spine-syntax?
  [bindings : (& bindings TcSelectedBindings)]
  [syntax : (& syntax typed.TypedSyntax)]) : bool
  (match syntax
    [(typed.TypedSyntax.Source id)
      (let
        [index : i64 0]
        [found? : bool false]
        (while (and (not found?) (< index (array-length bindings.read-spines)))
          (set! found? (= (array-ref bindings.read-spines index) id))
          (set! index (+ index 1)))
        found?)]
    [(typed.TypedSyntax.Generated) false]))

(defenum TcSelectedMaybeTypeId
  (Found typed.TypedTypeId)
  (No)
  (Err typed.TypedError))

;; Occurrence `id`'s own type, or No when it diverges (Never).
(define (tc-selected-occurrence-live-type!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [id : typed.TypedOccurrenceId]) : TcSelectedMaybeTypeId
  (let
    [type : typed.TypedTypeId
      (match (typed.typed-occurrence-get! store lease id)
        [(typed.TypedNodeResult.Err error)
          (return (TcSelectedMaybeTypeId.Err error))]
        [(typed.TypedNodeResult.Ok node)
          (typed.TypedTypeId (typed.typed-handle-copy (& node.type.handle)))])]
    (match (typed.typed-type-get!
      store
      lease
      (typed.TypedTypeId (typed.typed-handle-copy (& type.handle))))
      [(typed.TypedTypeResult.Err error) (TcSelectedMaybeTypeId.Err error)]
      [(typed.TypedTypeResult.Ok value)
        (match value
          [(ast.AstType.Never) TcSelectedMaybeTypeId.No]
          [_ (TcSelectedMaybeTypeId.Found type)])])))

;; The type a form a `clone` operand reads through publishes
;; (`tc-infer-selected-read`): its result's, which is the read of the place
;; (or temporary) its result child names. The result children are an `if`'s
;; branches, a match's arm bodies and a sequence's last form; the first that
;; does not diverge decides (No when none does).
(define (tc-selected-read-result-type-id!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [operation : (& operation typed.TypedOperation)]
  [children : (& children (__tl_dyn-array typed.TypedOccurrenceId))]) : TcSelectedMaybeTypeId
  (let
    [count : i64 (array-length children)]
    [index : i64
      (match operation
        [(typed.TypedOperation.If) 1]
        [(typed.TypedOperation.Match _) 1]
        [(typed.TypedOperation.Sequence) (- count 1)]
        [_ count])]
    (while (and (>= index 0) (< index count))
      (let
        [child : typed.TypedOccurrenceId
          (typed.TypedOccurrenceId
            (typed.typed-handle-copy (& (array-ref children index).handle)))]
        [result : typed.TypedOccurrenceId
          (match operation
            [(typed.TypedOperation.Match _)
              (match (typed.typed-child-get! store lease child 1)
                [(typed.TypedChildResult.Ok body) body]
                [(typed.TypedChildResult.Err error)
                  (return (TcSelectedMaybeTypeId.Err error))])]
            [_ child])]
        (match (tc-selected-occurrence-live-type! store lease result)
          [(TcSelectedMaybeTypeId.No) (set! index (+ index 1))]
          [(TcSelectedMaybeTypeId.Found type)
            (return (TcSelectedMaybeTypeId.Found type))]
          [(TcSelectedMaybeTypeId.Err error)
            (return (TcSelectedMaybeTypeId.Err error))])))
    TcSelectedMaybeTypeId.No))

;; An occurrence published with its intrinsic result (`tc-selected-publish`
;; derives it for every form).
(define (tc-selected-publish-flow
  [result : ResultTcType]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [operation : typed.TypedOperation]
  [children : (__tl_dyn-array typed.TypedOccurrenceId)]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (tc-selected-publish result syntax source operation children sink))

(define (tc-selected-publish
  [result : ResultTcType]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [operation : typed.TypedOperation]
  [children : (__tl_dyn-array typed.TypedOccurrenceId)]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match result
    [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcType.Ok ty)
      (match sink
        [(TcSelectedSink.Query)
          (TcSelectedResult.Ok
            ty
            TcSelectedOccurrence.Unrepresented
            TcSelectedSink.Query)]
        [(TcSelectedSink.Capture store lease bindings)
          ;; Only its defining module writes a module value (#7976).
          (match (tc-selected-foreign-write
            store
            lease
            (&mut bindings)
            (& operation)
            (& children))
            [(TcMaybeString.Some message)
              (TcSelectedResult.Err
                (tc-selected-expansion-framed
                  (& source.expansion)
                  (tc-located-error
                    (tc-selected-source-span (& source))
                    message))
                (TcSelectedSink.Capture store lease bindings))]
            [(TcMaybeString.No)
              ;; Synthetic clients without a real origin are not yet normalizable.
              ;; Do not invent a source location or turn that migration gap into a
              ;; source rejection. Lease/resource failures still take the hard path.
              (if (not (ownership.ownership-source-valid? (& source)))
                (TcSelectedResult.Ok
                  ty
                  TcSelectedOccurrence.Unrepresented
                  (TcSelectedSink.Capture store lease bindings))
                (match (match (tc-selected-flow-never!
                  store
                  lease
                  (& operation)
                  (& children))
                  [(TcSelectedBoolResult.Err error)
                    (typed.TypedTypeIdResult.Err error)]
                  [(TcSelectedBoolResult.Ok never?)
                    (match (if (and
                      (not never?)
                      (tc-selected-read-spine-syntax? (& bindings) (& syntax)))
                      (tc-selected-read-result-type-id!
                        store
                        lease
                        (& operation)
                        (& children))
                      TcSelectedMaybeTypeId.No)
                      [(TcSelectedMaybeTypeId.Found type)
                        (typed.TypedTypeIdResult.Ok type)]
                      [(TcSelectedMaybeTypeId.Err error)
                        (typed.TypedTypeIdResult.Err error)]
                      [(TcSelectedMaybeTypeId.No)
                        (typed.typed-type-add!
                          store
                          lease
                          (if never?
                            ast.AstType.Never
                            (tc-global-shared-view ty)))])])
                  [(typed.TypedTypeIdResult.Err error)
                    (tc-selected-failed error store lease bindings)]
                  [(typed.TypedTypeIdResult.Ok type-id)
                    (match (typed.typed-origin-add! store lease source)
                      [(typed.TypedOriginResult.Err error)
                        (tc-selected-failed error store lease bindings)]
                      [(typed.TypedOriginResult.Ok origin)
                        (match (typed.typed-occurrence-add!
                          store
                          lease
                          type-id
                          syntax
                          origin
                          operation
                          (& children))
                          [(typed.TypedOccurrenceResult.Err error)
                            (tc-selected-failed error store lease bindings)]
                          [(typed.TypedOccurrenceResult.Ok id)
                            (TcSelectedResult.Ok
                              ty
                              (TcSelectedOccurrence.Selected id)
                              (TcSelectedSink.Capture store lease bindings))])])]))])])]))

(define (tc-selected-attempt-finish
  [attempt : typed.TypedAttemptId]
  [binding-count : i64]
  [result : (TcSelectedResult store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match result
    [(TcSelectedResult.Ok ty occurrence sink)
      (match sink
        [(TcSelectedSink.Query)
          (TcSelectedResult.Err
            "typecheck: selected inference lost its capability"
            TcSelectedSink.Query)]
        [(TcSelectedSink.Capture store lease bindings)
          (let
            [commit? : bool
              (match (& occurrence)
                [(TcSelectedOccurrence.Selected _) true]
                [_ false])]
            (unless commit? (set! bindings.len binding-count))
            (match (typed.typed-attempt-finish! store lease attempt commit?)
              [(typed.TypedResult.Ok _)
                (TcSelectedResult.Ok
                  ty
                  occurrence
                  (TcSelectedSink.Capture store lease bindings))]
              [(typed.TypedResult.Err error)
                (tc-selected-failed error store lease bindings)]))])]
    [(TcSelectedResult.Err message sink)
      (match sink
        [(TcSelectedSink.Query)
          (TcSelectedResult.Err message TcSelectedSink.Query)]
        [(TcSelectedSink.Capture store lease bindings)
          (set! bindings.len binding-count)
          (match (typed.typed-attempt-finish! store lease attempt false)
            [(typed.TypedResult.Ok _)
              (TcSelectedResult.Err
                message
                (TcSelectedSink.Capture store lease bindings))]
            [(typed.TypedResult.Err error)
              (tc-selected-failed error store lease bindings)])])]))

;; This entry owns one inference attempt. It never looks up a type by AST ID.
;; Child results, including contextual results for reused syntax, are returned
;; by the actual selected operation. Unsupported operations retain no subtree.
(define (tc-infer-selected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (if (tc-type-env-scoped-identity-exhausted? env)
    (TcSelectedResult.Err (tc-selected-error typed.TypedError.Exhausted) sink)
    (match sink
      [(TcSelectedSink.Query)
        (tc-infer-selected-inner
          ctx
          env
          expr
          syntax
          expected
          source
          TcSelectedSink.Query)]
      [(TcSelectedSink.Capture store lease bindings)
        (match (tc-selected-context-lease-ok ctx lease)
          [(typed.TypedResult.Err error)
            (TcSelectedResult.Err
              (tc-selected-error error)
              (TcSelectedSink.Capture store lease bindings))]
          [(typed.TypedResult.Ok _)
            (match (typed.typed-attempt-begin!
              store
              lease
              typed.TypedMode.Executable)
              [(typed.TypedAttemptResult.Err error)
                (TcSelectedResult.Err
                  (tc-selected-error error)
                  (TcSelectedSink.Capture store lease bindings))]
              [(typed.TypedAttemptResult.Ok attempt)
                (tc-selected-attempt-finish
                  attempt
                  bindings.len
                  (tc-infer-selected-inner
                    ctx
                    env
                    expr
                    syntax
                    expected
                    source
                    (TcSelectedSink.Capture store lease bindings)))])])])))

(define (tc-selected-context-lease-ok
  [ctx : TcContext]
  [lease : (& lease (typed.TypedBodyLease intern))]) : typed.TypedResult
  ;; Read only the scalar identities, in place: this runs for every inferred
  ;; expression, and copying the whole source session and body-state records
  ;; cost more than the comparisons.
  (let
    [names : ci.InternSourceNameSessionHandle (tc-context-source-names ctx)]
    [table-id : i64 (ci.intern-source-name-session-handle-table-id names)]
    [generation : i64
      (ci.intern-source-name-session-handle-reset-generation names)]
    [pools : ast.AstNodePoolContext (tc-context-pools ctx)]
    [reader-pools : ast.AstNodePoolContext (tc-context-expr-reader-pools ctx)]
    [body-state : (Ptr TcBodyStateData)
      (tc-body-state-view (tc-context-body-state ctx))]
    (if (and
      lease.live?
      (=
        (unsafe
          (deref body-state).selected-owner)
        lease.body.owner)
      (=
        (unsafe
          (deref body-state).selected-revision)
        lease.body.revision)
      (= (cast generation : u64) lease.body.generation)
      (= table-id (ci.intern-compat-state-table-id lease.intern-state))
      (= generation (ci.intern-compat-state-generation lease.intern-state))
      (= pools.expr-pool lease.pools.expr-pool)
      (= pools.type-pool lease.pools.type-pool)
      (= pools.owner-arena lease.pools.owner-arena)
      (= reader-pools.expr-pool lease.pools.expr-pool)
      (= reader-pools.type-pool lease.pools.type-pool)
      (= reader-pools.owner-arena lease.pools.owner-arena))
      (typed.TypedResult.Ok unit)
      (typed.TypedResult.Err typed.TypedError.Lease))))

(define (tc-infer-selected-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (if (tc-type-env-scoped-identity-exhausted? env)
    (TcSelectedResult.Err (tc-selected-error typed.TypedError.Exhausted) sink)
    (match sink
      [(TcSelectedSink.Query)
        (tc-semantic-unobserved
          ctx
          (tc-infer-selected-id-validated
            ctx
            env
            expr-id
            expected
            source
            (tc-context-expr-query-id-ok ctx expr-id)
            TcSelectedSink.Query))]
      [(TcSelectedSink.Capture store lease bindings)
        (match (tc-selected-context-lease-ok ctx lease)
          [(typed.TypedResult.Err error)
            (tc-selected-failed error store lease bindings)]
          [(typed.TypedResult.Ok _)
            (match (typed.typed-lease-ok (& store) lease)
              [(typed.TypedResult.Err error)
                (tc-selected-failed error store lease bindings)]
              [(typed.TypedResult.Ok _)
                (let
                  [tail : i64
                    (tc-selected-receiver-tail-take! (&mut bindings) expr-id)]
                  (if (>= tail 0)
                    (tc-infer-selected-receiver-tail
                      ctx
                      env
                      expr-id
                      (= tail 1)
                      source
                      (TcSelectedSink.Capture store lease bindings))
                    (tc-infer-selected-id-validated
                      ctx
                      env
                      expr-id
                      expected
                      source
                      (tc-selected-id-bound-ok
                        expr-id
                        (ast.ast-node-pool-context-expr-len lease.pools))
                      (TcSelectedSink.Capture store lease bindings))))])])])))

(define (tc-infer-selected-id-validated
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [read-ok : typed.TypedResult]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match read-ok
    [(typed.TypedResult.Err error)
      (TcSelectedResult.Err (tc-selected-error error) sink)]
    [(typed.TypedResult.Ok _)
      (let
        ;; A body type fact is the expression's intrinsic type; divergence,
        ;; move-tail and region consumers read it as such. Under an expected
        ;; type the result is the contextual use (a diverging call coerced to
        ;; its arm's type, a literal adopting its annotation), which is an
        ;; adjustment rather than the expression's type. Record only
        ;; unadjusted results, as the legacy expected-type path does.
        [intrinsic? : bool
          (match (& expected)
            [(ast.AstMaybeType.No) true]
            [(ast.AstMaybeType.Some _) false])]
        [observed? : bool (tc-semantic-capture-observed? ctx (& sink))]
        (when observed? (tc-semantic-observe-enter! ctx env expr-id))
        (match (tc-infer-selected
          ctx
          env
          (tc-context-expr-get ctx expr-id)
          (typed.TypedSyntax.Source expr-id)
          expected
          source
          sink)
          [(TcSelectedResult.Ok ty occurrence next)
            (when
              intrinsic?
              (tc-body-type-fact-record!
                (tc-context-body-state ctx)
                expr-id
                (tc-global-shared-view ty)))
            (when
              observed?
              (tc-semantic-observe-expression!
                ctx
                env
                expr-id
                (ResultTcType.Ok (tc-global-shared-view ty))))
            (TcSelectedResult.Ok ty occurrence next)]
          [(TcSelectedResult.Err message next)
            (when
              observed?
              (tc-semantic-observe-expression!
                ctx
                env
                expr-id
                (ResultTcType.Err (tc-global-shared-view message))))
            (TcSelectedResult.Err message next)]))]))

(define (tc-infer-selected-literal-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [literal : ast.AstLiteral]
  [expected : ast.AstMaybeType]) : ResultTcType
  (match expected
    [(ast.AstMaybeType.No) (tc-literal-type-checked literal)]
    [(ast.AstMaybeType.Some want)
      (match (tc-global-shared-view literal)
        [(ast.AstLiteral.Int value text)
          (tc-integer-literal-type-with-expected ctx value text want)]
        [(ast.AstLiteral.Float text)
          (tc-float-literal-type-with-expected text want)]
        [_
          (tc-expr-result-with-expected-or-actual
            ctx
            env
            want
            false
            (tc-literal-type-checked literal))])]))

(define (tc-infer-selected-inner
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-global-shared-view expr)
    [(ast.AstExpr.Spanned inner-id span)
      (let
        [inner : ast.AstExpr (tc-context-expr-get ctx inner-id)]
        ;; An expansion is transparent: its expanded body is the occurrence, and
        ;; its frame travels in the provenance of everything inside it. An
        ;; unsafe block is a sequence checked in the unsafe context.
        (match (tc-global-shared-view inner)
          [(ast.AstExpr.MacroExpansion expanded provenance-id macro-name-id)
            (let
              [observed? : bool (tc-semantic-capture-observed? ctx (& sink))]
              [_enter : unit
                (when
                  observed?
                  (tc-semantic-observer-send!
                    (tc-context-semantic-observer ctx)
                    ctx
                    env
                    (ExpansionEnter
                      (macro-expansion-origin-path-id provenance-id)
                      macro-name-id
                      span)))]
              [result : (TcSelectedResult store lease intern bind)
                (match (tc-infer-selected-result-id
                  ctx
                  env
                  (& syntax)
                  expanded
                  expected
                  (tc-selected-expansion-source
                    (& source)
                    span
                    provenance-id
                    macro-name-id)
                  sink)
                  [(TcSelectedResult.Ok ty occurrence next)
                    (TcSelectedResult.Ok ty occurrence next)]
                  [(TcSelectedResult.Err message next)
                    (let
                      [compact? : bool
                        (=
                          macro-name-id
                          (ctfe_support.ctfe-compact-caller-origin-name))]
                      (tc-selected-unrepresented
                        (tc-macro-expansion-result-with-frame
                          ctx
                          expanded
                          compact?
                          (macro-expansion-invocation-path-id provenance-id)
                          (macro-expansion-origin-path-id provenance-id)
                          macro-name-id
                          span
                          ;; A compact caller operand has no Spanned row of
                          ;; its own; locate its error with full context, as
                          ;; `tc-check-operand-view` does, so an unbound name
                          ;; keeps its suggestion.
                          (if compact?
                            (tc-locate-spanned-error-with-context
                              ctx
                              env
                              (tc-context-expr-get ctx expanded)
                              span
                              message)
                            (ResultTcType.Err message)))
                        next))])]
              (when
                observed?
                (tc-semantic-observer-send!
                  (tc-context-semantic-observer ctx)
                  ctx
                  env
                  ExpansionLeave))
              result)]
          [(ast.AstExpr.Unsafe exprs)
            (match (tc-infer-selected-unsafe
              ctx
              env
              (& exprs)
              syntax
              expected
              (TcMaybeAstSourceSpan.Some span)
              (ownership.OwnershipSource
                source.path
                (tc-selected-span-line source.line span)
                (tc-selected-span-column source.column span)
                source.expansion)
              sink)
              [(TcSelectedResult.Ok ty occurrence next)
                (TcSelectedResult.Ok ty occurrence next)]
              [(TcSelectedResult.Err message next)
                (tc-selected-unrepresented
                  (tc-locate-spanned-error-with-context
                    ctx
                    env
                    inner
                    span
                    message)
                  next)])]
          [_
            (match (tc-infer-selected-result-id
              ctx
              env
              (& syntax)
              inner-id
              expected
              (ownership.OwnershipSource
                source.path
                (tc-selected-span-line source.line span)
                (tc-selected-span-column source.column span)
                source.expansion)
              sink)
              [(TcSelectedResult.Ok ty occurrence next)
                (TcSelectedResult.Ok ty occurrence next)]
              [(TcSelectedResult.Err message next)
                (tc-selected-unrepresented
                  (tc-locate-spanned-error-with-context
                    ctx
                    env
                    inner
                    span
                    message)
                  next)])]))]
    [(ast.AstExpr.Literal literal)
      (tc-selected-publish
        (tc-infer-selected-literal-type
          ctx
          env
          (tc-global-shared-view literal)
          expected)
        syntax
        source
        (typed.TypedOperation.Literal literal)
        (tc-selected-no-occurrences)
        sink)]
    [(ast.AstExpr.Var name)
      ;; A dotted local place becomes its `StructGet` chain (the canonical
      ;; source rewrite legacy typing applies too). Ordinary and generated
      ;; undotted reads retain the successful lexical winner.
      (if (<
        (tc-dotted-name-first-dot-id (tc-context-structural-session ctx) name)
        0)
        (match (tc-selected-expected-var-retarget!
          ctx
          env
          syntax
          name
          (tc-global-shared-view expected))
          [(ResultTcNameId.Err message) (TcSelectedResult.Err message sink)]
          [(ResultTcNameId.Ok resolved)
            (tc-infer-selected-var ctx env resolved syntax expected source sink)])
        (match (tc-selected-dotted-field ctx env syntax)
          [(TcSelectedDotted.Field rewritten)
            (tc-infer-selected-inner
              ctx
              env
              rewritten
              syntax
              expected
              source
              sink)]
          [(TcSelectedDotted.Err message) (TcSelectedResult.Err message sink)]
          [(TcSelectedDotted.No)
            (tc-infer-selected-qualified-value
              ctx
              env
              (tc-global-shared-view expr)
              name
              syntax
              expected
              source
              sink)]))]
    [(ast.AstExpr.Set name value-id)
      (cond
        [(<
            (tc-dotted-name-first-dot-id
              (tc-context-structural-session ctx)
              name)
            0)
          (tc-selected-contextual-result
            ctx
            env
            expected
            (tc-infer-selected-set ctx env name value-id syntax source sink))]
        ;; A dotted place (an ordinary or hygienic local's field path) is the
        ;; same field store legacy typing checks. A source node is rewritten
        ;; in place, as legacy normalization rewrites it: lowering reads the
        ;; field store there.
        [(tc-dotted-place-name-id? ctx env name)
          (match (match syntax
            [(typed.TypedSyntax.Source id)
