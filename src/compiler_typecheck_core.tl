  (Missing)
  (Found i64))

(defenum ResultTcUnit
  (Ok)
  (Err String))

;; Convert selected coordinates only at direct borrow-policy/type rejections.
;; Legacy views already carry their complete span.
(defenum TcBorrowSource
  (No)
  (Selected i64 i64)
  (Spanned ast.AstSourceSpan))

(define (tc-borrow-source-error [source : TcBorrowSource] [message : String]) : String
  (match source
    [(TcBorrowSource.Selected line column)
      (if (and (> line 0) (> column 0))
        (tc-located-error (ast.ast-source-span line column line column) message)
        message)]
    [(TcBorrowSource.Spanned span) (tc-located-error span message)]
    [(TcBorrowSource.No) message]))

(defenum TcMoveKind
  (Copyable)
  (MoveOnly))

;; Lifetime variance is a checker-only property. It never enters AstType,
;; symbol identity, layout, mangling, or either ABI.
(defenum TcVariance
  (TcVarianceBivariant)
  (TcVarianceCovariant)
  (TcVarianceContravariant)
  (TcVarianceInvariant))

(defenum TcSpmdClass
  (Uniform)
  (Varying))

(defenum TcSpmdScope
  (Outer)
  (Local))

(defenum TcSpmdRole
  (Value)
  (ForeachIndex)
  ;; A read-only coordinate of a rank-2 foreach domain: its ordinal in
  ;; binding order (0 outer, 1 inner), then for the inner coordinate the ids
  ;; of the header's begin and end expressions when each is a stable atom
  ;; (an integer literal, or a variable the body never assigns), else -1.
  ;; The final field is the domain body id, used to reject mutable offsets.
  ;; The row-major write proof compares the body's span against those atoms.
  (ForeachCoordinate i64 i64 i64 i64)
  (CompactIndex)
  (CompactSlot)
  ;; A sentinel above an ordered scan body's bindings (and a helper's, when
  ;; the scan body calls it): iterations run in scalar order, so a varying
  ;; write there needs no disjoint destination.
  (ScanBody)
  ;; foreach-active (#8306): the read-only lane binding, and the two sentinel
  ;; bindings the walker pushes. A barrier opens a foreach-active body; an
  ;; opening starts a lane-value operand. Sentinels carry a name no source
  ;; binding has.
  (ActiveLane)
  (ActiveBarrier)
  (LaneValueOpen))

(defstruct TcSpmdBinding
  (name i64)
  (ty ast.AstType)
  (class TcSpmdClass)
  (scope TcSpmdScope)
  (role TcSpmdRole))

(defstruct TcSpmdEnv
  ;; The address of the first binding. Every update copies the bindings into
  ;; a fresh array, so no environment writes the bindings it holds; keeping
  ;; their address instead of the array makes this Copy.
  (bindings u64)
  (len i64))

(defstruct TcSpmdEnvMark
  (len i64))

