    [(AstExpr.Unquote _)
      (ResultTcType.Err "typecheck: unquote is only valid inside quasiquote")]
    [(AstExpr.UnquoteSplicing _)
      (ResultTcType.Err
        "typecheck: unquote-splicing is only valid inside quasiquote")]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-try-expr ctx env inner))]
    [(AstExpr.Return value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-return-expr ctx env value))]
    [(AstExpr.Break) (tc-loop-control-expr env "break")]
    [(AstExpr.Continue) (tc-loop-control-expr env "continue")]
    [(AstExpr.PtrNull ty)
      (let
        [resolved : AstType (tc-resolve-type ctx ty)]
        (match resolved
          [(AstType.Ptr _) (ResultTcType.Ok resolved)]
          [(AstType.MutPtr _) (ResultTcType.Ok resolved)]
          [_
            (ResultTcType.Err
              "typecheck: ptr-null requires a pointer type, e.g. (ptr-null : (Ptr i64))")]))]
    [(AstExpr.PtrNullCheck inner-box)
      (match (tc-expr-id ctx env inner-box)
        [(ResultTcType.Ok inner-ty)
          (match (tc-type-strip-region inner-ty)
            [(AstType.Ptr _) (ResultTcType.Ok (AstType.Bool))]
            [(AstType.MutPtr _) (ResultTcType.Ok (AstType.Bool))]
            [_
              (ResultTcType.Err
                "typecheck: ptr-null? requires a raw pointer operand")])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(AstExpr.PtrAddrOf place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (tc-ptr-addr-of-expr ctx env place))]
    [(AstExpr.PtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-ptr-read-expr ctx env ptr))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-ptr-write-expr ctx env ptr value))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (tc-ptr-offset-expr ctx env ptr offset))]
    [(AstExpr.PtrCast ptr-box target)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-ptr-cast-expr ctx env ptr target))]
    [(AstExpr.PtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-ptr-to-int-expr ctx env ptr))]
    [(AstExpr.IntToPtr value-box target)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-int-to-ptr-expr ctx env value target))]
    [(AstExpr.StringData str-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        (tc-string-data-expr ctx env str))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (tc-string-from-bytes-expr ctx env ptr len))]
    [(AstExpr.ArrayData array-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-array-data-expr ctx env array))]
    [(AstExpr.ProgramArgc) (ResultTcType.Ok (AstType.I64))]
    [(AstExpr.ProgramArgv) (tc-program-entry-ptr-expr env "program-argv")]
    [(AstExpr.ProgramEnvp) (tc-program-entry-ptr-expr env "program-envp")]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-cpuid-expr ctx env leaf subleaf))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-cpuid-expr ctx env leaf subleaf))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-cpuid-expr ctx env leaf subleaf))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-cpuid-expr ctx env leaf subleaf))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (tc-xgetbv-expr ctx env index))]
    [(AstExpr.Syscall args) (tc-syscall-expr ctx env args)]
    [_ (ResultTcType.Err "typecheck: unsupported expression")]))

(define (tc-expr [ctx : TcContext] [env : TcTypeEnv] [expr : AstExpr]) : ResultTcType
  (if (and (tc-type-env-scoped-runtime-active?) (tc-expr-scoped-bindings? expr))
    (let
      [saved : TcTypeEnvScopedRuntimeSave (tc-type-env-scoped-runtime-save)]
      [result : ResultTcType (tc-expr-inner ctx env expr)]
      (begin
        (tc-type-env-scoped-runtime-restore! saved)
        result))
    (tc-expr-inner ctx env expr)))

(define (tc-extern-abi-enum-aggregate-type? [ty : AstType]) : bool
  (match (tc-type-without-regions ty)
    [(AstType.Enum _) true]
    [(AstType.EnumArgs _ _) true]
    [_ false]))

(define (tc-extern-abi-inline-enum-type-ok? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-without-regions ty)
    [(AstType.Enum name)
      (match (tc-inline-aggregate-layout-for-with-stack
        ctx
        (tc-nominal-name-id-display name)
        name
        TcStringList.Nil)
        [(ResultTcInlineAggregateLayout.Ok layout)
          (match layout
            [(TcInlineAggregateLayout.Enum _ _ _) true]
            [_ false])]
        [(ResultTcInlineAggregateLayout.Err _) false])]
    [(AstType.EnumArgs name _)
      (match (tc-inline-aggregate-layout-for-with-stack
        ctx
        (tc-nominal-name-id-display name)
        name
        TcStringList.Nil)
        [(ResultTcInlineAggregateLayout.Ok layout)
          (match layout
            [(TcInlineAggregateLayout.Enum _ _ _) true]
            [_ false])]
        [(ResultTcInlineAggregateLayout.Err _) false])]
    [_ false]))

(define (tc-extern-abi-value-type-ok? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-without-regions ty)
    [(AstType.I64) true]
    [(AstType.I32) true]
    [(AstType.I16) true]
    [(AstType.I8) true]
    [(AstType.U64) true]
    [(AstType.U32) true]
    [(AstType.U16) true]
    [(AstType.U8) true]
    [(AstType.F64) true]
    [(AstType.F32) true]
    [(AstType.Bool) true]
    [(AstType.Char) true]
    [(AstType.Unit) true]
    [(AstType.Never) true]
    [(AstType.Func _ _) true]
    [(AstType.Ptr _) true]
    [(AstType.MutPtr _) true]
    [(AstType.String) true]
    [(AstType.DynArray _) true]
    [(AstType.Enum _) (tc-extern-abi-inline-enum-type-ok? ctx ty)]
    [(AstType.EnumArgs _ _) (tc-extern-abi-inline-enum-type-ok? ctx ty)]
    [(AstType.Struct _) true]
    [(AstType.StructArgs _ _) true]
    [_ false]))

(define (tc-extern-abi-unsupported-message [position : String] [ty : AstType]) : String
  (if (tc-extern-abi-enum-aggregate-type? ty)
    (string.append
      "typecheck: extern ABI c does not support enum aggregate "
      (string.append position (string.append " type " (tc-type-render ty))))
    (string.append
      "typecheck: extern ABI c does not support "
      (string.append position (string.append " type " (tc-type-render ty))))))

(define (tc-check-extern-arg-abi [ctx : TcContext] [args : AstTypeList]) : ResultTcUnit
  (tc-check-extern-arg-abi-at ctx (& args) 0))

(define (tc-check-extern-arg-abi-at
  [ctx : TcContext]
  [args : (& args AstTypeList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-type-list-len args))
    ResultTcUnit.Ok
    (let
      [head : AstType
        (ty-node-get (ast-type-list-get args index (ast-type-id-fallback)))]
      (if (tc-extern-abi-value-type-ok? ctx head)
        (tc-check-extern-arg-abi-at ctx args (+ index 1))
        (ResultTcUnit.Err (tc-extern-abi-unsupported-message "parameter" head))))))

(define (tc-check-extern-c-abi [ctx : TcContext] [ty : AstType]) : ResultTcUnit
  (match ty
    [(AstType.Func args ret)
      (match (tc-check-extern-arg-abi ctx (box-get args))
        [(ResultTcUnit.Ok)
          (if (tc-extern-abi-value-type-ok? ctx (ty-node-get ret))
            ResultTcUnit.Ok
            (ResultTcUnit.Err
              (tc-extern-abi-unsupported-message "return" (ty-node-get ret))))]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [_ (ResultTcUnit.Err "typecheck: extern must have function type")]))

(define (tc-check-extern-value-c-abi [ctx : TcContext] [ty : AstType]) : ResultTcUnit
  (match ty
    [(AstType.Func _ _) (tc-check-extern-c-abi ctx ty)]
    [_
      (if (tc-extern-abi-value-type-ok? ctx ty)
        ResultTcUnit.Ok
        (ResultTcUnit.Err (tc-extern-abi-unsupported-message "value" ty)))]))

(define (tc-check-extern-varargs-tail-type
  [ctx : TcContext]
  [abi : AstExternAbi]) : ResultTcUnit
  (if (ast-extern-abi-c-varargs-typed? abi)
    (let
      [tail-ty : AstType
        (tc-resolve-type ctx (ast-extern-abi-varargs-tail-type abi))]
      (if (tc-extern-abi-value-type-ok? ctx tail-ty)
        ResultTcUnit.Ok
        (ResultTcUnit.Err
          (tc-extern-abi-unsupported-message "variadic argument" tail-ty))))
    ResultTcUnit.Ok))

(define (tc-check-extern-decl
  [ctx : TcContext]
  [kind : AstExternKind]
  [metadata : AstExternMetadata]
  [ty : AstType]) : ResultTcUnit
  (match metadata
    [(AstExternMetadata.Metadata abi _ _ explicit-abi)
      (let
        [resolved : AstType (tc-resolve-type ctx ty)]
        (match kind
          [(AstExternKind.Function)
            (if (and
              (ast-extern-abi-c? abi)
              (or explicit-abi (ast-extern-abi-c-varargs? abi)))
              (match (tc-check-extern-c-abi ctx resolved)
                [(ResultTcUnit.Ok)
                  (if (ast-extern-abi-c-varargs? abi)
                    (tc-check-extern-varargs-tail-type ctx abi)
                    ResultTcUnit.Ok)]
                [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])
              ResultTcUnit.Ok)]
          [(AstExternKind.Value)
            (if (ast-extern-abi-c-varargs? abi)
              (ResultTcUnit.Err
                "typecheck: extern value cannot use c-varargs ABI")
              (tc-check-extern-value-c-abi ctx resolved))]))]))

(define (tc-summary-add-decl
  [summary : CompilerTypecheckSummary]
  [decl : AstDecl]) : CompilerTypecheckSummary
  (match summary
    [(CompilerTypecheckSummary values functions externs)
      (match decl
        [(AstDecl.Def decl-meta _ _ _)
          (CompilerTypecheckSummary (+ values 1) functions externs)]
        [(AstDecl.DefFn decl-meta _ _ _ _ _)
          (CompilerTypecheckSummary values (+ functions 1) externs)]
        [(AstDecl.Extern decl-meta _ _ _ _)
          (CompilerTypecheckSummary values functions (+ externs 1))]
        [(AstDecl.Unsafe inner-box)
          (let
            [inner : AstDecl (box-get inner-box)]
            (tc-summary-add-decl summary inner))]
        [_ summary])]))

(define (tc-macro-signature-type [ty : AstType]) : AstType
  (match ty
    [(AstType.Var name)
      (match (tc-macro-signature-stdlib-comptime-type-id name)
        [(AstMaybeType.Some syntax-ty) syntax-ty]
        [(AstMaybeType.No)
          (cond
            [(= name cbi.compiler-builtin-id-fix-Expr) (AstType.Expr)]
            [(= name cbi.compiler-builtin-id-fix-ExprList) (AstType.ExprList)]
            [(= name cbi.compiler-builtin-id-fix-ExprClause)
              (tc-macro-expr-clause-type)]
            [(= name cbi.compiler-builtin-id-fix-ExprClauseList)
              (tc-macro-expr-clause-list-type)]
            [(= name cbi.compiler-builtin-id-fix-ExprBindingClause)
              (tc-macro-expr-binding-clause-type)]
            [(= name cbi.compiler-builtin-id-fix-ExprBindingClauseList)
              (tc-macro-expr-binding-clause-list-type)]
            [(= name cbi.compiler-builtin-id-fix-Pattern)
              (tc-macro-pattern-type)]
            [(= name cbi.compiler-builtin-id-fix-PatternList)
              (tc-macro-pattern-list-type)]
            [(= name cbi.compiler-builtin-id-fix-MatchArm)
              (tc-macro-match-arm-type)]
            [(= name cbi.compiler-builtin-id-fix-MatchArmList)
              (tc-macro-match-arm-list-type)]
            [else ty])])]
    [(AstType.VarArgs name _)
      (match (tc-macro-signature-stdlib-comptime-type-id name)
        [(AstMaybeType.Some syntax-ty) syntax-ty]
        [(AstMaybeType.No) ty])]
    [(AstType.Enum name)
      (match (tc-macro-signature-stdlib-comptime-type-id name)
        [(AstMaybeType.Some syntax-ty) syntax-ty]
        [(AstMaybeType.No) ty])]
    [(AstType.EnumArgs name _)
      (match (tc-macro-signature-stdlib-comptime-type-id name)
        [(AstMaybeType.Some syntax-ty) syntax-ty]
        [(AstMaybeType.No) ty])]
    [(AstType.Struct name)
      (match (tc-macro-signature-stdlib-comptime-type-id name)
        [(AstMaybeType.Some syntax-ty) syntax-ty]
        [(AstMaybeType.No) ty])]
    [(AstType.StructArgs name _)
      (match (tc-macro-signature-stdlib-comptime-type-id name)
        [(AstMaybeType.Some syntax-ty) syntax-ty]
        [(AstMaybeType.No) ty])]
    [_ ty]))

(define (tc-macro-produced-type-compatible?
  [ctx : TcContext]
  [ret : AstType]
  [produced : AstType]) : bool
  (let
    [expected : AstType (tc-resolve-type ctx (tc-macro-signature-type ret))]
    (or
      (tc-type-eq expected (AstType.Expr))
      (tc-type-eq produced (AstType.Expr))
      (ctfe-untyped-expr-type? produced)
      (ctfe-captured-expr-type? produced)
      (tc-type-compatible? expected (tc-resolve-type ctx produced)))))

(define (tc-check-defmacro-produced-type
  [ctx : TcContext]
  [ret : AstType]
  [value : CompilerCtfeValue]) : ResultTcUnit
  (if (tc-macro-result-module? ret)
    (match value
      [(CompilerCtfeValue.Expr _ _) ResultTcUnit.Ok]
      [_ (ResultTcUnit.Err "typecheck: Module macro body must return Expr")])
    (if (tc-macro-result-decls? ret)
      (match value
        [(CompilerCtfeValue.Expr _ _) ResultTcUnit.Ok]
        [_ (ResultTcUnit.Err "typecheck: Decls macro body must return Expr")])
      (match value
        [(CompilerCtfeValue.Expr _ produced)
          (if (tc-macro-produced-type-compatible? ctx ret produced)
            ResultTcUnit.Ok
            (ResultTcUnit.Err
              "typecheck: macro body produced type does not match declaration"))]
        [_ (ResultTcUnit.Err "typecheck: macro body must return Expr")]))))

(define (tc-comptime-purity-chain-push [chain : TcStringList] [name : String]) : TcStringList
  (TcStringList.Cons name (box chain)))

(define (tc-comptime-purity-chain-render [chain : TcStringList]) : String
  (match chain
    [(TcStringList.Nil) ""]
    [(TcStringList.Cons head rest)
      (let
        [tail : String (tc-comptime-purity-chain-render (box-get rest))]
        (if (string.eq tail "")
          head
          (str_cat.str-cat tail " -> " head)))]))

(define (tc-comptime-purity-chain-path [chain : TcStringList] [name : String]) : String
  (let
    [prefix : String (tc-comptime-purity-chain-render chain)]
    (if (string.eq prefix "")
      name
      (str_cat.str-cat prefix " -> " name))))

(define (tc-comptime-purity-error
  [expr : AstExpr]
  [chain : TcStringList]
  [name : String]
  [reason : String]) : ResultTcUnit
  (ResultTcUnit.Err
    (tc-locate-error-at-expr
      expr
      (str_cat.str-cat
        "typecheck: comptime purity rejects "
        reason
        "; reference path: "
        (tc-comptime-purity-chain-path chain name)))))

(define (tc-comptime-purity-banned-module? [module : String]) : bool
  (cond
    [(string.eq module "io") true]
    [(string.eq module "stdlib.io") true]
    [(string.eq module "stdlib/io") true]
    [(string.eq module "fs") true]
    [(string.eq module "stdlib.fs") true]
    [(string.eq module "stdlib/fs") true]
    [(string.eq module "process") true]
    [(string.eq module "stdlib.process") true]
    [(string.eq module "stdlib/process") true]
    [(string.eq module "stdlib.process-runtime") true]
    [(string.eq module "stdlib/process_runtime") true]
    [(string.eq module "env") true]
    [(string.eq module "stdlib.env") true]
    [(string.eq module "stdlib/env") true]
    [else false]))

(define (tc-comptime-purity-banned-qualified?
  [ctx : TcContext]
  [_ : String]
  [name-id : i64]) : bool
  (let
    [source-id : i64 (macro-hygiene-global-source-name-id-or name-id name-id)]
    (if (tc-name-qualified-id? source-id)
      (let
        [qualifier-id : i64 (tc-qualified-name-module-id source-id)]
        [target-id : i64
          (tc-qualified-access-target-module-id ctx qualifier-id)]
        [qualifier : String (intern-str qualifier-id)]
        [target : String (intern-str target-id)]
        (or
          (tc-comptime-purity-banned-module? qualifier)
          (tc-comptime-purity-banned-module? target)))
      false)))

(define (tc-comptime-purity-ctfe-builtin? [name : String] [name-id : i64]) : bool
  (let
    [lookup-name : String (tc-hygiene-global-call-name name)]
    [lookup-id : i64 (macro-hygiene-global-source-name-id-or name-id name-id)]
    [call-id : i64 (ctfe-comptime-helper-call-name-id lookup-id)]
    (cond
      [(ctfe-builtin-size-align-id? lookup-id) true]
      [(ctfe-builtin-offset-of-id? lookup-id) true]
      [(ctfe-builtin-reflection-id? call-id) true]
      [(ctfe-string-eq-helper-name-id? lookup-name lookup-id) true]
      [(ctfe-builtin-string-build-id? call-id) true]
      [(ctfe-string-length-helper-name-id? lookup-name lookup-id) true]
      [(ctfe-string-ref-helper-name-id? lookup-name lookup-id) true]
      [(ctfe-string-to-int-helper-name-id? lookup-name lookup-id) true]
      [(ctfe-builtin-int-to-string-id? call-id) true]
      [(ctfe-builtin-source-helper-id? call-id) true]
      [(ctfe-builtin-expr-clause-list-inspector-id? call-id) true]
      [(ctfe-builtin-expr-binding-clause-list-inspector-id? call-id) true]
      [(ctfe-builtin-comptime-error-id? call-id) true]
      [else false])))

(define (tc-macro-param-list-add-bound-names
  [params : AstMacroParamList]
  [bound : TcStringList]) : TcStringList
  (tc-macro-param-list-add-bound-names-at (& params) 0 bound))

(define (tc-macro-param-list-add-bound-names-at
  [params : (& params AstMacroParamList)]
  [index : i64]
  [bound : TcStringList]) : TcStringList
  (if (>= index (ast-macro-param-list-len params))
    bound
    (match (ast-macro-param-list-get params index (ast-macro-param-fallback))
      [(AstMacroParam.Param name _ _ _)
        (tc-macro-param-list-add-bound-names-at
          params
          (+ index 1)
          (tc-string-list-add bound (tc-env-key-name-text name)))])))

(define (tc-macro-param-bound-names [params : AstMacroParamList]) : TcStringList
  (tc-macro-param-list-add-bound-names params TcStringList.Nil))

(define (tc-comptime-purity-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [expr : AstExpr]) : ResultTcUnit
  (tc-comptime-purity-expr-mode ctx env bound chain seen false expr))

(define (tc-comptime-purity-node-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [expr-id : i64]) : ResultTcUnit
  (tc-comptime-purity-expr-mode
    ctx
    env
    bound
    chain
    seen
    template?
    (ast-node-get expr-id)))

(define (tc-comptime-purity-node2-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [left : i64]
  [right : i64]) : ResultTcUnit
  (match (tc-comptime-purity-node-mode ctx env bound chain seen template? left)
    [(ResultTcUnit.Ok)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? right)]
    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))

(define (tc-comptime-purity-node3-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [first : i64]
  [second : i64]
  [third : i64]) : ResultTcUnit
  (match (tc-comptime-purity-node-mode ctx env bound chain seen template? first)
    [(ResultTcUnit.Ok)
      (match (tc-comptime-purity-node-mode
        ctx
        env
        bound
        chain
        seen
        template?
        second)
        [(ResultTcUnit.Ok)
          (tc-comptime-purity-node-mode
            ctx
            env
            bound
            chain
            seen
            template?
            third)]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))

(define (tc-comptime-purity-template-bound
  [template? : bool]
  [bound : TcStringList]
  [name : i64]) : TcStringList
  (if template?
    bound
    (tc-string-list-add bound (tc-env-key-name-text name))))

(define (tc-comptime-purity-reject-or-template-ok
  [expr : AstExpr]
  [chain : TcStringList]
  [template? : bool]
  [name : String]
  [reason : String]) : ResultTcUnit
  (if template?
    ResultTcUnit.Ok
    (tc-comptime-purity-error expr chain name reason)))

(define (tc-comptime-purity-reject-or-template-node
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [expr : AstExpr]
  [name : String]
  [reason : String]
  [inner : i64]) : ResultTcUnit
  (if template?
    (tc-comptime-purity-node-mode ctx env bound chain seen true inner)
    (tc-comptime-purity-error expr chain name reason)))

(define (tc-comptime-purity-reject-or-template-node2
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [expr : AstExpr]
  [name : String]
  [reason : String]
  [left : i64]
  [right : i64]) : ResultTcUnit
  (if template?
    (tc-comptime-purity-node2-mode ctx env bound chain seen true left right)
    (tc-comptime-purity-error expr chain name reason)))

(define (tc-comptime-purity-expr-list-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [exprs : AstExprList]) : ResultTcUnit
  (tc-comptime-purity-expr-list-mode-at
    ctx
    env
    bound
    chain
    seen
    template?
    (& exprs)
    0))

(define (tc-comptime-purity-expr-list-mode-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get exprs len))
    ResultTcUnit.Ok
    (match (tc-comptime-purity-node-mode
      ctx
      env
      bound
      chain
      seen
      template?
      (ast-expr-list-get exprs index 0))
      [(ResultTcUnit.Ok)
        (tc-comptime-purity-expr-list-mode-at
          ctx
          env
          bound
          chain
          seen
          template?
          exprs
          (+ index 1))]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

(define (tc-comptime-purity-expr-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [exprs : AstExprList]) : ResultTcUnit
  (tc-comptime-purity-expr-list-mode ctx env bound chain seen false exprs))

(define (tc-comptime-purity-let-bindings-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [bindings : AstLetBindingList]) : ResultTcStringList
  (tc-comptime-purity-let-bindings-mode-at
    ctx
    env
    bound
    chain
    seen
    template?
    (& bindings)
    0))

(define (tc-comptime-purity-let-bindings-mode-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : ResultTcStringList
  (if (>= index (ast-let-binding-list-len bindings))
    (ResultTcStringList.Ok bound)
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding name _ init-box)
        (match (tc-comptime-purity-node-mode
          ctx
          env
          bound
          chain
          seen
          template?
          init-box)
          [(ResultTcUnit.Ok)
            (tc-comptime-purity-let-bindings-mode-at
              ctx
              env
              (tc-macro-abstract-binding-bound
                bound
                name
                (ast-node-get init-box)
                template?)
              chain
              seen
              template?
              bindings
              (+ index 1))]
          [(ResultTcUnit.Err message) (ResultTcStringList.Err message)])])))

(define (tc-comptime-purity-resource-bindings-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [bindings : AstResourceBindingList]) : ResultTcStringList
  (tc-comptime-purity-resource-bindings-mode-at
    ctx
    env
    bound
    chain
    seen
    template?
    (& bindings)
    0))

(define (tc-comptime-purity-resource-bindings-mode-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [bindings : (& bindings AstResourceBindingList)]
  [index : i64]) : ResultTcStringList
  (if (>= index (ast-resource-binding-list-len bindings))
    (ResultTcStringList.Ok bound)
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding name init-box cleanup-box)
        (match (tc-comptime-purity-node2-mode
          ctx
          env
          bound
          chain
          seen
          template?
          init-box
          cleanup-box)
          [(ResultTcUnit.Ok)
            (tc-comptime-purity-resource-bindings-mode-at
              ctx
              env
              (tc-comptime-purity-template-bound template? bound name)
              chain
              seen
              template?
              bindings
              (+ index 1))]
          [(ResultTcUnit.Err message) (ResultTcStringList.Err message)])])))

(define (tc-comptime-purity-match-arms-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [arms : AstMatchArmList]) : ResultTcUnit
  (tc-comptime-purity-match-arms-mode-at
    ctx
    env
    bound
    chain
    seen
    template?
    (& arms)
    0))

(define (tc-comptime-purity-match-arms-mode-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get arms len))
    ResultTcUnit.Ok
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (match (tc-comptime-purity-node-mode
          ctx
          env
          (if template?
            bound
            (tc-pattern-add-bound-names pattern bound))
          chain
          seen
          template?
          body-box)
          [(ResultTcUnit.Ok)
            (tc-comptime-purity-match-arms-mode-at
              ctx
              env
              bound
              chain
              seen
              template?
              arms
              (+ index 1))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])))

(define (tc-comptime-purity-expr-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [expr : AstExpr]) : ResultTcUnit
  (match expr
    [(AstExpr.Spanned inner-box _)
      (tc-comptime-purity-node-mode
        ctx
        env
        bound
        chain
        seen
        template?
        inner-box)]
    [(AstExpr.Literal _) ResultTcUnit.Ok]
    [(AstExpr.Var name)
      (if template?
        ResultTcUnit.Ok
        (tc-comptime-purity-var ctx env bound chain seen expr name))]
    [(AstExpr.Binary _ left right)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        left
        right)]
    [(AstExpr.Unary _ inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExpr.Call func args)
      (match (tc-macro-abstract-check-current-call
        bound
        template?
        expr
        (ast-node-get func)
        args)
        [(ResultTcUnit.Ok)
          (match (tc-comptime-purity-node-mode
            ctx
            env
            bound
            chain
            seen
            template?
            func)
            [(ResultTcUnit.Ok)
              (tc-comptime-purity-expr-list-mode
                ctx
                env
                bound
                chain
                seen
                template?
                args)]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [(AstExpr.If cond then-branch else-branch)
      (tc-comptime-purity-if-mode
        ctx
        env
        bound
        chain
        seen
        template?
        cond
        then-branch
        else-branch)]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body)
          (match (tc-comptime-purity-let-bindings-mode
            ctx
            env
            bound
            chain
            seen
            template?
            bindings)
            [(ResultTcStringList.Ok body-bound)
              (tc-comptime-purity-node-mode
                ctx
                env
                body-bound
                chain
                seen
                template?
                body)]
            [(ResultTcStringList.Err message) (ResultTcUnit.Err message)])])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params _ body)
          (tc-comptime-purity-node-mode
            ctx
            env
            (if template?
              bound
              (tc-param-list-add-bound-names params bound))
            chain
            seen
            template?
            body)])]
    [(AstExpr.Tuple exprs)
      (tc-comptime-purity-expr-list-mode
        ctx
        env
        bound
        chain
        seen
        template?
        exprs)]
    [(AstExpr.TupleRef tuple _)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? tuple)]
    [(AstExpr.Array exprs)
      (tc-comptime-purity-expr-list-mode
        ctx
        env
        bound
        chain
        seen
        template?
        exprs)]
    [(AstExpr.DynArray exprs)
      (tc-comptime-purity-expr-list-mode
        ctx
        env
        bound
        chain
        seen
        template?
        exprs)]
    [(AstExpr.MakeArray _ len)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? len)]
    [(AstExpr.ArrayRef array index)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        array
        index)]
    [(AstExpr.ArraySet array index value)
      (tc-comptime-purity-node3-mode
        ctx
        env
        bound
        chain
        seen
        template?
        array
        index
        value)]
    [(AstExpr.ArrayTake array live index)
      (tc-comptime-purity-node3-mode
        ctx
        env
        bound
        chain
        seen
        template?
        array
        live
        index)]
    [(AstExpr.ArrayPush array value)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        array
        value)]
    [(AstExpr.StringRef str index)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        str
        index)]
    [(AstExpr.While cond body)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        cond
        body)]
    [(AstExpr.Begin exprs)
      (tc-comptime-purity-expr-list-mode
        ctx
        env
        bound
        chain
        seen
        template?
        exprs)]
    [(AstExpr.Unsafe exprs)
      (if template?
        (tc-comptime-purity-expr-list-mode ctx env bound chain seen true exprs)
        (tc-comptime-purity-error expr chain "unsafe" "unsafe block"))]
    [(AstExpr.Set _ value)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? value)]
    [(AstExpr.Ann inner _)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExpr.Cast inner _)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExpr.Borrow _ _ place)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? place)]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrut arms)
          (match (tc-comptime-purity-node-mode
            ctx
            env
            bound
            chain
            seen
            template?
            scrut)
            [(ResultTcUnit.Ok)
              (tc-comptime-purity-match-arms-mode
                ctx
                env
                bound
                chain
                seen
                template?
                arms)]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach index _ start end body)
          (match (tc-comptime-purity-node2-mode
            ctx
            env
            bound
            chain
            seen
            template?
            start
            end)
            [(ResultTcUnit.Ok)
              (tc-comptime-purity-node-mode
                ctx
                env
                (tc-comptime-purity-template-bound template? bound index)
                chain
                seen
                template?
                body)]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce _ index _ start end init value)
          (match (tc-comptime-purity-node3-mode
            ctx
            env
            bound
            chain
            seen
            template?
            start
            end
            init)
            [(ResultTcUnit.Ok)
              (tc-comptime-purity-node-mode
                ctx
                env
                (tc-comptime-purity-template-bound template? bound index)
                chain
                seen
                template?
                value)]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan _ index _ start end prefix _ init value body)
          (match (tc-comptime-purity-node3-mode
            ctx
            env
            bound
            chain
            seen
            template?
            start
            end
            init)
            [(ResultTcUnit.Ok)
              (let
                [index-bound : TcStringList
                  (tc-comptime-purity-template-bound template? bound index)]
                (match (tc-comptime-purity-node-mode
                  ctx
                  env
                  index-bound
                  chain
                  seen
                  template?
                  value)
                  [(ResultTcUnit.Ok)
                    (tc-comptime-purity-node-mode
                      ctx
                      env
                      (tc-comptime-purity-template-bound
                        template?
                        index-bound
                        prefix)
                      chain
                      seen
                      template?
                      body)]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
    [(AstExpr.SpmdBroadcast value lane)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        value
        lane)]
    [(AstExpr.SpmdShuffle value lane)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        value
        lane)]
    [(AstExpr.StructGet receiver _)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? receiver)]
    [(AstExpr.StructSet receiver _ value)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        receiver
        value)]
    [(AstExpr.WithRegion _ body)
      (tc-comptime-purity-expr-list-mode
        ctx
        env
        bound
        chain
        seen
        template?
        body)]
    [(AstExpr.WithEscape scratch body)
      (match (tc-comptime-purity-node-mode
        ctx
        env
        bound
        chain
        seen
        template?
        scratch)
        [(ResultTcUnit.Ok)
          (tc-comptime-purity-expr-list-mode
            ctx
            env
            bound
            chain
            seen
            template?
            body)]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [(AstExpr.WithScratch body)
      (tc-comptime-purity-expr-list-mode
        ctx
        env
        bound
        chain
        seen
        template?
        body)]
    [(AstExpr.InArena arena body)
      (match (tc-comptime-purity-node-mode
        ctx
        env
        bound
        chain
        seen
        template?
        arena)
        [(ResultTcUnit.Ok)
          (tc-comptime-purity-expr-list-mode
            ctx
            env
            bound
            chain
            seen
            template?
            body)]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (match (tc-comptime-purity-resource-bindings-mode
            ctx
            env
            bound
            chain
            seen
            template?
            bindings)
            [(ResultTcStringList.Ok body-bound)
              (tc-comptime-purity-expr-list-mode
                ctx
                env
                body-bound
                chain
                seen
                template?
                body)]
            [(ResultTcStringList.Err message) (ResultTcUnit.Err message)])])]
    [(AstExpr.Box inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExpr.BoxGet inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExpr.BoxTake inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExpr.BoxSet inner value)
      (match (tc-comptime-purity-node-mode
        ctx
        env
        bound
        chain
        seen
        template?
        inner)
        [(ResultTcUnit.Ok)
          (tc-comptime-purity-node-mode
            ctx
            env
            bound
            chain
            seen
            template?
            value)]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [(AstExpr.TypeLiteral _) ResultTcUnit.Ok]
    [(AstExpr.Init _) ResultTcUnit.Ok]
    [(AstExpr.Comptime inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExpr.Quote _) ResultTcUnit.Ok]
    [(AstExpr.Quasiquote inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen true inner)]
    [(AstExpr.Unquote inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen false inner)]
    [(AstExpr.UnquoteSplicing inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen false inner)]
    [(AstExpr.BracketClause items)
      (tc-comptime-purity-expr-list-mode
        ctx
        env
        bound
        chain
        seen
        template?
        items)]
    [(AstExpr.Try inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExpr.Return inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExpr.Break) ResultTcUnit.Ok]
    [(AstExpr.Continue) ResultTcUnit.Ok]
    [(AstExpr.PtrNull _)
      (tc-comptime-purity-reject-or-template-ok
        expr
        chain
        template?
        "ptr-null"
        "raw pointer operation")]
    [(AstExpr.PtrNullCheck inner)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "ptr-null?"
        "raw pointer operation"
        inner)]
    [(AstExpr.PtrAddrOf place)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "ptr-addr-of"
        "raw pointer operation"
        place)]
    [(AstExpr.PtrRead ptr)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "ptr-read"
        "raw pointer operation"
        ptr)]
    [(AstExpr.PtrWrite ptr value)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "ptr-write!"
        "raw pointer operation"
        ptr
        value)]
    [(AstExpr.PtrOffset ptr offset)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "ptr-offset"
        "raw pointer operation"
        ptr
        offset)]
    [(AstExpr.PtrCast ptr _)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "ptr-cast"
        "raw pointer operation"
        ptr)]
    [(AstExpr.PtrToInt ptr)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "ptr->int"
        "raw pointer operation"
        ptr)]
    [(AstExpr.IntToPtr value _)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "int->ptr"
        "raw pointer operation"
        value)]
    [(AstExpr.StringData str)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "string-data"
        "unsafe FFI bridge"
        str)]
    [(AstExpr.StringFromBytes ptr len)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "string-from-bytes"
        "unsafe FFI bridge"
        ptr
        len)]
    [(AstExpr.ArrayData array)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "array-data"
        "unsafe FFI bridge"
        array)]
    [(AstExpr.BinaryData _) ResultTcUnit.Ok]
    [(AstExpr.SpmdProgramIndex) ResultTcUnit.Ok]
    [(AstExpr.SpmdProgramCount) ResultTcUnit.Ok]
    [(AstExpr.ProgramArgc)
      (tc-comptime-purity-reject-or-template-ok
        expr
        chain
        template?
        "program-argc"
        "runtime process state")]
    [(AstExpr.ProgramArgv)
      (tc-comptime-purity-reject-or-template-ok
        expr
        chain
        template?
        "program-argv"
        "runtime process state")]
    [(AstExpr.ProgramEnvp)
      (tc-comptime-purity-reject-or-template-ok
        expr
        chain
        template?
        "program-envp"
        "runtime process state")]
    [(AstExpr.CpuIdEax leaf subleaf)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "cpuid"
        "host CPU query"
        leaf
        subleaf)]
    [(AstExpr.CpuIdEbx leaf subleaf)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "cpuid"
        "host CPU query"
        leaf
        subleaf)]
    [(AstExpr.CpuIdEcx leaf subleaf)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "cpuid"
        "host CPU query"
        leaf
        subleaf)]
    [(AstExpr.CpuIdEdx leaf subleaf)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "cpuid"
        "host CPU query"
        leaf
        subleaf)]
    [(AstExpr.Xgetbv index)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "xgetbv"
        "host CPU query"
        index)]
    [(AstExpr.Syscall args)
      (if template?
        (tc-comptime-purity-expr-list-mode ctx env bound chain seen true args)
        (tc-comptime-purity-error expr chain "syscall" "host syscall"))]))

(define (tc-comptime-purity-var
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [expr : AstExpr]
  [name-id : i64]) : ResultTcUnit
  (let
    [name : String (tc-hygiene-name-text-id name-id)]
    (cond
      [(tc-string-list-contains bound name) ResultTcUnit.Ok]
      [(tc-comptime-purity-banned-qualified? ctx name name-id)
        (tc-comptime-purity-error
          expr
          chain
          name
          (str_cat.str-cat
            "import from module "
            (tc-qualified-name-module name)))]
      [(tc-comptime-purity-ctfe-builtin? name name-id) ResultTcUnit.Ok]
      [else
        (match (tc-lookup-unsafe-id env name-id)
          [(ResultTcTypeUnsafe.Ok _ unsafe?)
            (if unsafe?
              (tc-comptime-purity-error
                expr
                chain
                name
                (str_cat.str-cat "unsafe declaration " name))
              (tc-comptime-purity-var-handle
                ctx
                env
                bound
                chain
                seen
                expr
                name-id))]
          [(ResultTcTypeUnsafe.Err _)
            (tc-comptime-purity-var-handle
              ctx
              env
              bound
              chain
              seen
              expr
              name-id)])])))

(define (tc-comptime-purity-var-handle
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [expr : AstExpr]
  [name-id : i64]) : ResultTcUnit
  (let
    [source-id : i64 (macro-hygiene-global-source-name-id-or name-id name-id)]
    [module-id : i64
      (if (macro-hygiene-global-id? name-id)
        (macro-hygiene-global-module-id name-id)
        (tc-context-module-id ctx))]
    [handle : i64
      (compiler-symbols-lookup-value-in-module-id-or
        (tc-context-symbols ctx)
        module-id
        source-id
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (let
        [name : String (intern-str source-id)]
        [kind : i64 (compiler-symbol-handle-kind handle)]
        (cond
          [(= kind (compiler-symbol-kind-extern))
            (tc-comptime-purity-error
              expr
              chain
              name
              (str_cat.str-cat "extern reference " name))]
          [(= kind (compiler-symbol-kind-defdispatch))
            (tc-comptime-purity-error
              expr
              chain
              name
              (str_cat.str-cat "runtime dispatch reference " name))]
          [(or
              (= kind (compiler-symbol-kind-value-define))
              (= kind (compiler-symbol-kind-function-define)))
            (tc-comptime-purity-handle-decl
              ctx
              env
              bound
              chain
              seen
              expr
              name
              handle)]
          [else ResultTcUnit.Ok]))
      ResultTcUnit.Ok)))

(define (tc-comptime-purity-handle-decl
  [ctx : TcContext]
  [env : TcTypeEnv]
  [_bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [_expr : AstExpr]
  [name : String]
  [handle : i64]) : ResultTcUnit
  (if (tc-string-list-contains seen name)
    ResultTcUnit.Ok
    (let
      [index : i64 (compiler-symbol-handle-index handle)]
      [decls : (Array AstDecl)
        (compiler-symbols-decls (tc-context-symbols ctx))]
      (if (or (< index 0) (>= index (array.length decls)))
        ResultTcUnit.Ok
        (tc-comptime-purity-decl
          ctx
          env
          (tc-comptime-purity-chain-push chain name)
          (tc-string-list-add seen name)
          (array-ref decls index))))))

(define (tc-comptime-purity-decl
  [ctx : TcContext]
  [env : TcTypeEnv]
  [chain : TcStringList]
  [seen : TcStringList]
  [decl : AstDecl]) : ResultTcUnit
  (match decl
    [(AstDecl.Def decl-meta _ _ expr-box)
      (let
        [expr : AstExpr (ast-node-get expr-box)]
        (tc-comptime-purity-expr ctx env TcStringList.Nil chain seen expr))]
    [(AstDecl.DefFn decl-meta _ params _ body-box _)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (tc-comptime-purity-expr
          ctx
          env
          (tc-param-bound-names params)
          chain
          seen
          body))]
    [(AstDecl.DefMacro decl-meta _ _ _ _) ResultTcUnit.Ok]
    [(AstDecl.Extern decl-meta name _ _ _)
      (tc-comptime-purity-error
        (AstExpr.Var name)
        chain
        (tc-env-key-name-text name)
        (str_cat.str-cat "extern reference " (tc-env-key-name-text name)))]
    [(AstDecl.DefDispatch decl-meta name _)
      (tc-comptime-purity-error
        (AstExpr.Var name)
        chain
        (tc-env-key-name-text name)
        (str_cat.str-cat
          "runtime dispatch reference "
          (tc-env-key-name-text name)))]
    [(AstDecl.Unsafe _)
      (ResultTcUnit.Err
        (str_cat.str-cat
          "typecheck: comptime purity rejects unsafe declaration; reference path: "
          (tc-comptime-purity-chain-render chain)))]
    [_ ResultTcUnit.Ok]))

(define (tc-check-defmacro-purity
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [params : AstMacroParamList]
  [body : AstExpr]) : ResultTcUnit
  (tc-comptime-purity-expr
    ctx
    env
    (tc-macro-param-bound-names params)
    (tc-comptime-purity-chain-push TcStringList.Nil (tc-env-key-name-text name))
    (tc-string-list-add TcStringList.Nil (tc-env-key-name-text name))
    body))

;; The ordinary comptime-purity walk already models executable macro syntax,
;; including quote/unquote and lexical shadowing.  Reuse that walk while a
;; small abstract-kind state is active instead of maintaining a second large
;; recursive visitor.  Typechecking is single-threaded, and every scoped state
;; mutation below is restored before returning.
(defstruct TcMacroAbstractState
  (active bool)
  (macro-name String)
  (param-name String)
  (kind-mask i64))

(defenum TcMacroAbstractGuard
  (No)
  (Kind String))

(define tc-macro-abstract-active : bool
  false)
(define tc-macro-abstract-macro-name : String
  "")
(define tc-macro-abstract-param-name : String
  "")
(define tc-macro-abstract-kind-mask : i64
  0)

(define (tc-macro-abstract-state-save) : TcMacroAbstractState
  (TcMacroAbstractState
    tc-macro-abstract-active
    tc-macro-abstract-macro-name
    tc-macro-abstract-param-name
    tc-macro-abstract-kind-mask))

(define (tc-macro-abstract-state-restore! [state : TcMacroAbstractState]) : unit
  (begin
    (set! tc-macro-abstract-active (struct-get state active))
    (set! tc-macro-abstract-macro-name (struct-get state macro-name))
    (set! tc-macro-abstract-param-name (struct-get state param-name))
    (set! tc-macro-abstract-kind-mask (struct-get state kind-mask))))

(define (tc-macro-abstract-call-id [func : AstExpr] [bound : TcStringList]) : i64
  (let
    [raw-id : i64 (tc-expr-var-name-id func)]
    (if (or
      (< raw-id 0)
      (tc-string-list-contains bound (tc-hygiene-name-text-id raw-id)))
      -1
      (ctfe-comptime-helper-call-name-id
        (macro-hygiene-global-source-name-id-or raw-id raw-id)))))

(define (tc-macro-abstract-arg [args : (& args AstExprList)] [index : i64]) : AstExpr
  (ast-node-get (ast-expr-list-get args index 0)))

(define (tc-macro-abstract-alias-marker [name : String]) : String
  (str_cat.str-cat " abstract type alias " name))

(define (tc-macro-abstract-bound-alias-at?
  [items : TcStringList]
  [name : String]
  [marker : String]) : bool
  (match items
    [(TcStringList.Nil) false]
    [(TcStringList.Cons item rest)
      (cond
        [(string.eq item marker) true]
        [(string.eq item name) false]
        [else (tc-macro-abstract-bound-alias-at? (box-get rest) name marker)])]))

(define (tc-macro-abstract-bound-alias? [bound : TcStringList] [name : String]) : bool
  (tc-macro-abstract-bound-alias-at?
    bound
    name
    (tc-macro-abstract-alias-marker name)))

(define (tc-macro-abstract-param-var? [expr : AstExpr] [bound : TcStringList]) : bool
  (match (ast-expr-unspan expr)
    [(AstExpr.Var name-id)
      (let
        [name : String (tc-hygiene-name-text-id name-id)]
        (or
          (and
            (string.eq name tc-macro-abstract-param-name)
            (not (tc-string-list-contains bound name)))
          (tc-macro-abstract-bound-alias? bound name)))]
    [_ false]))

(define (tc-macro-abstract-binding-bound
  [bound : TcStringList]
  [name-id : i64]
  [init : AstExpr]
  [template? : bool]) : TcStringList
  (let
    [next-bound : TcStringList
      (if (and tc-macro-abstract-active (not template?))
        (TcStringList.Cons (tc-env-key-name-text name-id) (box bound))
        (tc-comptime-purity-template-bound template? bound name-id))]
    (if (and
      tc-macro-abstract-active
      (not template?)
      (tc-macro-abstract-param-var? init bound))
      (TcStringList.Cons
        (tc-macro-abstract-alias-marker (tc-env-key-name-text name-id))
        (box next-bound))
      next-bound)))

(define (tc-macro-abstract-kind-bit [kind : String]) : i64
  (cond
    [(string.eq kind "i64") (shl 1 0)]
    [(string.eq kind "i32") (shl 1 1)]
    [(string.eq kind "i16") (shl 1 2)]
    [(string.eq kind "i8") (shl 1 3)]
    [(string.eq kind "u64") (shl 1 4)]
    [(string.eq kind "u32") (shl 1 5)]
    [(string.eq kind "u16") (shl 1 6)]
    [(string.eq kind "u8") (shl 1 7)]
    [(string.eq kind "f64") (shl 1 8)]
    [(string.eq kind "f32") (shl 1 9)]
    [(string.eq kind "bool") (shl 1 10)]
    [(string.eq kind "char") (shl 1 11)]
    [(string.eq kind "string") (shl 1 12)]
    [(string.eq kind "unit") (shl 1 13)]
    [(string.eq kind "never") (shl 1 14)]
    [(string.eq kind "array") (shl 1 15)]
    [(string.eq kind "dyn-array") (shl 1 16)]
    [(string.eq kind "function") (shl 1 17)]
    [(string.eq kind "tuple") (shl 1 18)]
    [(string.eq kind "struct") (shl 1 19)]
    [(string.eq kind "enum") (shl 1 20)]
    [(string.eq kind "str") (shl 1 21)]
    [(string.eq kind "ptr") (shl 1 22)]
    [(string.eq kind "mut-ptr") (shl 1 23)]
    [(string.eq kind "ref") (shl 1 24)]
    [(string.eq kind "mut-ref") (shl 1 25)]
    [(string.eq kind "region") (shl 1 26)]
    [(string.eq kind "type-var") (shl 1 27)]
    ;; Reserved for a future parser-visible `box` kind constraint.
    [(string.eq kind "box") (shl 1 28)]
    [else (shl 1 29)]))

(define (tc-macro-abstract-kind-list-mask [kinds : AstMacroTypeKindList]) : i64
  (match kinds
    [(AstMacroTypeKindList.Nil) 0]
    [(AstMacroTypeKindList.Cons head rest)
      (bit-or
        (tc-macro-abstract-kind-bit (intern-str head))
        (tc-macro-abstract-kind-list-mask (box-get rest)))]))

(define (tc-macro-abstract-mask-allows? [allowed : i64]) : bool
  (= (bit-and tc-macro-abstract-kind-mask (bit-xor allowed -1)) 0))

(define (tc-macro-abstract-reflection-supported? [call-id : i64]) : bool
  (cond
    [(or
        (= call-id (cbi.compiler-builtin-ctfe-ref 46))
        (= call-id (cbi.compiler-builtin-ctfe-ref 71))
        (= call-id (cbi.compiler-builtin-ctfe-ref 72))
        (= call-id (cbi.compiler-builtin-ctfe-ref 210)))
      true]
    [(or
        (= call-id (cbi.compiler-builtin-ctfe-ref 73))
        (= call-id (cbi.compiler-builtin-ctfe-ref 74)))
      (tc-macro-abstract-mask-allows? (bit-or (shl 1 19) (shl 1 20)))]
    [(or
        (= call-id (cbi.compiler-builtin-ctfe-ref 2))
        (= call-id (cbi.compiler-builtin-ctfe-ref 75))
        (= call-id (cbi.compiler-builtin-ctfe-ref 76))
        (= call-id (cbi.compiler-builtin-ctfe-ref 77)))
      (tc-macro-abstract-mask-allows? (shl 1 19))]
    [(or
        (= call-id (cbi.compiler-builtin-ctfe-ref 78))
        (= call-id (cbi.compiler-builtin-ctfe-ref 79))
        (= call-id (cbi.compiler-builtin-ctfe-ref 80))
        (= call-id (cbi.compiler-builtin-ctfe-ref 81)))
      (tc-macro-abstract-mask-allows? (shl 1 20))]
    [(or
        (= call-id (cbi.compiler-builtin-ctfe-ref 82))
        (= call-id (cbi.compiler-builtin-ctfe-ref 84)))
      (tc-macro-abstract-mask-allows? (bit-or (shl 1 15) (shl 1 16)))]
    [(= call-id (cbi.compiler-builtin-ctfe-ref 214))
      (tc-macro-abstract-mask-allows? (shl 1 28))]
    [(or
        (= call-id (cbi.compiler-builtin-ctfe-ref 85))
        (= call-id (cbi.compiler-builtin-ctfe-ref 86)))
      (tc-macro-abstract-mask-allows? (shl 1 18))]
    [(or
        (= call-id (cbi.compiler-builtin-ctfe-ref 87))
        (= call-id (cbi.compiler-builtin-ctfe-ref 88))
        (= call-id (cbi.compiler-builtin-ctfe-ref 89)))
      (tc-macro-abstract-mask-allows? (shl 1 17))]
    ;; Kind `array` does not imply a fixed length, and no kind proves cleanup
    ;; ownership.  Those facts remain concrete-only.
    [(or
        (= call-id (cbi.compiler-builtin-ctfe-ref 83))
        (= call-id (cbi.compiler-builtin-ctfe-ref 211)))
      false]
    [else false]))

(define (tc-macro-abstract-required [call-id : i64]) : String
  (cond
    [(or
        (= call-id (cbi.compiler-builtin-ctfe-ref 73))
        (= call-id (cbi.compiler-builtin-ctfe-ref 74)))
      "struct or enum"]
    [(or
        (= call-id (cbi.compiler-builtin-ctfe-ref 2))
        (= call-id (cbi.compiler-builtin-ctfe-ref 75))
        (= call-id (cbi.compiler-builtin-ctfe-ref 76))
        (= call-id (cbi.compiler-builtin-ctfe-ref 77)))
      "struct"]
    [(or
        (= call-id (cbi.compiler-builtin-ctfe-ref 78))
        (= call-id (cbi.compiler-builtin-ctfe-ref 79))
        (= call-id (cbi.compiler-builtin-ctfe-ref 80))
        (= call-id (cbi.compiler-builtin-ctfe-ref 81)))
      "enum"]
    [(or
        (= call-id (cbi.compiler-builtin-ctfe-ref 82))
        (= call-id (cbi.compiler-builtin-ctfe-ref 84)))
      "array"]
    [(= call-id (cbi.compiler-builtin-ctfe-ref 83)) "fixed array shape"]
    [(= call-id (cbi.compiler-builtin-ctfe-ref 214)) "box"]
    [(or
        (= call-id (cbi.compiler-builtin-ctfe-ref 85))
        (= call-id (cbi.compiler-builtin-ctfe-ref 86)))
      "tuple"]
    [(or
        (= call-id (cbi.compiler-builtin-ctfe-ref 87))
        (= call-id (cbi.compiler-builtin-ctfe-ref 88))
        (= call-id (cbi.compiler-builtin-ctfe-ref 89)))
      "function"]
    [(= call-id (cbi.compiler-builtin-ctfe-ref 211)) "cleanup-owning type"]
    [else "a stronger type-kind bound"]))

(define (tc-macro-abstract-check-current-call
  [bound : TcStringList]
  [template? : bool]
  [expr : AstExpr]
  [func : AstExpr]
  [args : AstExprList]) : ResultTcUnit
  (if (or (not tc-macro-abstract-active) template? (= (struct-get args len) 0))
    ResultTcUnit.Ok
    (let
      [call-id : i64 (tc-macro-abstract-call-id func bound)]
      (if (and
        (or
          (ctfe-builtin-reflection-id? call-id)
          (ctfe-builtin-offset-of-id? call-id))
        (tc-macro-abstract-param-var? (tc-macro-abstract-arg (& args) 0) bound)
        (not (tc-macro-abstract-reflection-supported? call-id)))
        (let
          [name-id : i64 (tc-expr-var-name-id func)]
          [call-name : String
            (if (< name-id 0)
              "reflection operation"
              (tc-hygiene-name-text-id name-id))]
          (ResultTcUnit.Err
            (tc-locate-error-at-expr
              expr
              (str_cat.str-cat
                "typecheck: macro "
                (tc-name-slashes-to-dots tc-macro-abstract-macro-name)
                " constrained type operand "
                tc-macro-abstract-param-name
                " cannot use "
                call-name
                "; requires "
                (tc-macro-abstract-required call-id)))))
        ResultTcUnit.Ok))))

(define (tc-macro-abstract-kind-literal [expr : AstExpr]) : TcMacroAbstractGuard
  (match (ast-expr-unspan expr)
    [(AstExpr.Literal (AstLiteral.String string-id))
      (TcMacroAbstractGuard.Kind (intern-str string-id))]
    [_ TcMacroAbstractGuard.No]))

(define (tc-macro-abstract-type-kind-param?
  [expr : AstExpr]
  [bound : TcStringList]) : bool
  (match (ast-expr-unspan expr)
    [(AstExpr.Call func args)
      (and
        (=
          (tc-macro-abstract-call-id (ast-node-get func) bound)
          (cbi.compiler-builtin-ctfe-ref 71))
        (= (struct-get args len) 1)
        (tc-macro-abstract-param-var? (tc-macro-abstract-arg (& args) 0) bound))]
    [_ false]))

(define (tc-macro-abstract-kind-equality
  [left : AstExpr]
  [right : AstExpr]
  [bound : TcStringList]) : TcMacroAbstractGuard
  (if (tc-macro-abstract-type-kind-param? left bound)
    (tc-macro-abstract-kind-literal right)
    (if (tc-macro-abstract-type-kind-param? right bound)
      (tc-macro-abstract-kind-literal left)
      TcMacroAbstractGuard.No)))

(define (tc-macro-abstract-guard [cond-expr : AstExpr] [bound : TcStringList]) : TcMacroAbstractGuard
  (match (ast-expr-unspan cond-expr)
    [(AstExpr.Binary (AstBinOp.Eq) left right)
      (tc-macro-abstract-kind-equality
        (ast-node-get left)
        (ast-node-get right)
        bound)]
    [(AstExpr.Call func args)
      (let
        [raw-id : i64 (tc-expr-var-name-id (ast-node-get func))]
        (if (and
          (= (struct-get args len) 2)
          (>= raw-id 0)
          (ctfe-string-eq-helper-name-id?
            (tc-hygiene-name-text-id raw-id)
            (macro-hygiene-global-source-name-id-or raw-id raw-id)))
          (tc-macro-abstract-kind-equality
            (tc-macro-abstract-arg (& args) 0)
            (tc-macro-abstract-arg (& args) 1)
            bound)
          TcMacroAbstractGuard.No))]
    [_ TcMacroAbstractGuard.No]))

(define (tc-macro-abstract-purity-node-with-mask
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [kind-mask : i64]
  [expr-id : i64]) : ResultTcUnit
  (let
    [saved : i64 tc-macro-abstract-kind-mask]
    (begin
      (set! tc-macro-abstract-kind-mask kind-mask)
      (let
        [result : ResultTcUnit
          (tc-comptime-purity-node-mode ctx env bound chain seen false expr-id)]
        (begin
          (set! tc-macro-abstract-kind-mask saved)
          result)))))

(define (tc-comptime-purity-if-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [cond-id : i64]
  [then-id : i64]
  [else-id : i64]) : ResultTcUnit
  (if (or (not tc-macro-abstract-active) template?)
    (tc-comptime-purity-node3-mode
      ctx
      env
      bound
      chain
      seen
      template?
      cond-id
      then-id
      else-id)
    (match (tc-comptime-purity-node-mode ctx env bound chain seen false cond-id)
      [(ResultTcUnit.Ok)
        (match (tc-macro-abstract-guard (ast-node-get cond-id) bound)
          [(TcMacroAbstractGuard.No)
            (tc-comptime-purity-node2-mode
              ctx
              env
              bound
              chain
              seen
              false
              then-id
              else-id)]
          [(TcMacroAbstractGuard.Kind kind)
            (let
              [kind-bit : i64 (tc-macro-abstract-kind-bit kind)]
              (match (tc-macro-abstract-purity-node-with-mask
                ctx
                env
                bound
                chain
                seen
                (bit-and tc-macro-abstract-kind-mask kind-bit)
                then-id)
                [(ResultTcUnit.Ok)
                  (tc-macro-abstract-purity-node-with-mask
                    ctx
                    env
                    bound
                    chain
                    seen
                    (bit-and tc-macro-abstract-kind-mask (bit-xor kind-bit -1))
                    else-id)]
                [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

(define (tc-check-defmacro-abstract-param
  [ctx : TcContext]
  [env : TcTypeEnv]
  [macro-name : String]
  [param-name : String]
  [kinds : AstMacroTypeKindList]
  [body : AstExpr]) : ResultTcUnit
  (let
    [saved : TcMacroAbstractState (tc-macro-abstract-state-save)]
    (begin
      (set! tc-macro-abstract-active true)
      (set! tc-macro-abstract-macro-name (string.copy (& macro-name)))
      (set! tc-macro-abstract-param-name param-name)
      (set!
        tc-macro-abstract-kind-mask
        (tc-macro-abstract-kind-list-mask kinds))
      (let
        [result : ResultTcUnit
          (tc-comptime-purity-expr
            ctx
            env
            TcStringList.Nil
            (tc-comptime-purity-chain-push
              TcStringList.Nil
              (string.copy (& macro-name)))
            (tc-string-list-add TcStringList.Nil macro-name)
            body)]
        (begin
          (tc-macro-abstract-state-restore! saved)
          result)))))

(define (tc-check-defmacro-abstract-type-params-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [macro-name : String]
  [params : (& params AstMacroParamList)]
  [index : i64]
  [body : AstExpr]) : ResultTcUnit
  (if (>= index (ast-macro-param-list-len params))
    ResultTcUnit.Ok
    (match (ast-macro-param-list-get params index (ast-macro-param-fallback))
      [(AstMacroParam.Param param-name ty _ type-kinds)
        (match (if (and
          (tc-macro-type-param-kind? ty)
          (not
            (match type-kinds
              [(AstMacroTypeKindList.Nil) true]
              [_ false])))
          (tc-check-defmacro-abstract-param
            ctx
            env
            macro-name
            (tc-env-key-name-text param-name)
            type-kinds
            body)
          ResultTcUnit.Ok)
          [(ResultTcUnit.Ok)
            (tc-check-defmacro-abstract-type-params-at
              ctx
              env
              macro-name
              params
              (+ index 1)
              body)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])))

(define (tc-check-defmacro-abstract-type-params
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [params : AstMacroParamList]
  [body : AstExpr]) : ResultTcUnit
  (tc-check-defmacro-abstract-type-params-at
    ctx
    env
    (tc-env-key-name-text name)
    (& params)
    0
    body))

(define (tc-macro-param-list-needs-call-context? [params : AstMacroParamList]) : bool
  (tc-macro-param-list-needs-call-context-at? (& params) 0))

(define (tc-macro-param-list-needs-call-context-at?
  [params : (& params AstMacroParamList)]
  [index : i64]) : bool
  (if (>= index (ast-macro-param-list-len params))
    false
    (match (ast-macro-param-list-get params index (ast-macro-param-fallback))
      [(AstMacroParam.Param _ ty _ _)
        (if (or (tc-macro-type-param-kind? ty) (tc-macro-module-param-kind? ty))
          true
          (tc-macro-param-list-needs-call-context-at? params (+ index 1)))])))

(define (tc-check-comptime-decl-purity
  [ctx : TcContext]
  [env : TcTypeEnv]
  [template : AstDecl]) : ResultTcUnit
  (tc-comptime-purity-decl
    ctx
    env
    (tc-comptime-purity-chain-push TcStringList.Nil "comptime-decl")
    TcStringList.Nil
    template))

(define (tc-check-defmacro
  [name : i64]
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [params : AstMacroParamList]
  [ret : AstType]
  [body : AstExpr]) : ResultTcUnit
  (let
    [macro-env : TcTypeEnv
      (tc-bind-macro-params ctx (tc-macro-helper-env-cached top-env) params)]
    (match (tc-expr ctx macro-env body)
      [(ResultTcType.Ok got)
        (match (tc-check-defmacro-purity ctx macro-env name params body)
          [(ResultTcUnit.Ok)
            (match (tc-check-defmacro-abstract-type-params
              ctx
              macro-env
              name
              params
              body)
              [(ResultTcUnit.Ok)
                (match (tc-expect
                  got
                  (AstType.Expr)
                  "typecheck: macro body must return Expr")
                  [(ResultTcUnit.Ok)
                    (if (or
                      (tc-macro-param-list-needs-call-context? params)
                      (macro-expr-uses-expr-type? body))
                      ResultTcUnit.Ok
                      (begin
                        (tc-context-capture-active-pools! ctx)
                        (match (compiler-ctfe-eval
                          body
                          (tc-ctfe-env-extend-macro-params
                            ctx
                            (tc-ctfe-env ctx)
                            params)
                          (ctfe-fuel-limit))
                          [(ResultCtfe.Ok value _)
                            (begin
                              (tc-context-install-pools! ctx)
                              (tc-check-defmacro-produced-type ctx ret value))]
                          [(ResultCtfe.Err diag)
                            (ResultTcUnit.Err
                              (compiler-diagnostic-message (box-get diag)))])))]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
      [(ResultTcType.Err message) (ResultTcUnit.Err message)])))

;; --- whole-local move checker -----------------------------------------------
;;
;; Reject use-after-move for move-only whole locals/parameters in source
;; evaluation order. The owner-only policy keeps ordinary aggregate
;; sharing compatible, while consuming only by-value sites whose target is an
;; owner today: cleanup-owning structs and Box values. Reads never move; branches
;; merge by union (a place moved on any arm is moved afterward). Loops reject
;; owner moves from values visible before the repeated body, then discard body
;; moves for the post-state because they may run zero times; lambdas still
;; discard their body's moves because they may be deferred. Reassigning a slot
;; with `set!` clears its moved mark. Owner-consuming struct fields, tuple
;; elements, and fixed-array literal elements are tracked as root paths so
;; unrelated entries remain usable. Nested direct-root struct/tuple/fixed-array
;; literal chains are represented by stable paths. Box and non-literal
;; aggregate projections stay rejected until their path/reinitialization policy
;; lands; dynamic arrays have a separate diagnostic because element ownership
;; cannot be made sound without an index policy.
(defenum TcMovePathSegments
  (Nil)
  (Field i64 (Box TcMovePathSegments))
  (TupleIndex i64 (Box TcMovePathSegments))
  (ArrayIndex i64 (Box TcMovePathSegments)))

(defstruct TcMovePath
  (root i64)
  (segments TcMovePathSegments))

(defenum TcMovedPathKind
  (Move)
  (BorrowShared)
  (BorrowMut)
  (BorrowTwoPhaseMut)
  (BorrowLending i64))

(defstruct TcMovedPathFact
  (path TcMovePath)
  (kind TcMovedPathKind)
  (origin i64))

(defenum TcMovedPathFacts
  (Nil)
  (Cons TcMovedPathFact (Box TcMovedPathFacts)))

(defenum TcMovedPathFactsRemove
  (Missing)
  (Removed TcMovedPathFacts))

(defstruct TcMovedExactPathIndex
  (heads tc_i64_i64_map.Map)
  (facts (Array TcMovedPathFact))
  (next (Array i64))
  (len i64))

(defstruct TcMovedSet
  (roots tc_i64_i64_map.Map)
  (partials tc_i64_i64_map.Map)
  (paths TcMovedPathFacts)
  (exact-path-index TcMovedExactPathIndex)
  (hidden-atomic-users tc_i64_i64_map.Map))

(defenum TcMoveResult
  (Ok TcMovedSet)
  (Err String))

(defenum TcMoveBindings
  (Ok TcTypeEnv TcMovedSet TcMovedSet TcMovedSet)
  (Err String))

(defenum TcMoveCleanupOwners
  (Nil)
  (Cons i64 i64 (Box TcMoveCleanupOwners)))

(defenum TcMoveResourceBindings
  (Ok TcTypeEnv TcMovedSet TcMovedSet TcMovedSet TcMoveCleanupOwners)
  (Err String))

(defenum TcMoveMaybeIndex
  (No)
  (Some i64))

(defenum TcMaybeMovePath
  (No)
  (Some TcMovePath))

(defenum TcMaybeMoveName
  (No)
  (Some i64 String))

(defenum TcMoveConflict
  (No)
  (Some String i64))

(define (tc-moved-empty) : TcMovedSet
  (TcMovedSet
    (tc_i64_i64_map.with-capacity 8)
    (tc_i64_i64_map.with-capacity 4)
    TcMovedPathFacts.Nil
    (TcMovedExactPathIndex
      (tc_i64_i64_map.with-capacity 8)
      (make-array TcMovedPathFact 8)
      (make-array i64 8)
      0)
    (tc_i64_i64_map.with-capacity 2)))

(define (tc-moved-roots [set : TcMovedSet]) : tc_i64_i64_map.Map
  (struct-get set roots))

(define (tc-moved-partials [set : TcMovedSet]) : tc_i64_i64_map.Map
  (struct-get set partials))

(define (tc-moved-paths [set : TcMovedSet]) : TcMovedPathFacts
  (struct-get set paths))

(define (tc-moved-exact-path-index [set : TcMovedSet]) : TcMovedExactPathIndex
  (struct-get set exact-path-index))

(define (tc-moved-path-facts-len [facts : TcMovedPathFacts]) : i64
  (match facts
    [(TcMovedPathFacts.Nil) 0]
    [(TcMovedPathFacts.Cons _ rest)
      (+ 1 (tc-moved-path-facts-len (box-get rest)))]))

(define (tc-moved-hidden-atomic-users [set : TcMovedSet]) : tc_i64_i64_map.Map
  (struct-get set hidden-atomic-users))

(define (tc-moved-len [set : TcMovedSet]) : i64
  (let
    [roots : tc_i64_i64_map.Map (tc-moved-roots set)]
    [partials : tc_i64_i64_map.Map (tc-moved-partials set)]
    [paths : TcMovedPathFacts (tc-moved-paths set)]
    [hidden : tc_i64_i64_map.Map (tc-moved-hidden-atomic-users set)]
    (+
      (+ (tc_i64_i64_map.len (& roots)) (tc_i64_i64_map.len (& partials)))
      (+ (tc-moved-path-facts-len paths) (tc_i64_i64_map.len (& hidden))))))

(define (tc-moved-capacity [set : TcMovedSet]) : i64
  (let
    [roots : tc_i64_i64_map.Map (tc-moved-roots set)]
    [partials : tc_i64_i64_map.Map (tc-moved-partials set)]
    [paths : TcMovedPathFacts (tc-moved-paths set)]
    [hidden : tc_i64_i64_map.Map (tc-moved-hidden-atomic-users set)]
    (+
      (+
        (tc_i64_i64_map.capacity (& roots))
        (tc_i64_i64_map.capacity (& partials)))
      (+ (tc-moved-path-facts-len paths) (tc_i64_i64_map.capacity (& hidden))))))

(define (tc-moved-clone-id-map [src : (& src tc_i64_i64_map.Map)]) : tc_i64_i64_map.Map
  (let
    [out : tc_i64_i64_map.Map
      (tc_i64_i64_map.with-capacity (tc_i64_i64_map.capacity src))]
    [index : i64 (tc_i64_i64_map.next-occupied src 0)]
    (begin
      (while (< index (tc_i64_i64_map.capacity src))
        (begin
          (match (tc_i64_i64_map.entry-at src index)
            [(tc_i64_i64_map.EntrySome key value)
              (tc_i64_i64_map.insert-ref! (&mut out) key value)]
            [(tc_i64_i64_map.EntryNone) unit])
          (set! index (tc_i64_i64_map.next-occupied src (+ index 1)))))
      out)))

(define (tc-moved-clone [set : TcMovedSet]) : TcMovedSet
  (let
    [roots : tc_i64_i64_map.Map (tc-moved-roots set)]
    [partials : tc_i64_i64_map.Map (tc-moved-partials set)]
    [paths : TcMovedPathFacts (tc-moved-paths set)]
    [hidden : tc_i64_i64_map.Map (tc-moved-hidden-atomic-users set)]
    (TcMovedSet
      (tc-moved-clone-id-map (& roots))
      (tc-moved-clone-id-map (& partials))
      paths
      (tc-moved-exact-path-index-from-facts paths)
      (tc-moved-clone-id-map (& hidden)))))

(define (tc-moved-contains? [set : TcMovedSet] [name-id : i64]) : bool
  (let
    [map : tc_i64_i64_map.Map (tc-moved-roots set)]
    (tc_i64_i64_map.contains? (& map) name-id)))

(define (tc-moved-no-origin-id) : i64
  -1)

(define (tc-moved-add [set : TcMovedSet] [name-id : i64]) : TcMovedSet
  (let
    [out : tc_i64_i64_map.Map (tc-moved-roots set)]
    (begin
      (tc_i64_i64_map.insert-ref! (&mut out) name-id (tc-moved-no-origin-id))
      (TcMovedSet
        out
        (tc-moved-partials set)
        (tc-moved-paths set)
        (tc-moved-exact-path-index set)
        (tc-moved-hidden-atomic-users set)))))

(define (tc-moved-add-value [set : TcMovedSet] [name-id : i64] [value : i64]) : TcMovedSet
  (let
    [out : tc_i64_i64_map.Map (tc-moved-roots set)]
    (begin
      (tc_i64_i64_map.insert-ref! (&mut out) name-id value)
      (TcMovedSet
        out
        (tc-moved-partials set)
        (tc-moved-paths set)
        (tc-moved-exact-path-index set)
        (tc-moved-hidden-atomic-users set)))))

(define (tc-moved-add-origin
  [set : TcMovedSet]
  [name-id : i64]
  [origin : AstExpr]) : TcMovedSet
  (tc-moved-add-value set name-id (ast-node-push origin)))

(define (tc-moved-remove [set : TcMovedSet] [name-id : i64]) : TcMovedSet
  (let
    [out : tc_i64_i64_map.Map (tc-moved-roots set)]
    (begin
      (tc_i64_i64_map.remove-ref! (&mut out) name-id)
      (TcMovedSet
        out
        (tc-moved-partials set)
        (tc-moved-paths set)
        (tc-moved-exact-path-index set)
        (tc-moved-hidden-atomic-users set)))))

(define (tc-moved-conflict [set : TcMovedSet] [name-id : i64]) : TcMoveConflict
  (let
    [map : tc_i64_i64_map.Map (tc-moved-roots set)]
    (match (tc_i64_i64_map.get (& map) name-id)
      [(tc_i64_i64_map.LookupFound origin-id)
        (TcMoveConflict.Some (tc-hygiene-name-text-id name-id) origin-id)]
      [(tc_i64_i64_map.LookupMissing) TcMoveConflict.No])))

(define (tc-move-use-message [name : String]) : String
  (string.append (string.append "typecheck: use of moved value `" name) "`"))

(define (tc-move-loop-carried-message [name : String]) : String
  (string.append
    (string.append "typecheck: cannot move loop-carried owner value `" name)
    "`"))

(define (tc-move-cleanup-owner-exit-message [name : String]) : String
  (string.append
    (string.append "typecheck: cleanup owner `" name)
    "` moved before with scope exit"))

(define (tc-move-help) : String
  "clone the owner before moving it again, reinitialize the moved place before reuse, or keep the owner move inside a narrower scope")

(define (tc-move-path-root-id [path : TcMovePath]) : i64
  (struct-get path root))

(define (tc-move-path-segments-eq?
  [a : TcMovePathSegments]
  [b : TcMovePathSegments]) : bool
  (match a
    [(TcMovePathSegments.Nil)
      (match b
        [(TcMovePathSegments.Nil) true]
        [_ false])]
    [(TcMovePathSegments.Field a-id a-rest)
      (match b
        [(TcMovePathSegments.Field b-id b-rest)
          (and
            (= a-id b-id)
            (tc-move-path-segments-eq? (box-get a-rest) (box-get b-rest)))]
        [_ false])]
    [(TcMovePathSegments.TupleIndex a-index a-rest)
      (match b
        [(TcMovePathSegments.TupleIndex b-index b-rest)
          (and
            (= a-index b-index)
            (tc-move-path-segments-eq? (box-get a-rest) (box-get b-rest)))]
        [_ false])]
    [(TcMovePathSegments.ArrayIndex a-index a-rest)
      (match b
        [(TcMovePathSegments.ArrayIndex b-index b-rest)
          (and
            (= a-index b-index)
            (tc-move-path-segments-eq? (box-get a-rest) (box-get b-rest)))]
        [_ false])]))

(define (tc-move-path-segments-prefix?
  [prefix : TcMovePathSegments]
  [value : TcMovePathSegments]) : bool
  (match prefix
    [(TcMovePathSegments.Nil) true]
    [(TcMovePathSegments.Field prefix-id prefix-rest)
      (match value
        [(TcMovePathSegments.Field value-id value-rest)
          (and
            (= prefix-id value-id)
            (tc-move-path-segments-prefix?
              (box-get prefix-rest)
              (box-get value-rest)))]
        [_ false])]
    [(TcMovePathSegments.TupleIndex prefix-index prefix-rest)
      (match value
        [(TcMovePathSegments.TupleIndex value-index value-rest)
          (and
            (= prefix-index value-index)
            (tc-move-path-segments-prefix?
              (box-get prefix-rest)
              (box-get value-rest)))]
        [_ false])]
    [(TcMovePathSegments.ArrayIndex prefix-index prefix-rest)
      (match value
        [(TcMovePathSegments.ArrayIndex value-index value-rest)
          (and
            (= prefix-index value-index)
            (tc-move-path-segments-prefix?
              (box-get prefix-rest)
              (box-get value-rest)))]
        [_ false])]))

(define (tc-move-path-eq? [a : TcMovePath] [b : TcMovePath]) : bool
  (and
    (= (struct-get a root) (struct-get b root))
    (tc-move-path-segments-eq? (struct-get a segments) (struct-get b segments))))

(define (tc-move-path-conflicts? [a : TcMovePath] [b : TcMovePath]) : bool
  (and
    (= (struct-get a root) (struct-get b root))
    (or
      (tc-move-path-segments-prefix?
        (struct-get a segments)
        (struct-get b segments))
      (tc-move-path-segments-prefix?
        (struct-get b segments)
        (struct-get a segments)))))

(define (tc-move-path-segments-render [segments : TcMovePathSegments]) : String
  (match segments
    [(TcMovePathSegments.Nil) ""]
    [(TcMovePathSegments.Field field-id rest)
      (string.append
        (string.append "." (tc-env-key-name-text field-id))
        (tc-move-path-segments-render (box-get rest)))]
    [(TcMovePathSegments.TupleIndex index rest)
      (string.append
        (string.append ".#tuple." (string.int->string index))
        (tc-move-path-segments-render (box-get rest)))]
    [(TcMovePathSegments.ArrayIndex index rest)
      (string.append
        (string.append ".#array." (string.int->string index))
        (tc-move-path-segments-render (box-get rest)))]))

(define (tc-move-path-render [path : TcMovePath]) : String
  (string.append
    (tc-env-key-name-text (struct-get path root))
    (tc-move-path-segments-render (struct-get path segments))))

(define (tc-moved-path-kind-eq? [a : TcMovedPathKind] [b : TcMovedPathKind]) : bool
  (match a
    [(TcMovedPathKind.Move)
      (match b
        [(TcMovedPathKind.Move) true]
        [_ false])]
    [(TcMovedPathKind.BorrowShared)
      (match b
        [(TcMovedPathKind.BorrowShared) true]
        [_ false])]
    [(TcMovedPathKind.BorrowMut)
      (match b
        [(TcMovedPathKind.BorrowMut) true]
        [_ false])]
    [(TcMovedPathKind.BorrowTwoPhaseMut)
      (match b
        [(TcMovedPathKind.BorrowTwoPhaseMut) true]
        [_ false])]
    [(TcMovedPathKind.BorrowLending a-id)
      (match b
        [(TcMovedPathKind.BorrowLending b-id) (= a-id b-id)]
        [_ false])]))

(define (tc-move-path-hash-combine [seed : i64] [component : i64]) : i64
  (bit-xor (* seed 2654435761) (+ component 40503)))

(define (tc-move-path-segments-hash [segments : TcMovePathSegments]) : i64
  (match segments
    [(TcMovePathSegments.Nil) 17]
    [(TcMovePathSegments.Field field-id rest)
      (tc-move-path-hash-combine
        (tc-move-path-hash-combine 23 field-id)
        (tc-move-path-segments-hash (box-get rest)))]
    [(TcMovePathSegments.TupleIndex index rest)
      (tc-move-path-hash-combine
        (tc-move-path-hash-combine 29 index)
        (tc-move-path-segments-hash (box-get rest)))]
    [(TcMovePathSegments.ArrayIndex index rest)
      (tc-move-path-hash-combine
        (tc-move-path-hash-combine 31 index)
        (tc-move-path-segments-hash (box-get rest)))]))

(define (tc-moved-path-kind-hash [kind : TcMovedPathKind]) : i64
  (match kind
    [(TcMovedPathKind.Move) 1]
    [(TcMovedPathKind.BorrowShared) 2]
    [(TcMovedPathKind.BorrowMut) 3]
    [(TcMovedPathKind.BorrowTwoPhaseMut) 4]
    [(TcMovedPathKind.BorrowLending binding-id)
      (tc-move-path-hash-combine 5 binding-id)]))

(define (tc-moved-exact-path-hash [path : TcMovePath] [kind : TcMovedPathKind]) : i64
  (tc-move-path-hash-combine
    (tc-move-path-hash-combine
      (struct-get path root)
      (tc-move-path-segments-hash (struct-get path segments)))
    (tc-moved-path-kind-hash kind)))

(define (tc-moved-path-fact-new
  [path : TcMovePath]
  [kind : TcMovedPathKind]
  [origin : i64]) : TcMovedPathFact
  (TcMovedPathFact path kind origin))

(define (tc-moved-path-fact-origin [fact : TcMovedPathFact]) : i64
  (struct-get fact origin))

(define (tc-moved-exact-path-index-find-from
  [index : TcMovedExactPathIndex]
  [path : TcMovePath]
  [kind : TcMovedPathKind]
  [entry : i64]) : i64
  (let
    [cursor : i64 entry]
    [facts : (Array TcMovedPathFact) (struct-get index facts)]
    [next : (Array i64) (struct-get index next)]
    (begin
      (while (>= cursor 0)
        (let
          [fact : TcMovedPathFact (array-ref facts cursor)]
          (if (and
            (tc-move-path-eq? (struct-get fact path) path)
            (tc-moved-path-kind-eq? (struct-get fact kind) kind))
            (return cursor)
            (set! cursor (array-ref next cursor)))))
      -1)))

(define (tc-moved-exact-path-index-find
  [index : TcMovedExactPathIndex]
  [path : TcMovePath]
  [kind : TcMovedPathKind]) : i64
  (let
    [heads : tc_i64_i64_map.Map (struct-get index heads)]
    [hash : i64 (tc-moved-exact-path-hash path kind)]
    [head : i64 (tc_i64_i64_map.get-value-or (& heads) hash -1)]
    (tc-moved-exact-path-index-find-from index path kind head)))

(define (tc-moved-exact-path-index-copy-prefix!
  [src-facts : (Array TcMovedPathFact)]
  [src-next : (Array i64)]
  [dst-facts : (Array TcMovedPathFact)]
  [dst-next : (Array i64)]
  [len : i64]) : unit
  (let
    [cursor : i64 0]
    (while (< cursor len)
      (begin
        (array-set! dst-facts cursor (array-ref src-facts cursor))
        (array-set! dst-next cursor (array-ref src-next cursor))
        (set! cursor (+ cursor 1))))))

(define (tc-moved-exact-path-index-ensure-capacity
  [index : TcMovedExactPathIndex]) : TcMovedExactPathIndex
  (let
    [facts : (Array TcMovedPathFact) (struct-get index facts)]
    [len : i64 (struct-get index len)]
    (if (< len (array-length facts))
      index
      (let
        [next-capacity : i64 (* (array-length facts) 2)]
        [next-facts : (Array TcMovedPathFact)
          (make-array TcMovedPathFact next-capacity)]
        [next-links : (Array i64) (make-array i64 next-capacity)]
        (begin
          (tc-moved-exact-path-index-copy-prefix!
            facts
            (struct-get index next)
            next-facts
            next-links
            len)
          (TcMovedExactPathIndex
            (struct-get index heads)
            next-facts
            next-links
            len))))))

(define (tc-moved-exact-path-index-insert-new
  [index : TcMovedExactPathIndex]
  [fact : TcMovedPathFact]) : TcMovedExactPathIndex
  (let
    [ready : TcMovedExactPathIndex
      (tc-moved-exact-path-index-ensure-capacity index)]
    [heads : tc_i64_i64_map.Map (struct-get ready heads)]
    [path : TcMovePath (struct-get fact path)]
    [kind : TcMovedPathKind (struct-get fact kind)]
    [hash : i64 (tc-moved-exact-path-hash path kind)]
    [head : i64 (tc_i64_i64_map.get-value-or (& heads) hash -1)]
    [slot : i64 (struct-get ready len)]
    (begin
      (array-set! (struct-get ready facts) slot fact)
      (array-set! (struct-get ready next) slot head)
      (tc_i64_i64_map.insert-ref! (&mut heads) hash slot)
      (TcMovedExactPathIndex
        heads
        (struct-get ready facts)
        (struct-get ready next)
        (+ slot 1)))))

(define (tc-moved-exact-path-index-from-facts-at
  [facts : TcMovedPathFacts]
  [index : TcMovedExactPathIndex]) : TcMovedExactPathIndex
  (match facts
    [(TcMovedPathFacts.Nil) index]
    [(TcMovedPathFacts.Cons fact rest)
      (tc-moved-exact-path-index-insert-new
        (tc-moved-exact-path-index-from-facts-at (box-get rest) index)
        fact)]))

(define (tc-moved-exact-path-index-from-facts [facts : TcMovedPathFacts]) : TcMovedExactPathIndex
  (tc-moved-exact-path-index-from-facts-at
    facts
    (TcMovedExactPathIndex
      (tc_i64_i64_map.with-capacity 8)
      (make-array TcMovedPathFact 8)
      (make-array i64 8)
      0)))

(define (tc-moved-base-path-kind? [kind : TcMovedPathKind]) : bool
  (match kind
    [(TcMovedPathKind.Move) true]
    [(TcMovedPathKind.BorrowShared) true]
    [_ false]))

(define (tc-moved-partial? [set : TcMovedSet] [name-id : i64]) : bool
  (let
    [partials : tc_i64_i64_map.Map (tc-moved-partials set)]
    (tc_i64_i64_map.contains? (& partials) name-id)))

(define (tc-moved-add-partial-value
  [set : TcMovedSet]
  [name-id : i64]
  [origin-id : i64]) : TcMovedSet
  (let
    [partials : tc_i64_i64_map.Map (tc-moved-partials set)]
    (begin
      (tc_i64_i64_map.insert-ref! (&mut partials) name-id origin-id)
      (TcMovedSet
        (tc-moved-roots set)
        partials
        (tc-moved-paths set)
        (tc-moved-exact-path-index set)
        (tc-moved-hidden-atomic-users set)))))

(define (tc-moved-remove-partial [set : TcMovedSet] [name-id : i64]) : TcMovedSet
  (let
    [partials : tc_i64_i64_map.Map (tc-moved-partials set)]
    (begin
      (tc_i64_i64_map.remove-ref! (&mut partials) name-id)
      (TcMovedSet
        (tc-moved-roots set)
        partials
        (tc-moved-paths set)
        (tc-moved-exact-path-index set)
        (tc-moved-hidden-atomic-users set)))))

(define (tc-moved-partial-conflict [set : TcMovedSet] [name-id : i64]) : TcMoveConflict
  (let
    [partials : tc_i64_i64_map.Map (tc-moved-partials set)]
    (match (tc_i64_i64_map.get (& partials) name-id)
      [(tc_i64_i64_map.LookupFound origin-id)
        (TcMoveConflict.Some (tc-hygiene-name-text-id name-id) origin-id)]
      [(tc_i64_i64_map.LookupMissing) TcMoveConflict.No])))

(define (tc-moved-path-facts-remove-exact
  [facts : TcMovedPathFacts]
  [path : TcMovePath]
  [kind : TcMovedPathKind]) : TcMovedPathFactsRemove
  (match facts
    [(TcMovedPathFacts.Nil) (TcMovedPathFactsRemove.Missing)]
    [(TcMovedPathFacts.Cons fact rest)
      (if (and
        (tc-move-path-eq? (struct-get fact path) path)
        (tc-moved-path-kind-eq? (struct-get fact kind) kind))
        (TcMovedPathFactsRemove.Removed (box-get rest))
        (match (tc-moved-path-facts-remove-exact (box-get rest) path kind)
          [(TcMovedPathFactsRemove.Missing) (TcMovedPathFactsRemove.Missing)]
          [(TcMovedPathFactsRemove.Removed tail)
            (TcMovedPathFactsRemove.Removed
              (TcMovedPathFacts.Cons fact (box tail)))]))]))

(define (tc-moved-path-facts-contains-exact-kind?
  [facts : TcMovedPathFacts]
  [path : TcMovePath]
  [kind : TcMovedPathKind]) : bool
  (match facts
    [(TcMovedPathFacts.Nil) false]
    [(TcMovedPathFacts.Cons fact rest)
      (if (and
        (tc-move-path-eq? (struct-get fact path) path)
        (tc-moved-path-kind-eq? (struct-get fact kind) kind))
        true
        (tc-moved-path-facts-contains-exact-kind? (box-get rest) path kind))]))

(define (tc-moved-add-path-fact
  [set : TcMovedSet]
  [path : TcMovePath]
  [kind : TcMovedPathKind]
  [origin : i64]) : TcMovedSet
  (let
    [index : TcMovedExactPathIndex (tc-moved-exact-path-index set)]
    [entry : i64 (tc-moved-exact-path-index-find index path kind)]
    (if (>= entry 0)
      set
      (let
        [fact : TcMovedPathFact (tc-moved-path-fact-new path kind origin)]
        [next-index : TcMovedExactPathIndex
          (tc-moved-exact-path-index-insert-new index fact)]
        (TcMovedSet
          (tc-moved-roots set)
          (tc-moved-partials set)
          (TcMovedPathFacts.Cons fact (box (tc-moved-paths set)))
          next-index
          (tc-moved-hidden-atomic-users set))))))

(define (tc-moved-remove-path-kind
  [set : TcMovedSet]
  [path : TcMovePath]
  [kind : TcMovedPathKind]) : TcMovedSet
  (match (tc-moved-path-facts-remove-exact (tc-moved-paths set) path kind)
    [(TcMovedPathFactsRemove.Missing) set]
    [(TcMovedPathFactsRemove.Removed facts)
      (TcMovedSet
        (tc-moved-roots set)
        (tc-moved-partials set)
        facts
        (tc-moved-exact-path-index-from-facts facts)
        (tc-moved-hidden-atomic-users set))]))

(define (tc-moved-path-exact-conflict-kind
  [set : TcMovedSet]
  [path : TcMovePath]
  [kind : TcMovedPathKind]) : TcMoveConflict
  (let
    [index : TcMovedExactPathIndex (tc-moved-exact-path-index set)]
    [entry : i64 (tc-moved-exact-path-index-find index path kind)]
    (if (< entry 0)
      TcMoveConflict.No
      (let
        [fact : TcMovedPathFact (array-ref (struct-get index facts) entry)]
        (TcMoveConflict.Some
          (tc-move-path-render (struct-get fact path))
          (tc-moved-path-fact-origin fact))))))

(define (tc-moved-path-exact-conflict [set : TcMovedSet] [path : TcMovePath]) : TcMoveConflict
  (match (tc-moved-path-exact-conflict-kind set path (TcMovedPathKind.Move))
    [(TcMoveConflict.Some key origin) (TcMoveConflict.Some key origin)]
    [TcMoveConflict.No
      (tc-moved-path-exact-conflict-kind
        set
        path
        (TcMovedPathKind.BorrowShared))]))

(define (tc-moved-conflict-display-path [key : String]) : String
  key)

(define (tc-move-origin-label [key : String]) : String
  (str_cat.str-cat
    "move of `"
    (tc-moved-conflict-display-path key)
    "` happened here"))

(define (tc-move-loop-carried-origin-label [name : String]) : String
  (str_cat.str-cat
    "owner value `"
    name
    "` is loop-carried into a repeated body"))

(define (tc-move-cleanup-owner-binding-label [name : String]) : String
  (str_cat.str-cat "cleanup owner `" name "` is bound for this with scope here"))

(define (tc-move-origin-span [origin-id : i64]) : TcMaybeAstSourceSpan
  (if (= origin-id (tc-moved-no-origin-id))
    TcMaybeAstSourceSpan.No
    (tc-expr-maybe-span (ast-node-get origin-id))))

(define (tc-move-rich-origin-message
  [primary : AstExpr]
  [message : String]
  [origin-id : i64]
  [origin-label : String]) : String
  (match (tc-expr-maybe-span primary)
    [(TcMaybeAstSourceSpan.Some primary-span)
      (match (tc-move-origin-span origin-id)
        [(TcMaybeAstSourceSpan.Some origin-span)
          (tc-rich-error-one-secondary
            primary-span
            message
            (tc-move-help)
            origin-span
            origin-label)]
        [(TcMaybeAstSourceSpan.No)
          (tc-rich-error-one-secondary
            primary-span
            message
            (tc-move-help)
            primary-span
            origin-label)])]
    [(TcMaybeAstSourceSpan.No)
      (match (tc-move-origin-span origin-id)
        [(TcMaybeAstSourceSpan.Some origin-span)
          (tc-rich-error-one-secondary
            origin-span
            message
            (tc-move-help)
            origin-span
            origin-label)]
        [(TcMaybeAstSourceSpan.No) message])]))

(define (tc-move-rich-conflict-message
  [conflict : TcMoveConflict]
  [fallback-key : String]
  [primary : AstExpr]
  [message : String]) : String
  (match conflict
    [(TcMoveConflict.Some key origin-id)
      (tc-move-rich-origin-message
        primary
        message
        origin-id
        (tc-move-origin-label key))]
    [TcMoveConflict.No
      (tc-move-rich-origin-message
        primary
        message
        (tc-moved-no-origin-id)
        (tc-move-origin-label fallback-key))]))

(define (tc-move-rich-loop-carried-message [name : String] [primary : AstExpr]) : String
  (tc-move-rich-origin-message
    primary
    (tc-move-loop-carried-message name)
    (tc-moved-no-origin-id)
    (tc-move-loop-carried-origin-label name)))

(define (tc-move-rich-cleanup-owner-exit-message
  [conflict : TcMoveConflict]
  [name : String]
  [owner-origin-id : i64]
  [scope : AstExpr]) : String
  (let
    [message : String (tc-move-cleanup-owner-exit-message name)]
    [owner-label : String (tc-move-cleanup-owner-binding-label name)]
    (match (tc-expr-maybe-span scope)
      [(TcMaybeAstSourceSpan.Some primary-span)
        (match conflict
          [(TcMoveConflict.Some key move-origin-id)
            (match (tc-move-origin-span move-origin-id)
              [(TcMaybeAstSourceSpan.Some move-span)
                (match (tc-move-origin-span owner-origin-id)
                  [(TcMaybeAstSourceSpan.Some owner-span)
                    (tc-rich-error-two-secondaries
                      primary-span
                      message
                      (tc-move-help)
                      move-span
                      (tc-move-origin-label key)
                      owner-span
                      owner-label)]
                  [(TcMaybeAstSourceSpan.No)
                    (tc-rich-error-two-secondaries
                      primary-span
                      message
                      (tc-move-help)
                      move-span
                      (tc-move-origin-label key)
                      primary-span
                      owner-label)])]
              [(TcMaybeAstSourceSpan.No)
                (match (tc-move-origin-span owner-origin-id)
                  [(TcMaybeAstSourceSpan.Some owner-span)
                    (tc-rich-error-one-secondary
                      primary-span
                      message
                      (tc-move-help)
                      owner-span
                      owner-label)]
                  [(TcMaybeAstSourceSpan.No)
                    (tc-rich-error-one-secondary
                      primary-span
                      message
                      (tc-move-help)
                      primary-span
                      owner-label)])])]
          [TcMoveConflict.No
            (match (tc-move-origin-span owner-origin-id)
              [(TcMaybeAstSourceSpan.Some owner-span)
                (tc-rich-error-one-secondary
                  primary-span
                  message
                  (tc-move-help)
                  owner-span
                  owner-label)]
              [(TcMaybeAstSourceSpan.No)
                (tc-rich-error-one-secondary
                  primary-span
                  message
                  (tc-move-help)
                  primary-span
                  owner-label)])])]
      [(TcMaybeAstSourceSpan.No)
        (match conflict
          [(TcMoveConflict.Some key move-origin-id)
            (match (tc-move-origin-span move-origin-id)
              [(TcMaybeAstSourceSpan.Some move-span)
                (match (tc-move-origin-span owner-origin-id)
                  [(TcMaybeAstSourceSpan.Some owner-span)
                    (tc-rich-error-two-secondaries
                      move-span
                      message
                      (tc-move-help)
                      move-span
                      (tc-move-origin-label key)
                      owner-span
                      owner-label)]
                  [(TcMaybeAstSourceSpan.No)
                    (tc-rich-error-two-secondaries
                      move-span
                      message
                      (tc-move-help)
                      move-span
                      (tc-move-origin-label key)
                      move-span
                      owner-label)])]
              [(TcMaybeAstSourceSpan.No)
                (match (tc-move-origin-span owner-origin-id)
                  [(TcMaybeAstSourceSpan.Some owner-span)
                    (tc-rich-error-one-secondary
                      owner-span
                      message
                      (tc-move-help)
                      owner-span
                      owner-label)]
                  [(TcMaybeAstSourceSpan.No) message])])]
          [TcMoveConflict.No
            (match (tc-move-origin-span owner-origin-id)
              [(TcMaybeAstSourceSpan.Some owner-span)
                (tc-rich-error-one-secondary
                  owner-span
                  message
                  (tc-move-help)
                  owner-span
                  owner-label)]
              [(TcMaybeAstSourceSpan.No) message])])])))

(define (tc-move-rich-conflict-result
  [conflict : TcMoveConflict]
  [fallback-key : String]
  [primary : AstExpr]
  [message : String]) : TcMoveResult
  (TcMoveResult.Err
    (tc-move-rich-conflict-message conflict fallback-key primary message)))

(define (tc-move-rich-use-conflict-result
  [conflict : TcMoveConflict]
  [fallback-key : String]
  [primary : AstExpr]
  [name : String]) : TcMoveResult
  (tc-move-rich-conflict-result
    conflict
    fallback-key
    primary
    (tc-move-use-message name)))

(define (tc-move-rich-loop-carried-result [name : String] [primary : AstExpr]) : TcMoveResult
  (TcMoveResult.Err (tc-move-rich-loop-carried-message name primary)))

(define (tc-moved-path-conflict-at
  [facts : TcMovedPathFacts]
  [path : TcMovePath]) : TcMoveConflict
  (match facts
    [(TcMovedPathFacts.Nil) TcMoveConflict.No]
    [(TcMovedPathFacts.Cons fact rest)
      (if (and
        (tc-moved-base-path-kind? (struct-get fact kind))
        (tc-move-path-conflicts? (struct-get fact path) path))
        (TcMoveConflict.Some
          (tc-move-path-render (struct-get fact path))
          (tc-moved-path-fact-origin fact))
        (tc-moved-path-conflict-at (box-get rest) path))]))

(define (tc-moved-path-conflict-kind-at
  [facts : TcMovedPathFacts]
  [path : TcMovePath]
  [kind : TcMovedPathKind]) : TcMoveConflict
  (match facts
    [(TcMovedPathFacts.Nil) TcMoveConflict.No]
    [(TcMovedPathFacts.Cons fact rest)
      (if (and
        (tc-moved-path-kind-eq? (struct-get fact kind) kind)
        (tc-move-path-conflicts? (struct-get fact path) path))
        (TcMoveConflict.Some
          (tc-move-path-render (struct-get fact path))
          (tc-moved-path-fact-origin fact))
        (tc-moved-path-conflict-kind-at (box-get rest) path kind))]))

(define (tc-moved-path-conflict-kind
  [set : TcMovedSet]
  [path : TcMovePath]
  [kind : TcMovedPathKind]) : TcMoveConflict
  (tc-moved-path-conflict-kind-at (tc-moved-paths set) path kind))

(define (tc-moved-path-conflict [set : TcMovedSet] [path : TcMovePath]) : TcMoveConflict
  (tc-moved-path-conflict-at (tc-moved-paths set) path))

(define (tc-moved-path-conflict? [set : TcMovedSet] [path : TcMovePath]) : bool
  (match (tc-moved-path-conflict set path)
    [(TcMoveConflict.Some _ _) true]
    [TcMoveConflict.No false]))

(define (tc-moved-path-facts-remove-root
  [facts : TcMovedPathFacts]
  [root-id : i64]) : TcMovedPathFacts
  (match facts
    [(TcMovedPathFacts.Nil) TcMovedPathFacts.Nil]
    [(TcMovedPathFacts.Cons fact rest)
      (let
        [tail : TcMovedPathFacts
          (tc-moved-path-facts-remove-root (box-get rest) root-id)]
        (if (= (tc-move-path-root-id (struct-get fact path)) root-id)
          tail
          (TcMovedPathFacts.Cons fact (box tail))))]))

(define (tc-moved-remove-root-state [set : TcMovedSet] [name-id : i64]) : TcMovedSet
  (let
    [without-root : TcMovedSet
      (tc-moved-remove-partial (tc-moved-remove set name-id) name-id)]
    [facts : TcMovedPathFacts
      (tc-moved-path-facts-remove-root (tc-moved-paths without-root) name-id)]
    (TcMovedSet
      (tc-moved-roots without-root)
      (tc-moved-partials without-root)
      facts
      (tc-moved-exact-path-index-from-facts facts)
      (tc-moved-hidden-atomic-users without-root))))

(define (tc-moved-any-root-path-at? [facts : TcMovedPathFacts] [root-id : i64]) : bool
  (match facts
    [(TcMovedPathFacts.Nil) false]
    [(TcMovedPathFacts.Cons fact rest)
      (if (and
        (match (struct-get fact kind)
          [(TcMovedPathKind.Move) true]
          [_ false])
        (= (tc-move-path-root-id (struct-get fact path)) root-id))
        true
        (tc-moved-any-root-path-at? (box-get rest) root-id))]))

(define (tc-moved-any-root-path? [set : TcMovedSet] [root-id : i64]) : bool
  (tc-moved-any-root-path-at? (tc-moved-paths set) root-id))

(define (tc-moved-root-path-conflict-loop
  [facts : TcMovedPathFacts]
  [root-id : i64]) : TcMoveConflict
  (match facts
    [(TcMovedPathFacts.Nil) TcMoveConflict.No]
    [(TcMovedPathFacts.Cons fact rest)
      (if (and
        (match (struct-get fact kind)
          [(TcMovedPathKind.Move) true]
          [_ false])
        (= (tc-move-path-root-id (struct-get fact path)) root-id))
        (TcMoveConflict.Some
          (tc-move-path-render (struct-get fact path))
          (tc-moved-path-fact-origin fact))
        (tc-moved-root-path-conflict-loop (box-get rest) root-id))]))

(define (tc-moved-root-path-conflict [set : TcMovedSet] [root-id : i64]) : TcMoveConflict
  (tc-moved-root-path-conflict-loop (tc-moved-paths set) root-id))

(define (tc-moved-root-conflict [set : TcMovedSet] [root-id : i64]) : TcMoveConflict
  (match (tc-moved-conflict set root-id)
    [(TcMoveConflict.Some key origin-id) (TcMoveConflict.Some key origin-id)]
    [TcMoveConflict.No
      (match (tc-moved-root-path-conflict set root-id)
        [(TcMoveConflict.Some key origin-id)
          (TcMoveConflict.Some key origin-id)]
        [TcMoveConflict.No (tc-moved-partial-conflict set root-id)])]))

(define (tc-moved-remove-exact-path
  [set : TcMovedSet]
  [root-id : i64]
  [path : TcMovePath]) : TcMovedSet
  (let
    [without-path : TcMovedSet
      (tc-moved-remove-path-kind set path (TcMovedPathKind.Move))]
    (if (tc-moved-any-root-path? without-path root-id)
      without-path
      (tc-moved-remove-partial without-path root-id))))

(define (tc-moved-union-path-loop [a : TcMovedPathFacts] [out : TcMovedSet]) : TcMovedSet
  (match a
    [(TcMovedPathFacts.Nil) out]
    [(TcMovedPathFacts.Cons fact rest)
      (tc-moved-union-path-loop
        (box-get rest)
        (tc-moved-add-path-fact
          out
          (struct-get fact path)
          (struct-get fact kind)
          (tc-moved-path-fact-origin fact)))]))

(define (tc-moved-union-id-loop
  [a : (& a tc_i64_i64_map.Map)]
  [index : i64]
  [out : tc_i64_i64_map.Map]) : tc_i64_i64_map.Map
  (if (>= index (tc_i64_i64_map.capacity a))
    out
    (match (tc_i64_i64_map.entry-at a index)
      [(tc_i64_i64_map.EntrySome key value)
        (let
          [out2 : tc_i64_i64_map.Map out]
          (begin
            (tc_i64_i64_map.insert-ref! (&mut out2) key value)
            (tc-moved-union-id-loop
              a
              (tc_i64_i64_map.next-occupied a (+ index 1))
              out2)))]
      [(tc_i64_i64_map.EntryNone)
        (tc-moved-union-id-loop
          a
          (tc_i64_i64_map.next-occupied a (+ index 1))
          out)])))

;; Union keeps the left input's value for duplicate facts. Branch merging
;; therefore reports the origin from the first/left arm deterministically.
(define (tc-moved-union [a : TcMovedSet] [b : TcMovedSet]) : TcMovedSet
  (let
    [a-roots : tc_i64_i64_map.Map (tc-moved-roots a)]
    [a-partials : tc_i64_i64_map.Map (tc-moved-partials a)]
    [a-paths : TcMovedPathFacts (tc-moved-paths a)]
    [a-hidden : tc_i64_i64_map.Map (tc-moved-hidden-atomic-users a)]
    [b-roots : tc_i64_i64_map.Map (tc-moved-roots b)]
    [b-partials : tc_i64_i64_map.Map (tc-moved-partials b)]
    [b-paths : TcMovedPathFacts (tc-moved-paths b)]
    [b-hidden : tc_i64_i64_map.Map (tc-moved-hidden-atomic-users b)]
    [with-a-paths : TcMovedSet
      (TcMovedSet
        b-roots
        b-partials
        a-paths
        (tc-moved-exact-path-index-from-facts a-paths)
        b-hidden)]
    [with-paths : TcMovedSet (tc-moved-union-path-loop b-paths with-a-paths)]
    (TcMovedSet
      (tc-moved-union-id-loop
        (& a-roots)
        (tc_i64_i64_map.next-occupied (& a-roots) 0)
        b-roots)
      (tc-moved-union-id-loop
        (& a-partials)
        (tc_i64_i64_map.next-occupied (& a-partials) 0)
        b-partials)
      (tc-moved-paths with-paths)
      (tc-moved-exact-path-index with-paths)
      (tc-moved-union-id-loop
        (& a-hidden)
        (tc_i64_i64_map.next-occupied (& a-hidden) 0)
        b-hidden))))

(define (tc-move-var-move-only-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (match (tc-lookup-id env name-id)
    [(ResultTcType.Ok ty) (tc-type-move-only? ty)]
    [(ResultTcType.Err _) false]))

(define (tc-type-consuming-by-value-now? [ctx : TcContext] [ty : AstType]) : bool
  (let
    [resolved : AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
    (match resolved
      [(AstType.Box _) true]
      [(AstType.Struct name)
        (if (tc-thread-safe-handle-type-name? (tc-nominal-name-id-display name))
          true
          (tc-cleanup-owning-struct-type? ctx resolved))]
      [(AstType.StructArgs name _)
        (if (tc-thread-safe-handle-type-name? (tc-nominal-name-id-display name))
          true
          (tc-cleanup-owning-struct-type? ctx resolved))]
      [_ false])))

(define (tc-call-param-consuming-now? [ctx : TcContext] [ty : AstType]) : bool
  (if (ast-type-consuming-param? ty)
    (tc-type-move-only?
      (tc-resolve-type ctx (ast-type-strip-consuming-param ty)))
    (tc-type-consuming-by-value-now? ctx ty)))

;; Matching a cleanup-owning enum consumes the whole scrutinee value. Ordinary
;; enums stay compatibility-non-consuming for existing AST/IR-style sharing.
(define (tc-type-consuming-match-scrutinee-now?
  [ctx : TcContext]
  [ty : AstType]) : bool
  (tc-cleanup-owning-enum-type? ctx ty))

;; The bare variable named by an init/rhs expression, unwrapping spans and
;; annotations, or none if the expression is not a whole-variable reference.
(define (tc-move-bare-var [expr : AstExpr]) : TcMaybeMoveName
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-bare-var inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-bare-var inner))]
    [(AstExpr.Var name) (TcMaybeMoveName.Some name (tc-env-key-name-text name))]
    [_ (TcMaybeMoveName.No)]))

;; The root local named by a projection chain. Keep its parser-owned ID through
;; recursive projection unwrapping; String path analysis renders only at its
;; compatibility boundary below.
(define (tc-move-root-projection-var-id [expr : AstExpr]) : TcMaybeNameId
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-root-projection-var-id inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-root-projection-var-id inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-root-projection-var-id inner))]
    [(AstExpr.StructGet inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-root-projection-var-id inner))]
    [(AstExpr.TupleRef inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-root-projection-var-id inner))]
    [(AstExpr.ArrayRef array-box _)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-move-root-projection-var-id array))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-root-projection-var-id inner))]
    [(AstExpr.Var name) (TcMaybeNameId.Some name)]
    [_ (TcMaybeNameId.No)]))

(define (tc-move-root-projection-var [expr : AstExpr]) : TcMaybeString
  (match (tc-move-root-projection-var-id expr)
    [(TcMaybeNameId.Some name-id)
      (TcMaybeString.Some (tc-hygiene-name-text-id name-id))]
    [(TcMaybeNameId.No) (TcMaybeString.No)]))

(define (tc-move-dynamic-array-element-message) : String
  "typecheck: cannot move owner-consuming value out of dynamic array element")

(define (tc-move-box-projection-message) : String
  "typecheck: cannot move owner-consuming value out of box")

(define (tc-move-aggregate-path-message) : String
  "typecheck: cannot move owner-consuming value out of aggregate path")

(define (tc-move-aggregate-path-projection? [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-aggregate-path-projection? inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-aggregate-path-projection? inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-aggregate-path-projection? inner))]
    [(AstExpr.StructGet _ _) true]
    [(AstExpr.TupleRef _ _) true]
    [(AstExpr.ArrayRef _ _) true]
    [(AstExpr.BoxGet _) true]
    [_ false]))

(define (tc-move-path-segments-append-field
  [segments : TcMovePathSegments]
  [field-id : i64]) : TcMovePathSegments
  (match segments
    [(TcMovePathSegments.Nil)
      (TcMovePathSegments.Field field-id (box TcMovePathSegments.Nil))]
    [(TcMovePathSegments.Field id rest)
      (TcMovePathSegments.Field
        id
        (box (tc-move-path-segments-append-field (box-get rest) field-id)))]
    [(TcMovePathSegments.TupleIndex index rest)
      (TcMovePathSegments.TupleIndex
        index
        (box (tc-move-path-segments-append-field (box-get rest) field-id)))]
    [(TcMovePathSegments.ArrayIndex index rest)
      (TcMovePathSegments.ArrayIndex
        index
        (box (tc-move-path-segments-append-field (box-get rest) field-id)))]))

(define (tc-move-path-segments-append-tuple
  [segments : TcMovePathSegments]
  [tuple-index : i64]) : TcMovePathSegments
  (match segments
    [(TcMovePathSegments.Nil)
      (TcMovePathSegments.TupleIndex tuple-index (box TcMovePathSegments.Nil))]
    [(TcMovePathSegments.Field id rest)
      (TcMovePathSegments.Field
        id
        (box (tc-move-path-segments-append-tuple (box-get rest) tuple-index)))]
    [(TcMovePathSegments.TupleIndex index rest)
      (TcMovePathSegments.TupleIndex
        index
        (box (tc-move-path-segments-append-tuple (box-get rest) tuple-index)))]
    [(TcMovePathSegments.ArrayIndex index rest)
      (TcMovePathSegments.ArrayIndex
        index
        (box (tc-move-path-segments-append-tuple (box-get rest) tuple-index)))]))

(define (tc-move-path-segments-append-array
  [segments : TcMovePathSegments]
  [array-index : i64]) : TcMovePathSegments
  (match segments
    [(TcMovePathSegments.Nil)
      (TcMovePathSegments.ArrayIndex array-index (box TcMovePathSegments.Nil))]
    [(TcMovePathSegments.Field id rest)
      (TcMovePathSegments.Field
        id
        (box (tc-move-path-segments-append-array (box-get rest) array-index)))]
    [(TcMovePathSegments.TupleIndex index rest)
      (TcMovePathSegments.TupleIndex
        index
        (box (tc-move-path-segments-append-array (box-get rest) array-index)))]
    [(TcMovePathSegments.ArrayIndex index rest)
      (TcMovePathSegments.ArrayIndex
        index
        (box (tc-move-path-segments-append-array (box-get rest) array-index)))]))

(define (tc-move-path-append [base : TcMovePath] [field-id : i64]) : TcMovePath
  (TcMovePath
    (struct-get base root)
    (tc-move-path-segments-append-field (struct-get base segments) field-id)))

(define (tc-move-tuple-index-path [base : TcMovePath] [index : i64]) : TcMovePath
  (TcMovePath
    (struct-get base root)
    (tc-move-path-segments-append-tuple (struct-get base segments) index)))

(define (tc-move-array-index-path [base : TcMovePath] [index : i64]) : TcMovePath
  (TcMovePath
    (struct-get base root)
    (tc-move-path-segments-append-array (struct-get base segments) index)))

(define (tc-move-literal-index [expr : AstExpr]) : TcMoveMaybeIndex
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-literal-index inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-literal-index inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-literal-index inner))]
    [(AstExpr.Literal lit)
      (match lit
        [(AstLiteral.Int index _) (TcMoveMaybeIndex.Some index)]
        [_ (TcMoveMaybeIndex.No)])]
    [_ (TcMoveMaybeIndex.No)]))

(define (tc-move-direct-root-base-path [expr : AstExpr]) : TcMaybeMovePath
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-direct-root-base-path inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-direct-root-base-path inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-direct-root-base-path inner))]
    [(AstExpr.StructGet inner-box field)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-move-direct-root-base-path inner)
          [(TcMaybeMovePath.Some base)
            (TcMaybeMovePath.Some (tc-move-path-append base field))]
          [(TcMaybeMovePath.No) (TcMaybeMovePath.No)]))]
    [(AstExpr.TupleRef inner-box index)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-move-direct-root-base-path inner)
          [(TcMaybeMovePath.Some base)
            (TcMaybeMovePath.Some (tc-move-tuple-index-path base index))]
          [(TcMaybeMovePath.No) (TcMaybeMovePath.No)]))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index-expr : AstExpr (ast-node-get index-box)]
        (match (tc-move-direct-root-base-path array)
          [(TcMaybeMovePath.Some base)
            (match (tc-move-literal-index index-expr)
              [(TcMoveMaybeIndex.Some index)
                (TcMaybeMovePath.Some (tc-move-array-index-path base index))]
              [(TcMoveMaybeIndex.No) (TcMaybeMovePath.No)])]
          [(TcMaybeMovePath.No) (TcMaybeMovePath.No)]))]
    [(AstExpr.Var name)
      (TcMaybeMovePath.Some (TcMovePath name TcMovePathSegments.Nil))]
    [_ (TcMaybeMovePath.No)]))

(define (tc-move-struct-field-path [expr : AstExpr]) : TcMaybeMovePath
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-struct-field-path inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-struct-field-path inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-struct-field-path inner))]
    [(AstExpr.StructGet inner-box field)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-move-direct-root-base-path inner)
          [(TcMaybeMovePath.Some base)
            (TcMaybeMovePath.Some (tc-move-path-append base field))]
          [(TcMaybeMovePath.No) (TcMaybeMovePath.No)]))]
    [_ (TcMaybeMovePath.No)]))

(define (tc-move-tuple-element-path [expr : AstExpr]) : TcMaybeMovePath
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-tuple-element-path inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-tuple-element-path inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-tuple-element-path inner))]
    [(AstExpr.TupleRef inner-box index)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-move-direct-root-base-path inner)
          [(TcMaybeMovePath.Some base)
            (TcMaybeMovePath.Some (tc-move-tuple-index-path base index))]
          [(TcMaybeMovePath.No) (TcMaybeMovePath.No)]))]
    [_ (TcMaybeMovePath.No)]))

(define (tc-move-array-element-path [expr : AstExpr]) : TcMaybeMovePath
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-array-element-path inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-array-element-path inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-array-element-path inner))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index-expr : AstExpr (ast-node-get index-box)]
        (tc-move-array-set-path array index-expr))]
    [_ (TcMaybeMovePath.No)]))

(define (tc-move-array-set-path [array : AstExpr] [index-expr : AstExpr]) : TcMaybeMovePath
  (match (tc-move-direct-root-base-path array)
    [(TcMaybeMovePath.Some base)
      (match (tc-move-literal-index index-expr)
        [(TcMoveMaybeIndex.Some index)
          (TcMaybeMovePath.Some (tc-move-array-index-path base index))]
        [(TcMoveMaybeIndex.No) (TcMaybeMovePath.No)])]
    [(TcMaybeMovePath.No) (TcMaybeMovePath.No)]))

(define (tc-move-struct-set-path [receiver : AstExpr] [field-id : i64]) : TcMaybeMovePath
  (match (tc-move-direct-root-base-path receiver)
    [(TcMaybeMovePath.Some base)
      (TcMaybeMovePath.Some (tc-move-path-append base field-id))]
    [(TcMaybeMovePath.No) (TcMaybeMovePath.No)]))

(define (tc-move-reinitialize-array-set-path
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [array : AstExpr]
  [index : AstExpr]) : TcMovedSet
  (match (tc-move-array-set-path array index)
    [(TcMaybeMovePath.Some path)
      (match (tc-move-root-projection-var-id array)
        [(TcMaybeNameId.Some root-id)
          (if (tc-moved-contains? locals root-id)
            (tc-moved-remove-exact-path moved root-id path)
            moved)]
        [(TcMaybeNameId.No) moved])]
    [(TcMaybeMovePath.No) moved]))

(define (tc-move-reinitialize-struct-set-path
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [receiver : AstExpr]
  [field-id : i64]) : TcMovedSet
  (match (tc-move-struct-set-path receiver field-id)
    [(TcMaybeMovePath.Some path)
      (match (tc-move-root-projection-var-id receiver)
        [(TcMaybeNameId.Some root-id)
          (if (tc-moved-contains? locals root-id)
            (tc-moved-remove-exact-path moved root-id path)
            moved)]
        [(TcMaybeNameId.No) moved])]
    [(TcMaybeMovePath.No) moved]))

(define (tc-move-projection-path [expr : AstExpr]) : TcMaybeMovePath
  (match (tc-move-struct-field-path expr)
    [(TcMaybeMovePath.Some path) (TcMaybeMovePath.Some path)]
    [(TcMaybeMovePath.No)
      (match (tc-move-tuple-element-path expr)
        [(TcMaybeMovePath.Some path) (TcMaybeMovePath.Some path)]
        [(TcMaybeMovePath.No) (tc-move-array-element-path expr)])]))

(define (tc-moved-add-projection-path
  [moved : TcMovedSet]
  [root-id : i64]
  [path : TcMovePath]
  [origin : AstExpr]) : TcMovedSet
  (let
    [origin-id : i64 (ast-node-push origin)]
    (tc-moved-add-partial-value
      (tc-moved-add-path-fact moved path (TcMovedPathKind.Move) origin-id)
      root-id
      origin-id)))

(define (tc-move-box-projection? [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-box-projection? inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-box-projection? inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-box-projection? inner))]
    [(AstExpr.StructGet inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-box-projection? inner))]
    [(AstExpr.TupleRef inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-box-projection? inner))]
    [(AstExpr.ArrayRef array-box _)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-move-box-projection? array))]
    [(AstExpr.BoxGet _) true]
    [_ false]))

(define (tc-move-dynamic-array-element-projection?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-dynamic-array-element-projection? ctx env inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-dynamic-array-element-projection? ctx env inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-dynamic-array-element-projection? ctx env inner))]
    [(AstExpr.StructGet inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-dynamic-array-element-projection? ctx env inner))]
    [(AstExpr.TupleRef inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-dynamic-array-element-projection? ctx env inner))]
    [(AstExpr.ArrayRef array-box _)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (match (tc-expr ctx env array)
          [(ResultTcType.Ok array-ty)
            (match (tc-type-strip-region (tc-resolve-type ctx array-ty))
              [(AstType.DynArray _) true]
              [_ (tc-move-dynamic-array-element-projection? ctx env array)])]
          [(ResultTcType.Err _)
            (tc-move-dynamic-array-element-projection? ctx env array)]))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-dynamic-array-element-projection? ctx env inner))]
    [_ false]))

(define (tc-move-binding-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [maybe-ty : AstMaybeType]
  [init : AstExpr]) : AstType
  (match maybe-ty
    [(AstMaybeType.Some t)
      (let
        [resolved : AstType (tc-resolve-type ctx t)]
        (match (tc-expr-with-expected-or-actual ctx env init resolved)
          [(ResultTcType.Ok init-ty)
            (if (tc-type-contains-any-region init-ty)
              init-ty
              resolved)]
          [(ResultTcType.Err _) resolved]))]
    [(AstMaybeType.No)
      (match (tc-expr ctx env init)
        [(ResultTcType.Ok t) t]
        [(ResultTcType.Err _) (AstType.I64)])]))

;; The names that are genuine local/parameter bindings, seeded from a function's
;; parameter list. Only these are tracked as movable places; enum constructors,
;; globals, and function references share the variable syntax but are never moved.
(define (tc-move-params-locals [params : AstParamList] [acc : TcMovedSet]) : TcMovedSet
  (tc-move-params-locals-at (& params) 0 acc))

(define (tc-move-params-locals-at
  [params : (& params AstParamList)]
  [index : i64]
  [acc : TcMovedSet]) : TcMovedSet
  (if (>= index (ast-param-list-len params))
    acc
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param name _ _ _)
        (tc-move-params-locals-at params (+ index 1) (tc-moved-add acc name))])))

(define (tc-move-after-consuming-projection
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : AstExpr]) : TcMoveResult
  (if (tc-move-dynamic-array-element-projection? ctx env expr)
    (TcMoveResult.Err (tc-move-dynamic-array-element-message))
    (if (tc-move-box-projection? expr)
      (TcMoveResult.Err (tc-move-box-projection-message))
      (match (tc-move-projection-path expr)
        [(TcMaybeMovePath.Some path)
          (match (tc-move-root-projection-var-id expr)
            [(TcMaybeNameId.Some root-id)
              (if (tc-moved-contains? locals root-id)
                (match (tc-moved-path-conflict moved path)
                  [(TcMoveConflict.Some key origin-id)
                    (tc-move-rich-use-conflict-result
                      (TcMoveConflict.Some key origin-id)
                      (tc-move-path-render path)
                      expr
                      (tc-move-path-render path))]
                  [TcMoveConflict.No
                    (TcMoveResult.Ok
                      (tc-moved-add-projection-path moved root-id path expr))])
                (TcMoveResult.Ok moved))]
            [(TcMaybeNameId.No) (TcMoveResult.Ok moved)])]
        [(TcMaybeMovePath.No)
          (if (tc-move-aggregate-path-projection? expr)
            (TcMoveResult.Err (tc-move-aggregate-path-message))
            (match (tc-move-root-projection-var-id expr)
              [(TcMaybeNameId.Some root-id)
                (let
                  [root : String (tc-env-key-name-text root-id)]
                  (if (tc-moved-contains? locals root-id)
                    (if (tc-moved-partial? moved root-id)
                      (tc-move-rich-use-conflict-result
                        (tc-moved-root-conflict moved root-id)
                        root
                        expr
                        root)
                      (if (tc-moved-contains? loop-carried root-id)
                        (tc-move-rich-loop-carried-result root expr)
                        (TcMoveResult.Ok
                          (tc-moved-add-origin moved root-id expr))))
                    (TcMoveResult.Ok moved)))]
              [(TcMaybeNameId.No) (TcMoveResult.Ok moved)]))]))))

(define (tc-move-after-bind-typed
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [init : AstExpr]
  [init-ty : AstType]) : TcMoveResult
  (if (tc-type-consuming-by-value-now? ctx init-ty)
    (tc-move-after-consuming-projection ctx env locals loop-carried moved init)
    (TcMoveResult.Ok moved)))

;; Mark the source variable moved when an init/rhs is a bare move-only variable
;; that names a tracked local/parameter (not an enum constructor or global).
(define (tc-move-after-bind
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [init : AstExpr]) : TcMoveResult
  (match (tc-move-bare-var init)
    [(TcMaybeMoveName.Some v-id v)
      (if (and
        (tc-moved-contains? locals v-id)
        (tc-move-var-move-only-id? env v-id))
        (if (tc-moved-partial? moved v-id)
          (tc-move-rich-use-conflict-result
            (tc-moved-root-conflict moved v-id)
            v
            init
            v)
          (if (tc-moved-contains? loop-carried v-id)
            (tc-move-rich-loop-carried-result v init)
            (TcMoveResult.Ok (tc-moved-add-origin moved v-id init))))
        (TcMoveResult.Ok moved))]
    [(TcMaybeMoveName.No)
      (match (cfg
        compile-profile
        (compiler-tc-reinfer-profile-expr "move.bind_init" ctx env init)
        (tc-expr ctx env init))
        [(ResultTcType.Ok init-ty)
          (tc-move-after-bind-typed
            ctx
            env
            locals
            loop-carried
            moved
            init
            init-ty)]
        [(ResultTcType.Err _) (TcMoveResult.Ok moved)])]))

(define (tc-move-after-bind-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [init-id : i64]) : TcMoveResult
  (let
    [init : AstExpr (ast-node-get init-id)]
    (match (tc-move-bare-var init)
      [(TcMaybeMoveName.Some v-id v)
        (if (and
          (tc-moved-contains? locals v-id)
          (tc-move-var-move-only-id? env v-id))
          (if (tc-moved-partial? moved v-id)
            (tc-move-rich-use-conflict-result
              (tc-moved-root-conflict moved v-id)
              v
              init
              v)
            (if (tc-moved-contains? loop-carried v-id)
              (tc-move-rich-loop-carried-result v init)
              (TcMoveResult.Ok (tc-moved-add-origin moved v-id init))))
          (TcMoveResult.Ok moved))]
      [(TcMaybeMoveName.No)
        (match (tc-body-type-fact-expr-id "move.bind_init" ctx env init-id)
          [(ResultTcType.Ok init-ty)
            (tc-move-after-bind-typed
              ctx
              env
              locals
              loop-carried
              moved
              init
              init-ty)]
          [(ResultTcType.Err _) (TcMoveResult.Ok moved)])])))

(define (tc-move-after-bind-known-type-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [init-id : i64]
  [init-ty : AstType]) : TcMoveResult
  (let
    [init : AstExpr (ast-node-get init-id)]
    (match (tc-move-bare-var init)
      [(TcMaybeMoveName.Some v-id v)
        (if (and
          (tc-moved-contains? locals v-id)
          (tc-move-var-move-only-id? env v-id))
          (if (tc-moved-partial? moved v-id)
            (tc-move-rich-use-conflict-result
              (tc-moved-root-conflict moved v-id)
              v
              init
              v)
            (if (tc-moved-contains? loop-carried v-id)
              (tc-move-rich-loop-carried-result v init)
              (TcMoveResult.Ok (tc-moved-add-origin moved v-id init))))
          (TcMoveResult.Ok moved))]
      [(TcMaybeMoveName.No)
        (tc-move-after-bind-typed
          ctx
          env
          locals
          loop-carried
          moved
          init
          init-ty)])))

(define (tc-move-after-moving-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : AstExpr]
  [move? : bool]) : TcMoveResult
  (if move?
    (tc-move-after-consuming-projection ctx env locals loop-carried moved expr)
    (TcMoveResult.Ok moved)))

(define (tc-move-after-consuming-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : AstExpr]
  [target-ty : AstType]) : TcMoveResult
  (tc-move-after-moving-value
    ctx
    env
    locals
    loop-carried
    moved
    expr
    (tc-call-param-consuming-now? ctx target-ty)))

(define (tc-move-after-move-only-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : AstExpr]
  [target-ty : AstType]) : TcMoveResult
  (tc-move-after-moving-value
    ctx
    env
    locals
    loop-carried
    moved
    expr
    (tc-type-move-only? (tc-resolve-type ctx target-ty))))

(define (tc-move-after-match-scrutinee
  [ctx : TcContext]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [expr : AstExpr]
  [scrut-ty : AstType]) : TcMovedSet
  (match (tc-move-bare-var expr)
    [(TcMaybeMoveName.Some v-id _)
      (if (and
        (tc-moved-contains? locals v-id)
        (tc-type-consuming-match-scrutinee-now? ctx scrut-ty))
        (tc-moved-add-origin moved v-id expr)
        moved)]
    [(TcMaybeMoveName.No) moved]))

(define (tc-move-consume-local
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [name-id : i64]
  [origin : AstExpr]) : TcMoveResult
  (let
    [name : String (tc-hygiene-name-text-id name-id)]
    (if (tc-moved-contains? locals name-id)
      (if (or
        (tc-moved-contains? moved name-id)
        (tc-moved-partial? moved name-id))
        (tc-move-rich-use-conflict-result
          (tc-moved-root-conflict moved name-id)
          name
          origin
          name)
        (if (tc-moved-contains? loop-carried name-id)
          (tc-move-rich-loop-carried-result name origin)
          (TcMoveResult.Ok (tc-moved-add-origin moved name-id origin))))
      (TcMoveResult.Ok moved))))

(define (tc-move-invalidate-local
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [name-id : i64]
  [origin : AstExpr]) : TcMoveResult
  (let
    [name : String (tc-hygiene-name-text-id name-id)]
    (cond
      [(not (tc-moved-contains? locals name-id)) (TcMoveResult.Ok moved)]
      [(tc-moved-contains? moved name-id) (TcMoveResult.Ok moved)]
      [(tc-moved-partial? moved name-id)
        (tc-move-rich-use-conflict-result
          (tc-moved-root-conflict moved name-id)
          name
          origin
          name)]
      [(tc-moved-contains? loop-carried name-id)
        (tc-move-rich-loop-carried-result name origin)]
      [else (TcMoveResult.Ok (tc-moved-add-origin moved name-id origin))])))

(define (tc-move-mark-region-locals-scan
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [region : i64]
  [seen : TcNameIdList]
  [remaining : i64]
  [origin : AstExpr]) : TcMoveResult
  (if (<= remaining 0)
    (TcMoveResult.Ok moved)
    (match (tc-type-env-marker-step env)
      [(TcTypeEnvMarkerStep.Done) (TcMoveResult.Ok moved)]
      [(TcTypeEnvMarkerStep.Cache rest-env)
        (tc-move-mark-region-locals-scan
          rest-env
          locals
          loop-carried
          moved
          region
          seen
          remaining
          origin)]
      [(TcTypeEnvMarkerStep.Bind key ty rest-env)
        (cond
          [(= key (tc-default-boundary-id)) (TcMoveResult.Ok moved)]
          [(tc-name-id-list-contains seen key)
            (tc-move-mark-region-locals-scan
              rest-env
              locals
              loop-carried
              moved
              region
              seen
              remaining
              origin)]
          [(not (tc-moved-contains? locals key))
            (tc-move-mark-region-locals-scan
              rest-env
              locals
              loop-carried
              moved
              region
              (tc-name-id-list-add seen key)
              remaining
              origin)]
          [(tc-type-contains-region ty region)
            (match (tc-move-invalidate-local
              locals
              loop-carried
              moved
              key
              origin)
              [(TcMoveResult.Ok moved2)
                (tc-move-mark-region-locals-scan
                  rest-env
                  locals
                  loop-carried
                  moved2
                  region
                  (tc-name-id-list-add seen key)
                  (- remaining 1)
                  origin)]
              [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
          [else
            (tc-move-mark-region-locals-scan
              rest-env
              locals
              loop-carried
              moved
              region
              (tc-name-id-list-add seen key)
              (- remaining 1)
              origin)])])))

(define (tc-move-mark-region-locals
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [region : i64]
  [origin : AstExpr]) : TcMoveResult
  (tc-move-mark-region-locals-scan
    env
    locals
    loop-carried
    moved
    region
    TcNameIdList.Nil
    (tc-moved-len locals)
    origin))

(define (tc-move-mark-owner-region-locals-scan
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [owner : i64]
  [seen : TcNameIdList]
  [remaining : i64]
  [origin : AstExpr]) : TcMoveResult
  (if (<= remaining 0)
    (TcMoveResult.Ok moved)
    (match (tc-type-env-marker-step env)
      [(TcTypeEnvMarkerStep.Done) (TcMoveResult.Ok moved)]
      [(TcTypeEnvMarkerStep.Cache rest-env)
        (tc-move-mark-owner-region-locals-scan
          rest-env
          locals
          loop-carried
          moved
          owner
          seen
          remaining
          origin)]
      [(TcTypeEnvMarkerStep.Bind key ty rest-env)
        (cond
          [(= key (tc-default-boundary-id)) (TcMoveResult.Ok moved)]
          [(tc-name-id-list-contains seen key)
            (tc-move-mark-owner-region-locals-scan
              rest-env
              locals
              loop-carried
              moved
              owner
              seen
              remaining
              origin)]
          [(not (tc-moved-contains? locals key))
            (tc-move-mark-owner-region-locals-scan
              rest-env
              locals
              loop-carried
              moved
              owner
              (tc-name-id-list-add seen key)
              remaining
              origin)]
          [(tc-type-contains-arena-owner-region? ty owner)
            (match (tc-move-invalidate-local
              locals
              loop-carried
              moved
              key
              origin)
              [(TcMoveResult.Ok moved2)
                (tc-move-mark-owner-region-locals-scan
                  rest-env
                  locals
                  loop-carried
                  moved2
                  owner
                  (tc-name-id-list-add seen key)
                  (- remaining 1)
                  origin)]
              [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
          [else
            (tc-move-mark-owner-region-locals-scan
              rest-env
              locals
              loop-carried
              moved
              owner
              (tc-name-id-list-add seen key)
              (- remaining 1)
              origin)])])))

(define (tc-move-mark-owner-region-locals
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [owner : i64]
  [origin : AstExpr]) : TcMoveResult
  (tc-move-mark-owner-region-locals-scan
    env
    locals
    loop-carried
    moved
    owner
    TcNameIdList.Nil
    (tc-moved-len locals)
    origin))

(define (tc-moved-add-hidden-atomic-user [set : TcMovedSet] [owner-id : i64]) : TcMovedSet
  (let
    [hidden : tc_i64_i64_map.Map (tc-moved-hidden-atomic-users set)]
    (begin
      (tc_i64_i64_map.insert-ref!
        (&mut hidden)
        owner-id
        (tc-moved-no-origin-id))
      (TcMovedSet
        (tc-moved-roots set)
        (tc-moved-partials set)
        (tc-moved-paths set)
        (tc-moved-exact-path-index set)
        hidden))))

(define (tc-moved-hidden-atomic-user? [set : TcMovedSet] [owner-id : i64]) : bool
  (let
    [hidden : tc_i64_i64_map.Map (tc-moved-hidden-atomic-users set)]
    (tc_i64_i64_map.contains? (& hidden) owner-id)))

(define (tc-move-mark-hidden-atomic-arena-users
  [moved : TcMovedSet]
  [owners : TcNameIdList]) : TcMovedSet
  (match owners
    [(TcNameIdList.Nil) moved]
    [(TcNameIdList.Cons owner rest)
      (tc-move-mark-hidden-atomic-arena-users
        (tc-moved-add-hidden-atomic-user moved owner)
        (box-get rest))]))

(define (tc-move-atomic-arena-hidden-user-message [owner : String]) : String
  (str_cat.str-cat
    "typecheck: arena.destroy-safe!/rewind-safe! cannot prove atomic arena `"
    owner
    "` is released after an owner-tagged value was sent to a channel"))

(define (tc-move-check-atomic-arena-hidden-users-released
  [moved : TcMovedSet]
  [owner-id : i64]) : TcMoveResult
  (if (tc-moved-hidden-atomic-user? moved owner-id)
    (TcMoveResult.Err
      (tc-move-atomic-arena-hidden-user-message (tc-env-key-name-text owner-id)))
    (TcMoveResult.Ok moved)))

(define (tc-move-atomic-arena-live-user-message
  [owner : String]
  [name : String]) : String
  (str_cat.str-cat
    "typecheck: arena.destroy-safe!/rewind-safe! requires atomic arena user `"
    name
    "` to be joined or released before invalidating `"
    owner
    "`"))

(define (tc-move-check-atomic-arena-users-released-scan
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [owner : i64]
  [seen : TcNameIdList]
  [remaining : i64]) : TcMoveResult
  (if (<= remaining 0)
    (TcMoveResult.Ok moved)
    (match (tc-type-env-marker-step env)
      [(TcTypeEnvMarkerStep.Done) (TcMoveResult.Ok moved)]
      [(TcTypeEnvMarkerStep.Cache rest-env)
        (tc-move-check-atomic-arena-users-released-scan
          ctx
          rest-env
          locals
          moved
          owner
          seen
          remaining)]
      [(TcTypeEnvMarkerStep.Bind key ty rest-env)
        (cond
          [(= key (tc-default-boundary-id)) (TcMoveResult.Ok moved)]
          [(tc-name-id-list-contains seen key)
            (tc-move-check-atomic-arena-users-released-scan
              ctx
              rest-env
              locals
              moved
              owner
              seen
              remaining)]
          [(not (tc-moved-contains? locals key))
            (tc-move-check-atomic-arena-users-released-scan
              ctx
              rest-env
              locals
              moved
              owner
              (tc-name-id-list-add seen key)
              remaining)]
          [(and
              (tc-type-contains-arena-owner-region? ty owner)
              (tc-thread-safe-user-type? ctx ty)
              (not (tc-moved-contains? moved key)))
            (TcMoveResult.Err
              (tc-move-atomic-arena-live-user-message
                (tc-env-key-name-text owner)
                (tc-env-key-name-text key)))]
          [else
            (tc-move-check-atomic-arena-users-released-scan
              ctx
              rest-env
              locals
              moved
              owner
              (tc-name-id-list-add seen key)
              (- remaining 1))])])))

(define (tc-move-check-atomic-arena-users-released
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [owner : i64]) : TcMoveResult
  (match (tc-move-check-atomic-arena-hidden-users-released moved owner)
    [(TcMoveResult.Ok moved1)
      (tc-move-check-atomic-arena-users-released-scan
        ctx
        env
        locals
        moved1
        owner
        TcNameIdList.Nil
        (tc-moved-len locals))]
    [(TcMoveResult.Err message) (TcMoveResult.Err message)]))

(define (tc-move-safe-arena-rewind-effect
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [args : AstExprList]
  [origin : AstExpr]) : TcMoveResult
  (if (ast-expr-list-empty? (& args))
    (TcMoveResult.Ok moved)
    (let
      [phase-box : i64 (ast-expr-list-get (& args) 0 0)]
      [phase-expr : AstExpr (ast-node-get phase-box)]
      [pid : i64 (tc-expr-var-name-id phase-expr)]
      (if (>= pid 0)
        (match (tc-arena-phase-token-region-active env pid)
          [(TcMaybeNameId.Some region)
            (match (tc-arena-phase-token-owner-active env pid)
              [(TcMaybeNameId.Some owner)
                (match (if (tc-atomic-arena-owner-active-id? env owner)
                  (tc-move-check-atomic-arena-users-released
                    ctx
                    env
                    locals
                    moved
                    owner)
                  (TcMoveResult.Ok moved))
                  [(TcMoveResult.Ok moved1)
                    (match (tc-move-consume-local
                      locals
                      loop-carried
                      moved1
                      pid
                      origin)
                      [(TcMoveResult.Ok moved2)
                        (tc-move-mark-region-locals
                          env
                          locals
                          loop-carried
                          moved2
                          region
                          origin)]
                      [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
                  [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
              [(TcMaybeNameId.No)
                (match (tc-move-consume-local
                  locals
                  loop-carried
                  moved
                  pid
                  origin)
                  [(TcMoveResult.Ok moved2)
                    (tc-move-mark-region-locals
                      env
                      locals
                      loop-carried
                      moved2
                      region
                      origin)]
                  [(TcMoveResult.Err message) (TcMoveResult.Err message)])])]
          [(TcMaybeNameId.No) (TcMoveResult.Ok moved)])
        (TcMoveResult.Ok moved)))))

(define (tc-move-safe-arena-destroy-effect
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [args : AstExprList]
  [origin : AstExpr]) : TcMoveResult
  (if (ast-expr-list-empty? (& args))
    (TcMoveResult.Ok moved)
    (let
      [owner-box : i64 (ast-expr-list-get (& args) 0 0)]
      [owner-expr : AstExpr (ast-node-get owner-box)]
      [oid : i64 (tc-expr-var-name-id owner-expr)]
      (if (>= oid 0)
        (if (or
          (tc-ordinary-arena-owner-active-id? env oid)
          (tc-atomic-arena-owner-active-id? env oid))
          (match (if (tc-atomic-arena-owner-active-id? env oid)
            (tc-move-check-atomic-arena-users-released ctx env locals moved oid)
            (TcMoveResult.Ok moved))
            [(TcMoveResult.Ok moved1)
              (match (tc-move-consume-local
                locals
                loop-carried
                moved1
                oid
                origin)
                [(TcMoveResult.Ok moved2)
                  (tc-move-mark-owner-region-locals
                    env
                    locals
                    loop-carried
                    moved2
                    oid
                    origin)]
                [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
            [(TcMoveResult.Err message) (TcMoveResult.Err message)])
          (TcMoveResult.Ok moved))
        (TcMoveResult.Ok moved)))))

(define (tc-move-check-safe-arena-call-effects
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [func : AstExpr]
  [args : AstExprList]
  [origin : AstExpr]) : TcMoveResult
  (let
    [raw-id : i64 (tc-expr-var-name-id func)]
    (if (>= raw-id 0)
      (let
        [raw-name : String (tc-hygiene-name-text-id raw-id)]
        [hygiene-global : bool (tc-hygiene-global-name-id? raw-id)]
        [name : String
          (if (and hygiene-global (not (macro-hygiene-global-id? raw-id)))
            (tc-hygiene-global-symbol-name raw-name)
            raw-name)]
        [name-id : i64 (tc-builtin-symbol-name-id raw-id hygiene-global)]
        [lookup-id : i64 (tc-call-builtin-lookup-id ctx env name name-id)]
        [arena-call-kind : i64
          (tc-arena-safe-call-kind-id ctx env name-id lookup-id)]
        (cond
          [(= arena-call-kind (tc-arena-safe-call-kind-rewind))
            (tc-move-safe-arena-rewind-effect
              ctx
              env
              locals
              loop-carried
              moved
              args
              origin)]
          [(= arena-call-kind (tc-arena-safe-call-kind-destroy))
            (tc-move-safe-arena-destroy-effect
              ctx
              env
              locals
              loop-carried
              moved
              args
              origin)]
          [else (TcMoveResult.Ok moved)]))
      (TcMoveResult.Ok moved))))

(define (tc-move-check-lambda-owner-captures-scan
  [ctx : TcContext]
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [bound : TcStringList]
  [seen : TcStringList]
  [remaining : i64]
  [body : AstExpr]) : TcMoveResult
  (if (<= remaining 0)
    (TcMoveResult.Ok moved)
    (match (tc-type-env-marker-step env)
      [(TcTypeEnvMarkerStep.Done) (TcMoveResult.Ok moved)]
      [(TcTypeEnvMarkerStep.Cache rest-env)
        (tc-move-check-lambda-owner-captures-scan
          ctx
          root
          rest-env
          locals
          loop-carried
          moved
          bound
          seen
          remaining
          body)]
      [(TcTypeEnvMarkerStep.Bind key ty rest-env)
        (let
          [name : String
            (if (tc-env-key-has-name-id? key)
              (intern-str key)
              "")]
          (cond
            [(= key (tc-default-boundary-id)) (TcMoveResult.Ok moved)]
            [(or
                (= key (tc-region-marker-id))
                (tc-cleanup-owner-marker-entry? key ty))
              (tc-move-check-lambda-owner-captures-scan
                ctx
                root
                rest-env
                locals
                loop-carried
                moved
                bound
                seen
                remaining
                body)]
            [(tc-string-list-contains seen name)
              (tc-move-check-lambda-owner-captures-scan
                ctx
                root
                rest-env
                locals
                loop-carried
                moved
                bound
                seen
                remaining
                body)]
            [(not (tc-moved-contains? locals key))
              (tc-move-check-lambda-owner-captures-scan
                ctx
                root
                rest-env
                locals
                loop-carried
                moved
                bound
                seen
                remaining
                body)]
            [(not (tc-expr-uses-free-name? body name bound))
              (tc-move-check-lambda-owner-captures-scan
                ctx
                root
                rest-env
                locals
                loop-carried
                moved
                bound
                (tc-string-list-add seen name)
                (- remaining 1)
                body)]
            [else
              (match (tc-lookup-id root key)
                [(ResultTcType.Ok visible-ty)
                  (if (tc-type-consuming-by-value-now? ctx visible-ty)
                    (if (or
                      (tc-moved-contains? moved key)
                      (tc-moved-partial? moved key))
                      (tc-move-rich-use-conflict-result
                        (tc-moved-root-conflict moved key)
                        name
                        body
                        name)
                      (if (tc-moved-contains? loop-carried key)
                        (tc-move-rich-loop-carried-result name body)
                        (tc-move-check-lambda-owner-captures-scan
                          ctx
                          root
                          rest-env
                          locals
                          loop-carried
                          (tc-moved-add-origin moved key body)
                          bound
                          (tc-string-list-add seen name)
                          (- remaining 1)
                          body)))
                    (tc-move-check-lambda-owner-captures-scan
                      ctx
                      root
                      rest-env
                      locals
                      loop-carried
                      moved
                      bound
                      (tc-string-list-add seen name)
                      (- remaining 1)
                      body))]
                [(ResultTcType.Err _)
                  (tc-move-check-lambda-owner-captures-scan
                    ctx
                    root
                    rest-env
                    locals
                    loop-carried
                    moved
                    bound
                    (tc-string-list-add seen name)
                    (- remaining 1)
                    body)])]))])))

(define (tc-move-check-lambda-owner-captures
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [params : AstParamList]
  [body : AstExpr]) : TcMoveResult
  (tc-move-check-lambda-owner-captures-scan
    ctx
    env
    env
    locals
    loop-carried
    moved
    (tc-param-bound-names params)
    TcStringList.Nil
    (tc-moved-len locals)
    body))

(define (tc-move-check-exprs-with-types-no-auto
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : AstExprList]
  [types : AstTypeList]) : TcMoveResult
  (tc-move-check-exprs-with-types-no-auto-at
    ctx
    env
    locals
    loop-carried
    moved
    (& exprs)
    (& types)
    0))

(define (tc-move-check-exprs-with-types-no-auto-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : (& exprs AstExprList)]
  [types : (& types AstTypeList)]
  [index : i64]) : TcMoveResult
  (if (>= index (struct-get exprs len))
    (if (>= index (ast-type-list-len types))
      (TcMoveResult.Ok moved)
      (TcMoveResult.Err (tc-call-arity-invariant-message "move-check")))
    (if (>= index (ast-type-list-len types))
      (TcMoveResult.Err (tc-call-arity-invariant-message "move-check"))
      (let
        [head : i64 (ast-expr-list-get exprs index 0)]
        [head-expr : AstExpr (ast-node-get head)]
        [raw-ty : AstType
          (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))]
        (match (tc-move-check-expr-id ctx env locals loop-carried moved head)
          [(TcMoveResult.Ok moved1)
            (match (tc-move-after-consuming-value
              ctx
              env
              locals
              loop-carried
              moved1
              head-expr
              raw-ty)
              [(TcMoveResult.Ok moved2)
                (tc-move-check-exprs-with-types-no-auto-at
                  ctx
                  env
                  locals
                  loop-carried
                  moved2
                  exprs
                  types
                  (+ index 1))]
              [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)])))))

(define (tc-move-check-exprs-with-types-auto
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : AstExprList]
  [types : AstTypeList]) : TcMoveResult
  (tc-move-check-exprs-with-types-auto-at
    ctx
    env
    locals
    loop-carried
    moved
    (& exprs)
    (& types)
    0))

(define (tc-move-check-exprs-with-types-auto-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : (& exprs AstExprList)]
  [types : (& types AstTypeList)]
  [index : i64]) : TcMoveResult
  (if (>= index (struct-get exprs len))
    (if (>= index (ast-type-list-len types))
      (TcMoveResult.Ok moved)
      (TcMoveResult.Err (tc-call-arity-invariant-message "move-check")))
    (if (>= index (ast-type-list-len types))
      (TcMoveResult.Err (tc-call-arity-invariant-message "move-check"))
      (let
        [head : i64 (ast-expr-list-get exprs index 0)]
        [head-expr : AstExpr (ast-node-get head)]
        [raw-ty : AstType
          (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))]
        [ty : AstType (ast-type-strip-consuming-param raw-ty)]
        (match (cfg
          compile-profile
          (compiler-tc-reinfer-profile-effective-arg-expr
            "move.call_arg"
            ctx
            env
            head-expr
            ty)
          (tc-call-effective-arg-expr ctx env head-expr ty))
          [(ResultTcExpr.Ok effective-head)
            (match (tc-move-check-expr
              ctx
              env
              locals
              loop-carried
              moved
              effective-head)
              [(TcMoveResult.Ok moved1)
                (match (tc-move-after-consuming-value
                  ctx
                  env
                  locals
                  loop-carried
                  moved1
                  effective-head
                  raw-ty)
                  [(TcMoveResult.Ok moved2)
                    (tc-move-check-exprs-with-types-auto-at
                      ctx
                      env
                      locals
                      loop-carried
                      moved2
                      exprs
                      types
                      (+ index 1))]
                  [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
              [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
          [(ResultTcExpr.Err message) (TcMoveResult.Err message)])))))

(define (tc-move-check-exprs-with-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : AstExprList]
  [types : AstTypeList]) : TcMoveResult
  (if (tc-call-type-list-has-immutable-ref-formal? ctx types)
    (tc-move-check-exprs-with-types-auto
      ctx
      env
      locals
      loop-carried
      moved
      exprs
      types)
    (tc-move-check-exprs-with-types-no-auto
      ctx
      env
      locals
      loop-carried
      moved
      exprs
      types)))

(define (tc-move-check-thread-channel-send-message
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]) : TcMoveResult
  (if (tc-thread-channel-send-call? ctx env func)
    (match (tc-thread-channel-send-call-name func)
      [(TcMaybeString.Some _)
        (match (tc-thread-channel-send-message-param params)
          [(ResultTcType.Ok message-ty)
            (match (tc-thread-channel-send-message-arg args)
              [(ResultTcExpr.Ok message-expr)
                (match (tc-move-after-move-only-value
                  ctx
                  env
                  locals
                  loop-carried
                  moved
                  message-expr
                  message-ty)
                  [(TcMoveResult.Ok moved2)
                    (TcMoveResult.Ok
                      (tc-move-mark-hidden-atomic-arena-users
                        moved2
                        (match (tc-expr ctx env message-expr)
                          [(ResultTcType.Ok actual-message-ty)
                            (tc-type-atomic-arena-owner-regions
                              env
                              actual-message-ty)]
                          [(ResultTcType.Err _)
                            (tc-type-atomic-arena-owner-regions env message-ty)])))]
                  [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
              [(ResultTcExpr.Err message) (TcMoveResult.Err message)])]
          [(ResultTcType.Err message) (TcMoveResult.Err message)])]
      [(TcMaybeString.No) (TcMoveResult.Ok moved)])
    (TcMoveResult.Ok moved)))

(define (tc-move-check-call-args-with-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [call-expr : AstExpr]
  [func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]) : TcMoveResult
  (match (tc-move-check-exprs-with-types
    ctx
    env
    locals
    loop-carried
    moved
    args
    params)
    [(TcMoveResult.Ok moved-args)
      (match (tc-move-check-thread-channel-send-message
        ctx
        env
        locals
        loop-carried
        moved-args
        func
        args
        params)
        [(TcMoveResult.Ok moved-thread)
          (tc-move-check-safe-arena-call-effects
            ctx
            env
            locals
            loop-carried
            moved-thread
            func
            args
            call-expr)]
        [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
    [(TcMoveResult.Err message) (TcMoveResult.Err message)]))

(define (tc-move-call-param-types-from-type [fn-ty : AstType]) : ResultTcTypeList
  (match (tc-type-strip-region fn-ty)
    [(AstType.Func params _) (ResultTcTypeList.Ok (box-get params))]
    [(AstType.Enum _) (ResultTcTypeList.Ok (ast-type-list-new))]
    [(AstType.EnumArgs _ _) (ResultTcTypeList.Ok (ast-type-list-new))]
    [_ (ResultTcTypeList.Err "typecheck: call target is not a function")]))

(define (tc-borrow-call-return-lifetimes-from-function
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]
  [ret : AstType]) : TcBorrowCallReturnLifetimes
  (if (tc-call-lifetime-constructor-for-func? ctx func ret)
    (TcBorrowCallReturnLifetimes.Fallback)
    (match (tc-call-constructor-target-for-func ctx env func params ret)
      [(AstMaybeType.Some _) (TcBorrowCallReturnLifetimes.Fallback)]
      [(AstMaybeType.No)
        (let
          [lifetimes : AstLifetimeList (tc-call-function-lifetimes params ret)]
          (if (ast-lifetime-list-empty? (& lifetimes))
            (TcBorrowCallReturnLifetimes.Known
              (tc-type-collect-reference-lifetimes (tc-resolve-type ctx ret)))
            (match (tc-infer-call-lifetime-subst
              ctx
              env
              func
              args
              params
              lifetimes
              TcLifetimeSubst.Nil)
              [(ResultTcLifetimeSubst.Ok subst)
                (TcBorrowCallReturnLifetimes.Known
                  (tc-type-collect-reference-lifetimes
                    (tc-resolve-type ctx (tc-lifetime-subst-type subst ret))))]
              [(ResultTcLifetimeSubst.Err _)
                (TcBorrowCallReturnLifetimes.Fallback)])))])))

(define (tc-borrow-call-info-from-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]
  [fn-ty : AstType]) : ResultTcBorrowCallInfo
  (match (tc-type-strip-region fn-ty)
    [(AstType.Func params ret)
      (let
        [params-list : AstTypeList (box-get params)]
        [ret-ty : AstType (ty-node-get ret)]
        (ResultTcBorrowCallInfo.Ok
          params-list
          (tc-borrow-call-return-lifetimes-from-function
            ctx
            env
            func
            args
            params-list
            ret-ty)))]
    [(AstType.Enum _)
      (ResultTcBorrowCallInfo.Ok
        (ast-type-list-new)
        (TcBorrowCallReturnLifetimes.Fallback))]
    [(AstType.EnumArgs _ _)
      (ResultTcBorrowCallInfo.Ok
        (ast-type-list-new)
        (TcBorrowCallReturnLifetimes.Fallback))]
    [_ (ResultTcBorrowCallInfo.Err "typecheck: call target is not a function")]))

(define (tc-borrow-call-info-id-raw
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]
  [args : AstExprList]) : ResultTcBorrowCallInfo
  (let
    [func : AstExpr (ast-node-get func-id)]
    (match (tc-expr-id ctx env func-id)
      [(ResultTcType.Ok fn-ty)
        (tc-borrow-call-info-from-type ctx env func args fn-ty)]
      [(ResultTcType.Err message) (ResultTcBorrowCallInfo.Err message)])))

(define (tc-borrow-call-info-id-with-facts
  [site : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]
  [args : AstExprList]) : ResultTcBorrowCallInfo
  (let
    [func : AstExpr (ast-node-get func-id)]
    (match (tc-body-type-fact-lookup-profiled site func-id)
      [(TcBodyTypeFact.Hit fn-ty)
        (tc-borrow-call-info-from-type ctx env func args fn-ty)]
      [(TcBodyTypeFact.Miss)
        (cfg
          compile-profile
          (compiler-tc-reinfer-profile-borrow-call-info-id
            site
            ctx
            env
            func-id
            args)
          (tc-borrow-call-info-id-raw ctx env func-id args))])))

(define (tc-move-call-param-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]) : ResultTcTypeList
  (match (tc-expr ctx env func)
    [(ResultTcType.Ok fn-ty) (tc-move-call-param-types-from-type fn-ty)]
    [(ResultTcType.Err message) (ResultTcTypeList.Err message)]))

(define (tc-move-call-param-types-id-raw
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]) : ResultTcTypeList
  (match (tc-expr-id ctx env func-id)
    [(ResultTcType.Ok fn-ty) (tc-move-call-param-types-from-type fn-ty)]
    [(ResultTcType.Err message) (ResultTcTypeList.Err message)]))

(define (tc-move-call-param-types-id-with-facts
  [site : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]) : ResultTcTypeList
  (match (tc-body-type-fact-lookup-profiled site func-id)
    [(TcBodyTypeFact.Hit fn-ty) (tc-move-call-param-types-from-type fn-ty)]
    [(TcBodyTypeFact.Miss)
      (cfg
        compile-profile
        (compiler-tc-reinfer-profile-call-param-types-id site ctx env func-id)
        (tc-move-call-param-types-id-raw ctx env func-id))]))

(define (tc-move-call-param-types-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]) : ResultTcTypeList
  (tc-move-call-param-types-id-with-facts "move.call_func" ctx env func-id))

(define (tc-move-check-exprs
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : AstExprList]) : TcMoveResult
  (tc-move-check-exprs-at ctx env locals loop-carried moved (& exprs) 0))

(define (tc-move-check-exprs-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : TcMoveResult
  (if (>= index (struct-get exprs len))
    (TcMoveResult.Ok moved)
    (match (tc-move-check-expr-id
      ctx
      env
      locals
      loop-carried
      moved
      (ast-expr-list-get exprs index 0))
      [(TcMoveResult.Ok moved1)
        (tc-move-check-exprs-at
          ctx
          env
          locals
          loop-carried
          moved1
          exprs
          (+ index 1))]
      [(TcMoveResult.Err message) (TcMoveResult.Err message)])))

(define (tc-move-check-let-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [bindings : AstLetBindingList]) : TcMoveBindings
  (tc-move-check-let-bindings-at
    ctx
    env
    locals
    loop-carried
    moved
    (& bindings)
    0))

(define (tc-move-check-let-bindings-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : TcMoveBindings
  (if (>= index (ast-let-binding-list-len bindings))
    (TcMoveBindings.Ok env moved locals loop-carried)
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (match (tc-move-check-expr-id
            ctx
            env
            locals
            loop-carried
            moved
            init-box)
            [(TcMoveResult.Ok moved1)
              (let
                [binding-ty : AstType
                  (tc-move-binding-type-id
                    "move.let_init"
                    ctx
                    env
                    maybe-ty
                    init-box)]
                (match (tc-move-after-bind-known-type-id
                  ctx
                  env
                  locals
                  loop-carried
                  moved1
                  init-box
                  binding-ty)
                  [(TcMoveResult.Ok moved2)
                    (tc-move-check-let-bindings-at
                      ctx
                      (tc-bind-c-abi-fnptr-if-needed-id
                        ctx
                        env
                        name
                        binding-ty
                        init)
                      (tc-moved-add locals name)
                      (tc-moved-remove-root-state loop-carried name)
                      (tc-moved-remove-root-state moved2 name)
                      bindings
                      (+ index 1))]
                  [(TcMoveResult.Err message) (TcMoveBindings.Err message)]))]
            [(TcMoveResult.Err message) (TcMoveBindings.Err message)]))])))

(define (tc-move-check-resource-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [bindings : AstResourceBindingList]) : TcMoveResourceBindings
  (tc-move-check-resource-bindings-at
    ctx
    env
    locals
    loop-carried
    moved
    (& bindings)
    0))

(define (tc-move-check-resource-bindings-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [bindings : (& bindings AstResourceBindingList)]
  [index : i64]) : TcMoveResourceBindings
  (if (>= index (ast-resource-binding-list-len bindings))
    (TcMoveResourceBindings.Ok
      env
      moved
      locals
      loop-carried
      TcMoveCleanupOwners.Nil)
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding name init-box _)
        (let
          [_init : AstExpr (ast-node-get init-box)]
          (match (tc-move-check-expr-id
            ctx
            env
            locals
            loop-carried
            moved
            init-box)
            [(TcMoveResult.Ok moved1)
              (match (tc-move-after-bind-id
                ctx
                env
                locals
                loop-carried
                moved1
                init-box)
                [(TcMoveResult.Ok moved2)
                  (match (tc-body-type-fact-expr-id
                    "move.resource_init"
                    ctx
                    env
                    init-box)
                    [(ResultTcType.Ok init-ty)
                      (match (tc-move-check-resource-bindings-at
                        ctx
                        (tc-bind-id
                          (tc-bind-id
                            env
                            (tc-cleanup-owner-marker-id)
                            (AstType.Var name))
                          name
                          (tc-type-without-regions init-ty))
                        (tc-moved-add locals name)
                        (tc-moved-remove-root-state loop-carried name)
                        (tc-moved-remove-root-state moved2 name)
                        bindings
                        (+ index 1))
                        [(TcMoveResourceBindings.Ok
                            env2
                            moved3
                            locals2
                            loop-carried2
                            roots)
                          (TcMoveResourceBindings.Ok
                            env2
                            moved3
                            locals2
                            loop-carried2
                            (TcMoveCleanupOwners.Cons name init-box (box roots)))]
                        [(TcMoveResourceBindings.Err message)
                          (TcMoveResourceBindings.Err message)])]
                    [(ResultTcType.Err message)
                      (TcMoveResourceBindings.Err message)])]
                [(TcMoveResult.Err message)
                  (TcMoveResourceBindings.Err message)])]
            [(TcMoveResult.Err message) (TcMoveResourceBindings.Err message)]))])))

(define (tc-move-check-cleanup-owner-exit
  [moved : TcMovedSet]
  [roots : TcMoveCleanupOwners]
  [scope : AstExpr]) : TcMoveResult
  (match roots
    [(TcMoveCleanupOwners.Nil) (TcMoveResult.Ok moved)]
    [(TcMoveCleanupOwners.Cons name-id owner-origin-id rest)
      (if (or
        (tc-moved-contains? moved name-id)
        (tc-moved-partial? moved name-id))
        (TcMoveResult.Err
          (tc-move-rich-cleanup-owner-exit-message
            (tc-moved-root-conflict moved name-id)
            (tc-hygiene-name-text-id name-id)
            owner-origin-id
            scope))
        (tc-move-check-cleanup-owner-exit moved (box-get rest) scope))]))

(define (tc-move-add-bound-names [locals : TcMovedSet] [names : TcNameIdList]) : TcMovedSet
  (match names
    [(TcNameIdList.Nil) locals]
    [(TcNameIdList.Cons name-id rest)
      (tc-move-add-bound-names (tc-moved-add locals name-id) (box-get rest))]))

(define (tc-move-remove-bound-root-states
  [moved : TcMovedSet]
  [names : TcNameIdList]) : TcMovedSet
  (match names
    [(TcNameIdList.Nil) moved]
    [(TcNameIdList.Cons name-id rest)
      (tc-move-remove-bound-root-states
        (tc-moved-remove-root-state moved name-id)
        (box-get rest))]))

(define (tc-move-pattern-bound-names
  [ctx : TcContext]
  [scrut-ty : AstType]
  [pattern : AstPattern]) : TcNameIdList
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-match-coverage-type ctx scrut-ty)))
    [(AstType.Enum _)
      (match pattern
        [(AstPattern.Variant _ patterns-box)
          (let
            [patterns : AstPatternList (box-get patterns-box)]
            (tc-pattern-list-add-bound-name-ids patterns TcNameIdList.Nil))]
        [_ TcNameIdList.Nil])]
    [(AstType.EnumArgs _ _)
      (match pattern
        [(AstPattern.Variant _ patterns-box)
          (let
            [patterns : AstPatternList (box-get patterns-box)]
            (tc-pattern-list-add-bound-name-ids patterns TcNameIdList.Nil))]
        [_ TcNameIdList.Nil])]
    [_ (tc-pattern-add-bound-name-ids pattern TcNameIdList.Nil)]))

;; Each arm is checked from the same post-scrutinee state; results are unioned so
;; a place moved on any arm is considered moved after the match.
(define (tc-move-check-arms
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : TcMoveResult
  (tc-move-check-arms-at ctx env locals loop-carried moved scrut-ty (& arms) 0))

(define (tc-move-check-arms-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [scrut-ty : AstType]
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : TcMoveResult
  (if (>= index (struct-get arms len))
    (TcMoveResult.Ok moved)
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (let
          [body : AstExpr (ast-node-get body-box)]
          [bound : TcNameIdList
            (tc-move-pattern-bound-names ctx scrut-ty pattern)]
          (match (tc-bind-match-pattern ctx env scrut-ty pattern)
            [(ResultTcEnv.Ok arm-env)
              (match (tc-move-check-expr
                ctx
                arm-env
                (tc-move-add-bound-names (tc-moved-clone locals) bound)
                (tc-move-remove-bound-root-states
                  (tc-moved-clone loop-carried)
                  bound)
                (tc-move-remove-bound-root-states (tc-moved-clone moved) bound)
                body)
                [(TcMoveResult.Ok arm-moved)
                  (let
                    [visible-arm-moved : TcMovedSet
                      (tc-moved-union
                        moved
                        (tc-move-remove-bound-root-states arm-moved bound))]
                    (match (tc-move-check-arms-at
                      ctx
                      env
                      (tc-moved-clone locals)
                      (tc-moved-clone loop-carried)
                      (tc-moved-clone moved)
                      scrut-ty
                      arms
                      (+ index 1))
                      [(TcMoveResult.Ok rest-moved)
                        (TcMoveResult.Ok
                          (tc-moved-union visible-arm-moved rest-moved))]
                      [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
                [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
            [(ResultTcEnv.Err message) (TcMoveResult.Err message)]))])))

(define (tc-move-check-expr-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr-id : i64]) : TcMoveResult
  (tc-move-check-expr ctx env locals loop-carried moved (ast-node-get expr-id)))

(define (tc-move-check-ptr-addr-of-place
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [place : AstExpr]
  [origin : AstExpr]) : TcMoveResult
  (match (ast-expr-unspan place)
    [(AstExpr.Var name)
      (let
        [name-text : String (tc-hygiene-name-text-id name)]
        (if (tc-moved-contains? moved name)
          (tc-move-rich-use-conflict-result
            (tc-moved-conflict moved name)
            name-text
            origin
            name-text)
          (TcMoveResult.Ok moved)))]
    [(AstExpr.StructGet receiver-box _)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (tc-move-check-ptr-addr-of-place
          ctx
          env
          locals
          loop-carried
          moved
          receiver
          origin))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-move-check-ptr-addr-of-place
          ctx
          env
          locals
          loop-carried
          moved
          array
          origin)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 index)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [_ (tc-move-check-expr ctx env locals loop-carried moved place)]))

(define (tc-move-check-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : AstExpr]) : TcMoveResult
  (match expr
    [(AstExpr.Spanned inner-box _)
      (tc-move-check-expr-id ctx env locals loop-carried moved inner-box)]
    [(AstExpr.Literal _) (TcMoveResult.Ok moved)]
    [(AstExpr.Var name)
      (let
        [name-text : String (tc-hygiene-name-text-id name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-expr-id env name)
            [(ResultTcExprId.Ok virtual-id)
