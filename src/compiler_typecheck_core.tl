  embedded-stdlib-tlci
  (import compiler_embedded_stdlib_tlci as embedded_tlci))
(cfg embedded-stdlib-tlci (import tlci_core as tlci))
(cfg embedded-stdlib-tlci (import tlci_loader as tlci_loader_support))
(cfg tlci-native-route-stress (import stdlib.env as stress_env))
(cfg
  tlci-bootstrap-mutation-witness
  (import stdlib.env as mutation_witness_env))
(import sym_i64_env)

(defmacro (tc-global-shared-view [place : Expr]) : Expr
  `(unsafe
    (ptr-read (ptr-addr-of ,place))))

(defmacro (tc-global-array-element-shared-view [items : Expr] [index : Expr]) : Expr
  `(unsafe
    (ptr-read (ptr-offset (__tl_array-data ,items) ,index))))

;; Capture the dynamic-array descriptor itself, rather than its data pointer.
;; This indirection is required while bootstrapping the owned-value ABI: taking
;; the address of a dynamic-array local directly can be lowered as the address
;; of its projected data field by the previous compiler generation.
(defmacro (tc-array-address [items : Expr]) : Expr
  `(let
    [shared-ref (& ,items)]
    (unsafe
      (ptr-read (ptr-cast (__tl_array-data (array shared-ref)) : (Ptr u64))))))

;; TcTypeEnv cache fields: ids map, values, unsafe flags, raw C fnptr flags,
;; default-shadow flags, scan-through, partial, rest head, below head. The flag
;; arrays parallel `values`:
;; the raw C fnptr flag records whether the head-most binding is a raw C
;; function pointer value, and bit 0 of the packed default-shadow sidecar is set
;; when the head-most binding sits above the first default-boundary marker
;; (replaces the former whole-env shadows map).
;; The default-shadow array is a packed ordinary-marker sidecar: bit 0 records
;; the default-boundary fact, while bits 1-3 record whether the head-most
;; ordinary binding is paired with a cleanup, ordinary-arena, or atomic-arena
;; owner marker.  This preserves the persistent env's snapshot semantics while
;; letting owner queries use the existing relevance index instead of mirroring
;; every bind into the scoped runtime.
;; `scan-through` is true for threshold-compaction caches created in the
;; middle of function-body spines: marker-position scans (active region,
;; return type, unsafe context, cleanup owners, lifetimes, lambda capture
;; checks) must keep scanning the spine below such a cache, because the
;; markers they look for can be buried more than a compaction window up
;; (with-arena escape checking was once silently disabled past 32 local
;; binds). Explicit top-env/module caches keep scan-through false so those
;; scans still terminate without walking the global env spine. Full explicit
;; caches are authoritative on miss; explicit layered caches are partial for
;; lookup fall-through but still stop marker scans. Partial local caches cover
;; only the compaction prefix; their `rest` keeps the full spine for marker
;; scans, while `below` skips the covered prefix for lookup miss fall-through.
;;
;; Immutable snapshots are a shared segmented arena plus an encoded stable
;; entry address. Bind heads are positive addresses, cache heads are negated
;; addresses, and -1 is empty. Branches append arena entries whose parent is
;; the retained head, so sibling snapshots remain stable without one boxed
;; self-tail allocation per binding/cache node.
(defstruct TcTypeEnvBinding
  (name-id i64)
  (ty ast.AstType)
  (parent i64))

;; The four chain fields lead the record so the structural top-env index can
;; read them with fixed word offsets (0..3) without materializing the whole
;; cache. `chain-depth` is -1 for every node that is not an indexed explicit
;; top-env layer (local compaction caches, and any explicit layer that failed
;; an encoding guard); such nodes keep the plain `below` walk.
(defstruct TcTypeEnvCache
  (chain-depth i64)
  (chain-seq i64)
  ;; Binary-lifting ancestor pointers: entry k is the layer 2^k steps down the
  ;; `below` chain, or 0 past the root.
  (chain-jumps-address u64)
  ;; Parallel to `values`: slot -> 2 + (packed ref of the previous layer that
  ;; bound the same key, -1 when this layer is the first). 0 means the slot is
  ;; still unregistered, which must stay distinct from "registered, no earlier
  ;; version" -- the two collided in an earlier draft and made a first version
  ;; point at itself.
  (chain-prev-address u64)
  (ids tc_i64_i64_map.Map)
  (values (__tl_dyn-array ast.AstType))
  ;; Only top-env signatures that still contain Var/VarArgs can change after
  ;; an additive splice. Explicit layers fuse that shrinking candidate-name
  ;; list into the tail of `unsafe-flags`: [flags x capacity, live count,
  ;; names x capacity, resolution stamp]. The existing `ids` map recovers each
  ;; value slot. This avoids a separate candidate-name array in the hot cache
  ;; record. The stamp is the tc-top-env-resolution-generation at which the
  ;; candidates were last re-resolved (0: never).
  (unsafe-flags (__tl_dyn-array i64))
  (shadow-flags (__tl_dyn-array i64))
  (scan-through bool)
  (partial bool)
  (rest i64)
  (below i64))

;; Type-name resolution reads nominal declarations, import aliases and module
;; rows, and lazy import stubs. Every change to one of them, and every new
;; expansion walk, advances this process-wide generation. A cache layer whose
;; candidates were re-resolved at the current generation would resolve them
;; to the same types again, so the splice re-resolution pass skips it.
(define tc-top-env-resolution-generation : i64
  0)

(define (tc-top-env-resolution-inputs-changed!) : unit
  (set! tc-top-env-resolution-generation (+ tc-top-env-resolution-generation 1)))

(defstruct TcTopEnvMembershipStateData
  ;; Bit 0 = membership active, bit 1 = alias fanout, bit 2 = explicit build.
  ;; It is first so hot bind paths can read it directly through the capability
  ;; without copying the larger table carrier.
  (mode i64)
  ;; The hot prefix of renderable names uses bounded epoch-stamped
  ;; dense lanes. Higher typed IDs use a sparse overflow map, so an ID's numeric
  ;; value never forces allocation up to that value. Structural and marker keys
  ;; take a distinct explicit path into the same map; the validated renderable
  ;; and raw structural key domains are disjoint.
  (renderable-slots (__tl_dyn-array i64))
  (renderable-bound-slots (__tl_dyn-array i64))
  (structural-flags tc_i64_i64_map.Map)
  (epoch i64)
  (intern-table-id i64)
  (intern-generation i64)
  (accelerator-enabled bool)
  (owner-arena i64))

(defstruct TcTopEnvMembershipState
  (address i64))

(defstruct TcThreadNameKindStateData
  ;; Values pack an ownership epoch above the two classification bits.
  (kinds tc_i64_i64_map.Map)
  (epoch i64)
  (intern-table-id i64)
  (intern-generation i64)
  (accelerator-enabled bool)
  (owner-arena i64))

(defstruct TcThreadNameKindState
  (address i64))

;; Inlay-hint collection belongs to one compiler job. The fixed record arrays
;; are allocated lazily in the arena captured when the state is created; the
;; copied rendered strings use a separate per-generation arena.
(defstruct TcInlayHintStateData
  (enabled bool)
  (count i64)
  (lines (__tl_dyn-array i64))
  (cols (__tl_dyn-array i64))
  (types (__tl_dyn-array String))
  (fixed-storage-arena i64)
  (string-arena i64))

(defstruct TcInlayHintState
  (address i64))

;; Macro expansion consumes user-written call nodes before the checked program
;; reaches tooling. Keep the resolved call-head facts in the owning compiler
;; job, then let semantic-index consumers copy them before the next file reset.
;; The grow-only scalar record slab stays in the job arena and is bounded by
;; the largest check seen by that job. Intern IDs keep strings out of this hot
;; state graph; semantic-index consumers copy their text before the next reset.
(defstruct TcMacroCallSiteStateData
  (enabled bool)
  (records (__tl_dyn-array i64))
  (capacity i64)
  (len i64)
  (seen-sites tc_i64_i64_map.Map)
  (fixed-storage-arena i64)
  ;; Intern IDs keep active and recorded metadata job-local without embedding
  ;; cleanup-owning Strings in the hot typecheck state graph.
  (active-path-id i64)
  (active-editable bool)
  (active-generator-id i64)
  (active-item-id i64)
  (active-key-id i64)
  ;; Stable source-facing macro display-name id -> defining source path.
  (definition-paths tc_i64_i64_map.Map))

(defstruct TcMacroCallSiteState
  (address i64))

;; Semantic indexing runs after body-local checker facts have been released.
;; Retain only the successful let binding's final type and the scalar inputs
;; needed to reproduce its lexical environment transition. The full identity
;; deliberately includes the flattened declaration and enclosing let body: AST
;; expression ids may be shared by generated/contextual nodes.
(defstruct TcCheckedLetBindingTransition
  (arena-owner-kind i64)
  ;; -1 means that the initializer did not produce an arena phase token.
  (phase-owner-id i64))

(defstruct TcCheckedLetBindingFact
  (declaration-ordinal i64)
  (body-id i64)
  (binding-ordinal i64)
  (name-id i64)
  (init-id i64)
  (binding-ty ast.AstType)
  (transition TcCheckedLetBindingTransition)
  ;; Previous fact with the same composite hash. Full identity is compared on
  ;; lookup, so hash collisions cannot alias bindings.
  (hash-next i64))

(defenum TcMaybeCheckedLetBindingFact
  (Hit ast.AstType TcCheckedLetBindingTransition)
  (Missing)
  (Inconsistent))

(defstruct TcCheckedLetBindingFactStateData
  (enabled bool)
  (current-declaration-ordinal i64)
  (facts (__tl_dyn-array TcCheckedLetBindingFact))
  (capacity i64)
  (len i64)
  (by-hash tc_i64_i64_map.Map)
  ;; Facts can contain aggregate AstType payloads. Keep the whole generation in
  ;; a separately resettable arena rather than leaking boxes into the job arena.
  (payload-arena i64)
  (return-arena i64)
  (owner-arena i64)
  (inconsistent bool))

(defstruct TcCheckedLetBindingFactState
  (address i64))

(defstruct TcScratchArenaStateData
  ;; Reusable arenas are isolated per typecheck job. Each entry records the
  ;; caller arena it must restore if teardown is requested while scratch is
  ;; active; this avoids consulting an unrelated active pool or global owner.
  (fn-arena i64)
  (fn-return-arena i64)
  (decl-arena i64)
  (decl-return-arena i64)
  (decl-depth i64))

(defstruct TcScratchArenaState
  (address i64))

;; Typed unused-unsafe collection runs a nested typecheck from the lint driver.
;; Keep both its traversal selectors and retained block records in that
;; typecheck job: another compiler job may reset or destroy its own state while
;; this collection is active.
(defstruct TcUnusedUnsafeStateData
  (enabled bool)
  (current-block i64)
  (current-path String)
  (target-path String)
  (block-len i64)
  (block-spans (__tl_dyn-array ast.AstSourceSpan))
  (block-paths (__tl_dyn-array String))
  (block-used (__tl_dyn-array bool))
  (fixed-storage-arena i64))

(defstruct TcUnusedUnsafeState
  (address i64))

;; SPMD helper recursion detection is a mutable traversal stack. Keep only a
;; small capability in the compiler job header; the typed stack cell and any
;; persistent dense spine it grows live in that job's lifetime arena.
(defstruct TcSpmdTraversalState
  (address i64))

;; The immutable type-node resolution predicate is memoized per compiler job.
;; Numeric type ids are meaningful only within one type-pool segment table, so
;; the owner identity travels with the cache instead of following whichever
;; compatibility pool is currently installed in the process.
(defstruct TcTypeResolutionCacheStateData
  (owner-arena i64)
  (slots (__tl_dyn-array i64))
  (epoch i64)
  (type-pool-owner-id i64)
  (type-segment-bases i64))

(defstruct TcTypeResolutionCacheState
  (address i64))

;; Aggregate scalar layout accelerators are retained for the lifetime of one
;; compiler job. Their fixed arrays stay lazy because ordinary tooling requests
;; may never lower an aggregate; the identity fields reject equal numeric name
;; IDs from another intern owner or reset generation.
(defstruct TcAggScalarCacheStateData
  (owner-arena i64)
  (size-cache (__tl_dyn-array i64))
  (size-intern-table-id i64)
  (size-intern-generation i64)
  (align-cache (__tl_dyn-array i64))
  (align-intern-table-id i64)
  (align-intern-generation i64)
  (regwords-cache (__tl_dyn-array i64))
  (regwords-intern-table-id i64)
  (regwords-intern-generation i64))

(defstruct TcAggScalarCacheState
  (address i64))

;; Direct nominal type handles are memoized per compiler job. Both positive and
;; negative entries belong to one append-only CompilerSymbols type-map stamp;
;; a rebuilt table or an in-place addition rebinds the whole direct-map view.
(defstruct TcTypeHandleCacheStateData
  (owner-arena i64)
  ;; Raw pointers into fixed arena-owned lanes keep the multi-million-call hit
  ;; path to scalar loads. The arena retains all three allocations for the job.
  (keys-address i64)
  (handles-address i64)
  ;; Top-level move kind of the slot's declaration: 0 unknown, 1 Copyable,
  ;; 2 MoveOnly. Every store of a key into a slot resets its kind, so a kind is
  ;; only ever read beside the key and stamp it was classified under.
  (move-kinds-address i64)
  (symbols-owner i64)
  (symbols-generation i64))

(defstruct TcTypeHandleCacheState
  (address i64))

;; Nominal owner names and the one-entry type-name lookup memo can retain
;; scratch-owned strings and negative answers. Keep their compact storage in
;; one compiler job so another job's declaration or scratch reset cannot clear
;; or expose those entries.
(defstruct TcNominalCacheStateData
  (owner-handles (__tl_dyn-array i64))
  (owner-names (__tl_dyn-array String))
  (type-name-valid bool)
  (type-name-found bool)
  (type-name-key i64)
  (type-name-handle i64)
  (type-handles TcTypeHandleCacheState))

(defstruct TcNominalCacheState
  (address i64))

;; Cloneability and clone-root collection share the whole-program declaration
;; view and reset boundary. The able-set lives in the stable AST-pool arena;
;; the selected declaration map and resolved root closure use a separately
;; destroyable arena owned only by this job.
(defstruct TcCloneStateData
  (able-ready bool)
  (able-cache clone_support.CloneNameSet)
  (root-active bool)
  (root-current-decl bool)
  (root-selected tc_i64_i64_map.Map)
  (root-roots clone_support.CloneRootEntries)
  (root-arena i64))

(defstruct TcCloneState
  (address i64))

(defstruct TcMacroCallSiteActiveDecl
  (path-id i64)
  (editable bool)
  (generator-id i64)
  (item-id i64)
  (key-id i64))

(defstruct TcTypeEnvStore
  (bindings (__tl_dyn-array TcTypeEnvBinding))
  (binding-capacity i64)
  (binding-len i64)
  (caches (__tl_dyn-array TcTypeEnvCache))
  (cache-capacity i64)
  (cache-len i64)
  (owner-arena i64)
  ;; Zero for ordinary compatibility environments. The whole-program top env
  ;; attaches its owning job's membership capability here so generic bind and
  ;; lookup helpers need no process-global active-state selector.
  (topenv-membership-state-address i64)
  ;; Address of this store's TcChainIndex cell, or 0 before the first explicit
  ;; top-env layer is built. Word offset 8; the eight fields above are one word
  ;; each, which the raw accessors below rely on.
  (chain-state i64)
  ;; Explicit source-name/structural-intern session owned by this environment.
  ;; Arena-phase marker handles resolve only through this capability; snapshots
  ;; share the store, so the hot three-word TcTypeEnv ABI stays unchanged.
  (structural-session-address i64)
  ;; Job-owned memo used while explicit cache layers collect signatures that
  ;; still contain unresolved type variables.
  (type-resolution-cache-state-address i64))

;; Structural index over one store's explicit top-env layer forest. `map` sends
;; a binding key to the packed reference of the newest layer that binds it;
;; each layer's `chain-prev` slot threads the older versions in strictly
;; decreasing `seq`. Values are never copied here: a reference is (layer node
;; address, slot), so every payload read goes to the layer's own live arrays.
(defstruct TcChainIndex
  (map tc_i64_i64_map.Map)
  (next-seq i64)
  (owner-arena i64))

(defstruct TcTypeEnv
  (store i64)
  (head i64)
  ;; Keep snapshot arguments in the aggregate-by-reference ABI class. Passing
  ;; the two live words in separate registers made high-frequency wrappers
  ;; spill and rebuild both words on every call. Cache the scoped-state
  ;; capability in that third word so hot active-runtime tests remain direct.
  (abi-pad i64))

(defstruct TcCheckedLetBindingApplied
  (env TcTypeEnv)
  (transition TcCheckedLetBindingTransition))

(defenum TcTypeEnvView
  (Nil)
  (Bind i64 ast.AstType TcTypeEnv)
  (Cache (Ptr TcTypeEnvCache) bool bool TcTypeEnv TcTypeEnv))

(defenum TcTypeEnvSpineStep
  (Done)
  (Cache TcTypeEnv)
  (Bind i64 ast.AstType TcTypeEnv))

(defenum TcTypeEnvMarkerStep
  (Done)
  (Cache TcTypeEnv)
  (Bind i64 ast.AstType TcTypeEnv))

(defenum TcTypeEnvScopedMarkerKind
  (None)
  (UnsafeDecl)
  (DefaultBoundary)
  (Region)
  (UnsafeContext)
  (CleanupOwner)
  (OrdinaryArenaOwner)
  (AtomicArenaOwner)
  (Other))

;; Small capability for mutable scoped-environment state owned by one compiler
;; job. The typed cell is allocated lazily because its dense lookup lanes are
;; only useful once that job starts typechecking a function body.
(defstruct TcTypeEnvScopedState
  (address i64))

(defstruct TcTypeEnvScopedSlot
  (name-id i64)
  (ty ast.AstType)
  (flags i64)
  (marker-kind-tag i64)
  (scope-depth i64)
  (generation i64))

(defstruct TcTypeEnvScopedMark
  (slot-count i64)
  (mark-count i64)
  (scope-depth i64)
  (cache-generation i64))

(defstruct TcTypeEnvScopedStack
  (state-address i64)
  (slots (__tl_dyn-array TcTypeEnvScopedSlot))
  (slot-count i64)
  ;; Latest slot per out-of-range name. Dense intern ids use the shared
  ;; epoch-keyed arrays below; this map preserves the unbounded fallback.
  (lookup-cache (Box tc_i64_i64_map.Map))
  (lookup-epoch i64)
  (marks (__tl_dyn-array TcTypeEnvScopedMark))
  (mark-count i64)
  (scope-depth i64)
  (cache-generation i64))

(defstruct TcTypeEnvScopedMarkerCursor
  (stack TcTypeEnvScopedStack)
  (index i64))

(defstruct TcTypeEnvScopedSidecar
  ;; Immutable module/top-level snapshot. Only slots at materialize-start and
  ;; above are newer than this tail; earlier slots mirror it for marker scans.
  (persistent TcTypeEnv)
  (stack TcTypeEnvScopedStack)
  (materialize-start i64))

(defstruct TcTypeEnvScopedSidecarMark
  (persistent TcTypeEnv)
  (stack-mark TcTypeEnvScopedMark)
  (materialize-start i64))

(defstruct TcTypeEnvScopedCarrier
  ;; `env` is the last immutable snapshot. A dirty carrier owns newer bindings
  ;; in sidecar.stack and materializes them only at a legacy TcTypeEnv boundary.
  (env TcTypeEnv)
  (sidecar TcTypeEnvScopedSidecar)
  (dirty bool))

(defstruct TcTypeEnvScopedCarrierMark
  (env TcTypeEnv)
  (sidecar-mark TcTypeEnvScopedSidecarMark)
  (dirty bool))

(defenum TcTypeEnvScopedRuntimeSave
  (Inactive TcTypeEnvScopedState)
  (Scope TcTypeEnvScopedState TcTypeEnvScopedCarrierMark)
  (Replaced TcTypeEnvScopedState TcTypeEnvScopedCarrier))

(defstruct TcTypeEnvScopedVisibleCache
  (valid bool)
  (len i64)
  (generation i64)
  (session-owner i64)
  (session-generation i64)
  (lifetime-id i64)
  (result bool))

(defstruct TcTypeEnvScopedOutlivesBindingCache
  (valid bool)
  (len i64)
  (generation i64)
  (session-owner i64)
  (session-generation i64)
  (lifetime-id i64)
  (target-id i64)
  (result bool))

(defstruct TcTypeEnvScopedOutlivesLifetimeCache
  (valid bool)
  (len i64)
  (generation i64)
  (session-owner i64)
  (session-generation i64)
  (value-id i64)
  (target-id i64)
  (result bool))

(defstruct TcTypeEnvScopedStateData
  (owner-arena i64)
  (runtime-active bool)
  ;; The carrier is kept in a separate fixed cell so hot runtime mutations do
  ;; not copy the dense-lane and lifetime-memo descriptors beside it.
  (runtime-carrier-address i64)
  (dense-lookup-indices (__tl_dyn-array i64))
  (dense-lookup-epochs (__tl_dyn-array i64))
  (next-lookup-epoch i64)
  (visible-cache-address i64)
  (outlives-binding-cache-address i64)
  (outlives-lifetime-cache-address i64)
  ;; Depth of speculative typechecks whose error the caller discards. While it
  ;; is positive an unbound name gets no near-miss scan: the suggestion would be
  ;; thrown away with the error (see `tc-unbound-suggestions-suppress-push!`).
  (unbound-suggestion-suppress-depth i64)
  (semantic-observer TcSemanticObserver))

(defenum TcTypeEnvScopedLookup
  (Missing)
  (Found ast.AstType bool TcTypeEnvScopedMarkerKind i64 i64))

(defenum TcTypeEnvScopedMarkerStep
  (Done)
  (Bind i64 ast.AstType TcTypeEnvScopedMarkerCursor))

;; Mutable source-lookup caches belong to one compiler job. Keep the carrier in
;; the typecheck layer so driver jobs can own it without teaching the loader
;; about typecheck internals.
(defstruct TcSourceKeyCacheState
  (dotted-alias-module-keys (__tl_dyn-array i64))
  (dotted-alias-name-keys (__tl_dyn-array i64))
  (dotted-alias-values (__tl_dyn-array i64))
  (dotted-full-path-module-keys (__tl_dyn-array i64))
  (dotted-full-path-name-keys (__tl_dyn-array i64))
  (dotted-full-path-values (__tl_dyn-array i64))
  (qualified-variant-module-keys (__tl_dyn-array i64))
  (qualified-variant-name-keys (__tl_dyn-array i64))
  (qualified-variant-values (__tl_dyn-array i64))
  (qualified-variant-handles (__tl_dyn-array i64))
  ;; alias table-id, generation, ready;
  ;; full-path table-id, generation, ready;
  ;; qualified table-id, generation, registry-id, ready.
  (control (__tl_dyn-array i64)))

;; Explicit capability for all mutable macro-expansion and CTFE handoff state.
;; The address is a stable pointer to the owning job's fixed-width substate
;; directory; typed substates below are allocated lazily in that job's lifetime
;; arena. Keeping the capability
;; separate from TcContext lets prescan/setup code use it before a context has
;; been built, while contexts still recover the same owner through job-state.
(defstruct TcMacroState
  (address i64))

(defstruct TcJobStateData
  ;; Arena and lazy typed-substate cells owned by this compiler job.  Zero is a
  ;; valid "unused" state: an idle job allocates no macro tables or arenas.
  (owner-arena i64)
  ;; Fixed-width lazy address directory. Keeping this out of the job header
  ;; avoids inflating every pass-by-value job-data read as macro subsystems grow.
  (macro-state-addresses (__tl_dyn-array i64))
  (source-key-cache TcSourceKeyCacheState)
  (topenv-membership TcTopEnvMembershipState)
  (thread-name-kind TcThreadNameKindState)
  (inlay-hints TcInlayHintState)
  (macro-call-sites TcMacroCallSiteState)
  (checked-let-binding-facts TcCheckedLetBindingFactState)
  (scratch-arenas TcScratchArenaState)
  (unused-unsafe TcUnusedUnsafeState)
  (spmd-traversal TcSpmdTraversalState)
  (type-resolution-cache TcTypeResolutionCacheState)
  (agg-scalar-caches TcAggScalarCacheState)
  ;; Lazily allocated scoped-environment lookup/runtime state. Keeping only the
  ;; address and its independently reclaimable arena here leaves idle
  ;; parse/macro-only jobs free of the dense lanes and lets result boundaries
  ;; return their multi-megabyte storage before the next batch entry.
  (type-env-scoped-state-address i64)
  (type-env-scoped-state-arena i64)
  ;; Lazily allocated typed complete-layout state. Its slot table belongs to
  ;; this job's lifetime arena; retained nested layout arrays use the state's
  ;; separately resettable payload arena.
  (agg-layout-cache-address i64)
  ;; Lazily points into the expansion scratch arena while one macro walk owns
  ;; a segmented declaration/path view. Zero outside that structural scope, so
  ;; idle compiler jobs retain no segment table or maximum-capacity storage.
  (macro-program-view-address i64)
  ;; 1 while the program declares an `(:opaque)` aggregate (#6999), else 0.
  (opaque-program i64)
  ;; One job-owned non-fatal channel is shared with lowering and codegen by
  ;; the compiler driver. Its payload arena remains lazy for ordinary jobs.
  (advisory-sink cdiag.CompilerAdvisorySink)
  (semantic-observer TcSemanticObserver))

(defstruct TcJobState
  ;; Small immutable capability; the pointed-to cell and its tables are
  ;; allocated in the owning driver's lifetime arena.
  (address i64))

(define tc-inlay-hint-capacity : i64
  65536)
(define tc-topenv-renderable-table-capacity : i64
  32768)

;; One dense latest-slot table is shared by the scoped stacks of a single job.
(define tc-type-env-scoped-dense-lookup-capacity : i64
  262144)

(define (tc-topenv-membership-state-new) : TcTopEnvMembershipState
  (let
    [cell : (__tl_dyn-array TcTopEnvMembershipStateData)
      (__tl_make-array TcTopEnvMembershipStateData 1)]
    (set!
      (array-ref cell 0)
      (TcTopEnvMembershipStateData
        0
        (__tl_make-array i64 tc-topenv-renderable-table-capacity)
        (__tl_make-array i64 tc-topenv-renderable-table-capacity)
        (tc_i64_i64_map.with-capacity 64)
        1
        -1
        -1
        true
        (arena.tl_arena_current)))
    (TcTopEnvMembershipState
      (cast
        (unsafe
          (ptr->int
            (ptr-cast
              (__tl_array-data cell)
              : (Ptr TcTopEnvMembershipStateData))))
        : i64))))

