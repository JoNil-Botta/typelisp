(define (tc-stdlib-comptime-surface-ok-impl [ctx : TcContext]) : ResultTcUnit
  (if (not (tc-stdlib-comptime-present? ctx))
    Ok
    (let
      [result : ResultTcUnit (tc-stdlib-check-comptime-declaration-surface ctx)]
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-enum
            ctx
            "Expr"
            cbi.compiler-builtin-id-fix-Expr
            (tc-stdlib-expr-specs ctx))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "ExprList"
            cbi.compiler-builtin-id-fix-ExprList
            (tc-stdlib-sequence-fields ctx cbi.compiler-builtin-id-fix-Expr))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "ExprClause"
            cbi.compiler-builtin-id-fix-ExprClause
            (tc-stdlib-expr-clause-fields))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "ExprClauseList"
            cbi.compiler-builtin-id-fix-ExprClauseList
            (tc-stdlib-sequence-fields
              ctx
              cbi.compiler-builtin-id-fix-ExprClause))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "ExprBindingClause"
            cbi.compiler-builtin-id-fix-ExprBindingClause
            (tc-stdlib-expr-binding-clause-fields))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "ExprBindingClauseList"
            cbi.compiler-builtin-id-fix-ExprBindingClauseList
            (tc-stdlib-sequence-fields
              ctx
              cbi.compiler-builtin-id-fix-ExprBindingClause))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-enum
            ctx
            "Pattern"
            cbi.compiler-builtin-id-fix-Pattern
            (tc-stdlib-pattern-specs ctx))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "PatternList"
            cbi.compiler-builtin-id-fix-PatternList
            (tc-stdlib-sequence-fields ctx cbi.compiler-builtin-id-fix-Pattern))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "MatchArm"
            cbi.compiler-builtin-id-fix-MatchArm
            (tc-stdlib-match-arm-fields))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "MatchArmList"
            cbi.compiler-builtin-id-fix-MatchArmList
            (tc-stdlib-sequence-fields ctx cbi.compiler-builtin-id-fix-MatchArm))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "TypeInfoList"
            cbi.compiler-builtin-id-fix-TypeInfoList
            (tc-stdlib-sequence-fields ctx cbi.compiler-builtin-id-fix-TypeInfo))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "TypeField"
            cbi.compiler-builtin-id-fix-TypeField
            (tc-stdlib-type-field-fields))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "TypeFieldList"
            cbi.compiler-builtin-id-fix-TypeFieldList
            (tc-stdlib-sequence-fields
              ctx
              cbi.compiler-builtin-id-fix-TypeField))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "TypeVariantPayload"
            cbi.compiler-builtin-id-fix-TypeVariantPayload
            (tc-stdlib-type-variant-payload-fields))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "TypeVariantPayloadList"
            cbi.compiler-builtin-id-fix-TypeVariantPayloadList
            (tc-stdlib-sequence-fields
              ctx
              cbi.compiler-builtin-id-fix-TypeVariantPayload))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "TypeVariant"
            cbi.compiler-builtin-id-fix-TypeVariant
            (tc-stdlib-type-variant-fields))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "TypeVariantList"
            cbi.compiler-builtin-id-fix-TypeVariantList
            (tc-stdlib-sequence-fields
              ctx
              cbi.compiler-builtin-id-fix-TypeVariant))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "TypeParam"
            cbi.compiler-builtin-id-fix-TypeParam
            (tc-stdlib-type-param-fields))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-struct
            ctx
            "TypeParamList"
            cbi.compiler-builtin-id-fix-TypeParamList
            (tc-stdlib-sequence-fields
              ctx
              cbi.compiler-builtin-id-fix-TypeParam))))
      (set!
        result
        (tc-stdlib-comptime-surface-step
          result
          (tc-stdlib-check-enum
            ctx
            "TypeInfo"
            cbi.compiler-builtin-id-fix-TypeInfo
            (tc-stdlib-type-info-specs ctx))))
      result)))

(define (tc-stdlib-comptime-surface-ok [ctx : TcContext]) : ResultTcUnit
  (let
    [prev : ast.AstNodePoolContext (ast.ast-node-pool-context-capture-active)]
    [_install : unit (tc-context-install-pools! ctx)]
    ;; The well-known spec builder pushes fresh type nodes (e.g. the
    ;; `(Box Expr)` payload of Expr.Splice) into this context's type-node pool.
    ;; In a long-lived `test --check --batch` process the captured pool snapshot
    ;; inherits a dedup index whose entries can point at slot ids that a later
    ;; batch entry's nodes now occupy, so a deduped spec push would resolve to a
    ;; slot holding an unrelated node and the well-known compare spuriously
    ;; mismatches. Drop the dedup index here (no live nodes are truncated) so
    ;; spec pushes rebuild it against the current entry's nodes only.
    [_dedup : unit
      (ast.ast-node-pool-context-type-dedup-clear! (tc-context-pools ctx))]
    [result : ResultTcUnit (tc-stdlib-comptime-surface-ok-impl ctx)]
    (tc-install-pools! prev)
    result))

(define (tc-stdlib-comptime-macro-surface-ok-reset! [state : TcMacroState]) : unit
  (unsafe
    (set! (deref (tc-macro-helper-state-ptr state)).stdlib-surface-ready false)))

(define (tc-stdlib-comptime-surface-ok-for-macro [ctx : TcContext]) : ResultTcUnit
  (let
    [state : TcMacroState (tc-context-macro-state ctx)]
    [cache : (MutPtr TcMacroHelperStateData) (tc-macro-helper-state-ptr state)]
    (unsafe
      (if (deref cache).stdlib-surface-ready
        Ok
        (let
          [_ (try (tc-stdlib-comptime-surface-ok ctx))]
          (if (tc-stdlib-comptime-present? ctx)
            (set! (deref cache).stdlib-surface-ready true)
            unit)
          Ok)))))

(define (tc-bind-comptime-helper-aliases
  [env : TcTypeEnv]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnv
  ;; Qualified `stdlib.comptime` helper calls are normalized to the legacy
  ;; helper key in name lookup. Keep one compatibility binding instead of
  ;; growing every macro helper environment with duplicate qualified aliases.
  (if (tc-source-name-bound-exact-id? env name-id)
    env
    (tc-bind-id env name-id ty)))

;; The legacy unqualified macro helper signatures. New stdlib macro code
;; imports `stdlib.comptime` and calls the public helpers via that module; keep
;; only the old names still covered by compatibility tests and by the legacy
;; type-query surface.
;;
;; Row k binds builtin slot k of `tc-macro-helper-slots` to the k-th
;; `|`-terminated code of `tc-macro-helper-signatures`: a binder (`i` binds the
;; id, `a` also its comptime helper aliases), then one type per parameter and
;; the result type, each one character of `tc-macro-helper-type-codes`. A table
;; instead of one binding call per row keeps this cold, cached setup small.
(define tc-macro-helper-slots : (Array i64 134)
  (array
    (cbi.compiler-builtin-ctfe-slot "string-append")
    (cbi.compiler-builtin-ctfe-slot "string-append")
