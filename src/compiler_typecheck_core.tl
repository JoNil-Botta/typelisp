(define (tc-source-qualified-variant-key-cache-put!
  [registry-id : i64]
  [module-id : i64]
  [name-id : i64]
  [value : i64]
  [handle : i64]) : unit
  (tc-source-qualified-variant-key-cache-put-for-state!
    (tc-job-state-source-key-cache (tc-serial-job-state))
