  (Ok TcInlineAggregateLayout)
  (Err String))

(defenum TcAggLayoutCacheSlot
  (Empty)
  (Full i64 TcInlineAggregateLayout))

;; Transitional owner for the remaining process-global type-resolution and
;; complete aggregate-layout tables. Both tables are mutable and still require
;; explicit job ownership; they are not immutable exceptions. Keeping their
;; arenas beside the dependent views makes that later move a whole-state swap
;; instead of a protocol over unrelated globals. Refs #6257 and #4960.
(defstruct TcLazyGlobalTableState
  (owner arena.Arena)
  ;; Complete aggregate layouts contain retained field/payload/variant arrays.
  ;; Keep their owner in the same state as the slots that publish those views.
  (agg-layout-storage-owner arena.Arena)
  (type-needs-resolution-slots (__tl_dyn-array i64))
  (agg-layout-cache (__tl_dyn-array TcAggLayoutCacheSlot)))

(define tc-lazy-global-table-state : TcLazyGlobalTableState
  (TcLazyGlobalTableState
    (arena.Arena 0)
    (arena.Arena 0)
    (array.make-array i64 0)
    (array.make-array TcAggLayoutCacheSlot 0)))

(define (tc-agg-layout-cache-storage-arena-handle-value) : i64
  (arena.raw-handle
    (__tl-project-field tc-lazy-global-table-state agg-layout-storage-owner)))

(define (tc-agg-layout-cache-storage-handle) : arena.Arena
  (let
    [storage : arena.Arena
      (__tl-project-field tc-lazy-global-table-state agg-layout-storage-owner)]
    (if (= (arena.raw-handle storage) 0)
      ;; Selfhost retains less than 1 MiB here. A small root leaves ample
      ;; headroom and still grows through the ordinary arena overflow path.
      (let
        [fresh : arena.Arena (arena.Arena (arena.tl_arena_make_small))]
        (begin
          (__tl-project-set-field
            tc-lazy-global-table-state
            agg-layout-storage-owner
            fresh)
          fresh))
      storage)))

(define (tc-agg-layout-cache-storage-reset!) : unit
  (let
    [storage : arena.Arena
      (__tl-project-field tc-lazy-global-table-state agg-layout-storage-owner)]
    [index : i64 0]
    (begin
      ;; Unpublish every dependent view before destroying its owner. The slot
      ;; backing array belongs to the outer persistent-table owner and is safe
      ;; to reuse; none of its entries may retain the retired payload brand.
      (while (<
        index
        (array-length
          (__tl-project-field tc-lazy-global-table-state agg-layout-cache)))
        (begin
          (set!
            (array-ref
              (__tl-project-field tc-lazy-global-table-state agg-layout-cache)
              index)
            (TcAggLayoutCacheSlot.Empty))
          (set! index (+ index 1))))
      (__tl-project-set-field
        tc-lazy-global-table-state
        agg-layout-storage-owner
        (arena.Arena 0))
      (if (= (arena.raw-handle storage) 0)
        unit
        (unsafe
          (arena.destroy storage))))))

(define (tc-agg-layout-cache-slot-empty? [index : i64]) : bool
  (if (or
    (< index 0)
    (>=
      index
      (array-length
        (__tl-project-field tc-lazy-global-table-state agg-layout-cache))))
    false
    (match (tc-global-array-element-shared-view
      (__tl-project-field tc-lazy-global-table-state agg-layout-cache)
      index)
      [(TcAggLayoutCacheSlot.Empty) true]
      [(TcAggLayoutCacheSlot.Full _ _) false])))

;; Builders know the final cardinality from their AST vectors. Allocate one
;; right-sized backing array in the retained cache arena, fill it in source
;; order, and carry only the shallow array descriptor through cached layouts.
(define (tc-repr-c-field-layout-list-with-count [count : i64]) : TcReprCFieldLayoutList
  (TcReprCFieldLayoutList (array.make-array TcReprCFieldLayout count)))

(define (tc-repr-c-field-layout-list-count [items : TcReprCFieldLayoutList]) : i64
  (array-length items.slots))

(define (tc-repr-c-field-layout-list-ref
  [items : TcReprCFieldLayoutList]
  [index : i64]) : TcReprCFieldLayout
  (array-ref items.slots index))

(define (tc-repr-c-field-layout-list-set!
  [items : TcReprCFieldLayoutList]
  [index : i64]
  [value : TcReprCFieldLayout]) : unit
  (set! (array-ref items.slots index) value))

(define (tc-inline-field-layout-list-with-count [count : i64]) : TcInlineFieldLayoutList
  (in-arena
    (tc-agg-layout-cache-storage-handle)
    (TcInlineFieldLayoutList (array.make-array TcInlineFieldLayout count))))

(define (tc-inline-field-layout-list-count [items : TcInlineFieldLayoutList]) : i64
  (array-length items.slots))

(define (tc-inline-field-layout-list-ref
  [items : TcInlineFieldLayoutList]
  [index : i64]) : TcInlineFieldLayout
  (array-ref items.slots index))

(define (tc-inline-field-layout-list-set!
  [items : TcInlineFieldLayoutList]
  [index : i64]
  [value : TcInlineFieldLayout]) : unit
  (set! (array-ref items.slots index) value))

(define (tc-inline-payload-layout-list-with-count [count : i64]) : TcInlinePayloadLayoutList
  (in-arena
    (tc-agg-layout-cache-storage-handle)
    (TcInlinePayloadLayoutList (array.make-array TcInlinePayloadLayout count))))

(define (tc-inline-payload-layout-list-count
  [items : TcInlinePayloadLayoutList]) : i64
  (array-length items.slots))

(define (tc-inline-payload-layout-list-ref
  [items : TcInlinePayloadLayoutList]
  [index : i64]) : TcInlinePayloadLayout
  (array-ref items.slots index))

(define (tc-inline-payload-layout-list-set!
  [items : TcInlinePayloadLayoutList]
  [index : i64]
  [value : TcInlinePayloadLayout]) : unit
  (set! (array-ref items.slots index) value))

(define (tc-inline-variant-layout-list-with-count [count : i64]) : TcInlineVariantLayoutList
  (in-arena
    (tc-agg-layout-cache-storage-handle)
    (TcInlineVariantLayoutList (array.make-array TcInlineVariantLayout count))))

(define (tc-inline-variant-layout-list-count
  [items : TcInlineVariantLayoutList]) : i64
  (array-length items.slots))

(define (tc-inline-variant-layout-list-ref
  [items : TcInlineVariantLayoutList]
  [index : i64]) : TcInlineVariantLayout
  (array-ref items.slots index))

(define (tc-inline-variant-layout-list-set!
  [items : TcInlineVariantLayoutList]
  [index : i64]
  [value : TcInlineVariantLayout]) : unit
  (set! (array-ref items.slots index) value))

(defenum CompilerTypecheckSummary
  (CompilerTypecheckSummary i64 i64 i64))

(defenum ResultCompilerTypecheck
  (Ok CompilerTypecheckSummary)
  (Err (Box cdiag.CompilerDiagnosticList)))

(defenum ResultCompilerTypecheckChecked
  (Ok CompilerTypecheckSummary TcContext TcTypeEnv ast.AstDeclPathList)
  ;; The checked program, symbol identities, and every successfully established
  ;; body fact remain available even when declaration recovery reports type
  ;; diagnostics. Semantic tooling consumes this transient view immediately and
  ;; copies any useful records into its own arena.
  (Partial
    (Box cdiag.CompilerDiagnosticList)
    TcContext
    TcTypeEnv
    ast.AstDeclPathList)
  (Err (Box cdiag.CompilerDiagnosticList)))

(defenum TcPrefixSnapshotLookup
  (Miss)
  (Hit i64 String i64 CompilerTypecheckSummary))

(defenum TcPrefixSnapshotSlot
  (Empty)
  (Full String i64 String i64 CompilerTypecheckSummary))

(defenum TcPrefixCandidate
  (No)
  (Some String i64 String i64))

(define tc-prefix-snapshot-cache-capacity : i64
  64)

;; Prefix summaries are retained independently from the AST and intern pools,
;; but their keys and module identities describe one load/typecheck job. Keep
;; that ownership explicit so a reset or teardown of driver A can neither
;; invalidate driver B's arena nor make B observe A's counters.
(defstruct TcPrefixSnapshotCacheProvenance
  (pool-arena i64)
  (ast-floor i64)
  (type-floor i64)
  (intern-table-id i64)
  (intern-generation i64)
  (intern-floor i64))

(defstruct TcPrefixSnapshotCacheState
  (slots (__tl_dyn-array TcPrefixSnapshotSlot))
  (arena (__tl_dyn-array i64))
  (enabled (__tl_dyn-array bool))
  (ready (__tl_dyn-array bool))
  (hit-count (__tl_dyn-array i64))
  (miss-count (__tl_dyn-array i64))
  (store-count (__tl_dyn-array i64))
  (provenance (__tl_dyn-array TcPrefixSnapshotCacheProvenance))
  (provenance-ready (__tl_dyn-array bool)))

(define (tc-prefix-snapshot-cache-provenance-empty) : TcPrefixSnapshotCacheProvenance
  (TcPrefixSnapshotCacheProvenance 0 0 0 0 0 0))

(define (tc-prefix-snapshot-cache-state-new) : TcPrefixSnapshotCacheState
  (let
    [arena-cell : (__tl_dyn-array i64) (array.make-array i64 1)]
    [enabled-cell : (__tl_dyn-array bool) (array.make-array bool 1)]
    [ready-cell : (__tl_dyn-array bool) (array.make-array bool 1)]
    [hit-cell : (__tl_dyn-array i64) (array.make-array i64 1)]
    [miss-cell : (__tl_dyn-array i64) (array.make-array i64 1)]
    [store-cell : (__tl_dyn-array i64) (array.make-array i64 1)]
    [provenance-cell : (__tl_dyn-array TcPrefixSnapshotCacheProvenance)
      (array.make-array TcPrefixSnapshotCacheProvenance 1)]
    [provenance-ready-cell : (__tl_dyn-array bool) (array.make-array bool 1)]
    (begin
      (set! (array-ref arena-cell 0) 0)
      (set! (array-ref enabled-cell 0) false)
      (set! (array-ref ready-cell 0) false)
      (set! (array-ref hit-cell 0) 0)
      (set! (array-ref miss-cell 0) 0)
      (set! (array-ref store-cell 0) 0)
      (set!
        (array-ref provenance-cell 0)
        (tc-prefix-snapshot-cache-provenance-empty))
      (set! (array-ref provenance-ready-cell 0) false)
      (TcPrefixSnapshotCacheState
        (array.make-array TcPrefixSnapshotSlot 64)
        arena-cell
        enabled-cell
        ready-cell
        hit-cell
        miss-cell
        store-cell
        provenance-cell
        provenance-ready-cell))))

;; Standalone source APIs and direct tests are intentionally serial. Production
;; driver jobs pass the state owned by `CompilerDriverState` instead.
(define tc-prefix-snapshot-serial-test-cache-state : TcPrefixSnapshotCacheState
  (tc-prefix-snapshot-cache-state-new))

(define (tc-prefix-snapshot-serial-test-cache-state-shared-view) : TcPrefixSnapshotCacheState
  (tc-global-shared-view tc-prefix-snapshot-serial-test-cache-state))

(define (tc-prefix-snapshot-cache-provenance-from-job
  [load-state : cload.CompilerLoadSessionState]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]) : TcPrefixSnapshotCacheProvenance
  (let
    [session : ci.InternSourceNameSession
      (ci.intern-source-name-session-handle-session source-names)]
    (TcPrefixSnapshotCacheProvenance
      (ast.ast-node-pool-context-base-arena pools)
      (cload.compiler-load-session-state-ast-floor-value load-state)
      (cload.compiler-load-session-state-ty-floor-value load-state)
      session.table-id
      session.reset-generation
      (cload.compiler-load-session-state-intern-floor-value load-state))))

(define (tc-prefix-snapshot-cache-provenance-eq?
  [left : TcPrefixSnapshotCacheProvenance]
  [right : TcPrefixSnapshotCacheProvenance]) : bool
  (and
    (= left.pool-arena right.pool-arena)
    (= left.ast-floor right.ast-floor)
    (= left.type-floor right.type-floor)
    (= left.intern-table-id right.intern-table-id)
    (= left.intern-generation right.intern-generation)
    (= left.intern-floor right.intern-floor)))

(define (tc-prefix-snapshot-cache-fill-for-state!
  [state : TcPrefixSnapshotCacheState]
  [index : i64]) : unit
  (if (>= index tc-prefix-snapshot-cache-capacity)
    unit
    (begin
      (set! (array-ref state.slots index) (TcPrefixSnapshotSlot.Empty))
      (tc-prefix-snapshot-cache-fill-for-state! state (+ index 1)))))

(define (tc-prefix-snapshot-cache-stats-reset-for-state!
  [state : TcPrefixSnapshotCacheState]) : unit
  (begin
    (set! (array-ref state.hit-count 0) 0)
    (set! (array-ref state.miss-count 0) 0)
    (set! (array-ref state.store-count 0) 0)))

(define (tc-prefix-snapshot-cache-arena-handle-for-state
  [state : TcPrefixSnapshotCacheState]) : i64
  (begin
    (if (= (array-ref state.arena 0) 0)
      (set! (array-ref state.arena 0) (arena.tl_arena_make_small))
      unit)
    (array-ref state.arena 0)))

(define (tc-prefix-snapshot-cache-arena-reset-for-state!
  [state : TcPrefixSnapshotCacheState]) : unit
  (let
    [cache-arena : i64 (array-ref state.arena 0)]
    (if (= cache-arena 0)
      unit
      (begin
        (if (= (arena.tl_arena_current) cache-arena)
          (unsafe
            (arena.tl_arena_set ast.node-pool-base-arena))
          unit)
        (unsafe
          (arena.tl_arena_destroy cache-arena))
        (set! (array-ref state.arena 0) 0)))))

(define (tc-prefix-snapshot-cache-clear-for-state!
  [state : TcPrefixSnapshotCacheState]) : unit
  (begin
    (tc-prefix-snapshot-cache-fill-for-state! state 0)
    (tc-prefix-snapshot-cache-arena-reset-for-state! state)
    (set! (array-ref state.ready 0) true)
    (tc-prefix-snapshot-cache-stats-reset-for-state! state)))

(define (tc-prefix-snapshot-cache-invalidate-for-state!
  [state : TcPrefixSnapshotCacheState]) : unit
  (begin
    (tc-prefix-snapshot-cache-clear-for-state! state)
    (set! (array-ref state.provenance-ready 0) false)))

(define (tc-prefix-snapshot-cache-enable-for-state!
  [state : TcPrefixSnapshotCacheState]) : unit
  (set! (array-ref state.enabled 0) true))

(define (tc-prefix-snapshot-cache-disable-for-state!
  [state : TcPrefixSnapshotCacheState]) : unit
  (set! (array-ref state.enabled 0) false))

(define (tc-prefix-snapshot-cache-active-for-state?
  [state : TcPrefixSnapshotCacheState]
  [load-state : cload.CompilerLoadSessionState]) : bool
  (or
    (array-ref state.enabled 0)
    (cload.compiler-load-session-state-cache-enabled? load-state)))

(define (tc-prefix-snapshot-cache-ensure-for-state!
  [state : TcPrefixSnapshotCacheState]) : unit
  (if (array-ref state.ready 0)
    unit
    (tc-prefix-snapshot-cache-clear-for-state! state)))

(define (tc-prefix-snapshot-cache-prepare-for-job!
  [state : TcPrefixSnapshotCacheState]
  [provenance : TcPrefixSnapshotCacheProvenance]) : unit
  (if (and
    (array-ref state.provenance-ready 0)
    (tc-prefix-snapshot-cache-provenance-eq?
      (array-ref state.provenance 0)
      provenance))
    (tc-prefix-snapshot-cache-ensure-for-state! state)
    (begin
      (tc-prefix-snapshot-cache-clear-for-state! state)
      (set! (array-ref state.provenance 0) provenance)
      (set! (array-ref state.provenance-ready 0) true))))

(define (tc-prefix-snapshot-cache-note-hit-for-state!
  [state : TcPrefixSnapshotCacheState]) : unit
  (set! (array-ref state.hit-count 0) (+ (array-ref state.hit-count 0) 1)))

(define (tc-prefix-snapshot-cache-note-miss-for-state!
  [state : TcPrefixSnapshotCacheState]) : unit
  (set! (array-ref state.miss-count 0) (+ (array-ref state.miss-count 0) 1)))

(define (tc-prefix-snapshot-cache-note-store-for-state!
  [state : TcPrefixSnapshotCacheState]) : unit
  (set! (array-ref state.store-count 0) (+ (array-ref state.store-count 0) 1)))

(define (tc-prefix-snapshot-cache-hit-count-for-state
  [state : TcPrefixSnapshotCacheState]) : i64
  (array-ref state.hit-count 0))

(define (tc-prefix-snapshot-cache-miss-count-for-state
  [state : TcPrefixSnapshotCacheState]) : i64
  (array-ref state.miss-count 0))

(define (tc-prefix-snapshot-cache-store-count-for-state
  [state : TcPrefixSnapshotCacheState]) : i64
  (array-ref state.store-count 0))

(define (tc-prefix-snapshot-cache-arena-value-for-state
  [state : TcPrefixSnapshotCacheState]) : i64
  (array-ref state.arena 0))

(define (tc-prefix-snapshot-cache-lookup-count-for-state
  [state : TcPrefixSnapshotCacheState]) : i64
  (+
    (tc-prefix-snapshot-cache-hit-count-for-state state)
    (tc-prefix-snapshot-cache-miss-count-for-state state)))

(define (tc-prefix-snapshot-cache-hit-rate-per-mille-for-state
  [state : TcPrefixSnapshotCacheState]) : i64
  (let
    [lookups : i64 (tc-prefix-snapshot-cache-lookup-count-for-state state)]
    (if (= lookups 0)
      0
      (/ (* (tc-prefix-snapshot-cache-hit-count-for-state state) 1000) lookups))))

(define (tc-prefix-snapshot-cache-stats-line-for-state
  [state : TcPrefixSnapshotCacheState]
  [label : String]) : String
  (str_cat.str-cat
    "typecheck-prefix-cache|"
    label
    "|hits="
    (string.int->string (tc-prefix-snapshot-cache-hit-count-for-state state))
    "|misses="
    (string.int->string (tc-prefix-snapshot-cache-miss-count-for-state state))
    "|stores="
    (string.int->string (tc-prefix-snapshot-cache-store-count-for-state state))
    "|lookups="
    (string.int->string (tc-prefix-snapshot-cache-lookup-count-for-state state))
    "|hit-rate-per-mille="
    (string.int->string
      (tc-prefix-snapshot-cache-hit-rate-per-mille-for-state state))))

(define (tc-prefix-snapshot-cache-print-stats-for-state
  [state : TcPrefixSnapshotCacheState]
  [label : String]) : unit
  (io.print-error
    (str_cat.str-cat
      (tc-prefix-snapshot-cache-stats-line-for-state state label)
      "\n")))

(define (tc-prefix-snapshot-cache-lookup-from-for-state
  [state : TcPrefixSnapshotCacheState]
  [key : String]
  [index : i64]) : TcPrefixSnapshotLookup
  (if (>= index tc-prefix-snapshot-cache-capacity)
    (TcPrefixSnapshotLookup.Miss)
    (match (array-ref state.slots index)
      [(TcPrefixSnapshotSlot.Empty) (TcPrefixSnapshotLookup.Miss)]
      [(TcPrefixSnapshotSlot.Full slot-key count module module-id summary)
        (if (string.eq slot-key key)
          (TcPrefixSnapshotLookup.Hit count module module-id summary)
          (tc-prefix-snapshot-cache-lookup-from-for-state state key (+ index 1)))])))

(define (tc-prefix-snapshot-cache-lookup-for-state
  [state : TcPrefixSnapshotCacheState]
  [key : String]) : TcPrefixSnapshotLookup
  (begin
    (tc-prefix-snapshot-cache-ensure-for-state! state)
    (tc-prefix-snapshot-cache-lookup-from-for-state state key 0)))

(define (tc-prefix-snapshot-cache-store-at-for-state
  [state : TcPrefixSnapshotCacheState]
  [key : String]
  [count : i64]
  [module : String]
  [module-id : i64]
  [summary : CompilerTypecheckSummary]
  [index : i64]) : bool
  (if (>= index tc-prefix-snapshot-cache-capacity)
    false
    (match (array-ref state.slots index)
      [(TcPrefixSnapshotSlot.Empty)
        (begin
          (set!
            (array-ref state.slots index)
            (TcPrefixSnapshotSlot.Full key count module module-id summary))
          (tc-prefix-snapshot-cache-note-store-for-state! state)
          true)]
      [(TcPrefixSnapshotSlot.Full slot-key _ _ _ _)
        (if (string.eq slot-key key)
          (begin
            (set!
              (array-ref state.slots index)
              (TcPrefixSnapshotSlot.Full key count module module-id summary))
            (tc-prefix-snapshot-cache-note-store-for-state! state)
            true)
          (tc-prefix-snapshot-cache-store-at-for-state
            state
            key
            count
            module
            module-id
            summary
            (+ index 1)))])))

(define (tc-prefix-snapshot-cache-store-for-state
  [state : TcPrefixSnapshotCacheState]
  [key : String]
  [count : i64]
  [module : String]
  [module-id : i64]
  [summary : CompilerTypecheckSummary]) : bool
  (begin
    (tc-prefix-snapshot-cache-ensure-for-state! state)
    (tc-prefix-snapshot-cache-store-at-for-state
      state
      key
      count
      module
      module-id
      summary
      0)))

(define (tc-prefix-snapshot-cache-store-persistent-for-state
  [state : TcPrefixSnapshotCacheState]
  [key : String]
  [count : i64]
  [module : String]
  [module-id : i64]
  [summary : CompilerTypecheckSummary]) : bool
  (begin
    (tc-prefix-snapshot-cache-ensure-for-state! state)
    (in-arena
      (arena.Arena (tc-prefix-snapshot-cache-arena-handle-for-state state))
      (let
        [persistent-key : String (string.copy (& key))]
        [persistent-module : String (string.copy (& module))]
        (tc-prefix-snapshot-cache-store-for-state
          state
          persistent-key
          count
          persistent-module
          module-id
          summary)))))

;; Serial/test compatibility surface. These adapters are intentionally the only
;; prefix-cache APIs that consult the serial loader selector.
(define (tc-prefix-snapshot-cache-clear!) : unit
  (tc-prefix-snapshot-cache-clear-for-state!
    (tc-global-shared-view tc-prefix-snapshot-serial-test-cache-state)))

(define (tc-prefix-snapshot-cache-hit-count-value) : i64
  (tc-prefix-snapshot-cache-hit-count-for-state
    (tc-global-shared-view tc-prefix-snapshot-serial-test-cache-state)))

(define (tc-prefix-snapshot-cache-store-count-value) : i64
  (tc-prefix-snapshot-cache-store-count-for-state
    (tc-global-shared-view tc-prefix-snapshot-serial-test-cache-state)))

(define (tc-prefix-snapshot-cache-stats-line [label : String]) : String
  (tc-prefix-snapshot-cache-stats-line-for-state
    (tc-global-shared-view tc-prefix-snapshot-serial-test-cache-state)
    label))

(define (tc-prefix-snapshot-cache-print-stats [label : String]) : unit
  (tc-prefix-snapshot-cache-print-stats-for-state
    (tc-global-shared-view tc-prefix-snapshot-serial-test-cache-state)
    label))

(define (tc-prefix-snapshot-cache-note-hit!) : unit
  (tc-prefix-snapshot-cache-note-hit-for-state!
    (tc-global-shared-view tc-prefix-snapshot-serial-test-cache-state)))

(define (tc-prefix-snapshot-cache-note-miss!) : unit
  (tc-prefix-snapshot-cache-note-miss-for-state!
    (tc-global-shared-view tc-prefix-snapshot-serial-test-cache-state)))

(define (tc-prefix-snapshot-cache-note-store!) : unit
  (tc-prefix-snapshot-cache-note-store-for-state!
    (tc-global-shared-view tc-prefix-snapshot-serial-test-cache-state)))

(define (tc-prefix-snapshot-cache-stats-reset!) : unit
  (tc-prefix-snapshot-cache-stats-reset-for-state!
    (tc-global-shared-view tc-prefix-snapshot-serial-test-cache-state)))

(define (tc-context-with-module-id
  [ctx : TcContext]
  [module : String]
  [module-id : i64]) : TcContext
  (match ctx
    [(TcContext program symbols registries _ _ _ pools source-names body-state)
      (TcContext
        program
        symbols
        registries
        module
        module-id
        module-id
        pools
        source-names
        body-state)]))

(define (tc-context-with-type-module-id [ctx : TcContext] [module-id : i64]) : TcContext
  (match ctx
    [(TcContext
        program
        symbols
        registries
        value-module
        value-module-id
        _
        pools
        source-names
        body-state)
      (TcContext
        program
        symbols
        registries
        value-module
        value-module-id
        module-id
        pools
        source-names
        body-state)]))

(define (tc-context-with-program [ctx : TcContext] [program : ast.AstProgram]) : TcContext
  (match ctx
    [(TcContext
        _
        symbols
        registries
        module
        module-id
        type-module-id
        pools
        source-names
        body-state)
      (TcContext
        program
        symbols
        registries
        module
        module-id
        type-module-id
        pools
        source-names
        body-state)]))

(define (tc-context-module [ctx : TcContext]) : String
  (match ctx
    [(TcContext _ _ _ module _ _ _ _ _) module]))

(define (tc-context-module-id [ctx : TcContext]) : i64
  (match ctx
    [(TcContext _ _ _ _ module-id _ _ _ _) module-id]))

(define (tc-context-type-module-id [ctx : TcContext]) : i64
  (match ctx
    [(TcContext _ _ _ _ _ type-module-id _ _ _) type-module-id]))

(define (tc-context-for-type-resolution [ctx : TcContext]) : TcContext
  (match ctx
    [(TcContext
        program
        symbols
        registries
        _
        module-id
        type-module-id
        pools
        source-names
        body-state)
      (if (= module-id type-module-id)
        ctx
        (let
          [type-module : String
            (if (csym.compiler-symbol-root-module-id? type-module-id)
              ""
              (tc-env-key-name-text type-module-id))]
          (TcContext
            program
            symbols
            registries
            type-module
            type-module-id
            type-module-id
            pools
            source-names
            body-state)))]))

(define (tc-context-dotted-module-id-or-suffix
  [dotted-modules : sym_i64_env.SymI64Env]
  [module-id : i64]) : i64
  (let
    [exact : i64 (sym_i64_env.sym-i64-lookup-id-or dotted-modules module-id -1)]
    (if (>= exact 0)
      exact
      (csym.compiler-symbols-dotted-suffix-owner-module-id
        dotted-modules
        module-id))))

(define (tc-context-type-module-id-for-path-owner
  [dotted-modules : sym_i64_env.SymI64Env]
  [path : String]
  [path-owner-id : i64]) : i64
  (let
    [exact : i64
      (sym_i64_env.sym-i64-lookup-id-or dotted-modules path-owner-id -1)]
    [suffix-match : i64
      (csym.compiler-symbols-dotted-suffix-owner-module-id
        dotted-modules
        path-owner-id)]
    (cond
      [(>= exact 0) exact]
      [(or (>= suffix-match 0) (string.eq path "")) suffix-match]
      [else
        (tc-context-dotted-module-id-or-suffix
          dotted-modules
          (ci.intern (cload.compiler-load-canonical-module-id-from-path path)))])))

(define (tc-context-pools [ctx : TcContext]) : ast.AstNodePoolContext
  (match ctx
    [(TcContext _ _ _ _ _ _ pools _ _) pools]))

(define (tc-context-source-names [ctx : TcContext]) : ci.InternSourceNameSessionHandle
  (match ctx
    [(TcContext _ _ _ _ _ _ _ source-names _) source-names]))

(define (tc-context-body-state [ctx : TcContext]) : TcBodyState
  (match ctx
    [(TcContext _ _ _ _ _ _ _ _ body-state) body-state]))

(define (tc-context-job-state [ctx : TcContext]) : TcJobState
  (__tl-project-field (tc-context-body-state ctx) job-state))

(define (tc-context-capture-active-pools! [ctx : TcContext]) : unit
  (if (ast.ast-node-pool-compat-context-active?)
    unit
    (ast.ast-node-pool-context-capture-active! (tc-context-pools ctx))))

(define (tc-context-install-pools! [ctx : TcContext]) : unit
  (if (ast.ast-node-pool-compat-context-active?)
    unit
    (ast.ast-node-pool-context-install! (tc-context-pools ctx))))

(define (tc-install-pools! [pools : ast.AstNodePoolContext]) : unit
  (if (ast.ast-node-pool-compat-context-active?)
    unit
    (ast.ast-node-pool-context-install! pools)))

(define (tc-context-type-get [ctx : TcContext] [id : i64]) : ast.AstType
  (ast.ast-node-pool-context-type-get (tc-context-pools ctx) id))

;; Macro-capable typecheck walks cannot hoist an expression segment-bases token:
;; expansion may install another pool between two reads. Expand the scalar read
;; at each use so nested installs cannot redirect the walk or add a TcContext-
;; sized helper frame to recursive expression checking.
(defmacro (tc-context-expr-get [ctx : Expr] [id : Expr]) : Expr
  `(ast.ast-expr-segment-bases-get
    (if (ast.ast-node-pool-compat-context-active?)
      (ast.ast-node-pool-active-expr-segment-bases)
      (match ,ctx
        [(TcContext _ _ _ _ _ _ expr-pools _ _)
          (ast.ast-node-pool-context-expr-segment-bases expr-pools)]))
    ,id))

(test
  tc-context-expression-pool-isolation
  (let
    [installed-len : i64 (ast.ast-node-pool-len)]
    [pools-a : ast.AstNodePoolContext
      (ast.ast-node-pool-context-new-with-capacities 8 8)]
    [pools-b : ast.AstNodePoolContext
      (ast.ast-node-pool-context-new-with-capacities 8 8)]
    [root-a : i64
      (ast.ast-node-pool-context-expr-push pools-a (ast.AstExpr.Var 101))]
    [root-b : i64
      (ast.ast-node-pool-context-expr-push pools-b (ast.AstExpr.Var 202))]
    [ctx-a : TcContext
      (tc-context-new
        (ast.ast-program (ast.ast-decl-list-new))
        (csym.compiler-symbols-empty)
        (csym.compiler-registries-empty)
        ""
        cbi.compiler-builtin-id-fix-empty
        pools-a)]
    [ctx-b : TcContext
      (tc-context-new
        (ast.ast-program (ast.ast-decl-list-new))
        (csym.compiler-symbols-empty)
        (csym.compiler-registries-empty)
        ""
        cbi.compiler-builtin-id-fix-empty
        pools-b)]
    [next-a : i64
      (ast.ast-node-pool-context-expr-push pools-a (ast.AstExpr.Var 303))]
    [next-b : i64
      (ast.ast-node-pool-context-expr-push pools-b (ast.AstExpr.Var 404))]
    [a-root-ok? : bool
      (match (tc-context-expr-get ctx-a root-a)
        [(ast.AstExpr.Var name) (= name 101)]
        [_ false])]
    [b-root-ok? : bool
      (match (tc-context-expr-get ctx-b root-b)
        [(ast.AstExpr.Var name) (= name 202)]
        [_ false])]
    [a-next-ok? : bool
      (match (tc-context-expr-get ctx-a next-a)
        [(ast.AstExpr.Var name) (= name 303)]
        [_ false])]
    [b-next-ok? : bool
      (match (tc-context-expr-get ctx-b next-b)
        [(ast.AstExpr.Var name) (= name 404)]
        [_ false])]
    [compat-ok? : bool
      (begin
        (ast.ast-node-pool-compat-context-use! pools-a)
        (let
          [ok?
            : bool
            ;; Compatibility callers intentionally follow their selected pool,
            ;; even when the TcContext argument names another owner.
            (match (tc-context-expr-get ctx-b root-a)
              [(ast.AstExpr.Var name) (= name 101)]
              [_ false])]
          (begin
            (ast.ast-node-pool-compat-context-clear!)
            ok?)))]
    (if (and
      (= root-a root-b)
      (= next-a next-b)
      a-root-ok?
      b-root-ok?
      a-next-ok?
      b-next-ok?
      compat-ok?
      (= (ast.ast-node-pool-context-expr-len pools-a) 2)
      (= (ast.ast-node-pool-context-expr-len pools-b) 2)
      (= (ast.ast-node-pool-len) installed-len))
      unit
      (io.panic "typecheck: context expression pool isolation failed"))))

;; Pool selected for type walks that may both read and append. Explicit
;; compatibility callers intentionally keep following the pool they installed;
;; ordinary compile jobs stay on the pool owned by their context even when an
;; unrelated pool is process-global.
(define (tc-context-type-pools [ctx : TcContext]) : ast.AstNodePoolContext
  (if (ast.ast-node-pool-compat-context-active?)
    (ast.ast-node-pool-compat-context-current)
    (tc-context-pools ctx)))

;; Transitional owner for a resolver result consumed by paths that still read
;; nested type ids through the installed compatibility reader. An explicitly
;; installed ctx already names those cells. A captured ctx does not: until its
;; consumers are threaded, reconstruct into the installed live cells exactly
;; as the historical global constructors did. The explicit resolver below is
;; available to callers whose whole consumer chain carries `pools`.
(define (tc-context-type-resolution-pools [ctx : TcContext]) : ast.AstNodePoolContext
  (let
    [owned : ast.AstNodePoolContext (tc-context-type-pools ctx)]
    (if (ast.ast-node-pool-context-type-installed? owned)
      owned
      (if (ast.ast-node-pool-has-active-context?)
        (ast.ast-node-pool-context-active-live)
        owned))))

;; Type segment-bases for a pure read under `ctx`. Lifetime-elision walks may
;; append reconstructed nodes, but never install a different pool; the table is
;; stable across push/grow. Compatibility callers continue following the
;; installed pool that their historical no-context API selected.
(define (tc-context-type-bases [ctx : TcContext]) : i64
  (ast.ast-node-pool-context-type-segment-bases (tc-context-type-pools ctx)))

;; Expression segment-bases for a read-only walk under `ctx`, snapshotted once
;; at the walk's entry and threaded down as a scalar.
;;
;; Reading through `AstNodePoolContext` per node is not an option on this path:
;; at opt2 `tc-context-expr-get` is 30 instructions against `ast-node-get`'s 14,
;; because the context struct is copied to the stack for every call. The scalar
;; token is 13, so a converted walk is cheaper than the global reader it
;; replaces, and the hoist is what makes that true rather than the conversion.
;;
;; A compatibility pool context suppresses the ctx install (see
;; `tc-context-install-pools!`), so under one the walk must follow the installed
;; pool exactly as `ast-node-get` does. Only walks that cannot expand a macro or
;; otherwise install a different pool mid-traversal may cache this.
(define (tc-context-expr-bases [ctx : TcContext]) : i64
  (if (ast.ast-node-pool-compat-context-active?)
    (ast.ast-node-pool-active-expr-segment-bases)
    (ast.ast-node-pool-context-expr-segment-bases (tc-context-pools ctx))))

;; The typechecker receives an already-loaded program and so does not know the
;; source path; it builds diagnostics with an empty path (the CLI driver stamps
;; the real path before rendering). Synthetic/internal errors fall back to 1:1.
;; Every typecheck error becomes a diagnostic through here, so this is where the
;; per-kind code is decided (refs #5668). The kind is not available at the raise
;; site -- errors travel as `ResultTcType.Err <String>` -- so the code is derived
;; from the canonical message; see the registry in `compiler_diagnostic.tl`. A
;; kind that is not classified yet keeps `E0200`.
(define (tc-canonical-diagnostic [diag : cdiag.CompilerDiagnostic]) : cdiag.CompilerDiagnostic
  (cdiag.compiler-diagnostic-with-category
    (cdiag.compiler-diagnostic-with-code
      diag
      (cdiag.compiler-diagnostic-code-for-typecheck-message
        (cdiag.compiler-diagnostic-message diag)))
    "typecheck"))

(define (tc-diag-at-start [message : String]) : cdiag.CompilerDiagnostic
  (tc-canonical-diagnostic (cdiag.compiler-diagnostic-at-start "" message)))

(define (tc-located-error-prefix) : String
  "__tl_tc_loc|")

(define (tc-rich-error-prefix) : String
  "__tl_tc_diag|")

;; A macro frame wraps any established typecheck error transport instead of
;; flattening and rebuilding it. The fixed fields precede the untouched inner
;; payload, which may itself be a located/rich error or another macro frame.
(define (tc-macro-framed-error-prefix) : String
  "__tl_tc_macro|")

(define (tc-diag-string-prefix? [text : String] [prefix : String]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [prefix-len : i64 (string.string-length prefix)]
    (if (< text-len prefix-len)
      false
      (string.eq (string.substring text 0 prefix-len) prefix))))

(define (tc-located-error? [message : String]) : bool
  (tc-diag-string-prefix? message (tc-located-error-prefix)))

(define (tc-rich-error? [message : String]) : bool
  (tc-diag-string-prefix? message (tc-rich-error-prefix)))

(define (tc-macro-framed-error? [message : String]) : bool
  (tc-diag-string-prefix? message (tc-macro-framed-error-prefix)))

(define (tc-encoded-error? [message : String]) : bool
  (or
    (tc-macro-framed-error? message)
    (tc-rich-error? message)
    (tc-located-error? message)))

(define (tc-rich-error-span-fields [span : ast.AstSourceSpan]) : String
  (str_cat.str-cat
    (string.int->string (ast.ast-source-span-start-line span))
    "|"
    (string.int->string (ast.ast-source-span-start-col span))
    "|"
    (string.int->string (ast.ast-source-span-end-line span))
    "|"
    (string.int->string (ast.ast-source-span-end-col span))
    "|"))

(define (tc-rich-error-with-help
  [primary : ast.AstSourceSpan]
  [message : String]
  [help : String]) : String
  (str_cat.str-cat
    (tc-rich-error-prefix)
    (tc-rich-error-span-fields primary)
    message
    "|"
    help
    "|0"))

;; The optional suffix after the secondary-count field transports one
;; machine-applicable replacement of the primary span. The title is delimiter-
;; safe and the replacement consumes the remaining payload, so symbol text may
;; itself contain `|`.
(define (tc-rich-error-with-machine-fix
  [primary : ast.AstSourceSpan]
  [edit-span : ast.AstSourceSpan]
  [message : String]
  [help : String]
  [replacement : String]) : String
  (str_cat.str-cat
    (tc-rich-error-prefix)
    (tc-rich-error-span-fields primary)
    message
    "|"
    help
    "|0|"
    (tc-rich-error-span-fields edit-span)
    "Replace misspelled name|"
    replacement))

(define (tc-rich-error-one-secondary
  [primary : ast.AstSourceSpan]
  [message : String]
  [help : String]
  [secondary : ast.AstSourceSpan]
  [secondary-label : String]) : String
  (str_cat.str-cat
    (tc-rich-error-prefix)
    (tc-rich-error-span-fields primary)
    message
    "|"
    help
    "|1|"
    (tc-rich-error-span-fields secondary)
    secondary-label))

(define (tc-rich-error-two-secondaries
  [primary : ast.AstSourceSpan]
  [message : String]
  [help : String]
  [first : ast.AstSourceSpan]
  [first-label : String]
  [second : ast.AstSourceSpan]
  [second-label : String]) : String
  (str_cat.str-cat
    (tc-rich-error-prefix)
    (tc-rich-error-span-fields primary)
    message
    "|"
    help
    "|2|"
    (tc-rich-error-span-fields first)
    first-label
    "|"
    (tc-rich-error-span-fields second)
    second-label))

(define (tc-located-error-field-end [text : String] [start : i64]) : i64
  (let
    [i : i64 start]
    [n : i64 (string.string-length text)]
    [done : bool false]
    (begin
      (while (and (< i n) (not done))
        (if (= (cast (string.string-ref text i) : i64) 124)
          (set! done true)
          (set! i (+ i 1))))
      i)))

(define (tc-located-error-field [text : String] [start : i64] [end : i64]) : String
  (string.substring text start (- end start)))

(define (tc-rich-error-diag [message : String]) : cdiag.CompilerDiagnostic
  (let
    [prefix-len : i64 (string.string-length (tc-rich-error-prefix))]
    [line-end : i64 (tc-located-error-field-end message prefix-len)]
    [col-start : i64 (+ line-end 1)]
    [col-end : i64 (tc-located-error-field-end message col-start)]
    [end-line-start : i64 (+ col-end 1)]
    [end-line-end : i64 (tc-located-error-field-end message end-line-start)]
    [end-col-start : i64 (+ end-line-end 1)]
    [end-col-end : i64 (tc-located-error-field-end message end-col-start)]
    [msg-start : i64 (+ end-col-end 1)]
    [msg-end : i64 (tc-located-error-field-end message msg-start)]
    [help-start : i64 (+ msg-end 1)]
    [help-end : i64 (tc-located-error-field-end message help-start)]
    [count-start : i64 (+ help-end 1)]
    [count-end : i64 (tc-located-error-field-end message count-start)]
    [clean-message : String (tc-located-error-field message msg-start msg-end)]
    [help : String (tc-located-error-field message help-start help-end)]
    [remaining : i64
      (string.>int (tc-located-error-field message count-start count-end))]
    [idx : i64 (+ count-end 1)]
    [diag : cdiag.CompilerDiagnostic
      (cdiag.compiler-diagnostic-from-ast-span
        ""
        (ast.ast-source-span
          (string.>int (tc-located-error-field message prefix-len line-end))
          (string.>int (tc-located-error-field message col-start col-end))
          (string.>int
            (tc-located-error-field message end-line-start end-line-end))
          (string.>int
            (tc-located-error-field message end-col-start end-col-end)))
        clean-message)]
    (begin
      (if (> (string.string-length help) 0)
        (set! diag (cdiag.compiler-diagnostic-with-help diag help))
        unit)
      (while (> remaining 0)
        (let
          [sec-line-end : i64 (tc-located-error-field-end message idx)]
          [sec-col-start : i64 (+ sec-line-end 1)]
          [sec-col-end : i64 (tc-located-error-field-end message sec-col-start)]
          [sec-end-line-start : i64 (+ sec-col-end 1)]
          [sec-end-line-end : i64
            (tc-located-error-field-end message sec-end-line-start)]
          [sec-end-col-start : i64 (+ sec-end-line-end 1)]
          [sec-end-col-end : i64
            (tc-located-error-field-end message sec-end-col-start)]
          [label-start : i64 (+ sec-end-col-end 1)]
          [label-end : i64
            (if (= remaining 1)
              (string.string-length message)
              (tc-located-error-field-end message label-start))]
          [label : String
            (tc-located-error-field message label-start label-end)]
          (begin
            (set!
              diag
              (cdiag.compiler-diagnostic-with-secondary
                diag
                (cdiag.CompilerDiagnosticSpan
                  ""
                  (string.>int
                    (tc-located-error-field message idx sec-line-end))
                  (string.>int
                    (tc-located-error-field message sec-col-start sec-col-end))
                  (string.>int
                    (tc-located-error-field
                      message
                      sec-end-line-start
                      sec-end-line-end))
                  (string.>int
                    (tc-located-error-field
                      message
                      sec-end-col-start
                      sec-end-col-end)))
                (CompilerDiagnosticSomeString label)))
            (set! idx (+ label-end 1))
            (set! remaining (- remaining 1)))))
      (if (< idx (string.string-length message))
        (let
          [fix-line-end : i64 (tc-located-error-field-end message idx)]
          [fix-col-start : i64 (+ fix-line-end 1)]
          [fix-col-end : i64 (tc-located-error-field-end message fix-col-start)]
          [fix-end-line-start : i64 (+ fix-col-end 1)]
          [fix-end-line-end : i64
            (tc-located-error-field-end message fix-end-line-start)]
          [fix-end-col-start : i64 (+ fix-end-line-end 1)]
          [fix-end-col-end : i64
            (tc-located-error-field-end message fix-end-col-start)]
          [title-start : i64 (+ fix-end-col-end 1)]
          [title-end : i64 (tc-located-error-field-end message title-start)]
          [replacement-start : i64 (+ title-end 1)]
          (if (and
            (< title-end (string.string-length message))
            (<= replacement-start (string.string-length message)))
            (set!
              diag
              (cdiag.compiler-diagnostic-with-fix
                diag
                (cdiag.compiler-diagnostic-fix-new
                  (tc-located-error-field message title-start title-end)
                  CompilerDiagnosticMachineApplicable
                  (cdiag.compiler-diagnostic-text-edit-single
                    (cdiag.compiler-diagnostic-text-edit-new
                      (cdiag.CompilerDiagnosticSpan
                        ""
                        (string.>int
                          (tc-located-error-field message idx fix-line-end))
                        (string.>int
                          (tc-located-error-field
                            message
                            fix-col-start
                            fix-col-end))
                        (string.>int
                          (tc-located-error-field
                            message
                            fix-end-line-start
                            fix-end-line-end))
                        (string.>int
                          (tc-located-error-field
                            message
                            fix-end-col-start
                            fix-end-col-end)))
                      (string.substring
                        message
                        replacement-start
                        (- (string.string-length message) replacement-start)))))))
            unit))
        unit)
      (tc-canonical-diagnostic diag))))

(define (tc-located-error [span : ast.AstSourceSpan] [message : String]) : String
  (str_cat.str-cat
    (tc-located-error-prefix)
    (string.int->string (ast.ast-source-span-start-line span))
    "|"
    (string.int->string (ast.ast-source-span-start-col span))
    "|"
    (string.int->string (ast.ast-source-span-end-line span))
    "|"
    (string.int->string (ast.ast-source-span-end-col span))
    "|"
    message))

(define (tc-located-error-diag [message : String]) : cdiag.CompilerDiagnostic
  (let
    [prefix-len : i64 (string.string-length (tc-located-error-prefix))]
    [line-end : i64 (tc-located-error-field-end message prefix-len)]
    [col-start : i64 (+ line-end 1)]
    [col-end : i64 (tc-located-error-field-end message col-start)]
    [end-line-start : i64 (+ col-end 1)]
    [end-line-end : i64 (tc-located-error-field-end message end-line-start)]
    [end-col-start : i64 (+ end-line-end 1)]
    [end-col-end : i64 (tc-located-error-field-end message end-col-start)]
    [clean-start : i64 (+ end-col-end 1)]
    [clean-message : String
      (string.substring
        message
        clean-start
        (- (string.string-length message) clean-start))]
    (tc-canonical-diagnostic
      (cdiag.compiler-diagnostic-from-ast-span
        ""
        (ast.ast-source-span
          (string.>int (tc-located-error-field message prefix-len line-end))
          (string.>int (tc-located-error-field message col-start col-end))
          (string.>int
            (tc-located-error-field message end-line-start end-line-end))
          (string.>int
            (tc-located-error-field message end-col-start end-col-end)))
        clean-message))))

(define (tc-macro-expansion-frame-label [macro-name-id : i64]) : String
  (let
    [name : String
      (if (< macro-name-id 0)
        "<macro>"
        (ci.intern-str macro-name-id))]
    (str_cat.str-cat "in expansion of macro `" name "` invoked here")))

(define (macro-expansion-provenance-id [path-id : i64] [origin-path-id : i64]) : i64
  (ci.intern-composite-pair-id path-id origin-path-id))

(define (macro-expansion-invocation-path-id [provenance-id : i64]) : i64
  (ci.intern-composite-left-id-unchecked provenance-id))

(define (macro-expansion-origin-path-id [provenance-id : i64]) : i64
  (ci.intern-composite-right-id-unchecked provenance-id))

(define (tc-macro-framed-error
  [path-id : i64]
  [span : ast.AstSourceSpan]
  [origin-path-id : i64]
  [macro-name-id : i64]
  [message : String]) : String
  (str_cat.str-cat
    (tc-macro-framed-error-prefix)
    (string.int->string path-id)
    "|"
    (tc-rich-error-span-fields span)
    (string.int->string origin-path-id)
    "|"
    (string.int->string macro-name-id)
    "|"
    message))

(define (tc-macro-framed-error-from-root
  [expr : ast.AstExpr]
  [message : String]) : TcMaybeString
  (match expr
    [(ast.AstExpr.Spanned inner-id span)
      (match (ast.ast-node-get inner-id)
        [(ast.AstExpr.MacroExpansion expanded provenance-id macro-name-id)
          (let
            [expanded-expr : ast.AstExpr (ast.ast-node-get expanded)]
            [path-id : i64 (macro-expansion-invocation-path-id provenance-id)]
            [origin-path-id : i64
              (macro-expansion-origin-path-id provenance-id)]
            [inner-message : String
              (match (tc-macro-framed-error-from-root expanded-expr message)
                [(TcMaybeString.Some framed) framed]
                [(TcMaybeString.No)
                  (match (tc-expr-maybe-span expanded-expr)
                    [(TcMaybeAstSourceSpan.Some primary)
                      (tc-located-error primary message)]
                    [(TcMaybeAstSourceSpan.No) (tc-located-error span message)])])]
            (TcMaybeString.Some
              (tc-macro-framed-error
                path-id
                span
                origin-path-id
                macro-name-id
                inner-message)))]
        [_ (TcMaybeString.No)])]
    [_ (TcMaybeString.No)]))

(defstruct TcMacroDecodedDiagnostic
  (diagnostic cdiag.CompilerDiagnostic)
  (primary-origin-claimed bool))

(define (tc-macro-framed-error-decode [message : String]) : TcMacroDecodedDiagnostic
  (let
    [prefix-len : i64 (string.string-length (tc-macro-framed-error-prefix))]
    [path-end : i64 (tc-located-error-field-end message prefix-len)]
    [line-start : i64 (+ path-end 1)]
    [line-end : i64 (tc-located-error-field-end message line-start)]
    [col-start : i64 (+ line-end 1)]
    [col-end : i64 (tc-located-error-field-end message col-start)]
    [end-line-start : i64 (+ col-end 1)]
    [end-line-end : i64 (tc-located-error-field-end message end-line-start)]
    [end-col-start : i64 (+ end-line-end 1)]
    [end-col-end : i64 (tc-located-error-field-end message end-col-start)]
    [origin-start : i64 (+ end-col-end 1)]
    [origin-end : i64 (tc-located-error-field-end message origin-start)]
    [name-start : i64 (+ origin-end 1)]
    [name-end : i64 (tc-located-error-field-end message name-start)]
    [inner-start : i64 (+ name-end 1)]
    [inner : String
      (string.substring
        message
        inner-start
        (- (string.string-length message) inner-start))]
    [inner-decoded : TcMacroDecodedDiagnostic
      (if (tc-macro-framed-error? inner)
        (tc-macro-framed-error-decode inner)
        (TcMacroDecodedDiagnostic
          (if (tc-rich-error? inner)
            (tc-rich-error-diag inner)
            (if (tc-located-error? inner)
              (tc-located-error-diag inner)
              (tc-diag-at-start inner)))
          false))]
    [inner-diag : cdiag.CompilerDiagnostic inner-decoded.diagnostic]
    [path-id : i64
      (string.>int (tc-located-error-field message prefix-len path-end))]
    [macro-name-id : i64
      (string.>int (tc-located-error-field message name-start name-end))]
    [origin-path-id : i64
      (string.>int (tc-located-error-field message origin-start origin-end))]
    [claim-origin : bool
      (and (>= origin-path-id 0) (not inner-decoded.primary-origin-claimed))]
    [origin-diag : cdiag.CompilerDiagnostic
      (if claim-origin
        (cdiag.compiler-diagnostic-with-path
          inner-diag
          (ci.intern-str origin-path-id))
        inner-diag)]
    ;; Decode recursively, then prepend this boundary. The resulting stable
    ;; order is explicitly outer-to-inner. Caller-origin markers only repath
    ;; the primary and deliberately add no user-visible frame.
    (TcMacroDecodedDiagnostic
      (if (< macro-name-id 0)
        origin-diag
        (cdiag.compiler-diagnostic-with-secondary-if-new
          origin-diag
          (cdiag.CompilerDiagnosticSpan
            (if (< path-id 0)
              ""
              (ci.intern-str path-id))
            (string.>int (tc-located-error-field message line-start line-end))
            (string.>int (tc-located-error-field message col-start col-end))
            (string.>int
              (tc-located-error-field message end-line-start end-line-end))
            (string.>int
              (tc-located-error-field message end-col-start end-col-end)))
          (CompilerDiagnosticSomeString
            (tc-macro-expansion-frame-label macro-name-id))))
      (or inner-decoded.primary-origin-claimed claim-origin))))

(define (tc-macro-framed-error-diag [message : String]) : cdiag.CompilerDiagnostic
  (__tl-project-field (tc-macro-framed-error-decode message) diagnostic))

(define (tc-ty-node-pool-exhausted-diagnostic) : cdiag.CompilerDiagnostic
  (tc-diag-at-start (ast.ty-node-pool-exhausted-message)))

(define (tc-typecheck-result-with-pool-check
  [job-state : TcJobState]
  [result : ResultCompilerTypecheck]) : ResultCompilerTypecheck
  (begin
    (tc-job-state-release-scratch-arenas! job-state)
    (if (ast.ty-node-pool-exhausted?)
      (ResultCompilerTypecheck.Err
        (box
          (cdiag.compiler-diagnostic-list-single
            (tc-ty-node-pool-exhausted-diagnostic))))
      result)))

(define (tc-typecheck-checked-result-with-pool-check
  [job-state : TcJobState]
  [result : ResultCompilerTypecheckChecked]) : ResultCompilerTypecheckChecked
  (begin
    (tc-job-state-release-scratch-arenas! job-state)
    (if (ast.ty-node-pool-exhausted?)
      (ResultCompilerTypecheckChecked.Err
        (box
          (cdiag.compiler-diagnostic-list-single
            (tc-ty-node-pool-exhausted-diagnostic))))
      result)))

(cfg
  compile-profile
  (define compiler-tc-profile-start-ms : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-profile-start-total : i64
    0))
(cfg
  compile-profile
  (define compiler-tc-profile-start-live : i64
    0))

(cfg
  compile-profile
  (define (compiler-tc-profile-field [value : i64]) : String
    (str_cat.str-cat "|" (string.int->string value))))

(cfg
  compile-profile
  (define (compiler-tc-profile-start) : unit
    (begin
      (set! compiler-tc-profile-start-ms (profile.now-ms))
      (set! compiler-tc-profile-start-total (profile.alloc-total))
      (set! compiler-tc-profile-start-live (profile.alloc-live))
      (profile.alloc-reset-peak))))

(cfg
  compile-profile
  (define (compiler-tc-profile-finish [phase : String]) : unit
    (let
      [end-ms : i64 (profile.now-ms)]
      [end-total : i64 (profile.alloc-total)]
      [end-live : i64 (profile.alloc-live)]
      [peak-delta : i64 (- (profile.alloc-peak) compiler-tc-profile-start-live)]
      (io.print-error
        (str_cat.str-cat
          "compile-profile|typecheck."
          phase
          (compiler-tc-profile-field (- end-ms compiler-tc-profile-start-ms))
          (compiler-tc-profile-field
            (- end-total compiler-tc-profile-start-total))
          (compiler-tc-profile-field
            (- end-live compiler-tc-profile-start-live))
          (compiler-tc-profile-field peak-delta)
          "\n")))))

;; Fine-grained walk-region accumulators. The ms clock cannot resolve the
;; per-call regions inside the macro walk, so these use a nanosecond
;; monotonic clock. Linux only: on Windows the reads return 0 and the rows
;; report zeros, which the profile harness does not assert on.
(cfg
  compile-profile
  (define compiler-tc-walk-clock-scratch : (__tl_dyn-array i64)
    (array.make-array i64 2)))

(cfg
  compile-profile
  (define (compiler-tc-walk-now-ns) : i64
    (cfg
      windows
      0
      (let
        [addr : i64
          (unsafe
            (cast
              (ptr->int
                (ptr-cast
                  (__tl_array-data compiler-tc-walk-clock-scratch)
                  : (Ptr u8)))
              : i64))]
        [status : i64
          (unsafe
            (syscall 228 1 addr))]
        (if (< status 0)
          0
          (+
            (* (array-ref compiler-tc-walk-clock-scratch 0) 1000000000)
            (array-ref compiler-tc-walk-clock-scratch 1)))))))

