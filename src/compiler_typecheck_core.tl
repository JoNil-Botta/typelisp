        expected
        source
        sink)]
    ;; Outside a call argument a borrow keeps its own type, like the legacy
    ;; expected-type path.
    [(ast.AstExpr.Borrow mutable lifetime-id place-id)
      (tc-infer-selected-borrow
        ctx
        env
        mutable
        lifetime-id
        place-id
        false
        syntax
        source
        sink)]
    ;; A bare unsafe block (without a span) types like the legacy bare form:
    ;; inferred alone, then adapted to the context.
    [(ast.AstExpr.Unsafe exprs)
      (tc-selected-contextual-result
        ctx
        env
        expected
        (tc-infer-selected-unsafe
          ctx
          env
          (& exprs)
          syntax
          ast.AstMaybeType.No
          TcMaybeAstSourceSpan.No
          source
          sink))]
    [(ast.AstExpr.Cast inner-id ty-id)
      (tc-selected-contextual-result
        ctx
        env
        expected
        (tc-infer-selected-cast ctx env inner-id ty-id syntax source sink))]
    [(ast.AstExpr.PtrNull ty-id)
      (tc-selected-contextual-result
        ctx
        env
        expected
        (tc-infer-selected-ptr-null ctx ty-id syntax source sink))]
    [(ast.AstExpr.PtrNullCheck inner-id)
      (tc-selected-contextual-result
        ctx
        env
        expected
        (tc-infer-selected-pointer-unary
          ctx
          env
          3
          inner-id
          -1
          syntax
          source
          sink))]
    [(ast.AstExpr.PtrAddrOf place-id)
      (tc-selected-contextual-result
        ctx
        env
        expected
        (tc-infer-selected-ptr-addr-of ctx env place-id syntax source sink))]
    [(ast.AstExpr.PtrRead ptr-id)
      (tc-selected-contextual-result
        ctx
        env
        expected
        (tc-infer-selected-ptr-read ctx env ptr-id syntax source sink))]
    [(ast.AstExpr.PtrWrite ptr-id value-id)
      (tc-selected-contextual-result
        ctx
        env
        expected
        (tc-infer-selected-ptr-write ctx env ptr-id value-id syntax source sink))]
    [(ast.AstExpr.PtrOffset ptr-id offset-id)
      (tc-selected-contextual-result
        ctx
        env
        expected
        (tc-infer-selected-ptr-offset
          ctx
          env
          ptr-id
          offset-id
          syntax
          source
          sink))]
    [(ast.AstExpr.PtrCast ptr-id target-id)
      (tc-selected-contextual-result
        ctx
        env
        expected
        (tc-infer-selected-pointer-unary
          ctx
          env
          0
          ptr-id
          target-id
          syntax
          source
          sink))]
    [(ast.AstExpr.PtrToInt ptr-id)
      (tc-selected-contextual-result
        ctx
        env
        expected
        (tc-infer-selected-pointer-unary ctx env 1 ptr-id -1 syntax source sink))]
    [(ast.AstExpr.IntToPtr value-id target-id)
      (tc-selected-contextual-result
        ctx
        env
        expected
        (tc-infer-selected-pointer-unary
          ctx
          env
          2
          value-id
          target-id
          syntax
          source
          sink))]
    [(ast.AstExpr.Try inner-id)
      (tc-infer-selected-try ctx env inner-id syntax expected source sink)]
    [(ast.AstExpr.InArena arena-id body)
      (tc-infer-selected-in-arena
        ctx
        env
        arena-id
        body
        syntax
        expected
        source
        sink)]
    [(ast.AstExpr.WithRegion region body)
      (tc-infer-selected-with-region
        ctx
        env
        expr
        region
        body
        syntax
        expected
        source
        sink)]
    [(ast.AstExpr.WithScratch body)
      (tc-infer-selected-scratch
        ctx
        env
        expr
        -1
        (& body)
        syntax
        expected
        source
        sink)]
    [(ast.AstExpr.WithEscape scratch-id body)
      (tc-infer-selected-scratch
        ctx
        env
        expr
        scratch-id
        (& body)
        syntax
        expected
        source
        sink)]
    ;; A compile-time value is computed before the program runs: at run time
    ;; it is a fresh value with no operands.
    [(ast.AstExpr.Comptime _)
      (match (tc-infer-selected-legacy ctx env expr syntax expected)
        [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
        [(ResultTcType.Ok ty)
          (if (tc-selected-call-type-ok? ctx (tc-global-shared-view ty))
            (tc-selected-publish-nullary-variant ty syntax source sink)
            (tc-selected-unrepresented (ResultTcType.Ok ty) sink))])]
    [_
      (tc-selected-unrepresented
        (tc-infer-selected-legacy ctx env expr syntax expected)
        sink)]))

;; --- Unsafe blocks and macro expansions (#8449) ------------------------------
;; Mirrors `tc-unsafe-begin-list-scoped`: a fresh scope, the unused-unsafe
;; block marker, then the canonical sequence in the unsafe context.
(define (tc-infer-selected-unsafe
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [span : TcMaybeAstSourceSpan]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    [saved : TcTypeEnvScopedRuntimeSave
      (tc-type-env-scoped-runtime-enter-env! env)]
    [unused-unsafe : TcUnusedUnsafeState
      (tc-job-state-unused-unsafe (tc-context-job-state ctx))]
    [prev : i64 (tc-unused-unsafe-enter-block unused-unsafe span)]
    [result : (TcSelectedResult store lease intern bind)
      (tc-infer-selected-begin
        ctx
        (tc-enter-unsafe env)
        exprs
        syntax
        expected
        source
        sink)]
    (tc-unused-unsafe-restore-block! unused-unsafe prev)
    (tc-type-env-scoped-runtime-restore! saved)
    result))

;; A spanned form's position, or its parent's (`line`, `column`) when the
;; span is empty: a generated node keeps the location of the code it was
;; generated in.
(define (tc-selected-span-line [line : i64] [span : ast.AstSourceSpan]) : i64
  (if (> (ast.ast-source-span-start-line span) 0)
    (ast.ast-source-span-start-line span)
    line))

(define (tc-selected-span-column [column : i64] [span : ast.AstSourceSpan]) : i64
  (if (> (ast.ast-source-span-start-line span) 0)
    (ast.ast-source-span-start-col span)
    column))

;; Provenance inside an expansion: the invocation span locates nodes without
;; their own span, and the expansion frame is prepended to the frame list, so
;; the list reads innermost first.
(define (tc-selected-expansion-source
  [source : (& source ownership.OwnershipSource)]
  [span : ast.AstSourceSpan]
  [provenance-id : i64]
  [macro-name-id : i64]) : ownership.OwnershipSource
  (ownership.OwnershipSource
    (string.copy (& source.path))
    (tc-selected-span-line source.line span)
    (tc-selected-span-column source.column span)
    (str_cat.str-cat
      (string.int->string (macro-expansion-invocation-path-id provenance-id))
      "|"
      (string.int->string (ast.ast-source-span-start-line span))
      "|"
      (string.int->string (ast.ast-source-span-start-col span))
      "|"
      (string.int->string (ast.ast-source-span-end-line span))
      "|"
      (string.int->string (ast.ast-source-span-end-col span))
      "|"
      (string.int->string (macro-expansion-origin-path-id provenance-id))
      "|"
      (string.int->string macro-name-id)
      ";"
      (string.copy (& source.expansion)))))

;; The next `|`/`;`-terminated field of a frame list and its end index.
(define (tc-selected-frame-field-end [text : (& text str)] [start : i64]) : i64
  (let
    [index : i64 start]
    [count : i64 (string.string-length text)]
    (while (and
      (< index count)
      (!= (cast (string.string-ref text index) : i64) 124)
      (!= (cast (string.string-ref text index) : i64) 59))
      (set! index (+ index 1)))
    index))

;; Wrap a located message in each frame of `expansion`, innermost first, the
;; same nesting `tc-macro-expansion-result-with-frame` builds while an error
;; leaves each expansion.
(define (tc-selected-expansion-framed
  [expansion : (& expansion str)]
  [message : String]) : String
  (let
    [result : String message]
    [cursor : i64 0]
    [count : i64 (string.string-length expansion)]
    (while (< cursor count)
      (let
        [fields : (__tl_dyn-array i64) (__tl_make-array i64 7)]
        [field : i64 0]
        (while (< field 7)
          (let
            [end : i64 (tc-selected-frame-field-end expansion cursor)]
            (set!
              (array-ref fields field)
              (string.>int (string.substring expansion cursor (- end cursor))))
            (set! cursor (+ end 1))
            (set! field (+ field 1))))
        (set!
          result
          (tc-macro-framed-error
            (array-ref fields 0)
            (ast.ast-source-span
              (array-ref fields 1)
              (array-ref fields 2)
              (array-ref fields 3)
              (array-ref fields 4))
            (array-ref fields 5)
            (array-ref fields 6)
            result))))
    result))

;; --- Casts and raw pointer primitives (#8449) -------------------------------
;;
;; Each producer mirrors its legacy typing exactly: the same unsafe admission,
;; operand order, expected types and diagnostics. Value operands are selected
;; once; a place addressed by `ptr-addr-of` is never evaluated, so only places
;; whose typing reads nothing (a name or a field chain on one) are represented.
(defenum TcSelectedChildren
  (Some (__tl_dyn-array typed.TypedOccurrenceId))
  (No))

(define (tc-selected-children0) : TcSelectedChildren
  (TcSelectedChildren.Some (tc-selected-no-occurrences)))

(define (tc-selected-children1 [first : TcSelectedOccurrence]) : TcSelectedChildren
  (match first
    [(TcSelectedOccurrence.Selected id)
      (let
        [ids : (__tl_dyn-array typed.TypedOccurrenceId)
          (__tl_make-array typed.TypedOccurrenceId 1)]
        (set! (array-ref ids 0) id)
        (TcSelectedChildren.Some ids))]
    [(TcSelectedOccurrence.Unrepresented) TcSelectedChildren.No]))

(define (tc-selected-children2
  [first : TcSelectedOccurrence]
  [second : TcSelectedOccurrence]) : TcSelectedChildren
  (match first
    [(TcSelectedOccurrence.Selected left)
      (match second
        [(TcSelectedOccurrence.Selected right)
          (let
            [ids : (__tl_dyn-array typed.TypedOccurrenceId)
              (__tl_make-array typed.TypedOccurrenceId 2)]
            (set! (array-ref ids 0) left)
            (set! (array-ref ids 1) right)
            (TcSelectedChildren.Some ids))]
        [(TcSelectedOccurrence.Unrepresented) TcSelectedChildren.No])]
    [(TcSelectedOccurrence.Unrepresented) TcSelectedChildren.No]))

(define (tc-selected-represented? [child : (& child TcSelectedOccurrence)]) : bool
  (match child
    [(TcSelectedOccurrence.Selected _) true]
    [(TcSelectedOccurrence.Unrepresented) false]))

(define (tc-selected-publish-primitive
  [result : ResultTcType]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [primitive : typed.TypedPrimitive]
  [children : TcSelectedChildren]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match children
    [(TcSelectedChildren.Some ids)
      (tc-selected-publish
        result
        syntax
        source
        (typed.TypedOperation.Primitive primitive)
        ids
        sink)]
    [(TcSelectedChildren.No) (tc-selected-unrepresented result sink)]))

(define (tc-infer-selected-cast
  [ctx : TcContext]
  [env : TcTypeEnv]
  [inner-id : i64]
  [ty-id : i64]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-result-id
    ctx
    env
    (& syntax)
    inner-id
    ast.AstMaybeType.No
    (tc-global-shared-view source)
    sink)
    [(TcSelectedResult.Err message next) (TcSelectedResult.Err message next)]
    [(TcSelectedResult.Ok inner-ty child next)
      (let
        [target-ty : ast.AstType
          (tc-resolve-type ctx (tc-context-type-get ctx ty-id))]
        (cond
          [(and
              (tc-castable-type? (tc-global-shared-view inner-ty))
              (tc-castable-type? (tc-global-shared-view target-ty)))
            (tc-selected-publish-primitive
              (ResultTcType.Ok target-ty)
              syntax
              source
              typed.TypedPrimitive.Cast
              (tc-selected-children1 child)
              next)]
          ;; A function-to-integer cast reads a function value's address (an
          ;; unsafe read of the callable, which it does not move).
          [(tc-function-to-integer-cast?
              inner-ty
              (tc-global-shared-view target-ty))
            (match (tc-require-unsafe ctx env "function-to-integer cast")
              [(ResultTcUnit.Ok)
                (tc-selected-publish-primitive
                  (ResultTcType.Ok target-ty)
                  syntax
                  source
                  typed.TypedPrimitive.Cast
                  (tc-selected-children1 child)
                  next)]
              [(ResultTcUnit.Err message) (TcSelectedResult.Err message next)])]
          [else
            (TcSelectedResult.Err
              (tc-kind-message
                (cdiag.CompilerTypecheckKind.TypeMismatch)
                "typecheck: cast requires scalar numeric (integer/char/float) source and target")
              next)]))]))

;; The pointer operand of a raw primitive: no expected type, exactly like the
;; legacy `tc-expr` operand.
(define (tc-infer-selected-pointer-operand
  [ctx : TcContext]
  [env : TcTypeEnv]
  [id : i64]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (tc-infer-selected-id ctx env id ast.AstMaybeType.No source sink))

(define (tc-infer-selected-ptr-read
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ptr-id : i64]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-require-unsafe ctx env "ptr-read")
    [(ResultTcUnit.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcUnit.Ok)
      (match (tc-infer-selected-pointer-operand
        ctx
        env
        ptr-id
        (tc-global-shared-view source)
        sink)
        [(TcSelectedResult.Err message next)
          (TcSelectedResult.Err message next)]
        [(TcSelectedResult.Ok ptr-ty child next)
          (match (tc-raw-pointer-elem
            (tc-resolve-type ctx ptr-ty)
            "typecheck: ptr-read requires a raw pointer operand")
            [(ResultTcType.Err message) (TcSelectedResult.Err message next)]
            [(ResultTcType.Ok elem)
              (tc-selected-publish-primitive
                (match (tc-opaque-by-value-ok
                  ctx
                  (tc-resolve-type ctx (tc-global-shared-view elem))
                  "cannot read through a pointer to the")
                  [(ResultTcUnit.Err message) (ResultTcType.Err message)]
                  [(ResultTcUnit.Ok)
                    (ResultTcType.Ok (tc-resolve-type ctx elem))])
                syntax
                source
                typed.TypedPrimitive.PtrRead
                (tc-selected-children1 child)
                next)])])]))

(define (tc-infer-selected-ptr-write
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ptr-id : i64]
  [value-id : i64]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-require-unsafe ctx env "ptr-write!")
    [(ResultTcUnit.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcUnit.Ok)
      (match (tc-infer-selected-pointer-operand
        ctx
        env
        ptr-id
        (tc-global-shared-view source)
        sink)
        [(TcSelectedResult.Err message next)
          (TcSelectedResult.Err message next)]
        [(TcSelectedResult.Ok ptr-ty ptr-child next)
          (match (tc-mut-pointer-elem
            (tc-resolve-type ctx ptr-ty)
            "typecheck: ptr-write! requires a MutPtr pointer operand")
            [(ResultTcType.Err message) (TcSelectedResult.Err message next)]
            [(ResultTcType.Ok elem)
              (match (tc-opaque-by-value-ok
                ctx
                (tc-resolve-type ctx (tc-global-shared-view elem))
                "cannot write through a pointer to the")
                [(ResultTcUnit.Err message) (TcSelectedResult.Err message next)]
                [(ResultTcUnit.Ok)
                  (let
                    [represented? : bool
                      (tc-selected-represented? (& ptr-child))]
                    (match (tc-infer-selected-sequence-child
                      ctx
                      env
                      value-id
                      ;; An element read through a reference is written as it
                      ;; is read, bitwise, as on main: relocation loops move an
                      ;; array's elements through its backing this way.
                      (match (ast.ast-expr-unspan-with-segment-bases
                        (tc-context-expr-segment-bases ctx)
                        (& (tc-context-expr-get ctx value-id)))
                        [(ast.AstExpr.ArrayRef _ _) ast.AstMaybeType.No]
                        [_
                          (ast.AstMaybeType.Some
                            (tc-resolve-type ctx (tc-global-shared-view elem)))])
                      (tc-global-shared-view source)
                      represented?
                      next)
                      [(TcSelectedResult.Err message after)
                        (TcSelectedResult.Err message after)]
                      [(TcSelectedResult.Ok value-ty value-child after)
                        (match (tc-expect
                          value-ty
                          (tc-resolve-type ctx elem)
                          "typecheck: ptr-write! value type mismatch")
                          [(ResultTcUnit.Err message)
                            (TcSelectedResult.Err message after)]
                          [(ResultTcUnit.Ok)
                            (tc-selected-publish-primitive
                              (ResultTcType.Ok (ast.AstType.Unit))
                              syntax
                              source
                              typed.TypedPrimitive.PtrWrite
                              (tc-selected-children2 ptr-child value-child)
                              after)])]))])])])]))

(define (tc-infer-selected-ptr-offset
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ptr-id : i64]
  [offset-id : i64]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-require-unsafe ctx env "ptr-offset")
    [(ResultTcUnit.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcUnit.Ok)
      (match (tc-infer-selected-pointer-operand
        ctx
        env
        ptr-id
        (tc-global-shared-view source)
        sink)
        [(TcSelectedResult.Err message next)
          (TcSelectedResult.Err message next)]
        [(TcSelectedResult.Ok ptr-ty ptr-child next)
          (let
            [resolved-ptr : ast.AstType (tc-resolve-type ctx ptr-ty)]
            (match (tc-raw-pointer-elem
              (tc-global-shared-view resolved-ptr)
              "typecheck: ptr-offset requires a raw pointer operand")
              [(ResultTcType.Err message) (TcSelectedResult.Err message next)]
              [(ResultTcType.Ok elem)
                (match (tc-opaque-by-value-ok
                  ctx
                  (tc-global-shared-view elem)
                  "cannot offset a pointer to the")
                  [(ResultTcUnit.Err message)
                    (TcSelectedResult.Err message next)]
                  [(ResultTcUnit.Ok)
                    (let
                      [represented? : bool
                        (tc-selected-represented? (& ptr-child))]
                      (match (tc-infer-selected-sequence-child
                        ctx
                        env
                        offset-id
                        (ast.AstMaybeType.Some (ast.AstType.I64))
                        (tc-global-shared-view source)
                        represented?
                        next)
                        [(TcSelectedResult.Err message after)
                          (TcSelectedResult.Err message after)]
                        [(TcSelectedResult.Ok offset-ty offset-child after)
                          (if (tc-integer-type? offset-ty)
                            (tc-selected-publish-primitive
                              (ResultTcType.Ok resolved-ptr)
                              syntax
                              source
                              typed.TypedPrimitive.PtrOffset
                              (tc-selected-children2 ptr-child offset-child)
                              after)
                            (TcSelectedResult.Err
                              "typecheck: ptr-offset requires an integer offset"
                              after))]))])]))])]))

;; The single-operand pointer conversions share a shape: an unsafe admission,
;; an optional target check that precedes operand typing, the operand, then an
;; operand check. `kind` selects ptr-cast (0), ptr->int (1), int->ptr (2) or
;; ptr-null? (3), whose legacy null check needs no unsafe context.
(define (tc-infer-selected-pointer-unary
  [ctx : TcContext]
  [env : TcTypeEnv]
  [kind : i64]
  [operand-id : i64]
  [target-id : i64]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    [name : String
      (cond
        [(= kind 0) "ptr-cast"]
        [(= kind 1) "ptr->int"]
        [(= kind 2) "int->ptr"]
        [else "ptr-null?"])]
    [admitted : ResultTcUnit
      (if (= kind 3)
        ResultTcUnit.Ok
        (tc-require-unsafe ctx env name))]
    (match admitted
      [(ResultTcUnit.Err message) (TcSelectedResult.Err message sink)]
      [(ResultTcUnit.Ok)
        (let
          [target : ast.AstType
            (if (or (= kind 0) (= kind 2))
              (tc-resolve-type ctx (ast.ty-node-get target-id))
              ast.AstType.Unit)]
          (if (and
            (or (= kind 0) (= kind 2))
            (not (tc-raw-pointer-type? (tc-global-shared-view target))))
            (TcSelectedResult.Err
              (if (= kind 0)
                "typecheck: ptr-cast target must be a raw pointer type"
                "typecheck: int->ptr target must be a raw pointer type")
              sink)
            (match (tc-infer-selected-pointer-operand
              ctx
              env
              operand-id
              (tc-global-shared-view source)
              sink)
              [(TcSelectedResult.Err message next)
                (TcSelectedResult.Err message next)]
              [(TcSelectedResult.Ok operand-ty child next)
                (let
                  [result : ResultTcType
                    (cond
                      [(= kind 0)
                        (if (tc-raw-pointer-type?
                          (tc-resolve-type ctx operand-ty))
                          (ResultTcType.Ok target)
                          (ResultTcType.Err
                            "typecheck: ptr-cast requires a raw pointer operand"))]
                      [(= kind 1)
                        (if (tc-raw-pointer-type?
                          (tc-resolve-type ctx operand-ty))
                          (ResultTcType.Ok (ast.AstType.U64))
                          (ResultTcType.Err
                            "typecheck: ptr->int requires a raw pointer operand"))]
                      [(= kind 2)
                        (if (tc-integer-type? operand-ty)
                          (ResultTcType.Ok target)
                          (ResultTcType.Err
                            "typecheck: int->ptr requires an integer operand"))]
                      [else
                        (match (tc-type-strip-region operand-ty)
                          [(ast.AstType.CFunc _ _)
                            (ResultTcType.Ok (ast.AstType.Bool))]
                          [(ast.AstType.Ptr _)
                            (ResultTcType.Ok (ast.AstType.Bool))]
                          [(ast.AstType.MutPtr _)
                            (ResultTcType.Ok (ast.AstType.Bool))]
                          [_
                            (ResultTcType.Err
                              "typecheck: ptr-null? requires a raw pointer operand")])])]
                  (tc-selected-publish-primitive
                    result
                    syntax
                    source
                    (cond
                      [(= kind 0) typed.TypedPrimitive.PtrCast]
                      [(= kind 1) typed.TypedPrimitive.PtrToInt]
                      [(= kind 2) typed.TypedPrimitive.IntToPtr]
                      [else typed.TypedPrimitive.PtrNullCheck])
                    (tc-selected-children1 child)
                    next))])))])))

;; A name or a field chain rooted in one: typing it evaluates nothing.
(define (tc-selected-addressable-place? [ctx : TcContext] [place : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan (& place))
    [(ast.AstExpr.Var _) true]
    [(ast.AstExpr.StructGet receiver _)
      (tc-selected-addressable-place? ctx (tc-context-expr-get ctx receiver))]
    [(ast.AstExpr.TupleRef receiver _)
      (tc-selected-addressable-place? ctx (tc-context-expr-get ctx receiver))]
    ;; An element's address evaluates its index (`tc-selected-address-indices`).
    [(ast.AstExpr.ArrayRef receiver _)
      (tc-selected-addressable-place? ctx (tc-context-expr-get ctx receiver))]
    [(ast.AstExpr.MacroExpansion expanded _ _)
      (tc-selected-addressable-place? ctx (tc-context-expr-get ctx expanded))]
    [_ false]))

;; The index expressions an addressable place's element steps evaluate, outer
;; receiver first.
(define (tc-selected-address-indices
  [ctx : TcContext]
  [place : ast.AstExpr]
  [out : (&mut out (__tl_dyn-array i64))]) : unit
  (match (ast.ast-expr-unspan (& place))
    [(ast.AstExpr.StructGet receiver _)
      (tc-selected-address-indices ctx (tc-context-expr-get ctx receiver) out)]
    [(ast.AstExpr.TupleRef receiver _)
      (tc-selected-address-indices ctx (tc-context-expr-get ctx receiver) out)]
    [(ast.AstExpr.ArrayRef receiver index)
      (tc-selected-address-indices ctx (tc-context-expr-get ctx receiver) out)
      (tc-selected-i64s-push! (&mut out) index)]
    [(ast.AstExpr.MacroExpansion expanded _ _)
      (tc-selected-address-indices ctx (tc-context-expr-get ctx expanded) out)]
    [_ unit]))

(define (tc-infer-selected-ptr-addr-of
  [ctx : TcContext]
  [env : TcTypeEnv]
  [place-id : i64]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-normalize-dotted-local-field-node! ctx env place-id)
    [(ResultTcUnit.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcUnit.Ok)
      (let
        [place : ast.AstExpr (tc-context-expr-get ctx place-id)]
        [result : ResultTcType
          (tc-ptr-addr-of-expr ctx env (tc-global-shared-view place))]
        [indices : (__tl_dyn-array i64) (tc-selected-no-i64s)]
        (if (not
          (tc-selected-addressable-place? ctx (tc-global-shared-view place)))
          (tc-selected-publish-primitive
            result
            syntax
            source
            typed.TypedPrimitive.PtrAddrOf
            TcSelectedChildren.No
            sink)
          (begin
            (tc-selected-address-indices
              ctx
              (tc-global-shared-view place)
              (&mut indices))
            (if (= (array-length indices) 0)
              (tc-selected-publish-primitive
                result
                syntax
                source
                typed.TypedPrimitive.PtrAddrOf
                (tc-selected-children0)
                sink)
              ;; An element's address reads its indices first (plain integers);
              ;; the raw address itself accesses nothing.
              (tc-selected-address-of-element
                ctx
                env
                result
                syntax
                source
                indices
                sink)))))]))

(define (tc-selected-address-of-element
  [ctx : TcContext]
  [env : TcTypeEnv]
  [result : ResultTcType]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [indices : (__tl_dyn-array i64)]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match result
    [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcType.Ok ty)
      (tc-selected-address-of-element-at
        ctx
        env
        ty
        syntax
        source
        (& indices)
        0
        (tc-selected-no-occurrences)
        sink)]))

;; The indices from `index` on, then the address, in one sequence.
(define (tc-selected-address-of-element-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : ast.AstType]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [indices : (& indices (__tl_dyn-array i64))]
  [index : i64]
  [children : (__tl_dyn-array typed.TypedOccurrenceId)]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (if (< index (array-length indices))
    (match (tc-infer-selected-id
      ctx
      env
      (array-ref indices index)
      ast.AstMaybeType.No
      (ownership.ownership-source-copy (& source))
      sink)
      [(TcSelectedResult.Err message next) (TcSelectedResult.Err message next)]
      [(TcSelectedResult.Ok _ occurrence next)
        (match occurrence
          [(TcSelectedOccurrence.Unrepresented)
            (tc-selected-unrepresented (ResultTcType.Ok ty) next)]
          [(TcSelectedOccurrence.Selected id)
            (tc-selected-occurrences-push! (&mut children) id)
            (tc-selected-address-of-element-at
              ctx
              env
              ty
              syntax
              source
              indices
              (+ index 1)
              children
              next)])])
    (match (tc-selected-publish
      (ResultTcType.Ok (tc-global-shared-view ty))
      typed.TypedSyntax.Generated
      (ownership.ownership-source-copy (& source))
      (typed.TypedOperation.Primitive typed.TypedPrimitive.PtrAddrOf)
      (tc-selected-no-occurrences)
      sink)
      [(TcSelectedResult.Err message after)
        (TcSelectedResult.Err message after)]
      [(TcSelectedResult.Ok _ address after)
        (match address
          [(TcSelectedOccurrence.Unrepresented)
            (tc-selected-unrepresented (ResultTcType.Ok ty) after)]
          [(TcSelectedOccurrence.Selected address-id)
            (tc-selected-occurrences-push! (&mut children) address-id)
            (match (tc-selected-publish
              (ResultTcType.Ok (tc-global-shared-view ty))
              syntax
              source
              typed.TypedOperation.Sequence
              children
              after)
              [(TcSelectedResult.Err message last)
                (TcSelectedResult.Err message last)]
              [(TcSelectedResult.Ok _ whole last)
                (TcSelectedResult.Ok ty whole last)])])])))

(define (tc-infer-selected-ptr-null
  [ctx : TcContext]
  [ty-id : i64]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    [resolved : ast.AstType (tc-resolve-type ctx (ast.ty-node-get ty-id))]
    [result : ResultTcType
      (match (tc-global-shared-view resolved)
        [(ast.AstType.CFunc _ mode)
          (if (ast.ast-c-function-mode-nullable? mode)
            (ResultTcType.Ok resolved)
            (ResultTcType.Err
              "typecheck: ptr-null cannot create a non-null C function pointer"))]
        [(ast.AstType.Ptr _) (ResultTcType.Ok resolved)]
        [(ast.AstType.MutPtr _) (ResultTcType.Ok resolved)]
        [_
          (ResultTcType.Err
            "typecheck: ptr-null requires a pointer type, e.g. (ptr-null : (Ptr i64))")])]
    (tc-selected-publish-primitive
      result
      syntax
      source
      typed.TypedPrimitive.PtrNull
      (tc-selected-children0)
      sink)))

;; --- Borrows (#8449) ----------------------------------------------------------
;;
;; Typing is the legacy `tc-borrow-expr-with-policy`, including the call
;; argument policy that admits `(&mut local)` of a by-value local. The child
;; forms the borrowed place: a binder, or a field of a binder or of a
;; reference parameter's referent (a reborrow of its entry loan).
(define (tc-infer-selected-borrow
  [ctx : TcContext]
  [env : TcTypeEnv]
  [mutable : bool]
  [lifetime-id : i64]
  [place-id : i64]
  [allow-mut-by-value-borrow : bool]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-normalize-dotted-local-field-node! ctx env place-id)
    [(ResultTcUnit.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcUnit.Ok)
      (let
        [place : ast.AstExpr (tc-context-expr-get ctx place-id)]
        (match (tc-borrow-expr-with-policy
          ctx
          (tc-context-expr-bases ctx)
          env
          mutable
          (ast.ast-borrow-lifetime-from-id lifetime-id)
          place
          allow-mut-by-value-borrow
          (TcBorrowSource.Selected source.line source.column))
          [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
          [(ResultTcType.Ok ty)
            ;; A mutable borrow of a view binder borrows through the view.
            (match (if mutable
              (tc-selected-view-receiver
                ctx
                env
                (tc-global-shared-view source)
                (tc-infer-selected-place-id
                  ctx
                  env
                  place-id
                  (tc-global-shared-view source)
                  sink))
              (tc-infer-selected-place-id
                ctx
                env
                place-id
                (tc-global-shared-view source)
                sink))
              [(TcSelectedPlaceResult.Err message next)
                (TcSelectedResult.Err message next)]
              [(TcSelectedPlaceResult.Ok place-type selected next)
                (match selected
                  [(TcSelectedPlace.Unrepresented)
                    (tc-selected-unrepresented (ResultTcType.Ok ty) next)]
                  [(TcSelectedPlace.Selected id indices)
                    (if (tc-selected-borrow-through-reference?
                      ctx
                      (tc-global-shared-view place-type)
                      (tc-global-shared-view ty))
                      ;; Borrowing a reference for its referent reborrows the
                      ;; referent (`&*r`): the new loan is a child of the
                      ;; reference's own, so a write through the reference
                      ;; while the reborrow is live conflicts.
                      (match (tc-selected-place-project
                        (tc-selected-referent
                          ctx
                          (tc-resolve-type
                            ctx
                            (tc-global-shared-view place-type)))
                        (tc-selected-referent
                          ctx
                          (tc-resolve-type
                            ctx
                            (tc-global-shared-view place-type)))
                        (TcSelectedPlace.Selected id indices)
                        typed.TypedProjectionKind.Deref
                        (tc-global-shared-view source)
                        next)
                        [(TcSelectedPlaceResult.Err message after)
                          (TcSelectedResult.Err message after)]
                        [(TcSelectedPlaceResult.Ok _ derefed after)
                          (match derefed
                            [(TcSelectedPlace.Selected
                                referent-id
                                referent-indices)
                              (tc-selected-publish-borrow
                                ty
                                mutable
                                referent-id
                                referent-indices
                                syntax
                                source
                                after)]
                            [(TcSelectedPlace.Unrepresented)
                              (tc-selected-unrepresented
                                (ResultTcType.Ok ty)
                                after)])])
                      (tc-selected-publish-borrow
                        ty
                        mutable
                        id
                        indices
                        syntax
                        source
                        next))])])]))]))

;; A borrow of a reference-typed place whose result refers to the reference's
;; referent rather than to the reference itself.
(define (tc-selected-borrow-through-reference?
  [ctx : TcContext]
  [place-type : ast.AstType]
  [ty : ast.AstType]) : bool
  (let
    [place : ast.AstType
      (tc-type-strip-region (tc-resolve-type ctx place-type))]
    [result : ast.AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
    (match (& place)
      [(ast.AstType.Ref _ _)
        (tc-selected-borrow-of-referent?
          ctx
          (tc-global-shared-view place)
          result)]
      [(ast.AstType.MutRef _ _)
        (tc-selected-borrow-of-referent?
          ctx
          (tc-global-shared-view place)
          result)]
      [_ false])))

(define (tc-selected-borrow-of-referent?
  [ctx : TcContext]
  [place : ast.AstType]
  [result : ast.AstType]) : bool
  (let
    [referent : ast.AstType
      (tc-resolve-type
        ctx
        (tc-selected-referent ctx (tc-global-shared-view place)))]
    [target : ast.AstType
      (tc-resolve-type
        ctx
        (tc-selected-referent ctx (tc-global-shared-view result)))]
    (and
      (not (tc-selected-same-type? (tc-global-shared-view target) place))
      (tc-selected-same-type?
        (tc-type-strip-region target)
        (tc-type-strip-region referent)))))

;; Forming a place evaluates its index operands in order. One that diverges is
;; an exit, as a diverging operand of any form (`tc-selected-flow-never!`): the
;; place is never formed and its consumer never runs, so the consumer is the
;; sequence of the indices through that one. The count of those indices, or 0.
(define (tc-selected-place-exit!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [indices : (& indices (__tl_dyn-array typed.TypedOccurrenceId))]) : TcSelectedIndexCut
  (let
    [index : i64 0]
    [cut : i64 0]
    (while (and (= cut 0) (< index (array-length indices)))
      (match (tc-selected-child-never! store lease indices index)
        [(TcSelectedBoolResult.Err error)
          (return (TcSelectedIndexCut.Err error))]
        [(TcSelectedBoolResult.Ok never?) (when never? (set! cut (+ index 1)))])
      (set! index (+ index 1)))
    (TcSelectedIndexCut.Ok cut)))

(defenum TcSelectedIndexCut
  (Ok i64)
  (Err typed.TypedError))

;; The consumer of a place whose formation exits after `cut` indices.
(define (tc-selected-place-exit-publish
  [result : ResultTcType]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [indices : (& indices (__tl_dyn-array typed.TypedOccurrenceId))]
  [cut : i64]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    [prefix : (__tl_dyn-array typed.TypedOccurrenceId)
      (__tl_make-array typed.TypedOccurrenceId cut)]
    [index : i64 0]
    (while (< index cut)
      (set!
        (array-ref prefix index)
        (typed.TypedOccurrenceId
          (typed.typed-handle-copy (& (array-ref indices index).handle))))
      (set! index (+ index 1)))
    (tc-selected-publish
      result
      syntax
      source
      typed.TypedOperation.Sequence
      prefix
      sink)))

(define (tc-selected-publish-borrow
  [ty : ast.AstType]
  [mutable : bool]
  [id : typed.TypedPlaceId]
  [indices : (__tl_dyn-array typed.TypedOccurrenceId)]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match sink
    [(TcSelectedSink.Query)
      (tc-selected-unrepresented (ResultTcType.Ok ty) TcSelectedSink.Query)]
    [(TcSelectedSink.Capture store lease bindings)
      (if (not (ownership.ownership-source-valid? (& source)))
        (tc-selected-unrepresented
          (ResultTcType.Ok ty)
          (TcSelectedSink.Capture store lease bindings))
        (let
          [_exit : unit
            (match (tc-selected-place-exit! store lease (& indices))
              [(TcSelectedIndexCut.Err error)
                (return (tc-selected-failed error store lease bindings))]
              [(TcSelectedIndexCut.Ok cut)
                (when
                  (> cut 0)
                  (return
                    (tc-selected-place-exit-publish
                      (ResultTcType.Ok ty)
                      syntax
                      source
                      (& indices)
                      cut
                      (TcSelectedSink.Capture store lease bindings))))])]
          [type-id : typed.TypedTypeId
            (match (typed.typed-place-get! store lease id)
              [(typed.TypedPlaceView.Ok row)
                (typed.TypedTypeId
                  (typed.typed-handle-copy (& row.type.handle)))]
              [(typed.TypedPlaceView.Err error)
                (return (tc-selected-failed error store lease bindings))])]
          [origin : typed.TypedOriginId
            (match (typed.typed-origin-add!
              store
              lease
              (tc-global-shared-view source))
              [(typed.TypedOriginResult.Ok value) value]
              [(typed.TypedOriginResult.Err error)
                (return (tc-selected-failed error store lease bindings))])]
          [formation : typed.TypedOccurrenceId
            (match (typed.typed-occurrence-add!
              store
              lease
              type-id
              syntax
              origin
              (typed.TypedOperation.FormPlace id)
              (& indices))
              [(typed.TypedOccurrenceResult.Ok value) value]
              [(typed.TypedOccurrenceResult.Err error)
                (return (tc-selected-failed error store lease bindings))])]
          [children : (__tl_dyn-array typed.TypedOccurrenceId)
            (__tl_make-array typed.TypedOccurrenceId 1)]
          (set! (array-ref children 0) formation)
          (tc-selected-publish
            (ResultTcType.Ok ty)
            syntax
            source
            (typed.TypedOperation.Borrow mutable)
            children
            (TcSelectedSink.Capture store lease bindings))))]))

;; A top-level `(&mut place)` call argument, possibly spanned, typed under the
;; call-argument policy inside its own selected attempt. Returns No for any
;; other argument.
(defenum TcSelectedMutBorrowArg
  (Some i64 i64 i64 TcMaybeAstSourceSpan)
  (No))

(define (tc-selected-mut-borrow-arg [ctx : TcContext] [arg : ast.AstExpr]) : TcSelectedMutBorrowArg
  (match (tc-global-shared-view arg)
    [(ast.AstExpr.Spanned inner-id span)
      (match (tc-context-expr-get ctx inner-id)
        [(ast.AstExpr.Borrow true lifetime-id place-id)
          (TcSelectedMutBorrowArg.Some
            inner-id
            lifetime-id
            place-id
            (TcMaybeAstSourceSpan.Some span))]
        [_ TcSelectedMutBorrowArg.No])]
    [(ast.AstExpr.Borrow true lifetime-id place-id)
      (TcSelectedMutBorrowArg.Some
        -1
        lifetime-id
        place-id
        TcMaybeAstSourceSpan.No)]
    [_ TcSelectedMutBorrowArg.No]))

(define (tc-infer-selected-mut-borrow-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg-id : i64]
  [inner-id : i64]
  [lifetime-id : i64]
  [place-id : i64]
  [span : TcMaybeAstSourceSpan]
  [source : ownership.OwnershipSource]
  [represented? : bool]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    [located : ownership.OwnershipSource
      (match span
        [(TcMaybeAstSourceSpan.Some at)
          (ownership.OwnershipSource
            (string.copy (& source.path))
            (ast.ast-source-span-start-line at)
            (ast.ast-source-span-start-col at)
            (string.copy (& source.expansion)))]
        [(TcMaybeAstSourceSpan.No) source])]
    [syntax : typed.TypedSyntax
      (typed.TypedSyntax.Source
        (if (>= inner-id 0)
          inner-id
          arg-id))]
    [result : (TcSelectedResult store lease intern bind)
      (if (not represented?)
        (tc-selected-unrepresented
          (tc-selected-project
            (tc-infer-selected-borrow
              ctx
              env
              true
              lifetime-id
              place-id
              true
              syntax
              located
              TcSelectedSink.Query))
          sink)
        (match sink
          [(TcSelectedSink.Query)
            (tc-infer-selected-borrow
              ctx
              env
              true
              lifetime-id
              place-id
              true
              syntax
              located
              TcSelectedSink.Query)]
          [(TcSelectedSink.Capture store lease bindings)
            (match (typed.typed-attempt-begin!
              store
              lease
              typed.TypedMode.Executable)
              [(typed.TypedAttemptResult.Err error)
                (tc-selected-failed error store lease bindings)]
              [(typed.TypedAttemptResult.Ok attempt)
                (tc-selected-attempt-finish
                  attempt
                  bindings.len
                  (tc-infer-selected-borrow
                    ctx
                    env
                    true
                    lifetime-id
                    place-id
                    true
                    syntax
                    located
                    (TcSelectedSink.Capture store lease bindings)))])]))]
    (match span
      [(TcMaybeAstSourceSpan.Some at)
        (match result
          [(TcSelectedResult.Err message next)
            (tc-selected-unrepresented
              (tc-locate-spanned-error-with-context
                ctx
                env
                (tc-context-expr-get ctx inner-id)
                at
                message)
              next)]
          [(TcSelectedResult.Ok ty occurrence next)
            (TcSelectedResult.Ok ty occurrence next)])]
      [(TcMaybeAstSourceSpan.No) result])))

;; --- Match (#8449) ------------------------------------------------------------
;;
;; Typing is the legacy one: `tc-bind-match-pattern` binds each arm's names,
;; arms merge with `tc-merge-branch-type`, and the reachability and
;; exhaustiveness checks are shared. A match whose scrutinee, patterns or arm
;; join leave the subset is typed by the legacy path as a whole, so its result
;; and diagnostics are the legacy ones. By value, the scrutinee is a place (a
;; place expression, or a synthetic binder holding its value) and every
;; pattern node forms its position's place: payload fields are `Payload`
;; projections, so binding moves a field out alone. Through a shared
;; reference to an enum, binders are references derived from the scrutinee.
(defenum TcSelectedPatternResult
  (Ok typed.TypedOccurrenceId)
  (Unsupported)
  (Err String))

;; The next stack slot a pattern binder takes (legacy binds in pattern order).
(defstruct TcSelectedPatternCursor
  (slot i64)
  ;; A binding or-pattern's later candidate binds the first candidate's
  ;; binders by name, from these slots; -1 otherwise.
  (shared-start i64)
  (shared-end i64))

(defenum TcSelectedMaybePlace
  (Some typed.TypedPlaceId)
  (No))

(define (tc-selected-pattern-node!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [ty : ast.AstType]
  [kind : typed.TypedPattern]
  [children : (__tl_dyn-array typed.TypedOccurrenceId)]
  [source : (& source ownership.OwnershipSource)]) : TcSelectedPatternResult
  (let
    [type-id : typed.TypedTypeId
      (match (typed.typed-type-add! store lease ty)
        [(typed.TypedTypeIdResult.Ok id) id]
        [(typed.TypedTypeIdResult.Err error)
          (return (TcSelectedPatternResult.Err (tc-selected-error error)))])]
    [origin : typed.TypedOriginId
      (match (typed.typed-origin-add!
        store
        lease
        (ownership.ownership-source-copy source))
        [(typed.TypedOriginResult.Ok id) id]
        [(typed.TypedOriginResult.Err error)
          (return (TcSelectedPatternResult.Err (tc-selected-error error)))])]
    (match (typed.typed-occurrence-add!
      store
      lease
      type-id
      typed.TypedSyntax.Generated
      origin
      (typed.TypedOperation.Pattern kind)
      (& children))
      [(typed.TypedOccurrenceResult.Ok id) (TcSelectedPatternResult.Ok id)]
      [(typed.TypedOccurrenceResult.Err error)
        (TcSelectedPatternResult.Err (tc-selected-error error))])))

;; The formation of a pattern position (no position in a borrowed match).
(define (tc-selected-position-children!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [position : (& position TcSelectedMaybePlace)]
  [source : (& source ownership.OwnershipSource)]) : TcSelectedPatternChildren
  (let
    [children : (__tl_dyn-array typed.TypedOccurrenceId)
      (tc-selected-no-occurrences)]
    (match position
      [(TcSelectedMaybePlace.No) (TcSelectedPatternChildren.Ok children)]
      [(TcSelectedMaybePlace.Some place)
        (let
          [type-id : typed.TypedTypeId
            (match (typed.typed-place-get!
              store
              lease
              (typed.TypedPlaceId (typed.typed-handle-copy (& place.handle))))
              [(typed.TypedPlaceView.Ok row)
                (typed.TypedTypeId
                  (typed.typed-handle-copy (& row.type.handle)))]
              [(typed.TypedPlaceView.Err error)
                (return
                  (TcSelectedPatternChildren.Err (tc-selected-error error)))])]
          [origin : typed.TypedOriginId
            (match (typed.typed-origin-add!
              store
              lease
              (ownership.ownership-source-copy source))
              [(typed.TypedOriginResult.Ok id) id]
              [(typed.TypedOriginResult.Err error)
                (return
                  (TcSelectedPatternChildren.Err (tc-selected-error error)))])]
          [empty : (__tl_dyn-array typed.TypedOccurrenceId)
            (tc-selected-no-occurrences)]
          (match (typed.typed-occurrence-add!
            store
            lease
            type-id
            typed.TypedSyntax.Generated
            origin
            (typed.TypedOperation.FormPlace
              (typed.TypedPlaceId (typed.typed-handle-copy (& place.handle))))
            (& empty))
            [(typed.TypedOccurrenceResult.Ok id)
              (tc-selected-occurrences-push! (&mut children) id)
              (TcSelectedPatternChildren.Ok children)]
            [(typed.TypedOccurrenceResult.Err error)
              (TcSelectedPatternChildren.Err (tc-selected-error error))]))])))

(defenum TcSelectedPatternChildren
  (Ok (__tl_dyn-array typed.TypedOccurrenceId))
  (Err String))

;; A sub-position: the projection of `parent` that holds `result-ty`.
(define (tc-selected-position-project!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [parent : (& parent TcSelectedMaybePlace)]
  [result-ty : ast.AstType]
  [kind : typed.TypedProjectionKind]
  [source : (& source ownership.OwnershipSource)]) : TcSelectedPositionResult
  (match parent
    [(TcSelectedMaybePlace.No)
      (TcSelectedPositionResult.Ok TcSelectedMaybePlace.No)]
    [(TcSelectedMaybePlace.Some place)
      (let
        [container : typed.TypedTypeId
          (match (typed.typed-place-get!
            store
            lease
            (typed.TypedPlaceId (typed.typed-handle-copy (& place.handle))))
            [(typed.TypedPlaceView.Ok row)
              (typed.TypedTypeId (typed.typed-handle-copy (& row.type.handle)))]
            [(typed.TypedPlaceView.Err error)
              (return (TcSelectedPositionResult.Err (tc-selected-error error)))])]
        [result : typed.TypedTypeId
          (match (typed.typed-type-add! store lease result-ty)
            [(typed.TypedTypeIdResult.Ok id) id]
            [(typed.TypedTypeIdResult.Err error)
              (return (TcSelectedPositionResult.Err (tc-selected-error error)))])]
        [origin : typed.TypedOriginId
          (match (typed.typed-origin-add!
            store
            lease
            (ownership.ownership-source-copy source))
            [(typed.TypedOriginResult.Ok id) id]
            [(typed.TypedOriginResult.Err error)
              (return (TcSelectedPositionResult.Err (tc-selected-error error)))])]
        [projection : typed.TypedProjectionId
          (match (typed.typed-projection-add!
            store
            lease
            container
            result
            kind
            origin)
            [(typed.TypedProjectionResult.Ok id) id]
            [(typed.TypedProjectionResult.Err error)
              (return (TcSelectedPositionResult.Err (tc-selected-error error)))])]
        (match (typed.typed-place-add!
          store
          lease
          (typed.TypedPlaceKind.Projection
            (typed.TypedPlaceId (typed.typed-handle-copy (& place.handle)))
            projection))
          [(typed.TypedPlaceResult.Ok id)
            (TcSelectedPositionResult.Ok (TcSelectedMaybePlace.Some id))]
          [(typed.TypedPlaceResult.Err error)
            (TcSelectedPositionResult.Err (tc-selected-error error))]))]))

(defenum TcSelectedPositionResult
  (Ok TcSelectedMaybePlace)
  (Err String))

;; A variant of the enum `enum-name` by pattern name: its ordinal, its payload
;; offset among all variants' payload fields, and the declaration index.
(defstruct TcSelectedVariant
  (ordinal i64)
  (offset i64)
  (declaration i64))

(define (tc-selected-variant
  [ctx : TcContext]
  [enum-name : i64]
  [variant-name : i64]) : TcSelectedVariant
  (let
    [missing : TcSelectedVariant (TcSelectedVariant -1 -1 -1)]
    [handle : i64
      (tc-source-variant-handle-for-enum-id-or
        ctx
        enum-name
        variant-name
        (csym.compiler-symbols-missing-handle))]
    [owner : i64
      (if (csym.compiler-symbols-handle-found? handle)
        (tc-variant-owner-id-or ctx handle -1)
        -1)]
    [declaration : i64 (csym.compiler-registry-handle-owner-index handle)]
    [ordinal : i64 (csym.compiler-registry-handle-child-index handle)]
    (if (or
      (< owner 0)
      (not
        (or
          (tc-nominal-name-id-eq? owner enum-name)
          (tc-nominal-name-id-canonical-eq? ctx owner enum-name))))
      missing
      (match (csym.compiler-symbols-decl-at-index
        (tc-context-symbols ctx)
        declaration)
        [(parser.ResultAstDecl.Ok decl)
          (let
            [variants : ast.AstVariantDefList
              (match decl
                [(ast.AstDecl.DefEnum _ _ _ list) list]
                [(ast.AstDecl.DefEnumLifetimes _ _ _ _ list) list]
                [_ (return missing)])]
            [offset : i64 0]
            [index : i64 0]
            (while (< index ordinal)
              (begin
                (match (ast.ast-variant-def-list-get
                  (& variants)
                  index
                  (ast.ast-variant-def-fallback))
                  [(ast.AstVariantDef.Def _ types _)
                    (set! offset (+ offset (ast.ast-type-list-len (& types))))])
                (set! index (+ index 1))))
            (TcSelectedVariant ordinal offset declaration))]
        [(parser.ResultAstDecl.Err _) missing]))))

;; One pattern at a position of type `ty` (resolved; for the top of a
;; borrowed match, the referent). `top?` marks the arm's whole pattern, where a
;; bare name at an enum type is a unit variant.
(define (tc-selected-pattern!
  [ctx : TcContext]
  [ty : ast.AstType]
  [pattern : ast.AstPattern]
  [top? : bool]
  [position : TcSelectedMaybePlace]
  [cursor : (&mut cursor TcSelectedPatternCursor)]
  [carrier : (& carrier TcTypeEnvScopedCarrier)]
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [bindings : (&mut bindings TcSelectedBindings)]
  [source : (& source ownership.OwnershipSource)]) : TcSelectedPatternResult
  (let
    [stripped : ast.AstType
      (tc-selected-layout-type ctx (tc-global-shared-view ty))]
    [enum-name : i64
      (match (tc-global-shared-view stripped)
        [(ast.AstType.Enum name) name]
        [(ast.AstType.EnumArgs name _) name]
        [_ -1])]
    [lifetimes : ast.AstLifetimeList
      (match (tc-global-shared-view stripped)
        [(ast.AstType.EnumArgs _ list)
          (ast.ast-lifetime-list-box-shared-view list)]
        [_ (ast.ast-lifetime-list-new)])]
    [children : (__tl_dyn-array typed.TypedOccurrenceId)
      (match (tc-selected-position-children! store lease (& position) source)
        [(TcSelectedPatternChildren.Ok list) list]
        [(TcSelectedPatternChildren.Err message)
          (return (TcSelectedPatternResult.Err message))])]
    (match pattern
      [(ast.AstPattern.Wildcard)
        (tc-selected-pattern-node!
          store
          lease
          ty
          typed.TypedPattern.Wildcard
          children
          source)]
      [(ast.AstPattern.Literal literal)
        (tc-selected-pattern-node!
          store
          lease
          ty
          (typed.TypedPattern.Literal literal)
          children
          source)]
      [(ast.AstPattern.Binding name)
        (if (and top? (>= enum-name 0))
          (let
            [variant : TcSelectedVariant
              (tc-selected-variant ctx enum-name name)]
            (if (< variant.ordinal 0)
              TcSelectedPatternResult.Unsupported
              (tc-selected-pattern-node!
                store
                lease
                ty
                (typed.TypedPattern.Variant variant.ordinal)
                children
                source)))
          (if (>= cursor.shared-start 0)
            (tc-selected-pattern-shared-binder!
              name
              ty
              children
              cursor
              carrier
              store
              lease
              bindings
              source)
            (tc-selected-pattern-binder!
              ty
              children
              cursor
              carrier
              store
              lease
              bindings
              source)))]
      [(ast.AstPattern.Var name _)
        (if (>= cursor.shared-start 0)
          (tc-selected-pattern-shared-binder!
            name
            ty
            children
            cursor
            carrier
            store
            lease
            bindings
            source)
          (tc-selected-pattern-binder!
            ty
            children
            cursor
            carrier
            store
            lease
            bindings
            source))]
      ;; A slice pattern matches through a reference (its position's value, or
      ;; a borrowed match's scrutinee): Copy elements bind by value, others as
      ;; references, the rest as a sub-slice reference, all derived from it.
      [(ast.AstPattern.Slice items-box has-rest)
        (let
          [items : ast.AstPatternList
            (ast.ast-pattern-list-box-shared-view items-box)]
          [elem-ty : ast.AstType
            (tc-selected-slice-pattern-element ctx (tc-global-shared-view ty))]
          [count : i64 (tc-slice-pattern-element-count (& items) has-rest)]
          [elements : (__tl_dyn-array typed.TypedOccurrenceId) children]
          [index : i64 0]
          (while (< index items.len)
            (match (tc-selected-pattern!
              ctx
              (if (< index count)
                (tc-global-shared-view elem-ty)
                (tc-global-shared-view ty))
              (ast.ast-pattern-list-get
                (& items)
                index
                (ast.ast-pattern-fallback))
              false
              TcSelectedMaybePlace.No
              cursor
              carrier
              store
              lease
              bindings
              source)
              [(TcSelectedPatternResult.Ok child)
                (tc-selected-occurrences-push! (&mut elements) child)
                (set! index (+ index 1))]
              [(TcSelectedPatternResult.Unsupported)
                (return TcSelectedPatternResult.Unsupported)]
              [(TcSelectedPatternResult.Err message)
                (return (TcSelectedPatternResult.Err message))]))
          (tc-selected-pattern-node!
            store
            lease
            ty
            typed.TypedPattern.Slice
            elements
            source))]
      ;; `(fields ...)` names struct fields: it matches as the positional struct
      ;; pattern it stands for (unnamed fields `_`), binding in field order.
      [(ast.AstPattern.Fields entries-box)
        (match (tc-fields-pattern-resolve
          ctx
          (tc-global-shared-view stripped)
          (ast.ast-pattern-list-box-shared-view entries-box))
          [(ResultTcFieldsPattern.Err _) TcSelectedPatternResult.Unsupported]
          [(ResultTcFieldsPattern.Ok positional _)
            (match (tc-global-shared-view stripped)
              [(ast.AstType.Struct struct-name)
                (tc-selected-struct-pattern!
                  ctx
                  ty
                  struct-name
                  (ast.ast-lifetime-list-new)
                  -1
                  (& positional)
                  (& position)
                  children
                  cursor
                  carrier
                  store
                  lease
                  bindings
                  source)]
              [(ast.AstType.StructArgs struct-name list)
                (tc-selected-struct-pattern!
                  ctx
                  ty
                  struct-name
                  (ast.ast-lifetime-list-box-shared-view list)
                  -1
                  (& positional)
                  (& position)
                  children
                  cursor
                  carrier
                  store
                  lease
                  bindings
                  source)]
              [_ TcSelectedPatternResult.Unsupported])])]
      [(ast.AstPattern.Or alternatives-box)
        (let
          [alternatives : ast.AstPatternList
            (ast.ast-pattern-list-box-shared-view alternatives-box)]
          [first : ast.AstPattern
            (ast.ast-pattern-list-get
              (& alternatives)
              0
              (ast.ast-pattern-fallback))]
          (if (tc-name-id-list-empty?
            (if top?
              (tc-or-alternative-bound-names
                ctx
                TcOrPatternSite.Arm
                (tc-global-shared-view ty)
                (tc-global-shared-view first))
              (tc-pattern-add-bound-name-ids
                (tc-global-shared-view first)
                TcNameIdList.Nil)))
            ;; The alternatives only test the position.
            (tc-selected-pattern-node!
              store
              lease
              ty
              typed.TypedPattern.Or
              children
              source)
            (if (and top? (< cursor.shared-start 0))
              (tc-selected-or-candidates!
                ctx
                ty
                (& alternatives)
                (& position)
                children
                cursor
                carrier
                store
                lease
                bindings
                source)
              TcSelectedPatternResult.Unsupported)))]
      [(ast.AstPattern.Variant name args-box)
        (let
          [args : ast.AstPatternList
            (ast.ast-pattern-list-box-shared-view args-box)]
          ;; `(box p)` on an owned box (SPEC box patterns) matches `p` against
          ;; the box contents.
          [_box : unit
            (match (tc-global-shared-view stripped)
              [(ast.AstType.Box inner)
                (when
                  (and (tc-box-pattern-name? name) (= args.len 1))
                  (return
                    (tc-selected-box-pattern!
                      ctx
                      ty
                      (ast.ty-node-get inner)
                      (& args)
                      (& position)
                      children
                      cursor
                      carrier
                      store
                      lease
                      bindings
                      source)))]
              [_ unit])]
          [_struct : unit
            (match (tc-global-shared-view stripped)
              [(ast.AstType.Struct struct-name)
                (return
                  (tc-selected-struct-pattern!
                    ctx
                    ty
                    struct-name
                    (ast.ast-lifetime-list-new)
                    name
                    (& args)
                    (& position)
                    children
                    cursor
                    carrier
                    store
                    lease
                    bindings
                    source))]
              [(ast.AstType.StructArgs struct-name list)
                (return
                  (tc-selected-struct-pattern!
                    ctx
                    ty
                    struct-name
                    (ast.ast-lifetime-list-box-shared-view list)
                    name
                    (& args)
                    (& position)
                    children
                    cursor
                    carrier
                    store
                    lease
                    bindings
                    source))]
              [_ unit])]
          [variant : TcSelectedVariant
            (if (< enum-name 0)
              (TcSelectedVariant -1 -1 -1)
              (tc-selected-variant ctx enum-name name))]
          [payload : ast.AstTypeList
            (if (< variant.ordinal 0)
              (return TcSelectedPatternResult.Unsupported)
              (match (csym.compiler-registries-variant-fields-indexed
                (tc-context-symbols ctx)
                (tc-source-variant-handle-for-enum-id-or
                  ctx
                  enum-name
                  name
                  (csym.compiler-symbols-missing-handle)))
                [(parser.ResultAstTypeList.Ok fields)
                  (match (tc-variant-pattern-payload-types
                    ctx
                    enum-name
                    variant.declaration
                    lifetimes
                    fields)
                    [(ResultTcVariantPayloadTypes.Ok types) types]
                    [(ResultTcVariantPayloadTypes.Err _)
                      (return TcSelectedPatternResult.Unsupported)])]
                [(parser.ResultAstTypeList.Err _)
                  (return TcSelectedPatternResult.Unsupported)]))]
          [index : i64 0]
          (unless
            (= args.len (ast.ast-type-list-len (& payload)))
            (return TcSelectedPatternResult.Unsupported))
          (while (< index args.len)
            (let
              [field-ty : ast.AstType
                (ast.ty-node-get
                  (ast.ast-type-list-get
                    (& payload)
                    index
                    (ast.ast-type-id-fallback)))]
              [payload-position : TcSelectedMaybePlace
                (match (tc-selected-position-project!
                  store
                  lease
                  (& position)
                  (tc-global-shared-view field-ty)
                  (typed.TypedProjectionKind.Payload
                    (typed.TypedResolvedGlobal
                      lease.resolutions.owner
                      lease.resolutions.generation
                      lease.resolutions.revision
                      variant.declaration)
                    (+ variant.offset index))
                  source)
                  [(TcSelectedPositionResult.Ok place) place]
                  [(TcSelectedPositionResult.Err message)
                    (return (TcSelectedPatternResult.Err message))])]
              ;; A syntax enum's boxed payload is matched at the box
              ;; contents (`tc-selected-syntax-enum?`).
              [unboxed : ast.AstMaybeType
                (if (tc-selected-syntax-enum? enum-name)
                  (match (tc-global-shared-view field-ty)
                    [(ast.AstType.Box inner)
                      (ast.AstMaybeType.Some (ast.ty-node-get inner))]
                    [_ ast.AstMaybeType.No])
                  ast.AstMaybeType.No)]
              [sub-ty : ast.AstType
                (match (tc-global-shared-view unboxed)
                  [(ast.AstMaybeType.Some inner) inner]
                  [(ast.AstMaybeType.No) (tc-global-shared-view field-ty)])]
              [sub-position : TcSelectedMaybePlace
                (match (tc-global-shared-view unboxed)
                  [(ast.AstMaybeType.Some inner)
                    (match (tc-selected-position-project!
                      store
                      lease
                      (& payload-position)
                      inner
                      typed.TypedProjectionKind.Deref
                      source)
                      [(TcSelectedPositionResult.Ok place) place]
                      [(TcSelectedPositionResult.Err message)
                        (return (TcSelectedPatternResult.Err message))])]
                  [(ast.AstMaybeType.No) payload-position])]
              (match (tc-selected-pattern!
                ctx
                sub-ty
                (ast.ast-pattern-list-get
                  (& args)
                  index
                  (ast.ast-pattern-fallback))
                false
                sub-position
                cursor
                carrier
                store
                lease
                bindings
                source)
                [(TcSelectedPatternResult.Ok child)
                  (tc-selected-occurrences-push! (&mut children) child)
                  (set! index (+ index 1))]
                [(TcSelectedPatternResult.Unsupported)
                  (return TcSelectedPatternResult.Unsupported)]
                [(TcSelectedPatternResult.Err message)
                  (return (TcSelectedPatternResult.Err message))])))
          (tc-selected-pattern-node!
            store
            lease
            ty
            (typed.TypedPattern.Variant variant.ordinal)
            children
            source))]
      [(ast.AstPattern.Tuple args-box)
        (match (tc-global-shared-view stripped)
          [(ast.AstType.Tuple elements)
            (let
              [declared : ast.AstTypeList
                (ast.ast-type-list-box-shared-view elements)]
              [element-types : (__tl_dyn-array ast.AstType)
                (tc-selected-no-types)]
              [index : i64 0]
              (while (< index (ast.ast-type-list-len (& declared)))
                (begin
                  (match (tc-tuple-ref-result-type
                    (tc-global-shared-view ty)
                    index)
                    [(ResultTcType.Ok element)
                      (tc-selected-types-push! (&mut element-types) element)]
                    [(ResultTcType.Err _)
                      (return TcSelectedPatternResult.Unsupported)])
                  (set! index (+ index 1))))
              (tc-selected-element-patterns!
                ctx
                ty
                element-types
                false
                (ast.ast-pattern-list-box-shared-view args-box)
                (& position)
                children
                cursor
                carrier
                store
                lease
                bindings
                source))]
          [_ TcSelectedPatternResult.Unsupported])]
      [(ast.AstPattern.Array args-box)
        (let
          [args : ast.AstPatternList
            (ast.ast-pattern-list-box-shared-view args-box)]
          (match (tc-global-shared-view stripped)
            [(ast.AstType.Array element size)
              (if (!= size args.len)
                TcSelectedPatternResult.Unsupported
                (let
                  [element-types : (__tl_dyn-array ast.AstType)
                    (tc-selected-no-types)]
                  [index : i64 0]
                  (while (< index size)
                    (let
                      [element-ty : ast.AstType
                        (tc-project-from-region-container
                          (tc-global-shared-view ty)
                          (ast.ty-node-get element))]
                      (tc-selected-types-push! (&mut element-types) element-ty)
                      (set! index (+ index 1))))
                  (tc-selected-element-patterns!
                    ctx
                    ty
                    element-types
                    true
                    args
                    (& position)
                    children
                    cursor
                    carrier
                    store
                    lease
                    bindings
                    source)))]
            [_ TcSelectedPatternResult.Unsupported]))]
      [_ TcSelectedPatternResult.Unsupported])))

;; `(tuple p ...)` or `(array p ...)`: a product pattern that tests nothing,
;; whose sub-patterns match the elements left to right, each at its element's
;; position. A fixed array's pattern positions are literal-index elements, each
;; its own place (a by-value match consumes the whole scrutinee first, SPEC
;; 5.13, so its elements move out one by one).
(define (tc-selected-element-patterns!
  [ctx : TcContext]
  [ty : ast.AstType]
  [element-types : (__tl_dyn-array ast.AstType)]
  [fixed? : bool]
  [args : ast.AstPatternList]
  [position : (& position TcSelectedMaybePlace)]
  [children : (__tl_dyn-array typed.TypedOccurrenceId)]
  [cursor : (&mut cursor TcSelectedPatternCursor)]
  [carrier : (& carrier TcTypeEnvScopedCarrier)]
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [bindings : (&mut bindings TcSelectedBindings)]
  [source : (& source ownership.OwnershipSource)]) : TcSelectedPatternResult
  (let
    [index : i64 0]
    (unless
      (= args.len (array-length element-types))
      (return TcSelectedPatternResult.Unsupported))
    (while (< index args.len)
      (let
        [element-ty : ast.AstType
          (tc-global-array-element-shared-view element-types index)]
        [sub-position : TcSelectedMaybePlace
          (match (tc-selected-position-project!
            store
            lease
            position
            (tc-global-shared-view element-ty)
            (if fixed?
              (typed.TypedProjectionKind.FixedArrayElement index)
              (typed.TypedProjectionKind.TupleElement index))
            source)
            [(TcSelectedPositionResult.Ok place) place]
            [(TcSelectedPositionResult.Err message)
              (return (TcSelectedPatternResult.Err message))])]
        (match (tc-selected-pattern!
          ctx
          element-ty
          (ast.ast-pattern-list-get (& args) index (ast.ast-pattern-fallback))
          false
          sub-position
          cursor
          carrier
          store
          lease
          bindings
          source)
          [(TcSelectedPatternResult.Ok child)
            (tc-selected-occurrences-push! (&mut children) child)
            (set! index (+ index 1))]
          [(TcSelectedPatternResult.Unsupported)
            (return TcSelectedPatternResult.Unsupported)]
          [(TcSelectedPatternResult.Err message)
            (return (TcSelectedPatternResult.Err message))])))
    (tc-selected-pattern-node!
      store
      lease
      ty
      typed.TypedPattern.Tuple
      children
      source)))

;; `(S p ...)` destructuring a struct: a product pattern that tests nothing,
;; whose sub-patterns match the fields in declaration order, each at its
;; field's position (as legacy `tc-bind-struct-pattern` binds them).
(define (tc-selected-struct-pattern!
  [ctx : TcContext]
  [ty : ast.AstType]
  [struct-name : i64]
  [lifetimes : ast.AstLifetimeList]
  [pattern-name : i64]
  [args : (& args ast.AstPatternList)]
  [position : (& position TcSelectedMaybePlace)]
  [children : (__tl_dyn-array typed.TypedOccurrenceId)]
  [cursor : (&mut cursor TcSelectedPatternCursor)]
  [carrier : (& carrier TcTypeEnvScopedCarrier)]
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [bindings : (&mut bindings TcSelectedBindings)]
  [source : (& source ownership.OwnershipSource)]) : TcSelectedPatternResult
  (let
    [fields : ast.AstFieldDefList
      (match (tc-struct-decl-id ctx struct-name)
        [(ResultTcStructDecl.Ok decl)
          (match decl
            [(TcStructDecl _ _ list) list])]
        [(ResultTcStructDecl.Err _)
          (return TcSelectedPatternResult.Unsupported)])]
    [index : i64 0]
    ;; A by-name `(fields ...)` pattern (`pattern-name` -1) has no head.
    (unless
      (and
        (= args.len (ast.ast-field-def-list-len (& fields)))
        (or
          (< pattern-name 0)
          (tc-struct-pattern-name-matches?
            ctx
            (tc-nominal-name-id-display struct-name)
            (tc-env-key-name-text pattern-name)
            pattern-name)))
      (return TcSelectedPatternResult.Unsupported))
    (while (< index args.len)
      (let
        [field-id : i64
          (match (ast.ast-field-def-list-get
            (& fields)
            index
            (ast.ast-field-def-fallback))
            [(ast.AstFieldDef.Def field-name _ _)
              (ci.intern-syntax-id-value field-name)])]
        [selected : TcResolvedField
          (match (tc-struct-field-selected-with-args-id
            ctx
            struct-name
            (tc-global-shared-view lifetimes)
            field-id)
            [(ResultTcField.Ok field) field]
            [(ResultTcField.Err _) (return TcSelectedPatternResult.Unsupported)])]
        [owner : i64
          (match (& selected.identity)
            [(TcFieldIdentity.Nominal owner _) owner]
            [(TcFieldIdentity.Intrinsic)
              (return TcSelectedPatternResult.Unsupported)])]
        [ordinal : i64
          (match (& selected.identity)
            [(TcFieldIdentity.Nominal _ child) child]
            [(TcFieldIdentity.Intrinsic) -1])]
        [sub-position : TcSelectedMaybePlace
          (match (tc-selected-position-project!
            store
            lease
            position
            (tc-global-shared-view selected.type)
            (typed.TypedProjectionKind.StructField
              (typed.TypedResolvedGlobal
                lease.resolutions.owner
                lease.resolutions.generation
                lease.resolutions.revision
                owner)
              ordinal)
            source)
            [(TcSelectedPositionResult.Ok place) place]
            [(TcSelectedPositionResult.Err message)
              (return (TcSelectedPatternResult.Err message))])]
        (match (tc-selected-pattern!
          ctx
          (tc-global-shared-view selected.type)
          (ast.ast-pattern-list-get args index (ast.ast-pattern-fallback))
          false
          sub-position
          cursor
          carrier
          store
          lease
          bindings
          source)
          [(TcSelectedPatternResult.Ok child)
            (tc-selected-occurrences-push! (&mut children) child)
            (set! index (+ index 1))]
          [(TcSelectedPatternResult.Unsupported)
            (return TcSelectedPatternResult.Unsupported)]
          [(TcSelectedPatternResult.Err message)
            (return (TcSelectedPatternResult.Err message))])))
    (tc-selected-pattern-node!
      store
      lease
      ty
      typed.TypedPattern.Tuple
      children
      source)))

;; A box pattern: its inner pattern at the box contents, a `Deref` of the
;; matched position. The graph reaches box contents through the whole box (a
;; boxed route), so a binding that moves out of them consumes the box.
(define (tc-selected-box-pattern!
  [ctx : TcContext]
  [ty : ast.AstType]
  [inner : ast.AstType]
  [args : (& args ast.AstPatternList)]
  [position : (& position TcSelectedMaybePlace)]
  [children : (__tl_dyn-array typed.TypedOccurrenceId)]
  [cursor : (&mut cursor TcSelectedPatternCursor)]
  [carrier : (& carrier TcTypeEnvScopedCarrier)]
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [bindings : (&mut bindings TcSelectedBindings)]
  [source : (& source ownership.OwnershipSource)]) : TcSelectedPatternResult
  (let
    [sub-position : TcSelectedMaybePlace
      (match (tc-selected-position-project!
        store
        lease
        position
        (tc-global-shared-view inner)
        typed.TypedProjectionKind.Deref
        source)
        [(TcSelectedPositionResult.Ok place) place]
        [(TcSelectedPositionResult.Err message)
          (return (TcSelectedPatternResult.Err message))])]
    (match (tc-selected-pattern!
      ctx
      (tc-global-shared-view inner)
      (ast.ast-pattern-list-get args 0 (ast.ast-pattern-fallback))
      false
      sub-position
      cursor
      carrier
      store
      lease
      bindings
      source)
      [(TcSelectedPatternResult.Ok child)
        (tc-selected-occurrences-push! (&mut children) child)
        (tc-selected-pattern-node!
          store
          lease
          ty
          typed.TypedPattern.Tuple
          children
          source)]
      [(TcSelectedPatternResult.Unsupported)
        TcSelectedPatternResult.Unsupported]
      [(TcSelectedPatternResult.Err message)
        (TcSelectedPatternResult.Err message)])))

;; A binder pattern takes the next slot legacy binding pushed.
;; The element type a slice pattern matches at `ty`: the scrutinee's view's
;; (a reference to a Slice or fixed array), or the referent's itself.
(define (tc-selected-slice-pattern-element [ctx : TcContext] [ty : ast.AstType]) : ast.AstType
  (match (tc-slice-pattern-scrutinee ctx (tc-global-shared-view ty))
    [(TcSlicePatternScrutinee.View _ _ elem _) elem]
    [(TcSlicePatternScrutinee.Invalid)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(ast.AstType.Slice elem) (tc-resolve-type ctx (ast.ty-node-get elem))]
        [(ast.AstType.Array elem _)
          (tc-resolve-type ctx (ast.ty-node-get elem))]
        [_ ast.AstType.Unit])]))

;; A later or-pattern candidate's binder: the first candidate's binder of the
;; same name (typing checked that every alternative binds the same names at
;; the same types).
(define (tc-selected-pattern-shared-binder!
  [name : i64]
  [ty : ast.AstType]
  [children : (__tl_dyn-array typed.TypedOccurrenceId)]
  [cursor : (&mut cursor TcSelectedPatternCursor)]
  [carrier : (& carrier TcTypeEnvScopedCarrier)]
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [bindings : (&mut bindings TcSelectedBindings)]
  [source : (& source ownership.OwnershipSource)]) : TcSelectedPatternResult
  (let
    [slot : i64 cursor.shared-start]
    [found : i64 -1]
    (while (and (< found 0) (< slot cursor.shared-end))
      (when
        (and
          (< slot carrier.sidecar.stack.slot-count)
          (=
            (tc-type-env-scoped-stack-slot-at (& carrier.sidecar.stack) slot).name-id
            name))
        (set! found slot))
      (set! slot (+ slot 1)))
    (if (or (< found 0) (>= found bindings.len))
      TcSelectedPatternResult.Unsupported
      (tc-selected-pattern-node!
        store
        lease
        ty
        (typed.TypedPattern.Bind
          (typed.TypedBinderId
            (typed.typed-handle-copy
              (& (array-ref bindings.entries found).binder.handle))))
        children
        source))))

;; Nested binding or-patterns distribute over the patterns holding them, as
;; Rust's match lowering expands them: `(Right (or (Num n) (Lit n)))` is the
;; arm `(or (Right (Num n)) (Right (Lit n)))`, tried in the same order and
;; binding the same names. An arm's top-level candidates are the only binding
;; or-patterns the graph lowers (`tc-selected-or-candidates!`); past this many
;; candidates the arm stays unrepresented (rejected, fail-closed).
(define (tc-selected-or-candidate-limit) : i64
  256)

;; The arm pattern with its nested binding or-patterns distributed into one
;; top-level `or`, or the pattern itself when it has none (or too many).
(define (tc-selected-or-distributed [pattern : ast.AstPattern]) : ast.AstPattern
  (let
    [items : ast.AstPatternList (ast.ast-pattern-list-with-capacity 1)]
    (ast.ast-pattern-list-push (&mut items) pattern)
    (let
      [count : i64
        (tc-selected-or-count-at (& items) 0 (tc-selected-or-candidate-limit))]
      (if (or (<= count 1) (> count (tc-selected-or-candidate-limit)))
        (ast.ast-pattern-list-get (& items) 0 (ast.ast-pattern-fallback))
        (ast.ast-pat-or (tc-selected-or-expand-at (& items) 0))))))

;; Whether an or-pattern's alternatives bind names (they all bind the same).
(define (tc-selected-or-binds?
  [alternatives : (& alternatives ast.AstPatternList)]) : bool
  (not
    (tc-name-id-list-empty?
      (tc-pattern-add-bound-name-ids
        (ast.ast-pattern-list-get alternatives 0 (ast.ast-pattern-fallback))
        TcNameIdList.Nil))))

;; How many candidates `items[index]` distributes into, saturating past `limit`.
(define (tc-selected-or-count-at
  [items : (& items ast.AstPatternList)]
  [index : i64]
  [limit : i64]) : i64
  (match (ast.ast-pattern-list-get items index (ast.ast-pattern-fallback))
    [(ast.AstPattern.Or alternatives-box)
      (let
        [alternatives : ast.AstPatternList
          (ast.ast-pattern-list-box-shared-view alternatives-box)]
        (if (tc-selected-or-binds? (& alternatives))
          (let
            [total : i64 0]
            [at : i64 0]
            (while (and (< at alternatives.len) (<= total limit))
              (set!
                total
                (+ total (tc-selected-or-count-at (& alternatives) at limit)))
              (set! at (+ at 1)))
            total)
          1))]
    [(or (ast.AstPattern.Variant _ subs-box) (ast.AstPattern.Tuple subs-box)
         (ast.AstPattern.Array subs-box) (ast.AstPattern.Slice subs-box _)
         (ast.AstPattern.Fields subs-box) (ast.AstPattern.Field _ subs-box))
      (let
        [subs : ast.AstPatternList
          (ast.ast-pattern-list-box-shared-view subs-box)]
        [total : i64 1]
        [at : i64 0]
        (while (and (< at subs.len) (<= total limit))
          (set! total (* total (tc-selected-or-count-at (& subs) at limit)))
          (set! at (+ at 1)))
        total)]
    [_ 1]))

;; `items[index]` alone, as a one-candidate list.
(define (tc-selected-or-single
  [items : (& items ast.AstPatternList)]
  [index : i64]) : ast.AstPatternList
  (let
    [out : ast.AstPatternList (ast.ast-pattern-list-with-capacity 1)]
    (ast.ast-pattern-list-push
      (&mut out)
      (ast.ast-pattern-list-get items index (ast.ast-pattern-fallback)))
    out))

;; The candidates `items[index]` distributes into, in trial order.
(define (tc-selected-or-expand-at
  [items : (& items ast.AstPatternList)]
  [index : i64]) : ast.AstPatternList
  (if (<= (tc-selected-or-count-at items index 2) 1)
    (tc-selected-or-single items index)
    (match (ast.ast-pattern-list-get items index (ast.ast-pattern-fallback))
      [(ast.AstPattern.Or alternatives-box)
        (let
          [alternatives : ast.AstPatternList
            (ast.ast-pattern-list-box-shared-view alternatives-box)]
          [out : ast.AstPatternList (ast.ast-pattern-list-new)]
          [at : i64 0]
          (while (< at alternatives.len)
            (let
              [part : ast.AstPatternList
                (tc-selected-or-expand-at (& alternatives) at)]
              (ast.ast-pattern-list-append-from (&mut out) (& part) 0))
            (set! at (+ at 1)))
          out)]
      [(or (ast.AstPattern.Variant _ subs-box) (ast.AstPattern.Tuple subs-box)
           (ast.AstPattern.Array subs-box) (ast.AstPattern.Slice subs-box _)
           (ast.AstPattern.Fields subs-box) (ast.AstPattern.Field _ subs-box))
        (let
          [subs : ast.AstPatternList
            (ast.ast-pattern-list-box-shared-view subs-box)]
          (tc-selected-or-rebuild items index (tc-selected-or-rows (& subs) 0)))]
      [_ (tc-selected-or-single items index)])))

;; Every combination of the candidates of `items[index..]`, in trial order,
;; each row held as a tuple pattern of its items.
(define (tc-selected-or-rows
  [items : (& items ast.AstPatternList)]
  [index : i64]) : ast.AstPatternList
  (let
    [out : ast.AstPatternList (ast.ast-pattern-list-new)]
    (if (>= index items.len)
      (ast.ast-pattern-list-push
        (&mut out)
        (ast.ast-pat-tuple (ast.ast-pattern-list-new)))
      (let
        [heads : ast.AstPatternList (tc-selected-or-expand-at items index)]
        [tails : ast.AstPatternList (tc-selected-or-rows items (+ index 1))]
        [head : i64 0]
        (while (< head heads.len)
          (let
            [tail : i64 0]
            (while (< tail tails.len)
              (match (ast.ast-pattern-list-get
                (& tails)
                tail
                (ast.ast-pattern-fallback))
                [(ast.AstPattern.Tuple rest-box)
                  (ast.ast-pattern-list-push
                    (&mut out)
                    (ast.ast-pat-tuple
                      (ast.ast-pattern-cons
                        (&
                          (ast.ast-pattern-list-get
                            (& heads)
                            head
                            (ast.ast-pattern-fallback)))
                        (& (ast.ast-pattern-list-box-shared-view rest-box)))))]
                [_ unit])
              (set! tail (+ tail 1))))
          (set! head (+ head 1)))))
    out))

;; `items[index]`'s shape rebuilt over each row of its distributed parts.
(define (tc-selected-or-rebuild
  [items : (& items ast.AstPatternList)]
  [index : i64]
  [rows : ast.AstPatternList]) : ast.AstPatternList
  (let
    [out : ast.AstPatternList (ast.ast-pattern-list-new)]
    [at : i64 0]
    (while (< at rows.len)
      (match (ast.ast-pattern-list-get (& rows) at (ast.ast-pattern-fallback))
        [(ast.AstPattern.Tuple row-box)
          (let
            [row : ast.AstPatternList
              (ast.ast-pattern-list-box-shared-view row-box)]
            (ast.ast-pattern-list-push
              (&mut out)
              (match (ast.ast-pattern-list-get
                items
                index
                (ast.ast-pattern-fallback))
                [(ast.AstPattern.Variant name _)
                  (ast.ast-pat-variant-id name row)]
                [(ast.AstPattern.Tuple _) (ast.ast-pat-tuple row)]
                [(ast.AstPattern.Array _) (ast.ast-pat-array row)]
                [(ast.AstPattern.Slice _ rest?) (ast.ast-pat-slice row rest?)]
                [(ast.AstPattern.Fields _) (ast.ast-pat-fields row)]
                [(ast.AstPattern.Field name _)
                  (ast.AstPattern.Field name (box row))]
                [_ (ast.ast-pattern-fallback)])))]
        [_ unit])
      (set! at (+ at 1)))
    out))

;; An arm's `(or p ...)` whose alternatives bind names: one candidate pattern
;; per alternative at the same position. The first binds the arm's slots in
;; order; the others bind the same binders by name.
(define (tc-selected-or-candidates!
  [ctx : TcContext]
  [ty : ast.AstType]
  [alternatives : (& alternatives ast.AstPatternList)]
  [position : (& position TcSelectedMaybePlace)]
  [children : (__tl_dyn-array typed.TypedOccurrenceId)]
  [cursor : (&mut cursor TcSelectedPatternCursor)]
  [carrier : (& carrier TcTypeEnvScopedCarrier)]
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [bindings : (&mut bindings TcSelectedBindings)]
  [source : (& source ownership.OwnershipSource)]) : TcSelectedPatternResult
  (let
    [start : i64 cursor.slot]
    [end : i64 cursor.slot]
    [items : (__tl_dyn-array typed.TypedOccurrenceId) children]
    [index : i64 0]
    (while (< index alternatives.len)
      (let
        [candidate : TcSelectedPatternCursor
          (if (= index 0)
            (TcSelectedPatternCursor start -1 -1)
            (TcSelectedPatternCursor end start end))]
        (match (tc-selected-pattern!
          ctx
          (tc-global-shared-view ty)
          (ast.ast-pattern-list-get
            alternatives
            index
            (ast.ast-pattern-fallback))
          true
          (match position
            [(TcSelectedMaybePlace.Some place)
              (TcSelectedMaybePlace.Some
                (typed.TypedPlaceId (typed.typed-handle-copy (& place.handle))))]
            [(TcSelectedMaybePlace.No) TcSelectedMaybePlace.No])
          (&mut candidate)
          carrier
          store
          lease
          bindings
          source)
          [(TcSelectedPatternResult.Ok id)
            (tc-selected-occurrences-push! (&mut items) id)]
          [(TcSelectedPatternResult.Unsupported)
            (return TcSelectedPatternResult.Unsupported)]
          [(TcSelectedPatternResult.Err message)
            (return (TcSelectedPatternResult.Err message))])
        (when (= index 0) (set! end candidate.slot))
        (set! index (+ index 1))))
    (set! cursor.slot end)
    (tc-selected-pattern-node!
      store
      lease
      ty
      typed.TypedPattern.Alternatives
      items
      source)))

(define (tc-selected-pattern-binder!
  [ty : ast.AstType]
  [children : (__tl_dyn-array typed.TypedOccurrenceId)]
  [cursor : (&mut cursor TcSelectedPatternCursor)]
  [carrier : (& carrier TcTypeEnvScopedCarrier)]
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [bindings : (&mut bindings TcSelectedBindings)]
  [source : (& source ownership.OwnershipSource)]) : TcSelectedPatternResult
  (let
    [slot : i64 cursor.slot]
    [entry : TcTypeEnvScopedSlot
      (if (and (>= slot 0) (< slot carrier.sidecar.stack.slot-count))
        (tc-type-env-scoped-stack-slot-at (& carrier.sidecar.stack) slot)
        (return TcSelectedPatternResult.Unsupported))]
    (set! cursor.slot (+ slot 1))
    (match (tc-selected-binding-note-at!
      store
      lease
      bindings
      carrier
      slot
      entry.ty
      typed.TypedBinderKind.Local
      source)
      [(TcSelectedBinderLookup.Ok found)
        (match found
          [(TcSelectedBinder.Found binder)
            (tc-selected-pattern-node!
              store
              lease
              ty
              (typed.TypedPattern.Bind binder)
              children
              source)]
          [(TcSelectedBinder.Unrepresented) TcSelectedPatternResult.Unsupported])]
      [(TcSelectedBinderLookup.Err error)
        (TcSelectedPatternResult.Err (tc-selected-error error))])))

;; The arms after the scrutinee: each arm's names are bound by legacy pattern
;; binding in a scope of its own, its pattern occurrence follows the bound
;; slots, and its body is typed by the selected producer. `merged` is the
;; legacy branch merge of the arm types so far (Never before the first arm).
(defenum TcSelectedArmsResult
  (:lifetimes store lease intern bind)
  ;; The merged type, whether every arm is represented, and the arm types and
  ;; match children handed back.
  (Ok
    ast.AstType
    bool
    (__tl_dyn-array ast.AstType)
    (__tl_dyn-array typed.TypedOccurrenceId)
    (TcSelectedSink store lease intern bind))
  ;; Outside the subset: the caller types the whole match through legacy.
  (Legacy (TcSelectedSink store lease intern bind))
  (Err String (TcSelectedSink store lease intern bind)))

(define (tc-infer-selected-match-arms
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : ast.AstType]
  [top-ty : ast.AstType]
  [position : TcSelectedMaybePlace]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]
  [expected : ast.AstMaybeType]
  [merged : ast.AstType]
  [arm-types : (__tl_dyn-array ast.AstType)]
  [children : (__tl_dyn-array typed.TypedOccurrenceId)]
  [represented? : bool]
  ;; The match's own syntax: its arm bodies are its result children.
  [syntax : (& syntax typed.TypedSyntax)]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedArmsResult
    store
    lease
    intern
    bind)
  (if (>= index arms.len)
    (TcSelectedArmsResult.Ok merged represented? arm-types children sink)
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm pattern body-id)
        (let
          [observed? : bool (tc-semantic-capture-observed? ctx (& sink))]
          [_semantic-scope : unit
            (when
              observed?
              (tc-semantic-observer-send!
                (tc-context-semantic-observer ctx)
                ctx
                env
                (ScopeEnter body-id)))]
          [saved : TcTypeEnvScopedRuntimeSave
            (tc-type-env-scoped-runtime-save env)]
          [slot : i64
            (if (tc-type-env-scoped-runtime-active? env)
              (tc-type-env-scoped-runtime-current env).sidecar.stack.slot-count
              -1)]
          [bound : ResultTcEnv
            (tc-bind-match-pattern
              ctx
              env
              (tc-global-shared-view scrut-ty)
              (tc-global-shared-view pattern))]
          [arm-env : TcTypeEnv
            (match bound
              [(ResultTcEnv.Ok next) next]
              [(ResultTcEnv.Err message)
                (tc-type-env-scoped-runtime-restore! saved)
                (when
                  observed?
                  (tc-semantic-observer-send!
                    (tc-context-semantic-observer ctx)
                    ctx
                    env
                    ScopeLeave))
                (return
                  (TcSelectedArmsResult.Err
                    (tc-locate-match-pattern-error
                      (tc-context-expr-bases ctx)
                      (tc-context-expr-get ctx body-id)
                      message)
                    sink))])]
          ;; The pattern occurrence, built before the body (in Capture only).
          [pattern-result : (TcSelectedPatternOutcome store lease intern bind)
            (if (or (not represented?) (< slot 0))
              (TcSelectedPatternOutcome.Skipped sink)
              (match sink
                [(TcSelectedSink.Query)
                  (TcSelectedPatternOutcome.Skipped TcSelectedSink.Query)]
                [(TcSelectedSink.Capture store lease bindings)
                  (let
                    [cursor : TcSelectedPatternCursor
                      (TcSelectedPatternCursor slot -1 -1)]
                    [carrier : TcTypeEnvScopedCarrier
                      (tc-type-env-scoped-runtime-current arm-env)]
                    [built : TcSelectedPatternResult
                      (tc-selected-pattern!
                        ctx
                        (tc-global-shared-view top-ty)
                        (tc-selected-or-distributed
                          (tc-global-shared-view pattern))
                        true
                        (match (& position)
                          [(TcSelectedMaybePlace.Some place)
                            (TcSelectedMaybePlace.Some
                              (typed.TypedPlaceId
                                (typed.typed-handle-copy (& place.handle))))]
                          [(TcSelectedMaybePlace.No) TcSelectedMaybePlace.No])
                        (&mut cursor)
                        (& carrier)
                        store
                        lease
                        (&mut bindings)
                        (& source))]
                    (match built
                      [(TcSelectedPatternResult.Ok id)
                        (if (= cursor.slot carrier.sidecar.stack.slot-count)
                          (TcSelectedPatternOutcome.Built
                            id
                            (TcSelectedSink.Capture store lease bindings))
                          (TcSelectedPatternOutcome.Legacy
                            (TcSelectedSink.Capture store lease bindings)))]
                      [(TcSelectedPatternResult.Unsupported)
                        (TcSelectedPatternOutcome.Legacy
                          (TcSelectedSink.Capture store lease bindings))]
                      [(TcSelectedPatternResult.Err message)
                        (TcSelectedPatternOutcome.Failed
                          message
                          (TcSelectedSink.Capture store lease bindings))]))]))]
          (match pattern-result
            [(TcSelectedPatternOutcome.Failed message next)
              (tc-type-env-scoped-runtime-restore! saved)
              (when
                observed?
                (tc-semantic-observer-send!
                  (tc-context-semantic-observer ctx)
                  ctx
                  env
                  ScopeLeave))
              (TcSelectedArmsResult.Err message next)]
            [(TcSelectedPatternOutcome.Legacy next)
              (tc-type-env-scoped-runtime-restore! saved)
              (when
                observed?
                (tc-semantic-observer-send!
                  (tc-context-semantic-observer ctx)
                  ctx
                  env
                  ScopeLeave))
              (TcSelectedArmsResult.Legacy next)]
            [(TcSelectedPatternOutcome.Skipped next)
              (tc-infer-selected-match-arm-body
                ctx
                env
                scrut-ty
                top-ty
                position
                arms
                index
                expected
                merged
                arm-types
                children
                false
                TcSelectedOccurrence.Unrepresented
                body-id
                arm-env
                saved
                syntax
                source
                next)]
            [(TcSelectedPatternOutcome.Built id next)
              (tc-infer-selected-match-arm-body
                ctx
                env
                scrut-ty
                top-ty
                position
                arms
                index
                expected
                merged
                arm-types
                children
                represented?
                (TcSelectedOccurrence.Selected id)
                body-id
                arm-env
                saved
                syntax
                source
                next)]))])))

(defenum TcSelectedPatternOutcome
  (:lifetimes store lease intern bind)
  (Built typed.TypedOccurrenceId (TcSelectedSink store lease intern bind))
  (Skipped (TcSelectedSink store lease intern bind))
  (Legacy (TcSelectedSink store lease intern bind))
  (Failed String (TcSelectedSink store lease intern bind)))

;; One arm's body, its merge into the arm types, its Arm occurrence, and the
;; remaining arms.
(define (tc-infer-selected-match-arm-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : ast.AstType]
  [top-ty : ast.AstType]
  [position : TcSelectedMaybePlace]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]
  [expected : ast.AstMaybeType]
  [merged : ast.AstType]
  [arm-types : (__tl_dyn-array ast.AstType)]
  [children : (__tl_dyn-array typed.TypedOccurrenceId)]
  [represented? : bool]
  [pattern : TcSelectedOccurrence]
  [body-id : i64]
  [arm-env : TcTypeEnv]
  [saved : TcTypeEnvScopedRuntimeSave]
  [syntax : (& syntax typed.TypedSyntax)]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedArmsResult
    store
    lease
    intern
    bind)
  (let
    [observed? : bool (tc-semantic-capture-observed? ctx (& sink))]
    [body : (TcSelectedResult store lease intern bind)
      (tc-infer-selected-result-child
        ctx
        arm-env
        syntax
        true
        body-id
        (tc-global-shared-view expected)
        (tc-global-shared-view source)
        represented?
        sink)]
    (tc-type-env-scoped-runtime-restore! saved)
    (when
      observed?
      (tc-semantic-observer-send!
        (tc-context-semantic-observer ctx)
        ctx
        env
        ScopeLeave))
    (match body
      ;; An arm's error is the match's: falling back to legacy typing
      ;; would drop an ownership error only the graph finds.
      [(TcSelectedResult.Err message next)
        (TcSelectedArmsResult.Err message next)]
      [(TcSelectedResult.Ok got occurrence next)
        (let
          [joined : ResultTcType
            (match (tc-global-shared-view expected)
              [(ast.AstMaybeType.Some want)
                (match (tc-match-inferred-type-for-expected
                  ctx
                  arm-env
                  (tc-global-shared-view got)
                  (tc-global-shared-view want))
                  [(TcInferredTypeMatch.Compatible _) (ResultTcType.Ok want)]
                  [(TcInferredTypeMatch.Mismatch _)
                    (ResultTcType.Err
                      "typecheck: match arm result type mismatch")])]
              [(ast.AstMaybeType.No)
                (if (= index 0)
                  (ResultTcType.Ok (tc-global-shared-view got))
                  (tc-merge-branch-type
                    ctx
                    env
                    (tc-global-shared-view merged)
                    (tc-global-shared-view got)))])]
          (match joined
            [(ResultTcType.Err _) (TcSelectedArmsResult.Legacy next)]
            [(ResultTcType.Ok next-merged)
              (let
                [arm : (TcSelectedArmOutcome store lease intern bind)
                  (match occurrence
                    [(TcSelectedOccurrence.Selected body-occurrence)
                      (match pattern
                        [(TcSelectedOccurrence.Selected pattern-occurrence)
                          (if represented?
                            (tc-selected-publish-arm!
                              (tc-global-shared-view got)
                              pattern-occurrence
                              body-occurrence
                              (tc-global-shared-view source)
                              next)
                            (TcSelectedArmOutcome.Skipped next))]
                        [(TcSelectedOccurrence.Unrepresented)
                          (TcSelectedArmOutcome.Skipped next)])]
                    [(TcSelectedOccurrence.Unrepresented)
                      (TcSelectedArmOutcome.Skipped next)])]
                (match arm
                  [(TcSelectedArmOutcome.Failed message after)
                    (TcSelectedArmsResult.Err message after)]
                  [(TcSelectedArmOutcome.Skipped after)
                    (set! (array-ref arm-types index) got)
                    (tc-infer-selected-match-arms
                      ctx
                      env
                      scrut-ty
                      top-ty
                      position
                      arms
                      (+ index 1)
                      expected
                      next-merged
                      arm-types
                      children
                      false
                      syntax
                      source
                      after)]
                  [(TcSelectedArmOutcome.Built id after)
                    (set! (array-ref arm-types index) got)
                    (set! (array-ref children (+ index 1)) id)
                    (tc-infer-selected-match-arms
                      ctx
                      env
                      scrut-ty
                      top-ty
                      position
                      arms
                      (+ index 1)
                      expected
                      next-merged
                      arm-types
                      children
                      represented?
                      syntax
                      source
                      after)]))]))])))

(defenum TcSelectedArmOutcome
  (:lifetimes store lease intern bind)
  (Built typed.TypedOccurrenceId (TcSelectedSink store lease intern bind))
  (Skipped (TcSelectedSink store lease intern bind))
  (Failed String (TcSelectedSink store lease intern bind)))

(define (tc-selected-publish-arm!
  [ty : ast.AstType]
  [pattern : typed.TypedOccurrenceId]
  [body : typed.TypedOccurrenceId]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedArmOutcome
    store
    lease
    intern
    bind)
  (match sink
    [(TcSelectedSink.Query) (TcSelectedArmOutcome.Skipped TcSelectedSink.Query)]
    [(TcSelectedSink.Capture store lease bindings)
      (let
        [children : (__tl_dyn-array typed.TypedOccurrenceId)
          (__tl_make-array typed.TypedOccurrenceId 2)]
        [type-id : typed.TypedTypeId
          (match (typed.typed-type-add! store lease ty)
            [(typed.TypedTypeIdResult.Ok id) id]
            [(typed.TypedTypeIdResult.Err error)
              (return
                (TcSelectedArmOutcome.Failed
                  (tc-selected-error error)
                  (TcSelectedSink.Capture store lease bindings)))])]
        [origin : typed.TypedOriginId
          (match (typed.typed-origin-add! store lease source)
            [(typed.TypedOriginResult.Ok id) id]
            [(typed.TypedOriginResult.Err error)
              (return
                (TcSelectedArmOutcome.Failed
                  (tc-selected-error error)
                  (TcSelectedSink.Capture store lease bindings)))])]
        (set! (array-ref children 0) pattern)
        (set! (array-ref children 1) body)
        (match (typed.typed-occurrence-add!
          store
          lease
          type-id
          typed.TypedSyntax.Generated
          origin
          typed.TypedOperation.Arm
          (& children))
          [(typed.TypedOccurrenceResult.Ok id)
            (TcSelectedArmOutcome.Built
              id
              (TcSelectedSink.Capture store lease bindings))]
          [(typed.TypedOccurrenceResult.Err error)
            (TcSelectedArmOutcome.Failed
              (tc-selected-error error)
              (TcSelectedSink.Capture store lease bindings))]))]))

;; The scrutinee as the match's first child: a formed place (mode 0), an
;; initialized synthetic binder holding its value (mode 1), or a reference to
;; an enum (mode 2, borrowed). `position` is the by-value scrutinee place.
(defenum TcSelectedScrutinee
  (:lifetimes store lease intern bind)
  (Ok
    ast.AstType
    i64
    typed.TypedOccurrenceId
    TcSelectedMaybePlace
    (TcSelectedSink store lease intern bind))
  (Legacy (TcSelectedSink store lease intern bind))
  (Err String (TcSelectedSink store lease intern bind)))

;; `tc-selected-failed` for a scrutinee.
(define (tc-selected-scrutinee-failed
  [error : typed.TypedError]
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [bindings : (&mut bind TcSelectedBindings)]) : (TcSelectedScrutinee
    store
    lease
    intern
    bind)
  (TcSelectedScrutinee.Err
    (tc-selected-error error)
    (TcSelectedSink.Capture store lease bindings)))

;; Whether `expr` forms a place, through span and expansion wrappers. A field
;; of an array element is a field place of the element (Rust's `v[i].f`), not a
;; move of the whole element.
(define (tc-selected-place-expression? [ctx : TcContext] [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan expr)
    [(ast.AstExpr.Var _) true]
    [(ast.AstExpr.StructGet _ _) true]
    [(ast.AstExpr.TupleRef _ _) true]
    [(ast.AstExpr.ArrayRef _ _) true]
    ;; Box contents, `(*b)` in Rust: a field read projects them.
    [(ast.AstExpr.BoxTake _) true]
    [(ast.AstExpr.BoxGet _) true]
    [(ast.AstExpr.MacroExpansion expanded _ _)
      (tc-selected-place-expression? ctx (tc-context-expr-get ctx expanded))]
    [_ false]))

;; A reference not matched in place (to a struct or a scalar): its arms are
;; bindings and wildcards (a scalar match), so it is matched by value and a
;; binding takes the reference itself.
(define (tc-selected-reference-scrutinee? [ctx : TcContext] [ty : ast.AstType]) : bool
  (match (tc-selected-canonical-type ctx (tc-resolve-type ctx ty))
    [(ast.AstType.Ref _ _) true]
    [(ast.AstType.MutRef _ _) true]
    [_ false]))

;; A by-value scrutinee type: no outer region and no reference.
;; A region tag on a Copy scrutinee (read through a reference) is dropped: it
;; is matched by value like any Copy value.
(define (tc-selected-owned-scrutinee? [ctx : TcContext] [ty : ast.AstType]) : bool
  (match (tc-selected-canonical-type ctx (tc-resolve-type ctx ty))
    [(ast.AstType.Region _ _) false]
    [(ast.AstType.Ref _ _) false]
    [(ast.AstType.MutRef _ _) false]
    [_ true]))

;; The matched type of a borrowed scrutinee: a reference's referent, or the
;; enum a region-tagged view reads in place.
(define (tc-selected-borrowed-top [ctx : TcContext] [ty : ast.AstType]) : ast.AstType
  (let
    [stripped : ast.AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
    (match (& stripped)
      [(ast.AstType.Ref _ _)
        (tc-resolve-type ctx (tc-selected-referent ctx stripped))]
      [(ast.AstType.MutRef _ _)
        (tc-resolve-type ctx (tc-selected-referent ctx stripped))]
      [_ stripped])))

;; `ty` without its outer arena region tags: an arena region marks where a
;; value is allocated (the ownership graph erases it), not a borrow.
(define (tc-selected-strip-arena-tags
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : ast.AstType]) : ast.AstType
  (match (tc-resolve-type ctx (tc-global-shared-view ty))
    [(ast.AstType.Region region inner)
      (if (tc-selected-arena-region? env region)
        (tc-selected-strip-arena-tags ctx env (ast.ty-node-get inner))
        ty)]
    [_ ty]))

;; A region-tagged view of an enum (a value read through a reference): matched
;; in place like a shared borrow of it, its bindings are views too.
(define (tc-selected-view-scrutinee? [ctx : TcContext] [ty : ast.AstType]) : bool
  (let
    [resolved : ast.AstType (tc-resolve-type ctx ty)]
    (and
      (tc-selected-view-type? ctx (tc-global-shared-view resolved))
      (not (tc-type-copyable? ctx (tc-global-shared-view resolved)))
      (match (tc-type-strip-region resolved)
        [(ast.AstType.Enum _) true]
        [(ast.AstType.EnumArgs _ _) true]
        [_ false]))))

;; A shared reference to an enum, a struct, a tuple or a fixed array (outer
;; regions aside, as legacy matches it): its bindings are references into the
;; referent (SPEC 5.13).
(define (tc-selected-borrowed-scrutinee? [ctx : TcContext] [ty : ast.AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(ast.AstType.Ref _ inner)
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-context-type-get ctx inner)))
        [(ast.AstType.Enum _) true]
        [(ast.AstType.EnumArgs _ _) true]
        [(ast.AstType.Struct _) true]
        [(ast.AstType.StructArgs _ _) true]
        [(ast.AstType.Tuple _) true]
        [(ast.AstType.Array _ _) true]
        [_ false])]
    [_ false]))

;; Whether a place's path goes through a dereference: 0 for none, 1 for box
;; contents only, 2 through a referent. The ownership graph reaches such a part
;; as an indexed part of the box or loan, not a named position, so a by-value
;; match reads box contents as a value (a copy, or a move that consumes the
;; box) and matches a referent's part through a borrow.
(define (tc-selected-place-deref-kind
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [place : i64]) : i64
  (let
    [cursor : i64 place]
    [kind : i64 0]
    (while (and (< kind 2) (>= cursor 0))
      (let
        [link : TcSelectedPlaceLink
          (match (typed.typed-place-at! store lease cursor)
            [(typed.TypedPlaceResult.Err _) TcSelectedPlaceLink.None]
            [(typed.TypedPlaceResult.Ok id)
              (match (typed.typed-place-get! store lease id)
                [(typed.TypedPlaceView.Err _) TcSelectedPlaceLink.None]
                [(typed.TypedPlaceView.Ok row)
                  (match (& row.kind)
                    [(typed.TypedPlaceKind.Root root)
                      (TcSelectedPlaceLink.Root root.handle.index)]
                    [(typed.TypedPlaceKind.Projection parent step)
                      (TcSelectedPlaceLink.Step
                        parent.handle.index
                        (typed.TypedProjectionId
                          (typed.typed-handle-copy (& step.handle))))])])])]
        (match link
          [(TcSelectedPlaceLink.Step parent step)
            (match (typed.typed-projection-get! store lease step)
              [(typed.TypedProjectionView.Ok projection)
                (match (& projection.kind)
                  [(typed.TypedProjectionKind.Deref)
                    (set!
                      kind
                      (if (tc-selected-place-reference? store lease parent)
                        2
                        1))]
                  [_ unit])]
              [(typed.TypedProjectionView.Err _) unit])
            (set! cursor parent)]
          [_ (set! cursor -1)])))
    kind))

;; Whether the place at `index` holds a reference (its deref is a referent).
(define (tc-selected-place-reference?
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [index : i64]) : bool
  (match (typed.typed-place-at! store lease index)
    [(typed.TypedPlaceResult.Err _) false]
    [(typed.TypedPlaceResult.Ok id)
      (match (typed.typed-place-get! store lease id)
        [(typed.TypedPlaceView.Err _) false]
        [(typed.TypedPlaceView.Ok row)
          (match (typed.typed-type-value-at! store lease row.type.handle.index)
            [(typed.TypedTypeValueResult.Ok value)
              (match (tc-type-strip-region value)
                [(ast.AstType.Ref _ _) true]
                [(ast.AstType.MutRef _ _) true]
                [_ false])]
            [(typed.TypedTypeValueResult.Err _) false])])]))

;; The sink, and whether the scrutinee place goes through a dereference (box
;; contents, or a referent).
(defenum TcSelectedDerefProbe
  (:lifetimes store lease intern bind)
  (Deref (TcSelectedSink store lease intern bind))
  (Referent (TcSelectedSink store lease intern bind))
  (Direct (TcSelectedSink store lease intern bind)))

(define (tc-selected-probe-deref
  [place : i64]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedDerefProbe
    store
    lease
    intern
    bind)
  (match sink
    [(TcSelectedSink.Query) (TcSelectedDerefProbe.Direct TcSelectedSink.Query)]
    [(TcSelectedSink.Capture store lease bindings)
      (let
        [kind : i64 (tc-selected-place-deref-kind store lease place)]
        (cond
          [(= kind 2)
            (TcSelectedDerefProbe.Referent
              (TcSelectedSink.Capture store lease bindings))]
          [(= kind 1)
            (TcSelectedDerefProbe.Deref
              (TcSelectedSink.Capture store lease bindings))]
          [else
            (TcSelectedDerefProbe.Direct
              (TcSelectedSink.Capture store lease bindings))]))]))

;; A move-only scrutinee place reached through a reference, a view of the
;; referent's part (its type carries the reference's region), matched through
;; a shared reborrow of the place (mode 2). Its patterns bind views of its
;; parts, and a view of a move-only part reaching an owned slot (an arm's
;; value, a return) would move it out from behind the reference: rejected.
(define (tc-selected-referent-scrutinee
  [ty : ast.AstType]
  [id : typed.TypedPlaceId]
  [indices : (__tl_dyn-array typed.TypedOccurrenceId)]
  [scrut-id : i64]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedScrutinee
    store
    lease
    intern
    bind)
  (match (tc-type-outer-region (tc-global-shared-view ty))
    [(TcMaybeNameId.No) (TcSelectedScrutinee.Legacy sink)]
    [(TcMaybeNameId.Some _)
      (match (tc-selected-publish-borrow
        (tc-global-shared-view ty)
        false
        id
        indices
        (typed.TypedSyntax.Source scrut-id)
        source
        sink)
        [(TcSelectedResult.Err message next)
          (TcSelectedScrutinee.Err message next)]
        [(TcSelectedResult.Ok _ occurrence next)
          (match occurrence
            [(TcSelectedOccurrence.Unrepresented)
              (TcSelectedScrutinee.Legacy next)]
            [(TcSelectedOccurrence.Selected value)
              (TcSelectedScrutinee.Ok ty 2 value TcSelectedMaybePlace.No next)])])]))

;; The region a matched-in-place array element's view carries: its root
;; local's name, or a fixed one for an element of a computed array (any region
;; that is not an arena's marks a view).
(define (tc-selected-element-view-lifetime
  [ctx : TcContext]
  [expr : ast.AstExpr]) : i64
  (match (ast.ast-expr-unspan expr)
    [(ast.AstExpr.Var name) name]
    [(ast.AstExpr.ArrayRef base _)
      (tc-selected-element-view-lifetime ctx (tc-context-expr-get ctx base))]
    [(ast.AstExpr.StructGet base _)
      (tc-selected-element-view-lifetime ctx (tc-context-expr-get ctx base))]
    [(ast.AstExpr.TupleRef base _)
      (tc-selected-element-view-lifetime ctx (tc-context-expr-get ctx base))]
    [(ast.AstExpr.MacroExpansion expanded _ _)
      (tc-selected-element-view-lifetime ctx (tc-context-expr-get ctx expanded))]
    [_ (ci.intern "element")]))

;; A match on an array element whose arms all bind only Copy values (or
;; nothing): it moves nothing out of the element (Rust's place semantics).
(define (tc-selected-element-match-in-place?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-id : i64]
  [arms : (& arms ast.AstMatchArmList)]) : bool
  (and
    (tc-selected-element-place-expression?
      ctx
      (tc-context-expr-get ctx scrut-id))
    (match (tc-expr-id ctx env scrut-id)
      [(ResultTcType.Ok scrut-ty)
        (tc-semantic-unobserved
          ctx
          (tc-selected-arms-bind-copy-only? ctx env scrut-ty arms))]
      [(ResultTcType.Err _) false])))

(define (tc-selected-arms-bind-copy-only?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : ast.AstType]
  [arms : (& arms ast.AstMatchArmList)]) : bool
  (let
    [index : i64 0]
    [ok : bool true]
    (while (and ok (< index arms.len))
      (begin
        (match (ast.ast-match-arm-list-get
          arms
          index
          (ast.ast-match-arm-fallback))
          [(ast.AstMatchArm.Arm pattern _)
            (let
              [saved : TcTypeEnvScopedRuntimeSave
                (tc-type-env-scoped-runtime-save env)]
              [checked : bool
                (match (tc-bind-match-pattern
                  ctx
                  env
                  (tc-global-shared-view scrut-ty)
                  (tc-global-shared-view pattern))
                  [(ResultTcEnv.Ok arm-env)
                    (let
                      [names : TcNameIdList
                        (tc-pattern-add-bound-name-ids
                          (tc-global-shared-view pattern)
                          TcNameIdList.Nil)]
                      [all : bool true]
                      (while (and all (not (tc-name-id-list-empty? names)))
                        (begin
                          (match (tc-lookup-id
                            arm-env
                            (tc-name-id-list-head names))
                            [(ResultTcType.Ok bound)
                              (unless
                                (tc-type-copyable? ctx bound)
                                (set! all false))]
                            [(ResultTcType.Err _) (set! all false)])
                          (set! names (tc-name-id-list-rest names))))
                      all)]
                  [(ResultTcEnv.Err _) false])]
              (tc-type-env-scoped-runtime-restore! saved)
              (set! ok checked))])
        (set! index (+ index 1))))
    ok))

(define (tc-infer-selected-scrutinee
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-id : i64]
  ;; Every arm binds only Copy values (`tc-selected-arms-bind-copy-only?`): a
  ;; move-only array element is matched in place rather than moved out.
  [in-place? : bool]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedScrutinee
    store
    lease
    intern
    bind)
  ;; A dereferenced scrutinee is read by value (`tc-selected-deref-opaque-ok`).
  (match (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-bases ctx)
    (& (tc-context-expr-get ctx scrut-id)))
    [(ast.AstExpr.BoxTake receiver)
      (tc-selected-deref-opaque-ok ctx env receiver)]
    [(ast.AstExpr.BoxGet receiver)
      (tc-selected-deref-opaque-ok ctx env receiver)]
    [_ ResultTcUnit.Ok])
    [(ResultTcUnit.Err message) (TcSelectedScrutinee.Err message sink)]
    [(ResultTcUnit.Ok)
      (let
        [scrut : ast.AstExpr (tc-context-expr-get ctx scrut-id)]
        (if (tc-selected-place-expression? ctx (tc-global-shared-view scrut))
          (match (tc-infer-selected-place-id
            ctx
            env
            scrut-id
            (tc-global-shared-view source)
            sink)
            [(TcSelectedPlaceResult.Err message next)
              (TcSelectedScrutinee.Err message next)]
            [(TcSelectedPlaceResult.Ok ty place next)
              (match place
                [(TcSelectedPlace.Selected id indices)
                  (match (tc-selected-probe-deref id.handle.index next)
                    [(TcSelectedDerefProbe.Deref after)
                      (tc-infer-selected-scrutinee-value
                        ctx
                        env
                        scrut-id
                        source
                        after)]
                    ;; A part of a referent is matched in place: a Copy value is
                    ;; copied out, and a move-only view is matched through a
                    ;; shared borrow of the place, binding views of its parts
                    ;; (`tc-selected-referent-scrutinee`).
                    [(TcSelectedDerefProbe.Referent after)
                      (if (or
                        (tc-type-copyable?
                          ctx
                          (tc-type-strip-region
                            (tc-resolve-type ctx (tc-global-shared-view ty))))
                        ;; A part not typed as a view (an element read through a
                        ;; reference) is read as a value: a move-only one moves
                        ;; out of its container, which the graph rejects.
                        (match (tc-type-outer-region (tc-global-shared-view ty))
                          [(TcMaybeNameId.Some _) false]
                          [(TcMaybeNameId.No) true]))
                        (tc-infer-selected-scrutinee-value
                          ctx
                          env
                          scrut-id
                          source
                          after)
                        (tc-selected-referent-scrutinee
                          ty
                          id
                          indices
                          scrut-id
                          source
                          after))]
                    [(TcSelectedDerefProbe.Direct after)
                      (if (and
                        in-place?
                        (> (array-length indices) 0)
                        (not
                          (tc-type-copyable?
                            ctx
                            (tc-type-strip-region
                              (tc-resolve-type ctx (tc-global-shared-view ty))))))
                        ;; An element whose arms bind only Copy parts moves nothing
                        ;; out (Rust's place semantics): it is matched as a view
                        ;; through a shared borrow of the element.
                        (tc-selected-referent-scrutinee
                          (ast.ast-ty-region
                            (tc-selected-element-view-lifetime
                              ctx
                              (tc-context-expr-get ctx scrut-id))
                            (& ty))
                          id
                          indices
                          scrut-id
                          source
                          after)
                        (if (let
                          [shape : ast.AstType
                            (tc-selected-strip-arena-tags
                              ctx
                              env
                              (tc-global-shared-view ty))]
                          (and
                            (= (array-length indices) 0)
                            (tc-selected-owned-scrutinee?
                              ctx
                              (tc-global-shared-view shape))
                            ;; A Copy value read through a reference is copied out.
                            (match (tc-resolve-type
                              ctx
                              (tc-global-shared-view shape))
                              [(ast.AstType.Region _ _) false]
                              [_ true])))
                          (match (tc-selected-position-form
                            (tc-global-shared-view ty)
                            id
                            (tc-global-shared-view source)
                            after)
                            [(TcSelectedResult.Ok
                                _
                                (TcSelectedOccurrence.Selected form)
                                settled)
                              (TcSelectedScrutinee.Ok
                                ty
                                0
                                form
                                (TcSelectedMaybePlace.Some id)
                                settled)]
                            [(TcSelectedResult.Ok _ _ settled)
                              (TcSelectedScrutinee.Legacy settled)]
                            [(TcSelectedResult.Err message settled)
                              (TcSelectedScrutinee.Err message settled)])
                          (tc-selected-view-binder-scrutinee
                            ctx
                            env
                            ty
                            id
                            indices
                            scrut-id
                            source
                            after)))])]
                [(TcSelectedPlace.Unrepresented)
                  (tc-infer-selected-scrutinee-value
                    ctx
                    env
                    scrut-id
                    source
                    next)])])
          (tc-infer-selected-scrutinee-value ctx env scrut-id source sink)))]))

;; A view binder (a value read through a reference, bound by value) is matched
;; through a fresh view of its referent, as a part read through a reference is
;; (`tc-selected-referent-scrutinee`): its bindings are views of that view's
;; parts, writable when its path is (`normalize-pattern-bindings!`). Any other
;; place is read as a value.
(define (tc-selected-view-binder-scrutinee
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : ast.AstType]
  [id : typed.TypedPlaceId]
  [indices : (__tl_dyn-array typed.TypedOccurrenceId)]
  [scrut-id : i64]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedScrutinee
    store
    lease
    intern
    bind)
  (let
    [root : i64 id.handle.index]
    (if (tc-selected-view-scrutinee?
      ctx
      (tc-selected-strip-arena-tags ctx env (tc-global-shared-view ty)))
      (match (tc-selected-view-receiver
        ctx
        env
        (tc-global-shared-view source)
        (TcSelectedPlaceResult.Ok
          (tc-global-shared-view ty)
          (TcSelectedPlace.Selected id indices)
          sink))
        [(TcSelectedPlaceResult.Ok
            _
            (TcSelectedPlace.Selected derefed parts)
            next)
          (if (= derefed.handle.index root)
            (tc-infer-selected-scrutinee-value ctx env scrut-id source next)
            (tc-selected-referent-scrutinee
              ty
              derefed
              parts
              scrut-id
              source
              next))]
        [(TcSelectedPlaceResult.Ok _ _ next)
          (tc-infer-selected-scrutinee-value ctx env scrut-id source next)]
        [(TcSelectedPlaceResult.Err message next)
          (TcSelectedScrutinee.Err message next)])
      (tc-infer-selected-scrutinee-value ctx env scrut-id source sink))))

;; The FormPlace of a by-value scrutinee place.
(define (tc-selected-position-form
  [ty : ast.AstType]
  [id : typed.TypedPlaceId]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match sink
    [(TcSelectedSink.Query)
      (TcSelectedResult.Ok
        ty
        TcSelectedOccurrence.Unrepresented
        TcSelectedSink.Query)]
    [(TcSelectedSink.Capture store lease bindings)
      (match (let
        [position : TcSelectedMaybePlace (TcSelectedMaybePlace.Some id)]
        (tc-selected-position-children! store lease (& position) (& source)))
        [(TcSelectedPatternChildren.Ok children)
          (TcSelectedResult.Ok
            ty
            (TcSelectedOccurrence.Selected
              (typed.TypedOccurrenceId
                (typed.typed-handle-copy (& (array-ref children 0).handle))))
            (TcSelectedSink.Capture store lease bindings))]
        [(TcSelectedPatternChildren.Err message)
          (TcSelectedResult.Err
            message
            (TcSelectedSink.Capture store lease bindings))])]))

(define (tc-infer-selected-scrutinee-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-id : i64]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedScrutinee
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-sequence-child
    ctx
    env
    scrut-id
    ast.AstMaybeType.No
    (tc-global-shared-view source)
    true
    sink)
    [(TcSelectedResult.Err message next) (TcSelectedScrutinee.Err message next)]
    [(TcSelectedResult.Ok ty occurrence next)
      (match occurrence
        [(TcSelectedOccurrence.Unrepresented) (TcSelectedScrutinee.Legacy next)]
        [(TcSelectedOccurrence.Selected value)
          (cond
            [(tc-selected-borrowed-scrutinee? ctx (tc-global-shared-view ty))
              (TcSelectedScrutinee.Ok ty 2 value TcSelectedMaybePlace.No next)]
            [(tc-selected-view-scrutinee?
                ctx
                (tc-selected-strip-arena-tags
                  ctx
                  env
                  (tc-global-shared-view ty)))
              (TcSelectedScrutinee.Ok ty 2 value TcSelectedMaybePlace.No next)]
            [(and
                (not
                  (tc-selected-reference-scrutinee?
                    ctx
                    (tc-global-shared-view ty)))
                (not
                  (tc-selected-owned-scrutinee?
                    ctx
                    (tc-selected-strip-arena-tags
                      ctx
                      env
                      (tc-global-shared-view ty)))))
              (TcSelectedScrutinee.Legacy next)]
            [else
              (match next
                [(TcSelectedSink.Query)
                  (TcSelectedScrutinee.Legacy TcSelectedSink.Query)]
                [(TcSelectedSink.Capture store lease bindings)
                  (tc-selected-scrutinee-binder!
                    ty
                    value
                    source
                    store
                    lease
                    bindings)])])])]))

;; A by-value scrutinee that is not a place lives in a synthetic binder.
;; Unit, or Never when the initializing `value` diverges: an initialization
;; published outside `tc-selected-publish` takes the same intrinsic result.
(define (tc-selected-initialization-type!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [value : typed.TypedOccurrenceId]) : ast.AstType
  (match (tc-selected-occurrence-never! store lease value)
    [(TcSelectedBoolResult.Ok never?)
      (if never?
        ast.AstType.Never
        ast.AstType.Unit)]
    [(TcSelectedBoolResult.Err _) ast.AstType.Unit]))

(define (tc-selected-scrutinee-binder!
  [ty : ast.AstType]
  [value : typed.TypedOccurrenceId]
  [source : ownership.OwnershipSource]
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [bindings : (&mut bind TcSelectedBindings)]) : (TcSelectedScrutinee
    store
    lease
    intern
    bind)
  (let
    [type-id : typed.TypedTypeId
      (match (typed.typed-type-add! store lease (tc-global-shared-view ty))
        [(typed.TypedTypeIdResult.Ok id) id]
        [(typed.TypedTypeIdResult.Err error)
          (return (tc-selected-scrutinee-failed error store lease bindings))])]
    ;; The initialization's own result: Never when its value diverges
    ;; (`tc-selected-flow-never!`).
    [unit-id : typed.TypedTypeId
      (match (typed.typed-type-add!
        store
        lease
        (tc-selected-initialization-type!
          store
          lease
          (typed.TypedOccurrenceId (typed.typed-handle-copy (& value.handle)))))
        [(typed.TypedTypeIdResult.Ok id) id]
        [(typed.TypedTypeIdResult.Err error)
          (return (tc-selected-scrutinee-failed error store lease bindings))])]
    [origin : typed.TypedOriginId
      (match (typed.typed-origin-add!
        store
        lease
        (ownership.ownership-source-copy (& source)))
        [(typed.TypedOriginResult.Ok id) id]
        [(typed.TypedOriginResult.Err error)
          (return (tc-selected-scrutinee-failed error store lease bindings))])]
    [binder : typed.TypedBinderId
      (match (typed.typed-binder-add!
        store
        lease
        type-id
        typed.TypedBinderKind.Local
        (typed.TypedOriginId (typed.typed-handle-copy (& origin.handle)))
        -1)
        [(typed.TypedBinderResult.Ok id) id]
        [(typed.TypedBinderResult.Err error)
          (return (tc-selected-scrutinee-failed error store lease bindings))])]
    [place : typed.TypedPlaceId
      (match (typed.typed-place-add!
        store
        lease
        (typed.TypedPlaceKind.Root
          (typed.TypedBinderId (typed.typed-handle-copy (& binder.handle)))))
        [(typed.TypedPlaceResult.Ok id) id]
        [(typed.TypedPlaceResult.Err error)
          (return (tc-selected-scrutinee-failed error store lease bindings))])]
    [children : (__tl_dyn-array typed.TypedOccurrenceId)
      (__tl_make-array typed.TypedOccurrenceId 1)]
    (set! (array-ref children 0) value)
    (match (typed.typed-occurrence-add!
      store
      lease
      unit-id
      typed.TypedSyntax.Generated
      origin
      (typed.TypedOperation.Initialize binder)
      (& children))
      [(typed.TypedOccurrenceResult.Ok id)
        (TcSelectedScrutinee.Ok
          ty
          1
          id
          (TcSelectedMaybePlace.Some place)
          (TcSelectedSink.Capture store lease bindings))]
      [(typed.TypedOccurrenceResult.Err error)
        (tc-selected-scrutinee-failed error store lease bindings)])))

;; An expression typed by numeric literal defaulting alone: a literal, or an
;; arithmetic operation, conditional or sequence over such values.
(define (tc-selected-literal-typed-expr? [ctx : TcContext] [expr : ast.AstExpr]) : bool
  (or
    (tc-integer-literal-expr? ctx (tc-global-shared-view expr))
    (tc-float-literal-expr? ctx (tc-global-shared-view expr))
    (match (ast.ast-expr-unspan-with-segment-bases
      (tc-context-expr-bases ctx)
      expr)
      [(ast.AstExpr.Binary op left right)
        (and
          (match op
            [(ast.AstBinOp.Add) true]
            [(ast.AstBinOp.Sub) true]
            [(ast.AstBinOp.Mul) true]
            [(ast.AstBinOp.Div) true]
            [(ast.AstBinOp.Mod) true]
            [_ false])
          (tc-selected-literal-typed-expr? ctx (tc-context-expr-get ctx left))
          (tc-selected-literal-typed-expr? ctx (tc-context-expr-get ctx right)))]
      [(ast.AstExpr.Unary (ast.AstUnOp.Neg) operand)
        (tc-selected-literal-typed-expr? ctx (tc-context-expr-get ctx operand))]
      [(ast.AstExpr.If _ then-id else-id)
        (and
          (tc-selected-literal-typed-expr?
            ctx
            (tc-context-expr-get ctx then-id))
          (tc-selected-literal-typed-expr?
            ctx
            (tc-context-expr-get ctx else-id)))]
      [(ast.AstExpr.Begin exprs)
        (and
          (> exprs.len 0)
          (tc-selected-literal-typed-expr?
            ctx
            (tc-context-expr-get
              ctx
              (ast.ast-expr-list-get (& exprs) (- exprs.len 1) 0))))]
      [_ false])))

;; The type a match's arms are checked against. Without an expected type, an
;; arm typed by literal defaulting alone (to i32 or f64) is retyped by legacy
;; typing against the other arms (`tc-check-match-arm-types-from-first-at`);
;; the arms then check against the match's legacy type, as they would under an
;; expected type.
(define (tc-selected-match-arm-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [arms : (& arms ast.AstMatchArmList)]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]) : ast.AstMaybeType
  (match expected
    [(ast.AstMaybeType.Some want) (ast.AstMaybeType.Some want)]
    [(ast.AstMaybeType.No)
      (let
        [index : i64 0]
        [literal? : bool false]
        (while (and (not literal?) (< index arms.len))
          (begin
            (match (ast.ast-match-arm-list-get
              arms
              index
              (ast.ast-match-arm-fallback))
              [(ast.AstMatchArm.Arm _ body-id)
                (let
                  [body : ast.AstExpr (tc-context-expr-get ctx body-id)]
                  (when
                    (tc-selected-literal-typed-expr? ctx body)
                    (set! literal? true)))])
            (set! index (+ index 1))))
        (if literal?
          (match (tc-infer-selected-legacy
            ctx
            env
            expr
            syntax
            ast.AstMaybeType.No)
            [(ResultTcType.Ok ty) (ast.AstMaybeType.Some ty)]
            [(ResultTcType.Err _) ast.AstMaybeType.No])
          ast.AstMaybeType.No))]))

(define (tc-infer-selected-match
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [match-box : (Box ast.AstMatch)]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match sink
    [(TcSelectedSink.Query)
      (tc-selected-unrepresented
        (tc-infer-selected-legacy ctx env expr syntax expected)
        TcSelectedSink.Query)]
    [(TcSelectedSink.Capture store lease bindings)
      (match (ast.ast-match-box-shared-view match-box)
        [(ast.AstMatch.Match scrut-id arms)
          (match (tc-infer-selected-scrutinee
            ctx
            env
            scrut-id
            (tc-selected-element-match-in-place? ctx env scrut-id (& arms))
            (tc-global-shared-view source)
            (TcSelectedSink.Capture store lease bindings))
            [(TcSelectedScrutinee.Err message next)
              (TcSelectedResult.Err message next)]
            [(TcSelectedScrutinee.Legacy next)
              (tc-selected-unrepresented
                (tc-infer-selected-legacy ctx env expr syntax expected)
                next)]
            [(TcSelectedScrutinee.Ok scrut-ty mode scrutinee position next)
              (let
                [coverage : ast.AstType
                  (tc-match-coverage-type ctx (tc-global-shared-view scrut-ty))]
                [top-ty : ast.AstType
                  (if (= mode 2)
                    (tc-selected-borrowed-top
                      ctx
                      (tc-global-shared-view scrut-ty))
                    (tc-global-shared-view scrut-ty))]
                [arm-types : (__tl_dyn-array ast.AstType)
                  (__tl_make-array ast.AstType arms.len)]
                [children : (__tl_dyn-array typed.TypedOccurrenceId)
                  (__tl_make-array typed.TypedOccurrenceId (+ arms.len 1))]
                (match (tc-match-arm-reachability-ok
                  ctx
                  (tc-global-shared-view coverage)
                  (tc-global-shared-view arms))
                  [(ResultTcUnit.Err message)
                    (return (TcSelectedResult.Err message next))]
                  [(ResultTcUnit.Ok) unit])
                (set! (array-ref children 0) scrutinee)
                (match (tc-selected-sink-never!
                  next
                  (typed.TypedOccurrenceId
                    (typed.typed-handle-copy (& (array-ref children 0).handle))))
                  [(TcSelectedNeverCheck.Checked diverged? next)
                    (match (tc-infer-selected-match-arms
                      ctx
                      env
                      scrut-ty
                      top-ty
                      position
                      (& arms)
                      0
                      (tc-selected-match-arm-expected
                        ctx
                        env
                        (tc-global-shared-view expr)
                        (& arms)
                        (tc-global-shared-view syntax)
                        (tc-global-shared-view expected))
                      ast.AstType.Never
                      arm-types
                      children
                      (and (> arms.len 0) (not diverged?))
                      (& syntax)
                      (tc-global-shared-view source)
                      next)
                      [(TcSelectedArmsResult.Err message after)
                        (TcSelectedResult.Err message after)]
                      [(TcSelectedArmsResult.Legacy after)
                        (tc-selected-unrepresented
                          (tc-infer-selected-legacy
                            ctx
                            env
                            expr
                            syntax
                            expected)
                          after)]
                      [(TcSelectedArmsResult.Ok
                          merged
                          represented?
                          arm-types
                          children
                          after)
                        (match (tc-match-exhaustiveness-ok
                          ctx
                          (tc-global-shared-view coverage)
                          (tc-global-shared-view arms))
                          [(ResultTcUnit.Err message)
                            (TcSelectedResult.Err message after)]
                          [(ResultTcUnit.Ok)
                            (let
                              [index : i64 0]
                              [joined? : bool represented?]
                              (while (< index arms.len)
                                (unless
                                  (or
                                    (match (owned_view.compiler-owned-element-view
                                      arm-types
                                      index)
                                      [(ast.AstType.Never) true]
                                      [_ false])
                                    ;; As an `if` joins its branches: a
                                    ;; region tag on a Copy value aside.
                                    (tc-selected-aligned-type?
                                      ctx
                                      (tc-global-array-element-shared-view
                                        arm-types
                                        index)
                                      (tc-global-shared-view merged)))
                                  (set! joined? false))
                                (set! index (+ index 1)))
                              (cond
                                ;; The arms after a diverging scrutinee never
                                ;; run: the match is its scrutinee's evaluation,
                                ;; an exit (the arms are still typed).
                                [diverged?
                                  (TcSelectedResult.Ok
                                    merged
                                    (TcSelectedOccurrence.Selected
                                      (typed.TypedOccurrenceId
                                        (typed.typed-handle-copy
                                          (& (array-ref children 0).handle))))
                                    after)]
                                [joined?
                                  (tc-selected-publish-flow
                                    (ResultTcType.Ok merged)
                                    syntax
                                    source
                                    (typed.TypedOperation.Match (= mode 2))
                                    children
                                    after)]
                                [else
                                  (TcSelectedResult.Ok
                                    merged
                                    TcSelectedOccurrence.Unrepresented
                                    after)]))])])]))])])]))

;; --- In-arena (#8449) ---------------------------------------------------------
;;
;; `(in-arena arena body ...)` (SPEC first-class arena target) typed as
;; `tc-in-arena-expr`: the arena operand is read (a bare handle; a tracked
;; owner or a branded target keeps the legacy route), the body is a sequence
;; typed in the arena's body environment, and the result is the body's value.
(define (tc-infer-selected-in-arena
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arena-id : i64]
  [body : ast.AstExprList]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    [saved : TcTypeEnvScopedRuntimeSave
      (tc-type-env-scoped-runtime-enter-env! env)]
    [result : (TcSelectedResult store lease intern bind)
      (tc-infer-selected-in-arena-at
        ctx
        env
        arena-id
        (& body)
        syntax
        expected
        source
        sink)]
    (tc-type-env-scoped-runtime-restore! saved)
    result))

(define (tc-infer-selected-in-arena-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arena-id : i64]
  [body : (& body ast.AstExprList)]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (if (tc-selected-arena-handle-operand? ctx env arena-id)
    (match (tc-expr-id ctx env arena-id)
      [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
      [(ResultTcType.Ok owner-ty)
        (tc-infer-selected-arena-handle
          ctx
          env
          arena-id
          owner-ty
          (tc-global-shared-view source)
          sink)])
    (tc-infer-selected-operand
      ctx
      env
      arena-id
      (tc-global-shared-view source)
      sink))
    [(TcSelectedResult.Err message next) (TcSelectedResult.Err message next)]
    [(TcSelectedResult.Ok arena-ty arena-occurrence noted)
      (let
        [next : (TcSelectedSink store lease intern bind)
          (match (tc-in-arena-region
            ctx
            env
            (tc-context-expr-get ctx arena-id)
            (tc-global-shared-view arena-ty))
            [(TcMaybeNameId.Some region)
              (match (tc-selected-note-arena-region noted region)
                [(TcSelectedNoteResult.Ok after) after]
                [(TcSelectedNoteResult.Err message after)
                  (return (TcSelectedResult.Err message after))])]
            [(TcMaybeNameId.No) noted])]
        (if (not
          (tc-arena-allocation-target? ctx (tc-global-shared-view arena-ty)))
          (TcSelectedResult.Err
            (tc-kind-message
              (cdiag.CompilerTypecheckKind.ArenaOwnership)
              "typecheck: in-arena arena must be Arena")
            next)
          (let
            [arena : ast.AstExpr (tc-context-expr-get ctx arena-id)]
            [body-env : TcTypeEnv
              (tc-in-arena-body-env
                ctx
                env
                (tc-global-shared-view arena)
                (tc-global-shared-view arena-ty))]
            (match (tc-infer-selected-begin
              ctx
              body-env
              body
              typed.TypedSyntax.Generated
              expected
              (tc-global-shared-view source)
              next)
              [(TcSelectedResult.Err message after)
                (TcSelectedResult.Err message after)]
              [(TcSelectedResult.Ok body-ty body-occurrence after)
                (let
                  [result-ty : ast.AstType
                    (tc-in-arena-body-result
                      ctx
                      env
                      (tc-global-shared-view arena)
                      (tc-global-shared-view arena-ty)
                      (tc-global-shared-view body-ty))]
                  (match arena-occurrence
                    [(TcSelectedOccurrence.Selected arena-child)
                      (match body-occurrence
                        [(TcSelectedOccurrence.Selected body-child)
                          (if (or
                            (tc-selected-same-type?
                              (tc-global-shared-view result-ty)
                              (tc-global-shared-view body-ty))
                            (and
                              (or
                                ;; A Copy value read from arena storage leaves
                                ;; with the arena's tag erased: a copy of the
                                ;; value.
                                (tc-type-copyable?
                                  ctx
                                  (tc-global-shared-view body-ty))
                                ;; An untagged body value (a fresh literal in a
                                ;; scratch body) takes the arena's tag: only a
                                ;; tag is added, and the graph erases tags.
                                (match (tc-type-outer-region
                                  (tc-global-shared-view body-ty))
                                  [(Some _) false]
                                  [(No) true]))
                              (tc-selected-same-type?
                                (tc-selected-strip-arena-tags
                                  ctx
                                  body-env
                                  (tc-global-shared-view result-ty))
                                (tc-selected-strip-arena-tags
                                  ctx
                                  body-env
                                  (tc-global-shared-view body-ty)))))
                            (let
                              [children : (__tl_dyn-array
                                typed.TypedOccurrenceId)
                                (__tl_make-array typed.TypedOccurrenceId 2)]
                              (set! (array-ref children 0) arena-child)
                              (set! (array-ref children 1) body-child)
                              (tc-selected-publish
                                (ResultTcType.Ok result-ty)
                                syntax
                                source
                                (typed.TypedOperation.Primitive
                                  (typed.TypedPrimitive.Builtin
                                    (tc-selected-form-code-in-arena)
                                    2))
                                children
                                after))
                            (TcSelectedResult.Ok
                              result-ty
                              TcSelectedOccurrence.Unrepresented
                              after))]
                        [(TcSelectedOccurrence.Unrepresented)
                          (TcSelectedResult.Ok
                            result-ty
                            TcSelectedOccurrence.Unrepresented
                            after)])]
                    [(TcSelectedOccurrence.Unrepresented)
                      (TcSelectedResult.Ok
                        result-ty
                        TcSelectedOccurrence.Unrepresented
                        after)]))]))))]))

;; `(ann e : T)` typed as legacy `tc-expr-inner`: `e` is typed against `T` and
;; must be compatible with it. The form is `e` itself when its checked type is
;; `e`'s own; a coercion (a subtype, `never` at another type) keeps the legacy
;; route.
(define (tc-infer-selected-ann
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [inner-id : i64]
  [ty-id : i64]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    [want-ty : ast.AstType
      (tc-resolve-type ctx (tc-context-type-get ctx ty-id))]
    (match (tc-infer-selected-result-id
      ctx
      env
      (& syntax)
      inner-id
      (ast.AstMaybeType.Some (tc-global-shared-view want-ty))
      source
      sink)
      [(TcSelectedResult.Err message next) (TcSelectedResult.Err message next)]
      [(TcSelectedResult.Ok got occurrence next)
        (match (tc-expect
          (tc-global-shared-view got)
          (tc-global-shared-view want-ty)
          "typecheck: annotation type mismatch")
          [(ResultTcUnit.Err message) (TcSelectedResult.Err message next)]
          [(ResultTcUnit.Ok)
            (if (or
              (tc-type-contains-any-region (tc-global-shared-view got))
              (tc-selected-same-type?
                (tc-global-shared-view got)
                (tc-global-shared-view want-ty)))
              (TcSelectedResult.Ok got occurrence next)
              (tc-selected-unrepresented
                (tc-infer-selected-legacy ctx env expr syntax expected)
                next))])])))

;; --- With-arena (#8449) ------------------------------------------------------
;;
;; `(with-arena r body ...)` (SPEC 3.9) typed as `tc-with-region-expr`: the body
;; is a sequence typed with `r` pushed as an arena region, whose tags the
;; ownership graph erases like an in-arena target's (stores of region-tagged
;; values into outer places are checked where they happen). The form's value is
;; the body's; a result that still carries `r` would escape the reset, and
;; legacy typing reports that escape with its spans.
(define (tc-infer-selected-with-region
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [region : i64]
  [body : ast.AstExprList]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    [saved : TcTypeEnvScopedRuntimeSave
      (tc-type-env-scoped-runtime-enter-env! env)]
    [result : (TcSelectedResult store lease intern bind)
      (tc-infer-selected-with-region-at
        ctx
        env
        expr
        region
        (& body)
        syntax
        expected
        source
        sink)]
    (tc-type-env-scoped-runtime-restore! saved)
    result))

(define (tc-infer-selected-with-region-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [region : i64]
  [body : (& body ast.AstExprList)]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-selected-note-arena-region sink region)
    [(TcSelectedNoteResult.Err message next)
      (TcSelectedResult.Err message next)]
    [(TcSelectedNoteResult.Ok noted)
      (match (tc-infer-selected-begin
        ctx
        (tc-push-region env region)
        body
        (tc-global-shared-view syntax)
        (tc-global-shared-view expected)
        (tc-global-shared-view source)
        noted)
        [(TcSelectedResult.Err message after)
          (TcSelectedResult.Err message after)]
        [(TcSelectedResult.Ok body-ty occurrence after)
          (if (tc-type-contains-region (tc-global-shared-view body-ty) region)
            (tc-selected-unrepresented
              (tc-infer-selected-legacy ctx env expr syntax expected)
              after)
            (TcSelectedResult.Ok body-ty occurrence after))])]))

;; A scratch form's body, checked under a region scoped to the form (#8776,
;; `tc-scratch-body-type`): its allocations cannot outlive it through a store,
;; a global, a capture or an exit, while a by-value argument to an ordinary
;; call still checks.
(define (tc-infer-selected-scratch-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [body : (& body ast.AstExprList)]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    [saved : TcTypeEnvScopedRuntimeSave
      (tc-type-env-scoped-runtime-enter-env! env)]
    [result : (TcSelectedResult store lease intern bind)
      (tc-infer-selected-begin
        ctx
        (tc-push-region env (tc-scratch-body-region body))
        body
        typed.TypedSyntax.Generated
        expected
        source
        sink)]
    (tc-type-env-scoped-runtime-restore! saved)
    result))

;; `with-scratch` and `with-escape` (SPEC clone-out): legacy typing decides
;; the result (the body's value with its scratch regions erased, a supported
;; clone-out type). The body is an ordinary block whose value is consumed by
;; the clone-out; the result is a fresh value. A `with-escape` scratch owner
;; is read through a borrow, never moved.
(define (tc-infer-selected-scratch
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [scratch-id : i64]
  [body : (& body ast.AstExprList)]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-legacy
    ctx
    env
    expr
    syntax
    (tc-global-shared-view expected))
    [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcType.Ok ty)
      (match (cond
        [(< scratch-id 0)
          (TcSelectedResult.Ok
            ast.AstType.Unit
            TcSelectedOccurrence.Unrepresented
            sink)]
        [(tc-selected-arena-handle-operand? ctx env scratch-id)
          (match (tc-expr-id ctx env scratch-id)
            [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
            [(ResultTcType.Ok scratch-ty)
              (tc-infer-selected-arena-handle
                ctx
                env
                scratch-id
                scratch-ty
                (tc-global-shared-view source)
                sink)])]
        [else
          (tc-infer-selected-operand
            ctx
            env
            scratch-id
            (tc-global-shared-view source)
            sink)])
        [(TcSelectedResult.Err message next)
          (TcSelectedResult.Err message next)]
        [(TcSelectedResult.Ok _ scratch next)
          (match (tc-infer-selected-scratch-body
            ctx
            env
            body
            expected
            (tc-global-shared-view source)
            next)
            [(TcSelectedResult.Err message after)
              (TcSelectedResult.Err message after)]
            [(TcSelectedResult.Ok _ value after)
              (match value
                [(TcSelectedOccurrence.Unrepresented)
                  (tc-selected-unrepresented (ResultTcType.Ok ty) after)]
                ;; A diverging body (a `return` or `break` out of the form)
                ;; never reaches the clone-out: the form is its evaluated
                ;; operands, in order. (The body's checked type may be a
                ;; contextual coercion of Never; its occurrence's is not.)
                [(TcSelectedOccurrence.Selected body-child)
                  (match (tc-selected-sink-never!
                    after
                    (typed.TypedOccurrenceId
                      (typed.typed-handle-copy (& body-child.handle))))
                    [(TcSelectedNeverCheck.Checked diverges after)
                      (if diverges
                        (let
                          [children : (__tl_dyn-array typed.TypedOccurrenceId)
                            (tc-selected-no-occurrences)]
                          (match scratch
                            [(TcSelectedOccurrence.Selected scratch-child)
                              (when
                                (>= scratch-id 0)
                                (tc-selected-occurrences-push!
                                  (&mut children)
                                  scratch-child))]
                            [(TcSelectedOccurrence.Unrepresented) unit])
                          (if (and
                            (>= scratch-id 0)
                            (= (array-length children) 0))
                            (tc-selected-unrepresented
                              (ResultTcType.Ok ty)
                              after)
                            (begin
                              (tc-selected-occurrences-push!
                                (&mut children)
                                body-child)
                              (tc-selected-publish-flow
                                (ResultTcType.Ok ast.AstType.Never)
                                syntax
                                source
                                typed.TypedOperation.Sequence
                                children
                                after))))
                        (if (< scratch-id 0)
                          (tc-selected-publish
                            (ResultTcType.Ok ty)
                            syntax
                            source
                            (typed.TypedOperation.Primitive
                              (typed.TypedPrimitive.Builtin
                                (tc-selected-form-code-with-scratch)
                                1))
                            (__tl_make-array body-child)
                            after)
                          (match scratch
                            [(TcSelectedOccurrence.Unrepresented)
                              (tc-selected-unrepresented
                                (ResultTcType.Ok ty)
                                after)]
                            [(TcSelectedOccurrence.Selected scratch-child)
                              (let
                                [children : (__tl_dyn-array
                                  typed.TypedOccurrenceId)
                                  (__tl_make-array typed.TypedOccurrenceId 2)]
                                (set! (array-ref children 0) scratch-child)
                                (set! (array-ref children 1) body-child)
                                (tc-selected-publish
                                  (ResultTcType.Ok ty)
                                  syntax
                                  source
                                  (typed.TypedOperation.Primitive
                                    (typed.TypedPrimitive.Builtin
                                      (tc-selected-form-code-with-escape)
                                      2))
                                  children
                                  after))])))])])])])]))

;; --- Arena owners (SPEC 5.16, #8449) -----------------------------------------
;;
;; Typing stays legacy-first (`tc-arena-owner-call-type-id`, `tc-phase-call`,
;; `tc-rewind-safe-call`, `tc-destroy-safe-call`). A branded owner `(Arena r)`
;; is move-only; a direct owner annotated with the bare `Arena` type and a
;; phase token are Copy handles in Affine binders, so a whole read moves them.
;; A bare `Arena` parameter, `phase` and an `in-arena` target read an owner
;; place through a shared borrow (form 123) and never move it. A safe destroy
;; or rewind consumes its owner place or token and then invalidates every
;; binder in scope whose type carries a region it ends (the legacy walker's
;; region scan, over every scoped slot, so a shadowed binder counts too).
(defenum TcSelectedNoteResult
  (:lifetimes store lease intern bind)
  (Ok (TcSelectedSink store lease intern bind))
  (Err String (TcSelectedSink store lease intern bind)))

;; Records an arena region of this body in its store (see
;; `typed.typed-arena-region-note!`).
(define (tc-selected-note-arena-region
  [sink : (TcSelectedSink store lease intern bind)]
  [region : i64]) : (TcSelectedNoteResult store lease intern bind)
  (match sink
    [(TcSelectedSink.Query) (TcSelectedNoteResult.Ok TcSelectedSink.Query)]
    [(TcSelectedSink.Capture store lease bindings)
      (match (typed.typed-arena-region-note! store lease region)
        [(typed.TypedResult.Err error)
          (TcSelectedNoteResult.Err
            (tc-selected-error error)
            (TcSelectedSink.Capture store lease bindings))]
        [(typed.TypedResult.Ok _)
          (TcSelectedNoteResult.Ok
            (TcSelectedSink.Capture store lease bindings))])]))

;; An owner operand read without moving it: a local's place of `Arena` type
;; holding an owner (a branded owner, or a tracked bare-annotated owner local).
;; A plain bare handle is an ordinary Copy read.
(define (tc-selected-arena-handle-operand?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [id : i64]) : bool
  (let
    [expr : ast.AstExpr (tc-context-expr-get ctx id)]
    (and
      (tc-selected-rooted-place? ctx (tc-global-shared-view expr))
      (match (tc-expr-id ctx env id)
        [(ResultTcType.Ok ty)
          (and
            (tc-arena-type? ctx (tc-global-shared-view ty))
            (or
              (not (tc-type-copyable? ctx (tc-global-shared-view ty)))
              (let
                [name : i64
                  (tc-expr-var-name-id
                    (tc-context-expr-segment-bases ctx)
                    (tc-global-shared-view expr))]
                (and (>= name 0) (tc-move-arena-owner-local? env name)))))]
        [(ResultTcType.Err _) false]))))

;; A local or parameter, or a field or tuple element path from one.
(define (tc-selected-rooted-place? [ctx : TcContext] [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan expr)
    [(ast.AstExpr.Var _) true]
    [(ast.AstExpr.StructGet receiver _)
      (tc-selected-rooted-place? ctx (tc-context-expr-get ctx receiver))]
    [(ast.AstExpr.TupleRef receiver _)
      (tc-selected-rooted-place? ctx (tc-context-expr-get ctx receiver))]
    [(ast.AstExpr.MacroExpansion expanded _ _)
      (tc-selected-rooted-place? ctx (tc-context-expr-get ctx expanded))]
    [_ false]))

;; `actual`, a branded arena owner, coerced to its bare `Arena` handle type.
(define (tc-selected-arena-erasure?
  [ctx : TcContext]
  [actual : ast.AstType]
  [ty : ast.AstType]) : bool
  (and
    (tc-arena-type? ctx (tc-global-shared-view actual))
    (not (tc-type-copyable? ctx (tc-global-shared-view actual)))
    (tc-arena-type? ctx (tc-global-shared-view ty))
    (tc-selected-same-type?
      (tc-resolve-type
        ctx
        (tc-selected-arena-bare-type ctx (tc-global-shared-view actual)))
      (tc-resolve-type ctx (tc-global-shared-view ty)))))

;; The bare handle type of an `Arena` type (a branded owner's brand dropped).
(define (tc-selected-arena-bare-type [ctx : TcContext] [ty : ast.AstType]) : ast.AstType
  (match (tc-arena-target ctx (tc-global-shared-view ty))
    [(TcArenaTarget.Target _ name _) (ast.AstType.Struct name)]
    [(TcArenaTarget.No) ty]))

;; The owner place `id` read as its bare handle: form 123 over `(& place)`.
;; The result is typed `ty` (the legacy type of the read).
(define (tc-infer-selected-arena-handle
  [ctx : TcContext]
  [env : TcTypeEnv]
  [id : i64]
  [ty : ast.AstType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-borrow
    ctx
    env
    false
    -1
    id
    false
    typed.TypedSyntax.Generated
    (tc-global-shared-view source)
    sink)
    [(TcSelectedResult.Err message next) (TcSelectedResult.Err message next)]
    [(TcSelectedResult.Ok _ borrow next)
      (match borrow
        [(TcSelectedOccurrence.Selected child)
          (match (tc-selected-publish
            (ResultTcType.Ok
              (tc-selected-arena-bare-type ctx (tc-global-shared-view ty)))
            (typed.TypedSyntax.Source id)
            source
            (typed.TypedOperation.Primitive
              (typed.TypedPrimitive.Builtin
                (tc-selected-form-code-arena-handle)
                1))
            (__tl_make-array child)
            next)
            [(TcSelectedResult.Err message after)
              (TcSelectedResult.Err message after)]
            [(TcSelectedResult.Ok _ occurrence after)
              (TcSelectedResult.Ok ty occurrence after)])]
        [(TcSelectedOccurrence.Unrepresented)
          (tc-selected-unrepresented (ResultTcType.Ok ty) next)])]))

;; Whether a value of type `ty` holds a region that ends: any region of an
;; `owners` brand (`tc-type-contains-arena-owner-region?`), the phase
;; `region` (-1 for none), or a region of `fed` (`tc-admitted-fed-regions`).
(define (tc-selected-type-ends-region?
  [env : TcTypeEnv]
  [ty : ast.AstType]
  [owners : TcNameIdList]
  [region : i64]
  [fed : TcNameIdList]) : bool
  (> (tc-selected-type-end-kind env ty owners region fed) 0))

;; How a value of type `ty` holds an ending region: 0 not at all, 1 a region
;; of the ended owners or phase itself, 2 only a region of `fed`.
(define (tc-selected-type-end-kind
  [env : TcTypeEnv]
  [ty : ast.AstType]
  [owners : TcNameIdList]
  [region : i64]
  [fed : TcNameIdList]) : i64
  (let
    [cursor : TcNameIdList owners]
    [found : bool
      (and
        (>= region 0)
        (tc-type-contains-region (tc-global-shared-view ty) region))]
    (while (and (not found) (not (tc-name-id-list-empty? cursor)))
      (when
        (tc-type-contains-arena-owner-region?
          env
          (tc-global-shared-view ty)
          (tc-name-id-list-head cursor))
        (set! found true))
      (set! cursor (tc-name-id-list-rest cursor)))
    (cond
      [found 1]
      [(tc-name-id-list-overlaps? (tc-type-collect-regions ty) fed) 2]
      [else 0])))

;; Whether `candidate` is a region the end of the `owners` (or of the phase
;; `region`, -1 for none) ends itself.
(define (tc-admitted-ended-region?
  [env : TcTypeEnv]
  [owners : TcNameIdList]
  [region : i64]
  [candidate : i64]) : bool
  (let
    [cursor : TcNameIdList owners]
    [found : bool (and (>= region 0) (= candidate region))]
    (while (and (not found) (not (tc-name-id-list-empty? cursor)))
      (when
        (or
          (= candidate (tc-name-id-list-head cursor))
          (tc-arena-region-owned-by-id?
            env
            (tc-name-id-list-head cursor)
            candidate))
        (set! found true))
      (set! cursor (tc-name-id-list-rest cursor)))
    found))

;; The regions this body's admitted stores (`tc-admitted-edge-note!`) can have
;; carried values of the ended `owners` or phase `region` into, closed over
;; chains of such stores. Lexical outlives does not survive an explicit
;; invalidation, so the end ends these regions too (#9445). A phase's
;; allocations are stored as values of its owner's brand `phase-brand`: a
;; rewind also ends every store of that brand's values recorded after the phase
;; was taken (`tc-admitted-phase-mark!`), which includes older values stored
;; then.
(define (tc-admitted-fed-regions
  [env : TcTypeEnv]
  [owners : TcNameIdList]
  [region : i64]
  [phase-brand : i64]) : TcNameIdList
  (if (<= env.abi-pad 0)
    Nil
    (let
      [state : TcTypeEnvScopedState (tc-type-env-scoped-state env)]
      [edges : (__tl_dyn-array i64) (tc-admitted-edges state)]
      [start : i64 (tc-admitted-start state)]
      [count : i64 (tc-admitted-count state)]
      ;; The phase's mark; without one every store of the brand counts.
      [mark : i64 count]
      [_marked : unit
        (when
          (>= region 0)
          (let
            [at : i64 start]
            (while (and (= mark count) (< at count))
              (when
                (and
                  (= (array-ref edges (* at 2)) region)
                  (< (array-ref edges (+ (* at 2) 1)) 0))
                (set! mark at))
              (set! at (+ at 1)))
            (when (= mark count) (set! mark (- start 1)))))]
      [fed : TcNameIdList Nil]
      [changed? : bool true]
      (while changed?
        (set! changed? false)
        (let
          [at : i64 start]
          (while (< at count)
            (let
              [from : i64 (array-ref edges (* at 2))]
              [to : i64 (array-ref edges (+ (* at 2) 1))]
              (when
                (and
                  (>= to 0)
                  (not (tc-name-id-list-contains fed to))
                  (not (tc-admitted-ended-region? env owners region to))
                  (or
                    (tc-name-id-list-contains fed from)
                    (tc-admitted-ended-region? env owners region from)
                    (and
                      (> at mark)
                      (>= region 0)
                      (>= phase-brand 0)
                      (= from phase-brand))))
                (set! fed (tc-name-id-list-add fed to))
                (set! changed? true)))
            (set! at (+ at 1)))))
      fed)))

;; Where the phase of region `region` was taken among the admitted stores: a
;; `(region, -1)` entry.
(define (tc-admitted-phase-mark! [env : TcTypeEnv] [region : i64]) : unit
  (when
    (> env.abi-pad 0)
    (tc-admitted-edge-note! (tc-type-env-scoped-state env) region -1)))

;; A childless or single-child generated occurrence of type `ty`.
(define (tc-selected-op!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [ty : ast.AstType]
  [operation : typed.TypedOperation]
  [children : (__tl_dyn-array typed.TypedOccurrenceId)]
  [source : (& source ownership.OwnershipSource)]) : TcSelectedPatternResult
  (let
    [type-id : typed.TypedTypeId
      (match (typed.typed-type-add! store lease ty)
        [(typed.TypedTypeIdResult.Ok id) id]
        [(typed.TypedTypeIdResult.Err error)
          (return (TcSelectedPatternResult.Err (tc-selected-error error)))])]
    [origin : typed.TypedOriginId
      (match (typed.typed-origin-add!
        store
        lease
        (ownership.ownership-source-copy source))
        [(typed.TypedOriginResult.Ok id) id]
        [(typed.TypedOriginResult.Err error)
          (return (TcSelectedPatternResult.Err (tc-selected-error error)))])]
    (match (typed.typed-occurrence-add!
      store
      lease
      type-id
      typed.TypedSyntax.Generated
      origin
      operation
      (& children))
      [(typed.TypedOccurrenceResult.Ok id) (TcSelectedPatternResult.Ok id)]
      [(typed.TypedOccurrenceResult.Err error)
        (TcSelectedPatternResult.Err (tc-selected-error error))])))

;; A closure local's environment (its binder's type, see
;; `tc-selected-publish-closure`) holds its captures' regions.
;; A binder `name` live at an arena's end inside a loop, which a store later
;; in the loop can have filled with that arena's values in an earlier
;; iteration (`tc-selected-loop-end-failure`).
(define (tc-selected-loop-end-message
  [origin-span : TcMaybeAstSourceSpan]
  [name : String]) : String
  (let
    [message : String
      (str_cat.str-cat
        (cdiag.compiler-diagnostic-typecheck-tag (ArenaOwnership))
        "typecheck: `"
        (string.copy (& name))
        "` is live where an arena ends inside this loop, and a store later in the loop places that arena's values in `"
        (string.copy (& name))
        "`'s region; ending the arena there is rejected conservatively")]
    (match origin-span
      [(Some span)
        (tc-rich-error-one-secondary
          span
          message
          "end the arena after the loop, or make that store before the arena ends"
          span
          "this ends the arena inside the loop")]
      [(No) message])))

;; The first binder an arena end inside the loop left live (`loop-ends` from
;; `start`) whose region the stores recorded up to the loop's end now reach.
(define (tc-selected-loop-end-failure
  [env : TcTypeEnv]
  [bindings : (& bindings TcSelectedBindings)]
  [start : i64]) : TcMaybeString
  (let
    [index : i64 start]
    [found : i64 -1]
    (while (and (< found 0) (< index (array-length bindings.loop-ends)))
      (let
        [region : i64 (array-ref bindings.loop-ends index)]
        [phase-brand : i64 (array-ref bindings.loop-ends (+ index 1))]
        [owner-count : i64 (array-ref bindings.loop-ends (+ index 2))]
        [owners : TcNameIdList Nil]
        [at : i64 0]
        (while (< at owner-count)
          (set!
            owners
            (tc-name-id-list-add
              owners
              (array-ref bindings.loop-ends (+ index 3 at))))
          (set! at (+ at 1)))
        (let
          [live-at : i64 (+ index 3 owner-count)]
          [live-end : i64 (+ live-at 1 (array-ref bindings.loop-ends live-at))]
          [fed : TcNameIdList
            (tc-admitted-fed-regions env owners region phase-brand)]
          [row : i64 (+ live-at 1)]
          (while (and (< found 0) (< row live-end))
            (let
              [message : i64 (array-ref bindings.loop-ends row)]
              [count : i64 (array-ref bindings.loop-ends (+ row 1))]
              [k : i64 0]
              (while (< k count)
                (when
                  (tc-name-id-list-contains
                    fed
                    (array-ref bindings.loop-ends (+ row 2 k)))
                  (set! found message))
                (set! k (+ k 1)))
              (set! row (+ row 2 count))))
          (set! index live-end))))
    (if (< found 0)
      TcMaybeString.No
      (TcMaybeString.Some
        (string.copy (& (array-ref bindings.loop-end-messages found)))))))

;; The selected loop body, then the re-check of the arena ends inside it.
(define (tc-selected-loop-end-checked
  [env : TcTypeEnv]
  [start : i64]
  [result : (TcSelectedResult store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match result
    [(TcSelectedResult.Err message sink) (TcSelectedResult.Err message sink)]
    [(TcSelectedResult.Ok ty occurrence sink)
      (match sink
        [(TcSelectedSink.Query)
          (TcSelectedResult.Ok ty occurrence TcSelectedSink.Query)]
        [(TcSelectedSink.Capture store lease bindings)
          (match (tc-selected-loop-end-failure env (& bindings) start)
            [(TcMaybeString.Some message)
              (TcSelectedResult.Err
                message
                (TcSelectedSink.Capture store lease bindings))]
            [(TcMaybeString.No)
              (TcSelectedResult.Ok
                ty
                occurrence
                (TcSelectedSink.Capture store lease bindings))])])]))

(define (tc-selected-closure-ends-region?
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [binder : (& binder typed.TypedBinderId)]
  [env : TcTypeEnv]
  [owners : TcNameIdList]
  [region : i64]
  [fed : TcNameIdList]) : bool
  (let
    [ty : ast.AstType (tc-selected-binder-type! store lease binder)]
    (and
      (>= (tc-selected-closure-capability (tc-global-shared-view ty)) 0)
      (tc-selected-type-ends-region? env ty owners region fed))))

;; A thread handle holding the region of one of the atomic arena `owners`.
(define (tc-selected-atomic-user?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : ast.AstType]
  [owners : TcNameIdList]) : bool
  (let
    [cursor : TcNameIdList owners]
    [found : bool false]
    (when
      (tc-thread-safe-user-type? ctx (tc-global-shared-view ty))
      (while (and (not found) (not (tc-name-id-list-empty? cursor)))
        (when
          (and
            (tc-atomic-arena-owner-active-id? env (tc-name-id-list-head cursor))
            (tc-type-contains-arena-owner-region?
              env
              (tc-global-shared-view ty)
              (tc-name-id-list-head cursor)))
          (set! found true))
        (set! cursor (tc-name-id-list-rest cursor))))
    found))

;; Scoped slot `index` is a `with` cleanup owner: the slot below it is its
;; owner marker (`tc-cleanup-owner-marker-for?`), whatever shadows its name.
(define (tc-selected-with-owner-slot?
  [carrier : (& carrier TcTypeEnvScopedCarrier)]
  [index : i64]) : bool
  (and
    (> index 0)
    (< index (array-length carrier.sidecar.stack.slots))
    (let
      [marker : (& carrier TcTypeEnvScopedSlot)
        (& (array-ref carrier.sidecar.stack.slots (- index 1)))]
      [slot : (& carrier TcTypeEnvScopedSlot)
        (& (array-ref carrier.sidecar.stack.slots index))]
      (tc-cleanup-owner-marker-for? marker.name-id marker.ty slot.name-id))))

;; The occurrences ending arena regions after `call` (its type `result-ty`):
;; an Invalidate for every binder in scope whose type holds an ended region
;; (`tc-selected-type-ends-region?`; every scoped slot, so a shadowed binder
;; counts too), then an EndBrand for every enclosing `:invalidate` parameter
;; whose brand is among `owners`. A unit call is followed by them in one unit
;; sequence; a call yielding a value is held in a temporary read after them.
(define (tc-selected-end-regions
  [ctx : TcContext]
  [env : TcTypeEnv]
  [owners : TcNameIdList]
  [region : i64]
  ;; For a rewind, the brand of the phase's owner (-1 otherwise).
  [phase-brand : i64]
  [call : typed.TypedOccurrenceId]
  [result-ty : ast.AstType]
  ;; A safe destroy or rewind (`rewind?`) of the arena named `unheld-arena`
  ;; (-1 otherwise; `origin` is its argument): a `with` cleanup owner holding
  ;; the ended region must no longer hold it (`RequireUnheld`).
  [unheld-arena : i64]
  [rewind? : bool]
  [origin : ast.AstExpr]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match sink
    [(TcSelectedSink.Query)
      (tc-selected-unrepresented
        (ResultTcType.Ok result-ty)
        TcSelectedSink.Query)]
    [(TcSelectedSink.Capture store lease bindings)
      (if (not
        (and
          (tc-type-env-scoped-runtime-active? env)
          bindings.pinned?
          (= env.store bindings.env-store)
          (= env.abi-pad bindings.scoped-state)))
        (tc-selected-unrepresented
          (ResultTcType.Ok result-ty)
          (TcSelectedSink.Capture store lease bindings))
        (let
          [carrier : TcTypeEnvScopedCarrier
            (tc-type-env-scoped-runtime-current env)]
          [count : i64
            (if (< carrier.sidecar.stack.slot-count bindings.len)
              carrier.sidecar.stack.slot-count
              bindings.len)]
          [unit? : bool
            (tc-type-eq (tc-global-shared-view result-ty) ast.AstType.Unit)]
          [children : (__tl_dyn-array typed.TypedOccurrenceId)
            (tc-selected-no-occurrences)]
          [ended : (__tl_dyn-array typed.TypedOccurrenceId)
            (tc-selected-no-occurrences)]
          [index : i64 0]
          [temporary : i64 -1]
          [held : (__tl_dyn-array typed.TypedBinderId) (tc-selected-no-binders)]
          ;; The regions the stores admitted so far carried its values into.
          [fed : TcNameIdList
            (tc-admitted-fed-regions env owners region phase-brand)]
          ;; Inside a loop a later store may have run in an earlier iteration:
          ;; the binders this end leaves live are re-checked when the loop is
          ;; inferred (`tc-selected-loop-end-failure`).
          [in-loop? : bool (tc-in-loop-target? env)]
          [live : (__tl_dyn-array i64) (tc-selected-no-i64s)]
          ;; The arena or phase argument, where main reports an end's checks.
          [origin-span : TcMaybeAstSourceSpan
            (tc-expr-maybe-span
              (tc-context-expr-bases ctx)
              (tc-global-shared-view origin))]
          (unless
            (and
              (= carrier.sidecar.stack.state-address bindings.scoped-state)
              (= carrier.sidecar.stack.lookup-epoch bindings.lookup-epoch)
              (<= count (array-length carrier.sidecar.stack.slots))
              (<= count (array-length bindings.entries)))
            (return
              (tc-selected-unrepresented
                (ResultTcType.Ok result-ty)
                (TcSelectedSink.Capture store lease bindings))))
          ;; The call first: whole, or held in a temporary.
          (if unit?
            (tc-selected-occurrences-push! (&mut children) call)
            (match (tc-selected-synthetic-binder!
              store
              lease
              (tc-global-shared-view result-ty)
              (& source))
              [(TcSelectedSyntheticBinder.Err message)
                (return
                  (TcSelectedResult.Err
                    message
                    (TcSelectedSink.Capture store lease bindings)))]
              [(TcSelectedSyntheticBinder.Ok binder)
                (match (tc-selected-op!
                  store
                  lease
                  ast.AstType.Unit
                  (typed.TypedOperation.Initialize
                    (typed.TypedBinderId
                      (typed.typed-handle-copy (& binder.handle))))
                  (__tl_make-array call)
                  (& source))
                  [(TcSelectedPatternResult.Ok id)
                    (tc-selected-occurrences-push! (&mut children) id)
                    (tc-selected-binders-push! (&mut held) binder)
                    (set! temporary 0)]
                  [(TcSelectedPatternResult.Unsupported)
                    (return
                      (tc-selected-unrepresented
                        (ResultTcType.Ok result-ty)
                        (TcSelectedSink.Capture store lease bindings)))]
                  [(TcSelectedPatternResult.Err message)
                    (return
                      (TcSelectedResult.Err
                        message
                        (TcSelectedSink.Capture store lease bindings)))])]))
          (while (< index count)
            (let
              [slot : (& carrier TcTypeEnvScopedSlot)
                (& (array-ref carrier.sidecar.stack.slots index))]
              (match (tc-selected-slot-binder
                (& bindings)
                index
                slot.generation)
                [(TcSelectedBinder.Unrepresented) unit]
                [(TcSelectedBinder.Found binder)
                  (let
                    ;; A `with` owner's binder keeps the region of the
                    ;; arena its value was allocated in (its scoped type
                    ;; drops it), and its cleanup runs at its scope's end:
                    ;; it must not hold that region's values any more.
                    [unheld-kind : i64
                      (if (and
                        (>= unheld-arena 0)
                        (tc-selected-with-owner-slot? (& carrier) index))
                        (tc-selected-type-end-kind
                          env
                          (tc-selected-binder-type! store lease (& binder))
                          owners
                          region
                          fed)
                        0)]
                    [_with-owner : unit
                      (when
                        (> unheld-kind 0)
                        (match (tc-selected-named-binder
                          env
                          (& bindings)
                          unheld-arena)
                          [(TcSelectedBinder.Found arena-binder)
                            (let
                              ;; Located at the arena or phase argument, as
                              ;; main reports it, else at the call.
                              [unheld-source : ownership.OwnershipSource
                                (match origin-span
                                  [(Some span)
                                    (ownership.OwnershipSource
                                      (string.copy (& source.path))
                                      (tc-selected-span-line source.line span)
                                      (tc-selected-span-column
                                        source.column
                                        span)
                                      (string.copy (& source.expansion)))]
                                  [(No)
                                    (ownership.ownership-source-copy (& source))])]
                              ;; Its failure then names the store that placed the
                              ;; arena's values in the owner's region.
                              (when
                                (= unheld-kind 2)
                                (match (typed.typed-fed-end-note!
                                  store
                                  lease
                                  binder.handle.index
                                  unheld-source.line
                                  unheld-source.column
                                  2)
                                  [(typed.TypedResult.Ok _) unit]
                                  [(typed.TypedResult.Err error)
                                    (return
                                      (tc-selected-failed
                                        error
                                        store
                                        lease
                                        bindings))]))
                              (match (tc-selected-op!
                                store
                                lease
                                ast.AstType.Unit
                                (typed.TypedOperation.RequireUnheld
                                  (typed.TypedBinderId
                                    (typed.typed-handle-copy (& binder.handle)))
                                  arena-binder
                                  rewind?)
                                (tc-selected-no-occurrences)
                                (& unheld-source))
                                [(TcSelectedPatternResult.Ok id)
                                  (tc-selected-occurrences-push!
                                    (&mut children)
                                    id)]
                                [(TcSelectedPatternResult.Unsupported) unit]
                                [(TcSelectedPatternResult.Err message)
                                  (return
                                    (TcSelectedResult.Err
                                      message
                                      (TcSelectedSink.Capture
                                        store
                                        lease
                                        bindings)))]))]
                          ;; An arena not named by a binder here: the
                          ;; owner cannot have left its scope, so it holds.
                          [(TcSelectedBinder.Unrepresented)
                            (return
                              (TcSelectedResult.Err
                                (tc-move-safe-invalidation-cleanup-owner-message
                                  (tc-context-expr-bases ctx)
                                  (tc-global-shared-view origin)
                                  (if rewind?
                                    "arena.rewind-safe!"
                                    "arena.destroy-safe!")
                                  (tc-env-key-name-text unheld-arena)
                                  (tc-env-key-name-text slot.name-id)
                                  (= unheld-kind 2))
                                (TcSelectedSink.Capture store lease bindings)))]))]
                    [brand? : bool
                      (match (typed.typed-binder-get!
                        store
                        lease
                        (typed.TypedBinderId
                          (typed.typed-handle-copy (& binder.handle))))
                        [(typed.TypedBinderView.Ok row)
                          (match (& row.kind)
                            [(typed.TypedBinderKind.InvalidateParameter
                                lifetime)
                              (tc-name-id-list-contains owners lifetime)]
                            [_ false])]
                        [(typed.TypedBinderView.Err error)
                          (return
                            (tc-selected-failed error store lease bindings))])]
                    (let
                      [end-kind : i64
                        (tc-selected-type-end-kind
                          env
                          (owned_view.compiler-owned-reference-shared-view
                            (& slot.ty))
                          owners
                          region
                          fed)]
                      (when
                        (and
                          (or
                            (> end-kind 0)
                            (tc-selected-closure-ends-region?
                              store
                              lease
                              (& binder)
                              env
                              owners
                              region
                              fed))
                          ;; A thread handle of an atomic owner is required
                          ;; released instead (`tc-selected-release-checks!`).
                          (not
                            (tc-selected-atomic-user?
                              ctx
                              env
                              (owned_view.compiler-owned-reference-shared-view
                                (& slot.ty))
                              owners)))
                        (match (tc-selected-op!
                          store
                          lease
                          ast.AstType.Unit
                          (typed.TypedOperation.Invalidate
                            (typed.TypedBinderId
                              (typed.typed-handle-copy (& binder.handle))))
                          (tc-selected-no-occurrences)
                          (& source))
                          [(TcSelectedPatternResult.Ok id)
                            (tc-selected-occurrences-push! (&mut children) id)]
                          [(TcSelectedPatternResult.Unsupported) unit]
                          [(TcSelectedPatternResult.Err message)
                            (return
                              (TcSelectedResult.Err
                                message
                                (TcSelectedSink.Capture store lease bindings)))])
                        ;; Its use then says why the arena's end reached it.
                        (when
                          (= end-kind 2)
                          (match (typed.typed-fed-end-note!
                            store
                            lease
                            binder.handle.index
                            source.line
                            source.column
                            1)
                            [(typed.TypedResult.Ok _) unit]
                            [(typed.TypedResult.Err error)
                              (return
                                (tc-selected-failed error store lease bindings))])))
                      (when
                        (and in-loop? (= end-kind 0) (= unheld-kind 0))
                        (let
                          [regions : TcNameIdList
                            (tc-name-id-list-without-program
                              (tc-type-collect-regions
                                (tc-selected-binder-type!
                                  store
                                  lease
                                  (& binder))))]
                          (unless
                            (or
                              (tc-name-id-list-empty? regions)
                              (tc-name-id-list-overlaps? regions fed))
                            (tc-selected-i64s-push!
                              (&mut live)
                              (array-length bindings.loop-end-messages))
                            (__tl_array-push!
                              bindings.loop-end-messages
                              (tc-selected-loop-end-message
                                origin-span
                                (tc-env-key-name-text slot.name-id)))
                            (tc-selected-i64s-push! (&mut live) 0)
                            (let
                              [count-at : i64 (- (array-length live) 1)]
                              [cursor : TcNameIdList regions]
                              (while (not (tc-name-id-list-empty? cursor))
                                (tc-selected-i64s-push!
                                  (&mut live)
                                  (tc-name-id-list-head cursor))
                                (set!
                                  (array-ref live count-at)
                                  (+ (array-ref live count-at) 1))
                                (set! cursor (tc-name-id-list-rest cursor))))))))
                    ;; An enclosing `:invalidate` parameter's brand ends.
                    (when
                      brand?
                      (match (tc-selected-op!
                        store
                        lease
                        ast.AstType.Unit
                        (typed.TypedOperation.EndBrand binder)
                        (tc-selected-no-occurrences)
                        (& source))
                        [(TcSelectedPatternResult.Ok id)
                          (tc-selected-occurrences-push! (&mut ended) id)]
                        [(TcSelectedPatternResult.Unsupported) unit]
                        [(TcSelectedPatternResult.Err message)
                          (return
                            (TcSelectedResult.Err
                              message
                              (TcSelectedSink.Capture store lease bindings)))])))])
              (set! index (+ index 1))))
          (when
            (> (array-length live) 0)
            (tc-selected-i64s-push! (&mut bindings.loop-ends) region)
            (tc-selected-i64s-push! (&mut bindings.loop-ends) phase-brand)
            (tc-selected-i64s-push!
              (&mut bindings.loop-ends)
              (tc-name-id-list-len owners))
            (let
              [cursor : TcNameIdList owners]
              (while (not (tc-name-id-list-empty? cursor))
                (tc-selected-i64s-push!
                  (&mut bindings.loop-ends)
                  (tc-name-id-list-head cursor))
                (set! cursor (tc-name-id-list-rest cursor))))
            (tc-selected-i64s-push!
              (&mut bindings.loop-ends)
              (array-length live))
            (set! index 0)
            (while (< index (array-length live))
              (tc-selected-i64s-push!
                (&mut bindings.loop-ends)
                (array-ref live index))
              (set! index (+ index 1))))
          (set! index 0)
          (while (< index (array-length ended))
            (begin
              (tc-selected-occurrences-push!
                (&mut children)
                (typed.TypedOccurrenceId
                  (typed.typed-handle-copy (& (array-ref ended index).handle))))
              (set! index (+ index 1))))
          ;; A value the call yields is read back last.
          (when
            (>= temporary 0)
            (match (tc-selected-binder-read!
              store
              lease
              (tc-global-shared-view result-ty)
              (typed.TypedBinderId
                (typed.typed-handle-copy (& (array-ref held 0).handle)))
              (& source))
              [(TcSelectedPatternResult.Ok id)
                (tc-selected-occurrences-push! (&mut children) id)]
              [(TcSelectedPatternResult.Unsupported)
                (return
                  (tc-selected-unrepresented
                    (ResultTcType.Ok result-ty)
                    (TcSelectedSink.Capture store lease bindings)))]
              [(TcSelectedPatternResult.Err message)
                (return
                  (TcSelectedResult.Err
                    message
                    (TcSelectedSink.Capture store lease bindings)))]))
          (tc-selected-publish
            (ResultTcType.Ok result-ty)
            syntax
            source
            typed.TypedOperation.Sequence
            children
            (TcSelectedSink.Capture store lease bindings))))]))

;; The binder of binding slot `index` when its entry is the slot's current
;; binding (`tc-selected-binding-find!` checks the same coordinate).
(define (tc-selected-slot-binder
  [bindings : (& bindings TcSelectedBindings)]
  [index : i64]
  [generation : i64]) : TcSelectedBinder
  (let
    [entry : (& bindings TcSelectedBinding)
      (& (array-ref bindings.entries index))]
    (if (and
      (= entry.coordinate.env-store bindings.env-store)
      (= entry.coordinate.scoped-state bindings.scoped-state)
      (= entry.coordinate.lookup-epoch bindings.lookup-epoch)
      (= entry.coordinate.slot-index index)
      (= entry.coordinate.slot-generation generation))
      (TcSelectedBinder.Found
        (typed.TypedBinderId (typed.typed-handle-copy (& entry.binder.handle))))
      TcSelectedBinder.Unrepresented)))

;; The brands a call's `:invalidate` arguments end (mirrors
;; `tc-move-check-invalidate-call-effects`): `tc-invalidate-call-brand` of each
;; argument's checked type. A live `with` owner holding a brand is the legacy
;; error; an atomic owner's thread users are checked at the call
;; (`tc-selected-with-release-checks`).
(defenum TcSelectedBrands
  (Ok TcNameIdList)
  (Err String))

(define (tc-selected-invalidate-call-brands
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [params : (& params ast.AstTypeList)]) : TcSelectedBrands
  (let
    [index : i64 0]
    [brands : TcNameIdList TcNameIdList.Nil]
    (while (and (< index (ast.ast-type-list-len params)) (< index args.len))
      (let
        [formal : ast.AstType
          (ast.ty-node-get
            (ast.ast-type-list-get params index (ast.ast-type-id-fallback)))]
        [arg-id : i64 (ast.ast-expr-list-get args index 0)]
        (match (tc-type-invalidate-lifetime (tc-global-shared-view formal))
          [(TcMaybeNameId.Some _)
            (match (tc-expr-id ctx env arg-id)
              [(ResultTcType.Ok actual)
                (match (tc-invalidate-call-brand ctx env formal actual)
                  [(TcMaybeNameId.Some brand)
                    (let
                      [live-owner : i64
                        (tc-move-live-cleanup-owner-in-region
                          (tc-global-shared-view env)
                          brand
                          -1)]
                      (cond
                        [(>= live-owner 0)
                          (return
                            (TcSelectedBrands.Err
                              (tc-move-safe-invalidation-cleanup-owner-message
                                (tc-context-expr-bases ctx)
                                (tc-context-expr-get ctx arg-id)
                                "an :invalidate call"
                                (tc-env-key-name-text brand)
                                (tc-env-key-name-text live-owner)
                                false)))]
                        [else (set! brands (tc-name-id-list-add brands brand))]))]
                  [(TcMaybeNameId.No) unit])]
              [(ResultTcType.Err _) unit])]
          [(TcMaybeNameId.No) unit])
        (set! index (+ index 1))))
    (TcSelectedBrands.Ok brands)))

;; The atomic arena owners whose regions a channel send's message carries
;; (none for any other call).
(define (tc-selected-sent-owners
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : (& args ast.AstExprList)]) : TcNameIdList
  (match (tc-thread-channel-send-call-name ctx func)
    [(TcMaybeString.No) TcNameIdList.Nil]
    [(TcMaybeString.Some _)
      (match (tc-thread-channel-send-message-arg
        (tc-context-expr-segment-bases ctx)
        (owned_view.compiler-owned-reference-shared-view args))
        [(ResultTcExpr.Err _) TcNameIdList.Nil]
        [(ResultTcExpr.Ok message)
          (match (tc-expr ctx env message)
            [(ResultTcType.Ok message-ty)
              (tc-type-atomic-arena-owner-regions env message-ty)]
            [(ResultTcType.Err _) TcNameIdList.Nil])])]))

;; `result` preceded by the marks that atomic arena `owners` gained thread
;; users (their values crossed to another thread).
(define (tc-selected-with-thread-users
  [env : TcTypeEnv]
  [owners : TcNameIdList]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [result : (TcSelectedResult store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (if (tc-name-id-list-empty? owners)
    result
    (match result
      [(TcSelectedResult.Err message next) (TcSelectedResult.Err message next)]
      [(TcSelectedResult.Ok ty occurrence next)
        (match next
          [(TcSelectedSink.Query)
            (TcSelectedResult.Ok ty occurrence TcSelectedSink.Query)]
          [(TcSelectedSink.Capture store lease bindings)
            (let
              [marks : (__tl_dyn-array typed.TypedOccurrenceId)
                (tc-selected-no-occurrences)]
              [cursor : TcNameIdList owners]
              (while (not (tc-name-id-list-empty? cursor))
                (begin
                  (match (tc-selected-named-binder
                    env
                    (& bindings)
                    (tc-name-id-list-head cursor))
                    [(TcSelectedBinder.Unrepresented)
                      (return
                        (TcSelectedResult.Ok
                          ty
                          TcSelectedOccurrence.Unrepresented
                          (TcSelectedSink.Capture store lease bindings)))]
                    [(TcSelectedBinder.Found owner)
                      (match (tc-selected-op!
                        store
                        lease
                        ast.AstType.Unit
                        (typed.TypedOperation.ThreadUsers owner)
                        (tc-selected-no-occurrences)
                        (& source))
                        [(TcSelectedPatternResult.Ok id)
                          (tc-selected-occurrences-push! (&mut marks) id)]
                        [(TcSelectedPatternResult.Unsupported)
                          (return
                            (TcSelectedResult.Ok
                              ty
                              TcSelectedOccurrence.Unrepresented
                              (TcSelectedSink.Capture store lease bindings)))]
                        [(TcSelectedPatternResult.Err message)
                          (return
                            (TcSelectedResult.Err
                              message
                              (TcSelectedSink.Capture store lease bindings)))])])
                  (set! cursor (tc-name-id-list-rest cursor))))
              (tc-selected-after-checks
                marks
                syntax
                source
                (TcSelectedResult.Ok
                  ty
                  occurrence
                  (TcSelectedSink.Capture store lease bindings))))])])))

;; `result` (a call ending the regions of `owners`) preceded by the release
;; checks of the atomic ones (`tc-selected-release-checks!`).
(define (tc-selected-with-release-checks
  [ctx : TcContext]
  [env : TcTypeEnv]
  [owners : TcNameIdList]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [result : (TcSelectedResult store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match result
    [(TcSelectedResult.Err message next) (TcSelectedResult.Err message next)]
    [(TcSelectedResult.Ok ty occurrence next)
      (match next
        [(TcSelectedSink.Query)
          (TcSelectedResult.Ok ty occurrence TcSelectedSink.Query)]
        [(TcSelectedSink.Capture store lease bindings)
          (let
            [checks : (__tl_dyn-array typed.TypedOccurrenceId)
              (tc-selected-no-occurrences)]
            [cursor : TcNameIdList owners]
            (while (not (tc-name-id-list-empty? cursor))
              (begin
                (match (tc-selected-release-checks!
                  ctx
                  env
                  (tc-name-id-list-head cursor)
                  store
                  lease
                  (& bindings)
                  (& source))
                  [(TcSelectedReleaseChecks.Ok found)
                    (let
                      [index : i64 0]
                      (while (< index (array-length found))
                        (begin
                          (tc-selected-occurrences-push!
                            (&mut checks)
                            (typed.TypedOccurrenceId
                              (typed.typed-handle-copy
                                (& (array-ref found index).handle))))
                          (set! index (+ index 1)))))]
                  [(TcSelectedReleaseChecks.Unrepresented)
                    (return
                      (TcSelectedResult.Ok
                        ty
                        TcSelectedOccurrence.Unrepresented
                        (TcSelectedSink.Capture store lease bindings)))]
                  [(TcSelectedReleaseChecks.Err message)
                    (return
                      (TcSelectedResult.Err
                        message
                        (TcSelectedSink.Capture store lease bindings)))])
                (set! cursor (tc-name-id-list-rest cursor))))
            (tc-selected-after-checks
              checks
              syntax
              source
              (TcSelectedResult.Ok
                ty
                occurrence
                (TcSelectedSink.Capture store lease bindings))))])]))

;; A published call followed by the region ends of its `:invalidate`
;; arguments' `brands`.
(define (tc-selected-with-region-ends
  [ctx : TcContext]
  [env : TcTypeEnv]
  [brands : TcNameIdList]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [result : (TcSelectedResult store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (if (tc-name-id-list-empty? brands)
    result
    (match result
      [(TcSelectedResult.Err message after)
        (TcSelectedResult.Err message after)]
      [(TcSelectedResult.Ok ty occurrence after)
        (match occurrence
          [(TcSelectedOccurrence.Selected call)
            (tc-selected-end-regions
              ctx
              env
              brands
              -1
              -1
              call
              ty
              -1
              false
              (ast.AstExpr.Var -1)
              syntax
              source
              after)]
          [(TcSelectedOccurrence.Unrepresented)
            (TcSelectedResult.Ok ty TcSelectedOccurrence.Unrepresented after)])])))

;; Mirrors `tc-move-safe-arena-destroy-effect`/`-rewind-effect` up to the
;; walker's flow: a `with` cleanup owner holding values of the ended region is
;; the legacy error (a `with` owner cannot move before its scope ends, so
;; holding is static); an atomic owner with thread users in scope keeps the
;; legacy route.
(define (tc-infer-selected-arena-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [func-id : i64]
  [arm : i64]
  [args : (& args ast.AstExprList)]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-legacy ctx env expr syntax expected)
    [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcType.Ok ty)
      (let
        [func : ast.AstExpr (tc-context-expr-get ctx func-id)]
        [raw-name : i64
          (tc-expr-var-name-id
            (tc-context-expr-segment-bases ctx)
            (tc-global-shared-view func))]
        [key : i64
          (if (>= raw-name 0)
            (tc-selected-call-declared-function ctx env raw-name)
            -1)]
        [arg-id : i64
          (if (= args.len 1)
            (ast.ast-expr-list-get args 0 0)
            -1)]
        (match (tc-call-target-expr-id ctx env func-id)
          [(ResultTcType.Err _)
            (tc-selected-unrepresented (ResultTcType.Ok ty) sink)]
          [(ResultTcType.Ok fn-ty)
            (cond
              [(< key 0) (tc-selected-unrepresented (ResultTcType.Ok ty) sink)]
              [(= arm 9)
                (if (= args.len 0)
                  (tc-selected-publish-call
                    (ResultTcType.Ok ty)
                    (typed.TypedCallKind.Declared key)
                    fn-ty
                    syntax
                    source
                    (tc-selected-no-occurrences)
                    true
                    sink)
                  (tc-selected-unrepresented (ResultTcType.Ok ty) sink))]
              [(< arg-id 0)
                (tc-selected-unrepresented (ResultTcType.Ok ty) sink)]
              [(= arm 10)
                (match (tc-expr-id ctx env arg-id)
                  [(ResultTcType.Err message)
                    (TcSelectedResult.Err message sink)]
                  [(ResultTcType.Ok owner-ty)
                    (match (tc-infer-selected-arena-handle
                      ctx
                      env
                      arg-id
                      owner-ty
                      (tc-global-shared-view source)
                      sink)
                      [(TcSelectedResult.Err message next)
                        (TcSelectedResult.Err message next)]
                      [(TcSelectedResult.Ok _ handle next)
                        (match handle
                          [(TcSelectedOccurrence.Selected child)
                            (tc-selected-publish-call
                              (ResultTcType.Ok ty)
                              (typed.TypedCallKind.Declared key)
                              fn-ty
                              syntax
                              source
                              (__tl_make-array child)
                              true
                              next)]
                          [(TcSelectedOccurrence.Unrepresented)
                            (tc-selected-unrepresented
                              (ResultTcType.Ok ty)
                              next)])])])]
              [else
                (tc-infer-selected-arena-invalidate
                  ctx
                  env
                  (= arm 12)
                  arg-id
                  key
                  fn-ty
                  ty
                  syntax
                  source
                  sink)])]))]))

;; The binder of the innermost scoped local named `name`.
(define (tc-selected-named-binder
  [env : TcTypeEnv]
  [bindings : (& bindings TcSelectedBindings)]
  [name : i64]) : TcSelectedBinder
  (if (not (tc-type-env-scoped-runtime-active? env))
    TcSelectedBinder.Unrepresented
    (let
      [carrier : TcTypeEnvScopedCarrier
        (tc-type-env-scoped-runtime-current env)]
      [index : i64
        (-
          (if (<
            carrier.sidecar.stack.slot-count
            (array-length carrier.sidecar.stack.slots))
            carrier.sidecar.stack.slot-count
            (array-length carrier.sidecar.stack.slots))
          1)]
      (while (>= index 0)
        (let
          [slot : (& carrier TcTypeEnvScopedSlot)
            (& (array-ref carrier.sidecar.stack.slots index))]
          (if (= slot.name-id name)
            (return (tc-selected-slot-binder bindings index slot.generation))
            (set! index (- index 1)))))
      TcSelectedBinder.Unrepresented)))

;; The binder of the innermost scoped local whose type is the arena owner
;; `(Arena brand)`.
(define (tc-selected-brand-owner-binder
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : (& bindings TcSelectedBindings)]
  [brand : i64]) : TcSelectedBinder
  (if (not (tc-type-env-scoped-runtime-active? env))
    TcSelectedBinder.Unrepresented
    (let
      [carrier : TcTypeEnvScopedCarrier
        (tc-type-env-scoped-runtime-current env)]
      [index : i64
        (-
          (if (<
            carrier.sidecar.stack.slot-count
            (array-length carrier.sidecar.stack.slots))
            carrier.sidecar.stack.slot-count
            (array-length carrier.sidecar.stack.slots))
          1)]
      (while (>= index 0)
        (let
          [slot : (& carrier TcTypeEnvScopedSlot)
            (& (array-ref carrier.sidecar.stack.slots index))]
          (if (match (tc-arena-branded-region
            ctx
            (owned_view.compiler-owned-reference-shared-view (& slot.ty)))
            [(TcMaybeNameId.Some region) (= region brand)]
            [(TcMaybeNameId.No) false])
            (return (tc-selected-slot-binder bindings index slot.generation))
            (set! index (- index 1)))))
      TcSelectedBinder.Unrepresented)))

;; The checks before atomic arena `owner` is destroyed or rewound: no value
;; of its region crossed to another thread (its thread-users marker is clear)
;; and every thread handle in scope holding its region was joined. None for
;; an ordinary arena; Unrepresented when the owner is not a local of this
;; body.
(defenum TcSelectedReleaseChecks
  (Ok (__tl_dyn-array typed.TypedOccurrenceId))
  (Unrepresented)
  (Err String))

(define (tc-selected-release-checks!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [owner : i64]
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [bindings : (& bindings TcSelectedBindings)]
  [source : (& source ownership.OwnershipSource)]) : TcSelectedReleaseChecks
  (let
    [checks : (__tl_dyn-array typed.TypedOccurrenceId)
      (tc-selected-no-occurrences)]
    (if (or (< owner 0) (not (tc-atomic-arena-owner-active-id? env owner)))
      (TcSelectedReleaseChecks.Ok checks)
      (match (match (tc-selected-named-binder env bindings owner)
        [(TcSelectedBinder.Found found) (TcSelectedBinder.Found found)]
        ;; An owner destroyed through a place holding it (`state.arena`) is
        ;; named by its arena's brand: the owner local of that brand.
        [(TcSelectedBinder.Unrepresented)
          (tc-selected-brand-owner-binder ctx env bindings owner)])
        [(TcSelectedBinder.Unrepresented) TcSelectedReleaseChecks.Unrepresented]
        [(TcSelectedBinder.Found owner-binder)
          (let
            [carrier : TcTypeEnvScopedCarrier
              (tc-type-env-scoped-runtime-current env)]
            [count : i64
              (if (<
                carrier.sidecar.stack.slot-count
                (array-length carrier.sidecar.stack.slots))
                carrier.sidecar.stack.slot-count
                (array-length carrier.sidecar.stack.slots))]
            [index : i64 0]
            (match (tc-selected-op!
              store
              lease
              ast.AstType.Unit
              (typed.TypedOperation.RequireReleased
                (typed.TypedBinderId
                  (typed.typed-handle-copy (& owner-binder.handle)))
                (typed.TypedBinderId
                  (typed.typed-handle-copy (& owner-binder.handle))))
              (tc-selected-no-occurrences)
              source)
              [(TcSelectedPatternResult.Ok id)
                (tc-selected-occurrences-push! (&mut checks) id)]
              [(TcSelectedPatternResult.Unsupported)
                (return TcSelectedReleaseChecks.Unrepresented)]
              [(TcSelectedPatternResult.Err message)
                (return (TcSelectedReleaseChecks.Err message))])
            (while (< index count)
              (let
                [slot : (& carrier TcTypeEnvScopedSlot)
                  (& (array-ref carrier.sidecar.stack.slots index))]
                (when
                  (and
                    (tc-thread-safe-user-type?
                      ctx
                      (owned_view.compiler-owned-reference-shared-view
                        (& slot.ty)))
                    (tc-type-contains-arena-owner-region?
                      env
                      (owned_view.compiler-owned-reference-shared-view
                        (& slot.ty))
                      owner))
                  (match (tc-selected-slot-binder
                    bindings
                    index
                    slot.generation)
                    [(TcSelectedBinder.Unrepresented)
                      (return TcSelectedReleaseChecks.Unrepresented)]
                    [(TcSelectedBinder.Found user)
                      (match (tc-selected-op!
                        store
                        lease
                        ast.AstType.Unit
                        (typed.TypedOperation.RequireReleased
                          user
                          (typed.TypedBinderId
                            (typed.typed-handle-copy (& owner-binder.handle))))
                        (tc-selected-no-occurrences)
                        source)
                        [(TcSelectedPatternResult.Ok id)
                          (tc-selected-occurrences-push! (&mut checks) id)]
                        [(TcSelectedPatternResult.Unsupported)
                          (return TcSelectedReleaseChecks.Unrepresented)]
                        [(TcSelectedPatternResult.Err message)
                          (return (TcSelectedReleaseChecks.Err message))])]))
                (set! index (+ index 1))))
            (TcSelectedReleaseChecks.Ok checks))]))))

;; The release checks of atomic arena `owner` with the sink handed back, or
;; the finished result when they cannot be published.
(defenum TcSelectedGated
  (:lifetimes store lease intern bind)
  (Ok
    (__tl_dyn-array typed.TypedOccurrenceId)
    (TcSelectedSink store lease intern bind))
  (Done (TcSelectedResult store lease intern bind)))

(define (tc-selected-release-gate
  [ctx : TcContext]
  [env : TcTypeEnv]
  [owner : i64]
  [ty : ast.AstType]
  ;; By value: a seed-built stage-1 checker treats a borrow passed here as
  ;; held by the returned sink (the call's lifetimes are separate).
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedGated
    store
    lease
    intern
    bind)
  (match sink
    [(TcSelectedSink.Query)
      (TcSelectedGated.Done
        (tc-selected-unrepresented (ResultTcType.Ok ty) TcSelectedSink.Query))]
    [(TcSelectedSink.Capture store lease bindings)
      (match (tc-selected-release-checks!
        ctx
        env
        owner
        store
        lease
        (& bindings)
        (& source))
        [(TcSelectedReleaseChecks.Ok checks)
          (TcSelectedGated.Ok
            checks
            (TcSelectedSink.Capture store lease bindings))]
        [(TcSelectedReleaseChecks.Unrepresented)
          (TcSelectedGated.Done
            (tc-selected-unrepresented
              (ResultTcType.Ok ty)
              (TcSelectedSink.Capture store lease bindings)))]
        [(TcSelectedReleaseChecks.Err message)
          (TcSelectedGated.Done
            (TcSelectedResult.Err
              message
              (TcSelectedSink.Capture store lease bindings)))])]))

;; `result` preceded by `checks` (a sequence when there are any).
(define (tc-selected-after-checks
  [checks : (__tl_dyn-array typed.TypedOccurrenceId)]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [result : (TcSelectedResult store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (if (= (array-length checks) 0)
    result
    (match result
      [(TcSelectedResult.Err message next) (TcSelectedResult.Err message next)]
      [(TcSelectedResult.Ok ty occurrence next)
        (match occurrence
          [(TcSelectedOccurrence.Unrepresented)
            (TcSelectedResult.Ok ty TcSelectedOccurrence.Unrepresented next)]
          [(TcSelectedOccurrence.Selected last)
            (tc-selected-occurrences-push! (&mut checks) last)
            (match (tc-selected-publish
              (ResultTcType.Ok (tc-global-shared-view ty))
              syntax
              source
              typed.TypedOperation.Sequence
              checks
              next)
              [(TcSelectedResult.Err message done)
                (TcSelectedResult.Err message done)]
              [(TcSelectedResult.Ok _ sequence done)
                (TcSelectedResult.Ok ty sequence done)])])])))

;; `destroy-safe!` (`destroy?`) or `rewind-safe!` of operand `arg-id`.
(define (tc-infer-selected-arena-invalidate
  [ctx : TcContext]
  [env : TcTypeEnv]
  [destroy? : bool]
  [arg-id : i64]
  [key : i64]
  [fn-ty : ast.AstType]
  [ty : ast.AstType]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    [arg : ast.AstExpr (tc-context-expr-get ctx arg-id)]
    [token : i64
      (tc-expr-var-name-id
        (tc-context-expr-segment-bases ctx)
        (tc-global-shared-view arg))]
    ;; The ended region's owner (an owner's every region ends) or, for a
    ;; rewind, the phase region alone.
    [owner : i64
      (if destroy?
        (match (tc-expr-id ctx env arg-id)
          [(ResultTcType.Ok owner-ty)
            (match (tc-destroy-safe-owner-place-id
              ctx
              env
              (tc-global-shared-view arg)
              owner-ty)
              [(TcMaybeNameId.Some id) id]
              [(TcMaybeNameId.No) -1])]
          [(ResultTcType.Err _) -1])
        -1)]
    [region : i64
      (if (or destroy? (< token 0))
        -1
        (match (tc-arena-phase-token-region-active env token)
          [(TcMaybeNameId.Some id) id]
          [(TcMaybeNameId.No) -1]))]
    [phase-owner : i64
      (if (or destroy? (< token 0))
        -1
        (match (tc-arena-phase-token-owner-active env token)
          [(TcMaybeNameId.Some id) id]
          [(TcMaybeNameId.No) -1]))]
    ;; The brand the owner's stored values carry (`tc-admitted-fed-regions`).
    [phase-brand : i64
      (if (< phase-owner 0)
        -1
        (match (tc-lookup-id env phase-owner)
          [(ResultTcType.Ok owner-ty)
            (match (tc-arena-branded-region ctx owner-ty)
              [(TcMaybeNameId.Some brand) brand]
              [(TcMaybeNameId.No) phase-owner])]
          [(ResultTcType.Err _) phase-owner]))]
    [atomic-owner : i64
      (if destroy?
        owner
        phase-owner)]
    (cond
      [(and destroy? (< owner 0))
        (tc-selected-unrepresented (ResultTcType.Ok ty) sink)]
      [(and (not destroy?) (< region 0))
        (tc-selected-unrepresented (ResultTcType.Ok ty) sink)]
      [else
        (let
          [live-owner : i64
            (tc-move-live-cleanup-owner-in-region
              (tc-global-shared-view env)
              owner
              region)]
          (match (tc-selected-release-gate
            ctx
            env
            atomic-owner
            (tc-global-shared-view ty)
            (ownership.ownership-source-copy (& source))
            sink)
            [(TcSelectedGated.Done result) result]
            ;; An atomic owner's thread users must be gone first.
            [(TcSelectedGated.Ok checks sink)
              (tc-selected-after-checks
                checks
                (tc-global-shared-view syntax)
                (ownership.ownership-source-copy (& source))
                (if (>= live-owner 0)
                  (TcSelectedResult.Err
                    (tc-move-safe-invalidation-cleanup-owner-message
                      (tc-context-expr-bases ctx)
                      (tc-global-shared-view arg)
                      (if destroy?
                        "arena.destroy-safe!"
                        "arena.rewind-safe!")
                      (tc-env-key-name-text
                        (cond
                          [destroy? owner]
                          [(>= phase-owner 0) phase-owner]
                          [else token]))
                      (tc-env-key-name-text live-owner)
                      false)
                    sink)
                  ;; The owner place or token is consumed (moved) by the call.
                  (match (tc-infer-selected-sequence-child
                    ctx
                    env
                    arg-id
                    ast.AstMaybeType.No
                    (tc-global-shared-view source)
                    true
                    sink)
                    [(TcSelectedResult.Err message next)
                      (TcSelectedResult.Err message next)]
                    [(TcSelectedResult.Ok _ operand next)
                      (match operand
                        [(TcSelectedOccurrence.Unrepresented)
                          (tc-selected-unrepresented (ResultTcType.Ok ty) next)]
                        [(TcSelectedOccurrence.Selected child)
                          (match (tc-selected-publish-call
                            (ResultTcType.Ok (tc-global-shared-view ty))
                            (typed.TypedCallKind.Declared key)
                            fn-ty
                            typed.TypedSyntax.Generated
                            (tc-global-shared-view source)
                            (__tl_make-array child)
                            true
                            next)
                            [(TcSelectedResult.Err message after)
                              (TcSelectedResult.Err message after)]
                            [(TcSelectedResult.Ok _ called after)
                              (match called
                                [(TcSelectedOccurrence.Selected call)
                                  (match (tc-selected-end-regions
                                    ctx
                                    env
                                    (if (>= owner 0)
                                      (tc-name-id-list-add
                                        TcNameIdList.Nil
                                        owner)
                                      TcNameIdList.Nil)
                                    region
                                    phase-brand
                                    call
                                    ast.AstType.Unit
                                    (cond
                                      [destroy? owner]
                                      [(>= phase-owner 0) phase-owner]
                                      [else token])
                                    (not destroy?)
                                    (tc-global-shared-view arg)
                                    syntax
                                    source
                                    after)
                                    [(TcSelectedResult.Err message done)
                                      (TcSelectedResult.Err message done)]
                                    [(TcSelectedResult.Ok _ occurrence done)
                                      (TcSelectedResult.Ok ty occurrence done)])]
                                [(TcSelectedOccurrence.Unrepresented)
                                  (tc-selected-unrepresented
                                    (ResultTcType.Ok ty)
                                    after)])])])])))]))])))

;; --- Try (#8449) --------------------------------------------------------------
;;
;; `(try e)` (SPEC try propagation) is a by-value match of `e` held in a
;; synthetic binder: the success arm yields its payload and the error (or
;; absence) arm returns the enclosing function's compatible variant carrying
;; the same payload. Typing and diagnostics are legacy `tc-try-expr`: the
;; operand is typed without an expected type, then classified against the
;; enclosing return type.
(define (tc-infer-selected-try
  [ctx : TcContext]
  [env : TcTypeEnv]
  [inner-id : i64]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-id
    ctx
    env
    inner-id
    ast.AstMaybeType.No
    (tc-global-shared-view source)
    sink)
    [(TcSelectedResult.Err message next) (TcSelectedResult.Err message next)]
    [(TcSelectedResult.Ok operand-ty operand next)
      (match (tc-current-return-type env)
        [(ResultTcType.Err _)
          (TcSelectedResult.Err
            "typecheck: try requires enclosing Result-like function"
            next)]
        [(ResultTcType.Ok return-ty)
          (match (tc-try-query
            ctx
            (tc-global-shared-view operand-ty)
            (tc-global-shared-view return-ty)
            TcTryEarlyExitAllowed)
            [(TcTryQueryIncompatible _ _ reason)
              (TcSelectedResult.Err
                (tc-try-incompatibility-message reason)
                next)]
            [(TcTryQueryCompatible operand-info return-info)
              (let
                [exit-regions : TcNameIdList
                  (tc-try-exit-regions
                    (tc-type-outer-regions (tc-global-shared-view operand-ty))
                    (tc-result-info-err-type
                      (tc-global-shared-view operand-info)))]
                (match (tc-check-try-exit-regions
                  ctx
                  env
                  (tc-context-expr-get ctx inner-id)
                  exit-regions)
                  [(ResultTcUnit.Err message)
                    (TcSelectedResult.Err message next)]
                  [(ResultTcUnit.Ok)
                    (tc-selected-contextual-result
                      ctx
                      env
                      expected
                      (tc-selected-try-publish
                        ctx
                        env
                        operand-ty
                        operand
                        return-ty
                        operand-info
                        return-info
                        syntax
                        source
                        (tc-selected-early-exit-flow
                          ctx
                          env
                          inner-id
                          exit-regions
                          "try's error exit"
                          next)))]))])])]))

(define (tc-selected-try-publish
  [ctx : TcContext]
  [env : TcTypeEnv]
  [operand-ty : ast.AstType]
  [operand : TcSelectedOccurrence]
  [return-ty : ast.AstType]
  [operand-info : TcResultInfo]
  [return-info : TcResultInfo]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    ;; The Ok payload lives where the operand does, as a match arm's binding
    ;; would.
    [ok-ty : ast.AstType
      (tc-tag-regions
        (tc-type-outer-regions (tc-global-shared-view operand-ty))
        (tc-result-info-ok-type (tc-global-shared-view operand-info)))]
    [result? : bool
      (match (tc-result-info-kind (tc-global-shared-view operand-info))
        [(TcTryResult) true]
        [(TcTryOption) false])]
    [err-ty : ast.AstType
      (tc-result-info-err-type (tc-global-shared-view operand-info))]
    [return-err-ty : ast.AstType
      (tc-result-info-err-type (tc-global-shared-view return-info))]
    [enum-name : i64
      (match (tc-global-shared-view operand-info)
        [(TcResultInfo _ name _ _ _ _) name])]
    [ok-variant : TcSelectedVariant
      (tc-selected-variant
        ctx
        enum-name
        (tc-result-info-ok-id (tc-global-shared-view operand-info)))]
    [err-variant : TcSelectedVariant
      (tc-selected-variant
        ctx
        enum-name
        (tc-result-info-err-id (tc-global-shared-view operand-info)))]
    ;; A payload-free `Ok*` yields `unit` (#8563): its arm binds nothing.
    [ok-payload? : bool
      (match (csym.compiler-registries-variant-fields-indexed
        (tc-context-symbols ctx)
        (tc-source-variant-handle-for-enum-id-or
          ctx
          enum-name
          (tc-result-info-ok-id (tc-global-shared-view operand-info))
          (csym.compiler-symbols-missing-handle)))
        [(parser.ResultAstTypeList.Ok fields)
          (> (ast.ast-type-list-len (& fields)) 0)]
        [(parser.ResultAstTypeList.Err _) true])]
    (match operand
      [(TcSelectedOccurrence.Unrepresented)
        (TcSelectedResult.Ok ok-ty TcSelectedOccurrence.Unrepresented sink)]
      [(TcSelectedOccurrence.Selected value)
        (if (or
          (< ok-variant.ordinal 0)
          (< err-variant.ordinal 0)
          ;; An arena's region tags (a value allocated in a `with-arena` body)
          ;; are legacy escape facts the graph does not model, as a match
          ;; scrutinee's are.
          (not
            (tc-selected-call-type-ok?
              ctx
              (tc-selected-strip-arena-tags
                ctx
                env
                (tc-global-shared-view operand-ty))))
          ;; A payload may be a reference (a view the result carries).
          (not
            (tc-selected-call-param-type-ok?
              ctx
              (tc-selected-strip-arena-tags
                ctx
                env
                (tc-global-shared-view ok-ty))))
          (not
            (tc-selected-call-type-ok? ctx (tc-global-shared-view return-ty)))
          (and
            result?
            (or
              (not
                (tc-selected-call-param-type-ok?
                  ctx
                  (tc-global-shared-view err-ty)))
              (not
                (tc-selected-call-param-type-ok?
                  ctx
                  (tc-global-shared-view return-err-ty))))))
          (TcSelectedResult.Ok ok-ty TcSelectedOccurrence.Unrepresented sink)
          (match sink
            [(TcSelectedSink.Query)
              (TcSelectedResult.Ok
                ok-ty
                TcSelectedOccurrence.Unrepresented
                TcSelectedSink.Query)]
            [(TcSelectedSink.Capture store lease bindings)
              (match (tc-selected-scrutinee-binder!
                (tc-global-shared-view operand-ty)
                value
                (ownership.ownership-source-copy (& source))
                store
                lease
                bindings)
                [(TcSelectedScrutinee.Err message next)
                  (TcSelectedResult.Err message next)]
                [(TcSelectedScrutinee.Legacy next)
                  (TcSelectedResult.Ok
                    ok-ty
                    TcSelectedOccurrence.Unrepresented
                    next)]
                [(TcSelectedScrutinee.Ok _ _ initialize position next)
                  (match position
                    [(TcSelectedMaybePlace.No)
                      (TcSelectedResult.Ok
                        ok-ty
                        TcSelectedOccurrence.Unrepresented
                        next)]
                    [(TcSelectedMaybePlace.Some place)
                      (tc-selected-try-arms!
                        operand-ty
                        ok-ty
                        err-ty
                        return-ty
                        return-err-ty
                        result?
                        ok-payload?
                        ok-variant
                        err-variant
                        initialize
                        place
                        syntax
                        source
                        next)])])]))])))

;; The two arms and the match over the operand's binder at `place`.
(define (tc-selected-try-arms!
  [operand-ty : ast.AstType]
  [ok-ty : ast.AstType]
  [err-ty : ast.AstType]
  [return-ty : ast.AstType]
  [return-err-ty : ast.AstType]
  [result? : bool]
  [ok-payload? : bool]
  [ok-variant : TcSelectedVariant]
  [err-variant : TcSelectedVariant]
  [initialize : typed.TypedOccurrenceId]
  [place : typed.TypedPlaceId]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match sink
    [(TcSelectedSink.Query)
      (TcSelectedResult.Ok
        ok-ty
        TcSelectedOccurrence.Unrepresented
        TcSelectedSink.Query)]
    [(TcSelectedSink.Capture store lease bindings)
      (let
        ;; Success: bind the payload and yield it.
        [ok-binder : typed.TypedBinderId
          (match (tc-selected-synthetic-binder!
            store
            lease
            (tc-global-shared-view ok-ty)
            (& source))
            [(TcSelectedSyntheticBinder.Ok id) id]
            [(TcSelectedSyntheticBinder.Err message)
              (return
                (TcSelectedResult.Err
                  message
                  (TcSelectedSink.Capture store lease bindings)))])]
        [ok-pattern : typed.TypedOccurrenceId
          (match (tc-selected-try-pattern!
            store
            lease
            (tc-global-shared-view operand-ty)
            (& ok-variant)
            (tc-global-shared-view ok-ty)
            (typed.TypedBinderId (typed.typed-handle-copy (& ok-binder.handle)))
            ok-payload?
            (& place)
            (& source))
            [(TcSelectedPatternResult.Ok id) id]
            [(TcSelectedPatternResult.Unsupported)
              (return
                (TcSelectedResult.Ok
                  ok-ty
                  TcSelectedOccurrence.Unrepresented
                  (TcSelectedSink.Capture store lease bindings)))]
            [(TcSelectedPatternResult.Err message)
              (return
                (TcSelectedResult.Err
                  message
                  (TcSelectedSink.Capture store lease bindings)))])]
        [ok-body : typed.TypedOccurrenceId
          (match (if ok-payload?
            (tc-selected-binder-read!
              store
              lease
              (tc-global-shared-view ok-ty)
              (typed.TypedBinderId
                (typed.typed-handle-copy (& ok-binder.handle)))
              (& source))
            (tc-selected-unit-literal! store lease (& source)))
            [(TcSelectedPatternResult.Ok id) id]
            [(TcSelectedPatternResult.Unsupported)
              (return
                (TcSelectedResult.Ok
                  ok-ty
                  TcSelectedOccurrence.Unrepresented
                  (TcSelectedSink.Capture store lease bindings)))]
            [(TcSelectedPatternResult.Err message)
              (return
                (TcSelectedResult.Err
                  message
                  (TcSelectedSink.Capture store lease bindings)))])]
        ;; Error or absence: bind the error payload (a result only) and return
        ;; the enclosing function's variant carrying it.
        [err-binder : typed.TypedBinderId
          (match (tc-selected-synthetic-binder!
            store
            lease
            (if result?
              (tc-global-shared-view err-ty)
              ast.AstType.Unit)
            (& source))
            [(TcSelectedSyntheticBinder.Ok id) id]
            [(TcSelectedSyntheticBinder.Err message)
              (return
                (TcSelectedResult.Err
                  message
                  (TcSelectedSink.Capture store lease bindings)))])]
        [err-pattern : typed.TypedOccurrenceId
          (match (tc-selected-try-pattern!
            store
            lease
            (tc-global-shared-view operand-ty)
            (& err-variant)
            (tc-global-shared-view err-ty)
            (typed.TypedBinderId
              (typed.typed-handle-copy (& err-binder.handle)))
            result?
            (& place)
            (& source))
            [(TcSelectedPatternResult.Ok id) id]
            [(TcSelectedPatternResult.Unsupported)
              (return
                (TcSelectedResult.Ok
                  ok-ty
                  TcSelectedOccurrence.Unrepresented
                  (TcSelectedSink.Capture store lease bindings)))]
            [(TcSelectedPatternResult.Err message)
              (return
                (TcSelectedResult.Err
                  message
                  (TcSelectedSink.Capture store lease bindings)))])]
        [operands : (__tl_dyn-array typed.TypedOccurrenceId)
          (if result?
            (match (tc-selected-binder-read!
              store
              lease
              (tc-global-shared-view err-ty)
              err-binder
              (& source))
              [(TcSelectedPatternResult.Ok id) (__tl_make-array id)]
              [(TcSelectedPatternResult.Unsupported)
                (return
                  (TcSelectedResult.Ok
                    ok-ty
                    TcSelectedOccurrence.Unrepresented
                    (TcSelectedSink.Capture store lease bindings)))]
              [(TcSelectedPatternResult.Err message)
                (return
                  (TcSelectedResult.Err
                    message
                    (TcSelectedSink.Capture store lease bindings)))])
            (tc-selected-no-occurrences))]
        [signature : ast.AstType
          (if result?
            (let
              [params : ast.AstTypeList (ast.ast-type-list-new)]
              (ast.ast-type-list-push
                (&mut params)
                (ast.ty-node-push (& return-err-ty)))
              (ast.ast-ty-func params (& return-ty)))
            (ast.ast-ty-func (ast.ast-type-list-new) (& return-ty)))]
        (match (tc-selected-publish-call
          (ResultTcType.Ok (tc-global-shared-view return-ty))
          typed.TypedCallKind.Construct
          signature
          typed.TypedSyntax.Generated
          (ownership.ownership-source-copy (& source))
          operands
          true
          (TcSelectedSink.Capture store lease bindings))
          [(TcSelectedResult.Err message next)
            (TcSelectedResult.Err message next)]
          [(TcSelectedResult.Ok _ construct next)
            (match (tc-selected-return
              construct
              typed.TypedSyntax.Generated
              (ownership.ownership-source-copy (& source))
              next)
              [(TcSelectedResult.Err message after)
                (TcSelectedResult.Err message after)]
              [(TcSelectedResult.Ok _ returned after)
                (match returned
                  [(TcSelectedOccurrence.Unrepresented)
                    (TcSelectedResult.Ok
                      ok-ty
                      TcSelectedOccurrence.Unrepresented
                      after)]
                  [(TcSelectedOccurrence.Selected err-body)
                    (match (tc-selected-publish-arm!
                      (tc-global-shared-view ok-ty)
                      ok-pattern
                      ok-body
                      (ownership.ownership-source-copy (& source))
                      after)
                      [(TcSelectedArmOutcome.Failed message next2)
                        (TcSelectedResult.Err message next2)]
                      [(TcSelectedArmOutcome.Skipped next2)
                        (TcSelectedResult.Ok
                          ok-ty
                          TcSelectedOccurrence.Unrepresented
                          next2)]
                      [(TcSelectedArmOutcome.Built ok-arm next2)
                        (match (tc-selected-publish-arm!
                          ast.AstType.Never
                          err-pattern
                          err-body
                          (ownership.ownership-source-copy (& source))
                          next2)
                          [(TcSelectedArmOutcome.Failed message next3)
                            (TcSelectedResult.Err message next3)]
                          [(TcSelectedArmOutcome.Skipped next3)
                            (TcSelectedResult.Ok
                              ok-ty
                              TcSelectedOccurrence.Unrepresented
                              next3)]
                          [(TcSelectedArmOutcome.Built err-arm next3)
                            (let
                              [children : (__tl_dyn-array
                                typed.TypedOccurrenceId)
                                (__tl_make-array typed.TypedOccurrenceId 3)]
                              (set! (array-ref children 0) initialize)
                              (set! (array-ref children 1) ok-arm)
                              (set! (array-ref children 2) err-arm)
                              (tc-selected-publish
                                (ResultTcType.Ok ok-ty)
                                syntax
                                source
                                (typed.TypedOperation.Match false)
                                children
                                next3))])])])])]))]))

(defenum TcSelectedSyntheticBinder
  (Ok typed.TypedBinderId)
  (Err String))

;; A local binder the producer introduces (no source name).
(define (tc-selected-synthetic-binder!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [ty : ast.AstType]
  [source : (& source ownership.OwnershipSource)]) : TcSelectedSyntheticBinder
  (let
    [type-id : typed.TypedTypeId
      (match (typed.typed-type-add! store lease ty)
        [(typed.TypedTypeIdResult.Ok id) id]
        [(typed.TypedTypeIdResult.Err error)
          (return (TcSelectedSyntheticBinder.Err (tc-selected-error error)))])]
    [origin : typed.TypedOriginId
      (match (typed.typed-origin-add!
        store
        lease
        (ownership.ownership-source-copy source))
        [(typed.TypedOriginResult.Ok id) id]
        [(typed.TypedOriginResult.Err error)
          (return (TcSelectedSyntheticBinder.Err (tc-selected-error error)))])]
    (match (typed.typed-binder-add!
      store
      lease
      type-id
      typed.TypedBinderKind.Local
      origin
      -1)
      [(typed.TypedBinderResult.Ok id) (TcSelectedSyntheticBinder.Ok id)]
      [(typed.TypedBinderResult.Err error)
        (TcSelectedSyntheticBinder.Err (tc-selected-error error))])))

;; A read of a synthetic binder's whole value.
(define (tc-selected-binder-read!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [ty : ast.AstType]
  [binder : typed.TypedBinderId]
  [source : (& source ownership.OwnershipSource)]) : TcSelectedPatternResult
  (let
    [type-id : typed.TypedTypeId
      (match (typed.typed-type-add! store lease ty)
        [(typed.TypedTypeIdResult.Ok id) id]
        [(typed.TypedTypeIdResult.Err error)
          (return (TcSelectedPatternResult.Err (tc-selected-error error)))])]
    [origin : typed.TypedOriginId
      (match (typed.typed-origin-add!
        store
        lease
        (ownership.ownership-source-copy source))
        [(typed.TypedOriginResult.Ok id) id]
        [(typed.TypedOriginResult.Err error)
          (return (TcSelectedPatternResult.Err (tc-selected-error error)))])]
    [empty : (__tl_dyn-array typed.TypedOccurrenceId)
      (tc-selected-no-occurrences)]
    (match (typed.typed-occurrence-add!
      store
      lease
      type-id
      typed.TypedSyntax.Generated
      origin
      (typed.TypedOperation.Read binder)
      (& empty))
      [(typed.TypedOccurrenceResult.Ok id) (TcSelectedPatternResult.Ok id)]
      [(typed.TypedOccurrenceResult.Err error)
        (TcSelectedPatternResult.Err (tc-selected-error error))])))

;; A `unit` value the producer introduces (no source occurrence).
(define (tc-selected-unit-literal!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [source : (& source ownership.OwnershipSource)]) : TcSelectedPatternResult
  (let
    [type-id : typed.TypedTypeId
      (match (typed.typed-type-add! store lease ast.AstType.Unit)
        [(typed.TypedTypeIdResult.Ok id) id]
        [(typed.TypedTypeIdResult.Err error)
          (return (TcSelectedPatternResult.Err (tc-selected-error error)))])]
    [origin : typed.TypedOriginId
      (match (typed.typed-origin-add!
        store
        lease
        (ownership.ownership-source-copy source))
        [(typed.TypedOriginResult.Ok id) id]
        [(typed.TypedOriginResult.Err error)
          (return (TcSelectedPatternResult.Err (tc-selected-error error)))])]
    [empty : (__tl_dyn-array typed.TypedOccurrenceId)
      (tc-selected-no-occurrences)]
    (match (typed.typed-occurrence-add!
      store
      lease
      type-id
      typed.TypedSyntax.Generated
      origin
      (typed.TypedOperation.Literal ast.AstLiteral.Unit)
      (& empty))
      [(typed.TypedOccurrenceResult.Ok id) (TcSelectedPatternResult.Ok id)]
      [(typed.TypedOccurrenceResult.Err error)
        (TcSelectedPatternResult.Err (tc-selected-error error))])))

;; `(Variant binder)` (or `(Variant)` without a payload) at the binder place.
(define (tc-selected-try-pattern!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [enum-ty : ast.AstType]
  [variant : (& variant TcSelectedVariant)]
  [payload-ty : ast.AstType]
  [binder : typed.TypedBinderId]
  [payload? : bool]
  [place : (& place typed.TypedPlaceId)]
  [source : (& source ownership.OwnershipSource)]) : TcSelectedPatternResult
  (let
    [position : TcSelectedMaybePlace
      (TcSelectedMaybePlace.Some
        (typed.TypedPlaceId (typed.typed-handle-copy (& place.handle))))]
    [children : (__tl_dyn-array typed.TypedOccurrenceId)
      (match (tc-selected-position-children! store lease (& position) source)
        [(TcSelectedPatternChildren.Ok list) list]
        [(TcSelectedPatternChildren.Err message)
          (return (TcSelectedPatternResult.Err message))])]
    (when
      payload?
      (let
        [sub-position : TcSelectedMaybePlace
          (match (tc-selected-position-project!
            store
            lease
            (& position)
            (tc-global-shared-view payload-ty)
            (typed.TypedProjectionKind.Payload
              (typed.TypedResolvedGlobal
                lease.resolutions.owner
                lease.resolutions.generation
                lease.resolutions.revision
                variant.declaration)
              variant.offset)
            source)
            [(TcSelectedPositionResult.Ok sub) sub]
            [(TcSelectedPositionResult.Err message)
              (return (TcSelectedPatternResult.Err message))])]
        [sub-children : (__tl_dyn-array typed.TypedOccurrenceId)
          (match (tc-selected-position-children!
            store
            lease
            (& sub-position)
            source)
            [(TcSelectedPatternChildren.Ok list) list]
            [(TcSelectedPatternChildren.Err message)
              (return (TcSelectedPatternResult.Err message))])]
        (match (tc-selected-pattern-node!
          store
          lease
          payload-ty
          (typed.TypedPattern.Bind binder)
          sub-children
          source)
          [(TcSelectedPatternResult.Ok bound)
            (tc-selected-occurrences-push! (&mut children) bound)]
          [(TcSelectedPatternResult.Unsupported)
            (return TcSelectedPatternResult.Unsupported)]
          [(TcSelectedPatternResult.Err message)
            (return (TcSelectedPatternResult.Err message))])))
    (tc-selected-pattern-node!
      store
      lease
      enum-ty
      (typed.TypedPattern.Variant variant.ordinal)
      children
      source)))

;; --- Array and raw storage forms (#8449) -------------------------------------
;;
;; Legacy types each form; its operands are produced by access mode
;; (`tc-selected-form-*` codes): 0 reads (an owned non-Copy place is borrowed
;; shared, any other operand is a value), 1 writes (the place is borrowed
;; exclusively; through a `&mut` parameter, reborrowed), 2 consumes (an
;; evaluated value moved in). The form is `Primitive (Builtin code arity)`.
(define (tc-selected-form-code-array-data) : i64
  101)

(define (tc-selected-form-code-string-data) : i64
  102)

(define (tc-selected-form-code-make-array) : i64
  103)

(define (tc-selected-form-code-array-push) : i64
  104)

(define (tc-selected-form-code-array-set) : i64
  105)

;; Form 105 at a literal index of an owned fixed array (an exact element).
(define (tc-selected-form-code-fixed-element-set) : i64
  126)

;; `(set! (array-ref a N) v)` of an owned fixed array `a` at a literal `N`.
(define (tc-selected-fixed-element-store?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [array-id : i64]
  [index-id : i64]) : bool
  (and
    (match (ast.ast-expr-unspan (& (tc-context-expr-get ctx index-id)))
      [(ast.AstExpr.Literal (ast.AstLiteral.Int _ _)) true]
      [_ false])
    (match (tc-expr-id ctx env array-id)
      [(ResultTcType.Ok ty)
        (match (tc-type-strip-region
          (tc-resolve-type ctx (tc-global-shared-view ty)))
          [(ast.AstType.Array _ _) true]
          [_ false])]
      [(ResultTcType.Err _) false])))

(define (tc-selected-exact-element-store
  [ctx : TcContext]
  [env : TcTypeEnv]
  [array-id : i64]
  [index-id : i64]) : i64
  (match (tc-expr-id ctx env array-id)
    [(ResultTcType.Ok ty)
      (tc-selected-exact-element ctx ty (tc-context-expr-get ctx index-id))]
    [(ResultTcType.Err _) -1]))

;; `(set! (array-ref items k) value)` at an exact element path: legacy typing
;; checks the store, then the value is moved into the element's place, which
;; reinitializes it (SPEC: literal-index stores).
(define (tc-infer-selected-exact-element-store
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [array-id : i64]
  [index-id : i64]
  [value-id : i64]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-legacy
    ctx
    env
    (tc-global-shared-view expr)
    syntax
    expected)
    [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcType.Ok _)
      (match (tc-infer-selected-array-place
        ctx
        env
        array-id
        index-id
        (tc-global-shared-view source)
        sink)
        [(TcSelectedPlaceResult.Err message next)
          (TcSelectedResult.Err message next)]
        [(TcSelectedPlaceResult.Ok element-ty place next)
          (match (tc-infer-selected-id
            ctx
            env
            value-id
            (ast.AstMaybeType.Some
              (tc-type-strip-region (tc-global-shared-view element-ty)))
            (tc-global-shared-view source)
            next)
            [(TcSelectedResult.Err message after)
              (TcSelectedResult.Err message after)]
            [(TcSelectedResult.Ok value-ty occurrence after)
              ;; As the graph sees types: a Copy value read through a
              ;; reference is a plain value (`tc-selected-canonical-type`).
              (if (tc-selected-same-type?
                (tc-selected-canonical-type
                  ctx
                  (tc-type-strip-region (tc-global-shared-view element-ty)))
                (tc-selected-canonical-type
                  ctx
                  (tc-global-shared-view value-ty)))
                (tc-selected-place-assign
                  (ResultTcType.Ok ast.AstType.Unit)
                  false
                  syntax
                  source
                  place
                  occurrence
                  after)
                (tc-selected-unrepresented
                  (ResultTcType.Ok ast.AstType.Unit)
                  after))])])]))

(define (tc-selected-form-code-string-ref) : i64
  106)

(define (tc-selected-form-code-global) : i64
  108)

(define (tc-selected-form-code-box) : i64
  109)

(define (tc-selected-form-code-box-get) : i64
  110)

(define (tc-selected-form-code-box-set) : i64
  111)

(define (tc-selected-form-code-deref-value) : i64
  112)

(define (tc-selected-form-code-value-field) : i64
  113)

(define (tc-selected-form-code-array-literal) : i64
  114)

(define (tc-selected-form-code-dyn-array-literal) : i64
  115)

;; `(in-arena arena body ...)`: children are the arena operand and the body.
(define (tc-selected-form-code-in-arena) : i64
  116)

(define (tc-selected-form-code-syscall) : i64
  117)

(define (tc-selected-form-code-string-from-bytes) : i64
  118)

;; A fixed array of initialized elements: its length operand alone.
(define (tc-selected-form-code-fixed-make-array) : i64
  119)

;; `__tl_array-take!`: the array and its liveness bitmap are written, the
;; index read; the result is a fresh (taken?, element) tuple.
(define (tc-selected-form-code-array-take) : i64
  120)

;; The process argument vector pointer: no operands.
(define (tc-selected-form-code-program-argv) : i64
  121)

;; The process argument count: no operands.
(define (tc-selected-form-code-program-argc) : i64
  122)

;; An arena owner read as its bare handle: the operand is a shared reference to
;; the owner place, which stays usable.
(define (tc-selected-form-code-arena-handle) : i64
  123)

;; --- Closures (SPEC 3.10.4, #8449) -------------------------------------------
;;
;; Typing stays legacy (`tc-lambda-expr`: capture, capability and escape
;; rules). A lambda's captures are the enclosing locals its body names; the
;; closure value is form 135 over them: a Copy capture is copied, a move-only
;; one (and a `&mut` reference) moves in. A Copy closure holding no reference
;; keeps its function type (a loan-free Copy value); any other closure's
;; canonical type is its environment `(Tuple marker captures...)`, the marker
;; `(Array bool capability)` recording its call capability (0 shared, 1
;; mutable, 2 once). The lambda body is its own MIR body whose captures are
;; `Capture` binders in its environment at entry.
(define (tc-selected-form-code-closure) : i64
  135)

(defstruct TcSelectedCapture
  (slot i64)
  (name i64)
  (binder typed.TypedBinderId))

(defenum TcSelectedCaptures
  (Ok (__tl_dyn-array TcSelectedCapture))
  (Unrepresented))

;; The enclosing locals the lambda body names, innermost first: each scoped
;; slot whose name the body uses free (a shadowed slot is skipped) and that a
;; selected binder holds. A captured name without one keeps the legacy route.
(define (tc-selected-lambda-captures
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : (& bindings TcSelectedBindings)]
  [params : (& params ast.AstParamList)]
  [body : ast.AstExpr]) : TcSelectedCaptures
  (if (not
    (and
      (tc-type-env-scoped-runtime-active? env)
      bindings.pinned?
      (= env.store bindings.env-store)
      (= env.abi-pad bindings.scoped-state)))
    TcSelectedCaptures.Unrepresented
    (let
      [carrier : TcTypeEnvScopedCarrier
        (tc-type-env-scoped-runtime-current env)]
      [count : i64
        (if (<
          carrier.sidecar.stack.slot-count
          (array-length carrier.sidecar.stack.slots))
          carrier.sidecar.stack.slot-count
          (array-length carrier.sidecar.stack.slots))]
      [bound : TcStringList
        (tc-param-bound-names
          (owned_view.compiler-owned-reference-shared-view params))]
      [seen : TcStringList TcStringList.Nil]
      [captures : (__tl_dyn-array TcSelectedCapture)
        (__tl_make-array TcSelectedCapture 0)]
      [index : i64 (- count 1)]
      [ok? : bool true]
      (while (and ok? (>= index 0))
        (let
          [slot : (& carrier TcTypeEnvScopedSlot)
            (& (array-ref carrier.sidecar.stack.slots index))]
          (when
            (= (bit-and slot.flags tc-type-env-scoped-flag-marker) 0)
            (let
              [name : String (tc-env-key-name-text slot.name-id)]
              (when
                (and
                  (not
                    (tc-string-list-contains
                      (tc-global-shared-view seen)
                      (tc-global-shared-view name)))
                  (tc-expr-uses-free-name?
                    (tc-context-expr-bases ctx)
                    (tc-global-shared-view body)
                    (tc-global-shared-view name)
                    (tc-global-shared-view bound)))
                (set! seen (tc-string-list-add seen name))
                (match (if (< index bindings.len)
                  (tc-selected-slot-binder bindings index slot.generation)
                  TcSelectedBinder.Unrepresented)
                  [(TcSelectedBinder.Found binder)
                    (__tl_array-push!
                      captures
                      (TcSelectedCapture index slot.name-id binder))]
                  [(TcSelectedBinder.Unrepresented) (set! ok? false)]))))
          (set! index (- index 1))))
      (if ok?
        (TcSelectedCaptures.Ok captures)
        TcSelectedCaptures.Unrepresented))))

;; The value type of a selected binder (as it was registered).
(define (tc-selected-binder-type!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [binder : (& binder typed.TypedBinderId)]) : ast.AstType
  (let
    [type-id : i64
      (match (typed.typed-binder-get!
        store
        lease
        (typed.TypedBinderId (typed.typed-handle-copy (& binder.handle))))
        [(typed.TypedBinderView.Ok row) row.type.handle.index]
        [(typed.TypedBinderView.Err _) -1])]
    (if (< type-id 0)
      ast.AstType.Never
      (match (typed.typed-type-value-at! store lease type-id)
        [(typed.TypedTypeValueResult.Ok value) value]
        [(typed.TypedTypeValueResult.Err _) ast.AstType.Never]))))

;; The value type of a published occurrence.
(define (tc-selected-occurrence-type!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [id : (& id typed.TypedOccurrenceId)]) : ast.AstType
  (let
    [type-id : i64
      (match (typed.typed-occurrence-get!
        store
        lease
        (typed.TypedOccurrenceId (typed.typed-handle-copy (& id.handle))))
        [(typed.TypedNodeResult.Ok node) node.type.handle.index]
        [(typed.TypedNodeResult.Err _) -1])]
    (if (< type-id 0)
      ast.AstType.Never
      (match (typed.typed-type-value-at! store lease type-id)
        [(typed.TypedTypeValueResult.Ok value) value]
        [(typed.TypedTypeValueResult.Err _) ast.AstType.Never]))))

;; A closure environment's call capability (its marker), or -1 for any other
;; type.
(define (tc-selected-closure-capability [ty : ast.AstType]) : i64
  (match (tc-global-shared-view ty)
    [(ast.AstType.Tuple elems)
      (let
        [list : ast.AstTypeList (ast.ast-type-list-box-shared-view elems)]
        (if (< (ast.ast-type-list-len (& list)) 1)
          -1
          (match (ast.ty-node-get
            (ast.ast-type-list-get (& list) 0 (ast.ast-type-id-fallback)))
            [(ast.AstType.Array elem count)
              (match (ast.ty-node-get elem)
                [(ast.AstType.Bool) count]
                [_ -1])]
            [_ -1])))]
    [_ -1]))

(defenum TcSelectedLambdaBody
  (Ok i64)
  (Unrepresented)
  (Err String))

;; The lambda body as its own MIR body (a separate typed store on the same
;; lease): its captures are `Capture` binders of their enclosing slots, its
;; parameters and return type are bound on top of the enclosing scope. The
;; result is its call capability: once when the body moves a capture out,
;; mutable when it captures a mutable reference, shared otherwise.
(define (tc-selected-check-lambda-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : (& params ast.AstParamList)]
  [ret : ast.AstType]
  [body-id : i64]
  [captures : (& captures (__tl_dyn-array TcSelectedCapture))]
  [capture-types : (& capture-types (__tl_dyn-array ast.AstType))]
  ;; The enclosing body's arena regions (its captures may hold them).
  [regions : (__tl_dyn-array i64)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [source : ownership.OwnershipSource]) : TcSelectedLambdaBody
  (match (typed.typed-store-new-growing lease (tc-selected-body-limits))
    [(typed.TypedStoreResult.Err error)
      (TcSelectedLambdaBody.Err (tc-selected-error error))]
    [(typed.TypedStoreResult.Ok store)
      (let
        [_regions : unit
          (let
            [index : i64 0]
            (while (< index (array-length regions))
              (begin
                (match (typed.typed-arena-region-note!
                  (&mut store)
                  lease
                  (array-ref regions index))
                  [(typed.TypedResult.Err error)
                    (typed.typed-store-retire! (&mut store))
                    (return
                      (TcSelectedLambdaBody.Err (tc-selected-error error)))]
                  [(typed.TypedResult.Ok _) unit])
                (set! index (+ index 1)))))]
        [saved : TcTypeEnvScopedRuntimeSave
          (tc-type-env-scoped-runtime-enter-env! env)]
        [inferred : TcSelectedLambdaInferred
          (tc-selected-check-lambda-body-in
            ctx
            env
            params
            ret
            body-id
            captures
            capture-types
            (&mut store)
            lease
            source)]
        [result : TcSelectedLambdaBody
          (match inferred
            [(TcSelectedLambdaInferred.Done body) body]
            [(TcSelectedLambdaInferred.Root root return-type noted)
              (tc-selected-lambda-body-normalize
                ctx
                (&mut store)
                lease
                root
                return-type
                (& noted)
                capture-types)])]
        (tc-type-env-scoped-runtime-restore! saved)
        (typed.typed-store-retire! (&mut store))
        result)]))

;; The inferred lambda body: a finished result, or its root occurrence (with
;; its return type and capture binders) to normalize.
(defenum TcSelectedLambdaInferred
  (Done TcSelectedLambdaBody)
  (Root
    typed.TypedOccurrenceId
    typed.TypedTypeId
    (__tl_dyn-array typed.TypedBinderId)))

;; The lambda body's MIR check: its normalized body gives the closure's call
;; capability.
(define (tc-selected-lambda-body-normalize
  [ctx : TcContext]
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [root : typed.TypedOccurrenceId]
  [return-type : typed.TypedTypeId]
  [noted : (& noted (__tl_dyn-array typed.TypedBinderId))]
  [capture-types : (& capture-types (__tl_dyn-array ast.AstType))]) : TcSelectedLambdaBody
  (match (tc-selected-normalize-body
    ctx
    store
    lease
    root
    return-type
    (ownership_normalize.ownership-normalize-default-limits))
    [(ownership_normalize.OwnershipNormalizeResult.Err failure)
      (match (tc-selected-normalization-failure-in ctx store lease failure)
        [(ResultTcUnit.Ok) TcSelectedLambdaBody.Unrepresented]
        [(ResultTcUnit.Err message) (TcSelectedLambdaBody.Err message)])]
    [(ownership_normalize.OwnershipNormalizeResult.Ok output)
      (tc-selected-defer-global-effects! ctx (& output.deferred))
      (TcSelectedLambdaBody.Ok
        (tc-selected-lambda-capability (& output) noted capture-types))]))

(define (tc-selected-check-lambda-body-in
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : (& params ast.AstParamList)]
  [ret : ast.AstType]
  [body-id : i64]
  [captures : (& captures (__tl_dyn-array TcSelectedCapture))]
  [capture-types : (& capture-types (__tl_dyn-array ast.AstType))]
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [source : ownership.OwnershipSource]) : TcSelectedLambdaInferred
  (let
    [return-type : typed.TypedTypeId
      (match (typed.typed-type-add! store lease (tc-global-shared-view ret))
        [(typed.TypedTypeIdResult.Ok id) id]
        [(typed.TypedTypeIdResult.Err error)
          (return
            (TcSelectedLambdaInferred.Done
              (TcSelectedLambdaBody.Err (tc-selected-error error))))])]
    [bindings : TcSelectedBindings (tc-selected-bindings-new lease)]
    [outer : TcTypeEnvScopedCarrier (tc-type-env-scoped-runtime-current env)]
    [noted : (__tl_dyn-array typed.TypedBinderId) (tc-selected-no-binders)]
    [index : i64 0]
    ;; Each capture is a binder of its enclosing slot, in the environment.
    (while (< index (array-length captures))
      (begin
        (match (tc-selected-binding-note-at!
          store
          lease
          (&mut bindings)
          (& outer)
          (array-ref captures index).slot
          (owned_view.compiler-owned-reference-shared-view
            (& (array-ref capture-types index)))
          typed.TypedBinderKind.Capture
          (& source))
          [(TcSelectedBinderLookup.Ok found)
            (match found
              [(TcSelectedBinder.Found binder)
                (tc-selected-binders-push! (&mut noted) binder)]
              [(TcSelectedBinder.Unrepresented)
                (return
                  (TcSelectedLambdaInferred.Done
                    TcSelectedLambdaBody.Unrepresented))])]
          [(TcSelectedBinderLookup.Err error)
            (return
              (TcSelectedLambdaInferred.Done
                (TcSelectedLambdaBody.Err (tc-selected-error error))))])
        (set! index (+ index 1))))
    (match (tc-type-env-scoped-carrier-bind-params
      ctx
      outer
      params
      store
      lease
      (&mut bindings)
      (ownership.ownership-source-copy (& source)))
      [(ResultTcScopedCarrier.Err message)
        (TcSelectedLambdaInferred.Done (TcSelectedLambdaBody.Err message))]
      [(ResultTcScopedCarrier.Ok params-carrier)
        (let
          [carrier : TcTypeEnvScopedCarrier
            (tc-type-env-scoped-carrier-bind-return-type
              params-carrier
              (tc-global-shared-view ret))]
          [inner-env : TcTypeEnv (tc-type-env-scoped-carrier-env (& carrier))]
          [entered : TcTypeEnvScopedRuntimeSave
            (tc-type-env-scoped-runtime-enter! carrier)]
          [closed : TcSelectedClosedResult
            (let
              [current : TcTypeEnvScopedCarrier
                (tc-type-env-scoped-runtime-current inner-env)]
              (match (tc-selected-bindings-pin!
                (&mut bindings)
                lease
                (& current))
                [(typed.TypedResult.Err error)
                  (TcSelectedClosedResult.Err (tc-selected-error error))]
                [(typed.TypedResult.Ok _)
                  (tc-selected-close
                    (tc-infer-selected-id
                      ctx
                      inner-env
                      body-id
                      (ast.AstMaybeType.Some (tc-global-shared-view ret))
                      (ownership.ownership-source-copy (& source))
                      (TcSelectedSink.Capture store lease (&mut bindings))))]))]
          (tc-type-env-scoped-runtime-restore! entered)
          (match closed
            [(TcSelectedClosedResult.Err message)
              (TcSelectedLambdaInferred.Done (TcSelectedLambdaBody.Err message))]
            [(TcSelectedClosedResult.Ok _ root)
              (match root
                [(TcSelectedOccurrence.Unrepresented)
                  (TcSelectedLambdaInferred.Done
                    TcSelectedLambdaBody.Unrepresented)]
                [(TcSelectedOccurrence.Selected id)
                  ;; Its early exits, judged with the finished body's arena
                  ;; regions.
                  (match (tc-selected-exit-flow-failure ctx store (& bindings))
                    [(TcMaybeString.Some message)
                      (TcSelectedLambdaInferred.Done
                        (TcSelectedLambdaBody.Err message))]
                    [(TcMaybeString.No)
                      (TcSelectedLambdaInferred.Root id return-type noted)])])]))])))

;; Once when the body moves (or ends) a capture, mutable when a capture holds
;; a mutable reference, shared otherwise.
(define (tc-selected-lambda-capability
  [output : (& output ownership_normalize.OwnershipNormalizedBody)]
  [captures : (& captures (__tl_dyn-array typed.TypedBinderId))]
  [capture-types : (& capture-types (__tl_dyn-array ast.AstType))]) : i64
  (let
    [body : (& output ownership.OwnershipBody) (& output.body)]
    [places : (__tl_dyn-array i64) (tc-selected-no-i64s)]
    [index : i64 0]
    [once? : bool false]
    [mutable? : bool false]
    (while (< index (array-length output.binders))
      (let
        [binder : (& output ownership_normalize.NormalizeBinder)
          (& (array-ref output.binders index))]
        (let
          [capture : i64 0]
          (while (< capture (array-length captures))
            (when
              (= binder.handle.index (array-ref captures capture).handle.index)
              (tc-selected-i64s-push! (&mut places) binder.place))
            (set! capture (+ capture 1))))
        (set! index (+ index 1))))
    (set! index 0)
    (while (and (not once?) (< index (array-length body.blocks)))
      (let
        [instructions : (&
          output
          (__tl_dyn-array ownership.OwnershipInstruction))
          (& (array-ref body.blocks index).instructions)]
        [at : i64 0]
        (while (and (not once?) (< at (array-length instructions)))
          (let
            [target : i64
              (match (& (array-ref instructions at).operation)
                [(ownership.OwnershipOperation.Move source _) source.index]
                [(ownership.OwnershipOperation.Consume place) place.index]
                ;; A capture's storage ending at a return is the call's own
                ;; copy ending, not the body ending the capture (#9297).
                [(ownership.OwnershipOperation.Invalidate place)
                  (if (ownership_normalize.normalize-i64-member?
                    (& output.storage-ends)
                    (+ (* index 4294967296) at))
                    -1
                    place.index)]
                [_ -1])]
            [place : i64 0]
            (when
              (>= target 0)
              (while (and (not once?) (< place (array-length places)))
                (when
                  (ownership.ownership-overlap?
                    body
                    target
                    (array-ref places place))
                  (set! once? true))
                (set! place (+ place 1))))
            (set! at (+ at 1))))
        (set! index (+ index 1))))
    (set! index 0)
    (while (< index (array-length capture-types))
      (when
        (tc-type-contains-mut-reference?
          (owned_view.compiler-owned-reference-shared-view
            (& (array-ref capture-types index))))
        (set! mutable? true))
      (set! index (+ index 1)))
    (cond [once? 2] [mutable? 1] [else 0])))

;; `(lambda (params) body)`: legacy typing first; then the body's own MIR check
;; and the closure value over its capture transfers.
(define (tc-infer-selected-lambda
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [lambda-box : (Box ast.AstLambda)]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    ;; A closure flowing into a function-typed slot (a result, an argument,
    ;; a field or a store) is coerced to its function type.
    [coerced? : bool
      (match (tc-global-shared-view expected)
        [(ast.AstMaybeType.Some want)
          (match (tc-resolve-type ctx want)
            [(ast.AstType.Func _ _) true]
            [_ false])]
        [(ast.AstMaybeType.No) false])]
    (match (tc-infer-selected-legacy
      ctx
      env
      (tc-global-shared-view expr)
      syntax
      expected)
      [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
      [(ResultTcType.Ok ty)
        (tc-infer-selected-closure
          ctx
          env
          lambda-box
          ty
          coerced?
          syntax
          source
          sink)])))

;; The closure value of a lambda typed `ty` (see `tc-selected-publish-closure`);
;; `coerced?` when it flows into a function-typed slot.
(define (tc-infer-selected-closure
  [ctx : TcContext]
  [env : TcTypeEnv]
  [lambda-box : (Box ast.AstLambda)]
  [ty : ast.AstType]
  [coerced? : bool]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match sink
    [(TcSelectedSink.Query)
      (tc-selected-unrepresented (ResultTcType.Ok ty) TcSelectedSink.Query)]
    [(TcSelectedSink.Capture store lease bindings)
      (match (ast.ast-lambda-box-shared-view lambda-box)
        [(ast.AstLambda.Lambda params _ body-id)
          (let
            [body : ast.AstExpr (tc-context-expr-get ctx body-id)]
            [ret : ast.AstType
              (match (tc-resolve-type ctx (tc-global-shared-view ty))
                [(ast.AstType.Func _ result) (ast.ty-node-get result)]
                [_ ast.AstType.Never])]
            (match (tc-selected-lambda-captures
              ctx
              env
              (& bindings)
              (& params)
              (tc-global-shared-view body))
              [(TcSelectedCaptures.Unrepresented)
                (tc-selected-unrepresented
                  (ResultTcType.Ok ty)
                  (TcSelectedSink.Capture store lease bindings))]
              [(TcSelectedCaptures.Ok captures)
                (let
                  [capture-types : (__tl_dyn-array ast.AstType)
                    (tc-selected-no-types)]
                  [index : i64 0]
                  (while (< index (array-length captures))
                    (begin
                      (tc-selected-types-push!
                        (&mut capture-types)
                        (tc-selected-binder-type!
                          store
                          lease
                          (& (array-ref captures index).binder)))
                      (set! index (+ index 1))))
                  (match (let
                    [observer : TcSemanticObserver
                      (if (= tc-semantic-observed-jobs 0)
                        (TcSemanticObserver 0)
                        (tc-context-semantic-observer ctx))]
                    [_enter : unit
                      (when
                        (!= observer.address 0)
                        (tc-semantic-observer-send!
                          observer
                          ctx
                          env
                          (FunctionEnter
                            -1
                            (match (tc-context-expr-get ctx body-id)
                              [(ast.AstExpr.Spanned inner _) inner]
                              [_ -1])
                            (tc-global-shared-view params)
                            (ast.AstMaybeType.Some (tc-global-shared-view ret)))))]
                    [checked : TcSelectedLambdaBody
                      (tc-selected-check-lambda-body
                        ctx
                        env
                        (& params)
                        (tc-global-shared-view ret)
                        body-id
                        (& captures)
                        (& capture-types)
                        (typed.typed-arena-regions-copy (& store))
                        lease
                        (tc-global-shared-view source))]
                    (when
                      (!= observer.address 0)
                      (tc-semantic-observer-send!
                        observer
                        ctx
                        env
                        (FunctionLeave
                          (match (& checked)
                            [(TcSelectedLambdaBody.Err message)
                              (ResultTcType.Err (string.copy message))]
                            [_ (ResultTcType.Ok (tc-global-shared-view ret))]))))
                    checked)
                    [(TcSelectedLambdaBody.Err message)
                      (TcSelectedResult.Err
                        message
                        (TcSelectedSink.Capture store lease bindings))]
                    [(TcSelectedLambdaBody.Unrepresented)
                      (tc-selected-unrepresented
                        (ResultTcType.Ok ty)
                        (TcSelectedSink.Capture store lease bindings))]
                    [(TcSelectedLambdaBody.Ok capability)
                      (match (if coerced?
                        (tc-selected-closure-coerce
                          ctx
                          (& source)
                          (& capture-types)
                          capability)
                        ResultTcUnit.Ok)
                        [(ResultTcUnit.Err message)
                          (TcSelectedResult.Err
                            message
                            (TcSelectedSink.Capture store lease bindings))]
                        [(ResultTcUnit.Ok)
                          (tc-selected-publish-closure
                            ctx
                            ty
                            (& captures)
                            (& capture-types)
                            (tc-selected-kept-captures env (& captures) true)
                            capability
                            syntax
                            source
                            (TcSelectedSink.Capture store lease bindings))])]))]))])]))

;; A closure is plain when it is shared (capability 0) and every capture is a
;; Copy value without references or regions: its environment is then a plain
;; function value. Any other environment keeps its own type.
(define (tc-selected-closure-plain?
  [ctx : TcContext]
  [capture-types : (& capture-types (__tl_dyn-array ast.AstType))]
  [capability : i64]) : bool
  (let
    [plain? : bool (= capability 0)]
    [index : i64 0]
    (while (and plain? (< index (array-length capture-types)))
      (let
        [capture-type : ast.AstType
          (owned_view.compiler-owned-reference-shared-view
            (& (array-ref capture-types index)))]
        (when
          (or
            (not (tc-type-copyable? ctx (tc-global-shared-view capture-type)))
            (tc-type-contains-reference? (tc-global-shared-view capture-type))
            (tc-type-contains-any-region capture-type))
          (set! plain? false))
        (set! index (+ index 1))))
    plain?))

;; Coercing a closure to a function type erases its environment, so only a
;; plain closure coerces; any other closure stays confined to its direct local
;; binding (SPEC closures).
(define (tc-selected-closure-coerce
  [ctx : TcContext]
  [source : (& source ownership.OwnershipSource)]
  [capture-types : (& capture-types (__tl_dyn-array ast.AstType))]
  [capability : i64]) : ResultTcUnit
  (if (tc-selected-closure-plain? ctx capture-types capability)
    ResultTcUnit.Ok
    (let
      [references? : bool false]
      [index : i64 0]
      (while (< index (array-length capture-types))
        (when
          (or
            (tc-type-contains-reference?
              (owned_view.compiler-owned-reference-shared-view
                (& (array-ref capture-types index))))
            (tc-type-contains-any-region
              (owned_view.compiler-owned-reference-shared-view
                (& (array-ref capture-types index)))))
          (set! references? true))
        (set! index (+ index 1)))
      (ResultTcUnit.Err
        (tc-selected-expansion-framed
          (& source.expansion)
          (tc-located-error
            (tc-selected-source-span source)
            (cond
              [(> capability 0) (tc-capability-closure-escape-message)]
              [references? (tc-reference-closure-escape-message)]
              [else (tc-move-closure-escape-message)])))))))

;; Which captures are read without moving: with `keep?`, each atomic arena
;; owner (`tc-selected-raw-spawn-entry?`).
(define (tc-selected-kept-captures
  [env : TcTypeEnv]
  [captures : (& captures (__tl_dyn-array TcSelectedCapture))]
  [keep? : bool]) : (__tl_dyn-array bool)
  (let
    [kept : (__tl_dyn-array bool)
      (__tl_make-array bool (array-length captures))]
    [index : i64 0]
    (when
      keep?
      (while (< index (array-length captures))
        (set!
          (array-ref kept index)
          (tc-atomic-arena-owner-active-id? env (array-ref captures index).name))
        (set! index (+ index 1))))
    kept))

;; A captured owner read as its bare handle without moving it, as a bare
;; `Arena` argument reads one: form 123 over a shared borrow of the binder.
(define (tc-selected-owner-handle-op!
  [ctx : TcContext]
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [capture : (& capture TcSelectedCapture)]
  [ty : ast.AstType]
  ;; The bare handle (form 123) rather than the shared borrow itself.
  [handle? : bool]
  [source : (& source ownership.OwnershipSource)]) : TcSelectedPatternResult
  (let
    [place : typed.TypedPlaceId
      (match (typed.typed-place-add!
        store
        lease
        (typed.TypedPlaceKind.Root
          (typed.TypedBinderId
            (typed.typed-handle-copy (& capture.binder.handle)))))
        [(typed.TypedPlaceResult.Ok id) id]
        [(typed.TypedPlaceResult.Err error)
          (return (TcSelectedPatternResult.Err (tc-selected-error error)))])]
    [type-id : typed.TypedTypeId
      (match (typed.typed-place-get! store lease place)
        [(typed.TypedPlaceView.Ok row)
          (typed.TypedTypeId (typed.typed-handle-copy (& row.type.handle)))]
        [(typed.TypedPlaceView.Err error)
          (return (TcSelectedPatternResult.Err (tc-selected-error error)))])]
    [origin : typed.TypedOriginId
      (match (typed.typed-origin-add!
        store
        lease
        (ownership.ownership-source-copy source))
        [(typed.TypedOriginResult.Ok id) id]
        [(typed.TypedOriginResult.Err error)
          (return (TcSelectedPatternResult.Err (tc-selected-error error)))])]
    [no-children : (__tl_dyn-array typed.TypedOccurrenceId)
      (tc-selected-no-occurrences)]
    ;; Formed at the place's own type.
    [formed : typed.TypedOccurrenceId
      (match (typed.typed-occurrence-add!
        store
        lease
        type-id
        typed.TypedSyntax.Generated
        origin
        (typed.TypedOperation.FormPlace place)
        (& no-children))
        [(typed.TypedOccurrenceResult.Ok id) id]
        [(typed.TypedOccurrenceResult.Err error)
          (return (TcSelectedPatternResult.Err (tc-selected-error error)))])]
    [borrow : typed.TypedOccurrenceId
      (match (tc-selected-op!
        store
        lease
        (ast.ast-ty-ref
          capture.name
          (& (tc-borrow-referent-type (tc-global-shared-view ty))))
        (typed.TypedOperation.Borrow false)
        (__tl_make-array formed)
        source)
        [(TcSelectedPatternResult.Ok id) id]
        [(TcSelectedPatternResult.Unsupported)
          (return TcSelectedPatternResult.Unsupported)]
        [(TcSelectedPatternResult.Err message)
          (return (TcSelectedPatternResult.Err message))])]
    (if handle?
      (tc-selected-op!
        store
        lease
        (tc-selected-arena-bare-type ctx (tc-global-shared-view ty))
        (typed.TypedOperation.Primitive
          (typed.TypedPrimitive.Builtin (tc-selected-form-code-arena-handle) 1))
        (__tl_make-array borrow)
        source)
      (TcSelectedPatternResult.Ok borrow))))

;; The closure value: each capture read (copied or moved) into form 135.
;; The closure environment's capture types: a kept capture (an atomic arena
;; owner) is the shared reference its slot borrows.
(define (tc-selected-environment-capture-types
  [captures : (& captures (__tl_dyn-array TcSelectedCapture))]
  [capture-types : (& capture-types (__tl_dyn-array ast.AstType))]
  [kept : (& kept (__tl_dyn-array bool))]) : (__tl_dyn-array ast.AstType)
  (let
    [out : (__tl_dyn-array ast.AstType) (tc-selected-no-types)]
    [index : i64 0]
    (while (< index (array-length capture-types))
      (let
        [capture-type : ast.AstType
          (owned_view.compiler-owned-reference-shared-view
            (& (array-ref capture-types index)))]
        (tc-selected-types-push!
          (&mut out)
          (if (array-ref kept index)
            (ast.ast-ty-ref
              (array-ref captures index).name
              (& (tc-borrow-referent-type capture-type)))
            capture-type))
        (set! index (+ index 1))))
    out))

(define (tc-selected-publish-closure
  [ctx : TcContext]
  [ty : ast.AstType]
  [captures : (& captures (__tl_dyn-array TcSelectedCapture))]
  [capture-types : (& capture-types (__tl_dyn-array ast.AstType))]
  [kept : (__tl_dyn-array bool)]
  [capability : i64]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match sink
    [(TcSelectedSink.Query)
      (tc-selected-unrepresented (ResultTcType.Ok ty) TcSelectedSink.Query)]
    [(TcSelectedSink.Capture store lease bindings)
      (let
        [children : (__tl_dyn-array typed.TypedOccurrenceId)
          (tc-selected-no-occurrences)]
        ;; A kept atomic owner is held as a shared reference to its binder:
        ;; the closure is one of the owner's users (SPEC 5.16), so it keeps
        ;; the owner borrowed while it lives (its destroy waits for the
        ;; closure's last use).
        [environment-types : (__tl_dyn-array ast.AstType)
          (tc-selected-environment-capture-types
            captures
            capture-types
            (& kept))]
        [plain? : bool
          (tc-selected-closure-plain? ctx (& environment-types) capability)]
        [index : i64 0]
        (while (< index (array-length captures))
          (begin
            (match (if (array-ref kept index)
              (tc-selected-owner-handle-op!
                ctx
                store
                lease
                (& (array-ref captures index))
                (owned_view.compiler-owned-reference-shared-view
                  (& (array-ref capture-types index)))
                false
                (& source))
              (tc-selected-op!
                store
                lease
                (owned_view.compiler-owned-reference-shared-view
                  (& (array-ref capture-types index)))
                (typed.TypedOperation.Read
                  (typed.TypedBinderId
                    (typed.typed-handle-copy
                      (& (array-ref captures index).binder.handle))))
                (tc-selected-no-occurrences)
                (& source)))
              [(TcSelectedPatternResult.Ok id)
                (tc-selected-occurrences-push! (&mut children) id)]
              [(TcSelectedPatternResult.Unsupported)
                (return
                  (tc-selected-unrepresented
                    (ResultTcType.Ok ty)
                    (TcSelectedSink.Capture store lease bindings)))]
              [(TcSelectedPatternResult.Err message)
                (return
                  (TcSelectedResult.Err
                    message
                    (TcSelectedSink.Capture store lease bindings)))])
            (set! index (+ index 1))))
        (match (tc-selected-publish
          (ResultTcType.Ok
            (if plain?
              (tc-global-shared-view ty)
              (tc-selected-closure-environment (& environment-types) capability)))
          syntax
          source
          (typed.TypedOperation.Primitive
            (typed.TypedPrimitive.Builtin
              (tc-selected-form-code-closure)
              (array-length children)))
          children
          (TcSelectedSink.Capture store lease bindings))
          [(TcSelectedResult.Err message next)
            (TcSelectedResult.Err message next)]
          [(TcSelectedResult.Ok _ occurrence next)
            (TcSelectedResult.Ok ty occurrence next)]))]))

;; The callee of a call through a function value. A closure local (its binder
;; holds a closure environment) is used per its call capability: a shared one
;; is copied when Copy and borrowed otherwise, a mutable one is borrowed
;; exclusively, and a once one moves into the call.
(define (tc-infer-selected-callee
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    [name : i64
      (match (ast.ast-expr-unspan (& (tc-context-expr-get ctx func-id)))
        [(ast.AstExpr.Var raw) raw]
        [_ -1])]
    (match (tc-direct-lambda-check ctx env (tc-context-expr-get ctx func-id))
      ;; An immediately called lambda's closure is a temporary the call takes.
      [(TcDirectLambdaCheck.Ok fn-ty)
        (return
          (tc-infer-selected-direct-closure
            ctx
            env
            func-id
            (ResultTcType.Ok fn-ty)
            source
            sink))]
      [(TcDirectLambdaCheck.Err message)
        (return (TcSelectedResult.Err message sink))]
      [(TcDirectLambdaCheck.No) unit])
    (match sink
      [(TcSelectedSink.Query)
        (tc-infer-selected-operand ctx env func-id source TcSelectedSink.Query)]
      [(TcSelectedSink.Capture store lease bindings)
        (let
          [binder : TcSelectedBinder
            (if (or
              (< name 0)
              (>=
                (tc-dotted-name-first-dot-id
                  (tc-context-structural-session ctx)
                  name)
                0))
              TcSelectedBinder.Unrepresented
              (match (tc-var-binding-after-local-field-check-mode
                ctx
                env
                name
                (tc-hygiene-name-text-id-for-session
                  (tc-context-structural-session ctx)
                  name)
                false)
                [(ResultTcBinding.Ok _ _ origin)
                  (match (tc-selected-binding-find!
                    store
                    lease
                    (& bindings)
                    env
                    origin)
                    [(TcSelectedBinderLookup.Ok found) found]
                    [(TcSelectedBinderLookup.Err _)
                      TcSelectedBinder.Unrepresented])]
                [_ TcSelectedBinder.Unrepresented]))]
          (match binder
            [(TcSelectedBinder.Unrepresented)
              (tc-infer-selected-operand
                ctx
                env
                func-id
                source
                (TcSelectedSink.Capture store lease bindings))]
            [(TcSelectedBinder.Found id)
              (let
                [closure-ty : ast.AstType
                  (tc-selected-binder-type! store lease (& id))]
                [capability : i64
                  (tc-selected-closure-capability
                    (tc-global-shared-view closure-ty))]
                (cond
                  [(< capability 0)
                    (tc-infer-selected-operand
                      ctx
                      env
                      func-id
                      source
                      (TcSelectedSink.Capture store lease bindings))]
                  [(or
                      (= capability 2)
                      (and
                        (= capability 0)
                        (tc-type-copyable?
                          ctx
                          (tc-global-shared-view closure-ty))))
                    (match (tc-selected-op!
                      store
                      lease
                      (tc-global-shared-view closure-ty)
                      (typed.TypedOperation.Read id)
                      (tc-selected-no-occurrences)
                      (& source))
                      [(TcSelectedPatternResult.Ok read)
                        (TcSelectedResult.Ok
                          (tc-global-shared-view closure-ty)
                          (TcSelectedOccurrence.Selected read)
                          (TcSelectedSink.Capture store lease bindings))]
                      [(TcSelectedPatternResult.Unsupported)
                        (tc-selected-unrepresented
                          (ResultTcType.Ok (tc-global-shared-view closure-ty))
                          (TcSelectedSink.Capture store lease bindings))]
                      [(TcSelectedPatternResult.Err message)
                        (TcSelectedResult.Err
                          message
                          (TcSelectedSink.Capture store lease bindings))])]
                  [else
                    (tc-infer-selected-borrow
                      ctx
                      env
                      (= capability 1)
                      -1
                      func-id
                      true
                      typed.TypedSyntax.Generated
                      source
                      (TcSelectedSink.Capture store lease bindings))]))]))])))

;; `(Tuple (Array bool capability) captures...)`.
(define (tc-selected-closure-environment
  [capture-types : (& capture-types (__tl_dyn-array ast.AstType))]
  [capability : i64]) : ast.AstType
  (let
    [list : ast.AstTypeList (ast.ast-type-list-new)]
    [index : i64 (- (array-length capture-types) 1)]
    (while (>= index 0)
      (set! list (ast.ast-type-cons (& (array-ref capture-types index)) list))
      (set! index (- index 1)))
    (ast.ast-ty-tuple
      (ast.ast-type-cons
        (& (ast.ast-ty-array (& (ast.AstType.Bool)) capability))
        list))))

;; `(tuple a b ...)` (SPEC tuples): legacy typing decides the tuple type; each
;; element is inferred against its slot type and moved into the tuple (form
;; 129: a mutable reference element moves, it is not reborrowed).
(define (tc-infer-selected-tuple
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [items : (& items ast.AstExprList)]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-legacy ctx env expr syntax expected)
    [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcType.Ok ty)
      (match (tc-resolve-type ctx (tc-global-shared-view ty))
        [(ast.AstType.Tuple elems)
          (let
            [slots : ast.AstTypeList (ast.ast-type-list-box-shared-view elems)]
            ;; A tuple is not a cleanup-owning aggregate: one holding a cleanup
            ;; owner keeps the legacy route.
            (if (or
              (!=
                (ast.ast-type-list-len (& slots))
                (ast.ast-expr-list-len items))
              (not (tc-selected-call-type-ok? ctx (tc-global-shared-view ty)))
              (tc-type-reaches-cleanup? ctx (tc-global-shared-view ty)))
              (tc-selected-unrepresented (ResultTcType.Ok ty) sink)
              (match (tc-infer-selected-tuple-items
                ctx
                env
                items
                (& slots)
                0
                (__tl_make-array
                  typed.TypedOccurrenceId
                  (ast.ast-expr-list-len items))
                true
                (tc-global-shared-view source)
                sink)
                [(TcSelectedArgsResult.Err message next)
                  (TcSelectedResult.Err message next)]
                [(TcSelectedArgsResult.Ok children represented? next)
                  (if represented?
                    (tc-selected-publish
                      (ResultTcType.Ok (tc-global-shared-view ty))
                      syntax
                      source
                      (typed.TypedOperation.Primitive
                        (typed.TypedPrimitive.Builtin
                          (tc-selected-form-code-tuple)
                          (array-length children)))
                      children
                      next)
                    (tc-selected-unrepresented
                      (ResultTcType.Ok (tc-global-shared-view ty))
                      next))])))]
        [_ (tc-selected-unrepresented (ResultTcType.Ok ty) sink)])]))

(define (tc-infer-selected-tuple-items
  [ctx : TcContext]
  [env : TcTypeEnv]
  [items : (& items ast.AstExprList)]
  [slots : (& slots ast.AstTypeList)]
  [index : i64]
  [children : (__tl_dyn-array typed.TypedOccurrenceId)]
  [represented? : bool]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedArgsResult
    store
    lease
    intern
    bind)
  (if (>= index (ast.ast-expr-list-len items))
    (TcSelectedArgsResult.Ok children represented? sink)
    (match (tc-infer-selected-sequence-child
      ctx
      env
      (ast.ast-expr-list-get items index 0)
      (ast.AstMaybeType.Some
        (ast.ty-node-get
          (ast.ast-type-list-get slots index (ast.ast-type-id-fallback))))
      (tc-global-shared-view source)
      represented?
      sink)
      [(TcSelectedResult.Err message next)
        (TcSelectedArgsResult.Err message next)]
      [(TcSelectedResult.Ok _ occurrence next)
        (let
          [selected? : bool
            (match occurrence
              [(TcSelectedOccurrence.Selected child)
                (set! (array-ref children index) child)
                true]
              [(TcSelectedOccurrence.Unrepresented) false])]
          (tc-infer-selected-tuple-items
            ctx
            env
            items
            slots
            (+ index 1)
            children
            (and represented? selected?)
            source
            next))])))

;; A tuple literal: its elements, moved in.
(define (tc-selected-form-code-tuple) : i64
  129)

;; `(with-scratch body...)`: the body's value, cloned out of the scratch arena
;; into a fresh result. `(with-escape scratch body...)` reads the scratch
;; arena handle first (form 128).
(define (tc-selected-form-code-with-scratch) : i64
  127)

(define (tc-selected-form-code-with-escape) : i64
  128)

;; `(set! (array-ref view i) value)` through a mutable slice reference: the
;; reference (reborrowed for the store), the index and the stored value.
(define (tc-selected-form-code-slice-store) : i64
  125)

;; Whether expression `id` is a reference to a slice (`(& r (Slice T))` or
;; `(&mut r (Slice T))`): its elements are reached only through it.
(define (tc-selected-slice-reference?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [id : i64]) : bool
  (match (tc-expr-id ctx env id)
    [(ResultTcType.Ok ty)
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-global-shared-view ty)))
        [(ast.AstType.Ref _ inner)
          (match (tc-type-strip-region
            (tc-resolve-type ctx (ast.ty-node-get inner)))
            [(ast.AstType.Slice _) true]
            [_ false])]
        [(ast.AstType.MutRef _ inner)
          (match (tc-type-strip-region
            (tc-resolve-type ctx (ast.ty-node-get inner)))
            [(ast.AstType.Slice _) true]
            [_ false])]
        [_ false])]
    [(ResultTcType.Err _) false]))

;; The element ids of a literal, each consumed against the element type.
(define (tc-selected-list-ids [items : (& items ast.AstExprList)]) : (__tl_dyn-array
    i64)
  (let
    [count : i64 (ast.ast-expr-list-len items)]
    [ids : (__tl_dyn-array i64) (__tl_make-array i64 count)]
    [index : i64 0]
    (while (< index count)
      (set! (array-ref ids index) (ast.ast-expr-list-get items index 0))
      (set! index (+ index 1)))
    ids))

(define (tc-selected-modes [count : i64] [mode : i64]) : (__tl_dyn-array i64)
  (let
    [modes : (__tl_dyn-array i64) (__tl_make-array i64 count)]
    [index : i64 0]
    (while (< index count)
      (set! (array-ref modes index) mode)
      (set! index (+ index 1)))
    modes))

;; A field of an evaluated owned value (a call result, a raw read, an unsafe
;; block): the value is consumed and the field is the result. Values holding
;; references, regions, cleanup owners or arena handles keep the legacy route.
(define (tc-infer-selected-value-field
  [ctx : TcContext]
  [env : TcTypeEnv]
  [receiver : i64]
  [field : i64]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-id
    ctx
    env
    receiver
    ast.AstMaybeType.No
    (tc-global-shared-view source)
    sink)
    [(TcSelectedResult.Err message next) (TcSelectedResult.Err message next)]
    [(TcSelectedResult.Ok receiver-ty occurrence next)
      (match (tc-struct-get-result-type-id
        ctx
        (tc-global-shared-view receiver-ty)
        field)
        [(ResultTcType.Err message) (TcSelectedResult.Err message next)]
        [(ResultTcType.Ok ty)
          (match occurrence
            [(TcSelectedOccurrence.Selected child)
              ;; A value allocated in an arena (inside `in-arena`) is read
              ;; like any other: the arena's region tag aside.
              (if (tc-selected-value-type-supported?
                ctx
                (tc-resolve-type
                  ctx
                  (tc-selected-strip-arena-tags ctx env receiver-ty)))
                (tc-selected-publish
                  (ResultTcType.Ok ty)
                  syntax
                  source
                  (typed.TypedOperation.Primitive
                    (typed.TypedPrimitive.Builtin
                      (tc-selected-form-code-value-field)
                      1))
                  (__tl_make-array child)
                  next)
                (tc-selected-unrepresented (ResultTcType.Ok ty) next))]
            [(TcSelectedOccurrence.Unrepresented)
              (tc-selected-unrepresented (ResultTcType.Ok ty) next)])])]))

(define (tc-infer-selected-form
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [code : i64]
  [operands : (__tl_dyn-array i64)]
  [modes : (__tl_dyn-array i64)]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-legacy
    ctx
    env
    (tc-global-shared-view expr)
    syntax
    expected)
    [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcType.Ok ty)
      (match sink
        [(TcSelectedSink.Query)
          (TcSelectedResult.Ok
            ty
            TcSelectedOccurrence.Unrepresented
            TcSelectedSink.Query)]
        [(TcSelectedSink.Capture store lease bindings)
          (let
            [count : i64 (array-length operands)]
            [_verb : unit
              (set!
                bindings.write-verb
                (cond
                  [(= code (tc-selected-form-code-array-push)) "push onto"]
                  [(or
                      (= code (tc-selected-form-code-array-set))
                      (= code (tc-selected-form-code-fixed-element-set))
                      (= code (tc-selected-form-code-slice-store)))
                    "assign to an element of"]
                  [(= code (tc-selected-form-code-box-set)) "assign through"]
                  [else ""]))]
            (match (tc-infer-selected-form-operands
              ctx
              env
              operands
              modes
              0
              (tc-global-shared-view ty)
              (__tl_make-array typed.TypedOccurrenceId count)
              (tc-global-shared-view source)
              (TcSelectedSink.Capture store lease bindings))
              [(TcSelectedArgsResult.Err message next)
                (TcSelectedResult.Err message next)]
              [(TcSelectedArgsResult.Ok children represented? next)
                (if represented?
                  (tc-selected-publish
                    (ResultTcType.Ok ty)
                    syntax
                    source
                    (typed.TypedOperation.Primitive
                      (typed.TypedPrimitive.Builtin code count))
                    children
                    next)
                  (TcSelectedResult.Ok
                    ty
                    TcSelectedOccurrence.Unrepresented
                    next))]))])]))

;; The expected type of a consumed operand: mode 2 none, 3 an index (i64),
;; 4 a pushed element, 5 a stored element (of operand 0, a borrowed array).
(define (tc-selected-operand-expected
  [ctx : TcContext]
  [mode : i64]
  [first : ast.AstType]) : ast.AstMaybeType
  (let
    [container : ast.AstType
      (match (tc-resolve-type ctx (tc-global-shared-view first))
        [(ast.AstType.MutRef _ inner) (tc-context-type-get ctx inner)]
        [(ast.AstType.Ref _ inner) (tc-context-type-get ctx inner)]
        [_ (tc-global-shared-view first)])]
    (cond
      [(= mode 3) (ast.AstMaybeType.Some ast.AstType.I64)]
      [(= mode 4)
        (match (tc-array-push-receiver ctx container)
          [(ResultTcArrayReceiver.Ok (TcArrayReceiver _ elem))
            (ast.AstMaybeType.Some elem)]
          [(ResultTcArrayReceiver.Err _) ast.AstMaybeType.No])]
      [(= mode 5)
        (match (tc-array-set-receiver ctx container)
          [(ResultTcArrayReceiver.Ok (TcArrayReceiver _ elem))
            (ast.AstMaybeType.Some elem)]
          [(ResultTcArrayReceiver.Err _) ast.AstMaybeType.No])]
      ;; An element of an array literal: the literal's element type.
      [(= mode 7)
        (match (tc-type-strip-region
          (tc-resolve-type ctx (tc-global-shared-view container)))
          [(ast.AstType.Array elem _)
            (ast.AstMaybeType.Some (ast.ty-node-get elem))]
          [(ast.AstType.DynArray elem)
            (ast.AstMaybeType.Some (ast.ty-node-get elem))]
          [_ ast.AstMaybeType.No])]
      ;; A value stored through a box (or a reborrowed mutable referent).
      [(= mode 6)
        (match (tc-type-strip-region
          (tc-resolve-type ctx (tc-global-shared-view container)))
          [(ast.AstType.Box inner)
            (ast.AstMaybeType.Some
              (tc-project-from-region-container
                container
                (ast.ty-node-get inner)))]
          [_ (ast.AstMaybeType.Some container)])]
      [else ast.AstMaybeType.No])))

(define (tc-infer-selected-form-operands
  [ctx : TcContext]
  [env : TcTypeEnv]
  [operands : (__tl_dyn-array i64)]
  [modes : (__tl_dyn-array i64)]
  [index : i64]
  ;; Operand 0's type: a pushed or stored value expects its element type.
  [first : ast.AstType]
  [children : (__tl_dyn-array typed.TypedOccurrenceId)]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedArgsResult
    store
    lease
    intern
    bind)
  (if (>= index (array-length operands))
    (TcSelectedArgsResult.Ok children true sink)
    (let
      [operand : i64 (array-ref operands index)]
      [mode : i64 (array-ref modes index)]
      (match (cond
        [(= mode 0)
          (tc-infer-selected-operand
            ctx
            env
            operand
            (tc-global-shared-view source)
            sink)]
        [(= mode 1)
          (tc-infer-selected-write-operand
            ctx
            env
            operand
            (tc-global-shared-view source)
            sink)]
        [(= mode 8)
          (tc-infer-selected-write-operand-at
            ctx
            env
            operand
            (tc-global-shared-view source)
            true
            sink)]
        [else
          (tc-infer-selected-sequence-child
            ctx
            env
            operand
            (tc-selected-operand-expected
              ctx
              mode
              (tc-global-shared-view first))
            (tc-global-shared-view source)
            true
            sink)])
        [(TcSelectedResult.Err message next)
          (TcSelectedArgsResult.Err message next)]
        [(TcSelectedResult.Ok got occurrence next)
          (match occurrence
            [(TcSelectedOccurrence.Selected child)
              (set! (array-ref children index) child)
              (tc-infer-selected-form-operands
                ctx
                env
                operands
                modes
                (+ index 1)
                (if (and (= index 0) (!= mode 7))
                  got
                  first)
                children
                source
                next)]
            [(TcSelectedOccurrence.Unrepresented)
              (TcSelectedArgsResult.Ok children false next)])]))))

;; A written operand: its place borrowed exclusively. Through a `&mut`
;; reference the referent is reborrowed; through a shared reference the
;; exclusive borrow is the MIR's E0596 rejection.
(define (tc-infer-selected-write-operand
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg-id : i64]
  [outer : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (tc-infer-selected-write-operand-at ctx env arg-id outer false sink))

;; `located?`: the written place's borrow is reported at the operand itself
;; (a fixed-array element store names its exact element there, as legacy).
(define (tc-infer-selected-write-operand-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg-id : i64]
  [outer : ownership.OwnershipSource]
  [located? : bool]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    [source : ownership.OwnershipSource
      (match (if located?
        (tc-expr-maybe-span
          (tc-context-expr-bases ctx)
          (tc-context-expr-get ctx arg-id))
        TcMaybeAstSourceSpan.No)
        [(TcMaybeAstSourceSpan.Some at)
          (ownership.OwnershipSource
            (string.copy (& outer.path))
            (ast.ast-source-span-start-line at)
            (ast.ast-source-span-start-col at)
            (string.copy (& outer.expansion)))]
        [(TcMaybeAstSourceSpan.No) outer])]
    ;; 0 a place, 1 a temporary, 2 a place selected through control flow.
    [mode : i64
      (cond
        [(tc-selected-place-expression? ctx (tc-context-expr-get ctx arg-id)) 0]
        [(tc-selected-write-temporary? ctx env arg-id) 1]
        [else (tc-selected-receiver-mode ctx arg-id)])]
    (cond
      [(< mode 0) (tc-selected-unrepresented (tc-expr-id ctx env arg-id) sink)]
      [(= mode 2) (tc-infer-selected-receiver ctx env arg-id source sink)]
      [else
        (match (if (= mode 0)
          (tc-selected-view-receiver
            ctx
            env
            (tc-global-shared-view source)
            (tc-infer-selected-place-id
              ctx
              env
              arg-id
              (tc-global-shared-view source)
              sink))
          (tc-selected-place-temporary
            ctx
            env
            arg-id
            (tc-global-shared-view source)
            sink))
          [(TcSelectedPlaceResult.Err message next)
            (TcSelectedResult.Err message next)]
          [(TcSelectedPlaceResult.Ok ty place next)
            (match place
              [(TcSelectedPlace.Unrepresented)
                (tc-selected-unrepresented (ResultTcType.Ok ty) next)]
              [(TcSelectedPlace.Selected id indices)
                (match (tc-resolve-type ctx (tc-global-shared-view ty))
                  [(ast.AstType.Ref _ inner)
                    (tc-selected-write-through
                      ctx
                      ty
                      inner
                      id
                      indices
                      arg-id
                      source
                      next)]
                  [(ast.AstType.MutRef _ inner)
                    (tc-selected-write-through
                      ctx
                      ty
                      inner
                      id
                      indices
                      arg-id
                      source
                      next)]
                  [_
                    (tc-selected-publish-borrow
                      (ast.AstType.MutRef
                        0
                        (ast.ast-node-pool-reader-type-push
                          (& (tc-type-strip-region (tc-global-shared-view ty)))))
                      true
                      id
                      indices
                      (typed.TypedSyntax.Source arg-id)
                      source
                      next)])])])])))

;; A written value that is not a place: a dynamic array value (a view sharing
;; its storage, written in place) or a mutable reference (written through),
;; held in a temporary.
(define (tc-selected-write-temporary?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg-id : i64]) : bool
  (match (tc-expr-id ctx env arg-id)
    [(ResultTcType.Ok ty)
      (match (tc-resolve-type ctx ty)
        [(ast.AstType.DynArray _) true]
        [(ast.AstType.MutRef _ _) true]
        [_ false])]
    [(ResultTcType.Err _) false]))

;; The binder name a place expression is rooted at, or -1.
(define (tc-selected-place-root-name [ctx : TcContext] [id : i64]) : i64
  (match (ast.ast-expr-unspan (& (tc-context-expr-get ctx id)))
    [(ast.AstExpr.Var name) name]
    [(ast.AstExpr.StructGet receiver _)
      (tc-selected-place-root-name ctx receiver)]
    [(ast.AstExpr.TupleRef receiver _)
      (tc-selected-place-root-name ctx receiver)]
    [(ast.AstExpr.ArrayRef receiver _)
      (tc-selected-place-root-name ctx receiver)]
    [(ast.AstExpr.BoxGet receiver) (tc-selected-place-root-name ctx receiver)]
    [(ast.AstExpr.BoxTake receiver) (tc-selected-place-root-name ctx receiver)]
    [(ast.AstExpr.MacroExpansion expanded _ _)
      (tc-selected-place-root-name ctx expanded)]
    [_ -1]))

;; The tails of a store receiver that selects its place through control flow
;; (`(set! (array-ref (if c a b) i) v)`; the store writes the selected place,
;; SPEC 5.10): `if` branches, `match` arms and the last form of a `let`,
;; `begin`, `with` or arena body. Each tail's expression id is appended with
;; whether it names a place bound outside the receiver; any other tail (a
;; value, or a place the receiver itself binds) is written in a temporary.
;; Diverging tails select nothing. False for a shape this does not follow.
(define (tc-selected-receiver-tails!
  [ctx : TcContext]
  [id : i64]
  [bound : TcNameIdList]
  [ids : (&mut ids (__tl_dyn-array i64))]
  [places : (&mut places (__tl_dyn-array bool))]) : bool
  (if (tc-selected-place-expression? ctx (tc-context-expr-get ctx id))
    (let
      [root : i64 (tc-selected-place-root-name ctx id)]
      [outer? : bool
        (and (>= root 0) (not (tc-name-id-list-contains bound root)))]
      (tc-selected-i64s-push! (&mut ids) id)
      (tc-selected-bools-push! (&mut places) outer?)
      true)
    (match (tc-context-expr-get ctx id)
      [(ast.AstExpr.Spanned inner _)
        (tc-selected-receiver-tails! ctx inner bound ids places)]
      [(ast.AstExpr.MacroExpansion expanded _ _)
        (tc-selected-receiver-tails! ctx expanded bound ids places)]
      [(ast.AstExpr.If _ then-id else-id)
        (and
          (tc-selected-receiver-tails! ctx then-id bound ids places)
          (tc-selected-receiver-tails! ctx else-id bound ids places))]
      [(ast.AstExpr.Let let-box)
        (match (ast.ast-let-box-shared-view let-box)
          [(ast.AstLet.Let bindings body)
            (let
              [names : TcNameIdList bound]
              [index : i64 0]
              (while (< index (ast.ast-let-binding-list-len (& bindings)))
                (begin
                  (match (ast.ast-let-binding-list-get
                    (& bindings)
                    index
                    (ast.ast-let-binding-fallback))
                    [(ast.AstLetBinding.Binding name _ _)
                      (set! names (tc-name-id-list-add names name))])
                  (set! index (+ index 1))))
              (tc-selected-receiver-tails! ctx body names ids places))])]
      [(ast.AstExpr.Match match-box)
        (match (ast.ast-match-box-shared-view match-box)
          [(ast.AstMatch.Match _ arms)
            (let
              [ok : bool true]
              [index : i64 0]
              (while (and ok (< index arms.len))
                (begin
                  (match (ast.ast-match-arm-list-get
                    (& arms)
                    index
                    (ast.ast-match-arm-fallback))
                    [(ast.AstMatchArm.Arm pattern body)
                      (set!
                        ok
                        (tc-selected-receiver-tails!
                          ctx
                          body
                          (tc-pattern-add-bound-name-ids pattern bound)
                          ids
                          places))])
                  (set! index (+ index 1))))
              ok)])]
      [(ast.AstExpr.WithResource resource-box)
        (match (ast.ast-with-resource-box-shared-view resource-box)
          [(ast.AstWithResource.WithResource bindings body)
            (let
              [names : TcNameIdList bound]
              [index : i64 0]
              (while (< index (ast.ast-resource-binding-list-len (& bindings)))
                (begin
                  (match (ast.ast-resource-binding-list-get
                    (& bindings)
                    index
                    (ast.ast-resource-binding-fallback))
                    [(ast.AstResourceBinding.Binding name _ _ _)
                      (set! names (tc-name-id-list-add names name))])
                  (set! index (+ index 1))))
              (tc-selected-receiver-list-tails! ctx (& body) names ids places))])]
      [(ast.AstExpr.Begin items)
        (tc-selected-receiver-list-tails! ctx (& items) bound ids places)]
      [(ast.AstExpr.WithRegion _ items)
        (tc-selected-receiver-list-tails! ctx (& items) bound ids places)]
      [(ast.AstExpr.WithEscape _ items)
        (tc-selected-receiver-list-tails! ctx (& items) bound ids places)]
      [(ast.AstExpr.WithScratch items)
        (tc-selected-receiver-list-tails! ctx (& items) bound ids places)]
      [(ast.AstExpr.InArena _ items)
        (tc-selected-receiver-list-tails! ctx (& items) bound ids places)]
      [(ast.AstExpr.Return _) true]
      [(ast.AstExpr.Break) true]
      [(ast.AstExpr.Continue) true]
      [_
        (tc-selected-i64s-push! (&mut ids) id)
        (tc-selected-bools-push! (&mut places) false)
        true])))

;; The tail of a body list: its last form.
(define (tc-selected-receiver-list-tails!
  [ctx : TcContext]
  [items : (& items ast.AstExprList)]
  [bound : TcNameIdList]
  [ids : (&mut ids (__tl_dyn-array i64))]
  [places : (&mut places (__tl_dyn-array bool))]) : bool
  (if (< items.len 1)
    false
    (tc-selected-receiver-tails!
      ctx
      (ast.ast-expr-list-get items (- items.len 1) 0)
      bound
      ids
      places)))

;; How a written operand that is neither a place nor a reference or dynamic
;; array value is stored: 1 into a temporary (its receiver selects no place
;; bound outside it), 2 into the place its control flow selects, -1 not
;; represented.
(define (tc-selected-receiver-mode [ctx : TcContext] [id : i64]) : i64
  (let
    [ids : (__tl_dyn-array i64) (tc-selected-no-i64s)]
    [places : (__tl_dyn-array bool) (tc-selected-no-bools)]
    [index : i64 0]
    [selects? : bool false]
    (if (not
      (tc-selected-receiver-tails!
        ctx
        id
        TcNameIdList.Nil
        (&mut ids)
        (&mut places)))
      -1
      (begin
        (while (< index (array-length places))
          (when (array-ref places index) (set! selects? true))
          (set! index (+ index 1)))
        (if selects?
          2
          1)))))

;; A control-flow store receiver (mode 2): its tails register for
;; `tc-infer-selected-receiver-tail` while the receiver is inferred, and the
;; inferred control flow is published as the receiver (form 151) of the
;; store, which forms each selected place and borrows the taken one at the
;; store (SPEC 5.10). A tail inferred any other way leaves it unrepresented.
(define (tc-infer-selected-receiver
  [ctx : TcContext]
  [env : TcTypeEnv]
  [id : i64]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match sink
    [(TcSelectedSink.Query)
      (tc-selected-unrepresented (tc-expr-id ctx env id) TcSelectedSink.Query)]
    [(TcSelectedSink.Capture store lease bindings)
      (let
        [mark : i64 (array-length bindings.receiver-tails)]
        [_tails : bool
          (tc-selected-receiver-tails!
            ctx
            id
            TcNameIdList.Nil
            (&mut bindings.receiver-tails)
            (&mut bindings.receiver-places))]
        (match (tc-infer-selected-id
          ctx
          env
          id
          ast.AstMaybeType.No
          (tc-global-shared-view source)
          (TcSelectedSink.Capture store lease bindings))
          [(TcSelectedResult.Err message next)
            (TcSelectedResult.Err message (tc-selected-receiver-pop next mark))]
          [(TcSelectedResult.Ok ty occurrence next)
            (let
              [counted : (TcSelectedCounted store lease intern bind)
                (tc-selected-receiver-inferred next mark)]
              [inferred? : bool (= (tc-selected-counted-value (& counted)) 1)]
              [next : (TcSelectedSink store lease intern bind)
                (tc-selected-counted-sink counted)]
              [popped : (TcSelectedSink store lease intern bind)
                (tc-selected-receiver-pop next mark)]
              (match occurrence
                [(TcSelectedOccurrence.Selected value)
                  (if inferred?
                    (tc-selected-publish
                      (ResultTcType.Ok
                        (ast.AstType.MutRef
                          0
                          (ast.ast-node-pool-reader-type-push
                            (&
                              (tc-type-strip-region (tc-global-shared-view ty))))))
                      typed.TypedSyntax.Generated
                      source
                      (typed.TypedOperation.Primitive
                        (typed.TypedPrimitive.Builtin
                          (tc-selected-form-code-receiver)
                          1))
                      (let
                        [children : (__tl_dyn-array typed.TypedOccurrenceId)
                          (tc-selected-no-occurrences)]
                        (tc-selected-occurrences-push! (&mut children) value)
                        children)
                      popped)
                    (tc-selected-unrepresented (ResultTcType.Ok ty) popped))]
                [(TcSelectedOccurrence.Unrepresented)
                  (tc-selected-unrepresented (ResultTcType.Ok ty) popped)]))]))]))

(define (tc-selected-form-code-literal-select) : i64
  154)

;; The items of an array literal, or an empty list.
(define (tc-selected-literal-items [ctx : TcContext] [receiver : i64]) : ast.AstExprList
  (match (ast.ast-expr-unspan (& (tc-context-expr-get ctx receiver)))
    [(ast.AstExpr.Array items) items]
    [(ast.AstExpr.DynArray items) items]
    [_ (ast.ast-expr-list-new)]))

;; `(array-ref (array e0 ... en) k)` with a literal `k` in range, over elements
;; that hold references and no cleanup owner (dropping the others moves
;; nothing that needs one).
(define (tc-selected-literal-select?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [receiver : i64]
  [index : i64]) : bool
  (let
    [items : ast.AstExprList (tc-selected-literal-items ctx receiver)]
    [count : i64 (ast.ast-expr-list-len (& items))]
    (and
      (> count 0)
      (match (ast.ast-expr-unspan (& (tc-context-expr-get ctx index)))
        [(ast.AstExpr.Literal (ast.AstLiteral.Int value _))
          (and (>= value 0) (< value count))]
        [_ false])
      (match (tc-expr-id ctx env receiver)
        [(ResultTcType.Ok ty)
          (match (tc-type-strip-region (tc-resolve-type ctx ty))
            [(ast.AstType.Array elem _)
              (tc-selected-selectable-element? ctx (ast.ty-node-get elem))]
            [(ast.AstType.DynArray elem)
              (tc-selected-selectable-element? ctx (ast.ty-node-get elem))]
            [_ false])]
        [(ResultTcType.Err _) false]))))

;; The items of a tuple literal, or an empty list.
(define (tc-selected-tuple-items [ctx : TcContext] [receiver : i64]) : ast.AstExprList
  (match (ast.ast-expr-unspan (& (tc-context-expr-get ctx receiver)))
    [(ast.AstExpr.Tuple items) items]
    [_ (ast.ast-expr-list-new)]))

;; `(tuple-ref (tuple e0 ... en) k)` over elements that hold references and
;; no cleanup owner (dropping the others moves nothing that needs one).
(define (tc-selected-tuple-select?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [receiver : i64]
  [index : i64]) : bool
  (let
    [items : ast.AstExprList (tc-selected-tuple-items ctx receiver)]
    (and
      (> items.len 0)
      (>= index 0)
      (< index items.len)
      (match (tc-expr-id ctx env receiver)
        [(ResultTcType.Ok ty)
          (let
            [resolved : ast.AstType
              (tc-type-strip-region (tc-resolve-type ctx ty))]
            (and
              (tc-type-contains-reference? (tc-global-shared-view resolved))
              (not (tc-type-reaches-cleanup? ctx resolved))))]
        [(ResultTcType.Err _) false]))))

;; Form 154 over a tuple literal's elements, then the index as a generated
;; literal (a tuple index is not an expression).
(define (tc-infer-selected-tuple-select
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [items : ast.AstExprList]
  [index : i64]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-legacy
    ctx
    env
    (tc-global-shared-view expr)
    syntax
    expected)
    [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcType.Ok ty)
      (match (tc-infer-selected-form-operands
        ctx
        env
        (tc-selected-list-ids (& items))
        (tc-selected-modes items.len 2)
        0
        (tc-global-shared-view ty)
        (__tl_make-array typed.TypedOccurrenceId items.len)
        (tc-global-shared-view source)
        sink)
        [(TcSelectedArgsResult.Err message next)
          (TcSelectedResult.Err message next)]
        [(TcSelectedArgsResult.Ok children represented? next)
          (if (not represented?)
            (tc-selected-unrepresented (ResultTcType.Ok ty) next)
            (match (tc-selected-publish-literal
              ast.AstType.I64
              (ast.ast-lit-int index)
              (tc-global-shared-view source)
              next)
              [(TcSelectedResult.Err message limited)
                (TcSelectedResult.Err message limited)]
              [(TcSelectedResult.Ok _ literal limited)
                (match literal
                  [(TcSelectedOccurrence.Selected literal-id)
                    (tc-selected-occurrences-push! (&mut children) literal-id)
                    (tc-selected-publish
                      (ResultTcType.Ok ty)
                      syntax
                      source
                      (typed.TypedOperation.Primitive
                        (typed.TypedPrimitive.Builtin
                          (tc-selected-form-code-literal-select)
                          (+ items.len 1)))
                      children
                      limited)]
                  [(TcSelectedOccurrence.Unrepresented)
                    (tc-selected-unrepresented (ResultTcType.Ok ty) limited)])]))])]))

(define (tc-selected-selectable-element? [ctx : TcContext] [ty : ast.AstType]) : bool
  (and
    (tc-type-contains-reference? (tc-global-shared-view ty))
    (not (tc-type-reaches-cleanup? ctx ty))))

;; The literal's items, then the index.
(define (tc-selected-literal-select-ids
  [ctx : TcContext]
  [receiver : i64]
  [index : i64]) : (__tl_dyn-array i64)
  (let
    [items : ast.AstExprList (tc-selected-literal-items ctx receiver)]
    [ids : (__tl_dyn-array i64) (tc-selected-list-ids (& items))]
    (tc-selected-i64s-push! (&mut ids) index)
    ids))

(define (tc-selected-literal-select-modes [ctx : TcContext] [receiver : i64]) : (__tl_dyn-array
    i64)
  (let
    [items : ast.AstExprList (tc-selected-literal-items ctx receiver)]
    [modes : (__tl_dyn-array i64)
      (tc-selected-modes (ast.ast-expr-list-len (& items)) 2)]
    (tc-selected-i64s-push! (&mut modes) 3)
    modes))

;; A runtime quasiquote over its unquoted operands (fresh `Expr` result).
(define (tc-selected-form-code-quasiquote) : i64
  155)

;; The expression ids a quasiquote template unquotes or splices, in template
;; order: the positions `tc-quasiquote-template-ok` types.
(define (tc-selected-quasiquote-operands!
  [ctx : TcContext]
  [expr : ast.AstExpr]
  [out : (&mut out (__tl_dyn-array i64))]) : unit
  (match expr
    [(ast.AstExpr.Spanned inner _)
      (tc-selected-quasiquote-operands! ctx (tc-context-expr-get ctx inner) out)]
    [(ast.AstExpr.MacroExpansion inner _ _)
      (tc-selected-quasiquote-operands! ctx (tc-context-expr-get ctx inner) out)]
    [(ast.AstExpr.Unquote inner) (tc-selected-i64s-push! (&mut out) inner)]
    [(ast.AstExpr.UnquoteSplicing inner)
      (tc-selected-i64s-push! (&mut out) inner)]
    [(ast.AstExpr.Binary _ left right)
      (tc-selected-quasiquote-operands! ctx (tc-context-expr-get ctx left) out)
      (tc-selected-quasiquote-operands! ctx (tc-context-expr-get ctx right) out)]
    [(ast.AstExpr.Unary _ inner)
      (tc-selected-quasiquote-operands! ctx (tc-context-expr-get ctx inner) out)]
    [(ast.AstExpr.Call func args)
      (tc-selected-quasiquote-operands! ctx (tc-context-expr-get ctx func) out)
      (tc-selected-quasiquote-list-operands! ctx (& args) out)]
    [(ast.AstExpr.BracketClause items)
      (tc-selected-quasiquote-list-operands! ctx (& items) out)]
    [(ast.AstExpr.If condition then-branch else-branch)
      (tc-selected-quasiquote-operands!
        ctx
        (tc-context-expr-get ctx condition)
        out)
      (tc-selected-quasiquote-operands!
        ctx
        (tc-context-expr-get ctx then-branch)
        out)
      (tc-selected-quasiquote-operands!
        ctx
        (tc-context-expr-get ctx else-branch)
        out)]
    [(ast.AstExpr.Tuple exprs)
      (tc-selected-quasiquote-list-operands! ctx (& exprs) out)]
    [(ast.AstExpr.Array exprs)
      (tc-selected-quasiquote-list-operands! ctx (& exprs) out)]
    [(ast.AstExpr.DynArray exprs)
      (tc-selected-quasiquote-list-operands! ctx (& exprs) out)]
    [(ast.AstExpr.Begin exprs)
      (tc-selected-quasiquote-list-operands! ctx (& exprs) out)]
    [(ast.AstExpr.Unsafe exprs)
      (tc-selected-quasiquote-list-operands! ctx (& exprs) out)]
    [(ast.AstExpr.Ann inner _)
      (tc-selected-quasiquote-operands! ctx (tc-context-expr-get ctx inner) out)]
    [(ast.AstExpr.Cast inner _)
      (tc-selected-quasiquote-operands! ctx (tc-context-expr-get ctx inner) out)]
    [(ast.AstExpr.Box inner)
      (tc-selected-quasiquote-operands! ctx (tc-context-expr-get ctx inner) out)]
    [(ast.AstExpr.BoxGet inner)
      (tc-selected-quasiquote-operands! ctx (tc-context-expr-get ctx inner) out)]
    [(ast.AstExpr.BoxTake inner)
      (tc-selected-quasiquote-operands! ctx (tc-context-expr-get ctx inner) out)]
    [(ast.AstExpr.BoxSet inner value)
      (tc-selected-quasiquote-operands! ctx (tc-context-expr-get ctx inner) out)
      (tc-selected-quasiquote-operands! ctx (tc-context-expr-get ctx value) out)]
    [(ast.AstExpr.Comptime inner)
      (tc-selected-quasiquote-operands! ctx (tc-context-expr-get ctx inner) out)]
    [(ast.AstExpr.Return inner)
      (tc-selected-quasiquote-operands! ctx (tc-context-expr-get ctx inner) out)]
    [(ast.AstExpr.Quasiquote inner)
      (tc-selected-quasiquote-operands! ctx (tc-context-expr-get ctx inner) out)]
    [_ unit]))

(define (tc-selected-quasiquote-list-operands!
  [ctx : TcContext]
  [exprs : (& exprs ast.AstExprList)]
  [out : (&mut out (__tl_dyn-array i64))]) : unit
  (let
    [index : i64 0]
    (while (< index exprs.len)
      (begin
        (tc-selected-quasiquote-operands!
          ctx
          (tc-context-expr-get ctx (ast.ast-expr-list-get exprs index 0))
          out)
        (set! index (+ index 1))))))

(define (tc-selected-form-code-fresh-data) : i64
  153)

(define (tc-selected-form-code-receiver) : i64
  151)

(define (tc-selected-form-code-receiver-tail) : i64
  150)

;; Whether every receiver tail registered from `mark` was inferred.
;; Whether every receiver tail registered from `mark` was inferred (1) or
;; not (0), and the sink.
(define (tc-selected-receiver-inferred
  [sink : (TcSelectedSink store lease intern bind)]
  [mark : i64]) : (TcSelectedCounted store lease intern bind)
  (match sink
    [(TcSelectedSink.Capture store lease bindings)
      (let
        [index : i64 mark]
        [all? : bool true]
        (while (< index (array-length bindings.receiver-tails))
          (when
            (>= (array-ref bindings.receiver-tails index) 0)
            (set! all? false))
          (set! index (+ index 1)))
        (TcSelectedCounted.Counted
          (if all?
            1
            0)
          (TcSelectedSink.Capture store lease bindings)))]
    [(TcSelectedSink.Query) (TcSelectedCounted.Counted 0 TcSelectedSink.Query)]))

;; Retire the receiver tails registered from `mark`.
(define (tc-selected-receiver-pop
  [sink : (TcSelectedSink store lease intern bind)]
  [mark : i64]) : (TcSelectedSink store lease intern bind)
  (match sink
    [(TcSelectedSink.Capture store lease bindings)
      (let
        [index : i64 mark]
        (while (< index (array-length bindings.receiver-tails))
          (set! (array-ref bindings.receiver-tails index) -1)
          (set! index (+ index 1)))
        (TcSelectedSink.Capture store lease bindings))]
    [(TcSelectedSink.Query) TcSelectedSink.Query]))

;; The registered receiver tail `id` (see `tc-selected-receiver-tails!`):
;; 1 a place outside its receiver, 0 a value, -1 not a tail. Taking it
;; retires it, so its own inference runs once.
(define (tc-selected-receiver-tail-take!
  [bindings : (&mut bindings TcSelectedBindings)]
  [id : i64]) : i64
  (let
    [index : i64 (- (array-length bindings.receiver-tails) 1)]
    [found : i64 -1]
    (while (and (< found 0) (>= index 0))
      (when
        (= (array-ref bindings.receiver-tails index) id)
        (set! (array-ref bindings.receiver-tails index) -1)
        (set!
          found
          (if (array-ref bindings.receiver-places index)
            1
            0)))
      (set! index (- index 1)))
    found))

;; A receiver tail (form 150 over the mutable borrow of the place it
;; selects): a place outside the receiver, or a temporary holding its value.
;; Its value is the place's, which the normalizer only forms here.
(define (tc-infer-selected-receiver-tail
  [ctx : TcContext]
  [env : TcTypeEnv]
  [id : i64]
  [place? : bool]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (if place?
    (tc-selected-view-receiver
      ctx
      env
      (tc-global-shared-view source)
      (tc-infer-selected-place-id
        ctx
        env
        id
        (tc-global-shared-view source)
        sink))
    (tc-selected-place-temporary ctx env id (tc-global-shared-view source) sink))
    [(TcSelectedPlaceResult.Err message next)
      (TcSelectedResult.Err message next)]
    [(TcSelectedPlaceResult.Ok ty place next)
      (match place
        [(TcSelectedPlace.Unrepresented)
          (tc-selected-unrepresented (ResultTcType.Ok ty) next)]
        [(TcSelectedPlace.Selected place-id indices)
          (match (tc-resolve-type ctx (tc-global-shared-view ty))
            [(ast.AstType.Ref _ _)
              (tc-selected-unrepresented (ResultTcType.Ok ty) next)]
            [(ast.AstType.MutRef _ _)
              (tc-selected-unrepresented (ResultTcType.Ok ty) next)]
            [_
              (match (tc-selected-publish-borrow
                (ast.AstType.MutRef
                  0
                  (ast.ast-node-pool-reader-type-push
                    (& (tc-type-strip-region (tc-global-shared-view ty)))))
                true
                place-id
                indices
                (typed.TypedSyntax.Source id)
                (tc-global-shared-view source)
                next)
                [(TcSelectedResult.Err message after)
                  (TcSelectedResult.Err message after)]
                [(TcSelectedResult.Ok _ occurrence after)
                  (match occurrence
                    [(TcSelectedOccurrence.Selected borrow)
                      (tc-selected-publish
                        (ResultTcType.Ok ty)
                        typed.TypedSyntax.Generated
                        source
                        (typed.TypedOperation.Primitive
                          (typed.TypedPrimitive.Builtin
                            (tc-selected-form-code-receiver-tail)
                            1))
                        (let
                          [children : (__tl_dyn-array typed.TypedOccurrenceId)
                            (tc-selected-no-occurrences)]
                          (tc-selected-occurrences-push! (&mut children) borrow)
                          children)
                        after)]
                    [(TcSelectedOccurrence.Unrepresented)
                      (tc-selected-unrepresented (ResultTcType.Ok ty) after)])])])])]))

(define (tc-selected-write-through
  [ctx : TcContext]
  [ty : ast.AstType]
  [inner : i64]
  [id : typed.TypedPlaceId]
  [indices : (__tl_dyn-array typed.TypedOccurrenceId)]
  [arg-id : i64]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    [referent : ast.AstType
      (tc-resolve-type ctx (tc-context-type-get ctx inner))]
    (match (tc-selected-place-project
      (tc-global-shared-view referent)
      (tc-global-shared-view referent)
      (TcSelectedPlace.Selected id indices)
      typed.TypedProjectionKind.Deref
      (tc-global-shared-view source)
      sink)
      [(TcSelectedPlaceResult.Err message next)
        (TcSelectedResult.Err message next)]
      [(TcSelectedPlaceResult.Ok _ derefed next)
        (match derefed
          [(TcSelectedPlace.Selected referent-id referent-indices)
            (tc-selected-publish-borrow
              (ast.AstType.MutRef
                0
                (ast.ast-node-pool-reader-type-push referent))
              true
              referent-id
              referent-indices
              (typed.TypedSyntax.Source arg-id)
              source
              next)]
          [(TcSelectedPlace.Unrepresented)
            (tc-selected-unrepresented (ResultTcType.Ok ty) next)])])))

(define (tc-selected-ids1 [a : i64]) : (__tl_dyn-array i64)
  (let
    [ids : (__tl_dyn-array i64) (tc-selected-no-i64s)]
    (tc-selected-i64s-push! (&mut ids) a)
    ids))

(define (tc-selected-ids2 [a : i64] [b : i64]) : (__tl_dyn-array i64)
  (let
    [ids : (__tl_dyn-array i64) (__tl_make-array i64 2)]
    (set! (array-ref ids 0) a)
    (set! (array-ref ids 1) b)
    ids))

(define (tc-selected-ids3 [a : i64] [b : i64] [c : i64]) : (__tl_dyn-array i64)
  (let
    [ids : (__tl_dyn-array i64) (tc-selected-ids2 a b)]
    (tc-selected-i64s-push! (&mut ids) c)
    ids))

;; --- Ordinary direct calls (#8449) -----------------------------------------
;;
;; A call to a declared function whose signature has no lifetimes, references,
;; regions, cleanup owners, arena authorities or C ABI. Its arguments are
;; selected once, left to right, against the declared parameter types with
;; the compatibility and region-argument checks of
;; `tc-check-call-args-with-message-at`. Builtin dispatch, enum variants,
;; constructors, externs, thread spawns/sends and calls through values keep
;; the legacy route until their contracts are represented.
(defenum TcSelectedCallTarget
  (Ordinary i64 ast.AstType bool)
  ;; An extern function: its key and checked signature.
  (Foreign i64 ast.AstType)
  ;; A call through a C function pointer value: the `CFunc`'s signature. The C
  ;; ABI is a property of the callee's type, so the call is foreign as an
  ;; extern function's is (SPEC 4.3), wherever the pointer value comes from.
  (ForeignValue ast.AstType)
  ;; A read-only builtin: its dispatch arm.
  (Builtin i64)
  ;; A slice view (`slice-view`, `slice-mut-view` and their bytes forms):
  ;; whether the view is mutable.
  (SliceView bool)
  ;; `arena.make`/`make-atomic`, `phase`, `rewind-safe!` or `destroy-safe!`:
  ;; the dispatch arm (9-12).
  (ArenaForm i64)
  ;; A safe thread spawn of a direct lambda (`tc-thread-safe-spawn-call-name`).
  (Spawn)
  ;; `slice-split-at` / `slice-split-at-mut`: whether the halves are mutable.
  (SliceSplit bool)
  (Legacy)
  (Err String))

(defenum TcSelectedArgsResult
  (:lifetimes store lease intern bind)
  (Ok
    (__tl_dyn-array typed.TypedOccurrenceId)
    bool
    (TcSelectedSink store lease intern bind))
  (Err String (TcSelectedSink store lease intern bind)))

;; Whether callee `func-id` is the safe thread spawn, as legacy typing decides
;; (`tc-check-thread-safe-spawn-call`): a spawn name whose resolved signature
;; is the thread module's, not a user function that happens to be named so.
(define (tc-selected-safe-spawn-call?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]) : bool
  (match (tc-call-target-expr-id ctx env func-id)
    [(ResultTcType.Ok fn-ty)
      (match (tc-global-shared-view fn-ty)
        [(ast.AstType.Func params-box ret)
          (tc-selected-safe-spawn-signature?
            ctx
            env
            (tc-context-expr-get ctx func-id)
            (ast.ast-type-list-box-shared-view params-box)
            (ast.ty-node-get ret))]
        [_ false])]
    [(ResultTcType.Err _) false]))

;; Callee `func` with signature `params` -> `ret` is the safe thread spawn.
(define (tc-selected-safe-spawn-signature?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [params : ast.AstTypeList]
  [ret : ast.AstType]) : bool
  (match (tc-thread-safe-spawn-call-name ctx env (tc-global-shared-view func))
    [(TcMaybeString.Some source-name)
      (let
        [source-id : i64
          (macro-hygiene-global-source-name-id-or
            (tc-context-structural-session ctx)
            (tc-expr-var-name-id
              (tc-context-expr-segment-bases ctx)
              (tc-global-shared-view func))
            (tc-expr-var-name-id
              (tc-context-expr-segment-bases ctx)
              (tc-global-shared-view func)))]
        [lookup-name : String
          (tc-thread-spawn-lookup-name
            ctx
            env
            (tc-global-shared-view source-name)
            source-id)]
        (tc-thread-safe-spawn-signature?
          ctx
          (tc-global-shared-view source-name)
          lookup-name
          params
          ret))]
    [(TcMaybeString.No) false]))

;; The shared builtin dispatch (`tc-call-builtin-name`, whose answer is `info`)
;; takes the ordinary path for this name, and the name is not an enum variant.
(define (tc-selected-call-name-ordinary?
  [ctx : TcContext]
  [info : (& info TcCallBuiltinName)]) : bool
  (and (= info.arm 0) (not (tc-call-variant-name-id? ctx info.name-id))))

;; The symbol index of the function definition or extern this callee name
;; denotes, or -1. Lexical storage shadows declarations exactly as for `set!`
;; (`tc-set-function-declaration?`). The index names the callee in dumps only:
;; a call's ownership contract is its checked signature, so an extern is
;; checked like a definition. A self-qualified name (`module.name` inside
;; `module`) resolves through the source lookup's key.
(define (tc-selected-call-declared-function
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]) : i64
  (if (and
    (not (macro-hygiene-global-id? (tc-context-structural-session ctx) name))
    (or
      (and
        (tc-type-env-scoped-runtime-active? env)
        (>= (tc-type-env-scoped-runtime-lookup-index env name) 0))
      (tc-name-local-bound-before-module-scan-id? env name)))
    -1
    (match (tc-unqualified-import-ambiguity-message ctx env name)
      [(TcMaybeString.Some _) -1]
      [(TcMaybeString.No)
        (match (tc-source-name-lookup-key-with-field-check-lookup
          ctx
          env
          (tc-hygiene-name-text-id-for-session
            (tc-context-structural-session ctx)
            name)
          name
          false)
          [(TcNameLookup.Err _) -1]
          [(TcNameLookup.Ok _ key)
            (let
              [moved : i64 (tc-move-value-symbol-handle-id ctx name)]
              [handle : i64
                (if (csym.compiler-symbols-handle-found? moved)
                  moved
                  (csym.compiler-symbols-lookup-value-id-or
                    (tc-context-symbols ctx)
                    key
                    (csym.compiler-symbols-missing-handle)))]
              (if (and
                (csym.compiler-symbols-handle-found? handle)
                (or
                  (=
                    (csym.compiler-symbol-handle-kind handle)
                    (csym.compiler-symbol-kind-function-define))
                  (=
                    (csym.compiler-symbol-handle-kind handle)
                    (csym.compiler-symbol-kind-extern))))
                (csym.compiler-symbol-handle-index handle)
                -1))])])))

(define (tc-selected-call-type-ok? [ctx : TcContext] [ty : ast.AstType]) : bool
  (let
    [resolved : ast.AstType (tc-resolve-type ctx ty)]
    (or
      (tc-selected-primitive-type? (& resolved))
      (tc-selected-value-type-supported? ctx (tc-global-shared-view resolved))
      (tc-selected-holding-type? ctx (tc-global-shared-view resolved))
      (tc-selected-loan-array? ctx (tc-global-shared-view resolved))
      (tc-selected-program-reference? ctx (tc-global-shared-view resolved)))))

;; A reference of the reserved `program` lifetime to a supported referent, as
;; Rust's `'static`: it outlives every other lifetime, so a value holding it
;; holds no loan the graph must track, though it is still read (and, when
;; mutable, written) through as a reference, and a `&mut` stays move-only.
(define (tc-selected-program-reference?
  [ctx : TcContext]
  [resolved : ast.AstType]) : bool
  (match (tc-global-shared-view resolved)
    [(or (ast.AstType.Ref lifetime _) (ast.AstType.MutRef lifetime _))
      (and
        (tc-program-lifetime-id? lifetime)
        (> (tc-selected-reference-kind ctx (tc-global-shared-view resolved)) 0))]
    [_ false]))

;; A parameter type the call slice represents: a value, or a reference whose
;; referent is one (`tc-selected-reference-kind`).
(define (tc-selected-call-param-type-ok? [ctx : TcContext] [ty : ast.AstType]) : bool
  (let
    ;; An `(:invalidate r T)` parameter takes a `T`.
    [param : ast.AstType (tc-type-strip-invalidate ty)]
    (or
      (tc-selected-call-type-ok? ctx (tc-global-shared-view param))
      (> (tc-selected-reference-kind ctx (tc-resolve-type ctx param)) 0))))

;; No argument's loan can flow into another argument unseen: two parameters
;; may share a lifetime only when no parameter can store a reference of that
;; lifetime, except a direct `(&mut T)` parameter, whose stores are the call's
;; store contracts (the source's loans flow into the place it borrows). A
;; lifetime written through an aggregate holding a mutable reference has no
;; place the graph names. The result may carry shared lifetimes; a result
;; holding references holds every reference operand's loans whose type names
;; one of its lifetimes.
(define (tc-selected-call-lifetimes-separate?
  [ctx : TcContext]
  [params : (& params ast.AstTypeList)]) : bool
  (let
    [count : i64 (ast.ast-type-list-len params)]
    [first : i64 0]
    [separate? : bool true]
    [written : TcNameIdList
      (let
        [out : TcNameIdList TcNameIdList.Nil]
        [index : i64 0]
        (while (< index count)
          (let
            [param : ast.AstType
              (ast.ty-node-get
                (ast.ast-type-list-get params index (ast.ast-type-id-fallback)))]
            ;; A direct `(&mut T)` parameter's stores are the call's store
            ;; contracts (`normalize-call-contracts`): the source argument's
            ;; loans flow into the place it borrows.
            (match (tc-resolve-type ctx (tc-global-shared-view param))
              [(ast.AstType.MutRef _ _) unit]
              [_ (set! out (tc-selected-written-lifetimes-into ctx param out))]))
          (set! index (+ index 1)))
        out)]
    (while (and separate? (< first count))
      (let
        [left : TcNameIdList
          (tc-type-collect-reference-lifetimes-into
            (ast.ty-node-get
              (ast.ast-type-list-get params first (ast.ast-type-id-fallback)))
            TcNameIdList.Nil)]
        [second : i64 (+ first 1)]
        (while (and separate? (< second count))
          (let
            [right : TcNameIdList
              (tc-type-collect-reference-lifetimes-into
                (ast.ty-node-get
                  (ast.ast-type-list-get
                    params
                    second
                    (ast.ast-type-id-fallback)))
                TcNameIdList.Nil)]
            [items : TcNameIdList left]
            (while (and separate? (not (tc-name-id-list-empty? items)))
              (when
                (and
                  (tc-name-id-list-contains right (tc-name-id-list-head items))
                  (tc-name-id-list-contains
                    written
                    (tc-name-id-list-head items)))
                (set! separate? false))
              (set! items (tc-name-id-list-rest items)))
            (set! second (+ second 1))))
        (set! first (+ first 1))))
    separate?))

;; The lifetimes a value of this type could store references of: those inside
;; the referent of a mutable reference, and every lifetime argument of an
;; aggregate holding a mutable reference.
(define (tc-selected-written-lifetimes-into
  [ctx : TcContext]
  [ty : ast.AstType]
  [out : TcNameIdList]) : TcNameIdList
  (let
    [resolved : ast.AstType (tc-resolve-type ctx ty)]
    (match (tc-global-shared-view resolved)
      [(ast.AstType.MutRef _ inner)
        (tc-type-collect-reference-lifetimes-into (ast.ty-node-get inner) out)]
      [(ast.AstType.Ref _ inner)
        (tc-selected-written-lifetimes-into ctx (ast.ty-node-get inner) out)]
      [(ast.AstType.Region _ inner)
        (tc-selected-written-lifetimes-into ctx (ast.ty-node-get inner) out)]
      [(ast.AstType.Tuple elems)
        (let
          [items : ast.AstTypeList (ast.ast-type-list-box-shared-view elems)]
          [index : i64 0]
          [acc : TcNameIdList out]
          (while (< index (ast.ast-type-list-len (& items)))
            (set!
              acc
              (tc-selected-written-lifetimes-into
                ctx
                (ast.ty-node-get
                  (ast.ast-type-list-get
                    (& items)
                    index
                    (ast.ast-type-id-fallback)))
                acc))
            (set! index (+ index 1)))
          acc)]
      [_
        (if (tc-selected-holds-reference?
          ctx
          (tc-global-shared-view resolved)
          true)
          (tc-type-collect-reference-lifetimes-into resolved out)
          out)])))

(define (tc-selected-call-signature-ok?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [params : ast.AstTypeList]
  [ret : ast.AstType]) : bool
  (let
    [lifetimes : ast.AstLifetimeList
      (tc-call-function-lifetimes
        (tc-global-shared-view params)
        (tc-global-shared-view ret))]
    [arena-regions : (__tl_dyn-array i64)
      (tc-selected-signature-arena-regions ctx (& params))]
    [index : i64 0]
    [ok? : bool
      (and
        (match (tc-call-extern-abi ctx (tc-global-shared-view func))
          [(TcMaybeExternAbi.No) true]
          [(TcMaybeExternAbi.Some _) false])
        (not
          (tc-call-lifetime-constructor-for-func?
            ctx
            (tc-global-shared-view func)
            (tc-global-shared-view ret)))
        ;; A name that resolves to a declared function is that function even
        ;; when an imported variant shares it (#8582: unqualified entry-module
        ;; lookup never searches imports).
        (match (tc-call-constructor-target-for-func
          ctx
          env
          (tc-global-shared-view func)
          (tc-global-shared-view params)
          (tc-global-shared-view ret))
          [(ast.AstMaybeType.No) true]
          [(ast.AstMaybeType.Some _)
            (>=
              (tc-selected-call-declared-function
                ctx
                env
                (tc-expr-var-name-id
                  (tc-context-expr-segment-bases ctx)
                  (tc-global-shared-view func)))
              0)])
        (or
          (ast.ast-lifetime-list-empty? (& lifetimes))
          (tc-selected-call-lifetimes-separate? ctx (& params)))
        ;; The safe spawn takes one nullary task (`tc-infer-selected-spawn`);
        ;; the raw two-argument `thread.spawn` adapter is an ordinary call.
        (or
          (!= (ast.ast-type-list-len (& params)) 1)
          (not
            (tc-selected-safe-spawn-signature?
              ctx
              env
              (tc-global-shared-view func)
              (tc-global-shared-view params)
              (tc-global-shared-view ret))))
        (or
          (tc-selected-call-param-type-ok?
            ctx
            (tc-selected-canonical-type
              ctx
              (tc-selected-signature-arena-erase
                ctx
                (& arena-regions)
                (tc-global-shared-view ret))))
          (tc-selected-view-type?
            ctx
            (tc-resolve-type ctx (tc-global-shared-view ret)))))]
    ;; A parameter's region tag is the graph's as for any value: dropped on a
    ;; Copy one, a view of a move-only one.
    (while (and ok? (< index (ast.ast-type-list-len (& params))))
      (set!
        ok?
        (or
          (tc-selected-call-param-type-ok?
            ctx
            (tc-selected-canonical-type
              ctx
              (tc-selected-signature-arena-erase
                ctx
                (& arena-regions)
                (ast.ty-node-get
                  (ast.ast-type-list-get
                    (& params)
                    index
                    (ast.ast-type-id-fallback))))))
          (tc-selected-view-type?
            ctx
            (tc-resolve-type
              ctx
              (ast.ty-node-get
                (ast.ast-type-list-get
                  (& params)
                  index
                  (ast.ast-type-id-fallback)))))))
      (set! index (+ index 1)))
    ok?))

;; The lifetimes a signature brands an arena owner parameter with, by value or
;; behind a reference: the arena regions of the call, as an arena parameter's
;; brand is one of its own body's (`typed.typed-arena-region-note!`). A value
;; `(in r T)` of such a brand is an allocation of the argument's arena: an
;; owned value of the graph, while typing keeps the brand's region rules.
(define (tc-selected-signature-arena-regions
  [ctx : TcContext]
  [params : (& params ast.AstTypeList)]) : (__tl_dyn-array i64)
  (let
    [regions : (__tl_dyn-array i64) (tc-selected-no-i64s)]
    [index : i64 0]
    (while (< index (ast.ast-type-list-len params))
      (match (tc-arena-target
        ctx
        (tc-type-strip-invalidate
          (tc-resolve-type
            ctx
            (ast.ty-node-get
              (ast.ast-type-list-get params index (ast.ast-type-id-fallback))))))
        [(TcArenaTarget.Target _ _ (TcMaybeNameId.Some region))
          (tc-selected-i64s-push! (&mut regions) region)]
        [_ unit])
      (set! index (+ index 1)))
    regions))

;; A signature type with the signature's arena `regions` erased
;; (`tc-selected-arena-erase`); an `(:invalidate r T)` parameter takes a `T`.
(define (tc-selected-signature-arena-erase
  [ctx : TcContext]
  [regions : (& regions (__tl_dyn-array i64))]
  [ty : ast.AstType]) : ast.AstType
  (tc-selected-arena-erase
    ctx
    regions
    (tc-type-strip-invalidate (tc-resolve-type ctx ty))))

;; A macro's hygienic name for an enum variant of its definition module,
;; looked up in that module's context exactly as legacy name lookup does (the
;; variant caches are keyed by the context's module).
(define (tc-selected-hygienic-variant? [ctx : TcContext] [raw-name : i64]) : bool
  (let
    [session : cis.InternStructuralSessionHandle
      (tc-context-structural-session ctx)]
    [source : i64 (macro-hygiene-global-source-name-id-or session raw-name -1)]
    [module-id : i64 (macro-hygiene-global-module-id session raw-name)]
    [source-ctx : TcContext
      (if (csym.compiler-symbol-root-module-id? module-id)
        (tc-context-with-module-id ctx "" cbi.compiler-builtin-id-fix-empty)
        (tc-context-with-module-id
          ctx
          (tc-env-key-name-text module-id)
          module-id))]
    (and
      (>= source 0)
      (match (tc-enum-qualified-variant-lookup-handle source-ctx source)
        [(option_i64.Some _) true]
        [(option_i64.None) false]))))

;; A struct or enum variant constructor named directly (not shadowed). A
;; macro's hygienic global name denotes its definition module's declaration,
;; which no local shadows. `info` is the name's builtin dispatch
;; (`tc-call-builtin-name`).
(define (tc-selected-call-constructor?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [raw-name : i64]
  [info : (& info TcCallBuiltinName)]) : bool
  (let
    [hygienic? : bool
      (macro-hygiene-global-id? (tc-context-structural-session ctx) raw-name)]
    (and
      (= info.arm 0)
      (or
        hygienic?
        (and
          (not
            (and
              (tc-type-env-scoped-runtime-active? env)
              (>= (tc-type-env-scoped-runtime-lookup-index env raw-name) 0)))
          (not (tc-name-local-bound-before-module-scan-id? env raw-name))))
      (or
        (and (not hygienic?) (tc-call-variant-name-id? ctx info.name-id))
        (and (not hygienic?) (tc-call-variant-name-id? ctx raw-name))
        (and hygienic? (tc-selected-hygienic-variant? ctx raw-name))
        ;; Struct constructors, and variants also through an import alias or
        ;; a hygienic name.
        (let
          [handle : i64 (tc-move-value-symbol-handle-id ctx raw-name)]
          (and
            (csym.compiler-symbols-handle-found? handle)
            (or
              (=
                (csym.compiler-symbol-handle-kind handle)
                (csym.compiler-symbol-kind-defstruct))
              (=
                (csym.compiler-symbol-handle-kind handle)
                (csym.compiler-symbol-kind-enum-variant)))))))))

;; A bare variant name of an imported module's enum, which legacy typing
;; resolves to its constructor function in the whole program although it names
;; no value symbol there: a callee typed as a function returning an enum with
;; a variant of that name, and no local of that name.
(define (tc-selected-call-variant-value?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [raw-name : i64]
  [func-id : i64]) : bool
  (and
    (not
      (macro-hygiene-global-id? (tc-context-structural-session ctx) raw-name))
    (not
      (and
        (tc-type-env-scoped-runtime-active? env)
        (>= (tc-type-env-scoped-runtime-lookup-index env raw-name) 0)))
    (not (tc-name-local-bound-before-module-scan-id? env raw-name))
    (match (tc-call-target-expr-id ctx env func-id)
      [(ResultTcType.Ok fn-ty)
        (tc-selected-enum-variant-named?
          ctx
          ;; A nullary variant is typed as its enum value.
          (match (tc-global-shared-view fn-ty)
            [(ast.AstType.Func _ ret) (ast.ty-node-get ret)]
            [_ (tc-global-shared-view fn-ty)])
          raw-name)]
      [(ResultTcType.Err _) false])))

;; Whether `ty` is an enum with a variant named `name`.
(define (tc-selected-enum-variant-named?
  [ctx : TcContext]
  [ty : ast.AstType]
  [name : i64]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(ast.AstType.Enum enum-name)
      (>= (tc-selected-variant ctx enum-name name).ordinal 0)]
    [(ast.AstType.EnumArgs enum-name _)
      (>= (tc-selected-variant ctx enum-name name).ordinal 0)]
    [_ false]))

;; A constructor's checked signature from its legacy target type. A field
;; storing a reference moves its loans into a lifetime-parameterized result,
;; which holds them.
;; Whether the call's type (legacy typing) is a lifetime-parameterized
;; aggregate all of whose lifetime arguments are arena regions here.
(define (tc-selected-arena-branded-call?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [call : ast.AstExpr]) : bool
  (match (tc-expr ctx env call)
    [(ResultTcType.Ok ty)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(ast.AstType.StructArgs _ lifetimes)
          (tc-selected-arena-lifetimes-only?
            env
            (ast.ast-lifetime-list-box-shared-view lifetimes))]
        [(ast.AstType.EnumArgs _ lifetimes)
          (tc-selected-arena-lifetimes-only?
            env
            (ast.ast-lifetime-list-box-shared-view lifetimes))]
        [_ false])]
    [(ResultTcType.Err _) false]))

(define (tc-selected-arena-lifetimes-only?
  [env : TcTypeEnv]
  [lifetimes : ast.AstLifetimeList]) : bool
  (let
    [count : i64 (ast.ast-lifetime-list-len (& lifetimes))]
    [index : i64 0]
    [all? : bool (> count 0)]
    (while (and all? (< index count))
      (unless
        (tc-selected-arena-region?
          env
          (ast.ast-lifetime-list-get
            (& lifetimes)
            index
            (ast.ast-lifetime-fallback)))
        (set! all? false))
      (set! index (+ index 1)))
    all?))

;; `ty` without the outer region tags that name a lifetime of `owner` (a
;; constructed aggregate type).
(define (tc-selected-strip-lifetime-tags
  [ctx : TcContext]
  [ty : ast.AstType]
  [owner : ast.AstType]) : ast.AstType
  (match (tc-resolve-type ctx (tc-global-shared-view ty))
    [(ast.AstType.Region region inner)
      (if (tc-selected-type-names-lifetime?
        (tc-global-shared-view owner)
        region)
        (tc-selected-strip-lifetime-tags ctx (ast.ty-node-get inner) owner)
        ty)]
    [_ ty]))

(define (tc-selected-type-names-lifetime?
  [owner : ast.AstType]
  [lifetime : i64]) : bool
  (match owner
    [(ast.AstType.StructArgs _ lifetimes)
      (tc-selected-lifetime-member?
        (ast.ast-lifetime-list-box-shared-view lifetimes)
        lifetime)]
    [(ast.AstType.EnumArgs _ lifetimes)
      (tc-selected-lifetime-member?
        (ast.ast-lifetime-list-box-shared-view lifetimes)
        lifetime)]
    [_ false]))

(define (tc-selected-lifetime-member?
  [lifetimes : ast.AstLifetimeList]
  [lifetime : i64]) : bool
  (let
    [index : i64 0]
    [found : bool false]
    (while (and (not found) (< index (ast.ast-lifetime-list-len (& lifetimes))))
      (when
        (=
          (ast.ast-lifetime-list-get
            (& lifetimes)
            index
            (ast.ast-lifetime-fallback))
          lifetime)
        (set! found true))
      (set! index (+ index 1)))
    found))

(define (tc-selected-constructor-target
  [ctx : TcContext]
  [env : TcTypeEnv]
  [call : ast.AstExpr]
  [func-id : i64]
  [arg-count : i64]) : TcSelectedCallTarget
  (let
    [func : ast.AstExpr (tc-context-expr-get ctx func-id)]
    ;; An arena-branded construction: every lifetime of the constructed type is
    ;; an arena region here, so a parameter tagged with one of them holds an
    ;; arena allocation, which the ownership graph erases (`tc-selected-arena-
    ;; erase`; destroying the arena invalidates the result, whose type keeps
    ;; the region).
    [arena-branded? : bool
      (tc-selected-arena-branded-call? ctx env (tc-global-shared-view call))]
    (match (tc-call-target-expr-id ctx env func-id)
      ;; Legacy call typing resolves a constructor without typing its name as
      ;; a value (a macro's variant through its module alias): it decides
      ;; whether the call is an error.
      [(ResultTcType.Err _) TcSelectedCallTarget.Legacy]
      [(ResultTcType.Ok fn-ty)
        (match (tc-global-shared-view fn-ty)
          [(ast.AstType.Func params-box ret-id)
            (let
              [params : ast.AstTypeList
                (ast.ast-type-list-box-shared-view params-box)]
              [index : i64 0]
              [ok? : bool
                (tc-selected-call-type-ok? ctx (ast.ty-node-get ret-id))]
              ;; A field may store a reference only into a lifetime-
              ;; parameterized aggregate, whose loans the MIR tracks.
              [holding? : bool
                (tc-selected-holding-type?
                  ctx
                  (tc-resolve-type ctx (ast.ty-node-get ret-id)))]
              (while (and ok? (< index (ast.ast-type-list-len (& params))))
                (set!
                  ok?
                  (let
                    [param : ast.AstType
                      (if arena-branded?
                        (tc-selected-strip-lifetime-tags
                          ctx
                          (ast.ty-node-get
                            (ast.ast-type-list-get
                              (& params)
                              index
                              (ast.ast-type-id-fallback)))
                          (tc-resolve-type ctx (ast.ty-node-get ret-id)))
                        (ast.ty-node-get
                          (ast.ast-type-list-get
                            (& params)
                            index
                            (ast.ast-type-id-fallback))))]
                    (if holding?
                      (tc-selected-call-param-type-ok? ctx param)
                      (tc-selected-call-type-ok? ctx param))))
                (set! index (+ index 1)))
              (cond
                ;; A struct or enum without lifetime parameters cannot hold a
                ;; reference soundly: its type names no lifetime, so a value
                ;; can outlive the referent once it leaves the function
                ;; (legacy walkers patched some of those escapes). Its
                ;; fields' lifetimes must be declared (`(:lifetimes n)`).
                [(and
                    (match (tc-resolve-type ctx (ast.ty-node-get ret-id))
                      [(ast.AstType.Struct _) true]
                      [(ast.AstType.Enum _) true]
                      [_ false])
                    (tc-selected-holds-reference?
                      ctx
                      (tc-resolve-type ctx (ast.ty-node-get ret-id))
                      false))
                  (match (tc-expr ctx env (tc-global-shared-view call))
                    [(ResultTcType.Err message)
                      (TcSelectedCallTarget.Err message)]
                    [(ResultTcType.Ok _)
                      (TcSelectedCallTarget.Err
                        ;; A missing lifetime declaration (E0210), not an
                        ;; escape.
                        (tc-kind-message
                          (cdiag.CompilerTypecheckKind.LifetimeMismatch)
                          (str_cat.str-cat
                            "typecheck: `"
                            (tc-type-render
                              (tc-resolve-type ctx (ast.ty-node-get ret-id)))
                            "` holds a reference but declares no lifetimes; declare them with (:lifetimes ...)")))])]
                [(not ok?) TcSelectedCallTarget.Legacy]
                [else
                  (TcSelectedCallTarget.Ordinary
                    -1
                    fn-ty
                    (tc-call-region-args-allowed-for-func
                      ctx
                      env
                      (tc-global-shared-view func)))]))]
          ;; A nullary variant's target is its enum value itself.
          [_
            (if (and
              (= arg-count 0)
              (tc-selected-call-type-ok? ctx (tc-global-shared-view fn-ty)))
              (TcSelectedCallTarget.Ordinary
                -1
                (ast.ast-ty-func (ast.ast-type-list-new) fn-ty)
                false)
              TcSelectedCallTarget.Legacy)])])))

;; A nullary enum variant used as a value is a construction without operands.
(define (tc-selected-symbol-kind? [ctx : TcContext] [name : i64] [kind : i64]) : bool
  (let
    [handle : i64 (tc-move-value-symbol-handle-id ctx name)]
    (and
      (csym.compiler-symbols-handle-found? handle)
      (= (csym.compiler-symbol-handle-kind handle) kind))))

(define (tc-selected-publish-nullary-variant
  [ty : ast.AstType]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (tc-selected-publish-call
    (ResultTcType.Ok (tc-global-shared-view ty))
    typed.TypedCallKind.Construct
    (ast.ast-ty-func (ast.ast-type-list-new) ty)
    syntax
    source
    (tc-selected-no-occurrences)
    true
    sink))

;; A module-qualified value name: a nullary variant is a construction and a
;; Copy module value is a read of a fresh value; others stay with legacy.
(define (tc-infer-selected-qualified-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [name : i64]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    [reference? : bool
      (tc-selected-expects-reference? ctx (tc-global-shared-view expected))]
    (match (tc-infer-selected-legacy ctx env expr syntax expected)
      [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
      [(ResultTcType.Ok ty)
        (cond
          [(and
              (or
                (tc-selected-symbol-kind?
                  ctx
                  name
                  (csym.compiler-symbol-kind-enum-variant))
                (tc-call-variant-name-id? ctx name)
                ;; A bare variant of an aliased import's enum
                ;; (`tc-selected-call-variant-value?`).
                (and
                  (not
                    (macro-hygiene-global-id?
                      (tc-context-structural-session ctx)
                      name))
                  (tc-selected-enum-variant-named?
                    ctx
                    (tc-global-shared-view ty)
                    name))
                ;; A macro template's hygienic `Enum.Variant` name.
                (and
                  (macro-hygiene-global-id?
                    (tc-context-structural-session ctx)
                    name)
                  (tc-selected-hygienic-variant? ctx name)))
              (tc-selected-call-type-ok? ctx (tc-global-shared-view ty)))
            (tc-selected-publish-nullary-variant ty syntax source sink)]
          ;; Any other resolved Copy name (a module value, a function) is read
          ;; as a fresh value.
          [(and
              (tc-type-copyable? ctx (tc-global-shared-view ty))
              (tc-selected-call-type-ok? ctx (tc-global-shared-view ty)))
            (tc-selected-publish
              (ResultTcType.Ok ty)
              syntax
              source
              (typed.TypedOperation.Primitive
                (typed.TypedPrimitive.Builtin (tc-selected-form-code-global) 0))
              (tc-selected-no-occurrences)
              sink)]
          ;; A move-only module value (of this module or another) is its static
          ;; place, as an unqualified one is (`tc-infer-selected-var`): taking it
          ;; whole is a move out of a global, which the checker rejects.
          [(>= (tc-selected-global-index ctx env name) 0)
            (tc-selected-place-acquire
              ctx
              env
              reference?
              ast.AstMaybeType.No
              syntax
              (ownership.ownership-source-copy (& source))
              (tc-selected-global-place-of
                ctx
                (tc-global-shared-view ty)
                (tc-selected-global-index ctx env name)
                name
                source
                sink))]
          [else (tc-selected-unrepresented (ResultTcType.Ok ty) sink)])])))

;; Builtins that only read their operands: string and array lengths, string
;; equality, indexing, copying and parsing, and clone.
(define (tc-selected-read-builtin-arm? [arm : i64]) : bool
  (or
    (= arm 2)
    (= arm 5)
    (= arm 6)
    (= arm 7)
    ;; Atomic and volatile pointer operations, the TLS current-arena word and
    ;; float square root and bit casts take and return plain values (raw
    ;; pointers, integers, floats): no operand is a tracked place.
    (= arm 8)
    (= arm 13)
    (= arm 20)
    (= arm 21)
    (= arm 14)
    (= arm 15)
    (= arm 16)
    (= arm 17)
    (= arm 23)
    ;; `c-fn-check` checks a Copy C function pointer and returns it non-null.
    (= arm 22)))

;; A read-only builtin: legacy typing decides its result and diagnostics; an
;; operand that is an owned non-Copy place is borrowed shared for the read,
;; any other operand is an evaluated value.
(define (tc-infer-selected-builtin
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [arm : i64]
  [args : (& args ast.AstExprList)]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-legacy ctx env expr syntax expected)
    [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcType.Ok ty)
      (match sink
        [(TcSelectedSink.Query)
          (TcSelectedResult.Ok
            ty
            TcSelectedOccurrence.Unrepresented
            TcSelectedSink.Query)]
        [(TcSelectedSink.Capture store lease bindings)
          (match (let
            [operand-source : ownership.OwnershipSource
              (tc-global-shared-view source)]
            (if (and (= arm 23) (= args.len 1))
              (tc-infer-selected-clone-operands
                ctx
                env
                args
                operand-source
                (TcSelectedSink.Capture store lease bindings))
              (tc-infer-selected-builtin-operands
                ctx
                env
                args
                0
                (__tl_make-array typed.TypedOccurrenceId args.len)
                operand-source
                (TcSelectedSink.Capture store lease bindings))))
            [(TcSelectedArgsResult.Err message next)
              (TcSelectedResult.Err message next)]
            [(TcSelectedArgsResult.Ok children represented? next)
              (if represented?
                (tc-selected-publish
                  (ResultTcType.Ok ty)
                  syntax
                  source
                  (typed.TypedOperation.Primitive
                    (typed.TypedPrimitive.Builtin arm args.len))
                  children
                  next)
                (TcSelectedResult.Ok ty TcSelectedOccurrence.Unrepresented next))])])]))

;; The compiler-special `clone`'s one operand, read (`tc-infer-selected-read`).
(define (tc-infer-selected-clone-operands
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedArgsResult
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-read-operand
    ctx
    env
    (ast.ast-expr-list-get args 0 0)
    source
    sink)
    [(TcSelectedResult.Err message next)
      (TcSelectedArgsResult.Err message next)]
    [(TcSelectedResult.Ok _ occurrence next)
      (match occurrence
        [(TcSelectedOccurrence.Selected child)
          (TcSelectedArgsResult.Ok (__tl_make-array child) true next)]
        [(TcSelectedOccurrence.Unrepresented)
          (TcSelectedArgsResult.Ok
            (__tl_make-array typed.TypedOccurrenceId 1)
            false
            next)])]))

(define (tc-infer-selected-builtin-operands
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [index : i64]
  [children : (__tl_dyn-array typed.TypedOccurrenceId)]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedArgsResult
    store
    lease
    intern
    bind)
  (if (>= index args.len)
    (TcSelectedArgsResult.Ok children true sink)
    (match (tc-infer-selected-operand
      ctx
      env
      (ast.ast-expr-list-get args index 0)
      (tc-global-shared-view source)
      sink)
      [(TcSelectedResult.Err message next)
        (TcSelectedArgsResult.Err message next)]
      [(TcSelectedResult.Ok _ occurrence next)
        (match occurrence
          [(TcSelectedOccurrence.Selected child)
            (set! (array-ref children index) child)
            (tc-infer-selected-builtin-operands
              ctx
              env
              args
              (+ index 1)
              children
              source
              next)]
          [(TcSelectedOccurrence.Unrepresented)
            (TcSelectedArgsResult.Ok children false next)])])))

;; `(slice-view source start len)` and `(slice-mut-view ...)`: legacy typing
;; decides the view type and diagnostics. An owned array source is borrowed
;; for the view (exclusively for a mutable view); a borrow form or a shared
;; reference source is read. The view is a reference holding its source
;; operand's loans.
(define (tc-infer-selected-slice-view
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [mutable? : bool]
  [args : (& args ast.AstExprList)]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-legacy ctx env expr syntax expected)
    [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcType.Ok ty)
      (if (!= args.len 3)
        (tc-selected-unrepresented (ResultTcType.Ok ty) sink)
        (match (tc-infer-selected-slice-source
          ctx
          env
          (ast.ast-expr-list-get args 0 0)
          mutable?
          (tc-global-shared-view source)
          sink)
          [(TcSelectedResult.Err message next)
            (TcSelectedResult.Err message next)]
          [(TcSelectedResult.Ok _ occurrence next)
            (match occurrence
              [(TcSelectedOccurrence.Unrepresented)
                (tc-selected-unrepresented (ResultTcType.Ok ty) next)]
              [(TcSelectedOccurrence.Selected first)
                (let
                  [children : (__tl_dyn-array typed.TypedOccurrenceId)
                    (__tl_make-array typed.TypedOccurrenceId 3)]
                  (set! (array-ref children 0) first)
                  (match (tc-infer-selected-builtin-operands
                    ctx
                    env
                    args
                    1
                    children
                    (tc-global-shared-view source)
                    next)
                    [(TcSelectedArgsResult.Err message after)
                      (TcSelectedResult.Err message after)]
                    [(TcSelectedArgsResult.Ok children represented? after)
                      (if represented?
                        (tc-selected-publish
                          (ResultTcType.Ok ty)
                          syntax
                          source
                          (typed.TypedOperation.Primitive
                            (typed.TypedPrimitive.Builtin 4 3))
                          children
                          after)
                        (tc-selected-unrepresented (ResultTcType.Ok ty) after))]))])]))]))

;; `(slice-split-at view mid)` (`-mut`): legacy typing checks the borrowed
;; Slice source and the index; the source is read (shared) or reborrowed
;; (mutable) once, and both halves of the result tuple hold its loans (form
;; 144).
(define (tc-selected-form-code-slice-split) : i64
  144)

(define (tc-infer-selected-slice-split
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [mutable? : bool]
  [args : (& args ast.AstExprList)]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-legacy ctx env expr syntax expected)
    [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcType.Ok ty)
      (if (!= args.len 2)
        (tc-selected-unrepresented (ResultTcType.Ok ty) sink)
        (match (tc-infer-selected-slice-source
          ctx
          env
          (ast.ast-expr-list-get args 0 0)
          mutable?
          (tc-global-shared-view source)
          sink)
          [(TcSelectedResult.Err message next)
            (TcSelectedResult.Err message next)]
          [(TcSelectedResult.Ok _ occurrence next)
            (match occurrence
              [(TcSelectedOccurrence.Unrepresented)
                (tc-selected-unrepresented (ResultTcType.Ok ty) next)]
              [(TcSelectedOccurrence.Selected first)
                (let
                  [children : (__tl_dyn-array typed.TypedOccurrenceId)
                    (__tl_make-array typed.TypedOccurrenceId 2)]
                  (set! (array-ref children 0) first)
                  (match (tc-infer-selected-builtin-operands
                    ctx
                    env
                    args
                    1
                    children
                    (tc-global-shared-view source)
                    next)
                    [(TcSelectedArgsResult.Err message after)
                      (TcSelectedResult.Err message after)]
                    [(TcSelectedArgsResult.Ok children represented? after)
                      (if represented?
                        (tc-selected-publish
                          (ResultTcType.Ok ty)
                          syntax
                          source
                          (typed.TypedOperation.Primitive
                            (typed.TypedPrimitive.Builtin
                              (tc-selected-form-code-slice-split)
                              2))
                          children
                          after)
                        (tc-selected-unrepresented (ResultTcType.Ok ty) after))]))])]))]))

;; The source operand of a slice view: a borrow of an owned array place, or
;; the value of any other source form.
(define (tc-infer-selected-slice-source
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg-id : i64]
  [mutable? : bool]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    [arg : ast.AstExpr (tc-context-expr-get ctx arg-id)]
    [owned-array? : bool
      (match (tc-expr-id ctx env arg-id)
        [(ResultTcType.Ok arg-ty)
          (match (tc-resolve-type ctx (tc-global-shared-view arg-ty))
            [(ast.AstType.Array _ _) true]
            [(ast.AstType.DynArray _) true]
            [_ false])]
        [(ResultTcType.Err _) false])]
    (cond
      [(not (tc-selected-place-expression? ctx (tc-global-shared-view arg)))
        (tc-infer-selected-operand ctx env arg-id source sink)]
      ;; A slice reference source: a shared one is copied; a mutable one is
      ;; reborrowed (a two-phase operand of the view form), so the parent is
      ;; usable again once the view is dead.
      [(not owned-array?)
        (if mutable?
          (tc-infer-selected-sequence-child
            ctx
            env
            arg-id
            ast.AstMaybeType.No
            source
            true
            sink)
          (tc-infer-selected-operand ctx env arg-id source sink))]
      [mutable? (tc-infer-selected-write-operand ctx env arg-id source sink)]
      [else
        (match (tc-infer-selected-place-id
          ctx
          env
          arg-id
          (tc-global-shared-view source)
          sink)
          [(TcSelectedPlaceResult.Err message next)
            (TcSelectedResult.Err message next)]
          [(TcSelectedPlaceResult.Ok ty place next)
            (match place
              [(TcSelectedPlace.Unrepresented)
                (tc-selected-unrepresented (ResultTcType.Ok ty) next)]
              [(TcSelectedPlace.Selected id indices)
                (tc-selected-publish-borrow
                  (ast.ast-ty-ref 0 (& ty))
                  false
                  id
                  indices
                  (typed.TypedSyntax.Source arg-id)
                  source
                  next)])])])))

;; An extern call (SPEC 4.3: no ownership effect): legacy typing decides its
;; result and diagnostics, and each operand is read for the call like a
;; read-only builtin's.
(define (tc-infer-selected-foreign-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [key : i64]
  [fn-ty : ast.AstType]
  [args : (& args ast.AstExprList)]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-legacy ctx env expr syntax expected)
    [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcType.Ok ty)
      (match sink
        [(TcSelectedSink.Query)
          (TcSelectedResult.Ok
            ty
            TcSelectedOccurrence.Unrepresented
            TcSelectedSink.Query)]
        [(TcSelectedSink.Capture store lease bindings)
          (match (tc-infer-selected-builtin-operands
            ctx
            env
            args
            0
            (__tl_make-array typed.TypedOccurrenceId args.len)
            (tc-global-shared-view source)
            (TcSelectedSink.Capture store lease bindings))
            [(TcSelectedArgsResult.Err message next)
              (TcSelectedResult.Err message next)]
            [(TcSelectedArgsResult.Ok children represented? next)
              (tc-selected-publish-call
                (ResultTcType.Ok ty)
                (typed.TypedCallKind.Foreign key)
                fn-ty
                syntax
                source
                children
                represented?
                next)])])]))

;; A call through a C function pointer value (SPEC 4.3): the pointer, a Copy
;; value, is read first; then, as for an extern function, legacy typing
;; decides the result and each operand is read for the call (a non-Copy place
;; is lent). The callee is the call's child 0, as for any call through a value.
(define (tc-infer-selected-foreign-value-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [func-id : i64]
  [fn-ty : ast.AstType]
  [args : (& args ast.AstExprList)]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-legacy ctx env expr syntax expected)
    [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcType.Ok ty)
      (match sink
        [(TcSelectedSink.Query)
          (TcSelectedResult.Ok
            ty
            TcSelectedOccurrence.Unrepresented
            TcSelectedSink.Query)]
        [(TcSelectedSink.Capture store lease bindings)
          (match (tc-infer-selected-callee
            ctx
            env
            func-id
            (tc-global-shared-view source)
            (TcSelectedSink.Capture store lease bindings))
            [(TcSelectedResult.Err message next)
              (TcSelectedResult.Err message next)]
            [(TcSelectedResult.Ok _ callee next)
              (match (tc-infer-selected-builtin-operands
                ctx
                env
                args
                0
                (__tl_make-array typed.TypedOccurrenceId args.len)
                (tc-global-shared-view source)
                next)
                [(TcSelectedArgsResult.Err message after)
                  (TcSelectedResult.Err message after)]
                [(TcSelectedArgsResult.Ok children represented? after)
                  (tc-selected-publish-call
                    (ResultTcType.Ok ty)
                    (typed.TypedCallKind.Indirect
                      (tc-selected-effect-callee-id ctx env func-id))
                    fn-ty
                    syntax
                    source
                    (tc-selected-with-callee children (& callee))
                    (and
                      represented?
                      (match (& callee)
                        [(TcSelectedOccurrence.Selected _) true]
                        [_ false]))
                    after)])])])]))

;; A read operand formed as a place: a named place, or an array element (lent
;; whole for the read when its element cannot be named).
(define (tc-selected-operand-place? [ctx : TcContext] [expr : ast.AstExpr]) : bool
  (or
    (tc-selected-place-expression? ctx (tc-global-shared-view expr))
    (match (ast.ast-expr-unspan expr)
      [(ast.AstExpr.ArrayRef _ _) true]
      [(ast.AstExpr.MacroExpansion expanded _ _)
        (tc-selected-operand-place? ctx (tc-context-expr-get ctx expanded))]
      [_ false])))

;; How a call argument meets a reference formal `want`: 1, a compound one read
;; as `clone` reads its operand (`tc-infer-selected-read-operand`); 2, a
;; move-only element read through a temporary (no auto-borrowed place), read
;; the same way; 3, a `&mut` element or field where a `&mut` is expected, the
;; implicit reborrow `&mut *(array-ref r i)` or `&mut *h.r` (Rust's reborrow
;; coercion), not a move of the reference out of its place (a binder argument
;; is reborrowed by the graph, `normalize-argument!`); 0, inferred as any other
;; argument.
(define (tc-selected-argument-route
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg-id : i64]
  [want : (& want ast.AstType)]) : i64
  (match want
    [(ast.AstType.Ref _ _)
      (cond
        [(tc-selected-read-spine-form? ctx (tc-context-expr-get ctx arg-id)) 1]
        [(and
            (tc-selected-element-form? ctx (tc-context-expr-get ctx arg-id))
            (match (tc-expr-id ctx env arg-id)
              [(ResultTcType.Ok own) (not (tc-type-copyable? ctx own))]
              [(ResultTcType.Err _) false]))
          2]
        [else 0])]
    [(ast.AstType.MutRef _ _)
      (if (and
        (or
          (tc-selected-element-form? ctx (tc-context-expr-get ctx arg-id))
          (tc-selected-field-read-form? ctx (tc-context-expr-get ctx arg-id)))
        (match (tc-expr-id ctx env arg-id)
          [(ResultTcType.Ok ty)
            (match (tc-type-strip-region (tc-resolve-type ctx ty))
              [(ast.AstType.MutRef _ _) true]
              [_ false])]
          [(ResultTcType.Err _) false]))
        3
        0)]
    [_ 0]))

(define (tc-infer-selected-reborrow-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg-id : i64]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-place-id
    ctx
    env
    arg-id
    (tc-global-shared-view source)
    sink)
    [(TcSelectedPlaceResult.Err message next)
      (TcSelectedResult.Err message next)]
    [(TcSelectedPlaceResult.Ok ty place next)
      (let
        [referent : ast.AstType
          (tc-selected-referent
            ctx
            (tc-type-strip-region
              (tc-resolve-type ctx (tc-global-shared-view ty))))]
        (match (tc-selected-place-project
          (tc-global-shared-view referent)
          referent
          place
          typed.TypedProjectionKind.Deref
          (tc-global-shared-view source)
          next)
          [(TcSelectedPlaceResult.Err message after)
            (TcSelectedResult.Err message after)]
          [(TcSelectedPlaceResult.Ok _ derefed after)
            (match derefed
              [(TcSelectedPlace.Selected id indices)
                (tc-selected-publish-borrow
                  ty
                  true
                  id
                  indices
                  (typed.TypedSyntax.Source arg-id)
                  source
                  after)]
              [(TcSelectedPlace.Unrepresented)
                (tc-selected-unrepresented (ResultTcType.Ok ty) after)])]))]))

;; An array or slice element read, through any expansion wrapper.
(define (tc-selected-element-form? [ctx : TcContext] [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan expr)
    [(ast.AstExpr.ArrayRef _ _) true]
    [(ast.AstExpr.MacroExpansion expanded _ _)
      (tc-selected-element-form? ctx (tc-context-expr-get ctx expanded))]
    [_ false]))

(define (tc-infer-selected-operand
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg-id : i64]
  [outer : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    ;; The operand's own location, for its borrow's diagnostics.
    [source : ownership.OwnershipSource
      (match (tc-expr-maybe-span
        (tc-context-expr-bases ctx)
        (tc-context-expr-get ctx arg-id))
        [(TcMaybeAstSourceSpan.Some at)
          (ownership.OwnershipSource
            (string.copy (& outer.path))
            (ast.ast-source-span-start-line at)
            (ast.ast-source-span-start-col at)
            (string.copy (& outer.expansion)))]
        [(TcMaybeAstSourceSpan.No) outer])]
    (if (tc-selected-operand-place? ctx (tc-context-expr-get ctx arg-id))
      (match (tc-infer-selected-place-id
        ctx
        env
        arg-id
        (tc-global-shared-view source)
        sink)
        [(TcSelectedPlaceResult.Err message next)
          (TcSelectedResult.Err message next)]
        [(TcSelectedPlaceResult.Ok ty place next)
          (match place
            [(TcSelectedPlace.Selected id indices)
              (if (and
                (tc-selected-owned-scrutinee? ctx (tc-global-shared-view ty))
                (not (tc-type-copyable? ctx (tc-global-shared-view ty))))
                (tc-selected-publish-borrow
                  (ast.ast-ty-ref 0 (& ty))
                  false
                  id
                  indices
                  (typed.TypedSyntax.Source arg-id)
                  source
                  next)
                (match (tc-resolve-type ctx (tc-global-shared-view ty))
                  ;; A mutable reference is reborrowed shared through its
                  ;; referent for the read, never moved.
                  [(ast.AstType.MutRef _ inner)
                    (let
                      [referent : ast.AstType
                        (tc-resolve-type ctx (tc-context-type-get ctx inner))]
                      (match (tc-selected-place-project
                        (tc-global-shared-view referent)
                        (tc-global-shared-view referent)
                        (TcSelectedPlace.Selected id indices)
                        typed.TypedProjectionKind.Deref
                        (tc-global-shared-view source)
                        next)
                        [(TcSelectedPlaceResult.Err message after)
                          (TcSelectedResult.Err message after)]
                        [(TcSelectedPlaceResult.Ok _ derefed after)
                          (match derefed
                            [(TcSelectedPlace.Selected
                                referent-id
                                referent-indices)
                              (tc-selected-publish-borrow
                                (ast.ast-ty-ref 0 referent)
                                false
                                referent-id
                                referent-indices
                                (typed.TypedSyntax.Source arg-id)
                                source
                                after)]
                            [(TcSelectedPlace.Unrepresented)
                              (tc-selected-unrepresented
                                (ResultTcType.Ok ty)
                                after)])]))]
                  [_
                    (cond
                      ;; An element (or a temporary's part) is read from the
                      ;; place already formed: its indices are evaluated once.
                      ;; A region-tagged element (read through a reference) is
                      ;; a view, acquired as a shared reborrow of the element.
                      [(> (array-length indices) 0)
                        (if (or
                          (tc-type-copyable? ctx (tc-global-shared-view ty))
                          (match (& ty)
                            [(ast.AstType.Region _ _) true]
                            [_ false]))
                          (tc-selected-place-acquire
                            ctx
                            env
                            true
                            ast.AstMaybeType.No
                            (typed.TypedSyntax.Source arg-id)
                            source
                            (TcSelectedPlaceResult.Ok
                              ty
                              (TcSelectedPlace.Selected id indices)
                              next))
                          (tc-selected-unrepresented (ResultTcType.Ok ty) next))]
                      [(or
                          (tc-type-copyable? ctx (tc-global-shared-view ty))
                          (not
                            (tc-selected-owned-scrutinee?
                              ctx
                              (tc-global-shared-view ty))))
                        (tc-infer-selected-sequence-child
                          ctx
                          env
                          arg-id
                          ast.AstMaybeType.No
                          source
                          true
                          next)]
                      [else
                        (tc-selected-unrepresented (ResultTcType.Ok ty) next)])]))]
            ;; A read never moves its operand: a place it cannot borrow keeps the
            ;; builtin unrepresented unless the value is Copy.
            [(TcSelectedPlace.Unrepresented)
              (if (tc-type-copyable? ctx (tc-global-shared-view ty))
                (tc-infer-selected-sequence-child
                  ctx
                  env
                  arg-id
                  ast.AstMaybeType.No
                  source
                  true
                  next)
                (tc-selected-unrepresented (ResultTcType.Ok ty) next))])])
      (tc-infer-selected-sequence-child
        ctx
        env
        arg-id
        ast.AstMaybeType.No
        source
        true
        sink))))

;; --- Clone reads (SPEC 7.6) ---------------------------------------------------
;;
;; The compiler-special `(clone value)` reads its operand without moving it.
;; The read reaches the operand's result positions: through annotation, `cast`
;; and expansion wrappers, both `if` branches, every match arm body, the `let`
;; body, the last form of a `begin` or `unsafe` block, and the receivers of
;; `deref`, field, tuple and array projections. A move-only place in such a
;; position is lent shared for the read (Rust's `&place`) instead of moved;
;; any other move-only value there is held in a temporary lent the same way.
;; A form the read reaches through therefore yields that reference, which
;; `clone` reads through, as it reads a place operand directly. Everything
;; else in the operand (conditions, scrutinees, initializers, earlier forms,
;; indices, arguments) is inferred as anywhere else. The forms read through are
;; registered by expression id while the operand is inferred; each one's result
;; sites call `tc-infer-selected-result-id`, and its occurrence is published
;; with the type of its result (`tc-selected-read-result-type-id!`). The
;; inferred types stay the expressions' own.
;;
;; The forms a read reaches through to their results:
(define (tc-selected-read-spine-form? [ctx : TcContext] [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan (& expr))
    [(ast.AstExpr.If _ _ _) true]
    [(ast.AstExpr.Match _) true]
    [(ast.AstExpr.Let _) true]
    [(ast.AstExpr.Begin _) true]
    [(ast.AstExpr.Unsafe _) true]
    [(ast.AstExpr.Ann _ _) true]
    [(ast.AstExpr.Cast _ _) true]
    [(ast.AstExpr.MacroExpansion expanded _ _)
      (tc-selected-read-spine-form? ctx (tc-context-expr-get ctx expanded))]
    [_ false]))

;; Register `id` as a form the read reaches through.
(define (tc-selected-read-spine-push
  [sink : (TcSelectedSink store lease intern bind)]
  [id : i64]) : (TcSelectedSink store lease intern bind)
  (match sink
    [(TcSelectedSink.Query) TcSelectedSink.Query]
    [(TcSelectedSink.Capture store lease bindings)
      (tc-selected-i64s-push! (&mut bindings.read-spines) id)
      (TcSelectedSink.Capture store lease bindings)]))

;; Retire the forms registered from `mark`.
(define (tc-selected-read-spine-pop
  [sink : (TcSelectedSink store lease intern bind)]
  [mark : i64]) : (TcSelectedSink store lease intern bind)
  (match sink
    [(TcSelectedSink.Query) TcSelectedSink.Query]
    [(TcSelectedSink.Capture store lease bindings)
      (if (= mark 0)
        (set! bindings.read-spines (tc-selected-no-i64s))
        (let
          [index : i64 mark]
          (while (< index (array-length bindings.read-spines))
            (set! (array-ref bindings.read-spines index) -1)
            (set! index (+ index 1)))))
      (TcSelectedSink.Capture store lease bindings)]))

;; Whether `syntax` names a form the read reaches through (1) or not (0).
(define (tc-selected-sink-read-spine
  [sink : (TcSelectedSink store lease intern bind)]
  [syntax : (& syntax typed.TypedSyntax)]) : (TcSelectedCounted
    store
    lease
    intern
    bind)
  (match sink
    [(TcSelectedSink.Query) (TcSelectedCounted.Counted 0 TcSelectedSink.Query)]
    [(TcSelectedSink.Capture store lease bindings)
      (TcSelectedCounted.Counted
        (if (tc-selected-read-spine-syntax? (& bindings) syntax)
          1
          0)
        (TcSelectedSink.Capture store lease bindings))]))

;; A read operand: the compiler-special `clone`'s, or a compound argument a
;; shared-reference formal borrows. It is read, never moved.
(define (tc-infer-selected-read-operand
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg-id : i64]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    [counted : (TcSelectedCounted store lease intern bind)
      (match sink
        [(TcSelectedSink.Query)
          (TcSelectedCounted.Counted 0 TcSelectedSink.Query)]
        [(TcSelectedSink.Capture store lease bindings)
          (TcSelectedCounted.Counted
            (array-length bindings.read-spines)
            (TcSelectedSink.Capture store lease bindings))])]
    [mark : i64 (tc-selected-counted-value (& counted))]
    [sink : (TcSelectedSink store lease intern bind)
      (tc-selected-counted-sink counted)]
    (match (if (tc-selected-read-spine-form?
      ctx
      (tc-context-expr-get ctx arg-id))
      (tc-infer-selected-read ctx env arg-id ast.AstMaybeType.No source sink)
      (tc-infer-selected-operand
        ctx
        env
        arg-id
        source
        (tc-selected-read-receiver-push ctx env arg-id sink)))
      [(TcSelectedResult.Ok ty occurrence next)
        (TcSelectedResult.Ok
          ty
          occurrence
          (tc-selected-read-spine-pop next mark))]
      [(TcSelectedResult.Err message next)
        (TcSelectedResult.Err message (tc-selected-read-spine-pop next mark))])))

;; A form's result child `id`: read when the form itself is read through,
;; otherwise inferred as anywhere else.
(define (tc-infer-selected-result-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [syntax : (& syntax typed.TypedSyntax)]
  [id : i64]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-selected-sink-read-spine sink syntax)
    [(TcSelectedCounted.Counted read? next)
      (if (= read? 1)
        (tc-infer-selected-read ctx env id expected source next)
        (tc-infer-selected-id ctx env id expected source next))]))

;; `tc-infer-selected-sequence-child` for a form's child `id`, its result
;; child when `result?`.
(define (tc-infer-selected-result-child
  [ctx : TcContext]
  [env : TcTypeEnv]
  [syntax : (& syntax typed.TypedSyntax)]
  [result? : bool]
  [id : i64]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [represented? : bool]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (if (and result? represented?)
    (tc-infer-selected-result-id ctx env syntax id expected source sink)
    (tc-infer-selected-sequence-child
      ctx
      env
      id
      expected
      source
      represented?
      sink)))

;; A result position of a `clone` operand: a form the read reaches through is
;; registered and inferred (its own result sites read in turn); any other
;; expression is a read tail.
(define (tc-infer-selected-read
  [ctx : TcContext]
  [env : TcTypeEnv]
  [id : i64]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (if (tc-selected-read-spine-form? ctx (tc-context-expr-get ctx id))
    (tc-infer-selected-id
      ctx
      env
      id
      expected
      source
      (tc-selected-read-spine-push sink id))
    (tc-infer-selected-read-tail ctx env id expected source sink)))

;; A read tail. A Copy value, a reference or a diverging value is inferred as
;; anywhere else. A move-only place is lent as a read builtin's operand is
;; (`tc-infer-selected-operand`), and when it projects out of a form the read
;; reaches through, that receiver is read too; any other move-only value is
;; held in a temporary lent the same way. The result keeps the expression's
;; own type; its occurrence is the read reference.
(define (tc-infer-selected-read-tail
  [ctx : TcContext]
  [env : TcTypeEnv]
  [id : i64]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (cond
    [(not
        (match (tc-expr-id ctx env id)
          [(ResultTcType.Ok ty)
            (match (& ty)
              [(ast.AstType.Never) false]
              [(ast.AstType.Ref _ _) false]
              [(ast.AstType.MutRef _ _) false]
              [_ (not (tc-type-copyable? ctx ty))])]
          [(ResultTcType.Err _) false]))
      (tc-infer-selected-id ctx env id expected source sink)]
    [(tc-selected-operand-place? ctx (tc-context-expr-get ctx id))
      (match (tc-infer-selected-operand
        ctx
        env
        id
        source
        (tc-selected-read-receiver-push ctx env id sink))
        [(TcSelectedResult.Err message next)
          (TcSelectedResult.Err message next)]
        ;; The read reference of the lent place stands for the place's
        ;; value, of the type its context gives it.
        [(TcSelectedResult.Ok ty occurrence next)
          (let
            [value : ast.AstType
              (match (& ty)
                [(ast.AstType.Ref _ inner) (ast.ty-node-get inner)]
                [_ ty])]
            (match (match expected
              [(ast.AstMaybeType.No) (ResultTcType.Ok value)]
              [(ast.AstMaybeType.Some want)
                (tc-expr-result-with-expected-or-actual
                  ctx
                  env
                  want
                  false
                  (ResultTcType.Ok value))])
              [(ResultTcType.Ok read)
                (TcSelectedResult.Ok read occurrence next)]
              [(ResultTcType.Err message) (TcSelectedResult.Err message next)]))])]
    [else (tc-infer-selected-read-value ctx env id expected source sink)]))

;; A move-only value in a read position: held in a temporary, which is lent
;; for the read.
(define (tc-infer-selected-read-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [id : i64]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-id
    ctx
    env
    id
    expected
    (ownership.ownership-source-copy (& source))
    sink)
    [(TcSelectedResult.Err message next) (TcSelectedResult.Err message next)]
    [(TcSelectedResult.Ok ty occurrence next)
      (match occurrence
        [(TcSelectedOccurrence.Unrepresented)
          (TcSelectedResult.Ok ty TcSelectedOccurrence.Unrepresented next)]
        [(TcSelectedOccurrence.Selected value)
          (match next
            [(TcSelectedSink.Query)
              (TcSelectedResult.Ok
                ty
                TcSelectedOccurrence.Unrepresented
                TcSelectedSink.Query)]
            [(TcSelectedSink.Capture store lease bindings)
              (match (tc-selected-temporary-place!
                (ast.ty-node-get (ast.ast-node-pool-reader-type-push (& ty)))
                value
                (ownership.ownership-source-copy (& source))
                store
                lease
                bindings)
                [(TcSelectedPlaceResult.Err message after)
                  (TcSelectedResult.Err message after)]
                [(TcSelectedPlaceResult.Ok _ place after)
                  (match place
                    [(TcSelectedPlace.Selected place-id indices)
                      (match (tc-selected-publish-borrow
                        (ast.ast-ty-ref 0 (& ty))
                        false
                        place-id
                        indices
                        (typed.TypedSyntax.Source id)
                        source
                        after)
                        [(TcSelectedResult.Ok _ borrow done)
                          (TcSelectedResult.Ok ty borrow done)]
                        [(TcSelectedResult.Err message done)
                          (TcSelectedResult.Err message done)])]
                    [(TcSelectedPlace.Unrepresented)
                      (TcSelectedResult.Ok
                        ty
                        TcSelectedOccurrence.Unrepresented
                        after)])])])])]))

;; The receiver a projection chain `id` starts from when that receiver is not
;; a place (`tc-infer-selected-receiver-place` holds it in a temporary), or -1.
(define (tc-selected-projection-base [ctx : TcContext] [id : i64]) : i64
  (match (ast.ast-expr-unspan (& (tc-context-expr-get ctx id)))
    [(ast.AstExpr.StructGet receiver _)
      (tc-selected-projection-receiver-base ctx receiver)]
    [(ast.AstExpr.TupleRef receiver _)
      (tc-selected-projection-receiver-base ctx receiver)]
    [(ast.AstExpr.ArrayRef receiver _)
      (tc-selected-projection-receiver-base ctx receiver)]
    [(ast.AstExpr.BoxGet receiver)
      (tc-selected-projection-receiver-base ctx receiver)]
    [(ast.AstExpr.BoxTake receiver)
      (tc-selected-projection-receiver-base ctx receiver)]
    [(ast.AstExpr.MacroExpansion expanded _ _)
      (tc-selected-projection-base ctx expanded)]
    [_ -1]))

(define (tc-selected-projection-receiver-base
  [ctx : TcContext]
  [receiver : i64]) : i64
  (if (tc-selected-place-form? ctx (tc-context-expr-get ctx receiver))
    (tc-selected-projection-base ctx receiver)
    receiver))

;; A read of projection `id` reads its receiver too: a move-only receiver that
;; is a form the read reaches through is registered, so its temporary holds
;; the read reference (`tc-selected-place-temporary`). A receiver that an
;; index evaluated after it can write is retained by value instead, as the
;; lowering retains an operand a later operand can write (its snapshot rule):
;; the clone then reads the value the receiver selected before that write.
(define (tc-selected-read-receiver-push
  [ctx : TcContext]
  [env : TcTypeEnv]
  [id : i64]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedSink
    store
    lease
    intern
    bind)
  (let
    [base : i64 (tc-selected-projection-base ctx id)]
    (if (and
      (>= base 0)
      (tc-selected-read-spine-form? ctx (tc-context-expr-get ctx base))
      (match (tc-expr-id ctx env base)
        [(ResultTcType.Ok ty) (not (tc-type-copyable? ctx ty))]
        [(ResultTcType.Err _) false])
      (not (tc-selected-receiver-written? ctx env id base)))
      (tc-selected-read-spine-push sink base)
      sink)))

;; Whether an index of projection chain `id`, evaluated after its receiver
;; `base`, can write a root `base` may select (`tc-selected-read-roots!`).
(define (tc-selected-receiver-written?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [id : i64]
  [base : i64]) : bool
  (let
    [roots : (__tl_dyn-array i64) (tc-selected-no-i64s)]
    [indices : (__tl_dyn-array i64) (tc-selected-no-i64s)]
    [budget : i64 4096]
    [written? : bool false]
    [index : i64 0]
    (tc-selected-read-roots! ctx base (&mut roots))
    (tc-selected-chain-indices! ctx id base (&mut indices))
    (while (and (not written?) (< index (array-length indices)))
      (let
        [root : i64 0]
        (while (and (not written?) (< root (array-length roots)))
          (set!
            written?
            (tc-selected-writes-root?
              ctx
              env
              (array-ref indices index)
              (array-ref roots root)
              (>= (tc-selected-global-index ctx env (array-ref roots root)) 0)
              (&mut budget)))
          (set! root (+ root 1))))
      (set! index (+ index 1)))
    written?))

;; The roots of the places a form the read reaches through may select: the
;; variables its result tails project from inline (fields, tuple components
;; and array elements). A tail read through a reference or box, or a value,
;; selects no root.
(define (tc-selected-read-roots!
  [ctx : TcContext]
  [id : i64]
  [roots : (&mut roots (__tl_dyn-array i64))]) : unit
  (match (tc-context-expr-get ctx id)
    [(ast.AstExpr.Spanned inner _) (tc-selected-read-roots! ctx inner roots)]
    [(ast.AstExpr.MacroExpansion expanded _ _)
      (tc-selected-read-roots! ctx expanded roots)]
    [(ast.AstExpr.Ann inner _) (tc-selected-read-roots! ctx inner roots)]
    [(ast.AstExpr.Cast inner _) (tc-selected-read-roots! ctx inner roots)]
    [(ast.AstExpr.If _ then-id else-id)
      (tc-selected-read-roots! ctx then-id roots)
      (tc-selected-read-roots! ctx else-id roots)]
    [(ast.AstExpr.Let let-box)
      (match (& (deref let-box))
        [(ast.AstLet.Let _ body) (tc-selected-read-roots! ctx body roots)])]
    [(ast.AstExpr.Begin items)
      (when
        (> items.len 0)
        (tc-selected-read-roots!
          ctx
          (ast.ast-expr-list-get (& items) (- items.len 1) 0)
          roots))]
    [(ast.AstExpr.Unsafe items)
      (when
        (> items.len 0)
        (tc-selected-read-roots!
          ctx
          (ast.ast-expr-list-get (& items) (- items.len 1) 0)
          roots))]
    [(ast.AstExpr.Match match-box)
      (match (& (deref match-box))
        [(ast.AstMatch.Match _ arms)
          (let
            [index : i64 0]
            (while (< index arms.len)
              (match (ast.ast-match-arm-list-get
                arms
                index
                (ast.ast-match-arm-fallback))
                [(ast.AstMatchArm.Arm _ body)
                  (tc-selected-read-roots! ctx body roots)])
              (set! index (+ index 1))))])]
    [(ast.AstExpr.StructGet receiver _)
      (tc-selected-read-roots! ctx receiver roots)]
    [(ast.AstExpr.TupleRef receiver _)
      (tc-selected-read-roots! ctx receiver roots)]
    [(ast.AstExpr.ArrayRef receiver _)
      (tc-selected-read-roots! ctx receiver roots)]
    [(ast.AstExpr.Var name) (tc-selected-i64s-push! (&mut roots) name)]
    [_ unit]))

;; The indices of projection chain `id` above its receiver `base`, which are
;; evaluated after the receiver.
(define (tc-selected-chain-indices!
  [ctx : TcContext]
  [id : i64]
  [base : i64]
  [indices : (&mut indices (__tl_dyn-array i64))]) : unit
  (when
    (!= id base)
    (match (tc-context-expr-get ctx id)
      [(ast.AstExpr.Spanned inner _)
        (tc-selected-chain-indices! ctx inner base indices)]
      [(ast.AstExpr.MacroExpansion expanded _ _)
        (tc-selected-chain-indices! ctx expanded base indices)]
      [(ast.AstExpr.StructGet receiver _)
        (tc-selected-chain-indices! ctx receiver base indices)]
      [(ast.AstExpr.TupleRef receiver _)
        (tc-selected-chain-indices! ctx receiver base indices)]
      [(ast.AstExpr.BoxGet receiver)
        (tc-selected-chain-indices! ctx receiver base indices)]
      [(ast.AstExpr.BoxTake receiver)
        (tc-selected-chain-indices! ctx receiver base indices)]
      [(ast.AstExpr.ArrayRef receiver index)
        (tc-selected-i64s-push! (&mut indices) index)
        (tc-selected-chain-indices! ctx receiver base indices)]
      [_ unit])))

;; Whether evaluating `expr-id` can write the variable `root`, the lowering's
;; snapshot proof (`lower-snapshot-writes-root?`): safe code changes a local
;; only by naming it in a writing position (`set!`, `replace!`, a store, push,
;; take or `box-set` into a place rooted at it, `(&mut ...)` of such a place,
;; `ptr-addr-of`); a read of it changes nothing. A call may write a module
;; value (`global?`). Unscannable forms, and running out of `budget`, answer
;; that it may.
(define (tc-selected-writes-root?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]
  [root : i64]
  [global? : bool]
  [budget : (&mut budget i64)]) : bool
  (cond
    [(< expr-id 0) false]
    [(<= (deref budget) 0) true]
    [else
      (set! (deref budget) (- (deref budget) 1))
      (let
        [expr : ast.AstExpr (tc-context-expr-get ctx expr-id)]
        (match (& expr)
          [(ast.AstExpr.Var _) false]
          [(ast.AstExpr.Set name value)
            (or
              (tc-selected-name-may-denote-root? ctx env name root)
              (tc-selected-writes-root? ctx env value root global? budget))]
          [(or (ast.AstExpr.Replace place-box _)
               (ast.AstExpr.StructSet place-box _ _)
               (ast.AstExpr.ArraySet place-box _ _)
               (ast.AstExpr.ArrayTake place-box _ _)
               (ast.AstExpr.ArrayPush place-box _)
               (ast.AstExpr.BoxSet place-box _) (ast.AstExpr.BoxTake place-box)
               (ast.AstExpr.PtrAddrOf place-box))
            (or
              (tc-selected-place-roots-at? ctx env place-box root)
              (tc-selected-writes-root-children?
                ctx
                env
                (ast.ast-expr-child-ids (tc-context-expr-get ctx expr-id))
                0
                root
                global?
                budget))]
          [(ast.AstExpr.Borrow mutable? _ place-box)
            (or
              (and
                mutable?
                (tc-selected-place-roots-at? ctx env place-box root))
              (tc-selected-writes-root? ctx env place-box root global? budget))]
          [(ast.AstExpr.Call _ _)
            (or
              global?
              (tc-selected-writes-root-children?
                ctx
                env
                (ast.ast-expr-child-ids (tc-context-expr-get ctx expr-id))
                0
                root
                global?
                budget))]
          ;; Forms that bind or update state through payload fields other
          ;; than expression children are not decomposed.
          [(ast.AstExpr.Foreach _) true]
          [(ast.AstExpr.SpmdReduce _) true]
          [(ast.AstExpr.SpmdScan _) true]
          [(ast.AstExpr.SpmdCompact _) true]
          [(ast.AstExpr.WithResource _) true]
          [(ast.AstExpr.ForOwnedState _) true]
          [(ast.AstExpr.ForOwnedStep _) true]
          [_
            (tc-selected-writes-root-children?
              ctx
              env
              (ast.ast-expr-child-ids (tc-context-expr-get ctx expr-id))
              0
              root
              global?
              budget)]))]))

(define (tc-selected-writes-root-children?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [children : ast.AstExprList]
  [index : i64]
  [root : i64]
  [global? : bool]
  [budget : (&mut budget i64)]) : bool
  (if (>= index children.len)
    false
    (or
      (tc-selected-writes-root?
        ctx
        env
        (ast.ast-expr-list-get (& children) index -1)
        root
        global?
        budget)
      (tc-selected-writes-root-children?
        ctx
        env
        children
        (+ index 1)
        root
        global?
        budget))))

;; Whether the place at `place-box` is storage of `root` (a name that may
;; denote it, through inline projections).
(define (tc-selected-place-roots-at?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [place-box : i64]
  [root : i64]) : bool
  (match (tc-context-expr-get ctx place-box)
    [(or (ast.AstExpr.Spanned inner-box _) (ast.AstExpr.Ann inner-box _)
         (ast.AstExpr.Cast inner-box _) (ast.AstExpr.StructGet inner-box _)
         (ast.AstExpr.TupleRef inner-box _) (ast.AstExpr.ArrayRef inner-box _))
      (tc-selected-place-roots-at? ctx env inner-box root)]
    [(ast.AstExpr.Var name)
      (tc-selected-name-may-denote-root? ctx env name root)]
    [_ false]))

;; Whether `name` can denote the variable `root`: the same identity, or a
;; dotted local-field spelling whose leading segment may be `root`. Structural
;; (hygienic) identities are not decomposed and conservatively match.
(define (tc-selected-name-may-denote-root?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [root : i64]) : bool
  (if (= name root)
    true
    (let
      [capacity : i64 (ci.intern-capacity)]
      (if (and (>= name 0) (< name capacity))
        (and
          (tc-dotted-local-field-name-id? env name)
          (or
            (not (and (>= root 0) (< root capacity)))
            (= (ci.intern-leading-dot-id name) root)))
        (>=
          (tc-dotted-name-first-dot-id (tc-context-structural-session ctx) name)
          0)))))

;; An extern function: a fixed parameter list, or a C variadic one whose call
;; is checked against its signature expanded to the call's arity
;; (`tc-selected-foreign-call-type`).
(define (tc-selected-foreign-abi? [ctx : TcContext] [func : ast.AstExpr]) : bool
  (match (tc-call-extern-abi ctx func)
    [(TcMaybeExternAbi.Some abi)
      (match abi
        [(ast.AstExternAbi.C) true]
        [(ast.AstExternAbi.TypeLisp) true]
        [(ast.AstExternAbi.CVarargsOpen) true]
        [(ast.AstExternAbi.CVarargsTyped _) true]
        [_ false])]
    [(TcMaybeExternAbi.No) false]))

;; The signature a call to extern `func` passes its arguments through: a C
;; variadic extern's fixed parameters, then each trailing argument at the
;; declared tail type (`...T`), or at its own type for an open tail (`...`).
;; C varargs pass values; the call reads each one like a fixed argument.
;; The argument list of a call expression (empty for any other form).
(define (tc-selected-call-args [ctx : TcContext] [call : ast.AstExpr]) : ast.AstExprList
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-bases ctx)
    call)
    [(ast.AstExpr.Call _ args) args]
    [(ast.AstExpr.MacroExpansion expanded _ _)
      (tc-selected-call-args ctx (tc-context-expr-get ctx expanded))]
    [_ (ast.ast-expr-list-new)]))

(define (tc-selected-foreign-call-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [fn-ty : ast.AstType]
  [args : (& args ast.AstExprList)]) : ast.AstType
  (let
    [abi : ast.AstExternAbi
      (match (tc-call-extern-abi ctx func)
        [(TcMaybeExternAbi.Some found) found]
        [(TcMaybeExternAbi.No) ast.AstExternAbi.C])]
    [open? : bool
      (match (& abi)
        [(ast.AstExternAbi.CVarargsOpen) true]
        [_ false])]
    [typed? : bool
      (match (& abi)
        [(ast.AstExternAbi.CVarargsTyped _) true]
        [_ false])]
    (if (not (or open? typed?))
      fn-ty
      (match (tc-global-shared-view fn-ty)
        [(ast.AstType.Func params-box ret)
          (let
            [params : ast.AstTypeList
              (ast.ast-type-list-box-shared-view params-box)]
            [tail-ty : ast.AstType
              (match abi
                [(ast.AstExternAbi.CVarargsTyped ty) ty]
                [_ ast.AstType.Never])]
            [expanded : ast.AstTypeList (ast.ast-type-list-new)]
            [index : i64 0]
            (while (< index args.len)
              (begin
                (ast.ast-type-list-push
                  (&mut expanded)
                  (if (< index (ast.ast-type-list-len (& params)))
                    (ast.ast-type-list-get
                      (& params)
                      index
                      (ast.ast-type-id-fallback))
                    (ast.ty-node-push
                      (&
                        (if open?
                          (match (tc-expr-id
                            ctx
                            env
                            (ast.ast-expr-list-get args index 0))
                            [(ResultTcType.Ok ty) ty]
                            [(ResultTcType.Err _) ast.AstType.Never])
                          (tc-global-shared-view tail-ty))))))
                (set! index (+ index 1))))
            (ast.ast-ty-func expanded (& (ast.ty-node-get ret))))]
        [_ fn-ty]))))

;; An extern signature the call slice records: value or reference parameters
;; (a reference argument is lent for the call) and a value result.
(define (tc-selected-foreign-signature-ok?
  [ctx : TcContext]
  [fn-ty : ast.AstType]
  [arg-count : i64]) : bool
  (match fn-ty
    [(ast.AstType.Func params-box ret)
      (let
        [params : ast.AstTypeList
          (ast.ast-type-list-box-shared-view params-box)]
        [index : i64 0]
        [ok? : bool
          (and
            (= (ast.ast-type-list-len (& params)) arg-count)
            (tc-selected-call-type-ok? ctx (ast.ty-node-get ret))
            ;; As for an ordinary call: no argument's loan can flow into
            ;; another (a reference stored through a `&mut` parameter).
            (tc-selected-call-lifetimes-separate? ctx (& params)))]
        (while (and ok? (< index arg-count))
          (set!
            ok?
            (tc-selected-call-param-type-ok?
              ctx
              (ast.ty-node-get
                (ast.ast-type-list-get
                  (& params)
                  index
                  (ast.ast-type-id-fallback)))))
          (set! index (+ index 1)))
        ok?)]
    [_ false]))

;; An extern signature taking references and Copy values and returning a
;; value or a reference: nothing moves into the call (SPEC 4.3), and a
;; returned reference borrows from the operands its lifetime names, which the
;; ordinary call route tracks.
(define (tc-selected-foreign-view-signature-ok?
  [ctx : TcContext]
  [fn-ty : ast.AstType]
  [arg-count : i64]) : bool
  (match fn-ty
    [(ast.AstType.Func params-box ret)
      (let
        [params : ast.AstTypeList
          (ast.ast-type-list-box-shared-view params-box)]
        [index : i64 0]
        [ok? : bool
          (and
            (= (ast.ast-type-list-len (& params)) arg-count)
            (tc-selected-call-param-type-ok? ctx (ast.ty-node-get ret))
            (tc-selected-call-lifetimes-separate? ctx (& params)))]
        (while (and ok? (< index arg-count))
          (let
            [param : ast.AstType
              (ast.ty-node-get
                (ast.ast-type-list-get
                  (& params)
                  index
                  (ast.ast-type-id-fallback)))]
            (set!
              ok?
              (or
                (>
                  (tc-selected-reference-kind
                    ctx
                    (tc-resolve-type ctx (tc-global-shared-view param)))
                  0)
                (and
                  (tc-selected-call-type-ok? ctx (tc-global-shared-view param))
                  (tc-type-copyable? ctx (tc-global-shared-view param)))))
            (set! index (+ index 1))))
        ok?)]
    [_ false]))

(define (tc-selected-call-target
  [ctx : TcContext]
  [env : TcTypeEnv]
  [call : ast.AstExpr]
  [func-id : i64]
  [arg-count : i64]) : TcSelectedCallTarget
  (let
    [func : ast.AstExpr (tc-context-expr-get ctx func-id)]
    (match (ast.ast-expr-unspan (& func))
      [(ast.AstExpr.Var raw-name)
        ;; The builtin dispatch is a pure lookup of the name in this scope:
        ;; every test below reads its one answer.
        (let
          [builtin : TcCallBuiltinName
            (tc-call-builtin-name ctx env raw-name arg-count)]
          (if (or
            (tc-selected-call-constructor? ctx env raw-name (& builtin))
            (tc-selected-call-variant-value? ctx env raw-name func-id))
            (tc-selected-constructor-target ctx env call func-id arg-count)
            (let
              [arm : i64 builtin.arm]
              (cond
                [(tc-selected-read-builtin-arm? arm)
                  (TcSelectedCallTarget.Builtin arm)]
                [(and (>= arm 9) (<= arm 12))
                  (TcSelectedCallTarget.ArenaForm arm)]
                [(= arm 4)
                  (TcSelectedCallTarget.SliceView
                    (tc-slice-call-mutable? builtin.slice-call-kind))]
                [(= arm 3)
                  (TcSelectedCallTarget.SliceSplit
                    (tc-slice-call-mutable? builtin.slice-call-kind))]
                [(not (tc-selected-call-name-ordinary? ctx (& builtin)))
                  TcSelectedCallTarget.Legacy]
                ;; The safe spawn takes one nullary task; the raw two-argument
                ;; `thread.spawn` adapter is an ordinary (unsafe) call.
                [(and
                    (= arg-count 1)
                    (tc-selected-safe-spawn-call? ctx env func-id))
                  TcSelectedCallTarget.Spawn]
                ;; The definition or extern this name denotes, looked up once
                ;; (-1: none, a call through a value).
                [else
                  (let
                    [declared : i64
                      (tc-selected-call-declared-function ctx env raw-name)]
                    (cond
                      [(< declared 0)
                        (tc-selected-indirect-target ctx env func-id)]
                      [(tc-selected-foreign-abi?
                          ctx
                          (tc-global-shared-view func))
                        (match (tc-call-target-expr-id ctx env func-id)
                          [(ResultTcType.Err message)
                            (TcSelectedCallTarget.Err message)]
                          [(ResultTcType.Ok declared-ty)
                            (let
                              [call-args : ast.AstExprList
                                (tc-selected-call-args
                                  ctx
                                  (tc-global-shared-view call))]
                              [fn-ty : ast.AstType
                                (tc-selected-foreign-call-type
                                  ctx
                                  env
                                  (tc-global-shared-view func)
                                  declared-ty
                                  (& call-args))]
                              (cond
                                [(tc-selected-foreign-signature-ok?
                                    ctx
                                    (tc-global-shared-view fn-ty)
                                    arg-count)
                                  (TcSelectedCallTarget.Foreign declared fn-ty)]
                                ;; An extern view constructor (`tl_str_view`):
                                ;; its result borrows from its reference
                                ;; operands, as an ordinary call's does
                                ;; through the signature's lifetimes.
                                [(tc-selected-foreign-view-signature-ok?
                                    ctx
                                    (tc-global-shared-view fn-ty)
                                    arg-count)
                                  (TcSelectedCallTarget.Ordinary
                                    declared
                                    fn-ty
                                    (tc-call-region-args-allowed-for-func
                                      ctx
                                      env
                                      (tc-global-shared-view func)))]
                                [else TcSelectedCallTarget.Legacy]))])]
                      [else
                        (match (tc-direct-lambda-check
                          ctx
                          env
                          (tc-global-shared-view func))
                          [(TcDirectLambdaCheck.No)
                            (match (tc-call-target-expr-id ctx env func-id)
                              [(ResultTcType.Err message)
                                (TcSelectedCallTarget.Err message)]
                              [(ResultTcType.Ok fn-ty)
                                (match (tc-global-shared-view fn-ty)
                                  [(ast.AstType.Func params ret)
                                    (if (tc-selected-call-signature-ok?
                                      ctx
                                      env
                                      (tc-global-shared-view func)
                                      (ast.ast-type-list-box-shared-view params)
                                      (ast.ty-node-get ret))
                                      (TcSelectedCallTarget.Ordinary
                                        declared
                                        fn-ty
                                        (tc-call-region-args-allowed-for-func
                                          ctx
                                          env
                                          (tc-global-shared-view func)))
                                      TcSelectedCallTarget.Legacy)]
                                  ;; A declared C function pointer value (an
                                  ;; extern `CFunc` global) is called through
                                  ;; its value.
                                  [_
                                    (match (tc-selected-c-function-signature
                                      ctx
                                      env
                                      (tc-global-shared-view fn-ty))
                                      [(ast.AstMaybeType.Some _)
                                        (tc-selected-indirect-target
                                          ctx
                                          env
                                          func-id)]
                                      [(ast.AstMaybeType.No)
                                        TcSelectedCallTarget.Legacy])])])]
                          [_ TcSelectedCallTarget.Legacy])]))]))))]
      ;; A callee that is an expression (an immediately called lambda, a
      ;; function value read from a place) is a call through its value.
      [_ (tc-selected-indirect-target ctx env func-id)])))

;; A call of its argument type's declared cleanup function: it discharges a
;; `let` owner's cleanup obligation (as the legacy cleanup checker decides).
(define (tc-selected-discharge-call?
  [ctx : TcContext]
  [func : ast.AstExpr]
  [params : (& params ast.AstTypeList)]) : bool
  (let
    [callee-id : i64
      (tc-expr-var-name-id (tc-context-expr-segment-bases ctx) func)]
    (and
      (= (ast.ast-type-list-len params) 1)
      (>= callee-id 0)
      (let
        [callee : i64 (tc-move-value-symbol-handle-id ctx callee-id)]
        (and
          (csym.compiler-symbols-handle-found? callee)
          (=
            callee
            (tc-move-declared-cleanup-handle
              ctx
              (tc-context-type-get
                ctx
                (ast.ast-type-list-get params 0 (ast.ast-type-id-fallback))))))))))

;; A safe thread spawn (SPEC threads): legacy typing checks the call, its
;; direct nullary lambda and the captures it may send, and tags the result
;; with the atomic arena regions the captures hold (the thread handle must be
;; joined before those arenas are released). The closure's environment moves
;; into the new thread (form 136) rather than being coerced to the task's
;; function type.
(define (tc-infer-selected-spawn
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [func-id : i64]
  [args : (& args ast.AstExprList)]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-legacy ctx env expr syntax expected)
    [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcType.Ok ty)
      (let
        [arg-id : i64 (ast.ast-expr-list-get args 0 0)]
        [task : ast.AstType
          (match (tc-call-target-expr-id ctx env func-id)
            [(ResultTcType.Ok fn-ty)
              (match (tc-type-strip-region fn-ty)
                [(ast.AstType.Func params _)
                  (let
                    [list : ast.AstTypeList
                      (ast.ast-type-list-box-shared-view params)]
                    (ast.ty-node-get
                      (ast.ast-type-list-get
                        (& list)
                        0
                        (ast.ast-type-id-fallback))))]
                [_ ast.AstType.Never])]
            [(ResultTcType.Err _) ast.AstType.Never])]
        (match (& task)
          [(ast.AstType.Func _ _)
            (match (tc-infer-selected-direct-closure
              ctx
              env
              arg-id
              (ResultTcType.Ok task)
              (ownership.ownership-source-copy (& source))
              sink)
              [(TcSelectedResult.Err message next)
                (TcSelectedResult.Err message next)]
              [(TcSelectedResult.Ok _ closure next)
                (match closure
                  [(TcSelectedOccurrence.Unrepresented)
                    (tc-selected-unrepresented (ResultTcType.Ok ty) next)]
                  [(TcSelectedOccurrence.Selected child)
                    (tc-selected-publish
                      (ResultTcType.Ok ty)
                      syntax
                      source
                      (typed.TypedOperation.Primitive
                        (typed.TypedPrimitive.Builtin
                          (tc-selected-form-code-spawn)
                          1))
                      (__tl_make-array child)
                      next)])])]
          [_ (tc-selected-unrepresented (ResultTcType.Ok ty) sink)]))]))

;; A safe thread spawn: its one operand, the task closure, moves into the
;; new thread.
(define (tc-selected-form-code-spawn) : i64
  136)

;; The children of a call through a function value: the callee, then the
;; operands. Other calls keep their operands alone.
(define (tc-selected-with-callee
  [operands : (__tl_dyn-array typed.TypedOccurrenceId)]
  [callee : (& callee TcSelectedOccurrence)]) : (__tl_dyn-array
    typed.TypedOccurrenceId)
  (match callee
    [(TcSelectedOccurrence.Selected id)
      (let
        [children : (__tl_dyn-array typed.TypedOccurrenceId)
          (__tl_make-array
            typed.TypedOccurrenceId
            (+ (array-length operands) 1))]
        [index : i64 0]
        (set!
          (array-ref children 0)
          (typed.TypedOccurrenceId (typed.typed-handle-copy (& id.handle))))
        (while (< index (array-length operands))
          (set!
            (array-ref children (+ index 1))
            (typed.TypedOccurrenceId
              (typed.typed-handle-copy (& (array-ref operands index).handle))))
          (set! index (+ index 1)))
        children)]
    [_ operands]))

;; A call through a function value (a parameter, local or field holding one):
;; the callee is read like any Copy operand, then the call proceeds as a
;; declared one against the value's signature. Key -2 marks it.
;; The `Func` signature of a C function pointer value a call may go through:
;; legacy `tc-call-c-function-type` rejects a nullable pointer, requires
;; `unsafe` for an unsafe one and checks the signature's C ABI first (those
;; diagnostics keep the legacy route).
(define (tc-selected-c-function-signature
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : ast.AstType]) : ast.AstMaybeType
  (match (tc-resolve-type ctx ty)
    [(ast.AstType.CFunc signature mode)
      (let
        [signature-type : ast.AstType (ast.ty-node-get signature)]
        (cond
          [(ast.ast-c-function-mode-nullable? mode) ast.AstMaybeType.No]
          [(match (if (ast.ast-c-function-mode-unsafe? mode)
              (tc-require-unsafe ctx env "C function pointer")
              ResultTcUnit.Ok)
              [(ResultTcUnit.Err _) true]
              [(ResultTcUnit.Ok) false])
            ast.AstMaybeType.No]
          [(match (tc-check-extern-c-abi
              ctx
              (tc-global-shared-view signature-type))
              [(ResultTcUnit.Err _) true]
              [(ResultTcUnit.Ok) false])
            ast.AstMaybeType.No]
          [else
            (match (& signature-type)
              [(ast.AstType.Func _ _) (ast.AstMaybeType.Some signature-type)]
              [_ ast.AstMaybeType.No])]))]
    [_ ast.AstMaybeType.No]))

(define (tc-selected-indirect-target
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]) : TcSelectedCallTarget
  (let
    [func : ast.AstExpr (tc-context-expr-get ctx func-id)]
    (match (tc-direct-lambda-check ctx env (tc-global-shared-view func))
      [(TcDirectLambdaCheck.No)
        (match (match (tc-call-target-expr-id ctx env func-id)
          [(ResultTcType.Ok callee-ty)
            (match (tc-selected-c-function-signature
              ctx
              env
              (tc-global-shared-view callee-ty))
              ;; A C function pointer value is called through the C ABI: a
              ;; foreign call, as a direct extern call is, whatever the
              ;; pointer's source (a global, parameter, local, field or any
              ;; other expression).
              [(ast.AstMaybeType.Some signature)
                (return
                  (if (tc-selected-foreign-signature-ok?
                    ctx
                    (tc-global-shared-view signature)
                    (match (& signature)
                      [(ast.AstType.Func params _)
                        (ast.ast-type-list-len params)]
                      [_ -1]))
                    (TcSelectedCallTarget.ForeignValue signature)
                    TcSelectedCallTarget.Legacy))]
              [(ast.AstMaybeType.No) (ResultTcType.Ok callee-ty)])]
          [(ResultTcType.Err message) (ResultTcType.Err message)])
          [(ResultTcType.Err _) TcSelectedCallTarget.Legacy]
          [(ResultTcType.Ok fn-ty)
            (match (tc-global-shared-view fn-ty)
              [(ast.AstType.Func params ret)
                (if (and
                  (tc-type-copyable? ctx (tc-global-shared-view fn-ty))
                  (tc-selected-call-signature-ok?
                    ctx
                    env
                    (tc-global-shared-view func)
                    (ast.ast-type-list-box-shared-view
                      (tc-global-shared-view params))
                    (ast.ty-node-get ret)))
                  (TcSelectedCallTarget.Ordinary
                    ;; A type's generated cleanup function is named directly:
                    ;; its symbol handle keys the call.
                    (if (let
                      [param-list : ast.AstTypeList
                        (ast.ast-type-list-box-shared-view
                          (tc-global-shared-view params))]
                      (tc-selected-discharge-call?
                        ctx
                        (tc-global-shared-view func)
                        (& param-list)))
                      (tc-move-value-symbol-handle-id
                        ctx
                        (tc-expr-var-name-id
                          (tc-context-expr-segment-bases ctx)
                          (tc-global-shared-view func)))
                      -2)
                    fn-ty
                    (tc-call-region-args-allowed-for-func
                      ctx
                      env
                      (tc-global-shared-view func)))
                  TcSelectedCallTarget.Legacy)]
              [_ TcSelectedCallTarget.Legacy])])]
      ;; An immediately called lambda (typed as a direct call, where its
      ;; reference captures cannot escape) is called through its closure.
      [(TcDirectLambdaCheck.Ok fn-ty)
        (match (tc-global-shared-view fn-ty)
          [(ast.AstType.Func params ret)
            (if (tc-selected-call-signature-ok?
              ctx
              env
              (tc-global-shared-view func)
              (ast.ast-type-list-box-shared-view (tc-global-shared-view params))
              (ast.ty-node-get ret))
              (TcSelectedCallTarget.Ordinary -2 fn-ty false)
              TcSelectedCallTarget.Legacy)]
          [_ TcSelectedCallTarget.Legacy])]
      [(TcDirectLambdaCheck.Err message) (TcSelectedCallTarget.Err message)])))

;; Mirrors `tc-check-call-args-with-message-at` for a signature without
;; reference parameters: the effective argument is the argument itself, and
;; each argument is inferred once against its parameter type. After the first
;; unrepresented argument the rest are inferred without publication.
;; The synthesized borrow of an auto-borrowed argument (the legacy effective
;; argument is a fresh Borrow node while the source argument is not a borrow).
(defenum TcSelectedAutoBorrow
  (Some i64 i64)
  (No))

(define (tc-selected-auto-borrow
  [arg : ast.AstExpr]
  [effective : (& effective ast.AstExpr)]) : TcSelectedAutoBorrow
  (match (ast.ast-expr-unspan arg)
    [(ast.AstExpr.Borrow _ _ _) TcSelectedAutoBorrow.No]
    [_
      (match effective
        [(ast.AstExpr.Borrow false lifetime-id place-id)
          (TcSelectedAutoBorrow.Some lifetime-id place-id)]
        [_ TcSelectedAutoBorrow.No])]))

;; Argument 0 of a raw `thread.spawn` call (its entry) as a direct lambda.
;; The adapter is unsafe, so the call sits in an `unsafe` context; the thread
;; name test goes by spelling, so this also keeps a safe function that is
;; merely named `spawn` out of the exemption.
(define (tc-selected-raw-spawn-entry?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : (& args ast.AstExprList)]
  [params : (& params ast.AstTypeList)]
  [index : i64]) : bool
  (and
    (= index 0)
    (tc-in-unsafe? env)
    (= args.len 2)
    (= (ast.ast-type-list-len params) 2)
    (match (ast.ast-expr-unspan
      (& (tc-context-expr-get ctx (ast.ast-expr-list-get args 0 0))))
      [(ast.AstExpr.Lambda _) true]
      [_ false])
    (match (tc-thread-safe-spawn-call-name ctx env func)
      [(TcMaybeString.Some _) true]
      [(TcMaybeString.No) false])))

;; The entry lambda of a raw `thread.spawn` call, coerced to the entry's
;; function type like any lambda argument, except that an atomic arena owner
;; it captures stays usable (legacy typing has the same exemption). The
;; unsafe caller must join the thread before releasing that owner.
(define (tc-infer-selected-spawn-entry
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg-id : i64]
  [want : ast.AstType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-expr-with-expected-or-actual-id
    ctx
    env
    arg-id
    (tc-global-shared-view want))
    [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcType.Ok ty)
      (match (tc-context-expr-get ctx arg-id)
        [(ast.AstExpr.Spanned inner-id span)
          (match (tc-context-expr-get ctx inner-id)
            [(ast.AstExpr.Lambda lambda-box)
              (tc-infer-selected-closure
                ctx
                env
                lambda-box
                ty
                true
                (typed.TypedSyntax.Source inner-id)
                (ownership.OwnershipSource
                  source.path
                  (tc-selected-span-line source.line span)
                  (tc-selected-span-column source.column span)
                  source.expansion)
                sink)]
            [_ (tc-selected-unrepresented (ResultTcType.Ok ty) sink)])]
        [(ast.AstExpr.Lambda lambda-box)
          (tc-infer-selected-closure
            ctx
            env
            lambda-box
            ty
            true
            (typed.TypedSyntax.Source arg-id)
            source
            sink)]
        [_ (tc-selected-unrepresented (ResultTcType.Ok ty) sink)])]))

;; A call argument `(& operand)` or `(&mut operand)` whose operand names no
;; place (section 3.10): the operand's value is held in a call temporary that
;; lives until the call returns, and the argument borrows it with the
;; call-temporary lifetime. The temporary is a Temporary binder, as for a
;; projection out of a value; the call's escape check keeps the loan inside
;; the call.
(define (tc-infer-selected-temporary-borrow-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg-id : i64]
  [want : ast.AstType]
  [source : ownership.OwnershipSource]
  [represented? : bool]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    [arg : ast.AstExpr (tc-context-expr-get ctx arg-id)]
    [operand-id : i64
      (tc-call-temporary-borrow-operand-id
        (tc-context-expr-bases ctx)
        (tc-global-shared-view arg))]
    (match (tc-call-temporary-borrow-type
      ctx
      env
      (tc-global-shared-view arg)
      (tc-global-shared-view want))
      [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
      [(ResultTcType.Ok ty)
        (let
          [mutable : bool
            (match (tc-type-strip-region
              (tc-resolve-type ctx (tc-global-shared-view ty)))
              [(ast.AstType.MutRef _ _) true]
              [_ false])]
          (match sink
            [(TcSelectedSink.Query)
              (tc-selected-unrepresented
                (ResultTcType.Ok ty)
                TcSelectedSink.Query)]
            [(TcSelectedSink.Capture store lease bindings)
              (if (not represented?)
                (tc-selected-unrepresented
                  (ResultTcType.Ok ty)
                  (TcSelectedSink.Capture store lease bindings))
                (match (tc-infer-selected-id
                  ctx
                  env
                  operand-id
                  (tc-call-temporary-referent-hint
                    ctx
                    (tc-global-shared-view want)
                    (tc-context-expr-get ctx operand-id))
                  (tc-global-shared-view source)
                  (TcSelectedSink.Capture store lease bindings))
                  [(TcSelectedResult.Err message next)
                    (TcSelectedResult.Err message next)]
                  [(TcSelectedResult.Ok operand-ty operand next)
                    (match operand
                      [(TcSelectedOccurrence.Unrepresented)
                        (tc-selected-unrepresented (ResultTcType.Ok ty) next)]
                      [(TcSelectedOccurrence.Selected value)
                        (match next
                          [(TcSelectedSink.Query)
                            (tc-selected-unrepresented
                              (ResultTcType.Ok ty)
                              TcSelectedSink.Query)]
                          [(TcSelectedSink.Capture store2 lease2 bindings2)
                            (match (tc-selected-temporary-place!
                              operand-ty
                              value
                              (tc-global-shared-view source)
                              store2
                              lease2
                              bindings2)
                              [(TcSelectedPlaceResult.Err message after)
                                (TcSelectedResult.Err message after)]
                              [(TcSelectedPlaceResult.Ok _ place after)
                                (match place
                                  [(TcSelectedPlace.Selected id indices)
                                    (tc-selected-publish-borrow
                                      ty
                                      mutable
                                      id
                                      indices
                                      (typed.TypedSyntax.Source arg-id)
                                      source
                                      after)]
                                  [(TcSelectedPlace.Unrepresented)
                                    (tc-selected-unrepresented
                                      (ResultTcType.Ok ty)
                                      after)])])])])]))]))])))

;; A call rejected under its call-scoped substitution reports what
;; `tc-call-lifetime-function-type` does: the substitution inferred from the
;; arguments (declared lifetime names) gives the rejected call its diagnostic.
;; A rejection only the ownership graph sees keeps its own message.
(define (tc-selected-call-scoped-diagnostic
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [params : ast.AstTypeList]
  [lifetimes : ast.AstLifetimeList]
  [allow-region-args : bool]
  [message : String]) : String
  (match (tc-infer-call-lifetime-subst
    ctx
    env
    (tc-global-shared-view func)
    (tc-global-shared-view args)
    (tc-global-shared-view params)
    lifetimes
    TcLifetimeSubst.Nil)
    [(ResultTcLifetimeSubst.Err inferred) inferred]
    [(ResultTcLifetimeSubst.Ok subst)
      (match (tc-check-call-args
        ctx
        env
        func
        args
        (tc-lifetime-subst-type-list subst params)
        allow-region-args
        ast.AstMaybeType.No)
        [(ResultTcUnit.Err checked) checked]
        [(ResultTcUnit.Ok) message])]))

(define (tc-infer-selected-call-args
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : ast.AstExpr]
  [args : (& args ast.AstExprList)]
  [params : (& params ast.AstTypeList)]
  ;; Per parameter: whether the signature brands it with an arena
  ;; (`tc-selected-arena-branded-params`).
  [branded : (& branded (__tl_dyn-array bool))]
  [allow-region-args : bool]
  ;; A constructor's result: its arguments are stored into it.
  [constructor : ast.AstMaybeType]
  [arity-msg : TcArityMessage]
  [index : i64]
  [children : (__tl_dyn-array typed.TypedOccurrenceId)]
  [represented? : bool]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedArgsResult
    store
    lease
    intern
    bind)
  (if (or (>= index args.len) (>= index (ast.ast-type-list-len params)))
    (if (and (>= index args.len) (>= index (ast.ast-type-list-len params)))
      (TcSelectedArgsResult.Ok children represented? sink)
      (TcSelectedArgsResult.Err
        (tc-arity-message-text (tc-context-expr-segment-bases ctx) arity-msg)
        sink))
    (let
      [arg-id : i64 (ast.ast-expr-list-get args index 0)]
      [arg : ast.AstExpr (tc-context-expr-get ctx arg-id)]
      ;; As legacy argument checking: an `(:invalidate r T)` formal takes a `T`.
      [want : ast.AstType
        (tc-type-strip-invalidate
          (ast.ty-node-get
            (ast.ast-type-list-get params index (ast.ast-type-id-fallback))))]
      ;; The effective argument is the legacy one: an immutable reference
      ;; formal auto-borrows a plain place argument.
      (match (tc-call-effective-arg-expr
        ctx
        env
        arg-id
        (tc-global-shared-view arg)
        (tc-global-shared-view want))
        [(ResultTcExpr.Err message)
          (TcSelectedArgsResult.Err
            (tc-locate-error-at-expr (tc-context-expr-bases ctx) arg message)
            sink)]
        [(ResultTcExpr.Ok effective-arg)
          (match (if (tc-call-temporary-borrow-arg?
            (tc-context-expr-bases ctx)
            (tc-global-shared-view arg))
            (tc-infer-selected-temporary-borrow-arg
              ctx
              env
              arg-id
              (tc-global-shared-view want)
              (tc-global-shared-view source)
              represented?
              sink)
            (match (tc-selected-auto-borrow
              (tc-global-shared-view arg)
              (& effective-arg))
              [(TcSelectedAutoBorrow.Some lifetime-id place-id)
                (if represented?
                  (tc-infer-selected-borrow
                    ctx
                    env
                    false
                    lifetime-id
                    place-id
                    false
                    (typed.TypedSyntax.Source arg-id)
                    (tc-global-shared-view source)
                    sink)
                  (tc-selected-unrepresented
                    (tc-selected-project
                      (tc-infer-selected-borrow
                        ctx
                        env
                        false
                        lifetime-id
                        place-id
                        false
                        (typed.TypedSyntax.Source arg-id)
                        (tc-global-shared-view source)
                        TcSelectedSink.Query))
                    sink))]
              [(TcSelectedAutoBorrow.No)
                (match (tc-selected-mut-borrow-arg
                  ctx
                  (tc-global-shared-view arg))
                  [(TcSelectedMutBorrowArg.Some
                      inner-id
                      lifetime-id
                      place-id
                      span)
                    (tc-infer-selected-mut-borrow-arg
                      ctx
                      env
                      arg-id
                      inner-id
                      lifetime-id
                      place-id
                      span
                      (tc-global-shared-view source)
                      represented?
                      sink)]
                  [(TcSelectedMutBorrowArg.No)
                    (if (and
                      represented?
                      (tc-selected-raw-spawn-entry?
                        ctx
                        env
                        (tc-global-shared-view func)
                        args
                        params
                        index))
                      (tc-infer-selected-spawn-entry
                        ctx
                        env
                        arg-id
                        (tc-global-shared-view want)
                        (tc-global-shared-view source)
                        sink)
                      (if (and
                        (match (& constructor)
                          [(ast.AstMaybeType.No) true]
                          [(ast.AstMaybeType.Some _) false])
                        (tc-arena-type? ctx (tc-global-shared-view want))
                        (not
                          (tc-call-param-moves-argument?
                            ctx
                            (tc-global-shared-view want)))
                        (tc-selected-arena-handle-operand? ctx env arg-id))
                        ;; A bare `Arena` parameter reads an owner without
                        ;; moving it (`tc-call-param-moves-argument?`).
                        (match (tc-expr-with-expected-or-actual-id
                          ctx
                          env
                          arg-id
                          (tc-global-shared-view want))
                          [(ResultTcType.Err message)
                            (TcSelectedResult.Err message sink)]
                          [(ResultTcType.Ok got)
                            (if represented?
                              (tc-infer-selected-arena-handle
                                ctx
                                env
                                arg-id
                                got
                                (tc-global-shared-view source)
                                sink)
                              (tc-selected-unrepresented
                                (ResultTcType.Ok got)
                                sink))])
                        ;; A shared-reference formal borrows its argument for
                        ;; the call, so a compound one, or an element read
                        ;; through a temporary (no auto-borrowed place), is
                        ;; read as `clone` reads its operand
                        ;; (`tc-infer-selected-read`).
                        (let
                          [arg-source : ownership.OwnershipSource
                            (tc-global-shared-view source)]
                          [route : i64
                            (if represented?
                              (tc-selected-argument-route
                                ctx
                                env
                                arg-id
                                (& want))
                              0)]
                          (cond
                            [(= route 1)
                              (tc-infer-selected-read-operand
                                ctx
                                env
                                arg-id
                                arg-source
                                sink)]
                            ;; A move-only element keeps its own type, as a
                            ;; read spine's result does.
                            [(= route 2)
                              (match (tc-infer-selected-read-operand
                                ctx
                                env
                                arg-id
                                arg-source
                                sink)
                                [(TcSelectedResult.Ok ty occurrence next)
                                  (TcSelectedResult.Ok
                                    (match (tc-expr-id ctx env arg-id)
                                      [(ResultTcType.Ok own)
                                        (tc-selected-strip-regions own)]
                                      [(ResultTcType.Err _) ty])
                                    occurrence
                                    next)]
                                [(TcSelectedResult.Err message next)
                                  (TcSelectedResult.Err message next)])]
                            [(= route 3)
                              (tc-infer-selected-reborrow-arg
                                ctx
                                env
                                arg-id
                                arg-source
                                sink)]
                            [else
                              (tc-infer-selected-sequence-child
                                ctx
                                env
                                arg-id
                                (ast.AstMaybeType.Some
                                  (tc-global-shared-view want))
                                arg-source
                                represented?
                                sink)]))))])]))
            [(TcSelectedResult.Err message next)
              (TcSelectedArgsResult.Err message next)]
            [(TcSelectedResult.Ok got child next)
              (match (tc-match-call-type-for-expected
                ctx
                env
                (tc-global-shared-view got)
                (tc-global-shared-view want))
                [(TcInferredTypeMatch.Mismatch actual)
                  (TcSelectedArgsResult.Err
                    (tc-locate-error-at-expr
                      (tc-context-expr-bases ctx)
                      arg
                      (tc-type-mismatch-message-in-context
                        ctx
                        env
                        actual
                        (tc-global-shared-view want)
                        (tc-argument-message-prefix-text
                          ctx
                          (tc-global-shared-view arity-msg)
                          index)))
                    next)]
                [(TcInferredTypeMatch.Compatible _)
                  (if (and
                    (tc-type-contains-any-region (tc-global-shared-view got))
                    (not allow-region-args)
                    (not
                      (tc-type-contains-any-region (tc-global-shared-view want)))
                    (not
                      (tc-type-regions-all-atomic-arena-owners?
                        env
                        (tc-global-shared-view got)))
                    (not
                      (tc-type-regions-all-scratch? (tc-global-shared-view got)))
                    (not
                      (tc-type-contains-reference? (tc-global-shared-view got))))
                    (TcSelectedArgsResult.Err
                      (tc-region-call-arg-error
                        (tc-context-expr-bases ctx)
                        (tc-global-shared-view effective-arg))
                      next)
                    (let
                      [stored : ResultTcUnit
                        (match (tc-global-shared-view constructor)
                          [(ast.AstMaybeType.No) ResultTcUnit.Ok]
                          [(ast.AstMaybeType.Some target)
                            (match (tc-ensure-cleanup-resource-not-stored-expr
                              ctx
                              env
                              (tc-global-shared-view effective-arg))
                              [(ResultTcUnit.Ok)
                                (tc-ensure-region-value-can-flow-into
                                  env
                                  target
                                  (tc-global-shared-view got)
                                  "constructor result")]
                              [(ResultTcUnit.Err message)
                                (ResultTcUnit.Err message)])])]
                      [selected? : bool
                        (match child
                          [(TcSelectedOccurrence.Selected id)
                            (set! (array-ref children index) id)
                            true]
                          [(TcSelectedOccurrence.Unrepresented) false])]
                      (match stored
                        [(ResultTcUnit.Err message)
                          (TcSelectedArgsResult.Err message next)]
                        [(ResultTcUnit.Ok)
                          (tc-infer-selected-call-args
                            ctx
                            env
                            func
                            args
                            params
                            branded
                            allow-region-args
                            constructor
                            arity-msg
                            (+ index 1)
                            children
                            (and
                              represented?
                              selected?
                              (or
                                (>= index (array-length branded))
                                (not (array-ref branded index))
                                (tc-selected-arena-brand-exact?
                                  (tc-global-shared-view got)
                                  (tc-global-shared-view want))))
                            source
                            next)])))])])]))))

;; The region tags (`(in r T)`) anywhere in a type.
(define (tc-selected-region-tags-into [ty : ast.AstType] [out : TcNameIdList]) : TcNameIdList
  (match ty
    [(ast.AstType.Region region inner)
      (tc-selected-region-tags-into
        (ast.ty-node-get inner)
        (tc-name-id-list-add out region))]
    [(ast.AstType.Tuple elems)
      (let
        [list : ast.AstTypeList (ast.ast-type-list-box-shared-view elems)]
        [index : i64 0]
        [acc : TcNameIdList out]
        (while (< index (ast.ast-type-list-len (& list)))
          (set!
            acc
            (tc-selected-region-tags-into
              (ast.ty-node-get
                (ast.ast-type-list-get
                  (& list)
                  index
                  (ast.ast-type-id-fallback)))
              acc))
          (set! index (+ index 1)))
        acc)]
    [(or (ast.AstType.Array elem _) (ast.AstType.DynArray elem)
         (ast.AstType.Slice elem) (ast.AstType.Box elem) (ast.AstType.Ptr elem)
         (ast.AstType.MutPtr elem))
      (tc-selected-region-tags-into (ast.ty-node-get elem) out)]
    [(or (ast.AstType.Ref _ inner) (ast.AstType.MutRef _ inner)
         (ast.AstType.Invalidate _ inner))
      (tc-selected-region-tags-into (ast.ty-node-get inner) out)]
    [_ out]))

;; Per parameter of a signature: whether it is tagged with one of the
;; signature's arena brands (`tc-selected-signature-arena-regions`).
(define (tc-selected-arena-branded-params
  [ctx : TcContext]
  [params : (& params ast.AstTypeList)]) : (__tl_dyn-array bool)
  (let
    [regions : (__tl_dyn-array i64)
      (tc-selected-signature-arena-regions ctx params)]
    [count : i64 (ast.ast-type-list-len params)]
    [out : (__tl_dyn-array bool) (__tl_make-array bool count)]
    [index : i64 0]
    (while (< index count)
      (let
        [tags : TcNameIdList
          (tc-selected-region-tags-into
            (tc-type-strip-invalidate
              (tc-resolve-type
                ctx
                (ast.ty-node-get
                  (ast.ast-type-list-get
                    params
                    index
                    (ast.ast-type-id-fallback)))))
            TcNameIdList.Nil)]
        [found : bool false]
        (while (and (not found) (not (tc-name-id-list-empty? tags)))
          (when
            (tc-selected-i64-member? (& regions) (tc-name-id-list-head tags))
            (set! found true))
          (set! tags (tc-name-id-list-rest tags)))
        (set! (array-ref out index) found))
      (set! index (+ index 1)))
    out))

;; A call represents an argument for a parameter it brands with an arena
;; (`tc-selected-arena-branded-params`) only when the argument carries no
;; other brand than the parameter's (`want`, instantiated). Typing lets a value
;; of an outer arena flow into an inner arena's brand, but the call's result
;; and stores then name the inner brand alone, and destroying the outer arena
;; would not end them: the graph sees arena values only through their brands.
(define (tc-selected-arena-brand-exact?
  [got : ast.AstType]
  [want : ast.AstType]) : bool
  (let
    [wanted : TcNameIdList (tc-selected-region-tags-into want TcNameIdList.Nil)]
    [cursor : TcNameIdList (tc-selected-region-tags-into got TcNameIdList.Nil)]
    [exact? : bool true]
    (unless
      (tc-name-id-list-empty? wanted)
      (while (and exact? (not (tc-name-id-list-empty? cursor)))
        (unless
          (tc-name-id-list-contains wanted (tc-name-id-list-head cursor))
          (set! exact? false))
        (set! cursor (tc-name-id-list-rest cursor))))
    exact?))

(define (tc-selected-publish-call
  [result : ResultTcType]
  [kind : typed.TypedCallKind]
  [signature : ast.AstType]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [children : (__tl_dyn-array typed.TypedOccurrenceId)]
  [represented? : bool]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (if (not represented?)
    (tc-selected-unrepresented result sink)
    (match sink
      [(TcSelectedSink.Query)
        (tc-selected-unrepresented result TcSelectedSink.Query)]
      [(TcSelectedSink.Capture store lease bindings)
        (match (typed.typed-charge!
          store
          lease
          (*
            (array-length children)
            (comptime (size-of (type typed.TypedOccurrenceId)))))
          [(typed.TypedResult.Err error)
            (TcSelectedResult.Err
              (tc-selected-error error)
              (TcSelectedSink.Capture store lease bindings))]
          [(typed.TypedResult.Ok _)
            (match (typed.typed-type-add! store lease signature)
              [(typed.TypedTypeIdResult.Err error)
                (TcSelectedResult.Err
                  (tc-selected-error error)
                  (TcSelectedSink.Capture store lease bindings))]
              [(typed.TypedTypeIdResult.Ok signature-id)
                (match (let
                  ;; A call through a value retains its callee as child 0.
                  [callee-children : i64
                    (match (& kind)
                      [(typed.TypedCallKind.Indirect _) 1]
                      [_ 0])]
                  (typed.typed-call-add!
                    store
                    lease
                    signature-id
                    kind
                    (- (array-length children) callee-children)))
                  [(typed.TypedCallResult.Err error)
                    (TcSelectedResult.Err
                      (tc-selected-error error)
                      (TcSelectedSink.Capture store lease bindings))]
                  [(typed.TypedCallResult.Ok call)
                    (tc-selected-publish
                      result
                      syntax
                      source
                      (typed.TypedOperation.Call call)
                      children
                      (TcSelectedSink.Capture store lease bindings))])])])])))

(define (tc-infer-selected-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [func-id : i64]
  [args : ast.AstExprList]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  ;; In an expected-enum position a bare variant callee names the expected
  ;; enum's variant; the callee node is retargeted before the call's target is
  ;; resolved, as legacy typing does.
  (match (tc-selected-expected-call-variant-retarget!
    ctx
    env
    func-id
    (tc-global-shared-view expected))
    [(ResultTcUnit.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcUnit.Ok)
      (tc-infer-selected-call-resolved
        ctx
        env
        expr
        func-id
        args
        syntax
        expected
        source
        sink)]))

(define (tc-selected-expected-call-variant-retarget!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]
  [expected : ast.AstMaybeType]) : ResultTcUnit
  (match expected
    [(ast.AstMaybeType.No) ResultTcUnit.Ok]
    [(ast.AstMaybeType.Some want)
      (tc-expected-call-variant-retarget! ctx env func-id want)]))

;; A bare variant read in an expected-enum position names the expected enum's
;; variant (the source node is retargeted, as legacy typing does).
(define (tc-selected-expected-var-retarget!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [syntax : typed.TypedSyntax]
  [name : i64]
  [expected : ast.AstMaybeType]) : ResultTcNameId
  (match syntax
    [(typed.TypedSyntax.Generated) (ResultTcNameId.Ok name)]
    [(typed.TypedSyntax.Source id)
      (match expected
        [(ast.AstMaybeType.No) (ResultTcNameId.Ok name)]
        [(ast.AstMaybeType.Some want)
          (if (tc-bare-variant-name-gate? ctx name)
            (tc-expected-bare-variant-retarget!
              ctx
              env
              id
              name
              (tc-global-shared-view want))
            (ResultTcNameId.Ok name))])]))

(define (tc-infer-selected-call-resolved
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [func-id : i64]
  [args : ast.AstExprList]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-selected-call-target
    ctx
    env
    (tc-global-shared-view expr)
    func-id
    args.len)
    [(TcSelectedCallTarget.Legacy)
      (tc-selected-unrepresented
        (tc-infer-selected-legacy ctx env expr syntax expected)
        sink)]
    [(TcSelectedCallTarget.Err message) (TcSelectedResult.Err message sink)]
    [(TcSelectedCallTarget.Builtin arm)
      (tc-infer-selected-builtin
        ctx
        env
        expr
        arm
        (& args)
        syntax
        expected
        source
        sink)]
    [(TcSelectedCallTarget.ArenaForm arm)
      (tc-infer-selected-arena-call
        ctx
        env
        expr
        func-id
        arm
        (& args)
        syntax
        expected
        source
        sink)]
    [(TcSelectedCallTarget.Spawn)
      (tc-infer-selected-spawn
        ctx
        env
        expr
        func-id
        (& args)
        syntax
        expected
        source
        sink)]
    [(TcSelectedCallTarget.SliceSplit mutable?)
      (tc-infer-selected-slice-split
        ctx
        env
        expr
        mutable?
        (& args)
        syntax
        expected
        source
        sink)]
    [(TcSelectedCallTarget.SliceView mutable?)
      (tc-infer-selected-slice-view
        ctx
        env
        expr
        mutable?
        (& args)
        syntax
        expected
        source
        sink)]
    [(TcSelectedCallTarget.ForeignValue fn-ty)
      (tc-infer-selected-foreign-value-call
        ctx
        env
        expr
        func-id
        fn-ty
        (& args)
        syntax
        expected
        source
        sink)]
    [(TcSelectedCallTarget.Foreign key fn-ty)
      (tc-infer-selected-foreign-call
        ctx
        env
        expr
        key
        fn-ty
        (& args)
        syntax
        expected
        source
        sink)]
    [(TcSelectedCallTarget.Ordinary key fn-ty allow-region-args)
      (match (tc-normalize-dotted-local-field-expr-list! ctx env args)
        [(ResultTcUnit.Err message) (TcSelectedResult.Err message sink)]
        [(ResultTcUnit.Ok)
          (match (tc-global-shared-view fn-ty)
            [(ast.AstType.Func params-box ret-id)
              (let
                [declared-params : ast.AstTypeList
                  (ast.ast-type-list-box-shared-view params-box)]
                [declared-ret : ast.AstType (ast.ty-node-get ret-id)]
                [func : ast.AstExpr (tc-context-expr-get ctx func-id)]
                [collected : TcNameIdList
                  (tc-type-collect-reference-lifetimes-into
                    (tc-global-shared-view declared-ret)
                    (tc-type-list-collect-reference-lifetimes
                      (tc-global-shared-view declared-params)
                      TcNameIdList.Nil))]
                ;; A declared callee's parameter spelled `program` names its
                ;; own lifetime there (`tc-call-program-shadow`); a
                ;; constructor's fields cannot.
                [shadow : i64
                  (if (and
                    (>= key 0)
                    (tc-name-id-list-spells-program? collected))
                    (tc-call-program-shadow
                      ctx
                      key
                      (ast.ast-type-list-len (& declared-params)))
                    -1)]
                ;; A call never instantiates the reserved `program` lifetime,
                ;; which outlives every other as Rust's `'static` does: a
                ;; `program` parameter or field takes only a `program`
                ;; reference (`tc-call-lifetime-constructor-type`).
                [lifetimes : ast.AstLifetimeList
                  (tc-name-id-list-to-lifetime-list
                    (if (< shadow 0)
                      (tc-name-id-list-without-program collected)
                      collected))]
                ;; A lifetime that only says how long the call borrows its
                ;; argument is the call-temporary lifetime: the call infers
                ;; nothing from it (`tc-call-lifetime-function-type`).
                [call-scoped? : bool
                  (and
                    (not (ast.ast-lifetime-list-empty? (& lifetimes)))
                    (!= key -1)
                    (tc-call-lifetimes-call-scoped?
                      ctx
                      (& declared-params)
                      (tc-global-shared-view declared-ret)
                      (& lifetimes)))]
                ;; Like `tc-call-lifetime-function-type`: the callee's lifetimes
                ;; are instantiated from the arguments before they are checked.
                [subst : TcLifetimeSubst
                  (cond
                    [(ast.ast-lifetime-list-empty? (& lifetimes))
                      TcLifetimeSubst.Nil]
                    [call-scoped? (tc-call-scoped-lifetime-subst (& lifetimes))]
                    [else
                      (match (tc-infer-call-lifetime-subst
                        ctx
                        env
                        (tc-global-shared-view func)
                        (tc-global-shared-view args)
                        (tc-global-shared-view declared-params)
                        (tc-global-shared-view lifetimes)
                        TcLifetimeSubst.Nil)
                        [(ResultTcLifetimeSubst.Ok found) found]
                        [(ResultTcLifetimeSubst.Err message)
                          (return (TcSelectedResult.Err message sink))])])]
                [_escape : unit
                  (match (tc-check-by-value-borrow-escape
                    ctx
                    env
                    (& args)
                    (& declared-params)
                    (tc-global-shared-view declared-ret))
                    [(ResultTcUnit.Ok) unit]
                    [(ResultTcUnit.Err message)
                      (return (TcSelectedResult.Err message sink))])]
                ;; No borrowed call temporary may outlive the call (section
                ;; 3.10).
                [_temporaries : unit
                  (match (tc-check-call-temporary-borrows
                    ctx
                    env
                    (& args)
                    (& declared-params)
                    (tc-global-shared-view declared-ret))
                    [(ResultTcUnit.Ok) unit]
                    [(ResultTcUnit.Err message)
                      (return (TcSelectedResult.Err message sink))])]
                [declared-view : ast.AstTypeList
                  (tc-global-shared-view declared-params)]
                [branded : (__tl_dyn-array bool)
                  (tc-selected-arena-branded-params ctx (& declared-params))]
                [params : ast.AstTypeList
                  (if (ast.ast-lifetime-list-empty? (& lifetimes))
                    declared-params
                    (tc-lifetime-subst-type-list
                      (tc-global-shared-view subst)
                      declared-params))]
                [ret : ast.AstType
                  (if (ast.ast-lifetime-list-empty? (& lifetimes))
                    declared-ret
                    (tc-lifetime-subst-type subst declared-ret))]
                [children : (__tl_dyn-array typed.TypedOccurrenceId)
                  (__tl_make-array typed.TypedOccurrenceId args.len)]
                ;; A call through a function value reads the callee first.
                (match (if (= key -2)
                  (tc-infer-selected-callee
                    ctx
                    env
                    func-id
                    (tc-global-shared-view source)
                    sink)
                  (TcSelectedResult.Ok
                    ast.AstType.Unit
                    TcSelectedOccurrence.Unrepresented
                    sink))
                  [(TcSelectedResult.Err message after)
                    (TcSelectedResult.Err message after)]
                  [(TcSelectedResult.Ok _ callee callee-sink)
                    (match (tc-infer-selected-call-args
                      ctx
                      env
                      (tc-global-shared-view func)
                      (& args)
                      (& params)
                      (& branded)
                      allow-region-args
                      (if (= key -1)
                        (ast.AstMaybeType.Some
                          (tc-constructor-target-type
                            env
                            (tc-global-shared-view params)
                            (tc-global-shared-view ret)))
                        ast.AstMaybeType.No)
                      (TcArityMessage.Detailed
                        (tc-global-shared-view func)
                        (tc-global-shared-view args)
                        (tc-global-shared-view params))
                      0
                      children
                      true
                      (tc-global-shared-view source)
                      callee-sink)
                      [(TcSelectedArgsResult.Err message next)
                        (TcSelectedResult.Err
                          (if call-scoped?
                            (tc-selected-call-scoped-diagnostic
                              ctx
                              env
                              (tc-global-shared-view func)
                              (tc-global-shared-view args)
                              declared-view
                              (tc-global-shared-view lifetimes)
                              allow-region-args
                              message)
                            message)
                          next)]
                      [(TcSelectedArgsResult.Ok selected represented? next)
                        (match (match (tc-check-thread-channel-send-call
                          ctx
                          env
                          (tc-global-shared-view func)
                          (tc-global-shared-view args)
                          (tc-global-shared-view params)
                          (tc-global-shared-view ret))
                          [(ResultTcUnit.Err message)
                            (ResultTcUnit.Err message)]
                          [(ResultTcUnit.Ok)
                            (if (ast.ast-lifetime-list-empty? (& lifetimes))
                              ResultTcUnit.Ok
                              (tc-check-invalidate-call
                                ctx
                                env
                                (tc-global-shared-view args)
                                (tc-global-shared-view params)
                                (tc-global-shared-view ret)))])
                          [(ResultTcUnit.Err message)
                            (TcSelectedResult.Err message next)]
                          [(ResultTcUnit.Ok)
                            (match (if (ast.ast-lifetime-list-empty?
                              (& lifetimes))
                              (TcSelectedBrands.Ok TcNameIdList.Nil)
                              (tc-selected-invalidate-call-brands
                                ctx
                                env
                                (& args)
                                (& params)))
                              [(TcSelectedBrands.Err message)
                                (TcSelectedResult.Err message next)]
                              [(TcSelectedBrands.Ok brands)
                                (tc-selected-contextual-result
                                  ctx
                                  env
                                  expected
                                  (tc-selected-with-thread-users
                                    env
                                    (tc-selected-sent-owners
                                      ctx
                                      env
                                      (tc-global-shared-view func)
                                      (& args))
                                    syntax
                                    (ownership.ownership-source-copy (& source))
                                    (tc-selected-with-release-checks
                                      ctx
                                      env
                                      brands
                                      syntax
                                      (ownership.ownership-source-copy
                                        (& source))
                                      (tc-selected-with-region-ends
                                        ctx
                                        env
                                        brands
                                        syntax
                                        (tc-global-shared-view source)
                                        (tc-selected-publish-call
                                          (ResultTcType.Ok
                                            (tc-tag-active-region env ret))
                                          ;; Key -1 names a constructor (no declaration),
                                          ;; -2 a call through a function value.
                                          (cond
                                            [(= key -1)
                                              typed.TypedCallKind.Construct]
                                            [(= key -2)
                                              (typed.TypedCallKind.Indirect
                                                (tc-selected-effect-callee-id
                                                  ctx
                                                  env
                                                  func-id))]
                                            [(tc-selected-discharge-call?
                                                ctx
                                                (tc-global-shared-view func)
                                                (& params))
                                              (typed.TypedCallKind.Discharge
                                                key)]
                                            [else
                                              (typed.TypedCallKind.Declared key)])
                                          (tc-call-published-signature
                                            shadow
                                            (tc-global-shared-view fn-ty))
                                          syntax
                                          source
                                          (tc-selected-with-callee
                                            selected
                                            (& callee))
                                          (and
                                            represented?
                                            (or
                                              (!= key -2)
                                              (match (& callee)
                                                [(TcSelectedOccurrence.Selected
                                                    _)
                                                  true]
                                                [_ false])))
                                          next)))))])])])]))]
            [_
              (TcSelectedResult.Err
                "typecheck: call target is not a function"
                sink)])])]))

(define (tc-infer-selected-legacy
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]) : ResultTcType
  (match syntax
    [(typed.TypedSyntax.Generated)
      (match expected
        [(ast.AstMaybeType.No) (tc-expr ctx env expr)]
        [(ast.AstMaybeType.Some want)
          (tc-expr-with-expected-or-actual ctx env expr want)])]
    [(typed.TypedSyntax.Source id)
      (match expected
        [(ast.AstMaybeType.No) (tc-expr-id ctx env id)]
        [(ast.AstMaybeType.Some want)
          (tc-expr-with-expected-or-actual-id ctx env id want)])]))

;; The referent of the view binder a name read `syntax` reads (of view type
;; `actual`), taken.
(define (tc-infer-selected-view-take
  [ctx : TcContext]
  [env : TcTypeEnv]
  [actual : ast.AstType]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match syntax
    [(typed.TypedSyntax.Generated)
      (tc-selected-unrepresented
        (ResultTcType.Ok (tc-selected-strip-regions actual))
        sink)]
    [(typed.TypedSyntax.Source read)
      (let
        [owned : ast.AstType (tc-selected-strip-regions actual)]
        (match (tc-infer-selected-place-id
          ctx
          env
          read
          (tc-global-shared-view source)
          sink)
          [(TcSelectedPlaceResult.Err message next)
            (TcSelectedResult.Err message next)]
          [(TcSelectedPlaceResult.Ok _ place next)
            (match (tc-selected-place-project
              (tc-global-shared-view owned)
              (tc-global-shared-view owned)
              place
              typed.TypedProjectionKind.Deref
              (tc-global-shared-view source)
              next)
              [(TcSelectedPlaceResult.Err message after)
                (TcSelectedResult.Err message after)]
              [(TcSelectedPlaceResult.Ok _ derefed after)
                (match derefed
                  [(TcSelectedPlace.Selected id indices)
                    (tc-selected-place-read
                      ctx
                      owned
                      id
                      indices
                      syntax
                      source
                      after)]
                  [(TcSelectedPlace.Unrepresented)
                    (tc-selected-unrepresented (ResultTcType.Ok owned) after)])])]))]))

(define (tc-infer-selected-var
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  ;; A tracked arena owner moves when read whole (a branded owner is
  ;; move-only, a bare one is an Affine binder); a bare `Arena` argument or an
  ;; `in-arena` target reads it through a borrow instead (form 123).
  (match (tc-var-binding-after-local-field-check-mode
    ctx
    env
    name
    (tc-hygiene-name-text-id-for-session
      (tc-context-structural-session ctx)
      name)
    false)
    [(ResultTcBinding.Fault error)
      (TcSelectedResult.Err (tc-selected-error error) sink)]
    [(ResultTcBinding.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcBinding.Ok actual _ origin)
      (let
        [reference? : bool
          (tc-selected-expects-reference? ctx (tc-global-shared-view expected))]
        ;; A module-level binding (no scoped origin and not a local).
        [global? : bool
          (and
            (match (& origin)
              [(TcBindingOrigin.Unrepresented) true]
              [_ false])
            (not (tc-name-local-bound-before-module-scan-id? env name)))]
        ;; A view binder (a part bound by a match on a view, or a binding of
        ;; one) used as the owned value it views takes its referent, as a view
        ;; place does (`tc-selected-place-acquire`).
        (when
          (and
            (match (& actual)
              [(ast.AstType.Region _ _) true]
              [_ false])
            (not global?)
            (match (tc-global-shared-view expected)
              [(ast.AstMaybeType.Some want)
                (tc-selected-view-move-out?
                  ctx
                  env
                  want
                  (tc-global-shared-view actual))]
              [(ast.AstMaybeType.No) false]))
          (return
            (tc-infer-selected-view-take ctx env actual syntax source sink)))
        (match (match expected
          [(ast.AstMaybeType.No)
            (ResultTcType.Ok (tc-global-shared-view actual))]
          [(ast.AstMaybeType.Some want)
            (tc-expr-result-with-expected-or-actual
              ctx
              env
              want
              false
              (ResultTcType.Ok (tc-global-shared-view actual)))])
          [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
          [(ResultTcType.Ok ty)
            (if (not
              (tc-selected-same-type?
                (tc-global-shared-view actual)
                (tc-global-shared-view ty)))
              ;; A branded arena owner erased into a bare `Arena` (a bare field
              ;; or binding) is read whole, which moves the owner (#8172), and
              ;; cast to the bare handle; a scalar is read and widened. Any
              ;; other contextual coercion needs its own selected operation
              ;; before it can be represented.
              (if (or
                (tc-selected-arena-erasure?
                  ctx
                  (tc-global-shared-view actual)
                  (tc-global-shared-view ty))
                ;; A scalar read at a wider contextual type (an `f32` local
                ;; under an `f64` result) is read as itself, then cast.
                (and
                  (tc-selected-primitive-type? (& actual))
                  (tc-selected-primitive-type? (& ty))))
                (match (tc-infer-selected-var
                  ctx
                  env
                  name
                  syntax
                  (ast.AstMaybeType.Some (tc-global-shared-view actual))
                  source
                  sink)
                  [(TcSelectedResult.Ok _ occurrence next)
                    (tc-selected-widening ty occurrence next)]
                  [(TcSelectedResult.Err message next)
                    (TcSelectedResult.Err message next)])
                (TcSelectedResult.Ok ty TcSelectedOccurrence.Unrepresented sink))
              (match sink
                [(TcSelectedSink.Query)
                  (TcSelectedResult.Ok
                    ty
                    TcSelectedOccurrence.Unrepresented
                    TcSelectedSink.Query)]
                [(TcSelectedSink.Capture store lease bindings)
                  (match (tc-selected-binding-find!
                    store
                    lease
                    (& bindings)
                    env
                    origin)
                    [(TcSelectedBinderLookup.Err error)
                      (tc-selected-failed error store lease bindings)]
                    [(TcSelectedBinderLookup.Ok found)
                      (match found
                        ;; A Copy global is read as a fresh value of its type.
                        [(TcSelectedBinder.Unrepresented)
                          (cond
                            [(and
                                global?
                                (or
                                  (tc-selected-symbol-kind?
                                    ctx
                                    name
                                    (csym.compiler-symbol-kind-enum-variant))
                                  ;; A bare variant of an aliased import.
                                  (and
                                    (not
                                      (macro-hygiene-global-id?
                                        (tc-context-structural-session ctx)
                                        name))
                                    (tc-selected-enum-variant-named?
                                      ctx
                                      (tc-global-shared-view ty)
                                      name))
                                  ;; A hygienic `Enum.Variant` name: a macro
                                  ;; template's, or a bare variant retargeted
                                  ;; to its expected enum.
                                  (and
                                    (macro-hygiene-global-id?
                                      (tc-context-structural-session ctx)
                                      name)
                                    (tc-selected-hygienic-variant? ctx name)))
                                (tc-selected-call-type-ok?
                                  ctx
                                  (tc-global-shared-view ty)))
                              (tc-selected-publish-nullary-variant
                                ty
                                syntax
                                source
                                (TcSelectedSink.Capture store lease bindings))]
                            [(and
                                global?
                                (tc-type-copyable?
                                  ctx
                                  (tc-global-shared-view ty)))
                              (tc-selected-publish
                                (ResultTcType.Ok ty)
                                syntax
                                source
                                (typed.TypedOperation.Primitive
                                  (typed.TypedPrimitive.Builtin
                                    (tc-selected-form-code-global)
                                    0))
                                (tc-selected-no-occurrences)
                                (TcSelectedSink.Capture store lease bindings))]
                            ;; A move-only module value read whole is taken out
                            ;; of its static place, which the checker rejects.
                            [(and
                                global?
                                (>= (tc-selected-global-index ctx env name) 0))
                              (tc-selected-place-acquire
                                ctx
                                env
                                reference?
                                ast.AstMaybeType.No
                                syntax
                                (ownership.ownership-source-copy (& source))
                                (tc-selected-global-place-of
                                  ctx
                                  (tc-global-shared-view ty)
                                  (tc-selected-global-index ctx env name)
                                  name
                                  source
                                  (TcSelectedSink.Capture store lease bindings)))]
                            [else
                              (TcSelectedResult.Ok
                                ty
                                TcSelectedOccurrence.Unrepresented
                                (TcSelectedSink.Capture store lease bindings))])]
                        ;; A closure local is read as its environment.
                        [(TcSelectedBinder.Found binder)
                          (match (tc-selected-publish
                            (ResultTcType.Ok
                              (if (match (tc-resolve-type
                                ctx
                                (tc-global-shared-view ty))
                                [(ast.AstType.Func _ _) true]
                                [_ false])
                                (let
                                  [binder-ty : ast.AstType
                                    (tc-selected-binder-type!
                                      store
                                      lease
                                      (& binder))]
                                  (if (>=
                                    (tc-selected-closure-capability
                                      (tc-global-shared-view binder-ty))
                                    0)
                                    binder-ty
                                    (tc-global-shared-view ty)))
                                (tc-global-shared-view ty)))
                            syntax
                            source
                            (typed.TypedOperation.Read binder)
                            (tc-selected-no-occurrences)
                            (TcSelectedSink.Capture store lease bindings))
                            [(TcSelectedResult.Err message next)
                              (TcSelectedResult.Err message next)]
                            [(TcSelectedResult.Ok _ occurrence next)
                              (TcSelectedResult.Ok ty occurrence next)])])])]))]))]))

;; This place producer accepts lexical roots and tuple/owned-array paths.
;; It never acquires the root's aggregate value while forming a projection.
(define (tc-selected-place-unrepresented
  [result : ResultTcType]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedPlaceResult
    store
    lease
    intern
    bind)
  (match result
    [(ResultTcType.Ok type)
      (TcSelectedPlaceResult.Ok type TcSelectedPlace.Unrepresented sink)]
    [(ResultTcType.Err message) (TcSelectedPlaceResult.Err message sink)]))

;; The symbol index of the module value `name` resolves to, or -1.
;; The value symbol `name` names: the canonical lookup, then for a dotted name
;; ordinary source lookup, which resolves a module value named with its own
;; module's qualifier (`effects.deep.g`), as the global effect collector does.
(define (tc-selected-value-symbol-handle [ctx : TcContext] [name : i64]) : i64
  (let
    [direct : i64 (tc-move-value-symbol-handle-id ctx name)]
    (if (or
      (csym.compiler-symbols-handle-found? direct)
      (< (tc-name-first-dot-id (tc-context-structural-session ctx) name) 0))
      direct
      (match (tc-source-name-lookup-key-with-field-check-lookup
        ctx
        (tc-empty-env)
        (tc-hygiene-name-text-id-for-session
          (tc-context-structural-session ctx)
          name)
        name
        false)
        [(Ok _ key)
          (csym.compiler-symbols-lookup-value-id-or
            (tc-context-symbols ctx)
            key
            direct)]
        [(Err _) direct]))))

(define (tc-selected-global-index
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]) : i64
  (if (tc-name-local-bound-before-module-scan-id? env name)
    -1
    (let
      [handle : i64 (tc-selected-value-symbol-handle ctx name)]
      (if (and
        (csym.compiler-symbols-handle-found? handle)
        (=
          (csym.compiler-symbol-handle-kind handle)
          (csym.compiler-symbol-kind-value-define)))
        (csym.compiler-symbol-handle-index handle)
        -1))))

;; The place of module value `name` (`tc-selected-global-place`); a value
;; another module owns is noted so that a write to it is rejected
;; (`tc-selected-foreign-write`).
(define (tc-selected-global-place-of
  [ctx : TcContext]
  [type : ast.AstType]
  [global : i64]
  [name : i64]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedPlaceResult
    store
    lease
    intern
    bind)
  (let
    [handle : i64 (tc-selected-value-symbol-handle ctx name)]
    [foreign? : bool
      (not
        (tc-module-ids-same?
          (tc-move-global-owner-module-id ctx handle)
          (tc-context-module-id ctx)))]
    (match (tc-selected-global-place type global name source sink)
      [(TcSelectedPlaceResult.Ok ty place next)
        (match place
          [(TcSelectedPlace.Selected id indices)
            (match next
              [(TcSelectedSink.Capture store lease bindings)
                (when
                  foreign?
                  (match (typed.typed-place-get!
                    store
                    lease
                    (typed.TypedPlaceId (typed.typed-handle-copy (& id.handle))))
                    [(typed.TypedPlaceView.Ok row)
                      (match (& row.kind)
                        [(typed.TypedPlaceKind.Root binder)
                          (__tl_array-push!
                            bindings.foreign-globals
                            (TcSelectedForeignGlobal
                              binder.handle.index
                              (tc-move-foreign-global-write-head)
                              (tc-move-foreign-global-write-tail
                                ctx
                                name
                                handle)))]
                        [_ unit])]
                    [(typed.TypedPlaceView.Err _) unit]))
                (TcSelectedPlaceResult.Ok
                  ty
                  (TcSelectedPlace.Selected id indices)
                  (TcSelectedSink.Capture store lease bindings))]
              [(TcSelectedSink.Query)
                (TcSelectedPlaceResult.Ok
                  ty
                  (TcSelectedPlace.Selected id indices)
                  TcSelectedSink.Query)])]
          [(TcSelectedPlace.Unrepresented)
            (TcSelectedPlaceResult.Ok ty TcSelectedPlace.Unrepresented next)])]
      [(TcSelectedPlaceResult.Err message next)
        (TcSelectedPlaceResult.Err message next)])))

;; One step up a typed place: its root binder or its parent and projection.
(defenum TcSelectedPlaceLink
  (Root i64)
  (Step i64 typed.TypedProjectionId)
  (None))

;; A write to a foreign module value's place (#7976): the legacy diagnostic
;; for the operation, by the place's last step (a whole value is assigned, a
;; field or element of it, or its box contents), or No.
(define (tc-selected-foreign-write
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [bindings : (&mut bindings TcSelectedBindings)]
  [operation : (& operation typed.TypedOperation)]
  [children : (& children (__tl_dyn-array typed.TypedOccurrenceId))]) : TcMaybeString
  (let
    ;; A mutable borrow takes the pending store verb.
    [pending : String
      (match operation
        [(typed.TypedOperation.Borrow mutable?)
          (if mutable?
            (replace! bindings.write-verb "")
            "")]
        [_ ""])]
    (if (= (array-length bindings.foreign-globals) 0)
      TcMaybeString.No
      (let
        ;; The written place (-1 for none) and the whole binder for `Assign`.
        [place : i64
          (match operation
            [(typed.TypedOperation.AssignPlace id) id.handle.index]
            [(typed.TypedOperation.ReplacePlace id) id.handle.index]
            [(typed.TypedOperation.Borrow mutable?)
              (if (and mutable? (> (array-length children) 0))
                (match (typed.typed-occurrence-get!
                  store
                  lease
                  (typed.TypedOccurrenceId
                    (typed.typed-handle-copy (& (array-ref children 0).handle))))
                  [(typed.TypedNodeResult.Ok node)
                    (match (& node.operation)
                      [(typed.TypedOperation.FormPlace id) id.handle.index]
                      [_ -1])]
                  [(typed.TypedNodeResult.Err _) -1])
                -1)]
            [_ -1])]
        [binder : i64
          (match operation
            [(typed.TypedOperation.Assign id) id.handle.index]
            [_ -1])]
        [verb : String
          (match operation
            [(typed.TypedOperation.ReplacePlace _) "replace a place in"]
            [(typed.TypedOperation.Borrow _)
              (if (> (string.string-length (& pending)) 0)
                pending
                "mutably borrow")]
            [_ "assign to"])]
        ;; Walk the written place up to its root binder.
        (let
          [cursor : i64 place]
          [first? : bool true]
          (while (>= cursor 0)
            (let
              [link : TcSelectedPlaceLink
                (match (typed.typed-place-at! store lease cursor)
                  [(typed.TypedPlaceResult.Err _) TcSelectedPlaceLink.None]
                  [(typed.TypedPlaceResult.Ok id)
                    (match (typed.typed-place-get! store lease id)
                      [(typed.TypedPlaceView.Err _) TcSelectedPlaceLink.None]
                      [(typed.TypedPlaceView.Ok row)
                        (match (& row.kind)
                          [(typed.TypedPlaceKind.Root root)
                            (TcSelectedPlaceLink.Root root.handle.index)]
                          [(typed.TypedPlaceKind.Projection parent step)
                            (TcSelectedPlaceLink.Step
                              parent.handle.index
                              (typed.TypedProjectionId
                                (typed.typed-handle-copy (& step.handle))))])])])]
              (match link
                [(TcSelectedPlaceLink.None) (set! cursor -1)]
                [(TcSelectedPlaceLink.Root root)
                  (set! binder root)
                  (set! cursor -1)]
                [(TcSelectedPlaceLink.Step parent step)
                  ;; An assignment names the written part by its innermost
                  ;; step.
                  (when
                    (and
                      first?
                      (match operation
                        [(typed.TypedOperation.AssignPlace _) true]
                        [_ false]))
                    (match (typed.typed-projection-get! store lease step)
                      [(typed.TypedProjectionView.Ok projection)
                        (set!
                          verb
                          (match (& projection.kind)
                            [(typed.TypedProjectionKind.ArrayElement)
                              "assign to an element of"]
                            [(typed.TypedProjectionKind.FixedArrayElement _)
                              "assign to an element of"]
                            [(typed.TypedProjectionKind.Deref) "assign through"]
                            [_ "assign to part of"]))]
                      [(typed.TypedProjectionView.Err _) unit]))
                  (set! first? false)
                  (set! cursor parent)]))))
        (let
          [index : i64 0]
          [found : TcMaybeString TcMaybeString.No]
          (while (and
            (>= binder 0)
            (< index (array-length bindings.foreign-globals)))
            (when
              (= (array-ref bindings.foreign-globals index).binder binder)
              (set!
                found
                (TcMaybeString.Some
                  (str_cat.str-cat
                    (string.copy
                      (& (array-ref bindings.foreign-globals index).head))
                    (string.copy (& verb))
                    (string.copy
                      (& (array-ref bindings.foreign-globals index).tail))))))
            (set! index (+ index 1)))
          found)))))

;; The place of module value `global`: one binder per body, found again by its
;; resolved declaration.
(define (tc-selected-global-place
  [type : ast.AstType]
  [global : i64]
  [name : i64]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedPlaceResult
    store
    lease
    intern
    bind)
  (match sink
    [(TcSelectedSink.Query)
      (TcSelectedPlaceResult.Ok
        type
        TcSelectedPlace.Unrepresented
        TcSelectedSink.Query)]
    [(TcSelectedSink.Capture store lease bindings)
      (let
        ;; Only a declaration the body's current resolution lease covers is
        ;; one of its resolved globals.
        [resolved : typed.TypedResolvedGlobal
          (typed.TypedResolvedGlobal
            lease.resolutions.owner
            lease.resolutions.generation
            lease.resolutions.revision
            global)]
        [_resolved : unit
          (when
            (not (typed.typed-global-valid? lease (& resolved)))
            (return
              (TcSelectedPlaceResult.Ok
                type
                TcSelectedPlace.Unrepresented
                (TcSelectedSink.Capture store lease bindings))))]
        [count : i64
          (match (typed.typed-binder-count! store lease)
            [(typed.TypedCountResult.Ok value) value]
            [(typed.TypedCountResult.Err error)
              (return
                (TcSelectedPlaceResult.Ok
                  type
                  TcSelectedPlace.Unrepresented
                  (TcSelectedSink.Capture store lease bindings)))])]
        [index : i64 0]
        [found : i64 -1]
        (while (and (< found 0) (< index count))
          (begin
            (match (typed.typed-binder-at! store lease index)
              [(typed.TypedBinderResult.Ok id)
                (match (typed.typed-binder-get! store lease id)
                  [(typed.TypedBinderView.Ok binder)
                    (match (& binder.kind)
                      [(typed.TypedBinderKind.Global resolved)
                        (when (= resolved.index global) (set! found index))]
                      [_ unit])]
                  [(typed.TypedBinderView.Err _) unit])]
              [(typed.TypedBinderResult.Err _) unit])
            (set! index (+ index 1))))
        (match (if (>= found 0)
          (typed.typed-binder-at! store lease found)
          (match (typed.typed-type-add!
            store
            lease
            (tc-global-shared-view type))
            [(typed.TypedTypeIdResult.Err error)
              (typed.TypedBinderResult.Err error)]
            [(typed.TypedTypeIdResult.Ok type-id)
              (match (typed.typed-origin-add! store lease source)
                [(typed.TypedOriginResult.Err error)
                  (typed.TypedBinderResult.Err error)]
                [(typed.TypedOriginResult.Ok origin)
                  (typed.typed-binder-add!
                    store
                    lease
                    type-id
                    (typed.TypedBinderKind.Global
                      (typed.TypedResolvedGlobal
                        lease.resolutions.owner
                        lease.resolutions.generation
                        lease.resolutions.revision
                        global))
                    origin
                    name)])]))
          [(typed.TypedBinderResult.Err error)
            (TcSelectedPlaceResult.Ok
              type
              TcSelectedPlace.Unrepresented
              (TcSelectedSink.Capture store lease bindings))]
          [(typed.TypedBinderResult.Ok binder)
            (match (typed.typed-place-add!
              store
              lease
              (typed.TypedPlaceKind.Root binder))
              [(typed.TypedPlaceResult.Err error)
                (TcSelectedPlaceResult.Ok
                  type
                  TcSelectedPlace.Unrepresented
                  (TcSelectedSink.Capture store lease bindings))]
              [(typed.TypedPlaceResult.Ok id)
                (TcSelectedPlaceResult.Ok
                  type
                  (TcSelectedPlace.Selected id (tc-selected-no-occurrences))
                  (TcSelectedSink.Capture store lease bindings))])]))]))

(define (tc-selected-place-root
  [env : TcTypeEnv]
  [result : ResultTcBinding]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedPlaceResult
    store
    lease
    intern
    bind)
  (match result
    [(ResultTcBinding.Fault error)
      (TcSelectedPlaceResult.Err (tc-selected-error error) sink)]
    [(ResultTcBinding.Err message) (TcSelectedPlaceResult.Err message sink)]
    [(ResultTcBinding.Ok type _ origin)
      (match sink
        [(TcSelectedSink.Query)
          (TcSelectedPlaceResult.Ok
            type
            TcSelectedPlace.Unrepresented
            TcSelectedSink.Query)]
        [(TcSelectedSink.Capture store lease bindings)
          (match (tc-selected-binding-find! store lease (& bindings) env origin)
            [(TcSelectedBinderLookup.Err error)
              (tc-selected-place-failed error store lease bindings)]
            [(TcSelectedBinderLookup.Ok found)
              (match found
                [(TcSelectedBinder.Unrepresented)
                  (TcSelectedPlaceResult.Ok
                    type
                    TcSelectedPlace.Unrepresented
                    (TcSelectedSink.Capture store lease bindings))]
                [(TcSelectedBinder.Found binder)
                  (match (typed.typed-place-add!
                    store
                    lease
                    (typed.TypedPlaceKind.Root binder))
                    [(typed.TypedPlaceResult.Err error)
                      (tc-selected-place-failed error store lease bindings)]
                    [(typed.TypedPlaceResult.Ok id)
                      (TcSelectedPlaceResult.Ok
                        type
                        (TcSelectedPlace.Selected
                          id
                          (tc-selected-no-occurrences))
                        (TcSelectedSink.Capture store lease bindings))])])])])]))

(define (tc-tuple-ref-result-type [type : ast.AstType] [index : i64]) : ResultTcType
  (match (tc-type-strip-region (tc-global-shared-view type))
    [(ast.AstType.Tuple types)
      (match (tc-type-list-ref (ast.ast-type-list-box-shared-view types) index)
        [(ResultTcType.Ok element)
          (ResultTcType.Ok (tc-project-from-region-container type element))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [_ (ResultTcType.Err "typecheck: tuple-ref requires tuple type")]))

;; `type` is what the place expression reports; `place-type` is the projected
;; place's own type (a field read through a reference reports a region-tagged
;; view of a plain field place).
(define (tc-selected-place-project
  [type : ast.AstType]
  [place-type : ast.AstType]
  [place : TcSelectedPlace]
  [kind : typed.TypedProjectionKind]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedPlaceResult
    store
    lease
    intern
    bind)
  (if (not (ownership.ownership-source-valid? (& source)))
    (TcSelectedPlaceResult.Ok type TcSelectedPlace.Unrepresented sink)
    (match place
      [(TcSelectedPlace.Unrepresented)
        (TcSelectedPlaceResult.Ok type TcSelectedPlace.Unrepresented sink)]
      [(TcSelectedPlace.Selected parent indices)
        (match sink
          [(TcSelectedSink.Query)
            (TcSelectedPlaceResult.Err
              (tc-selected-error typed.TypedError.Query)
              TcSelectedSink.Query)]
          [(TcSelectedSink.Capture store lease bindings)
            (let
              [container-id : typed.TypedTypeId
                (match (typed.typed-place-get! store lease parent)
                  [(typed.TypedPlaceView.Ok row)
                    ;; A fresh value: the row lives in store storage that the
                    ;; following additions may grow and move.
                    (typed.TypedTypeId
                      (typed.typed-handle-copy (& row.type.handle)))]
                  [(typed.TypedPlaceView.Err error)
                    (return
                      (tc-selected-place-failed error store lease bindings))])]
              [result-id : typed.TypedTypeId
                (match (typed.typed-type-add! store lease place-type)
                  [(typed.TypedTypeIdResult.Ok id) id]
                  [(typed.TypedTypeIdResult.Err error)
                    (return
                      (tc-selected-place-failed error store lease bindings))])]
              [origin : typed.TypedOriginId
                (match (typed.typed-origin-add! store lease source)
                  [(typed.TypedOriginResult.Ok id) id]
                  [(typed.TypedOriginResult.Err error)
                    (return
                      (tc-selected-place-failed error store lease bindings))])]
              [projection : typed.TypedProjectionId
                (match (typed.typed-projection-add!
                  store
                  lease
                  container-id
                  result-id
                  kind
                  origin)
                  [(typed.TypedProjectionResult.Ok id) id]
                  [(typed.TypedProjectionResult.Err error)
                    (return
                      (tc-selected-place-failed error store lease bindings))])]
              (match (typed.typed-place-add!
                store
                lease
                (typed.TypedPlaceKind.Projection parent projection))
                [(typed.TypedPlaceResult.Ok id)
                  (TcSelectedPlaceResult.Ok
                    type
                    (TcSelectedPlace.Selected id indices)
                    (TcSelectedSink.Capture store lease bindings))]
                [(typed.TypedPlaceResult.Err error)
                  (tc-selected-place-failed error store lease bindings)]))])])))

(define (tc-selected-place-tuple
  [ctx : TcContext]
  [index : i64]
  [source : ownership.OwnershipSource]
  [receiver : (TcSelectedPlaceResult store lease intern bind)]) : (TcSelectedPlaceResult
    store
    lease
    intern
    bind)
  (match receiver
    [(TcSelectedPlaceResult.Err message sink)
      (TcSelectedPlaceResult.Err message sink)]
    [(TcSelectedPlaceResult.Ok container place sink)
      (let
        ;; Through a reference receiver the element is the referent tuple's,
        ;; reached through a dereference (as `tc-selected-place-field`).
        [resolved : ast.AstType
          (tc-selected-layout-type ctx (tc-global-shared-view container))]
        [through? : bool
          (match (& resolved)
            [(ast.AstType.Ref _ _) true]
            [(ast.AstType.MutRef _ _) true]
            [_ false])]
        [base : ast.AstType
          (if through?
            (tc-type-strip-region
              (tc-resolve-type
                ctx
                (tc-selected-referent ctx (tc-global-shared-view resolved))))
            container)]
        (match (tc-tuple-ref-result-type (tc-global-shared-view base) index)
          [(ResultTcType.Err message) (TcSelectedPlaceResult.Err message sink)]
          [(ResultTcType.Ok type)
            (match (if through?
              (tc-selected-place-project
                (tc-global-shared-view base)
                (tc-global-shared-view base)
                place
                typed.TypedProjectionKind.Deref
                (tc-global-shared-view source)
                sink)
              (TcSelectedPlaceResult.Ok (tc-global-shared-view base) place sink))
              [(TcSelectedPlaceResult.Err message next)
                (TcSelectedPlaceResult.Err message next)]
              [(TcSelectedPlaceResult.Ok _ base-place next)
                (tc-selected-place-project
                  (tc-global-shared-view type)
                  ;; The element place's own type: a tuple read through a
                  ;; reference reports a region-tagged view of a plain element
                  ;; (as `tc-selected-place-field`).
                  (match (tc-tuple-ref-result-type
                    (tc-type-strip-region (tc-global-shared-view base))
                    index)
                    [(ResultTcType.Ok element) element]
                    [(ResultTcType.Err _) (tc-global-shared-view type)])
                  base-place
                  (typed.TypedProjectionKind.TupleElement index)
                  source
                  next)])]))]))

;; A struct value type whose fields a place can project.
(define (tc-selected-struct-place-type? [resolved : ast.AstType]) : bool
  (match resolved
    [(ast.AstType.Struct _) true]
    [(ast.AstType.StructArgs _ _) true]
    [_ false]))

;; `receiver.field` as a place: a field of a struct place, or through a
;; reference, a field of its referent (after a `Deref` projection). The place
;; has the plain field type; the expression keeps the legacy type, which is a
;; region-tagged view for an aggregate read through a reference.
(define (tc-selected-place-field
  [ctx : TcContext]
  [field : i64]
  [source : ownership.OwnershipSource]
  [receiver : (TcSelectedPlaceResult store lease intern bind)]) : (TcSelectedPlaceResult
    store
    lease
    intern
    bind)
  (match receiver
    [(TcSelectedPlaceResult.Err message sink)
      (TcSelectedPlaceResult.Err message sink)]
    [(TcSelectedPlaceResult.Ok container place sink)
      ;; A field of an opaque struct is unreachable outside its module family
      ;; (#6999), as `tc-struct-get-result-type-id` checks.
      (match (if (tc-job-state-opaque-program? (tc-context-job-state ctx))
        (tc-opaque-representation-ok
          ctx
          (let
            [resolved : ast.AstType
              (tc-type-strip-region
                (tc-resolve-type ctx (tc-global-shared-view container)))]
            ;; Through a reference, the referent's representation is read.
            (match (& resolved)
              [(ast.AstType.Ref _ _)
                (tc-type-strip-region
                  (tc-resolve-type
                    ctx
                    (tc-selected-referent ctx (tc-global-shared-view resolved))))]
              [(ast.AstType.MutRef _ _)
                (tc-type-strip-region
                  (tc-resolve-type
                    ctx
                    (tc-selected-referent ctx (tc-global-shared-view resolved))))]
              [_ resolved]))
          "cannot access a field of the")
        ResultTcUnit.Ok)
        [(ResultTcUnit.Err message) (TcSelectedPlaceResult.Err message sink)]
        [(ResultTcUnit.Ok)
          (match (match (tc-selected-syntax-nominal
            ctx
            (tc-type-strip-region
              (tc-resolve-type ctx (tc-global-shared-view container))))
            ;; A syntax type's fields are its declaration's.
            [(ast.AstMaybeType.Some (ast.AstType.Struct name))
              (tc-struct-field-selected-id ctx name field)]
            [_
              (tc-struct-get-selected-id
                ctx
                (tc-global-shared-view container)
                field)])
            [(ResultTcField.Err message)
              (TcSelectedPlaceResult.Err message sink)]
            [(ResultTcField.Ok selected)
              (let
                ;; A region-tagged struct (an aggregate read through a reference)
                ;; is a place of the struct itself: the tag constrains the value's
                ;; lifetime, not its layout.
                [resolved : ast.AstType
                  (tc-selected-layout-type
                    ctx
                    (tc-global-shared-view container))]
                [through? : bool
                  (match (& resolved)
                    [(ast.AstType.Ref _ _) true]
                    [(ast.AstType.MutRef _ _) true]
                    [_ false])]
                [base : ast.AstType
                  (if through?
                    (tc-type-strip-region
                      (tc-resolve-type
                        ctx
                        (tc-selected-referent
                          ctx
                          (tc-global-shared-view resolved))))
                    (tc-global-shared-view resolved))]
                [owner : i64
                  (match (& selected.identity)
                    [(TcFieldIdentity.Nominal owner _) owner]
                    [(TcFieldIdentity.Intrinsic) -1])]
                [ordinal : i64
                  (match (& selected.identity)
                    [(TcFieldIdentity.Nominal _ child) child]
                    [(TcFieldIdentity.Intrinsic) -1])]
                [place-type : ast.AstType
                  (match (tc-selected-syntax-nominal
                    ctx
                    (tc-type-strip-region
                      (tc-resolve-type ctx (tc-global-shared-view container))))
                    [(ast.AstMaybeType.Some _)
                      (tc-global-shared-view selected.type)]
                    [(ast.AstMaybeType.No)
                      (match (tc-struct-get-result-type-id
                        ctx
                        (tc-global-shared-view base)
                        field)
                        [(ResultTcType.Ok ty) ty]
                        [(ResultTcType.Err _) ast.AstType.Never])])]
                (if (or
                  (< owner 0)
                  (not
                    (tc-selected-struct-place-type?
                      (tc-global-shared-view base))))
                  (tc-selected-place-unrepresented
                    (ResultTcType.Ok selected.type)
                    sink)
                  (match sink
                    [(TcSelectedSink.Query)
                      (TcSelectedPlaceResult.Ok
                        selected.type
                        TcSelectedPlace.Unrepresented
                        TcSelectedSink.Query)]
                    [(TcSelectedSink.Capture store lease bindings)
                      (let
                        [global : typed.TypedResolvedGlobal
                          (typed.TypedResolvedGlobal
                            lease.resolutions.owner
                            lease.resolutions.generation
                            lease.resolutions.revision
                            owner)]
                        (match (if through?
                          (tc-selected-place-project
                            (tc-global-shared-view base)
                            (tc-global-shared-view base)
                            place
                            typed.TypedProjectionKind.Deref
                            (tc-global-shared-view source)
                            (TcSelectedSink.Capture store lease bindings))
                          (TcSelectedPlaceResult.Ok
                            (tc-global-shared-view base)
                            place
                            (TcSelectedSink.Capture store lease bindings)))
                          [(TcSelectedPlaceResult.Err message next)
                            (TcSelectedPlaceResult.Err message next)]
                          [(TcSelectedPlaceResult.Ok _ base-place next)
                            (tc-selected-place-project
                              selected.type
                              place-type
                              base-place
                              (typed.TypedProjectionKind.StructField
                                global
                                ordinal)
                              source
                              next)]))])))])])]))

;; The `StructGet` chain a dotted local name is rewritten to in place, or No
;; for a module-qualified name (and for generated syntax, which has no node).
(defenum TcSelectedDotted
  (Field ast.AstExpr)
  (Err String)
  (No))

(define (tc-selected-dotted-field
  [ctx : TcContext]
  [env : TcTypeEnv]
  [syntax : typed.TypedSyntax]) : TcSelectedDotted
  (match syntax
    [(typed.TypedSyntax.Generated) TcSelectedDotted.No]
    [(typed.TypedSyntax.Source id)
      (match (tc-normalize-dotted-local-field-node! ctx env id)
        [(ResultTcUnit.Err message) (TcSelectedDotted.Err message)]
        [(ResultTcUnit.Ok)
          (let
            [rewritten : ast.AstExpr (tc-context-expr-get ctx id)]
            (match (& rewritten)
              [(ast.AstExpr.StructGet _ _) (TcSelectedDotted.Field rewritten)]
              [_ TcSelectedDotted.No]))])]))

;; --- Raw-pointer places (#8564) --------------------------------------------
;;
;; `(deref p)` over a raw pointer `p` is a place only as the root of a
;; struct-field projection, which field, tuple and array projections may
;; follow. Such a place lies outside ownership tracking, like the whole pointee
;; `ptr-read` and `ptr-write!` access: a read is a fresh bitwise copy (RawRead)
;; and a store moves its value in, neither dropping nor checking the value it
;; overwrites (RawWrite). Typing (legacy, which requires the unsafe context and
;; a `MutPtr` for a store) rejects a borrow of such a place and `replace!` of it.
;; Whether the place expression `id` projects out of a raw pointer's pointee.
(define (tc-selected-raw-place? [ctx : TcContext] [env : TcTypeEnv] [id : i64]) : bool
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-bases ctx)
    (& (tc-context-expr-get ctx id)))
    [(or (ast.AstExpr.StructGet _ _) (ast.AstExpr.TupleRef _ _)
         (ast.AstExpr.ArrayRef _ _))
      (tc-raw-deref-place? ctx env (tc-context-expr-get ctx id))]
    [_ false]))

;; The operands of a raw-pointer place, appended to `children`: the pointer,
;; then each dynamic index of the path from root to leaf.
(define (tc-infer-selected-raw-place-operands
  [ctx : TcContext]
  [env : TcTypeEnv]
  [id : i64]
  [children : (__tl_dyn-array typed.TypedOccurrenceId)]
  [represented? : bool]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedArgsResult
    store
    lease
    intern
    bind)
  (match (ast.ast-expr-unspan-with-segment-bases
    (tc-context-expr-bases ctx)
    (& (tc-context-expr-get ctx id)))
    [(ast.AstExpr.BoxTake pointer-id)
      (tc-selected-raw-operand-push
        children
        represented?
        (tc-infer-selected-pointer-operand ctx env pointer-id source sink))]
    [(or (ast.AstExpr.StructGet receiver-id _)
         (ast.AstExpr.TupleRef receiver-id _))
      (tc-infer-selected-raw-place-operands
        ctx
        env
        receiver-id
        children
        represented?
        source
        sink)]
    [(ast.AstExpr.ArrayRef receiver-id index-id)
      (match (tc-infer-selected-raw-place-operands
        ctx
        env
        receiver-id
        children
        represented?
        (tc-global-shared-view source)
        sink)
        [(TcSelectedArgsResult.Err message next)
          (TcSelectedArgsResult.Err message next)]
        [(TcSelectedArgsResult.Ok before before-represented? next)
          (tc-selected-raw-operand-push
            before
            before-represented?
            (tc-infer-selected-id
              ctx
              env
              index-id
              (ast.AstMaybeType.Some ast.AstType.I64)
              source
              next))])]
    [_ (TcSelectedArgsResult.Err (tc-raw-deref-whole-message) sink)]))

(define (tc-selected-raw-operand-push
  [children : (__tl_dyn-array typed.TypedOccurrenceId)]
  [represented? : bool]
  [result : (TcSelectedResult store lease intern bind)]) : (TcSelectedArgsResult
    store
    lease
    intern
    bind)
  (match result
    [(TcSelectedResult.Err message next)
      (TcSelectedArgsResult.Err message next)]
    [(TcSelectedResult.Ok _ child next)
      (match child
        [(TcSelectedOccurrence.Selected id)
          (let
            [items : (__tl_dyn-array typed.TypedOccurrenceId) children]
            (tc-selected-occurrences-push! (&mut items) id)
            (TcSelectedArgsResult.Ok items represented? next))]
        [(TcSelectedOccurrence.Unrepresented)
          (TcSelectedArgsResult.Ok children false next)])]))

;; A value read of a raw-pointer place (#8564): RawRead of its operands, the
;; receiver's then `index-id`'s unless it is -1, typed as legacy types it.
(define (tc-infer-selected-raw-read
  [ctx : TcContext]
  [env : TcTypeEnv]
  [receiver-id : i64]
  [index-id : i64]
  [expr : ast.AstExpr]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-legacy ctx env expr syntax expected)
    [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcType.Ok ty)
      (match (tc-infer-selected-raw-place-operands
        ctx
        env
        receiver-id
        (tc-selected-no-occurrences)
        true
        (tc-global-shared-view source)
        sink)
        [(TcSelectedArgsResult.Err message next)
          (TcSelectedResult.Err message next)]
        [(TcSelectedArgsResult.Ok operands represented? next)
          (match (if (< index-id 0)
            (TcSelectedArgsResult.Ok operands represented? next)
            (tc-selected-raw-operand-push
              operands
              represented?
              (tc-infer-selected-id
                ctx
                env
                index-id
                (ast.AstMaybeType.Some ast.AstType.I64)
                (tc-global-shared-view source)
                next)))
            [(TcSelectedArgsResult.Err message after)
              (TcSelectedResult.Err message after)]
            [(TcSelectedArgsResult.Ok children all? after)
              (if all?
                (tc-selected-publish
                  (ResultTcType.Ok ty)
                  syntax
                  source
                  (typed.TypedOperation.Primitive
                    (typed.TypedPrimitive.RawRead (array-length children)))
                  children
                  after)
                (tc-selected-unrepresented (ResultTcType.Ok ty) after))])])]))

;; A raw-pointer place formed to be read: a temporary holding its RawRead
;; value.
(define (tc-infer-selected-raw-place
  [ctx : TcContext]
  [env : TcTypeEnv]
  [id : i64]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedPlaceResult
    store
    lease
    intern
    bind)
  (match (tc-expr-id ctx env id)
    [(ResultTcType.Err message) (TcSelectedPlaceResult.Err message sink)]
    [(ResultTcType.Ok ty)
      (match (tc-infer-selected-raw-place-operands
        ctx
        env
        id
        (tc-selected-no-occurrences)
        true
        (tc-global-shared-view source)
        sink)
        [(TcSelectedArgsResult.Err message next)
          (TcSelectedPlaceResult.Err message next)]
        [(TcSelectedArgsResult.Ok operands represented? next)
          (if (not represented?)
            (TcSelectedPlaceResult.Ok ty TcSelectedPlace.Unrepresented next)
            (match (tc-selected-publish
              (ResultTcType.Ok (tc-global-shared-view ty))
              typed.TypedSyntax.Generated
              (tc-global-shared-view source)
              (typed.TypedOperation.Primitive
                (typed.TypedPrimitive.RawRead (array-length operands)))
              operands
              next)
              [(TcSelectedResult.Err message after)
                (TcSelectedPlaceResult.Err message after)]
              [(TcSelectedResult.Ok _ occurrence after)
                (match occurrence
                  [(TcSelectedOccurrence.Unrepresented)
                    (TcSelectedPlaceResult.Ok
                      ty
                      TcSelectedPlace.Unrepresented
                      after)]
                  [(TcSelectedOccurrence.Selected value)
                    (match after
                      [(TcSelectedSink.Capture store lease bindings)
                        (tc-selected-temporary-place!
                          ty
                          value
                          source
                          store
                          lease
                          bindings)]
                      [(TcSelectedSink.Query)
                        (TcSelectedPlaceResult.Ok
                          ty
                          TcSelectedPlace.Unrepresented
                          TcSelectedSink.Query)])])]))])]))

;; A store into the raw-pointer place `id` (indexed by `index-id` unless it is
;; -1): RawWrite of the value, inferred against `value-ty`. Typing has checked
;; the store.
(define (tc-infer-selected-raw-store
  [ctx : TcContext]
  [env : TcTypeEnv]
  [id : i64]
  [index-id : i64]
  [value-id : i64]
  [value-ty : ast.AstType]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-raw-place-operands
    ctx
    env
    id
    (tc-selected-no-occurrences)
    true
    (tc-global-shared-view source)
    sink)
    [(TcSelectedArgsResult.Err message next)
      (TcSelectedResult.Err message next)]
    [(TcSelectedArgsResult.Ok operands represented? next)
      (match (if (< index-id 0)
        (TcSelectedArgsResult.Ok operands represented? next)
        (tc-selected-raw-operand-push
          operands
          represented?
          (tc-infer-selected-id
            ctx
            env
            index-id
            (ast.AstMaybeType.Some ast.AstType.I64)
            (tc-global-shared-view source)
            next)))
        [(TcSelectedArgsResult.Err message after)
          (TcSelectedResult.Err message after)]
        [(TcSelectedArgsResult.Ok indexed indexed-represented? after)
          (match (tc-selected-raw-operand-push
            indexed
            indexed-represented?
            (tc-infer-selected-id
              ctx
              env
              value-id
              (ast.AstMaybeType.Some value-ty)
              (tc-global-shared-view source)
              after))
            [(TcSelectedArgsResult.Err message done)
              (TcSelectedResult.Err message done)]
            [(TcSelectedArgsResult.Ok children all? done)
              (if all?
                (tc-selected-publish
                  (ResultTcType.Ok ast.AstType.Unit)
                  syntax
                  source
                  (typed.TypedOperation.Primitive
                    (typed.TypedPrimitive.RawWrite (array-length children)))
                  children
                  done)
                (tc-selected-unrepresented
                  (ResultTcType.Ok ast.AstType.Unit)
                  done))])])]))

(define (tc-infer-selected-place-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [id : i64]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedPlaceResult
    store
    lease
    intern
    bind)
  (if (tc-type-env-scoped-identity-exhausted? env)
    (TcSelectedPlaceResult.Err
      (tc-selected-error typed.TypedError.Exhausted)
      sink)
    (match sink
      [(TcSelectedSink.Query)
        (tc-semantic-unobserved
          ctx
          (tc-infer-selected-place-id-checked
            ctx
            env
            id
            source
            (tc-context-expr-query-id-ok ctx id)
            TcSelectedSink.Query))]
      [(TcSelectedSink.Capture store lease bindings)
        (match (tc-selected-context-lease-ok ctx lease)
          [(typed.TypedResult.Err error)
            (tc-selected-place-failed error store lease bindings)]
          [(typed.TypedResult.Ok _)
            (match (typed.typed-charge! store lease 1)
              [(typed.TypedResult.Err error)
                (tc-selected-place-failed error store lease bindings)]
              [(typed.TypedResult.Ok _)
                (tc-infer-selected-place-id-checked
                  ctx
                  env
                  id
                  source
                  (tc-selected-id-bound-ok
                    id
                    (ast.ast-node-pool-context-expr-len lease.pools))
                  (TcSelectedSink.Capture store lease bindings))])])])))

(define (tc-infer-selected-place-id-checked
  [ctx : TcContext]
  [env : TcTypeEnv]
  [id : i64]
  [source : ownership.OwnershipSource]
  [checked : typed.TypedResult]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedPlaceResult
    store
    lease
    intern
    bind)
  (match checked
    [(typed.TypedResult.Err error)
      (TcSelectedPlaceResult.Err (tc-selected-error error) sink)]
    [(typed.TypedResult.Ok _)
      (let
        [observed? : bool (tc-semantic-capture-observed? ctx (& sink))]
        (when observed? (tc-semantic-observe-enter! ctx env id))
        (match (if (tc-selected-raw-place? ctx env id)
          (tc-infer-selected-raw-place ctx env id source sink)
          (tc-infer-selected-place-node
            ctx
            env
            id
            (tc-context-expr-get ctx id)
            source
            sink))
          [(TcSelectedPlaceResult.Err message next)
            (when
              observed?
              (tc-semantic-observe-expression!
                ctx
                env
                id
                (ResultTcType.Err (tc-global-shared-view message))))
            (TcSelectedPlaceResult.Err message next)]
          [(TcSelectedPlaceResult.Ok type place next)
            (tc-body-type-fact-record!
              (tc-context-body-state ctx)
              id
              (tc-global-shared-view type))
            (when
              observed?
              (tc-semantic-observe-expression!
                ctx
                env
                id
                (ResultTcType.Ok (tc-global-shared-view type))))
            (TcSelectedPlaceResult.Ok type place next)]))]))

(define (tc-infer-selected-place-node
  [ctx : TcContext]
  [env : TcTypeEnv]
  [id : i64]
  [expr : ast.AstExpr]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedPlaceResult
    store
    lease
    intern
    bind)
  (match expr
    [(ast.AstExpr.Var name)
      (if (<
        (tc-dotted-name-first-dot-id (tc-context-structural-session ctx) name)
        0)
        (let
          [binding : ResultTcBinding
            (tc-var-binding-after-local-field-check-mode
              ctx
              env
              name
              (tc-hygiene-name-text-id-for-session
                (tc-context-structural-session ctx)
                name)
              false)]
          ;; A module value is a permanent static place of its own.
          [global : i64
            (match (& binding)
              [(ResultTcBinding.Ok _ _ origin)
                (match origin
                  [(TcBindingOrigin.Unrepresented)
                    (tc-selected-global-index ctx env name)]
                  [_ -1])]
              [_ -1])]
          (if (< global 0)
            (tc-selected-place-root env binding sink)
            (tc-selected-global-place-of
              ctx
              (match binding
                [(ResultTcBinding.Ok type _ _) type]
                [_ ast.AstType.Unit])
              global
              name
              source
              sink)))
        (match (tc-selected-dotted-field ctx env (typed.TypedSyntax.Source id))
          [(TcSelectedDotted.Field rewritten)
            (tc-infer-selected-place-node ctx env id rewritten source sink)]
          [(TcSelectedDotted.Err message)
            (TcSelectedPlaceResult.Err message sink)]
          ;; A module-qualified name of a module value is its static place.
          [(TcSelectedDotted.No)
            (let
              [global : i64 (tc-selected-global-index ctx env name)]
              (if (< global 0)
                (tc-selected-place-unrepresented (tc-expr-id ctx env id) sink)
                (match (tc-expr-id ctx env id)
                  [(ResultTcType.Err message)
                    (TcSelectedPlaceResult.Err message sink)]
                  [(ResultTcType.Ok type)
                    (tc-selected-global-place-of
                      ctx
                      type
                      global
                      name
                      source
                      sink)])))]))]
    ;; An expansion or an annotation is transparent to the place it forms.
    [(ast.AstExpr.MacroExpansion expanded _ _)
      (tc-infer-selected-place-id ctx env expanded source sink)]
    [(ast.AstExpr.Ann inner _)
      (tc-infer-selected-place-id ctx env inner source sink)]
    [(ast.AstExpr.Spanned inner span)
      (match (tc-infer-selected-place-id
        ctx
        env
        inner
        (ownership.OwnershipSource
          source.path
          (tc-selected-span-line source.line span)
          (tc-selected-span-column source.column span)
          source.expansion)
        sink)
        [(TcSelectedPlaceResult.Ok type place next)
          (TcSelectedPlaceResult.Ok type place next)]
        [(TcSelectedPlaceResult.Err message next)
          (tc-selected-place-unrepresented
            (tc-locate-spanned-error-with-context
              ctx
              env
              (tc-context-expr-get ctx inner)
              span
              message)
            next)])]
    [(ast.AstExpr.TupleRef receiver index)
      (tc-selected-place-tuple
        ctx
        index
        (tc-global-shared-view source)
        (tc-infer-selected-receiver-place ctx env receiver source sink))]
    [(ast.AstExpr.StructGet receiver field)
      (tc-selected-place-field
        ctx
        field
        (tc-global-shared-view source)
        (tc-infer-selected-receiver-place ctx env receiver source sink))]
    [(ast.AstExpr.ArrayRef receiver index)
      (tc-infer-selected-array-place ctx env receiver index source sink)]
    [(ast.AstExpr.BoxTake receiver)
      (tc-selected-place-box
        ctx
        (tc-global-shared-view source)
        (tc-infer-selected-receiver-place ctx env receiver source sink))]
    ;; `(box-get b)` names the same contents place as `box-take`; only the
    ;; access (a read, a borrow) differs, and the consumer decides it.
    [(ast.AstExpr.BoxGet receiver)
      (tc-selected-place-box
        ctx
        (tc-global-shared-view source)
        (tc-infer-selected-receiver-place ctx env receiver source sink))]
    [_ (tc-selected-place-unrepresented (tc-expr-id ctx env id) sink)]))

;; A form the place resolver projects through (as opposed to a value). The
;; bootstrap bridge `(box-get b)` (`__tl-box-place`) names the same contents
;; place as `(deref b)`.
(define (tc-selected-place-form? [ctx : TcContext] [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan expr)
    [(ast.AstExpr.Var _) true]
    [(ast.AstExpr.StructGet _ _) true]
    [(ast.AstExpr.TupleRef _ _) true]
    [(ast.AstExpr.ArrayRef _ _) true]
    [(ast.AstExpr.BoxTake _) true]
    [(ast.AstExpr.BoxGet _) true]
    [(ast.AstExpr.MacroExpansion expanded _ _)
      (tc-selected-place-form? ctx (tc-context-expr-get ctx expanded))]
    [_ false]))

;; The receiver of a projection: a place, or a value held in a temporary.
(define (tc-infer-selected-receiver-place
  [ctx : TcContext]
  [env : TcTypeEnv]
  [id : i64]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedPlaceResult
    store
    lease
    intern
    bind)
  (if (tc-selected-place-form? ctx (tc-context-expr-get ctx id))
    (tc-selected-view-receiver
      ctx
      env
      (tc-global-shared-view source)
      (tc-infer-selected-place-id ctx env id source sink))
    (tc-selected-place-temporary ctx env id source sink)))

;; A receiver held in a move-only view (a value read through a reference and
;; bound by value) is projected through the view, as through the reference it
;; was read from: its parts are borrowed data, not the binder's own.
(define (tc-selected-view-receiver
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source : ownership.OwnershipSource]
  [result : (TcSelectedPlaceResult store lease intern bind)]) : (TcSelectedPlaceResult
    store
    lease
    intern
    bind)
  (match result
    [(TcSelectedPlaceResult.Ok type place sink)
      (match place
        [(TcSelectedPlace.Selected id indices)
          (match sink
            [(TcSelectedSink.Capture store lease bindings)
              (let
                ;; Only a binder holds a view; a projected place (an element
                ;; read through a reference) is the referent storage itself.
                [type-index : i64
                  (match (typed.typed-place-get! store lease id)
                    [(typed.TypedPlaceView.Ok row)
                      (match (& row.kind)
                        [(typed.TypedPlaceKind.Root _) row.type.handle.index]
                        [(typed.TypedPlaceKind.Projection _ _) -1])]
                    [(typed.TypedPlaceView.Err _) -1])]
                [place-type : ast.AstType
                  (if (< type-index 0)
                    ast.AstType.Never
                    (match (typed.typed-type-value-at! store lease type-index)
                      [(typed.TypedTypeValueResult.Ok value) value]
                      [(typed.TypedTypeValueResult.Err _) ast.AstType.Never]))]
                (if (tc-selected-view-binder-type?
                  ctx
                  env
                  (tc-global-shared-view place-type))
                  (let
                    [referent : ast.AstType
                      (tc-resolve-type
                        ctx
                        (tc-selected-strip-regions
                          (tc-resolve-type
                            ctx
                            (tc-global-shared-view place-type))))]
                    (match (tc-selected-place-project
                      (tc-global-shared-view referent)
                      (tc-global-shared-view referent)
                      (TcSelectedPlace.Selected id indices)
                      typed.TypedProjectionKind.Deref
                      source
                      (TcSelectedSink.Capture store lease bindings))
                      [(TcSelectedPlaceResult.Err message next)
                        (TcSelectedPlaceResult.Err message next)]
                      [(TcSelectedPlaceResult.Ok _ derefed next)
                        (TcSelectedPlaceResult.Ok type derefed next)]))
                  (TcSelectedPlaceResult.Ok
                    type
                    (TcSelectedPlace.Selected id indices)
                    (TcSelectedSink.Capture store lease bindings))))]
            [(TcSelectedSink.Query)
              (TcSelectedPlaceResult.Ok
                type
                (TcSelectedPlace.Selected id indices)
                TcSelectedSink.Query)])]
        [(TcSelectedPlace.Unrepresented)
          (TcSelectedPlaceResult.Ok type TcSelectedPlace.Unrepresented sink)])]
    [(TcSelectedPlaceResult.Err message sink)
      (TcSelectedPlaceResult.Err message sink)]))

;; A view binder's type: a region-tagged move-only value of a reference's
;; lifetime (not an arena value).
(define (tc-selected-view-binder-type?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : ast.AstType]) : bool
  (match (tc-resolve-type ctx (tc-global-shared-view ty))
    [(ast.AstType.Region region _)
      (and
        (not (tc-selected-arena-region? env region))
        (not (tc-type-copyable? ctx ty)))]
    [_ false]))

;; A value a projection reads, moves out of or writes in place is held in a
;; temporary, like Rust's place for `f().x`: FormPlace child 0 initializes a
;; Temporary binder from the value. Borrowing such a place stays a legacy
;; error (a borrow needs a local, parameter or aggregate place). A reference
;; result (`(array-ref (slots v) i)`) is held the same way: the projection
;; goes through its referent, and the temporary holds the call's loans. A
;; value that holds references otherwise, a view or a special owner keeps the
;; legacy route.
(define (tc-selected-place-temporary
  [ctx : TcContext]
  [env : TcTypeEnv]
  [id : i64]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedPlaceResult
    store
    lease
    intern
    bind)
  (match sink
    [(TcSelectedSink.Query)
      (tc-selected-place-unrepresented
        (tc-expr-id ctx env id)
        TcSelectedSink.Query)]
    [(TcSelectedSink.Capture store lease bindings)
      (let
        ;; A receiver a `clone` operand reads through
        ;; (`tc-selected-read-receiver-push`).
        [read? : bool
          (tc-selected-read-spine-syntax?
            (& bindings)
            (& (typed.TypedSyntax.Source id)))]
        (match (tc-infer-selected-id
          ctx
          env
          id
          ast.AstMaybeType.No
          (tc-global-shared-view source)
          (TcSelectedSink.Capture store lease bindings))
          [(TcSelectedResult.Err message next)
            (TcSelectedPlaceResult.Err message next)]
          [(TcSelectedResult.Ok ty occurrence next)
            (match occurrence
              [(TcSelectedOccurrence.Unrepresented)
                (TcSelectedPlaceResult.Ok ty TcSelectedPlace.Unrepresented next)]
              [(TcSelectedOccurrence.Selected value)
                (cond
                  [read?
                    (tc-selected-read-receiver-place ctx ty value source next)]
                  [(let
                      ;; A value allocated in an arena (inside `in-arena`) is
                      ;; held like any other: the arena's region tag aside.
                      [held : ast.AstType
                        (tc-resolve-type
                          ctx
                          (tc-selected-strip-arena-tags
                            ctx
                            env
                            (tc-global-shared-view ty)))]
                      (or
                        (tc-selected-value-type-supported?
                          ctx
                          (tc-global-shared-view held))
                        (>
                          (tc-selected-reference-kind
                            ctx
                            (tc-global-shared-view held))
                          0)
                        ;; An aggregate holding references (a call's array or
                        ;; tuple of views): the temporary holds the value's
                        ;; loans, as a local of that type does.
                        (tc-selected-holding-type?
                          ctx
                          (tc-global-shared-view held))
                        (tc-selected-loan-array?
                          ctx
                          (tc-global-shared-view held))))
                    (match next
                      [(TcSelectedSink.Capture store lease bindings)
                        (tc-selected-temporary-place!
                          ty
                          value
                          source
                          store
                          lease
                          bindings)]
                      [(TcSelectedSink.Query)
                        (TcSelectedPlaceResult.Ok
                          ty
                          TcSelectedPlace.Unrepresented
                          TcSelectedSink.Query)])]
                  [else
                    (TcSelectedPlaceResult.Ok
                      ty
                      TcSelectedPlace.Unrepresented
                      next)])])]))]))

;; A projection receiver a `clone` operand reads through: its occurrence is the
;; read reference (`tc-infer-selected-read`), held in a temporary and
;; dereferenced (`tc-selected-place-box`), so the receiver's parts are read
;; where they lie. A receiver that yields its value instead (a Copy one, or
;; one that diverges) is held as that value.
(define (tc-selected-read-receiver-place
  [ctx : TcContext]
  [ty : ast.AstType]
  [value : typed.TypedOccurrenceId]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedPlaceResult
    store
    lease
    intern
    bind)
  (match sink
    [(TcSelectedSink.Query)
      (TcSelectedPlaceResult.Ok
        ty
        TcSelectedPlace.Unrepresented
        TcSelectedSink.Query)]
    [(TcSelectedSink.Capture store lease bindings)
      (let
        [published : ast.AstType
          (tc-selected-occurrence-type! store lease (& value))]
        [reference? : bool
          (match (& published)
            [(ast.AstType.Ref _ _) true]
            [_ false])]
        (if reference?
          (tc-selected-place-box
            ctx
            (ownership.ownership-source-copy (& source))
            (tc-selected-temporary-place!
              published
              value
              source
              store
              lease
              bindings))
          (tc-selected-temporary-place! ty value source store lease bindings)))]))

(define (tc-selected-temporary-place!
  [ty : ast.AstType]
  [value : typed.TypedOccurrenceId]
  [source : ownership.OwnershipSource]
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [bindings : (&mut bind TcSelectedBindings)]) : (TcSelectedPlaceResult
    store
    lease
    intern
    bind)
  (let
    [type-id : typed.TypedTypeId
      (match (typed.typed-type-add! store lease (tc-global-shared-view ty))
        [(typed.TypedTypeIdResult.Ok id) id]
        [(typed.TypedTypeIdResult.Err error)
          (return (tc-selected-place-failed error store lease bindings))])]
    ;; The initialization's own result: Never when its value diverges
    ;; (`tc-selected-flow-never!`).
    [unit-id : typed.TypedTypeId
      (match (typed.typed-type-add!
        store
        lease
        (tc-selected-initialization-type!
          store
          lease
          (typed.TypedOccurrenceId (typed.typed-handle-copy (& value.handle)))))
        [(typed.TypedTypeIdResult.Ok id) id]
        [(typed.TypedTypeIdResult.Err error)
          (return (tc-selected-place-failed error store lease bindings))])]
    [origin : typed.TypedOriginId
      (match (typed.typed-origin-add!
        store
        lease
        (ownership.ownership-source-copy (& source)))
        [(typed.TypedOriginResult.Ok id) id]
        [(typed.TypedOriginResult.Err error)
          (return (tc-selected-place-failed error store lease bindings))])]
    [binder : typed.TypedBinderId
      (match (typed.typed-binder-add!
        store
        lease
        type-id
        typed.TypedBinderKind.Temporary
        (typed.TypedOriginId (typed.typed-handle-copy (& origin.handle)))
        -1)
        [(typed.TypedBinderResult.Ok id) id]
        [(typed.TypedBinderResult.Err error)
          (return (tc-selected-place-failed error store lease bindings))])]
    [place : typed.TypedPlaceId
      (match (typed.typed-place-add!
        store
        lease
        (typed.TypedPlaceKind.Root
          (typed.TypedBinderId (typed.typed-handle-copy (& binder.handle)))))
        [(typed.TypedPlaceResult.Ok id) id]
        [(typed.TypedPlaceResult.Err error)
          (return (tc-selected-place-failed error store lease bindings))])]
    [children : (__tl_dyn-array typed.TypedOccurrenceId)
      (__tl_make-array typed.TypedOccurrenceId 1)]
    (set! (array-ref children 0) value)
    (match (typed.typed-occurrence-add!
      store
      lease
      unit-id
      typed.TypedSyntax.Generated
      origin
      (typed.TypedOperation.Initialize binder)
      (& children))
      [(typed.TypedOccurrenceResult.Ok initialize)
        (let
          [indices : (__tl_dyn-array typed.TypedOccurrenceId)
            (__tl_make-array typed.TypedOccurrenceId 1)]
          (set! (array-ref indices 0) initialize)
          (TcSelectedPlaceResult.Ok
            ty
            (TcSelectedPlace.Selected place indices)
            (TcSelectedSink.Capture store lease bindings)))]
      [(typed.TypedOccurrenceResult.Err error)
        (tc-selected-place-failed error store lease bindings)])))

;; The own type of a selected place, or `fallback` for an unrepresented one.
(define (tc-selected-place-own-type!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [place : (& place TcSelectedPlace)]
  [fallback : (& fallback ast.AstType)]) : ast.AstType
  (match place
    [(TcSelectedPlace.Selected id _)
      (let
        [type-index : i64
          (match (typed.typed-place-get!
            store
            lease
            (typed.TypedPlaceId (typed.typed-handle-copy (& id.handle))))
            [(typed.TypedPlaceView.Ok row) row.type.handle.index]
            [(typed.TypedPlaceView.Err _) -1])]
        (if (< type-index 0)
          (clone (deref fallback))
          (match (typed.typed-type-value-at! store lease type-index)
            [(typed.TypedTypeValueResult.Ok value) value]
            [(typed.TypedTypeValueResult.Err _) (clone (deref fallback))])))]
    [(TcSelectedPlace.Unrepresented) (clone (deref fallback))]))

;; `(deref box)` as a place: the contents of an owned box, or the referent of
;; a supported reference. A place's own type follows its parent place's own
;; type, never the type a by-value read of the parent reports: a box reached
;; through a reference reads as a view tagged with that reference's lifetime,
;; but its contents are the referent's own storage, which `replace!` takes out
;; and `set!` fills as an owned value. A tag of the box's own type (an arena
;; box) stays on its contents.
(define (tc-selected-place-box
  [ctx : TcContext]
  [source : ownership.OwnershipSource]
  [receiver : (TcSelectedPlaceResult store lease intern bind)]) : (TcSelectedPlaceResult
    store
    lease
    intern
    bind)
  (match receiver
    [(TcSelectedPlaceResult.Err message next)
      (TcSelectedPlaceResult.Err message next)]
    [(TcSelectedPlaceResult.Ok type place next)
      (match (tc-type-strip-region
        (tc-resolve-type ctx (tc-global-shared-view type)))
        [(ast.AstType.Box inner)
          (let
            [contents : ast.AstType
              (tc-project-from-region-container
                (tc-global-shared-view type)
                (ast.ty-node-get inner))]
            (match next
              [(TcSelectedSink.Capture store lease bindings)
                (let
                  [owned : ast.AstType
                    (tc-project-from-region-container
                      (tc-selected-place-own-type!
                        store
                        lease
                        (& place)
                        (& type))
                      (ast.ty-node-get inner))]
                  (tc-selected-place-project
                    contents
                    owned
                    place
                    typed.TypedProjectionKind.Deref
                    source
                    (TcSelectedSink.Capture store lease bindings)))]
              [(TcSelectedSink.Query)
                (tc-selected-place-project
                  (tc-global-shared-view contents)
                  contents
                  place
                  typed.TypedProjectionKind.Deref
                  source
                  TcSelectedSink.Query)]))]
        [_
          (match (tc-deref-result-type ctx (tc-global-shared-view type))
            [(ResultTcType.Ok contents)
              ;; A reference's referent: reads and writes through it use the
              ;; reference's loan. An explicit `deref` names the referent
              ;; itself, not a view of it, so taking a move-only value out of
              ;; it is a move out of the reference (legacy rejects it).
              (if (tc-selected-deref-referent-ok?
                ctx
                (tc-global-shared-view type))
                (let
                  [referent : ast.AstType
                    (tc-type-strip-region (tc-global-shared-view contents))]
                  (tc-selected-place-project
                    (tc-global-shared-view referent)
                    referent
                    place
                    typed.TypedProjectionKind.Deref
                    source
                    next))
                (TcSelectedPlaceResult.Ok
                  contents
                  TcSelectedPlace.Unrepresented
                  next))]
            [(ResultTcType.Err message)
              (TcSelectedPlaceResult.Err message next)])])]))

;; A reference whose referent the place subset projects: a supported
;; reference (`tc-selected-reference-kind`) to anything but borrowed text.
(define (tc-selected-deref-referent-ok? [ctx : TcContext] [type : ast.AstType]) : bool
  (let
    [resolved : ast.AstType (tc-type-strip-region (tc-resolve-type ctx type))]
    (and
      (!= (tc-selected-reference-kind ctx (tc-global-shared-view resolved)) 0)
      (match (tc-global-shared-view resolved)
        [(ast.AstType.Ref _ inner)
          (match (tc-resolve-type ctx (tc-context-type-get ctx inner))
            [(ast.AstType.Str) false]
            [_ true])]
        [(ast.AstType.MutRef _ inner)
          (match (tc-resolve-type ctx (tc-context-type-get ctx inner))
            [(ast.AstType.Str) false]
            [_ true])]
        [_ false]))))

;; `(deref value)`: a place receiver projects its box's contents (a Copy value
;; is read, a move-only one consumes the box); an evaluated box is consumed;
;; an evaluated reference to a Copy value is read through (form 147). Other
;; reference receivers keep the legacy route.
;; A reference receiver whose referent is Copy: a dereference reads a copy.
(define (tc-selected-copy-referent-receiver?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [receiver : i64]) : bool
  (match (tc-expr-id ctx env receiver)
    [(ResultTcType.Ok receiver-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
        [(ast.AstType.Ref _ inner)
          (tc-type-copyable? ctx (tc-context-type-get ctx inner))]
        [(ast.AstType.MutRef _ inner)
          (tc-type-copyable? ctx (tc-context-type-get ctx inner))]
        [_ false])]
    [(ResultTcType.Err _) false]))

;; A place expression whose projection chain passes through an array element.
(define (tc-selected-element-place-expression?
  [ctx : TcContext]
  [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan expr)
    [(ast.AstExpr.ArrayRef _ _) true]
    [(ast.AstExpr.StructGet base _)
      (tc-selected-element-place-expression? ctx (tc-context-expr-get ctx base))]
    [(ast.AstExpr.TupleRef base _)
      (tc-selected-element-place-expression? ctx (tc-context-expr-get ctx base))]
    [(ast.AstExpr.MacroExpansion expanded _ _)
      (tc-selected-element-place-expression?
        ctx
        (tc-context-expr-get ctx expanded))]
    [_ false]))

;; `(deref receiver)` read by value: an opaque value is unusable by value
;; outside its module family (#8734), as `tc-deref-expr` checks. Typing
;; reports any other failure.
(define (tc-selected-deref-opaque-ok
  [ctx : TcContext]
  [env : TcTypeEnv]
  [receiver : i64]) : ResultTcUnit
  (if (not (tc-job-state-opaque-program? (tc-context-job-state ctx)))
    ResultTcUnit.Ok
    (match (tc-expr-id ctx env receiver)
      [(ResultTcType.Err _) ResultTcUnit.Ok]
      [(ResultTcType.Ok receiver-ty)
        (match (tc-deref-result-type ctx receiver-ty)
          [(ResultTcType.Err _) ResultTcUnit.Ok]
          [(ResultTcType.Ok ty)
            (tc-opaque-by-value-ok ctx ty "cannot dereference by value the")])])))

(define (tc-infer-selected-deref
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : ast.AstExpr]
  [receiver : i64]
  [syntax : typed.TypedSyntax]
  [expected : ast.AstMaybeType]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match (tc-selected-deref-opaque-ok ctx env receiver)
    [(ResultTcUnit.Err message) (TcSelectedResult.Err message sink)]
    [(ResultTcUnit.Ok)
      (cond
        ;; A reference read out of an array element: the graph reaches an element
        ;; only as access to the whole array, never the referent behind it, so a
        ;; Copy read goes through the evaluated reference (the element read uses
        ;; the array and the loans it carries).
        [(and
            (tc-selected-element-place-expression?
              ctx
              (tc-context-expr-get ctx receiver))
            (tc-selected-copy-referent-receiver? ctx env receiver))
          (tc-infer-selected-form
            ctx
            env
            expr
            (tc-selected-form-code-deref-read)
            (tc-selected-ids1 receiver)
            (tc-selected-ids1 0)
            syntax
            expected
            source
            sink)]
        [(tc-selected-place-expression? ctx (tc-context-expr-get ctx receiver))
          (tc-selected-contextual-result
            ctx
            env
            (tc-global-shared-view expected)
            (tc-selected-place-acquire
              ctx
              env
              false
              (tc-global-shared-view expected)
              syntax
              (tc-global-shared-view source)
              (tc-selected-place-box
                ctx
                (tc-global-shared-view source)
                (tc-infer-selected-place-id
                  ctx
                  env
                  receiver
                  (tc-global-shared-view source)
                  sink))))]
        [(match (tc-expr-id ctx env receiver)
            [(ResultTcType.Ok receiver-ty)
              (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
                [(ast.AstType.Box _) true]
                [_ false])]
            [(ResultTcType.Err _) false])
          (tc-infer-selected-form
            ctx
            env
            expr
            (tc-selected-form-code-deref-value)
            (tc-selected-ids1 receiver)
            (tc-selected-ids1 2)
            syntax
            expected
            source
            sink)]
        [(tc-selected-copy-referent-receiver? ctx env receiver)
          (tc-infer-selected-form
            ctx
            env
            expr
            (tc-selected-form-code-deref-read)
            (tc-selected-ids1 receiver)
            (tc-selected-ids1 0)
            syntax
            expected
            source
            sink)]
        ;; The referent of a computed reference is the place `*{e}` through a
        ;; temporary holding the reference (`tc-selected-place-temporary`),
        ;; read as the referent's own value: a move-only one taken there is a
        ;; move out of the reference, which the graph rejects.
        [(match (tc-expr-id ctx env receiver)
            [(ResultTcType.Ok receiver-ty)
              (tc-selected-deref-referent-ok? ctx receiver-ty)]
            [(ResultTcType.Err _) false])
          (tc-selected-contextual-result
            ctx
            env
            (tc-global-shared-view expected)
            (tc-selected-place-acquire
              ctx
              env
              false
              expected
              syntax
              (tc-global-shared-view source)
              (tc-selected-place-box
                ctx
                (tc-global-shared-view source)
                (tc-selected-place-temporary ctx env receiver source sink))))]
        [else
          (tc-selected-unrepresented
            (tc-infer-selected-legacy ctx env expr syntax expected)
            sink)])]))

(defenum TcSelectedMaybeRegion
  (Some i64)
  (No))

;; `type`'s outer region tag when it is one of the body's arena `regions` or
;; another region the graph erases as an arena's.
(define (tc-selected-arena-view-region
  [ctx : TcContext]
  [regions : (__tl_dyn-array i64)]
  [type : ast.AstType]) : TcSelectedMaybeRegion
  (match (tc-global-shared-view type)
    [(ast.AstType.Region region _)
      (if (tc-selected-arena-region-in? ctx (& regions) region)
        (TcSelectedMaybeRegion.Some region)
        TcSelectedMaybeRegion.No)]
    [_ TcSelectedMaybeRegion.No]))

;; An expected reference type: the value flows into a reference slot.
(define (tc-selected-expects-reference?
  [ctx : TcContext]
  [expected : ast.AstMaybeType]) : bool
  (match expected
    [(ast.AstMaybeType.Some want)
      (match (tc-resolve-type ctx (tc-global-shared-view want))
        [(ast.AstType.Ref _ _) true]
        [(ast.AstType.MutRef _ _) true]
        [_ false])]
    [(ast.AstMaybeType.No) false]))

(define (tc-selected-place-acquire
  [ctx : TcContext]
  [env : TcTypeEnv]
  ;; The place's value flows where a reference is expected (an argument for a
  ;; reference parameter, a builtin's read operand), whether or not `expected`
  ;; states it.
  [lent? : bool]
  ;; The type the value is used as, when the use states one.
  [expected : ast.AstMaybeType]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [result : (TcSelectedPlaceResult store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    [reference? : bool
      (or
        lent?
        (tc-selected-expects-reference? ctx (tc-global-shared-view expected)))]
    (match result
      [(TcSelectedPlaceResult.Err message sink)
        (TcSelectedResult.Err message sink)]
      [(TcSelectedPlaceResult.Ok type place sink)
        (if (not (ownership.ownership-source-valid? (& source)))
          (tc-selected-unrepresented (ResultTcType.Ok type) sink)
          (match place
            [(TcSelectedPlace.Unrepresented)
              (tc-selected-unrepresented (ResultTcType.Ok type) sink)]
            ;; A move-only aggregate read through a reference is a region-tagged
            ;; view of the place, checked as a shared reborrow while the view is
            ;; used; a Copy one is copied out.
            [(TcSelectedPlace.Selected id indices)
              (if (and
                (match (& type)
                  [(ast.AstType.Region _ _) true]
                  [_ false])
                (not (tc-type-copyable? ctx (tc-global-shared-view type))))
                (match sink
                  [(TcSelectedSink.Capture store lease bindings)
                    (match (tc-selected-arena-view-region
                      ctx
                      (typed.typed-arena-regions-copy (& store))
                      (tc-global-shared-view type))
                      ;; An arena region tag marks where the value is allocated,
                      ;; not a borrow, and the graph erases it: such a place is
                      ;; owned storage, borrowed where a reference is expected
                      ;; (the expression keeps its value type) and otherwise
                      ;; read as a value.
                      [(TcSelectedMaybeRegion.Some region)
                        (if reference?
                          (match (tc-selected-publish-borrow
                            (ast.ast-ty-ref region (& type))
                            false
                            id
                            indices
                            syntax
                            source
                            (TcSelectedSink.Capture store lease bindings))
                            [(TcSelectedResult.Ok _ occurrence next)
                              (TcSelectedResult.Ok type occurrence next)]
                            [(TcSelectedResult.Err message next)
                              (TcSelectedResult.Err message next)])
                          (tc-selected-place-read
                            ctx
                            type
                            id
                            indices
                            syntax
                            source
                            (TcSelectedSink.Capture store lease bindings)))]
                      ;; A view used as the owned value it views (an argument
                      ;; or field of its plain type, a result) takes that
                      ;; value: the graph rejects the move out of the
                      ;; reference it is read through (E0208, Rust E0507).
                      [(TcSelectedMaybeRegion.No)
                        (if (match expected
                          [(ast.AstMaybeType.Some want)
                            (tc-selected-view-move-out?
                              ctx
                              env
                              want
                              (tc-global-shared-view type))]
                          [(ast.AstMaybeType.No) false])
                          (tc-selected-place-read
                            ctx
                            (tc-selected-strip-regions type)
                            id
                            indices
                            syntax
                            source
                            (TcSelectedSink.Capture store lease bindings))
                          (tc-selected-publish-borrow
                            type
                            false
                            id
                            indices
                            syntax
                            source
                            (TcSelectedSink.Capture store lease bindings)))])]
                  [(TcSelectedSink.Query)
                    (tc-selected-publish-borrow
                      type
                      false
                      id
                      indices
                      syntax
                      source
                      TcSelectedSink.Query)])
                (tc-selected-place-read ctx type id indices syntax source sink))]))])))

;; A place read as its value: a Copy place copied, any other moved.
(define (tc-selected-place-read
  [ctx : TcContext]
  [type : ast.AstType]
  [id : typed.TypedPlaceId]
  [indices : (__tl_dyn-array typed.TypedOccurrenceId)]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match sink
    [(TcSelectedSink.Query)
      (TcSelectedResult.Err
        (tc-selected-error typed.TypedError.Query)
        TcSelectedSink.Query)]
    [(TcSelectedSink.Capture store lease bindings)
      (let
        [_exit : unit
          (match (tc-selected-place-exit! store lease (& indices))
            [(TcSelectedIndexCut.Err error)
              (return (tc-selected-failed error store lease bindings))]
            [(TcSelectedIndexCut.Ok cut)
              (when
                (> cut 0)
                (return
                  (tc-selected-place-exit-publish
                    (ResultTcType.Ok (tc-global-shared-view type))
                    (tc-global-shared-view syntax)
                    (tc-global-shared-view source)
                    (& indices)
                    cut
                    (TcSelectedSink.Capture store lease bindings))))])]
        [type-id : typed.TypedTypeId
          (match (typed.typed-place-get! store lease id)
            [(typed.TypedPlaceView.Ok row)
              ;; A fresh value: the row lives in store storage that the
              ;; following additions may grow and move.
              (typed.TypedTypeId (typed.typed-handle-copy (& row.type.handle)))]
            [(typed.TypedPlaceView.Err error)
              (return (tc-selected-failed error store lease bindings))])]
        [origin : typed.TypedOriginId
          (match (typed.typed-origin-add! store lease source)
            [(typed.TypedOriginResult.Ok value) value]
            [(typed.TypedOriginResult.Err error)
              (return (tc-selected-failed error store lease bindings))])]
        [formation : typed.TypedOccurrenceId
          (match (typed.typed-occurrence-add!
            store
            lease
            type-id
            syntax
            origin
            (typed.TypedOperation.FormPlace id)
            (& indices))
            [(typed.TypedOccurrenceResult.Ok value) value]
            [(typed.TypedOccurrenceResult.Err error)
              (return (tc-selected-failed error store lease bindings))])]
        [_charged : unit
          (match (typed.typed-charge!
            store
            lease
            (comptime (size-of (type typed.TypedOccurrenceId))))
            [(typed.TypedResult.Ok _) unit]
            [(typed.TypedResult.Err error)
              (return (tc-selected-failed error store lease bindings))])]
        [children : (__tl_dyn-array typed.TypedOccurrenceId)
          (__tl_make-array formation)]
        [operation : typed.TypedOperation
          (if (tc-type-copyable? ctx (tc-global-shared-view type))
            (typed.TypedOperation.CopyPlace id)
            (typed.TypedOperation.MovePlace id))]
        (match (typed.typed-occurrence-add!
          store
          lease
          type-id
          syntax
          origin
          operation
          (& children))
          [(typed.TypedOccurrenceResult.Ok value)
            (TcSelectedResult.Ok
              type
              (TcSelectedOccurrence.Selected value)
              (TcSelectedSink.Capture store lease bindings))]
          [(typed.TypedOccurrenceResult.Err error)
            (tc-selected-failed error store lease bindings)]))]))

;; `(set! receiver.field value)`: the legacy field-mutation checks, in its order,
;; with the value inferred once against the field type; then the field place
;; is formed and the value moved into it.
(define (tc-infer-selected-struct-set
  [ctx : TcContext]
  [env : TcTypeEnv]
  [receiver-id : i64]
  [field : i64]
  [value-id : i64]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    [receiver : ast.AstExpr (tc-context-expr-get ctx receiver-id)]
    [value : ast.AstExpr (tc-context-expr-get ctx value-id)]
    [label : String
      (if (ast.ast-tuple-set-field-id? field)
        "tuple element"
        "struct field")]
    (match (tc-store-place-lifetime ctx env (tc-global-shared-view receiver))
      [(ResultTcNameId.Err message) (TcSelectedResult.Err message sink)]
      [(ResultTcNameId.Ok _)
        (match (tc-field-receiver-type ctx env (tc-global-shared-view receiver))
          [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
          [(ResultTcType.Ok receiver-ty)
            (match (tc-struct-mutable-field-type-id ctx env receiver-ty field)
              [(ResultTcType.Err message) (TcSelectedResult.Err message sink)]
              [(ResultTcType.Ok field-ty)
                (if (tc-raw-deref-place?
                  ctx
                  env
                  (tc-global-shared-view receiver))
                  (match (tc-expr-with-expected-or-actual-id
                    ctx
                    env
                    value-id
                    (tc-type-strip-region (tc-global-shared-view field-ty)))
                    [(ResultTcType.Err message)
                      (TcSelectedResult.Err message sink)]
                    [(ResultTcType.Ok value-ty)
                      (match (tc-selected-field-store-ok
                        ctx
                        env
                        (tc-global-shared-view receiver)
                        (tc-global-shared-view value)
                        (tc-global-shared-view field-ty)
                        value-ty
                        field
                        (tc-global-shared-view label))
                        [(ResultTcUnit.Err message)
                          (TcSelectedResult.Err message sink)]
                        [(ResultTcUnit.Ok)
                          (tc-infer-selected-raw-store
                            ctx
                            env
                            receiver-id
                            -1
                            value-id
                            (tc-type-strip-region
                              (tc-global-shared-view field-ty))
                            syntax
                            source
                            sink)])])
                  (match (let
                    ;; A view binder's fields are the viewed storage's
                    ;; (`tc-selected-view-receiver`): the store writes through
                    ;; the view, as every other write to a view's part does.
                    [receiver-place : (TcSelectedPlaceResult
                      store
                      lease
                      intern
                      bind)
                      (tc-selected-view-receiver
                        ctx
                        env
                        (ownership.ownership-source-copy (& source))
                        (tc-infer-selected-place-id
                          ctx
                          env
                          receiver-id
                          (tc-global-shared-view source)
                          sink))]
                    ;; A tuple element store names its element by index.
                    (if (ast.ast-tuple-set-field-id? field)
                      (tc-selected-place-tuple
                        ctx
                        (ast.ast-tuple-set-index-from-field-id field)
                        (tc-global-shared-view source)
                        receiver-place)
                      (tc-selected-place-field
                        ctx
                        field
                        (tc-global-shared-view source)
                        receiver-place)))
                    [(TcSelectedPlaceResult.Err message next)
                      (TcSelectedResult.Err message next)]
                    [(TcSelectedPlaceResult.Ok _ place next)
                      ;; The stored value is owned: a field reached through a
                      ;; reference is a view only when read.
                      (match (tc-infer-selected-id
                        ctx
                        env
                        value-id
                        (ast.AstMaybeType.Some
                          (tc-type-strip-region
                            (tc-global-shared-view field-ty)))
                        (tc-global-shared-view source)
                        next)
                        [(TcSelectedResult.Err message after)
                          (TcSelectedResult.Err message after)]
                        [(TcSelectedResult.Ok value-ty occurrence after)
                          (match (tc-selected-field-store-ok
                            ctx
                            env
                            (tc-global-shared-view receiver)
                            (tc-global-shared-view value)
                            (tc-global-shared-view field-ty)
                            (tc-global-shared-view value-ty)
                            field
                            (tc-global-shared-view label))
                            [(ResultTcUnit.Err message)
                              (TcSelectedResult.Err message after)]
                            [(ResultTcUnit.Ok)
                              ;; The value has the field's type as the graph
                              ;; sees types: a Copy value read through a
                              ;; reference (`(in p T)`) is a plain `T` there
                              ;; (`tc-selected-canonical-type`). A view of a
                              ;; move-only value stored back keeps the legacy
                              ;; route.
                              (if (tc-selected-same-type?
                                (tc-selected-canonical-type
                                  ctx
                                  (tc-type-strip-region
                                    (tc-global-shared-view field-ty)))
                                (tc-selected-canonical-type
                                  ctx
                                  (tc-global-shared-view value-ty)))
                                (tc-selected-place-assign
                                  (ResultTcType.Ok ast.AstType.Unit)
                                  false
                                  syntax
                                  source
                                  place
                                  occurrence
                                  after)
                                (tc-selected-unrepresented
                                  (ResultTcType.Ok ast.AstType.Unit)
                                  after))])])]))])])])))

;; The checks after inference that `tc-struct-field-mutation-value-id` makes.
(define (tc-selected-field-store-ok
  [ctx : TcContext]
  [env : TcTypeEnv]
  [receiver : ast.AstExpr]
  [value : ast.AstExpr]
  [field-ty : ast.AstType]
  [value-ty : ast.AstType]
  [field : i64]
  [label : String]) : ResultTcUnit
  (match (tc-expect
    (tc-global-shared-view value-ty)
    (tc-global-shared-view field-ty)
    (if (ast.ast-tuple-set-field-id? field)
      (tc-kind-message
        (cdiag.CompilerTypecheckKind.TypeMismatch)
        "typecheck: tuple element assignment type mismatch")
      (tc-kind-message
        (cdiag.CompilerTypecheckKind.TypeMismatch)
        "typecheck: struct field assignment type mismatch")))
    [(ResultTcUnit.Err message) (return (ResultTcUnit.Err message))]
    [(ResultTcUnit.Ok) unit])
  (match (tc-ensure-cleanup-resource-not-stored-expr ctx env value)
    [(ResultTcUnit.Err message) (return (ResultTcUnit.Err message))]
    [(ResultTcUnit.Ok) unit])
  (match (tc-ensure-region-value-can-flow-into
    env
    (tc-global-shared-view field-ty)
    (tc-global-shared-view value-ty)
    (tc-global-shared-view label))
    [(ResultTcUnit.Err message) (return (ResultTcUnit.Err message))]
    [(ResultTcUnit.Ok) unit])
  (match (if (ast.ast-tuple-set-field-id? field)
    (tc-expr ctx env (tc-global-shared-view receiver))
    (tc-field-receiver-type ctx env (tc-global-shared-view receiver)))
    [(ResultTcType.Err message) (ResultTcUnit.Err message)]
    [(ResultTcType.Ok receiver-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
        ;; `b.f` with `b : (&mut m T)` stores through the reference: its
        ;; references must outlive the field's own lifetime, which `m` does
        ;; not bound (#8584).
        [(ast.AstType.MutRef lifetime referent)
          (tc-ensure-reference-lifetimes-can-store-at
            env
            (tc-type-collect-reference-lifetimes value-ty)
            (tc-store-place-reference-target ctx lifetime referent)
            label)]
        [_
          (tc-ensure-reference-value-can-store-in-place
            ctx
            env
            receiver
            value-ty
            label)])]))

;; Forms `place` and moves the value occurrence into it.
(define (tc-selected-place-assign
  ;; Unit for an assignment; the old value's type for a `replace!`.
  [result : ResultTcType]
  [replace? : bool]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [place : TcSelectedPlace]
  [value : TcSelectedOccurrence]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (match place
    [(TcSelectedPlace.Unrepresented)
      (tc-selected-unrepresented (tc-global-shared-view result) sink)]
    [(TcSelectedPlace.Selected id indices)
      (match value
        [(TcSelectedOccurrence.Unrepresented)
          (tc-selected-unrepresented (tc-global-shared-view result) sink)]
        [(TcSelectedOccurrence.Selected child)
          (match sink
            [(TcSelectedSink.Query)
              (tc-selected-unrepresented
                (tc-global-shared-view result)
                TcSelectedSink.Query)]
            [(TcSelectedSink.Capture store lease bindings)
              (if (not (ownership.ownership-source-valid? (& source)))
                (tc-selected-unrepresented
                  (tc-global-shared-view result)
                  (TcSelectedSink.Capture store lease bindings))
                (let
                  [_exit : unit
                    (match (tc-selected-place-exit! store lease (& indices))
                      [(TcSelectedIndexCut.Err error)
                        (return (tc-selected-failed error store lease bindings))]
                      [(TcSelectedIndexCut.Ok cut)
                        (when
                          (> cut 0)
                          (return
                            (tc-selected-place-exit-publish
                              (tc-global-shared-view result)
                              (tc-global-shared-view syntax)
                              (tc-global-shared-view source)
                              (& indices)
                              cut
                              (TcSelectedSink.Capture store lease bindings))))])]
                  [type-id : typed.TypedTypeId
                    (match (typed.typed-place-get! store lease id)
                      [(typed.TypedPlaceView.Ok row)
                        (typed.TypedTypeId
                          (typed.typed-handle-copy (& row.type.handle)))]
                      [(typed.TypedPlaceView.Err error)
                        (return (tc-selected-failed error store lease bindings))])]
                  [origin : typed.TypedOriginId
                    (match (typed.typed-origin-add!
                      store
                      lease
                      (tc-global-shared-view source))
                      [(typed.TypedOriginResult.Ok value) value]
                      [(typed.TypedOriginResult.Err error)
                        (return (tc-selected-failed error store lease bindings))])]
                  [formation : typed.TypedOccurrenceId
                    (match (typed.typed-occurrence-add!
                      store
                      lease
                      type-id
                      (tc-global-shared-view syntax)
                      origin
                      (typed.TypedOperation.FormPlace
                        (typed.TypedPlaceId
                          (typed.typed-handle-copy (& id.handle))))
                      (& indices))
                      [(typed.TypedOccurrenceResult.Ok value) value]
                      [(typed.TypedOccurrenceResult.Err error)
                        (return (tc-selected-failed error store lease bindings))])]
                  (tc-selected-publish
                    (tc-global-shared-view result)
                    syntax
                    source
                    (if replace?
                      (typed.TypedOperation.ReplacePlace
                        (typed.TypedPlaceId
                          (typed.typed-handle-copy (& id.handle))))
                      (typed.TypedOperation.AssignPlace id))
                    (let
                      [children : (__tl_dyn-array typed.TypedOccurrenceId)
                        (__tl_make-array typed.TypedOccurrenceId 2)]
                      (set! (array-ref children 0) formation)
                      (set! (array-ref children 1) child)
                      children)
                    (TcSelectedSink.Capture store lease bindings))))])])]))

(define (tc-infer-selected-tuple-ref
  [ctx : TcContext]
  [env : TcTypeEnv]
  [receiver : i64]
  [index : i64]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    [place
      : (TcSelectedPlaceResult store lease intern bind)
      ;; A value receiver (a call's tuple) is held in a temporary, as for
      ;; a field read (`tc-infer-selected-receiver-place`).
      (tc-selected-place-tuple
        ctx
        index
        (tc-global-shared-view source)
        (tc-infer-selected-receiver-place
          ctx
          env
          receiver
          (tc-global-shared-view source)
          sink))]
    (tc-selected-place-acquire
      ctx
      env
      false
      ast.AstMaybeType.No
      syntax
      source
      place)))

;; An integer literal index, through `ann` and `cast` as legacy reads it, or -1.
(define (tc-selected-literal-index [ctx : TcContext] [index : ast.AstExpr]) : i64
  (match (ast.ast-expr-unspan index)
    [(ast.AstExpr.Literal literal)
      (match literal
        [(ast.AstLiteral.Int value text)
          (ast.ast-int-literal-value-or-payload value text)]
        [_ -1])]
    [(ast.AstExpr.Ann inner _)
      (tc-selected-literal-index ctx (tc-context-expr-get ctx inner))]
    [(ast.AstExpr.Cast inner _)
      (tc-selected-literal-index ctx (tc-context-expr-get ctx inner))]
    [_ -1]))

;; The exact element path of `(array-ref receiver index)` (SPEC: literal-index
;; moves and stores): a move-only element of an owned fixed array at an integer
;; literal index in range, or -1. Other elements are indexed parts of the array.
;; A literal read through `ann` and `cast` counts, as legacy reads it.
(define (tc-selected-exact-element
  [ctx : TcContext]
  [container : ast.AstType]
  [index : ast.AstExpr]) : i64
  (let
    [literal : i64 (tc-selected-literal-index ctx index)]
    ;; A region-tagged array may be a view read through a reference: its
    ;; elements are not owned paths.
    (match (tc-resolve-type ctx (tc-global-shared-view container))
      [(ast.AstType.Array element size)
        (if (and
          (>= literal 0)
          (< literal size)
          (not (tc-type-copyable? ctx (ast.ty-node-get element))))
          literal
          -1)]
      [_ -1])))

;; Match the canonical ArrayRef checking order: receiver, contextual index,
;; then receiver classification. A failed receiver type still checks its index.
(define (tc-infer-selected-array-place
  [ctx : TcContext]
  [env : TcTypeEnv]
  [receiver : i64]
  [index : i64]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedPlaceResult
    store
    lease
    intern
    bind)
  (match (tc-infer-selected-receiver-place
    ctx
    env
    receiver
    (tc-global-shared-view source)
    sink)
    [(TcSelectedPlaceResult.Err message next)
      (TcSelectedPlaceResult.Err message next)]
    [(TcSelectedPlaceResult.Ok type place next)
      (let
        [exact : i64
          (tc-selected-exact-element
            ctx
            (tc-global-shared-view type)
            (tc-context-expr-get ctx index))]
        (tc-selected-array-after-index
          ctx
          type
          place
          exact
          (tc-global-shared-view source)
          ;; An exact path's literal index evaluates nothing.
          (if (>= exact 0)
            (TcSelectedResult.Ok
              ast.AstType.I64
              TcSelectedOccurrence.Unrepresented
              next)
            (tc-infer-selected-id
              ctx
              env
              index
              (ast.AstMaybeType.Some ast.AstType.I64)
              source
              next))))]))

(define (tc-selected-array-after-index
  [ctx : TcContext]
  [container : ast.AstType]
  [place : TcSelectedPlace]
  ;; The literal index of an exact element path, or -1.
  [exact : i64]
  [source : ownership.OwnershipSource]
  [index : (TcSelectedResult store lease intern bind)]) : (TcSelectedPlaceResult
    store
    lease
    intern
    bind)
  (match index
    [(TcSelectedResult.Err message sink)
      (TcSelectedPlaceResult.Err message sink)]
    [(TcSelectedResult.Ok index-type occurrence sink)
      (if (not (tc-integer-type? index-type))
        (TcSelectedPlaceResult.Err
          "typecheck: array index must be integer"
          sink)
        (let
          ;; Dereference and Slice provenance require a separate place step.
          ;; Preserve their canonical acceptance without inventing that step.
          [owned : bool
            (match (tc-type-strip-region (tc-global-shared-view container))
              [(ast.AstType.Array _ _) true]
              [(ast.AstType.DynArray _) true]
              [_ false])]
          (match (tc-array-readable-receiver
            ctx
            (tc-global-shared-view container))
            [(ResultTcArrayReceiver.Err message)
              (TcSelectedPlaceResult.Err message sink)]
            [(ResultTcArrayReceiver.Ok receiver)
              (match receiver
                [(TcArrayReceiver container-type element)
                  (let
                    ;; A slice's element read through the reference is the
                    ;; referent's own value of its plain type, as an array's
                    ;; is (`tc-array-readable-receiver` names the referent
                    ;; array as the container, but the slice's reference).
                    [type : ast.AstType
                      (if (tc-selected-slice-container?
                        ctx
                        (tc-global-shared-view container))
                        element
                        (tc-project-from-region-container
                          container-type
                          element))]
                    (if owned
                      (tc-selected-array-project
                        type
                        place
                        exact
                        occurrence
                        source
                        sink)
                      ;; Through a reference, the element is projected from
                      ;; the referent array or slice: the place `(deref r)[i]`.
                      (match (tc-selected-array-referent
                        ctx
                        (tc-global-shared-view container))
                        [(ast.AstMaybeType.Some referent)
                          (match (tc-selected-place-project
                            (tc-global-shared-view referent)
                            (tc-global-shared-view referent)
                            place
                            typed.TypedProjectionKind.Deref
                            (tc-global-shared-view source)
                            sink)
                            [(TcSelectedPlaceResult.Err message next)
                              (TcSelectedPlaceResult.Err message next)]
                            [(TcSelectedPlaceResult.Ok _ derefed next)
                              (tc-selected-array-project
                                type
                                derefed
                                -1
                                occurrence
                                source
                                next)])]
                        [(ast.AstMaybeType.No)
                          (TcSelectedPlaceResult.Ok
                            type
                            TcSelectedPlace.Unrepresented
                            sink)])))])])))]))

;; Whether `container` is a reference to a slice.
(define (tc-selected-slice-container?
  [ctx : TcContext]
  [container : ast.AstType]) : bool
  (match (tc-selected-array-referent ctx container)
    [(ast.AstMaybeType.Some referent)
      (match (tc-type-strip-region referent)
        [(ast.AstType.Slice _) true]
        [_ false])]
    [(ast.AstMaybeType.No) false]))

;; The array a reference receiver refers to, if any.
(define (tc-selected-array-referent [ctx : TcContext] [container : ast.AstType]) : ast.AstMaybeType
  (match (tc-type-strip-region container)
    [(ast.AstType.Ref _ inner) (tc-selected-array-referent-of ctx inner)]
    [(ast.AstType.MutRef _ inner) (tc-selected-array-referent-of ctx inner)]
    [_ ast.AstMaybeType.No]))

(define (tc-selected-array-referent-of [ctx : TcContext] [inner : i64]) : ast.AstMaybeType
  (let
    [referent : ast.AstType
      (tc-resolve-type ctx (tc-context-type-get ctx inner))]
    (match (tc-type-strip-region (tc-global-shared-view referent))
      [(ast.AstType.Array _ _) (ast.AstMaybeType.Some referent)]
      [(ast.AstType.DynArray _) (ast.AstMaybeType.Some referent)]
      ;; A slice's elements are parts of its (opaque) referent.
      [(ast.AstType.Slice _) (ast.AstMaybeType.Some referent)]
      [_ ast.AstMaybeType.No])))

(define (tc-selected-array-project
  [type : ast.AstType]
  [place : TcSelectedPlace]
  ;; The literal index of an exact element path, or -1.
  [exact : i64]
  [occurrence : TcSelectedOccurrence]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedPlaceResult
    store
    lease
    intern
    bind)
  (match place
    [(TcSelectedPlace.Unrepresented)
      (TcSelectedPlaceResult.Ok type TcSelectedPlace.Unrepresented sink)]
    [(TcSelectedPlace.Selected parent indices)
      (match occurrence
        [(TcSelectedOccurrence.Unrepresented)
          (if (>= exact 0)
            (tc-selected-place-project
              (tc-global-shared-view type)
              (tc-selected-strip-regions type)
              (TcSelectedPlace.Selected parent indices)
              (typed.TypedProjectionKind.FixedArrayElement exact)
              source
              sink)
            (TcSelectedPlaceResult.Ok type TcSelectedPlace.Unrepresented sink))]
        [(TcSelectedOccurrence.Selected index)
          (match sink
            [(TcSelectedSink.Query)
              (TcSelectedPlaceResult.Err
                (tc-selected-error typed.TypedError.Query)
                TcSelectedSink.Query)]
            ;; A diverging index stays in the place: forming it is an exit
            ;; (`tc-selected-place-exit!`).
            [(TcSelectedSink.Capture store lease bindings)
              (let
                [count : i64 (array-length indices)]
                [_charged : unit
                  (match (typed.typed-charge!
                    store
                    lease
                    (*
                      (+ count 1)
                      (comptime (size-of (type typed.TypedOccurrenceId)))))
                    [(typed.TypedResult.Ok _) unit]
                    [(typed.TypedResult.Err error)
                      (return
                        (tc-selected-place-failed error store lease bindings))])]
                [children : (__tl_dyn-array typed.TypedOccurrenceId)
                  (__tl_make-array typed.TypedOccurrenceId (+ count 1))]
                [at : i64 0]
                (while (< at count)
                  (set! (array-ref children at) (array-ref indices at))
                  (set! at (+ at 1)))
                (set! (array-ref children count) index)
                ;; The element place has the element's own type; a
                ;; region tag (an element read through a reference) is
                ;; the read's, not the storage's.
                (tc-selected-place-project
                  (tc-global-shared-view type)
                  (tc-selected-strip-regions type)
                  (TcSelectedPlace.Selected parent children)
                  typed.TypedProjectionKind.ArrayElement
                  source
                  (TcSelectedSink.Capture store lease bindings)))])])]))

;; An element read: an element view used as the owned value it views (an
;; argument or field of its plain type, a result) takes that value, as a field
;; read does (`tc-selected-place-acquire`).
(define (tc-infer-selected-array-ref
  [ctx : TcContext]
  [env : TcTypeEnv]
  [receiver : i64]
  [index : i64]
  [expected : ast.AstMaybeType]
  [syntax : typed.TypedSyntax]
  [source : ownership.OwnershipSource]
  [sink : (TcSelectedSink store lease intern bind)]) : (TcSelectedResult
    store
    lease
    intern
    bind)
  (let
    [place : (TcSelectedPlaceResult store lease intern bind)
      (tc-infer-selected-array-place
        ctx
        env
        receiver
        index
        (tc-global-shared-view source)
        sink)]
    (tc-selected-place-acquire ctx env false expected syntax source place)))

;; Core Slice subview calls are recognized as a small call-local operation,
;; rather than an additional AST node.  Keeping the classifier in one place
;; lets typechecking, move checking, and borrow checking agree on both
;; spellings and on the ordinary-name shadowing rule.  The private
;; `__tl_bytes-view`/`__tl_bytes-mut-view` kinds are the same checked subview
;; over a byte source (u8 array, `str`, `bytes`) whose result is a borrowed
;; `bytes` view instead of a Slice; stdlib builds every byte view with them.
(defenum TcSliceViewCallKind
  (None)
  (Shared)
  (Mutable)
  (SplitShared)
  (SplitMutable)
  (BytesShared)
  (BytesMutable))

;; Source shape accepted by the Slice subview builtins.  `Direct` is a genuine
;; Array/DynArray place; `Borrow` carries the source reference lifetime,
;; mutability, and its immediate referent.  Bare Slice values never appear in
;; this enum because they have no owning/value representation.
(defenum TcSliceViewSourceInfo
  (Invalid)
  (Direct ast.AstType)
  (Borrow i64 bool ast.AstType))

(define tc-poison-type-name-id : i64
  -1000000007)
(define tc-poison-observed : bool
  false)

(define (tc-poison-type) : ast.AstType
  (Var tc-poison-type-name-id))

(define (tc-poison-type? [ty : ast.AstType]) : bool
  (match ty
    [(Var name) (= name tc-poison-type-name-id)]
    [_ false]))

(define (tc-poison-observation-reset!) : unit
  (set! tc-poison-observed false))

(define (tc-poison-observation-note! [ty : ast.AstType]) : unit
  (if (tc-poison-type? ty)
    (set! tc-poison-observed true)
    unit))

(defenum TcInferredTypeMatch
  (Compatible ast.AstType)
  (Mismatch ast.AstType))

(defenum TcBinOpTypes
  (TcBinOpTypes ast.AstType ast.AstType ast.AstType))

(defenum ResultTcBinOpTypes
  (Ok TcBinOpTypes)
  (Err String))

(defenum ResultTcTypeUnsafe
  (Ok ast.AstType bool)
  (Err String))

;; Provenance of the actual canonical lookup winner. These coordinates are
;; meaningful only inside one live body lease and its pinned current carrier;
;; they are not binder IDs and cannot introduce a selected binding themselves.
;; Persistent entries, marker slots and foreign carriers remain unrepresented.
(defstruct TcScopedBindingCoordinate
  (env-store i64)
  (scoped-state i64)
  (lookup-epoch i64)
  (slot-index i64)
  (slot-generation i64))

(defenum TcBindingOrigin
  (Unrepresented)
  (Scoped TcScopedBindingCoordinate)
  (Exhausted))

(defenum ResultTcBinding
  (Ok ast.AstType bool TcBindingOrigin)
  (Fault typed.TypedError)
  (Err String))

(define (tc-binding-project [result : ResultTcBinding]) : ResultTcType
  (match result
    [(ResultTcBinding.Ok ty _ _) (ResultTcType.Ok ty)]
    [(ResultTcBinding.Fault error) (ResultTcType.Err (tc-selected-error error))]
    [(ResultTcBinding.Err message) (ResultTcType.Err message)]))

(define (tc-binding-unrepresented [result : ResultTcType]) : ResultTcBinding
  (match result
    [(ResultTcType.Ok ty)
      (ResultTcBinding.Ok ty false TcBindingOrigin.Unrepresented)]
    [(ResultTcType.Err message) (ResultTcBinding.Err message)]))

(defenum TcSelectedBinder
  (Found typed.TypedBinderId)
  (Unrepresented))

(defenum TcSelectedBinderLookup
  (Ok TcSelectedBinder)
  (Err typed.TypedError))

(define (tc-scoped-coordinate-copy
  [coordinate : (& coordinate TcScopedBindingCoordinate)]) : TcScopedBindingCoordinate
  (TcScopedBindingCoordinate
    coordinate.env-store
    coordinate.scoped-state
    coordinate.lookup-epoch
    coordinate.slot-index
    coordinate.slot-generation))

(define (tc-scoped-coordinate-same?
  [left : (& left TcScopedBindingCoordinate)]
  [right : (& right TcScopedBindingCoordinate)]) : bool
  (and
    (= left.env-store right.env-store)
    (= left.scoped-state right.scoped-state)
    (= left.lookup-epoch right.lookup-epoch)
    (= left.slot-index right.slot-index)
    (= left.slot-generation right.slot-generation)))

(define (tc-selected-bindings-ok
  [bindings : (& bindings TcSelectedBindings)]
  [lease : (& lease (typed.TypedBodyLease intern))]) : typed.TypedResult
  (cond
    [(not
        (and
          (= bindings.body-owner lease.body.owner)
          (= bindings.body-generation lease.body.generation)
          (= bindings.body-revision lease.body.revision)))
      (typed.TypedResult.Err typed.TypedError.Lease)]
    [(or (< bindings.len 0) (> bindings.len (array-length bindings.entries)))
      (typed.TypedResult.Err typed.TypedError.Shape)]
    [else (typed.TypedResult.Ok unit)]))

(define (tc-selected-bindings-pin!
  [bindings : (&mut bindings TcSelectedBindings)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [carrier : (& carrier TcTypeEnvScopedCarrier)]) : typed.TypedResult
  (try (tc-selected-bindings-ok (& bindings) lease))
  (cond
    [(or
        (<= carrier.sidecar.stack.lookup-epoch 0)
        (< carrier.sidecar.stack.cache-generation 0))
      (typed.TypedResult.Err typed.TypedError.Exhausted)]
    [(not
        (and
          (= carrier.env.store carrier.sidecar.persistent.store)
          (= carrier.env.abi-pad carrier.sidecar.stack.state-address)))
      (typed.TypedResult.Err typed.TypedError.Shape)]
    [bindings.pinned?
      (if (and
        (= bindings.env-store carrier.env.store)
        (= bindings.scoped-state carrier.sidecar.stack.state-address)
        (= bindings.lookup-epoch carrier.sidecar.stack.lookup-epoch))
        (typed.TypedResult.Ok unit)
        (typed.TypedResult.Err typed.TypedError.Stale))]
    [else
      (set! bindings.pinned? true)
      (set! bindings.env-store carrier.env.store)
      (set! bindings.scoped-state carrier.sidecar.stack.state-address)
      (set! bindings.lookup-epoch carrier.sidecar.stack.lookup-epoch)
      (typed.TypedResult.Ok unit)]))

(define (tc-selected-bindings-reserve!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [bindings : (&mut bindings TcSelectedBindings)]
  [needed : i64]) : typed.TypedResult
  (try (typed.typed-charge! store lease 1))
  (try (tc-selected-bindings-ok (& bindings) lease))
  (when
    (> (array-length bindings.entries) store.limits.records)
    (return (typed.TypedResult.Err typed.TypedError.Shape)))
  (if (or (< needed 0) (> needed store.limits.records))
    (typed.typed-resource-fail! store typed.TypedError.Budget)
    (if (<= needed (array-length bindings.entries))
      (typed.TypedResult.Ok unit)
      (let
        [old : i64 (array-length bindings.entries)]
        [capacity : i64
          (typed.typed-grown-capacity old needed store.limits.records)]
        [_charged : unit
          (try
            (typed.typed-charge!
              store
              lease
              (*
                (+ capacity bindings.len)
                (comptime (size-of (type TcSelectedBinding))))))]
        [entries : (__tl_dyn-array TcSelectedBinding)
          (__tl_make-array TcSelectedBinding capacity)]
        [index : i64 0]
        (while (< index bindings.len)
          (set!
            (array-ref entries index)
            (TcSelectedBinding
              (tc-scoped-coordinate-copy
                (& (array-ref bindings.entries index).coordinate))
              (typed.TypedBinderId
                (typed.typed-handle-copy
                  (& (array-ref bindings.entries index).binder.handle)))))
          (set! index (+ index 1)))
        (set! bindings.entries entries)
        (typed.TypedResult.Ok unit)))))

;; Called at the successful bind event, on its exact linear carrier. No name
;; search or type inference is performed here. A later install must pin this
;; same carrier, and a read must supply the actual canonical lookup winner.
(define (tc-selected-binding-note!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [bindings : (&mut bindings TcSelectedBindings)]
  [carrier : (& carrier TcTypeEnvScopedCarrier)]
  [type : ast.AstType]
  [kind : typed.TypedBinderKind]
  [source : (& source ownership.OwnershipSource)]) : typed.TypedResult
  (match (tc-selected-binding-note-id!
    store
    lease
    bindings
    carrier
    type
    kind
    source)
    [(TcSelectedBinderLookup.Ok _) (typed.TypedResult.Ok unit)]
    [(TcSelectedBinderLookup.Err error) (typed.TypedResult.Err error)]))

(define (tc-selected-binding-note-id!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [bindings : (&mut bindings TcSelectedBindings)]
  [carrier : (& carrier TcTypeEnvScopedCarrier)]
  [type : ast.AstType]
  [kind : typed.TypedBinderKind]
  [source : (& source ownership.OwnershipSource)]) : TcSelectedBinderLookup
  (tc-selected-binding-note-at!
    store
    lease
    bindings
    carrier
    (- carrier.sidecar.stack.slot-count 1)
    type
    kind
    source))

;; Registers the binder of stack slot `index` (a pattern binds several).
(define (tc-selected-binding-note-at!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [bindings : (&mut bindings TcSelectedBindings)]
  [carrier : (& carrier TcTypeEnvScopedCarrier)]
  [index : i64]
  [type : ast.AstType]
  [kind : typed.TypedBinderKind]
  [source : (& source ownership.OwnershipSource)]) : TcSelectedBinderLookup
  (try (typed.typed-charge! store lease 1))
  (try (tc-selected-bindings-pin! bindings lease carrier))
  (if (not (ownership.ownership-source-valid? (& source)))
    (TcSelectedBinderLookup.Ok TcSelectedBinder.Unrepresented)
    (let
      [coordinate : TcScopedBindingCoordinate
        (if (or
          (< index 0)
          (>= index (array-length carrier.sidecar.stack.slots)))
          (return (TcSelectedBinderLookup.Err typed.TypedError.Shape))
          (match (tc-lookup-binding-origin
            (TcTypeEnv carrier.env.store carrier.env.head carrier.env.abi-pad)
            carrier
            index
            (& (array-ref carrier.sidecar.stack.slots index)))
            [(TcBindingOrigin.Scoped coordinate) coordinate]
            [(TcBindingOrigin.Exhausted)
              (return (TcSelectedBinderLookup.Err typed.TypedError.Exhausted))]
            [(TcBindingOrigin.Unrepresented)
              (return (TcSelectedBinderLookup.Err typed.TypedError.Shape))]))]
      (when
        (and
          (< index bindings.len)
          (tc-scoped-coordinate-same?
            (& coordinate)
            (& (array-ref bindings.entries index).coordinate)))
        (return (TcSelectedBinderLookup.Err typed.TypedError.Stale)))
      (try (tc-selected-bindings-reserve! store lease bindings (+ index 1)))
      (let
        [type-id : typed.TypedTypeId
          (try (typed.typed-type-add! store lease type))]
        [_source-charged : unit
          (try
            (typed.typed-charge!
              store
              lease
              (+
                (string.string-length source.path)
                (string.string-length source.expansion))))]
        [origin : typed.TypedOriginId
          (try
            (typed.typed-origin-add!
              store
              lease
              (ownership.OwnershipSource
                (string.copy (& source.path))
                source.line
                source.column
                (string.copy (& source.expansion)))))]
        [binder : typed.TypedBinderId
          (try
            (typed.typed-binder-add!
              store
              lease
              type-id
              kind
              origin
              (array-ref carrier.sidecar.stack.slots index).name-id))]
        (set!
          (array-ref bindings.entries index)
          (TcSelectedBinding
            coordinate
            (typed.TypedBinderId (typed.typed-handle-copy (& binder.handle)))))
        (when (>= index bindings.len) (set! bindings.len (+ index 1)))
        (TcSelectedBinderLookup.Ok (TcSelectedBinder.Found binder))))))

(define (tc-selected-current-binding-note!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [bindings : (&mut bindings TcSelectedBindings)]
  [env : TcTypeEnv]
  [type : ast.AstType]
  [kind : typed.TypedBinderKind]
  [source : (& source ownership.OwnershipSource)]) : typed.TypedResult
  (match (tc-selected-current-binding-note-id!
    store
    lease
    bindings
    env
    type
    kind
    source)
    [(TcSelectedBinderLookup.Ok _) (typed.TypedResult.Ok unit)]
    [(TcSelectedBinderLookup.Err error) (typed.TypedResult.Err error)]))

(define (tc-selected-current-binding-note-id!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [bindings : (&mut bindings TcSelectedBindings)]
  [env : TcTypeEnv]
  [type : ast.AstType]
  [kind : typed.TypedBinderKind]
  [source : (& source ownership.OwnershipSource)]) : TcSelectedBinderLookup
  (try (typed.typed-charge! store lease 1))
  (unless
    (tc-type-env-scoped-runtime-active? env)
    (return (TcSelectedBinderLookup.Err typed.TypedError.Shape)))
  (let
    [carrier : TcTypeEnvScopedCarrier (tc-type-env-scoped-runtime-current env)]
    (if (not
      (and
        (= env.store carrier.env.store)
        (= env.abi-pad carrier.sidecar.stack.state-address)))
      (TcSelectedBinderLookup.Err typed.TypedError.Stale)
      (tc-selected-binding-note-id!
        store
        lease
        bindings
        (& carrier)
        type
        kind
        source))))

(define (tc-selected-binding-find!
  [store : (&mut store typed.TypedStore)]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [bindings : (& bindings TcSelectedBindings)]
  [env : TcTypeEnv]
  [origin : TcBindingOrigin]) : TcSelectedBinderLookup
  (try (typed.typed-charge! store lease 1))
  (try (tc-selected-bindings-ok bindings lease))
  (match origin
    [(TcBindingOrigin.Unrepresented)
      (TcSelectedBinderLookup.Ok TcSelectedBinder.Unrepresented)]
    [(TcBindingOrigin.Exhausted)
      (TcSelectedBinderLookup.Err typed.TypedError.Exhausted)]
    [(TcBindingOrigin.Scoped coordinate)
      (if (not
        (and
          bindings.pinned?
          (= env.store bindings.env-store)
          (= env.abi-pad bindings.scoped-state)
          (= coordinate.env-store bindings.env-store)
          (= coordinate.scoped-state bindings.scoped-state)
          (= coordinate.lookup-epoch bindings.lookup-epoch)
          (tc-type-env-scoped-runtime-active? env)))
        (TcSelectedBinderLookup.Ok TcSelectedBinder.Unrepresented)
        (let
          [carrier : TcTypeEnvScopedCarrier
            (tc-type-env-scoped-runtime-current env)]
          [index : i64 coordinate.slot-index]
          (when
            (or
              (<= carrier.sidecar.stack.lookup-epoch 0)
              (< carrier.sidecar.stack.cache-generation 0))
            (return (TcSelectedBinderLookup.Err typed.TypedError.Exhausted)))
          (unless
            (and
              (= carrier.env.store bindings.env-store)
              (= carrier.sidecar.persistent.store bindings.env-store)
              (= carrier.sidecar.stack.state-address bindings.scoped-state)
              (= carrier.sidecar.stack.lookup-epoch bindings.lookup-epoch))
            (return (TcSelectedBinderLookup.Ok TcSelectedBinder.Unrepresented)))
          (unless
            (and
              (>= index 0)
              (< index carrier.sidecar.stack.slot-count)
              (< index (array-length carrier.sidecar.stack.slots))
              (=
                (array-ref carrier.sidecar.stack.slots index).generation
                coordinate.slot-generation))
            (return (TcSelectedBinderLookup.Err typed.TypedError.Stale)))
          (if (and
            (< index bindings.len)
            (tc-scoped-coordinate-same?
              (& coordinate)
              (& (array-ref bindings.entries index).coordinate)))
            (let
              [id : typed.TypedBinderId
                (typed.TypedBinderId
                  (typed.typed-handle-copy
                    (& (array-ref bindings.entries index).binder.handle)))]
              ;; The bindings outlive attempts, so an entry may name a binder
              ;; a rolled-back attempt discarded: the store reads records
              ;; without checking them again, so check the binder here.
              (match (typed.typed-binder-ok (& store) (& id))
                [(typed.TypedResult.Err error)
                  (TcSelectedBinderLookup.Err error)]
                [(typed.TypedResult.Ok _)
                  (TcSelectedBinderLookup.Ok (TcSelectedBinder.Found id))]))
            (TcSelectedBinderLookup.Ok TcSelectedBinder.Unrepresented))))]))

(defenum ResultTcTypeList
  (Ok ast.AstTypeList)
  (Err String))

(defenum ResultTcExprList
  (Ok ast.AstExprList)
  (Err String))

(defenum ResultTcExpr
  (Ok ast.AstExpr)
  (Err String))

(defenum ResultTcExprId
  (Ok i64)
  (Err String))

(defenum TcBodyTypeFact
  (Hit ast.AstType)
  (Miss))

(defenum TcBodyEarlyExitFact
  (Known bool)
  (Unknown))

;; Dense source-expression id -> (fact slot + 1) index. Each function clears
;; only ids it touched, recorded in the parallel expr-id buffer, so body
;; boundaries neither allocate nor zero a capacity-sized hashmap. Expression
;; ids synthesized after the source-pool snapshot simply miss and use the
;; existing conservative reinference path.
;; Lower's call-slot RVO needs one semantic fact per function body: whether a
;; runtime `return` or `try` occurs anywhere in it. The move checker already
;; visits the complete runtime body (including nested lambdas), so recording the
;; bit there avoids a second recursive AST walk in lower. Facts are keyed by the
;; stable body node id. Bodies synthesized after source typecheck are absent and
;; lower falls back to its conservative scanner for those only.
(define (tc-body-state-new-with-job-state-and-source-names
  [job-state : TcJobState]
  [source-names : ci.InternSourceNameSessionHandle]) : TcBodyState
  (let
    [cell : (__tl_dyn-array TcBodyStateData)
      (__tl_make-array TcBodyStateData 1)]
    [source-session : ci.InternSourceNameSession
      (ci.intern-source-name-session-handle-session source-names)]
    (set!
      (array-ref cell 0)
      (TcBodyStateData
        false
        false
        (__tl_make-array i64 1)
        (__tl_make-array i64 1)
        (__tl_make-array ast.AstType 1)
        0
        0
        0
        false
        false
        false
        0
        -1
        (__tl_make-array i64 1)
        (__tl_make-array i64 1)
        (tc_i64_i64_map.with-capacity 0)
        0
        (tc-selected-body-owner-allocate!)
        (cast 0 : u64)
        ""
        false
        false
        false
        (__tl_make-array TcSelectedCertificate 0)
        0
        (tc_i64_i64_map.with-capacity 1)
        0
        0
        0
        (__tl_make-array i64 0)
        (__tl_make-array i64 0)))
    (TcBodyState
      (cast
        (unsafe
          (ptr->int (ptr-cast (__tl_array-data cell) : (Ptr TcBodyStateData))))
        : i64)
      job-state
      (tc-job-state-inlay-hints job-state)
      (unsafe
        (deref (tc-inlay-hint-state-view (tc-job-state-inlay-hints job-state))).enabled)
      source-session.table-id
      source-session.reset-generation)))

(define (tc-body-state-ptr [state : TcBodyState]) : (MutPtr TcBodyStateData)
  (tc-state-cell-ptr state.address TcBodyStateData))

(define (tc-body-state-view [state : TcBodyState]) : (Ptr TcBodyStateData)
  (tc-state-cell-view state.address TcBodyStateData))

(define (tc-body-state-data-value [state : TcBodyState]) : TcBodyStateData
  (tc-state-cell-read state.address TcBodyStateData))

(define (tc-body-state-data-set! [state : TcBodyState] [data : TcBodyStateData]) : unit
  (tc-state-cell-write! state.address TcBodyStateData data))

(define (tc-selected-lowering-start! [state : TcBodyState]) : unit
  (let
    [data : TcBodyStateData (tc-body-state-data-value state)]
    (set! data.selected-lowering? true)
    (set! data.selected-ready? false)
    (tc-body-state-data-set! state data)))

(define (tc-selected-lowering? [state : TcBodyState]) : bool
  (__tl-project-field (tc-body-state-data-value state) selected-lowering?))

(define (tc-selected-lowering-finish! [state : TcBodyState]) : unit
  (let
    [data : TcBodyStateData (tc-body-state-data-value state)]
    (set! data.selected-ready? (not data.selected-failed?))
    (tc-body-state-data-set! state data)))

(define (tc-selected-certificate-charge!
  [state : TcBodyState]
  [records : i64]
  [work : i64]
  [bytes : i64]) : ResultTcUnit
  (let
    [data : TcBodyStateData (tc-body-state-data-value state)]
    (if (and
      (not data.selected-failed?)
      (>= records 0)
      (>= work 0)
      (>= bytes 0)
      (<= records (- 4194304 data.selected-retained-records))
      (<= work (- 67108864 data.selected-certificate-work))
      (<= bytes (- 67108864 data.selected-retained-bytes)))
      (begin
        (set!
          data.selected-retained-records
          (+ data.selected-retained-records records))
        (set!
          data.selected-certificate-work
          (+ data.selected-certificate-work work))
        (set!
          data.selected-retained-bytes
          (+ data.selected-retained-bytes bytes))
        (tc-body-state-data-set! state data)
        ResultTcUnit.Ok)
      (begin
        (set! data.selected-failed? true)
        (set! data.selected-ready? false)
        (tc-body-state-data-set! state data)
        (ResultTcUnit.Err
          "typecheck: retained ownership certificate budget exhausted")))))

;; A DynArray append reallocates its exact length, so permanent publication
;; uses reserved slots and a separate published count. Never expose slack rows.
;; Job-owned ownership-certificate tables. A file's certificates are dead once
;; its lowering ends, so they live in an arena of their own that the driver
;; destroys at each file boundary (`tc-job-state-release-selected-file-storage!`):
;; neither the tables nor the smaller ones they outgrew stay in the job's
;; lifetime arena, which would hold them for every later batch entry. At most
;; one body owns the tables at a time: a body that finds them owned grows
;; private tables as before.
(defstruct TcSelectedCertificateStoreData
  (owner u64)
  (certificates (__tl_dyn-array TcSelectedCertificate))
  (index tc_i64_i64_map.Map)
  ;; The arena holding `certificates` and `index`; 0 once a file boundary
  ;; destroyed it, when the next owner starts fresh tables.
  (arena i64))

(define (tc-job-state-selected-certificate-store-address [state : TcJobState]) : i64
  (tc-job-state-field state selected-certificate-store-address i64))

(define (tc-job-state-set-selected-certificate-store-address!
  [state : TcJobState]
  [address : i64]) : unit
  (unsafe
    (ptr-write!
      (ptr-cast
        (ptr-offset
          (int->ptr (cast state.address : u64) : (Ptr u8))
          (comptime
            (offset-of (type TcJobStateData) selected-certificate-store-address)))
        : (MutPtr i64))
      address)))

;; File boundary: no body of the finished file reads its certificates again,
;; and the next file's stamp kills every holds-memo entry, so both arenas go.
;; Job retirement releases them too.
(define (tc-job-state-release-selected-file-storage! [state : TcJobState]) : unit
  (let
    [resolution : TcTypeResolutionCacheState
      (tc-job-state-type-resolution-cache state)]
    [cache : (MutPtr TcTypeResolutionCacheStateData)
      (tc-type-resolution-cache-state-ptr resolution)]
    [memo : i64
      (if (> resolution.address 0)
        (unsafe
          (deref cache).holds-memo-arena)
        0)]
    (when
      (> memo 0)
      (unsafe
        (set! (deref cache).holds-memo-address 0)
        (set! (deref cache).holds-memo-arena 0)
        (arena.tl_arena_destroy memo))))
  (let
    [address : i64 (tc-job-state-selected-certificate-store-address state)]
    (when
      (> address 0)
      (let
        [store : TcSelectedCertificateStoreData
          (tc-state-cell-read address TcSelectedCertificateStoreData)]
        [storage : i64 store.arena]
        (set! store.owner (cast 0 : u64))
        (set! store.arena 0)
        (tc-state-cell-write! address TcSelectedCertificateStoreData store)
        (when
          (> storage 0)
          (unsafe
            (arena.tl_arena_destroy storage)))))))

;; The arena of the job's certificate tables when `data`'s body owns them
;; (growth must stay there), else 0 (private tables grow where they live).
(define (tc-selected-certificate-store-arena
  [state : TcBodyState]
  [data : (& data TcBodyStateData)]) : i64
  (let
    [address : i64
      (tc-job-state-selected-certificate-store-address state.job-state)]
    (if (> address 0)
      (let
        [store : TcSelectedCertificateStoreData
          (tc-state-cell-read address TcSelectedCertificateStoreData)]
        (if (= store.owner data.selected-owner)
          store.arena
          0))
      0)))

;; A body about to publish its first certificate adopts the job's tables when
;; no other body owns them. The job's store cell is allocated in the job
;; owner's arena (publication's precondition); a file's tables start in a
;; fresh arena of their own, sized for a typical file's bodies.
(define tc-selected-certificate-initial-capacity : i64
  256)

(define (tc-selected-certificate-store-acquire! [state : TcBodyState]) : unit
  (let
    [data : TcBodyStateData (tc-body-state-data-value state)]
    [job : TcJobState state.job-state]
    [address : i64 (tc-job-state-selected-certificate-store-address job)]
    [store : TcSelectedCertificateStoreData
      (if (= address 0)
        (TcSelectedCertificateStoreData
          (cast 0 : u64)
          (__tl_make-array TcSelectedCertificate 0)
          (tc_i64_i64_map.with-capacity 0)
          0)
        (tc-state-cell-read address TcSelectedCertificateStoreData))]
    (when
      (= store.owner (cast 0 : u64))
      (if (> store.arena 0)
        (tc_i64_i64_map.clear-ref! (&mut store.index))
        (let
          [storage : i64 (arena.tl_arena_make_small)]
          (set! store.arena storage)
          (in-arena
            (unsafe
              (arena.Arena storage))
            (set!
              store.certificates
              (__tl_make-array
                TcSelectedCertificate
                tc-selected-certificate-initial-capacity))
            (set!
              store.index
              (tc_i64_i64_map.with-capacity
                tc-selected-certificate-initial-capacity)))))
      (set! store.owner data.selected-owner)
      (set!
        data.selected-certificates
        (tc-global-shared-view store.certificates))
      (set! data.selected-certificate-index (tc-global-shared-view store.index))
      (if (= address 0)
        (let
          [cell : (__tl_dyn-array TcSelectedCertificateStoreData)
            (__tl_make-array TcSelectedCertificateStoreData 1)]
          (set! (array-ref cell 0) store)
          (tc-job-state-set-selected-certificate-store-address!
            job
            (cast
              (unsafe
                (ptr->int
                  (ptr-cast
                    (__tl_array-data cell)
                    : (Ptr TcSelectedCertificateStoreData))))
              : i64)))
        (tc-state-cell-write! address TcSelectedCertificateStoreData store))
      (tc-body-state-data-set! state data))))

;; Keep the job's tables at the owning body's latest (possibly grown) storage.
(define (tc-selected-certificate-store-sync! [state : TcBodyState]) : unit
  (let
    [data : TcBodyStateData (tc-body-state-data-value state)]
    [address : i64
      (tc-job-state-selected-certificate-store-address state.job-state)]
    (when
      (> address 0)
      (let
        [store : TcSelectedCertificateStoreData
          (tc-state-cell-read address TcSelectedCertificateStoreData)]
        (when
          (= store.owner data.selected-owner)
          (set! store.certificates data.selected-certificates)
          (set! store.index data.selected-certificate-index)
          (tc-state-cell-write! address TcSelectedCertificateStoreData store))))))

(define (tc-selected-certificate-reserve! [state : TcBodyState]) : ResultTcUnit
  (let
    [_adopt : unit
      (let
        [first : TcBodyStateData (tc-body-state-data-value state)]
        (when
          (and
            (= first.selected-certificate-count 0)
            (= (array-length first.selected-certificates) 0))
          (tc-selected-certificate-store-acquire! state)))]
    [current : TcBodyStateData (tc-body-state-data-value state)]
    [capacity : i64 (array-length current.selected-certificates)]
    [count : i64 current.selected-certificate-count]
    (unless
      (and (>= count 0) (<= count capacity) (<= capacity 65536))
      (return
        (ResultTcUnit.Err "typecheck: malformed ownership certificate storage")))
    ;; The declaration index has geometric storage too. Reserve its next
    ;; allocation and rehash visits before insert-ref! can trigger growth.
    (when
      (>=
        current.selected-certificate-index.len
        current.selected-certificate-index.growth-limit)
      (let
        [slots : i64 (array-length current.selected-certificate-index.slots)]
        (match (tc-selected-certificate-charge! state (* 2 slots) (* 4 slots) 0)
          [(ResultTcUnit.Ok) unit]
          [(ResultTcUnit.Err message) (return (ResultTcUnit.Err message))])))
    (when (< count capacity) (return ResultTcUnit.Ok))
    (when
      (>= capacity 65536)
      (return
        (ResultTcUnit.Err "typecheck: ownership certificate table exhausted")))
    (let
      [next : i64
        (if (= capacity 0)
          16
          (if (> capacity 32768)
            65536
            (* 2 capacity)))]
      [_charge : unit
        (match (tc-selected-certificate-charge! state next (+ next count) 0)
          [(ResultTcUnit.Ok) unit]
          [(ResultTcUnit.Err message) (return (ResultTcUnit.Err message))])]
      [data : TcBodyStateData (tc-body-state-data-value state)]
      [storage : i64 (tc-selected-certificate-store-arena state (& data))]
      [slots : (__tl_dyn-array TcSelectedCertificate)
        (if (> storage 0)
          (in-arena
            (unsafe
              (arena.Arena storage))
            (__tl_make-array TcSelectedCertificate next))
          (__tl_make-array TcSelectedCertificate next))]
      [index : i64 0]
      (while (< index count)
        (set!
          (array-ref slots index)
          (array-ref data.selected-certificates index))
        (set! index (+ index 1)))
      (set! data.selected-certificates slots)
      (tc-body-state-data-set! state data)
      ResultTcUnit.Ok)))

;; Call only in the job owner's arena. Publication is the final step after a
;; body is admitted. Legacy is explicit migration state, never an error path;
;; final source cutover must remove it when every source form is represented.
(define (tc-selected-certificate-publish!
  [ctx : TcContext]
  [name : i64]
  [expression : i64]
  [lease : (& lease (typed.TypedBodyLease intern))]
  [address : u64]) : ResultTcUnit
  (let
    [state : TcBodyState (tc-context-body-state ctx)]
    [_charge : unit
      (match (tc-selected-certificate-charge! state 1 1 0)
        [(ResultTcUnit.Ok) unit]
        [(ResultTcUnit.Err error) (return (ResultTcUnit.Err error))])]
    [before : TcBodyStateData (tc-body-state-data-value state)]
    [key : i64 (tc-module-name-id-by-id (tc-context-module-id ctx) name)]
    [old : i64
      (tc_i64_i64_map.get-value-or (& before.selected-certificate-index) key -1)]
    [_capacity : unit
      (when
        (< old 0)
        (match (tc-selected-certificate-reserve! state)
          [(ResultTcUnit.Ok) unit]
          [(ResultTcUnit.Err message) (return (ResultTcUnit.Err message))]))]
    [data : TcBodyStateData (tc-body-state-data-value state)]
    [stamp : ast.AstTypePoolStamp
      (match (ast.ast-node-pool-context-type-stamp (& lease.pools))
        [(ast.AstMaybeTypePoolStamp.Some stamp) stamp]
        [(ast.AstMaybeTypePoolStamp.No)
          (return
            (ResultTcUnit.Err
              "typecheck: stale source pool at ownership publication"))])]
    [entry : TcSelectedCertificate
      (TcSelectedCertificate
        (tc-context-module-id ctx)
        name
        expression
        (typed.typed-body-copy (& lease.body))
        lease.pools.expr-pool
        lease.pools.type-pool
        lease.pools.owner-arena
        stamp
        (ci.intern-compat-state-table-id lease.intern-state)
        (ci.intern-compat-state-generation lease.intern-state)
        address)]
    (unless
      (and
        data.selected-lowering?
        (not data.selected-ready?)
        (= lease.body.owner data.selected-owner)
        (<= lease.body.revision data.selected-revision)
        (< data.selected-certificate-count 65536))
      (return
        (ResultTcUnit.Err
          "typecheck: invalid ownership certificate publication phase")))
    (if (>= old 0)
      (begin
        (unless
          (< old data.selected-certificate-count)
          (return
            (ResultTcUnit.Err "typecheck: invalid ownership certificate index")))
        (set! (array-ref data.selected-certificates old) entry))
      (let
        [storage : i64 (tc-selected-certificate-store-arena state (& data))]
        ;; The index grows where its table lives.
        (if (> storage 0)
          (in-arena
            (unsafe
              (arena.Arena storage))
            (tc_i64_i64_map.insert-ref!
              (&mut data.selected-certificate-index)
              key
              data.selected-certificate-count))
          (tc_i64_i64_map.insert-ref!
            (&mut data.selected-certificate-index)
            key
            data.selected-certificate-count))
        (set!
          (array-ref data.selected-certificates data.selected-certificate-count)
          entry)
        (set!
          data.selected-certificate-count
          (+ data.selected-certificate-count 1))))
    (tc-body-state-data-set! state data)
    (tc-selected-certificate-store-sync! state)
    ResultTcUnit.Ok))

(define (tc-selected-certificate-session?
  [ctx : TcContext]
  [data : (& data TcBodyStateData)]
  [entry : (& entry TcSelectedCertificate)]) : bool
  (let
    [pools : ast.AstNodePoolContext (tc-context-pools ctx)]
    [intern-state : ci.InternCompatState
      (ci.intern-compat-state-capture-active)]
    (and
      data.selected-lowering?
      data.selected-ready?
      (not data.selected-failed?)
      (= entry.body.owner data.selected-owner)
      (> entry.body.revision 0)
      (<= entry.body.revision data.selected-revision)
      (= entry.expr-pool pools.expr-pool)
      (= entry.type-pool pools.type-pool)
      (= entry.pool-owner pools.owner-arena)
      (ast.ast-node-pool-context-type-stamp-valid?
        (& pools)
        (& entry.type-stamp))
      (= entry.intern-table (ci.intern-compat-state-table-id (& intern-state)))
      (=
        entry.intern-generation
        (ci.intern-compat-state-generation (& intern-state))))))

(define (tc-selected-certificate-lookup
  [ctx : TcContext]
  [name : i64]
  [params : (& params ast.AstParamList)]
  [ret : (& ret ast.AstType)]
  [expression : i64]) : TcSelectedLookup
  (let
    [state : TcBodyState (tc-context-body-state ctx)]
    [_charge : unit
      (match (tc-selected-certificate-charge! state 0 1 0)
        [(ResultTcUnit.Ok) unit]
        [(ResultTcUnit.Err error) (return (TcSelectedLookup.Err error))])]
    [data : TcBodyStateData (tc-body-state-data-value state)]
    [key : i64 (tc-module-name-id-by-id (tc-context-module-id ctx) name)]
    [index : i64
      (tc_i64_i64_map.get-value-or (& data.selected-certificate-index) key -1)]
    (unless
      (and (>= index 0) (< index data.selected-certificate-count))
      (return (TcSelectedLookup.Err "lower: missing checked source body entry")))
    (let
      [entry : (& data TcSelectedCertificate)
        (& (array-ref data.selected-certificates index))]
      (unless
        (and
          (= entry.name name)
          (= entry.module (tc-context-module-id ctx))
          (= entry.expression expression)
          (tc-selected-certificate-session? ctx (& data) entry))
        (return (TcSelectedLookup.Err "lower: stale checked source body entry")))
      TcSelectedLookup.Legacy)))

;; The checked clone handoff is the sole post-check producer of named runtime
;; declarations. Register those appended declarations explicitly; a missing
;; ordinary source entry is never interpreted as generated or as Legacy.
;; Publish explicit Legacy lowering entries for the function declarations in
;; [start, end) of `decls`, whose bodies this job does not re-check: generated
;; declarations appended after checking, and a hydrated prelude surface prefix
;; (its bodies were checked when the surface was produced, and its published
;; typecheck facts stand in for them). Lowering then takes the same Legacy
;; route the unhydrated prelude takes. Module markers before `start` are
;; walked so every entry is keyed by its own module.
(define (tc-selected-register-legacy-decl-range!
  [ctx : TcContext]
  [decls : (& decls ast.AstDeclList)]
  [start : i64]
  [end : i64]) : ResultTcUnit
  (let
    [body-state : TcBodyState (tc-context-body-state ctx)]
    [intern-state : ci.InternCompatState
      (ci.intern-compat-state-capture-active)]
    [index : i64 0]
    [module : i64 cbi.compiler-builtin-id-fix-empty]
    (unless
      (and (>= start 0) (<= start end) (<= end (ast.ast-decl-list-len decls)))
      (return (ResultTcUnit.Err "lower: invalid legacy-body declaration range")))
    (while (< index end)
      (begin
        (match (tc-selected-certificate-charge! body-state 0 1 0)
          [(ResultTcUnit.Ok) unit]
          [(ResultTcUnit.Err message) (return (ResultTcUnit.Err message))])
        (match (ast.ast-decl-unwrapped
          (& (ast.ast-decl-list-get decls index (ast.ast-decl-fallback))))
          [(ast.AstDecl.Module next) (set! module next)]
          [(ast.AstDecl.DefFn _ name _ _ body _)
            (when
              (>= index start)
              (let
                [decl-ctx : TcContext
                  (tc-context-with-module-id
                    ctx
                    (tc-env-key-name-text module)
                    module)]
                (match (tc-selected-body-lease! decl-ctx (& intern-state))
                  [(TcSelectedBodyLeaseResult.Err error)
                    (return (ResultTcUnit.Err (tc-selected-error error)))]
                  [(TcSelectedBodyLeaseResult.Ok lease)
                    (match (tc-selected-publish-legacy
                      decl-ctx
                      name
                      body
                      (& lease))
                      [(ResultTcUnit.Ok) unit]
                      [(ResultTcUnit.Err message)
                        (return (ResultTcUnit.Err message))])])))]
          [_ unit])
        (set! index (+ index 1))))
    ResultTcUnit.Ok))

(define (tc-selected-register-generated-decls!
  [ctx : TcContext]
  [program : ast.AstProgram]
  [first : i64]) : ResultTcUnit
  (let
    [body-state : TcBodyState (tc-context-body-state ctx)]
    [before : TcBodyStateData (tc-body-state-data-value body-state)]
    (unless
      (and before.selected-lowering? before.selected-ready?)
      (return
        (ResultTcUnit.Err "lower: invalid generated-body registration phase")))
    (set! before.selected-ready? false)
    (tc-body-state-data-set! body-state before)
    (let
      [result : ResultTcUnit
        (match program
          [(ast.AstProgram.Program boxed)
            (let
              [decls : ast.AstDeclList
                (ast.ast-decl-list-box-shared-view boxed)]
              (tc-selected-register-legacy-decl-range!
                ctx
                (& decls)
                first
                (ast.ast-decl-list-len (& decls))))])]
      (tc-selected-lowering-finish! body-state)
      result)))

;; The path MIR diagnostics of a body name: its declaration's file, or
;; `<generated>` for a declaration a module macro produced (its spans and
;; expansion frames still locate the generated code).
(define (tc-selected-body-path [path : (& path str)]) : String
  (if (= (string.string-length path) 0)
    "<generated>"
    (string.copy path)))

;; A span position, or the start (1) for a generated node's empty span.
(define (tc-selected-position-or-start [position : i64]) : i64
  (if (> position 0)
    position
    1))

(define (tc-selected-source-path-set! [ctx : TcContext] [path : String]) : String
  (let
    [state : TcBodyState (tc-context-body-state ctx)]
    [data : TcBodyStateData (tc-body-state-data-value state)]
    [previous : String data.selected-source-path]
    (set! data.selected-source-path path)
    (tc-body-state-data-set! state data)
    previous))

(define (tc-body-early-exit-facts-start-with-limit!
  [state : TcBodyState]
  [expr-limit : i64]) : unit
  (let
    [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    (unsafe
      (set!
        (deref data).early-exit-facts
        (__tl_make-array i64 (/ (+ expr-limit 63) 64)))
      (set!
        (deref data).early-exit-known
        (__tl_make-array i64 (/ (+ expr-limit 63) 64)))
      (set! (deref data).early-exit-current false)
      (set! (deref data).early-exit-suppress-depth 0)
      (set! (deref data).early-exit-source-expr-limit expr-limit)
      (set! (deref data).early-exit-facts-ready false)
      (set! (deref data).early-exit-facts-collecting true)
      (set! (deref data).param-facts (tc_i64_i64_map.with-capacity 128))
      (set! (deref data).param-write-arena (arena.tl_arena_current)))
    (tc-body-type-fact-storage-start! state expr-limit)))

(define (tc-body-early-exit-facts-start!
  [state : TcBodyState]
  [pools : ast.AstNodePoolContext]) : unit
  (tc-body-early-exit-facts-start-with-limit!
    state
    (ast.ast-node-pool-context-expr-len pools)))

(define (tc-body-early-exit-facts-finish! [state : TcBodyState]) : unit
  (let
    [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    (unsafe
      (set! (deref data).early-exit-facts-collecting false)
      (set! (deref data).early-exit-facts-ready true))
    (tc-body-type-fact-storage-release! state)))

(define (tc-body-early-exit-facts-abort! [state : TcBodyState]) : unit
  (let
    [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    (unsafe
      (set! (deref data).early-exit-facts-collecting false)
      (set! (deref data).early-exit-facts-ready false)
      (set! (deref data).early-exit-current false)
      (set! (deref data).early-exit-suppress-depth 0)
      (set! (deref data).early-exit-source-expr-limit -1))
    (tc-body-type-fact-storage-release! state)))

(define (tc-body-early-exit-function-start! [state : TcBodyState]) : unit
  (let
    [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    (unsafe
      (if (deref data).early-exit-facts-collecting
        (begin
          (set! (deref data).early-exit-current false)
          (set! (deref data).early-exit-suppress-depth 0))
        unit))))

(define (tc-body-early-exit-function-finish!
  [state : TcBodyState]
  [body-id : i64]) : unit
  (let
    [data : TcBodyStateData (tc-body-state-data-value state)]
    (if (and
      data.early-exit-facts-collecting
      (>= body-id 0)
      (< body-id data.early-exit-source-expr-limit))
      (let
        [word-index : i64 (/ body-id 64)]
        [bit-index : i64 (% body-id 64)]
        [bit : i64 (shl 1 bit-index)]
        (set!
          (array-ref data.early-exit-known word-index)
          (bit-or (array-ref data.early-exit-known word-index) bit))
        (if data.early-exit-current
          (set!
            (array-ref data.early-exit-facts word-index)
            (bit-or (array-ref data.early-exit-facts word-index) bit))
          unit))
      unit)))

(define (tc-body-early-exit-note! [state : TcBodyState]) : unit
  (let
    [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    (unsafe
      (if (and
        (deref data).early-exit-facts-collecting
        (= (deref data).early-exit-suppress-depth 0))
        (set! (deref data).early-exit-current true)
        unit))))

;; The `param-facts` key of a body's borrowed root name, or with name -1 of the
;; body itself, present when it borrows any root. Its bits 61 and 60 are 01,
;; where a body's node id has 00 and tc-body-memory-class-key 10 (node and
;; name ids stay below 2^60), so entries of different kinds never collide. The map's
;; bucket index sees only a key's low bits, so the body id is spread over all
;; of them; were two root keys to collide, a call would only copy more often.
(define (tc-body-mut-borrow-key [body-id : i64] [name-id : i64]) : i64
  (bit-or
    (bit-and (+ (* body-id -7046029254386353131) name-id) 1152921504606846975)
    1152921504606846976))

(define (tc-body-memory-class-key [name-id : i64]) : i64
  (bit-or name-id 2305843009213693952))

;; Which roots of a body lowering treats as borrowed `&mut` there: -1 for
;; every root (no recorded body, or before the facts start), -2 for none (the
;; body borrows no root), or the body id, for the roots recorded with it.
(define (tc-body-mut-borrow-scope [state : TcBodyState] [body-id : i64]) : i64
  (let
    [view : (Ptr TcBodyStateData) (tc-body-state-view state)]
    (cond
      [(or
          (=
            (unsafe
              (deref view).param-write-arena)
            0)
          (< body-id 0))
        -1]
      [(let
          [roots : tc_i64_i64_map.Map
            (unsafe
              (deref view).param-facts)]
          (tc_i64_i64_map.contains?
            (& roots)
            (tc-body-mut-borrow-key body-id -1)))
        body-id]
      [else -2])))

(defenum TcBodyParamWriteFact
  (Known i64 i64)
  (Unknown i64))

;; Record a certified body's written-parameter mask for lowering, joined with
;; any mask an earlier check of the same body recorded.
(define (tc-body-param-write-fact-join!
  [state : TcBodyState]
  [body-id : i64]
  [mask : i64]) : unit
  (let
    [view : (Ptr TcBodyStateData) (tc-body-state-view state)]
    [ptr : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    [arena-id : i64
      (unsafe
        (deref view).param-write-arena)]
    (when
      (and (!= arena-id 0) (>= body-id 0))
      (in-arena
        (unsafe
          (arena.Arena arena-id))
        (let
          [facts : tc_i64_i64_map.Map
            (unsafe
              (deref view).param-facts)]
          (tc_i64_i64_map.insert-ref!
            (&mut facts)
            body-id
            (bit-or mask (tc_i64_i64_map.get-value-or (& facts) body-id 0)))
          (unsafe
            (set! (deref ptr).param-facts facts)))))))

;; A body's fact, carrying its node id (-1 for none): Known with the mask of
;; by-value parameter positions a checked body writes in place, or Unknown for
;; a body no move check recorded (one synthesized after typecheck), which
;; lowering treats as writing every parameter.
(define (tc-body-param-write-fact [state : TcBodyState] [body-id : i64]) : TcBodyParamWriteFact
  (let
    [view : (Ptr TcBodyStateData) (tc-body-state-view state)]
    [facts : tc_i64_i64_map.Map
      (unsafe
        (deref view).param-facts)]
    (match (tc_i64_i64_map.get (& facts) body-id)
      [(LookupFound mask) (Known body-id mask)]
      [(LookupMissing) (Unknown body-id)])))

(define (tc-body-early-exit-fact [state : TcBodyState] [body-id : i64]) : TcBodyEarlyExitFact
  (let
    [data : (Ptr TcBodyStateData) (tc-body-state-view state)]
    (unsafe
      (if (and
        (deref data).early-exit-facts-ready
        (>= body-id 0)
        (< body-id (deref data).early-exit-source-expr-limit))
        (let
          [word-index : i64 (/ body-id 64)]
          [bit-index : i64 (% body-id 64)]
          [bit : i64 (shl 1 bit-index)]
          [known : i64 (array-ref (deref data).early-exit-known word-index)]
          (if (= (bit-and known bit) 0)
            (Unknown)
            (let
              [bits : i64 (array-ref (deref data).early-exit-facts word-index)]
              (Known (not (= (bit-and bits bit) 0))))))
        (Unknown)))))

(define (tc-body-type-fact-initial-capacity) : i64
  1024)

;; Body checks run in a rewindable per-function arena, so reusable facts cannot
;; be allocated by the first body that happens to need them. Give the table a
;; phase-lifetime arena: build its dense index once before body checking, grow
;; only its compact value buffers, and release the whole arena when source
;; typechecking finishes.
(define (tc-body-type-fact-storage-release! [state : TcBodyState]) : unit
  (unsafe
    (let
      [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
      [storage : i64 (deref data).type-fact-storage-arena]
      (unless
        (= storage 0)
        (if (= (arena.tl_arena_current) storage)
          (arena.tl_arena_set (deref data).type-fact-enclosing-arena)
          unit)
        ;; Replace storage-owned arrays before destroying their arena. The
        ;; returned context retains only these tiny idle placeholders plus the
        ;; early-exit bitsets needed by lowering.
        (set! (deref data).type-fact-index (__tl_make-array i64 1))
        (set! (deref data).type-fact-expr-ids (__tl_make-array i64 1))
        (set! (deref data).type-fact-types (__tl_make-array ast.AstType 1))
        (set! (deref data).type-fact-storage-arena 0)
        (set! (deref data).type-fact-enclosing-arena 0)
        (set! (deref data).type-fact-count 0)
        (set! (deref data).type-facts-recording false)
        (set! (deref data).type-facts-consuming false)
        (arena.tl_arena_destroy storage)))))

(define (tc-body-type-fact-storage-start!
  [state : TcBodyState]
  [source-limit : i64]) : unit
  (tc-body-type-fact-storage-release! state)
  (let
    [enclosing : i64 (arena.tl_arena_current)]
    [storage : i64 (arena.tl_arena_make)]
    [index-cap : i64
      (if (> source-limit 0)
        source-limit
        1)]
    (in-arena
      (unsafe
        (arena.Arena storage))
      (let
        [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
        (unsafe
          (set! (deref data).type-fact-storage-arena storage)
          (set! (deref data).type-fact-enclosing-arena enclosing)
          (set! (deref data).type-fact-index (__tl_make-array i64 index-cap))
          (set!
            (deref data).type-fact-expr-ids
            (__tl_make-array i64 (tc-body-type-fact-initial-capacity)))
          (set!
            (deref data).type-fact-types
            (__tl_make-array ast.AstType (tc-body-type-fact-initial-capacity)))
          (set! (deref data).type-fact-count 0))))))

(define (tc-body-type-fact-grow-copy!
  [dst-types : (&mut dst-types (__tl_dyn-array ast.AstType))]
  [dst-expr-ids : (&mut dst-expr-ids (__tl_dyn-array i64))]
  [src-types : (& src-types (__tl_dyn-array ast.AstType))]
  [src-expr-ids : (& src-expr-ids (__tl_dyn-array i64))]
  [count : i64]
  [index : i64]) : unit
  (let
    [i : i64 index]
    (while (< i count)
      (set!
        (array-ref dst-types i)
        (owned_view.compiler-owned-element-view src-types i))
      (set! (array-ref dst-expr-ids i) (array-ref src-expr-ids i))
      (set! i (+ i 1)))))

(define (tc-body-type-fact-grow! [state : TcBodyState]) : unit
  (unsafe
    (let
      [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
      [old-types : (__tl_dyn-array ast.AstType) (deref data).type-fact-types]
      [old-expr-ids : (__tl_dyn-array i64) (deref data).type-fact-expr-ids]
      [old-cap : i64 (array-length old-types)]
      [new-cap : i64
        (if (< old-cap 1)
          (tc-body-type-fact-initial-capacity)
          (* old-cap 2))]
      (in-arena
        (unsafe
          (arena.Arena (deref data).type-fact-storage-arena))
        (let
          [next-types : (__tl_dyn-array ast.AstType)
            (__tl_make-array ast.AstType new-cap)]
          [next-expr-ids : (__tl_dyn-array i64) (__tl_make-array i64 new-cap)]
          (tc-body-type-fact-grow-copy!
            (&mut next-types)
            (&mut next-expr-ids)
            (& old-types)
            (& old-expr-ids)
            (deref data).type-fact-count
            0)
          (set! (deref data).type-fact-types next-types)
          (set! (deref data).type-fact-expr-ids next-expr-ids))))))

(define (tc-body-type-fact-clear-recorded-index! [state : TcBodyState]) : unit
  (unsafe
    (let
      [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
      [i : i64 0]
      [index-len : i64 (array-length (deref data).type-fact-index)]
      (while (< i (deref data).type-fact-count)
        (let
          [expr-id : i64 (array-ref (deref data).type-fact-expr-ids i)]
          (if (and (>= expr-id 0) (< expr-id index-len))
            (set! (array-ref (deref data).type-fact-index expr-id) 0)
            unit)
          (set! i (+ i 1))))
      (set! (deref data).type-fact-count 0))))

(define (tc-body-type-fact-ensure-storage! [state : TcBodyState]) : unit
  (unsafe
    (let
      [data : (Ptr TcBodyStateData) (tc-body-state-view state)]
      [source-limit : i64
        (if (> (deref data).early-exit-source-expr-limit 0)
          (deref data).early-exit-source-expr-limit
          1)]
      (if (or
        (= (deref data).type-fact-storage-arena 0)
        (< (array-length (deref data).type-fact-index) source-limit)
        (<
          (array-length (deref data).type-fact-types)
          (tc-body-type-fact-initial-capacity)))
        (tc-body-type-fact-storage-start! state source-limit)
        unit))))

(define (tc-body-type-fact-slot [state : TcBodyState] [expr-id : i64]) : i64
  (let
    [data : (Ptr TcBodyStateData) (tc-body-state-view state)]
    (unsafe
      (if (and
        (>= expr-id 0)
        (< expr-id (array-length (deref data).type-fact-index)))
        (- (array-ref (deref data).type-fact-index expr-id) 1)
        -1))))

(define (tc-body-type-facts-start-recording! [state : TcBodyState]) : unit
  (tc-body-type-fact-ensure-storage! state)
  (tc-body-type-fact-clear-recorded-index! state)
  (let
    [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    (unsafe
      (set! (deref data).type-facts-consuming false)
      (set! (deref data).type-facts-recording true))))

(define (tc-body-type-facts-start-consuming! [state : TcBodyState]) : unit
  (let
    [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    (unsafe
      (set! (deref data).type-facts-recording false)
      (set! (deref data).type-facts-consuming true))))

(define (tc-body-type-facts-clear! [state : TcBodyState]) : unit
  (let
    [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    (unsafe
      (set! (deref data).type-facts-recording false)
      (set! (deref data).type-facts-consuming false))
    (tc-body-type-fact-clear-recorded-index! state)))

(define (tc-body-type-fact-record!
  [state : TcBodyState]
  [expr-id : i64]
  [ty : ast.AstType]) : unit
  (let
    [data : (Ptr TcBodyStateData) (tc-body-state-view state)]
    (unsafe
      (if (and
        (deref data).type-facts-recording
        (>= expr-id 0)
        (< expr-id (array-length (deref data).type-fact-index)))
        (if (>= (tc-body-type-fact-slot state expr-id) 0)
          unit
          (let
            [slot : i64 (deref data).type-fact-count]
            (if (>= slot (array-length (deref data).type-fact-types))
              (tc-body-type-fact-grow! state)
              unit)
            (let
              [ready : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
              (set! (array-ref (deref ready).type-fact-types slot) ty)
              (set! (array-ref (deref ready).type-fact-expr-ids slot) expr-id)
              (set!
                (array-ref (deref ready).type-fact-index expr-id)
                (+ slot 1))
              (set! (deref ready).type-fact-count (+ slot 1)))))
        unit))))

(define (tc-body-type-fact-lookup [state : TcBodyState] [expr-id : i64]) : TcBodyTypeFact
  (let
    [data : (Ptr TcBodyStateData) (tc-body-state-view state)]
    (unsafe
      (if (deref data).type-facts-consuming
        (let
          [slot : i64 (tc-body-type-fact-slot state expr-id)]
          (if (and (>= slot 0) (< slot (deref data).type-fact-count))
            (Hit (ast.ast-array-shared-view (deref data).type-fact-types slot))
            (Miss)))
        (Miss)))))

;; Semantic queries observe recorded operands during inference. They never
;; activate the consuming cache or recheck an expression to obtain a type.
(define (tc-semantic-recorded-type [ctx : TcContext] [expr-id : i64]) : TcBodyTypeFact
  (let
    [state : TcBodyState (tc-context-body-state ctx)]
    [data : TcBodyStateData (tc-body-state-data-value state)]
    [slot : i64 (tc-body-type-fact-slot state expr-id)]
    (if (and
      data.type-facts-recording
      (>= slot 0)
      (< slot data.type-fact-count))
      (Hit (ast.ast-array-shared-view data.type-fact-types slot))
      (if data.type-facts-recording
        (match (tc-context-expr-get ctx expr-id)
          [(or (Spanned inner _) (MacroExpansion inner _ _))
            (tc-semantic-recorded-type ctx inner)]
          [_ (Miss)])
        (Miss)))))

(defenum TcBorrowPlace
  ;; The borrow's lifetime, the referent type, whether the path to the
