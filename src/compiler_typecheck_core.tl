      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [lane : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases lane-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env value)
          [(ResultTcSpmdExprInfo.Ok value-info)
            (match value-info
              [(TcSpmdExprInfo _ value-class value-env)
                (match (tc-spmd-expr-with-expected-or-actual
                  ctx
                  expr-bases
                  env
                  value-env
                  lane
                  (ast.AstType.I64))
                  [(ResultTcSpmdExprInfo.Ok lane-info)
                    (match lane-info
                      [(TcSpmdExprInfo lane-ty lane-class lane-env)
                        (tc-spmd-broadcast-finish
                          ctx
                          expr-ty
                          value-class
                          lane-ty
                          lane-class
                          lane-env)])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [lane : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases lane-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env value)
          [(ResultTcSpmdExprInfo.Ok value-info)
            (match value-info
              [(TcSpmdExprInfo _ value-class value-env)
                (match (tc-spmd-expr-with-expected-or-actual
                  ctx
                  expr-bases
                  env
                  value-env
                  lane
                  (ast.AstType.I64))
                  [(ResultTcSpmdExprInfo.Ok lane-info)
                    (match lane-info
                      [(TcSpmdExprInfo lane-ty _ lane-env)
                        (tc-spmd-shuffle-finish
                          ctx
                          expr-ty
                          value-class
                          lane-ty
                          lane-env)])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.Borrow _ _ place-box)
      (let
        [place : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases place-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env place)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.StructGet receiver-box _)
      (let
        [receiver : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases receiver-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env receiver)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.Box inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.BoxGet inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.BoxTake inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.BoxSet inner-box value-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ inner-class inner-env)
                (match (tc-spmd-expr ctx expr-bases env inner-env value)
                  [(ResultTcSpmdExprInfo.Ok value-info)
                    (match value-info
                      [(TcSpmdExprInfo _ value-class next-spmd-env)
                        (tc-spmd-finish
                          expr-ty
                          (tc-spmd-merge-class inner-class value-class)
                          next-spmd-env)])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.WithRegion region body)
      (tc-spmd-begin-list
        ctx
        expr-bases
        (tc-push-region env region)
        spmd-env
        body)]
    [(ast.AstExpr.WithEscape _ _)
      (ResultTcSpmdExprInfo.Err
        "typecheck: with-escape inside spmd is not supported")]
    [(ast.AstExpr.WithScratch _)
      (ResultTcSpmdExprInfo.Err
        "typecheck: with-scratch inside spmd is not supported")]
    [(ast.AstExpr.InArena _ _)
      (ResultTcSpmdExprInfo.Err
        "typecheck: in-arena inside spmd is not supported")]
    [(ast.AstExpr.WithResource _)
      (ResultTcSpmdExprInfo.Err
        "typecheck: resource with is not implemented yet")]
    [(ast.AstExpr.Comptime inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.Quote _)
      (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(ast.AstExpr.Quasiquote _)
      (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(ast.AstExpr.Unquote _)
      (ResultTcSpmdExprInfo.Err
        "typecheck: unquote is only valid inside quasiquote")]
    [(ast.AstExpr.UnquoteSplicing _)
      (ResultTcSpmdExprInfo.Err
        "typecheck: unquote-splicing is only valid inside quasiquote")]
    [(ast.AstExpr.Try _)
      (ResultTcSpmdExprInfo.Err
        "typecheck: try inside foreach is not supported")]
    [(ast.AstExpr.Return _)
      (ResultTcSpmdExprInfo.Err
        "typecheck: return inside foreach is not supported")]
    [(ast.AstExpr.Break)
      (ResultTcSpmdExprInfo.Err
        "typecheck: break inside foreach is not supported")]
    [(ast.AstExpr.Continue)
      (ResultTcSpmdExprInfo.Err
        "typecheck: continue inside foreach is not supported")]
    [(ast.AstExpr.PtrNull _)
      (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(ast.AstExpr.PtrNullCheck inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.PtrAddrOf place-box)
      (let
        [place : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases place-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env place)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.PtrRead ptr-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env ptr)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env ptr)
          [(ResultTcSpmdExprInfo.Ok ptr-info)
            (match ptr-info
              [(TcSpmdExprInfo _ ptr-class ptr-env)
                (match (tc-spmd-expr ctx expr-bases env ptr-env value)
                  [(ResultTcSpmdExprInfo.Ok value-info)
                    (match value-info
                      [(TcSpmdExprInfo _ value-class value-env)
                        (tc-spmd-finish
                          expr-ty
                          (tc-spmd-merge-class ptr-class value-class)
                          value-env)])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [offset : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases offset-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env ptr)
          [(ResultTcSpmdExprInfo.Ok ptr-info)
            (match ptr-info
              [(TcSpmdExprInfo _ ptr-class ptr-env)
                (match (tc-spmd-expr ctx expr-bases env ptr-env offset)
                  [(ResultTcSpmdExprInfo.Ok offset-info)
                    (match offset-info
                      [(TcSpmdExprInfo _ offset-class offset-env)
                        (tc-spmd-finish
                          expr-ty
                          (tc-spmd-merge-class ptr-class offset-class)
                          offset-env)])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.PtrCast ptr-box _)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env ptr)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.PtrToInt ptr-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env ptr)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.IntToPtr value-box _)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env value)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.StringData str-box)
      (let
        [str : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases str-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env str)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [len : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases len-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env ptr)
          [(ResultTcSpmdExprInfo.Ok ptr-info)
            (match ptr-info
              [(TcSpmdExprInfo _ ptr-class ptr-env)
                (match (tc-spmd-expr ctx expr-bases env ptr-env len)
                  [(ResultTcSpmdExprInfo.Ok len-info)
                    (match len-info
                      [(TcSpmdExprInfo _ len-class len-env)
                        (tc-spmd-finish
                          expr-ty
                          (tc-spmd-merge-class ptr-class len-class)
                          len-env)])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.ArrayData array-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env array)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.BinaryData _)
      (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(ast.AstExpr.ProgramArgc)
      (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(ast.AstExpr.ProgramArgv)
      (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(ast.AstExpr.ProgramEnvp)
      (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(ast.AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (tc-spmd-cpuid-like ctx expr-bases env spmd-env expr-ty leaf subleaf))]
    [(ast.AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (tc-spmd-cpuid-like ctx expr-bases env spmd-env expr-ty leaf subleaf))]
    [(ast.AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (tc-spmd-cpuid-like ctx expr-bases env spmd-env expr-ty leaf subleaf))]
    [(ast.AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (tc-spmd-cpuid-like ctx expr-bases env spmd-env expr-ty leaf subleaf))]
    [(ast.AstExpr.Xgetbv index-box)
      (let
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (match (tc-spmd-expr ctx expr-bases env spmd-env index)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(ast.AstExpr.Syscall args)
      (match (tc-spmd-expr-list ctx expr-bases env spmd-env args)
        [(ResultTcSpmdExprListInfo.Ok args-info)
          (match args-info
            [(TcSpmdExprListInfo args-class args-env)
              (match (tc-spmd-require-uniform
                args-class
                "typecheck: foreach calls with varying arguments are not supported")
                [(ResultTcUnit.Ok)
                  (tc-spmd-finish expr-ty TcSpmdClass.Uniform args-env)]
                [(ResultTcUnit.Err message) (ResultTcSpmdExprInfo.Err message)])])]
        [(ResultTcSpmdExprListInfo.Err message)
          (ResultTcSpmdExprInfo.Err message)])]))

(define (tc-param-list-add-bound-names
  [params : ast.AstParamList]
  [bound : TcStringList]) : TcStringList
  (tc-param-list-add-bound-names-at (& params) 0 bound))

(define (tc-param-list-add-bound-names-at
  [params : (& params ast.AstParamList)]
  [index : i64]
  [bound : TcStringList]) : TcStringList
  (if (>= index (ast.ast-param-list-len params))
    bound
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(ast.AstParam.Param name _ _ _)
        (tc-param-list-add-bound-names-at
          params
          (+ index 1)
          (tc-string-list-add bound (tc-env-key-name-text name)))])))

(define (tc-param-bound-names [params : ast.AstParamList]) : TcStringList
  (tc-param-list-add-bound-names params TcStringList.Nil))

(define (tc-pattern-add-bound-names
  [pattern : ast.AstPattern]
  [bound : TcStringList]) : TcStringList
  (match pattern
    [(ast.AstPattern.Var name _)
      (tc-string-list-add bound (tc-env-key-name-text name))]
    [(ast.AstPattern.Tuple patterns-box)
      (let
        [patterns : ast.AstPatternList (__tl-box-place patterns-box)]
        (tc-pattern-list-add-bound-names patterns bound))]
    [(ast.AstPattern.Array patterns-box)
      (let
        [patterns : ast.AstPatternList (__tl-box-place patterns-box)]
        (tc-pattern-list-add-bound-names patterns bound))]
    [(ast.AstPattern.Wildcard) bound]
    [(ast.AstPattern.Binding name)
      (tc-string-list-add bound (tc-env-key-name-text name))]
    [(ast.AstPattern.Variant _ patterns-box)
      (let
        [patterns : ast.AstPatternList (__tl-box-place patterns-box)]
        (tc-pattern-list-add-bound-names patterns bound))]
    [(ast.AstPattern.Literal _) bound]))

(define (tc-pattern-list-add-bound-names
  [patterns : ast.AstPatternList]
  [bound : TcStringList]) : TcStringList
  (tc-pattern-list-add-bound-names-at (& patterns) bound 0))

(define (tc-pattern-list-add-bound-names-at
  [patterns : (& patterns ast.AstPatternList)]
  [bound : TcStringList]
  [index : i64]) : TcStringList
  (if (>= index patterns.len)
    bound
    (tc-pattern-list-add-bound-names-at
      patterns
      (tc-pattern-add-bound-names
        (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))
        bound)
      (+ index 1))))

(define (tc-pattern-add-bound-name-ids
  [pattern : ast.AstPattern]
  [bound : TcNameIdList]) : TcNameIdList
  (match pattern
    [(ast.AstPattern.Var name _) (tc-name-id-list-add bound name)]
    [(ast.AstPattern.Tuple patterns-box)
      (tc-pattern-list-add-bound-name-ids (__tl-box-place patterns-box) bound)]
    [(ast.AstPattern.Array patterns-box)
      (tc-pattern-list-add-bound-name-ids (__tl-box-place patterns-box) bound)]
    [(ast.AstPattern.Wildcard) bound]
    [(ast.AstPattern.Binding name) (tc-name-id-list-add bound name)]
    [(ast.AstPattern.Variant _ patterns-box)
      (tc-pattern-list-add-bound-name-ids (__tl-box-place patterns-box) bound)]
    [(ast.AstPattern.Literal _) bound]))

(define (tc-pattern-list-add-bound-name-ids
  [patterns : ast.AstPatternList]
  [bound : TcNameIdList]) : TcNameIdList
  (tc-pattern-list-add-bound-name-ids-at (& patterns) bound 0))

(define (tc-pattern-list-add-bound-name-ids-at
  [patterns : (& patterns ast.AstPatternList)]
  [bound : TcNameIdList]
  [index : i64]) : TcNameIdList
  (if (>= index patterns.len)
    bound
    (tc-pattern-list-add-bound-name-ids-at
      patterns
      (tc-pattern-add-bound-name-ids
        (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))
        bound)
      (+ index 1))))

(define (tc-let-binding-list-add-bound-names
  [bindings : ast.AstLetBindingList]
  [bound : TcStringList]) : TcStringList
  (tc-let-binding-list-add-bound-names-at (& bindings) bound 0))

(define (tc-let-binding-list-add-bound-names-at
  [bindings : (& bindings ast.AstLetBindingList)]
  [bound : TcStringList]
  [index : i64]) : TcStringList
  (if (>= index (ast.ast-let-binding-list-len bindings))
    bound
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding name _ _)
        (tc-let-binding-list-add-bound-names-at
          bindings
          (tc-string-list-add bound (tc-env-key-name-text name))
          (+ index 1))])))

(define (tc-let-binding-list-add-bound-name-ids
  [bindings : ast.AstLetBindingList]
  [bound : TcNameIdList]) : TcNameIdList
  (tc-let-binding-list-add-bound-name-ids-at (& bindings) bound 0))

(define (tc-let-binding-list-add-bound-name-ids-at
  [bindings : (& bindings ast.AstLetBindingList)]
  [bound : TcNameIdList]
  [index : i64]) : TcNameIdList
  (if (>= index (ast.ast-let-binding-list-len bindings))
    bound
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding name _ _)
        (tc-let-binding-list-add-bound-name-ids-at
          bindings
          (tc-name-id-list-add bound name)
          (+ index 1))])))

(define (tc-resource-binding-list-add-bound-names
  [bindings : ast.AstResourceBindingList]
  [bound : TcStringList]) : TcStringList
  (tc-resource-binding-list-add-bound-names-at (& bindings) bound 0))

(define (tc-resource-binding-list-add-bound-names-at
  [bindings : (& bindings ast.AstResourceBindingList)]
  [bound : TcStringList]
  [index : i64]) : TcStringList
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    bound
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(ast.AstResourceBinding.Binding name _ _ _)
        (tc-resource-binding-list-add-bound-names-at
          bindings
          (tc-string-list-add bound (tc-env-key-name-text name))
          (+ index 1))])))

(define (tc-expr-list-uses-free-name?
  [expr-bases : i64]
  [exprs : ast.AstExprList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-expr-list-uses-free-name-at? expr-bases (& exprs) 0 name bound))

(define (tc-expr-list-uses-free-name-at?
  [expr-bases : i64]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [name : String]
  [bound : TcStringList]) : bool
  (if (>= index exprs.len)
    false
    (or
      (tc-expr-uses-free-name?
        expr-bases
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get exprs index 0))
        name
        bound)
      (tc-expr-list-uses-free-name-at? expr-bases exprs (+ index 1) name bound))))

(define (tc-let-binding-list-uses-free-name?
  [expr-bases : i64]
  [bindings : ast.AstLetBindingList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-let-binding-list-uses-free-name-at? expr-bases (& bindings) name bound 0))

(define (tc-let-binding-list-uses-free-name-at?
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [name : String]
  [bound : TcStringList]
  [index : i64]) : bool
  (if (>= index (ast.ast-let-binding-list-len bindings))
    false
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding bind-name _ init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          (or
            (tc-expr-uses-free-name? expr-bases init name bound)
            (tc-let-binding-list-uses-free-name-at?
              expr-bases
              bindings
              name
              (tc-string-list-add bound (ci.intern-str bind-name))
              (+ index 1))))])))

(define (tc-resource-binding-list-uses-free-name?
  [expr-bases : i64]
  [bindings : ast.AstResourceBindingList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-resource-binding-list-uses-free-name-at?
    expr-bases
    (& bindings)
    name
    bound
    0))

(define (tc-resource-binding-list-uses-free-name-at?
  [expr-bases : i64]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [name : String]
  [bound : TcStringList]
  [index : i64]) : bool
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    false
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(ast.AstResourceBinding.Binding bind-name init-box cleanup-box _)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [cleanup : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases cleanup-box)]
          (or
            (tc-expr-uses-free-name? expr-bases init name bound)
            (tc-expr-uses-free-name? expr-bases cleanup name bound)
            (tc-resource-binding-list-uses-free-name-at?
              expr-bases
              bindings
              name
              (tc-string-list-add bound (ci.intern-str bind-name))
              (+ index 1))))])))

(define (tc-match-arms-use-free-name?
  [expr-bases : i64]
  [arms : ast.AstMatchArmList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-match-arms-use-free-name-at? expr-bases (& arms) name bound 0))

(define (tc-match-arms-use-free-name-at?
  [expr-bases : i64]
  [arms : (& arms ast.AstMatchArmList)]
  [name : String]
  [bound : TcStringList]
  [index : i64]) : bool
  (if (>= index arms.len)
    false
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm pattern body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          (or
            (tc-expr-uses-free-name?
              expr-bases
              body
              name
              (tc-pattern-add-bound-names pattern bound))
            (tc-match-arms-use-free-name-at?
              expr-bases
              arms
              name
              bound
              (+ index 1))))])))

(define (tc-for-owned-name-id [expr-bases : i64] [expr-id : i64]) : i64
  (tc-expr-var-name-id (ast.ast-expr-segment-bases-get expr-bases expr-id)))

(define (tc-for-owned-add-bound-name
  [expr-bases : i64]
  [expr-id : i64]
  [bound : TcStringList]) : TcStringList
  (let
    [name-id : i64 (tc-for-owned-name-id expr-bases expr-id)]
    (if (>= name-id 0)
      (tc-string-list-add bound (tc-env-key-name-text name-id))
      bound)))

(define (tc-for-owned-add-bound-source-id
  [expr-bases : i64]
  [expr-id : i64]
  [bound : TcNameIdList]) : TcNameIdList
  (let
    [name-id : i64 (tc-for-owned-name-id expr-bases expr-id)]
    (if (>= name-id 0)
      (tc-name-id-list-add bound (tc-env-key-source-id-or-neg name-id))
      bound)))

(define (tc-expr-uses-free-name?
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [name : String]
  [bound : TcStringList]) : bool
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-expr-uses-free-name? expr-bases inner name bound))]
    [(ast.AstExpr.MacroExpansion inner-box _ _)
      (tc-expr-uses-free-name?
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box)
        name
        bound)]
    [(ast.AstExpr.Literal _) false]
    [(ast.AstExpr.Var var-name)
      (and
        (string.eq (tc-env-key-name-text var-name) name)
        (not (tc-string-list-contains bound name)))]
    [(ast.AstExpr.Binary _ left-box right-box)
      (let
        [left : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases left-box)]
        [right : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases right-box)]
        (or
          (tc-expr-uses-free-name? expr-bases left name bound)
          (tc-expr-uses-free-name? expr-bases right name bound)))]
    [(ast.AstExpr.Unary _ inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-expr-uses-free-name? expr-bases inner name bound))]
    [(ast.AstExpr.Call func-box args)
      (let
        [func : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases func-box)]
        (or
          (tc-expr-uses-free-name? expr-bases func name bound)
          (tc-expr-list-uses-free-name? expr-bases args name bound)))]
    [(ast.AstExpr.BracketClause items)
      (tc-expr-list-uses-free-name? expr-bases items name bound)]
    [(ast.AstExpr.TypeLiteral _) false]
    [(ast.AstExpr.Init _) false]
    [(ast.AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases cond-box)]
        [then-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases then-branch-box)]
        [else-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases else-branch-box)]
        (or
          (tc-expr-uses-free-name? expr-bases cond name bound)
          (tc-expr-uses-free-name? expr-bases then-branch name bound)
          (tc-expr-uses-free-name? expr-bases else-branch name bound)))]
    [(ast.AstExpr.Let let-box)
      (match (__tl-box-place let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (or
              (tc-let-binding-list-uses-free-name?
                expr-bases
                bindings
                name
                bound)
              (tc-expr-uses-free-name?
                expr-bases
                body
                name
                (tc-let-binding-list-add-bound-names bindings bound))))])]
    [(ast.AstExpr.Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(ast.AstLambda.Lambda params _ body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (tc-expr-uses-free-name?
              expr-bases
              body
              name
              (tc-param-list-add-bound-names params bound)))])]
    [(ast.AstExpr.Tuple exprs)
      (tc-expr-list-uses-free-name? expr-bases exprs name bound)]
    [(ast.AstExpr.TupleRef tuple-box _)
      (let
        [tuple : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases tuple-box)]
        (tc-expr-uses-free-name? expr-bases tuple name bound))]
    [(ast.AstExpr.Array exprs)
      (tc-expr-list-uses-free-name? expr-bases exprs name bound)]
    [(ast.AstExpr.DynArray exprs)
      (tc-expr-list-uses-free-name? expr-bases exprs name bound)]
    [(ast.AstExpr.MakeArray _ len-box)
      (let
        [len : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases len-box)]
        (tc-expr-uses-free-name? expr-bases len name bound))]
    [(ast.AstExpr.ArrayRef array-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (or
          (tc-expr-uses-free-name? expr-bases array name bound)
          (tc-expr-uses-free-name? expr-bases index name bound)))]
    [(ast.AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (or
          (tc-expr-uses-free-name? expr-bases array name bound)
          (tc-expr-uses-free-name? expr-bases index name bound)
          (tc-expr-uses-free-name? expr-bases value name bound)))]
    [(ast.AstExpr.ArrayTake array-box live-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [live : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases live-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (or
          (tc-expr-uses-free-name? expr-bases array name bound)
          (tc-expr-uses-free-name? expr-bases live name bound)
          (tc-expr-uses-free-name? expr-bases index name bound)))]
    [(ast.AstExpr.FixedArrayTake array-box index-box)
      (or
        (tc-expr-uses-free-name?
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases array-box)
          name
          bound)
        (tc-expr-uses-free-name?
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases index-box)
          name
          bound))]
    [(ast.AstExpr.Replace place-box replacement-box)
      (or
        (tc-expr-uses-free-name?
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases place-box)
          name
          bound)
        (tc-expr-uses-free-name?
          expr-bases
          (ast.ast-expr-segment-bases-get expr-bases replacement-box)
          name
          bound))]
    [(ast.AstExpr.ArrayPush array-box value-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (or
          (tc-expr-uses-free-name? expr-bases array name bound)
          (tc-expr-uses-free-name? expr-bases value name bound)))]
    [(ast.AstExpr.StringRef str-box index-box)
      (let
        [str : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases str-box)]
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (or
          (tc-expr-uses-free-name? expr-bases str name bound)
          (tc-expr-uses-free-name? expr-bases index name bound)))]
    [(ast.AstExpr.While cond-box body-box)
      (let
        [cond : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases cond-box)]
        [body : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases body-box)]
        (or
          (tc-expr-uses-free-name? expr-bases cond name bound)
          (tc-expr-uses-free-name? expr-bases body name bound)))]
    [(ast.AstExpr.ForOwnedState payload)
      (let
        [source-name : i64 (ast.ast-for-owned-state-source-name (& payload))]
        [index-name : i64 (ast.ast-for-owned-state-index-name (& payload))]
        (or
          (tc-expr-uses-free-name?
            expr-bases
            (ast.ast-expr-segment-bases-get
              expr-bases
              (ast.ast-for-owned-state-source (& payload)))
            name
            bound)
          (tc-expr-uses-free-name?
            expr-bases
            (ast.ast-expr-segment-bases-get
              expr-bases
              (ast.ast-for-owned-state-body (& payload)))
            name
            (tc-for-owned-add-bound-name
              expr-bases
              index-name
              (tc-for-owned-add-bound-name expr-bases source-name bound)))))]
    [(ast.AstExpr.ForOwnedStep payload)
      (let
        [source-name : i64 (ast.ast-for-owned-step-source-name (& payload))]
        [index-name : i64 (ast.ast-for-owned-step-index-name (& payload))]
        [binding-name : i64 (ast.ast-for-owned-step-binding-name (& payload))]
        [expected-type : i64 (ast.ast-for-owned-step-expected-type (& payload))]
        [done-name : i64 (ast.ast-for-owned-step-done-name (& payload))]
        [body : i64 (ast.ast-for-owned-step-body (& payload))]
        (or
          (tc-expr-uses-free-name?
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases source-name)
            name
            bound)
          (tc-expr-uses-free-name?
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases index-name)
            name
            bound)
          (if (>= expected-type 0)
            (tc-expr-uses-free-name?
              expr-bases
              (ast.ast-expr-segment-bases-get expr-bases expected-type)
              name
              bound)
            false)
          (tc-expr-uses-free-name?
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases done-name)
            name
            bound)
          (tc-expr-uses-free-name?
            expr-bases
            (ast.ast-expr-segment-bases-get expr-bases body)
            name
            (tc-for-owned-add-bound-name expr-bases binding-name bound))))]
    [(ast.AstExpr.Begin exprs)
      (tc-expr-list-uses-free-name? expr-bases exprs name bound)]
    [(ast.AstExpr.Unsafe exprs)
      (tc-expr-list-uses-free-name? expr-bases exprs name bound)]
    [(ast.AstExpr.Set var-name value-box)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (or
          (and
            (string.eq (tc-env-key-name-text var-name) name)
            (not (tc-string-list-contains bound name)))
          (tc-expr-uses-free-name? expr-bases value name bound)))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-expr-uses-free-name? expr-bases inner name bound))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-expr-uses-free-name? expr-bases inner name bound))]
    [(ast.AstExpr.Borrow _ _ place-box)
      (let
        [place : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases place-box)]
        (tc-expr-uses-free-name? expr-bases place name bound))]
    [(ast.AstExpr.Box inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-expr-uses-free-name? expr-bases inner name bound))]
    [(ast.AstExpr.BoxGet inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-expr-uses-free-name? expr-bases inner name bound))]
    [(ast.AstExpr.BoxTake inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-expr-uses-free-name? expr-bases inner name bound))]
    [(ast.AstExpr.BoxSet inner-box value-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (or
          (tc-expr-uses-free-name? expr-bases inner name bound)
          (tc-expr-uses-free-name? expr-bases value name bound)))]
    [(ast.AstExpr.Match match-box)
      (match (__tl-box-place match-box)
        [(ast.AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases scrutinee-box)]
            (or
              (tc-expr-uses-free-name? expr-bases scrutinee name bound)
              (tc-match-arms-use-free-name? expr-bases arms name bound)))])]
    [(ast.AstExpr.Foreach fe-box)
      (match (__tl-box-place fe-box)
        [(ast.AstForeach.Foreach index _ start-box end-box body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (or
              (tc-expr-uses-free-name? expr-bases start name bound)
              (tc-expr-uses-free-name? expr-bases end name bound)
              (tc-expr-uses-free-name?
                expr-bases
                body
                name
                (tc-string-list-add bound (tc-env-key-name-text index)))))])]
    [(ast.AstExpr.SpmdReduce reduce-box)
      (match (__tl-box-place reduce-box)
        [(ast.AstSpmdReduce.Reduce
            _
            index
            _
            start-box
            end-box
            init-box
            value-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [value : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases value-box)]
            (or
              (tc-expr-uses-free-name? expr-bases start name bound)
              (tc-expr-uses-free-name? expr-bases end name bound)
              (tc-expr-uses-free-name? expr-bases init name bound)
              (tc-expr-uses-free-name?
                expr-bases
                value
                name
                (tc-string-list-add bound (tc-env-key-name-text index)))))])]
    [(ast.AstExpr.SpmdScan scan-box)
      (match (__tl-box-place scan-box)
        [(ast.AstSpmdScan.Scan
            _
            index
            _
            start-box
            end-box
            prefix
            _
            init-box
            value-box
            body-box)
          (let
            [start : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases start-box)]
            [end : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases end-box)]
            [init : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases init-box)]
            [value : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases value-box)]
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            [value-bound : TcStringList
              (tc-string-list-add bound (tc-env-key-name-text index))]
            [body-bound : TcStringList
              (tc-string-list-add value-bound (tc-env-key-name-text prefix))]
            (or
              (tc-expr-uses-free-name? expr-bases start name bound)
              (tc-expr-uses-free-name? expr-bases end name bound)
              (tc-expr-uses-free-name? expr-bases init name bound)
              (tc-expr-uses-free-name? expr-bases value name value-bound)
              (tc-expr-uses-free-name? expr-bases body name body-bound)))])]
    [(ast.AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [lane : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases lane-box)]
        (or
          (tc-expr-uses-free-name? expr-bases value name bound)
          (tc-expr-uses-free-name? expr-bases lane name bound)))]
    [(ast.AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        [lane : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases lane-box)]
        (or
          (tc-expr-uses-free-name? expr-bases value name bound)
          (tc-expr-uses-free-name? expr-bases lane name bound)))]
    [(ast.AstExpr.StructGet receiver-box _)
      (let
        [receiver : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases receiver-box)]
        (tc-expr-uses-free-name? expr-bases receiver name bound))]
    [(ast.AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases receiver-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (or
          (tc-expr-uses-free-name? expr-bases receiver name bound)
          (tc-expr-uses-free-name? expr-bases value name bound)))]
    [(ast.AstExpr.WithRegion _ body)
      (tc-expr-list-uses-free-name? expr-bases body name bound)]
    [(ast.AstExpr.WithEscape scratch-box body)
      (let
        [scratch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases scratch-box)]
        (or
          (tc-expr-uses-free-name? expr-bases scratch name bound)
          (tc-expr-list-uses-free-name? expr-bases body name bound)))]
    [(ast.AstExpr.WithScratch body)
      (tc-expr-list-uses-free-name? expr-bases body name bound)]
    [(ast.AstExpr.InArena arena-box body)
      (let
        [arena : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases arena-box)]
        (or
          (tc-expr-uses-free-name? expr-bases arena name bound)
          (tc-expr-list-uses-free-name? expr-bases body name bound)))]
    [(ast.AstExpr.WithResource wr-box)
      (match (__tl-box-place wr-box)
        [(ast.AstWithResource.WithResource bindings body)
          (or
            (tc-resource-binding-list-uses-free-name?
              expr-bases
              bindings
              name
              bound)
            (tc-expr-list-uses-free-name?
              expr-bases
              body
              name
              (tc-resource-binding-list-add-bound-names bindings bound)))])]
    [(ast.AstExpr.TypeLiteral _) false]
    [(ast.AstExpr.Init _) false]
    [(ast.AstExpr.Comptime inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-expr-uses-free-name? expr-bases inner name bound))]
    [(ast.AstExpr.Quote inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-expr-uses-free-name? expr-bases inner name bound))]
    [(ast.AstExpr.Quasiquote inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-expr-uses-free-name? expr-bases inner name bound))]
    [(ast.AstExpr.Unquote inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-expr-uses-free-name? expr-bases inner name bound))]
    [(ast.AstExpr.UnquoteSplicing inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-expr-uses-free-name? expr-bases inner name bound))]
    [(ast.AstExpr.Try inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-expr-uses-free-name? expr-bases inner name bound))]
    [(ast.AstExpr.Return inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-expr-uses-free-name? expr-bases inner name bound))]
    [(ast.AstExpr.Break) false]
    [(ast.AstExpr.Continue) false]
    [(ast.AstExpr.PtrNull _) false]
    [(ast.AstExpr.PtrNullCheck inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-expr-uses-free-name? expr-bases inner name bound))]
    [(ast.AstExpr.PtrAddrOf place-box)
      (let
        [place : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases place-box)]
        (tc-expr-uses-free-name? expr-bases place name bound))]
    [(ast.AstExpr.PtrRead ptr-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        (tc-expr-uses-free-name? expr-bases ptr name bound))]
    [(ast.AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (or
          (tc-expr-uses-free-name? expr-bases ptr name bound)
          (tc-expr-uses-free-name? expr-bases value name bound)))]
    [(ast.AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [offset : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases offset-box)]
        (or
          (tc-expr-uses-free-name? expr-bases ptr name bound)
          (tc-expr-uses-free-name? expr-bases offset name bound)))]
    [(ast.AstExpr.PtrCast ptr-box _)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        (tc-expr-uses-free-name? expr-bases ptr name bound))]
    [(ast.AstExpr.PtrToInt ptr-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        (tc-expr-uses-free-name? expr-bases ptr name bound))]
    [(ast.AstExpr.IntToPtr value-box _)
      (let
        [value : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases value-box)]
        (tc-expr-uses-free-name? expr-bases value name bound))]
    [(ast.AstExpr.StringData str-box)
      (let
        [str : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases str-box)]
        (tc-expr-uses-free-name? expr-bases str name bound))]
    [(ast.AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
        [len : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases len-box)]
        (or
          (tc-expr-uses-free-name? expr-bases ptr name bound)
          (tc-expr-uses-free-name? expr-bases len name bound)))]
    [(ast.AstExpr.ArrayData array-box)
      (let
        [array : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases array-box)]
        (tc-expr-uses-free-name? expr-bases array name bound))]
    [(ast.AstExpr.BinaryData _) false]
    [(ast.AstExpr.SpmdProgramIndex) false]
    [(ast.AstExpr.SpmdProgramCount) false]
    [(ast.AstExpr.ProgramArgc) false]
    [(ast.AstExpr.ProgramArgv) false]
    [(ast.AstExpr.ProgramEnvp) false]
    [(ast.AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (or
          (tc-expr-uses-free-name? expr-bases leaf name bound)
          (tc-expr-uses-free-name? expr-bases subleaf name bound)))]
    [(ast.AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (or
          (tc-expr-uses-free-name? expr-bases leaf name bound)
          (tc-expr-uses-free-name? expr-bases subleaf name bound)))]
    [(ast.AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (or
          (tc-expr-uses-free-name? expr-bases leaf name bound)
          (tc-expr-uses-free-name? expr-bases subleaf name bound)))]
    [(ast.AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases leaf-box)]
        [subleaf : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases subleaf-box)]
        (or
          (tc-expr-uses-free-name? expr-bases leaf name bound)
          (tc-expr-uses-free-name? expr-bases subleaf name bound)))]
    [(ast.AstExpr.Xgetbv index-box)
      (let
        [index : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases index-box)]
        (tc-expr-uses-free-name? expr-bases index name bound))]
    [(ast.AstExpr.Syscall args)
      (tc-expr-list-uses-free-name? expr-bases args name bound)]))

;; The id rule for a dot-free target text: the source-name id of an env key,
;; or -1 when the key's display can never equal the target. Pool ids render
;; as their text (intern-str is injective), structural-local and hygiene
;; global/local ids render as their source name, and composite keys render
;; dotted (with '/'), so they map to -1. For any dot-free target text T this
;; makes (= (tc-env-key-source-id-or-neg v) (intern T)) EXACTLY
;; (string.eq (tc-env-key-name-text v) T).
(define (tc-env-key-source-id-or-neg [name-id : i64]) : i64
  (cond
    [(and (>= name-id 0) (< name-id (ci.intern-capacity))) name-id]
    [(ci.intern-structural-local-id? name-id)
      (ci.intern-structural-local-source-name-id name-id)]
    [(or (macro-hygiene-global-id? name-id) (macro-hygiene-local-id? name-id))
      (macro-hygiene-structural-source-name-id name-id)]
    [else -1]))

;; Same shadowing rules as `tc-expr-uses-free-name?`, but the target is one or
;; two source-name ids matched in a single walk and the bound set is keyed by
;; source-name id (the exact id form of the string-keyed set for the dot-free
;; target texts the compat prescan uses).
(define (tc-expr-list-uses-free-source-id?
  [expr-bases : i64]
  [exprs : ast.AstExprList]
  [target-1 : i64]
  [target-2 : i64]
  [bound : TcNameIdList]) : bool
  (tc-expr-list-uses-free-source-id-at?
    expr-bases
    (& exprs)
    0
    target-1
    target-2
    bound))

(define (tc-expr-list-uses-free-source-id-at?
  [expr-bases : i64]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [target-1 : i64]
  [target-2 : i64]
  [bound : TcNameIdList]) : bool
  (if (>= index exprs.len)
    false
    (or
      (tc-expr-uses-free-source-id?
        expr-bases
        (ast.ast-expr-segment-bases-get
          expr-bases
          (ast.ast-expr-list-get exprs index 0))
        target-1
        target-2
        bound)
      (tc-expr-list-uses-free-source-id-at?
        expr-bases
        exprs
        (+ index 1)
        target-1
        target-2
        bound))))

(define (tc-let-binding-list-uses-free-source-id?
  [expr-bases : i64]
  [bindings : ast.AstLetBindingList]
  [target-1 : i64]
  [target-2 : i64]
  [bound : TcNameIdList]) : bool
  (tc-let-binding-list-uses-free-source-id-at?
    expr-bases
    (& bindings)
    target-1
    target-2
    bound
    0))

(define (tc-let-binding-list-uses-free-source-id-at?
  [expr-bases : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [target-1 : i64]
  [target-2 : i64]
  [bound : TcNameIdList]
  [index : i64]) : bool
  (if (>= index (ast.ast-let-binding-list-len bindings))
    false
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding bind-name _ init-box)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          (or
            (tc-expr-uses-free-source-id?
              expr-bases
              init
              target-1
              target-2
              bound)
            (tc-let-binding-list-uses-free-source-id-at?
              expr-bases
              bindings
              target-1
              target-2
              (tc-name-id-list-add
                bound
                (tc-env-key-source-id-or-neg bind-name))
              (+ index 1))))])))

(define (tc-resource-binding-list-uses-free-source-id?
  [expr-bases : i64]
  [bindings : ast.AstResourceBindingList]
  [target-1 : i64]
  [target-2 : i64]
  [bound : TcNameIdList]) : bool
  (tc-resource-binding-list-uses-free-source-id-at?
    expr-bases
    (& bindings)
    target-1
    target-2
    bound
    0))

(define (tc-resource-binding-list-uses-free-source-id-at?
  [expr-bases : i64]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [target-1 : i64]
  [target-2 : i64]
  [bound : TcNameIdList]
  [index : i64]) : bool
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    false
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(ast.AstResourceBinding.Binding bind-name init-box cleanup-box _)
        (let
          [init : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases init-box)]
          [cleanup : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases cleanup-box)]
          (or
            (tc-expr-uses-free-source-id?
              expr-bases
              init
              target-1
              target-2
              bound)
            (tc-expr-uses-free-source-id?
              expr-bases
              cleanup
              target-1
              target-2
              bound)
            (tc-resource-binding-list-uses-free-source-id-at?
              expr-bases
              bindings
              target-1
              target-2
              (tc-name-id-list-add
                bound
                (tc-env-key-source-id-or-neg bind-name))
              (+ index 1))))])))

(define (tc-match-arms-use-free-source-id?
  [expr-bases : i64]
  [arms : ast.AstMatchArmList]
  [target-1 : i64]
  [target-2 : i64]
  [bound : TcNameIdList]) : bool
  (tc-match-arms-use-free-source-id-at?
    expr-bases
    (& arms)
    target-1
    target-2
    bound
    0))

(define (tc-match-arms-use-free-source-id-at?
  [expr-bases : i64]
  [arms : (& arms ast.AstMatchArmList)]
  [target-1 : i64]
  [target-2 : i64]
  [bound : TcNameIdList]
  [index : i64]) : bool
  (if (>= index arms.len)
    false
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm pattern body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-expr-segment-bases-get expr-bases body-box)]
          (or
            (tc-expr-uses-free-source-id?
              expr-bases
              body
              target-1
              target-2
              (tc-pattern-add-bound-source-ids pattern bound))
            (tc-match-arms-use-free-source-id-at?
              expr-bases
              arms
              target-1
              target-2
              bound
              (+ index 1))))])))

(define (tc-pattern-add-bound-source-ids
  [pattern : ast.AstPattern]
  [bound : TcNameIdList]) : TcNameIdList
  (match pattern
    [(ast.AstPattern.Var name _)
      (tc-name-id-list-add bound (tc-env-key-source-id-or-neg name))]
    [(ast.AstPattern.Tuple patterns-box)
      (let
        [patterns : ast.AstPatternList (__tl-box-place patterns-box)]
        (tc-pattern-list-add-bound-source-ids patterns bound))]
    [(ast.AstPattern.Array patterns-box)
      (let
        [patterns : ast.AstPatternList (__tl-box-place patterns-box)]
        (tc-pattern-list-add-bound-source-ids patterns bound))]
    [(ast.AstPattern.Wildcard) bound]
    [(ast.AstPattern.Binding name)
      (tc-name-id-list-add bound (tc-env-key-source-id-or-neg name))]
    [(ast.AstPattern.Variant _ patterns-box)
      (let
        [patterns : ast.AstPatternList (__tl-box-place patterns-box)]
        (tc-pattern-list-add-bound-source-ids patterns bound))]
    [(ast.AstPattern.Literal _) bound]))

(define (tc-pattern-list-add-bound-source-ids
  [patterns : ast.AstPatternList]
  [bound : TcNameIdList]) : TcNameIdList
  (tc-pattern-list-add-bound-source-ids-at (& patterns) bound 0))

(define (tc-pattern-list-add-bound-source-ids-at
  [patterns : (& patterns ast.AstPatternList)]
  [bound : TcNameIdList]
  [index : i64]) : TcNameIdList
  (if (>= index patterns.len)
    bound
    (tc-pattern-list-add-bound-source-ids-at
      patterns
      (tc-pattern-add-bound-source-ids
        (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))
        bound)
      (+ index 1))))

(define (tc-let-binding-list-add-bound-source-ids
  [bindings : ast.AstLetBindingList]
  [bound : TcNameIdList]) : TcNameIdList
  (tc-let-binding-list-add-bound-source-ids-at (& bindings) bound 0))

(define (tc-let-binding-list-add-bound-source-ids-at
  [bindings : (& bindings ast.AstLetBindingList)]
  [bound : TcNameIdList]
  [index : i64]) : TcNameIdList
  (if (>= index (ast.ast-let-binding-list-len bindings))
    bound
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding name _ _)
        (tc-let-binding-list-add-bound-source-ids-at
          bindings
          (tc-name-id-list-add bound (tc-env-key-source-id-or-neg name))
          (+ index 1))])))

(define (tc-resource-binding-list-add-bound-source-ids
  [bindings : ast.AstResourceBindingList]
  [bound : TcNameIdList]) : TcNameIdList
  (tc-resource-binding-list-add-bound-source-ids-at (& bindings) bound 0))

(define (tc-resource-binding-list-add-bound-source-ids-at
  [bindings : (& bindings ast.AstResourceBindingList)]
  [bound : TcNameIdList]
  [index : i64]) : TcNameIdList
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    bound
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(ast.AstResourceBinding.Binding name _ _ _)
        (tc-resource-binding-list-add-bound-source-ids-at
          bindings
          (tc-name-id-list-add bound (tc-env-key-source-id-or-neg name))
          (+ index 1))])))

(define (tc-param-list-add-bound-source-ids
  [params : ast.AstParamList]
  [bound : TcNameIdList]) : TcNameIdList
  (tc-param-list-add-bound-source-ids-at (& params) 0 bound))

(define (tc-param-list-add-bound-source-ids-at
  [params : (& params ast.AstParamList)]
  [index : i64]
  [bound : TcNameIdList]) : TcNameIdList
  (if (>= index (ast.ast-param-list-len params))
    bound
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(ast.AstParam.Param name _ _ _)
        (tc-param-list-add-bound-source-ids-at
          params
          (+ index 1)
          (tc-name-id-list-add bound (tc-env-key-source-id-or-neg name)))])))

(define (tc-expr-uses-free-source-id?
  [expr-bases : i64]
  [expr : ast.AstExpr]
  [target-1 : i64]
  [target-2 : i64]
  [bound : TcNameIdList]) : bool
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-expr-uses-free-source-id? expr-bases inner target-1 target-2 bound))]
    [(ast.AstExpr.MacroExpansion inner-box _ _)
      (tc-expr-uses-free-source-id?
        expr-bases
        (ast.ast-expr-segment-bases-get expr-bases inner-box)
        target-1
        target-2
        bound)]
    [(ast.AstExpr.Literal _) false]
    [(ast.AstExpr.Var var-name)
      (let
        [sid : i64 (tc-env-key-source-id-or-neg var-name)]
        (if (or (= sid target-1) (= sid target-2))
          (not (tc-name-id-list-contains bound sid))
          false))]
    [(ast.AstExpr.Binary _ left-box right-box)
      (let
        [left : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases left-box)]
        [right : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases right-box)]
        (or
          (tc-expr-uses-free-source-id? expr-bases left target-1 target-2 bound)
          (tc-expr-uses-free-source-id?
            expr-bases
            right
            target-1
            target-2
            bound)))]
    [(ast.AstExpr.Unary _ inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases inner-box)]
        (tc-expr-uses-free-source-id? expr-bases inner target-1 target-2 bound))]
    [(ast.AstExpr.Call func-box args)
      (let
        [func : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases func-box)]
        (or
          (tc-expr-uses-free-source-id? expr-bases func target-1 target-2 bound)
          (tc-expr-list-uses-free-source-id?
            expr-bases
            args
            target-1
            target-2
            bound)))]
    [(ast.AstExpr.BracketClause items)
      (tc-expr-list-uses-free-source-id?
        expr-bases
        items
        target-1
        target-2
        bound)]
    [(ast.AstExpr.TypeLiteral _) false]
    [(ast.AstExpr.Init _) false]
    [(ast.AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases cond-box)]
        [then-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases then-branch-box)]
        [else-branch : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases else-branch-box)]
        (or
          (tc-expr-uses-free-source-id? expr-bases cond target-1 target-2 bound)
          (tc-expr-uses-free-source-id?
            expr-bases
            then-branch
            target-1
            target-2
            bound)
          (tc-expr-uses-free-source-id?
            expr-bases
            else-branch
            target-1
            target-2
            bound)))]
    [(ast.AstExpr.Let let-box)
      (match (__tl-box-place let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (or
              (tc-let-binding-list-uses-free-source-id?
                expr-bases
                bindings
                target-1
                target-2
                bound)
              (tc-expr-uses-free-source-id?
                expr-bases
                body
                target-1
                target-2
                (tc-let-binding-list-add-bound-source-ids bindings bound))))])]
    [(ast.AstExpr.Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(ast.AstLambda.Lambda params _ body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-expr-segment-bases-get expr-bases body-box)]
            (tc-expr-uses-free-source-id?
              expr-bases
              body
              target-1
              target-2
              (tc-param-list-add-bound-source-ids params bound)))])]
    [(ast.AstExpr.Tuple exprs)
      (tc-expr-list-uses-free-source-id?
        expr-bases
        exprs
        target-1
        target-2
        bound)]
    [(ast.AstExpr.TupleRef tuple-box _)
      (let
        [tuple : ast.AstExpr
          (ast.ast-expr-segment-bases-get expr-bases tuple-box)]
        (tc-expr-uses-free-source-id? expr-bases tuple target-1 target-2 bound))]
    [(ast.AstExpr.Array exprs)
      (tc-expr-list-uses-free-source-id?
        expr-bases
        exprs
        target-1
        target-2
        bound)]
    [(ast.AstExpr.DynArray exprs)
      (tc-expr-list-uses-free-source-id?
        expr-bases
        exprs
        target-1
