    (cbi.compiler-builtin-ctfe-slot "expr-clause-list-nth")
    (cbi.compiler-builtin-ctfe-slot "expr-clause-list-nth")
    (cbi.compiler-builtin-ctfe-slot "expr-clause-list->expr-list")
    (cbi.compiler-builtin-ctfe-slot "expr-clause-list->expr-list")
    (cbi.compiler-builtin-ctfe-slot "expr-binding-clause-name")
    (cbi.compiler-builtin-ctfe-slot "expr-binding-clause-name")
    (cbi.compiler-builtin-ctfe-slot "expr-binding-clause-has-type?")
    (cbi.compiler-builtin-ctfe-slot "expr-binding-clause-has-type?")
    (cbi.compiler-builtin-ctfe-slot "expr-binding-clause-type")
    (cbi.compiler-builtin-ctfe-slot "expr-binding-clause-type")
    (cbi.compiler-builtin-ctfe-slot "expr-binding-clause-init")
    (cbi.compiler-builtin-ctfe-slot "expr-binding-clause-init")
    (cbi.compiler-builtin-ctfe-slot "expr-binding-clause-list-length")
    (cbi.compiler-builtin-ctfe-slot "expr-binding-clause-list-length")
    (cbi.compiler-builtin-ctfe-slot "expr-binding-clause-list-nth")
    (cbi.compiler-builtin-ctfe-slot "expr-binding-clause-list-nth")
    (cbi.compiler-builtin-ctfe-slot "expr-binding-clause-list->expr-list")
    (cbi.compiler-builtin-ctfe-slot "expr-binding-clause-list->expr-list")))
(define tc-macro-helper-signatures : String
  "isss|asss|isss|asss|isi|isi|isic|isic|issb|issb|isi|asi|iis|ais|ibe|abe|iie|aie|ase|ise|ase|iese|aese|ieie|aeie|iesee|aesee|iee|aee|iexe|aexe|ieee|ieeee|ieeeee|ix|ax|iexx|aexx|ieeee|aeeee|ip|isp|isPp|iP|ipPP|isiP|ipem|iM|imMM|ieMe|iee|aee|iee|aee|aee|aet|ass|assb|isse|asse|assb|asse|asse|aeeb|aeee|iee|aee|asn|isn|ies|ies|ieb|ies|ies|ies|iei|ieis|ieie|iei|ieii|iei|ieis|ieii|ieiie|iee|iee|aee|iei|ieb|iei|ieie|iei|ieie|iee|ieb|aeb|ieb|aeb|ieb|aeb|iee|aee|iee|aee|iee|aee|ixi|axi|ixie|axie|iCe|aCe|iCe|aCe|iDi|aDi|iDiC|aDiC|iDx|aDx|iBs|aBs|iBb|aBb|iBe|aBe|iBe|aBe|iFi|aFi|iFiB|aFiB|iFx|aFx|")

;; e Expr, x ExprList, s String, i i64, b bool, c char, n Never, C clause,
;; D clause list, B binding clause, F binding clause list, p pattern,
;; P pattern list, m match arm, M match arm list, t TypeInfo.
(define tc-macro-helper-type-codes : String
  "exsibcnCDBFpPmMt")

(define (tc-macro-helper-code-type
  [types : (__tl_dyn-array ast.AstType)]
  [code : char]) : ast.AstType
  (let
    [index : i64 0]
    (while (!= (string.string-ref tc-macro-helper-type-codes index) code)
      (+= index 1))
    (tc-global-array-element-shared-view types index)))

;; The type at signature position `at`, or unit past the parameters ending
;; before `end`.
(define (tc-macro-helper-param-type
  [types : (__tl_dyn-array ast.AstType)]
  [at : i64]
  [end : i64]) : ast.AstType
  (if (< at end)
    (tc-macro-helper-code-type
      types
      (string.string-ref tc-macro-helper-signatures at))
    (Unit)))

(define (tc-macro-helper-env [env : TcTypeEnv]) : TcTypeEnv
  (let
    [types : (__tl_dyn-array ast.AstType) (__tl_make-array ast.AstType 16)]
    [out : TcTypeEnv env]
    [pos : i64 0]
    (set! (array-ref types 0) (ast.AstType.Expr))
    (set! (array-ref types 1) (ast.AstType.ExprList))
    (set! (array-ref types 2) (ast.AstType.String))
    (set! (array-ref types 3) (ast.AstType.I64))
    (set! (array-ref types 4) (ast.AstType.Bool))
    (set! (array-ref types 5) (ast.AstType.Char))
    (set! (array-ref types 6) (ast.AstType.Never))
    (set! (array-ref types 7) (tc-macro-expr-clause-type))
    (set! (array-ref types 8) (tc-macro-expr-clause-list-type))
    (set! (array-ref types 9) (tc-macro-expr-binding-clause-type))
    (set! (array-ref types 10) (tc-macro-expr-binding-clause-list-type))
    (set! (array-ref types 11) (tc-macro-pattern-type))
    (set! (array-ref types 12) (tc-macro-pattern-list-type))
    (set! (array-ref types 13) (tc-macro-match-arm-type))
    (set! (array-ref types 14) (tc-macro-match-arm-list-type))
    (set!
      (array-ref types 15)
      (ast.AstType.Var
        (tc-stdlib-comptime-type-key-id
          "TypeInfo"
          cbi.compiler-builtin-id-fix-TypeInfo)))
    (for [row (iterator.range 0 134)]
      (let
        [start : i64 (+ pos 1)]
        [end : i64 start]
        (while (!= (string.string-ref tc-macro-helper-signatures end) '|')
          (+= end 1))
        (let
          [arity : i64 (- (- end start) 1)]
          [ret : ast.AstType
            (tc-macro-helper-code-type
              (tc-global-shared-view types)
              (string.string-ref tc-macro-helper-signatures (- end 1)))]
          [a : ast.AstType
            (tc-macro-helper-param-type
              (tc-global-shared-view types)
              start
              (- end 1))]
          [b : ast.AstType
            (tc-macro-helper-param-type
              (tc-global-shared-view types)
              (+ start 1)
              (- end 1))]
          [c : ast.AstType
            (tc-macro-helper-param-type
              (tc-global-shared-view types)
              (+ start 2)
              (- end 1))]
          [d : ast.AstType
            (tc-macro-helper-param-type
              (tc-global-shared-view types)
              (+ start 3)
              (- end 1))]
          [ty : ast.AstType
            (cond
              [(= arity 0) (tc-fn0 ret)]
              [(= arity 1) (tc-fn1 a ret)]
              [(= arity 2) (tc-fn2 a b ret)]
              [(= arity 3) (tc-fn3 a b c ret)]
              [else (tc-fn4 a b c d ret)])]
          [id : i64
            (cbi.compiler-builtin-ctfe-ref
              (array-ref tc-macro-helper-slots row))]
          (set!
            out
            (if (= (string.string-ref tc-macro-helper-signatures pos) 'a')
              (tc-bind-comptime-helper-aliases out id ty)
              (tc-bind-id out id ty))))
        (set! pos (+ end 1))))
    out))

(defstruct TcMacroHelperStateData
  (ready bool)
  (value TcTypeEnv)
  (stdlib-surface-ready bool))

(define (tc-macro-helper-state-address-initialize [state : TcMacroState]) : i64
  (tc-macro-state-cell-initialize
    state
    TcMacroHelperStateData
    tc-macro-state-slot-helper
    (TcMacroHelperStateData false (tc-empty-env) false)))

(define (tc-macro-helper-state-address [state : TcMacroState]) : i64
  (tc-macro-state-address-fast state 1 tc-macro-helper-state-address-initialize))

(define (tc-macro-helper-state-ptr [state : TcMacroState]) : (MutPtr
    TcMacroHelperStateData)
  (tc-state-cell-ptr
    (tc-macro-helper-state-address state)
    TcMacroHelperStateData))

(define (tc-macro-helper-env-cache-reset! [state : TcMacroState]) : unit
  (let
    [cache : (MutPtr TcMacroHelperStateData) (tc-macro-helper-state-ptr state)]
    (unsafe
      (set! (deref cache).ready false)
      (set! (deref cache).value (tc-empty-env)))))

(define (tc-macro-helper-env-cached [state : TcMacroState] [env : TcTypeEnv]) : TcTypeEnv
  (let
    [cache : (MutPtr TcMacroHelperStateData) (tc-macro-helper-state-ptr state)]
    (unsafe
      (if (deref cache).ready
        (deref cache).value
        (let
          [helper-env : TcTypeEnv (tc-macro-helper-env env)]
          (set! (deref cache).value helper-env)
          (set! (deref cache).ready true)
          helper-env)))))

(define (tc-env-key-display
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : String
  (if (tc-env-key-has-name-id? name-id)
    (ci.intern-str name-id)
    (if (or
      (>= name-id (ci.intern-structural-key-base))
      (csym.compiler-composite-pair-key-id? name-id)
      (csym.compiler-composite-triple-key-id? name-id))
      (tc-hygiene-name-text-id-for-session session name-id)
      (str_cat.str-cat "<structural-id:" (string.int->string name-id) ">"))))

(define (tc-env-key-name-text-for-session
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : String
  (if (tc-env-key-has-name-id? name-id)
    (ci.intern-str name-id)
    (tc-env-key-display session name-id)))

;; Module, declaration, and registry keys are never hygienic macro identities.
;; Keep their pervasive display helper narrow; mixed AST/environment boundaries
;; use the explicit-session variant above.
(define (tc-env-key-name-text [name-id : i64]) : String
  (if (tc-env-key-has-name-id? name-id)
    (ci.intern-str name-id)
    (tc-hygiene-name-text-id name-id)))

(defmacro (tc-semantic-observe-persistent-reference! [env : Expr] [node : Expr]) : Expr
  `(when
    (> tc-semantic-observed-jobs 0)
    (tc-semantic-observe-persistent-reference-active! ,env ,node)))

(define (tc-semantic-observe-persistent-reference-active!
  [env : TcTypeEnv]
  [node : i64]) : unit
  (let
    [state : TcTypeEnvScopedState (tc-type-env-scoped-state env)]
    (unless
      (= state.address 0)
      (let
        [observer : TcSemanticObserver
          (tc-state-cell-read
            (+
              state.address
              (comptime
                (offset-of (type TcTypeEnvScopedStateData) semantic-observer)))
            TcSemanticObserver)]
        (when
          (and (!= observer.address 0) (>= node 0))
          (let
            [data : TcSemanticObserverData
              (tc-state-cell-read observer.address TcSemanticObserverData)]
            (data.callback
              data.context
              data.active-context
              env
              (PersistentReference env.store node))))))))

(define (tc-lookup-persistent-key-id
  [env : TcTypeEnv]
  [lookup-id : i64]
  [display-id : i64]) : ResultTcType
  (begin
    (cfg compile-profile (counters.bump! tc-profile-env-lookups))
    (let
      [store-handle : i64 env.store]
      [head : i64 env.head]
      [done : bool false]
      [found : bool false]
      [found-ty : ast.AstType (Unit)]
      (while (not done)
        (cond
          [(= head -1) (set! done true)]
          [(< head -1)
            (let
              [node-addr : i64 (tc-type-env-cache-index head)]
              (if (>= (tc-chain-node-depth node-addr) 0)
                ;; Indexed explicit top-env layer: one structural resolve
                ;; answers for this layer and everything below it.
                (let
                  [ref : i64
                    (tc-chain-resolve store-handle node-addr lookup-id)]
                  (if (>= ref 0)
                    (let
                      [cache : TcTypeEnvCache
                        (tc-chain-ref-cache store-handle ref)]
                      [slot : i64 (tc-chain-ref-slot ref)]
                      (set!
                        found-ty
                        (tc-global-array-element-shared-view cache.values slot))
                      (set! found true))
                    unit)
                  (set! done true))
                (let
                  [cache : TcTypeEnvCache
                    (tc-type-env-cache-at
                      (tc-type-env-cache-ptr store-handle node-addr))]
                  [ids : tc_i64_i64_map.Map cache.ids]
                  [index : i64
                    (tc_i64_i64_map.get-value-or (& ids) lookup-id -1)]
                  (if (>= index 0)
                    (begin
                      ;; AstType is multi-word; keep this checked value read.
                      (set!
                        found-ty
                        (tc-global-array-element-shared-view cache.values index))
                      (set! found true)
                      (set! done true))
                    (if cache.partial
                      (set! head cache.below)
                      (set! done true))))))]
          [else
            (let
              [binding-ptr : (Ptr TcTypeEnvBinding)
                (tc-type-env-binding-ptr store-handle head)]
              (if (= (tc-type-env-binding-name-at binding-ptr) lookup-id)
                (begin
                  (set! found-ty (tc-type-env-binding-type-at binding-ptr))
                  (set! found true)
                  (set! done true))
                (set! head (tc-type-env-binding-parent-at binding-ptr))))]))
      (if found
        (begin
          (tc-semantic-observe-persistent-reference! env head)
          (tc-poison-observation-note! (tc-global-shared-view found-ty))
          (Ok found-ty))
        (Err
          (str_cat.str-cat
            (cdiag.compiler-diagnostic-typecheck-tag (UnboundName))
            "typecheck: unbound name "
            (tc-env-key-display (tc-type-env-structural-session env) display-id)))))))

(define (tc-lookup-persistent-id [env : TcTypeEnv] [name-id : i64]) : ResultTcType
  (tc-lookup-persistent-key-id
    env
    (tc-env-name-key-id (tc-type-env-structural-session env) name-id)
    name-id))

(define (tc-lookup-selected-id
  [env : TcTypeEnv]
  [scoped-id : i64]
  [persistent-id : i64]
  [display-id : i64]) : ResultTcType
  (tc-binding-project
    (tc-lookup-binding-selected-id env scoped-id persistent-id display-id false)))

(define (tc-lookup-id [env : TcTypeEnv] [name-id : i64]) : ResultTcType
  (tc-lookup-selected-id
    env
    name-id
    (tc-env-name-key-id (tc-type-env-structural-session env) name-id)
    name-id))

(define (tc-name-bound-persistent-key-id? [env : TcTypeEnv] [lookup-id : i64]) : bool
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    [done : bool false]
    [found : bool false]
    (while (not done)
      (cond
        [(= head -1) (set! done true)]
        [(< head -1)
          (let
            [node-addr : i64 (tc-type-env-cache-index head)]
            (if (>= (tc-chain-node-depth node-addr) 0)
              (begin
                (if (>= (tc-chain-resolve store-handle node-addr lookup-id) 0)
                  (set! found true)
                  unit)
                (set! done true))
              (let
                [cache : TcTypeEnvCache
                  (tc-type-env-cache-at
                    (tc-type-env-cache-ptr store-handle node-addr))]
                [ids : tc_i64_i64_map.Map cache.ids]
                [index : i64 (tc_i64_i64_map.get-value-or (& ids) lookup-id -1)]
                (if (>= index 0)
                  (begin
                    (set! found true)
                    (set! done true))
                  (if cache.partial
                    (set! head cache.below)
                    (set! done true))))))]
        [else
          (let
            [binding-ptr : (Ptr TcTypeEnvBinding)
              (tc-type-env-binding-ptr store-handle head)]
            (if (= (tc-type-env-binding-name-at binding-ptr) lookup-id)
              (begin
                (set! found true)
                (set! done true))
              (set! head (tc-type-env-binding-parent-at binding-ptr))))]))
    found))

(define (tc-name-bound-selected-id?
  [env : TcTypeEnv]
  [scoped-id : i64]
  [persistent-id : i64]) : bool
  (if (tc-type-env-scoped-runtime-active? env)
    (let
      [carrier : TcTypeEnvScopedCarrier
        (tc-type-env-scoped-runtime-current env)]
      [scoped : bool
        (if (>= (tc-type-env-scoped-carrier-lookup-index carrier scoped-id) 0)
          true
          (begin
            (cfg
              compile-profile
              (counters.bump! tc-profile-env-scoped-tail-fallbacks))
            (tc-name-bound-persistent-key-id?
              (__tl-project-field
                (__tl-project-field carrier sidecar)
                persistent)
              persistent-id)))]
      scoped)
    (tc-name-bound-persistent-key-id? env persistent-id)))

(define (tc-name-bound-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (tc-name-bound-selected-id?
    env
    name-id
    (tc-env-name-key-id (tc-type-env-structural-session env) name-id)))

(define (tc-lookup-unsafe-persistent-key-id
  [env : TcTypeEnv]
  [lookup-id : i64]
  [display-id : i64]) : ResultTcTypeUnsafe
  (begin
    (cfg compile-profile (counters.bump! tc-profile-env-lookups))
    (let
      [store-handle : i64 env.store]
      [head : i64 env.head]
      [done : bool false]
      [found : bool false]
      [found-ty : ast.AstType (Unit)]
      [found-unsafe : bool false]
      (while (not done)
        (cond
          [(= head -1) (set! done true)]
          [(< head -1)
            (let
              [node-addr : i64 (tc-type-env-cache-index head)]
              (if (>= (tc-chain-node-depth node-addr) 0)
                (let
                  [ref : i64
                    (tc-chain-resolve store-handle node-addr lookup-id)]
                  (if (>= ref 0)
                    (let
                      [cache : TcTypeEnvCache
                        (tc-chain-ref-cache store-handle ref)]
                      [slot : i64 (tc-chain-ref-slot ref)]
                      (set!
                        found-ty
                        (tc-global-array-element-shared-view cache.values slot))
                      (set!
                        found-unsafe
                        (= (array-ref cache.unsafe-flags slot) 1))
                      (set! found true))
                    unit)
                  (set! done true))
                (let
                  [cache : TcTypeEnvCache
                    (tc-type-env-cache-at
                      (tc-type-env-cache-ptr store-handle node-addr))]
                  [ids : tc_i64_i64_map.Map cache.ids]
                  [index : i64
                    (tc_i64_i64_map.get-value-or (& ids) lookup-id -1)]
                  (if (>= index 0)
                    (begin
                      ;; AstType read stays checked; the flag is scalar i64.
                      (set!
                        found-ty
                        (tc-global-array-element-shared-view cache.values index))
                      (set!
                        found-unsafe
                        (=
                          (unsafe
                            (ptr-read
                              (ptr-offset
                                (ptr-cast
                                  (__tl_array-data cache.unsafe-flags)
                                  : (Ptr i64))
                                index)))
                          1))
                      (set! found true)
                      (set! done true))
                    (if cache.partial
                      (set! head cache.below)
                      (set! done true))))))]
          [else
            (let
              [binding-ptr : (Ptr TcTypeEnvBinding)
                (tc-type-env-binding-ptr store-handle head)]
              [rest : TcTypeEnv
                (TcTypeEnv
                  store-handle
                  (tc-type-env-binding-parent-at binding-ptr)
                  env.abi-pad)]
              (if (= (tc-type-env-binding-name-at binding-ptr) lookup-id)
                (begin
                  (set! found-ty (tc-type-env-binding-type-at binding-ptr))
                  (set!
                    found-unsafe
                    (tc-binding-unsafe-marker-head-id? rest lookup-id))
                  (set! found true)
                  (set! done true))
                (set! head rest.head)))]))
      (if found
        (begin
          (tc-semantic-observe-persistent-reference! env head)
          (tc-poison-observation-note! (tc-global-shared-view found-ty))
          (Ok found-ty found-unsafe))
        (Err
          (str_cat.str-cat
            (cdiag.compiler-diagnostic-typecheck-tag (UnboundName))
            "typecheck: unbound name "
            (tc-env-key-display (tc-type-env-structural-session env) display-id)))))))

(define (tc-lookup-unsafe-selected-id
  [env : TcTypeEnv]
  [scoped-id : i64]
  [persistent-id : i64]
  [display-id : i64]) : ResultTcTypeUnsafe
  (match (tc-lookup-binding-selected-id
    env
    scoped-id
    persistent-id
    display-id
    true)
    [(ResultTcBinding.Ok ty unsafe? _) (ResultTcTypeUnsafe.Ok ty unsafe?)]
    [(ResultTcBinding.Fault error)
      (ResultTcTypeUnsafe.Err (tc-selected-error error))]
    [(ResultTcBinding.Err message) (ResultTcTypeUnsafe.Err message)]))

(define (tc-lookup-binding-persistent-id
  [env : TcTypeEnv]
  [persistent-id : i64]
  [display-id : i64]
  [include-unsafe? : bool]) : ResultTcBinding
  ;; Preserve the canonical plain/unsafe persistent paths and their effects.
  ;; In particular a type-only lookup must not perform an extra marker scan.
  (if include-unsafe?
    (match (tc-lookup-unsafe-persistent-key-id env persistent-id display-id)
      [(ResultTcTypeUnsafe.Ok ty unsafe?)
        (ResultTcBinding.Ok ty unsafe? TcBindingOrigin.Unrepresented)]
      [(ResultTcTypeUnsafe.Err message) (ResultTcBinding.Err message)])
    (match (tc-lookup-persistent-key-id env persistent-id display-id)
      [(ResultTcType.Ok ty)
        (ResultTcBinding.Ok ty false TcBindingOrigin.Unrepresented)]
      [(ResultTcType.Err message) (ResultTcBinding.Err message)])))

(define (tc-lookup-binding-origin
  [env : TcTypeEnv]
  [carrier : (& carrier TcTypeEnvScopedCarrier)]
  [index : i64]
  [slot : (& slot TcTypeEnvScopedSlot)]) : TcBindingOrigin
  (cond
    [(or
        (not (= env.store carrier.env.store))
        (not (= env.store carrier.sidecar.persistent.store))
        (not (= env.abi-pad carrier.sidecar.stack.state-address))
        (< index carrier.sidecar.materialize-start)
        (tc-type-env-scoped-flag? slot.flags tc-type-env-scoped-flag-marker))
      TcBindingOrigin.Unrepresented]
    [(or
        (<= carrier.sidecar.stack.lookup-epoch 0)
        (< carrier.sidecar.stack.cache-generation 0)
        (< slot.generation 0))
      TcBindingOrigin.Exhausted]
    [else
      (TcBindingOrigin.Scoped
        (TcScopedBindingCoordinate
          env.store
          env.abi-pad
          carrier.sidecar.stack.lookup-epoch
          index
          slot.generation))]))

;; Both ordinary type lookup and unsafe-aware Var lookup project this one
;; winner. A selected caller retains this result through its canonical policy
;; checks; it must never recover provenance with a second name lookup.
(define (tc-lookup-binding-selected-id
  [env : TcTypeEnv]
  [scoped-id : i64]
  [persistent-id : i64]
  [display-id : i64]
  [include-unsafe? : bool]) : ResultTcBinding
  (if (tc-type-env-scoped-identity-exhausted? env)
    (ResultTcBinding.Fault typed.TypedError.Exhausted)
    (if (tc-type-env-scoped-runtime-active? env)
      (let
        [carrier : TcTypeEnvScopedCarrier
          (tc-type-env-scoped-runtime-current env)]
        [index : i64
          (tc-type-env-scoped-carrier-lookup-index carrier scoped-id)]
        [scoped : ResultTcBinding
          (if (>= index 0)
            (if (or
              (>= index carrier.sidecar.stack.slot-count)
              (>= index (array-length carrier.sidecar.stack.slots)))
              (ResultTcBinding.Fault typed.TypedError.Shape)
              (let
                [slot : TcTypeEnvScopedSlot
                  (tc-global-array-element-shared-view
                    (__tl-project-field
                      (__tl-project-field
                        (__tl-project-field carrier sidecar)
                        stack)
                      slots)
                    index)]
                [origin : TcBindingOrigin
                  (tc-lookup-binding-origin env (& carrier) index (& slot))]
                (begin
                  (cfg compile-profile (counters.bump! tc-profile-env-lookups))
                  (match origin
                    [(TcBindingOrigin.Exhausted)
                      (ResultTcBinding.Fault typed.TypedError.Exhausted)]
                    [_
                      (ResultTcBinding.Ok
                        slot.ty
                        (and
                          include-unsafe?
                          (tc-type-env-scoped-flag?
                            slot.flags
                            tc-type-env-scoped-flag-unsafe))
                        origin)]))))
            (begin
              (cfg
                compile-profile
                (counters.bump! tc-profile-env-scoped-tail-fallbacks))
              (tc-lookup-binding-persistent-id
                (__tl-project-field
                  (__tl-project-field carrier sidecar)
                  persistent)
                persistent-id
                display-id
                include-unsafe?)))]
        (match (tc-global-shared-view scoped)
          [(ResultTcBinding.Ok ty _ _) (tc-poison-observation-note! ty)]
          [(ResultTcBinding.Fault _) unit]
          [(ResultTcBinding.Err _) unit])
        scoped)
      (tc-lookup-binding-persistent-id
        env
        persistent-id
        display-id
        include-unsafe?))))

(define (tc-lookup-unsafe-id [env : TcTypeEnv] [name-id : i64]) : ResultTcTypeUnsafe
  (tc-lookup-unsafe-selected-id
    env
    name-id
    (tc-env-name-key-id (tc-type-env-structural-session env) name-id)
    name-id))

(define (tc-lookup-unsafe-key-id [env : TcTypeEnv] [lookup-id : i64]) : ResultTcTypeUnsafe
  (tc-lookup-unsafe-selected-id env lookup-id lookup-id lookup-id))

;; Alias shadowing asks one pure question about the persistent env chain: is
;; `name-id` bound anywhere in the span that starts at `env` and ends at the
;; hygiene global boundary, at the first non-scan-through cache, or at the root?
;; Module-local overlay construction asks it once per declaration against a
;; chain that grows one binding at a time, so the plain walk below is quadratic
;; in the number of declarations a module contributes, and nearly every query
;; answers "no".
;;
;; The span of a chain head is `delta ++ span(parent head)`, so a single-entry
;; index of the last queried head answers repeated queries without rewalking:
;; binding keys go into an open-addressed key set and cache nodes into a short
;; list that is probed as before. Only the bindings pushed since the previous
;; query are walked.
;;
;; Soundness. The chain below a head is immutable and binding/cache records are
;; append-only within a store, so a recorded key set stays exact for as long as
;; the recorded head denotes the same node. The recorded set is dropped whenever
;; the store handle differs or `tc-type-env-store-epoch` moved, i.e. whenever a
;; store cell or an env segment was allocated, which is the only way a node
;; address can be recycled. A rebuild always walks the full span, so the index
;; is exact after every miss. Answers are a disjunction over the same node set
;; the plain walk visits: the walk exits early on a hit, and the index covers a
;; superset of that prefix only when the answer is already "yes".
(define tc-name-bound-span-slot-capacity : i64
  2048)
(define tc-name-bound-span-cache-capacity : i64
  128)
(define tc-name-bound-span-keys : (__tl_dyn-array i64)
  (__tl_make-array i64 tc-name-bound-span-slot-capacity))
(define tc-name-bound-span-stamps : (__tl_dyn-array i64)
  (__tl_make-array i64 tc-name-bound-span-slot-capacity))
(define tc-name-bound-span-caches : (__tl_dyn-array i64)
  (__tl_make-array i64 tc-name-bound-span-cache-capacity))

;; Stamps start above the zero-filled array so the first generation is empty.
(define tc-name-bound-span-stamp : i64
  1)
(define tc-name-bound-span-count : i64
  0)
(define tc-name-bound-span-cache-count : i64
  0)
(define tc-name-bound-span-valid : bool
  false)
(define tc-name-bound-span-store : i64
  0)
(define tc-name-bound-span-head : i64
  -2)
(define tc-name-bound-span-epoch : i64
  -1)

(define (tc-name-bound-span-mask) : i64
  (- tc-name-bound-span-slot-capacity 1))

(define (tc-name-bound-span-slot [key : i64]) : i64
  (bit-and (bit-xor (* key 2654435761) (shr key 27)) (tc-name-bound-span-mask)))

(define (tc-name-bound-span-next-slot [slot : i64]) : i64
  (bit-and (+ slot 1) (tc-name-bound-span-mask)))

(define (tc-name-bound-span-contains-at? [key : i64] [slot : i64] [tries : i64]) : bool
  (if (>= tries tc-name-bound-span-slot-capacity)
    false
    (if (= (array-ref tc-name-bound-span-stamps slot) tc-name-bound-span-stamp)
      (if (= (array-ref tc-name-bound-span-keys slot) key)
        true
        (tc-name-bound-span-contains-at?
          key
          (tc-name-bound-span-next-slot slot)
          (+ tries 1)))
      false)))

(define (tc-name-bound-span-contains? [key : i64]) : bool
  (tc-name-bound-span-contains-at? key (tc-name-bound-span-slot key) 0))

(define (tc-name-bound-span-insert-at! [key : i64] [slot : i64] [tries : i64]) : bool
  (if (>= tries tc-name-bound-span-slot-capacity)
    false
    (if (= (array-ref tc-name-bound-span-stamps slot) tc-name-bound-span-stamp)
      (if (= (array-ref tc-name-bound-span-keys slot) key)
        true
        (tc-name-bound-span-insert-at!
          key
          (tc-name-bound-span-next-slot slot)
          (+ tries 1)))
      (begin
        (set!
          (array-ref tc-name-bound-span-stamps slot)
          tc-name-bound-span-stamp)
        (set! (array-ref tc-name-bound-span-keys slot) key)
        (set! tc-name-bound-span-count (+ tc-name-bound-span-count 1))
        true))))

;; Half load keeps probe runs short; a longer span gives up on the index and
;; falls back to the plain walk instead of degrading every later query.
(define (tc-name-bound-span-insert! [key : i64]) : bool
  (if (>= (* tc-name-bound-span-count 2) tc-name-bound-span-slot-capacity)
    false
    (tc-name-bound-span-insert-at! key (tc-name-bound-span-slot key) 0)))

(define (tc-name-bound-span-note-cache! [cache-address : i64]) : bool
  (if (>= tc-name-bound-span-cache-count tc-name-bound-span-cache-capacity)
    false
    (begin
      (set!
        (array-ref tc-name-bound-span-caches tc-name-bound-span-cache-count)
        cache-address)
      (+= tc-name-bound-span-cache-count 1)
      true)))

(define (tc-name-bound-span-clear!) : unit
  (+= tc-name-bound-span-stamp 1)
  (set! tc-name-bound-span-count 0)
  (set! tc-name-bound-span-cache-count 0))

;; Records the span of `env` up to (but excluding) `stop-head`. Returns 1 when
;; `stop-head` was reached, 2 when the span ended on its own, and 0 when the
;; index overflowed. Head 0 is not a reachable chain head (the root is -1,
;; bindings are record addresses and caches their negations), so it is the
;; "no stop" sentinel.
(define (tc-name-bound-span-fill! [env : TcTypeEnv] [stop-head : i64]) : i64
  (if (= env.head stop-head)
    1
    (match (tc-type-env-view env)
      [(Nil) 2]
      [(Cache _ scan-through _ rest _)
        (if (tc-name-bound-span-note-cache! (tc-type-env-cache-index env.head))
          (if scan-through
            (tc-name-bound-span-fill! rest stop-head)
            2)
          0)]
      [(Bind key _ rest)
        (if (= key (tc-hygiene-global-boundary-id))
          2
          (if (tc-name-bound-span-insert! key)
            (tc-name-bound-span-fill! rest stop-head)
            0))])))

(define (tc-name-bound-span-rebuild! [env : TcTypeEnv]) : bool
  (tc-name-bound-span-clear!)
  (if (= (tc-name-bound-span-fill! env 0) 0)
    (begin
      (set! tc-name-bound-span-valid false)
      false)
    (begin
      (set! tc-name-bound-span-valid true)
      (set! tc-name-bound-span-store env.store)
      (set! tc-name-bound-span-head env.head)
      (set! tc-name-bound-span-epoch tc-type-env-store-epoch)
      true)))

(define (tc-name-bound-span-prepare! [env : TcTypeEnv]) : bool
  (if (and
    tc-name-bound-span-valid
    (= env.store tc-name-bound-span-store)
    (= tc-type-env-store-epoch tc-name-bound-span-epoch))
    (if (= (tc-name-bound-span-fill! env tc-name-bound-span-head) 1)
      (begin
        (set! tc-name-bound-span-head env.head)
        true)
      ;; The chain is not an extension of the indexed head, so the partial
      ;; delta above has to be discarded together with the stale suffix.
      (tc-name-bound-span-rebuild! env))
    (tc-name-bound-span-rebuild! env)))

(define (tc-name-bound-span-cache-hit? [name-id : i64] [index : i64]) : bool
  (if (>= index tc-name-bound-span-cache-count)
    false
    (let
      [cache : TcTypeEnvCache
        (tc-type-env-cache-at
          (tc-type-env-cache-ptr
            tc-name-bound-span-store
            (array-ref tc-name-bound-span-caches index)))]
      [ids : tc_i64_i64_map.Map cache.ids]
      (match (tc_i64_i64_map.get (& ids) name-id)
        [(LookupFound _) true]
        [(LookupMissing) (tc-name-bound-span-cache-hit? name-id (+ index 1))]))))

(define (tc-name-bound-before-hygiene-global-boundary-scan-id?
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (match (tc-type-env-view env)
    [(Nil) false]
    [(Cache cache-ptr scan-through _ rest _)
      (let
        [ids : tc_i64_i64_map.Map
          (tc-type-env-cache-field-at cache-ptr 32 tc_i64_i64_map.Map)]
        ;; A module's explicit cache now contains only imported aliases. Those
        ;; aliases still shadow a declaration owned by the current module, even
        ;; though marker scans stop at this cache boundary.
        (match (tc_i64_i64_map.get (& ids) name-id)
          [(LookupFound _) true]
          [(LookupMissing)
            (if scan-through
              (tc-name-bound-before-hygiene-global-boundary-scan-id?
                rest
                name-id)
              false)]))]
    [(Bind key _ rest)
      (if (= key (tc-hygiene-global-boundary-id))
        false
        (if (= key name-id)
          true
          (tc-name-bound-before-hygiene-global-boundary-scan-id? rest name-id)))]))

(define (tc-name-bound-before-hygiene-global-boundary-id?
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (if (tc-name-bound-span-prepare! env)
    (if (tc-name-bound-span-contains? name-id)
      true
      (tc-name-bound-span-cache-hit? name-id 0))
    (tc-name-bound-before-hygiene-global-boundary-scan-id? env name-id)))

(define (tc-unqualified-import-ambiguity-message-for-key
  [_ctx : TcContext]
  [env : TcTypeEnv]
  [_module : String]
  [name : String]
  [name-id : i64]
  [key-id : i64]) : TcMaybeString
  (let
    [first-modules : sym_i64_env.SymI64Env
      tc-unqualified-import-ambiguous-first-modules]
    [first-module : i64
      (sym_i64_env.sym-i64-lookup-id-or
        first-modules
        key-id
        (csym.compiler-symbols-missing-handle))]
    (if (not (csym.compiler-symbols-handle-found? first-module))
      (No)
      (if (tc-name-bound-before-hygiene-global-boundary-id? env name-id)
        (No)
        (let
          [second-modules : sym_i64_env.SymI64Env
            tc-unqualified-import-ambiguous-second-modules]
          [second-module : i64
            (sym_i64_env.sym-i64-lookup-id-or
              second-modules
              key-id
              (csym.compiler-symbols-missing-handle))]
          (if (not (csym.compiler-symbols-handle-found? second-module))
            (No)
            (Some
              (str_cat.str-cat
                "typecheck: ambiguous unqualified import for value "
                name
                " between modules "
                (tc-env-key-name-text-for-session
                  (tc-type-env-structural-session env)
                  first-module)
                " and "
                (tc-env-key-name-text-for-session
                  (tc-type-env-structural-session env)
                  second-module)
                "; use an explicit alias or qualified access"))))))))

(define (tc-unqualified-import-ambiguity-message
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : TcMaybeString
  (if (and
    tc-unqualified-import-has-ambiguity
    (not
      (tc-structural-local-name-id?
        (tc-type-env-structural-session env)
        name-id)))
    (let
      [source-id : i64
        (macro-hygiene-global-source-name-id-or
          (tc-type-env-structural-session env)
          name-id
          name-id)]
      [name : String (ci.intern-str source-id)]
      [module-id : i64
        (if (macro-hygiene-global-id?
          (tc-type-env-structural-session env)
          name-id)
          (macro-hygiene-global-module-id
            (tc-type-env-structural-session env)
            name-id)
          (tc-context-module-id ctx))]
      (if (tc-name-qualified-id? (tc-context-structural-session ctx) source-id)
        (No)
        (let
          [module : String
            (if (csym.compiler-symbol-root-module-id? module-id)
              ""
              (tc-env-key-name-text-for-session
                (tc-type-env-structural-session env)
                module-id))]
          (tc-unqualified-import-ambiguity-message-for-key
            ctx
            env
            module
            name
            source-id
            (tc-unqualified-import-key-id module-id source-id)))))
    (No)))

(define (tc-lookup-visible-source-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [env-name-id : i64]) : ResultTcType
  (tc-binding-project
    (tc-lookup-visible-binding-source-id ctx env name-id env-name-id)))

;; Keep the winning lexical coordinate through the existing module-selection
;; policy. Persistent/module winners have no executable local binder identity;
;; exhausted identities cannot fall through to another lookup.
(define (tc-lookup-visible-binding-source-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [env-name-id : i64]) : ResultTcBinding
  (if (tc-type-env-scoped-identity-exhausted? env)
    (ResultTcBinding.Fault typed.TypedError.Exhausted)
    (let
      [module : String (tc-context-module ctx)]
      [module-id : i64 (tc-context-module-id ctx)]
      [current-module-lookup? : bool
        (and
          (> (string.string-length module) 0)
          (not
            (tc-name-qualified-id? (tc-context-structural-session ctx) name-id))
          ;; The symbol owner index avoids a doomed qualified lookup for
          ;; imports/globals while actual lexical bindings retain precedence.
          (tc-top-level-value-owned-by-module-id? ctx module-id name-id)
          (not
            (or
              (and
                (tc-type-env-scoped-runtime-active? env)
                (>= (tc-type-env-scoped-runtime-lookup-index env env-name-id) 0))
              (tc-name-bound-before-hygiene-global-boundary-id? env env-name-id))))]
      (if current-module-lookup?
        (tc-binding-unrepresented
          (match (tc-lookup-persistent-key-id
            env
            (tc-module-name-id-by-id module-id name-id)
            name-id)
            [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
            [(ResultTcType.Err _)
              (tc-lookup-persistent-key-id env env-name-id env-name-id)]))
        (match (tc-lookup-binding-selected-id
          env
          env-name-id
          env-name-id
          env-name-id
          false)
          [(ResultTcBinding.Ok ty unsafe? origin)
            (ResultTcBinding.Ok ty unsafe? origin)]
          [(ResultTcBinding.Fault error) (ResultTcBinding.Fault error)]
          [(ResultTcBinding.Err message)
            (if (and
              (> (string.string-length module) 0)
              (not
                (tc-name-qualified-id?
                  (tc-context-structural-session ctx)
                  name-id)))
              (tc-binding-unrepresented
                (match (tc-lookup-persistent-key-id
                  env
                  (tc-module-name-id-by-id module-id name-id)
                  name-id)
                  [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
                  [(ResultTcType.Err _) (ResultTcType.Err message)]))
              (ResultTcBinding.Err message))])))))

(define (tc-lookup-visible-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : ResultTcType
  (tc-binding-project (tc-lookup-visible-binding-id ctx env name-id)))

(define (tc-lookup-visible-binding-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : ResultTcBinding
  (if (tc-type-env-scoped-identity-exhausted? env)
    (ResultTcBinding.Fault typed.TypedError.Exhausted)
    (if (tc-env-key-has-name-id? name-id)
      (let
        [env-name-id : i64
          (tc-env-name-key-id (tc-type-env-structural-session env) name-id)]
        (match (tc-lookup-visible-binding-source-id ctx env name-id env-name-id)
          [(ResultTcBinding.Ok ty unsafe? origin)
            (match (tc-unqualified-import-ambiguity-message ctx env name-id)
              [(TcMaybeString.No) (ResultTcBinding.Ok ty unsafe? origin)]
              [(TcMaybeString.Some message) (ResultTcBinding.Err message)])]
          [(ResultTcBinding.Fault error) (ResultTcBinding.Fault error)]
          [(ResultTcBinding.Err message) (ResultTcBinding.Err message)]))
      (tc-lookup-binding-selected-id
        env
        name-id
        (tc-env-name-key-id (tc-type-env-structural-session env) name-id)
        name-id
        false))))

(define (tc-lookup-hygiene-global-key-scan
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [lookup-id : i64]
  [display-id : i64]) : ResultTcType
  (match (tc-type-env-spine-step env)
    [(Done) (tc-lookup-persistent-key-id root lookup-id display-id)]
    [(Cache rest-env)
      (tc-lookup-hygiene-global-key-scan root rest-env lookup-id display-id)]
    [(Bind key _ rest-env)
      (if (= key (tc-hygiene-global-boundary-id))
        (tc-lookup-persistent-key-id rest-env lookup-id display-id)
        (tc-lookup-hygiene-global-key-scan root rest-env lookup-id display-id))]))

(define (tc-lookup-hygiene-global-visible-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : ResultTcType
  (let
    [lookup-id : i64
      (tc-env-name-key-id (tc-type-env-structural-session env) name-id)]
    [ty (try (tc-lookup-hygiene-global-key-scan env env lookup-id lookup-id))]
    (tc-semantic-observe-reference! ctx env lookup-id true)
    (Ok ty)))

(define (tc-unsafe-callable-use
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [ty : ast.AstType]
  [direct-call-target : bool]) : ResultTcType
  (let
    [_ (try (tc-require-unsafe ctx env (tc-global-shared-view name)))]
    (if direct-call-target
      (Ok ty)
      (Err
        (str_cat.str-cat
          (cdiag.compiler-diagnostic-typecheck-tag (UnsafeCallableEffect))
          "typecheck: "
          name
          " is an unsafe callable and cannot be used as a plain function value; call it directly inside unsafe")))))

(define (tc-lookup-dotted-source-visible-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [name-id : i64]
  [direct-call-target : bool]) : ResultTcType
  (match (tc-source-name-lookup-key-with-field-check-lookup
    ctx
    env
    (tc-global-shared-view name)
    name-id
    false)
    [(Ok lookup-name lookup-id)
      (match (tc-lookup-unsafe-key-id
        env
        (tc-env-name-key-id (tc-type-env-structural-session env) lookup-id))
        [(Ok ty unsafe)
          (tc-semantic-observe-reference! ctx env lookup-id false)
          (if unsafe
            (tc-unsafe-callable-use
              ctx
              env
              (tc-source-lookup-display-name ctx name name-id lookup-name)
              ty
              direct-call-target)
            (Ok ty))]
        [(Err message)
          (match (tc-dotted-alias-variant-handle ctx name name-id)
            [(Some handle) (tc-variant-constructor-type-for-handle ctx handle)]
            [(None)
              (tc-variant-constructor-type-for-lookup-or-id
                ctx
                lookup-id
                (tc-source-unbound-display-message
                  ctx
                  (string.copy (& name))
                  name-id
                  lookup-name
                  message))])])]
    [(Err message) (Err message)]))

(define (tc-hygiene-definition-env-id-inner
  [ctx : TcContext]
  [module : String]
  [module-id : i64]) : ResultTcEnv
  (let
    [state : TcMacroState (tc-context-macro-state ctx)]
    [data : TcMacroModuleEnvStateData (tc-macro-module-env-state-data state)]
    (if data.hygiene-active-top-env-ready
      (if (or
        (csym.compiler-symbol-root-module-id? module-id)
        (= module-id cbi.compiler-builtin-id-fix-empty))
        (Ok data.hygiene-active-top-env)
        ;; Build cache entries in the dedicated persistent arena (see
        ;; tc-hygiene-module-env-cache-arena) so the chain stored in the global
        ;; survives the scratch arenas active during per-decl typechecking.
        (let
          [current : TcMacroModuleEnvStateData
            (tc-hygiene-module-env-cache-owned-data state)]
          (in-arena
            (unsafe
              (arena.Arena current.hygiene-cache-arena))
            (match (tc-module-local-env-cached-id
              ctx
              current.hygiene-active-top-env
              module
              module-id
              current.hygiene-module-env-cache)
              [(Ok def-env next-cache)
                (set! current.hygiene-module-env-cache next-cache)
                (tc-macro-module-env-state-data-set! state current)
                (Ok def-env)]
              [(Err message) (Err message)]))))
      (Err "typecheck: macro hygiene definition context unavailable"))))

(define (tc-hygiene-definition-env-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [module : String]
  [module-id : i64]) : ResultTcEnv
  (let
    [saved : TcTypeEnvScopedRuntimeSave
      (tc-type-env-scoped-runtime-suspend! env)]
    [result : ResultTcEnv
      (tc-hygiene-definition-env-id-inner ctx module module-id)]
    (tc-type-env-scoped-runtime-restore! saved)
    result))

(define (tc-lookup-hygiene-context-global-visible-id-inner-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [module : String]
  [module-id : i64]
  [name-id : i64]
  [direct-call-target : bool]) : ResultTcType
  (let
    [name : String (ci.intern-str name-id)]
    [def-ctx : TcContext
      (tc-context-with-module-id
        ctx
        module
        (if (csym.compiler-symbol-root-module-id? module-id)
          cbi.compiler-builtin-id-fix-empty
          module-id))]
    [def-env : TcTypeEnv
      (try (tc-hygiene-definition-env-id ctx env module module-id))]
    (if (>=
      (tc-name-first-dot-id (tc-context-structural-session ctx) name-id)
      0)
      (tc-lookup-dotted-source-visible-mode
        def-ctx
        def-env
        name
        name-id
        direct-call-target)
      (let
        [env-name-id : i64
          (tc-env-name-key-id (tc-type-env-structural-session env) name-id)]
        [selected-key : i64 env-name-id]
        [found : ResultTcTypeUnsafe
          (if (and
            (not (csym.compiler-symbol-root-module-id? module-id))
            (not
              (tc-name-qualified-id?
                (tc-context-structural-session ctx)
                name-id)))
            (let
              [module-name-id : i64 (tc-module-name-id-by-id module-id name-id)]
              (match (tc-lookup-unsafe-persistent-key-id
                def-env
                module-name-id
                module-name-id)
                [(Ok ty unsafe)
                  (set! selected-key module-name-id)
                  (Ok ty unsafe)]
                [(Err _)
                  (tc-lookup-unsafe-persistent-key-id
                    def-env
                    env-name-id
                    env-name-id)]))
            (tc-lookup-unsafe-persistent-key-id def-env env-name-id env-name-id))]
        (match found
          [(Ok ty unsafe)
            (tc-semantic-observe-reference! ctx env selected-key true)
            (if unsafe
              (tc-unsafe-callable-use ctx env name ty direct-call-target)
              (Ok ty))]
          [(Err message) (Err message)])))))

(define (tc-lookup-hygiene-context-global-visible-id-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [module : String]
  [module-id : i64]
  [name-id : i64]
  [direct-call-target : bool]) : ResultTcType
  (let
    [saved : TcTypeEnvScopedRuntimeSave
      (tc-type-env-scoped-runtime-suspend! env)]
    [result : ResultTcType
      (tc-lookup-hygiene-context-global-visible-id-inner-mode
        ctx
        env
        module
        module-id
        name-id
        direct-call-target)]
    (tc-type-env-scoped-runtime-restore! saved)
    result))

(define (tc-hygiene-global-binding-unsafe-scan
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (match (tc-type-env-spine-step env)
    [(Done) (tc-binding-unsafe-id? root name-id)]
    [(Cache rest-env)
      (tc-hygiene-global-binding-unsafe-scan root rest-env name-id)]
    [(Bind key _ rest-env)
      (if (= key (tc-hygiene-global-boundary-id))
        (tc-binding-unsafe-id? rest-env name-id)
        (tc-hygiene-global-binding-unsafe-scan root rest-env name-id))]))

(define (tc-hygiene-global-binding-unsafe-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (tc-hygiene-global-binding-unsafe-scan env env name-id))

(define (tc-active-region-scan [env : TcTypeEnv]) : TcMaybeNameId
  (match (tc-type-env-view env)
    [(Nil) (No)]
    [(Cache _ scan-through _ rest _)
      (if scan-through
        (tc-active-region-scan rest)
        (No))]
    [(Bind key ty rest)
      (if (= key (tc-region-marker-id))
        (match ty
          [(or (Var region) (Region region _)) (Some region)]
          [_ (tc-active-region-scan rest)])
        (tc-active-region-scan rest))]))

(define (tc-active-region [env : TcTypeEnv]) : TcMaybeNameId
  (if (tc-type-env-scoped-runtime-active? env)
    (tc-type-env-scoped-carrier-active-region
      (tc-type-env-scoped-runtime-current env))
    (begin
      (cfg compile-profile (counters.bump! tc-profile-env-marker-scans))
      (match (tc-env-marker-type env (tc-region-marker-id))
        [(or (Some (Var region)) (Some (Region region _))) (Some region)]
        [(Some _) (tc-active-region-scan env)]
        [(No) (No)]))))

(define (tc-push-region-id [env : TcTypeEnv] [region-id : i64]) : TcTypeEnv
  (tc-bind-runtime-marker-id env (tc-region-marker-id) (Var region-id) Region))

(define (tc-push-region [env : TcTypeEnv] [region : i64]) : TcTypeEnv
  (tc-push-region-id env region))

(define (tc-string-list-store-read [address : i64]) : TcStringListStoreData
  (unsafe
    (ptr-read (int->ptr (cast address : u64) : (Ptr TcStringListStoreData)))))

(define (tc-string-list-store-write!
  [address : i64]
  [data : TcStringListStoreData]) : unit
  (unsafe
    (ptr-write!
      (int->ptr (cast address : u64) : (MutPtr TcStringListStoreData))
      data)))

(define (tc-string-list-store-new [first : String]) : i64
  (let
    [cell : (__tl_dyn-array TcStringListStoreData)
      (__tl_make-array TcStringListStoreData 1)]
    [nodes : (__tl_dyn-array TcStringListNode)
      (__tl_make-array TcStringListNode 4)]
    [owner : i64 (arena.tl_arena_current)]
    (set! (array-ref nodes 0) (TcStringListNode first -1))
    (set! (array-ref cell 0) (TcStringListStoreData nodes 1 owner))
    (unsafe
      (cast
        (ptr->int
          (ptr-cast (__tl_array-data cell) : (Ptr TcStringListStoreData)))
        : i64))))

(define (tc-string-list-store-grow!
  [data : (&mut data TcStringListStoreData)]
  [required : i64]) : unit
  (let
    [old : (__tl_dyn-array TcStringListNode) data.nodes]
    [old-capacity : i64 (array-length old)]
    [next-capacity : i64 old-capacity]
    (unless
      (<= required old-capacity)
      (while (< next-capacity required)
        (set! next-capacity (* next-capacity 2)))
      (let
        [owner : arena.Arena
          (unsafe
            (arena.Arena data.owner-arena))]
        [next : (__tl_dyn-array TcStringListNode)
          (in-arena owner (__tl_make-array TcStringListNode next-capacity))]
        [index : i64 0]
        (while (< index data.len)
          (let
            [node : TcStringListNode
              (tc-global-array-element-shared-view old index)]
            [owned : String (in-arena owner (string.copy (& node.value)))]
            (set! (array-ref next index) (TcStringListNode owned node.parent))
            (set! index (+ index 1))))
        (set! data.nodes next)))))

(define (tc-string-list-store-push!
  [address : i64]
  [parent : i64]
  [value : String]) : i64
  (let
    [data : TcStringListStoreData (tc-string-list-store-read address)]
    [index : i64 data.len]
    (tc-string-list-store-grow! (&mut data) (+ index 1))
    ;; Sibling snapshots can append from short-lived scratch arenas. Own each
    ;; string in the stable store arena so a later sibling never retains a
    ;; stale source pointer.
    (let
      [owner : arena.Arena
        (unsafe
          (arena.Arena data.owner-arena))]
      [owned : String (in-arena owner (string.copy (& value)))]
      (set! (array-ref data.nodes index) (TcStringListNode owned parent)))
    (set! data.len (+ index 1))
    (tc-string-list-store-write! address data)
    index))

(define (tc-string-list-store-node [address : i64] [index : i64]) : TcStringListNode
  (let
    [data : TcStringListStoreData (tc-string-list-store-read address)]
    [nodes : (__tl_dyn-array TcStringListNode) data.nodes]
    (TcStringListNode
      (string.copy (& (__tl-project-field (array-ref nodes index) value)))
      (__tl-project-field (array-ref nodes index) parent))))

(define (tc-string-list-empty? [items : (& items TcStringList)]) : bool
  (match items
    [(Nil) true]
    [_ false]))

(define (tc-string-list-head [items : TcStringList]) : String
  (match items
    [(Nil) ""]
    [(One value) value]
    [(Dense address tail _)
      (__tl-project-field (tc-string-list-store-node address tail) value)]))

(define (tc-string-list-rest [items : TcStringList]) : TcStringList
  (match items
    [(or (Nil) (One _)) Nil]
    [(Dense address tail len)
      (let
        [tail-node : TcStringListNode (tc-string-list-store-node address tail)]
        [parent : i64 tail-node.parent]
        (if (= len 2)
          (let
            [parent-node : TcStringListNode
              (tc-string-list-store-node address parent)]
            (One parent-node.value))
          (Dense address parent (- len 1))))]))

(define (tc-string-list-cons [items : TcStringList] [name : String]) : TcStringList
  (match items
    [(Nil) (One name)]
    [(One previous)
      (let
        [address : i64 (tc-string-list-store-new previous)]
        [tail : i64 (tc-string-list-store-push! address 0 name)]
        (Dense address tail 2))]
    [(Dense address tail len)
      (Dense address (tc-string-list-store-push! address tail name) (+ len 1))]))

(define (tc-string-list-contains [items : TcStringList] [name : String]) : bool
  (match items
    [(Nil) false]
    [(One item) (string.eq item name)]
    [(Dense address tail len)
      (let
        [data : TcStringListStoreData (tc-string-list-store-read address)]
        [nodes : (__tl_dyn-array TcStringListNode) data.nodes]
        [index : i64 tail]
        [remaining : i64 len]
        [found : bool false]
        ;; Read the shared store once: this membership path is substantially
        ;; hotter than materializing `rest` snapshots one node at a time.
        [name-len : i64 (string.string-length name)]
        ;; Most entries differ in length; compare those without a call.
        (while (and (not found) (> remaining 0))
          (if (and
            (=
              (string.string-length
                (& (__tl-project-field (array-ref nodes index) value)))
              name-len)
            (string.eq
              (& (__tl-project-field (array-ref nodes index) value))
              name))
            (set! found true)
            unit)
          (set! index (__tl-project-field (array-ref nodes index) parent))
          (-= remaining 1))
        found)]))

(define (tc-string-list-add [items : TcStringList] [name : String]) : TcStringList
  (if (tc-string-list-contains
    (tc-global-shared-view items)
    (string.copy (& name)))
    items
    (tc-string-list-cons items name)))

(define (tc-name-id-list-store-read [address : i64]) : TcNameIdListStoreData
  (unsafe
    (ptr-read (int->ptr (cast address : u64) : (Ptr TcNameIdListStoreData)))))

(define (tc-name-id-list-store-write!
  [address : i64]
  [data : TcNameIdListStoreData]) : unit
  (unsafe
    (ptr-write!
      (int->ptr (cast address : u64) : (MutPtr TcNameIdListStoreData))
      data)))

(define (tc-name-id-list-store-new [first : i64]) : i64
  (let
    [cell : (__tl_dyn-array TcNameIdListStoreData)
      (__tl_make-array TcNameIdListStoreData 1)]
    [nodes : (__tl_dyn-array TcNameIdListNode)
      (__tl_make-array TcNameIdListNode 4)]
    [owner : i64 (arena.tl_arena_current)]
    (set! (array-ref nodes 0) (TcNameIdListNode first -1))
    (set! (array-ref cell 0) (TcNameIdListStoreData nodes 1 owner))
    (unsafe
      (cast
        (ptr->int
          (ptr-cast (__tl_array-data cell) : (Ptr TcNameIdListStoreData)))
        : i64))))

(define (tc-name-id-list-store-grow!
  [data : (&mut data TcNameIdListStoreData)]
  [required : i64]) : unit
  (let
    [old : (__tl_dyn-array TcNameIdListNode) data.nodes]
    [old-capacity : i64 (array-length old)]
    [next-capacity : i64 old-capacity]
    (unless
      (<= required old-capacity)
      (while (< next-capacity required)
        (set! next-capacity (* next-capacity 2)))
      (in-arena
        (unsafe
          (arena.Arena data.owner-arena))
        (let
          [next : (__tl_dyn-array TcNameIdListNode)
            (__tl_make-array TcNameIdListNode next-capacity)]
          [index : i64 0]
          (while (< index data.len)
            (let
              [node : TcNameIdListNode (array-ref old index)]
              (set!
                (array-ref next index)
                (TcNameIdListNode node.value node.parent))
              (set! index (+ index 1))))
          (set! data.nodes next))))))

(define (tc-name-id-list-store-push!
  [address : i64]
  [parent : i64]
  [value : i64]) : i64
  (let
    [data : TcNameIdListStoreData (tc-name-id-list-store-read address)]
    [index : i64 data.len]
    (tc-name-id-list-store-grow! (&mut data) (+ index 1))
    (set! (array-ref data.nodes index) (TcNameIdListNode value parent))
    (set! data.len (+ index 1))
    (tc-name-id-list-store-write! address data)
    index))

(define (tc-name-id-list-store-node [address : i64] [index : i64]) : TcNameIdListNode
  (let
    [data : TcNameIdListStoreData (tc-name-id-list-store-read address)]
    [nodes : (__tl_dyn-array TcNameIdListNode) data.nodes]
    (TcNameIdListNode
      (__tl-project-field (array-ref nodes index) value)
      (__tl-project-field (array-ref nodes index) parent))))

(define (tc-name-id-list-empty? [items : TcNameIdList]) : bool
  (match items
    [(Nil) true]
    [_ false]))

(define (tc-name-id-list-len [items : TcNameIdList]) : i64
  (match items
    [(Nil) 0]
    [(One _) 1]
    [(Dense _ _ len) len]))

(define (tc-name-id-list-head [items : TcNameIdList]) : i64
  (match items
    [(Nil) -1]
    [(One value) value]
    [(Dense address tail _)
      (__tl-project-field (tc-name-id-list-store-node address tail) value)]))

(define (tc-name-id-list-rest [items : TcNameIdList]) : TcNameIdList
  (match items
    [(or (Nil) (One _)) Nil]
    [(Dense address tail len)
      (let
        [parent : i64
          (__tl-project-field (tc-name-id-list-store-node address tail) parent)]
        (if (= len 2)
          (One
            (__tl-project-field
              (tc-name-id-list-store-node address parent)
              value))
          (Dense address parent (- len 1))))]))

(define (tc-name-id-list-cons [items : TcNameIdList] [name : i64]) : TcNameIdList
  (match items
    [(Nil) (One name)]
    [(One previous)
      (let
        [address : i64 (tc-name-id-list-store-new previous)]
        [tail : i64 (tc-name-id-list-store-push! address 0 name)]
        (Dense address tail 2))]
    [(Dense address tail len)
      (Dense address (tc-name-id-list-store-push! address tail name) (+ len 1))]))

(define (tc-name-id-list-contains [items : TcNameIdList] [name : i64]) : bool
  (match items
    [(Nil) false]
    [(One item) (= item name)]
    [(Dense address tail len)
      (let
        [data : TcNameIdListStoreData (tc-name-id-list-store-read address)]
        [nodes : (__tl_dyn-array TcNameIdListNode) data.nodes]
        [index : i64 tail]
        [remaining : i64 len]
        [found : bool false]
        (while (and (not found) (> remaining 0))
          (if (= (__tl-project-field (array-ref nodes index) value) name)
            (set! found true)
            unit)
          (set! index (__tl-project-field (array-ref nodes index) parent))
          (-= remaining 1))
        found)]))

(define (tc-name-id-list-add [items : TcNameIdList] [name : i64]) : TcNameIdList
  (if (tc-name-id-list-contains items name)
    items
    (tc-name-id-list-cons items name)))

(define (tc-name-id-list-add-all [items : TcNameIdList] [names : TcNameIdList]) : TcNameIdList
  (let
    [out : TcNameIdList items]
    [cursor : TcNameIdList names]
    (while (not (tc-name-id-list-empty? cursor))
      (set! out (tc-name-id-list-add out (tc-name-id-list-head cursor)))
      (set! cursor (tc-name-id-list-rest cursor)))
    out))

(define (tc-name-id-list-overlaps? [a : TcNameIdList] [b : TcNameIdList]) : bool
  (let
    [cursor : TcNameIdList a]
    [found : bool false]
    (while (and (not found) (not (tc-name-id-list-empty? cursor)))
      (if (tc-name-id-list-contains b (tc-name-id-list-head cursor))
        (set! found true)
        unit)
      (set! cursor (tc-name-id-list-rest cursor)))
    found))

;; Names of `a` that `b` also contains, in `a`'s order.
(define (tc-name-id-list-intersection [a : TcNameIdList] [b : TcNameIdList]) : TcNameIdList
  (tc-name-id-list-filter-membership a b true))

;; Names of `a` that `b` does not contain, in `a`'s order.
(define (tc-name-id-list-difference [a : TcNameIdList] [b : TcNameIdList]) : TcNameIdList
  (tc-name-id-list-filter-membership a b false))

(define (tc-name-id-list-filter-membership
  [a : TcNameIdList]
  [b : TcNameIdList]
  [keep-members : bool]) : TcNameIdList
  (let
    [out : TcNameIdList Nil]
    [rest : TcNameIdList a]
    (while (not (tc-name-id-list-empty? rest))
      (let
        [name : i64 (tc-name-id-list-head rest)]
        (if (= (tc-name-id-list-contains b name) keep-members)
          (set! out (tc-name-id-list-add out name))
          unit)
        (set! rest (tc-name-id-list-rest rest))))
    out))

(define (tc-name-id-list-eq [a : TcNameIdList] [b : TcNameIdList]) : bool
  ;; Preserve the former predicate exactly: an empty left side only matches an
  ;; empty right side, while a non-empty left side tests membership in `b`.
  (if (tc-name-id-list-empty? a)
    (tc-name-id-list-empty? b)
    (tc-name-id-list-all-in? a b)))

(define (tc-name-id-list-all-in?
  [items : TcNameIdList]
  [allowed : TcNameIdList]) : bool
  (let
    [cursor : TcNameIdList items]
    [ok : bool true]
    (while (and ok (not (tc-name-id-list-empty? cursor)))
      (if (tc-name-id-list-contains allowed (tc-name-id-list-head cursor))
        unit
        (set! ok false))
      (set! cursor (tc-name-id-list-rest cursor)))
    ok))

(define (tc-bind-ordinary-arena-owner [env : TcTypeEnv] [name-id : i64]) : TcTypeEnv
  (tc-bind-runtime-marker-id
    env
    (tc-ordinary-arena-owner-marker-id)
    (Var name-id)
    OrdinaryArenaOwner))

(define (tc-bind-atomic-arena-owner [env : TcTypeEnv] [name-id : i64]) : TcTypeEnv
  (tc-bind-runtime-marker-id
    env
    (tc-atomic-arena-owner-marker-id)
    (Var name-id)
    AtomicArenaOwner))

(define (tc-arena-phase-record-id
  [session : cis.InternStructuralSessionHandle]
  [record : cis.InternArenaPhaseRecord]) : i64
  (cis.intern-arena-phase-identity-raw
    (cis.intern-structural-session-arena-phase-identity session record)))

(define (tc-arena-phase-region-id
  [env : TcTypeEnv]
  [owner-id : i64]
  [token-id : i64]) : i64
  (tc-arena-phase-record-id
    (tc-type-env-structural-session env)
    (Region owner-id token-id)))

(define (tc-arena-phase-current-region-marker-id
  [env : TcTypeEnv]
  [owner-id : i64]) : i64
  (tc-arena-phase-record-id
    (tc-type-env-structural-session env)
    (CurrentRegionMarker owner-id)))

(define (tc-arena-phase-token-owner-marker-id
  [env : TcTypeEnv]
  [token-id : i64]) : i64
  (tc-arena-phase-record-id
    (tc-type-env-structural-session env)
    (TokenOwnerMarker token-id)))

(define (tc-arena-phase-token-region-marker-id
  [env : TcTypeEnv]
  [token-id : i64]) : i64
  (tc-arena-phase-record-id
    (tc-type-env-structural-session env)
    (TokenRegionMarker token-id)))

(define (tc-qualified-name-key-id [module-id : i64] [base-id : i64]) : i64
  (csym.compiler-symbol-module-key-id-by-id module-id base-id))

(define (tc-generated-module-name-id [name : String]) : i64
  (ci.intern-generated-canonical-name name))

(define (tc-generated-name-id [name : String]) : i64
  (tc-generated-module-name-id name))

(define (tc-arena-region-owned-by-id-for-session?
  [session : cis.InternStructuralSessionHandle]
  [owner-id : i64]
  [region-id : i64]) : bool
  (if (or (< owner-id 0) (< region-id 0))
    false
    (or
      (= owner-id region-id)
      (match (cis.intern-structural-session-arena-phase-record-for-raw
        session
        region-id)
        [(Some (Region record-owner-id _)) (= record-owner-id owner-id)]
        [_ false]))))

(define (tc-arena-region-owned-by-id?
  [env : TcTypeEnv]
  [owner-id : i64]
  [region-id : i64]) : bool
  (tc-arena-region-owned-by-id-for-session?
    (tc-type-env-structural-session env)
    owner-id
    region-id))

(define (tc-bind-arena-phase-token
  [env : TcTypeEnv]
  [token-id : i64]
  [owner-id : i64]) : TcTypeEnv
  (let
    [region-id : i64 (tc-arena-phase-region-id env owner-id token-id)]
    ;; Later stores of the owner's values may carry the phase's allocations.
    [_mark : unit (tc-admitted-phase-mark! env region-id)]
    (tc-bind-id
      (tc-bind-id
        (tc-bind-id
          env
          (tc-arena-phase-current-region-marker-id env owner-id)
          (Var region-id))
        (tc-arena-phase-token-owner-marker-id env token-id)
        (Var owner-id))
      (tc-arena-phase-token-region-marker-id env token-id)
      (Var region-id))))

;; Threshold compaction (`tc-env-compact-local-if-threshold`) can put a
;; transparent cache layer between a token's own binding and its markers. Such
;; a layer only accelerates lookup over the same spine, so the direct-token
;; checks step through it as marker scans do; an explicit cache still ends
;; them.
(define (tc-arena-phase-token-region-head
  [env : TcTypeEnv]
  [region-marker-id : i64]) : TcMaybeNameId
  (match (tc-type-env-view env)
    [(Bind key ty _)
      (if (= key region-marker-id)
        (match ty
          [(Var region) (Some region)]
          [_ (No)])
        (No))]
    [(Cache _ scan-through _ rest _)
      (if scan-through
        (tc-arena-phase-token-region-head rest region-marker-id)
        (No))]
    [_ (No)]))

(define (tc-arena-phase-token-owner-head
  [env : TcTypeEnv]
  [owner-marker-id : i64]
  [region-marker-id : i64]) : TcMaybeNameId
  (match (tc-type-env-view env)
    [(Bind key ty rest)
      (if (= key owner-marker-id)
        (match ty
          [(Var owner) (Some owner)]
          [_ (No)])
        (if (= key region-marker-id)
          (tc-arena-phase-token-owner-head
            rest
            owner-marker-id
            region-marker-id)
          (No)))]
    [(Cache _ scan-through _ rest _)
      (if scan-through
        (tc-arena-phase-token-owner-head rest owner-marker-id region-marker-id)
        (No))]
    [_ (No)]))

(define (tc-arena-phase-token-region-active-scan
  [env : TcTypeEnv]
  [token-id : i64]
  [region-marker-id : i64]) : TcMaybeNameId
  (match (tc-type-env-view env)
    [(Nil) (No)]
    [(Cache _ scan-through _ rest _)
      (if scan-through
        (tc-arena-phase-token-region-active-scan rest token-id region-marker-id)
        (No))]
    [(Bind key _ rest)
      (if (= key token-id)
        (tc-arena-phase-token-region-head rest region-marker-id)
        (tc-arena-phase-token-region-active-scan rest token-id region-marker-id))]))

(define (tc-arena-phase-token-region-active [env : TcTypeEnv] [token-id : i64]) : TcMaybeNameId
  (begin
    (cfg compile-profile (counters.bump! tc-profile-env-marker-scans))
    (let
      [region-marker-id : i64
        (tc-arena-phase-token-region-marker-id env token-id)]
      (match (tc-type-env-view env)
        [(Cache _ _ _ rest _)
          (tc-arena-phase-token-region-active-scan
            rest
            token-id
            region-marker-id)]
        [_
          (tc-arena-phase-token-region-active-scan
            env
            token-id
            region-marker-id)]))))

(define (tc-arena-phase-token-owner-active-scan
  [env : TcTypeEnv]
  [token-id : i64]
  [owner-marker-id : i64]
  [region-marker-id : i64]) : TcMaybeNameId
  (match (tc-type-env-view env)
    [(Nil) (No)]
    [(Cache _ scan-through _ rest _)
      (if scan-through
        (tc-arena-phase-token-owner-active-scan
          rest
          token-id
          owner-marker-id
          region-marker-id)
        (No))]
    [(Bind key _ rest)
      (if (= key token-id)
        (tc-arena-phase-token-owner-head rest owner-marker-id region-marker-id)
        (tc-arena-phase-token-owner-active-scan
          rest
          token-id
          owner-marker-id
          region-marker-id))]))

(define (tc-arena-phase-token-owner-active [env : TcTypeEnv] [token-id : i64]) : TcMaybeNameId
  (begin
    (cfg compile-profile (counters.bump! tc-profile-env-marker-scans))
    (let
      [owner-marker-id : i64
        (tc-arena-phase-token-owner-marker-id env token-id)]
      [region-marker-id : i64
        (tc-arena-phase-token-region-marker-id env token-id)]
      (match (tc-type-env-view env)
        [(Cache _ _ _ rest _)
          (tc-arena-phase-token-owner-active-scan
            rest
            token-id
            owner-marker-id
            region-marker-id)]
        [_
          (tc-arena-phase-token-owner-active-scan
            env
            token-id
            owner-marker-id
            region-marker-id)]))))

(define (tc-current-arena-owner-region [env : TcTypeEnv] [owner : i64]) : i64
  (begin
    (cfg compile-profile (counters.bump! tc-profile-env-marker-scans))
    (match (tc-env-marker-type
      env
      (tc-arena-phase-current-region-marker-id env owner))
      [(Some (Var region)) region]
      [_ owner])))

(define (tc-active-region-owned-by-arena-id? [env : TcTypeEnv] [owner : i64]) : bool
  (match (tc-active-region env)
    [(Some region) (tc-arena-region-owned-by-id? env owner region)]
    [(No) false]))

(define (tc-cleanup-owner-marker-for?
  [key : i64]
  [ty : (& ast.AstType)]
  [name-id : i64]) : bool
  (if (= key (tc-cleanup-owner-marker-id))
    (match ty
      [(Var owner) (= owner name-id)]
      [_ false])
    false))

(define (tc-arena-owner-marker-for?
  [marker-id : i64]
  [key : i64]
  [ty : ast.AstType]
  [name-id : i64]) : bool
  (if (= key marker-id)
    (match ty
      [(Var owner) (= owner name-id)]
      [_ false])
    false))

(define (tc-cleanup-owner-marker-entry? [key : i64] [ty : (& ty ast.AstType)]) : bool
  (if (= key (tc-cleanup-owner-marker-id))
    (match ty
      [(Var _) true]
      [_ false])
    false))

(define (tc-arena-owner-marker-entry?
  [marker-id : i64]
  [key : i64]
  [ty : ast.AstType]) : bool
  (if (= key marker-id)
    (match ty
      [(Var _) true]
      [_ false])
    false))

(define (tc-ordinary-arena-owner-marker-entry? [key : i64] [ty : ast.AstType]) : bool
  (tc-arena-owner-marker-entry? (tc-ordinary-arena-owner-marker-id) key ty))

(define (tc-atomic-arena-owner-marker-entry? [key : i64] [ty : ast.AstType]) : bool
  (tc-arena-owner-marker-entry? (tc-atomic-arena-owner-marker-id) key ty))

(define (tc-owner-active-indexed-id?
  [env : TcTypeEnv]
  [name-id : i64]
  [marker-id : i64]
  [sidecar-flag : i64]) : bool
  (match (tc-type-env-view env)
    [(Nil) false]
    [(Cache cache-ptr _ partial _ below)
      (let
        [ids : tc_i64_i64_map.Map
          (tc-type-env-cache-field-at cache-ptr 32 tc_i64_i64_map.Map)]
        [sidecar-flags : (__tl_dyn-array i64)
          (tc-type-env-cache-field-at cache-ptr 72 (__tl_dyn-array i64))]
        (match (tc_i64_i64_map.get (& ids) name-id)
          [(LookupFound index)
            (not (= (bit-and (array-ref sidecar-flags index) sidecar-flag) 0))]
          [(LookupMissing)
            (if partial
              (tc-owner-active-indexed-id? below name-id marker-id sidecar-flag)
              false)]))]
    [(Bind key _ rest)
      (if (= key name-id)
        (tc-env-cache-owner-marker-head-id? rest name-id marker-id)
        (tc-owner-active-indexed-id? rest name-id marker-id sidecar-flag))]))

(define (tc-cleanup-owner-active-persistent-id?
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (tc-owner-active-indexed-id?
    env
    name-id
    (tc-cleanup-owner-marker-id)
    tc-env-cache-flag-cleanup-owner))

(define (tc-cleanup-owner-active-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (if (tc-type-env-scoped-runtime-active? env)
    (tc-type-env-scoped-carrier-cleanup-owner-active?
      (tc-type-env-scoped-runtime-current env)
      name-id)
    (begin
      (cfg compile-profile (counters.bump! tc-profile-env-marker-scans))
      (tc-cleanup-owner-active-persistent-id? env name-id))))

(define (tc-arena-owner-active-persistent-id?
  [env : TcTypeEnv]
  [name-id : i64]
  [marker-id : i64]) : bool
  (tc-owner-active-indexed-id?
    env
    name-id
    marker-id
    (if (= marker-id (tc-ordinary-arena-owner-marker-id))
      tc-env-cache-flag-ordinary-arena-owner
      tc-env-cache-flag-atomic-arena-owner)))

(define (tc-arena-owner-active-id?
  [env : TcTypeEnv]
  [name-id : i64]
  [marker-id : i64]) : bool
  (if (tc-type-env-scoped-runtime-active? env)
    (tc-type-env-scoped-carrier-arena-owner-active?
      (tc-type-env-scoped-runtime-current env)
      name-id
      marker-id)
    (begin
      (cfg compile-profile (counters.bump! tc-profile-env-marker-scans))
      (tc-arena-owner-active-persistent-id? env name-id marker-id))))

(define (tc-ordinary-arena-owner-active-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (or
    (tc-generated-ordinary-arena-brand-id? name-id)
    (tc-arena-owner-active-id? env name-id (tc-ordinary-arena-owner-marker-id))))

(define (tc-atomic-arena-owner-active-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (or
    (tc-generated-atomic-arena-brand-id? name-id)
    (tc-arena-owner-active-id? env name-id (tc-atomic-arena-owner-marker-id))))

(define (tc-active-cleanup-owners-scan [root : TcTypeEnv] [env : TcTypeEnv]) : TcStringList
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    (cond
      [(= head -1) Nil]
      [(< head -1)
        (let
          [cache : TcTypeEnvCache
            (tc-type-env-cache-at
              (tc-type-env-cache-ptr
                store-handle
                (tc-type-env-cache-index head)))]
          (if cache.scan-through
            (tc-active-cleanup-owners-scan
              root
              (TcTypeEnv store-handle cache.rest env.abi-pad))
            Nil))]
      [else
        (let
          [binding-ptr : (Ptr TcTypeEnvBinding)
            (tc-type-env-binding-ptr store-handle head)]
          [key : i64 (tc-type-env-binding-name-at binding-ptr)]
          [ty : ast.AstType (tc-type-env-binding-type-at binding-ptr)]
          [rest : TcTypeEnv
            (TcTypeEnv
              store-handle
              (tc-type-env-binding-parent-at binding-ptr)
              env.abi-pad)]
          [owners : TcStringList (tc-active-cleanup-owners-scan root rest)]
          (if (= key (tc-cleanup-owner-marker-id))
            (match ty
              [(Var owner)
                (let
                  [owner-str : String (ci.intern-str owner)]
                  (if (tc-cleanup-owner-active-id? root owner)
                    (tc-string-list-add owners owner-str)
                    owners))]
              [_ owners])
            owners))])))

(define (tc-active-cleanup-owners [env : TcTypeEnv]) : TcStringList
  (begin
    (cfg compile-profile (counters.bump! tc-profile-env-marker-scans))
    (if (not (tc-cleanup-owner-markers-possible?))
      Nil
      (let
        [head : i64 env.head]
        (if (< head -1)
          (let
            [store-handle : i64 env.store]
            [cache : TcTypeEnvCache
              (tc-type-env-cache-at
                (tc-type-env-cache-ptr
                  store-handle
                  (tc-type-env-cache-index head)))]
            (tc-active-cleanup-owners-scan
              env
              (TcTypeEnv store-handle cache.rest env.abi-pad)))
          (tc-active-cleanup-owners-scan env env))))))

(define (tc-lifetime-list-count [items : (& items ast.AstLifetimeList)]) : i64
  (ast.ast-lifetime-list-len (& items)))

(define (tc-lifetime-list-contains [items : ast.AstLifetimeList] [name : i64]) : bool
  (tc-lifetime-list-contains-at? (& items) name 0))

(define (tc-lifetime-list-contains-at?
  [items : (& items ast.AstLifetimeList)]
  [name : i64]
  [index : i64]) : bool
  (if (>= index (ast.ast-lifetime-list-len items))
    false
    (if (=
      (ast.ast-lifetime-list-get items index (ast.ast-lifetime-fallback))
      name)
      true
      (tc-lifetime-list-contains-at? items name (+ index 1)))))

(define (tc-lifetime-list-duplicates? [items : (& items ast.AstLifetimeList)]) : bool
  (tc-lifetime-list-duplicates-at? (& items) 0))

(define (tc-lifetime-list-contains-after?
  [items : (& items ast.AstLifetimeList)]
  [name : i64]
  [index : i64]) : bool
  (if (>= index (ast.ast-lifetime-list-len items))
    false
    (if (=
      (ast.ast-lifetime-list-get items index (ast.ast-lifetime-fallback))
      name)
      true
      (tc-lifetime-list-contains-after? items name (+ index 1)))))

(define (tc-lifetime-list-duplicates-at?
  [items : (& items ast.AstLifetimeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-lifetime-list-len items))
    false
    (let
      [item : i64
        (ast.ast-lifetime-list-get items index (ast.ast-lifetime-fallback))]
      (or
        (tc-lifetime-list-contains-after? items item (+ index 1))
        (tc-lifetime-list-duplicates-at? items (+ index 1))))))

(define (tc-lifetime-list-eq
  [a : ast.AstLifetimeList]
  [b : ast.AstLifetimeList]) : bool
  (ast.ast-lifetime-list-eq? a b))

(define (tc-lifetime-list-to-name-id-list-into
  [items : (& items ast.AstLifetimeList)]
  [out : TcNameIdList]) : TcNameIdList
  (tc-lifetime-list-to-name-id-list-into-at (& items) out 0))

(define (tc-lifetime-list-to-name-id-list-into-at
  [items : (& items ast.AstLifetimeList)]
  [out : TcNameIdList]
  [index : i64]) : TcNameIdList
  (if (>= index (ast.ast-lifetime-list-len items))
    out
    (tc-lifetime-list-to-name-id-list-into-at
      items
      (tc-name-id-list-add
        out
        (ast.ast-lifetime-list-get items index (ast.ast-lifetime-fallback)))
      (+ index 1))))

(define (tc-name-id-list-to-lifetime-list [items : TcNameIdList]) : ast.AstLifetimeList
  (let
    [out : ast.AstLifetimeList
      (ast.ast-lifetime-list-with-capacity (tc-name-id-list-len items))]
    [cursor : TcNameIdList items]
    (while (not (tc-name-id-list-empty? cursor))
      (ast.ast-lifetime-list-push (&mut out) (tc-name-id-list-head cursor))
      (set! cursor (tc-name-id-list-rest cursor)))
    out))

(define (tc-lifetime-subst-store-read [address : i64]) : TcLifetimeSubstStoreData
  (unsafe
    (ptr-read (int->ptr (cast address : u64) : (Ptr TcLifetimeSubstStoreData)))))

(define (tc-lifetime-subst-store-write!
  [address : i64]
  [data : TcLifetimeSubstStoreData]) : unit
  (unsafe
    (ptr-write!
      (int->ptr (cast address : u64) : (MutPtr TcLifetimeSubstStoreData))
      data)))

(define (tc-lifetime-subst-store-new [from : i64] [to : i64]) : i64
  (let
    [cell : (__tl_dyn-array TcLifetimeSubstStoreData)
      (__tl_make-array TcLifetimeSubstStoreData 1)]
    [nodes : (__tl_dyn-array TcLifetimeSubstNode)
      (__tl_make-array TcLifetimeSubstNode 4)]
    [owner : i64 (arena.tl_arena_current)]
    (set! (array-ref nodes 0) (TcLifetimeSubstNode from to -1))
    (set! (array-ref cell 0) (TcLifetimeSubstStoreData nodes 1 owner))
    (unsafe
      (cast
        (ptr->int
          (ptr-cast (__tl_array-data cell) : (Ptr TcLifetimeSubstStoreData)))
        : i64))))

(define (tc-lifetime-subst-store-grow!
  [data : (&mut data TcLifetimeSubstStoreData)]
  [required : i64]) : unit
  (let
    [old : (__tl_dyn-array TcLifetimeSubstNode) data.nodes]
    [old-capacity : i64 (array-length old)]
    [next-capacity : i64 old-capacity]
    (unless
      (<= required old-capacity)
      (while (< next-capacity required)
        (set! next-capacity (* next-capacity 2)))
      (in-arena
        (unsafe
          (arena.Arena data.owner-arena))
        (let
          [next : (__tl_dyn-array TcLifetimeSubstNode)
            (__tl_make-array TcLifetimeSubstNode next-capacity)]
          [index : i64 0]
          (while (< index data.len)
            (let
              [node : TcLifetimeSubstNode (array-ref old index)]
              (set!
                (array-ref next index)
                (TcLifetimeSubstNode node.from node.to node.parent))
              (set! index (+ index 1))))
          (set! data.nodes next))))))

(define (tc-lifetime-subst-store-push!
  [address : i64]
  [parent : i64]
  [from : i64]
  [to : i64]) : i64
  (let
    [data : TcLifetimeSubstStoreData (tc-lifetime-subst-store-read address)]
    [index : i64 data.len]
    (tc-lifetime-subst-store-grow! (&mut data) (+ index 1))
    (set! (array-ref data.nodes index) (TcLifetimeSubstNode from to parent))
    (set! data.len (+ index 1))
    (tc-lifetime-subst-store-write! address data)
    index))

(define (tc-lifetime-subst-lookup [subst : TcLifetimeSubst] [name : i64]) : TcMaybeNameId
  (match subst
    [(Nil) (No)]
    [(One from to)
      (if (= from name)
        (Some to)
        (No))]
    [(Dense address tail len)
      (let
        [data : TcLifetimeSubstStoreData (tc-lifetime-subst-store-read address)]
        [nodes : (__tl_dyn-array TcLifetimeSubstNode) data.nodes]
        [index : i64 tail]
        [remaining : i64 len]
        [found : bool false]
        [replacement : i64 -1]
        (while (and (not found) (> remaining 0))
          (when
            (= (__tl-project-field (array-ref nodes index) from) name)
            (set! replacement (__tl-project-field (array-ref nodes index) to))
            (set! found true))
          (set! index (__tl-project-field (array-ref nodes index) parent))
          (-= remaining 1))
        (if found
          (Some replacement)
          (No)))]))

(define (tc-lifetime-subst-push
  [subst : TcLifetimeSubst]
  [from : i64]
  [to : i64]) : TcLifetimeSubst
  (match subst
    [(Nil) (One from to)]
    [(One previous-from previous-to)
      (let
        [address : i64 (tc-lifetime-subst-store-new previous-from previous-to)]
        [tail : i64 (tc-lifetime-subst-store-push! address 0 from to)]
        (Dense address tail 2))]
    [(Dense address tail len)
      (Dense
        address
        (tc-lifetime-subst-store-push! address tail from to)
        (+ len 1))]))

(define (tc-lifetime-subst-bind
  [subst : TcLifetimeSubst]
  [from : i64]
  [to : i64]) : ResultTcLifetimeSubst
  (match (tc-lifetime-subst-lookup subst from)
    [(Some existing)
      (if (= existing to)
        (Ok subst)
        (Err
          (tc-kind-message
            (LifetimeMismatch)
            "typecheck: constructor lifetime mismatch")))]
    [(No) (Ok (tc-lifetime-subst-push subst from to))]))

(define (tc-lifetime-subst-apply [subst : TcLifetimeSubst] [name : i64]) : i64
  (match (tc-lifetime-subst-lookup subst name)
    [(Some replacement) replacement]
    [(No) name]))

(define (tc-lifetime-subst-list
  [subst : TcLifetimeSubst]
  [items : ast.AstLifetimeList]) : ast.AstLifetimeList
  (tc-lifetime-subst-list-at subst (& items) 0))

(define (tc-lifetime-subst-list-at
  [subst : TcLifetimeSubst]
  [items : (& items ast.AstLifetimeList)]
  [index : i64]) : ast.AstLifetimeList
  (if (>= index (ast.ast-lifetime-list-len items))
    (ast.ast-lifetime-list-new)
    (ast.ast-lifetime-cons
      (tc-lifetime-subst-apply
        subst
        (ast.ast-lifetime-list-get items index (ast.ast-lifetime-fallback)))
      (& (tc-lifetime-subst-list-at subst items (+ index 1))))))

;; V1 lifetime names are owner names. Normal environment bindings own stack
;; slots, and the synthetic region marker owns a with-arena scope. Environment
;; order is the lexical outlives relation: older owners appear farther down the
;; list and outlive nested stack bindings or scoped arenas. The default program
;; arena is inferred for untagged aggregate handles, so it has no lexical
;; binder in this environment walk.
(define (tc-signature-lifetime-marker-entry-id?
  [key : i64]
  [ty : (& ast.AstType)]
  [lifetime-id : i64]
  [signature-marker-id : i64]) : bool
  (if (= key signature-marker-id)
    (match ty
      [(Var lifetime) (and (>= lifetime-id 0) (= lifetime lifetime-id))]
      [_ false])
    false))

(define (tc-env-binding-matches-lifetime-id?
  [session : cis.InternStructuralSessionHandle]
  [key : i64]
  [ty : (& ast.AstType)]
  [lifetime-id : i64]
  [signature-marker-id : i64]) : bool
  (cond
    [(= key lifetime-id) true]
    [(tc-signature-lifetime-marker-entry-id?
        key
        ty
        lifetime-id
        signature-marker-id)
      true]
    [(= key (tc-region-marker-id))
      (match ty
        [(Var region) (and (>= lifetime-id 0) (= region lifetime-id))]
        [_ false])]
    [(or
        (= key (tc-ordinary-arena-owner-marker-id))
        (= key (tc-atomic-arena-owner-marker-id)))
      (match ty
        [(Var owner)
          (tc-arena-region-owned-by-id-for-session? session owner lifetime-id)]
        [_ false])]
    [else false]))

;; 0 = no matching binding in this cache window, 1 = ordinary/region/arena
;; binding, 2 = signature marker. Packed positions preserve the head-first
;; lexical order when several binding forms spell the same lifetime.
(define (tc-env-cache-lifetime-match-status
  [cache-ptr : (Ptr TcTypeEnvCache)]
  [session : cis.InternStructuralSessionHandle]
  [lifetime-id : i64]) : i64
  (let
    [ids : tc_i64_i64_map.Map
      (tc-type-env-cache-field-at cache-ptr 32 tc_i64_i64_map.Map)]
    [sidecar-flags : (__tl_dyn-array i64)
      (tc-type-env-cache-field-at cache-ptr 72 (__tl_dyn-array i64))]
    [ordinary-index : i64 (tc_i64_i64_map.get-value-or (& ids) lifetime-id -1)]
    [marker-index : i64
      (tc_i64_i64_map.get-value-or
        (& ids)
        (tc-env-cache-lifetime-marker-key lifetime-id)
        -1)]
    [owner-id : i64
      (match (cis.intern-structural-session-arena-phase-record-for-raw
        session
        lifetime-id)
        [(Some (Region owner _)) owner]
        [_ -1])]
    [owner-marker-index : i64
      (if (>= owner-id 0)
        (tc_i64_i64_map.get-value-or
          (& ids)
          (tc-env-cache-arena-lifetime-marker-key owner-id)
          -1)
        -1)]
    [best-position : i64
      (if (>= ordinary-index 0)
        (/
          (array-ref sidecar-flags ordinary-index)
          tc-env-cache-sidecar-position-scale)
        -1)]
    [best-signature : bool false]
    (if (>= marker-index 0)
      (let
        [flags : i64 (array-ref sidecar-flags marker-index)]
        [position : i64 (/ flags tc-env-cache-sidecar-position-scale)]
        (when
          (or (< best-position 0) (< position best-position))
          (set! best-position position)
          (set!
            best-signature
            (not (= (bit-and flags tc-env-cache-flag-signature-lifetime) 0)))))
      unit)
    (if (>= owner-marker-index 0)
      (let
        [flags : i64 (array-ref sidecar-flags owner-marker-index)]
        [position : i64 (/ flags tc-env-cache-sidecar-position-scale)]
        (when
          (or (< best-position 0) (< position best-position))
          (set! best-position position)
          (set!
            best-signature
            (not (= (bit-and flags tc-env-cache-flag-signature-lifetime) 0)))))
      unit)
    (if (< best-position 0)
      0
      (if best-signature
        2
        1))))

(define (tc-env-cache-covered-count [sidecar-flags : (__tl_dyn-array i64)]) : i64
  (array-ref sidecar-flags (- (array-length sidecar-flags) 1)))

;; Return the head-first lexical rank of an ordinary binding, or -1.  Local
;; cache layers store the original spine position in the packed sidecar, so a
;; miss can jump over the covered window while preserving the exact ordering
;; used by lifetime outlives checks.  Marker-owned lifetime spellings still use
;; the established scan below.
(define (tc-ordinary-binding-rank-id-from
  [env : TcTypeEnv]
  [name-id : i64]
  [base : i64]) : i64
  (match (tc-type-env-view env)
    [(Nil) -1]
    [(Bind key _ rest)
      (if (= key name-id)
        base
        (tc-ordinary-binding-rank-id-from rest name-id (+ base 1)))]
    [(Cache cache-ptr scan-through partial _ below)
      (let
        [ids : tc_i64_i64_map.Map
          (tc-type-env-cache-field-at cache-ptr 32 tc_i64_i64_map.Map)]
        [sidecar-flags : (__tl_dyn-array i64)
          (tc-type-env-cache-field-at cache-ptr 72 (__tl_dyn-array i64))]
        (if scan-through
          (match (tc_i64_i64_map.get (& ids) name-id)
            [(LookupFound index)
              (+
                base
                (/
                  (array-ref sidecar-flags index)
                  tc-env-cache-sidecar-position-scale))]
            [(LookupMissing)
              (if partial
                (tc-ordinary-binding-rank-id-from
                  below
                  name-id
                  (+ base (tc-env-cache-covered-count sidecar-flags)))
                -1)])
          -1))]))

(define (tc-lifetime-visible-scan-id?
  [env : TcTypeEnv]
  [session : cis.InternStructuralSessionHandle]
  [lifetime-id : i64]
  [signature-marker-id : i64]) : bool
  (match (tc-type-env-view env)
    [(Nil) false]
    [(Cache cache-ptr scan-through partial rest below)
      (if scan-through
        (if partial
          (or
            (not
              (=
                (tc-env-cache-lifetime-match-status
                  cache-ptr
                  session
                  lifetime-id)
                0))
            (tc-lifetime-visible-scan-id?
              below
              session
              lifetime-id
              signature-marker-id))
          (tc-lifetime-visible-scan-id?
            rest
            session
            lifetime-id
            signature-marker-id))
        false)]
    [(Bind key ty rest)
      (if (tc-env-binding-matches-lifetime-id?
        session
        key
        ty
        lifetime-id
        signature-marker-id)
        true
        (tc-lifetime-visible-scan-id?
          rest
          session
          lifetime-id
          signature-marker-id))]))

(define (tc-lifetime-nearest-binding-signature-scan-id?
  [env : TcTypeEnv]
  [session : cis.InternStructuralSessionHandle]
  [lifetime-id : i64]
  [signature-marker-id : i64]) : bool
  (match (tc-type-env-view env)
    [(Nil) false]
    [(Cache cache-ptr scan-through partial rest below)
      (if scan-through
        (if partial
          (let
            [status : i64
              (tc-env-cache-lifetime-match-status cache-ptr session lifetime-id)]
            (cond
              [(= status 2) true]
              [(= status 1) false]
              [else
                (tc-lifetime-nearest-binding-signature-scan-id?
                  below
                  session
                  lifetime-id
                  signature-marker-id)]))
          (tc-lifetime-nearest-binding-signature-scan-id?
            rest
            session
            lifetime-id
            signature-marker-id))
        false)]
    [(Bind key ty rest)
      (if (tc-env-binding-matches-lifetime-id?
        session
        key
        ty
        lifetime-id
        signature-marker-id)
        (tc-signature-lifetime-marker-entry-id?
          key
          ty
          lifetime-id
          signature-marker-id)
        (tc-lifetime-nearest-binding-signature-scan-id?
          rest
          session
          lifetime-id
          signature-marker-id))]))

(define (tc-lifetime-visible-persistent-id?
  [env : TcTypeEnv]
  [lifetime-id : i64]) : bool
  (if (< lifetime-id 0)
    false
    (let
      [session : cis.InternStructuralSessionHandle
        (tc-type-env-structural-session env)]
      [signature-marker-id : i64 (tc-signature-lifetime-marker-id)]
      (or
        (>= (tc-ordinary-binding-rank-id-from env lifetime-id 0) 0)
        (tc-lifetime-visible-scan-id?
          env
          session
          lifetime-id
          signature-marker-id)))))

(define (tc-lifetime-visible-id? [env : TcTypeEnv] [lifetime-id : i64]) : bool
  (if (tc-generated-arena-brand-id? lifetime-id)
    true
    (if (tc-type-env-scoped-runtime-active? env)
      (tc-type-env-scoped-carrier-lifetime-visible-id?
        (tc-type-env-scoped-runtime-current env)
        lifetime-id)
      (begin
        (cfg compile-profile (counters.bump! tc-profile-env-marker-scans))
        (tc-lifetime-visible-persistent-id? env lifetime-id)))))

(define (tc-reference-lifetimes-visible?
  [env : TcTypeEnv]
  [lifetimes : TcNameIdList]) : bool
  (let
    [cursor : TcNameIdList lifetimes]
    [visible : bool true]
    (while (and visible (not (tc-name-id-list-empty? cursor)))
      (if (tc-lifetime-visible-id? env (tc-name-id-list-head cursor))
        unit
        (set! visible false))
      (set! cursor (tc-name-id-list-rest cursor)))
    visible))

(define (tc-lifetime-outlives-binding-scan-inner-id
  [env : TcTypeEnv]
  [session : cis.InternStructuralSessionHandle]
  [lifetime-id : i64]
  [target-id : i64]
  [seen-target : bool]
  [signature-only : bool]
  [signature-marker-id : i64]) : bool
  (match (tc-type-env-view env)
    [(Nil) false]
    [(Cache _ scan-through _ rest _)
      (if scan-through
        (tc-lifetime-outlives-binding-scan-inner-id
          rest
          session
          lifetime-id
          target-id
          seen-target
          signature-only
          signature-marker-id)
        false)]
    [(Bind key ty rest)
      (if (if signature-only
        (tc-signature-lifetime-marker-entry-id?
          key
          ty
          lifetime-id
          signature-marker-id)
        (tc-env-binding-matches-lifetime-id?
          session
          key
          ty
          lifetime-id
          signature-marker-id))
        seen-target
        (tc-lifetime-outlives-binding-scan-inner-id
          rest
          session
          lifetime-id
          target-id
          (or seen-target (= key target-id))
          signature-only
          signature-marker-id))]))

(define (tc-lifetime-outlives-binding-scan-id
  [env : TcTypeEnv]
  [session : cis.InternStructuralSessionHandle]
  [lifetime-id : i64]
  [target-id : i64]
  [seen-target : bool]
  [signature-only : bool]
  [signature-marker-id : i64]) : bool
  (match (tc-type-env-view env)
    [(Cache _ _ _ rest _)
      (tc-lifetime-outlives-binding-scan-inner-id
        rest
        session
        lifetime-id
        target-id
        seen-target
        signature-only
        signature-marker-id)]
    [_
      (tc-lifetime-outlives-binding-scan-inner-id
        env
        session
        lifetime-id
        target-id
        seen-target
        signature-only
        signature-marker-id)]))

(define (tc-lifetime-outlives-binding-persistent-id?
  [env : TcTypeEnv]
  [lifetime-id : i64]
  [target-id : i64]) : bool
  (if (or (< lifetime-id 0) (< target-id 0))
    false
    (let
      [session : cis.InternStructuralSessionHandle
        (tc-type-env-structural-session env)]
      [signature-marker-id : i64 (tc-signature-lifetime-marker-id)]
      [signature-lifetime : bool
        (tc-lifetime-nearest-binding-signature-scan-id?
          env
          session
          lifetime-id
          signature-marker-id)]
      [lifetime-rank : i64 (tc-ordinary-binding-rank-id-from env lifetime-id 0)]
      [target-rank : i64 (tc-ordinary-binding-rank-id-from env target-id 0)]
      (if signature-lifetime
        (tc-lifetime-outlives-binding-scan-id
          env
          session
          lifetime-id
          target-id
          false
          true
          signature-marker-id)
        (if (and (>= lifetime-rank 0) (>= target-rank 0))
          (> lifetime-rank target-rank)
          (tc-lifetime-outlives-binding-scan-id
            env
            session
            lifetime-id
            target-id
            false
            false
            signature-marker-id))))))

(define (tc-lifetime-outlives-binding-id?
  [env : TcTypeEnv]
  [lifetime-id : i64]
  [target-id : i64]) : bool
  (if (tc-type-env-scoped-runtime-active? env)
    (tc-type-env-scoped-carrier-lifetime-outlives-binding-id?
      (tc-type-env-scoped-runtime-current env)
      lifetime-id
      target-id)
    (begin
      (cfg compile-profile (counters.bump! tc-profile-env-marker-scans))
      (tc-lifetime-outlives-binding-persistent-id? env lifetime-id target-id))))

(define (tc-first-shorter-lifetime-id
  [env : TcTypeEnv]
  [lifetimes : TcNameIdList]
  [target-id : i64]) : TcMaybeNameId
  (let
    [cursor : TcNameIdList lifetimes]
    (while (not (tc-name-id-list-empty? cursor))
      (unless
        (tc-lifetime-outlives-binding-id?
          env
          (tc-name-id-list-head cursor)
          target-id)
        (return (Some (tc-name-id-list-head cursor))))
      (set! cursor (tc-name-id-list-rest cursor))))
  (No))

(define (tc-reference-lifetimes-outlive-binding-id?
  [env : TcTypeEnv]
  [lifetimes : TcNameIdList]
  [target-id : i64]) : bool
  (match (tc-first-shorter-lifetime-id env lifetimes target-id)
    [(No) true]
    [(Some _) false]))

(define (tc-lifetime-outlives-lifetime-scan-inner-id
  [env : TcTypeEnv]
  [session : cis.InternStructuralSessionHandle]
  [value-lifetime-id : i64]
  [target-lifetime-id : i64]
  [seen-target : bool]
  [value-signature : bool]
  [target-signature : bool]
  [signature-marker-id : i64]) : bool
  (if (and (>= value-lifetime-id 0) (= value-lifetime-id target-lifetime-id))
    true
    (match (tc-type-env-view env)
      [(Nil) false]
      [(Cache _ scan-through _ rest _)
        (if scan-through
          (tc-lifetime-outlives-lifetime-scan-inner-id
            rest
            session
            value-lifetime-id
            target-lifetime-id
            seen-target
            value-signature
            target-signature
            signature-marker-id)
          false)]
      [(Bind key ty rest)
        (if (if value-signature
          (tc-signature-lifetime-marker-entry-id?
            key
            ty
            value-lifetime-id
            signature-marker-id)
          (tc-env-binding-matches-lifetime-id?
            session
            key
            ty
            value-lifetime-id
            signature-marker-id))
          seen-target
          (tc-lifetime-outlives-lifetime-scan-inner-id
            rest
            session
            value-lifetime-id
            target-lifetime-id
            (or
              seen-target
              (if target-signature
                (tc-signature-lifetime-marker-entry-id?
                  key
                  ty
                  target-lifetime-id
                  signature-marker-id)
                (tc-env-binding-matches-lifetime-id?
                  session
                  key
                  ty
                  target-lifetime-id
                  signature-marker-id)))
            value-signature
            target-signature
            signature-marker-id))])))

(define (tc-lifetime-outlives-lifetime-scan-id
  [env : TcTypeEnv]
  [session : cis.InternStructuralSessionHandle]
  [value-lifetime-id : i64]
  [target-lifetime-id : i64]
  [seen-target : bool]
  [value-signature : bool]
  [target-signature : bool]
  [signature-marker-id : i64]) : bool
  (match (tc-type-env-view env)
    [(Cache _ _ _ rest _)
      (tc-lifetime-outlives-lifetime-scan-inner-id
        rest
        session
        value-lifetime-id
        target-lifetime-id
        seen-target
        value-signature
        target-signature
        signature-marker-id)]
    [_
      (tc-lifetime-outlives-lifetime-scan-inner-id
        env
        session
        value-lifetime-id
        target-lifetime-id
        seen-target
        value-signature
        target-signature
        signature-marker-id)]))

;; The persistent spine is immutable below each (store, head) snapshot.
;; Store epochs reject addresses reused after scratch retirement; structural
;; owner/generation and installed intern owner/generation reject recycled ids.
;; Entries retain only scalars in the existing job-owned resolution cache, whose
;; epoch also invalidates them on a job reset. Collisions only replace a slot.
(define tc-outlives-memo-capacity : i64
  1024)

(define (tc-outlives-memo-storage-ensure! [state : TcTypeResolutionCacheState]) : unit
  (let
    [data : (MutPtr TcTypeResolutionCacheStateData)
      (tc-type-resolution-cache-state-ptr state)]
    (unsafe
      (when
        (= (array-length (deref data).outlives-slots) 0)
        (in-arena
          (arena.Arena (deref data).owner-arena)
          (set!
            (deref data).outlives-slots
            (__tl_make-array
              TcLifetimeOutlivesMemoEntry
              tc-outlives-memo-capacity)))))))

(define (tc-outlives-memo-slot [head : i64] [value : i64] [target : i64]) : i64
  (bit-and
    (bit-xor
      (bit-xor (* head 2654435761) (shr head 21))
      (bit-xor (* value 40503) (* target 9973)))
    (- tc-outlives-memo-capacity 1)))

(define (tc-lifetime-outlives-lifetime-persistent-id?
  [env : TcTypeEnv]
  [value-lifetime-id : i64]
  [target-lifetime-id : i64]) : bool
  (if (or (< value-lifetime-id 0) (< target-lifetime-id 0))
    false
    (if (= value-lifetime-id target-lifetime-id)
      true
      (let
        [state : TcTypeResolutionCacheState
          (tc-type-env-type-resolution-cache-state env)]
        [_storage : unit (tc-outlives-memo-storage-ensure! state)]
        [data : TcTypeResolutionCacheStateData
          (tc-type-resolution-cache-state-data state)]
        [session : cis.InternStructuralSessionHandle
          (tc-type-env-structural-session env)]
        [owner : i64 (cis.intern-structural-session-owner session)]
        [session-generation : i64
          (cis.intern-structural-session-current-reset-generation session)]
        [intern-owner : i64 (ci.intern-active-table-id)]
        [intern-generation : i64 (ci.intern-generation)]
        [epoch : i64 (+ tc-type-env-store-epoch 1)]
        [slot : i64
          (tc-outlives-memo-slot env.head value-lifetime-id target-lifetime-id)]
        [entry : (& data TcLifetimeOutlivesMemoEntry)
          (& (array-ref data.outlives-slots slot))]
        (if (and
          (= entry.store-epoch epoch)
          (= entry.job-epoch data.epoch)
          (= entry.head env.head)
          (= entry.store env.store)
          (= entry.value-lifetime value-lifetime-id)
          (= entry.target-lifetime target-lifetime-id)
          (= entry.session-owner owner)
          (= entry.session-generation session-generation)
          (= entry.intern-owner intern-owner)
          (= entry.intern-generation intern-generation))
          entry.result
          (let
            [result : bool
              (tc-lifetime-outlives-lifetime-persistent-scan-id?
                env
                value-lifetime-id
                target-lifetime-id)]
            (set!
              (array-ref data.outlives-slots slot)
              (TcLifetimeOutlivesMemoEntry
                env.store
                env.head
                value-lifetime-id
                target-lifetime-id
                owner
                session-generation
                intern-owner
                intern-generation
                epoch
                data.epoch
                result))
            result))))))

(define (tc-lifetime-outlives-lifetime-persistent-scan-id?
  [env : TcTypeEnv]
  [value-lifetime-id : i64]
  [target-lifetime-id : i64]) : bool
  (if (or (< value-lifetime-id 0) (< target-lifetime-id 0))
    false
    (if (= value-lifetime-id target-lifetime-id)
      true
      (let
        [session : cis.InternStructuralSessionHandle
          (tc-type-env-structural-session env)]
        [signature-marker-id : i64 (tc-signature-lifetime-marker-id)]
        [value-signature : bool
          (tc-lifetime-nearest-binding-signature-scan-id?
            env
            session
            value-lifetime-id
            signature-marker-id)]
        [target-signature : bool
          (tc-lifetime-nearest-binding-signature-scan-id?
            env
            session
            target-lifetime-id
            signature-marker-id)]
        [value-rank : i64
          (tc-ordinary-binding-rank-id-from env value-lifetime-id 0)]
        [target-rank : i64
          (tc-ordinary-binding-rank-id-from env target-lifetime-id 0)]
        (cond
          [(and value-signature target-signature) false]
          [(or value-signature target-signature)
            (tc-lifetime-outlives-lifetime-scan-id
              env
              session
              value-lifetime-id
              target-lifetime-id
              false
              value-signature
              target-signature
              signature-marker-id)]
          [(and (>= value-rank 0) (>= target-rank 0))
            (> value-rank target-rank)]
          [else
            (tc-lifetime-outlives-lifetime-scan-id
              env
              session
              value-lifetime-id
              target-lifetime-id
              false
              false
              false
              signature-marker-id)])))))

(define (tc-lifetime-outlives-lifetime-id?
  [env : TcTypeEnv]
  [value-lifetime-id : i64]
  [target-lifetime-id : i64]) : bool
  (if (= value-lifetime-id target-lifetime-id)
    true
    (let
      [temporary : i64 (tc-call-temporary-lifetime-id)]
      (cond
        ;; A borrowed call-argument temporary dies when its call returns, so
        ;; every other lifetime outlives it and it outlives none of them.
        [(= target-lifetime-id temporary) true]
        [(= value-lifetime-id temporary) false]
        [(tc-type-env-scoped-runtime-active? env)
          (tc-type-env-scoped-carrier-lifetime-outlives-lifetime-id?
            (tc-type-env-scoped-runtime-current env)
            value-lifetime-id
            target-lifetime-id)]
        [else
          (begin
            (cfg compile-profile (counters.bump! tc-profile-env-marker-scans))
            (tc-lifetime-outlives-lifetime-persistent-id?
              env
              value-lifetime-id
              target-lifetime-id))]))))

(define (tc-reference-lifetimes-outlive-lifetime-id?
  [env : TcTypeEnv]
  [lifetimes : TcNameIdList]
  [target-lifetime-id : i64]) : bool
  (let
    [cursor : TcNameIdList lifetimes]
    [outlives : bool true]
    (while (and outlives (not (tc-name-id-list-empty? cursor)))
      (if (tc-lifetime-outlives-lifetime-id?
        env
        (tc-name-id-list-head cursor)
        target-lifetime-id)
        unit
        (set! outlives false))
      (set! cursor (tc-name-id-list-rest cursor)))
    outlives))

(define (tc-reference-lifetimes-outlive-lifetime?
  [env : TcTypeEnv]
  [lifetimes : TcNameIdList]
  [target-lifetime : i64]) : bool
  (tc-reference-lifetimes-outlive-lifetime-id? env lifetimes target-lifetime))

(define (tc-ensure-reference-value-can-bind
  [env : TcTypeEnv]
  [value-ty : ast.AstType]) : ResultTcUnit
  (let
    [lifetimes : TcNameIdList (tc-type-collect-regions value-ty)]
    (if (tc-reference-lifetimes-visible? env lifetimes)
      Ok
      (Err
        (tc-kind-message
          (RegionEscape)
          "typecheck: reference value would escape lexical scope")))))

(define (tc-ensure-reference-value-can-assign
  [env : TcTypeEnv]
  [target-id : i64]
  [value-ty : ast.AstType]) : ResultTcUnit
  (let
    [lifetimes : TcNameIdList (tc-type-collect-reference-lifetimes value-ty)]
    (if (tc-reference-lifetimes-outlive-binding-id? env lifetimes target-id)
      Ok
      (Err
        (tc-kind-message
          (RegionEscape)
          "typecheck: cannot store reference into longer-lived binding; reference value would escape lexical scope")))))

(define (tc-ensure-reference-type-does-not-escape-names
  [ty : ast.AstType]
  [names : TcNameIdList]) : ResultTcUnit
  (if (tc-name-id-list-overlaps? (tc-type-collect-regions ty) names)
    (Err
      (tc-kind-message
        (RegionEscape)
        "typecheck: reference value would escape lexical scope"))
    Ok))

(define (tc-type-strip-region [ty : ast.AstType]) : ast.AstType
  (match (tc-global-shared-view ty)
    [(or (Region _ inner) (Invalidate _ inner))
      (tc-type-strip-region (ast.ty-node-get inner))]
    ;; An `:invalidate` parameter wrapper is structurally its inner type; code
    ;; that needs the effect reads it before stripping (#6670).
    [_ ty]))

;; The lifetime an `(:invalidate r T)` parameter type destroys, if it is one.
(define (tc-type-invalidate-lifetime [ty : ast.AstType]) : TcMaybeNameId
  (match ty
    [(Invalidate lifetime _) (Some lifetime)]
    [_ (No)]))

;; Whether any `(:invalidate r T)` type exists yet. Until one does, the
;; checkers skip every `:invalidate` scan (see `ast-invalidate-type-count`).
(defmacro (tc-invalidate-types-present?) : Expr
  `(not (= ast.ast-invalidate-type-count 0)))

;; A parameter type without its `(:invalidate r T)` wrapper.
(define (tc-type-strip-invalidate [ty : ast.AstType]) : ast.AstType
  (match (tc-global-shared-view ty)
    [(Invalidate _ inner) (ast.ty-node-get inner)]
    [_ ty]))

(define (tc-type-list-contains-region-tag? [types : ast.AstTypeList]) : bool
  (tc-type-list-contains-region-tag-at? (& types) 0))

(define (tc-type-list-contains-region-tag-at?
  [types : (& types ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    false
    (if (tc-type-contains-region-tag?
      (ast.ty-node-get
        (ast.ast-type-list-get types index (ast.ast-type-id-fallback))))
      true
      (tc-type-list-contains-region-tag-at? types (+ index 1)))))

(define (tc-type-contains-region-tag? [ty : ast.AstType]) : bool
  (match ty
    [(Func args ret)
      (if (tc-type-list-contains-region-tag?
        (ast.ast-type-list-box-shared-view args))
        true
        (tc-type-contains-region-tag? (ast.ty-node-get ret)))]
    [(Tuple elems)
      (tc-type-list-contains-region-tag?
        (ast.ast-type-list-box-shared-view elems))]
    [(or (Array elem _) (DynArray elem) (Slice elem) (Box elem) (Ptr elem)
         (MutPtr elem) (Ref _ elem) (MutRef _ elem) (Invalidate _ elem))
      (tc-type-contains-region-tag? (ast.ty-node-get elem))]
    [(Region _ _) true]
    [_ false]))

(define (tc-type-list-without-regions [types : ast.AstTypeList]) : ast.AstTypeList
  (if (tc-type-list-contains-region-tag? (tc-global-shared-view types))
    (tc-type-list-without-regions-at (& types) 0)
    types))

(define (tc-type-list-without-regions-at
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ast.AstTypeList
  (if (>= index (ast.ast-type-list-len types))
    (ast.ast-type-list-new)
    (ast.ast-type-cons
      (&
        (tc-type-without-regions
          (ast.ty-node-get
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))))
      (& (tc-type-list-without-regions-at types (+ index 1))))))

(define (tc-type-without-regions [ty : ast.AstType]) : ast.AstType
  (if (tc-type-contains-region-tag? (tc-global-shared-view ty))
    (match (tc-global-shared-view ty)
      [(Func args ret)
        (ast.ast-ty-func
          (tc-type-list-without-regions
            (ast.ast-type-list-box-shared-view args))
          (& (tc-type-without-regions (ast.ty-node-get ret))))]
      [(Tuple elems)
        (ast.ast-ty-tuple
          (tc-type-list-without-regions
            (ast.ast-type-list-box-shared-view elems)))]
      [(Array elem len)
        (ast.ast-ty-array
          (& (tc-type-without-regions (ast.ty-node-get elem)))
          len)]
      [(DynArray elem)
        (ast.ast-ty-dyn-array
          (& (tc-type-without-regions (ast.ty-node-get elem))))]
      [(Slice elem)
        (ast.ast-ty-slice (& (tc-type-without-regions (ast.ty-node-get elem))))]
      [(Box elem)
        (ast.ast-ty-box (& (tc-type-without-regions (ast.ty-node-get elem))))]
      [(Ptr elem)
        (ast.ast-ty-ptr (& (tc-type-without-regions (ast.ty-node-get elem))))]
      [(MutPtr elem)
        (ast.ast-ty-mut-ptr
          (& (tc-type-without-regions (ast.ty-node-get elem))))]
      [(Ref region inner)
        (ast.ast-ty-ref
          region
          (& (tc-type-without-regions (ast.ty-node-get inner))))]
      [(MutRef region inner)
        (ast.ast-ty-mut-ref
          region
          (& (tc-type-without-regions (ast.ty-node-get inner))))]
      [(Region _ inner) (tc-type-without-regions (ast.ty-node-get inner))]
      [(Invalidate lifetime inner)
        (ast.ast-ty-invalidate
          lifetime
          (& (tc-type-without-regions (ast.ty-node-get inner))))]
      [(EnumArgs name lifetimes)
        (ast.ast-ty-enum-args
          name
          (ast.ast-lifetime-list-box-shared-view lifetimes))]
      [(StructArgs name lifetimes)
        (ast.ast-ty-struct-args
          name
          (ast.ast-lifetime-list-box-shared-view lifetimes))]
      [(VarArgs name lifetimes)
        (ast.ast-ty-var-args
          name
          (ast.ast-lifetime-list-box-shared-view lifetimes))]
      [_ ty])
    ty))

(define (tc-type-list-contains-region [types : ast.AstTypeList] [region : i64]) : bool
  (tc-type-list-contains-region-at? (& types) region 0))

(define (tc-type-list-contains-region-at?
  [types : (& types ast.AstTypeList)]
  [region : i64]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    false
    (or
      (tc-type-contains-region
        (ast.ty-node-get
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))
        region)
      (tc-type-list-contains-region-at? types region (+ index 1)))))

(define (tc-type-contains-region [ty : ast.AstType] [region : i64]) : bool
  (match ty
    [(Func args ret)
      (or
        (tc-type-list-contains-region
          (ast.ast-type-list-box-shared-view args)
          region)
        (tc-type-contains-region (ast.ty-node-get ret) region))]
    [(Tuple elems)
      (tc-type-list-contains-region
        (ast.ast-type-list-box-shared-view elems)
        region)]
    [(or (Array elem _) (DynArray elem) (Slice elem) (Box elem) (Ptr elem)
         (MutPtr elem))
      (tc-type-contains-region (ast.ty-node-get elem) region)]
    [(or (Ref name inner) (MutRef name inner) (Region name inner)
         (Invalidate name inner))
      (or
        (= name region)
        (tc-type-contains-region (ast.ty-node-get inner) region))]
    [(or (EnumArgs _ lifetimes) (StructArgs _ lifetimes) (VarArgs _ lifetimes))
      (tc-lifetime-list-contains
        (ast.ast-lifetime-list-box-shared-view lifetimes)
        region)]
    [_ false]))

(define (tc-type-list-contains-any-region [types : ast.AstTypeList]) : bool
  (tc-type-list-contains-any-region-at? (& types) 0))

(define (tc-type-list-contains-any-region-at?
  [types : (& types ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    false
    (or
      (tc-type-contains-any-region
        (ast.ty-node-get
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback))))
      (tc-type-list-contains-any-region-at? types (+ index 1)))))

(define (tc-type-contains-any-region [ty : ast.AstType]) : bool
  (match ty
    [(Func args ret)
      (or
        (tc-type-list-contains-any-region
          (ast.ast-type-list-box-shared-view args))
        (tc-type-contains-any-region (ast.ty-node-get ret)))]
    [(Tuple elems)
      (tc-type-list-contains-any-region
        (ast.ast-type-list-box-shared-view elems))]
    [(or (Array elem _) (DynArray elem) (Slice elem) (Box elem) (Ptr elem)
         (MutPtr elem))
      (tc-type-contains-any-region (ast.ty-node-get elem))]
    [(or (Ref _ _) (MutRef _ _) (Region _ _) (Invalidate _ _)) true]
    [(or (EnumArgs _ lifetimes) (StructArgs _ lifetimes) (VarArgs _ lifetimes))
      (> (tc-lifetime-list-count (deref lifetimes)) 0)]
    [_ false]))

(define (tc-type-list-contains-reference? [types : ast.AstTypeList]) : bool
  (tc-type-list-contains-reference-at? (& types) 0))

(define (tc-type-list-contains-reference-at?
  [types : (& types ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    false
    (or
      (tc-type-contains-reference?
        (ast.ty-node-get
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback))))
      (tc-type-list-contains-reference-at? types (+ index 1)))))

(define (tc-type-list-contains-mut-reference? [types : ast.AstTypeList]) : bool
  (tc-type-list-contains-mut-reference-at? (& types) 0))

(define (tc-type-list-contains-mut-reference-at?
  [types : (& types ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    false
    (or
      (tc-type-contains-mut-reference?
        (ast.ty-node-get
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback))))
      (tc-type-list-contains-mut-reference-at? types (+ index 1)))))

(define (tc-type-contains-reference? [ty : ast.AstType]) : bool
  (match ty
    [(Func args ret)
      (or
        (tc-type-list-contains-reference?
          (ast.ast-type-list-box-shared-view args))
        (tc-type-contains-reference? (ast.ty-node-get ret)))]
    [(Tuple elems)
      (tc-type-list-contains-reference?
        (ast.ast-type-list-box-shared-view elems))]
    [(or (Array elem _) (DynArray elem) (Slice elem) (Box elem) (Ptr elem)
         (MutPtr elem) (Region _ elem) (Invalidate _ elem))
      (tc-type-contains-reference? (ast.ty-node-get elem))]
    [(or (Ref _ _) (MutRef _ _)) true]
    [(or (EnumArgs _ lifetimes) (StructArgs _ lifetimes) (VarArgs _ lifetimes))
      (> (tc-lifetime-list-count (deref lifetimes)) 0)]
    [_ false]))

(define (tc-type-contains-mut-reference? [ty : ast.AstType]) : bool
  (match ty
    [(Func args ret)
      (or
        (tc-type-list-contains-mut-reference?
          (ast.ast-type-list-box-shared-view args))
        (tc-type-contains-mut-reference? (ast.ty-node-get ret)))]
    [(Tuple elems)
      (tc-type-list-contains-mut-reference?
        (ast.ast-type-list-box-shared-view elems))]
    [(or (Array elem _) (DynArray elem) (Slice elem) (Box elem) (Ptr elem)
         (MutPtr elem) (Ref _ elem) (Region _ elem) (Invalidate _ elem))
      (tc-type-contains-mut-reference? (ast.ty-node-get elem))]
    [(MutRef _ _) true]
    [_ false]))

;; An empty reference lifetime is the parser's marker for source-level
;; `(& T)` / `(&mut T)`. It never survives signature normalization. The
;; generated spelling cannot be written by source code, so it cannot collide
;; with an explicit lifetime name.
(defstruct TcElidedType
  (ty ast.AstType)
  (next-index i64))

(defstruct TcElidedTypes
  (types ast.AstTypeList)
  (next-index i64))

(defstruct TcElidedParams
  (params ast.AstParamList)
  (next-index i64))

(defstruct TcElidedSignature
  (params ast.AstParamList)
  (ret ast.AstType))

(defenum ResultTcElidedType
  (Ok TcElidedType)
  (Err String))

(defenum ResultTcElidedTypes
  (Ok TcElidedTypes)
  (Err String))

(defenum ResultTcElidedParams
  (Ok TcElidedParams)
  (Err String))

(defenum ResultTcElidedSignature
  (Ok TcElidedSignature)
  (Err String))

(define (tc-elided-lifetime-name [index : i64]) : i64
  (let
    [name : String
      (str_cat.str-cat
        (tc-elided-lifetime-name-prefix)
        (string.int->string index))]
    (tc-generated-name-id name)))

(define (tc-elided-lifetime? [name : i64]) : bool
  (= name cbi.compiler-builtin-id-fix-empty))

(define (tc-signature-input-lifetimes-into
  [type-bases : i64]
  [ty : ast.AstType]
  [out : TcNameIdList]) : TcNameIdList
  ;; A nested function type owns a separate signature scope. Its lifetimes are
  ;; intentionally not candidates for the enclosing function's elided return.
  (match ty
    [(Func _ _) out]
    [(Tuple elems)
      (tc-signature-input-type-list-lifetimes-into
        type-bases
        (& (ast.ast-type-list-box-shared-view elems))
        out)]
    [(or (Array elem _) (DynArray elem) (Slice elem) (Box elem) (Ptr elem)
         (MutPtr elem) (Region _ elem) (Invalidate _ elem))
      (tc-signature-input-lifetimes-into
        type-bases
        (ast.ast-type-segment-bases-get type-bases elem)
        out)]
    [(or (Ref lifetime inner) (MutRef lifetime inner))
      (tc-signature-input-lifetimes-into
        type-bases
        (ast.ast-type-segment-bases-get type-bases inner)
        (tc-name-id-list-add out lifetime))]
    [_ out]))

(define (tc-signature-input-type-list-lifetimes-into
  [type-bases : i64]
  [types : (& ast.AstTypeList)]
  [out : TcNameIdList]) : TcNameIdList
  (tc-signature-input-type-list-lifetimes-at type-bases types 0 out))

(define (tc-signature-input-type-list-lifetimes-at
  [type-bases : i64]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [out : TcNameIdList]) : TcNameIdList
  (if (>= index (ast.ast-type-list-len types))
    out
    (tc-signature-input-type-list-lifetimes-at
      type-bases
      types
      (+ index 1)
      (tc-signature-input-lifetimes-into
        type-bases
        (ast.ast-type-segment-bases-get
          type-bases
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))
        out))))

(define (tc-signature-single-input-lifetime
  [type-bases : i64]
  [types : (& ast.AstTypeList)]) : TcMaybeNameId
  (let
    [lifetimes : TcNameIdList
      (tc-signature-input-type-list-lifetimes-into type-bases types Nil)]
    (if (= (tc-name-id-list-len lifetimes) 1)
      (Some (tc-name-id-list-head lifetimes))
      (No))))

(define (tc-elide-input-type-list
  [type-bases : i64]
  [types : ast.AstTypeList]
  [index : i64]) : ResultTcElidedTypes
  (tc-elide-input-type-list-at
    type-bases
    (& types)
    0
    index
    (ast.ast-type-list-new)))

(define (tc-elide-input-type-list-at
  [type-bases : i64]
  [types : (& types ast.AstTypeList)]
  [offset : i64]
  [index : i64]
  [out : ast.AstTypeList]) : ResultTcElidedTypes
  (if (>= offset (ast.ast-type-list-len types))
    (Ok (TcElidedTypes out index))
    (let
      [item : TcElidedType
        (try
          (tc-elide-input-type
            type-bases
            (ast.ast-type-segment-bases-get
              type-bases
              (ast.ast-type-list-get types offset (ast.ast-type-id-fallback)))
            index))]
      [next-out : ast.AstTypeList out]
      (ast.ast-type-list-push (&mut next-out) (ast.ty-node-push (& item.ty)))
      (tc-elide-input-type-list-at
        type-bases
        types
        (+ offset 1)
        item.next-index
        next-out))))

(define (tc-elide-output-type-list
  [type-bases : i64]
  [types : ast.AstTypeList]
  [lifetime : TcMaybeNameId]) : ResultTcElidedTypes
  (tc-elide-output-type-list-at
    type-bases
    (& types)
    0
    lifetime
    (ast.ast-type-list-new)))

(define (tc-elide-output-type-list-at
  [type-bases : i64]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [lifetime : TcMaybeNameId]
  [out : ast.AstTypeList]) : ResultTcElidedTypes
  (if (>= index (ast.ast-type-list-len types))
    (Ok (TcElidedTypes out 0))
    (let
      [item : TcElidedType
        (try
          (tc-elide-output-type
            type-bases
            (ast.ast-type-segment-bases-get
              type-bases
              (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))
            lifetime))]
      [next-out : ast.AstTypeList out]
      (ast.ast-type-list-push (&mut next-out) (ast.ty-node-push (& item.ty)))
      (tc-elide-output-type-list-at
        type-bases
        types
        (+ index 1)
        lifetime
        next-out))))

(define (tc-elide-function-type
  [type-bases : i64]
  [args : ast.AstTypeList]
  [ret : ast.AstType]) : ResultTcElidedType
  (let
    [inputs : TcElidedTypes (try (tc-elide-input-type-list type-bases args 0))]
    [input-types : ast.AstTypeList inputs.types]
    [lifetime : TcMaybeNameId
      (tc-signature-single-input-lifetime type-bases input-types)]
    [output : TcElidedType (try (tc-elide-output-type type-bases ret lifetime))]
    (Ok
      (TcElidedType
        (ast.ast-ty-func input-types (& output.ty))
        inputs.next-index))))

(define (tc-elide-input-type
  [type-bases : i64]
  [ty : ast.AstType]
  [index : i64]) : ResultTcElidedType
  (match (tc-global-shared-view ty)
    [(Func args ret)
      (tc-elide-function-type
        type-bases
        (ast.ast-type-list-box-shared-view args)
        (ast.ast-type-segment-bases-get type-bases ret))]
    [(Tuple elems)
      (let
        [items : TcElidedTypes
          (try
            (tc-elide-input-type-list
              type-bases
              (ast.ast-type-list-box-shared-view elems)
              index))]
        (Ok (TcElidedType (ast.ast-ty-tuple items.types) items.next-index)))]
    [(Array elem count)
      (let
        [inner : TcElidedType
          (try
            (tc-elide-input-type
              type-bases
              (ast.ast-type-segment-bases-get type-bases elem)
              index))]
        (Ok
          (TcElidedType (ast.ast-ty-array (& inner.ty) count) inner.next-index)))]
    [(DynArray elem)
      (let
        [inner : TcElidedType
          (try
            (tc-elide-input-type
              type-bases
              (ast.ast-type-segment-bases-get type-bases elem)
              index))]
        (Ok (TcElidedType (ast.ast-ty-dyn-array (& inner.ty)) inner.next-index)))]
    [(Slice elem)
      (let
        [inner : TcElidedType
          (try
            (tc-elide-input-type
              type-bases
              (ast.ast-type-segment-bases-get type-bases elem)
              index))]
        (Ok (TcElidedType (ast.ast-ty-slice (& inner.ty)) inner.next-index)))]
    [(Box elem)
      (let
        [inner : TcElidedType
          (try
            (tc-elide-input-type
              type-bases
              (ast.ast-type-segment-bases-get type-bases elem)
              index))]
        (Ok (TcElidedType (ast.ast-ty-box (& inner.ty)) inner.next-index)))]
    [(Ptr elem)
      (let
        [inner : TcElidedType
          (try
            (tc-elide-input-type
              type-bases
              (ast.ast-type-segment-bases-get type-bases elem)
              index))]
        (Ok (TcElidedType (ast.ast-ty-ptr (& inner.ty)) inner.next-index)))]
    [(MutPtr elem)
      (let
        [inner : TcElidedType
          (try
            (tc-elide-input-type
              type-bases
              (ast.ast-type-segment-bases-get type-bases elem)
              index))]
        (Ok (TcElidedType (ast.ast-ty-mut-ptr (& inner.ty)) inner.next-index)))]
    [(Region region elem)
      (let
        [inner : TcElidedType
          (try
            (tc-elide-input-type
              type-bases
              (ast.ast-type-segment-bases-get type-bases elem)
              index))]
        (Ok
          (TcElidedType
            (ast.ast-ty-region region (& inner.ty))
            inner.next-index)))]
    [(Invalidate lifetime elem)
      (let
        [inner : TcElidedType
          (try
            (tc-elide-input-type
              type-bases
              (ast.ast-type-segment-bases-get type-bases elem)
              index))]
        (Ok
          (TcElidedType
            (ast.ast-ty-invalidate lifetime (& inner.ty))
            inner.next-index)))]
    [(Ref lifetime elem)
      (let
        [next-lifetime : i64
          (if (tc-elided-lifetime? lifetime)
            (tc-elided-lifetime-name index)
            lifetime)]
        [next-index : i64
          (if (tc-elided-lifetime? lifetime)
            (+ index 1)
            index)]
        [inner : TcElidedType
          (try
            (tc-elide-input-type
              type-bases
              (ast.ast-type-segment-bases-get type-bases elem)
              next-index))]
        (Ok
          (TcElidedType
            (ast.ast-ty-ref next-lifetime (& inner.ty))
            inner.next-index)))]
    [(MutRef lifetime elem)
      (let
        [next-lifetime : i64
          (if (tc-elided-lifetime? lifetime)
            (tc-elided-lifetime-name index)
            lifetime)]
        [next-index : i64
          (if (tc-elided-lifetime? lifetime)
            (+ index 1)
            index)]
        [inner : TcElidedType
          (try
            (tc-elide-input-type
              type-bases
              (ast.ast-type-segment-bases-get type-bases elem)
              next-index))]
        (Ok
          (TcElidedType
            (ast.ast-ty-mut-ref next-lifetime (& inner.ty))
            inner.next-index)))]
    [_ (Ok (TcElidedType ty index))]))

(define (tc-elide-output-type
  [type-bases : i64]
  [ty : ast.AstType]
  [lifetime : TcMaybeNameId]) : ResultTcElidedType
  (match (tc-global-shared-view ty)
    [(Func args ret)
      (tc-elide-function-type
        type-bases
        (ast.ast-type-list-box-shared-view args)
        (ast.ast-type-segment-bases-get type-bases ret))]
    [(Tuple elems)
      (let
        [items : TcElidedTypes
          (try
            (tc-elide-output-type-list
              type-bases
              (ast.ast-type-list-box-shared-view elems)
              lifetime))]
        (Ok (TcElidedType (ast.ast-ty-tuple items.types) 0)))]
    [(Array elem count)
      (let
        [inner : TcElidedType
          (try
            (tc-elide-output-type
              type-bases
              (ast.ast-type-segment-bases-get type-bases elem)
              lifetime))]
        (Ok (TcElidedType (ast.ast-ty-array (& inner.ty) count) 0)))]
    [(DynArray elem)
      (let
        [inner : TcElidedType
          (try
            (tc-elide-output-type
              type-bases
              (ast.ast-type-segment-bases-get type-bases elem)
              lifetime))]
        (Ok (TcElidedType (ast.ast-ty-dyn-array (& inner.ty)) 0)))]
    [(Slice elem)
      (let
        [inner : TcElidedType
          (try
            (tc-elide-output-type
              type-bases
              (ast.ast-type-segment-bases-get type-bases elem)
              lifetime))]
        (Ok (TcElidedType (ast.ast-ty-slice (& inner.ty)) 0)))]
    [(Box elem)
      (let
        [inner : TcElidedType
          (try
            (tc-elide-output-type
              type-bases
              (ast.ast-type-segment-bases-get type-bases elem)
              lifetime))]
        (Ok (TcElidedType (ast.ast-ty-box (& inner.ty)) 0)))]
    [(Ptr elem)
      (let
        [inner : TcElidedType
          (try
            (tc-elide-output-type
              type-bases
              (ast.ast-type-segment-bases-get type-bases elem)
              lifetime))]
        (Ok (TcElidedType (ast.ast-ty-ptr (& inner.ty)) 0)))]
    [(MutPtr elem)
      (let
        [inner : TcElidedType
          (try
            (tc-elide-output-type
              type-bases
              (ast.ast-type-segment-bases-get type-bases elem)
              lifetime))]
        (Ok (TcElidedType (ast.ast-ty-mut-ptr (& inner.ty)) 0)))]
    [(Region region elem)
      (let
        [inner : TcElidedType
          (try
            (tc-elide-output-type
              type-bases
              (ast.ast-type-segment-bases-get type-bases elem)
              lifetime))]
        (Ok (TcElidedType (ast.ast-ty-region region (& inner.ty)) 0)))]
    [(Ref name elem)
      (match lifetime
        [(No)
          (if (tc-elided-lifetime? name)
            (Err
              (tc-kind-message
                (LifetimeMismatch)
                "typecheck: elided reference return is ambiguous; write an explicit lifetime"))
            (let
              [inner : TcElidedType
                (try
                  (tc-elide-output-type
                    type-bases
                    (ast.ast-type-segment-bases-get type-bases elem)
                    lifetime))]
              (Ok (TcElidedType (ast.ast-ty-ref name (& inner.ty)) 0))))]
        [(Some source)
          (let
            [inner : TcElidedType
              (try
                (tc-elide-output-type
                  type-bases
                  (ast.ast-type-segment-bases-get type-bases elem)
                  lifetime))]
            (Ok
              (TcElidedType
                (ast.ast-ty-ref
                  (if (tc-elided-lifetime? name)
                    source
                    name)
                  (& inner.ty))
                0)))])]
    [(MutRef name elem)
      (match lifetime
        [(No)
          (if (tc-elided-lifetime? name)
            (Err
              (tc-kind-message
                (LifetimeMismatch)
                "typecheck: elided reference return is ambiguous; write an explicit lifetime"))
            (let
              [inner : TcElidedType
                (try
                  (tc-elide-output-type
                    type-bases
                    (ast.ast-type-segment-bases-get type-bases elem)
                    lifetime))]
              (Ok (TcElidedType (ast.ast-ty-mut-ref name (& inner.ty)) 0))))]
        [(Some source)
          (let
            [inner : TcElidedType
              (try
                (tc-elide-output-type
                  type-bases
                  (ast.ast-type-segment-bases-get type-bases elem)
                  lifetime))]
            (Ok
              (TcElidedType
                (ast.ast-ty-mut-ref
                  (if (tc-elided-lifetime? name)
                    source
                    name)
                  (& inner.ty))
                0)))])]
    [_ (Ok (TcElidedType ty 0))]))

(define (tc-elide-input-params-at
  [type-bases : i64]
  [params : (& params ast.AstParamList)]
  [offset : i64]
  [index : i64]
  [out : ast.AstParamList]) : ResultTcElidedParams
  (if (>= offset (ast.ast-param-list-len params))
    (Ok (TcElidedParams out index))
    (match (ast.ast-param-list-get params offset (ast.ast-param-fallback))
      [(Param name ty is-comptime)
        (let
          [item : TcElidedType (try (tc-elide-input-type type-bases ty index))]
          [next-out : ast.AstParamList out]
          (ast.ast-param-list-push
            (&mut next-out)
            (ast.ast-param-id name item.ty is-comptime))
          (tc-elide-input-params-at
            type-bases
            params
            (+ offset 1)
            item.next-index
            next-out))])))

(define (tc-elided-param-type-list [params : (& params ast.AstParamList)]) : ast.AstTypeList
  (tc-elided-param-type-list-at (& params) 0))

(define (tc-elided-param-type-list-at
  [params : (& params ast.AstParamList)]
  [index : i64]) : ast.AstTypeList
  (if (>= index (ast.ast-param-list-len params))
    (ast.ast-type-list-new)
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param _ ty _)
        (ast.ast-type-cons
          (& ty)
          (& (tc-elided-param-type-list-at params (+ index 1))))])))

(define (tc-elide-function-signature
  [type-bases : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]) : ResultTcElidedSignature
  (let
    [inputs : TcElidedParams
      (try
        (tc-elide-input-params-at
          type-bases
          (& params)
          0
          0
          (ast.ast-param-list-with-capacity (ast.ast-param-list-len (& params)))))]
    [input-params : ast.AstParamList inputs.params]
    [input-types : ast.AstTypeList (tc-elided-param-type-list input-params)]
    [lifetime : TcMaybeNameId
      (tc-signature-single-input-lifetime type-bases input-types)]
    [output : TcElidedType (try (tc-elide-output-type type-bases ret lifetime))]
    (Ok (TcElidedSignature input-params output.ty))))

(define (tc-type-list-collect-reference-lifetimes
  [types : ast.AstTypeList]
  [out : TcNameIdList]) : TcNameIdList
  (tc-type-list-collect-reference-lifetimes-at (& types) out 0))

(define (tc-type-list-collect-reference-lifetimes-at
  [types : (& types ast.AstTypeList)]
  [out : TcNameIdList]
  [index : i64]) : TcNameIdList
  (if (>= index (ast.ast-type-list-len types))
    out
    (tc-type-list-collect-reference-lifetimes-at
      types
      (tc-type-collect-reference-lifetimes-into
        (ast.ty-node-get
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))
        out)
      (+ index 1))))

(define (tc-type-collect-reference-lifetimes-into
  [ty : ast.AstType]
  [out : TcNameIdList]) : TcNameIdList
  (match ty
    [(Func args ret)
      (tc-type-collect-reference-lifetimes-into
        (ast.ty-node-get ret)
        (tc-type-list-collect-reference-lifetimes
          (ast.ast-type-list-box-shared-view args)
          out))]
    [(Tuple elems)
      (tc-type-list-collect-reference-lifetimes
        (ast.ast-type-list-box-shared-view elems)
        out)]
    [(or (Array elem _) (DynArray elem) (Slice elem) (Box elem) (Ptr elem)
         (MutPtr elem) (Region _ elem))
      (tc-type-collect-reference-lifetimes-into (ast.ty-node-get elem) out)]
    [(or (Ref lifetime inner) (MutRef lifetime inner)
         (Invalidate lifetime inner))
      (tc-type-collect-reference-lifetimes-into
        (ast.ty-node-get inner)
        (tc-name-id-list-add out lifetime))]
    [(or (EnumArgs _ lifetimes) (StructArgs _ lifetimes) (VarArgs _ lifetimes))
      (tc-lifetime-list-to-name-id-list-into (deref lifetimes) out)]
    [_ out]))

(define (tc-type-collect-reference-lifetimes [ty : ast.AstType]) : TcNameIdList
  (tc-type-collect-reference-lifetimes-into ty Nil))

(define (tc-maybe-type-contains-reference? [maybe-ty : ast.AstMaybeType]) : bool
  (match maybe-ty
    [(No) false]
    [(Some ty) (tc-type-contains-reference? ty)]))

(define (tc-param-list-reference-return-lifetimes-into
  [ctx : TcContext]
  [params : ast.AstParamList]
  [out : TcNameIdList]) : TcNameIdList
  (tc-param-list-reference-return-lifetimes-at ctx (& params) 0 out))

(define (tc-param-list-reference-return-lifetimes-at
  [ctx : TcContext]
  [params : (& params ast.AstParamList)]
  [index : i64]
  [out : TcNameIdList]) : TcNameIdList
  (if (>= index (ast.ast-param-list-len params))
    out
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param _ ty _)
        (tc-param-list-reference-return-lifetimes-at
          ctx
          params
          (+ index 1)
          (tc-type-collect-reference-lifetimes-into
            (tc-resolve-type ctx ty)
            out))])))

;; The first lifetime of `ret` that names a parameter but no lifetime of the
;; parameter types, or -1. A borrow of a by-value parameter takes the
;; parameter's name as its lifetime (SPEC 3.10 lifetime name selection), but
;; the parameter's storage belongs to the call: a reference to it cannot be
;; returned (Rust E0515).
(define (tc-reference-return-parameter-lifetime
  [ctx : TcContext]
  [params : ast.AstParamList]
  [ret : ast.AstType]) : i64
  (let
    [allowed : TcNameIdList
      (tc-param-list-reference-return-lifetimes-into
        ctx
        (tc-global-shared-view params)
        Nil)]
    [cursor : TcNameIdList
      (tc-type-collect-reference-lifetimes (tc-resolve-type ctx ret))]
    [found : i64 -1]
    (while (and (< found 0) (not (tc-name-id-list-empty? cursor)))
      (let
        [lifetime : i64 (tc-name-id-list-head cursor)]
        (when
          (and
            (not (tc-name-id-list-contains allowed lifetime))
            (tc-param-list-has-name? (& params) lifetime 0))
          (set! found lifetime)))
      (set! cursor (tc-name-id-list-rest cursor)))
    found))

(define (tc-param-list-has-name?
  [params : (& params ast.AstParamList)]
  [name-id : i64]
  [index : i64]) : bool
  (cond
    [(>= index (ast.ast-param-list-len params)) false]
    [(match (ast.ast-param-list-get params index (ast.ast-param-fallback))
        [(Param name _ _) (= name name-id)])
      true]
    [else (tc-param-list-has-name? params name-id (+ index 1))]))

;: The reserved `program` lifetime, which outlives every other lifetime.
(define (tc-program-lifetime-id? [lifetime-id : i64]) : bool
  (and
    (>= lifetime-id 0)
    (ci.intern-renderable-id? lifetime-id)
    (string.eq (ci.intern-str lifetime-id) "program")))

;: The list without the reserved `program` lifetime (itself when it has none).
(define (tc-name-id-list-without-program [items : TcNameIdList]) : TcNameIdList
  (if (tc-name-id-list-spells-program? items)
    (let
      [out : TcNameIdList Nil]
      [rest : TcNameIdList items]
      (while (not (tc-name-id-list-empty? rest))
        (let
          [lifetime : i64 (tc-name-id-list-head rest)]
          (unless
            (tc-program-lifetime-id? lifetime)
            (set! out (tc-name-id-list-add out lifetime))))
        (set! rest (tc-name-id-list-rest rest)))
      out)
    items))

(define (tc-name-id-list-spells-program? [items : TcNameIdList]) : bool
  (let
    [cursor : TcNameIdList items]
    [found : bool false]
    (while (and (not found) (not (tc-name-id-list-empty? cursor)))
      (when
        (tc-program-lifetime-id? (tc-name-id-list-head cursor))
        (set! found true))
      (set! cursor (tc-name-id-list-rest cursor)))
    found))

;; A parameter of the declared callee with symbol index `key` spelled
;; `program` names its own lifetime in the signature, as any parameter named
;; like a lifetime does, shadowing the reserved one
;; (`tc-signature-lifetime-needs-marker?`): that name, or -1. A function
;; value's type names no parameters, so its `program` is the reserved one.
(define (tc-call-program-shadow [ctx : TcContext] [key : i64] [count : i64]) : i64
  (let
    [index : i64 0]
    [found : i64 -1]
    (while (and (< found 0) (< index count))
      (match (match (csym.compiler-symbols-decl-at-index
        (tc-context-symbols ctx)
        key)
        [(Ok declared) (tc-call-decl-param-name-at declared index)]
        [(Err _) TcMaybeNameId.No])
        [(TcMaybeNameId.Some name)
          (when (tc-program-lifetime-id? name) (set! found name))]
        [(TcMaybeNameId.No) unit])
      (set! index (+ index 1)))
    found))

;; The signature a call publishes for the ownership graph, where a `program`
;; lifetime is the reserved one (`normalize-region-edges`): a shadowing
;; parameter's own `program` is renamed to a hidden lifetime.
(define (tc-call-published-signature [shadow : i64] [fn-ty : ast.AstType]) : ast.AstType
  (if (< shadow 0)
    fn-ty
    (tc-lifetime-subst-type
      (tc-lifetime-subst-push
        TcLifetimeSubst.Nil
        shadow
        cbi.compiler-builtin-id-fix-empty)
      fn-ty)))

;; A returned reference lifetime must be tied to an input parameter or be the
;; reserved `program` lifetime (SPEC 3.10, lifetime-parameterized aggregates).
(define (tc-reference-return-lifetimes-allowed?
  [ctx : TcContext]
  [params : ast.AstParamList]
  [ret : ast.AstType]) : bool
  (let
    [allowed : TcNameIdList
      (tc-param-list-reference-return-lifetimes-into ctx params Nil)]
    [cursor : TcNameIdList
      (tc-type-collect-reference-lifetimes (tc-resolve-type ctx ret))]
    [ok : bool true]
    (while (and ok (not (tc-name-id-list-empty? cursor)))
      (let
        [lifetime : i64 (tc-name-id-list-head cursor)]
        (unless
          (or
            (tc-program-lifetime-id? lifetime)
            (tc-name-id-list-contains allowed lifetime))
          (set! ok false)))
      (set! cursor (tc-name-id-list-rest cursor)))
    ok))

(define (tc-reference-return-policy-ok
  [ctx : TcContext]
  [params : ast.AstParamList]
  [ret : ast.AstType]) : ResultTcUnit
  (if (tc-type-contains-reference?
    (tc-resolve-type ctx (tc-global-shared-view ret)))
    (let
      [parameter : i64
        (tc-reference-return-parameter-lifetime
          ctx
          (tc-global-shared-view params)
          (tc-global-shared-view ret))]
      (cond
        [(tc-reference-return-lifetimes-allowed? ctx params ret) Ok]
        [(>= parameter 0)
          (Err
            (tc-kind-message
              (LifetimeMismatch)
              (str_cat.str-cat
                "typecheck: returned reference lifetime `"
                (ci.intern-str parameter)
                "` is a by-value parameter's own storage, which does not outlive the call; return a reference derived from a reference parameter")))]
        [else
          (Err
            (tc-kind-message
              (LifetimeMismatch)
              "typecheck: returned reference lifetime must be tied to a parameter"))]))
    Ok))

(define (tc-type-list-collect-regions
  [types : ast.AstTypeList]
  [out : TcNameIdList]) : TcNameIdList
  (tc-type-list-collect-regions-at (& types) out 0))

(define (tc-type-list-collect-regions-at
  [types : (& types ast.AstTypeList)]
  [out : TcNameIdList]
  [index : i64]) : TcNameIdList
  (if (>= index (ast.ast-type-list-len types))
    out
    (tc-type-list-collect-regions-at
      types
      (tc-type-collect-regions-into
        (ast.ty-node-get
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))
        out)
      (+ index 1))))

(define (tc-type-collect-regions-into [ty : ast.AstType] [out : TcNameIdList]) : TcNameIdList
  (match ty
    [(Func args ret)
      (tc-type-collect-regions-into
        (ast.ty-node-get ret)
        (tc-type-list-collect-regions
          (ast.ast-type-list-box-shared-view args)
          out))]
    [(Tuple elems)
      (tc-type-list-collect-regions
        (ast.ast-type-list-box-shared-view elems)
        out)]
    [(or (Array elem _) (DynArray elem) (Slice elem) (Box elem) (Ptr elem)
         (MutPtr elem))
      (tc-type-collect-regions-into (ast.ty-node-get elem) out)]
    [(or (Ref name inner) (MutRef name inner) (Region name inner)
         (Invalidate name inner))
      (tc-type-collect-regions-into
        (ast.ty-node-get inner)
        (tc-name-id-list-add out name))]
    [(or (EnumArgs _ lifetimes) (StructArgs _ lifetimes) (VarArgs _ lifetimes))
      (tc-lifetime-list-to-name-id-list-into (deref lifetimes) out)]
    [_ out]))

(define (tc-type-collect-regions [ty : ast.AstType]) : TcNameIdList
  (tc-type-collect-regions-into ty Nil))

(define (tc-region-list-contains-arena-owner?
  [env : TcTypeEnv]
  [regions : TcNameIdList]
  [owner : i64]) : bool
  (let
    [cursor : TcNameIdList regions]
    [found : bool false]
    (while (and (not found) (not (tc-name-id-list-empty? cursor)))
      (if (tc-arena-region-owned-by-id? env owner (tc-name-id-list-head cursor))
        (set! found true)
        unit)
      (set! cursor (tc-name-id-list-rest cursor)))
    found))

(define (tc-type-contains-arena-owner-region?
  [env : TcTypeEnv]
  [ty : ast.AstType]
  [owner : i64]) : bool
  (tc-region-list-contains-arena-owner? env (tc-type-collect-regions ty) owner))

(define (tc-region-list-all-atomic-arena-owners?
  [env : TcTypeEnv]
  [regions : TcNameIdList]) : bool
  (let
    [cursor : TcNameIdList regions]
    [all-atomic : bool true]
    (while (and all-atomic (not (tc-name-id-list-empty? cursor)))
      (if (tc-atomic-arena-owner-active-id? env (tc-name-id-list-head cursor))
        unit
        (set! all-atomic false))
      (set! cursor (tc-name-id-list-rest cursor)))
    all-atomic))

(define (tc-type-regions-all-atomic-arena-owners?
  [env : TcTypeEnv]
  [ty : ast.AstType]) : bool
  (tc-region-list-all-atomic-arena-owners? env (tc-type-collect-regions ty)))

(define (tc-type-outer-region [ty : ast.AstType]) : TcMaybeNameId
  (match ty
    [(Region region _) (Some region)]
    [_ (No)]))

(define (tc-type-outer-regions [ty : ast.AstType]) : TcNameIdList
  (match ty
    [(Region region inner)
      (tc-name-id-list-add
        (tc-type-outer-regions (ast.ty-node-get inner))
        region)]
    [_ Nil]))

(define (tc-region-taggable-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(or (String) (DynArray _) (Box _) (Tuple _) (Struct _) (StructArgs _ _)
         (Enum _) (EnumArgs _ _))
      true]
    [(Slice _) false]
    [_ false]))

(define (tc-tag-region [region : i64] [ty : ast.AstType]) : ast.AstType
  (if (tc-region-taggable-type? (tc-global-shared-view ty))
    (ast.ast-ty-region region (& ty))
    ty))

(define (tc-tag-active-region [env : TcTypeEnv] [ty : ast.AstType]) : ast.AstType
  (match (tc-active-region env)
    [(Some region) (tc-tag-region region ty)]
    [(No) ty]))

;; Nominal aggregate types have no lifetime-argument surface yet. Until they do,
;; constructor results carry stored-reference lifetimes as local region facts so
;; existing flow/escape checks can reject boundary escapes.
(define (tc-tag-reference-lifetimes
  [lifetimes : TcNameIdList]
  [ty : ast.AstType]) : ast.AstType
  (if (tc-name-id-list-empty? lifetimes)
    ty
    (tc-tag-region
      (tc-name-id-list-head lifetimes)
      (tc-tag-reference-lifetimes (tc-name-id-list-rest lifetimes) ty))))

;; The reserved `program` lifetime confines no value (it outlives every
;; region), so a field's `program` reference tags nothing.
(define (tc-constructor-target-type
  [env : TcTypeEnv]
  [params : ast.AstTypeList]
  [ret : ast.AstType]) : ast.AstType
  (tc-tag-active-region
    env
    (tc-tag-reference-lifetimes
      (tc-name-id-list-without-program
        (tc-type-list-collect-reference-lifetimes params Nil))
      ret)))

(define (tc-project-from-region-container
  [container-ty : ast.AstType]
  [projected-ty : ast.AstType]) : ast.AstType
  (match (tc-type-outer-region (tc-global-shared-view container-ty))
    [(Some region) (tc-tag-region region projected-ty)]
    [(No)
      (match (tc-type-strip-region container-ty)
        [(or (Ref region _) (MutRef region _))
          (tc-tag-region region projected-ty)]
        [_ projected-ty])]))

;; Arena selection does not make an input lifetime younger. Retain the arena
;; scope proof for aggregate storage, and order an activated local home at its
;; owner rather than at the activation. Distinct generated brands stay invariant.
(define (tc-region-outlives-or-matches-scan
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [value-region : i64]
  [target-region : i64]) : bool
  (match (tc-type-env-view env)
    [(Nil) false]
    [(Cache _ scan-through _ rest _)
      (and
        scan-through
        (tc-region-outlives-or-matches-scan
          root
          rest
          value-region
          target-region))]
    [(Bind key ty rest)
      (if (and
        (= key (tc-region-marker-id))
        (match ty
          [(or (Var region) (Region region _))
            (or (= region value-region) (= region target-region))]
          [_ false]))
        (match ty
          [(or (Var region) (Region region _))
            (and
              (= region target-region)
              (tc-lifetime-outlives-lifetime-id?
                root
                value-region
                target-region))]
          [_ false])
        (tc-region-outlives-or-matches-scan
          root
          rest
          value-region
          target-region))]))

(define (tc-region-outlives-or-matches
  [env : TcTypeEnv]
  [value-region : i64]
  [target-region : i64]) : bool
  (cond
    [(= value-region target-region) true]
    [(and
        (tc-generated-arena-brand-id? value-region)
        (tc-generated-arena-brand-id? target-region))
      false]
    [else
      (begin
        (cfg compile-profile (counters.bump! tc-profile-env-marker-scans))
        (match (tc-type-env-view env)
          [(Cache _ _ _ rest _)
            (tc-region-outlives-or-matches-scan
              env
              rest
              value-region
              target-region)]
          [_
            (tc-region-outlives-or-matches-scan
              env
              env
              value-region
              target-region)]))]))

(define (tc-region-can-flow-into-any
  [env : TcTypeEnv]
  [value-region : i64]
  [target-regions : TcNameIdList]) : bool
  (let
    [cursor : TcNameIdList target-regions]
    [found : bool false]
    (while (and (not found) (not (tc-name-id-list-empty? cursor)))
      (if (tc-region-outlives-or-matches
        env
        value-region
        (tc-name-id-list-head cursor))
        (set! found true)
        unit)
      (set! cursor (tc-name-id-list-rest cursor)))
    found))

;; Whether every value region flows into some target region. Each admitted
;; flow between distinct regions is recorded (`tc-admitted-edge-note!`).
(define (tc-region-list-admit!
  [env : TcTypeEnv]
  [value-regions : TcNameIdList]
  [target-regions : TcNameIdList]) : bool
  (let
    [cursor : TcNameIdList value-regions]
    [can-flow : bool true]
    (while (and can-flow (not (tc-name-id-list-empty? cursor)))
      (let
        [from : i64 (tc-name-id-list-head cursor)]
        [targets : TcNameIdList target-regions]
        [found : bool false]
        (while (not (tc-name-id-list-empty? targets))
          (let
            [to : i64 (tc-name-id-list-head targets)]
            (when
              (tc-region-outlives-or-matches env from to)
              (set! found true)
              (when
                (and
                  (> env.abi-pad 0)
                  (!= from to)
                  (not (tc-program-lifetime-id? to)))
                (tc-admitted-edge-note! (tc-type-env-scoped-state env) from to))))
          (set! targets (tc-name-id-list-rest targets)))
        (unless found (set! can-flow false)))
      (set! cursor (tc-name-id-list-rest cursor)))
    can-flow))

(define (tc-ensure-region-value-can-flow-into
  [env : TcTypeEnv]
  [target-ty : ast.AstType]
  [value-ty : ast.AstType]
  [context : String]) : ResultTcUnit
  (tc-ensure-regions-can-flow-into
    env
    target-ty
    (tc-type-collect-regions value-ty)
    context))

(define (tc-ensure-regions-can-flow-into
  [env : TcTypeEnv]
  [target-ty : ast.AstType]
  [regions : TcNameIdList]
  [context : String]) : ResultTcUnit
  (let
    ;; `program` outlives every target, so only shorter regions can escape.
    [value-regions : TcNameIdList (tc-name-id-list-without-program regions)]
    (match value-regions
      [(Nil) Ok]
      [_
        (let
          [target-regions : TcNameIdList
            (tc-type-collect-regions (tc-global-shared-view target-ty))]
          (if (and
            (tc-type-contains-any-region target-ty)
            (tc-region-list-admit! env value-regions target-regions))
            Ok
            (Err (tc-region-store-escape-error context))))])))

;; Store admission records each region flow it admits, a value of region
;; `from` into a container of region `to`, so that an arena's end can end what
;; those stores reached (`tc-admitted-fed-regions`, #9445). The pairs live in
;; the job's scoped state reached through the environment, like the
;; suggestion depth, and each checked function body sees only its own
;; (`tc-check-fn-decl-body`).
(define tc-admitted-edges-initial-capacity : i64
  64)

(define (tc-admitted-edges [state : TcTypeEnvScopedState]) : (__tl_dyn-array
    i64)
  (tc-type-env-scoped-state-field state admitted-edges (__tl_dyn-array i64)))

(define (tc-admitted-count [state : TcTypeEnvScopedState]) : i64
  (tc-type-env-scoped-state-field state admitted-count i64))

(define (tc-admitted-start [state : TcTypeEnvScopedState]) : i64
  (tc-type-env-scoped-state-field state admitted-start i64))

(define (tc-admitted-edges-set!
  [state : TcTypeEnvScopedState]
  [edges : (__tl_dyn-array i64)]) : unit
  (unsafe
    (ptr-write!
      (ptr-cast
        (ptr-offset
          (int->ptr (cast state.address : u64) : (Ptr u8))
          (comptime (offset-of (type TcTypeEnvScopedStateData) admitted-edges)))
        : (MutPtr (__tl_dyn-array i64)))
      edges)))

(define (tc-admitted-count-set! [state : TcTypeEnvScopedState] [count : i64]) : unit
  (unsafe
    (ptr-write!
      (ptr-cast
        (ptr-offset
          (int->ptr (cast state.address : u64) : (Ptr u8))
          (comptime (offset-of (type TcTypeEnvScopedStateData) admitted-count)))
        : (MutPtr i64))
      count)))

(define (tc-admitted-start-set! [state : TcTypeEnvScopedState] [start : i64]) : unit
  (unsafe
    (ptr-write!
      (ptr-cast
        (ptr-offset
          (int->ptr (cast state.address : u64) : (Ptr u8))
          (comptime (offset-of (type TcTypeEnvScopedStateData) admitted-start)))
        : (MutPtr i64))
      start)))

(define (tc-admitted-edge-note!
  [state : TcTypeEnvScopedState]
  [from : i64]
  [to : i64]) : unit
  (let
    [edges : (__tl_dyn-array i64) (tc-admitted-edges state)]
    [count : i64 (tc-admitted-count state)]
    [start : i64 (tc-admitted-start state)]
    [at : i64 (- count 1)]
    [found : bool false]
    [marked? : bool false]
    ;; A store is recorded again after a later phase mark, which a rewind of
    ;; that phase reads from (`tc-admitted-fed-regions`).
    (while (and (not found) (not marked?) (>= at start))
      (cond
        [(and
            (= (array-ref edges (* at 2)) from)
            (= (array-ref edges (+ (* at 2) 1)) to))
          (set! found true)]
        [(and (>= to 0) (< (array-ref edges (+ (* at 2) 1)) 0))
          (set! marked? true)]
        [else unit])
      (set! at (- at 1)))
    (unless
      found
      (when
        (> (* (+ count 1) 2) (array-length edges))
        (let
          [grown : (__tl_dyn-array i64)
            (in-arena
              (unsafe
                (arena.Arena
                  (tc-type-env-scoped-state-field state owner-arena i64)))
              (__tl_make-array i64 (* 2 (array-length edges))))]
          [index : i64 0]
          (while (< index (* count 2))
            (set! (array-ref grown index) (array-ref edges index))
            (set! index (+ index 1)))
          (tc-admitted-edges-set! state grown)))
      (let
        [slots : (__tl_dyn-array i64) (tc-admitted-edges state)]
        (set! (array-ref slots (* count 2)) from)
        (set! (array-ref slots (+ (* count 2) 1)) to))
      (tc-admitted-count-set! state (+ count 1)))))

(define (tc-region-store-escape-error [context : String]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (RegionEscape))
    "typecheck: cannot store region-tagged value into "
    context
    "; region value would escape"))

(define (tc-resolve-type-list [ctx : TcContext] [types : ast.AstTypeList]) : ast.AstTypeList
  (let
    [pools : ast.AstNodePoolContext (tc-context-type-resolution-pools ctx)]
    (if (tc-type-list-needs-resolution-for-job-and-pools?
      (tc-context-job-state ctx)
      pools
      (ast.ast-node-pool-context-type-segment-bases pools)
      types)
      (let
        [count : i64 (ast.ast-type-list-len (& types))]
        [out : ast.AstTypeList (ast.ast-type-list-with-capacity count)]
        ;; The source list is immutable. Reserve once instead of copying each
        ;; suffix; children retain the resolver's existing reader/pusher owner.
        (for [index (iterator.range 0 count)]
          (ast.ast-type-list-push
            (&mut out)
            (ast.ast-node-pool-reader-type-push
              (&
                (tc-resolve-type
                  ctx
                  (ast.ty-node-get
                    (ast.ast-type-list-get
                      (& types)
                      index
                      (ast.ast-type-id-fallback))))))))
        out)
      types)))

;; Per-type-node memo for the resolution predicate: type nodes are immutable
;; and hash-consed, so the answer is a pure function of the node id within one
;; pool owner. One slot packs the owning job's fill epoch with the answer bit;
;; rebinding or resetting only that job advances its epoch. Fixed storage is
;; allocated lazily in the job owner arena, and ids beyond it fall back to the
;; uncached walk over the same explicitly bound segment table.
(define tc-type-resolution-cache-capacity : i64
  131072)

(define (tc-type-resolution-cache-storage-ensure-for-state!
  [state : TcTypeResolutionCacheState]) : unit
  (let
    [data : (MutPtr TcTypeResolutionCacheStateData)
      (tc-type-resolution-cache-state-ptr state)]
    (unsafe
      (if (=
        (array-length (deref data).slots)
        tc-type-resolution-cache-capacity)
        unit
        (in-arena
          (arena.Arena (deref data).owner-arena)
          (set!
            (deref data).slots
            (__tl_make-array i64 tc-type-resolution-cache-capacity)))))))

(define (tc-type-needs-resolution-storage-ensure-for-job!
  [job-state : TcJobState]) : unit
  (tc-type-resolution-cache-storage-ensure-for-state!
    (tc-job-state-type-resolution-cache job-state)))

(define (tc-type-resolution-cache-bind!
  [state : TcTypeResolutionCacheState]
  [type-pool-owner-id : i64]
  [type-segment-bases : i64]) : unit
  (let
    [data : (MutPtr TcTypeResolutionCacheStateData)
      (tc-type-resolution-cache-state-ptr state)]
    (unsafe
      (unless
        (and
          (= (deref data).type-pool-owner-id type-pool-owner-id)
          (= (deref data).type-segment-bases type-segment-bases))
        (set! (deref data).epoch (+ (deref data).epoch 1))
        (set! (deref data).type-pool-owner-id type-pool-owner-id)
        (set! (deref data).type-segment-bases type-segment-bases)))))

(define (tc-type-resolution-cache-bind-pools-for-job!
  [job-state : TcJobState]
  [pools : ast.AstNodePoolContext]) : unit
  (tc-type-resolution-cache-bind!
    (tc-job-state-type-resolution-cache job-state)
    (ast.ast-node-pool-context-type-cell-address pools)
    (ast.ast-node-pool-context-type-segment-bases pools)))

(define (tc-type-resolution-cache-bind-active-for-state!
  [state : TcTypeResolutionCacheState]) : unit
  (let
    [type-segment-bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    (tc-type-resolution-cache-bind! state type-segment-bases type-segment-bases)))

(define (tc-type-resolution-cache-ensure-bound-for-state!
  [state : TcTypeResolutionCacheState]) : unit
  (if (=
    (unsafe
      (deref (tc-type-resolution-cache-state-view state)).type-segment-bases)
    0)
    (tc-type-resolution-cache-bind-active-for-state! state)
    unit))

(define (tc-type-list-needs-resolution-for-state?
  [state : TcTypeResolutionCacheState]
  [types : (& ast.AstTypeList)]) : bool
  (tc-type-list-needs-resolution-at-for-state? state types 0))

(define (tc-type-list-needs-resolution-at-for-state?
  [state : TcTypeResolutionCacheState]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    false
    (if (tc-type-needs-resolution-id-for-state?
      state
      (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))
      true
      (tc-type-list-needs-resolution-at-for-state? state types (+ index 1)))))

(define (tc-type-needs-resolution-id-for-state?
  [state : TcTypeResolutionCacheState]
  [ty-id : i64]) : bool
  (tc-type-resolution-cache-storage-ensure-for-state! state)
  (let
    [data : TcTypeResolutionCacheStateData
      (tc-type-resolution-cache-state-data state)]
    (when
      (>= ty-id (array-length data.slots))
      (return
        (tc-type-needs-resolution-for-state?
          state
          (ast.ast-type-segment-bases-get data.type-segment-bases ty-id))))
    (let
      [slot : i64 (array-ref data.slots ty-id)]
      (if (= (shr slot 1) data.epoch)
        (= (bit-and slot 1) 1)
        (let
          [answer : bool
            (tc-type-needs-resolution-for-state?
              state
              (ast.ast-type-segment-bases-get data.type-segment-bases ty-id))]
          (set!
            (array-ref data.slots ty-id)
            (bit-or
              (shl data.epoch 1)
              (if answer
                1
                0)))
          answer)))))

(define (tc-type-needs-resolution-for-state?
  [state : TcTypeResolutionCacheState]
  [ty : ast.AstType]) : bool
  (match ty
    [(Func args ret)
      (if (tc-type-list-needs-resolution-for-state?
        state
        (& (ast.ast-type-list-box-shared-view args)))
        true
        (tc-type-needs-resolution-id-for-state? state ret))]
    [(Tuple elems)
      (tc-type-list-needs-resolution-for-state?
        state
        (& (ast.ast-type-list-box-shared-view elems)))]
    [(or (Array elem _) (DynArray elem) (Slice elem) (Box elem) (CFunc elem _)
         (Ptr elem) (MutPtr elem) (Ref _ elem) (MutRef _ elem) (Region _ elem)
         (Invalidate _ elem))
      (tc-type-needs-resolution-id-for-state? state elem)]
    [(or (VarArgs _ _) (Var _)) true]
    [_ false]))

(define (tc-type-list-needs-resolution-for-job-and-pools?
  [job-state : TcJobState]
  [pools : ast.AstNodePoolContext]
  [type-bases : i64]
  [types : (& ast.AstTypeList)]) : bool
  (let
    [state : TcTypeResolutionCacheState
      (tc-job-state-type-resolution-cache job-state)]
    (tc-type-resolution-cache-bind!
      state
      (ast.ast-node-pool-context-type-cell-address pools)
      type-bases)
    (tc-type-list-needs-resolution-for-state? state types)))

(define (tc-type-needs-resolution-for-job-and-pools?
  [job-state : TcJobState]
  [pools : ast.AstNodePoolContext]
  [type-bases : i64]
  [ty : ast.AstType]) : bool
  (let
    [state : TcTypeResolutionCacheState
      (tc-job-state-type-resolution-cache job-state)]
    (tc-type-resolution-cache-bind!
      state
      (ast.ast-node-pool-context-type-cell-address pools)
      type-bases)
    (tc-type-needs-resolution-for-state? state ty)))

(define (tc-type-needs-resolution-for-context?
  [ctx : TcContext]
  [ty : ast.AstType]) : bool
  (let
    [pools : ast.AstNodePoolContext (tc-context-type-resolution-pools ctx)]
    [type-bases : i64 (ast.ast-node-pool-context-type-segment-bases pools)]
    (tc-type-needs-resolution-for-job-and-pools?
      (tc-context-job-state ctx)
      pools
      type-bases
      ty)))

;; The ordinary resolver reads and appends through the installed reader rather
;; than through an explicit `AstNodePoolContext`. Bind the job-owned memo to
;; that reader's segment table directly: selecting and copying a pool context
;; for every composite type would cost more than the rebuilds this predicate
;; avoids. Reader segment tables are stable across pool growth, and rebinding
;; advances only this job's cache epoch when a compatibility caller swaps the
;; installed reader.
(define (tc-type-needs-resolution-for-reader-context?
  [ctx : TcContext]
  [ty : ast.AstType]) : bool
  (let
    [state : TcTypeResolutionCacheState
      (tc-job-state-type-resolution-cache (tc-context-job-state ctx))]
    (tc-type-resolution-cache-bind-active-for-state! state)
    (tc-type-needs-resolution-for-state? state ty)))

;; id-keyed variant: reads the O(1) precomputed "contains-'/'" metadata slot
;; instead of re-hashing the name. The hygiene check needs the string, which
;; intern-str recovers in O(1). `tc-name-qualified? name` ==
;; `tc-name-qualified-id? (intern name)`, so threading the already-interned id
;; from callers is semantics-preserving and skips the hash. Refs #4427.
(define (tc-name-first-dot-id
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : i64
  ;; Ids inside the intern pool range are the common case and can never be
  ;; structural/hygiene ids (every structural family's base is >= stride^2),
  ;; so dispatch on the pool range first and keep the layered predicate
  ;; checks for the out-of-pool families only.
  (if (and (>= name-id 0) (< name-id (ci.intern-capacity)))
    (ci.intern-first-dot name-id)
    (if (or
      (macro-hygiene-global-id? session name-id)
      (tc-structural-local-name-id? session name-id))
      (ci.intern-first-dot
        (macro-hygiene-global-source-name-id-or session name-id name-id))
      -1)))

(define (tc-name-qualified-id?
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : bool
  (if (and (>= name-id 0) (< name-id (ci.intern-capacity)))
    (and
      (or
        (< name-id (ci.intern-pool-len))
        (not (ci.intern-macro-local-name-id? name-id)))
      (ci.intern-qualified? name-id))
    (cond
      [(< name-id 0) false]
      [(< name-id (ci.intern-structural-key-base)) false]
      [else
        ;; Qualified checks only need a table record's tag in the common
        ;; pair/triple case. Hygienic globals are rarer and reopen their typed
        ;; record only when the tag says its module lane is relevant.
        (let
          [kind : i64
            (cis.intern-structural-session-record-kind-for-structural-or
              session
              name-id
              -1)]
          (cond
            [(or
                (= kind (ci.intern-structural-kind-fresh-local))
                (= kind (ci.intern-structural-kind-macro-local)))
              false]
            [(= kind (ci.intern-structural-kind-macro-global))
              (match (cis.intern-structural-session-macro-global-record-for-raw
                session
                name-id)
                [(Some record)
                  (not
                    (csym.compiler-symbol-root-module-id?
                      record.definition-module-id))]
                [(No) false])]
            [else
              (or
                (= kind (ci.intern-structural-kind-pair))
                (= kind (ci.intern-structural-kind-triple)))]))])))

(define (tc-qualified-name-module-id [name-id : i64]) : i64
  (cond
    [(and
        (>= name-id 0)
        (< name-id (ci.intern-capacity))
        (ci.intern-qualified? name-id))
      (ci.intern-qualified-module-id name-id)]
    [(and (>= name-id 0) (< name-id (ci.intern-capacity))) -1]
    [(csym.compiler-composite-triple-key-id? name-id)
      (csym.compiler-composite-triple-left-id name-id)]
    [(csym.compiler-composite-pair-key-id? name-id)
      (csym.compiler-composite-pair-left-id name-id)]
    [else -1]))

(define (tc-qualified-name-base-id [name-id : i64]) : i64
  (cond
    [(and
        (>= name-id 0)
        (< name-id (ci.intern-capacity))
        (ci.intern-qualified? name-id))
      (ci.intern-qualified-base-id name-id)]
    [(and (>= name-id 0) (< name-id (ci.intern-capacity))) name-id]
    [(csym.compiler-composite-triple-key-id? name-id)
      (csym.compiler-composite-pair-key-id
        (csym.compiler-composite-triple-middle-id name-id)
        (csym.compiler-composite-triple-right-id name-id))]
    [(csym.compiler-composite-pair-key-id? name-id)
      (csym.compiler-composite-pair-right-id name-id)]
    [else name-id]))

(define (tc-name-qualified? [name : (& name str)]) : bool
  (and
    (not (tc-hygiene-local-name? name))
    (>= (tc-qualified-name-last-slash name) 0)))

(define (tc-name-first-char [name : (& name str)] [needle : char]) : i64
  (let
    [n : i64 (string.string-length name)]
    (for [i (iterator.range 0 n)]
      (when (string.char-eq (string.string-ref name i) needle) (return i)))
    -1))

(define (tc-name-first-dot [name : (& name str)]) : i64
  (tc-name-first-char name '.'))

;; Variant taking the already-interned `name-id` so the hot name-resolution
;; path interns each name once and reads the slash position from the id-keyed
;; metadata instead of re-hashing the string. The hygiene checks stay on the
;; string (cheap prefix tests, no interning). Slash metadata is read directly
;; from the source identity carried by the AST.
(define (tc-source-slash-qualified-id?
  [session : cis.InternStructuralSessionHandle]
  [name : (& str)]
  [name-id : i64]) : bool
  (if (< name-id 0)
    false
    (let
      [source-name-id : i64
        (macro-hygiene-global-source-name-id-or session name-id name-id)]
      (if (not (tc-env-key-has-name-id? source-name-id))
        false
        (let
          [slash : i64 (ci.intern-qualified-last-slash source-name-id)]
          [n : i64 (string.string-length name)]
          (and
            (not (tc-hygiene-local-name-id? session name-id))
            (not (tc-hygiene-global-name-id? session name-id))
            (> slash 0)
            (< slash (- n 1))))))))

(define (tc-name-slashes-to-dots [name : String]) : String
  (let
    [n : i64 (string.string-length name)]
    [out : String ""]
    (for [i (iterator.range 0 n)]
      (let
        [chunk : String
          (if (string.char-eq (string.string-ref name i) '/')
            "."
            (string.substring name i 1))]
        (set! out (str_cat.str-cat out chunk ""))))
    out))

(define (tc-source-slash-qualified-message [name : String]) : String
  (str_cat.str-cat
    "typecheck: slash-qualified name "
    (string.copy (& name))
    " is no longer supported; use "
    (tc-name-slashes-to-dots name)))

;; Bootstrap bridge: published stage0 builds may still encounter legacy
;; slash-qualified core macro spellings. Keep this narrow until the seed no
;; longer needs the compatibility path.
(define (tc-source-legacy-core-macro-compat? [name : String]) : bool
  (if (tc-name-qualified? name)
    (let
      [module : String (tc-qualified-name-module (string.copy (& name)))]
      [base : String (tc-qualified-name-base name)]
      (and
        (string.eq module "core")
        (or
          (string.eq base "when")
          (string.eq base "unless")
          (string.eq base "and")
          (string.eq base "or")
          (string.eq base "cond"))))
    false))

(define (tc-source-name-bound-exact-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (let
    [key-id : i64
      (tc-env-name-key-id (tc-type-env-structural-session env) name-id)]
    (tc-name-bound-selected-id? env key-id key-id)))

(define (tc-current-module-source-lookup-key-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : TcMaybeNameId
  (let
    [module : String (tc-context-module ctx)]
    (if (and
      (> (string.string-length module) 0)
      (not (tc-name-qualified-id? (tc-context-structural-session ctx) name-id)))
      (let
        [module-key-id : i64
          (tc-module-name-id-by-id (tc-context-module-id ctx) name-id)]
        (if (tc-source-name-bound-exact-id? env module-key-id)
          (Some module-key-id)
          (No)))
      (No))))

(define (tc-current-module-source-lookup-key
  [ctx : TcContext]
  [env : TcTypeEnv]
  [_name : (& _name str)]
  [name-id : i64]) : TcMaybeString
  (match (tc-current-module-source-lookup-key-id ctx env name-id)
    [(Some key-id)
      (Some (tc-env-key-display (tc-context-structural-session ctx) key-id))]
    [(No) (No)]))

;; Dotted-local disambiguation compares binding ORDER in the raw source/local
;; key domain. Its callers deliberately pass the unnormalized `a.b` and `a`
;; ids: canonical top-env lookup happens only after this ordering decision.
;; Normalizing either key here would skip a raw local exact binding.
(define (tc-source-leading-segment-wins-over-exact-persistent-id?
  [env : TcTypeEnv]
  [name-id : i64]
  [prefix-id : i64]) : bool
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    (cond
      [(= head -1) false]
      [(< head -1)
        (let
          [node-addr : i64 (tc-type-env-cache-index head)]
          (if (>= (tc-chain-node-depth node-addr) 0)
            ;; Both keys resolve to their top-most binding at or below this
            ;; layer; the deeper-in-the-snapshot one is what the walk would
            ;; have met first, and a tie means one layer holds both.
            (let
              [prefix-ref : i64
                (tc-chain-resolve store-handle node-addr prefix-id)]
              [name-ref : i64 (tc-chain-resolve store-handle node-addr name-id)]
              (cond
                [(< prefix-ref 0) false]
                [(< name-ref 0) true]
                [else
                  (let
                    [prefix-addr : i64 (tc-chain-ref-addr prefix-ref)]
                    [name-addr : i64 (tc-chain-ref-addr name-ref)]
                    (if (= prefix-addr name-addr)
                      (<
                        (tc-chain-ref-slot prefix-ref)
                        (tc-chain-ref-slot name-ref))
                      (>
                        (tc-chain-node-depth prefix-addr)
                        (tc-chain-node-depth name-addr))))]))
            (let
              [cache : TcTypeEnvCache
                (tc-type-env-cache-at
                  (tc-type-env-cache-ptr store-handle node-addr))]
              [ids : tc_i64_i64_map.Map cache.ids]
              [prefix-index : i64
                (tc_i64_i64_map.get-value-or (& ids) prefix-id -1)]
              (if (>= prefix-index 0)
                (let
                  [name-index : i64
                    (tc_i64_i64_map.get-value-or (& ids) name-id -1)]
                  (if (>= name-index 0)
                    (< prefix-index name-index)
                    true))
                (if cache.partial
                  (if (>= (tc_i64_i64_map.get-value-or (& ids) name-id -1) 0)
                    false
                    (tc-source-leading-segment-wins-over-exact-persistent-id?
                      (TcTypeEnv store-handle cache.below env.abi-pad)
                      name-id
                      prefix-id))
                  false)))))]
      [else
        (let
          [binding-ptr : (Ptr TcTypeEnvBinding)
            (tc-type-env-binding-ptr store-handle head)]
          [key : i64 (tc-type-env-binding-name-at binding-ptr)]
          (if (= key name-id)
            false
            (if (= key prefix-id)
              true
              (tc-source-leading-segment-wins-over-exact-persistent-id?
                (TcTypeEnv
                  store-handle
                  (tc-type-env-binding-parent-at binding-ptr)
                  env.abi-pad)
                name-id
                prefix-id))))])))

;; The caller still supplies raw source/local keys; canonical top-env lookup is
;; downstream of this ordering decision. The scoped stack already indexes the
;; newest raw binding for each key. When either candidate is present, its
;; monotonically increasing slot index answers the ordering question without
;; rebuilding the persistent chain walk. If both miss, only the immutable
;; persistent tail can contain either key.
(define (tc-source-leading-segment-wins-over-exact-id?
  [env : TcTypeEnv]
  [name-id : i64]
  [prefix-id : i64]) : bool
  (if (tc-type-env-scoped-runtime-active? env)
    (let
      [carrier : TcTypeEnvScopedCarrier
        (tc-type-env-scoped-runtime-current env)]
      [name-index : i64
        (tc-type-env-scoped-carrier-lookup-index carrier name-id)]
      [prefix-index : i64
        (tc-type-env-scoped-carrier-lookup-index carrier prefix-id)]
      [scoped : bool
        (cond
          [(>= prefix-index 0)
            (if (>= name-index 0)
              (> prefix-index name-index)
              true)]
          [(>= name-index 0) false]
          [else
            (begin
              (cfg
                compile-profile
                (counters.bump! tc-profile-env-scoped-tail-fallbacks))
              (tc-source-leading-segment-wins-over-exact-persistent-id?
                (__tl-project-field
                  (__tl-project-field carrier sidecar)
                  persistent)
                name-id
                prefix-id))])]
      scoped)
    (tc-source-leading-segment-wins-over-exact-persistent-id?
      env
      name-id
      prefix-id)))

(define (tc-source-leading-segment-wins-over-exact-id-from-dot?
  [env : TcTypeEnv]
  [name-id : i64]
  [first-dot : i64]) : bool
  (if (or (<= first-dot 0) (< name-id 0) (>= name-id (ci.intern-capacity)))
    false
    (let
      [prefix-id : i64 (ci.intern-leading-dot-id name-id)]
      (if (< prefix-id 0)
        false
        (tc-source-leading-segment-wins-over-exact-id? env name-id prefix-id)))))

;; Variant taking the already-interned `name-id` to avoid re-hashing `name` on
;; the hot resolution path. The prefix comes from intern metadata recorded with
;; the first dot.
(define (tc-source-leading-segment-wins-over-exact-from-id?
  [env : TcTypeEnv]
  [_name : (& _name str)]
  [name-id : i64]
  [first-dot : i64]) : bool
  (if (or (<= first-dot 0) (< name-id 0) (>= name-id (ci.intern-capacity)))
    false
    (let
      [prefix-id : i64 (ci.intern-leading-dot-id name-id)]
      (if (< prefix-id 0)
        false
        (tc-source-leading-segment-wins-over-exact-id? env name-id prefix-id)))))

(define (tc-dotted-field-index-message [name : String]) : String
  (str_cat.str-cat
    (cdiag.compiler-diagnostic-typecheck-tag (Place))
    "typecheck: dotted field access "
    name
    " cannot use numeric field segments; use tuple-ref or array-ref"))

(define (tc-dotted-field-empty-message) : String
  "typecheck: malformed dotted field access; field name cannot be empty")

(define (tc-dotted-field-index-like-id? [field-id : i64]) : bool
  (let
    [field : String (ci.intern-str field-id)]
    (and
      (> (string.string-length field) 0)
      (>= (string.string-ref field 0) '0')
      (<= (string.string-ref field 0) '9'))))

(define (tc-dotted-name-source-id
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : i64
  ;; Parsed names in the ordinary intern pool dominate this path. Structural
  ;; families all live above that range, so reject the common case before
  ;; evaluating their range predicates.
  (if (and (>= name-id 0) (< name-id (ci.intern-capacity)))
    name-id
    (cis.intern-structural-session-syntax-source-name-id-or
      session
      name-id
      name-id)))

(define (tc-dotted-name-first-dot-id
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : i64
  (if (and (>= name-id 0) (< name-id (ci.intern-capacity)))
    (tc-name-first-dot-id session name-id)
    (let
      [source-id : i64 (tc-dotted-name-source-id session name-id)]
      (if (or (< source-id 0) (>= source-id (ci.intern-capacity)))
        -1
        (tc-name-first-dot-id session source-id)))))

;; Structural syntax identities place the source spelling in their low lane.
;; Replacing only that lane keeps the macro/ordinal namespace and depth intact.
(define (tc-dotted-name-with-source-id
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]
  [source-id : i64]) : i64
  (if (< name-id (ci.intern-structural-key-base))
    (let
      [old-source-id : i64 (tc-dotted-name-source-id session name-id)]
      (if (= old-source-id name-id)
        source-id
        (+ (- name-id old-source-id) source-id)))
    (match (cis.intern-structural-session-macro-global-record-for-raw
      session
      name-id)
      [(Some record)
        (cis.intern-macro-global-identity-raw
          (cis.intern-structural-session-macro-global-identity
            session
            record.role
            record.definition-module-id
            source-id))]
      [(No)
        (match (cis.intern-structural-session-macro-local-record-for-raw
          session
          name-id)
          [(Some record)
            (cis.intern-macro-local-identity-raw
              (cis.intern-structural-session-macro-local-identity
                session
                record.macro-definition
                record.lexical-depth
                source-id))]
          [(No)
            (let
              [old-source-id : i64 (tc-dotted-name-source-id session name-id)]
              (if (= old-source-id name-id)
                source-id
                (+ (- name-id old-source-id) source-id)))])])))

(define (tc-dotted-local-field-name-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (if (or (< name-id 0) (>= name-id (ci.intern-capacity)))
    false
    (let
      [first-dot : i64
        (tc-name-first-dot-id (tc-type-env-structural-session env) name-id)]
      (if (< first-dot 0)
        false
        (tc-source-leading-segment-wins-over-exact-id-from-dot?
          env
          name-id
          first-dot)))))

(define (tc-dotted-global-enum-root-without-value?
  [ctx : TcContext]
  [name-id : i64]
  [source-id : i64]) : bool
  (and
    (not
      (macro-hygiene-global-legacy-id?
        (tc-context-structural-session ctx)
        name-id))
    (let
      [root-id : i64 (ci.intern-leading-dot-id source-id)]
      [module-id : i64
        (macro-hygiene-global-module-id
          (tc-context-structural-session ctx)
          name-id)]
      [lookup-module-id : i64
        (if (csym.compiler-symbol-root-module-id? module-id)
          cbi.compiler-builtin-id-fix-empty
          module-id)]
      [symbols (tc-context-symbols ctx)]
      [missing : i64 (csym.compiler-symbols-missing-handle)]
      ;; An enum type is not a value root. Keep both module values and bare
      ;; aliases on the canonical path, including its unqualified fallback.
      (and
        (>= root-id 0)
        (not
          (csym.compiler-symbols-handle-found?
            (csym.compiler-symbols-lookup-value-in-module-id-or
              symbols
              lookup-module-id
              root-id
              missing)))
        (not
          (csym.compiler-symbols-handle-found?
            (csym.compiler-symbols-lookup-value-in-module-id-or
              symbols
              cbi.compiler-builtin-id-fix-empty
              root-id
              missing)))
        (let
          [type-handle : i64
            (csym.compiler-symbols-lookup-type-in-module-id-or
              symbols
              lookup-module-id
              root-id
              missing)]
          (and
            (csym.compiler-symbols-handle-found? type-handle)
            (=
              (csym.compiler-symbol-handle-kind type-handle)
              (csym.compiler-symbol-kind-defenum))))))))

;; A dotted value first keeps the established local-over-module rule. If no
;; local root wins, an existing fully-qualified value still wins over a global
;; projection; otherwise a visible value in the leading segment is a place
;; root. This admits `global.field` without changing module qualification.
(define (tc-dotted-place-name-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (cond
    ;; Ordinary parsed names never belong to a structural hygiene family. Keep
    ;; their local/module disambiguation off those substantially wider range
    ;; checks and use their intern metadata directly.
    [(and (>= name-id 0) (< name-id (ci.intern-capacity)))
      (let
        [first-dot : i64
          (tc-name-first-dot-id (tc-context-structural-session ctx) name-id)]
        (if (< first-dot 0)
          false
          (if (tc-source-leading-segment-wins-over-exact-id-from-dot?
            env
            name-id
            first-dot)
            true
            (let
              [root-id : i64 (ci.intern-leading-dot-id name-id)]
              (if (< root-id 0)
                false
                (match (tc-var-expr-after-local-field-check
                  ctx
                  env
                  name-id
                  (tc-hygiene-name-text-id-for-session
                    (tc-context-structural-session ctx)
                    name-id))
                  [(Ok _) false]
                  [(Err _)
                    (match (tc-var-expr-after-local-field-check
                      ctx
                      env
                      root-id
                      (tc-hygiene-name-text-id-for-session
                        (tc-context-structural-session ctx)
                        root-id))
                      [(Ok _) true]
                      [(Err _) false])]))))))]
    [(or
        (tc-structural-local-name-id?
          (tc-context-structural-session ctx)
          name-id)
        (macro-hygiene-global-id? (tc-context-structural-session ctx) name-id))
      (let
        [source-id : i64
          (tc-dotted-name-source-id (tc-context-structural-session ctx) name-id)]
        [first-dot : i64
          (tc-dotted-name-first-dot-id
            (tc-context-structural-session ctx)
            name-id)]
        (if (or
          (< first-dot 0)
          (and
            (macro-hygiene-global-id?
              (tc-context-structural-session ctx)
              name-id)
            (or
              (tc-dotted-global-enum-root-without-value? ctx name-id source-id)
              (match (tc-var-expr-after-local-field-check
                ctx
                env
                name-id
                (tc-hygiene-name-text-id-for-session
                  (tc-context-structural-session ctx)
                  name-id))
                [(Ok _) true]
                [(Err _) false]))))
          false
          (let
            [root-source-id : i64 (ci.intern-leading-dot-id source-id)]
            (if (< root-source-id 0)
              false
              (match (tc-var-expr-after-local-field-check
                ctx
                env
                (tc-dotted-name-with-source-id
                  (tc-context-structural-session ctx)
                  name-id
                  root-source-id)
                (tc-hygiene-name-text-id-for-session
                  (tc-context-structural-session ctx)
                  root-source-id))
                [(Ok _) true]
                [(Err _) false])))))]
    [else false]))

(define (tc-dotted-local-field-expr-id-tail
  [source-name-id : i64]
  [remaining-id : i64]
  [current : i64]) : ResultTcExprId
  (let
    [next-remaining-id : i64 (ci.intern-dotted-tail-id remaining-id)]
    [field-id : i64
      (if (>= next-remaining-id 0)
        (ci.intern-leading-dot-id remaining-id)
        remaining-id)]
    [field : String (ci.intern-str field-id)]
    (if (= (string.string-length field) 0)
      (Err (tc-dotted-field-empty-message))
      (if (tc-dotted-field-index-like-id? field-id)
        (Err (tc-dotted-field-index-message (ci.intern-str source-name-id)))
        (let
          [next : i64 (ast.ast-expr-struct-get-id current field-id)]
          (if (>= next-remaining-id 0)
            (tc-dotted-local-field-expr-id-tail
              source-name-id
              next-remaining-id
              next)
            (Ok next)))))))

(define (tc-dotted-local-field-expr-id-from-source-name-id
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : ResultTcExprId
  (let
    [source-name-id : i64 (tc-dotted-name-source-id session name-id)]
    [root-source-id : i64 (ci.intern-leading-dot-id source-name-id)]
    [remaining-id : i64 (ci.intern-dotted-tail-id source-name-id)]
    (if (or (< root-source-id 0) (< remaining-id 0))
      (Err (tc-dotted-field-empty-message))
      (tc-dotted-local-field-expr-id-tail
        source-name-id
        remaining-id
        (ast.ast-node-push
          (Var (tc-dotted-name-with-source-id session name-id root-source-id)))))))

(define (tc-dotted-local-field-expr-id-after-check
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]) : ResultTcExprId
  (tc-dotted-local-field-expr-id-from-source-name-id session name-id))

(define (tc-dotted-local-field-expr-id [env : TcTypeEnv] [name-id : i64]) : ResultTcExprId
  (if (tc-dotted-local-field-name-id? env name-id)
    (tc-dotted-local-field-expr-id-after-check
      (tc-type-env-structural-session env)
      name-id)
    (Err "")))

(define (tc-dotted-local-field-set-expr-id-after-check
  [expr-bases : i64]
  [session : cis.InternStructuralSessionHandle]
  [name-id : i64]
  [value : i64]) : ResultTcExprId
  (let
    [get-id : i64
      (try (tc-dotted-local-field-expr-id-after-check session name-id))]
    (match (ast.ast-expr-unspan-with-segment-bases
      expr-bases
      (& (ast.ast-expr-segment-bases-get expr-bases get-id)))
      [(StructGet receiver-box field)
        (Ok (ast.ast-expr-struct-set-id receiver-box field value))]
      [_ (Err "typecheck: internal dotted field target mismatch")])))

(define (tc-dotted-local-field-set-expr-id
  [expr-bases : i64]
  [env : TcTypeEnv]
  [name-id : i64]
  [value : i64]) : ResultTcExprId
  (if (tc-dotted-local-field-name-id? env name-id)
    (tc-dotted-local-field-set-expr-id-after-check
      expr-bases
      (tc-type-env-structural-session env)
      name-id
      value)
    (Err "")))

;; Typed macro operands are checked before they are captured. Dotted-place
;; checking normally canonicalizes the source node in place, but retaining that
;; canonical StructGet in a captured operand makes hygiene treat its synthetic
;; receiver as transformer-produced syntax. Journal those focused rewrites and
;; restore the caller's spelling after the operand check; the expanded result
;; is normalized permanently when it is checked in its final lexical context.
;; The journal is job-owned because nested checks from two jobs may interleave.
(define (tc-dotted-macro-journal-expr-at [state : TcMacroState] [index : i64]) : ast.AstExpr
  (let
    [address : u64
      (unsafe
        (ptr->int
          (ptr-offset
            (__tl_array-data
              (tc-macro-walk-field state dotted-macro-journal-exprs))
            index)))]
    ;; Journal storage lives in the job owner arena. The integer round-trip
    ;; deliberately hides the temporary array borrow while retaining that
    ;; stable owner, so restoring a node transfers the saved descriptor rather
    ;; than making a lexical borrow escape.
    (unsafe
      (ptr-read (int->ptr address : (Ptr ast.AstExpr))))))

(define (tc-dotted-macro-journal-pool-at [state : TcMacroState] [index : i64]) : ast.AstNodePoolContext
  (let
    [address : u64
      (unsafe
        (ptr->int
          (ptr-offset
            (__tl_array-data
              (tc-macro-walk-field state dotted-macro-journal-pools))
            index)))]
    ;; Like saved expressions, pool contexts remain owned by the macro job.
    (unsafe
      (ptr-read (int->ptr address : (Ptr ast.AstNodePoolContext))))))

(define (tc-dotted-macro-journal-grow-copy!
  [state : TcMacroState]
  [next-pools : (&mut next-pools (__tl_dyn-array ast.AstNodePoolContext))]
  [next-ids : (&mut next-ids (__tl_dyn-array i64))]
  [next-exprs : (&mut next-exprs (__tl_dyn-array ast.AstExpr))]
  [index : i64]) : unit
  (unless
    (>= index (tc-macro-walk-field state dotted-macro-journal-len))
    (set!
      (array-ref next-pools index)
      (array-ref (tc-macro-walk-field state dotted-macro-journal-pools) index))
    (set!
      (array-ref next-ids index)
      (array-ref (tc-macro-walk-field state dotted-macro-journal-ids) index))
    (set!
      (array-ref next-exprs index)
      (tc-dotted-macro-journal-expr-at state index))
    (tc-dotted-macro-journal-grow-copy!
      state
      next-pools
      next-ids
      next-exprs
      (+ index 1))))

(define (tc-dotted-macro-journal-grow! [state : TcMacroState]) : unit
  (let
    [old-capacity : i64
      (array-length (tc-macro-walk-field state dotted-macro-journal-ids))]
    [next-capacity : i64
      (if (< old-capacity 1)
        16
        (* old-capacity 2))]
    (in-arena
      (unsafe
        (arena.Arena (tc-macro-state-owner-arena state)))
      (let
        [next-pools : (__tl_dyn-array ast.AstNodePoolContext)
          (__tl_make-array ast.AstNodePoolContext next-capacity)]
        [next-ids : (__tl_dyn-array i64) (__tl_make-array i64 next-capacity)]
        [next-exprs : (__tl_dyn-array ast.AstExpr)
          (__tl_make-array ast.AstExpr next-capacity)]
        (tc-dotted-macro-journal-grow-copy!
          state
          (&mut next-pools)
          (&mut next-ids)
          (&mut next-exprs)
          0)
        (tc-macro-walk-set! state dotted-macro-journal-pools next-pools)
        (tc-macro-walk-set! state dotted-macro-journal-ids next-ids)
        (tc-macro-walk-set! state dotted-macro-journal-exprs next-exprs)))))

(define (tc-dotted-macro-journal-active-pools) : ast.AstNodePoolContext
  (if (ast.ast-node-pool-compat-context-active?)
    (ast.ast-node-pool-compat-context-current)
    (if (ast.ast-node-pool-has-active-context?)
      (ast.ast-node-pool-context-active-live)
      (ast.ast-node-pool-context-capture-active))))

(define (tc-dotted-macro-journal-record!
  [state : TcMacroState]
  [expr-id : i64]
  [expr : ast.AstExpr]) : unit
  (unless
    (< (tc-macro-walk-field state dotted-macro-journal-depth) 1)
    (if (>=
      (tc-macro-walk-field state dotted-macro-journal-len)
      (array-length (tc-macro-walk-field state dotted-macro-journal-ids)))
      (tc-dotted-macro-journal-grow! state)
      unit)
    (set!
      (array-ref
        (tc-macro-walk-field state dotted-macro-journal-pools)
        (tc-macro-walk-field state dotted-macro-journal-len))
      (tc-dotted-macro-journal-active-pools))
    (set!
      (array-ref
        (tc-macro-walk-field state dotted-macro-journal-ids)
        (tc-macro-walk-field state dotted-macro-journal-len))
      expr-id)
    (set!
      (array-ref
        (tc-macro-walk-field state dotted-macro-journal-exprs)
        (tc-macro-walk-field state dotted-macro-journal-len))
      expr)
    (tc-macro-walk-set!
      state
      dotted-macro-journal-len
      (+ (tc-macro-walk-field state dotted-macro-journal-len) 1))))

(define (tc-dotted-macro-journal-start! [state : TcMacroState]) : i64
  (let
    [mark : i64 (tc-macro-walk-field state dotted-macro-journal-len)]
    (tc-macro-walk-set!
      state
      dotted-macro-journal-depth
      (+ (tc-macro-walk-field state dotted-macro-journal-depth) 1))
    mark))

(define (tc-dotted-macro-journal-restore-to!
  [state : TcMacroState]
  [mark : i64]) : unit
  (while (> (tc-macro-walk-field state dotted-macro-journal-len) mark)
    (let
      [index : i64 (- (tc-macro-walk-field state dotted-macro-journal-len) 1)]
      (ast.ast-node-pool-context-expr-set!
        (tc-dotted-macro-journal-pool-at state index)
        (array-ref (tc-macro-walk-field state dotted-macro-journal-ids) index)
        (& (tc-dotted-macro-journal-expr-at state index)))
      (tc-macro-walk-set! state dotted-macro-journal-len index)))
  (tc-macro-walk-set!
    state
    dotted-macro-journal-depth
    (- (tc-macro-walk-field state dotted-macro-journal-depth) 1)))

;; Local dotted fields must become ordinary projection nodes before the
;; move/borrow/lower passes see them.  Keeping `root.field` as a raw Var and
;; teaching each later pass to rebuild it independently loses the rooted place
;; identity those passes use for conflict tracking.  This mutates the parsed
;; node exactly once, after the current lexical environment has decided that
;; the leading segment is a local rather than a module alias.
(define (tc-normalize-dotted-local-field-direct-node!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]
  [expr : ast.AstExpr]) : ResultTcUnit
  (match expr
    [(Var name)
      (if (<
        (tc-dotted-name-first-dot-id (tc-context-structural-session ctx) name)
        0)
        Ok
        (if (tc-dotted-place-name-id? ctx env name)
          (let
            [projection-id
              (try
                (tc-dotted-local-field-expr-id-after-check
                  (tc-context-structural-session ctx)
                  name))]
            (tc-dotted-macro-journal-record!
              (tc-context-macro-state ctx)
              expr-id
              (Var name))
            (ast.ast-node-set! expr-id (tc-context-expr-get ctx projection-id))
            Ok)
          Ok))]
    [(Set name value-box)
      (if (<
        (tc-dotted-name-first-dot-id (tc-context-structural-session ctx) name)
        0)
        Ok
        (if (tc-dotted-place-name-id? ctx env name)
          (let
            [projection-id
              (try
                (tc-dotted-local-field-set-expr-id-after-check
                  (tc-context-expr-segment-bases ctx)
                  (tc-context-structural-session ctx)
                  name
                  value-box))]
            (tc-dotted-macro-journal-record!
              (tc-context-macro-state ctx)
              expr-id
              (Set name value-box))
            (ast.ast-node-set! expr-id (tc-context-expr-get ctx projection-id))
            Ok)
          Ok))]
    [_ Ok]))

;; Most typecheck entrypoints visit every expression in a program, so their
;; hot path only dispatches direct `Var` and `Set` nodes above.  Places and
;; call arguments can be source-span wrappers around those nodes; keep the
;; recursive walk for those focused paths only.
(define (tc-normalize-dotted-local-field-node!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]) : ResultTcUnit
  (match (tc-context-expr-get ctx expr-id)
    [(or (Spanned inner-box _) (MacroExpansion inner-box _ _) (Ann inner-box _)
         (Cast inner-box _) (Borrow _ _ inner-box) (StructGet inner-box _)
         (TupleRef inner-box _) (BoxGet inner-box) (BoxTake inner-box)
         (PtrAddrOf inner-box))
      (tc-normalize-dotted-local-field-node! ctx env inner-box)]
    [(ArrayRef array-box index-box)
      (let
        [_ (try (tc-normalize-dotted-local-field-node! ctx env array-box))]
        (tc-normalize-dotted-local-field-node! ctx env index-box))]
    [_
      (tc-normalize-dotted-local-field-direct-node!
        ctx
        env
        expr-id
        (tc-context-expr-get ctx expr-id))]))

(define (tc-normalize-dotted-local-field-expr-list!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]) : ResultTcUnit
  (tc-normalize-dotted-local-field-expr-list-at! ctx env (& exprs) 0))

(define (tc-normalize-dotted-local-field-expr-list-at!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : ResultTcUnit
  (if (>= index exprs.len)
    Ok
    (let
      [_
        (try
          (tc-normalize-dotted-local-field-node!
            ctx
            env
            (ast.ast-expr-list-get exprs index 0)))]
      (tc-normalize-dotted-local-field-expr-list-at! ctx env exprs (+ index 1)))))

(define tc-imported-module-identity-cache-capacity : i64
  8192)
(define tc-imported-module-identity-cache-module-keys : (__tl_dyn-array i64)
  (__tl_make-array i64 8192))
(define tc-imported-module-identity-cache-target-keys : (__tl_dyn-array i64)
  (__tl_make-array i64 8192))
(define tc-imported-module-identity-cache-values : (__tl_dyn-array i64)
  (__tl_make-array i64 8192))
(define tc-imported-module-identity-cache-count : i64
  0)
(define tc-imported-module-identity-cache-generation : i64
  -1)
(define tc-imported-module-identity-cache-ready : bool
  false)

(define (tc-imported-module-identity-cache-reset!) : unit
  (set! tc-imported-module-identity-cache-ready false))

(define (tc-imported-module-identity-cache-ensure!) : unit
  (if (if tc-imported-module-identity-cache-ready
    (= tc-imported-module-identity-cache-generation (ci.intern-generation))
    false)
    unit
    (begin
      (for [i (iterator.range 0 tc-imported-module-identity-cache-capacity)]
        (set! (array-ref tc-imported-module-identity-cache-module-keys i) 0))
      (set! tc-imported-module-identity-cache-count 0)
      (set! tc-imported-module-identity-cache-generation (ci.intern-generation))
      (set! tc-imported-module-identity-cache-ready true))))

(define (tc-imported-module-identity-cache-bucket
  [current-module-id : i64]
  [target-id : i64]) : i64
  (bit-and
    (+ (* current-module-id 2654435761) (* target-id 40503))
    (- tc-imported-module-identity-cache-capacity 1)))

;; Returns 1 for true, -1 for false, or -2 when absent.
(define (tc-imported-module-identity-cache-get
  [current-module-id : i64]
  [target-id : i64]) : i64
  (let
    [cursor : i64
      (tc-imported-module-identity-cache-bucket current-module-id target-id)]
    [module-key : i64 (+ current-module-id 1)]
    [target-key : i64 (+ target-id 1)]
    [steps : i64 0]
    [out : i64 -2]
    [done : bool false]
    (while (if done
      false
      (< steps tc-imported-module-identity-cache-capacity))
      (let
        [slot : i64
          (array-ref tc-imported-module-identity-cache-module-keys cursor)]
        (if (= slot 0)
          (set! done true)
          (if (and
            (= slot module-key)
            (=
              (array-ref tc-imported-module-identity-cache-target-keys cursor)
              target-key))
            (begin
              (set!
                out
                (array-ref tc-imported-module-identity-cache-values cursor))
              (set! done true))
            (begin
              (set!
                cursor
                (bit-and
                  (+ cursor 1)
                  (- tc-imported-module-identity-cache-capacity 1)))
              (+= steps 1))))))
    out))

(define (tc-imported-module-identity-cache-put!
  [current-module-id : i64]
  [target-id : i64]
  [value : bool]) : unit
  (if (>=
    (* tc-imported-module-identity-cache-count 2)
    tc-imported-module-identity-cache-capacity)
    unit
    (let
      [cursor : i64
        (tc-imported-module-identity-cache-bucket current-module-id target-id)]
      [module-key : i64 (+ current-module-id 1)]
      [target-key : i64 (+ target-id 1)]
      [steps : i64 0]
      [done : bool false]
      (while (if done
        false
        (< steps tc-imported-module-identity-cache-capacity))
        (let
          [slot : i64
            (array-ref tc-imported-module-identity-cache-module-keys cursor)]
          (if (= slot 0)
            (begin
              (set!
                (array-ref tc-imported-module-identity-cache-module-keys cursor)
                module-key)
              (set!
                (array-ref tc-imported-module-identity-cache-target-keys cursor)
                target-key)
              (set!
                (array-ref tc-imported-module-identity-cache-values cursor)
                (if value
                  1
                  -1))
              (+= tc-imported-module-identity-cache-count 1)
              (set! done true))
            (if (and
              (= slot module-key)
              (=
                (array-ref tc-imported-module-identity-cache-target-keys cursor)
                target-key))
              (set! done true)
              (begin
                (set!
                  cursor
                  (bit-and
                    (+ cursor 1)
                    (- tc-imported-module-identity-cache-capacity 1)))
                (+= steps 1))))))
      unit)))

(define (tc-module-identity-id-eq?
  [session : cis.InternStructuralSessionHandle]
  [a : i64]
  [b : i64]) : bool
  (or
    (= a b)
    (string.eq
      (tc-env-key-name-text-for-session session a)
      (tc-env-key-name-text-for-session session b))))

(define (tc-imported-module-identity-ids?
  [state : TcMacroState]
  [session : cis.InternStructuralSessionHandle]
  [decls : ast.AstDeclList]
  [current-module-id : i64]
  [target-id : i64]) : bool
  ;; Only the current module's own import rows can match. The module decl
  ;; index lists them in program order, so a miss reads those rows instead of
  ;; walking every declaration of the program: a miss recurs for each
  ;; (module, target) pair after every splice resets the answer cache, and bare
  ;; names reach this query on lookups qualified names answer from the symbol
  ;; table. The projection match loads the tag and only the fields an arm binds.
  (unsafe
    (let
      [module-index : (MutPtr TcModuleDeclIndexStateData)
        (tc-module-decl-index-state-ptr state)]
      [_ensure : unit (tc-module-decl-index-ensure! state (& decls))]
      [slot : i64
        (tc-module-decl-index-slot
          (ptr-cast module-index : (Ptr TcModuleDeclIndexStateData))
          current-module-id)]
      (if (< slot 0)
        false
        (let
          [j : i64 (array-ref (deref module-index).import-starts slot)]
          [end : i64 (array-ref (deref module-index).import-ends slot)]
          [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
          [decl-offset : i64 decls.offset]
          [found : bool false]
          (while (and (not found) (< j end))
            (let
              [at : i64
                (+
                  decl-offset
                  (array-ref (deref module-index).import-positions j))]
              (match (owned_view.compiler-owned-element-view decl-slots at)
                [(Import decl-meta (Spec _ _ expected _ _))
                  (match expected
                    [(Some target)
                      (if (tc-module-identity-id-eq? session target target-id)
                        (set! found true)
                        unit)]
                    [(No) unit])]
                [_ unit]))
            (+= j 1))
          found)))))

(define (tc-imported-module-identity-id? [ctx : TcContext] [target-id : i64]) : bool
  (let
    [program : ast.AstProgram (tc-context-program ctx)]
    [current-module-id : i64 (tc-context-module-id ctx)]
    (match program
      [(Program decls-box)
        (tc-imported-module-identity-cache-ensure!)
        (let
          [cached : i64
            (tc-imported-module-identity-cache-get current-module-id target-id)]
          (if (= cached -2)
            (let
              [found : bool
                (if (macro-segmented-program-active? (tc-context-job-state ctx))
                  (macro-segmented-imported-module-identity-ids?
                    (tc-context-structural-session ctx)
                    (tc-context-job-state ctx)
                    current-module-id
                    target-id)
                  (tc-imported-module-identity-ids?
                    (tc-context-macro-state ctx)
                    (tc-context-structural-session ctx)
                    (ast.ast-decl-list-box-shared-view decls-box)
                    current-module-id
                    target-id))]
              (tc-imported-module-identity-cache-put!
                current-module-id
                target-id
                found)
              found)
            (> cached 0)))])))

(define (tc-source-name-id-or [ctx : TcContext] [name : i64] [fallback : i64]) : i64
  (let
    [session : ci.InternSourceNameSession
      (ci.intern-source-name-session-handle-session
        (tc-context-source-names ctx))]
    [source-name : i64
      (tc-dotted-name-source-id (tc-context-structural-session ctx) name)]
    ;; Qualified source names already carry their parsed module ID. Returning
    ;; it directly avoids hashing the same module spelling for every nominal
    ;; type occurrence. Preserve the session ownership/generation checks that
    ;; keep retained IDs from being mistaken for names in a reset table.
    (if (and
      (= (array-ref session.table-id-cell 0) session.table-id)
      (= (array-ref session.reset-generation-cell 0) session.reset-generation)
      (>= source-name 0)
      (< source-name session.source-count))
      source-name
      (match (ci.intern-source-name-session-resolve
        session
        (ci.intern-source-name-session-identity session source-name)
        (& (ci.intern-syntax-name-text-or name "")))
        [(ParsedIdentity source-id) source-id]
        [(GeneratedIdentity _ lookup)
          (match lookup
            [(InternLookupFound source-id) source-id]
            [(InternLookupMissing) fallback])]
        [_ fallback]))))

(define (tc-stdlib-string-module-name? [module-name : String]) : bool
  (or
    (string.eq module-name "string")
    (string.eq module-name "string.tl")
    (string.eq module-name "stdlib.string")
    (string.eq module-name "stdlib/string")
    (string.eq module-name "stdlib/string.tl")
    (tc-string-has-suffix? module-name "/stdlib/string.tl")
    (tc-string-has-suffix? module-name "\\stdlib\\string.tl")
    (tc-string-has-suffix? module-name "\\stdlib/string.tl")
    (tc-string-has-suffix? module-name "/stdlib\\string.tl")))

(define (tc-context-is-stdlib-string? [ctx : TcContext]) : bool
  (tc-stdlib-string-module-name? (tc-context-module ctx)))

(define (tc-type-list-ty-node-get
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ast.AstType
  (ast.ty-node-get
    (ast.ast-type-list-get types index (ast.ast-type-id-fallback))))

(define (tc-stdlib-string-length-wrapper-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(Func args ret)
      (let
        [args : ast.AstTypeList (ast.ast-type-list-box-shared-view args)]
        (if (= (ast.ast-type-list-len (& args)) 1)
          (and
            (tc-str-ref-type? (tc-type-list-ty-node-get args 0))
            (tc-type-eq (ast.ty-node-get ret) (I64)))
          false))]
    [_ false]))

(define (tc-stdlib-string-ref-wrapper-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(Func args ret)
      (let
        [args : ast.AstTypeList (ast.ast-type-list-box-shared-view args)]
        (if (= (ast.ast-type-list-len (& args)) 2)
          (and
            (tc-str-ref-type? (tc-type-list-ty-node-get args 0))
            (tc-type-eq (tc-type-list-ty-node-get args 1) (I64))
            (tc-type-eq (ast.ty-node-get ret) (Char)))
          false))]
    [_ false]))

(define (tc-stdlib-string-eq-wrapper-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(Func args ret)
      (let
        [args : ast.AstTypeList (ast.ast-type-list-box-shared-view args)]
        (if (= (ast.ast-type-list-len (& args)) 2)
          (and
            (tc-string-handle-type? (tc-type-list-ty-node-get args 0))
            (tc-string-handle-type? (tc-type-list-ty-node-get args 1))
            (tc-type-eq (ast.ty-node-get ret) (Bool)))
          false))]
    [_ false]))

(define (tc-stdlib-string-copy-wrapper-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(Func args ret)
      (let
        [args : ast.AstTypeList (ast.ast-type-list-box-shared-view args)]
        (if (= (ast.ast-type-list-len (& args)) 2)
          (and
            (tc-str-ref-type? (tc-type-list-ty-node-get args 0))
            (tc-str-ref-type? (tc-type-list-ty-node-get args 1))
            (tc-type-eq (ast.ty-node-get ret) (String)))
          false))]
    [_ false]))

(define (tc-stdlib-string-to-int-wrapper-type? [ty : ast.AstType]) : bool
  (match (tc-type-strip-region ty)
    [(Func args ret)
      (let
        [args : ast.AstTypeList (ast.ast-type-list-box-shared-view args)]
        (if (= (ast.ast-type-list-len (& args)) 1)
          (and
            (tc-string-handle-type? (tc-type-list-ty-node-get args 0))
            (tc-type-eq (ast.ty-node-get ret) (I64)))
          false))]
    [_ false]))

(define (tc-stdlib-string-helper-wrapper-type?
  [base : (& str)]
  [ty : ast.AstType]) : bool
  (cond
    [(string.eq base "string-length")
      (tc-stdlib-string-length-wrapper-type? ty)]
    [(string.eq base "string-ref") (tc-stdlib-string-ref-wrapper-type? ty)]
    [(string.eq base "char-at") (tc-stdlib-string-ref-wrapper-type? ty)]
    [(string.eq base "eq") (tc-stdlib-string-eq-wrapper-type? ty)]
    [(string.eq base "string-eq") (tc-stdlib-string-eq-wrapper-type? ty)]
    [(string.eq base "string=?") (tc-stdlib-string-eq-wrapper-type? ty)]
    [(string.eq base "string-append") (tc-stdlib-string-copy-wrapper-type? ty)]
    [(string.eq base "string-concat") (tc-stdlib-string-copy-wrapper-type? ty)]
    [(string.eq base ">int") (tc-stdlib-string-to-int-wrapper-type? ty)]
    [else false]))

(define (tc-stdlib-string-helper-bound-wrapper?
  [env : TcTypeEnv]
  [base-id : i64]
  [base : (& str)]) : bool
  (match (tc-lookup-id env base-id)
    [(Ok ty) (tc-stdlib-string-helper-wrapper-type? base ty)]
    [(Err _) false]))

(define (tc-stdlib-string-length-wrapper-decl?
  [ctx : TcContext]
  [base : (& str)]
  [decl : ast.AstDecl]) : bool
  (match decl
    [(DefFn decl-meta name params ret _ _)
      (and
        (string.eq (tc-env-key-name-text name) base)
        (tc-type-eq (tc-resolve-type ctx ret) (I64))
        (= (ast.ast-param-list-len (& params)) 1)
        (match (ast.ast-param-list-get (& params) 0 (ast.ast-param-fallback))
          [(Param _ text _) (tc-str-ref-type? (tc-resolve-type ctx text))]
          [_ false]))]
    [_ false]))

(define (tc-stdlib-string-ref-wrapper-decl?
  [ctx : TcContext]
  [base : (& str)]
  [decl : ast.AstDecl]) : bool
  (match decl
    [(DefFn decl-meta name params ret _ _)
      (and
        (string.eq (tc-env-key-name-text name) base)
        (tc-type-eq (tc-resolve-type ctx ret) (Char))
        (= (ast.ast-param-list-len (& params)) 2)
        (match (ast.ast-param-list-get (& params) 0 (ast.ast-param-fallback))
          [(Param _ text _)
            (match (ast.ast-param-list-get
              (& params)
              1
              (ast.ast-param-fallback))
              [(Param _ index _)
                (and
                  (tc-str-ref-type? (tc-resolve-type ctx text))
                  (tc-type-eq (tc-resolve-type ctx index) (I64)))]
              [_ false])]
          [_ false]))]
    [_ false]))

(define (tc-stdlib-string-eq-wrapper-decl?
  [ctx : TcContext]
  [base : (& str)]
  [decl : ast.AstDecl]) : bool
  (match decl
    [(DefFn decl-meta name params ret _ _)
      (and
        (string.eq (tc-env-key-name-text name) base)
        (tc-type-eq (tc-resolve-type ctx ret) (Bool))
        (= (ast.ast-param-list-len (& params)) 2)
        (match (ast.ast-param-list-get (& params) 0 (ast.ast-param-fallback))
          [(Param _ left _)
            (match (ast.ast-param-list-get
              (& params)
              1
              (ast.ast-param-fallback))
              [(Param _ right _)
                (and
                  (tc-str-ref-type? (tc-resolve-type ctx left))
                  (tc-str-ref-type? (tc-resolve-type ctx right)))]
              [_ false])]
          [_ false]))]
    [_ false]))

(define (tc-stdlib-string-copy-wrapper-decl?
  [ctx : TcContext]
  [base : (& str)]
  [decl : ast.AstDecl]) : bool
  (match decl
    [(DefFn decl-meta name params ret _ _)
      (and
        (string.eq (tc-env-key-name-text name) base)
        (tc-type-eq (tc-resolve-type ctx ret) (String))
        (= (ast.ast-param-list-len (& params)) 2)
        (match (ast.ast-param-list-get (& params) 0 (ast.ast-param-fallback))
          [(Param _ left _)
            (match (ast.ast-param-list-get
              (& params)
              1
              (ast.ast-param-fallback))
              [(Param _ right _)
                (and
                  (tc-str-ref-type? (tc-resolve-type ctx left))
                  (tc-str-ref-type? (tc-resolve-type ctx right)))]
              [_ false])]
          [_ false]))]
    [_ false]))

(define (tc-stdlib-string-helper-symbol-wrapper?
  [ctx : TcContext]
  [base-id : i64]
  [base : (& str)]) : bool
  (let
    [symbols : (& ctx csym.CompilerSymbols) (tc-context-symbols ctx)]
    [handle : i64
      (csym.compiler-symbols-lookup-value-id-or
        symbols
        base-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (let
        [decls : (__tl_dyn-array ast.AstDecl)
          (csym.compiler-symbols-decls symbols)]
        [index : i64 (csym.compiler-symbol-handle-index handle)]
        (if (or (< index 0) (>= index (array-length decls)))
          false
          (let
            [decl : ast.AstDecl (ast.ast-array-shared-view decls index)]
            (cond
              [(string.eq base "string-length")
                (tc-stdlib-string-length-wrapper-decl? ctx base decl)]
              [(string.eq base "string-ref")
                (tc-stdlib-string-ref-wrapper-decl? ctx base decl)]
              [(string.eq base "char-at")
                (tc-stdlib-string-ref-wrapper-decl? ctx base decl)]
              [(string.eq base "eq")
                (tc-stdlib-string-eq-wrapper-decl? ctx base decl)]
              [(string.eq base "string-append")
                (tc-stdlib-string-copy-wrapper-decl? ctx base decl)]
              [(string.eq base "string-concat")
                (tc-stdlib-string-copy-wrapper-decl? ctx base decl)]
              [else false]))))
      false)))

;; The builtin string helpers a module-qualified `stdlib.string` call may
;; reach: exactly the helper names stdlib.string exports. `string-append`,
;; `string-concat` and `string-eq` are bare-only spellings with no stdlib.string
;; export, so `string.string-append`, `string.string-concat` and
;; `string.string-eq` fall through to ordinary resolution and are reported
;; unbound. Treating them as builtins made them typecheck and then fail at link
;; against a module symbol that does not exist (#7883). The set is fixed by the
;; module's source rather than read from the environment, so every path that
;; types a qualified call (the loader's and the single-program lowering
;; fixtures', which bind module-qualified imports differently) routes the same
;; calls. The `qualified_string_*` safety rows pin it against the real module.
(define (tc-stdlib-string-exported-helper-base-id? [base-id : i64]) : bool
  (or
    (= base-id cbi.compiler-builtin-id-string-length)
    (= base-id cbi.compiler-builtin-id-string-ref)
    (= base-id cbi.compiler-builtin-id-char-at)
    (= base-id cbi.compiler-builtin-id-eq)
    (= base-id cbi.compiler-builtin-id-string-eq-question)))

(define (tc-stdlib-string-qualified-helper-id?
  [session : cis.InternStructuralSessionHandle]
  [lookup-id : i64]
  [base-id : i64]
  [_base : String]) : bool
  (and
    (tc-stdlib-string-exported-helper-base-id? base-id)
    (tc-name-qualified-id? session lookup-id)
    (= (tc-qualified-name-base-id lookup-id) base-id)
    (tc-stdlib-string-module-name?
      (tc-nominal-name-id-display (tc-qualified-name-module-id lookup-id)))))

;; --- per-epoch module -> decl-position index ----------------------------------
;; The job-owned header indexes module ids to program-order declaration and
;; import positions, excluding module markers. Its payload owns only integer
;; keys/positions, never borrowed declaration rows. A separate arena keeps it
;; alive across transient query scratch and is retired with the owning job.
;; The fast stamp includes the declaration view and the job's source-name
;; table identity/generation. A splice invalidation retains the payload only
;; when every recorded module/import shape still matches the current view;
;; declaration changes that preserve that shape cannot change its positions.
(defstruct TcModuleDeclIndexStateData
  (ready bool)
  (decl-count i64)
  (decl-offset i64)
  (decl-slots i64)
  (intern-table-id i64)
  (generation i64)
  (arena i64)
  (modules tc_i64_i64_map.Map)
  (starts (__tl_dyn-array i64))
  (ends (__tl_dyn-array i64))
  (positions (__tl_dyn-array i64))
  (import-starts (__tl_dyn-array i64))
  (import-ends (__tl_dyn-array i64))
  (import-positions (__tl_dyn-array i64))
  (maybe-stale bool)
  (seq (__tl_dyn-array i64)))

(define (tc-module-decl-index-state-new) : TcModuleDeclIndexStateData
  (TcModuleDeclIndexStateData
    false
    -1
    -1
    0
    -1
    -1
    0
    (tc_i64_i64_map.with-capacity 0)
    (__tl_make-array i64 0)
    (__tl_make-array i64 0)
    (__tl_make-array i64 0)
    (__tl_make-array i64 0)
    (__tl_make-array i64 0)
    (__tl_make-array i64 0)
    false
    (__tl_make-array i64 0)))

(define (tc-module-decl-index-state-initialize [state : TcMacroState]) : i64
  (tc-macro-state-cell-initialize
    state
    TcModuleDeclIndexStateData
    tc-macro-state-slot-module-decl-index
    (tc-module-decl-index-state-new)))

(define (tc-module-decl-index-state-address [state : TcMacroState]) : i64
  (tc-macro-state-address-fast
    state
    tc-macro-state-slot-module-decl-index
    tc-module-decl-index-state-initialize))

(define (tc-module-decl-index-state-ptr [state : TcMacroState]) : (MutPtr
    TcModuleDeclIndexStateData)
  (tc-state-cell-ptr
    (tc-module-decl-index-state-address state)
    TcModuleDeclIndexStateData))

;; Invalidation retains the index until its module/import shape changes.
;; An idle job must not allocate an index merely to invalidate it.
(define (tc-module-decl-index-reset! [state : TcMacroState]) : unit
  (let
    [address : i64
      (tc-macro-state-slot-address state tc-macro-state-slot-module-decl-index)]
    (when
      (> address 0)
      (unsafe
        (set!
          (deref (tc-state-cell-ptr address TcModuleDeclIndexStateData)).maybe-stale
          true)))))

(define (tc-module-decl-index-arena-for-state [state : TcMacroState]) : i64
  (let
    [address : i64
      (tc-macro-state-slot-address state tc-macro-state-slot-module-decl-index)]
    (if (> address 0)
      (unsafe
        (deref (tc-state-cell-view address TcModuleDeclIndexStateData)).arena)
      0)))

;; The fixed header belongs to the job. Clear every payload view there before
;; destroying its independently retained arena; another job may be current.
(define (tc-module-decl-index-release! [state : TcMacroState]) : unit
  (let
    [address : i64
      (tc-macro-state-slot-address state tc-macro-state-slot-module-decl-index)]
    (when
      (> address 0)
      (let
        [data : (MutPtr TcModuleDeclIndexStateData)
          (tc-state-cell-ptr address TcModuleDeclIndexStateData)]
        [storage : i64
          (unsafe
            (deref data).arena)]
        (when
          (> storage 0)
          (in-arena
            (unsafe
              (arena.Arena (tc-macro-state-owner-arena state)))
            (tc-state-cell-write!
              address
              TcModuleDeclIndexStateData
              (tc-module-decl-index-state-new)))
          (unsafe
            (arena.tl_arena_destroy storage)))))))

;; Shape code of one declaration as the index build reads it: a module marker
;; carries its module id (never negative), imports are -1, everything else -2.
;; Reads the tag through a borrow and the module id straight out of the row, so
;; the whole-program shape sweep never copies an `AstDecl` per declaration.
(define (tc-module-decl-index-shape-code-at
  [decls : (& decls ast.AstDeclList)]
  [index : i64]) : i64
  (match (ast.ast-decl-list-ref-borrowed decls index)
    [(Module _) (ast.ast-decl-list-module-id-at decls index -2)]
    [_
      (if (ast.ast-decl-list-unwrapped-import-at? decls index)
        -1
        -2)]))

(define (tc-module-decl-index-seq-matches?
  [index : (Ptr TcModuleDeclIndexStateData)]
  [decls : (& decls ast.AstDeclList)]) : bool
  (unsafe
    (let
      [count : i64 decls.len]
      (if (not (= (array-length (deref index).seq) count))
        false
        (begin
          (for [i (iterator.range 0 count)]
            (let
              [code : i64 (tc-module-decl-index-shape-code-at (& decls) i)]
              (when
                (or (< code -2) (not (= code (array-ref (deref index).seq i))))
                (return false))))
          true)))))

(define (tc-module-decl-index-ensure!
  [state : TcMacroState]
  [decls : (& decls ast.AstDeclList)]) : unit
  (let
    [module-index : (MutPtr TcModuleDeclIndexStateData)
      (tc-module-decl-index-state-ptr state)]
    [table-id : i64 (tc-macro-state-source-name-table-id state)]
    [generation : i64 (tc-macro-state-source-name-reset-generation state)]
    (unsafe
      (when
        (and
          (deref module-index).ready
          (= (deref module-index).decl-count decls.len)
          (= (deref module-index).decl-offset decls.offset)
          (=
            (deref module-index).decl-slots
            (macro-decl-list-slots-data-addr decls)))
        (when
          (and
            (not (deref module-index).maybe-stale)
            (= (deref module-index).intern-table-id table-id)
            (= (deref module-index).generation generation))
          (return unit))
        ;; The kept index is valid whenever the module/import shape of the
        ;; declaration list is unchanged: the index stores only per-module
        ;; declaration and import positions, so in-place declaration rewrites
        ;; that preserve the shape cannot change it.
        (when
          (tc-module-decl-index-seq-matches?
            (ptr-cast module-index : (Ptr TcModuleDeclIndexStateData))
            decls)
          (set! (deref module-index).maybe-stale false)
          (set! (deref module-index).intern-table-id table-id)
          (set! (deref module-index).generation generation)
          (return unit)))
      (let
        [count : i64 decls.len]
        [decl-offset : i64 decls.offset]
        [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
        [empty-module-id : i64 cbi.compiler-builtin-id-fix-empty]
        [prev-arena : i64 (arena.tl_arena_current)]
        [old-arena : i64 (deref module-index).arena]
        [_make-arena : unit
          (set! (deref module-index).arena (arena.tl_arena_make_small))]
        [_switch : unit
          (unsafe
            (arena.tl_arena_set (deref module-index).arena))]
        [modules : tc_i64_i64_map.Map (tc_i64_i64_map.with-capacity 512)]
        [module-count : i64 0]
        [counts : (__tl_dyn-array i64) (__tl_make-array i64 (+ count 1))]
        [import-counts : (__tl_dyn-array i64) (__tl_make-array i64 (+ count 1))]
        [starts : (__tl_dyn-array i64) (__tl_make-array i64 (+ count 1))]
        [ends : (__tl_dyn-array i64) (__tl_make-array i64 (+ count 1))]
        [positions : (__tl_dyn-array i64) (__tl_make-array i64 (+ count 1))]
        [import-starts : (__tl_dyn-array i64) (__tl_make-array i64 (+ count 1))]
        [import-ends : (__tl_dyn-array i64) (__tl_make-array i64 (+ count 1))]
        [import-positions : (__tl_dyn-array i64)
          (__tl_make-array i64 (+ count 1))]
        [cur-module-id : i64 empty-module-id]
        [running : i64 0]
        [import-running : i64 0]
        ;; Pass 1: assign a dense slot per module id and count its decls.
        (for [i (iterator.range 0 count)]
          (match (array-ref decl-slots (+ decl-offset i))
            [(Module next-module) (set! cur-module-id next-module)]
            [_
              (let
                [slot : i64
                  (let
                    [found-slot : i64
                      (tc_i64_i64_map.get-value-or (& modules) cur-module-id -1)]
                    (if (>= found-slot 0)
                      found-slot
                      (let
                        [new-slot : i64 module-count]
                        (tc_i64_i64_map.insert-ref!
                          (&mut modules)
                          cur-module-id
                          new-slot)
                        (+= module-count 1)
                        new-slot)))]
                (set! (array-ref counts slot) (+ (array-ref counts slot) 1))
                ;; Borrowed import test: the count needs one bit, not a row.
                (if (ast.ast-decl-list-unwrapped-import-at? (& decls) i)
                  (set!
                    (array-ref import-counts slot)
                    (+ (array-ref import-counts slot) 1))
                  unit))]))
        ;; Prefix sums: starts fixed, ends double as fill cursors below.
        (for [i (iterator.range 0 module-count)]
          (set! (array-ref starts i) running)
          (set! (array-ref ends i) running)
          (set! (array-ref import-starts i) import-running)
          (set! (array-ref import-ends i) import-running)
          (+= running (array-ref counts i))
          (+= import-running (array-ref import-counts i)))
        ;; Pass 2: fill program-order positions per module slot.
        (set! cur-module-id empty-module-id)
        (for [i (iterator.range 0 count)]
          (match (array-ref decl-slots (+ decl-offset i))
            [(Module next-module) (set! cur-module-id next-module)]
            [_
              (let
                [slot : i64
                  (tc_i64_i64_map.get-value-or (& modules) cur-module-id -1)]
                (if (>= slot 0)
                  (let
                    [cursor : i64 (array-ref ends slot)]
                    (set! (array-ref positions cursor) i)
                    (set! (array-ref ends slot) (+ cursor 1))
                    (if (ast.ast-decl-list-unwrapped-import-at? (& decls) i)
                      (let
                        [import-cursor : i64 (array-ref import-ends slot)]
                        (set! (array-ref import-positions import-cursor) i)
                        (set! (array-ref import-ends slot) (+ import-cursor 1)))
                      unit))
                  unit))]))
        ;; Record the per-decl shape sequence so a maybe-stale index can be
        ;; revalidated without rebuilding.
        (let
          [seq : (__tl_dyn-array i64) (__tl_make-array i64 count)]
          (for [i (iterator.range 0 count)]
            (set!
              (array-ref seq i)
              (tc-module-decl-index-shape-code-at (& decls) i)))
          (set! (deref module-index).seq seq))
        (set! (deref module-index).modules modules)
        (set! (deref module-index).starts starts)
        (set! (deref module-index).ends ends)
        (set! (deref module-index).positions positions)
        (set! (deref module-index).import-starts import-starts)
        (set! (deref module-index).import-ends import-ends)
        (set! (deref module-index).import-positions import-positions)
        (set! (deref module-index).decl-count count)
        (set! (deref module-index).decl-offset decl-offset)
        (set!
          (deref module-index).decl-slots
          (macro-decl-list-slots-data-addr decls))
        (set! (deref module-index).intern-table-id table-id)
        (set! (deref module-index).generation generation)
        (set! (deref module-index).maybe-stale false)
        ;; The stable arena root names the complete grown chain. The previous
        ;; rebuild (kept alive across maybe-stale revalidation) is destroyed
        ;; only now that every index global points into the fresh one.
        (unsafe
          (arena.tl_arena_set prev-arena))
        (if (= old-arena 0)
          unit
          (unsafe
            (arena.tl_arena_destroy old-arena)))
        (set! (deref module-index).ready true)))))

;; Dense slot for a module id, or -1 when the module owns no declarations.
(define (tc-module-decl-index-slot
  [index : (Ptr TcModuleDeclIndexStateData)]
  [module-id : i64]) : i64
  (unsafe
    (let
      [modules : tc_i64_i64_map.Map (deref index).modules]
      (tc_i64_i64_map.get-value-or (& modules) module-id -1))))

(define (tc-decl-list-module-imports-stdlib-string?
  [state : TcMacroState]
  [decls : ast.AstDeclList]
  [target-module-id : i64]
  [current-module-id : i64]) : bool
  (unsafe
    (let
      [module-index : (MutPtr TcModuleDeclIndexStateData)
        (tc-module-decl-index-state-ptr state)]
      [_ensure : unit (tc-module-decl-index-ensure! state decls)]
      [_unused-module-id : i64 current-module-id]
      [slot : i64
        (tc-module-decl-index-slot
          (ptr-cast module-index : (Ptr TcModuleDeclIndexStateData))
          target-module-id)]
      (if (< slot 0)
        false
        (let
          [j : i64 (array-ref (deref module-index).starts slot)]
          [end : i64 (array-ref (deref module-index).ends slot)]
          [found : bool false]
          (while (and (not found) (< j end))
            (let
              [at : i64
                (+ decls.offset (array-ref (deref module-index).positions j))]
              (match (owned_view.compiler-owned-element-view decls.slots at)
                [(Import decl-meta (Spec _ _ (Some import-module) _ _))
                  (if (tc-stdlib-string-module-name?
                    (ci.intern-str import-module))
                    (set! found true)
                    unit)]
                [_ unit]))
            (+= j 1))
          found)))))

(define (tc-context-imports-stdlib-string? [ctx : TcContext]) : bool
  (let
    [program : ast.AstProgram (tc-context-program ctx)]
    [module-id : i64 (tc-context-module-id ctx)]
    (match program
      [(Program decls-box)
        (tc-decl-list-module-imports-stdlib-string?
          (tc-context-macro-state ctx)
          (ast.ast-decl-list-box-shared-view decls-box)
          module-id
          cbi.compiler-builtin-id-fix-empty)])))

(define (tc-stdlib-string-helper-visible-or-wrapper-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-id : i64]
  [source-match : bool]
  [lookup-id : i64]
  [base-id : i64]
  [base : String]) : bool
  (if (and
    source-match
    (cbi.compiler-builtin-typecheck-stdlib-string-bare-helper-id? source-id))
    (or
      (tc-context-is-stdlib-string? ctx)
      (tc-context-imports-stdlib-string? ctx)
      (tc-stdlib-string-helper-bound-wrapper? env base-id base)
      (tc-stdlib-string-helper-symbol-wrapper? ctx base-id base)
      (tc-stdlib-string-qualified-helper-id?
        (tc-context-structural-session ctx)
        lookup-id
        base-id
        base))
    (tc-stdlib-string-qualified-helper-id?
      (tc-context-structural-session ctx)
      lookup-id
      base-id
      base)))

(define tc-source-dotted-alias-key-cache-capacity : i64
  8192)
(define tc-source-dotted-full-path-key-cache-capacity : i64
  8192)
(define tc-source-qualified-variant-key-cache-capacity : i64
  8192)

(define (tc-source-dotted-alias-key-cache-ensure-for-state!
  [state : (& state TcSourceKeyCacheState)]
  [table-id : i64]
  [generation : i64]) : unit
  (if (and
    (= (array-ref state.control 2) 1)
    (= (array-ref state.control 0) table-id)
    (= (array-ref state.control 1) generation))
    unit
    (let
      [i : i64 0]
      (while (< i tc-source-dotted-alias-key-cache-capacity)
        (owned_view.compiler-owned-cell-set! state.dotted-alias-module-keys i 0)
        (set! i (+ i 1)))
      (owned_view.compiler-owned-cell-set! state.control 0 table-id)
      (owned_view.compiler-owned-cell-set! state.control 1 generation)
      (owned_view.compiler-owned-cell-set! state.control 2 1))))

(define (tc-source-dotted-full-path-key-cache-ensure-for-state!
  [state : (& state TcSourceKeyCacheState)]
  [table-id : i64]
  [generation : i64]) : unit
  (if (and
    (= (array-ref state.control 5) 1)
    (= (array-ref state.control 3) table-id)
    (= (array-ref state.control 4) generation))
    unit
    (let
      [i : i64 0]
      (while (< i tc-source-dotted-full-path-key-cache-capacity)
        (owned_view.compiler-owned-cell-set!
          state.dotted-full-path-module-keys
          i
          0)
        (set! i (+ i 1)))
      (owned_view.compiler-owned-cell-set! state.control 3 table-id)
      (owned_view.compiler-owned-cell-set! state.control 4 generation)
      (owned_view.compiler-owned-cell-set! state.control 5 1))))

(define (tc-source-qualified-variant-key-cache-ensure-for-state!
  [state : (& state TcSourceKeyCacheState)]
  [table-id : i64]
  [generation : i64]
  [registry-id : i64]) : unit
  (if (and
    (= (array-ref state.control 9) 1)
    (= (array-ref state.control 6) table-id)
    (= (array-ref state.control 7) generation)
    (= (array-ref state.control 8) registry-id))
    unit
    (let
      [i : i64 0]
      (while (< i tc-source-qualified-variant-key-cache-capacity)
        (owned_view.compiler-owned-cell-set!
          state.qualified-variant-name-keys
          i
          0)
        (set! i (+ i 1)))
      (owned_view.compiler-owned-cell-set! state.control 6 table-id)
      (owned_view.compiler-owned-cell-set! state.control 7 generation)
      (owned_view.compiler-owned-cell-set! state.control 8 registry-id)
      (owned_view.compiler-owned-cell-set! state.control 9 1))))

(define (tc-source-dotted-alias-key-cache-bucket
  [module-id : i64]
  [name-id : i64]) : i64
  (bit-and
    (+ (* module-id 2654435761) (* name-id 40503))
    (- tc-source-dotted-alias-key-cache-capacity 1)))

(define (tc-source-dotted-full-path-key-cache-bucket
  [module-id : i64]
  [name-id : i64]) : i64
  (bit-and
    (+ (* module-id 2246822519) (* name-id 3266489917))
    (- tc-source-dotted-full-path-key-cache-capacity 1)))

(define (tc-source-qualified-variant-key-cache-bucket
  [module-id : i64]
  [name-id : i64]) : i64
  (bit-and
    (+ (* module-id 668265263) (* name-id 374761393))
    (- tc-source-qualified-variant-key-cache-capacity 1)))

;; Returns the cached lookup-name id, -1 for no alias import, or -2 when absent.
(define (tc-source-dotted-alias-key-cache-get-for-state
  [state : (& TcSourceKeyCacheState)]
  [table-id : i64]
  [generation : i64]
  [module-id : i64]
  [name-id : i64]) : i64
  (tc-source-dotted-alias-key-cache-ensure-for-state! state table-id generation)
  (let
    [cursor : i64 (tc-source-dotted-alias-key-cache-bucket module-id name-id)]
    [module-key : i64 (+ module-id 1)]
    [name-key : i64 (+ name-id 1)]
    (if (and
      (= (array-ref state.dotted-alias-module-keys cursor) module-key)
      (= (array-ref state.dotted-alias-name-keys cursor) name-key))
      (array-ref state.dotted-alias-values cursor)
      -2)))

;; Returns the cached lookup-name id, -1 for no full path, or -2 when absent.
(define (tc-source-dotted-full-path-key-cache-get-for-state
  [state : (& TcSourceKeyCacheState)]
  [table-id : i64]
  [generation : i64]
  [module-id : i64]
  [name-id : i64]) : i64
  (tc-source-dotted-full-path-key-cache-ensure-for-state!
    state
    table-id
    generation)
  (let
    [cursor : i64
      (tc-source-dotted-full-path-key-cache-bucket module-id name-id)]
    [module-key : i64 (+ module-id 1)]
    [name-key : i64 (+ name-id 1)]
    (if (and
      (= (array-ref state.dotted-full-path-module-keys cursor) module-key)
      (= (array-ref state.dotted-full-path-name-keys cursor) name-key))
      (array-ref state.dotted-full-path-values cursor)
      -2)))

;; Returns the cached lookup-name id, -1 for no variant, or -2 when absent.
(define (tc-source-qualified-variant-key-cache-get-for-state
  [state : (& TcSourceKeyCacheState)]
  [table-id : i64]
  [generation : i64]
  [registry-id : i64]
  [module-id : i64]
  [name-id : i64]) : i64
  (tc-source-qualified-variant-key-cache-ensure-for-state!
    state
    table-id
    generation
    registry-id)
  (let
    [cursor : i64
      (tc-source-qualified-variant-key-cache-bucket module-id name-id)]
    [module-key : i64 (+ module-id 1)]
    [name-key : i64 (+ name-id 1)]
    (if (and
      (= (array-ref state.qualified-variant-module-keys cursor) module-key)
      (= (array-ref state.qualified-variant-name-keys cursor) name-key))
      (array-ref state.qualified-variant-values cursor)
      -2)))

;; Returns the cached registry handle, -1 for no variant, or -2 when absent.
(define (tc-source-qualified-variant-handle-cache-get-for-state
  [state : (& TcSourceKeyCacheState)]
  [table-id : i64]
  [generation : i64]
  [registry-id : i64]
  [module-id : i64]
  [name-id : i64]) : i64
  (tc-source-qualified-variant-key-cache-ensure-for-state!
    state
    table-id
    generation
    registry-id)
  (let
    [cursor : i64
      (tc-source-qualified-variant-key-cache-bucket module-id name-id)]
    [module-key : i64 (+ module-id 1)]
    [name-key : i64 (+ name-id 1)]
    (if (and
      (= (array-ref state.qualified-variant-module-keys cursor) module-key)
      (= (array-ref state.qualified-variant-name-keys cursor) name-key))
      (array-ref state.qualified-variant-handles cursor)
      -2)))

(define (tc-source-dotted-alias-key-cache-put-for-state!
  [state : (& TcSourceKeyCacheState)]
  [table-id : i64]
  [generation : i64]
  [module-id : i64]
  [name-id : i64]
  [value : i64]) : unit
  (tc-source-dotted-alias-key-cache-ensure-for-state! state table-id generation)
  (let
    [cursor : i64 (tc-source-dotted-alias-key-cache-bucket module-id name-id)]
    (owned_view.compiler-owned-cell-set!
      state.dotted-alias-module-keys
      cursor
      (+ module-id 1))
    (owned_view.compiler-owned-cell-set!
      state.dotted-alias-name-keys
      cursor
      (+ name-id 1))
    (owned_view.compiler-owned-cell-set! state.dotted-alias-values cursor value)))

(define (tc-source-dotted-full-path-key-cache-put-for-state!
  [state : (& TcSourceKeyCacheState)]
  [table-id : i64]
  [generation : i64]
  [module-id : i64]
  [name-id : i64]
  [value : i64]) : unit
  (tc-source-dotted-full-path-key-cache-ensure-for-state!
    state
    table-id
    generation)
  (let
    [cursor : i64
      (tc-source-dotted-full-path-key-cache-bucket module-id name-id)]
    (owned_view.compiler-owned-cell-set!
      state.dotted-full-path-module-keys
      cursor
      (+ module-id 1))
    (owned_view.compiler-owned-cell-set!
      state.dotted-full-path-name-keys
      cursor
      (+ name-id 1))
    (owned_view.compiler-owned-cell-set!
      state.dotted-full-path-values
      cursor
      value)))

(define (tc-source-qualified-variant-key-cache-put-for-state!
  [state : (& TcSourceKeyCacheState)]
  [table-id : i64]
  [generation : i64]
  [registry-id : i64]
  [module-id : i64]
  [name-id : i64]
  [value : i64]
  [handle : i64]) : unit
  (tc-source-qualified-variant-key-cache-ensure-for-state!
    state
    table-id
    generation
    registry-id)
  (let
    [cursor : i64
      (tc-source-qualified-variant-key-cache-bucket module-id name-id)]
    (owned_view.compiler-owned-cell-set!
      state.qualified-variant-module-keys
      cursor
      (+ module-id 1))
    (owned_view.compiler-owned-cell-set!
      state.qualified-variant-name-keys
      cursor
      (+ name-id 1))
    (owned_view.compiler-owned-cell-set!
      state.qualified-variant-values
      cursor
      value)
    (owned_view.compiler-owned-cell-set!
      state.qualified-variant-handles
      cursor
      handle)))

;; Serial/test adapters. Production helpers use the explicit-state forms above.
(define (tc-source-dotted-alias-key-cache-reset!) : unit
  (tc-serial-job-state-reset-if-ready!))

(define (tc-source-dotted-full-path-key-cache-reset!) : unit
  (tc-serial-job-state-reset-if-ready!))

(define (tc-source-qualified-variant-key-cache-reset!) : unit
