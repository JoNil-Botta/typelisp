(define (tc-hygiene-global-boundary-name) : String
  "__tl_hygiene_global_boundary")

(define tc-hygiene-global-boundary-id-cache : i64
  -1)
(define tc-hygiene-global-boundary-id-cache-generation : i64
  -1)

(define (tc-hygiene-global-boundary-id) : i64
  (if (= tc-hygiene-global-boundary-id-cache-generation (intern-generation))
    tc-hygiene-global-boundary-id-cache
    (let
      [id : i64 (tc-name-id (tc-hygiene-global-boundary-name))]
      (begin
        (set! tc-hygiene-global-boundary-id-cache id)
        (set!
          tc-hygiene-global-boundary-id-cache-generation
          (intern-generation))
        id))))

(define (tc-hygiene-template-prefix) : String
  "__tl_macro_template$")

(define (tc-hygiene-global-prefix) : String
  "__tl_macro_global$")

(define (tc-hygiene-local-prefix) : String
  "__tl_macro_local$")

(defenum TcHygieneGlobalName
  (TcHygieneLegacyGlobal String)
  (TcHygieneContextGlobal String String))

(define tc-hygiene-active-top-env-ready : bool
  false)

(define (tc-empty-type-env) : TcTypeEnv
  TcTypeNil)

(define (tc-empty-module-local-env-cache) : TcModuleLocalEnvCache
  TcModuleLocalEnvNil)

(define tc-hygiene-active-top-env : TcTypeEnv
  (tc-empty-type-env))
(define tc-hygiene-module-env-cache : TcModuleLocalEnvCache
  (tc-empty-module-local-env-cache))

;; #2357: arena that owns the module-local env cache chain. The cache lives in
;; the GLOBAL above, but hygiene lookups fire deep inside per-decl typechecking
;; whose allocations land in scratch arenas; the cache's (box ...) cells and
;; the cached env internals allocated there dangle once the scratch arena is
;; reclaimed, and a later tl_arena_make reuses the pages (observed: a fresh
;; arena header written over a live cache node, then a garbage module String
;; crashing string-eq). Build cache entries inside this dedicated persistent
;; arena instead (same idiom as the node pools' base arena).
(define tc-hygiene-module-env-cache-arena : i64
  0)

(define (tc-hygiene-module-env-cache-arena-handle) : i64
  (begin
    (if (= tc-hygiene-module-env-cache-arena 0)
      (set! tc-hygiene-module-env-cache-arena (arena-make))
      unit)
    tc-hygiene-module-env-cache-arena))

(define (tc-hygiene-string-prefix? [text : String] [prefix : String]) : bool
  (let
    [text-len : i64 (string-length text)]
    [prefix-len : i64 (string-length prefix)]
    (if (< text-len prefix-len)
      false
      (if (= (string-ref text 0) (string-ref prefix 0))
        (string-eq (substring text 0 prefix-len) prefix)
        false))))

(define (tc-hygiene-name-base [name : String] [prefix : String]) : String
  (substring
    name
    (string-length prefix)
    (- (string-length name) (string-length prefix))))

(define (tc-hygiene-template-name? [name : String]) : bool
  (tc-hygiene-string-prefix? name (tc-hygiene-template-prefix)))

(define (tc-hygiene-template-base [name : String]) : String
  (tc-hygiene-name-base name (tc-hygiene-template-prefix)))

(define (tc-hygiene-global-name? [name : String]) : bool
  (tc-hygiene-string-prefix? name (tc-hygiene-global-prefix)))

(define (tc-hygiene-local-name? [name : String]) : bool
  (tc-hygiene-string-prefix? name (tc-hygiene-local-prefix)))

(define (tc-hygiene-global-base [name : String]) : String
  (tc-hygiene-name-base name (tc-hygiene-global-prefix)))

(define (tc-hygiene-global-name [name : String]) : String
  (string-append (tc-hygiene-global-prefix) name))

(define (tc-hygiene-global-context-name [module : String] [name : String]) : String
  (tc-hygiene-global-name (str-cat module "|" name)))

(define (tc-hygiene-context-separator-index [payload : String]) : i64
  (let
    [i : i64 0]
    [n : i64 (string-length payload)]
    [found : i64 -1]
    (begin
      (while (and (< i n) (< found 0))
        (if (= (cast (string-ref payload i) : i64) 124)
          (set! found i)
          (set! i (+ i 1))))
      found)))

(define (tc-hygiene-global-decode [name : String]) : TcHygieneGlobalName
  (let
    [payload : String (tc-hygiene-global-base name)]
    [sep : i64 (tc-hygiene-context-separator-index payload)]
    (if (< sep 0)
      (TcHygieneLegacyGlobal payload)
      (let
        [start : i64 (+ sep 1)]
        (TcHygieneContextGlobal
          (substring payload 0 sep)
          (substring payload start (- (string-length payload) start)))))))

(define (tc-hygiene-global-call-name [name : String]) : String
  (if (tc-hygiene-global-name? name)
    (match (tc-hygiene-global-decode name)
      [(TcHygieneLegacyGlobal lookup-name) lookup-name]
      [(TcHygieneContextGlobal _ lookup-name) lookup-name])
    name))

(define (tc-hygiene-global-symbol-name [name : String]) : String
  (if (tc-hygiene-global-name? name)
    (match (tc-hygiene-global-decode name)
      [(TcHygieneLegacyGlobal lookup-name) lookup-name]
      [(TcHygieneContextGlobal module lookup-name)
        (if (tc-name-qualified? lookup-name)
          lookup-name
          (compiler-symbol-module-key module lookup-name))])
    name))

(define (tc-hygiene-global-env [top-env : TcTypeEnv]) : TcTypeEnv
  (tc-bind top-env (tc-hygiene-global-boundary-name) (AstTyUnit)))

(define (tc-hygiene-reset-active-top-env! [top-env : TcTypeEnv]) : unit
  (begin
    (set! tc-hygiene-active-top-env top-env)
    (set! tc-hygiene-active-top-env-ready true)
    (set! tc-hygiene-module-env-cache (tc-empty-module-local-env-cache))
    ;; #2357: release the persistent cache arena with the chain it owns; the
    ;; next cache miss creates a fresh one (keeps batch compiles from leaking
    ;; one arena's worth of dead cache entries per program).
    (if (= tc-hygiene-module-env-cache-arena 0)
      unit
      (begin
        (unsafe
          (arena-destroy tc-hygiene-module-env-cache-arena))
        (set! tc-hygiene-module-env-cache-arena 0)))))

(define (tc-unsafe-marker-name) : String
  " __tl_unsafe_context")

(define tc-unsafe-marker-id-cache : i64
  -1)
(define tc-unsafe-marker-id-cache-generation : i64
  -1)

(define (tc-unsafe-marker-id) : i64
  (if (= tc-unsafe-marker-id-cache-generation (intern-generation))
    tc-unsafe-marker-id-cache
    (let
      [id : i64 (tc-name-id (tc-unsafe-marker-name))]
      (begin
        (set! tc-unsafe-marker-id-cache id)
        (set! tc-unsafe-marker-id-cache-generation (intern-generation))
        id))))

(define (tc-enter-unsafe [env : TcTypeEnv]) : TcTypeEnv
  (tc-bind env (tc-unsafe-marker-name) (AstTyUnit)))

(define (tc-in-unsafe-scan? [env : TcTypeEnv]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-in-unsafe-scan? (box-get rest))
        false)]
    [(TcTypeBind key _ rest)
      (if (= key (tc-unsafe-marker-id))
        true
        (tc-in-unsafe-scan? (box-get rest)))]))

(define (tc-in-unsafe? [env : TcTypeEnv]) : bool
  (match env
    [(TcTypeCache _ _ _ _ _ _ _ rest _) (tc-in-unsafe-scan? (box-get rest))]
    [_ (tc-in-unsafe-scan? env)]))

(define tc-unused-unsafe-tracking-enabled : bool
  false)
(define tc-unused-unsafe-current-block : i64
  -1)
(define tc-unused-unsafe-current-path : String
  "")
(define tc-unused-unsafe-target-path : String
  "")
(define tc-unused-unsafe-block-spans : (Array AstSourceSpan)
  (make-array AstSourceSpan 128))
(define tc-unused-unsafe-block-paths : (Array String)
  (make-array String 128))
(define tc-unused-unsafe-block-used : (Array bool)
  (make-array bool 128))
(define tc-unused-unsafe-block-len : i64
  0)

(define (tc-unused-unsafe-no-span) : AstSourceSpan
  (AstSourceSpan 0 0 0 0))

(define (tc-unused-unsafe-tracking-reset! [path : String]) : unit
  (begin
    (set! tc-unused-unsafe-current-block -1)
    (set! tc-unused-unsafe-current-path "")
    (set! tc-unused-unsafe-target-path path)
    (set! tc-unused-unsafe-block-len 0)
    (set! tc-unused-unsafe-tracking-enabled true)))

(define (tc-unused-unsafe-tracking-disable!) : unit
  (begin
    (set! tc-unused-unsafe-tracking-enabled false)
    (set! tc-unused-unsafe-current-block -1)
    (set! tc-unused-unsafe-current-path "")
    (set! tc-unused-unsafe-target-path "")))

(define (tc-unused-unsafe-block-count) : i64
  tc-unused-unsafe-block-len)

(define (tc-unused-unsafe-block-path [index : i64]) : String
  (if (and (>= index 0) (< index tc-unused-unsafe-block-len))
    (array-ref tc-unused-unsafe-block-paths index)
    ""))

(define (tc-unused-unsafe-block-span [index : i64]) : AstSourceSpan
  (if (and (>= index 0) (< index tc-unused-unsafe-block-len))
    (array-ref tc-unused-unsafe-block-spans index)
    (tc-unused-unsafe-no-span)))

(define (tc-unused-unsafe-block-used? [index : i64]) : bool
  (if (and (>= index 0) (< index tc-unused-unsafe-block-len))
    (array-ref tc-unused-unsafe-block-used index)
    false))

(define (tc-unused-unsafe-set-current-path! [path : String]) : String
  (let
    [prev : String tc-unused-unsafe-current-path]
    (begin
      (if tc-unused-unsafe-tracking-enabled
        (set! tc-unused-unsafe-current-path path)
        unit)
      prev)))

(define (tc-unused-unsafe-restore-current-path! [path : String]) : unit
  (if tc-unused-unsafe-tracking-enabled
    (set! tc-unused-unsafe-current-path path)
    unit))

(define (tc-unused-unsafe-span-eq? [a : AstSourceSpan] [b : AstSourceSpan]) : bool
  (and
    (= (struct-get a start-line) (struct-get b start-line))
    (= (struct-get a start-col) (struct-get b start-col))
    (= (struct-get a end-line) (struct-get b end-line))
    (= (struct-get a end-col) (struct-get b end-col))))

(define (tc-unused-unsafe-find-existing
  [path : String]
  [span : AstSourceSpan]
  [index : i64]) : i64
  (if (>= index tc-unused-unsafe-block-len)
    -1
    (if (and
      (string-eq (array-ref tc-unused-unsafe-block-paths index) path)
      (tc-unused-unsafe-span-eq?
        (array-ref tc-unused-unsafe-block-spans index)
        span))
      index
      (tc-unused-unsafe-find-existing path span (+ index 1)))))

(define (tc-unused-unsafe-grow-copy
  [new-spans : (Array AstSourceSpan)]
  [new-paths : (Array String)]
  [new-used : (Array bool)]
  [index : i64]) : unit
  (if (>= index tc-unused-unsafe-block-len)
    unit
    (begin
      (array-set!
        new-spans
        index
        (array-ref tc-unused-unsafe-block-spans index))
      (array-set!
        new-paths
        index
        (array-ref tc-unused-unsafe-block-paths index))
      (array-set! new-used index (array-ref tc-unused-unsafe-block-used index))
      (tc-unused-unsafe-grow-copy new-spans new-paths new-used (+ index 1)))))

(define (tc-unused-unsafe-grow!) : unit
  (let
    [old-cap : i64 (array-length tc-unused-unsafe-block-spans)]
    [new-cap : i64 (* old-cap 2)]
    [new-spans : (Array AstSourceSpan) (make-array AstSourceSpan new-cap)]
    [new-paths : (Array String) (make-array String new-cap)]
    [new-used : (Array bool) (make-array bool new-cap)]
    (begin
      (tc-unused-unsafe-grow-copy new-spans new-paths new-used 0)
      (set! tc-unused-unsafe-block-spans new-spans)
      (set! tc-unused-unsafe-block-paths new-paths)
      (set! tc-unused-unsafe-block-used new-used))))

(define (tc-unused-unsafe-push [span : AstSourceSpan]) : i64
  (let
    [existing : i64
      (tc-unused-unsafe-find-existing tc-unused-unsafe-current-path span 0)]
    (if (>= existing 0)
      existing
      (let
        [slot : i64 tc-unused-unsafe-block-len]
        (begin
          (if (>= slot (array-length tc-unused-unsafe-block-spans))
            (tc-unused-unsafe-grow!)
            unit)
          (array-set! tc-unused-unsafe-block-spans slot span)
          (array-set!
            tc-unused-unsafe-block-paths
            slot
            tc-unused-unsafe-current-path)
          (array-set! tc-unused-unsafe-block-used slot false)
          (set! tc-unused-unsafe-block-len (+ tc-unused-unsafe-block-len 1))
          slot)))))

(define (tc-unused-unsafe-enter-block [span : TcMaybeAstSourceSpan]) : i64
  (let
    [prev : i64 tc-unused-unsafe-current-block]
    (begin
      (if tc-unused-unsafe-tracking-enabled
        (if (string-eq
          tc-unused-unsafe-current-path
          tc-unused-unsafe-target-path)
          (match span
            [(TcSomeAstSourceSpan real-span)
              (set!
                tc-unused-unsafe-current-block
                (tc-unused-unsafe-push real-span))]
            [(TcNoAstSourceSpan) unit])
          unit)
        unit)
      prev)))

(define (tc-unused-unsafe-restore-block! [prev : i64]) : unit
  (if tc-unused-unsafe-tracking-enabled
    (set! tc-unused-unsafe-current-block prev)
    unit))

(define (tc-unused-unsafe-mark-current-used!) : unit
  (if (and
    tc-unused-unsafe-tracking-enabled
    (>= tc-unused-unsafe-current-block 0)
    (< tc-unused-unsafe-current-block tc-unused-unsafe-block-len))
    (array-set! tc-unused-unsafe-block-used tc-unused-unsafe-current-block true)
    unit))

(define (tc-unsafe-begin-list-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [expected : AstType]
  [span : TcMaybeAstSourceSpan]) : ResultTcType
  (let
    [prev : i64 (tc-unused-unsafe-enter-block span)]
    [result : ResultTcType
      (tc-begin-list-with-expected ctx (tc-enter-unsafe env) exprs expected)]
    (begin
      (tc-unused-unsafe-restore-block! prev)
      result)))

(define (tc-unsafe-begin-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [span : TcMaybeAstSourceSpan]) : ResultTcType
  (let
    [prev : i64 (tc-unused-unsafe-enter-block span)]
    [result : ResultTcType (tc-begin-list ctx (tc-enter-unsafe env) exprs)]
    (begin
      (tc-unused-unsafe-restore-block! prev)
      result)))

(define (tc-bind-return-type [env : TcTypeEnv] [ty : AstType]) : TcTypeEnv
  (tc-bind env (tc-return-type-name) ty))

(define (tc-current-return-type-scan [env : TcTypeEnv]) : ResultTcType
  (match env
    [(TcTypeNil)
      (ErrTcType "typecheck: try requires enclosing Result-like function")]
    [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-current-return-type-scan (box-get rest))
        (ErrTcType "typecheck: try requires enclosing Result-like function"))]
    [(TcTypeBind key ty rest)
      (if (= key (tc-return-type-id))
        (OkTcType ty)
        (tc-current-return-type-scan (box-get rest)))]))

(define (tc-current-return-type [env : TcTypeEnv]) : ResultTcType
  (match env
    [(TcTypeCache _ _ _ _ _ _ _ rest _)
      (tc-current-return-type-scan (box-get rest))]
    [_ (tc-current-return-type-scan env)]))

(define (tc-type-list1 [a : AstType]) : AstTypeList
  (ast-type-cons a AstTypeNil))

(define (tc-type-list2 [a : AstType] [b : AstType]) : AstTypeList
  (ast-type-cons a (ast-type-cons b AstTypeNil)))

(define (tc-type-list3 [a : AstType] [b : AstType] [c : AstType]) : AstTypeList
  (ast-type-cons a (ast-type-cons b (ast-type-cons c AstTypeNil))))

(define (tc-fn0 [ret : AstType]) : AstType
  (ast-ty-func AstTypeNil ret))

(define (tc-fn1 [a : AstType] [ret : AstType]) : AstType
  (ast-ty-func (tc-type-list1 a) ret))

(define (tc-fn2 [a : AstType] [b : AstType] [ret : AstType]) : AstType
  (ast-ty-func (tc-type-list2 a b) ret))

(define (tc-fn3 [a : AstType] [b : AstType] [c : AstType] [ret : AstType]) : AstType
  (ast-ty-func (tc-type-list3 a b c) ret))

(define (tc-type-list-render [types : AstTypeList]) : String
  (match types
    [(AstTypeNil) ""]
    [(AstTypeCons head rest)
      (let
        [head : AstType (ty-node-get head)]
        [rest : AstTypeList (box-get rest)]
        (string-append
          (tc-type-render head)
          (match rest
            [(AstTypeNil) ""]
            [_ (string-append " " (tc-type-list-render rest))])))]))

(define (tc-lifetime-list-render [lifetimes : AstLifetimeList]) : String
  (match lifetimes
    [(AstLifetimeNil) ""]
    [(AstLifetimeCons head rest)
      (let
        [rest : AstLifetimeList (box-get rest)]
        (string-append
          head
          (match rest
            [(AstLifetimeNil) ""]
            [_ (string-append " " (tc-lifetime-list-render rest))])))]))

(define (tc-render-nominal-lifetime-type
  [name : String]
  [lifetimes : AstLifetimeList]) : String
  (str-cat
    "("
    name
    (string-append " " (string-append (tc-lifetime-list-render lifetimes) ")"))))

(define (tc-type-render [ty : AstType]) : String
  (match ty
    [(AstTyI64) "i64"]
    [(AstTyI32) "i32"]
    [(AstTyI16) "i16"]
    [(AstTyI8) "i8"]
    [(AstTyU64) "u64"]
    [(AstTyU32) "u32"]
    [(AstTyU16) "u16"]
    [(AstTyU8) "u8"]
    [(AstTyF64) "f64"]
    [(AstTyF32) "f32"]
    [(AstTyBool) "bool"]
    [(AstTyChar) "char"]
    [(AstTyString) "String"]
    [(AstTyStr) "str"]
    [(AstTyBytes) "bytes"]
    [(AstTyUnit) "unit"]
    [(AstTyNever) "never"]
    [(AstTyExpr) "Expr"]
    [(AstTyExprList) "ExprList"]
    [(AstTyFunc args ret)
      (str-cat
        "(-> "
        (tc-type-list-render (box-get args))
        (string-append
          " "
          (string-append (tc-type-render (ty-node-get ret)) ")")))]
    [(AstTyTuple elems)
      (str-cat "(Tuple " (tc-type-list-render (box-get elems)) ")")]
    [(AstTyArray elem count)
      (str-cat
        "(Array "
        (tc-type-render (ty-node-get elem))
        " "
        (int->string count)
        ")")]
    [(AstTyDynArray elem)
      (str-cat "(Array " (tc-type-render (ty-node-get elem)) ")")]
    [(AstTyBox elem) (str-cat "(Box " (tc-type-render (ty-node-get elem)) ")")]
    [(AstTyPtr elem) (str-cat "(Ptr " (tc-type-render (ty-node-get elem)) ")")]
    [(AstTyMutPtr elem)
      (str-cat "(MutPtr " (tc-type-render (ty-node-get elem)) ")")]
    [(AstTyRef region inner)
      (str-cat
        "(& "
        region
        (string-append
          " "
          (string-append (tc-type-render (ty-node-get inner)) ")")))]
    [(AstTyMutRef region inner)
      (str-cat
        "(&mut "
        region
        (string-append
          " "
          (string-append (tc-type-render (ty-node-get inner)) ")")))]
    [(AstTyRegion region inner)
      (str-cat
        "(Region "
        region
        (string-append
          " "
          (string-append (tc-type-render (ty-node-get inner)) ")")))]
    [(AstTyEnum name) (intern-str name)]
    [(AstTyEnumArgs name lifetimes)
      (tc-render-nominal-lifetime-type (intern-str name) (box-get lifetimes))]
    [(AstTyStruct name) (intern-str name)]
    [(AstTyStructArgs name lifetimes)
      (tc-render-nominal-lifetime-type (intern-str name) (box-get lifetimes))]
    [(AstTyVar name) (intern-str name)]
    [(AstTyVarArgs name lifetimes)
      (tc-render-nominal-lifetime-type (intern-str name) (box-get lifetimes))]))

(define (tc-default-env) : TcTypeEnv
  (tc-bind (tc-default-env-base) (tc-default-boundary-name) (AstTyUnit)))

(define (tc-default-env-base) : TcTypeEnv
  (let
    [e0 : TcTypeEnv (tc-empty-env)]
    [e1 : TcTypeEnv
      (tc-bind e0 "string-length" (tc-fn1 (AstTyString) (AstTyI64)))]
    [e2 : TcTypeEnv (tc-bind e1 "length" (tc-fn1 (AstTyString) (AstTyI64)))]
    [e3 : TcTypeEnv
      (tc-bind e2 "string-eq" (tc-fn2 (AstTyString) (AstTyString) (AstTyBool)))]
    [e4 : TcTypeEnv
      (tc-bind e3 "string=?" (tc-fn2 (AstTyString) (AstTyString) (AstTyBool)))]
    [e5 : TcTypeEnv
      (tc-bind e4 "string->int" (tc-fn1 (AstTyString) (AstTyI64)))]
    [e6 : TcTypeEnv
      (tc-bind
        (tc-bind
          e5
          "cpuid"
          (tc-fn2
            (AstTyI64)
            (AstTyI64)
            (ast-ty-tuple
              (ast-type-cons
                (AstTyI32)
                (ast-type-cons
                  (AstTyI32)
                  (ast-type-cons
                    (AstTyI32)
                    (ast-type-cons (AstTyI32) (AstTypeNil))))))))
        "xgetbv"
        (tc-fn1 (AstTyI64) (AstTyI64)))]
    (tc-bind e6 (tc-default-boundary-name) (AstTyUnit))))

(define (tc-macro-expr-clause-type) : AstType
  (AstTyVar (intern "ExprClause")))

(define (tc-macro-expr-clause-list-type) : AstType
  (AstTyVar (intern "ExprClauseList")))

(define (tc-macro-expr-clause-type? [ty : AstType]) : bool
  (match ty
    [(AstTyVar name) (= name (intern "ExprClause"))]
    [_ false]))

(define (tc-macro-expr-clause-list-type? [ty : AstType]) : bool
  (match ty
    [(AstTyVar name) (= name (intern "ExprClauseList"))]
    [_ false]))

(define (tc-macro-type-param-kind? [ty : AstType]) : bool
  (match ty
    [(AstTyVar name) (= name (intern "type"))]
    [_ false]))

(define (tc-type-unquote-marker? [ty : AstType]) : bool
  (match ty
    [(AstTyVarArgs name _) (= name (intern "unquote"))]
    [_ false]))

(define (tc-stdlib-comptime-module-name) : String
  "stdlib.comptime")

(define (tc-stdlib-comptime-type-key [name : String]) : String
  (compiler-symbol-module-key (tc-stdlib-comptime-module-name) name))

(define (tc-stdlib-comptime-type-display-name [name : String]) : String
  (str-cat (tc-stdlib-comptime-module-name) "." name))

(define (tc-stdlib-comptime-syntax-type [canonical-name : String]) : AstMaybeType
  (cond
    [(string-eq canonical-name (tc-stdlib-comptime-type-key "Expr"))
      (AstSomeType (AstTyExpr))]
    [(string-eq canonical-name (tc-stdlib-comptime-type-key "ExprList"))
      (AstSomeType (AstTyExprList))]
    [(string-eq canonical-name (tc-stdlib-comptime-type-key "ExprClause"))
      (AstSomeType (tc-macro-expr-clause-type))]
    [(string-eq canonical-name (tc-stdlib-comptime-type-key "ExprClauseList"))
      (AstSomeType (tc-macro-expr-clause-list-type))]
    [else (AstNoType)]))

(defenum TcStdlibFieldSpecList
  (TcStdlibFieldSpecNil)
  (TcStdlibFieldSpecCons String AstType (Box TcStdlibFieldSpecList)))

(defenum TcStdlibVariantSpecList
  (TcStdlibVariantSpecNil)
  (TcStdlibVariantSpecCons String AstTypeList (Box TcStdlibVariantSpecList)))

(define (tc-stdlib-field-spec-cons
  [name : String]
  [ty : AstType]
  [rest : TcStdlibFieldSpecList]) : TcStdlibFieldSpecList
  (TcStdlibFieldSpecCons name ty (box rest)))

(define (tc-stdlib-variant-spec-cons
  [name : String]
  [payloads : AstTypeList]
  [rest : TcStdlibVariantSpecList]) : TcStdlibVariantSpecList
  (TcStdlibVariantSpecCons name payloads (box rest)))

(define (tc-stdlib-name-type [name : String]) : AstType
  (AstTyVar (intern name)))

(define (tc-stdlib-box-name-type [name : String]) : AstType
  (ast-ty-box (tc-stdlib-name-type name)))

(define (tc-stdlib-array-name-type [name : String]) : AstType
  (ast-ty-dyn-array (tc-stdlib-name-type name)))

(define (tc-stdlib-well-known-mismatch [type-name : String] [detail : String]) : ResultTcUnit
  (ErrTcUnit
    (str-cat
      "typecheck: stdlib well-known type mismatch for "
      (tc-stdlib-comptime-type-display-name type-name)
      ": "
      detail)))

(define (tc-stdlib-comptime-generated-metadata-message) : String
  "expected comptime-decl generated metadata stdlib/comptime-well-known \"v0\"")

(define (tc-stdlib-comptime-version-arg? [args : AstExprList]) : bool
  (match args
    [(AstExprCons head rest)
      (match (box-get rest)
        [(AstExprNil)
          (match (ast-expr-unspan (ast-node-get head))
            [(AstExprLiteral (AstLitString version)) (string-eq version "v0")]
            [_ false])]
        [_ false])]
    [_ false]))

(define (tc-stdlib-comptime-generated-meta-ok?
  [type-name : String]
  [meta : AstGeneratedDeclMeta]) : bool
  (match meta
    [(AstSomeGeneratedDeclMeta generator item args _)
      (and
        (string-eq generator "stdlib/comptime-well-known")
        (string-eq item type-name)
        (tc-stdlib-comptime-version-arg? args))]
    [(AstNoGeneratedDeclMeta) false]))

(define (tc-stdlib-comptime-well-known-type? [type-name : String]) : bool
  (or
    (string-eq type-name "Expr")
    (string-eq type-name "ExprList")
    (string-eq type-name "ExprClause")
    (string-eq type-name "ExprClauseList")
    (string-eq type-name "TypeInfo")
    (string-eq type-name "TypeInfoList")
    (string-eq type-name "TypeField")
    (string-eq type-name "TypeFieldList")
    (string-eq type-name "TypeVariantPayload")
    (string-eq type-name "TypeVariantPayloadList")
    (string-eq type-name "TypeVariant")
    (string-eq type-name "TypeVariantList")
    (string-eq type-name "TypeParam")
    (string-eq type-name "TypeParamList")))

(define (tc-stdlib-comptime-raw-type-name [decl : AstDecl]) : TcMaybeString
  (match decl
    [(AstDeclComptimeDecl _ template-box)
      (tc-stdlib-comptime-raw-type-name (box-get template-box))]
    [(AstDeclUnsafe inner-box)
      (tc-stdlib-comptime-raw-type-name (box-get inner-box))]
    [(AstDeclDefEnum name _ _) (TcSomeString (intern-str name))]
    [(AstDeclDefEnumLifetimes name _ _ _) (TcSomeString (intern-str name))]
    [(AstDeclDefStruct name _ _ _) (TcSomeString (intern-str name))]
    [(AstDeclDefStructLifetimes name _ _ _ _) (TcSomeString (intern-str name))]
    [_ (TcNoString)]))

(define (tc-stdlib-comptime-raw-meta-ok? [type-name : String] [decl : AstDecl]) : bool
  (match decl
    [(AstDeclComptimeDecl meta _)
      (tc-stdlib-comptime-generated-meta-ok? type-name meta)]
    [(AstDeclUnsafe inner-box)
      (tc-stdlib-comptime-raw-meta-ok? type-name (box-get inner-box))]
    [_ false]))

(define (tc-stdlib-check-comptime-metadata-decl
  [module : String]
  [decl : AstDecl]) : ResultTcUnit
  (if (not (string-eq module (tc-stdlib-comptime-module-name)))
    OkTcUnit
    (match (tc-stdlib-comptime-raw-type-name decl)
      [(TcNoString) OkTcUnit]
      [(TcSomeString type-name)
        (if (not (tc-stdlib-comptime-well-known-type? type-name))
          OkTcUnit
          (if (tc-stdlib-comptime-raw-meta-ok? type-name decl)
            OkTcUnit
            (tc-stdlib-well-known-mismatch
              type-name
              (tc-stdlib-comptime-generated-metadata-message))))])))

(define (tc-stdlib-check-comptime-metadata-list
  [decls : AstDeclList]
  [module : String]) : ResultTcUnit
  (match decls
    [(AstDeclNil) OkTcUnit]
    [(AstDeclCons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDeclModule module-id)
            (tc-stdlib-check-comptime-metadata-list rest (intern-str module-id))]
          [_
            (match (tc-stdlib-check-comptime-metadata-decl module decl)
              [(OkTcUnit) (tc-stdlib-check-comptime-metadata-list rest module)]
              [(ErrTcUnit message) (ErrTcUnit message)])]))]))

(define (tc-stdlib-check-comptime-metadata [ctx : TcContext]) : ResultTcUnit
  (match (tc-context-program ctx)
    [(AstProgram decls-box)
      (tc-stdlib-check-comptime-metadata-list (box-get decls-box) "")]))

(define (tc-stdlib-type-match?
  [ctx : TcContext]
  [actual : AstType]
  [expected : AstType]) : bool
  (tc-type-eq (tc-resolve-type ctx actual) (tc-resolve-type ctx expected)))

(define (tc-stdlib-check-field-specs
  [ctx : TcContext]
  [type-name : String]
  [fields : AstFieldDefList]
  [specs : TcStdlibFieldSpecList]
  [index : i64]) : ResultTcUnit
  (match specs
    [(TcStdlibFieldSpecNil)
      (match fields
        [(AstFieldDefNil) OkTcUnit]
        [_ (tc-stdlib-well-known-mismatch type-name "unexpected extra field")])]
    [(TcStdlibFieldSpecCons expected-name expected-ty rest-specs)
      (match fields
        [(AstFieldDefNil)
          (tc-stdlib-well-known-mismatch
            type-name
            (str-cat "missing field " expected-name))]
        [(AstFieldDefCons field rest-fields)
          (let
            [rest-fields : AstFieldDefList (box-get rest-fields)]
            [rest-specs : TcStdlibFieldSpecList (box-get rest-specs)]
            (match field
              [(AstFieldDef actual-name actual-ty _)
                (if (not (string-eq (intern-str actual-name) expected-name))
                  (tc-stdlib-well-known-mismatch
                    type-name
                    (str-cat
                      "expected field "
                      expected-name
                      " at index "
                      (int->string index)))
                  (if (tc-stdlib-type-match? ctx actual-ty expected-ty)
                    (tc-stdlib-check-field-specs
                      ctx
                      type-name
                      rest-fields
                      rest-specs
                      (+ index 1))
                    (tc-stdlib-well-known-mismatch
                      type-name
                      (str-cat
                        "expected field "
                        expected-name
                        " type "
                        (tc-type-render (tc-resolve-type ctx expected-ty))))))]))])]))

(define (tc-stdlib-check-payload-specs
  [ctx : TcContext]
  [type-name : String]
  [variant-name : String]
  [actual : AstTypeList]
  [expected : AstTypeList]
  [index : i64]) : ResultTcUnit
  (if (!= (tc-type-list-len actual) (tc-type-list-len expected))
    (tc-stdlib-well-known-mismatch
      type-name
      (str-cat "payload arity mismatch for variant " variant-name))
    (if (= index (tc-type-list-len expected))
      OkTcUnit
      (match (tc-type-list-ref actual index)
        [(OkTcType actual-ty)
          (match (tc-type-list-ref expected index)
            [(OkTcType expected-ty)
              (if (tc-stdlib-type-match? ctx actual-ty expected-ty)
                (tc-stdlib-check-payload-specs
                  ctx
                  type-name
                  variant-name
                  actual
                  expected
                  (+ index 1))
                (tc-stdlib-well-known-mismatch
                  type-name
                  (str-cat
                    "payload type mismatch for variant "
                    variant-name
                    " at index "
                    (int->string index))))]
            [(ErrTcType message)
              (tc-stdlib-well-known-mismatch type-name message)])]
        [(ErrTcType message) (tc-stdlib-well-known-mismatch type-name message)]))))

(define (tc-stdlib-check-variant-specs
  [ctx : TcContext]
  [type-name : String]
  [variants : AstVariantDefList]
  [specs : TcStdlibVariantSpecList]
  [index : i64]) : ResultTcUnit
  (match specs
    [(TcStdlibVariantSpecNil)
      (match variants
        [(AstVariantDefNil) OkTcUnit]
        [_ (tc-stdlib-well-known-mismatch type-name "unexpected extra variant")])]
    [(TcStdlibVariantSpecCons expected-name expected-payloads rest-specs)
      (match variants
        [(AstVariantDefNil)
          (tc-stdlib-well-known-mismatch
            type-name
            (str-cat "missing variant " expected-name))]
        [(AstVariantDefCons variant rest-variants)
          (let
            [rest-variants : AstVariantDefList (box-get rest-variants)]
            [rest-specs : TcStdlibVariantSpecList (box-get rest-specs)]
            (match variant
              [(AstVariantDef actual-name actual-payloads _)
                (if (not (string-eq (intern-str actual-name) expected-name))
                  (tc-stdlib-well-known-mismatch
                    type-name
                    (str-cat
                      "expected variant "
                      expected-name
                      " at index "
                      (int->string index)))
                  (match (tc-stdlib-check-payload-specs
                    ctx
                    type-name
                    expected-name
                    actual-payloads
                    expected-payloads
                    0)
                    [(OkTcUnit)
                      (tc-stdlib-check-variant-specs
                        ctx
                        type-name
                        rest-variants
                        rest-specs
                        (+ index 1))]
                    [(ErrTcUnit message) (ErrTcUnit message)]))]))])]))

(define (tc-stdlib-check-struct
  [ctx : TcContext]
  [type-name : String]
  [specs : TcStdlibFieldSpecList]) : ResultTcUnit
  (match (compiler-symbols-lookup-type-in-module
    (tc-context-symbols ctx)
    (tc-stdlib-comptime-module-name)
    type-name)
    [(SomeI64 handle)
      (match (compiler-symbols-decl-at-index
        (tc-context-symbols ctx)
        (compiler-symbol-handle-index handle))
        [(OkAstDecl decl)
          (match decl
            [(AstDeclDefStruct _ _ _ fields)
              (tc-stdlib-check-field-specs
                (tc-context-with-module ctx (tc-stdlib-comptime-module-name))
                type-name
                fields
                specs
                0)]
            [_ (tc-stdlib-well-known-mismatch type-name "expected defstruct")])]
        [(ErrAstDecl message) (tc-stdlib-well-known-mismatch type-name message)])]
    [(NoneI64) (tc-stdlib-well-known-mismatch type-name "missing declaration")]))

(define (tc-stdlib-check-enum
  [ctx : TcContext]
  [type-name : String]
  [specs : TcStdlibVariantSpecList]) : ResultTcUnit
  (match (compiler-symbols-lookup-type-in-module
    (tc-context-symbols ctx)
    (tc-stdlib-comptime-module-name)
    type-name)
    [(SomeI64 handle)
      (match (compiler-symbols-decl-at-index
        (tc-context-symbols ctx)
        (compiler-symbol-handle-index handle))
        [(OkAstDecl decl)
          (match decl
            [(AstDeclDefEnum _ _ variants)
              (tc-stdlib-check-variant-specs
                (tc-context-with-module ctx (tc-stdlib-comptime-module-name))
                type-name
                variants
                specs
                0)]
            [_ (tc-stdlib-well-known-mismatch type-name "expected defenum")])]
        [(ErrAstDecl message) (tc-stdlib-well-known-mismatch type-name message)])]
    [(NoneI64) (tc-stdlib-well-known-mismatch type-name "missing declaration")]))

(define (tc-stdlib-comptime-present? [ctx : TcContext]) : bool
  (or
    (match (compiler-symbols-lookup-type-in-module
      (tc-context-symbols ctx)
      (tc-stdlib-comptime-module-name)
      "Expr")
      [(SomeI64 _) true]
      [(NoneI64) false])
    (match (compiler-symbols-lookup-type-in-module
      (tc-context-symbols ctx)
      (tc-stdlib-comptime-module-name)
      "TypeInfo")
      [(SomeI64 _) true]
      [(NoneI64) false])))

(define (tc-stdlib-expr-specs) : TcStdlibVariantSpecList
  (tc-stdlib-variant-spec-cons
    "ExprBool"
    (tc-type-list1 (AstTyBool))
    (tc-stdlib-variant-spec-cons
      "ExprInt"
      (tc-type-list1 (AstTyI64))
      (tc-stdlib-variant-spec-cons
        "ExprVar"
        (tc-type-list1 (AstTyString))
        (tc-stdlib-variant-spec-cons
          "ExprSplice"
          (tc-type-list1 (tc-stdlib-box-name-type "Expr"))
          (tc-stdlib-variant-spec-cons
            "ExprIf"
            (tc-type-list3
              (tc-stdlib-box-name-type "Expr")
              (tc-stdlib-box-name-type "Expr")
              (tc-stdlib-box-name-type "Expr"))
            (tc-stdlib-variant-spec-cons
              "ExprCall"
              (tc-type-list2
                (tc-stdlib-box-name-type "Expr")
                (tc-stdlib-name-type "ExprList"))
              (tc-stdlib-variant-spec-cons
                "ExprBegin"
                (tc-type-list1 (tc-stdlib-name-type "ExprList"))
                (tc-stdlib-variant-spec-cons
                  "ExprQuote"
                  (tc-type-list1 (tc-stdlib-box-name-type "Expr"))
                  (tc-stdlib-variant-spec-cons
                    "ExprQuasiquote"
                    (tc-type-list1 (tc-stdlib-box-name-type "Expr"))
                    (tc-stdlib-variant-spec-cons
                      "ExprUnquote"
                      (tc-type-list1 (tc-stdlib-box-name-type "Expr"))
                      (tc-stdlib-variant-spec-cons
                        "ExprUnquoteSplicing"
                        (tc-type-list1 (tc-stdlib-box-name-type "Expr"))
                        (TcStdlibVariantSpecNil)))))))))))))

(define (tc-stdlib-sequence-fields [elem-name : String]) : TcStdlibFieldSpecList
  (tc-stdlib-field-spec-cons
    "items"
    (tc-stdlib-array-name-type elem-name)
    (tc-stdlib-field-spec-cons "len" (AstTyI64) (TcStdlibFieldSpecNil))))

(define (tc-stdlib-type-info-specs) : TcStdlibVariantSpecList
  (tc-stdlib-variant-spec-cons
    "TypeInfoBuiltin"
    (tc-type-list1 (AstTyString))
    (tc-stdlib-variant-spec-cons
      "TypeInfoArray"
      (tc-type-list2 (tc-stdlib-box-name-type "TypeInfo") (AstTyI64))
      (tc-stdlib-variant-spec-cons
        "TypeInfoDynArray"
        (tc-type-list1 (tc-stdlib-box-name-type "TypeInfo"))
        (tc-stdlib-variant-spec-cons
          "TypeInfoFunction"
          (tc-type-list2
            (tc-stdlib-name-type "TypeInfoList")
            (tc-stdlib-box-name-type "TypeInfo"))
          (tc-stdlib-variant-spec-cons
            "TypeInfoTuple"
            (tc-type-list1 (tc-stdlib-name-type "TypeInfoList"))
            (tc-stdlib-variant-spec-cons
              "TypeInfoStruct"
              (tc-type-list2
                (AstTyString)
                (tc-stdlib-name-type "TypeFieldList"))
              (tc-stdlib-variant-spec-cons
                "TypeInfoEnum"
                (tc-type-list2
                  (AstTyString)
                  (tc-stdlib-name-type "TypeVariantList"))
                (tc-stdlib-variant-spec-cons
                  "TypeInfoOpaque"
                  (tc-type-list1 (AstTyString))
                  (TcStdlibVariantSpecNil))))))))))

(define (tc-stdlib-comptime-surface-ok [ctx : TcContext]) : ResultTcUnit
  (if (not (tc-stdlib-comptime-present? ctx))
    OkTcUnit
    (match (tc-stdlib-check-comptime-metadata ctx)
      [(OkTcUnit)
        (match (tc-stdlib-check-enum ctx "Expr" (tc-stdlib-expr-specs))
          [(OkTcUnit)
            (match (tc-stdlib-check-struct
              ctx
              "ExprList"
              (tc-stdlib-sequence-fields "Expr"))
              [(OkTcUnit)
                (match (tc-stdlib-check-struct
                  ctx
                  "ExprClause"
                  (tc-stdlib-field-spec-cons
                    "first"
                    (tc-stdlib-name-type "Expr")
                    (tc-stdlib-field-spec-cons
                      "second"
                      (tc-stdlib-name-type "Expr")
                      (TcStdlibFieldSpecNil))))
                  [(OkTcUnit)
                    (match (tc-stdlib-check-struct
                      ctx
                      "ExprClauseList"
                      (tc-stdlib-sequence-fields "ExprClause"))
                      [(OkTcUnit)
                        (match (tc-stdlib-check-struct
                          ctx
                          "TypeInfoList"
                          (tc-stdlib-sequence-fields "TypeInfo"))
                          [(OkTcUnit)
                            (match (tc-stdlib-check-struct
                              ctx
                              "TypeField"
                              (tc-stdlib-field-spec-cons
                                "name"
                                (AstTyString)
                                (tc-stdlib-field-spec-cons
                                  "ty"
                                  (tc-stdlib-name-type "TypeInfo")
                                  (TcStdlibFieldSpecNil))))
                              [(OkTcUnit)
                                (match (tc-stdlib-check-struct
                                  ctx
                                  "TypeFieldList"
                                  (tc-stdlib-sequence-fields "TypeField"))
                                  [(OkTcUnit)
                                    (match (tc-stdlib-check-struct
                                      ctx
                                      "TypeVariantPayload"
                                      (tc-stdlib-field-spec-cons
                                        "ty"
                                        (tc-stdlib-name-type "TypeInfo")
                                        (TcStdlibFieldSpecNil)))
                                      [(OkTcUnit)
                                        (match (tc-stdlib-check-struct
                                          ctx
                                          "TypeVariantPayloadList"
                                          (tc-stdlib-sequence-fields
                                            "TypeVariantPayload"))
                                          [(OkTcUnit)
                                            (match (tc-stdlib-check-struct
                                              ctx
                                              "TypeVariant"
                                              (tc-stdlib-field-spec-cons
                                                "name"
                                                (AstTyString)
                                                (tc-stdlib-field-spec-cons
                                                  "payloads"
                                                  (tc-stdlib-name-type
                                                    "TypeVariantPayloadList")
                                                  (TcStdlibFieldSpecNil))))
                                              [(OkTcUnit)
                                                (match (tc-stdlib-check-struct
                                                  ctx
                                                  "TypeVariantList"
                                                  (tc-stdlib-sequence-fields
                                                    "TypeVariant"))
                                                  [(OkTcUnit)
                                                    (match (tc-stdlib-check-struct
                                                      ctx
                                                      "TypeParam"
                                                      (tc-stdlib-field-spec-cons
                                                        "name"
                                                        (AstTyString)
                                                        (tc-stdlib-field-spec-cons
                                                          "ty"
                                                          (tc-stdlib-name-type
                                                            "TypeInfo")
                                                          (TcStdlibFieldSpecNil))))
                                                      [(OkTcUnit)
                                                        (match (tc-stdlib-check-struct
                                                          ctx
                                                          "TypeParamList"
                                                          (tc-stdlib-sequence-fields
                                                            "TypeParam"))
                                                          [(OkTcUnit)
                                                            (tc-stdlib-check-enum
                                                              ctx
                                                              "TypeInfo"
                                                              (tc-stdlib-type-info-specs))]
                                                          [(ErrTcUnit message)
                                                            (ErrTcUnit message)])]
                                                      [(ErrTcUnit message)
                                                        (ErrTcUnit message)])]
                                                  [(ErrTcUnit message)
                                                    (ErrTcUnit message)])]
                                              [(ErrTcUnit message)
                                                (ErrTcUnit message)])]
                                          [(ErrTcUnit message)
                                            (ErrTcUnit message)])]
                                      [(ErrTcUnit message) (ErrTcUnit message)])]
                                  [(ErrTcUnit message) (ErrTcUnit message)])]
                              [(ErrTcUnit message) (ErrTcUnit message)])]
                          [(ErrTcUnit message) (ErrTcUnit message)])]
                      [(ErrTcUnit message) (ErrTcUnit message)])]
                  [(ErrTcUnit message) (ErrTcUnit message)])]
              [(ErrTcUnit message) (ErrTcUnit message)])]
          [(ErrTcUnit message) (ErrTcUnit message)])]
      [(ErrTcUnit message) (ErrTcUnit message)])))

(define (tc-macro-helper-env [env : TcTypeEnv]) : TcTypeEnv
  (let
    [expr : AstType (AstTyExpr)]
    [clause : AstType (tc-macro-expr-clause-type)]
    [clause-list : AstType (tc-macro-expr-clause-list-type)]
    [out : TcTypeEnv env]
    (begin
      (set!
        out
        (tc-bind
          out
          "string-append"
          (tc-fn2 (AstTyString) (AstTyString) (AstTyString))))
      (set!
        out
        (tc-bind
          out
          "string-concat"
          (tc-fn2 (AstTyString) (AstTyString) (AstTyString))))
      (set! out (tc-bind out "int->string" (tc-fn1 (AstTyI64) (AstTyString))))
      (set! out (tc-bind out "expr-bool" (tc-fn1 (AstTyBool) expr)))
      (set! out (tc-bind out "expr-int" (tc-fn1 (AstTyI64) expr)))
      (set! out (tc-bind out "expr-var" (tc-fn1 (AstTyString) expr)))
      (set! out (tc-bind out "expr-splice" (tc-fn1 expr expr)))
      (set! out (tc-bind out "expr-if" (tc-fn3 expr expr expr expr)))
      (set! out (tc-bind out "type-kind" (tc-fn1 expr (AstTyString))))
      (set! out (tc-bind out "type-key" (tc-fn1 expr (AstTyString))))
      (set! out (tc-bind out "expr-bool?" (tc-fn1 expr (AstTyBool))))
      (set! out (tc-bind out "expr-bool-value" (tc-fn1 expr (AstTyBool))))
      (set! out (tc-bind out "expr-if?" (tc-fn1 expr (AstTyBool))))
      (set! out (tc-bind out "expr-if-cond" (tc-fn1 expr expr)))
      (set! out (tc-bind out "expr-if-then" (tc-fn1 expr expr)))
      (set! out (tc-bind out "expr-if-else" (tc-fn1 expr expr)))
      (set!
        out
        (tc-bind out "expr-list-empty?" (tc-fn1 (AstTyExprList) (AstTyBool))))
      (set!
        out
        (tc-bind out "expr-list-length" (tc-fn1 (AstTyExprList) (AstTyI64))))
      (set! out (tc-bind out "expr-list-head" (tc-fn1 (AstTyExprList) expr)))
      (set!
        out
        (tc-bind out "expr-list-tail" (tc-fn1 (AstTyExprList) (AstTyExprList))))
      (set!
        out
        (tc-bind out "expr-list-nth" (tc-fn2 (AstTyExprList) (AstTyI64) expr)))
      (set! out (tc-bind out "expr-clause-first" (tc-fn1 clause expr)))
      (set! out (tc-bind out "expr-clause-second" (tc-fn1 clause expr)))
      (set!
        out
        (tc-bind out "expr-clause-list-empty?" (tc-fn1 clause-list (AstTyBool))))
      (set!
        out
        (tc-bind out "expr-clause-list-length" (tc-fn1 clause-list (AstTyI64))))
      (set!
        out
        (tc-bind out "expr-clause-list-head" (tc-fn1 clause-list clause)))
      (set!
        out
        (tc-bind out "expr-clause-list-tail" (tc-fn1 clause-list clause-list)))
      (set!
        out
        (tc-bind
          out
          "expr-clause-list-nth"
          (tc-fn2 clause-list (AstTyI64) clause)))
      (set!
        out
        (tc-bind
          out
          "expr-clause-list->expr-list"
          (tc-fn1 clause-list (AstTyExprList))))
      out)))

(define (tc-lookup-id [env : TcTypeEnv] [name-id : i64]) : ResultTcType
  (match env
    [(TcTypeNil)
      (ErrTcType
        (string-append "typecheck: unbound name " (intern-str name-id)))]
    [(TcTypeCache ids values _ _ _ _ partial _ below)
      (match (i64-i64-map-get ids name-id)
        ;; #2357: MUST stay `array-ref` -- with #1867 inline-by-value `AstType` is
        ;; a multi-word value and the raw ptr-offset/ptr-read path mis-scales the
        ;; element stride, reading garbage.
        [(I64I64MapFound index) (OkTcType (array-ref values index))]
        [(I64I64MapMissing)
          (if partial
            (tc-lookup-id (box-get below) name-id)
            (ErrTcType
              (string-append "typecheck: unbound name " (intern-str name-id))))])]
    [(TcTypeBind key ty rest)
      (if (= key name-id)
        (OkTcType ty)
        (tc-lookup-id (box-get rest) name-id))]))

(define (tc-lookup [env : TcTypeEnv] [name : String]) : ResultTcType
  (tc-lookup-id env (tc-name-id name)))

(define (tc-name-bound-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache ids _ _ _ _ _ partial _ below)
      (match (i64-i64-map-get ids name-id)
        [(I64I64MapFound _) true]
        [(I64I64MapMissing)
          (if partial
            (tc-name-bound-id? (box-get below) name-id)
            false)])]
    [(TcTypeBind key _ rest)
      (if (= key name-id)
        true
        (tc-name-bound-id? (box-get rest) name-id))]))

(define (tc-lookup-unsafe-id [env : TcTypeEnv] [name-id : i64]) : ResultTcTypeUnsafe
  (match env
    [(TcTypeNil)
      (ErrTcTypeUnsafe
        (string-append "typecheck: unbound name " (intern-str name-id)))]
    [(TcTypeCache ids values unsafe-flags _ _ _ partial _ below)
      (match (i64-i64-map-get ids name-id)
        ;; #2357: AstType read MUST stay `array-ref` (inline-by-value multi-word
        ;; value); the `unsafe-flags` i64 read below is scalar so the raw ptr path
        ;; is still sound there.
        [(I64I64MapFound index)
          (OkTcTypeUnsafe
            (array-ref values index)
            (=
              (unsafe
                (ptr-read
                  (ptr-offset
                    (ptr-cast (array-data unsafe-flags) : (Ptr i64))
                    index)))
              1))]
        [(I64I64MapMissing)
          (if partial
            (tc-lookup-unsafe-id (box-get below) name-id)
            (ErrTcTypeUnsafe
              (string-append "typecheck: unbound name " (intern-str name-id))))])]
    [(TcTypeBind key ty rest)
      (if (= key name-id)
        (OkTcTypeUnsafe
          ty
          (tc-binding-unsafe-marker-head-id? (box-get rest) name-id))
        (tc-lookup-unsafe-id (box-get rest) name-id))]))

(define (tc-lookup-unsafe [env : TcTypeEnv] [name : String]) : ResultTcTypeUnsafe
  (tc-lookup-unsafe-id env (tc-name-id name)))

(define (tc-lookup-visible-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : ResultTcType
  (let
    [name : String (intern-str name-id)]
    (match (tc-lookup-id env name-id)
      [(OkTcType ty)
        (match (tc-qualified-value-visible-ok ctx name)
          [(OkTcUnit) (OkTcType ty)]
          [(ErrTcUnit message) (ErrTcType message)])]
      [(ErrTcType message) (ErrTcType message)])))

(define (tc-lookup-visible [ctx : TcContext] [env : TcTypeEnv] [name : String]) : ResultTcType
  (tc-lookup-visible-id ctx env (tc-name-id name)))

(define (tc-lookup-hygiene-global-scan
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [name-id : i64]) : ResultTcType
  (match env
    [(TcTypeNil) (tc-lookup-id root name-id)]
    [(TcTypeCache _ _ _ _ _ _ _ rest _)
      (tc-lookup-hygiene-global-scan root (box-get rest) name-id)]
    [(TcTypeBind key _ rest)
      (if (= key (tc-hygiene-global-boundary-id))
        (tc-lookup-id (box-get rest) name-id)
        (tc-lookup-hygiene-global-scan root (box-get rest) name-id))]))

(define (tc-lookup-hygiene-global-id [env : TcTypeEnv] [name-id : i64]) : ResultTcType
  (tc-lookup-hygiene-global-scan env env name-id))

(define (tc-lookup-hygiene-global [env : TcTypeEnv] [name : String]) : ResultTcType
  (tc-lookup-hygiene-global-id env (tc-name-id name)))

(define (tc-lookup-hygiene-global-visible-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : ResultTcType
  (let
    [name : String (intern-str name-id)]
    (match (tc-lookup-hygiene-global-id env name-id)
      [(OkTcType ty)
        (match (tc-qualified-value-visible-ok ctx name)
          [(OkTcUnit) (OkTcType ty)]
          [(ErrTcUnit message) (ErrTcType message)])]
      [(ErrTcType message) (ErrTcType message)])))

(define (tc-lookup-hygiene-global-visible
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]) : ResultTcType
  (tc-lookup-hygiene-global-visible-id ctx env (tc-name-id name)))

(define (tc-lookup-dotted-source-visible
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]) : ResultTcType
  (match (tc-source-name-lookup-key-after-local-field-check ctx env name)
    [(OkTcString lookup-name)
      (let
        [lookup-id : i64 (tc-name-id lookup-name)]
        (match (tc-lookup-unsafe-id env lookup-id)
          [(OkTcTypeUnsafe ty unsafe)
            (if unsafe
              (match (tc-require-unsafe env lookup-name)
                [(OkTcUnit)
                  (match (tc-qualified-value-visible-ok ctx lookup-name)
                    [(OkTcUnit) (OkTcType ty)]
                    [(ErrTcUnit message) (ErrTcType message)])]
                [(ErrTcUnit message) (ErrTcType message)])
              (match (tc-qualified-value-visible-ok ctx lookup-name)
                [(OkTcUnit) (OkTcType ty)]
                [(ErrTcUnit message) (ErrTcType message)]))]
          [(ErrTcTypeUnsafe message)
            (tc-variant-constructor-type-for-lookup-or ctx lookup-name message)]))]
    [(ErrTcString message) (ErrTcType message)]))

(define (tc-hygiene-definition-env [ctx : TcContext] [module : String]) : ResultTcEnv
  (if tc-hygiene-active-top-env-ready
    (if (string-eq module "")
      (OkTcEnv tc-hygiene-active-top-env)
      ;; #2357: build cache entries in the dedicated persistent arena (see
      ;; tc-hygiene-module-env-cache-arena) so the chain stored in the global
      ;; survives the scratch arenas active during per-decl typechecking.
      (let
        [prev-arena : i64 (arena-current)]
        [_switched : unit
          (unsafe
            (arena-set! (tc-hygiene-module-env-cache-arena-handle)))]
        (match (tc-module-local-env-cached
          ctx
          tc-hygiene-active-top-env
          module
          tc-hygiene-module-env-cache)
          [(OkTcModuleLocalEnv def-env next-cache)
            (begin
              (set! tc-hygiene-module-env-cache next-cache)
              (unsafe
                (arena-set! prev-arena))
              (OkTcEnv def-env))]
          [(ErrTcModuleLocalEnv message)
            (begin
              (unsafe
                (arena-set! prev-arena))
              (ErrTcEnv message))])))
    (ErrTcEnv "typecheck: macro hygiene definition context unavailable")))

(define (tc-lookup-hygiene-context-global-visible-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [module : String]
  [name-id : i64]) : ResultTcType
  (let
    [name : String (intern-str name-id)]
    [def-ctx : TcContext (tc-context-with-module ctx module)]
    (if (>= (intern-first-dot name-id) 0)
      (tc-lookup-dotted-source-visible ctx env name)
      (match (tc-hygiene-definition-env ctx module)
        [(OkTcEnv def-env)
          (match (tc-lookup-unsafe-id def-env name-id)
            [(OkTcTypeUnsafe ty unsafe)
              (if unsafe
                (match (tc-require-unsafe env name)
                  [(OkTcUnit)
                    (match (tc-qualified-value-visible-ok def-ctx name)
                      [(OkTcUnit) (OkTcType ty)]
                      [(ErrTcUnit message) (ErrTcType message)])]
                  [(ErrTcUnit message) (ErrTcType message)])
                (match (tc-qualified-value-visible-ok def-ctx name)
                  [(OkTcUnit) (OkTcType ty)]
                  [(ErrTcUnit message) (ErrTcType message)]))]
            [(ErrTcTypeUnsafe message) (ErrTcType message)])]
        [(ErrTcEnv message) (ErrTcType message)]))))

(define (tc-hygiene-global-binding-unsafe-scan
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (match env
    [(TcTypeNil) (tc-binding-unsafe-id? root name-id)]
    [(TcTypeCache _ _ _ _ _ _ _ rest _)
      (tc-hygiene-global-binding-unsafe-scan root (box-get rest) name-id)]
    [(TcTypeBind key _ rest)
      (if (= key (tc-hygiene-global-boundary-id))
        (tc-binding-unsafe-id? (box-get rest) name-id)
        (tc-hygiene-global-binding-unsafe-scan root (box-get rest) name-id))]))

(define (tc-hygiene-global-binding-unsafe-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (tc-hygiene-global-binding-unsafe-scan env env name-id))

(define (tc-hygiene-global-binding-unsafe? [env : TcTypeEnv] [name : String]) : bool
  (tc-hygiene-global-binding-unsafe-id? env (tc-name-id name)))

(define (tc-active-region-scan [env : TcTypeEnv]) : TcMaybeString
  (match env
    [(TcTypeNil) (TcNoString)]
    [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-active-region-scan (box-get rest))
        (TcNoString))]
    [(TcTypeBind key ty rest)
      (if (= key (tc-region-marker-id))
        (match ty
          [(AstTyVar region) (TcSomeString (intern-str region))]
          [_ (tc-active-region-scan (box-get rest))])
        (tc-active-region-scan (box-get rest)))]))

(define (tc-active-region [env : TcTypeEnv]) : TcMaybeString
  (match env
    [(TcTypeCache _ _ _ _ _ _ _ rest _) (tc-active-region-scan (box-get rest))]
    [_ (tc-active-region-scan env)]))

(define (tc-push-region [env : TcTypeEnv] [region : String]) : TcTypeEnv
  (tc-bind env (tc-region-marker-name) (AstTyVar (intern region))))

(define (tc-string-list-contains [items : TcStringList] [name : String]) : bool
  (match items
    [(TcStringNil) false]
    [(TcStringCons item rest)
      (if (string-eq item name)
        true
        (tc-string-list-contains (box-get rest) name))]))

(define (tc-string-list-add [items : TcStringList] [name : String]) : TcStringList
  (if (tc-string-list-contains items name)
    items
    (TcStringCons name (box items))))

(define (tc-bind-cleanup-owner [env : TcTypeEnv] [name : String]) : TcTypeEnv
  (tc-bind env (tc-cleanup-owner-marker-name) (AstTyVar (intern name))))

(define (tc-bind-ordinary-arena-owner [env : TcTypeEnv] [name : String]) : TcTypeEnv
  (tc-bind env (tc-ordinary-arena-owner-marker-name) (AstTyVar (intern name))))

(define (tc-bind-atomic-arena-owner [env : TcTypeEnv] [name : String]) : TcTypeEnv
  (tc-bind env (tc-atomic-arena-owner-marker-name) (AstTyVar (intern name))))

(define (tc-cleanup-owner-marker-for?
  [key : i64]
  [ty : AstType]
  [name : String]) : bool
  (if (= key (tc-cleanup-owner-marker-id))
    (match ty
      [(AstTyVar owner) (string-eq (intern-str owner) name)]
      [_ false])
    false))

(define (tc-arena-owner-marker-for?
  [marker-id : i64]
  [key : i64]
  [ty : AstType]
  [name : String]) : bool
  (if (= key marker-id)
    (match ty
      [(AstTyVar owner) (string-eq (intern-str owner) name)]
      [_ false])
    false))

(define (tc-cleanup-owner-marker-entry? [key : i64] [ty : AstType]) : bool
  (if (= key (tc-cleanup-owner-marker-id))
    (match ty
      [(AstTyVar _) true]
      [_ false])
    false))

(define (tc-arena-owner-marker-entry?
  [marker-id : i64]
  [key : i64]
  [ty : AstType]) : bool
  (if (= key marker-id)
    (match ty
      [(AstTyVar _) true]
      [_ false])
    false))

(define (tc-ordinary-arena-owner-marker-entry? [key : i64] [ty : AstType]) : bool
  (tc-arena-owner-marker-entry? (tc-ordinary-arena-owner-marker-id) key ty))

(define (tc-atomic-arena-owner-marker-entry? [key : i64] [ty : AstType]) : bool
  (tc-arena-owner-marker-entry? (tc-atomic-arena-owner-marker-id) key ty))

(define (tc-arena-owner-marker-head?
  [env : TcTypeEnv]
  [name : String]
  [marker-id : i64]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache _ _ _ _ _ _ _ _ _) false]
    [(TcTypeBind key ty _) (tc-arena-owner-marker-for? marker-id key ty name)]))

(define (tc-cleanup-owner-marker-head? [env : TcTypeEnv] [name : String]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache _ _ _ _ _ _ _ _ _) false]
    [(TcTypeBind key ty _) (tc-cleanup-owner-marker-for? key ty name)]))

(define (tc-cleanup-owner-active-scan? [env : TcTypeEnv] [name : String]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-cleanup-owner-active-scan? (box-get rest) name)
        false)]
    [(TcTypeBind key ty rest)
      (if (= key (tc-name-id name))
        (tc-cleanup-owner-marker-head? (box-get rest) name)
        (tc-cleanup-owner-active-scan? (box-get rest) name))]))

(define (tc-cleanup-owner-active? [env : TcTypeEnv] [name : String]) : bool
  (match env
    [(TcTypeCache _ _ _ _ _ _ _ rest _)
      (tc-cleanup-owner-active-scan? (box-get rest) name)]
    [_ (tc-cleanup-owner-active-scan? env name)]))

(define (tc-arena-owner-active-scan?
  [env : TcTypeEnv]
  [name : String]
  [marker-id : i64]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-arena-owner-active-scan? (box-get rest) name marker-id)
        false)]
    [(TcTypeBind key _ rest)
      (if (= key (tc-name-id name))
        (tc-arena-owner-marker-head? (box-get rest) name marker-id)
        (tc-arena-owner-active-scan? (box-get rest) name marker-id))]))

(define (tc-arena-owner-active?
  [env : TcTypeEnv]
  [name : String]
  [marker-id : i64]) : bool
  (match env
    [(TcTypeCache _ _ _ _ _ _ _ rest _)
      (tc-arena-owner-active-scan? (box-get rest) name marker-id)]
    [_ (tc-arena-owner-active-scan? env name marker-id)]))

(define (tc-ordinary-arena-owner-active? [env : TcTypeEnv] [name : String]) : bool
  (tc-arena-owner-active? env name (tc-ordinary-arena-owner-marker-id)))

(define (tc-atomic-arena-owner-active? [env : TcTypeEnv] [name : String]) : bool
  (tc-arena-owner-active? env name (tc-atomic-arena-owner-marker-id)))

(define (tc-active-cleanup-owners-scan [root : TcTypeEnv] [env : TcTypeEnv]) : TcStringList
  (match env
    [(TcTypeNil) TcStringNil]
    [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-active-cleanup-owners-scan root (box-get rest))
        TcStringNil)]
    [(TcTypeBind key ty rest)
      (let
        [owners : TcStringList
          (tc-active-cleanup-owners-scan root (box-get rest))]
        (if (= key (tc-cleanup-owner-marker-id))
          (match ty
            [(AstTyVar owner)
              (let
                [owner-str : String (intern-str owner)]
                (if (tc-cleanup-owner-active? root owner-str)
                  (tc-string-list-add owners owner-str)
                  owners))]
            [_ owners])
          owners))]))

(define (tc-active-cleanup-owners [env : TcTypeEnv]) : TcStringList
  (match env
    [(TcTypeCache _ _ _ _ _ _ _ rest _)
      (tc-active-cleanup-owners-scan env (box-get rest))]
    [_ (tc-active-cleanup-owners-scan env env)]))

(define (tc-string-list-eq [a : TcStringList] [b : TcStringList]) : bool
  (match a
    [(TcStringNil)
      (match b
        [(TcStringNil) true]
        [_ false])]
    [(TcStringCons item rest)
      (and
        (tc-string-list-contains b item)
        (tc-string-list-eq (box-get rest) b))]))

(define (tc-string-list-overlaps? [a : TcStringList] [b : TcStringList]) : bool
  (match a
    [(TcStringNil) false]
    [(TcStringCons item rest)
      (if (tc-string-list-contains b item)
        true
        (tc-string-list-overlaps? (box-get rest) b))]))

(define (tc-string-list-all-in? [items : TcStringList] [allowed : TcStringList]) : bool
  (match items
    [(TcStringNil) true]
    [(TcStringCons item rest)
      (and
        (tc-string-list-contains allowed item)
        (tc-string-list-all-in? (box-get rest) allowed))]))

(define (tc-lifetime-list-count [items : AstLifetimeList]) : i64
  (match items
    [(AstLifetimeNil) 0]
    [(AstLifetimeCons _ rest)
      (let
        [rest : AstLifetimeList (box-get rest)]
        (+ 1 (tc-lifetime-list-count rest)))]))

(define (tc-lifetime-list-contains [items : AstLifetimeList] [name : String]) : bool
  (match items
    [(AstLifetimeNil) false]
    [(AstLifetimeCons item rest)
      (let
        [rest : AstLifetimeList (box-get rest)]
        (if (string-eq item name)
          true
          (tc-lifetime-list-contains rest name)))]))

(define (tc-lifetime-list-duplicates? [items : AstLifetimeList]) : bool
  (match items
    [(AstLifetimeNil) false]
    [(AstLifetimeCons item rest)
      (let
        [rest : AstLifetimeList (box-get rest)]
        (or
          (tc-lifetime-list-contains rest item)
          (tc-lifetime-list-duplicates? rest)))]))

(define (tc-lifetime-list-eq [a : AstLifetimeList] [b : AstLifetimeList]) : bool
  (match a
    [(AstLifetimeNil)
      (match b
        [(AstLifetimeNil) true]
        [_ false])]
    [(AstLifetimeCons a-head a-rest)
      (let
        [a-rest : AstLifetimeList (box-get a-rest)]
        (match b
          [(AstLifetimeCons b-head b-rest)
            (let
              [b-rest : AstLifetimeList (box-get b-rest)]
              (and
                (string-eq a-head b-head)
                (tc-lifetime-list-eq a-rest b-rest)))]
          [_ false]))]))

(define (tc-lifetime-list-all-in?
  [items : AstLifetimeList]
  [allowed : AstLifetimeList]) : bool
  (match items
    [(AstLifetimeNil) true]
    [(AstLifetimeCons item rest)
      (let
        [rest : AstLifetimeList (box-get rest)]
        (and
          (or
            (string-eq item "program")
            (tc-lifetime-list-contains allowed item))
          (tc-lifetime-list-all-in? rest allowed)))]))

(define (tc-lifetime-list-to-string-list-into
  [items : AstLifetimeList]
  [out : TcStringList]) : TcStringList
  (match items
    [(AstLifetimeNil) out]
    [(AstLifetimeCons item rest)
      (let
        [rest : AstLifetimeList (box-get rest)]
        (tc-lifetime-list-to-string-list-into
          rest
          (tc-string-list-add out item)))]))

(define (tc-string-list-to-lifetime-list [items : TcStringList]) : AstLifetimeList
  (match items
    [(TcStringNil) AstLifetimeNil]
    [(TcStringCons item rest)
      (ast-lifetime-cons item (tc-string-list-to-lifetime-list (box-get rest)))]))

(define (tc-lifetime-subst-lookup [subst : TcLifetimeSubst] [name : String]) : TcMaybeString
  (match subst
    [(TcLifetimeSubstNil) (TcNoString)]
    [(TcLifetimeSubstCons from to rest)
      (if (string-eq from name)
        (TcSomeString to)
        (tc-lifetime-subst-lookup (box-get rest) name))]))

(define (tc-lifetime-subst-bind
  [subst : TcLifetimeSubst]
  [from : String]
  [to : String]) : ResultTcLifetimeSubst
  (match (tc-lifetime-subst-lookup subst from)
    [(TcSomeString existing)
      (if (string-eq existing to)
        (OkTcLifetimeSubst subst)
        (ErrTcLifetimeSubst "typecheck: constructor lifetime mismatch"))]
    [(TcNoString) (OkTcLifetimeSubst (TcLifetimeSubstCons from to (box subst)))]))

(define (tc-lifetime-subst-apply [subst : TcLifetimeSubst] [name : String]) : String
  (match (tc-lifetime-subst-lookup subst name)
    [(TcSomeString replacement) replacement]
    [(TcNoString) name]))

(define (tc-lifetime-subst-list
  [subst : TcLifetimeSubst]
  [items : AstLifetimeList]) : AstLifetimeList
  (match items
    [(AstLifetimeNil) AstLifetimeNil]
    [(AstLifetimeCons item rest)
      (let
        [rest : AstLifetimeList (box-get rest)]
        (ast-lifetime-cons
          (tc-lifetime-subst-apply subst item)
          (tc-lifetime-subst-list subst rest)))]))

;; V1 lifetime names are owner names. Normal environment bindings own stack
;; slots, and the synthetic region marker owns a with-arena scope. Environment
;; order is the lexical outlives relation: older owners appear farther down the
;; list and outlive nested stack bindings or scoped arenas. The default program
;; arena is inferred for untagged aggregate handles, so it has no lexical
;; binder in this environment walk.
(define (tc-env-binding-matches-lifetime?
  [key : i64]
  [ty : AstType]
  [lifetime : String]) : bool
  (if (= key (tc-name-id lifetime))
    true
    (if (= key (tc-region-marker-id))
      (match ty
        [(AstTyVar region) (string-eq (intern-str region) lifetime)]
        [_ false])
      false)))

(define (tc-lifetime-visible-scan? [env : TcTypeEnv] [lifetime : String]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-lifetime-visible-scan? (box-get rest) lifetime)
        false)]
    [(TcTypeBind key ty rest)
      (if (tc-env-binding-matches-lifetime? key ty lifetime)
        true
        (tc-lifetime-visible-scan? (box-get rest) lifetime))]))

(define (tc-lifetime-visible? [env : TcTypeEnv] [lifetime : String]) : bool
  (match env
    [(TcTypeCache _ _ _ _ _ _ _ rest _)
      (tc-lifetime-visible-scan? (box-get rest) lifetime)]
    [_ (tc-lifetime-visible-scan? env lifetime)]))

(define (tc-reference-lifetimes-visible?
  [env : TcTypeEnv]
  [lifetimes : TcStringList]) : bool
  (match lifetimes
    [(TcStringNil) true]
    [(TcStringCons lifetime rest)
      (and
        (tc-lifetime-visible? env lifetime)
        (tc-reference-lifetimes-visible? env (box-get rest)))]))

(define (tc-lifetime-outlives-binding-scan-inner
  [env : TcTypeEnv]
  [lifetime : String]
  [target : String]
  [seen-target : bool]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-lifetime-outlives-binding-scan-inner
          (box-get rest)
          lifetime
          target
          seen-target)
        false)]
    [(TcTypeBind key ty rest)
      (if (tc-env-binding-matches-lifetime? key ty lifetime)
        seen-target
        (tc-lifetime-outlives-binding-scan-inner
          (box-get rest)
          lifetime
          target
          (or seen-target (= key (tc-name-id target)))))]))

(define (tc-lifetime-outlives-binding-scan
  [env : TcTypeEnv]
  [lifetime : String]
  [target : String]
  [seen-target : bool]) : bool
  (match env
    [(TcTypeCache _ _ _ _ _ _ _ rest _)
      (tc-lifetime-outlives-binding-scan-inner
        (box-get rest)
        lifetime
        target
        seen-target)]
    [_
      (tc-lifetime-outlives-binding-scan-inner env lifetime target seen-target)]))

(define (tc-lifetime-outlives-binding?
  [env : TcTypeEnv]
  [lifetime : String]
  [target : String]) : bool
  (tc-lifetime-outlives-binding-scan env lifetime target false))

(define (tc-reference-lifetimes-outlive-binding?
  [env : TcTypeEnv]
  [lifetimes : TcStringList]
  [target : String]) : bool
  (match lifetimes
    [(TcStringNil) true]
    [(TcStringCons lifetime rest)
      (and
        (tc-lifetime-outlives-binding? env lifetime target)
        (tc-reference-lifetimes-outlive-binding? env (box-get rest) target))]))

(define (tc-lifetime-outlives-lifetime-scan-inner
  [env : TcTypeEnv]
  [value-lifetime : String]
  [target-lifetime : String]
  [seen-target : bool]) : bool
  (if (string-eq value-lifetime target-lifetime)
    true
    (match env
      [(TcTypeNil) false]
      [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
        (if scan-through
          (tc-lifetime-outlives-lifetime-scan-inner
            (box-get rest)
            value-lifetime
            target-lifetime
            seen-target)
          false)]
      [(TcTypeBind key ty rest)
        (if (tc-env-binding-matches-lifetime? key ty value-lifetime)
          seen-target
          (tc-lifetime-outlives-lifetime-scan-inner
            (box-get rest)
            value-lifetime
            target-lifetime
            (or
              seen-target
              (tc-env-binding-matches-lifetime? key ty target-lifetime))))])))

(define (tc-lifetime-outlives-lifetime-scan
  [env : TcTypeEnv]
  [value-lifetime : String]
  [target-lifetime : String]
  [seen-target : bool]) : bool
  (match env
    [(TcTypeCache _ _ _ _ _ _ _ rest _)
      (tc-lifetime-outlives-lifetime-scan-inner
        (box-get rest)
        value-lifetime
        target-lifetime
        seen-target)]
    [_
      (tc-lifetime-outlives-lifetime-scan-inner
        env
        value-lifetime
        target-lifetime
        seen-target)]))

(define (tc-lifetime-outlives-lifetime?
  [env : TcTypeEnv]
  [value-lifetime : String]
  [target-lifetime : String]) : bool
  (tc-lifetime-outlives-lifetime-scan env value-lifetime target-lifetime false))

(define (tc-reference-lifetimes-outlive-lifetime?
  [env : TcTypeEnv]
  [lifetimes : TcStringList]
  [target-lifetime : String]) : bool
  (match lifetimes
    [(TcStringNil) true]
    [(TcStringCons lifetime rest)
      (and
        (tc-lifetime-outlives-lifetime? env lifetime target-lifetime)
        (tc-reference-lifetimes-outlive-lifetime?
          env
          (box-get rest)
          target-lifetime))]))

(define (tc-ensure-reference-value-can-bind
  [env : TcTypeEnv]
  [value-ty : AstType]) : ResultTcUnit
  (let
    [lifetimes : TcStringList (tc-type-collect-regions value-ty)]
    (if (tc-reference-lifetimes-visible? env lifetimes)
      OkTcUnit
      (ErrTcUnit "typecheck: reference value would escape lexical scope"))))

(define (tc-ensure-reference-value-can-assign
  [env : TcTypeEnv]
  [target : String]
  [value-ty : AstType]) : ResultTcUnit
  (let
    [lifetimes : TcStringList (tc-type-collect-reference-lifetimes value-ty)]
    (if (tc-reference-lifetimes-outlive-binding? env lifetimes target)
      OkTcUnit
      (ErrTcUnit
        "typecheck: cannot store reference into longer-lived binding; reference value would escape lexical scope"))))

(define (tc-ensure-reference-type-does-not-escape-names
  [ty : AstType]
  [names : TcStringList]) : ResultTcUnit
  (if (tc-string-list-overlaps? (tc-type-collect-regions ty) names)
    (ErrTcUnit "typecheck: reference value would escape lexical scope")
    OkTcUnit))

(define (tc-type-strip-region [ty : AstType]) : AstType
  (match ty
    [(AstTyRegion _ inner) (tc-type-strip-region (ty-node-get inner))]
    [_ ty]))

(define (tc-type-list-contains-region-tag? [types : AstTypeList]) : bool
  (match types
    [(AstTypeNil) false]
    [(AstTypeCons head tail)
      (let
        [head : AstType (ty-node-get head)]
        [tail : AstTypeList (box-get tail)]
        (if (tc-type-contains-region-tag? head)
          true
          (tc-type-list-contains-region-tag? tail)))]))

(define (tc-type-contains-region-tag? [ty : AstType]) : bool
  (match ty
    [(AstTyFunc args ret)
      (if (tc-type-list-contains-region-tag? (box-get args))
        true
        (tc-type-contains-region-tag? (ty-node-get ret)))]
    [(AstTyTuple elems) (tc-type-list-contains-region-tag? (box-get elems))]
    [(AstTyArray elem _) (tc-type-contains-region-tag? (ty-node-get elem))]
    [(AstTyDynArray elem) (tc-type-contains-region-tag? (ty-node-get elem))]
    [(AstTyBox elem) (tc-type-contains-region-tag? (ty-node-get elem))]
    [(AstTyPtr elem) (tc-type-contains-region-tag? (ty-node-get elem))]
    [(AstTyMutPtr elem) (tc-type-contains-region-tag? (ty-node-get elem))]
    [(AstTyRef _ inner) (tc-type-contains-region-tag? (ty-node-get inner))]
    [(AstTyMutRef _ inner) (tc-type-contains-region-tag? (ty-node-get inner))]
    [(AstTyRegion _ _) true]
    [_ false]))

(define (tc-type-list-without-regions [types : AstTypeList]) : AstTypeList
  (if (tc-type-list-contains-region-tag? types)
    (match types
      [(AstTypeNil) AstTypeNil]
      [(AstTypeCons head tail)
        (let
          [head : AstType (ty-node-get head)]
          [tail : AstTypeList (box-get tail)]
          (ast-type-cons
            (tc-type-without-regions head)
            (tc-type-list-without-regions tail)))])
    types))

(define (tc-type-without-regions [ty : AstType]) : AstType
  (if (tc-type-contains-region-tag? ty)
    (match ty
      [(AstTyFunc args ret)
        (ast-ty-func
          (tc-type-list-without-regions (box-get args))
          (tc-type-without-regions (ty-node-get ret)))]
      [(AstTyTuple elems)
        (ast-ty-tuple (tc-type-list-without-regions (box-get elems)))]
      [(AstTyArray elem len)
        (ast-ty-array (tc-type-without-regions (ty-node-get elem)) len)]
      [(AstTyDynArray elem)
        (ast-ty-dyn-array (tc-type-without-regions (ty-node-get elem)))]
      [(AstTyBox elem)
        (ast-ty-box (tc-type-without-regions (ty-node-get elem)))]
      [(AstTyPtr elem)
        (ast-ty-ptr (tc-type-without-regions (ty-node-get elem)))]
      [(AstTyMutPtr elem)
        (ast-ty-mut-ptr (tc-type-without-regions (ty-node-get elem)))]
      [(AstTyRef region inner)
        (ast-ty-ref region (tc-type-without-regions (ty-node-get inner)))]
      [(AstTyMutRef region inner)
        (ast-ty-mut-ref region (tc-type-without-regions (ty-node-get inner)))]
      [(AstTyRegion _ inner) (tc-type-without-regions (ty-node-get inner))]
      [(AstTyEnumArgs name lifetimes)
        (ast-ty-enum-args name (box-get lifetimes))]
      [(AstTyStructArgs name lifetimes)
        (ast-ty-struct-args name (box-get lifetimes))]
      [(AstTyVarArgs name lifetimes) (ast-ty-var-args name (box-get lifetimes))]
      [_ ty])
    ty))

(define (tc-type-list-contains-region [types : AstTypeList] [region : String]) : bool
  (match types
    [(AstTypeNil) false]
    [(AstTypeCons head tail)
      (let
        [head : AstType (ty-node-get head)]
        [tail : AstTypeList (box-get tail)]
        (or
          (tc-type-contains-region head region)
          (tc-type-list-contains-region tail region)))]))

(define (tc-type-contains-region [ty : AstType] [region : String]) : bool
  (match ty
    [(AstTyFunc args ret)
      (or
        (tc-type-list-contains-region (box-get args) region)
        (tc-type-contains-region (ty-node-get ret) region))]
    [(AstTyTuple elems) (tc-type-list-contains-region (box-get elems) region)]
    [(AstTyArray elem _) (tc-type-contains-region (ty-node-get elem) region)]
    [(AstTyDynArray elem) (tc-type-contains-region (ty-node-get elem) region)]
    [(AstTyBox elem) (tc-type-contains-region (ty-node-get elem) region)]
    [(AstTyPtr elem) (tc-type-contains-region (ty-node-get elem) region)]
    [(AstTyMutPtr elem) (tc-type-contains-region (ty-node-get elem) region)]
    [(AstTyRef name inner)
      (or
        (string-eq name region)
        (tc-type-contains-region (ty-node-get inner) region))]
    [(AstTyMutRef name inner)
      (or
        (string-eq name region)
        (tc-type-contains-region (ty-node-get inner) region))]
    [(AstTyRegion name inner)
      (or
        (string-eq name region)
        (tc-type-contains-region (ty-node-get inner) region))]
    [(AstTyEnumArgs _ lifetimes)
      (tc-lifetime-list-contains (box-get lifetimes) region)]
    [(AstTyStructArgs _ lifetimes)
      (tc-lifetime-list-contains (box-get lifetimes) region)]
    [(AstTyVarArgs _ lifetimes)
      (tc-lifetime-list-contains (box-get lifetimes) region)]
    [_ false]))

(define (tc-type-list-contains-any-region [types : AstTypeList]) : bool
  (match types
    [(AstTypeNil) false]
    [(AstTypeCons head tail)
      (let
        [head : AstType (ty-node-get head)]
        [tail : AstTypeList (box-get tail)]
        (or
          (tc-type-contains-any-region head)
          (tc-type-list-contains-any-region tail)))]))

(define (tc-type-contains-any-region [ty : AstType]) : bool
  (match ty
    [(AstTyFunc args ret)
      (or
        (tc-type-list-contains-any-region (box-get args))
        (tc-type-contains-any-region (ty-node-get ret)))]
    [(AstTyTuple elems) (tc-type-list-contains-any-region (box-get elems))]
    [(AstTyArray elem _) (tc-type-contains-any-region (ty-node-get elem))]
    [(AstTyDynArray elem) (tc-type-contains-any-region (ty-node-get elem))]
    [(AstTyBox elem) (tc-type-contains-any-region (ty-node-get elem))]
    [(AstTyPtr elem) (tc-type-contains-any-region (ty-node-get elem))]
    [(AstTyMutPtr elem) (tc-type-contains-any-region (ty-node-get elem))]
    [(AstTyRef _ _) true]
    [(AstTyMutRef _ _) true]
    [(AstTyRegion _ _) true]
    [(AstTyEnumArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [(AstTyStructArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [(AstTyVarArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [_ false]))

(define (tc-type-list-contains-reference? [types : AstTypeList]) : bool
  (match types
    [(AstTypeNil) false]
    [(AstTypeCons head tail)
      (let
        [head : AstType (ty-node-get head)]
        [tail : AstTypeList (box-get tail)]
        (or
          (tc-type-contains-reference? head)
          (tc-type-list-contains-reference? tail)))]))

(define (tc-type-list-contains-mut-reference? [types : AstTypeList]) : bool
  (match types
    [(AstTypeNil) false]
    [(AstTypeCons head tail)
      (let
        [head : AstType (ty-node-get head)]
        [tail : AstTypeList (box-get tail)]
        (or
          (tc-type-contains-mut-reference? head)
          (tc-type-list-contains-mut-reference? tail)))]))

(define (tc-type-contains-reference? [ty : AstType]) : bool
  (match ty
    [(AstTyFunc args ret)
      (or
        (tc-type-list-contains-reference? (box-get args))
        (tc-type-contains-reference? (ty-node-get ret)))]
    [(AstTyTuple elems) (tc-type-list-contains-reference? (box-get elems))]
    [(AstTyArray elem _) (tc-type-contains-reference? (ty-node-get elem))]
    [(AstTyDynArray elem) (tc-type-contains-reference? (ty-node-get elem))]
    [(AstTyBox elem) (tc-type-contains-reference? (ty-node-get elem))]
    [(AstTyPtr elem) (tc-type-contains-reference? (ty-node-get elem))]
    [(AstTyMutPtr elem) (tc-type-contains-reference? (ty-node-get elem))]
    [(AstTyRef _ _) true]
    [(AstTyMutRef _ _) true]
    [(AstTyRegion _ inner) (tc-type-contains-reference? (ty-node-get inner))]
    [(AstTyEnumArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [(AstTyStructArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [(AstTyVarArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [_ false]))

(define (tc-type-contains-mut-reference? [ty : AstType]) : bool
  (match ty
    [(AstTyFunc args ret)
      (or
        (tc-type-list-contains-mut-reference? (box-get args))
        (tc-type-contains-mut-reference? (ty-node-get ret)))]
    [(AstTyTuple elems) (tc-type-list-contains-mut-reference? (box-get elems))]
    [(AstTyArray elem _) (tc-type-contains-mut-reference? (ty-node-get elem))]
    [(AstTyDynArray elem) (tc-type-contains-mut-reference? (ty-node-get elem))]
    [(AstTyBox elem) (tc-type-contains-mut-reference? (ty-node-get elem))]
    [(AstTyPtr elem) (tc-type-contains-mut-reference? (ty-node-get elem))]
    [(AstTyMutPtr elem) (tc-type-contains-mut-reference? (ty-node-get elem))]
    [(AstTyRef _ inner) (tc-type-contains-mut-reference? (ty-node-get inner))]
    [(AstTyMutRef _ _) true]
    [(AstTyRegion _ inner)
      (tc-type-contains-mut-reference? (ty-node-get inner))]
    [_ false]))

(define (tc-type-list-collect-reference-lifetimes
  [types : AstTypeList]
  [out : TcStringList]) : TcStringList
  (match types
    [(AstTypeNil) out]
    [(AstTypeCons head tail)
      (let
        [head : AstType (ty-node-get head)]
        [tail : AstTypeList (box-get tail)]
        (tc-type-list-collect-reference-lifetimes
          tail
          (tc-type-collect-reference-lifetimes-into head out)))]))

(define (tc-type-collect-reference-lifetimes-into
  [ty : AstType]
  [out : TcStringList]) : TcStringList
  (match ty
    [(AstTyFunc args ret)
      (tc-type-collect-reference-lifetimes-into
        (ty-node-get ret)
        (tc-type-list-collect-reference-lifetimes (box-get args) out))]
    [(AstTyTuple elems)
      (tc-type-list-collect-reference-lifetimes (box-get elems) out)]
    [(AstTyArray elem _)
      (tc-type-collect-reference-lifetimes-into (ty-node-get elem) out)]
    [(AstTyDynArray elem)
      (tc-type-collect-reference-lifetimes-into (ty-node-get elem) out)]
    [(AstTyBox elem)
      (tc-type-collect-reference-lifetimes-into (ty-node-get elem) out)]
    [(AstTyPtr elem)
      (tc-type-collect-reference-lifetimes-into (ty-node-get elem) out)]
    [(AstTyMutPtr elem)
      (tc-type-collect-reference-lifetimes-into (ty-node-get elem) out)]
    [(AstTyRef lifetime inner)
      (tc-type-collect-reference-lifetimes-into
        (ty-node-get inner)
        (tc-string-list-add out lifetime))]
    [(AstTyMutRef lifetime inner)
      (tc-type-collect-reference-lifetimes-into
        (ty-node-get inner)
        (tc-string-list-add out lifetime))]
    [(AstTyRegion _ inner)
      (tc-type-collect-reference-lifetimes-into (ty-node-get inner) out)]
    [(AstTyEnumArgs _ lifetimes)
      (tc-lifetime-list-to-string-list-into (box-get lifetimes) out)]
    [(AstTyStructArgs _ lifetimes)
      (tc-lifetime-list-to-string-list-into (box-get lifetimes) out)]
    [(AstTyVarArgs _ lifetimes)
      (tc-lifetime-list-to-string-list-into (box-get lifetimes) out)]
    [_ out]))

(define (tc-type-collect-reference-lifetimes [ty : AstType]) : TcStringList
  (tc-type-collect-reference-lifetimes-into ty TcStringNil))

(define (tc-maybe-type-contains-reference? [maybe-ty : AstMaybeType]) : bool
  (match maybe-ty
    [(AstNoType) false]
    [(AstSomeType ty) (tc-type-contains-reference? ty)]))

(define (tc-param-list-contains-reference? [params : AstParamList]) : bool
  (match params
    [(AstParamNil) false]
    [(AstParamCons param rest)
      (let
        [rest : AstParamList (box-get rest)]
        (match param
          [(AstParam _ ty _)
            (or
              (tc-type-contains-reference? ty)
              (tc-param-list-contains-reference? rest))]))]))

(define (tc-param-list-reference-return-lifetimes-into
  [ctx : TcContext]
  [params : AstParamList]
  [out : TcStringList]) : TcStringList
  (match params
    [(AstParamNil) out]
    [(AstParamCons param rest)
      (let
        [rest : AstParamList (box-get rest)]
        (match param
          [(AstParam name ty _)
            (tc-param-list-reference-return-lifetimes-into
              ctx
              rest
              (tc-type-collect-reference-lifetimes-into
                (tc-resolve-type ctx ty)
                (tc-string-list-add out (intern-str name))))]))]))

(define (tc-reference-return-lifetimes-allowed?
  [ctx : TcContext]
  [params : AstParamList]
  [ret : AstType]) : bool
  (tc-string-list-all-in?
    (tc-type-collect-reference-lifetimes (tc-resolve-type ctx ret))
    (tc-param-list-reference-return-lifetimes-into ctx params TcStringNil)))

(define (tc-reference-return-policy-ok
  [ctx : TcContext]
  [params : AstParamList]
  [ret : AstType]) : ResultTcUnit
  (if (tc-type-contains-reference? (tc-resolve-type ctx ret))
    (if (tc-reference-return-lifetimes-allowed? ctx params ret)
      OkTcUnit
      (ErrTcUnit
        "typecheck: returned reference lifetime must be tied to a parameter"))
    OkTcUnit))

(define (tc-type-list-collect-regions
  [types : AstTypeList]
  [out : TcStringList]) : TcStringList
  (match types
    [(AstTypeNil) out]
    [(AstTypeCons head tail)
      (let
        [head : AstType (ty-node-get head)]
        [tail : AstTypeList (box-get tail)]
        (tc-type-list-collect-regions
          tail
          (tc-type-collect-regions-into head out)))]))

(define (tc-type-collect-regions-into [ty : AstType] [out : TcStringList]) : TcStringList
  (match ty
    [(AstTyFunc args ret)
      (tc-type-collect-regions-into
        (ty-node-get ret)
        (tc-type-list-collect-regions (box-get args) out))]
    [(AstTyTuple elems) (tc-type-list-collect-regions (box-get elems) out)]
    [(AstTyArray elem _) (tc-type-collect-regions-into (ty-node-get elem) out)]
    [(AstTyDynArray elem) (tc-type-collect-regions-into (ty-node-get elem) out)]
    [(AstTyBox elem) (tc-type-collect-regions-into (ty-node-get elem) out)]
    [(AstTyPtr elem) (tc-type-collect-regions-into (ty-node-get elem) out)]
    [(AstTyMutPtr elem) (tc-type-collect-regions-into (ty-node-get elem) out)]
    [(AstTyRef name inner)
      (tc-type-collect-regions-into
        (ty-node-get inner)
        (tc-string-list-add out name))]
    [(AstTyMutRef name inner)
      (tc-type-collect-regions-into
        (ty-node-get inner)
        (tc-string-list-add out name))]
    [(AstTyRegion name inner)
      (tc-type-collect-regions-into
        (ty-node-get inner)
        (tc-string-list-add out name))]
    [(AstTyEnumArgs _ lifetimes)
      (tc-lifetime-list-to-string-list-into (box-get lifetimes) out)]
    [(AstTyStructArgs _ lifetimes)
      (tc-lifetime-list-to-string-list-into (box-get lifetimes) out)]
    [(AstTyVarArgs _ lifetimes)
      (tc-lifetime-list-to-string-list-into (box-get lifetimes) out)]
    [_ out]))

(define (tc-type-collect-regions [ty : AstType]) : TcStringList
  (tc-type-collect-regions-into ty TcStringNil))

(define (tc-region-list-all-atomic-arena-owners?
  [env : TcTypeEnv]
  [regions : TcStringList]) : bool
  (match regions
    [(TcStringNil) true]
    [(TcStringCons region rest)
      (and
        (tc-atomic-arena-owner-active? env region)
        (tc-region-list-all-atomic-arena-owners? env (box-get rest)))]))

(define (tc-type-regions-all-atomic-arena-owners?
  [env : TcTypeEnv]
  [ty : AstType]) : bool
  (tc-region-list-all-atomic-arena-owners? env (tc-type-collect-regions ty)))

(define (tc-type-outer-region [ty : AstType]) : TcMaybeString
  (match ty
    [(AstTyRegion region _) (TcSomeString region)]
    [_ (TcNoString)]))

(define (tc-region-taggable-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyString) true]
    [(AstTyDynArray _) true]
    [(AstTyBox _) true]
    [(AstTyTuple _) true]
    [(AstTyStruct _) true]
    [(AstTyStructArgs _ _) true]
    [(AstTyEnum _) true]
    [(AstTyEnumArgs _ _) true]
    [_ false]))

(define (tc-tag-region [region : String] [ty : AstType]) : AstType
  (if (tc-region-taggable-type? ty)
    (ast-ty-region region ty)
    ty))

(define (tc-tag-active-region [env : TcTypeEnv] [ty : AstType]) : AstType
  (match (tc-active-region env)
    [(TcSomeString region) (tc-tag-region region ty)]
    [(TcNoString) ty]))

;; Nominal aggregate types have no lifetime-argument surface yet. Until they do,
;; constructor results carry stored-reference lifetimes as local region facts so
;; existing flow/escape checks can reject boundary escapes.
(define (tc-tag-reference-lifetimes [lifetimes : TcStringList] [ty : AstType]) : AstType
  (match lifetimes
    [(TcStringNil) ty]
    [(TcStringCons lifetime rest)
      (tc-tag-region lifetime (tc-tag-reference-lifetimes (box-get rest) ty))]))

(define (tc-constructor-target-type
  [env : TcTypeEnv]
  [params : AstTypeList]
  [ret : AstType]) : AstType
  (tc-tag-active-region
    env
    (tc-tag-reference-lifetimes
      (tc-type-list-collect-reference-lifetimes params TcStringNil)
      ret)))

(define (tc-project-from-region-container
  [container-ty : AstType]
  [projected-ty : AstType]) : AstType
  (match (tc-type-outer-region container-ty)
    [(TcSomeString region) (tc-tag-region region projected-ty)]
    [(TcNoString)
      (match (tc-type-strip-region container-ty)
        [(AstTyRef region _) (tc-tag-region region projected-ty)]
        [(AstTyMutRef region _) (tc-tag-region region projected-ty)]
        [_ projected-ty])]))

;; Region-tagged aggregate flow uses the same lexical owner ordering as
;; references, but only considers arena owners. A value from an outer region can
;; flow into an inner target; an inner-region value cannot flow outward.
(define (tc-region-outlives-or-matches-scan
  [env : TcTypeEnv]
  [value-region : String]
  [target-region : String]) : bool
  (if (string-eq value-region target-region)
    true
    (match env
      [(TcTypeNil) false]
      [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
        (if scan-through
          (tc-region-outlives-or-matches-scan
            (box-get rest)
            value-region
            target-region)
          false)]
      [(TcTypeBind key ty rest)
        (if (= key (tc-region-marker-id))
          (match ty
            [(AstTyVar region)
              (if (string-eq (intern-str region) value-region)
                false
                (if (string-eq (intern-str region) target-region)
                  true
                  (tc-region-outlives-or-matches-scan
                    (box-get rest)
                    value-region
                    target-region)))]
            [_
              (tc-region-outlives-or-matches-scan
                (box-get rest)
                value-region
                target-region)])
          (tc-region-outlives-or-matches-scan
            (box-get rest)
            value-region
            target-region))])))

(define (tc-region-outlives-or-matches
  [env : TcTypeEnv]
  [value-region : String]
  [target-region : String]) : bool
  (match env
    [(TcTypeCache _ _ _ _ _ _ _ rest _)
      (tc-region-outlives-or-matches-scan
        (box-get rest)
        value-region
        target-region)]
    [_ (tc-region-outlives-or-matches-scan env value-region target-region)]))

(define (tc-region-can-flow-into-any
  [env : TcTypeEnv]
  [value-region : String]
  [target-regions : TcStringList]) : bool
  (match target-regions
    [(TcStringNil) false]
    [(TcStringCons target rest)
      (if (tc-region-outlives-or-matches env value-region target)
        true
        (tc-region-can-flow-into-any env value-region (box-get rest)))]))

(define (tc-region-list-can-flow-into
  [env : TcTypeEnv]
  [value-regions : TcStringList]
  [target-regions : TcStringList]) : bool
  (match value-regions
    [(TcStringNil) true]
    [(TcStringCons value rest)
      (and
        (tc-region-can-flow-into-any env value target-regions)
        (tc-region-list-can-flow-into env (box-get rest) target-regions))]))

(define (tc-ensure-region-value-can-flow-into
  [env : TcTypeEnv]
  [target-ty : AstType]
  [value-ty : AstType]
  [context : String]) : ResultTcUnit
  (let
    [value-regions : TcStringList (tc-type-collect-regions value-ty)]
    (match value-regions
      [(TcStringNil) OkTcUnit]
      [_
        (let
          [target-regions : TcStringList (tc-type-collect-regions target-ty)]
          (if (and
            (tc-type-contains-any-region target-ty)
            (tc-region-list-can-flow-into env value-regions target-regions))
            OkTcUnit
            (ErrTcUnit
              (string-append
                "typecheck: cannot store region-tagged value into "
                (string-append context "; region value would escape")))))])))

(define (tc-resolve-type-list [ctx : TcContext] [types : AstTypeList]) : AstTypeList
  (if (tc-type-list-needs-resolution? types)
    (match types
      [(AstTypeNil) AstTypeNil]
      [(AstTypeCons head tail)
        (let
          [head : AstType (ty-node-get head)]
          [tail : AstTypeList (box-get tail)]
          (ast-type-cons
            (tc-resolve-type ctx head)
            (tc-resolve-type-list ctx tail)))])
    types))

(define (tc-type-list-needs-resolution? [types : AstTypeList]) : bool
  (match types
    [(AstTypeNil) false]
    [(AstTypeCons head tail)
      (let
        [head : AstType (ty-node-get head)]
        [tail : AstTypeList (box-get tail)]
        (if (tc-type-needs-resolution? head)
          true
          (tc-type-list-needs-resolution? tail)))]))

(define (tc-type-needs-resolution? [ty : AstType]) : bool
  (match ty
    [(AstTyFunc args ret)
      (if (tc-type-list-needs-resolution? (box-get args))
        true
        (tc-type-needs-resolution? (ty-node-get ret)))]
    [(AstTyTuple elems) (tc-type-list-needs-resolution? (box-get elems))]
    [(AstTyArray elem _) (tc-type-needs-resolution? (ty-node-get elem))]
    [(AstTyDynArray elem) (tc-type-needs-resolution? (ty-node-get elem))]
    [(AstTyBox elem) (tc-type-needs-resolution? (ty-node-get elem))]
    [(AstTyPtr elem) (tc-type-needs-resolution? (ty-node-get elem))]
    [(AstTyMutPtr elem) (tc-type-needs-resolution? (ty-node-get elem))]
    [(AstTyRef _ inner) (tc-type-needs-resolution? (ty-node-get inner))]
    [(AstTyMutRef _ inner) (tc-type-needs-resolution? (ty-node-get inner))]
    [(AstTyRegion _ inner) (tc-type-needs-resolution? (ty-node-get inner))]
    [(AstTyVarArgs _ _) true]
    [(AstTyVar _) true]
    [_ false]))

(define (tc-name-qualified? [name : String]) : bool
  (and (not (tc-hygiene-local-name? name)) (intern-name-qualified? name)))

(define (tc-name-first-char [name : String] [needle : char]) : i64
  (let
    [i : i64 0]
    [n : i64 (string-length name)]
    (begin
      (while (< i n)
        (if (char-eq (string-ref name i) needle)
          (return i)
          (set! i (+ i 1))))
      -1)))

(define (tc-name-first-dot [name : String]) : i64
  (intern-name-first-dot name))

(define (tc-source-slash-qualified? [name : String]) : bool
  (tc-source-slash-qualified-id? name (tc-name-id name)))

;; Variant taking the already-interned `name-id` so the hot name-resolution
;; path interns each name once and reads the slash position from the id-keyed
;; metadata instead of re-hashing the string. The hygiene checks stay on the
;; string (cheap prefix tests, no interning). `intern-name-last-slash name`
;; is exactly `intern-qualified-last-slash (intern name)`, so this is
;; semantics-preserving.
(define (tc-source-slash-qualified-id? [name : String] [name-id : i64]) : bool
  (let
    [slash : i64 (intern-qualified-last-slash name-id)]
    [n : i64 (string-length name)]
    (and
      (not (tc-hygiene-local-name? name))
      (not (tc-hygiene-global-name? name))
      (> slash 0)
      (< slash (- n 1)))))

(define (tc-name-slashes-to-dots [name : String]) : String
  (let
    [i : i64 0]
    [n : i64 (string-length name)]
    [out : String ""]
    (begin
      (while (< i n)
        (let
          [chunk : String
            (if (char-eq (string-ref name i) '/')
              "."
              (substring name i 1))]
          (begin
            (set! out (string-append out chunk))
            (set! i (+ i 1)))))
      out)))

(define (tc-source-slash-qualified-message [name : String]) : String
  (str-cat
    "typecheck: slash-qualified name "
    name
    " is no longer supported; use "
    (tc-name-slashes-to-dots name)))

;; Bootstrap bridge: published stage0 builds may still encounter legacy
;; slash-qualified core macro spellings. Keep this narrow until the seed no
;; longer needs the compatibility path.
(define (tc-source-legacy-core-macro-compat? [name : String]) : bool
  (if (tc-name-qualified? name)
    (let
      [module : String (tc-qualified-name-module name)]
      [base : String (tc-qualified-name-base name)]
      (and
        (string-eq module "core")
        (or
          (string-eq base "when")
          (string-eq base "unless")
          (string-eq base "and")
          (string-eq base "or")
          (string-eq base "cond"))))
    false))

(define (tc-source-name-bound-exact-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (tc-name-bound-id? env name-id))

(define (tc-source-name-bound-exact? [env : TcTypeEnv] [name : String]) : bool
  (tc-source-name-bound-exact-id? env (tc-name-id name)))

(define (tc-source-leading-segment-bound?
  [env : TcTypeEnv]
  [name : String]
  [first-dot : i64]) : bool
  (if (<= first-dot 0)
    false
    (tc-source-name-bound-exact? env (substring name 0 first-dot))))

(define (tc-source-leading-segment-wins-over-exact-id?
  [env : TcTypeEnv]
  [name-id : i64]
  [prefix-id : i64]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeBind key _ rest)
      (if (= key name-id)
        false
        (if (= key prefix-id)
          true
          (tc-source-leading-segment-wins-over-exact-id?
            (box-get rest)
            name-id
            prefix-id)))]
    [(TcTypeCache ids _ _ _ _ _ partial _ below)
      (match (i64-i64-map-get ids prefix-id)
        [(I64I64MapFound prefix-index)
          (match (i64-i64-map-get ids name-id)
            [(I64I64MapFound name-index) (< prefix-index name-index)]
            [(I64I64MapMissing) true])]
        [(I64I64MapMissing)
          (match (i64-i64-map-get ids name-id)
            [(I64I64MapFound _) false]
            [(I64I64MapMissing)
              (if partial
                (tc-source-leading-segment-wins-over-exact-id?
                  (box-get below)
                  name-id
                  prefix-id)
                false)])])]))

(define (tc-source-leading-segment-wins-over-exact-id-from-dot?
  [env : TcTypeEnv]
  [name-id : i64]
  [first-dot : i64]) : bool
  (if (<= first-dot 0)
    false
    (tc-source-leading-segment-wins-over-exact-id?
      env
      name-id
      (intern-slice (intern-str name-id) 0 first-dot))))

(define (tc-source-leading-segment-wins-over-exact?
  [env : TcTypeEnv]
  [name : String]
  [first-dot : i64]) : bool
  (tc-source-leading-segment-wins-over-exact-from-id?
    env
    name
    (tc-name-id name)
    first-dot))

;; Variant taking the already-interned `name-id` to avoid re-hashing `name` on
;; the hot resolution path. The prefix is still interned via the cached
;; `intern-slice`.
(define (tc-source-leading-segment-wins-over-exact-from-id?
  [env : TcTypeEnv]
  [name : String]
  [name-id : i64]
  [first-dot : i64]) : bool
  (if (<= first-dot 0)
    false
    (let
      [prefix-id : i64 (intern-slice name 0 first-dot)]
      (tc-source-leading-segment-wins-over-exact-id? env name-id prefix-id))))

(define (tc-dotted-field-index-message [name : String]) : String
  (str-cat
    "typecheck: dotted field access "
    name
    " cannot use numeric field segments; use tuple-ref or array-ref"))

(define (tc-dotted-field-empty-message) : String
  "typecheck: malformed dotted field access; field name cannot be empty")

(define (tc-dotted-field-index-like? [name : String] [start : i64] [len : i64]) : bool
  (and
    (> len 0)
    (>= (string-ref name start) '0')
    (<= (string-ref name start) '9')))

(define (tc-dotted-local-field-name? [env : TcTypeEnv] [name : String]) : bool
  (let
    [first-dot : i64 (tc-name-first-dot name)]
    (if (< first-dot 0)
      false
      (tc-source-leading-segment-wins-over-exact? env name first-dot))))

(define (tc-dotted-local-field-name-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (let
    [first-dot : i64 (intern-first-dot name-id)]
    (if (< first-dot 0)
      false
      (tc-source-leading-segment-wins-over-exact-id-from-dot?
        env
        name-id
        first-dot))))

(define (tc-dotted-local-field-expr-id-tail
  [name : String]
  [start : i64]
  [current : i64]) : ResultTcExprId
  (let
    [n : i64 (string-length name)]
    [i : i64 start]
    (begin
      (while (and (< i n) (not (char-eq (string-ref name i) '.')))
        (set! i (+ i 1)))
      (let
        [len : i64 (- i start)]
        (if (<= len 0)
          (ErrTcExprId (tc-dotted-field-empty-message))
          (if (tc-dotted-field-index-like? name start len)
            (ErrTcExprId (tc-dotted-field-index-message name))
            (let
              [field : String (substring name start len)]
              [next : i64 (ast-expr-struct-get current field)]
              (if (< i n)
                (tc-dotted-local-field-expr-id-tail name (+ i 1) next)
                (OkTcExprId next)))))))))

(define (tc-dotted-local-field-expr-id [env : TcTypeEnv] [name : String]) : ResultTcExprId
  (if (tc-dotted-local-field-name? env name)
    (let
      [first-dot : i64 (tc-name-first-dot name)]
      [root-name : String (substring name 0 first-dot)]
      [root : i64 (ast-node-push (AstExprVar (intern root-name)))]
      (tc-dotted-local-field-expr-id-tail name (+ first-dot 1) root))
    (ErrTcExprId "")))

(define (tc-dotted-local-field-set-expr-id
  [env : TcTypeEnv]
  [name : String]
  [value : i64]) : ResultTcExprId
  (match (tc-dotted-local-field-expr-id env name)
    [(OkTcExprId get-id)
      (match (ast-expr-unspan (ast-node-get get-id))
        [(AstExprStructGet receiver-box field)
          (OkTcExprId (ast-expr-struct-set-id receiver-box field value))]
        [_ (ErrTcExprId "typecheck: internal dotted field target mismatch")])]
    [(ErrTcExprId message) (ErrTcExprId message)]))

(define (tc-imported-module-identity-ids?
  [decls : AstDeclList]
  [current-module-id : i64]
  [target-id : i64]
  [module-id : i64]) : bool
  (match decls
    [(AstDeclNil) false]
    [(AstDeclCons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDeclModule next-module)
            (tc-imported-module-identity-ids?
              rest
              current-module-id
              target-id
              next-module)]
          [(AstDeclImport (AstImportSpec _ _ expected _ _))
            (if (= module-id current-module-id)
              (match expected
                [(AstSomeModuleName target)
                  (if (= (intern target) target-id)
                    true
                    (tc-imported-module-identity-ids?
                      rest
                      current-module-id
                      target-id
                      module-id))]
                [(AstNoModuleName)
                  (tc-imported-module-identity-ids?
                    rest
                    current-module-id
                    target-id
                    module-id)])
              (tc-imported-module-identity-ids?
                rest
                current-module-id
                target-id
                module-id))]
          [_
            (tc-imported-module-identity-ids?
              rest
              current-module-id
              target-id
              module-id)]))]))

(define (tc-imported-module-identity? [ctx : TcContext] [module-name : String]) : bool
  (match ctx
    [(TcContext program _ _ current-module)
      (match program
        [(AstProgram decls-box)
          (tc-imported-module-identity-ids?
            (box-get decls-box)
            (intern current-module)
            (intern module-name)
            (intern ""))])]))

(define (tc-source-dotted-alias-key
  [ctx : TcContext]
  [name : String]
  [first-dot : i64]) : TcMaybeString
  (let
    [n : i64 (string-length name)]
    (if (or (<= first-dot 0) (>= first-dot (- n 1)))
      (TcNoString)
      (let
        [alias : String (substring name 0 first-dot)]
        [base-start : i64 (+ first-dot 1)]
        [base : String (substring name base-start (- n base-start))]
        (match ctx
          [(TcContext program _ _ current-module)
            (match program
              [(AstProgram decls-box)
                (match (macro-import-alias-target-ids
                  (box-get decls-box)
                  (intern current-module)
                  alias
                  (intern ""))
                  [(TcSomeString _)
                    (TcSomeString (compiler-symbol-module-key alias base))]
                  [(TcNoString) (TcNoString)])])])))))

(define (tc-source-dotted-full-path-key [ctx : TcContext] [name : String]) : TcMaybeString
  (let
    [n : i64 (string-length name)]
    [i : i64 0]
    [best-dot : i64 -1]
    (begin
      (while (< i n)
        (begin
          (if (char-eq (string-ref name i) '.')
            (let
              [candidate : String (substring name 0 i)]
              (if (or
                (string-eq candidate (tc-context-module ctx))
                (tc-imported-module-identity? ctx candidate))
                (set! best-dot i)
                unit))
            unit)
          (set! i (+ i 1))))
      (if (and (> best-dot 0) (< best-dot (- n 1)))
        (let
          [base-start : i64 (+ best-dot 1)]
          [module-name : String (substring name 0 best-dot)]
          [base : String (substring name base-start (- n base-start))]
          (TcSomeString (compiler-symbol-module-key module-name base)))
        (TcNoString)))))

(define (tc-unresolved-dotted-name-message [name : String]) : String
  (str-cat
    "typecheck: unknown qualified name "
    name
    "; import the module or use a visible dotted module alias"))

(define (tc-comptime-syntax-helper-name? [name : String]) : bool
  (or
    (string-eq name "expr-bool")
    (string-eq name "expr-int")
    (string-eq name "expr-var")
    (string-eq name "expr-splice")
    (string-eq name "expr-if")
    (ctfe-expr-inspector-name? name)
    (ctfe-expr-list-inspector-name? name)
    (ctfe-expr-clause-inspector-name? name)
    (ctfe-expr-clause-list-inspector-name? name)))

(define (tc-comptime-helper-qualified-lookup-key
  [env : TcTypeEnv]
  [name : String]) : TcMaybeString
  (let
    [call-name : String (ctfe-comptime-helper-call-name name)]
    (if (and
      (not (string-eq call-name name))
      (tc-comptime-syntax-helper-name? call-name)
      (tc-source-name-bound-exact? env call-name))
      (TcSomeString call-name)
      (TcNoString))))

(define (tc-dotted-type-name-lookup-key [ctx : TcContext] [name : String]) : ResultTcString
  (tc-dotted-type-name-lookup-key-from-id ctx name (tc-name-id name)))

;; Variant taking the already-interned `name-id`; reads the first-dot position
;; from id-keyed metadata instead of re-hashing `name`.
(define (tc-dotted-type-name-lookup-key-from-id
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : ResultTcString
  (let
    [first-dot : i64 (intern-first-dot name-id)]
    (if (< first-dot 0)
      (OkTcString name)
      (match (tc-source-dotted-alias-key ctx name first-dot)
        [(TcSomeString key) (OkTcString key)]
        [(TcNoString)
          (match (tc-source-dotted-full-path-key ctx name)
            [(TcSomeString key) (OkTcString key)]
            [(TcNoString)
              (ErrTcString (tc-unresolved-dotted-name-message name))])]))))

(define (tc-source-type-name-lookup-key [ctx : TcContext] [name : String]) : ResultTcString
  (let
    [name-id : i64 (tc-name-id name)]
    (if (tc-source-slash-qualified-id? name name-id)
      (ErrTcString (tc-source-slash-qualified-message name))
      (tc-dotted-type-name-lookup-key-from-id ctx name name-id))))

(define (tc-enum-qualified-variant-lookup-name? [name : String]) : bool
  (>= (tc-name-first-dot (tc-qualified-name-base name)) 0))

(define (tc-enum-qualified-variant-lookup-key [ctx : TcContext] [name : String]) : ResultTcString
  (if (tc-enum-qualified-variant-lookup-name? name)
    (match ctx
      [(TcContext _ _ registries module)
        (if (and (> (string-length module) 0) (not (tc-name-qualified? name)))
          (let
            [module-key : String (compiler-symbol-module-key module name)]
            (match (compiler-registries-lookup-variant registries module-key)
              [(SomeI64 _) (OkTcString module-key)]
              [(NoneI64)
                (match (compiler-registries-lookup-variant registries name)
                  [(SomeI64 _) (OkTcString name)]
                  [(NoneI64) (ErrTcString "")])]))
          (match (compiler-registries-lookup-variant registries name)
            [(SomeI64 _) (OkTcString name)]
            [(NoneI64) (ErrTcString "")]))])
    (ErrTcString "")))

(define (tc-source-name-lookup-key-with-field-check
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [check-local-field : bool]) : ResultTcString
  ;; Intern `name` once; every metadata query below reads the id-keyed slots
  ;; instead of re-hashing the string. This is the hottest name-resolution
  ;; function, previously hashing each name 3-4x (slash-qualified?, first-dot,
  ;; leading-segment, bound-exact?).
  (let
    [name-id : i64 (tc-name-id name)]
    (if (tc-source-slash-qualified-id? name name-id)
      (ErrTcString (tc-source-slash-qualified-message name))
      (let
        [first-dot : i64 (intern-first-dot name-id)]
        (if (< first-dot 0)
          (OkTcString name)
          (if (and
            check-local-field
            (tc-source-leading-segment-wins-over-exact-from-id?
              env
              name
              name-id
              first-dot))
            (OkTcString name)
            (match (tc-comptime-helper-qualified-lookup-key env name)
              [(TcSomeString key) (OkTcString key)]
              [(TcNoString)
                (match (tc-source-dotted-alias-key ctx name first-dot)
                  [(TcSomeString key) (OkTcString key)]
                  [(TcNoString)
                    (match (tc-source-dotted-full-path-key ctx name)
                      [(TcSomeString key) (OkTcString key)]
                      [(TcNoString)
                        (if (tc-source-name-bound-exact-id? env name-id)
                          (OkTcString name)
                          (match (tc-enum-qualified-variant-lookup-key ctx name)
                            [(OkTcString key) (OkTcString key)]
                            [(ErrTcString _)
                              (ErrTcString
                                (tc-unresolved-dotted-name-message name))]))])])])))))))

(define (tc-source-name-lookup-key
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]) : ResultTcString
  (tc-source-name-lookup-key-with-field-check ctx env name true))

(define (tc-source-name-lookup-key-after-local-field-check
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]) : ResultTcString
  (tc-source-name-lookup-key-with-field-check ctx env name false))

(define (tc-qualified-access-target-module
  [ctx : TcContext]
  [qualifier : String]) : String
  (match ctx
    [(TcContext program _ _ current-module)
      (match program
        [(AstProgram decls-box)
          (let
            [decls : AstDeclList (box-get decls-box)]
            (macro-resolve-qualified-module decls current-module qualifier))])]))

(define (tc-qualified-access-private-message
  [kind-name : String]
  [name : String]
  [target-module : String]) : String
  (string-append
    "typecheck: private "
    (string-append
      kind-name
      (string-append
        " "
        (string-append name (string-append " from module " target-module))))))

(define (tc-qualified-export-visible-ok
  [ctx : TcContext]
  [kind-name : String]
  [display-name : String]
  [target-module : String]
  [export-name : String]) : ResultTcUnit
  (if (string-eq target-module (tc-context-module ctx))
    OkTcUnit
    (match (build-compiler-exports-with
      (tc-context-program ctx)
      (tc-context-symbols ctx)
      (tc-context-registries ctx))
      [(OkCompilerExports exports)
        (match (compiler-exports-lookup-id
          exports
          (intern kind-name)
          (intern target-module)
          (intern export-name))
          [(SomeI64 _) OkTcUnit]
          [(NoneI64)
            (ErrTcUnit
              (tc-qualified-access-private-message
                kind-name
                display-name
                target-module))])]
      [(ErrCompilerExports message) (ErrTcUnit message)])))

(define (tc-qualified-name-export-visible-ok
  [ctx : TcContext]
  [kind-name : String]
  [name : String]) : ResultTcUnit
  (if (tc-name-qualified? name)
    (let
      [qualifier : String (tc-qualified-name-module name)]
      [base : String (tc-qualified-name-base name)]
      [target-module : String (tc-qualified-access-target-module ctx qualifier)]
      (tc-qualified-export-visible-ok ctx kind-name name target-module base))
    OkTcUnit))

(define (tc-qualified-type-visible-ok [ctx : TcContext] [name : String]) : ResultTcUnit
  (tc-qualified-name-export-visible-ok ctx (compiler-export-kind-type) name))

(define (tc-value-export-kind-for-handle [handle : i64]) : String
  (let
    [kind : i64 (compiler-symbol-handle-kind handle)]
    (if (= kind (compiler-symbol-kind-defstruct))
      (compiler-export-kind-constructor)
      (if (= kind (compiler-symbol-kind-enum-variant))
        (compiler-export-kind-variant)
        (compiler-export-kind-value)))))

(define (tc-qualified-value-export-kind
  [ctx : TcContext]
  [target-module : String]
  [base : String]) : String
  (match (compiler-symbols-lookup-value-in-module-id
    (tc-context-symbols ctx)
    (intern target-module)
    (intern base))
    [(SomeI64 handle) (tc-value-export-kind-for-handle handle)]
    [(NoneI64) (compiler-export-kind-value)]))

(define (tc-qualified-value-visible-ok [ctx : TcContext] [name : String]) : ResultTcUnit
  (if (tc-name-qualified? name)
    (let
      [qualifier : String (tc-qualified-name-module name)]
      [base : String (tc-qualified-name-base name)]
      [target-module : String (tc-qualified-access-target-module ctx qualifier)]
      [kind-name : String
        (tc-qualified-value-export-kind ctx target-module base)]
      (tc-qualified-export-visible-ok ctx kind-name name target-module base))
    OkTcUnit))

(define (tc-qualified-field-visible-ok
  [ctx : TcContext]
  [struct-name : String]
  [field : String]) : ResultTcUnit
  (if (tc-name-qualified? struct-name)
    (let
      [qualifier : String (tc-qualified-name-module struct-name)]
      [type-base : String (tc-qualified-name-base struct-name)]
      [target-module : String (tc-qualified-access-target-module ctx qualifier)]
      [export-name : String (compiler-export-field-name type-base field)]
      [display-name : String (compiler-export-field-name struct-name field)]
      (tc-qualified-export-visible-ok
        ctx
        (compiler-export-kind-field)
        display-name
        target-module
        export-name))
    OkTcUnit))

(define (tc-qualified-variant-visible-ok
  [ctx : TcContext]
  [variant-name : String]) : ResultTcUnit
  (tc-qualified-name-export-visible-ok
    ctx
    (compiler-export-kind-variant)
    variant-name))

(define (tc-resolved-nominal-type [name : String] [handle : i64]) : AstType
  (if (= (compiler-symbol-handle-kind handle) (compiler-symbol-kind-defenum))
    (AstTyEnum (intern name))
    (if (=
      (compiler-symbol-handle-kind handle)
      (compiler-symbol-kind-defstruct))
      (AstTyStruct (intern name))
      (AstTyVar (intern name)))))

(define (tc-resolved-nominal-type-with-args
  [name : String]
  [handle : i64]
  [lifetimes : AstLifetimeList]) : AstType
  (if (= (compiler-symbol-handle-kind handle) (compiler-symbol-kind-defenum))
    (ast-ty-enum-args (intern name) lifetimes)
    (if (=
      (compiler-symbol-handle-kind handle)
      (compiler-symbol-kind-defstruct))
      (ast-ty-struct-args (intern name) lifetimes)
      (ast-ty-var-args (intern name) lifetimes))))

(define (tc-current-module-owner-name-matches?
  [lookup-name : String]
  [owner-name : String]) : bool
  (or
    (string-eq owner-name lookup-name)
    (and
      (tc-name-qualified? lookup-name)
      (not (tc-name-qualified? owner-name))
      (string-eq owner-name (tc-qualified-name-base lookup-name)))))

(define (tc-current-module-enum? [ctx : TcContext] [name : String]) : bool
  (match (tc-program-enum-variants (tc-context-program ctx) name)
    [(OkAstVariantDefList _) true]
    [(ErrAstVariantDefList _) false]))

(define (tc-resolved-current-module-nominal-type
  [ctx : TcContext]
  [name : String]
  [handle : i64]) : AstType
  (match (tc-nominal-owner-name ctx handle)
    [(OkTcString owner-name)
      (if (tc-current-module-owner-name-matches? name owner-name)
        (tc-resolved-nominal-type name handle)
        (if (tc-current-module-enum? ctx name)
          (AstTyEnum (intern name))
          (tc-resolved-nominal-type name handle)))]
    [(ErrTcString _)
      (if (tc-current-module-enum? ctx name)
        (AstTyEnum (intern name))
        (tc-resolved-nominal-type name handle))]))

(define (tc-resolved-current-module-nominal-type-with-args
  [ctx : TcContext]
  [name : String]
  [handle : i64]
  [lifetimes : AstLifetimeList]) : AstType
  (match (tc-nominal-owner-name ctx handle)
    [(OkTcString owner-name)
      (if (tc-current-module-owner-name-matches? name owner-name)
        (tc-resolved-nominal-type-with-args name handle lifetimes)
        (if (tc-current-module-enum? ctx name)
          (ast-ty-enum-args (intern name) lifetimes)
          (tc-resolved-nominal-type-with-args name handle lifetimes)))]
    [(ErrTcString _)
      (if (tc-current-module-enum? ctx name)
        (ast-ty-enum-args (intern name) lifetimes)
        (tc-resolved-nominal-type-with-args name handle lifetimes))]))

(define tc-nominal-owner-cache-handle : i64
  0)
(define tc-nominal-owner-cache-name : String
  "")
(define tc-nominal-owner-cache-handle1 : i64
  0)
(define tc-nominal-owner-cache-name1 : String
  "")
(define tc-nominal-owner-cache-handle2 : i64
  0)
(define tc-nominal-owner-cache-name2 : String
  "")
(define tc-nominal-owner-cache-handle3 : i64
  0)
(define tc-nominal-owner-cache-name3 : String
  "")
(define tc-nominal-owner-cache-handle4 : i64
  0)
(define tc-nominal-owner-cache-name4 : String
  "")
(define tc-nominal-owner-cache-handle5 : i64
  0)
(define tc-nominal-owner-cache-name5 : String
  "")
(define tc-nominal-owner-cache-handle6 : i64
  0)
(define tc-nominal-owner-cache-name6 : String
  "")
(define tc-nominal-owner-cache-handle7 : i64
  0)
(define tc-nominal-owner-cache-name7 : String
  "")
(define tc-resolve-type-name-cache-valid : bool
  false)
(define tc-resolve-type-name-cache-found : bool
  false)
(define tc-resolve-type-name-cache-key : String
  "")
(define tc-resolve-type-name-cache-handle : i64
  0)

;; The cached name strings are caller-provided and may live in a transient
;; scratch arena (per-function typecheck arenas; #2596): clear them to the
;; static empty string as well, so no slot can compare against freed memory
;; after the owning arena is destroyed.
(define (tc-nominal-owner-cache-reset!) : unit
  (begin
    (set! tc-nominal-owner-cache-handle 0)
    (set! tc-nominal-owner-cache-name "")
    (set! tc-nominal-owner-cache-handle1 0)
    (set! tc-nominal-owner-cache-name1 "")
    (set! tc-nominal-owner-cache-handle2 0)
    (set! tc-nominal-owner-cache-name2 "")
    (set! tc-nominal-owner-cache-handle3 0)
    (set! tc-nominal-owner-cache-name3 "")
    (set! tc-nominal-owner-cache-handle4 0)
    (set! tc-nominal-owner-cache-name4 "")
    (set! tc-nominal-owner-cache-handle5 0)
    (set! tc-nominal-owner-cache-name5 "")
    (set! tc-nominal-owner-cache-handle6 0)
    (set! tc-nominal-owner-cache-name6 "")
    (set! tc-nominal-owner-cache-handle7 0)
    (set! tc-nominal-owner-cache-name7 "")
    (set! tc-resolve-type-name-cache-valid false)
    (set! tc-resolve-type-name-cache-key "")))

(define (tc-resolve-type-name-cache-lookup [lookup-name : String]) : TcTypeNameLookupCache
  (if (and
    tc-resolve-type-name-cache-valid
    (string-eq tc-resolve-type-name-cache-key lookup-name))
    (if tc-resolve-type-name-cache-found
      (TcTypeNameLookupCacheFound tc-resolve-type-name-cache-handle)
      (TcTypeNameLookupCacheMissing))
    (TcTypeNameLookupCacheMiss)))

(define (tc-resolve-type-name-cache-store!
  [lookup-name : String]
  [found : bool]
  [handle : i64]) : unit
  (begin
    (set! tc-resolve-type-name-cache-key lookup-name)
    (set! tc-resolve-type-name-cache-found found)
    (set! tc-resolve-type-name-cache-handle handle)
    (set! tc-resolve-type-name-cache-valid true)))

(define (tc-resolve-type-name-symbol-lookup
  [symbols : CompilerSymbols]
  [lookup-name : String]) : MaybeI64
  (match (tc-resolve-type-name-cache-lookup lookup-name)
    [(TcTypeNameLookupCacheFound handle) (SomeI64 handle)]
    [(TcTypeNameLookupCacheMissing) NoneI64]
    [(TcTypeNameLookupCacheMiss)
      (match (compiler-symbols-lookup-type symbols lookup-name)
        [(SomeI64 handle)
          (begin
            (tc-resolve-type-name-cache-store! lookup-name true handle)
            (SomeI64 handle))]
        [(NoneI64)
          (begin
            (tc-resolve-type-name-cache-store! lookup-name false 0)
            NoneI64)])]))

(define (tc-nominal-owner-cache-slot [handle : i64]) : i64
  (% (compiler-symbol-handle-index handle) 8))

(define (tc-nominal-owner-cache-entry-lookup
  [ctx : TcContext]
  [handle : i64]
  [cached-handle : i64]
  [cached-name : String]) : ResultTcString
  (if (= cached-handle handle)
    (match (tc-resolve-type-name-symbol-lookup
      (tc-context-symbols ctx)
      cached-name)
      [(SomeI64 cached-handle)
        (if (= cached-handle handle)
          (OkTcString cached-name)
          (ErrTcString ""))]
      [(NoneI64) (ErrTcString "")])
    (ErrTcString "")))

(define (tc-nominal-owner-cache-lookup [ctx : TcContext] [handle : i64]) : ResultTcString
  (let
    [slot : i64 (tc-nominal-owner-cache-slot handle)]
    (cond
      [(= slot 0)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle
          tc-nominal-owner-cache-name)]
      [(= slot 1)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle1
          tc-nominal-owner-cache-name1)]
      [(= slot 2)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle2
          tc-nominal-owner-cache-name2)]
      [(= slot 3)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle3
          tc-nominal-owner-cache-name3)]
      [(= slot 4)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle4
          tc-nominal-owner-cache-name4)]
      [(= slot 5)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle5
          tc-nominal-owner-cache-name5)]
      [(= slot 6)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle6
          tc-nominal-owner-cache-name6)]
      [else
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle7
          tc-nominal-owner-cache-name7)])))

(define (tc-nominal-owner-cache-store-if-safe! [handle : i64] [name : String]) : unit
  (if (tc-name-qualified? name)
    unit
    (let
      [slot : i64 (tc-nominal-owner-cache-slot handle)]
      (cond
        [(= slot 0)
          (begin
            (set! tc-nominal-owner-cache-handle handle)
            (set! tc-nominal-owner-cache-name name))]
        [(= slot 1)
          (begin
            (set! tc-nominal-owner-cache-handle1 handle)
            (set! tc-nominal-owner-cache-name1 name))]
        [(= slot 2)
          (begin
            (set! tc-nominal-owner-cache-handle2 handle)
            (set! tc-nominal-owner-cache-name2 name))]
        [(= slot 3)
          (begin
            (set! tc-nominal-owner-cache-handle3 handle)
            (set! tc-nominal-owner-cache-name3 name))]
        [(= slot 4)
          (begin
            (set! tc-nominal-owner-cache-handle4 handle)
            (set! tc-nominal-owner-cache-name4 name))]
        [(= slot 5)
          (begin
            (set! tc-nominal-owner-cache-handle5 handle)
            (set! tc-nominal-owner-cache-name5 name))]
        [(= slot 6)
          (begin
            (set! tc-nominal-owner-cache-handle6 handle)
            (set! tc-nominal-owner-cache-name6 name))]
        [else
          (begin
            (set! tc-nominal-owner-cache-handle7 handle)
            (set! tc-nominal-owner-cache-name7 name))]))))

(define (tc-nominal-owner-name-list
  [decls : AstDeclList]
  [target : i64]
  [index : i64]
  [module : String]) : ResultTcString
  (match decls
    [(AstDeclNil) (ErrTcString "typecheck: nominal owner not found")]
    [(AstDeclCons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDeclImport _)
            (tc-nominal-owner-name-list rest target index module)]
          [(AstDeclIncludeStr _ _)
            (tc-nominal-owner-name-list rest target index module)]
          [(AstDeclIncludeBin _ _)
            (tc-nominal-owner-name-list rest target index module)]
          [(AstDeclExport _)
            (tc-nominal-owner-name-list rest target index module)]
          [(AstDeclModule next-module)
            (tc-nominal-owner-name-list
              rest
              target
              index
              (intern-str next-module))]
          [(AstDeclTest _ _ _)
            (tc-nominal-owner-name-list rest target index module)]
          [(AstDeclDefEnum name _ _)
            (if (= target index)
              (OkTcString (compiler-symbol-module-key module (intern-str name)))
              (tc-nominal-owner-name-list rest target (+ index 1) module))]
          [(AstDeclDefEnumLifetimes name _ _ _)
            (if (= target index)
              (OkTcString (compiler-symbol-module-key module (intern-str name)))
              (tc-nominal-owner-name-list rest target (+ index 1) module))]
          [(AstDeclDefStruct name _ _ _)
            (if (= target index)
              (OkTcString (compiler-symbol-module-key module (intern-str name)))
              (tc-nominal-owner-name-list rest target (+ index 1) module))]
          [(AstDeclDefStructLifetimes name _ _ _ _)
            (if (= target index)
              (OkTcString (compiler-symbol-module-key module (intern-str name)))
              (tc-nominal-owner-name-list rest target (+ index 1) module))]
          [(AstDeclComptimeDecl _ template-box)
            (let
              [template : AstDecl (box-get template-box)]
              (match template
                [(AstDeclDefEnum name _ _)
                  (if (= target index)
                    (OkTcString
                      (compiler-symbol-module-key module (intern-str name)))
                    (tc-nominal-owner-name-list rest target (+ index 1) module))]
                [(AstDeclDefEnumLifetimes name _ _ _)
                  (if (= target index)
                    (OkTcString
                      (compiler-symbol-module-key module (intern-str name)))
                    (tc-nominal-owner-name-list rest target (+ index 1) module))]
                [(AstDeclDefStruct name _ _ _)
                  (if (= target index)
                    (OkTcString
                      (compiler-symbol-module-key module (intern-str name)))
                    (tc-nominal-owner-name-list rest target (+ index 1) module))]
                [(AstDeclDefStructLifetimes name _ _ _ _)
                  (if (= target index)
                    (OkTcString
                      (compiler-symbol-module-key module (intern-str name)))
                    (tc-nominal-owner-name-list rest target (+ index 1) module))]
                [_ (tc-nominal-owner-name-list rest target (+ index 1) module)]))]
          [_ (tc-nominal-owner-name-list rest target (+ index 1) module)]))]))

(define (tc-nominal-owner-name-scan
  [program : AstProgram]
  [handle : i64]
  [index : i64]) : ResultTcString
  (match program
    [(AstProgram decls-box)
      (let
        [decls : AstDeclList (box-get decls-box)]
        (match (tc-nominal-owner-name-list decls index 0 "")
          [(OkTcString name)
            (begin
              (tc-nominal-owner-cache-store-if-safe! handle name)
              (OkTcString name))]
          [(ErrTcString message) (ErrTcString message)]))]))

(define (tc-nominal-owner-name [ctx : TcContext] [handle : i64]) : ResultTcString
  (match (tc-nominal-owner-cache-lookup ctx handle)
    [(OkTcString cached) (OkTcString cached)]
    [(ErrTcString _)
      (match ctx
        [(TcContext program symbols _ _)
          (match (compiler-symbols-owner-name-at-index
            symbols
            (compiler-symbol-handle-index handle))
            [(CompilerSomeString name)
              (begin
                (tc-nominal-owner-cache-store-if-safe! handle name)
                (OkTcString name))]
            [(CompilerNoString)
              (tc-nominal-owner-name-scan
                program
                handle
                (compiler-symbol-handle-index handle))])])]))

(define (tc-resolve-type-name [ctx : TcContext] [name : String]) : AstType
  (match ctx
    [(TcContext _ symbols _ module)
      (let
        [source-name : String
          (match (tc-dotted-type-name-lookup-key ctx name)
            [(OkTcString key) key]
            [(ErrTcString _) name])]
        [lookup-name : String
          (if (and
            (> (string-length module) 0)
            (not (tc-name-qualified? source-name)))
            (compiler-symbol-module-key module source-name)
            source-name)]
        (match (tc-resolve-type-name-symbol-lookup symbols lookup-name)
          [(SomeI64 handle)
            (if (and
              (tc-name-qualified? lookup-name)
              (string-eq (tc-qualified-name-module lookup-name) module))
              (match (tc-stdlib-comptime-syntax-type lookup-name)
                [(AstSomeType syntax-ty) syntax-ty]
                [(AstNoType)
                  (tc-resolved-current-module-nominal-type
                    ctx
                    lookup-name
                    handle)])
              (match (tc-nominal-owner-name ctx handle)
                [(OkTcString canonical-name)
                  (match (tc-stdlib-comptime-syntax-type canonical-name)
                    [(AstSomeType syntax-ty) syntax-ty]
                    [(AstNoType)
                      (tc-resolved-nominal-type canonical-name handle)])]
                [(ErrTcString _)
                  (match (tc-stdlib-comptime-syntax-type lookup-name)
                    [(AstSomeType syntax-ty) syntax-ty]
                    [(AstNoType) (tc-resolved-nominal-type lookup-name handle)])]))]
          [(NoneI64)
            (cond
              [(string-eq name "Expr") (AstTyExpr)]
              [(string-eq name "ExprList") (AstTyExprList)]
              [(string-eq name "ExprClause") (tc-macro-expr-clause-type)]
              [(string-eq name "ExprClauseList")
                (tc-macro-expr-clause-list-type)]
              [else (AstTyVar (intern name))])]))]))

(define (tc-resolve-type [ctx : TcContext] [ty : AstType]) : AstType
  (if (tc-type-needs-resolution? ty)
    (match ty
      [(AstTyFunc args ret)
        (ast-ty-func
          (tc-resolve-type-list ctx (box-get args))
          (tc-resolve-type ctx (ty-node-get ret)))]
      [(AstTyTuple elems)
        (ast-ty-tuple (tc-resolve-type-list ctx (box-get elems)))]
      [(AstTyArray elem len)
        (ast-ty-array (tc-resolve-type ctx (ty-node-get elem)) len)]
      [(AstTyDynArray elem)
        (ast-ty-dyn-array (tc-resolve-type ctx (ty-node-get elem)))]
      [(AstTyBox elem) (ast-ty-box (tc-resolve-type ctx (ty-node-get elem)))]
      [(AstTyPtr elem) (ast-ty-ptr (tc-resolve-type ctx (ty-node-get elem)))]
      [(AstTyMutPtr elem)
        (ast-ty-mut-ptr (tc-resolve-type ctx (ty-node-get elem)))]
      [(AstTyRef region inner)
        (ast-ty-ref region (tc-resolve-type ctx (ty-node-get inner)))]
      [(AstTyMutRef region inner)
        (ast-ty-mut-ref region (tc-resolve-type ctx (ty-node-get inner)))]
      [(AstTyRegion region inner)
        (ast-ty-region region (tc-resolve-type ctx (ty-node-get inner)))]
      [(AstTyVarArgs name lifetimes)
        (tc-resolve-type-name-with-args
          ctx
          (intern-str name)
          (box-get lifetimes))]
      [(AstTyVar name) (tc-resolve-type-name ctx (intern-str name))]
      [_ ty])
    ty))

(define (tc-resolve-type-name-with-args
  [ctx : TcContext]
  [name : String]
  [lifetimes : AstLifetimeList]) : AstType
  (match ctx
    [(TcContext _ symbols _ module)
      (let
        [source-name : String
          (match (tc-dotted-type-name-lookup-key ctx name)
            [(OkTcString key) key]
            [(ErrTcString _) name])]
        [lookup-name : String
          (if (and
            (> (string-length module) 0)
            (not (tc-name-qualified? source-name)))
            (compiler-symbol-module-key module source-name)
            source-name)]
        (match (tc-resolve-type-name-symbol-lookup symbols lookup-name)
          [(SomeI64 handle)
            (if (and
              (tc-name-qualified? lookup-name)
              (string-eq (tc-qualified-name-module lookup-name) module))
              (match (tc-stdlib-comptime-syntax-type lookup-name)
                [(AstSomeType syntax-ty) syntax-ty]
                [(AstNoType)
                  (tc-resolved-current-module-nominal-type-with-args
                    ctx
                    lookup-name
                    handle
                    lifetimes)])
              (match (tc-nominal-owner-name ctx handle)
                [(OkTcString canonical-name)
                  (match (tc-stdlib-comptime-syntax-type canonical-name)
                    [(AstSomeType syntax-ty) syntax-ty]
                    [(AstNoType)
                      (tc-resolved-nominal-type-with-args
                        canonical-name
                        handle
                        lifetimes)])]
                [(ErrTcString _)
                  (match (tc-stdlib-comptime-syntax-type lookup-name)
                    [(AstSomeType syntax-ty) syntax-ty]
                    [(AstNoType)
                      (tc-resolved-nominal-type-with-args
                        lookup-name
                        handle
                        lifetimes)])]))]
          [(NoneI64) (ast-ty-var-args (intern name) lifetimes)]))]))

(define (tc-source-str-value-policy-message) : String
  "typecheck: str is a borrowed string-slice referent; use (& lifetime str)")

(define (tc-source-str-mut-ref-policy-message) : String
  "typecheck: mutable references to str are reserved; use immutable (& lifetime str)")

(define (tc-source-bytes-value-policy-message) : String
  "typecheck: bytes is a borrowed byte-slice referent; use (& lifetime bytes) or (&mut lifetime bytes)")

(define (tc-source-type-policy-message [name : String]) : String
  (cond
    [(string-eq name "varying")
      "typecheck: public SPMD varying source types are deferred; varying is inferred inside foreach (#2764)"]
    [(string-eq name "Varying")
      "typecheck: public SPMD varying source types are deferred; varying is inferred inside foreach (#2764)"]
    [(string-eq name "Vector")
      "typecheck: public SPMD vector source types are deferred; vector values remain compiler-internal (#2764)"]
    [(string-eq name "vector")
      "typecheck: public SPMD vector source types are deferred; vector values remain compiler-internal (#2764)"]
    [(string-eq name "Mask")
      "typecheck: public SPMD mask source types are deferred; masks remain compiler-internal (#2764)"]
    [(string-eq name "mask")
      "typecheck: public SPMD mask source types are deferred; masks remain compiler-internal (#2764)"]
    [else
      (string-append
        "typecheck: unknown type "
        (string-append
          name
          "; TypeLisp has no source-level type parameters; use comptime-generated concrete declarations instead (#893/#913/#970/#902)"))]))

(define (tc-nominal-lifetimes-from-decl [decl : AstDecl]) : ResultTcLifetimeList
  (match decl
    [(AstDeclDefEnum _ _ _) (OkTcLifetimeList AstLifetimeNil)]
    [(AstDeclDefEnumLifetimes _ lifetimes _ _) (OkTcLifetimeList lifetimes)]
    [(AstDeclDefStruct _ _ _ _) (OkTcLifetimeList AstLifetimeNil)]
    [(AstDeclDefStructLifetimes _ lifetimes _ _ _) (OkTcLifetimeList lifetimes)]
    [_ (ErrTcLifetimeList "typecheck: nominal type not found")]))

(define (tc-nominal-lifetimes [ctx : TcContext] [name : String]) : ResultTcLifetimeList
  (match ctx
    [(TcContext _ symbols _ _)
      (match (compiler-symbols-lookup-type symbols name)
        [(SomeI64 handle)
          (match (compiler-symbols-decl-at-index
            symbols
            (compiler-symbol-handle-index handle))
            [(OkAstDecl decl) (tc-nominal-lifetimes-from-decl decl)]
            [(ErrAstDecl message) (ErrTcLifetimeList message)])]
        [(NoneI64) (ErrTcLifetimeList "typecheck: nominal type not found")])]))

(define (tc-nominal-lifetime-use-policy-ok
  [ctx : TcContext]
  [name : String]
  [lifetimes : AstLifetimeList]) : ResultTcUnit
  (match (tc-nominal-lifetimes ctx name)
    [(OkTcLifetimeList params)
      (if (= (tc-lifetime-list-count params) (tc-lifetime-list-count lifetimes))
        OkTcUnit
        (ErrTcUnit "typecheck: nominal lifetime argument arity mismatch"))]
    [(ErrTcLifetimeList message) (ErrTcUnit message)]))

(define (tc-bare-nominal-lifetime-policy-ok [ctx : TcContext] [name : String]) : ResultTcUnit
  (match (tc-nominal-lifetimes ctx name)
    [(OkTcLifetimeList params)
      (match params
        [(AstLifetimeNil) OkTcUnit]
        [_ (ErrTcUnit "typecheck: missing nominal lifetime arguments")])]
    [(ErrTcLifetimeList message) (ErrTcUnit message)]))

(define (tc-source-type-list-policy-ok [ctx : TcContext] [types : AstTypeList]) : ResultTcUnit
  (match types
    [(AstTypeNil) OkTcUnit]
    [(AstTypeCons head tail)
      (let
        [head : AstType (ty-node-get head)]
        [tail : AstTypeList (box-get tail)]
        (match (tc-source-type-policy-ok ctx head)
          [(OkTcUnit) (tc-source-type-list-policy-ok ctx tail)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]))

(define (tc-source-type-policy-ok [ctx : TcContext] [ty : AstType]) : ResultTcUnit
  (if (tc-type-unquote-marker? ty)
    OkTcUnit
    (let
      [syntax-ok : ResultTcUnit
        (match ty
          [(AstTyVar name)
            (match (tc-source-type-name-lookup-key ctx (intern-str name))
              [(OkTcString _) OkTcUnit]
              [(ErrTcString message) (ErrTcUnit message)])]
          [(AstTyVarArgs name _)
            (match (tc-source-type-name-lookup-key ctx (intern-str name))
              [(OkTcString _) OkTcUnit]
              [(ErrTcString message) (ErrTcUnit message)])]
          [_ OkTcUnit])]
      (match syntax-ok
        [(ErrTcUnit message) (ErrTcUnit message)]
        [(OkTcUnit)
          (match (tc-resolve-type ctx ty)
            [(AstTyFunc args ret)
              (match (tc-source-type-list-policy-ok ctx (box-get args))
                [(OkTcUnit) (tc-source-type-policy-ok ctx (ty-node-get ret))]
                [(ErrTcUnit message) (ErrTcUnit message)])]
            [(AstTyTuple elems)
              (tc-source-type-list-policy-ok ctx (box-get elems))]
            [(AstTyArray elem _)
              (tc-source-type-policy-ok ctx (ty-node-get elem))]
            [(AstTyDynArray elem)
              (tc-source-type-policy-ok ctx (ty-node-get elem))]
            [(AstTyBox elem) (tc-source-type-policy-ok ctx (ty-node-get elem))]
            [(AstTyPtr elem) (tc-source-type-policy-ok ctx (ty-node-get elem))]
            [(AstTyMutPtr elem)
              (tc-source-type-policy-ok ctx (ty-node-get elem))]
            [(AstTyRef _ inner)
              (match (tc-resolve-type ctx (ty-node-get inner))
                [(AstTyStr) OkTcUnit]
                [(AstTyBytes) OkTcUnit]
                [_ (tc-source-type-policy-ok ctx (ty-node-get inner))])]
            [(AstTyMutRef _ inner)
              (match (tc-resolve-type ctx (ty-node-get inner))
                [(AstTyStr) (ErrTcUnit (tc-source-str-mut-ref-policy-message))]
                [(AstTyBytes) OkTcUnit]
                [_ (tc-source-type-policy-ok ctx (ty-node-get inner))])]
            [(AstTyRegion _ inner)
              (tc-source-type-policy-ok ctx (ty-node-get inner))]
            [(AstTyStr) (ErrTcUnit (tc-source-str-value-policy-message))]
            [(AstTyBytes) (ErrTcUnit (tc-source-bytes-value-policy-message))]
            [(AstTyEnum name)
              (match (tc-qualified-type-visible-ok ctx (intern-str name))
                [(OkTcUnit)
                  (tc-bare-nominal-lifetime-policy-ok ctx (intern-str name))]
                [(ErrTcUnit message) (ErrTcUnit message)])]
            [(AstTyStruct name)
              (match (tc-qualified-type-visible-ok ctx (intern-str name))
                [(OkTcUnit)
                  (tc-bare-nominal-lifetime-policy-ok ctx (intern-str name))]
                [(ErrTcUnit message) (ErrTcUnit message)])]
            [(AstTyEnumArgs name lifetimes)
              (match (tc-qualified-type-visible-ok ctx (intern-str name))
                [(OkTcUnit)
                  (tc-nominal-lifetime-use-policy-ok
                    ctx
                    (intern-str name)
                    (box-get lifetimes))]
                [(ErrTcUnit message) (ErrTcUnit message)])]
            [(AstTyStructArgs name lifetimes)
              (match (tc-qualified-type-visible-ok ctx (intern-str name))
                [(OkTcUnit)
                  (tc-nominal-lifetime-use-policy-ok
                    ctx
                    (intern-str name)
                    (box-get lifetimes))]
                [(ErrTcUnit message) (ErrTcUnit message)])]
            [(AstTyVarArgs name _)
              (ErrTcUnit (tc-source-type-policy-message (intern-str name)))]
            [(AstTyVar name)
              (if (or
                (= name (intern "ExprClause"))
                (= name (intern "ExprClauseList")))
                OkTcUnit
                (ErrTcUnit (tc-source-type-policy-message (intern-str name))))]
            [_ OkTcUnit])]))))

(define (tc-source-maybe-type-policy-ok
  [ctx : TcContext]
  [maybe-ty : AstMaybeType]) : ResultTcUnit
  (match maybe-ty
    [(AstNoType) OkTcUnit]
    [(AstSomeType ty) (tc-source-type-policy-ok ctx ty)]))

(define (tc-source-param-list-policy-ok
  [ctx : TcContext]
  [params : AstParamList]) : ResultTcUnit
  (match params
    [(AstParamNil) OkTcUnit]
    [(AstParamCons param rest)
      (let
        [rest : AstParamList (box-get rest)]
        (match param
          [(AstParam _ ty _)
            (match (tc-source-type-policy-ok ctx ty)
              [(OkTcUnit) (tc-source-param-list-policy-ok ctx rest)]
              [(ErrTcUnit message) (ErrTcUnit message)])]))]))

(define (tc-source-macro-param-list-policy-ok
  [ctx : TcContext]
  [params : AstMacroParamList]) : ResultTcUnit
  (match params
    [(AstMacroParamNil) OkTcUnit]
    [(AstMacroParamCons param rest)
      (let
        [rest : AstMacroParamList (box-get rest)]
        (match param
          [(AstMacroParam _ ty variadic)
            (if (tc-macro-type-param-kind? ty)
              (if variadic
                (ErrTcUnit "typecheck: type macro operand cannot be variadic")
                (tc-source-macro-param-list-policy-ok ctx rest))
              (match (tc-source-type-policy-ok ctx ty)
                [(OkTcUnit) (tc-source-macro-param-list-policy-ok ctx rest)]
                [(ErrTcUnit message) (ErrTcUnit message)]))]))]))

(define (tc-macro-result-name? [ty : AstType] [upper : String] [lower : String]) : bool
  (match ty
    [(AstTyVar name) (or (= name (intern upper)) (= name (intern lower)))]
    [_ false]))

(define (tc-macro-result-module? [ty : AstType]) : bool
  (tc-macro-result-name? ty "Module" "module"))

(define (tc-macro-result-decls? [ty : AstType]) : bool
  (tc-macro-result-name? ty "Decls" "decls"))

(define (tc-macro-result-decl-emitting? [ty : AstType]) : bool
  (or (tc-macro-result-module? ty) (tc-macro-result-decls? ty)))

(define (tc-source-macro-result-policy-ok [ctx : TcContext] [ty : AstType]) : ResultTcUnit
  (if (tc-macro-result-decl-emitting? ty)
    OkTcUnit
    (tc-source-type-policy-ok ctx ty)))

(define (tc-source-field-list-policy-ok
  [ctx : TcContext]
  [fields : AstFieldDefList]) : ResultTcUnit
  (match fields
    [(AstFieldDefNil) OkTcUnit]
    [(AstFieldDefCons field rest)
      (let
        [rest : AstFieldDefList (box-get rest)]
        (match field
          [(AstFieldDef _ ty _)
            (match (tc-source-type-policy-ok ctx ty)
              [(OkTcUnit) (tc-source-field-list-policy-ok ctx rest)]
              [(ErrTcUnit message) (ErrTcUnit message)])]))]))

(define (tc-struct-cleanup-repr-c-message [struct-name : String]) : String
  (str-cat "typecheck: cleanup-owning struct " struct-name " cannot use repr c"))

(define (tc-source-variant-list-policy-ok
  [ctx : TcContext]
  [variants : AstVariantDefList]) : ResultTcUnit
  (match variants
    [(AstVariantDefNil) OkTcUnit]
    [(AstVariantDefCons variant rest)
      (let
        [rest : AstVariantDefList (box-get rest)]
        (match variant
          [(AstVariantDef _ fields _)
            (match (tc-source-type-list-policy-ok ctx fields)
              [(OkTcUnit) (tc-source-variant-list-policy-ok ctx rest)]
              [(ErrTcUnit message) (ErrTcUnit message)])]))]))

(define (tc-decl-lifetime-name-allowed?
  [params : AstLifetimeList]
  [name : String]) : bool
  (or (string-eq name "program") (tc-lifetime-list-contains params name)))

(define (tc-decl-lifetime-string-list-all-in?
  [lifetimes : TcStringList]
  [params : AstLifetimeList]) : bool
  (match lifetimes
    [(TcStringNil) true]
    [(TcStringCons lifetime rest)
      (and
        (tc-decl-lifetime-name-allowed? params lifetime)
        (tc-decl-lifetime-string-list-all-in? (box-get rest) params))]))

(define (tc-source-type-decl-lifetimes-ok
  [ctx : TcContext]
  [params : AstLifetimeList]
  [ty : AstType]) : ResultTcUnit
  (let
    [lifetimes : TcStringList
      (tc-type-collect-reference-lifetimes (tc-resolve-type ctx ty))]
    (if (tc-decl-lifetime-string-list-all-in? lifetimes params)
      OkTcUnit
      (ErrTcUnit "typecheck: unknown aggregate lifetime parameter"))))

(define (tc-source-field-list-lifetimes-policy-ok
  [ctx : TcContext]
  [params : AstLifetimeList]
  [fields : AstFieldDefList]) : ResultTcUnit
  (match fields
    [(AstFieldDefNil) OkTcUnit]
    [(AstFieldDefCons field rest)
      (let
        [rest : AstFieldDefList (box-get rest)]
        (match field
          [(AstFieldDef _ ty _)
            (match (tc-source-type-policy-ok ctx ty)
              [(OkTcUnit)
                (match (tc-source-type-decl-lifetimes-ok ctx params ty)
                  [(OkTcUnit)
                    (tc-source-field-list-lifetimes-policy-ok ctx params rest)]
                  [(ErrTcUnit message) (ErrTcUnit message)])]
              [(ErrTcUnit message) (ErrTcUnit message)])]))]))

(define (tc-source-type-list-lifetimes-policy-ok
  [ctx : TcContext]
  [params : AstLifetimeList]
  [types : AstTypeList]) : ResultTcUnit
  (match types
    [(AstTypeNil) OkTcUnit]
    [(AstTypeCons head tail)
      (let
        [head : AstType (ty-node-get head)]
        [tail : AstTypeList (box-get tail)]
        (match (tc-source-type-policy-ok ctx head)
          [(OkTcUnit)
            (match (tc-source-type-decl-lifetimes-ok ctx params head)
              [(OkTcUnit)
                (tc-source-type-list-lifetimes-policy-ok ctx params tail)]
              [(ErrTcUnit message) (ErrTcUnit message)])]
          [(ErrTcUnit message) (ErrTcUnit message)]))]))

(define (tc-source-variant-list-lifetimes-policy-ok
  [ctx : TcContext]
  [params : AstLifetimeList]
  [variants : AstVariantDefList]) : ResultTcUnit
  (match variants
    [(AstVariantDefNil) OkTcUnit]
    [(AstVariantDefCons variant rest)
      (let
        [rest : AstVariantDefList (box-get rest)]
        (match variant
          [(AstVariantDef _ fields _)
            (match (tc-source-type-list-lifetimes-policy-ok ctx params fields)
              [(OkTcUnit)
                (tc-source-variant-list-lifetimes-policy-ok ctx params rest)]
              [(ErrTcUnit message) (ErrTcUnit message)])]))]))

(define (tc-source-default-aggregate-layout-finite-ok
  [ctx : TcContext]
  [name : String]) : ResultTcUnit
  (tc-inline-aggregate-layout-finite-ok
    ctx
    (compiler-symbol-module-key (tc-context-module ctx) name)))

(define (tc-source-default-struct-layout-finite-ok
  [ctx : TcContext]
  [name : String]
  [repr : AstStructRepr]) : ResultTcUnit
  (if (ast-struct-repr-c? repr)
    OkTcUnit
    (tc-source-default-aggregate-layout-finite-ok ctx name)))

(define (tc-source-pattern-list-policy-ok
  [ctx : TcContext]
  [patterns : AstPatternList]) : ResultTcUnit
  (match patterns
    [(AstPatternNil) OkTcUnit]
    [(AstPatternCons pattern rest)
      (let
        [pattern : AstPattern (box-get pattern)]
        [rest : AstPatternList (box-get rest)]
        (match (tc-source-pattern-policy-ok ctx pattern)
          [(OkTcUnit) (tc-source-pattern-list-policy-ok ctx rest)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]))

(define (tc-source-pattern-policy-ok [ctx : TcContext] [pattern : AstPattern]) : ResultTcUnit
  (match pattern
    [(AstPatVar _ maybe-ty) (tc-source-maybe-type-policy-ok ctx maybe-ty)]
    [(AstPatTuple patterns-box)
      (let
        [patterns : AstPatternList (box-get patterns-box)]
        (tc-source-pattern-list-policy-ok ctx patterns))]
    [(AstPatVariant _ patterns-box)
      (let
        [patterns : AstPatternList (box-get patterns-box)]
        (tc-source-pattern-list-policy-ok ctx patterns))]
    [_ OkTcUnit]))

(define (tc-source-match-arm-list-policy-ok
  [ctx : TcContext]
  [arms : AstMatchArmList]) : ResultTcUnit
  (match arms
    [(AstMatchArmNil) OkTcUnit]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm pattern body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (match (tc-source-pattern-policy-ok ctx pattern)
                [(OkTcUnit)
                  (match (tc-source-expr-policy-ok ctx body)
                    [(OkTcUnit) (tc-source-match-arm-list-policy-ok ctx rest)]
                    [(ErrTcUnit message) (ErrTcUnit message)])]
                [(ErrTcUnit message) (ErrTcUnit message)]))]))]))

(define (tc-source-let-binding-list-policy-ok
  [ctx : TcContext]
  [bindings : AstLetBindingList]) : ResultTcUnit
  (match bindings
    [(AstLetBindingNil) OkTcUnit]
    [(AstLetBindingCons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding _ maybe-ty init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (match (tc-source-maybe-type-policy-ok ctx maybe-ty)
                [(OkTcUnit)
                  (match (tc-source-expr-policy-ok ctx init)
                    [(OkTcUnit) (tc-source-let-binding-list-policy-ok ctx rest)]
                    [(ErrTcUnit message) (ErrTcUnit message)])]
                [(ErrTcUnit message) (ErrTcUnit message)]))]))]))

(define (tc-source-resource-binding-list-policy-ok
  [ctx : TcContext]
  [bindings : AstResourceBindingList]) : ResultTcUnit
  (match bindings
    [(AstResourceBindingNil) OkTcUnit]
    [(AstResourceBindingCons binding rest)
      (let
        [rest : AstResourceBindingList (box-get rest)]
        (match binding
          [(AstResourceBinding _ init-box cleanup-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              [cleanup : AstExpr (ast-node-get cleanup-box)]
              (match (tc-source-expr-policy-ok ctx init)
                [(OkTcUnit)
                  (match (tc-source-expr-policy-ok ctx cleanup)
                    [(OkTcUnit)
                      (tc-source-resource-binding-list-policy-ok ctx rest)]
                    [(ErrTcUnit message) (ErrTcUnit message)])]
                [(ErrTcUnit message) (ErrTcUnit message)]))]))]))

(define (tc-source-expr-list-policy-ok [ctx : TcContext] [exprs : AstExprList]) : ResultTcUnit
  (match exprs
    [(AstExprNil) OkTcUnit]
    [(AstExprCons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (match (tc-source-expr-policy-ok ctx expr)
          [(OkTcUnit) (tc-source-expr-list-policy-ok ctx rest)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]))

(define (tc-source-expr-pair-policy-ok
  [ctx : TcContext]
  [left : AstExpr]
  [right : AstExpr]) : ResultTcUnit
  (match (tc-source-expr-policy-ok ctx left)
    [(OkTcUnit) (tc-source-expr-policy-ok ctx right)]
    [(ErrTcUnit message) (ErrTcUnit message)]))

(define (tc-source-expr-triple-policy-ok
  [ctx : TcContext]
  [first : AstExpr]
  [second : AstExpr]
  [third : AstExpr]) : ResultTcUnit
  (match (tc-source-expr-pair-policy-ok ctx first second)
    [(OkTcUnit) (tc-source-expr-policy-ok ctx third)]
    [(ErrTcUnit message) (ErrTcUnit message)]))

(define (tc-spmd-broadcast-scope-message) : String
  "typecheck: spmd-broadcast is only valid inside a foreach body, spmd-reduce value expression, or spmd-scan body")

(define (tc-spmd-lane-scope-message [name : String]) : String
  (string-append
    (string-append "typecheck: " name)
    " is only valid inside a foreach body or spmd-reduce value expression"))

(define (tc-source-expr-list-spmd-broadcast-scope-ok
  [exprs : AstExprList]
  [allow : bool]) : ResultTcUnit
  (match exprs
    [(AstExprNil) OkTcUnit]
    [(AstExprCons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (match (tc-source-expr-spmd-broadcast-scope-ok expr allow)
          [(OkTcUnit) (tc-source-expr-list-spmd-broadcast-scope-ok rest allow)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]))

(define (tc-source-expr-pair-spmd-broadcast-scope-ok
  [left : AstExpr]
  [right : AstExpr]
  [allow : bool]) : ResultTcUnit
  (match (tc-source-expr-spmd-broadcast-scope-ok left allow)
    [(OkTcUnit) (tc-source-expr-spmd-broadcast-scope-ok right allow)]
    [(ErrTcUnit message) (ErrTcUnit message)]))

(define (tc-source-expr-triple-spmd-broadcast-scope-ok
  [first : AstExpr]
  [second : AstExpr]
  [third : AstExpr]
  [allow : bool]) : ResultTcUnit
  (match (tc-source-expr-pair-spmd-broadcast-scope-ok first second allow)
    [(OkTcUnit) (tc-source-expr-spmd-broadcast-scope-ok third allow)]
    [(ErrTcUnit message) (ErrTcUnit message)]))

(define (tc-source-let-binding-list-spmd-broadcast-scope-ok
  [bindings : AstLetBindingList]
  [allow : bool]) : ResultTcUnit
  (match bindings
    [(AstLetBindingNil) OkTcUnit]
    [(AstLetBindingCons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding _ _ init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (match (tc-source-expr-spmd-broadcast-scope-ok init allow)
                [(OkTcUnit)
                  (tc-source-let-binding-list-spmd-broadcast-scope-ok
                    rest
                    allow)]
                [(ErrTcUnit message) (ErrTcUnit message)]))]))]))

(define (tc-source-resource-binding-list-spmd-broadcast-scope-ok
  [bindings : AstResourceBindingList]
  [allow : bool]) : ResultTcUnit
  (match bindings
    [(AstResourceBindingNil) OkTcUnit]
    [(AstResourceBindingCons binding rest)
      (let
        [rest : AstResourceBindingList (box-get rest)]
        (match binding
          [(AstResourceBinding _ init-box cleanup-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              [cleanup : AstExpr (ast-node-get cleanup-box)]
              (match (tc-source-expr-pair-spmd-broadcast-scope-ok
                init
                cleanup
                allow)
                [(OkTcUnit)
                  (tc-source-resource-binding-list-spmd-broadcast-scope-ok
                    rest
                    allow)]
                [(ErrTcUnit message) (ErrTcUnit message)]))]))]))

(define (tc-source-match-arm-list-spmd-broadcast-scope-ok
  [arms : AstMatchArmList]
  [allow : bool]) : ResultTcUnit
  (match arms
    [(AstMatchArmNil) OkTcUnit]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm _ body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (match (tc-source-expr-spmd-broadcast-scope-ok body allow)
                [(OkTcUnit)
                  (tc-source-match-arm-list-spmd-broadcast-scope-ok rest allow)]
                [(ErrTcUnit message) (ErrTcUnit message)]))]))]))

(define (tc-source-expr-spmd-broadcast-scope-ok [expr : AstExpr] [allow : bool]) : ResultTcUnit
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprBinary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok left right allow))]
    [(AstExprUnary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprCall func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (match (tc-source-expr-spmd-broadcast-scope-ok func allow)
          [(OkTcUnit) (tc-source-expr-list-spmd-broadcast-scope-ok args allow)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprIf cond-box then-box else-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-box)]
        [else-branch : AstExpr (ast-node-get else-box)]
        (tc-source-expr-triple-spmd-broadcast-scope-ok
          cond
          then-branch
          else-branch
          allow))]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-let-binding-list-spmd-broadcast-scope-ok
              bindings
              allow)
              [(OkTcUnit) (tc-source-expr-spmd-broadcast-scope-ok body allow)]
              [(ErrTcUnit message) (ErrTcUnit message)]))])]
    [(AstExprLambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda _ _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (tc-source-expr-spmd-broadcast-scope-ok body false))])]
    [(AstExprTuple exprs)
      (tc-source-expr-list-spmd-broadcast-scope-ok exprs allow)]
    [(AstExprTupleRef tuple-box _)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        (tc-source-expr-spmd-broadcast-scope-ok tuple allow))]
    [(AstExprArray exprs)
      (tc-source-expr-list-spmd-broadcast-scope-ok exprs allow)]
    [(AstExprMakeArray _ len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (tc-source-expr-spmd-broadcast-scope-ok len allow))]
    [(AstExprArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok array index allow))]
    [(AstExprArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-triple-spmd-broadcast-scope-ok array index value allow))]
    [(AstExprArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok array value allow))]
    [(AstExprStringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok str index allow))]
    [(AstExprWhile cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok cond body allow))]
    [(AstExprBegin exprs)
      (tc-source-expr-list-spmd-broadcast-scope-ok exprs allow)]
    [(AstExprUnsafe exprs)
      (tc-source-expr-list-spmd-broadcast-scope-ok exprs allow)]
    [(AstExprSet _ value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-spmd-broadcast-scope-ok value allow))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprBorrow _ _ place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (tc-source-expr-spmd-broadcast-scope-ok place allow))]
    [(AstExprMatch match-box)
      (match (box-get match-box)
        [(AstMatch scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            (match (tc-source-expr-spmd-broadcast-scope-ok scrutinee allow)
              [(OkTcUnit)
                (tc-source-match-arm-list-spmd-broadcast-scope-ok arms allow)]
              [(ErrTcUnit message) (ErrTcUnit message)]))])]
    [(AstExprForeach fe-box)
      (match (box-get fe-box)
        [(AstForeach _ _ start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-expr-pair-spmd-broadcast-scope-ok start end false)
              [(OkTcUnit) (tc-source-expr-spmd-broadcast-scope-ok body true)]
              [(ErrTcUnit message) (ErrTcUnit message)]))])]
    [(AstExprSpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce _ _ _ start-box end-box init-box value-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            (match (tc-source-expr-triple-spmd-broadcast-scope-ok
              start
              end
              init
              false)
              [(OkTcUnit) (tc-source-expr-spmd-broadcast-scope-ok value true)]
              [(ErrTcUnit message) (ErrTcUnit message)]))])]
    [(AstExprSpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan _ _ _ start-box end-box _ _ init-box value-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-expr-triple-spmd-broadcast-scope-ok
              start
              end
              init
              false)
              [(OkTcUnit)
                (match (tc-source-expr-spmd-broadcast-scope-ok value false)
                  [(OkTcUnit)
                    (tc-source-expr-spmd-broadcast-scope-ok body true)]
                  [(ErrTcUnit message) (ErrTcUnit message)])]
              [(ErrTcUnit message) (ErrTcUnit message)]))])]
    [(AstExprSpmdBroadcast value-box lane-box)
      (if allow
        (let
          [value : AstExpr (ast-node-get value-box)]
          [lane : AstExpr (ast-node-get lane-box)]
          (tc-source-expr-pair-spmd-broadcast-scope-ok value lane true))
        (ErrTcUnit (tc-spmd-broadcast-scope-message)))]
    [(AstExprSpmdProgramIndex)
      (if allow
        OkTcUnit
        (ErrTcUnit (tc-spmd-lane-scope-message "program-index")))]
    [(AstExprSpmdProgramCount)
      (if allow
        OkTcUnit
        (ErrTcUnit (tc-spmd-lane-scope-message "program-count")))]
    [(AstExprStructGet receiver-box _)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (tc-source-expr-spmd-broadcast-scope-ok receiver allow))]
    [(AstExprStructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok receiver value allow))]
    [(AstExprWithRegion _ body)
      (tc-source-expr-list-spmd-broadcast-scope-ok body allow)]
    [(AstExprWithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (match (tc-source-expr-spmd-broadcast-scope-ok scratch allow)
          [(OkTcUnit) (tc-source-expr-list-spmd-broadcast-scope-ok body allow)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprWithScratch body)
      (tc-source-expr-list-spmd-broadcast-scope-ok body allow)]
    [(AstExprInArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (match (tc-source-expr-spmd-broadcast-scope-ok arena allow)
          [(OkTcUnit) (tc-source-expr-list-spmd-broadcast-scope-ok body allow)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprWithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource bindings body)
          (match (tc-source-resource-binding-list-spmd-broadcast-scope-ok
            bindings
            allow)
            [(OkTcUnit)
              (tc-source-expr-list-spmd-broadcast-scope-ok body allow)]
            [(ErrTcUnit message) (ErrTcUnit message)])])]
    [(AstExprBox inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprBoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprBoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprBoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok inner value allow))]
    [(AstExprComptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprQuote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprQuasiquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprUnquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprUnquoteSplicing inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprBracketClause items)
      (tc-source-expr-list-spmd-broadcast-scope-ok items allow)]
    [(AstExprTry inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprReturn inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprPtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprPtrAddrOf inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprPtrRead inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExprPtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok ptr value allow))]
    [(AstExprPtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok ptr offset allow))]
    [(AstExprPtrCast ptr-box _)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-source-expr-spmd-broadcast-scope-ok ptr allow))]
    [(AstExprPtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-source-expr-spmd-broadcast-scope-ok ptr allow))]
    [(AstExprIntToPtr value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-spmd-broadcast-scope-ok value allow))]
    [(AstExprStringData str-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        (tc-source-expr-spmd-broadcast-scope-ok str allow))]
    [(AstExprStringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok ptr len allow))]
    [(AstExprArrayData array-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-source-expr-spmd-broadcast-scope-ok array allow))]
    [(AstExprCpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok leaf subleaf allow))]
    [(AstExprCpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok leaf subleaf allow))]
    [(AstExprCpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok leaf subleaf allow))]
    [(AstExprCpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok leaf subleaf allow))]
    [(AstExprXgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (tc-source-expr-spmd-broadcast-scope-ok index allow))]
    [(AstExprSyscall args)
      (tc-source-expr-list-spmd-broadcast-scope-ok args allow)]
    [_ OkTcUnit]))

(define (tc-source-expr-policy-ok [ctx : TcContext] [expr : AstExpr]) : ResultTcUnit
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExprBinary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (tc-source-expr-pair-policy-ok ctx left right))]
    [(AstExprUnary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExprCall func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (match (tc-source-expr-policy-ok ctx func)
          [(OkTcUnit) (tc-source-expr-list-policy-ok ctx args)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprBracketClause items) (tc-source-expr-list-policy-ok ctx items)]
    [(AstExprTypeLiteral ty) (tc-source-type-policy-ok ctx ty)]
    [(AstExprInit maybe-ty) (tc-source-maybe-type-policy-ok ctx maybe-ty)]
    [(AstExprIf cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (tc-source-expr-triple-policy-ok ctx cond then-branch else-branch))]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-let-binding-list-policy-ok ctx bindings)
              [(OkTcUnit) (tc-source-expr-policy-ok ctx body)]
              [(ErrTcUnit message) (ErrTcUnit message)]))])]
    [(AstExprLambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda params maybe-ret body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-param-list-policy-ok ctx params)
              [(OkTcUnit)
                (match (tc-source-maybe-type-policy-ok ctx maybe-ret)
                  [(OkTcUnit)
                    (if (tc-maybe-type-contains-reference? maybe-ret)
                      (ErrTcUnit
                        "typecheck: returning references requires lifetime support (#804)")
                      (tc-source-expr-policy-ok ctx body))]
                  [(ErrTcUnit message) (ErrTcUnit message)])]
              [(ErrTcUnit message) (ErrTcUnit message)]))])]
    [(AstExprTuple exprs) (tc-source-expr-list-policy-ok ctx exprs)]
    [(AstExprTupleRef tuple-box _)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        (tc-source-expr-policy-ok ctx tuple))]
    [(AstExprArray exprs) (tc-source-expr-list-policy-ok ctx exprs)]
    [(AstExprMakeArray elem-ty len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (match (tc-source-type-policy-ok ctx elem-ty)
          [(OkTcUnit) (tc-source-expr-policy-ok ctx len)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (tc-source-expr-pair-policy-ok ctx array index))]
    [(AstExprArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-triple-policy-ok ctx array index value))]
    [(AstExprArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-policy-ok ctx array value))]
    [(AstExprStringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (tc-source-expr-pair-policy-ok ctx str index))]
    [(AstExprWhile cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (tc-source-expr-pair-policy-ok ctx cond body))]
    [(AstExprBegin exprs) (tc-source-expr-list-policy-ok ctx exprs)]
    [(AstExprUnsafe exprs) (tc-source-expr-list-policy-ok ctx exprs)]
    [(AstExprSet _ value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-policy-ok ctx value))]
    [(AstExprAnn inner-box ty)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-source-expr-policy-ok ctx inner)
          [(OkTcUnit) (tc-source-type-policy-ok ctx ty)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprCast inner-box ty)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-source-expr-policy-ok ctx inner)
          [(OkTcUnit) (tc-source-type-policy-ok ctx ty)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprBorrow _ _ place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (tc-source-expr-policy-ok ctx place))]
    [(AstExprBox inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExprBoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExprBoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExprBoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-policy-ok ctx inner value))]
    [(AstExprMatch match-box)
      (match (box-get match-box)
        [(AstMatch scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            (match (tc-source-expr-policy-ok ctx scrutinee)
              [(OkTcUnit) (tc-source-match-arm-list-policy-ok ctx arms)]
              [(ErrTcUnit message) (ErrTcUnit message)]))])]
    [(AstExprForeach fe-box)
      (match (box-get fe-box)
        [(AstForeach _ index-ty start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-type-policy-ok ctx index-ty)
              [(OkTcUnit) (tc-source-expr-triple-policy-ok ctx start end body)]
              [(ErrTcUnit message) (ErrTcUnit message)]))])]
    [(AstExprSpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce _ _ index-ty start-box end-box init-box value-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            (match (tc-source-type-policy-ok ctx index-ty)
              [(OkTcUnit)
                (match (tc-source-expr-triple-policy-ok ctx start end init)
                  [(OkTcUnit) (tc-source-expr-policy-ok ctx value)]
                  [(ErrTcUnit message) (ErrTcUnit message)])]
              [(ErrTcUnit message) (ErrTcUnit message)]))])]
    [(AstExprSpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan
            _
            _
            index-ty
            start-box
            end-box
            _
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-type-policy-ok ctx index-ty)
              [(OkTcUnit)
                (match (tc-source-type-policy-ok ctx prefix-ty)
                  [(OkTcUnit)
                    (match (tc-source-expr-triple-policy-ok ctx start end init)
                      [(OkTcUnit)
                        (match (tc-source-expr-policy-ok ctx value)
                          [(OkTcUnit) (tc-source-expr-policy-ok ctx body)]
                          [(ErrTcUnit message) (ErrTcUnit message)])]
                      [(ErrTcUnit message) (ErrTcUnit message)])]
                  [(ErrTcUnit message) (ErrTcUnit message)])]
              [(ErrTcUnit message) (ErrTcUnit message)]))])]
    [(AstExprSpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (tc-source-expr-pair-policy-ok ctx value lane))]
    [(AstExprStructGet receiver-box _)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (tc-source-expr-policy-ok ctx receiver))]
    [(AstExprStructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-policy-ok ctx receiver value))]
    [(AstExprWithRegion _ body) (tc-source-expr-list-policy-ok ctx body)]
    [(AstExprWithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (match (tc-source-expr-policy-ok ctx scratch)
          [(OkTcUnit) (tc-source-expr-list-policy-ok ctx body)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprWithScratch body) (tc-source-expr-list-policy-ok ctx body)]
    [(AstExprInArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (match (tc-source-expr-policy-ok ctx arena)
          [(OkTcUnit) (tc-source-expr-list-policy-ok ctx body)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprWithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource bindings body)
          (match (tc-source-resource-binding-list-policy-ok ctx bindings)
            [(OkTcUnit) (tc-source-expr-list-policy-ok ctx body)]
            [(ErrTcUnit message) (ErrTcUnit message)])])]
    [(AstExprComptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExprQuote _) OkTcUnit]
    [(AstExprQuasiquote _) OkTcUnit]
    [(AstExprUnquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExprUnquoteSplicing inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExprTry inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExprReturn inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExprPtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExprPtrAddrOf _) OkTcUnit]
    [(AstExprPtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-source-expr-policy-ok ctx ptr))]
    [(AstExprPtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-policy-ok ctx ptr value))]
    [(AstExprPtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (tc-source-expr-pair-policy-ok ctx ptr offset))]
    [(AstExprPtrCast ptr-box ty)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (match (tc-source-expr-policy-ok ctx ptr)
          [(OkTcUnit) (tc-source-type-policy-ok ctx ty)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprPtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-source-expr-policy-ok ctx ptr))]
    [(AstExprIntToPtr value-box ty)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-source-expr-policy-ok ctx value)
          [(OkTcUnit) (tc-source-type-policy-ok ctx ty)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprStringData str-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        (tc-source-expr-policy-ok ctx str))]
    [(AstExprStringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (tc-source-expr-pair-policy-ok ctx ptr len))]
    [(AstExprArrayData array-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-source-expr-policy-ok ctx array))]
    [(AstExprBinaryData _) OkTcUnit]
    [(AstExprSpmdProgramIndex) OkTcUnit]
    [(AstExprSpmdProgramCount) OkTcUnit]
    [(AstExprProgramArgc) OkTcUnit]
    [(AstExprProgramArgv) OkTcUnit]
    [(AstExprProgramEnvp) OkTcUnit]
    [(AstExprCpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-policy-ok ctx leaf subleaf))]
    [(AstExprCpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-policy-ok ctx leaf subleaf))]
    [(AstExprCpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-policy-ok ctx leaf subleaf))]
    [(AstExprCpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-policy-ok ctx leaf subleaf))]
    [(AstExprXgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (tc-source-expr-policy-ok ctx index))]
    [(AstExprSyscall args) (tc-source-expr-list-policy-ok ctx args)]
    [_ OkTcUnit]))

(define (tc-source-decl-policy-ok [ctx : TcContext] [decl : AstDecl]) : ResultTcUnit
  (match decl
    [(AstDeclDef _ maybe-ty expr-box)
      (let
        [expr : AstExpr (ast-node-get expr-box)]
        (match (tc-source-maybe-type-policy-ok ctx maybe-ty)
          [(OkTcUnit)
            (if (tc-maybe-type-contains-reference? maybe-ty)
              (ErrTcUnit
                "typecheck: storing references in top-level values requires lifetime support (#804)")
              (match (tc-source-expr-policy-ok ctx expr)
                [(OkTcUnit) (tc-source-expr-spmd-broadcast-scope-ok expr false)]
                [(ErrTcUnit message) (ErrTcUnit message)]))]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstDeclDefFn _ params ret body-box _)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (match (tc-source-param-list-policy-ok ctx params)
          [(OkTcUnit)
            (match (tc-source-type-policy-ok ctx ret)
              [(OkTcUnit)
                (match (tc-reference-return-policy-ok ctx params ret)
                  [(OkTcUnit)
                    (match (tc-source-expr-policy-ok ctx body)
                      [(OkTcUnit)
                        (tc-source-expr-spmd-broadcast-scope-ok body false)]
                      [(ErrTcUnit message) (ErrTcUnit message)])]
                  [(ErrTcUnit message) (ErrTcUnit message)])]
              [(ErrTcUnit message) (ErrTcUnit message)])]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstDeclDefMacro _ params ret body-box)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (match (tc-source-macro-param-list-policy-ok ctx params)
          [(OkTcUnit)
            (match (tc-source-macro-result-policy-ok ctx ret)
              [(OkTcUnit)
                (match (tc-source-expr-policy-ok ctx body)
                  [(OkTcUnit)
                    (tc-source-expr-spmd-broadcast-scope-ok body false)]
                  [(ErrTcUnit message) (ErrTcUnit message)])]
              [(ErrTcUnit message) (ErrTcUnit message)])]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstDeclExtern _ _ _ ty) (tc-source-type-policy-ok ctx ty)]
    [(AstDeclDefEnum name _ variants)
      (match (tc-source-variant-list-policy-ok ctx variants)
        [(OkTcUnit)
          (tc-source-default-aggregate-layout-finite-ok ctx (intern-str name))]
        [(ErrTcUnit message) (ErrTcUnit message)])]
    [(AstDeclDefEnumLifetimes name lifetimes _ variants)
      (if (tc-lifetime-list-duplicates? lifetimes)
        (ErrTcUnit "typecheck: duplicate lifetime parameter")
        (match (tc-source-variant-list-lifetimes-policy-ok
          ctx
          lifetimes
          variants)
          [(OkTcUnit)
            (tc-source-default-aggregate-layout-finite-ok ctx (intern-str name))]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstDeclDefStruct name repr cleanup fields)
      (match (tc-source-field-list-policy-ok ctx fields)
        [(OkTcUnit)
          (if (and (ast-struct-repr-c? repr) (ast-struct-cleanup? cleanup))
            (ErrTcUnit
              (tc-struct-cleanup-repr-c-message
                (compiler-symbol-module-key
                  (tc-context-module ctx)
                  (intern-str name))))
            (tc-source-default-struct-layout-finite-ok
              ctx
              (intern-str name)
              repr))]
        [(ErrTcUnit message) (ErrTcUnit message)])]
    [(AstDeclDefStructLifetimes name lifetimes repr cleanup fields)
      (if (tc-lifetime-list-duplicates? lifetimes)
        (ErrTcUnit "typecheck: duplicate lifetime parameter")
        (match (tc-source-field-list-lifetimes-policy-ok ctx lifetimes fields)
          [(OkTcUnit)
            (if (and (ast-struct-repr-c? repr) (ast-struct-cleanup? cleanup))
              (ErrTcUnit
                (tc-struct-cleanup-repr-c-message
                  (compiler-symbol-module-key
                    (tc-context-module ctx)
                    (intern-str name))))
              (tc-source-default-struct-layout-finite-ok
                ctx
                (intern-str name)
                repr))]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstDeclDefDispatch _ _) OkTcUnit]
    [(AstDeclIncludeStr _ _)
      (ErrTcUnit "typecheck: include-str must be expanded by compiler loader")]
    [(AstDeclIncludeBin _ _)
      (ErrTcUnit "typecheck: include-bin must be expanded by compiler loader")]
    [(AstDeclImport _) OkTcUnit]
    [(AstDeclExport _) OkTcUnit]
    [(AstDeclModule _) OkTcUnit]
    [(AstDeclTest _ body-box _)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (tc-source-expr-policy-ok ctx body))]
    [(AstDeclUnsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (tc-source-decl-policy-ok ctx inner))]
    [(AstDeclComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (tc-source-decl-policy-ok ctx template))]))

(define (tc-source-decl-list-policy-ok [ctx : TcContext] [decls : AstDeclList]) : ResultTcUnit
  (tc-source-decl-list-policy-ok-in-module ctx decls ""))

(define (tc-source-decl-list-policy-ok-in-module
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]) : ResultTcUnit
  (match decls
    [(AstDeclNil) OkTcUnit]
    [(AstDeclCons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDeclModule next-module)
            (tc-source-decl-list-policy-ok-in-module
              ctx
              rest
              (intern-str next-module))]
          [_
            (match (tc-source-decl-policy-ok
              (tc-context-with-module ctx module)
              decl)
              [(OkTcUnit)
                (tc-source-decl-list-policy-ok-in-module ctx rest module)]
              [(ErrTcUnit message) (ErrTcUnit message)])]))]))

(define (tc-program-source-types-policy-ok
  [ctx : TcContext]
  [program : AstProgram]) : ResultTcUnit
  (begin
    (tc-nominal-owner-cache-reset!)
    (match program
      [(AstProgram decls-box)
        (let
          [decls : AstDeclList (box-get decls-box)]
          (tc-source-decl-list-policy-ok ctx decls))])))

(define (tc-type-list-eq [a : AstTypeList] [b : AstTypeList]) : bool
  (match a
    [(AstTypeNil)
      (match b
        [(AstTypeNil) true]
        [_ false])]
    [(AstTypeCons ah at)
      (let
        [ah : AstType (ty-node-get ah)]
        [at : AstTypeList (box-get at)]
        (match b
          [(AstTypeCons bh bt)
            (let
              [bh : AstType (ty-node-get bh)]
              [bt : AstTypeList (box-get bt)]
              (and (tc-type-eq ah bh) (tc-type-list-eq at bt)))]
          [_ false]))]))

(define (tc-type-eq-core [a : AstType] [b : AstType]) : bool
  (match a
    [(AstTyI64)
      (match b
        [(AstTyI64) true]
        [_ false])]
    [(AstTyI32)
      (match b
        [(AstTyI32) true]
        [_ false])]
    [(AstTyI16)
      (match b
        [(AstTyI16) true]
        [_ false])]
    [(AstTyI8)
      (match b
        [(AstTyI8) true]
        [_ false])]
    [(AstTyU64)
      (match b
        [(AstTyU64) true]
        [_ false])]
    [(AstTyU32)
      (match b
        [(AstTyU32) true]
        [_ false])]
    [(AstTyU16)
      (match b
        [(AstTyU16) true]
        [_ false])]
    [(AstTyU8)
      (match b
        [(AstTyU8) true]
        [_ false])]
    [(AstTyF64)
      (match b
        [(AstTyF64) true]
        [_ false])]
    [(AstTyF32)
      (match b
        [(AstTyF32) true]
        [_ false])]
    [(AstTyBool)
      (match b
        [(AstTyBool) true]
        [_ false])]
    [(AstTyChar)
      (match b
        [(AstTyChar) true]
        [_ false])]
    [(AstTyString)
      (match b
        [(AstTyString) true]
        [_ false])]
    [(AstTyStr)
      (match b
        [(AstTyStr) true]
        [_ false])]
    [(AstTyBytes)
      (match b
        [(AstTyBytes) true]
        [_ false])]
    [(AstTyUnit)
      (match b
        [(AstTyUnit) true]
        [_ false])]
    [(AstTyNever)
      (match b
        [(AstTyNever) true]
        [_ false])]
    [(AstTyExpr)
      (match b
        [(AstTyExpr) true]
        [_ false])]
    [(AstTyExprList)
      (match b
        [(AstTyExprList) true]
        [_ false])]
    [(AstTyFunc a-args a-ret)
      (match b
        [(AstTyFunc b-args b-ret)
          (and
            (tc-type-list-eq (box-get a-args) (box-get b-args))
            (tc-type-eq (ty-node-get a-ret) (ty-node-get b-ret)))]
        [_ false])]
    [(AstTyTuple a-elems)
      (match b
        [(AstTyTuple b-elems)
          (tc-type-list-eq (box-get a-elems) (box-get b-elems))]
        [_ false])]
    [(AstTyArray a-elem a-len)
      (match b
        [(AstTyArray b-elem b-len)
          (and
            (= a-len b-len)
            (tc-type-eq (ty-node-get a-elem) (ty-node-get b-elem)))]
        [_ false])]
    [(AstTyDynArray a-elem)
      (match b
        [(AstTyDynArray b-elem)
          (tc-type-eq (ty-node-get a-elem) (ty-node-get b-elem))]
        [_ false])]
    [(AstTyBox a-elem)
      (match b
        [(AstTyBox b-elem)
          (tc-type-eq (ty-node-get a-elem) (ty-node-get b-elem))]
        [_ false])]
    [(AstTyPtr a-elem)
      (match b
        [(AstTyPtr b-elem)
          (tc-type-eq (ty-node-get a-elem) (ty-node-get b-elem))]
        [_ false])]
    [(AstTyMutPtr a-elem)
      (match b
        [(AstTyMutPtr b-elem)
          (tc-type-eq (ty-node-get a-elem) (ty-node-get b-elem))]
        [_ false])]
    [(AstTyRef a-region a-inner)
      (match b
        [(AstTyRef b-region b-inner)
          (and
            (string-eq a-region b-region)
            (tc-type-eq (ty-node-get a-inner) (ty-node-get b-inner)))]
        [_ false])]
    [(AstTyMutRef a-region a-inner)
      (match b
        [(AstTyMutRef b-region b-inner)
          (and
            (string-eq a-region b-region)
            (tc-type-eq (ty-node-get a-inner) (ty-node-get b-inner)))]
        [_ false])]
    [(AstTyRegion _ inner)
      (tc-type-eq-core
        (tc-type-without-regions (ty-node-get inner))
        (tc-type-without-regions b))]
    [(AstTyEnum a-name)
      (match b
        [(AstTyEnum b-name) (= a-name b-name)]
        [_ false])]
    [(AstTyEnumArgs a-name a-lifetimes)
      (match b
        [(AstTyEnumArgs b-name b-lifetimes)
          (and
            (= a-name b-name)
            (tc-lifetime-list-eq (box-get a-lifetimes) (box-get b-lifetimes)))]
        [_ false])]
    [(AstTyStruct a-name)
      (match b
        [(AstTyStruct b-name) (= a-name b-name)]
        [_ false])]
    [(AstTyStructArgs a-name a-lifetimes)
      (match b
        [(AstTyStructArgs b-name b-lifetimes)
          (and
            (= a-name b-name)
            (tc-lifetime-list-eq (box-get a-lifetimes) (box-get b-lifetimes)))]
        [_ false])]
    [(AstTyVar a-name)
      (match b
        [(AstTyVar b-name) (= a-name b-name)]
        [_ false])]
    [(AstTyVarArgs a-name a-lifetimes)
      (match b
        [(AstTyVarArgs b-name b-lifetimes)
          (and
            (= a-name b-name)
            (tc-lifetime-list-eq (box-get a-lifetimes) (box-get b-lifetimes)))]
        [_ false])]))

(define (tc-type-eq [a : AstType] [b : AstType]) : bool
  (match a
    [(AstTyRegion _ inner) (tc-type-eq (ty-node-get inner) b)]
    [_
      (match b
        [(AstTyRegion _ inner) (tc-type-eq a (ty-node-get inner))]
        [_ (tc-type-eq-core a b)])]))

(define (tc-never-type? [ty : AstType]) : bool
  (match ty
    [(AstTyNever) true]
    [_ false]))

(define (tc-f32-to-f64-compatible? [expected : AstType] [actual : AstType]) : bool
  (match (tc-type-strip-region expected)
    [(AstTyF64)
      (match (tc-type-strip-region actual)
        [(AstTyF32) true]
        [_ false])]
    [_ false]))

(define (tc-type-compatible? [expected : AstType] [actual : AstType]) : bool
  (if (tc-never-type? actual)
    true
    (if (tc-type-eq expected actual)
      true
      (tc-f32-to-f64-compatible? expected actual))))

(define (tc-merge-branch-type [a : AstType] [b : AstType]) : ResultTcType
  (cond
    [(tc-never-type? a) (OkTcType b)]
    [(tc-never-type? b) (OkTcType a)]
    [(tc-type-eq a b)
      (let
        [a-regions : TcStringList (tc-type-collect-regions a)]
        [b-regions : TcStringList (tc-type-collect-regions b)]
        (if (tc-string-list-eq a-regions b-regions)
          (OkTcType a)
          (match a-regions
            [(TcStringNil) (OkTcType b)]
            [_
              (match b-regions
                [(TcStringNil) (OkTcType a)]
                [_ (ErrTcType "typecheck: if branches must match")])])))]
    [(tc-type-compatible? a b) (OkTcType a)]
    [(tc-type-compatible? b a) (OkTcType b)]
    [else (ErrTcType "typecheck: if branches must match")]))

(define (tc-match-arm-merge-message [previous : AstType] [current : AstType]) : String
  (string-append
    "typecheck: match arms must agree: previous arm type "
    (string-append
      (tc-type-render previous)
      (string-append ", current arm type " (tc-type-render current)))))

(define (tc-integer-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyI64) true]
    [(AstTyI32) true]
    [(AstTyI16) true]
    [(AstTyI8) true]
    [(AstTyU64) true]
    [(AstTyU32) true]
    [(AstTyU16) true]
    [(AstTyU8) true]
    [_ false]))

(define (tc-repeat-text [piece : String] [count : i64]) : String
  (let
    [out : String ""]
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (set! out (string-append out piece))
          (set! i (+ i 1))))
      out)))

(define (tc-binary-ones [bits : i64]) : String
  (tc-repeat-text "1" bits))

(define (tc-binary-min-signed [bits : i64]) : String
  (string-append "1" (tc-repeat-text "0" (- bits 1))))

(define (tc-integer-literal-fits-positive-type? [text : String] [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyI8)
      (ast-int-literal-magnitude-fits-limit? text "127" "7f" (tc-binary-ones 7))]
    [(AstTyI16)
      (ast-int-literal-magnitude-fits-limit?
        text
        "32767"
        "7fff"
        (tc-binary-ones 15))]
    [(AstTyI32)
      (ast-int-literal-magnitude-fits-limit?
        text
        "2147483647"
        "7fffffff"
        (tc-binary-ones 31))]
    [(AstTyI64)
      (ast-int-literal-magnitude-fits-limit?
        text
        "9223372036854775807"
        "7fffffffffffffff"
        (tc-binary-ones 63))]
    [(AstTyU8)
      (ast-int-literal-magnitude-fits-limit? text "255" "ff" (tc-binary-ones 8))]
    [(AstTyU16)
      (ast-int-literal-magnitude-fits-limit?
        text
        "65535"
        "ffff"
        (tc-binary-ones 16))]
    [(AstTyU32)
      (ast-int-literal-magnitude-fits-limit?
        text
        "4294967295"
        "ffffffff"
        (tc-binary-ones 32))]
    [(AstTyU64)
      (ast-int-literal-magnitude-fits-limit?
        text
        "18446744073709551615"
        "ffffffffffffffff"
        (tc-binary-ones 64))]
    [_ false]))

(define (tc-integer-literal-fits-negative-type? [text : String] [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyI8)
      (ast-int-literal-magnitude-fits-limit?
        text
        "128"
        "80"
        (tc-binary-min-signed 8))]
    [(AstTyI16)
      (ast-int-literal-magnitude-fits-limit?
        text
        "32768"
        "8000"
        (tc-binary-min-signed 16))]
    [(AstTyI32)
      (ast-int-literal-magnitude-fits-limit?
        text
        "2147483648"
        "80000000"
        (tc-binary-min-signed 32))]
    [(AstTyI64)
      (ast-int-literal-magnitude-fits-limit?
        text
        "9223372036854775808"
        "8000000000000000"
        (tc-binary-min-signed 64))]
    [_ false]))

(define (tc-integer-literal-fits-type? [text : String] [ty : AstType]) : bool
  (if (ast-int-literal-negative? text)
    (tc-integer-literal-fits-negative-type? text ty)
    (tc-integer-literal-fits-positive-type? text ty)))

(define (tc-integer-literal-value-fits-type? [value : i64] [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyI8) (and (>= value -128) (<= value 127))]
    [(AstTyI16) (and (>= value -32768) (<= value 32767))]
    [(AstTyI32) (and (>= value -2147483648) (<= value 2147483647))]
    [(AstTyI64) true]
    [(AstTyU8) (and (>= value 0) (<= value 255))]
    [(AstTyU16) (and (>= value 0) (<= value 65535))]
    [(AstTyU32) (and (>= value 0) (<= value 4294967295))]
    [(AstTyU64) (>= value 0)]
    [_ false]))

(define (tc-integer-literal-fits-value-or-text?
  [value : i64]
  [text : String]
  [ty : AstType]) : bool
  (if (> (string-length text) 0)
    (tc-integer-literal-fits-type? text ty)
    (tc-integer-literal-value-fits-type? value ty)))

(define (tc-integer-literal-render [value : i64] [text : String]) : String
  (if (> (string-length text) 0)
    text
    (int->string value)))

(define (tc-integer-literal-range-message
  [ctx : TcContext]
  [value : i64]
  [text : String]
  [expected : AstType]) : String
  (str-cat
    "typecheck: integer literal "
    (tc-integer-literal-render value text)
    " does not fit expected type "
    (tc-type-render (tc-type-without-regions (tc-resolve-type ctx expected)))))

(define (tc-integer-literal-type-with-expected
  [ctx : TcContext]
  [value : i64]
  [text : String]
  [expected : AstType]) : ResultTcType
  (let
    [resolved : AstType
      (tc-type-without-regions (tc-resolve-type ctx expected))]
    (if (tc-integer-type? resolved)
      (if (tc-integer-literal-fits-value-or-text? value text resolved)
        (OkTcType resolved)
        (ErrTcType (tc-integer-literal-range-message ctx value text expected)))
      (OkTcType (AstTyI32)))))

(define (tc-float-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyF64) true]
    [(AstTyF32) true]
    [_ false]))

;; Word-class for register-resident aggregates (#2386): a POD type that occupies
;; at most one machine word and is trivially copyable by value. Integers, bool,
;; char, and raw pointers qualify. Floats are excluded (a register-resident
;; aggregate is packed into general-purpose words). Owning handles (Box, String,
;; Array, DynArray), references, closures, tuples, and nested struct/enum fields
;; are excluded too: they would need deep-clone or multi-word handling that the
;; word-copy representation does not provide.
(define (tc-word-class-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyI64) true]
    [(AstTyU64) true]
    [(AstTyI32) true]
    [(AstTyU32) true]
    [(AstTyI16) true]
    [(AstTyU16) true]
    [(AstTyI8) true]
    [(AstTyU8) true]
    [(AstTyBool) true]
    [(AstTyChar) true]
    [(AstTyPtr _) true]
    [(AstTyMutPtr _) true]
    [_ false]))

(define (tc-ordered-comparison-type? [ty : AstType]) : bool
  (if (tc-integer-type? ty)
    true
    (if (tc-float-type? ty)
      true
      (match (tc-type-strip-region ty)
        [(AstTyChar) true]
        [_ false]))))

(define (tc-castable-type? [ty : AstType]) : bool
  (if (tc-integer-type? ty)
    true
    (match (tc-type-strip-region ty)
      [(AstTyChar) true]
      [(AstTyF64) true]
      [(AstTyF32) true]
      [_ false])))

(define (tc-function-to-integer-cast? [from-ty : AstType] [to-ty : AstType]) : bool
  (match (tc-type-strip-region from-ty)
    [(AstTyFunc _ _) (tc-integer-type? (tc-type-strip-region to-ty))]
    [_ false]))

(define (tc-raw-pointer-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyPtr _) true]
    [(AstTyMutPtr _) true]
    [_ false]))

(define (tc-type-move-kind [ty : AstType]) : TcMoveKind
  (match ty
    [(AstTyI64) (TcCopyable)]
    [(AstTyI32) (TcCopyable)]
    [(AstTyI16) (TcCopyable)]
    [(AstTyI8) (TcCopyable)]
    [(AstTyU64) (TcCopyable)]
    [(AstTyU32) (TcCopyable)]
    [(AstTyU16) (TcCopyable)]
    [(AstTyU8) (TcCopyable)]
    [(AstTyF64) (TcCopyable)]
    [(AstTyF32) (TcCopyable)]
    [(AstTyBool) (TcCopyable)]
    [(AstTyChar) (TcCopyable)]
    [(AstTyUnit) (TcCopyable)]
    [(AstTyNever) (TcCopyable)]
    [(AstTyExpr) (TcCopyable)]
    [(AstTyExprList) (TcCopyable)]
    [(AstTyFunc _ _) (TcCopyable)]
    [(AstTyPtr _) (TcCopyable)]
    [(AstTyMutPtr _) (TcCopyable)]
    [(AstTyRef _ _) (TcCopyable)]
    [(AstTyRegion _ inner) (tc-type-move-kind (ty-node-get inner))]
    [(AstTyString) (TcMoveOnly)]
    [(AstTyStr) (TcMoveOnly)]
    [(AstTyBytes) (TcMoveOnly)]
    [(AstTyTuple _) (TcMoveOnly)]
    [(AstTyArray _ _) (TcMoveOnly)]
    [(AstTyDynArray _) (TcMoveOnly)]
    [(AstTyBox _) (TcMoveOnly)]
    [(AstTyMutRef _ _) (TcMoveOnly)]
    [(AstTyEnum _) (TcMoveOnly)]
    [(AstTyEnumArgs _ _) (TcMoveOnly)]
    [(AstTyStruct _) (TcMoveOnly)]
    [(AstTyStructArgs _ _) (TcMoveOnly)]
    [(AstTyVar _) (TcMoveOnly)]
    [(AstTyVarArgs _ _) (TcMoveOnly)]))

(define (tc-move-kind-copyable? [kind : TcMoveKind]) : bool
  (match kind
    [(TcCopyable) true]
    [(TcMoveOnly) false]))

(define (tc-type-copyable? [ty : AstType]) : bool
  (tc-move-kind-copyable? (tc-type-move-kind ty)))

(define (tc-type-move-only? [ty : AstType]) : bool
  (not (tc-type-copyable? ty)))

(define (tc-raw-pointer-elem [ty : AstType] [message : String]) : ResultTcType
  (match (tc-type-strip-region ty)
    [(AstTyPtr elem) (OkTcType (ty-node-get elem))]
    [(AstTyMutPtr elem) (OkTcType (ty-node-get elem))]
    [_ (ErrTcType message)]))

(define (tc-mut-pointer-elem [ty : AstType] [message : String]) : ResultTcType
  (match (tc-type-strip-region ty)
    [(AstTyMutPtr elem) (OkTcType (ty-node-get elem))]
    [_ (ErrTcType message)]))

(define (tc-atomic-pointer-name? [name : String]) : bool
  (or
    (string-eq name "atomic-load")
    (string-eq name "atomic-store!")
    (string-eq name "atomic-add!")
    (string-eq name "atomic-fetch-add!")
    (string-eq name "atomic-cas!")))

(define (tc-atomic-load-name? [name : String]) : bool
  (string-eq name "atomic-load"))

(define (tc-atomic-store-name? [name : String]) : bool
  (string-eq name "atomic-store!"))

(define (tc-atomic-cas-name? [name : String]) : bool
  (string-eq name "atomic-cas!"))

(define (tc-atomic-elem-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyI64) true]
    [(AstTyU64) true]
    [(AstTyI32) true]
    [(AstTyU32) true]
    [_ false]))

(define (tc-atomic-check-elem [elem : AstType]) : ResultTcType
  (let
    [resolved : AstType (tc-type-strip-region elem)]
    (if (tc-atomic-elem-type? resolved)
      (OkTcType resolved)
      (ErrTcType
        "typecheck: atomic pointer element must be i32, i64, u32, or u64"))))

(define (tc-atomic-pointer-elem
  [ctx : TcContext]
  [name : String]
  [ptr-ty : AstType]) : ResultTcType
  (if (tc-atomic-load-name? name)
    (match (tc-raw-pointer-elem
      (tc-resolve-type ctx ptr-ty)
      "typecheck: atomic-load requires a raw pointer operand")
      [(OkTcType elem) (tc-atomic-check-elem (tc-resolve-type ctx elem))]
      [(ErrTcType message) (ErrTcType message)])
    (match (tc-mut-pointer-elem
      (tc-resolve-type ctx ptr-ty)
      (string-append
        "typecheck: "
        (string-append name " requires a MutPtr pointer operand")))
      [(OkTcType elem) (tc-atomic-check-elem (tc-resolve-type ctx elem))]
      [(ErrTcType message) (ErrTcType message)])))

(define (tc-atomic-check-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [value : AstExpr]
  [elem : AstType]
  [message : String]) : ResultTcUnit
  (match (tc-expr-with-expected-or-actual ctx env value elem)
    [(OkTcType value-ty) (tc-expect value-ty elem message)]
    [(ErrTcType message) (ErrTcUnit message)]))

(define (tc-atomic-one-arg-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [ptr : AstExpr]
  [rest : AstExprList]) : ResultTcType
  (match rest
    [(AstExprNil)
      (match (tc-expr ctx env ptr)
        [(OkTcType ptr-ty)
          (match (tc-atomic-pointer-elem ctx name ptr-ty)
            [(OkTcType elem) (OkTcType elem)]
            [(ErrTcType message) (ErrTcType message)])]
        [(ErrTcType message) (ErrTcType message)])]
    [_ (ErrTcType "typecheck: atomic-load expects exactly one argument")]))

(define (tc-atomic-two-arg-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [ptr : AstExpr]
  [value : AstExpr]
  [rest : AstExprList]) : ResultTcType
  (match rest
    [(AstExprNil)
      (match (tc-expr ctx env ptr)
        [(OkTcType ptr-ty)
          (match (tc-atomic-pointer-elem ctx name ptr-ty)
            [(OkTcType elem)
              (match (tc-atomic-check-value
                ctx
                env
                value
                elem
                "typecheck: atomic value type mismatch")
                [(OkTcUnit)
                  (if (tc-atomic-store-name? name)
                    (OkTcType (AstTyUnit))
                    (if (string-eq name "atomic-add!")
                      (OkTcType (AstTyUnit))
                      (OkTcType elem)))]
                [(ErrTcUnit message) (ErrTcType message)])]
            [(ErrTcType message) (ErrTcType message)])]
        [(ErrTcType message) (ErrTcType message)])]
    [_ (ErrTcType "typecheck: atomic update expects exactly two arguments")]))

(define (tc-atomic-cas-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ptr : AstExpr]
  [expected : AstExpr]
  [new-value : AstExpr]
  [rest : AstExprList]) : ResultTcType
  (match rest
    [(AstExprNil)
      (match (tc-expr ctx env ptr)
        [(OkTcType ptr-ty)
          (match (tc-atomic-pointer-elem ctx "atomic-cas!" ptr-ty)
            [(OkTcType elem)
              (match (tc-atomic-check-value
                ctx
                env
                expected
                elem
                "typecheck: atomic expected value type mismatch")
                [(OkTcUnit)
                  (match (tc-atomic-check-value
                    ctx
                    env
                    new-value
                    elem
                    "typecheck: atomic new value type mismatch")
                    [(OkTcUnit) (OkTcType elem)]
                    [(ErrTcUnit message) (ErrTcType message)])]
                [(ErrTcUnit message) (ErrTcType message)])]
            [(ErrTcType message) (ErrTcType message)])]
        [(ErrTcType message) (ErrTcType message)])]
    [_ (ErrTcType "typecheck: atomic-cas! expects exactly three arguments")]))

(define (tc-atomic-nonload-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [ptr : AstExpr]
  [tail0 : AstExprList]) : ResultTcType
  (match tail0
    [(AstExprCons value-node tail1)
      (let
        [value : AstExpr (ast-node-get value-node)]
        [tail1 : AstExprList (box-get tail1)]
        (if (tc-atomic-cas-name? name)
          (match tail1
            [(AstExprCons new-node tail2)
              (tc-atomic-cas-call
                ctx
                env
                ptr
                value
                (ast-node-get new-node)
                (box-get tail2))]
            [_
              (ErrTcType
                "typecheck: atomic-cas! expects exactly three arguments")])
          (tc-atomic-two-arg-call ctx env name ptr value tail1)))]
    [_
      (ErrTcType
        (if (tc-atomic-cas-name? name)
          "typecheck: atomic-cas! expects exactly three arguments"
          "typecheck: atomic update expects exactly two arguments"))]))

(define (tc-atomic-pointer-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [args : AstExprList]) : ResultTcType
  (match (tc-require-unsafe env name)
    [(OkTcUnit)
      (match args
        [(AstExprCons ptr-node tail0)
          (let
            [ptr : AstExpr (ast-node-get ptr-node)]
            [tail0 : AstExprList (box-get tail0)]
            (if (tc-atomic-load-name? name)
              (tc-atomic-one-arg-call ctx env name ptr tail0)
              (tc-atomic-nonload-call ctx env name ptr tail0)))]
        [(AstExprNil)
          (ErrTcType
            (if (tc-atomic-load-name? name)
              "typecheck: atomic-load expects exactly one argument"
              (if (tc-atomic-cas-name? name)
                "typecheck: atomic-cas! expects exactly three arguments"
                "typecheck: atomic update expects exactly two arguments")))])]
    [(ErrTcUnit message) (ErrTcType message)]))

(define (tc-ptr-addr-of-cell-type-ok? [ty : AstType]) : bool
  (if (tc-integer-type? ty)
    true
    (match (tc-type-strip-region ty)
      [(AstTyF64) true]
      [(AstTyF32) true]
      [(AstTyBool) true]
      [(AstTyChar) true]
      [(AstTyPtr _) true]
      [(AstTyMutPtr _) true]
      [_ false])))

(define (tc-ptr-addr-of-local-lookup [env : TcTypeEnv] [name : String]) : ResultTcType
  (match env
    [(TcTypeNil)
      (ErrTcType "typecheck: ptr-addr-of requires a local or parameter name")]
    [(TcTypeCache _ _ _ _ _ _ _ rest _)
      (tc-ptr-addr-of-local-lookup (box-get rest) name)]
    [(TcTypeBind key ty rest)
      (if (= key (tc-hygiene-global-boundary-id))
        (ErrTcType "typecheck: ptr-addr-of requires a local or parameter name")
        (if (= key (tc-name-id name))
          (OkTcType ty)
          (tc-ptr-addr-of-local-lookup (box-get rest) name)))]))

(define (tc-require-unsafe [env : TcTypeEnv] [name : String]) : ResultTcUnit
  (if (tc-in-unsafe? env)
    (begin
      (tc-unused-unsafe-mark-current-used!)
      OkTcUnit)
    (ErrTcUnit
      (string-append
        "typecheck: "
        (string-append name " requires unsafe context")))))

(define (tc-dyn-array-elem-supported? [env : TcTypeEnv] [ty : AstType]) : bool
  (if (tc-integer-type? ty)
    true
    (match (tc-type-strip-region ty)
      [(AstTyBool) true]
      [(AstTyChar) true]
      [(AstTyF64) true]
      [(AstTyF32) true]
      [(AstTyString) true]
      [(AstTyEnum _) true]
      [(AstTyEnumArgs _ _) true]
      [(AstTyStruct _) true]
      [(AstTyStructArgs _ _) true]
      [(AstTyDynArray _) true]
      [(AstTyRef _ _)
        (tc-reference-lifetimes-visible?
          env
          (tc-type-collect-reference-lifetimes ty))]
      [_ false])))

(define (tc-spmd-varying? [class : TcSpmdClass]) : bool
  (match class
    [(TcSpmdUniform) false]
    [(TcSpmdVarying) true]))

(define (tc-spmd-merge-class [a : TcSpmdClass] [b : TcSpmdClass]) : TcSpmdClass
  (if (tc-spmd-varying? a)
    TcSpmdVarying
    (if (tc-spmd-varying? b)
      TcSpmdVarying
      TcSpmdUniform)))

(define (tc-spmd-varying-value-type-supported? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyI64) true]
    [(AstTyU64) true]
    [(AstTyI32) true]
    [(AstTyU32) true]
    [(AstTyI16) true]
    [(AstTyU16) true]
    [(AstTyI8) true]
    [(AstTyU8) true]
    [(AstTyF64) true]
    [(AstTyF32) true]
    [(AstTyBool) true]
    [_ false]))

(define (tc-spmd-lane-type-supported? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyI64) true]
    [(AstTyU64) true]
    [(AstTyI32) true]
    [(AstTyU32) true]
    [(AstTyI16) true]
    [(AstTyU16) true]
    [(AstTyI8) true]
    [(AstTyU8) true]
    [(AstTyF64) true]
    [(AstTyF32) true]
    [(AstTyBool) true]
    [_ false]))

(define (tc-spmd-broadcast-type-supported? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyI64) true]
    [(AstTyU64) true]
    [(AstTyI32) true]
    [(AstTyU32) true]
    [(AstTyF64) true]
    [(AstTyF32) true]
    [_ false]))

(define (tc-spmd-broadcast-type-message) : String
  "typecheck: spmd-broadcast value must have type i32, u32, i64, u64, f32, or f64; bool broadcast remains deferred")

(define (tc-spmd-broadcast-finish
  [ctx : TcContext]
  [expr-ty : AstType]
  [value-class : TcSpmdClass]
  [lane-ty : AstType]
  [lane-class : TcSpmdClass]
  [lane-env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (if (tc-spmd-broadcast-type-supported? (tc-resolve-type ctx expr-ty))
    (match (tc-spmd-require-uniform
      lane-class
      "typecheck: spmd-broadcast lane must be uniform")
      [(OkTcUnit)
        (match (tc-expect
          (tc-resolve-type ctx lane-ty)
          (AstTyI64)
          "typecheck: spmd-broadcast lane must have type i64")
          [(OkTcUnit) (tc-spmd-finish expr-ty value-class lane-env)]
          [(ErrTcUnit message) (ErrTcSpmdExprInfo message)])]
      [(ErrTcUnit message) (ErrTcSpmdExprInfo message)])
    (ErrTcSpmdExprInfo (tc-spmd-broadcast-type-message))))

(define (tc-spmd-finish [ty : AstType] [class : TcSpmdClass] [env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (if (and
    (tc-spmd-varying? class)
    (not (tc-spmd-varying-value-type-supported? ty)))
    (ErrTcSpmdExprInfo
      (string-append
        "typecheck: foreach varying value type is not supported: "
        (tc-type-render (tc-type-strip-region ty))))
    (OkTcSpmdExprInfo (TcSpmdExprInfo ty class env))))

(define (tc-spmd-finish-lane
  [ty : AstType]
  [class : TcSpmdClass]
  [env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (if (and (tc-spmd-varying? class) (not (tc-spmd-lane-type-supported? ty)))
    (ErrTcSpmdExprInfo
      (string-append
        "typecheck: foreach varying array lane type is not supported: "
        (tc-type-render (tc-type-strip-region ty))))
    (tc-spmd-finish ty class env)))

(define (tc-spmd-cpuid-like
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : AstType]
  [leaf : AstExpr]
  [subleaf : AstExpr]) : ResultTcSpmdExprInfo
  (match (tc-spmd-expr ctx env spmd-env leaf)
    [(OkTcSpmdExprInfo leaf-info)
      (match leaf-info
        [(TcSpmdExprInfo _ leaf-class leaf-env)
          (match (tc-spmd-expr ctx env leaf-env subleaf)
            [(OkTcSpmdExprInfo subleaf-info)
              (match subleaf-info
                [(TcSpmdExprInfo _ subleaf-class subleaf-env)
                  (tc-spmd-finish
                    expr-ty
                    (tc-spmd-merge-class leaf-class subleaf-class)
                    subleaf-env)])]
            [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)])])]
    [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)]))

(define (tc-spmd-env-from-type-env [env : TcTypeEnv]) : TcSpmdEnv
  (match env
    [(TcTypeNil) TcSpmdEnvNil]
    [(TcTypeCache _ _ _ _ _ _ _ rest _)
      (tc-spmd-env-from-type-env (box-get rest))]
    [(TcTypeBind name-id ty rest)
      (TcSpmdEnvBind
        (intern-str name-id)
        ty
        TcSpmdUniform
        TcSpmdOuter
        TcSpmdValue
        (box (tc-spmd-env-from-type-env (box-get rest))))]))

(define (tc-spmd-env-bind
  [env : TcSpmdEnv]
  [name : String]
  [ty : AstType]
  [class : TcSpmdClass]
  [scope : TcSpmdScope]) : TcSpmdEnv
  (TcSpmdEnvBind name ty class scope TcSpmdValue (box env)))

(define (tc-spmd-env-bind-role
  [env : TcSpmdEnv]
  [name : String]
  [ty : AstType]
  [class : TcSpmdClass]
  [scope : TcSpmdScope]
  [role : TcSpmdRole]) : TcSpmdEnv
  (TcSpmdEnvBind name ty class scope role (box env)))

(define (tc-spmd-env-lookup [env : TcSpmdEnv] [name : String]) : TcSpmdLookup
  (match env
    [(TcSpmdEnvNil) TcSpmdMissing]
    [(TcSpmdEnvBind key ty class scope role rest)
      (if (string-eq key name)
        (TcSpmdFound ty class scope role)
        (tc-spmd-env-lookup (box-get rest) name))]))

(define (tc-spmd-env-has-local? [env : TcSpmdEnv] [name : String]) : bool
  (match env
    [(TcSpmdEnvNil) false]
    [(TcSpmdEnvBind key _ _ scope _ rest)
      (if (string-eq key name)
        (match scope
          [(TcSpmdLocal) true]
          [(TcSpmdOuter) (tc-spmd-env-has-local? (box-get rest) name)])
        (tc-spmd-env-has-local? (box-get rest) name))]))

(define (tc-spmd-env-has-outer? [env : TcSpmdEnv] [name : String]) : bool
  (match env
    [(TcSpmdEnvNil) false]
    [(TcSpmdEnvBind key _ _ scope _ rest)
      (if (string-eq key name)
        (match scope
          [(TcSpmdOuter) true]
          [(TcSpmdLocal) (tc-spmd-env-has-outer? (box-get rest) name)])
        (tc-spmd-env-has-outer? (box-get rest) name))]))

(define (tc-spmd-env-set-local-class
  [env : TcSpmdEnv]
  [name : String]
  [class : TcSpmdClass]) : TcSpmdEnv
  (match env
    [(TcSpmdEnvNil) TcSpmdEnvNil]
    [(TcSpmdEnvBind key ty old-class scope role rest)
      (if (string-eq key name)
        (match scope
          [(TcSpmdLocal) (TcSpmdEnvBind key ty class scope role rest)]
          [(TcSpmdOuter)
            (TcSpmdEnvBind
              key
              ty
              old-class
              scope
              role
              (box (tc-spmd-env-set-local-class (box-get rest) name class)))])
        (TcSpmdEnvBind
          key
          ty
          old-class
          scope
          role
          (box (tc-spmd-env-set-local-class (box-get rest) name class))))]))

(define (tc-spmd-env-pop [env : TcSpmdEnv] [count : i64]) : TcSpmdEnv
  (if (<= count 0)
    env
    (match env
      [(TcSpmdEnvNil) TcSpmdEnvNil]
      [(TcSpmdEnvBind _ _ _ _ _ rest)
        (tc-spmd-env-pop (box-get rest) (- count 1))])))

(define (tc-spmd-env-mark-outer [env : TcSpmdEnv]) : TcSpmdEnv
  (match env
    [(TcSpmdEnvNil) TcSpmdEnvNil]
    [(TcSpmdEnvBind name ty class _ role rest)
      (TcSpmdEnvBind
        name
        ty
        class
        TcSpmdOuter
        role
        (box (tc-spmd-env-mark-outer (box-get rest))))]))

(define (tc-spmd-env-merge-classes [left : TcSpmdEnv] [right : TcSpmdEnv]) : TcSpmdEnv
  (match left
    [(TcSpmdEnvNil) TcSpmdEnvNil]
    [(TcSpmdEnvBind name ty class scope role left-rest)
      (match right
        [(TcSpmdEnvNil) left]
        [(TcSpmdEnvBind _ _ right-class _ _ right-rest)
          (TcSpmdEnvBind
            name
            ty
            (tc-spmd-merge-class class right-class)
            scope
            role
            (box
              (tc-spmd-env-merge-classes
                (box-get left-rest)
                (box-get right-rest))))])]))

(define (tc-type-env-box-smoke?) : bool
  (let
    [env : TcTypeEnv
      (tc-bind-return-type
        (tc-bind
          (tc-bind (tc-push-region (tc-empty-env) "arena") "x" (AstTyI64))
          "x"
          (AstTyBool))
        (AstTyI64))]
    [cached : TcTypeEnv (tc-env-with-cache env)]
    (and
      (= (tc-env-cache-count cached) 4)
      (match (tc-lookup cached "x")
        [(OkTcType (AstTyBool)) true]
        [_ false])
      (match (tc-current-return-type env)
        [(OkTcType (AstTyI64)) true]
        [_ false])
      (match (tc-active-region env)
        [(TcSomeString region) (string-eq region "arena")]
        [_ false])
      (tc-lifetime-visible? env "arena"))))

(define (tc-type-env-cache-head? [env : TcTypeEnv]) : bool
  (match env
    [(TcTypeCache _ _ _ _ _ _ _ _ _) true]
    [_ false]))

(define (tc-type-env-cache-partial-head? [env : TcTypeEnv]) : bool
  (match env
    [(TcTypeCache _ _ _ _ _ _ partial _ _) partial]
    [_ false]))

(define (tc-type-env-bind-many [env : TcTypeEnv] [count : i64]) : TcTypeEnv
  (let
    [i : i64 0]
    [out : TcTypeEnv env]
    (begin
      (while (< i count)
        (begin
          (set!
            out
            (tc-bind out (string-append "local" (int->string i)) (AstTyI64)))
          (set! i (+ i 1))))
      out)))

(define (tc-type-env-local-cache-behavior-smoke?) : bool
  (let
    [base : TcTypeEnv
      (tc-env-with-cache (tc-bind (tc-empty-env) "global" (AstTyString)))]
    [marked : TcTypeEnv
      (tc-bind-return-type
        (tc-bind-unsafe (tc-push-region base "arena") "danger" (AstTyI64))
        (AstTyI64))]
    [shadowed : TcTypeEnv
      (tc-bind (tc-bind marked "shadow" (AstTyI64)) "shadow" (AstTyBool))]
    [cached : TcTypeEnv
      (tc-type-env-bind-many shadowed (- (tc-local-cache-threshold) 6))]
    (and
      (tc-type-env-cache-head? cached)
      (match (tc-lookup cached "shadow")
        [(OkTcType (AstTyBool)) true]
        [_ false])
      (match (tc-lookup cached "global")
        [(OkTcType (AstTyString)) true]
        [_ false])
      (match (tc-lookup-unsafe cached "danger")
        [(OkTcTypeUnsafe (AstTyI64) unsafe) unsafe]
        [_ false])
      (match (tc-lookup cached "missing")
        [(ErrTcType message)
          (string-eq message "typecheck: unbound name missing")]
        [_ false])
      (match (tc-current-return-type cached)
        [(OkTcType (AstTyI64)) true]
        [_ false])
      (match (tc-active-region cached)
        [(TcSomeString region) (string-eq region "arena")]
        [_ false])
      (tc-lifetime-visible? cached "shadow"))))

(define (tc-type-env-local-cache-default-shadow-smoke?) : bool
  (let
    [base : TcTypeEnv (tc-env-with-cache (tc-default-env))]
    [shadowed : TcTypeEnv
      (tc-bind base "string-length" (tc-fn1 (AstTyI64) (AstTyI64)))]
    [cached : TcTypeEnv
      (tc-type-env-bind-many shadowed (- (tc-local-cache-threshold) 1))]
    (and
      (tc-type-env-cache-head? cached)
      (not (tc-default-builtin-unshadowed? cached "string-length")))))

(define (tc-type-env-local-cache-partial-layer-smoke?) : bool
  (let
    [base : TcTypeEnv
      (tc-env-with-cache (tc-bind (tc-empty-env) "global" (AstTyString)))]
    [layer1 : TcTypeEnv (tc-type-env-bind-many base (tc-local-cache-threshold))]
    [older-shadow : TcTypeEnv (tc-bind layer1 "shadow" (AstTyI64))]
    [layer2 : TcTypeEnv
      (tc-type-env-bind-many older-shadow (- (tc-local-cache-threshold) 1))]
    [newer-shadow : TcTypeEnv (tc-bind layer2 "shadow" (AstTyBool))]
    [layer3 : TcTypeEnv
      (tc-type-env-bind-many newer-shadow (- (tc-local-cache-threshold) 1))]
    (and
      (tc-type-env-cache-partial-head? layer1)
      (tc-type-env-cache-partial-head? layer2)
      (tc-type-env-cache-partial-head? layer3)
      (= (tc-env-partial-layer-depth layer3) 3)
      (match (tc-lookup layer3 "global")
        [(OkTcType (AstTyString)) true]
        [_ false])
      (match (tc-lookup layer2 "shadow")
        [(OkTcType (AstTyI64)) true]
        [_ false])
      (match (tc-lookup layer3 "shadow")
        [(OkTcType (AstTyBool)) true]
        [_ false]))))

(define (tc-type-env-local-cache-default-shadow-partial-miss-smoke?) : bool
  (let
    [base : TcTypeEnv (tc-env-with-cache (tc-default-env))]
    [shadowed : TcTypeEnv
      (tc-bind base "string-length" (tc-fn1 (AstTyI64) (AstTyI64)))]
    [shadow-layer : TcTypeEnv
      (tc-type-env-bind-many shadowed (- (tc-local-cache-threshold) 1))]
    [miss-layer : TcTypeEnv
      (tc-type-env-bind-many shadow-layer (tc-local-cache-threshold))]
    [clear-layer : TcTypeEnv
      (tc-type-env-bind-many base (tc-local-cache-threshold))]
    (and
      (tc-type-env-cache-partial-head? shadow-layer)
      (tc-type-env-cache-partial-head? miss-layer)
      (tc-type-env-cache-partial-head? clear-layer)
      (not (tc-default-builtin-unshadowed? shadow-layer "string-length"))
      (not (tc-default-builtin-unshadowed? miss-layer "string-length"))
      (tc-default-builtin-unshadowed? clear-layer "string-length"))))

(define (tc-type-env-local-cache-depth-cap-smoke?) : bool
  (let
    [base : TcTypeEnv
      (tc-env-with-cache (tc-bind (tc-empty-env) "global" (AstTyString)))]
    [deep : TcTypeEnv
      (tc-type-env-bind-many
        base
        (* (tc-local-cache-threshold) (+ (tc-local-cache-partial-layer-cap) 1)))]
    (and
      (tc-type-env-cache-head? deep)
      (not (tc-type-env-cache-partial-head? deep))
      (= (tc-env-partial-layer-depth deep) 0)
      (match (tc-lookup deep "global")
        [(OkTcType (AstTyString)) true]
        [_ false]))))

;; #2661: markers buried below MORE THAN ONE compaction window. The behavior
;; smoke above only crosses one threshold, so the head cache is unwrapped and
;; the markers are reached by the plain bind walk; with two stacked
;; compaction caches the scans must recurse through scan-through cache nodes
;; or the markers disappear (with-arena escape checking was silently disabled
;; past 32 local binds). Scans must still terminate at the explicit
;; non-scan-through base cache.
(define (tc-type-env-local-cache-deep-scan-smoke?) : bool
  (let
    [base : TcTypeEnv
      (tc-env-with-cache (tc-bind (tc-empty-env) "global" (AstTyString)))]
    [marked : TcTypeEnv
      (tc-bind
        (tc-bind-cleanup-owner
          (tc-bind-return-type
            (tc-enter-unsafe (tc-push-region base "arena"))
            (AstTyI64))
          "resource")
        "resource"
        (AstTyString))]
    [deep : TcTypeEnv
      (tc-type-env-bind-many marked (+ (* (tc-local-cache-threshold) 2) 8))]
    [below-base : TcTypeEnv
      (tc-type-env-bind-many base (+ (* (tc-local-cache-threshold) 2) 8))]
    (and
      (match (tc-active-region deep)
        [(TcSomeString region) (string-eq region "arena")]
        [_ false])
      (match (tc-current-return-type deep)
        [(OkTcType (AstTyI64)) true]
        [_ false])
      (tc-in-unsafe? deep)
      (tc-string-list-contains (tc-active-cleanup-owners deep) "resource")
      (tc-lifetime-visible? deep "arena")
      (match (tc-active-region below-base)
        [(TcNoString) true]
        [_ false]))))

(define (tc-type-env-local-cache-smoke?) : bool
  (and
    (tc-type-env-local-cache-behavior-smoke?)
    (tc-type-env-local-cache-default-shadow-smoke?)
    (tc-type-env-local-cache-partial-layer-smoke?)
    (tc-type-env-local-cache-default-shadow-partial-miss-smoke?)
    (tc-type-env-local-cache-depth-cap-smoke?)
    (tc-type-env-local-cache-deep-scan-smoke?)))

(define (tc-spmd-env-box-smoke?) : bool
  (let
    [env : TcTypeEnv
      (tc-bind (tc-bind (tc-empty-env) "x" (AstTyI64)) "flag" (AstTyBool))]
    [outer : TcSpmdEnv (tc-spmd-env-from-type-env env)]
    [local : TcSpmdEnv
      (tc-spmd-env-bind outer "lane" (AstTyI64) TcSpmdVarying TcSpmdLocal)]
    [updated : TcSpmdEnv
      (tc-spmd-env-set-local-class local "lane" TcSpmdUniform)]
    (and
      (match (tc-spmd-env-lookup updated "lane")
        [(TcSpmdFound (AstTyI64) (TcSpmdUniform) (TcSpmdLocal) (TcSpmdValue))
          true]
        [_ false])
      (tc-spmd-env-has-local? updated "lane")
      (tc-spmd-env-has-outer? updated "x")
      (match (tc-spmd-env-lookup (tc-spmd-env-pop updated 1) "lane")
        [(TcSpmdMissing) true]
        [_ false]))))

(define (tc-literal-type [lit : AstLiteral]) : AstType
  (match lit
    [(AstLitInt _ _) (AstTyI32)]
    [(AstLitFloat _) (AstTyF64)]
    [(AstLitBool _) (AstTyBool)]
    [(AstLitChar _) (AstTyChar)]
    [(AstLitString _) (AstTyString)]
    [(AstLitUnit) (AstTyUnit)]))

(define (tc-param-type-list [ctx : TcContext] [params : AstParamList]) : AstTypeList
  (match params
    [(AstParamNil) AstTypeNil]
    [(AstParamCons param rest)
      (let
        [rest : AstParamList (box-get rest)]
        (match param
          [(AstParam _ ty _)
            (ast-type-cons
              (tc-resolve-type ctx ty)
              (tc-param-type-list ctx rest))]))]))

(define (tc-type-list-ref [types : AstTypeList] [index : i64]) : ResultTcType
  (if (< index 0)
    (ErrTcType "typecheck: tuple index out of bounds")
    (match types
      [(AstTypeNil) (ErrTcType "typecheck: tuple index out of bounds")]
      [(AstTypeCons ty rest)
        (let
          [ty : AstType (ty-node-get ty)]
          [rest : AstTypeList (box-get rest)]
          (if (= index 0)
            (OkTcType ty)
            (tc-type-list-ref rest (- index 1))))])))

(define (tc-expr-list-len [exprs : AstExprList]) : i64
  (match exprs
    [(AstExprNil) 0]
    [(AstExprCons _ rest)
      (let
        [rest : AstExprList (box-get rest)]
        (+ 1 (tc-expr-list-len rest)))]))

(define (tc-expr-list-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]) : ResultTcTypeList
  (match exprs
    [(AstExprNil) (OkTcTypeList AstTypeNil)]
    [(AstExprCons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (match (tc-expr ctx env expr)
          [(OkTcType ty)
            (match (tc-expr-list-types ctx env rest)
              [(OkTcTypeList rest-types)
                (OkTcTypeList (ast-type-cons ty rest-types))]
              [(ErrTcTypeList message) (ErrTcTypeList message)])]
          [(ErrTcType message) (ErrTcTypeList message)]))]))

(define (tc-check-array-rest
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [elem-ty : AstType]) : ResultTcUnit
  (match exprs
    [(AstExprNil) OkTcUnit]
    [(AstExprCons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (match (tc-expr-with-expected-or-actual ctx env expr elem-ty)
          [(OkTcType ty)
            (match (tc-expect
              ty
              elem-ty
              "typecheck: array elements must have same type")
              [(OkTcUnit) (tc-check-array-rest ctx env rest elem-ty)]
              [(ErrTcUnit message) (ErrTcUnit message)])]
          [(ErrTcType message) (ErrTcUnit message)]))]))

(define (tc-bind-params
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]) : TcTypeEnv
  (match params
    [(AstParamNil) env]
    [(AstParamCons param rest)
      (let
        [rest : AstParamList (box-get rest)]
        (match param
          [(AstParam name ty _)
            (tc-bind-params
              ctx
              (tc-bind-id env name (tc-resolve-type ctx ty))
              rest)]))]))

(define (tc-bind-macro-params
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstMacroParamList]) : TcTypeEnv
  (match params
    [(AstMacroParamNil) env]
    [(AstMacroParamCons param rest)
      (let
        [rest : AstMacroParamList (box-get rest)]
        (match param
          [(AstMacroParam name ty variadic)
            (tc-bind-macro-params
              ctx
              (tc-bind-id
                env
                name
                (cond
                  [(tc-macro-type-param-kind? ty) (AstTyExpr)]
                  [(and
                      variadic
                      (tc-macro-expr-clause-type?
                        (tc-resolve-type ctx (tc-macro-signature-type ty))))
                    (tc-macro-expr-clause-list-type)]
                  [(tc-macro-expr-clause-type?
                      (tc-resolve-type ctx (tc-macro-signature-type ty)))
                    (tc-macro-expr-clause-type)]
                  [variadic (AstTyExprList)]
                  [else (AstTyExpr)]))
              rest)]))]))

(define (tc-ctfe-env-extend-macro-params
  [ctx : TcContext]
  [env : CtfeEnv]
  [params : AstMacroParamList]) : CtfeEnv
  (match params
    [(AstMacroParamNil) env]
    [(AstMacroParamCons param rest)
      (let
        [rest : AstMacroParamList (box-get rest)]
        (match param
          [(AstMacroParam name ty variadic)
            (tc-ctfe-env-extend-macro-params
              ctx
              (ctfe-env-extend
                env
                (intern-str name)
                (cond
                  [(tc-macro-type-param-kind? ty) (CtfeType (AstTyVar name))]
                  [(and
                      variadic
                      (tc-macro-expr-clause-type?
                        (tc-resolve-type ctx (tc-macro-signature-type ty))))
                    (CtfeExprClauseList AstExprClauseNil)]
                  [variadic (CtfeExprList AstExprNil)]
                  [(tc-macro-expr-clause-type?
                      (tc-resolve-type ctx (tc-macro-signature-type ty)))
                    (CtfeExprClause
                      (ast-expr-clause
                        (ast-node-push
                          (AstExprVar
                            (intern (string-append (intern-str name) "$first"))))
                        (ast-node-push
                          (AstExprVar
                            (intern (string-append (intern-str name) "$second"))))))]
                  [else
                    (CtfeExpr
                      (ast-node-push (AstExprVar name))
                      (tc-resolve-type ctx (tc-macro-signature-type ty)))]))
              rest)]))]))

(define (tc-dispatch-isa-eq? [a : AstDispatchIsa] [b : AstDispatchIsa]) : bool
  (match a
    [(AstDispatchScalar)
      (match b
        [(AstDispatchScalar) true]
        [_ false])]
    [(AstDispatchAvx2)
      (match b
        [(AstDispatchAvx2) true]
        [_ false])]
    [(AstDispatchAvx512)
      (match b
        [(AstDispatchAvx512) true]
        [_ false])]))

(define (tc-dispatch-variant-list-contains-isa?
  [variants : AstDispatchVariantList]
  [isa : AstDispatchIsa]) : bool
  (match variants
    [(AstDispatchVariantNil) false]
    [(AstDispatchVariantCons variant rest)
      (let
        [rest : AstDispatchVariantList (box-get rest)]
        (match variant
          [(AstDispatchVariant found-isa _)
            (if (tc-dispatch-isa-eq? found-isa isa)
              true
              (tc-dispatch-variant-list-contains-isa? rest isa))]))]))

(define (tc-dispatch-variant-list-duplicate-isa?
  [variants : AstDispatchVariantList]) : bool
  (match variants
    [(AstDispatchVariantNil) false]
    [(AstDispatchVariantCons variant rest)
      (let
        [rest : AstDispatchVariantList (box-get rest)]
        (match variant
          [(AstDispatchVariant isa _)
            (or
              (tc-dispatch-variant-list-contains-isa? rest isa)
              (tc-dispatch-variant-list-duplicate-isa? rest))]))]))

(define (tc-dispatch-variant-list-scalar-count
  [variants : AstDispatchVariantList]) : i64
  (match variants
    [(AstDispatchVariantNil) 0]
    [(AstDispatchVariantCons variant rest)
      (let
        [rest : AstDispatchVariantList (box-get rest)]
        (match variant
          [(AstDispatchVariant isa _)
            (+
              (match isa
                [(AstDispatchScalar) 1]
                [_ 0])
              (tc-dispatch-variant-list-scalar-count rest))]))]))

(define (tc-dispatch-symbol-name [module : String] [name : String]) : String
  (if (and (> (string-length module) 0) (not (tc-name-qualified? name)))
    (compiler-symbol-module-key module name)
    name))

(define (tc-dispatch-variant-non-function-message [name : String]) : String
  (string-append "typecheck: defdispatch variant is not a function " name))

(define (tc-dispatch-variant-type
  [ctx : TcContext]
  [dispatch-name : String]
  [variant-name : String]) : ResultTcType
  (let
    [module : String (tc-context-module ctx)]
    [logical-name : String (tc-dispatch-symbol-name module dispatch-name)]
    [lookup-name : String (tc-dispatch-symbol-name module variant-name)]
    (if (string-eq lookup-name logical-name)
      (ErrTcType "typecheck: defdispatch cannot use itself as a variant")
      (match (compiler-symbols-lookup-value
        (tc-context-symbols ctx)
        lookup-name)
        [(SomeI64 handle)
          (let
            [kind : i64 (compiler-symbol-handle-kind handle)]
            (if (= kind (compiler-symbol-kind-defdispatch))
              (ErrTcType
                "typecheck: defdispatch variant cannot be another dispatch")
              (if (or
                (= kind (compiler-symbol-kind-function-define))
                (= kind (compiler-symbol-kind-extern)))
                (match (compiler-program-decl-at-index
                  (tc-context-program ctx)
                  (compiler-symbol-handle-index handle))
                  [(OkAstDecl decl)
                    (match (tc-top-decl-type ctx decl)
                      [(OkTcType ty)
                        (match ty
                          [(AstTyFunc _ _) (OkTcType ty)]
                          [_
                            (ErrTcType
                              (tc-dispatch-variant-non-function-message
                                variant-name))])]
                      [(ErrTcType message) (ErrTcType message)])]
                  [(ErrAstDecl message) (ErrTcType message)])
                (ErrTcType
                  (tc-dispatch-variant-non-function-message variant-name)))))]
        [(NoneI64)
          (ErrTcType
            (string-append
              "typecheck: unknown defdispatch variant "
              variant-name))]))))

(define (tc-dispatch-variant-signatures
  [ctx : TcContext]
  [dispatch-name : String]
  [variants : AstDispatchVariantList]
  [expected : AstMaybeType]) : ResultTcType
  (match variants
    [(AstDispatchVariantNil)
      (match expected
        [(AstSomeType ty) (OkTcType ty)]
        [(AstNoType) (ErrTcType "typecheck: defdispatch has no variants")])]
    [(AstDispatchVariantCons variant rest)
      (let
        [rest : AstDispatchVariantList (box-get rest)]
        (match variant
          [(AstDispatchVariant _ variant-name)
            (match (tc-dispatch-variant-type ctx dispatch-name variant-name)
              [(OkTcType ty)
                (match expected
                  [(AstNoType)
                    (tc-dispatch-variant-signatures
                      ctx
                      dispatch-name
                      rest
                      (AstSomeType ty))]
                  [(AstSomeType want)
                    (if (tc-type-eq ty want)
                      (tc-dispatch-variant-signatures
                        ctx
                        dispatch-name
                        rest
                        expected)
                      (ErrTcType
                        "typecheck: defdispatch variant signatures must match"))])]
              [(ErrTcType message) (ErrTcType message)])]))]))

(define (tc-dispatch-decl-type
  [ctx : TcContext]
  [name : String]
  [variants : AstDispatchVariantList]) : ResultTcType
  (if (!= (tc-dispatch-variant-list-scalar-count variants) 1)
    (ErrTcType "typecheck: defdispatch requires exactly one scalar variant")
    (if (tc-dispatch-variant-list-duplicate-isa? variants)
      (ErrTcType "typecheck: duplicate defdispatch ISA variant")
      (tc-dispatch-variant-signatures ctx name variants AstNoType))))

(define (tc-top-decl-type [ctx : TcContext] [decl : AstDecl]) : ResultTcType
  (match decl
    [(AstDeclDef _ maybe-ty expr-box)
      (let
        [expr : AstExpr (ast-node-get expr-box)]
        (match maybe-ty
          [(AstSomeType ty) (OkTcType (tc-resolve-type ctx ty))]
          [(AstNoType)
            (match (ast-expr-unspan expr)
              [(AstExprLiteral lit) (OkTcType (tc-literal-type lit))]
              [(AstExprAnn _ ty) (OkTcType (tc-resolve-type ctx ty))]
              [_ (ErrTcType "typecheck: top-level value requires annotation")])]))]
    [(AstDeclDefFn _ params ret _ _)
      (OkTcType
        (ast-ty-func (tc-param-type-list ctx params) (tc-resolve-type ctx ret)))]
    [(AstDeclExtern _ _ _ ty) (OkTcType (tc-resolve-type ctx ty))]
    [(AstDeclDefDispatch name variants)
      (tc-dispatch-decl-type ctx (intern-str name) variants)]
    [(AstDeclUnsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (tc-top-decl-type ctx inner))]
    [_ (ErrTcType "typecheck: declaration has no value type")]))

;; Like `tc-top-decl-type`, but infers an un-annotated top-level `define`'s type
;; from its initializer expression when it is neither a literal nor an annotated
;; expression. The `env` carries the bindings of all preceding declarations
;; (functions, enum/struct constructors, earlier globals), so a global such as
;; `(define result (factorial 5))` or `(define pair (Pair 10 11))` resolves
;; through the ordinary expression typechecker instead of demanding an
;; annotation. This mirrors the former Rust typechecker, whose first pass over
;; the declarations runs `check_expr(value)` for an un-annotated `Decl::Def`.
(define (tc-top-decl-type-with-env
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decl : AstDecl]) : ResultTcType
  (match decl
    [(AstDeclDef _ maybe-ty expr-box)
      (let
        [expr : AstExpr (ast-node-get expr-box)]
        (match maybe-ty
          [(AstSomeType ty) (OkTcType (tc-resolve-type ctx ty))]
          [(AstNoType)
            (match (ast-expr-unspan expr)
              [(AstExprLiteral lit) (OkTcType (tc-literal-type lit))]
              [(AstExprAnn _ ty) (OkTcType (tc-resolve-type ctx ty))]
              [_ (tc-expr ctx env expr)])]))]
    [_ (tc-top-decl-type ctx decl)]))

(define (tc-field-type-list [ctx : TcContext] [fields : AstFieldDefList]) : AstTypeList
  (match fields
    [(AstFieldDefNil) AstTypeNil]
    [(AstFieldDefCons field rest)
      (let
        [rest : AstFieldDefList (box-get rest)]
        (match field
          [(AstFieldDef _ ty _)
            (ast-type-cons
              (tc-resolve-type ctx ty)
              (tc-field-type-list ctx rest))]))]))

(define (tc-tag-type-list-region [region : String] [types : AstTypeList]) : AstTypeList
  (match types
    [(AstTypeNil) AstTypeNil]
    [(AstTypeCons head tail)
      (let
        [head : AstType (ty-node-get head)]
        [tail : AstTypeList (box-get tail)]
        (ast-type-cons
          (tc-tag-region region head)
          (tc-tag-type-list-region region tail)))]))

(define (tc-enum-variant-constructor-type
  [ctx : TcContext]
  [enum-name : String]
  [lifetimes : AstLifetimeList]
  [fields : AstTypeList]) : AstType
  (let
    [ret : AstType
      (match lifetimes
        [(AstLifetimeNil) (AstTyEnum (intern enum-name))]
        [_ (ast-ty-enum-args (intern enum-name) lifetimes)])]
    (match fields
      [(AstTypeNil) ret]
      [_ (ast-ty-func (tc-resolve-type-list ctx fields) ret)])))

(define (tc-bind-enum-variants
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [variants : AstVariantDefList]) : ResultTcEnv
  (tc-bind-enum-variants-in-module ctx env "" enum-name AstLifetimeNil variants))

(define (tc-bind-enum-variants-in-module
  [ctx : TcContext]
  [env : TcTypeEnv]
  [module : String]
  [enum-name : String]
  [lifetimes : AstLifetimeList]
  [variants : AstVariantDefList]) : ResultTcEnv
  (match variants
    [(AstVariantDefNil) (OkTcEnv env)]
    [(AstVariantDefCons variant rest)
      (let
        [rest : AstVariantDefList (box-get rest)]
        (match variant
          [(AstVariantDef name fields _)
            (let
              [scoped-enum : String
                (compiler-symbol-module-key module enum-name)]
              [constructor-ty : AstType
                (tc-enum-variant-constructor-type
                  ctx
                  scoped-enum
                  lifetimes
                  fields)]
              (tc-bind-enum-variants-in-module
                ctx
                (tc-bind-alias-id-if-free
                  env
                  (tc-module-name-id module name)
                  constructor-ty)
                module
                enum-name
                lifetimes
                rest))]))]))

(define (tc-build-top-env-list
  [ctx : TcContext]
  [decls : AstDeclList]
  [env : TcTypeEnv]) : ResultTcEnv
  (tc-build-top-env-list-in-module ctx decls env ""))

(define (tc-build-top-env-bind-decl-in-module
  [ctx : TcContext]
  [env : TcTypeEnv]
  [module : String]
  [decl : AstDecl]) : ResultTcEnv
  (match decl
    [(AstDeclModule _) (OkTcEnv env)]
    [(AstDeclUnsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (match inner
          [(AstDeclDefFn name _ _ _ _)
            (match (tc-top-decl-type (tc-context-with-module ctx module) inner)
              [(OkTcType ty)
                (OkTcEnv (tc-bind-module-name-unsafe-id env module name ty))]
              [(ErrTcType message) (ErrTcEnv message)])]
          [(AstDeclExtern name kind _ _)
            (let
              [extern-ctx : TcContext (tc-context-with-module ctx module)]
              (match (tc-top-decl-type extern-ctx inner)
                [(OkTcType ty)
                  (OkTcEnv
                    (if (tc-extern-value-c-abi-fnptr? extern-ctx kind ty)
                      (tc-bind-module-name-unsafe-id-c-abi-fnptr
                        env
                        module
                        name
                        ty)
                      (tc-bind-module-name-unsafe-id env module name ty)))]
                [(ErrTcType message) (ErrTcEnv message)]))]
          [_ (OkTcEnv env)]))]
    [(AstDeclDef name _ _)
      (match (tc-top-decl-type-with-env
        (tc-context-with-module ctx module)
        env
        decl)
        [(OkTcType ty) (OkTcEnv (tc-bind-module-name-id env module name ty))]
        [(ErrTcType message) (ErrTcEnv message)])]
    [(AstDeclDefFn name _ _ _ _)
      (match (tc-top-decl-type (tc-context-with-module ctx module) decl)
        [(OkTcType ty) (OkTcEnv (tc-bind-module-name-id env module name ty))]
        [(ErrTcType message) (ErrTcEnv message)])]
    [(AstDeclDefDispatch name _)
      (match (tc-top-decl-type (tc-context-with-module ctx module) decl)
        [(OkTcType ty) (OkTcEnv (tc-bind-module-name-id env module name ty))]
        [(ErrTcType message) (ErrTcEnv message)])]
    [(AstDeclDefMacro _ _ _ _) (OkTcEnv env)]
    [(AstDeclExtern name kind _ _)
      (let
        [extern-ctx : TcContext (tc-context-with-module ctx module)]
        (match (tc-top-decl-type extern-ctx decl)
          [(OkTcType ty)
            (OkTcEnv
              (if (tc-extern-value-c-abi-fnptr? extern-ctx kind ty)
                (tc-bind-module-name-id-c-abi-fnptr env module name ty)
                (tc-bind-module-name-id env module name ty)))]
          [(ErrTcType message) (ErrTcEnv message)]))]
    [(AstDeclDefEnum name cleanup variants)
      (let
        [name-str : String (intern-str name)]
        [scoped-name : String (compiler-symbol-module-key module name-str)]
        [enum-ty : AstType (AstTyEnum (intern scoped-name))]
        (match (tc-bind-enum-variants-in-module
          (tc-context-with-module ctx module)
          env
          module
          name-str
          AstLifetimeNil
          variants)
          [(OkTcEnv with-variants)
            (OkTcEnv
              (tc-bind-enum-cleanup-module-name
                with-variants
                module
                cleanup
                enum-ty))]
          [(ErrTcEnv message) (ErrTcEnv message)]))]
    [(AstDeclDefEnumLifetimes name lifetimes cleanup variants)
      (let
        [name-str : String (intern-str name)]
        [scoped-name : String (compiler-symbol-module-key module name-str)]
        [enum-ty : AstType (ast-ty-enum-args (intern scoped-name) lifetimes)]
        (match (tc-bind-enum-variants-in-module
          (tc-context-with-module ctx module)
          env
          module
          name-str
          lifetimes
          variants)
          [(OkTcEnv with-variants)
            (OkTcEnv
              (tc-bind-enum-cleanup-module-name
                with-variants
                module
                cleanup
                enum-ty))]
          [(ErrTcEnv message) (ErrTcEnv message)]))]
    [(AstDeclDefStruct name _ cleanup fields)
      (let
        [name-str : String (intern-str name)]
        [scoped-name : String (compiler-symbol-module-key module name-str)]
        [struct-ty : AstType (AstTyStruct (intern scoped-name))]
        [constructor-ty : AstType
          (ast-ty-func
            (tc-field-type-list (tc-context-with-module ctx module) fields)
            struct-ty)]
        (OkTcEnv
          (tc-bind-struct-cleanup-module-name
            (tc-bind-module-name-id env module name constructor-ty)
            module
            cleanup
            struct-ty)))]
    [(AstDeclDefStructLifetimes name lifetimes _ cleanup fields)
      (let
        [name-str : String (intern-str name)]
        [scoped-name : String (compiler-symbol-module-key module name-str)]
        [struct-ty : AstType
          (ast-ty-struct-args (intern scoped-name) lifetimes)]
        [constructor-ty : AstType
          (ast-ty-func
            (tc-field-type-list (tc-context-with-module ctx module) fields)
            struct-ty)]
        (OkTcEnv
          (tc-bind-struct-cleanup-module-name
            (tc-bind-module-name-id env module name constructor-ty)
            module
            cleanup
            struct-ty)))]
    [(AstDeclComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (tc-build-top-env-bind-decl-in-module ctx env module template))]
    [(AstDeclImport _) (OkTcEnv env)]
    [(AstDeclIncludeStr _ _) (OkTcEnv env)]
    [(AstDeclIncludeBin _ _) (OkTcEnv env)]
    [(AstDeclExport _) (OkTcEnv env)]
    [(AstDeclTest _ _ _) (OkTcEnv env)]))

(define (tc-build-top-env-list-in-module
  [ctx : TcContext]
  [decls : AstDeclList]
  [env : TcTypeEnv]
  [module : String]) : ResultTcEnv
  (let
    [cursor : AstDeclList decls]
    [current-env : TcTypeEnv env]
    [current-module : String module]
    [message : String ""]
    [ok : bool true]
    (begin
      (while ok
        (match cursor
          [(AstDeclNil) (set! ok false)]
          [(AstDeclCons decl rest)
            (let
              [rest : AstDeclList (box-get rest)]
              (match decl
                [(AstDeclModule next-module)
                  (begin
                    (set! current-module (intern-str next-module))
                    (set! cursor rest))]
                [_
                  (match (tc-build-top-env-bind-decl-in-module
                    ctx
                    current-env
                    current-module
                    decl)
                    [(OkTcEnv next-env)
                      (begin
                        (set! current-env next-env)
                        (set! cursor rest))]
                    [(ErrTcEnv step-message)
                      (begin
                        (set! message step-message)
                        (set! ok false))])]))]))
      (if (string-eq message "")
        (OkTcEnv current-env)
        (ErrTcEnv message)))))

(define (tc-bind-enum-variant-aliases
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias : String]
  [enum-name : String]
  [lifetimes : AstLifetimeList]
  [variants : AstVariantDefList]) : TcTypeEnv
  (match variants
    [(AstVariantDefNil) env]
    [(AstVariantDefCons variant rest)
      (let
        [rest : AstVariantDefList (box-get rest)]
        (match variant
          [(AstVariantDef name fields _)
            (let
              [constructor-ty : AstType
                (tc-enum-variant-constructor-type
                  ctx
                  enum-name
                  lifetimes
                  fields)]
              (tc-bind-enum-variant-aliases
                ctx
                (tc-bind-alias-id-if-free
                  env
                  (tc-module-name-id alias name)
                  constructor-ty)
                alias
                enum-name
                lifetimes
                rest))]))]))

(define (tc-bind-import-alias-decl-in-module
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias : String]
  [module : String]
  [decl : AstDecl]) : ResultTcEnv
  (match decl
    [(AstDeclUnsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (match inner
          [(AstDeclDefFn name _ _ _ _)
            (match (tc-top-decl-type (tc-context-with-module ctx module) inner)
              [(OkTcType ty)
                (OkTcEnv
                  (tc-bind-unsafe
                    env
                    (compiler-symbol-module-key alias (intern-str name))
                    ty))]
              [(ErrTcType message) (ErrTcEnv message)])]
          [(AstDeclExtern name kind _ _)
            (let
              [extern-ctx : TcContext (tc-context-with-module ctx module)]
              (match (tc-top-decl-type extern-ctx inner)
                [(OkTcType ty)
                  (OkTcEnv
                    (if (tc-extern-value-c-abi-fnptr? extern-ctx kind ty)
                      (tc-bind-unsafe-c-abi-fnptr-id
                        env
                        (tc-name-id
                          (compiler-symbol-module-key alias (intern-str name)))
                        ty)
                      (tc-bind-unsafe
                        env
                        (compiler-symbol-module-key alias (intern-str name))
                        ty)))]
                [(ErrTcType message) (ErrTcEnv message)]))]
          [_ (OkTcEnv env)]))]
    [(AstDeclDef name _ _)
      (match (tc-top-decl-type (tc-context-with-module ctx module) decl)
        [(OkTcType ty)
          (OkTcEnv
            (tc-bind
              env
              (compiler-symbol-module-key alias (intern-str name))
              ty))]
        [(ErrTcType message) (ErrTcEnv message)])]
    [(AstDeclDefFn name _ _ _ _)
      (match (tc-top-decl-type (tc-context-with-module ctx module) decl)
        [(OkTcType ty)
          (OkTcEnv
            (tc-bind
              env
              (compiler-symbol-module-key alias (intern-str name))
              ty))]
        [(ErrTcType message) (ErrTcEnv message)])]
    [(AstDeclDefDispatch name _)
      (match (tc-top-decl-type (tc-context-with-module ctx module) decl)
        [(OkTcType ty)
          (OkTcEnv
            (tc-bind
              env
              (compiler-symbol-module-key alias (intern-str name))
              ty))]
        [(ErrTcType message) (ErrTcEnv message)])]
    [(AstDeclExtern name kind _ _)
      (let
        [extern-ctx : TcContext (tc-context-with-module ctx module)]
        (match (tc-top-decl-type extern-ctx decl)
          [(OkTcType ty)
            (OkTcEnv
              (if (tc-extern-value-c-abi-fnptr? extern-ctx kind ty)
                (tc-bind-c-abi-fnptr
                  env
                  (compiler-symbol-module-key alias (intern-str name))
                  ty)
                (tc-bind
                  env
                  (compiler-symbol-module-key alias (intern-str name))
                  ty)))]
          [(ErrTcType message) (ErrTcEnv message)]))]
    [(AstDeclDefEnum name cleanup variants)
      (let
        [name-str : String (intern-str name)]
        [scoped-name : String (compiler-symbol-module-key module name-str)]
        [enum-ty : AstType (AstTyEnum (intern scoped-name))]
        (OkTcEnv
          (tc-bind-enum-cleanup-alias
            (tc-bind-enum-variant-aliases
              (tc-context-with-module ctx module)
              env
              alias
              scoped-name
              AstLifetimeNil
              variants)
            alias
            cleanup
            enum-ty)))]
    [(AstDeclDefEnumLifetimes name lifetimes cleanup variants)
      (let
        [name-str : String (intern-str name)]
        [scoped-name : String (compiler-symbol-module-key module name-str)]
        [enum-ty : AstType (ast-ty-enum-args (intern scoped-name) lifetimes)]
        (OkTcEnv
          (tc-bind-enum-cleanup-alias
            (tc-bind-enum-variant-aliases
              (tc-context-with-module ctx module)
              env
              alias
              scoped-name
              lifetimes
              variants)
            alias
            cleanup
            enum-ty)))]
    [(AstDeclDefStruct name _ cleanup fields)
      (let
        [name-str : String (intern-str name)]
        [struct-ty : AstType
          (AstTyStruct (intern (compiler-symbol-module-key module name-str)))]
        [constructor-ty : AstType
          (ast-ty-func
            (tc-field-type-list (tc-context-with-module ctx module) fields)
            struct-ty)]
        (OkTcEnv
          (tc-bind-struct-cleanup-alias
            (tc-bind
              env
              (compiler-symbol-module-key alias name-str)
              constructor-ty)
            alias
            cleanup
            struct-ty)))]
    [(AstDeclDefStructLifetimes name lifetimes _ cleanup fields)
      (let
        [name-str : String (intern-str name)]
        [struct-ty : AstType
          (ast-ty-struct-args
            (intern (compiler-symbol-module-key module name-str))
            lifetimes)]
        [constructor-ty : AstType
          (ast-ty-func
            (tc-field-type-list (tc-context-with-module ctx module) fields)
            struct-ty)]
        (OkTcEnv
          (tc-bind-struct-cleanup-alias
            (tc-bind
              env
              (compiler-symbol-module-key alias name-str)
              constructor-ty)
            alias
            cleanup
            struct-ty)))]
    [(AstDeclComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (tc-bind-import-alias-decl-in-module ctx env alias module template))]
    [_ (OkTcEnv env)]))

(define (tc-bind-import-alias-module-list
  [ctx : TcContext]
  [decls : AstDeclList]
  [env : TcTypeEnv]
  [target-module : String]
  [alias : String]
  [module : String]) : ResultTcEnv
  (match decls
    [(AstDeclNil) (OkTcEnv env)]
    [(AstDeclCons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDeclModule next-module)
            (tc-bind-import-alias-module-list
              ctx
              rest
              env
              target-module
              alias
              (intern-str next-module))]
          [(AstDeclImport _)
            (tc-bind-import-alias-module-list
              ctx
              rest
              env
              target-module
              alias
              module)]
          [(AstDeclIncludeStr _ _)
            (tc-bind-import-alias-module-list
              ctx
              rest
              env
              target-module
              alias
              module)]
          [(AstDeclIncludeBin _ _)
            (tc-bind-import-alias-module-list
              ctx
              rest
              env
              target-module
              alias
              module)]
          [(AstDeclExport _)
            (tc-bind-import-alias-module-list
              ctx
              rest
              env
              target-module
              alias
              module)]
          [(AstDeclTest _ _ _)
            (tc-bind-import-alias-module-list
              ctx
              rest
              env
              target-module
              alias
              module)]
          [_
            (if (string-eq module target-module)
              (match (tc-bind-import-alias-decl-in-module
                ctx
                env
                alias
                module
                decl)
                [(OkTcEnv next-env)
                  (tc-bind-import-alias-module-list
                    ctx
                    rest
                    next-env
                    target-module
                    alias
                    module)]
                [(ErrTcEnv message) (ErrTcEnv message)])
              (tc-bind-import-alias-module-list
                ctx
                rest
                env
                target-module
                alias
                module))]))]))

(define (tc-bind-import-alias-module
  [ctx : TcContext]
  [decls : AstDeclList]
  [env : TcTypeEnv]
  [target-module : String]
  [alias : String]) : ResultTcEnv
  (tc-bind-import-alias-module-list ctx decls env target-module alias ""))

(define (tc-build-top-env-aliases-list
  [ctx : TcContext]
  [all-decls : AstDeclList]
  [decls : AstDeclList]
  [env : TcTypeEnv]) : ResultTcEnv
  (match decls
    [(AstDeclNil) (OkTcEnv env)]
    [(AstDeclCons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDeclImport
              (AstImportSpec
                _
                _
                (AstSomeModuleName target-module)
                (AstSomeImportAlias alias)
                _))
            (match (tc-bind-import-alias-module
              ctx
              all-decls
              env
              target-module
              alias)
              [(OkTcEnv next-env)
                (tc-build-top-env-aliases-list ctx all-decls rest next-env)]
              [(ErrTcEnv message) (ErrTcEnv message)])]
          [_ (tc-build-top-env-aliases-list ctx all-decls rest env)]))]))

(define (tc-build-top-env [ctx : TcContext] [program : AstProgram]) : ResultTcEnv
  (begin
    (tc-nominal-owner-cache-reset!)
    (match program
      [(AstProgram decls-box)
        (let
          [decls : AstDeclList (box-get decls-box)]
          (match (tc-build-top-env-list ctx decls (tc-default-env))
            [(OkTcEnv env)
              (match (tc-build-top-env-aliases-list ctx decls decls env)
                [(OkTcEnv aliases) (OkTcEnv (tc-env-with-cache aliases))]
                [(ErrTcEnv message) (ErrTcEnv message)])]
            [(ErrTcEnv message) (ErrTcEnv message)]))])))

(define (tc-bind-enum-variants-local
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [scoped-enum : String]
  [lifetimes : AstLifetimeList]
  [variants : AstVariantDefList]) : TcTypeEnv
  (match variants
    [(AstVariantDefNil) env]
    [(AstVariantDefCons variant rest)
      (let
        [rest : AstVariantDefList (box-get rest)]
        (match variant
          [(AstVariantDef name fields _)
            (let
              [constructor-ty : AstType
                (tc-enum-variant-constructor-type
                  ctx
                  scoped-enum
                  lifetimes
                  fields)]
              (tc-bind-enum-variants-local
                ctx
                (tc-bind-id env name constructor-ty)
                enum-name
                scoped-enum
                lifetimes
                rest))]))]))

(define (tc-module-local-env-add-decl
  [ctx : TcContext]
  [env : TcTypeEnv]
  [module : String]
  [decl : AstDecl]) : ResultTcEnv
  (match decl
    [(AstDeclUnsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (match inner
          [(AstDeclDefFn name _ _ _ _)
            (match (tc-top-decl-type ctx inner)
              [(OkTcType ty) (OkTcEnv (tc-bind-unsafe-id env name ty))]
              [(ErrTcType message) (ErrTcEnv message)])]
          [(AstDeclExtern name kind _ _)
            (match (tc-top-decl-type ctx inner)
              [(OkTcType ty)
                (OkTcEnv
                  (if (tc-extern-value-c-abi-fnptr? ctx kind ty)
                    (tc-bind-unsafe-c-abi-fnptr-id env name ty)
                    (tc-bind-unsafe-id env name ty)))]
              [(ErrTcType message) (ErrTcEnv message)])]
          [_ (OkTcEnv env)]))]
    [(AstDeclDef name _ _)
      (match (tc-top-decl-type-with-env ctx env decl)
        [(OkTcType ty) (OkTcEnv (tc-bind-id env name ty))]
        [(ErrTcType message) (ErrTcEnv message)])]
    [(AstDeclDefFn name _ _ _ _)
      (match (tc-top-decl-type ctx decl)
        [(OkTcType ty) (OkTcEnv (tc-bind-id env name ty))]
        [(ErrTcType message) (ErrTcEnv message)])]
    [(AstDeclDefDispatch name _)
      (match (tc-top-decl-type ctx decl)
        [(OkTcType ty) (OkTcEnv (tc-bind-id env name ty))]
        [(ErrTcType message) (ErrTcEnv message)])]
    [(AstDeclExtern name kind _ _)
      (match (tc-top-decl-type ctx decl)
        [(OkTcType ty)
          (OkTcEnv
            (if (tc-extern-value-c-abi-fnptr? ctx kind ty)
              (tc-bind-c-abi-fnptr-id env name ty)
              (tc-bind-id env name ty)))]
        [(ErrTcType message) (ErrTcEnv message)])]
    [(AstDeclDefEnum name cleanup variants)
      (let
        [name-str : String (intern-str name)]
        [enum-ty : AstType
          (AstTyEnum (intern (compiler-symbol-module-key module name-str)))]
        (OkTcEnv
          (tc-bind-enum-cleanup-local
            (tc-bind-enum-variants-local
              ctx
              env
              name-str
              (compiler-symbol-module-key module name-str)
              AstLifetimeNil
              variants)
            cleanup
            enum-ty)))]
    [(AstDeclDefEnumLifetimes name lifetimes cleanup variants)
      (let
        [name-str : String (intern-str name)]
        [enum-ty : AstType
          (ast-ty-enum-args
            (intern (compiler-symbol-module-key module name-str))
            lifetimes)]
        (OkTcEnv
          (tc-bind-enum-cleanup-local
            (tc-bind-enum-variants-local
              ctx
              env
              name-str
              (compiler-symbol-module-key module name-str)
              lifetimes
              variants)
            cleanup
            enum-ty)))]
    [(AstDeclDefStruct name _ cleanup fields)
      (let
        [name-str : String (intern-str name)]
        [struct-ty : AstType
          (AstTyStruct (intern (compiler-symbol-module-key module name-str)))]
        [constructor-ty : AstType
          (ast-ty-func (tc-field-type-list ctx fields) struct-ty)]
        (OkTcEnv
          (tc-bind-struct-cleanup-local
            (tc-bind-id env name constructor-ty)
            cleanup
            struct-ty)))]
    [(AstDeclDefStructLifetimes name lifetimes _ cleanup fields)
      (let
        [name-str : String (intern-str name)]
        [struct-ty : AstType
          (ast-ty-struct-args
            (intern (compiler-symbol-module-key module name-str))
            lifetimes)]
        [constructor-ty : AstType
          (ast-ty-func (tc-field-type-list ctx fields) struct-ty)]
        (OkTcEnv
          (tc-bind-struct-cleanup-local
            (tc-bind-id env name constructor-ty)
            cleanup
            struct-ty)))]
    [(AstDeclComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (tc-module-local-env-add-decl ctx env module template))]
    [_ (OkTcEnv env)]))

(define (tc-module-local-env-list
  [ctx : TcContext]
  [decls : AstDeclList]
  [env : TcTypeEnv]
  [target-module : String]
  [module : String]) : ResultTcEnv
  (match decls
    [(AstDeclNil) (OkTcEnv env)]
    [(AstDeclCons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDeclModule next-module)
            (tc-module-local-env-list
              ctx
              rest
              env
              target-module
              (intern-str next-module))]
          [_
            (if (string-eq module target-module)
              (match (tc-module-local-env-add-decl ctx env target-module decl)
                [(OkTcEnv next-env)
                  (tc-module-local-env-list
                    ctx
                    rest
                    next-env
                    target-module
                    module)]
                [(ErrTcEnv message) (ErrTcEnv message)])
              (tc-module-local-env-list ctx rest env target-module module))]))]))

(define (tc-module-local-env
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [module : String]) : ResultTcEnv
  (if (string-eq module "")
    (OkTcEnv top-env)
    (match (tc-context-program ctx)
      [(AstProgram decls-box)
        (let
          [decls : AstDeclList (box-get decls-box)]
          (tc-module-local-env-list
            (tc-context-with-module ctx module)
            decls
            top-env
            module
            ""))])))

(define (tc-module-local-env-cache-lookup
  [cache : TcModuleLocalEnvCache]
  [module : String]) : TcMaybeTypeEnv
  (match cache
    [(TcModuleLocalEnvNil) (TcNoTypeEnv)]
    [(TcModuleLocalEnvCons cached-module env rest)
      (if (string-eq cached-module module)
        (TcSomeTypeEnv env)
        (tc-module-local-env-cache-lookup (box-get rest) module))]))

(define (tc-module-local-env-cached
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [module : String]
  [cache : TcModuleLocalEnvCache]) : ResultTcModuleLocalEnv
  (if (string-eq module "")
    (OkTcModuleLocalEnv top-env cache)
    (match (tc-module-local-env-cache-lookup cache module)
      [(TcSomeTypeEnv env) (OkTcModuleLocalEnv env cache)]
      [(TcNoTypeEnv)
        (match (tc-module-local-env ctx top-env module)
          [(OkTcEnv env)
            (let
              ;; The cache outlives transient scratch arenas (per-function
              ;; typecheck arenas; #2596), but `module` may have been
              ;; allocated in one: hygiene markers decode it by substring.
              ;; Copy the key into the current arena -- the hygiene caller
              ;; switches to the dedicated cache arena before inserting
              ;; (#2357) -- so the stored key cannot dangle.
              [key : String (substring module 0 (string-length module))]
              (OkTcModuleLocalEnv
                env
                (TcModuleLocalEnvCons key env (box cache))))]
          [(ErrTcEnv message) (ErrTcModuleLocalEnv message)])])))

(define (tc-expect [actual : AstType] [expected : AstType] [message : String]) : ResultTcUnit
  (if (tc-type-compatible? expected actual)
    OkTcUnit
    (ErrTcUnit message)))

(define (tc-contextual-result-type [expected : AstType] [actual : AstType]) : AstType
  (if (tc-type-contains-any-region actual)
    actual
    expected))

(define (tc-float-literal-non-finite-message [ty-name : String]) : String
  (str-cat "typecheck: non-finite " ty-name " literal is not supported"))

(define (tc-float-literal-f64-type [text : String]) : ResultTcType
  (match (compiler-float-parse-f64 text)
    [(CompilerFloatSomeF64 value)
      (if (compiler-float-f64-finite? value)
        (OkTcType (AstTyF64))
        (ErrTcType (tc-float-literal-non-finite-message "f64")))]
    [(CompilerFloatNoF64)
      (if (compiler-float-decimal-syntax? text)
        (ErrTcType (tc-float-literal-non-finite-message "f64"))
        (ErrTcType "typecheck: invalid f64 literal"))]))

(define (tc-float-literal-f32-type [text : String] [expected : AstType]) : ResultTcType
  (match (compiler-float-parse-f64 text)
    [(CompilerFloatSomeF64 value)
      (let
        [rounded : f64 (compiler-float-round-f32-as-f64 value)]
        (if (and
          (compiler-float-f64-finite? value)
          (compiler-float-f64-finite? rounded))
          (OkTcType expected)
          (ErrTcType (tc-float-literal-non-finite-message "f32"))))]
    [(CompilerFloatNoF64)
      (if (compiler-float-decimal-syntax? text)
        (ErrTcType (tc-float-literal-non-finite-message "f32"))
        (ErrTcType "typecheck: invalid f64 literal"))]))

(define (tc-float-literal-type-with-expected
  [text : String]
  [expected : AstType]) : ResultTcType
  (if (tc-type-eq (tc-type-strip-region expected) (AstTyF32))
    (tc-float-literal-f32-type text expected)
    (match (tc-float-literal-f64-type text)
      [(OkTcType actual)
        (if (tc-type-compatible? expected actual)
          (OkTcType (tc-contextual-result-type expected actual))
          (OkTcType actual))]
      [(ErrTcType message) (ErrTcType message)])))

(define (tc-literal-type-checked [lit : AstLiteral]) : ResultTcType
  (match lit
    [(AstLitFloat text) (tc-float-literal-f64-type text)]
    [_ (OkTcType (tc-literal-type lit))]))

(define (tc-float-literal-expr? [expr : AstExpr]) : bool
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-float-literal-expr? inner))]
    [(AstExprLiteral lit)
      (match lit
        [(AstLitFloat _) true]
        [_ false])]
    [_ false]))

(define (tc-float-literal-expr-with-expected
  [expr : AstExpr]
  [expected : AstType]) : ResultTcType
  (match expr
    [(AstExprSpanned inner-box span)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-float-literal-expr-with-expected inner expected)
          [(OkTcType ty) (OkTcType ty)]
          [(ErrTcType message) (tc-locate-spanned-error inner span message)]))]
    [(AstExprLiteral lit)
      (match lit
        [(AstLitFloat text) (tc-float-literal-type-with-expected text expected)]
        [_ (OkTcType (tc-literal-type lit))])]
    [_ (OkTcType (AstTyF64))]))

(define (tc-integer-literal-expr? [expr : AstExpr]) : bool
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-integer-literal-expr? inner))]
    [(AstExprLiteral lit)
      (match lit
        [(AstLitInt _ _) true]
        [_ false])]
    [_ false]))

(define (tc-integer-literal-expr-with-expected
  [ctx : TcContext]
  [expr : AstExpr]
  [expected : AstType]) : ResultTcType
  (match expr
    [(AstExprSpanned inner-box span)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-integer-literal-expr-with-expected ctx inner expected)
          [(OkTcType ty) (OkTcType ty)]
          [(ErrTcType message) (tc-locate-spanned-error inner span message)]))]
    [(AstExprLiteral lit)
      (match lit
        [(AstLitInt value text)
          (tc-integer-literal-type-with-expected ctx value text expected)]
        [_ (OkTcType (tc-literal-type lit))])]
    [_ (OkTcType (AstTyI32))]))

(define (tc-binop-types-from-left
  [ctx : TcContext]
  [env : TcTypeEnv]
  [op : AstBinOp]
  [left-ty : AstType]
  [right : AstExpr]) : ResultTcBinOpTypes
  (match (tc-expr-with-expected-or-actual ctx env right left-ty)
    [(OkTcType right-ty)
      (match (tc-binop-type op left-ty right-ty)
        [(OkTcType result-ty)
          (OkTcBinOpTypes (TcBinOpTypes left-ty right-ty result-ty))]
        [(ErrTcType message) (ErrTcBinOpTypes message)])]
    [(ErrTcType message) (ErrTcBinOpTypes message)]))

(define (tc-binop-types-from-right
  [ctx : TcContext]
  [op : AstBinOp]
  [left : AstExpr]
  [right-ty : AstType]) : ResultTcBinOpTypes
  (match (tc-integer-literal-expr-with-expected ctx left right-ty)
    [(OkTcType left-ty)
      (match (tc-binop-type op left-ty right-ty)
        [(OkTcType result-ty)
          (OkTcBinOpTypes (TcBinOpTypes left-ty right-ty result-ty))]
        [(ErrTcType message) (ErrTcBinOpTypes message)])]
    [(ErrTcType message) (ErrTcBinOpTypes message)]))

(define (tc-binop-types-with-same-operands
  [op : AstBinOp]
  [operand-ty : AstType]) : ResultTcBinOpTypes
  (match (tc-binop-type op operand-ty operand-ty)
    [(OkTcType result-ty)
      (OkTcBinOpTypes (TcBinOpTypes operand-ty operand-ty result-ty))]
    [(ErrTcType message) (ErrTcBinOpTypes message)]))

(define (tc-binop-expr-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [op : AstBinOp]
  [left : AstExpr]
  [right : AstExpr]) : ResultTcBinOpTypes
  (match (tc-expr ctx env left)
    [(OkTcType left-ty)
      (if (tc-float-literal-expr? left)
        (match (tc-expr ctx env right)
          [(OkTcType right-actual)
            (if (tc-type-eq (tc-type-strip-region right-actual) (AstTyF32))
              (match (tc-float-literal-expr-with-expected left (AstTyF32))
                [(OkTcType _) (tc-binop-types-with-same-operands op (AstTyF32))]
                [(ErrTcType message) (ErrTcBinOpTypes message)])
              (tc-binop-types-from-left ctx env op left-ty right))]
          [(ErrTcType message) (ErrTcBinOpTypes message)])
        (if (tc-integer-literal-expr? left)
          (match (tc-expr ctx env right)
            [(OkTcType right-actual)
              (if (tc-integer-type? right-actual)
                (tc-binop-types-from-right ctx op left right-actual)
                (tc-binop-types-from-left ctx env op left-ty right))]
            [(ErrTcType message) (ErrTcBinOpTypes message)])
          (tc-binop-types-from-left ctx env op left-ty right)))]
    [(ErrTcType message) (ErrTcBinOpTypes message)]))

(define (tc-binop-contextual-operand-type [op : AstBinOp] [expected : AstType]) : AstMaybeType
  (match op
    [(AstBinAdd)
      (if (or (tc-integer-type? expected) (tc-float-type? expected))
        (AstSomeType expected)
        (AstNoType))]
    [(AstBinSub)
      (if (or (tc-integer-type? expected) (tc-float-type? expected))
        (AstSomeType expected)
        (AstNoType))]
    [(AstBinMul)
      (if (or (tc-integer-type? expected) (tc-float-type? expected))
        (AstSomeType expected)
        (AstNoType))]
    [(AstBinDiv)
      (if (or (tc-integer-type? expected) (tc-float-type? expected))
        (AstSomeType expected)
        (AstNoType))]
    [(AstBinMod)
      (if (tc-integer-type? expected)
        (AstSomeType expected)
        (AstNoType))]
    [(AstBinBitAnd)
      (if (tc-integer-type? expected)
        (AstSomeType expected)
        (AstNoType))]
    [(AstBinBitOr)
      (if (tc-integer-type? expected)
        (AstSomeType expected)
        (AstNoType))]
    [(AstBinBitXor)
      (if (tc-integer-type? expected)
        (AstSomeType expected)
        (AstNoType))]
    [(AstBinShl)
      (if (tc-integer-type? expected)
        (AstSomeType expected)
        (AstNoType))]
    [(AstBinShr)
      (if (tc-integer-type? expected)
        (AstSomeType expected)
        (AstNoType))]
    [(AstBinAnd)
      (if (tc-type-eq expected (AstTyBool))
        (AstSomeType expected)
        (AstNoType))]
    [(AstBinOr)
      (if (tc-type-eq expected (AstTyBool))
        (AstSomeType expected)
        (AstNoType))]
    [_ (AstNoType)]))

(define (tc-binary-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [op : AstBinOp]
  [left : AstExpr]
  [right : AstExpr]
  [expected : AstType]) : ResultTcType
  (let
    [operand-expected : AstType
      (tc-type-without-regions (tc-resolve-type ctx expected))]
    (match (tc-binop-contextual-operand-type op operand-expected)
      [(AstNoType) (tc-expr ctx env expr)]
      [(AstSomeType operand-ty)
        (match (tc-expr-with-expected-or-actual ctx env left operand-ty)
          [(OkTcType left-ty)
            (match (tc-expr-with-expected-or-actual ctx env right operand-ty)
              [(OkTcType right-ty)
                (match (tc-binop-type op left-ty right-ty)
                  [(OkTcType result-ty)
                    (if (tc-type-compatible? expected result-ty)
                      (OkTcType (tc-contextual-result-type expected result-ty))
                      (OkTcType result-ty))]
                  [(ErrTcType _) (tc-expr ctx env expr)])]
              [(ErrTcType message) (ErrTcType message)])]
          [(ErrTcType message) (ErrTcType message)])])))

(define (tc-unop-contextual-operand-type [op : AstUnOp] [expected : AstType]) : AstMaybeType
  (match op
    [(AstUnNeg)
      (if (or (tc-integer-type? expected) (tc-float-type? expected))
        (AstSomeType expected)
        (AstNoType))]
    [(AstUnBitNot)
      (if (tc-integer-type? expected)
        (AstSomeType expected)
        (AstNoType))]
    [(AstUnNot)
      (if (tc-type-eq expected (AstTyBool))
        (AstSomeType expected)
        (AstNoType))]))

(define (tc-unary-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [op : AstUnOp]
  [inner : AstExpr]
  [expected : AstType]) : ResultTcType
  (let
    [operand-expected : AstType
      (tc-type-without-regions (tc-resolve-type ctx expected))]
    (match (tc-unop-contextual-operand-type op operand-expected)
      [(AstNoType) (tc-expr ctx env expr)]
      [(AstSomeType operand-ty)
        (match (tc-expr-with-expected-or-actual ctx env inner operand-ty)
          [(OkTcType inner-ty)
            (match (tc-unop-type op inner-ty)
              [(OkTcType result-ty)
                (if (tc-type-compatible? expected result-ty)
                  (OkTcType (tc-contextual-result-type expected result-ty))
                  (OkTcType result-ty))]
              [(ErrTcType _) (tc-expr ctx env expr)])]
          [(ErrTcType message) (ErrTcType message)])])))

(define (tc-expr-list-with-expected-elements
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [elem-ty : AstType]) : ResultTcUnit
  (match exprs
    [(AstExprNil) OkTcUnit]
    [(AstExprCons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (match (tc-expr-with-expected-or-actual ctx env expr elem-ty)
          [(OkTcType got)
            (match (tc-expect
              got
              elem-ty
              "typecheck: array elements must have same type")
              [(OkTcUnit)
                (tc-expr-list-with-expected-elements ctx env rest elem-ty)]
              [(ErrTcUnit message) (ErrTcUnit message)])]
          [(ErrTcType message) (ErrTcUnit message)]))]))

(define (tc-expr-array-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [elem-ty : AstType]
  [expected-len : i64]) : ResultTcType
  (if (= (tc-expr-list-len exprs) expected-len)
    (match (tc-ensure-cleanup-resource-not-stored-list env exprs)
      [(OkTcUnit)
        (match (tc-expr-list-with-expected-elements ctx env exprs elem-ty)
          [(OkTcUnit) (OkTcType (ast-ty-array elem-ty expected-len))]
          [(ErrTcUnit message) (ErrTcType message)])]
      [(ErrTcUnit message) (ErrTcType message)])
    (tc-expr ctx env (AstExprArray exprs))))

(define (tc-expr-if-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [cond : AstExpr]
  [then-branch : AstExpr]
  [else-branch : AstExpr]
  [expected : AstType]) : ResultTcType
  (match (tc-expr ctx env cond)
    [(OkTcType cond-ty)
      (match (tc-expect
        cond-ty
        (AstTyBool)
        "typecheck: if condition must be bool")
        [(OkTcUnit)
          (match (tc-expr-with-expected-or-actual ctx env then-branch expected)
            [(OkTcType then-ty)
              (match (tc-expr-with-expected-or-actual
                ctx
                env
                else-branch
                expected)
                [(OkTcType else-ty)
                  (if (and
                    (tc-type-compatible? expected then-ty)
                    (tc-type-compatible? expected else-ty))
                    (OkTcType expected)
                    (tc-merge-branch-type then-ty else-ty))]
                [(ErrTcType message) (ErrTcType message)])]
            [(ErrTcType message) (ErrTcType message)])]
        [(ErrTcUnit message) (ErrTcType message)])]
    [(ErrTcType message) (ErrTcType message)]))

(define (tc-type-list-len [types : AstTypeList]) : i64
  (match types
    [(AstTypeNil) 0]
    [(AstTypeCons _ rest)
      (let
        [rest : AstTypeList (box-get rest)]
        (+ 1 (tc-type-list-len rest)))]))

;; Flow each tuple element into its expected element type so contextual
;; literals (e.g. f32 floats) resolve against the tuple's declared element
;; type instead of their default. Returns the resolved element types.
(define (tc-check-tuple-elements-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [types : AstTypeList]) : ResultTcTypeList
  (match exprs
    [(AstExprNil)
      (match types
        [(AstTypeNil) (OkTcTypeList AstTypeNil)]
        [_ (ErrTcTypeList "typecheck: tuple element type mismatch")])]
    [(AstExprCons expr rest-exprs)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest-exprs : AstExprList (box-get rest-exprs)]
        (match types
          [(AstTypeCons want rest-types)
            (let
              [want : AstType (ty-node-get want)]
              [rest-types : AstTypeList (box-get rest-types)]
              (match (tc-expr-with-expected-or-actual ctx env expr want)
                [(OkTcType got)
                  (match (tc-expect
                    got
                    want
                    "typecheck: tuple element type mismatch")
                    [(OkTcUnit)
                      (match (tc-check-tuple-elements-with-expected
                        ctx
                        env
                        rest-exprs
                        rest-types)
                        [(OkTcTypeList rest-result)
                          (OkTcTypeList
                            (ast-type-cons
                              (tc-contextual-result-type want got)
                              rest-result))]
                        [(ErrTcTypeList message) (ErrTcTypeList message)])]
                    [(ErrTcUnit message) (ErrTcTypeList message)])]
                [(ErrTcType message) (ErrTcTypeList message)]))]
          [(AstTypeNil)
            (ErrTcTypeList "typecheck: tuple element type mismatch")]))]))

(define (tc-expr-tuple-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [expected-elems : AstTypeList]) : ResultTcType
  (if (= (tc-expr-list-len exprs) (tc-type-list-len expected-elems))
    (match (tc-ensure-cleanup-resource-not-stored-list env exprs)
      [(OkTcUnit)
        (match (tc-check-tuple-elements-with-expected
          ctx
          env
          exprs
          expected-elems)
          [(OkTcTypeList result-elems) (OkTcType (ast-ty-tuple result-elems))]
          [(ErrTcTypeList message) (ErrTcType message)])]
      [(ErrTcUnit message) (ErrTcType message)])
    (tc-expr ctx env (AstExprTuple exprs))))

;; Flow the expected type into a begin's final expression so a contextual
;; literal in tail position resolves against it; non-final expressions keep
;; the non-contextual policy (any type is allowed).
(define (tc-begin-list-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [expected : AstType]) : ResultTcType
  (match exprs
    [(AstExprNil) (OkTcType (AstTyUnit))]
    [(AstExprCons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (match rest
          [(AstExprNil) (tc-expr-with-expected-or-actual ctx env expr expected)]
          [_
            (match (tc-expr ctx env expr)
              [(OkTcType _) (tc-begin-list-with-expected ctx env rest expected)]
              [(ErrTcType message) (ErrTcType message)])]))]))

(define (tc-ctfe-value-type [ctx : TcContext] [value : CompilerCtfeValue]) : ResultTcType
  (match value
    [(CtfeI64 _) (OkTcType (AstTyI64))]
    [(CtfeF64 _) (OkTcType (AstTyF64))]
    [(CtfeF32 _) (OkTcType (AstTyF32))]
    [(CtfeBool _) (OkTcType (AstTyBool))]
    [(CtfeChar _) (OkTcType (AstTyChar))]
    [(CtfeString _) (ErrTcType "String value is compile-time only")]
    [(CtfeUnit) (OkTcType (AstTyUnit))]
    [(CtfeExpr _ _) (OkTcType (AstTyExpr))]
    [(CtfeType ty)
      (ErrTcType
        (string-append
          "type value "
          (string-append
            (tc-type-render (tc-resolve-type ctx ty))
            " is compile-time only")))]
    [(CtfeExprList _) (OkTcType (AstTyExprList))]
    [(CtfeExprClause _) (OkTcType (tc-macro-expr-clause-type))]
    [(CtfeExprClauseList _) (OkTcType (tc-macro-expr-clause-list-type))]))

(define (tc-ctfe-float-value? [value : CompilerCtfeValue]) : bool
  (match value
    [(CtfeF64 _) true]
    [(CtfeF32 _) true]
    [_ false]))

(define (tc-ctfe-value-type-with-expected
  [ctx : TcContext]
  [value : CompilerCtfeValue]
  [expected : AstType]) : ResultTcType
  (match (tc-ctfe-value-type ctx value)
    [(OkTcType actual)
      (if (and
        (tc-ctfe-float-value? value)
        (tc-type-eq (tc-type-strip-region expected) (AstTyF32)))
        (OkTcType expected)
        (if (tc-type-compatible? expected actual)
          (OkTcType (tc-contextual-result-type expected actual))
          (OkTcType actual)))]
    [(ErrTcType message) (ErrTcType message)]))

(define (tc-expr-with-expected-or-actual-core
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [expected : AstType]
  [allow-mut-by-value-borrow : bool]) : ResultTcType
  (match expr
    [(AstExprSpanned inner-box span)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [result : ResultTcType
          (match inner
            [(AstExprUnsafe exprs)
              (tc-unsafe-begin-list-with-expected
                ctx
                env
                exprs
                expected
                (TcSomeAstSourceSpan span))]
            [_
              (tc-expr-with-expected-or-actual-core
                ctx
                env
                inner
                expected
                allow-mut-by-value-borrow)])]
        (match result
          [(OkTcType ty) (OkTcType ty)]
          [(ErrTcType message) (tc-locate-spanned-error inner span message)]))]
    [(AstExprBinary op left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (tc-binary-expr-with-expected-or-actual
          ctx
          env
          expr
          op
          left
          right
          expected))]
    [(AstExprUnary op inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-unary-expr-with-expected-or-actual ctx env expr op inner expected))]
    [(AstExprIf cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (tc-expr-if-with-expected-or-actual
          ctx
          env
          cond
          then-branch
          else-branch
          expected))]
    [(AstExprMatch match-box)
      (match (box-get match-box)
        [(AstMatch scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            (match (tc-expr ctx env scrutinee)
              [(OkTcType scrut-ty)
                (tc-match-expr-with-expected ctx env scrut-ty arms expected)]
              [(ErrTcType message) (ErrTcType message)]))])]
    [(AstExprArray exprs)
      (match (tc-type-strip-region expected)
        [(AstTyArray elem-ty len)
          (tc-expr-array-with-expected-or-actual
            ctx
            env
            exprs
            (ty-node-get elem-ty)
            len)]
        [_ (tc-expr ctx env expr)])]
    [(AstExprTuple exprs)
      (match (tc-type-strip-region expected)
        [(AstTyTuple expected-elems)
          (tc-expr-tuple-with-expected-or-actual
            ctx
            env
            exprs
            (box-get expected-elems))]
        [_ (tc-expr ctx env expr)])]
    [(AstExprBegin exprs) (tc-begin-list-with-expected ctx env exprs expected)]
    [(AstExprUnsafe exprs)
      (tc-unsafe-begin-list-with-expected
        ctx
        env
        exprs
        expected
        TcNoAstSourceSpan)]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-let-bindings-for-body ctx env bindings body)
              [(OkTcEnv next-env)
                (match (tc-expr-with-expected-or-actual
                  ctx
                  next-env
                  body
                  expected)
                  [(OkTcType body-ty)
                    (match (tc-ensure-reference-type-does-not-escape-names
                      body-ty
                      (tc-let-binding-list-add-bound-names bindings TcStringNil))
                      [(OkTcUnit) (OkTcType body-ty)]
                      [(ErrTcUnit message) (ErrTcType message)])]
                  [(ErrTcType message) (ErrTcType message)])]
              [(ErrTcEnv message) (ErrTcType message)]))])]
    [(AstExprWithRegion region body)
      (tc-with-region-expr-with-expected ctx env region body expected)]
    [(AstExprWithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (tc-with-escape-expr-with-expected ctx env scratch body expected))]
    [(AstExprWithScratch body)
      (tc-with-scratch-expr-with-expected ctx env body expected)]
    [(AstExprInArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (tc-in-arena-expr-with-expected ctx env arena body expected))]
    [(AstExprWithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource bindings body)
          (tc-with-resource-expr-with-expected ctx env bindings body expected)])]
    [(AstExprBorrow mutable lifetime place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (if (and mutable allow-mut-by-value-borrow)
          (tc-borrow-expr-with-policy ctx env mutable lifetime place true)
          (tc-expr ctx env expr)))]
    [(AstExprBox inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-box-expr-with-expected-or-actual ctx env inner expected))]
    [(AstExprBoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-box-get-expr-with-expected-or-actual ctx env inner expected))]
    [(AstExprBoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-box-take-expr-with-expected-or-actual ctx env inner expected))]
    [(AstExprComptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (compiler-ctfe-eval inner (tc-ctfe-env ctx) (ctfe-fuel-limit))
          [(OkCtfe value _)
            (tc-ctfe-value-type-with-expected ctx value expected)]
          [(ErrCtfe diag) (ErrTcType (compiler-diagnostic-message diag))]))]
    [(AstExprInit maybe-ty)
      (match maybe-ty
        [(AstNoType) (tc-init-expr ctx env expected)]
        [(AstSomeType ty)
          (match (tc-init-expr ctx env ty)
            [(OkTcType actual)
              (if (tc-type-compatible? expected actual)
                (OkTcType (tc-contextual-result-type expected actual))
                (OkTcType actual))]
            [(ErrTcType message) (ErrTcType message)])])]
    [(AstExprBox inner-box)
      (match (tc-type-strip-region (tc-resolve-type ctx expected))
        [(AstTyBox inner-ty)
          (let
            [inner : AstExpr (ast-node-get inner-box)]
            [want : AstType (ty-node-get inner-ty)]
            (match (tc-ensure-cleanup-resource-not-stored-expr env inner)
              [(OkTcUnit)
                (match (tc-expr-with-expected-or-actual ctx env inner want)
                  [(OkTcType got)
                    (match (tc-expect
                      got
                      want
                      "typecheck: box inner type mismatch")
                      [(OkTcUnit)
                        (OkTcType
                          (tc-tag-active-region
                            env
                            (ast-ty-box (tc-contextual-result-type want got))))]
                      [(ErrTcUnit message) (ErrTcType message)])]
                  [(ErrTcType message) (ErrTcType message)])]
              [(ErrTcUnit message) (ErrTcType message)]))]
        [_ (tc-expr ctx env expr)])]
    [_
      (if (tc-integer-literal-expr? expr)
        (tc-integer-literal-expr-with-expected ctx expr expected)
        (if (tc-float-literal-expr? expr)
          (tc-float-literal-expr-with-expected expr expected)
          (match (tc-expr ctx env expr)
            [(OkTcType actual)
              (if (tc-type-compatible? expected actual)
                (OkTcType (tc-contextual-result-type expected actual))
                (OkTcType actual))]
            [(ErrTcType message) (ErrTcType message)])))]))

(define (tc-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [expected : AstType]) : ResultTcType
  (tc-expr-with-expected-or-actual-core ctx env expr expected false))

(define (tc-expr-with-expected-or-actual-call-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [expected : AstType]) : ResultTcType
  (tc-expr-with-expected-or-actual-core ctx env expr expected true))

(define (tc-binop-type [op : AstBinOp] [left : AstType] [right : AstType]) : ResultTcType
  (match op
    [(AstBinAnd)
      (if (and (tc-type-eq left (AstTyBool)) (tc-type-eq right (AstTyBool)))
        (OkTcType (AstTyBool))
        (ErrTcType "typecheck: boolean operator expects bool operands"))]
    [(AstBinOr)
      (if (and (tc-type-eq left (AstTyBool)) (tc-type-eq right (AstTyBool)))
        (OkTcType (AstTyBool))
        (ErrTcType "typecheck: boolean operator expects bool operands"))]
    [(AstBinEq)
      (if (tc-type-eq left right)
        (OkTcType (AstTyBool))
        (ErrTcType "typecheck: equality operands must match"))]
    [(AstBinNe)
      (if (tc-type-eq left right)
        (OkTcType (AstTyBool))
        (ErrTcType "typecheck: equality operands must match"))]
    [(AstBinLt) (tc-compare-binop-type left right)]
    [(AstBinLe) (tc-compare-binop-type left right)]
    [(AstBinGt) (tc-compare-binop-type left right)]
    [(AstBinGe) (tc-compare-binop-type left right)]
    [(AstBinAdd) (tc-arithmetic-binop-type left right)]
    [(AstBinSub) (tc-arithmetic-binop-type left right)]
    [(AstBinMul) (tc-arithmetic-binop-type left right)]
    [(AstBinDiv) (tc-arithmetic-binop-type left right)]
    [(AstBinShl) (tc-shift-binop-type left right)]
    [(AstBinShr) (tc-shift-binop-type left right)]
    [_ (tc-integer-binop-type left right)]))

(define (tc-integer-binop-type [left : AstType] [right : AstType]) : ResultTcType
  (if (and (tc-integer-type? left) (tc-type-eq left right))
    (OkTcType left)
    (ErrTcType "typecheck: integer operator expects matching integer operands")))

(define (tc-arithmetic-binop-type [left : AstType] [right : AstType]) : ResultTcType
  (if (and (tc-float-type? left) (tc-type-eq left right))
    (OkTcType left)
    (tc-integer-binop-type left right)))

(define (tc-shift-binop-type [left : AstType] [right : AstType]) : ResultTcType
  (if (tc-integer-type? left)
    (if (tc-integer-type? right)
      (OkTcType left)
      (ErrTcType "typecheck: shift count must be integer"))
    (ErrTcType "typecheck: shift left operand must be integer")))

(define (tc-compare-binop-type [left : AstType] [right : AstType]) : ResultTcType
  (if (and (tc-ordered-comparison-type? left) (tc-type-eq left right))
    (OkTcType (AstTyBool))
    (ErrTcType "typecheck: comparison expects matching ordered scalar operands")))

(define (tc-unop-type [op : AstUnOp] [ty : AstType]) : ResultTcType
  (match op
    [(AstUnNot)
      (if (tc-type-eq ty (AstTyBool))
        (OkTcType (AstTyBool))
        (ErrTcType "typecheck: not expects bool"))]
    [(AstUnNeg)
      (if (or (tc-integer-type? ty) (tc-float-type? ty))
        (OkTcType ty)
        (ErrTcType "typecheck: neg expects integer"))]
    [(AstUnBitNot)
      (if (tc-integer-type? ty)
        (OkTcType ty)
        (ErrTcType "typecheck: bit-not expects integer"))]))

(define (tc-region-arg-builtin-name? [name : String]) : bool
  (compiler-builtin-typecheck-region-arg-id? (tc-builtin-name-id name)))

(define (tc-default-builtin-unshadowed-scan-id?
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache ids _ _ _ shadow-flags _ partial _ below)
      (match (i64-i64-map-get ids name-id)
        [(I64I64MapFound index) (not (= (array-ref shadow-flags index) 1))]
        [(I64I64MapMissing)
          (if partial
            (tc-default-builtin-unshadowed-scan-id? (box-get below) name-id)
            true)])]
    [(TcTypeBind key _ rest)
      (if (= key name-id)
        false
        (if (= key (tc-default-boundary-id))
          true
          (tc-default-builtin-unshadowed-scan-id? (box-get rest) name-id)))]))

(define (tc-default-builtin-unshadowed-scan? [env : TcTypeEnv] [name : String]) : bool
  (tc-default-builtin-unshadowed-scan-id? env (tc-name-id name)))

(define (tc-name-local-bound-before-module-scan-id?
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-name-local-bound-before-module-scan-id? (box-get rest) name-id)
        false)]
    [(TcTypeBind key _ rest)
      (if (= key name-id)
        true
        (tc-name-local-bound-before-module-scan-id? (box-get rest) name-id))]))

(define (tc-name-local-bound-before-module? [env : TcTypeEnv] [name : String]) : bool
  (tc-name-local-bound-before-module-scan-id? env (tc-name-id name)))

(define (tc-default-builtin-unshadowed? [env : TcTypeEnv] [name : String]) : bool
  (if (tc-region-arg-builtin-name? name)
    (tc-default-builtin-unshadowed-scan? env name)
    false))

(define (tc-constructor-name? [ctx : TcContext] [name : String]) : bool
  (match ctx
    [(TcContext _ symbols registries module)
      (let
        [lookup-name : String
          (if (and (> (string-length module) 0) (not (tc-name-qualified? name)))
            (compiler-symbol-module-key module name)
            name)]
        (match (compiler-symbols-lookup-type symbols lookup-name)
          [(SomeI64 handle)
            (if (=
              (compiler-symbol-handle-kind handle)
              (compiler-symbol-kind-defstruct))
              true
              (match (compiler-registries-lookup-variant registries lookup-name)
                [(SomeI64 _) true]
                [(NoneI64) false]))]
          [(NoneI64)
            (match (compiler-registries-lookup-variant registries lookup-name)
              [(SomeI64 _) true]
              [(NoneI64) false])]))]))

(define (tc-call-allows-region-args?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]) : bool
  (if (tc-default-builtin-unshadowed? env name)
    true
    (match (tc-active-region env)
      [(TcSomeString _) (tc-constructor-name? ctx name)]
      [(TcNoString) false])))

(define (tc-expr-var-name [expr : AstExpr]) : TcMaybeString
  (match (ast-expr-unspan expr)
    [(AstExprVar name) (TcSomeString (intern-str name))]
    [_ (TcNoString)]))

(define (tc-call-arity-message-prefix) : String
  "typecheck: call arity mismatch: ")

(define (tc-call-arity-message? [message : String]) : bool
  (tc-diag-string-prefix? message (tc-call-arity-message-prefix)))

(define (tc-call-expr? [expr : AstExpr]) : bool
  (match (ast-expr-unspan expr)
    [(AstExprCall _ _) true]
    [_ false]))

(define (tc-locate-call-arity-error
  [inner : AstExpr]
  [span : AstSourceSpan]
  [message : String]) : ResultTcType
  (if (and
    (tc-call-expr? inner)
    (tc-call-arity-message? message)
    (not (tc-located-error? message)))
    (ErrTcType (tc-located-error span message))
    (ErrTcType message)))

(define (tc-locate-spanned-error
  [inner : AstExpr]
  [span : AstSourceSpan]
  [message : String]) : ResultTcType
  (match (tc-spanned-escape-error inner span message)
    [(TcSomeString rich) (ErrTcType rich)]
    [(TcNoString) (tc-locate-call-arity-error inner span message)]))

(define (tc-call-arity-callee-name [func : AstExpr]) : String
  (match (tc-expr-var-name func)
    [(TcSomeString name) name]
    [(TcNoString)
      (match (ast-expr-unspan func)
        [(AstExprLambda _) "lambda"]
        [_ "call target"])]))

(define (tc-call-arity-argument-word [count : i64]) : String
  (if (= count 1)
    " argument"
    " arguments"))

(define (tc-call-arity-message
  [func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]) : String
  (let
    [expected : i64 (tc-type-list-len params)]
    [actual : i64 (tc-expr-list-len args)]
    (string-append
      (tc-call-arity-message-prefix)
      (string-append
        (tc-call-arity-callee-name func)
        (string-append
          " expected "
          (string-append
            (int->string expected)
            (string-append
              (tc-call-arity-argument-word expected)
              (string-append
                ", got "
                (string-append
                  (int->string actual)
                  (tc-call-arity-argument-word actual))))))))))

;; Deferred arity-mismatch message. tc-call-arity-message is real work (two
;; list-length walks, callee-name unspan/intern, two int->string division loops,
;; seven string-appends) but it is only ever consumed on the arity-mismatch error
;; path, which never fires while typechecking well-formed code (the self-compile).
;; Carrying the ingredients in this enum and materializing the text only at the
;; error arms keeps the success path -- the overwhelmingly common one -- free of
;; that build, with byte-identical output for accepted programs and identical
;; diagnostics for rejected ones.
(defenum TcArityMessage
  (TcArityLiteral)
  (TcArityDetailed AstExpr AstExprList AstTypeList))

(define (tc-arity-message-text [arity-msg : TcArityMessage]) : String
  (match arity-msg
    [(TcArityLiteral) "typecheck: arity mismatch"]
    [(TcArityDetailed func args params)
      (tc-call-arity-message func args params)]))

(define (tc-nullary-variant-call-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]
  [enum-name : String]
  [ret : AstType]) : ResultTcType
  (match (tc-expr-var-name func)
    [(TcSomeString name)
      (let
        [lookup-name : String
          (tc-source-variant-name-for-enum ctx enum-name name)]
        (match (compiler-registries-lookup-variant
          (tc-context-registries ctx)
          lookup-name)
          [(SomeI64 handle)
            (match (tc-qualified-variant-visible-ok ctx lookup-name)
              [(OkTcUnit)
                (match (tc-variant-owner-name ctx handle)
                  [(OkTcString owner)
                    (if (string-eq owner enum-name)
                      (match (compiler-registries-variant-fields-indexed
                        (tc-context-symbols ctx)
                        handle)
                        [(OkAstTypeList fields)
                          (match fields
                            [(AstTypeNil)
                              (OkTcType (tc-tag-active-region env ret))]
                            [_ (ErrTcType "typecheck: arity mismatch")])]
                        [(ErrAstTypeList message) (ErrTcType message)])
                      (ErrTcType "typecheck: call target is not a function"))]
                  [(ErrTcString message) (ErrTcType message)])]
              [(ErrTcUnit message) (ErrTcType message)])]
          [(NoneI64)
            (if (tc-name-qualified? lookup-name)
              (OkTcType (tc-tag-active-region env ret))
              (ErrTcType "typecheck: call target is not a function"))]))]
    [(TcNoString) (ErrTcType "typecheck: call target is not a function")]))

(define (tc-call-region-args-allowed-for-func
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]) : bool
  (match (tc-expr-var-name func)
    [(TcSomeString name) (tc-call-allows-region-args? ctx env name)]
    [(TcNoString) false]))

(define (tc-call-constructor-target-for-func
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]
  [params : AstTypeList]
  [ret : AstType]) : AstMaybeType
  (match (tc-expr-var-name func)
    [(TcSomeString name)
      (if (tc-constructor-name? ctx name)
        (AstSomeType (tc-constructor-target-type env params ret))
        (AstNoType))]
    [(TcNoString) (AstNoType)]))

(define (tc-lifetime-constructor-ret? [ret : AstType]) : bool
  (match ret
    [(AstTyStructArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [(AstTyEnumArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [_ false]))

(define (tc-call-lifetime-constructor-for-func?
  [ctx : TcContext]
  [func : AstExpr]
  [ret : AstType]) : bool
  (if (tc-lifetime-constructor-ret? ret)
    (match (tc-expr-var-name func)
      [(TcSomeString name) (tc-constructor-name? ctx name)]
      [(TcNoString) false])
    false))

(define (tc-lifetime-subst-type-list
  [subst : TcLifetimeSubst]
  [types : AstTypeList]) : AstTypeList
  (match types
    [(AstTypeNil) AstTypeNil]
    [(AstTypeCons head tail)
      (let
        [head : AstType (ty-node-get head)]
        [tail : AstTypeList (box-get tail)]
        (ast-type-cons
          (tc-lifetime-subst-type subst head)
          (tc-lifetime-subst-type-list subst tail)))]))

(define (tc-lifetime-subst-type [subst : TcLifetimeSubst] [ty : AstType]) : AstType
  (match ty
    [(AstTyFunc args ret)
      (ast-ty-func
        (tc-lifetime-subst-type-list subst (box-get args))
        (tc-lifetime-subst-type subst (ty-node-get ret)))]
    [(AstTyTuple elems)
      (ast-ty-tuple (tc-lifetime-subst-type-list subst (box-get elems)))]
    [(AstTyArray elem len)
      (ast-ty-array (tc-lifetime-subst-type subst (ty-node-get elem)) len)]
    [(AstTyDynArray elem)
      (ast-ty-dyn-array (tc-lifetime-subst-type subst (ty-node-get elem)))]
    [(AstTyBox elem)
      (ast-ty-box (tc-lifetime-subst-type subst (ty-node-get elem)))]
    [(AstTyPtr elem)
      (ast-ty-ptr (tc-lifetime-subst-type subst (ty-node-get elem)))]
    [(AstTyMutPtr elem)
      (ast-ty-mut-ptr (tc-lifetime-subst-type subst (ty-node-get elem)))]
    [(AstTyRef lifetime inner)
      (ast-ty-ref
        (tc-lifetime-subst-apply subst lifetime)
        (tc-lifetime-subst-type subst (ty-node-get inner)))]
    [(AstTyMutRef lifetime inner)
      (ast-ty-mut-ref
        (tc-lifetime-subst-apply subst lifetime)
        (tc-lifetime-subst-type subst (ty-node-get inner)))]
    [(AstTyRegion region inner)
      (ast-ty-region region (tc-lifetime-subst-type subst (ty-node-get inner)))]
    [(AstTyEnumArgs name lifetimes)
      (ast-ty-enum-args name (tc-lifetime-subst-list subst (box-get lifetimes)))]
    [(AstTyStructArgs name lifetimes)
      (ast-ty-struct-args
        name
        (tc-lifetime-subst-list subst (box-get lifetimes)))]
    [(AstTyVarArgs name lifetimes)
      (ast-ty-var-args name (tc-lifetime-subst-list subst (box-get lifetimes)))]
    [_ ty]))

(define (tc-infer-lifetime-name
  [params : AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : String]
  [actual : String]) : ResultTcLifetimeSubst
  (if (tc-lifetime-list-contains params formal)
    (tc-lifetime-subst-bind subst formal actual)
    (if (string-eq formal actual)
      (OkTcLifetimeSubst subst)
      (ErrTcLifetimeSubst "typecheck: argument type mismatch"))))

(define (tc-infer-lifetime-list
  [params : AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : AstLifetimeList]
  [actual : AstLifetimeList]) : ResultTcLifetimeSubst
  (match formal
    [(AstLifetimeNil)
      (match actual
        [(AstLifetimeNil) (OkTcLifetimeSubst subst)]
        [_ (ErrTcLifetimeSubst "typecheck: argument type mismatch")])]
    [(AstLifetimeCons formal-head formal-rest)
      (let
        [formal-rest : AstLifetimeList (box-get formal-rest)]
        (match actual
          [(AstLifetimeCons actual-head actual-rest)
            (let
              [actual-rest : AstLifetimeList (box-get actual-rest)]
              (match (tc-infer-lifetime-name
                params
                subst
                formal-head
                actual-head)
                [(OkTcLifetimeSubst next-subst)
                  (tc-infer-lifetime-list
                    params
                    next-subst
                    formal-rest
                    actual-rest)]
                [(ErrTcLifetimeSubst message) (ErrTcLifetimeSubst message)]))]
          [_ (ErrTcLifetimeSubst "typecheck: argument type mismatch")]))]))

(define (tc-infer-lifetime-subst-from-type
  [ctx : TcContext]
  [params : AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : AstType]
  [actual : AstType]) : ResultTcLifetimeSubst
  (let
    [want : AstType (tc-resolve-type ctx formal)]
    [got : AstType (tc-resolve-type ctx actual)]
    (match want
      [(AstTyRef formal-lifetime formal-inner)
        (match got
          [(AstTyRef actual-lifetime actual-inner)
            (match (tc-infer-lifetime-name
              params
              subst
              formal-lifetime
              actual-lifetime)
              [(OkTcLifetimeSubst next-subst)
                (tc-infer-lifetime-subst-from-type
                  ctx
                  params
                  next-subst
                  (ty-node-get formal-inner)
                  (ty-node-get actual-inner))]
              [(ErrTcLifetimeSubst message) (ErrTcLifetimeSubst message)])]
          [_ (ErrTcLifetimeSubst "typecheck: argument type mismatch")])]
      [(AstTyMutRef formal-lifetime formal-inner)
        (match got
          [(AstTyMutRef actual-lifetime actual-inner)
            (match (tc-infer-lifetime-name
              params
              subst
              formal-lifetime
              actual-lifetime)
              [(OkTcLifetimeSubst next-subst)
                (tc-infer-lifetime-subst-from-type
                  ctx
                  params
                  next-subst
                  (ty-node-get formal-inner)
                  (ty-node-get actual-inner))]
              [(ErrTcLifetimeSubst message) (ErrTcLifetimeSubst message)])]
          [_ (ErrTcLifetimeSubst "typecheck: argument type mismatch")])]
      [(AstTyEnumArgs formal-name formal-lifetimes)
        (match got
          [(AstTyEnumArgs actual-name actual-lifetimes)
            (if (= formal-name actual-name)
              (tc-infer-lifetime-list
                params
                subst
                (box-get formal-lifetimes)
                (box-get actual-lifetimes))
              (ErrTcLifetimeSubst "typecheck: argument type mismatch"))]
          [_ (ErrTcLifetimeSubst "typecheck: argument type mismatch")])]
      [(AstTyStructArgs formal-name formal-lifetimes)
        (match got
          [(AstTyStructArgs actual-name actual-lifetimes)
            (if (= formal-name actual-name)
              (tc-infer-lifetime-list
                params
                subst
                (box-get formal-lifetimes)
                (box-get actual-lifetimes))
              (ErrTcLifetimeSubst "typecheck: argument type mismatch"))]
          [_ (ErrTcLifetimeSubst "typecheck: argument type mismatch")])]
      [(AstTyTuple formal-elems)
        (match got
          [(AstTyTuple actual-elems)
            (tc-infer-lifetime-subst-from-type-list
              ctx
              params
              subst
              (box-get formal-elems)
              (box-get actual-elems))]
          [_ (ErrTcLifetimeSubst "typecheck: argument type mismatch")])]
      [(AstTyArray formal-elem formal-len)
        (match got
          [(AstTyArray actual-elem actual-len)
            (if (= formal-len actual-len)
              (tc-infer-lifetime-subst-from-type
                ctx
                params
                subst
                (ty-node-get formal-elem)
                (ty-node-get actual-elem))
              (ErrTcLifetimeSubst "typecheck: argument type mismatch"))]
          [_ (ErrTcLifetimeSubst "typecheck: argument type mismatch")])]
      [(AstTyDynArray formal-elem)
        (match got
          [(AstTyDynArray actual-elem)
            (tc-infer-lifetime-subst-from-type
              ctx
              params
              subst
              (ty-node-get formal-elem)
              (ty-node-get actual-elem))]
          [_ (ErrTcLifetimeSubst "typecheck: argument type mismatch")])]
      [(AstTyBox formal-elem)
        (match got
          [(AstTyBox actual-elem)
            (tc-infer-lifetime-subst-from-type
              ctx
              params
              subst
              (ty-node-get formal-elem)
              (ty-node-get actual-elem))]
          [_ (ErrTcLifetimeSubst "typecheck: argument type mismatch")])]
      [_
        (if (tc-type-compatible? want got)
          (OkTcLifetimeSubst subst)
          (ErrTcLifetimeSubst "typecheck: argument type mismatch"))])))

(define (tc-infer-lifetime-subst-from-type-list
  [ctx : TcContext]
  [params : AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : AstTypeList]
  [actual : AstTypeList]) : ResultTcLifetimeSubst
  (match formal
    [(AstTypeNil)
      (match actual
        [(AstTypeNil) (OkTcLifetimeSubst subst)]
        [_ (ErrTcLifetimeSubst "typecheck: argument type mismatch")])]
    [(AstTypeCons formal-head formal-rest)
      (let
        [formal-head : AstType (ty-node-get formal-head)]
        [formal-rest : AstTypeList (box-get formal-rest)]
        (match actual
          [(AstTypeCons actual-head actual-rest)
            (let
              [actual-head : AstType (ty-node-get actual-head)]
              [actual-rest : AstTypeList (box-get actual-rest)]
              (match (tc-infer-lifetime-subst-from-type
                ctx
                params
                subst
                formal-head
                actual-head)
                [(OkTcLifetimeSubst next-subst)
                  (tc-infer-lifetime-subst-from-type-list
                    ctx
                    params
                    next-subst
                    formal-rest
                    actual-rest)]
                [(ErrTcLifetimeSubst message) (ErrTcLifetimeSubst message)]))]
          [_ (ErrTcLifetimeSubst "typecheck: argument type mismatch")]))]))

(define (tc-call-immutable-ref-formal? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyRef _ _) true]
    [(AstTyVar _)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(AstTyRef _ _) true]
        [_ false])]
    [(AstTyVarArgs _ _)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(AstTyRef _ _) true]
        [_ false])]
    [_ false]))

(define (tc-call-mutable-ref-formal? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyMutRef _ _) true]
    [(AstTyVar _)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(AstTyMutRef _ _) true]
        [_ false])]
    [(AstTyVarArgs _ _)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(AstTyMutRef _ _) true]
        [_ false])]
    [_ false]))

(define (tc-call-actual-reference? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyRef _ _) true]
    [(AstTyMutRef _ _) true]
    [(AstTyVar _)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(AstTyRef _ _) true]
        [(AstTyMutRef _ _) true]
        [_ false])]
    [(AstTyVarArgs _ _)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(AstTyRef _ _) true]
        [(AstTyMutRef _ _) true]
        [_ false])]
    [_ false]))

(define (tc-call-type-list-has-immutable-ref-formal?
  [ctx : TcContext]
  [types : AstTypeList]) : bool
  (match types
    [(AstTypeNil) false]
    [(AstTypeCons head rest)
      (let
        [head : AstType (ty-node-get head)]
        [rest : AstTypeList (box-get rest)]
        (if (tc-call-immutable-ref-formal? ctx head)
          true
          (tc-call-type-list-has-immutable-ref-formal? ctx rest)))]))

(define (tc-call-auto-borrow-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : AstExpr]) : ResultTcType
  (match (tc-borrow-place ctx env arg)
    [(OkTcBorrowPlace place)
      (match place
        [(TcBorrowPlace lifetime referent-ty)
          (OkTcType (ast-ty-ref lifetime referent-ty))])]
    [(ErrTcBorrowPlace message) (ErrTcType message)]))

(define (tc-call-auto-borrow-expr [arg : AstExpr]) : AstExpr
  (ast-node-get
    (ast-expr-borrow false AstBorrowLifetimeInferred (ast-node-push arg))))

(define (tc-call-effective-var-arg-type
  [ctx : TcContext]
  [name : String]
  [got : AstType]) : ResultTcType
  (if (tc-call-actual-reference? ctx got)
    (OkTcType got)
    (match (tc-borrow-place-var name got)
      [(OkTcBorrowPlace place)
        (match place
          [(TcBorrowPlace lifetime referent-ty)
            (OkTcType (ast-ty-ref lifetime referent-ty))])]
      [(ErrTcBorrowPlace message) (ErrTcType message)])))

(define (tc-call-effective-arg-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : AstExpr]
  [want : AstType]) : ResultTcType
  (if (tc-call-immutable-ref-formal? ctx want)
    (match (ast-expr-unspan arg)
      [(AstExprVar name)
        (let
          [name-text : String (intern-str name)]
          (if (tc-dotted-local-field-name-id? env name)
            (match (tc-expr ctx env arg)
              [(OkTcType got)
                (if (tc-call-actual-reference? ctx got)
                  (OkTcType got)
                  (tc-call-auto-borrow-type ctx env arg))]
              [(ErrTcType message) (ErrTcType message)])
            (match (tc-lookup-visible-id ctx env name)
              [(OkTcType got)
                (tc-call-effective-var-arg-type ctx name-text got)]
              [(ErrTcType message) (ErrTcType message)])))]
      [_
        (match (tc-expr ctx env arg)
          [(OkTcType got)
            (if (tc-call-actual-reference? ctx got)
              (OkTcType got)
              (tc-call-auto-borrow-type ctx env arg))]
          [(ErrTcType message) (ErrTcType message)])])
    (tc-expr-with-expected-or-actual-call-arg ctx env arg want)))

(define (tc-call-effective-var-arg-expr
  [ctx : TcContext]
  [name : String]
  [got : AstType]
  [arg : AstExpr]) : ResultTcExpr
  (if (tc-call-actual-reference? ctx got)
    (OkTcExpr arg)
    (match (tc-borrow-place-var name got)
      [(OkTcBorrowPlace _) (OkTcExpr (tc-call-auto-borrow-expr arg))]
      [(ErrTcBorrowPlace message) (ErrTcExpr message)])))

(define (tc-call-effective-arg-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : AstExpr]
  [want : AstType]) : ResultTcExpr
  (if (tc-call-immutable-ref-formal? ctx want)
    (if (tc-call-explicit-borrow-expr? arg)
      (OkTcExpr arg)
      (match (ast-expr-unspan arg)
        [(AstExprVar name)
          (let
            [name-text : String (intern-str name)]
            (if (tc-dotted-local-field-name-id? env name)
              (match (tc-expr ctx env arg)
                [(OkTcType got)
                  (if (tc-call-actual-reference? ctx got)
                    (OkTcExpr arg)
                    (match (tc-call-auto-borrow-type ctx env arg)
                      [(OkTcType _) (OkTcExpr (tc-call-auto-borrow-expr arg))]
                      [(ErrTcType message) (ErrTcExpr message)]))]
                [(ErrTcType message) (ErrTcExpr message)])
              (match (tc-lookup-visible-id ctx env name)
                [(OkTcType got)
                  (tc-call-effective-var-arg-expr ctx name-text got arg)]
                [(ErrTcType message) (ErrTcExpr message)])))]
        [_
          (match (tc-expr ctx env arg)
            [(OkTcType got)
              (if (tc-call-actual-reference? ctx got)
                (OkTcExpr arg)
                (match (tc-call-auto-borrow-type ctx env arg)
                  [(OkTcType _) (OkTcExpr (tc-call-auto-borrow-expr arg))]
                  [(ErrTcType message) (ErrTcExpr message)]))]
            [(ErrTcType message) (ErrTcExpr message)])]))
    (OkTcExpr arg)))

(define (tc-infer-call-lifetime-subst
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [params : AstTypeList]
  [lifetimes : AstLifetimeList]
  [subst : TcLifetimeSubst]) : ResultTcLifetimeSubst
  (match args
    [(AstExprNil)
      (match params
        [(AstTypeNil) (OkTcLifetimeSubst subst)]
        [_ (ErrTcLifetimeSubst "typecheck: arity mismatch")])]
    [(AstExprCons arg rest-args)
      (let
        [arg : AstExpr (ast-node-get arg)]
        [rest-args : AstExprList (box-get rest-args)]
        (match params
          [(AstTypeCons want rest-params)
            (let
              [want : AstType (ty-node-get want)]
              [rest-params : AstTypeList (box-get rest-params)]
              (match (tc-call-effective-arg-type ctx env arg want)
                [(OkTcType got)
                  (match (tc-infer-lifetime-subst-from-type
                    ctx
                    lifetimes
                    subst
                    want
                    got)
                    [(OkTcLifetimeSubst next-subst)
                      (tc-infer-call-lifetime-subst
                        ctx
                        env
                        rest-args
                        rest-params
                        lifetimes
                        next-subst)]
                    [(ErrTcLifetimeSubst message)
                      (ErrTcLifetimeSubst (tc-locate-error-at-expr arg message))])]
                [(ErrTcType message)
                  (ErrTcLifetimeSubst (tc-locate-error-at-expr arg message))]))]
          [(AstTypeNil) (ErrTcLifetimeSubst "typecheck: arity mismatch")]))]))

(define (tc-call-lifetime-constructor-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [_func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]
  [ret : AstType]
  [allow-region-args : bool]) : ResultTcType
  (let
    [lifetimes : AstLifetimeList
      (match ret
        [(AstTyStructArgs _ params-lifetimes) (box-get params-lifetimes)]
        [(AstTyEnumArgs _ params-lifetimes) (box-get params-lifetimes)]
        [_ AstLifetimeNil])]
    (match (tc-infer-call-lifetime-subst
      ctx
      env
      args
      params
      lifetimes
      TcLifetimeSubstNil)
      [(OkTcLifetimeSubst subst)
        (let
          [target : AstType
            (tc-tag-active-region env (tc-lifetime-subst-type subst ret))]
          [resolved-params : AstTypeList
            (tc-lifetime-subst-type-list subst params)]
          (match (tc-check-call-args
            ctx
            env
            args
            resolved-params
            allow-region-args
            (AstSomeType target)
            false)
            [(OkTcUnit) (OkTcType target)]
            [(ErrTcUnit message) (ErrTcType message)]))]
      [(ErrTcLifetimeSubst message) (ErrTcType message)])))

(define (tc-call-function-lifetimes [params : AstTypeList] [ret : AstType]) : AstLifetimeList
  (tc-string-list-to-lifetime-list
    (tc-type-collect-reference-lifetimes-into
      ret
      (tc-type-list-collect-reference-lifetimes params TcStringNil))))

(define (tc-call-lifetime-function-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [params : AstTypeList]
  [ret : AstType]
  [lifetimes : AstLifetimeList]
  [allow-region-args : bool]
  [c-abi-args : bool]) : ResultTcType
  (match (tc-infer-call-lifetime-subst
    ctx
    env
    args
    params
    lifetimes
    TcLifetimeSubstNil)
    [(OkTcLifetimeSubst subst)
      (let
        [resolved-ret : AstType (tc-lifetime-subst-type subst ret)]
        [resolved-params : AstTypeList
          (tc-lifetime-subst-type-list subst params)]
        (match (tc-check-call-args
          ctx
          env
          args
          resolved-params
          allow-region-args
          (AstNoType)
          c-abi-args)
          [(OkTcUnit) (OkTcType (tc-tag-active-region env resolved-ret))]
          [(ErrTcUnit message) (ErrTcType message)]))]
    [(ErrTcLifetimeSubst message) (ErrTcType message)]))

(define (tc-call-dynamic-c-varargs-abi? [abi : AstExternAbi]) : bool
  (or
    (ast-extern-abi-c-varargs-open? abi)
    (ast-extern-abi-c-varargs-typed? abi)))

(define (tc-call-extern-abi-for-name [ctx : TcContext] [name : String]) : TcMaybeExternAbi
  (let
    [source-name : String (tc-hygiene-global-symbol-name name)]
    [module : String (tc-context-module ctx)]
    [lookup-name : String
      (if (and
        (> (string-length module) 0)
        (not (tc-name-qualified? source-name)))
        (compiler-symbol-module-key module source-name)
        source-name)]
    (match (compiler-symbols-lookup-value (tc-context-symbols ctx) lookup-name)
      [(SomeI64 handle)
        (if (=
          (compiler-symbol-handle-kind handle)
          (compiler-symbol-kind-extern))
          (match (compiler-symbols-decl-at-index
            (tc-context-symbols ctx)
            (compiler-symbol-handle-index handle))
            [(OkAstDecl decl)
              (match decl
                [(AstDeclExtern _ kind metadata _)
                  (match kind
                    [(AstExternFunction)
                      (TcSomeExternAbi (ast-extern-metadata-abi metadata))]
                    [(AstExternValue) (TcNoExternAbi)])]
                [_ (TcNoExternAbi)])]
            [(ErrAstDecl _) (TcNoExternAbi)])
          (TcNoExternAbi))]
      [(NoneI64) (TcNoExternAbi)])))

(define (tc-call-extern-abi [ctx : TcContext] [func : AstExpr]) : TcMaybeExternAbi
  (match (ast-expr-unspan func)
    [(AstExprVar name) (tc-call-extern-abi-for-name ctx (intern-str name))]
    [_ (TcNoExternAbi)]))

(define (tc-c-abi-fnptr-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyFunc _ _) true]
    [_ false]))

(define (tc-extern-value-c-abi-fnptr?
  [ctx : TcContext]
  [kind : AstExternKind]
  [ty : AstType]) : bool
  (match kind
    [(AstExternValue) (tc-c-abi-fnptr-type? (tc-resolve-type ctx ty))]
    [(AstExternFunction) false]))

(define (tc-expr-list-last-c-abi-fnptr?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]) : bool
  (match exprs
    [(AstExprNil) false]
    [(AstExprCons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (match rest
          [(AstExprNil) (tc-expr-c-abi-fnptr? ctx env expr)]
          [_ (tc-expr-list-last-c-abi-fnptr? ctx env rest)]))]))

(define (tc-hygiene-c-abi-fnptr-binding?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]) : bool
  (match (tc-hygiene-global-decode name)
    [(TcHygieneLegacyGlobal global-name)
      (tc-binding-c-abi-fnptr-id? env (tc-name-id global-name))]
    [(TcHygieneContextGlobal module global-name)
      (match (tc-hygiene-definition-env ctx module)
        [(OkTcEnv def-env)
          (tc-binding-c-abi-fnptr-id? def-env (tc-name-id global-name))]
        [(ErrTcEnv _) false])]))

(define (tc-expr-c-abi-fnptr?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]) : bool
  (match (ast-expr-unspan expr)
    [(AstExprVar name)
      (let
        [text : String (intern-str name)]
        (if (tc-hygiene-global-name? text)
          (tc-hygiene-c-abi-fnptr-binding? ctx env text)
          (tc-binding-c-abi-fnptr-id? env name)))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-c-abi-fnptr? ctx env inner))]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-let-bindings-for-body ctx env bindings body)
              [(OkTcEnv next-env) (tc-expr-c-abi-fnptr? ctx next-env body)]
              [(ErrTcEnv _) false]))])]
    [(AstExprBegin exprs) (tc-expr-list-last-c-abi-fnptr? ctx env exprs)]
    [(AstExprIf _ then-box else-box)
      (let
        [then-branch : AstExpr (ast-node-get then-box)]
        [else-branch : AstExpr (ast-node-get else-box)]
        (and
          (tc-expr-c-abi-fnptr? ctx env then-branch)
          (tc-expr-c-abi-fnptr? ctx env else-branch)))]
    [_ false]))

(define (tc-name-base-eq? [name : String] [base : String]) : bool
  (if (string-eq name base)
    true
    (if (tc-name-qualified? name)
      (string-eq (tc-qualified-name-base name) base)
      false)))

(define (tc-arena-owner-kind-none) : i64
  0)

(define (tc-arena-owner-kind-ordinary) : i64
  1)

(define (tc-arena-owner-kind-atomic) : i64
  2)

(define (tc-arena-owner-call-kind [env : TcTypeEnv] [expr : AstExpr]) : i64
  (match (ast-expr-unspan expr)
    [(AstExprCall func-box args)
      (match args
        [(AstExprNil)
          (match (tc-expr-var-name (ast-node-get func-box))
            [(TcSomeString name)
              (cond
                [(and
                    (string-eq name "arena-make-atomic")
                    (not
                      (tc-name-local-bound-before-module?
                        env
                        "arena-make-atomic")))
                  (tc-arena-owner-kind-atomic)]
                [(and
                    (string-eq name "arena-make")
                    (not (tc-name-local-bound-before-module? env "arena-make")))
                  (tc-arena-owner-kind-ordinary)]
                [else (tc-arena-owner-kind-none)])]
            [(TcNoString) (tc-arena-owner-kind-none)])]
        [_ (tc-arena-owner-kind-none)])]
    [_ (tc-arena-owner-kind-none)]))

(define (tc-bind-arena-owner-if-needed-id
  [env : TcTypeEnv]
  [name : i64]
  [init : AstExpr]) : TcTypeEnv
  (let
    [kind : i64 (tc-arena-owner-call-kind env init)]
    (cond
      [(= kind (tc-arena-owner-kind-atomic))
        (tc-bind-atomic-arena-owner env (intern-str name))]
      [(= kind (tc-arena-owner-kind-ordinary))
        (tc-bind-ordinary-arena-owner env (intern-str name))]
      [else env])))

(define (tc-bind-c-abi-fnptr-if-needed-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [ty : AstType]
  [init : AstExpr]) : TcTypeEnv
  (let
    [owner-env : TcTypeEnv
      (if (tc-type-eq (tc-type-strip-region ty) (AstTyI64))
        (tc-bind-arena-owner-if-needed-id env name init)
        env)]
    (if (and (tc-c-abi-fnptr-type? ty) (tc-expr-c-abi-fnptr? ctx env init))
      (tc-bind-c-abi-fnptr-id owner-env name ty)
      (tc-bind-id owner-env name ty))))

(define (tc-raw-c-fnptr-flow-ok
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [expected : AstType]
  [c-abi-position : bool]) : ResultTcUnit
  (if (and
    (not c-abi-position)
    (tc-c-abi-fnptr-type? expected)
    (tc-expr-c-abi-fnptr? ctx env expr))
    (ErrTcUnit
      (tc-locate-error-at-expr
        expr
        "typecheck: raw C function pointer cannot be used as a TypeLisp function value"))
    OkTcUnit))

(define (tc-call-varargs-tail-args [args : AstExprList] [params : AstTypeList]) : ResultTcExprList
  (match params
    [(AstTypeNil) (OkTcExprList args)]
    [(AstTypeCons _ rest-params)
      (match args
        [(AstExprCons _ rest-args)
          (tc-call-varargs-tail-args (box-get rest-args) (box-get rest-params))]
        [(AstExprNil) (ErrTcExprList "typecheck: arity mismatch")])]))

(define (tc-type-list-append [a : AstTypeList] [b : AstTypeList]) : AstTypeList
  (match a
    [(AstTypeNil) b]
    [(AstTypeCons head rest)
      (ast-type-cons (ty-node-get head) (tc-type-list-append (box-get rest) b))]))

(define (tc-type-list-repeat [ty : AstType] [count : i64]) : AstTypeList
  (if (<= count 0)
    AstTypeNil
    (ast-type-cons ty (tc-type-list-repeat ty (- count 1)))))

(define (tc-call-open-varargs-tail-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]) : ResultTcTypeList
  (match args
    [(AstExprNil) (OkTcTypeList AstTypeNil)]
    [(AstExprCons arg rest)
      (let
        [arg : AstExpr (ast-node-get arg)]
        [rest : AstExprList (box-get rest)]
        (match (tc-expr ctx env arg)
          [(OkTcType ty)
            (let
              [resolved : AstType (tc-resolve-type ctx ty)]
              (if (tc-extern-abi-value-type-ok? ctx resolved)
                (match (tc-call-open-varargs-tail-types ctx env rest)
                  [(OkTcTypeList tail-types)
                    (OkTcTypeList (ast-type-cons ty tail-types))]
                  [(ErrTcTypeList message) (ErrTcTypeList message)])
                (ErrTcTypeList
                  (tc-extern-abi-unsupported-message
                    "variadic argument"
                    resolved))))]
          [(ErrTcType message) (ErrTcTypeList message)]))]))

(define (tc-call-extern-varargs-params
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [params : AstTypeList]
  [abi : AstExternAbi]) : ResultTcTypeList
  (match (tc-call-varargs-tail-args args params)
    [(OkTcExprList tail-args)
      (if (ast-extern-abi-c-varargs-open? abi)
        (match (tc-call-open-varargs-tail-types ctx env tail-args)
          [(OkTcTypeList tail-types)
            (OkTcTypeList (tc-type-list-append params tail-types))]
          [(ErrTcTypeList message) (ErrTcTypeList message)])
        (if (ast-extern-abi-c-varargs-typed? abi)
          (let
            [tail-ty : AstType
              (tc-resolve-type ctx (ast-extern-abi-varargs-tail-type abi))]
            (OkTcTypeList
              (tc-type-list-append
                params
                (tc-type-list-repeat tail-ty (tc-expr-list-len tail-args)))))
          (OkTcTypeList params)))]
    [(ErrTcExprList message) (ErrTcTypeList message)]))

(define (tc-call-function-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]
  [ret : AstType]) : ResultTcType
  (match (tc-call-extern-abi ctx func)
    [(TcSomeExternAbi abi)
      (if (tc-call-dynamic-c-varargs-abi? abi)
        (match (tc-call-extern-varargs-params ctx env args params abi)
          [(OkTcTypeList expanded-params)
            (tc-call-function-type-normal
              ctx
              env
              func
              args
              expanded-params
              ret
              true)]
          [(ErrTcTypeList message) (ErrTcType message)])
        (tc-call-function-type-normal ctx env func args params ret true))]
    [(TcNoExternAbi)
      (tc-call-function-type-normal
        ctx
        env
        func
        args
        params
        ret
        (tc-expr-c-abi-fnptr? ctx env func))]))

(define (tc-thread-name-base [name : String]) : String
  (if (tc-name-qualified? name)
    (tc-qualified-name-base name)
    name))

(define (tc-thread-name-base-eq? [name : String] [base : String]) : bool
  (tc-name-base-eq? name base))

(define (tc-thread-spawn-i64-name? [name : String]) : bool
  (string-eq (tc-thread-name-base name) "thread-spawn-i64"))

(define (tc-thread-spawn-bool-name? [name : String]) : bool
  (string-eq (tc-thread-name-base name) "thread-spawn-bool"))

(define (tc-thread-spawn-unit-name? [name : String]) : bool
  (string-eq (tc-thread-name-base name) "thread-spawn-unit"))

(define (tc-thread-spawn-string-name? [name : String]) : bool
  (string-eq (tc-thread-name-base name) "thread-spawn-string"))

(define (tc-thread-spawn-array-i64-name? [name : String]) : bool
  (string-eq (tc-thread-name-base name) "thread-spawn-array-i64"))

(define (tc-thread-spawn-box-i64-name? [name : String]) : bool
  (string-eq (tc-thread-name-base name) "thread-spawn-box-i64"))

(define (tc-thread-safe-spawn-name? [name : String]) : bool
  (let
    [base : String (tc-thread-name-base name)]
    (or
      (string-eq base "thread-spawn-i64")
      (string-eq base "thread-spawn-bool")
      (string-eq base "thread-spawn-unit")
      (string-eq base "thread-spawn-string")
      (string-eq base "thread-spawn-array-i64")
      (string-eq base "thread-spawn-box-i64"))))

(define (tc-thread-safe-handle-type-name? [name : String]) : bool
  (let
    [base : String (tc-thread-name-base name)]
    (or
      (string-eq base "ThreadI64")
      (string-eq base "ThreadBool")
      (string-eq base "ThreadUnit")
      (string-eq base "ThreadString")
      (string-eq base "ThreadArrayI64")
      (string-eq base "ThreadBoxI64"))))

(define (tc-thread-safe-spawn-call-name [func : AstExpr]) : TcMaybeString
  (match (tc-expr-var-name func)
    [(TcSomeString name)
      (if (tc-thread-safe-spawn-name? name)
        (TcSomeString name)
        (TcNoString))]
    [(TcNoString) (TcNoString)]))

(define (tc-thread-channel-send-name? [name : String]) : bool
  (let
    [base : String (tc-thread-name-base name)]
    (and
      (tc-string-prefix? base "channel-")
      (tc-string-has-suffix? base "-send"))))

(define (tc-thread-channel-send-call-name [func : AstExpr]) : TcMaybeString
  (match (tc-expr-var-name func)
    [(TcSomeString name)
      (if (tc-thread-channel-send-name? name)
        (TcSomeString name)
        (TcNoString))]
    [(TcNoString) (TcNoString)]))

(define (tc-thread-channel-send-result-name? [name : String]) : bool
  (tc-string-has-suffix? (tc-thread-name-base name) "SendResult"))

(define (tc-thread-channel-send-result-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstTyEnum name) (tc-thread-channel-send-result-name? (intern-str name))]
    [(AstTyEnumArgs name _)
      (tc-thread-channel-send-result-name? (intern-str name))]
    [_ false]))

(define (tc-thread-channel-send-message-param [params : AstTypeList]) : ResultTcType
  (match params
    [(AstTypeCons _ rest-box)
      (let
        [rest : AstTypeList (box-get rest-box)]
        (match rest
          [(AstTypeCons message-box tail-box)
            (match (box-get tail-box)
              [(AstTypeNil) (OkTcType (ty-node-get message-box))]
              [_
                (ErrTcType
                  "typecheck: channel send expects channel and message parameters")])]
          [(AstTypeNil)
            (ErrTcType
              "typecheck: channel send expects channel and message parameters")]))]
    [(AstTypeNil)
      (ErrTcType
        "typecheck: channel send expects channel and message parameters")]))

(define (tc-thread-channel-send-message-arg [args : AstExprList]) : ResultTcExpr
  (match args
    [(AstExprCons _ rest-box)
      (let
        [rest : AstExprList (box-get rest-box)]
        (match rest
          [(AstExprCons message-box tail-box)
            (match (box-get tail-box)
              [(AstExprNil) (OkTcExpr (ast-node-get message-box))]
              [_
                (ErrTcExpr
                  "typecheck: channel send expects channel and message arguments")])]
          [(AstExprNil)
            (ErrTcExpr
              "typecheck: channel send expects channel and message arguments")]))]
    [(AstExprNil)
      (ErrTcExpr
        "typecheck: channel send expects channel and message arguments")]))

(define (tc-thread-safe-spawn-result-type-name?
  [spawn-name : String]
  [result-name : String]) : bool
  (cond
    [(tc-thread-spawn-i64-name? spawn-name)
      (tc-thread-name-base-eq? result-name "ThreadI64SpawnResult")]
    [(tc-thread-spawn-bool-name? spawn-name)
      (tc-thread-name-base-eq? result-name "ThreadBoolSpawnResult")]
    [(tc-thread-spawn-unit-name? spawn-name)
      (tc-thread-name-base-eq? result-name "ThreadUnitSpawnResult")]
    [(tc-thread-spawn-string-name? spawn-name)
      (tc-thread-name-base-eq? result-name "ThreadStringSpawnResult")]
    [(tc-thread-spawn-array-i64-name? spawn-name)
      (tc-thread-name-base-eq? result-name "ThreadArrayI64SpawnResult")]
    [(tc-thread-spawn-box-i64-name? spawn-name)
      (tc-thread-name-base-eq? result-name "ThreadBoxI64SpawnResult")]
    [else false]))

(define (tc-thread-safe-spawn-result-type?
  [ctx : TcContext]
  [spawn-name : String]
  [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstTyEnum name)
      (tc-thread-safe-spawn-result-type-name? spawn-name (intern-str name))]
    [(AstTyEnumArgs name _)
      (tc-thread-safe-spawn-result-type-name? spawn-name (intern-str name))]
    [_ false]))

(define (tc-thread-safe-spawn-task-ret-type?
  [ctx : TcContext]
  [spawn-name : String]
  [ty : AstType]) : bool
  (let
    [resolved : AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
    (cond
      [(tc-thread-spawn-i64-name? spawn-name)
        (match resolved
          [(AstTyI64) true]
          [_ false])]
      [(tc-thread-spawn-bool-name? spawn-name)
        (match resolved
          [(AstTyBool) true]
          [_ false])]
      [(tc-thread-spawn-unit-name? spawn-name)
        (match resolved
          [(AstTyUnit) true]
          [_ false])]
      [(tc-thread-spawn-string-name? spawn-name)
        (match resolved
          [(AstTyString) true]
          [_ false])]
      [(tc-thread-spawn-array-i64-name? spawn-name)
        (match resolved
          [(AstTyDynArray elem)
            (match (tc-type-strip-region
              (tc-resolve-type ctx (ty-node-get elem)))
              [(AstTyI64) true]
              [_ false])]
          [_ false])]
      [(tc-thread-spawn-box-i64-name? spawn-name)
        (match resolved
          [(AstTyBox elem)
            (match (tc-type-strip-region
              (tc-resolve-type ctx (ty-node-get elem)))
              [(AstTyI64) true]
              [_ false])]
          [_ false])]
      [else false])))

(define (tc-thread-safe-spawn-task-type?
  [ctx : TcContext]
  [spawn-name : String]
  [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstTyFunc task-params task-ret-box)
      (match (box-get task-params)
        [(AstTypeNil)
          (tc-thread-safe-spawn-task-ret-type?
            ctx
            spawn-name
            (ty-node-get task-ret-box))]
        [_ false])]
    [_ false]))

(define (tc-thread-safe-spawn-signature?
  [ctx : TcContext]
  [spawn-name : String]
  [params : AstTypeList]
  [ret : AstType]) : bool
  (and
    (tc-thread-safe-spawn-result-type? ctx spawn-name ret)
    (match params
      [(AstTypeCons task-param rest-box)
        (match (box-get rest-box)
          [(AstTypeNil)
            (tc-thread-safe-spawn-task-type?
              ctx
              spawn-name
              (ty-node-get task-param))]
          [_ false])]
      [_ false])))

(define (tc-thread-transfer-class-merge
  [left : TcThreadTransferClass]
  [right : TcThreadTransferClass]) : TcThreadTransferClass
  (match left
    [(TcThreadTransferRejected _) left]
    [(TcThreadTransferable)
      (match right
        [(TcThreadTransferRejected _) right]
        [_ (TcThreadTransferable)])]
    [(TcThreadShareable)
      (match right
        [(TcThreadTransferRejected _) right]
        [(TcThreadTransferable) (TcThreadTransferable)]
        [(TcThreadShareable) (TcThreadShareable)])]))

(define (tc-thread-transfer-reject [message : String]) : TcThreadTransferClass
  (TcThreadTransferRejected message))

(define (tc-thread-transfer-aggregate-class [class : TcThreadTransferClass]) : TcThreadTransferClass
  (match class
    [(TcThreadTransferRejected _) class]
    [_ (TcThreadTransferable)]))

(define (tc-thread-transfer-region-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "scoped-region and lifetime-parameterized values cannot cross thread boundaries"))

(define (tc-thread-transfer-reference-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "borrowed references cannot cross thread boundaries"))

(define (tc-thread-transfer-mut-reference-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "mutable references cannot cross thread boundaries"))

(define (tc-thread-transfer-raw-pointer-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "raw pointers cannot cross thread boundaries in safe code"))

(define (tc-thread-transfer-owned-heap-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "owned heap storage needs a static/program or spanning atomic owner proof"))

(define (tc-thread-transfer-cleanup-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "cleanup-required resources cannot cross thread boundaries"))

(define (tc-thread-transfer-type-list-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [types : AstTypeList]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (match types
    [(AstTypeNil) (TcThreadShareable)]
    [(AstTypeCons head rest)
      (let
        [head : AstType (ty-node-get head)]
        [rest : AstTypeList (box-get rest)]
        (tc-thread-transfer-class-merge
          (tc-thread-transfer-type-class ctx env head stack owner-proof)
          (tc-thread-transfer-type-list-class ctx env rest stack owner-proof)))]))

(define (tc-thread-transfer-field-list-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [fields : AstFieldDefList]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (match fields
    [(AstFieldDefNil) (TcThreadShareable)]
    [(AstFieldDefCons field rest)
      (let
        [rest : AstFieldDefList (box-get rest)]
        (match field
          [(AstFieldDef _ ty _)
            (tc-thread-transfer-class-merge
              (tc-thread-transfer-type-class ctx env ty stack owner-proof)
              (tc-thread-transfer-field-list-class
                ctx
                env
                rest
                stack
                owner-proof))]))]))

(define (tc-thread-transfer-variant-list-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [variants : AstVariantDefList]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (match variants
    [(AstVariantDefNil) (TcThreadShareable)]
    [(AstVariantDefCons variant rest)
      (let
        [rest : AstVariantDefList (box-get rest)]
        (match variant
          [(AstVariantDef _ payloads _)
            (tc-thread-transfer-class-merge
              (tc-thread-transfer-type-list-class
                ctx
                env
                payloads
                stack
                owner-proof)
              (tc-thread-transfer-variant-list-class
                ctx
                env
                rest
                stack
                owner-proof))]))]))

(define (tc-thread-transfer-struct-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (if (tc-string-list-contains stack struct-name)
    (tc-thread-transfer-reject
      (str-cat
        "recursive aggregate "
        struct-name
        " needs an explicit spanning owner proof"))
    (match (tc-struct-decl ctx struct-name)
      [(OkTcStructDecl decl)
        (match decl
          [(TcStructDecl _ cleanup fields)
            (if (ast-struct-cleanup? cleanup)
              (tc-thread-transfer-cleanup-reject)
              (tc-thread-transfer-aggregate-class
                (tc-thread-transfer-field-list-class
                  ctx
                  env
                  fields
                  (tc-string-list-add stack struct-name)
                  owner-proof)))])]
      [(ErrTcStructDecl message) (tc-thread-transfer-reject message)])))

(define (tc-thread-transfer-enum-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (if (tc-string-list-contains stack enum-name)
    (tc-thread-transfer-reject
      (str-cat
        "recursive aggregate "
        enum-name
        " needs an explicit spanning owner proof"))
    (match (tc-enum-decl ctx enum-name)
      [(OkTcEnumDecl decl)
        (match decl
          [(TcEnumDecl cleanup variants)
            (if (ast-enum-cleanup? cleanup)
              (tc-thread-transfer-cleanup-reject)
              (tc-thread-transfer-aggregate-class
                (tc-thread-transfer-variant-list-class
                  ctx
                  env
                  variants
                  (tc-string-list-add stack enum-name)
                  owner-proof)))])]
      [(ErrTcEnumDecl message) (tc-thread-transfer-reject message)])))

(define (tc-thread-transfer-type-class-with-stack
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : AstType]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (let
    [resolved : AstType (tc-resolve-type ctx ty)]
    (match resolved
      [(AstTyRegion region inner)
        (if (tc-atomic-arena-owner-active? env region)
          (tc-thread-transfer-type-class ctx env (ty-node-get inner) stack true)
          (tc-thread-transfer-region-reject))]
      [(AstTyRef _ _) (tc-thread-transfer-reference-reject)]
      [(AstTyMutRef _ _) (tc-thread-transfer-mut-reference-reject)]
      [(AstTyPtr _) (tc-thread-transfer-raw-pointer-reject)]
      [(AstTyMutPtr _) (tc-thread-transfer-raw-pointer-reject)]
      [(AstTyString)
        (if owner-proof
          (TcThreadShareable)
          (tc-thread-transfer-owned-heap-reject))]
      [(AstTyStr) (tc-thread-transfer-reference-reject)]
      [(AstTyBytes) (tc-thread-transfer-reference-reject)]
      [(AstTyDynArray elem)
        (if owner-proof
          (tc-thread-transfer-aggregate-class
            (tc-thread-transfer-type-class
              ctx
              env
              (ty-node-get elem)
              stack
              owner-proof))
          (tc-thread-transfer-owned-heap-reject))]
      [(AstTyBox elem)
        (if owner-proof
          (tc-thread-transfer-aggregate-class
            (tc-thread-transfer-type-class
              ctx
              env
              (ty-node-get elem)
              stack
              owner-proof))
          (tc-thread-transfer-owned-heap-reject))]
      [(AstTyTuple elems)
        (tc-thread-transfer-aggregate-class
          (tc-thread-transfer-type-list-class
            ctx
            env
            (box-get elems)
            stack
            owner-proof))]
      [(AstTyArray elem _)
        (tc-thread-transfer-aggregate-class
          (tc-thread-transfer-type-class
            ctx
            env
            (ty-node-get elem)
            stack
            owner-proof))]
      [(AstTyStruct name)
        (tc-thread-transfer-struct-class
          ctx
          env
          (intern-str name)
          stack
          owner-proof)]
      [(AstTyStructArgs name lifetimes)
        (if (> (tc-lifetime-list-count (box-get lifetimes)) 0)
          (tc-thread-transfer-region-reject)
          (tc-thread-transfer-struct-class
            ctx
            env
            (intern-str name)
            stack
            owner-proof))]
      [(AstTyEnum name)
        (tc-thread-transfer-enum-class
          ctx
          env
          (intern-str name)
          stack
          owner-proof)]
      [(AstTyEnumArgs name lifetimes)
        (if (> (tc-lifetime-list-count (box-get lifetimes)) 0)
          (tc-thread-transfer-region-reject)
          (tc-thread-transfer-enum-class
            ctx
            env
            (intern-str name)
            stack
            owner-proof))]
      [(AstTyFunc _ _)
        (tc-thread-transfer-reject
          "function value transfer requires a direct no-capture function symbol")]
      [(AstTyExpr)
        (tc-thread-transfer-reject
          "compile-time expression values cannot cross thread boundaries")]
      [(AstTyExprList)
        (tc-thread-transfer-reject
          "compile-time expression values cannot cross thread boundaries")]
      [(AstTyVar _)
        (tc-thread-transfer-reject
          "unresolved type variable cannot cross thread boundaries")]
      [(AstTyVarArgs _ _)
        (tc-thread-transfer-reject
          "unresolved lifetime-parameterized type cannot cross thread boundaries")]
      [_ (TcThreadShareable)])))

(define (tc-thread-transfer-type-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : AstType]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (tc-thread-transfer-type-class-with-stack ctx env ty stack owner-proof))

(define (tc-thread-transfer-classify-type [ctx : TcContext] [ty : AstType]) : TcThreadTransferClass
  (tc-thread-transfer-type-class ctx (tc-empty-env) ty TcStringNil false))

(define (tc-thread-transfer-classify-type-in-env
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : AstType]) : TcThreadTransferClass
  (tc-thread-transfer-type-class ctx env ty TcStringNil false))

(define (tc-thread-safe-spawn-capture-message
  [spawn-name : String]
  [ctx : TcContext]
  [name : String]
  [ty : AstType]
  [reason : String]) : String
  (str-cat
    "typecheck: "
    spawn-name
    " cannot capture `"
    name
    "` of type "
    (tc-type-render (tc-type-without-regions (tc-resolve-type ctx ty)))
    "; "
    reason))

(define (tc-check-thread-safe-spawn-captures-scan-root
  [spawn-name : String]
  [ctx : TcContext]
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [body : AstExpr]) : ResultTcUnit
  (match env
    [(TcTypeNil) OkTcUnit]
    [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-check-thread-safe-spawn-captures-scan-root
          spawn-name
          ctx
          root
          (box-get rest)
          bound
          body)
        OkTcUnit)]
    [(TcTypeBind key ty rest)
      (let
        [name : String (intern-str key)]
        (cond
          [(or
              (= key (tc-region-marker-id))
              (= key (tc-default-boundary-id))
              (tc-cleanup-owner-marker-entry? key ty)
              (tc-ordinary-arena-owner-marker-entry? key ty)
              (tc-atomic-arena-owner-marker-entry? key ty))
            (tc-check-thread-safe-spawn-captures-scan-root
              spawn-name
              ctx
              root
              (box-get rest)
              bound
              body)]
          [(not (tc-expr-uses-free-name? body name bound))
            (tc-check-thread-safe-spawn-captures-scan-root
              spawn-name
              ctx
              root
              (box-get rest)
              bound
              body)]
          [(tc-expr-sets-free-name? body name bound)
            (ErrTcUnit
              (str-cat
                "typecheck: "
                spawn-name
                " lambda cannot assign captured binding"))]
          [(tc-ordinary-arena-owner-active? root name)
            (ErrTcUnit
              (str-cat
                "typecheck: "
                spawn-name
                " cannot capture ordinary arena handle `"
                name
                "`; use arena-make-atomic for a spanning owner"))]
          [(tc-cleanup-owner-active? root name)
            (ErrTcUnit
              (str-cat
                "typecheck: "
                spawn-name
                " cannot capture cleanup-required resource"))]
          [else
            (match (tc-thread-transfer-classify-type-in-env ctx root ty)
              [(TcThreadTransferRejected reason)
                (ErrTcUnit
                  (tc-thread-safe-spawn-capture-message
                    spawn-name
                    ctx
                    name
                    ty
                    reason))]
              [_
                (tc-check-thread-safe-spawn-captures-scan-root
                  spawn-name
                  ctx
                  root
                  (box-get rest)
                  bound
                  body)])]))]))

(define (tc-check-thread-safe-spawn-captures
  [spawn-name : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]
  [body : AstExpr]) : ResultTcUnit
  (match env
    [(TcTypeCache _ _ _ _ _ _ _ rest _)
      (tc-check-thread-safe-spawn-captures-scan-root
        spawn-name
        ctx
        env
        (box-get rest)
        (tc-param-bound-names params)
        body)]
    [_
      (tc-check-thread-safe-spawn-captures-scan-root
        spawn-name
        ctx
        env
        env
        (tc-param-bound-names params)
        body)]))

(define (tc-check-thread-safe-spawn-direct-lambda-arg
  [spawn-name : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : AstExpr]) : ResultTcUnit
  (match (ast-expr-unspan arg)
    [(AstExprLambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda params _ body-box)
          (match params
            [(AstParamNil)
              (tc-check-thread-safe-spawn-captures
                spawn-name
                ctx
                env
                params
                (ast-node-get body-box))]
            [_
              (ErrTcUnit
                (str-cat
                  "typecheck: "
                  spawn-name
                  " requires a direct nullary lambda argument so captures can be checked"))])])]
    [_
      (ErrTcUnit
        (str-cat
          "typecheck: "
          spawn-name
          " requires a direct nullary lambda argument so captures can be checked"))]))

(define (tc-check-thread-safe-spawn-direct-lambda
  [spawn-name : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : AstExpr]) : ResultTcUnit
  (match (tc-active-region env)
    [(TcSomeString region)
      (if (tc-atomic-arena-owner-active? env region)
        (tc-check-thread-safe-spawn-direct-lambda-arg spawn-name ctx env arg)
        (ErrTcUnit
          (str-cat
            "typecheck: "
            spawn-name
            " cannot spawn from scoped arena; closure storage would not outlive the worker")))]
    [(TcNoString)
      (tc-check-thread-safe-spawn-direct-lambda-arg spawn-name ctx env arg)]))

(define (tc-check-thread-spawn-i64-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]
  [ret : AstType]) : ResultTcUnit
  (match (tc-thread-safe-spawn-call-name func)
    [(TcSomeString spawn-name)
      (if (tc-thread-safe-spawn-signature? ctx spawn-name params ret)
        (match args
          [(AstExprCons arg rest)
            (match (box-get rest)
              [(AstExprNil)
                (tc-check-thread-safe-spawn-direct-lambda
                  spawn-name
                  ctx
                  env
                  (ast-node-get arg))]
              [_
                (ErrTcUnit
                  (str-cat "typecheck: " spawn-name " expects one argument"))])]
          [(AstExprNil)
            (ErrTcUnit
              (str-cat "typecheck: " spawn-name " expects one argument"))])
        OkTcUnit)]
    [(TcNoString) OkTcUnit]))

(define (tc-thread-channel-send-message
  [send-name : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [message-ty : AstType]) : ResultTcUnit
  (match (tc-thread-transfer-classify-type-in-env ctx env message-ty)
    [(TcThreadTransferRejected reason)
      (ErrTcUnit
        (str-cat
          "typecheck: "
          send-name
          " cannot send value of type "
          (tc-type-render
            (tc-type-without-regions (tc-resolve-type ctx message-ty)))
          "; "
          reason))]
    [_ OkTcUnit]))

(define (tc-check-thread-channel-send-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]
  [ret : AstType]) : ResultTcUnit
  (match (tc-thread-channel-send-call-name func)
    [(TcSomeString send-name)
      (if (tc-thread-channel-send-result-type? ctx ret)
        (match (tc-thread-channel-send-message-param params)
          [(OkTcType _)
            (match (tc-thread-channel-send-message-arg args)
              [(OkTcExpr message-expr)
                (match (tc-expr ctx env message-expr)
                  [(OkTcType message-ty)
                    (tc-thread-channel-send-message
                      send-name
                      ctx
                      env
                      message-ty)]
                  [(ErrTcType message) (ErrTcUnit message)])]
              [(ErrTcExpr message) (ErrTcUnit message)])]
          [(ErrTcType message) (ErrTcUnit message)])
        OkTcUnit)]
    [(TcNoString) OkTcUnit]))

(define (tc-thread-channel-send-function-result?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]) : bool
  (match (tc-expr ctx env func)
    [(OkTcType fn-ty)
      (match (tc-type-strip-region fn-ty)
        [(AstTyFunc _ ret-box)
          (tc-thread-channel-send-result-type? ctx (ty-node-get ret-box))]
        [_ false])]
    [(ErrTcType _) false]))

(define (tc-thread-channel-send-call?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]) : bool
  (match (tc-thread-channel-send-call-name func)
    [(TcSomeString _) (tc-thread-channel-send-function-result? ctx env func)]
    [(TcNoString) false]))

(define (tc-call-function-type-normal
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]
  [ret : AstType]
  [c-abi-args : bool]) : ResultTcType
  (let
    [allow-region-args : bool
      (tc-call-region-args-allowed-for-func ctx env func)]
    (if (tc-call-lifetime-constructor-for-func? ctx func ret)
      (tc-call-lifetime-constructor-type
        ctx
        env
        func
        args
        params
        ret
        allow-region-args)
      (let
        [constructor-target : AstMaybeType
          (tc-call-constructor-target-for-func ctx env func params ret)]
        (match constructor-target
          [(AstSomeType _)
            (match (tc-check-call-args
              ctx
              env
              args
              params
              allow-region-args
              constructor-target
              c-abi-args)
              [(OkTcUnit)
                (match constructor-target
                  [(AstSomeType target) (OkTcType target)]
                  [(AstNoType) (OkTcType (tc-tag-active-region env ret))])]
              [(ErrTcUnit message) (ErrTcType message)])]
          [(AstNoType)
            (let
              [lifetimes : AstLifetimeList
                (tc-call-function-lifetimes params ret)]
              (match lifetimes
                [(AstLifetimeNil)
                  (match (tc-check-call-args-with-message
                    ctx
                    env
                    args
                    params
                    allow-region-args
                    constructor-target
                    (TcArityDetailed func args params)
                    c-abi-args)
                    [(OkTcUnit)
                      (match (tc-check-thread-spawn-i64-call
                        ctx
                        env
                        func
                        args
                        params
                        ret)
                        [(OkTcUnit)
                          (match (tc-check-thread-channel-send-call
                            ctx
                            env
                            func
                            args
                            params
                            ret)
                            [(OkTcUnit)
                              (OkTcType (tc-tag-active-region env ret))]
                            [(ErrTcUnit message) (ErrTcType message)])]
                        [(ErrTcUnit message) (ErrTcType message)])]
                    [(ErrTcUnit message) (ErrTcType message)])]
                [_
                  (tc-call-lifetime-function-type
                    ctx
                    env
                    args
                    params
                    ret
                    lifetimes
                    allow-region-args
                    c-abi-args)]))])))))

(define (tc-check-call-args-with-message
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [params : AstTypeList]
  [allow-region-args : bool]
  [constructor-target : AstMaybeType]
  [arity-msg : TcArityMessage]
  [c-abi-args : bool]) : ResultTcUnit
  (match args
    [(AstExprNil)
      (match params
        [(AstTypeNil) OkTcUnit]
        [_ (ErrTcUnit (tc-arity-message-text arity-msg))])]
    [(AstExprCons arg rest-args)
      (let
        [arg : AstExpr (ast-node-get arg)]
        [rest-args : AstExprList (box-get rest-args)]
        (match params
          [(AstTypeCons want rest-params)
            (let
              [want : AstType (ty-node-get want)]
              [rest-params : AstTypeList (box-get rest-params)]
              (match (tc-call-effective-arg-expr ctx env arg want)
                [(OkTcExpr effective-arg)
                  (let
                    [typed-arg : ResultTcType
                      (match constructor-target
                        [(AstNoType)
                          (tc-expr-with-expected-or-actual-call-arg
                            ctx
                            env
                            effective-arg
                            want)]
                        [(AstSomeType _)
                          (tc-expr-with-expected-or-actual
                            ctx
                            env
                            effective-arg
                            want)])]
                    (match typed-arg
                      [(OkTcType got)
                        (match (tc-expect-at-expr
                          arg
                          got
                          want
                          "typecheck: argument type mismatch")
                          [(OkTcUnit)
                            (match (tc-raw-c-fnptr-flow-ok
                              ctx
                              env
                              effective-arg
                              want
                              c-abi-args)
                              [(OkTcUnit)
                                (if (and
                                  (tc-type-contains-any-region got)
                                  (not allow-region-args)
                                  (not
                                    (tc-type-regions-all-atomic-arena-owners?
                                      env
                                      got))
                                  (not (tc-type-contains-reference? got)))
                                  (ErrTcUnit
                                    "typecheck: cannot pass region-tagged value to function parameter; region value would escape")
                                  (match constructor-target
                                    [(AstSomeType target)
                                      (match (tc-ensure-cleanup-resource-not-stored-expr
                                        env
                                        effective-arg)
                                        [(OkTcUnit)
                                          (match (tc-ensure-region-value-can-flow-into
                                            env
                                            target
                                            got
                                            "constructor result")
                                            [(OkTcUnit)
                                              (tc-check-call-args-with-message
                                                ctx
                                                env
                                                rest-args
                                                rest-params
                                                allow-region-args
                                                constructor-target
                                                arity-msg
                                                c-abi-args)]
                                            [(ErrTcUnit message)
                                              (ErrTcUnit message)])]
                                        [(ErrTcUnit message)
                                          (ErrTcUnit message)])]
                                    [(AstNoType)
                                      (tc-check-call-args-with-message
                                        ctx
                                        env
                                        rest-args
                                        rest-params
                                        allow-region-args
                                        constructor-target
                                        arity-msg
                                        c-abi-args)]))]
                              [(ErrTcUnit message) (ErrTcUnit message)])]
                          [(ErrTcUnit message) (ErrTcUnit message)])]
                      [(ErrTcType message) (ErrTcUnit message)]))]
                [(ErrTcExpr message)
                  (ErrTcUnit (tc-locate-error-at-expr arg message))]))]
          [(AstTypeNil) (ErrTcUnit (tc-arity-message-text arity-msg))]))]))

(define (tc-check-call-args
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [params : AstTypeList]
  [allow-region-args : bool]
  [constructor-target : AstMaybeType]
  [c-abi-args : bool]) : ResultTcUnit
  (tc-check-call-args-with-message
    ctx
    env
    args
    params
    allow-region-args
    constructor-target
    (TcArityLiteral)
    c-abi-args))

(define (tc-check-args
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [params : AstTypeList]) : ResultTcUnit
  (match args
    [(AstExprNil)
      (match params
        [(AstTypeNil) OkTcUnit]
        [_ (ErrTcUnit "typecheck: arity mismatch")])]
    [(AstExprCons arg rest-args)
      (let
        [arg : AstExpr (ast-node-get arg)]
        [rest-args : AstExprList (box-get rest-args)]
        (match params
          [(AstTypeCons want rest-params)
            (let
              [want : AstType (ty-node-get want)]
              [rest-params : AstTypeList (box-get rest-params)]
              (match (tc-expr-with-expected-or-actual ctx env arg want)
                [(OkTcType got)
                  (match (tc-expect-at-expr
                    arg
                    got
                    want
                    "typecheck: argument type mismatch")
                    [(OkTcUnit) (tc-check-args ctx env rest-args rest-params)]
                    [(ErrTcUnit message) (ErrTcUnit message)])]
                [(ErrTcType message) (ErrTcUnit message)]))]
          [(AstTypeNil) (ErrTcUnit "typecheck: arity mismatch")]))]))

(define (tc-call-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]) : ResultTcType
  (match (ast-expr-unspan func)
    [(AstExprLambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda params maybe-ret body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-lambda-expr-allow-ref-captures
              ctx
              env
              params
              maybe-ret
              body)
              [(OkTcType fn-ty)
                (match fn-ty
                  [(AstTyFunc params ret)
                    (tc-call-function-type
                      ctx
                      env
                      func
                      args
                      (box-get params)
                      (ty-node-get ret))]
                  [_ (ErrTcType "typecheck: call target is not a function")])]
              [(ErrTcType message) (ErrTcType message)]))])]
    [_
      (match (tc-expr ctx env func)
        [(OkTcType fn-ty)
          (match fn-ty
            [(AstTyFunc params ret)
              (tc-call-function-type
                ctx
                env
                func
                args
                (box-get params)
                (ty-node-get ret))]
            [(AstTyRegion _ inner)
              (match (ty-node-get inner)
                [(AstTyFunc params ret)
                  (match (tc-check-call-args-with-message
                    ctx
                    env
                    args
                    (box-get params)
                    false
                    (AstNoType)
                    (TcArityDetailed func args (box-get params))
                    (tc-expr-c-abi-fnptr? ctx env func))
                    [(OkTcUnit)
                      (OkTcType (tc-tag-active-region env (ty-node-get ret)))]
                    [(ErrTcUnit message) (ErrTcType message)])]
                [(AstTyEnum enum-name)
                  (match args
                    [(AstExprNil)
                      (tc-nullary-variant-call-expr
                        ctx
                        env
                        func
                        (intern-str enum-name)
                        (ty-node-get inner))]
                    [_ (ErrTcType "typecheck: arity mismatch")])]
                [(AstTyEnumArgs enum-name _)
                  (match args
                    [(AstExprNil)
                      (tc-nullary-variant-call-expr
                        ctx
                        env
                        func
                        (intern-str enum-name)
                        (ty-node-get inner))]
                    [_ (ErrTcType "typecheck: arity mismatch")])]
                [_ (ErrTcType "typecheck: call target is not a function")])]
            [(AstTyEnum enum-name)
              (match args
                [(AstExprNil)
                  (tc-nullary-variant-call-expr
                    ctx
                    env
                    func
                    (intern-str enum-name)
                    fn-ty)]
                [_ (ErrTcType "typecheck: arity mismatch")])]
            [(AstTyEnumArgs enum-name _)
              (match args
                [(AstExprNil)
                  (tc-nullary-variant-call-expr
                    ctx
                    env
                    func
                    (intern-str enum-name)
                    fn-ty)]
                [_ (ErrTcType "typecheck: arity mismatch")])]
            [_ (ErrTcType "typecheck: call target is not a function")])]
        [(ErrTcType message) (ErrTcType message)])]))

;; Whether `name` resolves to any binding in `env` (a builtin, a top-level
;; user definition, or a local). Used to decide whether an unbound builtin
;; name like `string-ref`/`char-at` should be treated as the String-index
;; builtin (unbound) or as an ordinary direct call to a shadowing user
;; definition (bound). Mirrors the host compiler's shadowing check (#677).
(define (tc-name-bound? [env : TcTypeEnv] [name : String]) : bool
  (tc-name-bound-id? env (tc-name-id name)))

(define (tc-str-ref-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyRef _ inner)
      (match (tc-type-strip-region (ty-node-get inner))
        [(AstTyStr) true]
        [_ false])]
    [_ false]))

(define (tc-string-handle-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyString) true]
    [_ (tc-str-ref-type? ty)]))

(define (tc-bytes-ref-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyRef _ inner)
      (match (tc-type-strip-region (ty-node-get inner))
        [(AstTyBytes) true]
        [_ false])]
    [(AstTyMutRef _ inner)
      (match (tc-type-strip-region (ty-node-get inner))
        [(AstTyBytes) true]
        [_ false])]
    [_ false]))

(define (tc-bytes-handle-type? [ty : AstType]) : bool
  (tc-bytes-ref-type? ty))

(define (tc-length-handle-type? [ty : AstType]) : bool
  (or (tc-string-handle-type? ty) (tc-bytes-handle-type? ty)))

(define (tc-check-string-handle-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : AstExpr]
  [message : String]) : ResultTcUnit
  (match (tc-expr ctx env arg)
    [(OkTcType arg-ty)
      (if (tc-string-handle-type? arg-ty)
        OkTcUnit
        (ErrTcUnit (tc-locate-error-at-expr arg message)))]
    [(ErrTcType message) (ErrTcUnit message)]))

(define (tc-check-exact-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : AstExpr]
  [want : AstType]
  [message : String]) : ResultTcUnit
  (match (tc-expr-with-expected-or-actual ctx env arg want)
    [(OkTcType arg-ty) (tc-expect-at-expr arg arg-ty want message)]
    [(ErrTcType message) (ErrTcUnit message)]))

(define (tc-one-string-handle-builtin-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [ret : AstType]) : ResultTcType
  (match args
    [(AstExprCons arg tail)
      (let
        [arg : AstExpr (ast-node-get arg)]
        [tail : AstExprList (box-get tail)]
        (match tail
          [(AstExprNil)
            (match (tc-check-string-handle-arg
              ctx
              env
              arg
              "typecheck: argument type mismatch")
              [(OkTcUnit) (OkTcType (tc-tag-active-region env ret))]
              [(ErrTcUnit message) (ErrTcType message)])]
          [_ (ErrTcType "typecheck: arity mismatch")]))]
    [_ (ErrTcType "typecheck: arity mismatch")]))

(define (tc-two-string-handle-builtin-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [ret : AstType]) : ResultTcType
  (match args
    [(AstExprCons left tail)
      (let
        [left : AstExpr (ast-node-get left)]
        [tail : AstExprList (box-get tail)]
        (match tail
          [(AstExprCons right rest)
            (let
              [right : AstExpr (ast-node-get right)]
              [rest : AstExprList (box-get rest)]
              (match rest
                [(AstExprNil)
                  (match (tc-check-string-handle-arg
                    ctx
                    env
                    left
                    "typecheck: argument type mismatch")
                    [(OkTcUnit)
                      (match (tc-check-string-handle-arg
                        ctx
                        env
                        right
                        "typecheck: argument type mismatch")
                        [(OkTcUnit) (OkTcType (tc-tag-active-region env ret))]
                        [(ErrTcUnit message) (ErrTcType message)])]
                    [(ErrTcUnit message) (ErrTcType message)])]
                [_ (ErrTcType "typecheck: arity mismatch")]))]
          [_ (ErrTcType "typecheck: arity mismatch")]))]
    [_ (ErrTcType "typecheck: arity mismatch")]))

(define (tc-string-i64-i64-builtin-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [ret : AstType]) : ResultTcType
  (match args
    [(AstExprCons text tail)
      (let
        [text : AstExpr (ast-node-get text)]
        [tail : AstExprList (box-get tail)]
        (match tail
          [(AstExprCons start rest1)
            (let
              [start : AstExpr (ast-node-get start)]
              [rest1 : AstExprList (box-get rest1)]
              (match rest1
                [(AstExprCons len rest2)
                  (let
                    [len : AstExpr (ast-node-get len)]
                    [rest2 : AstExprList (box-get rest2)]
                    (match rest2
                      [(AstExprNil)
                        (match (tc-check-string-handle-arg
                          ctx
                          env
                          text
                          "typecheck: argument type mismatch")
                          [(OkTcUnit)
                            (match (tc-check-exact-arg
                              ctx
                              env
                              start
                              (AstTyI64)
                              "typecheck: argument type mismatch")
                              [(OkTcUnit)
                                (match (tc-check-exact-arg
                                  ctx
                                  env
                                  len
                                  (AstTyI64)
                                  "typecheck: argument type mismatch")
                                  [(OkTcUnit)
                                    (OkTcType (tc-tag-active-region env ret))]
                                  [(ErrTcUnit message) (ErrTcType message)])]
                              [(ErrTcUnit message) (ErrTcType message)])]
                          [(ErrTcUnit message) (ErrTcType message)])]
                      [_ (ErrTcType "typecheck: arity mismatch")]))]
                [_ (ErrTcType "typecheck: arity mismatch")]))]
          [_ (ErrTcType "typecheck: arity mismatch")]))]
    [_ (ErrTcType "typecheck: arity mismatch")]))

(define (tc-string-i64-builtin-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [ret : AstType]) : ResultTcType
  (match args
    [(AstExprCons text tail)
      (let
        [text : AstExpr (ast-node-get text)]
        [tail : AstExprList (box-get tail)]
        (match tail
          [(AstExprCons value rest)
            (let
              [value : AstExpr (ast-node-get value)]
              [rest : AstExprList (box-get rest)]
              (match rest
                [(AstExprNil)
                  (match (tc-check-string-handle-arg
                    ctx
                    env
                    text
                    "typecheck: argument type mismatch")
                    [(OkTcUnit)
                      (match (tc-check-exact-arg
                        ctx
                        env
                        value
                        (AstTyI64)
                        "typecheck: argument type mismatch")
                        [(OkTcUnit) (OkTcType (tc-tag-active-region env ret))]
                        [(ErrTcUnit message) (ErrTcType message)])]
                    [(ErrTcUnit message) (ErrTcType message)])]
                [_ (ErrTcType "typecheck: arity mismatch")]))]
          [_ (ErrTcType "typecheck: arity mismatch")]))]
    [_ (ErrTcType "typecheck: arity mismatch")]))

(define (tc-i64-string-builtin-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [ret : AstType]) : ResultTcType
  (match args
    [(AstExprCons value tail)
      (let
        [value : AstExpr (ast-node-get value)]
        [tail : AstExprList (box-get tail)]
        (match tail
          [(AstExprCons text rest)
            (let
              [text : AstExpr (ast-node-get text)]
              [rest : AstExprList (box-get rest)]
              (match rest
                [(AstExprNil)
                  (match (tc-check-exact-arg
                    ctx
                    env
                    value
                    (AstTyI64)
                    "typecheck: argument type mismatch")
                    [(OkTcUnit)
                      (match (tc-check-string-handle-arg
                        ctx
                        env
                        text
                        "typecheck: argument type mismatch")
                        [(OkTcUnit) (OkTcType (tc-tag-active-region env ret))]
                        [(ErrTcUnit message) (ErrTcType message)])]
                    [(ErrTcUnit message) (ErrTcType message)])]
                [_ (ErrTcType "typecheck: arity mismatch")]))]
          [_ (ErrTcType "typecheck: arity mismatch")]))]
    [_ (ErrTcType "typecheck: arity mismatch")]))

(define (tc-borrowed-string-builtin-name? [name : String]) : bool
  (compiler-builtin-typecheck-borrowed-string-id? (tc-builtin-name-id name)))

(define (tc-borrowed-string-builtin-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [args : AstExprList]) : ResultTcType
  (let
    [name-id : i64 (tc-builtin-name-id name)]
    (if (compiler-builtin-typecheck-string-eq-id? name-id)
      (tc-two-string-handle-builtin-call ctx env args (AstTyBool))
      (if (compiler-builtin-typecheck-string-to-int-id? name-id)
        (tc-one-string-handle-builtin-call ctx env args (AstTyI64))
        (ErrTcType "typecheck: unknown borrowed string builtin")))))

;; Typecheck the *unshadowed* `(string-ref s i)` / `(char-at s i)` builtin: a
;; String plus any integer index, yielding `char`. The parser emits this as an
;; ordinary `Call`; when `string-ref`/`char-at` is not bound to a user function
;; or local, recover the builtin String-index behavior (and its exact
;; diagnostics) here rather than via the generic call path (#677).
(define (tc-string-ref-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]) : ResultTcType
  (match args
    [(AstExprCons str tail)
      (let
        [str : AstExpr (ast-node-get str)]
        [tail : AstExprList (box-get tail)]
        (match tail
          [(AstExprCons index rest)
            (let
              [index : AstExpr (ast-node-get index)]
              [rest : AstExprList (box-get rest)]
              (match rest
                [(AstExprNil)
                  (match (tc-expr ctx env str)
                    [(OkTcType str-ty)
                      (if (tc-string-handle-type? str-ty)
                        (match (tc-expr ctx env index)
                          [(OkTcType index-ty)
                            (if (tc-integer-type? index-ty)
                              (OkTcType (AstTyChar))
                              (ErrTcType
                                "typecheck: string index must be integer"))]
                          [(ErrTcType message) (ErrTcType message)])
                        (ErrTcType "typecheck: string-ref requires String"))]
                    [(ErrTcType message) (ErrTcType message)])]
                [_ (ErrTcType "typecheck: arity mismatch")]))]
          [_ (ErrTcType "typecheck: arity mismatch")]))]
    [_ (ErrTcType "typecheck: arity mismatch")]))

(define (tc-length-string-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [func : AstExpr]
  [args : AstExprList]
  [arg-ty : AstType]) : ResultTcType
  (if (and
    (tc-default-builtin-unshadowed? env name)
    (tc-length-handle-type? arg-ty))
    (OkTcType (AstTyI64))
    (if (compiler-builtin-typecheck-string-length-id? (tc-builtin-name-id name))
      (if (tc-default-builtin-unshadowed? env name)
        (ErrTcType "typecheck: argument type mismatch")
        (tc-call-expr ctx env func args))
      (tc-call-expr ctx env func args))))

(define (tc-array-length-non-array-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [func : AstExpr]
  [args : AstExprList]
  [arg-ty : AstType]) : ResultTcType
  (if (compiler-builtin-typecheck-array-length-id? (tc-builtin-name-id name))
    (ErrTcType "typecheck: array-length requires dynamic array")
    (tc-length-string-call ctx env name func args arg-ty)))

(define (tc-array-length-array-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [func : AstExpr]
  [args : AstExprList]) : ResultTcType
  (if (compiler-builtin-typecheck-string-length-id? (tc-builtin-name-id name))
    (if (tc-default-builtin-unshadowed? env name)
      (ErrTcType "typecheck: argument type mismatch")
      (tc-call-expr ctx env func args))
    (OkTcType (AstTyI64))))

(define (tc-array-length-receiver [ctx : TcContext] [receiver-ty : AstType]) : ResultTcArrayReceiver
  (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
    [(AstTyDynArray elem-ty)
      (OkTcArrayReceiver (TcArrayReceiver receiver-ty (ty-node-get elem-ty)))]
    [(AstTyRef _ referent-ty)
      (tc-array-length-receiver ctx (ty-node-get referent-ty))]
    [(AstTyMutRef _ referent-ty)
      (tc-array-length-receiver ctx (ty-node-get referent-ty))]
    [_ (ErrTcArrayReceiver "typecheck: array-length requires dynamic array")]))

;; `array-length` remains dynamic-array-only. `length` and `string-length` keep
;; their legacy owned-String path while also accepting explicit borrowed `str`
;; handles for the unshadowed default builtin.
(define (tc-array-length-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [func : AstExpr]
  [args : AstExprList]) : ResultTcType
  (match args
    [(AstExprCons arg rest)
      (let
        [arg : AstExpr (ast-node-get arg)]
        [rest : AstExprList (box-get rest)]
        (match rest
          [(AstExprNil)
            (match (tc-expr ctx env arg)
              [(OkTcType arg-ty)
                (match (tc-array-length-receiver ctx arg-ty)
                  [(OkTcArrayReceiver _)
                    (tc-array-length-array-call ctx env name func args)]
                  [(ErrTcArrayReceiver _)
                    (tc-array-length-non-array-call
                      ctx
                      env
                      name
                      func
                      args
                      arg-ty)])]
              [(ErrTcType message) (ErrTcType message)])]
          [_
            (if (compiler-builtin-typecheck-array-length-id?
              (tc-builtin-name-id name))
              (ErrTcType "typecheck: arity mismatch")
              (tc-call-expr ctx env func args))]))]
    [_
      (if (compiler-builtin-typecheck-array-length-id?
        (tc-builtin-name-id name))
        (ErrTcType "typecheck: arity mismatch")
        (tc-call-expr ctx env func args))]))

(define (tc-layout-query-name? [name : String]) : bool
  (if (string-eq name "size-of")
    true
    (if (string-eq name "align-of")
      true
      (string-eq name "offset-of"))))

;; Layout queries are CTFE-only. Inside `(comptime ...)` the typechecker gets the
;; folded value from `compiler-ctfe-eval`; if an unshadowed query reaches normal
;; expression typing, it is a runtime use and must be rejected.
(define (tc-one-arg-layout-query-runtime-call
  [name : String]
  [args : AstExprList]) : ResultTcType
  (match args
    [(AstExprCons _ rest)
      (let
        [rest : AstExprList (box-get rest)]
        (match rest
          [(AstExprNil)
            (ErrTcType
              (string-append
                "typecheck: "
                (string-append
                  name
                  " is compile-time only; wrap it in (comptime ...)")))]
          [_
            (ErrTcType
              (string-append
                "typecheck: "
                (string-append name " expects exactly one type argument")))]))]
    [_
      (ErrTcType
        (string-append
          "typecheck: "
          (string-append name " expects exactly one type argument")))]))

(define (tc-offset-layout-query-runtime-call [args : AstExprList]) : ResultTcType
  (match args
    [(AstExprCons _ tail)
      (let
        [tail : AstExprList (box-get tail)]
        (match tail
          [(AstExprCons _ rest)
            (let
              [rest : AstExprList (box-get rest)]
              (match rest
                [(AstExprNil)
                  (ErrTcType
                    "typecheck: offset-of is compile-time only; wrap it in (comptime ...)")]
                [_
                  (ErrTcType
                    "typecheck: offset-of expects exactly one type argument and one field name")]))]
          [_
            (ErrTcType
              "typecheck: offset-of expects exactly one type argument and one field name")]))]
    [_
      (ErrTcType
        "typecheck: offset-of expects exactly one type argument and one field name")]))

(define (tc-layout-query-runtime-call [name : String] [args : AstExprList]) : ResultTcType
  (if (string-eq name "offset-of")
    (tc-offset-layout-query-runtime-call args)
    (tc-one-arg-layout-query-runtime-call name args)))

(define (tc-reflection-query-runtime-call [name : String]) : ResultTcType
  (ErrTcType
    (string-append
      "typecheck: "
      (string-append name " is compile-time only; wrap it in (comptime ...)"))))

;; The clone-able type set is a whole-program fixpoint (O(types*fields) plus a
;; type-name map build). It is invariant across a compile, but `tc-clone-able-
;; type?` is invoked once per `(clone ...)` / `with-escape` body in the program,
;; so recomputing it each time was a large repeated cost. Cache it per compile:
;; populated eagerly in the typecheck entry (program arena, so the cached map
;; never dangles into a scratch arena) and reset per compile in macro-expand-
;; program / the REPL entry. When not yet populated (e.g. REPL one-shot checks)
;; the set is rebuilt without caching, preserving correctness.
(define tc-clone-able-cache-ready : bool
  false)
(define tc-clone-able-cache : CloneNameSet
  (clone-name-set-empty))

(define (tc-clone-able-cache-reset!) : unit
  (set! tc-clone-able-cache-ready false))

(define (tc-clone-able-set-build [ctx : TcContext]) : CloneNameSet
  (match (tc-context-program ctx)
    [(AstProgram decls-box)
      (let
        [decls : AstDeclList (box-get decls-box)]
        (clone-fixpoint
          decls
          (clone-all-type-names decls (clone-name-set-empty))))]))

(define (tc-clone-able-cache-populate! [ctx : TcContext]) : unit
  (begin
    (set! tc-clone-able-cache (tc-clone-able-set-build ctx))
    (set! tc-clone-able-cache-ready true)))

(define (tc-clone-able-set [ctx : TcContext]) : CloneNameSet
  (if tc-clone-able-cache-ready
    tc-clone-able-cache
    (tc-clone-able-set-build ctx)))

(define (tc-clone-able-type? [ctx : TcContext] [ty : AstType]) : bool
  (clone-field-type-able?
    (tc-type-without-regions (tc-resolve-type ctx ty))
    (tc-clone-able-set ctx)))

;; `(clone x)` deep-copies x into the current arena (#1633). Type-directed: the
;; result is the argument's type, stripped of any inner-region tag (the copy
;; lands in the enclosing arena, not the source's region). Unsupported types are
;; rejected here so no heap-backed value silently lowers as a shallow handle copy.
(define (tc-clone-call [ctx : TcContext] [env : TcTypeEnv] [args : AstExprList]) : ResultTcType
  (match args
    [(AstExprCons arg tail)
      (let
        [arg : AstExpr (ast-node-get arg)]
        [tail : AstExprList (box-get tail)]
        (match tail
          [(AstExprNil)
            (match (tc-expr ctx env arg)
              [(OkTcType arg-ty)
                (let
                  [clone-ty : AstType (tc-type-without-regions arg-ty)]
                  (if (tc-clone-able-type? ctx clone-ty)
                    (OkTcType clone-ty)
                    (ErrTcType
                      (string-append
                        "typecheck: clone unsupported type "
                        (tc-type-render
                          (tc-type-without-regions (tc-resolve-type ctx arg-ty)))))))]
              [(ErrTcType message) (ErrTcType message)])]
          [_ (ErrTcType "typecheck: clone expects exactly one argument")]))]
    [_ (ErrTcType "typecheck: clone expects exactly one argument")]))

(define (tc-call-or-array-length
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]) : ResultTcType
  (match (ast-expr-unspan func)
    [(AstExprVar raw-name)
      ;; A builtin called from a macro expansion arrives hygiene-renamed
      ;; (`__tl_macro_global$string-length`), which would miss the literal-name
      ;; checks below and fall through to the strict registered signature. Strip
      ;; the hygiene-global prefix so macro-generated builtin calls dispatch
      ;; exactly like hand-written ones; `func` keeps the original name for the
      ;; ordinary call/resolution paths.
      (let
        [name : String (tc-hygiene-global-call-name (intern-str raw-name))]
        [name-id : i64 (tc-builtin-name-id name)]
        (cond
          [(and (tc-layout-query-name? name) (not (tc-name-bound? env name)))
            (tc-layout-query-runtime-call name args)]
          [(compiler-builtin-typecheck-length-call-id? name-id)
            (tc-array-length-call ctx env name func args)]
          [(and
              (compiler-builtin-typecheck-string-ref-call-id? name-id)
              (not (tc-name-bound? env name)))
            (tc-string-ref-call ctx env args)]
          [(and (tc-atomic-pointer-name? name) (not (tc-name-bound? env name)))
            (tc-atomic-pointer-call ctx env name args)]
          [(and
              (tc-borrowed-string-builtin-name? name)
              (tc-default-builtin-unshadowed? env name))
            (tc-borrowed-string-builtin-call ctx env name args)]
          [(and
              (ctfe-reflection-query-name? name)
              (not (tc-name-bound? env name)))
            (tc-reflection-query-runtime-call name)]
          [(and
              (compiler-builtin-typecheck-clone-id? name-id)
              (not (tc-name-bound? env name)))
            (tc-clone-call ctx env args)]
          [else (tc-call-expr ctx env func args)]))]
    [_ (tc-call-expr ctx env func args)]))

(define (tc-let-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : AstLetBindingList]) : ResultTcEnv
  (match bindings
    [(AstLetBindingNil) (OkTcEnv env)]
    [(AstLetBindingCons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding name maybe-ty init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (match maybe-ty
                [(AstSomeType want)
                  (let
                    [resolved-want : AstType (tc-resolve-type ctx want)]
                    (match (tc-expr-with-expected-or-actual
                      ctx
                      env
                      init
                      resolved-want)
                      [(OkTcType init-ty)
                        (match (tc-expect
                          init-ty
                          resolved-want
                          "typecheck: let binding type mismatch")
                          [(OkTcUnit)
                            (match (tc-ensure-cleanup-resource-not-let-bound
                              ctx
                              env
                              init
                              init-ty)
                              [(OkTcUnit)
                                (match (tc-ensure-reference-value-can-bind
                                  env
                                  init-ty)
                                  [(OkTcUnit)
                                    (tc-let-bindings
                                      ctx
                                      (let
                                        [binding-ty : AstType
                                          (if (tc-type-contains-any-region
                                            init-ty)
                                            init-ty
                                            resolved-want)]
                                        (tc-bind-c-abi-fnptr-if-needed-id
                                          ctx
                                          env
                                          name
                                          binding-ty
                                          init))
                                      rest)]
                                  [(ErrTcUnit message) (ErrTcEnv message)])]
                              [(ErrTcUnit message) (ErrTcEnv message)])]
                          [(ErrTcUnit message) (ErrTcEnv message)])]
                      [(ErrTcType message) (ErrTcEnv message)]))]
                [(AstNoType)
                  (match (tc-expr ctx env init)
                    [(OkTcType init-ty)
                      (match (tc-ensure-cleanup-resource-not-let-bound
                        ctx
                        env
                        init
                        init-ty)
                        [(OkTcUnit)
                          (match (tc-ensure-reference-value-can-bind
                            env
                            init-ty)
                            [(OkTcUnit)
                              (tc-let-bindings
                                ctx
                                (tc-bind-c-abi-fnptr-if-needed-id
                                  ctx
                                  env
                                  name
                                  init-ty
                                  init)
                                rest)]
                            [(ErrTcUnit message) (ErrTcEnv message)])]
                        [(ErrTcUnit message) (ErrTcEnv message)])]
                    [(ErrTcType message) (ErrTcEnv message)])]))]))]))

(define (tc-lambda-captures-reference-scan-root
  [env : TcTypeEnv]
  [bound : TcStringList]
  [body : AstExpr]) : bool
  (match env
    [(TcTypeNil) false]
    [(TcTypeCache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-lambda-captures-reference-scan-root (box-get rest) bound body)
        false)]
    [(TcTypeBind key ty rest)
      (if (or
        (= key (tc-region-marker-id))
        (= key (tc-default-boundary-id))
        (tc-cleanup-owner-marker-entry? key ty))
        (tc-lambda-captures-reference-scan-root (box-get rest) bound body)
        (if (and
          (tc-expr-uses-free-name? body (intern-str key) bound)
          (tc-type-contains-reference? ty))
          true
          (tc-lambda-captures-reference-scan-root (box-get rest) bound body)))]))

(define (tc-lambda-captures-reference?
  [env : TcTypeEnv]
  [params : AstParamList]
  [body : AstExpr]) : bool
  (match env
    [(TcTypeCache _ _ _ _ _ _ _ rest _)
      (tc-lambda-captures-reference-scan-root
        (box-get rest)
        (tc-param-bound-names params)
        body)]
    [_
      (tc-lambda-captures-reference-scan-root
        env
        (tc-param-bound-names params)
        body)]))

(define (tc-ref-capturing-lambda-init? [env : TcTypeEnv] [init : AstExpr]) : bool
  (match (ast-expr-unspan init)
    [(AstExprLambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda params _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (tc-lambda-captures-reference? env params body))])]
    [_ false]))

(define (tc-ref-closure-expr-list-local-uses-ok?
  [exprs : AstExprList]
  [name : String]
  [bound : TcStringList]) : bool
  (match exprs
    [(AstExprNil) true]
    [(AstExprCons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (and
          (tc-ref-closure-local-uses-ok? expr name bound)
          (tc-ref-closure-expr-list-local-uses-ok? rest name bound)))]))

(define (tc-ref-closure-let-binding-list-local-uses-ok?
  [bindings : AstLetBindingList]
  [name : String]
  [bound : TcStringList]) : bool
  (match bindings
    [(AstLetBindingNil) true]
    [(AstLetBindingCons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding bind-name _ init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (and
                (tc-ref-closure-local-uses-ok? init name bound)
                (tc-ref-closure-let-binding-list-local-uses-ok?
                  rest
                  name
                  (tc-string-list-add bound (intern-str bind-name)))))]))]))

(define (tc-ref-closure-let-rest-and-body-local-uses-ok?
  [bindings : AstLetBindingList]
  [body : AstExpr]
  [name : String]
  [bound : TcStringList]) : bool
  (match bindings
    [(AstLetBindingNil) (tc-ref-closure-local-uses-ok? body name bound)]
    [(AstLetBindingCons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding bind-name _ init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (and
                (tc-ref-closure-local-uses-ok? init name bound)
                (tc-ref-closure-let-rest-and-body-local-uses-ok?
                  rest
                  body
                  name
                  (tc-string-list-add bound (intern-str bind-name)))))]))]))

(define (tc-ref-closure-resource-binding-list-local-uses-ok?
  [bindings : AstResourceBindingList]
  [name : String]
  [bound : TcStringList]) : bool
  (match bindings
    [(AstResourceBindingNil) true]
    [(AstResourceBindingCons binding rest)
      (let
        [rest : AstResourceBindingList (box-get rest)]
        (match binding
          [(AstResourceBinding bind-name init-box cleanup-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              [cleanup : AstExpr (ast-node-get cleanup-box)]
              (and
                (tc-ref-closure-local-uses-ok? init name bound)
                (tc-ref-closure-local-uses-ok? cleanup name bound)
                (tc-ref-closure-resource-binding-list-local-uses-ok?
                  rest
                  name
                  (tc-string-list-add bound (intern-str bind-name)))))]))]))

(define (tc-ref-closure-match-arms-local-uses-ok?
  [arms : AstMatchArmList]
  [name : String]
  [bound : TcStringList]) : bool
  (match arms
    [(AstMatchArmNil) true]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm pattern body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (and
                (tc-ref-closure-local-uses-ok?
                  body
                  name
                  (tc-pattern-add-bound-names pattern bound))
                (tc-ref-closure-match-arms-local-uses-ok? rest name bound)))]))]))

(define (tc-ref-closure-direct-call?
  [func : AstExpr]
  [name : String]
  [bound : TcStringList]) : bool
  (match (ast-expr-unspan func)
    [(AstExprVar var-name)
      (and
        (string-eq (intern-str var-name) name)
        (not (tc-string-list-contains bound name)))]
    [_ false]))

(define (tc-ref-closure-local-uses-ok?
  [expr : AstExpr]
  [name : String]
  [bound : TcStringList]) : bool
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExprVar var-name)
      (not
        (and
          (string-eq (intern-str var-name) name)
          (not (tc-string-list-contains bound name))))]
    [(AstExprBinary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (and
          (tc-ref-closure-local-uses-ok? left name bound)
          (tc-ref-closure-local-uses-ok? right name bound)))]
    [(AstExprUnary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExprCall func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (if (tc-ref-closure-direct-call? func name bound)
          (tc-ref-closure-expr-list-local-uses-ok? args name bound)
          (and
            (tc-ref-closure-local-uses-ok? func name bound)
            (tc-ref-closure-expr-list-local-uses-ok? args name bound))))]
    [(AstExprBracketClause items)
      (tc-ref-closure-expr-list-local-uses-ok? items name bound)]
    [(AstExprIf cond-box then-box else-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-box)]
        [else-branch : AstExpr (ast-node-get else-box)]
        (and
          (tc-ref-closure-local-uses-ok? cond name bound)
          (tc-ref-closure-local-uses-ok? then-branch name bound)
          (tc-ref-closure-local-uses-ok? else-branch name bound)))]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (and
              (tc-ref-closure-let-binding-list-local-uses-ok?
                bindings
                name
                bound)
              (tc-ref-closure-local-uses-ok?
                body
                name
                (tc-let-binding-list-add-bound-names bindings bound))))])]
    [(AstExprLambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda params _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (not
              (tc-expr-uses-free-name?
                body
                name
                (tc-param-list-add-bound-names params bound))))])]
    [(AstExprTuple exprs)
      (tc-ref-closure-expr-list-local-uses-ok? exprs name bound)]
    [(AstExprTupleRef tuple-box _)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        (tc-ref-closure-local-uses-ok? tuple name bound))]
    [(AstExprArray exprs)
      (tc-ref-closure-expr-list-local-uses-ok? exprs name bound)]
    [(AstExprMakeArray _ len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (tc-ref-closure-local-uses-ok? len name bound))]
    [(AstExprArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (and
          (tc-ref-closure-local-uses-ok? array name bound)
          (tc-ref-closure-local-uses-ok? index name bound)))]
    [(AstExprArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (and
          (tc-ref-closure-local-uses-ok? array name bound)
          (tc-ref-closure-local-uses-ok? index name bound)
          (tc-ref-closure-local-uses-ok? value name bound)))]
    [(AstExprArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (and
          (tc-ref-closure-local-uses-ok? array name bound)
          (tc-ref-closure-local-uses-ok? value name bound)))]
    [(AstExprStringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (and
          (tc-ref-closure-local-uses-ok? str name bound)
          (tc-ref-closure-local-uses-ok? index name bound)))]
    [(AstExprWhile cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (and
          (tc-ref-closure-local-uses-ok? cond name bound)
          (tc-ref-closure-local-uses-ok? body name bound)))]
    [(AstExprBegin exprs)
      (tc-ref-closure-expr-list-local-uses-ok? exprs name bound)]
    [(AstExprUnsafe exprs)
      (tc-ref-closure-expr-list-local-uses-ok? exprs name bound)]
    [(AstExprSet var-name value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (and
          (not
            (and
              (string-eq (intern-str var-name) name)
              (not (tc-string-list-contains bound name))))
          (tc-ref-closure-local-uses-ok? value name bound)))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExprBorrow _ _ place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (tc-ref-closure-local-uses-ok? place name bound))]
    [(AstExprBox inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExprBoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExprBoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExprBoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (and
          (tc-ref-closure-local-uses-ok? inner name bound)
          (tc-ref-closure-local-uses-ok? value name bound)))]
    [(AstExprMatch match-box)
      (match (box-get match-box)
        [(AstMatch scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            (and
              (tc-ref-closure-local-uses-ok? scrutinee name bound)
              (tc-ref-closure-match-arms-local-uses-ok? arms name bound)))])]
    [(AstExprForeach fe-box)
      (match (box-get fe-box)
        [(AstForeach index _ start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (and
              (tc-ref-closure-local-uses-ok? start name bound)
              (tc-ref-closure-local-uses-ok? end name bound)
              (tc-ref-closure-local-uses-ok?
                body
                name
                (tc-string-list-add bound (intern-str index)))))])]
    [(AstExprSpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce _ index _ start-box end-box init-box value-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            (and
              (tc-ref-closure-local-uses-ok? start name bound)
              (tc-ref-closure-local-uses-ok? end name bound)
              (tc-ref-closure-local-uses-ok? init name bound)
              (tc-ref-closure-local-uses-ok?
                value
                name
                (tc-string-list-add bound (intern-str index)))))])]
    [(AstExprSpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan
            _
            index
            _
            start-box
            end-box
            prefix
            _
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            [index-bound : TcStringList
              (tc-string-list-add bound (intern-str index))]
            [body-bound : TcStringList
              (tc-string-list-add index-bound (intern-str prefix))]
            (and
              (tc-ref-closure-local-uses-ok? start name bound)
              (tc-ref-closure-local-uses-ok? end name bound)
              (tc-ref-closure-local-uses-ok? init name bound)
              (tc-ref-closure-local-uses-ok? value name index-bound)
              (tc-ref-closure-local-uses-ok? body name body-bound)))])]
    [(AstExprSpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (and
          (tc-ref-closure-local-uses-ok? value name bound)
          (tc-ref-closure-local-uses-ok? lane name bound)))]
    [(AstExprStructGet receiver-box _)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (tc-ref-closure-local-uses-ok? receiver name bound))]
    [(AstExprStructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (and
          (tc-ref-closure-local-uses-ok? receiver name bound)
          (tc-ref-closure-local-uses-ok? value name bound)))]
    [(AstExprWithRegion _ body)
      (tc-ref-closure-expr-list-local-uses-ok? body name bound)]
    [(AstExprWithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (and
          (tc-ref-closure-local-uses-ok? scratch name bound)
          (tc-ref-closure-expr-list-local-uses-ok? body name bound)))]
    [(AstExprWithScratch body)
      (tc-ref-closure-expr-list-local-uses-ok? body name bound)]
    [(AstExprInArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (and
          (tc-ref-closure-local-uses-ok? arena name bound)
          (tc-ref-closure-expr-list-local-uses-ok? body name bound)))]
    [(AstExprWithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource bindings body)
          (and
            (tc-ref-closure-resource-binding-list-local-uses-ok?
              bindings
              name
              bound)
            (tc-ref-closure-expr-list-local-uses-ok?
              body
              name
              (tc-resource-binding-list-add-bound-names bindings bound)))])]
    [(AstExprComptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExprQuote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExprQuasiquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExprUnquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExprUnquoteSplicing inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExprTry inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExprReturn inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExprPtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExprPtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-ref-closure-local-uses-ok? ptr name bound))]
    [(AstExprPtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (and
          (tc-ref-closure-local-uses-ok? ptr name bound)
          (tc-ref-closure-local-uses-ok? value name bound)))]
    [(AstExprPtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (and
          (tc-ref-closure-local-uses-ok? ptr name bound)
          (tc-ref-closure-local-uses-ok? offset name bound)))]
    [(AstExprPtrCast ptr-box _)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-ref-closure-local-uses-ok? ptr name bound))]
    [(AstExprPtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-ref-closure-local-uses-ok? ptr name bound))]
    [(AstExprIntToPtr value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-ref-closure-local-uses-ok? value name bound))]
    [(AstExprStringData str-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        (tc-ref-closure-local-uses-ok? str name bound))]
    [(AstExprStringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (and
          (tc-ref-closure-local-uses-ok? ptr name bound)
          (tc-ref-closure-local-uses-ok? len name bound)))]
    [(AstExprArrayData array-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-ref-closure-local-uses-ok? array name bound))]
    [(AstExprBinaryData _) true]
    [(AstExprSpmdProgramIndex) true]
    [(AstExprSpmdProgramCount) true]
    [(AstExprCpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (and
          (tc-ref-closure-local-uses-ok? leaf name bound)
          (tc-ref-closure-local-uses-ok? subleaf name bound)))]
    [(AstExprCpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (and
          (tc-ref-closure-local-uses-ok? leaf name bound)
          (tc-ref-closure-local-uses-ok? subleaf name bound)))]
    [(AstExprCpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (and
          (tc-ref-closure-local-uses-ok? leaf name bound)
          (tc-ref-closure-local-uses-ok? subleaf name bound)))]
    [(AstExprCpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (and
          (tc-ref-closure-local-uses-ok? leaf name bound)
          (tc-ref-closure-local-uses-ok? subleaf name bound)))]
    [(AstExprXgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (tc-ref-closure-local-uses-ok? index name bound))]
    [(AstExprSyscall args)
      (tc-ref-closure-expr-list-local-uses-ok? args name bound)]
    [_ (not (tc-expr-uses-free-name? expr name bound))]))

(define (tc-reference-closure-escape-message) : String
  "typecheck: reference-capturing closure value would escape lexical scope")

(define (tc-let-binding-ref-closure-scope-ok
  [rest : AstLetBindingList]
  [body : AstExpr]
  [name : String]) : ResultTcUnit
  (if (tc-ref-closure-let-rest-and-body-local-uses-ok?
    rest
    body
    name
    TcStringNil)
    OkTcUnit
    (ErrTcUnit (tc-reference-closure-escape-message))))

;; --------------------------------------------------------------------------
;; Inferred-type hint collection (used by the LSP for inlay hints).
;;
;; Disabled by default so normal and bootstrap compiles are byte-for-byte
;; unaffected. When enabled, the typechecker records the rendered inferred type
;; and 1-based source position of each un-annotated `let` binding value. A ring
;; buffer keeps the most recent records, so the entry document (whose decls are
;; checked last) is always retained even when imported modules are re-checked.
;; Records are not file-attributed; the LSP filters them against the open
;; document's text before turning them into hints.
;; --------------------------------------------------------------------------
(define tc-inlay-hint-capacity : i64
  65536)
(define tc-inlay-hint-enabled : bool
  false)
(define tc-inlay-hint-count : i64
  0)
(define tc-inlay-hint-lines : (Array i64)
  (make-array i64 65536))
(define tc-inlay-hint-cols : (Array i64)
  (make-array i64 65536))
(define tc-inlay-hint-types : (Array String)
  (make-array String 65536))

(define (tc-inlay-hints-enable!) : unit
  (begin
    (set! tc-inlay-hint-count 0)
    (set! tc-inlay-hint-enabled true)))

(define (tc-inlay-hints-disable!) : unit
  (set! tc-inlay-hint-enabled false))

(define (tc-inlay-hints-size) : i64
  (if (< tc-inlay-hint-count tc-inlay-hint-capacity)
    tc-inlay-hint-count
    tc-inlay-hint-capacity))

(define (tc-inlay-hint-line-at [i : i64]) : i64
  (array-ref tc-inlay-hint-lines i))

(define (tc-inlay-hint-col-at [i : i64]) : i64
  (array-ref tc-inlay-hint-cols i))

(define (tc-inlay-hint-type-at [i : i64]) : String
  (array-ref tc-inlay-hint-types i))

(define (tc-inlay-hint-record! [line : i64] [col : i64] [ty : String]) : unit
  (let
    [slot : i64 (% tc-inlay-hint-count tc-inlay-hint-capacity)]
    (begin
      (array-set! tc-inlay-hint-lines slot line)
      (array-set! tc-inlay-hint-cols slot col)
      (array-set! tc-inlay-hint-types slot ty)
      (set! tc-inlay-hint-count (+ tc-inlay-hint-count 1)))))

;; Record the inferred type of an un-annotated let binding value, if collection
;; is enabled and the value expression carries a source span.
;; Caller guards on tc-inlay-hint-enabled so the disabled path never calls this
;; (keeping the per-binding cost in normal compiles to a single flag check).
(define (tc-inlay-hint-maybe-record
  [maybe-ty : AstMaybeType]
  [init : AstExpr]
  [init-ty : AstType]) : unit
  (match maybe-ty
    [(AstNoType)
      (match init
        [(AstExprSpanned _ span)
          (tc-inlay-hint-record!
            (struct-get span start-line)
            (struct-get span start-col)
            (tc-type-render init-ty))]
        [_ unit])]
    [(AstSomeType _) unit]))

(define (tc-let-binding-init-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [maybe-ty : AstMaybeType]
  [init : AstExpr]
  [rest : AstLetBindingList]
  [body : AstExpr]) : ResultTcType
  (let
    [ref-capturing-lambda : bool (tc-ref-capturing-lambda-init? env init)]
    (match maybe-ty
      [(AstSomeType want)
        (let
          [resolved-want : AstType (tc-resolve-type ctx want)]
          (if ref-capturing-lambda
            (match (tc-let-binding-ref-closure-scope-ok rest body name)
              [(OkTcUnit)
                (match (ast-expr-unspan init)
                  [(AstExprLambda lambda-box)
                    (match (box-get lambda-box)
                      [(AstLambda params maybe-ret lambda-body-box)
                        (let
                          [lambda-body : AstExpr (ast-node-get lambda-body-box)]
                          (tc-lambda-expr-allow-ref-captures
                            ctx
                            env
                            params
                            maybe-ret
                            lambda-body))])]
                  [_
                    (tc-expr-with-expected-or-actual ctx env init resolved-want)])]
              [(ErrTcUnit message) (ErrTcType message)])
            (tc-expr-with-expected-or-actual ctx env init resolved-want)))]
      [(AstNoType)
        (if ref-capturing-lambda
          (match (tc-let-binding-ref-closure-scope-ok rest body name)
            [(OkTcUnit)
              (match (ast-expr-unspan init)
                [(AstExprLambda lambda-box)
                  (match (box-get lambda-box)
                    [(AstLambda params maybe-ret lambda-body-box)
                      (let
                        [lambda-body : AstExpr (ast-node-get lambda-body-box)]
                        (tc-lambda-expr-allow-ref-captures
                          ctx
                          env
                          params
                          maybe-ret
                          lambda-body))])]
                [_ (tc-expr ctx env init)])]
            [(ErrTcUnit message) (ErrTcType message)])
          (tc-expr ctx env init))])))

(define (tc-let-bindings-for-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : AstLetBindingList]
  [body : AstExpr]) : ResultTcEnv
  (match bindings
    [(AstLetBindingNil) (OkTcEnv env)]
    [(AstLetBindingCons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding name maybe-ty init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (match (tc-let-binding-init-type
                ctx
                env
                (intern-str name)
                maybe-ty
                init
                rest
                body)
                [(OkTcType init-ty)
                  (begin
                    (if tc-inlay-hint-enabled
                      (tc-inlay-hint-maybe-record maybe-ty init init-ty)
                      unit)
                    (match maybe-ty
                      [(AstSomeType want)
                        (let
                          [resolved-want : AstType (tc-resolve-type ctx want)]
                          (match (tc-expect
                            init-ty
                            resolved-want
                            "typecheck: let binding type mismatch")
                            [(OkTcUnit)
                              (match (tc-ensure-cleanup-resource-not-let-bound
                                ctx
                                env
                                init
                                init-ty)
                                [(OkTcUnit)
                                  (match (tc-ensure-reference-value-can-bind
                                    env
                                    init-ty)
                                    [(OkTcUnit)
                                      (tc-let-bindings-for-body
                                        ctx
                                        (let
                                          [binding-ty : AstType
                                            (if (tc-type-contains-any-region
                                              init-ty)
                                              init-ty
                                              resolved-want)]
                                          (tc-bind-c-abi-fnptr-if-needed-id
                                            ctx
                                            env
                                            name
                                            binding-ty
                                            init))
                                        rest
                                        body)]
                                    [(ErrTcUnit message) (ErrTcEnv message)])]
                                [(ErrTcUnit message) (ErrTcEnv message)])]
                            [(ErrTcUnit message) (ErrTcEnv message)]))]
                      [(AstNoType)
                        (match (tc-ensure-cleanup-resource-not-let-bound
                          ctx
                          env
                          init
                          init-ty)
                          [(OkTcUnit)
                            (match (tc-ensure-reference-value-can-bind
                              env
                              init-ty)
                              [(OkTcUnit)
                                (tc-let-bindings-for-body
                                  ctx
                                  (tc-bind-c-abi-fnptr-if-needed-id
                                    ctx
                                    env
                                    name
                                    init-ty
                                    init)
                                  rest
                                  body)]
                              [(ErrTcUnit message) (ErrTcEnv message)])]
                          [(ErrTcUnit message) (ErrTcEnv message)])]))]
                [(ErrTcType message) (ErrTcEnv message)]))]))]))

(define (tc-resource-cleanup-direct-name-ok [cleanup : AstExpr]) : ResultTcUnit
  (match (ast-expr-unspan cleanup)
    [(AstExprVar _) OkTcUnit]
    [_ (ErrTcUnit "typecheck: with cleanup must be a direct function name")]))

(define (tc-resource-cleanup-resource-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [cleanup : AstExpr]) : ResultTcType
  (match (tc-resource-cleanup-direct-name-ok cleanup)
    [(OkTcUnit)
      (match (tc-expr ctx env cleanup)
        [(OkTcType cleanup-ty)
          (match (tc-type-strip-region (tc-resolve-type ctx cleanup-ty))
            [(AstTyFunc args ret)
              (let
                [ret-ty : AstType (ty-node-get ret)]
                (match (box-get args)
                  [(AstTypeCons arg rest)
                    (let
                      [arg-ty : AstType (ty-node-get arg)]
                      [rest : AstTypeList (box-get rest)]
                      (match rest
                        [(AstTypeNil)
                          (if (tc-type-eq ret-ty (AstTyUnit))
                            (OkTcType arg-ty)
                            (ErrTcType
                              "typecheck: with cleanup function type mismatch"))]
                        [_
                          (ErrTcType
                            "typecheck: with cleanup function type mismatch")]))]
                  [_
                    (ErrTcType "typecheck: with cleanup function type mismatch")]))]
            [_ (ErrTcType "typecheck: with cleanup function type mismatch")])]
        [(ErrTcType message) (ErrTcType message)])]
    [(ErrTcUnit message) (ErrTcType message)]))

(define (tc-resource-cleanup-ok
  [ctx : TcContext]
  [env : TcTypeEnv]
  [cleanup : AstExpr]
  [resource-ty : AstType]) : ResultTcUnit
  (match (tc-resource-cleanup-resource-type ctx env cleanup)
    [(OkTcType cleanup-resource-ty)
      (tc-expect
        cleanup-resource-ty
        (tc-type-without-regions resource-ty)
        "typecheck: with cleanup function type mismatch")]
    [(ErrTcType message) (ErrTcUnit message)]))

(define (tc-resource-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : AstResourceBindingList]) : ResultTcEnv
  (match bindings
    [(AstResourceBindingNil) (OkTcEnv env)]
    [(AstResourceBindingCons binding rest)
      (let
        [rest : AstResourceBindingList (box-get rest)]
        (match binding
          [(AstResourceBinding name init-box cleanup-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              [cleanup : AstExpr (ast-node-get cleanup-box)]
              (match (tc-resource-cleanup-resource-type ctx env cleanup)
                [(OkTcType expected-init-ty)
                  (match (tc-expr-with-expected-or-actual
                    ctx
                    env
                    init
                    expected-init-ty)
                    [(OkTcType init-ty)
                      (match (tc-ensure-cleanup-resource-not-transferred
                        env
                        init)
                        [(OkTcUnit)
                          (match (tc-resource-cleanup-ok
                            ctx
                            env
                            cleanup
                            init-ty)
                            [(OkTcUnit)
                              (tc-resource-bindings
                                ctx
                                (tc-bind-id
                                  (tc-bind-cleanup-owner env (intern-str name))
                                  name
                                  (tc-type-without-regions init-ty))
                                rest)]
                            [(ErrTcUnit message) (ErrTcEnv message)])]
                        [(ErrTcUnit message) (ErrTcEnv message)])]
                    [(ErrTcType message) (ErrTcEnv message)])]
                [(ErrTcType message) (ErrTcEnv message)]))]))]))

(define (tc-begin-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]) : ResultTcType
  (match exprs
    [(AstExprNil) (OkTcType (AstTyUnit))]
    [(AstExprCons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (match rest
          [(AstExprNil) (tc-expr ctx env expr)]
          [_
            (match (tc-expr ctx env expr)
              [(OkTcType _) (tc-begin-list ctx env rest)]
              [(ErrTcType message) (ErrTcType message)])]))]))

(define (tc-spmd-require-uniform [class : TcSpmdClass] [message : String]) : ResultTcUnit
  (if (tc-spmd-varying? class)
    (ErrTcUnit message)
    OkTcUnit))

(define (tc-spmd-inline-helper-empty-stack) : TcStringList
  TcStringNil)

(define tc-spmd-inline-helper-stack : TcStringList
  (tc-spmd-inline-helper-empty-stack))

(define (tc-spmd-inline-helper-stack-reset!) : unit
  (set! tc-spmd-inline-helper-stack (tc-spmd-inline-helper-empty-stack)))

(define (tc-spmd-inline-helper-recursive-message) : String
  "typecheck: recursive SPMD inline helper call is not supported")

(define (tc-spmd-inline-helper-resolve-name
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [func : AstExpr]) : ResultTcString
  (match (ast-expr-unspan func)
    [(AstExprVar raw-name)
      (let
        [raw-text : String (intern-str raw-name)]
        (cond
          [(tc-spmd-env-has-local? spmd-env raw-text) (ErrTcString "")]
          [(tc-hygiene-global-name? raw-text)
            (OkTcString (tc-hygiene-global-call-name raw-text))]
          [(tc-name-qualified? raw-text) (OkTcString raw-text)]
          [else (tc-source-name-lookup-key ctx env raw-text)]))]
    [_ (ErrTcString "")]))

(define (tc-spmd-inline-helper-from-decl [name : String] [decl : AstDecl]) : ResultTcSpmdInlineHelper
  (match decl
    [(AstDeclDefFn _ params ret body-box _)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (OkTcSpmdInlineHelper (TcSpmdSomeInlineHelper name params ret body)))]
    [(AstDeclUnsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (tc-spmd-inline-helper-from-decl name inner))]
    [(AstDeclComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (tc-spmd-inline-helper-from-decl name template))]
    [_ (OkTcSpmdInlineHelper (TcSpmdNoInlineHelper))]))

(define (tc-spmd-inline-helper-lookup
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [func : AstExpr]) : ResultTcSpmdInlineHelper
  (match (tc-spmd-inline-helper-resolve-name ctx env spmd-env func)
    [(OkTcString lookup-name)
      (if (string-eq lookup-name "")
        (OkTcSpmdInlineHelper (TcSpmdNoInlineHelper))
        (if (tc-string-list-contains tc-spmd-inline-helper-stack lookup-name)
          (ErrTcSpmdInlineHelper (tc-spmd-inline-helper-recursive-message))
          (match (compiler-symbols-lookup-value
            (tc-context-symbols ctx)
            lookup-name)
            [(SomeI64 handle)
              (if (=
                (compiler-symbol-handle-kind handle)
                (compiler-symbol-kind-function-define))
                (match (compiler-symbols-decl-at-index
                  (tc-context-symbols ctx)
                  (compiler-symbol-handle-index handle))
                  [(OkAstDecl decl)
                    (tc-spmd-inline-helper-from-decl lookup-name decl)]
                  [(ErrAstDecl message) (ErrTcSpmdInlineHelper message)])
                (OkTcSpmdInlineHelper (TcSpmdNoInlineHelper)))]
            [(NoneI64) (OkTcSpmdInlineHelper (TcSpmdNoInlineHelper))])))]
    [(ErrTcString message)
      (if (string-eq message "")
        (OkTcSpmdInlineHelper (TcSpmdNoInlineHelper))
        (ErrTcSpmdInlineHelper message))]))

(define (tc-spmd-inline-helper-module [ctx : TcContext] [name : String]) : String
  (if (tc-name-qualified? name)
    (tc-qualified-name-module name)
    (tc-context-module ctx)))

(define (tc-spmd-inline-helper-env
  [ctx : TcContext]
  [fallback : TcTypeEnv]
  [module : String]) : TcTypeEnv
  (match (tc-hygiene-definition-env ctx module)
    [(OkTcEnv helper-env) helper-env]
    [(ErrTcEnv _) fallback]))

(define (tc-spmd-inline-helper-bind-args
  [ctx : TcContext]
  [caller-env : TcTypeEnv]
  [caller-spmd-env : TcSpmdEnv]
  [helper-ctx : TcContext]
  [helper-env : TcTypeEnv]
  [helper-spmd-env : TcSpmdEnv]
  [params : AstParamList]
  [args : AstExprList]
  [seen-class : TcSpmdClass]) : ResultTcSpmdInlineCallState
  (match params
    [(AstParamNil)
      (match args
        [(AstExprNil)
          (OkTcSpmdInlineCallState
            (TcSpmdInlineCallState
              caller-spmd-env
              helper-env
              helper-spmd-env
              seen-class))]
        [_ (ErrTcSpmdInlineCallState "typecheck: arity mismatch")])]
    [(AstParamCons param rest-params)
      (let
        [rest-params : AstParamList (box-get rest-params)]
        (match args
          [(AstExprCons arg rest-args)
            (let
              [arg : AstExpr (ast-node-get arg)]
              [rest-args : AstExprList (box-get rest-args)]
              (match (tc-spmd-expr ctx caller-env caller-spmd-env arg)
                [(OkTcSpmdExprInfo arg-info)
                  (match arg-info
                    [(TcSpmdExprInfo _ arg-class next-caller-spmd-env)
                      (match param
                        [(AstParam param-name param-ty _)
                          (let
                            [bound-ty : AstType
                              (tc-resolve-type helper-ctx param-ty)]
                            (if (and
                              (tc-spmd-varying? arg-class)
                              (not
                                (tc-spmd-varying-value-type-supported? bound-ty)))
                              (ErrTcSpmdInlineCallState
                                (string-append
                                  "typecheck: SPMD inline helper varying parameter type is not supported: "
                                  (tc-type-render
                                    (tc-type-strip-region bound-ty))))
                              (tc-spmd-inline-helper-bind-args
                                ctx
                                caller-env
                                next-caller-spmd-env
                                helper-ctx
                                (tc-bind-id helper-env param-name bound-ty)
                                (tc-spmd-env-bind
                                  helper-spmd-env
                                  (intern-str param-name)
                                  bound-ty
                                  arg-class
                                  TcSpmdLocal)
                                rest-params
                                rest-args
                                (tc-spmd-merge-class seen-class arg-class))))])])]
                [(ErrTcSpmdExprInfo message) (ErrTcSpmdInlineCallState message)]))]
          [(AstExprNil) (ErrTcSpmdInlineCallState "typecheck: arity mismatch")]))]))

(define (tc-spmd-inline-helper-body
  [ctx : TcContext]
  [helper-env : TcTypeEnv]
  [helper-spmd-env : TcSpmdEnv]
  [name : String]
  [body : AstExpr]) : ResultTcSpmdExprInfo
  (let
    [previous : TcStringList tc-spmd-inline-helper-stack]
    [result : ResultTcSpmdExprInfo
      (ErrTcSpmdExprInfo (tc-spmd-inline-helper-recursive-message))]
    (begin
      (set! tc-spmd-inline-helper-stack (tc-string-list-add previous name))
      (set! result (tc-spmd-expr ctx helper-env helper-spmd-env body))
      (set! tc-spmd-inline-helper-stack previous)
      result)))

(define (tc-spmd-call-uniform-only
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : AstType]
  [func : AstExpr]
  [args : AstExprList]) : ResultTcSpmdExprInfo
  (match (tc-spmd-expr ctx env spmd-env func)
    [(OkTcSpmdExprInfo func-info)
      (match func-info
        [(TcSpmdExprInfo _ _ func-env)
          (match (tc-spmd-expr-list ctx env func-env args)
            [(OkTcSpmdExprListInfo args-info)
              (match args-info
                [(TcSpmdExprListInfo args-class args-env)
                  (match (tc-spmd-require-uniform
                    args-class
                    "typecheck: foreach calls with varying arguments are not supported")
                    [(OkTcUnit) (tc-spmd-finish expr-ty TcSpmdUniform args-env)]
                    [(ErrTcUnit message) (ErrTcSpmdExprInfo message)])])]
            [(ErrTcSpmdExprListInfo message) (ErrTcSpmdExprInfo message)])])]
    [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)]))

(define (tc-spmd-atomic-public-symbol? [symbol : String]) : bool
  (or
    (string-eq symbol "tl_atomic_i64_load")
    (string-eq symbol "tl_atomic_i64_store")
    (string-eq symbol "tl_atomic_i64_add")
    (string-eq symbol "tl_atomic_i64_fetch_add")
    (string-eq symbol "tl_atomic_i32_load")
    (string-eq symbol "tl_atomic_i32_store")
    (string-eq symbol "tl_atomic_i32_add")
    (string-eq symbol "tl_atomic_i32_fetch_add")))

(define (tc-spmd-atomic-public-name? [name : String]) : bool
  (or
    (string-eq name "atomic-i64-load")
    (string-eq name "atomic-i64-store!")
    (string-eq name "atomic-i64-add!")
    (string-eq name "atomic-i64-fetch-add!")
    (string-eq name "atomic-i32-load")
    (string-eq name "atomic-i32-store!")
    (string-eq name "atomic-i32-add!")
    (string-eq name "atomic-i32-fetch-add!")))

(define (tc-spmd-atomic-name-candidate? [name : String]) : bool
  (or
    (tc-spmd-atomic-public-name? name)
    (tc-spmd-atomic-public-symbol? name)
    (and
      (tc-name-qualified? name)
      (tc-spmd-atomic-public-name? (tc-qualified-name-base name)))))

(define (tc-spmd-atomic-symbol-for-name [name : String]) : String
  (cond
    [(string-eq name "atomic-i64-load") "tl_atomic_i64_load"]
    [(string-eq name "atomic-i64-store!") "tl_atomic_i64_store"]
    [(string-eq name "atomic-i64-add!") "tl_atomic_i64_add"]
    [(string-eq name "atomic-i64-fetch-add!") "tl_atomic_i64_fetch_add"]
    [(string-eq name "atomic-i32-load") "tl_atomic_i32_load"]
    [(string-eq name "atomic-i32-store!") "tl_atomic_i32_store"]
    [(string-eq name "atomic-i32-add!") "tl_atomic_i32_add"]
    [(string-eq name "atomic-i32-fetch-add!") "tl_atomic_i32_fetch_add"]
    [else ""]))

(define (tc-spmd-atomic-import-path? [path : String]) : bool
  (or (string-eq path "stdlib/atomic.tl") (string-eq path "atomic.tl")))

(define (tc-spmd-program-imports-atomic? [decls : AstDeclList]) : bool
  (match decls
    [(AstDeclNil) false]
    [(AstDeclCons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDeclImport (AstImportSpec _ path _ _ _))
            (or
              (tc-spmd-atomic-import-path? path)
              (tc-spmd-program-imports-atomic? rest))]
          [_ (tc-spmd-program-imports-atomic? rest)]))]))

(define (tc-spmd-context-imports-atomic? [ctx : TcContext]) : bool
  (match ctx
    [(TcContext program _ _ _)
      (match program
        [(AstProgram decls-box)
          (tc-spmd-program-imports-atomic? (box-get decls-box))])]))

(define (tc-spmd-atomic-imported-symbol-for-name
  [ctx : TcContext]
  [name : String]) : TcMaybeString
  (if (and
    (tc-spmd-atomic-public-name? name)
    (tc-spmd-context-imports-atomic? ctx))
    (TcSomeString (tc-spmd-atomic-symbol-for-name name))
    (TcNoString)))

(define (tc-spmd-atomic-value-result? [symbol : String]) : bool
  (or
    (string-eq symbol "tl_atomic_i64_load")
    (string-eq symbol "tl_atomic_i64_fetch_add")
    (string-eq symbol "tl_atomic_i32_load")
    (string-eq symbol "tl_atomic_i32_fetch_add")))

(define (tc-spmd-atomic-extern-symbol-from-handle
  [symbols : CompilerSymbols]
  [handle : i64]) : TcMaybeString
  (if (= (compiler-symbol-handle-kind handle) (compiler-symbol-kind-extern))
    (match (compiler-symbols-decl-at-index
      symbols
      (compiler-symbol-handle-index handle))
      [(OkAstDecl decl)
        (match decl
          [(AstDeclExtern _ kind metadata _)
            (match kind
              [(AstExternFunction)
                (let
                  [symbol : String (ast-extern-metadata-symbol metadata)]
                  (if (tc-spmd-atomic-public-symbol? symbol)
                    (TcSomeString symbol)
                    (TcNoString)))]
              [(AstExternValue) (TcNoString)])]
          [_ (TcNoString)])]
      [(ErrAstDecl _) (TcNoString)])
    (TcNoString)))

(define (tc-spmd-atomic-extern-symbol-lookup
  [symbols : CompilerSymbols]
  [lookup-name : String]) : TcMaybeString
  (match (compiler-symbols-lookup-value symbols lookup-name)
    [(SomeI64 handle) (tc-spmd-atomic-extern-symbol-from-handle symbols handle)]
    [(NoneI64) (TcNoString)]))

(define (tc-spmd-atomic-extern-symbol-for-name
  [ctx : TcContext]
  [name : String]) : TcMaybeString
  (if (not (tc-spmd-atomic-name-candidate? name))
    (TcNoString)
    (let
      [symbols : CompilerSymbols (tc-context-symbols ctx)]
      [direct : TcMaybeString
        (tc-spmd-atomic-extern-symbol-lookup symbols name)]
      [source-name : String (tc-hygiene-global-symbol-name name)]
      [module : String (tc-context-module ctx)]
      [lookup-name : String
        (if (and
          (> (string-length module) 0)
          (not (tc-name-qualified? source-name)))
          (compiler-symbol-module-key module source-name)
          source-name)]
      (match direct
        [(TcSomeString symbol) (TcSomeString symbol)]
        [(TcNoString)
          (match (tc-spmd-atomic-extern-symbol-lookup symbols lookup-name)
            [(TcSomeString symbol) (TcSomeString symbol)]
            [(TcNoString)
              (if (string-eq lookup-name source-name)
                (tc-spmd-atomic-imported-symbol-for-name ctx source-name)
                (tc-spmd-atomic-extern-symbol-lookup symbols source-name))])]))))

(define (tc-spmd-atomic-call-symbol
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [func : AstExpr]) : ResultTcString
  (match (tc-spmd-inline-helper-resolve-name ctx env spmd-env func)
    [(OkTcString lookup-name)
      (if (string-eq lookup-name "")
        (OkTcString "")
        (match (tc-spmd-atomic-extern-symbol-for-name ctx lookup-name)
          [(TcSomeString symbol) (OkTcString symbol)]
          [(TcNoString) (OkTcString "")]))]
    [(ErrTcString message)
      (if (string-eq message "")
        (OkTcString "")
        (ErrTcString message))]))

(define (tc-spmd-atomic-call-with-symbol
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : AstType]
  [func : AstExpr]
  [args : AstExprList]
  [symbol : String]) : ResultTcSpmdExprInfo
  (match (tc-spmd-expr ctx env spmd-env func)
    [(OkTcSpmdExprInfo func-info)
      (match func-info
        [(TcSpmdExprInfo _ _ func-env)
          (match (tc-spmd-expr-list ctx env func-env args)
            [(OkTcSpmdExprListInfo args-info)
              (match args-info
                [(TcSpmdExprListInfo args-class args-env)
                  (tc-spmd-finish
                    expr-ty
                    (if (tc-spmd-atomic-value-result? symbol)
                      args-class
                      TcSpmdUniform)
                    args-env)])]
            [(ErrTcSpmdExprListInfo message) (ErrTcSpmdExprInfo message)])])]
    [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)]))

(define (tc-spmd-atomic-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : AstType]
  [func : AstExpr]
  [args : AstExprList]) : ResultTcSpmdExprInfo
  (match (tc-spmd-atomic-call-symbol ctx env spmd-env func)
    [(OkTcString symbol)
      (if (string-eq symbol "")
        (tc-spmd-inline-call ctx env spmd-env expr-ty func args)
        (tc-spmd-atomic-call-with-symbol
          ctx
          env
          spmd-env
          expr-ty
          func
          args
          symbol))]
    [(ErrTcString message) (ErrTcSpmdExprInfo message)]))

(define (tc-spmd-inline-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : AstType]
  [func : AstExpr]
  [args : AstExprList]) : ResultTcSpmdExprInfo
  (match (tc-spmd-inline-helper-lookup ctx env spmd-env func)
    [(OkTcSpmdInlineHelper helper)
      (match helper
        [(TcSpmdSomeInlineHelper name params _ body)
          (let
            [module : String (tc-spmd-inline-helper-module ctx name)]
            [helper-ctx : TcContext (tc-context-with-module ctx module)]
            [base-env : TcTypeEnv (tc-spmd-inline-helper-env ctx env module)]
            [base-spmd-env : TcSpmdEnv
              (tc-spmd-env-mark-outer (tc-spmd-env-from-type-env base-env))]
            (match (tc-spmd-inline-helper-bind-args
              ctx
              env
              spmd-env
              helper-ctx
              base-env
              base-spmd-env
              params
              args
              TcSpmdUniform)
              [(OkTcSpmdInlineCallState call-state)
                (match call-state
                  [(TcSpmdInlineCallState
                      caller-next
                      helper-env
                      helper-spmd-env
                      args-class)
                    (if (tc-spmd-varying? args-class)
                      (match (tc-spmd-inline-helper-body
                        helper-ctx
                        helper-env
                        helper-spmd-env
                        name
                        body)
                        [(OkTcSpmdExprInfo body-info)
                          (match body-info
                            [(TcSpmdExprInfo _ body-class _)
                              (tc-spmd-finish expr-ty body-class caller-next)])]
                        [(ErrTcSpmdExprInfo message)
                          (ErrTcSpmdExprInfo message)])
                      (tc-spmd-finish expr-ty TcSpmdUniform caller-next))])]
              [(ErrTcSpmdInlineCallState message) (ErrTcSpmdExprInfo message)]))]
        [(TcSpmdNoInlineHelper)
          (tc-spmd-call-uniform-only ctx env spmd-env expr-ty func args)])]
    [(ErrTcSpmdInlineHelper message) (ErrTcSpmdExprInfo message)]))

(define (tc-spmd-masked-if-inline-helper-body
  [ctx : TcContext]
  [helper-env : TcTypeEnv]
  [helper-spmd-env : TcSpmdEnv]
  [name : String]
  [body : AstExpr]) : ResultTcUnit
  (let
    [previous : TcStringList tc-spmd-inline-helper-stack]
    [result : ResultTcUnit
      (ErrTcUnit (tc-spmd-inline-helper-recursive-message))]
    (begin
      (set! tc-spmd-inline-helper-stack (tc-string-list-add previous name))
      (set! result (tc-spmd-masked-if-expr ctx helper-env helper-spmd-env body))
      (set! tc-spmd-inline-helper-stack previous)
      result)))

(define (tc-spmd-masked-if-inline-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [func : AstExpr]
  [args : AstExprList]) : ResultTcUnit
  (match (tc-spmd-inline-helper-lookup ctx env spmd-env func)
    [(OkTcSpmdInlineHelper helper)
      (match helper
        [(TcSpmdSomeInlineHelper name params _ body)
          (let
            [module : String (tc-spmd-inline-helper-module ctx name)]
            [helper-ctx : TcContext (tc-context-with-module ctx module)]
            [base-env : TcTypeEnv (tc-spmd-inline-helper-env ctx env module)]
            [base-spmd-env : TcSpmdEnv
              (tc-spmd-env-mark-outer (tc-spmd-env-from-type-env base-env))]
            (match (tc-spmd-inline-helper-bind-args
              ctx
              env
              spmd-env
              helper-ctx
              base-env
              base-spmd-env
              params
              args
              TcSpmdUniform)
              [(OkTcSpmdInlineCallState call-state)
                (match call-state
                  [(TcSpmdInlineCallState _ helper-env helper-spmd-env _)
                    (tc-spmd-masked-if-inline-helper-body
                      helper-ctx
                      helper-env
                      helper-spmd-env
                      name
                      body)])]
              [(ErrTcSpmdInlineCallState message) (ErrTcUnit message)]))]
        [(TcSpmdNoInlineHelper)
          (tc-spmd-masked-if-unsupported "varying calls inside masked branches")])]
    [(ErrTcSpmdInlineHelper message) (ErrTcUnit message)]))

(define (tc-spmd-masked-if-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [func : AstExpr]
  [args : AstExprList]
  [expr : AstExpr]) : ResultTcUnit
  (match (tc-spmd-atomic-call-symbol ctx env spmd-env func)
    [(OkTcString symbol)
      (if (string-eq symbol "")
        (tc-spmd-masked-if-inline-call ctx env spmd-env func args)
        (match (tc-spmd-atomic-call-with-symbol
          ctx
          env
          spmd-env
          (match (tc-expr ctx env expr)
            [(OkTcType ty) ty]
            [(ErrTcType _) (AstTyUnit)])
          func
          args
          symbol)
          [(OkTcSpmdExprInfo _) OkTcUnit]
          [(ErrTcSpmdExprInfo message) (ErrTcUnit message)]))]
    [(ErrTcString message) (ErrTcUnit message)]))

(define (tc-spmd-masked-if-unsupported [detail : String]) : ResultTcUnit
  (ErrTcUnit
    (string-append "typecheck: SPMD masked if does not support " detail)))

(define (tc-spmd-masked-if-result-type-supported? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstTyUnit) true]
    [_ (tc-spmd-varying-value-type-supported? ty)]))

(define (tc-spmd-masked-if-result-type-ok [ty : AstType]) : ResultTcUnit
  (if (tc-spmd-masked-if-result-type-supported? ty)
    OkTcUnit
    (ErrTcUnit
      (string-append
        "typecheck: SPMD masked if result type is not supported: "
        (tc-type-render (tc-type-strip-region ty))))))

(define (tc-spmd-masked-if-index-var? [spmd-env : TcSpmdEnv] [name : String]) : bool
  (match (tc-spmd-env-lookup spmd-env name)
    [(TcSpmdFound _ (TcSpmdVarying) (TcSpmdLocal) (TcSpmdForeachIndex)) true]
    [_ false]))

(define (tc-spmd-foreach-index-unsupported) : ResultTcUnit
  (ErrTcUnit
    "typecheck: foreach does not support non-contiguous array-set! destination indexes; use the foreach index plus a uniform offset"))

(define (tc-spmd-foreach-uniform-offset
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : AstExpr]) : ResultTcUnit
  (match (tc-spmd-expr ctx env spmd-env expr)
    [(OkTcSpmdExprInfo info)
      (match info
        [(TcSpmdExprInfo _ class _)
          (if (tc-spmd-varying? class)
            (tc-spmd-foreach-index-unsupported)
            OkTcUnit)])]
    [(ErrTcSpmdExprInfo message) (ErrTcUnit message)]))

(define (tc-spmd-foreach-direct-index [spmd-env : TcSpmdEnv] [expr : AstExpr]) : ResultTcUnit
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-foreach-direct-index spmd-env inner))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-foreach-direct-index spmd-env inner))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-foreach-direct-index spmd-env inner))]
    [(AstExprVar name)
      (if (tc-spmd-masked-if-index-var? spmd-env (intern-str name))
        OkTcUnit
        (tc-spmd-foreach-index-unsupported))]
    [_ (tc-spmd-foreach-index-unsupported)]))

(define (tc-spmd-foreach-index
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : AstExpr]) : ResultTcUnit
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-foreach-index ctx env spmd-env inner))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-foreach-index ctx env spmd-env inner))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-foreach-index ctx env spmd-env inner))]
    [(AstExprBinary op left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (match op
          [(AstBinAdd)
            (match (tc-spmd-foreach-direct-index spmd-env left)
              [(OkTcUnit)
                (tc-spmd-foreach-uniform-offset ctx env spmd-env right)]
              [(ErrTcUnit _)
                (match (tc-spmd-foreach-direct-index spmd-env right)
                  [(OkTcUnit)
                    (tc-spmd-foreach-uniform-offset ctx env spmd-env left)]
                  [(ErrTcUnit message) (ErrTcUnit message)])])]
          [(AstBinSub)
            (match (tc-spmd-foreach-direct-index spmd-env left)
              [(OkTcUnit)
                (tc-spmd-foreach-uniform-offset ctx env spmd-env right)]
              [(ErrTcUnit message) (ErrTcUnit message)])]
          [_ (tc-spmd-foreach-index-unsupported)]))]
    [_ (tc-spmd-foreach-direct-index spmd-env expr)]))

(define (tc-spmd-masked-if-uniform-offset
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : AstExpr]) : ResultTcUnit
  (match (tc-spmd-expr ctx env spmd-env expr)
    [(OkTcSpmdExprInfo info)
      (match info
        [(TcSpmdExprInfo _ class _)
          (if (tc-spmd-varying? class)
            (tc-spmd-masked-if-unsupported
              "gather/scatter-like array indexes; use the foreach index plus a uniform offset")
            OkTcUnit)])]
    [(ErrTcSpmdExprInfo message) (ErrTcUnit message)]))

(define (tc-spmd-masked-if-direct-index [spmd-env : TcSpmdEnv] [expr : AstExpr]) : ResultTcUnit
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-masked-if-direct-index spmd-env inner))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-masked-if-direct-index spmd-env inner))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-masked-if-direct-index spmd-env inner))]
    [(AstExprVar name)
      (if (tc-spmd-masked-if-index-var? spmd-env (intern-str name))
        OkTcUnit
        (tc-spmd-masked-if-unsupported
          "gather/scatter-like array indexes; use the foreach index plus a uniform offset"))]
    [_
      (tc-spmd-masked-if-unsupported
        "gather/scatter-like array indexes; use the foreach index plus a uniform offset")]))

(define (tc-spmd-masked-if-index
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : AstExpr]) : ResultTcUnit
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-masked-if-index ctx env spmd-env inner))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-masked-if-index ctx env spmd-env inner))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-masked-if-index ctx env spmd-env inner))]
    [(AstExprBinary op left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (match op
          [(AstBinAdd)
            (match (tc-spmd-masked-if-direct-index spmd-env left)
              [(OkTcUnit)
                (tc-spmd-masked-if-uniform-offset ctx env spmd-env right)]
              [(ErrTcUnit _)
                (match (tc-spmd-masked-if-direct-index spmd-env right)
                  [(OkTcUnit)
                    (tc-spmd-masked-if-uniform-offset ctx env spmd-env left)]
                  [(ErrTcUnit message) (ErrTcUnit message)])])]
          [(AstBinSub)
            (match (tc-spmd-masked-if-direct-index spmd-env left)
              [(OkTcUnit)
                (tc-spmd-masked-if-uniform-offset ctx env spmd-env right)]
              [(ErrTcUnit message) (ErrTcUnit message)])]
          [_
            (tc-spmd-masked-if-unsupported
              "gather/scatter-like array indexes; use the foreach index plus a uniform offset")]))]
    [_ (tc-spmd-masked-if-direct-index spmd-env expr)]))

(define (tc-spmd-masked-if-lane-type-ok [ty : AstType]) : ResultTcUnit
  (if (tc-spmd-lane-type-supported? ty)
    OkTcUnit
    (ErrTcUnit
      (string-append
        "typecheck: SPMD masked if lane type is not supported: "
        (tc-type-render (tc-type-strip-region ty))))))

(define (tc-spmd-masked-if-expr-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [exprs : AstExprList]) : ResultTcUnit
  (match exprs
    [(AstExprNil) OkTcUnit]
    [(AstExprCons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (match (tc-spmd-masked-if-expr ctx env spmd-env expr)
          [(OkTcUnit) (tc-spmd-masked-if-expr-list ctx env spmd-env rest)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]))

(define (tc-spmd-masked-if-let-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [bindings : AstLetBindingList]
  [count : i64]) : ResultTcSpmdLetState
  (match bindings
    [(AstLetBindingNil) (OkTcSpmdLetState (TcSpmdLetState env spmd-env count))]
    [(AstLetBindingCons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding name maybe-ty init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (match (tc-spmd-masked-if-expr ctx env spmd-env init)
                [(OkTcUnit)
                  (match (tc-spmd-expr ctx env spmd-env init)
                    [(OkTcSpmdExprInfo info)
                      (match info
                        [(TcSpmdExprInfo init-ty init-class next-spmd-env)
                          (let
                            [bound-ty : AstType
                              (match maybe-ty
                                [(AstSomeType want)
                                  (if (tc-type-contains-any-region init-ty)
                                    init-ty
                                    (tc-resolve-type ctx want))]
                                [(AstNoType) init-ty])]
                            (tc-spmd-masked-if-let-bindings
                              ctx
                              (tc-bind-id env name bound-ty)
                              (tc-spmd-env-bind
                                next-spmd-env
                                (intern-str name)
                                bound-ty
                                init-class
                                TcSpmdLocal)
                              rest
                              (+ count 1)))])]
                    [(ErrTcSpmdExprInfo message) (ErrTcSpmdLetState message)])]
                [(ErrTcUnit message) (ErrTcSpmdLetState message)]))]))]))

(define (tc-spmd-masked-if-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : AstExpr]) : ResultTcUnit
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-masked-if-expr ctx env spmd-env inner))]
    [(AstExprLiteral _) OkTcUnit]
    [(AstExprVar _) OkTcUnit]
    [(AstExprTypeLiteral _) OkTcUnit]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-masked-if-expr ctx env spmd-env inner))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-masked-if-expr ctx env spmd-env inner))]
    [(AstExprUnary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-masked-if-expr ctx env spmd-env inner))]
    [(AstExprBinary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (match (tc-spmd-masked-if-expr ctx env spmd-env left)
          [(OkTcUnit) (tc-spmd-masked-if-expr ctx env spmd-env right)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-spmd-masked-if-let-bindings ctx env spmd-env bindings 0)
              [(OkTcSpmdLetState state)
                (match state
                  [(TcSpmdLetState body-env body-spmd-env _)
                    (tc-spmd-masked-if-expr ctx body-env body-spmd-env body)])]
              [(ErrTcSpmdLetState message) (ErrTcUnit message)]))])]
    [(AstExprIf cond-box then-box else-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-box)]
        [else-branch : AstExpr (ast-node-get else-box)]
        (match (tc-spmd-masked-if-expr ctx env spmd-env cond)
          [(OkTcUnit)
            (match (tc-spmd-masked-if-expr ctx env spmd-env then-branch)
              [(OkTcUnit) (tc-spmd-masked-if-expr ctx env spmd-env else-branch)]
              [(ErrTcUnit message) (ErrTcUnit message)])]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprBegin exprs) (tc-spmd-masked-if-expr-list ctx env spmd-env exprs)]
    [(AstExprArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-spmd-masked-if-expr ctx env spmd-env array)
          [(OkTcUnit)
            (match (tc-spmd-masked-if-index ctx env spmd-env index)
              [(OkTcUnit)
                (match (tc-expr ctx env expr)
                  [(OkTcType ty) (tc-spmd-masked-if-lane-type-ok ty)]
                  [(ErrTcType message) (ErrTcUnit message)])]
              [(ErrTcUnit message) (ErrTcUnit message)])]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-spmd-masked-if-expr ctx env spmd-env array)
          [(OkTcUnit)
            (match (tc-spmd-masked-if-index ctx env spmd-env index)
              [(OkTcUnit)
                (match (tc-spmd-masked-if-expr ctx env spmd-env value)
                  [(OkTcUnit)
                    (match (tc-expr ctx env value)
                      [(OkTcType ty) (tc-spmd-masked-if-lane-type-ok ty)]
                      [(ErrTcType message) (ErrTcUnit message)])]
                  [(ErrTcUnit message) (ErrTcUnit message)])]
              [(ErrTcUnit message) (ErrTcUnit message)])]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprStructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-spmd-masked-if-expr ctx env spmd-env receiver)
          [(OkTcUnit)
            (match (tc-spmd-masked-if-expr ctx env spmd-env value)
              [(OkTcUnit)
                (match (tc-expr ctx env value)
                  [(OkTcType ty) (tc-spmd-masked-if-lane-type-ok ty)]
                  [(ErrTcType message) (ErrTcUnit message)])]
              [(ErrTcUnit message) (ErrTcUnit message)])]
          [(ErrTcUnit message) (ErrTcUnit message)]))]
    [(AstExprCall func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (tc-spmd-masked-if-call ctx env spmd-env func args expr))]
    [(AstExprSyscall _)
      (tc-spmd-masked-if-unsupported "varying calls inside masked branches")]
    [(AstExprWhile _ _)
      (tc-spmd-masked-if-unsupported "varying while inside masked branches")]
    [(AstExprMatch _)
      (tc-spmd-masked-if-unsupported "varying match inside masked branches")]
    [(AstExprForeach _)
      (tc-spmd-masked-if-unsupported "nested foreach inside masked branches")]
    [(AstExprSpmdReduce _)
      (tc-spmd-masked-if-unsupported
        "nested spmd-reduce inside masked branches")]
    [(AstExprSpmdScan _)
      (tc-spmd-masked-if-unsupported "nested spmd-scan inside masked branches")]
    [(AstExprSpmdBroadcast _ _)
      (tc-spmd-masked-if-unsupported "spmd-broadcast inside masked branches")]
    [(AstExprSpmdProgramIndex) OkTcUnit]
    [(AstExprSpmdProgramCount) OkTcUnit]
    [(AstExprSet _ _)
      (tc-spmd-masked-if-unsupported
        "side effects other than contiguous array writes inside masked branches")]
    [(AstExprArrayPush _ _)
      (tc-spmd-masked-if-unsupported
        "side effects other than contiguous array writes inside masked branches")]
    [(AstExprBoxSet _ _)
      (tc-spmd-masked-if-unsupported
        "side effects other than contiguous array writes inside masked branches")]
    [(AstExprPtrWrite _ _)
      (tc-spmd-masked-if-unsupported
        "side effects other than contiguous array writes inside masked branches")]
    [(AstExprMakeArray _ _)
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [(AstExprArray _)
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [(AstExprBox _)
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [(AstExprBoxTake _)
      (tc-spmd-masked-if-unsupported "box-take inside masked branches")]
    [(AstExprWithRegion _ _)
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [(AstExprWithEscape _ _)
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [(AstExprWithScratch _)
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [(AstExprInArena _ _)
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [_
      (tc-spmd-masked-if-unsupported
        "this branch shape in the masked-control-flow subset")]))

(define (tc-spmd-masked-if
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : AstType]
  [then-branch : AstExpr]
  [else-branch : AstExpr]) : ResultTcSpmdExprInfo
  (match (tc-spmd-masked-if-result-type-ok expr-ty)
    [(OkTcUnit)
      (match (tc-spmd-masked-if-expr ctx env spmd-env then-branch)
        [(OkTcUnit)
          (match (tc-spmd-masked-if-expr ctx env spmd-env else-branch)
            [(OkTcUnit)
              (match (tc-type-strip-region expr-ty)
                [(AstTyUnit) (tc-spmd-finish expr-ty TcSpmdUniform spmd-env)]
                [_ (tc-spmd-finish expr-ty TcSpmdVarying spmd-env)])]
            [(ErrTcUnit message) (ErrTcSpmdExprInfo message)])]
        [(ErrTcUnit message) (ErrTcSpmdExprInfo message)])]
    [(ErrTcUnit message) (ErrTcSpmdExprInfo message)]))

(define (tc-spmd-let-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [bindings : AstLetBindingList]
  [count : i64]) : ResultTcSpmdLetState
  (match bindings
    [(AstLetBindingNil) (OkTcSpmdLetState (TcSpmdLetState env spmd-env count))]
    [(AstLetBindingCons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding name maybe-ty init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (match (tc-spmd-expr ctx env spmd-env init)
                [(OkTcSpmdExprInfo info)
                  (match info
                    [(TcSpmdExprInfo init-ty init-class next-spmd-env)
                      (let
                        [bound-ty : AstType
                          (match maybe-ty
                            [(AstSomeType want)
                              (if (tc-type-contains-any-region init-ty)
                                init-ty
                                (tc-resolve-type ctx want))]
                            [(AstNoType) init-ty])]
                        (tc-spmd-let-bindings
                          ctx
                          (tc-bind-id env name bound-ty)
                          (tc-spmd-env-bind
                            next-spmd-env
                            (intern-str name)
                            bound-ty
                            init-class
                            TcSpmdLocal)
                          rest
                          (+ count 1)))])]
                [(ErrTcSpmdExprInfo message) (ErrTcSpmdLetState message)]))]))]))

(define (tc-spmd-expr-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [exprs : AstExprList]) : ResultTcSpmdExprListInfo
  (match exprs
    [(AstExprNil)
      (OkTcSpmdExprListInfo (TcSpmdExprListInfo TcSpmdUniform spmd-env))]
    [(AstExprCons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (match (tc-spmd-expr ctx env spmd-env expr)
          [(OkTcSpmdExprInfo info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (match (tc-spmd-expr-list ctx env next-spmd-env rest)
                  [(OkTcSpmdExprListInfo rest-info)
                    (match rest-info
                      [(TcSpmdExprListInfo rest-class rest-env)
                        (OkTcSpmdExprListInfo
                          (TcSpmdExprListInfo
                            (tc-spmd-merge-class class rest-class)
                            rest-env))])]
                  [(ErrTcSpmdExprListInfo message)
                    (ErrTcSpmdExprListInfo message)])])]
          [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprListInfo message)]))]))

(define (tc-spmd-begin-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [exprs : AstExprList]) : ResultTcSpmdExprInfo
  (match exprs
    [(AstExprNil)
      (OkTcSpmdExprInfo (TcSpmdExprInfo (AstTyUnit) TcSpmdUniform spmd-env))]
    [(AstExprCons expr rest)
      (let
        [expr : AstExpr (ast-node-get expr)]
        [rest : AstExprList (box-get rest)]
        (match rest
          [(AstExprNil) (tc-spmd-expr ctx env spmd-env expr)]
          [_
            (match (tc-spmd-expr ctx env spmd-env expr)
              [(OkTcSpmdExprInfo info)
                (match info
                  [(TcSpmdExprInfo _ _ next-spmd-env)
                    (tc-spmd-begin-list ctx env next-spmd-env rest)])]
              [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)])]))]))

(define (tc-spmd-match-arms
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [class : TcSpmdClass]) : ResultTcSpmdExprListInfo
  (match arms
    [(AstMatchArmNil)
      (OkTcSpmdExprListInfo (TcSpmdExprListInfo class spmd-env))]
    [(AstMatchArmCons arm rest)
      (let
        [rest : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm pattern body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (match (tc-bind-match-pattern ctx env scrut-ty pattern)
                [(OkTcEnv arm-env)
                  (match (tc-spmd-expr ctx arm-env spmd-env body)
                    [(OkTcSpmdExprInfo body-info)
                      (match body-info
                        [(TcSpmdExprInfo _ body-class body-env)
                          (match (tc-spmd-match-arms
                            ctx
                            env
                            spmd-env
                            scrut-ty
                            rest
                            (tc-spmd-merge-class class body-class))
                            [(OkTcSpmdExprListInfo rest-info)
                              (match rest-info
                                [(TcSpmdExprListInfo rest-class rest-env)
                                  (OkTcSpmdExprListInfo
                                    (TcSpmdExprListInfo
                                      rest-class
                                      (tc-spmd-env-merge-classes
                                        body-env
                                        rest-env)))])]
                            [(ErrTcSpmdExprListInfo message)
                              (ErrTcSpmdExprListInfo message)])])]
                    [(ErrTcSpmdExprInfo message)
                      (ErrTcSpmdExprListInfo message)])]
                [(ErrTcEnv message) (ErrTcSpmdExprListInfo message)]))]))]))

(define (tc-spmd-check-foreach-body-with-env
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [index : String]
  [index-ty : AstType]
  [body : AstExpr]) : ResultTcUnit
  (let
    [body-env : TcTypeEnv (tc-bind env index index-ty)]
    [body-spmd-env : TcSpmdEnv
      (tc-spmd-env-bind-role
        (tc-spmd-env-mark-outer spmd-env)
        index
        index-ty
        TcSpmdVarying
        TcSpmdLocal
        TcSpmdForeachIndex)]
    [result : ResultTcUnit OkTcUnit]
    (begin
      (tc-spmd-inline-helper-stack-reset!)
      (set!
        result
        (match (tc-spmd-expr ctx body-env body-spmd-env body)
          [(OkTcSpmdExprInfo _) OkTcUnit]
          [(ErrTcSpmdExprInfo message) (ErrTcUnit message)]))
      (tc-spmd-inline-helper-stack-reset!)
      result)))

(define (tc-spmd-check-foreach-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [index : String]
  [index-ty : AstType]
  [body : AstExpr]) : ResultTcUnit
  (tc-spmd-check-foreach-body-with-env
    ctx
    env
    (tc-spmd-env-from-type-env env)
    index
    index-ty
    body))

(define (tc-spmd-scan-body-no-nested-list [exprs : AstExprList]) : ResultTcUnit
  (match exprs
    [(AstExprNil) OkTcUnit]
    [(AstExprCons expr rest)
      (let
        [head : AstExpr (ast-node-get expr)]
        [tail : AstExprList (box-get rest)]
        (match (tc-spmd-scan-body-no-nested-spmd head)
          [(OkTcUnit) (tc-spmd-scan-body-no-nested-list tail)]
          [(ErrTcUnit message) (ErrTcUnit message)]))]))

(define (tc-spmd-scan-body-no-nested-pair [left : AstExpr] [right : AstExpr]) : ResultTcUnit
  (match (tc-spmd-scan-body-no-nested-spmd left)
    [(OkTcUnit) (tc-spmd-scan-body-no-nested-spmd right)]
    [(ErrTcUnit message) (ErrTcUnit message)]))

(define (tc-spmd-scan-body-no-nested-triple
  [first : AstExpr]
  [second : AstExpr]
  [third : AstExpr]) : ResultTcUnit
  (match (tc-spmd-scan-body-no-nested-pair first second)
    [(OkTcUnit) (tc-spmd-scan-body-no-nested-spmd third)]
    [(ErrTcUnit message) (ErrTcUnit message)]))

(define (tc-spmd-scan-body-no-nested-let-bindings
  [bindings : AstLetBindingList]) : ResultTcUnit
  (match bindings
    [(AstLetBindingNil) OkTcUnit]
    [(AstLetBindingCons binding rest)
      (let
        [tail : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding _ _ init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (match (tc-spmd-scan-body-no-nested-spmd init)
                [(OkTcUnit) (tc-spmd-scan-body-no-nested-let-bindings tail)]
                [(ErrTcUnit message) (ErrTcUnit message)]))]))]))

(define (tc-spmd-scan-body-no-nested-resource-bindings
  [bindings : AstResourceBindingList]) : ResultTcUnit
  (match bindings
    [(AstResourceBindingNil) OkTcUnit]
    [(AstResourceBindingCons binding rest)
      (let
        [tail : AstResourceBindingList (box-get rest)]
        (match binding
          [(AstResourceBinding _ init-box cleanup-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              [cleanup : AstExpr (ast-node-get cleanup-box)]
              (match (tc-spmd-scan-body-no-nested-pair init cleanup)
                [(OkTcUnit)
                  (tc-spmd-scan-body-no-nested-resource-bindings tail)]
                [(ErrTcUnit message) (ErrTcUnit message)]))]))]))

(define (tc-spmd-scan-body-no-nested-arms [arms : AstMatchArmList]) : ResultTcUnit
  (match arms
    [(AstMatchArmNil) OkTcUnit]
    [(AstMatchArmCons arm rest)
      (let
        [tail : AstMatchArmList (box-get rest)]
        (match arm
          [(AstMatchArm _ body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (match (tc-spmd-scan-body-no-nested-spmd body)
                [(OkTcUnit) (tc-spmd-scan-body-no-nested-arms tail)]
                [(ErrTcUnit message) (ErrTcUnit message)]))]))]))

(define (tc-spmd-scan-body-no-nested-spmd [expr : AstExpr]) : ResultTcUnit
  (match expr
    [(AstExprSpanned inner-box _)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExprBinary _ left-box right-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get left-box)
        (ast-node-get right-box))]
    [(AstExprUnary _ inner-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExprCall func-box args)
      (match (tc-spmd-scan-body-no-nested-spmd (ast-node-get func-box))
        [(OkTcUnit) (tc-spmd-scan-body-no-nested-list args)]
        [(ErrTcUnit message) (ErrTcUnit message)])]
    [(AstExprIf cond-box then-box else-box)
      (tc-spmd-scan-body-no-nested-triple
        (ast-node-get cond-box)
        (ast-node-get then-box)
        (ast-node-get else-box))]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body-box)
          (match (tc-spmd-scan-body-no-nested-let-bindings bindings)
            [(OkTcUnit)
              (tc-spmd-scan-body-no-nested-spmd (ast-node-get body-box))]
            [(ErrTcUnit message) (ErrTcUnit message)])])]
    [(AstExprLambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda _ _ body-box)
          (tc-spmd-scan-body-no-nested-spmd (ast-node-get body-box))])]
    [(AstExprTuple exprs) (tc-spmd-scan-body-no-nested-list exprs)]
    [(AstExprTupleRef tuple-box index-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get tuple-box)
        (ast-node-get index-box))]
    [(AstExprArray exprs) (tc-spmd-scan-body-no-nested-list exprs)]
    [(AstExprMakeArray _ len-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get len-box))]
    [(AstExprArrayRef array-box index-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get array-box)
        (ast-node-get index-box))]
    [(AstExprArraySet array-box index-box value-box)
      (tc-spmd-scan-body-no-nested-triple
        (ast-node-get array-box)
        (ast-node-get index-box)
        (ast-node-get value-box))]
    [(AstExprArrayPush array-box value-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get array-box)
        (ast-node-get value-box))]
    [(AstExprStringRef str-box index-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get str-box)
        (ast-node-get index-box))]
    [(AstExprWhile cond-box body-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get cond-box)
        (ast-node-get body-box))]
    [(AstExprBegin exprs) (tc-spmd-scan-body-no-nested-list exprs)]
    [(AstExprUnsafe exprs) (tc-spmd-scan-body-no-nested-list exprs)]
    [(AstExprSet _ value-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get value-box))]
    [(AstExprAnn inner-box _)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExprCast inner-box _)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExprBorrow _ _ place-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get place-box))]
    [(AstExprMatch match-box)
      (match (box-get match-box)
        [(AstMatch scrutinee-box arms)
          (match (tc-spmd-scan-body-no-nested-spmd (ast-node-get scrutinee-box))
            [(OkTcUnit) (tc-spmd-scan-body-no-nested-arms arms)]
            [(ErrTcUnit message) (ErrTcUnit message)])])]
    [(AstExprForeach _)
      (ErrTcUnit "typecheck: nested foreach inside spmd-scan is not supported")]
    [(AstExprSpmdReduce _)
      (ErrTcUnit
        "typecheck: nested spmd-reduce inside spmd-scan is not supported")]
    [(AstExprSpmdScan _)
      (ErrTcUnit
        "typecheck: nested spmd-scan inside spmd-scan is not supported")]
    [(AstExprSpmdBroadcast value-box lane-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get value-box)
        (ast-node-get lane-box))]
    [(AstExprSpmdProgramIndex)
      (ErrTcUnit
        "typecheck: program-index is not supported inside spmd-scan body")]
    [(AstExprSpmdProgramCount)
      (ErrTcUnit
        "typecheck: program-count is not supported inside spmd-scan body")]
    [(AstExprStructGet receiver-box _)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get receiver-box))]
    [(AstExprStructSet receiver-box _ value-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get receiver-box)
        (ast-node-get value-box))]
    [(AstExprWithRegion _ body) (tc-spmd-scan-body-no-nested-list body)]
    [(AstExprWithEscape scratch-box body)
      (match (tc-spmd-scan-body-no-nested-spmd (ast-node-get scratch-box))
        [(OkTcUnit) (tc-spmd-scan-body-no-nested-list body)]
        [(ErrTcUnit message) (ErrTcUnit message)])]
    [(AstExprWithScratch body) (tc-spmd-scan-body-no-nested-list body)]
    [(AstExprInArena arena-box body)
      (match (tc-spmd-scan-body-no-nested-spmd (ast-node-get arena-box))
        [(OkTcUnit) (tc-spmd-scan-body-no-nested-list body)]
        [(ErrTcUnit message) (ErrTcUnit message)])]
    [(AstExprWithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource bindings body)
          (match (tc-spmd-scan-body-no-nested-resource-bindings bindings)
            [(OkTcUnit) (tc-spmd-scan-body-no-nested-list body)]
            [(ErrTcUnit message) (ErrTcUnit message)])])]
    [(AstExprBox inner-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExprBoxGet inner-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExprBoxTake inner-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExprBoxSet inner-box value-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get inner-box)
        (ast-node-get value-box))]
    [(AstExprComptime inner-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExprQuote _) OkTcUnit]
    [(AstExprQuasiquote _) OkTcUnit]
    [(AstExprUnquote inner-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExprUnquoteSplicing inner-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExprBracketClause items) (tc-spmd-scan-body-no-nested-list items)]
    [(AstExprTry inner-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExprReturn inner-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExprPtrNullCheck inner-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExprPtrRead ptr-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get ptr-box))]
    [(AstExprPtrWrite ptr-box value-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get ptr-box)
        (ast-node-get value-box))]
    [(AstExprPtrOffset ptr-box offset-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get ptr-box)
        (ast-node-get offset-box))]
    [(AstExprPtrCast ptr-box _)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get ptr-box))]
    [(AstExprPtrToInt ptr-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get ptr-box))]
    [(AstExprIntToPtr value-box _)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get value-box))]
    [(AstExprStringData str-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get str-box))]
    [(AstExprStringFromBytes ptr-box len-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get ptr-box)
        (ast-node-get len-box))]
    [(AstExprArrayData array-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get array-box))]
    [(AstExprCpuIdEax leaf-box subleaf-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get leaf-box)
        (ast-node-get subleaf-box))]
    [(AstExprCpuIdEbx leaf-box subleaf-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get leaf-box)
        (ast-node-get subleaf-box))]
    [(AstExprCpuIdEcx leaf-box subleaf-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get leaf-box)
        (ast-node-get subleaf-box))]
    [(AstExprCpuIdEdx leaf-box subleaf-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get leaf-box)
        (ast-node-get subleaf-box))]
    [(AstExprXgetbv index-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get index-box))]
    [(AstExprSyscall args) (tc-spmd-scan-body-no-nested-list args)]
    [_ OkTcUnit]))

(define (tc-spmd-check-scan-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [index : String]
  [index-ty : AstType]
  [prefix : String]
  [prefix-ty : AstType]
  [body : AstExpr]) : ResultTcUnit
  (let
    [index-env : TcTypeEnv (tc-bind env index index-ty)]
    [body-env : TcTypeEnv (tc-bind index-env prefix prefix-ty)]
    [base-spmd-env : TcSpmdEnv
      (tc-spmd-env-mark-outer (tc-spmd-env-from-type-env env))]
    [index-spmd-env : TcSpmdEnv
      (tc-spmd-env-bind-role
        base-spmd-env
        index
        index-ty
        TcSpmdVarying
        TcSpmdLocal
        TcSpmdForeachIndex)]
    [body-spmd-env : TcSpmdEnv
      (tc-spmd-env-bind
        index-spmd-env
        prefix
        prefix-ty
        TcSpmdVarying
        TcSpmdLocal)]
    [result : ResultTcUnit OkTcUnit]
    (match (tc-spmd-scan-body-no-nested-spmd body)
      [(OkTcUnit)
        (begin
          (tc-spmd-inline-helper-stack-reset!)
          (set!
            result
            (match (tc-spmd-expr ctx body-env body-spmd-env body)
              [(OkTcSpmdExprInfo _) OkTcUnit]
              [(ErrTcSpmdExprInfo message) (ErrTcUnit message)]))
          (tc-spmd-inline-helper-stack-reset!)
          result)]
      [(ErrTcUnit message) (ErrTcUnit message)])))

;; `spmd-reduce` allows varying bool values for `all`/`any`, so it cannot reuse
;; the full foreach body checker: that checker applies foreach array-lane
;; restrictions to the entire expression. This path only classifies the reduce
;; value enough to enforce nested `spmd-broadcast` value/lane rules.
(define (tc-spmd-reduce-class-finish
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : AstExpr]
  [class : TcSpmdClass]) : ResultTcSpmdExprInfo
  (match (tc-expr ctx env expr)
    [(OkTcType ty) (tc-spmd-finish ty class spmd-env)]
    [(ErrTcType message) (ErrTcSpmdExprInfo message)]))

(define (tc-spmd-reduce-class-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : AstExpr]
  [expected : AstType]) : ResultTcSpmdExprInfo
  (match (tc-spmd-reduce-class ctx env spmd-env expr)
    [(OkTcSpmdExprInfo info)
      (match info
        [(TcSpmdExprInfo _ class next-spmd-env)
          (match (tc-expr-with-expected-or-actual ctx env expr expected)
            [(OkTcType ty) (tc-spmd-finish ty class next-spmd-env)]
            [(ErrTcType message) (ErrTcSpmdExprInfo message)])])]
    [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)]))

(define (tc-spmd-reduce-let-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [bindings : AstLetBindingList]
  [count : i64]) : ResultTcSpmdLetState
  (match bindings
    [(AstLetBindingNil) (OkTcSpmdLetState (TcSpmdLetState env spmd-env count))]
    [(AstLetBindingCons binding rest)
      (let
        [rest : AstLetBindingList (box-get rest)]
        (match binding
          [(AstLetBinding name maybe-ty init-box)
            (let
              [init : AstExpr (ast-node-get init-box)]
              (match (tc-spmd-reduce-class ctx env spmd-env init)
                [(OkTcSpmdExprInfo info)
                  (match info
                    [(TcSpmdExprInfo init-ty init-class next-spmd-env)
                      (let
                        [bound-ty : AstType
                          (match maybe-ty
                            [(AstSomeType want)
                              (if (tc-type-contains-any-region init-ty)
                                init-ty
                                (tc-resolve-type ctx want))]
                            [(AstNoType) init-ty])]
                        (tc-spmd-reduce-let-bindings
                          ctx
                          (tc-bind-id env name bound-ty)
                          (tc-spmd-env-bind
                            next-spmd-env
                            (intern-str name)
                            bound-ty
                            init-class
                            TcSpmdLocal)
                          rest
                          (+ count 1)))])]
                [(ErrTcSpmdExprInfo message) (ErrTcSpmdLetState message)]))]))]))

(define (tc-spmd-reduce-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : AstExpr]) : ResultTcSpmdExprInfo
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-reduce-class ctx env spmd-env inner))]
    [(AstExprLiteral _)
      (tc-spmd-reduce-class-finish ctx env spmd-env expr TcSpmdUniform)]
    [(AstExprSpmdProgramIndex)
      (tc-spmd-reduce-class-finish ctx env spmd-env expr TcSpmdVarying)]
    [(AstExprSpmdProgramCount)
      (tc-spmd-reduce-class-finish ctx env spmd-env expr TcSpmdUniform)]
    [(AstExprVar name)
      (let
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-expr-id env name-text)
            [(OkTcExprId virtual-id)
              (tc-spmd-reduce-class ctx env spmd-env (ast-node-get virtual-id))]
            [(ErrTcExprId message) (ErrTcSpmdExprInfo message)])
          (match (tc-spmd-env-lookup spmd-env name-text)
            [(TcSpmdFound _ class _ _)
              (tc-spmd-reduce-class-finish ctx env spmd-env expr class)]
            [(TcSpmdMissing)
              (tc-spmd-reduce-class-finish ctx env spmd-env expr TcSpmdUniform)])))]
    [(AstExprBinary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (match (tc-spmd-reduce-class ctx env spmd-env left)
          [(OkTcSpmdExprInfo left-info)
            (match left-info
              [(TcSpmdExprInfo _ left-class left-env)
                (match (tc-spmd-reduce-class ctx env left-env right)
                  [(OkTcSpmdExprInfo right-info)
                    (match right-info
                      [(TcSpmdExprInfo _ right-class right-env)
                        (tc-spmd-reduce-class-finish
                          ctx
                          env
                          right-env
                          expr
                          (tc-spmd-merge-class left-class right-class))])]
                  [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)])])]
          [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)]))]
    [(AstExprUnary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-spmd-reduce-class ctx env spmd-env inner)
          [(OkTcSpmdExprInfo info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-reduce-class-finish ctx env next-spmd-env expr class)])]
          [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)]))]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-spmd-reduce-class ctx env spmd-env inner)
          [(OkTcSpmdExprInfo info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-reduce-class-finish ctx env next-spmd-env expr class)])]
          [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)]))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-spmd-reduce-class ctx env spmd-env inner)
          [(OkTcSpmdExprInfo info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-reduce-class-finish ctx env next-spmd-env expr class)])]
          [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)]))]
    [(AstExprLet let-box)
      (match (box-get let-box)
        [(AstLet bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-spmd-reduce-let-bindings ctx env spmd-env bindings 0)
              [(OkTcSpmdLetState state)
                (match state
                  [(TcSpmdLetState body-env body-spmd-env count)
                    (match (tc-spmd-reduce-class
                      ctx
                      body-env
                      body-spmd-env
                      body)
                      [(OkTcSpmdExprInfo body-info)
                        (match body-info
                          [(TcSpmdExprInfo _ body-class final-spmd-env)
                            (tc-spmd-reduce-class-finish
                              ctx
                              env
                              (tc-spmd-env-pop final-spmd-env count)
                              expr
                              body-class)])]
                      [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)])])]
              [(ErrTcSpmdLetState message) (ErrTcSpmdExprInfo message)]))])]
    [(AstExprArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-spmd-reduce-class ctx env spmd-env array)
          [(OkTcSpmdExprInfo array-info)
            (match array-info
              [(TcSpmdExprInfo _ array-class array-env)
                (match (tc-spmd-reduce-class ctx env array-env index)
                  [(OkTcSpmdExprInfo index-info)
                    (match index-info
                      [(TcSpmdExprInfo _ index-class index-env)
                        (tc-spmd-reduce-class-finish
                          ctx
                          env
                          index-env
                          expr
                          (tc-spmd-merge-class array-class index-class))])]
                  [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)])])]
          [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)]))]
    [(AstExprSpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (match (tc-spmd-reduce-class ctx env spmd-env value)
          [(OkTcSpmdExprInfo value-info)
            (match value-info
              [(TcSpmdExprInfo _ value-class value-env)
                (match (tc-spmd-reduce-class-with-expected-or-actual
                  ctx
                  env
                  value-env
                  lane
                  (AstTyI64))
                  [(OkTcSpmdExprInfo lane-info)
                    (match lane-info
                      [(TcSpmdExprInfo lane-ty lane-class lane-env)
                        (match (tc-expr ctx env expr)
                          [(OkTcType expr-ty)
                            (tc-spmd-broadcast-finish
                              ctx
                              expr-ty
                              value-class
                              lane-ty
                              lane-class
                              lane-env)]
                          [(ErrTcType message) (ErrTcSpmdExprInfo message)])])]
                  [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)])])]
          [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)]))]
    [_ (tc-spmd-reduce-class-finish ctx env spmd-env expr TcSpmdUniform)]))

(define (tc-spmd-check-reduce-value-broadcasts
  [ctx : TcContext]
  [env : TcTypeEnv]
  [index : String]
  [index-ty : AstType]
  [value : AstExpr]) : ResultTcUnit
  (let
    [value-env : TcTypeEnv (tc-bind env index index-ty)]
    [value-spmd-env : TcSpmdEnv
      (tc-spmd-env-bind-role
        (tc-spmd-env-mark-outer (tc-spmd-env-from-type-env env))
        index
        index-ty
        TcSpmdVarying
        TcSpmdLocal
        TcSpmdForeachIndex)]
    (match (tc-spmd-reduce-class ctx value-env value-spmd-env value)
      [(OkTcSpmdExprInfo _) OkTcUnit]
      [(ErrTcSpmdExprInfo message) (ErrTcUnit message)])))

(define (tc-spmd-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : AstExpr]) : ResultTcSpmdExprInfo
  (match (tc-expr ctx env expr)
    [(OkTcType ty) (tc-spmd-expr-typed ctx env spmd-env expr ty)]
    [(ErrTcType message) (ErrTcSpmdExprInfo message)]))

(define (tc-spmd-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : AstExpr]
  [expected : AstType]) : ResultTcSpmdExprInfo
  (match (tc-expr-with-expected-or-actual ctx env expr expected)
    [(OkTcType ty) (tc-spmd-expr-typed ctx env spmd-env expr ty)]
    [(ErrTcType message) (ErrTcSpmdExprInfo message)]))

(define (tc-spmd-array-value-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [array-ty : AstType]
  [value : AstExpr]) : ResultTcSpmdExprInfo
  (match (tc-type-strip-region (tc-resolve-type ctx array-ty))
    [(AstTyArray elem-ty _)
      (tc-spmd-expr-with-expected-or-actual
        ctx
        env
        spmd-env
        value
        (ty-node-get elem-ty))]
    [(AstTyDynArray elem-ty)
      (tc-spmd-expr-with-expected-or-actual
        ctx
        env
        spmd-env
        value
        (ty-node-get elem-ty))]
    [_ (tc-spmd-expr ctx env spmd-env value)]))

(define (tc-spmd-expr-typed
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : AstExpr]
  [expr-ty : AstType]) : ResultTcSpmdExprInfo
  (match expr
    [(AstExprSpanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-expr-typed ctx env spmd-env inner expr-ty))]
    [(AstExprLiteral _) (tc-spmd-finish expr-ty TcSpmdUniform spmd-env)]
    [(AstExprSpmdProgramIndex) (tc-spmd-finish expr-ty TcSpmdVarying spmd-env)]
    [(AstExprSpmdProgramCount) (tc-spmd-finish expr-ty TcSpmdUniform spmd-env)]
    [(AstExprVar name)
      (let
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-expr-id env name-text)
            [(OkTcExprId virtual-id)
              (tc-spmd-expr-typed
                ctx
                env
                spmd-env
                (ast-node-get virtual-id)
                expr-ty)]
            [(ErrTcExprId message) (ErrTcSpmdExprInfo message)])
          (match (tc-spmd-env-lookup spmd-env name-text)
            [(TcSpmdFound _ class _ _) (tc-spmd-finish expr-ty class spmd-env)]
            [(TcSpmdMissing) (tc-spmd-finish expr-ty TcSpmdUniform spmd-env)])))]
    [(AstExprTypeLiteral _) (tc-spmd-finish expr-ty TcSpmdUniform spmd-env)]
    [(AstExprInit _) (tc-spmd-finish expr-ty TcSpmdUniform spmd-env)]
    [(AstExprAnn inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-spmd-expr ctx env spmd-env inner)
          [(OkTcSpmdExprInfo info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ErrTcSpmdExprInfo message) (ErrTcSpmdExprInfo message)]))]
    [(AstExprCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-spmd-expr ctx env spmd-env inner)
