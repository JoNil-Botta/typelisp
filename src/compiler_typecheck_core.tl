(cfg
  compile-profile
  (define (tc-lp-reset [index : i64]) : unit
    (if (< index 15)
      (begin
        (array.array-set! tc-lp-counts index 0)
        (tc-lp-reset (+ index 1)))
      unit)))

(cfg
  compile-profile
  (define (tc-lp-note [index : i64]) : unit
