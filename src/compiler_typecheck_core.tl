(define (tc-topenv-membership-state-reset! [state : TcTopEnvMembershipState]) : unit
  (let
    [data : (MutPtr TcTopEnvMembershipStateData)
      (tc-topenv-membership-state-ptr state)]
    (unsafe
      (set! (deref data).epoch (+ (deref data).epoch 1))
      (set! (deref data).intern-table-id -1)
      (set! (deref data).intern-generation -1)
      (set! (deref data).mode 0))))

(define (tc-thread-name-kind-state-reset! [state : TcThreadNameKindState]) : unit
  (let
    [data : (MutPtr TcThreadNameKindStateData)
      (tc-thread-name-kind-state-ptr state)]
    (unsafe
      (set! (deref data).epoch (+ (deref data).epoch 1))
      (set! (deref data).intern-table-id -1)
      (set! (deref data).intern-generation -1))))

(define (tc-type-resolution-cache-state-reset!
  [state : TcTypeResolutionCacheState]) : unit
  (let
    [data : (MutPtr TcTypeResolutionCacheStateData)
      (tc-type-resolution-cache-state-ptr state)]
    (unsafe
      (set! (deref data).epoch (+ (deref data).epoch 1))
      (set! (deref data).type-pool-owner-id 0)
      (set! (deref data).type-segment-bases 0))))

(define (tc-source-key-cache-state-reset! [state : TcSourceKeyCacheState]) : unit
  (set! (array-ref state.control 2) 0)
  (set! (array-ref state.control 5) 0)
  (set! (array-ref state.control 9) 0))

(define tc-macro-call-site-record-stride : i64
  12)

(define (tc-macro-call-site-record-slot [index : i64] [field : i64]) : i64
  (+ (* index tc-macro-call-site-record-stride) field))

(define (tc-macro-call-site-state-storage-grow! [state : TcMacroCallSiteState]) : unit
  (unsafe
    (let
      [data : (MutPtr TcMacroCallSiteStateData)
        (tc-macro-call-site-state-ptr state)]
      [old-records : (__tl_dyn-array i64) (deref data).records]
      [old-capacity : i64 (deref data).capacity]
      [new-capacity : i64
        (if (< old-capacity 1)
          16
          (* old-capacity 2))]
      (in-arena
        (arena.Arena (deref data).fixed-storage-arena)
        (let
          [new-records : (__tl_dyn-array i64)
            (__tl_make-array
              i64
              (* new-capacity tc-macro-call-site-record-stride))]
          [index : i64 0]
          (while (< index (* (deref data).len tc-macro-call-site-record-stride))
            (set! (array-ref new-records index) (array-ref old-records index))
            (set! index (+ index 1)))
          (set! (deref data).records new-records)
          (set! (deref data).capacity new-capacity))))))

(define (tc-macro-call-site-record-key-eq?
  [data : (& data TcMacroCallSiteStateData)]
  [index : i64]
  [path-id : i64]
  [definition-module-id : i64]
  [declaration-id : i64]
  [span : ast.AstSourceSpan]) : bool
  (let
    [base : i64 (tc-macro-call-site-record-slot index 0)]
    (and
      (= (array-ref data.records base) path-id)
      (= (array-ref data.records (+ base 2)) definition-module-id)
      (= (array-ref data.records (+ base 3)) declaration-id)
      (=
        (array-ref data.records (+ base 4))
        (ast.ast-source-span-start-line span))
      (=
        (array-ref data.records (+ base 5))
        (ast.ast-source-span-start-col span))
      (=
        (array-ref data.records (+ base 6))
        (ast.ast-source-span-end-line span))
      (= (array-ref data.records (+ base 7)) (ast.ast-source-span-end-col span)))))

(define (tc-macro-call-site-key-hash
  [path-id : i64]
  [definition-module-id : i64]
  [declaration-id : i64]
  [span : ast.AstSourceSpan]) : i64
  (hash.combine
    (hash.combine
      (hash.combine
        (hash.combine
          (hash.combine
            (hash.combine (hash.i64 path-id) (hash.i64 definition-module-id))
            (hash.i64 declaration-id))
          (hash.i64 (ast.ast-source-span-start-line span)))
        (hash.i64 (ast.ast-source-span-start-col span)))
      (hash.i64 (ast.ast-source-span-end-line span)))
    (hash.i64 (ast.ast-source-span-end-col span))))

(define (tc-macro-call-site-state-contains-key?
  [data : (& data TcMacroCallSiteStateData)]
  [path-id : i64]
  [definition-module-id : i64]
  [declaration-id : i64]
  [span : ast.AstSourceSpan]) : bool
  (let
    [index : i64 0]
    [found : bool false]
    (while (and (not found) (< index data.len))
      (if (tc-macro-call-site-record-key-eq?
        data
        index
        path-id
        definition-module-id
        declaration-id
        span)
        (set! found true)
        unit)
      (set! index (+ index 1)))
    found))

(define (tc-macro-call-site-state-contains?
  [state : TcMacroCallSiteState]
  [site-hash : i64]
  [path-id : i64]
  [definition-module-id : i64]
  [declaration-id : i64]
  [span : ast.AstSourceSpan]) : bool
  (let
    [data : TcMacroCallSiteStateData (tc-macro-call-site-state-data state)]
    (match (tc_i64_i64_map.get (& data.seen-sites) site-hash)
      [(LookupFound index)
        (if (and (>= index 0) (< index data.len))
          (if (tc-macro-call-site-record-key-eq?
            data
            index
            path-id
            definition-module-id
            declaration-id
            span)
            true
            ;; Pool-generation node-ID reuse is rare. Preserve exactness by
            ;; falling back to the full key only on that collision path.
            (tc-macro-call-site-state-contains-key?
              data
              path-id
              definition-module-id
              declaration-id
              span))
          (tc-macro-call-site-state-contains-key?
            data
            path-id
            definition-module-id
            declaration-id
            span))]
      [(LookupMissing) false])))

(define (tc-macro-call-site-state-seen-note!
  [state : TcMacroCallSiteState]
  [site-hash : i64]
  [record-index : i64]) : unit
  (let
    [data : TcMacroCallSiteStateData (tc-macro-call-site-state-data state)]
    (match (tc_i64_i64_map.get (& data.seen-sites) site-hash)
      [(LookupFound _) unit]
      [(LookupMissing)
        (in-arena
          (arena.Arena data.fixed-storage-arena)
          (tc_i64_i64_map.insert-ref!
            (&mut data.seen-sites)
            site-hash
            record-index)
          (tc-macro-call-site-state-data-set! state data))])))

(define (tc-macro-call-site-state-record!
  [state : TcMacroCallSiteState]
  [macro-name-id : i64]
  [definition-module-id : i64]
  [declaration-id : i64]
  [span : ast.AstSourceSpan]) : unit
  (let
    [active : TcMacroCallSiteStateData (tc-macro-call-site-state-data state)]
    [path-id : i64 active.active-path-id]
    [site-hash : i64
      (tc-macro-call-site-key-hash
        path-id
        definition-module-id
        declaration-id
        span)]
    (unless
      (tc-macro-call-site-state-contains?
        state
        site-hash
        path-id
        definition-module-id
        declaration-id
        span)
      (if (>= active.len active.capacity)
        (tc-macro-call-site-state-storage-grow! state)
        unit)
      (let
        [latest : (MutPtr TcMacroCallSiteStateData)
          (tc-macro-call-site-state-ptr state)]
        [index : i64
          (unsafe
            (deref latest).len)]
        [base : i64 (tc-macro-call-site-record-slot index 0)]
        (unsafe
          (set! (array-ref (deref latest).records base) path-id)
          (set! (array-ref (deref latest).records (+ base 1)) macro-name-id)
          (set!
            (array-ref (deref latest).records (+ base 2))
            definition-module-id)
          (set! (array-ref (deref latest).records (+ base 3)) declaration-id)
          (set!
            (array-ref (deref latest).records (+ base 4))
            (ast.ast-source-span-start-line span))
          (set!
            (array-ref (deref latest).records (+ base 5))
            (ast.ast-source-span-start-col span))
          (set!
            (array-ref (deref latest).records (+ base 6))
            (ast.ast-source-span-end-line span))
          (set!
            (array-ref (deref latest).records (+ base 7))
            (ast.ast-source-span-end-col span))
          (set!
            (array-ref (deref latest).records (+ base 8))
            (if active.active-editable
              1
              0))
          (set!
            (array-ref (deref latest).records (+ base 9))
            active.active-generator-id)
          (set!
            (array-ref (deref latest).records (+ base 10))
            active.active-item-id)
          (set!
            (array-ref (deref latest).records (+ base 11))
            active.active-key-id)
          (set! (deref latest).len (+ index 1)))
        (tc-macro-call-site-state-seen-note! state site-hash index)))))

(define (tc-macro-call-site-state-set-active-decl!
  [state : TcMacroCallSiteState]
  [path : String]
  [meta : ast.AstGeneratedDeclMeta]) : unit
  (let
    [data : (MutPtr TcMacroCallSiteStateData)
      (tc-macro-call-site-state-ptr state)]
    (unsafe
      (set! (deref data).active-path-id (ci.intern path))
      (match meta
        [(No)
          (set! (deref data).active-editable true)
          (set! (deref data).active-generator-id -1)
          (set! (deref data).active-item-id -1)
          (set! (deref data).active-key-id -1)]
        [(Some generator item _ key)
          (set! (deref data).active-editable false)
          (set! (deref data).active-generator-id (ci.intern generator))
          (set! (deref data).active-item-id (ci.intern item))
          (set! (deref data).active-key-id (ci.intern key))]))))

(define (tc-macro-call-site-state-active-decl [state : TcMacroCallSiteState]) : TcMacroCallSiteActiveDecl
  (let
    [data : (Ptr TcMacroCallSiteStateData)
      (tc-macro-call-site-state-view state)]
    (unsafe
      (TcMacroCallSiteActiveDecl
        (deref data).active-path-id
        (deref data).active-editable
        (deref data).active-generator-id
        (deref data).active-item-id
        (deref data).active-key-id))))

(define (tc-macro-call-site-state-restore-active-decl!
  [state : TcMacroCallSiteState]
  [active : TcMacroCallSiteActiveDecl]) : unit
  (let
    [data : (MutPtr TcMacroCallSiteStateData)
      (tc-macro-call-site-state-ptr state)]
    (unsafe
      (set! (deref data).active-path-id active.path-id)
      (set! (deref data).active-editable active.editable)
      (set! (deref data).active-generator-id active.generator-id)
      (set! (deref data).active-item-id active.item-id)
      (set! (deref data).active-key-id active.key-id))))

(define (tc-macro-call-site-state-reset! [state : TcMacroCallSiteState]) : unit
  (let
    [data : TcMacroCallSiteStateData (tc-macro-call-site-state-data state)]
    (set! data.len 0)
    (set! data.active-path-id -1)
    (set! data.active-editable false)
    (set! data.active-generator-id -1)
    (set! data.active-item-id -1)
    (set! data.active-key-id -1)
    (tc-cache-map-clear! (&mut data.seen-sites))
    (tc-cache-map-clear! (&mut data.definition-paths))
    (tc-macro-call-site-state-data-set! state data)))

(define (tc-macro-call-site-text [id : i64]) : String
  (if (< id 0)
    ""
    (ci.intern-str id)))

(define (tc-macro-call-site-count-for-state [state : TcMacroCallSiteState]) : i64
  (unsafe
    (deref (tc-macro-call-site-state-view state)).len))

(define (tc-macro-call-site-field-for-state
  [state : TcMacroCallSiteState]
  [index : i64]
  [field : i64]
  [fallback : i64]) : i64
  (let
    [data : (Ptr TcMacroCallSiteStateData)
      (tc-macro-call-site-state-view state)]
    (unsafe
      (if (and (>= index 0) (< index (deref data).len))
        (array-ref
          (deref data).records
          (tc-macro-call-site-record-slot index field))
        fallback))))

(define (tc-macro-call-site-path-for-state
  [state : TcMacroCallSiteState]
  [index : i64]) : String
  (tc-macro-call-site-text
    (tc-macro-call-site-field-for-state state index 0 -1)))

(define (tc-macro-call-site-macro-name-id-for-state
  [state : TcMacroCallSiteState]
  [index : i64]) : i64
  (tc-macro-call-site-field-for-state state index 1 -1))

(define (tc-macro-call-site-definition-module-id-for-state
  [state : TcMacroCallSiteState]
  [index : i64]) : i64
  (tc-macro-call-site-field-for-state
    state
    index
    2
    cbi.compiler-builtin-id-fix-empty))

(define (tc-macro-call-site-declaration-id-for-state
  [state : TcMacroCallSiteState]
  [index : i64]) : i64
  (tc-macro-call-site-field-for-state state index 3 -1))

(define (tc-macro-call-site-span-for-state
  [state : TcMacroCallSiteState]
  [index : i64]) : ast.AstSourceSpan
  (ast.ast-source-span
    (tc-macro-call-site-field-for-state state index 4 0)
    (tc-macro-call-site-field-for-state state index 5 0)
    (tc-macro-call-site-field-for-state state index 6 0)
    (tc-macro-call-site-field-for-state state index 7 0)))

(define (tc-macro-call-site-editable-for-state?
  [state : TcMacroCallSiteState]
  [index : i64]) : bool
  (= (tc-macro-call-site-field-for-state state index 8 0) 1))

(define (tc-macro-call-site-generator-for-state
  [state : TcMacroCallSiteState]
  [index : i64]) : String
  (tc-macro-call-site-text
    (tc-macro-call-site-field-for-state state index 9 -1)))

(define (tc-macro-call-site-item-for-state
  [state : TcMacroCallSiteState]
  [index : i64]) : String
  (tc-macro-call-site-text
    (tc-macro-call-site-field-for-state state index 10 -1)))

(define (tc-macro-call-site-key-for-state
  [state : TcMacroCallSiteState]
  [index : i64]) : String
  (tc-macro-call-site-text
    (tc-macro-call-site-field-for-state state index 11 -1)))

;; Internal macro/typecheck pass boundaries reset file lookup carriers but must
;; not tear down caller-owned inlay or retained-let-fact generations active for
;; the whole request. The explicit compiler file reset releases both.
(define (tc-job-state-reset-derived-caches! [state : TcJobState]) : unit
  (tc-source-key-cache-state-reset! (tc-job-state-source-key-cache state))
  (tc-topenv-membership-state-reset! (tc-job-state-topenv-membership state))
  (tc-thread-name-kind-state-reset! (tc-job-state-thread-name-kind state))
  (let
    [scoped-address : i64 (tc-job-state-type-env-scoped-state-address state)]
    (if (> scoped-address 0)
      (let
        [scoped-state : TcTypeEnvScopedState
          (TcTypeEnvScopedState scoped-address)]
        (tc-type-env-scoped-state-set-active! scoped-state false)
        (tc-type-env-scoped-cache-clear! scoped-state))
      unit))
  (tc-type-resolution-cache-state-reset!
    (tc-job-state-type-resolution-cache state)))

(define (tc-job-state-reset-file-state! [state : TcJobState]) : unit
  (tc-job-state-reset-advisories! state)
  (tc-job-state-reset-derived-caches! state)
  (tc-inlay-hints-reset-for-state! (tc-job-state-inlay-hints state))
  (tc-unused-unsafe-tracking-clear! (tc-job-state-unused-unsafe state))
  (tc-spmd-inline-helper-stack-reset-for-job! state))

;; Terminal job boundary. Every checked result and macro snapshot has already
;; been consumed. Unlike a reusable file reset, this releases storage whose
;; lazy replacement would otherwise wait for a next lookup that never occurs.
(define (tc-job-state-retire-owned-storage! [job : TcJobState]) : unit
  (let
    [state : TcMacroState (tc-job-state-macro-state job)]
    [layout-address : i64 (tc-job-state-agg-layout-cache-address job)]
    (when
      (> (tc-macro-state-slot-address state tc-macro-state-slot-walk) 0)
      (unless
        (= (tc-macro-walk-field state macro-hygiene-env-root-depth) 0)
        (io.panic "typecheck: cannot retire an active macro hygiene owner")))
    (tc-job-state-reset-advisories! job)
    (tc-job-state-release-scratch-arenas! job)
    (tc-checked-let-binding-facts-finish!
      (tc-job-state-checked-let-binding-facts job))
    (tc-inlay-hint-string-arena-release-for-state!
      (tc-job-state-inlay-hints job))
    (if (> layout-address 0)
      (tc-agg-layout-cache-storage-reset-for-state!
        (TcAggLayoutCacheState layout-address))
      unit)
    (if (> (tc-macro-state-slot-address state tc-macro-state-slot-clone) 0)
      (tc-clone-root-collection-abort! job)
      unit)
    (if (> (tc-macro-state-slot-address state tc-macro-state-slot-module-env) 0)
      (tc-hygiene-module-env-cache-release! state)
      unit)
    (when
      (> (tc-macro-state-slot-address state tc-macro-state-slot-walk) 0)
      (macro-live-symbols-clear! state)
      (macro-hygiene-env-storage-retire! state))
    ;; Empty-env construction in the preceding cache clears can lazily
    ;; recreate this owner. It must be the final typechecker operation.
    (tc-job-state-release-type-env-scoped-state! job)))

;; Scratch destruction is a lifetime boundary, not a generic cache reset.
;; Lowering performs internal file-state resets while a caller still owns an
;; outer region mark, so result boundaries invoke this operation explicitly.
(define (tc-job-state-release-scratch-arenas! [state : TcJobState]) : unit
  (tc-scratch-arena-state-release! (tc-job-state-scratch-arenas state)))

;; Scoped environments carry the state's address as a capability, so internal
;; pass resets may only clear it. A compiler result boundary has retired every
;; such environment and may destroy the dedicated dense-lane arena outright.
(define (tc-job-state-release-type-env-scoped-state! [state : TcJobState]) : unit
  (let
    [state-address : i64 (tc-job-state-type-env-scoped-state-address state)]
    [storage : i64 (tc-job-state-type-env-scoped-state-arena state)]
    (when
      (> state-address 0)
      ;; Invalidate the persistent job capability before releasing the memory
      ;; it names. The next environment lazily installs a fresh state/arena.
      (tc-job-state-set-type-env-scoped-state-address! state 0)
      (tc-job-state-set-type-env-scoped-state-arena! state 0)
      (if (> storage 0)
        (unsafe
          (arena.tl_arena_destroy storage))
        unit))))

;; Standalone source APIs and direct tests are serial compatibility surfaces.
;; The removed global scoped carrier initialized this adapter during startup;
;; do so explicitly to preserve that stable memory/profile boundary, while all
;; mutable cells—including scoped lookup/runtime state—remain owned by this
;; TcJobState. Production compiler jobs always pass their driver-owned state.
(define tc-serial-job-state-arena : i64
  (arena.tl_arena_make_small))
(define tc-serial-job-state-cell : (__tl_dyn-array TcJobState)
  (in-arena
    (arena.Arena tc-serial-job-state-arena)
    (let
      [cell : (__tl_dyn-array TcJobState) (__tl_make-array TcJobState 1)]
      [state : TcJobState (tc-job-state-new)]
      (set! (array-ref cell 0) state)
      (tc-job-state-type-env-scoped-state state)
      cell)))

(define (tc-serial-job-state) : TcJobState
  (array-ref tc-serial-job-state-cell 0))

;; Replace the serial compatibility job state. Only this module writes its
;; globals; harnesses that nest a job restore the parent through this function.
(define (tc-serial-job-state-set! [state : TcJobState]) : unit
  (set! (array-ref tc-serial-job-state-cell 0) state))

(define (tc-serial-job-state-reset-if-ready!) : unit
  (tc-job-state-reset-file-state! (array-ref tc-serial-job-state-cell 0)))

(defstruct TcBodyStateData
  (type-facts-recording bool)
  (type-facts-consuming bool)
  (type-fact-index (__tl_dyn-array i64))
  (type-fact-expr-ids (__tl_dyn-array i64))
  (type-fact-types (__tl_dyn-array ast.AstType))
  ;; Parallel to type-fact-types. Zero means no checker-only concrete closure
  ;; fact has been computed for this expression; encoded facts start at 16.
  ;; Move analysis populates a lambda body slot once, and the later borrow and
  ;; tail-escape walks reuse it instead of recursively rechecking the lambda.
  (type-fact-closure-codes (__tl_dyn-array i64))
  (type-fact-count i64)
  (type-fact-storage-arena i64)
  (type-fact-enclosing-arena i64)
  (early-exit-facts-collecting bool)
  (early-exit-facts-ready bool)
  (early-exit-current bool)
  (early-exit-suppress-depth i64)
  (early-exit-source-expr-limit i64)
  (early-exit-facts (__tl_dyn-array i64))
  (early-exit-known (__tl_dyn-array i64))
  ;; The contextual type body typing gave each annotated let binding's value,
  ;; keyed by the value's node id; see tc-body-let-init-type-record!.
  (let-init-ids (__tl_dyn-array i64))
  (let-init-types (__tl_dyn-array ast.AstType))
  (let-init-count i64)
  ;; The address of the one-slot TcMoveBreakCollection cell; see
  ;; tc-body-move-breaks-swap!.
  (move-breaks-cell i64)
  (move-operand-control bool)
  (move-operand-edges bool)
  ;; By-value parameters written in place (#7901). `param-facts` holds what
  ;; each checked body recorded: under its node id, the mask of written
  ;; parameter positions that lowering reads (tc-body-param-write-fact); under
  ;; tc-body-mut-borrow-key, each root it borrows `&mut`; under
  ;; tc-body-memory-class-key, whether a nominal name needs private parameter
  ;; storage (tc-body-param-storage-name?); and under tc-body-param-note-key,
  ;; the names noted during the current move check, the first
  ;; `param-writes-count`. A noted name `-1 - name` is a local root the body
  ;; borrows `&mut` rather than a written parameter.
  (param-writes-count i64)
  (param-facts tc_i64_i64_map.Map)
  ;; These outlive every function's scratch arena, so they grow in the arena
  ;; the facts started in; 0 until then, when nothing is recorded.
  (param-write-arena i64)
  ;; The address of the one-slot TcBorrowLoopExits cell; see
  ;; tc-body-borrow-exits-swap!.
  (borrow-exits-cell i64))

;; TcContext values are copied while resolving modules and rebuilding macro
;; views. Keep the mutable body analysis behind a shared one-slot cell so every
;; derived context for one job observes the same state without consulting a
;; process-global selector.
(defstruct TcBodyState
  ;; The one-slot TcBodyStateData cell; see tc-state-cell-read.
  (address i64)
  (job-state TcJobState)
  ;; Cache the inlay capability and enabled bit at body construction. The
  ;; ordinary disabled path then pays only this body-local flag check.
  (inlay-hint-state TcInlayHintState)
  (inlay-hint-enabled bool)
  ;; The source-name owner is immutable for one typecheck body. Cache it here
  ;; so hot source-key lookups do not repeatedly traverse TcContext and the
  ;; intern session handle just to validate the job-owned tables.
  (intern-table-id i64)
  (intern-generation i64))

;; The part of a typecheck context that every context derived from one root
;; shares. Only the root constructors allocate it, in the owning job's
;; lifetime arena; the `tc-context-with-*` derivations reuse it. The leading
;; words hold the addresses of the three fields that accessors hand out by
;; reference, so each is one load at a constant offset (an address-taken local
;; would keep the accessor from being inlined); `symbols-address` comes first.
(defstruct TcContextShared
  (symbols-address u64)
  (registries-address u64)
  (pools-address u64)
  (symbols csym.CompilerSymbols)
  (registries csym.CompilerRegistries)
  (pools ast.AstNodePoolContext)
  (source-names ci.InternSourceNameSessionHandle)
  (body-state TcBodyState)
  (semantic-observer TcSemanticObserver))

;; A typecheck context is a Copy handle: the address of its TcContextShared
;; block, the body's job state (the most frequently read capability) and the
;; fields that differ between derived contexts, so deriving a context for
;; another module or program allocates nothing. `module` and `program-decls`
;; hold the bits of the module-name String and of the program's
;; declaration-list Box; their owners keep them alive, as they did for the
;; shallow copies of the former by-value context.
(defstruct TcContext
  (shared u64)
  (job-state TcJobState)
  (module-id i64)
  (type-module-id i64)
  (module u64)
  (program-decls u64))

;; Observations borrow the exact checked context and environment only for the
;; callback. Consumers copy payloads before function scratch or pools retire.
;; Only the final checked-program body installs an observer; macro probes and
;; compatibility contexts retain the zero capability.
(defstruct TcSemanticObserver
  (address i64))

(defenum TcSemanticEvent
  (ExpansionEnter i64 i64 ast.AstSourceSpan)
  (ExpansionLeave)
  (ResolvedMember i64)
  (Reference i64 bool)
  (ScopeEnter i64)
  (ScopeLeave)
  (SpmdEnter)
  (SpmdLeave)
  (ExpressionEnter i64)
  (Expression i64 ResultTcType bool)
  (Declaration i64 i64 String ast.AstDecl)
  (FunctionEnter i64 i64 ast.AstParamList ast.AstMaybeType)
  (FunctionLeave ResultTcType)
  (Binding i64 i64 i64 i64 i64 ast.AstType)
  (BindingSite TcMaybeAstSourceSpan)
  (BindingMaterialized i64 i64 i64 i64 i64)
  (BindingImported i64 i64 i64 i64 i64)
  (PersistentReference i64 i64))

;; Expansion wrappers can be checked by value. Publish their provenance around
;; the existing evaluation, before the transparent wrapper is discarded.
(defmacro (tc-semantic-expansion
  [ctx : Expr]
  [env : Expr]
  [origin : Expr]
  [name : Expr]
  [span : Expr]
  [body : Expr]) : Expr
  `(if (or
    (= tc-semantic-observed-jobs 0)
    (= (tc-context-semantic-observer ,ctx).address 0))
    ,body
    (let
      [_enter : unit
        (tc-semantic-observer-send!
          (tc-context-semantic-observer ,ctx)
          ,ctx
          ,env
          (TcSemanticEvent.ExpansionEnter ,origin ,name ,span))]
      [result : ResultTcType ,body]
      (tc-semantic-observer-send!
        (tc-context-semantic-observer ,ctx)
        ,ctx
        ,env
        TcSemanticEvent.ExpansionLeave)
      result)))

;; SPMD classification rechecks source operands by value. Keep its policy scope
;; around the existing calls even when those operands have no source wrapper.
(defmacro (tc-semantic-spmd [ctx : Expr] [env : Expr] [body : Expr]) : Expr
  `(let
    [observer : TcSemanticObserver
      (if (= tc-semantic-observed-jobs 0)
        (TcSemanticObserver 0)
        (tc-context-semantic-observer ,ctx))]
    [_enter : unit
      (when
        (!= observer.address 0)
        (tc-semantic-observer-send!
          observer
          ,ctx
          ,env
          TcSemanticEvent.SpmdEnter))]
    [result ,body]
    (when
      (!= observer.address 0)
      (tc-semantic-observer-send! observer ,ctx ,env TcSemanticEvent.SpmdLeave))
    result))

(defstruct TcSemanticObserverData
  (context i64)
  (callback (-> i64 TcContext TcTypeEnv TcSemanticEvent unit))
  (active-context TcContext))

(define (tc-semantic-observer-new
  [context : i64]
  [callback : (-> i64 TcContext TcTypeEnv TcSemanticEvent unit)]) : TcSemanticObserver
  (let
    [cell : (__tl_dyn-array i64)
      (__tl_make-array
        i64
        (/ (+ (comptime (size-of (type TcSemanticObserverData))) 7) 8))]
    (unsafe
      (ptr-write!
        (ptr-cast (__tl_array-data cell) : (MutPtr TcSemanticObserverData))
        (TcSemanticObserverData
          context
          callback
          (TcContext 0 (TcJobState 0) 0 0 0 0))))
    (TcSemanticObserver
      (cast
        (unsafe
          (ptr->int (__tl_array-data cell)))
        : i64))))

(define (tc-semantic-observer-send!
  [observer : TcSemanticObserver]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [event : TcSemanticEvent]) : unit
  (let
    [data : TcSemanticObserverData
      (tc-state-cell-read observer.address TcSemanticObserverData)]
    (set! data.active-context ctx)
    (unsafe
      (ptr-write!
        (int->ptr
          (cast observer.address : u64)
          : (MutPtr TcSemanticObserverData))
        data))
    (data.callback data.context ctx env event)))

(define (tc-context-set-semantic-observer!
  [ctx : TcContext]
  [observer : TcSemanticObserver]) : unit
  (unsafe
    (ptr-write!
      (ptr-cast
        (ptr-offset
          (int->ptr ctx.shared : (MutPtr u8))
          (comptime (offset-of (type TcContextShared) semantic-observer)))
        : (MutPtr TcSemanticObserver))
      observer)))

(define (tc-scoped-state-set-semantic-observer!
  [state : TcTypeEnvScopedState]
  [observer : TcSemanticObserver]) : unit
  (unless
    (= state.address 0)
    (unsafe
      (ptr-write!
        (ptr-cast
          (ptr-offset
            (int->ptr (cast state.address : u64) : (MutPtr u8))
            (comptime
              (offset-of (type TcTypeEnvScopedStateData) semantic-observer)))
          : (MutPtr TcSemanticObserver))
        observer))))

;; Keep the disabled reference path in its caller, before callback arguments
;; or event storage become live. The shared send function is reached only for
;; the final checked body that owns an observer.
(defmacro (tc-semantic-observe-reference!
  [ctx : Expr]
  [env : Expr]
  [key : Expr]
  [global : Expr]) : Expr
  `(when
    (> tc-semantic-observed-jobs 0)
    (tc-semantic-observe-reference-active! ,ctx ,env ,key ,global)))

(define (tc-semantic-observe-reference-active!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [key : i64]
  [global : bool]) : unit
  (let
    [observer : TcSemanticObserver (tc-context-semantic-observer ctx)]
    (when
      (!= observer.address 0)
      (tc-semantic-observer-send! observer ctx env (Reference key global)))))

(define (tc-semantic-observe-enter!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expression : i64]) : unit
  (tc-semantic-observer-send!
    (tc-context-semantic-observer ctx)
    ctx
    env
    (ExpressionEnter expression)))

(define (tc-job-state-semantic-observer [state : TcJobState]) : TcSemanticObserver
  (tc-job-state-field state semantic-observer TcSemanticObserver))

(define tc-semantic-observed-jobs : i64
  0)

;; Job scopes bracket observation even when a discarded nested check clears
;; its context observer. Nested jobs cannot disable an outer requested job.
(define (tc-job-state-set-semantic-observer!
  [state : TcJobState]
  [observer : TcSemanticObserver]) : unit
  (let
    [previous : TcSemanticObserver (tc-job-state-semantic-observer state)]
    (unless
      (= previous.address observer.address)
      (when
        (= previous.address 0)
        (set! tc-semantic-observed-jobs (+ tc-semantic-observed-jobs 1)))
      (when
        (= observer.address 0)
        (set! tc-semantic-observed-jobs (- tc-semantic-observed-jobs 1)))
      (unsafe
        (ptr-write!
          (ptr-cast
            (ptr-offset
              (int->ptr (cast state.address : u64) : (MutPtr u8))
              (comptime (offset-of (type TcJobStateData) semantic-observer)))
            : (MutPtr TcSemanticObserver))
          observer)))))

(define (tc-semantic-observe-expression!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]
  [result : ResultTcType]) : unit
  (tc-semantic-observer-send!
    (tc-context-semantic-observer ctx)
    ctx
    env
    (Expression expr-id result tc-poison-observed)))

;; Read one field of the shared block with a single load at its offset;
;; accessors never copy the whole block.
(defmacro (tc-context-shared-field [ctx : Expr] [field : Expr] [_T : type]) : Expr
  `(unsafe
    (ptr-read
      (int->ptr
        (+
          ,(comptime.expr-struct-get ctx "shared")
          (cast (comptime (offset-of (type TcContextShared) ,field)) : u64))
        : (Ptr ,_T)))))

(define (tc-context-symbols [ctx : (& ctx TcContext)]) : (&
    ctx
    csym.CompilerSymbols)
  (unsafe
    (ptr-read (int->ptr ctx.shared : (Ptr (& ctx csym.CompilerSymbols))))))

(define (tc-context-symbols-ref [ctx : (& ctx TcContext)]) : (&
    ctx
    csym.CompilerSymbols)
  (tc-context-symbols ctx))

(define (tc-context-registries [ctx : (& ctx TcContext)]) : (&
    ctx
    csym.CompilerRegistries)
  (unsafe
    (ptr-read
      (int->ptr
        (+
          ctx.shared
          (cast
            (comptime (offset-of (type TcContextShared) registries-address))
            : u64))
        : (Ptr (& ctx csym.CompilerRegistries))))))

(define (tc-context-pools-ref [ctx : (& ctx TcContext)]) : (&
    ctx
    ast.AstNodePoolContext)
  (unsafe
    (ptr-read
      (int->ptr
        (+
          ctx.shared
          (cast
            (comptime (offset-of (type TcContextShared) pools-address))
            : u64))
        : (Ptr (& ctx ast.AstNodePoolContext))))))

;; By-value shallow view for helpers that still take CompilerSymbols by value.
(define (tc-context-symbols-view [ctx : TcContext]) : csym.CompilerSymbols
  (tc-context-shared-field ctx symbols csym.CompilerSymbols))

(define (tc-context-module [ctx : TcContext]) : String
  (unsafe
    (ptr-read (ptr-cast (ptr-addr-of ctx.module) : (Ptr String)))))

(define (tc-context-module-id [ctx : TcContext]) : i64
  ctx.module-id)

(define (tc-context-type-module-id [ctx : TcContext]) : i64
  ctx.type-module-id)

(define (tc-context-program [ctx : TcContext]) : ast.AstProgram
  (Program
    (unsafe
      (ptr-read
        (ptr-cast (ptr-addr-of ctx.program-decls) : (Ptr (Box ast.AstDeclList)))))))

(define (tc-context-source-names [ctx : TcContext]) : ci.InternSourceNameSessionHandle
  (tc-context-shared-field ctx source-names ci.InternSourceNameSessionHandle))

(define (tc-context-body-state [ctx : TcContext]) : TcBodyState
  (tc-context-shared-field ctx body-state TcBodyState))

(define (tc-context-semantic-observer [ctx : TcContext]) : TcSemanticObserver
  (tc-context-shared-field ctx semantic-observer TcSemanticObserver))

(define (tc-context-job-state [ctx : TcContext]) : TcJobState
  ctx.job-state)

(define (tc-context-string-bits [text : String]) : u64
  (unsafe
    (ptr-read (ptr-cast (ptr-addr-of text) : (Ptr u64)))))

(define (tc-context-program-bits [program : ast.AstProgram]) : u64
  (match program
    [(Program decls-box)
      (unsafe
        (ptr-read (ptr-cast (ptr-addr-of decls-box) : (Ptr u64))))]))

;; Typechecker pool reads follow the context's own pools and ignore a
;; compatibility pool context, so none may be active when a root context is
;; created. Lint, the only production user, clears its compatibility context
;; around the checks it runs. Empty when creation is allowed.
(define (tc-context-compat-guard-message) : String
  (if (ast.ast-node-pool-compat-context-active?)
    "typecheck: a typecheck context was created while a compatibility pool context is active"
    ""))

;; Allocate a root context's shared block in the job's lifetime arena, which
;; outlives every context of the job (a caller's scratch arena might not).
(define (tc-context-shared-new
  [job-state : TcJobState]
  [shared : TcContextShared]) : u64
  (let
    [guard : String (tc-context-compat-guard-message)]
    [_guard : unit (when (> (string.string-length guard) 0) (io.panic guard))]
    [owner : i64 (tc-job-state-field job-state owner-arena i64)]
    [home : i64 (arena.tl_arena_current)]
    [_enter : unit
      (if (= owner 0)
        unit
        (unsafe
          (arena.tl_arena_set owner)))]
    [block : (Box TcContextShared) (box shared)]
    [_leave : unit
      (if (= owner 0)
        unit
        (unsafe
          (arena.tl_arena_set home)))]
    [address : u64
      (unsafe
        (ptr-read (ptr-cast (ptr-addr-of block) : (Ptr u64))))]
    (tc-context-shared-address-set!
      address
      (comptime (offset-of (type TcContextShared) symbols-address))
      (comptime (offset-of (type TcContextShared) symbols)))
    (tc-context-shared-address-set!
      address
      (comptime (offset-of (type TcContextShared) registries-address))
      (comptime (offset-of (type TcContextShared) registries)))
    (tc-context-shared-address-set!
      address
      (comptime (offset-of (type TcContextShared) pools-address))
      (comptime (offset-of (type TcContextShared) pools)))
    address))

(define (tc-context-shared-address-set!
  [address : u64]
  [slot-offset : i64]
  [field-offset : i64]) : unit
  (unsafe
    (ptr-write!
      (int->ptr (+ address (cast slot-offset : u64)) : (MutPtr u64))
      (+ address (cast field-offset : u64)))))

(define (tc-context-expr-cell-address-live [ctx : TcContext]) : u64
  (let
    [pools : ast.AstNodePoolContext
      (tc-context-shared-field ctx pools ast.AstNodePoolContext)]
    (ast.ast-pool-cell-data pools.expr-pool)))

(define (tc-context-type-cell-address-live [ctx : TcContext]) : u64
  (let
    [pools : ast.AstNodePoolContext
      (tc-context-shared-field ctx pools ast.AstNodePoolContext)]
    (ast.ast-pool-cell-data pools.type-pool)))

(define (tc-context-expr-push-cell-addresses
  [expr-cell-address : u64]
  [type-cell-address : u64]
  [node : ast.AstExpr]) : i64
  (ast.ast-node-pool-context-expr-push-cells
    expr-cell-address
    type-cell-address
    (& node)))

(defenum TcUnboundSuggestionSnapshot
  (No)
  (Some bool i64 TcTypeEnv i64))

(define tc-unbound-suggestion-snapshot : TcUnboundSuggestionSnapshot
  (No))

(define (tc-unbound-suggestion-snapshot-reset!) : unit
  (set! tc-unbound-suggestion-snapshot (TcUnboundSuggestionSnapshot.No)))

(define (tc-unbound-suggestion-snapshot-record!
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : unit
  (set!
    tc-unbound-suggestion-snapshot
    (TcUnboundSuggestionSnapshot.Some
      (> (string.string-length (tc-context-module ctx)) 0)
      (tc-unbound-suggestion-scope-module-id ctx name-id)
      env
      name-id)))

(define (tc-context-new-with-source-names-and-job-state
  [program : ast.AstProgram]
  [symbols : csym.CompilerSymbols]
  [registries : csym.CompilerRegistries]
  [module : String]
  [module-id : i64]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [job-state : TcJobState]) : TcContext
  (tc-type-resolution-cache-bind-pools-for-job! job-state pools)
  (TcContext
    (tc-context-shared-new
      job-state
      (TcContextShared
        0
        0
        0
        symbols
        registries
        pools
        source-names
        (tc-body-state-new-with-job-state-and-source-names
          job-state
          source-names)
        (TcSemanticObserver 0)))
    job-state
    module-id
    module-id
    (tc-context-string-bits module)
    (tc-context-program-bits program)))

(define (tc-context-new-with-source-names
  [program : ast.AstProgram]
  [symbols : csym.CompilerSymbols]
  [registries : csym.CompilerRegistries]
  [module : String]
  [module-id : i64]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]) : TcContext
  (tc-context-new-with-source-names-and-job-state
    program
    symbols
    registries
    module
    module-id
    pools
    source-names
    (tc-serial-job-state)))

(define (tc-context-new-with-source-names-and-body-state
  [program : ast.AstProgram]
  [symbols : csym.CompilerSymbols]
  [registries : csym.CompilerRegistries]
  [module : String]
  [module-id : i64]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [body-state : TcBodyState]
  [observer : TcSemanticObserver]) : TcContext
  (let
    [job-state : TcJobState body-state.job-state]
    [_bind : unit
      (tc-type-resolution-cache-bind-pools-for-job! job-state pools)]
    (TcContext
      (tc-context-shared-new
        job-state
        (TcContextShared
          0
          0
          0
          symbols
          registries
          pools
          source-names
          body-state
          observer))
      job-state
      module-id
      module-id
      (tc-context-string-bits module)
      (tc-context-program-bits program))))

(define (tc-context-new
  [program : ast.AstProgram]
  [symbols : csym.CompilerSymbols]
  [registries : csym.CompilerRegistries]
  [module : String]
  [module-id : i64]
  [pools : ast.AstNodePoolContext]) : TcContext
  (tc-context-new-with-source-names
    program
    symbols
    registries
    module
    module-id
    pools
    (ci.intern-source-name-session-capture-active-handle)))

(defenum ResultTcType
  (Ok ast.AstType)
  (Err String))

;; Core Slice subview calls are recognized as a small call-local operation,
;; rather than an additional AST node.  Keeping the classifier in one place
;; lets typechecking, move checking, and borrow checking agree on both
;; spellings and on the ordinary-name shadowing rule.  The private
;; `__tl_bytes-view`/`__tl_bytes-mut-view` kinds are the same checked subview
;; over a byte source (u8 array, `str`, `bytes`) whose result is a borrowed
;; `bytes` view instead of a Slice; stdlib builds every byte view with them.
(defenum TcSliceViewCallKind
  (None)
  (Shared)
  (Mutable)
  (SplitShared)
  (SplitMutable)
  (BytesShared)
  (BytesMutable))

;; Source shape accepted by the Slice subview builtins.  `Direct` is a genuine
;; Array/DynArray place; `Borrow` carries the source reference lifetime,
;; mutability, and its immediate referent.  Bare Slice values never appear in
;; this enum because they have no owning/value representation.
(defenum TcSliceViewSourceInfo
  (Invalid)
  (Direct ast.AstType)
  (Borrow i64 bool ast.AstType))

(define tc-poison-type-name-id : i64
  -1000000007)
(define tc-poison-observed : bool
  false)

(define (tc-poison-type) : ast.AstType
  (Var tc-poison-type-name-id))

(define (tc-poison-type? [ty : ast.AstType]) : bool
  (match ty
    [(Var name) (= name tc-poison-type-name-id)]
    [_ false]))

(define (tc-poison-observation-reset!) : unit
  (set! tc-poison-observed false))

(define (tc-poison-observation-note! [ty : ast.AstType]) : unit
  (if (tc-poison-type? ty)
    (set! tc-poison-observed true)
    unit))

(defenum TcInferredTypeMatch
  (Compatible ast.AstType)
  (Mismatch ast.AstType))

(defenum TcBinOpTypes
  (TcBinOpTypes ast.AstType ast.AstType ast.AstType))

(defenum ResultTcBinOpTypes
  (Ok TcBinOpTypes)
  (Err String))

(defenum ResultTcTypeUnsafe
  (Ok ast.AstType bool)
  (Err String))

(defenum ResultTcTypeList
  (Ok ast.AstTypeList)
  (Err String))

(defenum ResultTcExprList
  (Ok ast.AstExprList)
  (Err String))

(defenum ResultTcExpr
  (Ok ast.AstExpr)
  (Err String))

(defenum ResultTcExprId
  (Ok i64)
  (Err String))

(defenum TcBodyTypeFact
  (Hit ast.AstType)
  (Miss))

(defenum TcBodyEarlyExitFact
  (Known bool)
  (Unknown))

;; Dense source-expression id -> (fact slot + 1) index. Each function clears
;; only ids it touched, recorded in the parallel expr-id buffer, so body
;; boundaries neither allocate nor zero a capacity-sized hashmap. Expression
;; ids synthesized after the source-pool snapshot simply miss and use the
;; existing conservative reinference path.
;; Lower's call-slot RVO needs one semantic fact per function body: whether a
;; runtime `return` or `try` occurs anywhere in it. The move checker already
;; visits the complete runtime body (including nested lambdas), so recording the
;; bit there avoids a second recursive AST walk in lower. Facts are keyed by the
;; stable body node id. Bodies synthesized after source typecheck are absent and
;; lower falls back to its conservative scanner for those only.
(define (tc-body-state-new-with-job-state-and-source-names
  [job-state : TcJobState]
  [source-names : ci.InternSourceNameSessionHandle]) : TcBodyState
  (let
    [cell : (__tl_dyn-array TcBodyStateData)
      (__tl_make-array TcBodyStateData 1)]
    [source-session : ci.InternSourceNameSession
      (ci.intern-source-name-session-handle-session source-names)]
    (set!
      (array-ref cell 0)
      (TcBodyStateData
        false
        false
        (__tl_make-array i64 1)
        (__tl_make-array i64 1)
        (__tl_make-array ast.AstType 1)
        (__tl_make-array i64 1)
        0
        0
        0
        false
        false
        false
        0
        -1
        (__tl_make-array i64 1)
        (__tl_make-array i64 1)
        (tc-global-shared-view tc-body-let-init-no-ids)
        (tc-global-shared-view tc-body-let-init-no-types)
        0
        (tc-move-break-collection-cell-new)
        false
        false
        0
        (tc_i64_i64_map.with-capacity 0)
        0
        (tc-borrow-loop-exits-cell-new)))
    (TcBodyState
      (cast
        (unsafe
          (ptr->int (ptr-cast (__tl_array-data cell) : (Ptr TcBodyStateData))))
        : i64)
      job-state
      (tc-job-state-inlay-hints job-state)
      (unsafe
        (deref (tc-inlay-hint-state-view (tc-job-state-inlay-hints job-state))).enabled)
      source-session.table-id
      source-session.reset-generation)))

(define (tc-body-state-ptr [state : TcBodyState]) : (MutPtr TcBodyStateData)
  (tc-state-cell-ptr state.address TcBodyStateData))

(define (tc-body-state-view [state : TcBodyState]) : (Ptr TcBodyStateData)
  (tc-state-cell-view state.address TcBodyStateData))

(define (tc-body-state-data-value [state : TcBodyState]) : TcBodyStateData
  (tc-state-cell-read state.address TcBodyStateData))

(define (tc-body-state-data-set! [state : TcBodyState] [data : TcBodyStateData]) : unit
  (tc-state-cell-write! state.address TcBodyStateData data))

(define (tc-body-early-exit-facts-start-with-limit!
  [state : TcBodyState]
  [expr-limit : i64]) : unit
  (let
    [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    (unsafe
      (set!
        (deref data).early-exit-facts
        (__tl_make-array i64 (/ (+ expr-limit 63) 64)))
      (set!
        (deref data).early-exit-known
        (__tl_make-array i64 (/ (+ expr-limit 63) 64)))
      (set! (deref data).early-exit-current false)
      (set! (deref data).early-exit-suppress-depth 0)
      (set! (deref data).early-exit-source-expr-limit expr-limit)
      (set! (deref data).early-exit-facts-ready false)
      (set! (deref data).early-exit-facts-collecting true)
      (set! (deref data).param-writes-count 0)
      (set! (deref data).param-facts (tc_i64_i64_map.with-capacity 128))
      (set! (deref data).param-write-arena (arena.tl_arena_current)))
    (tc-body-type-fact-storage-start! state expr-limit)))

(define (tc-body-early-exit-facts-start!
  [state : TcBodyState]
  [pools : ast.AstNodePoolContext]) : unit
  (tc-body-early-exit-facts-start-with-limit!
    state
    (ast.ast-node-pool-context-expr-len pools)))

(define (tc-body-early-exit-facts-finish! [state : TcBodyState]) : unit
  (let
    [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    (unsafe
      (set! (deref data).early-exit-facts-collecting false)
      (set! (deref data).early-exit-facts-ready true))
    (tc-body-type-fact-storage-release! state)))

(define (tc-body-early-exit-facts-abort! [state : TcBodyState]) : unit
  (let
    [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    (unsafe
      (set! (deref data).early-exit-facts-collecting false)
      (set! (deref data).early-exit-facts-ready false)
      (set! (deref data).early-exit-current false)
      (set! (deref data).early-exit-suppress-depth 0)
      (set! (deref data).early-exit-source-expr-limit -1))
    (tc-body-type-fact-storage-release! state)))

(define (tc-body-early-exit-function-start! [state : TcBodyState]) : unit
  (let
    [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    (unsafe
      (if (deref data).early-exit-facts-collecting
        (begin
          (set! (deref data).early-exit-current false)
          (set! (deref data).early-exit-suppress-depth 0))
        unit))))

(define (tc-body-early-exit-function-finish!
  [state : TcBodyState]
  [body-id : i64]) : unit
  (let
    [data : TcBodyStateData (tc-body-state-data-value state)]
    (if (and
      data.early-exit-facts-collecting
      (>= body-id 0)
      (< body-id data.early-exit-source-expr-limit))
      (let
        [word-index : i64 (/ body-id 64)]
        [bit-index : i64 (% body-id 64)]
        [bit : i64 (shl 1 bit-index)]
        (set!
          (array-ref data.early-exit-known word-index)
          (bit-or (array-ref data.early-exit-known word-index) bit))
        (if data.early-exit-current
          (set!
            (array-ref data.early-exit-facts word-index)
            (bit-or (array-ref data.early-exit-facts word-index) bit))
          unit))
      unit)))

(define (tc-body-early-exit-note! [state : TcBodyState]) : unit
  (let
    [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    (unsafe
      (if (and
        (deref data).early-exit-facts-collecting
        (= (deref data).early-exit-suppress-depth 0))
        (set! (deref data).early-exit-current true)
        unit))))

;; The move checker's loop walker hands a loop-body form it has no arm for (a
;; call, operator, `set!`, constructor, `return` value, ...) to the non-loop
;; walker, which takes a `break` nested in it as divergence and so drops the
;; moved state on that exit edge (#8575). The loop walker therefore opens a
;; collecting frame around such a form, each `break` the non-loop walker
;; reaches unions its moved set into the innermost frame, and the walker
;; reports the frame as the form's break state. A loop body entered from the
;; non-loop walker opens a frame that does not collect, so the `break`s it
;; reaches stay with that inner loop. Frames nest: opening one swaps out the
;; enclosing frame, and closing it swaps that frame back.
;;
;; A `break` or `continue` reached in a collecting frame also sets
;; `move-operand-control`: the loop flow summaries skip operands, so such a
;; body is walked again with `move-operand-edges` set (see
;; `tc-move-check-body-walk`).
(define (tc-body-move-breaks-cell [state : TcBodyState]) : i64
  (let
    [data : (Ptr TcBodyStateData) (tc-body-state-view state)]
    (unsafe
      (deref data).move-breaks-cell)))

;; Installs `next` as the innermost frame and returns the frame it replaces.
;; The frame read from the cell is rebuilt into fresh storage before the write,
;; since a bound aggregate read still aliases its source (#7900).
(define (tc-body-move-breaks-swap!
  [state : TcBodyState]
  [next : TcMoveBreakCollection]) : TcMoveBreakCollection
  (let
    [cell : i64 (tc-body-move-breaks-cell state)]
    [read : TcMoveBreakCollection
      (tc-state-cell-read cell TcMoveBreakCollection)]
    [replaced : TcMoveBreakCollection
      (TcMoveBreakCollection read.collecting read.seen read.moved)]
    (tc-state-cell-write! cell TcMoveBreakCollection next)
    replaced))

;; A `break` (with its moved set) or a `continue` (without one) reached by the
;; non-loop walker.
(define (tc-body-move-loop-exit-note!
  [state : TcBodyState]
  [break-moved : (& break-moved TcMovedSet)]
  [break? : bool]) : unit
  (let
    [cell : i64 (tc-body-move-breaks-cell state)]
    [frame : TcMoveBreakCollection
      (tc-state-cell-read cell TcMoveBreakCollection)]
    (if frame.collecting
      (begin
        (tc-body-move-operand-control-set! state true)
        (if break?
          (tc-state-cell-write!
            cell
            TcMoveBreakCollection
            (TcMoveBreakCollection
              true
              true
              (if frame.seen
                (tc-moved-union (& frame.moved) (tc-moved-clone break-moved))
                (tc-moved-clone break-moved))))
          unit))
      unit)))

;; The borrow checker's loop-path walker likewise hands a form it has no arm for
;; to the non-loop walker, which treated a `break` or `continue` nested in it
;; as divergence, so the borrow state on that exit edge never reached the join
;; after the loop (#8671). The walker opens a collecting frame around such a
;; form; each `break` and `continue` the non-loop walker reaches unions its
;; borrowed set into the innermost frame's break or repeat state, which become
;; the form's edges. A loop body entered from the non-loop walker opens a frame
;; that does not collect, so its exits stay with that loop. Frames nest as the
;; move checker's do.
(define (tc-body-borrow-exits-cell [state : TcBodyState]) : i64
  (let
    [data : (Ptr TcBodyStateData) (tc-body-state-view state)]
    (unsafe
      (deref data).borrow-exits-cell)))

;; Installs `next` as the innermost frame and returns the frame it replaces,
;; rebuilt into fresh storage before the write (#7900).
(define (tc-body-borrow-exits-swap!
  [state : TcBodyState]
  [next : TcBorrowLoopExits]) : TcBorrowLoopExits
  (let
    [cell : i64 (tc-body-borrow-exits-cell state)]
    [read : TcBorrowLoopExits (tc-state-cell-read cell TcBorrowLoopExits)]
    [replaced : TcBorrowLoopExits
      (TcBorrowLoopExits
        read.collecting
        read.breaks
        read.break-borrowed
        read.repeats
        read.repeat-borrowed)]
    (tc-state-cell-write! cell TcBorrowLoopExits next)
    replaced))

;; Opens a collecting frame and returns the frame it replaces, which the caller
;; reinstalls with tc-body-borrow-exits-swap! once the collected form is checked.
(define (tc-body-borrow-exits-collect! [state : TcBodyState]) : TcBorrowLoopExits
  (tc-body-borrow-exits-swap! state (tc-borrow-loop-exits-new true)))

;; A `break` (`break?`) or `continue` the non-loop borrow walker reached with
;; `borrowed` live.
(define (tc-body-borrow-loop-exit-note!
  [state : TcBodyState]
  [borrowed : (& borrowed TcMovedSet)]
  [break? : bool]) : unit
  (let
    [cell : i64 (tc-body-borrow-exits-cell state)]
    [frame : TcBorrowLoopExits (tc-state-cell-read cell TcBorrowLoopExits)]
    (when
      frame.collecting
      (tc-state-cell-write!
        cell
        TcBorrowLoopExits
        (if break?
          (TcBorrowLoopExits
            true
            true
            (if frame.breaks
              (tc-moved-union
                (& frame.break-borrowed)
                (tc-moved-clone borrowed))
              (tc-moved-clone borrowed))
            frame.repeats
            frame.repeat-borrowed)
          (TcBorrowLoopExits
            true
            frame.breaks
            frame.break-borrowed
            true
            (if frame.repeats
              (tc-moved-union
                (& frame.repeat-borrowed)
                (tc-moved-clone borrowed))
              (tc-moved-clone borrowed))))))))

(define (tc-body-move-operand-control? [state : TcBodyState]) : bool
  (let
    [data : (Ptr TcBodyStateData) (tc-body-state-view state)]
    (unsafe
      (deref data).move-operand-control)))

(define (tc-body-move-operand-control-set! [state : TcBodyState] [on : bool]) : unit
  (let
    [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    (unsafe
      (set! (deref data).move-operand-control on))))

(define (tc-body-move-operand-edges? [state : TcBodyState]) : bool
  (let
    [data : (Ptr TcBodyStateData) (tc-body-state-view state)]
    (unsafe
      (deref data).move-operand-edges)))

(define (tc-body-move-operand-edges-set! [state : TcBodyState] [on : bool]) : unit
  (let
    [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    (unsafe
      (set! (deref data).move-operand-edges on))))

;; Note a name for the current move check (see TcBodyStateData).
(define (tc-body-move-note-push! [state : TcBodyState] [entry : i64]) : unit
  (let
    [view : (Ptr TcBodyStateData) (tc-body-state-view state)]
    [ptr : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    [arena-id : i64
      (unsafe
        (deref view).param-write-arena)]
    (when
      (!= arena-id 0)
      (in-arena
        (arena.Arena arena-id)
        (let
          [count : i64
            (unsafe
              (deref view).param-writes-count)]
          [notes : tc_i64_i64_map.Map
            (unsafe
              (deref view).param-facts)]
          (tc_i64_i64_map.insert-ref!
            (&mut notes)
            (tc-body-param-note-key count)
            entry)
          (unsafe
            (set! (deref ptr).param-facts notes)
            (set! (deref ptr).param-writes-count (+ count 1))))))))

;; The `param-facts` key of the move check's noted name at `index`: bits 61
;; and 60 are 11 (see tc-body-mut-borrow-key).
(define (tc-body-param-note-key [index : i64]) : i64
  (bit-or index 3458764513820540928))

;; The noted name at `index` (see TcBodyStateData).
(define (tc-body-param-note [state : TcBodyState] [index : i64]) : i64
  (let
    [view : (Ptr TcBodyStateData) (tc-body-state-view state)]
    [notes : tc_i64_i64_map.Map
      (unsafe
        (deref view).param-facts)]
    (tc_i64_i64_map.get-value-or (& notes) (tc-body-param-note-key index) 0)))

;; A by-value parameter's storage written in place, by name; see
;; tc-param-storage-note-write.
(define (tc-body-param-write-note! [state : TcBodyState] [name-id : i64]) : unit
  (tc-body-move-note-push! state name-id))

;; The position of the next noted write: a move check notes its own writes
;; from this mark on.
(define (tc-body-param-writes-mark [state : TcBodyState]) : i64
  (let
    [data : (Ptr TcBodyStateData) (tc-body-state-view state)]
    (unsafe
      (deref data).param-writes-count)))

(define (tc-body-param-writes-truncate! [state : TcBodyState] [mark : i64]) : unit
  (let
    [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    (unsafe
      (set! (deref data).param-writes-count mark))))

;; Bit i is set when parameter i's name was noted as written since `mark`. A
;; noted parameter past position 62 sets every bit, so lowering privatizes all
;; of that function's memory-class parameters.
(define (tc-body-param-write-mask
  [state : TcBodyState]
  [mark : i64]
  [params : (& params ast.AstParamList)]) : i64
  (let
    [count : i64 (tc-body-param-writes-mark state)]
    [mask : i64 0]
    ;; No write noted since `mark` leaves the parameters unvisited.
    [index : i64
      (if (< mark count)
        0
        (ast.ast-param-list-len params))]
    (while (< index (ast.ast-param-list-len params))
      (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
        [(Param name _ _)
          (let
            [noted : i64 mark]
            (while (< noted count)
              (if (= (tc-body-param-note state noted) name)
                (begin
                  (set!
                    mask
                    (if (> index 62)
                      -1
                      (bit-or mask (shl 1 index))))
                  (set! noted count))
                (set! noted (+ noted 1)))))])
      (set! index (+ index 1)))
    mask))

;; Record what a checked body's move check noted since `mark`: its
;; written-parameter mask, joined with any mask an earlier check of the same
;; body recorded, and its `&mut` borrow roots. A body's notes include its
;; lambdas', which record their own as well.
(define (tc-body-param-write-fact-record!
  [state : TcBodyState]
  [body-id : i64]
  [mark : i64]
  [params : (& params ast.AstParamList)]) : unit
  (let
    [mask : i64 (tc-body-param-write-mask state mark params)]
    [view : (Ptr TcBodyStateData) (tc-body-state-view state)]
    [ptr : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    [arena-id : i64
      (unsafe
        (deref view).param-write-arena)]
    [noted : i64 mark]
    (when
      (!= arena-id 0)
      (begin
        (in-arena
          (arena.Arena arena-id)
          (let
            [facts : tc_i64_i64_map.Map
              (unsafe
                (deref view).param-facts)]
            (tc_i64_i64_map.insert-ref!
              (&mut facts)
              body-id
              (bit-or mask (tc_i64_i64_map.get-value-or (& facts) body-id 0)))
            (unsafe
              (set! (deref ptr).param-facts facts))))
        (let
          [count : i64 (tc-body-param-writes-mark state)]
          (while (< noted count)
            (let
              [entry : i64 (tc-body-param-note state noted)]
              (when
                (< entry 0)
                (tc-body-mut-borrow-record! state body-id (- -1 entry))))
            (set! noted (+ noted 1))))))))

;; A call's caller-side copy (lowering's lower-call-args-snapshot-mask) needs
;; another argument that writes the same local root, which takes a `&mut`
;; borrow of it in the same body; the move check notes each such root.
(define (tc-body-mut-borrow-note! [state : TcBodyState] [name-id : i64]) : unit
  (tc-body-move-note-push! state (- -1 name-id)))

;; The `param-facts` key of a body's borrowed root name, or with name -1 of the
;; body itself, present when it borrows any root. Its bits 61 and 60 are 01,
;; where a body's node id has 00, tc-body-memory-class-key 10 and
;; tc-body-param-note-key 11 (node and name ids and note indexes stay below
;; 2^60), so entries of different kinds never collide. The map's
;; bucket index sees only a key's low bits, so the body id is spread over all
;; of them; were two root keys to collide, a call would only copy more often.
(define (tc-body-mut-borrow-key [body-id : i64] [name-id : i64]) : i64
  (bit-or
    (bit-and (+ (* body-id -7046029254386353131) name-id) 1152921504606846975)
    1152921504606846976))

(define (tc-body-memory-class-key [name-id : i64]) : i64
  (bit-or name-id 2305843009213693952))

(define (tc-body-mut-borrow-record!
  [state : TcBodyState]
  [body-id : i64]
  [name-id : i64]) : unit
  (let
    [view : (Ptr TcBodyStateData) (tc-body-state-view state)]
    [ptr : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    [arena-id : i64
      (unsafe
        (deref view).param-write-arena)]
    (when
      (and (!= arena-id 0) (>= body-id 0))
      (in-arena
        (arena.Arena arena-id)
        (let
          [roots : tc_i64_i64_map.Map
            (unsafe
              (deref view).param-facts)]
          (tc_i64_i64_map.insert-ref!
            (&mut roots)
            (tc-body-mut-borrow-key body-id name-id)
            1)
          (tc_i64_i64_map.insert-ref!
            (&mut roots)
            (tc-body-mut-borrow-key body-id -1)
            1)
          (unsafe
            (set! (deref ptr).param-facts roots)))))))

;; Which roots of a body lowering treats as borrowed `&mut` there: -1 for
;; every root (no recorded body, or before the facts start), -2 for none (the
;; body borrows no root), or the body id, for the roots recorded with it.
(define (tc-body-mut-borrow-scope [state : TcBodyState] [body-id : i64]) : i64
  (let
    [view : (Ptr TcBodyStateData) (tc-body-state-view state)]
    (cond
      [(or
          (=
            (unsafe
              (deref view).param-write-arena)
            0)
          (< body-id 0))
        -1]
      [(let
          [roots : tc_i64_i64_map.Map
            (unsafe
              (deref view).param-facts)]
          (tc_i64_i64_map.contains?
            (& roots)
            (tc-body-mut-borrow-key body-id -1)))
        body-id]
      [else -2])))

(define (tc-body-mut-borrowed-root?
  [state : TcBodyState]
  [scope : i64]
  [name-id : i64]) : bool
  (cond
    [(= scope -1) true]
    [(< scope 0) false]
    [else
      (let
        [view : (Ptr TcBodyStateData) (tc-body-state-view state)]
        [roots : tc_i64_i64_map.Map
          (unsafe
            (deref view).param-facts)]
        (tc_i64_i64_map.contains?
          (& roots)
          (tc-body-mut-borrow-key scope name-id)))]))

;; Note the local a `&mut` borrow's place is rooted at, both as written and
;; with dotted field names resolved, as lowering resolves them.
(define (tc-move-note-mut-borrow-root
  [ctx : TcContext]
  [expr-bases : i64]
  [env : TcTypeEnv]
  [place : ast.AstExpr]) : unit
  (match (tc-move-root-projection-var-id expr-bases place)
    [(Some name)
      (tc-body-mut-borrow-note! (tc-context-body-state ctx) name)
      (when
        (tc-dotted-place-name-id? ctx env name)
        (match (tc-dotted-local-field-expr-id-after-check
          (tc-context-structural-session ctx)
          name)
          [(Ok virtual-id)
            (tc-move-note-mut-borrow-root
              ctx
              expr-bases
              env
              (ast.ast-expr-segment-bases-get expr-bases virtual-id))]
          [(Err _) unit]))]
    [(No) unit]))

(defenum TcBodyParamWriteFact
  (Known i64 i64)
  (Unknown i64))

;; A body's fact, carrying its node id (-1 for none): Known with the mask of
;; by-value parameter positions a checked body writes in place, or Unknown for
;; a body no move check recorded (one synthesized after typecheck), which
;; lowering treats as writing every parameter.
(define (tc-body-param-write-fact [state : TcBodyState] [body-id : i64]) : TcBodyParamWriteFact
  (let
    [view : (Ptr TcBodyStateData) (tc-body-state-view state)]
    [facts : tc_i64_i64_map.Map
      (unsafe
        (deref view).param-facts)]
    (match (tc_i64_i64_map.get (& facts) body-id)
      [(LookupFound mask) (Known body-id mask)]
      [(LookupMissing) (Unknown body-id)])))

(define (tc-body-early-exit-fact [state : TcBodyState] [body-id : i64]) : TcBodyEarlyExitFact
  (let
    [data : (Ptr TcBodyStateData) (tc-body-state-view state)]
    (unsafe
      (if (and
        (deref data).early-exit-facts-ready
        (>= body-id 0)
        (< body-id (deref data).early-exit-source-expr-limit))
        (let
          [word-index : i64 (/ body-id 64)]
          [bit-index : i64 (% body-id 64)]
          [bit : i64 (shl 1 bit-index)]
          [known : i64 (array-ref (deref data).early-exit-known word-index)]
          (if (= (bit-and known bit) 0)
            (Unknown)
            (let
              [bits : i64 (array-ref (deref data).early-exit-facts word-index)]
              (Known (not (= (bit-and bits bit) 0))))))
        (Unknown)))))

(define (tc-body-type-fact-initial-capacity) : i64
  1024)

;; Body checks run in a rewindable per-function arena, so reusable facts cannot
;; be allocated by the first body that happens to need them. Give the table a
;; phase-lifetime arena: build its dense index once before body checking, grow
;; only its compact value buffers, and release the whole arena when source
;; typechecking finishes.
(define (tc-body-type-fact-storage-release! [state : TcBodyState]) : unit
  (unsafe
    (let
      [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
      [storage : i64 (deref data).type-fact-storage-arena]
      (unless
        (= storage 0)
        (if (= (arena.tl_arena_current) storage)
          (arena.tl_arena_set (deref data).type-fact-enclosing-arena)
          unit)
        ;; Replace storage-owned arrays before destroying their arena. The
        ;; returned context retains only these tiny idle placeholders plus the
        ;; early-exit bitsets needed by lowering.
        (set! (deref data).type-fact-index (__tl_make-array i64 1))
        (set! (deref data).type-fact-expr-ids (__tl_make-array i64 1))
        (set! (deref data).type-fact-types (__tl_make-array ast.AstType 1))
        (set! (deref data).type-fact-closure-codes (__tl_make-array i64 1))
        (set!
          (deref data).let-init-ids
          (tc-global-shared-view tc-body-let-init-no-ids))
        (set!
          (deref data).let-init-types
          (tc-global-shared-view tc-body-let-init-no-types))
        (set! (deref data).let-init-count 0)
        (set! (deref data).type-fact-storage-arena 0)
        (set! (deref data).type-fact-enclosing-arena 0)
        (set! (deref data).type-fact-count 0)
        (set! (deref data).type-facts-recording false)
        (set! (deref data).type-facts-consuming false)
        (arena.tl_arena_destroy storage)))))

(define (tc-body-type-fact-storage-start!
  [state : TcBodyState]
  [source-limit : i64]) : unit
  (tc-body-type-fact-storage-release! state)
  (let
    [enclosing : i64 (arena.tl_arena_current)]
    [storage : i64 (arena.tl_arena_make)]
    [index-cap : i64
      (if (> source-limit 0)
        source-limit
        1)]
    (in-arena
      (arena.Arena storage)
      (let
        [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
        (unsafe
          (set! (deref data).type-fact-storage-arena storage)
          (set! (deref data).type-fact-enclosing-arena enclosing)
          (set! (deref data).type-fact-index (__tl_make-array i64 index-cap))
          (set!
            (deref data).type-fact-expr-ids
            (__tl_make-array i64 (tc-body-type-fact-initial-capacity)))
          (set!
            (deref data).type-fact-types
            (__tl_make-array ast.AstType (tc-body-type-fact-initial-capacity)))
          (set!
            (deref data).type-fact-closure-codes
            (__tl_make-array i64 (tc-body-type-fact-initial-capacity)))
          (set! (deref data).type-fact-count 0))))))

(define (tc-body-type-fact-grow-copy!
  [dst-types : (&mut dst-types (__tl_dyn-array ast.AstType))]
  [dst-closure-codes : (&mut dst-closure-codes (__tl_dyn-array i64))]
  [dst-expr-ids : (&mut dst-expr-ids (__tl_dyn-array i64))]
  [src-types : (& src-types (__tl_dyn-array ast.AstType))]
  [src-closure-codes : (& src-closure-codes (__tl_dyn-array i64))]
  [src-expr-ids : (& src-expr-ids (__tl_dyn-array i64))]
  [count : i64]
  [index : i64]) : unit
  (let
    [i : i64 index]
    (while (< i count)
      (set! (array-ref dst-types i) (array-ref src-types i))
      (set! (array-ref dst-closure-codes i) (array-ref src-closure-codes i))
      (set! (array-ref dst-expr-ids i) (array-ref src-expr-ids i))
      (set! i (+ i 1)))))

(define (tc-body-type-fact-grow! [state : TcBodyState]) : unit
  (unsafe
    (let
      [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
      [old-types : (__tl_dyn-array ast.AstType) (deref data).type-fact-types]
      [old-closure-codes : (__tl_dyn-array i64)
        (deref data).type-fact-closure-codes]
      [old-expr-ids : (__tl_dyn-array i64) (deref data).type-fact-expr-ids]
      [old-cap : i64 (array-length old-types)]
      [new-cap : i64
        (if (< old-cap 1)
          (tc-body-type-fact-initial-capacity)
          (* old-cap 2))]
      (in-arena
        (arena.Arena (deref data).type-fact-storage-arena)
        (let
          [next-types : (__tl_dyn-array ast.AstType)
            (__tl_make-array ast.AstType new-cap)]
          [next-closure-codes : (__tl_dyn-array i64)
            (__tl_make-array i64 new-cap)]
          [next-expr-ids : (__tl_dyn-array i64) (__tl_make-array i64 new-cap)]
          (tc-body-type-fact-grow-copy!
            (&mut next-types)
            (&mut next-closure-codes)
            (&mut next-expr-ids)
            (& old-types)
            (& old-closure-codes)
            (& old-expr-ids)
            (deref data).type-fact-count
            0)
          (set! (deref data).type-fact-types next-types)
          (set! (deref data).type-fact-closure-codes next-closure-codes)
          (set! (deref data).type-fact-expr-ids next-expr-ids))))))

(define (tc-body-type-fact-clear-recorded-index! [state : TcBodyState]) : unit
  (unsafe
    (let
      [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
      [i : i64 0]
      [index-len : i64 (array-length (deref data).type-fact-index)]
      (while (< i (deref data).type-fact-count)
        (let
          [expr-id : i64 (array-ref (deref data).type-fact-expr-ids i)]
          (if (and (>= expr-id 0) (< expr-id index-len))
            (set! (array-ref (deref data).type-fact-index expr-id) 0)
            unit)
          (set! i (+ i 1))))
      (set! (deref data).type-fact-count 0)
      (set! (deref data).let-init-count 0))))

(define (tc-body-type-fact-ensure-storage! [state : TcBodyState]) : unit
  (unsafe
    (let
      [data : (Ptr TcBodyStateData) (tc-body-state-view state)]
      [source-limit : i64
        (if (> (deref data).early-exit-source-expr-limit 0)
          (deref data).early-exit-source-expr-limit
          1)]
      (if (or
        (= (deref data).type-fact-storage-arena 0)
        (< (array-length (deref data).type-fact-index) source-limit)
        (<
          (array-length (deref data).type-fact-types)
          (tc-body-type-fact-initial-capacity)))
        (tc-body-type-fact-storage-start! state source-limit)
        unit))))

(define (tc-body-type-fact-slot [state : TcBodyState] [expr-id : i64]) : i64
  (let
    [data : (Ptr TcBodyStateData) (tc-body-state-view state)]
    (unsafe
      (if (and
        (>= expr-id 0)
        (< expr-id (array-length (deref data).type-fact-index)))
        (- (array-ref (deref data).type-fact-index expr-id) 1)
        -1))))

(define (tc-body-type-facts-start-recording! [state : TcBodyState]) : unit
  (tc-body-type-fact-ensure-storage! state)
  (tc-body-type-fact-clear-recorded-index! state)
  (let
    [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    (unsafe
      (set! (deref data).type-facts-consuming false)
      (set! (deref data).type-facts-recording true))))

(define (tc-body-type-facts-start-consuming! [state : TcBodyState]) : unit
  (let
    [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    (unsafe
      (set! (deref data).type-facts-recording false)
      (set! (deref data).type-facts-consuming true))))

(define (tc-body-type-facts-clear! [state : TcBodyState]) : unit
  (let
    [data : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
    (unsafe
      (set! (deref data).type-facts-recording false)
      (set! (deref data).type-facts-consuming false))
    (tc-body-type-fact-clear-recorded-index! state)))

(define (tc-body-type-fact-record!
  [state : TcBodyState]
  [expr-id : i64]
  [ty : ast.AstType]) : unit
  (let
    [data : (Ptr TcBodyStateData) (tc-body-state-view state)]
    (unsafe
      (if (and
        (deref data).type-facts-recording
        (>= expr-id 0)
        (< expr-id (array-length (deref data).type-fact-index)))
        (if (>= (tc-body-type-fact-slot state expr-id) 0)
          unit
          (let
            [slot : i64 (deref data).type-fact-count]
            (if (>= slot (array-length (deref data).type-fact-types))
              (tc-body-type-fact-grow! state)
              unit)
            (let
              [ready : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
              (set! (array-ref (deref ready).type-fact-types slot) ty)
              (set! (array-ref (deref ready).type-fact-closure-codes slot) 0)
              (set! (array-ref (deref ready).type-fact-expr-ids slot) expr-id)
              (set!
                (array-ref (deref ready).type-fact-index expr-id)
                (+ slot 1))
              (set! (deref ready).type-fact-count (+ slot 1)))))
        unit))))

(define (tc-body-let-init-capacity) : i64
  256)

(define tc-body-let-init-no-ids : (__tl_dyn-array i64)
  (__tl_make-array i64 0))
(define tc-body-let-init-no-types : (__tl_dyn-array ast.AstType)
  (__tl_make-array ast.AstType 0))

;; Record the contextual type body typing gave an annotated let binding's
;; value. The move check, the borrow check and the result-fact walk each need
;; the binding's type, and re-typing the value against its annotation three
;; times was the costliest part of both checks. A body with more annotated
;; bindings than the table holds keeps re-typing the rest.
(define (tc-body-let-init-type-record!
  [state : TcBodyState]
  [init-id : i64]
  [ty : ast.AstType]) : unit
  (let
    [data : (Ptr TcBodyStateData) (tc-body-state-view state)]
    (unsafe
      (when
        (and
          (deref data).type-facts-recording
          (>= init-id 0)
          (< (deref data).let-init-count (tc-body-let-init-capacity))
          (< (tc-body-let-init-slot state init-id) 0))
        (let
          [slot : i64 (deref data).let-init-count]
          [ready : (MutPtr TcBodyStateData) (tc-body-state-ptr state)]
          ;; The table lives in the facts' storage arena, made on first use.
          (when
            (= (array-length (deref ready).let-init-ids) 0)
            (in-arena
              (arena.Arena (deref ready).type-fact-storage-arena)
              (set!
                (deref ready).let-init-ids
                (__tl_make-array i64 (tc-body-let-init-capacity)))
              (set!
                (deref ready).let-init-types
                (__tl_make-array ast.AstType (tc-body-let-init-capacity)))))
          (set! (array-ref (deref ready).let-init-ids slot) init-id)
          (set! (array-ref (deref ready).let-init-types slot) ty)
          (set! (deref ready).let-init-count (+ slot 1)))))))

(define (tc-body-let-init-slot [state : TcBodyState] [init-id : i64]) : i64
  (let
    [data : (Ptr TcBodyStateData) (tc-body-state-view state)]
    [i : i64 0]
    [slot : i64 -1]
    (unsafe
      (while (and (< slot 0) (< i (deref data).let-init-count))
        (when (= (array-ref (deref data).let-init-ids i) init-id) (set! slot i))
        (set! i (+ i 1))))
    slot))

;; The recorded contextual type of an annotated let binding's value, while the
;; body's facts are being consumed.
(define (tc-body-let-init-type-lookup [state : TcBodyState] [init-id : i64]) : TcBodyTypeFact
  (let
    [data : (Ptr TcBodyStateData) (tc-body-state-view state)]
    (unsafe
      (if (deref data).type-facts-consuming
        (let
          [slot : i64 (tc-body-let-init-slot state init-id)]
          (if (>= slot 0)
            (Hit (ast.ast-array-shared-view (deref data).let-init-types slot))
            (Miss)))
        (Miss)))))

(define (tc-body-type-fact-lookup [state : TcBodyState] [expr-id : i64]) : TcBodyTypeFact
  (let
    [data : (Ptr TcBodyStateData) (tc-body-state-view state)]
    (unsafe
      (if (deref data).type-facts-consuming
        (let
          [slot : i64 (tc-body-type-fact-slot state expr-id)]
          (if (and (>= slot 0) (< slot (deref data).type-fact-count))
            (Hit (ast.ast-array-shared-view (deref data).type-fact-types slot))
            (Miss)))
        (Miss)))))

;; Semantic queries observe recorded operands during inference. They never
;; activate the consuming cache or recheck an expression to obtain a type.
(define (tc-semantic-recorded-type [ctx : TcContext] [expr-id : i64]) : TcBodyTypeFact
  (let
    [state : TcBodyState (tc-context-body-state ctx)]
    [data : TcBodyStateData (tc-body-state-data-value state)]
    [slot : i64 (tc-body-type-fact-slot state expr-id)]
    (if (and
      data.type-facts-recording
      (>= slot 0)
      (< slot data.type-fact-count))
      (Hit (ast.ast-array-shared-view data.type-fact-types slot))
      (if data.type-facts-recording
        (match (tc-context-expr-get ctx expr-id)
          [(or (Spanned inner _) (MacroExpansion inner _ _))
            (tc-semantic-recorded-type ctx inner)]
          [_ (Miss)])
        (Miss)))))

;; Concrete closure facts use the same per-body slot index as inferred types.
;; They are written during the move pass, while type facts are being consumed,
;; and remain available to the immediately following borrow pass. Lambda body
;; ids synthesized after source typecheck simply miss and retain the
;; conservative recomputation path.
(define (tc-body-closure-fact-code [state : TcBodyState] [body-id : i64]) : i64
  (let
    [data : (Ptr TcBodyStateData) (tc-body-state-view state)]
    [slot : i64 (tc-body-type-fact-slot state body-id)]
    (unsafe
      (if (and
        (deref data).type-facts-consuming
        (>= slot 0)
        (< slot (deref data).type-fact-count))
        (array-ref (deref data).type-fact-closure-codes slot)
        0))))

(define (tc-body-closure-fact-record!
  [state : TcBodyState]
  [body-id : i64]
  [code : i64]) : unit
  (let
    [data : TcBodyStateData (tc-body-state-data-value state)]
    [slot : i64 (tc-body-type-fact-slot state body-id)]
    (if (and
      data.type-facts-consuming
      (>= slot 0)
      (< slot data.type-fact-count))
      (set! (array-ref data.type-fact-closure-codes slot) code)
      unit)))

(defenum TcBorrowPlace
  ;; The borrow's lifetime, the referent type, and whether the path to the
  ;; referent passes through a shared reference. No `&mut` borrow may reach a
  ;; referent through one (#8694).
  (TcBorrowPlace i64 ast.AstType bool))

(defenum ResultTcBorrowPlace
  (Ok TcBorrowPlace)
  (Err String))

