          out
          "expr-binding-clause-list-length"
          (tc-fn1 binding-clause-list (AstType.I64))))
      (set!
        out
        (tc-bind
          out
          "expr-binding-clause-list-head"
          (tc-fn1 binding-clause-list binding-clause)))
      (set!
        out
        (tc-bind-comptime-helper-aliases
          out
          "expr-binding-clause-list-head"
          (tc-fn1 binding-clause-list binding-clause)))
      (set!
        out
        (tc-bind
          out
          "expr-binding-clause-list-tail"
          (tc-fn1 binding-clause-list binding-clause-list)))
      (set!
        out
        (tc-bind-comptime-helper-aliases
          out
          "expr-binding-clause-list-tail"
          (tc-fn1 binding-clause-list binding-clause-list)))
      (set!
        out
        (tc-bind
          out
          "expr-binding-clause-list-nth"
          (tc-fn2 binding-clause-list (AstType.I64) binding-clause)))
      (set!
        out
        (tc-bind-comptime-helper-aliases
          out
          "expr-binding-clause-list-nth"
          (tc-fn2 binding-clause-list (AstType.I64) binding-clause)))
      (set!
        out
        (tc-bind
          out
          "expr-binding-clause-list->expr-list"
          (tc-fn1 binding-clause-list (AstType.ExprList))))
      (set!
        out
        (tc-bind-comptime-helper-aliases
          out
          "expr-binding-clause-list->expr-list"
          (tc-fn1 binding-clause-list (AstType.ExprList))))
      out)))

(define tc-macro-helper-env-cache-ready : bool
  false)
(define tc-macro-helper-env-cache-value : TcTypeEnv
  (TcTypeEnv.Nil))

(define (tc-macro-helper-env-cache-reset!) : unit
  (begin
    (set! tc-macro-helper-env-cache-ready false)
    (set! tc-macro-helper-env-cache-value (TcTypeEnv.Nil))))

(define (tc-macro-helper-env-cached [env : TcTypeEnv]) : TcTypeEnv
  (if tc-macro-helper-env-cache-ready
    tc-macro-helper-env-cache-value
    (let
      [helper-env : TcTypeEnv (tc-macro-helper-env env)]
      (begin
        (set! tc-macro-helper-env-cache-value helper-env)
        (set! tc-macro-helper-env-cache-ready true)
        tc-macro-helper-env-cache-value))))

(define (tc-lookup-id [env : TcTypeEnv] [name-id : i64]) : ResultTcType
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-lookup))
    (match env
      [(TcTypeEnv.Nil)
        (ResultTcType.Err
          (string.append "typecheck: unbound name " (intern-str name-id)))]
      [(TcTypeEnv.Cache ids values _ _ _ _ partial _ below)
        (match (hashmap.i64-i64-map-get ids name-id)
          ;; #2357: MUST stay `array-ref` -- with #1867 inline-by-value `AstType` is
          ;; a multi-word value and the raw ptr-offset/ptr-read path mis-scales the
          ;; element stride, reading garbage.
          [(hashmap.I64I64MapFound index)
            (ResultTcType.Ok (array-ref values index))]
          [(hashmap.I64I64MapMissing)
            (if partial
              (tc-lookup-id (box-get below) name-id)
              (ResultTcType.Err
                (string.append "typecheck: unbound name " (intern-str name-id))))])]
      [(TcTypeEnv.Bind key ty rest)
        (if (= key name-id)
          (ResultTcType.Ok ty)
          (tc-lookup-id (box-get rest) name-id))])))

(define (tc-lookup [env : TcTypeEnv] [name : String]) : ResultTcType
  (tc-lookup-id env (tc-name-id name)))

(define (tc-name-bound-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (match env
    [(TcTypeEnv.Nil) false]
    [(TcTypeEnv.Cache ids _ _ _ _ _ partial _ below)
      (match (hashmap.i64-i64-map-get ids name-id)
        [(hashmap.I64I64MapFound _) true]
        [(hashmap.I64I64MapMissing)
          (if partial
            (tc-name-bound-id? (box-get below) name-id)
            false)])]
    [(TcTypeEnv.Bind key _ rest)
      (if (= key name-id)
        true
        (tc-name-bound-id? (box-get rest) name-id))]))

(define (tc-lookup-unsafe-id [env : TcTypeEnv] [name-id : i64]) : ResultTcTypeUnsafe
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-lookup))
    (match env
      [(TcTypeEnv.Nil)
        (ResultTcTypeUnsafe.Err
          (string.append "typecheck: unbound name " (intern-str name-id)))]
      [(TcTypeEnv.Cache ids values unsafe-flags _ _ _ partial _ below)
        (match (hashmap.i64-i64-map-get ids name-id)
          ;; #2357: AstType read MUST stay `array-ref` (inline-by-value multi-word
          ;; value); the `unsafe-flags` i64 read below is scalar so the raw ptr path
          ;; is still sound there.
          [(hashmap.I64I64MapFound index)
            (ResultTcTypeUnsafe.Ok
              (array-ref values index)
              (=
                (unsafe
                  (ptr-read
                    (ptr-offset
                      (ptr-cast (array-data unsafe-flags) : (Ptr i64))
                      index)))
                1))]
          [(hashmap.I64I64MapMissing)
            (if partial
              (tc-lookup-unsafe-id (box-get below) name-id)
              (ResultTcTypeUnsafe.Err
                (string.append "typecheck: unbound name " (intern-str name-id))))])]
      [(TcTypeEnv.Bind key ty rest)
        (if (= key name-id)
          (ResultTcTypeUnsafe.Ok
            ty
            (tc-binding-unsafe-marker-head-id? (box-get rest) name-id))
          (tc-lookup-unsafe-id (box-get rest) name-id))])))

(define (tc-lookup-unsafe [env : TcTypeEnv] [name : String]) : ResultTcTypeUnsafe
  (tc-lookup-unsafe-id env (tc-name-id name)))

(define (tc-name-bound-before-hygiene-global-boundary-id?
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (match env
    [(TcTypeEnv.Nil) false]
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-name-bound-before-hygiene-global-boundary-id?
          (box-get rest)
          name-id)
        false)]
    [(TcTypeEnv.Bind key _ rest)
      (if (= key (tc-hygiene-global-boundary-id))
        false
        (if (= key name-id)
          true
          (tc-name-bound-before-hygiene-global-boundary-id?
            (box-get rest)
            name-id)))]))

(define (tc-unqualified-import-ambiguity-message-for-key
  [_ctx : TcContext]
  [env : TcTypeEnv]
  [_module : String]
  [name : String]
  [name-id : i64]
  [key-id : i64]) : TcMaybeString
  (let
    [first-module : i64
      (sym_i64_env.sym-i64-lookup-id-or
        tc-unqualified-import-ambiguous-first-modules
        key-id
        (compiler-symbols-missing-handle))]
    (if (not (compiler-symbols-handle-found? first-module))
      (TcMaybeString.No)
      (if (tc-name-bound-before-hygiene-global-boundary-id? env name-id)
        (TcMaybeString.No)
        (let
          [second-module : i64
            (sym_i64_env.sym-i64-lookup-id-or
              tc-unqualified-import-ambiguous-second-modules
              key-id
              (compiler-symbols-missing-handle))]
          (if (not (compiler-symbols-handle-found? second-module))
            (TcMaybeString.No)
            (TcMaybeString.Some
              (str_cat.str-cat
                "typecheck: ambiguous unqualified import for value "
                name
                " between modules "
                (intern-str first-module)
                " and "
                (intern-str second-module)
                "; use an explicit alias or qualified access"))))))))

(define (tc-unqualified-import-ambiguity-message
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : TcMaybeString
  (if tc-unqualified-import-has-ambiguity
    (let
      [name : String (intern-str name-id)]
      (if (tc-name-qualified? name)
        (TcMaybeString.No)
        (let
          [module : String (tc-context-module ctx)]
          (tc-unqualified-import-ambiguity-message-for-key
            ctx
            env
            module
            name
            name-id
            (tc-unqualified-import-key-id module name-id)))))
    (TcMaybeString.No)))

(define (tc-lookup-visible-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : ResultTcType
  (let
    [name : String (intern-str name-id)]
    [found : ResultTcType
      (match (tc-lookup-id env name-id)
        [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
        [(ResultTcType.Err message)
          (let
            [module : String (tc-context-module ctx)]
            (if (and
              (> (string.string-length module) 0)
              (not (tc-name-qualified? name)))
              (match (tc-lookup-id
                env
                (tc-name-id (compiler-symbol-module-key module name)))
                [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
                [(ResultTcType.Err _) (ResultTcType.Err message)])
              (ResultTcType.Err message)))])]
    (match found
      [(ResultTcType.Ok ty)
        (match (tc-unqualified-import-ambiguity-message ctx env name-id)
          [(TcMaybeString.No) (ResultTcType.Ok ty)]
          [(TcMaybeString.Some message) (ResultTcType.Err message)])]
      [(ResultTcType.Err message) (ResultTcType.Err message)])))

(define (tc-lookup-visible [ctx : TcContext] [env : TcTypeEnv] [name : String]) : ResultTcType
  (tc-lookup-visible-id ctx env (tc-name-id name)))

(define (tc-lookup-hygiene-global-scan
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [name-id : i64]) : ResultTcType
  (match (tc-type-env-spine-step env)
    [(TcTypeEnvSpineStep.Done) (tc-lookup-id root name-id)]
    [(TcTypeEnvSpineStep.Cache rest-env)
      (tc-lookup-hygiene-global-scan root rest-env name-id)]
    [(TcTypeEnvSpineStep.Bind key _ rest-env)
      (if (= key (tc-hygiene-global-boundary-id))
        (tc-lookup-id rest-env name-id)
        (tc-lookup-hygiene-global-scan root rest-env name-id))]))

(define (tc-lookup-hygiene-global-id [env : TcTypeEnv] [name-id : i64]) : ResultTcType
  (tc-lookup-hygiene-global-scan env env name-id))

(define (tc-lookup-hygiene-global [env : TcTypeEnv] [name : String]) : ResultTcType
  (tc-lookup-hygiene-global-id env (tc-name-id name)))

(define (tc-lookup-hygiene-global-visible-id
  [_ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]) : ResultTcType
  (match (tc-lookup-hygiene-global-id env name-id)
    [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (tc-lookup-hygiene-global-visible
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]) : ResultTcType
  (tc-lookup-hygiene-global-visible-id ctx env (tc-name-id name)))

(define (tc-lookup-dotted-source-visible
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]) : ResultTcType
  (match (tc-source-name-lookup-key-after-local-field-check ctx env name)
    [(ResultTcString.Ok lookup-name)
      (let
        [lookup-id : i64 (tc-name-id lookup-name)]
        (match (tc-lookup-unsafe-id env lookup-id)
          [(ResultTcTypeUnsafe.Ok ty unsafe)
            (if unsafe
              (match (tc-require-unsafe
                env
                (tc-source-lookup-display-name ctx name lookup-name))
                [(ResultTcUnit.Ok) (ResultTcType.Ok ty)]
                [(ResultTcUnit.Err message) (ResultTcType.Err message)])
              (ResultTcType.Ok ty))]
          [(ResultTcTypeUnsafe.Err message)
            (tc-variant-constructor-type-for-lookup-or
              ctx
              lookup-name
              (tc-source-lookup-display-name ctx name lookup-name)
              (tc-source-unbound-display-message ctx name lookup-name message))]))]
    [(ResultTcString.Err message) (ResultTcType.Err message)]))

(define (tc-hygiene-definition-env [ctx : TcContext] [module : String]) : ResultTcEnv
  (if tc-hygiene-active-top-env-ready
    (if (string.eq module "")
      (ResultTcEnv.Ok tc-hygiene-active-top-env)
      ;; #2357: build cache entries in the dedicated persistent arena (see
      ;; tc-hygiene-module-env-cache-arena) so the chain stored in the global
      ;; survives the scratch arenas active during per-decl typechecking.
      (let
        [prev-arena : i64 (arena.tl_arena_current)]
        [_switched : unit
          (unsafe
            (arena.tl_arena_set (tc-hygiene-module-env-cache-arena-handle)))]
        (match (tc-module-local-env-cached
          ctx
          tc-hygiene-active-top-env
          module
          tc-hygiene-module-env-cache)
          [(ResultTcModuleLocalEnv.Ok def-env next-cache)
            (let
              [cache-head : i64 (arena.tl_arena_current)]
              (begin
                (set! tc-hygiene-module-env-cache-arena cache-head)
                (set! tc-hygiene-module-env-cache next-cache)
                (unsafe
                  (arena.tl_arena_set prev-arena))
                (ResultTcEnv.Ok def-env)))]
          [(ResultTcModuleLocalEnv.Err message)
            (let
              [cache-head : i64 (arena.tl_arena_current)]
              (begin
                (set! tc-hygiene-module-env-cache-arena cache-head)
                (unsafe
                  (arena.tl_arena_set prev-arena))
                (ResultTcEnv.Err message)))])))
    (ResultTcEnv.Err "typecheck: macro hygiene definition context unavailable")))

(define (tc-lookup-hygiene-context-global-visible-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [module : String]
  [name-id : i64]) : ResultTcType
  (let
    [name : String (intern-str name-id)]
    [def-ctx : TcContext (tc-context-with-module ctx module)]
    (if (>= (intern-first-dot name-id) 0)
      (tc-lookup-dotted-source-visible def-ctx env name)
      (match (tc-hygiene-definition-env ctx module)
        [(ResultTcEnv.Ok def-env)
          (match (tc-lookup-unsafe-id def-env name-id)
            [(ResultTcTypeUnsafe.Ok ty unsafe)
              (if unsafe
                (match (tc-require-unsafe env name)
                  [(ResultTcUnit.Ok) (ResultTcType.Ok ty)]
                  [(ResultTcUnit.Err message) (ResultTcType.Err message)])
                (ResultTcType.Ok ty))]
            [(ResultTcTypeUnsafe.Err message) (ResultTcType.Err message)])]
        [(ResultTcEnv.Err message) (ResultTcType.Err message)]))))

(define (tc-hygiene-global-binding-unsafe-scan
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (match (tc-type-env-spine-step env)
    [(TcTypeEnvSpineStep.Done) (tc-binding-unsafe-id? root name-id)]
    [(TcTypeEnvSpineStep.Cache rest-env)
      (tc-hygiene-global-binding-unsafe-scan root rest-env name-id)]
    [(TcTypeEnvSpineStep.Bind key _ rest-env)
      (if (= key (tc-hygiene-global-boundary-id))
        (tc-binding-unsafe-id? rest-env name-id)
        (tc-hygiene-global-binding-unsafe-scan root rest-env name-id))]))

(define (tc-hygiene-global-binding-unsafe-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (tc-hygiene-global-binding-unsafe-scan env env name-id))

(define (tc-hygiene-global-binding-unsafe? [env : TcTypeEnv] [name : String]) : bool
  (tc-hygiene-global-binding-unsafe-id? env (tc-name-id name)))

(define (tc-active-region-scan [env : TcTypeEnv]) : TcMaybeString
  (match env
    [(TcTypeEnv.Nil) (TcMaybeString.No)]
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-active-region-scan (box-get rest))
        (TcMaybeString.No))]
    [(TcTypeEnv.Bind key ty rest)
      (if (= key (tc-region-marker-id))
        (match ty
          [(AstType.Var region) (TcMaybeString.Some (intern-str region))]
          [_ (tc-active-region-scan (box-get rest))])
        (tc-active-region-scan (box-get rest)))]))

(define (tc-active-region [env : TcTypeEnv]) : TcMaybeString
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match (tc-env-marker-type env (tc-region-marker-id))
      [(AstMaybeType.Some (AstType.Var region))
        (TcMaybeString.Some (intern-str region))]
      [(AstMaybeType.Some _) (tc-active-region-scan env)]
      [(AstMaybeType.No) (TcMaybeString.No)])))

(define (tc-push-region [env : TcTypeEnv] [region : String]) : TcTypeEnv
  (tc-bind env (tc-region-marker-name) (AstType.Var (intern region))))

(define (tc-string-list-contains [items : TcStringList] [name : String]) : bool
  (match items
    [(TcStringList.Nil) false]
    [(TcStringList.Cons item rest)
      (if (string.eq item name)
        true
        (tc-string-list-contains (box-get rest) name))]))

(define (tc-string-list-add [items : TcStringList] [name : String]) : TcStringList
  (if (tc-string-list-contains items name)
    items
    (TcStringList.Cons name (box items))))

(define (tc-string-list-add-all [items : TcStringList] [names : TcStringList]) : TcStringList
  (match names
    [(TcStringList.Nil) items]
    [(TcStringList.Cons name rest)
      (tc-string-list-add-all (tc-string-list-add items name) (box-get rest))]))

(define (tc-bind-cleanup-owner [env : TcTypeEnv] [name : String]) : TcTypeEnv
  (tc-bind env (tc-cleanup-owner-marker-name) (AstType.Var (intern name))))

(define (tc-bind-ordinary-arena-owner [env : TcTypeEnv] [name : String]) : TcTypeEnv
  (tc-bind
    env
    (tc-ordinary-arena-owner-marker-name)
    (AstType.Var (intern name))))

(define (tc-bind-atomic-arena-owner [env : TcTypeEnv] [name : String]) : TcTypeEnv
  (tc-bind env (tc-atomic-arena-owner-marker-name) (AstType.Var (intern name))))

(define (tc-arena-phase-region-separator) : String
  "#phase:")

(define (tc-arena-phase-region-prefix [owner : String]) : String
  (string.append owner (tc-arena-phase-region-separator)))

(define (tc-arena-phase-region [owner : String] [token : String]) : String
  (string.append (tc-arena-phase-region-prefix owner) token))

(define (tc-arena-region-owned-by? [owner : String] [region : String]) : bool
  (or
    (string.eq owner region)
    (tc-string-prefix? region (tc-arena-phase-region-prefix owner))))

(define (tc-arena-phase-token-region-marker-name [token : String]) : String
  (str_cat.str-cat " __tl_arena_phase_token_region:" token))

(define (tc-arena-phase-token-owner-marker-name [token : String]) : String
  (str_cat.str-cat " __tl_arena_phase_token_owner:" token))

(define (tc-arena-phase-current-region-marker-name [owner : String]) : String
  (str_cat.str-cat " __tl_arena_phase_current_region:" owner))

(define (tc-bind-arena-phase-token
  [env : TcTypeEnv]
  [token : String]
  [owner : String]) : TcTypeEnv
  (let
    [region : String (tc-arena-phase-region owner token)]
    (tc-bind
      (tc-bind
        (tc-bind
          env
          (tc-arena-phase-current-region-marker-name owner)
          (AstType.Var (intern region)))
        (tc-arena-phase-token-owner-marker-name token)
        (AstType.Var (intern owner)))
      (tc-arena-phase-token-region-marker-name token)
      (AstType.Var (intern region)))))

(define (tc-arena-phase-token-region-head [env : TcTypeEnv] [token : String]) : TcMaybeString
  (match env
    [(TcTypeEnv.Bind key ty _)
      (if (= key (tc-name-id (tc-arena-phase-token-region-marker-name token)))
        (match ty
          [(AstType.Var region) (TcMaybeString.Some (intern-str region))]
          [_ (TcMaybeString.No)])
        (TcMaybeString.No))]
    [_ (TcMaybeString.No)]))

(define (tc-arena-phase-token-owner-head [env : TcTypeEnv] [token : String]) : TcMaybeString
  (match env
    [(TcTypeEnv.Bind key ty rest)
      (if (= key (tc-name-id (tc-arena-phase-token-owner-marker-name token)))
        (match ty
          [(AstType.Var owner) (TcMaybeString.Some (intern-str owner))]
          [_ (TcMaybeString.No)])
        (if (= key (tc-name-id (tc-arena-phase-token-region-marker-name token)))
          (tc-arena-phase-token-owner-head (box-get rest) token)
          (TcMaybeString.No)))]
    [_ (TcMaybeString.No)]))

(define (tc-arena-phase-token-region-active-scan
  [env : TcTypeEnv]
  [token : String]) : TcMaybeString
  (match env
    [(TcTypeEnv.Nil) (TcMaybeString.No)]
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-arena-phase-token-region-active-scan (box-get rest) token)
        (TcMaybeString.No))]
    [(TcTypeEnv.Bind key _ rest)
      (if (= key (tc-name-id token))
        (tc-arena-phase-token-region-head (box-get rest) token)
        (tc-arena-phase-token-region-active-scan (box-get rest) token))]))

(define (tc-arena-phase-token-region-active [env : TcTypeEnv] [token : String]) : TcMaybeString
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match env
      [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
        (tc-arena-phase-token-region-active-scan (box-get rest) token)]
      [_ (tc-arena-phase-token-region-active-scan env token)])))

(define (tc-arena-phase-token-owner-active-scan
  [env : TcTypeEnv]
  [token : String]) : TcMaybeString
  (match env
    [(TcTypeEnv.Nil) (TcMaybeString.No)]
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-arena-phase-token-owner-active-scan (box-get rest) token)
        (TcMaybeString.No))]
    [(TcTypeEnv.Bind key _ rest)
      (if (= key (tc-name-id token))
        (tc-arena-phase-token-owner-head (box-get rest) token)
        (tc-arena-phase-token-owner-active-scan (box-get rest) token))]))

(define (tc-arena-phase-token-owner-active [env : TcTypeEnv] [token : String]) : TcMaybeString
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match env
      [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
        (tc-arena-phase-token-owner-active-scan (box-get rest) token)]
      [_ (tc-arena-phase-token-owner-active-scan env token)])))

(define (tc-current-arena-owner-region [env : TcTypeEnv] [owner : String]) : String
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match (tc-env-marker-type
      env
      (tc-name-id (tc-arena-phase-current-region-marker-name owner)))
      [(AstMaybeType.Some (AstType.Var region)) (intern-str region)]
      [_ owner])))

(define (tc-active-region-owned-by-arena? [env : TcTypeEnv] [owner : String]) : bool
  (match (tc-active-region env)
    [(TcMaybeString.Some region) (tc-arena-region-owned-by? owner region)]
    [(TcMaybeString.No) false]))

(define (tc-cleanup-owner-marker-for?
  [key : i64]
  [ty : AstType]
  [name : String]) : bool
  (if (= key (tc-cleanup-owner-marker-id))
    (match ty
      [(AstType.Var owner) (string.eq (intern-str owner) name)]
      [_ false])
    false))

(define (tc-arena-owner-marker-for?
  [marker-id : i64]
  [key : i64]
  [ty : AstType]
  [name : String]) : bool
  (if (= key marker-id)
    (match ty
      [(AstType.Var owner) (string.eq (intern-str owner) name)]
      [_ false])
    false))

(define (tc-cleanup-owner-marker-entry? [key : i64] [ty : AstType]) : bool
  (if (= key (tc-cleanup-owner-marker-id))
    (match ty
      [(AstType.Var _) true]
      [_ false])
    false))

(define (tc-arena-owner-marker-entry?
  [marker-id : i64]
  [key : i64]
  [ty : AstType]) : bool
  (if (= key marker-id)
    (match ty
      [(AstType.Var _) true]
      [_ false])
    false))

(define (tc-ordinary-arena-owner-marker-entry? [key : i64] [ty : AstType]) : bool
  (tc-arena-owner-marker-entry? (tc-ordinary-arena-owner-marker-id) key ty))

(define (tc-atomic-arena-owner-marker-entry? [key : i64] [ty : AstType]) : bool
  (tc-arena-owner-marker-entry? (tc-atomic-arena-owner-marker-id) key ty))

(define (tc-arena-owner-marker-head?
  [env : TcTypeEnv]
  [name : String]
  [marker-id : i64]) : bool
  (match env
    [(TcTypeEnv.Nil) false]
    [(TcTypeEnv.Cache _ _ _ _ _ _ _ _ _) false]
    [(TcTypeEnv.Bind key ty _)
      (tc-arena-owner-marker-for? marker-id key ty name)]))

(define (tc-cleanup-owner-marker-head? [env : TcTypeEnv] [name : String]) : bool
  (match env
    [(TcTypeEnv.Nil) false]
    [(TcTypeEnv.Cache _ _ _ _ _ _ _ _ _) false]
    [(TcTypeEnv.Bind key ty _) (tc-cleanup-owner-marker-for? key ty name)]))

(define (tc-cleanup-owner-active-scan? [env : TcTypeEnv] [name : String]) : bool
  (match env
    [(TcTypeEnv.Nil) false]
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-cleanup-owner-active-scan? (box-get rest) name)
        false)]
    [(TcTypeEnv.Bind key ty rest)
      (if (= key (tc-name-id name))
        (tc-cleanup-owner-marker-head? (box-get rest) name)
        (tc-cleanup-owner-active-scan? (box-get rest) name))]))

(define (tc-cleanup-owner-active? [env : TcTypeEnv] [name : String]) : bool
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match env
      [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
        (tc-cleanup-owner-active-scan? (box-get rest) name)]
      [_ (tc-cleanup-owner-active-scan? env name)])))

(define (tc-arena-owner-active-scan?
  [env : TcTypeEnv]
  [name : String]
  [marker-id : i64]) : bool
  (match env
    [(TcTypeEnv.Nil) false]
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-arena-owner-active-scan? (box-get rest) name marker-id)
        false)]
    [(TcTypeEnv.Bind key _ rest)
      (if (= key (tc-name-id name))
        (tc-arena-owner-marker-head? (box-get rest) name marker-id)
        (tc-arena-owner-active-scan? (box-get rest) name marker-id))]))

(define (tc-arena-owner-active?
  [env : TcTypeEnv]
  [name : String]
  [marker-id : i64]) : bool
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match env
      [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
        (tc-arena-owner-active-scan? (box-get rest) name marker-id)]
      [_ (tc-arena-owner-active-scan? env name marker-id)])))

(define (tc-ordinary-arena-owner-active? [env : TcTypeEnv] [name : String]) : bool
  (tc-arena-owner-active? env name (tc-ordinary-arena-owner-marker-id)))

(define (tc-atomic-arena-owner-active? [env : TcTypeEnv] [name : String]) : bool
  (tc-arena-owner-active? env name (tc-atomic-arena-owner-marker-id)))

(define (tc-active-cleanup-owners-scan [root : TcTypeEnv] [env : TcTypeEnv]) : TcStringList
  (match env
    [(TcTypeEnv.Nil) TcStringList.Nil]
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-active-cleanup-owners-scan root (box-get rest))
        TcStringList.Nil)]
    [(TcTypeEnv.Bind key ty rest)
      (let
        [owners : TcStringList
          (tc-active-cleanup-owners-scan root (box-get rest))]
        (if (= key (tc-cleanup-owner-marker-id))
          (match ty
            [(AstType.Var owner)
              (let
                [owner-str : String (intern-str owner)]
                (if (tc-cleanup-owner-active? root owner-str)
                  (tc-string-list-add owners owner-str)
                  owners))]
            [_ owners])
          owners))]))

(define (tc-active-cleanup-owners [env : TcTypeEnv]) : TcStringList
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match env
      [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
        (tc-active-cleanup-owners-scan env (box-get rest))]
      [_ (tc-active-cleanup-owners-scan env env)])))

(define (tc-string-list-eq [a : TcStringList] [b : TcStringList]) : bool
  (match a
    [(TcStringList.Nil)
      (match b
        [(TcStringList.Nil) true]
        [_ false])]
    [(TcStringList.Cons item rest)
      (and
        (tc-string-list-contains b item)
        (tc-string-list-eq (box-get rest) b))]))

(define (tc-string-list-overlaps? [a : TcStringList] [b : TcStringList]) : bool
  (match a
    [(TcStringList.Nil) false]
    [(TcStringList.Cons item rest)
      (if (tc-string-list-contains b item)
        true
        (tc-string-list-overlaps? (box-get rest) b))]))

(define (tc-string-list-all-in? [items : TcStringList] [allowed : TcStringList]) : bool
  (match items
    [(TcStringList.Nil) true]
    [(TcStringList.Cons item rest)
      (and
        (tc-string-list-contains allowed item)
        (tc-string-list-all-in? (box-get rest) allowed))]))

(define (tc-lifetime-list-count [items : AstLifetimeList]) : i64
  (ast-lifetime-list-len (& items)))

(define (tc-lifetime-list-contains [items : AstLifetimeList] [name : String]) : bool
  (tc-lifetime-list-contains-at? (& items) name 0))

(define (tc-lifetime-list-contains-at?
  [items : (& items AstLifetimeList)]
  [name : String]
  [index : i64]) : bool
  (if (>= index (ast-lifetime-list-len items))
    false
    (if (string.eq
      (ast-lifetime-list-get items index (ast-lifetime-fallback))
      name)
      true
      (tc-lifetime-list-contains-at? items name (+ index 1)))))

(define (tc-lifetime-list-duplicates? [items : AstLifetimeList]) : bool
  (tc-lifetime-list-duplicates-at? (& items) 0))

(define (tc-lifetime-list-contains-after?
  [items : (& items AstLifetimeList)]
  [name : String]
  [index : i64]) : bool
  (if (>= index (ast-lifetime-list-len items))
    false
    (if (string.eq
      (ast-lifetime-list-get items index (ast-lifetime-fallback))
      name)
      true
      (tc-lifetime-list-contains-after? items name (+ index 1)))))

(define (tc-lifetime-list-duplicates-at?
  [items : (& items AstLifetimeList)]
  [index : i64]) : bool
  (if (>= index (ast-lifetime-list-len items))
    false
    (let
      [item : String
        (ast-lifetime-list-get items index (ast-lifetime-fallback))]
      (or
        (tc-lifetime-list-contains-after? items item (+ index 1))
        (tc-lifetime-list-duplicates-at? items (+ index 1))))))

(define (tc-lifetime-list-eq [a : AstLifetimeList] [b : AstLifetimeList]) : bool
  (ast-lifetime-list-eq? a b))

(define (tc-lifetime-list-all-in?
  [items : AstLifetimeList]
  [allowed : AstLifetimeList]) : bool
  (tc-lifetime-list-all-in-at? (& items) allowed 0))

(define (tc-lifetime-list-all-in-at?
  [items : (& items AstLifetimeList)]
  [allowed : AstLifetimeList]
  [index : i64]) : bool
  (if (>= index (ast-lifetime-list-len items))
    true
    (let
      [item : String
        (ast-lifetime-list-get items index (ast-lifetime-fallback))]
      (and
        (or (string.eq item "program") (tc-lifetime-list-contains allowed item))
        (tc-lifetime-list-all-in-at? items allowed (+ index 1))))))

(define (tc-lifetime-list-to-string-list-into
  [items : AstLifetimeList]
  [out : TcStringList]) : TcStringList
  (tc-lifetime-list-to-string-list-into-at (& items) out 0))

(define (tc-lifetime-list-to-string-list-into-at
  [items : (& items AstLifetimeList)]
  [out : TcStringList]
  [index : i64]) : TcStringList
  (if (>= index (ast-lifetime-list-len items))
    out
    (tc-lifetime-list-to-string-list-into-at
      items
      (tc-string-list-add
        out
        (ast-lifetime-list-get items index (ast-lifetime-fallback)))
      (+ index 1))))

(define (tc-string-list-to-lifetime-list [items : TcStringList]) : AstLifetimeList
  (match items
    [(TcStringList.Nil) (ast-lifetime-list-new)]
    [(TcStringList.Cons item rest)
      (ast-lifetime-cons item (tc-string-list-to-lifetime-list (box-get rest)))]))

(define (tc-lifetime-subst-lookup [subst : TcLifetimeSubst] [name : String]) : TcMaybeString
  (match subst
    [(TcLifetimeSubst.Nil) (TcMaybeString.No)]
    [(TcLifetimeSubst.Cons from to rest)
      (if (string.eq from name)
        (TcMaybeString.Some to)
        (tc-lifetime-subst-lookup (box-get rest) name))]))

(define (tc-lifetime-subst-bind
  [subst : TcLifetimeSubst]
  [from : String]
  [to : String]) : ResultTcLifetimeSubst
  (match (tc-lifetime-subst-lookup subst from)
    [(TcMaybeString.Some existing)
      (if (string.eq existing to)
        (ResultTcLifetimeSubst.Ok subst)
        (ResultTcLifetimeSubst.Err "typecheck: constructor lifetime mismatch"))]
    [(TcMaybeString.No)
      (ResultTcLifetimeSubst.Ok (TcLifetimeSubst.Cons from to (box subst)))]))

(define (tc-lifetime-subst-apply [subst : TcLifetimeSubst] [name : String]) : String
  (match (tc-lifetime-subst-lookup subst name)
    [(TcMaybeString.Some replacement) replacement]
    [(TcMaybeString.No) name]))

(define (tc-lifetime-subst-list
  [subst : TcLifetimeSubst]
  [items : AstLifetimeList]) : AstLifetimeList
  (tc-lifetime-subst-list-at subst (& items) 0))

(define (tc-lifetime-subst-list-at
  [subst : TcLifetimeSubst]
  [items : (& items AstLifetimeList)]
  [index : i64]) : AstLifetimeList
  (if (>= index (ast-lifetime-list-len items))
    (ast-lifetime-list-new)
    (ast-lifetime-cons
      (tc-lifetime-subst-apply
        subst
        (ast-lifetime-list-get items index (ast-lifetime-fallback)))
      (tc-lifetime-subst-list-at subst items (+ index 1)))))

;; V1 lifetime names are owner names. Normal environment bindings own stack
;; slots, and the synthetic region marker owns a with-arena scope. Environment
;; order is the lexical outlives relation: older owners appear farther down the
;; list and outlive nested stack bindings or scoped arenas. The default program
;; arena is inferred for untagged aggregate handles, so it has no lexical
;; binder in this environment walk.
(define (tc-env-binding-matches-lifetime?
  [key : i64]
  [ty : AstType]
  [lifetime : String]) : bool
  (cond
    [(= key (tc-name-id lifetime)) true]
    [(= key (tc-region-marker-id))
      (match ty
        [(AstType.Var region) (string.eq (intern-str region) lifetime)]
        [_ false])]
    [(or
        (= key (tc-ordinary-arena-owner-marker-id))
        (= key (tc-atomic-arena-owner-marker-id)))
      (match ty
        [(AstType.Var owner)
          (tc-arena-region-owned-by? (intern-str owner) lifetime)]
        [_ false])]
    [else false]))

(define (tc-lifetime-visible-scan? [env : TcTypeEnv] [lifetime : String]) : bool
  (match env
    [(TcTypeEnv.Nil) false]
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-lifetime-visible-scan? (box-get rest) lifetime)
        false)]
    [(TcTypeEnv.Bind key ty rest)
      (if (tc-env-binding-matches-lifetime? key ty lifetime)
        true
        (tc-lifetime-visible-scan? (box-get rest) lifetime))]))

(define (tc-lifetime-visible? [env : TcTypeEnv] [lifetime : String]) : bool
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match env
      [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
        (tc-lifetime-visible-scan? (box-get rest) lifetime)]
      [_ (tc-lifetime-visible-scan? env lifetime)])))

(define (tc-reference-lifetimes-visible?
  [env : TcTypeEnv]
  [lifetimes : TcStringList]) : bool
  (match lifetimes
    [(TcStringList.Nil) true]
    [(TcStringList.Cons lifetime rest)
      (and
        (tc-lifetime-visible? env lifetime)
        (tc-reference-lifetimes-visible? env (box-get rest)))]))

(define (tc-lifetime-outlives-binding-scan-inner
  [env : TcTypeEnv]
  [lifetime : String]
  [target : String]
  [seen-target : bool]) : bool
  (match env
    [(TcTypeEnv.Nil) false]
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-lifetime-outlives-binding-scan-inner
          (box-get rest)
          lifetime
          target
          seen-target)
        false)]
    [(TcTypeEnv.Bind key ty rest)
      (if (tc-env-binding-matches-lifetime? key ty lifetime)
        seen-target
        (tc-lifetime-outlives-binding-scan-inner
          (box-get rest)
          lifetime
          target
          (or seen-target (= key (tc-name-id target)))))]))

(define (tc-lifetime-outlives-binding-scan
  [env : TcTypeEnv]
  [lifetime : String]
  [target : String]
  [seen-target : bool]) : bool
  (match env
    [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
      (tc-lifetime-outlives-binding-scan-inner
        (box-get rest)
        lifetime
        target
        seen-target)]
    [_
      (tc-lifetime-outlives-binding-scan-inner env lifetime target seen-target)]))

(define (tc-lifetime-outlives-binding?
  [env : TcTypeEnv]
  [lifetime : String]
  [target : String]) : bool
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (tc-lifetime-outlives-binding-scan env lifetime target false)))

(define (tc-reference-lifetimes-outlive-binding?
  [env : TcTypeEnv]
  [lifetimes : TcStringList]
  [target : String]) : bool
  (match lifetimes
    [(TcStringList.Nil) true]
    [(TcStringList.Cons lifetime rest)
      (and
        (tc-lifetime-outlives-binding? env lifetime target)
        (tc-reference-lifetimes-outlive-binding? env (box-get rest) target))]))

(define (tc-lifetime-outlives-lifetime-scan-inner
  [env : TcTypeEnv]
  [value-lifetime : String]
  [target-lifetime : String]
  [seen-target : bool]) : bool
  (if (string.eq value-lifetime target-lifetime)
    true
    (match env
      [(TcTypeEnv.Nil) false]
      [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
        (if scan-through
          (tc-lifetime-outlives-lifetime-scan-inner
            (box-get rest)
            value-lifetime
            target-lifetime
            seen-target)
          false)]
      [(TcTypeEnv.Bind key ty rest)
        (if (tc-env-binding-matches-lifetime? key ty value-lifetime)
          seen-target
          (tc-lifetime-outlives-lifetime-scan-inner
            (box-get rest)
            value-lifetime
            target-lifetime
            (or
              seen-target
              (tc-env-binding-matches-lifetime? key ty target-lifetime))))])))

(define (tc-lifetime-outlives-lifetime-scan
  [env : TcTypeEnv]
  [value-lifetime : String]
  [target-lifetime : String]
  [seen-target : bool]) : bool
  (match env
    [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
      (tc-lifetime-outlives-lifetime-scan-inner
        (box-get rest)
        value-lifetime
        target-lifetime
        seen-target)]
    [_
      (tc-lifetime-outlives-lifetime-scan-inner
        env
        value-lifetime
        target-lifetime
        seen-target)]))

(define (tc-lifetime-outlives-lifetime?
  [env : TcTypeEnv]
  [value-lifetime : String]
  [target-lifetime : String]) : bool
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (tc-lifetime-outlives-lifetime-scan
      env
      value-lifetime
      target-lifetime
      false)))

(define (tc-reference-lifetimes-outlive-lifetime?
  [env : TcTypeEnv]
  [lifetimes : TcStringList]
  [target-lifetime : String]) : bool
  (match lifetimes
    [(TcStringList.Nil) true]
    [(TcStringList.Cons lifetime rest)
      (and
        (tc-lifetime-outlives-lifetime? env lifetime target-lifetime)
        (tc-reference-lifetimes-outlive-lifetime?
          env
          (box-get rest)
          target-lifetime))]))

(define (tc-ensure-reference-value-can-bind
  [env : TcTypeEnv]
  [value-ty : AstType]) : ResultTcUnit
  (let
    [lifetimes : TcStringList (tc-type-collect-regions value-ty)]
    (if (tc-reference-lifetimes-visible? env lifetimes)
      ResultTcUnit.Ok
      (ResultTcUnit.Err "typecheck: reference value would escape lexical scope"))))

(define (tc-ensure-reference-value-can-assign
  [env : TcTypeEnv]
  [target : String]
  [value-ty : AstType]) : ResultTcUnit
  (let
    [lifetimes : TcStringList (tc-type-collect-reference-lifetimes value-ty)]
    (if (tc-reference-lifetimes-outlive-binding? env lifetimes target)
      ResultTcUnit.Ok
      (ResultTcUnit.Err
        "typecheck: cannot store reference into longer-lived binding; reference value would escape lexical scope"))))

(define (tc-ensure-reference-type-does-not-escape-names
  [ty : AstType]
  [names : TcStringList]) : ResultTcUnit
  (if (tc-string-list-overlaps? (tc-type-collect-regions ty) names)
    (ResultTcUnit.Err "typecheck: reference value would escape lexical scope")
    ResultTcUnit.Ok))

(define (tc-type-strip-region [ty : AstType]) : AstType
  (match ty
    [(AstType.Region _ inner) (tc-type-strip-region (ty-node-get inner))]
    [_ ty]))

(define (tc-type-list-contains-region-tag? [types : AstTypeList]) : bool
  (tc-type-list-contains-region-tag-at? (& types) 0))

(define (tc-type-list-contains-region-tag-at?
  [types : (& types AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len types))
    false
    (if (tc-type-contains-region-tag?
      (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      true
      (tc-type-list-contains-region-tag-at? types (+ index 1)))))

(define (tc-type-contains-region-tag? [ty : AstType]) : bool
  (match ty
    [(AstType.Func args ret)
      (if (tc-type-list-contains-region-tag? (box-get args))
        true
        (tc-type-contains-region-tag? (ty-node-get ret)))]
    [(AstType.Tuple elems) (tc-type-list-contains-region-tag? (box-get elems))]
    [(AstType.Array elem _) (tc-type-contains-region-tag? (ty-node-get elem))]
    [(AstType.DynArray elem) (tc-type-contains-region-tag? (ty-node-get elem))]
    [(AstType.Box elem) (tc-type-contains-region-tag? (ty-node-get elem))]
    [(AstType.Ptr elem) (tc-type-contains-region-tag? (ty-node-get elem))]
    [(AstType.MutPtr elem) (tc-type-contains-region-tag? (ty-node-get elem))]
    [(AstType.Ref _ inner) (tc-type-contains-region-tag? (ty-node-get inner))]
    [(AstType.MutRef _ inner)
      (tc-type-contains-region-tag? (ty-node-get inner))]
    [(AstType.Region _ _) true]
    [_ false]))

(define (tc-type-list-without-regions [types : AstTypeList]) : AstTypeList
  (if (tc-type-list-contains-region-tag? types)
    (tc-type-list-without-regions-at (& types) 0)
    types))

(define (tc-type-list-without-regions-at
  [types : (& types AstTypeList)]
  [index : i64]) : AstTypeList
  (if (>= index (ast-type-list-len types))
    (ast-type-list-new)
    (ast-type-cons
      (tc-type-without-regions
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      (tc-type-list-without-regions-at types (+ index 1)))))

(define (tc-type-without-regions [ty : AstType]) : AstType
  (if (tc-type-contains-region-tag? ty)
    (match ty
      [(AstType.Func args ret)
        (ast-ty-func
          (tc-type-list-without-regions (box-get args))
          (tc-type-without-regions (ty-node-get ret)))]
      [(AstType.Tuple elems)
        (ast-ty-tuple (tc-type-list-without-regions (box-get elems)))]
      [(AstType.Array elem len)
        (ast-ty-array (tc-type-without-regions (ty-node-get elem)) len)]
      [(AstType.DynArray elem)
        (ast-ty-dyn-array (tc-type-without-regions (ty-node-get elem)))]
      [(AstType.Box elem)
        (ast-ty-box (tc-type-without-regions (ty-node-get elem)))]
      [(AstType.Ptr elem)
        (ast-ty-ptr (tc-type-without-regions (ty-node-get elem)))]
      [(AstType.MutPtr elem)
        (ast-ty-mut-ptr (tc-type-without-regions (ty-node-get elem)))]
      [(AstType.Ref region inner)
        (ast-ty-ref region (tc-type-without-regions (ty-node-get inner)))]
      [(AstType.MutRef region inner)
        (ast-ty-mut-ref region (tc-type-without-regions (ty-node-get inner)))]
      [(AstType.Region _ inner) (tc-type-without-regions (ty-node-get inner))]
      [(AstType.EnumArgs name lifetimes)
        (ast-ty-enum-args name (box-get lifetimes))]
      [(AstType.StructArgs name lifetimes)
        (ast-ty-struct-args name (box-get lifetimes))]
      [(AstType.VarArgs name lifetimes)
        (ast-ty-var-args name (box-get lifetimes))]
      [_ ty])
    ty))

(define (tc-type-list-contains-region [types : AstTypeList] [region : String]) : bool
  (tc-type-list-contains-region-at? (& types) region 0))

(define (tc-type-list-contains-region-at?
  [types : (& types AstTypeList)]
  [region : String]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len types))
    false
    (or
      (tc-type-contains-region
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))
        region)
      (tc-type-list-contains-region-at? types region (+ index 1)))))

(define (tc-type-contains-region [ty : AstType] [region : String]) : bool
  (match ty
    [(AstType.Func args ret)
      (or
        (tc-type-list-contains-region (box-get args) region)
        (tc-type-contains-region (ty-node-get ret) region))]
    [(AstType.Tuple elems)
      (tc-type-list-contains-region (box-get elems) region)]
    [(AstType.Array elem _) (tc-type-contains-region (ty-node-get elem) region)]
    [(AstType.DynArray elem)
      (tc-type-contains-region (ty-node-get elem) region)]
    [(AstType.Box elem) (tc-type-contains-region (ty-node-get elem) region)]
    [(AstType.Ptr elem) (tc-type-contains-region (ty-node-get elem) region)]
    [(AstType.MutPtr elem) (tc-type-contains-region (ty-node-get elem) region)]
    [(AstType.Ref name inner)
      (or
        (string.eq name region)
        (tc-type-contains-region (ty-node-get inner) region))]
    [(AstType.MutRef name inner)
      (or
        (string.eq name region)
        (tc-type-contains-region (ty-node-get inner) region))]
    [(AstType.Region name inner)
      (or
        (string.eq name region)
        (tc-type-contains-region (ty-node-get inner) region))]
    [(AstType.EnumArgs _ lifetimes)
      (tc-lifetime-list-contains (box-get lifetimes) region)]
    [(AstType.StructArgs _ lifetimes)
      (tc-lifetime-list-contains (box-get lifetimes) region)]
    [(AstType.VarArgs _ lifetimes)
      (tc-lifetime-list-contains (box-get lifetimes) region)]
    [_ false]))

(define (tc-type-list-contains-any-region [types : AstTypeList]) : bool
  (tc-type-list-contains-any-region-at? (& types) 0))

(define (tc-type-list-contains-any-region-at?
  [types : (& types AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len types))
    false
    (or
      (tc-type-contains-any-region
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      (tc-type-list-contains-any-region-at? types (+ index 1)))))

(define (tc-type-contains-any-region [ty : AstType]) : bool
  (match ty
    [(AstType.Func args ret)
      (or
        (tc-type-list-contains-any-region (box-get args))
        (tc-type-contains-any-region (ty-node-get ret)))]
    [(AstType.Tuple elems) (tc-type-list-contains-any-region (box-get elems))]
    [(AstType.Array elem _) (tc-type-contains-any-region (ty-node-get elem))]
    [(AstType.DynArray elem) (tc-type-contains-any-region (ty-node-get elem))]
    [(AstType.Box elem) (tc-type-contains-any-region (ty-node-get elem))]
    [(AstType.Ptr elem) (tc-type-contains-any-region (ty-node-get elem))]
    [(AstType.MutPtr elem) (tc-type-contains-any-region (ty-node-get elem))]
    [(AstType.Ref _ _) true]
    [(AstType.MutRef _ _) true]
    [(AstType.Region _ _) true]
    [(AstType.EnumArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [(AstType.StructArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [(AstType.VarArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [_ false]))

(define (tc-type-list-contains-reference? [types : AstTypeList]) : bool
  (tc-type-list-contains-reference-at? (& types) 0))

(define (tc-type-list-contains-reference-at?
  [types : (& types AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len types))
    false
    (or
      (tc-type-contains-reference?
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      (tc-type-list-contains-reference-at? types (+ index 1)))))

(define (tc-type-list-contains-mut-reference? [types : AstTypeList]) : bool
  (tc-type-list-contains-mut-reference-at? (& types) 0))

(define (tc-type-list-contains-mut-reference-at?
  [types : (& types AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len types))
    false
    (or
      (tc-type-contains-mut-reference?
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      (tc-type-list-contains-mut-reference-at? types (+ index 1)))))

(define (tc-type-contains-reference? [ty : AstType]) : bool
  (match ty
    [(AstType.Func args ret)
      (or
        (tc-type-list-contains-reference? (box-get args))
        (tc-type-contains-reference? (ty-node-get ret)))]
    [(AstType.Tuple elems) (tc-type-list-contains-reference? (box-get elems))]
    [(AstType.Array elem _) (tc-type-contains-reference? (ty-node-get elem))]
    [(AstType.DynArray elem) (tc-type-contains-reference? (ty-node-get elem))]
    [(AstType.Box elem) (tc-type-contains-reference? (ty-node-get elem))]
    [(AstType.Ptr elem) (tc-type-contains-reference? (ty-node-get elem))]
    [(AstType.MutPtr elem) (tc-type-contains-reference? (ty-node-get elem))]
    [(AstType.Ref _ _) true]
    [(AstType.MutRef _ _) true]
    [(AstType.Region _ inner) (tc-type-contains-reference? (ty-node-get inner))]
    [(AstType.EnumArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [(AstType.StructArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [(AstType.VarArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [_ false]))

(define (tc-type-contains-mut-reference? [ty : AstType]) : bool
  (match ty
    [(AstType.Func args ret)
      (or
        (tc-type-list-contains-mut-reference? (box-get args))
        (tc-type-contains-mut-reference? (ty-node-get ret)))]
    [(AstType.Tuple elems)
      (tc-type-list-contains-mut-reference? (box-get elems))]
    [(AstType.Array elem _)
      (tc-type-contains-mut-reference? (ty-node-get elem))]
    [(AstType.DynArray elem)
      (tc-type-contains-mut-reference? (ty-node-get elem))]
    [(AstType.Box elem) (tc-type-contains-mut-reference? (ty-node-get elem))]
    [(AstType.Ptr elem) (tc-type-contains-mut-reference? (ty-node-get elem))]
    [(AstType.MutPtr elem) (tc-type-contains-mut-reference? (ty-node-get elem))]
    [(AstType.Ref _ inner)
      (tc-type-contains-mut-reference? (ty-node-get inner))]
    [(AstType.MutRef _ _) true]
    [(AstType.Region _ inner)
      (tc-type-contains-mut-reference? (ty-node-get inner))]
    [_ false]))

(define (tc-type-list-collect-reference-lifetimes
  [types : AstTypeList]
  [out : TcStringList]) : TcStringList
  (tc-type-list-collect-reference-lifetimes-at (& types) out 0))

(define (tc-type-list-collect-reference-lifetimes-at
  [types : (& types AstTypeList)]
  [out : TcStringList]
  [index : i64]) : TcStringList
  (if (>= index (ast-type-list-len types))
    out
    (tc-type-list-collect-reference-lifetimes-at
      types
      (tc-type-collect-reference-lifetimes-into
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))
        out)
      (+ index 1))))

(define (tc-type-collect-reference-lifetimes-into
  [ty : AstType]
  [out : TcStringList]) : TcStringList
  (match ty
    [(AstType.Func args ret)
      (tc-type-collect-reference-lifetimes-into
        (ty-node-get ret)
        (tc-type-list-collect-reference-lifetimes (box-get args) out))]
    [(AstType.Tuple elems)
      (tc-type-list-collect-reference-lifetimes (box-get elems) out)]
    [(AstType.Array elem _)
      (tc-type-collect-reference-lifetimes-into (ty-node-get elem) out)]
    [(AstType.DynArray elem)
      (tc-type-collect-reference-lifetimes-into (ty-node-get elem) out)]
    [(AstType.Box elem)
      (tc-type-collect-reference-lifetimes-into (ty-node-get elem) out)]
    [(AstType.Ptr elem)
      (tc-type-collect-reference-lifetimes-into (ty-node-get elem) out)]
    [(AstType.MutPtr elem)
      (tc-type-collect-reference-lifetimes-into (ty-node-get elem) out)]
    [(AstType.Ref lifetime inner)
      (tc-type-collect-reference-lifetimes-into
        (ty-node-get inner)
        (tc-string-list-add out lifetime))]
    [(AstType.MutRef lifetime inner)
      (tc-type-collect-reference-lifetimes-into
        (ty-node-get inner)
        (tc-string-list-add out lifetime))]
    [(AstType.Region _ inner)
      (tc-type-collect-reference-lifetimes-into (ty-node-get inner) out)]
    [(AstType.EnumArgs _ lifetimes)
      (tc-lifetime-list-to-string-list-into (box-get lifetimes) out)]
    [(AstType.StructArgs _ lifetimes)
      (tc-lifetime-list-to-string-list-into (box-get lifetimes) out)]
    [(AstType.VarArgs _ lifetimes)
      (tc-lifetime-list-to-string-list-into (box-get lifetimes) out)]
    [_ out]))

(define (tc-type-collect-reference-lifetimes [ty : AstType]) : TcStringList
  (tc-type-collect-reference-lifetimes-into ty TcStringList.Nil))

(define (tc-maybe-type-contains-reference? [maybe-ty : AstMaybeType]) : bool
  (match maybe-ty
    [(AstMaybeType.No) false]
    [(AstMaybeType.Some ty) (tc-type-contains-reference? ty)]))

(define (tc-param-list-contains-reference? [params : AstParamList]) : bool
  (tc-param-list-contains-reference-at? (& params) 0))

(define (tc-param-list-contains-reference-at?
  [params : (& params AstParamList)]
  [index : i64]) : bool
  (if (>= index (ast-param-list-len params))
    false
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param _ ty _)
        (or
          (tc-type-contains-reference? ty)
          (tc-param-list-contains-reference-at? params (+ index 1)))])))

(define (tc-param-list-reference-return-lifetimes-into
  [ctx : TcContext]
  [params : AstParamList]
  [out : TcStringList]) : TcStringList
  (tc-param-list-reference-return-lifetimes-at ctx (& params) 0 out))

(define (tc-param-list-reference-return-lifetimes-at
  [ctx : TcContext]
  [params : (& params AstParamList)]
  [index : i64]
  [out : TcStringList]) : TcStringList
  (if (>= index (ast-param-list-len params))
    out
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param name ty _)
        (tc-param-list-reference-return-lifetimes-at
          ctx
          params
          (+ index 1)
          (tc-type-collect-reference-lifetimes-into
            (tc-resolve-type ctx ty)
            (tc-string-list-add out (intern-str name))))])))

(define (tc-reference-return-lifetimes-allowed?
  [ctx : TcContext]
  [params : AstParamList]
  [ret : AstType]) : bool
  (tc-string-list-all-in?
    (tc-type-collect-reference-lifetimes (tc-resolve-type ctx ret))
    (tc-param-list-reference-return-lifetimes-into ctx params TcStringList.Nil)))

(define (tc-reference-return-policy-ok
  [ctx : TcContext]
  [params : AstParamList]
  [ret : AstType]) : ResultTcUnit
  (if (tc-type-contains-reference? (tc-resolve-type ctx ret))
    (if (tc-reference-return-lifetimes-allowed? ctx params ret)
      ResultTcUnit.Ok
      (ResultTcUnit.Err
        "typecheck: returned reference lifetime must be tied to a parameter"))
    ResultTcUnit.Ok))

(define (tc-type-list-collect-regions
  [types : AstTypeList]
  [out : TcStringList]) : TcStringList
  (tc-type-list-collect-regions-at (& types) out 0))

(define (tc-type-list-collect-regions-at
  [types : (& types AstTypeList)]
  [out : TcStringList]
  [index : i64]) : TcStringList
  (if (>= index (ast-type-list-len types))
    out
    (tc-type-list-collect-regions-at
      types
      (tc-type-collect-regions-into
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))
        out)
      (+ index 1))))

(define (tc-type-collect-regions-into [ty : AstType] [out : TcStringList]) : TcStringList
  (match ty
    [(AstType.Func args ret)
      (tc-type-collect-regions-into
        (ty-node-get ret)
        (tc-type-list-collect-regions (box-get args) out))]
    [(AstType.Tuple elems) (tc-type-list-collect-regions (box-get elems) out)]
    [(AstType.Array elem _)
      (tc-type-collect-regions-into (ty-node-get elem) out)]
    [(AstType.DynArray elem)
      (tc-type-collect-regions-into (ty-node-get elem) out)]
    [(AstType.Box elem) (tc-type-collect-regions-into (ty-node-get elem) out)]
    [(AstType.Ptr elem) (tc-type-collect-regions-into (ty-node-get elem) out)]
    [(AstType.MutPtr elem)
      (tc-type-collect-regions-into (ty-node-get elem) out)]
    [(AstType.Ref name inner)
      (tc-type-collect-regions-into
        (ty-node-get inner)
        (tc-string-list-add out name))]
    [(AstType.MutRef name inner)
      (tc-type-collect-regions-into
        (ty-node-get inner)
        (tc-string-list-add out name))]
    [(AstType.Region name inner)
      (tc-type-collect-regions-into
        (ty-node-get inner)
        (tc-string-list-add out name))]
    [(AstType.EnumArgs _ lifetimes)
      (tc-lifetime-list-to-string-list-into (box-get lifetimes) out)]
    [(AstType.StructArgs _ lifetimes)
      (tc-lifetime-list-to-string-list-into (box-get lifetimes) out)]
    [(AstType.VarArgs _ lifetimes)
      (tc-lifetime-list-to-string-list-into (box-get lifetimes) out)]
    [_ out]))

(define (tc-type-collect-regions [ty : AstType]) : TcStringList
  (tc-type-collect-regions-into ty TcStringList.Nil))

(define (tc-region-list-contains-arena-owner?
  [regions : TcStringList]
  [owner : String]) : bool
  (match regions
    [(TcStringList.Nil) false]
    [(TcStringList.Cons region rest)
      (or
        (tc-arena-region-owned-by? owner region)
        (tc-region-list-contains-arena-owner? (box-get rest) owner))]))

(define (tc-type-contains-arena-owner-region? [ty : AstType] [owner : String]) : bool
  (tc-region-list-contains-arena-owner? (tc-type-collect-regions ty) owner))

(define (tc-region-list-all-atomic-arena-owners?
  [env : TcTypeEnv]
  [regions : TcStringList]) : bool
  (match regions
    [(TcStringList.Nil) true]
    [(TcStringList.Cons region rest)
      (and
        (tc-atomic-arena-owner-active? env region)
        (tc-region-list-all-atomic-arena-owners? env (box-get rest)))]))

(define (tc-type-regions-all-atomic-arena-owners?
  [env : TcTypeEnv]
  [ty : AstType]) : bool
  (tc-region-list-all-atomic-arena-owners? env (tc-type-collect-regions ty)))

(define (tc-type-outer-region [ty : AstType]) : TcMaybeString
  (match ty
    [(AstType.Region region _) (TcMaybeString.Some region)]
    [_ (TcMaybeString.No)]))

(define (tc-type-outer-regions [ty : AstType]) : TcStringList
  (match ty
    [(AstType.Region region inner)
      (tc-string-list-add (tc-type-outer-regions (ty-node-get inner)) region)]
    [_ TcStringList.Nil]))

(define (tc-region-taggable-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.String) true]
    [(AstType.DynArray _) true]
    [(AstType.Box _) true]
    [(AstType.Tuple _) true]
    [(AstType.Struct _) true]
    [(AstType.StructArgs _ _) true]
    [(AstType.Enum _) true]
    [(AstType.EnumArgs _ _) true]
    [_ false]))

(define (tc-tag-region [region : String] [ty : AstType]) : AstType
  (if (tc-region-taggable-type? ty)
    (ast-ty-region region ty)
    ty))

(define (tc-tag-active-region [env : TcTypeEnv] [ty : AstType]) : AstType
  (match (tc-active-region env)
    [(TcMaybeString.Some region) (tc-tag-region region ty)]
    [(TcMaybeString.No) ty]))

;; Nominal aggregate types have no lifetime-argument surface yet. Until they do,
;; constructor results carry stored-reference lifetimes as local region facts so
;; existing flow/escape checks can reject boundary escapes.
(define (tc-tag-reference-lifetimes [lifetimes : TcStringList] [ty : AstType]) : AstType
  (match lifetimes
    [(TcStringList.Nil) ty]
    [(TcStringList.Cons lifetime rest)
      (tc-tag-region lifetime (tc-tag-reference-lifetimes (box-get rest) ty))]))

(define (tc-constructor-target-type
  [env : TcTypeEnv]
  [params : AstTypeList]
  [ret : AstType]) : AstType
  (tc-tag-active-region
    env
    (tc-tag-reference-lifetimes
      (tc-type-list-collect-reference-lifetimes params TcStringList.Nil)
      ret)))

(define (tc-project-from-region-container
  [container-ty : AstType]
  [projected-ty : AstType]) : AstType
  (match (tc-type-outer-region container-ty)
    [(TcMaybeString.Some region) (tc-tag-region region projected-ty)]
    [(TcMaybeString.No)
      (match (tc-type-strip-region container-ty)
        [(AstType.Ref region _) (tc-tag-region region projected-ty)]
        [(AstType.MutRef region _) (tc-tag-region region projected-ty)]
        [_ projected-ty])]))

;; Region-tagged aggregate flow uses the same lexical owner ordering as
;; references, but only considers arena owners. A value from an outer region can
;; flow into an inner target; an inner-region value cannot flow outward.
(define (tc-region-outlives-or-matches-scan
  [env : TcTypeEnv]
  [value-region : String]
  [target-region : String]) : bool
  (if (string.eq value-region target-region)
    true
    (match env
      [(TcTypeEnv.Nil) false]
      [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
        (if scan-through
          (tc-region-outlives-or-matches-scan
            (box-get rest)
            value-region
            target-region)
          false)]
      [(TcTypeEnv.Bind key ty rest)
        (if (= key (tc-region-marker-id))
          (match ty
            [(AstType.Var region)
              (if (string.eq (intern-str region) value-region)
                false
                (if (string.eq (intern-str region) target-region)
                  true
                  (tc-region-outlives-or-matches-scan
                    (box-get rest)
                    value-region
                    target-region)))]
            [_
              (tc-region-outlives-or-matches-scan
                (box-get rest)
                value-region
                target-region)])
          (tc-region-outlives-or-matches-scan
            (box-get rest)
            value-region
            target-region))])))

(define (tc-region-outlives-or-matches
  [env : TcTypeEnv]
  [value-region : String]
  [target-region : String]) : bool
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match env
      [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
        (tc-region-outlives-or-matches-scan
          (box-get rest)
          value-region
          target-region)]
      [_ (tc-region-outlives-or-matches-scan env value-region target-region)])))

(define (tc-region-can-flow-into-any
  [env : TcTypeEnv]
  [value-region : String]
  [target-regions : TcStringList]) : bool
  (match target-regions
    [(TcStringList.Nil) false]
    [(TcStringList.Cons target rest)
      (if (tc-region-outlives-or-matches env value-region target)
        true
        (tc-region-can-flow-into-any env value-region (box-get rest)))]))

(define (tc-region-list-can-flow-into
  [env : TcTypeEnv]
  [value-regions : TcStringList]
  [target-regions : TcStringList]) : bool
  (match value-regions
    [(TcStringList.Nil) true]
    [(TcStringList.Cons value rest)
      (and
        (tc-region-can-flow-into-any env value target-regions)
        (tc-region-list-can-flow-into env (box-get rest) target-regions))]))

(define (tc-ensure-region-value-can-flow-into
  [env : TcTypeEnv]
  [target-ty : AstType]
  [value-ty : AstType]
  [context : String]) : ResultTcUnit
  (let
    [value-regions : TcStringList (tc-type-collect-regions value-ty)]
    (match value-regions
      [(TcStringList.Nil) ResultTcUnit.Ok]
      [_
        (let
          [target-regions : TcStringList (tc-type-collect-regions target-ty)]
          (if (and
            (tc-type-contains-any-region target-ty)
            (tc-region-list-can-flow-into env value-regions target-regions))
            ResultTcUnit.Ok
            (ResultTcUnit.Err
              (string.append
                "typecheck: cannot store region-tagged value into "
                (string.append context "; region value would escape")))))])))

(define (tc-resolve-type-list [ctx : TcContext] [types : AstTypeList]) : AstTypeList
  (if (tc-type-list-needs-resolution? types)
    (tc-resolve-type-list-at ctx (& types) 0)
    types))

(define (tc-resolve-type-list-at
  [ctx : TcContext]
  [types : (& types AstTypeList)]
  [index : i64]) : AstTypeList
  (if (>= index (ast-type-list-len types))
    (ast-type-list-new)
    (ast-type-cons
      (tc-resolve-type
        ctx
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      (tc-resolve-type-list-at ctx types (+ index 1)))))

(define (tc-type-list-needs-resolution? [types : AstTypeList]) : bool
  (tc-type-list-needs-resolution-at? (& types) 0))

(define (tc-type-list-needs-resolution-at?
  [types : (& types AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len types))
    false
    (if (tc-type-needs-resolution?
      (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      true
      (tc-type-list-needs-resolution-at? types (+ index 1)))))

(define (tc-type-needs-resolution? [ty : AstType]) : bool
  (match ty
    [(AstType.Func args ret)
      (if (tc-type-list-needs-resolution? (box-get args))
        true
        (tc-type-needs-resolution? (ty-node-get ret)))]
    [(AstType.Tuple elems) (tc-type-list-needs-resolution? (box-get elems))]
    [(AstType.Array elem _) (tc-type-needs-resolution? (ty-node-get elem))]
    [(AstType.DynArray elem) (tc-type-needs-resolution? (ty-node-get elem))]
    [(AstType.Box elem) (tc-type-needs-resolution? (ty-node-get elem))]
    [(AstType.Ptr elem) (tc-type-needs-resolution? (ty-node-get elem))]
    [(AstType.MutPtr elem) (tc-type-needs-resolution? (ty-node-get elem))]
    [(AstType.Ref _ inner) (tc-type-needs-resolution? (ty-node-get inner))]
    [(AstType.MutRef _ inner) (tc-type-needs-resolution? (ty-node-get inner))]
    [(AstType.Region _ inner) (tc-type-needs-resolution? (ty-node-get inner))]
    [(AstType.VarArgs _ _) true]
    [(AstType.Var _) true]
    [_ false]))

(define (tc-name-qualified? [name : String]) : bool
  (and (not (tc-hygiene-local-name? name)) (intern-name-qualified? name)))

(define (tc-name-first-char [name : String] [needle : char]) : i64
  (let
    [i : i64 0]
    [n : i64 (string.string-length name)]
    (begin
      (while (< i n)
        (if (string.char-eq (string.string-ref name i) needle)
          (return i)
          (set! i (+ i 1))))
      -1)))

(define (tc-name-first-dot [name : String]) : i64
  (intern-name-first-dot name))

(define (tc-source-slash-qualified? [name : String]) : bool
  (tc-source-slash-qualified-id? name (tc-name-id name)))

;; Variant taking the already-interned `name-id` so the hot name-resolution
;; path interns each name once and reads the slash position from the id-keyed
;; metadata instead of re-hashing the string. The hygiene checks stay on the
;; string (cheap prefix tests, no interning). `intern-name-last-slash name`
;; is exactly `intern-qualified-last-slash (intern name)`, so this is
;; semantics-preserving.
(define (tc-source-slash-qualified-id? [name : String] [name-id : i64]) : bool
  (let
    [slash : i64 (intern-qualified-last-slash name-id)]
    [n : i64 (string.string-length name)]
    (and
      (not (tc-hygiene-local-name? name))
      (not (tc-hygiene-global-name? name))
      (> slash 0)
      (< slash (- n 1)))))

(define (tc-name-slashes-to-dots [name : String]) : String
  (let
    [i : i64 0]
    [n : i64 (string.string-length name)]
    [out : String ""]
    (begin
      (while (< i n)
        (let
          [chunk : String
            (if (string.char-eq (string.string-ref name i) '/')
              "."
              (string.substring name i 1))]
          (begin
            (set! out (string.concat3 out chunk ""))
            (set! i (+ i 1)))))
      out)))

(define (tc-source-slash-qualified-message [name : String]) : String
  (str_cat.str-cat
    "typecheck: slash-qualified name "
    name
    " is no longer supported; use "
    (tc-name-slashes-to-dots name)))

;; Bootstrap bridge: published stage0 builds may still encounter legacy
;; slash-qualified core macro spellings. Keep this narrow until the seed no
;; longer needs the compatibility path.
(define (tc-source-legacy-core-macro-compat? [name : String]) : bool
  (if (tc-name-qualified? name)
    (let
      [module : String (tc-qualified-name-module name)]
      [base : String (tc-qualified-name-base name)]
      (and
        (string.eq module "core")
        (or
          (string.eq base "when")
          (string.eq base "unless")
          (string.eq base "and")
          (string.eq base "or")
          (string.eq base "cond"))))
    false))

(define (tc-source-name-bound-exact-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (tc-name-bound-id? env name-id))

(define (tc-source-name-bound-exact? [env : TcTypeEnv] [name : String]) : bool
  (tc-source-name-bound-exact-id? env (tc-name-id name)))

(define (tc-current-module-source-lookup-key
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]) : TcMaybeString
  (let
    [module : String (tc-context-module ctx)]
    (if (and
      (> (string.string-length module) 0)
      (not (tc-name-qualified? name)))
      (let
        [module-key : String (compiler-symbol-module-key module name)]
        [module-key-id : i64 (tc-name-id module-key)]
        (if (tc-source-name-bound-exact-id? env module-key-id)
          (TcMaybeString.Some module-key)
          (TcMaybeString.No)))
      (TcMaybeString.No))))

(define (tc-source-leading-segment-bound?
  [env : TcTypeEnv]
  [name : String]
  [first-dot : i64]) : bool
  (if (<= first-dot 0)
    false
    (tc-source-name-bound-exact? env (string.substring name 0 first-dot))))

(define (tc-source-leading-segment-wins-over-exact-id?
  [env : TcTypeEnv]
  [name-id : i64]
  [prefix-id : i64]) : bool
  (match env
    [(TcTypeEnv.Nil) false]
    [(TcTypeEnv.Bind key _ rest)
      (if (= key name-id)
        false
        (if (= key prefix-id)
          true
          (tc-source-leading-segment-wins-over-exact-id?
            (box-get rest)
            name-id
            prefix-id)))]
    [(TcTypeEnv.Cache ids _ _ _ _ _ partial _ below)
      (match (hashmap.i64-i64-map-get ids prefix-id)
        [(hashmap.I64I64MapFound prefix-index)
          (match (hashmap.i64-i64-map-get ids name-id)
            [(hashmap.I64I64MapFound name-index) (< prefix-index name-index)]
            [(hashmap.I64I64MapMissing) true])]
        [(hashmap.I64I64MapMissing)
          (if partial
            (match (hashmap.i64-i64-map-get ids name-id)
              [(hashmap.I64I64MapFound _) false]
              [(hashmap.I64I64MapMissing)
                (tc-source-leading-segment-wins-over-exact-id?
                  (box-get below)
                  name-id
                  prefix-id)])
            false)])]))

(define (tc-source-leading-segment-wins-over-exact-id-from-dot?
  [env : TcTypeEnv]
  [name-id : i64]
  [first-dot : i64]) : bool
  (if (<= first-dot 0)
    false
    (let
      [prefix-id : i64 (intern-leading-dot-id name-id)]
      (if (< prefix-id 0)
        false
        (tc-source-leading-segment-wins-over-exact-id? env name-id prefix-id)))))

(define (tc-source-leading-segment-wins-over-exact?
  [env : TcTypeEnv]
  [name : String]
  [first-dot : i64]) : bool
  (tc-source-leading-segment-wins-over-exact-from-id?
    env
    name
    (tc-name-id name)
    first-dot))

;; Variant taking the already-interned `name-id` to avoid re-hashing `name` on
;; the hot resolution path. The prefix comes from intern metadata recorded with
;; the first dot.
(define (tc-source-leading-segment-wins-over-exact-from-id?
  [env : TcTypeEnv]
  [_name : String]
  [name-id : i64]
  [first-dot : i64]) : bool
  (if (<= first-dot 0)
    false
    (let
      [prefix-id : i64 (intern-leading-dot-id name-id)]
      (if (< prefix-id 0)
        false
        (tc-source-leading-segment-wins-over-exact-id? env name-id prefix-id)))))

(define (tc-dotted-field-index-message [name : String]) : String
  (str_cat.str-cat
    "typecheck: dotted field access "
    name
    " cannot use numeric field segments; use tuple-ref or array-ref"))

(define (tc-dotted-field-empty-message) : String
  "typecheck: malformed dotted field access; field name cannot be empty")

(define (tc-dotted-field-index-like? [name : String] [start : i64] [len : i64]) : bool
  (and
    (> len 0)
    (>= (string.string-ref name start) '0')
    (<= (string.string-ref name start) '9')))

(define (tc-dotted-local-field-name? [env : TcTypeEnv] [name : String]) : bool
  (let
    [first-dot : i64 (tc-name-first-dot name)]
    (if (< first-dot 0)
      false
      (tc-source-leading-segment-wins-over-exact? env name first-dot))))

(define (tc-dotted-local-field-name-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (let
    [first-dot : i64 (intern-first-dot name-id)]
    (if (< first-dot 0)
      false
      (tc-source-leading-segment-wins-over-exact-id-from-dot?
        env
        name-id
        first-dot))))

(define (tc-dotted-local-field-expr-id-tail
  [name : String]
  [start : i64]
  [current : i64]) : ResultTcExprId
  (let
    [n : i64 (string.string-length name)]
    [i : i64 start]
    (begin
      (while (and (< i n) (not (string.char-eq (string.string-ref name i) '.')))
        (set! i (+ i 1)))
      (let
        [len : i64 (- i start)]
        (if (<= len 0)
          (ResultTcExprId.Err (tc-dotted-field-empty-message))
          (if (tc-dotted-field-index-like? name start len)
            (ResultTcExprId.Err (tc-dotted-field-index-message name))
            (let
              [field : String (string.substring name start len)]
              [next : i64 (ast-expr-struct-get current field)]
              (if (< i n)
                (tc-dotted-local-field-expr-id-tail name (+ i 1) next)
                (ResultTcExprId.Ok next)))))))))

(define (tc-dotted-local-field-expr-id [env : TcTypeEnv] [name : String]) : ResultTcExprId
  (if (tc-dotted-local-field-name? env name)
    (let
      [first-dot : i64 (tc-name-first-dot name)]
      [root-name : String (string.substring name 0 first-dot)]
      [root : i64 (ast-node-push (AstExpr.Var (intern root-name)))]
      (tc-dotted-local-field-expr-id-tail name (+ first-dot 1) root))
    (ResultTcExprId.Err "")))

(define (tc-dotted-local-field-set-expr-id
  [env : TcTypeEnv]
  [name : String]
  [value : i64]) : ResultTcExprId
  (match (tc-dotted-local-field-expr-id env name)
    [(ResultTcExprId.Ok get-id)
      (match (ast-expr-unspan (ast-node-get get-id))
        [(AstExpr.StructGet receiver-box field)
          (ResultTcExprId.Ok (ast-expr-struct-set-id receiver-box field value))]
        [_
          (ResultTcExprId.Err
            "typecheck: internal dotted field target mismatch")])]
    [(ResultTcExprId.Err message) (ResultTcExprId.Err message)]))

(define tc-imported-module-identity-cache-capacity : i64
  8192)
(define tc-imported-module-identity-cache-module-keys : (Array i64)
  (array.make-array i64 8192))
(define tc-imported-module-identity-cache-target-keys : (Array i64)
  (array.make-array i64 8192))
(define tc-imported-module-identity-cache-values : (Array i64)
  (array.make-array i64 8192))
(define tc-imported-module-identity-cache-count : i64
  0)
(define tc-imported-module-identity-cache-generation : i64
  -1)
(define tc-imported-module-identity-cache-ready : bool
  false)

(define (tc-imported-module-identity-cache-reset!) : unit
  (set! tc-imported-module-identity-cache-ready false))

(define (tc-imported-module-identity-cache-ensure!) : unit
  (if (if tc-imported-module-identity-cache-ready
    (= tc-imported-module-identity-cache-generation (intern-generation))
    false)
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i tc-imported-module-identity-cache-capacity)
          (begin
            (array-set! tc-imported-module-identity-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set! tc-imported-module-identity-cache-count 0)
        (set! tc-imported-module-identity-cache-generation (intern-generation))
        (set! tc-imported-module-identity-cache-ready true)))))

(define (tc-imported-module-identity-cache-bucket
  [current-module-id : i64]
  [target-id : i64]) : i64
  (bit-and
    (+ (* current-module-id 2654435761) (* target-id 40503))
    (- tc-imported-module-identity-cache-capacity 1)))

;; Returns 1 for true, -1 for false, or -2 when absent.
(define (tc-imported-module-identity-cache-get
  [current-module-id : i64]
  [target-id : i64]) : i64
  (let
    [cursor : i64
      (tc-imported-module-identity-cache-bucket current-module-id target-id)]
    [module-key : i64 (+ current-module-id 1)]
    [target-key : i64 (+ target-id 1)]
    [steps : i64 0]
    [out : i64 -2]
    [done : bool false]
    (begin
      (while (if done
        false
        (< steps tc-imported-module-identity-cache-capacity))
        (let
          [slot : i64
            (array-ref tc-imported-module-identity-cache-module-keys cursor)]
          (if (= slot 0)
            (set! done true)
            (if (and
              (= slot module-key)
              (=
                (array-ref tc-imported-module-identity-cache-target-keys cursor)
                target-key))
              (begin
                (set!
                  out
                  (array-ref tc-imported-module-identity-cache-values cursor))
                (set! done true))
              (begin
                (set!
                  cursor
                  (bit-and
                    (+ cursor 1)
                    (- tc-imported-module-identity-cache-capacity 1)))
                (set! steps (+ steps 1)))))))
      out)))

(define (tc-imported-module-identity-cache-put!
  [current-module-id : i64]
  [target-id : i64]
  [value : bool]) : unit
  (if (>=
    (* tc-imported-module-identity-cache-count 2)
    tc-imported-module-identity-cache-capacity)
    unit
    (let
      [cursor : i64
        (tc-imported-module-identity-cache-bucket current-module-id target-id)]
      [module-key : i64 (+ current-module-id 1)]
      [target-key : i64 (+ target-id 1)]
      [steps : i64 0]
      [done : bool false]
      (begin
        (while (if done
          false
          (< steps tc-imported-module-identity-cache-capacity))
          (let
            [slot : i64
              (array-ref tc-imported-module-identity-cache-module-keys cursor)]
            (if (= slot 0)
              (begin
                (array-set!
                  tc-imported-module-identity-cache-module-keys
                  cursor
                  module-key)
                (array-set!
                  tc-imported-module-identity-cache-target-keys
                  cursor
                  target-key)
                (array-set!
                  tc-imported-module-identity-cache-values
                  cursor
                  (if value
                    1
                    -1))
                (set!
                  tc-imported-module-identity-cache-count
                  (+ tc-imported-module-identity-cache-count 1))
                (set! done true))
              (if (and
                (= slot module-key)
                (=
                  (array-ref
                    tc-imported-module-identity-cache-target-keys
                    cursor)
                  target-key))
                (set! done true)
                (begin
                  (set!
                    cursor
                    (bit-and
                      (+ cursor 1)
                      (- tc-imported-module-identity-cache-capacity 1)))
                  (set! steps (+ steps 1)))))))
        unit))))

(define (tc-imported-module-identity-ids?
  [decls : AstDeclList]
  [current-module-id : i64]
  [target-id : i64]
  [module-id : i64]) : bool
  (let
    [cursor : AstDeclList decls]
    [current-module : i64 module-id]
    [found : bool false]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons decl rest-box)
            (let
              [rest : AstDeclList rest-box]
              (match decl
                [(AstDecl.Module next-module)
                  (begin
                    (set! current-module next-module)
                    (set! cursor rest))]
                [(AstDecl.Import (AstImportSpec.Spec _ _ expected _ _))
                  (begin
                    (if (= current-module current-module-id)
                      (match expected
                        [(AstMaybeModuleName.Some target)
                          (if (= (intern target) target-id)
                            (begin
                              (set! found true)
                              (set! done true))
                            unit)]
                        [(AstMaybeModuleName.No) unit])
                      unit)
                    (if done
                      unit
                      (set! cursor rest)))]
                [_ (set! cursor rest)]))]))
      found)))

(define (tc-imported-module-identity-id? [ctx : TcContext] [target-id : i64]) : bool
  (match ctx
    [(TcContext program _ _ current-module _)
      (match program
        [(AstProgram.Program decls-box)
          (begin
            (tc-imported-module-identity-cache-ensure!)
            (let
              [current-module-id : i64 (intern current-module)]
              [cached : i64
                (tc-imported-module-identity-cache-get
                  current-module-id
                  target-id)]
              (if (= cached -2)
                (let
                  [found : bool
                    (tc-imported-module-identity-ids?
                      (box-get decls-box)
                      current-module-id
                      target-id
                      (intern ""))]
                  (begin
                    (tc-imported-module-identity-cache-put!
                      current-module-id
                      target-id
                      found)
                    found))
                (> cached 0))))])]))

(define (tc-imported-module-identity? [ctx : TcContext] [module-name : String]) : bool
  (tc-imported-module-identity-id? ctx (intern module-name)))

(define (tc-stdlib-string-module-name? [module-name : String]) : bool
  (or
    (string.eq module-name "string")
    (string.eq module-name "string.tl")
    (string.eq module-name "stdlib.string")
    (string.eq module-name "stdlib/string")
    (string.eq module-name "stdlib/string.tl")
    (tc-string-has-suffix? module-name "/stdlib/string.tl")
    (tc-string-has-suffix? module-name "\\stdlib\\string.tl")
    (tc-string-has-suffix? module-name "\\stdlib/string.tl")
    (tc-string-has-suffix? module-name "/stdlib\\string.tl")))

(define (tc-context-is-stdlib-string? [ctx : TcContext]) : bool
  (tc-stdlib-string-module-name? (tc-context-module ctx)))

(define (tc-type-list-ty-node-get [types : AstTypeList] [index : i64]) : AstType
  (ty-node-get (ast-type-list-get (& types) index (ast-type-id-fallback))))

(define (tc-stdlib-string-length-wrapper-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Func args ret)
      (let
        [args : AstTypeList (box-get args)]
        (if (= (ast-type-list-len (& args)) 1)
          (and
            (tc-str-ref-type? (tc-type-list-ty-node-get args 0))
            (tc-type-eq (ty-node-get ret) (AstType.I64)))
          false))]
    [_ false]))

(define (tc-stdlib-string-ref-wrapper-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Func args ret)
      (let
        [args : AstTypeList (box-get args)]
        (if (= (ast-type-list-len (& args)) 2)
          (and
            (tc-str-ref-type? (tc-type-list-ty-node-get args 0))
            (tc-type-eq (tc-type-list-ty-node-get args 1) (AstType.I64))
            (tc-type-eq (ty-node-get ret) (AstType.Char)))
          false))]
    [_ false]))

(define (tc-stdlib-string-eq-wrapper-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Func args ret)
      (let
        [args : AstTypeList (box-get args)]
        (if (= (ast-type-list-len (& args)) 2)
          (and
            (tc-string-handle-type? (tc-type-list-ty-node-get args 0))
            (tc-string-handle-type? (tc-type-list-ty-node-get args 1))
            (tc-type-eq (ty-node-get ret) (AstType.Bool)))
          false))]
    [_ false]))

(define (tc-stdlib-string-copy-wrapper-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Func args ret)
      (let
        [args : AstTypeList (box-get args)]
        (if (= (ast-type-list-len (& args)) 2)
          (and
            (tc-str-ref-type? (tc-type-list-ty-node-get args 0))
            (tc-str-ref-type? (tc-type-list-ty-node-get args 1))
            (tc-type-eq (ty-node-get ret) (AstType.String)))
          false))]
    [_ false]))

(define (tc-stdlib-string-to-int-wrapper-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Func args ret)
      (let
        [args : AstTypeList (box-get args)]
        (if (= (ast-type-list-len (& args)) 1)
          (and
            (tc-string-handle-type? (tc-type-list-ty-node-get args 0))
            (tc-type-eq (ty-node-get ret) (AstType.I64)))
          false))]
    [_ false]))

(define (tc-stdlib-string-helper-wrapper-type? [base : String] [ty : AstType]) : bool
  (cond
    [(string.eq base "string-length")
      (tc-stdlib-string-length-wrapper-type? ty)]
    [(string.eq base "string-ref") (tc-stdlib-string-ref-wrapper-type? ty)]
    [(string.eq base "char-at") (tc-stdlib-string-ref-wrapper-type? ty)]
    [(string.eq base "eq") (tc-stdlib-string-eq-wrapper-type? ty)]
    [(string.eq base "string-eq") (tc-stdlib-string-eq-wrapper-type? ty)]
    [(string.eq base "string=?") (tc-stdlib-string-eq-wrapper-type? ty)]
    [(string.eq base "string-append") (tc-stdlib-string-copy-wrapper-type? ty)]
    [(string.eq base "string-concat") (tc-stdlib-string-copy-wrapper-type? ty)]
    [(string.eq base "string->int") (tc-stdlib-string-to-int-wrapper-type? ty)]
    [else false]))

(define (tc-stdlib-string-helper-bound-wrapper?
  [env : TcTypeEnv]
  [base : String]) : bool
  (match (tc-lookup env base)
    [(ResultTcType.Ok ty) (tc-stdlib-string-helper-wrapper-type? base ty)]
    [(ResultTcType.Err _) false]))

(define (tc-stdlib-string-length-wrapper-decl?
  [ctx : TcContext]
  [base : String]
  [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.DefFn name params ret _ _)
      (and
        (string.eq (intern-str name) base)
        (tc-type-eq (tc-resolve-type ctx ret) (AstType.I64))
        (= (ast-param-list-len (& params)) 1)
        (match (ast-param-list-get (& params) 0 (ast-param-fallback))
          [(AstParam.Param _ text _)
            (tc-str-ref-type? (tc-resolve-type ctx text))]
          [_ false]))]
    [_ false]))

(define (tc-stdlib-string-ref-wrapper-decl?
  [ctx : TcContext]
  [base : String]
  [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.DefFn name params ret _ _)
      (and
        (string.eq (intern-str name) base)
        (tc-type-eq (tc-resolve-type ctx ret) (AstType.Char))
        (= (ast-param-list-len (& params)) 2)
        (match (ast-param-list-get (& params) 0 (ast-param-fallback))
          [(AstParam.Param _ text _)
            (match (ast-param-list-get (& params) 1 (ast-param-fallback))
              [(AstParam.Param _ index _)
                (and
                  (tc-str-ref-type? (tc-resolve-type ctx text))
                  (tc-type-eq (tc-resolve-type ctx index) (AstType.I64)))]
              [_ false])]
          [_ false]))]
    [_ false]))

(define (tc-stdlib-string-eq-wrapper-decl?
  [ctx : TcContext]
  [base : String]
  [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.DefFn name params ret _ _)
      (and
        (string.eq (intern-str name) base)
        (tc-type-eq (tc-resolve-type ctx ret) (AstType.Bool))
        (= (ast-param-list-len (& params)) 2)
        (match (ast-param-list-get (& params) 0 (ast-param-fallback))
          [(AstParam.Param _ left _)
            (match (ast-param-list-get (& params) 1 (ast-param-fallback))
              [(AstParam.Param _ right _)
                (and
                  (tc-str-ref-type? (tc-resolve-type ctx left))
                  (tc-str-ref-type? (tc-resolve-type ctx right)))]
              [_ false])]
          [_ false]))]
    [_ false]))

(define (tc-stdlib-string-copy-wrapper-decl?
  [ctx : TcContext]
  [base : String]
  [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.DefFn name params ret _ _)
      (and
        (string.eq (intern-str name) base)
        (tc-type-eq (tc-resolve-type ctx ret) (AstType.String))
        (= (ast-param-list-len (& params)) 2)
        (match (ast-param-list-get (& params) 0 (ast-param-fallback))
          [(AstParam.Param _ left _)
            (match (ast-param-list-get (& params) 1 (ast-param-fallback))
              [(AstParam.Param _ right _)
                (and
                  (tc-str-ref-type? (tc-resolve-type ctx left))
                  (tc-str-ref-type? (tc-resolve-type ctx right)))]
              [_ false])]
          [_ false]))]
    [_ false]))

(define (tc-stdlib-string-helper-symbol-wrapper?
  [ctx : TcContext]
  [base : String]) : bool
  (match ctx
    [(TcContext _ symbols _ _ _)
      (let
        [handle : i64
          (compiler-symbols-lookup-value-or
            symbols
            base
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? handle)
          (let
            [decls : (Array AstDecl) (compiler-symbols-decls symbols)]
            [index : i64 (compiler-symbol-handle-index handle)]
            (if (or (< index 0) (>= index (array.length decls)))
              false
              (let
                [decl : AstDecl (array-ref decls index)]
                (cond
                  [(string.eq base "string-length")
                    (tc-stdlib-string-length-wrapper-decl? ctx base decl)]
                  [(string.eq base "string-ref")
                    (tc-stdlib-string-ref-wrapper-decl? ctx base decl)]
                  [(string.eq base "char-at")
                    (tc-stdlib-string-ref-wrapper-decl? ctx base decl)]
                  [(string.eq base "eq")
                    (tc-stdlib-string-eq-wrapper-decl? ctx base decl)]
                  [(string.eq base "string-append")
                    (tc-stdlib-string-copy-wrapper-decl? ctx base decl)]
                  [(string.eq base "string-concat")
                    (tc-stdlib-string-copy-wrapper-decl? ctx base decl)]
                  [else false]))))
          false))]))

(define (tc-stdlib-string-qualified-helper-id?
  [lookup-id : i64]
  [base : String]) : bool
  (and
    (intern-qualified? lookup-id)
    (= (intern-qualified-base-id lookup-id) (tc-name-id base))
    (tc-stdlib-string-module-name? (intern-qualified-module lookup-id))))

(define (tc-decl-list-module-imports-stdlib-string?
  [decls : AstDeclList]
  [target-module-id : i64]
  [current-module-id : i64]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest-box)
      (let
        [rest : AstDeclList rest-box]
        (match decl
          [(AstDecl.Module next-module)
            (tc-decl-list-module-imports-stdlib-string?
              rest
              target-module-id
              next-module)]
          [(AstDecl.Import
              (AstImportSpec.Spec
                _
                _
                (AstMaybeModuleName.Some import-module)
                _
                _))
            (if (and
              (= current-module-id target-module-id)
              (tc-stdlib-string-module-name? import-module))
              true
              (tc-decl-list-module-imports-stdlib-string?
                rest
                target-module-id
                current-module-id))]
          [_
            (tc-decl-list-module-imports-stdlib-string?
              rest
              target-module-id
              current-module-id)]))]))

(define (tc-context-imports-stdlib-string? [ctx : TcContext]) : bool
  (match ctx
    [(TcContext program _ _ module _)
      (match program
        [(AstProgram.Program decls-box)
          (tc-decl-list-module-imports-stdlib-string?
            (box-get decls-box)
            (intern module)
            (intern ""))])]))

(define (tc-stdlib-string-helper-visible-or-wrapper-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-match : bool]
  [lookup-id : i64]
  [base : String]) : bool
  (if source-match
    (or
      (tc-context-is-stdlib-string? ctx)
      (tc-context-imports-stdlib-string? ctx)
      (tc-stdlib-string-helper-bound-wrapper? env base)
      (tc-stdlib-string-helper-symbol-wrapper? ctx base)
      (tc-stdlib-string-qualified-helper-id? lookup-id base))
    (tc-stdlib-string-qualified-helper-id? lookup-id base)))

(define tc-source-dotted-alias-key-cache-capacity : i64
  8192)
(define tc-source-dotted-alias-key-cache-module-keys : (Array i64)
  (array.make-array i64 8192))
(define tc-source-dotted-alias-key-cache-name-keys : (Array i64)
  (array.make-array i64 8192))
(define tc-source-dotted-alias-key-cache-values : (Array i64)
  (array.make-array i64 8192))
(define tc-source-dotted-alias-key-cache-generation : i64
  -1)
(define tc-source-dotted-alias-key-cache-ready : bool
  false)
(define tc-source-dotted-full-path-key-cache-capacity : i64
  8192)
(define tc-source-dotted-full-path-key-cache-module-keys : (Array i64)
  (array.make-array i64 8192))
(define tc-source-dotted-full-path-key-cache-name-keys : (Array i64)
  (array.make-array i64 8192))
(define tc-source-dotted-full-path-key-cache-values : (Array i64)
  (array.make-array i64 8192))
(define tc-source-dotted-full-path-key-cache-generation : i64
  -1)
(define tc-source-dotted-full-path-key-cache-ready : bool
  false)
(define tc-source-qualified-variant-key-cache-capacity : i64
  8192)
(define tc-source-qualified-variant-key-cache-module-keys : (Array i64)
  (array.make-array i64 8192))
(define tc-source-qualified-variant-key-cache-name-keys : (Array i64)
  (array.make-array i64 8192))
(define tc-source-qualified-variant-key-cache-values : (Array i64)
  (array.make-array i64 8192))
(define tc-source-qualified-variant-key-cache-generation : i64
  -1)
(define tc-source-qualified-variant-key-cache-ready : bool
  false)

(define (tc-source-dotted-alias-key-cache-reset!) : unit
  (set! tc-source-dotted-alias-key-cache-ready false))

(define (tc-source-dotted-full-path-key-cache-reset!) : unit
  (set! tc-source-dotted-full-path-key-cache-ready false))

(define (tc-source-qualified-variant-key-cache-reset!) : unit
  (set! tc-source-qualified-variant-key-cache-ready false))

(define (tc-source-dotted-alias-key-cache-ensure!) : unit
  (if tc-source-dotted-alias-key-cache-ready
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i tc-source-dotted-alias-key-cache-capacity)
          (begin
            (array-set! tc-source-dotted-alias-key-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set! tc-source-dotted-alias-key-cache-generation (intern-generation))
        (set! tc-source-dotted-alias-key-cache-ready true)))))

(define (tc-source-dotted-full-path-key-cache-ensure!) : unit
  (if tc-source-dotted-full-path-key-cache-ready
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i tc-source-dotted-full-path-key-cache-capacity)
          (begin
            (array-set! tc-source-dotted-full-path-key-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set!
          tc-source-dotted-full-path-key-cache-generation
          (intern-generation))
        (set! tc-source-dotted-full-path-key-cache-ready true)))))

(define (tc-source-qualified-variant-key-cache-ensure!) : unit
  (if tc-source-qualified-variant-key-cache-ready
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i tc-source-qualified-variant-key-cache-capacity)
          (begin
            (array-set! tc-source-qualified-variant-key-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set!
          tc-source-qualified-variant-key-cache-generation
          (intern-generation))
        (set! tc-source-qualified-variant-key-cache-ready true)))))

(define (tc-source-dotted-alias-key-cache-bucket
  [module-id : i64]
  [name-id : i64]) : i64
  (bit-and
    (+ (* module-id 2654435761) (* name-id 40503))
    (- tc-source-dotted-alias-key-cache-capacity 1)))

(define (tc-source-dotted-full-path-key-cache-bucket
  [module-id : i64]
  [name-id : i64]) : i64
  (bit-and
    (+ (* module-id 2246822519) (* name-id 3266489917))
    (- tc-source-dotted-full-path-key-cache-capacity 1)))

(define (tc-source-qualified-variant-key-cache-bucket
  [module-id : i64]
  [name-id : i64]) : i64
  (bit-and
    (+ (* module-id 668265263) (* name-id 374761393))
    (- tc-source-qualified-variant-key-cache-capacity 1)))

;; Returns the cached lookup-name id, -1 for no alias import, or -2 when absent.
(define (tc-source-dotted-alias-key-cache-get [module-id : i64] [name-id : i64]) : i64
  (begin
    (tc-source-dotted-alias-key-cache-ensure!)
    (let
      [cursor : i64 (tc-source-dotted-alias-key-cache-bucket module-id name-id)]
      [module-key : i64 (+ module-id 1)]
      [name-key : i64 (+ name-id 1)]
      (if (and
        (=
          (array-ref tc-source-dotted-alias-key-cache-module-keys cursor)
          module-key)
        (=
          (array-ref tc-source-dotted-alias-key-cache-name-keys cursor)
          name-key))
        (array-ref tc-source-dotted-alias-key-cache-values cursor)
        -2))))

;; Returns the cached lookup-name id, -1 for no full path, or -2 when absent.
(define (tc-source-dotted-full-path-key-cache-get
  [module-id : i64]
  [name-id : i64]) : i64
  (begin
    (tc-source-dotted-full-path-key-cache-ensure!)
    (let
      [cursor : i64
        (tc-source-dotted-full-path-key-cache-bucket module-id name-id)]
      [module-key : i64 (+ module-id 1)]
      [name-key : i64 (+ name-id 1)]
      (if (and
        (=
          (array-ref tc-source-dotted-full-path-key-cache-module-keys cursor)
          module-key)
        (=
          (array-ref tc-source-dotted-full-path-key-cache-name-keys cursor)
          name-key))
        (array-ref tc-source-dotted-full-path-key-cache-values cursor)
        -2))))

;; Returns the cached lookup-name id, -1 for no variant, or -2 when absent.
(define (tc-source-qualified-variant-key-cache-get
  [module-id : i64]
  [name-id : i64]) : i64
  (begin
    (tc-source-qualified-variant-key-cache-ensure!)
    (let
      [cursor : i64
        (tc-source-qualified-variant-key-cache-bucket module-id name-id)]
      [module-key : i64 (+ module-id 1)]
      [name-key : i64 (+ name-id 1)]
      (if (and
        (=
          (array-ref tc-source-qualified-variant-key-cache-module-keys cursor)
          module-key)
        (=
          (array-ref tc-source-qualified-variant-key-cache-name-keys cursor)
          name-key))
        (array-ref tc-source-qualified-variant-key-cache-values cursor)
        -2))))

(define (tc-source-dotted-alias-key-cache-put!
  [module-id : i64]
  [name-id : i64]
  [value : i64]) : unit
  (begin
    (tc-source-dotted-alias-key-cache-ensure!)
    (let
      [cursor : i64 (tc-source-dotted-alias-key-cache-bucket module-id name-id)]
      (begin
        (array-set!
          tc-source-dotted-alias-key-cache-module-keys
          cursor
          (+ module-id 1))
        (array-set!
          tc-source-dotted-alias-key-cache-name-keys
          cursor
          (+ name-id 1))
        (array-set! tc-source-dotted-alias-key-cache-values cursor value)))))

(define (tc-source-dotted-full-path-key-cache-put!
  [module-id : i64]
  [name-id : i64]
  [value : i64]) : unit
  (begin
    (tc-source-dotted-full-path-key-cache-ensure!)
    (let
      [cursor : i64
        (tc-source-dotted-full-path-key-cache-bucket module-id name-id)]
      (begin
        (array-set!
          tc-source-dotted-full-path-key-cache-module-keys
          cursor
          (+ module-id 1))
        (array-set!
          tc-source-dotted-full-path-key-cache-name-keys
          cursor
          (+ name-id 1))
        (array-set! tc-source-dotted-full-path-key-cache-values cursor value)))))

(define (tc-source-qualified-variant-key-cache-put!
  [module-id : i64]
  [name-id : i64]
  [value : i64]) : unit
  (begin
    (tc-source-qualified-variant-key-cache-ensure!)
    (let
      [cursor : i64
        (tc-source-qualified-variant-key-cache-bucket module-id name-id)]
      (begin
        (array-set!
          tc-source-qualified-variant-key-cache-module-keys
          cursor
          (+ module-id 1))
        (array-set!
          tc-source-qualified-variant-key-cache-name-keys
          cursor
          (+ name-id 1))
        (array-set! tc-source-qualified-variant-key-cache-values cursor value)))))

(define tc-lazy-import-stubs : TcLazyImportStubList
  (TcLazyImportStubList.Nil))
(define tc-lazy-import-stub-record-count : i64
  0)
(define tc-lazy-import-summary-backed-count : i64
  0)
(define tc-lazy-import-summary-macro-force-record-count : i64
  0)

(define (tc-lazy-import-stubs-reset!) : unit
  (begin
    (set! tc-lazy-import-stubs (TcLazyImportStubList.Nil))
    (set! tc-lazy-import-stub-record-count 0)
    (set! tc-lazy-import-summary-backed-count 0)
    (tc-source-dotted-alias-key-cache-reset!)
    (tc-source-dotted-full-path-key-cache-reset!)
    (tc-source-qualified-variant-key-cache-reset!)))

(define (tc-lazy-import-stub-count) : i64
  tc-lazy-import-stub-record-count)

(define (tc-lazy-import-summary-backed-stub-count) : i64
  tc-lazy-import-summary-backed-count)

(define (tc-lazy-import-summary-macro-force-count) : i64
  tc-lazy-import-summary-macro-force-record-count)

(define (tc-lazy-import-summary-macro-force-record!) : unit
  (set!
    tc-lazy-import-summary-macro-force-record-count
    (+ tc-lazy-import-summary-macro-force-record-count 1)))

(define (tc-lazy-import-stub-record!
  [importer-module-id : i64]
  [alias : String]
  [target-module : String]
  [summary-backed : bool]) : unit
  (begin
    (set!
      tc-lazy-import-stubs
      (TcLazyImportStubList.Cons
        importer-module-id
        (intern alias)
        target-module
        summary-backed
        (box tc-lazy-import-stubs)))
    (set!
      tc-lazy-import-stub-record-count
      (+ tc-lazy-import-stub-record-count 1))
    (if summary-backed
      (set!
        tc-lazy-import-summary-backed-count
        (+ tc-lazy-import-summary-backed-count 1))
      unit)
    (tc-source-dotted-alias-key-cache-reset!)
    (tc-source-dotted-full-path-key-cache-reset!)
    (tc-source-qualified-variant-key-cache-reset!)))

(define (tc-lazy-import-stub-target-in
  [stubs : TcLazyImportStubList]
  [importer-module-id : i64]
  [alias-id : i64]) : TcMaybeString
  (match stubs
    [(TcLazyImportStubList.Nil) (TcMaybeString.No)]
    [(TcLazyImportStubList.Cons
        stub-module-id
        stub-alias-id
        target-module
        _
        rest-box)
      (if (and (= stub-module-id importer-module-id) (= stub-alias-id alias-id))
        (TcMaybeString.Some target-module)
        (tc-lazy-import-stub-target-in
          (box-get rest-box)
          importer-module-id
          alias-id))]))

(define (tc-lazy-import-stub-target [importer-module-id : i64] [alias : String]) : TcMaybeString
  (tc-lazy-import-stub-target-in
    tc-lazy-import-stubs
    importer-module-id
    (intern alias)))

(define (tc-lazy-import-stub-target-id
  [importer-module-id : i64]
  [alias-id : i64]) : TcMaybeString
  (tc-lazy-import-stub-target-in
    tc-lazy-import-stubs
    importer-module-id
    alias-id))

(define (tc-source-dotted-alias-target
  [decls : AstDeclList]
  [current-module-id : i64]
  [alias : String]) : TcMaybeString
  (match (tc-lazy-import-stub-target current-module-id alias)
    [(TcMaybeString.Some target-module) (TcMaybeString.Some target-module)]
    [(TcMaybeString.No)
      (macro-import-alias-target-cached decls current-module-id alias)]))

(define (tc-source-dotted-alias-target-id
  [decls : AstDeclList]
  [current-module-id : i64]
  [alias-id : i64]) : TcMaybeString
  (match (tc-lazy-import-stub-target-id current-module-id alias-id)
    [(TcMaybeString.Some target-module) (TcMaybeString.Some target-module)]
    [(TcMaybeString.No)
      (macro-import-alias-target-cached-id decls current-module-id alias-id)]))

(define (tc-call-builtin-lookup-name
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-name : String]) : String
  (if (tc-name-qualified? source-name)
    source-name
    (if (>= (tc-name-first-dot source-name) 0)
      (match (tc-source-name-lookup-key ctx env source-name)
        [(ResultTcString.Ok lookup-name) lookup-name]
        [(ResultTcString.Err _) source-name])
      source-name)))

(define (tc-call-builtin-lookup-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-name : String]
  [source-id : i64]) : i64
  (if (and
    (not (tc-hygiene-local-name? source-name))
    (intern-qualified? source-id))
    source-id
    (if (>= (intern-first-dot source-id) 0)
      (match (tc-source-name-lookup-key ctx env source-name)
        [(ResultTcString.Ok lookup-name) (tc-builtin-name-id lookup-name)]
        [(ResultTcString.Err _) source-id])
      source-id)))

(define (tc-source-dotted-alias-key
  [ctx : TcContext]
  [name : String]
  [name-id : i64]
  [first-dot : i64]
  [current-module-id : i64]) : TcMaybeString
  (let
    [n : i64 (string.string-length name)]
    (if (or (<= first-dot 0) (>= first-dot (- n 1)))
      (TcMaybeString.No)
      (let
        [alias-id : i64 (intern-leading-dot-id name-id)]
        [cached : i64
          (tc-source-dotted-alias-key-cache-get current-module-id name-id)]
        (if (= cached -2)
          (let
            [base-start : i64 (+ first-dot 1)]
            [base-id : i64 (intern-slice name base-start (- n base-start))]
            (match (tc-context-program ctx)
              [(AstProgram.Program decls-box)
                (match (tc-source-dotted-alias-target-id
                  (box-get decls-box)
                  current-module-id
                  alias-id)
                  [(TcMaybeString.Some target-module)
                    (let
                      [lookup-name : String
                        (compiler-symbol-module-key
                          target-module
                          (intern-str base-id))]
                      (begin
                        (tc-source-dotted-alias-key-cache-put!
                          current-module-id
                          name-id
                          (intern lookup-name))
                        (TcMaybeString.Some lookup-name)))]
                  [(TcMaybeString.No)
                    (begin
                      (tc-source-dotted-alias-key-cache-put!
                        current-module-id
                        name-id
                        -1)
                      (TcMaybeString.No))])]))
          (if (< cached 0)
            (TcMaybeString.No)
            (TcMaybeString.Some (intern-str cached))))))))

(define (tc-source-alias-display-key [ctx : TcContext] [name : String]) : TcMaybeString
  (let
    [n : i64 (string.string-length name)]
    [first-dot : i64 (tc-name-first-dot name)]
    (if (or (<= first-dot 0) (>= first-dot (- n 1)))
      (TcMaybeString.No)
      (let
        [alias : String (string.substring name 0 first-dot)]
        [base-start : i64 (+ first-dot 1)]
        [base : String (string.substring name base-start (- n base-start))]
        (match ctx
          [(TcContext program _ _ current-module _)
            (match program
              [(AstProgram.Program decls-box)
                (let
                  [target : String
                    (macro-resolve-qualified-module
                      (box-get decls-box)
                      current-module
                      alias)]
                  (if (string.eq target alias)
                    (TcMaybeString.No)
                    (TcMaybeString.Some (compiler-symbol-module-key alias base))))])])))))

(define (tc-source-lookup-display-name
  [ctx : TcContext]
  [source-name : String]
  [lookup-name : String]) : String
  (match (tc-source-alias-display-key ctx source-name)
    [(TcMaybeString.Some display-name) display-name]
    [(TcMaybeString.No) lookup-name]))

(define (tc-source-unbound-display-message
  [ctx : TcContext]
  [source-name : String]
  [lookup-name : String]
  [message : String]) : String
  (let
    [lookup-unbound : String
      (string.append "typecheck: unbound name " lookup-name)]
    (match (tc-source-alias-display-key ctx source-name)
      [(TcMaybeString.Some display-name)
        (if (string.eq message lookup-unbound)
          (string.append "typecheck: unbound name " display-name)
          message)]
      [(TcMaybeString.No) message])))

(define (tc-source-dotted-full-path-key-from-id
  [ctx : TcContext]
  [name : String]
  [name-id : i64]
  [current-module-id : i64]) : TcMaybeString
  (let
    [cached : i64
      (tc-source-dotted-full-path-key-cache-get current-module-id name-id)]
    (if (= cached -2)
      (let
        [n : i64 (string.string-length name)]
        [i : i64 0]
        [best-dot : i64 -1]
        (begin
          (while (< i n)
            (begin
              (if (string.char-eq (string.string-ref name i) '.')
                (let
                  [candidate-id : i64 (intern-slice name 0 i)]
                  (if (or
                    (= candidate-id current-module-id)
                    (tc-imported-module-identity-id? ctx candidate-id))
                    (set! best-dot i)
                    unit))
                unit)
              (set! i (+ i 1))))
          (if (and (> best-dot 0) (< best-dot (- n 1)))
            (let
              [base-start : i64 (+ best-dot 1)]
              [module-id : i64 (intern-slice name 0 best-dot)]
              [base-id : i64 (intern-slice name base-start (- n base-start))]
              [lookup-name : String
                (compiler-symbol-module-key
                  (intern-str module-id)
                  (intern-str base-id))]
              (begin
                (tc-source-dotted-full-path-key-cache-put!
                  current-module-id
                  name-id
                  (intern lookup-name))
                (TcMaybeString.Some lookup-name)))
            (begin
              (tc-source-dotted-full-path-key-cache-put!
                current-module-id
                name-id
                -1)
              (TcMaybeString.No)))))
      (if (< cached 0)
        (TcMaybeString.No)
        (TcMaybeString.Some (intern-str cached))))))

(define (tc-source-dotted-full-path-key [ctx : TcContext] [name : String]) : TcMaybeString
  (tc-source-dotted-full-path-key-from-id
    ctx
    name
    (tc-name-id name)
    (intern (tc-context-module ctx))))

(define (tc-unresolved-dotted-name-message [name : String]) : String
  (str_cat.str-cat
    "typecheck: unknown qualified name "
    name
    "; import the module or use a visible dotted module alias"))

(define (tc-comptime-syntax-helper-name? [name : String]) : bool
  (or
    (string.eq name "expr-bool")
    (string.eq name "expr-int")
    (string.eq name "expr-string")
    (string.eq name "expr-var")
    (string.eq name "expr-struct-get")
    (string.eq name "expr-tuple-ref")
    (string.eq name "expr-struct-set")
    (string.eq name "expr-splice")
    (string.eq name "expr-if")
    (string.eq name "pattern-wildcard")
    (string.eq name "pattern-binding")
    (string.eq name "pattern-variant")
    (string.eq name "pattern-list-empty")
    (string.eq name "pattern-list-cons")
    (string.eq name "match-arm")
    (string.eq name "match-arm-list-empty")
    (string.eq name "match-arm-list-cons")
    (string.eq name "expr-match")
    (string.eq name "expr-type")
    (string.eq name "type-info")
    (string.eq name "module-name")
    (string.eq name "module-export-macro?")
    (string.eq name "module-hook")
    (string.eq name "string-append")
    (string.eq name "string-concat")
    (string.eq name "string->int")
    (string.eq name "int->string")
    (ctfe-comptime-source-helper-name? name)
    (ctfe-expr-list-inspector-name? name)
    (ctfe-expr-clause-list-inspector-name? name)
    (ctfe-expr-binding-clause-list-inspector-name? name)
    (string.eq name "comptime-error")))

(define (tc-string-prefix-at? [text : String] [prefix : String] [start : i64]) : bool
  (string.is-string-prefix-at (& text) (& prefix) start))

(define tc-comptime-helper-prefix-cache-generation : i64
  -1)
(define tc-comptime-helper-prefix-comptime-id : i64
  -1)
(define tc-comptime-helper-prefix-stdlib-comptime-id : i64
  -1)
(define tc-comptime-helper-prefix-string-id : i64
  -1)
(define tc-comptime-helper-prefix-stdlib-string-id : i64
  -1)
(define tc-comptime-helper-prefix-stdlib-id : i64
  -1)

(define (tc-comptime-helper-prefix-cache-ensure!) : unit
  (if (= tc-comptime-helper-prefix-cache-generation (intern-generation))
    unit
    (begin
      (set! tc-comptime-helper-prefix-comptime-id (intern "comptime"))
      (set!
        tc-comptime-helper-prefix-stdlib-comptime-id
        (intern "stdlib/comptime"))
      (set! tc-comptime-helper-prefix-string-id (intern "string"))
      (set! tc-comptime-helper-prefix-stdlib-string-id (intern "stdlib/string"))
      (set! tc-comptime-helper-prefix-stdlib-id (intern "stdlib"))
      (set! tc-comptime-helper-prefix-cache-generation (intern-generation)))))

(define (tc-comptime-helper-qualified-candidate-from-id?
  [name : String]
  [name-id : i64]
  [first-dot : i64]) : bool
  (if (<= first-dot 0)
    false
    (begin
      (tc-comptime-helper-prefix-cache-ensure!)
      (let
        [prefix-id : i64 (intern-leading-dot-id name-id)]
        (cond
          [(or
              (= prefix-id tc-comptime-helper-prefix-comptime-id)
              (= prefix-id tc-comptime-helper-prefix-stdlib-comptime-id)
              (= prefix-id tc-comptime-helper-prefix-string-id)
              (= prefix-id tc-comptime-helper-prefix-stdlib-string-id))
            true]
          [(= prefix-id tc-comptime-helper-prefix-stdlib-id)
            (or
              (tc-string-prefix-at? name "comptime." (+ first-dot 1))
              (tc-string-prefix-at? name "comptime/" (+ first-dot 1))
              (tc-string-prefix-at? name "string." (+ first-dot 1))
              (tc-string-prefix-at? name "string/" (+ first-dot 1)))]
          [else false])))))

(define (tc-comptime-helper-qualified-lookup-key
  [env : TcTypeEnv]
  [name : String]
  [name-id : i64]
  [first-dot : i64]) : TcMaybeString
  (if (tc-comptime-helper-qualified-candidate-from-id? name name-id first-dot)
    (let
      [call-name : String (ctfe-comptime-helper-call-name name)]
      (if (and
        (not (string.eq call-name name))
        (tc-comptime-syntax-helper-name? call-name)
        (tc-source-name-bound-exact? env call-name))
        (TcMaybeString.Some call-name)
        (TcMaybeString.No)))
    (TcMaybeString.No)))

(define (tc-dotted-type-name-lookup-key [ctx : TcContext] [name : String]) : ResultTcString
  (tc-dotted-type-name-lookup-key-from-id ctx name (tc-name-id name)))

;; Variant taking the already-interned `name-id`; reads the first-dot position
;; from id-keyed metadata instead of re-hashing `name`.
(define (tc-dotted-type-name-lookup-key-from-id
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : ResultTcString
  (let
    [first-dot : i64 (intern-first-dot name-id)]
    (if (< first-dot 0)
      (ResultTcString.Ok name)
      (let
        [current-module-id : i64 (intern (tc-context-module ctx))]
        (match (tc-source-dotted-alias-key
          ctx
          name
          name-id
          first-dot
          current-module-id)
          [(TcMaybeString.Some key) (ResultTcString.Ok key)]
          [(TcMaybeString.No)
            (match (tc-source-dotted-full-path-key-from-id
              ctx
              name
              name-id
              current-module-id)
              [(TcMaybeString.Some key) (ResultTcString.Ok key)]
              [(TcMaybeString.No)
                (ResultTcString.Err (tc-unresolved-dotted-name-message name))])])))))

(define (tc-source-type-name-lookup-key [ctx : TcContext] [name : String]) : ResultTcString
  (let
    [name-id : i64 (tc-name-id name)]
    (if (tc-source-slash-qualified-id? name name-id)
      (ResultTcString.Err (tc-source-slash-qualified-message name))
      (tc-dotted-type-name-lookup-key-from-id ctx name name-id))))

(define (tc-enum-qualified-variant-lookup-name? [name : String]) : bool
  (>= (tc-name-first-dot (tc-qualified-name-base name)) 0))

(define (tc-enum-qualified-variant-lookup-name-id? [name-id : i64]) : bool
  (let
    [base-id : i64
      (if (intern-qualified? name-id)
        (intern-qualified-base-id name-id)
        name-id)]
    (>= (intern-first-dot base-id) 0)))

(define (tc-enum-qualified-variant-lookup-handle
  [ctx : TcContext]
  [name : String]
  [name-id : i64]) : option_i64.Option
  (if (tc-enum-qualified-variant-lookup-name-id? name-id)
    (match ctx
      [(TcContext _ _ registries module _)
        (if (and
          (> (string.string-length module) 0)
          (not (tc-name-qualified? name)))
          (let
            [module-key-id : i64
              (compiler-symbol-module-key-id-by-name-id module name-id)]
            (match (compiler-registries-lookup-variant-key-id
              registries
              module-key-id)
              [(option_i64.Some handle) (option_i64.Some handle)]
              [(option_i64.None)
                (compiler-registries-lookup-variant-id registries name-id)]))
          (compiler-registries-lookup-variant-id registries name-id))])
    option_i64.None))

(define (tc-enum-qualified-variant-lookup-key-from-id
  [ctx : TcContext]
  [name : String]
  [name-id : i64]
  [module-id : i64]) : ResultTcString
  (if (tc-enum-qualified-variant-lookup-name-id? name-id)
    (match ctx
      [(TcContext _ _ registries module _)
        (let
          [cached : i64
            (tc-source-qualified-variant-key-cache-get module-id name-id)]
          (if (= cached -2)
            (if (and
              (> (string.string-length module) 0)
              (not (tc-name-qualified? name)))
              (let
                [module-key-id : i64
                  (compiler-symbol-module-key-id-by-name-id module name-id)]
                (match (compiler-registries-lookup-variant-key-id
                  registries
                  module-key-id)
                  [(option_i64.Some _)
                    (let
                      [lookup-name : String
                        (compiler-symbol-module-key module name)]
                      (begin
                        (tc-source-qualified-variant-key-cache-put!
                          module-id
                          name-id
                          (intern lookup-name))
                        (ResultTcString.Ok lookup-name)))]
                  [(option_i64.None)
                    (match (compiler-registries-lookup-variant-id
                      registries
                      name-id)
                      [(option_i64.Some _)
                        (begin
                          (tc-source-qualified-variant-key-cache-put!
                            module-id
                            name-id
                            name-id)
                          (ResultTcString.Ok name))]
                      [(option_i64.None)
                        (begin
                          (tc-source-qualified-variant-key-cache-put!
                            module-id
                            name-id
                            -1)
                          (ResultTcString.Err ""))])]))
              (match (compiler-registries-lookup-variant-id registries name-id)
                [(option_i64.Some _)
                  (begin
                    (tc-source-qualified-variant-key-cache-put!
                      module-id
                      name-id
                      name-id)
                    (ResultTcString.Ok name))]
                [(option_i64.None)
                  (begin
                    (tc-source-qualified-variant-key-cache-put!
                      module-id
                      name-id
                      -1)
                    (ResultTcString.Err ""))]))
            (if (< cached 0)
              (ResultTcString.Err "")
              (ResultTcString.Ok (intern-str cached)))))])
    (ResultTcString.Err "")))

(define (tc-enum-qualified-variant-lookup-key [ctx : TcContext] [name : String]) : ResultTcString
  (tc-enum-qualified-variant-lookup-key-from-id
    ctx
    name
    (tc-name-id name)
    (intern (tc-context-module ctx))))

(define (tc-source-name-lookup-key-with-field-check
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [check-local-field : bool]) : ResultTcString
  ;; Intern `name` once; every metadata query below reads the id-keyed slots
  ;; instead of re-hashing the string. This is the hottest name-resolution
  ;; function, previously hashing each name 3-4x (slash-qualified?, first-dot,
  ;; leading-segment, bound-exact?).
  (let
    [name-id : i64 (tc-name-id name)]
    (if (tc-source-slash-qualified-id? name name-id)
      (ResultTcString.Err (tc-source-slash-qualified-message name))
      (let
        [first-dot : i64 (intern-first-dot name-id)]
        (if (< first-dot 0)
          (if (tc-source-name-bound-exact-id? env name-id)
            (ResultTcString.Ok name)
            (match (tc-current-module-source-lookup-key ctx env name)
              [(TcMaybeString.Some key) (ResultTcString.Ok key)]
              [(TcMaybeString.No) (ResultTcString.Ok name)]))
          (if (and
            check-local-field
            (tc-source-leading-segment-wins-over-exact-from-id?
              env
              name
              name-id
              first-dot))
            (ResultTcString.Ok name)
            (match (tc-comptime-helper-qualified-lookup-key
              env
              name
              name-id
              first-dot)
              [(TcMaybeString.Some key) (ResultTcString.Ok key)]
              [(TcMaybeString.No)
                (let
                  [current-module-id : i64 (intern (tc-context-module ctx))]
                  (match (tc-source-dotted-alias-key
                    ctx
                    name
                    name-id
                    first-dot
                    current-module-id)
                    [(TcMaybeString.Some key) (ResultTcString.Ok key)]
                    [(TcMaybeString.No)
                      (match (tc-enum-qualified-variant-lookup-key-from-id
                        ctx
                        name
                        name-id
                        current-module-id)
                        [(ResultTcString.Ok key) (ResultTcString.Ok key)]
                        [(ResultTcString.Err _)
                          (match (tc-source-dotted-full-path-key-from-id
                            ctx
                            name
                            name-id
                            current-module-id)
                            [(TcMaybeString.Some key) (ResultTcString.Ok key)]
                            [(TcMaybeString.No)
                              (if (tc-source-name-bound-exact-id? env name-id)
                                (ResultTcString.Ok name)
                                (ResultTcString.Err
                                  (tc-unresolved-dotted-name-message name)))])])]))])))))))

(define (tc-source-name-lookup-key
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]) : ResultTcString
  (tc-source-name-lookup-key-with-field-check ctx env name true))

(define (tc-source-name-lookup-key-after-local-field-check
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]) : ResultTcString
  (tc-source-name-lookup-key-with-field-check ctx env name false))

(define (tc-qualified-access-target-module
  [ctx : TcContext]
  [qualifier : String]) : String
  (match ctx
    [(TcContext program _ _ current-module _)
      (match program
        [(AstProgram.Program decls-box)
          (let
            [decls : AstDeclList (box-get decls-box)]
            (macro-resolve-qualified-module decls current-module qualifier))])]))

(define (tc-resolved-nominal-type [name : String] [handle : i64]) : AstType
  (if (= (compiler-symbol-handle-kind handle) (compiler-symbol-kind-defenum))
    (AstType.Enum (intern name))
    (if (=
      (compiler-symbol-handle-kind handle)
      (compiler-symbol-kind-defstruct))
      (AstType.Struct (intern name))
      (AstType.Var (intern name)))))

(define (tc-resolved-nominal-type-with-args
  [name : String]
  [handle : i64]
  [lifetimes : AstLifetimeList]) : AstType
  (if (= (compiler-symbol-handle-kind handle) (compiler-symbol-kind-defenum))
    (ast-ty-enum-args (intern name) lifetimes)
    (if (=
      (compiler-symbol-handle-kind handle)
      (compiler-symbol-kind-defstruct))
      (ast-ty-struct-args (intern name) lifetimes)
      (ast-ty-var-args (intern name) lifetimes))))

(define (tc-current-module-owner-name-matches?
  [lookup-name : String]
  [owner-name : String]) : bool
  (or
    (string.eq owner-name lookup-name)
    (and
      (tc-name-qualified? lookup-name)
      (not (tc-name-qualified? owner-name))
      (string.eq owner-name (tc-qualified-name-base lookup-name)))))

(define (tc-current-module-enum? [ctx : TcContext] [name : String]) : bool
  (match (tc-program-enum-variants (tc-context-program ctx) name)
    [(ResultAstVariantDefList.Ok _) true]
    [(ResultAstVariantDefList.Err _) false]))

(define (tc-resolved-current-module-nominal-type
  [ctx : TcContext]
  [name : String]
  [handle : i64]) : AstType
  (match (tc-nominal-owner-name ctx handle)
    [(ResultTcString.Ok owner-name)
      (if (tc-current-module-owner-name-matches? name owner-name)
        (tc-resolved-nominal-type name handle)
        (if (tc-current-module-enum? ctx name)
          (AstType.Enum (intern name))
          (tc-resolved-nominal-type owner-name handle)))]
    [(ResultTcString.Err _)
      (if (tc-current-module-enum? ctx name)
        (AstType.Enum (intern name))
        (tc-resolved-nominal-type name handle))]))

(define (tc-resolved-current-module-nominal-type-with-args
  [ctx : TcContext]
  [name : String]
  [handle : i64]
  [lifetimes : AstLifetimeList]) : AstType
  (match (tc-nominal-owner-name ctx handle)
    [(ResultTcString.Ok owner-name)
      (if (tc-current-module-owner-name-matches? name owner-name)
        (tc-resolved-nominal-type-with-args name handle lifetimes)
        (if (tc-current-module-enum? ctx name)
          (ast-ty-enum-args (intern name) lifetimes)
          (tc-resolved-nominal-type-with-args owner-name handle lifetimes)))]
    [(ResultTcString.Err _)
      (if (tc-current-module-enum? ctx name)
        (ast-ty-enum-args (intern name) lifetimes)
        (tc-resolved-nominal-type-with-args name handle lifetimes))]))

(define (tc-qualified-lookup-owner-name
  [lookup-name : String]
  [owner-name : String]) : String
  (if (and
    (or (tc-name-qualified? lookup-name) (>= (tc-name-first-dot lookup-name) 0))
    (not (tc-name-qualified? owner-name)))
    lookup-name
    owner-name))

(define tc-nominal-owner-cache-handle : i64
  0)
(define tc-nominal-owner-cache-name : String
  "")
(define tc-nominal-owner-cache-handle1 : i64
  0)
(define tc-nominal-owner-cache-name1 : String
  "")
(define tc-nominal-owner-cache-handle2 : i64
  0)
(define tc-nominal-owner-cache-name2 : String
  "")
(define tc-nominal-owner-cache-handle3 : i64
  0)
(define tc-nominal-owner-cache-name3 : String
  "")
(define tc-nominal-owner-cache-handle4 : i64
  0)
(define tc-nominal-owner-cache-name4 : String
  "")
(define tc-nominal-owner-cache-handle5 : i64
  0)
(define tc-nominal-owner-cache-name5 : String
  "")
(define tc-nominal-owner-cache-handle6 : i64
  0)
(define tc-nominal-owner-cache-name6 : String
  "")
(define tc-nominal-owner-cache-handle7 : i64
  0)
(define tc-nominal-owner-cache-name7 : String
  "")
(define tc-resolve-type-name-cache-valid : bool
  false)
(define tc-resolve-type-name-cache-found : bool
  false)
(define tc-resolve-type-name-cache-key : String
  "")
(define tc-resolve-type-name-cache-handle : i64
  0)

;; The cached name strings are caller-provided and may live in a transient
;; scratch arena (per-function typecheck arenas; #2596): clear them to the
;; static empty string as well, so no slot can compare against freed memory
;; after the owning arena is destroyed.
(define (tc-nominal-owner-cache-reset!) : unit
  (begin
    (set! tc-nominal-owner-cache-handle 0)
    (set! tc-nominal-owner-cache-name "")
    (set! tc-nominal-owner-cache-handle1 0)
    (set! tc-nominal-owner-cache-name1 "")
    (set! tc-nominal-owner-cache-handle2 0)
    (set! tc-nominal-owner-cache-name2 "")
    (set! tc-nominal-owner-cache-handle3 0)
    (set! tc-nominal-owner-cache-name3 "")
    (set! tc-nominal-owner-cache-handle4 0)
    (set! tc-nominal-owner-cache-name4 "")
    (set! tc-nominal-owner-cache-handle5 0)
    (set! tc-nominal-owner-cache-name5 "")
    (set! tc-nominal-owner-cache-handle6 0)
    (set! tc-nominal-owner-cache-name6 "")
    (set! tc-nominal-owner-cache-handle7 0)
    (set! tc-nominal-owner-cache-name7 "")
    (set! tc-resolve-type-name-cache-valid false)
    (set! tc-resolve-type-name-cache-key "")))

(define (tc-resolve-type-name-cache-lookup [lookup-name : String]) : TcTypeNameLookupCache
  (if (and
    tc-resolve-type-name-cache-valid
    (string.eq tc-resolve-type-name-cache-key lookup-name))
    (if tc-resolve-type-name-cache-found
      (TcTypeNameLookupCache.Found tc-resolve-type-name-cache-handle)
      (TcTypeNameLookupCache.Missing))
    (TcTypeNameLookupCache.Miss)))

(define (tc-resolve-type-name-cache-store!
  [lookup-name : String]
  [found : bool]
  [handle : i64]) : unit
  (begin
    (set! tc-resolve-type-name-cache-key (intern-persistent-copy lookup-name))
    (set! tc-resolve-type-name-cache-found found)
    (set! tc-resolve-type-name-cache-handle handle)
    (set! tc-resolve-type-name-cache-valid true)))

(define (tc-resolve-type-name-symbol-lookup
  [symbols : CompilerSymbols]
  [lookup-name : String]) : i64
  (match (tc-resolve-type-name-cache-lookup lookup-name)
    [(TcTypeNameLookupCache.Found handle) handle]
    [(TcTypeNameLookupCache.Missing) (compiler-symbols-missing-handle)]
    [(TcTypeNameLookupCache.Miss)
      (let
        [handle : i64
          (compiler-symbols-lookup-type-or
            symbols
            lookup-name
            (compiler-symbols-missing-handle))]
        (begin
          (tc-resolve-type-name-cache-store!
            lookup-name
            (compiler-symbols-handle-found? handle)
            (if (compiler-symbols-handle-found? handle)
              handle
              0))
          handle))]))

(define (tc-nominal-owner-cache-slot [handle : i64]) : i64
  (% (compiler-symbol-handle-index handle) 8))

(define (tc-nominal-owner-cache-entry-lookup
  [ctx : TcContext]
  [handle : i64]
  [cached-handle : i64]
  [cached-name : String]) : ResultTcString
  (if (= cached-handle handle)
    (let
      [found-handle : i64
        (tc-resolve-type-name-symbol-lookup
          (tc-context-symbols ctx)
          cached-name)]
      (if (compiler-symbols-handle-found? found-handle)
        (if (= found-handle handle)
          (ResultTcString.Ok cached-name)
          (ResultTcString.Err ""))
        (ResultTcString.Err "")))
    (ResultTcString.Err "")))

(define (tc-nominal-owner-cache-lookup [ctx : TcContext] [handle : i64]) : ResultTcString
  (let
    [slot : i64 (tc-nominal-owner-cache-slot handle)]
    (cond
      [(= slot 0)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle
          tc-nominal-owner-cache-name)]
      [(= slot 1)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle1
          tc-nominal-owner-cache-name1)]
      [(= slot 2)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle2
          tc-nominal-owner-cache-name2)]
      [(= slot 3)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle3
          tc-nominal-owner-cache-name3)]
      [(= slot 4)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle4
          tc-nominal-owner-cache-name4)]
      [(= slot 5)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle5
          tc-nominal-owner-cache-name5)]
      [(= slot 6)
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle6
          tc-nominal-owner-cache-name6)]
      [else
        (tc-nominal-owner-cache-entry-lookup
          ctx
          handle
          tc-nominal-owner-cache-handle7
          tc-nominal-owner-cache-name7)])))

(define (tc-nominal-owner-cache-store-if-safe! [handle : i64] [name : String]) : unit
  (if (tc-name-qualified? name)
    unit
    (let
      [slot : i64 (tc-nominal-owner-cache-slot handle)]
      (cond
        [(= slot 0)
          (begin
            (set! tc-nominal-owner-cache-handle handle)
            (set! tc-nominal-owner-cache-name name))]
        [(= slot 1)
          (begin
            (set! tc-nominal-owner-cache-handle1 handle)
            (set! tc-nominal-owner-cache-name1 name))]
        [(= slot 2)
          (begin
            (set! tc-nominal-owner-cache-handle2 handle)
            (set! tc-nominal-owner-cache-name2 name))]
        [(= slot 3)
          (begin
            (set! tc-nominal-owner-cache-handle3 handle)
            (set! tc-nominal-owner-cache-name3 name))]
        [(= slot 4)
          (begin
            (set! tc-nominal-owner-cache-handle4 handle)
            (set! tc-nominal-owner-cache-name4 name))]
        [(= slot 5)
          (begin
            (set! tc-nominal-owner-cache-handle5 handle)
            (set! tc-nominal-owner-cache-name5 name))]
        [(= slot 6)
          (begin
            (set! tc-nominal-owner-cache-handle6 handle)
            (set! tc-nominal-owner-cache-name6 name))]
        [else
          (begin
            (set! tc-nominal-owner-cache-handle7 handle)
            (set! tc-nominal-owner-cache-name7 name))]))))

(define (tc-nominal-owner-name-list
  [decls : AstDeclList]
  [target : i64]
  [index : i64]
  [module : String]) : ResultTcString
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil)
      (ResultTcString.Err "typecheck: nominal owner not found")]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        (match decl
          [(AstDecl.Import _)
            (tc-nominal-owner-name-list rest target index module)]
          [(AstDecl.IncludeStr _ _)
            (tc-nominal-owner-name-list rest target index module)]
          [(AstDecl.IncludeBin _ _)
            (tc-nominal-owner-name-list rest target index module)]
          [(AstDecl.Module next-module)
            (tc-nominal-owner-name-list
              rest
              target
              index
              (intern-str next-module))]
          [(AstDecl.ModuleBody name body-box)
            (let
              [body : AstDeclList (box-get body-box)]
              [body-count : i64 (compiler-decl-list-index-count body)]
              (if (< target (+ index body-count))
                (tc-nominal-owner-name-list body target index (intern-str name))
                (tc-nominal-owner-name-list
                  rest
                  target
                  (+ index body-count)
                  module)))]
          [(AstDecl.Test _ _ _)
            (tc-nominal-owner-name-list rest target index module)]
          [(AstDecl.DefEnum name _ _)
            (if (= target index)
              (ResultTcString.Ok
                (compiler-symbol-module-key module (intern-str name)))
              (tc-nominal-owner-name-list rest target (+ index 1) module))]
          [(AstDecl.DefEnumLifetimes name _ _ _)
            (if (= target index)
              (ResultTcString.Ok
                (compiler-symbol-module-key module (intern-str name)))
              (tc-nominal-owner-name-list rest target (+ index 1) module))]
          [(AstDecl.DefStruct name _ _ _)
            (if (= target index)
              (ResultTcString.Ok
                (compiler-symbol-module-key module (intern-str name)))
              (tc-nominal-owner-name-list rest target (+ index 1) module))]
          [(AstDecl.DefStructLifetimes name _ _ _ _)
            (if (= target index)
              (ResultTcString.Ok
                (compiler-symbol-module-key module (intern-str name)))
              (tc-nominal-owner-name-list rest target (+ index 1) module))]
          [(AstDecl.ComptimeDecl _ template-box)
            (let
              [template : AstDecl (box-get template-box)]
              (match template
                [(AstDecl.DefEnum name _ _)
                  (if (= target index)
                    (ResultTcString.Ok
                      (compiler-symbol-module-key module (intern-str name)))
                    (tc-nominal-owner-name-list rest target (+ index 1) module))]
                [(AstDecl.DefEnumLifetimes name _ _ _)
                  (if (= target index)
                    (ResultTcString.Ok
                      (compiler-symbol-module-key module (intern-str name)))
                    (tc-nominal-owner-name-list rest target (+ index 1) module))]
                [(AstDecl.DefStruct name _ _ _)
                  (if (= target index)
                    (ResultTcString.Ok
                      (compiler-symbol-module-key module (intern-str name)))
                    (tc-nominal-owner-name-list rest target (+ index 1) module))]
                [(AstDecl.DefStructLifetimes name _ _ _ _)
                  (if (= target index)
                    (ResultTcString.Ok
                      (compiler-symbol-module-key module (intern-str name)))
                    (tc-nominal-owner-name-list rest target (+ index 1) module))]
                [_ (tc-nominal-owner-name-list rest target (+ index 1) module)]))]
          [_ (tc-nominal-owner-name-list rest target (+ index 1) module)]))]))

(define (tc-nominal-owner-name-scan
  [program : AstProgram]
  [handle : i64]
  [index : i64]) : ResultTcString
  (match program
    [(AstProgram.Program decls-box)
      (let
        [decls : AstDeclList (box-get decls-box)]
        (match (tc-nominal-owner-name-list decls index 0 "")
          [(ResultTcString.Ok name)
            (begin
              (tc-nominal-owner-cache-store-if-safe! handle name)
              (ResultTcString.Ok name))]
          [(ResultTcString.Err message) (ResultTcString.Err message)]))]))

(define (tc-nominal-owner-name [ctx : TcContext] [handle : i64]) : ResultTcString
  (match (tc-nominal-owner-cache-lookup ctx handle)
    [(ResultTcString.Ok cached) (ResultTcString.Ok cached)]
    [(ResultTcString.Err _)
      (match ctx
        [(TcContext program symbols _ _ _)
          (match (compiler-symbols-owner-name-at-index
            symbols
            (compiler-symbol-handle-index handle))
            [(CompilerSomeString name)
              (begin
                (tc-nominal-owner-cache-store-if-safe! handle name)
                (ResultTcString.Ok name))]
            [(CompilerNoString)
              (tc-nominal-owner-name-scan
                program
                handle
                (compiler-symbol-handle-index handle))])])]))

(define (tc-nominal-owner-name-at-index [ctx : TcContext] [index : i64]) : ResultTcString
  (match (compiler-symbols-owner-name-at-index (tc-context-symbols ctx) index)
    [(CompilerSomeString name) (ResultTcString.Ok name)]
    [(CompilerNoString)
      (match (tc-context-program ctx)
        [(AstProgram.Program decls-box)
          (tc-nominal-owner-name-list (box-get decls-box) index 0 "")])]))

(define (tc-context-with-owner-name-module
  [ctx : TcContext]
  [owner-name : String]) : TcContext
  (if (tc-name-qualified? owner-name)
    (tc-context-with-module ctx (tc-qualified-name-module owner-name))
    (tc-context-with-module ctx "")))

(define (tc-context-with-nominal-owner-index-module
  [ctx : TcContext]
  [index : i64]) : TcContext
  (match (tc-nominal-owner-name-at-index ctx index)
    [(ResultTcString.Ok owner-name)
      (tc-context-with-owner-name-module ctx owner-name)]
    [(ResultTcString.Err _) ctx]))

(define (tc-resolve-type-name [ctx : TcContext] [name : String]) : AstType
  (match ctx
    [(TcContext _ symbols _ module _)
      (let
        [source-name : String
          (match (tc-dotted-type-name-lookup-key ctx name)
            [(ResultTcString.Ok key) key]
            [(ResultTcString.Err _) name])]
        [lookup-name : String
          (if (and
            (> (string.string-length module) 0)
            (not (tc-name-qualified? source-name)))
            (compiler-symbol-module-key module source-name)
            source-name)]
        [handle : i64 (tc-resolve-type-name-symbol-lookup symbols lookup-name)]
        (if (compiler-symbols-handle-found? handle)
          (if (and
            (tc-name-qualified? lookup-name)
            (string.eq (tc-qualified-name-module lookup-name) module))
            (match (tc-stdlib-comptime-syntax-type lookup-name)
              [(AstMaybeType.Some syntax-ty) syntax-ty]
              [(AstMaybeType.No)
                (tc-resolved-current-module-nominal-type ctx lookup-name handle)])
            (match (tc-nominal-owner-name ctx handle)
              [(ResultTcString.Ok canonical-name)
                (match (tc-stdlib-comptime-syntax-type canonical-name)
                  [(AstMaybeType.Some syntax-ty) syntax-ty]
                  [(AstMaybeType.No)
                    (tc-resolved-nominal-type
                      (tc-qualified-lookup-owner-name
                        lookup-name
                        canonical-name)
                      handle)])]
              [(ResultTcString.Err _)
                (match (tc-stdlib-comptime-syntax-type lookup-name)
                  [(AstMaybeType.Some syntax-ty) syntax-ty]
                  [(AstMaybeType.No)
                    (tc-resolved-nominal-type lookup-name handle)])]))
          (cond
            [(string.eq name "Expr") (AstType.Expr)]
            [(string.eq name "ExprList") (AstType.ExprList)]
            [(string.eq name "ExprClause") (tc-macro-expr-clause-type)]
            [(string.eq name "ExprClauseList") (tc-macro-expr-clause-list-type)]
            [(string.eq name "ExprBindingClause")
              (tc-macro-expr-binding-clause-type)]
            [(string.eq name "ExprBindingClauseList")
              (tc-macro-expr-binding-clause-list-type)]
            [(string.eq name "Pattern") (tc-macro-pattern-type)]
            [(string.eq name "PatternList") (tc-macro-pattern-list-type)]
            [(string.eq name "MatchArm") (tc-macro-match-arm-type)]
            [(string.eq name "MatchArmList") (tc-macro-match-arm-list-type)]
            [else (AstType.Var (intern name))])))]))

(define (tc-resolve-type [ctx : TcContext] [ty : AstType]) : AstType
  (if (tc-type-needs-resolution? ty)
    (match ty
      [(AstType.Func args ret)
        (ast-ty-func
          (tc-resolve-type-list ctx (box-get args))
          (tc-resolve-type ctx (ty-node-get ret)))]
      [(AstType.Tuple elems)
        (ast-ty-tuple (tc-resolve-type-list ctx (box-get elems)))]
      [(AstType.Array elem len)
        (ast-ty-array (tc-resolve-type ctx (ty-node-get elem)) len)]
      [(AstType.DynArray elem)
        (ast-ty-dyn-array (tc-resolve-type ctx (ty-node-get elem)))]
      [(AstType.Box elem) (ast-ty-box (tc-resolve-type ctx (ty-node-get elem)))]
      [(AstType.Ptr elem) (ast-ty-ptr (tc-resolve-type ctx (ty-node-get elem)))]
      [(AstType.MutPtr elem)
        (ast-ty-mut-ptr (tc-resolve-type ctx (ty-node-get elem)))]
      [(AstType.Ref region inner)
        (ast-ty-ref region (tc-resolve-type ctx (ty-node-get inner)))]
      [(AstType.MutRef region inner)
        (ast-ty-mut-ref region (tc-resolve-type ctx (ty-node-get inner)))]
      [(AstType.Region region inner)
        (ast-ty-region region (tc-resolve-type ctx (ty-node-get inner)))]
      [(AstType.VarArgs name lifetimes)
        (tc-resolve-type-name-with-args
          ctx
          (intern-str name)
          (box-get lifetimes))]
      [(AstType.Var name) (tc-resolve-type-name ctx (intern-str name))]
      [_ ty])
    ty))

(define (tc-resolve-type-name-with-args
  [ctx : TcContext]
  [name : String]
  [lifetimes : AstLifetimeList]) : AstType
  (match ctx
    [(TcContext _ symbols _ module _)
      (let
        [source-name : String
          (match (tc-dotted-type-name-lookup-key ctx name)
            [(ResultTcString.Ok key) key]
            [(ResultTcString.Err _) name])]
        [lookup-name : String
          (if (and
            (> (string.string-length module) 0)
            (not (tc-name-qualified? source-name)))
            (compiler-symbol-module-key module source-name)
            source-name)]
        [handle : i64 (tc-resolve-type-name-symbol-lookup symbols lookup-name)]
        (if (compiler-symbols-handle-found? handle)
          (if (and
            (tc-name-qualified? lookup-name)
            (string.eq (tc-qualified-name-module lookup-name) module))
            (match (tc-stdlib-comptime-syntax-type lookup-name)
              [(AstMaybeType.Some syntax-ty) syntax-ty]
              [(AstMaybeType.No)
                (tc-resolved-current-module-nominal-type-with-args
                  ctx
                  lookup-name
                  handle
                  lifetimes)])
            (match (tc-nominal-owner-name ctx handle)
              [(ResultTcString.Ok canonical-name)
                (match (tc-stdlib-comptime-syntax-type canonical-name)
                  [(AstMaybeType.Some syntax-ty) syntax-ty]
                  [(AstMaybeType.No)
                    (tc-resolved-nominal-type-with-args
                      (tc-qualified-lookup-owner-name
                        lookup-name
                        canonical-name)
                      handle
                      lifetimes)])]
              [(ResultTcString.Err _)
                (match (tc-stdlib-comptime-syntax-type lookup-name)
                  [(AstMaybeType.Some syntax-ty) syntax-ty]
                  [(AstMaybeType.No)
                    (tc-resolved-nominal-type-with-args
                      lookup-name
                      handle
                      lifetimes)])]))
          (ast-ty-var-args (intern name) lifetimes)))]))

(define (tc-source-str-value-policy-message) : String
  "typecheck: str is a borrowed string-slice referent; use (& lifetime str)")

(define (tc-source-str-mut-ref-policy-message) : String
  "typecheck: mutable references to str are reserved; use immutable (& lifetime str)")

(define (tc-source-bytes-value-policy-message) : String
  "typecheck: bytes is a borrowed byte-slice referent; use (& lifetime bytes) or (&mut lifetime bytes)")

(define (tc-source-type-policy-message [name : String]) : String
  (cond
    [(string.eq name "varying")
      "typecheck: public SPMD varying source types are deferred; varying is inferred inside foreach (#2764)"]
    [(string.eq name "Varying")
      "typecheck: public SPMD varying source types are deferred; varying is inferred inside foreach (#2764)"]
    [(string.eq name "Vector")
      "typecheck: public SPMD vector source types are deferred; vector values remain compiler-internal (#2764)"]
    [(string.eq name "vector")
      "typecheck: public SPMD vector source types are deferred; vector values remain compiler-internal (#2764)"]
    [(string.eq name "Mask")
      "typecheck: public SPMD mask source types are deferred; masks remain compiler-internal (#2764)"]
    [(string.eq name "mask")
      "typecheck: public SPMD mask source types are deferred; masks remain compiler-internal (#2764)"]
    [else
      (string.append
        "typecheck: unknown type "
        (string.append
          name
          "; TypeLisp has no source-level type parameters; use comptime-generated concrete declarations instead (#893/#913/#970/#902)"))]))

(define (tc-nominal-lifetimes-from-decl [decl : AstDecl]) : ResultTcLifetimeList
  (match decl
    [(AstDecl.DefEnum _ _ _) (ResultTcLifetimeList.Ok (ast-lifetime-list-new))]
    [(AstDecl.DefEnumLifetimes _ lifetimes _ _)
      (ResultTcLifetimeList.Ok lifetimes)]
    [(AstDecl.DefStruct _ _ _ _)
      (ResultTcLifetimeList.Ok (ast-lifetime-list-new))]
    [(AstDecl.DefStructLifetimes _ lifetimes _ _ _)
      (ResultTcLifetimeList.Ok lifetimes)]
    [_ (ResultTcLifetimeList.Err "typecheck: nominal type not found")]))

(define (tc-nominal-lifetimes [ctx : TcContext] [name : String]) : ResultTcLifetimeList
  (match ctx
    [(TcContext _ symbols _ _ _)
      (let
        [handle : i64
          (compiler-symbols-lookup-type-or
            symbols
            name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? handle)
          (match (compiler-symbols-decl-at-index
            symbols
            (compiler-symbol-handle-index handle))
            [(ResultAstDecl.Ok decl) (tc-nominal-lifetimes-from-decl decl)]
            [(ResultAstDecl.Err message) (ResultTcLifetimeList.Err message)])
          (ResultTcLifetimeList.Err "typecheck: nominal type not found")))]))

(define (tc-nominal-lifetime-use-policy-ok
  [ctx : TcContext]
  [name : String]
  [lifetimes : AstLifetimeList]) : ResultTcUnit
  (match (tc-nominal-lifetimes ctx name)
    [(ResultTcLifetimeList.Ok params)
      (if (= (tc-lifetime-list-count params) (tc-lifetime-list-count lifetimes))
        ResultTcUnit.Ok
        (ResultTcUnit.Err "typecheck: nominal lifetime argument arity mismatch"))]
    [(ResultTcLifetimeList.Err message) (ResultTcUnit.Err message)]))

(define (tc-bare-nominal-lifetime-policy-ok [ctx : TcContext] [name : String]) : ResultTcUnit
  (match (tc-nominal-lifetimes ctx name)
    [(ResultTcLifetimeList.Ok params)
      (if (ast-lifetime-list-empty? (& params))
        ResultTcUnit.Ok
        (ResultTcUnit.Err "typecheck: missing nominal lifetime arguments"))]
    [(ResultTcLifetimeList.Err message) (ResultTcUnit.Err message)]))

(define (tc-source-type-list-policy-ok [ctx : TcContext] [types : AstTypeList]) : ResultTcUnit
  (tc-source-type-list-policy-ok-at ctx (& types) 0))

(define (tc-source-type-list-policy-ok-at
  [ctx : TcContext]
  [types : (& types AstTypeList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-type-list-len types))
    ResultTcUnit.Ok
    (match (tc-source-type-policy-ok
      ctx
      (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      [(ResultTcUnit.Ok)
        (tc-source-type-list-policy-ok-at ctx types (+ index 1))]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

(define (tc-source-type-policy-ok [ctx : TcContext] [ty : AstType]) : ResultTcUnit
  (if (tc-type-unquote-marker? ty)
    ResultTcUnit.Ok
    (let
      [syntax-ok : ResultTcUnit
        (match ty
          [(AstType.Var name)
            (match (tc-source-type-name-lookup-key ctx (intern-str name))
              [(ResultTcString.Ok _) ResultTcUnit.Ok]
              [(ResultTcString.Err message) (ResultTcUnit.Err message)])]
          [(AstType.VarArgs name _)
            (match (tc-source-type-name-lookup-key ctx (intern-str name))
              [(ResultTcString.Ok _) ResultTcUnit.Ok]
              [(ResultTcString.Err message) (ResultTcUnit.Err message)])]
          [_ ResultTcUnit.Ok])]
      (match syntax-ok
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]
        [(ResultTcUnit.Ok)
          (match (tc-resolve-type ctx ty)
            [(AstType.Func args ret)
              (match (tc-source-type-list-policy-ok ctx (box-get args))
                [(ResultTcUnit.Ok)
                  (tc-source-type-policy-ok ctx (ty-node-get ret))]
                [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
            [(AstType.Tuple elems)
              (tc-source-type-list-policy-ok ctx (box-get elems))]
            [(AstType.Array elem _)
              (tc-source-type-policy-ok ctx (ty-node-get elem))]
            [(AstType.DynArray elem)
              (tc-source-type-policy-ok ctx (ty-node-get elem))]
            [(AstType.Box elem)
              (tc-source-type-policy-ok ctx (ty-node-get elem))]
            [(AstType.Ptr elem)
              (tc-source-type-policy-ok ctx (ty-node-get elem))]
            [(AstType.MutPtr elem)
              (tc-source-type-policy-ok ctx (ty-node-get elem))]
            [(AstType.Ref _ inner)
              (match (tc-resolve-type ctx (ty-node-get inner))
                [(AstType.Str) ResultTcUnit.Ok]
                [(AstType.Bytes) ResultTcUnit.Ok]
                [_ (tc-source-type-policy-ok ctx (ty-node-get inner))])]
            [(AstType.MutRef _ inner)
              (match (tc-resolve-type ctx (ty-node-get inner))
                [(AstType.Str)
                  (ResultTcUnit.Err (tc-source-str-mut-ref-policy-message))]
                [(AstType.Bytes) ResultTcUnit.Ok]
                [_ (tc-source-type-policy-ok ctx (ty-node-get inner))])]
            [(AstType.Region _ inner)
              (tc-source-type-policy-ok ctx (ty-node-get inner))]
            [(AstType.Str)
              (ResultTcUnit.Err (tc-source-str-value-policy-message))]
            [(AstType.Bytes)
              (ResultTcUnit.Err (tc-source-bytes-value-policy-message))]
            [(AstType.Enum name)
              (tc-bare-nominal-lifetime-policy-ok ctx (intern-str name))]
            [(AstType.Struct name)
              (tc-bare-nominal-lifetime-policy-ok ctx (intern-str name))]
            [(AstType.EnumArgs name lifetimes)
              (tc-nominal-lifetime-use-policy-ok
                ctx
                (intern-str name)
                (box-get lifetimes))]
            [(AstType.StructArgs name lifetimes)
              (tc-nominal-lifetime-use-policy-ok
                ctx
                (intern-str name)
                (box-get lifetimes))]
            [(AstType.VarArgs name _)
              (ResultTcUnit.Err
                (tc-source-type-policy-message (intern-str name)))]
            [(AstType.Var name)
              (if (or
                (= name (intern "ExprClause"))
                (= name (intern "ExprClauseList"))
                (= name (intern "ExprBindingClause"))
                (= name (intern "ExprBindingClauseList"))
                (= name (intern "Pattern"))
                (= name (intern "PatternList"))
                (= name (intern "MatchArm"))
                (= name (intern "MatchArmList")))
                ResultTcUnit.Ok
                (ResultTcUnit.Err
                  (tc-source-type-policy-message (intern-str name))))]
            [_ ResultTcUnit.Ok])]))))

(define (tc-source-maybe-type-policy-ok
  [ctx : TcContext]
  [maybe-ty : AstMaybeType]) : ResultTcUnit
  (match maybe-ty
    [(AstMaybeType.No) ResultTcUnit.Ok]
    [(AstMaybeType.Some ty) (tc-source-type-policy-ok ctx ty)]))

(define (tc-source-param-list-policy-ok
  [ctx : TcContext]
  [params : AstParamList]) : ResultTcUnit
  (tc-source-param-list-policy-ok-at ctx (& params) 0))

(define (tc-source-param-list-policy-ok-at
  [ctx : TcContext]
  [params : (& params AstParamList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-param-list-len params))
    ResultTcUnit.Ok
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param _ ty _)
        (match (tc-source-type-policy-ok ctx ty)
          [(ResultTcUnit.Ok)
            (tc-source-param-list-policy-ok-at ctx params (+ index 1))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])))

(define (tc-source-macro-param-list-policy-ok
  [ctx : TcContext]
  [params : AstMacroParamList]) : ResultTcUnit
  (tc-source-macro-param-list-policy-ok-at ctx (& params) 0))

(define (tc-source-macro-param-list-policy-ok-at
  [ctx : TcContext]
  [params : (& params AstMacroParamList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-macro-param-list-len params))
    ResultTcUnit.Ok
    (match (ast-macro-param-list-get params index (ast-macro-param-fallback))
      [(AstMacroParam.Param _ ty variadic)
        (if (tc-macro-type-param-kind? ty)
          (if variadic
            (ResultTcUnit.Err
              "typecheck: type macro operand cannot be variadic")
            (tc-source-macro-param-list-policy-ok-at ctx params (+ index 1)))
          (if (tc-macro-module-param-kind? ty)
            (if variadic
              (ResultTcUnit.Err
                "typecheck: Module macro operand cannot be variadic")
              (tc-source-macro-param-list-policy-ok-at ctx params (+ index 1)))
            (match (tc-source-type-policy-ok ctx ty)
              [(ResultTcUnit.Ok)
                (tc-source-macro-param-list-policy-ok-at ctx params (+ index 1))]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))])))

(define (tc-macro-result-name? [ty : AstType] [upper : String] [lower : String]) : bool
  (match ty
    [(AstType.Var name) (or (= name (intern upper)) (= name (intern lower)))]
    [_ false]))

(define (tc-macro-result-module? [ty : AstType]) : bool
  (tc-macro-result-name? ty "Module" "module"))

(define (tc-macro-result-decls? [ty : AstType]) : bool
  (tc-macro-result-name? ty "Decls" "decls"))

(define (tc-macro-result-decl-emitting? [ty : AstType]) : bool
  (or (tc-macro-result-module? ty) (tc-macro-result-decls? ty)))

(define (tc-source-macro-result-policy-ok [ctx : TcContext] [ty : AstType]) : ResultTcUnit
  (if (tc-macro-result-decl-emitting? ty)
    ResultTcUnit.Ok
    (tc-source-type-policy-ok ctx ty)))

(define (tc-source-field-list-policy-ok
  [ctx : TcContext]
  [fields : AstFieldDefList]) : ResultTcUnit
  (tc-source-field-list-policy-ok-at ctx (& fields) 0))

(define (tc-source-field-list-policy-ok-at
  [ctx : TcContext]
  [fields : (& fields AstFieldDefList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get fields len))
    ResultTcUnit.Ok
    (match (ast-field-def-list-get fields index (ast-field-def-fallback))
      [(AstFieldDef.Def _ ty _)
        (match (tc-source-type-policy-ok ctx ty)
          [(ResultTcUnit.Ok)
            (tc-source-field-list-policy-ok-at ctx fields (+ index 1))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])))

(define (tc-struct-cleanup-repr-c-message [struct-name : String]) : String
  (str_cat.str-cat
    "typecheck: cleanup-owning struct "
    struct-name
    " cannot use repr c"))

(define (tc-source-variant-list-policy-ok
  [ctx : TcContext]
  [variants : AstVariantDefList]) : ResultTcUnit
  (tc-source-variant-list-policy-ok-at ctx (& variants) 0))

(define (tc-source-variant-list-policy-ok-at
  [ctx : TcContext]
  [variants : (& variants AstVariantDefList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get variants len))
    ResultTcUnit.Ok
    (match (ast-variant-def-list-get variants index (ast-variant-def-fallback))
      [(AstVariantDef.Def _ fields _)
        (match (tc-source-type-list-policy-ok ctx fields)
          [(ResultTcUnit.Ok)
            (tc-source-variant-list-policy-ok-at ctx variants (+ index 1))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])))

(define (tc-decl-lifetime-name-allowed?
  [params : AstLifetimeList]
  [name : String]) : bool
  (or (string.eq name "program") (tc-lifetime-list-contains params name)))

(define (tc-decl-lifetime-string-list-all-in?
  [lifetimes : TcStringList]
  [params : AstLifetimeList]) : bool
  (match lifetimes
    [(TcStringList.Nil) true]
    [(TcStringList.Cons lifetime rest)
      (and
        (tc-decl-lifetime-name-allowed? params lifetime)
        (tc-decl-lifetime-string-list-all-in? (box-get rest) params))]))

(define (tc-source-type-decl-lifetimes-ok
  [ctx : TcContext]
  [params : AstLifetimeList]
  [ty : AstType]) : ResultTcUnit
  (let
    [lifetimes : TcStringList
      (tc-type-collect-reference-lifetimes (tc-resolve-type ctx ty))]
    (if (tc-decl-lifetime-string-list-all-in? lifetimes params)
      ResultTcUnit.Ok
      (ResultTcUnit.Err "typecheck: unknown aggregate lifetime parameter"))))

(define (tc-source-field-list-lifetimes-policy-ok
  [ctx : TcContext]
  [params : AstLifetimeList]
  [fields : AstFieldDefList]) : ResultTcUnit
  (tc-source-field-list-lifetimes-policy-ok-at ctx params (& fields) 0))

(define (tc-source-field-list-lifetimes-policy-ok-at
  [ctx : TcContext]
  [params : AstLifetimeList]
  [fields : (& fields AstFieldDefList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get fields len))
    ResultTcUnit.Ok
    (match (ast-field-def-list-get fields index (ast-field-def-fallback))
      [(AstFieldDef.Def _ ty _)
        (match (tc-source-type-policy-ok ctx ty)
          [(ResultTcUnit.Ok)
            (match (tc-source-type-decl-lifetimes-ok ctx params ty)
              [(ResultTcUnit.Ok)
                (tc-source-field-list-lifetimes-policy-ok-at
                  ctx
                  params
                  fields
                  (+ index 1))]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])))

(define (tc-source-type-list-lifetimes-policy-ok
  [ctx : TcContext]
  [params : AstLifetimeList]
  [types : AstTypeList]) : ResultTcUnit
  (tc-source-type-list-lifetimes-policy-ok-at ctx params (& types) 0))

(define (tc-source-type-list-lifetimes-policy-ok-at
  [ctx : TcContext]
  [params : AstLifetimeList]
  [types : (& types AstTypeList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-type-list-len types))
    ResultTcUnit.Ok
    (let
      [head : AstType
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))]
      (match (tc-source-type-policy-ok ctx head)
        [(ResultTcUnit.Ok)
          (match (tc-source-type-decl-lifetimes-ok ctx params head)
            [(ResultTcUnit.Ok)
              (tc-source-type-list-lifetimes-policy-ok-at
                ctx
                params
                types
                (+ index 1))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))))

(define (tc-source-variant-list-lifetimes-policy-ok
  [ctx : TcContext]
  [params : AstLifetimeList]
  [variants : AstVariantDefList]) : ResultTcUnit
  (tc-source-variant-list-lifetimes-policy-ok-at ctx params (& variants) 0))

(define (tc-source-variant-list-lifetimes-policy-ok-at
  [ctx : TcContext]
  [params : AstLifetimeList]
  [variants : (& variants AstVariantDefList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get variants len))
    ResultTcUnit.Ok
    (match (ast-variant-def-list-get variants index (ast-variant-def-fallback))
      [(AstVariantDef.Def _ fields _)
        (match (tc-source-type-list-lifetimes-policy-ok ctx params fields)
          [(ResultTcUnit.Ok)
            (tc-source-variant-list-lifetimes-policy-ok-at
              ctx
              params
              variants
              (+ index 1))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])))

(define (tc-source-default-aggregate-layout-finite-ok
  [ctx : TcContext]
  [name : String]) : ResultTcUnit
  (tc-inline-aggregate-layout-finite-ok
    ctx
    (compiler-symbol-module-key (tc-context-module ctx) name)))

(define (tc-source-default-struct-layout-finite-ok
  [ctx : TcContext]
  [name : String]
  [repr : AstStructRepr]) : ResultTcUnit
  (if (ast-struct-repr-c? repr)
    ResultTcUnit.Ok
    (tc-source-default-aggregate-layout-finite-ok ctx name)))

(define (tc-source-pattern-list-policy-ok
  [ctx : TcContext]
  [patterns : AstPatternList]) : ResultTcUnit
  (tc-source-pattern-list-policy-ok-at ctx (& patterns) 0))

(define (tc-source-pattern-list-policy-ok-at
  [ctx : TcContext]
  [patterns : (& patterns AstPatternList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get patterns len))
    ResultTcUnit.Ok
    (match (tc-source-pattern-policy-ok
      ctx
      (ast-pattern-list-get patterns index (ast-pattern-fallback)))
      [(ResultTcUnit.Ok)
        (tc-source-pattern-list-policy-ok-at ctx patterns (+ index 1))]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

(define (tc-source-pattern-policy-ok [ctx : TcContext] [pattern : AstPattern]) : ResultTcUnit
  (match pattern
    [(AstPattern.Var _ maybe-ty) (tc-source-maybe-type-policy-ok ctx maybe-ty)]
    [(AstPattern.Tuple patterns-box)
      (let
        [patterns : AstPatternList (box-get patterns-box)]
        (tc-source-pattern-list-policy-ok ctx patterns))]
    [(AstPattern.Variant _ patterns-box)
      (let
        [patterns : AstPatternList (box-get patterns-box)]
        (tc-source-pattern-list-policy-ok ctx patterns))]
    [_ ResultTcUnit.Ok]))

(define (tc-source-match-arm-list-policy-ok
  [ctx : TcContext]
  [arms : AstMatchArmList]) : ResultTcUnit
  (tc-source-match-arm-list-policy-ok-at ctx (& arms) 0))

(define (tc-source-match-arm-list-policy-ok-at
  [ctx : TcContext]
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get arms len))
    ResultTcUnit.Ok
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (let
          [body : AstExpr (ast-node-get body-box)]
          (match (tc-source-pattern-policy-ok ctx pattern)
            [(ResultTcUnit.Ok)
              (match (tc-source-expr-policy-ok ctx body)
                [(ResultTcUnit.Ok)
                  (tc-source-match-arm-list-policy-ok-at ctx arms (+ index 1))]
                [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])))

(define (tc-source-let-binding-list-policy-ok
  [ctx : TcContext]
  [bindings : AstLetBindingList]) : ResultTcUnit
  (tc-source-let-binding-list-policy-ok-at ctx (& bindings) 0))

(define (tc-source-let-binding-list-policy-ok-at
  [ctx : TcContext]
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-let-binding-list-len bindings))
    ResultTcUnit.Ok
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding _ maybe-ty init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (match (tc-source-maybe-type-policy-ok ctx maybe-ty)
            [(ResultTcUnit.Ok)
              (match (tc-source-expr-policy-ok ctx init)
                [(ResultTcUnit.Ok)
                  (tc-source-let-binding-list-policy-ok-at
                    ctx
                    bindings
                    (+ index 1))]
                [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])))

(define (tc-source-resource-binding-list-policy-ok
  [ctx : TcContext]
  [bindings : AstResourceBindingList]) : ResultTcUnit
  (tc-source-resource-binding-list-policy-ok-at ctx (& bindings) 0))

(define (tc-source-resource-binding-list-policy-ok-at
  [ctx : TcContext]
  [bindings : (& bindings AstResourceBindingList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-resource-binding-list-len bindings))
    ResultTcUnit.Ok
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding _ init-box cleanup-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          [cleanup : AstExpr (ast-node-get cleanup-box)]
          (match (tc-source-expr-policy-ok ctx init)
            [(ResultTcUnit.Ok)
              (match (tc-source-expr-policy-ok ctx cleanup)
                [(ResultTcUnit.Ok)
                  (tc-source-resource-binding-list-policy-ok-at
                    ctx
                    bindings
                    (+ index 1))]
                [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])))

(define (tc-source-expr-list-policy-ok [ctx : TcContext] [exprs : AstExprList]) : ResultTcUnit
  (tc-source-expr-list-policy-ok-at ctx (& exprs) 0))

(define (tc-source-expr-list-policy-ok-at
  [ctx : TcContext]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get exprs len))
    ResultTcUnit.Ok
    (let
      [expr : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
      (match (tc-source-expr-policy-ok ctx expr)
        [(ResultTcUnit.Ok)
          (tc-source-expr-list-policy-ok-at ctx exprs (+ index 1))]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))))

(define (tc-source-expr-pair-policy-ok
  [ctx : TcContext]
  [left : AstExpr]
  [right : AstExpr]) : ResultTcUnit
  (match (tc-source-expr-policy-ok ctx left)
    [(ResultTcUnit.Ok) (tc-source-expr-policy-ok ctx right)]
    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))

(define (tc-source-expr-triple-policy-ok
  [ctx : TcContext]
  [first : AstExpr]
  [second : AstExpr]
  [third : AstExpr]) : ResultTcUnit
  (match (tc-source-expr-pair-policy-ok ctx first second)
    [(ResultTcUnit.Ok) (tc-source-expr-policy-ok ctx third)]
    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))

(define (tc-spmd-broadcast-scope-message) : String
  "typecheck: spmd-broadcast is only valid inside a foreach body, spmd-reduce value expression, or spmd-scan body")

(define (tc-spmd-shuffle-scope-message) : String
  "typecheck: spmd-shuffle is only valid inside a foreach body, spmd-reduce value expression, or spmd-scan body")

(define (tc-spmd-lane-scope-message [name : String]) : String
  (string.append
    (string.append "typecheck: " name)
    " is only valid inside a foreach body or spmd-reduce value expression"))

(define (tc-source-expr-list-spmd-broadcast-scope-ok
  [exprs : AstExprList]
  [allow : bool]) : ResultTcUnit
  (tc-source-expr-list-spmd-broadcast-scope-ok-at (& exprs) 0 allow))

(define (tc-source-expr-list-spmd-broadcast-scope-ok-at
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [allow : bool]) : ResultTcUnit
  (if (>= index (struct-get exprs len))
    ResultTcUnit.Ok
    (let
      [expr : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
      (match (tc-source-expr-spmd-broadcast-scope-ok expr allow)
        [(ResultTcUnit.Ok)
          (tc-source-expr-list-spmd-broadcast-scope-ok-at
            exprs
            (+ index 1)
            allow)]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))))

(define (tc-source-expr-pair-spmd-broadcast-scope-ok
  [left : AstExpr]
  [right : AstExpr]
  [allow : bool]) : ResultTcUnit
  (match (tc-source-expr-spmd-broadcast-scope-ok left allow)
    [(ResultTcUnit.Ok) (tc-source-expr-spmd-broadcast-scope-ok right allow)]
    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))

(define (tc-source-expr-triple-spmd-broadcast-scope-ok
  [first : AstExpr]
  [second : AstExpr]
  [third : AstExpr]
  [allow : bool]) : ResultTcUnit
  (match (tc-source-expr-pair-spmd-broadcast-scope-ok first second allow)
    [(ResultTcUnit.Ok) (tc-source-expr-spmd-broadcast-scope-ok third allow)]
    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))

(define (tc-source-let-binding-list-spmd-broadcast-scope-ok
  [bindings : AstLetBindingList]
  [allow : bool]) : ResultTcUnit
  (tc-source-let-binding-list-spmd-broadcast-scope-ok-at (& bindings) allow 0))

(define (tc-source-let-binding-list-spmd-broadcast-scope-ok-at
  [bindings : (& bindings AstLetBindingList)]
  [allow : bool]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-let-binding-list-len bindings))
    ResultTcUnit.Ok
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding _ _ init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (match (tc-source-expr-spmd-broadcast-scope-ok init allow)
            [(ResultTcUnit.Ok)
              (tc-source-let-binding-list-spmd-broadcast-scope-ok-at
                bindings
                allow
                (+ index 1))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])))

(define (tc-source-resource-binding-list-spmd-broadcast-scope-ok
  [bindings : AstResourceBindingList]
  [allow : bool]) : ResultTcUnit
  (tc-source-resource-binding-list-spmd-broadcast-scope-ok-at
    (& bindings)
    allow
    0))

(define (tc-source-resource-binding-list-spmd-broadcast-scope-ok-at
  [bindings : (& bindings AstResourceBindingList)]
  [allow : bool]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-resource-binding-list-len bindings))
    ResultTcUnit.Ok
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding _ init-box cleanup-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          [cleanup : AstExpr (ast-node-get cleanup-box)]
          (match (tc-source-expr-pair-spmd-broadcast-scope-ok
            init
            cleanup
            allow)
            [(ResultTcUnit.Ok)
              (tc-source-resource-binding-list-spmd-broadcast-scope-ok-at
                bindings
                allow
                (+ index 1))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])))

(define (tc-source-match-arm-list-spmd-broadcast-scope-ok
  [arms : AstMatchArmList]
  [allow : bool]) : ResultTcUnit
  (tc-source-match-arm-list-spmd-broadcast-scope-ok-at (& arms) allow 0))

(define (tc-source-match-arm-list-spmd-broadcast-scope-ok-at
  [arms : (& arms AstMatchArmList)]
  [allow : bool]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get arms len))
    ResultTcUnit.Ok
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm _ body-box)
        (let
          [body : AstExpr (ast-node-get body-box)]
          (match (tc-source-expr-spmd-broadcast-scope-ok body allow)
            [(ResultTcUnit.Ok)
              (tc-source-match-arm-list-spmd-broadcast-scope-ok-at
                arms
                allow
                (+ index 1))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])))

(define (tc-source-expr-spmd-broadcast-scope-ok [expr : AstExpr] [allow : bool]) : ResultTcUnit
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok left right allow))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (match (tc-source-expr-spmd-broadcast-scope-ok func allow)
          [(ResultTcUnit.Ok)
            (tc-source-expr-list-spmd-broadcast-scope-ok args allow)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-box)]
        [else-branch : AstExpr (ast-node-get else-box)]
        (tc-source-expr-triple-spmd-broadcast-scope-ok
          cond
          then-branch
          else-branch
          allow))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-let-binding-list-spmd-broadcast-scope-ok
              bindings
              allow)
              [(ResultTcUnit.Ok)
                (tc-source-expr-spmd-broadcast-scope-ok body allow)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda _ _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (tc-source-expr-spmd-broadcast-scope-ok body false))])]
    [(AstExpr.Tuple exprs)
      (tc-source-expr-list-spmd-broadcast-scope-ok exprs allow)]
    [(AstExpr.TupleRef tuple-box _)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        (tc-source-expr-spmd-broadcast-scope-ok tuple allow))]
    [(AstExpr.Array exprs)
      (tc-source-expr-list-spmd-broadcast-scope-ok exprs allow)]
    [(AstExpr.MakeArray _ len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (tc-source-expr-spmd-broadcast-scope-ok len allow))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok array index allow))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-triple-spmd-broadcast-scope-ok array index value allow))]
    [(AstExpr.ArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok array value allow))]
    [(AstExpr.StringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok str index allow))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok cond body allow))]
    [(AstExpr.Begin exprs)
      (tc-source-expr-list-spmd-broadcast-scope-ok exprs allow)]
    [(AstExpr.Unsafe exprs)
      (tc-source-expr-list-spmd-broadcast-scope-ok exprs allow)]
    [(AstExpr.Set _ value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-spmd-broadcast-scope-ok value allow))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.Borrow _ _ place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (tc-source-expr-spmd-broadcast-scope-ok place allow))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            (match (tc-source-expr-spmd-broadcast-scope-ok scrutinee allow)
              [(ResultTcUnit.Ok)
                (tc-source-match-arm-list-spmd-broadcast-scope-ok arms allow)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach _ _ start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-expr-pair-spmd-broadcast-scope-ok start end false)
              [(ResultTcUnit.Ok)
                (tc-source-expr-spmd-broadcast-scope-ok body true)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce _ _ _ start-box end-box init-box value-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            (match (tc-source-expr-triple-spmd-broadcast-scope-ok
              start
              end
              init
              false)
              [(ResultTcUnit.Ok)
                (tc-source-expr-spmd-broadcast-scope-ok value true)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            _
            _
            _
            start-box
            end-box
            _
            _
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-expr-triple-spmd-broadcast-scope-ok
              start
              end
              init
              false)
              [(ResultTcUnit.Ok)
                (match (tc-source-expr-spmd-broadcast-scope-ok value false)
                  [(ResultTcUnit.Ok)
                    (tc-source-expr-spmd-broadcast-scope-ok body true)]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (if allow
        (let
          [value : AstExpr (ast-node-get value-box)]
          [lane : AstExpr (ast-node-get lane-box)]
          (tc-source-expr-pair-spmd-broadcast-scope-ok value lane true))
        (ResultTcUnit.Err (tc-spmd-broadcast-scope-message)))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (if allow
        (let
          [value : AstExpr (ast-node-get value-box)]
          [lane : AstExpr (ast-node-get lane-box)]
          (tc-source-expr-pair-spmd-broadcast-scope-ok value lane true))
        (ResultTcUnit.Err (tc-spmd-shuffle-scope-message)))]
    [(AstExpr.SpmdProgramIndex)
      (if allow
        ResultTcUnit.Ok
        (ResultTcUnit.Err (tc-spmd-lane-scope-message "program-index")))]
    [(AstExpr.SpmdProgramCount)
      (if allow
        ResultTcUnit.Ok
        (ResultTcUnit.Err (tc-spmd-lane-scope-message "program-count")))]
    [(AstExpr.StructGet receiver-box _)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (tc-source-expr-spmd-broadcast-scope-ok receiver allow))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok receiver value allow))]
    [(AstExpr.WithRegion _ body)
      (tc-source-expr-list-spmd-broadcast-scope-ok body allow)]
    [(AstExpr.WithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (match (tc-source-expr-spmd-broadcast-scope-ok scratch allow)
          [(ResultTcUnit.Ok)
            (tc-source-expr-list-spmd-broadcast-scope-ok body allow)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.WithScratch body)
      (tc-source-expr-list-spmd-broadcast-scope-ok body allow)]
    [(AstExpr.InArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (match (tc-source-expr-spmd-broadcast-scope-ok arena allow)
          [(ResultTcUnit.Ok)
            (tc-source-expr-list-spmd-broadcast-scope-ok body allow)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (match (tc-source-resource-binding-list-spmd-broadcast-scope-ok
            bindings
            allow)
            [(ResultTcUnit.Ok)
              (tc-source-expr-list-spmd-broadcast-scope-ok body allow)]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.BoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok inner value allow))]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.Quote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.Quasiquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.Unquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.UnquoteSplicing inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.BracketClause items)
      (tc-source-expr-list-spmd-broadcast-scope-ok items allow)]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.Return inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.PtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.PtrAddrOf inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.PtrRead inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-spmd-broadcast-scope-ok inner allow))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok ptr value allow))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok ptr offset allow))]
    [(AstExpr.PtrCast ptr-box _)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-source-expr-spmd-broadcast-scope-ok ptr allow))]
    [(AstExpr.PtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-source-expr-spmd-broadcast-scope-ok ptr allow))]
    [(AstExpr.IntToPtr value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-spmd-broadcast-scope-ok value allow))]
    [(AstExpr.StringData str-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        (tc-source-expr-spmd-broadcast-scope-ok str allow))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok ptr len allow))]
    [(AstExpr.ArrayData array-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-source-expr-spmd-broadcast-scope-ok array allow))]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok leaf subleaf allow))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok leaf subleaf allow))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok leaf subleaf allow))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-spmd-broadcast-scope-ok leaf subleaf allow))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (tc-source-expr-spmd-broadcast-scope-ok index allow))]
    [(AstExpr.Syscall args)
      (tc-source-expr-list-spmd-broadcast-scope-ok args allow)]
    [_ ResultTcUnit.Ok]))

(define (tc-source-expr-policy-ok [ctx : TcContext] [expr : AstExpr]) : ResultTcUnit
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (tc-source-expr-pair-policy-ok ctx left right))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (match (tc-source-expr-policy-ok ctx func)
          [(ResultTcUnit.Ok) (tc-source-expr-list-policy-ok ctx args)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.BracketClause items) (tc-source-expr-list-policy-ok ctx items)]
    [(AstExpr.TypeLiteral ty) (tc-source-type-policy-ok ctx ty)]
    [(AstExpr.Init maybe-ty) (tc-source-maybe-type-policy-ok ctx maybe-ty)]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (tc-source-expr-triple-policy-ok ctx cond then-branch else-branch))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-let-binding-list-policy-ok ctx bindings)
              [(ResultTcUnit.Ok) (tc-source-expr-policy-ok ctx body)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params maybe-ret body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-param-list-policy-ok ctx params)
              [(ResultTcUnit.Ok)
                (match (tc-source-maybe-type-policy-ok ctx maybe-ret)
                  [(ResultTcUnit.Ok)
                    (if (tc-maybe-type-contains-reference? maybe-ret)
                      (ResultTcUnit.Err
                        "typecheck: returning references requires lifetime support (#804)")
                      (tc-source-expr-policy-ok ctx body))]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.Tuple exprs) (tc-source-expr-list-policy-ok ctx exprs)]
    [(AstExpr.TupleRef tuple-box _)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        (tc-source-expr-policy-ok ctx tuple))]
    [(AstExpr.Array exprs) (tc-source-expr-list-policy-ok ctx exprs)]
    [(AstExpr.MakeArray elem-ty len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (match (tc-source-type-policy-ok ctx elem-ty)
          [(ResultTcUnit.Ok) (tc-source-expr-policy-ok ctx len)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (tc-source-expr-pair-policy-ok ctx array index))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-triple-policy-ok ctx array index value))]
    [(AstExpr.ArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-policy-ok ctx array value))]
    [(AstExpr.StringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (tc-source-expr-pair-policy-ok ctx str index))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (tc-source-expr-pair-policy-ok ctx cond body))]
    [(AstExpr.Begin exprs) (tc-source-expr-list-policy-ok ctx exprs)]
    [(AstExpr.Unsafe exprs) (tc-source-expr-list-policy-ok ctx exprs)]
    [(AstExpr.Set _ value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-policy-ok ctx value))]
    [(AstExpr.Ann inner-box ty)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-source-expr-policy-ok ctx inner)
          [(ResultTcUnit.Ok) (tc-source-type-policy-ok ctx ty)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.Cast inner-box ty)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-source-expr-policy-ok ctx inner)
          [(ResultTcUnit.Ok) (tc-source-type-policy-ok ctx ty)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.Borrow _ _ place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (tc-source-expr-policy-ok ctx place))]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExpr.BoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-policy-ok ctx inner value))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            (match (tc-source-expr-policy-ok ctx scrutinee)
              [(ResultTcUnit.Ok) (tc-source-match-arm-list-policy-ok ctx arms)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach _ index-ty start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-type-policy-ok ctx index-ty)
              [(ResultTcUnit.Ok)
                (tc-source-expr-triple-policy-ok ctx start end body)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce
            _
            _
            index-ty
            start-box
            end-box
            init-box
            value-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            (match (tc-source-type-policy-ok ctx index-ty)
              [(ResultTcUnit.Ok)
                (match (tc-source-expr-triple-policy-ok ctx start end init)
                  [(ResultTcUnit.Ok) (tc-source-expr-policy-ok ctx value)]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            _
            _
            index-ty
            start-box
            end-box
            _
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-source-type-policy-ok ctx index-ty)
              [(ResultTcUnit.Ok)
                (match (tc-source-type-policy-ok ctx prefix-ty)
                  [(ResultTcUnit.Ok)
                    (match (tc-source-expr-triple-policy-ok ctx start end init)
                      [(ResultTcUnit.Ok)
                        (match (tc-source-expr-policy-ok ctx value)
                          [(ResultTcUnit.Ok)
                            (tc-source-expr-policy-ok ctx body)]
                          [(ResultTcUnit.Err message)
                            (ResultTcUnit.Err message)])]
                      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (tc-source-expr-pair-policy-ok ctx value lane))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (tc-source-expr-pair-policy-ok ctx value lane))]
    [(AstExpr.StructGet receiver-box _)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (tc-source-expr-policy-ok ctx receiver))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-policy-ok ctx receiver value))]
    [(AstExpr.WithRegion _ body) (tc-source-expr-list-policy-ok ctx body)]
    [(AstExpr.WithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (match (tc-source-expr-policy-ok ctx scratch)
          [(ResultTcUnit.Ok) (tc-source-expr-list-policy-ok ctx body)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.WithScratch body) (tc-source-expr-list-policy-ok ctx body)]
    [(AstExpr.InArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (match (tc-source-expr-policy-ok ctx arena)
          [(ResultTcUnit.Ok) (tc-source-expr-list-policy-ok ctx body)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (match (tc-source-resource-binding-list-policy-ok ctx bindings)
            [(ResultTcUnit.Ok) (tc-source-expr-list-policy-ok ctx body)]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExpr.Quote _) ResultTcUnit.Ok]
    [(AstExpr.Quasiquote _) ResultTcUnit.Ok]
    [(AstExpr.Unquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExpr.UnquoteSplicing inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExpr.Return inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExpr.PtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-source-expr-policy-ok ctx inner))]
    [(AstExpr.PtrAddrOf _) ResultTcUnit.Ok]
    [(AstExpr.PtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-source-expr-policy-ok ctx ptr))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-source-expr-pair-policy-ok ctx ptr value))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (tc-source-expr-pair-policy-ok ctx ptr offset))]
    [(AstExpr.PtrCast ptr-box ty)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (match (tc-source-expr-policy-ok ctx ptr)
          [(ResultTcUnit.Ok) (tc-source-type-policy-ok ctx ty)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.PtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-source-expr-policy-ok ctx ptr))]
    [(AstExpr.IntToPtr value-box ty)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-source-expr-policy-ok ctx value)
          [(ResultTcUnit.Ok) (tc-source-type-policy-ok ctx ty)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.StringData str-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        (tc-source-expr-policy-ok ctx str))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (tc-source-expr-pair-policy-ok ctx ptr len))]
    [(AstExpr.ArrayData array-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-source-expr-policy-ok ctx array))]
    [(AstExpr.BinaryData _) ResultTcUnit.Ok]
    [(AstExpr.SpmdProgramIndex) ResultTcUnit.Ok]
    [(AstExpr.SpmdProgramCount) ResultTcUnit.Ok]
    [(AstExpr.ProgramArgc) ResultTcUnit.Ok]
    [(AstExpr.ProgramArgv) ResultTcUnit.Ok]
    [(AstExpr.ProgramEnvp) ResultTcUnit.Ok]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-policy-ok ctx leaf subleaf))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-policy-ok ctx leaf subleaf))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-policy-ok ctx leaf subleaf))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-source-expr-pair-policy-ok ctx leaf subleaf))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (tc-source-expr-policy-ok ctx index))]
    [(AstExpr.Syscall args) (tc-source-expr-list-policy-ok ctx args)]
    [_ ResultTcUnit.Ok]))

(define (tc-source-decl-policy-ok [ctx : TcContext] [decl : AstDecl]) : ResultTcUnit
  (match decl
    [(AstDecl.Def _ maybe-ty expr-box)
      (let
        [expr : AstExpr (ast-node-get expr-box)]
        (match (tc-source-maybe-type-policy-ok ctx maybe-ty)
          [(ResultTcUnit.Ok)
            (if (tc-maybe-type-contains-reference? maybe-ty)
              (ResultTcUnit.Err
                "typecheck: storing references in top-level values requires lifetime support (#804)")
              (match (tc-source-expr-policy-ok ctx expr)
                [(ResultTcUnit.Ok)
                  (tc-source-expr-spmd-broadcast-scope-ok expr false)]
                [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstDecl.DefFn _ params ret body-box _)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (match (tc-source-param-list-policy-ok ctx params)
          [(ResultTcUnit.Ok)
            (match (tc-source-type-policy-ok ctx ret)
              [(ResultTcUnit.Ok)
                (match (tc-reference-return-policy-ok ctx params ret)
                  [(ResultTcUnit.Ok)
                    (match (tc-source-expr-policy-ok ctx body)
                      [(ResultTcUnit.Ok)
                        (tc-source-expr-spmd-broadcast-scope-ok body false)]
                      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstDecl.DefMacro _ params ret body-box)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (match (tc-source-macro-param-list-policy-ok ctx params)
          [(ResultTcUnit.Ok)
            (match (tc-source-macro-result-policy-ok ctx ret)
              [(ResultTcUnit.Ok)
                (match (tc-source-expr-policy-ok ctx body)
                  [(ResultTcUnit.Ok)
                    (tc-source-expr-spmd-broadcast-scope-ok body false)]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstDecl.Extern _ _ _ ty) (tc-source-type-policy-ok ctx ty)]
    [(AstDecl.DefEnum name _ variants)
      (match (tc-source-variant-list-policy-ok ctx variants)
        [(ResultTcUnit.Ok)
          (tc-source-default-aggregate-layout-finite-ok ctx (intern-str name))]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [(AstDecl.DefEnumLifetimes name lifetimes _ variants)
      (if (tc-lifetime-list-duplicates? lifetimes)
        (ResultTcUnit.Err "typecheck: duplicate lifetime parameter")
        (match (tc-source-variant-list-lifetimes-policy-ok
          ctx
          lifetimes
          variants)
          [(ResultTcUnit.Ok)
            (tc-source-default-aggregate-layout-finite-ok ctx (intern-str name))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstDecl.DefStruct name repr cleanup fields)
      (match (tc-source-field-list-policy-ok ctx fields)
        [(ResultTcUnit.Ok)
          (if (and (ast-struct-repr-c? repr) (ast-struct-cleanup? cleanup))
            (ResultTcUnit.Err
              (tc-struct-cleanup-repr-c-message
                (compiler-symbol-module-key
                  (tc-context-module ctx)
                  (intern-str name))))
            (tc-source-default-struct-layout-finite-ok
              ctx
              (intern-str name)
              repr))]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [(AstDecl.DefStructLifetimes name lifetimes repr cleanup fields)
      (if (tc-lifetime-list-duplicates? lifetimes)
        (ResultTcUnit.Err "typecheck: duplicate lifetime parameter")
        (match (tc-source-field-list-lifetimes-policy-ok ctx lifetimes fields)
          [(ResultTcUnit.Ok)
            (if (and (ast-struct-repr-c? repr) (ast-struct-cleanup? cleanup))
              (ResultTcUnit.Err
                (tc-struct-cleanup-repr-c-message
                  (compiler-symbol-module-key
                    (tc-context-module ctx)
                    (intern-str name))))
              (tc-source-default-struct-layout-finite-ok
                ctx
                (intern-str name)
                repr))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstDecl.DefDispatch _ _) ResultTcUnit.Ok]
    [(AstDecl.IncludeStr _ _)
      (ResultTcUnit.Err
        "typecheck: include-str must be expanded by compiler loader")]
    [(AstDecl.IncludeBin _ _)
      (ResultTcUnit.Err
        "typecheck: include-bin must be expanded by compiler loader")]
    [(AstDecl.Import _) ResultTcUnit.Ok]
    [(AstDecl.Module _) ResultTcUnit.Ok]
    [(AstDecl.ModuleBody name body-box)
      (tc-source-decl-list-policy-ok-in-module
        (tc-context-with-module ctx (intern-str name))
        (box-get body-box)
        (intern-str name))]
    [(AstDecl.Test _ body-box _)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (tc-source-expr-policy-ok ctx body))]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (tc-source-decl-policy-ok ctx inner))]
    [(AstDecl.ComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (tc-source-decl-policy-ok ctx template))]))

(define (tc-source-decl-list-policy-ok [ctx : TcContext] [decls : AstDeclList]) : ResultTcUnit
  (tc-source-decl-list-policy-ok-in-module ctx decls ""))

(define (tc-source-decl-list-policy-ok-in-module
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]) : ResultTcUnit
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) ResultTcUnit.Ok]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        (match decl
          [(AstDecl.Module next-module)
            (tc-source-decl-list-policy-ok-in-module
              ctx
              rest
              (intern-str next-module))]
          [_
            (match (tc-source-decl-policy-ok
              (tc-context-with-module ctx module)
              decl)
              [(ResultTcUnit.Ok)
                (tc-source-decl-list-policy-ok-in-module ctx rest module)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]))]))

(define (tc-program-source-types-policy-ok
  [ctx : TcContext]
  [program : AstProgram]) : ResultTcUnit
  (begin
    (tc-nominal-owner-cache-reset!)
    (match program
      [(AstProgram.Program decls-box)
        (let
          [decls : AstDeclList (box-get decls-box)]
          (tc-source-decl-list-policy-ok ctx decls))])))

(define (tc-type-list-eq [a : AstTypeList] [b : AstTypeList]) : bool
  (and
    (= (ast-type-list-len (& a)) (ast-type-list-len (& b)))
    (tc-type-list-eq-at? (& a) (& b) 0)))

(define (tc-type-list-eq-at?
  [a : (& a AstTypeList)]
  [b : (& b AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len a))
    true
    (and
      (tc-type-eq
        (ty-node-get (ast-type-list-get a index (ast-type-id-fallback)))
        (ty-node-get (ast-type-list-get b index (ast-type-id-fallback))))
      (tc-type-list-eq-at? a b (+ index 1)))))

(define (tc-type-eq-core [a : AstType] [b : AstType]) : bool
  (match a
    [(AstType.I64)
      (match b
        [(AstType.I64) true]
        [_ false])]
    [(AstType.I32)
      (match b
        [(AstType.I32) true]
        [_ false])]
    [(AstType.I16)
      (match b
        [(AstType.I16) true]
        [_ false])]
    [(AstType.I8)
      (match b
        [(AstType.I8) true]
        [_ false])]
    [(AstType.U64)
      (match b
        [(AstType.U64) true]
        [_ false])]
    [(AstType.U32)
      (match b
        [(AstType.U32) true]
        [_ false])]
    [(AstType.U16)
      (match b
        [(AstType.U16) true]
        [_ false])]
    [(AstType.U8)
      (match b
        [(AstType.U8) true]
        [_ false])]
    [(AstType.F64)
      (match b
        [(AstType.F64) true]
        [_ false])]
    [(AstType.F32)
      (match b
        [(AstType.F32) true]
        [_ false])]
    [(AstType.Bool)
      (match b
        [(AstType.Bool) true]
        [_ false])]
    [(AstType.Char)
      (match b
        [(AstType.Char) true]
        [_ false])]
    [(AstType.String)
      (match b
        [(AstType.String) true]
        [_ false])]
    [(AstType.Str)
      (match b
        [(AstType.Str) true]
        [_ false])]
    [(AstType.Bytes)
      (match b
        [(AstType.Bytes) true]
        [_ false])]
    [(AstType.Unit)
      (match b
        [(AstType.Unit) true]
        [_ false])]
    [(AstType.Never)
      (match b
        [(AstType.Never) true]
        [_ false])]
    [(AstType.Expr)
      (match b
        [(AstType.Expr) true]
        [_ false])]
    [(AstType.ExprList)
      (match b
        [(AstType.ExprList) true]
        [_ false])]
    [(AstType.Func a-args a-ret)
      (match b
        [(AstType.Func b-args b-ret)
          (and
            (tc-type-list-eq (box-get a-args) (box-get b-args))
            (tc-type-eq (ty-node-get a-ret) (ty-node-get b-ret)))]
        [_ false])]
    [(AstType.Tuple a-elems)
      (match b
        [(AstType.Tuple b-elems)
          (tc-type-list-eq (box-get a-elems) (box-get b-elems))]
        [_ false])]
    [(AstType.Array a-elem a-len)
      (match b
        [(AstType.Array b-elem b-len)
          (and
            (= a-len b-len)
            (tc-type-eq (ty-node-get a-elem) (ty-node-get b-elem)))]
        [_ false])]
    [(AstType.DynArray a-elem)
      (match b
        [(AstType.DynArray b-elem)
          (tc-type-eq (ty-node-get a-elem) (ty-node-get b-elem))]
        [_ false])]
    [(AstType.Box a-elem)
      (match b
        [(AstType.Box b-elem)
          (tc-type-eq (ty-node-get a-elem) (ty-node-get b-elem))]
        [_ false])]
    [(AstType.Ptr a-elem)
      (match b
        [(AstType.Ptr b-elem)
          (tc-type-eq (ty-node-get a-elem) (ty-node-get b-elem))]
        [_ false])]
    [(AstType.MutPtr a-elem)
      (match b
        [(AstType.MutPtr b-elem)
          (tc-type-eq (ty-node-get a-elem) (ty-node-get b-elem))]
        [_ false])]
    [(AstType.Ref a-region a-inner)
      (match b
        [(AstType.Ref b-region b-inner)
          (and
            (string.eq a-region b-region)
            (tc-type-eq (ty-node-get a-inner) (ty-node-get b-inner)))]
        [_ false])]
    [(AstType.MutRef a-region a-inner)
      (match b
        [(AstType.MutRef b-region b-inner)
          (and
            (string.eq a-region b-region)
            (tc-type-eq (ty-node-get a-inner) (ty-node-get b-inner)))]
        [_ false])]
    [(AstType.Region _ inner)
      (tc-type-eq-core
        (tc-type-without-regions (ty-node-get inner))
        (tc-type-without-regions b))]
    [(AstType.Enum a-name)
      (match b
        [(AstType.Enum b-name) (= a-name b-name)]
        [_ false])]
    [(AstType.EnumArgs a-name a-lifetimes)
      (match b
        [(AstType.EnumArgs b-name b-lifetimes)
          (and
            (= a-name b-name)
            (tc-lifetime-list-eq (box-get a-lifetimes) (box-get b-lifetimes)))]
        [_ false])]
    [(AstType.Struct a-name)
      (match b
        [(AstType.Struct b-name) (= a-name b-name)]
        [_ false])]
    [(AstType.StructArgs a-name a-lifetimes)
      (match b
        [(AstType.StructArgs b-name b-lifetimes)
          (and
            (= a-name b-name)
            (tc-lifetime-list-eq (box-get a-lifetimes) (box-get b-lifetimes)))]
        [_ false])]
    [(AstType.Var a-name)
      (match b
        [(AstType.Var b-name) (= a-name b-name)]
        [_ false])]
    [(AstType.VarArgs a-name a-lifetimes)
      (match b
        [(AstType.VarArgs b-name b-lifetimes)
          (and
            (= a-name b-name)
            (tc-lifetime-list-eq (box-get a-lifetimes) (box-get b-lifetimes)))]
        [_ false])]))

(define (tc-type-eq [a : AstType] [b : AstType]) : bool
  (match a
    [(AstType.Region _ inner) (tc-type-eq (ty-node-get inner) b)]
    [_
      (match b
        [(AstType.Region _ inner) (tc-type-eq a (ty-node-get inner))]
        [_ (tc-type-eq-core a b)])]))

(define (tc-never-type? [ty : AstType]) : bool
  (match ty
    [(AstType.Never) true]
    [_ false]))

(define (tc-f32-to-f64-compatible? [expected : AstType] [actual : AstType]) : bool
  (match (tc-type-strip-region expected)
    [(AstType.F64)
      (match (tc-type-strip-region actual)
        [(AstType.F32) true]
        [_ false])]
    [_ false]))

(define (tc-type-compatible? [expected : AstType] [actual : AstType]) : bool
  (if (tc-never-type? actual)
    true
    (if (tc-type-eq expected actual)
      true
      (tc-f32-to-f64-compatible? expected actual))))

(define (tc-merge-branch-type [a : AstType] [b : AstType]) : ResultTcType
  (cond
    [(tc-never-type? a) (ResultTcType.Ok b)]
    [(tc-never-type? b) (ResultTcType.Ok a)]
    [(tc-type-eq a b)
      (let
        [a-regions : TcStringList (tc-type-collect-regions a)]
        [b-regions : TcStringList (tc-type-collect-regions b)]
        (if (tc-string-list-eq a-regions b-regions)
          (ResultTcType.Ok a)
          (match a-regions
            [(TcStringList.Nil) (ResultTcType.Ok b)]
            [_
              (match b-regions
                [(TcStringList.Nil) (ResultTcType.Ok a)]
                [_ (ResultTcType.Err "typecheck: if branches must match")])])))]
    [(tc-type-compatible? a b) (ResultTcType.Ok a)]
    [(tc-type-compatible? b a) (ResultTcType.Ok b)]
    [else (ResultTcType.Err "typecheck: if branches must match")]))

(define (tc-match-arm-merge-message [previous : AstType] [current : AstType]) : String
  (string.append
    "typecheck: match arms must agree: previous arm type "
    (string.append
      (tc-type-render previous)
      (string.append ", current arm type " (tc-type-render current)))))

(define (tc-integer-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.I64) true]
    [(AstType.I32) true]
    [(AstType.I16) true]
    [(AstType.I8) true]
    [(AstType.U64) true]
    [(AstType.U32) true]
    [(AstType.U16) true]
    [(AstType.U8) true]
    [_ false]))

(define (tc-repeat-text [piece : String] [count : i64]) : String
  (let
    [out : String ""]
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (set! out (string.concat3 out piece ""))
          (set! i (+ i 1))))
      out)))

(define (tc-binary-ones [bits : i64]) : String
  (tc-repeat-text "1" bits))

(define (tc-binary-min-signed [bits : i64]) : String
  (string.append "1" (tc-repeat-text "0" (- bits 1))))

(define (tc-integer-literal-fits-positive-type? [text : String] [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.I8)
      (ast-int-literal-magnitude-fits-limit? text "127" "7f" (tc-binary-ones 7))]
    [(AstType.I16)
      (ast-int-literal-magnitude-fits-limit?
        text
        "32767"
        "7fff"
        (tc-binary-ones 15))]
    [(AstType.I32)
      (ast-int-literal-magnitude-fits-limit?
        text
        "2147483647"
        "7fffffff"
        (tc-binary-ones 31))]
    [(AstType.I64)
      (ast-int-literal-magnitude-fits-limit?
        text
        "9223372036854775807"
        "7fffffffffffffff"
        (tc-binary-ones 63))]
    [(AstType.U8)
      (ast-int-literal-magnitude-fits-limit? text "255" "ff" (tc-binary-ones 8))]
    [(AstType.U16)
      (ast-int-literal-magnitude-fits-limit?
        text
        "65535"
        "ffff"
        (tc-binary-ones 16))]
    [(AstType.U32)
      (ast-int-literal-magnitude-fits-limit?
        text
        "4294967295"
        "ffffffff"
        (tc-binary-ones 32))]
    [(AstType.U64)
      (ast-int-literal-magnitude-fits-limit?
        text
        "18446744073709551615"
        "ffffffffffffffff"
        (tc-binary-ones 64))]
    [_ false]))

(define (tc-integer-literal-fits-negative-type? [text : String] [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.I8)
      (ast-int-literal-magnitude-fits-limit?
        text
        "128"
        "80"
        (tc-binary-min-signed 8))]
    [(AstType.I16)
      (ast-int-literal-magnitude-fits-limit?
        text
        "32768"
        "8000"
        (tc-binary-min-signed 16))]
    [(AstType.I32)
      (ast-int-literal-magnitude-fits-limit?
        text
        "2147483648"
        "80000000"
        (tc-binary-min-signed 32))]
    [(AstType.I64)
      (ast-int-literal-magnitude-fits-limit?
        text
        "9223372036854775808"
        "8000000000000000"
        (tc-binary-min-signed 64))]
    [_ false]))

(define (tc-integer-literal-fits-type? [text : String] [ty : AstType]) : bool
  (if (ast-int-literal-negative? text)
    (tc-integer-literal-fits-negative-type? text ty)
    (tc-integer-literal-fits-positive-type? text ty)))

(define (tc-integer-literal-value-fits-type? [value : i64] [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.I8) (and (>= value -128) (<= value 127))]
    [(AstType.I16) (and (>= value -32768) (<= value 32767))]
    [(AstType.I32) (and (>= value -2147483648) (<= value 2147483647))]
    [(AstType.I64) true]
    [(AstType.U8) (and (>= value 0) (<= value 255))]
    [(AstType.U16) (and (>= value 0) (<= value 65535))]
    [(AstType.U32) (and (>= value 0) (<= value 4294967295))]
    [(AstType.U64) (>= value 0)]
    [_ false]))

(define (tc-integer-literal-fits-value-or-text?
  [value : i64]
  [text : String]
  [ty : AstType]) : bool
  (if (> (string.string-length text) 0)
    (tc-integer-literal-fits-type? text ty)
    (tc-integer-literal-value-fits-type? value ty)))

(define (tc-integer-literal-render [value : i64] [text : String]) : String
  (if (> (string.string-length text) 0)
    text
    (string.int->string value)))

(define (tc-integer-literal-range-message
  [ctx : TcContext]
  [value : i64]
  [text : String]
  [expected : AstType]) : String
  (str_cat.str-cat
    "typecheck: integer literal "
    (tc-integer-literal-render value text)
    " does not fit expected type "
    (tc-type-render (tc-type-without-regions (tc-resolve-type ctx expected)))))

(define (tc-integer-literal-type-with-expected
  [ctx : TcContext]
  [value : i64]
  [text : String]
  [expected : AstType]) : ResultTcType
  (let
    [resolved : AstType
      (tc-type-without-regions (tc-resolve-type ctx expected))]
    (if (tc-integer-type? resolved)
      (if (tc-integer-literal-fits-value-or-text? value text resolved)
        (ResultTcType.Ok resolved)
        (ResultTcType.Err
          (tc-integer-literal-range-message ctx value text expected)))
      (ResultTcType.Ok (AstType.I32)))))

(define (tc-float-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.F64) true]
    [(AstType.F32) true]
    [_ false]))

;; Word-class for register-resident aggregates (#2386): a POD type that occupies
;; at most one machine word and is trivially copyable by value. Integers, bool,
;; char, and raw pointers qualify. Floats are excluded (a register-resident
;; aggregate is packed into general-purpose words). Owning handles (Box, String,
;; Array, DynArray), references, closures, tuples, and nested struct/enum fields
;; are excluded too: they would need deep-clone or multi-word handling that the
;; word-copy representation does not provide.
(define (tc-word-class-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.I64) true]
    [(AstType.U64) true]
    [(AstType.I32) true]
    [(AstType.U32) true]
    [(AstType.I16) true]
    [(AstType.U16) true]
    [(AstType.I8) true]
    [(AstType.U8) true]
    [(AstType.Bool) true]
    [(AstType.Char) true]
    [(AstType.Ptr _) true]
    [(AstType.MutPtr _) true]
    [_ false]))

(define (tc-ordered-comparison-type? [ty : AstType]) : bool
  (if (tc-integer-type? ty)
    true
    (if (tc-float-type? ty)
      true
      (match (tc-type-strip-region ty)
        [(AstType.Char) true]
        [_ false]))))

(define (tc-castable-type? [ty : AstType]) : bool
  (if (tc-integer-type? ty)
    true
    (match (tc-type-strip-region ty)
      [(AstType.Char) true]
      [(AstType.F64) true]
      [(AstType.F32) true]
      [_ false])))

(define (tc-function-to-integer-cast? [from-ty : AstType] [to-ty : AstType]) : bool
  (match (tc-type-strip-region from-ty)
    [(AstType.Func _ _) (tc-integer-type? (tc-type-strip-region to-ty))]
    [_ false]))

(define (tc-raw-pointer-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Ptr _) true]
    [(AstType.MutPtr _) true]
    [_ false]))

(define (tc-type-move-kind [ty : AstType]) : TcMoveKind
  (match ty
    [(AstType.I64) (TcMoveKind.Copyable)]
    [(AstType.I32) (TcMoveKind.Copyable)]
    [(AstType.I16) (TcMoveKind.Copyable)]
    [(AstType.I8) (TcMoveKind.Copyable)]
    [(AstType.U64) (TcMoveKind.Copyable)]
    [(AstType.U32) (TcMoveKind.Copyable)]
    [(AstType.U16) (TcMoveKind.Copyable)]
    [(AstType.U8) (TcMoveKind.Copyable)]
    [(AstType.F64) (TcMoveKind.Copyable)]
    [(AstType.F32) (TcMoveKind.Copyable)]
    [(AstType.Bool) (TcMoveKind.Copyable)]
    [(AstType.Char) (TcMoveKind.Copyable)]
    [(AstType.Unit) (TcMoveKind.Copyable)]
    [(AstType.Never) (TcMoveKind.Copyable)]
    [(AstType.Expr) (TcMoveKind.Copyable)]
    [(AstType.ExprList) (TcMoveKind.Copyable)]
    [(AstType.Func _ _) (TcMoveKind.Copyable)]
    [(AstType.Ptr _) (TcMoveKind.Copyable)]
    [(AstType.MutPtr _) (TcMoveKind.Copyable)]
    [(AstType.Ref _ _) (TcMoveKind.Copyable)]
    [(AstType.Region _ inner) (tc-type-move-kind (ty-node-get inner))]
    [(AstType.String) (TcMoveKind.MoveOnly)]
    [(AstType.Str) (TcMoveKind.MoveOnly)]
    [(AstType.Bytes) (TcMoveKind.MoveOnly)]
    [(AstType.Tuple _) (TcMoveKind.MoveOnly)]
    [(AstType.Array _ _) (TcMoveKind.MoveOnly)]
    [(AstType.DynArray _) (TcMoveKind.MoveOnly)]
    [(AstType.Box _) (TcMoveKind.MoveOnly)]
    [(AstType.MutRef _ _) (TcMoveKind.MoveOnly)]
    [(AstType.Enum _) (TcMoveKind.MoveOnly)]
    [(AstType.EnumArgs _ _) (TcMoveKind.MoveOnly)]
    [(AstType.Struct _) (TcMoveKind.MoveOnly)]
    [(AstType.StructArgs _ _) (TcMoveKind.MoveOnly)]
    [(AstType.Var _) (TcMoveKind.MoveOnly)]
    [(AstType.VarArgs _ _) (TcMoveKind.MoveOnly)]))

(define (tc-move-kind-copyable? [kind : TcMoveKind]) : bool
  (match kind
    [(TcMoveKind.Copyable) true]
    [(TcMoveKind.MoveOnly) false]))

(define (tc-type-copyable? [ty : AstType]) : bool
  (tc-move-kind-copyable? (tc-type-move-kind ty)))

(define (tc-type-move-only? [ty : AstType]) : bool
  (not (tc-type-copyable? ty)))

(define (tc-raw-pointer-elem [ty : AstType] [message : String]) : ResultTcType
  (match (tc-type-strip-region ty)
    [(AstType.Ptr elem) (ResultTcType.Ok (ty-node-get elem))]
    [(AstType.MutPtr elem) (ResultTcType.Ok (ty-node-get elem))]
    [_ (ResultTcType.Err message)]))

(define (tc-mut-pointer-elem [ty : AstType] [message : String]) : ResultTcType
  (match (tc-type-strip-region ty)
    [(AstType.MutPtr elem) (ResultTcType.Ok (ty-node-get elem))]
    [_ (ResultTcType.Err message)]))

(define (tc-atomic-pointer-name? [name : String]) : bool
  (or
    (string.eq name "atomic-load")
    (string.eq name "atomic-store!")
    (string.eq name "atomic-add!")
    (string.eq name "atomic-fetch-add!")
    (string.eq name "atomic-cas!")))

(define (tc-atomic-load-name? [name : String]) : bool
  (string.eq name "atomic-load"))

(define (tc-atomic-store-name? [name : String]) : bool
  (string.eq name "atomic-store!"))

(define (tc-atomic-cas-name? [name : String]) : bool
  (string.eq name "atomic-cas!"))

(define (tc-atomic-elem-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.I64) true]
    [(AstType.U64) true]
    [(AstType.I32) true]
    [(AstType.U32) true]
    [_ false]))

(define (tc-atomic-check-elem [elem : AstType]) : ResultTcType
  (let
    [resolved : AstType (tc-type-strip-region elem)]
    (if (tc-atomic-elem-type? resolved)
      (ResultTcType.Ok resolved)
      (ResultTcType.Err
        "typecheck: atomic pointer element must be i32, i64, u32, or u64"))))

(define (tc-atomic-pointer-elem
  [ctx : TcContext]
  [name : String]
  [ptr-ty : AstType]) : ResultTcType
  (if (tc-atomic-load-name? name)
    (match (tc-raw-pointer-elem
      (tc-resolve-type ctx ptr-ty)
      "typecheck: atomic-load requires a raw pointer operand")
      [(ResultTcType.Ok elem) (tc-atomic-check-elem (tc-resolve-type ctx elem))]
      [(ResultTcType.Err message) (ResultTcType.Err message)])
    (match (tc-mut-pointer-elem
      (tc-resolve-type ctx ptr-ty)
      (string.append
        "typecheck: "
        (string.append name " requires a MutPtr pointer operand")))
      [(ResultTcType.Ok elem) (tc-atomic-check-elem (tc-resolve-type ctx elem))]
      [(ResultTcType.Err message) (ResultTcType.Err message)])))

(define (tc-atomic-check-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [value : AstExpr]
  [elem : AstType]
  [message : String]) : ResultTcUnit
  (match (tc-expr-with-expected-or-actual ctx env value elem)
    [(ResultTcType.Ok value-ty) (tc-expect value-ty elem message)]
    [(ResultTcType.Err message) (ResultTcUnit.Err message)]))

(define (tc-atomic-one-arg-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [ptr : AstExpr]
  [rest : AstExprList]) : ResultTcType
  (if (ast-expr-list-empty? (& rest))
    (match (tc-expr ctx env ptr)
      [(ResultTcType.Ok ptr-ty)
        (match (tc-atomic-pointer-elem ctx name ptr-ty)
          [(ResultTcType.Ok elem) (ResultTcType.Ok elem)]
          [(ResultTcType.Err message) (ResultTcType.Err message)])]
      [(ResultTcType.Err message) (ResultTcType.Err message)])
    (ResultTcType.Err "typecheck: atomic-load expects exactly one argument")))

(define (tc-atomic-two-arg-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [ptr : AstExpr]
  [value : AstExpr]
  [rest : AstExprList]) : ResultTcType
  (if (ast-expr-list-empty? (& rest))
    (match (tc-expr ctx env ptr)
      [(ResultTcType.Ok ptr-ty)
        (match (tc-atomic-pointer-elem ctx name ptr-ty)
          [(ResultTcType.Ok elem)
            (match (tc-atomic-check-value
              ctx
              env
              value
              elem
              "typecheck: atomic value type mismatch")
              [(ResultTcUnit.Ok)
                (if (tc-atomic-store-name? name)
                  (ResultTcType.Ok (AstType.Unit))
                  (if (string.eq name "atomic-add!")
                    (ResultTcType.Ok (AstType.Unit))
                    (ResultTcType.Ok elem)))]
              [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
          [(ResultTcType.Err message) (ResultTcType.Err message)])]
      [(ResultTcType.Err message) (ResultTcType.Err message)])
    (ResultTcType.Err "typecheck: atomic update expects exactly two arguments")))

(define (tc-atomic-cas-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ptr : AstExpr]
  [expected : AstExpr]
  [new-value : AstExpr]
  [rest : AstExprList]) : ResultTcType
  (if (ast-expr-list-empty? (& rest))
    (match (tc-expr ctx env ptr)
      [(ResultTcType.Ok ptr-ty)
        (match (tc-atomic-pointer-elem ctx "atomic-cas!" ptr-ty)
          [(ResultTcType.Ok elem)
            (match (tc-atomic-check-value
              ctx
              env
              expected
              elem
              "typecheck: atomic expected value type mismatch")
              [(ResultTcUnit.Ok)
                (match (tc-atomic-check-value
                  ctx
                  env
                  new-value
                  elem
                  "typecheck: atomic new value type mismatch")
                  [(ResultTcUnit.Ok) (ResultTcType.Ok elem)]
                  [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
          [(ResultTcType.Err message) (ResultTcType.Err message)])]
      [(ResultTcType.Err message) (ResultTcType.Err message)])
    (ResultTcType.Err "typecheck: atomic-cas! expects exactly three arguments")))

(define (tc-atomic-nonload-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [ptr : AstExpr]
  [tail0 : AstExprList]) : ResultTcType
  (if (> (struct-get (& tail0) len) 0)
    (let
      [value : AstExpr (ast-node-get (ast-expr-list-get (& tail0) 0 0))]
      [tail1 : AstExprList (ast-expr-list-tail-from-ref (& tail0) 1)]
      (if (tc-atomic-cas-name? name)
        (if (> (struct-get (& tail1) len) 0)
          (tc-atomic-cas-call
            ctx
            env
            ptr
            value
            (ast-node-get (ast-expr-list-get (& tail1) 0 0))
            (ast-expr-list-tail-from-ref (& tail1) 1))
          (ResultTcType.Err
            "typecheck: atomic-cas! expects exactly three arguments"))
        (tc-atomic-two-arg-call ctx env name ptr value tail1)))
    (ResultTcType.Err
      (if (tc-atomic-cas-name? name)
        "typecheck: atomic-cas! expects exactly three arguments"
        "typecheck: atomic update expects exactly two arguments"))))

(define (tc-atomic-pointer-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [args : AstExprList]) : ResultTcType
  (match (tc-require-unsafe env name)
    [(ResultTcUnit.Ok)
      (if (> (struct-get (& args) len) 0)
        (let
          [ptr : AstExpr (ast-node-get (ast-expr-list-get (& args) 0 0))]
          [tail0 : AstExprList (ast-expr-list-tail-from-ref (& args) 1)]
          (if (tc-atomic-load-name? name)
            (tc-atomic-one-arg-call ctx env name ptr tail0)
            (tc-atomic-nonload-call ctx env name ptr tail0)))
        (ResultTcType.Err
          (if (tc-atomic-load-name? name)
            "typecheck: atomic-load expects exactly one argument"
            (if (tc-atomic-cas-name? name)
              "typecheck: atomic-cas! expects exactly three arguments"
              "typecheck: atomic update expects exactly two arguments"))))]
    [(ResultTcUnit.Err message) (ResultTcType.Err message)]))

(define (tc-ptr-addr-of-cell-type-ok? [ty : AstType]) : bool
  (if (tc-integer-type? ty)
    true
    (match (tc-type-strip-region ty)
      [(AstType.F64) true]
      [(AstType.F32) true]
      [(AstType.Bool) true]
      [(AstType.Char) true]
      [(AstType.Ptr _) true]
      [(AstType.MutPtr _) true]
      [_ false])))

(define (tc-ptr-addr-of-local-lookup [env : TcTypeEnv] [name : String]) : ResultTcType
  (match env
    [(TcTypeEnv.Nil)
      (ResultTcType.Err
        "typecheck: ptr-addr-of requires a local or parameter name")]
    [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
      (tc-ptr-addr-of-local-lookup (box-get rest) name)]
    [(TcTypeEnv.Bind key ty rest)
      (if (= key (tc-hygiene-global-boundary-id))
        (ResultTcType.Err
          "typecheck: ptr-addr-of requires a local or parameter name")
        (if (= key (tc-name-id name))
          (ResultTcType.Ok ty)
          (tc-ptr-addr-of-local-lookup (box-get rest) name)))]))

(define (tc-require-unsafe [env : TcTypeEnv] [name : String]) : ResultTcUnit
  (if (tc-in-unsafe? env)
    (begin
      (tc-unused-unsafe-mark-current-used!)
      ResultTcUnit.Ok)
    (ResultTcUnit.Err
      (string.append
        "typecheck: "
        (string.append name " requires unsafe context")))))

(define (tc-dyn-array-elem-list-supported?
  [env : TcTypeEnv]
  [types : AstTypeList]) : bool
  (tc-dyn-array-elem-list-supported-at? env (& types) 0))

(define (tc-dyn-array-elem-list-supported-at?
  [env : TcTypeEnv]
  [types : (& types AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len types))
    true
    (if (tc-dyn-array-elem-supported?
      env
      (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      (tc-dyn-array-elem-list-supported-at? env types (+ index 1))
      false)))

(define (tc-dyn-array-elem-supported? [env : TcTypeEnv] [ty : AstType]) : bool
  (if (tc-integer-type? ty)
    true
    (match (tc-type-strip-region ty)
      [(AstType.Bool) true]
      [(AstType.Char) true]
      [(AstType.F64) true]
      [(AstType.F32) true]
      [(AstType.String) true]
      [(AstType.Enum _) true]
      [(AstType.EnumArgs _ _) true]
      [(AstType.Struct _) true]
      [(AstType.StructArgs _ _) true]
      [(AstType.DynArray _) true]
      [(AstType.Tuple elems)
        (tc-dyn-array-elem-list-supported? env (box-get elems))]
      [(AstType.Ref _ _)
        (tc-reference-lifetimes-visible?
          env
          (tc-type-collect-reference-lifetimes ty))]
      [_ false])))

(define (tc-spmd-varying? [class : TcSpmdClass]) : bool
  (match class
    [(TcSpmdClass.Uniform) false]
    [(TcSpmdClass.Varying) true]))

(define (tc-spmd-merge-class [a : TcSpmdClass] [b : TcSpmdClass]) : TcSpmdClass
  (if (tc-spmd-varying? a)
    TcSpmdClass.Varying
    (if (tc-spmd-varying? b)
      TcSpmdClass.Varying
      TcSpmdClass.Uniform)))

(define (tc-spmd-varying-value-type-supported? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.I64) true]
    [(AstType.U64) true]
    [(AstType.I32) true]
    [(AstType.U32) true]
    [(AstType.I16) true]
    [(AstType.U16) true]
    [(AstType.I8) true]
    [(AstType.U8) true]
    [(AstType.F64) true]
    [(AstType.F32) true]
    [(AstType.Bool) true]
    [_ false]))

(define (tc-spmd-varying-expr-type-supported? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Enum _) true]
    [(AstType.EnumArgs _ _) true]
    [_ (tc-spmd-varying-value-type-supported? ty)]))

(define (tc-spmd-varying-enum-type-supported? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Enum _) true]
    [(AstType.EnumArgs _ _) true]
    [(AstType.Var name)
      (match (tc-context-enum-variants ctx (intern-str name))
        [(ResultAstVariantDefList.Ok _) true]
        [(ResultAstVariantDefList.Err _)
          (match (tc-program-enum-variants
            (tc-context-program ctx)
            (intern-str name))
            [(ResultAstVariantDefList.Ok _) true]
            [(ResultAstVariantDefList.Err _) false])])]
    [_ false]))

(define (tc-spmd-lane-type-supported? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.I64) true]
    [(AstType.U64) true]
    [(AstType.I32) true]
    [(AstType.U32) true]
    [(AstType.I16) true]
    [(AstType.U16) true]
    [(AstType.I8) true]
    [(AstType.U8) true]
    [(AstType.F64) true]
    [(AstType.F32) true]
    [(AstType.Bool) true]
    [_ false]))

(define (tc-spmd-broadcast-type-supported? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.I64) true]
    [(AstType.U64) true]
    [(AstType.I32) true]
    [(AstType.U32) true]
    [(AstType.F64) true]
    [(AstType.F32) true]
    [_ false]))

(define (tc-spmd-broadcast-type-message) : String
  "typecheck: spmd-broadcast value must have type i32, u32, i64, u64, f32, or f64; bool broadcast remains deferred")

(define (tc-spmd-shuffle-type-message) : String
  "typecheck: spmd-shuffle value must have type i32, u32, i64, u64, f32, or f64; bool shuffle remains deferred")

(define (tc-spmd-broadcast-finish
  [ctx : TcContext]
  [expr-ty : AstType]
  [value-class : TcSpmdClass]
  [lane-ty : AstType]
  [lane-class : TcSpmdClass]
  [lane-env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (if (tc-spmd-broadcast-type-supported? (tc-resolve-type ctx expr-ty))
    (match (tc-spmd-require-uniform
      lane-class
      "typecheck: spmd-broadcast lane must be uniform")
      [(ResultTcUnit.Ok)
        (match (tc-expect
          (tc-resolve-type ctx lane-ty)
          (AstType.I64)
          "typecheck: spmd-broadcast lane must have type i64")
          [(ResultTcUnit.Ok) (tc-spmd-finish expr-ty value-class lane-env)]
          [(ResultTcUnit.Err message) (ResultTcSpmdExprInfo.Err message)])]
      [(ResultTcUnit.Err message) (ResultTcSpmdExprInfo.Err message)])
    (ResultTcSpmdExprInfo.Err (tc-spmd-broadcast-type-message))))

(define (tc-spmd-shuffle-finish
  [ctx : TcContext]
  [expr-ty : AstType]
  [value-class : TcSpmdClass]
  [lane-ty : AstType]
  [lane-env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (if (tc-spmd-broadcast-type-supported? (tc-resolve-type ctx expr-ty))
    (match (tc-expect
      (tc-resolve-type ctx lane-ty)
      (AstType.I64)
      "typecheck: spmd-shuffle lane must have type i64")
      [(ResultTcUnit.Ok) (tc-spmd-finish expr-ty value-class lane-env)]
      [(ResultTcUnit.Err message) (ResultTcSpmdExprInfo.Err message)])
    (ResultTcSpmdExprInfo.Err (tc-spmd-shuffle-type-message))))

(define (tc-spmd-finish [ty : AstType] [class : TcSpmdClass] [env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (if (and
    (tc-spmd-varying? class)
    (not (tc-spmd-varying-expr-type-supported? ty)))
    (ResultTcSpmdExprInfo.Err
      (string.append
        "typecheck: foreach varying value type is not supported: "
        (tc-type-render (tc-type-strip-region ty))))
    (ResultTcSpmdExprInfo.Ok (TcSpmdExprInfo ty class env))))

(define (tc-spmd-finish-ctx
  [ctx : TcContext]
  [ty : AstType]
  [class : TcSpmdClass]
  [env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (let
    [resolved : AstType (tc-resolve-type ctx ty)]
    (if (and
      (tc-spmd-varying? class)
      (tc-spmd-varying-enum-type-supported? ctx resolved))
      (ResultTcSpmdExprInfo.Ok (TcSpmdExprInfo resolved class env))
      (tc-spmd-finish resolved class env))))

(define (tc-spmd-finish-lane
  [ctx : TcContext]
  [ty : AstType]
  [class : TcSpmdClass]
  [env : TcSpmdEnv]) : ResultTcSpmdExprInfo
  (let
    [resolved : AstType (tc-resolve-type ctx ty)]
    [supported-enum : bool (tc-spmd-varying-enum-type-supported? ctx resolved)]
    (if (and
      (tc-spmd-varying? class)
      (not (tc-spmd-lane-type-supported? resolved))
      (not supported-enum))
      (ResultTcSpmdExprInfo.Err
        (string.append
          "typecheck: foreach varying array lane type is not supported: "
          (tc-type-render (tc-type-strip-region resolved))))
      (if (and (tc-spmd-varying? class) supported-enum)
        (ResultTcSpmdExprInfo.Ok (TcSpmdExprInfo resolved class env))
        (tc-spmd-finish-ctx ctx resolved class env)))))

(define (tc-spmd-cpuid-like
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : AstType]
  [leaf : AstExpr]
  [subleaf : AstExpr]) : ResultTcSpmdExprInfo
  (match (tc-spmd-expr ctx env spmd-env leaf)
    [(ResultTcSpmdExprInfo.Ok leaf-info)
      (match leaf-info
        [(TcSpmdExprInfo _ leaf-class leaf-env)
          (match (tc-spmd-expr ctx env leaf-env subleaf)
            [(ResultTcSpmdExprInfo.Ok subleaf-info)
              (match subleaf-info
                [(TcSpmdExprInfo _ subleaf-class subleaf-env)
                  (tc-spmd-finish
                    expr-ty
                    (tc-spmd-merge-class leaf-class subleaf-class)
                    subleaf-env)])]
            [(ResultTcSpmdExprInfo.Err message)
              (ResultTcSpmdExprInfo.Err message)])])]
    [(ResultTcSpmdExprInfo.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-env-empty) : TcSpmdEnv
  (TcSpmdEnv (array.make-array TcSpmdBinding 0) 0))

(define (tc-spmd-binding
  [name : String]
  [ty : AstType]
  [class : TcSpmdClass]
  [scope : TcSpmdScope]
  [role : TcSpmdRole]) : TcSpmdBinding
  (TcSpmdBinding name ty class scope role))

(define (tc-spmd-env-binding-count [env : TcTypeEnv]) : i64
  (match env
    [(TcTypeEnv.Nil) 0]
    [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
      (tc-spmd-env-binding-count (box-get rest))]
    [(TcTypeEnv.Bind _ _ rest) (+ 1 (tc-spmd-env-binding-count (box-get rest)))]))

(define (tc-spmd-env-fill-from-type-env
  [env : TcTypeEnv]
  [bindings : (Array TcSpmdBinding)]
  [index : i64]) : unit
  (match env
    [(TcTypeEnv.Nil) unit]
    [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
      (tc-spmd-env-fill-from-type-env (box-get rest) bindings index)]
    [(TcTypeEnv.Bind name-id ty rest)
      (begin
        (array-set!
          bindings
          index
          (tc-spmd-binding
            (intern-str name-id)
            ty
            TcSpmdClass.Uniform
            TcSpmdScope.Outer
            TcSpmdRole.Value))
        (tc-spmd-env-fill-from-type-env (box-get rest) bindings (- index 1)))]))

(define (tc-spmd-env-from-type-env [env : TcTypeEnv]) : TcSpmdEnv
  (let
    [count : i64 (tc-spmd-env-binding-count env)]
    [bindings : (Array TcSpmdBinding) (array.make-array TcSpmdBinding count)]
    (begin
      (tc-spmd-env-fill-from-type-env env bindings (- count 1))
      (TcSpmdEnv bindings count))))

(define (tc-spmd-env-bindings [env : TcSpmdEnv]) : (Array TcSpmdBinding)
  (struct-get env bindings))

(define (tc-spmd-env-len [env : TcSpmdEnv]) : i64
  (struct-get env len))

(define (tc-spmd-env-mark [env : TcSpmdEnv]) : TcSpmdEnvMark
  (TcSpmdEnvMark (tc-spmd-env-len env)))

(define (tc-spmd-env-restore [env : TcSpmdEnv] [mark : TcSpmdEnvMark]) : TcSpmdEnv
  (let
    [mark-len : i64 (struct-get mark len)]
    [current-len : i64 (tc-spmd-env-len env)]
    [restored-len : i64
      (if (< mark-len 0)
        0
        (if (> mark-len current-len)
          current-len
          mark-len))]
    (TcSpmdEnv (tc-spmd-env-bindings env) restored-len)))

(define (tc-spmd-env-copy-bindings
  [dst : (Array TcSpmdBinding)]
  [src : (Array TcSpmdBinding)]
  [index : i64]
  [count : i64]) : unit
  (if (>= index count)
    unit
    (begin
      (array-set! dst index (array-ref src index))
      (tc-spmd-env-copy-bindings dst src (+ index 1) count))))

(define (tc-spmd-env-bind
  [env : TcSpmdEnv]
  [name : String]
  [ty : AstType]
  [class : TcSpmdClass]
  [scope : TcSpmdScope]) : TcSpmdEnv
  (tc-spmd-env-bind-role env name ty class scope TcSpmdRole.Value))

(define (tc-spmd-env-bind-role
  [env : TcSpmdEnv]
  [name : String]
  [ty : AstType]
  [class : TcSpmdClass]
  [scope : TcSpmdScope]
  [role : TcSpmdRole]) : TcSpmdEnv
  (let
    [old-len : i64 (tc-spmd-env-len env)]
    [old-bindings : (Array TcSpmdBinding) (tc-spmd-env-bindings env)]
    [new-len : i64 (+ old-len 1)]
    [new-bindings : (Array TcSpmdBinding)
      (array.make-array TcSpmdBinding new-len)]
    (begin
      (tc-spmd-env-copy-bindings new-bindings old-bindings 0 old-len)
      (array-set!
        new-bindings
        old-len
        (tc-spmd-binding name ty class scope role))
      (TcSpmdEnv new-bindings new-len))))

(define (tc-spmd-env-lookup-from
  [bindings : (Array TcSpmdBinding)]
  [index : i64]
  [name : String]) : TcSpmdLookup
  (if (< index 0)
    TcSpmdLookup.Missing
    (let
      [binding : TcSpmdBinding (array-ref bindings index)]
      (if (string.eq (struct-get binding name) name)
        (TcSpmdLookup.Found
          (struct-get binding ty)
          (struct-get binding class)
          (struct-get binding scope)
          (struct-get binding role))
        (tc-spmd-env-lookup-from bindings (- index 1) name)))))

(define (tc-spmd-env-lookup [env : TcSpmdEnv] [name : String]) : TcSpmdLookup
  (tc-spmd-env-lookup-from
    (tc-spmd-env-bindings env)
    (- (tc-spmd-env-len env) 1)
    name))

(define (tc-spmd-env-has-local-from?
  [bindings : (Array TcSpmdBinding)]
  [index : i64]
  [name : String]) : bool
  (if (< index 0)
    false
    (let
      [binding : TcSpmdBinding (array-ref bindings index)]
      (if (string.eq (struct-get binding name) name)
        (match (struct-get binding scope)
          [(TcSpmdScope.Local) true]
          [(TcSpmdScope.Outer)
            (tc-spmd-env-has-local-from? bindings (- index 1) name)])
        (tc-spmd-env-has-local-from? bindings (- index 1) name)))))

(define (tc-spmd-env-has-local? [env : TcSpmdEnv] [name : String]) : bool
  (tc-spmd-env-has-local-from?
    (tc-spmd-env-bindings env)
    (- (tc-spmd-env-len env) 1)
    name))

(define (tc-spmd-env-has-outer-from?
  [bindings : (Array TcSpmdBinding)]
  [index : i64]
  [name : String]) : bool
  (if (< index 0)
    false
    (let
      [binding : TcSpmdBinding (array-ref bindings index)]
      (if (string.eq (struct-get binding name) name)
        (match (struct-get binding scope)
          [(TcSpmdScope.Outer) true]
          [(TcSpmdScope.Local)
            (tc-spmd-env-has-outer-from? bindings (- index 1) name)])
        (tc-spmd-env-has-outer-from? bindings (- index 1) name)))))

(define (tc-spmd-env-has-outer? [env : TcSpmdEnv] [name : String]) : bool
  (tc-spmd-env-has-outer-from?
    (tc-spmd-env-bindings env)
    (- (tc-spmd-env-len env) 1)
    name))

(define (tc-spmd-env-local-index
  [bindings : (Array TcSpmdBinding)]
  [index : i64]
  [name : String]) : i64
  (if (< index 0)
    -1
    (let
      [binding : TcSpmdBinding (array-ref bindings index)]
      (if (string.eq (struct-get binding name) name)
        (match (struct-get binding scope)
          [(TcSpmdScope.Local) index]
          [(TcSpmdScope.Outer)
            (tc-spmd-env-local-index bindings (- index 1) name)])
        (tc-spmd-env-local-index bindings (- index 1) name)))))

(define (tc-spmd-env-set-local-class
  [env : TcSpmdEnv]
  [name : String]
  [class : TcSpmdClass]) : TcSpmdEnv
  (let
    [old-len : i64 (tc-spmd-env-len env)]
    [old-bindings : (Array TcSpmdBinding) (tc-spmd-env-bindings env)]
    [local-index : i64
      (tc-spmd-env-local-index old-bindings (- old-len 1) name)]
    (if (< local-index 0)
      env
      (let
        [new-bindings : (Array TcSpmdBinding)
          (array.make-array TcSpmdBinding old-len)]
        [old-binding : TcSpmdBinding (array-ref old-bindings local-index)]
        (begin
          (tc-spmd-env-copy-bindings new-bindings old-bindings 0 old-len)
          (array-set!
            new-bindings
            local-index
            (tc-spmd-binding
              (struct-get old-binding name)
              (struct-get old-binding ty)
              class
              (struct-get old-binding scope)
              (struct-get old-binding role)))
          (TcSpmdEnv new-bindings old-len))))))

(define (tc-spmd-env-pop [env : TcSpmdEnv] [count : i64]) : TcSpmdEnv
  (if (<= count 0)
    env
    (tc-spmd-env-restore env (TcSpmdEnvMark (- (tc-spmd-env-len env) count)))))

(define (tc-spmd-env-mark-outer-into
  [dst : (Array TcSpmdBinding)]
  [src : (Array TcSpmdBinding)]
  [index : i64]
  [count : i64]) : unit
  (if (>= index count)
    unit
    (let
      [binding : TcSpmdBinding (array-ref src index)]
      (begin
        (array-set!
          dst
          index
          (tc-spmd-binding
            (struct-get binding name)
            (struct-get binding ty)
            (struct-get binding class)
            TcSpmdScope.Outer
            (struct-get binding role)))
        (tc-spmd-env-mark-outer-into dst src (+ index 1) count)))))

(define (tc-spmd-env-mark-outer [env : TcSpmdEnv]) : TcSpmdEnv
  (let
    [old-len : i64 (tc-spmd-env-len env)]
    [old-bindings : (Array TcSpmdBinding) (tc-spmd-env-bindings env)]
    [new-bindings : (Array TcSpmdBinding)
      (array.make-array TcSpmdBinding old-len)]
    (begin
      (tc-spmd-env-mark-outer-into new-bindings old-bindings 0 old-len)
      (TcSpmdEnv new-bindings old-len))))

(define (tc-spmd-env-merge-binding-class
  [left : TcSpmdBinding]
  [right-bindings : (Array TcSpmdBinding)]
  [right-len : i64]
  [index : i64]) : TcSpmdClass
  (if (>= index right-len)
    (struct-get left class)
    (let
      [right : TcSpmdBinding (array-ref right-bindings index)]
      (tc-spmd-merge-class (struct-get left class) (struct-get right class)))))

(define (tc-spmd-env-merge-classes-into
  [dst : (Array TcSpmdBinding)]
  [left-bindings : (Array TcSpmdBinding)]
  [right-bindings : (Array TcSpmdBinding)]
  [left-len : i64]
  [right-len : i64]
  [index : i64]) : unit
  (if (>= index left-len)
    unit
    (let
      [left : TcSpmdBinding (array-ref left-bindings index)]
      (begin
        (array-set!
          dst
          index
          (tc-spmd-binding
            (struct-get left name)
            (struct-get left ty)
            (tc-spmd-env-merge-binding-class
              left
              right-bindings
              right-len
              index)
            (struct-get left scope)
            (struct-get left role)))
        (tc-spmd-env-merge-classes-into
          dst
          left-bindings
          right-bindings
          left-len
          right-len
          (+ index 1))))))

(define (tc-spmd-env-merge-classes [left : TcSpmdEnv] [right : TcSpmdEnv]) : TcSpmdEnv
  (let
    [left-len : i64 (tc-spmd-env-len left)]
    [right-len : i64 (tc-spmd-env-len right)]
    [left-bindings : (Array TcSpmdBinding) (tc-spmd-env-bindings left)]
    [right-bindings : (Array TcSpmdBinding) (tc-spmd-env-bindings right)]
    [merged : (Array TcSpmdBinding) (array.make-array TcSpmdBinding left-len)]
    (begin
      ;; Branch merge is index-aligned: both branches start from the same
      ;; snapshot and local lets restore to that mark before the merge.
      (tc-spmd-env-merge-classes-into
        merged
        left-bindings
        right-bindings
        left-len
        right-len
        0)
      (TcSpmdEnv merged left-len))))

(define (tc-type-env-box-smoke?) : bool
  (let
    [env : TcTypeEnv
      (tc-bind-return-type
        (tc-bind
          (tc-bind (tc-push-region (tc-empty-env) "arena") "x" (AstType.I64))
          "x"
          (AstType.Bool))
        (AstType.I64))]
    [cached : TcTypeEnv (tc-env-with-cache env)]
    (and
      (= (tc-env-cache-count cached) 4)
      (match (tc-lookup cached "x")
        [(ResultTcType.Ok (AstType.Bool)) true]
        [_ false])
      (match (tc-current-return-type env)
        [(ResultTcType.Ok (AstType.I64)) true]
        [_ false])
      (match (tc-active-region env)
        [(TcMaybeString.Some region) (string.eq region "arena")]
        [_ false])
      (tc-lifetime-visible? env "arena"))))

(define (tc-type-env-cache-head? [env : TcTypeEnv]) : bool
  (match env
    [(TcTypeEnv.Cache _ _ _ _ _ _ _ _ _) true]
    [_ false]))

(define (tc-type-env-cache-partial-head? [env : TcTypeEnv]) : bool
  (match env
    [(TcTypeEnv.Cache _ _ _ _ _ _ partial _ _) partial]
    [_ false]))

(define (tc-type-env-bind-many [env : TcTypeEnv] [count : i64]) : TcTypeEnv
  (let
    [i : i64 0]
    [out : TcTypeEnv env]
    (begin
      (while (< i count)
        (begin
          (set!
            out
            (tc-bind
              out
              (string.append "local" (string.int->string i))
              (AstType.I64)))
          (set! i (+ i 1))))
      out)))

(define (tc-type-env-local-cache-behavior-smoke?) : bool
  (let
    [base : TcTypeEnv
      (tc-env-with-cache (tc-bind (tc-empty-env) "global" (AstType.String)))]
    [marked : TcTypeEnv
      (tc-bind-return-type
        (tc-bind-unsafe (tc-push-region base "arena") "danger" (AstType.I64))
        (AstType.I64))]
    [shadowed : TcTypeEnv
      (tc-bind (tc-bind marked "shadow" (AstType.I64)) "shadow" (AstType.Bool))]
    [cached : TcTypeEnv
      (tc-type-env-bind-many shadowed (- (tc-local-cache-threshold) 6))]
    (and
      (tc-type-env-cache-head? cached)
      (match (tc-lookup cached "shadow")
        [(ResultTcType.Ok (AstType.Bool)) true]
        [_ false])
      (match (tc-lookup cached "global")
        [(ResultTcType.Ok (AstType.String)) true]
        [_ false])
      (match (tc-lookup-unsafe cached "danger")
        [(ResultTcTypeUnsafe.Ok (AstType.I64) unsafe) unsafe]
        [_ false])
      (match (tc-lookup cached "missing")
        [(ResultTcType.Err message)
          (string.eq message "typecheck: unbound name missing")]
        [_ false])
      (match (tc-current-return-type cached)
        [(ResultTcType.Ok (AstType.I64)) true]
        [_ false])
      (match (tc-active-region cached)
        [(TcMaybeString.Some region) (string.eq region "arena")]
        [_ false])
      (tc-lifetime-visible? cached "shadow"))))

(define (tc-type-env-local-cache-default-shadow-smoke?) : bool
  (let
    [base : TcTypeEnv (tc-env-with-cache (tc-default-env))]
    [shadowed : TcTypeEnv
      (tc-bind base "__tl_string_length" (tc-fn1 (AstType.I64) (AstType.I64)))]
    [cached : TcTypeEnv
      (tc-type-env-bind-many shadowed (- (tc-local-cache-threshold) 1))]
    (and
      (tc-type-env-cache-head? cached)
      (not (tc-default-builtin-unshadowed? cached "__tl_string_length")))))

(define (tc-type-env-local-cache-partial-layer-smoke?) : bool
  (let
    [base : TcTypeEnv
      (tc-env-with-cache (tc-bind (tc-empty-env) "global" (AstType.String)))]
    [layer1 : TcTypeEnv (tc-type-env-bind-many base (tc-local-cache-threshold))]
    [older-shadow : TcTypeEnv (tc-bind layer1 "shadow" (AstType.I64))]
    [layer2 : TcTypeEnv
      (tc-type-env-bind-many older-shadow (- (tc-local-cache-threshold) 1))]
    [newer-shadow : TcTypeEnv (tc-bind layer2 "shadow" (AstType.Bool))]
    [layer3 : TcTypeEnv
      (tc-type-env-bind-many newer-shadow (- (tc-local-cache-threshold) 1))]
    (and
      (tc-type-env-cache-partial-head? layer1)
      (tc-type-env-cache-partial-head? layer2)
      (tc-type-env-cache-partial-head? layer3)
      (= (tc-env-partial-layer-depth layer3) 3)
      (match (tc-lookup layer3 "global")
        [(ResultTcType.Ok (AstType.String)) true]
        [_ false])
      (match (tc-lookup layer2 "shadow")
        [(ResultTcType.Ok (AstType.I64)) true]
        [_ false])
      (match (tc-lookup layer3 "shadow")
        [(ResultTcType.Ok (AstType.Bool)) true]
        [_ false]))))

(define (tc-type-env-local-cache-default-shadow-partial-miss-smoke?) : bool
  (let
    [base : TcTypeEnv (tc-env-with-cache (tc-default-env))]
    [shadowed : TcTypeEnv
      (tc-bind base "__tl_string_length" (tc-fn1 (AstType.I64) (AstType.I64)))]
    [shadow-layer : TcTypeEnv
      (tc-type-env-bind-many shadowed (- (tc-local-cache-threshold) 1))]
    [miss-layer : TcTypeEnv
      (tc-type-env-bind-many shadow-layer (tc-local-cache-threshold))]
    [clear-layer : TcTypeEnv
      (tc-type-env-bind-many base (tc-local-cache-threshold))]
    (and
      (tc-type-env-cache-partial-head? shadow-layer)
      (tc-type-env-cache-partial-head? miss-layer)
      (tc-type-env-cache-partial-head? clear-layer)
      (not (tc-default-builtin-unshadowed? shadow-layer "__tl_string_length"))
      (not (tc-default-builtin-unshadowed? miss-layer "__tl_string_length"))
      (tc-default-builtin-unshadowed? clear-layer "__tl_string_length"))))

(define (tc-type-env-local-cache-depth-cap-smoke?) : bool
  (let
    [base : TcTypeEnv
      (tc-env-with-cache (tc-bind (tc-empty-env) "global" (AstType.String)))]
    [deep : TcTypeEnv
      (tc-type-env-bind-many
        base
        (* (tc-local-cache-threshold) (+ (tc-local-cache-partial-layer-cap) 1)))]
    (and
      (tc-type-env-cache-head? deep)
      (not (tc-type-env-cache-partial-head? deep))
      (= (tc-env-partial-layer-depth deep) 0)
      (match (tc-lookup deep "global")
        [(ResultTcType.Ok (AstType.String)) true]
        [_ false]))))

;; #2661: markers buried below MORE THAN ONE compaction window. The behavior
;; smoke above only crosses one threshold, so the head cache is unwrapped and
;; the markers are reached by the plain bind walk; with two stacked
;; compaction caches the scans must recurse through scan-through cache nodes
;; or the markers disappear (with-arena escape checking was silently disabled
;; past 32 local binds). Scans must still terminate at the explicit
;; non-scan-through base cache.
(define (tc-type-env-local-cache-deep-scan-smoke?) : bool
  (let
    [base : TcTypeEnv
      (tc-env-with-cache (tc-bind (tc-empty-env) "global" (AstType.String)))]
    [marked : TcTypeEnv
      (tc-bind
        (tc-bind-cleanup-owner
          (tc-bind-return-type
            (tc-enter-unsafe (tc-push-region base "arena"))
            (AstType.I64))
          "resource")
        "resource"
        (AstType.String))]
    [deep : TcTypeEnv
      (tc-type-env-bind-many marked (+ (* (tc-local-cache-threshold) 2) 8))]
    [below-base : TcTypeEnv
      (tc-type-env-bind-many base (+ (* (tc-local-cache-threshold) 2) 8))]
    (and
      (match (tc-active-region deep)
        [(TcMaybeString.Some region) (string.eq region "arena")]
        [_ false])
      (match (tc-current-return-type deep)
        [(ResultTcType.Ok (AstType.I64)) true]
        [_ false])
      (tc-in-unsafe? deep)
      (tc-string-list-contains (tc-active-cleanup-owners deep) "resource")
      (tc-lifetime-visible? deep "arena")
      (tc-lifetime-visible? deep "resource")
      (tc-lifetime-outlives-binding? deep "arena" "resource")
      (not (tc-lifetime-outlives-binding? deep "resource" "arena"))
      (tc-lifetime-outlives-lifetime? deep "arena" "resource")
      (not (tc-lifetime-outlives-lifetime? deep "resource" "arena"))
      (tc-region-outlives-or-matches deep "arena" "arena")
      (match (tc-active-region below-base)
        [(TcMaybeString.No) true]
        [_ false])
      (not (tc-lifetime-visible? below-base "global")))))

(define (tc-type-env-local-cache-c-abi-fnptr-smoke?) : bool
  (let
    [base : TcTypeEnv (tc-env-with-cache (tc-empty-env))]
    [callback-ty : AstType (tc-fn0 (AstType.I64))]
    [marked : TcTypeEnv (tc-bind-c-abi-fnptr base "callback" callback-ty)]
    [both : TcTypeEnv
      (tc-bind-unsafe-c-abi-fnptr-id
        marked
        (tc-name-id "danger-callback")
        callback-ty)]
    [deep : TcTypeEnv
      (tc-type-env-bind-many both (+ (* (tc-local-cache-threshold) 2) 8))]
    (and
      (tc-binding-c-abi-fnptr? deep "callback")
      (not (tc-binding-unsafe? deep "callback"))
      (tc-binding-c-abi-fnptr? deep "danger-callback")
      (tc-binding-unsafe? deep "danger-callback")
      (match (tc-lookup-unsafe deep "danger-callback")
        [(ResultTcTypeUnsafe.Ok (AstType.Func _ _) unsafe) unsafe]
        [_ false]))))

(define (tc-type-env-local-cache-lambda-capture-smoke?) : bool
  (let
    [body : AstExpr (AstExpr.Var (tc-name-id "captured"))]
    [base : TcTypeEnv (tc-env-with-cache (tc-empty-env))]
    [env : TcTypeEnv
      (tc-bind
        (tc-push-region base "outer")
        "captured"
        (ast-ty-ref "outer" (AstType.I64)))]
    [deep : TcTypeEnv
      (tc-type-env-bind-many env (+ (* (tc-local-cache-threshold) 2) 8))]
    (and
      (tc-lambda-captures-reference? deep (ast-param-list-new) body)
      (match (tc-check-lambda-region-captures deep (ast-param-list-new) body)
        [(ResultTcUnit.Err message)
          (string.eq
            message
            "typecheck: lambda cannot capture immutable reference; reference value would escape lexical scope")]
        [_ false])
      (match (tc-check-lambda-region-captures-allow-refs
        deep
        (ast-param-list-new)
        body)
        [(ResultTcUnit.Ok) true]
        [_ false]))))

(define (tc-type-env-walker-api-smoke?) : bool
  (let
    [lookup-base : TcTypeEnv
      (tc-env-with-cache (tc-bind (tc-empty-env) "global" (AstType.String)))]
    [lookup-local : TcTypeEnv (tc-bind lookup-base "local" (AstType.I64))]
    [lookup-deep : TcTypeEnv
      (tc-type-env-bind-many lookup-local (+ (tc-local-cache-threshold) 4))]
    [marker-base : TcTypeEnv
      (tc-env-with-cache (tc-push-region (tc-empty-env) "outer"))]
    [marker-local : TcTypeEnv (tc-push-region marker-base "inner")]
    [marker-deep : TcTypeEnv
      (tc-type-env-bind-many
        marker-local
        (+ (* (tc-local-cache-threshold) 2) 8))]
    [unsafe-env : TcTypeEnv
      (tc-bind-unsafe (tc-empty-env) "unsafe-value" (AstType.I64))]
    [hygiene-top : TcTypeEnv (tc-bind (tc-empty-env) "visible" (AstType.I64))]
    [hygiene-env : TcTypeEnv
      (tc-bind (tc-hygiene-global-env hygiene-top) "visible" (AstType.Bool))]
    (and
      (match (tc-type-env-lookup-step lookup-local (tc-name-id "local"))
        [(TcTypeEnvLookupStep.Found (AstType.I64)) true]
        [_ false])
      (match (tc-type-env-lookup-step lookup-local (tc-name-id "global"))
        [(TcTypeEnvLookupStep.Miss rest-env)
          (match (tc-type-env-lookup-step rest-env (tc-name-id "global"))
            [(TcTypeEnvLookupStep.Found (AstType.String)) true]
            [_ false])]
        [_ false])
      (match (tc-type-env-marker-step (tc-type-env-marker-start marker-local))
        [(TcTypeEnvMarkerStep.Bind key (AstType.Var region) _)
          (and
            (= key (tc-region-marker-id))
            (string.eq (intern-str region) "inner"))]
        [_ false])
      (match (tc-type-env-unsafe-lookup-step
        unsafe-env
        (tc-name-id "unsafe-value"))
        [(TcTypeEnvUnsafeLookupStep.Found (AstType.I64) unsafe) unsafe]
        [_ false])
      (match (tc-lookup lookup-deep "global")
        [(ResultTcType.Ok (AstType.String)) true]
        [_ false])
      (match (tc-lookup lookup-deep "local")
        [(ResultTcType.Ok (AstType.I64)) true]
        [_ false])
      (match (tc-active-region marker-deep)
        [(TcMaybeString.Some region) (string.eq region "inner")]
        [_ false])
      (tc-lifetime-visible? marker-deep "inner")
      (not (tc-lifetime-visible? marker-deep "outer"))
      (match (tc-lookup hygiene-env "visible")
        [(ResultTcType.Ok (AstType.Bool)) true]
        [_ false])
      (match (tc-lookup-hygiene-global hygiene-env "visible")
        [(ResultTcType.Ok (AstType.I64)) true]
        [_ false]))))

(test
  tc-type-env-walker-api
  (if (tc-type-env-walker-api-smoke?)
    unit
    (io.panic "typecheck: env walker api smoke failed")))

(define (tc-type-env-local-cache-smoke?) : bool
  (and
    (tc-type-env-local-cache-behavior-smoke?)
    (tc-type-env-local-cache-default-shadow-smoke?)
    (tc-type-env-local-cache-partial-layer-smoke?)
    (tc-type-env-local-cache-default-shadow-partial-miss-smoke?)
    (tc-type-env-local-cache-depth-cap-smoke?)
    (tc-type-env-local-cache-deep-scan-smoke?)
    (tc-type-env-local-cache-c-abi-fnptr-smoke?)
    (tc-type-env-local-cache-lambda-capture-smoke?)
    (tc-type-env-walker-api-smoke?)))

(define (tc-spmd-env-box-smoke?) : bool
  (let
    [env : TcTypeEnv
      (tc-bind (tc-bind (tc-empty-env) "x" (AstType.I64)) "flag" (AstType.Bool))]
    [shadow-env : TcTypeEnv
      (tc-bind (tc-bind (tc-empty-env) "x" (AstType.I64)) "x" (AstType.Bool))]
    [shadow-spmd : TcSpmdEnv (tc-spmd-env-from-type-env shadow-env)]
    [outer : TcSpmdEnv (tc-spmd-env-from-type-env env)]
    [local : TcSpmdEnv
      (tc-spmd-env-bind
        outer
        "lane"
        (AstType.I64)
        TcSpmdClass.Varying
        TcSpmdScope.Local)]
    [updated : TcSpmdEnv
      (tc-spmd-env-set-local-class local "lane" TcSpmdClass.Uniform)]
    [indexed : TcSpmdEnv
      (tc-spmd-env-bind-role
        updated
        "idx"
        (AstType.I64)
        TcSpmdClass.Uniform
        TcSpmdScope.Local
        TcSpmdRole.ForeachIndex)]
    [marked-outer : TcSpmdEnv (tc-spmd-env-mark-outer indexed)]
    [branch-right : TcSpmdEnv
      (tc-spmd-env-set-local-class indexed "lane" TcSpmdClass.Varying)]
    [merged : TcSpmdEnv (tc-spmd-env-merge-classes indexed branch-right)]
    [restore-mark : TcSpmdEnvMark (tc-spmd-env-mark outer)]
    [restored : TcSpmdEnv (tc-spmd-env-restore updated restore-mark)]
    (and
      (match (tc-spmd-env-lookup updated "lane")
        [(TcSpmdLookup.Found
            (AstType.I64)
            (TcSpmdClass.Uniform)
            (TcSpmdScope.Local)
            (TcSpmdRole.Value))
          true]
        [_ false])
      (tc-spmd-env-has-local? updated "lane")
      (tc-spmd-env-has-outer? updated "x")
      (match (tc-spmd-env-lookup shadow-spmd "x")
        [(TcSpmdLookup.Found
            (AstType.Bool)
            (TcSpmdClass.Uniform)
            (TcSpmdScope.Outer)
            (TcSpmdRole.Value))
          true]
        [_ false])
      (match (tc-spmd-env-lookup marked-outer "idx")
        [(TcSpmdLookup.Found
            (AstType.I64)
            (TcSpmdClass.Uniform)
            (TcSpmdScope.Outer)
            (TcSpmdRole.ForeachIndex))
          true]
        [_ false])
      (not (tc-spmd-env-has-local? marked-outer "lane"))
      (tc-spmd-env-has-outer? marked-outer "lane")
      (match (tc-spmd-env-lookup merged "lane")
        [(TcSpmdLookup.Found
            (AstType.I64)
            (TcSpmdClass.Varying)
            (TcSpmdScope.Local)
            (TcSpmdRole.Value))
          true]
        [_ false])
      (match (tc-spmd-env-lookup merged "idx")
        [(TcSpmdLookup.Found
            (AstType.I64)
            (TcSpmdClass.Uniform)
            (TcSpmdScope.Local)
            (TcSpmdRole.ForeachIndex))
          true]
        [_ false])
      (match (tc-spmd-env-lookup (tc-spmd-env-pop updated 1) "lane")
        [(TcSpmdLookup.Missing) true]
        [_ false])
      (match (tc-spmd-env-lookup restored "lane")
        [(TcSpmdLookup.Missing) true]
        [_ false]))))

(define (tc-literal-type [lit : AstLiteral]) : AstType
  (match lit
    [(AstLiteral.Int _ _) (AstType.I32)]
    [(AstLiteral.Float _) (AstType.F64)]
    [(AstLiteral.Bool _) (AstType.Bool)]
    [(AstLiteral.Char _) (AstType.Char)]
    [(AstLiteral.String _) (AstType.String)]
    [(AstLiteral.Unit) (AstType.Unit)]))

(define (tc-param-type-list-into
  [ctx : TcContext]
  [params : (& params AstParamList)]
  [index : i64]
  [out : (&mut out AstTypeList)]) : unit
  (if (>= index (ast-param-list-len params))
    unit
    (begin
      (match (ast-param-list-get params index (ast-param-fallback))
        [(AstParam.Param _ ty _)
          (ast-type-list-push
            out
            (ast-node-pool-reader-type-push (tc-resolve-type ctx ty)))])
      (tc-param-type-list-into ctx params (+ index 1) out))))

(define (tc-param-type-list [ctx : TcContext] [params : AstParamList]) : AstTypeList
  (let
    [out : AstTypeList
      (ast-type-list-with-capacity (ast-param-list-len (& params)))]
    (begin
      (tc-param-type-list-into ctx (& params) 0 (&mut out))
      out)))

(define (tc-macro-param-type-list-into
  [ctx : TcContext]
  [params : (& params AstMacroParamList)]
  [index : i64]
  [out : (&mut out AstTypeList)]) : unit
  (if (>= index (ast-macro-param-list-len params))
    unit
    (begin
      (match (ast-macro-param-list-get params index (ast-macro-param-fallback))
        [(AstMacroParam.Param _ ty _)
          (ast-type-list-push
            out
            (ast-node-pool-reader-type-push
              (tc-resolve-type ctx (tc-macro-signature-type ty))))])
      (tc-macro-param-type-list-into ctx params (+ index 1) out))))

(define (tc-macro-param-type-list
  [ctx : TcContext]
  [params : AstMacroParamList]) : AstTypeList
  (let
    [out : AstTypeList
      (ast-type-list-with-capacity (ast-macro-param-list-len (& params)))]
    (begin
      (tc-macro-param-type-list-into ctx (& params) 0 (&mut out))
      out)))

(define (tc-type-list-ref [types : AstTypeList] [index : i64]) : ResultTcType
  (if (or (< index 0) (>= index (ast-type-list-len (& types))))
    (ResultTcType.Err "typecheck: tuple index out of bounds")
    (ResultTcType.Ok
      (ty-node-get (ast-type-list-get (& types) index (ast-type-id-fallback))))))

(define (tc-expr-list-len [exprs : AstExprList]) : i64
  (struct-get (& exprs) len))

(define (tc-expr-list-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]) : ResultTcTypeList
  (let
    [out : AstTypeList (ast-type-list-new)]
    (match (tc-expr-list-types-into-at ctx env (& exprs) 0 (&mut out))
      [(ResultTcUnit.Ok) (ResultTcTypeList.Ok out)]
      [(ResultTcUnit.Err message) (ResultTcTypeList.Err message)])))

(define (tc-expr-list-types-into-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [out : (&mut out AstTypeList)]) : ResultTcUnit
  (if (>= index (struct-get exprs len))
    ResultTcUnit.Ok
    (match (tc-expr-id ctx env (ast-expr-list-get exprs index 0))
      [(ResultTcType.Ok ty)
        (begin
          (ast-type-list-push out (ast-node-pool-reader-type-push ty))
          (tc-expr-list-types-into-at ctx env exprs (+ index 1) out))]
      [(ResultTcType.Err message) (ResultTcUnit.Err message)])))

(define (tc-check-array-rest
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [elem-ty : AstType]) : ResultTcUnit
  (tc-check-array-rest-at ctx env (& exprs) 0 elem-ty))

(define (tc-check-array-rest-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [elem-ty : AstType]) : ResultTcUnit
  (if (>= index (struct-get exprs len))
    ResultTcUnit.Ok
    (match (tc-expr-with-expected-or-actual-id
      ctx
      env
      (ast-expr-list-get exprs index 0)
      elem-ty)
      [(ResultTcType.Ok ty)
        (match (tc-expect
          ty
          elem-ty
          "typecheck: array elements must have same type")
          [(ResultTcUnit.Ok)
            (tc-check-array-rest-at ctx env exprs (+ index 1) elem-ty)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
      [(ResultTcType.Err message) (ResultTcUnit.Err message)])))

(define (tc-bind-params
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]) : TcTypeEnv
  (tc-bind-params-at ctx env (& params) 0))

(define (tc-bind-params-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : (& params AstParamList)]
  [index : i64]) : TcTypeEnv
  (if (>= index (ast-param-list-len params))
    env
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param name ty _)
        (tc-bind-params-at
          ctx
          (tc-bind-id env name (tc-resolve-type ctx ty))
          params
          (+ index 1))])))

(define (tc-bind-macro-params
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstMacroParamList]) : TcTypeEnv
  (tc-bind-macro-params-at ctx env (& params) 0))

(define (tc-bind-macro-params-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : (& params AstMacroParamList)]
  [index : i64]) : TcTypeEnv
  (if (>= index (ast-macro-param-list-len params))
    env
    (match (ast-macro-param-list-get params index (ast-macro-param-fallback))
      [(AstMacroParam.Param name ty variadic)
        (tc-bind-macro-params-at
          ctx
          (tc-bind-id
            env
            name
            (cond
              [(tc-macro-type-param-kind? ty) (AstType.Expr)]
              [(tc-macro-module-param-kind? ty) (AstType.String)]
              [(and
                  variadic
                  (tc-macro-expr-clause-type?
                    (tc-resolve-type ctx (tc-macro-signature-type ty))))
                (tc-macro-expr-clause-list-type)]
              [(and
                  variadic
                  (tc-macro-expr-binding-clause-type?
                    (tc-resolve-type ctx (tc-macro-signature-type ty))))
                (tc-macro-expr-binding-clause-list-type)]
              [(tc-macro-expr-clause-type?
                  (tc-resolve-type ctx (tc-macro-signature-type ty)))
                (tc-macro-expr-clause-type)]
              [(tc-macro-expr-binding-clause-type?
                  (tc-resolve-type ctx (tc-macro-signature-type ty)))
                (tc-macro-expr-binding-clause-type)]
              [variadic (AstType.ExprList)]
              [else (AstType.Expr)]))
          params
          (+ index 1))])))

(define (tc-ctfe-env-extend-macro-params
  [ctx : TcContext]
  [env : CtfeEnv]
  [params : AstMacroParamList]) : CtfeEnv
  (tc-ctfe-env-extend-macro-params-at ctx env (& params) 0))

(define (tc-ctfe-env-extend-macro-params-at
  [ctx : TcContext]
  [env : CtfeEnv]
  [params : (& params AstMacroParamList)]
  [index : i64]) : CtfeEnv
  (if (>= index (ast-macro-param-list-len params))
    env
    (match (ast-macro-param-list-get params index (ast-macro-param-fallback))
      [(AstMacroParam.Param name ty variadic)
        (tc-ctfe-env-extend-macro-params-at
          ctx
          (ctfe-env-extend
            env
            (intern-str name)
            (cond
              [(tc-macro-type-param-kind? ty)
                (CompilerCtfeValue.Type (AstType.Var name))]
              [(tc-macro-module-param-kind? ty) (CompilerCtfeValue.String "")]
              [(and
                  variadic
                  (tc-macro-expr-clause-type?
                    (tc-resolve-type ctx (tc-macro-signature-type ty))))
                (CompilerCtfeValue.ExprClauseList (ast-expr-clause-list-new))]
              [(and
                  variadic
                  (tc-macro-expr-binding-clause-type?
                    (tc-resolve-type ctx (tc-macro-signature-type ty))))
                (CompilerCtfeValue.ExprBindingClauseList
                  (ast-expr-binding-clause-list-new))]
              [variadic (CompilerCtfeValue.ExprList (ast-expr-list-new))]
              [(tc-macro-expr-clause-type?
                  (tc-resolve-type ctx (tc-macro-signature-type ty)))
                (CompilerCtfeValue.ExprClause
                  (ast-expr-clause
                    (ast-node-pool-context-expr-push
                      (tc-context-pools ctx)
                      (AstExpr.Var
                        (intern (string.append (intern-str name) "$first"))))
                    (ast-node-pool-context-expr-push
                      (tc-context-pools ctx)
                      (AstExpr.Var
                        (intern (string.append (intern-str name) "$second"))))))]
              [(tc-macro-expr-binding-clause-type?
                  (tc-resolve-type ctx (tc-macro-signature-type ty)))
                (let
                  [unit-expr : i64
                    (ast-node-pool-context-expr-push
                      (tc-context-pools ctx)
                      (AstExpr.Literal (AstLiteral.Unit)))]
                  (CompilerCtfeValue.ExprBindingClause
                    (ast-expr-binding-clause-id
                      name
                      false
                      unit-expr
                      (ast-node-pool-context-expr-push
                        (tc-context-pools ctx)
                        (AstExpr.Var
                          (intern (string.append (intern-str name) "$init"))))
                      (AstSourceSpan 0 0 0 0))))]
              [else
                (CompilerCtfeValue.Expr
                  (ast-node-pool-context-expr-push
                    (tc-context-pools ctx)
                    (AstExpr.Var name))
                  (tc-resolve-type ctx (tc-macro-signature-type ty)))]))
          params
          (+ index 1))])))

(define (tc-dispatch-isa-eq? [a : AstDispatchIsa] [b : AstDispatchIsa]) : bool
  (match a
    [(AstDispatchIsa.Scalar)
      (match b
        [(AstDispatchIsa.Scalar) true]
        [_ false])]
    [(AstDispatchIsa.Avx2)
      (match b
        [(AstDispatchIsa.Avx2) true]
        [_ false])]
    [(AstDispatchIsa.Avx512)
      (match b
        [(AstDispatchIsa.Avx512) true]
        [_ false])]))

(define (tc-dispatch-variant-list-contains-isa-from?
  [variants : (& variants AstDispatchVariantList)]
  [index : i64]
  [isa : AstDispatchIsa]) : bool
  (if (>= index (struct-get variants len))
    false
    (match (ast-dispatch-variant-list-get
      variants
      index
      (ast-dispatch-variant-fallback))
      [(AstDispatchVariant.Variant found-isa _)
        (if (tc-dispatch-isa-eq? found-isa isa)
          true
          (tc-dispatch-variant-list-contains-isa-from? variants (+ index 1) isa))])))

(define (tc-dispatch-variant-list-contains-isa?
  [variants : AstDispatchVariantList]
  [isa : AstDispatchIsa]) : bool
  (tc-dispatch-variant-list-contains-isa-from? (& variants) 0 isa))

(define (tc-dispatch-variant-list-duplicate-isa-from?
  [variants : (& variants AstDispatchVariantList)]
  [index : i64]) : bool
  (if (>= index (struct-get variants len))
    false
    (match (ast-dispatch-variant-list-get
      variants
      index
      (ast-dispatch-variant-fallback))
      [(AstDispatchVariant.Variant isa _)
        (or
          (tc-dispatch-variant-list-contains-isa-from? variants (+ index 1) isa)
          (tc-dispatch-variant-list-duplicate-isa-from? variants (+ index 1)))])))

(define (tc-dispatch-variant-list-duplicate-isa?
  [variants : AstDispatchVariantList]) : bool
  (tc-dispatch-variant-list-duplicate-isa-from? (& variants) 0))

(define (tc-dispatch-variant-list-scalar-count-from
  [variants : (& variants AstDispatchVariantList)]
  [index : i64]
  [count : i64]) : i64
  (if (>= index (struct-get variants len))
    count
    (match (ast-dispatch-variant-list-get
      variants
      index
      (ast-dispatch-variant-fallback))
      [(AstDispatchVariant.Variant isa _)
        (tc-dispatch-variant-list-scalar-count-from
          variants
          (+ index 1)
          (+
            count
            (match isa
              [(AstDispatchIsa.Scalar) 1]
              [_ 0])))])))

(define (tc-dispatch-variant-list-scalar-count
  [variants : AstDispatchVariantList]) : i64
  (tc-dispatch-variant-list-scalar-count-from (& variants) 0 0))

(define (tc-dispatch-symbol-name [module : String] [name : String]) : String
  (if (and (> (string.string-length module) 0) (not (tc-name-qualified? name)))
    (compiler-symbol-module-key module name)
    name))

(define (tc-dispatch-variant-non-function-message [name : String]) : String
  (string.append "typecheck: defdispatch variant is not a function " name))

(define (tc-dispatch-variant-type
  [ctx : TcContext]
  [dispatch-name : String]
  [variant-name : String]) : ResultTcType
  (let
    [module : String (tc-context-module ctx)]
    [logical-name : String (tc-dispatch-symbol-name module dispatch-name)]
    [lookup-name : String (tc-dispatch-symbol-name module variant-name)]
    (if (string.eq lookup-name logical-name)
      (ResultTcType.Err "typecheck: defdispatch cannot use itself as a variant")
      (let
        [handle : i64
          (compiler-symbols-lookup-value-or
            (tc-context-symbols ctx)
            lookup-name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? handle)
          (let
            [kind : i64 (compiler-symbol-handle-kind handle)]
            (if (= kind (compiler-symbol-kind-defdispatch))
              (ResultTcType.Err
                "typecheck: defdispatch variant cannot be another dispatch")
              (if (or
                (= kind (compiler-symbol-kind-function-define))
                (= kind (compiler-symbol-kind-extern)))
                (match (compiler-program-decl-at-index
                  (tc-context-program ctx)
                  (compiler-symbol-handle-index handle))
                  [(ResultAstDecl.Ok decl)
                    (match (tc-top-decl-type ctx decl)
                      [(ResultTcType.Ok ty)
                        (match ty
                          [(AstType.Func _ _) (ResultTcType.Ok ty)]
                          [_
                            (ResultTcType.Err
                              (tc-dispatch-variant-non-function-message
                                variant-name))])]
                      [(ResultTcType.Err message) (ResultTcType.Err message)])]
                  [(ResultAstDecl.Err message) (ResultTcType.Err message)])
                (ResultTcType.Err
                  (tc-dispatch-variant-non-function-message variant-name)))))
          (ResultTcType.Err
            (string.append
              "typecheck: unknown defdispatch variant "
              variant-name)))))))

(define (tc-dispatch-variant-signatures-from
  [ctx : TcContext]
  [dispatch-name : String]
  [variants : (& variants AstDispatchVariantList)]
  [index : i64]
  [expected : AstMaybeType]) : ResultTcType
  (if (>= index (struct-get variants len))
    (match expected
      [(AstMaybeType.Some ty) (ResultTcType.Ok ty)]
      [(AstMaybeType.No)
        (ResultTcType.Err "typecheck: defdispatch has no variants")])
    (match (ast-dispatch-variant-list-get
      variants
      index
      (ast-dispatch-variant-fallback))
      [(AstDispatchVariant.Variant _ variant-name)
        (match (tc-dispatch-variant-type ctx dispatch-name variant-name)
          [(ResultTcType.Ok ty)
            (match expected
              [(AstMaybeType.No)
                (tc-dispatch-variant-signatures-from
                  ctx
                  dispatch-name
                  variants
                  (+ index 1)
                  (AstMaybeType.Some ty))]
              [(AstMaybeType.Some want)
                (if (tc-type-eq ty want)
                  (tc-dispatch-variant-signatures-from
                    ctx
                    dispatch-name
                    variants
                    (+ index 1)
                    expected)
                  (ResultTcType.Err
                    "typecheck: defdispatch variant signatures must match"))])]
          [(ResultTcType.Err message) (ResultTcType.Err message)])])))

(define (tc-dispatch-variant-signatures
  [ctx : TcContext]
  [dispatch-name : String]
  [variants : AstDispatchVariantList]
  [expected : AstMaybeType]) : ResultTcType
  (tc-dispatch-variant-signatures-from
    ctx
    dispatch-name
    (& variants)
    0
    expected))

(define (tc-dispatch-decl-type
  [ctx : TcContext]
  [name : String]
  [variants : AstDispatchVariantList]) : ResultTcType
  (if (!= (tc-dispatch-variant-list-scalar-count variants) 1)
    (ResultTcType.Err
      "typecheck: defdispatch requires exactly one scalar variant")
    (if (tc-dispatch-variant-list-duplicate-isa? variants)
      (ResultTcType.Err "typecheck: duplicate defdispatch ISA variant")
      (tc-dispatch-variant-signatures ctx name variants AstMaybeType.No))))

(define (tc-top-decl-type [ctx : TcContext] [decl : AstDecl]) : ResultTcType
  (match decl
    [(AstDecl.Def _ maybe-ty expr-box)
      (let
        [expr : AstExpr (ast-node-get expr-box)]
        (match maybe-ty
          [(AstMaybeType.Some ty) (ResultTcType.Ok (tc-resolve-type ctx ty))]
          [(AstMaybeType.No)
            (match (ast-expr-unspan expr)
              [(AstExpr.Literal lit) (ResultTcType.Ok (tc-literal-type lit))]
              [(AstExpr.Ann _ ty) (ResultTcType.Ok (tc-resolve-type ctx ty))]
              [_
                (ResultTcType.Err
                  "typecheck: top-level value requires annotation")])]))]
    [(AstDecl.DefFn _ params ret _ _)
      (ResultTcType.Ok
        (ast-ty-func (tc-param-type-list ctx params) (tc-resolve-type ctx ret)))]
    [(AstDecl.Extern _ _ _ ty) (ResultTcType.Ok (tc-resolve-type ctx ty))]
    [(AstDecl.DefDispatch name variants)
      (tc-dispatch-decl-type ctx (intern-str name) variants)]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (tc-top-decl-type ctx inner))]
    [_ (ResultTcType.Err "typecheck: declaration has no value type")]))

;; Like `tc-top-decl-type`, but infers an un-annotated top-level `define`'s type
;; from its initializer expression when it is neither a literal nor an annotated
;; expression. The `env` carries the bindings of all preceding declarations
;; (functions, enum/struct constructors, earlier globals), so a global such as
;; `(define result (factorial 5))` or `(define pair (Pair 10 11))` resolves
;; through the ordinary expression typechecker instead of demanding an
;; annotation. This mirrors the former Rust typechecker, whose first pass over
;; the declarations runs `check_expr(value)` for an un-annotated `Decl::Def`.
(define (tc-top-decl-type-with-env
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decl : AstDecl]) : ResultTcType
  (match decl
    [(AstDecl.Def _ maybe-ty expr-box)
      (let
        [expr : AstExpr (ast-node-get expr-box)]
        (match maybe-ty
          [(AstMaybeType.Some ty) (ResultTcType.Ok (tc-resolve-type ctx ty))]
          [(AstMaybeType.No)
            (match (ast-expr-unspan expr)
              [(AstExpr.Literal lit) (ResultTcType.Ok (tc-literal-type lit))]
              [(AstExpr.Ann _ ty) (ResultTcType.Ok (tc-resolve-type ctx ty))]
              [_ (tc-expr ctx env expr)])]))]
    [_ (tc-top-decl-type ctx decl)]))

(define (tc-field-type-list [ctx : TcContext] [fields : AstFieldDefList]) : AstTypeList
  (tc-field-type-list-at ctx (& fields) 0))

(define (tc-field-type-list-at
  [ctx : TcContext]
  [fields : (& fields AstFieldDefList)]
  [index : i64]) : AstTypeList
  (if (>= index (ast-field-def-list-len fields))
    (ast-type-list-new)
    (match (ast-field-def-list-get fields index (ast-field-def-fallback))
      [(AstFieldDef.Def _ ty _)
        (ast-type-cons
          (tc-resolve-type ctx ty)
          (tc-field-type-list-at ctx fields (+ index 1)))])))

(define (tc-tag-type-list-region [region : String] [types : AstTypeList]) : AstTypeList
  (tc-tag-type-list-region-at region (& types) 0))

(define (tc-tag-type-list-region-at
  [region : String]
  [types : (& types AstTypeList)]
  [index : i64]) : AstTypeList
  (if (>= index (ast-type-list-len types))
    (ast-type-list-new)
    (ast-type-cons
      (tc-tag-region
        region
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      (tc-tag-type-list-region-at region types (+ index 1)))))

(define (tc-tag-regions [regions : TcStringList] [ty : AstType]) : AstType
  (match regions
    [(TcStringList.Nil) ty]
    [(TcStringList.Cons region rest)
      (tc-tag-region region (tc-tag-regions (box-get rest) ty))]))

(define (tc-tag-type-list-regions
  [regions : TcStringList]
  [types : AstTypeList]) : AstTypeList
  (tc-tag-type-list-regions-at regions (& types) 0))

(define (tc-tag-type-list-regions-at
  [regions : TcStringList]
  [types : (& types AstTypeList)]
  [index : i64]) : AstTypeList
  (if (>= index (ast-type-list-len types))
    (ast-type-list-new)
    (ast-type-cons
      (tc-tag-regions
        regions
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      (tc-tag-type-list-regions-at regions types (+ index 1)))))

(define (tc-project-type-list-from-region-container
  [container-ty : AstType]
  [types : AstTypeList]) : AstTypeList
  (tc-project-type-list-from-region-container-at container-ty (& types) 0))

(define (tc-project-type-list-from-region-container-at
  [container-ty : AstType]
  [types : (& types AstTypeList)]
  [index : i64]) : AstTypeList
  (if (>= index (ast-type-list-len types))
    (ast-type-list-new)
    (ast-type-cons
      (tc-project-from-region-container
        container-ty
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      (tc-project-type-list-from-region-container-at
        container-ty
        types
        (+ index 1)))))

(define (tc-enum-variant-constructor-type
  [ctx : TcContext]
  [enum-name : String]
  [lifetimes : AstLifetimeList]
  [fields : AstTypeList]) : AstType
  (let
    [ret : AstType
      (if (ast-lifetime-list-empty? (& lifetimes))
        (AstType.Enum (intern enum-name))
        (ast-ty-enum-args (intern enum-name) lifetimes))]
    (if (ast-type-list-empty? (& fields))
      ret
      (ast-ty-func (tc-resolve-type-list ctx fields) ret))))

(define (tc-bind-enum-variants
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [variants : AstVariantDefList]) : ResultTcEnv
  (tc-bind-enum-variants-in-module
    ctx
    env
    ""
    enum-name
    (ast-lifetime-list-new)
    variants))

(define (tc-bind-enum-variants-in-module
  [ctx : TcContext]
  [env : TcTypeEnv]
  [module : String]
  [enum-name : String]
  [lifetimes : AstLifetimeList]
  [variants : AstVariantDefList]) : ResultTcEnv
  (tc-bind-enum-variants-in-module-at
    ctx
    env
    module
    enum-name
    lifetimes
    (& variants)
    0))

(define (tc-bind-enum-variants-in-module-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [module : String]
  [enum-name : String]
  [lifetimes : AstLifetimeList]
  [variants : (& variants AstVariantDefList)]
  [index : i64]) : ResultTcEnv
  (if (>= index (struct-get variants len))
    (ResultTcEnv.Ok env)
    (match (ast-variant-def-list-get variants index (ast-variant-def-fallback))
      [(AstVariantDef.Def name fields _)
        (let
          [scoped-enum : String (compiler-symbol-module-key module enum-name)]
          [constructor-ty : AstType
            (tc-enum-variant-constructor-type ctx scoped-enum lifetimes fields)]
          (tc-bind-enum-variants-in-module-at
            ctx
            (tc-bind-alias-id-if-free
              env
              (tc-module-name-id module name)
              constructor-ty)
            module
            enum-name
            lifetimes
            variants
            (+ index 1)))])))

(define (tc-build-top-env-list
  [ctx : TcContext]
  [decls : AstDeclList]
  [env : TcTypeEnv]) : ResultTcEnv
  (tc-build-top-env-list-in-module ctx decls env ""))

(define (tc-build-top-env-bind-decl-in-module
  [ctx : TcContext]
  [env : TcTypeEnv]
  [module : String]
  [decl : AstDecl]) : ResultTcEnv
  (match decl
    [(AstDecl.Module _) (ResultTcEnv.Ok env)]
    [(AstDecl.ModuleBody name body-box)
      (tc-build-top-env-list-in-module
        ctx
        (box-get body-box)
        env
        (intern-str name))]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (match inner
          [(AstDecl.DefFn name _ _ _ _)
            (match (tc-top-decl-type (tc-context-with-module ctx module) inner)
              [(ResultTcType.Ok ty)
                (ResultTcEnv.Ok
                  (tc-bind-module-name-unsafe-id env module name ty))]
              [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
          [(AstDecl.Extern name kind _ _)
            (let
              [extern-ctx : TcContext (tc-context-with-module ctx module)]
              (match (tc-top-decl-type extern-ctx inner)
                [(ResultTcType.Ok ty)
                  (ResultTcEnv.Ok
                    (if (tc-extern-value-c-abi-fnptr? extern-ctx kind ty)
                      (tc-bind-module-name-unsafe-id-c-abi-fnptr
                        env
                        module
                        name
                        ty)
                      (tc-bind-module-name-unsafe-id env module name ty)))]
                [(ResultTcType.Err message) (ResultTcEnv.Err message)]))]
          [_ (ResultTcEnv.Ok env)]))]
    [(AstDecl.Def name _ _)
      (match (tc-top-decl-type-with-env
        (tc-context-with-module ctx module)
        env
        decl)
        [(ResultTcType.Ok ty)
          (ResultTcEnv.Ok (tc-bind-module-name-id env module name ty))]
        [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
    [(AstDecl.DefFn name _ _ _ _)
      (match (tc-top-decl-type (tc-context-with-module ctx module) decl)
        [(ResultTcType.Ok ty)
          (ResultTcEnv.Ok (tc-bind-module-name-id env module name ty))]
        [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
    [(AstDecl.DefDispatch name _)
      (match (tc-top-decl-type (tc-context-with-module ctx module) decl)
        [(ResultTcType.Ok ty)
          (ResultTcEnv.Ok (tc-bind-module-name-id env module name ty))]
        [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
    [(AstDecl.DefMacro _ _ _ _) (ResultTcEnv.Ok env)]
    [(AstDecl.Extern name kind _ _)
      (let
        [extern-ctx : TcContext (tc-context-with-module ctx module)]
        (match (tc-top-decl-type extern-ctx decl)
          [(ResultTcType.Ok ty)
            (ResultTcEnv.Ok
              (if (tc-extern-value-c-abi-fnptr? extern-ctx kind ty)
                (tc-bind-module-name-id-c-abi-fnptr env module name ty)
                (tc-bind-module-name-id env module name ty)))]
          [(ResultTcType.Err message) (ResultTcEnv.Err message)]))]
    [(AstDecl.DefEnum name cleanup variants)
      (let
        [name-str : String (intern-str name)]
        [scoped-name : String (compiler-symbol-module-key module name-str)]
        [enum-ty : AstType (AstType.Enum (intern scoped-name))]
        (match (tc-bind-enum-variants-in-module
          (tc-context-with-module ctx module)
          env
          module
          name-str
          (ast-lifetime-list-new)
          variants)
          [(ResultTcEnv.Ok with-variants)
            (ResultTcEnv.Ok
              (tc-bind-enum-cleanup-module-name
                with-variants
                module
                cleanup
                enum-ty))]
          [(ResultTcEnv.Err message) (ResultTcEnv.Err message)]))]
    [(AstDecl.DefEnumLifetimes name lifetimes cleanup variants)
      (let
        [name-str : String (intern-str name)]
        [scoped-name : String (compiler-symbol-module-key module name-str)]
        [enum-ty : AstType (ast-ty-enum-args (intern scoped-name) lifetimes)]
        (match (tc-bind-enum-variants-in-module
          (tc-context-with-module ctx module)
          env
          module
          name-str
          lifetimes
          variants)
          [(ResultTcEnv.Ok with-variants)
            (ResultTcEnv.Ok
              (tc-bind-enum-cleanup-module-name
                with-variants
                module
                cleanup
                enum-ty))]
          [(ResultTcEnv.Err message) (ResultTcEnv.Err message)]))]
    [(AstDecl.DefStruct name _ cleanup fields)
      (let
        [name-str : String (intern-str name)]
        [scoped-name : String (compiler-symbol-module-key module name-str)]
        [struct-ty : AstType (AstType.Struct (intern scoped-name))]
        [constructor-ty : AstType
          (ast-ty-func
            (tc-field-type-list (tc-context-with-module ctx module) fields)
            struct-ty)]
        (ResultTcEnv.Ok
          (tc-bind-struct-cleanup-module-name
            (tc-bind-module-name-id env module name constructor-ty)
            module
            cleanup
            struct-ty)))]
    [(AstDecl.DefStructLifetimes name lifetimes _ cleanup fields)
      (let
        [name-str : String (intern-str name)]
        [scoped-name : String (compiler-symbol-module-key module name-str)]
        [struct-ty : AstType
          (ast-ty-struct-args (intern scoped-name) lifetimes)]
        [constructor-ty : AstType
          (ast-ty-func
            (tc-field-type-list (tc-context-with-module ctx module) fields)
            struct-ty)]
        (ResultTcEnv.Ok
          (tc-bind-struct-cleanup-module-name
            (tc-bind-module-name-id env module name constructor-ty)
            module
            cleanup
            struct-ty)))]
    [(AstDecl.ComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (tc-build-top-env-bind-decl-in-module ctx env module template))]
    [(AstDecl.Import _) (ResultTcEnv.Ok env)]
    [(AstDecl.IncludeStr _ _) (ResultTcEnv.Ok env)]
    [(AstDecl.IncludeBin _ _) (ResultTcEnv.Ok env)]
    [(AstDecl.Test _ _ _) (ResultTcEnv.Ok env)]))

(define (tc-build-top-env-list-in-module
  [ctx : TcContext]
  [decls : AstDeclList]
  [env : TcTypeEnv]
  [module : String]) : ResultTcEnv
  (let
    [cursor : AstDeclList decls]
    [current-env : TcTypeEnv env]
    [current-module : String module]
    [message : String ""]
    [ok : bool true]
    (begin
      (while ok
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! ok false)]
          [(AstDeclListStep.Cons decl rest)
            (let
              [rest : AstDeclList rest]
              (match decl
                [(AstDecl.Module next-module)
                  (begin
                    (set! current-module (intern-str next-module))
                    (set! cursor rest))]
                [_
                  (match (tc-build-top-env-bind-decl-in-module
                    ctx
                    current-env
                    current-module
                    decl)
                    [(ResultTcEnv.Ok next-env)
                      (begin
                        (set! current-env next-env)
                        (set! cursor rest))]
                    [(ResultTcEnv.Err step-message)
                      (begin
                        (set! message step-message)
                        (set! ok false))])]))]))
      (if (string.eq message "")
        (ResultTcEnv.Ok current-env)
        (ResultTcEnv.Err message)))))

(define (tc-bind-enum-variant-aliases
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias : String]
  [importer-module : String]
  [source-module : String]
  [import-unqualified : bool]
  [enum-name : String]
  [lifetimes : AstLifetimeList]
  [variants : AstVariantDefList]) : TcTypeEnv
  (tc-bind-enum-variant-aliases-at
    ctx
    env
    alias
    importer-module
    source-module
    import-unqualified
    enum-name
    lifetimes
    (& variants)
    0))

(define (tc-bind-enum-variant-aliases-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias : String]
  [importer-module : String]
  [source-module : String]
  [import-unqualified : bool]
  [enum-name : String]
  [lifetimes : AstLifetimeList]
  [variants : (& variants AstVariantDefList)]
  [index : i64]) : TcTypeEnv
  (if (>= index (struct-get variants len))
    env
    (match (ast-variant-def-list-get variants index (ast-variant-def-fallback))
      [(AstVariantDef.Def name fields _)
        (let
          [constructor-ty : AstType
            (tc-enum-variant-constructor-type ctx enum-name lifetimes fields)]
          (tc-bind-enum-variant-aliases-at
            ctx
            (let
              [_note : unit
                (tc-unqualified-import-note-value!
                  ctx
                  env
                  alias
                  importer-module
                  source-module
                  import-unqualified
                  name)]
              (tc-bind-alias-id-if-free
                env
                (tc-module-name-id alias name)
                constructor-ty))
            alias
            importer-module
            source-module
            import-unqualified
            enum-name
            lifetimes
            variants
            (+ index 1)))])))

;; Alias construction runs after the canonical top env is built, so reuse the
;; existing `module/name` type instead of recomputing each imported decl type.
(define (tc-import-alias-source-value-type
  [env : TcTypeEnv]
  [module : String]
  [name-id : i64]) : ResultTcType
  (tc-lookup-id env (tc-module-name-id module name-id)))

(define (tc-import-alias-ast-decl-list-reverse-into
  [items : AstDeclList]
  [out : AstDeclList]) : AstDeclList
  (let
    [cursor : AstDeclList items]
    [result : AstDeclList out]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (set! result (ast-decl-list-prepend-builder decl result))
              (set! cursor rest))]))
      result)))

(define (tc-import-alias-ast-decl-list-reverse [items : AstDeclList]) : AstDeclList
  (tc-import-alias-ast-decl-list-reverse-into items (ast-decl-list-new)))

(define (tc-import-alias-summary-index-reverse-slots!
  [decls : (Array AstDeclList)]
  [count : i64]) : unit
  (let
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (array-set!
            decls
            index
            (tc-import-alias-ast-decl-list-reverse (array-ref decls index)))
          (set! index (+ index 1))))
      unit)))

(define (tc-import-alias-summary-index-build-current [all-decls : AstDeclList]) : TcImportAliasSummaryIndex
  (let
    [capacity : i64 (+ (ast-decl-list-count all-decls) 1)]
    [decls : (Array AstDeclList) (array.make-array AstDeclList capacity)]
    [modules : hashmap.I64I64Map (hashmap.i64-i64-map-with-capacity capacity)]
    [slot-count : i64 0]
    [cur : AstDeclList all-decls]
    [cur-module-id : i64 (intern "")]
    [ok : bool true]
    (begin
      (while ok
        (match (ast-decl-list-step cur)
          [(AstDeclListStep.Nil) (set! ok false)]
          [(AstDeclListStep.Cons decl rest)
            (let
              [next : AstDeclList rest]
              (match decl
                [(AstDecl.Module next-module)
                  (begin
                    (set! cur-module-id next-module)
                    (set! cur next))]
                [_
                  (let
                    [slot : i64 0]
                    [existing : AstDeclList (ast-decl-list-new)]
                    (begin
                      (match (hashmap.i64-i64-map-get modules cur-module-id)
                        [(hashmap.I64I64MapFound found-slot)
                          (begin
                            (set! slot found-slot)
                            (set! existing (array-ref decls slot)))]
                        [(hashmap.I64I64MapMissing)
                          (begin
                            (set! slot slot-count)
                            (set!
                              modules
                              (hashmap.i64-i64-map-put
                                modules
                                cur-module-id
                                slot))
                            (array-set! decls slot (ast-decl-list-new))
                            (set! slot-count (+ slot-count 1)))])
                      (array-set!
                        decls
                        slot
                        (ast-decl-list-prepend-builder decl existing))
                      (set! cur next)))]))]))
      (tc-import-alias-summary-index-reverse-slots! decls slot-count)
      (TcImportAliasSummaryIndex modules decls slot-count))))

(define (tc-import-alias-summary-index-build [all-decls : AstDeclList]) : TcImportAliasSummaryIndex
  (tc-import-alias-summary-index-build-current all-decls))

(define (tc-import-alias-summary-index-lookup
  [index : TcImportAliasSummaryIndex]
  [target-module : String]) : TcImportAliasSummaryLookup
  (match (hashmap.i64-i64-map-get
    (struct-get index modules)
    (intern target-module))
    [(hashmap.I64I64MapFound slot)
      (if (and (>= slot 0) (< slot (struct-get index count)))
        (TcImportAliasSummaryLookup.Found
          (array-ref (struct-get index decls) slot))
        (TcImportAliasSummaryLookup.Missing))]
    [(hashmap.I64I64MapMissing) (TcImportAliasSummaryLookup.Missing)]))

(define (tc-import-alias-surface-summary-backed-in?
  [summaries : CompilerLoadSurfaceSummaryList]
  [target-module : String]) : bool
  (match summaries
    [(CompilerLoadSurfaceSummaryNil) false]
    [(CompilerLoadSurfaceSummaryCons summary rest)
      (or
        (string.eq (struct-get summary module-id) target-module)
        (tc-import-alias-surface-summary-backed-in?
          (box-get rest)
          target-module))]))

(define (tc-import-alias-surface-summary-backed? [target-module : String]) : bool
  (tc-import-alias-surface-summary-backed-in?
    (compiler-load-surface-summaries)
    target-module))

(define (tc-import-alias-summary-backed?
  [index : TcImportAliasSummaryIndex]
  [target-module : String]) : bool
  (match (tc-import-alias-summary-index-lookup index target-module)
    [(TcImportAliasSummaryLookup.Found _) true]
    [(TcImportAliasSummaryLookup.Missing)
      (tc-import-alias-surface-summary-backed? target-module)]))

(define (tc-bind-import-alias-decl-in-module
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias : String]
  [importer-module : String]
  [import-unqualified : bool]
  [module : String]
  [decl : AstDecl]) : ResultTcEnv
  (match decl
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (match inner
          [(AstDecl.DefFn name _ _ _ _)
            (match (tc-import-alias-source-value-type env module name)
              [(ResultTcType.Ok ty)
                (ResultTcEnv.Ok
                  (tc-bind-import-alias-value-unsafe-id
                    ctx
                    env
                    alias
                    importer-module
                    module
                    import-unqualified
                    name
                    ty))]
              [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
          [(AstDecl.Extern name kind _ _)
            (let
              [extern-ctx : TcContext (tc-context-with-module ctx module)]
              (match (tc-import-alias-source-value-type env module name)
                [(ResultTcType.Ok ty)
                  (ResultTcEnv.Ok
                    (if (tc-extern-value-c-abi-fnptr? extern-ctx kind ty)
                      (tc-bind-import-alias-value-unsafe-c-abi-fnptr-id
                        ctx
                        env
                        alias
                        importer-module
                        module
                        import-unqualified
                        name
                        ty)
                      (tc-bind-import-alias-value-unsafe-id
                        ctx
                        env
                        alias
                        importer-module
                        module
                        import-unqualified
                        name
                        ty)))]
                [(ResultTcType.Err message) (ResultTcEnv.Err message)]))]
          [_ (ResultTcEnv.Ok env)]))]
    [(AstDecl.Def name _ _)
      (match (tc-import-alias-source-value-type env module name)
        [(ResultTcType.Ok ty)
          (ResultTcEnv.Ok
            (tc-bind-import-alias-value-id
              ctx
              env
              alias
              importer-module
              module
              import-unqualified
              name
              ty))]
        [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
    [(AstDecl.DefFn name _ _ _ _)
      (match (tc-import-alias-source-value-type env module name)
        [(ResultTcType.Ok ty)
          (ResultTcEnv.Ok
            (tc-bind-import-alias-value-id
              ctx
              env
              alias
              importer-module
              module
              import-unqualified
              name
              ty))]
        [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
    [(AstDecl.DefDispatch name _)
      (match (tc-import-alias-source-value-type env module name)
        [(ResultTcType.Ok ty)
          (ResultTcEnv.Ok
            (tc-bind-import-alias-value-id
              ctx
              env
              alias
              importer-module
              module
              import-unqualified
              name
              ty))]
        [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
    [(AstDecl.Extern name kind _ _)
      (let
        [extern-ctx : TcContext (tc-context-with-module ctx module)]
        (match (tc-import-alias-source-value-type env module name)
          [(ResultTcType.Ok ty)
            (ResultTcEnv.Ok
              (if (tc-extern-value-c-abi-fnptr? extern-ctx kind ty)
                (tc-bind-import-alias-value-c-abi-fnptr-id
                  ctx
                  env
                  alias
                  importer-module
                  module
                  import-unqualified
                  name
                  ty)
                (tc-bind-import-alias-value-id
                  ctx
                  env
                  alias
                  importer-module
                  module
                  import-unqualified
                  name
                  ty)))]
          [(ResultTcType.Err message) (ResultTcEnv.Err message)]))]
    [(AstDecl.DefEnum name cleanup variants)
      (let
        [name-str : String (intern-str name)]
        [scoped-name : String (compiler-symbol-module-key module name-str)]
        [enum-ty : AstType (AstType.Enum (intern scoped-name))]
        (ResultTcEnv.Ok
          (tc-bind-enum-cleanup-import-alias
            ctx
            (tc-bind-enum-variant-aliases
              (tc-context-with-module ctx module)
              env
              alias
              importer-module
              module
              import-unqualified
              scoped-name
              (ast-lifetime-list-new)
              variants)
            alias
            importer-module
            module
            import-unqualified
            cleanup
            enum-ty)))]
    [(AstDecl.DefEnumLifetimes name lifetimes cleanup variants)
      (let
        [name-str : String (intern-str name)]
        [scoped-name : String (compiler-symbol-module-key module name-str)]
        [enum-ty : AstType (ast-ty-enum-args (intern scoped-name) lifetimes)]
        (ResultTcEnv.Ok
          (tc-bind-enum-cleanup-import-alias
            ctx
            (tc-bind-enum-variant-aliases
              (tc-context-with-module ctx module)
              env
              alias
              importer-module
              module
              import-unqualified
              scoped-name
              lifetimes
              variants)
            alias
            importer-module
            module
            import-unqualified
            cleanup
            enum-ty)))]
    [(AstDecl.DefStruct name _ cleanup fields)
      (let
        [name-str : String (intern-str name)]
        [struct-ty : AstType
          (AstType.Struct (intern (compiler-symbol-module-key module name-str)))]
        (match (tc-import-alias-source-value-type env module name)
          [(ResultTcType.Ok constructor-ty)
            (ResultTcEnv.Ok
              (tc-bind-struct-cleanup-import-alias
                ctx
                (tc-bind-import-alias-value-id
                  ctx
                  env
                  alias
                  importer-module
                  module
                  import-unqualified
                  name
                  constructor-ty)
                alias
                importer-module
                module
                import-unqualified
                cleanup
                struct-ty))]
          [(ResultTcType.Err message) (ResultTcEnv.Err message)]))]
    [(AstDecl.DefStructLifetimes name lifetimes _ cleanup fields)
      (let
        [name-str : String (intern-str name)]
        [struct-ty : AstType
          (ast-ty-struct-args
            (intern (compiler-symbol-module-key module name-str))
            lifetimes)]
        (match (tc-import-alias-source-value-type env module name)
          [(ResultTcType.Ok constructor-ty)
            (ResultTcEnv.Ok
              (tc-bind-struct-cleanup-import-alias
                ctx
                (tc-bind-import-alias-value-id
                  ctx
                  env
                  alias
                  importer-module
                  module
                  import-unqualified
                  name
                  constructor-ty)
                alias
                importer-module
                module
                import-unqualified
                cleanup
                struct-ty))]
          [(ResultTcType.Err message) (ResultTcEnv.Err message)]))]
    [(AstDecl.ComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (tc-bind-import-alias-decl-in-module
          ctx
          env
          alias
          importer-module
          import-unqualified
          module
          template))]
    [_ (ResultTcEnv.Ok env)]))

(define (tc-bind-import-alias-module-list
  [ctx : TcContext]
  [decls : AstDeclList]
  [env : TcTypeEnv]
  [target-module : String]
  [alias : String]
  [importer-module : String]
  [import-unqualified : bool]
  [module : String]) : ResultTcEnv
  (let
    [cur : AstDeclList decls]
    [cur-env : TcTypeEnv env]
    [target-module-id : i64 (intern target-module)]
    [cur-module-id : i64 (intern module)]
    [message : String ""]
    [ok : bool true]
    (begin
      (while ok
        (match (ast-decl-list-step cur)
          [(AstDeclListStep.Nil) (set! ok false)]
          [(AstDeclListStep.Cons decl rest)
            (let
              [rest : AstDeclList rest]
              (match decl
                [(AstDecl.Module next-module)
                  (begin
                    (set! cur-module-id next-module)
                    (set! cur rest))]
                [(AstDecl.Import _) (set! cur rest)]
                [(AstDecl.IncludeStr _ _) (set! cur rest)]
                [(AstDecl.IncludeBin _ _) (set! cur rest)]
                [(AstDecl.Test _ _ _) (set! cur rest)]
                [_
                  (if (= cur-module-id target-module-id)
                    (match (tc-bind-import-alias-decl-in-module
                      ctx
                      cur-env
                      alias
                      importer-module
                      import-unqualified
                      (intern-str cur-module-id)
                      decl)
                      [(ResultTcEnv.Ok next-env)
                        (begin
                          (set! cur-env next-env)
                          (set! cur rest))]
                      [(ResultTcEnv.Err step-message)
                        (begin
                          (set! message step-message)
                          (set! ok false))])
                    (set! cur rest))]))]))
      (if (string.eq message "")
        (ResultTcEnv.Ok cur-env)
        (ResultTcEnv.Err message)))))

(define (tc-bind-import-alias-module
  [ctx : TcContext]
  [decls : AstDeclList]
  [env : TcTypeEnv]
  [target-module : String]
  [alias : String]
  [importer-module : String]
  [import-unqualified : bool]) : ResultTcEnv
  (tc-bind-import-alias-module-list
    ctx
    decls
    env
    target-module
    alias
    importer-module
    import-unqualified
    ""))

(define (tc-bind-import-alias-module-with-index
  [ctx : TcContext]
  [summary-index : TcImportAliasSummaryIndex]
  [decls : AstDeclList]
  [env : TcTypeEnv]
  [target-module : String]
  [alias : String]
  [importer-module : String]
  [import-unqualified : bool]) : ResultTcEnv
  (match (tc-import-alias-summary-index-lookup summary-index target-module)
    [(TcImportAliasSummaryLookup.Found target-decls)
      (match (tc-bind-import-alias-module-list
        ctx
        target-decls
        env
        target-module
        alias
        importer-module
        import-unqualified
        target-module)
        [(ResultTcEnv.Ok next-env) (ResultTcEnv.Ok next-env)]
        [(ResultTcEnv.Err _)
          (tc-bind-import-alias-module
            ctx
            decls
            env
            target-module
            alias
            importer-module
            import-unqualified)])]
    [(TcImportAliasSummaryLookup.Missing)
      (tc-bind-import-alias-module
        ctx
        decls
        env
        target-module
        alias
        importer-module
        import-unqualified)]))

(define (tc-import-alias-materialized-key-id
  [alias-key : String]
  [target-module : String]) : i64
  (intern (compiler-symbol-module-key alias-key target-module)))

(define (tc-import-alias-materialized? [seen : hashmap.I64I64Map] [key : i64]) : bool
  (match (hashmap.i64-i64-map-get seen key)
    [(hashmap.I64I64MapFound _) true]
    [(hashmap.I64I64MapMissing) false]))

(define (tc-build-top-env-aliases-list
  [ctx : TcContext]
  [all-decls : AstDeclList]
  [decls : AstDeclList]
  [env : TcTypeEnv]
  [module : String]) : ResultTcEnv
  (let
    [cur : AstDeclList decls]
    [cur-env : TcTypeEnv env]
    [cur-module-id : i64 (intern module)]
    [message : String ""]
    [ok : bool true]
    [summary-index : TcImportAliasSummaryIndex
      (tc-import-alias-summary-index-build all-decls)]
    [seen-aliases : hashmap.I64I64Map (hashmap.i64-i64-map-with-capacity 512)]
    (begin
      (while ok
        (match (ast-decl-list-step cur)
          [(AstDeclListStep.Nil) (set! ok false)]
          [(AstDeclListStep.Cons decl rest)
            (let
              [rest : AstDeclList rest]
              (match (ast-decl-unwrapped decl)
                [(AstDecl.Module next-module)
                  (begin
                    (set! cur-module-id next-module)
                    (set! cur rest))]
                [(AstDecl.Import
                    (AstImportSpec.Spec
                      _
                      _
                      (AstMaybeModuleName.Some target-module)
                      (AstMaybeImportAlias.Some alias)
                      _))
                  (let
                    [importer-module : String (intern-str cur-module-id)]
                    [alias-key : String
                      (compiler-symbols-import-alias-key importer-module alias)]
                    [seen-key : i64
                      (tc-import-alias-materialized-key-id
                        alias-key
                        target-module)]
                    (if (tc-import-alias-materialized? seen-aliases seen-key)
                      (set! cur rest)
                      (begin
                        (set!
                          seen-aliases
                          (hashmap.i64-i64-map-put seen-aliases seen-key 1))
                        (if (string.eq alias "")
                          (match (tc-bind-import-alias-module-with-index
                            ctx
                            summary-index
                            all-decls
                            cur-env
                            target-module
                            alias-key
                            importer-module
                            true)
                            [(ResultTcEnv.Ok next-env)
                              (begin
                                (set! cur-env next-env)
                                (set! cur rest))]
                            [(ResultTcEnv.Err step-message)
                              (begin
                                (set! message step-message)
                                (set! ok false))])
                          (begin
                            (let
                              [summary-backed : bool
                                (tc-import-alias-summary-backed?
                                  summary-index
                                  target-module)]
                              (tc-lazy-import-stub-record!
                                cur-module-id
                                alias-key
                                target-module
                                summary-backed))
                            (set! cur rest))))))]
                [_ (set! cur rest)]))]))
      (if (string.eq message "")
        (ResultTcEnv.Ok cur-env)
        (ResultTcEnv.Err message)))))

(define (tc-build-top-env [ctx : TcContext] [program : AstProgram]) : ResultTcEnv
  (begin
    (tc-nominal-owner-cache-reset!)
    (tc-unqualified-import-ambiguity-reset!)
    (tc-lazy-import-stubs-reset!)
    (match program
      [(AstProgram.Program decls-box)
        (let
          [decls : AstDeclList (box-get decls-box)]
          [base-env : TcTypeEnv (tc-default-env)]
          ;; #3792: activate the membership bloom across the bind-list so the
          ;; enum-variant alias-if-free guard is O(1) instead of rescanning the
          ;; whole top-env spine per variant.
          [_membership-begin : unit (tc-topenv-membership-begin! base-env)]
          (match (tc-build-top-env-list ctx decls base-env)
            [(ResultTcEnv.Ok env)
              (let
                [_membership-end : unit (tc-topenv-membership-end!)]
                [cached-env : TcTypeEnv (tc-env-with-cache env)]
                ;; Alias fanout copies canonical entries by lookup; cache the
                ;; source env before adding aliases so that copy is O(1).
                (match (tc-build-top-env-aliases-list
                  ctx
                  decls
                  decls
                  cached-env
                  "")
                  [(ResultTcEnv.Ok aliases)
                    (let
                      [out : TcTypeEnv (tc-env-with-cache aliases)]
                      (ResultTcEnv.Ok out))]
                  [(ResultTcEnv.Err message) (ResultTcEnv.Err message)]))]
            [(ResultTcEnv.Err message)
              (begin
                (tc-topenv-membership-end!)
                (ResultTcEnv.Err message))]))])))

(define (tc-bind-enum-variants-local
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [scoped-enum : String]
  [lifetimes : AstLifetimeList]
  [variants : AstVariantDefList]) : TcTypeEnv
  (tc-bind-enum-variants-local-at
    ctx
    env
    enum-name
    scoped-enum
    lifetimes
    (& variants)
    0))

(define (tc-bind-enum-variants-local-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [scoped-enum : String]
  [lifetimes : AstLifetimeList]
  [variants : (& variants AstVariantDefList)]
  [index : i64]) : TcTypeEnv
  (if (>= index (struct-get variants len))
    env
    (match (ast-variant-def-list-get variants index (ast-variant-def-fallback))
      [(AstVariantDef.Def name fields _)
        (let
          [constructor-ty : AstType
            (tc-enum-variant-constructor-type ctx scoped-enum lifetimes fields)]
          (tc-bind-enum-variants-local-at
            ctx
            (tc-bind-id env name constructor-ty)
            enum-name
            scoped-enum
            lifetimes
            variants
            (+ index 1)))])))

(define (tc-module-local-env-add-decl
  [ctx : TcContext]
  [env : TcTypeEnv]
  [module : String]
  [decl : AstDecl]) : ResultTcEnv
  (match decl
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (match inner
          [(AstDecl.DefFn name _ _ _ _)
            (match (tc-top-decl-type ctx inner)
              [(ResultTcType.Ok ty)
                (ResultTcEnv.Ok (tc-bind-unsafe-id env name ty))]
              [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
          [(AstDecl.Extern name kind _ _)
            (match (tc-top-decl-type ctx inner)
              [(ResultTcType.Ok ty)
                (ResultTcEnv.Ok
                  (if (tc-extern-value-c-abi-fnptr? ctx kind ty)
                    (tc-bind-unsafe-c-abi-fnptr-id env name ty)
                    (tc-bind-unsafe-id env name ty)))]
              [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
          [_ (ResultTcEnv.Ok env)]))]
    [(AstDecl.Def name _ _)
      (match (tc-top-decl-type-with-env ctx env decl)
        [(ResultTcType.Ok ty) (ResultTcEnv.Ok (tc-bind-id env name ty))]
        [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
    [(AstDecl.DefFn name _ _ _ _)
      (match (tc-top-decl-type ctx decl)
        [(ResultTcType.Ok ty) (ResultTcEnv.Ok (tc-bind-id env name ty))]
        [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
    [(AstDecl.DefDispatch name _)
      (match (tc-top-decl-type ctx decl)
        [(ResultTcType.Ok ty) (ResultTcEnv.Ok (tc-bind-id env name ty))]
        [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
    [(AstDecl.Extern name kind _ _)
      (match (tc-top-decl-type ctx decl)
        [(ResultTcType.Ok ty)
          (ResultTcEnv.Ok
            (if (tc-extern-value-c-abi-fnptr? ctx kind ty)
              (tc-bind-c-abi-fnptr-id env name ty)
              (tc-bind-id env name ty)))]
        [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
    [(AstDecl.DefEnum name cleanup variants)
      (let
        [name-str : String (intern-str name)]
        [enum-ty : AstType
          (AstType.Enum (intern (compiler-symbol-module-key module name-str)))]
        (ResultTcEnv.Ok
          (tc-bind-enum-cleanup-local
            (tc-bind-enum-variants-local
              ctx
              env
              name-str
              (compiler-symbol-module-key module name-str)
              (ast-lifetime-list-new)
              variants)
            cleanup
            enum-ty)))]
    [(AstDecl.DefEnumLifetimes name lifetimes cleanup variants)
      (let
        [name-str : String (intern-str name)]
        [enum-ty : AstType
          (ast-ty-enum-args
            (intern (compiler-symbol-module-key module name-str))
            lifetimes)]
        (ResultTcEnv.Ok
          (tc-bind-enum-cleanup-local
            (tc-bind-enum-variants-local
              ctx
              env
              name-str
              (compiler-symbol-module-key module name-str)
              lifetimes
              variants)
            cleanup
            enum-ty)))]
    [(AstDecl.DefStruct name _ cleanup fields)
      (let
        [name-str : String (intern-str name)]
        [struct-ty : AstType
          (AstType.Struct (intern (compiler-symbol-module-key module name-str)))]
        [constructor-ty : AstType
          (ast-ty-func (tc-field-type-list ctx fields) struct-ty)]
        (ResultTcEnv.Ok
          (tc-bind-struct-cleanup-local
            (tc-bind-id env name constructor-ty)
            cleanup
            struct-ty)))]
    [(AstDecl.DefStructLifetimes name lifetimes _ cleanup fields)
      (let
        [name-str : String (intern-str name)]
        [struct-ty : AstType
          (ast-ty-struct-args
            (intern (compiler-symbol-module-key module name-str))
            lifetimes)]
        [constructor-ty : AstType
          (ast-ty-func (tc-field-type-list ctx fields) struct-ty)]
        (ResultTcEnv.Ok
          (tc-bind-struct-cleanup-local
            (tc-bind-id env name constructor-ty)
            cleanup
            struct-ty)))]
    [(AstDecl.Import
        (AstImportSpec.Spec
          _
          _
          (AstMaybeModuleName.Some target-module)
          (AstMaybeImportAlias.Some alias)
          _))
      (if (string.eq alias "")
        (match (tc-context-program ctx)
          [(AstProgram.Program decls-box)
            (tc-bind-import-alias-module
              ctx
              (box-get decls-box)
              env
              target-module
              ""
              module
              true)])
        (ResultTcEnv.Ok env))]
    [(AstDecl.ComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (tc-module-local-env-add-decl ctx env module template))]
    [_ (ResultTcEnv.Ok env)]))

(define (tc-module-local-env-list
  [ctx : TcContext]
  [decls : AstDeclList]
  [env : TcTypeEnv]
  [target-module : String]
  [module : String]) : ResultTcEnv
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) (ResultTcEnv.Ok env)]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        (match decl
          [(AstDecl.Module next-module)
            (tc-module-local-env-list
              ctx
              rest
              env
              target-module
              (intern-str next-module))]
          [_
            (if (string.eq module target-module)
              (match (tc-module-local-env-add-decl ctx env target-module decl)
                [(ResultTcEnv.Ok next-env)
                  (tc-module-local-env-list
                    ctx
                    rest
                    next-env
                    target-module
                    module)]
                [(ResultTcEnv.Err message) (ResultTcEnv.Err message)])
              (tc-module-local-env-list ctx rest env target-module module))]))]))

(define (tc-module-local-env
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [module : String]) : ResultTcEnv
  (if (string.eq module "")
    (ResultTcEnv.Ok top-env)
    (match (tc-context-program ctx)
      [(AstProgram.Program decls-box)
        (let
          [decls : AstDeclList (box-get decls-box)]
          (tc-module-local-env-list
            (tc-context-with-module ctx module)
            decls
            top-env
            module
            ""))])))

(define (tc-module-local-env-cache-lookup
  [cache : TcModuleLocalEnvCache]
  [module : String]) : TcMaybeTypeEnv
  (match cache
    [(TcModuleLocalEnvCache.Nil) (TcMaybeTypeEnv.No)]
    [(TcModuleLocalEnvCache.Cons cached-module env rest)
      (if (string.eq cached-module module)
        (TcMaybeTypeEnv.Some env)
        (tc-module-local-env-cache-lookup (box-get rest) module))]))

(define (tc-module-local-env-cached
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [module : String]
  [cache : TcModuleLocalEnvCache]) : ResultTcModuleLocalEnv
  (if (string.eq module "")
    (ResultTcModuleLocalEnv.Ok top-env cache)
    (match (tc-module-local-env-cache-lookup cache module)
      [(TcMaybeTypeEnv.Some env)
        (begin
          (cfg compile-profile (compiler-tc-env-profile-note-module-local-hit))
          (ResultTcModuleLocalEnv.Ok env cache))]
      [(TcMaybeTypeEnv.No)
        (begin
          (cfg compile-profile (compiler-tc-env-profile-note-module-local-miss))
          (match (tc-module-local-env ctx top-env module)
            [(ResultTcEnv.Ok env)
              (let
                ;; The cache outlives transient scratch arenas (per-function
                ;; typecheck arenas; #2596), but `module` may have been
                ;; allocated in one: hygiene markers decode it by substring.
                ;; Copy the key into the current arena -- the hygiene caller
                ;; switches to the dedicated cache arena before inserting
                ;; (#2357) -- so the stored key cannot dangle.
                [key : String
                  (string.substring module 0 (string.string-length module))]
                (ResultTcModuleLocalEnv.Ok
                  env
                  (TcModuleLocalEnvCache.Cons key env (box cache))))]
            [(ResultTcEnv.Err message) (ResultTcModuleLocalEnv.Err message)]))])))

(define (tc-expect [actual : AstType] [expected : AstType] [message : String]) : ResultTcUnit
  (if (tc-type-compatible? expected actual)
    ResultTcUnit.Ok
    (ResultTcUnit.Err message)))

(define (tc-contextual-result-type [expected : AstType] [actual : AstType]) : AstType
  (if (tc-type-contains-any-region actual)
    actual
    expected))

(define (tc-float-literal-non-finite-message [ty-name : String]) : String
  (str_cat.str-cat "typecheck: non-finite " ty-name " literal is not supported"))

(define (tc-float-literal-f64-type [text : String]) : ResultTcType
  (match (compiler-float-parse-f64 text)
    [(CompilerFloatSomeF64 value)
      (if (compiler-float-f64-finite? value)
        (ResultTcType.Ok (AstType.F64))
        (ResultTcType.Err (tc-float-literal-non-finite-message "f64")))]
    [(CompilerFloatNoF64)
      (if (compiler-float-decimal-syntax? text)
        (ResultTcType.Err (tc-float-literal-non-finite-message "f64"))
        (ResultTcType.Err "typecheck: invalid f64 literal"))]))

(define (tc-float-literal-f32-type [text : String] [expected : AstType]) : ResultTcType
  (match (compiler-float-parse-f64 text)
    [(CompilerFloatSomeF64 value)
      (let
        [rounded : f64 (compiler-float-round-f32-as-f64 value)]
        (if (and
          (compiler-float-f64-finite? value)
          (compiler-float-f64-finite? rounded))
          (ResultTcType.Ok expected)
          (ResultTcType.Err (tc-float-literal-non-finite-message "f32"))))]
    [(CompilerFloatNoF64)
      (if (compiler-float-decimal-syntax? text)
        (ResultTcType.Err (tc-float-literal-non-finite-message "f32"))
        (ResultTcType.Err "typecheck: invalid f64 literal"))]))

(define (tc-float-literal-type-with-expected
  [text : String]
  [expected : AstType]) : ResultTcType
  (if (tc-type-eq (tc-type-strip-region expected) (AstType.F32))
    (tc-float-literal-f32-type text expected)
    (match (tc-float-literal-f64-type text)
      [(ResultTcType.Ok actual)
        (if (tc-type-compatible? expected actual)
          (ResultTcType.Ok (tc-contextual-result-type expected actual))
          (ResultTcType.Ok actual))]
      [(ResultTcType.Err message) (ResultTcType.Err message)])))

(define (tc-literal-type-checked [lit : AstLiteral]) : ResultTcType
  (match lit
    [(AstLiteral.Float text) (tc-float-literal-f64-type text)]
    [_ (ResultTcType.Ok (tc-literal-type lit))]))

(define (tc-float-literal-expr? [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-float-literal-expr? inner))]
    [(AstExpr.Literal lit)
      (match lit
        [(AstLiteral.Float _) true]
        [_ false])]
    [_ false]))

(define (tc-float-literal-expr-with-expected
  [expr : AstExpr]
  [expected : AstType]) : ResultTcType
  (match expr
    [(AstExpr.Spanned inner-box span)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-float-literal-expr-with-expected inner expected)
          [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
          [(ResultTcType.Err message)
            (tc-locate-spanned-error inner span message)]))]
    [(AstExpr.Literal lit)
      (match lit
        [(AstLiteral.Float text)
          (tc-float-literal-type-with-expected text expected)]
        [_ (ResultTcType.Ok (tc-literal-type lit))])]
    [_ (ResultTcType.Ok (AstType.F64))]))

(define (tc-integer-literal-expr? [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-integer-literal-expr? inner))]
    [(AstExpr.Literal lit)
      (match lit
        [(AstLiteral.Int _ _) true]
        [_ false])]
    [_ false]))

(define (tc-integer-literal-expr-with-expected
  [ctx : TcContext]
  [expr : AstExpr]
  [expected : AstType]) : ResultTcType
  (match expr
    [(AstExpr.Spanned inner-box span)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-integer-literal-expr-with-expected ctx inner expected)
          [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
          [(ResultTcType.Err message)
            (tc-locate-spanned-error inner span message)]))]
    [(AstExpr.Literal lit)
      (match lit
        [(AstLiteral.Int value text)
          (tc-integer-literal-type-with-expected ctx value text expected)]
        [_ (ResultTcType.Ok (tc-literal-type lit))])]
    [_ (ResultTcType.Ok (AstType.I32))]))

(define (tc-binop-types-from-left
  [ctx : TcContext]
  [env : TcTypeEnv]
  [op : AstBinOp]
  [left-ty : AstType]
  [right : AstExpr]) : ResultTcBinOpTypes
  (match (tc-expr-with-expected-or-actual ctx env right left-ty)
    [(ResultTcType.Ok right-ty)
      (match (tc-binop-type op left-ty right-ty)
        [(ResultTcType.Ok result-ty)
          (ResultTcBinOpTypes.Ok (TcBinOpTypes left-ty right-ty result-ty))]
        [(ResultTcType.Err message) (ResultTcBinOpTypes.Err message)])]
    [(ResultTcType.Err message) (ResultTcBinOpTypes.Err message)]))

(define (tc-binop-types-from-right
  [ctx : TcContext]
  [op : AstBinOp]
  [left : AstExpr]
  [right-ty : AstType]) : ResultTcBinOpTypes
  (match (tc-integer-literal-expr-with-expected ctx left right-ty)
    [(ResultTcType.Ok left-ty)
      (match (tc-binop-type op left-ty right-ty)
        [(ResultTcType.Ok result-ty)
          (ResultTcBinOpTypes.Ok (TcBinOpTypes left-ty right-ty result-ty))]
        [(ResultTcType.Err message) (ResultTcBinOpTypes.Err message)])]
    [(ResultTcType.Err message) (ResultTcBinOpTypes.Err message)]))

(define (tc-binop-types-with-same-operands
  [op : AstBinOp]
  [operand-ty : AstType]) : ResultTcBinOpTypes
  (match (tc-binop-type op operand-ty operand-ty)
    [(ResultTcType.Ok result-ty)
      (ResultTcBinOpTypes.Ok (TcBinOpTypes operand-ty operand-ty result-ty))]
    [(ResultTcType.Err message) (ResultTcBinOpTypes.Err message)]))

(define (tc-binop-expr-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [op : AstBinOp]
  [left : AstExpr]
  [right : AstExpr]) : ResultTcBinOpTypes
  (match (tc-expr ctx env left)
    [(ResultTcType.Ok left-ty)
      (if (tc-float-literal-expr? left)
        (match (tc-expr ctx env right)
          [(ResultTcType.Ok right-actual)
            (if (tc-type-eq (tc-type-strip-region right-actual) (AstType.F32))
              (match (tc-float-literal-expr-with-expected left (AstType.F32))
                [(ResultTcType.Ok _)
                  (tc-binop-types-with-same-operands op (AstType.F32))]
                [(ResultTcType.Err message) (ResultTcBinOpTypes.Err message)])
              (tc-binop-types-from-left ctx env op left-ty right))]
          [(ResultTcType.Err message) (ResultTcBinOpTypes.Err message)])
        (if (tc-integer-literal-expr? left)
          (match (tc-expr ctx env right)
            [(ResultTcType.Ok right-actual)
              (if (tc-integer-type? right-actual)
                (tc-binop-types-from-right ctx op left right-actual)
                (tc-binop-types-from-left ctx env op left-ty right))]
            [(ResultTcType.Err message) (ResultTcBinOpTypes.Err message)])
          (tc-binop-types-from-left ctx env op left-ty right)))]
    [(ResultTcType.Err message) (ResultTcBinOpTypes.Err message)]))

(define (tc-binop-contextual-operand-type [op : AstBinOp] [expected : AstType]) : AstMaybeType
  (match op
    [(AstBinOp.Add)
      (if (or (tc-integer-type? expected) (tc-float-type? expected))
        (AstMaybeType.Some expected)
        (AstMaybeType.No))]
    [(AstBinOp.Sub)
      (if (or (tc-integer-type? expected) (tc-float-type? expected))
        (AstMaybeType.Some expected)
        (AstMaybeType.No))]
    [(AstBinOp.Mul)
      (if (or (tc-integer-type? expected) (tc-float-type? expected))
        (AstMaybeType.Some expected)
        (AstMaybeType.No))]
    [(AstBinOp.Div)
      (if (or (tc-integer-type? expected) (tc-float-type? expected))
        (AstMaybeType.Some expected)
        (AstMaybeType.No))]
    [(AstBinOp.Mod)
      (if (tc-integer-type? expected)
        (AstMaybeType.Some expected)
        (AstMaybeType.No))]
    [(AstBinOp.BitAnd)
      (if (tc-integer-type? expected)
        (AstMaybeType.Some expected)
        (AstMaybeType.No))]
    [(AstBinOp.BitOr)
      (if (tc-integer-type? expected)
        (AstMaybeType.Some expected)
        (AstMaybeType.No))]
    [(AstBinOp.BitXor)
      (if (tc-integer-type? expected)
        (AstMaybeType.Some expected)
        (AstMaybeType.No))]
    [(AstBinOp.Shl)
      (if (tc-integer-type? expected)
        (AstMaybeType.Some expected)
        (AstMaybeType.No))]
    [(AstBinOp.Shr)
      (if (tc-integer-type? expected)
        (AstMaybeType.Some expected)
        (AstMaybeType.No))]
    [(AstBinOp.And)
      (if (tc-type-eq expected (AstType.Bool))
        (AstMaybeType.Some expected)
        (AstMaybeType.No))]
    [(AstBinOp.Or)
      (if (tc-type-eq expected (AstType.Bool))
        (AstMaybeType.Some expected)
        (AstMaybeType.No))]
    [_ (AstMaybeType.No)]))

(define (tc-binary-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [op : AstBinOp]
  [left : AstExpr]
  [right : AstExpr]
  [expected : AstType]) : ResultTcType
  (let
    [operand-expected : AstType
      (tc-type-without-regions (tc-resolve-type ctx expected))]
    (match (tc-binop-contextual-operand-type op operand-expected)
      [(AstMaybeType.No) (tc-expr ctx env expr)]
      [(AstMaybeType.Some operand-ty)
        (match (tc-expr-with-expected-or-actual ctx env left operand-ty)
          [(ResultTcType.Ok left-ty)
            (match (tc-expr-with-expected-or-actual ctx env right operand-ty)
              [(ResultTcType.Ok right-ty)
                (match (tc-binop-type op left-ty right-ty)
                  [(ResultTcType.Ok result-ty)
                    (if (tc-type-compatible? expected result-ty)
                      (ResultTcType.Ok
                        (tc-contextual-result-type expected result-ty))
                      (ResultTcType.Ok result-ty))]
                  [(ResultTcType.Err _) (tc-expr ctx env expr)])]
              [(ResultTcType.Err message) (ResultTcType.Err message)])]
          [(ResultTcType.Err message) (ResultTcType.Err message)])])))

(define (tc-unop-contextual-operand-type [op : AstUnOp] [expected : AstType]) : AstMaybeType
  (match op
    [(AstUnOp.Neg)
      (if (or (tc-integer-type? expected) (tc-float-type? expected))
        (AstMaybeType.Some expected)
        (AstMaybeType.No))]
    [(AstUnOp.BitNot)
      (if (tc-integer-type? expected)
        (AstMaybeType.Some expected)
        (AstMaybeType.No))]
    [(AstUnOp.Not)
      (if (tc-type-eq expected (AstType.Bool))
        (AstMaybeType.Some expected)
        (AstMaybeType.No))]))

(define (tc-unary-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [op : AstUnOp]
  [inner : AstExpr]
  [expected : AstType]) : ResultTcType
  (let
    [operand-expected : AstType
      (tc-type-without-regions (tc-resolve-type ctx expected))]
    (match (tc-unop-contextual-operand-type op operand-expected)
      [(AstMaybeType.No) (tc-expr ctx env expr)]
      [(AstMaybeType.Some operand-ty)
        (match (tc-expr-with-expected-or-actual ctx env inner operand-ty)
          [(ResultTcType.Ok inner-ty)
            (match (tc-unop-type op inner-ty)
              [(ResultTcType.Ok result-ty)
                (if (tc-type-compatible? expected result-ty)
                  (ResultTcType.Ok
                    (tc-contextual-result-type expected result-ty))
                  (ResultTcType.Ok result-ty))]
              [(ResultTcType.Err _) (tc-expr ctx env expr)])]
          [(ResultTcType.Err message) (ResultTcType.Err message)])])))

(define (tc-expr-list-with-expected-elements
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [elem-ty : AstType]) : ResultTcUnit
  (tc-expr-list-with-expected-elements-at ctx env (& exprs) 0 elem-ty))

(define (tc-expr-list-with-expected-elements-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [elem-ty : AstType]) : ResultTcUnit
  (if (>= index (struct-get exprs len))
    ResultTcUnit.Ok
    (match (tc-expr-with-expected-or-actual-id
      ctx
      env
      (ast-expr-list-get exprs index 0)
      elem-ty)
      [(ResultTcType.Ok got)
        (match (tc-expect
          got
          elem-ty
          "typecheck: array elements must have same type")
          [(ResultTcUnit.Ok)
            (tc-expr-list-with-expected-elements-at
              ctx
              env
              exprs
              (+ index 1)
              elem-ty)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
      [(ResultTcType.Err message) (ResultTcUnit.Err message)])))

(define (tc-expr-array-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [elem-ty : AstType]
  [expected-len : i64]) : ResultTcType
  (if (= (tc-expr-list-len exprs) expected-len)
    (match (tc-ensure-cleanup-resource-not-stored-list env exprs)
      [(ResultTcUnit.Ok)
        (match (tc-expr-list-with-expected-elements ctx env exprs elem-ty)
          [(ResultTcUnit.Ok)
            (ResultTcType.Ok (ast-ty-array elem-ty expected-len))]
          [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
      [(ResultTcUnit.Err message) (ResultTcType.Err message)])
    (tc-expr ctx env (AstExpr.Array exprs))))

(define (tc-expr-if-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [cond : AstExpr]
  [then-branch : AstExpr]
  [else-branch : AstExpr]
  [expected : AstType]) : ResultTcType
  (match (tc-expr ctx env cond)
    [(ResultTcType.Ok cond-ty)
      (match (tc-expect
        cond-ty
        (AstType.Bool)
        "typecheck: if condition must be bool")
        [(ResultTcUnit.Ok)
          (match (tc-expr-with-expected-or-actual ctx env then-branch expected)
            [(ResultTcType.Ok then-ty)
              (match (tc-expr-with-expected-or-actual
                ctx
                env
                else-branch
                expected)
                [(ResultTcType.Ok else-ty)
                  (if (and
                    (tc-type-compatible? expected then-ty)
                    (tc-type-compatible? expected else-ty))
                    (ResultTcType.Ok expected)
                    (tc-merge-branch-type then-ty else-ty))]
                [(ResultTcType.Err message) (ResultTcType.Err message)])]
            [(ResultTcType.Err message) (ResultTcType.Err message)])]
        [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (tc-type-list-len [types : AstTypeList]) : i64
  (ast-type-list-len (& types)))

;; Flow each tuple element into its expected element type so contextual
;; literals (e.g. f32 floats) resolve against the tuple's declared element
;; type instead of their default. Returns the resolved element types.
(define (tc-check-tuple-elements-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [types : AstTypeList]) : ResultTcTypeList
  (let
    [out : AstTypeList (ast-type-list-new)]
    (match (tc-check-tuple-elements-with-expected-into-at
      ctx
      env
      (& exprs)
      (& types)
      0
      (&mut out))
      [(ResultTcUnit.Ok) (ResultTcTypeList.Ok out)]
      [(ResultTcUnit.Err message) (ResultTcTypeList.Err message)])))

(define (tc-check-tuple-elements-with-expected-into-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs AstExprList)]
  [types : (& types AstTypeList)]
  [index : i64]
  [out : (&mut out AstTypeList)]) : ResultTcUnit
  (if (>= index (struct-get exprs len))
    (if (>= index (ast-type-list-len types))
      ResultTcUnit.Ok
      (ResultTcUnit.Err "typecheck: tuple element type mismatch"))
    (if (>= index (ast-type-list-len types))
      (ResultTcUnit.Err "typecheck: tuple element type mismatch")
      (let
        [expr-id : i64 (ast-expr-list-get exprs index 0)]
        [want : AstType
          (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))]
        (match (tc-expr-with-expected-or-actual-id ctx env expr-id want)
          [(ResultTcType.Ok got)
            (match (tc-expect got want "typecheck: tuple element type mismatch")
              [(ResultTcUnit.Ok)
                (begin
                  (ast-type-list-push
                    out
                    (ast-node-pool-reader-type-push
                      (tc-contextual-result-type want got)))
                  (tc-check-tuple-elements-with-expected-into-at
                    ctx
                    env
                    exprs
                    types
                    (+ index 1)
                    out))]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcType.Err message) (ResultTcUnit.Err message)])))))

(define (tc-expr-tuple-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [expected-elems : AstTypeList]) : ResultTcType
  (if (= (tc-expr-list-len exprs) (tc-type-list-len expected-elems))
    (match (tc-ensure-cleanup-resource-not-stored-list env exprs)
      [(ResultTcUnit.Ok)
        (match (tc-check-tuple-elements-with-expected
          ctx
          env
          exprs
          expected-elems)
          [(ResultTcTypeList.Ok result-elems)
            (ResultTcType.Ok (ast-ty-tuple result-elems))]
          [(ResultTcTypeList.Err message) (ResultTcType.Err message)])]
      [(ResultTcUnit.Err message) (ResultTcType.Err message)])
    (tc-expr ctx env (AstExpr.Tuple exprs))))

;; Flow the expected type into a begin's final expression so a contextual
;; literal in tail position resolves against it; non-final expressions keep
;; the non-contextual policy (any type is allowed).
(define (tc-begin-list-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [expected : AstType]) : ResultTcType
  (tc-begin-list-with-expected-at ctx env (& exprs) 0 expected))

(define (tc-begin-list-with-expected-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [expected : AstType]) : ResultTcType
  (if (>= index (struct-get exprs len))
    (ResultTcType.Ok (AstType.Unit))
    (if (= (+ index 1) (struct-get exprs len))
      (tc-expr-with-expected-or-actual-id
        ctx
        env
        (ast-expr-list-get exprs index 0)
        expected)
      (match (tc-expr-id ctx env (ast-expr-list-get exprs index 0))
        [(ResultTcType.Ok _)
          (tc-begin-list-with-expected-at ctx env exprs (+ index 1) expected)]
        [(ResultTcType.Err message) (ResultTcType.Err message)]))))

(define (tc-ctfe-value-type [ctx : TcContext] [value : CompilerCtfeValue]) : ResultTcType
  (match value
    [(CompilerCtfeValue.I64 _) (ResultTcType.Ok (AstType.I64))]
    [(CompilerCtfeValue.F64 _) (ResultTcType.Ok (AstType.F64))]
    [(CompilerCtfeValue.F32 _) (ResultTcType.Ok (AstType.F32))]
    [(CompilerCtfeValue.Bool _) (ResultTcType.Ok (AstType.Bool))]
    [(CompilerCtfeValue.Char _) (ResultTcType.Ok (AstType.Char))]
    [(CompilerCtfeValue.String _)
      (ResultTcType.Err "String value is compile-time only")]
    [(CompilerCtfeValue.Unit) (ResultTcType.Ok (AstType.Unit))]
    [(CompilerCtfeValue.Expr _ _) (ResultTcType.Ok (AstType.Expr))]
    [(CompilerCtfeValue.Type ty)
      (ResultTcType.Err
        (string.append
          "type value "
          (string.append
            (tc-type-render (tc-resolve-type ctx ty))
            " is compile-time only")))]
    [(CompilerCtfeValue.ExprList _) (ResultTcType.Ok (AstType.ExprList))]
    [(CompilerCtfeValue.ExprClause _)
      (ResultTcType.Ok (tc-macro-expr-clause-type))]
    [(CompilerCtfeValue.ExprClauseList _)
      (ResultTcType.Ok (tc-macro-expr-clause-list-type))]
    [(CompilerCtfeValue.ExprBindingClause _)
      (ResultTcType.Ok (tc-macro-expr-binding-clause-type))]
    [(CompilerCtfeValue.ExprBindingClauseList _)
      (ResultTcType.Ok (tc-macro-expr-binding-clause-list-type))]
    [(CompilerCtfeValue.Pattern _) (ResultTcType.Ok (tc-macro-pattern-type))]
    [(CompilerCtfeValue.PatternList _)
      (ResultTcType.Ok (tc-macro-pattern-list-type))]
    [(CompilerCtfeValue.MatchArm _) (ResultTcType.Ok (tc-macro-match-arm-type))]
    [(CompilerCtfeValue.MatchArmList _)
      (ResultTcType.Ok (tc-macro-match-arm-list-type))]
    [(CompilerCtfeValue.TypeInfo _)
      (ResultTcType.Err "TypeInfo value is compile-time only")]
    [(CompilerCtfeValue.TypeInfoBox _)
      (ResultTcType.Err "TypeInfo box value is compile-time only")]
    [(CompilerCtfeValue.TypeInfoList _)
      (ResultTcType.Err "TypeInfoList value is compile-time only")]
    [(CompilerCtfeValue.TypeField _ _)
      (ResultTcType.Err "TypeField value is compile-time only")]
    [(CompilerCtfeValue.TypeFieldList _)
      (ResultTcType.Err "TypeFieldList value is compile-time only")]
    [(CompilerCtfeValue.TypeVariantPayload _)
      (ResultTcType.Err "TypeVariantPayload value is compile-time only")]
    [(CompilerCtfeValue.TypeVariantPayloadList _)
      (ResultTcType.Err "TypeVariantPayloadList value is compile-time only")]
    [(CompilerCtfeValue.TypeVariant _ _)
      (ResultTcType.Err "TypeVariant value is compile-time only")]
    [(CompilerCtfeValue.TypeVariantList _)
      (ResultTcType.Err "TypeVariantList value is compile-time only")]))

(define (tc-ctfe-float-value? [value : CompilerCtfeValue]) : bool
  (match value
    [(CompilerCtfeValue.F64 _) true]
    [(CompilerCtfeValue.F32 _) true]
    [_ false]))

(define (tc-ctfe-value-type-with-expected
  [ctx : TcContext]
  [value : CompilerCtfeValue]
  [expected : AstType]) : ResultTcType
  (match (tc-ctfe-value-type ctx value)
    [(ResultTcType.Ok actual)
      (if (and
        (tc-ctfe-float-value? value)
        (tc-type-eq (tc-type-strip-region expected) (AstType.F32)))
        (ResultTcType.Ok expected)
        (if (tc-type-compatible? expected actual)
          (ResultTcType.Ok (tc-contextual-result-type expected actual))
          (ResultTcType.Ok actual)))]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (tc-expr-with-expected-or-actual-core
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [expected : AstType]
  [allow-mut-by-value-borrow : bool]) : ResultTcType
  (match expr
    [(AstExpr.Spanned inner-box span)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [result : ResultTcType
          (match inner
            [(AstExpr.Unsafe exprs)
              (tc-unsafe-begin-list-with-expected
                ctx
                env
                exprs
                expected
                (TcMaybeAstSourceSpan.Some span))]
            [_
              (tc-expr-with-expected-or-actual-core-id
                ctx
                env
                inner-box
                expected
                allow-mut-by-value-borrow)])]
        (match result
          [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
          [(ResultTcType.Err message)
            (tc-locate-spanned-error inner span message)]))]
    [(AstExpr.Binary op left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (tc-binary-expr-with-expected-or-actual
          ctx
          env
          expr
          op
          left
          right
          expected))]
    [(AstExpr.Unary op inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-unary-expr-with-expected-or-actual ctx env expr op inner expected))]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (tc-expr-if-with-expected-or-actual
          ctx
          env
          cond
          then-branch
          else-branch
          expected))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (match (tc-expr-id ctx env scrutinee-box)
            [(ResultTcType.Ok scrut-ty)
              (tc-match-expr-with-expected ctx env scrut-ty arms expected)]
            [(ResultTcType.Err message) (ResultTcType.Err message)])])]
    [(AstExpr.Array exprs)
      (match (tc-type-strip-region expected)
        [(AstType.Array elem-ty len)
          (tc-expr-array-with-expected-or-actual
            ctx
            env
            exprs
            (ty-node-get elem-ty)
            len)]
        [_ (tc-expr ctx env expr)])]
    [(AstExpr.Tuple exprs)
      (match (tc-type-strip-region expected)
        [(AstType.Tuple expected-elems)
          (tc-expr-tuple-with-expected-or-actual
            ctx
            env
            exprs
            (box-get expected-elems))]
        [_ (tc-expr ctx env expr)])]
    [(AstExpr.Begin exprs) (tc-begin-list-with-expected ctx env exprs expected)]
    [(AstExpr.Unsafe exprs)
      (tc-unsafe-begin-list-with-expected
        ctx
        env
        exprs
        expected
        TcMaybeAstSourceSpan.No)]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-let-bindings-for-body ctx env bindings body)
              [(ResultTcEnv.Ok next-env)
                (match (tc-expr-with-expected-or-actual-id
                  ctx
                  next-env
                  body-box
                  expected)
                  [(ResultTcType.Ok body-ty)
                    (match (tc-ensure-reference-type-does-not-escape-names
                      body-ty
                      (tc-let-binding-list-add-bound-names
                        bindings
                        TcStringList.Nil))
                      [(ResultTcUnit.Ok) (ResultTcType.Ok body-ty)]
                      [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                  [(ResultTcType.Err message) (ResultTcType.Err message)])]
              [(ResultTcEnv.Err message) (ResultTcType.Err message)]))])]
    [(AstExpr.WithRegion region body)
      (tc-with-region-expr-with-expected ctx env region body expected)]
    [(AstExpr.WithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (tc-with-escape-expr-with-expected ctx env scratch body expected))]
    [(AstExpr.WithScratch body)
      (tc-with-scratch-expr-with-expected ctx env body expected)]
    [(AstExpr.InArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (tc-in-arena-expr-with-expected ctx env arena body expected))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (tc-with-resource-expr-with-expected ctx env bindings body expected)])]
    [(AstExpr.Borrow mutable lifetime place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (if (and mutable allow-mut-by-value-borrow)
          (tc-borrow-expr-with-policy ctx env mutable lifetime place true)
          (tc-expr ctx env expr)))]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-box-expr-with-expected-or-actual ctx env inner expected))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-box-get-expr-with-expected-or-actual ctx env inner expected))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-box-take-expr-with-expected-or-actual ctx env inner expected))]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (compiler-ctfe-eval inner (tc-ctfe-env ctx) (ctfe-fuel-limit))
          [(ResultCtfe.Ok value _)
            (tc-ctfe-value-type-with-expected ctx value expected)]
          [(ResultCtfe.Err diag)
            (ResultTcType.Err (compiler-diagnostic-message (box-get diag)))]))]
    [(AstExpr.Init maybe-ty)
      (match maybe-ty
        [(AstMaybeType.No) (tc-init-expr ctx env expected)]
        [(AstMaybeType.Some ty)
          (match (tc-init-expr ctx env ty)
            [(ResultTcType.Ok actual)
              (if (tc-type-compatible? expected actual)
                (ResultTcType.Ok (tc-contextual-result-type expected actual))
                (ResultTcType.Ok actual))]
            [(ResultTcType.Err message) (ResultTcType.Err message)])])]
    [(AstExpr.Box inner-box)
      (match (tc-type-strip-region (tc-resolve-type ctx expected))
        [(AstType.Box inner-ty)
          (let
            [inner : AstExpr (ast-node-get inner-box)]
            [want : AstType (ty-node-get inner-ty)]
            (match (tc-ensure-cleanup-resource-not-stored-expr env inner)
              [(ResultTcUnit.Ok)
                (match (tc-expr-with-expected-or-actual ctx env inner want)
                  [(ResultTcType.Ok got)
                    (match (tc-expect
                      got
                      want
                      "typecheck: box inner type mismatch")
                      [(ResultTcUnit.Ok)
                        (ResultTcType.Ok
                          (tc-tag-active-region
                            env
                            (ast-ty-box (tc-contextual-result-type want got))))]
                      [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                  [(ResultTcType.Err message) (ResultTcType.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcType.Err message)]))]
        [_ (tc-expr ctx env expr)])]
    [_
      (if (tc-integer-literal-expr? expr)
        (tc-integer-literal-expr-with-expected ctx expr expected)
        (if (tc-float-literal-expr? expr)
          (tc-float-literal-expr-with-expected expr expected)
          (match (tc-expr ctx env expr)
            [(ResultTcType.Ok actual)
              (if (tc-type-compatible? expected actual)
                (ResultTcType.Ok (tc-contextual-result-type expected actual))
                (if (and
                  allow-mut-by-value-borrow
                  (tc-call-string-temporary-ref-compatible? ctx expected actual))
                  (ResultTcType.Ok expected)
                  (ResultTcType.Ok actual)))]
            [(ResultTcType.Err message) (ResultTcType.Err message)])))]))

(define (tc-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [expected : AstType]) : ResultTcType
  (tc-expr-with-expected-or-actual-core ctx env expr expected false))

(define (tc-expr-with-expected-or-actual-call-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [expected : AstType]) : ResultTcType
  (tc-expr-with-expected-or-actual-core ctx env expr expected true))

;; Id entrypoints keep the original AST node identity available to future
;; body-local type caches. The value-based forms above remain necessary for
;; synthetic expressions that were never pushed into the node pool.
(define (tc-expr-id [ctx : TcContext] [env : TcTypeEnv] [expr-id : i64]) : ResultTcType
  (let
    [result : ResultTcType (tc-expr ctx env (ast-node-get expr-id))]
    (begin
      (match result
        [(ResultTcType.Ok ty) (tc-body-type-fact-record! expr-id ty)]
        [(ResultTcType.Err _) unit])
      result)))

(define (tc-body-type-fact-lookup-profiled [_site : String] [expr-id : i64]) : TcBodyTypeFact
  (match (tc-body-type-fact-lookup expr-id)
    [(TcBodyTypeFact.Hit ty)
      (begin
        (cfg compile-profile (compiler-tc-body-fact-profile-hit _site))
        (TcBodyTypeFact.Hit ty))]
    [(TcBodyTypeFact.Miss)
      (begin
        (cfg compile-profile (compiler-tc-body-fact-profile-miss _site))
        (TcBodyTypeFact.Miss))]))

(define (tc-body-type-fact-expr-id
  [site : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]) : ResultTcType
  (match (tc-body-type-fact-lookup-profiled site expr-id)
    [(TcBodyTypeFact.Hit ty) (ResultTcType.Ok ty)]
    [(TcBodyTypeFact.Miss)
      (cfg
        compile-profile
        (compiler-tc-reinfer-profile-expr-id site ctx env expr-id)
        (tc-expr-id ctx env expr-id))]))

(define (tc-body-type-fact-list-types-into-at
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [out : (&mut out AstTypeList)]) : ResultTcUnit
  (if (>= index (struct-get exprs len))
    ResultTcUnit.Ok
    (match (tc-body-type-fact-lookup (ast-expr-list-get exprs index 0))
      [(TcBodyTypeFact.Hit ty)
        (begin
          (ast-type-list-push out (ast-node-pool-reader-type-push ty))
          (tc-body-type-fact-list-types-into-at exprs (+ index 1) out))]
      [(TcBodyTypeFact.Miss) (ResultTcUnit.Err "")])))

(define (tc-body-type-fact-list-types [exprs : AstExprList]) : ResultTcTypeList
  (if tc-body-type-facts-consuming
    (let
      [out : AstTypeList (ast-type-list-new)]
      (match (tc-body-type-fact-list-types-into-at (& exprs) 0 (&mut out))
        [(ResultTcUnit.Ok) (ResultTcTypeList.Ok out)]
        [(ResultTcUnit.Err message) (ResultTcTypeList.Err message)]))
    (ResultTcTypeList.Err "")))

(define (tc-body-type-fact-expr-list-types
  [_site : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]) : ResultTcTypeList
  (match (tc-body-type-fact-list-types exprs)
    [(ResultTcTypeList.Ok types)
      (begin
        (cfg compile-profile (compiler-tc-body-fact-profile-hit _site))
        (ResultTcTypeList.Ok types))]
    [(ResultTcTypeList.Err _)
      (begin
        (cfg compile-profile (compiler-tc-body-fact-profile-miss _site))
        (cfg
          compile-profile
          (compiler-tc-reinfer-profile-expr-list-types _site ctx env exprs)
          (tc-expr-list-types ctx env exprs)))]))

(define (tc-move-binding-type-id
  [site : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [maybe-ty : AstMaybeType]
  [init-id : i64]) : AstType
  (match maybe-ty
    [(AstMaybeType.Some t)
      (let
        [resolved : AstType (tc-resolve-type ctx t)]
        (match (tc-expr-with-expected-or-actual-id ctx env init-id resolved)
          [(ResultTcType.Ok init-ty)
            (if (tc-type-contains-any-region init-ty)
              init-ty
              resolved)]
          [(ResultTcType.Err _) resolved]))]
    [(AstMaybeType.No)
      (match (tc-body-type-fact-expr-id site ctx env init-id)
        [(ResultTcType.Ok t) t]
        [(ResultTcType.Err _) (AstType.I64)])]))

;; Contextual typing is deliberately separate from non-contextual `tc-expr-id`:
;; the same node can produce a different result type when an expected type
;; guides literal, array, tuple, borrow, or call-argument typing.
(define (tc-expr-with-expected-or-actual-core-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]
  [expected : AstType]
  [allow-mut-by-value-borrow : bool]) : ResultTcType
  (tc-expr-with-expected-or-actual-core
    ctx
    env
    (ast-node-get expr-id)
    expected
    allow-mut-by-value-borrow))

(define (tc-expr-with-expected-or-actual-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]
  [expected : AstType]) : ResultTcType
  (tc-expr-with-expected-or-actual-core-id ctx env expr-id expected false))

(define (tc-expr-with-expected-or-actual-call-arg-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr-id : i64]
  [expected : AstType]) : ResultTcType
  (tc-expr-with-expected-or-actual-core-id ctx env expr-id expected true))

(define (tc-binop-type [op : AstBinOp] [left : AstType] [right : AstType]) : ResultTcType
  (match op
    [(AstBinOp.And)
      (if (and
        (tc-type-eq left (AstType.Bool))
        (tc-type-eq right (AstType.Bool)))
        (ResultTcType.Ok (AstType.Bool))
        (ResultTcType.Err "typecheck: boolean operator expects bool operands"))]
    [(AstBinOp.Or)
      (if (and
        (tc-type-eq left (AstType.Bool))
        (tc-type-eq right (AstType.Bool)))
        (ResultTcType.Ok (AstType.Bool))
        (ResultTcType.Err "typecheck: boolean operator expects bool operands"))]
    [(AstBinOp.Eq)
      (if (tc-type-eq left right)
        (ResultTcType.Ok (AstType.Bool))
        (ResultTcType.Err "typecheck: equality operands must match"))]
    [(AstBinOp.Ne)
      (if (tc-type-eq left right)
        (ResultTcType.Ok (AstType.Bool))
        (ResultTcType.Err "typecheck: equality operands must match"))]
    [(AstBinOp.Lt) (tc-compare-binop-type left right)]
    [(AstBinOp.Le) (tc-compare-binop-type left right)]
    [(AstBinOp.Gt) (tc-compare-binop-type left right)]
    [(AstBinOp.Ge) (tc-compare-binop-type left right)]
    [(AstBinOp.Add) (tc-arithmetic-binop-type left right)]
    [(AstBinOp.Sub) (tc-arithmetic-binop-type left right)]
    [(AstBinOp.Mul) (tc-arithmetic-binop-type left right)]
    [(AstBinOp.Div) (tc-arithmetic-binop-type left right)]
    [(AstBinOp.Shl) (tc-shift-binop-type left right)]
    [(AstBinOp.Shr) (tc-shift-binop-type left right)]
    [_ (tc-integer-binop-type left right)]))

(define (tc-integer-binop-type [left : AstType] [right : AstType]) : ResultTcType
  (if (and (tc-integer-type? left) (tc-type-eq left right))
    (ResultTcType.Ok left)
    (ResultTcType.Err
      "typecheck: integer operator expects matching integer operands")))

(define (tc-arithmetic-binop-type [left : AstType] [right : AstType]) : ResultTcType
  (if (and (tc-float-type? left) (tc-type-eq left right))
    (ResultTcType.Ok left)
    (tc-integer-binop-type left right)))

(define (tc-shift-binop-type [left : AstType] [right : AstType]) : ResultTcType
  (if (tc-integer-type? left)
    (if (tc-integer-type? right)
      (ResultTcType.Ok left)
      (ResultTcType.Err "typecheck: shift count must be integer"))
    (ResultTcType.Err "typecheck: shift left operand must be integer")))

(define (tc-compare-binop-type [left : AstType] [right : AstType]) : ResultTcType
  (if (and (tc-ordered-comparison-type? left) (tc-type-eq left right))
    (ResultTcType.Ok (AstType.Bool))
    (ResultTcType.Err
      "typecheck: comparison expects matching ordered scalar operands")))

(define (tc-unop-type [op : AstUnOp] [ty : AstType]) : ResultTcType
  (match op
    [(AstUnOp.Not)
      (if (tc-type-eq ty (AstType.Bool))
        (ResultTcType.Ok (AstType.Bool))
        (ResultTcType.Err "typecheck: not expects bool"))]
    [(AstUnOp.Neg)
      (if (or (tc-integer-type? ty) (tc-float-type? ty))
        (ResultTcType.Ok ty)
        (ResultTcType.Err "typecheck: neg expects integer"))]
    [(AstUnOp.BitNot)
      (if (tc-integer-type? ty)
        (ResultTcType.Ok ty)
        (ResultTcType.Err "typecheck: bit-not expects integer"))]))

(define (tc-region-arg-builtin-name? [name : String]) : bool
  (cbi.compiler-builtin-typecheck-region-arg-id? (tc-builtin-name-id name)))

(define (tc-default-builtin-unshadowed-scan-id?
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (match env
    [(TcTypeEnv.Nil) false]
    [(TcTypeEnv.Cache ids _ _ _ shadow-flags _ partial _ below)
      (match (hashmap.i64-i64-map-get ids name-id)
        [(hashmap.I64I64MapFound index)
          (not (= (array-ref shadow-flags index) 1))]
        [(hashmap.I64I64MapMissing)
          (if partial
            (tc-default-builtin-unshadowed-scan-id? (box-get below) name-id)
            true)])]
    [(TcTypeEnv.Bind key _ rest)
      (if (= key name-id)
        false
        (if (= key (tc-default-boundary-id))
          true
          (tc-default-builtin-unshadowed-scan-id? (box-get rest) name-id)))]))

(define (tc-default-builtin-unshadowed-scan? [env : TcTypeEnv] [name : String]) : bool
  (tc-default-builtin-unshadowed-scan-id? env (tc-name-id name)))

(define (tc-name-local-bound-before-module-scan-id?
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (match env
    [(TcTypeEnv.Nil) false]
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-name-local-bound-before-module-scan-id? (box-get rest) name-id)
        false)]
    [(TcTypeEnv.Bind key _ rest)
      (if (= key name-id)
        true
        (tc-name-local-bound-before-module-scan-id? (box-get rest) name-id))]))

(define (tc-name-local-bound-before-module? [env : TcTypeEnv] [name : String]) : bool
  (tc-name-local-bound-before-module-scan-id? env (tc-name-id name)))

(define (tc-default-builtin-unshadowed-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (if (cbi.compiler-builtin-typecheck-region-arg-id? name-id)
    (tc-default-builtin-unshadowed-scan-id? env name-id)
    false))

(define (tc-default-builtin-unshadowed? [env : TcTypeEnv] [name : String]) : bool
  (tc-default-builtin-unshadowed-id? env (tc-name-id name)))

(define (tc-constructor-name? [ctx : TcContext] [name : String]) : bool
  (match ctx
    [(TcContext _ symbols registries module _)
      (let
        [lookup-name : String
          (if (and
            (> (string.string-length module) 0)
            (not (tc-name-qualified? name)))
            (compiler-symbol-module-key module name)
            name)]
        [handle : i64
          (compiler-symbols-lookup-type-or
            symbols
            lookup-name
            (compiler-symbols-missing-handle))]
        [variant-found : bool
          (compiler-symbols-handle-found?
            (compiler-registries-lookup-variant-or
              registries
              lookup-name
              (compiler-symbols-missing-handle)))]
        (if (compiler-symbols-handle-found? handle)
          (if (=
            (compiler-symbol-handle-kind handle)
            (compiler-symbol-kind-defstruct))
            true
            variant-found)
          variant-found))]))

(define (tc-call-allows-region-args?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]) : bool
  (if (tc-default-builtin-unshadowed? env name)
    true
    (match (tc-active-region env)
      [(TcMaybeString.Some _) (tc-constructor-name? ctx name)]
      [(TcMaybeString.No) false])))

(define (tc-expr-var-name [expr : AstExpr]) : TcMaybeString
  (match (ast-expr-unspan expr)
    [(AstExpr.Var name) (TcMaybeString.Some (intern-str name))]
    [_ (TcMaybeString.No)]))

(define (tc-call-arity-message-prefix) : String
  "typecheck: call arity mismatch: ")

(define (tc-call-arity-message? [message : String]) : bool
  (tc-diag-string-prefix? message (tc-call-arity-message-prefix)))

(define (tc-call-expr? [expr : AstExpr]) : bool
  (match (ast-expr-unspan expr)
    [(AstExpr.Call _ _) true]
    [_ false]))

(define (tc-locate-call-arity-error
  [inner : AstExpr]
  [span : AstSourceSpan]
  [message : String]) : ResultTcType
  (if (and
    (tc-call-expr? inner)
    (tc-call-arity-message? message)
    (not (tc-located-error? message)))
    (ResultTcType.Err (tc-located-error span message))
    (ResultTcType.Err message)))

(define (tc-locate-spanned-error
  [inner : AstExpr]
  [span : AstSourceSpan]
  [message : String]) : ResultTcType
  (match (tc-spanned-escape-error inner span message)
    [(TcMaybeString.Some rich) (ResultTcType.Err rich)]
    [(TcMaybeString.No) (tc-locate-call-arity-error inner span message)]))

(define (tc-call-arity-callee-name [func : AstExpr]) : String
  (match (tc-expr-var-name func)
    [(TcMaybeString.Some name) name]
    [(TcMaybeString.No)
      (match (ast-expr-unspan func)
        [(AstExpr.Lambda _) "lambda"]
        [_ "call target"])]))

(define (tc-call-arity-argument-word [count : i64]) : String
  (if (= count 1)
    " argument"
    " arguments"))

(define (tc-call-arity-message
  [func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]) : String
  (let
    [expected : i64 (tc-type-list-len params)]
    [actual : i64 (tc-expr-list-len args)]
    (string.append
      (tc-call-arity-message-prefix)
      (string.append
        (tc-call-arity-callee-name func)
        (string.append
          " expected "
          (string.append
            (string.int->string expected)
            (string.append
              (tc-call-arity-argument-word expected)
              (string.append
                ", got "
                (string.append
                  (string.int->string actual)
                  (tc-call-arity-argument-word actual))))))))))

;; Deferred arity-mismatch message. tc-call-arity-message is real work (two
;; list-length walks, callee-name unspan/intern, two string.int->string division loops,
;; seven string-appends) but it is only ever consumed on the arity-mismatch error
;; path, which never fires while typechecking well-formed code (the self-compile).
;; Carrying the ingredients in this enum and materializing the text only at the
;; error arms keeps the success path -- the overwhelmingly common one -- free of
;; that build, with byte-identical output for accepted programs and identical
;; diagnostics for rejected ones.
(defenum TcArityMessage
  (Literal)
  (Detailed AstExpr AstExprList AstTypeList))

(define (tc-arity-message-text [arity-msg : TcArityMessage]) : String
  (match arity-msg
    [(TcArityMessage.Literal) "typecheck: arity mismatch"]
    [(TcArityMessage.Detailed func args params)
      (tc-call-arity-message func args params)]))

(define (tc-nullary-variant-call-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]
  [enum-name : String]
  [ret : AstType]) : ResultTcType
  (match (tc-expr-var-name func)
    [(TcMaybeString.Some name)
      (let
        [lookup-name : String
          (tc-source-variant-name-for-enum ctx enum-name name)]
        [handle : i64
          (compiler-registries-lookup-variant-or
            (tc-context-registries ctx)
            lookup-name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? handle)
          (match (tc-variant-owner-name ctx handle)
            [(ResultTcString.Ok owner)
              (if (string.eq owner enum-name)
                (match (compiler-registries-variant-fields-indexed
                  (tc-context-symbols ctx)
                  handle)
                  [(ResultAstTypeList.Ok fields)
                    (if (ast-type-list-empty? (& fields))
                      (ResultTcType.Ok (tc-tag-active-region env ret))
                      (ResultTcType.Err "typecheck: arity mismatch"))]
                  [(ResultAstTypeList.Err message) (ResultTcType.Err message)])
                (ResultTcType.Err "typecheck: call target is not a function"))]
            [(ResultTcString.Err message) (ResultTcType.Err message)])
          (if (tc-name-qualified? lookup-name)
            (ResultTcType.Ok (tc-tag-active-region env ret))
            (ResultTcType.Err "typecheck: call target is not a function"))))]
    [(TcMaybeString.No)
      (ResultTcType.Err "typecheck: call target is not a function")]))

(define (tc-call-region-args-allowed-for-func
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]) : bool
  (match (tc-expr-var-name func)
    [(TcMaybeString.Some name) (tc-call-allows-region-args? ctx env name)]
    [(TcMaybeString.No) false]))

(define (tc-call-constructor-target-for-func
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]
  [params : AstTypeList]
  [ret : AstType]) : AstMaybeType
  (match (tc-expr-var-name func)
    [(TcMaybeString.Some name)
      (if (tc-constructor-name? ctx name)
        (AstMaybeType.Some (tc-constructor-target-type env params ret))
        (AstMaybeType.No))]
    [(TcMaybeString.No) (AstMaybeType.No)]))

(define (tc-lifetime-constructor-ret? [ret : AstType]) : bool
  (match ret
    [(AstType.StructArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [(AstType.EnumArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [_ false]))

(define (tc-call-lifetime-constructor-for-func?
  [ctx : TcContext]
  [func : AstExpr]
  [ret : AstType]) : bool
  (if (tc-lifetime-constructor-ret? ret)
    (match (tc-expr-var-name func)
      [(TcMaybeString.Some name) (tc-constructor-name? ctx name)]
      [(TcMaybeString.No) false])
    false))

(define (tc-lifetime-subst-type-list
  [subst : TcLifetimeSubst]
  [types : AstTypeList]) : AstTypeList
  (let
    [out : AstTypeList
      (ast-type-list-with-capacity (ast-type-list-len (& types)))]
    (begin
      (tc-lifetime-subst-type-list-into subst (& types) (&mut out) 0)
      out)))

(define (tc-lifetime-subst-type-list-into
  [subst : TcLifetimeSubst]
  [types : (& types AstTypeList)]
  [out : (&mut out AstTypeList)]
  [index : i64]) : unit
  (if (>= index (ast-type-list-len types))
    unit
    (begin
      (ast-type-list-push
        out
        (ast-node-pool-reader-type-push
          (tc-lifetime-subst-type
            subst
            (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))))
      (tc-lifetime-subst-type-list-into subst types out (+ index 1)))))

(define (tc-lifetime-subst-type [subst : TcLifetimeSubst] [ty : AstType]) : AstType
  (match ty
    [(AstType.Func args ret)
      (ast-ty-func
        (tc-lifetime-subst-type-list subst (box-get args))
        (tc-lifetime-subst-type subst (ty-node-get ret)))]
    [(AstType.Tuple elems)
      (ast-ty-tuple (tc-lifetime-subst-type-list subst (box-get elems)))]
    [(AstType.Array elem len)
      (ast-ty-array (tc-lifetime-subst-type subst (ty-node-get elem)) len)]
    [(AstType.DynArray elem)
      (ast-ty-dyn-array (tc-lifetime-subst-type subst (ty-node-get elem)))]
    [(AstType.Box elem)
      (ast-ty-box (tc-lifetime-subst-type subst (ty-node-get elem)))]
    [(AstType.Ptr elem)
      (ast-ty-ptr (tc-lifetime-subst-type subst (ty-node-get elem)))]
    [(AstType.MutPtr elem)
      (ast-ty-mut-ptr (tc-lifetime-subst-type subst (ty-node-get elem)))]
    [(AstType.Ref lifetime inner)
      (ast-ty-ref
        (tc-lifetime-subst-apply subst lifetime)
        (tc-lifetime-subst-type subst (ty-node-get inner)))]
    [(AstType.MutRef lifetime inner)
      (ast-ty-mut-ref
        (tc-lifetime-subst-apply subst lifetime)
        (tc-lifetime-subst-type subst (ty-node-get inner)))]
    [(AstType.Region region inner)
      (ast-ty-region region (tc-lifetime-subst-type subst (ty-node-get inner)))]
    [(AstType.EnumArgs name lifetimes)
      (ast-ty-enum-args name (tc-lifetime-subst-list subst (box-get lifetimes)))]
    [(AstType.StructArgs name lifetimes)
      (ast-ty-struct-args
        name
        (tc-lifetime-subst-list subst (box-get lifetimes)))]
    [(AstType.VarArgs name lifetimes)
      (ast-ty-var-args name (tc-lifetime-subst-list subst (box-get lifetimes)))]
    [_ ty]))

(define (tc-infer-lifetime-name
  [params : AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : String]
  [actual : String]) : ResultTcLifetimeSubst
  (if (tc-lifetime-list-contains params formal)
    (tc-lifetime-subst-bind subst formal actual)
    (if (string.eq formal actual)
      (ResultTcLifetimeSubst.Ok subst)
      (ResultTcLifetimeSubst.Err "typecheck: argument type mismatch"))))

(define (tc-infer-lifetime-list
  [params : AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : AstLifetimeList]
  [actual : AstLifetimeList]) : ResultTcLifetimeSubst
  (if (= (ast-lifetime-list-len (& formal)) (ast-lifetime-list-len (& actual)))
    (tc-infer-lifetime-list-at params subst (& formal) (& actual) 0)
    (ResultTcLifetimeSubst.Err "typecheck: argument type mismatch")))

(define (tc-infer-lifetime-list-at
  [params : AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : (& formal AstLifetimeList)]
  [actual : (& actual AstLifetimeList)]
  [index : i64]) : ResultTcLifetimeSubst
  (if (>= index (ast-lifetime-list-len formal))
    (ResultTcLifetimeSubst.Ok subst)
    (match (tc-infer-lifetime-name
      params
      subst
      (ast-lifetime-list-get formal index (ast-lifetime-fallback))
      (ast-lifetime-list-get actual index (ast-lifetime-fallback)))
      [(ResultTcLifetimeSubst.Ok next-subst)
        (tc-infer-lifetime-list-at params next-subst formal actual (+ index 1))]
      [(ResultTcLifetimeSubst.Err message) (ResultTcLifetimeSubst.Err message)])))

(define (tc-infer-lifetime-subst-from-type
  [ctx : TcContext]
  [params : AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : AstType]
  [actual : AstType]) : ResultTcLifetimeSubst
  (let
    [want : AstType (tc-resolve-type ctx formal)]
    [got : AstType (tc-resolve-type ctx actual)]
    (match want
      [(AstType.Ref formal-lifetime formal-inner)
        (match got
          [(AstType.Ref actual-lifetime actual-inner)
            (match (tc-infer-lifetime-name
              params
              subst
              formal-lifetime
              actual-lifetime)
              [(ResultTcLifetimeSubst.Ok next-subst)
                (tc-infer-lifetime-subst-from-type
                  ctx
                  params
                  next-subst
                  (ty-node-get formal-inner)
                  (ty-node-get actual-inner))]
              [(ResultTcLifetimeSubst.Err message)
                (ResultTcLifetimeSubst.Err message)])]
          [_ (ResultTcLifetimeSubst.Err "typecheck: argument type mismatch")])]
      [(AstType.MutRef formal-lifetime formal-inner)
        (match got
          [(AstType.MutRef actual-lifetime actual-inner)
            (match (tc-infer-lifetime-name
              params
              subst
              formal-lifetime
              actual-lifetime)
              [(ResultTcLifetimeSubst.Ok next-subst)
                (tc-infer-lifetime-subst-from-type
                  ctx
                  params
                  next-subst
                  (ty-node-get formal-inner)
                  (ty-node-get actual-inner))]
              [(ResultTcLifetimeSubst.Err message)
                (ResultTcLifetimeSubst.Err message)])]
          [_ (ResultTcLifetimeSubst.Err "typecheck: argument type mismatch")])]
      [(AstType.EnumArgs formal-name formal-lifetimes)
        (match got
          [(AstType.EnumArgs actual-name actual-lifetimes)
            (if (= formal-name actual-name)
              (tc-infer-lifetime-list
                params
                subst
                (box-get formal-lifetimes)
                (box-get actual-lifetimes))
              (ResultTcLifetimeSubst.Err "typecheck: argument type mismatch"))]
          [_ (ResultTcLifetimeSubst.Err "typecheck: argument type mismatch")])]
      [(AstType.StructArgs formal-name formal-lifetimes)
        (match got
          [(AstType.StructArgs actual-name actual-lifetimes)
            (if (= formal-name actual-name)
              (tc-infer-lifetime-list
                params
                subst
                (box-get formal-lifetimes)
                (box-get actual-lifetimes))
              (ResultTcLifetimeSubst.Err "typecheck: argument type mismatch"))]
          [_ (ResultTcLifetimeSubst.Err "typecheck: argument type mismatch")])]
      [(AstType.Tuple formal-elems)
        (match got
          [(AstType.Tuple actual-elems)
            (tc-infer-lifetime-subst-from-type-list
              ctx
              params
              subst
              (box-get formal-elems)
              (box-get actual-elems))]
          [_ (ResultTcLifetimeSubst.Err "typecheck: argument type mismatch")])]
      [(AstType.Array formal-elem formal-len)
        (match got
          [(AstType.Array actual-elem actual-len)
            (if (= formal-len actual-len)
              (tc-infer-lifetime-subst-from-type
                ctx
                params
                subst
                (ty-node-get formal-elem)
                (ty-node-get actual-elem))
              (ResultTcLifetimeSubst.Err "typecheck: argument type mismatch"))]
          [_ (ResultTcLifetimeSubst.Err "typecheck: argument type mismatch")])]
      [(AstType.DynArray formal-elem)
        (match got
          [(AstType.DynArray actual-elem)
            (tc-infer-lifetime-subst-from-type
              ctx
              params
              subst
              (ty-node-get formal-elem)
              (ty-node-get actual-elem))]
          [_ (ResultTcLifetimeSubst.Err "typecheck: argument type mismatch")])]
      [(AstType.Box formal-elem)
        (match got
          [(AstType.Box actual-elem)
            (tc-infer-lifetime-subst-from-type
              ctx
              params
              subst
              (ty-node-get formal-elem)
              (ty-node-get actual-elem))]
          [_ (ResultTcLifetimeSubst.Err "typecheck: argument type mismatch")])]
      [_
        (if (tc-type-compatible? want got)
          (ResultTcLifetimeSubst.Ok subst)
          (ResultTcLifetimeSubst.Err "typecheck: argument type mismatch"))])))

(define (tc-infer-lifetime-subst-from-type-list
  [ctx : TcContext]
  [params : AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : AstTypeList]
  [actual : AstTypeList]) : ResultTcLifetimeSubst
  (if (= (ast-type-list-len (& formal)) (ast-type-list-len (& actual)))
    (tc-infer-lifetime-subst-from-type-list-at
      ctx
      params
      subst
      (& formal)
      (& actual)
      0)
    (ResultTcLifetimeSubst.Err "typecheck: argument type mismatch")))

(define (tc-infer-lifetime-subst-from-type-list-at
  [ctx : TcContext]
  [params : AstLifetimeList]
  [subst : TcLifetimeSubst]
  [formal : (& formal AstTypeList)]
  [actual : (& actual AstTypeList)]
  [index : i64]) : ResultTcLifetimeSubst
  (if (>= index (ast-type-list-len formal))
    (ResultTcLifetimeSubst.Ok subst)
    (match (tc-infer-lifetime-subst-from-type
      ctx
      params
      subst
      (ty-node-get (ast-type-list-get formal index (ast-type-id-fallback)))
      (ty-node-get (ast-type-list-get actual index (ast-type-id-fallback))))
      [(ResultTcLifetimeSubst.Ok next-subst)
        (tc-infer-lifetime-subst-from-type-list-at
          ctx
          params
          next-subst
          formal
          actual
          (+ index 1))]
      [(ResultTcLifetimeSubst.Err message) (ResultTcLifetimeSubst.Err message)])))

(define (tc-call-immutable-ref-formal? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Ref _ _) true]
    [(AstType.Var _)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(AstType.Ref _ _) true]
        [_ false])]
    [(AstType.VarArgs _ _)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(AstType.Ref _ _) true]
        [_ false])]
    [_ false]))

(define (tc-call-mutable-ref-formal? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.MutRef _ _) true]
    [(AstType.Var _)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(AstType.MutRef _ _) true]
        [_ false])]
    [(AstType.VarArgs _ _)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(AstType.MutRef _ _) true]
        [_ false])]
    [_ false]))

(define (tc-call-actual-reference? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Ref _ _) true]
    [(AstType.MutRef _ _) true]
    [(AstType.Var _)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(AstType.Ref _ _) true]
        [(AstType.MutRef _ _) true]
        [_ false])]
    [(AstType.VarArgs _ _)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(AstType.Ref _ _) true]
        [(AstType.MutRef _ _) true]
        [_ false])]
    [_ false]))

(define (tc-call-string-temporary-ref-compatible?
  [ctx : TcContext]
  [want : AstType]
  [got : AstType]) : bool
  (and
    (tc-str-ref-type? (tc-resolve-type ctx want))
    (match (tc-type-strip-region got)
      [(AstType.String) true]
      [_ false])))

(define (tc-call-type-list-has-immutable-ref-formal?
  [ctx : TcContext]
  [types : AstTypeList]) : bool
  (tc-call-type-list-has-immutable-ref-formal-at? ctx (& types) 0))

(define (tc-call-type-list-has-immutable-ref-formal-at?
  [ctx : TcContext]
  [types : (& types AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast-type-list-len types))
    false
    (if (tc-call-immutable-ref-formal?
      ctx
      (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      true
      (tc-call-type-list-has-immutable-ref-formal-at? ctx types (+ index 1)))))

(define (tc-call-auto-borrow-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : AstExpr]) : ResultTcType
  (match (tc-borrow-place ctx env arg)
    [(ResultTcBorrowPlace.Ok place)
      (match place
        [(TcBorrowPlace lifetime referent-ty)
          (ResultTcType.Ok (ast-ty-ref lifetime referent-ty))])]
    [(ResultTcBorrowPlace.Err message) (ResultTcType.Err message)]))

(define (tc-call-auto-borrow-expr [arg : AstExpr]) : AstExpr
  (ast-node-get
    (ast-expr-borrow false AstBorrowLifetime.Inferred (ast-node-push arg))))

(define (tc-call-effective-var-arg-type
  [ctx : TcContext]
  [name : String]
  [got : AstType]) : ResultTcType
  (if (tc-call-actual-reference? ctx got)
    (ResultTcType.Ok got)
    (match (tc-borrow-place-var name got)
      [(ResultTcBorrowPlace.Ok place)
        (match place
          [(TcBorrowPlace lifetime referent-ty)
            (ResultTcType.Ok (ast-ty-ref lifetime referent-ty))])]
      [(ResultTcBorrowPlace.Err message) (ResultTcType.Err message)])))

(define (tc-call-effective-arg-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : AstExpr]
  [want : AstType]) : ResultTcType
  (if (tc-call-immutable-ref-formal? ctx want)
    (match (ast-expr-unspan arg)
      [(AstExpr.Var name)
        (let
          [name-text : String (intern-str name)]
          (if (tc-dotted-local-field-name-id? env name)
            (match (tc-expr ctx env arg)
              [(ResultTcType.Ok got)
                (if (tc-call-actual-reference? ctx got)
                  (ResultTcType.Ok got)
                  (tc-call-auto-borrow-type ctx env arg))]
              [(ResultTcType.Err message) (ResultTcType.Err message)])
            (match (tc-lookup-visible-id ctx env name)
              [(ResultTcType.Ok got)
                (tc-call-effective-var-arg-type ctx name-text got)]
              [(ResultTcType.Err message) (ResultTcType.Err message)])))]
      [_
        (match (tc-expr ctx env arg)
          [(ResultTcType.Ok got)
            (if (tc-call-actual-reference? ctx got)
              (ResultTcType.Ok got)
              (match (tc-call-auto-borrow-type ctx env arg)
                [(ResultTcType.Ok borrowed) (ResultTcType.Ok borrowed)]
                [(ResultTcType.Err message)
                  (if (tc-call-string-temporary-ref-compatible? ctx want got)
                    (ResultTcType.Ok want)
                    (ResultTcType.Err message))]))]
          [(ResultTcType.Err message) (ResultTcType.Err message)])])
    (tc-expr-with-expected-or-actual-call-arg ctx env arg want)))

(define (tc-call-effective-var-arg-expr
  [ctx : TcContext]
  [name : String]
  [got : AstType]
  [arg : AstExpr]) : ResultTcExpr
  (if (tc-call-actual-reference? ctx got)
    (ResultTcExpr.Ok arg)
    (match (tc-borrow-place-var name got)
      [(ResultTcBorrowPlace.Ok _)
        (ResultTcExpr.Ok (tc-call-auto-borrow-expr arg))]
      [(ResultTcBorrowPlace.Err message) (ResultTcExpr.Err message)])))

(define (tc-call-effective-arg-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : AstExpr]
  [want : AstType]) : ResultTcExpr
  (if (tc-call-immutable-ref-formal? ctx want)
    (if (tc-call-explicit-borrow-expr? arg)
      (ResultTcExpr.Ok arg)
      (match (ast-expr-unspan arg)
        [(AstExpr.Var name)
          (let
            [name-text : String (intern-str name)]
            (if (tc-dotted-local-field-name-id? env name)
              (match (tc-expr ctx env arg)
                [(ResultTcType.Ok got)
                  (if (tc-call-actual-reference? ctx got)
                    (ResultTcExpr.Ok arg)
                    (match (tc-call-auto-borrow-type ctx env arg)
                      [(ResultTcType.Ok _)
                        (ResultTcExpr.Ok (tc-call-auto-borrow-expr arg))]
                      [(ResultTcType.Err message) (ResultTcExpr.Err message)]))]
                [(ResultTcType.Err message) (ResultTcExpr.Err message)])
              (match (tc-lookup-visible-id ctx env name)
                [(ResultTcType.Ok got)
                  (tc-call-effective-var-arg-expr ctx name-text got arg)]
                [(ResultTcType.Err message) (ResultTcExpr.Err message)])))]
        [_
          (match (tc-expr ctx env arg)
            [(ResultTcType.Ok got)
              (if (tc-call-actual-reference? ctx got)
                (ResultTcExpr.Ok arg)
                (match (tc-call-auto-borrow-type ctx env arg)
                  [(ResultTcType.Ok _)
                    (ResultTcExpr.Ok (tc-call-auto-borrow-expr arg))]
                  [(ResultTcType.Err message)
                    (if (tc-call-string-temporary-ref-compatible? ctx want got)
                      (ResultTcExpr.Ok arg)
                      (ResultTcExpr.Err message))]))]
            [(ResultTcType.Err message) (ResultTcExpr.Err message)])]))
    (ResultTcExpr.Ok arg)))

(define (tc-infer-call-lifetime-subst
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [params : AstTypeList]
  [lifetimes : AstLifetimeList]
  [subst : TcLifetimeSubst]) : ResultTcLifetimeSubst
  (tc-infer-call-lifetime-subst-at
    ctx
    env
    (& args)
    (& params)
    0
    lifetimes
    subst))

(define (tc-infer-call-lifetime-subst-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : (& args AstExprList)]
  [params : (& params AstTypeList)]
  [index : i64]
  [lifetimes : AstLifetimeList]
  [subst : TcLifetimeSubst]) : ResultTcLifetimeSubst
  (if (>= index (struct-get args len))
    (if (>= index (ast-type-list-len params))
      (ResultTcLifetimeSubst.Ok subst)
      (ResultTcLifetimeSubst.Err "typecheck: arity mismatch"))
    (if (>= index (ast-type-list-len params))
      (ResultTcLifetimeSubst.Err "typecheck: arity mismatch")
      (let
        [arg : AstExpr (ast-node-get (ast-expr-list-get args index 0))]
        [want : AstType
          (ty-node-get (ast-type-list-get params index (ast-type-id-fallback)))]
        (match (tc-call-effective-arg-type ctx env arg want)
          [(ResultTcType.Ok got)
            (match (tc-infer-lifetime-subst-from-type
              ctx
              lifetimes
              subst
              want
              got)
              [(ResultTcLifetimeSubst.Ok next-subst)
                (tc-infer-call-lifetime-subst-at
                  ctx
                  env
                  args
                  params
                  (+ index 1)
                  lifetimes
                  next-subst)]
              [(ResultTcLifetimeSubst.Err message)
                (ResultTcLifetimeSubst.Err
                  (tc-locate-error-at-expr arg message))])]
          [(ResultTcType.Err message)
            (ResultTcLifetimeSubst.Err (tc-locate-error-at-expr arg message))])))))

(define (tc-call-lifetime-constructor-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [_func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]
  [ret : AstType]
  [allow-region-args : bool]) : ResultTcType
  (let
    [lifetimes : AstLifetimeList
      (match ret
        [(AstType.StructArgs _ params-lifetimes) (box-get params-lifetimes)]
        [(AstType.EnumArgs _ params-lifetimes) (box-get params-lifetimes)]
        [_ (ast-lifetime-list-new)])]
    (match (tc-infer-call-lifetime-subst
      ctx
      env
      args
      params
      lifetimes
      TcLifetimeSubst.Nil)
      [(ResultTcLifetimeSubst.Ok subst)
        (let
          [target : AstType
            (tc-tag-active-region env (tc-lifetime-subst-type subst ret))]
          [resolved-params : AstTypeList
            (tc-lifetime-subst-type-list subst params)]
          (match (tc-check-call-args
            ctx
            env
            args
            resolved-params
            allow-region-args
            (AstMaybeType.Some target)
            false)
            [(ResultTcUnit.Ok) (ResultTcType.Ok target)]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)]))]
      [(ResultTcLifetimeSubst.Err message) (ResultTcType.Err message)])))

(define (tc-call-function-lifetimes [params : AstTypeList] [ret : AstType]) : AstLifetimeList
  (tc-string-list-to-lifetime-list
    (tc-type-collect-reference-lifetimes-into
      ret
      (tc-type-list-collect-reference-lifetimes params TcStringList.Nil))))

(define (tc-call-lifetime-function-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [params : AstTypeList]
  [ret : AstType]
  [lifetimes : AstLifetimeList]
  [allow-region-args : bool]
  [c-abi-args : bool]) : ResultTcType
  (match (tc-infer-call-lifetime-subst
    ctx
    env
    args
    params
    lifetimes
    TcLifetimeSubst.Nil)
    [(ResultTcLifetimeSubst.Ok subst)
      (let
        [resolved-ret : AstType (tc-lifetime-subst-type subst ret)]
        [resolved-params : AstTypeList
          (tc-lifetime-subst-type-list subst params)]
        (match (tc-check-call-args
          ctx
          env
          args
          resolved-params
          allow-region-args
          (AstMaybeType.No)
          c-abi-args)
          [(ResultTcUnit.Ok)
            (ResultTcType.Ok (tc-tag-active-region env resolved-ret))]
          [(ResultTcUnit.Err message) (ResultTcType.Err message)]))]
    [(ResultTcLifetimeSubst.Err message) (ResultTcType.Err message)]))

(define (tc-call-dynamic-c-varargs-abi? [abi : AstExternAbi]) : bool
  (or
    (ast-extern-abi-c-varargs-open? abi)
    (ast-extern-abi-c-varargs-typed? abi)))

(define (tc-call-extern-abi-for-name [ctx : TcContext] [name : String]) : TcMaybeExternAbi
  (let
    [source-name : String (tc-hygiene-global-symbol-name name)]
    [module : String (tc-context-module ctx)]
    [lookup-name : String
      (if (and
        (> (string.string-length module) 0)
        (not (tc-name-qualified? source-name)))
        (compiler-symbol-module-key module source-name)
        source-name)]
    [handle : i64
      (compiler-symbols-lookup-value-or
        (tc-context-symbols ctx)
        lookup-name
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (if (= (compiler-symbol-handle-kind handle) (compiler-symbol-kind-extern))
        (match (compiler-symbols-decl-at-index
          (tc-context-symbols ctx)
          (compiler-symbol-handle-index handle))
          [(ResultAstDecl.Ok decl)
            (match decl
              [(AstDecl.Extern _ kind metadata _)
                (match kind
                  [(AstExternKind.Function)
                    (TcMaybeExternAbi.Some (ast-extern-metadata-abi metadata))]
                  [(AstExternKind.Value) (TcMaybeExternAbi.No)])]
              [_ (TcMaybeExternAbi.No)])]
          [(ResultAstDecl.Err _) (TcMaybeExternAbi.No)])
        (TcMaybeExternAbi.No))
      (TcMaybeExternAbi.No))))

(define (tc-call-extern-abi [ctx : TcContext] [func : AstExpr]) : TcMaybeExternAbi
  (match (ast-expr-unspan func)
    [(AstExpr.Var name) (tc-call-extern-abi-for-name ctx (intern-str name))]
    [_ (TcMaybeExternAbi.No)]))

(define (tc-c-abi-fnptr-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Func _ _) true]
    [_ false]))

(define (tc-extern-value-c-abi-fnptr?
  [ctx : TcContext]
  [kind : AstExternKind]
  [ty : AstType]) : bool
  (match kind
    [(AstExternKind.Value) (tc-c-abi-fnptr-type? (tc-resolve-type ctx ty))]
    [(AstExternKind.Function) false]))

(define (tc-expr-list-last-c-abi-fnptr?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]) : bool
  (if (ast-expr-list-empty? (& exprs))
    false
    (tc-expr-c-abi-fnptr?
      ctx
      env
      (ast-node-get
        (ast-expr-list-get (& exprs) (- (struct-get (& exprs) len) 1) 0)))))

(define (tc-hygiene-c-abi-fnptr-binding?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]) : bool
  (match (tc-hygiene-global-decode name)
    [(TcHygieneGlobalName.Legacy global-name)
      (tc-binding-c-abi-fnptr-id? env (tc-name-id global-name))]
    [(TcHygieneGlobalName.Context module global-name)
      (match (tc-hygiene-definition-env ctx module)
        [(ResultTcEnv.Ok def-env)
          (tc-binding-c-abi-fnptr-id? def-env (tc-name-id global-name))]
        [(ResultTcEnv.Err _) false])]))

(define (tc-expr-c-abi-fnptr?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]) : bool
  (match (ast-expr-unspan expr)
    [(AstExpr.Var name)
      (let
        [text : String (intern-str name)]
        (if (tc-hygiene-global-name? text)
          (tc-hygiene-c-abi-fnptr-binding? ctx env text)
          (tc-binding-c-abi-fnptr-id? env name)))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-c-abi-fnptr? ctx env inner))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-let-bindings-for-body ctx env bindings body)
              [(ResultTcEnv.Ok next-env)
                (tc-expr-c-abi-fnptr? ctx next-env body)]
              [(ResultTcEnv.Err _) false]))])]
    [(AstExpr.Begin exprs) (tc-expr-list-last-c-abi-fnptr? ctx env exprs)]
    [(AstExpr.If _ then-box else-box)
      (let
        [then-branch : AstExpr (ast-node-get then-box)]
        [else-branch : AstExpr (ast-node-get else-box)]
        (and
          (tc-expr-c-abi-fnptr? ctx env then-branch)
          (tc-expr-c-abi-fnptr? ctx env else-branch)))]
    [_ false]))

(define (tc-name-base-eq? [name : String] [base : String]) : bool
  (if (string.eq name base)
    true
    (if (tc-name-qualified? name)
      (string.eq (tc-qualified-name-base name) base)
      false)))

(define (tc-arena-type-name) : String
  "stdlib.arena/Arena")

(define (tc-arena-module-name) : String
  "stdlib.arena")

(define (tc-arena-mark-type-name) : String
  "stdlib.arena/ArenaMark")

(define (tc-arena-phase-type-name) : String
  "stdlib.arena/ArenaPhase")

(define (tc-nominal-struct-type-name-eq?
  [ctx : TcContext]
  [ty : AstType]
  [name : String]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct actual) (string.eq (intern-str actual) name)]
    [(AstType.StructArgs actual _) (string.eq (intern-str actual) name)]
    [_ false]))

(define (tc-arena-type? [ctx : TcContext] [ty : AstType]) : bool
  (tc-nominal-struct-type-name-eq? ctx ty (tc-arena-type-name)))

(define (tc-arena-mark-type? [ctx : TcContext] [ty : AstType]) : bool
  (tc-nominal-struct-type-name-eq? ctx ty (tc-arena-mark-type-name)))

(define (tc-arena-phase-type? [ctx : TcContext] [ty : AstType]) : bool
  (tc-nominal-struct-type-name-eq? ctx ty (tc-arena-phase-type-name)))

(define (tc-arena-owner-call-name?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [base : String]) : bool
  (if (tc-name-qualified? name)
    (string.eq (tc-qualified-name-base name) base)
    (and
      (string.eq name base)
      (or
        (not (tc-name-local-bound-before-module? env base))
        (string.eq (tc-context-module ctx) (tc-arena-module-name))))))

(define (tc-arena-canonical-call-name?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [base : String]) : bool
  (string.eq
    (tc-call-builtin-lookup-name ctx env name)
    (compiler-symbol-module-key (tc-arena-module-name) base)))

(define (tc-arena-safe-call-name?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [base : String]) : bool
  (or
    (tc-arena-canonical-call-name? ctx env name base)
    (and
      (tc-arena-owner-call-name? ctx env name base)
      (or
        (tc-source-name-bound-exact? env name)
        (and
          (not (tc-name-qualified? name))
          (string.eq (tc-context-module ctx) (tc-arena-module-name)))))))

(define (tc-arena-owner-kind-none) : i64
  0)

(define (tc-arena-owner-kind-ordinary) : i64
  1)

(define (tc-arena-owner-kind-atomic) : i64
  2)

(define (tc-arena-owner-call-kind
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]) : i64
  (match (ast-expr-unspan expr)
    [(AstExpr.Call func-box args)
      (if (ast-expr-list-empty? (& args))
        (match (tc-expr-var-name (ast-node-get func-box))
          [(TcMaybeString.Some name)
            (cond
              [(or
                  (tc-arena-owner-call-name? ctx env name "arena-make-atomic")
                  (tc-arena-canonical-call-name? ctx env name "make-atomic"))
                (tc-arena-owner-kind-atomic)]
              [(or
                  (tc-arena-owner-call-name? ctx env name "arena-make")
                  (tc-arena-canonical-call-name? ctx env name "make"))
                (tc-arena-owner-kind-ordinary)]
              [else (tc-arena-owner-kind-none)])]
          [(TcMaybeString.No) (tc-arena-owner-kind-none)])
        (tc-arena-owner-kind-none))]
    [_ (tc-arena-owner-kind-none)]))

(define (tc-phase-call-owner
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]) : TcMaybeString
  (match (ast-expr-unspan expr)
    [(AstExpr.Call func-box args)
      (if (= (struct-get (& args) len) 1)
        (let
          [owner-expr : AstExpr (ast-node-get (ast-expr-list-get (& args) 0 0))]
          (match (tc-expr-var-name (ast-node-get func-box))
            [(TcMaybeString.Some name)
              (if (tc-arena-safe-call-name? ctx env name "phase")
                (match (tc-expr-var-name owner-expr)
                  [(TcMaybeString.Some owner)
                    (if (or
                      (tc-ordinary-arena-owner-active? env owner)
                      (tc-atomic-arena-owner-active? env owner))
                      (TcMaybeString.Some owner)
                      (TcMaybeString.No))]
                  [(TcMaybeString.No) (TcMaybeString.No)])
                (TcMaybeString.No))]
            [(TcMaybeString.No) (TcMaybeString.No)]))
        (TcMaybeString.No))]
    [_ (TcMaybeString.No)]))

(define (tc-bind-arena-owner-if-needed-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [init : AstExpr]) : TcTypeEnv
  (let
    [kind : i64 (tc-arena-owner-call-kind ctx env init)]
    (cond
      [(= kind (tc-arena-owner-kind-atomic))
        (tc-bind-atomic-arena-owner env (intern-str name))]
      [(= kind (tc-arena-owner-kind-ordinary))
        (tc-bind-ordinary-arena-owner env (intern-str name))]
      [else env])))

(define (tc-bind-arena-phase-if-needed-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [init : AstExpr]) : TcTypeEnv
  (match (tc-phase-call-owner ctx env init)
    [(TcMaybeString.Some owner)
      (tc-bind-arena-phase-token env (intern-str name) owner)]
    [(TcMaybeString.No) env]))

(define (tc-bind-c-abi-fnptr-if-needed-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [ty : AstType]
  [init : AstExpr]) : TcTypeEnv
  (let
    [owner-env : TcTypeEnv
      (if (or
        (tc-type-eq (tc-type-strip-region ty) (AstType.I64))
        (tc-arena-type? ctx ty))
        (tc-bind-arena-owner-if-needed-id ctx env name init)
        env)]
    [phase-env : TcTypeEnv
      (tc-bind-arena-phase-if-needed-id ctx owner-env name init)]
    (if (and (tc-c-abi-fnptr-type? ty) (tc-expr-c-abi-fnptr? ctx env init))
      (tc-bind-c-abi-fnptr-id phase-env name ty)
      (tc-bind-id phase-env name ty))))

(define (tc-raw-c-fnptr-flow-ok
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [expected : AstType]
  [c-abi-position : bool]) : ResultTcUnit
  (if (and
    (not c-abi-position)
    (tc-c-abi-fnptr-type? expected)
    (tc-expr-c-abi-fnptr? ctx env expr))
    (ResultTcUnit.Err
      (tc-locate-error-at-expr
        expr
        "typecheck: raw C function pointer cannot be used as a TypeLisp function value"))
    ResultTcUnit.Ok))

(define (tc-call-varargs-tail-args [args : AstExprList] [params : AstTypeList]) : ResultTcExprList
  (tc-call-varargs-tail-args-at (& args) (& params) 0))

(define (tc-call-varargs-tail-args-at
  [args : (& args AstExprList)]
  [params : (& params AstTypeList)]
  [index : i64]) : ResultTcExprList
  (if (>= index (ast-type-list-len params))
    (ResultTcExprList.Ok (ast-expr-list-tail-from-ref args index))
    (if (< index (struct-get args len))
      (tc-call-varargs-tail-args-at args params (+ index 1))
      (ResultTcExprList.Err "typecheck: arity mismatch"))))

(define (tc-type-list-append [a : AstTypeList] [b : AstTypeList]) : AstTypeList
  (let
    [out : AstTypeList
      (ast-type-list-with-capacity
        (+ (ast-type-list-len (& a)) (ast-type-list-len (& b))))]
    (begin
      (ast-type-list-append-from (&mut out) (& a) 0)
      (ast-type-list-append-from (&mut out) (& b) 0)
      out)))

(define (tc-type-list-repeat [ty : AstType] [count : i64]) : AstTypeList
  (let
    [out : AstTypeList (ast-type-list-with-capacity count)]
    [id : i64 (ast-node-pool-reader-type-push ty)]
    (begin
      (tc-type-list-repeat-into (&mut out) id count)
      out)))

(define (tc-type-list-repeat-into
  [out : (&mut out AstTypeList)]
  [id : i64]
  [count : i64]) : unit
  (if (<= count 0)
    unit
    (begin
      (ast-type-list-push out id)
      (tc-type-list-repeat-into out id (- count 1)))))

(define (tc-call-open-varargs-tail-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]) : ResultTcTypeList
  (let
    [out : AstTypeList (ast-type-list-new)]
    (match (tc-call-open-varargs-tail-types-into-at
      ctx
      env
      (& args)
      0
      (&mut out))
      [(ResultTcUnit.Ok) (ResultTcTypeList.Ok out)]
      [(ResultTcUnit.Err message) (ResultTcTypeList.Err message)])))

(define (tc-call-open-varargs-tail-types-into-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : (& args AstExprList)]
  [index : i64]
  [out : (&mut out AstTypeList)]) : ResultTcUnit
  (if (>= index (struct-get args len))
    ResultTcUnit.Ok
    (let
      [arg : AstExpr (ast-node-get (ast-expr-list-get args index 0))]
      (match (tc-expr ctx env arg)
        [(ResultTcType.Ok ty)
          (let
            [resolved : AstType (tc-resolve-type ctx ty)]
            (if (tc-extern-abi-value-type-ok? ctx resolved)
              (begin
                (ast-type-list-push out (ast-node-pool-reader-type-push ty))
                (tc-call-open-varargs-tail-types-into-at
                  ctx
                  env
                  args
                  (+ index 1)
                  out))
              (ResultTcUnit.Err
                (tc-extern-abi-unsupported-message "variadic argument" resolved))))]
        [(ResultTcType.Err message) (ResultTcUnit.Err message)]))))

(define (tc-call-extern-varargs-params
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [params : AstTypeList]
  [abi : AstExternAbi]) : ResultTcTypeList
  (match (tc-call-varargs-tail-args args params)
    [(ResultTcExprList.Ok tail-args)
      (if (ast-extern-abi-c-varargs-open? abi)
        (match (tc-call-open-varargs-tail-types ctx env tail-args)
          [(ResultTcTypeList.Ok tail-types)
            (ResultTcTypeList.Ok (tc-type-list-append params tail-types))]
          [(ResultTcTypeList.Err message) (ResultTcTypeList.Err message)])
        (if (ast-extern-abi-c-varargs-typed? abi)
          (let
            [tail-ty : AstType
              (tc-resolve-type ctx (ast-extern-abi-varargs-tail-type abi))]
            (ResultTcTypeList.Ok
              (tc-type-list-append
                params
                (tc-type-list-repeat tail-ty (tc-expr-list-len tail-args)))))
          (ResultTcTypeList.Ok params)))]
    [(ResultTcExprList.Err message) (ResultTcTypeList.Err message)]))

(define (tc-call-function-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]
  [ret : AstType]) : ResultTcType
  (match (tc-call-extern-abi ctx func)
    [(TcMaybeExternAbi.Some abi)
      (if (tc-call-dynamic-c-varargs-abi? abi)
        (match (tc-call-extern-varargs-params ctx env args params abi)
          [(ResultTcTypeList.Ok expanded-params)
            (tc-call-function-type-normal
              ctx
              env
              func
              args
              expanded-params
              ret
              true)]
          [(ResultTcTypeList.Err message) (ResultTcType.Err message)])
        (tc-call-function-type-normal ctx env func args params ret true))]
    [(TcMaybeExternAbi.No)
      (tc-call-function-type-normal
        ctx
        env
        func
        args
        params
        ret
        (tc-expr-c-abi-fnptr? ctx env func))]))

(define (tc-thread-name-last-dot [name : String]) : i64
  (let
    [first : i64 (tc-name-first-dot name)]
    (if (< first 0)
      -1
      (let
        [i : i64 (+ first 1)]
        [n : i64 (string.string-length name)]
        [last : i64 first]
        (begin
          (while (< i n)
            (begin
              (if (string.char-eq (string.string-ref name i) '.')
                (set! last i)
                unit)
              (set! i (+ i 1))))
          last)))))

(define (tc-thread-name-base [name : String]) : String
  (if (tc-name-qualified? name)
    (tc-qualified-name-base name)
    name))

(define (tc-thread-source-name-base [name : String]) : String
  (if (tc-name-qualified? name)
    (tc-qualified-name-base name)
    (let
      [dot : i64 (tc-thread-name-last-dot name)]
      (if (and (>= dot 0) (< dot (- (string.string-length name) 1)))
        (string.substring
          name
          (+ dot 1)
          (- (string.string-length name) (+ dot 1)))
        name))))

(define (tc-thread-name-base-eq? [name : String] [base : String]) : bool
  (tc-name-base-eq? name base))

(define (tc-thread-generated-module-prefix) : String
  "stdlib.thread.generated.")

(define (tc-thread-generated-module? [module : String]) : bool
  (tc-string-prefix? module (tc-thread-generated-module-prefix)))

(define (tc-thread-generated-module-type-key [module : String]) : String
  (let
    [prefix-len : i64
      (string.string-length (tc-thread-generated-module-prefix))]
    [module-len : i64 (string.string-length module)]
    (if (tc-thread-generated-module? module)
      (string.substring module prefix-len (- module-len prefix-len))
      "")))

(define (tc-thread-generated-name-module [name : String] [base : String]) : TcMaybeString
  (if (tc-name-qualified? name)
    (let
      [module : String (tc-qualified-name-module name)]
      (if (and
        (tc-thread-generated-module? module)
        (string.eq (tc-qualified-name-base name) base))
        (TcMaybeString.Some module)
        (TcMaybeString.No)))
    (TcMaybeString.No)))

(define (tc-thread-generated-name? [name : String] [base : String]) : bool
  (match (tc-thread-generated-name-module name base)
    [(TcMaybeString.Some _) true]
    [(TcMaybeString.No) false]))

(define (tc-thread-type-name-base? [name : String] [base : String]) : bool
  (string.eq (tc-thread-name-base name) base))

(define (tc-thread-generated-handle-type-name? [name : String]) : bool
  (or
    (tc-thread-generated-name? name "Handle")
    (and
      (not (tc-name-qualified? name))
      (>= (tc-thread-name-last-dot name) 0)
      (string.eq (tc-thread-source-name-base name) "Handle"))))

(define (tc-spawn-string-name? [name : String]) : bool
  (string.eq (tc-thread-source-name-base name) "spawn-string"))

(define (tc-spawn-array-i64-name? [name : String]) : bool
  (string.eq (tc-thread-source-name-base name) "spawn-array-i64"))

(define (tc-spawn-box-i64-name? [name : String]) : bool
  (string.eq (tc-thread-source-name-base name) "spawn-box-i64"))

(define (tc-thread-legacy-safe-spawn-base? [base : String]) : bool
  (or
    (string.eq base "spawn-string")
    (string.eq base "spawn-array-i64")
    (string.eq base "spawn-box-i64")))

(define (tc-thread-legacy-safe-spawn-name? [name : String]) : bool
  (tc-thread-legacy-safe-spawn-base? (tc-thread-source-name-base name)))

(define (tc-thread-safe-handle-type-name? [name : String]) : bool
  (let
    [base : String (tc-thread-name-base name)]
    (or
      (tc-thread-generated-handle-type-name? name)
      (string.eq base "ThreadString")
      (string.eq base "ThreadArrayI64")
      (string.eq base "ThreadBoxI64"))))

(define (tc-thread-spawn-lookup-name
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-name : String]) : String
  (match (tc-source-name-lookup-key ctx env source-name)
    [(ResultTcString.Ok lookup-name) lookup-name]
    [(ResultTcString.Err _) source-name]))

(define (tc-thread-potential-safe-spawn-name?
  [source-name : String]
  [lookup-name : String]) : bool
  (or
    (tc-thread-legacy-safe-spawn-name? source-name)
    (tc-thread-legacy-safe-spawn-name? lookup-name)
    (tc-thread-generated-name? lookup-name "spawn")
    (string.eq (tc-thread-source-name-base source-name) "spawn")
    (string.eq (tc-thread-name-base lookup-name) "spawn")))

(define (tc-thread-potential-safe-spawn-dotted-source-name?
  [source-name : String]) : bool
  (tc-string-has-suffix? source-name ".spawn"))

(define (tc-thread-potential-safe-spawn-source-name? [source-name : String]) : bool
  (let
    [base : String (tc-thread-source-name-base source-name)]
    (or (string.eq base "spawn") (tc-thread-legacy-safe-spawn-base? base))))

(define (tc-thread-safe-spawn-call-name
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]) : TcMaybeString
  (match (tc-expr-var-name func)
    [(TcMaybeString.Some name)
      (if (tc-thread-potential-safe-spawn-source-name? name)
        (if (tc-thread-potential-safe-spawn-name?
          name
          (tc-thread-spawn-lookup-name ctx env name))
          (TcMaybeString.Some name)
          (TcMaybeString.No))
        (TcMaybeString.No))]
    [(TcMaybeString.No) (TcMaybeString.No)]))

(define (tc-thread-channel-send-name? [name : String]) : bool
  (let
    [base : String (tc-thread-source-name-base name)]
    (and
      (tc-string-prefix? base "channel-")
      (tc-string-has-suffix? base "-send"))))

(define (tc-thread-channel-send-call-name [func : AstExpr]) : TcMaybeString
  (match (tc-expr-var-name func)
    [(TcMaybeString.Some name)
      (if (tc-thread-channel-send-name? name)
        (TcMaybeString.Some name)
        (TcMaybeString.No))]
    [(TcMaybeString.No) (TcMaybeString.No)]))

(define (tc-thread-channel-send-result-name? [name : String]) : bool
  (tc-string-has-suffix? (tc-thread-name-base name) "SendResult"))

(define (tc-thread-channel-send-result-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Enum name)
      (tc-thread-channel-send-result-name? (intern-str name))]
    [(AstType.EnumArgs name _)
      (tc-thread-channel-send-result-name? (intern-str name))]
    [_ false]))

(define (tc-thread-channel-send-message-param [params : AstTypeList]) : ResultTcType
  (if (= (ast-type-list-len (& params)) 2)
    (ResultTcType.Ok
      (ty-node-get (ast-type-list-get (& params) 1 (ast-type-id-fallback))))
    (ResultTcType.Err
      "typecheck: channel send expects channel and message parameters")))

(define (tc-thread-channel-send-message-arg [args : AstExprList]) : ResultTcExpr
  (if (= (struct-get (& args) len) 2)
    (ResultTcExpr.Ok (ast-node-get (ast-expr-list-get (& args) 1 0)))
    (ResultTcExpr.Err
      "typecheck: channel send expects channel and message arguments")))

(define (tc-thread-generated-spawn-result-module
  [ctx : TcContext]
  [ty : AstType]) : TcMaybeString
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Enum name)
      (tc-thread-generated-name-module (intern-str name) "SpawnResult")]
    [(AstType.EnumArgs name _)
      (tc-thread-generated-name-module (intern-str name) "SpawnResult")]
    [_ (TcMaybeString.No)]))

(define (tc-thread-spawn-result-type-base? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Enum name)
      (tc-thread-type-name-base? (intern-str name) "SpawnResult")]
    [(AstType.EnumArgs name _)
      (tc-thread-type-name-base? (intern-str name) "SpawnResult")]
    [_ false]))

(define (tc-thread-safe-spawn-result-type-name? [name : String]) : bool
  (let
    [base : String (tc-thread-name-base name)]
    (or
      (string.eq base "SpawnResult")
      (string.eq base "ThreadStringSpawnResult")
      (string.eq base "ThreadArrayI64SpawnResult")
      (string.eq base "ThreadBoxI64SpawnResult"))))

(define (tc-thread-safe-user-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Struct name) (tc-thread-safe-handle-type-name? (intern-str name))]
    [(AstType.StructArgs name _)
      (tc-thread-safe-handle-type-name? (intern-str name))]
    [(AstType.Enum name)
      (tc-thread-safe-spawn-result-type-name? (intern-str name))]
    [(AstType.EnumArgs name _)
      (tc-thread-safe-spawn-result-type-name? (intern-str name))]
    [_ false]))

(define (tc-thread-generated-spawn-module
  [ctx : TcContext]
  [source-name : String]
  [lookup-name : String]
  [ret : AstType]) : TcMaybeString
  (match (tc-thread-generated-name-module lookup-name "spawn")
    [(TcMaybeString.Some module) (TcMaybeString.Some module)]
    [(TcMaybeString.No)
      (if (or
        (string.eq (tc-thread-source-name-base source-name) "spawn")
        (string.eq (tc-thread-name-base lookup-name) "spawn"))
        (match (tc-thread-generated-spawn-result-module ctx ret)
          [(TcMaybeString.Some module) (TcMaybeString.Some module)]
          [(TcMaybeString.No)
            (if (tc-thread-spawn-result-type-base? ctx ret)
              (TcMaybeString.Some "")
              (TcMaybeString.No))])
        (TcMaybeString.No))]))

(define (tc-thread-generated-spawn-result-type?
  [ctx : TcContext]
  [module : String]
  [ty : AstType]) : bool
  (if (string.eq module "")
    (tc-thread-spawn-result-type-base? ctx ty)
    (match (tc-thread-generated-spawn-result-module ctx ty)
      [(TcMaybeString.Some result-module) (string.eq result-module module)]
      [(TcMaybeString.No) false])))

(define (tc-thread-legacy-safe-spawn-result-type-name?
  [spawn-name : String]
  [result-name : String]) : bool
  (cond
    [(tc-spawn-string-name? spawn-name)
      (tc-thread-name-base-eq? result-name "ThreadStringSpawnResult")]
    [(tc-spawn-array-i64-name? spawn-name)
      (tc-thread-name-base-eq? result-name "ThreadArrayI64SpawnResult")]
    [(tc-spawn-box-i64-name? spawn-name)
      (tc-thread-name-base-eq? result-name "ThreadBoxI64SpawnResult")]
    [else false]))

(define (tc-thread-safe-spawn-result-type?
  [ctx : TcContext]
  [source-name : String]
  [lookup-name : String]
  [generated-module : TcMaybeString]
  [ty : AstType]) : bool
  (match generated-module
    [(TcMaybeString.Some module)
      (tc-thread-generated-spawn-result-type? ctx module ty)]
    [(TcMaybeString.No)
      (match (tc-type-strip-region (tc-resolve-type ctx ty))
        [(AstType.Enum name)
          (or
            (tc-thread-legacy-safe-spawn-result-type-name?
              source-name
              (intern-str name))
            (tc-thread-legacy-safe-spawn-result-type-name?
              lookup-name
              (intern-str name)))]
        [(AstType.EnumArgs name _)
          (or
            (tc-thread-legacy-safe-spawn-result-type-name?
              source-name
              (intern-str name))
            (tc-thread-legacy-safe-spawn-result-type-name?
              lookup-name
              (intern-str name)))]
        [_ false])]))

(define (tc-thread-generated-spawn-task-ret-type?
  [ctx : TcContext]
  [module : String]
  [ty : AstType]) : bool
  (let
    [type-key : String (tc-thread-generated-module-type-key module)]
    [resolved : AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
    (cond
      [(string.eq module "")
        (match resolved
          [(AstType.I64) true]
          [(AstType.Bool) true]
          [(AstType.Unit) true]
          [_ false])]
      [(string.eq type-key "i64")
        (match resolved
          [(AstType.I64) true]
          [_ false])]
      [(string.eq type-key "bool")
        (match resolved
          [(AstType.Bool) true]
          [_ false])]
      [(string.eq type-key "unit")
        (match resolved
          [(AstType.Unit) true]
          [_ false])]
      [else false])))

(define (tc-thread-safe-spawn-task-ret-type?
  [ctx : TcContext]
  [source-name : String]
  [lookup-name : String]
  [generated-module : TcMaybeString]
  [ty : AstType]) : bool
  (match generated-module
    [(TcMaybeString.Some module)
      (tc-thread-generated-spawn-task-ret-type? ctx module ty)]
    [(TcMaybeString.No)
      (let
        [resolved : AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
        (cond
          [(or
              (tc-spawn-string-name? source-name)
              (tc-spawn-string-name? lookup-name))
            (match resolved
              [(AstType.String) true]
              [_ false])]
          [(or
              (tc-spawn-array-i64-name? source-name)
              (tc-spawn-array-i64-name? lookup-name))
            (match resolved
              [(AstType.DynArray elem)
                (match (tc-type-strip-region
                  (tc-resolve-type ctx (ty-node-get elem)))
                  [(AstType.I64) true]
                  [_ false])]
              [_ false])]
          [(or
              (tc-spawn-box-i64-name? source-name)
              (tc-spawn-box-i64-name? lookup-name))
            (match resolved
              [(AstType.Box elem)
                (match (tc-type-strip-region
                  (tc-resolve-type ctx (ty-node-get elem)))
                  [(AstType.I64) true]
                  [_ false])]
              [_ false])]
          [else false]))]))

(define (tc-thread-safe-spawn-task-type?
  [ctx : TcContext]
  [source-name : String]
  [lookup-name : String]
  [generated-module : TcMaybeString]
  [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Func task-params task-ret-box)
      (if (ast-type-list-empty? (box-get task-params))
        (tc-thread-safe-spawn-task-ret-type?
          ctx
          source-name
          lookup-name
          generated-module
          (ty-node-get task-ret-box))
        false)]
    [_ false]))

(define (tc-thread-safe-spawn-signature?
  [ctx : TcContext]
  [source-name : String]
  [lookup-name : String]
  [params : AstTypeList]
  [ret : AstType]) : bool
  (let
    [generated-module : TcMaybeString
      (tc-thread-generated-spawn-module ctx source-name lookup-name ret)]
    (and
      (tc-thread-safe-spawn-result-type?
        ctx
        source-name
        lookup-name
        generated-module
        ret)
      (if (= (ast-type-list-len (& params)) 1)
        (tc-thread-safe-spawn-task-type?
          ctx
          source-name
          lookup-name
          generated-module
          (ty-node-get (ast-type-list-get (& params) 0 (ast-type-id-fallback))))
        false))))

(define (tc-thread-transfer-class-merge
  [left : TcThreadTransferClass]
  [right : TcThreadTransferClass]) : TcThreadTransferClass
  (match left
    [(TcThreadTransferClass.Rejected _) left]
    [(TcThreadTransferClass.Transferable)
      (match right
        [(TcThreadTransferClass.Rejected _) right]
        [_ (TcThreadTransferClass.Transferable)])]
    [(TcThreadTransferClass.Shareable)
      (match right
        [(TcThreadTransferClass.Rejected _) right]
        [(TcThreadTransferClass.Transferable)
          (TcThreadTransferClass.Transferable)]
        [(TcThreadTransferClass.Shareable) (TcThreadTransferClass.Shareable)])]))

(define (tc-thread-transfer-reject [message : String]) : TcThreadTransferClass
  (TcThreadTransferClass.Rejected message))

(define (tc-thread-transfer-aggregate-class [class : TcThreadTransferClass]) : TcThreadTransferClass
  (match class
    [(TcThreadTransferClass.Rejected _) class]
    [_ (TcThreadTransferClass.Transferable)]))

(define (tc-thread-transfer-region-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "scoped-region and lifetime-parameterized values cannot cross thread boundaries"))

(define (tc-thread-transfer-reference-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "borrowed references cannot cross thread boundaries"))

(define (tc-thread-transfer-mut-reference-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "mutable references cannot cross thread boundaries"))

(define (tc-thread-transfer-raw-pointer-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "raw pointers cannot cross thread boundaries in safe code"))

(define (tc-thread-transfer-owned-heap-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "owned heap storage needs a static/program or spanning atomic owner proof"))

(define (tc-thread-transfer-cleanup-reject) : TcThreadTransferClass
  (tc-thread-transfer-reject
    "cleanup-required resources cannot cross thread boundaries"))

(define (tc-thread-transfer-type-list-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [types : AstTypeList]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (tc-thread-transfer-type-list-class-at ctx env (& types) stack owner-proof 0))

(define (tc-thread-transfer-type-list-class-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [types : (& types AstTypeList)]
  [stack : TcStringList]
  [owner-proof : bool]
  [index : i64]) : TcThreadTransferClass
  (if (>= index (ast-type-list-len types))
    (TcThreadTransferClass.Shareable)
    (tc-thread-transfer-class-merge
      (tc-thread-transfer-type-class
        ctx
        env
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))
        stack
        owner-proof)
      (tc-thread-transfer-type-list-class-at
        ctx
        env
        types
        stack
        owner-proof
        (+ index 1)))))

(define (tc-thread-transfer-field-list-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [fields : AstFieldDefList]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (tc-thread-transfer-field-list-class-at
    ctx
    env
    (& fields)
    stack
    owner-proof
    0))

(define (tc-thread-transfer-field-list-class-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [fields : (& fields AstFieldDefList)]
  [stack : TcStringList]
  [owner-proof : bool]
  [index : i64]) : TcThreadTransferClass
  (if (>= index (struct-get fields len))
    (TcThreadTransferClass.Shareable)
    (match (ast-field-def-list-get fields index (ast-field-def-fallback))
      [(AstFieldDef.Def _ ty _)
        (tc-thread-transfer-class-merge
          (tc-thread-transfer-type-class ctx env ty stack owner-proof)
          (tc-thread-transfer-field-list-class-at
            ctx
            env
            fields
            stack
            owner-proof
            (+ index 1)))])))

(define (tc-thread-transfer-variant-list-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [variants : AstVariantDefList]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (tc-thread-transfer-variant-list-class-at
    ctx
    env
    (& variants)
    stack
    owner-proof
    0))

(define (tc-thread-transfer-variant-list-class-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [variants : (& variants AstVariantDefList)]
  [stack : TcStringList]
  [owner-proof : bool]
  [index : i64]) : TcThreadTransferClass
  (if (>= index (struct-get variants len))
    (TcThreadTransferClass.Shareable)
    (match (ast-variant-def-list-get variants index (ast-variant-def-fallback))
      [(AstVariantDef.Def _ payloads _)
        (tc-thread-transfer-class-merge
          (tc-thread-transfer-type-list-class
            ctx
            env
            payloads
            stack
            owner-proof)
          (tc-thread-transfer-variant-list-class-at
            ctx
            env
            variants
            stack
            owner-proof
            (+ index 1)))])))

(define (tc-thread-transfer-struct-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (if (tc-string-list-contains stack struct-name)
    (tc-thread-transfer-reject
      (str_cat.str-cat
        "recursive aggregate "
        struct-name
        " needs an explicit spanning owner proof"))
    (match (tc-struct-decl ctx struct-name)
      [(ResultTcStructDecl.Ok decl)
        (match decl
          [(TcStructDecl _ cleanup fields)
            (if (ast-struct-cleanup? cleanup)
              (tc-thread-transfer-cleanup-reject)
              (tc-thread-transfer-aggregate-class
                (tc-thread-transfer-field-list-class
                  ctx
                  env
                  fields
                  (tc-string-list-add stack struct-name)
                  owner-proof)))])]
      [(ResultTcStructDecl.Err message) (tc-thread-transfer-reject message)])))

(define (tc-thread-transfer-enum-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (if (tc-string-list-contains stack enum-name)
    (tc-thread-transfer-reject
      (str_cat.str-cat
        "recursive aggregate "
        enum-name
        " needs an explicit spanning owner proof"))
    (match (tc-enum-decl ctx enum-name)
      [(ResultTcEnumDecl.Ok decl)
        (match decl
          [(TcEnumDecl cleanup variants)
            (if (ast-enum-cleanup? cleanup)
              (tc-thread-transfer-cleanup-reject)
              (tc-thread-transfer-aggregate-class
                (tc-thread-transfer-variant-list-class
                  ctx
                  env
                  variants
                  (tc-string-list-add stack enum-name)
                  owner-proof)))])]
      [(ResultTcEnumDecl.Err message) (tc-thread-transfer-reject message)])))

(define (tc-thread-transfer-type-class-with-stack
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : AstType]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (let
    [resolved : AstType (tc-resolve-type ctx ty)]
    (match resolved
      [(AstType.Region region inner)
        (cond
          [(tc-atomic-arena-owner-active? env region)
            (tc-thread-transfer-type-class
              ctx
              env
              (ty-node-get inner)
              stack
              true)]
          [(tc-ordinary-arena-owner-active? env region)
            (tc-thread-transfer-owned-heap-reject)]
          [else (tc-thread-transfer-region-reject)])]
      [(AstType.Ref _ _) (tc-thread-transfer-reference-reject)]
      [(AstType.MutRef _ _) (tc-thread-transfer-mut-reference-reject)]
      [(AstType.Ptr _) (tc-thread-transfer-raw-pointer-reject)]
      [(AstType.MutPtr _) (tc-thread-transfer-raw-pointer-reject)]
      [(AstType.String)
        (if owner-proof
          (TcThreadTransferClass.Shareable)
          (tc-thread-transfer-owned-heap-reject))]
      [(AstType.Str) (tc-thread-transfer-reference-reject)]
      [(AstType.Bytes) (tc-thread-transfer-reference-reject)]
      [(AstType.DynArray elem)
        (if owner-proof
          (tc-thread-transfer-aggregate-class
            (tc-thread-transfer-type-class
              ctx
              env
              (ty-node-get elem)
              stack
              owner-proof))
          (tc-thread-transfer-owned-heap-reject))]
      [(AstType.Box elem)
        (if owner-proof
          (tc-thread-transfer-aggregate-class
            (tc-thread-transfer-type-class
              ctx
              env
              (ty-node-get elem)
              stack
              owner-proof))
          (tc-thread-transfer-owned-heap-reject))]
      [(AstType.Tuple elems)
        (tc-thread-transfer-aggregate-class
          (tc-thread-transfer-type-list-class
            ctx
            env
            (box-get elems)
            stack
            owner-proof))]
      [(AstType.Array elem _)
        (tc-thread-transfer-aggregate-class
          (tc-thread-transfer-type-class
            ctx
            env
            (ty-node-get elem)
            stack
            owner-proof))]
      [(AstType.Struct name)
        (tc-thread-transfer-struct-class
          ctx
          env
          (intern-str name)
          stack
          owner-proof)]
      [(AstType.StructArgs name lifetimes)
        (if (> (tc-lifetime-list-count (box-get lifetimes)) 0)
          (tc-thread-transfer-region-reject)
          (tc-thread-transfer-struct-class
            ctx
            env
            (intern-str name)
            stack
            owner-proof))]
      [(AstType.Enum name)
        (tc-thread-transfer-enum-class
          ctx
          env
          (intern-str name)
          stack
          owner-proof)]
      [(AstType.EnumArgs name lifetimes)
        (if (> (tc-lifetime-list-count (box-get lifetimes)) 0)
          (tc-thread-transfer-region-reject)
          (tc-thread-transfer-enum-class
            ctx
            env
            (intern-str name)
            stack
            owner-proof))]
      [(AstType.Func _ _)
        (tc-thread-transfer-reject
          "function value transfer requires a direct no-capture function symbol")]
      [(AstType.Expr)
        (tc-thread-transfer-reject
          "compile-time expression values cannot cross thread boundaries")]
      [(AstType.ExprList)
        (tc-thread-transfer-reject
          "compile-time expression values cannot cross thread boundaries")]
      [(AstType.Var _)
        (tc-thread-transfer-reject
          "unresolved type variable cannot cross thread boundaries")]
      [(AstType.VarArgs _ _)
        (tc-thread-transfer-reject
          "unresolved lifetime-parameterized type cannot cross thread boundaries")]
      [_ (TcThreadTransferClass.Shareable)])))

(define (tc-thread-transfer-type-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : AstType]
  [stack : TcStringList]
  [owner-proof : bool]) : TcThreadTransferClass
  (tc-thread-transfer-type-class-with-stack ctx env ty stack owner-proof))

(define (tc-thread-transfer-classify-type [ctx : TcContext] [ty : AstType]) : TcThreadTransferClass
  (tc-thread-transfer-type-class ctx (tc-empty-env) ty TcStringList.Nil false))

(define (tc-thread-transfer-classify-type-in-env
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : AstType]) : TcThreadTransferClass
  (tc-thread-transfer-type-class ctx env ty TcStringList.Nil false))

(define (tc-region-list-atomic-arena-owners
  [env : TcTypeEnv]
  [regions : TcStringList]
  [out : TcStringList]) : TcStringList
  (match regions
    [(TcStringList.Nil) out]
    [(TcStringList.Cons region rest)
      (tc-region-list-atomic-arena-owners
        env
        (box-get rest)
        (if (tc-atomic-arena-owner-active? env region)
          (tc-string-list-add out region)
          out))]))

(define (tc-type-atomic-arena-owner-regions [env : TcTypeEnv] [ty : AstType]) : TcStringList
  (tc-region-list-atomic-arena-owners
    env
    (tc-type-collect-regions ty)
    TcStringList.Nil))

(define (tc-thread-safe-spawn-capture-message
  [spawn-name : String]
  [ctx : TcContext]
  [name : String]
  [ty : AstType]
  [reason : String]) : String
  (str_cat.str-cat
    "typecheck: "
    spawn-name
    " cannot capture `"
    name
    "` of type "
    (tc-type-render (tc-type-without-regions (tc-resolve-type ctx ty)))
    "; "
    reason))

(define (tc-check-thread-safe-spawn-captures-scan-root
  [spawn-name : String]
  [ctx : TcContext]
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [body : AstExpr]) : ResultTcUnit
  (match env
    [(TcTypeEnv.Nil) ResultTcUnit.Ok]
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-check-thread-safe-spawn-captures-scan-root
          spawn-name
          ctx
          root
          (box-get rest)
          bound
          body)
        ResultTcUnit.Ok)]
    [(TcTypeEnv.Bind key ty rest)
      (let
        [name : String (intern-str key)]
        (cond
          [(or
              (= key (tc-region-marker-id))
              (= key (tc-default-boundary-id))
              (tc-cleanup-owner-marker-entry? key ty)
              (tc-ordinary-arena-owner-marker-entry? key ty)
              (tc-atomic-arena-owner-marker-entry? key ty))
            (tc-check-thread-safe-spawn-captures-scan-root
              spawn-name
              ctx
              root
              (box-get rest)
              bound
              body)]
          [(not (tc-expr-uses-free-name? body name bound))
            (tc-check-thread-safe-spawn-captures-scan-root
              spawn-name
              ctx
              root
              (box-get rest)
              bound
              body)]
          [(tc-expr-sets-free-name? body name bound)
            (ResultTcUnit.Err
              (str_cat.str-cat
                "typecheck: "
                spawn-name
                " lambda cannot assign captured binding"))]
          [(tc-ordinary-arena-owner-active? root name)
            (ResultTcUnit.Err
              (str_cat.str-cat
                "typecheck: "
                spawn-name
                " cannot capture ordinary arena handle `"
                name
                "`; use arena-make-atomic for a spanning owner"))]
          [(tc-cleanup-owner-active? root name)
            (ResultTcUnit.Err
              (str_cat.str-cat
                "typecheck: "
                spawn-name
                " cannot capture cleanup-required resource"))]
          [else
            (match (tc-thread-transfer-classify-type-in-env ctx root ty)
              [(TcThreadTransferClass.Rejected reason)
                (ResultTcUnit.Err
                  (tc-thread-safe-spawn-capture-message
                    spawn-name
                    ctx
                    name
                    ty
                    reason))]
              [_
                (tc-check-thread-safe-spawn-captures-scan-root
                  spawn-name
                  ctx
                  root
                  (box-get rest)
                  bound
                  body)])]))]))

(define (tc-check-thread-safe-spawn-captures
  [spawn-name : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]
  [body : AstExpr]) : ResultTcUnit
  (match env
    [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
      (tc-check-thread-safe-spawn-captures-scan-root
        spawn-name
        ctx
        env
        (box-get rest)
        (tc-param-bound-names params)
        body)]
    [_
      (tc-check-thread-safe-spawn-captures-scan-root
        spawn-name
        ctx
        env
        env
        (tc-param-bound-names params)
        body)]))

(define (tc-thread-safe-spawn-captured-owner-regions-scan-root
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [body : AstExpr]
  [owners : TcStringList]) : TcStringList
  (match env
    [(TcTypeEnv.Nil) owners]
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-thread-safe-spawn-captured-owner-regions-scan-root
          root
          (box-get rest)
          bound
          body
          owners)
        owners)]
    [(TcTypeEnv.Bind key ty rest)
      (let
        [name : String (intern-str key)]
        [rest-env : TcTypeEnv (box-get rest)]
        (cond
          [(or
              (= key (tc-region-marker-id))
              (= key (tc-default-boundary-id))
              (tc-cleanup-owner-marker-entry? key ty)
              (tc-ordinary-arena-owner-marker-entry? key ty)
              (tc-atomic-arena-owner-marker-entry? key ty))
            (tc-thread-safe-spawn-captured-owner-regions-scan-root
              root
              rest-env
              bound
              body
              owners)]
          [(not (tc-expr-uses-free-name? body name bound))
            (tc-thread-safe-spawn-captured-owner-regions-scan-root
              root
              rest-env
              bound
              body
              owners)]
          [else
            (tc-thread-safe-spawn-captured-owner-regions-scan-root
              root
              rest-env
              bound
              body
              (tc-string-list-add-all
                (if (tc-atomic-arena-owner-active? root name)
                  (tc-string-list-add owners name)
                  owners)
                (tc-type-atomic-arena-owner-regions root ty)))]))]))

(define (tc-thread-safe-spawn-captured-owner-regions
  [env : TcTypeEnv]
  [params : AstParamList]
  [body : AstExpr]) : TcStringList
  (match env
    [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
      (tc-thread-safe-spawn-captured-owner-regions-scan-root
        env
        (box-get rest)
        (tc-param-bound-names params)
        body
        TcStringList.Nil)]
    [_
      (tc-thread-safe-spawn-captured-owner-regions-scan-root
        env
        env
        (tc-param-bound-names params)
        body
        TcStringList.Nil)]))

(define (tc-thread-safe-spawn-direct-lambda-owner-regions
  [env : TcTypeEnv]
  [arg : AstExpr]) : TcStringList
  (match (ast-expr-unspan arg)
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params _ body-box)
          (if (= (ast-param-list-len (& params)) 0)
            (tc-thread-safe-spawn-captured-owner-regions
              env
              params
              (ast-node-get body-box))
            TcStringList.Nil)])]
    [_ TcStringList.Nil]))

(define (tc-check-thread-safe-spawn-direct-lambda-arg
  [spawn-name : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : AstExpr]) : ResultTcUnit
  (match (ast-expr-unspan arg)
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params _ body-box)
          (if (= (ast-param-list-len (& params)) 0)
            (tc-check-thread-safe-spawn-captures
              spawn-name
              ctx
              env
              params
              (ast-node-get body-box))
            (ResultTcUnit.Err
              (str_cat.str-cat
                "typecheck: "
                spawn-name
                " requires a direct nullary lambda argument so captures can be checked")))])]
    [_
      (ResultTcUnit.Err
        (str_cat.str-cat
          "typecheck: "
          spawn-name
          " requires a direct nullary lambda argument so captures can be checked"))]))

(define (tc-check-thread-safe-spawn-direct-lambda
  [spawn-name : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : AstExpr]) : ResultTcUnit
  (match (tc-active-region env)
    [(TcMaybeString.Some region)
      (if (tc-atomic-arena-owner-active? env region)
        (tc-check-thread-safe-spawn-direct-lambda-arg spawn-name ctx env arg)
        (ResultTcUnit.Err
          (str_cat.str-cat
            "typecheck: "
            spawn-name
            " cannot spawn from scoped arena; closure storage would not outlive the worker")))]
    [(TcMaybeString.No)
      (tc-check-thread-safe-spawn-direct-lambda-arg spawn-name ctx env arg)]))

(define (tc-check-thread-safe-spawn-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]
  [ret : AstType]) : ResultTcStringList
  (match (tc-thread-safe-spawn-call-name ctx env func)
    [(TcMaybeString.Some source-name)
      (let
        [lookup-name : String (tc-thread-spawn-lookup-name ctx env source-name)]
        (if (tc-thread-safe-spawn-signature?
          ctx
          source-name
          lookup-name
          params
          ret)
          (if (= (struct-get (& args) len) 1)
            (let
              [arg : AstExpr (ast-node-get (ast-expr-list-get (& args) 0 0))]
              (match (tc-check-thread-safe-spawn-direct-lambda
                source-name
                ctx
                env
                arg)
                [(ResultTcUnit.Ok)
                  (ResultTcStringList.Ok
                    (tc-thread-safe-spawn-direct-lambda-owner-regions env arg))]
                [(ResultTcUnit.Err message) (ResultTcStringList.Err message)]))
            (ResultTcStringList.Err
              (str_cat.str-cat
                "typecheck: "
                source-name
                " expects one argument")))
          (ResultTcStringList.Ok TcStringList.Nil)))]
    [(TcMaybeString.No) (ResultTcStringList.Ok TcStringList.Nil)]))

(define (tc-thread-channel-send-message
  [send-name : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [message-ty : AstType]) : ResultTcUnit
  (match (tc-thread-transfer-classify-type-in-env ctx env message-ty)
    [(TcThreadTransferClass.Rejected reason)
      (ResultTcUnit.Err
        (str_cat.str-cat
          "typecheck: "
          send-name
          " cannot send value of type "
          (tc-type-render
            (tc-type-without-regions (tc-resolve-type ctx message-ty)))
          "; "
          reason))]
    [_ ResultTcUnit.Ok]))

(define (tc-check-thread-channel-send-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]
  [ret : AstType]) : ResultTcUnit
  (match (tc-thread-channel-send-call-name func)
    [(TcMaybeString.Some send-name)
      (if (tc-thread-channel-send-result-type? ctx ret)
        (match (tc-thread-channel-send-message-param params)
          [(ResultTcType.Ok _)
            (match (tc-thread-channel-send-message-arg args)
              [(ResultTcExpr.Ok message-expr)
                (match (tc-expr ctx env message-expr)
                  [(ResultTcType.Ok message-ty)
                    (tc-thread-channel-send-message
                      send-name
                      ctx
                      env
                      message-ty)]
                  [(ResultTcType.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcExpr.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcType.Err message) (ResultTcUnit.Err message)])
        ResultTcUnit.Ok)]
    [(TcMaybeString.No) ResultTcUnit.Ok]))

(define (tc-thread-channel-send-function-result?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]) : bool
  (match (tc-expr ctx env func)
    [(ResultTcType.Ok fn-ty)
      (match (tc-type-strip-region fn-ty)
        [(AstType.Func _ ret-box)
          (tc-thread-channel-send-result-type? ctx (ty-node-get ret-box))]
        [_ false])]
    [(ResultTcType.Err _) false]))

(define (tc-thread-channel-send-call?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]) : bool
  (match (tc-thread-channel-send-call-name func)
    [(TcMaybeString.Some _)
      (tc-thread-channel-send-function-result? ctx env func)]
    [(TcMaybeString.No) false]))

(define (tc-call-function-type-normal
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]
  [ret : AstType]
  [c-abi-args : bool]) : ResultTcType
  (let
    [allow-region-args : bool
      (tc-call-region-args-allowed-for-func ctx env func)]
    (if (tc-call-lifetime-constructor-for-func? ctx func ret)
      (tc-call-lifetime-constructor-type
        ctx
        env
        func
        args
        params
        ret
        allow-region-args)
      (let
        [constructor-target : AstMaybeType
          (tc-call-constructor-target-for-func ctx env func params ret)]
        (match constructor-target
          [(AstMaybeType.Some _)
            (match (tc-check-call-args
              ctx
              env
              args
              params
              allow-region-args
              constructor-target
              c-abi-args)
              [(ResultTcUnit.Ok)
                (match constructor-target
                  [(AstMaybeType.Some target) (ResultTcType.Ok target)]
                  [(AstMaybeType.No)
                    (ResultTcType.Ok (tc-tag-active-region env ret))])]
              [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
          [(AstMaybeType.No)
            (let
              [lifetimes : AstLifetimeList
                (tc-call-function-lifetimes params ret)]
              (if (ast-lifetime-list-empty? (& lifetimes))
                (match (tc-check-call-args-with-message
                  ctx
                  env
                  args
                  params
                  allow-region-args
                  constructor-target
                  (TcArityMessage.Detailed func args params)
                  c-abi-args)
                  [(ResultTcUnit.Ok)
                    (match (tc-check-thread-safe-spawn-call
                      ctx
                      env
                      func
                      args
                      params
                      ret)
                      [(ResultTcStringList.Ok spawn-owner-regions)
                        (match (tc-check-thread-channel-send-call
                          ctx
                          env
                          func
                          args
                          params
                          ret)
                          [(ResultTcUnit.Ok)
                            (ResultTcType.Ok
                              (tc-tag-regions
                                spawn-owner-regions
                                (tc-tag-active-region env ret)))]
                          [(ResultTcUnit.Err message)
                            (ResultTcType.Err message)])]
                      [(ResultTcStringList.Err message)
                        (ResultTcType.Err message)])]
                  [(ResultTcUnit.Err message) (ResultTcType.Err message)])
                (tc-call-lifetime-function-type
                  ctx
                  env
                  args
                  params
                  ret
                  lifetimes
                  allow-region-args
                  c-abi-args)))])))))

(define (tc-check-call-args-with-message
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [params : AstTypeList]
  [allow-region-args : bool]
  [constructor-target : AstMaybeType]
  [arity-msg : TcArityMessage]
  [c-abi-args : bool]) : ResultTcUnit
  (tc-check-call-args-with-message-at
    ctx
    env
    (& args)
    (& params)
    0
    allow-region-args
    constructor-target
    arity-msg
    c-abi-args))

(define (tc-check-call-args-with-message-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : (& args AstExprList)]
  [params : (& params AstTypeList)]
  [index : i64]
  [allow-region-args : bool]
  [constructor-target : AstMaybeType]
  [arity-msg : TcArityMessage]
  [c-abi-args : bool]) : ResultTcUnit
  (if (>= index (struct-get args len))
    (if (>= index (ast-type-list-len params))
      ResultTcUnit.Ok
      (ResultTcUnit.Err (tc-arity-message-text arity-msg)))
    (if (>= index (ast-type-list-len params))
      (ResultTcUnit.Err (tc-arity-message-text arity-msg))
      (let
        [arg : AstExpr (ast-node-get (ast-expr-list-get args index 0))]
        [want : AstType
          (ty-node-get (ast-type-list-get params index (ast-type-id-fallback)))]
        (match (tc-call-effective-arg-expr ctx env arg want)
          [(ResultTcExpr.Ok effective-arg)
            (let
              [typed-arg : ResultTcType
                (match constructor-target
                  [(AstMaybeType.No)
                    (tc-expr-with-expected-or-actual-call-arg
                      ctx
                      env
                      effective-arg
                      want)]
                  [(AstMaybeType.Some _)
                    (tc-expr-with-expected-or-actual ctx env effective-arg want)])]
              (match typed-arg
                [(ResultTcType.Ok got)
                  (match (tc-expect-at-expr
                    arg
                    got
                    want
                    "typecheck: argument type mismatch")
                    [(ResultTcUnit.Ok)
                      (match (tc-raw-c-fnptr-flow-ok
                        ctx
                        env
                        effective-arg
                        want
                        c-abi-args)
                        [(ResultTcUnit.Ok)
                          (if (and
                            (tc-type-contains-any-region got)
                            (not allow-region-args)
                            (not
                              (tc-type-regions-all-atomic-arena-owners? env got))
                            (not (tc-type-contains-reference? got)))
                            (ResultTcUnit.Err
                              "typecheck: cannot pass region-tagged value to function parameter; region value would escape")
                            (match constructor-target
                              [(AstMaybeType.Some target)
                                (match (tc-ensure-cleanup-resource-not-stored-expr
                                  env
                                  effective-arg)
                                  [(ResultTcUnit.Ok)
                                    (match (tc-ensure-region-value-can-flow-into
                                      env
                                      target
                                      got
                                      "constructor result")
                                      [(ResultTcUnit.Ok)
                                        (tc-check-call-args-with-message-at
                                          ctx
                                          env
                                          args
                                          params
                                          (+ index 1)
                                          allow-region-args
                                          constructor-target
                                          arity-msg
                                          c-abi-args)]
                                      [(ResultTcUnit.Err message)
                                        (ResultTcUnit.Err message)])]
                                  [(ResultTcUnit.Err message)
                                    (ResultTcUnit.Err message)])]
                              [(AstMaybeType.No)
                                (tc-check-call-args-with-message-at
                                  ctx
                                  env
                                  args
                                  params
                                  (+ index 1)
                                  allow-region-args
                                  constructor-target
                                  arity-msg
                                  c-abi-args)]))]
                        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
                    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
                [(ResultTcType.Err message) (ResultTcUnit.Err message)]))]
          [(ResultTcExpr.Err message)
            (ResultTcUnit.Err (tc-locate-error-at-expr arg message))])))))

(define (tc-check-call-args
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [params : AstTypeList]
  [allow-region-args : bool]
  [constructor-target : AstMaybeType]
  [c-abi-args : bool]) : ResultTcUnit
  (tc-check-call-args-with-message
    ctx
    env
    args
    params
    allow-region-args
    constructor-target
    (TcArityMessage.Literal)
    c-abi-args))

(define (tc-check-args
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [params : AstTypeList]) : ResultTcUnit
  (tc-check-args-at ctx env (& args) (& params) 0))

(define (tc-check-args-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : (& args AstExprList)]
  [params : (& params AstTypeList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get args len))
    (if (>= index (ast-type-list-len params))
      ResultTcUnit.Ok
      (ResultTcUnit.Err "typecheck: arity mismatch"))
    (if (>= index (ast-type-list-len params))
      (ResultTcUnit.Err "typecheck: arity mismatch")
      (let
        [arg : AstExpr (ast-node-get (ast-expr-list-get args index 0))]
        [want : AstType
          (ty-node-get (ast-type-list-get params index (ast-type-id-fallback)))]
        (match (tc-expr-with-expected-or-actual ctx env arg want)
          [(ResultTcType.Ok got)
            (match (tc-expect-at-expr
              arg
              got
              want
              "typecheck: argument type mismatch")
              [(ResultTcUnit.Ok)
                (tc-check-args-at ctx env args params (+ index 1))]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcType.Err message) (ResultTcUnit.Err message)])))))

(define (tc-call-expr-ordinary
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]) : ResultTcType
  (match (ast-expr-unspan func)
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params maybe-ret body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-lambda-expr-allow-ref-captures
              ctx
              env
              params
              maybe-ret
              body)
              [(ResultTcType.Ok fn-ty)
                (match fn-ty
                  [(AstType.Func params ret)
                    (tc-call-function-type
                      ctx
                      env
                      func
                      args
                      (box-get params)
                      (ty-node-get ret))]
                  [_
                    (ResultTcType.Err
                      "typecheck: call target is not a function")])]
              [(ResultTcType.Err message) (ResultTcType.Err message)]))])]
    [_
      (match (tc-expr ctx env func)
        [(ResultTcType.Ok fn-ty)
          (match fn-ty
            [(AstType.Func params ret)
              (tc-call-function-type
                ctx
                env
                func
                args
                (box-get params)
                (ty-node-get ret))]
            [(AstType.Region _ inner)
              (match (ty-node-get inner)
                [(AstType.Func params ret)
                  (match (tc-check-call-args-with-message
                    ctx
                    env
                    args
                    (box-get params)
                    false
                    (AstMaybeType.No)
                    (TcArityMessage.Detailed func args (box-get params))
                    (tc-expr-c-abi-fnptr? ctx env func))
                    [(ResultTcUnit.Ok)
                      (ResultTcType.Ok
                        (tc-tag-active-region env (ty-node-get ret)))]
                    [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                [(AstType.Enum enum-name)
                  (if (ast-expr-list-empty? (& args))
                    (tc-nullary-variant-call-expr
                      ctx
                      env
                      func
                      (intern-str enum-name)
                      (ty-node-get inner))
                    (ResultTcType.Err "typecheck: arity mismatch"))]
                [(AstType.EnumArgs enum-name _)
                  (if (ast-expr-list-empty? (& args))
                    (tc-nullary-variant-call-expr
                      ctx
                      env
                      func
                      (intern-str enum-name)
                      (ty-node-get inner))
                    (ResultTcType.Err "typecheck: arity mismatch"))]
                [_
                  (ResultTcType.Err "typecheck: call target is not a function")])]
            [(AstType.Enum enum-name)
              (if (ast-expr-list-empty? (& args))
                (tc-nullary-variant-call-expr
                  ctx
                  env
                  func
                  (intern-str enum-name)
                  fn-ty)
                (ResultTcType.Err "typecheck: arity mismatch"))]
            [(AstType.EnumArgs enum-name _)
              (if (ast-expr-list-empty? (& args))
                (tc-nullary-variant-call-expr
                  ctx
                  env
                  func
                  (intern-str enum-name)
                  fn-ty)
                (ResultTcType.Err "typecheck: arity mismatch"))]
            [_ (ResultTcType.Err "typecheck: call target is not a function")])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]))

(define (tc-phase-call [ctx : TcContext] [env : TcTypeEnv] [args : AstExprList]) : ResultTcType
  (if (= (struct-get (& args) len) 1)
    (let
      [owner-expr : AstExpr (ast-node-get (ast-expr-list-get (& args) 0 0))]
      (match (tc-expr ctx env owner-expr)
        [(ResultTcType.Ok owner-ty)
          (if (tc-arena-type? ctx owner-ty)
            (match (tc-expr-var-name owner-expr)
              [(TcMaybeString.Some owner)
                (if (or
                  (tc-ordinary-arena-owner-active? env owner)
                  (tc-atomic-arena-owner-active? env owner))
                  (ResultTcType.Ok
                    (AstType.Struct (intern (tc-arena-phase-type-name))))
                  (ResultTcType.Err
                    (tc-locate-error-at-expr
                      owner-expr
                      "typecheck: arena.phase requires a direct arena owner")))]
              [(TcMaybeString.No)
                (ResultTcType.Err
                  (tc-locate-error-at-expr
                    owner-expr
                    "typecheck: arena.phase requires a direct arena owner"))])
            (ResultTcType.Err
              (tc-locate-error-at-expr
                owner-expr
                "typecheck: arena.phase arena must be Arena")))]
        [(ResultTcType.Err message) (ResultTcType.Err message)]))
    (ResultTcType.Err "typecheck: arena.phase expects exactly one argument")))

(define (tc-rewind-safe-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]) : ResultTcType
  (if (= (struct-get (& args) len) 1)
    (let
      [phase-expr : AstExpr (ast-node-get (ast-expr-list-get (& args) 0 0))]
      (match (tc-expr ctx env phase-expr)
        [(ResultTcType.Ok phase-ty)
          (if (tc-arena-phase-type? ctx phase-ty)
            (match (tc-expr-var-name phase-expr)
              [(TcMaybeString.Some phase)
                (match (tc-arena-phase-token-region-active env phase)
                  [(TcMaybeString.Some _)
                    (match (tc-arena-phase-token-owner-active env phase)
                      [(TcMaybeString.Some owner)
                        (if (tc-active-region-owned-by-arena? env owner)
                          (ResultTcType.Err
                            (tc-locate-error-at-expr
                              phase-expr
                              "typecheck: arena.rewind-safe! cannot run inside the arena it rewinds"))
                          (ResultTcType.Ok (AstType.Unit)))]
                      [(TcMaybeString.No) (ResultTcType.Ok (AstType.Unit))])]
                  [(TcMaybeString.No)
                    (ResultTcType.Err
                      (tc-locate-error-at-expr
                        phase-expr
                        "typecheck: arena.rewind-safe! requires a direct arena phase token"))])]
              [(TcMaybeString.No)
                (ResultTcType.Err
                  (tc-locate-error-at-expr
                    phase-expr
                    "typecheck: arena.rewind-safe! requires a direct arena phase token"))])
            (ResultTcType.Err
              (tc-locate-error-at-expr
                phase-expr
                "typecheck: arena.rewind-safe! phase must be ArenaPhase")))]
        [(ResultTcType.Err message) (ResultTcType.Err message)]))
    (ResultTcType.Err
      "typecheck: arena.rewind-safe! expects exactly one argument")))

(define (tc-destroy-safe-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]) : ResultTcType
  (if (= (struct-get (& args) len) 1)
    (let
      [owner-expr : AstExpr (ast-node-get (ast-expr-list-get (& args) 0 0))]
      (match (tc-expr ctx env owner-expr)
        [(ResultTcType.Ok owner-ty)
          (if (tc-arena-type? ctx owner-ty)
            (match (tc-expr-var-name owner-expr)
              [(TcMaybeString.Some owner)
                (if (or
                  (tc-ordinary-arena-owner-active? env owner)
                  (tc-atomic-arena-owner-active? env owner))
                  (if (tc-active-region-owned-by-arena? env owner)
                    (ResultTcType.Err
                      (tc-locate-error-at-expr
                        owner-expr
                        "typecheck: arena.destroy-safe! cannot run inside the arena it destroys"))
                    (ResultTcType.Ok (AstType.Unit)))
                  (ResultTcType.Err
                    (tc-locate-error-at-expr
                      owner-expr
                      "typecheck: arena.destroy-safe! requires a direct arena owner")))]
              [(TcMaybeString.No)
                (ResultTcType.Err
                  (tc-locate-error-at-expr
                    owner-expr
                    "typecheck: arena.destroy-safe! requires a direct arena owner"))])
            (ResultTcType.Err
              (tc-locate-error-at-expr
                owner-expr
                "typecheck: arena.destroy-safe! arena must be Arena")))]
        [(ResultTcType.Err message) (ResultTcType.Err message)]))
    (ResultTcType.Err
      "typecheck: arena.destroy-safe! expects exactly one argument")))

(define (tc-call-expr-ordinary-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]
  [args : AstExprList]) : ResultTcType
  (let
    [func : AstExpr (ast-node-get func-id)]
    (match (ast-expr-unspan func)
      [(AstExpr.Lambda lambda-box)
        (match (box-get lambda-box)
          [(AstLambda.Lambda params maybe-ret body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (match (tc-lambda-expr-allow-ref-captures
                ctx
                env
                params
                maybe-ret
                body)
                [(ResultTcType.Ok fn-ty)
                  (begin
                    (tc-body-type-fact-record! func-id fn-ty)
                    (match fn-ty
                      [(AstType.Func params ret)
                        (tc-call-function-type
                          ctx
                          env
                          func
                          args
                          (box-get params)
                          (ty-node-get ret))]
                      [_
                        (ResultTcType.Err
                          "typecheck: call target is not a function")]))]
                [(ResultTcType.Err message) (ResultTcType.Err message)]))])]
      [_
        (match (tc-expr-id ctx env func-id)
          [(ResultTcType.Ok fn-ty)
            (match fn-ty
              [(AstType.Func params ret)
                (tc-call-function-type
                  ctx
                  env
                  func
                  args
                  (box-get params)
                  (ty-node-get ret))]
              [(AstType.Region _ inner)
                (match (ty-node-get inner)
                  [(AstType.Func params ret)
                    (match (tc-check-call-args-with-message
                      ctx
                      env
                      args
                      (box-get params)
                      false
                      (AstMaybeType.No)
                      (TcArityMessage.Detailed func args (box-get params))
                      (tc-expr-c-abi-fnptr? ctx env func))
                      [(ResultTcUnit.Ok)
                        (ResultTcType.Ok
                          (tc-tag-active-region env (ty-node-get ret)))]
                      [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                  [(AstType.Enum enum-name)
                    (if (ast-expr-list-empty? (& args))
                      (tc-nullary-variant-call-expr
                        ctx
                        env
                        func
                        (intern-str enum-name)
                        (ty-node-get inner))
                      (ResultTcType.Err "typecheck: arity mismatch"))]
                  [(AstType.EnumArgs enum-name _)
                    (if (ast-expr-list-empty? (& args))
                      (tc-nullary-variant-call-expr
                        ctx
                        env
                        func
                        (intern-str enum-name)
                        (ty-node-get inner))
                      (ResultTcType.Err "typecheck: arity mismatch"))]
                  [_
                    (ResultTcType.Err
                      "typecheck: call target is not a function")])]
              [(AstType.Enum enum-name)
                (if (ast-expr-list-empty? (& args))
                  (tc-nullary-variant-call-expr
                    ctx
                    env
                    func
                    (intern-str enum-name)
                    fn-ty)
                  (ResultTcType.Err "typecheck: arity mismatch"))]
              [(AstType.EnumArgs enum-name _)
                (if (ast-expr-list-empty? (& args))
                  (tc-nullary-variant-call-expr
                    ctx
                    env
                    func
                    (intern-str enum-name)
                    fn-ty)
                  (ResultTcType.Err "typecheck: arity mismatch"))]
              [_ (ResultTcType.Err "typecheck: call target is not a function")])]
          [(ResultTcType.Err message) (ResultTcType.Err message)])])))

(define (tc-call-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]) : ResultTcType
  (match (ast-expr-unspan func)
    [(AstExpr.Var raw-name)
      (let
        [name : String (tc-hygiene-global-call-name (intern-str raw-name))]
        [name-id : i64 (tc-builtin-name-id name)]
        [lookup-id : i64 (tc-call-builtin-lookup-id ctx env name name-id)]
        (cond
          [(and (tc-layout-query-name? name) (not (tc-name-bound? env name)))
            (tc-layout-query-runtime-call name args)]
          [(tc-string-length-helper-call-id? ctx env name-id lookup-id)
            (tc-one-length-handle-builtin-call ctx env args (AstType.I64))]
          [(cbi.compiler-builtin-typecheck-length-call-id? name-id)
            (tc-array-length-call ctx env name func args)]
          [(and
              (cbi.compiler-builtin-typecheck-string-ref-call-id? name-id)
              (not (tc-name-bound? env name)))
            (tc-string-ref-call ctx env args)]
          [(tc-string-ref-helper-call-id? ctx env name-id lookup-id)
            (tc-string-ref-call ctx env args)]
          [(and (tc-atomic-pointer-name? name) (not (tc-name-bound? env name)))
            (tc-atomic-pointer-call ctx env name args)]
          [(tc-arena-safe-call-name? ctx env name "phase")
            (tc-phase-call ctx env args)]
          [(tc-arena-safe-call-name? ctx env name "rewind-safe!")
            (tc-rewind-safe-call ctx env args)]
          [(tc-arena-safe-call-name? ctx env name "destroy-safe!")
            (tc-destroy-safe-call ctx env args)]
          [(and
              (tc-borrowed-string-builtin-id? name-id)
              (tc-default-builtin-unshadowed-id? env name-id))
            (tc-borrowed-string-builtin-call ctx env name args)]
          [(tc-string-eq-helper-call-id? ctx env name-id lookup-id)
            (tc-borrowed-string-builtin-call ctx env "__tl_string_eq" args)]
          [(tc-string-to-int-helper-call-id? env lookup-id)
            (tc-borrowed-string-builtin-call ctx env "__tl_string_to_int" args)]
          [(and
              (ctfe-reflection-query-name? name)
              (not (tc-name-bound? env name)))
            (tc-reflection-query-runtime-call name)]
          [(and
              (cbi.compiler-builtin-typecheck-clone-id? name-id)
              (not (tc-name-bound? env name)))
            (tc-clone-call ctx env args)]
          [else (tc-call-expr-ordinary ctx env func args)]))]
    [_ (tc-call-expr-ordinary ctx env func args)]))

;; Whether `name` resolves to any binding in `env` (a builtin, a top-level
;; user definition, or a local). Used to decide whether an unbound private
;; compiler intrinsic should be recovered as a builtin or as an ordinary direct
;; call to a shadowing user definition. Mirrors the host compiler's shadowing
;; check (#677).
(define (tc-name-bound? [env : TcTypeEnv] [name : String]) : bool
  (tc-name-bound-id? env (tc-name-id name)))

(define (tc-str-ref-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Ref _ inner)
      (match (tc-type-strip-region (ty-node-get inner))
        [(AstType.Str) true]
        [_ false])]
    [_ false]))

(define (tc-string-handle-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.String) true]
    [_ (tc-str-ref-type? ty)]))

(define (tc-bytes-ref-type? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Ref _ inner)
      (match (tc-type-strip-region (ty-node-get inner))
        [(AstType.Bytes) true]
        [_ false])]
    [(AstType.MutRef _ inner)
      (match (tc-type-strip-region (ty-node-get inner))
        [(AstType.Bytes) true]
        [_ false])]
    [_ false]))

(define (tc-bytes-handle-type? [ty : AstType]) : bool
  (tc-bytes-ref-type? ty))

(define (tc-length-handle-type? [ty : AstType]) : bool
  (or (tc-string-handle-type? ty) (tc-bytes-handle-type? ty)))

(define (tc-check-string-handle-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : AstExpr]
  [message : String]) : ResultTcUnit
  (match (tc-expr ctx env arg)
    [(ResultTcType.Ok arg-ty)
      (if (tc-string-handle-type? arg-ty)
        ResultTcUnit.Ok
        (ResultTcUnit.Err (tc-locate-error-at-expr arg message)))]
    [(ResultTcType.Err message) (ResultTcUnit.Err message)]))

(define (tc-check-length-handle-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : AstExpr]
  [message : String]) : ResultTcUnit
  (match (tc-expr ctx env arg)
    [(ResultTcType.Ok arg-ty)
      (if (tc-length-handle-type? arg-ty)
        ResultTcUnit.Ok
        (ResultTcUnit.Err (tc-locate-error-at-expr arg message)))]
    [(ResultTcType.Err message) (ResultTcUnit.Err message)]))

(define (tc-check-exact-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arg : AstExpr]
  [want : AstType]
  [message : String]) : ResultTcUnit
  (match (tc-expr-with-expected-or-actual ctx env arg want)
    [(ResultTcType.Ok arg-ty) (tc-expect-at-expr arg arg-ty want message)]
    [(ResultTcType.Err message) (ResultTcUnit.Err message)]))

(define (tc-one-string-handle-builtin-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [ret : AstType]) : ResultTcType
  (if (= (struct-get (& args) len) 1)
    (let
      [arg : AstExpr (ast-node-get (ast-expr-list-get (& args) 0 0))]
      (match (tc-check-string-handle-arg
        ctx
        env
        arg
        "typecheck: argument type mismatch")
        [(ResultTcUnit.Ok) (ResultTcType.Ok (tc-tag-active-region env ret))]
        [(ResultTcUnit.Err message) (ResultTcType.Err message)]))
    (ResultTcType.Err "typecheck: arity mismatch")))

(define (tc-one-length-handle-builtin-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [ret : AstType]) : ResultTcType
  (if (= (struct-get (& args) len) 1)
    (let
      [arg : AstExpr (ast-node-get (ast-expr-list-get (& args) 0 0))]
      (match (tc-check-length-handle-arg
        ctx
        env
        arg
        "typecheck: argument type mismatch")
        [(ResultTcUnit.Ok) (ResultTcType.Ok (tc-tag-active-region env ret))]
        [(ResultTcUnit.Err message) (ResultTcType.Err message)]))
    (ResultTcType.Err "typecheck: arity mismatch")))

(define (tc-two-string-handle-builtin-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [ret : AstType]) : ResultTcType
  (if (= (struct-get (& args) len) 2)
    (let
      [left : AstExpr (ast-node-get (ast-expr-list-get (& args) 0 0))]
      [right : AstExpr (ast-node-get (ast-expr-list-get (& args) 1 0))]
      (match (tc-check-string-handle-arg
        ctx
        env
        left
        "typecheck: argument type mismatch")
        [(ResultTcUnit.Ok)
          (match (tc-check-string-handle-arg
            ctx
            env
            right
            "typecheck: argument type mismatch")
            [(ResultTcUnit.Ok) (ResultTcType.Ok (tc-tag-active-region env ret))]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
        [(ResultTcUnit.Err message) (ResultTcType.Err message)]))
    (ResultTcType.Err "typecheck: arity mismatch")))

(define (tc-string-i64-i64-builtin-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [ret : AstType]) : ResultTcType
  (if (= (struct-get (& args) len) 3)
    (let
      [text : AstExpr (ast-node-get (ast-expr-list-get (& args) 0 0))]
      [start : AstExpr (ast-node-get (ast-expr-list-get (& args) 1 0))]
      [len : AstExpr (ast-node-get (ast-expr-list-get (& args) 2 0))]
      (match (tc-check-string-handle-arg
        ctx
        env
        text
        "typecheck: argument type mismatch")
        [(ResultTcUnit.Ok)
          (match (tc-check-exact-arg
            ctx
            env
            start
            (AstType.I64)
            "typecheck: argument type mismatch")
            [(ResultTcUnit.Ok)
              (match (tc-check-exact-arg
                ctx
                env
                len
                (AstType.I64)
                "typecheck: argument type mismatch")
                [(ResultTcUnit.Ok)
                  (ResultTcType.Ok (tc-tag-active-region env ret))]
                [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
        [(ResultTcUnit.Err message) (ResultTcType.Err message)]))
    (ResultTcType.Err "typecheck: arity mismatch")))

(define (tc-string-i64-builtin-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [ret : AstType]) : ResultTcType
  (if (= (struct-get (& args) len) 2)
    (let
      [text : AstExpr (ast-node-get (ast-expr-list-get (& args) 0 0))]
      [value : AstExpr (ast-node-get (ast-expr-list-get (& args) 1 0))]
      (match (tc-check-string-handle-arg
        ctx
        env
        text
        "typecheck: argument type mismatch")
        [(ResultTcUnit.Ok)
          (match (tc-check-exact-arg
            ctx
            env
            value
            (AstType.I64)
            "typecheck: argument type mismatch")
            [(ResultTcUnit.Ok) (ResultTcType.Ok (tc-tag-active-region env ret))]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
        [(ResultTcUnit.Err message) (ResultTcType.Err message)]))
    (ResultTcType.Err "typecheck: arity mismatch")))

(define (tc-i64-string-builtin-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]
  [ret : AstType]) : ResultTcType
  (if (= (struct-get (& args) len) 2)
    (let
      [value : AstExpr (ast-node-get (ast-expr-list-get (& args) 0 0))]
      [text : AstExpr (ast-node-get (ast-expr-list-get (& args) 1 0))]
      (match (tc-check-exact-arg
        ctx
        env
        value
        (AstType.I64)
        "typecheck: argument type mismatch")
        [(ResultTcUnit.Ok)
          (match (tc-check-string-handle-arg
            ctx
            env
            text
            "typecheck: argument type mismatch")
            [(ResultTcUnit.Ok) (ResultTcType.Ok (tc-tag-active-region env ret))]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
        [(ResultTcUnit.Err message) (ResultTcType.Err message)]))
    (ResultTcType.Err "typecheck: arity mismatch")))

(define (tc-string-length-helper-call-name?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-name : String]
  [lookup-name : String]) : bool
  (tc-string-length-helper-call-id?
    ctx
    env
    (tc-builtin-name-id source-name)
    (tc-builtin-name-id lookup-name)))

(define (tc-string-length-helper-call-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-id : i64]
  [lookup-id : i64]) : bool
  (tc-stdlib-string-helper-visible-or-wrapper-id?
    ctx
    env
    (cbi.compiler-builtin-typecheck-public-string-length-id? source-id)
    lookup-id
    "string-length"))

(define (tc-string-ref-helper-call-name?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-name : String]
  [lookup-name : String]) : bool
  (tc-string-ref-helper-call-id?
    ctx
    env
    (tc-builtin-name-id source-name)
    (tc-builtin-name-id lookup-name)))

(define (tc-string-ref-helper-call-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-id : i64]
  [lookup-id : i64]) : bool
  (or
    (and
      (cbi.compiler-builtin-typecheck-string-ref-call-id? lookup-id)
      (not (tc-name-bound-id? env lookup-id)))
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      (and
        (cbi.compiler-builtin-typecheck-public-string-ref-id? source-id)
        (not (cbi.compiler-builtin-typecheck-public-char-at-id? source-id)))
      lookup-id
      "string-ref")
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      (cbi.compiler-builtin-typecheck-public-char-at-id? source-id)
      lookup-id
      "char-at")))

(define (tc-string-eq-helper-call-name?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-name : String]
  [lookup-name : String]) : bool
  (tc-string-eq-helper-call-id?
    ctx
    env
    (tc-builtin-name-id source-name)
    (tc-builtin-name-id lookup-name)))

(define (tc-string-eq-helper-call-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-id : i64]
  [lookup-id : i64]) : bool
  (or
    (and
      (cbi.compiler-builtin-typecheck-string-eq-id? lookup-id)
      (tc-default-builtin-unshadowed-id? env lookup-id))
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      (= source-id (tc-name-id "eq"))
      lookup-id
      "eq")
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      (and
        (cbi.compiler-builtin-typecheck-public-string-eq-id? source-id)
        (not
          (cbi.compiler-builtin-typecheck-public-string-eq-question-id?
            source-id)))
      lookup-id
      "string-eq")
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      (cbi.compiler-builtin-typecheck-public-string-eq-question-id? source-id)
      lookup-id
      "string=?")))

(define (tc-string-copy-helper-call-id?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [source-id : i64]
  [lookup-id : i64]) : bool
  (or
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      (= source-id (tc-name-id "string-append"))
      lookup-id
      "string-append")
    (tc-stdlib-string-helper-visible-or-wrapper-id?
      ctx
      env
      (= source-id (tc-name-id "string-concat"))
      lookup-id
      "string-concat")))

(define (tc-string-to-int-helper-call-name?
  [_ctx : TcContext]
  [env : TcTypeEnv]
  [_source-name : String]
  [lookup-name : String]) : bool
  (tc-string-to-int-helper-call-id? env (tc-builtin-name-id lookup-name)))

(define (tc-string-to-int-helper-call-id? [env : TcTypeEnv] [lookup-id : i64]) : bool
  (and
    (cbi.compiler-builtin-typecheck-string-to-int-id? lookup-id)
    (tc-default-builtin-unshadowed-id? env lookup-id)))

(define (tc-borrowed-string-builtin-id? [name-id : i64]) : bool
  (cbi.compiler-builtin-typecheck-borrowed-string-id? name-id))

(define (tc-borrowed-string-builtin-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [args : AstExprList]) : ResultTcType
  (let
    [name-id : i64 (tc-builtin-name-id name)]
    (if (cbi.compiler-builtin-typecheck-string-eq-id? name-id)
      (tc-two-string-handle-builtin-call ctx env args (AstType.Bool))
      (if (cbi.compiler-builtin-typecheck-string-to-int-id? name-id)
        (tc-one-string-handle-builtin-call ctx env args (AstType.I64))
        (ResultTcType.Err "typecheck: unknown borrowed string builtin")))))

;; Typecheck the private `(__tl_string_ref s i)` intrinsic: a String plus any
;; integer index, yielding `char`. Public `string-ref` and `char-at` live in
;; stdlib/string.tl and lower through this private operation.
(define (tc-string-ref-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]) : ResultTcType
  (if (= (struct-get (& args) len) 2)
    (let
      [str : AstExpr (ast-node-get (ast-expr-list-get (& args) 0 0))]
      [index : AstExpr (ast-node-get (ast-expr-list-get (& args) 1 0))]
      (match (tc-expr ctx env str)
        [(ResultTcType.Ok str-ty)
          (if (tc-string-handle-type? str-ty)
            (match (tc-expr ctx env index)
              [(ResultTcType.Ok index-ty)
                (if (tc-integer-type? index-ty)
                  (ResultTcType.Ok (AstType.Char))
                  (ResultTcType.Err "typecheck: string index must be integer"))]
              [(ResultTcType.Err message) (ResultTcType.Err message)])
            (ResultTcType.Err "typecheck: string-ref requires String"))]
        [(ResultTcType.Err message) (ResultTcType.Err message)]))
    (ResultTcType.Err "typecheck: arity mismatch")))

(define (tc-length-string-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [func : AstExpr]
  [args : AstExprList]
  [arg-ty : AstType]) : ResultTcType
  (let
    [name-id : i64 (tc-builtin-name-id name)]
    [public-helper : bool
      (tc-string-length-helper-call-id? ctx env name-id name-id)]
    (begin
      (when
        (and
          (or public-helper (tc-default-builtin-unshadowed? env name))
          (tc-length-handle-type? arg-ty))
        (return (ResultTcType.Ok (AstType.I64))))
      (unless
        (cbi.compiler-builtin-typecheck-string-length-id? name-id)
        (return (tc-call-expr-ordinary ctx env func args)))
      (unless
        (or public-helper (tc-default-builtin-unshadowed? env name))
        (return (tc-call-expr-ordinary ctx env func args)))
      (if (tc-length-handle-type? arg-ty)
        (ResultTcType.Ok (AstType.I64))
        (ResultTcType.Err "typecheck: argument type mismatch")))))

(define (tc-array-length-non-array-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [func : AstExpr]
  [args : AstExprList]
  [arg-ty : AstType]) : ResultTcType
  (if (cbi.compiler-builtin-typecheck-array-length-id?
    (tc-builtin-name-id name))
    (if (and
      (tc-type-eq (tc-type-strip-region arg-ty) (AstType.Expr))
      (tc-name-bound? env name))
      (ResultTcType.Ok (AstType.I64))
      (ResultTcType.Err "typecheck: array-length requires dynamic array"))
    (tc-length-string-call ctx env name func args arg-ty)))

(define (tc-array-length-array-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [func : AstExpr]
  [args : AstExprList]) : ResultTcType
  (if (cbi.compiler-builtin-typecheck-string-length-id?
    (tc-builtin-name-id name))
    (if (tc-default-builtin-unshadowed? env name)
      (ResultTcType.Err "typecheck: argument type mismatch")
      (tc-call-expr-ordinary ctx env func args))
    (ResultTcType.Ok (AstType.I64))))

(define (tc-array-length-receiver [ctx : TcContext] [receiver-ty : AstType]) : ResultTcArrayReceiver
  (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
    [(AstType.DynArray elem-ty)
      (ResultTcArrayReceiver.Ok
        (TcArrayReceiver receiver-ty (ty-node-get elem-ty)))]
    [(AstType.Ref _ referent-ty)
      (tc-array-length-receiver ctx (ty-node-get referent-ty))]
    [(AstType.MutRef _ referent-ty)
      (tc-array-length-receiver ctx (ty-node-get referent-ty))]
    [_
      (ResultTcArrayReceiver.Err
        "typecheck: array-length requires dynamic array")]))

;; Runtime `array-length` remains dynamic-array-only. Macro helper environments
;; bind `array-length` for Expr operands so CTFE can validate fixed-array type
;; reflection.
;; `length` remains a transitional array alias. String/bytes length is a stdlib
;; wrapper over the private `__tl_string_length` intrinsic.
(define (tc-array-length-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [func : AstExpr]
  [args : AstExprList]) : ResultTcType
  (if (= (struct-get (& args) len) 1)
    (let
      [arg : AstExpr (ast-node-get (ast-expr-list-get (& args) 0 0))]
      (match (tc-expr ctx env arg)
        [(ResultTcType.Ok arg-ty)
          (match (tc-array-length-receiver ctx arg-ty)
            [(ResultTcArrayReceiver.Ok _)
              (tc-array-length-array-call ctx env name func args)]
            [(ResultTcArrayReceiver.Err _)
              (tc-array-length-non-array-call ctx env name func args arg-ty)])]
        [(ResultTcType.Err message) (ResultTcType.Err message)]))
    (if (cbi.compiler-builtin-typecheck-array-length-id?
      (tc-builtin-name-id name))
      (ResultTcType.Err "typecheck: arity mismatch")
      (tc-call-expr-ordinary ctx env func args))))

(define (tc-layout-query-name? [name : String]) : bool
  (if (string.eq name "size-of")
    true
    (if (string.eq name "align-of")
      true
      (string.eq name "offset-of"))))

;; Layout queries are CTFE-only. Inside `(comptime ...)` the typechecker gets the
;; folded value from `compiler-ctfe-eval`; if an unshadowed query reaches normal
;; expression typing, it is a runtime use and must be rejected.
(define (tc-one-arg-layout-query-runtime-call
  [name : String]
  [args : AstExprList]) : ResultTcType
  (if (= (struct-get (& args) len) 1)
    (ResultTcType.Err
      (string.append
        "typecheck: "
        (string.append name " is compile-time only; wrap it in (comptime ...)")))
    (ResultTcType.Err
      (string.append
        "typecheck: "
        (string.append name " expects exactly one type argument")))))

(define (tc-offset-layout-query-runtime-call [args : AstExprList]) : ResultTcType
  (if (= (struct-get (& args) len) 2)
    (ResultTcType.Err
      "typecheck: offset-of is compile-time only; wrap it in (comptime ...)")
    (ResultTcType.Err
      "typecheck: offset-of expects exactly one type argument and one field name")))

(define (tc-layout-query-runtime-call [name : String] [args : AstExprList]) : ResultTcType
  (if (string.eq name "offset-of")
    (tc-offset-layout-query-runtime-call args)
    (tc-one-arg-layout-query-runtime-call name args)))

(define (tc-reflection-query-runtime-call [name : String]) : ResultTcType
  (ResultTcType.Err
    (string.append
      "typecheck: "
      (string.append name " is compile-time only; wrap it in (comptime ...)"))))

;; The clone-able type set is a whole-program fixpoint (O(types*fields) plus a
;; type-name map build). It is invariant across a compile, but `tc-clone-able-
;; type?` is invoked once per `(clone ...)` / `with-escape` body in the program,
;; so recomputing it each time was a large repeated cost. Cache it per compile:
;; populated eagerly in the typecheck entry (program arena, so the cached map
;; never dangles into a scratch arena) and reset per compile in macro-expand-
;; program / the REPL entry. When not yet populated (e.g. REPL one-shot checks)
;; the set is rebuilt without caching, preserving correctness.
(define tc-clone-able-cache-ready : bool
  false)
(define tc-clone-able-cache : CloneNameSet
  (clone-name-set-empty))

(define (tc-clone-able-cache-reset!) : unit
  (begin
    (set! tc-clone-able-cache-ready false)
    (set! tc-clone-able-cache (clone-name-set-empty))))

(define (tc-clone-able-set-build [ctx : TcContext]) : CloneNameSet
  (match (tc-context-program ctx)
    [(AstProgram.Program decls-box)
      (let
        [decls : AstDeclList (box-get decls-box)]
        [pools : AstNodePoolContext (tc-context-pools ctx)]
        (clone-fixpoint
          pools
          decls
          (clone-all-type-names decls (clone-name-set-empty))))]))

(define (tc-clone-able-cache-populate! [ctx : TcContext]) : unit
  (begin
    (set! tc-clone-able-cache (tc-clone-able-set-build ctx))
    (set! tc-clone-able-cache-ready true)))

(define (tc-clone-able-set [ctx : TcContext]) : CloneNameSet
  (if tc-clone-able-cache-ready
    tc-clone-able-cache
    (tc-clone-able-set-build ctx)))

(define (tc-clone-able-type? [ctx : TcContext] [ty : AstType]) : bool
  (clone-field-type-able?
    (tc-context-pools ctx)
    (tc-type-without-regions (tc-resolve-type ctx ty))
    (tc-clone-able-set ctx)
    (tc-context-module ctx)))

;; `(clone x)` deep-copies x into the current arena (#1633). Type-directed: the
;; result is the argument's type, stripped of any inner-region tag (the copy
;; lands in the enclosing arena, not the source's region). Unsupported types are
;; rejected here so no heap-backed value silently lowers as a shallow handle copy.
(define (tc-clone-call [ctx : TcContext] [env : TcTypeEnv] [args : AstExprList]) : ResultTcType
  (if (= (struct-get (& args) len) 1)
    (let
      [arg : AstExpr (ast-node-get (ast-expr-list-get (& args) 0 0))]
      (match (tc-expr ctx env arg)
        [(ResultTcType.Ok arg-ty)
          (let
            [clone-ty : AstType (tc-type-without-regions arg-ty)]
            (if (tc-clone-able-type? ctx clone-ty)
              (ResultTcType.Ok clone-ty)
              (ResultTcType.Err
                (string.append
                  "typecheck: clone unsupported type "
                  (tc-type-render
                    (tc-type-without-regions (tc-resolve-type ctx arg-ty)))))))]
        [(ResultTcType.Err message) (ResultTcType.Err message)]))
    (ResultTcType.Err "typecheck: clone expects exactly one argument")))

(define (tc-tls-current-arena-read-call [args : AstExprList]) : ResultTcType
  (if (ast-expr-list-empty? (& args))
    (ResultTcType.Ok (AstType.I64))
    (ResultTcType.Err "typecheck: tls-current-arena expects no arguments")))

(define (tc-tls-current-arena-set-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]) : ResultTcType
  (match (tc-require-unsafe env "tls-current-arena-set!")
    [(ResultTcUnit.Ok)
      (if (= (struct-get (& args) len) 1)
        (let
          [value : AstExpr (ast-node-get (ast-expr-list-get (& args) 0 0))]
          (match (tc-check-exact-arg
            ctx
            env
            value
            (AstType.I64)
            "typecheck: tls-current-arena-set! value type mismatch")
            [(ResultTcUnit.Ok) (ResultTcType.Ok (AstType.Unit))]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)]))
        (ResultTcType.Err
          "typecheck: tls-current-arena-set! expects exactly one argument"))]
    [(ResultTcUnit.Err message) (ResultTcType.Err message)]))

(define (tc-tls-current-arena-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name-id : i64]
  [args : AstExprList]) : ResultTcType
  (if (cbi.compiler-builtin-typecheck-tls-current-arena-read-id? name-id)
    (tc-tls-current-arena-read-call args)
    (tc-tls-current-arena-set-call ctx env args)))

(define (tc-call-or-array-length
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]) : ResultTcType
  (match (ast-expr-unspan func)
    [(AstExpr.Var raw-name)
      ;; A builtin called from a macro expansion arrives hygiene-renamed
      ;; (`__tl_macro_global$__tl_string_length`), which would miss the
      ;; literal-name checks below and fall through to the strict registered
      ;; signature. Strip the hygiene-global prefix so macro-generated builtin
      ;; calls dispatch exactly like hand-written ones; `func` keeps the
      ;; original name for the ordinary call/resolution paths.
      (let
        [name : String (tc-hygiene-global-call-name (intern-str raw-name))]
        [name-id : i64 (tc-builtin-name-id name)]
        [lookup-id : i64 (tc-call-builtin-lookup-id ctx env name name-id)]
        (cond
          [(and (tc-layout-query-name? name) (not (tc-name-bound? env name)))
            (tc-layout-query-runtime-call name args)]
          [(tc-string-length-helper-call-id? ctx env name-id lookup-id)
            (tc-one-length-handle-builtin-call ctx env args (AstType.I64))]
          [(cbi.compiler-builtin-typecheck-length-call-id? name-id)
            (tc-array-length-call ctx env name func args)]
          [(and
              (cbi.compiler-builtin-typecheck-string-ref-call-id? name-id)
              (not (tc-name-bound? env name)))
            (tc-string-ref-call ctx env args)]
          [(tc-string-ref-helper-call-id? ctx env name-id lookup-id)
            (tc-string-ref-call ctx env args)]
          [(and (tc-atomic-pointer-name? name) (not (tc-name-bound? env name)))
            (tc-atomic-pointer-call ctx env name args)]
          [(tc-arena-safe-call-name? ctx env name "phase")
            (tc-phase-call ctx env args)]
          [(tc-arena-safe-call-name? ctx env name "rewind-safe!")
            (tc-rewind-safe-call ctx env args)]
          [(tc-arena-safe-call-name? ctx env name "destroy-safe!")
            (tc-destroy-safe-call ctx env args)]
          [(and
              (cbi.compiler-builtin-typecheck-tls-current-arena-id? name-id)
              (not (tc-name-bound? env name)))
            (tc-tls-current-arena-call ctx env name-id args)]
          [(and
              (tc-borrowed-string-builtin-id? name-id)
              (tc-default-builtin-unshadowed-id? env name-id))
            (tc-borrowed-string-builtin-call ctx env name args)]
          [(tc-string-eq-helper-call-id? ctx env name-id lookup-id)
            (tc-borrowed-string-builtin-call ctx env "__tl_string_eq" args)]
          [(tc-string-copy-helper-call-id? ctx env name-id lookup-id)
            (tc-two-string-handle-builtin-call ctx env args (AstType.String))]
          [(tc-string-to-int-helper-call-id? env lookup-id)
            (tc-borrowed-string-builtin-call ctx env "__tl_string_to_int" args)]
          [(and
              (ctfe-reflection-query-name? name)
              (not (tc-name-bound? env name)))
            (tc-reflection-query-runtime-call name)]
          [(and
              (cbi.compiler-builtin-typecheck-clone-id? name-id)
              (not (tc-name-bound? env name)))
            (tc-clone-call ctx env args)]
          [else (tc-call-expr-ordinary ctx env func args)]))]
    [_ (tc-call-expr-ordinary ctx env func args)]))

(define (tc-call-or-array-length-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]
  [args : AstExprList]) : ResultTcType
  (let
    [func : AstExpr (ast-node-get func-id)]
    (match (ast-expr-unspan func)
      [(AstExpr.Var raw-name)
        ;; Keep builtin dispatch identical to `tc-call-or-array-length`; only
        ;; the ordinary fallback needs the pooled function expression id.
        (let
          [name : String (tc-hygiene-global-call-name (intern-str raw-name))]
          [name-id : i64 (tc-builtin-name-id name)]
          [lookup-id : i64 (tc-call-builtin-lookup-id ctx env name name-id)]
          (cond
            [(and (tc-layout-query-name? name) (not (tc-name-bound? env name)))
              (tc-layout-query-runtime-call name args)]
            [(tc-string-length-helper-call-id? ctx env name-id lookup-id)
              (tc-one-length-handle-builtin-call ctx env args (AstType.I64))]
            [(cbi.compiler-builtin-typecheck-length-call-id? name-id)
              (tc-array-length-call ctx env name func args)]
            [(and
                (cbi.compiler-builtin-typecheck-string-ref-call-id? name-id)
                (not (tc-name-bound? env name)))
              (tc-string-ref-call ctx env args)]
            [(tc-string-ref-helper-call-id? ctx env name-id lookup-id)
              (tc-string-ref-call ctx env args)]
            [(and
                (tc-atomic-pointer-name? name)
                (not (tc-name-bound? env name)))
              (tc-atomic-pointer-call ctx env name args)]
            [(tc-arena-safe-call-name? ctx env name "phase")
              (tc-phase-call ctx env args)]
            [(tc-arena-safe-call-name? ctx env name "rewind-safe!")
              (tc-rewind-safe-call ctx env args)]
            [(tc-arena-safe-call-name? ctx env name "destroy-safe!")
              (tc-destroy-safe-call ctx env args)]
            [(and
                (cbi.compiler-builtin-typecheck-tls-current-arena-id? name-id)
                (not (tc-name-bound? env name)))
              (tc-tls-current-arena-call ctx env name-id args)]
            [(and
                (tc-borrowed-string-builtin-id? name-id)
                (tc-default-builtin-unshadowed-id? env name-id))
              (tc-borrowed-string-builtin-call ctx env name args)]
            [(tc-string-eq-helper-call-id? ctx env name-id lookup-id)
              (tc-borrowed-string-builtin-call ctx env "__tl_string_eq" args)]
            [(tc-string-copy-helper-call-id? ctx env name-id lookup-id)
              (tc-two-string-handle-builtin-call ctx env args (AstType.String))]
            [(tc-string-to-int-helper-call-id? env lookup-id)
              (tc-borrowed-string-builtin-call
                ctx
                env
                "__tl_string_to_int"
                args)]
            [(and
                (ctfe-reflection-query-name? name)
                (not (tc-name-bound? env name)))
              (tc-reflection-query-runtime-call name)]
            [(and
                (cbi.compiler-builtin-typecheck-clone-id? name-id)
                (not (tc-name-bound? env name)))
              (tc-clone-call ctx env args)]
            [else (tc-call-expr-ordinary-id ctx env func-id args)]))]
      [_ (tc-call-expr-ordinary-id ctx env func-id args)])))

(define (tc-let-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : AstLetBindingList]) : ResultTcEnv
  (tc-let-bindings-at ctx env (& bindings) 0))

(define (tc-let-binding-plain-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [maybe-ty : AstMaybeType]
  [init : AstExpr]) : ResultTcType
  (match maybe-ty
    [(AstMaybeType.Some want)
      (tc-expr-with-expected-or-actual ctx env init (tc-resolve-type ctx want))]
    [(AstMaybeType.No) (tc-expr ctx env init)]))

(define (tc-let-binding-plain-expected-ok
  [ctx : TcContext]
  [maybe-ty : AstMaybeType]
  [init-ty : AstType]) : ResultTcUnit
  (match maybe-ty
    [(AstMaybeType.Some want)
      (tc-expect
        init-ty
        (tc-resolve-type ctx want)
        "typecheck: let binding type mismatch")]
    [(AstMaybeType.No) ResultTcUnit.Ok]))

(define (tc-let-binding-plain-bind-type
  [ctx : TcContext]
  [maybe-ty : AstMaybeType]
  [init-ty : AstType]) : AstType
  (match maybe-ty
    [(AstMaybeType.Some want)
      (let
        [resolved-want : AstType (tc-resolve-type ctx want)]
        (if (tc-type-contains-any-region init-ty)
          init-ty
          resolved-want))]
    [(AstMaybeType.No) init-ty]))

(define (tc-let-bindings-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : ResultTcEnv
  (if (>= index (ast-let-binding-list-len bindings))
    (ResultTcEnv.Ok env)
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (match (tc-let-binding-plain-type ctx env maybe-ty init)
            [(ResultTcType.Ok init-ty)
              (match (tc-let-binding-plain-expected-ok ctx maybe-ty init-ty)
                [(ResultTcUnit.Ok)
                  (match (tc-ensure-cleanup-resource-not-let-bound
                    ctx
                    env
                    init
                    init-ty)
                    [(ResultTcUnit.Ok)
                      (match (tc-ensure-reference-value-can-bind env init-ty)
                        [(ResultTcUnit.Ok)
                          (tc-let-bindings-at
                            ctx
                            (tc-bind-c-abi-fnptr-if-needed-id
                              ctx
                              env
                              name
                              (tc-let-binding-plain-bind-type
                                ctx
                                maybe-ty
                                init-ty)
                              init)
                            bindings
                            (+ index 1))]
                        [(ResultTcUnit.Err message) (ResultTcEnv.Err message)])]
                    [(ResultTcUnit.Err message) (ResultTcEnv.Err message)])]
                [(ResultTcUnit.Err message) (ResultTcEnv.Err message)])]
            [(ResultTcType.Err message) (ResultTcEnv.Err message)]))])))

(define (tc-lambda-captures-reference-scan-root
  [env : TcTypeEnv]
  [bound : TcStringList]
  [body : AstExpr]) : bool
  (match env
    [(TcTypeEnv.Nil) false]
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-lambda-captures-reference-scan-root (box-get rest) bound body)
        false)]
    [(TcTypeEnv.Bind key ty rest)
      (if (or
        (= key (tc-region-marker-id))
        (= key (tc-default-boundary-id))
        (tc-cleanup-owner-marker-entry? key ty))
        (tc-lambda-captures-reference-scan-root (box-get rest) bound body)
        (if (and
          (tc-expr-uses-free-name? body (intern-str key) bound)
          (tc-type-contains-reference? ty))
          true
          (tc-lambda-captures-reference-scan-root (box-get rest) bound body)))]))

(define (tc-lambda-captures-reference?
  [env : TcTypeEnv]
  [params : AstParamList]
  [body : AstExpr]) : bool
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match env
      [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
        (tc-lambda-captures-reference-scan-root
          (box-get rest)
          (tc-param-bound-names params)
          body)]
      [_
        (tc-lambda-captures-reference-scan-root
          env
          (tc-param-bound-names params)
          body)])))

(define (tc-ref-capturing-lambda-init? [env : TcTypeEnv] [init : AstExpr]) : bool
  (match (ast-expr-unspan init)
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (tc-lambda-captures-reference? env params body))])]
    [_ false]))

(define (tc-ref-closure-expr-list-local-uses-ok?
  [exprs : AstExprList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-ref-closure-expr-list-local-uses-ok-at? (& exprs) 0 name bound))

(define (tc-ref-closure-expr-list-local-uses-ok-at?
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [name : String]
  [bound : TcStringList]) : bool
  (if (>= index (struct-get exprs len))
    true
    (and
      (tc-ref-closure-local-uses-ok?
        (ast-node-get (ast-expr-list-get exprs index 0))
        name
        bound)
      (tc-ref-closure-expr-list-local-uses-ok-at? exprs (+ index 1) name bound))))

(define (tc-ref-closure-let-binding-list-local-uses-ok?
  [bindings : AstLetBindingList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-ref-closure-let-binding-list-local-uses-ok-at? (& bindings) name bound 0))

(define (tc-ref-closure-let-binding-list-local-uses-ok-at?
  [bindings : (& bindings AstLetBindingList)]
  [name : String]
  [bound : TcStringList]
  [index : i64]) : bool
  (if (>= index (ast-let-binding-list-len bindings))
    true
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding bind-name _ init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (and
            (tc-ref-closure-local-uses-ok? init name bound)
            (tc-ref-closure-let-binding-list-local-uses-ok-at?
              bindings
              name
              (tc-string-list-add bound (intern-str bind-name))
              (+ index 1))))])))

(define (tc-ref-closure-let-rest-and-body-local-uses-ok?
  [bindings : AstLetBindingList]
  [body : AstExpr]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-ref-closure-let-rest-and-body-local-uses-ok-at?
    (& bindings)
    body
    name
    bound
    0))

(define (tc-ref-closure-let-rest-and-body-local-uses-ok-at?
  [bindings : (& bindings AstLetBindingList)]
  [body : AstExpr]
  [name : String]
  [bound : TcStringList]
  [index : i64]) : bool
  (if (>= index (ast-let-binding-list-len bindings))
    (tc-ref-closure-local-uses-ok? body name bound)
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding bind-name _ init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (and
            (tc-ref-closure-local-uses-ok? init name bound)
            (tc-ref-closure-let-rest-and-body-local-uses-ok-at?
              bindings
              body
              name
              (tc-string-list-add bound (intern-str bind-name))
              (+ index 1))))])))

(define (tc-ref-closure-resource-binding-list-local-uses-ok?
  [bindings : AstResourceBindingList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-ref-closure-resource-binding-list-local-uses-ok-at?
    (& bindings)
    name
    bound
    0))

(define (tc-ref-closure-resource-binding-list-local-uses-ok-at?
  [bindings : (& bindings AstResourceBindingList)]
  [name : String]
  [bound : TcStringList]
  [index : i64]) : bool
  (if (>= index (ast-resource-binding-list-len bindings))
    true
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding bind-name init-box cleanup-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          [cleanup : AstExpr (ast-node-get cleanup-box)]
          (and
            (tc-ref-closure-local-uses-ok? init name bound)
            (tc-ref-closure-local-uses-ok? cleanup name bound)
            (tc-ref-closure-resource-binding-list-local-uses-ok-at?
              bindings
              name
              (tc-string-list-add bound (intern-str bind-name))
              (+ index 1))))])))

(define (tc-ref-closure-match-arms-local-uses-ok?
  [arms : AstMatchArmList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-ref-closure-match-arms-local-uses-ok-at? (& arms) name bound 0))

(define (tc-ref-closure-match-arms-local-uses-ok-at?
  [arms : (& arms AstMatchArmList)]
  [name : String]
  [bound : TcStringList]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    true
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (let
          [body : AstExpr (ast-node-get body-box)]
          (and
            (tc-ref-closure-local-uses-ok?
              body
              name
              (tc-pattern-add-bound-names pattern bound))
            (tc-ref-closure-match-arms-local-uses-ok-at?
              arms
              name
              bound
              (+ index 1))))])))

(define (tc-ref-closure-direct-call?
  [func : AstExpr]
  [name : String]
  [bound : TcStringList]) : bool
  (match (ast-expr-unspan func)
    [(AstExpr.Var var-name)
      (and
        (string.eq (intern-str var-name) name)
        (not (tc-string-list-contains bound name)))]
    [_ false]))

(define (tc-ref-closure-local-uses-ok?
  [expr : AstExpr]
  [name : String]
  [bound : TcStringList]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExpr.Var var-name)
      (not
        (and
          (string.eq (intern-str var-name) name)
          (not (tc-string-list-contains bound name))))]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (and
          (tc-ref-closure-local-uses-ok? left name bound)
          (tc-ref-closure-local-uses-ok? right name bound)))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (if (tc-ref-closure-direct-call? func name bound)
          (tc-ref-closure-expr-list-local-uses-ok? args name bound)
          (and
            (tc-ref-closure-local-uses-ok? func name bound)
            (tc-ref-closure-expr-list-local-uses-ok? args name bound))))]
    [(AstExpr.BracketClause items)
      (tc-ref-closure-expr-list-local-uses-ok? items name bound)]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-box)]
        [else-branch : AstExpr (ast-node-get else-box)]
        (and
          (tc-ref-closure-local-uses-ok? cond name bound)
          (tc-ref-closure-local-uses-ok? then-branch name bound)
          (tc-ref-closure-local-uses-ok? else-branch name bound)))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (and
              (tc-ref-closure-let-binding-list-local-uses-ok?
                bindings
                name
                bound)
              (tc-ref-closure-local-uses-ok?
                body
                name
                (tc-let-binding-list-add-bound-names bindings bound))))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (not
              (tc-expr-uses-free-name?
                body
                name
                (tc-param-list-add-bound-names params bound))))])]
    [(AstExpr.Tuple exprs)
      (tc-ref-closure-expr-list-local-uses-ok? exprs name bound)]
    [(AstExpr.TupleRef tuple-box _)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        (tc-ref-closure-local-uses-ok? tuple name bound))]
    [(AstExpr.Array exprs)
      (tc-ref-closure-expr-list-local-uses-ok? exprs name bound)]
    [(AstExpr.MakeArray _ len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (tc-ref-closure-local-uses-ok? len name bound))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (and
          (tc-ref-closure-local-uses-ok? array name bound)
          (tc-ref-closure-local-uses-ok? index name bound)))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (and
          (tc-ref-closure-local-uses-ok? array name bound)
          (tc-ref-closure-local-uses-ok? index name bound)
          (tc-ref-closure-local-uses-ok? value name bound)))]
    [(AstExpr.ArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (and
          (tc-ref-closure-local-uses-ok? array name bound)
          (tc-ref-closure-local-uses-ok? value name bound)))]
    [(AstExpr.StringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (and
          (tc-ref-closure-local-uses-ok? str name bound)
          (tc-ref-closure-local-uses-ok? index name bound)))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (and
          (tc-ref-closure-local-uses-ok? cond name bound)
          (tc-ref-closure-local-uses-ok? body name bound)))]
    [(AstExpr.Begin exprs)
      (tc-ref-closure-expr-list-local-uses-ok? exprs name bound)]
    [(AstExpr.Unsafe exprs)
      (tc-ref-closure-expr-list-local-uses-ok? exprs name bound)]
    [(AstExpr.Set var-name value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (and
          (not
            (and
              (string.eq (intern-str var-name) name)
              (not (tc-string-list-contains bound name))))
          (tc-ref-closure-local-uses-ok? value name bound)))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExpr.Borrow _ _ place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (tc-ref-closure-local-uses-ok? place name bound))]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExpr.BoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (and
          (tc-ref-closure-local-uses-ok? inner name bound)
          (tc-ref-closure-local-uses-ok? value name bound)))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            (and
              (tc-ref-closure-local-uses-ok? scrutinee name bound)
              (tc-ref-closure-match-arms-local-uses-ok? arms name bound)))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach index _ start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (and
              (tc-ref-closure-local-uses-ok? start name bound)
              (tc-ref-closure-local-uses-ok? end name bound)
              (tc-ref-closure-local-uses-ok?
                body
                name
                (tc-string-list-add bound (intern-str index)))))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce _ index _ start-box end-box init-box value-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            (and
              (tc-ref-closure-local-uses-ok? start name bound)
              (tc-ref-closure-local-uses-ok? end name bound)
              (tc-ref-closure-local-uses-ok? init name bound)
              (tc-ref-closure-local-uses-ok?
                value
                name
                (tc-string-list-add bound (intern-str index)))))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            _
            index
            _
            start-box
            end-box
            prefix
            _
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            [index-bound : TcStringList
              (tc-string-list-add bound (intern-str index))]
            [body-bound : TcStringList
              (tc-string-list-add index-bound (intern-str prefix))]
            (and
              (tc-ref-closure-local-uses-ok? start name bound)
              (tc-ref-closure-local-uses-ok? end name bound)
              (tc-ref-closure-local-uses-ok? init name bound)
              (tc-ref-closure-local-uses-ok? value name index-bound)
              (tc-ref-closure-local-uses-ok? body name body-bound)))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (and
          (tc-ref-closure-local-uses-ok? value name bound)
          (tc-ref-closure-local-uses-ok? lane name bound)))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (and
          (tc-ref-closure-local-uses-ok? value name bound)
          (tc-ref-closure-local-uses-ok? lane name bound)))]
    [(AstExpr.StructGet receiver-box _)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (tc-ref-closure-local-uses-ok? receiver name bound))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (and
          (tc-ref-closure-local-uses-ok? receiver name bound)
          (tc-ref-closure-local-uses-ok? value name bound)))]
    [(AstExpr.WithRegion _ body)
      (tc-ref-closure-expr-list-local-uses-ok? body name bound)]
    [(AstExpr.WithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (and
          (tc-ref-closure-local-uses-ok? scratch name bound)
          (tc-ref-closure-expr-list-local-uses-ok? body name bound)))]
    [(AstExpr.WithScratch body)
      (tc-ref-closure-expr-list-local-uses-ok? body name bound)]
    [(AstExpr.InArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (and
          (tc-ref-closure-local-uses-ok? arena name bound)
          (tc-ref-closure-expr-list-local-uses-ok? body name bound)))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (and
            (tc-ref-closure-resource-binding-list-local-uses-ok?
              bindings
              name
              bound)
            (tc-ref-closure-expr-list-local-uses-ok?
              body
              name
              (tc-resource-binding-list-add-bound-names bindings bound)))])]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExpr.Quote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExpr.Quasiquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExpr.Unquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExpr.UnquoteSplicing inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExpr.Return inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExpr.PtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-ref-closure-local-uses-ok? inner name bound))]
    [(AstExpr.PtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-ref-closure-local-uses-ok? ptr name bound))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (and
          (tc-ref-closure-local-uses-ok? ptr name bound)
          (tc-ref-closure-local-uses-ok? value name bound)))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (and
          (tc-ref-closure-local-uses-ok? ptr name bound)
          (tc-ref-closure-local-uses-ok? offset name bound)))]
    [(AstExpr.PtrCast ptr-box _)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-ref-closure-local-uses-ok? ptr name bound))]
    [(AstExpr.PtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-ref-closure-local-uses-ok? ptr name bound))]
    [(AstExpr.IntToPtr value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-ref-closure-local-uses-ok? value name bound))]
    [(AstExpr.StringData str-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        (tc-ref-closure-local-uses-ok? str name bound))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (and
          (tc-ref-closure-local-uses-ok? ptr name bound)
          (tc-ref-closure-local-uses-ok? len name bound)))]
    [(AstExpr.ArrayData array-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-ref-closure-local-uses-ok? array name bound))]
    [(AstExpr.BinaryData _) true]
    [(AstExpr.SpmdProgramIndex) true]
    [(AstExpr.SpmdProgramCount) true]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (and
          (tc-ref-closure-local-uses-ok? leaf name bound)
          (tc-ref-closure-local-uses-ok? subleaf name bound)))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (and
          (tc-ref-closure-local-uses-ok? leaf name bound)
          (tc-ref-closure-local-uses-ok? subleaf name bound)))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (and
          (tc-ref-closure-local-uses-ok? leaf name bound)
          (tc-ref-closure-local-uses-ok? subleaf name bound)))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (and
          (tc-ref-closure-local-uses-ok? leaf name bound)
          (tc-ref-closure-local-uses-ok? subleaf name bound)))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (tc-ref-closure-local-uses-ok? index name bound))]
    [(AstExpr.Syscall args)
      (tc-ref-closure-expr-list-local-uses-ok? args name bound)]
    [_ (not (tc-expr-uses-free-name? expr name bound))]))

(define (tc-reference-closure-escape-message) : String
  "typecheck: reference-capturing closure value would escape lexical scope")

(define (tc-let-binding-ref-closure-scope-ok
  [rest : AstLetBindingList]
  [body : AstExpr]
  [name : String]) : ResultTcUnit
  (if (tc-ref-closure-let-rest-and-body-local-uses-ok?
    rest
    body
    name
    TcStringList.Nil)
    ResultTcUnit.Ok
    (ResultTcUnit.Err (tc-reference-closure-escape-message))))

(define (tc-let-binding-ref-closure-scope-ok-at
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]
  [body : AstExpr]
  [name : String]) : ResultTcUnit
  (if (tc-ref-closure-let-rest-and-body-local-uses-ok-at?
    bindings
    body
    name
    TcStringList.Nil
    index)
    ResultTcUnit.Ok
    (ResultTcUnit.Err (tc-reference-closure-escape-message))))

;; --------------------------------------------------------------------------
;; Inferred-type hint collection (used by the LSP for inlay hints).
;;
;; Disabled by default so normal and bootstrap compiles are byte-for-byte
;; unaffected. When enabled, the typechecker records the rendered inferred type
;; and 1-based source position of each un-annotated `let` binding value. A ring
;; buffer keeps the most recent records, so the entry document (whose decls are
;; checked last) is always retained even when imported modules are re-checked.
;; Records are not file-attributed; the LSP filters them against the open
;; document's text before turning them into hints.
;; --------------------------------------------------------------------------
(define tc-inlay-hint-capacity : i64
  65536)
(define tc-inlay-hint-enabled : bool
  false)
(define tc-inlay-hint-count : i64
  0)
(define tc-inlay-hint-lines : (Array i64)
  (array.make-array i64 65536))
(define tc-inlay-hint-cols : (Array i64)
  (array.make-array i64 65536))
(define tc-inlay-hint-types : (Array String)
  (array.make-array String 65536))

(define (tc-inlay-hints-enable!) : unit
  (begin
    (set! tc-inlay-hint-count 0)
    (set! tc-inlay-hint-enabled true)))

(define (tc-inlay-hints-disable!) : unit
  (set! tc-inlay-hint-enabled false))

(define (tc-inlay-hints-size) : i64
  (if (< tc-inlay-hint-count tc-inlay-hint-capacity)
    tc-inlay-hint-count
    tc-inlay-hint-capacity))

(define (tc-inlay-hint-line-at [i : i64]) : i64
  (array-ref tc-inlay-hint-lines i))

(define (tc-inlay-hint-col-at [i : i64]) : i64
  (array-ref tc-inlay-hint-cols i))

(define (tc-inlay-hint-type-at [i : i64]) : String
  (array-ref tc-inlay-hint-types i))

(define (tc-inlay-hint-record! [line : i64] [col : i64] [ty : String]) : unit
  (let
    [slot : i64 (% tc-inlay-hint-count tc-inlay-hint-capacity)]
    (begin
      (array-set! tc-inlay-hint-lines slot line)
      (array-set! tc-inlay-hint-cols slot col)
      (array-set! tc-inlay-hint-types slot ty)
      (set! tc-inlay-hint-count (+ tc-inlay-hint-count 1)))))

;; Record the inferred type of an un-annotated let binding value, if collection
;; is enabled and the value expression carries a source span.
;; Caller guards on tc-inlay-hint-enabled so the disabled path never calls this
;; (keeping the per-binding cost in normal compiles to a single flag check).
(define (tc-inlay-hint-maybe-record
  [maybe-ty : AstMaybeType]
  [init : AstExpr]
  [init-ty : AstType]) : unit
  (match maybe-ty
    [(AstMaybeType.No)
      (match init
        [(AstExpr.Spanned _ span)
          (tc-inlay-hint-record!
            (struct-get span start-line)
            (struct-get span start-col)
            (tc-type-render init-ty))]
        [_ unit])]
    [(AstMaybeType.Some _) unit]))

(define (tc-let-binding-init-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [maybe-ty : AstMaybeType]
  [init-id : i64]
  [rest : AstLetBindingList]
  [body : AstExpr]) : ResultTcType
  (tc-let-binding-init-type-at ctx env name maybe-ty init-id (& rest) 0 body))

(define (tc-let-binding-init-type-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]
  [maybe-ty : AstMaybeType]
  [init-id : i64]
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]
  [body : AstExpr]) : ResultTcType
  (let
    [init : AstExpr (ast-node-get init-id)]
    [ref-capturing-lambda : bool (tc-ref-capturing-lambda-init? env init)]
    (match maybe-ty
      [(AstMaybeType.Some want)
        (let
          [resolved-want : AstType (tc-resolve-type ctx want)]
          (if ref-capturing-lambda
            (match (tc-let-binding-ref-closure-scope-ok-at
              bindings
              index
              body
              name)
              [(ResultTcUnit.Ok)
                (match (ast-expr-unspan init)
                  [(AstExpr.Lambda lambda-box)
                    (match (box-get lambda-box)
                      [(AstLambda.Lambda params maybe-ret lambda-body-box)
                        (let
                          [lambda-body : AstExpr (ast-node-get lambda-body-box)]
                          (tc-lambda-expr-allow-ref-captures
                            ctx
                            env
                            params
                            maybe-ret
                            lambda-body))])]
                  [_
                    (tc-expr-with-expected-or-actual-id
                      ctx
                      env
                      init-id
                      resolved-want)])]
              [(ResultTcUnit.Err message) (ResultTcType.Err message)])
            (tc-expr-with-expected-or-actual-id ctx env init-id resolved-want)))]
      [(AstMaybeType.No)
        (if ref-capturing-lambda
          (match (tc-let-binding-ref-closure-scope-ok-at
            bindings
            index
            body
            name)
            [(ResultTcUnit.Ok)
              (match (ast-expr-unspan init)
                [(AstExpr.Lambda lambda-box)
                  (match (box-get lambda-box)
                    [(AstLambda.Lambda params maybe-ret lambda-body-box)
                      (let
                        [lambda-body : AstExpr (ast-node-get lambda-body-box)]
                        (tc-lambda-expr-allow-ref-captures
                          ctx
                          env
                          params
                          maybe-ret
                          lambda-body))])]
                [_ (tc-expr-id ctx env init-id)])]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)])
          (tc-expr-id ctx env init-id))])))

(define (tc-let-bindings-for-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : AstLetBindingList]
  [body : AstExpr]) : ResultTcEnv
  (tc-let-bindings-for-body-at ctx env (& bindings) body 0))

(define (tc-let-bindings-for-body-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : (& bindings AstLetBindingList)]
  [body : AstExpr]
  [index : i64]) : ResultTcEnv
  (if (>= index (ast-let-binding-list-len bindings))
    (ResultTcEnv.Ok env)
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (match (tc-let-binding-init-type-at
            ctx
            env
            (intern-str name)
            maybe-ty
            init-box
            bindings
            (+ index 1)
            body)
            [(ResultTcType.Ok init-ty)
              (begin
                (if tc-inlay-hint-enabled
                  (tc-inlay-hint-maybe-record maybe-ty init init-ty)
                  unit)
                (match maybe-ty
                  [(AstMaybeType.Some want)
                    (let
                      [resolved-want : AstType (tc-resolve-type ctx want)]
                      (match (tc-expect
                        init-ty
                        resolved-want
                        "typecheck: let binding type mismatch")
                        [(ResultTcUnit.Ok)
                          (match (tc-ensure-cleanup-resource-not-let-bound
                            ctx
                            env
                            init
                            init-ty)
                            [(ResultTcUnit.Ok)
                              (match (tc-ensure-reference-value-can-bind
                                env
                                init-ty)
                                [(ResultTcUnit.Ok)
                                  (tc-let-bindings-for-body-at
                                    ctx
                                    (let
                                      [binding-ty : AstType
                                        (if (tc-type-contains-any-region
                                          init-ty)
                                          init-ty
                                          resolved-want)]
                                      (tc-bind-c-abi-fnptr-if-needed-id
                                        ctx
                                        env
                                        name
                                        binding-ty
                                        init))
                                    bindings
                                    body
                                    (+ index 1))]
                                [(ResultTcUnit.Err message)
                                  (ResultTcEnv.Err message)])]
                            [(ResultTcUnit.Err message)
                              (ResultTcEnv.Err message)])]
                        [(ResultTcUnit.Err message) (ResultTcEnv.Err message)]))]
                  [(AstMaybeType.No)
                    (match (tc-ensure-cleanup-resource-not-let-bound
                      ctx
                      env
                      init
                      init-ty)
                      [(ResultTcUnit.Ok)
                        (match (tc-ensure-reference-value-can-bind env init-ty)
                          [(ResultTcUnit.Ok)
                            (tc-let-bindings-for-body-at
                              ctx
                              (tc-bind-c-abi-fnptr-if-needed-id
                                ctx
                                env
                                name
                                init-ty
                                init)
                              bindings
                              body
                              (+ index 1))]
                          [(ResultTcUnit.Err message) (ResultTcEnv.Err message)])]
                      [(ResultTcUnit.Err message) (ResultTcEnv.Err message)])]))]
            [(ResultTcType.Err message) (ResultTcEnv.Err message)]))])))

(define (tc-resource-cleanup-direct-name-ok [cleanup : AstExpr]) : ResultTcUnit
  (match (ast-expr-unspan cleanup)
    [(AstExpr.Var _) ResultTcUnit.Ok]
    [_
      (ResultTcUnit.Err
        "typecheck: with cleanup must be a direct function name")]))

(define (tc-resource-cleanup-resource-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [cleanup : AstExpr]) : ResultTcType
  (match (tc-resource-cleanup-direct-name-ok cleanup)
    [(ResultTcUnit.Ok)
      (match (tc-expr ctx env cleanup)
        [(ResultTcType.Ok cleanup-ty)
          (match (tc-type-strip-region (tc-resolve-type ctx cleanup-ty))
            [(AstType.Func args ret)
              (let
                [ret-ty : AstType (ty-node-get ret)]
                [args : AstTypeList (box-get args)]
                (if (= (ast-type-list-len (& args)) 1)
                  (let
                    [arg-ty : AstType
                      (ty-node-get
                        (ast-type-list-get (& args) 0 (ast-type-id-fallback)))]
                    (if (tc-type-eq ret-ty (AstType.Unit))
                      (ResultTcType.Ok arg-ty)
                      (ResultTcType.Err
                        "typecheck: with cleanup function type mismatch")))
                  (ResultTcType.Err
                    "typecheck: with cleanup function type mismatch")))]
            [_
              (ResultTcType.Err
                "typecheck: with cleanup function type mismatch")])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcUnit.Err message) (ResultTcType.Err message)]))

(define (tc-resource-cleanup-ok
  [ctx : TcContext]
  [env : TcTypeEnv]
  [cleanup : AstExpr]
  [resource-ty : AstType]) : ResultTcUnit
  (match (tc-resource-cleanup-resource-type ctx env cleanup)
    [(ResultTcType.Ok cleanup-resource-ty)
      (tc-expect
        cleanup-resource-ty
        (tc-type-without-regions resource-ty)
        "typecheck: with cleanup function type mismatch")]
    [(ResultTcType.Err message) (ResultTcUnit.Err message)]))

(define (tc-resource-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : AstResourceBindingList]) : ResultTcEnv
  (tc-resource-bindings-at ctx env (& bindings) 0))

(define (tc-resource-bindings-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : (& bindings AstResourceBindingList)]
  [index : i64]) : ResultTcEnv
  (if (>= index (ast-resource-binding-list-len bindings))
    (ResultTcEnv.Ok env)
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding name init-box cleanup-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          [cleanup : AstExpr (ast-node-get cleanup-box)]
          (match (tc-resource-cleanup-resource-type ctx env cleanup)
            [(ResultTcType.Ok expected-init-ty)
              (match (tc-expr-with-expected-or-actual-id
                ctx
                env
                init-box
                expected-init-ty)
                [(ResultTcType.Ok init-ty)
                  (match (tc-ensure-cleanup-resource-not-transferred env init)
                    [(ResultTcUnit.Ok)
                      (match (tc-resource-cleanup-ok ctx env cleanup init-ty)
                        [(ResultTcUnit.Ok)
                          (tc-resource-bindings-at
                            ctx
                            (tc-bind-id
                              (tc-bind-cleanup-owner env (intern-str name))
                              name
                              (tc-type-without-regions init-ty))
                            bindings
                            (+ index 1))]
                        [(ResultTcUnit.Err message) (ResultTcEnv.Err message)])]
                    [(ResultTcUnit.Err message) (ResultTcEnv.Err message)])]
                [(ResultTcType.Err message) (ResultTcEnv.Err message)])]
            [(ResultTcType.Err message) (ResultTcEnv.Err message)]))])))

(define (tc-begin-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]) : ResultTcType
  (tc-begin-list-at ctx env (& exprs) 0))

(define (tc-begin-list-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : ResultTcType
  (if (>= index (struct-get exprs len))
    (ResultTcType.Ok (AstType.Unit))
    (if (= (+ index 1) (struct-get exprs len))
      (tc-expr-id ctx env (ast-expr-list-get exprs index 0))
      (match (tc-expr-id ctx env (ast-expr-list-get exprs index 0))
        [(ResultTcType.Ok _) (tc-begin-list-at ctx env exprs (+ index 1))]
        [(ResultTcType.Err message) (ResultTcType.Err message)]))))

(define (tc-spmd-require-uniform [class : TcSpmdClass] [message : String]) : ResultTcUnit
  (if (tc-spmd-varying? class)
    (ResultTcUnit.Err message)
    ResultTcUnit.Ok))

(define (tc-spmd-inline-helper-empty-stack) : TcStringList
  TcStringList.Nil)

(define tc-spmd-inline-helper-stack : TcStringList
  (tc-spmd-inline-helper-empty-stack))

(define (tc-spmd-inline-helper-stack-reset!) : unit
  (set! tc-spmd-inline-helper-stack (tc-spmd-inline-helper-empty-stack)))

(define (tc-spmd-inline-helper-recursive-message) : String
  "typecheck: recursive SPMD inline helper call is not supported")

(define (tc-spmd-inline-helper-resolve-name
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [func : AstExpr]) : ResultTcString
  (match (ast-expr-unspan func)
    [(AstExpr.Var raw-name)
      (let
        [raw-text : String (intern-str raw-name)]
        (cond
          [(tc-spmd-env-has-local? spmd-env raw-text) (ResultTcString.Err "")]
          [(tc-hygiene-global-name? raw-text)
            (ResultTcString.Ok (tc-hygiene-global-call-name raw-text))]
          [(tc-name-qualified? raw-text) (ResultTcString.Ok raw-text)]
          [else (tc-source-name-lookup-key ctx env raw-text)]))]
    [_ (ResultTcString.Err "")]))

(define (tc-spmd-inline-helper-from-decl [name : String] [decl : AstDecl]) : ResultTcSpmdInlineHelper
  (match decl
    [(AstDecl.DefFn _ params ret body-box _)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (ResultTcSpmdInlineHelper.Ok
          (TcSpmdInlineHelper.Some name params ret body)))]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (tc-spmd-inline-helper-from-decl name inner))]
    [(AstDecl.ComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (tc-spmd-inline-helper-from-decl name template))]
    [_ (ResultTcSpmdInlineHelper.Ok (TcSpmdInlineHelper.No))]))

(define (tc-spmd-inline-helper-lookup
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [func : AstExpr]) : ResultTcSpmdInlineHelper
  (match (tc-spmd-inline-helper-resolve-name ctx env spmd-env func)
    [(ResultTcString.Ok lookup-name)
      (if (string.eq lookup-name "")
        (ResultTcSpmdInlineHelper.Ok (TcSpmdInlineHelper.No))
        (if (tc-string-list-contains tc-spmd-inline-helper-stack lookup-name)
          (ResultTcSpmdInlineHelper.Err
            (tc-spmd-inline-helper-recursive-message))
          (let
            [handle : i64
              (compiler-symbols-lookup-value-or
                (tc-context-symbols ctx)
                lookup-name
                (compiler-symbols-missing-handle))]
            (if (compiler-symbols-handle-found? handle)
              (if (=
                (compiler-symbol-handle-kind handle)
                (compiler-symbol-kind-function-define))
                (match (compiler-symbols-decl-at-index
                  (tc-context-symbols ctx)
                  (compiler-symbol-handle-index handle))
                  [(ResultAstDecl.Ok decl)
                    (tc-spmd-inline-helper-from-decl lookup-name decl)]
                  [(ResultAstDecl.Err message)
                    (ResultTcSpmdInlineHelper.Err message)])
                (ResultTcSpmdInlineHelper.Ok (TcSpmdInlineHelper.No)))
              (ResultTcSpmdInlineHelper.Ok (TcSpmdInlineHelper.No))))))]
    [(ResultTcString.Err message)
      (if (string.eq message "")
        (ResultTcSpmdInlineHelper.Ok (TcSpmdInlineHelper.No))
        (ResultTcSpmdInlineHelper.Err message))]))

(define (tc-spmd-inline-helper-module [ctx : TcContext] [name : String]) : String
  (if (tc-name-qualified? name)
    (tc-qualified-name-module name)
    (tc-context-module ctx)))

(define (tc-spmd-inline-helper-env
  [ctx : TcContext]
  [fallback : TcTypeEnv]
  [module : String]) : TcTypeEnv
  (match (tc-hygiene-definition-env ctx module)
    [(ResultTcEnv.Ok helper-env) helper-env]
    [(ResultTcEnv.Err _) fallback]))

(define (tc-spmd-inline-helper-bind-args
  [ctx : TcContext]
  [caller-env : TcTypeEnv]
  [caller-spmd-env : TcSpmdEnv]
  [helper-ctx : TcContext]
  [helper-env : TcTypeEnv]
  [helper-spmd-env : TcSpmdEnv]
  [params : AstParamList]
  [args : AstExprList]
  [seen-class : TcSpmdClass]) : ResultTcSpmdInlineCallState
  (tc-spmd-inline-helper-bind-args-at
    ctx
    caller-env
    caller-spmd-env
    helper-ctx
    helper-env
    helper-spmd-env
    (& params)
    (& args)
    0
    seen-class))

(define (tc-spmd-inline-helper-bind-args-at
  [ctx : TcContext]
  [caller-env : TcTypeEnv]
  [caller-spmd-env : TcSpmdEnv]
  [helper-ctx : TcContext]
  [helper-env : TcTypeEnv]
  [helper-spmd-env : TcSpmdEnv]
  [params : (& params AstParamList)]
  [args : (& args AstExprList)]
  [index : i64]
  [seen-class : TcSpmdClass]) : ResultTcSpmdInlineCallState
  (cond
    [(>= index (ast-param-list-len params))
      (if (>= index (struct-get args len))
        (ResultTcSpmdInlineCallState.Ok
          (TcSpmdInlineCallState
            caller-spmd-env
            helper-env
            helper-spmd-env
            seen-class))
        (ResultTcSpmdInlineCallState.Err "typecheck: arity mismatch"))]
    [(>= index (struct-get args len))
      (ResultTcSpmdInlineCallState.Err "typecheck: arity mismatch")]
    [else
      (let
        [arg : AstExpr (ast-node-get (ast-expr-list-get args index 0))]
        (match (tc-spmd-expr ctx caller-env caller-spmd-env arg)
          [(ResultTcSpmdExprInfo.Ok arg-info)
            (match arg-info
              [(TcSpmdExprInfo _ arg-class next-caller-spmd-env)
                (match (ast-param-list-get params index (ast-param-fallback))
                  [(AstParam.Param param-name param-ty _)
                    (let
                      [bound-ty : AstType (tc-resolve-type helper-ctx param-ty)]
                      (if (and
                        (tc-spmd-varying? arg-class)
                        (not (tc-spmd-varying-value-type-supported? bound-ty)))
                        (ResultTcSpmdInlineCallState.Err
                          (string.append
                            "typecheck: SPMD inline helper varying parameter type is not supported: "
                            (tc-type-render (tc-type-strip-region bound-ty))))
                        (tc-spmd-inline-helper-bind-args-at
                          ctx
                          caller-env
                          next-caller-spmd-env
                          helper-ctx
                          (tc-bind-id helper-env param-name bound-ty)
                          (tc-spmd-env-bind
                            helper-spmd-env
                            (intern-str param-name)
                            bound-ty
                            arg-class
                            TcSpmdScope.Local)
                          params
                          args
                          (+ index 1)
                          (tc-spmd-merge-class seen-class arg-class))))])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdInlineCallState.Err message)]))]))

(define (tc-spmd-inline-helper-body
  [ctx : TcContext]
  [helper-env : TcTypeEnv]
  [helper-spmd-env : TcSpmdEnv]
  [name : String]
  [body : AstExpr]) : ResultTcSpmdExprInfo
  (let
    [previous : TcStringList tc-spmd-inline-helper-stack]
    [result : ResultTcSpmdExprInfo
      (ResultTcSpmdExprInfo.Err (tc-spmd-inline-helper-recursive-message))]
    (begin
      (set! tc-spmd-inline-helper-stack (tc-string-list-add previous name))
      (set! result (tc-spmd-expr ctx helper-env helper-spmd-env body))
      (set! tc-spmd-inline-helper-stack previous)
      result)))

(define (tc-spmd-call-uniform-only
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : AstType]
  [func : AstExpr]
  [args : AstExprList]) : ResultTcSpmdExprInfo
  (match (tc-spmd-expr ctx env spmd-env func)
    [(ResultTcSpmdExprInfo.Ok func-info)
      (match func-info
        [(TcSpmdExprInfo _ _ func-env)
          (match (tc-spmd-expr-list ctx env func-env args)
            [(ResultTcSpmdExprListInfo.Ok args-info)
              (match args-info
                [(TcSpmdExprListInfo args-class args-env)
                  (match (tc-spmd-require-uniform
                    args-class
                    "typecheck: foreach calls with varying arguments are not supported")
                    [(ResultTcUnit.Ok)
                      (tc-spmd-finish expr-ty TcSpmdClass.Uniform args-env)]
                    [(ResultTcUnit.Err message)
                      (ResultTcSpmdExprInfo.Err message)])])]
            [(ResultTcSpmdExprListInfo.Err message)
              (ResultTcSpmdExprInfo.Err message)])])]
    [(ResultTcSpmdExprInfo.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-atomic-public-symbol? [symbol : String]) : bool
  (or
    (string.eq symbol "tl_atomic_i64_load")
    (string.eq symbol "tl_atomic_i64_store")
    (string.eq symbol "tl_atomic_i64_add")
    (string.eq symbol "tl_atomic_i64_fetch_add")
    (string.eq symbol "tl_atomic_i32_load")
    (string.eq symbol "tl_atomic_i32_store")
    (string.eq symbol "tl_atomic_i32_add")
    (string.eq symbol "tl_atomic_i32_fetch_add")))

(define (tc-spmd-atomic-public-name? [name : String]) : bool
  (or
    (string.eq name "atomic-i64-load")
    (string.eq name "atomic-i64-store!")
    (string.eq name "atomic-i64-add!")
    (string.eq name "atomic-i64-fetch-add!")
    (string.eq name "atomic-i32-load")
    (string.eq name "atomic-i32-store!")
    (string.eq name "atomic-i32-add!")
    (string.eq name "atomic-i32-fetch-add!")))

(define (tc-spmd-atomic-name-candidate? [name : String]) : bool
  (or
    (tc-spmd-atomic-public-name? name)
    (tc-spmd-atomic-public-symbol? name)
    (and
      (tc-name-qualified? name)
      (tc-spmd-atomic-public-name? (tc-qualified-name-base name)))))

(define (tc-spmd-atomic-symbol-for-name [name : String]) : String
  (cond
    [(string.eq name "atomic-i64-load") "tl_atomic_i64_load"]
    [(string.eq name "atomic-i64-store!") "tl_atomic_i64_store"]
    [(string.eq name "atomic-i64-add!") "tl_atomic_i64_add"]
    [(string.eq name "atomic-i64-fetch-add!") "tl_atomic_i64_fetch_add"]
    [(string.eq name "atomic-i32-load") "tl_atomic_i32_load"]
    [(string.eq name "atomic-i32-store!") "tl_atomic_i32_store"]
    [(string.eq name "atomic-i32-add!") "tl_atomic_i32_add"]
    [(string.eq name "atomic-i32-fetch-add!") "tl_atomic_i32_fetch_add"]
    [else ""]))

(define (tc-spmd-atomic-import-path? [path : String]) : bool
  (or (string.eq path "stdlib/atomic.tl") (string.eq path "atomic.tl")))

(define (tc-spmd-program-imports-atomic? [decls : AstDeclList]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        (match decl
          [(AstDecl.Import (AstImportSpec.Spec _ path _ _ _))
            (or
              (tc-spmd-atomic-import-path? path)
              (tc-spmd-program-imports-atomic? rest))]
          [_ (tc-spmd-program-imports-atomic? rest)]))]))

(define (tc-spmd-context-imports-atomic? [ctx : TcContext]) : bool
  (match ctx
    [(TcContext program _ _ _ _)
      (match program
        [(AstProgram.Program decls-box)
          (tc-spmd-program-imports-atomic? (box-get decls-box))])]))

(define (tc-spmd-atomic-imported-symbol-for-name
  [ctx : TcContext]
  [name : String]) : TcMaybeString
  (if (and
    (tc-spmd-atomic-public-name? name)
    (tc-spmd-context-imports-atomic? ctx))
    (TcMaybeString.Some (tc-spmd-atomic-symbol-for-name name))
    (TcMaybeString.No)))

(define (tc-spmd-atomic-value-result? [symbol : String]) : bool
  (or
    (string.eq symbol "tl_atomic_i64_load")
    (string.eq symbol "tl_atomic_i64_fetch_add")
    (string.eq symbol "tl_atomic_i32_load")
    (string.eq symbol "tl_atomic_i32_fetch_add")))

(define (tc-spmd-atomic-extern-symbol-from-handle
  [symbols : CompilerSymbols]
  [handle : i64]) : TcMaybeString
  (if (= (compiler-symbol-handle-kind handle) (compiler-symbol-kind-extern))
    (match (compiler-symbols-decl-at-index
      symbols
      (compiler-symbol-handle-index handle))
      [(ResultAstDecl.Ok decl)
        (match decl
          [(AstDecl.Extern _ kind metadata _)
            (match kind
              [(AstExternKind.Function)
                (let
                  [symbol : String (ast-extern-metadata-symbol metadata)]
                  (if (tc-spmd-atomic-public-symbol? symbol)
                    (TcMaybeString.Some symbol)
                    (TcMaybeString.No)))]
              [(AstExternKind.Value) (TcMaybeString.No)])]
          [_ (TcMaybeString.No)])]
      [(ResultAstDecl.Err _) (TcMaybeString.No)])
    (TcMaybeString.No)))

(define (tc-spmd-atomic-extern-symbol-lookup
  [symbols : CompilerSymbols]
  [lookup-name : String]) : TcMaybeString
  (let
    [handle : i64
      (compiler-symbols-lookup-value-or
        symbols
        lookup-name
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (tc-spmd-atomic-extern-symbol-from-handle symbols handle)
      (TcMaybeString.No))))

(define (tc-spmd-atomic-extern-symbol-for-name
  [ctx : TcContext]
  [name : String]) : TcMaybeString
  (if (not (tc-spmd-atomic-name-candidate? name))
    (TcMaybeString.No)
    (let
      [symbols : CompilerSymbols (tc-context-symbols ctx)]
      [direct : TcMaybeString
        (tc-spmd-atomic-extern-symbol-lookup symbols name)]
      [source-name : String (tc-hygiene-global-symbol-name name)]
      [module : String (tc-context-module ctx)]
      [lookup-name : String
        (if (and
          (> (string.string-length module) 0)
          (not (tc-name-qualified? source-name)))
          (compiler-symbol-module-key module source-name)
          source-name)]
      (match direct
        [(TcMaybeString.Some symbol) (TcMaybeString.Some symbol)]
        [(TcMaybeString.No)
          (match (tc-spmd-atomic-extern-symbol-lookup symbols lookup-name)
            [(TcMaybeString.Some symbol) (TcMaybeString.Some symbol)]
            [(TcMaybeString.No)
              (if (string.eq lookup-name source-name)
                (tc-spmd-atomic-imported-symbol-for-name ctx source-name)
                (tc-spmd-atomic-extern-symbol-lookup symbols source-name))])]))))

(define (tc-spmd-atomic-call-symbol
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [func : AstExpr]) : ResultTcString
  (match (tc-spmd-inline-helper-resolve-name ctx env spmd-env func)
    [(ResultTcString.Ok lookup-name)
      (if (string.eq lookup-name "")
        (ResultTcString.Ok "")
        (match (tc-spmd-atomic-extern-symbol-for-name ctx lookup-name)
          [(TcMaybeString.Some symbol) (ResultTcString.Ok symbol)]
          [(TcMaybeString.No) (ResultTcString.Ok "")]))]
    [(ResultTcString.Err message)
      (if (string.eq message "")
        (ResultTcString.Ok "")
        (ResultTcString.Err message))]))

(define (tc-spmd-atomic-call-with-symbol
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : AstType]
  [func : AstExpr]
  [args : AstExprList]
  [symbol : String]) : ResultTcSpmdExprInfo
  (match (tc-spmd-expr ctx env spmd-env func)
    [(ResultTcSpmdExprInfo.Ok func-info)
      (match func-info
        [(TcSpmdExprInfo _ _ func-env)
          (match (tc-spmd-expr-list ctx env func-env args)
            [(ResultTcSpmdExprListInfo.Ok args-info)
              (match args-info
                [(TcSpmdExprListInfo args-class args-env)
                  (tc-spmd-finish
                    expr-ty
                    (if (tc-spmd-atomic-value-result? symbol)
                      args-class
                      TcSpmdClass.Uniform)
                    args-env)])]
            [(ResultTcSpmdExprListInfo.Err message)
              (ResultTcSpmdExprInfo.Err message)])])]
    [(ResultTcSpmdExprInfo.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-atomic-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : AstType]
  [func : AstExpr]
  [args : AstExprList]) : ResultTcSpmdExprInfo
  (match (tc-spmd-atomic-call-symbol ctx env spmd-env func)
    [(ResultTcString.Ok symbol)
      (if (string.eq symbol "")
        (tc-spmd-inline-call ctx env spmd-env expr-ty func args)
        (tc-spmd-atomic-call-with-symbol
          ctx
          env
          spmd-env
          expr-ty
          func
          args
          symbol))]
    [(ResultTcString.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-inline-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : AstType]
  [func : AstExpr]
  [args : AstExprList]) : ResultTcSpmdExprInfo
  (match (tc-spmd-inline-helper-lookup ctx env spmd-env func)
    [(ResultTcSpmdInlineHelper.Ok helper)
      (match helper
        [(TcSpmdInlineHelper.Some name params _ body)
          (let
            [module : String (tc-spmd-inline-helper-module ctx name)]
            [helper-ctx : TcContext (tc-context-with-module ctx module)]
            [base-env : TcTypeEnv (tc-spmd-inline-helper-env ctx env module)]
            [base-spmd-env : TcSpmdEnv
              (tc-spmd-env-mark-outer (tc-spmd-env-from-type-env base-env))]
            (match (tc-spmd-inline-helper-bind-args
              ctx
              env
              spmd-env
              helper-ctx
              base-env
              base-spmd-env
              params
              args
              TcSpmdClass.Uniform)
              [(ResultTcSpmdInlineCallState.Ok call-state)
                (match call-state
                  [(TcSpmdInlineCallState
                      caller-next
                      helper-env
                      helper-spmd-env
                      args-class)
                    (if (tc-spmd-varying? args-class)
                      (match (tc-spmd-inline-helper-body
                        helper-ctx
                        helper-env
                        helper-spmd-env
                        name
                        body)
                        [(ResultTcSpmdExprInfo.Ok body-info)
                          (match body-info
                            [(TcSpmdExprInfo _ body-class _)
                              (tc-spmd-finish expr-ty body-class caller-next)])]
                        [(ResultTcSpmdExprInfo.Err message)
                          (ResultTcSpmdExprInfo.Err message)])
                      (tc-spmd-finish expr-ty TcSpmdClass.Uniform caller-next))])]
              [(ResultTcSpmdInlineCallState.Err message)
                (ResultTcSpmdExprInfo.Err message)]))]
        [(TcSpmdInlineHelper.No)
          (tc-spmd-call-uniform-only ctx env spmd-env expr-ty func args)])]
    [(ResultTcSpmdInlineHelper.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-masked-if-inline-helper-body
  [ctx : TcContext]
  [helper-env : TcTypeEnv]
  [helper-spmd-env : TcSpmdEnv]
  [name : String]
  [body : AstExpr]) : ResultTcUnit
  (let
    [previous : TcStringList tc-spmd-inline-helper-stack]
    [result : ResultTcUnit
      (ResultTcUnit.Err (tc-spmd-inline-helper-recursive-message))]
    (begin
      (set! tc-spmd-inline-helper-stack (tc-string-list-add previous name))
      (set! result (tc-spmd-masked-if-expr ctx helper-env helper-spmd-env body))
      (set! tc-spmd-inline-helper-stack previous)
      result)))

(define (tc-spmd-masked-if-inline-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [func : AstExpr]
  [args : AstExprList]) : ResultTcUnit
  (match (tc-spmd-inline-helper-lookup ctx env spmd-env func)
    [(ResultTcSpmdInlineHelper.Ok helper)
      (match helper
        [(TcSpmdInlineHelper.Some name params _ body)
          (let
            [module : String (tc-spmd-inline-helper-module ctx name)]
            [helper-ctx : TcContext (tc-context-with-module ctx module)]
            [base-env : TcTypeEnv (tc-spmd-inline-helper-env ctx env module)]
            [base-spmd-env : TcSpmdEnv
              (tc-spmd-env-mark-outer (tc-spmd-env-from-type-env base-env))]
            (match (tc-spmd-inline-helper-bind-args
              ctx
              env
              spmd-env
              helper-ctx
              base-env
              base-spmd-env
              params
              args
              TcSpmdClass.Uniform)
              [(ResultTcSpmdInlineCallState.Ok call-state)
                (match call-state
                  [(TcSpmdInlineCallState _ helper-env helper-spmd-env _)
                    (tc-spmd-masked-if-inline-helper-body
                      helper-ctx
                      helper-env
                      helper-spmd-env
                      name
                      body)])]
              [(ResultTcSpmdInlineCallState.Err message)
                (ResultTcUnit.Err message)]))]
        [(TcSpmdInlineHelper.No)
          (tc-spmd-masked-if-unsupported "varying calls inside masked branches")])]
    [(ResultTcSpmdInlineHelper.Err message) (ResultTcUnit.Err message)]))

(define (tc-spmd-masked-if-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [func : AstExpr]
  [args : AstExprList]
  [expr : AstExpr]) : ResultTcUnit
  (match (tc-spmd-atomic-call-symbol ctx env spmd-env func)
    [(ResultTcString.Ok symbol)
      (if (string.eq symbol "")
        (tc-spmd-masked-if-inline-call ctx env spmd-env func args)
        (match (tc-spmd-atomic-call-with-symbol
          ctx
          env
          spmd-env
          (match (tc-expr ctx env expr)
            [(ResultTcType.Ok ty) ty]
            [(ResultTcType.Err _) (AstType.Unit)])
          func
          args
          symbol)
          [(ResultTcSpmdExprInfo.Ok _) ResultTcUnit.Ok]
          [(ResultTcSpmdExprInfo.Err message) (ResultTcUnit.Err message)]))]
    [(ResultTcString.Err message) (ResultTcUnit.Err message)]))

(define (tc-spmd-masked-if-unsupported [detail : String]) : ResultTcUnit
  (ResultTcUnit.Err
    (string.append "typecheck: SPMD masked if does not support " detail)))

(define (tc-spmd-masked-if-result-type-supported? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.Unit) true]
    [_ (tc-spmd-varying-value-type-supported? ty)]))

(define (tc-spmd-masked-if-result-type-ok [ty : AstType]) : ResultTcUnit
  (if (tc-spmd-masked-if-result-type-supported? ty)
    ResultTcUnit.Ok
    (ResultTcUnit.Err
      (string.append
        "typecheck: SPMD masked if result type is not supported: "
        (tc-type-render (tc-type-strip-region ty))))))

(define (tc-spmd-masked-if-index-var? [spmd-env : TcSpmdEnv] [name : String]) : bool
  (match (tc-spmd-env-lookup spmd-env name)
    [(TcSpmdLookup.Found
        _
        (TcSpmdClass.Varying)
        (TcSpmdScope.Local)
        (TcSpmdRole.ForeachIndex))
      true]
    [_ false]))

(define (tc-spmd-foreach-index-unsupported) : ResultTcUnit
  (ResultTcUnit.Err
    "typecheck: foreach does not support non-contiguous array-set! destination indexes; use the foreach index plus a uniform offset"))

(define (tc-spmd-foreach-uniform-offset
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : AstExpr]) : ResultTcUnit
  (match (tc-spmd-expr ctx env spmd-env expr)
    [(ResultTcSpmdExprInfo.Ok info)
      (match info
        [(TcSpmdExprInfo _ class _)
          (if (tc-spmd-varying? class)
            (tc-spmd-foreach-index-unsupported)
            ResultTcUnit.Ok)])]
    [(ResultTcSpmdExprInfo.Err message) (ResultTcUnit.Err message)]))

(define (tc-spmd-foreach-direct-index [spmd-env : TcSpmdEnv] [expr : AstExpr]) : ResultTcUnit
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-foreach-direct-index spmd-env inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-foreach-direct-index spmd-env inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-foreach-direct-index spmd-env inner))]
    [(AstExpr.Var name)
      (if (tc-spmd-masked-if-index-var? spmd-env (intern-str name))
        ResultTcUnit.Ok
        (tc-spmd-foreach-index-unsupported))]
    [_ (tc-spmd-foreach-index-unsupported)]))

(define (tc-spmd-foreach-index
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : AstExpr]) : ResultTcUnit
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-foreach-index ctx env spmd-env inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-foreach-index ctx env spmd-env inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-foreach-index ctx env spmd-env inner))]
    [(AstExpr.Binary op left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (match op
          [(AstBinOp.Add)
            (match (tc-spmd-foreach-direct-index spmd-env left)
              [(ResultTcUnit.Ok)
                (tc-spmd-foreach-uniform-offset ctx env spmd-env right)]
              [(ResultTcUnit.Err _)
                (match (tc-spmd-foreach-direct-index spmd-env right)
                  [(ResultTcUnit.Ok)
                    (tc-spmd-foreach-uniform-offset ctx env spmd-env left)]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
          [(AstBinOp.Sub)
            (match (tc-spmd-foreach-direct-index spmd-env left)
              [(ResultTcUnit.Ok)
                (tc-spmd-foreach-uniform-offset ctx env spmd-env right)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [_ (tc-spmd-foreach-index-unsupported)]))]
    [_ (tc-spmd-foreach-direct-index spmd-env expr)]))

(define (tc-spmd-masked-if-uniform-offset
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : AstExpr]) : ResultTcUnit
  (match (tc-spmd-expr ctx env spmd-env expr)
    [(ResultTcSpmdExprInfo.Ok info)
      (match info
        [(TcSpmdExprInfo _ class _)
          (if (tc-spmd-varying? class)
            (tc-spmd-masked-if-unsupported
              "gather/scatter-like array indexes; use the foreach index plus a uniform offset")
            ResultTcUnit.Ok)])]
    [(ResultTcSpmdExprInfo.Err message) (ResultTcUnit.Err message)]))

(define (tc-spmd-masked-if-direct-index [spmd-env : TcSpmdEnv] [expr : AstExpr]) : ResultTcUnit
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-masked-if-direct-index spmd-env inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-masked-if-direct-index spmd-env inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-masked-if-direct-index spmd-env inner))]
    [(AstExpr.Var name)
      (if (tc-spmd-masked-if-index-var? spmd-env (intern-str name))
        ResultTcUnit.Ok
        (tc-spmd-masked-if-unsupported
          "gather/scatter-like array indexes; use the foreach index plus a uniform offset"))]
    [_
      (tc-spmd-masked-if-unsupported
        "gather/scatter-like array indexes; use the foreach index plus a uniform offset")]))

(define (tc-spmd-masked-if-index
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : AstExpr]) : ResultTcUnit
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-masked-if-index ctx env spmd-env inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-masked-if-index ctx env spmd-env inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-masked-if-index ctx env spmd-env inner))]
    [(AstExpr.Binary op left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (match op
          [(AstBinOp.Add)
            (match (tc-spmd-masked-if-direct-index spmd-env left)
              [(ResultTcUnit.Ok)
                (tc-spmd-masked-if-uniform-offset ctx env spmd-env right)]
              [(ResultTcUnit.Err _)
                (match (tc-spmd-masked-if-direct-index spmd-env right)
                  [(ResultTcUnit.Ok)
                    (tc-spmd-masked-if-uniform-offset ctx env spmd-env left)]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
          [(AstBinOp.Sub)
            (match (tc-spmd-masked-if-direct-index spmd-env left)
              [(ResultTcUnit.Ok)
                (tc-spmd-masked-if-uniform-offset ctx env spmd-env right)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [_
            (tc-spmd-masked-if-unsupported
              "gather/scatter-like array indexes; use the foreach index plus a uniform offset")]))]
    [_ (tc-spmd-masked-if-direct-index spmd-env expr)]))

(define (tc-spmd-masked-if-lane-type-ok [ty : AstType]) : ResultTcUnit
  (if (tc-spmd-lane-type-supported? ty)
    ResultTcUnit.Ok
    (ResultTcUnit.Err
      (string.append
        "typecheck: SPMD masked if lane type is not supported: "
        (tc-type-render (tc-type-strip-region ty))))))

(define (tc-spmd-masked-if-expr-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [exprs : AstExprList]) : ResultTcUnit
  (tc-spmd-masked-if-expr-list-at ctx env spmd-env (& exprs) 0))

(define (tc-spmd-masked-if-expr-list-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get exprs len))
    ResultTcUnit.Ok
    (match (tc-spmd-masked-if-expr
      ctx
      env
      spmd-env
      (ast-node-get (ast-expr-list-get exprs index 0)))
      [(ResultTcUnit.Ok)
        (tc-spmd-masked-if-expr-list-at ctx env spmd-env exprs (+ index 1))]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

(define (tc-spmd-masked-if-let-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [bindings : AstLetBindingList]
  [mark : TcSpmdEnvMark]) : ResultTcSpmdLetState
  (tc-spmd-masked-if-let-bindings-at ctx env spmd-env (& bindings) mark 0))

(define (tc-spmd-masked-if-let-bindings-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [bindings : (& bindings AstLetBindingList)]
  [mark : TcSpmdEnvMark]
  [index : i64]) : ResultTcSpmdLetState
  (if (>= index (ast-let-binding-list-len bindings))
    (ResultTcSpmdLetState.Ok (TcSpmdLetState env spmd-env mark))
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (match (tc-spmd-masked-if-expr ctx env spmd-env init)
            [(ResultTcUnit.Ok)
              (match (tc-spmd-expr ctx env spmd-env init)
                [(ResultTcSpmdExprInfo.Ok info)
                  (match info
                    [(TcSpmdExprInfo init-ty init-class next-spmd-env)
                      (let
                        [bound-ty : AstType
                          (match maybe-ty
                            [(AstMaybeType.Some want)
                              (if (tc-type-contains-any-region init-ty)
                                init-ty
                                (tc-resolve-type ctx want))]
                            [(AstMaybeType.No) init-ty])]
                        (tc-spmd-masked-if-let-bindings-at
                          ctx
                          (tc-bind-id env name bound-ty)
                          (tc-spmd-env-bind
                            next-spmd-env
                            (intern-str name)
                            bound-ty
                            init-class
                            TcSpmdScope.Local)
                          bindings
                          mark
                          (+ index 1)))])]
                [(ResultTcSpmdExprInfo.Err message)
                  (ResultTcSpmdLetState.Err message)])]
            [(ResultTcUnit.Err message) (ResultTcSpmdLetState.Err message)]))])))

(define (tc-spmd-masked-if-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : AstExpr]) : ResultTcUnit
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-masked-if-expr ctx env spmd-env inner))]
    [(AstExpr.Literal _) ResultTcUnit.Ok]
    [(AstExpr.Var _) ResultTcUnit.Ok]
    [(AstExpr.TypeLiteral _) ResultTcUnit.Ok]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-masked-if-expr ctx env spmd-env inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-masked-if-expr ctx env spmd-env inner))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-masked-if-expr ctx env spmd-env inner))]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (match (tc-spmd-masked-if-expr ctx env spmd-env left)
          [(ResultTcUnit.Ok) (tc-spmd-masked-if-expr ctx env spmd-env right)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-spmd-masked-if-let-bindings
              ctx
              env
              spmd-env
              bindings
              (tc-spmd-env-mark spmd-env))
              [(ResultTcSpmdLetState.Ok state)
                (match state
                  [(TcSpmdLetState body-env body-spmd-env _)
                    (tc-spmd-masked-if-expr ctx body-env body-spmd-env body)])]
              [(ResultTcSpmdLetState.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.If cond-box then-box else-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-box)]
        [else-branch : AstExpr (ast-node-get else-box)]
        (match (tc-spmd-masked-if-expr ctx env spmd-env cond)
          [(ResultTcUnit.Ok)
            (match (tc-spmd-masked-if-expr ctx env spmd-env then-branch)
              [(ResultTcUnit.Ok)
                (tc-spmd-masked-if-expr ctx env spmd-env else-branch)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.Begin exprs) (tc-spmd-masked-if-expr-list ctx env spmd-env exprs)]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-spmd-masked-if-expr ctx env spmd-env array)
          [(ResultTcUnit.Ok)
            (match (tc-spmd-masked-if-index ctx env spmd-env index)
              [(ResultTcUnit.Ok)
                (match (tc-expr ctx env expr)
                  [(ResultTcType.Ok ty) (tc-spmd-masked-if-lane-type-ok ty)]
                  [(ResultTcType.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-spmd-masked-if-expr ctx env spmd-env array)
          [(ResultTcUnit.Ok)
            (match (tc-spmd-masked-if-index ctx env spmd-env index)
              [(ResultTcUnit.Ok)
                (match (tc-spmd-masked-if-expr ctx env spmd-env value)
                  [(ResultTcUnit.Ok)
                    (match (tc-expr ctx env value)
                      [(ResultTcType.Ok ty) (tc-spmd-masked-if-lane-type-ok ty)]
                      [(ResultTcType.Err message) (ResultTcUnit.Err message)])]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-spmd-masked-if-expr ctx env spmd-env receiver)
          [(ResultTcUnit.Ok)
            (match (tc-spmd-masked-if-expr ctx env spmd-env value)
              [(ResultTcUnit.Ok)
                (match (tc-expr ctx env value)
                  [(ResultTcType.Ok ty) (tc-spmd-masked-if-lane-type-ok ty)]
                  [(ResultTcType.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (tc-spmd-masked-if-call ctx env spmd-env func args expr))]
    [(AstExpr.Syscall _)
      (tc-spmd-masked-if-unsupported "varying calls inside masked branches")]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (match (tc-spmd-masked-if-expr ctx env spmd-env cond)
          [(ResultTcUnit.Ok)
            (match (tc-spmd-expr ctx env spmd-env cond)
              [(ResultTcSpmdExprInfo.Ok cond-info)
                (match cond-info
                  [(TcSpmdExprInfo _ cond-class cond-env)
                    (if (tc-spmd-varying? cond-class)
                      (tc-spmd-masked-if-expr ctx env cond-env body)
                      (tc-spmd-masked-if-unsupported
                        "uniform while inside masked branches"))])]
              [(ResultTcSpmdExprInfo.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (tc-spmd-masked-if-match
            ctx
            env
            spmd-env
            (ast-node-get scrutinee-box)
            arms)])]
    [(AstExpr.Foreach _)
      (tc-spmd-masked-if-unsupported "nested foreach inside masked branches")]
    [(AstExpr.SpmdReduce _)
      (tc-spmd-masked-if-unsupported
        "nested spmd-reduce inside masked branches")]
    [(AstExpr.SpmdScan _)
      (tc-spmd-masked-if-unsupported "nested spmd-scan inside masked branches")]
    [(AstExpr.SpmdBroadcast _ _)
      (tc-spmd-masked-if-unsupported "spmd-broadcast inside masked branches")]
    [(AstExpr.SpmdShuffle _ _)
      (tc-spmd-masked-if-unsupported "spmd-shuffle inside masked branches")]
    [(AstExpr.SpmdProgramIndex) ResultTcUnit.Ok]
    [(AstExpr.SpmdProgramCount) ResultTcUnit.Ok]
    [(AstExpr.Set _ _)
      (tc-spmd-masked-if-unsupported
        "side effects other than contiguous array writes inside masked branches")]
    [(AstExpr.ArrayPush _ _)
      (tc-spmd-masked-if-unsupported
        "side effects other than contiguous array writes inside masked branches")]
    [(AstExpr.BoxSet _ _)
      (tc-spmd-masked-if-unsupported
        "side effects other than contiguous array writes inside masked branches")]
    [(AstExpr.PtrWrite _ _)
      (tc-spmd-masked-if-unsupported
        "side effects other than contiguous array writes inside masked branches")]
    [(AstExpr.MakeArray _ _)
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [(AstExpr.Array _)
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [(AstExpr.Box _)
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [(AstExpr.BoxTake _)
      (tc-spmd-masked-if-unsupported "box-take inside masked branches")]
    [(AstExpr.WithRegion _ _)
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [(AstExpr.WithEscape _ _)
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [(AstExpr.WithScratch _)
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [(AstExpr.InArena _ _)
      (tc-spmd-masked-if-unsupported
        "allocations that can escape masked branches")]
    [_
      (tc-spmd-masked-if-unsupported
        "this branch shape in the masked-control-flow subset")]))

(define (tc-spmd-masked-if
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr-ty : AstType]
  [then-branch : AstExpr]
  [else-branch : AstExpr]) : ResultTcSpmdExprInfo
  (match (tc-spmd-masked-if-result-type-ok expr-ty)
    [(ResultTcUnit.Ok)
      (match (tc-spmd-masked-if-expr ctx env spmd-env then-branch)
        [(ResultTcUnit.Ok)
          (match (tc-spmd-masked-if-expr ctx env spmd-env else-branch)
            [(ResultTcUnit.Ok)
              (match (tc-type-strip-region expr-ty)
                [(AstType.Unit)
                  (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
                [_ (tc-spmd-finish expr-ty TcSpmdClass.Varying spmd-env)])]
            [(ResultTcUnit.Err message) (ResultTcSpmdExprInfo.Err message)])]
        [(ResultTcUnit.Err message) (ResultTcSpmdExprInfo.Err message)])]
    [(ResultTcUnit.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-let-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [bindings : AstLetBindingList]
  [mark : TcSpmdEnvMark]) : ResultTcSpmdLetState
  (tc-spmd-let-bindings-at ctx env spmd-env (& bindings) mark 0))

(define (tc-spmd-let-bindings-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [bindings : (& bindings AstLetBindingList)]
  [mark : TcSpmdEnvMark]
  [index : i64]) : ResultTcSpmdLetState
  (if (>= index (ast-let-binding-list-len bindings))
    (ResultTcSpmdLetState.Ok (TcSpmdLetState env spmd-env mark))
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (match (tc-spmd-expr ctx env spmd-env init)
            [(ResultTcSpmdExprInfo.Ok info)
              (match info
                [(TcSpmdExprInfo init-ty init-class next-spmd-env)
                  (let
                    [bound-ty : AstType
                      (match maybe-ty
                        [(AstMaybeType.Some want)
                          (if (tc-type-contains-any-region init-ty)
                            init-ty
                            (tc-resolve-type ctx want))]
                        [(AstMaybeType.No) init-ty])]
                    (tc-spmd-let-bindings-at
                      ctx
                      (tc-bind-id env name bound-ty)
                      (tc-spmd-env-bind
                        next-spmd-env
                        (intern-str name)
                        bound-ty
                        init-class
                        TcSpmdScope.Local)
                      bindings
                      mark
                      (+ index 1)))])]
            [(ResultTcSpmdExprInfo.Err message)
              (ResultTcSpmdLetState.Err message)]))])))

(define (tc-spmd-expr-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [exprs : AstExprList]) : ResultTcSpmdExprListInfo
  (tc-spmd-expr-list-at ctx env spmd-env (& exprs) 0))

(define (tc-spmd-expr-list-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : ResultTcSpmdExprListInfo
  (if (>= index (struct-get exprs len))
    (ResultTcSpmdExprListInfo.Ok
      (TcSpmdExprListInfo TcSpmdClass.Uniform spmd-env))
    (let
      [expr : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
      (match (tc-spmd-expr ctx env spmd-env expr)
        [(ResultTcSpmdExprInfo.Ok info)
          (match info
            [(TcSpmdExprInfo _ class next-spmd-env)
              (match (tc-spmd-expr-list-at
                ctx
                env
                next-spmd-env
                exprs
                (+ index 1))
                [(ResultTcSpmdExprListInfo.Ok rest-info)
                  (match rest-info
                    [(TcSpmdExprListInfo rest-class rest-env)
                      (ResultTcSpmdExprListInfo.Ok
                        (TcSpmdExprListInfo
                          (tc-spmd-merge-class class rest-class)
                          rest-env))])]
                [(ResultTcSpmdExprListInfo.Err message)
                  (ResultTcSpmdExprListInfo.Err message)])])]
        [(ResultTcSpmdExprInfo.Err message)
          (ResultTcSpmdExprListInfo.Err message)]))))

(define (tc-spmd-begin-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [exprs : AstExprList]) : ResultTcSpmdExprInfo
  (tc-spmd-begin-list-at ctx env spmd-env (& exprs) 0))

(define (tc-spmd-begin-list-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : ResultTcSpmdExprInfo
  (if (>= index (struct-get exprs len))
    (ResultTcSpmdExprInfo.Ok
      (TcSpmdExprInfo (AstType.Unit) TcSpmdClass.Uniform spmd-env))
    (let
      [expr : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
      (if (= (+ index 1) (struct-get exprs len))
        (tc-spmd-expr ctx env spmd-env expr)
        (match (tc-spmd-expr ctx env spmd-env expr)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ _ next-spmd-env)
                (tc-spmd-begin-list-at ctx env next-spmd-env exprs (+ index 1))])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)])))))

(define (tc-spmd-match-pattern-binding-supported?
  [class : TcSpmdClass]
  [ty : AstType]) : bool
  (if (tc-spmd-varying? class)
    (tc-spmd-lane-type-supported? ty)
    true))

(define (tc-spmd-match-pattern-binding-diagnostic [ty : AstType]) : String
  (string.append
    "typecheck: foreach varying match pattern binding type is not supported: "
    (tc-type-render (tc-type-strip-region ty))))

(define (tc-spmd-pattern-bound-names
  [ctx : TcContext]
  [scrut-ty : AstType]
  [pattern : AstPattern]) : TcStringList
  (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
    [(AstType.Enum _)
      (match pattern
        [(AstPattern.Variant _ args-box)
          (tc-pattern-list-add-bound-names (box-get args-box) TcStringList.Nil)]
        [_ TcStringList.Nil])]
    [(AstType.EnumArgs _ _)
      (match pattern
        [(AstPattern.Variant _ args-box)
          (tc-pattern-list-add-bound-names (box-get args-box) TcStringList.Nil)]
        [_ TcStringList.Nil])]
    [_ (tc-pattern-add-bound-names pattern TcStringList.Nil)]))

(define (tc-spmd-match-bind-pattern-names
  [arm-env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [names : TcStringList]
  [class : TcSpmdClass]) : ResultTcSpmdEnv
  (match names
    [(TcStringList.Nil) (ResultTcSpmdEnv.Ok spmd-env)]
    [(TcStringList.Cons name rest)
      (match (tc-lookup arm-env name)
        [(ResultTcType.Ok ty)
          (if (tc-spmd-match-pattern-binding-supported? class ty)
            (tc-spmd-match-bind-pattern-names
              arm-env
              (tc-spmd-env-bind spmd-env name ty class TcSpmdScope.Local)
              (box-get rest)
              class)
            (ResultTcSpmdEnv.Err (tc-spmd-match-pattern-binding-diagnostic ty)))]
        [(ResultTcType.Err message) (ResultTcSpmdEnv.Err message)])]))

(define (tc-spmd-masked-if-match-arms
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [scrut-ty : AstType]
  [scrut-class : TcSpmdClass]
  [arms : AstMatchArmList]) : ResultTcUnit
  (tc-spmd-masked-if-match-arms-at
    ctx
    env
    spmd-env
    scrut-ty
    scrut-class
    (& arms)
    0))

(define (tc-spmd-masked-if-match-arms-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [scrut-ty : AstType]
  [scrut-class : TcSpmdClass]
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get arms len))
    ResultTcUnit.Ok
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (let
          [body : AstExpr (ast-node-get body-box)]
          (match (tc-bind-match-pattern ctx env scrut-ty pattern)
            [(ResultTcEnv.Ok arm-env)
              (match (tc-spmd-match-bind-pattern-names
                arm-env
                spmd-env
                (tc-spmd-pattern-bound-names ctx scrut-ty pattern)
                scrut-class)
                [(ResultTcSpmdEnv.Ok arm-spmd-env)
                  (match (tc-spmd-masked-if-expr ctx arm-env arm-spmd-env body)
                    [(ResultTcUnit.Ok)
                      (tc-spmd-masked-if-match-arms-at
                        ctx
                        env
                        spmd-env
                        scrut-ty
                        scrut-class
                        arms
                        (+ index 1))]
                    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
                [(ResultTcSpmdEnv.Err message) (ResultTcUnit.Err message)])]
            [(ResultTcEnv.Err message) (ResultTcUnit.Err message)]))])))

(define (tc-spmd-masked-if-match
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [scrutinee : AstExpr]
  [arms : AstMatchArmList]) : ResultTcUnit
  (match (tc-spmd-masked-if-expr ctx env spmd-env scrutinee)
    [(ResultTcUnit.Ok)
      (match (tc-spmd-expr ctx env spmd-env scrutinee)
        [(ResultTcSpmdExprInfo.Ok scrut-info)
          (match scrut-info
            [(TcSpmdExprInfo scrut-ty scrut-class scrut-env)
              (tc-spmd-masked-if-match-arms
                ctx
                env
                scrut-env
                scrut-ty
                scrut-class
                arms)])]
        [(ResultTcSpmdExprInfo.Err message) (ResultTcUnit.Err message)])]
    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))

(define (tc-spmd-match-arms
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [scrut-ty : AstType]
  [scrut-class : TcSpmdClass]
  [arms : AstMatchArmList]
  [class : TcSpmdClass]) : ResultTcSpmdExprListInfo
  (tc-spmd-match-arms-at ctx env spmd-env scrut-ty scrut-class (& arms) class 0))

(define (tc-spmd-match-arms-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [scrut-ty : AstType]
  [scrut-class : TcSpmdClass]
  [arms : (& arms AstMatchArmList)]
  [class : TcSpmdClass]
  [index : i64]) : ResultTcSpmdExprListInfo
  (if (>= index (struct-get arms len))
    (ResultTcSpmdExprListInfo.Ok (TcSpmdExprListInfo class spmd-env))
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (let
          [body : AstExpr (ast-node-get body-box)]
          [mark : TcSpmdEnvMark (tc-spmd-env-mark spmd-env)]
          (match (tc-bind-match-pattern ctx env scrut-ty pattern)
            [(ResultTcEnv.Ok arm-env)
              (match (tc-spmd-match-bind-pattern-names
                arm-env
                spmd-env
                (tc-spmd-pattern-bound-names ctx scrut-ty pattern)
                scrut-class)
                [(ResultTcSpmdEnv.Ok arm-spmd-env)
                  (match (tc-spmd-expr ctx arm-env arm-spmd-env body)
                    [(ResultTcSpmdExprInfo.Ok body-info)
                      (match body-info
                        [(TcSpmdExprInfo _ body-class body-env)
                          (match (tc-spmd-match-arms-at
                            ctx
                            env
                            spmd-env
                            scrut-ty
                            scrut-class
                            arms
                            (tc-spmd-merge-class class body-class)
                            (+ index 1))
                            [(ResultTcSpmdExprListInfo.Ok rest-info)
                              (match rest-info
                                [(TcSpmdExprListInfo rest-class rest-env)
                                  (ResultTcSpmdExprListInfo.Ok
                                    (TcSpmdExprListInfo
                                      rest-class
                                      (tc-spmd-env-merge-classes
                                        (tc-spmd-env-restore body-env mark)
                                        rest-env)))])]
                            [(ResultTcSpmdExprListInfo.Err message)
                              (ResultTcSpmdExprListInfo.Err message)])])]
                    [(ResultTcSpmdExprInfo.Err message)
                      (ResultTcSpmdExprListInfo.Err message)])]
                [(ResultTcSpmdEnv.Err message)
                  (ResultTcSpmdExprListInfo.Err message)])]
            [(ResultTcEnv.Err message) (ResultTcSpmdExprListInfo.Err message)]))])))

(define (tc-spmd-check-foreach-body-with-env
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [index : String]
  [index-ty : AstType]
  [body : AstExpr]) : ResultTcUnit
  (let
    [body-env : TcTypeEnv (tc-bind env index index-ty)]
    [body-spmd-env : TcSpmdEnv
      (tc-spmd-env-bind-role
        (tc-spmd-env-mark-outer spmd-env)
        index
        index-ty
        TcSpmdClass.Varying
        TcSpmdScope.Local
        TcSpmdRole.ForeachIndex)]
    [result : ResultTcUnit ResultTcUnit.Ok]
    (begin
      (tc-spmd-inline-helper-stack-reset!)
      (set!
        result
        (match (tc-spmd-expr ctx body-env body-spmd-env body)
          [(ResultTcSpmdExprInfo.Ok _) ResultTcUnit.Ok]
          [(ResultTcSpmdExprInfo.Err message) (ResultTcUnit.Err message)]))
      (tc-spmd-inline-helper-stack-reset!)
      result)))

(define (tc-spmd-check-foreach-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [index : String]
  [index-ty : AstType]
  [body : AstExpr]) : ResultTcUnit
  (tc-spmd-check-foreach-body-with-env
    ctx
    env
    (tc-spmd-env-from-type-env env)
    index
    index-ty
    body))

(define (tc-spmd-scan-body-no-nested-list [exprs : AstExprList]) : ResultTcUnit
  (tc-spmd-scan-body-no-nested-list-at (& exprs) 0))

(define (tc-spmd-scan-body-no-nested-list-at
  [exprs : (& exprs AstExprList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get exprs len))
    ResultTcUnit.Ok
    (match (tc-spmd-scan-body-no-nested-spmd
      (ast-node-get (ast-expr-list-get exprs index 0)))
      [(ResultTcUnit.Ok)
        (tc-spmd-scan-body-no-nested-list-at exprs (+ index 1))]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

(define (tc-spmd-scan-body-no-nested-pair [left : AstExpr] [right : AstExpr]) : ResultTcUnit
  (match (tc-spmd-scan-body-no-nested-spmd left)
    [(ResultTcUnit.Ok) (tc-spmd-scan-body-no-nested-spmd right)]
    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))

(define (tc-spmd-scan-body-no-nested-triple
  [first : AstExpr]
  [second : AstExpr]
  [third : AstExpr]) : ResultTcUnit
  (match (tc-spmd-scan-body-no-nested-pair first second)
    [(ResultTcUnit.Ok) (tc-spmd-scan-body-no-nested-spmd third)]
    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))

(define (tc-spmd-scan-body-no-nested-let-bindings
  [bindings : AstLetBindingList]) : ResultTcUnit
  (tc-spmd-scan-body-no-nested-let-bindings-at (& bindings) 0))

(define (tc-spmd-scan-body-no-nested-let-bindings-at
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-let-binding-list-len bindings))
    ResultTcUnit.Ok
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding _ _ init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (match (tc-spmd-scan-body-no-nested-spmd init)
            [(ResultTcUnit.Ok)
              (tc-spmd-scan-body-no-nested-let-bindings-at bindings (+ index 1))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])))

(define (tc-spmd-scan-body-no-nested-resource-bindings
  [bindings : AstResourceBindingList]) : ResultTcUnit
  (tc-spmd-scan-body-no-nested-resource-bindings-at (& bindings) 0))

(define (tc-spmd-scan-body-no-nested-resource-bindings-at
  [bindings : (& bindings AstResourceBindingList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-resource-binding-list-len bindings))
    ResultTcUnit.Ok
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding _ init-box cleanup-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          [cleanup : AstExpr (ast-node-get cleanup-box)]
          (match (tc-spmd-scan-body-no-nested-pair init cleanup)
            [(ResultTcUnit.Ok)
              (tc-spmd-scan-body-no-nested-resource-bindings-at
                bindings
                (+ index 1))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])))

(define (tc-spmd-scan-body-no-nested-arms [arms : AstMatchArmList]) : ResultTcUnit
  (tc-spmd-scan-body-no-nested-arms-at (& arms) 0))

(define (tc-spmd-scan-body-no-nested-arms-at
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get arms len))
    ResultTcUnit.Ok
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm _ body-box)
        (let
          [body : AstExpr (ast-node-get body-box)]
          (match (tc-spmd-scan-body-no-nested-spmd body)
            [(ResultTcUnit.Ok)
              (tc-spmd-scan-body-no-nested-arms-at arms (+ index 1))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])))

(define (tc-spmd-scan-body-no-nested-spmd [expr : AstExpr]) : ResultTcUnit
  (match expr
    [(AstExpr.Spanned inner-box _)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExpr.Binary _ left-box right-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get left-box)
        (ast-node-get right-box))]
    [(AstExpr.Unary _ inner-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExpr.Call func-box args)
      (match (tc-spmd-scan-body-no-nested-spmd (ast-node-get func-box))
        [(ResultTcUnit.Ok) (tc-spmd-scan-body-no-nested-list args)]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [(AstExpr.If cond-box then-box else-box)
      (tc-spmd-scan-body-no-nested-triple
        (ast-node-get cond-box)
        (ast-node-get then-box)
        (ast-node-get else-box))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (match (tc-spmd-scan-body-no-nested-let-bindings bindings)
            [(ResultTcUnit.Ok)
              (tc-spmd-scan-body-no-nested-spmd (ast-node-get body-box))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda _ _ body-box)
          (tc-spmd-scan-body-no-nested-spmd (ast-node-get body-box))])]
    [(AstExpr.Tuple exprs) (tc-spmd-scan-body-no-nested-list exprs)]
    [(AstExpr.TupleRef tuple-box index-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get tuple-box)
        (ast-node-get index-box))]
    [(AstExpr.Array exprs) (tc-spmd-scan-body-no-nested-list exprs)]
    [(AstExpr.MakeArray _ len-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get len-box))]
    [(AstExpr.ArrayRef array-box index-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get array-box)
        (ast-node-get index-box))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (tc-spmd-scan-body-no-nested-triple
        (ast-node-get array-box)
        (ast-node-get index-box)
        (ast-node-get value-box))]
    [(AstExpr.ArrayPush array-box value-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get array-box)
        (ast-node-get value-box))]
    [(AstExpr.StringRef str-box index-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get str-box)
        (ast-node-get index-box))]
    [(AstExpr.While cond-box body-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get cond-box)
        (ast-node-get body-box))]
    [(AstExpr.Begin exprs) (tc-spmd-scan-body-no-nested-list exprs)]
    [(AstExpr.Unsafe exprs) (tc-spmd-scan-body-no-nested-list exprs)]
    [(AstExpr.Set _ value-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get value-box))]
    [(AstExpr.Ann inner-box _)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExpr.Cast inner-box _)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExpr.Borrow _ _ place-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get place-box))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (match (tc-spmd-scan-body-no-nested-spmd (ast-node-get scrutinee-box))
            [(ResultTcUnit.Ok) (tc-spmd-scan-body-no-nested-arms arms)]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
    [(AstExpr.Foreach _)
      (ResultTcUnit.Err
        "typecheck: nested foreach inside spmd-scan is not supported")]
    [(AstExpr.SpmdReduce _)
      (ResultTcUnit.Err
        "typecheck: nested spmd-reduce inside spmd-scan is not supported")]
    [(AstExpr.SpmdScan _)
      (ResultTcUnit.Err
        "typecheck: nested spmd-scan inside spmd-scan is not supported")]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get value-box)
        (ast-node-get lane-box))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get value-box)
        (ast-node-get lane-box))]
    [(AstExpr.SpmdProgramIndex)
      (ResultTcUnit.Err
        "typecheck: program-index is not supported inside spmd-scan body")]
    [(AstExpr.SpmdProgramCount)
      (ResultTcUnit.Err
        "typecheck: program-count is not supported inside spmd-scan body")]
    [(AstExpr.StructGet receiver-box _)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get receiver-box))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get receiver-box)
        (ast-node-get value-box))]
    [(AstExpr.WithRegion _ body) (tc-spmd-scan-body-no-nested-list body)]
    [(AstExpr.WithEscape scratch-box body)
      (match (tc-spmd-scan-body-no-nested-spmd (ast-node-get scratch-box))
        [(ResultTcUnit.Ok) (tc-spmd-scan-body-no-nested-list body)]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [(AstExpr.WithScratch body) (tc-spmd-scan-body-no-nested-list body)]
    [(AstExpr.InArena arena-box body)
      (match (tc-spmd-scan-body-no-nested-spmd (ast-node-get arena-box))
        [(ResultTcUnit.Ok) (tc-spmd-scan-body-no-nested-list body)]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (match (tc-spmd-scan-body-no-nested-resource-bindings bindings)
            [(ResultTcUnit.Ok) (tc-spmd-scan-body-no-nested-list body)]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
    [(AstExpr.Box inner-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExpr.BoxGet inner-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExpr.BoxTake inner-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExpr.BoxSet inner-box value-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get inner-box)
        (ast-node-get value-box))]
    [(AstExpr.Comptime inner-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExpr.Quote _) ResultTcUnit.Ok]
    [(AstExpr.Quasiquote _) ResultTcUnit.Ok]
    [(AstExpr.Unquote inner-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExpr.UnquoteSplicing inner-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExpr.BracketClause items) (tc-spmd-scan-body-no-nested-list items)]
    [(AstExpr.Try inner-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExpr.Return inner-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExpr.PtrNullCheck inner-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get inner-box))]
    [(AstExpr.PtrRead ptr-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get ptr-box))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get ptr-box)
        (ast-node-get value-box))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get ptr-box)
        (ast-node-get offset-box))]
    [(AstExpr.PtrCast ptr-box _)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get ptr-box))]
    [(AstExpr.PtrToInt ptr-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get ptr-box))]
    [(AstExpr.IntToPtr value-box _)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get value-box))]
    [(AstExpr.StringData str-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get str-box))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get ptr-box)
        (ast-node-get len-box))]
    [(AstExpr.ArrayData array-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get array-box))]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get leaf-box)
        (ast-node-get subleaf-box))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get leaf-box)
        (ast-node-get subleaf-box))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get leaf-box)
        (ast-node-get subleaf-box))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (tc-spmd-scan-body-no-nested-pair
        (ast-node-get leaf-box)
        (ast-node-get subleaf-box))]
    [(AstExpr.Xgetbv index-box)
      (tc-spmd-scan-body-no-nested-spmd (ast-node-get index-box))]
    [(AstExpr.Syscall args) (tc-spmd-scan-body-no-nested-list args)]
    [_ ResultTcUnit.Ok]))

(define (tc-spmd-check-scan-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [index : String]
  [index-ty : AstType]
  [prefix : String]
  [prefix-ty : AstType]
  [body : AstExpr]) : ResultTcUnit
  (let
    [index-env : TcTypeEnv (tc-bind env index index-ty)]
    [body-env : TcTypeEnv (tc-bind index-env prefix prefix-ty)]
    [base-spmd-env : TcSpmdEnv
      (tc-spmd-env-mark-outer (tc-spmd-env-from-type-env env))]
    [index-spmd-env : TcSpmdEnv
      (tc-spmd-env-bind-role
        base-spmd-env
        index
        index-ty
        TcSpmdClass.Varying
        TcSpmdScope.Local
        TcSpmdRole.ForeachIndex)]
    [body-spmd-env : TcSpmdEnv
      (tc-spmd-env-bind
        index-spmd-env
        prefix
        prefix-ty
        TcSpmdClass.Varying
        TcSpmdScope.Local)]
    [result : ResultTcUnit ResultTcUnit.Ok]
    (match (tc-spmd-scan-body-no-nested-spmd body)
      [(ResultTcUnit.Ok)
        (begin
          (tc-spmd-inline-helper-stack-reset!)
          (set!
            result
            (match (tc-spmd-expr ctx body-env body-spmd-env body)
              [(ResultTcSpmdExprInfo.Ok _) ResultTcUnit.Ok]
              [(ResultTcSpmdExprInfo.Err message) (ResultTcUnit.Err message)]))
          (tc-spmd-inline-helper-stack-reset!)
          result)]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

;; `spmd-reduce` allows varying bool values for `all`/`any`, so it cannot reuse
;; the full foreach body checker: that checker applies foreach array-lane
;; restrictions to the entire expression. This path only classifies the reduce
;; value enough to enforce nested cross-lane value/lane rules.
(define (tc-spmd-reduce-class-finish
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : AstExpr]
  [class : TcSpmdClass]) : ResultTcSpmdExprInfo
  (match (tc-expr ctx env expr)
    [(ResultTcType.Ok ty) (tc-spmd-finish ty class spmd-env)]
    [(ResultTcType.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-reduce-class-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : AstExpr]
  [expected : AstType]) : ResultTcSpmdExprInfo
  (match (tc-spmd-reduce-class ctx env spmd-env expr)
    [(ResultTcSpmdExprInfo.Ok info)
      (match info
        [(TcSpmdExprInfo _ class next-spmd-env)
          (match (tc-expr-with-expected-or-actual ctx env expr expected)
            [(ResultTcType.Ok ty) (tc-spmd-finish ty class next-spmd-env)]
            [(ResultTcType.Err message) (ResultTcSpmdExprInfo.Err message)])])]
    [(ResultTcSpmdExprInfo.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-reduce-let-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [bindings : AstLetBindingList]
  [mark : TcSpmdEnvMark]) : ResultTcSpmdLetState
  (tc-spmd-reduce-let-bindings-at ctx env spmd-env (& bindings) mark 0))

(define (tc-spmd-reduce-let-bindings-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [bindings : (& bindings AstLetBindingList)]
  [mark : TcSpmdEnvMark]
  [index : i64]) : ResultTcSpmdLetState
  (if (>= index (ast-let-binding-list-len bindings))
    (ResultTcSpmdLetState.Ok (TcSpmdLetState env spmd-env mark))
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (match (tc-spmd-reduce-class ctx env spmd-env init)
            [(ResultTcSpmdExprInfo.Ok info)
              (match info
                [(TcSpmdExprInfo init-ty init-class next-spmd-env)
                  (let
                    [bound-ty : AstType
                      (match maybe-ty
                        [(AstMaybeType.Some want)
                          (if (tc-type-contains-any-region init-ty)
                            init-ty
                            (tc-resolve-type ctx want))]
                        [(AstMaybeType.No) init-ty])]
                    (tc-spmd-reduce-let-bindings-at
                      ctx
                      (tc-bind-id env name bound-ty)
                      (tc-spmd-env-bind
                        next-spmd-env
                        (intern-str name)
                        bound-ty
                        init-class
                        TcSpmdScope.Local)
                      bindings
                      mark
                      (+ index 1)))])]
            [(ResultTcSpmdExprInfo.Err message)
              (ResultTcSpmdLetState.Err message)]))])))

(define (tc-spmd-reduce-class
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : AstExpr]) : ResultTcSpmdExprInfo
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-reduce-class ctx env spmd-env inner))]
    [(AstExpr.Literal _)
      (tc-spmd-reduce-class-finish ctx env spmd-env expr TcSpmdClass.Uniform)]
    [(AstExpr.SpmdProgramIndex)
      (tc-spmd-reduce-class-finish ctx env spmd-env expr TcSpmdClass.Varying)]
    [(AstExpr.SpmdProgramCount)
      (tc-spmd-reduce-class-finish ctx env spmd-env expr TcSpmdClass.Uniform)]
    [(AstExpr.Var name)
      (let
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-expr-id env name-text)
            [(ResultTcExprId.Ok virtual-id)
              (tc-spmd-reduce-class ctx env spmd-env (ast-node-get virtual-id))]
            [(ResultTcExprId.Err message) (ResultTcSpmdExprInfo.Err message)])
          (match (tc-spmd-env-lookup spmd-env name-text)
            [(TcSpmdLookup.Found _ class _ _)
              (tc-spmd-reduce-class-finish ctx env spmd-env expr class)]
            [(TcSpmdLookup.Missing)
              (tc-spmd-reduce-class-finish
                ctx
                env
                spmd-env
                expr
                TcSpmdClass.Uniform)])))]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (match (tc-spmd-reduce-class ctx env spmd-env left)
          [(ResultTcSpmdExprInfo.Ok left-info)
            (match left-info
              [(TcSpmdExprInfo _ left-class left-env)
                (match (tc-spmd-reduce-class ctx env left-env right)
                  [(ResultTcSpmdExprInfo.Ok right-info)
                    (match right-info
                      [(TcSpmdExprInfo _ right-class right-env)
                        (tc-spmd-reduce-class-finish
                          ctx
                          env
                          right-env
                          expr
                          (tc-spmd-merge-class left-class right-class))])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-spmd-reduce-class ctx env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-reduce-class-finish ctx env next-spmd-env expr class)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-spmd-reduce-class ctx env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-reduce-class-finish ctx env next-spmd-env expr class)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-spmd-reduce-class ctx env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-reduce-class-finish ctx env next-spmd-env expr class)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-spmd-reduce-let-bindings
              ctx
              env
              spmd-env
              bindings
              (tc-spmd-env-mark spmd-env))
              [(ResultTcSpmdLetState.Ok state)
                (match state
                  [(TcSpmdLetState body-env body-spmd-env mark)
                    (match (tc-spmd-reduce-class
                      ctx
                      body-env
                      body-spmd-env
                      body)
                      [(ResultTcSpmdExprInfo.Ok body-info)
                        (match body-info
                          [(TcSpmdExprInfo _ body-class final-spmd-env)
                            (tc-spmd-reduce-class-finish
                              ctx
                              env
                              (tc-spmd-env-restore final-spmd-env mark)
                              expr
                              body-class)])]
                      [(ResultTcSpmdExprInfo.Err message)
                        (ResultTcSpmdExprInfo.Err message)])])]
              [(ResultTcSpmdLetState.Err message)
                (ResultTcSpmdExprInfo.Err message)]))])]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-spmd-reduce-class ctx env spmd-env array)
          [(ResultTcSpmdExprInfo.Ok array-info)
            (match array-info
              [(TcSpmdExprInfo _ array-class array-env)
                (match (tc-spmd-reduce-class ctx env array-env index)
                  [(ResultTcSpmdExprInfo.Ok index-info)
                    (match index-info
                      [(TcSpmdExprInfo _ index-class index-env)
                        (tc-spmd-reduce-class-finish
                          ctx
                          env
                          index-env
                          expr
                          (tc-spmd-merge-class array-class index-class))])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (match (tc-spmd-reduce-class ctx env spmd-env value)
          [(ResultTcSpmdExprInfo.Ok value-info)
            (match value-info
              [(TcSpmdExprInfo _ value-class value-env)
                (match (tc-spmd-reduce-class-with-expected-or-actual
                  ctx
                  env
                  value-env
                  lane
                  (AstType.I64))
                  [(ResultTcSpmdExprInfo.Ok lane-info)
                    (match lane-info
                      [(TcSpmdExprInfo lane-ty lane-class lane-env)
                        (match (tc-expr ctx env expr)
                          [(ResultTcType.Ok expr-ty)
                            (tc-spmd-broadcast-finish
                              ctx
                              expr-ty
                              value-class
                              lane-ty
                              lane-class
                              lane-env)]
                          [(ResultTcType.Err message)
                            (ResultTcSpmdExprInfo.Err message)])])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (match (tc-spmd-reduce-class ctx env spmd-env value)
          [(ResultTcSpmdExprInfo.Ok value-info)
            (match value-info
              [(TcSpmdExprInfo _ value-class value-env)
                (match (tc-spmd-reduce-class-with-expected-or-actual
                  ctx
                  env
                  value-env
                  lane
                  (AstType.I64))
                  [(ResultTcSpmdExprInfo.Ok lane-info)
                    (match lane-info
                      [(TcSpmdExprInfo lane-ty _ lane-env)
                        (match (tc-expr ctx env expr)
                          [(ResultTcType.Ok expr-ty)
                            (tc-spmd-shuffle-finish
                              ctx
                              expr-ty
                              value-class
                              lane-ty
                              lane-env)]
                          [(ResultTcType.Err message)
                            (ResultTcSpmdExprInfo.Err message)])])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [_ (tc-spmd-reduce-class-finish ctx env spmd-env expr TcSpmdClass.Uniform)]))

(define (tc-spmd-check-reduce-value-broadcasts
  [ctx : TcContext]
  [env : TcTypeEnv]
  [index : String]
  [index-ty : AstType]
  [value : AstExpr]) : ResultTcUnit
  (let
    [value-env : TcTypeEnv (tc-bind env index index-ty)]
    [value-spmd-env : TcSpmdEnv
      (tc-spmd-env-bind-role
        (tc-spmd-env-mark-outer (tc-spmd-env-from-type-env env))
        index
        index-ty
        TcSpmdClass.Varying
        TcSpmdScope.Local
        TcSpmdRole.ForeachIndex)]
    (match (tc-spmd-reduce-class ctx value-env value-spmd-env value)
      [(ResultTcSpmdExprInfo.Ok _) ResultTcUnit.Ok]
      [(ResultTcSpmdExprInfo.Err message) (ResultTcUnit.Err message)])))

(define (tc-spmd-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : AstExpr]) : ResultTcSpmdExprInfo
  (match (tc-expr ctx env expr)
    [(ResultTcType.Ok ty) (tc-spmd-expr-typed ctx env spmd-env expr ty)]
    [(ResultTcType.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : AstExpr]
  [expected : AstType]) : ResultTcSpmdExprInfo
  (match (tc-expr-with-expected-or-actual ctx env expr expected)
    [(ResultTcType.Ok ty) (tc-spmd-expr-typed ctx env spmd-env expr ty)]
    [(ResultTcType.Err message) (ResultTcSpmdExprInfo.Err message)]))

(define (tc-spmd-array-value-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [array-ty : AstType]
  [value : AstExpr]) : ResultTcSpmdExprInfo
  (match (tc-type-strip-region (tc-resolve-type ctx array-ty))
    [(AstType.Array elem-ty _)
      (tc-spmd-expr-with-expected-or-actual
        ctx
        env
        spmd-env
        value
        (ty-node-get elem-ty))]
    [(AstType.DynArray elem-ty)
      (tc-spmd-expr-with-expected-or-actual
        ctx
        env
        spmd-env
        value
        (ty-node-get elem-ty))]
    [_ (tc-spmd-expr ctx env spmd-env value)]))

(define (tc-spmd-expr-typed
  [ctx : TcContext]
  [env : TcTypeEnv]
  [spmd-env : TcSpmdEnv]
  [expr : AstExpr]
  [expr-ty : AstType]) : ResultTcSpmdExprInfo
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-expr-typed ctx env spmd-env inner expr-ty))]
    [(AstExpr.Literal _) (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(AstExpr.SpmdProgramIndex)
      (tc-spmd-finish expr-ty TcSpmdClass.Varying spmd-env)]
    [(AstExpr.SpmdProgramCount)
      (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(AstExpr.Var name)
      (let
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-expr-id env name-text)
            [(ResultTcExprId.Ok virtual-id)
              (tc-spmd-expr-typed
                ctx
                env
                spmd-env
                (ast-node-get virtual-id)
                expr-ty)]
            [(ResultTcExprId.Err message) (ResultTcSpmdExprInfo.Err message)])
          (match (tc-spmd-env-lookup spmd-env name-text)
            [(TcSpmdLookup.Found _ class _ _)
              (tc-spmd-finish-ctx ctx expr-ty class spmd-env)]
            [(TcSpmdLookup.Missing)
              (tc-spmd-finish-ctx ctx expr-ty TcSpmdClass.Uniform spmd-env)])))]
    [(AstExpr.TypeLiteral _)
      (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(AstExpr.Init _) (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-spmd-expr ctx env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish-ctx ctx expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-spmd-expr ctx env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish-ctx ctx expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-spmd-expr ctx env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (match (tc-spmd-expr ctx env spmd-env left)
          [(ResultTcSpmdExprInfo.Ok left-info)
            (match left-info
              [(TcSpmdExprInfo _ left-class left-env)
                (match (tc-spmd-expr ctx env left-env right)
                  [(ResultTcSpmdExprInfo.Ok right-info)
                    (match right-info
                      [(TcSpmdExprInfo _ right-class right-env)
                        (tc-spmd-finish
                          expr-ty
                          (tc-spmd-merge-class left-class right-class)
                          right-env)])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (tc-spmd-atomic-call ctx env spmd-env expr-ty func args))]
    [(AstExpr.BracketClause items)
      (match (tc-spmd-expr-list ctx env spmd-env items)
        [(ResultTcSpmdExprListInfo.Ok info)
          (match info
            [(TcSpmdExprListInfo class next-env)
              (tc-spmd-finish expr-ty class next-env)])]
        [(ResultTcSpmdExprListInfo.Err message)
          (ResultTcSpmdExprInfo.Err message)])]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (match (tc-spmd-expr ctx env spmd-env cond)
          [(ResultTcSpmdExprInfo.Ok cond-info)
            (match cond-info
              [(TcSpmdExprInfo _ cond-class cond-env)
                (if (tc-spmd-varying? cond-class)
                  (tc-spmd-masked-if
                    ctx
                    env
                    cond-env
                    expr-ty
                    then-branch
                    else-branch)
                  (match (tc-spmd-expr ctx env cond-env then-branch)
                    [(ResultTcSpmdExprInfo.Ok then-info)
                      (match then-info
                        [(TcSpmdExprInfo _ then-class then-env)
                          (match (tc-spmd-expr ctx env cond-env else-branch)
                            [(ResultTcSpmdExprInfo.Ok else-info)
                              (match else-info
                                [(TcSpmdExprInfo _ else-class else-env)
                                  (tc-spmd-finish
                                    expr-ty
                                    (tc-spmd-merge-class then-class else-class)
                                    (tc-spmd-env-merge-classes
                                      then-env
                                      else-env))])]
                            [(ResultTcSpmdExprInfo.Err message)
                              (ResultTcSpmdExprInfo.Err message)])])]
                    [(ResultTcSpmdExprInfo.Err message)
                      (ResultTcSpmdExprInfo.Err message)]))])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-spmd-let-bindings
              ctx
              env
              spmd-env
              bindings
              (tc-spmd-env-mark spmd-env))
              [(ResultTcSpmdLetState.Ok state)
                (match state
                  [(TcSpmdLetState body-env body-spmd-env mark)
                    (match (tc-spmd-expr ctx body-env body-spmd-env body)
                      [(ResultTcSpmdExprInfo.Ok body-info)
                        (match body-info
                          [(TcSpmdExprInfo _ body-class final-spmd-env)
                            (tc-spmd-finish
                              expr-ty
                              body-class
                              (tc-spmd-env-restore final-spmd-env mark))])]
                      [(ResultTcSpmdExprInfo.Err message)
                        (ResultTcSpmdExprInfo.Err message)])])]
              [(ResultTcSpmdLetState.Err message)
                (ResultTcSpmdExprInfo.Err message)]))])]
    [(AstExpr.Lambda _) (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(AstExpr.Tuple exprs)
      (match (tc-spmd-expr-list ctx env spmd-env exprs)
        [(ResultTcSpmdExprListInfo.Ok info)
          (match info
            [(TcSpmdExprListInfo class next-spmd-env)
              (tc-spmd-finish expr-ty class next-spmd-env)])]
        [(ResultTcSpmdExprListInfo.Err message)
          (ResultTcSpmdExprInfo.Err message)])]
    [(AstExpr.TupleRef tuple-box _)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        (match (tc-spmd-expr ctx env spmd-env tuple)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.Array exprs)
      (match (tc-spmd-expr-list ctx env spmd-env exprs)
        [(ResultTcSpmdExprListInfo.Ok info)
          (match info
            [(TcSpmdExprListInfo class next-spmd-env)
              (tc-spmd-finish expr-ty class next-spmd-env)])]
        [(ResultTcSpmdExprListInfo.Err message)
          (ResultTcSpmdExprInfo.Err message)])]
    [(AstExpr.MakeArray _ len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (match (tc-spmd-expr ctx env spmd-env len)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-spmd-expr ctx env spmd-env array)
          [(ResultTcSpmdExprInfo.Ok array-info)
            (match array-info
              [(TcSpmdExprInfo _ array-class array-env)
                (match (tc-spmd-expr ctx env array-env index)
                  [(ResultTcSpmdExprInfo.Ok index-info)
                    (match index-info
                      [(TcSpmdExprInfo _ index-class index-env)
                        (tc-spmd-finish-lane
                          ctx
                          expr-ty
                          (tc-spmd-merge-class array-class index-class)
                          index-env)])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-spmd-expr ctx env spmd-env array)
          [(ResultTcSpmdExprInfo.Ok array-info)
            (match array-info
              [(TcSpmdExprInfo array-ty array-class array-env)
                (match (tc-spmd-expr ctx env array-env index)
                  [(ResultTcSpmdExprInfo.Ok index-info)
                    (match index-info
                      [(TcSpmdExprInfo _ index-class index-env)
                        (match (if (tc-spmd-varying? index-class)
                          (tc-spmd-foreach-index ctx env array-env index)
                          ResultTcUnit.Ok)
                          [(ResultTcUnit.Ok)
                            (match (tc-spmd-array-value-expr
                              ctx
                              env
                              index-env
                              array-ty
                              value)
                              [(ResultTcSpmdExprInfo.Ok value-info)
                                (match value-info
                                  [(TcSpmdExprInfo _ value-class value-env)
                                    (let
                                      [write-class : TcSpmdClass
                                        (tc-spmd-merge-class
                                          array-class
                                          (tc-spmd-merge-class
                                            index-class
                                            value-class))]
                                      (match (tc-type-strip-region array-ty)
                                        [(AstType.Array elem-ty _)
                                          (if (and
                                            (tc-spmd-varying? write-class)
                                            (not
                                              (tc-spmd-lane-type-supported?
                                                (ty-node-get elem-ty))))
                                            (ResultTcSpmdExprInfo.Err
                                              (string.append
                                                "typecheck: foreach varying array lane type is not supported: "
                                                (tc-type-render
                                                  (tc-type-strip-region
                                                    (ty-node-get elem-ty)))))
                                            (tc-spmd-finish
                                              expr-ty
                                              TcSpmdClass.Uniform
                                              value-env))]
                                        [(AstType.DynArray elem-ty)
                                          (if (and
                                            (tc-spmd-varying? write-class)
                                            (not
                                              (tc-spmd-lane-type-supported?
                                                (ty-node-get elem-ty))))
                                            (ResultTcSpmdExprInfo.Err
                                              (string.append
                                                "typecheck: foreach varying array lane type is not supported: "
                                                (tc-type-render
                                                  (tc-type-strip-region
                                                    (ty-node-get elem-ty)))))
                                            (tc-spmd-finish
                                              expr-ty
                                              TcSpmdClass.Uniform
                                              value-env))]
                                        [_
                                          (tc-spmd-finish
                                            expr-ty
                                            TcSpmdClass.Uniform
                                            value-env)]))])]
                              [(ResultTcSpmdExprInfo.Err message)
                                (ResultTcSpmdExprInfo.Err message)])]
                          [(ResultTcUnit.Err message)
                            (ResultTcSpmdExprInfo.Err message)])])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.StructSet receiver-box field value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-spmd-expr ctx env spmd-env receiver)
          [(ResultTcSpmdExprInfo.Ok receiver-info)
            (match receiver-info
              [(TcSpmdExprInfo receiver-ty receiver-class receiver-env)
                (match (tc-spmd-expr ctx env receiver-env value)
                  [(ResultTcSpmdExprInfo.Ok value-info)
                    (match value-info
                      [(TcSpmdExprInfo _ value-class value-env)
                        (match (tc-struct-set-field-type
                          ctx
                          receiver-ty
                          (intern-str field))
                          [(ResultTcType.Ok field-ty)
                            (let
                              [write-class : TcSpmdClass
                                (tc-spmd-merge-class receiver-class value-class)]
                              (if (and
                                (tc-spmd-varying? write-class)
                                (not
                                  (tc-spmd-lane-type-supported?
                                    (tc-type-strip-region field-ty))))
                                (ResultTcSpmdExprInfo.Err
                                  (string.append
                                    "typecheck: foreach varying struct field type is not supported: "
                                    (tc-type-render
                                      (tc-type-strip-region field-ty))))
                                (tc-spmd-finish
                                  expr-ty
                                  TcSpmdClass.Uniform
                                  value-env)))]
                          [(ResultTcType.Err message)
                            (ResultTcSpmdExprInfo.Err message)])])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.ArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-spmd-expr ctx env spmd-env array)
          [(ResultTcSpmdExprInfo.Ok array-info)
            (match array-info
              [(TcSpmdExprInfo array-ty array-class array-env)
                (match (tc-spmd-expr ctx env array-env value)
                  [(ResultTcSpmdExprInfo.Ok value-info)
                    (match value-info
                      [(TcSpmdExprInfo _ value-class value-env)
                        (let
                          [write-class : TcSpmdClass
                            (tc-spmd-merge-class array-class value-class)]
                          (match (tc-type-strip-region array-ty)
                            [(AstType.DynArray elem-ty)
                              (if (and
                                (tc-spmd-varying? write-class)
                                (not
                                  (tc-spmd-lane-type-supported?
                                    (ty-node-get elem-ty))))
                                (ResultTcSpmdExprInfo.Err
                                  (string.append
                                    "typecheck: foreach varying array lane type is not supported: "
                                    (tc-type-render
                                      (tc-type-strip-region
                                        (ty-node-get elem-ty)))))
                                (tc-spmd-finish
                                  expr-ty
                                  TcSpmdClass.Uniform
                                  value-env))]
                            [_
                              (tc-spmd-finish
                                expr-ty
                                TcSpmdClass.Uniform
                                value-env)]))])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.StringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-spmd-expr ctx env spmd-env str)
          [(ResultTcSpmdExprInfo.Ok str-info)
            (match str-info
              [(TcSpmdExprInfo _ str-class str-env)
                (match (tc-spmd-expr ctx env str-env index)
                  [(ResultTcSpmdExprInfo.Ok index-info)
                    (match index-info
                      [(TcSpmdExprInfo _ index-class index-env)
                        (tc-spmd-finish
                          expr-ty
                          (tc-spmd-merge-class str-class index-class)
                          index-env)])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (match (tc-spmd-expr ctx env spmd-env cond)
          [(ResultTcSpmdExprInfo.Ok cond-info)
            (match cond-info
              [(TcSpmdExprInfo _ cond-class cond-env)
                (if (tc-spmd-varying? cond-class)
                  (match (tc-spmd-masked-if-expr ctx env spmd-env cond)
                    [(ResultTcUnit.Ok)
                      (match (tc-spmd-masked-if-expr
                        ctx
                        (tc-enter-loop-target env)
                        cond-env
                        body)
                        [(ResultTcUnit.Ok)
                          (match (tc-spmd-expr
                            ctx
                            (tc-enter-loop-target env)
                            cond-env
                            body)
                            [(ResultTcSpmdExprInfo.Ok body-info)
                              (match body-info
                                [(TcSpmdExprInfo _ _ body-env)
                                  (tc-spmd-finish
                                    expr-ty
                                    TcSpmdClass.Uniform
                                    (tc-spmd-env-merge-classes
                                      cond-env
                                      body-env))])]
                            [(ResultTcSpmdExprInfo.Err message)
                              (ResultTcSpmdExprInfo.Err message)])]
                        [(ResultTcUnit.Err message)
                          (ResultTcSpmdExprInfo.Err message)])]
                    [(ResultTcUnit.Err message)
                      (ResultTcSpmdExprInfo.Err message)])
                  (match (tc-spmd-expr
                    ctx
                    (tc-enter-loop-target env)
                    cond-env
                    body)
                    [(ResultTcSpmdExprInfo.Ok body-info)
                      (match body-info
                        [(TcSpmdExprInfo _ _ body-env)
                          (tc-spmd-finish
                            expr-ty
                            TcSpmdClass.Uniform
                            (tc-spmd-env-merge-classes cond-env body-env))])]
                    [(ResultTcSpmdExprInfo.Err message)
                      (ResultTcSpmdExprInfo.Err message)]))])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.Begin exprs) (tc-spmd-begin-list ctx env spmd-env exprs)]
    [(AstExpr.Unsafe exprs)
      (tc-spmd-begin-list ctx (tc-enter-unsafe env) spmd-env exprs)]
    [(AstExpr.Set name value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-set-expr-id env name-text value-box)
            [(ResultTcExprId.Ok virtual-id)
              (tc-spmd-expr-typed
                ctx
                env
                spmd-env
                (ast-node-get virtual-id)
                expr-ty)]
            [(ResultTcExprId.Err message) (ResultTcSpmdExprInfo.Err message)])
          (match (tc-spmd-expr ctx env spmd-env value)
            [(ResultTcSpmdExprInfo.Ok value-info)
              (match value-info
                [(TcSpmdExprInfo _ value-class value-env)
                  (if (tc-spmd-env-has-local? value-env name-text)
                    (tc-spmd-finish
                      expr-ty
                      TcSpmdClass.Uniform
                      (tc-spmd-env-set-local-class
                        value-env
                        name-text
                        value-class))
                    (if (tc-spmd-env-has-outer? value-env name-text)
                      (ResultTcSpmdExprInfo.Err
                        "typecheck: foreach cannot set binding declared outside foreach")
                      (tc-spmd-finish expr-ty TcSpmdClass.Uniform value-env)))])]
            [(ResultTcSpmdExprInfo.Err message)
              (ResultTcSpmdExprInfo.Err message)])))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            (match (tc-spmd-expr ctx env spmd-env scrutinee)
              [(ResultTcSpmdExprInfo.Ok scrut-info)
                (match scrut-info
                  [(TcSpmdExprInfo scrut-ty scrut-class scrut-env)
                    (let
                      [initial-class : TcSpmdClass
                        (match (tc-type-strip-region expr-ty)
                          [(AstType.Unit) TcSpmdClass.Uniform]
                          [_ scrut-class])]
                      (match (tc-spmd-match-arms
                        ctx
                        env
                        scrut-env
                        scrut-ty
                        scrut-class
                        arms
                        initial-class)
                        [(ResultTcSpmdExprListInfo.Ok arms-info)
                          (match arms-info
                            [(TcSpmdExprListInfo arms-class arms-env)
                              (tc-spmd-finish expr-ty arms-class arms-env)])]
                        [(ResultTcSpmdExprListInfo.Err message)
                          (ResultTcSpmdExprInfo.Err message)]))])]
              [(ResultTcSpmdExprInfo.Err message)
                (ResultTcSpmdExprInfo.Err message)]))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach index index-ty start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-spmd-expr ctx env spmd-env start)
              [(ResultTcSpmdExprInfo.Ok start-info)
                (match start-info
                  [(TcSpmdExprInfo _ start-class start-env)
                    (match (tc-spmd-require-uniform
                      start-class
                      "typecheck: foreach bounds must be uniform")
                      [(ResultTcUnit.Ok)
                        (match (tc-spmd-expr ctx env start-env end)
                          [(ResultTcSpmdExprInfo.Ok end-info)
                            (match end-info
                              [(TcSpmdExprInfo _ end-class end-env)
                                (match (tc-spmd-require-uniform
                                  end-class
                                  "typecheck: foreach bounds must be uniform")
                                  [(ResultTcUnit.Ok)
                                    (match (tc-spmd-check-foreach-body-with-env
                                      ctx
                                      env
                                      end-env
                                      (intern-str index)
                                      (tc-resolve-type ctx index-ty)
                                      body)
                                      [(ResultTcUnit.Ok)
                                        (tc-spmd-finish
                                          expr-ty
                                          TcSpmdClass.Uniform
                                          end-env)]
                                      [(ResultTcUnit.Err message)
                                        (ResultTcSpmdExprInfo.Err message)])]
                                  [(ResultTcUnit.Err message)
                                    (ResultTcSpmdExprInfo.Err message)])])]
                          [(ResultTcSpmdExprInfo.Err message)
                            (ResultTcSpmdExprInfo.Err message)])]
                      [(ResultTcUnit.Err message)
                        (ResultTcSpmdExprInfo.Err message)])])]
              [(ResultTcSpmdExprInfo.Err message)
                (ResultTcSpmdExprInfo.Err message)]))])]
    [(AstExpr.SpmdReduce _)
      (ResultTcSpmdExprInfo.Err
        "typecheck: spmd-reduce inside foreach is not supported")]
    [(AstExpr.SpmdScan _)
      (ResultTcSpmdExprInfo.Err
        "typecheck: spmd-scan inside foreach is not supported")]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (match (tc-spmd-expr ctx env spmd-env value)
          [(ResultTcSpmdExprInfo.Ok value-info)
            (match value-info
              [(TcSpmdExprInfo _ value-class value-env)
                (match (tc-spmd-expr-with-expected-or-actual
                  ctx
                  env
                  value-env
                  lane
                  (AstType.I64))
                  [(ResultTcSpmdExprInfo.Ok lane-info)
                    (match lane-info
                      [(TcSpmdExprInfo lane-ty lane-class lane-env)
                        (tc-spmd-broadcast-finish
                          ctx
                          expr-ty
                          value-class
                          lane-ty
                          lane-class
                          lane-env)])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (match (tc-spmd-expr ctx env spmd-env value)
          [(ResultTcSpmdExprInfo.Ok value-info)
            (match value-info
              [(TcSpmdExprInfo _ value-class value-env)
                (match (tc-spmd-expr-with-expected-or-actual
                  ctx
                  env
                  value-env
                  lane
                  (AstType.I64))
                  [(ResultTcSpmdExprInfo.Ok lane-info)
                    (match lane-info
                      [(TcSpmdExprInfo lane-ty _ lane-env)
                        (tc-spmd-shuffle-finish
                          ctx
                          expr-ty
                          value-class
                          lane-ty
                          lane-env)])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.Borrow _ _ place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (match (tc-spmd-expr ctx env spmd-env place)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.StructGet receiver-box _)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (match (tc-spmd-expr ctx env spmd-env receiver)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-spmd-expr ctx env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-spmd-expr ctx env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-spmd-expr ctx env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.BoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-spmd-expr ctx env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ inner-class inner-env)
                (match (tc-spmd-expr ctx env inner-env value)
                  [(ResultTcSpmdExprInfo.Ok value-info)
                    (match value-info
                      [(TcSpmdExprInfo _ value-class next-spmd-env)
                        (tc-spmd-finish
                          expr-ty
                          (tc-spmd-merge-class inner-class value-class)
                          next-spmd-env)])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.WithRegion region body)
      (tc-spmd-begin-list ctx (tc-push-region env region) spmd-env body)]
    [(AstExpr.WithEscape _ _)
      (ResultTcSpmdExprInfo.Err
        "typecheck: with-escape inside spmd is not supported")]
    [(AstExpr.WithScratch _)
      (ResultTcSpmdExprInfo.Err
        "typecheck: with-scratch inside spmd is not supported")]
    [(AstExpr.InArena _ _)
      (ResultTcSpmdExprInfo.Err
        "typecheck: in-arena inside spmd is not supported")]
    [(AstExpr.WithResource _)
      (ResultTcSpmdExprInfo.Err
        "typecheck: resource with is not implemented yet (#907)")]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-spmd-expr ctx env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.Quote _) (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(AstExpr.Quasiquote _)
      (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(AstExpr.Unquote _)
      (ResultTcSpmdExprInfo.Err
        "typecheck: unquote is only valid inside quasiquote")]
    [(AstExpr.UnquoteSplicing _)
      (ResultTcSpmdExprInfo.Err
        "typecheck: unquote-splicing is only valid inside quasiquote")]
    [(AstExpr.Try _)
      (ResultTcSpmdExprInfo.Err
        "typecheck: try inside foreach is not supported")]
    [(AstExpr.Return _)
      (ResultTcSpmdExprInfo.Err
        "typecheck: return inside foreach is not supported")]
    [(AstExpr.Break)
      (ResultTcSpmdExprInfo.Err
        "typecheck: break inside foreach is not supported")]
    [(AstExpr.Continue)
      (ResultTcSpmdExprInfo.Err
        "typecheck: continue inside foreach is not supported")]
    [(AstExpr.PtrNull _) (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(AstExpr.PtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-spmd-expr ctx env spmd-env inner)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.PtrAddrOf _)
      (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(AstExpr.PtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (match (tc-spmd-expr ctx env spmd-env ptr)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-spmd-expr ctx env spmd-env ptr)
          [(ResultTcSpmdExprInfo.Ok ptr-info)
            (match ptr-info
              [(TcSpmdExprInfo _ ptr-class ptr-env)
                (match (tc-spmd-expr ctx env ptr-env value)
                  [(ResultTcSpmdExprInfo.Ok value-info)
                    (match value-info
                      [(TcSpmdExprInfo _ value-class value-env)
                        (tc-spmd-finish
                          expr-ty
                          (tc-spmd-merge-class ptr-class value-class)
                          value-env)])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (match (tc-spmd-expr ctx env spmd-env ptr)
          [(ResultTcSpmdExprInfo.Ok ptr-info)
            (match ptr-info
              [(TcSpmdExprInfo _ ptr-class ptr-env)
                (match (tc-spmd-expr ctx env ptr-env offset)
                  [(ResultTcSpmdExprInfo.Ok offset-info)
                    (match offset-info
                      [(TcSpmdExprInfo _ offset-class offset-env)
                        (tc-spmd-finish
                          expr-ty
                          (tc-spmd-merge-class ptr-class offset-class)
                          offset-env)])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.PtrCast ptr-box _)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (match (tc-spmd-expr ctx env spmd-env ptr)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.PtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (match (tc-spmd-expr ctx env spmd-env ptr)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.IntToPtr value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-spmd-expr ctx env spmd-env value)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.StringData str-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        (match (tc-spmd-expr ctx env spmd-env str)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (match (tc-spmd-expr ctx env spmd-env ptr)
          [(ResultTcSpmdExprInfo.Ok ptr-info)
            (match ptr-info
              [(TcSpmdExprInfo _ ptr-class ptr-env)
                (match (tc-spmd-expr ctx env ptr-env len)
                  [(ResultTcSpmdExprInfo.Ok len-info)
                    (match len-info
                      [(TcSpmdExprInfo _ len-class len-env)
                        (tc-spmd-finish
                          expr-ty
                          (tc-spmd-merge-class ptr-class len-class)
                          len-env)])]
                  [(ResultTcSpmdExprInfo.Err message)
                    (ResultTcSpmdExprInfo.Err message)])])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.ArrayData array-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (match (tc-spmd-expr ctx env spmd-env array)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.BinaryData _)
      (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(AstExpr.ProgramArgc)
      (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(AstExpr.ProgramArgv)
      (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(AstExpr.ProgramEnvp)
      (tc-spmd-finish expr-ty TcSpmdClass.Uniform spmd-env)]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-spmd-cpuid-like ctx env spmd-env expr-ty leaf subleaf))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-spmd-cpuid-like ctx env spmd-env expr-ty leaf subleaf))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-spmd-cpuid-like ctx env spmd-env expr-ty leaf subleaf))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-spmd-cpuid-like ctx env spmd-env expr-ty leaf subleaf))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-spmd-expr ctx env spmd-env index)
          [(ResultTcSpmdExprInfo.Ok info)
            (match info
              [(TcSpmdExprInfo _ class next-spmd-env)
                (tc-spmd-finish expr-ty class next-spmd-env)])]
          [(ResultTcSpmdExprInfo.Err message)
            (ResultTcSpmdExprInfo.Err message)]))]
    [(AstExpr.Syscall args)
      (match (tc-spmd-expr-list ctx env spmd-env args)
        [(ResultTcSpmdExprListInfo.Ok args-info)
          (match args-info
            [(TcSpmdExprListInfo args-class args-env)
              (match (tc-spmd-require-uniform
                args-class
                "typecheck: foreach calls with varying arguments are not supported")
                [(ResultTcUnit.Ok)
                  (tc-spmd-finish expr-ty TcSpmdClass.Uniform args-env)]
                [(ResultTcUnit.Err message) (ResultTcSpmdExprInfo.Err message)])])]
        [(ResultTcSpmdExprListInfo.Err message)
          (ResultTcSpmdExprInfo.Err message)])]))

(define (tc-param-list-add-bound-names
  [params : AstParamList]
  [bound : TcStringList]) : TcStringList
  (tc-param-list-add-bound-names-at (& params) 0 bound))

(define (tc-param-list-add-bound-names-at
  [params : (& params AstParamList)]
  [index : i64]
  [bound : TcStringList]) : TcStringList
  (if (>= index (ast-param-list-len params))
    bound
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param name _ _)
        (tc-param-list-add-bound-names-at
          params
          (+ index 1)
          (tc-string-list-add bound (intern-str name)))])))

(define (tc-param-bound-names [params : AstParamList]) : TcStringList
  (tc-param-list-add-bound-names params TcStringList.Nil))

(define (tc-pattern-add-bound-names
  [pattern : AstPattern]
  [bound : TcStringList]) : TcStringList
  (match pattern
    [(AstPattern.Var name _) (tc-string-list-add bound (intern-str name))]
    [(AstPattern.Tuple patterns-box)
      (let
        [patterns : AstPatternList (box-get patterns-box)]
        (tc-pattern-list-add-bound-names patterns bound))]
    [(AstPattern.Wildcard) bound]
    [(AstPattern.Binding name) (tc-string-list-add bound (intern-str name))]
    [(AstPattern.Variant _ patterns-box)
      (let
        [patterns : AstPatternList (box-get patterns-box)]
        (tc-pattern-list-add-bound-names patterns bound))]
    [(AstPattern.Literal _) bound]))

(define (tc-pattern-list-add-bound-names
  [patterns : AstPatternList]
  [bound : TcStringList]) : TcStringList
  (tc-pattern-list-add-bound-names-at (& patterns) bound 0))

(define (tc-pattern-list-add-bound-names-at
  [patterns : (& patterns AstPatternList)]
  [bound : TcStringList]
  [index : i64]) : TcStringList
  (if (>= index (struct-get patterns len))
    bound
    (tc-pattern-list-add-bound-names-at
      patterns
      (tc-pattern-add-bound-names
        (ast-pattern-list-get patterns index (ast-pattern-fallback))
        bound)
      (+ index 1))))

(define (tc-let-binding-list-add-bound-names
  [bindings : AstLetBindingList]
  [bound : TcStringList]) : TcStringList
  (tc-let-binding-list-add-bound-names-at (& bindings) bound 0))

(define (tc-let-binding-list-add-bound-names-at
  [bindings : (& bindings AstLetBindingList)]
  [bound : TcStringList]
  [index : i64]) : TcStringList
  (if (>= index (ast-let-binding-list-len bindings))
    bound
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding name _ _)
        (tc-let-binding-list-add-bound-names-at
          bindings
          (tc-string-list-add bound (intern-str name))
          (+ index 1))])))

(define (tc-resource-binding-list-add-bound-names
  [bindings : AstResourceBindingList]
  [bound : TcStringList]) : TcStringList
  (tc-resource-binding-list-add-bound-names-at (& bindings) bound 0))

(define (tc-resource-binding-list-add-bound-names-at
  [bindings : (& bindings AstResourceBindingList)]
  [bound : TcStringList]
  [index : i64]) : TcStringList
  (if (>= index (ast-resource-binding-list-len bindings))
    bound
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding name _ _)
        (tc-resource-binding-list-add-bound-names-at
          bindings
          (tc-string-list-add bound (intern-str name))
          (+ index 1))])))

(define (tc-expr-list-uses-free-name?
  [exprs : AstExprList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-expr-list-uses-free-name-at? (& exprs) 0 name bound))

(define (tc-expr-list-uses-free-name-at?
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [name : String]
  [bound : TcStringList]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (tc-expr-uses-free-name?
        (ast-node-get (ast-expr-list-get exprs index 0))
        name
        bound)
      (tc-expr-list-uses-free-name-at? exprs (+ index 1) name bound))))

(define (tc-let-binding-list-uses-free-name?
  [bindings : AstLetBindingList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-let-binding-list-uses-free-name-at? (& bindings) name bound 0))

(define (tc-let-binding-list-uses-free-name-at?
  [bindings : (& bindings AstLetBindingList)]
  [name : String]
  [bound : TcStringList]
  [index : i64]) : bool
  (if (>= index (ast-let-binding-list-len bindings))
    false
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding bind-name _ init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (or
            (tc-expr-uses-free-name? init name bound)
            (tc-let-binding-list-uses-free-name-at?
              bindings
              name
              (tc-string-list-add bound (intern-str bind-name))
              (+ index 1))))])))

(define (tc-resource-binding-list-uses-free-name?
  [bindings : AstResourceBindingList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-resource-binding-list-uses-free-name-at? (& bindings) name bound 0))

(define (tc-resource-binding-list-uses-free-name-at?
  [bindings : (& bindings AstResourceBindingList)]
  [name : String]
  [bound : TcStringList]
  [index : i64]) : bool
  (if (>= index (ast-resource-binding-list-len bindings))
    false
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding bind-name init-box cleanup-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          [cleanup : AstExpr (ast-node-get cleanup-box)]
          (or
            (tc-expr-uses-free-name? init name bound)
            (tc-expr-uses-free-name? cleanup name bound)
            (tc-resource-binding-list-uses-free-name-at?
              bindings
              name
              (tc-string-list-add bound (intern-str bind-name))
              (+ index 1))))])))

(define (tc-match-arms-use-free-name?
  [arms : AstMatchArmList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-match-arms-use-free-name-at? (& arms) name bound 0))

(define (tc-match-arms-use-free-name-at?
  [arms : (& arms AstMatchArmList)]
  [name : String]
  [bound : TcStringList]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    false
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (let
          [body : AstExpr (ast-node-get body-box)]
          (or
            (tc-expr-uses-free-name?
              body
              name
              (tc-pattern-add-bound-names pattern bound))
            (tc-match-arms-use-free-name-at? arms name bound (+ index 1))))])))

(define (tc-expr-uses-free-name?
  [expr : AstExpr]
  [name : String]
  [bound : TcStringList]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExpr.Literal _) false]
    [(AstExpr.Var var-name)
      (and
        (string.eq (intern-str var-name) name)
        (not (tc-string-list-contains bound name)))]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (or
          (tc-expr-uses-free-name? left name bound)
          (tc-expr-uses-free-name? right name bound)))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (or
          (tc-expr-uses-free-name? func name bound)
          (tc-expr-list-uses-free-name? args name bound)))]
    [(AstExpr.BracketClause items)
      (tc-expr-list-uses-free-name? items name bound)]
    [(AstExpr.TypeLiteral _) false]
    [(AstExpr.Init _) false]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (or
          (tc-expr-uses-free-name? cond name bound)
          (tc-expr-uses-free-name? then-branch name bound)
          (tc-expr-uses-free-name? else-branch name bound)))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (or
              (tc-let-binding-list-uses-free-name? bindings name bound)
              (tc-expr-uses-free-name?
                body
                name
                (tc-let-binding-list-add-bound-names bindings bound))))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (tc-expr-uses-free-name?
              body
              name
              (tc-param-list-add-bound-names params bound)))])]
    [(AstExpr.Tuple exprs) (tc-expr-list-uses-free-name? exprs name bound)]
    [(AstExpr.TupleRef tuple-box _)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        (tc-expr-uses-free-name? tuple name bound))]
    [(AstExpr.Array exprs) (tc-expr-list-uses-free-name? exprs name bound)]
    [(AstExpr.MakeArray _ len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (tc-expr-uses-free-name? len name bound))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (or
          (tc-expr-uses-free-name? array name bound)
          (tc-expr-uses-free-name? index name bound)))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (tc-expr-uses-free-name? array name bound)
          (tc-expr-uses-free-name? index name bound)
          (tc-expr-uses-free-name? value name bound)))]
    [(AstExpr.ArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (tc-expr-uses-free-name? array name bound)
          (tc-expr-uses-free-name? value name bound)))]
    [(AstExpr.StringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (or
          (tc-expr-uses-free-name? str name bound)
          (tc-expr-uses-free-name? index name bound)))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (or
          (tc-expr-uses-free-name? cond name bound)
          (tc-expr-uses-free-name? body name bound)))]
    [(AstExpr.Begin exprs) (tc-expr-list-uses-free-name? exprs name bound)]
    [(AstExpr.Unsafe exprs) (tc-expr-list-uses-free-name? exprs name bound)]
    [(AstExpr.Set var-name value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (or
          (and
            (string.eq (intern-str var-name) name)
            (not (tc-string-list-contains bound name)))
          (tc-expr-uses-free-name? value name bound)))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExpr.Borrow _ _ place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (tc-expr-uses-free-name? place name bound))]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExpr.BoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (tc-expr-uses-free-name? inner name bound)
          (tc-expr-uses-free-name? value name bound)))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            (or
              (tc-expr-uses-free-name? scrutinee name bound)
              (tc-match-arms-use-free-name? arms name bound)))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach index _ start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (or
              (tc-expr-uses-free-name? start name bound)
              (tc-expr-uses-free-name? end name bound)
              (tc-expr-uses-free-name?
                body
                name
                (tc-string-list-add bound (intern-str index)))))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce _ index _ start-box end-box init-box value-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            (or
              (tc-expr-uses-free-name? start name bound)
              (tc-expr-uses-free-name? end name bound)
              (tc-expr-uses-free-name? init name bound)
              (tc-expr-uses-free-name?
                value
                name
                (tc-string-list-add bound (intern-str index)))))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            _
            index
            _
            start-box
            end-box
            prefix
            _
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            [value-bound : TcStringList
              (tc-string-list-add bound (intern-str index))]
            [body-bound : TcStringList
              (tc-string-list-add value-bound (intern-str prefix))]
            (or
              (tc-expr-uses-free-name? start name bound)
              (tc-expr-uses-free-name? end name bound)
              (tc-expr-uses-free-name? init name bound)
              (tc-expr-uses-free-name? value name value-bound)
              (tc-expr-uses-free-name? body name body-bound)))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (or
          (tc-expr-uses-free-name? value name bound)
          (tc-expr-uses-free-name? lane name bound)))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (or
          (tc-expr-uses-free-name? value name bound)
          (tc-expr-uses-free-name? lane name bound)))]
    [(AstExpr.StructGet receiver-box _)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (tc-expr-uses-free-name? receiver name bound))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (tc-expr-uses-free-name? receiver name bound)
          (tc-expr-uses-free-name? value name bound)))]
    [(AstExpr.WithRegion _ body) (tc-expr-list-uses-free-name? body name bound)]
    [(AstExpr.WithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (or
          (tc-expr-uses-free-name? scratch name bound)
          (tc-expr-list-uses-free-name? body name bound)))]
    [(AstExpr.WithScratch body) (tc-expr-list-uses-free-name? body name bound)]
    [(AstExpr.InArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (or
          (tc-expr-uses-free-name? arena name bound)
          (tc-expr-list-uses-free-name? body name bound)))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (or
            (tc-resource-binding-list-uses-free-name? bindings name bound)
            (tc-expr-list-uses-free-name?
              body
              name
              (tc-resource-binding-list-add-bound-names bindings bound)))])]
    [(AstExpr.TypeLiteral _) false]
    [(AstExpr.Init _) false]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExpr.Quote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExpr.Quasiquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExpr.Unquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExpr.UnquoteSplicing inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExpr.Return inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExpr.Break) false]
    [(AstExpr.Continue) false]
    [(AstExpr.PtrNull _) false]
    [(AstExpr.PtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-uses-free-name? inner name bound))]
    [(AstExpr.PtrAddrOf var-name)
      (and
        (string.eq (intern-str var-name) name)
        (not (tc-string-list-contains bound name)))]
    [(AstExpr.PtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-expr-uses-free-name? ptr name bound))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (tc-expr-uses-free-name? ptr name bound)
          (tc-expr-uses-free-name? value name bound)))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (or
          (tc-expr-uses-free-name? ptr name bound)
          (tc-expr-uses-free-name? offset name bound)))]
    [(AstExpr.PtrCast ptr-box _)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-expr-uses-free-name? ptr name bound))]
    [(AstExpr.PtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-expr-uses-free-name? ptr name bound))]
    [(AstExpr.IntToPtr value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-expr-uses-free-name? value name bound))]
    [(AstExpr.StringData str-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        (tc-expr-uses-free-name? str name bound))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (or
          (tc-expr-uses-free-name? ptr name bound)
          (tc-expr-uses-free-name? len name bound)))]
    [(AstExpr.ArrayData array-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-expr-uses-free-name? array name bound))]
    [(AstExpr.BinaryData _) false]
    [(AstExpr.SpmdProgramIndex) false]
    [(AstExpr.SpmdProgramCount) false]
    [(AstExpr.ProgramArgc) false]
    [(AstExpr.ProgramArgv) false]
    [(AstExpr.ProgramEnvp) false]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or
          (tc-expr-uses-free-name? leaf name bound)
          (tc-expr-uses-free-name? subleaf name bound)))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or
          (tc-expr-uses-free-name? leaf name bound)
          (tc-expr-uses-free-name? subleaf name bound)))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or
          (tc-expr-uses-free-name? leaf name bound)
          (tc-expr-uses-free-name? subleaf name bound)))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or
          (tc-expr-uses-free-name? leaf name bound)
          (tc-expr-uses-free-name? subleaf name bound)))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (tc-expr-uses-free-name? index name bound))]
    [(AstExpr.Syscall args) (tc-expr-list-uses-free-name? args name bound)]))

;; Same shadowing rules as `tc-expr-uses-free-name?`, but it only returns true
;; when the expression assigns to the free name. Lambda capture checks use this
;; to reject mutation of captured bindings while allowing local parameter/let
;; assignment inside the lambda.
(define (tc-expr-list-sets-free-name?
  [exprs : AstExprList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-expr-list-sets-free-name-at? (& exprs) 0 name bound))

(define (tc-expr-list-sets-free-name-at?
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [name : String]
  [bound : TcStringList]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (tc-expr-sets-free-name?
        (ast-node-get (ast-expr-list-get exprs index 0))
        name
        bound)
      (tc-expr-list-sets-free-name-at? exprs (+ index 1) name bound))))

(define (tc-let-binding-list-sets-free-name?
  [bindings : AstLetBindingList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-let-binding-list-sets-free-name-at? (& bindings) name bound 0))

(define (tc-let-binding-list-sets-free-name-at?
  [bindings : (& bindings AstLetBindingList)]
  [name : String]
  [bound : TcStringList]
  [index : i64]) : bool
  (if (>= index (ast-let-binding-list-len bindings))
    false
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding bind-name _ init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (or
            (tc-expr-sets-free-name? init name bound)
            (tc-let-binding-list-sets-free-name-at?
              bindings
              name
              (tc-string-list-add bound (intern-str bind-name))
              (+ index 1))))])))

(define (tc-resource-binding-list-sets-free-name?
  [bindings : AstResourceBindingList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-resource-binding-list-sets-free-name-at? (& bindings) name bound 0))

(define (tc-resource-binding-list-sets-free-name-at?
  [bindings : (& bindings AstResourceBindingList)]
  [name : String]
  [bound : TcStringList]
  [index : i64]) : bool
  (if (>= index (ast-resource-binding-list-len bindings))
    false
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding bind-name init-box cleanup-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          [cleanup : AstExpr (ast-node-get cleanup-box)]
          (or
            (tc-expr-sets-free-name? init name bound)
            (tc-expr-sets-free-name? cleanup name bound)
            (tc-resource-binding-list-sets-free-name-at?
              bindings
              name
              (tc-string-list-add bound (intern-str bind-name))
              (+ index 1))))])))

(define (tc-match-arms-set-free-name?
  [arms : AstMatchArmList]
  [name : String]
  [bound : TcStringList]) : bool
  (tc-match-arms-set-free-name-at? (& arms) name bound 0))

(define (tc-match-arms-set-free-name-at?
  [arms : (& arms AstMatchArmList)]
  [name : String]
  [bound : TcStringList]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    false
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (let
          [body : AstExpr (ast-node-get body-box)]
          (or
            (tc-expr-sets-free-name?
              body
              name
              (tc-pattern-add-bound-names pattern bound))
            (tc-match-arms-set-free-name-at? arms name bound (+ index 1))))])))

(define (tc-expr-sets-free-name?
  [expr : AstExpr]
  [name : String]
  [bound : TcStringList]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExpr.Literal _) false]
    [(AstExpr.Var _) false]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (or
          (tc-expr-sets-free-name? left name bound)
          (tc-expr-sets-free-name? right name bound)))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (or
          (tc-expr-sets-free-name? func name bound)
          (tc-expr-list-sets-free-name? args name bound)))]
    [(AstExpr.BracketClause items)
      (tc-expr-list-sets-free-name? items name bound)]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (or
          (tc-expr-sets-free-name? cond name bound)
          (tc-expr-sets-free-name? then-branch name bound)
          (tc-expr-sets-free-name? else-branch name bound)))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (or
              (tc-let-binding-list-sets-free-name? bindings name bound)
              (tc-expr-sets-free-name?
                body
                name
                (tc-let-binding-list-add-bound-names bindings bound))))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (tc-expr-sets-free-name?
              body
              name
              (tc-param-list-add-bound-names params bound)))])]
    [(AstExpr.Tuple exprs) (tc-expr-list-sets-free-name? exprs name bound)]
    [(AstExpr.TupleRef tuple-box _)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        (tc-expr-sets-free-name? tuple name bound))]
    [(AstExpr.Array exprs) (tc-expr-list-sets-free-name? exprs name bound)]
    [(AstExpr.MakeArray _ len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (tc-expr-sets-free-name? len name bound))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (or
          (tc-expr-sets-free-name? array name bound)
          (tc-expr-sets-free-name? index name bound)))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (tc-expr-sets-free-name? array name bound)
          (tc-expr-sets-free-name? index name bound)
          (tc-expr-sets-free-name? value name bound)))]
    [(AstExpr.ArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (tc-expr-sets-free-name? array name bound)
          (tc-expr-sets-free-name? value name bound)))]
    [(AstExpr.StringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (or
          (tc-expr-sets-free-name? str name bound)
          (tc-expr-sets-free-name? index name bound)))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (or
          (tc-expr-sets-free-name? cond name bound)
          (tc-expr-sets-free-name? body name bound)))]
    [(AstExpr.Begin exprs) (tc-expr-list-sets-free-name? exprs name bound)]
    [(AstExpr.Unsafe exprs) (tc-expr-list-sets-free-name? exprs name bound)]
    [(AstExpr.Set var-name value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (or
          (and
            (string.eq (intern-str var-name) name)
            (not (tc-string-list-contains bound name)))
          (tc-expr-sets-free-name? value name bound)))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExpr.Borrow _ _ place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (tc-expr-sets-free-name? place name bound))]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExpr.BoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (tc-expr-sets-free-name? inner name bound)
          (tc-expr-sets-free-name? value name bound)))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            (or
              (tc-expr-sets-free-name? scrutinee name bound)
              (tc-match-arms-set-free-name? arms name bound)))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach index _ start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (or
              (tc-expr-sets-free-name? start name bound)
              (tc-expr-sets-free-name? end name bound)
              (tc-expr-sets-free-name?
                body
                name
                (tc-string-list-add bound (intern-str index)))))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce _ index _ start-box end-box init-box value-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            (or
              (tc-expr-sets-free-name? start name bound)
              (tc-expr-sets-free-name? end name bound)
              (tc-expr-sets-free-name? init name bound)
              (tc-expr-sets-free-name?
                value
                name
                (tc-string-list-add bound (intern-str index)))))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            _
            index
            _
            start-box
            end-box
            prefix
            _
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            [value-bound : TcStringList
              (tc-string-list-add bound (intern-str index))]
            [body-bound : TcStringList
              (tc-string-list-add value-bound (intern-str prefix))]
            (or
              (tc-expr-sets-free-name? start name bound)
              (tc-expr-sets-free-name? end name bound)
              (tc-expr-sets-free-name? init name bound)
              (tc-expr-sets-free-name? value name value-bound)
              (tc-expr-sets-free-name? body name body-bound)))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (or
          (tc-expr-sets-free-name? value name bound)
          (tc-expr-sets-free-name? lane name bound)))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (or
          (tc-expr-sets-free-name? value name bound)
          (tc-expr-sets-free-name? lane name bound)))]
    [(AstExpr.StructGet receiver-box _)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (tc-expr-sets-free-name? receiver name bound))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (tc-expr-sets-free-name? receiver name bound)
          (tc-expr-sets-free-name? value name bound)))]
    [(AstExpr.WithRegion _ body) (tc-expr-list-sets-free-name? body name bound)]
    [(AstExpr.WithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (or
          (tc-expr-sets-free-name? scratch name bound)
          (tc-expr-list-sets-free-name? body name bound)))]
    [(AstExpr.WithScratch body) (tc-expr-list-sets-free-name? body name bound)]
    [(AstExpr.InArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (or
          (tc-expr-sets-free-name? arena name bound)
          (tc-expr-list-sets-free-name? body name bound)))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (or
            (tc-resource-binding-list-sets-free-name? bindings name bound)
            (tc-expr-list-sets-free-name?
              body
              name
              (tc-resource-binding-list-add-bound-names bindings bound)))])]
    [(AstExpr.TypeLiteral _) false]
    [(AstExpr.Init _) false]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExpr.Quote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExpr.Quasiquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExpr.Unquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExpr.UnquoteSplicing inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExpr.Return inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExpr.Break) false]
    [(AstExpr.Continue) false]
    [(AstExpr.PtrNull _) false]
    [(AstExpr.PtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-sets-free-name? inner name bound))]
    [(AstExpr.PtrAddrOf _) false]
    [(AstExpr.PtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-expr-sets-free-name? ptr name bound))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (tc-expr-sets-free-name? ptr name bound)
          (tc-expr-sets-free-name? value name bound)))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (or
          (tc-expr-sets-free-name? ptr name bound)
          (tc-expr-sets-free-name? offset name bound)))]
    [(AstExpr.PtrCast ptr-box _)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-expr-sets-free-name? ptr name bound))]
    [(AstExpr.PtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-expr-sets-free-name? ptr name bound))]
    [(AstExpr.IntToPtr value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-expr-sets-free-name? value name bound))]
    [(AstExpr.StringData str-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        (tc-expr-sets-free-name? str name bound))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (or
          (tc-expr-sets-free-name? ptr name bound)
          (tc-expr-sets-free-name? len name bound)))]
    [(AstExpr.ArrayData array-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-expr-sets-free-name? array name bound))]
    [(AstExpr.BinaryData _) false]
    [(AstExpr.SpmdProgramIndex) false]
    [(AstExpr.SpmdProgramCount) false]
    [(AstExpr.ProgramArgc) false]
    [(AstExpr.ProgramArgv) false]
    [(AstExpr.ProgramEnvp) false]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or
          (tc-expr-sets-free-name? leaf name bound)
          (tc-expr-sets-free-name? subleaf name bound)))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or
          (tc-expr-sets-free-name? leaf name bound)
          (tc-expr-sets-free-name? subleaf name bound)))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or
          (tc-expr-sets-free-name? leaf name bound)
          (tc-expr-sets-free-name? subleaf name bound)))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (or
          (tc-expr-sets-free-name? leaf name bound)
          (tc-expr-sets-free-name? subleaf name bound)))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (tc-expr-sets-free-name? index name bound))]
    [(AstExpr.Syscall args) (tc-expr-list-sets-free-name? args name bound)]))

(define (tc-name-is-free-cleanup-owner?
  [owners : TcStringList]
  [name : String]
  [bound : TcStringList]) : bool
  (and
    (tc-string-list-contains owners name)
    (not (tc-string-list-contains bound name))))

(define (tc-expr-list-result-uses-cleanup-owner?
  [exprs : AstExprList]
  [owners : TcStringList]
  [bound : TcStringList]) : bool
  (if (ast-expr-list-empty? (& exprs))
    false
    (tc-expr-result-uses-cleanup-owner?
      (ast-node-get
        (ast-expr-list-get (& exprs) (- (struct-get (& exprs) len) 1) 0))
      owners
      bound)))

(define (tc-expr-list-any-result-uses-cleanup-owner?
  [exprs : AstExprList]
  [owners : TcStringList]
  [bound : TcStringList]) : bool
  (tc-expr-list-any-result-uses-cleanup-owner-at? (& exprs) 0 owners bound))

(define (tc-expr-list-any-result-uses-cleanup-owner-at?
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [owners : TcStringList]
  [bound : TcStringList]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (tc-expr-result-uses-cleanup-owner?
        (ast-node-get (ast-expr-list-get exprs index 0))
        owners
        bound)
      (tc-expr-list-any-result-uses-cleanup-owner-at?
        exprs
        (+ index 1)
        owners
        bound))))

(define (tc-match-arms-result-use-cleanup-owner?
  [arms : AstMatchArmList]
  [owners : TcStringList]
  [bound : TcStringList]) : bool
  (tc-match-arms-result-use-cleanup-owner-at? (& arms) owners bound 0))

(define (tc-match-arms-result-use-cleanup-owner-at?
  [arms : (& arms AstMatchArmList)]
  [owners : TcStringList]
  [bound : TcStringList]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    false
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (let
          [body : AstExpr (ast-node-get body-box)]
          (or
            (tc-expr-result-uses-cleanup-owner?
              body
              owners
              (tc-pattern-add-bound-names pattern bound))
            (tc-match-arms-result-use-cleanup-owner-at?
              arms
              owners
              bound
              (+ index 1))))])))

(define (tc-expr-result-uses-cleanup-owner?
  [expr : AstExpr]
  [owners : TcStringList]
  [bound : TcStringList]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-result-uses-cleanup-owner? inner owners bound))]
    [(AstExpr.Var name)
      (tc-name-is-free-cleanup-owner? owners (intern-str name) bound)]
    [(AstExpr.If _ then-branch-box else-branch-box)
      (let
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (or
          (tc-expr-result-uses-cleanup-owner? then-branch owners bound)
          (tc-expr-result-uses-cleanup-owner? else-branch owners bound)))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (tc-expr-result-uses-cleanup-owner?
              body
              owners
              (tc-let-binding-list-add-bound-names bindings bound)))])]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match _ arms)
          (tc-match-arms-result-use-cleanup-owner? arms owners bound)])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach index _ _ _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (tc-expr-result-uses-cleanup-owner?
              body
              owners
              (tc-string-list-add bound (intern-str index))))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce _ index _ _ _ _ value-box)
          (let
            [value : AstExpr (ast-node-get value-box)]
            (tc-expr-result-uses-cleanup-owner?
              value
              owners
              (tc-string-list-add bound (intern-str index))))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan _ index _ _ _ prefix _ _ value-box body-box)
          (let
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            [value-bound : TcStringList
              (tc-string-list-add bound (intern-str index))]
            [body-bound : TcStringList
              (tc-string-list-add value-bound (intern-str prefix))]
            (or
              (tc-expr-result-uses-cleanup-owner? value owners value-bound)
              (tc-expr-result-uses-cleanup-owner? body owners body-bound)))])]
    [(AstExpr.SpmdBroadcast value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-expr-result-uses-cleanup-owner? value owners bound))]
    [(AstExpr.SpmdShuffle value-box _)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-expr-result-uses-cleanup-owner? value owners bound))]
    [(AstExpr.Begin exprs)
      (tc-expr-list-result-uses-cleanup-owner? exprs owners bound)]
    [(AstExpr.Unsafe exprs)
      (tc-expr-list-result-uses-cleanup-owner? exprs owners bound)]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-result-uses-cleanup-owner? inner owners bound))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-result-uses-cleanup-owner? inner owners bound))]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-result-uses-cleanup-owner? inner owners bound))]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-result-uses-cleanup-owner? inner owners bound))]
    [(AstExpr.Return inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-result-uses-cleanup-owner? inner owners bound))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-result-uses-cleanup-owner? inner owners bound))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-expr-result-uses-cleanup-owner? inner owners bound))]
    [(AstExpr.BoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (or
          (tc-expr-result-uses-cleanup-owner? inner owners bound)
          (tc-expr-result-uses-cleanup-owner? value owners bound)))]
    [(AstExpr.WithRegion _ body)
      (tc-expr-list-result-uses-cleanup-owner? body owners bound)]
    [(AstExpr.WithEscape _ body)
      (tc-expr-list-result-uses-cleanup-owner? body owners bound)]
    [(AstExpr.WithScratch body)
      (tc-expr-list-result-uses-cleanup-owner? body owners bound)]
    [(AstExpr.InArena _ body)
      (tc-expr-list-result-uses-cleanup-owner? body owners bound)]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (tc-expr-list-result-uses-cleanup-owner?
            body
            owners
            (tc-resource-binding-list-add-bound-names bindings bound))])]
    [_ false]))

(define (tc-expr-result-uses-active-cleanup-owner?
  [env : TcTypeEnv]
  [expr : AstExpr]) : bool
  (tc-expr-result-uses-cleanup-owner?
    expr
    (tc-active-cleanup-owners env)
    TcStringList.Nil))

(define (tc-expr-list-any-result-uses-active-cleanup-owner?
  [env : TcTypeEnv]
  [exprs : AstExprList]) : bool
  (tc-expr-list-any-result-uses-cleanup-owner?
    exprs
    (tc-active-cleanup-owners env)
    TcStringList.Nil))

(define (tc-ensure-cleanup-resource-not-let-bound
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [ty : AstType]) : ResultTcUnit
  (if (or
    (tc-expr-result-uses-active-cleanup-owner? env expr)
    (tc-cleanup-owning-aggregate-type? ctx ty))
    (ResultTcUnit.Err
      "typecheck: ordinary let cannot own cleanup-required resource; use with")
    ResultTcUnit.Ok))

(define (tc-ensure-cleanup-resource-not-transferred
  [env : TcTypeEnv]
  [expr : AstExpr]) : ResultTcUnit
  (if (tc-expr-result-uses-active-cleanup-owner? env expr)
    (ResultTcUnit.Err
      "typecheck: cleanup-required resource already has a cleanup owner")
    ResultTcUnit.Ok))

(define (tc-ensure-cleanup-resource-not-stored-expr
  [env : TcTypeEnv]
  [expr : AstExpr]) : ResultTcUnit
  (if (tc-expr-result-uses-active-cleanup-owner? env expr)
    (ResultTcUnit.Err
      "typecheck: cannot store cleanup-required resource in ordinary aggregate")
    ResultTcUnit.Ok))

(define (tc-ensure-cleanup-resource-not-stored-list
  [env : TcTypeEnv]
  [exprs : AstExprList]) : ResultTcUnit
  (if (tc-expr-list-any-result-uses-active-cleanup-owner? env exprs)
    (ResultTcUnit.Err
      "typecheck: cannot store cleanup-required resource in ordinary aggregate")
    ResultTcUnit.Ok))

(define (tc-ensure-cleanup-resource-not-assigned
  [env : TcTypeEnv]
  [expr : AstExpr]) : ResultTcUnit
  (if (tc-expr-result-uses-active-cleanup-owner? env expr)
    (ResultTcUnit.Err
      "typecheck: cannot store cleanup-required resource in longer-lived binding")
    ResultTcUnit.Ok))

(define (tc-check-lambda-region-captures-scan-root
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [body : AstExpr]
  [allow-immutable-reference-captures : bool]) : ResultTcUnit
  (match env
    [(TcTypeEnv.Nil) ResultTcUnit.Ok]
    [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
      (if scan-through
        (tc-check-lambda-region-captures-scan-root
          root
          (box-get rest)
          bound
          body
          allow-immutable-reference-captures)
        ResultTcUnit.Ok)]
    [(TcTypeEnv.Bind key ty rest)
      (let
        [name : String (intern-str key)]
        (cond
          [(or
              (= key (tc-region-marker-id))
              (= key (tc-default-boundary-id))
              (tc-cleanup-owner-marker-entry? key ty)
              (tc-ordinary-arena-owner-marker-entry? key ty)
              (tc-atomic-arena-owner-marker-entry? key ty))
            (tc-check-lambda-region-captures-scan-root
              root
              (box-get rest)
              bound
              body
              allow-immutable-reference-captures)]
          [(not (tc-expr-uses-free-name? body name bound))
            (tc-check-lambda-region-captures-scan-root
              root
              (box-get rest)
              bound
              body
              allow-immutable-reference-captures)]
          [(tc-expr-sets-free-name? body name bound)
            (ResultTcUnit.Err
              "typecheck: lambda cannot assign captured binding")]
          [(tc-cleanup-owner-active? root name)
            (ResultTcUnit.Err
              "typecheck: lambda cannot capture cleanup-required resource; resource value would escape")]
          [(tc-type-contains-mut-reference? ty)
            (ResultTcUnit.Err
              "typecheck: lambda cannot capture mutable reference; reference value would escape lexical scope")]
          [(tc-type-contains-reference? ty)
            (if allow-immutable-reference-captures
              (tc-check-lambda-region-captures-scan-root
                root
                (box-get rest)
                bound
                body
                allow-immutable-reference-captures)
              (ResultTcUnit.Err
                "typecheck: lambda cannot capture immutable reference; reference value would escape lexical scope"))]
          [(tc-type-contains-any-region ty)
            (if (tc-type-regions-all-atomic-arena-owners? root ty)
              (tc-check-lambda-region-captures-scan-root
                root
                (box-get rest)
                bound
                body
                allow-immutable-reference-captures)
              (ResultTcUnit.Err
                "typecheck: lambda cannot capture region-tagged value; region value would escape"))]
          [else
            (tc-check-lambda-region-captures-scan-root
              root
              (box-get rest)
              bound
              body
              allow-immutable-reference-captures)]))]))

(define (tc-check-lambda-region-captures-scan
  [env : TcTypeEnv]
  [bound : TcStringList]
  [body : AstExpr]
  [allow-immutable-reference-captures : bool]) : ResultTcUnit
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
    (match env
      [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
        (tc-check-lambda-region-captures-scan-root
          env
          (box-get rest)
          bound
          body
          allow-immutable-reference-captures)]
      [_
        (tc-check-lambda-region-captures-scan-root
          env
          env
          bound
          body
          allow-immutable-reference-captures)])))

(define (tc-check-lambda-region-captures
  [env : TcTypeEnv]
  [params : AstParamList]
  [body : AstExpr]) : ResultTcUnit
  (tc-check-lambda-region-captures-scan
    env
    (tc-param-bound-names params)
    body
    false))

(define (tc-check-lambda-region-captures-allow-refs
  [env : TcTypeEnv]
  [params : AstParamList]
  [body : AstExpr]) : ResultTcUnit
  (tc-check-lambda-region-captures-scan
    env
    (tc-param-bound-names params)
    body
    true))

(define (tc-context-program [ctx : TcContext]) : AstProgram
  (match ctx
    [(TcContext program _ _ _ _) program]))

(define (tc-context-symbols [ctx : TcContext]) : CompilerSymbols
  (match ctx
    [(TcContext _ symbols _ _ _) symbols]))

(define (tc-context-registries [ctx : TcContext]) : CompilerRegistries
  (match ctx
    [(TcContext _ _ registries _ _) registries]))

(define (tc-program-enum-variants-list
  [decls : AstDeclList]
  [enum-name : String]) : ResultAstVariantDefList
  (tc-program-enum-variants-list-in-module decls enum-name ""))

(define (tc-program-enum-variants-list-in-module
  [decls : AstDeclList]
  [enum-name : String]
  [module : String]) : ResultAstVariantDefList
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil)
      (ResultAstVariantDefList.Err
        (string.append "typecheck: unknown enum " enum-name))]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        (match decl
          [(AstDecl.Module next-module)
            (tc-program-enum-variants-list-in-module
              rest
              enum-name
              (intern-str next-module))]
          [(AstDecl.DefEnum name _ variants)
            (if (or
              (string.eq (intern-str name) enum-name)
              (string.eq
                (compiler-symbol-module-key module (intern-str name))
                enum-name))
              (ResultAstVariantDefList.Ok variants)
              (tc-program-enum-variants-list-in-module rest enum-name module))]
          [(AstDecl.DefEnumLifetimes name _ _ variants)
            (if (or
              (string.eq (intern-str name) enum-name)
              (string.eq
                (compiler-symbol-module-key module (intern-str name))
                enum-name))
              (ResultAstVariantDefList.Ok variants)
              (tc-program-enum-variants-list-in-module rest enum-name module))]
          [(AstDecl.ComptimeDecl _ template-box)
            (let
              [template : AstDecl (box-get template-box)]
              (match template
                [(AstDecl.DefEnum name _ variants)
                  (if (or
                    (string.eq (intern-str name) enum-name)
                    (string.eq
                      (compiler-symbol-module-key module (intern-str name))
                      enum-name))
                    (ResultAstVariantDefList.Ok variants)
                    (tc-program-enum-variants-list-in-module
                      rest
                      enum-name
                      module))]
                [(AstDecl.DefEnumLifetimes name _ _ variants)
                  (if (or
                    (string.eq (intern-str name) enum-name)
                    (string.eq
                      (compiler-symbol-module-key module (intern-str name))
                      enum-name))
                    (ResultAstVariantDefList.Ok variants)
                    (tc-program-enum-variants-list-in-module
                      rest
                      enum-name
                      module))]
                [_
                  (tc-program-enum-variants-list-in-module
                    rest
                    enum-name
                    module)]))]
          [_ (tc-program-enum-variants-list-in-module rest enum-name module)]))]))

(define (tc-program-enum-variants [program : AstProgram] [enum-name : String]) : ResultAstVariantDefList
  (match program
    [(AstProgram.Program decls-box)
      (let
        [decls : AstDeclList (box-get decls-box)]
        (tc-program-enum-variants-list decls enum-name))]))

(define (tc-context-enum-variants [ctx : TcContext] [enum-name : String]) : ResultAstVariantDefList
  (let
    [handle : i64
      (compiler-symbols-lookup-type-or
        (tc-context-symbols ctx)
        enum-name
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (if (=
        (compiler-symbol-handle-kind handle)
        (compiler-symbol-kind-defenum))
        (match (compiler-symbols-decl-at-index
          (tc-context-symbols ctx)
          (compiler-symbol-handle-index handle))
          [(ResultAstDecl.Ok decl)
            (match decl
              [(AstDecl.DefEnum _ _ variants)
                (ResultAstVariantDefList.Ok variants)]
              [(AstDecl.DefEnumLifetimes _ _ _ variants)
                (ResultAstVariantDefList.Ok variants)]
              [_
                (ResultAstVariantDefList.Err
                  (string.append "typecheck: unknown enum " enum-name))])]
          [(ResultAstDecl.Err message) (ResultAstVariantDefList.Err message)])
        (ResultAstVariantDefList.Err
          (string.append "typecheck: unknown enum " enum-name)))
      (tc-program-enum-variants (tc-context-program ctx) enum-name))))

(define (tc-layout-info-size [info : TcLayoutInfo]) : i64
  (match info
    [(TcLayoutInfo size _) size]))

(define (tc-layout-info-align [info : TcLayoutInfo]) : i64
  (match info
    [(TcLayoutInfo _ align) align]))

(define (tc-repr-c-layout-size [layout : TcReprCLayout]) : i64
  (match layout
    [(TcReprCLayout.Layout size _ _) size]))

(define (tc-repr-c-layout-align [layout : TcReprCLayout]) : i64
  (match layout
    [(TcReprCLayout.Layout _ align _) align]))

(define (tc-repr-c-layout-fields [layout : TcReprCLayout]) : TcReprCFieldLayoutList
  (match layout
    [(TcReprCLayout.Layout _ _ fields) fields]))

(define (tc-repr-c-field-layout-name [field : TcReprCFieldLayout]) : String
  (match field
    [(TcReprCFieldLayout.Field name _ _) name]))

(define (tc-repr-c-field-layout-type [field : TcReprCFieldLayout]) : AstType
  (match field
    [(TcReprCFieldLayout.Field _ ty _) ty]))

(define (tc-repr-c-field-layout-offset [field : TcReprCFieldLayout]) : i64
  (match field
    [(TcReprCFieldLayout.Field _ _ offset) offset]))

(define (tc-repr-c-layout-field-offset
  [fields : TcReprCFieldLayoutList]
  [name : String]) : i64
  (match fields
    [(TcReprCFieldLayoutList.Nil) -1]
    [(TcReprCFieldLayoutList.Cons field rest)
      (begin
        (cfg compile-profile (tc-lp-note 1))
        (if (string.eq (tc-repr-c-field-layout-name field) name)
          (tc-repr-c-field-layout-offset field)
          (tc-repr-c-layout-field-offset (box-get rest) name)))]))

(define (tc-inline-field-layout-name [field : TcInlineFieldLayout]) : String
  (match field
    [(TcInlineFieldLayout.Field name _ _) name]))

(define (tc-inline-field-layout-type [field : TcInlineFieldLayout]) : AstType
  (match field
    [(TcInlineFieldLayout.Field _ ty _) ty]))

(define (tc-inline-field-layout-offset [field : TcInlineFieldLayout]) : i64
  (match field
    [(TcInlineFieldLayout.Field _ _ offset) offset]))

(define (tc-inline-field-layout-list-offset
  [fields : TcInlineFieldLayoutList]
  [name : String]) : i64
  (match fields
    [(TcInlineFieldLayoutList.Nil) -1]
    [(TcInlineFieldLayoutList.Cons field rest)
      (begin
        (cfg compile-profile (tc-lp-note 3))
        (if (string.eq (tc-inline-field-layout-name field) name)
          (tc-inline-field-layout-offset field)
          (tc-inline-field-layout-list-offset (box-get rest) name)))]))

;; #2601/#2855: register-resident aggregate eightbytes may be INTEGER (the
;; existing word-class data) or SSE. SSE admits exact aligned f64 fields and
;; packed f32 fields that share an eightbyte only with other SSE fields. Mixed
;; integer/float sub-word eightbytes intentionally stay memory-backed.
(define (tc-sse-eightbyte-field? [ty : AstType] [offset : i64]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.F64) (= (% offset 8) 0)]
    [(AstType.F32) (= (% offset 4) 0)]
    [_ false]))

(define (tc-register-field-class [ty : AstType] [offset : i64]) : i64
  (if (tc-word-class-type? ty)
    0
    (if (tc-sse-eightbyte-field? ty offset)
      1
      2)))

(define (tc-register-field-size [ty : AstType]) : i64
  (match (tc-type-strip-region ty)
    [(AstType.I64) 8]
    [(AstType.U64) 8]
    [(AstType.F64) 8]
    [(AstType.I32) 4]
    [(AstType.U32) 4]
    [(AstType.F32) 4]
    [(AstType.I16) 2]
    [(AstType.U16) 2]
    [(AstType.I8) 1]
    [(AstType.U8) 1]
    [(AstType.Bool) 1]
    [(AstType.Char) 1]
    [(AstType.Ptr _) 8]
    [(AstType.MutPtr _) 8]
    [_ 8]))

;; #2386: true when every struct field is word-class, so the aggregate can be
;; packed into general-purpose register words instead of a memory slot.
(define (tc-inline-fields-all-word-class? [fields : TcInlineFieldLayoutList]) : bool
  (match fields
    [(TcInlineFieldLayoutList.Nil) true]
    [(TcInlineFieldLayoutList.Cons field rest)
      (if (tc-word-class-type? (tc-inline-field-layout-type field))
        (tc-inline-fields-all-word-class? (box-get rest))
        false)]))

;; #2601/#2855: true when every struct field can be assigned to a supported
;; register eightbyte class and every occupied eightbyte has a single class.
;; This preserves every existing INTEGER case, exact f64 SSE eightbytes, and
;; homogeneous packed f32 SSE eightbytes while rejecting mixed int/float words.
(define (tc-inline-field-overlaps-word?
  [field : TcInlineFieldLayout]
  [word-index : i64]) : bool
  (let
    [offset : i64 (tc-inline-field-layout-offset field)]
    [size : i64 (tc-register-field-size (tc-inline-field-layout-type field))]
    [word-base : i64 (* word-index 8)]
    (and (< offset (+ word-base 8)) (> (+ offset size) word-base))))

(define (tc-inline-fields-word-register-class
  [fields : TcInlineFieldLayoutList]
  [word-index : i64]
  [found : i64]) : i64
  (match fields
    [(TcInlineFieldLayoutList.Nil) found]
    [(TcInlineFieldLayoutList.Cons field rest)
      (if (tc-inline-field-overlaps-word? field word-index)
        (let
          [class : i64
            (tc-register-field-class
              (tc-inline-field-layout-type field)
              (tc-inline-field-layout-offset field))]
          (cond
            [(= class 2) 2]
            [(= found -1)
              (tc-inline-fields-word-register-class
                (box-get rest)
                word-index
                class)]
            [(= found class)
              (tc-inline-fields-word-register-class
                (box-get rest)
                word-index
                found)]
            [else 2]))
        (tc-inline-fields-word-register-class (box-get rest) word-index found))]))

(define (tc-inline-fields-all-register-class?
  [fields : TcInlineFieldLayoutList]) : bool
  (and
    (< (tc-inline-fields-word-register-class fields 0 -1) 2)
    (< (tc-inline-fields-word-register-class fields 1 -1) 2)))

;; #2386: true when every payload field of a variant is word-class -- so a 16-byte
;; enum (tag in word0, the single word-class payload in word1) can be carried
;; register-resident.
(define (tc-inline-payloads-all-word-class?
  [payloads : TcInlinePayloadLayoutList]) : bool
  (match payloads
    [(TcInlinePayloadLayoutList.Nil) true]
    [(TcInlinePayloadLayoutList.Cons payload rest)
      (match payload
        [(TcInlinePayloadLayout.Payload _ ty _)
          (if (tc-word-class-type? ty)
            (tc-inline-payloads-all-word-class? (box-get rest))
            false)])]))

(define (tc-register-payload-class [payload : TcInlinePayloadLayout]) : i64
  (match payload
    [(TcInlinePayloadLayout.Payload _ ty offset)
      (tc-register-field-class ty offset)]))

;; Return -1 for an empty payload list, 0 for INTEGER, 1 for SSE, and 2 when the
;; payload fields cannot share one supported register eightbyte class.
(define (tc-inline-payloads-register-class
  [payloads : TcInlinePayloadLayoutList]
  [found : i64]) : i64
  (match payloads
    [(TcInlinePayloadLayoutList.Nil) found]
    [(TcInlinePayloadLayoutList.Cons payload rest)
      (let
        [class : i64 (tc-register-payload-class payload)]
        (cond
          [(= class 2) 2]
          [(= found -1)
            (tc-inline-payloads-register-class (box-get rest) class)]
          [(= found class)
            (tc-inline-payloads-register-class (box-get rest) found)]
          [else 2]))]))

(define (tc-inline-enum-register-payload-class
  [variants : TcInlineVariantLayoutList]
  [found : i64]) : i64
  (match variants
    [(TcInlineVariantLayoutList.Nil) found]
    [(TcInlineVariantLayoutList.Cons variant rest)
      (match variant
        [(TcInlineVariantLayout.Variant _ _ _ payloads)
          (let
            [class : i64 (tc-inline-payloads-register-class payloads -1)]
            (cond
              [(= class 2) 2]
              [(= class -1)
                (tc-inline-enum-register-payload-class (box-get rest) found)]
              [(= found -1)
                (tc-inline-enum-register-payload-class (box-get rest) class)]
              [(= found class)
                (tc-inline-enum-register-payload-class (box-get rest) found)]
              [else 2]))])]))

(define (tc-inline-enum-payloads-all-register-class?
  [variants : TcInlineVariantLayoutList]) : bool
  (< (tc-inline-enum-register-payload-class variants -1) 2))

(define (tc-inline-enum-payloads-all-word-class?
  [variants : TcInlineVariantLayoutList]) : bool
  (match variants
    [(TcInlineVariantLayoutList.Nil) true]
    [(TcInlineVariantLayoutList.Cons variant rest)
      (match variant
        [(TcInlineVariantLayout.Variant _ _ _ payloads)
          (if (tc-inline-payloads-all-word-class? payloads)
            (tc-inline-enum-payloads-all-word-class? (box-get rest))
            false)])]))

(define (tc-inline-payload-layout-list-empty?
  [payloads : TcInlinePayloadLayoutList]) : bool
  (match payloads
    [(TcInlinePayloadLayoutList.Nil) true]
    [(TcInlinePayloadLayoutList.Cons _ _) false]))

(define (tc-inline-enum-variants-tag-only?
  [variants : TcInlineVariantLayoutList]) : bool
  (match variants
    [(TcInlineVariantLayoutList.Nil) true]
    [(TcInlineVariantLayoutList.Cons variant rest)
      (match variant
        [(TcInlineVariantLayout.Variant _ size _ payloads)
          (if (and (= size 8) (tc-inline-payload-layout-list-empty? payloads))
            (tc-inline-enum-variants-tag-only? (box-get rest))
            false)])]))

(define (tc-inline-enum-layout-tag-only?
  [size : i64]
  [variants : TcInlineVariantLayoutList]) : bool
  (and (= size 8) (tc-inline-enum-variants-tag-only? variants)))

(define (tc-inline-aggregate-layout-tag-only-enum?
  [layout : TcInlineAggregateLayout]) : bool
  (match layout
    [(TcInlineAggregateLayout.Enum size _ variants)
      (tc-inline-enum-layout-tag-only? size variants)]
    [(TcInlineAggregateLayout.Struct _ _ _) false]))

(define (tc-inline-payload-layout-index [payload : TcInlinePayloadLayout]) : i64
  (match payload
    [(TcInlinePayloadLayout.Payload index _ _) index]))

(define (tc-inline-payload-layout-type [payload : TcInlinePayloadLayout]) : AstType
  (match payload
    [(TcInlinePayloadLayout.Payload _ ty _) ty]))

(define (tc-inline-payload-layout-offset [payload : TcInlinePayloadLayout]) : i64
  (match payload
    [(TcInlinePayloadLayout.Payload _ _ offset) offset]))

(define (tc-inline-payload-layout-list-offset
  [payloads : TcInlinePayloadLayoutList]
  [index : i64]) : i64
  (match payloads
    [(TcInlinePayloadLayoutList.Nil) -1]
    [(TcInlinePayloadLayoutList.Cons payload rest)
      (begin
        (cfg compile-profile (tc-lp-note 5))
        (if (= (tc-inline-payload-layout-index payload) index)
          (tc-inline-payload-layout-offset payload)
          (tc-inline-payload-layout-list-offset (box-get rest) index)))]))

(define (tc-inline-variant-layout-name [variant : TcInlineVariantLayout]) : String
  (match variant
    [(TcInlineVariantLayout.Variant name _ _ _) name]))

(define (tc-inline-variant-layout-size [variant : TcInlineVariantLayout]) : i64
  (match variant
    [(TcInlineVariantLayout.Variant _ size _ _) size]))

(define (tc-inline-variant-layout-align [variant : TcInlineVariantLayout]) : i64
  (match variant
    [(TcInlineVariantLayout.Variant _ _ align _) align]))

(define (tc-inline-variant-layout-payloads [variant : TcInlineVariantLayout]) : TcInlinePayloadLayoutList
  (match variant
    [(TcInlineVariantLayout.Variant _ _ _ payloads) payloads]))

(define (tc-inline-variant-layout-member-name [name : String]) : String
  (let
    [source : String
      (if (tc-name-qualified? name)
        (tc-qualified-name-base name)
        name)]
    [i : i64 0]
    [last-dot : i64 -1]
    [n : i64 (string.string-length source)]
    (begin
      (while (< i n)
        (begin
          (if (string.char-eq (string.string-ref source i) '.')
            (set! last-dot i)
            unit)
          (set! i (+ i 1))))
      (if (and (>= last-dot 0) (< last-dot (- n 1)))
        (string.substring source (+ last-dot 1) (- n (+ last-dot 1)))
        source))))

(define (tc-inline-variant-layout-name-matches?
  [stored : String]
  [name : String]) : bool
  (or
    (string.eq stored name)
    (string.eq
      (tc-inline-variant-layout-member-name stored)
      (tc-inline-variant-layout-member-name name))))

(define (tc-inline-variant-layout-list-size-exact
  [variants : TcInlineVariantLayoutList]
  [name : String]) : i64
  (match variants
    [(TcInlineVariantLayoutList.Nil) -1]
    [(TcInlineVariantLayoutList.Cons variant rest)
      (begin
        (cfg compile-profile (tc-lp-note 7))
        (if (string.eq (tc-inline-variant-layout-name variant) name)
          (tc-inline-variant-layout-size variant)
          (tc-inline-variant-layout-list-size-exact (box-get rest) name)))]))

(define (tc-inline-variant-layout-list-size-fallback
  [variants : TcInlineVariantLayoutList]
  [name : String]) : i64
  (match variants
    [(TcInlineVariantLayoutList.Nil) -1]
    [(TcInlineVariantLayoutList.Cons variant rest)
      (begin
        (cfg compile-profile (tc-lp-note 7))
        (if (tc-inline-variant-layout-name-matches?
          (tc-inline-variant-layout-name variant)
          name)
          (tc-inline-variant-layout-size variant)
          (tc-inline-variant-layout-list-size-fallback (box-get rest) name)))]))

(define (tc-inline-variant-layout-list-size
  [variants : TcInlineVariantLayoutList]
  [name : String]) : i64
  (let
    [exact : i64 (tc-inline-variant-layout-list-size-exact variants name)]
    (if (>= exact 0)
      exact
      (tc-inline-variant-layout-list-size-fallback variants name))))

(define (tc-inline-variant-layout-list-payload-offset-exact
  [variants : TcInlineVariantLayoutList]
  [name : String]
  [index : i64]) : i64
  (match variants
    [(TcInlineVariantLayoutList.Nil) -1]
    [(TcInlineVariantLayoutList.Cons variant rest)
      (begin
        (cfg compile-profile (tc-lp-note 7))
        (if (string.eq (tc-inline-variant-layout-name variant) name)
          (tc-inline-payload-layout-list-offset
            (tc-inline-variant-layout-payloads variant)
            index)
          (tc-inline-variant-layout-list-payload-offset-exact
            (box-get rest)
            name
            index)))]))

(define (tc-inline-variant-layout-list-payload-offset-fallback
  [variants : TcInlineVariantLayoutList]
  [name : String]
  [index : i64]) : i64
  (match variants
    [(TcInlineVariantLayoutList.Nil) -1]
    [(TcInlineVariantLayoutList.Cons variant rest)
      (begin
        (cfg compile-profile (tc-lp-note 7))
        (if (tc-inline-variant-layout-name-matches?
          (tc-inline-variant-layout-name variant)
          name)
          (tc-inline-payload-layout-list-offset
            (tc-inline-variant-layout-payloads variant)
            index)
          (tc-inline-variant-layout-list-payload-offset-fallback
            (box-get rest)
            name
            index)))]))

(define (tc-inline-variant-layout-list-payload-offset
  [variants : TcInlineVariantLayoutList]
  [name : String]
  [index : i64]) : i64
  (let
    [exact : i64
      (tc-inline-variant-layout-list-payload-offset-exact variants name index)]
    (if (>= exact 0)
      exact
      (tc-inline-variant-layout-list-payload-offset-fallback
        variants
        name
        index))))

(define (tc-inline-aggregate-layout-size [layout : TcInlineAggregateLayout]) : i64
  (match layout
    [(TcInlineAggregateLayout.Struct size _ _) size]
    [(TcInlineAggregateLayout.Enum size _ _) size]))

(define (tc-inline-aggregate-layout-align [layout : TcInlineAggregateLayout]) : i64
  (match layout
    [(TcInlineAggregateLayout.Struct _ align _) align]
    [(TcInlineAggregateLayout.Enum _ align _) align]))

(define (tc-inline-aggregate-layout-field-offset
  [layout : TcInlineAggregateLayout]
  [name : String]) : i64
  (match layout
    [(TcInlineAggregateLayout.Struct _ _ fields)
      (tc-inline-field-layout-list-offset fields name)]
    [(TcInlineAggregateLayout.Enum _ _ _) -1]))

(define (tc-inline-aggregate-layout-variant-size
  [layout : TcInlineAggregateLayout]
  [name : String]) : i64
  (match layout
    [(TcInlineAggregateLayout.Struct _ _ _) -1]
    [(TcInlineAggregateLayout.Enum _ _ variants)
      (tc-inline-variant-layout-list-size variants name)]))

(define (tc-inline-aggregate-layout-variant-payload-offset
  [layout : TcInlineAggregateLayout]
  [name : String]
  [index : i64]) : i64
  (match layout
    [(TcInlineAggregateLayout.Struct _ _ _) -1]
    [(TcInlineAggregateLayout.Enum _ _ variants)
      (tc-inline-variant-layout-list-payload-offset variants name index)]))

(define (tc-align-up [n : i64] [align : i64]) : i64
  (if (<= align 1)
    n
    (* (/ (+ n (- align 1)) align) align)))

(define (tc-max-i64 [a : i64] [b : i64]) : i64
  (if (> a b)
    a
    b))

(define (tc-struct-decl [ctx : TcContext] [struct-name : String]) : ResultTcStructDecl
  (match ctx
    [(TcContext _ symbols _ _ _)
      (let
        [handle : i64
          (compiler-symbols-lookup-type-or
            symbols
            struct-name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? handle)
          (if (=
            (compiler-symbol-handle-kind handle)
            (compiler-symbol-kind-defstruct))
            (match (compiler-symbols-decl-at-index
              symbols
              (compiler-symbol-handle-index handle))
              [(ResultAstDecl.Ok decl)
                (match decl
                  [(AstDecl.DefStruct _ repr cleanup fields)
                    (ResultTcStructDecl.Ok (TcStructDecl repr cleanup fields))]
                  [(AstDecl.DefStructLifetimes _ _ repr cleanup fields)
                    (ResultTcStructDecl.Ok (TcStructDecl repr cleanup fields))]
                  [_
                    (ResultTcStructDecl.Err
                      "typecheck: struct symbol owner is not a struct")])]
              [(ResultAstDecl.Err message) (ResultTcStructDecl.Err message)])
            (ResultTcStructDecl.Err
              (string.append "typecheck: unknown struct " struct-name)))
          (ResultTcStructDecl.Err
            (string.append "typecheck: unknown struct " struct-name))))]))

(define (tc-enum-decl [ctx : TcContext] [enum-name : String]) : ResultTcEnumDecl
  (match ctx
    [(TcContext _ symbols _ _ _)
      (let
        [handle : i64
          (compiler-symbols-lookup-type-or
            symbols
            enum-name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? handle)
          (if (=
            (compiler-symbol-handle-kind handle)
            (compiler-symbol-kind-defenum))
            (match (compiler-symbols-decl-at-index
              symbols
              (compiler-symbol-handle-index handle))
              [(ResultAstDecl.Ok decl)
                (match decl
                  [(AstDecl.DefEnum _ cleanup variants)
                    (ResultTcEnumDecl.Ok (TcEnumDecl cleanup variants))]
                  [(AstDecl.DefEnumLifetimes _ _ cleanup variants)
                    (ResultTcEnumDecl.Ok (TcEnumDecl cleanup variants))]
                  [_
                    (ResultTcEnumDecl.Err
                      "typecheck: enum symbol owner is not an enum")])]
              [(ResultAstDecl.Err message) (ResultTcEnumDecl.Err message)])
            (ResultTcEnumDecl.Err
              (string.append "typecheck: unknown enum " enum-name)))
          (ResultTcEnumDecl.Err
            (string.append "typecheck: unknown enum " enum-name))))]))

(define (tc-inline-aggregate-cycle-stack-render [stack : TcStringList]) : String
  (match stack
    [(TcStringList.Nil) ""]
    [(TcStringList.Cons head rest)
      (let
        [tail : String (tc-inline-aggregate-cycle-stack-render (box-get rest))]
        (if (string.eq tail "")
          head
          (str_cat.str-cat tail " -> " head)))]))

(define (tc-inline-aggregate-cycle-path [stack : TcStringList] [name : String]) : String
  (let
    [prefix : String (tc-inline-aggregate-cycle-stack-render stack)]
    (if (string.eq prefix "")
      name
      (str_cat.str-cat prefix " -> " name))))

(define (tc-inline-aggregate-cycle-message
  [name : String]
  [stack : TcStringList]) : String
  (str_cat.str-cat
    "typecheck: inline aggregate layout cycle "
    (tc-inline-aggregate-cycle-path stack name)
    "; insert (Box "
    name
    ") at the recursive edge"))

(define (tc-inline-aggregate-type-list-finite-ok
  [ctx : TcContext]
  [types : AstTypeList]
  [stack : TcStringList]) : ResultTcUnit
  (tc-inline-aggregate-type-list-finite-ok-at ctx (& types) stack 0))

(define (tc-inline-aggregate-type-list-finite-ok-at
  [ctx : TcContext]
  [types : (& types AstTypeList)]
  [stack : TcStringList]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-type-list-len types))
    ResultTcUnit.Ok
    (match (tc-inline-aggregate-type-finite-ok
      ctx
      (tc-context-type-get
        ctx
        (ast-type-list-get types index (ast-type-id-fallback)))
      stack)
      [(ResultTcUnit.Ok)
        (tc-inline-aggregate-type-list-finite-ok-at ctx types stack (+ index 1))]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

(define (tc-inline-aggregate-fields-finite-ok
  [ctx : TcContext]
  [fields : AstFieldDefList]
  [stack : TcStringList]) : ResultTcUnit
  (tc-inline-aggregate-fields-finite-ok-at ctx (& fields) stack 0))

(define (tc-inline-aggregate-fields-finite-ok-at
  [ctx : TcContext]
  [fields : (& fields AstFieldDefList)]
  [stack : TcStringList]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get fields len))
    ResultTcUnit.Ok
    (match (ast-field-def-list-get fields index (ast-field-def-fallback))
      [(AstFieldDef.Def _ ty _)
        (match (tc-inline-aggregate-type-finite-ok ctx ty stack)
          [(ResultTcUnit.Ok)
            (tc-inline-aggregate-fields-finite-ok-at
              ctx
              fields
              stack
              (+ index 1))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])))

(define (tc-inline-aggregate-variants-finite-ok
  [ctx : TcContext]
  [variants : AstVariantDefList]
  [stack : TcStringList]) : ResultTcUnit
  (tc-inline-aggregate-variants-finite-ok-at ctx (& variants) stack 0))

(define (tc-inline-aggregate-variants-finite-ok-at
  [ctx : TcContext]
  [variants : (& variants AstVariantDefList)]
  [stack : TcStringList]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get variants len))
    ResultTcUnit.Ok
    (match (ast-variant-def-list-get variants index (ast-variant-def-fallback))
      [(AstVariantDef.Def _ fields _)
        (match (tc-inline-aggregate-type-list-finite-ok ctx fields stack)
          [(ResultTcUnit.Ok)
            (tc-inline-aggregate-variants-finite-ok-at
              ctx
              variants
              stack
              (+ index 1))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])))

(define (tc-inline-aggregate-nominal-finite-ok
  [ctx : TcContext]
  [name : String]
  [stack : TcStringList]) : ResultTcUnit
  (if (tc-string-list-contains stack name)
    (ResultTcUnit.Err (tc-inline-aggregate-cycle-message name stack))
    (let
      [handle : i64
        (compiler-symbols-lookup-type-or
          (tc-context-symbols ctx)
          name
          (compiler-symbols-missing-handle))]
      (if (compiler-symbols-handle-found? handle)
        (if (=
          (compiler-symbol-handle-kind handle)
          (compiler-symbol-kind-defenum))
          (match (tc-context-enum-variants ctx name)
            [(ResultAstVariantDefList.Ok variants)
              (tc-inline-aggregate-variants-finite-ok
                ctx
                variants
                (TcStringList.Cons name (box stack)))]
            [(ResultAstVariantDefList.Err message) (ResultTcUnit.Err message)])
          (if (=
            (compiler-symbol-handle-kind handle)
            (compiler-symbol-kind-defstruct))
            (match (tc-struct-decl ctx name)
              [(ResultTcStructDecl.Ok decl)
                (match decl
                  [(TcStructDecl _ _ fields)
                    (tc-inline-aggregate-fields-finite-ok
                      ctx
                      fields
                      (TcStringList.Cons name (box stack)))])]
              [(ResultTcStructDecl.Err message) (ResultTcUnit.Err message)])
            (ResultTcUnit.Err
              (string.append "typecheck: unknown aggregate " name))))
        (ResultTcUnit.Err (string.append "typecheck: unknown aggregate " name))))))

(define (tc-inline-aggregate-type-finite-ok
  [ctx : TcContext]
  [ty : AstType]
  [stack : TcStringList]) : ResultTcUnit
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Tuple elems)
      (tc-inline-aggregate-type-list-finite-ok ctx (box-get elems) stack)]
    [(AstType.Array elem _)
      (tc-inline-aggregate-type-finite-ok
        ctx
        (tc-context-type-get ctx elem)
        stack)]
    [(AstType.Enum name)
      (tc-inline-aggregate-nominal-finite-ok ctx (intern-str name) stack)]
    [(AstType.EnumArgs name _)
      (tc-inline-aggregate-nominal-finite-ok ctx (intern-str name) stack)]
    [(AstType.Struct name)
      (tc-inline-aggregate-nominal-finite-ok ctx (intern-str name) stack)]
    [(AstType.StructArgs name _)
      (tc-inline-aggregate-nominal-finite-ok ctx (intern-str name) stack)]
    [_ ResultTcUnit.Ok]))

(define (tc-inline-aggregate-layout-finite-ok [ctx : TcContext] [name : String]) : ResultTcUnit
  (tc-inline-aggregate-nominal-finite-ok ctx name TcStringList.Nil))

(define (tc-inline-aggregate-layout-info [size : i64] [align : i64]) : TcLayoutInfo
  (TcLayoutInfo size align))

(define (tc-inline-aggregate-pointer-layout-info) : TcLayoutInfo
  (tc-inline-aggregate-layout-info 8 8))

(define (tc-inline-aggregate-zero-layout-info) : TcLayoutInfo
  (tc-inline-aggregate-layout-info 0 1))

(define (tc-inline-aggregate-finish-layout [cursor : i64] [max-align : i64]) : TcLayoutInfo
  (let
    [align : i64
      (if (= max-align 0)
        1
        max-align)]
    (tc-inline-aggregate-layout-info (tc-align-up cursor align) align)))

(define (tc-inline-aggregate-array-size
  [elem-size : i64]
  [elem-align : i64]
  [count : i64]) : i64
  (if (<= count 0)
    0
    (* (tc-align-up elem-size elem-align) count)))

(define (tc-inline-aggregate-type-list-layout-info
  [ctx : TcContext]
  [types : AstTypeList]
  [cursor : i64]
  [max-align : i64]
  [stack : TcStringList]) : ResultTcLayoutInfo
  (tc-inline-aggregate-type-list-layout-info-at
    ctx
    (& types)
    0
    cursor
    max-align
    stack))

(define (tc-inline-aggregate-type-list-layout-info-at
  [ctx : TcContext]
  [types : (& types AstTypeList)]
  [index : i64]
  [cursor : i64]
  [max-align : i64]
  [stack : TcStringList]) : ResultTcLayoutInfo
  (if (>= index (ast-type-list-len types))
    (ResultTcLayoutInfo.Ok (tc-inline-aggregate-finish-layout cursor max-align))
    (let
      [ty : AstType
        (tc-context-type-get
          ctx
          (ast-type-list-get types index (ast-type-id-fallback)))]
      (match (tc-inline-aggregate-type-layout-with-stack ctx ty stack)
        [(ResultTcLayoutInfo.Ok info)
          (let
            [field-align : i64 (tc-layout-info-align info)]
            [field-size : i64 (tc-layout-info-size info)]
            [offset : i64 (tc-align-up cursor field-align)]
            [next-cursor : i64 (+ offset field-size)]
            [next-align : i64 (tc-max-i64 max-align field-align)]
            (tc-inline-aggregate-type-list-layout-info-at
              ctx
              types
              (+ index 1)
              next-cursor
              next-align
              stack))]
        [(ResultTcLayoutInfo.Err message) (ResultTcLayoutInfo.Err message)]))))

(define (tc-inline-aggregate-field-defs-layout
  [ctx : TcContext]
  [fields : AstFieldDefList]
  [cursor : i64]
  [max-align : i64]
  [stack : TcStringList]) : ResultTcInlineFieldsLayout
  (tc-inline-aggregate-field-defs-layout-at
    ctx
    (& fields)
    0
    cursor
    max-align
    stack))

(define (tc-inline-aggregate-field-defs-layout-at
  [ctx : TcContext]
  [fields : (& fields AstFieldDefList)]
  [index : i64]
  [cursor : i64]
  [max-align : i64]
  [stack : TcStringList]) : ResultTcInlineFieldsLayout
  (if (>= index (struct-get fields len))
    (match (tc-inline-aggregate-finish-layout cursor max-align)
      [(TcLayoutInfo size align)
        (ResultTcInlineFieldsLayout.Ok
          (TcInlineFieldsLayout.Fields size align TcInlineFieldLayoutList.Nil))])
    (match (ast-field-def-list-get fields index (ast-field-def-fallback))
      [(AstFieldDef.Def name ty _)
        (let
          [resolved : AstType (tc-resolve-type ctx ty)]
          (match (tc-inline-aggregate-type-layout-with-stack ctx resolved stack)
            [(ResultTcLayoutInfo.Ok info)
              (let
                [field-align : i64 (tc-layout-info-align info)]
                [field-size : i64 (tc-layout-info-size info)]
                [offset : i64 (tc-align-up cursor field-align)]
                [next-cursor : i64 (+ offset field-size)]
                [next-align : i64 (tc-max-i64 max-align field-align)]
                (match (tc-inline-aggregate-field-defs-layout-at
                  ctx
                  fields
                  (+ index 1)
                  next-cursor
                  next-align
                  stack)
                  [(ResultTcInlineFieldsLayout.Ok rest-layout)
                    (match rest-layout
                      [(TcInlineFieldsLayout.Fields size align rest-fields)
                        (begin
                          (cfg compile-profile (tc-lp-note 2))
                          (ResultTcInlineFieldsLayout.Ok
                            (TcInlineFieldsLayout.Fields
                              size
                              align
                              (TcInlineFieldLayoutList.Cons
                                (TcInlineFieldLayout.Field
                                  (intern-str name)
                                  resolved
                                  offset)
                                (box rest-fields)))))])]
                  [(ResultTcInlineFieldsLayout.Err message)
                    (ResultTcInlineFieldsLayout.Err message)]))]
            [(ResultTcLayoutInfo.Err message)
              (ResultTcInlineFieldsLayout.Err message)]))])))

(define (tc-inline-aggregate-payloads-layout
  [ctx : TcContext]
  [types : AstTypeList]
  [index : i64]
  [cursor : i64]
  [max-align : i64]
  [stack : TcStringList]) : ResultTcInlinePayloadFieldsLayout
  (tc-inline-aggregate-payloads-layout-at
    ctx
    (& types)
    index
    cursor
    max-align
    stack))

(define (tc-inline-aggregate-payloads-layout-at
  [ctx : TcContext]
  [types : (& types AstTypeList)]
  [index : i64]
  [cursor : i64]
  [max-align : i64]
  [stack : TcStringList]) : ResultTcInlinePayloadFieldsLayout
  (if (>= index (ast-type-list-len types))
    (match (tc-inline-aggregate-finish-layout cursor max-align)
      [(TcLayoutInfo size align)
        (ResultTcInlinePayloadFieldsLayout.Ok
          (TcInlinePayloadFieldsLayout.Fields
            size
            align
            TcInlinePayloadLayoutList.Nil))])
    (let
      [ty : AstType
        (tc-context-type-get
          ctx
          (ast-type-list-get types index (ast-type-id-fallback)))]
      (match (tc-inline-aggregate-type-layout-with-stack ctx ty stack)
        [(ResultTcLayoutInfo.Ok info)
          (let
            [field-align : i64 (tc-layout-info-align info)]
            [field-size : i64 (tc-layout-info-size info)]
            [offset : i64 (tc-align-up cursor field-align)]
            [next-cursor : i64 (+ offset field-size)]
            [next-align : i64 (tc-max-i64 max-align field-align)]
            (match (tc-inline-aggregate-payloads-layout-at
              ctx
              types
              (+ index 1)
              next-cursor
              next-align
              stack)
              [(ResultTcInlinePayloadFieldsLayout.Ok rest-layout)
                (match rest-layout
                  [(TcInlinePayloadFieldsLayout.Fields size align rest-payloads)
                    (begin
                      (cfg compile-profile (tc-lp-note 4))
                      (ResultTcInlinePayloadFieldsLayout.Ok
                        (TcInlinePayloadFieldsLayout.Fields
                          size
                          align
                          (TcInlinePayloadLayoutList.Cons
                            (TcInlinePayloadLayout.Payload index ty offset)
                            (box rest-payloads)))))])]
              [(ResultTcInlinePayloadFieldsLayout.Err message)
                (ResultTcInlinePayloadFieldsLayout.Err message)]))]
        [(ResultTcLayoutInfo.Err message)
          (ResultTcInlinePayloadFieldsLayout.Err message)]))))

(define (tc-inline-aggregate-struct-layout-with-stack
  [ctx : TcContext]
  [struct-name : String]
  [stack : TcStringList]) : ResultTcInlineAggregateLayout
  (if (tc-string-list-contains stack struct-name)
    (ResultTcInlineAggregateLayout.Err
      (tc-inline-aggregate-cycle-message struct-name stack))
    (match (tc-struct-decl ctx struct-name)
      [(ResultTcStructDecl.Ok decl)
        (match decl
          [(TcStructDecl _ _ fields)
            (match (tc-inline-aggregate-field-defs-layout
              ctx
              fields
              0
              0
              (TcStringList.Cons struct-name (box stack)))
              [(ResultTcInlineFieldsLayout.Ok layout)
                (match layout
                  [(TcInlineFieldsLayout.Fields size align fields-layout)
                    (ResultTcInlineAggregateLayout.Ok
                      (TcInlineAggregateLayout.Struct size align fields-layout))])]
              [(ResultTcInlineFieldsLayout.Err message)
                (ResultTcInlineAggregateLayout.Err message)])])]
      [(ResultTcStructDecl.Err message)
        (ResultTcInlineAggregateLayout.Err message)])))

(define (tc-inline-aggregate-variants-layout
  [ctx : TcContext]
  [variants : AstVariantDefList]
  [max-size : i64]
  [max-align : i64]
  [stack : TcStringList]) : ResultTcInlineAggregateLayout
  (tc-inline-aggregate-variants-layout-at
    ctx
    (& variants)
    max-size
    max-align
    stack
    0))

(define (tc-inline-aggregate-variants-layout-at
  [ctx : TcContext]
  [variants : (& variants AstVariantDefList)]
  [max-size : i64]
  [max-align : i64]
  [stack : TcStringList]
  [index : i64]) : ResultTcInlineAggregateLayout
  (if (>= index (struct-get variants len))
    (ResultTcInlineAggregateLayout.Ok
      (TcInlineAggregateLayout.Enum
        (tc-align-up max-size max-align)
        max-align
        TcInlineVariantLayoutList.Nil))
    (match (ast-variant-def-list-get variants index (ast-variant-def-fallback))
      [(AstVariantDef.Def variant-name fields _)
        (match (tc-inline-aggregate-payloads-layout ctx fields 0 8 8 stack)
          [(ResultTcInlinePayloadFieldsLayout.Ok payload-layout)
            (match payload-layout
              [(TcInlinePayloadFieldsLayout.Fields
                  variant-size
                  variant-align
                  payloads)
                (let
                  [next-size : i64 (tc-max-i64 max-size variant-size)]
                  [next-align : i64 (tc-max-i64 max-align variant-align)]
                  (match (tc-inline-aggregate-variants-layout-at
                    ctx
                    variants
                    next-size
                    next-align
                    stack
                    (+ index 1))
                    [(ResultTcInlineAggregateLayout.Ok rest-layout)
                      (match rest-layout
                        [(TcInlineAggregateLayout.Enum
                            enum-size
                            enum-align
                            rest-variants)
                          (begin
                            (cfg compile-profile (tc-lp-note 6))
                            (ResultTcInlineAggregateLayout.Ok
                              (TcInlineAggregateLayout.Enum
                                enum-size
                                enum-align
                                (TcInlineVariantLayoutList.Cons
                                  (TcInlineVariantLayout.Variant
                                    (intern-str variant-name)
                                    variant-size
                                    variant-align
                                    payloads)
                                  (box rest-variants)))))]
                        [(TcInlineAggregateLayout.Struct _ _ _)
                          (ResultTcInlineAggregateLayout.Err
                            "typecheck: internal inline enum layout mismatch")])]
                    [(ResultTcInlineAggregateLayout.Err message)
                      (ResultTcInlineAggregateLayout.Err message)]))])]
          [(ResultTcInlinePayloadFieldsLayout.Err message)
            (ResultTcInlineAggregateLayout.Err message)])])))

(define (tc-inline-aggregate-enum-layout-with-stack
  [ctx : TcContext]
  [enum-name : String]
  [stack : TcStringList]) : ResultTcInlineAggregateLayout
  (if (tc-string-list-contains stack enum-name)
    (ResultTcInlineAggregateLayout.Err
      (tc-inline-aggregate-cycle-message enum-name stack))
    (match (tc-context-enum-variants ctx enum-name)
      [(ResultAstVariantDefList.Ok variants)
        (tc-inline-aggregate-variants-layout
          ctx
          variants
          8
          8
          (TcStringList.Cons enum-name (box stack)))]
      [(ResultAstVariantDefList.Err message)
        (ResultTcInlineAggregateLayout.Err message)])))

;; --- full inline-aggregate layout memo ---------------------------------------
;; The Superluminal profile of the stage2 self-compile shows ~18% of CPU inside
;; the tc-inline-aggregate-* layout walk: every struct-get field offset, enum
;; payload offset, and lower-type-size query on a nominal recomputes the whole
;; recursive layout (the #2386 caches only memoized the final size and the
;; register-word count as scalars). This cache memoizes the COMPLETE
;; TcInlineAggregateLayout per type name. Unlike the scalar handle-index caches,
;; this cache is keyed by the intern id of the nominal name: symbol handles can
;; be reassigned when specialization rebuilds the symbol table, while intern ids
;; are stable until intern-reset!. The cached value is deep-cloned into the
;; persistent program arena (node-pool-base-arena) before storing -- a layout
;; computed while a transient lowering scratch arena is active would otherwise
;; dangle after the arena rewinds (the #2441 hazard).
(defenum TcAggLayoutCacheSlot
  (Empty)
  (Full TcInlineAggregateLayout))

(define tc-agg-layout-cache-capacity : i64
  65536)
(define tc-agg-layout-cache : (Array TcAggLayoutCacheSlot)
  (array.make-array TcAggLayoutCacheSlot 65536))
(define tc-agg-layout-cache-generation : i64
  -1)

;; `make-array` does not produce valid Empty enum slots, so the fill is
;; mandatory before the first probe; generation -1 forces it on first use.
(define (tc-agg-layout-cache-ensure!) : unit
  (if (= tc-agg-layout-cache-generation (intern-generation))
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i tc-agg-layout-cache-capacity)
          (begin
            (array-set! tc-agg-layout-cache i (TcAggLayoutCacheSlot.Empty))
            (set! i (+ i 1))))
        (set! tc-agg-layout-cache-generation (intern-generation))))))

;; Cache key: the INTERN ID of the nominal type name. Unlike the symbol-handle
;; index used by the scalar #2386 caches, intern ids are stable for the whole
;; program: the intern table only appends, while the symbol table is rebuilt
;; after specialization inserts generated declarations, which shifts handle
;; indexes mid-compile (observed as a wrong cached layout under
;; --cfg compile-profile). Type names are unique program-wide in the flat
;; namespace, so the name id identifies exactly one layout per generation.
(define (tc-agg-layout-cache-slot-key [name : String]) : i64
  (let
    [id : i64 (intern name)]
    (if (>= id tc-agg-layout-cache-capacity)
      (- 0 1)
      id)))

;; Deep-clone the completed layout into the persistent program arena and store
;; it. Only fully-resolved Ok layouts reach this point, so a cached entry can
;; never participate in a cycle (its computation already terminated).
(define (tc-agg-layout-cache-store!
  [key : i64]
  [layout : TcInlineAggregateLayout]) : unit
  (let
    [prev : i64 (arena.tl_arena_current)]
    (begin
      (unsafe
        (arena.tl_arena_set node-pool-base-arena))
      (let
        [persistent : TcInlineAggregateLayout (clone layout)]
        (begin
          (unsafe
            (arena.tl_arena_set prev))
          (array-set!
            tc-agg-layout-cache
            key
            (TcAggLayoutCacheSlot.Full persistent)))))))

(define (tc-inline-aggregate-layout-kind-dispatch
  [ctx : TcContext]
  [name : String]
  [handle : i64]
  [stack : TcStringList]) : ResultTcInlineAggregateLayout
  (let
    [layout-ctx : TcContext
      (tc-context-with-nominal-owner-index-module
        ctx
        (compiler-symbol-handle-index handle))]
    (if (= (compiler-symbol-handle-kind handle) (compiler-symbol-kind-defenum))
      (tc-inline-aggregate-enum-layout-with-stack layout-ctx name stack)
      (if (=
        (compiler-symbol-handle-kind handle)
        (compiler-symbol-kind-defstruct))
        (tc-inline-aggregate-struct-layout-with-stack layout-ctx name stack)
        (ResultTcInlineAggregateLayout.Err
          (string.append "typecheck: unknown aggregate " name))))))

(define (tc-inline-aggregate-layout-fill-cache
  [ctx : TcContext]
  [name : String]
  [handle : i64]
  [stack : TcStringList]
  [key : i64]) : ResultTcInlineAggregateLayout
  (match (tc-inline-aggregate-layout-kind-dispatch ctx name handle stack)
    [(ResultTcInlineAggregateLayout.Ok layout)
      (begin
        (tc-agg-layout-cache-store! key layout)
        (match (array-ref tc-agg-layout-cache key)
          [(TcAggLayoutCacheSlot.Full cached)
            (ResultTcInlineAggregateLayout.Ok cached)]
          [(TcAggLayoutCacheSlot.Empty)
            ;; Unreachable: the slot was just stored. Recompute defensively.
            (tc-inline-aggregate-layout-kind-dispatch ctx name handle stack)]))]
    [(ResultTcInlineAggregateLayout.Err message)
      (ResultTcInlineAggregateLayout.Err message)]))

(define (tc-inline-aggregate-layout-for-with-stack
  [ctx : TcContext]
  [name : String]
  [stack : TcStringList]) : ResultTcInlineAggregateLayout
  (let
    [handle : i64
      (compiler-symbols-lookup-type-or
        (tc-context-symbols ctx)
        name
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (begin
        (tc-agg-layout-cache-ensure!)
        (let
          [key : i64 (tc-agg-layout-cache-slot-key name)]
          (if (< key 0)
            (begin
              (cfg compile-profile (tc-lp-note 14))
              (tc-inline-aggregate-layout-kind-dispatch ctx name handle stack))
            (match (array-ref tc-agg-layout-cache key)
              [(TcAggLayoutCacheSlot.Full layout)
                (begin
                  (cfg compile-profile (tc-lp-note 12))
                  (ResultTcInlineAggregateLayout.Ok layout))]
              [(TcAggLayoutCacheSlot.Empty)
                (begin
                  (cfg compile-profile (tc-lp-note 13))
                  (tc-inline-aggregate-layout-fill-cache
                    ctx
                    name
                    handle
                    stack
                    key))]))))
      (ResultTcInlineAggregateLayout.Err
        (string.append "typecheck: unknown aggregate " name)))))

(define (tc-inline-aggregate-type-layout-with-stack
  [ctx : TcContext]
  [ty : AstType]
  [stack : TcStringList]) : ResultTcLayoutInfo
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.I64)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-layout-info 8 8))]
    [(AstType.U64)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-layout-info 8 8))]
    [(AstType.F64)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-layout-info 8 8))]
    [(AstType.I32)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-layout-info 4 4))]
    [(AstType.U32)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-layout-info 4 4))]
    [(AstType.F32)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-layout-info 4 4))]
    [(AstType.I16)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-layout-info 2 2))]
    [(AstType.U16)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-layout-info 2 2))]
    [(AstType.I8) (ResultTcLayoutInfo.Ok (tc-inline-aggregate-layout-info 1 1))]
    [(AstType.U8) (ResultTcLayoutInfo.Ok (tc-inline-aggregate-layout-info 1 1))]
    [(AstType.Bool)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-layout-info 1 1))]
    [(AstType.Char)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-layout-info 1 1))]
    [(AstType.Unit)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-zero-layout-info))]
    [(AstType.Never)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-zero-layout-info))]
    [(AstType.Expr)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-zero-layout-info))]
    [(AstType.ExprList)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-zero-layout-info))]
    [(AstType.Func _ _)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-pointer-layout-info))]
    [(AstType.DynArray _)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-pointer-layout-info))]
    [(AstType.Box _)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-pointer-layout-info))]
    [(AstType.Ptr _)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-pointer-layout-info))]
    [(AstType.MutPtr _)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-pointer-layout-info))]
    [(AstType.Ref _ _)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-pointer-layout-info))]
    [(AstType.MutRef _ _)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-pointer-layout-info))]
    [(AstType.Region _ inner)
      (tc-inline-aggregate-type-layout-with-stack
        ctx
        (tc-context-type-get ctx inner)
        stack)]
    [(AstType.String)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-pointer-layout-info))]
    [(AstType.Str)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-pointer-layout-info))]
    [(AstType.Bytes)
      (ResultTcLayoutInfo.Err
        "typecheck: bytes has no by-value layout; use (& lifetime bytes) or (&mut lifetime bytes)")]
    [(AstType.Var _)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-pointer-layout-info))]
    [(AstType.VarArgs _ _)
      (ResultTcLayoutInfo.Ok (tc-inline-aggregate-pointer-layout-info))]
    [(AstType.Tuple elems)
      (tc-inline-aggregate-type-list-layout-info ctx (box-get elems) 0 0 stack)]
    [(AstType.Array elem count)
      (match (tc-inline-aggregate-type-layout-with-stack
        ctx
        (tc-context-type-get ctx elem)
        stack)
        [(ResultTcLayoutInfo.Ok elem-info)
          (ResultTcLayoutInfo.Ok
            (TcLayoutInfo
              (tc-inline-aggregate-array-size
                (tc-layout-info-size elem-info)
                (tc-layout-info-align elem-info)
                count)
              (tc-layout-info-align elem-info)))]
        [(ResultTcLayoutInfo.Err message) (ResultTcLayoutInfo.Err message)])]
    [(AstType.Struct name)
      (match (tc-inline-aggregate-layout-for-with-stack
        ctx
        (intern-str name)
        stack)
        [(ResultTcInlineAggregateLayout.Ok layout)
          (ResultTcLayoutInfo.Ok
            (TcLayoutInfo
              (tc-inline-aggregate-layout-size layout)
              (tc-inline-aggregate-layout-align layout)))]
        [(ResultTcInlineAggregateLayout.Err message)
          (ResultTcLayoutInfo.Err message)])]
    [(AstType.StructArgs name _)
      (match (tc-inline-aggregate-layout-for-with-stack
        ctx
        (intern-str name)
        stack)
        [(ResultTcInlineAggregateLayout.Ok layout)
          (ResultTcLayoutInfo.Ok
            (TcLayoutInfo
              (tc-inline-aggregate-layout-size layout)
              (tc-inline-aggregate-layout-align layout)))]
        [(ResultTcInlineAggregateLayout.Err message)
          (ResultTcLayoutInfo.Err message)])]
    [(AstType.Enum name)
      (match (tc-inline-aggregate-layout-for-with-stack
        ctx
        (intern-str name)
        stack)
        [(ResultTcInlineAggregateLayout.Ok layout)
          (ResultTcLayoutInfo.Ok
            (TcLayoutInfo
              (tc-inline-aggregate-layout-size layout)
              (tc-inline-aggregate-layout-align layout)))]
        [(ResultTcInlineAggregateLayout.Err message)
          (ResultTcLayoutInfo.Err message)])]
    [(AstType.EnumArgs name _)
      (match (tc-inline-aggregate-layout-for-with-stack
        ctx
        (intern-str name)
        stack)
        [(ResultTcInlineAggregateLayout.Ok layout)
          (ResultTcLayoutInfo.Ok
            (TcLayoutInfo
              (tc-inline-aggregate-layout-size layout)
              (tc-inline-aggregate-layout-align layout)))]
        [(ResultTcInlineAggregateLayout.Err message)
          (ResultTcLayoutInfo.Err message)])]))

(define (tc-inline-aggregate-type-layout [ctx : TcContext] [ty : AstType]) : ResultTcLayoutInfo
  (tc-inline-aggregate-type-layout-with-stack ctx ty TcStringList.Nil))

(define (tc-inline-aggregate-layout-for [ctx : TcContext] [name : String]) : ResultTcInlineAggregateLayout
  (tc-inline-aggregate-layout-for-with-stack ctx name TcStringList.Nil))

;; #2386 (compile-time): memoize the inline-aggregate SIZE. tc-inline-aggregate-
;; layout-for re-walks the whole layout on every lower-type-size query, which is
;; ~70% of the -O1 lower phase. The cache must do NO allocation during lowering
;; (the #2441 scratch-arena hazard makes a grown map / cached field-list dangle):
;; so it is a FIXED global i64 array, allocated once at startup (persistent, like
;; the AST node pool) and only read/written thereafter. Keyed by the intern id of
;; the nominal type name: symbol handles can be reassigned when specialization
;; rebuilds the symbol table, while intern ids are append-only until intern-reset!.
;; A size is encoded as size+1 (0 = uncached); only fully-resolved layouts are
;; cached (Err forward-refs stay uncached until their nested types resolve).
;; Entries are valid only for the current program; tc-agg-caches-reset! forces
;; the next query to clear them at lower boundaries.
(define tc-agg-scalar-cache-capacity : i64
  400000)
(define tc-agg-size-cache : (Array i64)
  (array.make-array i64 400000))

;; #2624: these scalar caches used to be keyed by symbol-handle INDEX, which is
;; only meaningful for one snapshot of a program's symbol table. Specialization
;; rebuilds that table after inserting generated declarations, so a cached value
;; under an old handle index could be returned for a different type whose new
;; handle reuses the same index. Intern ids are stable across that rebuild.
;; Intern generation remains the cheap clear token across programs, while
;; tc-agg-caches-reset! covers lower/test paths that reuse cache arrays without
;; resetting the intern table.
(define tc-agg-size-cache-generation : i64
  -1)

(define (tc-agg-size-cache-ensure!) : unit
  (if (= tc-agg-size-cache-generation (intern-generation))
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i tc-agg-scalar-cache-capacity)
          (begin
            (array-set! tc-agg-size-cache i 0)
            (set! i (+ i 1))))
        (set! tc-agg-size-cache-generation (intern-generation))))))

(define (tc-agg-scalar-cache-key-id [name-id : i64]) : i64
  (if (>= name-id tc-agg-scalar-cache-capacity)
    (- 0 1)
    name-id))

(define (tc-inline-aggregate-size-cached
  [ctx : TcContext]
  [name-id : i64]
  [fallback : i64]) : i64
  (begin
    (tc-agg-size-cache-ensure!)
    (let
      [key : i64 (tc-agg-scalar-cache-key-id name-id)]
      (if (< key 0)
        (match (tc-inline-aggregate-layout-for ctx (intern-str name-id))
          [(ResultTcInlineAggregateLayout.Ok layout)
            (tc-inline-aggregate-layout-size layout)]
          [(ResultTcInlineAggregateLayout.Err _) fallback])
        (let
          [cached : i64 (array-ref tc-agg-size-cache key)]
          (if (> cached 0)
            (- cached 1)
            (match (tc-inline-aggregate-layout-for ctx (intern-str name-id))
              [(ResultTcInlineAggregateLayout.Ok layout)
                (let
                  [size : i64 (tc-inline-aggregate-layout-size layout)]
                  (begin
                    (array-set! tc-agg-size-cache key (+ size 1))
                    size))]
              [(ResultTcInlineAggregateLayout.Err _) fallback])))))))

;; #2609: same arena-safe fixed cache for bare aggregate ALIGN queries. Lowering
;; asks for alignment on the same hot aggregate paths as size; rebuilding the full
;; layout here defeats the size/regword caches.
(define tc-agg-align-cache : (Array i64)
  (array.make-array i64 400000))
(define tc-agg-align-cache-generation : i64
  -1)

(define (tc-agg-align-cache-ensure!) : unit
  (if (= tc-agg-align-cache-generation (intern-generation))
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i tc-agg-scalar-cache-capacity)
          (begin
            (array-set! tc-agg-align-cache i 0)
            (set! i (+ i 1))))
        (set! tc-agg-align-cache-generation (intern-generation))))))

(define (tc-inline-aggregate-align-cached
  [ctx : TcContext]
  [name-id : i64]
  [fallback : i64]) : i64
  (begin
    (tc-agg-align-cache-ensure!)
    (let
      [key : i64 (tc-agg-scalar-cache-key-id name-id)]
      (if (< key 0)
        (match (tc-inline-aggregate-layout-for ctx (intern-str name-id))
          [(ResultTcInlineAggregateLayout.Ok layout)
            (tc-inline-aggregate-layout-align layout)]
          [(ResultTcInlineAggregateLayout.Err _) fallback])
        (let
          [cached : i64 (array-ref tc-agg-align-cache key)]
          (if (> cached 0)
            (- cached 1)
            (match (tc-inline-aggregate-layout-for ctx (intern-str name-id))
              [(ResultTcInlineAggregateLayout.Ok layout)
                (let
                  [align : i64 (tc-inline-aggregate-layout-align layout)]
                  (begin
                    (array-set! tc-agg-align-cache key (+ align 1))
                    align))]
              [(ResultTcInlineAggregateLayout.Err _) fallback])))))))

;; #2386 (compile-time): memoize a bare aggregate's register-resident word count
;; (0 = not register-resident, else 1 or 2). Same arena-safe intern-id keyed
;; fixed array as the size cache; this is the hot query for every aggregate
;; construct / struct-get / copy (lower-name-register-words). Encoded as
;; words+1 (0 = uncached). Only fully-resolved layouts are cached.
(define tc-agg-regwords-cache : (Array i64)
  (array.make-array i64 400000))

;; Same per-program keying as tc-agg-size-cache, so it is gated on
;; intern-generation and explicitly invalidated at lower boundaries.
(define tc-agg-regwords-cache-generation : i64
  -1)

(define (tc-agg-caches-reset!) : unit
  (begin
    (set! tc-agg-layout-cache-generation -1)
    (set! tc-agg-size-cache-generation -1)
    (set! tc-agg-align-cache-generation -1)
    (set! tc-agg-regwords-cache-generation -1)))

(define (tc-agg-regwords-cache-ensure!) : unit
  (if (= tc-agg-regwords-cache-generation (intern-generation))
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i tc-agg-scalar-cache-capacity)
          (begin
            (array-set! tc-agg-regwords-cache i 0)
            (set! i (+ i 1))))
        (set! tc-agg-regwords-cache-generation (intern-generation))))))

(define (tc-inline-aggregate-regwords-compute [ctx : TcContext] [name-id : i64]) : i64
  (match (tc-inline-aggregate-layout-for ctx (intern-str name-id))
    [(ResultTcInlineAggregateLayout.Ok layout)
      (if (tc-inline-aggregate-layout-register-resident? layout)
        (/ (+ (tc-inline-aggregate-layout-size layout) 7) 8)
        0)]
    [(ResultTcInlineAggregateLayout.Err _) 0]))

(define (tc-inline-aggregate-regwords-cached [ctx : TcContext] [name-id : i64]) : i64
  (begin
    (tc-agg-regwords-cache-ensure!)
    (let
      [key : i64 (tc-agg-scalar-cache-key-id name-id)]
      (if (< key 0)
        (tc-inline-aggregate-regwords-compute ctx name-id)
        (let
          [cached : i64 (array-ref tc-agg-regwords-cache key)]
          (if (> cached 0)
            (- cached 1)
            (match (tc-inline-aggregate-layout-for ctx (intern-str name-id))
              [(ResultTcInlineAggregateLayout.Ok layout)
                (let
                  [words : i64
                    (if (tc-inline-aggregate-layout-register-resident? layout)
                      (/ (+ (tc-inline-aggregate-layout-size layout) 7) 8)
                      0)]
                  (begin
                    (array-set! tc-agg-regwords-cache key (+ words 1))
                    words))]
              [(ResultTcInlineAggregateLayout.Err _) 0])))))))

;; #2386: a struct/enum layout is "register-resident (1-word)" when it fits in a
;; single 8-byte machine word and is built only of word-class data. Such a value
;; can live in a register end-to-end (packed/extracted by shift+mask) instead of
;; round-tripping through a memory slot.
;;
;; Scope (slice 2): single-word STRUCTs (all fields word-class) AND nullary
;; size-8 ENUMs. A size-8 enum is necessarily nullary -- the tag occupies the
;; whole first word at offset 0, so any variant payload would force size >= 16 --
;; hence its single register-resident word is just the discriminant tag.
;;
;; This makes `=` on a nullary enum a tag (structural) compare rather than the
;; old stack-slot handle compare: two separately-constructed values of the same
;; variant now compare equal, which is the intended value-semantics for a POD
;; tag (and matches what `match` already observes). Bootstrap fixpoint +
;; integration corpus are the canary that the compiler's own codegen does not
;; depend on the prior handle-identity behavior.
(define (tc-inline-aggregate-layout-register-resident?
  [layout : TcInlineAggregateLayout]) : bool
  (match layout
    [(TcInlineAggregateLayout.Struct size _ fields)
      ;; #2386: an integer-class struct of 1 word (8 B) or 2 words (16 B) whose
      ;; fields are all supported register classes is register-resident --
      ;; carried in one or two register-class words end-to-end. #2601 extends the
      ;; original INTEGER-only gate to exact f64 SSE eightbytes; #2855 admits
      ;; homogeneous packed f32 SSE eightbytes while mixed int/float words stay
      ;; memory-backed.
      (if (or (= size 8) (= size 16))
        (tc-inline-fields-all-register-class? fields)
        false)]
    ;; #2386: an enum is register-resident at 1 word (size 8 -- necessarily
    ;; nullary, the tag word) or 2 words (size 16 -- tag in word0, a single
    ;; supported register-class payload in word1). Larger or unsupported
    ;; aggregate-payload enums keep the memory path.
    [(TcInlineAggregateLayout.Enum size _ variants)
      (if (or (= size 8) (= size 16))
        (tc-inline-enum-payloads-all-register-class? variants)
        false)]))

(define (tc-name-register-resident? [ctx : TcContext] [name : String]) : bool
  (match (tc-inline-aggregate-layout-for ctx name)
    [(ResultTcInlineAggregateLayout.Ok layout)
      (tc-inline-aggregate-layout-register-resident? layout)]
    [(ResultTcInlineAggregateLayout.Err _) false]))

(define (tc-repr-c-unsupported-field-message
  [owner : String]
  [field : String]
  [ty : AstType]) : String
  (str_cat.str-cat
    "typecheck: repr c struct "
    owner
    " field "
    field
    " has unsupported field type "
    (tc-type-render ty)))

(define (tc-repr-c-field-layout-info
  [ctx : TcContext]
  [owner : String]
  [field : String]
  [ty : AstType]
  [seen : TcStringList]) : ResultTcLayoutInfo
  (match (tc-resolve-type ctx ty)
    [(AstType.I64) (ResultTcLayoutInfo.Ok (TcLayoutInfo 8 8))]
    [(AstType.U64) (ResultTcLayoutInfo.Ok (TcLayoutInfo 8 8))]
    [(AstType.F64) (ResultTcLayoutInfo.Ok (TcLayoutInfo 8 8))]
    [(AstType.F32) (ResultTcLayoutInfo.Ok (TcLayoutInfo 4 4))]
    [(AstType.I32) (ResultTcLayoutInfo.Ok (TcLayoutInfo 4 4))]
    [(AstType.U32) (ResultTcLayoutInfo.Ok (TcLayoutInfo 4 4))]
    [(AstType.I16) (ResultTcLayoutInfo.Ok (TcLayoutInfo 2 2))]
    [(AstType.U16) (ResultTcLayoutInfo.Ok (TcLayoutInfo 2 2))]
    [(AstType.I8) (ResultTcLayoutInfo.Ok (TcLayoutInfo 1 1))]
    [(AstType.U8) (ResultTcLayoutInfo.Ok (TcLayoutInfo 1 1))]
    [(AstType.Bool) (ResultTcLayoutInfo.Ok (TcLayoutInfo 1 1))]
    [(AstType.Char) (ResultTcLayoutInfo.Ok (TcLayoutInfo 1 1))]
    [(AstType.Ptr _) (ResultTcLayoutInfo.Ok (TcLayoutInfo 8 8))]
    [(AstType.MutPtr _) (ResultTcLayoutInfo.Ok (TcLayoutInfo 8 8))]
    [(AstType.Struct nested)
      (let
        [nested-str : String (intern-str nested)]
        (match (tc-struct-decl ctx nested-str)
          [(ResultTcStructDecl.Ok decl)
            (match decl
              [(TcStructDecl repr _ _)
                (if (ast-struct-repr-c? repr)
                  (match (tc-repr-c-struct-layout-with-seen ctx nested-str seen)
                    [(ResultTcReprCLayout.Ok layout)
                      (ResultTcLayoutInfo.Ok
                        (TcLayoutInfo
                          (tc-repr-c-layout-size layout)
                          (tc-repr-c-layout-align layout)))]
                    [(ResultTcReprCLayout.Err message)
                      (ResultTcLayoutInfo.Err message)])
                  ;; #2296: embed a default-layout struct by value using its
                  ;; default inline C-rule layout (default layout now follows C
                  ;; layout per #1867). `seen` carries the repr-c owners so a
                  ;; cycle back through this struct is still detected.
                  (tc-inline-aggregate-type-layout-with-stack
                    ctx
                    (AstType.Struct nested)
                    seen))])]
          [(ResultTcStructDecl.Err message) (ResultTcLayoutInfo.Err message)]))]
    [(AstType.StructArgs nested lifetimes)
      (let
        [nested-str : String (intern-str nested)]
        (match (tc-struct-decl ctx nested-str)
          [(ResultTcStructDecl.Ok decl)
            (match decl
              [(TcStructDecl repr _ _)
                (if (ast-struct-repr-c? repr)
                  (match (tc-repr-c-struct-layout-with-seen ctx nested-str seen)
                    [(ResultTcReprCLayout.Ok layout)
                      (ResultTcLayoutInfo.Ok
                        (TcLayoutInfo
                          (tc-repr-c-layout-size layout)
                          (tc-repr-c-layout-align layout)))]
                    [(ResultTcReprCLayout.Err message)
                      (ResultTcLayoutInfo.Err message)])
                  ;; #2296: embed a default-layout struct (with type args) by value
                  ;; using its default inline C-rule layout.
                  (tc-inline-aggregate-type-layout-with-stack
                    ctx
                    (AstType.StructArgs nested lifetimes)
                    seen))])]
          [(ResultTcStructDecl.Err message) (ResultTcLayoutInfo.Err message)]))]
    ;; #2296: embed an enum by value using its default inline layout (tag +
    ;; payload). Enums have no separate repr-c layout; the inline engine threads
    ;; `seen` for cycle detection.
    [(AstType.Enum name)
      (tc-inline-aggregate-type-layout-with-stack ctx (AstType.Enum name) seen)]
    [(AstType.EnumArgs name lifetimes)
      (tc-inline-aggregate-type-layout-with-stack
        ctx
        (AstType.EnumArgs name lifetimes)
        seen)]
    [_
      (ResultTcLayoutInfo.Err
        (tc-repr-c-unsupported-field-message owner field ty))]))

(define (tc-repr-c-fields-layout
  [ctx : TcContext]
  [owner : String]
  [fields : AstFieldDefList]
  [cursor : i64]
  [max-align : i64]
  [seen : TcStringList]) : ResultTcReprCLayout
  (tc-repr-c-fields-layout-at ctx owner (& fields) 0 cursor max-align seen))

(define (tc-repr-c-fields-layout-at
  [ctx : TcContext]
  [owner : String]
  [fields : (& fields AstFieldDefList)]
  [index : i64]
  [cursor : i64]
  [max-align : i64]
  [seen : TcStringList]) : ResultTcReprCLayout
  (if (>= index (struct-get fields len))
    (if (= max-align 0)
      (ResultTcReprCLayout.Err
        "typecheck: repr c struct needs at least one field")
      (ResultTcReprCLayout.Ok
        (TcReprCLayout.Layout
          (tc-align-up cursor max-align)
          max-align
          TcReprCFieldLayoutList.Nil)))
    (match (ast-field-def-list-get fields index (ast-field-def-fallback))
      [(AstFieldDef.Def name ty _)
        (let
          [resolved : AstType (tc-resolve-type ctx ty)]
          (match (tc-repr-c-field-layout-info
            ctx
            owner
            (intern-str name)
            resolved
            seen)
            [(ResultTcLayoutInfo.Ok info)
              (let
                [field-align : i64 (tc-layout-info-align info)]
                [field-size : i64 (tc-layout-info-size info)]
                [offset : i64 (tc-align-up cursor field-align)]
                [next-cursor : i64 (+ offset field-size)]
                [next-align : i64 (tc-max-i64 max-align field-align)]
                (match (tc-repr-c-fields-layout-at
                  ctx
                  owner
                  fields
                  (+ index 1)
                  next-cursor
                  next-align
                  seen)
                  [(ResultTcReprCLayout.Ok rest-layout)
                    (begin
                      (cfg compile-profile (tc-lp-note 0))
                      (ResultTcReprCLayout.Ok
                        (TcReprCLayout.Layout
                          (tc-repr-c-layout-size rest-layout)
                          (tc-repr-c-layout-align rest-layout)
                          (TcReprCFieldLayoutList.Cons
                            (TcReprCFieldLayout.Field
                              (intern-str name)
                              resolved
                              offset)
                            (box (tc-repr-c-layout-fields rest-layout))))))]
                  [(ResultTcReprCLayout.Err message)
                    (ResultTcReprCLayout.Err message)]))]
            [(ResultTcLayoutInfo.Err message) (ResultTcReprCLayout.Err message)]))])))

(define (tc-repr-c-struct-layout-with-seen
  [ctx : TcContext]
  [struct-name : String]
  [seen : TcStringList]) : ResultTcReprCLayout
  (if (tc-string-list-contains seen struct-name)
    (ResultTcReprCLayout.Err
      (string.append
        "typecheck: recursive repr c struct layout cycle involving "
        struct-name))
    (match (tc-struct-decl ctx struct-name)
      [(ResultTcStructDecl.Ok decl)
        (match decl
          [(TcStructDecl repr _ fields)
            (if (ast-struct-repr-c? repr)
              (tc-repr-c-fields-layout
                ctx
                struct-name
                fields
                0
                0
                (tc-string-list-add seen struct-name))
              (ResultTcReprCLayout.Err
                (string.append "typecheck: struct is not repr c: " struct-name)))])]
      [(ResultTcStructDecl.Err message) (ResultTcReprCLayout.Err message)])))

(define (tc-repr-c-struct-layout [ctx : TcContext] [struct-name : String]) : ResultTcReprCLayout
  (tc-repr-c-struct-layout-with-seen ctx struct-name TcStringList.Nil))

(define (tc-ctfe-inline-layout-fields-into
  [fields : TcInlineFieldLayoutList]
  [out : CtfeLayoutFieldList]) : CtfeLayoutFieldList
  (match fields
    [(TcInlineFieldLayoutList.Nil) out]
    [(TcInlineFieldLayoutList.Cons field rest)
      (match field
        [(TcInlineFieldLayout.Field name _ offset)
          (tc-ctfe-inline-layout-fields-into
            (box-get rest)
            (ctfe-layout-field-list-push
              out
              (CtfeLayoutField.Field name offset)))])]))

(define (tc-ctfe-inline-layout-field-count [fields : TcInlineFieldLayoutList]) : i64
  (match fields
    [(TcInlineFieldLayoutList.Nil) 0]
    [(TcInlineFieldLayoutList.Cons _ rest)
      (+ 1 (tc-ctfe-inline-layout-field-count (box-get rest)))]))

(define (tc-ctfe-inline-layout-fields [fields : TcInlineFieldLayoutList]) : CtfeLayoutFieldList
  (tc-ctfe-inline-layout-fields-into
    fields
    (ctfe-layout-field-list-with-capacity
      (tc-ctfe-inline-layout-field-count fields))))

(define (tc-ctfe-inline-aggregate-layout-info
  [name : String]
  [layout : TcInlineAggregateLayout]) : CtfeLayoutInfo
  (match layout
    [(TcInlineAggregateLayout.Struct size align fields)
      (CtfeLayoutInfo.Info
        name
        true
        size
        align
        (tc-ctfe-inline-layout-fields fields))]
    [(TcInlineAggregateLayout.Enum size align _)
      (CtfeLayoutInfo.Info name false size align (ctfe-layout-field-list-empty))]))

(define (tc-ctfe-struct-layout-info [ctx : TcContext] [struct-name : String]) : CtfeLayoutInfo
  (match (tc-inline-aggregate-layout-for ctx struct-name)
    [(ResultTcInlineAggregateLayout.Ok layout)
      (tc-ctfe-inline-aggregate-layout-info struct-name layout)]
    [(ResultTcInlineAggregateLayout.Err _)
      (CtfeLayoutInfo.Info struct-name false 8 8 (ctfe-layout-field-list-empty))]))

(define (tc-ctfe-type-layout-info [ctx : TcContext] [type-name : String]) : CtfeLayoutInfo
  (match (tc-inline-aggregate-layout-for ctx type-name)
    [(ResultTcInlineAggregateLayout.Ok layout)
      (tc-ctfe-inline-aggregate-layout-info type-name layout)]
    [(ResultTcInlineAggregateLayout.Err _)
      (CtfeLayoutInfo.Info type-name false 8 8 (ctfe-layout-field-list-empty))]))

(define (tc-ctfe-layout-add-alias
  [layouts : CtfeLayoutInfoList]
  [info : CtfeLayoutInfo]
  [alias : String]) : CtfeLayoutInfoList
  (match info
    [(CtfeLayoutInfo.Info _ repr-c? size align fields)
      (ctfe-layout-info-list-add-if-missing
        layouts
        (CtfeLayoutInfo.Info alias repr-c? size align fields))]))

(define (tc-ctfe-layout-add-names
  [layouts : CtfeLayoutInfoList]
  [info : CtfeLayoutInfo]
  [name : String]
  [module : String]) : CtfeLayoutInfoList
  (let
    [with-key : CtfeLayoutInfoList
      (ctfe-layout-info-list-add-if-missing layouts info)]
    (if (= (string.string-length module) 0)
      with-key
      (tc-ctfe-layout-add-alias with-key info name))))

(define (tc-ctfe-layouts-from-decls
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]
  [layouts : CtfeLayoutInfoList]) : CtfeLayoutInfoList
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) layouts]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        (match decl
          [(AstDecl.Module next-module)
            (tc-ctfe-layouts-from-decls
              ctx
              rest
              (intern-str next-module)
              layouts)]
          [(AstDecl.DefStruct name _ _ _)
            (let
              [name-str : String (intern-str name)]
              [key : String (compiler-symbol-module-key module name-str)]
              [info : CtfeLayoutInfo (tc-ctfe-struct-layout-info ctx key)]
              (tc-ctfe-layouts-from-decls
                ctx
                rest
                module
                (tc-ctfe-layout-add-names layouts info name-str module)))]
          [(AstDecl.DefStructLifetimes name _ _ _ _)
            (let
              [name-str : String (intern-str name)]
              [key : String (compiler-symbol-module-key module name-str)]
              [info : CtfeLayoutInfo (tc-ctfe-struct-layout-info ctx key)]
              (tc-ctfe-layouts-from-decls
                ctx
                rest
                module
                (tc-ctfe-layout-add-names layouts info name-str module)))]
          [(AstDecl.DefEnum name _ _)
            (let
              [name-str : String (intern-str name)]
              [key : String (compiler-symbol-module-key module name-str)]
              [info : CtfeLayoutInfo (tc-ctfe-type-layout-info ctx key)]
              (tc-ctfe-layouts-from-decls
                ctx
                rest
                module
                (tc-ctfe-layout-add-names layouts info name-str module)))]
          [(AstDecl.DefEnumLifetimes name _ _ _)
            (let
              [name-str : String (intern-str name)]
              [key : String (compiler-symbol-module-key module name-str)]
              [info : CtfeLayoutInfo (tc-ctfe-type-layout-info ctx key)]
              (tc-ctfe-layouts-from-decls
                ctx
                rest
                module
                (tc-ctfe-layout-add-names layouts info name-str module)))]
          [(AstDecl.ComptimeDecl _ template-box)
            (let
              [template : AstDecl (box-get template-box)]
              (match template
                [(AstDecl.DefStruct name _ _ _)
                  (let
                    [name-str : String (intern-str name)]
                    [key : String (compiler-symbol-module-key module name-str)]
                    [info : CtfeLayoutInfo (tc-ctfe-struct-layout-info ctx key)]
                    (tc-ctfe-layouts-from-decls
                      ctx
                      rest
                      module
                      (tc-ctfe-layout-add-names layouts info name-str module)))]
                [(AstDecl.DefStructLifetimes name _ _ _ _)
                  (let
                    [name-str : String (intern-str name)]
                    [key : String (compiler-symbol-module-key module name-str)]
                    [info : CtfeLayoutInfo (tc-ctfe-struct-layout-info ctx key)]
                    (tc-ctfe-layouts-from-decls
                      ctx
                      rest
                      module
                      (tc-ctfe-layout-add-names layouts info name-str module)))]
                [(AstDecl.DefEnum name _ _)
                  (let
                    [name-str : String (intern-str name)]
                    [key : String (compiler-symbol-module-key module name-str)]
                    [info : CtfeLayoutInfo (tc-ctfe-type-layout-info ctx key)]
                    (tc-ctfe-layouts-from-decls
                      ctx
                      rest
                      module
                      (tc-ctfe-layout-add-names layouts info name-str module)))]
                [(AstDecl.DefEnumLifetimes name _ _ _)
                  (let
                    [name-str : String (intern-str name)]
                    [key : String (compiler-symbol-module-key module name-str)]
                    [info : CtfeLayoutInfo (tc-ctfe-type-layout-info ctx key)]
                    (tc-ctfe-layouts-from-decls
                      ctx
                      rest
                      module
                      (tc-ctfe-layout-add-names layouts info name-str module)))]
                [_ (tc-ctfe-layouts-from-decls ctx rest module layouts)]))]
          [_ (tc-ctfe-layouts-from-decls ctx rest module layouts)]))]))

(define (tc-ctfe-layouts [ctx : TcContext]) : CtfeLayoutInfoList
  (match ctx
    [(TcContext program _ _ _ _)
      (match program
        [(AstProgram.Program decls-box)
          (let
            [decls : AstDeclList (box-get decls-box)]
            (begin
              (ctfe-build-seen-reset!)
              (tc-ctfe-layouts-from-decls
                ctx
                decls
                ""
                (ctfe-layout-info-list-with-capacity
                  (ctfe-metadata-decl-capacity decls)))))])]))

;; CTFE base environment (reflection + layout metadata). This is invariant across
;; a single compile (same program/symbols/registries), but is requested up to ~8
;; times per compile -- once in macro expansion plus once per comptime evaluation
;; in the typecheck and lower passes -- and each `ctfe-reflections-from-program` /
;; `tc-ctfe-layouts` build walks the whole program (O(program), tens of MB). The
;; cache is populated eagerly in `macro-expand-program` (which always runs first,
;; in the enclosing program arena, so the cached value never dangles into a
;; rewound scratch arena) and reset per compile at the top of that function.
(define (tc-ctfe-env [ctx : TcContext]) : CtfeEnv
  (if macro-expand-ctfe-env-ready
    (ctfe-env-rebase-pools macro-expand-ctfe-env-value (tc-context-pools ctx))
    (if ctfe-needs-metadata
      (ctfe-env-with-metadata-and-pools
        (tc-ctfe-layouts ctx)
        (ctfe-reflections-from-program (tc-context-program ctx))
        (tc-context-pools ctx))
      (ctfe-env-empty-with-pools (tc-context-pools ctx)))))

(define (tc-string-prefix? [text : String] [prefix : String]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [prefix-len : i64 (string.string-length prefix)]
    (if (< text-len prefix-len)
      false
      (string.eq (string.substring text 0 prefix-len) prefix))))

(define (tc-result-info-enum-name [info : TcResultInfo]) : String
  (match info
    [(TcResultInfo _ enum-name _ _ _ _) enum-name]))

(define (tc-result-info-kind [info : TcResultInfo]) : TcTryKind
  (match info
    [(TcResultInfo kind _ _ _ _ _) kind]))

(define (tc-result-info-ok-name [info : TcResultInfo]) : String
  (match info
    [(TcResultInfo _ _ ok-name _ _ _) ok-name]))

(define (tc-result-info-ok-type [info : TcResultInfo]) : AstType
  (match info
    [(TcResultInfo _ _ _ ok-ty _ _) ok-ty]))

(define (tc-result-info-err-name [info : TcResultInfo]) : String
  (match info
    [(TcResultInfo _ _ _ _ err-name _) err-name]))

(define (tc-result-info-err-type [info : TcResultInfo]) : AstType
  (match info
    [(TcResultInfo _ _ _ _ _ err-ty) err-ty]))

(define (tc-ok-variant-name? [name : String]) : bool
  (tc-string-prefix? name "Ok"))

(define (tc-err-variant-name? [name : String]) : bool
  (tc-string-prefix? name "Err"))

(define (tc-some-variant-name? [name : String]) : bool
  (tc-string-prefix? name "Some"))

(define (tc-none-variant-name? [name : String]) : bool
  (tc-string-prefix? name "None"))

(define (tc-result-variant-payload-type
  [ctx : TcContext]
  [variant-name : String]
  [fields : AstTypeList]) : ResultTcType
  (if (= (ast-type-list-len (& fields)) 1)
    (ResultTcType.Ok
      (tc-resolve-type
        ctx
        (tc-context-type-get
          ctx
          (ast-type-list-get (& fields) 0 (ast-type-id-fallback)))))
    (ResultTcType.Err
      (string.append
        "typecheck: try requires Result-like variant with one payload "
        variant-name))))

(define (tc-result-info-build
  [ctx : TcContext]
  [try-kind : TcTryKind]
  [enum-name : String]
  [ok-name : String]
  [ok-fields : AstTypeList]
  [err-name : String]
  [err-fields : AstTypeList]) : ResultTcResultInfo
  (match (tc-result-variant-payload-type ctx ok-name ok-fields)
    [(ResultTcType.Ok ok-ty)
      (match (tc-result-variant-payload-type ctx err-name err-fields)
        [(ResultTcType.Ok err-ty)
          (ResultTcResultInfo.Ok
            (TcResultInfo
              try-kind
              enum-name
              (tc-qualified-variant-name enum-name ok-name)
              ok-ty
              (tc-qualified-variant-name enum-name err-name)
              err-ty))]
        [(ResultTcType.Err message) (ResultTcResultInfo.Err message)])]
    [(ResultTcType.Err message) (ResultTcResultInfo.Err message)]))

(define (tc-option-none-variant-type
  [variant-name : String]
  [fields : AstTypeList]) : ResultTcType
  (if (ast-type-list-empty? (& fields))
    (ResultTcType.Ok (AstType.Unit))
    (ResultTcType.Err
      (string.append
        "typecheck: try requires Option-like variant with no payload "
        variant-name))))

(define (tc-option-info-build
  [ctx : TcContext]
  [enum-name : String]
  [some-name : String]
  [some-fields : AstTypeList]
  [none-name : String]
  [none-fields : AstTypeList]) : ResultTcResultInfo
  (match (tc-result-variant-payload-type ctx some-name some-fields)
    [(ResultTcType.Ok some-ty)
      (match (tc-option-none-variant-type none-name none-fields)
        [(ResultTcType.Ok none-ty)
          (ResultTcResultInfo.Ok
            (TcResultInfo
              TcTryOption
              enum-name
              (tc-qualified-variant-name enum-name some-name)
              some-ty
              (tc-qualified-variant-name enum-name none-name)
              none-ty))]
        [(ResultTcType.Err message) (ResultTcResultInfo.Err message)])]
    [(ResultTcType.Err message) (ResultTcResultInfo.Err message)]))

(define (tc-result-info-two-variants
  [ctx : TcContext]
  [enum-name : String]
  [first-name : String]
  [first-fields : AstTypeList]
  [second-name : String]
  [second-fields : AstTypeList]) : ResultTcResultInfo
  (cond
    [(and (tc-ok-variant-name? first-name) (tc-err-variant-name? second-name))
      (tc-result-info-build
        ctx
        TcTryResult
        enum-name
        first-name
        first-fields
        second-name
        second-fields)]
    [(and (tc-err-variant-name? first-name) (tc-ok-variant-name? second-name))
      (tc-result-info-build
        ctx
        TcTryResult
        enum-name
        second-name
        second-fields
        first-name
        first-fields)]
    [(and
        (tc-some-variant-name? first-name)
        (tc-none-variant-name? second-name))
      (tc-option-info-build
        ctx
        enum-name
        first-name
        first-fields
        second-name
        second-fields)]
    [(and
        (tc-none-variant-name? first-name)
        (tc-some-variant-name? second-name))
      (tc-option-info-build
        ctx
        enum-name
        second-name
        second-fields
        first-name
        first-fields)]
    [else
      (ResultTcResultInfo.Err
        "typecheck: try requires Result-like Ok*/Err* or Option-like Some*/None* variants")]))

(define (tc-result-info-from-variants
  [ctx : TcContext]
  [enum-name : String]
  [variants : AstVariantDefList]) : ResultTcResultInfo
  (if (= (struct-get (& variants) len) 2)
    (let
      [first : AstVariantDef
        (ast-variant-def-list-get (& variants) 0 (ast-variant-def-fallback))]
      [second : AstVariantDef
        (ast-variant-def-list-get (& variants) 1 (ast-variant-def-fallback))]
      (match first
        [(AstVariantDef.Def first-name first-fields _)
          (match second
            [(AstVariantDef.Def second-name second-fields _)
              (tc-result-info-two-variants
                ctx
                enum-name
                (intern-str first-name)
                first-fields
                (intern-str second-name)
                second-fields)])]))
    (ResultTcResultInfo.Err
      "typecheck: try requires Result-like enum with exactly two variants")))

(define (tc-result-info [ctx : TcContext] [ty : AstType]) : ResultTcResultInfo
  (match (tc-type-strip-region ty)
    [(AstType.Enum enum-name)
      (let
        [enum-name-str : String (intern-str enum-name)]
        (match (tc-context-enum-variants ctx enum-name-str)
          [(ResultAstVariantDefList.Ok variants)
            (tc-result-info-from-variants ctx enum-name-str variants)]
          [(ResultAstVariantDefList.Err message)
            (ResultTcResultInfo.Err message)]))]
    [(AstType.EnumArgs enum-name _)
      (let
        [enum-name-str : String (intern-str enum-name)]
        (match (tc-program-enum-variants (tc-context-program ctx) enum-name-str)
          [(ResultAstVariantDefList.Ok variants)
            (tc-result-info-from-variants ctx enum-name-str variants)]
          [(ResultAstVariantDefList.Err message)
            (ResultTcResultInfo.Err message)]))]
    [_ (ResultTcResultInfo.Err "typecheck: try requires Result-like enum")]))

(define (tc-try-infos-compatible
  [operand-info : TcResultInfo]
  [return-info : TcResultInfo]) : ResultTcUnit
  (match (tc-result-info-kind operand-info)
    [(TcTryResult)
      (match (tc-result-info-kind return-info)
        [(TcTryResult)
          (tc-expect
            (tc-result-info-err-type operand-info)
            (tc-result-info-err-type return-info)
            "typecheck: try error type mismatch")]
        [(TcTryOption) (ResultTcUnit.Err "typecheck: try carrier mismatch")])]
    [(TcTryOption)
      (match (tc-result-info-kind return-info)
        [(TcTryOption) ResultTcUnit.Ok]
        [(TcTryResult) (ResultTcUnit.Err "typecheck: try carrier mismatch")])]))

(define (tc-try-expr [ctx : TcContext] [env : TcTypeEnv] [inner : AstExpr]) : ResultTcType
  (match (tc-expr ctx env inner)
    [(ResultTcType.Ok operand-ty)
      (match (tc-result-info ctx operand-ty)
        [(ResultTcResultInfo.Ok operand-info)
          (match (tc-current-return-type env)
            [(ResultTcType.Ok return-ty)
              (match (tc-result-info ctx return-ty)
                [(ResultTcResultInfo.Ok return-info)
                  (match (tc-try-infos-compatible operand-info return-info)
                    [(ResultTcUnit.Ok)
                      (ResultTcType.Ok (tc-result-info-ok-type operand-info))]
                    [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                [(ResultTcResultInfo.Err _)
                  (ResultTcType.Err
                    "typecheck: try requires enclosing Result-like function")])]
            [(ResultTcType.Err _)
              (ResultTcType.Err
                "typecheck: try requires enclosing Result-like function")])]
        [(ResultTcResultInfo.Err _)
          (ResultTcType.Err "typecheck: try operand must be Result-like enum")])]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (tc-return-expr [ctx : TcContext] [env : TcTypeEnv] [value : AstExpr]) : ResultTcType
  (match (tc-current-return-type env)
    [(ResultTcType.Ok return-ty)
      (match (tc-expr-with-expected-or-actual ctx env value return-ty)
        [(ResultTcType.Ok value-ty)
          (match (tc-expect
            value-ty
            return-ty
            "typecheck: return type mismatch")
            [(ResultTcUnit.Ok)
              (if (tc-expr-result-uses-active-cleanup-owner? env value)
                (ResultTcType.Err
                  "typecheck: cleanup-required resource would escape with scope")
                (ResultTcType.Ok (AstType.Never)))]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcType.Err _)
      (ResultTcType.Err "typecheck: return requires enclosing function")]))

(define (tc-variant-owner-name [ctx : TcContext] [handle : i64]) : ResultTcString
  (match (compiler-symbols-owner-name-at-index
    (tc-context-symbols ctx)
    (compiler-registry-handle-owner-index handle))
    [(CompilerSomeString name) (ResultTcString.Ok name)]
    [(CompilerNoString)
      (match (tc-context-program ctx)
        [(AstProgram.Program decls-box)
          (let
            [decls : AstDeclList (box-get decls-box)]
            (tc-variant-owner-name-list
              decls
              (compiler-registry-handle-owner-index handle)
              0
              ""))])]))

(define (tc-variant-owner-name-list
  [decls : AstDeclList]
  [target : i64]
  [index : i64]
  [module : String]) : ResultTcString
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil)
      (ResultTcString.Err "typecheck: variant owner is not enum")]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        (match decl
          [(AstDecl.Import _)
            (tc-variant-owner-name-list rest target index module)]
          [(AstDecl.IncludeStr _ _)
            (tc-variant-owner-name-list rest target index module)]
          [(AstDecl.IncludeBin _ _)
            (tc-variant-owner-name-list rest target index module)]
          [(AstDecl.Module next-module)
            (tc-variant-owner-name-list
              rest
              target
              index
              (intern-str next-module))]
          [(AstDecl.Test _ _ _)
            (tc-variant-owner-name-list rest target index module)]
          [(AstDecl.ComptimeDecl _ template-box)
            (let
              [template : AstDecl (box-get template-box)]
              (if (= target index)
                (match template
                  [(AstDecl.DefEnum name _ _)
                    (ResultTcString.Ok
                      (compiler-symbol-module-key module (intern-str name)))]
                  [(AstDecl.DefEnumLifetimes name _ _ _)
                    (ResultTcString.Ok
                      (compiler-symbol-module-key module (intern-str name)))]
                  [_
                    (ResultTcString.Err "typecheck: variant owner is not enum")])
                (tc-variant-owner-name-list rest target (+ index 1) module)))]
          [_
            (if (= target index)
              (match decl
                [(AstDecl.DefEnum name _ _)
                  (ResultTcString.Ok
                    (compiler-symbol-module-key module (intern-str name)))]
                [(AstDecl.DefEnumLifetimes name _ _ _)
                  (ResultTcString.Ok
                    (compiler-symbol-module-key module (intern-str name)))]
                [_ (ResultTcString.Err "typecheck: variant owner is not enum")])
              (tc-variant-owner-name-list rest target (+ index 1) module))]))]))

(define (tc-variant-constructor-type-for-handle
  [ctx : TcContext]
  [handle : i64]) : ResultTcType
  (match (tc-variant-owner-name ctx handle)
    [(ResultTcString.Ok owner)
      (match (compiler-registries-variant-fields-indexed
        (tc-context-symbols ctx)
        handle)
        [(ResultAstTypeList.Ok fields)
          (match (tc-nominal-lifetimes ctx owner)
            [(ResultTcLifetimeList.Ok lifetimes)
              (ResultTcType.Ok
                (tc-enum-variant-constructor-type ctx owner lifetimes fields))]
            [(ResultTcLifetimeList.Err message) (ResultTcType.Err message)])]
        [(ResultAstTypeList.Err message) (ResultTcType.Err message)])]
    [(ResultTcString.Err message) (ResultTcType.Err message)]))

(define (tc-variant-constructor-type-for-lookup-or
  [ctx : TcContext]
  [lookup-name : String]
  [_display-name : String]
  [not-found-message : String]) : ResultTcType
  (let
    [registries : CompilerRegistries (tc-context-registries ctx)]
    [lookup-id : i64 (tc-name-id lookup-name)]
    (match (compiler-registries-lookup-variant-id registries lookup-id)
      [(option_i64.Some handle)
        (tc-variant-constructor-type-for-handle ctx handle)]
      [(option_i64.None)
        (match (tc-enum-qualified-variant-lookup-handle
          ctx
          lookup-name
          lookup-id)
          [(option_i64.Some handle)
            (tc-variant-constructor-type-for-handle ctx handle)]
          [(option_i64.None) (ResultTcType.Err not-found-message)])])))

(define (tc-struct-field-type
  [ctx : TcContext]
  [struct-name : String]
  [field : String]) : ResultTcType
  (let
    [handle : i64
      (compiler-registries-lookup-struct-field-or
        (tc-context-registries ctx)
        struct-name
        field
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (let
        [field-ctx : TcContext
          (tc-context-with-nominal-owner-index-module
            ctx
            (compiler-registry-handle-owner-index handle))]
        (match (compiler-registries-struct-field-type-indexed
          (tc-context-symbols ctx)
          handle)
          [(ResultAstType.Ok ty)
            (ResultTcType.Ok (tc-resolve-type field-ctx ty))]
          [(ResultAstType.Err message) (ResultTcType.Err message)]))
      (ResultTcType.Err
        (string.append
          "typecheck: unknown struct field "
          (compiler-struct-field-key struct-name field))))))

(define (tc-lifetime-subst-from-nominal-args
  [ctx : TcContext]
  [name : String]
  [args : AstLifetimeList]) : ResultTcLifetimeSubst
  (match (tc-nominal-lifetimes ctx name)
    [(ResultTcLifetimeList.Ok params)
      (tc-infer-lifetime-list params TcLifetimeSubst.Nil params args)]
    [(ResultTcLifetimeList.Err message) (ResultTcLifetimeSubst.Err message)]))

(define (tc-struct-field-type-with-args
  [ctx : TcContext]
  [struct-name : String]
  [lifetimes : AstLifetimeList]
  [field : String]) : ResultTcType
  (let
    [handle : i64
      (compiler-registries-lookup-struct-field-or
        (tc-context-registries ctx)
        struct-name
        field
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (let
        [field-ctx : TcContext
          (tc-context-with-nominal-owner-index-module
            ctx
            (compiler-registry-handle-owner-index handle))]
        (match (compiler-registries-struct-field-type
          (tc-context-program ctx)
          handle)
          [(ResultAstType.Ok ty)
            (match (tc-lifetime-subst-from-nominal-args
              field-ctx
              struct-name
              lifetimes)
              [(ResultTcLifetimeSubst.Ok subst)
                (ResultTcType.Ok
                  (tc-resolve-type field-ctx (tc-lifetime-subst-type subst ty)))]
              [(ResultTcLifetimeSubst.Err message) (ResultTcType.Err message)])]
          [(ResultAstType.Err message) (ResultTcType.Err message)]))
      (ResultTcType.Err
        (string.append
          "typecheck: unknown struct field "
          (compiler-struct-field-key struct-name field))))))

(define (tc-comptime-unknown-field [owner : String] [field : String]) : ResultTcType
  (ResultTcType.Err
    (string.append
      "typecheck: unknown struct field "
      (compiler-struct-field-key owner field))))

(define (tc-comptime-sequence-field-type
  [owner : String]
  [elem-ty : AstType]
  [field : String]) : ResultTcType
  (cond
    [(string.eq field "items")
      (ResultTcType.Ok (AstType.DynArray (ty-node-push elem-ty)))]
    [(string.eq field "len") (ResultTcType.Ok (AstType.I64))]
    [else (tc-comptime-unknown-field owner field)]))

(define (tc-comptime-expr-clause-field-type [field : String]) : ResultTcType
  (cond
    [(string.eq field "first") (ResultTcType.Ok (AstType.Expr))]
    [(string.eq field "second") (ResultTcType.Ok (AstType.Expr))]
    [else (tc-comptime-unknown-field "ExprClause" field)]))

(define (tc-comptime-expr-binding-clause-field-type [field : String]) : ResultTcType
  (cond
    [(string.eq field "name") (ResultTcType.Ok (AstType.String))]
    [(string.eq field "has-type") (ResultTcType.Ok (AstType.Bool))]
    [(string.eq field "ty") (ResultTcType.Ok (AstType.Expr))]
    [(string.eq field "init") (ResultTcType.Ok (AstType.Expr))]
    [else (tc-comptime-unknown-field "ExprBindingClause" field)]))

(define (tc-comptime-match-arm-field-type [field : String]) : ResultTcType
  (cond
    [(string.eq field "pattern") (ResultTcType.Ok (tc-macro-pattern-type))]
    [(string.eq field "body") (ResultTcType.Ok (AstType.Expr))]
    [else (tc-comptime-unknown-field "MatchArm" field)]))

(define (tc-struct-get-result-type
  [ctx : TcContext]
  [receiver-ty : AstType]
  [field : String]) : ResultTcType
  (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
    [(AstType.Struct struct-name)
      (match (tc-struct-field-type ctx (intern-str struct-name) field)
        [(ResultTcType.Ok field-ty)
          (ResultTcType.Ok
            (tc-project-from-region-container receiver-ty field-ty))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(AstType.StructArgs struct-name lifetimes)
      (match (tc-struct-field-type-with-args
        ctx
        (intern-str struct-name)
        (box-get lifetimes)
        field)
        [(ResultTcType.Ok field-ty)
          (ResultTcType.Ok
            (tc-project-from-region-container receiver-ty field-ty))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(AstType.Ref lifetime referent-ty)
      (match (tc-struct-get-result-type ctx (ty-node-get referent-ty) field)
        [(ResultTcType.Ok field-ty)
          (ResultTcType.Ok (tc-tag-region lifetime field-ty))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(AstType.MutRef lifetime referent-ty)
      (match (tc-struct-get-result-type ctx (ty-node-get referent-ty) field)
        [(ResultTcType.Ok field-ty)
          (ResultTcType.Ok (tc-tag-region lifetime field-ty))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(AstType.ExprList)
      (tc-comptime-sequence-field-type "ExprList" (AstType.Expr) field)]
    [(AstType.Var name)
      (cond
        [(= name (intern "ExprClause"))
          (tc-comptime-expr-clause-field-type field)]
        [(= name (intern "ExprClauseList"))
          (tc-comptime-sequence-field-type
            "ExprClauseList"
            (tc-macro-expr-clause-type)
            field)]
        [(= name (intern "ExprBindingClause"))
          (tc-comptime-expr-binding-clause-field-type field)]
        [(= name (intern "ExprBindingClauseList"))
          (tc-comptime-sequence-field-type
            "ExprBindingClauseList"
            (tc-macro-expr-binding-clause-type)
            field)]
        [(= name (intern "PatternList"))
          (tc-comptime-sequence-field-type
            "PatternList"
            (tc-macro-pattern-type)
            field)]
        [(= name (intern "MatchArm")) (tc-comptime-match-arm-field-type field)]
        [(= name (intern "MatchArmList"))
          (tc-comptime-sequence-field-type
            "MatchArmList"
            (tc-macro-match-arm-type)
            field)]
        [else (ResultTcType.Err "typecheck: struct-get requires struct")])]
    [_ (ResultTcType.Err "typecheck: struct-get requires struct")]))

(define (tc-borrow-place-var-by-value [name : String] [ty : AstType]) : ResultTcBorrowPlace
  (match (tc-type-outer-region ty)
    [(TcMaybeString.Some region)
      (ResultTcBorrowPlace.Ok
        (TcBorrowPlace region (tc-borrow-referent-type ty)))]
    [(TcMaybeString.No)
      (ResultTcBorrowPlace.Ok (TcBorrowPlace name (tc-borrow-referent-type ty)))]))

(define (tc-reference-containing-place-borrow-ok? [ty : AstType]) : bool
  (match (tc-type-strip-region ty)
    [(AstType.EnumArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [(AstType.StructArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [(AstType.VarArgs _ lifetimes)
      (> (tc-lifetime-list-count (box-get lifetimes)) 0)]
    [_ false]))

(define (tc-borrow-place-var [name : String] [ty : AstType]) : ResultTcBorrowPlace
  (match (tc-type-strip-region ty)
    [(AstType.Ref lifetime referent-ty)
      (ResultTcBorrowPlace.Ok
        (TcBorrowPlace
          lifetime
          (tc-borrow-referent-type (ty-node-get referent-ty))))]
    [(AstType.MutRef lifetime referent-ty)
      (ResultTcBorrowPlace.Ok
        (TcBorrowPlace
          lifetime
          (tc-borrow-referent-type (ty-node-get referent-ty))))]
    [_
      (if (and
        (tc-type-contains-reference? ty)
        (not (tc-reference-containing-place-borrow-ok? ty)))
        (ResultTcBorrowPlace.Err
          "typecheck: borrowing places that contain references is not implemented")
        (tc-borrow-place-var-by-value name ty))]))

(define (tc-borrow-referent-type [ty : AstType]) : AstType
  (match (tc-type-without-regions ty)
    [(AstType.String) (AstType.Str)]
    [_ (tc-type-without-regions ty)]))

(define (tc-borrow-place-struct-field
  [ctx : TcContext]
  [place : TcBorrowPlace]
  [field : String]) : ResultTcBorrowPlace
  (match place
    [(TcBorrowPlace lifetime receiver-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
        [(AstType.Struct struct-name)
          (match (tc-struct-field-type ctx (intern-str struct-name) field)
            [(ResultTcType.Ok field-ty)
              (ResultTcBorrowPlace.Ok
                (TcBorrowPlace lifetime (tc-borrow-referent-type field-ty)))]
            [(ResultTcType.Err message) (ResultTcBorrowPlace.Err message)])]
        [(AstType.StructArgs struct-name lifetimes)
          (match (tc-struct-field-type-with-args
            ctx
            (intern-str struct-name)
            (box-get lifetimes)
            field)
            [(ResultTcType.Ok field-ty)
              (ResultTcBorrowPlace.Ok
                (TcBorrowPlace lifetime (tc-borrow-referent-type field-ty)))]
            [(ResultTcType.Err message) (ResultTcBorrowPlace.Err message)])]
        [_
          (ResultTcBorrowPlace.Err
            "typecheck: struct-get borrow requires struct place")])]))

(define (tc-borrow-place-tuple-field
  [ctx : TcContext]
  [place : TcBorrowPlace]
  [index : i64]) : ResultTcBorrowPlace
  (match place
    [(TcBorrowPlace lifetime tuple-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx tuple-ty))
        [(AstType.Tuple elems)
          (match (tc-type-list-ref (box-get elems) index)
            [(ResultTcType.Ok elem-ty)
              (ResultTcBorrowPlace.Ok
                (TcBorrowPlace lifetime (tc-borrow-referent-type elem-ty)))]
            [(ResultTcType.Err message) (ResultTcBorrowPlace.Err message)])]
        [_
          (ResultTcBorrowPlace.Err
            "typecheck: tuple-ref borrow requires tuple place")])]))

(define (tc-borrow-place-array-element
  [ctx : TcContext]
  [place : TcBorrowPlace]) : ResultTcBorrowPlace
  (match place
    [(TcBorrowPlace lifetime array-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx array-ty))
        [(AstType.Array elem-ty _)
          (ResultTcBorrowPlace.Ok
            (TcBorrowPlace
              lifetime
              (tc-borrow-referent-type (ty-node-get elem-ty))))]
        [(AstType.DynArray elem-ty)
          (ResultTcBorrowPlace.Ok
            (TcBorrowPlace
              lifetime
              (tc-borrow-referent-type (ty-node-get elem-ty))))]
        [_
          (ResultTcBorrowPlace.Err
            "typecheck: array-ref borrow requires array place")])]))

(define (tc-borrow-place-box-get [ctx : TcContext] [place : TcBorrowPlace]) : ResultTcBorrowPlace
  (match place
    [(TcBorrowPlace lifetime box-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx box-ty))
        [(AstType.Box inner-ty)
          (ResultTcBorrowPlace.Ok
            (TcBorrowPlace
              lifetime
              (tc-borrow-referent-type (ty-node-get inner-ty))))]
        [_
          (ResultTcBorrowPlace.Err
            "typecheck: box-get borrow requires Box place")])]))

(define (tc-borrow-place [ctx : TcContext] [env : TcTypeEnv] [expr : AstExpr]) : ResultTcBorrowPlace
  (match (ast-expr-unspan expr)
    [(AstExpr.Var name)
      (let
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-expr-id env name-text)
            [(ResultTcExprId.Ok virtual-id)
              (tc-borrow-place ctx env (ast-node-get virtual-id))]
            [(ResultTcExprId.Err message) (ResultTcBorrowPlace.Err message)])
          (match (tc-lookup-visible-id ctx env name)
            [(ResultTcType.Ok ty) (tc-borrow-place-var name-text ty)]
            [(ResultTcType.Err message) (ResultTcBorrowPlace.Err message)])))]
    [(AstExpr.StructGet receiver-box field)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (match (tc-borrow-place ctx env receiver)
          [(ResultTcBorrowPlace.Ok place)
            (tc-borrow-place-struct-field ctx place (intern-str field))]
          [(ResultTcBorrowPlace.Err message) (ResultTcBorrowPlace.Err message)]))]
    [(AstExpr.TupleRef tuple-box index)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        (match (tc-borrow-place ctx env tuple)
          [(ResultTcBorrowPlace.Ok place)
            (tc-borrow-place-tuple-field ctx place index)]
          [(ResultTcBorrowPlace.Err message) (ResultTcBorrowPlace.Err message)]))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-expr ctx env index)
          [(ResultTcType.Ok index-ty)
            (if (tc-integer-type? index-ty)
              (match (tc-borrow-place ctx env array)
                [(ResultTcBorrowPlace.Ok place)
                  (tc-borrow-place-array-element ctx place)]
                [(ResultTcBorrowPlace.Err message)
                  (ResultTcBorrowPlace.Err message)])
              (ResultTcBorrowPlace.Err "typecheck: array index must be integer"))]
          [(ResultTcType.Err message) (ResultTcBorrowPlace.Err message)]))]
    [(AstExpr.BoxGet box-box)
      (let
        [box-expr : AstExpr (ast-node-get box-box)]
        (match (tc-borrow-place ctx env box-expr)
          [(ResultTcBorrowPlace.Ok place) (tc-borrow-place-box-get ctx place)]
          [(ResultTcBorrowPlace.Err message) (ResultTcBorrowPlace.Err message)]))]
    [_
      (ResultTcBorrowPlace.Err
        "typecheck: borrow requires a local, parameter, or aggregate place")]))

(define (tc-mut-borrow-by-value-place-message) : String
  "typecheck: mutable borrow of by-value place is only supported as an immediate call argument")

(define (tc-mut-borrow-storage-backed-type? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Ref _ _) true]
    [(AstType.MutRef _ _) true]
    [(AstType.Tuple _) true]
    [(AstType.Array _ _) true]
    [(AstType.DynArray _) true]
    [(AstType.Struct name)
      (not (tc-name-register-resident? ctx (intern-str name)))]
    [(AstType.StructArgs name _)
      (not (tc-name-register-resident? ctx (intern-str name)))]
    [(AstType.Enum name)
      (not (tc-name-register-resident? ctx (intern-str name)))]
    [(AstType.EnumArgs name _)
      (not (tc-name-register-resident? ctx (intern-str name)))]
    [_ false]))

(define (tc-mut-borrow-non-call-place-ok
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]) : ResultTcUnit
  (match (ast-expr-unspan expr)
    [(AstExpr.Var name)
      (match (tc-lookup-visible-id ctx env name)
        [(ResultTcType.Ok ty)
          (if (tc-mut-borrow-storage-backed-type? ctx ty)
            ResultTcUnit.Ok
            (ResultTcUnit.Err (tc-mut-borrow-by-value-place-message)))]
        [(ResultTcType.Err message) (ResultTcUnit.Err message)])]
    [(AstExpr.StructGet receiver-box _)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (tc-mut-borrow-non-call-place-ok ctx env receiver))]
    [(AstExpr.TupleRef tuple-box _)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        (tc-mut-borrow-non-call-place-ok ctx env tuple))]
    [(AstExpr.ArrayRef array-box _)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-mut-borrow-non-call-place-ok ctx env array))]
    [(AstExpr.BoxGet box-box)
      (let
        [box-expr : AstExpr (ast-node-get box-box)]
        (match (tc-store-place-lifetime ctx env box-expr)
          [(ResultTcString.Ok _)
            (match (tc-expr ctx env box-expr)
              [(ResultTcType.Ok box-ty)
                (match (tc-box-set-inner-type ctx box-ty)
                  [(ResultTcType.Ok _) ResultTcUnit.Ok]
                  [(ResultTcType.Err message) (ResultTcUnit.Err message)])]
              [(ResultTcType.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcString.Err message) (ResultTcUnit.Err message)]))]
    [_ ResultTcUnit.Ok]))

(define (tc-store-place-lifetime-var [name : String] [ty : AstType]) : ResultTcString
  (match (tc-type-outer-region ty)
    [(TcMaybeString.Some region) (ResultTcString.Ok region)]
    [(TcMaybeString.No) (ResultTcString.Ok name)]))

(define (tc-store-place-lifetime
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]) : ResultTcString
  (match (ast-expr-unspan expr)
    [(AstExpr.Var name)
      (let
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-expr-id env name-text)
            [(ResultTcExprId.Ok virtual-id)
              (tc-store-place-lifetime ctx env (ast-node-get virtual-id))]
            [(ResultTcExprId.Err message) (ResultTcString.Err message)])
          (match (tc-lookup-visible-id ctx env name)
            [(ResultTcType.Ok ty) (tc-store-place-lifetime-var name-text ty)]
            [(ResultTcType.Err message) (ResultTcString.Err message)])))]
    [(AstExpr.StructGet receiver-box _)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        (tc-store-place-lifetime ctx env receiver))]
    [(AstExpr.TupleRef tuple-box _)
      (let
        [tuple : AstExpr (ast-node-get tuple-box)]
        (tc-store-place-lifetime ctx env tuple))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-expr ctx env index)
          [(ResultTcType.Ok index-ty)
            (if (tc-integer-type? index-ty)
              (tc-store-place-lifetime ctx env array)
              (ResultTcString.Err "typecheck: array index must be integer"))]
          [(ResultTcType.Err message) (ResultTcString.Err message)]))]
    [(AstExpr.BoxGet box-box)
      (let
        [box-expr : AstExpr (ast-node-get box-box)]
        (match (tc-expr ctx env box-expr)
          [(ResultTcType.Ok box-ty)
            (match (tc-box-set-inner-type ctx box-ty)
              [(ResultTcType.Ok _) (tc-store-place-lifetime ctx env box-expr)]
              [(ResultTcType.Err message) (ResultTcString.Err message)])]
          [(ResultTcType.Err message) (ResultTcString.Err message)]))]
    [_ (ResultTcString.Err "typecheck: expression is not a storage place")]))

(define (tc-ensure-reference-value-can-store-in-place
  [ctx : TcContext]
  [env : TcTypeEnv]
  [place-expr : AstExpr]
  [value-ty : AstType]
  [context : String]) : ResultTcUnit
  (let
    [lifetimes : TcStringList (tc-type-collect-reference-lifetimes value-ty)]
    (match lifetimes
      [(TcStringList.Nil) ResultTcUnit.Ok]
      [_
        (match (tc-store-place-lifetime ctx env place-expr)
          [(ResultTcString.Ok target-lifetime)
            (if (tc-reference-lifetimes-outlive-lifetime?
              env
              lifetimes
              target-lifetime)
              ResultTcUnit.Ok
              (ResultTcUnit.Err
                (string.append
                  "typecheck: cannot store reference into longer-lived "
                  (string.append
                    context
                    "; reference value would escape lexical scope"))))]
          [(ResultTcString.Err _)
            (ResultTcUnit.Err
              (string.append
                "typecheck: cannot store reference into non-place "
                (string.append
                  context
                  "; reference value would escape lexical scope")))])])))

(define (tc-borrow-place-result-type
  [mutable : bool]
  [lifetime : AstBorrowLifetime]
  [place : TcBorrowPlace]) : ResultTcType
  (match place
    [(TcBorrowPlace inferred referent-ty)
      (match lifetime
        [(AstBorrowLifetime.Inferred)
          (ResultTcType.Ok
            (if mutable
              (ast-ty-mut-ref inferred referent-ty)
              (ast-ty-ref inferred referent-ty)))]
        [(AstBorrowLifetime.Named requested)
          (if (string.eq requested inferred)
            (ResultTcType.Ok
              (if mutable
                (ast-ty-mut-ref inferred referent-ty)
                (ast-ty-ref inferred referent-ty)))
            (ResultTcType.Err "typecheck: borrow lifetime mismatch"))])]))

(define (tc-borrow-expr-with-policy
  [ctx : TcContext]
  [env : TcTypeEnv]
  [mutable : bool]
  [lifetime : AstBorrowLifetime]
  [place-expr : AstExpr]
  [allow-mut-by-value-borrow : bool]) : ResultTcType
  (match (tc-borrow-place ctx env place-expr)
    [(ResultTcBorrowPlace.Ok place)
      (if (and mutable (not allow-mut-by-value-borrow))
        (match (tc-mut-borrow-non-call-place-ok ctx env place-expr)
          [(ResultTcUnit.Ok)
            (tc-borrow-place-result-type mutable lifetime place)]
          [(ResultTcUnit.Err message) (ResultTcType.Err message)])
        (tc-borrow-place-result-type mutable lifetime place))]
    [(ResultTcBorrowPlace.Err message) (ResultTcType.Err message)]))

(define (tc-borrow-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [mutable : bool]
  [lifetime : AstBorrowLifetime]
  [place-expr : AstExpr]) : ResultTcType
  (tc-borrow-expr-with-policy ctx env mutable lifetime place-expr false))

(define (tc-literal-pattern-compatible? [lit : AstLiteral] [scrut-ty : AstType]) : bool
  (let
    [lit-ty : AstType (tc-literal-type lit)]
    (match lit
      [(AstLiteral.Int _ _) (tc-integer-type? scrut-ty)]
      [_ (tc-type-eq lit-ty scrut-ty)])))

(define (tc-bind-literal-pattern
  [env : TcTypeEnv]
  [lit : AstLiteral]
  [scrut-ty : AstType]) : ResultTcEnv
  (match (tc-literal-type-checked lit)
    [(ResultTcType.Ok _)
      (if (tc-literal-pattern-compatible? lit scrut-ty)
        (ResultTcEnv.Ok env)
        (ResultTcEnv.Err "typecheck: literal pattern type mismatch"))]
    [(ResultTcType.Err message) (ResultTcEnv.Err message)]))

(define (tc-bind-scalar-match-pattern
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [pattern : AstPattern]) : ResultTcEnv
  (match pattern
    [(AstPattern.Wildcard) (ResultTcEnv.Ok env)]
    [(AstPattern.Binding name) (ResultTcEnv.Ok (tc-bind-id env name scrut-ty))]
    [(AstPattern.Literal lit) (tc-bind-literal-pattern env lit scrut-ty)]
    [(AstPattern.Variant name _)
      (if (tc-box-pattern-name? name)
        (ResultTcEnv.Err "typecheck: box pattern requires Box scrutinee")
        (ResultTcEnv.Err
          "typecheck: scalar match only supports literal, binding, or wildcard patterns"))]
    [_
      (ResultTcEnv.Err
        "typecheck: scalar match only supports literal, binding, or wildcard patterns")]))

(define (tc-bind-sub-pattern-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [patterns : AstPatternList]
  [types : AstTypeList]) : ResultTcEnv
  (tc-bind-sub-pattern-list-at ctx env (& patterns) (& types) 0))

(define (tc-bind-sub-pattern-list-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [patterns : (& patterns AstPatternList)]
  [types : (& types AstTypeList)]
  [index : i64]) : ResultTcEnv
  (if (>= index (ast-pattern-list-len patterns))
    (if (>= index (ast-type-list-len types))
      (ResultTcEnv.Ok env)
      (ResultTcEnv.Err "typecheck: pattern arity mismatch"))
    (if (>= index (ast-type-list-len types))
      (ResultTcEnv.Err "typecheck: pattern arity mismatch")
      (let
        [pattern : AstPattern
          (ast-pattern-list-get patterns index (ast-pattern-fallback))]
        [ty : AstType
          (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))]
        (match (tc-bind-sub-pattern ctx env pattern ty)
          [(ResultTcEnv.Ok next-env)
            (tc-bind-sub-pattern-list-at
              ctx
              next-env
              patterns
              types
              (+ index 1))]
          [(ResultTcEnv.Err message) (ResultTcEnv.Err message)])))))

(define (tc-nominal-owner-context [ctx : TcContext] [owner-name : String]) : TcContext
  (if (tc-name-qualified? owner-name)
    (tc-context-with-module ctx (tc-qualified-name-module owner-name))
    ctx))

(defenum ResultTcVariantPayloadTypes
  (Ok AstTypeList)
  (Err String))

(define (tc-variant-pattern-payload-types
  [ctx : TcContext]
  [enum-name : String]
  [enum-lifetimes : AstLifetimeList]
  [fields : AstTypeList]) : ResultTcVariantPayloadTypes
  (let
    [field-ctx : TcContext (tc-nominal-owner-context ctx enum-name)]
    [resolved-fields : AstTypeList (tc-resolve-type-list field-ctx fields)]
    (if (ast-lifetime-list-empty? (& enum-lifetimes))
      (ResultTcVariantPayloadTypes.Ok resolved-fields)
      (match (tc-lifetime-subst-from-nominal-args
        field-ctx
        enum-name
        enum-lifetimes)
        [(ResultTcLifetimeSubst.Ok subst)
          (ResultTcVariantPayloadTypes.Ok
            (tc-lifetime-subst-type-list subst resolved-fields))]
        [(ResultTcLifetimeSubst.Err message)
          (ResultTcVariantPayloadTypes.Err message)]))))

(define (tc-bind-variant-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [variant-name : String]
  [enum-lifetimes : AstLifetimeList]
  [args : AstPatternList]
  [payload-regions : TcStringList]) : ResultTcEnv
  (let
    [handle : i64
      (tc-source-variant-handle-for-enum-or
        ctx
        enum-name
        variant-name
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (match (tc-variant-owner-name ctx handle)
        [(ResultTcString.Ok owner)
          (if (string.eq owner enum-name)
            (match (compiler-registries-variant-fields-indexed
              (tc-context-symbols ctx)
              handle)
              [(ResultAstTypeList.Ok fields)
                (match (tc-variant-pattern-payload-types
                  ctx
                  enum-name
                  enum-lifetimes
                  fields)
                  [(ResultTcVariantPayloadTypes.Ok payload-fields)
                    (tc-bind-sub-pattern-list
                      ctx
                      env
                      args
                      (tc-tag-type-list-regions payload-regions payload-fields))]
                  [(ResultTcVariantPayloadTypes.Err message)
                    (ResultTcEnv.Err message)])]
              [(ResultAstTypeList.Err message) (ResultTcEnv.Err message)])
            (ResultTcEnv.Err
              (string.append
                "typecheck: variant "
                (string.append
                  variant-name
                  (string.append
                    " belongs to enum "
                    (string.append owner (string.append ", not " enum-name)))))))]
        [(ResultTcString.Err message) (ResultTcEnv.Err message)])
      (ResultTcEnv.Err
        (string.append "typecheck: unknown variant " variant-name)))))

(define (tc-box-pattern-name? [name : i64]) : bool
  (string.eq (intern-str name) "box"))

(define (tc-box-pattern-args-supported?
  [ctx : TcContext]
  [args : AstPatternList]
  [inner-ty : AstType]) : bool
  (let
    [args-ref : (& args AstPatternList) (& args)]
    (if (= (struct-get args-ref len) 1)
      (tc-box-pattern-inner-supported?
        ctx
        (ast-pattern-list-get args-ref 0 (ast-pattern-fallback))
        inner-ty)
      false)))

(define (tc-box-pattern-inner-supported?
  [ctx : TcContext]
  [pattern : AstPattern]
  [inner-ty : AstType]) : bool
  (match pattern
    [(AstPattern.Wildcard) true]
    [(AstPattern.Binding _) true]
    [(AstPattern.Variant name args-box)
      (if (tc-box-pattern-name? name)
        (match (tc-type-strip-region (tc-resolve-type ctx inner-ty))
          [(AstType.Box nested-inner)
            (tc-box-pattern-args-supported?
              ctx
              (box-get args-box)
              (ty-node-get nested-inner))]
          [_ false])
        false)]
    [_ false]))

(define (tc-bind-box-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstPatternList]
  [inner-ty : AstType]) : ResultTcEnv
  (let
    [args-ref : (& args AstPatternList) (& args)]
    (if (= (struct-get args-ref len) 1)
      (let
        [inner : AstPattern
          (ast-pattern-list-get args-ref 0 (ast-pattern-fallback))]
        (if (tc-box-pattern-inner-supported? ctx inner inner-ty)
          (tc-bind-sub-pattern ctx env inner inner-ty)
          (ResultTcEnv.Err
            "typecheck: box pattern only supports irrefutable binding, wildcard, or nested box patterns")))
      (ResultTcEnv.Err
        "typecheck: box pattern expects exactly one inner pattern"))))

(define (tc-struct-pattern-name-in-scrut-module
  [ctx : TcContext]
  [struct-name : String]
  [name : String]) : String
  (if (tc-name-qualified? name)
    (let
      [qualifier : String (tc-qualified-name-module name)]
      [base : String (tc-qualified-name-base name)]
      [target-module : String (tc-qualified-access-target-module ctx qualifier)]
      (compiler-symbol-module-key target-module base))
    (let
      [module : String (tc-qualified-name-module struct-name)]
      (if (string.eq module "")
        name
        (compiler-symbol-module-key module name)))))

(define (tc-source-struct-name-for-pattern
  [ctx : TcContext]
  [struct-name : String]
  [pattern-name : String]) : ResultTcString
  (if (tc-name-qualified? pattern-name)
    (let
      [qualifier : String (tc-qualified-name-module pattern-name)]
      [base : String (tc-qualified-name-base pattern-name)]
      [target-module : String (tc-qualified-access-target-module ctx qualifier)]
      (ResultTcString.Ok (compiler-symbol-module-key target-module base)))
    (match (tc-source-type-name-lookup-key ctx pattern-name)
      [(ResultTcString.Ok lookup-name)
        (ResultTcString.Ok
          (tc-struct-pattern-name-in-scrut-module ctx struct-name lookup-name))]
      [(ResultTcString.Err message) (ResultTcString.Err message)])))

(define (tc-struct-pattern-name-matches?
  [ctx : TcContext]
  [struct-name : String]
  [pattern-name : String]) : bool
  (match (tc-source-struct-name-for-pattern ctx struct-name pattern-name)
    [(ResultTcString.Ok lookup-name) (string.eq lookup-name struct-name)]
    [(ResultTcString.Err _) false]))

(define (tc-struct-pattern-head-message
  [pattern-name : String]
  [struct-name : String]) : String
  (str_cat.str-cat
    "typecheck: struct pattern head "
    pattern-name
    " does not match struct "
    struct-name))

(define (tc-struct-pattern-field-types-for-scrut
  [ctx : TcContext]
  [struct-name : String]
  [scrut-ty : AstType]
  [fields : AstFieldDefList]) : ResultTcTypeList
  (let
    [field-types : AstTypeList (tc-field-type-list ctx fields)]
    [resolved-scrut-ty : AstType
      (tc-type-strip-region (tc-resolve-type ctx scrut-ty))]
    (match resolved-scrut-ty
      [(AstType.StructArgs _ lifetimes)
        (match (tc-lifetime-subst-from-nominal-args
          ctx
          struct-name
          (box-get lifetimes))
          [(ResultTcLifetimeSubst.Ok subst)
            (ResultTcTypeList.Ok
              (tc-project-type-list-from-region-container
                scrut-ty
                (tc-lifetime-subst-type-list subst field-types)))]
          [(ResultTcLifetimeSubst.Err message) (ResultTcTypeList.Err message)])]
      [(AstType.VarArgs _ lifetimes)
        (match (tc-lifetime-subst-from-nominal-args
          ctx
          struct-name
          (box-get lifetimes))
          [(ResultTcLifetimeSubst.Ok subst)
            (ResultTcTypeList.Ok
              (tc-project-type-list-from-region-container
                scrut-ty
                (tc-lifetime-subst-type-list subst field-types)))]
          [(ResultTcLifetimeSubst.Err message) (ResultTcTypeList.Err message)])]
      [_
        (ResultTcTypeList.Ok
          (tc-project-type-list-from-region-container scrut-ty field-types))])))

(define (tc-bind-struct-field-pattern-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [patterns : AstPatternList]
  [types : AstTypeList]) : ResultTcEnv
  (tc-bind-struct-field-pattern-list-at ctx env (& patterns) (& types) 0))

(define (tc-bind-struct-field-pattern-list-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [patterns : (& patterns AstPatternList)]
  [types : (& types AstTypeList)]
  [index : i64]) : ResultTcEnv
  (if (>= index (ast-pattern-list-len patterns))
    (if (>= index (ast-type-list-len types))
      (ResultTcEnv.Ok env)
      (ResultTcEnv.Err "typecheck: pattern arity mismatch"))
    (if (>= index (ast-type-list-len types))
      (ResultTcEnv.Err "typecheck: pattern arity mismatch")
      (let
        [pattern : AstPattern
          (ast-pattern-list-get patterns index (ast-pattern-fallback))]
        [ty : AstType
          (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))]
        (match (tc-bind-struct-field-pattern ctx env pattern ty)
          [(ResultTcEnv.Ok next-env)
            (tc-bind-struct-field-pattern-list-at
              ctx
              next-env
              patterns
              types
              (+ index 1))]
          [(ResultTcEnv.Err message) (ResultTcEnv.Err message)])))))

(define (tc-bind-struct-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [scrut-ty : AstType]
  [pattern-name : String]
  [args : AstPatternList]) : ResultTcEnv
  (match (tc-source-struct-name-for-pattern ctx struct-name pattern-name)
    [(ResultTcString.Ok lookup-name)
      (if (string.eq lookup-name struct-name)
        (match (tc-struct-decl ctx struct-name)
          [(ResultTcStructDecl.Ok decl)
            (match decl
              [(TcStructDecl _ _ fields)
                (match (tc-struct-pattern-field-types-for-scrut
                  ctx
                  struct-name
                  scrut-ty
                  fields)
                  [(ResultTcTypeList.Ok field-types)
                    (tc-bind-struct-field-pattern-list ctx env args field-types)]
                  [(ResultTcTypeList.Err message) (ResultTcEnv.Err message)])])]
          [(ResultTcStructDecl.Err message) (ResultTcEnv.Err message)])
        (ResultTcEnv.Err
          (tc-struct-pattern-head-message pattern-name struct-name)))]
    [(ResultTcString.Err message) (ResultTcEnv.Err message)]))

(define (tc-bind-struct-field-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [pattern : AstPattern]
  [field-ty : AstType]) : ResultTcEnv
  (let
    [ty : AstType (tc-resolve-type ctx field-ty)]
    (match pattern
      [(AstPattern.Var name _) (ResultTcEnv.Ok (tc-bind-id env name ty))]
      [(AstPattern.Binding name) (ResultTcEnv.Ok (tc-bind-id env name ty))]
      [(AstPattern.Wildcard) (ResultTcEnv.Ok env)]
      [(AstPattern.Variant name args-box)
        (let
          [args : AstPatternList (box-get args-box)]
          (match (tc-type-strip-region ty)
            [(AstType.Struct struct-name)
              (tc-bind-struct-pattern
                ctx
                env
                (intern-str struct-name)
                ty
                (intern-str name)
                args)]
            [(AstType.StructArgs struct-name _)
              (tc-bind-struct-pattern
                ctx
                env
                (intern-str struct-name)
                ty
                (intern-str name)
                args)]
            [_
              (ResultTcEnv.Err
                "typecheck: struct field pattern only supports binding, wildcard, or nested struct patterns")]))]
      [_
        (ResultTcEnv.Err
          "typecheck: struct field pattern only supports binding, wildcard, or nested struct patterns")])))

(define (tc-bind-sub-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [pattern : AstPattern]
  [field-ty : AstType]) : ResultTcEnv
  (let
    [ty : AstType (tc-resolve-type ctx field-ty)]
    (match pattern
      [(AstPattern.Binding name) (ResultTcEnv.Ok (tc-bind-id env name ty))]
      [(AstPattern.Wildcard) (ResultTcEnv.Ok env)]
      [(AstPattern.Literal lit) (tc-bind-literal-pattern env lit ty)]
      [(AstPattern.Variant name args-box)
        (let
          [args : AstPatternList (box-get args-box)]
          (match (tc-type-strip-region ty)
            [(AstType.Expr)
              (tc-bind-expr-variant-pattern ctx env (intern-str name) args)]
            [(AstType.Enum enum-name)
              (tc-bind-variant-pattern
                ctx
                env
                (intern-str enum-name)
                (intern-str name)
                (ast-lifetime-list-new)
                args
                (tc-type-outer-regions ty))]
            [(AstType.EnumArgs enum-name lifetimes)
              (tc-bind-variant-pattern
                ctx
                env
                (intern-str enum-name)
                (intern-str name)
                (box-get lifetimes)
                args
                (tc-type-outer-regions ty))]
            [(AstType.Struct struct-name)
              (tc-bind-struct-pattern
                ctx
                env
                (intern-str struct-name)
                ty
                (intern-str name)
                args)]
            [(AstType.StructArgs struct-name _)
              (tc-bind-struct-pattern
                ctx
                env
                (intern-str struct-name)
                ty
                (intern-str name)
                args)]
            [(AstType.Box inner-ty)
              (if (tc-box-pattern-name? name)
                (tc-bind-box-pattern ctx env args (ty-node-get inner-ty))
                (ResultTcEnv.Err
                  "typecheck: nested variant pattern requires enum field"))]
            [_
              (if (tc-box-pattern-name? name)
                (ResultTcEnv.Err "typecheck: box pattern requires Box field")
                (ResultTcEnv.Err
                  "typecheck: nested variant pattern requires enum field"))]))]
      [_ (ResultTcEnv.Err "typecheck: unsupported nested match pattern")])))

(define (tc-borrowed-field-ref-type [lifetime : String] [field-ty : AstType]) : AstType
  (ast-ty-ref lifetime (tc-borrow-referent-type field-ty)))

(define (tc-bind-borrowed-sub-pattern-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [lifetime : String]
  [patterns : AstPatternList]
  [types : AstTypeList]) : ResultTcEnv
  (tc-bind-borrowed-sub-pattern-list-at
    ctx
    env
    lifetime
    (& patterns)
    (& types)
    0))

(define (tc-bind-borrowed-sub-pattern-list-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [lifetime : String]
  [patterns : (& patterns AstPatternList)]
  [types : (& types AstTypeList)]
  [index : i64]) : ResultTcEnv
  (if (>= index (ast-pattern-list-len patterns))
    (if (>= index (ast-type-list-len types))
      (ResultTcEnv.Ok env)
      (ResultTcEnv.Err "typecheck: pattern arity mismatch"))
    (if (>= index (ast-type-list-len types))
      (ResultTcEnv.Err "typecheck: pattern arity mismatch")
      (let
        [pattern : AstPattern
          (ast-pattern-list-get patterns index (ast-pattern-fallback))]
        [ty : AstType
          (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))]
        (match (tc-bind-borrowed-sub-pattern ctx env lifetime pattern ty)
          [(ResultTcEnv.Ok next-env)
            (tc-bind-borrowed-sub-pattern-list-at
              ctx
              next-env
              lifetime
              patterns
              types
              (+ index 1))]
          [(ResultTcEnv.Err message) (ResultTcEnv.Err message)])))))

(define (tc-bind-borrowed-variant-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [lifetime : String]
  [enum-name : String]
  [variant-name : String]
  [enum-lifetimes : AstLifetimeList]
  [args : AstPatternList]) : ResultTcEnv
  (let
    [handle : i64
      (tc-source-variant-handle-for-enum-or
        ctx
        enum-name
        variant-name
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (match (tc-variant-owner-name ctx handle)
        [(ResultTcString.Ok owner)
          (if (string.eq owner enum-name)
            (match (compiler-registries-variant-fields-indexed
              (tc-context-symbols ctx)
              handle)
              [(ResultAstTypeList.Ok fields)
                (match (tc-variant-pattern-payload-types
                  ctx
                  enum-name
                  enum-lifetimes
                  fields)
                  [(ResultTcVariantPayloadTypes.Ok payload-fields)
                    (tc-bind-borrowed-sub-pattern-list
                      ctx
                      env
                      lifetime
                      args
                      payload-fields)]
                  [(ResultTcVariantPayloadTypes.Err message)
                    (ResultTcEnv.Err message)])]
              [(ResultAstTypeList.Err message) (ResultTcEnv.Err message)])
            (ResultTcEnv.Err
              (string.append
                "typecheck: variant "
                (string.append
                  variant-name
                  (string.append
                    " belongs to enum "
                    (string.append owner (string.append ", not " enum-name)))))))]
        [(ResultTcString.Err message) (ResultTcEnv.Err message)])
      (ResultTcEnv.Err
        (string.append "typecheck: unknown variant " variant-name)))))

(define (tc-bind-borrowed-sub-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [lifetime : String]
  [pattern : AstPattern]
  [field-ty : AstType]) : ResultTcEnv
  (let
    [ty : AstType (tc-resolve-type ctx field-ty)]
    (match pattern
      [(AstPattern.Binding name)
        (ResultTcEnv.Ok
          (tc-bind-id env name (tc-borrowed-field-ref-type lifetime ty)))]
      [(AstPattern.Wildcard) (ResultTcEnv.Ok env)]
      [(AstPattern.Literal lit) (tc-bind-literal-pattern env lit ty)]
      [(AstPattern.Variant name args-box)
        (let
          [args : AstPatternList (box-get args-box)]
          (match (tc-type-strip-region ty)
            [(AstType.Enum enum-name)
              (tc-bind-borrowed-variant-pattern
                ctx
                env
                lifetime
                (intern-str enum-name)
                (intern-str name)
                (ast-lifetime-list-new)
                args)]
            [(AstType.EnumArgs enum-name lifetimes)
              (tc-bind-borrowed-variant-pattern
                ctx
                env
                lifetime
                (intern-str enum-name)
                (intern-str name)
                (box-get lifetimes)
                args)]
            [(AstType.Box _)
              (if (tc-box-pattern-name? name)
                (ResultTcEnv.Err
                  "typecheck: borrowed box patterns are not supported")
                (ResultTcEnv.Err
                  "typecheck: nested variant pattern requires enum field"))]
            [_
              (if (tc-box-pattern-name? name)
                (ResultTcEnv.Err "typecheck: box pattern requires Box field")
                (ResultTcEnv.Err
                  "typecheck: nested variant pattern requires enum field"))]))]
      [_ (ResultTcEnv.Err "typecheck: unsupported nested match pattern")])))

(define (tc-bind-borrowed-enum-match-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [lifetime : String]
  [enum-name : String]
  [enum-lifetimes : AstLifetimeList]
  [pattern : AstPattern]) : ResultTcEnv
  (match pattern
    [(AstPattern.Wildcard) (ResultTcEnv.Ok env)]
    [(AstPattern.Binding variant-name)
      (tc-bind-borrowed-variant-pattern
        ctx
        env
        lifetime
        enum-name
        (intern-str variant-name)
        enum-lifetimes
        (ast-pattern-list-new))]
    [(AstPattern.Variant variant-name args-box)
      (let
        [args : AstPatternList (box-get args-box)]
        (tc-bind-borrowed-variant-pattern
          ctx
          env
          lifetime
          enum-name
          (intern-str variant-name)
          enum-lifetimes
          args))]
    [_ (ResultTcEnv.Err "typecheck: unsupported enum match pattern")]))

(define (tc-bind-match-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [pattern : AstPattern]) : ResultTcEnv
  (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
    [(AstType.Ref lifetime referent-box)
      (let
        [referent-ty : AstType
          (tc-type-strip-region
            (tc-resolve-type ctx (ty-node-get referent-box)))]
        (match referent-ty
          [(AstType.Enum enum-name)
            (tc-bind-borrowed-enum-match-pattern
              ctx
              env
              lifetime
              (intern-str enum-name)
              (ast-lifetime-list-new)
              pattern)]
          [(AstType.EnumArgs enum-name lifetimes)
            (tc-bind-borrowed-enum-match-pattern
              ctx
              env
              lifetime
              (intern-str enum-name)
              (box-get lifetimes)
              pattern)]
          [(AstType.Box _)
            (match pattern
              [(AstPattern.Wildcard) (ResultTcEnv.Ok env)]
              [(AstPattern.Binding name)
                (ResultTcEnv.Ok (tc-bind-id env name scrut-ty))]
              [(AstPattern.Literal lit)
                (tc-bind-literal-pattern env lit scrut-ty)]
              [(AstPattern.Variant name _)
                (if (tc-box-pattern-name? name)
                  (ResultTcEnv.Err
                    "typecheck: borrowed box patterns are not supported")
                  (ResultTcEnv.Err
                    "typecheck: scalar match only supports literal, binding, or wildcard patterns"))]
              [_
                (ResultTcEnv.Err
                  "typecheck: scalar match only supports literal, binding, or wildcard patterns")])]
          [_ (tc-bind-scalar-match-pattern env scrut-ty pattern)]))]
    [(AstType.Enum enum-name)
      (match pattern
        [(AstPattern.Wildcard) (ResultTcEnv.Ok env)]
        [(AstPattern.Binding variant-name)
          (tc-bind-variant-pattern
            ctx
            env
            (intern-str enum-name)
            (intern-str variant-name)
            (ast-lifetime-list-new)
            (ast-pattern-list-new)
            (tc-type-outer-regions scrut-ty))]
        [(AstPattern.Variant variant-name args-box)
          (let
            [args : AstPatternList (box-get args-box)]
            (tc-bind-variant-pattern
              ctx
              env
              (intern-str enum-name)
              (intern-str variant-name)
              (ast-lifetime-list-new)
              args
              (tc-type-outer-regions scrut-ty)))]
        [_ (ResultTcEnv.Err "typecheck: unsupported enum match pattern")])]
    [(AstType.EnumArgs enum-name lifetimes)
      (match pattern
        [(AstPattern.Wildcard) (ResultTcEnv.Ok env)]
        [(AstPattern.Binding variant-name)
          (tc-bind-variant-pattern
            ctx
            env
            (intern-str enum-name)
            (intern-str variant-name)
            (box-get lifetimes)
            (ast-pattern-list-new)
            (tc-type-outer-regions scrut-ty))]
        [(AstPattern.Variant variant-name args-box)
          (let
            [args : AstPatternList (box-get args-box)]
            (tc-bind-variant-pattern
              ctx
              env
              (intern-str enum-name)
              (intern-str variant-name)
              (box-get lifetimes)
              args
              (tc-type-outer-regions scrut-ty)))]
        [_ (ResultTcEnv.Err "typecheck: unsupported enum match pattern")])]
    [(AstType.Struct struct-name)
      (match pattern
        [(AstPattern.Wildcard) (ResultTcEnv.Ok env)]
        [(AstPattern.Binding name)
          (ResultTcEnv.Ok (tc-bind-id env name scrut-ty))]
        [(AstPattern.Variant pattern-name args-box)
          (tc-bind-struct-pattern
            ctx
            env
            (intern-str struct-name)
            scrut-ty
            (intern-str pattern-name)
            (box-get args-box))]
        [_
          (ResultTcEnv.Err
            "typecheck: struct match only supports constructor-shaped, binding, or wildcard patterns")])]
    [(AstType.StructArgs struct-name _)
      (match pattern
        [(AstPattern.Wildcard) (ResultTcEnv.Ok env)]
        [(AstPattern.Binding name)
          (ResultTcEnv.Ok (tc-bind-id env name scrut-ty))]
        [(AstPattern.Variant pattern-name args-box)
          (tc-bind-struct-pattern
            ctx
            env
            (intern-str struct-name)
            scrut-ty
            (intern-str pattern-name)
            (box-get args-box))]
        [_
          (ResultTcEnv.Err
            "typecheck: struct match only supports constructor-shaped, binding, or wildcard patterns")])]
    [(AstType.Expr) (tc-bind-expr-match-pattern ctx env pattern)]
    [(AstType.Var name)
      (if (= name (intern "ExprClause"))
        (tc-bind-expr-clause-match-pattern ctx env pattern)
        (tc-bind-scalar-match-pattern env scrut-ty pattern))]
    [(AstType.Box inner-ty)
      (match pattern
        [(AstPattern.Wildcard) (ResultTcEnv.Ok env)]
        [(AstPattern.Binding name)
          (ResultTcEnv.Ok (tc-bind-id env name scrut-ty))]
        [(AstPattern.Literal lit) (tc-bind-literal-pattern env lit scrut-ty)]
        [(AstPattern.Variant name args-box)
          (let
            [args : AstPatternList (box-get args-box)]
            (if (tc-box-pattern-name? name)
              (tc-bind-box-pattern ctx env args (ty-node-get inner-ty))
              (ResultTcEnv.Err
                "typecheck: Box match only supports (box ...), binding, or wildcard patterns")))]
        [_ (ResultTcEnv.Err "typecheck: unsupported Box match pattern")])]
    [_ (tc-bind-scalar-match-pattern env scrut-ty pattern)]))

(define (tc-match-arm-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [arm : AstMatchArm]) : ResultTcType
  (match arm
    [(AstMatchArm.Arm pattern body-box)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (match (tc-bind-match-pattern ctx env scrut-ty pattern)
          [(ResultTcEnv.Ok arm-env) (tc-expr ctx arm-env body)]
          [(ResultTcEnv.Err message) (ResultTcType.Err message)]))]))

(define (tc-match-arm-type-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [arm : AstMatchArm]
  [expected : AstType]) : ResultTcType
  (match arm
    [(AstMatchArm.Arm pattern body-box)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (match (tc-bind-match-pattern ctx env scrut-ty pattern)
          [(ResultTcEnv.Ok arm-env)
            (match (tc-expr-with-expected-or-actual ctx arm-env body expected)
              [(ResultTcType.Ok got)
                (match (tc-expect
                  got
                  expected
                  "typecheck: match arm result type mismatch")
                  [(ResultTcUnit.Ok) (ResultTcType.Ok expected)]
                  [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
              [(ResultTcType.Err message) (ResultTcType.Err message)])]
          [(ResultTcEnv.Err message) (ResultTcType.Err message)]))]))

(define (tc-check-match-arm-types-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [expected : AstType]) : ResultTcType
  (let
    [arms-ref : (& arms AstMatchArmList) (& arms)]
    (if (= (struct-get arms-ref len) 0)
      (ResultTcType.Err "typecheck: match must have at least one arm")
      (tc-check-match-arm-types-with-expected-at
        ctx
        env
        scrut-ty
        arms-ref
        expected
        0))))

(define (tc-check-match-arm-types-with-expected-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [arms : (& arms AstMatchArmList)]
  [expected : AstType]
  [index : i64]) : ResultTcType
  (if (>= index (struct-get arms len))
    (ResultTcType.Ok expected)
    (match (tc-match-arm-type-with-expected
      ctx
      env
      scrut-ty
      (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      expected)
      [(ResultTcType.Ok _)
        (tc-check-match-arm-types-with-expected-at
          ctx
          env
          scrut-ty
          arms
          expected
          (+ index 1))]
      [(ResultTcType.Err message) (ResultTcType.Err message)])))

(define (tc-match-rest-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [want : AstType]) : ResultTcType
  (tc-match-rest-types-at ctx env scrut-ty (& arms) 0 want))

(define (tc-match-rest-types-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [arms : (& arms AstMatchArmList)]
  [index : i64]
  [want : AstType]) : ResultTcType
  (if (>= index (struct-get arms len))
    (ResultTcType.Ok want)
    (let
      [arm : AstMatchArm
        (ast-match-arm-list-get arms index (ast-match-arm-fallback))]
      (match (tc-match-arm-type-with-expected ctx env scrut-ty arm want)
        [(ResultTcType.Ok _)
          (tc-match-rest-types-at ctx env scrut-ty arms (+ index 1) want)]
        [(ResultTcType.Err _)
          (match (tc-match-arm-type ctx env scrut-ty arm)
            [(ResultTcType.Ok got)
              (match (tc-merge-branch-type want got)
                [(ResultTcType.Ok merged)
                  (tc-match-rest-types-at
                    ctx
                    env
                    scrut-ty
                    arms
                    (+ index 1)
                    merged)]
                [(ResultTcType.Err _)
                  (ResultTcType.Err (tc-match-arm-merge-message want got))])]
            [(ResultTcType.Err message) (ResultTcType.Err message)])]))))

(define (tc-check-match-arm-types-from-first
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [first-arm : AstMatchArm]
  [rest : AstMatchArmList]
  [first-ty : AstType]) : ResultTcType
  (tc-check-match-arm-types-from-first-at
    ctx
    env
    scrut-ty
    first-arm
    (& rest)
    0
    first-ty))

(define (tc-check-match-arm-types-from-first-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [first-arm : AstMatchArm]
  [rest : (& rest AstMatchArmList)]
  [index : i64]
  [first-ty : AstType]) : ResultTcType
  (if (>= index (struct-get rest len))
    (ResultTcType.Ok first-ty)
    (let
      [second-arm : AstMatchArm
        (ast-match-arm-list-get rest index (ast-match-arm-fallback))]
      [remaining-index : i64 (+ index 1)]
      (match (tc-match-arm-type ctx env scrut-ty second-arm)
        [(ResultTcType.Ok second-ty)
          (match (tc-merge-branch-type first-ty second-ty)
            [(ResultTcType.Ok merged)
              (tc-match-rest-types-at
                ctx
                env
                scrut-ty
                rest
                remaining-index
                merged)]
            [(ResultTcType.Err _)
              (match (tc-match-arm-type-with-expected
                ctx
                env
                scrut-ty
                first-arm
                second-ty)
                [(ResultTcType.Ok _)
                  (tc-match-rest-types-at
                    ctx
                    env
                    scrut-ty
                    rest
                    remaining-index
                    second-ty)]
                [(ResultTcType.Err _)
                  (match (tc-match-arm-type-with-expected
                    ctx
                    env
                    scrut-ty
                    second-arm
                    first-ty)
                    [(ResultTcType.Ok _)
                      (tc-match-rest-types-at
                        ctx
                        env
                        scrut-ty
                        rest
                        remaining-index
                        first-ty)]
                    [(ResultTcType.Err _)
                      (ResultTcType.Err
                        (tc-match-arm-merge-message first-ty second-ty))])])])]
        [(ResultTcType.Err message) (ResultTcType.Err message)]))))

(define (tc-check-match-arm-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : ResultTcType
  (let
    [arms-ref : (& arms AstMatchArmList) (& arms)]
    (if (= (struct-get arms-ref len) 0)
      (ResultTcType.Err "typecheck: match must have at least one arm")
      (let
        [arm : AstMatchArm
          (ast-match-arm-list-get arms-ref 0 (ast-match-arm-fallback))]
        (match (tc-match-arm-type ctx env scrut-ty arm)
          [(ResultTcType.Ok first-ty)
            (tc-check-match-arm-types-from-first-at
              ctx
              env
              scrut-ty
              arm
              arms-ref
              1
              first-ty)]
          [(ResultTcType.Err message) (ResultTcType.Err message)])))))

(define (tc-qualified-name-last-slash [name : String]) : i64
  (intern-name-last-slash name))

(define (tc-qualified-name-module [name : String]) : String
  (intern-name-module name))

(define (tc-qualified-name-base [name : String]) : String
  (intern-name-base name))

(define (tc-qualified-variant-name [enum-name : String] [variant-name : String]) : String
  (let
    [module : String (tc-qualified-name-module enum-name)]
    [enum-base : String (tc-qualified-name-base enum-name)]
    [qualified-variant : String
      (compiler-enum-qualified-variant-name enum-base variant-name)]
    (compiler-symbol-module-key module qualified-variant)))

(define (tc-qualified-variant-key-id
  [enum-name : String]
  [variant-name : String]) : i64
  (let
    [enum-name-id : i64 (tc-name-id enum-name)]
    [module-id : i64 (intern-qualified-module-id enum-name-id)]
    [enum-base-id : i64 (intern-qualified-base-id enum-name-id)]
    [variant-name-id : i64 (tc-name-id variant-name)]
    [qualified-variant-id : i64
      (compiler-enum-qualified-variant-name-id enum-base-id variant-name-id)]
    (compiler-symbol-module-key-id-by-id module-id qualified-variant-id)))

(define (tc-variant-name-for-enum [enum-name : String] [variant-name : String]) : String
  (if (tc-name-qualified? variant-name)
    variant-name
    (tc-qualified-variant-name enum-name variant-name)))

(define (tc-source-variant-name-for-enum
  [ctx : TcContext]
  [enum-name : String]
  [variant-name : String]) : String
  (if (tc-name-qualified? variant-name)
    variant-name
    (if (>= (tc-name-first-dot variant-name) 0)
      (match (tc-enum-qualified-variant-lookup-key ctx variant-name)
        [(ResultTcString.Ok lookup-name) lookup-name]
        [(ResultTcString.Err _)
          (match (tc-dotted-type-name-lookup-key ctx variant-name)
            [(ResultTcString.Ok lookup-name) lookup-name]
            [(ResultTcString.Err _) variant-name])])
      (let
        [handle : i64
          (compiler-registries-lookup-variant-or
            (tc-context-registries ctx)
            variant-name
            (compiler-symbols-missing-handle))]
        (if (compiler-symbols-handle-found? handle)
          (match (tc-variant-owner-name ctx handle)
            [(ResultTcString.Ok owner)
              (if (string.eq owner enum-name)
                variant-name
                (tc-qualified-variant-name enum-name variant-name))]
            [(ResultTcString.Err _)
              (tc-qualified-variant-name enum-name variant-name)])
          (tc-qualified-variant-name enum-name variant-name))))))

(define (tc-qualified-variant-handle-for-enum-or
  [ctx : TcContext]
  [enum-name : String]
  [variant-name : String]
  [fallback : i64]) : i64
  (compiler-registries-lookup-variant-key-id-or
    (tc-context-registries ctx)
    (tc-qualified-variant-key-id enum-name variant-name)
    fallback))

(define (tc-source-variant-handle-for-enum-or
  [ctx : TcContext]
  [enum-name : String]
  [variant-name : String]
  [fallback : i64]) : i64
  (let
    [registries : CompilerRegistries (tc-context-registries ctx)]
    [variant-name-id : i64 (tc-name-id variant-name)]
    (if (tc-name-qualified? variant-name)
      (compiler-registries-lookup-variant-id-or
        registries
        variant-name-id
        fallback)
      (if (>= (intern-first-dot variant-name-id) 0)
        (match (tc-enum-qualified-variant-lookup-handle
          ctx
          variant-name
          variant-name-id)
          [(option_i64.Some handle) handle]
          [(option_i64.None)
            (match (tc-dotted-type-name-lookup-key ctx variant-name)
              [(ResultTcString.Ok lookup-name)
                (compiler-registries-lookup-variant-or
                  registries
                  lookup-name
                  fallback)]
              [(ResultTcString.Err _) fallback])])
        (let
          [handle : i64
            (compiler-registries-lookup-variant-id-or
              registries
              variant-name-id
              (compiler-symbols-missing-handle))]
          (if (compiler-symbols-handle-found? handle)
            (match (tc-variant-owner-name ctx handle)
              [(ResultTcString.Ok owner)
                (if (string.eq owner enum-name)
                  handle
                  (tc-qualified-variant-handle-for-enum-or
                    ctx
                    enum-name
                    variant-name
                    fallback))]
              [(ResultTcString.Err _)
                (tc-qualified-variant-handle-for-enum-or
                  ctx
                  enum-name
                  variant-name
                  fallback)])
            (tc-qualified-variant-handle-for-enum-or
              ctx
              enum-name
              variant-name
              fallback)))))))

(define (tc-variant-name-matches?
  [ctx : TcContext]
  [enum-name : String]
  [pattern-name : String]
  [variant-name : String]) : bool
  (if (string.eq pattern-name variant-name)
    true
    (if (and
      (< (tc-name-first-dot pattern-name) 0)
      (not (tc-name-qualified? pattern-name)))
      false
      (let
        [pattern-handle : i64
          (tc-source-variant-handle-for-enum-or
            ctx
            enum-name
            pattern-name
            (compiler-symbols-missing-handle))]
        [candidate-handle : i64
          (tc-source-variant-handle-for-enum-or
            ctx
            enum-name
            variant-name
            (compiler-symbols-missing-handle))]
        (if (and
          (compiler-symbols-handle-found? pattern-handle)
          (compiler-symbols-handle-found? candidate-handle))
          (= pattern-handle candidate-handle)
          false)))))

(define (tc-expr-pattern-enum-name) : String
  (tc-stdlib-comptime-type-key "Expr"))

(define (tc-expr-variant-pattern-name?
  [ctx : TcContext]
  [pattern-name : String]
  [variant-name : String]) : bool
  (tc-variant-name-matches?
    ctx
    (tc-expr-pattern-enum-name)
    pattern-name
    variant-name))

(define (tc-expr-variant-payload-types
  [ctx : TcContext]
  [variant-name : String]) : ResultTcTypeList
  (cond
    [(tc-expr-variant-pattern-name? ctx variant-name "ExprBool")
      (ResultTcTypeList.Ok (tc-type-list1 (AstType.Bool)))]
    [(tc-expr-variant-pattern-name? ctx variant-name "ExprInt")
      (ResultTcTypeList.Ok (tc-type-list1 (AstType.I64)))]
    [(tc-expr-variant-pattern-name? ctx variant-name "ExprVar")
      (ResultTcTypeList.Ok (tc-type-list1 (AstType.String)))]
    [(tc-expr-variant-pattern-name? ctx variant-name "ExprSplice")
      (ResultTcTypeList.Ok (tc-type-list1 (AstType.Expr)))]
    [(tc-expr-variant-pattern-name? ctx variant-name "ExprIf")
      (ResultTcTypeList.Ok
        (tc-type-list3 (AstType.Expr) (AstType.Expr) (AstType.Expr)))]
    [(tc-expr-variant-pattern-name? ctx variant-name "ExprCall")
      (ResultTcTypeList.Ok (tc-type-list2 (AstType.Expr) (AstType.ExprList)))]
    [(tc-expr-variant-pattern-name? ctx variant-name "ExprBegin")
      (ResultTcTypeList.Ok (tc-type-list1 (AstType.ExprList)))]
    [(tc-expr-variant-pattern-name? ctx variant-name "ExprQuote")
      (ResultTcTypeList.Ok (tc-type-list1 (AstType.Expr)))]
    [(tc-expr-variant-pattern-name? ctx variant-name "ExprQuasiquote")
      (ResultTcTypeList.Ok (tc-type-list1 (AstType.Expr)))]
    [(tc-expr-variant-pattern-name? ctx variant-name "ExprUnquote")
      (ResultTcTypeList.Ok (tc-type-list1 (AstType.Expr)))]
    [(tc-expr-variant-pattern-name? ctx variant-name "ExprUnquoteSplicing")
      (ResultTcTypeList.Ok (tc-type-list1 (AstType.Expr)))]
    [else
      (ResultTcTypeList.Err
        (str_cat.str-cat "typecheck: unknown Expr variant " variant-name))]))

(define (tc-bind-expr-variant-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [variant-name : String]
  [args : AstPatternList]) : ResultTcEnv
  (match (tc-expr-variant-payload-types ctx variant-name)
    [(ResultTcTypeList.Ok payloads)
      (tc-bind-sub-pattern-list ctx env args payloads)]
    [(ResultTcTypeList.Err message) (ResultTcEnv.Err message)]))

(define (tc-bind-expr-match-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [pattern : AstPattern]) : ResultTcEnv
  (match pattern
    [(AstPattern.Wildcard) (ResultTcEnv.Ok env)]
    [(AstPattern.Binding name)
      (ResultTcEnv.Ok (tc-bind-id env name (AstType.Expr)))]
    [(AstPattern.Variant variant-name args-box)
      (let
        [args : AstPatternList (box-get args-box)]
        (tc-bind-expr-variant-pattern ctx env (intern-str variant-name) args))]
    [_ (ResultTcEnv.Err "typecheck: unsupported Expr match pattern")]))

(define (tc-expr-clause-pattern-name? [name : i64]) : bool
  (= name (intern "ExprClause")))

(define (tc-bind-expr-clause-match-pattern
  [ctx : TcContext]
  [env : TcTypeEnv]
  [pattern : AstPattern]) : ResultTcEnv
  (match pattern
    [(AstPattern.Wildcard) (ResultTcEnv.Ok env)]
    [(AstPattern.Binding name)
      (ResultTcEnv.Ok (tc-bind-id env name (tc-macro-expr-clause-type)))]
    [(AstPattern.Variant variant-name args-box)
      (if (tc-expr-clause-pattern-name? variant-name)
        (tc-bind-sub-pattern-list
          ctx
          env
          (box-get args-box)
          (tc-type-list2 (AstType.Expr) (AstType.Expr)))
        (ResultTcEnv.Err
          (str_cat.str-cat
            "typecheck: unknown ExprClause constructor "
            (intern-str variant-name))))]
    [_ (ResultTcEnv.Err "typecheck: unsupported ExprClause match pattern")]))

(define (tc-expr-clause-pattern-irrefutable?
  [ctx : TcContext]
  [pattern : AstPattern]) : bool
  (match pattern
    [(AstPattern.Wildcard) true]
    [(AstPattern.Binding _) true]
    [(AstPattern.Variant name args-box)
      (if (tc-expr-clause-pattern-name? name)
        (tc-pattern-list-irrefutable?
          ctx
          (box-get args-box)
          (tc-type-list2 (AstType.Expr) (AstType.Expr)))
        false)]
    [_ false]))

(define (tc-enum-has-single-variant?
  [ctx : TcContext]
  [variants : AstVariantDefList]
  [enum-name : String]
  [variant-name : String]) : bool
  (if (= (struct-get (& variants) len) 1)
    (match (ast-variant-def-list-get (& variants) 0 (ast-variant-def-fallback))
      [(AstVariantDef.Def name _ _)
        (tc-variant-name-matches? ctx enum-name variant-name (intern-str name))])
    false))

(define (tc-enum-single-matching-variant-name
  [ctx : TcContext]
  [variants : AstVariantDefList]
  [enum-name : String]
  [pattern-name : String]) : TcMaybeString
  (if (= (struct-get (& variants) len) 1)
    (match (ast-variant-def-list-get (& variants) 0 (ast-variant-def-fallback))
      [(AstVariantDef.Def name _ _)
        (let
          [variant-name : String (intern-str name)]
          (if (tc-variant-name-matches? ctx enum-name pattern-name variant-name)
            (TcMaybeString.Some variant-name)
            (TcMaybeString.No)))])
    (TcMaybeString.No)))

(define (tc-variant-pattern-irrefutable?
  [ctx : TcContext]
  [enum-name : String]
  [variant-name : String]
  [args : AstPatternList]) : bool
  (let
    [handle : i64
      (tc-source-variant-handle-for-enum-or
        ctx
        enum-name
        variant-name
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (match (compiler-registries-variant-fields-indexed
        (tc-context-symbols ctx)
        handle)
        [(ResultAstTypeList.Ok fields)
          (tc-pattern-list-irrefutable? ctx args fields)]
        [(ResultAstTypeList.Err _) false])
      false)))

(define (tc-struct-pattern-irrefutable?
  [ctx : TcContext]
  [struct-name : String]
  [scrut-ty : AstType]
  [pattern-name : String]
  [args : AstPatternList]) : bool
  (if (tc-struct-pattern-name-matches? ctx struct-name pattern-name)
    (match (tc-struct-decl ctx struct-name)
      [(ResultTcStructDecl.Ok decl)
        (match decl
          [(TcStructDecl _ _ fields)
            (match (tc-struct-pattern-field-types-for-scrut
              ctx
              struct-name
              scrut-ty
              fields)
              [(ResultTcTypeList.Ok field-types)
                (tc-pattern-list-irrefutable? ctx args field-types)]
              [(ResultTcTypeList.Err _) false])])]
      [(ResultTcStructDecl.Err _) false])
    false))

(define (tc-sub-pattern-irrefutable?
  [ctx : TcContext]
  [pattern : AstPattern]
  [field-ty : AstType]) : bool
  (match pattern
    [(AstPattern.Wildcard) true]
    [(AstPattern.Var _ _) true]
    [(AstPattern.Binding _) true]
    [(AstPattern.Literal _) false]
    [(AstPattern.Variant name args-box)
      (let
        [args : AstPatternList (box-get args-box)]
        (match (tc-type-strip-region (tc-resolve-type ctx field-ty))
          [(AstType.Enum enum-name)
            (let
              [enum-name-str : String (intern-str enum-name)]
              (match (tc-context-enum-variants ctx enum-name-str)
                [(ResultAstVariantDefList.Ok variants)
                  (match (tc-enum-single-matching-variant-name
                    ctx
                    variants
                    enum-name-str
                    (intern-str name))
                    [(TcMaybeString.Some variant-name)
                      (tc-variant-pattern-irrefutable?
                        ctx
                        enum-name-str
                        variant-name
                        args)]
                    [(TcMaybeString.No) false])]
                [(ResultAstVariantDefList.Err _) false]))]
          [(AstType.EnumArgs enum-name _)
            (let
              [enum-name-str : String (intern-str enum-name)]
              (match (tc-program-enum-variants
                (tc-context-program ctx)
                enum-name-str)
                [(ResultAstVariantDefList.Ok variants)
                  (match (tc-enum-single-matching-variant-name
                    ctx
                    variants
                    enum-name-str
                    (intern-str name))
                    [(TcMaybeString.Some variant-name)
                      (tc-variant-pattern-irrefutable?
                        ctx
                        enum-name-str
                        variant-name
                        args)]
                    [(TcMaybeString.No) false])]
                [(ResultAstVariantDefList.Err _) false]))]
          [(AstType.Struct struct-name)
            (tc-struct-pattern-irrefutable?
              ctx
              (intern-str struct-name)
              field-ty
              (intern-str name)
              args)]
          [(AstType.StructArgs struct-name _)
            (tc-struct-pattern-irrefutable?
              ctx
              (intern-str struct-name)
              field-ty
              (intern-str name)
              args)]
          [(AstType.Box inner-ty)
            (if (tc-box-pattern-name? name)
              (tc-box-pattern-args-supported? ctx args (ty-node-get inner-ty))
              false)]
          [_ false]))]
    [_ false]))

(define (tc-pattern-list-irrefutable?
  [ctx : TcContext]
  [patterns : AstPatternList]
  [types : AstTypeList]) : bool
  (tc-pattern-list-irrefutable-at? ctx (& patterns) (& types) 0))

(define (tc-pattern-list-irrefutable-at?
  [ctx : TcContext]
  [patterns : (& patterns AstPatternList)]
  [types : (& types AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast-pattern-list-len patterns))
    (>= index (ast-type-list-len types))
    (if (>= index (ast-type-list-len types))
      false
      (let
        [pattern : AstPattern
          (ast-pattern-list-get patterns index (ast-pattern-fallback))]
        [ty : AstType
          (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))]
        (if (tc-sub-pattern-irrefutable? ctx pattern ty)
          (tc-pattern-list-irrefutable-at? ctx patterns types (+ index 1))
          false)))))

(define (tc-pattern-covers-variant?
  [ctx : TcContext]
  [pattern : AstPattern]
  [enum-name : String]
  [variant-name : String]) : bool
  (match pattern
    [(AstPattern.Wildcard) true]
    [(AstPattern.Binding name)
      (tc-variant-name-matches? ctx enum-name (intern-str name) variant-name)]
    [(AstPattern.Variant name args-box)
      (let
        [args : AstPatternList (box-get args-box)]
        (and
          (tc-variant-name-matches?
            ctx
            enum-name
            (intern-str name)
            variant-name)
          (tc-variant-pattern-irrefutable? ctx enum-name variant-name args)))]
    [_ false]))

(define (tc-match-arms-cover-variant?
  [ctx : TcContext]
  [arms : AstMatchArmList]
  [enum-name : String]
  [variant-name : String]) : bool
  (tc-match-arms-cover-variant-at? ctx (& arms) enum-name variant-name 0))

(define (tc-match-arms-cover-variant-at?
  [ctx : TcContext]
  [arms : (& arms AstMatchArmList)]
  [enum-name : String]
  [variant-name : String]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    false
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern _)
        (if (tc-pattern-covers-variant? ctx pattern enum-name variant-name)
          true
          (tc-match-arms-cover-variant-at?
            ctx
            arms
            enum-name
            variant-name
            (+ index 1)))])))

(define (tc-match-missing-variant-message [variant-name : String]) : String
  (string.append "typecheck: match missing arm for variant " variant-name))

(define (tc-pattern-mentions-variant?
  [ctx : TcContext]
  [pattern : AstPattern]
  [enum-name : String]
  [variant-name : String]) : bool
  (match pattern
    [(AstPattern.Binding name)
      (tc-variant-name-matches? ctx enum-name (intern-str name) variant-name)]
    [(AstPattern.Variant name _)
      (tc-variant-name-matches? ctx enum-name (intern-str name) variant-name)]
    [_ false]))

(define (tc-match-arms-mention-variant?
  [ctx : TcContext]
  [arms : AstMatchArmList]
  [enum-name : String]
  [variant-name : String]) : bool
  (tc-match-arms-mention-variant-at? ctx (& arms) enum-name variant-name 0))

(define (tc-match-arms-mention-variant-at?
  [ctx : TcContext]
  [arms : (& arms AstMatchArmList)]
  [enum-name : String]
  [variant-name : String]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    false
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern _)
        (if (tc-pattern-mentions-variant? ctx pattern enum-name variant-name)
          true
          (tc-match-arms-mention-variant-at?
            ctx
            arms
            enum-name
            variant-name
            (+ index 1)))])))

(define (tc-enum-variants-exhaustive-ok
  [ctx : TcContext]
  [enum-name : String]
  [variants : AstVariantDefList]
  [arms : AstMatchArmList]) : ResultTcUnit
  (tc-enum-variants-exhaustive-ok-at ctx enum-name (& variants) arms 0))

(define (tc-enum-variants-exhaustive-ok-at
  [ctx : TcContext]
  [enum-name : String]
  [variants : (& variants AstVariantDefList)]
  [arms : AstMatchArmList]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get variants len))
    ResultTcUnit.Ok
    (match (ast-variant-def-list-get variants index (ast-variant-def-fallback))
      [(AstVariantDef.Def name _ _)
        (let
          [variant-name : String (intern-str name)]
          (if (tc-match-arms-cover-variant? ctx arms enum-name variant-name)
            (tc-enum-variants-exhaustive-ok-at
              ctx
              enum-name
              variants
              arms
              (+ index 1))
            (if (tc-match-arms-mention-variant? ctx arms enum-name variant-name)
              (ResultTcUnit.Err "typecheck: non-exhaustive match")
              (ResultTcUnit.Err (tc-match-missing-variant-message variant-name)))))])))

(define (tc-match-arms-have-catchall? [arms : AstMatchArmList]) : bool
  (tc-match-arms-have-catchall-at? (& arms) 0))

(define (tc-match-arms-have-catchall-at?
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    false
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern _)
        (match pattern
          [(AstPattern.Wildcard) true]
          [(AstPattern.Binding _) true]
          [_ (tc-match-arms-have-catchall-at? arms (+ index 1))])])))

(define (tc-match-arms-have-catchall-for-type?
  [ctx : TcContext]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : bool
  (tc-match-arms-have-catchall-for-type-at? ctx scrut-ty (& arms) 0))

(define (tc-match-arms-have-catchall-for-type-at?
  [ctx : TcContext]
  [scrut-ty : AstType]
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    false
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern _)
        (if (tc-match-pattern-catchall-for-type? ctx scrut-ty pattern)
          true
          (tc-match-arms-have-catchall-for-type-at?
            ctx
            scrut-ty
            arms
            (+ index 1)))])))

(define (tc-match-arms-cover-bool? [arms : AstMatchArmList] [want : bool]) : bool
  (tc-match-arms-cover-bool-at? (& arms) want 0))

(define (tc-match-arms-cover-bool-at?
  [arms : (& arms AstMatchArmList)]
  [want : bool]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    false
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern _)
        (match pattern
          [(AstPattern.Literal (AstLiteral.Bool value))
            (if (= value want)
              true
              (tc-match-arms-cover-bool-at? arms want (+ index 1)))]
          [_ (tc-match-arms-cover-bool-at? arms want (+ index 1))])])))

(define (tc-match-pattern-catchall-for-type?
  [ctx : TcContext]
  [scrut-ty : AstType]
  [pattern : AstPattern]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
    [(AstType.Enum _)
      (match pattern
        [(AstPattern.Wildcard) true]
        [_ false])]
    [(AstType.EnumArgs _ _)
      (match pattern
        [(AstPattern.Wildcard) true]
        [_ false])]
    [(AstType.Box inner-ty)
      (match pattern
        [(AstPattern.Wildcard) true]
        [(AstPattern.Binding _) true]
        [(AstPattern.Variant name args-box)
          (if (tc-box-pattern-name? name)
            (tc-box-pattern-args-supported?
              ctx
              (box-get args-box)
              (ty-node-get inner-ty))
            false)]
        [_ false])]
    [(AstType.Struct struct-name)
      (match pattern
        [(AstPattern.Wildcard) true]
        [(AstPattern.Binding _) true]
        [(AstPattern.Variant name args-box)
          (tc-struct-pattern-irrefutable?
            ctx
            (intern-str struct-name)
            scrut-ty
            (intern-str name)
            (box-get args-box))]
        [_ false])]
    [(AstType.StructArgs struct-name _)
      (match pattern
        [(AstPattern.Wildcard) true]
        [(AstPattern.Binding _) true]
        [(AstPattern.Variant name args-box)
          (tc-struct-pattern-irrefutable?
            ctx
            (intern-str struct-name)
            scrut-ty
            (intern-str name)
            (box-get args-box))]
        [_ false])]
    [(AstType.Var name)
      (if (= name (intern "ExprClause"))
        (tc-expr-clause-pattern-irrefutable? ctx pattern)
        (match pattern
          [(AstPattern.Wildcard) true]
          [(AstPattern.Binding _) true]
          [_ false]))]
    [_
      (match pattern
        [(AstPattern.Wildcard) true]
        [(AstPattern.Binding _) true]
        [_ false])]))

(define (tc-match-arm-reachability-loop
  [ctx : TcContext]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [seen-catchall : bool]) : ResultTcUnit
  (tc-match-arm-reachability-loop-at ctx scrut-ty (& arms) seen-catchall 0))

(define (tc-match-arm-reachability-loop-at
  [ctx : TcContext]
  [scrut-ty : AstType]
  [arms : (& arms AstMatchArmList)]
  [seen-catchall : bool]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get arms len))
    ResultTcUnit.Ok
    (if seen-catchall
      (ResultTcUnit.Err "typecheck: unreachable match arm after wildcard `_`")
      (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
        [(AstMatchArm.Arm pattern _)
          (tc-match-arm-reachability-loop-at
            ctx
            scrut-ty
            arms
            (tc-match-pattern-catchall-for-type? ctx scrut-ty pattern)
            (+ index 1))]))))

(define (tc-match-arm-reachability-ok
  [ctx : TcContext]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : ResultTcUnit
  (tc-match-arm-reachability-loop ctx scrut-ty arms false))

(define (tc-match-coverage-type [ctx : TcContext] [scrut-ty : AstType]) : AstType
  (match (tc-type-strip-region (tc-resolve-type ctx scrut-ty))
    [(AstType.Ref _ referent-box)
      (let
        [referent-ty : AstType
          (tc-type-strip-region
            (tc-resolve-type ctx (ty-node-get referent-box)))]
        (match referent-ty
          [(AstType.Enum _) referent-ty]
          [(AstType.EnumArgs _ _) referent-ty]
          [_ scrut-ty]))]
    [_ scrut-ty]))

(define (tc-match-bool-exhaustive-ok [arms : AstMatchArmList]) : ResultTcUnit
  (if (tc-match-arms-have-catchall? arms)
    ResultTcUnit.Ok
    (if (tc-match-arms-cover-bool? arms true)
      (if (tc-match-arms-cover-bool? arms false)
        ResultTcUnit.Ok
        (ResultTcUnit.Err "typecheck: match missing arm for false"))
      (ResultTcUnit.Err "typecheck: match missing arm for true"))))

(define (tc-match-exhaustiveness-ok
  [ctx : TcContext]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : ResultTcUnit
  (match (tc-type-strip-region scrut-ty)
    [(AstType.Enum enum-name)
      (let
        [enum-name-str : String (intern-str enum-name)]
        (match (tc-context-enum-variants ctx enum-name-str)
          [(ResultAstVariantDefList.Ok variants)
            (tc-enum-variants-exhaustive-ok ctx enum-name-str variants arms)]
          [(ResultAstVariantDefList.Err _)
            (ResultTcUnit.Err "typecheck: non-exhaustive match")]))]
    [(AstType.EnumArgs enum-name _)
      (let
        [enum-name-str : String (intern-str enum-name)]
        (match (tc-program-enum-variants (tc-context-program ctx) enum-name-str)
          [(ResultAstVariantDefList.Ok variants)
            (tc-enum-variants-exhaustive-ok ctx enum-name-str variants arms)]
          [(ResultAstVariantDefList.Err _)
            (ResultTcUnit.Err "typecheck: non-exhaustive match")]))]
    [(AstType.Bool) (tc-match-bool-exhaustive-ok arms)]
    [_
      (if (tc-match-arms-have-catchall-for-type? ctx scrut-ty arms)
        ResultTcUnit.Ok
        (ResultTcUnit.Err "typecheck: non-exhaustive match"))]))

(define (tc-match-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : ResultTcType
  (let
    [coverage-ty : AstType (tc-match-coverage-type ctx scrut-ty)]
    (match (tc-match-arm-reachability-ok ctx coverage-ty arms)
      [(ResultTcUnit.Ok)
        (match (tc-check-match-arm-types ctx env scrut-ty arms)
          [(ResultTcType.Ok result-ty)
            (match (tc-match-exhaustiveness-ok ctx coverage-ty arms)
              [(ResultTcUnit.Ok) (ResultTcType.Ok result-ty)]
              [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
          [(ResultTcType.Err message) (ResultTcType.Err message)])]
      [(ResultTcUnit.Err message) (ResultTcType.Err message)])))

(define (tc-match-expr-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [expected : AstType]) : ResultTcType
  (let
    [coverage-ty : AstType (tc-match-coverage-type ctx scrut-ty)]
    (match (tc-match-arm-reachability-ok ctx coverage-ty arms)
      [(ResultTcUnit.Ok)
        (match (tc-check-match-arm-types-with-expected
          ctx
          env
          scrut-ty
          arms
          expected)
          [(ResultTcType.Ok result-ty)
            (match (tc-match-exhaustiveness-ok ctx coverage-ty arms)
              [(ResultTcUnit.Ok) (ResultTcType.Ok result-ty)]
              [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
          [(ResultTcType.Err message) (ResultTcType.Err message)])]
      [(ResultTcUnit.Err message) (ResultTcType.Err message)])))

;; spmd-reduce operator/type rules (#1011, SPEC 5.15): the init/value/result type
;; must be in the operator's supported set -- `sum` over i32/i64/f64, `min`/`max`
;; over i32/i64, `all`/`any` over bool.
(define (tc-reduce-op-type-ok? [op : AstReduceOp] [ty : AstType]) : bool
  (match op
    [(AstReduceOp.Sum)
      (match ty
        [(AstType.I32) true]
        [(AstType.I64) true]
        [(AstType.F64) true]
        [_ false])]
    [(AstReduceOp.Min)
      (match ty
        [(AstType.I32) true]
        [(AstType.I64) true]
        [_ false])]
    [(AstReduceOp.Max)
      (match ty
        [(AstType.I32) true]
        [(AstType.I64) true]
        [_ false])]
    [(AstReduceOp.All)
      (match ty
        [(AstType.Bool) true]
        [_ false])]
    [(AstReduceOp.Any)
      (match ty
        [(AstType.Bool) true]
        [_ false])]))

(define (tc-reduce-op-type-msg [op : AstReduceOp]) : String
  (match op
    [(AstReduceOp.Sum)
      "typecheck: spmd-reduce sum requires an i32, i64, or f64 type"]
    [(AstReduceOp.Min) "typecheck: spmd-reduce min requires an i32 or i64 type"]
    [(AstReduceOp.Max) "typecheck: spmd-reduce max requires an i32 or i64 type"]
    [(AstReduceOp.All) "typecheck: spmd-reduce all requires a bool type"]
    [(AstReduceOp.Any) "typecheck: spmd-reduce any requires a bool type"]))

(define (tc-scan-op-type-ok? [op : AstReduceOp] [ty : AstType]) : bool
  (match op
    [(AstReduceOp.Sum)
      (match ty
        [(AstType.I32) true]
        [(AstType.I64) true]
        [_ false])]
    [(AstReduceOp.Min)
      (match ty
        [(AstType.I32) true]
        [(AstType.I64) true]
        [_ false])]
    [(AstReduceOp.Max)
      (match ty
        [(AstType.I32) true]
        [(AstType.I64) true]
        [_ false])]
    [(AstReduceOp.All)
      (match ty
        [(AstType.Bool) true]
        [_ false])]
    [(AstReduceOp.Any)
      (match ty
        [(AstType.Bool) true]
        [_ false])]))

(define (tc-scan-op-type-msg [op : AstReduceOp]) : String
  (match op
    [(AstReduceOp.Sum)
      "typecheck: spmd-scan sum requires an i32 or i64 type; floating-point scan ordering is deferred"]
    [(AstReduceOp.Min)
      "typecheck: spmd-scan min requires an i32 or i64 type; floating-point scan ordering is deferred"]
    [(AstReduceOp.Max)
      "typecheck: spmd-scan max requires an i32 or i64 type; floating-point scan ordering is deferred"]
    [(AstReduceOp.All) "typecheck: spmd-scan all requires a bool type"]
    [(AstReduceOp.Any) "typecheck: spmd-scan any requires a bool type"]))

;; spmd-reduce purity/effect rules (#1011, SPEC.md 5.15): mirror the Rust
;; typechecker's `check_spmd_reduce_value`. The first reduction slice accepts a
;; narrow, clearly-pure surface and rejects everything else with a focused
;; diagnostic rather than guessing at varying/uniform semantics not yet
;; implemented: the varying index, uniform variables, and literals;
;; arithmetic/comparison/boolean operators over those; `ann`/`cast` wrappers;
;; dynamic-array reads whose index is not itself another array read (direct,
;; non-gather indexing only); and local `let` bindings whose initializers obey
;; the same rules. Writes (`set!`, `array-set!`), function calls, nested
;; `foreach`/`spmd-reduce`, varying control flow (`if`/`while`/`match`),
;; sequencing, and aggregate constructors are rejected. The `in-index` flag is
;; set while walking an array-read index so a nested read (a gather) is
;; rejected. Uniformity of `start`/`end`/`init` is enforced by scoping: they are
;; typed outside the lane context, so referencing the index is an unbound error.
(define (tc-spmd-value-pure [expr : AstExpr]) : ResultTcUnit
  (tc-spmd-value-pure-at expr false))

(define (tc-spmd-value-pure-at [expr : AstExpr] [in-index : bool]) : ResultTcUnit
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-value-pure-at inner in-index))]
    [(AstExpr.Literal _) ResultTcUnit.Ok]
    [(AstExpr.SpmdProgramIndex) ResultTcUnit.Ok]
    [(AstExpr.SpmdProgramCount) ResultTcUnit.Ok]
    [(AstExpr.Var _) ResultTcUnit.Ok]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (match (tc-spmd-value-pure-at left in-index)
          [(ResultTcUnit.Ok) (tc-spmd-value-pure-at right in-index)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-value-pure-at inner in-index))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-value-pure-at inner in-index))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-spmd-value-pure-at inner in-index))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-spmd-value-let-bindings-pure-at bindings in-index)
              [(ResultTcUnit.Ok) (tc-spmd-value-pure-at body in-index)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (if in-index
          (ResultTcUnit.Err
            "indirect array indexing is not allowed inside a spmd-reduce value expression; gather/scatter is deferred in the first slice (SPEC.md 5.15)")
          (match (tc-spmd-value-pure-at array false)
            [(ResultTcUnit.Ok) (tc-spmd-value-pure-at index true)]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))]
    [(AstExpr.Set _ _)
      (ResultTcUnit.Err
        "`set!` is not allowed inside a spmd-reduce value expression; reductions must use the explicit accumulator, not outer mutation (SPEC.md 5.15)")]
    [(AstExpr.ArraySet _ _ _)
      (ResultTcUnit.Err
        "`array-set!` is not allowed inside a spmd-reduce value expression; the value expression must be free of writes and other side effects (SPEC.md 5.15)")]
    [(AstExpr.StructSet _ _ _)
      (ResultTcUnit.Err
        "struct field assignment is not allowed inside a spmd-reduce value expression; the value expression must be free of writes and other side effects (SPEC.md 5.15)")]
    [(AstExpr.ArrayPush _ _)
      (ResultTcUnit.Err
        "`array-push!` is not allowed inside a spmd-reduce value expression; the value expression must be free of writes and other side effects (SPEC.md 5.15)")]
    [(AstExpr.Call _ _)
      (ResultTcUnit.Err
        "function calls are not allowed inside a spmd-reduce value expression; side-effecting builtins and user calls with varying arguments are deferred in the first slice (SPEC.md 5.15)")]
    [(AstExpr.Foreach _)
      (ResultTcUnit.Err
        "a nested foreach is not allowed inside a spmd-reduce value expression (SPEC.md 5.15)")]
    [(AstExpr.SpmdReduce _)
      (ResultTcUnit.Err
        "a nested spmd-reduce is not allowed inside a spmd-reduce value expression (SPEC.md 5.15)")]
    [(AstExpr.SpmdScan _)
      (ResultTcUnit.Err
        "a nested spmd-scan is not allowed inside a spmd-reduce value expression (SPEC.md 5.15)")]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (if in-index
        (ResultTcUnit.Err
          "spmd-broadcast is not allowed inside an array index in a spmd-reduce value expression (SPEC.md 5.15)")
        (let
          [value : AstExpr (ast-node-get value-box)]
          [lane : AstExpr (ast-node-get lane-box)]
          (match (tc-spmd-value-pure-at value false)
            [(ResultTcUnit.Ok) (tc-spmd-value-pure-at lane false)]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (if in-index
        (ResultTcUnit.Err
          "spmd-shuffle is not allowed inside an array index in a spmd-reduce value expression (SPEC.md 5.15)")
        (let
          [value : AstExpr (ast-node-get value-box)]
          [lane : AstExpr (ast-node-get lane-box)]
          (match (tc-spmd-value-pure-at value false)
            [(ResultTcUnit.Ok) (tc-spmd-value-pure-at lane false)]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))]
    [(AstExpr.If _ _ _)
      (ResultTcUnit.Err
        "varying control flow is not allowed inside a spmd-reduce value expression; the first slice has no varying if/while/match (SPEC.md 5.15)")]
    [(AstExpr.While _ _)
      (ResultTcUnit.Err
        "varying control flow is not allowed inside a spmd-reduce value expression; the first slice has no varying if/while/match (SPEC.md 5.15)")]
    [(AstExpr.Match _)
      (ResultTcUnit.Err
        "varying control flow is not allowed inside a spmd-reduce value expression; the first slice has no varying if/while/match (SPEC.md 5.15)")]
    [_
      (ResultTcUnit.Err
        "this expression is not allowed inside a spmd-reduce value expression; the first slice allows only the varying index, uniform variables, literals, arithmetic/comparison/boolean operators, dynamic-array reads, and local let bindings (SPEC.md 5.15)")]))

(define (tc-spmd-value-let-bindings-pure-at
  [bindings : AstLetBindingList]
  [in-index : bool]) : ResultTcUnit
  (tc-spmd-value-let-bindings-pure-at-index (& bindings) in-index 0))

(define (tc-spmd-value-let-bindings-pure-at-index
  [bindings : (& bindings AstLetBindingList)]
  [in-index : bool]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-let-binding-list-len bindings))
    ResultTcUnit.Ok
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding _ _ init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (match (tc-spmd-value-pure-at init in-index)
            [(ResultTcUnit.Ok)
              (tc-spmd-value-let-bindings-pure-at-index
                bindings
                in-index
                (+ index 1))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])))

(define (tc-spmd-reduce-type-from-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [value-env : TcTypeEnv]
  [op : AstReduceOp]
  [init : AstExpr]
  [value : AstExpr]) : ResultTcType
  (match (tc-expr ctx value-env value)
    [(ResultTcType.Ok value-ty)
      (if (tc-reduce-op-type-ok? op (tc-resolve-type ctx value-ty))
        (match (tc-expr-with-expected-or-actual ctx env init value-ty)
          [(ResultTcType.Ok init-ty)
            (match (tc-expect
              init-ty
              value-ty
              "typecheck: spmd-reduce init and value type mismatch")
              [(ResultTcUnit.Ok) (ResultTcType.Ok value-ty)]
              [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
          [(ResultTcType.Err message) (ResultTcType.Err message)])
        (ResultTcType.Err (tc-reduce-op-type-msg op)))]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (tc-spmd-reduce-type-from-value-or-message
  [ctx : TcContext]
  [env : TcTypeEnv]
  [value-env : TcTypeEnv]
  [op : AstReduceOp]
  [init : AstExpr]
  [value : AstExpr]
  [fallback-message : String]) : ResultTcType
  (match (tc-spmd-reduce-type-from-value ctx env value-env op init value)
    [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
    [(ResultTcType.Err _) (ResultTcType.Err fallback-message)]))

(define (tc-spmd-reduce-init-value-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [value-env : TcTypeEnv]
  [op : AstReduceOp]
  [init : AstExpr]
  [value : AstExpr]) : ResultTcType
  (match (tc-expr ctx env init)
    [(ResultTcType.Ok init-ty)
      (if (tc-reduce-op-type-ok? op (tc-resolve-type ctx init-ty))
        (match (tc-spmd-value-pure value)
          [(ResultTcUnit.Ok)
            (match (tc-expr-with-expected-or-actual ctx value-env value init-ty)
              [(ResultTcType.Ok value-ty)
                (match (tc-expect
                  value-ty
                  init-ty
                  "typecheck: spmd-reduce init and value type mismatch")
                  [(ResultTcUnit.Ok) (ResultTcType.Ok init-ty)]
                  [(ResultTcUnit.Err message)
                    (tc-spmd-reduce-type-from-value-or-message
                      ctx
                      env
                      value-env
                      op
                      init
                      value
                      message)])]
              [(ResultTcType.Err message)
                (tc-spmd-reduce-type-from-value-or-message
                  ctx
                  env
                  value-env
                  op
                  init
                  value
                  message)])]
          [(ResultTcUnit.Err message) (ResultTcType.Err message)])
        (ResultTcType.Err (tc-reduce-op-type-msg op)))]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (tc-spmd-scan-init-value-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [value-env : TcTypeEnv]
  [op : AstReduceOp]
  [prefix-ty : AstType]
  [init : AstExpr]
  [value : AstExpr]) : ResultTcType
  (let
    [resolved-prefix-ty : AstType (tc-resolve-type ctx prefix-ty)]
    (if (tc-scan-op-type-ok? op resolved-prefix-ty)
      (match (tc-expr-with-expected-or-actual ctx env init resolved-prefix-ty)
        [(ResultTcType.Ok init-ty)
          (match (tc-expect
            (tc-resolve-type ctx init-ty)
            resolved-prefix-ty
            "typecheck: spmd-scan prefix init type mismatch")
            [(ResultTcUnit.Ok)
              (match (tc-spmd-value-pure value)
                [(ResultTcUnit.Ok)
                  (match (tc-expr-with-expected-or-actual
                    ctx
                    value-env
                    value
                    resolved-prefix-ty)
                    [(ResultTcType.Ok value-ty)
                      (match (tc-expect
                        (tc-resolve-type ctx value-ty)
                        resolved-prefix-ty
                        "typecheck: spmd-scan value type mismatch")
                        [(ResultTcUnit.Ok) (ResultTcType.Ok resolved-prefix-ty)]
                        [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                    [(ResultTcType.Err message) (ResultTcType.Err message)])]
                [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])
      (ResultTcType.Err (tc-scan-op-type-msg op)))))

(define (tc-ptr-addr-of-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : String]) : ResultTcType
  (match (tc-require-unsafe env "ptr-addr-of")
    [(ResultTcUnit.Ok)
      (match (tc-ptr-addr-of-local-lookup env name)
        [(ResultTcType.Ok ty)
          (let
            [resolved : AstType (tc-resolve-type ctx ty)]
            (if (tc-ptr-addr-of-cell-type-ok? resolved)
              (ResultTcType.Ok (ast-ty-mut-ptr resolved))
              (ResultTcType.Err
                "typecheck: ptr-addr-of supports local scalar cells only")))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcUnit.Err message) (ResultTcType.Err message)]))

(define (tc-ptr-read-expr [ctx : TcContext] [env : TcTypeEnv] [ptr : AstExpr]) : ResultTcType
  (match (tc-require-unsafe env "ptr-read")
    [(ResultTcUnit.Ok)
      (match (tc-expr ctx env ptr)
        [(ResultTcType.Ok ptr-ty)
          (match (tc-raw-pointer-elem
            (tc-resolve-type ctx ptr-ty)
            "typecheck: ptr-read requires a raw pointer operand")
            [(ResultTcType.Ok elem)
              (ResultTcType.Ok (tc-resolve-type ctx elem))]
            [(ResultTcType.Err message) (ResultTcType.Err message)])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcUnit.Err message) (ResultTcType.Err message)]))

(define (tc-ptr-write-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ptr : AstExpr]
  [value : AstExpr]) : ResultTcType
  (match (tc-require-unsafe env "ptr-write!")
    [(ResultTcUnit.Ok)
      (match (tc-expr ctx env ptr)
        [(ResultTcType.Ok ptr-ty)
          (match (tc-mut-pointer-elem
            (tc-resolve-type ctx ptr-ty)
            "typecheck: ptr-write! requires a MutPtr pointer operand")
            [(ResultTcType.Ok elem)
              (match (tc-expr-with-expected-or-actual
                ctx
                env
                value
                (tc-resolve-type ctx elem))
                [(ResultTcType.Ok value-ty)
                  (match (tc-expect
                    value-ty
                    (tc-resolve-type ctx elem)
                    "typecheck: ptr-write! value type mismatch")
                    [(ResultTcUnit.Ok) (ResultTcType.Ok (AstType.Unit))]
                    [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                [(ResultTcType.Err message) (ResultTcType.Err message)])]
            [(ResultTcType.Err message) (ResultTcType.Err message)])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcUnit.Err message) (ResultTcType.Err message)]))

(define (tc-ptr-offset-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ptr : AstExpr]
  [offset : AstExpr]) : ResultTcType
  (match (tc-require-unsafe env "ptr-offset")
    [(ResultTcUnit.Ok)
      (match (tc-expr ctx env ptr)
        [(ResultTcType.Ok ptr-ty)
          (let
            [resolved-ptr : AstType (tc-resolve-type ctx ptr-ty)]
            (match (tc-raw-pointer-elem
              resolved-ptr
              "typecheck: ptr-offset requires a raw pointer operand")
              [(ResultTcType.Ok _)
                (match (tc-expr-with-expected-or-actual
                  ctx
                  env
                  offset
                  (AstType.I64))
                  [(ResultTcType.Ok offset-ty)
                    (if (tc-integer-type? offset-ty)
                      (ResultTcType.Ok resolved-ptr)
                      (ResultTcType.Err
                        "typecheck: ptr-offset requires an integer offset"))]
                  [(ResultTcType.Err message) (ResultTcType.Err message)])]
              [(ResultTcType.Err message) (ResultTcType.Err message)]))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcUnit.Err message) (ResultTcType.Err message)]))

(define (tc-ptr-cast-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ptr : AstExpr]
  [target : AstType]) : ResultTcType
  (match (tc-require-unsafe env "ptr-cast")
    [(ResultTcUnit.Ok)
      (let
        [resolved-target : AstType (tc-resolve-type ctx target)]
        (if (tc-raw-pointer-type? resolved-target)
          (match (tc-expr ctx env ptr)
            [(ResultTcType.Ok ptr-ty)
              (if (tc-raw-pointer-type? (tc-resolve-type ctx ptr-ty))
                (ResultTcType.Ok resolved-target)
                (ResultTcType.Err
                  "typecheck: ptr-cast requires a raw pointer operand"))]
            [(ResultTcType.Err message) (ResultTcType.Err message)])
          (ResultTcType.Err
            "typecheck: ptr-cast target must be a raw pointer type")))]
    [(ResultTcUnit.Err message) (ResultTcType.Err message)]))

(define (tc-ptr-to-int-expr [ctx : TcContext] [env : TcTypeEnv] [ptr : AstExpr]) : ResultTcType
  (match (tc-require-unsafe env "ptr->int")
    [(ResultTcUnit.Ok)
      (match (tc-expr ctx env ptr)
        [(ResultTcType.Ok ptr-ty)
          (if (tc-raw-pointer-type? (tc-resolve-type ctx ptr-ty))
            (ResultTcType.Ok (AstType.U64))
            (ResultTcType.Err
              "typecheck: ptr->int requires a raw pointer operand"))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcUnit.Err message) (ResultTcType.Err message)]))

(define (tc-int-to-ptr-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [value : AstExpr]
  [target : AstType]) : ResultTcType
  (match (tc-require-unsafe env "int->ptr")
    [(ResultTcUnit.Ok)
      (let
        [resolved-target : AstType (tc-resolve-type ctx target)]
        (if (tc-raw-pointer-type? resolved-target)
          (match (tc-expr ctx env value)
            [(ResultTcType.Ok value-ty)
              (if (tc-integer-type? value-ty)
                (ResultTcType.Ok resolved-target)
                (ResultTcType.Err
                  "typecheck: int->ptr requires an integer operand"))]
            [(ResultTcType.Err message) (ResultTcType.Err message)])
          (ResultTcType.Err
            "typecheck: int->ptr target must be a raw pointer type")))]
    [(ResultTcUnit.Err message) (ResultTcType.Err message)]))

(define (tc-string-data-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [str : AstExpr]) : ResultTcType
  (match (tc-require-unsafe env "string-data")
    [(ResultTcUnit.Ok)
      (match (tc-expr ctx env str)
        [(ResultTcType.Ok str-ty)
          (if (tc-length-handle-type? str-ty)
            (ResultTcType.Ok (ast-ty-ptr (AstType.U8)))
            (ResultTcType.Err "typecheck: string-data requires String or bytes"))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcUnit.Err message) (ResultTcType.Err message)]))

(define (tc-string-from-bytes-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ptr : AstExpr]
  [len : AstExpr]) : ResultTcType
  (match (tc-require-unsafe env "string-from-bytes")
    [(ResultTcUnit.Ok)
      (match (tc-expr ctx env ptr)
        [(ResultTcType.Ok ptr-ty)
          (match (tc-type-strip-region (tc-resolve-type ctx ptr-ty))
            [(AstType.Ptr elem)
              (if (tc-type-compatible? (ty-node-get elem) (AstType.U8))
                (match (tc-expr-with-expected-or-actual
                  ctx
                  env
                  len
                  (AstType.I64))
                  [(ResultTcType.Ok len-ty)
                    (if (tc-integer-type? len-ty)
                      (ResultTcType.Ok (AstType.String))
                      (ResultTcType.Err
                        "typecheck: string-from-bytes length must be integer"))]
                  [(ResultTcType.Err message) (ResultTcType.Err message)])
                (ResultTcType.Err
                  "typecheck: string-from-bytes pointer must point at u8"))]
            [(AstType.MutPtr elem)
              (if (tc-type-compatible? (ty-node-get elem) (AstType.U8))
                (match (tc-expr-with-expected-or-actual
                  ctx
                  env
                  len
                  (AstType.I64))
                  [(ResultTcType.Ok len-ty)
                    (if (tc-integer-type? len-ty)
                      (ResultTcType.Ok (AstType.String))
                      (ResultTcType.Err
                        "typecheck: string-from-bytes length must be integer"))]
                  [(ResultTcType.Err message) (ResultTcType.Err message)])
                (ResultTcType.Err
                  "typecheck: string-from-bytes pointer must point at u8"))]
            [_
              (ResultTcType.Err
                "typecheck: string-from-bytes requires a raw u8 pointer")])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcUnit.Err message) (ResultTcType.Err message)]))

(define (tc-array-data-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [array : AstExpr]) : ResultTcType
  (match (tc-require-unsafe env "array-data")
    [(ResultTcUnit.Ok)
      (match (tc-expr ctx env array)
        [(ResultTcType.Ok array-ty)
          (match (tc-type-strip-region (tc-resolve-type ctx array-ty))
            [(AstType.Array elem-ty _)
              (ResultTcType.Ok (ast-ty-mut-ptr (ty-node-get elem-ty)))]
            [(AstType.DynArray elem-ty)
              (ResultTcType.Ok (ast-ty-mut-ptr (ty-node-get elem-ty)))]
            [_ (ResultTcType.Err "typecheck: array-data requires an array")])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcUnit.Err message) (ResultTcType.Err message)]))

(define (tc-program-entry-ptr-expr [env : TcTypeEnv] [name : String]) : ResultTcType
  (match (tc-require-unsafe env name)
    [(ResultTcUnit.Ok) (ResultTcType.Ok (ast-ty-ptr (ast-ty-ptr (AstType.U8))))]
    [(ResultTcUnit.Err message) (ResultTcType.Err message)]))

(define (tc-cpuid-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [leaf : AstExpr]
  [subleaf : AstExpr]) : ResultTcType
  (match (tc-expr-with-expected-or-actual ctx env leaf (AstType.I64))
    [(ResultTcType.Ok leaf-ty)
      (if (tc-integer-type? leaf-ty)
        (match (tc-expr-with-expected-or-actual ctx env subleaf (AstType.I64))
          [(ResultTcType.Ok subleaf-ty)
            (if (tc-integer-type? subleaf-ty)
              (ResultTcType.Ok (AstType.I64))
              (ResultTcType.Err "typecheck: cpuid subleaf must be integer"))]
          [(ResultTcType.Err message) (ResultTcType.Err message)])
        (ResultTcType.Err "typecheck: cpuid leaf must be integer"))]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (tc-xgetbv-expr [ctx : TcContext] [env : TcTypeEnv] [index : AstExpr]) : ResultTcType
  (match (tc-expr-with-expected-or-actual ctx env index (AstType.I64))
    [(ResultTcType.Ok index-ty)
      (if (tc-integer-type? index-ty)
        (ResultTcType.Ok (AstType.I64))
        (ResultTcType.Err "typecheck: xgetbv index must be integer"))]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

;; Each syscall operand (number and arguments) must be an integer; the raw
;; kernel result is an i64.
(define (tc-syscall-args
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]) : ResultTcUnit
  (tc-syscall-args-at ctx env (& args) 0))

(define (tc-syscall-args-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : (& args AstExprList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get args len))
    (ResultTcUnit.Ok)
    (match (tc-expr ctx env (ast-node-get (ast-expr-list-get args index 0)))
      [(ResultTcType.Ok arg-ty)
        (if (tc-integer-type? arg-ty)
          (tc-syscall-args-at ctx env args (+ index 1))
          (ResultTcUnit.Err "typecheck: syscall operands must be integer"))]
      [(ResultTcType.Err message) (ResultTcUnit.Err message)])))

(define (tc-syscall-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [args : AstExprList]) : ResultTcType
  (match (tc-require-unsafe env "syscall")
    [(ResultTcUnit.Ok)
      (match (tc-syscall-args ctx env args)
        [(ResultTcUnit.Ok) (ResultTcType.Ok (AstType.I64))]
        [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
    [(ResultTcUnit.Err message) (ResultTcType.Err message)]))

(define (tc-box-expr [ctx : TcContext] [env : TcTypeEnv] [inner : AstExpr]) : ResultTcType
  (match (tc-ensure-cleanup-resource-not-stored-expr env inner)
    [(ResultTcUnit.Ok)
      (match (tc-expr ctx env inner)
        [(ResultTcType.Ok inner-ty)
          (ResultTcType.Ok (tc-tag-active-region env (ast-ty-box inner-ty)))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcUnit.Err message) (ResultTcType.Err message)]))

(define (tc-box-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [inner : AstExpr]
  [expected : AstType]) : ResultTcType
  (match (tc-type-strip-region (tc-resolve-type ctx expected))
    [(AstType.Box expected-inner)
      (let
        [expected-inner-ty : AstType (ty-node-get expected-inner)]
        (match (tc-ensure-cleanup-resource-not-stored-expr env inner)
          [(ResultTcUnit.Ok)
            (match (tc-expr-with-expected-or-actual
              ctx
              env
              inner
              expected-inner-ty)
              [(ResultTcType.Ok inner-ty)
                (ResultTcType.Ok
                  (tc-tag-active-region
                    env
                    (ast-ty-box
                      (tc-contextual-result-type expected-inner-ty inner-ty))))]
              [(ResultTcType.Err message) (ResultTcType.Err message)])]
          [(ResultTcUnit.Err message) (ResultTcType.Err message)]))]
    [_ (tc-box-expr ctx env inner)]))

(define (tc-box-get-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [box-expr : AstExpr]) : ResultTcType
  (match (tc-expr ctx env box-expr)
    [(ResultTcType.Ok box-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx box-ty))
        [(AstType.Box inner-ty)
          (ResultTcType.Ok
            (tc-project-from-region-container box-ty (ty-node-get inner-ty)))]
        [_ (ResultTcType.Err "typecheck: box-get requires Box type")])]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (tc-box-get-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [box-expr : AstExpr]
  [expected : AstType]) : ResultTcType
  (match (tc-expr-with-expected-or-actual
    ctx
    env
    box-expr
    (ast-ty-box expected))
    [(ResultTcType.Ok box-ty)
      (match (tc-type-strip-region (tc-resolve-type ctx box-ty))
        [(AstType.Box inner-ty)
          (let
            [projected : AstType
              (tc-project-from-region-container box-ty (ty-node-get inner-ty))]
            (if (tc-type-compatible? expected projected)
              (ResultTcType.Ok (tc-contextual-result-type expected projected))
              (ResultTcType.Ok projected)))]
        [_ (ResultTcType.Err "typecheck: box-get requires Box type")])]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (tc-box-take-expr-with-expected-or-actual
  [ctx : TcContext]
  [env : TcTypeEnv]
  [box-expr : AstExpr]
  [expected : AstType]) : ResultTcType
  (match (tc-box-get-expr-with-expected-or-actual ctx env box-expr expected)
    [(ResultTcType.Ok inner-ty) (ResultTcType.Ok inner-ty)]
    [(ResultTcType.Err message)
      (if (string.eq message "typecheck: box-get requires Box type")
        (ResultTcType.Err "typecheck: box-take requires Box type")
        (ResultTcType.Err message))]))

(define (tc-box-take-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [box-expr : AstExpr]) : ResultTcType
  (match (tc-box-get-expr ctx env box-expr)
    [(ResultTcType.Ok inner-ty) (ResultTcType.Ok inner-ty)]
    [(ResultTcType.Err message)
      (if (string.eq message "typecheck: box-get requires Box type")
        (ResultTcType.Err "typecheck: box-take requires Box type")
        (ResultTcType.Err message))]))

(define (tc-box-set-inner-type [ctx : TcContext] [box-ty : AstType]) : ResultTcType
  (match (tc-type-strip-region (tc-resolve-type ctx box-ty))
    [(AstType.Box inner-ty)
      (ResultTcType.Ok
        (tc-project-from-region-container box-ty (ty-node-get inner-ty)))]
    [(AstType.Ref _ _)
      (ResultTcType.Err "typecheck: set! box requires mutable Box access")]
    [_ (ResultTcType.Err "typecheck: set! box requires Box type")]))

(define (tc-box-mutation-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [box-expr : AstExpr]
  [value : AstExpr]) : ResultTcType
  (match (tc-store-place-lifetime ctx env box-expr)
    [(ResultTcString.Ok _)
      (match (tc-expr ctx env box-expr)
        [(ResultTcType.Ok box-ty)
          (match (tc-box-set-inner-type ctx box-ty)
            [(ResultTcType.Ok inner-ty)
              (match (tc-expr-with-expected-or-actual ctx env value inner-ty)
                [(ResultTcType.Ok value-ty)
                  (match (tc-expect
                    value-ty
                    inner-ty
                    "typecheck: box assignment type mismatch")
                    [(ResultTcUnit.Ok)
                      (match (tc-ensure-cleanup-resource-not-stored-expr
                        env
                        value)
                        [(ResultTcUnit.Ok)
                          (match (tc-ensure-region-value-can-flow-into
                            env
                            inner-ty
                            value-ty
                            "box")
                            [(ResultTcUnit.Ok)
                              (match (tc-ensure-reference-value-can-store-in-place
                                ctx
                                env
                                (ast-node-get
                                  (ast-expr-box-get (ast-node-push box-expr)))
                                value-ty
                                "box")
                                [(ResultTcUnit.Ok)
                                  (ResultTcType.Ok (AstType.Unit))]
                                [(ResultTcUnit.Err message)
                                  (ResultTcType.Err message)])]
                            [(ResultTcUnit.Err message)
                              (ResultTcType.Err message)])]
                        [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                    [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                [(ResultTcType.Err message) (ResultTcType.Err message)])]
            [(ResultTcType.Err message) (ResultTcType.Err message)])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcString.Err message) (ResultTcType.Err message)]))

(define (tc-init-unsupported-message [ctx : TcContext] [ty : AstType]) : String
  (string.append
    "typecheck: init unsupported type "
    (tc-type-render (tc-type-without-regions (tc-resolve-type ctx ty)))))

(define (tc-init-cleanup-owning-message [ctx : TcContext] [ty : AstType]) : String
  (string.append
    "typecheck: init does not support cleanup-owning aggregate "
    (tc-type-render (tc-type-without-regions (tc-resolve-type ctx ty)))))

(define (tc-init-aggregate-layout-ok [ctx : TcContext] [ty : AstType]) : ResultTcUnit
  (match (tc-inline-aggregate-type-layout ctx ty)
    [(ResultTcLayoutInfo.Ok _) ResultTcUnit.Ok]
    [(ResultTcLayoutInfo.Err message) (ResultTcUnit.Err message)]))

(define (tc-init-type-list-supported
  [ctx : TcContext]
  [env : TcTypeEnv]
  [types : AstTypeList]) : ResultTcUnit
  (tc-init-type-list-supported-at ctx env (& types) 0))

(define (tc-init-type-list-supported-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [types : (& types AstTypeList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-type-list-len types))
    ResultTcUnit.Ok
    (match (tc-init-type-supported
      ctx
      env
      (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      [(ResultTcUnit.Ok)
        (tc-init-type-list-supported-at ctx env types (+ index 1))]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

(define (tc-init-struct-field-types-for-result
  [ctx : TcContext]
  [struct-name : String]
  [struct-ty : AstType]
  [fields : AstFieldDefList]) : AstTypeList
  (let
    [field-types : AstTypeList
      (tc-resolve-type-list ctx (tc-field-type-list ctx fields))]
    (match struct-ty
      [(AstType.StructArgs _ lifetimes)
        (match (tc-lifetime-subst-from-nominal-args
          ctx
          struct-name
          (box-get lifetimes))
          [(ResultTcLifetimeSubst.Ok subst)
            (tc-lifetime-subst-type-list subst field-types)]
          [(ResultTcLifetimeSubst.Err _) field-types])]
      [(AstType.VarArgs _ lifetimes)
        (match (tc-lifetime-subst-from-nominal-args
          ctx
          struct-name
          (box-get lifetimes))
          [(ResultTcLifetimeSubst.Ok subst)
            (tc-lifetime-subst-type-list subst field-types)]
          [(ResultTcLifetimeSubst.Err _) field-types])]
      [_ field-types])))

(define (tc-init-enum-fields-for-result
  [ctx : TcContext]
  [enum-name : String]
  [enum-ty : AstType]
  [fields : AstTypeList]) : AstTypeList
  (let
    [field-types : AstTypeList (tc-resolve-type-list ctx fields)]
    (match enum-ty
      [(AstType.EnumArgs _ lifetimes)
        (match (tc-lifetime-subst-from-nominal-args
          ctx
          enum-name
          (box-get lifetimes))
          [(ResultTcLifetimeSubst.Ok subst)
            (tc-lifetime-subst-type-list subst field-types)]
          [(ResultTcLifetimeSubst.Err _) field-types])]
      [(AstType.VarArgs _ lifetimes)
        (match (tc-lifetime-subst-from-nominal-args
          ctx
          enum-name
          (box-get lifetimes))
          [(ResultTcLifetimeSubst.Ok subst)
            (tc-lifetime-subst-type-list subst field-types)]
          [(ResultTcLifetimeSubst.Err _) field-types])]
      [_ field-types])))

(define (tc-context-with-nominal-owner-module
  [ctx : TcContext]
  [nominal-name : String]) : TcContext
  (if (tc-name-qualified? nominal-name)
    (tc-context-with-module ctx (tc-qualified-name-module nominal-name))
    ctx))

(define (tc-context-with-nominal-owner-handle-module
  [ctx : TcContext]
  [handle : i64]) : TcContext
  (match (tc-nominal-owner-name ctx handle)
    [(ResultTcString.Ok owner-name)
      (if (tc-name-qualified? owner-name)
        (tc-context-with-module ctx (tc-qualified-name-module owner-name))
        (tc-context-with-module ctx ""))]
    [(ResultTcString.Err _) ctx]))

(define (tc-init-nominal-field-context
  [ctx : TcContext]
  [nominal-name : String]) : TcContext
  (let
    [handle : i64
      (compiler-symbols-lookup-type-or
        (tc-context-symbols ctx)
        nominal-name
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (tc-context-with-nominal-owner-handle-module ctx handle)
      (tc-context-with-nominal-owner-module ctx nominal-name))))

(define (tc-init-struct-supported
  [ctx : TcContext]
  [env : TcTypeEnv]
  [struct-name : String]
  [struct-ty : AstType]) : ResultTcUnit
  (match (tc-struct-decl ctx struct-name)
    [(ResultTcStructDecl.Ok decl)
      (match decl
        [(TcStructDecl repr cleanup fields)
          (let
            [field-ctx : TcContext
              (tc-init-nominal-field-context ctx struct-name)]
            (if (ast-struct-repr-c? repr)
              (ResultTcUnit.Err
                "typecheck: init supports only default-layout structs")
              (if (ast-struct-cleanup? cleanup)
                (ResultTcUnit.Err
                  (tc-init-cleanup-owning-message ctx struct-ty))
                (match (tc-init-aggregate-layout-ok field-ctx struct-ty)
                  [(ResultTcUnit.Ok)
                    (tc-init-type-list-supported
                      field-ctx
                      env
                      (tc-init-struct-field-types-for-result
                        field-ctx
                        struct-name
                        struct-ty
                        fields))]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))))])]
    [(ResultTcStructDecl.Err message) (ResultTcUnit.Err message)]))

(define (tc-init-enum-supported
  [ctx : TcContext]
  [env : TcTypeEnv]
  [enum-name : String]
  [enum-ty : AstType]) : ResultTcUnit
  (let
    [field-ctx : TcContext (tc-init-nominal-field-context ctx enum-name)]
    (match (tc-enum-decl ctx enum-name)
      [(ResultTcEnumDecl.Ok decl)
        (match decl
          [(TcEnumDecl cleanup variants)
            (if (ast-enum-cleanup? cleanup)
              (ResultTcUnit.Err (tc-init-cleanup-owning-message ctx enum-ty))
              (match (tc-init-aggregate-layout-ok field-ctx enum-ty)
                [(ResultTcUnit.Ok)
                  (if (ast-variant-def-list-empty? (& variants))
                    (ResultTcUnit.Err
                      "typecheck: init requires enum with at least one variant")
                    (match (ast-variant-def-list-get
                      (& variants)
                      0
                      (ast-variant-def-fallback))
                      [(AstVariantDef.Def _ fields _)
                        (tc-init-type-list-supported
                          field-ctx
                          env
                          (tc-init-enum-fields-for-result
                            field-ctx
                            enum-name
                            enum-ty
                            fields))]))]
                [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])]
      [(ResultTcEnumDecl.Err message) (ResultTcUnit.Err message)])))

(define (tc-init-type-supported
  [ctx : TcContext]
  [env : TcTypeEnv]
  [ty : AstType]) : ResultTcUnit
  (let
    [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (if (tc-integer-type? resolved)
      ResultTcUnit.Ok
      (match resolved
        [(AstType.F64) ResultTcUnit.Ok]
        [(AstType.F32) ResultTcUnit.Ok]
        [(AstType.Bool) ResultTcUnit.Ok]
        [(AstType.Char) ResultTcUnit.Ok]
        [(AstType.Unit) ResultTcUnit.Ok]
        [(AstType.String) ResultTcUnit.Ok]
        [(AstType.Ptr _) ResultTcUnit.Ok]
        [(AstType.MutPtr _) ResultTcUnit.Ok]
        [(AstType.DynArray elem)
          (let
            [elem-ty : AstType
              (tc-type-without-regions (tc-resolve-type ctx (ty-node-get elem)))]
            (if (tc-dyn-array-elem-supported? env elem-ty)
              ResultTcUnit.Ok
              (ResultTcUnit.Err
                "typecheck: init dynamic array element type is not supported")))]
        [(AstType.Box elem) (tc-init-type-supported ctx env (ty-node-get elem))]
        [(AstType.Tuple elems)
          (match (tc-init-aggregate-layout-ok ctx resolved)
            [(ResultTcUnit.Ok)
              (tc-init-type-list-supported ctx env (box-get elems))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
        [(AstType.Array elem count)
          (if (< count 0)
            (ResultTcUnit.Err
              "typecheck: init fixed array length must be non-negative")
            (match (tc-init-aggregate-layout-ok ctx resolved)
              [(ResultTcUnit.Ok)
                (tc-init-type-supported ctx env (ty-node-get elem))]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
        [(AstType.Struct name)
          (tc-init-struct-supported ctx env (intern-str name) resolved)]
        [(AstType.StructArgs name _)
          (tc-init-struct-supported ctx env (intern-str name) resolved)]
        [(AstType.Enum name)
          (tc-init-enum-supported ctx env (intern-str name) resolved)]
        [(AstType.EnumArgs name _)
          (tc-init-enum-supported ctx env (intern-str name) resolved)]
        [_ (ResultTcUnit.Err (tc-init-unsupported-message ctx resolved))]))))

(define (tc-init-expr [ctx : TcContext] [env : TcTypeEnv] [ty : AstType]) : ResultTcType
  (let
    [resolved : AstType (tc-type-without-regions (tc-resolve-type ctx ty))]
    (match (tc-init-type-supported ctx env resolved)
      [(ResultTcUnit.Ok) (ResultTcType.Ok (tc-tag-active-region env resolved))]
      [(ResultTcUnit.Err message) (ResultTcType.Err message)])))

(define (tc-make-array-zero-literal-length? [len : AstExpr]) : bool
  (match (ast-expr-unspan len)
    [(AstExpr.Literal (AstLiteral.Int value _)) (= value 0)]
    [_ false]))

(define (tc-make-array-requires-element-init? [elem : AstType] [len : AstExpr]) : bool
  (not
    (and
      (tc-make-array-zero-literal-length? len)
      (not (tc-type-contains-reference? elem)))))

(define (tc-quasiquote-template-list-ok
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]) : ResultTcUnit
  (tc-quasiquote-template-list-ok-at ctx env (& exprs) 0))

(define (tc-quasiquote-template-list-ok-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get exprs len))
    ResultTcUnit.Ok
    (match (tc-quasiquote-template-ok
      ctx
      env
      (ast-node-get (ast-expr-list-get exprs index 0)))
      [(ResultTcUnit.Ok)
        (tc-quasiquote-template-list-ok-at ctx env exprs (+ index 1))]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

(define (tc-quasiquote-template-ok
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]) : ResultTcUnit
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-quasiquote-template-ok ctx env inner))]
    [(AstExpr.Unquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-expr ctx env inner)
          [(ResultTcType.Ok ty)
            (tc-expect ty (AstType.Expr) "typecheck: unquote expects Expr")]
          [(ResultTcType.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.UnquoteSplicing inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-expr ctx env inner)
          [(ResultTcType.Ok ty)
            (tc-expect
              ty
              (AstType.ExprList)
              "typecheck: unquote-splicing expects ExprList")]
          [(ResultTcType.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.Binary _ left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (match (tc-quasiquote-template-ok ctx env left)
          [(ResultTcUnit.Ok) (tc-quasiquote-template-ok ctx env right)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.Unary _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-quasiquote-template-ok ctx env inner))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (match (tc-quasiquote-template-ok ctx env func)
          [(ResultTcUnit.Ok) (tc-quasiquote-template-list-ok ctx env args)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.BracketClause items)
      (tc-quasiquote-template-list-ok ctx env items)]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (match (tc-quasiquote-template-ok ctx env cond)
          [(ResultTcUnit.Ok)
            (match (tc-quasiquote-template-ok ctx env then-branch)
              [(ResultTcUnit.Ok)
                (tc-quasiquote-template-ok ctx env else-branch)]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.Tuple exprs) (tc-quasiquote-template-list-ok ctx env exprs)]
    [(AstExpr.Array exprs) (tc-quasiquote-template-list-ok ctx env exprs)]
    [(AstExpr.Begin exprs) (tc-quasiquote-template-list-ok ctx env exprs)]
    [(AstExpr.Unsafe exprs) (tc-quasiquote-template-list-ok ctx env exprs)]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-quasiquote-template-ok ctx env inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-quasiquote-template-ok ctx env inner))]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-quasiquote-template-ok ctx env inner))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-quasiquote-template-ok ctx env inner))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-quasiquote-template-ok ctx env inner))]
    [(AstExpr.BoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-quasiquote-template-ok ctx env inner)
          [(ResultTcUnit.Ok) (tc-quasiquote-template-ok ctx env value)]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-quasiquote-template-ok ctx env inner))]
    [(AstExpr.Return inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-quasiquote-template-ok ctx env inner))]
    [(AstExpr.Quote _) ResultTcUnit.Ok]
    [(AstExpr.Quasiquote inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-quasiquote-template-ok ctx env inner))]
    [_ ResultTcUnit.Ok]))

(define (tc-clone-out-unsupported-message
  [ctx : TcContext]
  [form : String]
  [ty : AstType]) : String
  (str_cat.str-cat
    "typecheck: "
    form
    " result type is not clone-supported: "
    (tc-type-render (tc-type-without-regions (tc-resolve-type ctx ty)))))

(define (tc-with-escape-unsupported-message [ctx : TcContext] [ty : AstType]) : String
  (tc-clone-out-unsupported-message ctx "with-escape" ty))

(define (tc-with-scratch-unsupported-message [ctx : TcContext] [ty : AstType]) : String
  (tc-clone-out-unsupported-message ctx "with-scratch" ty))

(define (tc-with-region-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [region : String]
  [body : AstExprList]) : ResultTcType
  (let
    [region-env : TcTypeEnv (tc-push-region env region)]
    (match (tc-begin-list ctx region-env body)
      [(ResultTcType.Ok body-ty)
        (if (tc-type-contains-region body-ty region)
          (ResultTcType.Err
            (string.append
              "typecheck: region-tagged value cannot escape with-arena '"
              (string.append region "'")))
          (ResultTcType.Ok body-ty))]
      [(ResultTcType.Err message) (ResultTcType.Err message)])))

(define (tc-with-region-expr-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [region : String]
  [body : AstExprList]
  [expected : AstType]) : ResultTcType
  (let
    [region-env : TcTypeEnv (tc-push-region env region)]
    (match (tc-begin-list-with-expected ctx region-env body expected)
      [(ResultTcType.Ok body-ty)
        (if (tc-type-contains-region body-ty region)
          (ResultTcType.Err
            (string.append
              "typecheck: region-tagged value cannot escape with-arena '"
              (string.append region "'")))
          (ResultTcType.Ok body-ty))]
      [(ResultTcType.Err message) (ResultTcType.Err message)])))

;; with-escape is a first-class scratch-arena clone path, not a lexical
;; lifetime binder. The scratch expression is just an arena handle, and
;; supported results leave the form with scratch-region tags erased.
(define (tc-with-escape-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scratch : AstExpr]
  [body : AstExprList]) : ResultTcType
  (match (tc-expr ctx env scratch)
    [(ResultTcType.Ok scratch-ty)
      (if (tc-arena-type? ctx scratch-ty)
        (match (tc-begin-list ctx env body)
          [(ResultTcType.Ok body-ty)
            (if (tc-clone-able-type? ctx body-ty)
              (ResultTcType.Ok (tc-type-without-regions body-ty))
              (ResultTcType.Err
                (tc-with-escape-unsupported-message ctx body-ty)))]
          [(ResultTcType.Err message) (ResultTcType.Err message)])
        (ResultTcType.Err "typecheck: with-escape arena must be Arena"))]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (tc-with-escape-expr-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [scratch : AstExpr]
  [body : AstExprList]
  [expected : AstType]) : ResultTcType
  (match (tc-expr ctx env scratch)
    [(ResultTcType.Ok scratch-ty)
      (if (tc-arena-type? ctx scratch-ty)
        (match (tc-begin-list-with-expected ctx env body expected)
          [(ResultTcType.Ok body-ty)
            (if (tc-clone-able-type? ctx body-ty)
              (ResultTcType.Ok (tc-type-without-regions body-ty))
              (ResultTcType.Err
                (tc-with-escape-unsupported-message ctx body-ty)))]
          [(ResultTcType.Err message) (ResultTcType.Err message)])
        (ResultTcType.Err "typecheck: with-escape arena must be Arena"))]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (tc-with-scratch-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [body : AstExprList]) : ResultTcType
  (match (tc-begin-list ctx env body)
    [(ResultTcType.Ok body-ty)
      (if (tc-clone-able-type? ctx body-ty)
        (ResultTcType.Ok (tc-type-without-regions body-ty))
        (ResultTcType.Err (tc-with-scratch-unsupported-message ctx body-ty)))]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (tc-with-scratch-expr-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [body : AstExprList]
  [expected : AstType]) : ResultTcType
  (match (tc-begin-list-with-expected ctx env body expected)
    [(ResultTcType.Ok body-ty)
      (if (tc-clone-able-type? ctx body-ty)
        (ResultTcType.Ok (tc-type-without-regions body-ty))
        (ResultTcType.Err (tc-with-scratch-unsupported-message ctx body-ty)))]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (tc-in-arena-owner [env : TcTypeEnv] [arena : AstExpr]) : TcMaybeString
  (match (tc-expr-var-name arena)
    [(TcMaybeString.Some name)
      (if (or
        (tc-ordinary-arena-owner-active? env name)
        (tc-atomic-arena-owner-active? env name))
        (TcMaybeString.Some name)
        (TcMaybeString.No))]
    [(TcMaybeString.No) (TcMaybeString.No)]))

(define (tc-in-arena-body-env [env : TcTypeEnv] [arena : AstExpr]) : TcTypeEnv
  (match (tc-in-arena-owner env arena)
    [(TcMaybeString.Some owner)
      (tc-push-region env (tc-current-arena-owner-region env owner))]
    [(TcMaybeString.No) env]))

(define (tc-in-arena-body-result
  [env : TcTypeEnv]
  [arena : AstExpr]
  [body-ty : AstType]) : AstType
  (match (tc-type-outer-region body-ty)
    [(TcMaybeString.Some _) body-ty]
    [(TcMaybeString.No)
      (tc-tag-active-region (tc-in-arena-body-env env arena) body-ty)]))

(define (tc-in-arena-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arena : AstExpr]
  [body : AstExprList]) : ResultTcType
  (match (tc-expr ctx env arena)
    [(ResultTcType.Ok arena-ty)
      (if (tc-arena-type? ctx arena-ty)
        (match (tc-begin-list ctx (tc-in-arena-body-env env arena) body)
          [(ResultTcType.Ok body-ty)
            (ResultTcType.Ok (tc-in-arena-body-result env arena body-ty))]
          [(ResultTcType.Err message) (ResultTcType.Err message)])
        (ResultTcType.Err "typecheck: in-arena arena must be Arena"))]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (tc-in-arena-expr-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arena : AstExpr]
  [body : AstExprList]
  [expected : AstType]) : ResultTcType
  (match (tc-expr ctx env arena)
    [(ResultTcType.Ok arena-ty)
      (if (tc-arena-type? ctx arena-ty)
        (match (tc-begin-list-with-expected
          ctx
          (tc-in-arena-body-env env arena)
          body
          expected)
          [(ResultTcType.Ok body-ty)
            (ResultTcType.Ok (tc-in-arena-body-result env arena body-ty))]
          [(ResultTcType.Err message) (ResultTcType.Err message)])
        (ResultTcType.Err "typecheck: in-arena arena must be Arena"))]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (tc-with-resource-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : AstResourceBindingList]
  [body : AstExprList]) : ResultTcType
  (match (tc-resource-bindings ctx env bindings)
    [(ResultTcEnv.Ok body-env)
      (match (tc-begin-list ctx body-env body)
        [(ResultTcType.Ok body-ty)
          (if (tc-expr-list-result-uses-cleanup-owner?
            body
            (tc-resource-binding-list-add-bound-names bindings TcStringList.Nil)
            TcStringList.Nil)
            (ResultTcType.Err
              "typecheck: cleanup-required resource would escape with scope")
            (ResultTcType.Ok body-ty))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcEnv.Err message) (ResultTcType.Err message)]))

(define (tc-with-resource-expr-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : AstResourceBindingList]
  [body : AstExprList]
  [expected : AstType]) : ResultTcType
  (match (tc-resource-bindings ctx env bindings)
    [(ResultTcEnv.Ok body-env)
      (match (tc-begin-list-with-expected ctx body-env body expected)
        [(ResultTcType.Ok body-ty)
          (if (tc-expr-list-result-uses-cleanup-owner?
            body
            (tc-resource-binding-list-add-bound-names bindings TcStringList.Nil)
            TcStringList.Nil)
            (ResultTcType.Err
              "typecheck: cleanup-required resource would escape with scope")
            (ResultTcType.Ok body-ty))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcEnv.Err message) (ResultTcType.Err message)]))

(define (tc-lambda-expr-with-capture-check
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]
  [maybe-ret : AstMaybeType]
  [body : AstExpr]
  [allow-immutable-reference-captures : bool]) : ResultTcType
  (match (if allow-immutable-reference-captures
    (tc-check-lambda-region-captures-allow-refs env params body)
    (tc-check-lambda-region-captures env params body))
    [(ResultTcUnit.Ok)
      (let
        [lambda-env : TcTypeEnv
          (match maybe-ret
            [(AstMaybeType.Some ret)
              (tc-bind-return-type
                (tc-bind-params ctx (tc-clear-loop-target env) params)
                (tc-resolve-type ctx ret))]
            [(AstMaybeType.No)
              (tc-bind-return-type
                (tc-bind-params ctx (tc-clear-loop-target env) params)
                (AstType.Never))])]
        (match (match maybe-ret
          [(AstMaybeType.Some ret)
            (tc-expr-with-expected-or-actual
              ctx
              lambda-env
              body
              (tc-resolve-type ctx ret))]
          [(AstMaybeType.No) (tc-expr ctx lambda-env body)])
          [(ResultTcType.Ok body-ty)
            (if (and
              (tc-type-contains-any-region body-ty)
              (not
                (tc-type-regions-all-atomic-arena-owners? lambda-env body-ty)))
              (ResultTcType.Err
                "typecheck: lambda return value has region-tagged type; region value would escape")
              (match maybe-ret
                [(AstMaybeType.Some ret)
                  (match (tc-expect
                    body-ty
                    (tc-resolve-type ctx ret)
                    "typecheck: lambda return type mismatch")
                    [(ResultTcUnit.Ok)
                      (ResultTcType.Ok
                        (ast-ty-func
                          (tc-param-type-list ctx params)
                          (tc-resolve-type ctx ret)))]
                    [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                [(AstMaybeType.No)
                  (ResultTcType.Ok
                    (ast-ty-func (tc-param-type-list ctx params) body-ty))]))]
          [(ResultTcType.Err message) (ResultTcType.Err message)]))]
    [(ResultTcUnit.Err message) (ResultTcType.Err message)]))

(define (tc-lambda-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]
  [maybe-ret : AstMaybeType]
  [body : AstExpr]) : ResultTcType
  (tc-lambda-expr-with-capture-check ctx env params maybe-ret body false))

(define (tc-lambda-expr-allow-ref-captures
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]
  [maybe-ret : AstMaybeType]
  [body : AstExpr]) : ResultTcType
  (tc-lambda-expr-with-capture-check ctx env params maybe-ret body true))

(define (tc-array-readable-receiver [ctx : TcContext] [receiver-ty : AstType]) : ResultTcArrayReceiver
  (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
    [(AstType.Array elem-ty _)
      (ResultTcArrayReceiver.Ok
        (TcArrayReceiver receiver-ty (ty-node-get elem-ty)))]
    [(AstType.DynArray elem-ty)
      (ResultTcArrayReceiver.Ok
        (TcArrayReceiver receiver-ty (ty-node-get elem-ty)))]
    [(AstType.Ref _ referent-ty)
      (tc-array-readable-receiver ctx (ty-node-get referent-ty))]
    [(AstType.MutRef _ referent-ty)
      (tc-array-readable-receiver ctx (ty-node-get referent-ty))]
    [_ (ResultTcArrayReceiver.Err "typecheck: array-ref requires array type")]))

(define (tc-array-set-receiver [ctx : TcContext] [receiver-ty : AstType]) : ResultTcArrayReceiver
  (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
    [(AstType.Array elem-ty _)
      (ResultTcArrayReceiver.Ok
        (TcArrayReceiver receiver-ty (ty-node-get elem-ty)))]
    [(AstType.DynArray elem-ty)
      (ResultTcArrayReceiver.Ok
        (TcArrayReceiver receiver-ty (ty-node-get elem-ty)))]
    [(AstType.MutRef _ referent-ty)
      (tc-array-set-receiver ctx (ty-node-get referent-ty))]
    [(AstType.Ref _ _)
      (ResultTcArrayReceiver.Err
        "typecheck: array-set! requires mutable array access")]
    [_ (ResultTcArrayReceiver.Err "typecheck: array-set! requires array type")]))

(define (tc-array-push-receiver [ctx : TcContext] [receiver-ty : AstType]) : ResultTcArrayReceiver
  (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
    [(AstType.DynArray elem-ty)
      (ResultTcArrayReceiver.Ok
        (TcArrayReceiver receiver-ty (ty-node-get elem-ty)))]
    [(AstType.Array _ _)
      (ResultTcArrayReceiver.Err
        "typecheck: array-push! requires dynamic array type")]
    [(AstType.MutRef _ referent-ty)
      (tc-array-push-receiver ctx (ty-node-get referent-ty))]
    [(AstType.Ref _ _)
      (ResultTcArrayReceiver.Err
        "typecheck: array-push! requires mutable dynamic array access")]
    [_
      (ResultTcArrayReceiver.Err
        "typecheck: array-push! requires dynamic array type")]))

(define (tc-array-mutation-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [array : AstExpr]
  [array-ty : AstType]
  [elem-ty : AstType]
  [value : AstExpr]
  [mismatch-message : String]) : ResultTcType
  (match (tc-expr-with-expected-or-actual ctx env value elem-ty)
    [(ResultTcType.Ok value-ty)
      (match (tc-expect value-ty elem-ty mismatch-message)
        [(ResultTcUnit.Ok)
          (match (tc-ensure-cleanup-resource-not-stored-expr env value)
            [(ResultTcUnit.Ok)
              (match (tc-ensure-region-value-can-flow-into
                env
                array-ty
                value-ty
                "array")
                [(ResultTcUnit.Ok)
                  (match (tc-ensure-reference-value-can-store-in-place
                    ctx
                    env
                    array
                    value-ty
                    "array")
                    [(ResultTcUnit.Ok) (ResultTcType.Ok (AstType.Unit))]
                    [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
        [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
    [(ResultTcType.Err message) (ResultTcType.Err message)]))

(define (tc-struct-set-field-type
  [ctx : TcContext]
  [receiver-ty : AstType]
  [field : String]) : ResultTcType
  (match (tc-type-strip-region (tc-resolve-type ctx receiver-ty))
    [(AstType.Struct _) (tc-struct-get-result-type ctx receiver-ty field)]
    [(AstType.StructArgs _ _) (tc-struct-get-result-type ctx receiver-ty field)]
    [(AstType.MutRef _ _) (tc-struct-get-result-type ctx receiver-ty field)]
    [(AstType.Ref _ _)
      (ResultTcType.Err
        "typecheck: set! struct field requires mutable struct access")]
    [_ (ResultTcType.Err "typecheck: set! struct field requires struct")]))

(define (tc-struct-field-mutation-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [receiver : AstExpr]
  [field : String]
  [value : AstExpr]) : ResultTcType
  (match (tc-store-place-lifetime ctx env receiver)
    [(ResultTcString.Ok _)
      (match (tc-expr ctx env receiver)
        [(ResultTcType.Ok receiver-ty)
          (match (tc-struct-set-field-type ctx receiver-ty field)
            [(ResultTcType.Ok field-ty)
              (match (tc-expr-with-expected-or-actual ctx env value field-ty)
                [(ResultTcType.Ok value-ty)
                  (match (tc-expect
                    value-ty
                    field-ty
                    "typecheck: struct field assignment type mismatch")
                    [(ResultTcUnit.Ok)
                      (match (tc-ensure-cleanup-resource-not-stored-expr
                        env
                        value)
                        [(ResultTcUnit.Ok)
                          (match (tc-ensure-region-value-can-flow-into
                            env
                            field-ty
                            value-ty
                            "struct field")
                            [(ResultTcUnit.Ok)
                              (match (tc-ensure-reference-value-can-store-in-place
                                ctx
                                env
                                receiver
                                value-ty
                                "struct field")
                                [(ResultTcUnit.Ok)
                                  (ResultTcType.Ok (AstType.Unit))]
                                [(ResultTcUnit.Err message)
                                  (ResultTcType.Err message)])]
                            [(ResultTcUnit.Err message)
                              (ResultTcType.Err message)])]
                        [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                    [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                [(ResultTcType.Err message) (ResultTcType.Err message)])]
            [(ResultTcType.Err message) (ResultTcType.Err message)])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(ResultTcString.Err message) (ResultTcType.Err message)]))

(define (tc-expr [ctx : TcContext] [env : TcTypeEnv] [expr : AstExpr]) : ResultTcType
  (match expr
    [(AstExpr.Spanned inner-box span)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [result : ResultTcType
          (match inner
            [(AstExpr.Unsafe exprs)
              (tc-unsafe-begin-list
                ctx
                env
                exprs
                (TcMaybeAstSourceSpan.Some span))]
            [_ (tc-expr-id ctx env inner-box)])]
        (match result
          [(ResultTcType.Ok ty) (ResultTcType.Ok ty)]
          [(ResultTcType.Err message)
            (tc-locate-spanned-error inner span message)]))]
    [(AstExpr.Literal lit) (tc-literal-type-checked lit)]
    [(AstExpr.BinaryData _) (ResultTcType.Ok (ast-ty-dyn-array (AstType.U8)))]
    [(AstExpr.Var name)
      (let
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-expr-id env name-text)
            [(ResultTcExprId.Ok virtual-id) (tc-expr-id ctx env virtual-id)]
            [(ResultTcExprId.Err message) (ResultTcType.Err message)])
          (if (tc-hygiene-global-name? name-text)
            (match (tc-hygiene-global-decode name-text)
              [(TcHygieneGlobalName.Legacy global-name)
                (let
                  [global-id : i64 (tc-name-id global-name)]
                  (if (tc-hygiene-global-binding-unsafe? env global-name)
                    (match (tc-require-unsafe env global-name)
                      [(ResultTcUnit.Ok)
                        (tc-lookup-hygiene-global-visible-id ctx env global-id)]
                      [(ResultTcUnit.Err message) (ResultTcType.Err message)])
                    (tc-lookup-hygiene-global-visible-id ctx env global-id)))]
              [(TcHygieneGlobalName.Context module global-name)
                (tc-lookup-hygiene-context-global-visible-id
                  ctx
                  env
                  module
                  (tc-name-id global-name))])
            (match (tc-source-name-lookup-key-after-local-field-check
              ctx
              env
              name-text)
              [(ResultTcString.Ok lookup-name)
                (let
                  [lookup-id : i64 (tc-name-id lookup-name)]
                  (match (tc-lookup-unsafe-id env lookup-id)
                    [(ResultTcTypeUnsafe.Ok ty unsafe)
                      (if unsafe
                        (match (tc-require-unsafe
                          env
                          (tc-source-lookup-display-name
                            ctx
                            name-text
                            lookup-name))
                          [(ResultTcUnit.Ok)
                            (match (tc-unqualified-import-ambiguity-message
                              ctx
                              env
                              name)
                              [(TcMaybeString.No) (ResultTcType.Ok ty)]
                              [(TcMaybeString.Some message)
                                (ResultTcType.Err message)])]
                          [(ResultTcUnit.Err message)
                            (ResultTcType.Err message)])
                        (match (tc-unqualified-import-ambiguity-message
                          ctx
                          env
                          name)
                          [(TcMaybeString.No) (ResultTcType.Ok ty)]
                          [(TcMaybeString.Some message)
                            (ResultTcType.Err message)]))]
                    [(ResultTcTypeUnsafe.Err message)
                      (tc-variant-constructor-type-for-lookup-or
                        ctx
                        lookup-name
                        (tc-source-lookup-display-name
                          ctx
                          name-text
                          lookup-name)
                        (tc-source-unbound-display-message
                          ctx
                          name-text
                          lookup-name
                          message))]))]
              [(ResultTcString.Err message) (ResultTcType.Err message)]))))]
    [(AstExpr.TypeLiteral ty)
      (ResultTcType.Err
        (string.append
          "type value "
          (string.append
            (tc-type-render (tc-resolve-type ctx ty))
            " is compile-time only")))]
    [(AstExpr.Init maybe-ty)
      (match maybe-ty
        [(AstMaybeType.Some ty) (tc-init-expr ctx env ty)]
        [(AstMaybeType.No)
          (ResultTcType.Err
            "typecheck: contextual init requires an expected type; use (init : T) or add an annotation")])]
    [(AstExpr.Ann inner-box ty)
      (let
        [want-ty : AstType (tc-resolve-type ctx ty)]
        (match (tc-expr-with-expected-or-actual-id ctx env inner-box want-ty)
          [(ResultTcType.Ok got)
            (match (tc-expect got want-ty "typecheck: annotation type mismatch")
              [(ResultTcUnit.Ok)
                (ResultTcType.Ok
                  (if (tc-type-contains-any-region got)
                    got
                    want-ty))]
              [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
          [(ResultTcType.Err message) (ResultTcType.Err message)]))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-let-bindings-for-body ctx env bindings body)
              [(ResultTcEnv.Ok next-env)
                (match (tc-expr-id ctx next-env body-box)
                  [(ResultTcType.Ok body-ty)
                    (match (tc-ensure-reference-type-does-not-escape-names
                      body-ty
                      (tc-let-binding-list-add-bound-names
                        bindings
                        TcStringList.Nil))
                      [(ResultTcUnit.Ok) (ResultTcType.Ok body-ty)]
                      [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                  [(ResultTcType.Err message) (ResultTcType.Err message)])]
              [(ResultTcEnv.Err message) (ResultTcType.Err message)]))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params maybe-ret body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (tc-lambda-expr ctx env params maybe-ret body))])]
    [(AstExpr.Tuple exprs)
      (match (tc-ensure-cleanup-resource-not-stored-list env exprs)
        [(ResultTcUnit.Ok)
          (match (tc-expr-list-types ctx env exprs)
            [(ResultTcTypeList.Ok tys)
              (ResultTcType.Ok (tc-tag-active-region env (ast-ty-tuple tys)))]
            [(ResultTcTypeList.Err message) (ResultTcType.Err message)])]
        [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
    [(AstExpr.TupleRef tuple-box index)
      (match (tc-expr-id ctx env tuple-box)
        [(ResultTcType.Ok tuple-ty)
          (match (tc-type-strip-region tuple-ty)
            [(AstType.Tuple tys)
              (match (tc-type-list-ref (box-get tys) index)
                [(ResultTcType.Ok elem-ty)
                  (ResultTcType.Ok
                    (tc-project-from-region-container tuple-ty elem-ty))]
                [(ResultTcType.Err message) (ResultTcType.Err message)])]
            [_ (ResultTcType.Err "typecheck: tuple-ref requires tuple type")])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(AstExpr.Array exprs)
      (match (tc-ensure-cleanup-resource-not-stored-list env exprs)
        [(ResultTcUnit.Ok)
          (if (ast-expr-list-empty? (& exprs))
            (ResultTcType.Err "typecheck: cannot infer type of empty array")
            (let
              [first : i64 (ast-expr-list-get (& exprs) 0 0)]
              [rest : AstExprList (ast-expr-list-tail-from-ref (& exprs) 1)]
              (match (tc-expr-id ctx env first)
                [(ResultTcType.Ok first-ty)
                  (match (tc-check-array-rest ctx env rest first-ty)
                    [(ResultTcUnit.Ok)
                      (ResultTcType.Ok
                        (ast-ty-array first-ty (tc-expr-list-len exprs)))]
                    [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                [(ResultTcType.Err message) (ResultTcType.Err message)])))]
        [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
    [(AstExpr.MakeArray elem-ty len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        [elem : AstType (tc-resolve-type ctx elem-ty)]
        (match (tc-expr-with-expected-or-actual-id
          ctx
          env
          len-box
          (AstType.I64))
          [(ResultTcType.Ok len-ty)
            (cond
              [(not (tc-integer-type? len-ty))
                (ResultTcType.Err
                  "typecheck: make-array length must be integer")]
              [(not (tc-dyn-array-elem-supported? env elem))
                (ResultTcType.Err
                  "typecheck: make-array element type is not supported")]
              [(not (tc-make-array-requires-element-init? elem len))
                (ResultTcType.Ok
                  (tc-tag-active-region env (ast-ty-dyn-array elem)))]
              [else
                (match (tc-init-type-supported ctx env elem)
                  [(ResultTcUnit.Ok)
                    (ResultTcType.Ok
                      (tc-tag-active-region env (ast-ty-dyn-array elem)))]
                  [(ResultTcUnit.Err message) (ResultTcType.Err message)])])]
          [(ResultTcType.Err message) (ResultTcType.Err message)]))]
    [(AstExpr.ArrayRef array-box index-box)
      (match (tc-expr-id ctx env array-box)
        [(ResultTcType.Ok array-ty)
          (match (tc-expr-with-expected-or-actual-id
            ctx
            env
            index-box
            (AstType.I64))
            [(ResultTcType.Ok index-ty)
              (if (tc-integer-type? index-ty)
                (match (tc-array-readable-receiver ctx array-ty)
                  [(ResultTcArrayReceiver.Ok receiver)
                    (match receiver
                      [(TcArrayReceiver container-ty elem-ty)
                        (ResultTcType.Ok
                          (tc-project-from-region-container
                            container-ty
                            elem-ty))])]
                  [(ResultTcArrayReceiver.Err message)
                    (ResultTcType.Err message)])
                (ResultTcType.Err "typecheck: array index must be integer"))]
            [(ResultTcType.Err message) (ResultTcType.Err message)])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-expr-id ctx env array-box)
          [(ResultTcType.Ok array-ty)
            (match (tc-expr-with-expected-or-actual-id
              ctx
              env
              index-box
              (AstType.I64))
              [(ResultTcType.Ok index-ty)
                (if (tc-integer-type? index-ty)
                  (match (tc-array-set-receiver ctx array-ty)
                    [(ResultTcArrayReceiver.Ok receiver)
                      (match receiver
                        [(TcArrayReceiver container-ty elem-ty)
                          (tc-array-mutation-value
                            ctx
                            env
                            array
                            container-ty
                            elem-ty
                            value
                            "typecheck: array-set! value type mismatch")])]
                    [(ResultTcArrayReceiver.Err message)
                      (ResultTcType.Err message)])
                  (ResultTcType.Err "typecheck: array index must be integer"))]
              [(ResultTcType.Err message) (ResultTcType.Err message)])]
          [(ResultTcType.Err message) (ResultTcType.Err message)]))]
    [(AstExpr.ArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-expr-id ctx env array-box)
          [(ResultTcType.Ok array-ty)
            (match (tc-array-push-receiver ctx array-ty)
              [(ResultTcArrayReceiver.Ok receiver)
                (match receiver
                  [(TcArrayReceiver container-ty elem-ty)
                    (tc-array-mutation-value
                      ctx
                      env
                      array
                      container-ty
                      elem-ty
                      value
                      "typecheck: array-push! value type mismatch")])]
              [(ResultTcArrayReceiver.Err message) (ResultTcType.Err message)])]
          [(ResultTcType.Err message) (ResultTcType.Err message)]))]
    [(AstExpr.StringRef str-box index-box)
      (match (tc-expr-id ctx env str-box)
        [(ResultTcType.Ok str-ty)
          (match (tc-expect
            str-ty
            (AstType.String)
            "typecheck: string-ref requires String")
            [(ResultTcUnit.Ok)
              (match (tc-expr-with-expected-or-actual-id
                ctx
                env
                index-box
                (AstType.I64))
                [(ResultTcType.Ok index-ty)
                  (if (tc-integer-type? index-ty)
                    (ResultTcType.Ok (AstType.Char))
                    (ResultTcType.Err "typecheck: string index must be integer"))]
                [(ResultTcType.Err message) (ResultTcType.Err message)])]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(AstExpr.Begin exprs) (tc-begin-list ctx env exprs)]
    ;; `(unsafe ...)` types like `begin` in v1; the unsafe-context flag for
    ;; raw-pointer ops is added with their checks (#955).
    [(AstExpr.Unsafe exprs)
      (tc-unsafe-begin-list ctx env exprs TcMaybeAstSourceSpan.No)]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (match (tc-expr-id ctx env cond-box)
        [(ResultTcType.Ok cond-ty)
          (match (tc-expect
            cond-ty
            (AstType.Bool)
            "typecheck: if condition must be bool")
            [(ResultTcUnit.Ok)
              (match (tc-expr-id ctx env then-branch-box)
                [(ResultTcType.Ok then-ty)
                  (match (tc-expr-id ctx env else-branch-box)
                    [(ResultTcType.Ok else-ty)
                      (tc-merge-branch-type then-ty else-ty)]
                    [(ResultTcType.Err message) (ResultTcType.Err message)])]
                [(ResultTcType.Err message) (ResultTcType.Err message)])]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(AstExpr.Set name value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-set-expr-id env name-text value-box)
            [(ResultTcExprId.Ok virtual-id) (tc-expr-id ctx env virtual-id)]
            [(ResultTcExprId.Err message) (ResultTcType.Err message)])
          (match (tc-lookup-visible-id ctx env name)
            [(ResultTcType.Ok var-ty)
              (match (tc-expr-with-expected-or-actual-id
                ctx
                env
                value-box
                var-ty)
                [(ResultTcType.Ok value-ty)
                  (match (tc-expect
                    value-ty
                    var-ty
                    "typecheck: assignment type mismatch")
                    [(ResultTcUnit.Ok)
                      (match (tc-ensure-cleanup-resource-not-assigned env value)
                        [(ResultTcUnit.Ok)
                          (match (tc-ensure-region-value-can-flow-into
                            env
                            var-ty
                            value-ty
                            "assignment")
                            [(ResultTcUnit.Ok)
                              (match (tc-ensure-reference-value-can-assign
                                env
                                name-text
                                value-ty)
                                [(ResultTcUnit.Ok)
                                  (ResultTcType.Ok (AstType.Unit))]
                                [(ResultTcUnit.Err message)
                                  (ResultTcType.Err message)])]
                            [(ResultTcUnit.Err message)
                              (ResultTcType.Err message)])]
                        [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                    [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                [(ResultTcType.Err message) (ResultTcType.Err message)])]
            [(ResultTcType.Err message) (ResultTcType.Err message)])))]
    [(AstExpr.Cast inner-box ty)
      (match (tc-expr-id ctx env inner-box)
        [(ResultTcType.Ok inner-ty)
          (let
            [target-ty : AstType (tc-resolve-type ctx ty)]
            (if (and (tc-castable-type? inner-ty) (tc-castable-type? target-ty))
              (ResultTcType.Ok target-ty)
              (if (tc-function-to-integer-cast? inner-ty target-ty)
                (match (tc-require-unsafe env "function-to-integer cast")
                  [(ResultTcUnit.Ok) (ResultTcType.Ok target-ty)]
                  [(ResultTcUnit.Err message) (ResultTcType.Err message)])
                (ResultTcType.Err
                  "typecheck: cast requires scalar numeric (integer/char/float) source and target"))))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(AstExpr.Borrow mutable lifetime place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (tc-borrow-expr ctx env mutable lifetime place))]
    [(AstExpr.Unary op inner-box)
      (match (tc-expr-id ctx env inner-box)
        [(ResultTcType.Ok ty) (tc-unop-type op ty)]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(AstExpr.Binary op left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (match (tc-binop-expr-types ctx env op left right)
          [(ResultTcBinOpTypes.Ok binop-types)
            (match binop-types
              [(TcBinOpTypes _ _ result-ty) (ResultTcType.Ok result-ty)])]
          [(ResultTcBinOpTypes.Err message) (ResultTcType.Err message)]))]
    [(AstExpr.Call func-box args)
      (tc-call-or-array-length-id ctx env func-box args)]
    [(AstExpr.BracketClause _)
      (ResultTcType.Err
        "typecheck: bracket clause is only valid as an ExprClause or ExprBindingClause macro operand")]
    [(AstExpr.While cond-box body-box)
      (match (tc-expr-id ctx env cond-box)
        [(ResultTcType.Ok cond-ty)
          (match (tc-expect
            cond-ty
            (AstType.Bool)
            "typecheck: while condition must be bool")
            [(ResultTcUnit.Ok)
              (match (tc-expr-id ctx (tc-enter-loop-target env) body-box)
                [(ResultTcType.Ok body-ty)
                  (match (tc-expect
                    body-ty
                    (AstType.Unit)
                    "typecheck: while body must be unit")
                    [(ResultTcUnit.Ok) (ResultTcType.Ok (AstType.Unit))]
                    [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
                [(ResultTcType.Err message) (ResultTcType.Err message)])]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach index index-ty start-box end-box body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            [resolved-index-ty : AstType (tc-resolve-type ctx index-ty)]
            (if (tc-integer-type? resolved-index-ty)
              (match (tc-expr-with-expected-or-actual-id
                ctx
                env
                start-box
                resolved-index-ty)
                [(ResultTcType.Ok start-ty)
                  (if (tc-integer-type? start-ty)
                    (match (tc-expr-with-expected-or-actual-id
                      ctx
                      env
                      end-box
                      resolved-index-ty)
                      [(ResultTcType.Ok end-ty)
                        (if (tc-integer-type? end-ty)
                          (let
                            [body-env : TcTypeEnv
                              (tc-bind-id env index resolved-index-ty)]
                            (match (tc-expr-id ctx body-env body-box)
                              [(ResultTcType.Ok body-ty)
                                (match (tc-expect
                                  body-ty
                                  (AstType.Unit)
                                  "typecheck: foreach body must be unit")
                                  [(ResultTcUnit.Ok)
                                    (match (tc-spmd-check-foreach-body
                                      ctx
                                      env
                                      (intern-str index)
                                      resolved-index-ty
                                      body)
                                      [(ResultTcUnit.Ok)
                                        (ResultTcType.Ok (AstType.Unit))]
                                      [(ResultTcUnit.Err message)
                                        (ResultTcType.Err message)])]
                                  [(ResultTcUnit.Err message)
                                    (ResultTcType.Err message)])]
                              [(ResultTcType.Err message)
                                (ResultTcType.Err message)]))
                          (ResultTcType.Err
                            "typecheck: foreach end expression must be integer"))]
                      [(ResultTcType.Err message) (ResultTcType.Err message)])
                    (ResultTcType.Err
                      "typecheck: foreach start expression must be integer"))]
                [(ResultTcType.Err message) (ResultTcType.Err message)])
              (ResultTcType.Err "typecheck: foreach index type must be integer")))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce
            op
            index
            index-ty
            start-box
            end-box
            init-box
            value-box)
          (let
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [resolved-index-ty : AstType (tc-resolve-type ctx index-ty)]
            (if (tc-integer-type? resolved-index-ty)
              (match (tc-expr-id ctx env start-box)
                [(ResultTcType.Ok start-ty)
                  (if (tc-integer-type? start-ty)
                    (match (tc-expr-id ctx env end-box)
                      [(ResultTcType.Ok end-ty)
                        (if (tc-integer-type? end-ty)
                          (let
                            [value-env : TcTypeEnv
                              (tc-bind-id env index resolved-index-ty)]
                            (match (tc-spmd-reduce-init-value-type
                              ctx
                              env
                              value-env
                              op
                              init
                              value)
                              [(ResultTcType.Ok result-ty)
                                (match (tc-spmd-check-reduce-value-broadcasts
                                  ctx
                                  env
                                  (intern-str index)
                                  resolved-index-ty
                                  value)
                                  [(ResultTcUnit.Ok)
                                    (ResultTcType.Ok result-ty)]
                                  [(ResultTcUnit.Err message)
                                    (ResultTcType.Err message)])]
                              [(ResultTcType.Err message)
                                (ResultTcType.Err message)]))
                          (ResultTcType.Err
                            "typecheck: spmd-reduce end expression must be integer"))]
                      [(ResultTcType.Err message) (ResultTcType.Err message)])
                    (ResultTcType.Err
                      "typecheck: spmd-reduce start expression must be integer"))]
                [(ResultTcType.Err message) (ResultTcType.Err message)])
              (ResultTcType.Err
                "typecheck: spmd-reduce index type must be integer")))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            op
            index
            index-ty
            start-box
            end-box
            prefix
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            [resolved-index-ty : AstType (tc-resolve-type ctx index-ty)]
            [resolved-prefix-ty : AstType (tc-resolve-type ctx prefix-ty)]
            (if (tc-integer-type? resolved-index-ty)
              (match (tc-expr-with-expected-or-actual-id
                ctx
                env
                start-box
                resolved-index-ty)
                [(ResultTcType.Ok start-ty)
                  (if (tc-integer-type? start-ty)
                    (match (tc-expr-with-expected-or-actual-id
                      ctx
                      env
                      end-box
                      resolved-index-ty)
                      [(ResultTcType.Ok end-ty)
                        (if (tc-integer-type? end-ty)
                          (let
                            [value-env : TcTypeEnv
                              (tc-bind-id env index resolved-index-ty)]
                            [body-env : TcTypeEnv
                              (tc-bind-id value-env prefix resolved-prefix-ty)]
                            (match (tc-spmd-scan-init-value-type
                              ctx
                              env
                              value-env
                              op
                              resolved-prefix-ty
                              init
                              value)
                              [(ResultTcType.Ok _)
                                (match (tc-expr-id ctx body-env body-box)
                                  [(ResultTcType.Ok body-ty)
                                    (match (tc-expect
                                      body-ty
                                      (AstType.Unit)
                                      "typecheck: spmd-scan body must be unit")
                                      [(ResultTcUnit.Ok)
                                        (match (tc-spmd-check-scan-body
                                          ctx
                                          env
                                          (intern-str index)
                                          resolved-index-ty
                                          (intern-str prefix)
                                          resolved-prefix-ty
                                          body)
                                          [(ResultTcUnit.Ok)
                                            (ResultTcType.Ok (AstType.Unit))]
                                          [(ResultTcUnit.Err message)
                                            (ResultTcType.Err message)])]
                                      [(ResultTcUnit.Err message)
                                        (ResultTcType.Err message)])]
                                  [(ResultTcType.Err message)
                                    (ResultTcType.Err message)])]
                              [(ResultTcType.Err message)
                                (ResultTcType.Err message)]))
                          (ResultTcType.Err
                            "typecheck: spmd-scan end expression must be integer"))]
                      [(ResultTcType.Err message) (ResultTcType.Err message)])
                    (ResultTcType.Err
                      "typecheck: spmd-scan start expression must be integer"))]
                [(ResultTcType.Err message) (ResultTcType.Err message)])
              (ResultTcType.Err
                "typecheck: spmd-scan index type must be integer")))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (match (tc-expr-with-expected-or-actual-id ctx env lane-box (AstType.I64))
        [(ResultTcType.Ok lane-ty)
          (match (tc-expect
            (tc-resolve-type ctx lane-ty)
            (AstType.I64)
            "typecheck: spmd-broadcast lane must have type i64")
            [(ResultTcUnit.Ok)
              (match (tc-expr-id ctx env value-box)
                [(ResultTcType.Ok value-ty)
                  (if (tc-spmd-broadcast-type-supported?
                    (tc-resolve-type ctx value-ty))
                    (ResultTcType.Ok value-ty)
                    (ResultTcType.Err (tc-spmd-broadcast-type-message)))]
                [(ResultTcType.Err message) (ResultTcType.Err message)])]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (match (tc-expr-with-expected-or-actual-id ctx env lane-box (AstType.I64))
        [(ResultTcType.Ok lane-ty)
          (match (tc-expect
            (tc-resolve-type ctx lane-ty)
            (AstType.I64)
            "typecheck: spmd-shuffle lane must have type i64")
            [(ResultTcUnit.Ok)
              (match (tc-expr-id ctx env value-box)
                [(ResultTcType.Ok value-ty)
                  (if (tc-spmd-broadcast-type-supported?
                    (tc-resolve-type ctx value-ty))
                    (ResultTcType.Ok value-ty)
                    (ResultTcType.Err (tc-spmd-shuffle-type-message)))]
                [(ResultTcType.Err message) (ResultTcType.Err message)])]
            [(ResultTcUnit.Err message) (ResultTcType.Err message)])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(AstExpr.SpmdProgramIndex) (ResultTcType.Ok (AstType.I64))]
    [(AstExpr.SpmdProgramCount) (ResultTcType.Ok (AstType.I64))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (match (tc-expr-id ctx env scrutinee-box)
            [(ResultTcType.Ok scrut-ty) (tc-match-expr ctx env scrut-ty arms)]
            [(ResultTcType.Err message) (ResultTcType.Err message)])])]
    [(AstExpr.StructGet receiver-box field)
      (match (tc-expr-id ctx env receiver-box)
        [(ResultTcType.Ok receiver-ty)
          (tc-struct-get-result-type ctx receiver-ty (intern-str field))]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(AstExpr.StructSet receiver-box field value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-struct-field-mutation-value
          ctx
          env
          receiver
          (intern-str field)
          value))]
    [(AstExpr.WithRegion region body) (tc-with-region-expr ctx env region body)]
    [(AstExpr.WithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (tc-with-escape-expr ctx env scratch body))]
    [(AstExpr.WithScratch body) (tc-with-scratch-expr ctx env body)]
    [(AstExpr.InArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (tc-in-arena-expr ctx env arena body))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (tc-with-resource-expr ctx env bindings body)])]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-box-expr ctx env inner))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-box-get-expr ctx env inner))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-box-take-expr ctx env inner))]
    [(AstExpr.BoxSet box-box value-box)
      (let
        [box-expr : AstExpr (ast-node-get box-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-box-mutation-value ctx env box-expr value))]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (compiler-ctfe-eval inner (tc-ctfe-env ctx) (ctfe-fuel-limit))
          [(ResultCtfe.Ok value _) (tc-ctfe-value-type ctx value)]
          [(ResultCtfe.Err diag)
            (ResultTcType.Err (compiler-diagnostic-message (box-get diag)))]))]
    [(AstExpr.Quote _) (ResultTcType.Ok (AstType.Expr))]
    [(AstExpr.Quasiquote template-box)
      (let
        [template : AstExpr (ast-node-get template-box)]
        (match (tc-quasiquote-template-ok ctx env template)
          [(ResultTcUnit.Ok) (ResultTcType.Ok (AstType.Expr))]
          [(ResultTcUnit.Err message) (ResultTcType.Err message)]))]
    [(AstExpr.Unquote _)
      (ResultTcType.Err "typecheck: unquote is only valid inside quasiquote")]
    [(AstExpr.UnquoteSplicing _)
      (ResultTcType.Err
        "typecheck: unquote-splicing is only valid inside quasiquote")]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-try-expr ctx env inner))]
    [(AstExpr.Return value-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-return-expr ctx env value))]
    [(AstExpr.Break) (tc-loop-control-expr env "break")]
    [(AstExpr.Continue) (tc-loop-control-expr env "continue")]
    [(AstExpr.PtrNull ty)
      (let
        [resolved : AstType (tc-resolve-type ctx ty)]
        (match resolved
          [(AstType.Ptr _) (ResultTcType.Ok resolved)]
          [(AstType.MutPtr _) (ResultTcType.Ok resolved)]
          [_
            (ResultTcType.Err
              "typecheck: ptr-null requires a pointer type, e.g. (ptr-null : (Ptr i64))")]))]
    [(AstExpr.PtrNullCheck inner-box)
      (match (tc-expr-id ctx env inner-box)
        [(ResultTcType.Ok inner-ty)
          (match (tc-type-strip-region inner-ty)
            [(AstType.Ptr _) (ResultTcType.Ok (AstType.Bool))]
            [(AstType.MutPtr _) (ResultTcType.Ok (AstType.Bool))]
            [_
              (ResultTcType.Err
                "typecheck: ptr-null? requires a raw pointer operand")])]
        [(ResultTcType.Err message) (ResultTcType.Err message)])]
    [(AstExpr.PtrAddrOf name) (tc-ptr-addr-of-expr ctx env (intern-str name))]
    [(AstExpr.PtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-ptr-read-expr ctx env ptr))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (tc-ptr-write-expr ctx env ptr value))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (tc-ptr-offset-expr ctx env ptr offset))]
    [(AstExpr.PtrCast ptr-box target)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-ptr-cast-expr ctx env ptr target))]
    [(AstExpr.PtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (tc-ptr-to-int-expr ctx env ptr))]
    [(AstExpr.IntToPtr value-box target)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (tc-int-to-ptr-expr ctx env value target))]
    [(AstExpr.StringData str-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        (tc-string-data-expr ctx env str))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (tc-string-from-bytes-expr ctx env ptr len))]
    [(AstExpr.ArrayData array-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-array-data-expr ctx env array))]
    [(AstExpr.ProgramArgc) (ResultTcType.Ok (AstType.I64))]
    [(AstExpr.ProgramArgv) (tc-program-entry-ptr-expr env "program-argv")]
    [(AstExpr.ProgramEnvp) (tc-program-entry-ptr-expr env "program-envp")]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-cpuid-expr ctx env leaf subleaf))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-cpuid-expr ctx env leaf subleaf))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-cpuid-expr ctx env leaf subleaf))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (tc-cpuid-expr ctx env leaf subleaf))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (tc-xgetbv-expr ctx env index))]
    [(AstExpr.Syscall args) (tc-syscall-expr ctx env args)]
    [_ (ResultTcType.Err "typecheck: unsupported expression")]))

(define (tc-extern-abi-enum-aggregate-type? [ty : AstType]) : bool
  (match (tc-type-without-regions ty)
    [(AstType.Enum _) true]
    [(AstType.EnumArgs _ _) true]
    [_ false]))

(define (tc-extern-abi-inline-enum-type-ok? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-without-regions ty)
    [(AstType.Enum name)
      (match (tc-inline-aggregate-layout-for ctx (intern-str name))
        [(ResultTcInlineAggregateLayout.Ok layout)
          (match layout
            [(TcInlineAggregateLayout.Enum _ _ _) true]
            [_ false])]
        [(ResultTcInlineAggregateLayout.Err _) false])]
    [(AstType.EnumArgs name _)
      (match (tc-inline-aggregate-layout-for ctx (intern-str name))
        [(ResultTcInlineAggregateLayout.Ok layout)
          (match layout
            [(TcInlineAggregateLayout.Enum _ _ _) true]
            [_ false])]
        [(ResultTcInlineAggregateLayout.Err _) false])]
    [_ false]))

(define (tc-extern-abi-value-type-ok? [ctx : TcContext] [ty : AstType]) : bool
  (match (tc-type-without-regions ty)
    [(AstType.I64) true]
    [(AstType.I32) true]
    [(AstType.I16) true]
    [(AstType.I8) true]
    [(AstType.U64) true]
    [(AstType.U32) true]
    [(AstType.U16) true]
    [(AstType.U8) true]
    [(AstType.F64) true]
    [(AstType.F32) true]
    [(AstType.Bool) true]
    [(AstType.Char) true]
    [(AstType.Unit) true]
    [(AstType.Never) true]
    [(AstType.Func _ _) true]
    [(AstType.Ptr _) true]
    [(AstType.MutPtr _) true]
    [(AstType.String) true]
    [(AstType.DynArray _) true]
    [(AstType.Enum _) (tc-extern-abi-inline-enum-type-ok? ctx ty)]
    [(AstType.EnumArgs _ _) (tc-extern-abi-inline-enum-type-ok? ctx ty)]
    [(AstType.Struct _) true]
    [(AstType.StructArgs _ _) true]
    [_ false]))

(define (tc-extern-abi-unsupported-message [position : String] [ty : AstType]) : String
  (if (tc-extern-abi-enum-aggregate-type? ty)
    (string.append
      "typecheck: extern ABI c does not support enum aggregate "
      (string.append position (string.append " type " (tc-type-render ty))))
    (string.append
      "typecheck: extern ABI c does not support "
      (string.append position (string.append " type " (tc-type-render ty))))))

(define (tc-check-extern-arg-abi [ctx : TcContext] [args : AstTypeList]) : ResultTcUnit
  (tc-check-extern-arg-abi-at ctx (& args) 0))

(define (tc-check-extern-arg-abi-at
  [ctx : TcContext]
  [args : (& args AstTypeList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (ast-type-list-len args))
    ResultTcUnit.Ok
    (let
      [head : AstType
        (ty-node-get (ast-type-list-get args index (ast-type-id-fallback)))]
      (if (tc-extern-abi-value-type-ok? ctx head)
        (tc-check-extern-arg-abi-at ctx args (+ index 1))
        (ResultTcUnit.Err (tc-extern-abi-unsupported-message "parameter" head))))))

(define (tc-check-extern-c-abi [ctx : TcContext] [ty : AstType]) : ResultTcUnit
  (match ty
    [(AstType.Func args ret)
      (match (tc-check-extern-arg-abi ctx (box-get args))
        [(ResultTcUnit.Ok)
          (if (tc-extern-abi-value-type-ok? ctx (ty-node-get ret))
            ResultTcUnit.Ok
            (ResultTcUnit.Err
              (tc-extern-abi-unsupported-message "return" (ty-node-get ret))))]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [_ (ResultTcUnit.Err "typecheck: extern must have function type")]))

(define (tc-check-extern-value-c-abi [ctx : TcContext] [ty : AstType]) : ResultTcUnit
  (match ty
    [(AstType.Func _ _) (tc-check-extern-c-abi ctx ty)]
    [_
      (if (tc-extern-abi-value-type-ok? ctx ty)
        ResultTcUnit.Ok
        (ResultTcUnit.Err (tc-extern-abi-unsupported-message "value" ty)))]))

(define (tc-check-extern-varargs-tail-type
  [ctx : TcContext]
  [abi : AstExternAbi]) : ResultTcUnit
  (if (ast-extern-abi-c-varargs-typed? abi)
    (let
      [tail-ty : AstType
        (tc-resolve-type ctx (ast-extern-abi-varargs-tail-type abi))]
      (if (tc-extern-abi-value-type-ok? ctx tail-ty)
        ResultTcUnit.Ok
        (ResultTcUnit.Err
          (tc-extern-abi-unsupported-message "variadic argument" tail-ty))))
    ResultTcUnit.Ok))

(define (tc-check-extern-decl
  [ctx : TcContext]
  [kind : AstExternKind]
  [metadata : AstExternMetadata]
  [ty : AstType]) : ResultTcUnit
  (match metadata
    [(AstExternMetadata.Metadata abi _ _ explicit-abi)
      (let
        [resolved : AstType (tc-resolve-type ctx ty)]
        (match kind
          [(AstExternKind.Function)
            (if (and
              (ast-extern-abi-c? abi)
              (or explicit-abi (ast-extern-abi-c-varargs? abi)))
              (match (tc-check-extern-c-abi ctx resolved)
                [(ResultTcUnit.Ok)
                  (if (ast-extern-abi-c-varargs? abi)
                    (tc-check-extern-varargs-tail-type ctx abi)
                    ResultTcUnit.Ok)]
                [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])
              ResultTcUnit.Ok)]
          [(AstExternKind.Value)
            (if (ast-extern-abi-c-varargs? abi)
              (ResultTcUnit.Err
                "typecheck: extern value cannot use c-varargs ABI")
              (tc-check-extern-value-c-abi ctx resolved))]))]))

(define (tc-summary-add-decl
  [summary : CompilerTypecheckSummary]
  [decl : AstDecl]) : CompilerTypecheckSummary
  (match summary
    [(CompilerTypecheckSummary values functions externs)
      (match decl
        [(AstDecl.Def _ _ _)
          (CompilerTypecheckSummary (+ values 1) functions externs)]
        [(AstDecl.DefFn _ _ _ _ _)
          (CompilerTypecheckSummary values (+ functions 1) externs)]
        [(AstDecl.Extern _ _ _ _)
          (CompilerTypecheckSummary values functions (+ externs 1))]
        [(AstDecl.ComptimeDecl _ template-box)
          (let
            [template : AstDecl (box-get template-box)]
            (tc-summary-add-decl summary template))]
        [(AstDecl.Unsafe inner-box)
          (let
            [inner : AstDecl (box-get inner-box)]
            (tc-summary-add-decl summary inner))]
        [_ summary])]))

(define (tc-macro-signature-type [ty : AstType]) : AstType
  (match ty
    [(AstType.Var name)
      (match (tc-macro-signature-stdlib-comptime-type-id name)
        [(AstMaybeType.Some syntax-ty) syntax-ty]
        [(AstMaybeType.No)
          (cond
            [(= name (intern "Expr")) (AstType.Expr)]
            [(= name (intern "ExprList")) (AstType.ExprList)]
            [(= name (intern "ExprClause")) (tc-macro-expr-clause-type)]
            [(= name (intern "ExprClauseList"))
              (tc-macro-expr-clause-list-type)]
            [(= name (intern "ExprBindingClause"))
              (tc-macro-expr-binding-clause-type)]
            [(= name (intern "ExprBindingClauseList"))
              (tc-macro-expr-binding-clause-list-type)]
            [(= name (intern "Pattern")) (tc-macro-pattern-type)]
            [(= name (intern "PatternList")) (tc-macro-pattern-list-type)]
            [(= name (intern "MatchArm")) (tc-macro-match-arm-type)]
            [(= name (intern "MatchArmList")) (tc-macro-match-arm-list-type)]
            [else ty])])]
    [(AstType.VarArgs name _)
      (match (tc-macro-signature-stdlib-comptime-type-id name)
        [(AstMaybeType.Some syntax-ty) syntax-ty]
        [(AstMaybeType.No) ty])]
    [(AstType.Enum name)
      (match (tc-macro-signature-stdlib-comptime-type-id name)
        [(AstMaybeType.Some syntax-ty) syntax-ty]
        [(AstMaybeType.No) ty])]
    [(AstType.EnumArgs name _)
      (match (tc-macro-signature-stdlib-comptime-type-id name)
        [(AstMaybeType.Some syntax-ty) syntax-ty]
        [(AstMaybeType.No) ty])]
    [(AstType.Struct name)
      (match (tc-macro-signature-stdlib-comptime-type-id name)
        [(AstMaybeType.Some syntax-ty) syntax-ty]
        [(AstMaybeType.No) ty])]
    [(AstType.StructArgs name _)
      (match (tc-macro-signature-stdlib-comptime-type-id name)
        [(AstMaybeType.Some syntax-ty) syntax-ty]
        [(AstMaybeType.No) ty])]
    [_ ty]))

(define (tc-macro-produced-type-compatible?
  [ctx : TcContext]
  [ret : AstType]
  [produced : AstType]) : bool
  (let
    [expected : AstType (tc-resolve-type ctx (tc-macro-signature-type ret))]
    (or
      (tc-type-eq expected (AstType.Expr))
      (tc-type-eq produced (AstType.Expr))
      (ctfe-untyped-expr-type? produced)
      (ctfe-captured-expr-type? produced)
      (tc-type-compatible? expected (tc-resolve-type ctx produced)))))

(define (tc-check-defmacro-produced-type
  [ctx : TcContext]
  [ret : AstType]
  [value : CompilerCtfeValue]) : ResultTcUnit
  (if (tc-macro-result-module? ret)
    (match value
      [(CompilerCtfeValue.Expr _ _) ResultTcUnit.Ok]
      [_ (ResultTcUnit.Err "typecheck: Module macro body must return Expr")])
    (if (tc-macro-result-decls? ret)
      (match value
        [(CompilerCtfeValue.Expr _ _) ResultTcUnit.Ok]
        [_ (ResultTcUnit.Err "typecheck: Decls macro body must return Expr")])
      (match value
        [(CompilerCtfeValue.Expr _ produced)
          (if (tc-macro-produced-type-compatible? ctx ret produced)
            ResultTcUnit.Ok
            (ResultTcUnit.Err
              "typecheck: macro body produced type does not match declaration"))]
        [_ (ResultTcUnit.Err "typecheck: macro body must return Expr")]))))

(define (tc-comptime-purity-chain-push [chain : TcStringList] [name : String]) : TcStringList
  (TcStringList.Cons name (box chain)))

(define (tc-comptime-purity-chain-render [chain : TcStringList]) : String
  (match chain
    [(TcStringList.Nil) ""]
    [(TcStringList.Cons head rest)
      (let
        [tail : String (tc-comptime-purity-chain-render (box-get rest))]
        (if (string.eq tail "")
          head
          (str_cat.str-cat tail " -> " head)))]))

(define (tc-comptime-purity-chain-path [chain : TcStringList] [name : String]) : String
  (let
    [prefix : String (tc-comptime-purity-chain-render chain)]
    (if (string.eq prefix "")
      name
      (str_cat.str-cat prefix " -> " name))))

(define (tc-comptime-purity-error
  [expr : AstExpr]
  [chain : TcStringList]
  [name : String]
  [reason : String]) : ResultTcUnit
  (ResultTcUnit.Err
    (tc-locate-error-at-expr
      expr
      (str_cat.str-cat
        "typecheck: comptime purity rejects "
        reason
        "; reference path: "
        (tc-comptime-purity-chain-path chain name)))))

(define (tc-comptime-purity-banned-module? [module : String]) : bool
  (cond
    [(string.eq module "io") true]
    [(string.eq module "stdlib.io") true]
    [(string.eq module "stdlib/io") true]
    [(string.eq module "fs") true]
    [(string.eq module "stdlib.fs") true]
    [(string.eq module "stdlib/fs") true]
    [(string.eq module "process") true]
    [(string.eq module "stdlib.process") true]
    [(string.eq module "stdlib/process") true]
    [(string.eq module "stdlib.process-runtime") true]
    [(string.eq module "stdlib/process_runtime") true]
    [(string.eq module "env") true]
    [(string.eq module "stdlib.env") true]
    [(string.eq module "stdlib/env") true]
    [else false]))

(define (tc-comptime-purity-banned-qualified? [ctx : TcContext] [name : String]) : bool
  (if (tc-name-qualified? name)
    (let
      [qualifier : String (tc-qualified-name-module name)]
      [target : String (tc-qualified-access-target-module ctx qualifier)]
      (or
        (tc-comptime-purity-banned-module? qualifier)
        (tc-comptime-purity-banned-module? target)))
    false))

(define (tc-comptime-purity-ctfe-builtin? [name : String]) : bool
  (let
    [lookup-name : String (tc-hygiene-global-call-name name)]
    [call-name : String (ctfe-comptime-helper-call-name lookup-name)]
    (cond
      [(string.eq lookup-name "size-of") true]
      [(string.eq lookup-name "align-of") true]
      [(string.eq lookup-name "offset-of") true]
      [(ctfe-reflection-query-name? lookup-name) true]
      [(ctfe-string-eq-helper-name? lookup-name) true]
      [(string.eq call-name "string-append") true]
      [(string.eq call-name "string-concat") true]
      [(ctfe-string-length-helper-name? lookup-name) true]
      [(ctfe-string-ref-helper-name? lookup-name) true]
      [(ctfe-string-to-int-helper-name? lookup-name) true]
      [(string.eq call-name "int->string") true]
      [(string.eq call-name "expr-bool") true]
      [(string.eq call-name "expr-int") true]
      [(string.eq call-name "expr-string") true]
      [(string.eq call-name "expr-var") true]
      [(string.eq call-name "expr-struct-get") true]
      [(string.eq call-name "expr-tuple-ref") true]
      [(string.eq call-name "expr-struct-set") true]
      [(string.eq call-name "expr-splice") true]
      [(string.eq call-name "expr-if") true]
      [(string.eq call-name "expr-type") true]
      [(string.eq call-name "type-info") true]
      [(ctfe-expr-list-inspector-name? call-name) true]
      [(ctfe-expr-clause-list-inspector-name? call-name) true]
      [(ctfe-expr-binding-clause-list-inspector-name? call-name) true]
      [(string.eq call-name "comptime-error") true]
      [else false])))

(define (tc-macro-param-list-add-bound-names
  [params : AstMacroParamList]
  [bound : TcStringList]) : TcStringList
  (tc-macro-param-list-add-bound-names-at (& params) 0 bound))

(define (tc-macro-param-list-add-bound-names-at
  [params : (& params AstMacroParamList)]
  [index : i64]
  [bound : TcStringList]) : TcStringList
  (if (>= index (ast-macro-param-list-len params))
    bound
    (match (ast-macro-param-list-get params index (ast-macro-param-fallback))
      [(AstMacroParam.Param name _ _)
        (tc-macro-param-list-add-bound-names-at
          params
          (+ index 1)
          (tc-string-list-add bound (intern-str name)))])))

(define (tc-macro-param-bound-names [params : AstMacroParamList]) : TcStringList
  (tc-macro-param-list-add-bound-names params TcStringList.Nil))

(define (tc-comptime-purity-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [expr : AstExpr]) : ResultTcUnit
  (tc-comptime-purity-expr-mode ctx env bound chain seen false expr))

(define (tc-comptime-purity-node-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [expr-id : i64]) : ResultTcUnit
  (tc-comptime-purity-expr-mode
    ctx
    env
    bound
    chain
    seen
    template?
    (ast-node-get expr-id)))

(define (tc-comptime-purity-node2-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [left : i64]
  [right : i64]) : ResultTcUnit
  (match (tc-comptime-purity-node-mode ctx env bound chain seen template? left)
    [(ResultTcUnit.Ok)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? right)]
    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))

(define (tc-comptime-purity-node3-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [first : i64]
  [second : i64]
  [third : i64]) : ResultTcUnit
  (match (tc-comptime-purity-node-mode ctx env bound chain seen template? first)
    [(ResultTcUnit.Ok)
      (match (tc-comptime-purity-node-mode
        ctx
        env
        bound
        chain
        seen
        template?
        second)
        [(ResultTcUnit.Ok)
          (tc-comptime-purity-node-mode
            ctx
            env
            bound
            chain
            seen
            template?
            third)]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))

(define (tc-comptime-purity-template-bound
  [template? : bool]
  [bound : TcStringList]
  [name : i64]) : TcStringList
  (if template?
    bound
    (tc-string-list-add bound (intern-str name))))

(define (tc-comptime-purity-reject-or-template-ok
  [expr : AstExpr]
  [chain : TcStringList]
  [template? : bool]
  [name : String]
  [reason : String]) : ResultTcUnit
  (if template?
    ResultTcUnit.Ok
    (tc-comptime-purity-error expr chain name reason)))

(define (tc-comptime-purity-reject-or-template-node
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [expr : AstExpr]
  [name : String]
  [reason : String]
  [inner : i64]) : ResultTcUnit
  (if template?
    (tc-comptime-purity-node-mode ctx env bound chain seen true inner)
    (tc-comptime-purity-error expr chain name reason)))

(define (tc-comptime-purity-reject-or-template-node2
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [expr : AstExpr]
  [name : String]
  [reason : String]
  [left : i64]
  [right : i64]) : ResultTcUnit
  (if template?
    (tc-comptime-purity-node2-mode ctx env bound chain seen true left right)
    (tc-comptime-purity-error expr chain name reason)))

(define (tc-comptime-purity-expr-list-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [exprs : AstExprList]) : ResultTcUnit
  (tc-comptime-purity-expr-list-mode-at
    ctx
    env
    bound
    chain
    seen
    template?
    (& exprs)
    0))

(define (tc-comptime-purity-expr-list-mode-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get exprs len))
    ResultTcUnit.Ok
    (match (tc-comptime-purity-node-mode
      ctx
      env
      bound
      chain
      seen
      template?
      (ast-expr-list-get exprs index 0))
      [(ResultTcUnit.Ok)
        (tc-comptime-purity-expr-list-mode-at
          ctx
          env
          bound
          chain
          seen
          template?
          exprs
          (+ index 1))]
      [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])))

(define (tc-comptime-purity-expr-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [exprs : AstExprList]) : ResultTcUnit
  (tc-comptime-purity-expr-list-mode ctx env bound chain seen false exprs))

(define (tc-comptime-purity-let-bindings-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [bindings : AstLetBindingList]) : ResultTcStringList
  (tc-comptime-purity-let-bindings-mode-at
    ctx
    env
    bound
    chain
    seen
    template?
    (& bindings)
    0))

(define (tc-comptime-purity-let-bindings-mode-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : ResultTcStringList
  (if (>= index (ast-let-binding-list-len bindings))
    (ResultTcStringList.Ok bound)
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding name _ init-box)
        (match (tc-comptime-purity-node-mode
          ctx
          env
          bound
          chain
          seen
          template?
          init-box)
          [(ResultTcUnit.Ok)
            (tc-comptime-purity-let-bindings-mode-at
              ctx
              env
              (tc-comptime-purity-template-bound template? bound name)
              chain
              seen
              template?
              bindings
              (+ index 1))]
          [(ResultTcUnit.Err message) (ResultTcStringList.Err message)])])))

(define (tc-comptime-purity-resource-bindings-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [bindings : AstResourceBindingList]) : ResultTcStringList
  (tc-comptime-purity-resource-bindings-mode-at
    ctx
    env
    bound
    chain
    seen
    template?
    (& bindings)
    0))

(define (tc-comptime-purity-resource-bindings-mode-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [bindings : (& bindings AstResourceBindingList)]
  [index : i64]) : ResultTcStringList
  (if (>= index (ast-resource-binding-list-len bindings))
    (ResultTcStringList.Ok bound)
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding name init-box cleanup-box)
        (match (tc-comptime-purity-node2-mode
          ctx
          env
          bound
          chain
          seen
          template?
          init-box
          cleanup-box)
          [(ResultTcUnit.Ok)
            (tc-comptime-purity-resource-bindings-mode-at
              ctx
              env
              (tc-comptime-purity-template-bound template? bound name)
              chain
              seen
              template?
              bindings
              (+ index 1))]
          [(ResultTcUnit.Err message) (ResultTcStringList.Err message)])])))

(define (tc-comptime-purity-match-arms-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [arms : AstMatchArmList]) : ResultTcUnit
  (tc-comptime-purity-match-arms-mode-at
    ctx
    env
    bound
    chain
    seen
    template?
    (& arms)
    0))

(define (tc-comptime-purity-match-arms-mode-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : ResultTcUnit
  (if (>= index (struct-get arms len))
    ResultTcUnit.Ok
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (match (tc-comptime-purity-node-mode
          ctx
          env
          (if template?
            bound
            (tc-pattern-add-bound-names pattern bound))
          chain
          seen
          template?
          body-box)
          [(ResultTcUnit.Ok)
            (tc-comptime-purity-match-arms-mode-at
              ctx
              env
              bound
              chain
              seen
              template?
              arms
              (+ index 1))]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])))

(define (tc-comptime-purity-expr-mode
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [template? : bool]
  [expr : AstExpr]) : ResultTcUnit
  (match expr
    [(AstExpr.Spanned inner-box _)
      (tc-comptime-purity-node-mode
        ctx
        env
        bound
        chain
        seen
        template?
        inner-box)]
    [(AstExpr.Literal _) ResultTcUnit.Ok]
    [(AstExpr.Var name)
      (if template?
        ResultTcUnit.Ok
        (tc-comptime-purity-var ctx env bound chain seen expr name))]
    [(AstExpr.Binary _ left right)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        left
        right)]
    [(AstExpr.Unary _ inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExpr.Call func args)
      (match (tc-comptime-purity-node-mode
        ctx
        env
        bound
        chain
        seen
        template?
        func)
        [(ResultTcUnit.Ok)
          (tc-comptime-purity-expr-list-mode
            ctx
            env
            bound
            chain
            seen
            template?
            args)]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [(AstExpr.If cond then-branch else-branch)
      (tc-comptime-purity-node3-mode
        ctx
        env
        bound
        chain
        seen
        template?
        cond
        then-branch
        else-branch)]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body)
          (match (tc-comptime-purity-let-bindings-mode
            ctx
            env
            bound
            chain
            seen
            template?
            bindings)
            [(ResultTcStringList.Ok body-bound)
              (tc-comptime-purity-node-mode
                ctx
                env
                body-bound
                chain
                seen
                template?
                body)]
            [(ResultTcStringList.Err message) (ResultTcUnit.Err message)])])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params _ body)
          (tc-comptime-purity-node-mode
            ctx
            env
            (if template?
              bound
              (tc-param-list-add-bound-names params bound))
            chain
            seen
            template?
            body)])]
    [(AstExpr.Tuple exprs)
      (tc-comptime-purity-expr-list-mode
        ctx
        env
        bound
        chain
        seen
        template?
        exprs)]
    [(AstExpr.TupleRef tuple _)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? tuple)]
    [(AstExpr.Array exprs)
      (tc-comptime-purity-expr-list-mode
        ctx
        env
        bound
        chain
        seen
        template?
        exprs)]
    [(AstExpr.MakeArray _ len)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? len)]
    [(AstExpr.ArrayRef array index)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        array
        index)]
    [(AstExpr.ArraySet array index value)
      (tc-comptime-purity-node3-mode
        ctx
        env
        bound
        chain
        seen
        template?
        array
        index
        value)]
    [(AstExpr.ArrayPush array value)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        array
        value)]
    [(AstExpr.StringRef str index)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        str
        index)]
    [(AstExpr.While cond body)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        cond
        body)]
    [(AstExpr.Begin exprs)
      (tc-comptime-purity-expr-list-mode
        ctx
        env
        bound
        chain
        seen
        template?
        exprs)]
    [(AstExpr.Unsafe exprs)
      (if template?
        (tc-comptime-purity-expr-list-mode ctx env bound chain seen true exprs)
        (tc-comptime-purity-error expr chain "unsafe" "unsafe block"))]
    [(AstExpr.Set _ value)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? value)]
    [(AstExpr.Ann inner _)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExpr.Cast inner _)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExpr.Borrow _ _ place)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? place)]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrut arms)
          (match (tc-comptime-purity-node-mode
            ctx
            env
            bound
            chain
            seen
            template?
            scrut)
            [(ResultTcUnit.Ok)
              (tc-comptime-purity-match-arms-mode
                ctx
                env
                bound
                chain
                seen
                template?
                arms)]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach index _ start end body)
          (match (tc-comptime-purity-node2-mode
            ctx
            env
            bound
            chain
            seen
            template?
            start
            end)
            [(ResultTcUnit.Ok)
              (tc-comptime-purity-node-mode
                ctx
                env
                (tc-comptime-purity-template-bound template? bound index)
                chain
                seen
                template?
                body)]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce _ index _ start end init value)
          (match (tc-comptime-purity-node3-mode
            ctx
            env
            bound
            chain
            seen
            template?
            start
            end
            init)
            [(ResultTcUnit.Ok)
              (tc-comptime-purity-node-mode
                ctx
                env
                (tc-comptime-purity-template-bound template? bound index)
                chain
                seen
                template?
                value)]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan _ index _ start end prefix _ init value body)
          (match (tc-comptime-purity-node3-mode
            ctx
            env
            bound
            chain
            seen
            template?
            start
            end
            init)
            [(ResultTcUnit.Ok)
              (let
                [index-bound : TcStringList
                  (tc-comptime-purity-template-bound template? bound index)]
                (match (tc-comptime-purity-node-mode
                  ctx
                  env
                  index-bound
                  chain
                  seen
                  template?
                  value)
                  [(ResultTcUnit.Ok)
                    (tc-comptime-purity-node-mode
                      ctx
                      env
                      (tc-comptime-purity-template-bound
                        template?
                        index-bound
                        prefix)
                      chain
                      seen
                      template?
                      body)]
                  [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))]
            [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])])]
    [(AstExpr.SpmdBroadcast value lane)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        value
        lane)]
    [(AstExpr.SpmdShuffle value lane)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        value
        lane)]
    [(AstExpr.StructGet receiver _)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? receiver)]
    [(AstExpr.StructSet receiver _ value)
      (tc-comptime-purity-node2-mode
        ctx
        env
        bound
        chain
        seen
        template?
        receiver
        value)]
    [(AstExpr.WithRegion _ body)
      (tc-comptime-purity-expr-list-mode
        ctx
        env
        bound
        chain
        seen
        template?
        body)]
    [(AstExpr.WithEscape scratch body)
      (match (tc-comptime-purity-node-mode
        ctx
        env
        bound
        chain
        seen
        template?
        scratch)
        [(ResultTcUnit.Ok)
          (tc-comptime-purity-expr-list-mode
            ctx
            env
            bound
            chain
            seen
            template?
            body)]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [(AstExpr.WithScratch body)
      (tc-comptime-purity-expr-list-mode
        ctx
        env
        bound
        chain
        seen
        template?
        body)]
    [(AstExpr.InArena arena body)
      (match (tc-comptime-purity-node-mode
        ctx
        env
        bound
        chain
        seen
        template?
        arena)
        [(ResultTcUnit.Ok)
          (tc-comptime-purity-expr-list-mode
            ctx
            env
            bound
            chain
            seen
            template?
            body)]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (match (tc-comptime-purity-resource-bindings-mode
            ctx
            env
            bound
            chain
            seen
            template?
            bindings)
            [(ResultTcStringList.Ok body-bound)
              (tc-comptime-purity-expr-list-mode
                ctx
                env
                body-bound
                chain
                seen
                template?
                body)]
            [(ResultTcStringList.Err message) (ResultTcUnit.Err message)])])]
    [(AstExpr.Box inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExpr.BoxGet inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExpr.BoxTake inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExpr.BoxSet inner value)
      (match (tc-comptime-purity-node-mode
        ctx
        env
        bound
        chain
        seen
        template?
        inner)
        [(ResultTcUnit.Ok)
          (tc-comptime-purity-node-mode
            ctx
            env
            bound
            chain
            seen
            template?
            value)]
        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
    [(AstExpr.TypeLiteral _) ResultTcUnit.Ok]
    [(AstExpr.Init _) ResultTcUnit.Ok]
    [(AstExpr.Comptime inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExpr.Quote _) ResultTcUnit.Ok]
    [(AstExpr.Quasiquote inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen true inner)]
    [(AstExpr.Unquote inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen false inner)]
    [(AstExpr.UnquoteSplicing inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen false inner)]
    [(AstExpr.BracketClause items)
      (tc-comptime-purity-expr-list-mode
        ctx
        env
        bound
        chain
        seen
        template?
        items)]
    [(AstExpr.Try inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExpr.Return inner)
      (tc-comptime-purity-node-mode ctx env bound chain seen template? inner)]
    [(AstExpr.Break) ResultTcUnit.Ok]
    [(AstExpr.Continue) ResultTcUnit.Ok]
    [(AstExpr.PtrNull _)
      (tc-comptime-purity-reject-or-template-ok
        expr
        chain
        template?
        "ptr-null"
        "raw pointer operation")]
    [(AstExpr.PtrNullCheck inner)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "ptr-null?"
        "raw pointer operation"
        inner)]
    [(AstExpr.PtrAddrOf _)
      (tc-comptime-purity-reject-or-template-ok
        expr
        chain
        template?
        "ptr-addr-of"
        "raw pointer operation")]
    [(AstExpr.PtrRead ptr)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "ptr-read"
        "raw pointer operation"
        ptr)]
    [(AstExpr.PtrWrite ptr value)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "ptr-write!"
        "raw pointer operation"
        ptr
        value)]
    [(AstExpr.PtrOffset ptr offset)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "ptr-offset"
        "raw pointer operation"
        ptr
        offset)]
    [(AstExpr.PtrCast ptr _)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "ptr-cast"
        "raw pointer operation"
        ptr)]
    [(AstExpr.PtrToInt ptr)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "ptr->int"
        "raw pointer operation"
        ptr)]
    [(AstExpr.IntToPtr value _)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "int->ptr"
        "raw pointer operation"
        value)]
    [(AstExpr.StringData str)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "string-data"
        "unsafe FFI bridge"
        str)]
    [(AstExpr.StringFromBytes ptr len)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "string-from-bytes"
        "unsafe FFI bridge"
        ptr
        len)]
    [(AstExpr.ArrayData array)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "array-data"
        "unsafe FFI bridge"
        array)]
    [(AstExpr.BinaryData _) ResultTcUnit.Ok]
    [(AstExpr.SpmdProgramIndex) ResultTcUnit.Ok]
    [(AstExpr.SpmdProgramCount) ResultTcUnit.Ok]
    [(AstExpr.ProgramArgc)
      (tc-comptime-purity-reject-or-template-ok
        expr
        chain
        template?
        "program-argc"
        "runtime process state")]
    [(AstExpr.ProgramArgv)
      (tc-comptime-purity-reject-or-template-ok
        expr
        chain
        template?
        "program-argv"
        "runtime process state")]
    [(AstExpr.ProgramEnvp)
      (tc-comptime-purity-reject-or-template-ok
        expr
        chain
        template?
        "program-envp"
        "runtime process state")]
    [(AstExpr.CpuIdEax leaf subleaf)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "cpuid"
        "host CPU query"
        leaf
        subleaf)]
    [(AstExpr.CpuIdEbx leaf subleaf)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "cpuid"
        "host CPU query"
        leaf
        subleaf)]
    [(AstExpr.CpuIdEcx leaf subleaf)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "cpuid"
        "host CPU query"
        leaf
        subleaf)]
    [(AstExpr.CpuIdEdx leaf subleaf)
      (tc-comptime-purity-reject-or-template-node2
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "cpuid"
        "host CPU query"
        leaf
        subleaf)]
    [(AstExpr.Xgetbv index)
      (tc-comptime-purity-reject-or-template-node
        ctx
        env
        bound
        chain
        seen
        template?
        expr
        "xgetbv"
        "host CPU query"
        index)]
    [(AstExpr.Syscall args)
      (if template?
        (tc-comptime-purity-expr-list-mode ctx env bound chain seen true args)
        (tc-comptime-purity-error expr chain "syscall" "host syscall"))]))

(define (tc-comptime-purity-var
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [expr : AstExpr]
  [name-id : i64]) : ResultTcUnit
  (let
    [name : String (intern-str name-id)]
    (cond
      [(tc-string-list-contains bound name) ResultTcUnit.Ok]
      [(tc-comptime-purity-banned-qualified? ctx name)
        (tc-comptime-purity-error
          expr
          chain
          name
          (str_cat.str-cat
            "import from module "
            (tc-qualified-name-module name)))]
      [(tc-comptime-purity-ctfe-builtin? name) ResultTcUnit.Ok]
      [else
        (match (tc-lookup-unsafe-id env name-id)
          [(ResultTcTypeUnsafe.Ok _ unsafe?)
            (if unsafe?
              (tc-comptime-purity-error
                expr
                chain
                name
                (str_cat.str-cat "unsafe declaration " name))
              (tc-comptime-purity-var-handle
                ctx
                env
                bound
                chain
                seen
                expr
                name-id))]
          [(ResultTcTypeUnsafe.Err _)
            (tc-comptime-purity-var-handle
              ctx
              env
              bound
              chain
              seen
              expr
              name-id)])])))

(define (tc-comptime-purity-var-handle
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [expr : AstExpr]
  [name-id : i64]) : ResultTcUnit
  (let
    [handle : i64
      (compiler-symbols-lookup-value-id-or
        (tc-context-symbols ctx)
        name-id
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (let
        [name : String (intern-str name-id)]
        [kind : i64 (compiler-symbol-handle-kind handle)]
        (cond
          [(= kind (compiler-symbol-kind-extern))
            (tc-comptime-purity-error
              expr
              chain
              name
              (str_cat.str-cat "extern reference " name))]
          [(= kind (compiler-symbol-kind-defdispatch))
            (tc-comptime-purity-error
              expr
              chain
              name
              (str_cat.str-cat "runtime dispatch reference " name))]
          [(or
              (= kind (compiler-symbol-kind-value-define))
              (= kind (compiler-symbol-kind-function-define)))
            (tc-comptime-purity-handle-decl
              ctx
              env
              bound
              chain
              seen
              expr
              name
              handle)]
          [else ResultTcUnit.Ok]))
      ResultTcUnit.Ok)))

(define (tc-comptime-purity-handle-decl
  [ctx : TcContext]
  [env : TcTypeEnv]
  [_bound : TcStringList]
  [chain : TcStringList]
  [seen : TcStringList]
  [_expr : AstExpr]
  [name : String]
  [handle : i64]) : ResultTcUnit
  (if (tc-string-list-contains seen name)
    ResultTcUnit.Ok
    (let
      [index : i64 (compiler-symbol-handle-index handle)]
      [decls : (Array AstDecl)
        (compiler-symbols-decls (tc-context-symbols ctx))]
      (if (or (< index 0) (>= index (array.length decls)))
        ResultTcUnit.Ok
        (tc-comptime-purity-decl
          ctx
          env
          (tc-comptime-purity-chain-push chain name)
          (tc-string-list-add seen name)
          (array-ref decls index))))))

(define (tc-comptime-purity-decl
  [ctx : TcContext]
  [env : TcTypeEnv]
  [chain : TcStringList]
  [seen : TcStringList]
  [decl : AstDecl]) : ResultTcUnit
  (match decl
    [(AstDecl.Def _ _ expr-box)
      (let
        [expr : AstExpr (ast-node-get expr-box)]
        (tc-comptime-purity-expr ctx env TcStringList.Nil chain seen expr))]
    [(AstDecl.DefFn _ params _ body-box _)
      (let
        [body : AstExpr (ast-node-get body-box)]
        (tc-comptime-purity-expr
          ctx
          env
          (tc-param-bound-names params)
          chain
          seen
          body))]
    [(AstDecl.DefMacro _ _ _ _) ResultTcUnit.Ok]
    [(AstDecl.Extern name _ _ _)
      (tc-comptime-purity-error
        (AstExpr.Var name)
        chain
        (intern-str name)
        (str_cat.str-cat "extern reference " (intern-str name)))]
    [(AstDecl.DefDispatch name _)
      (tc-comptime-purity-error
        (AstExpr.Var name)
        chain
        (intern-str name)
        (str_cat.str-cat "runtime dispatch reference " (intern-str name)))]
    [(AstDecl.Unsafe _)
      (ResultTcUnit.Err
        (str_cat.str-cat
          "typecheck: comptime purity rejects unsafe declaration; reference path: "
          (tc-comptime-purity-chain-render chain)))]
    [(AstDecl.ComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (tc-comptime-purity-decl ctx env chain seen template))]
    [_ ResultTcUnit.Ok]))

(define (tc-check-defmacro-purity
  [ctx : TcContext]
  [env : TcTypeEnv]
  [name : i64]
  [params : AstMacroParamList]
  [body : AstExpr]) : ResultTcUnit
  (tc-comptime-purity-expr
    ctx
    env
    (tc-macro-param-bound-names params)
    (tc-comptime-purity-chain-push TcStringList.Nil (intern-str name))
    (tc-string-list-add TcStringList.Nil (intern-str name))
    body))

(define (tc-macro-param-list-needs-call-context? [params : AstMacroParamList]) : bool
  (tc-macro-param-list-needs-call-context-at? (& params) 0))

(define (tc-macro-param-list-needs-call-context-at?
  [params : (& params AstMacroParamList)]
  [index : i64]) : bool
  (if (>= index (ast-macro-param-list-len params))
    false
    (match (ast-macro-param-list-get params index (ast-macro-param-fallback))
      [(AstMacroParam.Param _ ty _)
        (if (or (tc-macro-type-param-kind? ty) (tc-macro-module-param-kind? ty))
          true
          (tc-macro-param-list-needs-call-context-at? params (+ index 1)))])))

(define (tc-check-comptime-decl-purity
  [ctx : TcContext]
  [env : TcTypeEnv]
  [template : AstDecl]) : ResultTcUnit
  (tc-comptime-purity-decl
    ctx
    env
    (tc-comptime-purity-chain-push TcStringList.Nil "comptime-decl")
    TcStringList.Nil
    template))

(define (tc-check-defmacro
  [name : i64]
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [params : AstMacroParamList]
  [ret : AstType]
  [body : AstExpr]) : ResultTcUnit
  (let
    [macro-env : TcTypeEnv
      (tc-bind-macro-params ctx (tc-macro-helper-env-cached top-env) params)]
    (match (tc-expr ctx macro-env body)
      [(ResultTcType.Ok got)
        (match (tc-check-defmacro-purity ctx macro-env name params body)
          [(ResultTcUnit.Ok)
            (match (tc-expect
              got
              (AstType.Expr)
              "typecheck: macro body must return Expr")
              [(ResultTcUnit.Ok)
                (if (tc-macro-param-list-needs-call-context? params)
                  ResultTcUnit.Ok
                  (begin
                    (tc-context-capture-active-pools! ctx)
                    (match (compiler-ctfe-eval
                      body
                      (tc-ctfe-env-extend-macro-params
                        ctx
                        (tc-ctfe-env ctx)
                        params)
                      (ctfe-fuel-limit))
                      [(ResultCtfe.Ok value _)
                        (begin
                          (ast-node-pool-context-install!
                            (tc-context-pools ctx))
                          (tc-check-defmacro-produced-type ctx ret value))]
                      [(ResultCtfe.Err diag)
                        (ResultTcUnit.Err
                          (compiler-diagnostic-message (box-get diag)))])))]
              [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
          [(ResultTcUnit.Err message) (ResultTcUnit.Err message)])]
      [(ResultTcType.Err message) (ResultTcUnit.Err message)])))

;; --- whole-local move checker (#1048/#1049) ---------------------------------
;;
;; Reject use-after-move for move-only whole locals/parameters in source
;; evaluation order. The staged owner-only policy keeps ordinary aggregate
;; sharing compatible, while consuming only by-value sites whose target is an
;; owner today: cleanup-owning structs and Box values. Reads never move; branches
;; merge by union (a place moved on any arm is moved afterward). Loops reject
;; owner moves from values visible before the repeated body, then discard body
;; moves for the post-state because they may run zero times; lambdas still
;; discard their body's moves because they may be deferred. Reassigning a slot
;; with `set!` clears its moved mark. Owner-consuming struct fields, tuple
;; elements, and fixed-array literal elements are tracked as root paths so
;; unrelated entries remain usable. Nested direct-root struct/tuple/fixed-array
;; literal chains are represented by stable path strings. Box and non-literal
;; aggregate projections stay rejected until their path/reinitialization policy
;; lands; dynamic arrays have a separate diagnostic because element ownership
;; cannot be made sound without an index policy.
(defstruct TcMovedSet
  (map hashmap.StringI64Map))

(defenum TcMoveResult
  (Ok TcMovedSet)
  (Err String))

(defenum TcMoveBindings
  (Ok TcTypeEnv TcMovedSet TcMovedSet TcMovedSet)
  (Err String))

(defenum TcMoveCleanupOwners
  (Nil)
  (Cons String i64 (Box TcMoveCleanupOwners)))

(defenum TcMoveResourceBindings
  (Ok TcTypeEnv TcMovedSet TcMovedSet TcMovedSet TcMoveCleanupOwners)
  (Err String))

(defenum TcMoveMaybeIndex
  (No)
  (Some i64))

(defenum TcMoveConflict
  (No)
  (Some String i64))

(define (tc-moved-empty) : TcMovedSet
  (TcMovedSet (hashmap.string-i64-map-with-capacity 8)))

(define (tc-moved-map [set : TcMovedSet]) : hashmap.StringI64Map
  (struct-get set map))

(define (tc-moved-len [set : TcMovedSet]) : i64
  (hashmap.string-i64-map-len (tc-moved-map set)))

(define (tc-moved-capacity [set : TcMovedSet]) : i64
  (hashmap.string-i64-map-capacity (tc-moved-map set)))

(define (tc-moved-clone [set : TcMovedSet]) : TcMovedSet
  (let
    [map : hashmap.StringI64Map (tc-moved-map set)]
    (TcMovedSet
      (hashmap.string-i64-map-resized map (hashmap.string-i64-map-capacity map)))))

(define (tc-moved-contains? [set : TcMovedSet] [name : String]) : bool
  (hashmap.string-i64-map-contains? (tc-moved-map set) name))

(define (tc-moved-no-origin-id) : i64
  -1)

(define (tc-moved-add [set : TcMovedSet] [name : String]) : TcMovedSet
  (TcMovedSet
    (hashmap.string-i64-map-put (tc-moved-map set) name (tc-moved-no-origin-id))))

(define (tc-moved-add-value [set : TcMovedSet] [name : String] [value : i64]) : TcMovedSet
  (TcMovedSet (hashmap.string-i64-map-put (tc-moved-map set) name value)))

(define (tc-moved-add-origin
  [set : TcMovedSet]
  [name : String]
  [origin : AstExpr]) : TcMovedSet
  (tc-moved-add-value set name (ast-node-push origin)))

(define (tc-moved-remove [set : TcMovedSet] [name : String]) : TcMovedSet
  (match (hashmap.string-i64-map-remove (tc-moved-map set) name)
    [(hashmap.StringI64MapRemoveOk map) (TcMovedSet map)]
    [(hashmap.StringI64MapRemoveMissing map) (TcMovedSet map)]))

(define (tc-moved-conflict [set : TcMovedSet] [name : String]) : TcMoveConflict
  (match (hashmap.string-i64-map-get (tc-moved-map set) name)
    [(hashmap.StringI64MapFound origin-id) (TcMoveConflict.Some name origin-id)]
    [(hashmap.StringI64MapMissing) TcMoveConflict.No]))

(define (tc-move-use-message [name : String]) : String
  (string.append (string.append "typecheck: use of moved value `" name) "`"))

(define (tc-move-loop-carried-message [name : String]) : String
  (string.append
    (string.append "typecheck: cannot move loop-carried owner value `" name)
    "`"))

(define (tc-move-cleanup-owner-exit-message [name : String]) : String
  (string.append
    (string.append "typecheck: cleanup owner `" name)
    "` moved before with scope exit"))

(define (tc-move-help) : String
  "clone the owner before moving it again, reinitialize the moved place before reuse, or keep the owner move inside a narrower scope")

(define (tc-moved-path-key [path : String]) : String
  (string.append "\npath:" path))

(define (tc-moved-partial-key [name : String]) : String
  (string.append "\npartial:" name))

(define (tc-moved-partial? [set : TcMovedSet] [name : String]) : bool
  (tc-moved-contains? set (tc-moved-partial-key name)))

(define (tc-move-string-prefix? [text : String] [prefix : String]) : bool
  (string.is-string-prefix-at (& text) (& prefix) 0))

(define (tc-moved-path-key? [key : String]) : bool
  (tc-move-string-prefix? key (tc-moved-path-key "")))

(define (tc-moved-conflict-display-path [key : String]) : String
  (let
    [path-prefix : String (tc-moved-path-key "")]
    [partial-prefix : String (tc-moved-partial-key "")]
    [key-len : i64 (string.string-length key)]
    (if (tc-move-string-prefix? key path-prefix)
      (string.substring
        key
        (string.string-length path-prefix)
        (- key-len (string.string-length path-prefix)))
      (if (tc-move-string-prefix? key partial-prefix)
        (string.substring
          key
          (string.string-length partial-prefix)
          (- key-len (string.string-length partial-prefix)))
        key))))

(define (tc-move-origin-label [key : String]) : String
  (str_cat.str-cat
    "move of `"
    (tc-moved-conflict-display-path key)
    "` happened here"))

(define (tc-move-loop-carried-origin-label [name : String]) : String
  (str_cat.str-cat
    "owner value `"
    name
    "` is loop-carried into a repeated body"))

(define (tc-move-cleanup-owner-binding-label [name : String]) : String
  (str_cat.str-cat "cleanup owner `" name "` is bound for this with scope here"))

(define (tc-move-origin-span [origin-id : i64]) : TcMaybeAstSourceSpan
  (if (= origin-id (tc-moved-no-origin-id))
    TcMaybeAstSourceSpan.No
    (tc-expr-maybe-span (ast-node-get origin-id))))

(define (tc-move-rich-origin-message
  [primary : AstExpr]
  [message : String]
  [origin-id : i64]
  [origin-label : String]) : String
  (match (tc-expr-maybe-span primary)
    [(TcMaybeAstSourceSpan.Some primary-span)
      (match (tc-move-origin-span origin-id)
        [(TcMaybeAstSourceSpan.Some origin-span)
          (tc-rich-error-one-secondary
            primary-span
            message
            (tc-move-help)
            origin-span
            origin-label)]
        [(TcMaybeAstSourceSpan.No)
          (tc-rich-error-one-secondary
            primary-span
            message
            (tc-move-help)
            primary-span
            origin-label)])]
    [(TcMaybeAstSourceSpan.No)
      (match (tc-move-origin-span origin-id)
        [(TcMaybeAstSourceSpan.Some origin-span)
          (tc-rich-error-one-secondary
            origin-span
            message
            (tc-move-help)
            origin-span
            origin-label)]
        [(TcMaybeAstSourceSpan.No) message])]))

(define (tc-move-rich-conflict-message
  [conflict : TcMoveConflict]
  [fallback-key : String]
  [primary : AstExpr]
  [message : String]) : String
  (match conflict
    [(TcMoveConflict.Some key origin-id)
      (tc-move-rich-origin-message
        primary
        message
        origin-id
        (tc-move-origin-label key))]
    [TcMoveConflict.No
      (tc-move-rich-origin-message
        primary
        message
        (tc-moved-no-origin-id)
        (tc-move-origin-label fallback-key))]))

(define (tc-move-rich-loop-carried-message [name : String] [primary : AstExpr]) : String
  (tc-move-rich-origin-message
    primary
    (tc-move-loop-carried-message name)
    (tc-moved-no-origin-id)
    (tc-move-loop-carried-origin-label name)))

(define (tc-move-rich-cleanup-owner-exit-message
  [conflict : TcMoveConflict]
  [name : String]
  [owner-origin-id : i64]
  [scope : AstExpr]) : String
  (let
    [message : String (tc-move-cleanup-owner-exit-message name)]
    [owner-label : String (tc-move-cleanup-owner-binding-label name)]
    (match (tc-expr-maybe-span scope)
      [(TcMaybeAstSourceSpan.Some primary-span)
        (match conflict
          [(TcMoveConflict.Some key move-origin-id)
            (match (tc-move-origin-span move-origin-id)
              [(TcMaybeAstSourceSpan.Some move-span)
                (match (tc-move-origin-span owner-origin-id)
                  [(TcMaybeAstSourceSpan.Some owner-span)
                    (tc-rich-error-two-secondaries
                      primary-span
                      message
                      (tc-move-help)
                      move-span
                      (tc-move-origin-label key)
                      owner-span
                      owner-label)]
                  [(TcMaybeAstSourceSpan.No)
                    (tc-rich-error-two-secondaries
                      primary-span
                      message
                      (tc-move-help)
                      move-span
                      (tc-move-origin-label key)
                      primary-span
                      owner-label)])]
              [(TcMaybeAstSourceSpan.No)
                (match (tc-move-origin-span owner-origin-id)
                  [(TcMaybeAstSourceSpan.Some owner-span)
                    (tc-rich-error-one-secondary
                      primary-span
                      message
                      (tc-move-help)
                      owner-span
                      owner-label)]
                  [(TcMaybeAstSourceSpan.No)
                    (tc-rich-error-one-secondary
                      primary-span
                      message
                      (tc-move-help)
                      primary-span
                      owner-label)])])]
          [TcMoveConflict.No
            (match (tc-move-origin-span owner-origin-id)
              [(TcMaybeAstSourceSpan.Some owner-span)
                (tc-rich-error-one-secondary
                  primary-span
                  message
                  (tc-move-help)
                  owner-span
                  owner-label)]
              [(TcMaybeAstSourceSpan.No)
                (tc-rich-error-one-secondary
                  primary-span
                  message
                  (tc-move-help)
                  primary-span
                  owner-label)])])]
      [(TcMaybeAstSourceSpan.No)
        (match conflict
          [(TcMoveConflict.Some key move-origin-id)
            (match (tc-move-origin-span move-origin-id)
              [(TcMaybeAstSourceSpan.Some move-span)
                (match (tc-move-origin-span owner-origin-id)
                  [(TcMaybeAstSourceSpan.Some owner-span)
                    (tc-rich-error-two-secondaries
                      move-span
                      message
                      (tc-move-help)
                      move-span
                      (tc-move-origin-label key)
                      owner-span
                      owner-label)]
                  [(TcMaybeAstSourceSpan.No)
                    (tc-rich-error-two-secondaries
                      move-span
                      message
                      (tc-move-help)
                      move-span
                      (tc-move-origin-label key)
                      move-span
                      owner-label)])]
              [(TcMaybeAstSourceSpan.No)
                (match (tc-move-origin-span owner-origin-id)
                  [(TcMaybeAstSourceSpan.Some owner-span)
                    (tc-rich-error-one-secondary
                      owner-span
                      message
                      (tc-move-help)
                      owner-span
                      owner-label)]
                  [(TcMaybeAstSourceSpan.No) message])])]
          [TcMoveConflict.No
            (match (tc-move-origin-span owner-origin-id)
              [(TcMaybeAstSourceSpan.Some owner-span)
                (tc-rich-error-one-secondary
                  owner-span
                  message
                  (tc-move-help)
                  owner-span
                  owner-label)]
              [(TcMaybeAstSourceSpan.No) message])])])))

(define (tc-move-rich-conflict-result
  [conflict : TcMoveConflict]
  [fallback-key : String]
  [primary : AstExpr]
  [message : String]) : TcMoveResult
  (TcMoveResult.Err
    (tc-move-rich-conflict-message conflict fallback-key primary message)))

(define (tc-move-rich-use-conflict-result
  [conflict : TcMoveConflict]
  [fallback-key : String]
  [primary : AstExpr]
  [name : String]) : TcMoveResult
  (tc-move-rich-conflict-result
    conflict
    fallback-key
    primary
    (tc-move-use-message name)))

(define (tc-move-rich-loop-carried-result [name : String] [primary : AstExpr]) : TcMoveResult
  (TcMoveResult.Err (tc-move-rich-loop-carried-message name primary)))

(define (tc-moved-path-key-conflicts? [key : String] [path : String]) : bool
  (let
    [new-key : String (tc-moved-path-key path)]
    [descendant-prefix : String (tc-moved-path-key (string.append path "."))]
    [ancestor-prefix : String (string.append key ".")]
    (if (tc-moved-path-key? key)
      (or
        (string.eq key new-key)
        (tc-move-string-prefix? key descendant-prefix)
        (tc-move-string-prefix? new-key ancestor-prefix))
      false)))

(define (tc-moved-path-conflict-loop
  [map : hashmap.StringI64Map]
  [path : String]
  [index : i64]) : TcMoveConflict
  (if (>= index (hashmap.string-i64-map-capacity map))
    TcMoveConflict.No
    (match (hashmap.string-i64-map-entry-at map index)
      [(hashmap.StringI64MapEntrySome key value)
        (if (tc-moved-path-key-conflicts? key path)
          (TcMoveConflict.Some key value)
          (tc-moved-path-conflict-loop
            map
            path
            (hashmap.string-i64-map-next-occupied map (+ index 1))))]
      [(hashmap.StringI64MapEntryNone)
        (tc-moved-path-conflict-loop
          map
          path
          (hashmap.string-i64-map-next-occupied map (+ index 1)))])))

(define (tc-moved-path-conflict [set : TcMovedSet] [path : String]) : TcMoveConflict
  (tc-moved-path-conflict-loop
    (tc-moved-map set)
    path
    (hashmap.string-i64-map-next-occupied (tc-moved-map set) 0)))

(define (tc-moved-path-conflict? [set : TcMovedSet] [path : String]) : bool
  (match (tc-moved-path-conflict set path)
    [(TcMoveConflict.Some _ _) true]
    [TcMoveConflict.No false]))

(define (tc-moved-remove-prefix-loop
  [map : hashmap.StringI64Map]
  [prefix : String]
  [index : i64]
  [out : TcMovedSet]) : TcMovedSet
  (if (>= index (hashmap.string-i64-map-capacity map))
    out
    (match (hashmap.string-i64-map-entry-at map index)
      [(hashmap.StringI64MapEntrySome key _)
        (let
          [next : i64 (hashmap.string-i64-map-next-occupied map (+ index 1))]
          [out2 : TcMovedSet
            (if (tc-move-string-prefix? key prefix)
              (tc-moved-remove out key)
              out)]
          (tc-moved-remove-prefix-loop map prefix next out2))]
      [(hashmap.StringI64MapEntryNone)
        (tc-moved-remove-prefix-loop
          map
          prefix
          (hashmap.string-i64-map-next-occupied map (+ index 1))
          out)])))

(define (tc-moved-remove-prefix [set : TcMovedSet] [prefix : String]) : TcMovedSet
  (tc-moved-remove-prefix-loop
    (tc-moved-map set)
    prefix
    (hashmap.string-i64-map-next-occupied (tc-moved-map set) 0)
    set))

(define (tc-moved-remove-root-state [set : TcMovedSet] [name : String]) : TcMovedSet
  (tc-moved-remove-prefix
    (tc-moved-remove
      (tc-moved-remove (tc-moved-remove set name) (tc-moved-partial-key name))
      (tc-moved-path-key name))
    (tc-moved-path-key (string.append name "."))))

(define (tc-moved-any-path-with-prefix-loop?
  [map : hashmap.StringI64Map]
  [prefix : String]
  [index : i64]) : bool
  (if (>= index (hashmap.string-i64-map-capacity map))
    false
    (match (hashmap.string-i64-map-entry-at map index)
      [(hashmap.StringI64MapEntrySome key _)
        (if (and (tc-moved-path-key? key) (tc-move-string-prefix? key prefix))
          true
          (tc-moved-any-path-with-prefix-loop?
            map
            prefix
            (hashmap.string-i64-map-next-occupied map (+ index 1))))]
      [(hashmap.StringI64MapEntryNone)
        (tc-moved-any-path-with-prefix-loop?
          map
          prefix
          (hashmap.string-i64-map-next-occupied map (+ index 1)))])))

(define (tc-moved-any-root-path? [set : TcMovedSet] [root : String]) : bool
  (tc-moved-any-path-with-prefix-loop?
    (tc-moved-map set)
    (tc-moved-path-key (string.append root "."))
    (hashmap.string-i64-map-next-occupied (tc-moved-map set) 0)))

(define (tc-moved-root-path-conflict-loop
  [map : hashmap.StringI64Map]
  [prefix : String]
  [index : i64]) : TcMoveConflict
  (if (>= index (hashmap.string-i64-map-capacity map))
    TcMoveConflict.No
    (match (hashmap.string-i64-map-entry-at map index)
      [(hashmap.StringI64MapEntrySome key value)
        (if (and (tc-moved-path-key? key) (tc-move-string-prefix? key prefix))
          (TcMoveConflict.Some key value)
          (tc-moved-root-path-conflict-loop
            map
            prefix
            (hashmap.string-i64-map-next-occupied map (+ index 1))))]
      [(hashmap.StringI64MapEntryNone)
        (tc-moved-root-path-conflict-loop
          map
          prefix
          (hashmap.string-i64-map-next-occupied map (+ index 1)))])))

(define (tc-moved-root-path-conflict [set : TcMovedSet] [root : String]) : TcMoveConflict
  (tc-moved-root-path-conflict-loop
    (tc-moved-map set)
    (tc-moved-path-key (string.append root "."))
    (hashmap.string-i64-map-next-occupied (tc-moved-map set) 0)))

(define (tc-moved-root-conflict [set : TcMovedSet] [root : String]) : TcMoveConflict
  (match (tc-moved-conflict set root)
    [(TcMoveConflict.Some key origin-id) (TcMoveConflict.Some key origin-id)]
    [TcMoveConflict.No
      (match (tc-moved-root-path-conflict set root)
        [(TcMoveConflict.Some key origin-id)
          (TcMoveConflict.Some key origin-id)]
        [TcMoveConflict.No (tc-moved-conflict set (tc-moved-partial-key root))])]))

(define (tc-moved-remove-exact-path
  [set : TcMovedSet]
  [root : String]
  [path : String]) : TcMovedSet
  (let
    [without-path : TcMovedSet (tc-moved-remove set (tc-moved-path-key path))]
    (if (tc-moved-any-root-path? without-path root)
      without-path
      (tc-moved-remove without-path (tc-moved-partial-key root)))))

(define (tc-moved-union-loop
  [a : hashmap.StringI64Map]
  [index : i64]
  [out : TcMovedSet]) : TcMovedSet
  (if (>= index (hashmap.string-i64-map-capacity a))
    out
    (match (hashmap.string-i64-map-entry-at a index)
      [(hashmap.StringI64MapEntrySome key value)
        (tc-moved-union-loop
          a
          (hashmap.string-i64-map-next-occupied a (+ index 1))
          (tc-moved-add-value out key value))]
      [(hashmap.StringI64MapEntryNone)
        (tc-moved-union-loop
          a
          (hashmap.string-i64-map-next-occupied a (+ index 1))
          out)])))

;; Union keeps the left input's value for duplicate facts. Branch merging
;; therefore reports the origin from the first/left arm deterministically.
(define (tc-moved-union [a : TcMovedSet] [b : TcMovedSet]) : TcMovedSet
  (tc-moved-union-loop
    (tc-moved-map a)
    (hashmap.string-i64-map-next-occupied (tc-moved-map a) 0)
    b))

(define (tc-move-var-move-only? [env : TcTypeEnv] [name : String]) : bool
  (match (tc-lookup env name)
    [(ResultTcType.Ok ty) (tc-type-move-only? ty)]
    [(ResultTcType.Err _) false]))

(define (tc-type-consuming-by-value-now? [ctx : TcContext] [ty : AstType]) : bool
  (let
    [resolved : AstType (tc-type-strip-region (tc-resolve-type ctx ty))]
    (match resolved
      [(AstType.Box _) true]
      [(AstType.Struct name)
        (if (tc-thread-safe-handle-type-name? (intern-str name))
          true
          (tc-cleanup-owning-struct-type? ctx resolved))]
      [(AstType.StructArgs name _)
        (if (tc-thread-safe-handle-type-name? (intern-str name))
          true
          (tc-cleanup-owning-struct-type? ctx resolved))]
      [_ false])))

;; Matching a cleanup-owning enum consumes the whole scrutinee value. Ordinary
;; enums stay compatibility-non-consuming for existing AST/IR-style sharing.
(define (tc-type-consuming-match-scrutinee-now?
  [ctx : TcContext]
  [ty : AstType]) : bool
  (tc-cleanup-owning-enum-type? ctx ty))

;; The bare variable named by an init/rhs expression, unwrapping spans and
;; annotations, or none if the expression is not a whole-variable reference.
(define (tc-move-bare-var [expr : AstExpr]) : TcMaybeString
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-bare-var inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-bare-var inner))]
    [(AstExpr.Var name) (TcMaybeString.Some (intern-str name))]
    [_ (TcMaybeString.No)]))

;; The root local named by a projection chain. This intentionally returns bare
;; variables too so consuming sites can share one helper for whole values and
;; projected owner fields/elements.
(define (tc-move-root-projection-var [expr : AstExpr]) : TcMaybeString
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-root-projection-var inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-root-projection-var inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-root-projection-var inner))]
    [(AstExpr.StructGet inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-root-projection-var inner))]
    [(AstExpr.TupleRef inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-root-projection-var inner))]
    [(AstExpr.ArrayRef array-box _)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-move-root-projection-var array))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-root-projection-var inner))]
    [(AstExpr.Var name) (TcMaybeString.Some (intern-str name))]
    [_ (TcMaybeString.No)]))

(define (tc-move-dynamic-array-element-message) : String
  "typecheck: cannot move owner-consuming value out of dynamic array element")

(define (tc-move-box-projection-message) : String
  "typecheck: cannot move owner-consuming value out of box")

(define (tc-move-aggregate-path-message) : String
  "typecheck: cannot move owner-consuming value out of aggregate path")

(define (tc-move-aggregate-path-projection? [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-aggregate-path-projection? inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-aggregate-path-projection? inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-aggregate-path-projection? inner))]
    [(AstExpr.StructGet _ _) true]
    [(AstExpr.TupleRef _ _) true]
    [(AstExpr.ArrayRef _ _) true]
    [(AstExpr.BoxGet _) true]
    [_ false]))

(define (tc-move-path-append [base : String] [field : String]) : String
  (string.append (string.append base ".") field))

(define (tc-move-tuple-index-path [base : String] [index : i64]) : String
  (string.append (string.append base ".#tuple.") (string.int->string index)))

(define (tc-move-array-index-path [base : String] [index : i64]) : String
  (string.append (string.append base ".#array.") (string.int->string index)))

(define (tc-move-literal-index [expr : AstExpr]) : TcMoveMaybeIndex
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-literal-index inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-literal-index inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-literal-index inner))]
    [(AstExpr.Literal lit)
      (match lit
        [(AstLiteral.Int index _) (TcMoveMaybeIndex.Some index)]
        [_ (TcMoveMaybeIndex.No)])]
    [_ (TcMoveMaybeIndex.No)]))

(define (tc-move-direct-root-base-path [expr : AstExpr]) : TcMaybeString
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-direct-root-base-path inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-direct-root-base-path inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-direct-root-base-path inner))]
    [(AstExpr.StructGet inner-box field)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-move-direct-root-base-path inner)
          [(TcMaybeString.Some base)
            (TcMaybeString.Some (tc-move-path-append base (intern-str field)))]
          [(TcMaybeString.No) (TcMaybeString.No)]))]
    [(AstExpr.TupleRef inner-box index)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-move-direct-root-base-path inner)
          [(TcMaybeString.Some base)
            (TcMaybeString.Some (tc-move-tuple-index-path base index))]
          [(TcMaybeString.No) (TcMaybeString.No)]))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index-expr : AstExpr (ast-node-get index-box)]
        (match (tc-move-direct-root-base-path array)
          [(TcMaybeString.Some base)
            (match (tc-move-literal-index index-expr)
              [(TcMoveMaybeIndex.Some index)
                (TcMaybeString.Some (tc-move-array-index-path base index))]
              [(TcMoveMaybeIndex.No) (TcMaybeString.No)])]
          [(TcMaybeString.No) (TcMaybeString.No)]))]
    [(AstExpr.Var name) (TcMaybeString.Some (intern-str name))]
    [_ (TcMaybeString.No)]))

(define (tc-move-struct-field-path [expr : AstExpr]) : TcMaybeString
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-struct-field-path inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-struct-field-path inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-struct-field-path inner))]
    [(AstExpr.StructGet inner-box field)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-move-direct-root-base-path inner)
          [(TcMaybeString.Some base)
            (TcMaybeString.Some (tc-move-path-append base (intern-str field)))]
          [(TcMaybeString.No) (TcMaybeString.No)]))]
    [_ (TcMaybeString.No)]))

(define (tc-move-tuple-element-path [expr : AstExpr]) : TcMaybeString
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-tuple-element-path inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-tuple-element-path inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-tuple-element-path inner))]
    [(AstExpr.TupleRef inner-box index)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-move-direct-root-base-path inner)
          [(TcMaybeString.Some base)
            (TcMaybeString.Some (tc-move-tuple-index-path base index))]
          [(TcMaybeString.No) (TcMaybeString.No)]))]
    [_ (TcMaybeString.No)]))

(define (tc-move-array-element-path [expr : AstExpr]) : TcMaybeString
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-array-element-path inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-array-element-path inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-array-element-path inner))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index-expr : AstExpr (ast-node-get index-box)]
        (tc-move-array-set-path array index-expr))]
    [_ (TcMaybeString.No)]))

(define (tc-move-array-set-path [array : AstExpr] [index-expr : AstExpr]) : TcMaybeString
  (match (tc-move-direct-root-base-path array)
    [(TcMaybeString.Some base)
      (match (tc-move-literal-index index-expr)
        [(TcMoveMaybeIndex.Some index)
          (TcMaybeString.Some (tc-move-array-index-path base index))]
        [(TcMoveMaybeIndex.No) (TcMaybeString.No)])]
    [(TcMaybeString.No) (TcMaybeString.No)]))

(define (tc-move-struct-set-path [receiver : AstExpr] [field : String]) : TcMaybeString
  (match (tc-move-direct-root-base-path receiver)
    [(TcMaybeString.Some base)
      (TcMaybeString.Some (tc-move-path-append base field))]
    [(TcMaybeString.No) (TcMaybeString.No)]))

(define (tc-move-reinitialize-array-set-path
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [array : AstExpr]
  [index : AstExpr]) : TcMovedSet
  (match (tc-move-array-set-path array index)
    [(TcMaybeString.Some path)
      (match (tc-move-root-projection-var array)
        [(TcMaybeString.Some root)
          (if (tc-moved-contains? locals root)
            (tc-moved-remove-exact-path moved root path)
            moved)]
        [(TcMaybeString.No) moved])]
    [(TcMaybeString.No) moved]))

(define (tc-move-reinitialize-struct-set-path
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [receiver : AstExpr]
  [field : String]) : TcMovedSet
  (match (tc-move-struct-set-path receiver field)
    [(TcMaybeString.Some path)
      (match (tc-move-root-projection-var receiver)
        [(TcMaybeString.Some root)
          (if (tc-moved-contains? locals root)
            (tc-moved-remove-exact-path moved root path)
            moved)]
        [(TcMaybeString.No) moved])]
    [(TcMaybeString.No) moved]))

(define (tc-move-projection-path [expr : AstExpr]) : TcMaybeString
  (match (tc-move-struct-field-path expr)
    [(TcMaybeString.Some path) (TcMaybeString.Some path)]
    [(TcMaybeString.No)
      (match (tc-move-tuple-element-path expr)
        [(TcMaybeString.Some path) (TcMaybeString.Some path)]
        [(TcMaybeString.No) (tc-move-array-element-path expr)])]))

(define (tc-moved-add-projection-path
  [moved : TcMovedSet]
  [root : String]
  [path : String]
  [origin : AstExpr]) : TcMovedSet
  (let
    [origin-id : i64 (ast-node-push origin)]
    (tc-moved-add-value
      (tc-moved-add-value moved (tc-moved-path-key path) origin-id)
      (tc-moved-partial-key root)
      origin-id)))

(define (tc-move-box-projection? [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-box-projection? inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-box-projection? inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-box-projection? inner))]
    [(AstExpr.StructGet inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-box-projection? inner))]
    [(AstExpr.TupleRef inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-box-projection? inner))]
    [(AstExpr.ArrayRef array-box _)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (tc-move-box-projection? array))]
    [(AstExpr.BoxGet _) true]
    [_ false]))

(define (tc-move-dynamic-array-element-projection?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-dynamic-array-element-projection? ctx env inner))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-dynamic-array-element-projection? ctx env inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-dynamic-array-element-projection? ctx env inner))]
    [(AstExpr.StructGet inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-dynamic-array-element-projection? ctx env inner))]
    [(AstExpr.TupleRef inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-dynamic-array-element-projection? ctx env inner))]
    [(AstExpr.ArrayRef array-box _)
      (let
        [array : AstExpr (ast-node-get array-box)]
        (match (tc-expr ctx env array)
          [(ResultTcType.Ok array-ty)
            (match (tc-type-strip-region (tc-resolve-type ctx array-ty))
              [(AstType.DynArray _) true]
              [_ (tc-move-dynamic-array-element-projection? ctx env array)])]
          [(ResultTcType.Err _)
            (tc-move-dynamic-array-element-projection? ctx env array)]))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-dynamic-array-element-projection? ctx env inner))]
    [_ false]))

(define (tc-move-binding-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [maybe-ty : AstMaybeType]
  [init : AstExpr]) : AstType
  (match maybe-ty
    [(AstMaybeType.Some t)
      (let
        [resolved : AstType (tc-resolve-type ctx t)]
        (match (tc-expr-with-expected-or-actual ctx env init resolved)
          [(ResultTcType.Ok init-ty)
            (if (tc-type-contains-any-region init-ty)
              init-ty
              resolved)]
          [(ResultTcType.Err _) resolved]))]
    [(AstMaybeType.No)
      (match (tc-expr ctx env init)
        [(ResultTcType.Ok t) t]
        [(ResultTcType.Err _) (AstType.I64)])]))

;; The names that are genuine local/parameter bindings, seeded from a function's
;; parameter list. Only these are tracked as movable places; enum constructors,
;; globals, and function references share the variable syntax but are never moved.
(define (tc-move-params-locals [params : AstParamList] [acc : TcMovedSet]) : TcMovedSet
  (tc-move-params-locals-at (& params) 0 acc))

(define (tc-move-params-locals-at
  [params : (& params AstParamList)]
  [index : i64]
  [acc : TcMovedSet]) : TcMovedSet
  (if (>= index (ast-param-list-len params))
    acc
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param name _ _)
        (tc-move-params-locals-at
          params
          (+ index 1)
          (tc-moved-add acc (intern-str name)))])))

(define (tc-move-after-consuming-projection
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : AstExpr]) : TcMoveResult
  (if (tc-move-dynamic-array-element-projection? ctx env expr)
    (TcMoveResult.Err (tc-move-dynamic-array-element-message))
    (if (tc-move-box-projection? expr)
      (TcMoveResult.Err (tc-move-box-projection-message))
      (match (tc-move-projection-path expr)
        [(TcMaybeString.Some path)
          (match (tc-move-root-projection-var expr)
            [(TcMaybeString.Some root)
              (if (tc-moved-contains? locals root)
                (match (tc-moved-path-conflict moved path)
                  [(TcMoveConflict.Some key origin-id)
                    (tc-move-rich-use-conflict-result
                      (TcMoveConflict.Some key origin-id)
                      (tc-moved-path-key path)
                      expr
                      path)]
                  [TcMoveConflict.No
                    (TcMoveResult.Ok
                      (tc-moved-add-projection-path moved root path expr))])
                (TcMoveResult.Ok moved))]
            [(TcMaybeString.No) (TcMoveResult.Ok moved)])]
        [(TcMaybeString.No)
          (if (tc-move-aggregate-path-projection? expr)
            (TcMoveResult.Err (tc-move-aggregate-path-message))
            (match (tc-move-root-projection-var expr)
              [(TcMaybeString.Some root)
                (if (tc-moved-contains? locals root)
                  (if (tc-moved-partial? moved root)
                    (tc-move-rich-use-conflict-result
                      (tc-moved-root-conflict moved root)
                      root
                      expr
                      root)
                    (if (tc-moved-contains? loop-carried root)
                      (tc-move-rich-loop-carried-result root expr)
                      (TcMoveResult.Ok (tc-moved-add-origin moved root expr))))
                  (TcMoveResult.Ok moved))]
              [(TcMaybeString.No) (TcMoveResult.Ok moved)]))]))))

(define (tc-move-after-bind-typed
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [init : AstExpr]
  [init-ty : AstType]) : TcMoveResult
  (if (tc-type-consuming-by-value-now? ctx init-ty)
    (tc-move-after-consuming-projection ctx env locals loop-carried moved init)
    (TcMoveResult.Ok moved)))

;; Mark the source variable moved when an init/rhs is a bare move-only variable
;; that names a tracked local/parameter (not an enum constructor or global).
(define (tc-move-after-bind
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [init : AstExpr]) : TcMoveResult
  (match (tc-move-bare-var init)
    [(TcMaybeString.Some v)
      (if (and (tc-moved-contains? locals v) (tc-move-var-move-only? env v))
        (if (tc-moved-partial? moved v)
          (tc-move-rich-use-conflict-result
            (tc-moved-root-conflict moved v)
            v
            init
            v)
          (if (tc-moved-contains? loop-carried v)
            (tc-move-rich-loop-carried-result v init)
            (TcMoveResult.Ok (tc-moved-add-origin moved v init))))
        (TcMoveResult.Ok moved))]
    [(TcMaybeString.No)
      (match (cfg
        compile-profile
        (compiler-tc-reinfer-profile-expr "move.bind_init" ctx env init)
        (tc-expr ctx env init))
        [(ResultTcType.Ok init-ty)
          (tc-move-after-bind-typed
            ctx
            env
            locals
            loop-carried
            moved
            init
            init-ty)]
        [(ResultTcType.Err _) (TcMoveResult.Ok moved)])]))

(define (tc-move-after-bind-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [init-id : i64]) : TcMoveResult
  (let
    [init : AstExpr (ast-node-get init-id)]
    (match (tc-move-bare-var init)
      [(TcMaybeString.Some v)
        (if (and (tc-moved-contains? locals v) (tc-move-var-move-only? env v))
          (if (tc-moved-partial? moved v)
            (tc-move-rich-use-conflict-result
              (tc-moved-root-conflict moved v)
              v
              init
              v)
            (if (tc-moved-contains? loop-carried v)
              (tc-move-rich-loop-carried-result v init)
              (TcMoveResult.Ok (tc-moved-add-origin moved v init))))
          (TcMoveResult.Ok moved))]
      [(TcMaybeString.No)
        (match (tc-body-type-fact-expr-id "move.bind_init" ctx env init-id)
          [(ResultTcType.Ok init-ty)
            (tc-move-after-bind-typed
              ctx
              env
              locals
              loop-carried
              moved
              init
              init-ty)]
          [(ResultTcType.Err _) (TcMoveResult.Ok moved)])])))

(define (tc-move-after-bind-known-type-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [init-id : i64]
  [init-ty : AstType]) : TcMoveResult
  (let
    [init : AstExpr (ast-node-get init-id)]
    (match (tc-move-bare-var init)
      [(TcMaybeString.Some v)
        (if (and (tc-moved-contains? locals v) (tc-move-var-move-only? env v))
          (if (tc-moved-partial? moved v)
            (tc-move-rich-use-conflict-result
              (tc-moved-root-conflict moved v)
              v
              init
              v)
            (if (tc-moved-contains? loop-carried v)
              (tc-move-rich-loop-carried-result v init)
              (TcMoveResult.Ok (tc-moved-add-origin moved v init))))
          (TcMoveResult.Ok moved))]
      [(TcMaybeString.No)
        (tc-move-after-bind-typed
          ctx
          env
          locals
          loop-carried
          moved
          init
          init-ty)])))

(define (tc-move-after-moving-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : AstExpr]
  [move? : bool]) : TcMoveResult
  (if move?
    (tc-move-after-consuming-projection ctx env locals loop-carried moved expr)
    (TcMoveResult.Ok moved)))

(define (tc-move-after-consuming-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : AstExpr]
  [target-ty : AstType]) : TcMoveResult
  (tc-move-after-moving-value
    ctx
    env
    locals
    loop-carried
    moved
    expr
    (tc-type-consuming-by-value-now? ctx target-ty)))

(define (tc-move-after-move-only-value
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : AstExpr]
  [target-ty : AstType]) : TcMoveResult
  (tc-move-after-moving-value
    ctx
    env
    locals
    loop-carried
    moved
    expr
    (tc-type-move-only? (tc-resolve-type ctx target-ty))))

(define (tc-move-after-match-scrutinee
  [ctx : TcContext]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [expr : AstExpr]
  [scrut-ty : AstType]) : TcMovedSet
  (match (tc-move-bare-var expr)
    [(TcMaybeString.Some v)
      (if (and
        (tc-moved-contains? locals v)
        (tc-type-consuming-match-scrutinee-now? ctx scrut-ty))
        (tc-moved-add-origin moved v expr)
        moved)]
    [(TcMaybeString.No) moved]))

(define (tc-move-consume-local
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [name : String]
  [origin : AstExpr]) : TcMoveResult
  (if (tc-moved-contains? locals name)
    (if (or (tc-moved-contains? moved name) (tc-moved-partial? moved name))
      (tc-move-rich-use-conflict-result
        (tc-moved-root-conflict moved name)
        name
        origin
        name)
      (if (tc-moved-contains? loop-carried name)
        (tc-move-rich-loop-carried-result name origin)
        (TcMoveResult.Ok (tc-moved-add-origin moved name origin))))
    (TcMoveResult.Ok moved)))

(define (tc-move-invalidate-local
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [name : String]
  [origin : AstExpr]) : TcMoveResult
  (cond
    [(not (tc-moved-contains? locals name)) (TcMoveResult.Ok moved)]
    [(tc-moved-contains? moved name) (TcMoveResult.Ok moved)]
    [(tc-moved-partial? moved name)
      (tc-move-rich-use-conflict-result
        (tc-moved-root-conflict moved name)
        name
        origin
        name)]
    [(tc-moved-contains? loop-carried name)
      (tc-move-rich-loop-carried-result name origin)]
    [else (TcMoveResult.Ok (tc-moved-add-origin moved name origin))]))

(define (tc-move-mark-region-locals-scan
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [region : String]
  [seen : TcStringList]
  [remaining : i64]
  [origin : AstExpr]) : TcMoveResult
  (if (<= remaining 0)
    (TcMoveResult.Ok moved)
    (match env
      [(TcTypeEnv.Nil) (TcMoveResult.Ok moved)]
      [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
        (if scan-through
          (tc-move-mark-region-locals-scan
            (box-get rest)
            locals
            loop-carried
            moved
            region
            seen
            remaining
            origin)
          (TcMoveResult.Ok moved))]
      [(TcTypeEnv.Bind key ty rest)
        (let
          [rest-env : TcTypeEnv (box-get rest)]
          [name : String (intern-str key)]
          (cond
            [(= key (tc-default-boundary-id)) (TcMoveResult.Ok moved)]
            [(tc-string-list-contains seen name)
              (tc-move-mark-region-locals-scan
                rest-env
                locals
                loop-carried
                moved
                region
                seen
                remaining
                origin)]
            [(not (tc-moved-contains? locals name))
              (tc-move-mark-region-locals-scan
                rest-env
                locals
                loop-carried
                moved
                region
                (tc-string-list-add seen name)
                remaining
                origin)]
            [(tc-type-contains-region ty region)
              (match (tc-move-invalidate-local
                locals
                loop-carried
                moved
                name
                origin)
                [(TcMoveResult.Ok moved2)
                  (tc-move-mark-region-locals-scan
                    rest-env
                    locals
                    loop-carried
                    moved2
                    region
                    (tc-string-list-add seen name)
                    (- remaining 1)
                    origin)]
                [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
            [else
              (tc-move-mark-region-locals-scan
                rest-env
                locals
                loop-carried
                moved
                region
                (tc-string-list-add seen name)
                (- remaining 1)
                origin)]))])))

(define (tc-move-mark-region-locals
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [region : String]
  [origin : AstExpr]) : TcMoveResult
  (tc-move-mark-region-locals-scan
    env
    locals
    loop-carried
    moved
    region
    TcStringList.Nil
    (tc-moved-len locals)
    origin))

(define (tc-move-mark-owner-region-locals-scan
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [owner : String]
  [seen : TcStringList]
  [remaining : i64]
  [origin : AstExpr]) : TcMoveResult
  (if (<= remaining 0)
    (TcMoveResult.Ok moved)
    (match env
      [(TcTypeEnv.Nil) (TcMoveResult.Ok moved)]
      [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
        (if scan-through
          (tc-move-mark-owner-region-locals-scan
            (box-get rest)
            locals
            loop-carried
            moved
            owner
            seen
            remaining
            origin)
          (TcMoveResult.Ok moved))]
      [(TcTypeEnv.Bind key ty rest)
        (let
          [rest-env : TcTypeEnv (box-get rest)]
          [name : String (intern-str key)]
          (cond
            [(= key (tc-default-boundary-id)) (TcMoveResult.Ok moved)]
            [(tc-string-list-contains seen name)
              (tc-move-mark-owner-region-locals-scan
                rest-env
                locals
                loop-carried
                moved
                owner
                seen
                remaining
                origin)]
            [(not (tc-moved-contains? locals name))
              (tc-move-mark-owner-region-locals-scan
                rest-env
                locals
                loop-carried
                moved
                owner
                (tc-string-list-add seen name)
                remaining
                origin)]
            [(tc-type-contains-arena-owner-region? ty owner)
              (match (tc-move-invalidate-local
                locals
                loop-carried
                moved
                name
                origin)
                [(TcMoveResult.Ok moved2)
                  (tc-move-mark-owner-region-locals-scan
                    rest-env
                    locals
                    loop-carried
                    moved2
                    owner
                    (tc-string-list-add seen name)
                    (- remaining 1)
                    origin)]
                [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
            [else
              (tc-move-mark-owner-region-locals-scan
                rest-env
                locals
                loop-carried
                moved
                owner
                (tc-string-list-add seen name)
                (- remaining 1)
                origin)]))])))

(define (tc-move-mark-owner-region-locals
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [owner : String]
  [origin : AstExpr]) : TcMoveResult
  (tc-move-mark-owner-region-locals-scan
    env
    locals
    loop-carried
    moved
    owner
    TcStringList.Nil
    (tc-moved-len locals)
    origin))

(define (tc-atomic-arena-hidden-user-key [owner : String]) : String
  (str_cat.str-cat "\natomic-arena-hidden-user:" owner))

(define (tc-move-mark-hidden-atomic-arena-users
  [moved : TcMovedSet]
  [owners : TcStringList]) : TcMovedSet
  (match owners
    [(TcStringList.Nil) moved]
    [(TcStringList.Cons owner rest)
      (tc-move-mark-hidden-atomic-arena-users
        (tc-moved-add moved (tc-atomic-arena-hidden-user-key owner))
        (box-get rest))]))

(define (tc-move-atomic-arena-hidden-user-message [owner : String]) : String
  (str_cat.str-cat
    "typecheck: arena.destroy-safe!/rewind-safe! cannot prove atomic arena `"
    owner
    "` is released after an owner-tagged value was sent to a channel"))

(define (tc-move-check-atomic-arena-hidden-users-released
  [moved : TcMovedSet]
  [owner : String]) : TcMoveResult
  (if (tc-moved-contains? moved (tc-atomic-arena-hidden-user-key owner))
    (TcMoveResult.Err (tc-move-atomic-arena-hidden-user-message owner))
    (TcMoveResult.Ok moved)))

(define (tc-move-atomic-arena-live-user-message
  [owner : String]
  [name : String]) : String
  (str_cat.str-cat
    "typecheck: arena.destroy-safe!/rewind-safe! requires atomic arena user `"
    name
    "` to be joined or released before invalidating `"
    owner
    "`"))

(define (tc-move-check-atomic-arena-users-released-scan
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [owner : String]
  [seen : TcStringList]
  [remaining : i64]) : TcMoveResult
  (if (<= remaining 0)
    (TcMoveResult.Ok moved)
    (match env
      [(TcTypeEnv.Nil) (TcMoveResult.Ok moved)]
      [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
        (if scan-through
          (tc-move-check-atomic-arena-users-released-scan
            ctx
            (box-get rest)
            locals
            moved
            owner
            seen
            remaining)
          (TcMoveResult.Ok moved))]
      [(TcTypeEnv.Bind key ty rest)
        (let
          [rest-env : TcTypeEnv (box-get rest)]
          [name : String (intern-str key)]
          (cond
            [(= key (tc-default-boundary-id)) (TcMoveResult.Ok moved)]
            [(tc-string-list-contains seen name)
              (tc-move-check-atomic-arena-users-released-scan
                ctx
                rest-env
                locals
                moved
                owner
                seen
                remaining)]
            [(not (tc-moved-contains? locals name))
              (tc-move-check-atomic-arena-users-released-scan
                ctx
                rest-env
                locals
                moved
                owner
                (tc-string-list-add seen name)
                remaining)]
            [(and
                (tc-type-contains-arena-owner-region? ty owner)
                (tc-thread-safe-user-type? ctx ty)
                (not (tc-moved-contains? moved name)))
              (TcMoveResult.Err
                (tc-move-atomic-arena-live-user-message owner name))]
            [else
              (tc-move-check-atomic-arena-users-released-scan
                ctx
                rest-env
                locals
                moved
                owner
                (tc-string-list-add seen name)
                (- remaining 1))]))])))

(define (tc-move-check-atomic-arena-users-released
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [moved : TcMovedSet]
  [owner : String]) : TcMoveResult
  (match (tc-move-check-atomic-arena-hidden-users-released moved owner)
    [(TcMoveResult.Ok moved1)
      (tc-move-check-atomic-arena-users-released-scan
        ctx
        env
        locals
        moved1
        owner
        TcStringList.Nil
        (tc-moved-len locals))]
    [(TcMoveResult.Err message) (TcMoveResult.Err message)]))

(define (tc-move-safe-arena-rewind-effect
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [args : AstExprList]
  [origin : AstExpr]) : TcMoveResult
  (if (ast-expr-list-empty? (& args))
    (TcMoveResult.Ok moved)
    (let
      [phase-box : i64 (ast-expr-list-get (& args) 0 0)]
      [phase-expr : AstExpr (ast-node-get phase-box)]
      (match (tc-expr-var-name phase-expr)
        [(TcMaybeString.Some phase)
          (match (tc-arena-phase-token-region-active env phase)
            [(TcMaybeString.Some region)
              (match (tc-arena-phase-token-owner-active env phase)
                [(TcMaybeString.Some owner)
                  (match (if (tc-atomic-arena-owner-active? env owner)
                    (tc-move-check-atomic-arena-users-released
                      ctx
                      env
                      locals
                      moved
                      owner)
                    (TcMoveResult.Ok moved))
                    [(TcMoveResult.Ok moved1)
                      (match (tc-move-consume-local
                        locals
                        loop-carried
                        moved1
                        phase
                        origin)
                        [(TcMoveResult.Ok moved2)
                          (tc-move-mark-region-locals
                            env
                            locals
                            loop-carried
                            moved2
                            region
                            origin)]
                        [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
                    [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
                [(TcMaybeString.No)
                  (match (tc-move-consume-local
                    locals
                    loop-carried
                    moved
                    phase
                    origin)
                    [(TcMoveResult.Ok moved2)
                      (tc-move-mark-region-locals
                        env
                        locals
                        loop-carried
                        moved2
                        region
                        origin)]
                    [(TcMoveResult.Err message) (TcMoveResult.Err message)])])]
            [(TcMaybeString.No) (TcMoveResult.Ok moved)])]
        [(TcMaybeString.No) (TcMoveResult.Ok moved)]))))

(define (tc-move-safe-arena-destroy-effect
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [args : AstExprList]
  [origin : AstExpr]) : TcMoveResult
  (if (ast-expr-list-empty? (& args))
    (TcMoveResult.Ok moved)
    (let
      [owner-box : i64 (ast-expr-list-get (& args) 0 0)]
      [owner-expr : AstExpr (ast-node-get owner-box)]
      (match (tc-expr-var-name owner-expr)
        [(TcMaybeString.Some owner)
          (if (or
            (tc-ordinary-arena-owner-active? env owner)
            (tc-atomic-arena-owner-active? env owner))
            (match (if (tc-atomic-arena-owner-active? env owner)
              (tc-move-check-atomic-arena-users-released
                ctx
                env
                locals
                moved
                owner)
              (TcMoveResult.Ok moved))
              [(TcMoveResult.Ok moved1)
                (match (tc-move-consume-local
                  locals
                  loop-carried
                  moved1
                  owner
                  origin)
                  [(TcMoveResult.Ok moved2)
                    (tc-move-mark-owner-region-locals
                      env
                      locals
                      loop-carried
                      moved2
                      owner
                      origin)]
                  [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
              [(TcMoveResult.Err message) (TcMoveResult.Err message)])
            (TcMoveResult.Ok moved))]
        [(TcMaybeString.No) (TcMoveResult.Ok moved)]))))

(define (tc-move-check-safe-arena-call-effects
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [func : AstExpr]
  [args : AstExprList]
  [origin : AstExpr]) : TcMoveResult
  (match (tc-expr-var-name func)
    [(TcMaybeString.Some raw-name)
      (let
        [name : String (tc-hygiene-global-symbol-name raw-name)]
        (cond
          [(tc-arena-safe-call-name? ctx env name "rewind-safe!")
            (tc-move-safe-arena-rewind-effect
              ctx
              env
              locals
              loop-carried
              moved
              args
              origin)]
          [(tc-arena-safe-call-name? ctx env name "destroy-safe!")
            (tc-move-safe-arena-destroy-effect
              ctx
              env
              locals
              loop-carried
              moved
              args
              origin)]
          [else (TcMoveResult.Ok moved)]))]
    [(TcMaybeString.No) (TcMoveResult.Ok moved)]))

(define (tc-move-check-lambda-owner-captures-scan
  [ctx : TcContext]
  [root : TcTypeEnv]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [bound : TcStringList]
  [seen : TcStringList]
  [remaining : i64]
  [body : AstExpr]) : TcMoveResult
  (if (<= remaining 0)
    (TcMoveResult.Ok moved)
    (match env
      [(TcTypeEnv.Nil) (TcMoveResult.Ok moved)]
      [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
        (if scan-through
          (tc-move-check-lambda-owner-captures-scan
            ctx
            root
            (box-get rest)
            locals
            loop-carried
            moved
            bound
            seen
            remaining
            body)
          (TcMoveResult.Ok moved))]
      [(TcTypeEnv.Bind key ty rest)
        (let
          [rest-env : TcTypeEnv (box-get rest)]
          [name : String (intern-str key)]
          (cond
            [(= key (tc-default-boundary-id)) (TcMoveResult.Ok moved)]
            [(or
                (= key (tc-region-marker-id))
                (tc-cleanup-owner-marker-entry? key ty))
              (tc-move-check-lambda-owner-captures-scan
                ctx
                root
                rest-env
                locals
                loop-carried
                moved
                bound
                seen
                remaining
                body)]
            [(tc-string-list-contains seen name)
              (tc-move-check-lambda-owner-captures-scan
                ctx
                root
                rest-env
                locals
                loop-carried
                moved
                bound
                seen
                remaining
                body)]
            [(not (tc-moved-contains? locals name))
              (tc-move-check-lambda-owner-captures-scan
                ctx
                root
                rest-env
                locals
                loop-carried
                moved
                bound
                seen
                remaining
                body)]
            [(not (tc-expr-uses-free-name? body name bound))
              (tc-move-check-lambda-owner-captures-scan
                ctx
                root
                rest-env
                locals
                loop-carried
                moved
                bound
                (tc-string-list-add seen name)
                (- remaining 1)
                body)]
            [else
              (match (tc-lookup-id root key)
                [(ResultTcType.Ok visible-ty)
                  (if (tc-type-consuming-by-value-now? ctx visible-ty)
                    (if (or
                      (tc-moved-contains? moved name)
                      (tc-moved-partial? moved name))
                      (tc-move-rich-use-conflict-result
                        (tc-moved-root-conflict moved name)
                        name
                        body
                        name)
                      (if (tc-moved-contains? loop-carried name)
                        (tc-move-rich-loop-carried-result name body)
                        (tc-move-check-lambda-owner-captures-scan
                          ctx
                          root
                          rest-env
                          locals
                          loop-carried
                          (tc-moved-add-origin moved name body)
                          bound
                          (tc-string-list-add seen name)
                          (- remaining 1)
                          body)))
                    (tc-move-check-lambda-owner-captures-scan
                      ctx
                      root
                      rest-env
                      locals
                      loop-carried
                      moved
                      bound
                      (tc-string-list-add seen name)
                      (- remaining 1)
                      body))]
                [(ResultTcType.Err _)
                  (tc-move-check-lambda-owner-captures-scan
                    ctx
                    root
                    rest-env
                    locals
                    loop-carried
                    moved
                    bound
                    (tc-string-list-add seen name)
                    (- remaining 1)
                    body)])]))])))

(define (tc-move-check-lambda-owner-captures
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [params : AstParamList]
  [body : AstExpr]) : TcMoveResult
  (tc-move-check-lambda-owner-captures-scan
    ctx
    env
    env
    locals
    loop-carried
    moved
    (tc-param-bound-names params)
    TcStringList.Nil
    (tc-moved-len locals)
    body))

(define (tc-move-check-exprs-with-types-no-auto
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : AstExprList]
  [types : AstTypeList]) : TcMoveResult
  (tc-move-check-exprs-with-types-no-auto-at
    ctx
    env
    locals
    loop-carried
    moved
    (& exprs)
    (& types)
    0))

(define (tc-move-check-exprs-with-types-no-auto-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : (& exprs AstExprList)]
  [types : (& types AstTypeList)]
  [index : i64]) : TcMoveResult
  (if (>= index (struct-get exprs len))
    (if (>= index (ast-type-list-len types))
      (TcMoveResult.Ok moved)
      (TcMoveResult.Err "typecheck: arity mismatch"))
    (if (>= index (ast-type-list-len types))
      (TcMoveResult.Err "typecheck: arity mismatch")
      (let
        [head : i64 (ast-expr-list-get exprs index 0)]
        [head-expr : AstExpr (ast-node-get head)]
        [ty : AstType
          (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))]
        (match (tc-move-check-expr-id ctx env locals loop-carried moved head)
          [(TcMoveResult.Ok moved1)
            (match (tc-move-after-consuming-value
              ctx
              env
              locals
              loop-carried
              moved1
              head-expr
              ty)
              [(TcMoveResult.Ok moved2)
                (tc-move-check-exprs-with-types-no-auto-at
                  ctx
                  env
                  locals
                  loop-carried
                  moved2
                  exprs
                  types
                  (+ index 1))]
              [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)])))))

(define (tc-move-check-exprs-with-types-auto
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : AstExprList]
  [types : AstTypeList]) : TcMoveResult
  (tc-move-check-exprs-with-types-auto-at
    ctx
    env
    locals
    loop-carried
    moved
    (& exprs)
    (& types)
    0))

(define (tc-move-check-exprs-with-types-auto-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : (& exprs AstExprList)]
  [types : (& types AstTypeList)]
  [index : i64]) : TcMoveResult
  (if (>= index (struct-get exprs len))
    (if (>= index (ast-type-list-len types))
      (TcMoveResult.Ok moved)
      (TcMoveResult.Err "typecheck: arity mismatch"))
    (if (>= index (ast-type-list-len types))
      (TcMoveResult.Err "typecheck: arity mismatch")
      (let
        [head : i64 (ast-expr-list-get exprs index 0)]
        [head-expr : AstExpr (ast-node-get head)]
        [ty : AstType
          (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))]
        (match (cfg
          compile-profile
          (compiler-tc-reinfer-profile-effective-arg-expr
            "move.call_arg"
            ctx
            env
            head-expr
            ty)
          (tc-call-effective-arg-expr ctx env head-expr ty))
          [(ResultTcExpr.Ok effective-head)
            (match (tc-move-check-expr
              ctx
              env
              locals
              loop-carried
              moved
              effective-head)
              [(TcMoveResult.Ok moved1)
                (match (tc-move-after-consuming-value
                  ctx
                  env
                  locals
                  loop-carried
                  moved1
                  effective-head
                  ty)
                  [(TcMoveResult.Ok moved2)
                    (tc-move-check-exprs-with-types-auto-at
                      ctx
                      env
                      locals
                      loop-carried
                      moved2
                      exprs
                      types
                      (+ index 1))]
                  [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
              [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
          [(ResultTcExpr.Err message) (TcMoveResult.Err message)])))))

(define (tc-move-check-exprs-with-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : AstExprList]
  [types : AstTypeList]) : TcMoveResult
  (if (tc-call-type-list-has-immutable-ref-formal? ctx types)
    (tc-move-check-exprs-with-types-auto
      ctx
      env
      locals
      loop-carried
      moved
      exprs
      types)
    (tc-move-check-exprs-with-types-no-auto
      ctx
      env
      locals
      loop-carried
      moved
      exprs
      types)))

(define (tc-move-check-thread-channel-send-message
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]) : TcMoveResult
  (if (tc-thread-channel-send-call? ctx env func)
    (match (tc-thread-channel-send-call-name func)
      [(TcMaybeString.Some _)
        (match (tc-thread-channel-send-message-param params)
          [(ResultTcType.Ok message-ty)
            (match (tc-thread-channel-send-message-arg args)
              [(ResultTcExpr.Ok message-expr)
                (match (tc-move-after-move-only-value
                  ctx
                  env
                  locals
                  loop-carried
                  moved
                  message-expr
                  message-ty)
                  [(TcMoveResult.Ok moved2)
                    (TcMoveResult.Ok
                      (tc-move-mark-hidden-atomic-arena-users
                        moved2
                        (match (tc-expr ctx env message-expr)
                          [(ResultTcType.Ok actual-message-ty)
                            (tc-type-atomic-arena-owner-regions
                              env
                              actual-message-ty)]
                          [(ResultTcType.Err _)
                            (tc-type-atomic-arena-owner-regions env message-ty)])))]
                  [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
              [(ResultTcExpr.Err message) (TcMoveResult.Err message)])]
          [(ResultTcType.Err message) (TcMoveResult.Err message)])]
      [(TcMaybeString.No) (TcMoveResult.Ok moved)])
    (TcMoveResult.Ok moved)))

(define (tc-move-check-call-args-with-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [call-expr : AstExpr]
  [func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]) : TcMoveResult
  (match (tc-move-check-exprs-with-types
    ctx
    env
    locals
    loop-carried
    moved
    args
    params)
    [(TcMoveResult.Ok moved-args)
      (match (tc-move-check-thread-channel-send-message
        ctx
        env
        locals
        loop-carried
        moved-args
        func
        args
        params)
        [(TcMoveResult.Ok moved-thread)
          (tc-move-check-safe-arena-call-effects
            ctx
            env
            locals
            loop-carried
            moved-thread
            func
            args
            call-expr)]
        [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
    [(TcMoveResult.Err message) (TcMoveResult.Err message)]))

(define (tc-move-call-param-types-from-type [fn-ty : AstType]) : ResultTcTypeList
  (match (tc-type-strip-region fn-ty)
    [(AstType.Func params _) (ResultTcTypeList.Ok (box-get params))]
    [(AstType.Enum _) (ResultTcTypeList.Ok (ast-type-list-new))]
    [(AstType.EnumArgs _ _) (ResultTcTypeList.Ok (ast-type-list-new))]
    [_ (ResultTcTypeList.Err "typecheck: call target is not a function")]))

(define (tc-borrow-call-return-lifetimes-from-function
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]
  [ret : AstType]) : TcBorrowCallReturnLifetimes
  (if (tc-call-lifetime-constructor-for-func? ctx func ret)
    (TcBorrowCallReturnLifetimes.Fallback)
    (match (tc-call-constructor-target-for-func ctx env func params ret)
      [(AstMaybeType.Some _) (TcBorrowCallReturnLifetimes.Fallback)]
      [(AstMaybeType.No)
        (let
          [lifetimes : AstLifetimeList (tc-call-function-lifetimes params ret)]
          (if (ast-lifetime-list-empty? (& lifetimes))
            (TcBorrowCallReturnLifetimes.Known
              (tc-type-collect-reference-lifetimes (tc-resolve-type ctx ret)))
            (match (tc-infer-call-lifetime-subst
              ctx
              env
              args
              params
              lifetimes
              TcLifetimeSubst.Nil)
              [(ResultTcLifetimeSubst.Ok subst)
                (TcBorrowCallReturnLifetimes.Known
                  (tc-type-collect-reference-lifetimes
                    (tc-resolve-type ctx (tc-lifetime-subst-type subst ret))))]
              [(ResultTcLifetimeSubst.Err _)
                (TcBorrowCallReturnLifetimes.Fallback)])))])))

(define (tc-borrow-call-info-from-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]
  [args : AstExprList]
  [fn-ty : AstType]) : ResultTcBorrowCallInfo
  (match (tc-type-strip-region fn-ty)
    [(AstType.Func params ret)
      (let
        [params-list : AstTypeList (box-get params)]
        [ret-ty : AstType (ty-node-get ret)]
        (ResultTcBorrowCallInfo.Ok
          params-list
          (tc-borrow-call-return-lifetimes-from-function
            ctx
            env
            func
            args
            params-list
            ret-ty)))]
    [(AstType.Enum _)
      (ResultTcBorrowCallInfo.Ok
        (ast-type-list-new)
        (TcBorrowCallReturnLifetimes.Fallback))]
    [(AstType.EnumArgs _ _)
      (ResultTcBorrowCallInfo.Ok
        (ast-type-list-new)
        (TcBorrowCallReturnLifetimes.Fallback))]
    [_ (ResultTcBorrowCallInfo.Err "typecheck: call target is not a function")]))

(define (tc-borrow-call-info-id-raw
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]
  [args : AstExprList]) : ResultTcBorrowCallInfo
  (let
    [func : AstExpr (ast-node-get func-id)]
    (match (tc-expr-id ctx env func-id)
      [(ResultTcType.Ok fn-ty)
        (tc-borrow-call-info-from-type ctx env func args fn-ty)]
      [(ResultTcType.Err message) (ResultTcBorrowCallInfo.Err message)])))

(define (tc-borrow-call-info-id-with-facts
  [site : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]
  [args : AstExprList]) : ResultTcBorrowCallInfo
  (let
    [func : AstExpr (ast-node-get func-id)]
    (match (tc-body-type-fact-lookup-profiled site func-id)
      [(TcBodyTypeFact.Hit fn-ty)
        (tc-borrow-call-info-from-type ctx env func args fn-ty)]
      [(TcBodyTypeFact.Miss)
        (cfg
          compile-profile
          (compiler-tc-reinfer-profile-borrow-call-info-id
            site
            ctx
            env
            func-id
            args)
          (tc-borrow-call-info-id-raw ctx env func-id args))])))

(define (tc-move-call-param-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]) : ResultTcTypeList
  (match (tc-expr ctx env func)
    [(ResultTcType.Ok fn-ty) (tc-move-call-param-types-from-type fn-ty)]
    [(ResultTcType.Err message) (ResultTcTypeList.Err message)]))

(define (tc-move-call-param-types-id-raw
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]) : ResultTcTypeList
  (match (tc-expr-id ctx env func-id)
    [(ResultTcType.Ok fn-ty) (tc-move-call-param-types-from-type fn-ty)]
    [(ResultTcType.Err message) (ResultTcTypeList.Err message)]))

(define (tc-move-call-param-types-id-with-facts
  [site : String]
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]) : ResultTcTypeList
  (match (tc-body-type-fact-lookup-profiled site func-id)
    [(TcBodyTypeFact.Hit fn-ty) (tc-move-call-param-types-from-type fn-ty)]
    [(TcBodyTypeFact.Miss)
      (cfg
        compile-profile
        (compiler-tc-reinfer-profile-call-param-types-id site ctx env func-id)
        (tc-move-call-param-types-id-raw ctx env func-id))]))

(define (tc-move-call-param-types-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func-id : i64]) : ResultTcTypeList
  (tc-move-call-param-types-id-with-facts "move.call_func" ctx env func-id))

(define (tc-move-check-exprs
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : AstExprList]) : TcMoveResult
  (tc-move-check-exprs-at ctx env locals loop-carried moved (& exprs) 0))

(define (tc-move-check-exprs-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : TcMoveResult
  (if (>= index (struct-get exprs len))
    (TcMoveResult.Ok moved)
    (match (tc-move-check-expr-id
      ctx
      env
      locals
      loop-carried
      moved
      (ast-expr-list-get exprs index 0))
      [(TcMoveResult.Ok moved1)
        (tc-move-check-exprs-at
          ctx
          env
          locals
          loop-carried
          moved1
          exprs
          (+ index 1))]
      [(TcMoveResult.Err message) (TcMoveResult.Err message)])))

(define (tc-move-check-let-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [bindings : AstLetBindingList]) : TcMoveBindings
  (tc-move-check-let-bindings-at
    ctx
    env
    locals
    loop-carried
    moved
    (& bindings)
    0))

(define (tc-move-check-let-bindings-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : TcMoveBindings
  (if (>= index (ast-let-binding-list-len bindings))
    (TcMoveBindings.Ok env moved locals loop-carried)
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (match (tc-move-check-expr-id
            ctx
            env
            locals
            loop-carried
            moved
            init-box)
            [(TcMoveResult.Ok moved1)
              (let
                [binding-ty : AstType
                  (tc-move-binding-type-id
                    "move.let_init"
                    ctx
                    env
                    maybe-ty
                    init-box)]
                (match (tc-move-after-bind-known-type-id
                  ctx
                  env
                  locals
                  loop-carried
                  moved1
                  init-box
                  binding-ty)
                  [(TcMoveResult.Ok moved2)
                    (tc-move-check-let-bindings-at
                      ctx
                      (tc-bind-c-abi-fnptr-if-needed-id
                        ctx
                        env
                        name
                        binding-ty
                        init)
                      (tc-moved-add locals (intern-str name))
                      (tc-moved-remove-root-state
                        loop-carried
                        (intern-str name))
                      (tc-moved-remove-root-state moved2 (intern-str name))
                      bindings
                      (+ index 1))]
                  [(TcMoveResult.Err message) (TcMoveBindings.Err message)]))]
            [(TcMoveResult.Err message) (TcMoveBindings.Err message)]))])))

(define (tc-move-check-resource-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [bindings : AstResourceBindingList]) : TcMoveResourceBindings
  (tc-move-check-resource-bindings-at
    ctx
    env
    locals
    loop-carried
    moved
    (& bindings)
    0))

(define (tc-move-check-resource-bindings-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [bindings : (& bindings AstResourceBindingList)]
  [index : i64]) : TcMoveResourceBindings
  (if (>= index (ast-resource-binding-list-len bindings))
    (TcMoveResourceBindings.Ok
      env
      moved
      locals
      loop-carried
      TcMoveCleanupOwners.Nil)
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding name init-box _)
        (let
          [_init : AstExpr (ast-node-get init-box)]
          (match (tc-move-check-expr-id
            ctx
            env
            locals
            loop-carried
            moved
            init-box)
            [(TcMoveResult.Ok moved1)
              (match (tc-move-after-bind-id
                ctx
                env
                locals
                loop-carried
                moved1
                init-box)
                [(TcMoveResult.Ok moved2)
                  (match (tc-body-type-fact-expr-id
                    "move.resource_init"
                    ctx
                    env
                    init-box)
                    [(ResultTcType.Ok init-ty)
                      (match (tc-move-check-resource-bindings-at
                        ctx
                        (tc-bind-id
                          (tc-bind-cleanup-owner env (intern-str name))
                          name
                          (tc-type-without-regions init-ty))
                        (tc-moved-add locals (intern-str name))
                        (tc-moved-remove-root-state
                          loop-carried
                          (intern-str name))
                        (tc-moved-remove-root-state moved2 (intern-str name))
                        bindings
                        (+ index 1))
                        [(TcMoveResourceBindings.Ok
                            env2
                            moved3
                            locals2
                            loop-carried2
                            roots)
                          (TcMoveResourceBindings.Ok
                            env2
                            moved3
                            locals2
                            loop-carried2
                            (TcMoveCleanupOwners.Cons
                              (intern-str name)
                              init-box
                              (box roots)))]
                        [(TcMoveResourceBindings.Err message)
                          (TcMoveResourceBindings.Err message)])]
                    [(ResultTcType.Err message)
                      (TcMoveResourceBindings.Err message)])]
                [(TcMoveResult.Err message)
                  (TcMoveResourceBindings.Err message)])]
            [(TcMoveResult.Err message) (TcMoveResourceBindings.Err message)]))])))

(define (tc-move-check-cleanup-owner-exit
  [moved : TcMovedSet]
  [roots : TcMoveCleanupOwners]
  [scope : AstExpr]) : TcMoveResult
  (match roots
    [(TcMoveCleanupOwners.Nil) (TcMoveResult.Ok moved)]
    [(TcMoveCleanupOwners.Cons name owner-origin-id rest)
      (if (or (tc-moved-contains? moved name) (tc-moved-partial? moved name))
        (TcMoveResult.Err
          (tc-move-rich-cleanup-owner-exit-message
            (tc-moved-root-conflict moved name)
            name
            owner-origin-id
            scope))
        (tc-move-check-cleanup-owner-exit moved (box-get rest) scope))]))

(define (tc-move-add-bound-names [locals : TcMovedSet] [names : TcStringList]) : TcMovedSet
  (match names
    [(TcStringList.Nil) locals]
    [(TcStringList.Cons name rest)
      (tc-move-add-bound-names (tc-moved-add locals name) (box-get rest))]))

(define (tc-move-remove-bound-root-states
  [moved : TcMovedSet]
  [names : TcStringList]) : TcMovedSet
  (match names
    [(TcStringList.Nil) moved]
    [(TcStringList.Cons name rest)
      (tc-move-remove-bound-root-states
        (tc-moved-remove-root-state moved name)
        (box-get rest))]))

(define (tc-move-pattern-bound-names
  [ctx : TcContext]
  [scrut-ty : AstType]
  [pattern : AstPattern]) : TcStringList
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-match-coverage-type ctx scrut-ty)))
    [(AstType.Enum _)
      (match pattern
        [(AstPattern.Variant _ patterns-box)
          (let
            [patterns : AstPatternList (box-get patterns-box)]
            (tc-pattern-list-add-bound-names patterns TcStringList.Nil))]
        [_ TcStringList.Nil])]
    [(AstType.EnumArgs _ _)
      (match pattern
        [(AstPattern.Variant _ patterns-box)
          (let
            [patterns : AstPatternList (box-get patterns-box)]
            (tc-pattern-list-add-bound-names patterns TcStringList.Nil))]
        [_ TcStringList.Nil])]
    [_ (tc-pattern-add-bound-names pattern TcStringList.Nil)]))

;; Each arm is checked from the same post-scrutinee state; results are unioned so
;; a place moved on any arm is considered moved after the match.
(define (tc-move-check-arms
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : TcMoveResult
  (tc-move-check-arms-at ctx env locals loop-carried moved scrut-ty (& arms) 0))

(define (tc-move-check-arms-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [scrut-ty : AstType]
  [arms : (& arms AstMatchArmList)]
  [index : i64]) : TcMoveResult
  (if (>= index (struct-get arms len))
    (TcMoveResult.Ok moved)
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (let
          [body : AstExpr (ast-node-get body-box)]
          [bound : TcStringList
            (tc-move-pattern-bound-names ctx scrut-ty pattern)]
          (match (tc-bind-match-pattern ctx env scrut-ty pattern)
            [(ResultTcEnv.Ok arm-env)
              (match (tc-move-check-expr
                ctx
                arm-env
                (tc-move-add-bound-names (tc-moved-clone locals) bound)
                (tc-move-remove-bound-root-states
                  (tc-moved-clone loop-carried)
                  bound)
                (tc-move-remove-bound-root-states (tc-moved-clone moved) bound)
                body)
                [(TcMoveResult.Ok arm-moved)
                  (let
                    [visible-arm-moved : TcMovedSet
                      (tc-moved-union
                        moved
                        (tc-move-remove-bound-root-states arm-moved bound))]
                    (match (tc-move-check-arms-at
                      ctx
                      env
                      (tc-moved-clone locals)
                      (tc-moved-clone loop-carried)
                      (tc-moved-clone moved)
                      scrut-ty
                      arms
                      (+ index 1))
                      [(TcMoveResult.Ok rest-moved)
                        (TcMoveResult.Ok
                          (tc-moved-union visible-arm-moved rest-moved))]
                      [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
                [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
            [(ResultTcEnv.Err message) (TcMoveResult.Err message)]))])))

(define (tc-move-check-expr-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr-id : i64]) : TcMoveResult
  (tc-move-check-expr ctx env locals loop-carried moved (ast-node-get expr-id)))

(define (tc-move-check-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [loop-carried : TcMovedSet]
  [moved : TcMovedSet]
  [expr : AstExpr]) : TcMoveResult
  (match expr
    [(AstExpr.Spanned inner-box _)
      (tc-move-check-expr-id ctx env locals loop-carried moved inner-box)]
    [(AstExpr.Literal _) (TcMoveResult.Ok moved)]
    [(AstExpr.Var name)
      (let
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-expr-id env name-text)
            [(ResultTcExprId.Ok virtual-id)
              (tc-move-check-expr-id
                ctx
                env
                locals
                loop-carried
                moved
                virtual-id)]
            [(ResultTcExprId.Err message) (TcMoveResult.Err message)])
          (if (tc-moved-contains? moved name-text)
            (tc-move-rich-use-conflict-result
              (tc-moved-conflict moved name-text)
              name-text
              expr
              name-text)
            (TcMoveResult.Ok moved))))]
    [(AstExpr.Binary _ left-box right-box)
      (match (tc-move-check-expr-id ctx env locals loop-carried moved left-box)
        [(TcMoveResult.Ok moved1)
          (tc-move-check-expr-id ctx env locals loop-carried moved1 right-box)]
        [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
    [(AstExpr.Unary _ inner-box)
      (tc-move-check-expr-id ctx env locals loop-carried moved inner-box)]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (match (tc-move-check-expr-id
          ctx
          env
          locals
          loop-carried
          moved
          func-box)
          [(TcMoveResult.Ok moved1)
            (match (tc-move-call-param-types-id-with-facts
              "move.call_func"
              ctx
              env
              func-box)
              [(ResultTcTypeList.Ok params)
                (match (tc-call-extern-abi ctx func)
                  [(TcMaybeExternAbi.Some abi)
                    (if (tc-call-dynamic-c-varargs-abi? abi)
                      (match (tc-call-extern-varargs-params
                        ctx
                        env
                        args
                        params
                        abi)
                        [(ResultTcTypeList.Ok expanded-params)
                          (tc-move-check-call-args-with-types
                            ctx
                            env
                            locals
                            loop-carried
                            moved1
                            expr
                            func
                            args
                            expanded-params)]
                        [(ResultTcTypeList.Err message)
                          (TcMoveResult.Err message)])
                      (tc-move-check-call-args-with-types
                        ctx
                        env
                        locals
                        loop-carried
                        moved1
                        expr
                        func
                        args
                        params))]
                  [(TcMaybeExternAbi.No)
                    (tc-move-check-call-args-with-types
                      ctx
                      env
                      locals
                      loop-carried
                      moved1
                      expr
                      func
                      args
                      params)])]
              [(ResultTcTypeList.Err _)
                (match (tc-move-check-exprs
                  ctx
                  env
                  locals
                  loop-carried
                  moved1
                  args)
                  [(TcMoveResult.Ok moved-args)
                    (tc-move-check-safe-arena-call-effects
                      ctx
                      env
                      locals
                      loop-carried
                      moved-args
                      func
                      args
                      expr)]
                  [(TcMoveResult.Err message) (TcMoveResult.Err message)])])]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.BracketClause items)
      (tc-move-check-exprs ctx env locals loop-carried moved items)]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (match (tc-move-check-expr-id ctx env locals loop-carried moved cond-box)
        [(TcMoveResult.Ok movedc)
          (match (tc-move-check-expr-id
            ctx
            env
            (tc-moved-clone locals)
            (tc-moved-clone loop-carried)
            (tc-moved-clone movedc)
            then-branch-box)
            [(TcMoveResult.Ok movedt)
              (match (tc-move-check-expr-id
                ctx
                env
                (tc-moved-clone locals)
                (tc-moved-clone loop-carried)
                (tc-moved-clone movedc)
                else-branch-box)
                [(TcMoveResult.Ok movede)
                  (TcMoveResult.Ok (tc-moved-union movedt movede))]
                [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
            [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
        [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (match (tc-move-check-let-bindings
            ctx
            env
            (tc-moved-clone locals)
            (tc-moved-clone loop-carried)
            moved
            bindings)
            [(TcMoveBindings.Ok env2 moved2 locals2 loop-carried2)
              (tc-move-check-expr-id
                ctx
                env2
                locals2
                loop-carried2
                moved2
                body-box)]
            [(TcMoveBindings.Err message) (TcMoveResult.Err message)])])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params _ body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            [lambda-env : TcTypeEnv (tc-bind-params ctx env params)]
            [lambda-locals : TcMovedSet
              (tc-move-params-locals params (tc-moved-clone locals))]
            (match (tc-move-check-expr-id
              ctx
              lambda-env
              lambda-locals
              (tc-moved-empty)
              (tc-moved-clone moved)
              body-box)
              [(TcMoveResult.Ok _)
                (tc-move-check-lambda-owner-captures
                  ctx
                  env
                  locals
                  loop-carried
                  moved
                  params
                  body)]
              [(TcMoveResult.Err message) (TcMoveResult.Err message)]))])]
    [(AstExpr.Tuple exprs)
      (match (tc-body-type-fact-expr-list-types "move.tuple_list" ctx env exprs)
        [(ResultTcTypeList.Ok types)
          (tc-move-check-exprs-with-types
            ctx
            env
            locals
            loop-carried
            moved
            exprs
            types)]
        [(ResultTcTypeList.Err _)
          (tc-move-check-exprs ctx env locals loop-carried moved exprs)])]
    [(AstExpr.TupleRef inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved inner)
          [(TcMoveResult.Ok moved1)
            (match (tc-move-tuple-element-path expr)
              [(TcMaybeString.Some path)
                (if (tc-moved-contains? moved1 (tc-moved-path-key path))
                  (tc-move-rich-use-conflict-result
                    (tc-moved-conflict moved1 (tc-moved-path-key path))
                    (tc-moved-path-key path)
                    expr
                    path)
                  (TcMoveResult.Ok moved1))]
              [(TcMaybeString.No) (TcMoveResult.Ok moved1)])]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.Array exprs)
      (match (tc-body-type-fact-expr-list-types "move.array_list" ctx env exprs)
        [(ResultTcTypeList.Ok types)
          (tc-move-check-exprs-with-types
            ctx
            env
            locals
            loop-carried
            moved
            exprs
            types)]
        [(ResultTcTypeList.Err _)
          (tc-move-check-exprs ctx env locals loop-carried moved exprs)])]
    [(AstExpr.MakeArray _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved array)
          [(TcMoveResult.Ok moved1)
            (match (tc-move-check-expr ctx env locals loop-carried moved1 index)
              [(TcMoveResult.Ok moved2)
                (match (tc-move-array-element-path expr)
                  [(TcMaybeString.Some path)
                    (if (tc-moved-contains? moved2 (tc-moved-path-key path))
                      (tc-move-rich-use-conflict-result
                        (tc-moved-conflict moved2 (tc-moved-path-key path))
                        (tc-moved-path-key path)
                        expr
                        path)
                      (TcMoveResult.Ok moved2))]
                  [(TcMaybeString.No) (TcMoveResult.Ok moved2)])]
              [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved array)
          [(TcMoveResult.Ok moved1)
            (match (tc-move-check-expr ctx env locals loop-carried moved1 index)
              [(TcMoveResult.Ok moved2)
                (match (tc-move-check-expr
                  ctx
                  env
                  locals
                  loop-carried
                  moved2
                  value)
                  [(TcMoveResult.Ok moved3)
                    (TcMoveResult.Ok
                      (tc-move-reinitialize-array-set-path
                        locals
                        moved3
                        array
                        index))]
                  [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
              [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.StructSet receiver-box field value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved receiver)
          [(TcMoveResult.Ok moved1)
            (match (tc-move-check-expr ctx env locals loop-carried moved1 value)
              [(TcMoveResult.Ok moved2)
                (TcMoveResult.Ok
                  (tc-move-reinitialize-struct-set-path
                    locals
                    moved2
                    receiver
                    (intern-str field)))]
              [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.ArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved array)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 value)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.StringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved str)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 index)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved cond)
          [(TcMoveResult.Ok movedc)
            (let
              [body-loop-carried : TcMovedSet
                (tc-moved-union locals (tc-moved-clone loop-carried))]
              (match (tc-move-check-expr
                ctx
                env
                (tc-moved-clone locals)
                body-loop-carried
                (tc-moved-clone movedc)
                body)
                [(TcMoveResult.Ok _) (TcMoveResult.Ok movedc)]
                [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.Begin exprs)
      (tc-move-check-exprs ctx env locals loop-carried moved exprs)]
    [(AstExpr.Unsafe exprs)
      (tc-move-check-exprs ctx env locals loop-carried moved exprs)]
    [(AstExpr.Set name rhs-box)
      (let
        [_rhs : AstExpr (ast-node-get rhs-box)]
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-set-expr-id env name-text rhs-box)
            [(ResultTcExprId.Ok virtual-id)
              (tc-move-check-expr
                ctx
                env
                locals
                loop-carried
                moved
                (ast-node-get virtual-id))]
            [(ResultTcExprId.Err message) (TcMoveResult.Err message)])
          (match (tc-move-check-expr-id
            ctx
            env
            locals
            loop-carried
            moved
            rhs-box)
            [(TcMoveResult.Ok moved1)
              (match (tc-move-after-bind-id
                ctx
                env
                locals
                loop-carried
                moved1
                rhs-box)
                [(TcMoveResult.Ok moved2)
                  (TcMoveResult.Ok
                    (tc-moved-remove-root-state moved2 name-text))]
                [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
            [(TcMoveResult.Err message) (TcMoveResult.Err message)])))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExpr.Borrow _ _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrut-box arms)
          (let
            [scrut : AstExpr (ast-node-get scrut-box)]
            (match (tc-move-check-expr ctx env locals loop-carried moved scrut)
              [(TcMoveResult.Ok moveds)
                (match (tc-body-type-fact-expr-id
                  "move.match_scrutinee"
                  ctx
                  env
                  scrut-box)
                  [(ResultTcType.Ok scrut-ty)
                    (tc-move-check-arms
                      ctx
                      env
                      locals
                      loop-carried
                      (tc-move-after-match-scrutinee
                        ctx
                        locals
                        moveds
                        scrut
                        scrut-ty)
                      scrut-ty
                      arms)]
                  [(ResultTcType.Err _)
                    (tc-move-check-arms
                      ctx
                      env
                      locals
                      loop-carried
                      moveds
                      (AstType.Unit)
                      arms)])]
              [(TcMoveResult.Err message) (TcMoveResult.Err message)]))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach index index-ty start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-move-check-expr ctx env locals loop-carried moved start)
              [(TcMoveResult.Ok moved1)
                (match (tc-move-check-expr
                  ctx
                  env
                  locals
                  loop-carried
                  moved1
                  end)
                  [(TcMoveResult.Ok moved2)
                    (let
                      [body-loop-carried : TcMovedSet
                        (tc-moved-union locals (tc-moved-clone loop-carried))]
                      (match (tc-move-check-expr
                        ctx
                        (tc-bind-id env index (tc-resolve-type ctx index-ty))
                        (tc-moved-add
                          (tc-moved-clone locals)
                          (intern-str index))
                        (tc-moved-remove-root-state
                          body-loop-carried
                          (intern-str index))
                        (tc-moved-clone moved2)
                        body)
                        [(TcMoveResult.Ok _) (TcMoveResult.Ok moved2)]
                        [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
                  [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
              [(TcMoveResult.Err message) (TcMoveResult.Err message)]))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce _ _ _ a-box b-box c-box d-box)
          (let
            [a : AstExpr (ast-node-get a-box)]
            [b : AstExpr (ast-node-get b-box)]
            [c : AstExpr (ast-node-get c-box)]
            [d : AstExpr (ast-node-get d-box)]
            (match (tc-move-check-expr ctx env locals loop-carried moved a)
              [(TcMoveResult.Ok m1)
                (match (tc-move-check-expr ctx env locals loop-carried m1 b)
                  [(TcMoveResult.Ok m2)
                    (match (tc-move-check-expr ctx env locals loop-carried m2 c)
                      [(TcMoveResult.Ok m3)
                        (tc-move-check-expr ctx env locals loop-carried m3 d)]
                      [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
                  [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
              [(TcMoveResult.Err message) (TcMoveResult.Err message)]))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            _
            index
            index-ty
            start-box
            end-box
            prefix
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-move-check-expr ctx env locals loop-carried moved start)
              [(TcMoveResult.Ok m1)
                (match (tc-move-check-expr ctx env locals loop-carried m1 end)
                  [(TcMoveResult.Ok m2)
                    (match (tc-move-check-expr
                      ctx
                      env
                      locals
                      loop-carried
                      m2
                      init)
                      [(TcMoveResult.Ok m3)
                        (match (tc-move-check-expr
                          ctx
                          (tc-bind-id env index (tc-resolve-type ctx index-ty))
                          (tc-moved-add
                            (tc-moved-clone locals)
                            (intern-str index))
                          loop-carried
                          m3
                          value)
                          [(TcMoveResult.Ok m4)
                            (let
                              [scan-env : TcTypeEnv
                                (tc-bind-id
                                  (tc-bind-id
                                    env
                                    index
                                    (tc-resolve-type ctx index-ty))
                                  prefix
                                  (tc-resolve-type ctx prefix-ty))]
                              [scan-locals : TcMovedSet
                                (tc-moved-add
                                  (tc-moved-add
                                    (tc-moved-clone locals)
                                    (intern-str index))
                                  (intern-str prefix))]
                              (match (tc-move-check-expr
                                ctx
                                scan-env
                                scan-locals
                                loop-carried
                                m4
                                body)
                                [(TcMoveResult.Ok _) (TcMoveResult.Ok m4)]
                                [(TcMoveResult.Err message)
                                  (TcMoveResult.Err message)]))]
                          [(TcMoveResult.Err message)
                            (TcMoveResult.Err message)])]
                      [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
                  [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
              [(TcMoveResult.Err message) (TcMoveResult.Err message)]))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved value)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 lane)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved value)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 lane)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.StructGet inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved inner)
          [(TcMoveResult.Ok moved1)
            (match (tc-move-struct-field-path expr)
              [(TcMaybeString.Some path)
                (if (tc-moved-contains? moved1 (tc-moved-path-key path))
                  (tc-move-rich-use-conflict-result
                    (tc-moved-conflict moved1 (tc-moved-path-key path))
                    (tc-moved-path-key path)
                    expr
                    path)
                  (TcMoveResult.Ok moved1))]
              [(TcMaybeString.No) (TcMoveResult.Ok moved1)])]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.WithRegion _ exprs)
      (tc-move-check-exprs ctx env locals loop-carried moved exprs)]
    [(AstExpr.WithEscape scratch-box exprs)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved scratch)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-exprs ctx env locals loop-carried moved1 exprs)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.WithScratch exprs)
      (tc-move-check-exprs ctx env locals loop-carried moved exprs)]
    [(AstExpr.InArena arena-box exprs)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved arena)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-exprs ctx env locals loop-carried moved1 exprs)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings exprs)
          (match (tc-move-check-resource-bindings
            ctx
            env
            locals
            loop-carried
            moved
            bindings)
            [(TcMoveResourceBindings.Ok
                body-env
                moved1
                body-locals
                body-loop
                roots)
              (match (tc-move-check-exprs
                ctx
                body-env
                body-locals
                body-loop
                moved1
                exprs)
                [(TcMoveResult.Ok moved2)
                  (tc-move-check-cleanup-owner-exit moved2 roots expr)]
                [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
            [(TcMoveResourceBindings.Err message) (TcMoveResult.Err message)])])]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved inner)
          [(TcMoveResult.Ok moved1)
            (match (tc-expr ctx env inner)
              [(ResultTcType.Ok box-ty)
                (tc-move-after-consuming-value
                  ctx
                  env
                  locals
                  loop-carried
                  moved1
                  inner
                  box-ty)]
              [(ResultTcType.Err _) (TcMoveResult.Ok moved1)])]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.BoxSet box-box value-box)
      (let
        [box-expr : AstExpr (ast-node-get box-box)]
        [_value : AstExpr (ast-node-get value-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved box-expr)
          [(TcMoveResult.Ok moved1)
            (match (tc-move-check-expr-id
              ctx
              env
              locals
              loop-carried
              moved1
              value-box)
              [(TcMoveResult.Ok moved2)
                (match (tc-move-after-bind-id
                  ctx
                  env
                  locals
                  loop-carried
                  moved2
                  value-box)
                  [(TcMoveResult.Ok moved3) (TcMoveResult.Ok moved3)]
                  [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
              [(TcMoveResult.Err message) (TcMoveResult.Err message)])]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.TypeLiteral _) (TcMoveResult.Ok moved)]
    [(AstExpr.Init _) (TcMoveResult.Ok moved)]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExpr.Quote _) (TcMoveResult.Ok moved)]
    [(AstExpr.Quasiquote _) (TcMoveResult.Ok moved)]
    [(AstExpr.Unquote _) (TcMoveResult.Ok moved)]
    [(AstExpr.UnquoteSplicing _) (TcMoveResult.Ok moved)]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExpr.Return inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved inner)
          [(TcMoveResult.Ok moved1)
            (match (tc-current-return-type env)
              [(ResultTcType.Ok return-ty)
                (tc-move-after-consuming-value
                  ctx
                  env
                  locals
                  loop-carried
                  moved1
                  inner
                  return-ty)]
              [(ResultTcType.Err _) (TcMoveResult.Ok moved1)])]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.Break) (TcMoveResult.Ok moved)]
    [(AstExpr.Continue) (TcMoveResult.Ok moved)]
    [(AstExpr.PtrNull _) (TcMoveResult.Ok moved)]
    [(AstExpr.PtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExpr.PtrAddrOf name)
      (if (tc-moved-contains? moved (intern-str name))
        (tc-move-rich-use-conflict-result
          (tc-moved-conflict moved (intern-str name))
          (intern-str name)
          expr
          (intern-str name))
        (TcMoveResult.Ok moved))]
    [(AstExpr.PtrRead inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved ptr)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 value)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved ptr)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 offset)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.PtrCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExpr.PtrToInt inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExpr.IntToPtr inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExpr.StringData inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved ptr)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 len)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.ArrayData inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-move-check-expr ctx env locals loop-carried moved inner))]
    [(AstExpr.BinaryData _) (TcMoveResult.Ok moved)]
    [(AstExpr.SpmdProgramIndex) (TcMoveResult.Ok moved)]
    [(AstExpr.SpmdProgramCount) (TcMoveResult.Ok moved)]
    [(AstExpr.ProgramArgc) (TcMoveResult.Ok moved)]
    [(AstExpr.ProgramArgv) (TcMoveResult.Ok moved)]
    [(AstExpr.ProgramEnvp) (TcMoveResult.Ok moved)]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved leaf)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 subleaf)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved leaf)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 subleaf)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved leaf)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 subleaf)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-move-check-expr ctx env locals loop-carried moved leaf)
          [(TcMoveResult.Ok moved1)
            (tc-move-check-expr ctx env locals loop-carried moved1 subleaf)]
          [(TcMoveResult.Err message) (TcMoveResult.Err message)]))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (tc-move-check-expr ctx env locals loop-carried moved index))]
    [(AstExpr.Syscall args)
      (tc-move-check-exprs ctx env locals loop-carried moved args)]))

(define (tc-move-check-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]
  [body : AstExpr]) : ResultTcUnit
  (match (tc-move-check-expr
    ctx
    env
    (tc-move-params-locals params (tc-moved-empty))
    (tc-moved-empty)
    (tc-moved-empty)
    body)
    [(TcMoveResult.Ok _) ResultTcUnit.Ok]
    [(TcMoveResult.Err message) (ResultTcUnit.Err message)]))

(define (tc-move-check-body-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]
  [body-id : i64]) : ResultTcUnit
  (match (tc-move-check-expr-id
    ctx
    env
    (tc-move-params-locals params (tc-moved-empty))
    (tc-moved-empty)
    (tc-moved-empty)
    body-id)
    [(TcMoveResult.Ok _) ResultTcUnit.Ok]
    [(TcMoveResult.Err message) (ResultTcUnit.Err message)]))

;; --- lexical borrow conflict checker (#1050/#806) --------------------------
;;
;; Borrows are lexical in this staged model: `begin` keeps borrows live, while
;; `let`, `with-arena`, resource `with`, lambdas, and individual match arms
;; bound their own borrow additions. The checker reuses the move path encoding
;; so whole roots, fields, tuple elements, and fixed-array literal elements share
;; the same ancestor/descendant conflict policy as moved paths. Mutable borrows
;; add both the ordinary borrowed path and a namespaced mutable marker, allowing
;; many immutable borrows but only one exclusive mutable borrow.
(defenum TcBorrowCheckResult
  (Ok TcMovedSet)
  (Err String))

(defenum TcBorrowCheckBindings
  (Ok TcTypeEnv TcMovedSet TcMovedSet)
  (Err String))

(defenum TcBorrowCheckResourceBindings
  (Ok TcTypeEnv TcMovedSet TcMovedSet)
  (Err String))

(defenum TcBorrowConflictOrigin
  (No)
  (Some i64))

(define (tc-borrow-check-move-message [path : String]) : String
  (string.append
    (string.append "typecheck: cannot move borrowed place `" path)
    "`"))

(define (tc-borrow-check-assign-message [path : String]) : String
  (string.append
    (string.append "typecheck: cannot assign to borrowed place `" path)
    "`"))

(define (tc-borrow-check-mutably-borrow-message [path : String]) : String
  (string.append
    (string.append "typecheck: cannot mutably borrow borrowed place `" path)
    "`"))

(define (tc-borrow-check-immutably-borrow-message [path : String]) : String
  (string.append
    (string.append
      "typecheck: cannot immutably borrow mutably borrowed place `"
      path)
    "`"))

(define (tc-borrow-check-read-message [path : String]) : String
  (string.append
    (string.append "typecheck: cannot read mutably borrowed place `" path)
    "`"))

(define (tc-borrow-check-help) : String
  "let the last reference use occur before this operation, shorten the borrow with a narrower lexical scope, clone the owner before borrowing when ownership must move later, or use an immutable borrow for non-mutating access")

(define (tc-borrow-check-origin-label [path : String]) : String
  (str_cat.str-cat
    "borrow of `"
    path
    "` remains live because a later reference use may still depend on it"))

(define (tc-borrow-check-conflict-origin-loop
  [map : hashmap.StringI64Map]
  [path : String]
  [index : i64]) : TcBorrowConflictOrigin
  (if (>= index (hashmap.string-i64-map-capacity map))
    TcBorrowConflictOrigin.No
    (match (hashmap.string-i64-map-entry-at map index)
      [(hashmap.StringI64MapEntrySome key value)
        (if (tc-moved-path-key-conflicts? key path)
          (TcBorrowConflictOrigin.Some value)
          (tc-borrow-check-conflict-origin-loop
            map
            path
            (hashmap.string-i64-map-next-occupied map (+ index 1))))]
      [(hashmap.StringI64MapEntryNone)
        (tc-borrow-check-conflict-origin-loop
          map
          path
          (hashmap.string-i64-map-next-occupied map (+ index 1)))])))

(define (tc-borrow-check-conflict-origin
  [borrowed : TcMovedSet]
  [path : String]) : TcBorrowConflictOrigin
  (tc-borrow-check-conflict-origin-loop
    (tc-moved-map borrowed)
    path
    (hashmap.string-i64-map-next-occupied (tc-moved-map borrowed) 0)))

(define (tc-borrow-check-rich-conflict-message
  [borrowed : TcMovedSet]
  [conflict-path : String]
  [display-path : String]
  [primary : AstExpr]
  [message : String]) : String
  (match (tc-expr-maybe-span primary)
    [(TcMaybeAstSourceSpan.Some primary-span)
      (match (tc-borrow-check-conflict-origin borrowed conflict-path)
        [(TcBorrowConflictOrigin.Some origin-id)
          (match (tc-expr-maybe-span (ast-node-get origin-id))
            [(TcMaybeAstSourceSpan.Some origin-span)
              (tc-rich-error-one-secondary
                primary-span
                message
                (tc-borrow-check-help)
                origin-span
                (tc-borrow-check-origin-label display-path))]
            [(TcMaybeAstSourceSpan.No)
              (tc-rich-error-one-secondary
                primary-span
                message
                (tc-borrow-check-help)
                primary-span
                (tc-borrow-check-origin-label display-path))])]
        [(TcBorrowConflictOrigin.No)
          (tc-rich-error-one-secondary
            primary-span
            message
            (tc-borrow-check-help)
            primary-span
            (tc-borrow-check-origin-label display-path))])]
    [(TcMaybeAstSourceSpan.No)
      (match (tc-borrow-check-conflict-origin borrowed conflict-path)
        [(TcBorrowConflictOrigin.Some origin-id)
          (match (tc-expr-maybe-span (ast-node-get origin-id))
            [(TcMaybeAstSourceSpan.Some origin-span)
              (tc-rich-error-one-secondary
                origin-span
                message
                (tc-borrow-check-help)
                origin-span
                (tc-borrow-check-origin-label display-path))]
            [(TcMaybeAstSourceSpan.No) message])]
        [(TcBorrowConflictOrigin.No) message])]))

(define (tc-borrow-check-mut-path [path : String]) : String
  (string.append "#mut." path))

(define (tc-borrow-check-two-phase-mut-prefix) : String
  "#two-phase-mut.")

(define (tc-borrow-check-two-phase-mut-path [path : String]) : String
  (string.append (tc-borrow-check-two-phase-mut-prefix) path))

(define (tc-borrow-check-two-phase-mut-path? [path : String]) : bool
  (tc-move-string-prefix? path (tc-borrow-check-two-phase-mut-prefix)))

(define (tc-borrow-check-two-phase-mut-original-path [path : String]) : String
  (let
    [prefix : String (tc-borrow-check-two-phase-mut-prefix)]
    [prefix-len : i64 (string.string-length prefix)]
    [path-len : i64 (string.string-length path)]
    (string.substring path prefix-len (- path-len prefix-len))))

(define (tc-borrow-check-remove-root-state
  [borrowed : TcMovedSet]
  [name : String]) : TcMovedSet
  (tc-moved-remove-root-state
    (tc-moved-remove-root-state
      (tc-moved-remove-root-state borrowed name)
      (tc-borrow-check-mut-path name))
    (tc-borrow-check-two-phase-mut-path name)))

(define (tc-borrow-check-remove-borrow-path
  [borrowed : TcMovedSet]
  [path : String]) : TcMovedSet
  (tc-moved-remove
    (tc-moved-remove
      (tc-moved-remove borrowed (tc-moved-path-key path))
      (tc-moved-path-key (tc-borrow-check-mut-path path)))
    (tc-moved-path-key (tc-borrow-check-two-phase-mut-path path))))

(define (tc-borrow-check-two-phase-mut-conflict
  [borrowed : TcMovedSet]
  [path : String]) : TcMoveConflict
  (tc-moved-path-conflict borrowed (tc-borrow-check-two-phase-mut-path path)))

(define (tc-borrow-check-two-phase-mut-conflict-message
  [borrowed : TcMovedSet]
  [path : String]
  [primary : AstExpr]
  [message : String]) : String
  (tc-borrow-check-rich-conflict-message
    borrowed
    (tc-borrow-check-two-phase-mut-path path)
    path
    primary
    message))

(define (tc-borrow-check-path-root-end [path : String] [index : i64] [n : i64]) : i64
  (if (>= index n)
    n
    (if (string.char-eq (string.string-ref path index) '.')
      index
      (tc-borrow-check-path-root-end path (+ index 1) n))))

(define (tc-borrow-check-path-root [path : String]) : String
  (let
    [n : i64 (string.string-length path)]
    [end : i64 (tc-borrow-check-path-root-end path 0 n)]
    (string.substring path 0 end)))

(define (tc-borrow-check-path-lifetime
  [ctx : TcContext]
  [env : TcTypeEnv]
  [path : String]) : String
  (let
    [root : String (tc-borrow-check-path-root path)]
    (match (tc-lookup env root)
      [(ResultTcType.Ok ty)
        (let
          [resolved : AstType (tc-resolve-type ctx ty)]
          (match (tc-type-strip-region resolved)
            [(AstType.Ref lifetime _) lifetime]
            [(AstType.MutRef lifetime _) lifetime]
            [_
              (match (tc-type-outer-region resolved)
                [(TcMaybeString.Some region) region]
                [(TcMaybeString.No) root])]))]
      [(ResultTcType.Err _) root])))

(define (tc-borrow-check-type-contains-lifetime?
  [ctx : TcContext]
  [ty : AstType]
  [lifetime : String]) : bool
  (tc-string-list-contains
    (tc-type-collect-reference-lifetimes (tc-resolve-type ctx ty))
    lifetime))

(define (tc-borrow-check-binding-stores-lifetime?
  [ctx : TcContext]
  [ty : AstType]
  [lifetime : String]) : bool
  (match (tc-type-strip-region (tc-resolve-type ctx ty))
    [(AstType.Func _ ret)
      (tc-borrow-check-type-contains-lifetime? ctx (ty-node-get ret) lifetime)]
    [_ (tc-borrow-check-type-contains-lifetime? ctx ty lifetime)]))

(define (tc-borrow-check-env-lifetime-used-in-exprs?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [lifetime : String]
  [seen : TcStringList]) : bool
  (match env
    [(TcTypeEnv.Nil) false]
    [(TcTypeEnv.Cache _ _ _ _ _ _ _ rest _)
      (tc-borrow-check-env-lifetime-used-in-exprs?
        ctx
        (box-get rest)
        exprs
        lifetime
        seen)]
    [(TcTypeEnv.Bind name-id ty rest)
      (let
        [name : String (intern-str name-id)]
        [rest-env : TcTypeEnv (box-get rest)]
        (if (tc-string-list-contains seen name)
          (tc-borrow-check-env-lifetime-used-in-exprs?
            ctx
            rest-env
            exprs
            lifetime
            seen)
          (if (and
            (tc-borrow-check-binding-stores-lifetime? ctx ty lifetime)
            (tc-expr-list-uses-free-name? exprs name TcStringList.Nil))
            true
            (tc-borrow-check-env-lifetime-used-in-exprs?
              ctx
              rest-env
              exprs
              lifetime
              (tc-string-list-add seen name)))))]))

(define (tc-borrow-check-lifetime-used-in-exprs?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [lifetime : String]) : bool
  (tc-borrow-check-env-lifetime-used-in-exprs?
    ctx
    env
    exprs
    lifetime
    TcStringList.Nil))

(define (tc-borrow-check-mut-path? [path : String]) : bool
  (tc-move-string-prefix? path "#mut."))

(define (tc-borrow-check-protected-path?
  [protected : TcMovedSet]
  [path : String]) : bool
  (or
    (tc-moved-path-conflict? protected path)
    (tc-moved-path-conflict? protected (tc-borrow-check-mut-path path))))

(define (tc-borrow-check-prune-before-exprs-loop
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [protected : TcMovedSet]
  [map : hashmap.StringI64Map]
  [index : i64]
  [out : TcMovedSet]) : TcMovedSet
  (if (>= index (hashmap.string-i64-map-capacity map))
    out
    (match (hashmap.string-i64-map-entry-at map index)
      [(hashmap.StringI64MapEntrySome key _)
        (let
          [next : i64 (hashmap.string-i64-map-next-occupied map (+ index 1))]
          [out2 : TcMovedSet
            (if (tc-moved-path-key? key)
              (let
                [path : String (tc-moved-conflict-display-path key)]
                (if (or
                  (tc-borrow-check-mut-path? path)
                  (tc-borrow-check-protected-path? protected path))
                  out
                  (let
                    [lifetime : String
                      (tc-borrow-check-path-lifetime ctx env path)]
                    (if (tc-borrow-check-lifetime-used-in-exprs?
                      ctx
                      env
                      exprs
                      lifetime)
                      out
                      (tc-borrow-check-remove-borrow-path out path)))))
              out)]
          (tc-borrow-check-prune-before-exprs-loop
            ctx
            env
            exprs
            protected
            map
            next
            out2))]
      [(hashmap.StringI64MapEntryNone)
        (tc-borrow-check-prune-before-exprs-loop
          ctx
          env
          exprs
          protected
          map
          (hashmap.string-i64-map-next-occupied map (+ index 1))
          out)])))

(define (tc-borrow-check-prune-before-exprs
  [ctx : TcContext]
  [env : TcTypeEnv]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : AstExprList]) : TcMovedSet
  (if (or (ast-expr-list-empty? (& exprs)) (= (tc-moved-len borrowed) 0))
    borrowed
    (let
      [map : hashmap.StringI64Map (tc-moved-map borrowed)]
      (tc-borrow-check-prune-before-exprs-loop
        ctx
        env
        exprs
        protected
        map
        (hashmap.string-i64-map-next-occupied map 0)
        borrowed))))

(define (tc-borrow-check-local-place-path
  [locals : TcMovedSet]
  [expr : AstExpr]) : TcMaybeString
  (match (tc-move-root-projection-var expr)
    [(TcMaybeString.Some root)
      (if (tc-moved-contains? locals root)
        (match (tc-move-direct-root-base-path expr)
          [(TcMaybeString.Some path) (TcMaybeString.Some path)]
          [(TcMaybeString.No) (TcMaybeString.Some root)])
        (TcMaybeString.No))]
    [(TcMaybeString.No) (TcMaybeString.No)]))

(define (tc-borrow-check-add-borrow-path
  [borrowed : TcMovedSet]
  [path : String]
  [mutable : bool]
  [origin : AstExpr]) : TcMovedSet
  (let
    [origin-id : i64 (ast-node-push origin)]
    [borrowed1 : TcMovedSet
      (tc-moved-add-value borrowed (tc-moved-path-key path) origin-id)]
    (if mutable
      (tc-moved-add-value
        borrowed1
        (tc-moved-path-key (tc-borrow-check-mut-path path))
        origin-id)
      borrowed1)))

(define (tc-borrow-check-add-two-phase-mut-borrow-path
  [borrowed : TcMovedSet]
  [path : String]
  [origin : AstExpr]) : TcMovedSet
  (tc-moved-add-value
    borrowed
    (tc-moved-path-key (tc-borrow-check-two-phase-mut-path path))
    (ast-node-push origin)))

(define (tc-borrow-check-add-two-phase-mut-place
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [place : AstExpr]
  [origin : AstExpr]) : TcBorrowCheckResult
  (match (tc-borrow-check-local-place-path locals place)
    [(TcMaybeString.Some path)
      (match (tc-borrow-check-mutably-borrow-conflict borrowed path origin)
        [(ResultTcUnit.Ok)
          (TcBorrowCheckResult.Ok
            (tc-borrow-check-add-two-phase-mut-borrow-path borrowed path origin))]
        [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])]
    [(TcMaybeString.No) (TcBorrowCheckResult.Ok borrowed)]))

(define (tc-borrow-check-move-conflict
  [borrowed : TcMovedSet]
  [path : String]
  [primary : AstExpr]) : ResultTcUnit
  (if (tc-moved-path-conflict? borrowed path)
    (ResultTcUnit.Err
      (tc-borrow-check-rich-conflict-message
        borrowed
        path
        path
        primary
        (tc-borrow-check-move-message path)))
    (match (tc-borrow-check-two-phase-mut-conflict borrowed path)
      [(TcMoveConflict.Some _ _)
        (ResultTcUnit.Err
          (tc-borrow-check-two-phase-mut-conflict-message
            borrowed
            path
            primary
            (tc-borrow-check-move-message path)))]
      [TcMoveConflict.No ResultTcUnit.Ok])))

(define (tc-borrow-check-assign-conflict
  [borrowed : TcMovedSet]
  [path : String]
  [primary : AstExpr]) : ResultTcUnit
  (if (tc-moved-path-conflict? borrowed path)
    (ResultTcUnit.Err
      (tc-borrow-check-rich-conflict-message
        borrowed
        path
        path
        primary
        (tc-borrow-check-assign-message path)))
    (match (tc-borrow-check-two-phase-mut-conflict borrowed path)
      [(TcMoveConflict.Some _ _)
        (ResultTcUnit.Err
          (tc-borrow-check-two-phase-mut-conflict-message
            borrowed
            path
            primary
            (tc-borrow-check-assign-message path)))]
      [TcMoveConflict.No ResultTcUnit.Ok])))

(define (tc-borrow-check-mutably-borrow-conflict
  [borrowed : TcMovedSet]
  [path : String]
  [primary : AstExpr]) : ResultTcUnit
  (if (tc-moved-path-conflict? borrowed path)
    (ResultTcUnit.Err
      (tc-borrow-check-rich-conflict-message
        borrowed
        path
        path
        primary
        (tc-borrow-check-mutably-borrow-message path)))
    (match (tc-borrow-check-two-phase-mut-conflict borrowed path)
      [(TcMoveConflict.Some _ _)
        (ResultTcUnit.Err
          (tc-borrow-check-two-phase-mut-conflict-message
            borrowed
            path
            primary
            (tc-borrow-check-mutably-borrow-message path)))]
      [TcMoveConflict.No ResultTcUnit.Ok])))

(define (tc-borrow-check-immutably-borrow-conflict
  [borrowed : TcMovedSet]
  [path : String]
  [primary : AstExpr]) : ResultTcUnit
  (if (tc-moved-path-conflict? borrowed (tc-borrow-check-mut-path path))
    (ResultTcUnit.Err
      (tc-borrow-check-rich-conflict-message
        borrowed
        (tc-borrow-check-mut-path path)
        path
        primary
        (tc-borrow-check-immutably-borrow-message path)))
    ResultTcUnit.Ok))

(define (tc-borrow-check-read-conflict
  [borrowed : TcMovedSet]
  [path : String]
  [primary : AstExpr]) : ResultTcUnit
  (if (tc-moved-path-conflict? borrowed (tc-borrow-check-mut-path path))
    (ResultTcUnit.Err
      (tc-borrow-check-rich-conflict-message
        borrowed
        (tc-borrow-check-mut-path path)
        path
        primary
        (tc-borrow-check-read-message path)))
    ResultTcUnit.Ok))

(define (tc-borrow-check-place-read-conflict
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : AstExpr]
  [primary : AstExpr]) : TcBorrowCheckResult
  (if (= (tc-moved-len borrowed) 0)
    (TcBorrowCheckResult.Ok borrowed)
    (match (tc-borrow-check-local-place-path locals expr)
      [(TcMaybeString.Some path)
        (match (tc-borrow-check-read-conflict borrowed path primary)
          [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed)]
          [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])]
      [(TcMaybeString.No) (TcBorrowCheckResult.Ok borrowed)])))

(define (tc-borrow-check-add-place-with-mutability
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [mutable : bool]
  [place : AstExpr]
  [origin : AstExpr]) : TcBorrowCheckResult
  (match (tc-borrow-check-local-place-path locals place)
    [(TcMaybeString.Some path)
      (if mutable
        (match (tc-borrow-check-mutably-borrow-conflict borrowed path origin)
          [(ResultTcUnit.Ok)
            (TcBorrowCheckResult.Ok
              (tc-borrow-check-add-borrow-path borrowed path true origin))]
          [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])
        (match (tc-borrow-check-immutably-borrow-conflict borrowed path origin)
          [(ResultTcUnit.Ok)
            (TcBorrowCheckResult.Ok
              (tc-borrow-check-add-borrow-path borrowed path false origin))]
          [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)]))]
    [(TcMaybeString.No) (TcBorrowCheckResult.Ok borrowed)]))

(define (tc-borrow-check-after-consuming-place
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : AstExpr]) : TcBorrowCheckResult
  (match (tc-borrow-check-local-place-path locals expr)
    [(TcMaybeString.Some path)
      (match (tc-borrow-check-move-conflict borrowed path expr)
        [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed)]
        [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])]
    [(TcMaybeString.No) (TcBorrowCheckResult.Ok borrowed)]))

(define (tc-borrow-check-after-consuming-value
  [ctx : TcContext]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : AstExpr]
  [target-ty : AstType]) : TcBorrowCheckResult
  (if (tc-type-consuming-by-value-now? ctx target-ty)
    (tc-borrow-check-after-consuming-place locals borrowed expr)
    (TcBorrowCheckResult.Ok borrowed)))

(define (tc-borrow-check-after-move-only-value
  [ctx : TcContext]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : AstExpr]
  [target-ty : AstType]) : TcBorrowCheckResult
  (if (tc-type-move-only? (tc-resolve-type ctx target-ty))
    (tc-borrow-check-after-consuming-place locals borrowed expr)
    (TcBorrowCheckResult.Ok borrowed)))

(define (tc-borrow-check-after-reading-value
  [ctx : TcContext]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : AstExpr]
  [target-ty : AstType]) : TcBorrowCheckResult
  (if (tc-type-consuming-by-value-now? ctx target-ty)
    (TcBorrowCheckResult.Ok borrowed)
    (tc-borrow-check-place-read-conflict locals borrowed expr expr)))

(define (tc-borrow-check-after-bind-typed
  [ctx : TcContext]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [init : AstExpr]
  [init-ty : AstType]) : TcBorrowCheckResult
  (if (tc-type-consuming-by-value-now? ctx init-ty)
    (tc-borrow-check-after-consuming-place locals borrowed init)
    (TcBorrowCheckResult.Ok borrowed)))

(define (tc-borrow-check-after-bind
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [init : AstExpr]) : TcBorrowCheckResult
  (match (tc-move-bare-var init)
    [(TcMaybeString.Some name)
      (if (and
        (tc-moved-contains? locals name)
        (tc-move-var-move-only? env name))
        (match (tc-borrow-check-move-conflict borrowed name init)
          [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed)]
          [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])
        (TcBorrowCheckResult.Ok borrowed))]
    [(TcMaybeString.No)
      (match (cfg
        compile-profile
        (compiler-tc-reinfer-profile-expr "borrow.bind_init" ctx env init)
        (tc-expr ctx env init))
        [(ResultTcType.Ok init-ty)
          (tc-borrow-check-after-bind-typed ctx locals borrowed init init-ty)]
        [(ResultTcType.Err _) (TcBorrowCheckResult.Ok borrowed)])]))

(define (tc-borrow-check-after-bind-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [init-id : i64]) : TcBorrowCheckResult
  (let
    [init : AstExpr (ast-node-get init-id)]
    (match (tc-move-bare-var init)
      [(TcMaybeString.Some name)
        (if (and
          (tc-moved-contains? locals name)
          (tc-move-var-move-only? env name))
          (match (tc-borrow-check-move-conflict borrowed name init)
            [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed)]
            [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])
          (TcBorrowCheckResult.Ok borrowed))]
      [(TcMaybeString.No)
        (match (tc-body-type-fact-expr-id "borrow.bind_init" ctx env init-id)
          [(ResultTcType.Ok init-ty)
            (tc-borrow-check-after-bind-typed ctx locals borrowed init init-ty)]
          [(ResultTcType.Err _) (TcBorrowCheckResult.Ok borrowed)])])))

(define (tc-borrow-check-after-bind-known-type-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [init-id : i64]
  [init-ty : AstType]) : TcBorrowCheckResult
  (let
    [init : AstExpr (ast-node-get init-id)]
    (match (tc-move-bare-var init)
      [(TcMaybeString.Some name)
        (if (and
          (tc-moved-contains? locals name)
          (tc-move-var-move-only? env name))
          (match (tc-borrow-check-move-conflict borrowed name init)
            [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed)]
            [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])
          (TcBorrowCheckResult.Ok borrowed))]
      [(TcMaybeString.No)
        (tc-borrow-check-after-bind-typed ctx locals borrowed init init-ty)])))

(define (tc-borrow-check-assignment
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [name : String]
  [primary : AstExpr]) : ResultTcUnit
  (if (tc-moved-contains? locals name)
    (tc-borrow-check-assign-conflict borrowed name primary)
    ResultTcUnit.Ok))

(define (tc-borrow-check-array-set-conflict
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [array : AstExpr]
  [index : AstExpr]
  [primary : AstExpr]) : ResultTcUnit
  (match (tc-move-root-projection-var array)
    [(TcMaybeString.Some root)
      (if (tc-moved-contains? locals root)
        (match (tc-move-array-set-path array index)
          [(TcMaybeString.Some path)
            (tc-borrow-check-assign-conflict borrowed path primary)]
          [(TcMaybeString.No)
            (tc-borrow-check-assign-conflict borrowed root primary)])
        ResultTcUnit.Ok)]
    [(TcMaybeString.No) ResultTcUnit.Ok]))

(define (tc-borrow-check-struct-set-conflict
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [receiver : AstExpr]
  [field : String]
  [primary : AstExpr]) : ResultTcUnit
  (match (tc-move-root-projection-var receiver)
    [(TcMaybeString.Some root)
      (if (tc-moved-contains? locals root)
        (match (tc-move-struct-set-path receiver field)
          [(TcMaybeString.Some path)
            (tc-borrow-check-assign-conflict borrowed path primary)]
          [(TcMaybeString.No)
            (tc-borrow-check-assign-conflict borrowed root primary)])
        ResultTcUnit.Ok)]
    [(TcMaybeString.No) ResultTcUnit.Ok]))

(define (tc-borrow-check-root-mutation-conflict
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [place : AstExpr]
  [primary : AstExpr]) : ResultTcUnit
  (match (tc-move-root-projection-var place)
    [(TcMaybeString.Some root)
      (if (tc-moved-contains? locals root)
        (tc-borrow-check-assign-conflict borrowed root primary)
        ResultTcUnit.Ok)]
    [(TcMaybeString.No) ResultTcUnit.Ok]))

(define (tc-borrow-check-region-invalidation-scan
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [region : String]
  [seen : TcStringList]
  [remaining : i64]
  [primary : AstExpr]) : TcBorrowCheckResult
  (if (<= remaining 0)
    (TcBorrowCheckResult.Ok borrowed)
    (match env
      [(TcTypeEnv.Nil) (TcBorrowCheckResult.Ok borrowed)]
      [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
        (if scan-through
          (tc-borrow-check-region-invalidation-scan
            ctx
            (box-get rest)
            locals
            borrowed
            region
            seen
            remaining
            primary)
          (TcBorrowCheckResult.Ok borrowed))]
      [(TcTypeEnv.Bind key ty rest)
        (let
          [rest-env : TcTypeEnv (box-get rest)]
          [name : String (intern-str key)]
          (cond
            [(= key (tc-default-boundary-id)) (TcBorrowCheckResult.Ok borrowed)]
            [(tc-string-list-contains seen name)
              (tc-borrow-check-region-invalidation-scan
                ctx
                rest-env
                locals
                borrowed
                region
                seen
                remaining
                primary)]
            [(not (tc-moved-contains? locals name))
              (tc-borrow-check-region-invalidation-scan
                ctx
                rest-env
                locals
                borrowed
                region
                (tc-string-list-add seen name)
                remaining
                primary)]
            [(tc-type-contains-region ty region)
              (match (tc-borrow-check-assign-conflict borrowed name primary)
                [(ResultTcUnit.Ok)
                  (tc-borrow-check-region-invalidation-scan
                    ctx
                    rest-env
                    locals
                    borrowed
                    region
                    (tc-string-list-add seen name)
                    (- remaining 1)
                    primary)]
                [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])]
            [else
              (tc-borrow-check-region-invalidation-scan
                ctx
                rest-env
                locals
                borrowed
                region
                (tc-string-list-add seen name)
                (- remaining 1)
                primary)]))])))

(define (tc-borrow-check-owner-invalidation-scan
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [owner : String]
  [seen : TcStringList]
  [remaining : i64]
  [primary : AstExpr]) : TcBorrowCheckResult
  (if (<= remaining 0)
    (TcBorrowCheckResult.Ok borrowed)
    (match env
      [(TcTypeEnv.Nil) (TcBorrowCheckResult.Ok borrowed)]
      [(TcTypeEnv.Cache _ _ _ _ _ scan-through _ rest _)
        (if scan-through
          (tc-borrow-check-owner-invalidation-scan
            ctx
            (box-get rest)
            locals
            borrowed
            owner
            seen
            remaining
            primary)
          (TcBorrowCheckResult.Ok borrowed))]
      [(TcTypeEnv.Bind key ty rest)
        (let
          [rest-env : TcTypeEnv (box-get rest)]
          [name : String (intern-str key)]
          (cond
            [(= key (tc-default-boundary-id)) (TcBorrowCheckResult.Ok borrowed)]
            [(tc-string-list-contains seen name)
              (tc-borrow-check-owner-invalidation-scan
                ctx
                rest-env
                locals
                borrowed
                owner
                seen
                remaining
                primary)]
            [(not (tc-moved-contains? locals name))
              (tc-borrow-check-owner-invalidation-scan
                ctx
                rest-env
                locals
                borrowed
                owner
                (tc-string-list-add seen name)
                remaining
                primary)]
            [(tc-type-contains-arena-owner-region? ty owner)
              (match (tc-borrow-check-assign-conflict borrowed name primary)
                [(ResultTcUnit.Ok)
                  (tc-borrow-check-owner-invalidation-scan
                    ctx
                    rest-env
                    locals
                    borrowed
                    owner
                    (tc-string-list-add seen name)
                    (- remaining 1)
                    primary)]
                [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])]
            [else
              (tc-borrow-check-owner-invalidation-scan
                ctx
                rest-env
                locals
                borrowed
                owner
                (tc-string-list-add seen name)
                (- remaining 1)
                primary)]))])))

(define (tc-borrow-check-safe-arena-rewind-effect
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : AstExprList]
  [primary : AstExpr]) : TcBorrowCheckResult
  (if (ast-expr-list-empty? (& args))
    (TcBorrowCheckResult.Ok borrowed)
    (let
      [phase-box : i64 (ast-expr-list-get (& args) 0 0)]
      [phase-expr : AstExpr (ast-node-get phase-box)]
      (match (tc-expr-var-name phase-expr)
        [(TcMaybeString.Some phase)
          (match (tc-borrow-check-assign-conflict borrowed phase primary)
            [(ResultTcUnit.Ok)
              (match (tc-arena-phase-token-region-active env phase)
                [(TcMaybeString.Some region)
                  (tc-borrow-check-region-invalidation-scan
                    ctx
                    env
                    locals
                    borrowed
                    region
                    TcStringList.Nil
                    (tc-moved-len locals)
                    primary)]
                [(TcMaybeString.No) (TcBorrowCheckResult.Ok borrowed)])]
            [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])]
        [(TcMaybeString.No) (TcBorrowCheckResult.Ok borrowed)]))))

(define (tc-borrow-check-safe-arena-destroy-effect
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : AstExprList]
  [primary : AstExpr]) : TcBorrowCheckResult
  (if (ast-expr-list-empty? (& args))
    (TcBorrowCheckResult.Ok borrowed)
    (let
      [owner-box : i64 (ast-expr-list-get (& args) 0 0)]
      [owner-expr : AstExpr (ast-node-get owner-box)]
      (match (tc-expr-var-name owner-expr)
        [(TcMaybeString.Some owner)
          (if (or
            (tc-ordinary-arena-owner-active? env owner)
            (tc-atomic-arena-owner-active? env owner))
            (match (tc-borrow-check-assign-conflict borrowed owner primary)
              [(ResultTcUnit.Ok)
                (tc-borrow-check-owner-invalidation-scan
                  ctx
                  env
                  locals
                  borrowed
                  owner
                  TcStringList.Nil
                  (tc-moved-len locals)
                  primary)]
              [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)])
            (TcBorrowCheckResult.Ok borrowed))]
        [(TcMaybeString.No) (TcBorrowCheckResult.Ok borrowed)]))))

(define (tc-borrow-check-safe-arena-call-effects
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : AstExpr]
  [func : AstExpr]
  [args : AstExprList]) : TcBorrowCheckResult
  (match (tc-expr-var-name func)
    [(TcMaybeString.Some raw-name)
      (let
        [name : String (tc-hygiene-global-symbol-name raw-name)]
        (cond
          [(tc-arena-safe-call-name? ctx env name "rewind-safe!")
            (tc-borrow-check-safe-arena-rewind-effect
              ctx
              env
              locals
              borrowed
              args
              call-expr)]
          [(tc-arena-safe-call-name? ctx env name "destroy-safe!")
            (tc-borrow-check-safe-arena-destroy-effect
              ctx
              env
              locals
              borrowed
              args
              call-expr)]
          [else (TcBorrowCheckResult.Ok borrowed)]))]
    [(TcMaybeString.No) (TcBorrowCheckResult.Ok borrowed)]))

(define (tc-string-has-suffix-at?
  [text : String]
  [suffix : String]
  [base : i64]
  [index : i64]
  [n : i64]) : bool
  (if (>= index n)
    true
    (if (=
      (cast (string.string-ref text (+ base index)) : i64)
      (cast (string.string-ref suffix index) : i64))
      (tc-string-has-suffix-at? text suffix base (+ index 1) n)
      false)))

(define (tc-string-has-suffix? [text : String] [suffix : String]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [suffix-len : i64 (string.string-length suffix)]
    (if (< text-len suffix-len)
      false
      (tc-string-has-suffix-at?
        text
        suffix
        (- text-len suffix-len)
        0
        suffix-len))))

(define (tc-hashmap-mutating-call-name? [name : String]) : bool
  (cond
    [(tc-string-has-suffix? name "-map-insert") true]
    [(tc-string-has-suffix? name "-map-put") true]
    [(tc-string-has-suffix? name "-map-remove") true]
    [(tc-string-has-suffix? name "-map-remove-borrowed") true]
    [(tc-string-has-suffix? name "-map-update-if-present") true]
    [(tc-string-has-suffix? name "-map-update-borrowed-if-present") true]
    [(tc-string-has-suffix? name "-map-insert-or-update") true]
    [(tc-string-has-suffix? name "-map-entry-or-insert") true]
    [(tc-string-has-suffix? name "-map-resized") true]
    [(tc-string-has-suffix? name "-map-grow") true]
    [else false]))

(define (tc-borrow-check-first-call-arg-root-mutation
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : AstExprList]) : TcBorrowCheckResult
  (if (ast-expr-list-empty? (& args))
    (TcBorrowCheckResult.Ok borrowed)
    (let
      [arg : AstExpr (ast-node-get (ast-expr-list-get (& args) 0 0))]
      (match (tc-borrow-check-root-mutation-conflict locals borrowed arg arg)
        [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed)]
        [(ResultTcUnit.Err message) (TcBorrowCheckResult.Err message)]))))

(define (tc-borrow-check-after-call-effects
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : AstExpr]
  [func : AstExpr]
  [args : AstExprList]
  [return-lifetimes : TcBorrowCallReturnLifetimes]) : TcBorrowCheckResult
  (match (tc-borrow-check-safe-arena-call-effects
    ctx
    env
    locals
    borrowed
    call-expr
    func
    args)
    [(TcBorrowCheckResult.Ok borrowed0)
      (match (tc-expr-var-name func)
        [(TcMaybeString.Some name)
          (if (tc-hashmap-mutating-call-name? name)
            (match (tc-borrow-check-first-call-arg-root-mutation
              locals
              borrowed0
              args)
              [(TcBorrowCheckResult.Ok _)
                (tc-borrow-check-after-returning-call
                  ctx
                  env
                  locals
                  borrowed0
                  call-expr
                  args
                  return-lifetimes)]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])
            (tc-borrow-check-after-returning-call
              ctx
              env
              locals
              borrowed0
              call-expr
              args
              return-lifetimes))]
        [(TcMaybeString.No)
          (tc-borrow-check-after-returning-call
            ctx
            env
            locals
            borrowed0
            call-expr
            args
            return-lifetimes)])]
    [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))

(define (tc-borrow-check-add-names [locals : TcMovedSet] [names : TcStringList]) : TcMovedSet
  (match names
    [(TcStringList.Nil) locals]
    [(TcStringList.Cons name rest)
      (tc-borrow-check-add-names (tc-moved-add locals name) (box-get rest))]))

(define (tc-borrow-check-remove-root-states
  [borrowed : TcMovedSet]
  [names : TcStringList]) : TcMovedSet
  (match names
    [(TcStringList.Nil) borrowed]
    [(TcStringList.Cons name rest)
      (tc-borrow-check-remove-root-states
        (tc-borrow-check-remove-root-state borrowed name)
        (box-get rest))]))

(define (tc-borrow-check-pattern-bound-names
  [ctx : TcContext]
  [scrut-ty : AstType]
  [pattern : AstPattern]) : TcStringList
  (match (tc-type-strip-region
    (tc-resolve-type ctx (tc-match-coverage-type ctx scrut-ty)))
    [(AstType.Enum _)
      (match pattern
        [(AstPattern.Variant _ patterns-box)
          (let
            [patterns : AstPatternList (box-get patterns-box)]
            (tc-pattern-list-add-bound-names patterns TcStringList.Nil))]
        [_ TcStringList.Nil])]
    [(AstType.EnumArgs _ _)
      (match pattern
        [(AstPattern.Variant _ patterns-box)
          (let
            [patterns : AstPatternList (box-get patterns-box)]
            (tc-pattern-list-add-bound-names patterns TcStringList.Nil))]
        [_ TcStringList.Nil])]
    [_ (tc-pattern-add-bound-names pattern TcStringList.Nil)]))

(define (tc-borrow-check-pattern-locals
  [ctx : TcContext]
  [scrut-ty : AstType]
  [pattern : AstPattern]
  [locals : TcMovedSet]) : TcMovedSet
  (tc-borrow-check-add-names
    locals
    (tc-borrow-check-pattern-bound-names ctx scrut-ty pattern)))

(define (tc-borrow-check-effective-arg-with-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [arg : AstExpr]
  [ty : AstType]) : TcBorrowCheckResult
  (match (tc-borrow-check-expr ctx env locals borrowed arg)
    [(TcBorrowCheckResult.Ok borrowed1)
      (match (tc-borrow-check-after-consuming-value ctx locals borrowed1 arg ty)
        [(TcBorrowCheckResult.Ok borrowed2)
          (if (= (tc-moved-len borrowed2) 0)
            (TcBorrowCheckResult.Ok borrowed2)
            (tc-borrow-check-after-reading-value ctx locals borrowed2 arg ty))]
        [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])]
    [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))

(define (tc-borrow-check-arg-with-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [arg : AstExpr]
  [ty : AstType]) : TcBorrowCheckResult
  (match (cfg
    compile-profile
    (compiler-tc-reinfer-profile-effective-arg-expr
      "borrow.call_arg"
      ctx
      env
      arg
      ty)
    (tc-call-effective-arg-expr ctx env arg ty))
    [(ResultTcExpr.Ok effective)
      (tc-borrow-check-effective-arg-with-type
        ctx
        env
        locals
        borrowed
        effective
        ty)]
    [(ResultTcExpr.Err message)
      (TcBorrowCheckResult.Err (tc-locate-error-at-expr arg message))]))

(define (tc-borrow-check-exprs-with-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : AstExprList]
  [types : AstTypeList]) : TcBorrowCheckResult
  (tc-borrow-check-exprs-with-types-at
    ctx
    env
    locals
    borrowed
    (& exprs)
    (& types)
    0))

(define (tc-borrow-check-exprs-with-types-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : (& exprs AstExprList)]
  [types : (& types AstTypeList)]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index (struct-get exprs len))
    (if (>= index (ast-type-list-len types))
      (TcBorrowCheckResult.Ok borrowed)
      (TcBorrowCheckResult.Err "typecheck: arity mismatch"))
    (if (>= index (ast-type-list-len types))
      (TcBorrowCheckResult.Err "typecheck: arity mismatch")
      (let
        [head-expr : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
        [ty : AstType
          (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))]
        (match (tc-borrow-check-arg-with-type
          ctx
          env
          locals
          borrowed
          head-expr
          ty)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-exprs-with-types-at
              ctx
              env
              locals
              borrowed1
              exprs
              types
              (+ index 1))]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])))))

(define (tc-borrow-check-activate-two-phase-mut-borrows-loop
  [borrowed : TcMovedSet]
  [map : hashmap.StringI64Map]
  [index : i64]
  [primary : AstExpr]) : TcBorrowCheckResult
  (if (>= index (hashmap.string-i64-map-capacity map))
    (TcBorrowCheckResult.Ok borrowed)
    (match (hashmap.string-i64-map-entry-at map index)
      [(hashmap.StringI64MapEntrySome key _)
        (let
          [next : i64 (hashmap.string-i64-map-next-occupied map (+ index 1))]
          (if (tc-moved-path-key? key)
            (let
              [path : String (tc-moved-conflict-display-path key)]
              (if (tc-borrow-check-two-phase-mut-path? path)
                (let
                  [display-path : String
                    (tc-borrow-check-two-phase-mut-original-path path)]
                  (match (tc-moved-path-conflict borrowed display-path)
                    [(TcMoveConflict.Some _ _)
                      (TcBorrowCheckResult.Err
                        (tc-borrow-check-rich-conflict-message
                          borrowed
                          display-path
                          display-path
                          primary
                          (tc-borrow-check-mutably-borrow-message display-path)))]
                    [TcMoveConflict.No
                      (tc-borrow-check-activate-two-phase-mut-borrows-loop
                        borrowed
                        map
                        next
                        primary)]))
                (tc-borrow-check-activate-two-phase-mut-borrows-loop
                  borrowed
                  map
                  next
                  primary)))
            (tc-borrow-check-activate-two-phase-mut-borrows-loop
              borrowed
              map
              next
              primary)))]
      [(hashmap.StringI64MapEntryNone)
        (tc-borrow-check-activate-two-phase-mut-borrows-loop
          borrowed
          map
          (hashmap.string-i64-map-next-occupied map (+ index 1))
          primary)])))

(define (tc-borrow-check-activate-two-phase-mut-borrows
  [borrowed : TcMovedSet]
  [primary : AstExpr]) : TcBorrowCheckResult
  (tc-borrow-check-activate-two-phase-mut-borrows-loop
    borrowed
    (tc-moved-map borrowed)
    (hashmap.string-i64-map-next-occupied (tc-moved-map borrowed) 0)
    primary))

(define (tc-borrow-check-reserve-two-phase-mut-call-arg
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [borrow-expr : AstExpr]
  [place : AstExpr]) : TcBorrowCheckResult
  (match (tc-borrow-check-place-read-conflict locals borrowed place borrow-expr)
    [(TcBorrowCheckResult.Ok borrowed0)
      (match (tc-borrow-check-expr ctx env locals borrowed0 place)
        [(TcBorrowCheckResult.Ok borrowed1)
          (match (tc-borrow-place ctx env place)
            [(ResultTcBorrowPlace.Ok _)
              (tc-borrow-check-add-two-phase-mut-place
                locals
                borrowed1
                place
                borrow-expr)]
            [(ResultTcBorrowPlace.Err message)
              (TcBorrowCheckResult.Err message)])]
        [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])]
    [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))

(define (tc-borrow-check-call-args-two-phase-with-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [reserved : bool]
  [call-expr : AstExpr]
  [exprs : AstExprList]
  [types : AstTypeList]) : TcBorrowCheckResult
  (tc-borrow-check-call-args-two-phase-with-types-at
    ctx
    env
    locals
    borrowed
    reserved
    call-expr
    (& exprs)
    (& types)
    0))

(define (tc-borrow-check-call-args-two-phase-with-types-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [reserved : bool]
  [call-expr : AstExpr]
  [exprs : (& exprs AstExprList)]
  [types : (& types AstTypeList)]
  [index : i64]) : TcBorrowCheckResult
  (begin
    (when
      (>= index (struct-get exprs len))
      (return
        (if (>= index (ast-type-list-len types))
          (if reserved
            (tc-borrow-check-activate-two-phase-mut-borrows borrowed call-expr)
            (TcBorrowCheckResult.Ok borrowed))
          (TcBorrowCheckResult.Err "typecheck: arity mismatch"))))
    (when
      (>= index (ast-type-list-len types))
      (return (TcBorrowCheckResult.Err "typecheck: arity mismatch")))
    (let
      [head-expr : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
      [ty : AstType
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))]
      (match (cfg
        compile-profile
        (compiler-tc-reinfer-profile-effective-arg-expr
          "borrow.call_arg"
          ctx
          env
          head-expr
          ty)
        (tc-call-effective-arg-expr ctx env head-expr ty))
        [(ResultTcExpr.Ok effective-head)
          (match (ast-expr-unspan effective-head)
            [(AstExpr.Borrow mutable _ place-box)
              (if (and mutable (tc-call-mutable-ref-formal? ctx ty))
                (let
                  [place : AstExpr (ast-node-get place-box)]
                  (match (tc-borrow-check-reserve-two-phase-mut-call-arg
                    ctx
                    env
                    locals
                    borrowed
                    effective-head
                    place)
                    [(TcBorrowCheckResult.Ok borrowed1)
                      (tc-borrow-check-call-args-two-phase-with-types-at
                        ctx
                        env
                        locals
                        borrowed1
                        true
                        call-expr
                        exprs
                        types
                        (+ index 1))]
                    [(TcBorrowCheckResult.Err message)
                      (TcBorrowCheckResult.Err message)]))
                (match (tc-borrow-check-effective-arg-with-type
                  ctx
                  env
                  locals
                  borrowed
                  effective-head
                  ty)
                  [(TcBorrowCheckResult.Ok borrowed1)
                    (tc-borrow-check-call-args-two-phase-with-types-at
                      ctx
                      env
                      locals
                      borrowed1
                      reserved
                      call-expr
                      exprs
                      types
                      (+ index 1))]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)]))]
            [_
              (match (tc-borrow-check-effective-arg-with-type
                ctx
                env
                locals
                borrowed
                effective-head
                ty)
                [(TcBorrowCheckResult.Ok borrowed1)
                  (tc-borrow-check-call-args-two-phase-with-types-at
                    ctx
                    env
                    locals
                    borrowed1
                    reserved
                    call-expr
                    exprs
                    types
                    (+ index 1))]
                [(TcBorrowCheckResult.Err message)
                  (TcBorrowCheckResult.Err message)])])]
        [(ResultTcExpr.Err message)
          (TcBorrowCheckResult.Err (tc-locate-error-at-expr head-expr message))]))))

(define (tc-call-explicit-borrow-expr? [expr : AstExpr]) : bool
  (match (ast-expr-unspan expr)
    [(AstExpr.Borrow _ _ _) true]
    [_ false]))

(define (tc-borrow-check-add-call-arg-auto-borrow
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [arg : AstExpr]
  [ty : AstType]) : TcBorrowCheckResult
  (if (tc-call-explicit-borrow-expr? arg)
    (TcBorrowCheckResult.Ok borrowed)
    (match (cfg
      compile-profile
      (compiler-tc-reinfer-profile-effective-arg-expr
        "borrow.call_arg"
        ctx
        env
        arg
        ty)
      (tc-call-effective-arg-expr ctx env arg ty))
      [(ResultTcExpr.Ok effective)
        (match (ast-expr-unspan effective)
          [(AstExpr.Borrow mutable _ place-box)
            (let
              [place : AstExpr (ast-node-get place-box)]
              (tc-borrow-check-add-place-with-mutability
                locals
                borrowed
                mutable
                place
                arg))]
          [_ (TcBorrowCheckResult.Ok borrowed)])]
      [(ResultTcExpr.Err message)
        (TcBorrowCheckResult.Err (tc-locate-error-at-expr arg message))])))

(define (tc-borrow-check-auto-borrowed-call-args
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : AstExprList]
  [types : AstTypeList]) : TcBorrowCheckResult
  (tc-borrow-check-auto-borrowed-call-args-at
    ctx
    env
    locals
    borrowed
    (& args)
    (& types)
    0))

(define (tc-borrow-check-auto-borrowed-call-args-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : (& args AstExprList)]
  [types : (& types AstTypeList)]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index (struct-get args len))
    (if (>= index (ast-type-list-len types))
      (TcBorrowCheckResult.Ok borrowed)
      (TcBorrowCheckResult.Err "typecheck: arity mismatch"))
    (if (>= index (ast-type-list-len types))
      (TcBorrowCheckResult.Err "typecheck: arity mismatch")
      (let
        [head-expr : AstExpr (ast-node-get (ast-expr-list-get args index 0))]
        [ty : AstType
          (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))]
        (match (tc-borrow-check-add-call-arg-auto-borrow
          ctx
          env
          locals
          borrowed
          head-expr
          ty)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-auto-borrowed-call-args-at
              ctx
              env
              locals
              borrowed1
              args
              types
              (+ index 1))]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])))))

(define (tc-borrow-check-thread-channel-send-message
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [func : AstExpr]
  [args : AstExprList]
  [params : AstTypeList]) : TcBorrowCheckResult
  (if (tc-thread-channel-send-call? ctx env func)
    (match (tc-thread-channel-send-call-name func)
      [(TcMaybeString.Some _)
        (match (tc-thread-channel-send-message-param params)
          [(ResultTcType.Ok message-ty)
            (match (tc-thread-channel-send-message-arg args)
              [(ResultTcExpr.Ok message-expr)
                (tc-borrow-check-after-move-only-value
                  ctx
                  locals
                  borrowed
                  message-expr
                  message-ty)]
              [(ResultTcExpr.Err message) (TcBorrowCheckResult.Err message)])]
          [(ResultTcType.Err message) (TcBorrowCheckResult.Err message)])]
      [(TcMaybeString.No) (TcBorrowCheckResult.Ok borrowed)])
    (TcBorrowCheckResult.Ok borrowed)))

(define (tc-borrow-check-string-helper-intrinsic-call?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [func : AstExpr]) : bool
  (match (ast-expr-unspan func)
    [(AstExpr.Var raw-name)
      (let
        [name : String (tc-hygiene-global-call-name (intern-str raw-name))]
        [name-id : i64 (tc-builtin-name-id name)]
        [lookup-id : i64 (tc-call-builtin-lookup-id ctx env name name-id)]
        (or
          (tc-string-length-helper-call-id? ctx env name-id lookup-id)
          (tc-string-ref-helper-call-id? ctx env name-id lookup-id)))]
    [_ false]))

(define (tc-borrow-check-call-args-with-types
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : AstExpr]
  [func : AstExpr]
  [args : AstExprList]
  [types : AstTypeList]
  [return-lifetimes : TcBorrowCallReturnLifetimes]) : TcBorrowCheckResult
  (if (tc-borrow-check-string-helper-intrinsic-call? ctx env func)
    (match (tc-borrow-check-read-exprs
      ctx
      env
      locals
      (tc-moved-clone borrowed)
      args)
      [(TcBorrowCheckResult.Ok _)
        (tc-borrow-check-after-call-effects
          ctx
          env
          locals
          borrowed
          call-expr
          func
          args
          return-lifetimes)]
      [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])
    (let
      [validation-borrowed : TcMovedSet (tc-moved-clone borrowed)]
      [validation-result : TcBorrowCheckResult
        (tc-borrow-check-call-args-two-phase-with-types
          ctx
          env
          locals
          validation-borrowed
          false
          call-expr
          args
          types)]
      (match validation-result
        [(TcBorrowCheckResult.Ok _)
          (if (tc-call-type-list-has-immutable-ref-formal? ctx types)
            (match (tc-borrow-check-auto-borrowed-call-args
              ctx
              env
              locals
              borrowed
              args
              types)
              [(TcBorrowCheckResult.Ok borrowed2)
                (match (tc-borrow-check-thread-channel-send-message
                  ctx
                  env
                  locals
                  borrowed2
                  func
                  args
                  types)
                  [(TcBorrowCheckResult.Ok borrowed3)
                    (tc-borrow-check-after-call-effects
                      ctx
                      env
                      locals
                      borrowed3
                      call-expr
                      func
                      args
                      return-lifetimes)]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])
            (match (tc-borrow-check-thread-channel-send-message
              ctx
              env
              locals
              borrowed
              func
              args
              types)
              [(TcBorrowCheckResult.Ok borrowed2)
                (tc-borrow-check-after-call-effects
                  ctx
                  env
                  locals
                  borrowed2
                  call-expr
                  func
                  args
                  return-lifetimes)]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)]))]
        [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))))

(define (tc-borrow-check-exprs-retry-after-prune
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : AstExprList]
  [head : AstExpr]
  [rest : AstExprList]
  [message : String]) : TcBorrowCheckResult
  (if (= (tc-moved-len borrowed) 0)
    (TcBorrowCheckResult.Err message)
    (let
      [borrowed0 : TcMovedSet
        (tc-borrow-check-prune-before-exprs ctx env borrowed protected exprs)]
      (if (= (tc-moved-len borrowed0) (tc-moved-len borrowed))
        (TcBorrowCheckResult.Err message)
        (match (tc-borrow-check-expr ctx env locals borrowed0 head)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-exprs-with-protected
              ctx
              env
              locals
              borrowed1
              protected
              rest)]
          [(TcBorrowCheckResult.Err retry-message)
            (TcBorrowCheckResult.Err retry-message)])))))

(define (tc-borrow-check-exprs-with-protected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : AstExprList]) : TcBorrowCheckResult
  (tc-borrow-check-exprs-with-protected-at
    ctx
    env
    locals
    borrowed
    protected
    (& exprs)
    0))

(define (tc-borrow-check-exprs-with-protected-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index (struct-get exprs len))
    (TcBorrowCheckResult.Ok borrowed)
    (let
      [head : i64 (ast-expr-list-get exprs index 0)]
      (match (tc-borrow-check-expr-id ctx env locals borrowed head)
        [(TcBorrowCheckResult.Ok borrowed1)
          (tc-borrow-check-exprs-with-protected-at
            ctx
            env
            locals
            borrowed1
            protected
            exprs
            (+ index 1))]
        [(TcBorrowCheckResult.Err message)
          (let
            [head-expr : AstExpr (ast-node-get head)]
            [rest : AstExprList (ast-expr-list-tail-from-ref exprs (+ index 1))]
            [current : AstExprList (ast-expr-list-tail-from-ref exprs index)]
            (tc-borrow-check-exprs-retry-after-prune
              ctx
              env
              locals
              borrowed
              protected
              current
              head-expr
              rest
              message))]))))

(define (tc-borrow-check-exprs
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : AstExprList]) : TcBorrowCheckResult
  (tc-borrow-check-exprs-with-protected ctx env locals borrowed borrowed exprs))

(define (tc-borrow-check-expr-with-protected-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [expr-id : i64]) : TcBorrowCheckResult
  (tc-borrow-check-expr-with-protected
    ctx
    env
    locals
    borrowed
    protected
    (ast-node-get expr-id)))

(define (tc-borrow-check-expr-with-protected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [expr : AstExpr]) : TcBorrowCheckResult
  (match expr
    [(AstExpr.Spanned inner-box _)
      (tc-borrow-check-expr-with-protected-id
        ctx
        env
        locals
        borrowed
        protected
        inner-box)]
    [(AstExpr.Begin exprs)
      (tc-borrow-check-exprs-with-protected
        ctx
        env
        locals
        borrowed
        protected
        exprs)]
    [(AstExpr.Unsafe exprs)
      (tc-borrow-check-exprs-with-protected
        ctx
        env
        locals
        borrowed
        protected
        exprs)]
    [_ (tc-borrow-check-expr ctx env locals borrowed expr)]))

(define (tc-borrow-check-expr-type-contains-lifetime?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [lifetime : String]) : bool
  (match (tc-expr ctx env expr)
    [(ResultTcType.Ok ty)
      (tc-borrow-check-type-contains-lifetime? ctx ty lifetime)]
    [(ResultTcType.Err _) false]))

(define (tc-borrow-check-expr-list-stores-lifetime?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : AstExprList]
  [lifetime : String]) : bool
  (tc-borrow-check-expr-list-stores-lifetime-at? ctx env (& exprs) 0 lifetime))

(define (tc-borrow-check-expr-list-stores-lifetime-at?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [lifetime : String]) : bool
  (if (>= index (struct-get exprs len))
    false
    (if (tc-borrow-check-expr-stores-lifetime?
      ctx
      env
      (ast-node-get (ast-expr-list-get exprs index 0))
      lifetime)
      true
      (tc-borrow-check-expr-list-stores-lifetime-at?
        ctx
        env
        exprs
        (+ index 1)
        lifetime))))

(define (tc-borrow-check-let-bindings-store-lifetime?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : AstLetBindingList]
  [lifetime : String]) : bool
  (tc-borrow-check-let-bindings-store-lifetime-at?
    ctx
    env
    (& bindings)
    lifetime
    0))

(define (tc-borrow-check-let-bindings-store-lifetime-at?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [bindings : (& bindings AstLetBindingList)]
  [lifetime : String]
  [index : i64]) : bool
  (if (>= index (ast-let-binding-list-len bindings))
    false
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding _ _ init-box)
        (if (tc-borrow-check-expr-stores-lifetime?
          ctx
          env
          (ast-node-get init-box)
          lifetime)
          true
          (tc-borrow-check-let-bindings-store-lifetime-at?
            ctx
            env
            bindings
            lifetime
            (+ index 1)))])))

(define (tc-borrow-check-match-arms-store-lifetime?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arms : AstMatchArmList]
  [lifetime : String]) : bool
  (tc-borrow-check-match-arms-store-lifetime-at? ctx env (& arms) lifetime 0))

(define (tc-borrow-check-match-arms-store-lifetime-at?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [arms : (& arms AstMatchArmList)]
  [lifetime : String]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    false
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm _ body-box)
        (if (tc-borrow-check-expr-stores-lifetime?
          ctx
          env
          (ast-node-get body-box)
          lifetime)
          true
          (tc-borrow-check-match-arms-store-lifetime-at?
            ctx
            env
            arms
            lifetime
            (+ index 1)))])))

(define (tc-borrow-check-expr-stores-lifetime?
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [lifetime : String]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (tc-borrow-check-expr-stores-lifetime?
        ctx
        env
        (ast-node-get inner-box)
        lifetime)]
    [(AstExpr.Ann inner-box _)
      (tc-borrow-check-expr-stores-lifetime?
        ctx
        env
        (ast-node-get inner-box)
        lifetime)]
    [(AstExpr.Cast inner-box _)
      (tc-borrow-check-expr-stores-lifetime?
        ctx
        env
        (ast-node-get inner-box)
        lifetime)]
    [(AstExpr.Begin exprs)
      (tc-borrow-check-expr-list-stores-lifetime? ctx env exprs lifetime)]
    [(AstExpr.Unsafe exprs)
      (tc-borrow-check-expr-list-stores-lifetime? ctx env exprs lifetime)]
    [(AstExpr.If cond-box then-box else-box)
      (or
        (tc-borrow-check-expr-stores-lifetime?
          ctx
          env
          (ast-node-get cond-box)
          lifetime)
        (tc-borrow-check-expr-stores-lifetime?
          ctx
          env
          (ast-node-get then-box)
          lifetime)
        (tc-borrow-check-expr-stores-lifetime?
          ctx
          env
          (ast-node-get else-box)
          lifetime))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (or
            (tc-borrow-check-let-bindings-store-lifetime?
              ctx
              env
              bindings
              lifetime)
            (tc-borrow-check-expr-stores-lifetime?
              ctx
              env
              (ast-node-get body-box)
              lifetime))])]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrut-box arms)
          (or
            (tc-borrow-check-expr-stores-lifetime?
              ctx
              env
              (ast-node-get scrut-box)
              lifetime)
            (tc-borrow-check-match-arms-store-lifetime? ctx env arms lifetime))])]
    [(AstExpr.Set name rhs-box)
      (let
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-set-expr-id env name-text rhs-box)
            [(ResultTcExprId.Ok virtual-id)
              (tc-borrow-check-expr-stores-lifetime?
                ctx
                env
                (ast-node-get virtual-id)
                lifetime)]
            [(ResultTcExprId.Err _) false])
          (match (tc-lookup env name-text)
            [(ResultTcType.Ok ty)
              (tc-borrow-check-type-contains-lifetime? ctx ty lifetime)]
            [(ResultTcType.Err _) false])))]
    [(AstExpr.ArraySet array-box _ _)
      (tc-borrow-check-expr-type-contains-lifetime?
        ctx
        env
        (ast-node-get array-box)
        lifetime)]
    [(AstExpr.ArrayPush array-box _)
      (tc-borrow-check-expr-type-contains-lifetime?
        ctx
        env
        (ast-node-get array-box)
        lifetime)]
    [(AstExpr.StructSet receiver-box _ _)
      (tc-borrow-check-expr-type-contains-lifetime?
        ctx
        env
        (ast-node-get receiver-box)
        lifetime)]
    [(AstExpr.BoxSet box-box _)
      (tc-borrow-check-expr-type-contains-lifetime?
        ctx
        env
        (ast-node-get box-box)
        lifetime)]
    [_ false]))

(define (tc-borrow-check-loop-protect-carried-facts-loop
  [ctx : TcContext]
  [loop-env : TcTypeEnv]
  [before : TcMovedSet]
  [after-map : hashmap.StringI64Map]
  [index : i64]
  [out : TcMovedSet]) : TcMovedSet
  (if (>= index (hashmap.string-i64-map-capacity after-map))
    out
    (match (hashmap.string-i64-map-entry-at after-map index)
      [(hashmap.StringI64MapEntrySome key value)
        (let
          [next : i64
            (hashmap.string-i64-map-next-occupied after-map (+ index 1))]
          [out2 : TcMovedSet
            (if (or
              (not (tc-moved-path-key? key))
              (tc-moved-contains? before key)
              (tc-moved-contains? out key))
              out
              (tc-moved-add-value out key value))]
          (tc-borrow-check-loop-protect-carried-facts-loop
            ctx
            loop-env
            before
            after-map
            next
            out2))]
      [(hashmap.StringI64MapEntryNone)
        (tc-borrow-check-loop-protect-carried-facts-loop
          ctx
          loop-env
          before
          after-map
          (hashmap.string-i64-map-next-occupied after-map (+ index 1))
          out)])))

(define (tc-borrow-check-loop-protect-carried-facts
  [ctx : TcContext]
  [loop-env : TcTypeEnv]
  [before : TcMovedSet]
  [after : TcMovedSet]
  [protected : TcMovedSet]) : TcMovedSet
  (tc-borrow-check-loop-protect-carried-facts-loop
    ctx
    loop-env
    before
    (tc-moved-map after)
    (hashmap.string-i64-map-next-occupied (tc-moved-map after) 0)
    protected))

(define (tc-borrow-check-loop-protect-stored-facts-loop
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [map : hashmap.StringI64Map]
  [index : i64]
  [out : TcMovedSet]) : TcMovedSet
  (if (>= index (hashmap.string-i64-map-capacity map))
    out
    (match (hashmap.string-i64-map-entry-at map index)
      [(hashmap.StringI64MapEntrySome key value)
        (let
          [next : i64 (hashmap.string-i64-map-next-occupied map (+ index 1))]
          [out2 : TcMovedSet
            (if (or (not (tc-moved-path-key? key)) (tc-moved-contains? out key))
              out
              (let
                [path : String (tc-moved-conflict-display-path key)]
                [lifetime : String (tc-borrow-check-path-lifetime ctx env path)]
                (if (tc-borrow-check-expr-stores-lifetime?
                  ctx
                  env
                  expr
                  lifetime)
                  (tc-moved-add-value out key value)
                  out)))]
          (tc-borrow-check-loop-protect-stored-facts-loop
            ctx
            env
            expr
            map
            next
            out2))]
      [(hashmap.StringI64MapEntryNone)
        (tc-borrow-check-loop-protect-stored-facts-loop
          ctx
          env
          expr
          map
          (hashmap.string-i64-map-next-occupied map (+ index 1))
          out)])))

(define (tc-borrow-check-loop-protect-stored-facts
  [ctx : TcContext]
  [env : TcTypeEnv]
  [expr : AstExpr]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]) : TcMovedSet
  (tc-borrow-check-loop-protect-stored-facts-loop
    ctx
    env
    expr
    (tc-moved-map borrowed)
    (hashmap.string-i64-map-next-occupied (tc-moved-map borrowed) 0)
    protected))

(define (tc-borrow-check-loop-visible-body-borrows
  [ctx : TcContext]
  [loop-env : TcTypeEnv]
  [entry : TcMovedSet]
  [body-borrowed : TcMovedSet]) : TcMovedSet
  (tc-moved-union
    (tc-borrow-check-loop-protect-carried-facts
      ctx
      loop-env
      entry
      body-borrowed
      (tc-moved-empty))
    entry))

(define (tc-borrow-check-exprs-loop-retry-after-prune
  [ctx : TcContext]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : AstExprList]
  [head : AstExpr]
  [rest : AstExprList]
  [message : String]) : TcBorrowCheckResult
  (if (= (tc-moved-len borrowed) 0)
    (TcBorrowCheckResult.Err message)
    (let
      [borrowed0 : TcMovedSet
        (tc-borrow-check-prune-before-exprs ctx env borrowed protected exprs)]
      (if (= (tc-moved-len borrowed0) (tc-moved-len borrowed))
        (TcBorrowCheckResult.Err message)
        (match (tc-borrow-check-expr-loop
          ctx
          env
          loop-env
          locals
          borrowed0
          protected
          head)
          [(TcBorrowCheckResult.Ok borrowed1)
            (let
              [protected1 : TcMovedSet
                (tc-borrow-check-loop-protect-stored-facts
                  ctx
                  env
                  head
                  borrowed1
                  (tc-borrow-check-loop-protect-carried-facts
                    ctx
                    loop-env
                    borrowed0
                    borrowed1
                    protected))]
              (tc-borrow-check-exprs-loop
                ctx
                env
                loop-env
                locals
                borrowed1
                protected1
                rest))]
          [(TcBorrowCheckResult.Err retry-message)
            (TcBorrowCheckResult.Err retry-message)])))))

(define (tc-borrow-check-exprs-loop
  [ctx : TcContext]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : AstExprList]) : TcBorrowCheckResult
  (tc-borrow-check-exprs-loop-at
    ctx
    env
    loop-env
    locals
    borrowed
    protected
    (& exprs)
    0))

(define (tc-borrow-check-exprs-loop-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index (struct-get exprs len))
    (TcBorrowCheckResult.Ok borrowed)
    (let
      [head : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
      (match (tc-borrow-check-expr-loop
        ctx
        env
        loop-env
        locals
        borrowed
        protected
        head)
        [(TcBorrowCheckResult.Ok borrowed1)
          (let
            [protected1 : TcMovedSet
              (tc-borrow-check-loop-protect-stored-facts
                ctx
                env
                head
                borrowed1
                (tc-borrow-check-loop-protect-carried-facts
                  ctx
                  loop-env
                  borrowed
                  borrowed1
                  protected))]
            (tc-borrow-check-exprs-loop-at
              ctx
              env
              loop-env
              locals
              borrowed1
              protected1
              exprs
              (+ index 1)))]
        [(TcBorrowCheckResult.Err message)
          (let
            [rest : AstExprList (ast-expr-list-tail-from-ref exprs (+ index 1))]
            [current : AstExprList (ast-expr-list-tail-from-ref exprs index)]
            (tc-borrow-check-exprs-loop-retry-after-prune
              ctx
              env
              loop-env
              locals
              borrowed
              protected
              current
              head
              rest
              message))]))))

(define (tc-borrow-check-arms-loop-join
  [ctx : TcContext]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [joined : TcMovedSet]) : TcBorrowCheckResult
  (tc-borrow-check-arms-loop-join-at
    ctx
    env
    loop-env
    locals
    borrowed
    scrut-ty
    (& arms)
    joined
    0))

(define (tc-borrow-check-arms-loop-join-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : AstType]
  [arms : (& arms AstMatchArmList)]
  [joined : TcMovedSet]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index (struct-get arms len))
    (TcBorrowCheckResult.Ok joined)
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (let
          [body : AstExpr (ast-node-get body-box)]
          (match (tc-bind-match-pattern ctx env scrut-ty pattern)
            [(ResultTcEnv.Ok arm-env)
              (match (tc-borrow-check-expr-loop
                ctx
                arm-env
                loop-env
                (tc-borrow-check-pattern-locals
                  ctx
                  scrut-ty
                  pattern
                  (tc-moved-clone locals))
                (tc-moved-clone borrowed)
                borrowed
                body)
                [(TcBorrowCheckResult.Ok arm-borrowed)
                  (let
                    [visible-arm-borrowed : TcMovedSet
                      (tc-borrow-check-remove-root-states
                        arm-borrowed
                        (tc-borrow-check-pattern-bound-names
                          ctx
                          scrut-ty
                          pattern))]
                    (tc-borrow-check-arms-loop-join-at
                      ctx
                      env
                      loop-env
                      locals
                      borrowed
                      scrut-ty
                      arms
                      (tc-moved-union joined visible-arm-borrowed)
                      (+ index 1)))]
                [(TcBorrowCheckResult.Err message)
                  (TcBorrowCheckResult.Err message)])]
            [(ResultTcEnv.Err message) (TcBorrowCheckResult.Err message)]))])))

(define (tc-borrow-check-arms-loop
  [ctx : TcContext]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : TcBorrowCheckResult
  (tc-borrow-check-arms-loop-join
    ctx
    env
    loop-env
    locals
    borrowed
    scrut-ty
    arms
    borrowed))

(define (tc-borrow-check-expr-loop
  [ctx : TcContext]
  [env : TcTypeEnv]
  [loop-env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [protected : TcMovedSet]
  [expr : AstExpr]) : TcBorrowCheckResult
  (match expr
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr-loop
          ctx
          env
          loop-env
          locals
          borrowed
          protected
          inner))]
    [(AstExpr.Begin exprs)
      (tc-borrow-check-exprs-loop
        ctx
        env
        loop-env
        locals
        borrowed
        protected
        exprs)]
    [(AstExpr.Unsafe exprs)
      (tc-borrow-check-exprs-loop
        ctx
        env
        loop-env
        locals
        borrowed
        protected
        exprs)]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed cond)
          [(TcBorrowCheckResult.Ok borrowedc)
            (match (tc-borrow-check-expr-loop
              ctx
              env
              loop-env
              (tc-moved-clone locals)
              (tc-moved-clone borrowedc)
              borrowedc
              then-branch)
              [(TcBorrowCheckResult.Ok borrowedt)
                (match (tc-borrow-check-expr-loop
                  ctx
                  env
                  loop-env
                  (tc-moved-clone locals)
                  (tc-moved-clone borrowedc)
                  borrowedc
                  else-branch)
                  [(TcBorrowCheckResult.Ok borrowede)
                    (TcBorrowCheckResult.Ok
                      (tc-moved-union borrowedt borrowede))]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-borrow-check-let-bindings
              ctx
              env
              (tc-moved-clone locals)
              (tc-moved-clone borrowed)
              bindings)
              [(TcBorrowCheckBindings.Ok env2 locals2 borrowed2)
                (match (tc-borrow-check-expr-loop
                  ctx
                  env2
                  loop-env
                  locals2
                  borrowed2
                  borrowed
                  body)
                  [(TcBorrowCheckResult.Ok body-borrowed)
                    (TcBorrowCheckResult.Ok
                      (tc-borrow-check-loop-visible-body-borrows
                        ctx
                        loop-env
                        borrowed
                        body-borrowed))]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckBindings.Err message)
                (TcBorrowCheckResult.Err message)]))])]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrut-box arms)
          (let
            [scrut : AstExpr (ast-node-get scrut-box)]
            (match (tc-borrow-check-expr ctx env locals borrowed scrut)
              [(TcBorrowCheckResult.Ok borroweds)
                (match (tc-body-type-fact-expr-id
                  "borrow.match_scrutinee"
                  ctx
                  env
                  scrut-box)
                  [(ResultTcType.Ok scrut-ty)
                    (tc-borrow-check-arms-loop
                      ctx
                      env
                      loop-env
                      locals
                      borroweds
                      scrut-ty
                      arms)]
                  [(ResultTcType.Err message) (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)]))])]
    [_ (tc-borrow-check-expr ctx env locals borrowed expr)]))

(define (tc-borrow-check-read-exprs
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : AstExprList]) : TcBorrowCheckResult
  (tc-borrow-check-read-exprs-at ctx env locals borrowed (& exprs) 0))

(define (tc-borrow-check-read-exprs-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [exprs : (& exprs AstExprList)]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index (struct-get exprs len))
    (TcBorrowCheckResult.Ok borrowed)
    (let
      [head : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
      (match (tc-borrow-check-expr ctx env locals borrowed head)
        [(TcBorrowCheckResult.Ok borrowed1)
          (if (= (tc-moved-len borrowed1) 0)
            (tc-borrow-check-read-exprs-at
              ctx
              env
              locals
              borrowed1
              exprs
              (+ index 1))
            (match (tc-borrow-check-place-read-conflict
              locals
              borrowed1
              head
              head)
              [(TcBorrowCheckResult.Ok borrowed2)
                (tc-borrow-check-read-exprs-at
                  ctx
                  env
                  locals
                  borrowed2
                  exprs
                  (+ index 1))]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)]))]
        [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))))

(define (tc-borrow-check-add-returned-call-arg-borrow
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [arg : AstExpr]
  [result-lifetimes : TcStringList]) : TcBorrowCheckResult
  (match (cfg
    compile-profile
    (compiler-tc-reinfer-profile-expr "borrow.return_arg" ctx env arg)
    (tc-expr ctx env arg))
    [(ResultTcType.Ok arg-ty)
      (if (tc-string-list-overlaps?
        (tc-type-collect-reference-lifetimes (tc-resolve-type ctx arg-ty))
        result-lifetimes)
        (match (ast-expr-unspan arg)
          [(AstExpr.Borrow mutable _ place-box)
            (let
              [place : AstExpr (ast-node-get place-box)]
              (tc-borrow-check-add-place-with-mutability
                locals
                borrowed
                mutable
                place
                arg))]
          [(AstExpr.Ann inner-box _)
            (let
              [inner : AstExpr (ast-node-get inner-box)]
              (tc-borrow-check-add-returned-call-arg-borrow
                ctx
                env
                locals
                borrowed
                inner
                result-lifetimes))]
          [(AstExpr.Cast inner-box _)
            (let
              [inner : AstExpr (ast-node-get inner-box)]
              (tc-borrow-check-add-returned-call-arg-borrow
                ctx
                env
                locals
                borrowed
                inner
                result-lifetimes))]
          [_ (TcBorrowCheckResult.Ok borrowed)])
        (TcBorrowCheckResult.Ok borrowed))]
    [(ResultTcType.Err _) (TcBorrowCheckResult.Ok borrowed)]))

(define (tc-borrow-check-add-returned-call-borrows
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : AstExprList]
  [result-lifetimes : TcStringList]) : TcBorrowCheckResult
  (tc-borrow-check-add-returned-call-borrows-at
    ctx
    env
    locals
    borrowed
    (& args)
    0
    result-lifetimes))

(define (tc-borrow-check-add-returned-call-borrows-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : (& args AstExprList)]
  [index : i64]
  [result-lifetimes : TcStringList]) : TcBorrowCheckResult
  (if (>= index (struct-get args len))
    (TcBorrowCheckResult.Ok borrowed)
    (let
      [arg : AstExpr (ast-node-get (ast-expr-list-get args index 0))]
      (match (tc-borrow-check-add-returned-call-arg-borrow
        ctx
        env
        locals
        borrowed
        arg
        result-lifetimes)
        [(TcBorrowCheckResult.Ok borrowed1)
          (tc-borrow-check-add-returned-call-borrows-at
            ctx
            env
            locals
            borrowed1
            args
            (+ index 1)
            result-lifetimes)]
        [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))))

(define (tc-borrow-check-after-returning-call-lifetimes
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [args : AstExprList]
  [result-lifetimes : TcStringList]) : TcBorrowCheckResult
  (match result-lifetimes
    [(TcStringList.Nil) (TcBorrowCheckResult.Ok borrowed)]
    [_
      (tc-borrow-check-add-returned-call-borrows
        ctx
        env
        locals
        borrowed
        args
        result-lifetimes)]))

(define (tc-borrow-check-after-returning-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [call-expr : AstExpr]
  [args : AstExprList]
  [return-lifetimes : TcBorrowCallReturnLifetimes]) : TcBorrowCheckResult
  (match return-lifetimes
    [(TcBorrowCallReturnLifetimes.Known result-lifetimes)
      (tc-borrow-check-after-returning-call-lifetimes
        ctx
        env
        locals
        borrowed
        args
        result-lifetimes)]
    [(TcBorrowCallReturnLifetimes.Fallback)
      (match (cfg
        compile-profile
        (compiler-tc-reinfer-profile-expr
          "borrow.return_call"
          ctx
          env
          call-expr)
        (tc-expr ctx env call-expr))
        [(ResultTcType.Ok result-ty)
          (tc-borrow-check-after-returning-call-lifetimes
            ctx
            env
            locals
            borrowed
            args
            (tc-type-collect-reference-lifetimes
              (tc-resolve-type ctx result-ty)))]
        [(ResultTcType.Err _) (TcBorrowCheckResult.Ok borrowed)])]))

(define (tc-borrow-check-let-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bindings : AstLetBindingList]) : TcBorrowCheckBindings
  (tc-borrow-check-let-bindings-at ctx env locals borrowed (& bindings) 0))

(define (tc-borrow-check-let-bindings-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]) : TcBorrowCheckBindings
  (if (>= index (ast-let-binding-list-len bindings))
    (TcBorrowCheckBindings.Ok env locals borrowed)
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (match (tc-borrow-check-expr-id ctx env locals borrowed init-box)
            [(TcBorrowCheckResult.Ok borrowed1)
              (let
                [binding-ty : AstType
                  (tc-move-binding-type-id
                    "borrow.let_init"
                    ctx
                    env
                    maybe-ty
                    init-box)]
                (match (tc-borrow-check-after-bind-known-type-id
                  ctx
                  env
                  locals
                  borrowed1
                  init-box
                  binding-ty)
                  [(TcBorrowCheckResult.Ok borrowed2)
                    (tc-borrow-check-let-bindings-at
                      ctx
                      (tc-bind-c-abi-fnptr-if-needed-id
                        ctx
                        env
                        name
                        binding-ty
                        init)
                      (tc-moved-add locals (intern-str name))
                      (tc-borrow-check-remove-root-state
                        borrowed2
                        (intern-str name))
                      bindings
                      (+ index 1))]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckBindings.Err message)]))]
            [(TcBorrowCheckResult.Err message)
              (TcBorrowCheckBindings.Err message)]))])))

(define (tc-borrow-check-resource-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bindings : AstResourceBindingList]) : TcBorrowCheckResourceBindings
  (tc-borrow-check-resource-bindings-at ctx env locals borrowed (& bindings) 0))

(define (tc-borrow-check-resource-bindings-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [bindings : (& bindings AstResourceBindingList)]
  [index : i64]) : TcBorrowCheckResourceBindings
  (if (>= index (ast-resource-binding-list-len bindings))
    (TcBorrowCheckResourceBindings.Ok env locals borrowed)
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding name init-box _)
        (let
          [_init : AstExpr (ast-node-get init-box)]
          (match (tc-borrow-check-expr-id ctx env locals borrowed init-box)
            [(TcBorrowCheckResult.Ok borrowed1)
              (match (tc-borrow-check-after-bind-id
                ctx
                env
                locals
                borrowed1
                init-box)
                [(TcBorrowCheckResult.Ok borrowed2)
                  (match (tc-body-type-fact-expr-id
                    "borrow.resource_init"
                    ctx
                    env
                    init-box)
                    [(ResultTcType.Ok init-ty)
                      (tc-borrow-check-resource-bindings-at
                        ctx
                        (tc-bind-id
                          (tc-bind-cleanup-owner env (intern-str name))
                          name
                          (tc-type-without-regions init-ty))
                        (tc-moved-add locals (intern-str name))
                        (tc-borrow-check-remove-root-state
                          borrowed2
                          (intern-str name))
                        bindings
                        (+ index 1))]
                    [(ResultTcType.Err message)
                      (TcBorrowCheckResourceBindings.Err message)])]
                [(TcBorrowCheckResult.Err message)
                  (TcBorrowCheckResourceBindings.Err message)])]
            [(TcBorrowCheckResult.Err message)
              (TcBorrowCheckResourceBindings.Err message)]))])))

(define (tc-borrow-check-arms-join
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]
  [joined : TcMovedSet]) : TcBorrowCheckResult
  (tc-borrow-check-arms-join-at
    ctx
    env
    locals
    borrowed
    scrut-ty
    (& arms)
    joined
    0))

(define (tc-borrow-check-arms-join-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : AstType]
  [arms : (& arms AstMatchArmList)]
  [joined : TcMovedSet]
  [index : i64]) : TcBorrowCheckResult
  (if (>= index (struct-get arms len))
    (TcBorrowCheckResult.Ok joined)
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (match (tc-bind-match-pattern ctx env scrut-ty pattern)
          [(ResultTcEnv.Ok arm-env)
            (match (tc-borrow-check-expr-id
              ctx
              arm-env
              (tc-borrow-check-pattern-locals
                ctx
                scrut-ty
                pattern
                (tc-moved-clone locals))
              (tc-moved-clone borrowed)
              body-box)
              [(TcBorrowCheckResult.Ok arm-borrowed)
                (let
                  [visible-arm-borrowed : TcMovedSet
                    (tc-borrow-check-remove-root-states
                      arm-borrowed
                      (tc-borrow-check-pattern-bound-names ctx scrut-ty pattern))]
                  (tc-borrow-check-arms-join-at
                    ctx
                    env
                    locals
                    borrowed
                    scrut-ty
                    arms
                    (tc-moved-union joined visible-arm-borrowed)
                    (+ index 1)))]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(ResultTcEnv.Err message) (TcBorrowCheckResult.Err message)])])))

(define (tc-borrow-check-arms
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : TcBorrowCheckResult
  (tc-borrow-check-arms-join ctx env locals borrowed scrut-ty arms borrowed))

(define (tc-borrow-check-expr-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr-id : i64]) : TcBorrowCheckResult
  (tc-borrow-check-expr ctx env locals borrowed (ast-node-get expr-id)))

(define (tc-borrow-check-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [locals : TcMovedSet]
  [borrowed : TcMovedSet]
  [expr : AstExpr]) : TcBorrowCheckResult
  (match expr
    [(AstExpr.Spanned inner-box _)
      (tc-borrow-check-expr-id ctx env locals borrowed inner-box)]
    [(AstExpr.Literal _) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.Var name)
      (let
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-expr-id env name-text)
            [(ResultTcExprId.Ok virtual-id)
              (tc-borrow-check-expr-id ctx env locals borrowed virtual-id)]
            [(ResultTcExprId.Err message) (TcBorrowCheckResult.Err message)])
          (TcBorrowCheckResult.Ok borrowed)))]
    [(AstExpr.Binary _ left-box right-box)
      (match (tc-borrow-check-expr-id ctx env locals borrowed left-box)
        [(TcBorrowCheckResult.Ok borrowed1)
          (tc-borrow-check-expr-id ctx env locals borrowed1 right-box)]
        [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])]
    [(AstExpr.Unary _ inner-box)
      (tc-borrow-check-expr-id ctx env locals borrowed inner-box)]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (match (tc-borrow-check-expr-id ctx env locals borrowed func-box)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-borrow-call-info-id-with-facts
              "borrow.call_func"
              ctx
              env
              func-box
              args)
              [(ResultTcBorrowCallInfo.Ok params return-lifetimes)
                (match (tc-call-extern-abi ctx func)
                  [(TcMaybeExternAbi.Some abi)
                    (if (tc-call-dynamic-c-varargs-abi? abi)
                      (match (tc-call-extern-varargs-params
                        ctx
                        env
                        args
                        params
                        abi)
                        [(ResultTcTypeList.Ok expanded-params)
                          (tc-borrow-check-call-args-with-types
                            ctx
                            env
                            locals
                            borrowed1
                            expr
                            func
                            args
                            expanded-params
                            (TcBorrowCallReturnLifetimes.Fallback))]
                        [(ResultTcTypeList.Err message)
                          (TcBorrowCheckResult.Err message)])
                      (tc-borrow-check-call-args-with-types
                        ctx
                        env
                        locals
                        borrowed1
                        expr
                        func
                        args
                        params
                        return-lifetimes))]
                  [(TcMaybeExternAbi.No)
                    (tc-borrow-check-call-args-with-types
                      ctx
                      env
                      locals
                      borrowed1
                      expr
                      func
                      args
                      params
                      return-lifetimes)])]
              [(ResultTcBorrowCallInfo.Err _)
                (match (tc-borrow-check-read-exprs
                  ctx
                  env
                  locals
                  (tc-moved-clone borrowed1)
                  args)
                  [(TcBorrowCheckResult.Ok _)
                    (tc-borrow-check-after-call-effects
                      ctx
                      env
                      locals
                      borrowed1
                      expr
                      func
                      args
                      (TcBorrowCallReturnLifetimes.Fallback))]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.BracketClause items)
      (tc-borrow-check-exprs ctx env locals borrowed items)]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (match (tc-borrow-check-expr-id ctx env locals borrowed cond-box)
        [(TcBorrowCheckResult.Ok borrowedc)
          (match (tc-borrow-check-expr-id
            ctx
            env
            (tc-moved-clone locals)
            (tc-moved-clone borrowedc)
            then-branch-box)
            [(TcBorrowCheckResult.Ok borrowedt)
              (match (tc-borrow-check-expr-id
                ctx
                env
                (tc-moved-clone locals)
                (tc-moved-clone borrowedc)
                else-branch-box)
                [(TcBorrowCheckResult.Ok borrowede)
                  (TcBorrowCheckResult.Ok (tc-moved-union borrowedt borrowede))]
                [(TcBorrowCheckResult.Err message)
                  (TcBorrowCheckResult.Err message)])]
            [(TcBorrowCheckResult.Err message)
              (TcBorrowCheckResult.Err message)])]
        [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (match (tc-borrow-check-let-bindings
            ctx
            env
            (tc-moved-clone locals)
            (tc-moved-clone borrowed)
            bindings)
            [(TcBorrowCheckBindings.Ok env2 locals2 borrowed2)
              (match (tc-borrow-check-expr-with-protected-id
                ctx
                env2
                locals2
                borrowed2
                borrowed
                body-box)
                [(TcBorrowCheckResult.Ok _) (TcBorrowCheckResult.Ok borrowed)]
                [(TcBorrowCheckResult.Err message)
                  (TcBorrowCheckResult.Err message)])]
            [(TcBorrowCheckBindings.Err message)
              (TcBorrowCheckResult.Err message)])])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params _ body-box)
          (match (tc-borrow-check-expr-id
            ctx
            (tc-bind-params ctx env params)
            (tc-move-params-locals params (tc-moved-clone locals))
            (tc-moved-empty)
            body-box)
            [(TcBorrowCheckResult.Ok _) (TcBorrowCheckResult.Ok borrowed)]
            [(TcBorrowCheckResult.Err message)
              (TcBorrowCheckResult.Err message)])])]
    [(AstExpr.Tuple exprs)
      (match (tc-body-type-fact-expr-list-types
        "borrow.tuple_list"
        ctx
        env
        exprs)
        [(ResultTcTypeList.Ok types)
          (tc-borrow-check-exprs-with-types ctx env locals borrowed exprs types)]
        [(ResultTcTypeList.Err _)
          (tc-borrow-check-exprs ctx env locals borrowed exprs)])]
    [(AstExpr.TupleRef inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed inner)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-place-read-conflict locals borrowed1 expr expr)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.Array exprs)
      (match (tc-body-type-fact-expr-list-types
        "borrow.array_list"
        ctx
        env
        exprs)
        [(ResultTcTypeList.Ok types)
          (tc-borrow-check-exprs-with-types ctx env locals borrowed exprs types)]
        [(ResultTcTypeList.Err _)
          (tc-borrow-check-exprs ctx env locals borrowed exprs)])]
    [(AstExpr.MakeArray _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed array)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-borrow-check-expr ctx env locals borrowed1 index)
              [(TcBorrowCheckResult.Ok borrowed2)
                (tc-borrow-check-place-read-conflict locals borrowed2 expr expr)]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [_value : AstExpr (ast-node-get value-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed array)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-borrow-check-expr ctx env locals borrowed1 index)
              [(TcBorrowCheckResult.Ok borrowed2)
                (match (tc-borrow-check-expr-id
                  ctx
                  env
                  locals
                  borrowed2
                  value-box)
                  [(TcBorrowCheckResult.Ok borrowed3)
                    (match (tc-borrow-check-after-bind-id
                      ctx
                      env
                      locals
                      borrowed3
                      value-box)
                      [(TcBorrowCheckResult.Ok borrowed4)
                        (match (tc-borrow-check-array-set-conflict
                          locals
                          borrowed4
                          array
                          index
                          array)
                          [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed4)]
                          [(ResultTcUnit.Err message)
                            (TcBorrowCheckResult.Err message)])]
                      [(TcBorrowCheckResult.Err message)
                        (TcBorrowCheckResult.Err message)])]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.StructSet receiver-box field value-box)
      (let
        [receiver : AstExpr (ast-node-get receiver-box)]
        [_value : AstExpr (ast-node-get value-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed receiver)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-borrow-check-expr-id ctx env locals borrowed1 value-box)
              [(TcBorrowCheckResult.Ok borrowed2)
                (match (tc-borrow-check-after-bind-id
                  ctx
                  env
                  locals
                  borrowed2
                  value-box)
                  [(TcBorrowCheckResult.Ok borrowed3)
                    (match (tc-borrow-check-struct-set-conflict
                      locals
                      borrowed3
                      receiver
                      (intern-str field)
                      receiver)
                      [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed3)]
                      [(ResultTcUnit.Err message)
                        (TcBorrowCheckResult.Err message)])]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.ArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [_value : AstExpr (ast-node-get value-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed array)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-borrow-check-expr-id ctx env locals borrowed1 value-box)
              [(TcBorrowCheckResult.Ok borrowed2)
                (match (tc-borrow-check-after-bind-id
                  ctx
                  env
                  locals
                  borrowed2
                  value-box)
                  [(TcBorrowCheckResult.Ok borrowed3)
                    (match (tc-borrow-check-root-mutation-conflict
                      locals
                      borrowed3
                      array
                      array)
                      [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed3)]
                      [(ResultTcUnit.Err message)
                        (TcBorrowCheckResult.Err message)])]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.StringRef str-box index-box)
      (let
        [str : AstExpr (ast-node-get str-box)]
        [index : AstExpr (ast-node-get index-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed str)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-borrow-check-expr ctx env locals borrowed1 index)
              [(TcBorrowCheckResult.Ok borrowed2)
                (tc-borrow-check-place-read-conflict locals borrowed2 expr expr)]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed cond)
          [(TcBorrowCheckResult.Ok borrowedc)
            (match (tc-borrow-check-expr-loop
              ctx
              env
              env
              (tc-moved-clone locals)
              (tc-moved-clone borrowedc)
              borrowedc
              body)
              [(TcBorrowCheckResult.Ok body-borrowed)
                (TcBorrowCheckResult.Ok
                  (tc-borrow-check-loop-visible-body-borrows
                    ctx
                    env
                    borrowedc
                    body-borrowed))]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.Begin exprs)
      (tc-borrow-check-exprs ctx env locals borrowed exprs)]
    [(AstExpr.Unsafe exprs)
      (tc-borrow-check-exprs ctx env locals borrowed exprs)]
    [(AstExpr.Set name rhs-box)
      (let
        [rhs : AstExpr (ast-node-get rhs-box)]
        [name-text : String (intern-str name)]
        (if (tc-dotted-local-field-name-id? env name)
          (match (tc-dotted-local-field-set-expr-id env name-text rhs-box)
            [(ResultTcExprId.Ok virtual-id)
              (tc-borrow-check-expr
                ctx
                env
                locals
                borrowed
                (ast-node-get virtual-id))]
            [(ResultTcExprId.Err message) (TcBorrowCheckResult.Err message)])
          (match (tc-borrow-check-expr-id ctx env locals borrowed rhs-box)
            [(TcBorrowCheckResult.Ok borrowed1)
              (match (tc-borrow-check-after-bind-id
                ctx
                env
                locals
                borrowed1
                rhs-box)
                [(TcBorrowCheckResult.Ok borrowed2)
                  (match (tc-borrow-check-assignment
                    locals
                    borrowed2
                    name-text
                    rhs)
                    [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed2)]
                    [(ResultTcUnit.Err message)
                      (TcBorrowCheckResult.Err message)])]
                [(TcBorrowCheckResult.Err message)
                  (TcBorrowCheckResult.Err message)])]
            [(TcBorrowCheckResult.Err message)
              (TcBorrowCheckResult.Err message)])))]
    [(AstExpr.Ann inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.Cast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.Borrow mutable _ inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (if (= (tc-moved-len borrowed) 0)
          (match (tc-borrow-check-expr ctx env locals borrowed inner)
            [(TcBorrowCheckResult.Ok borrowed1)
              (match (tc-borrow-place ctx env inner)
                [(ResultTcBorrowPlace.Ok _)
                  (tc-borrow-check-add-place-with-mutability
                    locals
                    borrowed1
                    mutable
                    inner
                    inner)]
                [(ResultTcBorrowPlace.Err message)
                  (TcBorrowCheckResult.Err message)])]
            [(TcBorrowCheckResult.Err message)
              (TcBorrowCheckResult.Err message)])
          (match (tc-borrow-check-place-read-conflict
            locals
            borrowed
            inner
            expr)
            [(TcBorrowCheckResult.Ok borrowed0)
              (match (tc-borrow-check-expr ctx env locals borrowed0 inner)
                [(TcBorrowCheckResult.Ok borrowed1)
                  (match (tc-borrow-place ctx env inner)
                    [(ResultTcBorrowPlace.Ok _)
                      (tc-borrow-check-add-place-with-mutability
                        locals
                        borrowed1
                        mutable
                        inner
                        inner)]
                    [(ResultTcBorrowPlace.Err message)
                      (TcBorrowCheckResult.Err message)])]
                [(TcBorrowCheckResult.Err message)
                  (TcBorrowCheckResult.Err message)])]
            [(TcBorrowCheckResult.Err message)
              (TcBorrowCheckResult.Err message)])))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrut-box arms)
          (let
            [scrut : AstExpr (ast-node-get scrut-box)]
            (match (tc-borrow-check-expr ctx env locals borrowed scrut)
              [(TcBorrowCheckResult.Ok borroweds)
                (match (tc-body-type-fact-expr-id
                  "borrow.match_scrutinee"
                  ctx
                  env
                  scrut-box)
                  [(ResultTcType.Ok scrut-ty)
                    (tc-borrow-check-arms
                      ctx
                      env
                      locals
                      borroweds
                      scrut-ty
                      arms)]
                  [(ResultTcType.Err message) (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)]))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach index index-ty start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (tc-borrow-check-expr ctx env locals borrowed start)
              [(TcBorrowCheckResult.Ok borrowed1)
                (match (tc-borrow-check-expr ctx env locals borrowed1 end)
                  [(TcBorrowCheckResult.Ok borrowed2)
                    (let
                      [index-name : String (intern-str index)]
                      [body-env : TcTypeEnv
                        (tc-bind-id env index (tc-resolve-type ctx index-ty))]
                      [body-locals : TcMovedSet
                        (tc-moved-add (tc-moved-clone locals) index-name)]
                      [body-entry : TcMovedSet
                        (tc-borrow-check-remove-root-state
                          (tc-moved-clone borrowed2)
                          index-name)]
                      (match (tc-borrow-check-expr-loop
                        ctx
                        body-env
                        env
                        body-locals
                        body-entry
                        body-entry
                        body)
                        [(TcBorrowCheckResult.Ok body-borrowed)
                          (TcBorrowCheckResult.Ok
                            (tc-borrow-check-loop-visible-body-borrows
                              ctx
                              env
                              body-entry
                              (tc-borrow-check-remove-root-state
                                body-borrowed
                                index-name)))]
                        [(TcBorrowCheckResult.Err message)
                          (TcBorrowCheckResult.Err message)]))]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)]))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce _ _ _ a-box b-box c-box d-box)
          (let
            [a : AstExpr (ast-node-get a-box)]
            [b : AstExpr (ast-node-get b-box)]
            [c : AstExpr (ast-node-get c-box)]
            [d : AstExpr (ast-node-get d-box)]
            (match (tc-borrow-check-expr ctx env locals borrowed a)
              [(TcBorrowCheckResult.Ok borrowed1)
                (match (tc-borrow-check-expr ctx env locals borrowed1 b)
                  [(TcBorrowCheckResult.Ok borrowed2)
                    (match (tc-borrow-check-expr ctx env locals borrowed2 c)
                      [(TcBorrowCheckResult.Ok borrowed3)
                        (tc-borrow-check-expr ctx env locals borrowed3 d)]
                      [(TcBorrowCheckResult.Err message)
                        (TcBorrowCheckResult.Err message)])]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)]))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            _
            index
            index-ty
            start-box
            end-box
            prefix
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            [index-name : String (intern-str index)]
            [prefix-name : String (intern-str prefix)]
            [value-env : TcTypeEnv
              (tc-bind-id env index (tc-resolve-type ctx index-ty))]
            [body-env : TcTypeEnv
              (tc-bind-id value-env prefix (tc-resolve-type ctx prefix-ty))]
            [value-locals : TcMovedSet
              (tc-moved-add (tc-moved-clone locals) index-name)]
            [body-locals : TcMovedSet
              (tc-moved-add (tc-moved-clone value-locals) prefix-name)]
            (match (tc-borrow-check-expr ctx env locals borrowed start)
              [(TcBorrowCheckResult.Ok borrowed1)
                (match (tc-borrow-check-expr ctx env locals borrowed1 end)
                  [(TcBorrowCheckResult.Ok borrowed2)
                    (match (tc-borrow-check-expr ctx env locals borrowed2 init)
                      [(TcBorrowCheckResult.Ok borrowed3)
                        (match (tc-borrow-check-expr-loop
                          ctx
                          value-env
                          env
                          value-locals
                          (tc-borrow-check-remove-root-state
                            (tc-moved-clone borrowed3)
                            index-name)
                          (tc-borrow-check-remove-root-state
                            (tc-moved-clone borrowed3)
                            index-name)
                          value)
                          [(TcBorrowCheckResult.Ok borrowed4)
                            (let
                              [body-entry : TcMovedSet
                                (tc-borrow-check-remove-root-state
                                  (tc-borrow-check-remove-root-state
                                    (tc-moved-clone borrowed4)
                                    index-name)
                                  prefix-name)]
                              (match (tc-borrow-check-expr-loop
                                ctx
                                body-env
                                env
                                body-locals
                                body-entry
                                body-entry
                                body)
                                [(TcBorrowCheckResult.Ok body-borrowed)
                                  (TcBorrowCheckResult.Ok
                                    (tc-borrow-check-loop-visible-body-borrows
                                      ctx
                                      env
                                      borrowed4
                                      (tc-borrow-check-remove-root-state
                                        (tc-borrow-check-remove-root-state
                                          body-borrowed
                                          index-name)
                                        prefix-name)))]
                                [(TcBorrowCheckResult.Err message)
                                  (TcBorrowCheckResult.Err message)]))]
                          [(TcBorrowCheckResult.Err message)
                            (TcBorrowCheckResult.Err message)])]
                      [(TcBorrowCheckResult.Err message)
                        (TcBorrowCheckResult.Err message)])]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)]))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed value)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 lane)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed value)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 lane)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.StructGet inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed inner)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-place-read-conflict locals borrowed1 expr expr)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.WithRegion _ exprs)
      (match (tc-borrow-check-exprs
        ctx
        env
        locals
        (tc-moved-clone borrowed)
        exprs)
        [(TcBorrowCheckResult.Ok _) (TcBorrowCheckResult.Ok borrowed)]
        [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])]
    [(AstExpr.WithEscape scratch-box exprs)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed scratch)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-borrow-check-exprs
              ctx
              env
              locals
              (tc-moved-clone borrowed1)
              exprs)
              [(TcBorrowCheckResult.Ok _) (TcBorrowCheckResult.Ok borrowed1)]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.WithScratch exprs)
      (match (tc-borrow-check-exprs
        ctx
        env
        locals
        (tc-moved-clone borrowed)
        exprs)
        [(TcBorrowCheckResult.Ok _) (TcBorrowCheckResult.Ok borrowed)]
        [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)])]
    [(AstExpr.InArena arena-box exprs)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed arena)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-borrow-check-exprs
              ctx
              env
              locals
              (tc-moved-clone borrowed1)
              exprs)
              [(TcBorrowCheckResult.Ok _) (TcBorrowCheckResult.Ok borrowed1)]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings exprs)
          (match (tc-borrow-check-resource-bindings
            ctx
            env
            locals
            (tc-moved-clone borrowed)
            bindings)
            [(TcBorrowCheckResourceBindings.Ok
                body-env
                body-locals
                body-borrowed)
              (match (tc-borrow-check-exprs-with-protected
                ctx
                body-env
                body-locals
                body-borrowed
                borrowed
                exprs)
                [(TcBorrowCheckResult.Ok _) (TcBorrowCheckResult.Ok borrowed)]
                [(TcBorrowCheckResult.Err message)
                  (TcBorrowCheckResult.Err message)])]
            [(TcBorrowCheckResourceBindings.Err message)
              (TcBorrowCheckResult.Err message)])])]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed inner)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-place-read-conflict locals borrowed1 expr expr)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed inner)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-expr ctx env inner)
              [(ResultTcType.Ok box-ty)
                (tc-borrow-check-after-consuming-value
                  ctx
                  locals
                  borrowed1
                  inner
                  box-ty)]
              [(ResultTcType.Err _) (TcBorrowCheckResult.Ok borrowed1)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.BoxSet box-box value-box)
      (let
        [box-expr : AstExpr (ast-node-get box-box)]
        [_value : AstExpr (ast-node-get value-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed box-expr)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-borrow-check-expr-id ctx env locals borrowed1 value-box)
              [(TcBorrowCheckResult.Ok borrowed2)
                (match (tc-borrow-check-after-bind-id
                  ctx
                  env
                  locals
                  borrowed2
                  value-box)
                  [(TcBorrowCheckResult.Ok borrowed3)
                    (match (tc-borrow-check-root-mutation-conflict
                      locals
                      borrowed3
                      (ast-node-get (ast-expr-box-get box-box))
                      box-expr)
                      [(ResultTcUnit.Ok) (TcBorrowCheckResult.Ok borrowed3)]
                      [(ResultTcUnit.Err message)
                        (TcBorrowCheckResult.Err message)])]
                  [(TcBorrowCheckResult.Err message)
                    (TcBorrowCheckResult.Err message)])]
              [(TcBorrowCheckResult.Err message)
                (TcBorrowCheckResult.Err message)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.TypeLiteral _) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.Init _) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.Quote _) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.Quasiquote _) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.Unquote _) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.UnquoteSplicing _) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.Return inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed inner)
          [(TcBorrowCheckResult.Ok borrowed1)
            (match (tc-current-return-type env)
              [(ResultTcType.Ok return-ty)
                (tc-borrow-check-after-consuming-value
                  ctx
                  locals
                  borrowed1
                  inner
                  return-ty)]
              [(ResultTcType.Err _) (TcBorrowCheckResult.Ok borrowed1)])]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.Break) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.Continue) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.PtrNull _) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.PtrNullCheck inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.PtrAddrOf _) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.PtrRead inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed ptr)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 value)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed ptr)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 offset)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.PtrCast inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.PtrToInt inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.IntToPtr inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.StringData inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed ptr)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 len)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.ArrayData inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (tc-borrow-check-expr ctx env locals borrowed inner))]
    [(AstExpr.BinaryData _) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.SpmdProgramIndex) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.SpmdProgramCount) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.ProgramArgc) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.ProgramArgv) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.ProgramEnvp) (TcBorrowCheckResult.Ok borrowed)]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed leaf)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 subleaf)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed leaf)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 subleaf)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed leaf)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 subleaf)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (match (tc-borrow-check-expr ctx env locals borrowed leaf)
          [(TcBorrowCheckResult.Ok borrowed1)
            (tc-borrow-check-expr ctx env locals borrowed1 subleaf)]
          [(TcBorrowCheckResult.Err message) (TcBorrowCheckResult.Err message)]))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (tc-borrow-check-expr ctx env locals borrowed index))]
    [(AstExpr.Syscall args)
      (tc-borrow-check-read-exprs ctx env locals borrowed args)]))

(define (tc-borrow-check-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]
  [body : AstExpr]) : ResultTcUnit
  (match (tc-borrow-check-expr-with-protected
    ctx
    env
    (tc-move-params-locals params (tc-moved-empty))
    (tc-moved-empty)
    (tc-moved-empty)
    body)
    [(TcBorrowCheckResult.Ok _) ResultTcUnit.Ok]
    [(TcBorrowCheckResult.Err message) (ResultTcUnit.Err message)]))

(define (tc-borrow-check-body-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [params : AstParamList]
  [body-id : i64]) : ResultTcUnit
  (match (tc-borrow-check-expr-with-protected-id
    ctx
    env
    (tc-move-params-locals params (tc-moved-empty))
    (tc-moved-empty)
    (tc-moved-empty)
    body-id)
    [(TcBorrowCheckResult.Ok _) ResultTcUnit.Ok]
    [(TcBorrowCheckResult.Err message) (ResultTcUnit.Err message)]))

;; --- macro expansion phase (#1139) ------------------------------------------
;;
;; Pipeline: parse -> EXPAND -> typecheck. When a call head names a `defmacro`,
;; the unevaluated operand forms are passed as `Expr` values (CompilerCtfeValue.Expr) to the
;; transformer, which is run via CTFE; the produced `Expr` is spliced at the
;; call site and re-expanded to a fixpoint (depth-limited). Macro calls in
;; ordinary evaluated positions are expanded; quoted/quasiquoted code is left
;; as data. Programs without macro calls pass through unchanged. The normal
;; typechecker then runs over the expanded program as the post-expansion safety
;; net. Call-site arity and operand signature checks run before the transformer
;; so obvious operand type errors are reported at the macro call site.
(defenum MacroMaybeDecl
  (No)
  (Some String String AstMacroParamList AstType AstExpr))

(defenum ResultMacroCallDecl
  (Ok MacroMaybeDecl)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroCallDeclModule
  (Ok MacroMaybeDecl String)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroExpr
  (Ok i64)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroCompatCall
  (Ok i64)
  (No)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroExprList
  (Ok AstExprList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroArms
  (Ok AstMatchArmList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroLetBindings
  (Ok AstLetBindingList TcTypeEnv)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroLetBindingsBuild
  (Ok TcTypeEnv)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroEnv
  (Ok CtfeEnv)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroCheck
  (Ok)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroModuleArg
  (Ok String)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroClause
  (Ok AstExprClause)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroClauseList
  (Ok AstExprClauseList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroBindingClause
  (Ok AstExprBindingClause)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroBindingClauseList
  (Ok AstExprBindingClauseList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroDecl
  (Ok AstDecl)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroDecls
  (Ok AstDeclList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroDeclExpansion
  (Ok AstDeclList AstDeclPathList)
  (Err (Box CompilerDiagnostic)))

(defenum MacroFollowupCause
  (ImportPlaceholder)
  (ExpandedDecl)
  (BlockedAfterInertSplice)
  (GeneratedImport)
  (ModulePlaceholder))

(defstruct MacroFollowupWork
  (start-index i64)
  (end-index i64)
  (start-path String)
  (end-path String)
  (module String)
  (cause MacroFollowupCause))

(defenum MacroFollowupWorkList
  (Nil)
  (Cons MacroFollowupWork (Box MacroFollowupWorkList)))

(defenum ResultMacroDeclsWithPaths
  (Ok AstDeclList AstDeclPathList MacroFollowupWorkList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroExpand
  (Ok AstProgram AstDeclPathList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroExpandPass
  (Ok AstProgram AstDeclPathList MacroFollowupWorkList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroLocalFollowup
  (Ok AstProgram AstDeclPathList MacroFollowupWorkList)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroValue
  (Ok CompilerCtfeValue)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroValueEnv
  (Ok CompilerCtfeValue CtfeEnv)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroTypeArg
  (Ok AstType)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroSexpr
  (Ok SpannedSexpr)
  (Err (Box CompilerDiagnostic)))

(defenum ResultMacroParsedDecls
  (Ok AstDeclList)
  (Err (Box CompilerDiagnostic)))

(defenum MacroMaybeModuleName
  (No)
  (Some String))

(defenum MacroMaybeDeclList
  (No)
  (Some AstDeclList))

(defenum MacroHygieneEnv
  (Nil)
  (Bind String String (Box MacroHygieneEnv)))

(defenum MacroHygieneName
  (Name String MacroHygieneEnv))

(defenum MacroHygieneParams
  (Params AstParamList MacroHygieneEnv))

(defenum MacroHygieneLetBindings
  (LetBindings AstLetBindingList MacroHygieneEnv))

(defenum MacroHygieneResourceBindings
  (ResourceBindings AstResourceBindingList MacroHygieneEnv))

(defenum MacroHygienePattern
  (Pattern AstPattern MacroHygieneEnv))

(defenum MacroHygienePatternList
  (PatternList AstPatternList MacroHygieneEnv))

(define macro-expand-active-module : String
  "")

;; Set of macro (and compat-guard) names callable in the program. Used as a
;; cheap, allocation-free pre-filter in the macro-use detector so the common
;; case (a plain function call whose name is not a macro) avoids the allocating
;; module-key lookup in `macro-call-decl`. Populated once per expansion run.
(define macro-expand-macro-names : TcStringList
  (TcStringList.Nil))

;; Macro names whose transformer bodies can call `expr-type`. Only those macros
;; need fixed `Expr` operands to carry produced type metadata.
(define macro-expand-expr-type-macro-names : TcStringList
  (TcStringList.Nil))

;; Cached CTFE base environment (reflection + layout metadata) for the current
;; expansion run. `macro-expand-call` rebuilt this via `tc-ctfe-env` -- which runs
;; `ctfe-reflections-from-program` over the WHOLE program (O(program)) -- on EVERY
;; macro call, costing ~150MB per call on a self-compile. The metadata is
;; invariant across an expansion run, so build it once per run and reuse.
(define macro-expand-ctfe-env-ready : bool
  false)
(define macro-expand-ctfe-env-value : CtfeEnv
  (ctfe-env-empty))

;; Whether the current compile needs the CTFE reflection/layout metadata at all
;; (i.e. the program contains a `(type T)` literal). Set per compile at the top of
;; macro-expand-program; when false, tc-ctfe-env returns an empty env and skips
;; the whole-program metadata build. Defaults true (build) for safety.
(define ctfe-needs-metadata : bool
  true)

(define (macro-zero-source-span) : token.SourceSpan
  (token.SourceSpan 1 1 1 1))

(define (macro-source-span-from-ast [span : AstSourceSpan]) : token.SourceSpan
  (token.SourceSpan
    (struct-get span start-line)
    (struct-get span start-col)
    (struct-get span end-line)
    (struct-get span end-col)))

(define (macro-output-syntax-diag [origin : AstExpr] [message : String]) : CompilerDiagnostic
  (ctfe-diagnostic-at-expr origin message))

(define (macro-output-syntax-name [name : String]) : String
  (if (tc-hygiene-template-name? name)
    (tc-hygiene-template-base name)
    name))

(define (macro-output-source-name [name : String]) : String
  (let
    [source-name : String
      (if (tc-hygiene-template-name? name)
        (tc-hygiene-template-base name)
        (tc-hygiene-global-symbol-name name))]
    (if (tc-source-slash-qualified? source-name)
      (tc-name-slashes-to-dots source-name)
      source-name)))

(define (macro-decl-list-reverse-into [items : AstDeclList] [out : AstDeclList]) : AstDeclList
  (let
    [cursor : AstDeclList items]
    [result : AstDeclList out]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons head rest)
            (begin
              (set! result (ast-decl-list-prepend-builder head result))
              (set! cursor rest))]))
      result)))

(define (macro-decl-list-reverse [items : AstDeclList]) : AstDeclList
  (macro-decl-list-reverse-into items (ast-decl-list-new)))

(define (macro-decl-list-append-from
  [out : (&mut out AstDeclList)]
  [items : (& items AstDeclList)]) : unit
  (let
    [index : i64 0]
    [count : i64 (ast-decl-list-len items)]
    (while (< index count)
      (begin
        (ast-decl-list-push
          out
          (ast-decl-list-get items index (ast-decl-fallback)))
        (set! index (+ index 1))))))

(define (macro-decl-list-append [left : AstDeclList] [right : AstDeclList]) : AstDeclList
  (let
    [out : AstDeclList
      (ast-decl-list-with-capacity
        (+ (ast-decl-list-len (& left)) (ast-decl-list-len (& right))))]
    (begin
      (macro-decl-list-append-from (&mut out) (& left))
      (macro-decl-list-append-from (&mut out) (& right))
      out)))

(define (macro-flatten-module-body-decls-into
  [decls : AstDeclList]
  [module : String]
  [out : AstDeclList]) : AstDeclList
  (let
    [cursor : AstDeclList decls]
    [current-module : String module]
    [result : AstDeclList out]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (match decl
                [(AstDecl.Module next-module)
                  (begin
                    (ast-decl-list-push (&mut result) decl)
                    (set! current-module (intern-str next-module)))]
                [(AstDecl.ModuleBody target-module-id body-box)
                  (let
                    [target-module : String (intern-str target-module-id)]
                    (begin
                      (ast-decl-list-push
                        (&mut result)
                        (ast-decl-module target-module))
                      (set!
                        result
                        (macro-flatten-module-body-decls-into
                          (box-get body-box)
                          target-module
                          result))
                      (ast-decl-list-push
                        (&mut result)
                        (ast-decl-module current-module))))]
                [_ (ast-decl-list-push (&mut result) decl)])
              (set! cursor rest))]))
      result)))

(define (macro-flatten-module-body-decls-in-module
  [decls : AstDeclList]
  [module : String]) : AstDeclList
  (macro-flatten-module-body-decls-into decls module (ast-decl-list-new)))

(define (macro-decl-path-list-reverse-into
  [items : AstDeclPathList]
  [out : AstDeclPathList]) : AstDeclPathList
  (let
    [cursor : AstDeclPathList items]
    [result : AstDeclPathList out]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-path-list-step cursor)
          [(AstDeclPathListStep.Nil) (set! done true)]
          [(AstDeclPathListStep.Cons head rest)
            (begin
              (set! result (ast-decl-path-list-prepend-builder head result))
              (set! cursor rest))]))
      result)))

(define (macro-decl-path-list-reverse [items : AstDeclPathList]) : AstDeclPathList
  (macro-decl-path-list-reverse-into items (ast-decl-path-list-new)))

(define (macro-decl-path-list-append-from
  [out : (&mut out AstDeclPathList)]
  [items : (& items AstDeclPathList)]) : unit
  (let
    [index : i64 0]
    [count : i64 (ast-decl-path-list-len items)]
    (while (< index count)
      (begin
        (ast-decl-path-list-push out (ast-decl-path-list-get items index ""))
        (set! index (+ index 1))))))

(define (macro-decl-path-list-append
  [left : AstDeclPathList]
  [right : AstDeclPathList]) : AstDeclPathList
  (let
    [out : AstDeclPathList
      (ast-decl-path-list-with-capacity
        (+ (ast-decl-path-list-len (& left)) (ast-decl-path-list-len (& right))))]
    (begin
      (macro-decl-path-list-append-from (&mut out) (& left))
      (macro-decl-path-list-append-from (&mut out) (& right))
      out)))

(define (macro-decl-list-current-suffix [head : AstDecl] [rest : AstDeclList]) : AstDeclList
  (let
    [offset : i64 (struct-get rest offset)]
    (if (> offset 0)
      (let
        [head-offset : i64 (- offset 1)]
        (begin
          (array-set! (struct-get rest slots) head-offset head)
          (AstDeclList
            (struct-get rest slots)
            head-offset
            (+ (struct-get rest len) 1)
            false)))
      (ast-decl-cons head rest))))

(define (macro-decl-path-list-current-suffix
  [head : String]
  [rest : AstDeclPathList]) : AstDeclPathList
  (let
    [offset : i64 (struct-get rest offset)]
    (if (> offset 0)
      (let
        [head-offset : i64 (- offset 1)]
        (begin
          (array-set! (struct-get rest slots) head-offset head)
          (AstDeclPathList
            (struct-get rest slots)
            head-offset
            (+ (struct-get rest len) 1)
            false)))
      (ast-decl-path-cons head rest))))

(define (macro-decl-list-prefix-rev-current-suffix
  [prefix-rev : AstDeclList]
  [suffix : AstDeclList]) : AstDeclList
  (let
    [prefix-count : i64 (ast-decl-list-len (& prefix-rev))]
    [suffix-offset : i64 (struct-get suffix offset)]
    (if (<= prefix-count suffix-offset)
      (let
        [cursor : AstDeclList prefix-rev]
        [write-index : i64 (- suffix-offset 1)]
        [done : bool false]
        (begin
          (while (not done)
            (match (ast-decl-list-step cursor)
              [(AstDeclListStep.Nil) (set! done true)]
              [(AstDeclListStep.Cons decl rest)
                (begin
                  (array-set! (struct-get suffix slots) write-index decl)
                  (set! write-index (- write-index 1))
                  (set! cursor rest))]))
          (AstDeclList
            (struct-get suffix slots)
            (- suffix-offset prefix-count)
            (+ prefix-count (struct-get suffix len))
            false)))
      (macro-decl-list-append (macro-decl-list-reverse prefix-rev) suffix))))

(define (macro-decl-path-list-prefix-rev-current-suffix
  [prefix-rev : AstDeclPathList]
  [suffix : AstDeclPathList]) : AstDeclPathList
  (let
    [prefix-count : i64 (ast-decl-path-list-len (& prefix-rev))]
    [suffix-offset : i64 (struct-get suffix offset)]
    (if (<= prefix-count suffix-offset)
      (let
        [cursor : AstDeclPathList prefix-rev]
        [write-index : i64 (- suffix-offset 1)]
        [done : bool false]
        (begin
          (while (not done)
            (match (ast-decl-path-list-step cursor)
              [(AstDeclPathListStep.Nil) (set! done true)]
              [(AstDeclPathListStep.Cons path rest)
                (begin
                  (array-set! (struct-get suffix slots) write-index path)
                  (set! write-index (- write-index 1))
                  (set! cursor rest))]))
          (AstDeclPathList
            (struct-get suffix slots)
            (- suffix-offset prefix-count)
            (+ prefix-count (struct-get suffix len))
            false)))
      (macro-decl-path-list-append
        (macro-decl-path-list-reverse prefix-rev)
        suffix))))

(define (macro-followup-work-list-empty? [items : MacroFollowupWorkList]) : bool
  (match items
    [(MacroFollowupWorkList.Nil) true]
    [(MacroFollowupWorkList.Cons _ _) false]))

(define (macro-followup-work-cons
  [head : MacroFollowupWork]
  [rest : MacroFollowupWorkList]) : MacroFollowupWorkList
  (MacroFollowupWorkList.Cons head (box rest)))

(define (macro-followup-work-list-reverse-into
  [items : MacroFollowupWorkList]
  [out : MacroFollowupWorkList]) : MacroFollowupWorkList
  (let
    [cursor : MacroFollowupWorkList items]
    [result : MacroFollowupWorkList out]
    [done : bool false]
    (begin
      (while (not done)
        (match cursor
          [(MacroFollowupWorkList.Nil) (set! done true)]
          [(MacroFollowupWorkList.Cons head rest)
            (begin
              (set! result (macro-followup-work-cons head result))
              (set! cursor (box-get rest)))]))
      result)))

(define (macro-followup-work-list-reverse [items : MacroFollowupWorkList]) : MacroFollowupWorkList
  (macro-followup-work-list-reverse-into items MacroFollowupWorkList.Nil))

(define (macro-local-followup-cause-supported? [cause : MacroFollowupCause]) : bool
  (match cause
    [(MacroFollowupCause.GeneratedImport) true]
    [(MacroFollowupCause.ModulePlaceholder) true]
    [(MacroFollowupCause.ExpandedDecl) false]
    [(MacroFollowupCause.ImportPlaceholder) false]
    [_ false]))

;; Keep local follow-up on small generated/module ranges; broader work falls
;; back to the existing whole-program fixed-point pass.
(define (macro-local-followup-range-limit) : i64
  256)

(define (macro-local-followup-work-supported? [items : MacroFollowupWorkList]) : bool
  (match items
    [(MacroFollowupWorkList.Nil) true]
    [(MacroFollowupWorkList.Cons work rest)
      (and
        (macro-local-followup-cause-supported? (struct-get work cause))
        (<=
          (- (struct-get work end-index) (struct-get work start-index))
          (macro-local-followup-range-limit))
        (macro-local-followup-work-supported? (box-get rest)))]))

(define (macro-followup-cause-expanded-decl? [cause : MacroFollowupCause]) : bool
  (match cause
    [(MacroFollowupCause.ExpandedDecl) true]
    [_ false]))

(define (macro-decl-contains-path-import? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Import (AstImportSpec.Spec kind _ _ _ _))
      (match kind
        [(AstImportKind.Path) true]
        [_ false])]
    [(AstDecl.ComptimeDecl _ template-box)
      (macro-decl-contains-path-import? (box-get template-box))]
    [(AstDecl.Unsafe inner-box)
      (macro-decl-contains-path-import? (box-get inner-box))]
    [_ false]))

(define (macro-decls-contain-path-import? [decls : AstDeclList]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (or
        (macro-decl-contains-path-import? decl)
        (macro-decls-contain-path-import? rest))]))

(define (macro-decl-list-replace-range
  [decls : AstDeclList]
  [start-index : i64]
  [end-index : i64]
  [replacement : AstDeclList]) : AstDeclList
  (macro-decl-list-append
    (tc-decl-list-take decls start-index)
    (macro-decl-list-append replacement (tc-decl-list-drop decls end-index))))

(define (macro-decl-path-list-replace-range
  [paths : AstDeclPathList]
  [start-index : i64]
  [end-index : i64]
  [replacement : AstDeclPathList]) : AstDeclPathList
  (macro-decl-path-list-append
    (tc-decl-path-list-take paths start-index)
    (macro-decl-path-list-append
      replacement
      (tc-decl-path-list-drop paths end-index))))

(define (macro-followup-path-list-first
  [paths : AstDeclPathList]
  [fallback : String]) : String
  (match (ast-decl-path-list-step paths)
    [(AstDeclPathListStep.Nil) fallback]
    [(AstDeclPathListStep.Cons path _) path]))

(define (macro-followup-path-list-last
  [paths : AstDeclPathList]
  [fallback : String]) : String
  (match (ast-decl-path-list-step paths)
    [(AstDeclPathListStep.Nil) fallback]
    [(AstDeclPathListStep.Cons path rest)
      (macro-followup-path-list-last rest path)]))

(define (macro-followup-work-at
  [start-index : i64]
  [end-index : i64]
  [start-path : String]
  [end-path : String]
  [module : String]
  [cause : MacroFollowupCause]) : MacroFollowupWorkList
  (macro-followup-work-cons
    (MacroFollowupWork start-index end-index start-path end-path module cause)
    MacroFollowupWorkList.Nil))

(define (macro-followup-work-shift [work : MacroFollowupWork] [offset : i64]) : MacroFollowupWork
  (MacroFollowupWork
    (+ (struct-get work start-index) offset)
    (+ (struct-get work end-index) offset)
    (struct-get work start-path)
    (struct-get work end-path)
    (struct-get work module)
    (struct-get work cause)))

(define (macro-followup-work-list-shift
  [items : MacroFollowupWorkList]
  [offset : i64]) : MacroFollowupWorkList
  (match items
    [(MacroFollowupWorkList.Nil) MacroFollowupWorkList.Nil]
    [(MacroFollowupWorkList.Cons work rest)
      (macro-followup-work-cons
        (macro-followup-work-shift work offset)
        (macro-followup-work-list-shift (box-get rest) offset))]))

(define (macro-followup-work-for-decls
  [start-index : i64]
  [decls : AstDeclList]
  [paths : AstDeclPathList]
  [module : String]
  [cause : MacroFollowupCause]) : MacroFollowupWorkList
  (let
    [start-path : String (macro-followup-path-list-first paths "")]
    [end-path : String (macro-followup-path-list-last paths start-path)]
    [end-index : i64 (+ start-index (ast-decl-list-count decls))]
    (macro-followup-work-at
      start-index
      end-index
      start-path
      end-path
      module
      cause)))

(cfg
  test
  (define (macro-followup-test-cause-code [cause : MacroFollowupCause]) : i64
    (match cause
      [(MacroFollowupCause.ImportPlaceholder) 1]
      [(MacroFollowupCause.ExpandedDecl) 2]
      [(MacroFollowupCause.BlockedAfterInertSplice) 3]
      [(MacroFollowupCause.GeneratedImport) 4]
      [(MacroFollowupCause.ModulePlaceholder) 5])))

(cfg
  test
  (define (macro-followup-test-head [items : MacroFollowupWorkList]) : MacroFollowupWork
    (match items
      [(MacroFollowupWorkList.Cons work _) work]
      [(MacroFollowupWorkList.Nil)
        (begin
          (test.assert-true false "expected follow-up work")
          (MacroFollowupWork 0 0 "" "" "" MacroFollowupCause.GeneratedImport))])))

(cfg
  test
  (test
    macro-followup-generated-import-work-metadata
    (let
      [decls : AstDeclList
        (ast-decl-cons (ast-decl-module "generated.module") (ast-decl-list-new))]
      [paths : AstDeclPathList
        (ast-decl-path-cons "generated.tl" (ast-decl-path-list-new))]
      [items : MacroFollowupWorkList
        (macro-followup-work-for-decls
          2
          decls
          paths
          "owner.module"
          MacroFollowupCause.GeneratedImport)]
      [work : MacroFollowupWork (macro-followup-test-head items)]
      [actual-start-path : String (struct-get work start-path)]
      [actual-end-path : String (struct-get work end-path)]
      [expected-path : String "generated.tl"]
      [actual-module : String (struct-get work module)]
      [expected-module : String "owner.module"]
      (begin
        (test.assert-false
          (macro-followup-work-list-empty? items)
          "generated import work should be present")
        (test.assert-i64-eq
          (struct-get work start-index)
          2
          "generated import work start")
        (test.assert-i64-eq
          (struct-get work end-index)
          3
          "generated import work end")
        (test.assert-string-eq
          (& actual-start-path)
          (& expected-path)
          "generated import start path")
        (test.assert-string-eq
          (& actual-end-path)
          (& expected-path)
          "generated import end path")
        (test.assert-string-eq
          (& actual-module)
          (& expected-module)
          "generated import module")
        (test.assert-i64-eq
          (macro-followup-test-cause-code (struct-get work cause))
          4
          "generated import cause")))))

(cfg
  test
  (test
    macro-followup-module-placeholder-work-metadata
    (let
      [span : AstSourceSpan (AstSourceSpan 1 1 1 1)]
      [placeholder : AstDecl
        (AstDecl.Import
          (AstImportSpec.Spec
            (AstImportKind.MacroDecls 0 AstMaybeModuleName.No)
            "stdlib/vector.tl"
            AstMaybeModuleName.No
            AstMaybeImportAlias.No
            span))]
      [decls : AstDeclList
        (ast-decl-cons
          (ast-decl-module "owner.module")
          (ast-decl-cons placeholder (ast-decl-list-new)))]
      [paths : AstDeclPathList
        (ast-decl-path-cons
          "owner.tl"
          (ast-decl-path-cons "owner.tl" (ast-decl-path-list-new)))]
      [items : MacroFollowupWorkList
        (macro-module-placeholder-followup-work-list decls paths)]
      [work : MacroFollowupWork (macro-followup-test-head items)]
      [actual-path : String (struct-get work start-path)]
      [expected-path : String "owner.tl"]
      [actual-module : String (struct-get work module)]
      [expected-module : String "owner.module"]
      (begin
        (test.assert-false
          (macro-followup-work-list-empty? items)
          "module placeholder work should be present")
        (test.assert-i64-eq
          (struct-get work start-index)
          1
          "module placeholder work start")
        (test.assert-i64-eq
          (struct-get work end-index)
          2
          "module placeholder work end")
        (test.assert-string-eq
          (& actual-path)
          (& expected-path)
          "module placeholder path")
        (test.assert-string-eq
          (& actual-module)
          (& expected-module)
          "module placeholder module")
        (test.assert-i64-eq
          (macro-followup-test-cause-code (struct-get work cause))
          5
          "module placeholder cause")))))

(define (macro-paths-for-decls [decls : AstDeclList] [path : String]) : AstDeclPathList
  (let
    [out : AstDeclPathList
      (ast-decl-path-list-with-capacity (ast-decl-list-len (& decls)))]
    [index : i64 0]
    [count : i64 (ast-decl-list-len (& decls))]
    (begin
      (while (< index count)
        (begin
          (ast-decl-path-list-push (&mut out) path)
          (set! index (+ index 1))))
      out)))

(define (macro-decls-final-module [decls : AstDeclList] [module : String]) : String
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) module]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        (match decl
          [(AstDecl.Module next-module)
            (macro-decls-final-module rest (intern-str next-module))]
          [(AstDecl.ModuleBody _ _)
            (macro-decls-final-module
              (macro-flatten-module-body-decls-in-module decls module)
              module)]
          [_ (macro-decls-final-module rest module)]))]))

(define (macro-decls-module-count [decls : AstDeclList]) : i64
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) 0]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest-count : i64 (macro-decls-module-count rest)]
        (match decl
          [(AstDecl.Module _) (+ rest-count 1)]
          [(AstDecl.ModuleBody _ body-box)
            (+ rest-count (+ 1 (macro-decls-module-count (box-get body-box))))]
          [_ rest-count]))]))

(define (macro-identity-key-join [head : String] [tail : String]) : String
  (if (> (string.string-length tail) 0)
    (str_cat.str-cat head ";" tail)
    head))

(define (macro-identity-key-string-expr
  [expr : AstExpr]
  [env : CtfeEnv]
  [fuel : i64]) : ResultGenKey
  (match (compiler-ctfe-eval expr env fuel)
    [(ResultCtfe.Ok value next-fuel)
      (match value
        [(CompilerCtfeValue.String text)
          (ResultGenKey.Ok (spec-string-key text) next-fuel)]
        [(CompilerCtfeValue.I64 n)
          (ResultGenKey.Ok
            (str_cat.str-cat "i64:" (string.int->string n))
            next-fuel)]
        [_
          (ResultGenKey.Err
            (box
              (ctfe-diagnostic-at-expr
                expr
                "typecheck: Module macro identity key expression must evaluate to String or i64")))])]
    [(ResultCtfe.Err diag) (ResultGenKey.Err diag)]))

(define (macro-identity-key-string-exprs
  [exprs : AstExprList]
  [env : CtfeEnv]
  [fuel : i64]) : ResultGenKey
  (macro-identity-key-string-exprs-at (& exprs) 0 env fuel))

(define (macro-identity-key-string-exprs-at
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [env : CtfeEnv]
  [fuel : i64]) : ResultGenKey
  (if (>= index (struct-get exprs len))
    (ResultGenKey.Ok "" fuel)
    (let
      [head-expr : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
      (match (macro-identity-key-string-expr head-expr env fuel)
        [(ResultGenKey.Ok head-key head-fuel)
          (match (macro-identity-key-string-exprs-at
            exprs
            (+ index 1)
            env
            head-fuel)
            [(ResultGenKey.Ok tail tail-fuel)
              (ResultGenKey.Ok
                (macro-identity-key-join head-key tail)
                tail-fuel)]
            [(ResultGenKey.Err diag) (ResultGenKey.Err diag)])]
        [(ResultGenKey.Err diag) (ResultGenKey.Err diag)]))))

(define (macro-identity-key-sexpr [sexpr : SpannedSexpr]) : String
  (match sexpr
    [(SpannedSexpr.Int _ text _)
      (str_cat.str-cat "int:" (spec-string-key text))]
    [(SpannedSexpr.Sym name _) (str_cat.str-cat "sym:" (spec-string-key name))]
    [(SpannedSexpr.Nil _) "nil"]
    [(SpannedSexpr.Cons head tail _)
      (str_cat.str-cat
        "cons:"
        (spec-string-key (macro-identity-key-sexpr (sp-node-get head)))
        ":"
        (spec-string-key (macro-identity-key-sexpr (sp-node-get tail))))]
    [(SpannedSexpr.Str text _) (str_cat.str-cat "str:" (spec-string-key text))]
    [(SpannedSexpr.Char c _)
      (str_cat.str-cat "char:" (string.int->string (cast c : i64)))]
    [(SpannedSexpr.Float text _)
      (str_cat.str-cat "float:" (spec-string-key text))]
    [(SpannedSexpr.BracketList items _)
      (str_cat.str-cat
        "bracket:"
        (spec-string-key (macro-identity-key-sexpr (sp-node-get items))))]))

(define (macro-identity-key-syntax-expr
  [expr : AstExpr]
  [origin : AstExpr]
  [fuel : i64]) : ResultGenKey
  (match (macro-expr-to-spanned-sexpr expr origin)
    [(ResultMacroSexpr.Ok sexpr)
      (ResultGenKey.Ok
        (str_cat.str-cat "syntax:" (macro-identity-key-sexpr sexpr))
        fuel)]
    [(ResultMacroSexpr.Err diag) (ResultGenKey.Err diag)]))

(define (macro-identity-syntax-param-type?
  [ctx : TcContext]
  [fallback-module : String]
  [ty : AstType]) : bool
  (let
    [resolved : AstType (macro-resolve-signature-type ctx fallback-module ty)]
    (or
      (tc-type-eq resolved (AstType.Expr))
      (tc-type-eq resolved (AstType.ExprList))
      (tc-macro-expr-clause-type? resolved)
      (tc-macro-expr-clause-list-type? resolved)
      (tc-macro-expr-binding-clause-type? resolved)
      (tc-macro-expr-binding-clause-list-type? resolved))))

(define (macro-identity-key-param-expr
  [ctx : TcContext]
  [fallback-module : String]
  [ty : AstType]
  [expr : AstExpr]
  [env : CtfeEnv]
  [fuel : i64]
  [call-expr : AstExpr]) : ResultGenKey
  (if (macro-identity-syntax-param-type? ctx fallback-module ty)
    (match (macro-identity-key-string-expr expr env fuel)
      [(ResultGenKey.Ok key next-fuel) (ResultGenKey.Ok key next-fuel)]
      [(ResultGenKey.Err _)
        (macro-identity-key-syntax-expr expr call-expr fuel)])
    (macro-identity-key-string-expr expr env fuel)))

(define (macro-identity-key-param-exprs
  [ctx : TcContext]
  [fallback-module : String]
  [ty : AstType]
  [exprs : AstExprList]
  [env : CtfeEnv]
  [fuel : i64]
  [call-expr : AstExpr]) : ResultGenKey
  (macro-identity-key-param-exprs-at
    ctx
    fallback-module
    ty
    (& exprs)
    0
    env
    fuel
    call-expr))

(define (macro-identity-key-param-exprs-at
  [ctx : TcContext]
  [fallback-module : String]
  [ty : AstType]
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [env : CtfeEnv]
  [fuel : i64]
  [call-expr : AstExpr]) : ResultGenKey
  (if (>= index (struct-get exprs len))
    (ResultGenKey.Ok "" fuel)
    (let
      [head-expr : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
      (match (macro-identity-key-param-expr
        ctx
        fallback-module
        ty
        head-expr
        env
        fuel
        call-expr)
        [(ResultGenKey.Ok head-key head-fuel)
          (match (macro-identity-key-param-exprs-at
            ctx
            fallback-module
            ty
            exprs
            (+ index 1)
            env
            head-fuel
            call-expr)
            [(ResultGenKey.Ok tail tail-fuel)
              (ResultGenKey.Ok
                (macro-identity-key-join head-key tail)
                tail-fuel)]
            [(ResultGenKey.Err diag) (ResultGenKey.Err diag)])]
        [(ResultGenKey.Err diag) (ResultGenKey.Err diag)]))))

(define (macro-identity-key-params
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [params : AstMacroParamList]
  [args : AstExprList]
  [env : CtfeEnv]
  [fuel : i64]
  [call-expr : AstExpr]) : ResultGenKey
  (macro-identity-key-params-at
    ctx
    decls
    fallback-module
    (& params)
    (& args)
    0
    env
    fuel
    call-expr))

(define (macro-identity-key-fixed-param
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [ty : AstType]
  [head-expr : AstExpr]
  [env : CtfeEnv]
  [fuel : i64]
  [call-expr : AstExpr]) : ResultGenKey
  (cond
    [(tc-macro-type-param-kind? ty)
      (match (macro-type-arg-with-fallback ctx decls fallback-module head-expr)
        [(ResultMacroTypeArg.Ok resolved-ty)
          (ResultGenKey.Ok
            (str_cat.str-cat "type_" (ctfe-type-key resolved-ty))
            fuel)]
        [(ResultMacroTypeArg.Err diag) (ResultGenKey.Err diag)])]
    [(tc-macro-module-param-kind? ty)
      (match (macro-module-strategy-arg-with-fallback
        ctx
        fallback-module
        head-expr)
        [(ResultMacroModuleArg.Ok module)
          (ResultGenKey.Ok
            (str_cat.str-cat "module_" (spec-string-key module))
            fuel)]
        [(ResultMacroModuleArg.Err diag) (ResultGenKey.Err diag)])]
    [else
      (macro-identity-key-param-expr
        ctx
        fallback-module
        ty
        head-expr
        env
        fuel
        call-expr)]))

(define (macro-identity-key-params-at
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [params : (& params AstMacroParamList)]
  [args : (& args AstExprList)]
  [index : i64]
  [env : CtfeEnv]
  [fuel : i64]
  [call-expr : AstExpr]) : ResultGenKey
  (cond
    [(>= index (ast-macro-param-list-len params))
      (if (>= index (struct-get args len))
        (ResultGenKey.Ok "" fuel)
        (ResultGenKey.Err
          (box
            (ctfe-diagnostic-at-expr
              (ast-node-get (ast-expr-list-get args index 0))
              "macro call has too many arguments"))))]
    [else
      (match (ast-macro-param-list-get params index (ast-macro-param-fallback))
        [(AstMacroParam.Param _ ty variadic)
          (if variadic
            (cond
              [(tc-macro-type-param-kind? ty)
                (ResultGenKey.Err
                  (box
                    (ctfe-diagnostic-at-expr
                      call-expr
                      "typecheck: type macro operand cannot be variadic")))]
              [(tc-macro-module-param-kind? ty)
                (ResultGenKey.Err
                  (box
                    (ctfe-diagnostic-at-expr
                      call-expr
                      "typecheck: Module macro operand cannot be variadic")))]
              [(macro-identity-syntax-param-type? ctx fallback-module ty)
                (macro-identity-key-param-exprs-at
                  ctx
                  fallback-module
                  ty
                  args
                  index
                  env
                  fuel
                  call-expr)]
              [else (macro-identity-key-string-exprs-at args index env fuel)])
            (if (>= index (struct-get args len))
              (ResultGenKey.Err
                (box
                  (ctfe-diagnostic-at-expr
                    call-expr
                    "macro call has too few arguments")))
              (let
                [head-expr : AstExpr
                  (ast-node-get (ast-expr-list-get args index 0))]
                (match (macro-identity-key-fixed-param
                  ctx
                  decls
                  fallback-module
                  ty
                  head-expr
                  env
                  fuel
                  call-expr)
                  [(ResultGenKey.Ok head-key head-fuel)
                    (match (macro-identity-key-params-at
                      ctx
                      decls
                      fallback-module
                      params
                      args
                      (+ index 1)
                      env
                      head-fuel
                      call-expr)
                      [(ResultGenKey.Ok tail tail-fuel)
                        (ResultGenKey.Ok
                          (macro-identity-key-join head-key tail)
                          tail-fuel)]
                      [(ResultGenKey.Err diag) (ResultGenKey.Err diag)])]
                  [(ResultGenKey.Err diag) (ResultGenKey.Err diag)]))))])]))

(define (macro-module-identity
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [macro-name : String]
  [definition-module : String]
  [params : AstMacroParamList]
  [args : AstExprList]
  [env : CtfeEnv]
  [call-expr : AstExpr]) : ResultGenKey
  (match (macro-identity-key-params
    ctx
    decls
    fallback-module
    params
    args
    env
    (ctfe-fuel-limit)
    call-expr)
    [(ResultGenKey.Ok arg-key fuel)
      (ResultGenKey.Ok
        (str_cat.str-cat definition-module ":" macro-name "(" arg-key ")")
        fuel)]
    [(ResultGenKey.Err diag) (ResultGenKey.Err diag)]))

(define (macro-decls-generated-key [identity : String]) : String
  (string.append "decls:" identity))

(define (macro-generated-meta
  [generator : String]
  [item : String]
  [key : String]) : AstGeneratedDeclMeta
  (AstGeneratedDeclMeta.Some generator item (ast-expr-list-new) key))

(define (macro-import-placeholder-kind? [kind : AstImportKind]) : bool
  (match kind
    [(AstImportKind.Macro _ _) true]
    [(AstImportKind.MacroDecls _ _) true]
    [_ false]))

(define (macro-decl-import-placeholder? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Import (AstImportSpec.Spec kind _ _ _ _))
      (macro-import-placeholder-kind? kind)]
    [(AstDecl.ComptimeDecl _ template-box)
      (macro-decl-import-placeholder? (box-get template-box))]
    [_ false]))

(define (macro-wrap-generated-decl
  [decl : AstDecl]
  [generator : String]
  [key : String]) : AstDecl
  (match decl
    [(AstDecl.Module _) decl]
    [(AstDecl.Import _)
      (ast-decl-comptime-decl-with-meta
        (macro-generated-meta generator "import" key)
        decl)]
    [_
      (match (gen-decl-visible-name decl)
        [(SpecMaybeString.Some item)
          (ast-decl-comptime-decl-with-meta
            (macro-generated-meta generator item key)
            decl)]
        [(SpecMaybeString.None) decl])]))

(define (macro-wrap-generated-decls
  [decls : AstDeclList]
  [generator : String]
  [key : String]) : AstDeclList
  (let
    [count : i64 (ast-decl-list-len (& decls))]
    [cursor : AstDeclList decls]
    [out : AstDeclList (ast-decl-list-with-capacity count)]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (ast-decl-list-push
                (&mut out)
                (macro-wrap-generated-decl decl generator key))
              (set! cursor rest))]))
      out)))

(define (macro-wrap-generated-decl-decls
  [decl : AstDecl]
  [generator : String]
  [key : String]) : AstDecl
  (match (gen-decl-visible-name decl)
    [(SpecMaybeString.Some item)
      (ast-decl-comptime-decl-with-meta
        (macro-generated-meta generator item key)
        decl)]
    [(SpecMaybeString.None) decl]))

(define (macro-wrap-generated-decls-decls
  [decls : AstDeclList]
  [generator : String]
  [key : String]) : AstDeclList
  (let
    [count : i64 (ast-decl-list-len (& decls))]
    [cursor : AstDeclList decls]
    [out : AstDeclList (ast-decl-list-with-capacity count)]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (ast-decl-list-push
                (&mut out)
                (macro-wrap-generated-decl-decls decl generator key))
              (set! cursor rest))]))
      out)))

(define (macro-generated-context-import-kind
  [kind : AstImportKind]
  [definition-module : String]) : AstImportKind
  (match kind
    [(AstImportKind.Macro call-id context)
      (match context
        [(AstMaybeModuleName.No)
          (AstImportKind.Macro
            call-id
            (AstMaybeModuleName.Some definition-module))]
        [_ kind])]
    [(AstImportKind.MacroDecls call-id context)
      (match context
        [(AstMaybeModuleName.No)
          (AstImportKind.MacroDecls
            call-id
            (AstMaybeModuleName.Some definition-module))]
        [_ kind])]
    [_ kind]))

(define (macro-generated-context-decl
  [decl : AstDecl]
  [definition-module : String]) : AstDecl
  (match decl
    [(AstDecl.Import (AstImportSpec.Spec kind path target alias span))
      (AstDecl.Import
        (AstImportSpec.Spec
          (macro-generated-context-import-kind kind definition-module)
          path
          target
          alias
          span))]
    [(AstDecl.Unsafe inner-box)
      (ast-decl-unsafe
        (macro-generated-context-decl (box-get inner-box) definition-module))]
    [(AstDecl.ComptimeDecl meta inner-box)
      (ast-decl-comptime-decl-with-meta
        meta
        (macro-generated-context-decl (box-get inner-box) definition-module))]
    [(AstDecl.ModuleBody name body-box)
      (ast-decl-module-body-id
        name
        (macro-generated-context-decls (box-get body-box) definition-module))]
    [_ decl]))

(define (macro-generated-context-decls
  [decls : AstDeclList]
  [definition-module : String]) : AstDeclList
  (let
    [count : i64 (ast-decl-list-len (& decls))]
    [cursor : AstDeclList decls]
    [out : AstDeclList (ast-decl-list-with-capacity count)]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (ast-decl-list-push
                (&mut out)
                (macro-generated-context-decl decl definition-module))
              (set! cursor rest))]))
      out)))

(define (macro-decl-generated-key? [decl : AstDecl] [key : String]) : bool
  (match decl
    [(AstDecl.ComptimeDecl meta template-box)
      (match meta
        [(AstGeneratedDeclMeta.Some _ _ _ meta-key)
          (if (string.eq meta-key key)
            true
            (macro-decl-generated-key? (box-get template-box) key))]
        [(AstGeneratedDeclMeta.No)
          (macro-decl-generated-key? (box-get template-box) key)])]
    [(AstDecl.Unsafe inner-box)
      (macro-decl-generated-key? (box-get inner-box) key)]
    [_ false]))

(define (macro-decl-generated-import-placeholder?
  [decl : AstDecl]
  [key : String]) : bool
  (match decl
    [(AstDecl.ComptimeDecl meta template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (match meta
          [(AstGeneratedDeclMeta.Some _ _ _ meta-key)
            (if (string.eq meta-key key)
              (macro-decl-import-placeholder? template)
              (macro-decl-generated-import-placeholder? template key))]
          [(AstGeneratedDeclMeta.No)
            (macro-decl-generated-import-placeholder? template key)]))]
    [(AstDecl.Unsafe inner-box)
      (macro-decl-generated-import-placeholder? (box-get inner-box) key)]
    [_ false]))

(define (macro-decl-import? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.Import _) true]
    [(AstDecl.ComptimeDecl _ template-box)
      (macro-decl-import? (box-get template-box))]
    [(AstDecl.Unsafe inner-box) (macro-decl-import? (box-get inner-box))]
    [_ false]))

(define (macro-decls-contain-generated-key?
  [decls : AstDeclList]
  [key : String]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (or
        (macro-decl-generated-key? decl key)
        (macro-decls-contain-generated-key? rest key))]))

(define (macro-decls-filter-generated-key [decls : AstDeclList] [key : String]) : AstDeclList
  (let
    [cursor : AstDeclList decls]
    [out-rev : AstDeclList (ast-decl-list-new)]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (if (and
                (macro-decl-generated-key? decl key)
                (not (macro-decl-import? decl)))
                (set! out-rev (ast-decl-list-prepend-builder decl out-rev))
                unit)
              (set! cursor rest))]))
      (macro-decl-list-reverse out-rev))))

(define (macro-decls-filter-generated-key-context
  [decls : AstDeclList]
  [key : String]) : AstDeclList
  (let
    [cursor : AstDeclList decls]
    [out-rev : AstDeclList (ast-decl-list-new)]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (if (or
                (macro-decl-import? decl)
                (macro-decl-generated-key? decl key))
                (set! out-rev (ast-decl-list-prepend-builder decl out-rev))
                unit)
              (set! cursor rest))]))
      (macro-decl-list-reverse out-rev))))

(define (macro-decl-list-contains-structural?
  [decls : AstDeclList]
  [want : AstDecl]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (or
        (gen-decl-eq? decl want)
        (macro-decl-list-contains-structural? rest want))]))

(define (macro-decls-missing-generated-imports
  [generated-body : AstDeclList]
  [existing-body : AstDeclList]) : AstDeclList
  (let
    [cursor : AstDeclList generated-body]
    [out-rev : AstDeclList (ast-decl-list-new)]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (if (and
                (macro-decl-import? decl)
                (not (macro-decl-list-contains-structural? existing-body decl)))
                (set! out-rev (ast-decl-list-prepend-builder decl out-rev))
                unit)
              (set! cursor rest))]))
      (macro-decl-list-reverse out-rev))))

(define (macro-module-replay-marker-decls
  [target-module : String]
  [owner-module : String]
  [alias : AstMaybeImportAlias]
  [span : AstSourceSpan]
  [generated-body : AstDeclList]
  [existing-body : AstDeclList]) : AstDeclList
  (let
    [marker-decls : AstDeclList
      (macro-module-import-marker-decls target-module alias span)]
    [missing-imports : AstDeclList
      (macro-decls-missing-generated-imports generated-body existing-body)]
    (match (ast-decl-list-step missing-imports)
      [(AstDeclListStep.Nil) marker-decls]
      [_
        (macro-decl-list-append
          (ast-decl-list-prepend-builder
            (ast-decl-module target-module)
            missing-imports)
          (ast-decl-list-prepend-builder
            (ast-decl-module owner-module)
            marker-decls))])))

(define (macro-find-generated-identity-module-in
  [decls : AstDeclList]
  [identity : String]
  [module : String]) : CompilerMaybeString
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) CompilerNoString]
    [(AstDeclListStep.Cons decl rest-box)
      (match decl
        [(AstDecl.Module next-module)
          (macro-find-generated-identity-module-in
            rest-box
            identity
            (intern-str next-module))]
        [_
          (if (and
            (> (string.string-length module) 0)
            (macro-decl-generated-key? decl identity))
            (CompilerSomeString module)
            (macro-find-generated-identity-module-in rest-box identity module))])]))

(define (macro-find-generated-identity-module
  [decls : AstDeclList]
  [identity : String]) : CompilerMaybeString
  (macro-find-generated-identity-module-in decls identity ""))

(define (macro-decl-list-structural-eq? [a : AstDeclList] [b : AstDeclList]) : bool
  (match (ast-decl-list-step a)
    [(AstDeclListStep.Nil)
      (match (ast-decl-list-step b)
        [(AstDeclListStep.Nil) true]
        [_ false])]
    [(AstDeclListStep.Cons a-head a-rest)
      (let
        [a-rest : AstDeclList a-rest]
        (match (ast-decl-list-step b)
          [(AstDeclListStep.Cons b-head b-rest)
            (let
              [b-rest : AstDeclList b-rest]
              (and
                (gen-decl-eq? a-head b-head)
                (macro-decl-list-structural-eq? a-rest b-rest)))]
          [_ false]))]))

(defenum MacroGeneratedFingerprintCacheLookup
  (Miss)
  (TooLarge)
  (Hit String))

(defenum MacroGeneratedFingerprintKey
  (Key String i64)
  (TooLarge))

(defenum MacroMaybeAstDecl
  (No)
  (Some AstDecl))

(defenum MacroGeneratedTargetReplayScan
  (NoRelevant)
  (AllMatched)
  (MissingOnly)
  (Incompatible))

(defenum MacroGeneratedTargetReplay
  (NoReplay)
  (ReplayCompatible)
  (ReplayIncompatible))

(define macro-generated-fingerprint-cache-capacity : i64
  4096)
(define macro-generated-fingerprint-cache-module-keys : (Array i64)
  (array.make-array i64 4096))
(define macro-generated-fingerprint-cache-identity-keys : (Array i64)
  (array.make-array i64 4096))
(define macro-generated-fingerprint-cache-values : (Array String)
  (array.make-array String 4096))
(define macro-generated-fingerprint-cache-count : i64
  0)
(define macro-generated-fingerprint-cache-generation : i64
  -1)
(define macro-generated-fingerprint-cache-ready : bool
  false)
(define macro-generated-fingerprint-cache-too-large-value : String
  "__typelisp_macro_generated_fingerprint_too_large__")

(define (macro-generated-fingerprint-cache-reset!) : unit
  (set! macro-generated-fingerprint-cache-ready false))

(define (macro-generated-fingerprint-cache-ensure!) : unit
  (if (if macro-generated-fingerprint-cache-ready
    (= macro-generated-fingerprint-cache-generation (intern-generation))
    false)
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i macro-generated-fingerprint-cache-capacity)
          (begin
            (array-set! macro-generated-fingerprint-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set! macro-generated-fingerprint-cache-count 0)
        (set! macro-generated-fingerprint-cache-generation (intern-generation))
        (set! macro-generated-fingerprint-cache-ready true)))))

(define (macro-generated-fingerprint-cache-bucket
  [module-id : i64]
  [identity-id : i64]) : i64
  (bit-and
    (+ (* module-id 2654435761) (* identity-id 40503))
    (- macro-generated-fingerprint-cache-capacity 1)))

(define (macro-generated-fingerprint-cache-get
  [target-module : String]
  [identity : String]) : MacroGeneratedFingerprintCacheLookup
  (let
    [module-id : i64 (intern target-module)]
    [identity-id : i64 (intern identity)]
    (begin
      (macro-generated-fingerprint-cache-ensure!)
      (let
        [cursor : i64
          (macro-generated-fingerprint-cache-bucket module-id identity-id)]
        [module-key : i64 (+ module-id 1)]
        [identity-key : i64 (+ identity-id 1)]
        [steps : i64 0]
        [out : MacroGeneratedFingerprintCacheLookup
          (MacroGeneratedFingerprintCacheLookup.Miss)]
        [done : bool false]
        (begin
          (while (if done
            false
            (< steps macro-generated-fingerprint-cache-capacity))
            (let
              [slot : i64
                (array-ref macro-generated-fingerprint-cache-module-keys cursor)]
              (if (= slot 0)
                (set! done true)
                (if (and
                  (= slot module-key)
                  (=
                    (array-ref
                      macro-generated-fingerprint-cache-identity-keys
                      cursor)
                    identity-key))
                  (begin
                    (set!
                      out
                      (let
                        [value : String
                          (array-ref
                            macro-generated-fingerprint-cache-values
                            cursor)]
                        (if (string.eq
                          value
                          macro-generated-fingerprint-cache-too-large-value)
                          (MacroGeneratedFingerprintCacheLookup.TooLarge)
                          (MacroGeneratedFingerprintCacheLookup.Hit value))))
                    (set! done true))
                  (begin
                    (set!
                      cursor
                      (bit-and
                        (+ cursor 1)
                        (- macro-generated-fingerprint-cache-capacity 1)))
                    (set! steps (+ steps 1)))))))
          out)))))

(define (macro-generated-fingerprint-cache-put!
  [target-module : String]
  [identity : String]
  [value : String]) : unit
  (let
    [module-id : i64 (intern target-module)]
    [identity-id : i64 (intern identity)]
    (begin
      (macro-generated-fingerprint-cache-ensure!)
      (if (>=
        (* macro-generated-fingerprint-cache-count 2)
        macro-generated-fingerprint-cache-capacity)
        unit
        (let
          [cursor : i64
            (macro-generated-fingerprint-cache-bucket module-id identity-id)]
          [module-key : i64 (+ module-id 1)]
          [identity-key : i64 (+ identity-id 1)]
          [stored : String (intern-persistent-copy value)]
          [steps : i64 0]
          [done : bool false]
          (begin
            (while (if done
              false
              (< steps macro-generated-fingerprint-cache-capacity))
              (let
                [slot : i64
                  (array-ref
                    macro-generated-fingerprint-cache-module-keys
                    cursor)]
                (if (= slot 0)
                  (begin
                    (array-set!
                      macro-generated-fingerprint-cache-module-keys
                      cursor
                      module-key)
                    (array-set!
                      macro-generated-fingerprint-cache-identity-keys
                      cursor
                      identity-key)
                    (array-set!
                      macro-generated-fingerprint-cache-values
                      cursor
                      stored)
                    (set!
                      macro-generated-fingerprint-cache-count
                      (+ macro-generated-fingerprint-cache-count 1))
                    (set! done true))
                  (if (and
                    (= slot module-key)
                    (=
                      (array-ref
                        macro-generated-fingerprint-cache-identity-keys
                        cursor)
                      identity-key))
                    (begin
                      (array-set!
                        macro-generated-fingerprint-cache-values
                        cursor
                        stored)
                      (set! done true))
                    (begin
                      (set!
                        cursor
                        (bit-and
                          (+ cursor 1)
                          (- macro-generated-fingerprint-cache-capacity 1)))
                      (set! steps (+ steps 1)))))))
            unit))))))

(define (macro-generated-fingerprint-join
  [tag : String]
  [left : String]
  [right : String]) : String
  (str_cat.str-cat tag ":" (spec-string-key left) ":" (spec-string-key right)))

(define (macro-generated-fingerprint-join3
  [tag : String]
  [a : String]
  [b : String]
  [c : String]) : String
  (str_cat.str-cat
    tag
    ":"
    (spec-string-key a)
    ":"
    (spec-string-key b)
    ":"
    (spec-string-key c)))

(define (macro-generated-fingerprint-bool [value : bool]) : String
  (if value
    "1"
    "0"))

(define (macro-generated-fingerprint-maybe-type [ty : AstMaybeType]) : String
  (match ty
    [(AstMaybeType.No) "type:none"]
    [(AstMaybeType.Some actual)
      (macro-generated-fingerprint-join "type:some" (spec-type-key actual) "")]))

(define (macro-generated-fingerprint-lifetimes [items : AstLifetimeList]) : String
  (spec-lifetime-list-key items))

(define (macro-generated-fingerprint-param [param : AstParam]) : String
  (match param
    [(AstParam.Param name ty comptime?)
      (macro-generated-fingerprint-join3
        "param"
        (intern-str name)
        (spec-type-key ty)
        (macro-generated-fingerprint-bool comptime?))]))

(define (macro-generated-fingerprint-param-list [params : AstParamList]) : String
  (macro-generated-fingerprint-param-list-at (& params) 0))

(define (macro-generated-fingerprint-param-list-at
  [params : (& params AstParamList)]
  [index : i64]) : String
  (if (>= index (ast-param-list-len params))
    "params:nil"
    (macro-generated-fingerprint-join
      "params:cons"
      (macro-generated-fingerprint-param
        (ast-param-list-get params index (ast-param-fallback)))
      (macro-generated-fingerprint-param-list-at params (+ index 1)))))

(define (macro-generated-fingerprint-macro-param [param : AstMacroParam]) : String
  (match param
    [(AstMacroParam.Param name ty variadic?)
      (macro-generated-fingerprint-join3
        "macro-param"
        (intern-str name)
        (spec-type-key ty)
        (macro-generated-fingerprint-bool variadic?))]))

(define (macro-generated-fingerprint-macro-param-list
  [params : AstMacroParamList]) : String
  (macro-generated-fingerprint-macro-param-list-at (& params) 0))

(define (macro-generated-fingerprint-macro-param-list-at
  [params : (& params AstMacroParamList)]
  [index : i64]) : String
  (if (>= index (ast-macro-param-list-len params))
    "macro-params:nil"
    (macro-generated-fingerprint-join
      "macro-params:cons"
      (macro-generated-fingerprint-macro-param
        (ast-macro-param-list-get params index (ast-macro-param-fallback)))
      (macro-generated-fingerprint-macro-param-list-at params (+ index 1)))))

(define (macro-generated-fingerprint-field-cleanup [cleanup : AstFieldCleanup]) : String
  (match cleanup
    [(AstFieldCleanup.No) "field-cleanup:none"]
    [(AstFieldCleanup.Fn name)
      (macro-generated-fingerprint-join "field-cleanup:fn" (intern-str name) "")]
    [(AstFieldCleanup.Owned) "field-cleanup:owned"]))

(define (macro-generated-fingerprint-field [field : AstFieldDef]) : String
  (match field
    [(AstFieldDef.Def name ty cleanup)
      (macro-generated-fingerprint-join3
        "field"
        (intern-str name)
        (spec-type-key ty)
        (macro-generated-fingerprint-field-cleanup cleanup))]))

(define (macro-generated-fingerprint-field-list [fields : AstFieldDefList]) : String
  (macro-generated-fingerprint-field-list-at (& fields) 0))

(define (macro-generated-fingerprint-field-list-at
  [fields : (& fields AstFieldDefList)]
  [index : i64]) : String
  (if (>= index (struct-get fields len))
    "fields:nil"
    (macro-generated-fingerprint-join
      "fields:cons"
      (macro-generated-fingerprint-field
        (ast-field-def-list-get fields index (ast-field-def-fallback)))
      (macro-generated-fingerprint-field-list-at fields (+ index 1)))))

(define (macro-generated-fingerprint-struct-repr [repr : AstStructRepr]) : String
  (match repr
    [(AstStructRepr.Default) "repr:default"]
    [(AstStructRepr.C) "repr:c"]))

(define (macro-generated-fingerprint-struct-cleanup
  [cleanup : AstStructCleanup]) : String
  (match cleanup
    [(AstStructCleanup.No) "struct-cleanup:none"]
    [(AstStructCleanup.Fn name)
      (macro-generated-fingerprint-join
        "struct-cleanup:fn"
        (intern-str name)
        "")]))

(define (macro-generated-fingerprint-enum-cleanup [cleanup : AstEnumCleanup]) : String
  (match cleanup
    [(AstEnumCleanup.No) "enum-cleanup:none"]
    [(AstEnumCleanup.Fn name)
      (macro-generated-fingerprint-join "enum-cleanup:fn" (intern-str name) "")]))

(define (macro-generated-fingerprint-payload-cleanup
  [cleanup : AstVariantPayloadCleanup]) : String
  (match cleanup
    [(AstVariantPayloadCleanup.No) "payload-cleanup:none"]
    [(AstVariantPayloadCleanup.Fn name)
      (macro-generated-fingerprint-join
        "payload-cleanup:fn"
        (intern-str name)
        "")]
    [(AstVariantPayloadCleanup.Owned) "payload-cleanup:owned"]))

(define (macro-generated-fingerprint-payload-cleanup-list
  [cleanups : AstVariantPayloadCleanupList]) : String
  (macro-generated-fingerprint-payload-cleanup-list-at (& cleanups) 0))

(define (macro-generated-fingerprint-payload-cleanup-list-at
  [cleanups : (& cleanups AstVariantPayloadCleanupList)]
  [index : i64]) : String
  (if (>= index (struct-get cleanups len))
    "payload-cleanups:nil"
    (macro-generated-fingerprint-join
      "payload-cleanups:cons"
      (macro-generated-fingerprint-payload-cleanup
        (ast-variant-payload-cleanup-list-get
          cleanups
          index
          (ast-variant-payload-cleanup-fallback)))
      (macro-generated-fingerprint-payload-cleanup-list-at cleanups (+ index 1)))))

(define (macro-generated-fingerprint-variant [variant : AstVariantDef]) : String
  (match variant
    [(AstVariantDef.Def name payloads cleanups)
      (macro-generated-fingerprint-join3
        "variant"
        (intern-str name)
        (spec-type-list-key payloads)
        (macro-generated-fingerprint-payload-cleanup-list cleanups))]))

(define (macro-generated-fingerprint-variant-list
  [variants : AstVariantDefList]) : String
  (macro-generated-fingerprint-variant-list-at (& variants) 0))

(define (macro-generated-fingerprint-variant-list-at
  [variants : (& variants AstVariantDefList)]
  [index : i64]) : String
  (if (>= index (struct-get variants len))
    "variants:nil"
    (macro-generated-fingerprint-join
      "variants:cons"
      (macro-generated-fingerprint-variant
        (ast-variant-def-list-get variants index (ast-variant-def-fallback)))
      (macro-generated-fingerprint-variant-list-at variants (+ index 1)))))

(define (macro-generated-fingerprint-fn-export [export : AstFnExport]) : String
  (match export
    [(AstFnExport.No) "export:none"]
    [(AstFnExport.Export symbol)
      (macro-generated-fingerprint-join "export:symbol" (intern-str symbol) "")]))

(define macro-generated-fingerprint-sexpr-fuel : i64
  128)

;; Bound allocation before AST -> sexpr conversion; oversized generated bodies
;; use the structural fallback instead of materializing huge temporary syntax.
(define (macro-generated-fingerprint-budget-tick [fuel : i64]) : i64
  (if (<= fuel 0)
    -1
    (- fuel 1)))

(define (macro-generated-fingerprint-expr-id-budget
  [expr-id : i64]
  [fuel : i64]) : i64
  (macro-generated-fingerprint-expr-budget (ast-node-get expr-id) fuel))

(define (macro-generated-fingerprint-two-exprs-budget
  [first-id : i64]
  [second-id : i64]
  [fuel : i64]) : i64
  (let
    [remaining : i64 (macro-generated-fingerprint-expr-id-budget first-id fuel)]
    (if (< remaining 0)
      -1
      (macro-generated-fingerprint-expr-id-budget second-id remaining))))

(define (macro-generated-fingerprint-three-exprs-budget
  [first-id : i64]
  [second-id : i64]
  [third-id : i64]
  [fuel : i64]) : i64
  (let
    [remaining : i64
      (macro-generated-fingerprint-two-exprs-budget first-id second-id fuel)]
    (if (< remaining 0)
      -1
      (macro-generated-fingerprint-expr-id-budget third-id remaining))))

(define (macro-generated-fingerprint-expr-list-budget
  [exprs : AstExprList]
  [fuel : i64]) : i64
  (let
    [index : i64 0]
    [len : i64 (struct-get (& exprs) len)]
    [remaining : i64 fuel]
    [done : bool false]
    [ok : bool true]
    (begin
      (while (if done
        false
        ok)
        (if (>= index len)
          (set! done true)
          (let
            [next-remaining : i64
              (macro-generated-fingerprint-expr-id-budget
                (ast-expr-list-get (& exprs) index 0)
                remaining)]
            (if (< next-remaining 0)
              (set! ok false)
              (begin
                (set! remaining next-remaining)
                (set! index (+ index 1)))))))
      (if ok
        remaining
        -1))))

(define (macro-generated-fingerprint-let-binding-budget
  [binding : AstLetBinding]
  [fuel : i64]) : i64
  (match binding
    [(AstLetBinding.Binding _ _ value-id)
      (macro-generated-fingerprint-expr-id-budget value-id fuel)]))

(define (macro-generated-fingerprint-let-bindings-budget
  [bindings : AstLetBindingList]
  [fuel : i64]) : i64
  (macro-generated-fingerprint-let-bindings-budget-at (& bindings) 0 fuel))

(define (macro-generated-fingerprint-let-bindings-budget-at
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]
  [fuel : i64]) : i64
  (if (>= index (ast-let-binding-list-len bindings))
    fuel
    (let
      [next-remaining : i64
        (macro-generated-fingerprint-let-binding-budget
          (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
          fuel)]
      (if (< next-remaining 0)
        -1
        (macro-generated-fingerprint-let-bindings-budget-at
          bindings
          (+ index 1)
          next-remaining)))))

(define (macro-generated-fingerprint-expr-budget [expr : AstExpr] [fuel : i64]) : i64
  (let
    [next : i64 (macro-generated-fingerprint-budget-tick fuel)]
    (if (< next 0)
      -1
      (match expr
        [(AstExpr.Spanned inner-id _)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExpr.Literal _) next]
        [(AstExpr.Var _) next]
        [(AstExpr.Binary _ left-id right-id)
          (macro-generated-fingerprint-two-exprs-budget left-id right-id next)]
        [(AstExpr.Unary _ inner-id)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExpr.Call func-id args)
          (let
            [remaining : i64
              (macro-generated-fingerprint-expr-id-budget func-id next)]
            (if (< remaining 0)
              -1
              (macro-generated-fingerprint-expr-list-budget args remaining)))]
        [(AstExpr.If cond-id then-id else-id)
          (macro-generated-fingerprint-three-exprs-budget
            cond-id
            then-id
            else-id
            next)]
        [(AstExpr.Let let-box)
          (match (box-get let-box)
            [(AstLet.Let bindings body-id)
              (let
                [remaining : i64
                  (macro-generated-fingerprint-let-bindings-budget
                    bindings
                    next)]
                (if (< remaining 0)
                  -1
                  (macro-generated-fingerprint-expr-id-budget body-id remaining)))])]
        [(AstExpr.Tuple exprs)
          (macro-generated-fingerprint-expr-list-budget exprs next)]
        [(AstExpr.TupleRef tuple-id _)
          (macro-generated-fingerprint-expr-id-budget tuple-id next)]
        [(AstExpr.Array exprs)
          (macro-generated-fingerprint-expr-list-budget exprs next)]
        [(AstExpr.MakeArray _ len-id)
          (macro-generated-fingerprint-expr-id-budget len-id next)]
        [(AstExpr.ArrayRef array-id index-id)
          (macro-generated-fingerprint-two-exprs-budget array-id index-id next)]
        [(AstExpr.ArraySet array-id index-id value-id)
          (macro-generated-fingerprint-three-exprs-budget
            array-id
            index-id
            value-id
            next)]
        [(AstExpr.ArrayPush array-id value-id)
          (macro-generated-fingerprint-two-exprs-budget array-id value-id next)]
        [(AstExpr.StringRef string-id index-id)
          (macro-generated-fingerprint-two-exprs-budget string-id index-id next)]
        [(AstExpr.While cond-id body-id)
          (macro-generated-fingerprint-two-exprs-budget cond-id body-id next)]
        [(AstExpr.Begin exprs)
          (macro-generated-fingerprint-expr-list-budget exprs next)]
        [(AstExpr.Unsafe exprs)
          (macro-generated-fingerprint-expr-list-budget exprs next)]
        [(AstExpr.Set _ value-id)
          (macro-generated-fingerprint-expr-id-budget value-id next)]
        [(AstExpr.Ann inner-id _)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExpr.Cast inner-id _)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExpr.Borrow _ _ place-id)
          (macro-generated-fingerprint-expr-id-budget place-id next)]
        [(AstExpr.StructGet receiver-id _)
          (macro-generated-fingerprint-expr-id-budget receiver-id next)]
        [(AstExpr.StructSet receiver-id _ value-id)
          (macro-generated-fingerprint-two-exprs-budget
            receiver-id
            value-id
            next)]
        [(AstExpr.Box inner-id)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExpr.BoxGet inner-id)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExpr.BoxTake inner-id)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExpr.BoxSet receiver-id value-id)
          (macro-generated-fingerprint-two-exprs-budget
            receiver-id
            value-id
            next)]
        [(AstExpr.TypeLiteral _) next]
        [(AstExpr.Init _) next]
        [(AstExpr.Quote inner-id)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExpr.Quasiquote inner-id)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExpr.Unquote inner-id)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExpr.UnquoteSplicing inner-id)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExpr.BracketClause exprs)
          (macro-generated-fingerprint-expr-list-budget exprs next)]
        [(AstExpr.Try inner-id)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [(AstExpr.Return inner-id)
          (macro-generated-fingerprint-expr-id-budget inner-id next)]
        [_ -1]))))

(define (macro-generated-fingerprint-sexpr [sexpr : SpannedSexpr] [fuel : i64]) : MacroGeneratedFingerprintKey
  (if (<= fuel 0)
    (MacroGeneratedFingerprintKey.TooLarge)
    (match sexpr
      [(SpannedSexpr.Int _ text _)
        (MacroGeneratedFingerprintKey.Key
          (str_cat.str-cat "int:" (spec-string-key text))
          (- fuel 1))]
      [(SpannedSexpr.Sym name _)
        (MacroGeneratedFingerprintKey.Key
          (str_cat.str-cat "sym:" (spec-string-key name))
          (- fuel 1))]
      [(SpannedSexpr.Nil _) (MacroGeneratedFingerprintKey.Key "nil" (- fuel 1))]
      [(SpannedSexpr.Cons head tail _)
        (match (macro-generated-fingerprint-sexpr (sp-node-get head) (- fuel 1))
          [(MacroGeneratedFingerprintKey.Key head-key head-fuel)
            (match (macro-generated-fingerprint-sexpr
              (sp-node-get tail)
              head-fuel)
              [(MacroGeneratedFingerprintKey.Key tail-key tail-fuel)
                (MacroGeneratedFingerprintKey.Key
                  (str_cat.str-cat
                    "cons:"
                    (spec-string-key head-key)
                    ":"
                    (spec-string-key tail-key))
                  tail-fuel)]
              [(MacroGeneratedFingerprintKey.TooLarge)
                (MacroGeneratedFingerprintKey.TooLarge)])]
          [(MacroGeneratedFingerprintKey.TooLarge)
            (MacroGeneratedFingerprintKey.TooLarge)])]
      [(SpannedSexpr.Str text _)
        (MacroGeneratedFingerprintKey.Key
          (str_cat.str-cat "str:" (spec-string-key text))
          (- fuel 1))]
      [(SpannedSexpr.Char c _)
        (MacroGeneratedFingerprintKey.Key
          (str_cat.str-cat "char:" (string.int->string (cast c : i64)))
          (- fuel 1))]
      [(SpannedSexpr.Float text _)
        (MacroGeneratedFingerprintKey.Key
          (str_cat.str-cat "float:" (spec-string-key text))
          (- fuel 1))]
      [(SpannedSexpr.BracketList items _)
        (match (macro-generated-fingerprint-sexpr
          (sp-node-get items)
          (- fuel 1))
          [(MacroGeneratedFingerprintKey.Key items-key items-fuel)
            (MacroGeneratedFingerprintKey.Key
              (str_cat.str-cat "bracket:" (spec-string-key items-key))
              items-fuel)]
          [(MacroGeneratedFingerprintKey.TooLarge)
            (MacroGeneratedFingerprintKey.TooLarge)])])))

(define (macro-generated-fingerprint-expr [expr : AstExpr]) : TcMaybeString
  (if (<
    (macro-generated-fingerprint-expr-budget
      expr
      macro-generated-fingerprint-sexpr-fuel)
    0)
    (TcMaybeString.No)
    (let
      [mark : i64 (sp-node-pool-len)]
      (match (macro-expr-to-spanned-sexpr expr expr)
        [(ResultMacroSexpr.Ok sexpr)
          (match (macro-generated-fingerprint-sexpr
            sexpr
            macro-generated-fingerprint-sexpr-fuel)
            [(MacroGeneratedFingerprintKey.Key key _)
              (begin
                (sp-node-pool-truncate! mark)
                (TcMaybeString.Some key))]
            [(MacroGeneratedFingerprintKey.TooLarge)
              (begin
                (sp-node-pool-truncate! mark)
                (TcMaybeString.No))])]
        [(ResultMacroSexpr.Err _)
          (begin
            (sp-node-pool-truncate! mark)
            (TcMaybeString.No))]))))

(define (macro-generated-fingerprint-decl [decl : AstDecl]) : TcMaybeString
  (match decl
    [(AstDecl.Module name)
      (TcMaybeString.Some
        (macro-generated-fingerprint-join "decl:module" (intern-str name) ""))]
    [(AstDecl.Def name ty value-box)
      (match (macro-generated-fingerprint-expr (ast-node-get value-box))
        [(TcMaybeString.Some value-key)
          (TcMaybeString.Some
            (macro-generated-fingerprint-join3
              "decl:def"
              (intern-str name)
              (macro-generated-fingerprint-maybe-type ty)
              value-key))]
        [(TcMaybeString.No) (TcMaybeString.No)])]
    [(AstDecl.DefFn name params ret body-box export)
      (match (macro-generated-fingerprint-expr (ast-node-get body-box))
        [(TcMaybeString.Some body-key)
          (TcMaybeString.Some
            (macro-generated-fingerprint-join3
              "decl:fn"
              (intern-str name)
              (macro-generated-fingerprint-param-list params)
              (macro-generated-fingerprint-join3
                "fn-tail"
                (spec-type-key ret)
                body-key
                (macro-generated-fingerprint-fn-export export))))]
        [(TcMaybeString.No) (TcMaybeString.No)])]
    [(AstDecl.DefEnum name cleanup variants)
      (TcMaybeString.Some
        (macro-generated-fingerprint-join3
          "decl:enum"
          (intern-str name)
          (macro-generated-fingerprint-enum-cleanup cleanup)
          (macro-generated-fingerprint-variant-list variants)))]
    [(AstDecl.DefEnumLifetimes name lifetimes cleanup variants)
      (TcMaybeString.Some
        (macro-generated-fingerprint-join3
          "decl:enum-lifetimes"
          (intern-str name)
          (macro-generated-fingerprint-lifetimes lifetimes)
          (macro-generated-fingerprint-join
            "enum-tail"
            (macro-generated-fingerprint-enum-cleanup cleanup)
            (macro-generated-fingerprint-variant-list variants))))]
    [(AstDecl.DefStruct name repr cleanup fields)
      (TcMaybeString.Some
        (macro-generated-fingerprint-join3
          "decl:struct"
          (intern-str name)
          (macro-generated-fingerprint-struct-repr repr)
          (macro-generated-fingerprint-join
            "struct-tail"
            (macro-generated-fingerprint-struct-cleanup cleanup)
            (macro-generated-fingerprint-field-list fields))))]
    [(AstDecl.DefStructLifetimes name lifetimes repr cleanup fields)
      (TcMaybeString.Some
        (macro-generated-fingerprint-join3
          "decl:struct-lifetimes"
          (intern-str name)
          (macro-generated-fingerprint-lifetimes lifetimes)
          (macro-generated-fingerprint-join3
            "struct-tail"
            (macro-generated-fingerprint-struct-repr repr)
            (macro-generated-fingerprint-struct-cleanup cleanup)
            (macro-generated-fingerprint-field-list fields))))]
    [(AstDecl.DefMacro name params ret body-box)
      (match (macro-generated-fingerprint-expr (ast-node-get body-box))
        [(TcMaybeString.Some body-key)
          (TcMaybeString.Some
            (macro-generated-fingerprint-join3
              "decl:macro"
              (intern-str name)
              (macro-generated-fingerprint-macro-param-list params)
              (macro-generated-fingerprint-join
                "macro-tail"
                (spec-type-key ret)
                body-key)))]
        [(TcMaybeString.No) (TcMaybeString.No)])]
    [(AstDecl.IncludeStr name path)
      (TcMaybeString.Some
        (macro-generated-fingerprint-join "decl:include-str" name path))]
    [(AstDecl.IncludeBin name path)
      (TcMaybeString.Some
        (macro-generated-fingerprint-join "decl:include-bin" name path))]
    [(AstDecl.Test name body-box _)
      (match (macro-generated-fingerprint-expr (ast-node-get body-box))
        [(TcMaybeString.Some body-key)
          (TcMaybeString.Some
            (macro-generated-fingerprint-join
              "decl:test"
              (intern-str name)
              body-key))]
        [(TcMaybeString.No) (TcMaybeString.No)])]
    [(AstDecl.Unsafe inner-box)
      (macro-generated-fingerprint-decl (box-get inner-box))]
    [(AstDecl.ComptimeDecl _ inner-box)
      (macro-generated-fingerprint-decl (box-get inner-box))]
    [_ (TcMaybeString.No)]))

(define (macro-generated-fingerprint-decl-list [decls : AstDeclList]) : TcMaybeString
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) (TcMaybeString.Some "decls:nil")]
    [(AstDeclListStep.Cons decl rest)
      (match (macro-generated-fingerprint-decl decl)
        [(TcMaybeString.Some head-key)
          (match (macro-generated-fingerprint-decl-list rest)
            [(TcMaybeString.Some rest-key)
              (TcMaybeString.Some
                (macro-generated-fingerprint-join
                  "decls:cons"
                  head-key
                  rest-key))]
            [(TcMaybeString.No) (TcMaybeString.No)])]
        [(TcMaybeString.No) (TcMaybeString.No)])]))

(define (macro-generated-key-body-for-compare
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [target-module : String]
  [decl-path : String]
  [identity : String]
  [body : AstDeclList]
  [fuel : i64]) : AstDeclList
  (begin
    (cfg
      compile-profile
      (compiler-tc-macro-profile-note-generated-compare-pass))
    (if (<= fuel 0)
      (macro-decls-filter-generated-key body identity)
      (match (macro-expand-decls
        ctx
        top-env
        orig-decls
        body
        (macro-paths-for-decls body decl-path)
        target-module
        false)
        [(ResultMacroDeclsWithPaths.Ok expanded _ followup-work)
          (if (not (macro-followup-work-list-empty? followup-work))
            (macro-generated-key-body-for-compare
              ctx
              top-env
              orig-decls
              target-module
              decl-path
              identity
              expanded
              (- fuel 1))
            (macro-decls-filter-generated-key expanded identity))]
        [(ResultMacroDeclsWithPaths.Err _)
          (macro-decls-filter-generated-key body identity)]))))

(define (macro-generated-key-body-normalized-fingerprint
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [target-module : String]
  [decl-path : String]
  [identity : String]
  [body : AstDeclList]) : TcMaybeString
  (macro-generated-fingerprint-decl-list
    (macro-generated-key-body-for-compare
      ctx
      top-env
      orig-decls
      target-module
      decl-path
      identity
      body
      (macro-expand-fixed-point-limit))))

(define (macro-generated-key-body-cached-existing-fingerprint
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [target-module : String]
  [decl-path : String]
  [identity : String]
  [body : AstDeclList]) : TcMaybeString
  (match (macro-generated-fingerprint-cache-get target-module identity)
    [(MacroGeneratedFingerprintCacheLookup.Hit fingerprint)
      (begin
        (cfg
          compile-profile
          (compiler-tc-macro-profile-note-generated-fingerprint-cache-hit))
        (TcMaybeString.Some fingerprint))]
    [(MacroGeneratedFingerprintCacheLookup.TooLarge)
      (begin
        (cfg
          compile-profile
          (compiler-tc-macro-profile-note-generated-fingerprint-cache-hit))
        (TcMaybeString.No))]
    [(MacroGeneratedFingerprintCacheLookup.Miss)
      (begin
        (cfg
          compile-profile
          (compiler-tc-macro-profile-note-generated-fingerprint-cache-miss))
        (match (macro-generated-key-body-normalized-fingerprint
          ctx
          top-env
          orig-decls
          target-module
          decl-path
          identity
          body)
          [(TcMaybeString.Some fingerprint)
            (begin
              (macro-generated-fingerprint-cache-put!
                target-module
                identity
                fingerprint)
              (TcMaybeString.Some fingerprint))]
          [(TcMaybeString.No)
            (begin
              (macro-generated-fingerprint-cache-put!
                target-module
                identity
                macro-generated-fingerprint-cache-too-large-value)
              (TcMaybeString.No))]))]))

(define (macro-generated-key-body-normalized-structural-eq?
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [target-module : String]
  [decl-path : String]
  [identity : String]
  [existing-body : AstDeclList]
  [generated-body : AstDeclList]) : bool
  (let
    [compare-existing-body : AstDeclList
      (macro-generated-key-body-for-compare
        ctx
        top-env
        orig-decls
        target-module
        decl-path
        identity
        existing-body
        (macro-expand-fixed-point-limit))]
    [compare-generated-body : AstDeclList
      (macro-generated-key-body-for-compare
        ctx
        top-env
        orig-decls
        target-module
        decl-path
        identity
        generated-body
        (macro-expand-fixed-point-limit))]
    (macro-decl-list-structural-eq?
      compare-existing-body
      compare-generated-body)))

(define (macro-generated-key-body-replay-compatible?
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [target-module : String]
  [decl-path : String]
  [identity : String]
  [existing-body : AstDeclList]
  [generated-body : AstDeclList]) : bool
  (match (macro-generated-key-body-cached-existing-fingerprint
    ctx
    top-env
    orig-decls
    target-module
    decl-path
    identity
    existing-body)
    [(TcMaybeString.Some existing-fingerprint)
      (match (macro-generated-key-body-normalized-fingerprint
        ctx
        top-env
        orig-decls
        target-module
        decl-path
        identity
        generated-body)
        [(TcMaybeString.Some generated-fingerprint)
          (if (string.eq existing-fingerprint generated-fingerprint)
            (macro-generated-key-body-normalized-structural-eq?
              ctx
              top-env
              orig-decls
              target-module
              decl-path
              identity
              existing-body
              generated-body)
            false)]
        [(TcMaybeString.No)
          (macro-generated-key-body-normalized-structural-eq?
            ctx
            top-env
            orig-decls
            target-module
            decl-path
            identity
            existing-body
            generated-body)])]
    [(TcMaybeString.No)
      (macro-generated-key-body-normalized-structural-eq?
        ctx
        top-env
        orig-decls
        target-module
        decl-path
        identity
        existing-body
        generated-body)]))

(define (macro-decl-generated? [decl : AstDecl]) : bool
  (match decl
    [(AstDecl.ComptimeDecl meta template-box)
      (match meta
        [(AstGeneratedDeclMeta.Some _ _ _ _) true]
        [(AstGeneratedDeclMeta.No)
          (macro-decl-generated? (box-get template-box))])]
    [(AstDecl.Unsafe inner-box) (macro-decl-generated? (box-get inner-box))]
    [_ false]))

(define (macro-generated-visible-name [decl : AstDecl]) : SpecMaybeString
  (if (and (macro-decl-generated? decl) (not (macro-decl-import? decl)))
    (gen-decl-visible-name decl)
    (SpecMaybeString.None)))

(define (macro-find-generated-visible-decl
  [decls : AstDeclList]
  [name : String]) : MacroMaybeAstDecl
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) (MacroMaybeAstDecl.No)]
    [(AstDeclListStep.Cons decl rest-box)
      (match (macro-generated-visible-name decl)
        [(SpecMaybeString.Some candidate)
          (if (string.eq candidate name)
            (MacroMaybeAstDecl.Some decl)
            (macro-find-generated-visible-decl rest-box name))]
        [(SpecMaybeString.None)
          (macro-find-generated-visible-decl rest-box name)])]))

(define (macro-generated-target-replay-scan-step
  [state : MacroGeneratedTargetReplayScan]
  [matched? : bool]
  [same? : bool]) : MacroGeneratedTargetReplayScan
  (if matched?
    (if same?
      (match state
        [(MacroGeneratedTargetReplayScan.NoRelevant)
          (MacroGeneratedTargetReplayScan.AllMatched)]
        [(MacroGeneratedTargetReplayScan.AllMatched)
          (MacroGeneratedTargetReplayScan.AllMatched)]
        [(MacroGeneratedTargetReplayScan.MissingOnly)
          (MacroGeneratedTargetReplayScan.Incompatible)]
        [(MacroGeneratedTargetReplayScan.Incompatible)
          (MacroGeneratedTargetReplayScan.Incompatible)])
      (MacroGeneratedTargetReplayScan.Incompatible))
    (match state
      [(MacroGeneratedTargetReplayScan.NoRelevant)
        (MacroGeneratedTargetReplayScan.MissingOnly)]
      [(MacroGeneratedTargetReplayScan.AllMatched)
        (MacroGeneratedTargetReplayScan.Incompatible)]
      [(MacroGeneratedTargetReplayScan.MissingOnly)
        (MacroGeneratedTargetReplayScan.MissingOnly)]
      [(MacroGeneratedTargetReplayScan.Incompatible)
        (MacroGeneratedTargetReplayScan.Incompatible)])))

(define (macro-generated-target-replay-scan-in
  [existing-body : AstDeclList]
  [generated-body : AstDeclList]
  [state : MacroGeneratedTargetReplayScan]) : MacroGeneratedTargetReplayScan
  (match (ast-decl-list-step generated-body)
    [(AstDeclListStep.Nil) state]
    [(AstDeclListStep.Cons decl rest-box)
      (match (macro-generated-visible-name decl)
        [(SpecMaybeString.Some name)
          (match (macro-find-generated-visible-decl existing-body name)
            [(MacroMaybeAstDecl.Some existing-decl)
              (macro-generated-target-replay-scan-in
                existing-body
                rest-box
                (macro-generated-target-replay-scan-step
                  state
                  true
                  (gen-decl-eq? existing-decl decl)))]
            [(MacroMaybeAstDecl.No)
              (macro-generated-target-replay-scan-in
                existing-body
                rest-box
                (macro-generated-target-replay-scan-step state false false))])]
        [(SpecMaybeString.None)
          (macro-generated-target-replay-scan-in existing-body rest-box state)])]))

(define (macro-generated-target-replay
  [existing-body : AstDeclList]
  [generated-body : AstDeclList]) : MacroGeneratedTargetReplay
  (match (macro-generated-target-replay-scan-in
    existing-body
    generated-body
    (MacroGeneratedTargetReplayScan.NoRelevant))
    [(MacroGeneratedTargetReplayScan.AllMatched)
      (MacroGeneratedTargetReplay.ReplayCompatible)]
    [(MacroGeneratedTargetReplayScan.Incompatible)
      (MacroGeneratedTargetReplay.ReplayIncompatible)]
    [_ (MacroGeneratedTargetReplay.NoReplay)]))

(define (macro-module-exists? [decls : AstDeclList] [target-module : String]) : bool
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) false]
    [(AstDeclListStep.Cons decl rest)
      (match decl
        [(AstDecl.Module module-name)
          (if (string.eq (intern-str module-name) target-module)
            true
            (macro-module-exists? rest target-module))]
        [_ (macro-module-exists? rest target-module)])]))

(define (macro-collect-module-body-decls
  [decls : AstDeclList]
  [target-module : String]
  [current-module : String]) : AstDeclList
  (let
    [cursor : AstDeclList decls]
    [module : String current-module]
    [out-rev : AstDeclList (ast-decl-list-new)]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (match decl
                [(AstDecl.Module module-name)
                  (set! module (intern-str module-name))]
                [_
                  (if (string.eq module target-module)
                    (set! out-rev (ast-decl-list-prepend-builder decl out-rev))
                    unit)])
              (set! cursor rest))]))
      (macro-decl-list-reverse out-rev))))

(define (macro-find-module-body-decls
  [decls : AstDeclList]
  [target-module : String]) : MacroMaybeDeclList
  (if (macro-module-exists? decls target-module)
    (MacroMaybeDeclList.Some
      (macro-collect-module-body-decls decls target-module ""))
    (MacroMaybeDeclList.No)))

(define (macro-generated-identity-shortcut-target
  [decls : AstDeclList]
  [identity : String]) : CompilerMaybeString
  (match (macro-find-generated-identity-module decls identity)
    [(CompilerSomeString target-module)
      (match (macro-find-module-body-decls decls target-module)
        [(MacroMaybeDeclList.Some existing-body)
          (if (macro-program-has-module-placeholder? existing-body)
            CompilerNoString
            (CompilerSomeString target-module))]
        [(MacroMaybeDeclList.No) (CompilerSomeString target-module)])]
    [(CompilerNoString) CompilerNoString]))

(define (macro-generated-identity-shortcut-safe-params?
  [ctx : TcContext]
  [definition-module : String]
  [params : AstMacroParamList]) : bool
  (macro-generated-identity-shortcut-safe-params-at?
    ctx
    definition-module
    (& params)
    0))

(define (macro-generated-identity-shortcut-safe-params-at?
  [ctx : TcContext]
  [definition-module : String]
  [params : (& params AstMacroParamList)]
  [index : i64]) : bool
  (if (>= index (ast-macro-param-list-len params))
    true
    (match (ast-macro-param-list-get params index (ast-macro-param-fallback))
      [(AstMacroParam.Param _ ty _)
        (and
          (not (macro-identity-syntax-param-type? ctx definition-module ty))
          (macro-generated-identity-shortcut-safe-params-at?
            ctx
            definition-module
            params
            (+ index 1)))])))

(define (macro-expr-list-with-head-symbol
  [name : String]
  [exprs : AstExprList]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match (macro-expr-list-to-spanned-sexpr exprs span origin)
    [(ResultMacroSexpr.Ok tail)
      (ResultMacroSexpr.Ok
        (spanned-sexpr-cons (SpannedSexpr.Sym name span) tail span))]
    [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)]))

;; Serialize a child expression node (referenced by node-pool id) back to a
;; spanned sexpr. Used by the declaration-emitting macro output serializer to
;; rebuild non-trivial function bodies (arithmetic, struct/array access, let,
;; while, set!, ...) that the quasiquote evaluator stores as typed AST nodes.
(define (macro-child-to-spanned-sexpr
  [id : i64]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (macro-expr-to-spanned-sexpr-with-span (ast-node-get id) span origin))

(define (macro-form1
  [name : String]
  [a : SpannedSexpr]
  [span : token.SourceSpan]) : SpannedSexpr
  (spanned-sexpr-cons
    (SpannedSexpr.Sym name span)
    (spanned-sexpr-cons a (SpannedSexpr.Nil span) span)
    span))

(define (macro-form0 [name : String] [span : token.SourceSpan]) : SpannedSexpr
  (spanned-sexpr-cons (SpannedSexpr.Sym name span) (SpannedSexpr.Nil span) span))

(define (macro-form2
  [name : String]
  [a : SpannedSexpr]
  [b : SpannedSexpr]
  [span : token.SourceSpan]) : SpannedSexpr
  (spanned-sexpr-cons
    (SpannedSexpr.Sym name span)
    (spanned-sexpr-cons
      a
      (spanned-sexpr-cons b (SpannedSexpr.Nil span) span)
      span)
    span))

(define (macro-form3
  [name : String]
  [a : SpannedSexpr]
  [b : SpannedSexpr]
  [c : SpannedSexpr]
  [span : token.SourceSpan]) : SpannedSexpr
  (spanned-sexpr-cons
    (SpannedSexpr.Sym name span)
    (spanned-sexpr-cons
      a
      (spanned-sexpr-cons
        b
        (spanned-sexpr-cons c (SpannedSexpr.Nil span) span)
        span)
      span)
    span))

(define (macro-binop-symbol [op : AstBinOp]) : String
  (match op
    [(AstBinOp.Add) "+"]
    [(AstBinOp.Sub) "-"]
    [(AstBinOp.Mul) "*"]
    [(AstBinOp.Div) "/"]
    [(AstBinOp.Mod) "%"]
    [(AstBinOp.Eq) "="]
    [(AstBinOp.Ne) "!="]
    [(AstBinOp.Lt) "<"]
    [(AstBinOp.Le) "<="]
    [(AstBinOp.Gt) ">"]
    [(AstBinOp.Ge) ">="]
    [(AstBinOp.And) "and"]
    [(AstBinOp.Or) "or"]
    [(AstBinOp.BitAnd) "bit-and"]
    [(AstBinOp.BitOr) "bit-or"]
    [(AstBinOp.BitXor) "bit-xor"]
    [(AstBinOp.Shl) "shl"]
    [(AstBinOp.Shr) "shr"]))

(define (macro-unop-symbol [op : AstUnOp]) : String
  (match op
    [(AstUnOp.Neg) "-"]
    [(AstUnOp.Not) "not"]
    [(AstUnOp.BitNot) "bit-not"]))

(define (macro-lifetime-list-to-spanned-sexpr
  [items : AstLifetimeList]
  [span : token.SourceSpan]) : SpannedSexpr
  (macro-lifetime-list-to-spanned-sexpr-at (& items) span 0))

(define (macro-lifetime-list-to-spanned-sexpr-at
  [items : (& items AstLifetimeList)]
  [span : token.SourceSpan]
  [index : i64]) : SpannedSexpr
  (if (>= index (ast-lifetime-list-len items))
    (SpannedSexpr.Nil span)
    (spanned-sexpr-cons
      (SpannedSexpr.Sym
        (ast-lifetime-list-get items index (ast-lifetime-fallback))
        span)
      (macro-lifetime-list-to-spanned-sexpr-at items span (+ index 1))
      span)))

(define (macro-internal-resolved-struct-type-marker) : String
  "__typelisp internal resolved struct type")

(define (macro-internal-resolved-enum-type-marker) : String
  "__typelisp internal resolved enum type")

(define (macro-resolved-nominal-type-sexpr
  [marker : String]
  [name : String]
  [lifetimes : AstLifetimeList]
  [span : token.SourceSpan]) : SpannedSexpr
  (spanned-sexpr-cons
    (SpannedSexpr.Sym marker span)
    (spanned-sexpr-cons
      (SpannedSexpr.Str name span)
      (macro-lifetime-list-to-spanned-sexpr lifetimes span)
      span)
    span))

(define (macro-type-list-to-spanned-sexpr
  [items : AstTypeList]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (macro-type-list-to-spanned-sexpr-at (& items) span origin 0))

(define (macro-type-list-to-spanned-sexpr-at
  [items : (& items AstTypeList)]
  [span : token.SourceSpan]
  [origin : AstExpr]
  [index : i64]) : ResultMacroSexpr
  (if (>= index (ast-type-list-len items))
    (ResultMacroSexpr.Ok (SpannedSexpr.Nil span))
    (match (macro-type-to-spanned-sexpr
      (ty-node-get (ast-type-list-get items index (ast-type-id-fallback)))
      span
      origin)
      [(ResultMacroSexpr.Ok shead)
        (match (macro-type-list-to-spanned-sexpr-at
          items
          span
          origin
          (+ index 1))
          [(ResultMacroSexpr.Ok stail)
            (ResultMacroSexpr.Ok (spanned-sexpr-cons shead stail span))]
          [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
      [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])))

(define (macro-type-unary-sexpr
  [name : String]
  [inner-id : i64]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match (macro-type-to-spanned-sexpr (ty-node-get inner-id) span origin)
    [(ResultMacroSexpr.Ok sinner)
      (ResultMacroSexpr.Ok (macro-form1 name sinner span))]
    [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)]))

(define (macro-type-named-args-sexpr
  [name : String]
  [lifetimes : AstLifetimeList]
  [span : token.SourceSpan]) : ResultMacroSexpr
  (ResultMacroSexpr.Ok
    (spanned-sexpr-cons
      (SpannedSexpr.Sym name span)
      (macro-lifetime-list-to-spanned-sexpr lifetimes span)
      span)))

;; Serialize an AstType back to a spanned sexpr so type positions embedded in
;; expression nodes (array.make-array, cast, ann, typed let bindings) round-trip.
(define (macro-type-to-spanned-sexpr
  [ty : AstType]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match ty
    [(AstType.I64) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "i64" span))]
    [(AstType.I32) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "i32" span))]
    [(AstType.I16) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "i16" span))]
    [(AstType.I8) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "i8" span))]
    [(AstType.U64) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "u64" span))]
    [(AstType.U32) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "u32" span))]
    [(AstType.U16) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "u16" span))]
    [(AstType.U8) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "u8" span))]
    [(AstType.F64) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "f64" span))]
    [(AstType.F32) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "f32" span))]
    [(AstType.Bool) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "bool" span))]
    [(AstType.Char) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "char" span))]
    [(AstType.String) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "String" span))]
    [(AstType.Str) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "str" span))]
    [(AstType.Bytes) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "bytes" span))]
    [(AstType.Unit) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "unit" span))]
    [(AstType.Never) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "never" span))]
    [(AstType.Expr) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "Expr" span))]
    [(AstType.ExprList)
      (ResultMacroSexpr.Ok (SpannedSexpr.Sym "ExprList" span))]
    [(AstType.DynArray elem) (macro-type-unary-sexpr "Array" elem span origin)]
    [(AstType.Array elem count)
      (match (macro-type-to-spanned-sexpr (ty-node-get elem) span origin)
        [(ResultMacroSexpr.Ok selem)
          (ResultMacroSexpr.Ok
            (macro-form2
              "Array"
              selem
              (SpannedSexpr.Int count (string.int->string count) span)
              span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstType.Box inner) (macro-type-unary-sexpr "Box" inner span origin)]
    [(AstType.Ptr inner) (macro-type-unary-sexpr "Ptr" inner span origin)]
    [(AstType.MutPtr inner) (macro-type-unary-sexpr "MutPtr" inner span origin)]
    [(AstType.Tuple items)
      (match (macro-type-list-to-spanned-sexpr (box-get items) span origin)
        [(ResultMacroSexpr.Ok stail)
          (ResultMacroSexpr.Ok
            (spanned-sexpr-cons (SpannedSexpr.Sym "Tuple" span) stail span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstType.Func args ret)
      (match (macro-type-list-to-spanned-sexpr (box-get args) span origin)
        [(ResultMacroSexpr.Ok sargs)
          (match (macro-type-to-spanned-sexpr (ty-node-get ret) span origin)
            [(ResultMacroSexpr.Ok sret)
              (ResultMacroSexpr.Ok
                (spanned-sexpr-cons
                  (SpannedSexpr.Sym "->" span)
                  (macro-spanned-sexpr-append
                    sargs
                    (spanned-sexpr-cons sret (SpannedSexpr.Nil span) span)
                    span)
                  span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstType.Struct name)
      (ResultMacroSexpr.Ok
        (macro-resolved-nominal-type-sexpr
          (macro-internal-resolved-struct-type-marker)
          (intern-str name)
          (ast-lifetime-list-new)
          span))]
    [(AstType.Enum name)
      (ResultMacroSexpr.Ok
        (macro-resolved-nominal-type-sexpr
          (macro-internal-resolved-enum-type-marker)
          (intern-str name)
          (ast-lifetime-list-new)
          span))]
    [(AstType.Var name)
      (ResultMacroSexpr.Ok
        (SpannedSexpr.Sym (macro-output-source-name (intern-str name)) span))]
    [(AstType.StructArgs name lifetimes)
      (ResultMacroSexpr.Ok
        (macro-resolved-nominal-type-sexpr
          (macro-internal-resolved-struct-type-marker)
          (intern-str name)
          (box-get lifetimes)
          span))]
    [(AstType.EnumArgs name lifetimes)
      (ResultMacroSexpr.Ok
        (macro-resolved-nominal-type-sexpr
          (macro-internal-resolved-enum-type-marker)
          (intern-str name)
          (box-get lifetimes)
          span))]
    [(AstType.VarArgs name lifetimes)
      (macro-type-named-args-sexpr
        (macro-output-source-name (intern-str name))
        (box-get lifetimes)
        span)]
    [(AstType.Ref region inner)
      (match (macro-type-to-spanned-sexpr (ty-node-get inner) span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok
            (if (= (string.string-length region) 0)
              (macro-form1 "&" sinner span)
              (macro-form2 "&" (SpannedSexpr.Sym region span) sinner span)))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstType.MutRef region inner)
      (match (macro-type-to-spanned-sexpr (ty-node-get inner) span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok
            (if (= (string.string-length region) 0)
              (macro-form1 "&mut" sinner span)
              (macro-form2 "&mut" (SpannedSexpr.Sym region span) sinner span)))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstType.Region region inner)
      (match (macro-type-to-spanned-sexpr (ty-node-get inner) span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok
            (macro-form2 "in" (SpannedSexpr.Sym region span) sinner span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]))

(define (macro-child-form1
  [name : String]
  [id : i64]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match (macro-child-to-spanned-sexpr id span origin)
    [(ResultMacroSexpr.Ok sexpr)
      (ResultMacroSexpr.Ok (macro-form1 name sexpr span))]
    [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)]))

(define (macro-child-form2
  [name : String]
  [left-id : i64]
  [right-id : i64]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match (macro-child-to-spanned-sexpr left-id span origin)
    [(ResultMacroSexpr.Ok sleft)
      (match (macro-child-to-spanned-sexpr right-id span origin)
        [(ResultMacroSexpr.Ok sright)
          (ResultMacroSexpr.Ok (macro-form2 name sleft sright span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)]))

(define (macro-child-type-form3
  [name : String]
  [expr-id : i64]
  [ty : AstType]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match (macro-child-to-spanned-sexpr expr-id span origin)
    [(ResultMacroSexpr.Ok sexpr)
      (match (macro-type-to-spanned-sexpr ty span origin)
        [(ResultMacroSexpr.Ok sty)
          (ResultMacroSexpr.Ok
            (macro-form3 name sexpr (SpannedSexpr.Sym ":" span) sty span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)]))

(define (macro-spanned-sexpr-append
  [left : SpannedSexpr]
  [right : SpannedSexpr]
  [span : token.SourceSpan]) : SpannedSexpr
  (match left
    [(SpannedSexpr.Cons head tail _)
      (spanned-sexpr-cons
        (sp-node-get head)
        (macro-spanned-sexpr-append (sp-node-get tail) right span)
        span)]
    [_ right]))

(define (macro-literal-to-spanned-sexpr
  [lit : AstLiteral]
  [span : token.SourceSpan]) : SpannedSexpr
  (match lit
    [(AstLiteral.Int n text) (SpannedSexpr.Int n text span)]
    [(AstLiteral.Float text) (SpannedSexpr.Float text span)]
    [(AstLiteral.Bool value)
      (SpannedSexpr.Sym
        (if value
          "true"
          "false")
        span)]
    [(AstLiteral.Char c) (SpannedSexpr.Char c span)]
    [(AstLiteral.String text) (SpannedSexpr.Str text span)]
    [(AstLiteral.Unit) (SpannedSexpr.Sym "unit" span)]))

(define (macro-pattern-list-to-spanned-sexpr
  [patterns : AstPatternList]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (macro-pattern-list-to-spanned-sexpr-at (& patterns) 0 span origin))

(define (macro-pattern-list-to-spanned-sexpr-at
  [patterns : (& patterns AstPatternList)]
  [index : i64]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (if (>= index (struct-get patterns len))
    (ResultMacroSexpr.Ok (SpannedSexpr.Nil span))
    (match (macro-pattern-to-spanned-sexpr
      (ast-pattern-list-get patterns index (ast-pattern-fallback))
      span
      origin)
      [(ResultMacroSexpr.Ok shead)
        (match (macro-pattern-list-to-spanned-sexpr-at
          patterns
          (+ index 1)
          span
          origin)
          [(ResultMacroSexpr.Ok stail)
            (ResultMacroSexpr.Ok (spanned-sexpr-cons shead stail span))]
          [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
      [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])))

(define (macro-pattern-to-spanned-sexpr
  [pattern : AstPattern]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match pattern
    [(AstPattern.Binding name)
      (ResultMacroSexpr.Ok
        (SpannedSexpr.Sym (macro-output-syntax-name (intern-str name)) span))]
    [(AstPattern.Wildcard) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "_" span))]
    [(AstPattern.Literal lit)
      (ResultMacroSexpr.Ok (macro-literal-to-spanned-sexpr lit span))]
    [(AstPattern.Variant name args-box)
      (match (macro-pattern-list-to-spanned-sexpr
        (box-get args-box)
        span
        origin)
        [(ResultMacroSexpr.Ok args)
          (ResultMacroSexpr.Ok
            (spanned-sexpr-cons
              (SpannedSexpr.Sym
                (macro-output-syntax-name (intern-str name))
                span)
              args
              span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstPattern.Tuple _)
      (ResultMacroSexpr.Err
        (box
          (macro-output-syntax-diag
            origin
            "typecheck: module macro output tuple patterns cannot be parsed as source declarations")))]
    [(AstPattern.Var _ _)
      (ResultMacroSexpr.Err
        (box
          (macro-output-syntax-diag
            origin
            "typecheck: module macro output typed patterns cannot be parsed as source declarations")))]))

(define (macro-match-arm-bracket
  [arm : AstMatchArm]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match arm
    [(AstMatchArm.Arm pattern body-id)
      (match (macro-pattern-to-spanned-sexpr pattern span origin)
        [(ResultMacroSexpr.Ok spattern)
          (match (macro-child-to-spanned-sexpr body-id span origin)
            [(ResultMacroSexpr.Ok sbody)
              (ResultMacroSexpr.Ok
                (spanned-sexpr-bracket-list
                  (spanned-sexpr-cons
                    spattern
                    (spanned-sexpr-cons sbody (SpannedSexpr.Nil span) span)
                    span)
                  span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]))

(define (macro-match-arm-list-to-spanned-sexpr
  [arms : AstMatchArmList]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (macro-match-arm-list-to-spanned-sexpr-at (& arms) 0 span origin))

(define (macro-match-arm-list-to-spanned-sexpr-at
  [arms : (& arms AstMatchArmList)]
  [index : i64]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (if (>= index (struct-get arms len))
    (ResultMacroSexpr.Ok (SpannedSexpr.Nil span))
    (match (macro-match-arm-bracket
      (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      span
      origin)
      [(ResultMacroSexpr.Ok shead)
        (match (macro-match-arm-list-to-spanned-sexpr-at
          arms
          (+ index 1)
          span
          origin)
          [(ResultMacroSexpr.Ok stail)
            (ResultMacroSexpr.Ok (spanned-sexpr-cons shead stail span))]
          [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
      [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])))

(define (macro-let-binding-bracket
  [binding : AstLetBinding]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match binding
    [(AstLetBinding.Binding name maybe-ty value-id)
      (match (macro-child-to-spanned-sexpr value-id span origin)
        [(ResultMacroSexpr.Ok svalue)
          (match maybe-ty
            [(AstMaybeType.No)
              (ResultMacroSexpr.Ok
                (spanned-sexpr-bracket-list
                  (spanned-sexpr-cons
                    (SpannedSexpr.Sym
                      (macro-output-syntax-name (intern-str name))
                      span)
                    (spanned-sexpr-cons svalue (SpannedSexpr.Nil span) span)
                    span)
                  span))]
            [(AstMaybeType.Some ty)
              (match (macro-type-to-spanned-sexpr ty span origin)
                [(ResultMacroSexpr.Ok sty)
                  (ResultMacroSexpr.Ok
                    (spanned-sexpr-bracket-list
                      (spanned-sexpr-cons
                        (SpannedSexpr.Sym
                          (macro-output-syntax-name (intern-str name))
                          span)
                        (spanned-sexpr-cons
                          (SpannedSexpr.Sym ":" span)
                          (spanned-sexpr-cons
                            sty
                            (spanned-sexpr-cons
                              svalue
                              (SpannedSexpr.Nil span)
                              span)
                            span)
                          span)
                        span)
                      span))]
                [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]))

(define (macro-let-tail
  [bindings : AstLetBindingList]
  [body : SpannedSexpr]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (macro-let-tail-at (& bindings) body span origin 0))

(define (macro-let-tail-at
  [bindings : (& bindings AstLetBindingList)]
  [body : SpannedSexpr]
  [span : token.SourceSpan]
  [origin : AstExpr]
  [index : i64]) : ResultMacroSexpr
  (if (>= index (ast-let-binding-list-len bindings))
    (ResultMacroSexpr.Ok (spanned-sexpr-cons body (SpannedSexpr.Nil span) span))
    (match (macro-let-binding-bracket
      (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      span
      origin)
      [(ResultMacroSexpr.Ok sbracket)
        (match (macro-let-tail-at bindings body span origin (+ index 1))
          [(ResultMacroSexpr.Ok stail)
            (ResultMacroSexpr.Ok (spanned-sexpr-cons sbracket stail span))]
          [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
      [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])))

(define (macro-expr-list-to-spanned-sexpr
  [exprs : AstExprList]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (macro-expr-list-to-spanned-sexpr-at (& exprs) 0 span origin))

(define (macro-expr-list-to-spanned-sexpr-at
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (if (>= index (struct-get exprs len))
    (ResultMacroSexpr.Ok (SpannedSexpr.Nil span))
    (let
      [head-expr : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
      (match (macro-expr-to-spanned-sexpr-with-span head-expr span origin)
        [(ResultMacroSexpr.Ok shead)
          (match (macro-expr-list-to-spanned-sexpr-at
            exprs
            (+ index 1)
            span
            origin)
            [(ResultMacroSexpr.Ok stail)
              (ResultMacroSexpr.Ok (spanned-sexpr-cons shead stail span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)]))))

(define (macro-expr-to-spanned-sexpr-with-span
  [expr : AstExpr]
  [span : token.SourceSpan]
  [origin : AstExpr]) : ResultMacroSexpr
  (match expr
    [(AstExpr.Spanned inner-box ast-span)
      (macro-expr-to-spanned-sexpr-with-span
        (ast-node-get inner-box)
        (macro-source-span-from-ast ast-span)
        origin)]
    [(AstExpr.Literal lit)
      (match lit
        [(AstLiteral.Int n text)
          (ResultMacroSexpr.Ok (SpannedSexpr.Int n text span))]
        [(AstLiteral.Float text)
          (ResultMacroSexpr.Ok (SpannedSexpr.Float text span))]
        [(AstLiteral.Bool value)
          (ResultMacroSexpr.Ok
            (SpannedSexpr.Sym
              (if value
                "true"
                "false")
              span))]
        [(AstLiteral.Char c) (ResultMacroSexpr.Ok (SpannedSexpr.Char c span))]
        [(AstLiteral.String text)
          (ResultMacroSexpr.Ok (SpannedSexpr.Str text span))]
        [(AstLiteral.Unit) (ResultMacroSexpr.Ok (SpannedSexpr.Sym "unit" span))])]
    [(AstExpr.Var name)
      (ResultMacroSexpr.Ok
        (SpannedSexpr.Sym (macro-output-syntax-name (intern-str name)) span))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (match (macro-expr-to-spanned-sexpr-with-span func span origin)
          [(ResultMacroSexpr.Ok head)
            (match (macro-expr-list-to-spanned-sexpr args span origin)
              [(ResultMacroSexpr.Ok tail)
                (ResultMacroSexpr.Ok (spanned-sexpr-cons head tail span))]
              [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
          [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)]))]
    [(AstExpr.BracketClause items)
      (match (macro-expr-list-to-spanned-sexpr items span origin)
        [(ResultMacroSexpr.Ok list)
          (ResultMacroSexpr.Ok (spanned-sexpr-bracket-list list span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.If cond-box then-box else-box)
      (macro-expr-list-with-head-symbol
        "if"
        (ast-expr-cons
          cond-box
          (ast-expr-cons then-box (ast-expr-cons else-box (ast-expr-list-new))))
        span
        origin)]
    [(AstExpr.Begin exprs)
      (macro-expr-list-with-head-symbol "begin" exprs span origin)]
    [(AstExpr.Unsafe exprs)
      (macro-expr-list-with-head-symbol "unsafe" exprs span origin)]
    [(AstExpr.Tuple exprs)
      (macro-expr-list-with-head-symbol "tuple" exprs span origin)]
    [(AstExpr.Array exprs)
      (macro-expr-list-with-head-symbol "array" exprs span origin)]
    [(AstExpr.Quote inner-box)
      (macro-expr-list-with-head-symbol
        "quote"
        (ast-expr-cons inner-box (ast-expr-list-new))
        span
        origin)]
    [(AstExpr.Quasiquote inner-box)
      (macro-expr-list-with-head-symbol
        "quasiquote"
        (ast-expr-cons inner-box (ast-expr-list-new))
        span
        origin)]
    [(AstExpr.Unquote inner-box)
      (macro-expr-list-with-head-symbol
        "unquote"
        (ast-expr-cons inner-box (ast-expr-list-new))
        span
        origin)]
    [(AstExpr.UnquoteSplicing inner-box)
      (macro-expr-list-with-head-symbol
        "unquote-splicing"
        (ast-expr-cons inner-box (ast-expr-list-new))
        span
        origin)]
    [(AstExpr.Binary op left-id right-id)
      (match (macro-child-to-spanned-sexpr left-id span origin)
        [(ResultMacroSexpr.Ok sleft)
          (match (macro-child-to-spanned-sexpr right-id span origin)
            [(ResultMacroSexpr.Ok sright)
              (ResultMacroSexpr.Ok
                (macro-form2 (macro-binop-symbol op) sleft sright span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.Unary op inner-id)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok (macro-form1 (macro-unop-symbol op) sinner span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-id)
          (match (macro-child-to-spanned-sexpr body-id span origin)
            [(ResultMacroSexpr.Ok sbody)
              (match (macro-let-tail bindings sbody span origin)
                [(ResultMacroSexpr.Ok stail)
                  (ResultMacroSexpr.Ok
                    (spanned-sexpr-cons
                      (SpannedSexpr.Sym "let" span)
                      stail
                      span))]
                [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])])]
    [(AstExpr.While cond-id body-id)
      (match (macro-child-to-spanned-sexpr cond-id span origin)
        [(ResultMacroSexpr.Ok scond)
          (match (macro-child-to-spanned-sexpr body-id span origin)
            [(ResultMacroSexpr.Ok sbody)
              (ResultMacroSexpr.Ok (macro-form2 "while" scond sbody span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-id arms)
          (match (macro-child-to-spanned-sexpr scrutinee-id span origin)
            [(ResultMacroSexpr.Ok sscrutinee)
              (match (macro-match-arm-list-to-spanned-sexpr arms span origin)
                [(ResultMacroSexpr.Ok sarms)
                  (ResultMacroSexpr.Ok
                    (spanned-sexpr-cons
                      (SpannedSexpr.Sym "match" span)
                      (spanned-sexpr-cons sscrutinee sarms span)
                      span))]
                [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])])]
    [(AstExpr.Set name value-id)
      (match (macro-child-to-spanned-sexpr value-id span origin)
        [(ResultMacroSexpr.Ok svalue)
          (ResultMacroSexpr.Ok
            (macro-form2
              "set!"
              (SpannedSexpr.Sym
                (macro-output-syntax-name (intern-str name))
                span)
              svalue
              span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.MakeArray ty len-id)
      (match (macro-type-to-spanned-sexpr ty span origin)
        [(ResultMacroSexpr.Ok sty)
          (match (macro-child-to-spanned-sexpr len-id span origin)
            [(ResultMacroSexpr.Ok slen)
              (ResultMacroSexpr.Ok (macro-form2 "make-array" sty slen span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.ArrayRef array-id index-id)
      (match (macro-child-to-spanned-sexpr array-id span origin)
        [(ResultMacroSexpr.Ok sarray)
          (match (macro-child-to-spanned-sexpr index-id span origin)
            [(ResultMacroSexpr.Ok sindex)
              (ResultMacroSexpr.Ok (macro-form2 "array-ref" sarray sindex span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.ArraySet array-id index-id value-id)
      (match (macro-child-to-spanned-sexpr array-id span origin)
        [(ResultMacroSexpr.Ok sarray)
          (match (macro-child-to-spanned-sexpr index-id span origin)
            [(ResultMacroSexpr.Ok sindex)
              (match (macro-child-to-spanned-sexpr value-id span origin)
                [(ResultMacroSexpr.Ok svalue)
                  (ResultMacroSexpr.Ok
                    (macro-form3 "array-set!" sarray sindex svalue span))]
                [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.ArrayPush array-id value-id)
      (match (macro-child-to-spanned-sexpr array-id span origin)
        [(ResultMacroSexpr.Ok sarray)
          (match (macro-child-to-spanned-sexpr value-id span origin)
            [(ResultMacroSexpr.Ok svalue)
              (ResultMacroSexpr.Ok
                (macro-form2 "array-push!" sarray svalue span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.StringRef string-id index-id)
      (match (macro-child-to-spanned-sexpr string-id span origin)
        [(ResultMacroSexpr.Ok sstring)
          (match (macro-child-to-spanned-sexpr index-id span origin)
            [(ResultMacroSexpr.Ok sindex)
              (ResultMacroSexpr.Ok
                (macro-form2 "string-ref" sstring sindex span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.StructGet receiver-id field)
      (match (macro-child-to-spanned-sexpr receiver-id span origin)
        [(ResultMacroSexpr.Ok sreceiver)
          (ResultMacroSexpr.Ok
            (macro-form2
              "struct-get"
              sreceiver
              (SpannedSexpr.Sym (intern-str field) span)
              span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.StructSet receiver-id field value-id)
      (match (macro-child-to-spanned-sexpr receiver-id span origin)
        [(ResultMacroSexpr.Ok sreceiver)
          (match (macro-child-to-spanned-sexpr value-id span origin)
            [(ResultMacroSexpr.Ok svalue)
              (ResultMacroSexpr.Ok
                (macro-form2
                  "set!"
                  (macro-form2
                    "struct-get"
                    sreceiver
                    (SpannedSexpr.Sym (intern-str field) span)
                    span)
                  svalue
                  span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.Cast inner-id ty)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (match (macro-type-to-spanned-sexpr ty span origin)
            [(ResultMacroSexpr.Ok sty)
              (ResultMacroSexpr.Ok
                (macro-form3 "cast" sinner (SpannedSexpr.Sym ":" span) sty span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.Ann inner-id ty)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (match (macro-type-to-spanned-sexpr ty span origin)
            [(ResultMacroSexpr.Ok sty)
              (ResultMacroSexpr.Ok
                (macro-form3 "ann" sinner (SpannedSexpr.Sym ":" span) sty span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.Borrow mutable lifetime place-id)
      (match (macro-child-to-spanned-sexpr place-id span origin)
        [(ResultMacroSexpr.Ok splace)
          (let
            [head : String
              (if mutable
                "&mut"
                "&")]
            (match lifetime
              [(AstBorrowLifetime.Inferred)
                (ResultMacroSexpr.Ok (macro-form1 head splace span))]
              [(AstBorrowLifetime.Named name)
                (ResultMacroSexpr.Ok
                  (macro-form2 head (SpannedSexpr.Sym name span) splace span))]))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.Return inner-id)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok (macro-form1 "return" sinner span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.Try inner-id)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok (macro-form1 "try" sinner span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.Box inner-id)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok (macro-form1 "box" sinner span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.BoxGet inner-id)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok (macro-form1 "box-get" sinner span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.BoxTake inner-id)
      (match (macro-child-to-spanned-sexpr inner-id span origin)
        [(ResultMacroSexpr.Ok sinner)
          (ResultMacroSexpr.Ok (macro-form1 "box-take" sinner span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.BoxSet receiver-id value-id)
      (match (macro-child-to-spanned-sexpr receiver-id span origin)
        [(ResultMacroSexpr.Ok sreceiver)
          (match (macro-child-to-spanned-sexpr value-id span origin)
            [(ResultMacroSexpr.Ok svalue)
              (ResultMacroSexpr.Ok
                (macro-form2
                  "set!"
                  (macro-form1 "box-get" sreceiver span)
                  svalue
                  span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.TupleRef tuple-id index)
      (match (macro-child-to-spanned-sexpr tuple-id span origin)
        [(ResultMacroSexpr.Ok stuple)
          (ResultMacroSexpr.Ok
            (macro-form2
              "tuple-ref"
              stuple
              (SpannedSexpr.Int index (string.int->string index) span)
              span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.Init maybe-ty)
      (match maybe-ty
        [(AstMaybeType.No)
          (ResultMacroSexpr.Ok
            (spanned-sexpr-cons
              (SpannedSexpr.Sym "init" span)
              (SpannedSexpr.Nil span)
              span))]
        [(AstMaybeType.Some ty)
          (match (macro-type-to-spanned-sexpr ty span origin)
            [(ResultMacroSexpr.Ok sty)
              (ResultMacroSexpr.Ok
                (macro-form2 "init" (SpannedSexpr.Sym ":" span) sty span))]
            [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])])]
    [(AstExpr.TypeLiteral ty)
      (match (macro-type-to-spanned-sexpr ty span origin)
        [(ResultMacroSexpr.Ok sty)
          (ResultMacroSexpr.Ok (macro-form1 "type" sty span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.PtrNull ty)
      (match (macro-type-to-spanned-sexpr ty span origin)
        [(ResultMacroSexpr.Ok sty)
          (ResultMacroSexpr.Ok
            (macro-form2 "ptr-null" (SpannedSexpr.Sym ":" span) sty span))]
        [(ResultMacroSexpr.Err diag) (ResultMacroSexpr.Err diag)])]
    [(AstExpr.PtrNullCheck ptr-id)
      (macro-child-form1 "ptr-null?" ptr-id span origin)]
    [(AstExpr.PtrAddrOf name)
      (ResultMacroSexpr.Ok
        (macro-form1
          "ptr-addr-of"
          (SpannedSexpr.Sym (macro-output-syntax-name (intern-str name)) span)
          span))]
    [(AstExpr.PtrRead ptr-id) (macro-child-form1 "ptr-read" ptr-id span origin)]
    [(AstExpr.PtrWrite ptr-id value-id)
      (macro-child-form2 "ptr-write!" ptr-id value-id span origin)]
    [(AstExpr.PtrOffset ptr-id offset-id)
      (macro-child-form2 "ptr-offset" ptr-id offset-id span origin)]
    [(AstExpr.PtrCast ptr-id ty)
      (macro-child-type-form3 "ptr-cast" ptr-id ty span origin)]
    [(AstExpr.PtrToInt ptr-id)
      (macro-child-form1 "ptr->int" ptr-id span origin)]
    [(AstExpr.IntToPtr value-id ty)
      (macro-child-type-form3 "int->ptr" value-id ty span origin)]
    [(AstExpr.StringData value-id)
      (macro-child-form1 "string-data" value-id span origin)]
    [(AstExpr.StringFromBytes ptr-id len-id)
      (macro-child-form2 "string-from-bytes" ptr-id len-id span origin)]
    [(AstExpr.ArrayData value-id)
      (macro-child-form1 "array-data" value-id span origin)]
    [(AstExpr.ProgramArgc)
      (ResultMacroSexpr.Ok (macro-form0 "program-argc" span))]
    [(AstExpr.ProgramArgv)
      (ResultMacroSexpr.Ok (macro-form0 "program-argv" span))]
    [(AstExpr.ProgramEnvp)
      (ResultMacroSexpr.Ok (macro-form0 "program-envp" span))]
    [(AstExpr.CpuIdEax leaf-id subleaf-id)
      (macro-child-form2 "cpuid-eax" leaf-id subleaf-id span origin)]
    [(AstExpr.CpuIdEbx leaf-id subleaf-id)
      (macro-child-form2 "cpuid-ebx" leaf-id subleaf-id span origin)]
    [(AstExpr.CpuIdEcx leaf-id subleaf-id)
      (macro-child-form2 "cpuid-ecx" leaf-id subleaf-id span origin)]
    [(AstExpr.CpuIdEdx leaf-id subleaf-id)
      (macro-child-form2 "cpuid-edx" leaf-id subleaf-id span origin)]
    [(AstExpr.Xgetbv index-id)
      (macro-child-form1 "xgetbv" index-id span origin)]
    [(AstExpr.Syscall args)
      (macro-expr-list-with-head-symbol "syscall" args span origin)]
    [_
      (ResultMacroSexpr.Err
        (box
          (macro-output-syntax-diag
            origin
            "typecheck: module macro output contains syntax that cannot be parsed as a declaration")))]))

(define (macro-expr-to-spanned-sexpr [expr : AstExpr] [origin : AstExpr]) : ResultMacroSexpr
  (macro-expr-to-spanned-sexpr-with-span expr (macro-zero-source-span) origin))

(define (macro-stdlib-private-dynamic-buffer-macro?
  [macro-name : String]
  [definition-module : String]) : bool
  (or
    (and
      (string.eq definition-module "stdlib.vector")
      (string.eq macro-name "stdlib.vector/vector"))
    (and
      (string.eq definition-module "stdlib.vector")
      (string.eq macro-name "stdlib.vector/vector-family"))))

(define (macro-parse-dispatch-for-macro
  [macro-name : String]
  [definition-module : String]) : sym_i64_env.SymI64Env
  (if (macro-stdlib-private-dynamic-buffer-macro? macro-name definition-module)
    (compiler-parse-dispatch-private-types (compiler-parse-dispatch-env))
    (compiler-parse-dispatch-env)))

(define (macro-parse-decl-sexpr
  [dispatch : sym_i64_env.SymI64Env]
  [form : SpannedSexpr]
  [origin : AstExpr]) : ResultMacroParsedDecls
  (match (parse-ast-decl-maybe dispatch form)
    [(ResultAstMaybeDecl.SomeDecl decl)
      (ResultMacroParsedDecls.Ok (ast-decl-cons decl (ast-decl-list-new)))]
    [(ResultAstMaybeDecl.Decls decls) (ResultMacroParsedDecls.Ok decls)]
    [(ResultAstMaybeDecl.NoDecl)
      (ResultMacroParsedDecls.Ok (ast-decl-list-new))]
    [(ResultAstMaybeDecl.Err message)
      (ResultMacroParsedDecls.Err
        (box (macro-output-syntax-diag origin message)))]))

(define (macro-parse-decls-from-one-expr
  [dispatch : sym_i64_env.SymI64Env]
  [expr : AstExpr]
  [origin : AstExpr]) : ResultMacroParsedDecls
  (let
    [mark : i64 (sp-node-pool-len)]
    (match (macro-expr-to-spanned-sexpr expr origin)
      [(ResultMacroSexpr.Ok form)
        (match (macro-parse-decl-sexpr dispatch form origin)
          [(ResultMacroParsedDecls.Ok decls)
            (begin
              (sp-node-pool-truncate! mark)
              (ResultMacroParsedDecls.Ok decls))]
          [(ResultMacroParsedDecls.Err diag)
            (begin
              (sp-node-pool-truncate! mark)
              (ResultMacroParsedDecls.Err diag))])]
      [(ResultMacroSexpr.Err diag)
        (begin
          (sp-node-pool-truncate! mark)
          (ResultMacroParsedDecls.Err diag))])))

(define (macro-parse-decls-from-exprs
  [dispatch : sym_i64_env.SymI64Env]
  [exprs : AstExprList]
  [origin : AstExpr]) : ResultMacroParsedDecls
  (macro-parse-decls-from-exprs-at dispatch (& exprs) 0 origin))

(define (macro-parse-decls-from-exprs-at
  [dispatch : sym_i64_env.SymI64Env]
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [origin : AstExpr]) : ResultMacroParsedDecls
  (if (>= index (struct-get exprs len))
    (ResultMacroParsedDecls.Ok (ast-decl-list-new))
    (let
      [head-expr : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
      (match (macro-parse-decls-from-expr dispatch head-expr origin)
        [(ResultMacroParsedDecls.Ok head-decls)
          (match (macro-parse-decls-from-exprs-at
            dispatch
            exprs
            (+ index 1)
            origin)
            [(ResultMacroParsedDecls.Ok rest-decls)
              (ResultMacroParsedDecls.Ok
                (macro-decl-list-append head-decls rest-decls))]
            [(ResultMacroParsedDecls.Err diag)
              (ResultMacroParsedDecls.Err diag)])]
        [(ResultMacroParsedDecls.Err diag) (ResultMacroParsedDecls.Err diag)]))))

(define (macro-parse-decls-from-expr
  [dispatch : sym_i64_env.SymI64Env]
  [expr : AstExpr]
  [origin : AstExpr]) : ResultMacroParsedDecls
  (match (ast-expr-unspan expr)
    [(AstExpr.Begin exprs) (macro-parse-decls-from-exprs dispatch exprs origin)]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (match (ast-expr-unspan func)
          [(AstExpr.Var name)
            (if (string.eq (macro-output-syntax-name (intern-str name)) "begin")
              (macro-parse-decls-from-exprs dispatch args origin)
              (macro-parse-decls-from-one-expr dispatch expr origin))]
          [_ (macro-parse-decls-from-one-expr dispatch expr origin)]))]
    [_ (macro-parse-decls-from-one-expr dispatch expr origin)]))

(define (macro-module-decls-from-ctfe-value
  [value : CompilerCtfeValue]
  [origin : AstExpr]
  [dispatch : sym_i64_env.SymI64Env]) : ResultMacroParsedDecls
  (match value
    [(CompilerCtfeValue.Expr node _)
      (macro-parse-decls-from-expr dispatch (ast-node-get node) origin)]
    [_
      (ResultMacroParsedDecls.Err
        (box
          (macro-output-syntax-diag
            origin
            "typecheck: Module macro transformer did not produce Expr")))]))

(define (macro-decls-from-ctfe-value
  [value : CompilerCtfeValue]
  [origin : AstExpr]
  [dispatch : sym_i64_env.SymI64Env]) : ResultMacroParsedDecls
  (match value
    [(CompilerCtfeValue.Expr node _)
      (macro-parse-decls-from-expr dispatch (ast-node-get node) origin)]
    [_
      (ResultMacroParsedDecls.Err
        (box
          (macro-output-syntax-diag
            origin
            "typecheck: Decls macro transformer did not produce Expr")))]))

(define (macro-collect-decl-name
  [decl : AstDecl]
  [module : String]
  [acc : TcStringList]) : TcStringList
  (match decl
    [(AstDecl.DefMacro name _ _ _)
      (begin
        (ctfe-module-macro-export-add! module (intern-str name))
        (tc-string-list-add acc (intern-str name)))]
    [(AstDecl.Unsafe inner-box)
      (macro-collect-decl-name (box-get inner-box) module acc)]
    [(AstDecl.ComptimeDecl _ template-box)
      (macro-collect-decl-name (box-get template-box) module acc)]
    [_ acc]))

(define (macro-collect-macro-names [decls : AstDeclList] [acc : TcStringList]) : TcStringList
  (let
    [cur : AstDeclList decls]
    [cur-module : String ""]
    [out : TcStringList acc]
    (begin
      (while (match (ast-decl-list-step cur)
        [(AstDeclListStep.Nil) false]
        [_ true])
        (match (ast-decl-list-step cur)
          [(AstDeclListStep.Nil) unit]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (match decl
                [(AstDecl.Module next-module)
                  (set! cur-module (intern-str next-module))]
                [_ (set! out (macro-collect-decl-name decl cur-module out))])
              (set! cur rest))]))
      out)))

(define (macro-collect-surface-decl-name
  [decl : CompilerLoadSurfaceDecl]
  [acc : TcStringList]) : TcStringList
  (match (struct-get decl kind)
    [(CompilerLoadSurfaceMacro)
      (let
        [module : String (struct-get decl module)]
        [name : String (struct-get decl name)]
        (begin
          (ctfe-module-macro-export-add! module name)
          (tc-string-list-add acc name)))]
    [_ acc]))

(define (macro-collect-surface-decl-names
  [decls : CompilerLoadSurfaceDeclList]
  [acc : TcStringList]) : TcStringList
  (match decls
    [(CompilerLoadSurfaceDeclNil) acc]
    [(CompilerLoadSurfaceDeclCons decl rest)
      (macro-collect-surface-decl-names
        (box-get rest)
        (macro-collect-surface-decl-name decl acc))]))

(define (macro-collect-surface-summary-macro-names
  [summaries : CompilerLoadSurfaceSummaryList]
  [acc : TcStringList]) : TcStringList
  (match summaries
    [(CompilerLoadSurfaceSummaryNil) acc]
    [(CompilerLoadSurfaceSummaryCons summary rest)
      (macro-collect-surface-summary-macro-names
        (box-get rest)
        (macro-collect-surface-decl-names (struct-get summary decls) acc))]))

(define (macro-collect-visible-macro-names [decls : AstDeclList]) : TcStringList
  (macro-collect-surface-summary-macro-names
    (compiler-load-surface-summaries)
    (macro-collect-macro-names
      decls
      (tc-string-list-add
        (tc-string-list-add (TcStringList.Nil) "when")
        "unless"))))

(define (macro-surface-decl-macro-in-module?
  [decl : CompilerLoadSurfaceDecl]
  [target-module : String]
  [base : String]) : bool
  (and
    (string.eq (struct-get decl module) target-module)
    (string.eq (struct-get decl name) base)
    (match (struct-get decl kind)
      [(CompilerLoadSurfaceMacro) true]
      [_ false])))

(define (macro-surface-decls-macro-in-module?
  [decls : CompilerLoadSurfaceDeclList]
  [target-module : String]
  [base : String]) : bool
  (match decls
    [(CompilerLoadSurfaceDeclNil) false]
    [(CompilerLoadSurfaceDeclCons decl rest)
      (or
        (macro-surface-decl-macro-in-module? decl target-module base)
        (macro-surface-decls-macro-in-module? (box-get rest) target-module base))]))

(define (macro-surface-summaries-macro-in-module?
  [summaries : CompilerLoadSurfaceSummaryList]
  [target-module : String]
  [base : String]) : bool
  (match summaries
    [(CompilerLoadSurfaceSummaryNil) false]
    [(CompilerLoadSurfaceSummaryCons summary rest)
      (or
        (macro-surface-decls-macro-in-module?
          (struct-get summary decls)
          target-module
          base)
        (macro-surface-summaries-macro-in-module?
          (box-get rest)
          target-module
          base))]))

(define (macro-surface-macro-in-module?
  [target-module : String]
  [base : String]) : bool
  (macro-surface-summaries-macro-in-module?
    (compiler-load-surface-summaries)
    target-module
    base))

(define (macro-surface-decls-module-has-macro?
  [decls : CompilerLoadSurfaceDeclList]
  [target-module : String]) : bool
  (match decls
    [(CompilerLoadSurfaceDeclNil) false]
    [(CompilerLoadSurfaceDeclCons decl rest)
      (or
        (and
          (string.eq (struct-get decl module) target-module)
          (match (struct-get decl kind)
            [(CompilerLoadSurfaceMacro) true]
            [_ false]))
        (macro-surface-decls-module-has-macro? (box-get rest) target-module))]))

(define (macro-surface-summaries-module-has-macro?
  [summaries : CompilerLoadSurfaceSummaryList]
  [target-module : String]) : bool
  (match summaries
    [(CompilerLoadSurfaceSummaryNil) false]
    [(CompilerLoadSurfaceSummaryCons summary rest)
      (or
        (macro-surface-decls-module-has-macro?
          (struct-get summary decls)
          target-module)
        (macro-surface-summaries-module-has-macro? (box-get rest) target-module))]))

(define (macro-surface-module-has-macro? [target-module : String]) : bool
  (macro-surface-summaries-module-has-macro?
    (compiler-load-surface-summaries)
    target-module))

(defenum MacroSurfaceCallDeclCacheLookup
  (Miss)
  (Hit MacroMaybeDecl))

(define macro-surface-call-decl-cache-capacity : i64
  8192)
(define macro-surface-call-decl-cache-module-keys : (Array i64)
  (array.make-array i64 8192))
(define macro-surface-call-decl-cache-base-keys : (Array i64)
  (array.make-array i64 8192))
(define macro-surface-call-decl-cache-values : (Array MacroMaybeDecl)
  (array.make-array MacroMaybeDecl 8192))
(define macro-surface-call-decl-cache-count : i64
  0)
(define macro-surface-call-decl-cache-generation : i64
  -1)
(define macro-surface-call-decl-cache-ready : bool
  false)

(define (macro-surface-call-decl-cache-reset!) : unit
  (set! macro-surface-call-decl-cache-ready false))

(define (macro-surface-call-decl-cache-ensure!) : unit
  (if (if macro-surface-call-decl-cache-ready
    (= macro-surface-call-decl-cache-generation (intern-generation))
    false)
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i macro-surface-call-decl-cache-capacity)
          (begin
            (array-set! macro-surface-call-decl-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set! macro-surface-call-decl-cache-count 0)
        (set! macro-surface-call-decl-cache-generation (intern-generation))
        (set! macro-surface-call-decl-cache-ready true)))))

(define (macro-surface-call-decl-cache-bucket [module-id : i64] [base-id : i64]) : i64
  (bit-and
    (+ (* module-id 2654435761) (* base-id 40503))
    (- macro-surface-call-decl-cache-capacity 1)))

(define (macro-surface-call-decl-cache-get [module-id : i64] [base-id : i64]) : MacroSurfaceCallDeclCacheLookup
  (let
    [cursor : i64 (macro-surface-call-decl-cache-bucket module-id base-id)]
    [module-key : i64 (+ module-id 1)]
    [base-key : i64 (+ base-id 1)]
    [steps : i64 0]
    [out : MacroSurfaceCallDeclCacheLookup
      (MacroSurfaceCallDeclCacheLookup.Miss)]
    [done : bool false]
    (begin
      (while (if done
        false
        (< steps macro-surface-call-decl-cache-capacity))
        (let
          [slot : i64
            (array-ref macro-surface-call-decl-cache-module-keys cursor)]
          (if (= slot 0)
            (set! done true)
            (if (and
              (= slot module-key)
              (=
                (array-ref macro-surface-call-decl-cache-base-keys cursor)
                base-key))
              (begin
                (set!
                  out
                  (MacroSurfaceCallDeclCacheLookup.Hit
                    (array-ref macro-surface-call-decl-cache-values cursor)))
                (set! done true))
              (begin
                (set!
                  cursor
                  (bit-and
                    (+ cursor 1)
                    (- macro-surface-call-decl-cache-capacity 1)))
                (set! steps (+ steps 1)))))))
      out)))

(define (macro-surface-call-decl-cache-put!
  [module-id : i64]
  [base-id : i64]
  [value : MacroMaybeDecl]) : unit
  (if (>=
    (* macro-surface-call-decl-cache-count 2)
    macro-surface-call-decl-cache-capacity)
    unit
    (let
      [cursor : i64 (macro-surface-call-decl-cache-bucket module-id base-id)]
      [module-key : i64 (+ module-id 1)]
      [base-key : i64 (+ base-id 1)]
      [steps : i64 0]
      [done : bool false]
      (begin
        (while (if done
          false
          (< steps macro-surface-call-decl-cache-capacity))
          (let
            [slot : i64
              (array-ref macro-surface-call-decl-cache-module-keys cursor)]
            (if (= slot 0)
              (begin
                (array-set!
                  macro-surface-call-decl-cache-module-keys
                  cursor
                  module-key)
                (array-set!
                  macro-surface-call-decl-cache-base-keys
                  cursor
                  base-key)
                (array-set! macro-surface-call-decl-cache-values cursor value)
                (set!
                  macro-surface-call-decl-cache-count
                  (+ macro-surface-call-decl-cache-count 1))
                (set! done true))
              (if (and
                (= slot module-key)
                (=
                  (array-ref macro-surface-call-decl-cache-base-keys cursor)
                  base-key))
                (begin
                  (array-set! macro-surface-call-decl-cache-values cursor value)
                  (set! done true))
                (begin
                  (set!
                    cursor
                    (bit-and
                      (+ cursor 1)
                      (- macro-surface-call-decl-cache-capacity 1)))
                  (set! steps (+ steps 1)))))))
        unit))))

(define (macro-surface-decl-call-decl-in-module
  [decl : CompilerLoadSurfaceDecl]
  [target-module : String]
  [base : String]) : MacroMaybeDecl
  (if (and
    (string.eq (struct-get decl module) target-module)
    (string.eq (struct-get decl name) base)
    (match (struct-get decl kind)
      [(CompilerLoadSurfaceMacro) true]
      [_ false]))
    (match (struct-get decl signature)
      [(CompilerLoadSurfaceMacroSignature params ret body-box)
        (begin
          (tc-lazy-import-summary-macro-force-record!)
          (MacroMaybeDecl.Some
            (compiler-symbol-module-key target-module base)
            target-module
            params
            ret
            (ast-node-get body-box)))]
      [_ (MacroMaybeDecl.No)])
    (MacroMaybeDecl.No)))

(define (macro-surface-decls-call-decl-in-module
  [decls : CompilerLoadSurfaceDeclList]
  [target-module : String]
  [base : String]) : MacroMaybeDecl
  (match decls
    [(CompilerLoadSurfaceDeclNil) (MacroMaybeDecl.No)]
    [(CompilerLoadSurfaceDeclCons decl rest)
      (match (macro-surface-decl-call-decl-in-module decl target-module base)
        [(MacroMaybeDecl.Some macro-name def-module params ret body)
          (MacroMaybeDecl.Some macro-name def-module params ret body)]
        [(MacroMaybeDecl.No)
          (macro-surface-decls-call-decl-in-module
            (box-get rest)
            target-module
            base)])]))

(define (macro-surface-summaries-call-decl-in-module
  [summaries : CompilerLoadSurfaceSummaryList]
  [target-module : String]
  [base : String]) : MacroMaybeDecl
  (match summaries
    [(CompilerLoadSurfaceSummaryNil) (MacroMaybeDecl.No)]
    [(CompilerLoadSurfaceSummaryCons summary rest)
      (match (macro-surface-decls-call-decl-in-module
        (struct-get summary decls)
        target-module
        base)
        [(MacroMaybeDecl.Some macro-name def-module params ret body)
          (MacroMaybeDecl.Some macro-name def-module params ret body)]
        [(MacroMaybeDecl.No)
          (macro-surface-summaries-call-decl-in-module
            (box-get rest)
            target-module
            base)])]))

(define (macro-surface-call-decl-in-module
  [target-module : String]
  [base : String]) : MacroMaybeDecl
  (let
    [module-id : i64 (intern target-module)]
    [base-id : i64 (intern base)]
    (begin
      (macro-surface-call-decl-cache-ensure!)
      (match (macro-surface-call-decl-cache-get module-id base-id)
        [(MacroSurfaceCallDeclCacheLookup.Hit cached) cached]
        [(MacroSurfaceCallDeclCacheLookup.Miss)
          (let
            [result : MacroMaybeDecl
              (macro-surface-summaries-call-decl-in-module
                (compiler-load-surface-summaries)
                target-module
                base)]
            (begin
              (macro-surface-call-decl-cache-put! module-id base-id result)
              result))]))))

(define (macro-expr-uses-expr-type? [expr : AstExpr]) : bool
  (or
    (tc-expr-uses-free-name? expr "expr-type" TcStringList.Nil)
    (tc-expr-uses-free-name? expr "comptime.expr-type" TcStringList.Nil)
    (tc-expr-uses-free-name? expr "comptime/expr-type" TcStringList.Nil)
    (tc-expr-uses-free-name? expr "stdlib.comptime.expr-type" TcStringList.Nil)
    (tc-expr-uses-free-name? expr "stdlib.comptime/expr-type" TcStringList.Nil)
    (tc-expr-uses-free-name? expr "stdlib/comptime.expr-type" TcStringList.Nil)
    (tc-expr-uses-free-name? expr "stdlib/comptime/expr-type" TcStringList.Nil)))

(define (macro-collect-expr-type-decl-name
  [decl : AstDecl]
  [module : String]
  [acc : TcStringList]) : TcStringList
  (match decl
    [(AstDecl.DefMacro name _ _ body-box)
      (let
        [body : AstExpr (ast-node-get body-box)]
        [name-str : String (intern-str name)]
        (if (macro-expr-uses-expr-type? body)
          (tc-string-list-add acc (compiler-symbol-module-key module name-str))
          acc))]
    [(AstDecl.Unsafe inner-box)
      (macro-collect-expr-type-decl-name (box-get inner-box) module acc)]
    [(AstDecl.ComptimeDecl _ template-box)
      (macro-collect-expr-type-decl-name (box-get template-box) module acc)]
    [_ acc]))

(define (macro-collect-expr-type-macro-names-in
  [decls : AstDeclList]
  [module : String]
  [acc : TcStringList]) : TcStringList
  (let
    [cur : AstDeclList decls]
    [cur-module-id : i64 (intern module)]
    [out : TcStringList acc]
    (begin
      (while (match (ast-decl-list-step cur)
        [(AstDeclListStep.Nil) false]
        [_ true])
        (match (ast-decl-list-step cur)
          [(AstDeclListStep.Nil) unit]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (match decl
                [(AstDecl.Module next-module) (set! cur-module-id next-module)]
                [_
                  (set!
                    out
                    (macro-collect-expr-type-decl-name
                      decl
                      (intern-str cur-module-id)
                      out))])
              (set! cur rest))]))
      out)))

(define (macro-collect-expr-type-macro-names [decls : AstDeclList]) : TcStringList
  (macro-collect-expr-type-macro-names-in decls "" TcStringList.Nil))

(define (macro-hygiene-env-lookup [env : MacroHygieneEnv] [name : String]) : TcMaybeString
  (match env
    [(MacroHygieneEnv.Nil) (TcMaybeString.No)]
    [(MacroHygieneEnv.Bind key value rest)
      (if (string.eq key name)
        (TcMaybeString.Some value)
        (macro-hygiene-env-lookup (box-get rest) name))]))

(define (macro-canonical-name [module : String] [name : String]) : String
  (compiler-symbol-module-key module name))

(define (macro-hygiene-definition-module [macro-name : String]) : String
  (if (tc-name-qualified? macro-name)
    (tc-qualified-name-module macro-name)
    ""))

(define (macro-hygiene-definition-base [macro-name : String]) : String
  (if (tc-name-qualified? macro-name)
    (tc-qualified-name-base macro-name)
    macro-name))

(define (macro-hygiene-context-macro-name
  [macro-name : String]
  [module : String]) : String
  (if (tc-name-qualified? macro-name)
    macro-name
    (if (string.eq module "")
      macro-name
      (compiler-symbol-module-key module macro-name))))

(define (macro-hygiene-global-name-for [macro-name : String] [base : String]) : String
  (let
    [definition-module : String (macro-hygiene-definition-module macro-name)]
    [macro-base : String (macro-hygiene-definition-base macro-name)]
    (if (and (not (tc-name-qualified? base)) (string.eq base macro-base))
      (tc-hygiene-global-name
        (compiler-symbol-module-key definition-module base))
      (tc-hygiene-global-context-name definition-module base))))

(define (macro-hygiene-fresh-local
  [macro-name : String]
  [depth : i64]
  [base : String]) : String
  (string.append
    (tc-hygiene-local-prefix)
    (string.append
      (string.int->string depth)
      (string.append "$" (string.append macro-name (string.append "$" base))))))

(define (macro-hygiene-rename-var
  [env : MacroHygieneEnv]
  [macro-name : String]
  [name : String]) : String
  (if (tc-hygiene-template-name? name)
    (let
      [base : String (tc-hygiene-template-base name)]
      (match (macro-hygiene-env-lookup env base)
        [(TcMaybeString.Some renamed) renamed]
        [(TcMaybeString.No) (macro-hygiene-global-name-for macro-name base)]))
    name))

(define (macro-hygiene-bind-name
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]
  [name : String]) : MacroHygieneName
  (if (tc-hygiene-template-name? name)
    (let
      [base : String (tc-hygiene-template-base name)]
      [renamed : String (macro-hygiene-fresh-local macro-name depth base)]
      (MacroHygieneName.Name
        renamed
        (MacroHygieneEnv.Bind base renamed (box env))))
    (MacroHygieneName.Name name env)))

(define (macro-hygiene-expr-list
  [exprs : AstExprList]
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]) : AstExprList
  (let
    [out : AstExprList (ast-expr-list-with-capacity (struct-get (& exprs) len))]
    (begin
      (macro-hygiene-expr-list-into (& exprs) 0 env macro-name depth (&mut out))
      out)))

(define (macro-hygiene-expr-list-into
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]
  [out : (&mut out AstExprList)]) : unit
  (if (>= index (struct-get exprs len))
    unit
    (begin
      (ast-expr-list-push
        out
        (macro-hygiene-expr
          (ast-node-get (ast-expr-list-get exprs index 0))
          env
          macro-name
          depth))
      (macro-hygiene-expr-list-into exprs (+ index 1) env macro-name depth out))))

(define (macro-hygiene-param-list
  [params : AstParamList]
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]) : MacroHygieneParams
  (macro-hygiene-param-list-at (& params) 0 env macro-name depth))

(define (macro-hygiene-param-list-at
  [params : (& params AstParamList)]
  [index : i64]
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]) : MacroHygieneParams
  (if (>= index (ast-param-list-len params))
    (MacroHygieneParams.Params (ast-param-list-new) env)
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param name ty comptime?)
        (match (macro-hygiene-bind-name env macro-name depth (intern-str name))
          [(MacroHygieneName.Name renamed next-env)
            (match (macro-hygiene-param-list-at
              params
              (+ index 1)
              next-env
              macro-name
              depth)
              [(MacroHygieneParams.Params nrest final-env)
                (MacroHygieneParams.Params
                  (ast-param-cons (ast-param renamed ty comptime?) nrest)
                  final-env)])])])))

(define (macro-hygiene-pattern-list
  [patterns : AstPatternList]
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]) : MacroHygienePatternList
  (let
    [out : AstPatternList
      (ast-pattern-list-with-capacity (struct-get (& patterns) len))]
    [final-env : MacroHygieneEnv
      (macro-hygiene-pattern-list-into
        (& patterns)
        0
        env
        macro-name
        depth
        (&mut out))]
    (MacroHygienePatternList.PatternList out final-env)))

(define (macro-hygiene-pattern-list-into
  [patterns : (& patterns AstPatternList)]
  [index : i64]
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]
  [out : (&mut out AstPatternList)]) : MacroHygieneEnv
  (if (>= index (struct-get patterns len))
    env
    (match (macro-hygiene-pattern
      (ast-pattern-list-get patterns index (ast-pattern-fallback))
      env
      macro-name
      depth)
      [(MacroHygienePattern.Pattern npattern next-env)
        (begin
          (ast-pattern-list-push out npattern)
          (macro-hygiene-pattern-list-into
            patterns
            (+ index 1)
            next-env
            macro-name
            depth
            out))])))

(define (macro-hygiene-pattern
  [pattern : AstPattern]
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]) : MacroHygienePattern
  (match pattern
    [(AstPattern.Var name maybe-ty)
      (match (macro-hygiene-bind-name env macro-name depth (intern-str name))
        [(MacroHygieneName.Name renamed next-env)
          (MacroHygienePattern.Pattern
            (AstPattern.Var (intern renamed) maybe-ty)
            next-env)])]
    [(AstPattern.Tuple patterns-box)
      (let
        [patterns : AstPatternList (box-get patterns-box)]
        (match (macro-hygiene-pattern-list patterns env macro-name depth)
          [(MacroHygienePatternList.PatternList npatterns next-env)
            (MacroHygienePattern.Pattern (ast-pat-tuple npatterns) next-env)]))]
    [(AstPattern.Wildcard)
      (MacroHygienePattern.Pattern AstPattern.Wildcard env)]
    [(AstPattern.Binding name)
      (match (macro-hygiene-bind-name env macro-name depth (intern-str name))
        [(MacroHygieneName.Name renamed next-env)
          (MacroHygienePattern.Pattern (ast-pat-binding renamed) next-env)])]
    [(AstPattern.Variant name args-box)
      (let
        [args : AstPatternList (box-get args-box)]
        (match (macro-hygiene-pattern-list args env macro-name depth)
          [(MacroHygienePatternList.PatternList nargs next-env)
            (MacroHygienePattern.Pattern
              (ast-pat-variant-id name nargs)
              next-env)]))]
    [(AstPattern.Literal lit)
      (MacroHygienePattern.Pattern (AstPattern.Literal lit) env)]))

(define (macro-hygiene-let-bindings
  [bindings : AstLetBindingList]
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]) : MacroHygieneLetBindings
  (let
    [out : AstLetBindingList
      (ast-let-binding-list-with-capacity
        (ast-let-binding-list-len (& bindings)))]
    [final-env : MacroHygieneEnv
      (macro-hygiene-let-bindings-into
        (& bindings)
        env
        macro-name
        depth
        0
        (&mut out))]
    (MacroHygieneLetBindings.LetBindings out final-env)))

(define (macro-hygiene-let-bindings-into
  [bindings : (& bindings AstLetBindingList)]
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]
  [index : i64]
  [out : (&mut out AstLetBindingList)]) : MacroHygieneEnv
  (if (>= index (ast-let-binding-list-len bindings))
    env
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          [ninit : i64 (macro-hygiene-expr init env macro-name depth)]
          (match (macro-hygiene-bind-name
            env
            macro-name
            depth
            (intern-str name))
            [(MacroHygieneName.Name renamed next-env)
              (begin
                (ast-let-binding-list-push
                  out
                  (ast-let-binding renamed maybe-ty ninit))
                (macro-hygiene-let-bindings-into
                  bindings
                  next-env
                  macro-name
                  depth
                  (+ index 1)
                  out))]))])))

(define (macro-hygiene-resource-bindings
  [bindings : AstResourceBindingList]
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]) : MacroHygieneResourceBindings
  (let
    [out : AstResourceBindingList
      (ast-resource-binding-list-with-capacity
        (ast-resource-binding-list-len (& bindings)))]
    [final-env : MacroHygieneEnv
      (macro-hygiene-resource-bindings-into
        (& bindings)
        env
        macro-name
        depth
        0
        (&mut out))]
    (MacroHygieneResourceBindings.ResourceBindings out final-env)))

(define (macro-hygiene-resource-bindings-into
  [bindings : (& bindings AstResourceBindingList)]
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]
  [index : i64]
  [out : (&mut out AstResourceBindingList)]) : MacroHygieneEnv
  (if (>= index (ast-resource-binding-list-len bindings))
    env
    (match (ast-resource-binding-list-get
      bindings
      index
      (ast-resource-binding-fallback))
      [(AstResourceBinding.Binding name init-box cleanup-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          [cleanup : AstExpr (ast-node-get cleanup-box)]
          [ninit : i64 (macro-hygiene-expr init env macro-name depth)]
          [ncleanup : i64 (macro-hygiene-expr cleanup env macro-name depth)]
          (match (macro-hygiene-bind-name
            env
            macro-name
            depth
            (intern-str name))
            [(MacroHygieneName.Name renamed next-env)
              (begin
                (ast-resource-binding-list-push
                  out
                  (ast-resource-binding renamed ninit ncleanup))
                (macro-hygiene-resource-bindings-into
                  bindings
                  next-env
                  macro-name
                  depth
                  (+ index 1)
                  out))]))])))

(define (macro-hygiene-arm-list
  [arms : AstMatchArmList]
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]) : AstMatchArmList
  (let
    [out : AstMatchArmList
      (ast-match-arm-list-with-capacity (struct-get (& arms) len))]
    (begin
      (macro-hygiene-arm-list-into (& arms) 0 env macro-name depth (&mut out))
      out)))

(define (macro-hygiene-arm-list-into
  [arms : (& arms AstMatchArmList)]
  [index : i64]
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]
  [out : (&mut out AstMatchArmList)]) : unit
  (if (>= index (struct-get arms len))
    unit
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (match (macro-hygiene-pattern pattern env macro-name depth)
          [(MacroHygienePattern.Pattern npattern arm-env)
            (begin
              (ast-match-arm-list-push
                out
                (ast-match-arm
                  npattern
                  (macro-hygiene-expr
                    (ast-node-get body-box)
                    arm-env
                    macro-name
                    depth)))
              (macro-hygiene-arm-list-into
                arms
                (+ index 1)
                env
                macro-name
                depth
                out))])])))

(define (macro-hygiene-expr
  [expr : AstExpr]
  [env : MacroHygieneEnv]
  [macro-name : String]
  [depth : i64]) : i64
  (match expr
    [(AstExpr.Spanned inner-box span)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-spanned (macro-hygiene-expr inner env macro-name depth) span))]
    [(AstExpr.Var name)
      (ast-node-push
        (AstExpr.Var
          (intern (macro-hygiene-rename-var env macro-name (intern-str name)))))]
    [(AstExpr.Binary op left-box right-box)
      (let
        [left : AstExpr (ast-node-get left-box)]
        [right : AstExpr (ast-node-get right-box)]
        (ast-expr-binary
          op
          (macro-hygiene-expr left env macro-name depth)
          (macro-hygiene-expr right env macro-name depth)))]
    [(AstExpr.Unary op inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-unary op (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExpr.Call func-box args)
      (let
        [func : AstExpr (ast-node-get func-box)]
        (ast-expr-call
          (macro-hygiene-expr func env macro-name depth)
          (macro-hygiene-expr-list args env macro-name depth)))]
    [(AstExpr.BracketClause items)
      (ast-expr-bracket-clause
        (macro-hygiene-expr-list items env macro-name depth))]
    [(AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [then-branch : AstExpr (ast-node-get then-branch-box)]
        [else-branch : AstExpr (ast-node-get else-branch-box)]
        (ast-expr-if
          (macro-hygiene-expr cond env macro-name depth)
          (macro-hygiene-expr then-branch env macro-name depth)
          (macro-hygiene-expr else-branch env macro-name depth)))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (macro-hygiene-let-bindings bindings env macro-name depth)
              [(MacroHygieneLetBindings.LetBindings nbindings body-env)
                (ast-expr-let
                  nbindings
                  (macro-hygiene-expr body body-env macro-name depth))]))])]
    [(AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(AstLambda.Lambda params maybe-ret body-box)
          (let
            [body : AstExpr (ast-node-get body-box)]
            (match (macro-hygiene-param-list params env macro-name depth)
              [(MacroHygieneParams.Params nparams body-env)
                (ast-expr-lambda
                  nparams
                  maybe-ret
                  (macro-hygiene-expr body body-env macro-name depth))]))])]
    [(AstExpr.Tuple exprs)
      (ast-node-push
        (AstExpr.Tuple (macro-hygiene-expr-list exprs env macro-name depth)))]
    [(AstExpr.TupleRef tuple-expr-box index)
      (let
        [tuple-expr : AstExpr (ast-node-get tuple-expr-box)]
        (ast-expr-tuple-ref
          (macro-hygiene-expr tuple-expr env macro-name depth)
          index))]
    [(AstExpr.Array exprs)
      (ast-node-push
        (AstExpr.Array (macro-hygiene-expr-list exprs env macro-name depth)))]
    [(AstExpr.MakeArray ty len-box)
      (let
        [len : AstExpr (ast-node-get len-box)]
        (ast-expr-make-array ty (macro-hygiene-expr len env macro-name depth)))]
    [(AstExpr.ArrayRef array-box index-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        (ast-expr-array-ref
          (macro-hygiene-expr array env macro-name depth)
          (macro-hygiene-expr index env macro-name depth)))]
    [(AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [index : AstExpr (ast-node-get index-box)]
        [value : AstExpr (ast-node-get value-box)]
        (ast-expr-array-set
          (macro-hygiene-expr array env macro-name depth)
          (macro-hygiene-expr index env macro-name depth)
          (macro-hygiene-expr value env macro-name depth)))]
    [(AstExpr.ArrayPush array-box value-box)
      (let
        [array : AstExpr (ast-node-get array-box)]
        [value : AstExpr (ast-node-get value-box)]
        (ast-expr-array-push
          (macro-hygiene-expr array env macro-name depth)
          (macro-hygiene-expr value env macro-name depth)))]
    [(AstExpr.StringRef text-box index-box)
      (let
        [text : AstExpr (ast-node-get text-box)]
        [index : AstExpr (ast-node-get index-box)]
        (ast-expr-string-ref
          (macro-hygiene-expr text env macro-name depth)
          (macro-hygiene-expr index env macro-name depth)))]
    [(AstExpr.While cond-box body-box)
      (let
        [cond : AstExpr (ast-node-get cond-box)]
        [body : AstExpr (ast-node-get body-box)]
        (ast-expr-while
          (macro-hygiene-expr cond env macro-name depth)
          (macro-hygiene-expr body env macro-name depth)))]
    [(AstExpr.Begin exprs)
      (ast-node-push
        (AstExpr.Begin (macro-hygiene-expr-list exprs env macro-name depth)))]
    [(AstExpr.Unsafe exprs)
      (ast-node-push
        (AstExpr.Unsafe (macro-hygiene-expr-list exprs env macro-name depth)))]
    [(AstExpr.Set name rhs-box)
      (let
        [rhs : AstExpr (ast-node-get rhs-box)]
        (ast-expr-set
          (macro-hygiene-rename-var env macro-name (intern-str name))
          (macro-hygiene-expr rhs env macro-name depth)))]
    [(AstExpr.Ann inner-box ty)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-ann (macro-hygiene-expr inner env macro-name depth) ty))]
    [(AstExpr.Cast inner-box ty)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-cast (macro-hygiene-expr inner env macro-name depth) ty))]
    [(AstExpr.Borrow mutable lifetime place-box)
      (let
        [place : AstExpr (ast-node-get place-box)]
        (ast-expr-borrow
          mutable
          lifetime
          (macro-hygiene-expr place env macro-name depth)))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrut-box arms)
          (let
            [scrut : AstExpr (ast-node-get scrut-box)]
            (ast-expr-match
              (macro-hygiene-expr scrut env macro-name depth)
              (macro-hygiene-arm-list arms env macro-name depth)))])]
    [(AstExpr.Foreach fe-box)
      (match (box-get fe-box)
        [(AstForeach.Foreach index index-ty start-box end-box body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (macro-hygiene-bind-name
              env
              macro-name
              depth
              (intern-str index))
              [(MacroHygieneName.Name nindex body-env)
                (ast-expr-foreach
                  nindex
                  index-ty
                  (macro-hygiene-expr start env macro-name depth)
                  (macro-hygiene-expr end env macro-name depth)
                  (macro-hygiene-expr body body-env macro-name depth))]))])]
    [(AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(AstSpmdReduce.Reduce
            op
            index
            index-ty
            start-box
            end-box
            init-box
            value-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            (match (macro-hygiene-bind-name
              env
              macro-name
              depth
              (intern-str index))
              [(MacroHygieneName.Name nindex body-env)
                (ast-expr-spmd-reduce
                  op
                  nindex
                  index-ty
                  (macro-hygiene-expr start env macro-name depth)
                  (macro-hygiene-expr end env macro-name depth)
                  (macro-hygiene-expr init env macro-name depth)
                  (macro-hygiene-expr value body-env macro-name depth))]))])]
    [(AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(AstSpmdScan.Scan
            op
            index
            index-ty
            start-box
            end-box
            prefix
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : AstExpr (ast-node-get start-box)]
            [end : AstExpr (ast-node-get end-box)]
            [init : AstExpr (ast-node-get init-box)]
            [value : AstExpr (ast-node-get value-box)]
            [body : AstExpr (ast-node-get body-box)]
            (match (macro-hygiene-bind-name
              env
              macro-name
              depth
              (intern-str index))
              [(MacroHygieneName.Name nindex value-env)
                (match (macro-hygiene-bind-name
                  value-env
                  macro-name
                  depth
                  (intern-str prefix))
                  [(MacroHygieneName.Name nprefix body-env)
                    (ast-expr-spmd-scan
                      op
                      nindex
                      index-ty
                      (macro-hygiene-expr start env macro-name depth)
                      (macro-hygiene-expr end env macro-name depth)
                      nprefix
                      prefix-ty
                      (macro-hygiene-expr init env macro-name depth)
                      (macro-hygiene-expr value value-env macro-name depth)
                      (macro-hygiene-expr body body-env macro-name depth))])]))])]
    [(AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (ast-expr-spmd-broadcast
          (macro-hygiene-expr value env macro-name depth)
          (macro-hygiene-expr lane env macro-name depth)))]
    [(AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : AstExpr (ast-node-get value-box)]
        [lane : AstExpr (ast-node-get lane-box)]
        (ast-expr-spmd-shuffle
          (macro-hygiene-expr value env macro-name depth)
          (macro-hygiene-expr lane env macro-name depth)))]
    [(AstExpr.StructGet inner-box field)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-struct-get
          (macro-hygiene-expr inner env macro-name depth)
          (intern-str field)))]
    [(AstExpr.StructSet inner-box field value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (ast-expr-struct-set-id
          (macro-hygiene-expr inner env macro-name depth)
          field
          (macro-hygiene-expr value env macro-name depth)))]
    [(AstExpr.WithRegion name body)
      (match (macro-hygiene-bind-name env macro-name depth name)
        [(MacroHygieneName.Name nname body-env)
          (ast-node-push
            (AstExpr.WithRegion
              nname
              (macro-hygiene-expr-list body body-env macro-name depth)))])]
    [(AstExpr.WithEscape scratch-box body)
      (let
        [scratch : AstExpr (ast-node-get scratch-box)]
        (ast-expr-with-escape
          (macro-hygiene-expr scratch env macro-name depth)
          (macro-hygiene-expr-list body env macro-name depth)))]
    [(AstExpr.WithScratch body)
      (ast-expr-with-scratch
        (macro-hygiene-expr-list body env macro-name depth))]
    [(AstExpr.InArena arena-box body)
      (let
        [arena : AstExpr (ast-node-get arena-box)]
        (ast-expr-in-arena
          (macro-hygiene-expr arena env macro-name depth)
          (macro-hygiene-expr-list body env macro-name depth)))]
    [(AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(AstWithResource.WithResource bindings body)
          (match (macro-hygiene-resource-bindings bindings env macro-name depth)
            [(MacroHygieneResourceBindings.ResourceBindings nbindings body-env)
              (ast-node-push
                (AstExpr.WithResource
                  (box
                    (AstWithResource.WithResource
                      nbindings
                      (macro-hygiene-expr-list body body-env macro-name depth)))))])])]
    [(AstExpr.Box inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-box (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExpr.BoxGet inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-box-get (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExpr.BoxTake inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-box-take (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExpr.BoxSet inner-box value-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        [value : AstExpr (ast-node-get value-box)]
        (ast-expr-box-set
          (macro-hygiene-expr inner env macro-name depth)
          (macro-hygiene-expr value env macro-name depth)))]
    [(AstExpr.TypeLiteral ty) (ast-node-push (AstExpr.TypeLiteral ty))]
    [(AstExpr.Init maybe-ty) (ast-expr-init-maybe maybe-ty)]
    [(AstExpr.Comptime inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-comptime (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExpr.Return inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-return (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExpr.Try inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-try (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExpr.PtrNull ty) (ast-node-push (AstExpr.PtrNull ty))]
    [(AstExpr.PtrNullCheck ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (ast-expr-ptr-null-check (macro-hygiene-expr ptr env macro-name depth)))]
    [(AstExpr.PtrAddrOf name)
      (ast-expr-ptr-addr-of
        (macro-hygiene-rename-var env macro-name (intern-str name)))]
    [(AstExpr.PtrRead ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (ast-expr-ptr-read (macro-hygiene-expr ptr env macro-name depth)))]
    [(AstExpr.PtrWrite ptr-box value-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [value : AstExpr (ast-node-get value-box)]
        (ast-expr-ptr-write
          (macro-hygiene-expr ptr env macro-name depth)
          (macro-hygiene-expr value env macro-name depth)))]
    [(AstExpr.PtrOffset ptr-box offset-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [offset : AstExpr (ast-node-get offset-box)]
        (ast-expr-ptr-offset
          (macro-hygiene-expr ptr env macro-name depth)
          (macro-hygiene-expr offset env macro-name depth)))]
    [(AstExpr.PtrCast ptr-box ty)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (ast-expr-ptr-cast (macro-hygiene-expr ptr env macro-name depth) ty))]
    [(AstExpr.PtrToInt ptr-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        (ast-expr-ptr-to-int (macro-hygiene-expr ptr env macro-name depth)))]
    [(AstExpr.IntToPtr value-box ty)
      (let
        [value : AstExpr (ast-node-get value-box)]
        (ast-expr-int-to-ptr (macro-hygiene-expr value env macro-name depth) ty))]
    [(AstExpr.StringData inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-string-data (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : AstExpr (ast-node-get ptr-box)]
        [len : AstExpr (ast-node-get len-box)]
        (ast-expr-string-from-bytes
          (macro-hygiene-expr ptr env macro-name depth)
          (macro-hygiene-expr len env macro-name depth)))]
    [(AstExpr.ArrayData inner-box)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-array-data (macro-hygiene-expr inner env macro-name depth)))]
    [(AstExpr.BinaryData bytes) (ast-node-push (AstExpr.BinaryData bytes))]
    [(AstExpr.SpmdProgramIndex) (ast-expr-spmd-program-index)]
    [(AstExpr.SpmdProgramCount) (ast-expr-spmd-program-count)]
    [(AstExpr.CpuIdEax leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (ast-expr-cpuid-eax
          (macro-hygiene-expr leaf env macro-name depth)
          (macro-hygiene-expr subleaf env macro-name depth)))]
    [(AstExpr.CpuIdEbx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (ast-expr-cpuid-ebx
          (macro-hygiene-expr leaf env macro-name depth)
          (macro-hygiene-expr subleaf env macro-name depth)))]
    [(AstExpr.CpuIdEcx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (ast-expr-cpuid-ecx
          (macro-hygiene-expr leaf env macro-name depth)
          (macro-hygiene-expr subleaf env macro-name depth)))]
    [(AstExpr.CpuIdEdx leaf-box subleaf-box)
      (let
        [leaf : AstExpr (ast-node-get leaf-box)]
        [subleaf : AstExpr (ast-node-get subleaf-box)]
        (ast-expr-cpuid-edx
          (macro-hygiene-expr leaf env macro-name depth)
          (macro-hygiene-expr subleaf env macro-name depth)))]
    [(AstExpr.Xgetbv index-box)
      (let
        [index : AstExpr (ast-node-get index-box)]
        (ast-expr-xgetbv (macro-hygiene-expr index env macro-name depth)))]
    [(AstExpr.Syscall args)
      (ast-expr-syscall (macro-hygiene-expr-list args env macro-name depth))]
    [(AstExpr.Quote _) (ast-node-push expr)]
    [(AstExpr.Quasiquote _) (ast-node-push expr)]
    [(AstExpr.Unquote _) (ast-node-push expr)]
    [(AstExpr.UnquoteSplicing _) (ast-node-push expr)]
    [_ (ast-node-push expr)]))

(define (macro-expand-depth-limit) : i64
  64)

(define (macro-find-decl-in-module
  [decls : AstDeclList]
  [name : String]
  [module : String]) : MacroMaybeDecl
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) (MacroMaybeDecl.No)]
    [(AstDeclListStep.Cons decl rest)
      (let
        [rest : AstDeclList rest]
        (match decl
          [(AstDecl.Module next-module)
            (macro-find-decl-in-module rest name (intern-str next-module))]
          [(AstDecl.DefMacro mname params ret body-box)
            (let
              [mname-str : String (intern-str mname)]
              [body : AstExpr (ast-node-get body-box)]
              (if (string.eq mname-str name)
                (MacroMaybeDecl.Some
                  (compiler-symbol-module-key module mname-str)
                  module
                  params
                  ret
                  body)
                (macro-find-decl-in-module rest name module)))]
          [_ (macro-find-decl-in-module rest name module)]))]))

(define (macro-find-decl [decls : AstDeclList] [name : String]) : MacroMaybeDecl
  (macro-find-decl-in-module decls name ""))

(define (macro-decl-from-decl [decl : AstDecl] [module : String]) : MacroMaybeDecl
  (match decl
    [(AstDecl.DefMacro name params ret body-box)
      (let
        [name-str : String (intern-str name)]
        [body : AstExpr (ast-node-get body-box)]
        (MacroMaybeDecl.Some
          (compiler-symbol-module-key module name-str)
          module
          params
          ret
          body))]
    [(AstDecl.Unsafe inner-box)
      (let
        [inner : AstDecl (box-get inner-box)]
        (macro-decl-from-decl inner module))]
    [(AstDecl.ComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (macro-decl-from-decl template module))]
    [_ (MacroMaybeDecl.No)]))

;; Resolve a macro decl from its symbol-table index in O(1). The symbols decls
;; array is populated (compiler-symbols-index-decl!) at the SAME index that
;; compiler-symbol-handle-index returns: build-compiler-symbol-list-in-module
;; writes the array slot and registers the handle with one shared `index`,
;; skipping the identical Import/IncludeStr/IncludeBin/Export/Module/Test set
;; that the old linear scan skipped. The array already stores the unwrapped decl
;; (compiler-symbol-indexed-decl peels AstDecl.Unsafe/AstDecl.ComptimeDecl the same
;; way macro-decl-from-decl does), so direct module lookups return the identical
;; MacroMaybeDecl.Some the previous O(decls) macro-find-decl-by-index walk produced.
(define (macro-decl-owner-module-or
  [symbols : CompilerSymbols]
  [target : i64]
  [fallback : String]) : String
  (match (compiler-symbols-owner-name-at-index symbols target)
    [(CompilerSomeString owner-name)
      (if (tc-name-qualified? owner-name)
        (tc-qualified-name-module owner-name)
        fallback)]
    [(CompilerNoString) fallback]))

(define (macro-decl-at-index-in-module
  [symbols : CompilerSymbols]
  [target : i64]
  [module : String]) : MacroMaybeDecl
  (match (compiler-symbols-decl-at-index symbols target)
    [(ResultAstDecl.Ok decl) (macro-decl-from-decl decl module)]
    [(ResultAstDecl.Err _) (MacroMaybeDecl.No)]))

;; Imported macro aliases can be looked up from the importing module. In that
;; path, recover the indexed owner module so the transformer still runs as its
;; original definition module.
(define (macro-decl-at-index-with-owner-module
  [symbols : CompilerSymbols]
  [target : i64]
  [module : String]) : MacroMaybeDecl
  (match (compiler-symbols-decl-at-index symbols target)
    [(ResultAstDecl.Ok decl)
      (macro-decl-from-decl
        decl
        (macro-decl-owner-module-or symbols target module))]
    [(ResultAstDecl.Err _) (MacroMaybeDecl.No)]))

;; The module accumulator and the current module compare as INTERN IDS: the
;; previous String-based walk converted every AstDecl.Module's interned name
;; back to a fresh String (`intern-str` allocates) and string-compared it, for
;; every declaration walked, on every qualified-alias resolution -- 11.6% of
;; the stage2 self-compile CPU profile. Import aliases still compare by
;; content, but only for imports declared in the current module.
(define (macro-import-alias-target-ids
  [decls : AstDeclList]
  [current-module-id : i64]
  [alias : String]
  [module-id : i64]) : TcMaybeString
  (let
    [index : i64 0]
    [count : i64 (ast-decl-list-len (& decls))]
    [decl-offset : i64 (struct-get decls offset)]
    [cur-module-id : i64 module-id]
    [result : TcMaybeString (TcMaybeString.No)]
    [done : bool false]
    (begin
      (while (and (not done) (< index count))
        (let
          [decl : AstDecl
            (array-ref (struct-get decls slots) (+ decl-offset index))]
          (begin
            (match (ast-decl-unwrapped decl)
              [(AstDecl.Module next-module) (set! cur-module-id next-module)]
              [(AstDecl.Import (AstImportSpec.Spec _ _ expected maybe-alias _))
                (match maybe-alias
                  [(AstMaybeImportAlias.Some import-alias)
                    (if (and
                      (= cur-module-id current-module-id)
                      (string.eq import-alias alias))
                      (begin
                        (set!
                          result
                          (match expected
                            [(AstMaybeModuleName.Some target)
                              (TcMaybeString.Some target)]
                            [(AstMaybeModuleName.No) (TcMaybeString.Some alias)]))
                        (set! done true))
                      unit)]
                  [(AstMaybeImportAlias.No) unit])]
              [_ unit])
            (set! index (+ index 1)))))
      result)))

;; --- import-aware macro resolution caches -------------------------------------
;;
;; Qualified-alias lookup and unqualified flat-import lookup both derive from the
;; program's AstDecl.Module/AstDecl.Import declarations. Cache them at the same
;; per-program boundary so generated macro bodies do not repeatedly rescan the
;; whole declaration list.
(defenum MacroFlatImportTargetList
  (Nil)
  (Cons i64 (Box MacroFlatImportTargetList)))

(defenum MacroFlatImportTargetCacheLookup
  (Missing)
  (Hit MacroFlatImportTargetList))

;; Even with id compares, each resolution walks the ENTIRE declaration list
;; (most declarations are neither modules nor imports), and the same
;; (current-module, qualifier) pair resolves identically for the whole
;; program: the mapping is derived only from AstDecl.Module/AstDecl.Import
;; declarations, which macro expansion, comptime generation, and
;; specialization never insert or reorder mid-compile. Memoize per
;; generation (same idiom as the marker name-id memos), open-addressed and
;; keyed by the two intern ids. Module key slots store module-id+1 so the zeroed
;; table is empty; qualifier slots store qualifier-id+1, and values store the
;; resolved target's intern id, or -1 for "no alias import" (return the
;; qualifier unchanged). Inserts stop at half load -- only memoization, never
;; correctness, degrades.
(define macro-alias-cache-capacity : i64
  4096)
(define macro-alias-cache-module-keys : (Array i64)
  (array.make-array i64 4096))
(define macro-alias-cache-qualifier-keys : (Array i64)
  (array.make-array i64 4096))
(define macro-alias-cache-values : (Array i64)
  (array.make-array i64 4096))
(define macro-alias-cache-count : i64
  0)
(define macro-alias-cache-generation : i64
  -1)
(define macro-alias-cache-ready : bool
  false)
(define macro-unqualified-import-cache-capacity : i64
  65536)
(define macro-unqualified-import-cache-module-keys : (Array i64)
  (array.make-array i64 65536))
(define macro-unqualified-import-cache-name-keys : (Array i64)
  (array.make-array i64 65536))
(define macro-unqualified-import-cache-values : (Array i64)
  (array.make-array i64 65536))
(define macro-unqualified-import-cache-count : i64
  0)
(define macro-unqualified-import-cache-generation : i64
  -1)
(define macro-unqualified-import-cache-ready : bool
  false)
(define macro-flat-import-target-cache-capacity : i64
  1024)
(define macro-flat-import-target-cache-module-keys : (Array i64)
  (array.make-array i64 1024))
(define macro-flat-import-target-cache-values : (Array
    MacroFlatImportTargetList)
  (array.make-array MacroFlatImportTargetList 1024))
(define macro-flat-import-target-cache-count : i64
  0)
(define macro-flat-import-target-cache-generation : i64
  -1)
(define macro-flat-import-target-cache-ready : bool
  false)

;; The mapping is program-derived, so the cache must not survive into the next
;; program of a multi-program process (smoke batteries, REPL, LSP, package
;; builds). macro-expand-program and the REPL typecheck entry reset it at the
;; same per-program boundary that resets the CTFE-env and clone-able caches;
;; the intern generation gate additionally covers intern-reset! boundaries.
(define (macro-alias-derived-cache-reset!) : unit
  (begin
    (set! macro-alias-cache-ready false)
    (set! macro-unqualified-import-cache-ready false)
    (set! macro-flat-import-target-cache-ready false)
    (macro-surface-call-decl-cache-reset!)
    (macro-generated-fingerprint-cache-reset!)
    (tc-source-dotted-alias-key-cache-reset!)
    (tc-source-dotted-full-path-key-cache-reset!)
    (tc-source-qualified-variant-key-cache-reset!)
    (tc-imported-module-identity-cache-reset!)))

(define (macro-alias-cache-reset!) : unit
  (begin
    (macro-alias-derived-cache-reset!)
    (tc-lazy-import-stubs-reset!)))

(define (macro-unqualified-import-cache-ensure!) : unit
  (if (if macro-unqualified-import-cache-ready
    (= macro-unqualified-import-cache-generation (intern-generation))
    false)
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i macro-unqualified-import-cache-capacity)
          (begin
            (array-set! macro-unqualified-import-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set! macro-unqualified-import-cache-count 0)
        (set! macro-unqualified-import-cache-generation (intern-generation))
        (set! macro-unqualified-import-cache-ready true)))))

(define (macro-unqualified-import-cache-bucket
  [module-id : i64]
  [name-id : i64]) : i64
  (bit-and
    (+ (* module-id 2654435761) (* name-id 40503))
    (- macro-unqualified-import-cache-capacity 1)))

;; Returns the cached target module id, -1 for "no imported macro", or -2 when
;; absent.
(define (macro-unqualified-import-cache-get [module-id : i64] [name-id : i64]) : i64
  (let
    [cursor : i64 (macro-unqualified-import-cache-bucket module-id name-id)]
    [module-key : i64 (+ module-id 1)]
    [name-key : i64 (+ name-id 1)]
    [steps : i64 0]
    [out : i64 -2]
    [done : bool false]
    (begin
      (while (if done
        false
        (< steps macro-unqualified-import-cache-capacity))
        (let
          [slot : i64
            (array-ref macro-unqualified-import-cache-module-keys cursor)]
          (if (= slot 0)
            (set! done true)
            (if (and
              (= slot module-key)
              (=
                (array-ref macro-unqualified-import-cache-name-keys cursor)
                name-key))
              (begin
                (set!
                  out
                  (array-ref macro-unqualified-import-cache-values cursor))
                (set! done true))
              (begin
                (set!
                  cursor
                  (bit-and
                    (+ cursor 1)
                    (- macro-unqualified-import-cache-capacity 1)))
                (set! steps (+ steps 1)))))))
      out)))

(define (macro-unqualified-import-cache-put!
  [module-id : i64]
  [name-id : i64]
  [value : i64]) : unit
  (if (>=
    (* macro-unqualified-import-cache-count 2)
    macro-unqualified-import-cache-capacity)
    unit
    (let
      [cursor : i64 (macro-unqualified-import-cache-bucket module-id name-id)]
      [module-key : i64 (+ module-id 1)]
      [name-key : i64 (+ name-id 1)]
      [steps : i64 0]
      [done : bool false]
      (begin
        (while (if done
          false
          (< steps macro-unqualified-import-cache-capacity))
          (let
            [slot : i64
              (array-ref macro-unqualified-import-cache-module-keys cursor)]
            (if (= slot 0)
              (begin
                (array-set!
                  macro-unqualified-import-cache-module-keys
                  cursor
                  module-key)
                (array-set!
                  macro-unqualified-import-cache-name-keys
                  cursor
                  name-key)
                (array-set! macro-unqualified-import-cache-values cursor value)
                (set!
                  macro-unqualified-import-cache-count
                  (+ macro-unqualified-import-cache-count 1))
                (set! done true))
              (if (and
                (= slot module-key)
                (=
                  (array-ref macro-unqualified-import-cache-name-keys cursor)
                  name-key))
                (set! done true)
                (begin
                  (set!
                    cursor
                    (bit-and
                      (+ cursor 1)
                      (- macro-unqualified-import-cache-capacity 1)))
                  (set! steps (+ steps 1)))))))
        unit))))

(define (macro-flat-import-target-cache-ensure!) : unit
  (if (if macro-flat-import-target-cache-ready
    (= macro-flat-import-target-cache-generation (intern-generation))
    false)
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i macro-flat-import-target-cache-capacity)
          (begin
            (array-set! macro-flat-import-target-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set! macro-flat-import-target-cache-count 0)
        (set! macro-flat-import-target-cache-generation (intern-generation))
        (set! macro-flat-import-target-cache-ready true)))))

(define (macro-flat-import-target-cache-bucket [module-id : i64]) : i64
  (bit-and
    (* module-id 2654435761)
    (- macro-flat-import-target-cache-capacity 1)))

(define (macro-flat-import-target-cache-get [module-id : i64]) : MacroFlatImportTargetCacheLookup
  (let
    [cursor : i64 (macro-flat-import-target-cache-bucket module-id)]
    [module-key : i64 (+ module-id 1)]
    [steps : i64 0]
    [out : MacroFlatImportTargetCacheLookup
      (MacroFlatImportTargetCacheLookup.Missing)]
    [done : bool false]
    (begin
      (while (if done
        false
        (< steps macro-flat-import-target-cache-capacity))
        (let
          [slot : i64
            (array-ref macro-flat-import-target-cache-module-keys cursor)]
          (if (= slot 0)
            (set! done true)
            (if (= slot module-key)
              (begin
                (set!
                  out
                  (MacroFlatImportTargetCacheLookup.Hit
                    (array-ref macro-flat-import-target-cache-values cursor)))
                (set! done true))
              (begin
                (set!
                  cursor
                  (bit-and
                    (+ cursor 1)
                    (- macro-flat-import-target-cache-capacity 1)))
                (set! steps (+ steps 1)))))))
      out)))

(define (macro-flat-import-target-cache-put!
  [module-id : i64]
  [targets : MacroFlatImportTargetList]) : unit
  (if (>=
    (* macro-flat-import-target-cache-count 2)
    macro-flat-import-target-cache-capacity)
    unit
    (let
      [cursor : i64 (macro-flat-import-target-cache-bucket module-id)]
      [module-key : i64 (+ module-id 1)]
      [steps : i64 0]
      [done : bool false]
      (begin
        (while (if done
          false
          (< steps macro-flat-import-target-cache-capacity))
          (let
            [slot : i64
              (array-ref macro-flat-import-target-cache-module-keys cursor)]
            (if (= slot 0)
              (begin
                (array-set!
                  macro-flat-import-target-cache-module-keys
                  cursor
                  module-key)
                (array-set!
                  macro-flat-import-target-cache-values
                  cursor
                  targets)
                (set!
                  macro-flat-import-target-cache-count
                  (+ macro-flat-import-target-cache-count 1))
                (set! done true))
              (if (= slot module-key)
                (set! done true)
                (begin
                  (set!
                    cursor
                    (bit-and
                      (+ cursor 1)
                      (- macro-flat-import-target-cache-capacity 1)))
                  (set! steps (+ steps 1)))))))
        unit))))

(define (macro-flat-import-target-list-contains?
  [targets : MacroFlatImportTargetList]
  [target-id : i64]) : bool
  (match targets
    [(MacroFlatImportTargetList.Nil) false]
    [(MacroFlatImportTargetList.Cons target rest)
      (if (= target target-id)
        true
        (macro-flat-import-target-list-contains? (box-get rest) target-id))]))

(define (macro-flat-import-target-list-add
  [targets : MacroFlatImportTargetList]
  [target-id : i64]) : MacroFlatImportTargetList
  (if (macro-flat-import-target-list-contains? targets target-id)
    targets
    (MacroFlatImportTargetList.Cons target-id (box targets))))

(define (macro-flat-import-target-list-reverse-into
  [targets : MacroFlatImportTargetList]
  [out : MacroFlatImportTargetList]) : MacroFlatImportTargetList
  (match targets
    [(MacroFlatImportTargetList.Nil) out]
    [(MacroFlatImportTargetList.Cons target rest)
      (macro-flat-import-target-list-reverse-into
        (box-get rest)
        (MacroFlatImportTargetList.Cons target (box out)))]))

(define (macro-flat-import-target-list-reverse
  [targets : MacroFlatImportTargetList]) : MacroFlatImportTargetList
  (macro-flat-import-target-list-reverse-into
    targets
    (MacroFlatImportTargetList.Nil)))

(define (macro-flat-import-targets-from-list
  [decls : AstDeclList]
  [current-module-id : i64]
  [module-id : i64]
  [targets : MacroFlatImportTargetList]) : MacroFlatImportTargetList
  (let
    [index : i64 0]
    [count : i64 (ast-decl-list-len (& decls))]
    [decl-offset : i64 (struct-get decls offset)]
    [cur-module-id : i64 module-id]
    [cur-targets : MacroFlatImportTargetList targets]
    (begin
      (while (< index count)
        (let
          [decl : AstDecl
            (array-ref (struct-get decls slots) (+ decl-offset index))]
          (begin
            (match (ast-decl-unwrapped decl)
              [(AstDecl.Module next-module) (set! cur-module-id next-module)]
              [(AstDecl.Import (AstImportSpec.Spec _ _ expected maybe-alias _))
                (match maybe-alias
                  [(AstMaybeImportAlias.Some alias)
                    (if (and
                      (= cur-module-id current-module-id)
                      (string.eq alias ""))
                      (match expected
                        [(AstMaybeModuleName.Some target-module)
                          (let
                            [target-id : i64 (intern target-module)]
                            (if (= target-id current-module-id)
                              unit
                              (set!
                                cur-targets
                                (macro-flat-import-target-list-add
                                  cur-targets
                                  target-id))))]
                        [(AstMaybeModuleName.No) unit])
                      unit)]
                  [(AstMaybeImportAlias.No) unit])]
              [_ unit])
            (set! index (+ index 1)))))
      (macro-flat-import-target-list-reverse cur-targets))))

(define (macro-flat-import-targets
  [decls : AstDeclList]
  [current-module-id : i64]) : MacroFlatImportTargetList
  (begin
    (macro-flat-import-target-cache-ensure!)
    (match (macro-flat-import-target-cache-get current-module-id)
      [(MacroFlatImportTargetCacheLookup.Hit targets) targets]
      [(MacroFlatImportTargetCacheLookup.Missing)
        (let
          [targets : MacroFlatImportTargetList
            (macro-flat-import-targets-from-list
              decls
              current-module-id
              (intern "")
              (MacroFlatImportTargetList.Nil))]
          (begin
            (macro-flat-import-target-cache-put! current-module-id targets)
            targets))])))

(define (macro-alias-cache-ensure!) : unit
  (if (if macro-alias-cache-ready
    (= macro-alias-cache-generation (intern-generation))
    false)
    unit
    (let
      [i : i64 0]
      (begin
        (while (< i macro-alias-cache-capacity)
          (begin
            (array-set! macro-alias-cache-module-keys i 0)
            (set! i (+ i 1))))
        (set! macro-alias-cache-count 0)
        (set! macro-alias-cache-generation (intern-generation))
        (set! macro-alias-cache-ready true)))))

(define (macro-alias-cache-bucket [module-id : i64] [qualifier-id : i64]) : i64
  (bit-and
    (+ (* module-id 2654435761) qualifier-id)
    (- macro-alias-cache-capacity 1)))

;; Returns the cached value for `(module-id, qualifier-id)`, or -2 when absent.
(define (macro-alias-cache-get [module-id : i64] [qualifier-id : i64]) : i64
  (let
    [cursor : i64 (macro-alias-cache-bucket module-id qualifier-id)]
    [module-key : i64 (+ module-id 1)]
    [qualifier-key : i64 (+ qualifier-id 1)]
    [steps : i64 0]
    [out : i64 -2]
    [done : bool false]
    (begin
      (while (if done
        false
        (< steps macro-alias-cache-capacity))
        (let
          [slot : i64 (array-ref macro-alias-cache-module-keys cursor)]
          (if (= slot 0)
            (set! done true)
            (if (and
              (= slot module-key)
              (=
                (array-ref macro-alias-cache-qualifier-keys cursor)
                qualifier-key))
              (begin
                (set! out (array-ref macro-alias-cache-values cursor))
                (set! done true))
              (begin
                (set!
                  cursor
                  (bit-and (+ cursor 1) (- macro-alias-cache-capacity 1)))
                (set! steps (+ steps 1)))))))
      out)))

(define (macro-alias-cache-put!
  [module-id : i64]
  [qualifier-id : i64]
  [value : i64]) : unit
  (if (>= (* macro-alias-cache-count 2) macro-alias-cache-capacity)
    unit
    (let
      [cursor : i64 (macro-alias-cache-bucket module-id qualifier-id)]
      [module-key : i64 (+ module-id 1)]
      [qualifier-key : i64 (+ qualifier-id 1)]
      [steps : i64 0]
      [done : bool false]
      (begin
        (while (if done
          false
          (< steps macro-alias-cache-capacity))
          (let
            [slot : i64 (array-ref macro-alias-cache-module-keys cursor)]
            (if (= slot 0)
              (begin
                (array-set! macro-alias-cache-module-keys cursor module-key)
                (array-set!
                  macro-alias-cache-qualifier-keys
                  cursor
                  qualifier-key)
                (array-set! macro-alias-cache-values cursor value)
                (set! macro-alias-cache-count (+ macro-alias-cache-count 1))
                (set! done true))
              (if (and
                (= slot module-key)
                (=
                  (array-ref macro-alias-cache-qualifier-keys cursor)
                  qualifier-key))
                (set! done true)
                (begin
                  (set!
                    cursor
                    (bit-and (+ cursor 1) (- macro-alias-cache-capacity 1)))
                  (set! steps (+ steps 1)))))))
        unit))))

(define (macro-import-alias-target-cached-id
  [decls : AstDeclList]
  [current-module-id : i64]
  [qualifier-id : i64]) : TcMaybeString
  (begin
    (macro-alias-cache-ensure!)
    (let
      [cached : i64 (macro-alias-cache-get current-module-id qualifier-id)]
      (if (= cached -2)
        (let
          [qualifier : String (intern-str qualifier-id)]
          (match (macro-import-alias-target-ids
            decls
            current-module-id
            qualifier
            (intern ""))
            [(TcMaybeString.Some target)
              (let
                [target-id : i64 (intern target)]
                (begin
                  (macro-alias-cache-put!
                    current-module-id
                    qualifier-id
                    target-id)
                  (TcMaybeString.Some target)))]
            [(TcMaybeString.No)
              (begin
                (macro-alias-cache-put! current-module-id qualifier-id -1)
                (TcMaybeString.No))]))
        (if (< cached 0)
          (TcMaybeString.No)
          (TcMaybeString.Some (intern-str cached)))))))

(define (macro-import-alias-target-cached
  [decls : AstDeclList]
  [current-module-id : i64]
  [qualifier : String]) : TcMaybeString
  (macro-import-alias-target-cached-id
    decls
    current-module-id
    (intern qualifier)))

(define (macro-resolve-qualified-module
  [decls : AstDeclList]
  [current-module : String]
  [qualifier : String]) : String
  (match (macro-import-alias-target-cached
    decls
    (intern current-module)
    qualifier)
    [(TcMaybeString.Some target) target]
    [(TcMaybeString.No) qualifier]))

(define (macro-missing-macro-message [name : String]) : String
  (string.append "typecheck: missing macro " name))

(define (macro-qualified-call-decl-in-module
  [ctx : TcContext]
  [_decls : AstDeclList]
  [target-module : String]
  [base : String]
  [name : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (let
    [macro-handle : i64
      (compiler-symbols-lookup-macro-in-module-id-or
        (tc-context-symbols ctx)
        (intern target-module)
        (intern base)
        (compiler-symbols-missing-handle))]
    ;; A macro that exists in the target module resolves directly from the
    ;; symbol table.
    (if (compiler-symbols-handle-found? macro-handle)
      (match (macro-decl-at-index-in-module
        (tc-context-symbols ctx)
        (compiler-symbol-handle-index macro-handle)
        target-module)
        [(MacroMaybeDecl.Some macro-name def-module params ret body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some macro-name def-module params ret body))]
        [(MacroMaybeDecl.No)
          (ResultMacroCallDecl.Err
            (box
              (ctfe-diagnostic-at-expr
                call-expr
                (macro-missing-macro-message name))))])
      (match (macro-surface-call-decl-in-module target-module base)
        [(MacroMaybeDecl.Some macro-name def-module params ret body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some macro-name def-module params ret body))]
        [(MacroMaybeDecl.No)
          (if (compiler-symbols-handle-found?
            (compiler-symbols-lookup-value-in-module-id-or
              (tc-context-symbols ctx)
              (intern target-module)
              (intern base)
              (compiler-symbols-missing-handle)))
            (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))
            (ResultMacroCallDecl.Err
              (box
                (ctfe-diagnostic-at-expr
                  call-expr
                  (macro-missing-macro-message name)))))]))))

(define (macro-qualified-call-decl
  [ctx : TcContext]
  [decls : AstDeclList]
  [name : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (let
    [qualifier : String (tc-qualified-name-module name)]
    [base : String (tc-qualified-name-base name)]
    [target-module : String
      (macro-resolve-qualified-module decls (tc-context-module ctx) qualifier)]
    (macro-qualified-call-decl-in-module
      ctx
      decls
      target-module
      base
      name
      call-expr)))

;; The implicit core macro prelude module (stdlib/core_macros.tl). A bare name
;; that is not bound as a macro in the current module falls back to this module's
;; available macros, so `and`/`or`/`when`/`unless`/`cond` resolve without an
;; explicit import (#2060). Local macros and explicit imports therefore take
;; precedence over the prelude. Returns MacroMaybeDecl.No (an ordinary call, not an
;; error) when the name is not a prelude macro, leaving plain calls unaffected.
(define (macro-prelude-resolve-module
  [symbols : CompilerSymbols]
  [module-name : String]
  [lookup-name : String]) : ResultMacroCallDecl
  ;; The implicit core_macros prelude resolves its macros straight from the
  ;; module's symbol table. core_macros declares exactly the prelude macros, so
  ;; this resolves the same set (`and`, `or`, `when`, `unless`, `cond`).
  (let
    [handle : i64
      (compiler-symbols-lookup-macro-in-module-id-or
        symbols
        (intern module-name)
        (intern lookup-name)
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (match (macro-decl-at-index-in-module
        symbols
        (compiler-symbol-handle-index handle)
        module-name)
        [(MacroMaybeDecl.Some macro-name def-module params ret body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some macro-name def-module params ret body))]
        [(MacroMaybeDecl.No) (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))])
      (ResultMacroCallDecl.Ok (MacroMaybeDecl.No)))))

(define (macro-prelude-resolve
  [symbols : CompilerSymbols]
  [lookup-name : String]) : ResultMacroCallDecl
  (match (macro-prelude-resolve-module symbols "stdlib.core_macros" lookup-name)
    [(ResultMacroCallDecl.Ok maybe-decl)
      (match maybe-decl
        [(MacroMaybeDecl.No)
          ;; Compatibility fallback for sources loaded with the old module
          ;; identity before the core_macros spelling migration.
          (macro-prelude-resolve-module
            symbols
            "stdlib.core-macros"
            lookup-name)]
        [_ (ResultMacroCallDecl.Ok maybe-decl)])]
    [(ResultMacroCallDecl.Err diag) (ResultMacroCallDecl.Err diag)]))

(define (macro-prelude-call-decl
  [ctx : TcContext]
  [_decls : AstDeclList]
  [lookup-name : String]
  [_call-expr : AstExpr]) : ResultMacroCallDecl
  (macro-prelude-resolve (tc-context-symbols ctx) lookup-name))

(define (macro-unqualified-imported-target-call-decl
  [ctx : TcContext]
  [target-module : String]
  [lookup-name : String]
  [_call-expr : AstExpr]) : ResultMacroCallDecl
  (let
    [handle : i64
      (compiler-symbols-lookup-macro-in-module-id-or
        (tc-context-symbols ctx)
        (intern target-module)
        (intern lookup-name)
        (compiler-symbols-missing-handle))]
    ;; Resolve an imported macro that exists in the target module directly from
    ;; the symbol table.
    (if (compiler-symbols-handle-found? handle)
      (match (macro-decl-at-index-in-module
        (tc-context-symbols ctx)
        (compiler-symbol-handle-index handle)
        target-module)
        [(MacroMaybeDecl.Some macro-name def-module params ret body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some macro-name def-module params ret body))]
        [(MacroMaybeDecl.No) (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))])
      (match (macro-surface-call-decl-in-module target-module lookup-name)
        [(MacroMaybeDecl.Some macro-name def-module params ret body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some macro-name def-module params ret body))]
        [(MacroMaybeDecl.No) (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))]))))

(define (macro-unqualified-imported-call-target
  [ctx : TcContext]
  [target-module-id : i64]
  [lookup-name-id : i64]) : i64
  ;; Any macro present in the target module is a resolution candidate.
  (if (compiler-symbols-handle-found?
    (compiler-symbols-lookup-macro-in-module-id-or
      (tc-context-symbols ctx)
      target-module-id
      lookup-name-id
      (compiler-symbols-missing-handle)))
    target-module-id
    (if (macro-surface-macro-in-module?
      (intern-str target-module-id)
      (intern-str lookup-name-id))
      target-module-id
      -1)))

(define (macro-unqualified-imported-call-target-from-imports
  [ctx : TcContext]
  [targets : MacroFlatImportTargetList]
  [lookup-name-id : i64]) : i64
  (match targets
    [(MacroFlatImportTargetList.Nil) -1]
    [(MacroFlatImportTargetList.Cons target-module-id rest-box)
      (let
        [target : i64
          (macro-unqualified-imported-call-target
            ctx
            target-module-id
            lookup-name-id)]
        (if (= target -1)
          (macro-unqualified-imported-call-target-from-imports
            ctx
            (box-get rest-box)
            lookup-name-id)
          target))]))

(define (macro-unqualified-imported-call-decl-from-target
  [ctx : TcContext]
  [target : i64]
  [lookup-name : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (if (>= target 0)
    (macro-unqualified-imported-target-call-decl
      ctx
      (intern-str target)
      lookup-name
      call-expr)
    (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))))

(define (macro-unqualified-imported-call-decl-cached
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]
  [lookup-name : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (let
    [module-id : i64 (intern module)]
    [lookup-name-id : i64 (intern lookup-name)]
    (begin
      (macro-unqualified-import-cache-ensure!)
      (let
        [cached : i64
          (macro-unqualified-import-cache-get module-id lookup-name-id)]
        [target : i64
          (if (= cached -2)
            (let
              [resolved : i64
                (macro-unqualified-imported-call-target-from-imports
                  ctx
                  (macro-flat-import-targets decls module-id)
                  lookup-name-id)]
              (begin
                (macro-unqualified-import-cache-put!
                  module-id
                  lookup-name-id
                  resolved)
                resolved))
            cached)]
        (macro-unqualified-imported-call-decl-from-target
          ctx
          target
          lookup-name
          call-expr)))))

(define (macro-unqualified-imported-call-decl
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]
  [lookup-name : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (macro-unqualified-imported-call-decl-cached
    ctx
    decls
    module
    lookup-name
    call-expr))

(define (macro-alias-self-call-decl
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]
  [lookup-name : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  ;; `(import stdlib.vector)` binds alias `vector`; module-scope `(vector T)`
  ;; should resolve to macro `vector` in that aliased module.
  (match (macro-import-alias-target-cached decls (intern module) lookup-name)
    [(TcMaybeString.Some target-module)
      (macro-unqualified-imported-target-call-decl
        ctx
        target-module
        lookup-name
        call-expr)]
    [(TcMaybeString.No) (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))]))

(define (macro-unqualified-call-decl-in-module
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]
  [lookup-name : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (let
    [handle : i64
      (compiler-symbols-lookup-macro-in-module-id-or
        (tc-context-symbols ctx)
        (intern module)
        (intern lookup-name)
        (compiler-symbols-missing-handle))]
    (if (compiler-symbols-handle-found? handle)
      (match (macro-decl-at-index-with-owner-module
        (tc-context-symbols ctx)
        (compiler-symbol-handle-index handle)
        module)
        [(MacroMaybeDecl.Some macro-name def-module params ret body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some macro-name def-module params ret body))]
        [(MacroMaybeDecl.No) (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))])
      (match (macro-surface-call-decl-in-module module lookup-name)
        [(MacroMaybeDecl.Some macro-name def-module params ret body)
          (ResultMacroCallDecl.Ok
            (MacroMaybeDecl.Some macro-name def-module params ret body))]
        [(MacroMaybeDecl.No)
          (match (macro-unqualified-imported-call-decl
            ctx
            decls
            module
            lookup-name
            call-expr)
            [(ResultMacroCallDecl.Ok imported-decl)
              (match imported-decl
                [(MacroMaybeDecl.No)
                  (macro-prelude-call-decl
                    (tc-context-with-module ctx module)
                    decls
                    lookup-name
                    call-expr)]
                [_ (ResultMacroCallDecl.Ok imported-decl)])]
            [(ResultMacroCallDecl.Err diag) (ResultMacroCallDecl.Err diag)])]))))

(define (macro-call-decl-from-name
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]
  [lookup-name : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (if (or
    (tc-name-qualified? lookup-name)
    (tc-source-slash-qualified? lookup-name))
    (macro-qualified-call-decl
      (tc-context-with-module ctx module)
      decls
      lookup-name
      call-expr)
    (macro-unqualified-call-decl-in-module
      ctx
      decls
      module
      lookup-name
      call-expr)))

(define (macro-call-decl-from-source-name
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]
  [lookup-name : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (if (tc-source-legacy-core-macro-compat? lookup-name)
    (macro-call-decl-from-name ctx decls module lookup-name call-expr)
    (let
      [source-ctx : TcContext
        (tc-context-with-program
          (tc-context-with-module ctx module)
          (ast-program decls))]
      (match (tc-source-type-name-lookup-key source-ctx lookup-name)
        [(ResultTcString.Ok resolved-name)
          (macro-call-decl-from-name ctx decls module resolved-name call-expr)]
        [(ResultTcString.Err message)
          (ResultMacroCallDecl.Err
            (box (ctfe-diagnostic-at-expr call-expr message)))]))))

(define (macro-call-decl-from-hygiene-name
  [ctx : TcContext]
  [decls : AstDeclList]
  [definition-module : String]
  [lookup-name : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (if (and
    (>= (tc-name-first-dot lookup-name) 0)
    (not (tc-name-qualified? lookup-name))
    (not (tc-source-slash-qualified? lookup-name)))
    (macro-call-decl-from-source-name
      ctx
      decls
      definition-module
      lookup-name
      call-expr)
    (macro-call-decl-from-name
      ctx
      decls
      definition-module
      lookup-name
      call-expr)))

;; If `func` names a visible macro, return that macro's decl. Bare local macros
;; are module-scope visible regardless of source order; qualified macro calls
;; must pass the export table. A bare name not bound locally falls back to the
;; implicit core macro prelude.
(define (macro-call-decl
  [ctx : TcContext]
  [func : AstExpr]
  [decls : AstDeclList]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (match func
    [(AstExpr.Spanned inner-box _)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (macro-call-decl ctx inner decls call-expr))]
    [(AstExpr.Var name)
      (if (tc-hygiene-global-name? (intern-str name))
        (match (tc-hygiene-global-decode (intern-str name))
          [(TcHygieneGlobalName.Legacy lookup-name)
            (macro-call-decl-from-hygiene-name
              ctx
              decls
              (tc-context-module ctx)
              lookup-name
              call-expr)]
          [(TcHygieneGlobalName.Context module lookup-name)
            (macro-call-decl-from-hygiene-name
              ctx
              decls
              module
              lookup-name
              call-expr)])
        (macro-call-decl-from-source-name
          ctx
          decls
          (tc-context-module ctx)
          (intern-str name)
          call-expr))]
    [_ (ResultMacroCallDecl.Ok (MacroMaybeDecl.No))]))

(define (macro-call-decl-with-self-alias
  [ctx : TcContext]
  [func : AstExpr]
  [decls : AstDeclList]
  [module : String]
  [call-expr : AstExpr]) : ResultMacroCallDecl
  (match (macro-call-decl
    (tc-context-with-module ctx module)
    func
    decls
    call-expr)
    [(ResultMacroCallDecl.Ok maybe-decl)
      (match maybe-decl
        [(MacroMaybeDecl.No)
          (match (ast-expr-unspan func)
            [(AstExpr.Var name)
              (let
                [lookup-name : String (intern-str name)]
                (if (or
                  (tc-hygiene-global-name? lookup-name)
                  (tc-name-qualified? lookup-name)
                  (>= (tc-name-first-dot lookup-name) 0))
                  (ResultMacroCallDecl.Ok maybe-decl)
                  (macro-alias-self-call-decl
                    ctx
                    decls
                    module
                    lookup-name
                    call-expr)))]
            [_ (ResultMacroCallDecl.Ok maybe-decl)])]
        [_ (ResultMacroCallDecl.Ok maybe-decl)])]
    [(ResultMacroCallDecl.Err diag) (ResultMacroCallDecl.Err diag)]))

(define (macro-call-decl-with-context
  [ctx : TcContext]
  [func : AstExpr]
  [decls : AstDeclList]
  [module : String]
  [context : AstMaybeModuleName]
  [call-expr : AstExpr]) : ResultMacroCallDeclModule
  (match (macro-call-decl-with-self-alias ctx func decls module call-expr)
    [(ResultMacroCallDecl.Ok maybe-decl)
      (match maybe-decl
        [(MacroMaybeDecl.No)
          (match context
            [(AstMaybeModuleName.Some context-module)
              (if (string.eq context-module module)
                (ResultMacroCallDeclModule.Ok maybe-decl module)
                (match (macro-call-decl-with-self-alias
                  ctx
                  func
                  decls
                  context-module
                  call-expr)
                  [(ResultMacroCallDecl.Ok context-decl)
                    (match context-decl
                      [(MacroMaybeDecl.No)
                        (ResultMacroCallDeclModule.Ok maybe-decl module)]
                      [_
                        (ResultMacroCallDeclModule.Ok
                          context-decl
                          context-module)])]
                  [(ResultMacroCallDecl.Err diag)
                    (ResultMacroCallDeclModule.Err diag)]))]
            [(AstMaybeModuleName.No)
              (ResultMacroCallDeclModule.Ok maybe-decl module)])]
        [_ (ResultMacroCallDeclModule.Ok maybe-decl module)])]
    [(ResultMacroCallDecl.Err primary-diag)
      (match context
        [(AstMaybeModuleName.Some context-module)
          (if (string.eq context-module module)
            (ResultMacroCallDeclModule.Err primary-diag)
            (match (macro-call-decl-with-self-alias
              ctx
              func
              decls
              context-module
              call-expr)
              [(ResultMacroCallDecl.Ok context-decl)
                (match context-decl
                  [(MacroMaybeDecl.No)
                    (ResultMacroCallDeclModule.Err primary-diag)]
                  [_ (ResultMacroCallDeclModule.Ok context-decl context-module)])]
              [(ResultMacroCallDecl.Err _)
                (ResultMacroCallDeclModule.Err primary-diag)]))]
        [(AstMaybeModuleName.No) (ResultMacroCallDeclModule.Err primary-diag)])]))

(define (macro-operand-mismatch-message [expected : AstType] [actual : AstType]) : String
  (str_cat.str-cat
    "typecheck: macro operand type mismatch: expected "
    (tc-type-render expected)
    ", got "
    (tc-type-render actual)))

(define (macro-clause-shape-message) : String
  "typecheck: ExprClause macro operand expects bracket clause [expr expr]")

(define (macro-binding-clause-shape-message) : String
  "typecheck: ExprBindingClause macro operand expects bracket clause [name expr] or [name : Type expr]")

(define (macro-clause-operand-mismatch-message [expected : AstType]) : String
  (str_cat.str-cat
    "typecheck: macro operand type mismatch: expected "
    (tc-type-render expected)
    ", got bracket clause"))

(define (macro-type-arg-module-qualify-name [ctx : TcContext] [name : i64]) : String
  (let
    [name-str : String (intern-str name)]
    [module : String (tc-context-module ctx)]
    (if (and
      (> (string.string-length module) 0)
      (not (tc-name-qualified? name-str))
      (not (tc-source-slash-qualified? name-str)))
      (str_cat.str-cat (tc-name-slashes-to-dots module) "." name-str)
      name-str)))

(define (macro-type-arg-module-qualify-list
  [ctx : TcContext]
  [types : AstTypeList]) : AstTypeList
  (macro-type-arg-module-qualify-list-at ctx (& types) 0))

(define (macro-type-arg-module-qualify-list-at
  [ctx : TcContext]
  [types : (& types AstTypeList)]
  [index : i64]) : AstTypeList
  (if (>= index (ast-type-list-len types))
    (ast-type-list-new)
    (ast-type-cons
      (macro-type-arg-module-qualify
        ctx
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback))))
      (macro-type-arg-module-qualify-list-at ctx types (+ index 1)))))

(define (macro-type-arg-module-qualify [ctx : TcContext] [ty : AstType]) : AstType
  (match ty
    [(AstType.Func args ret)
      (ast-ty-func
        (macro-type-arg-module-qualify-list ctx (box-get args))
        (macro-type-arg-module-qualify ctx (ty-node-get ret)))]
    [(AstType.Tuple elems)
      (ast-ty-tuple (macro-type-arg-module-qualify-list ctx (box-get elems)))]
    [(AstType.Array elem len)
      (ast-ty-array (macro-type-arg-module-qualify ctx (ty-node-get elem)) len)]
    [(AstType.DynArray elem)
      (ast-ty-dyn-array (macro-type-arg-module-qualify ctx (ty-node-get elem)))]
    [(AstType.Box elem)
      (ast-ty-box (macro-type-arg-module-qualify ctx (ty-node-get elem)))]
    [(AstType.Ptr elem)
      (ast-ty-ptr (macro-type-arg-module-qualify ctx (ty-node-get elem)))]
    [(AstType.MutPtr elem)
      (ast-ty-mut-ptr (macro-type-arg-module-qualify ctx (ty-node-get elem)))]
    [(AstType.Ref region inner)
      (ast-ty-ref
        region
        (macro-type-arg-module-qualify ctx (ty-node-get inner)))]
    [(AstType.MutRef region inner)
      (ast-ty-mut-ref
        region
        (macro-type-arg-module-qualify ctx (ty-node-get inner)))]
    [(AstType.Region region inner)
      (ast-ty-region
        region
        (macro-type-arg-module-qualify ctx (ty-node-get inner)))]
    [(AstType.Var name)
      (AstType.Var (intern (macro-type-arg-module-qualify-name ctx name)))]
    [(AstType.VarArgs name lifetimes)
      (ast-ty-var-args
        (intern (macro-type-arg-module-qualify-name ctx name))
        (box-get lifetimes))]
    [_ ty]))

(define (macro-type-arg-reflections-from-decls [decls : AstDeclList]) : CtfeReflectInfoList
  (begin
    (ctfe-build-seen-reset!)
    (ctfe-reflections-from-decls
      decls
      ""
      (ctfe-reflect-info-list-with-capacity (ctfe-metadata-decl-capacity decls)))))

(define (macro-type-arg-reflect-resolve
  [ctx : TcContext]
  [decls : AstDeclList]
  [ty : AstType]) : AstType
  (let
    [infos : CtfeReflectInfoList (macro-type-arg-reflections-from-decls decls)]
    [reflected : AstType
      (ctfe-reflect-resolve-type-with-pools (tc-context-pools ctx) infos ty)]
    (if (tc-type-needs-resolution? reflected)
      (let
        [qualified-reflected : AstType
          (ctfe-reflect-resolve-type-with-pools
            (tc-context-pools ctx)
            infos
            (macro-type-arg-module-qualify ctx reflected))]
        (if (tc-type-needs-resolution? qualified-reflected)
          reflected
          qualified-reflected))
      reflected)))

(define (macro-type-arg-resolve
  [ctx : TcContext]
  [decls : AstDeclList]
  [ty : AstType]) : AstType
  (let
    [resolved : AstType (tc-resolve-type ctx ty)]
    (if (tc-type-needs-resolution? resolved)
      (let
        [reflected : AstType
          (macro-type-arg-reflect-resolve ctx decls resolved)]
        (if (tc-type-needs-resolution? reflected)
          (macro-type-arg-module-qualify ctx reflected)
          reflected))
      resolved)))

(define (macro-type-arg [ctx : TcContext] [decls : AstDeclList] [arg : AstExpr]) : ResultMacroTypeArg
  (begin
    (tc-context-capture-active-pools! ctx)
    (match (ctfe-expr-to-type
      arg
      arg
      (ctfe-env-empty-with-pools (tc-context-pools ctx))
      (ctfe-fuel-limit))
      [(ResultCtfeQuoteType.Ok ty _)
        (match (tc-source-type-policy-ok ctx ty)
          [(ResultTcUnit.Ok)
            (ResultMacroTypeArg.Ok (macro-type-arg-resolve ctx decls ty))]
          [(ResultTcUnit.Err message)
            (ResultMacroTypeArg.Err (box (ctfe-diagnostic-at-expr arg message)))])]
      [(ResultCtfeQuoteType.Err diag) (ResultMacroTypeArg.Err diag)])))

(define (macro-type-arg-with-fallback
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [arg : AstExpr]) : ResultMacroTypeArg
  (match (macro-type-arg ctx decls arg)
    [(ResultMacroTypeArg.Ok resolved-ty) (ResultMacroTypeArg.Ok resolved-ty)]
    [(ResultMacroTypeArg.Err primary-diag)
      (if (string.eq fallback-module (tc-context-module ctx))
        (ResultMacroTypeArg.Err primary-diag)
        (match (macro-type-arg
          (tc-context-with-module ctx fallback-module)
          decls
          arg)
          [(ResultMacroTypeArg.Ok resolved-ty)
            (ResultMacroTypeArg.Ok resolved-ty)]
          [(ResultMacroTypeArg.Err _) (ResultMacroTypeArg.Err primary-diag)]))]))

(define (macro-module-strategy-unknown-message [name : String]) : String
  (str_cat.str-cat
    "typecheck: unknown module strategy "
    name
    "; import the module or use a visible dotted module alias"))

(define (macro-module-strategy-arg [ctx : TcContext] [arg : AstExpr]) : ResultMacroModuleArg
  (match (ast-expr-unspan arg)
    [(AstExpr.Var name-id)
      (let
        [name : String (intern-str name-id)]
        (if (tc-source-slash-qualified-id? name name-id)
          (ResultMacroModuleArg.Err
            (box
              (ctfe-diagnostic-at-expr
                arg
                (tc-source-slash-qualified-message name))))
          (match ctx
            [(TcContext program _ _ current-module _)
              (match program
                [(AstProgram.Program decls-box)
                  (match (macro-import-alias-target-cached
                    (box-get decls-box)
                    (intern current-module)
                    name)
                    [(TcMaybeString.Some target)
                      (ResultMacroModuleArg.Ok target)]
                    [(TcMaybeString.No)
                      (if (or
                        (string.eq name current-module)
                        (tc-imported-module-identity? ctx name))
                        (ResultMacroModuleArg.Ok name)
                        (ResultMacroModuleArg.Err
                          (box
                            (ctfe-diagnostic-at-expr
                              arg
                              (macro-module-strategy-unknown-message name)))))])])])))]
    [_
      (ResultMacroModuleArg.Err
        (box
          (ctfe-diagnostic-at-expr
            arg
            "typecheck: Module macro operand expects a module name")))]))

(define (macro-module-strategy-arg-with-fallback
  [ctx : TcContext]
  [fallback-module : String]
  [arg : AstExpr]) : ResultMacroModuleArg
  (match (macro-module-strategy-arg ctx arg)
    [(ResultMacroModuleArg.Ok module) (ResultMacroModuleArg.Ok module)]
    [(ResultMacroModuleArg.Err primary-diag)
      (if (string.eq fallback-module (tc-context-module ctx))
        (ResultMacroModuleArg.Err primary-diag)
        (match (macro-module-strategy-arg
          (tc-context-with-module ctx fallback-module)
          arg)
          [(ResultMacroModuleArg.Ok module) (ResultMacroModuleArg.Ok module)]
          [(ResultMacroModuleArg.Err _) (ResultMacroModuleArg.Err primary-diag)]))]))

(define (macro-expr-clause-from-items [arg : AstExpr] [items : AstExprList]) : ResultMacroClause
  (if (= (struct-get (& items) len) 2)
    (ResultMacroClause.Ok
      (ast-expr-clause
        (ast-expr-list-get (& items) 0 0)
        (ast-expr-list-get (& items) 1 0)))
    (ResultMacroClause.Err
      (box (ctfe-diagnostic-at-expr arg (macro-clause-shape-message))))))

(define (macro-expr-clause-from-arg [arg : AstExpr]) : ResultMacroClause
  (match (ast-expr-unspan arg)
    [(AstExpr.BracketClause items) (macro-expr-clause-from-items arg items)]
    [_
      (ResultMacroClause.Err
        (box
          (ctfe-diagnostic-at-expr
            arg
            "typecheck: ExprClause macro operand expects bracket syntax")))]))

(define (macro-expr-clause-list-from-args [args : AstExprList]) : ResultMacroClauseList
  (let
    [out : AstExprClauseList
      (ast-expr-clause-list-with-capacity (struct-get (& args) len))]
    (match (macro-expr-clause-list-from-args-into (& args) 0 (&mut out))
      [(ResultMacroCheck.Ok) (ResultMacroClauseList.Ok out)]
      [(ResultMacroCheck.Err diag) (ResultMacroClauseList.Err diag)])))

(define (macro-expr-clause-list-from-args-into
  [args : (& args AstExprList)]
  [index : i64]
  [out : (&mut out AstExprClauseList)]) : ResultMacroCheck
  (if (>= index (struct-get args len))
    ResultMacroCheck.Ok
    (let
      [head-expr : AstExpr (ast-node-get (ast-expr-list-get args index 0))]
      (match (macro-expr-clause-from-arg head-expr)
        [(ResultMacroClause.Ok clause)
          (begin
            (ast-expr-clause-list-push out clause)
            (macro-expr-clause-list-from-args-into args (+ index 1) out))]
        [(ResultMacroClause.Err diag) (ResultMacroCheck.Err diag)]))))

(define (macro-expr-span-or-zero [arg : AstExpr]) : AstSourceSpan
  (match arg
    [(AstExpr.Spanned _ span) span]
    [_ (AstSourceSpan 0 0 0 0)]))

(define (macro-expr-colon? [expr-id : i64]) : bool
  (match (ast-expr-unspan (ast-node-get expr-id))
    [(AstExpr.Var name) (= name (intern ":"))]
    [_ false]))

(define (macro-expr-binding-clause-shape-error [arg : AstExpr]) : ResultMacroBindingClause
  (ResultMacroBindingClause.Err
    (box (ctfe-diagnostic-at-expr arg (macro-binding-clause-shape-message)))))

(define (macro-expr-binding-clause-from-name
  [arg : AstExpr]
  [name : i64]
  [rest : AstExprList]) : ResultMacroBindingClause
  (let
    [len : i64 (struct-get (& rest) len)]
    (if (<= len 0)
      (macro-expr-binding-clause-shape-error arg)
      (let
        [first : i64 (ast-expr-list-get (& rest) 0 0)]
        (if (macro-expr-colon? first)
          (if (= len 3)
            (ResultMacroBindingClause.Ok
              (ast-expr-binding-clause-id
                name
                true
                (ast-expr-list-get (& rest) 1 0)
                (ast-expr-list-get (& rest) 2 0)
                (macro-expr-span-or-zero arg)))
            (macro-expr-binding-clause-shape-error arg))
          (if (= len 1)
            (ResultMacroBindingClause.Ok
              (ast-expr-binding-clause-id
                name
                false
                (ast-node-push (AstExpr.Literal (AstLiteral.Unit)))
                first
                (macro-expr-span-or-zero arg)))
            (macro-expr-binding-clause-shape-error arg)))))))

(define (macro-expr-binding-clause-from-items
  [arg : AstExpr]
  [items : AstExprList]) : ResultMacroBindingClause
  (if (ast-expr-list-empty? (& items))
    (macro-expr-binding-clause-shape-error arg)
    (let
      [name-expr : i64 (ast-expr-list-get (& items) 0 0)]
      (match (ast-expr-unspan (ast-node-get name-expr))
        [(AstExpr.Var name)
          (macro-expr-binding-clause-from-name
            arg
            name
            (ast-expr-list-tail-from-ref (& items) 1))]
        [_ (macro-expr-binding-clause-shape-error arg)]))))

(define (macro-expr-binding-clause-from-arg [arg : AstExpr]) : ResultMacroBindingClause
  (match (ast-expr-unspan arg)
    [(AstExpr.BracketClause items)
      (macro-expr-binding-clause-from-items arg items)]
    [_
      (ResultMacroBindingClause.Err
        (box
          (ctfe-diagnostic-at-expr
            arg
            "typecheck: ExprBindingClause macro operand expects bracket syntax")))]))

(define (macro-expr-binding-clause-list-from-args [args : AstExprList]) : ResultMacroBindingClauseList
  (let
    [out : AstExprBindingClauseList
      (ast-expr-binding-clause-list-with-capacity (struct-get (& args) len))]
    (match (macro-expr-binding-clause-list-from-args-into (& args) 0 (&mut out))
      [(ResultMacroCheck.Ok) (ResultMacroBindingClauseList.Ok out)]
      [(ResultMacroCheck.Err diag) (ResultMacroBindingClauseList.Err diag)])))

(define (macro-expr-binding-clause-list-from-args-into
  [args : (& args AstExprList)]
  [index : i64]
  [out : (&mut out AstExprBindingClauseList)]) : ResultMacroCheck
  (if (>= index (struct-get args len))
    ResultMacroCheck.Ok
    (let
      [head-expr : AstExpr (ast-node-get (ast-expr-list-get args index 0))]
      (match (macro-expr-binding-clause-from-arg head-expr)
        [(ResultMacroBindingClause.Ok clause)
          (begin
            (ast-expr-binding-clause-list-push out clause)
            (macro-expr-binding-clause-list-from-args-into args (+ index 1) out))]
        [(ResultMacroBindingClause.Err diag) (ResultMacroCheck.Err diag)]))))

(define (macro-signature-resolution-context
  [ctx : TcContext]
  [fallback-module : String]) : TcContext
  (if (> (string.string-length fallback-module) 0)
    (tc-context-with-module ctx fallback-module)
    ctx))

(define (macro-normalize-signature-syntax-type [ty : AstType]) : AstType
  (match ty
    [(AstType.Var name)
      (match (tc-stdlib-comptime-syntax-type (intern-str name))
        [(AstMaybeType.Some syntax-ty) syntax-ty]
        [(AstMaybeType.No) ty])]
    [_ ty]))

(define (macro-resolve-signature-type
  [ctx : TcContext]
  [fallback-module : String]
  [ty : AstType]) : AstType
  (macro-normalize-signature-syntax-type
    (tc-resolve-type
      (macro-signature-resolution-context ctx fallback-module)
      (tc-macro-signature-type ty))))

(define (macro-check-ordinary-operand
  [ctx : TcContext]
  [env : TcTypeEnv]
  [resolved-expected : AstType]
  [arg : AstExpr]) : ResultMacroCheck
  (if (tc-type-eq resolved-expected (AstType.Expr))
    ResultMacroCheck.Ok
    (match (tc-expr-with-expected-or-actual ctx env arg resolved-expected)
      [(ResultTcType.Ok actual)
        (if (tc-type-compatible? resolved-expected actual)
          ResultMacroCheck.Ok
          (ResultMacroCheck.Err
            (box
              (tc-expr-diag
                arg
                (macro-operand-mismatch-message resolved-expected actual)))))]
      [(ResultTcType.Err message)
        (ResultMacroCheck.Err
          (box
            (tc-expr-diag
              arg
              (string.append
                "typecheck: macro operand typecheck failed: "
                message))))])))

(define (macro-operand-bracket-clause? [arg : AstExpr]) : bool
  (match (ast-expr-unspan arg)
    [(AstExpr.BracketClause _) true]
    [_ false]))

(define (macro-check-operand
  [ctx : TcContext]
  [env : TcTypeEnv]
  [fallback-module : String]
  [expected : AstType]
  [arg : AstExpr]) : ResultMacroCheck
  (if (tc-macro-type-param-kind? expected)
    (match (macro-type-arg
      ctx
      (match (tc-context-program ctx)
        [(AstProgram.Program decls-box) (box-get decls-box)])
      arg)
      [(ResultMacroTypeArg.Ok _) ResultMacroCheck.Ok]
      [(ResultMacroTypeArg.Err diag) (ResultMacroCheck.Err diag)])
    (let
      [resolved-expected : AstType
        (macro-resolve-signature-type ctx fallback-module expected)]
      (cond
        [(tc-macro-expr-clause-type? resolved-expected)
          (match (macro-expr-clause-from-arg arg)
            [(ResultMacroClause.Ok _) ResultMacroCheck.Ok]
            [(ResultMacroClause.Err diag) (ResultMacroCheck.Err diag)])]
        [(tc-macro-expr-binding-clause-type? resolved-expected)
          (match (macro-expr-binding-clause-from-arg arg)
            [(ResultMacroBindingClause.Ok _) ResultMacroCheck.Ok]
            [(ResultMacroBindingClause.Err diag) (ResultMacroCheck.Err diag)])]
        [(macro-operand-bracket-clause? arg)
          (ResultMacroCheck.Err
            (box
              (ctfe-diagnostic-at-expr
                arg
                (macro-clause-operand-mismatch-message resolved-expected))))]
        [else (macro-check-ordinary-operand ctx env resolved-expected arg)]))))

(define (macro-check-variadic-operands
  [ctx : TcContext]
  [env : TcTypeEnv]
  [fallback-module : String]
  [expected : AstType]
  [args : AstExprList]) : ResultMacroCheck
  (macro-check-variadic-operands-at ctx env fallback-module expected (& args) 0))

(define (macro-check-variadic-operands-at
  [ctx : TcContext]
  [env : TcTypeEnv]
  [fallback-module : String]
  [expected : AstType]
  [args : (& args AstExprList)]
  [index : i64]) : ResultMacroCheck
  (if (>= index (struct-get args len))
    ResultMacroCheck.Ok
    (let
      [head : AstExpr (ast-node-get (ast-expr-list-get args index 0))]
      (match (macro-check-operand ctx env fallback-module expected head)
        [(ResultMacroCheck.Ok)
          (macro-check-variadic-operands-at
            ctx
            env
            fallback-module
            expected
            args
            (+ index 1))]
        [(ResultMacroCheck.Err diag) (ResultMacroCheck.Err diag)]))))

(define (macro-param-expr-clause?
  [ctx : TcContext]
  [fallback-module : String]
  [ty : AstType]) : bool
  (tc-macro-expr-clause-type?
    (macro-resolve-signature-type ctx fallback-module ty)))

(define (macro-param-expr-binding-clause?
  [ctx : TcContext]
  [fallback-module : String]
  [ty : AstType]) : bool
  (tc-macro-expr-binding-clause-type?
    (macro-resolve-signature-type ctx fallback-module ty)))

(define (macro-captured-expr-produced-type
  [ctx : TcContext]
  [env : TcTypeEnv]
  [resolved-expected : AstType]
  [capture-expr-types : bool]
  [arg : AstExpr]) : AstType
  (if (tc-type-eq resolved-expected (AstType.Expr))
    (if capture-expr-types
      (match (tc-expr ctx env arg)
        [(ResultTcType.Ok actual)
          (ctfe-captured-expr-type-with-pools
            (tc-context-pools ctx)
            (tc-resolve-type ctx actual))]
        [(ResultTcType.Err _) (ctfe-untyped-expr-type)])
      (ctfe-untyped-expr-type))
    resolved-expected))

(define (macro-bind-variadic-param
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [fallback-module : String]
  [name : i64]
  [ty : AstType]
  [args : AstExprList]
  [env : CtfeEnv]) : ResultMacroEnv
  (cond
    [(tc-macro-type-param-kind? ty)
      (ResultMacroEnv.Err
        (box
          (ctfe-diagnostic-at-expr
            (AstExpr.Var name)
            "typecheck: type macro operand cannot be variadic")))]
    [(tc-macro-module-param-kind? ty)
      (ResultMacroEnv.Err
        (box
          (ctfe-diagnostic-at-expr
            (AstExpr.Var name)
            "typecheck: Module macro operand cannot be variadic")))]
    [(macro-param-expr-clause? ctx fallback-module ty)
      (match (macro-expr-clause-list-from-args args)
        [(ResultMacroClauseList.Ok clauses)
          (ResultMacroEnv.Ok
            (ctfe-env-extend
              env
              (intern-str name)
              (CompilerCtfeValue.ExprClauseList clauses)))]
        [(ResultMacroClauseList.Err diag) (ResultMacroEnv.Err diag)])]
    [(macro-param-expr-binding-clause? ctx fallback-module ty)
      (match (macro-expr-binding-clause-list-from-args args)
        [(ResultMacroBindingClauseList.Ok clauses)
          (ResultMacroEnv.Ok
            (ctfe-env-extend
              env
              (intern-str name)
              (CompilerCtfeValue.ExprBindingClauseList clauses)))]
        [(ResultMacroBindingClauseList.Err diag) (ResultMacroEnv.Err diag)])]
    [else
      (match (macro-check-variadic-operands
        ctx
        type-env
        fallback-module
        ty
        args)
        [(ResultMacroCheck.Ok)
          (ResultMacroEnv.Ok
            (ctfe-env-extend
              env
              (intern-str name)
              (CompilerCtfeValue.ExprList args)))]
        [(ResultMacroCheck.Err diag) (ResultMacroEnv.Err diag)])]))

(define (macro-bind-fixed-param
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [type-env : TcTypeEnv]
  [name : i64]
  [ty : AstType]
  [arg-id : i64]
  [arg-expr : AstExpr]
  [capture-expr-types : bool]
  [env : CtfeEnv]) : ResultMacroEnv
  (cond
    [(tc-macro-type-param-kind? ty)
      (match (macro-type-arg-with-fallback ctx decls fallback-module arg-expr)
        [(ResultMacroTypeArg.Ok resolved-ty)
          (ResultMacroEnv.Ok
            (ctfe-env-extend
              env
              (intern-str name)
              (CompilerCtfeValue.Type resolved-ty)))]
        [(ResultMacroTypeArg.Err diag) (ResultMacroEnv.Err diag)])]
    [(tc-macro-module-param-kind? ty)
      (match (macro-module-strategy-arg-with-fallback
        ctx
        fallback-module
        arg-expr)
        [(ResultMacroModuleArg.Ok module)
          (ResultMacroEnv.Ok
            (ctfe-env-extend-typed
              env
              (intern-str name)
              (CompilerCtfeValue.String module)
              (AstType.String)))]
        [(ResultMacroModuleArg.Err diag) (ResultMacroEnv.Err diag)])]
    [(macro-param-expr-clause? ctx fallback-module ty)
      (match (macro-expr-clause-from-arg arg-expr)
        [(ResultMacroClause.Ok clause)
          (ResultMacroEnv.Ok
            (ctfe-env-extend
              env
              (intern-str name)
              (CompilerCtfeValue.ExprClause clause)))]
        [(ResultMacroClause.Err diag) (ResultMacroEnv.Err diag)])]
    [(macro-param-expr-binding-clause? ctx fallback-module ty)
      (match (macro-expr-binding-clause-from-arg arg-expr)
        [(ResultMacroBindingClause.Ok clause)
          (ResultMacroEnv.Ok
            (ctfe-env-extend
              env
              (intern-str name)
              (CompilerCtfeValue.ExprBindingClause clause)))]
        [(ResultMacroBindingClause.Err diag) (ResultMacroEnv.Err diag)])]
    [else
      (let
        [resolved-expected : AstType
          (macro-resolve-signature-type ctx fallback-module ty)]
        (match (macro-check-operand ctx type-env fallback-module ty arg-expr)
          [(ResultMacroCheck.Ok)
            (ResultMacroEnv.Ok
              (ctfe-env-extend
                env
                (intern-str name)
                (CompilerCtfeValue.Expr
                  arg-id
                  (macro-captured-expr-produced-type
                    ctx
                    type-env
                    resolved-expected
                    capture-expr-types
                    arg-expr))))]
          [(ResultMacroCheck.Err diag) (ResultMacroEnv.Err diag)]))]))

;; Bind the unevaluated operand forms to the macro parameters as `Expr` values.
;; A trailing variadic parameter collects the remaining operands as an ExprList.
(define (macro-bind-params
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [type-env : TcTypeEnv]
  [params : AstMacroParamList]
  [args : AstExprList]
  [env : CtfeEnv]
  [capture-expr-types : bool]
  [call-expr : AstExpr]) : ResultMacroEnv
  (macro-bind-params-at
    ctx
    decls
    fallback-module
    type-env
    (& params)
    (& args)
    0
    env
    capture-expr-types
    call-expr))

(define (macro-bind-params-at
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [type-env : TcTypeEnv]
  [params : (& params AstMacroParamList)]
  [args : (& args AstExprList)]
  [index : i64]
  [env : CtfeEnv]
  [capture-expr-types : bool]
  [call-expr : AstExpr]) : ResultMacroEnv
  (cond
    [(>= index (ast-macro-param-list-len params))
      (if (>= index (struct-get args len))
        (ResultMacroEnv.Ok env)
        (ResultMacroEnv.Err
          (box
            (ctfe-diagnostic-at-expr
              call-expr
              "macro call has too many arguments"))))]
    [else
      (match (ast-macro-param-list-get params index (ast-macro-param-fallback))
        [(AstMacroParam.Param pname pty variadic)
          (if variadic
            (macro-bind-variadic-param
              ctx
              type-env
              fallback-module
              pname
              pty
              (ast-expr-list-tail-from-ref args index)
              env)
            (if (>= index (struct-get args len))
              (ResultMacroEnv.Err
                (box
                  (ctfe-diagnostic-at-expr
                    call-expr
                    "macro call has too few arguments")))
              (let
                [arg : i64 (ast-expr-list-get args index 0)]
                [arg-expr : AstExpr (ast-node-get arg)]
                (match (macro-bind-fixed-param
                  ctx
                  decls
                  fallback-module
                  type-env
                  pname
                  pty
                  arg
                  arg-expr
                  capture-expr-types
                  env)
                  [(ResultMacroEnv.Ok next-env)
                    (macro-bind-params-at
                      ctx
                      decls
                      fallback-module
                      type-env
                      params
                      args
                      (+ index 1)
                      next-env
                      capture-expr-types
                      call-expr)]
                  [(ResultMacroEnv.Err diag) (ResultMacroEnv.Err diag)]))))])]))

;; Run a macro transformer via CTFE. Module/declaration macro expansion also
;; needs the bound CTFE environment while normalizing generated import operands.
(define (macro-eval-transformer-expanded-with-env
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [type-env : TcTypeEnv]
  [macro-name : String]
  [params : AstMacroParamList]
  [body : AstExpr]
  [expanded-args : AstExprList]
  [call-expr : AstExpr]) : ResultMacroValueEnv
  (begin
    (tc-context-capture-active-pools! ctx)
    (match (macro-bind-params
      ctx
      decls
      fallback-module
      type-env
      params
      expanded-args
      (tc-ctfe-env ctx)
      (tc-string-list-contains macro-expand-expr-type-macro-names macro-name)
      call-expr)
      [(ResultMacroEnv.Ok env)
        (begin
          (cfg compile-profile (compiler-tc-macro-profile-start))
          (match (ctfe-eval-node
            body
            (ctfe-env-extend
              env
              (ctfe-hygiene-enabled-name)
              (CompilerCtfeValue.Bool true))
            (ctfe-fuel-limit))
            [(ResultCtfe.Ok value _)
              (begin
                (ast-node-pool-context-install! (tc-context-pools ctx))
                (cfg
                  compile-profile
                  (compiler-tc-macro-profile-finish macro-name expanded-args))
                (ResultMacroValueEnv.Ok value env))]
            [(ResultCtfe.Err diag)
              (begin
                (cfg
                  compile-profile
                  (compiler-tc-macro-profile-finish macro-name expanded-args))
                (ResultMacroValueEnv.Err diag))]))]
      [(ResultMacroEnv.Err diag) (ResultMacroValueEnv.Err diag)])))

;; Run a macro transformer via CTFE. Callers decide how to interpret the
;; returned syntax value for expression, module, or declaration positions.
(define (macro-eval-transformer-expanded
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [type-env : TcTypeEnv]
  [macro-name : String]
  [params : AstMacroParamList]
  [body : AstExpr]
  [expanded-args : AstExprList]
  [call-expr : AstExpr]) : ResultMacroValue
  (match (macro-eval-transformer-expanded-with-env
    ctx
    decls
    fallback-module
    type-env
    macro-name
    params
    body
    expanded-args
    call-expr)
    [(ResultMacroValueEnv.Ok value _) (ResultMacroValue.Ok value)]
    [(ResultMacroValueEnv.Err diag) (ResultMacroValue.Err diag)]))

(define (macro-eval-transformer
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [fallback-module : String]
  [macro-name : String]
  [params : AstMacroParamList]
  [body : AstExpr]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]) : ResultMacroValue
  ;; Expand the operands first so a macro call passed as an argument (e.g. a
  ;; nested `str_cat.str-cat`) is reduced to a plain expression before it is typechecked
  ;; and bound; otherwise the operand typecheck sees the inner macro name as an
  ;; unbound value.
  (match (macro-expand-exprs ctx type-env decls depth args)
    [(ResultMacroExprList.Ok expanded-args)
      (macro-eval-transformer-expanded
        ctx
        decls
        fallback-module
        type-env
        macro-name
        params
        body
        expanded-args
        call-expr)]
    [(ResultMacroExprList.Err diag) (ResultMacroValue.Err diag)]))

(define (macro-generated-type-param-expr-list
  [env : CtfeEnv]
  [exprs : AstExprList]) : AstExprList
  (let
    [out : AstExprList (ast-expr-list-with-capacity (struct-get (& exprs) len))]
    (begin
      (macro-generated-type-param-expr-list-into env (& exprs) 0 (&mut out))
      out)))

(define (macro-generated-type-param-expr-list-into
  [env : CtfeEnv]
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [out : (&mut out AstExprList)]) : unit
  (if (>= index (struct-get exprs len))
    unit
    (begin
      (ast-expr-list-push
        out
        (macro-generated-type-param-expr
          env
          (ast-node-get (ast-expr-list-get exprs index 0))))
      (macro-generated-type-param-expr-list-into env exprs (+ index 1) out))))

(define (macro-generated-type-param-expr [env : CtfeEnv] [expr : AstExpr]) : i64
  (match expr
    [(AstExpr.Spanned inner-box span)
      (let
        [inner : AstExpr (ast-node-get inner-box)]
        (ast-expr-spanned (macro-generated-type-param-expr env inner) span))]
    [(AstExpr.Var name)
      (let
        [lookup-name : String (macro-output-source-name (intern-str name))]
        (match (ctfe-env-lookup env lookup-name)
          [(CtfeMaybeValue.Some value)
            (match value
              [(CompilerCtfeValue.Type ty)
                (ast-node-push (AstExpr.TypeLiteral ty))]
              [_ (ast-node-push expr)])]
          [(CtfeMaybeValue.None) (ast-node-push expr)]))]
    [(AstExpr.Call func-box args)
      (ast-expr-call func-box (macro-generated-type-param-expr-list env args))]
    [_ (ast-node-push expr)]))

(define (macro-generated-call-func-for-lookup [expr : AstExpr]) : AstExpr
  (match (ast-expr-unspan expr)
    [(AstExpr.Var name)
      (AstExpr.Var (intern (macro-output-source-name (intern-str name))))]
    [_ expr]))

(define (macro-generated-import-type-arg
  [ty : AstType]
  [arg : i64]
  [env : CtfeEnv]) : i64
  (if (tc-macro-type-param-kind? ty)
    (macro-generated-type-param-expr env (ast-node-get arg))
    arg))

(define (macro-generated-import-type-args-for-param
  [param : AstMacroParam]
  [params : (& params AstMacroParamList)]
  [args : (& args AstExprList)]
  [index : i64]
  [env : CtfeEnv]) : AstExprList
  (match param
    [(AstMacroParam.Param _ ty variadic)
      (if variadic
        (let
          [remaining : AstExprList (ast-expr-list-tail-from-ref args index)]
          (if (tc-macro-type-param-kind? ty)
            (macro-generated-type-param-expr-list env remaining)
            remaining))
        (ast-expr-cons
          (macro-generated-import-type-arg
            ty
            (ast-expr-list-get args index 0)
            env)
          (macro-generated-import-type-args-at params args (+ index 1) env)))]))

(define (macro-generated-import-type-args
  [params : AstMacroParamList]
  [args : AstExprList]
  [env : CtfeEnv]) : AstExprList
  (macro-generated-import-type-args-at (& params) (& args) 0 env))

(define (macro-generated-import-type-args-at
  [params : (& params AstMacroParamList)]
  [args : (& args AstExprList)]
  [index : i64]
  [env : CtfeEnv]) : AstExprList
  (if (>= index (ast-macro-param-list-len params))
    (ast-expr-list-tail-from-ref args index)
    (if (>= index (struct-get args len))
      (ast-expr-list-new)
      (macro-generated-import-type-args-for-param
        (ast-macro-param-list-get params index (ast-macro-param-fallback))
        params
        args
        index
        env))))

(define (macro-rewrite-generated-import-call-with-decl
  [func-box : i64]
  [args : AstExprList]
  [env : CtfeEnv]
  [fallback : i64]
  [maybe-decl : MacroMaybeDecl]) : i64
  (match maybe-decl
    [(MacroMaybeDecl.Some _ _ params _ _)
      (ast-expr-call
        func-box
        (macro-generated-import-type-args params args env))]
    [(MacroMaybeDecl.No) fallback]))

(define (macro-rewrite-generated-import-direct-call
  [ctx : TcContext]
  [decls : AstDeclList]
  [module : String]
  [func : AstExpr]
  [call-expr : AstExpr]
  [func-box : i64]
  [args : AstExprList]
  [env : CtfeEnv]
  [fallback : i64]) : i64
  (match (ast-expr-unspan func)
    [(AstExpr.Var name)
      (let
        [lookup-name : String (macro-output-source-name (intern-str name))]
        (if (or
          (tc-name-qualified? lookup-name)
          (tc-source-slash-qualified? lookup-name)
          (>= (tc-name-first-dot lookup-name) 0))
          fallback
          (match (macro-import-alias-target-cached
            decls
            (intern module)
            lookup-name)
            [(TcMaybeString.Some target)
              (match (macro-unqualified-imported-target-call-decl
                ctx
                target
                lookup-name
                call-expr)
                [(ResultMacroCallDecl.Ok maybe-decl)
                  (match maybe-decl
                    [(MacroMaybeDecl.Some _ _ _ _ _)
                      (macro-rewrite-generated-import-call-with-decl
                        func-box
                        args
                        env
                        fallback
                        maybe-decl)]
                    [(MacroMaybeDecl.No)
                      (ast-expr-call
                        func-box
                        (macro-generated-type-param-expr-list env args))])]
                [(ResultMacroCallDecl.Err _) fallback])]
            [(TcMaybeString.No) fallback])))]
    [_ fallback]))

(define (macro-rewrite-generated-import-call-id
  [ctx : TcContext]
  [orig-decls : AstDeclList]
  [module : String]
  [definition-module : String]
  [env : CtfeEnv]
  [call-id : i64]) : i64
  (let
    [call-expr : AstExpr (ast-node-get call-id)]
    (match (ast-expr-unspan call-expr)
      [(AstExpr.Call func-box args)
        (let
          [func : AstExpr (ast-node-get func-box)]
          [lookup-func : AstExpr (macro-generated-call-func-for-lookup func)]
          (match (macro-call-decl-with-context
            ctx
            lookup-func
            orig-decls
            module
            (AstMaybeModuleName.Some definition-module)
            call-expr)
            [(ResultMacroCallDeclModule.Ok maybe-decl _)
              (match maybe-decl
                [(MacroMaybeDecl.Some _ _ _ _ _)
                  (macro-rewrite-generated-import-call-with-decl
                    func-box
                    args
                    env
                    call-id
                    maybe-decl)]
                [(MacroMaybeDecl.No)
                  (macro-rewrite-generated-import-direct-call
                    ctx
                    orig-decls
                    module
                    lookup-func
                    call-expr
                    func-box
                    args
                    env
                    call-id)])]
            [(ResultMacroCallDeclModule.Err _)
              (macro-rewrite-generated-import-direct-call
                ctx
                orig-decls
                module
                lookup-func
                call-expr
                func-box
                args
                env
                call-id)]))]
      [_ call-id])))

(define (macro-rewrite-generated-import-kind
  [ctx : TcContext]
  [orig-decls : AstDeclList]
  [module : String]
  [definition-module : String]
  [env : CtfeEnv]
  [kind : AstImportKind]) : AstImportKind
  (match kind
    [(AstImportKind.Macro call-id context)
      (AstImportKind.Macro
        (macro-rewrite-generated-import-call-id
          ctx
          orig-decls
          module
          definition-module
          env
          call-id)
        context)]
    [(AstImportKind.MacroDecls call-id context)
      (AstImportKind.MacroDecls
        (macro-rewrite-generated-import-call-id
          ctx
          orig-decls
          module
          definition-module
          env
          call-id)
        context)]
    [_ kind]))

(define (macro-rewrite-generated-import-decl
  [ctx : TcContext]
  [orig-decls : AstDeclList]
  [module : String]
  [definition-module : String]
  [env : CtfeEnv]
  [decl : AstDecl]) : AstDecl
  (match decl
    [(AstDecl.Import (AstImportSpec.Spec kind path expected alias span))
      (AstDecl.Import
        (AstImportSpec.Spec
          (macro-rewrite-generated-import-kind
            ctx
            orig-decls
            module
            definition-module
            env
            kind)
          path
          expected
          alias
          span))]
    [(AstDecl.Unsafe inner-box)
      (ast-decl-unsafe
        (macro-rewrite-generated-import-decl
          ctx
          orig-decls
          module
          definition-module
          env
          (box-get inner-box)))]
    [(AstDecl.ComptimeDecl meta inner-box)
      (ast-decl-comptime-decl-with-meta
        meta
        (macro-rewrite-generated-import-decl
          ctx
          orig-decls
          module
          definition-module
          env
          (box-get inner-box)))]
    [(AstDecl.ModuleBody name body-box)
      (ast-decl-module-body-id
        name
        (macro-rewrite-generated-import-decls-with-env
          ctx
          orig-decls
          (intern-str name)
          definition-module
          env
          (box-get body-box)))]
    [_ decl]))

(define (macro-rewrite-generated-import-decls-with-env
  [ctx : TcContext]
  [orig-decls : AstDeclList]
  [module : String]
  [definition-module : String]
  [env : CtfeEnv]
  [decls : AstDeclList]) : AstDeclList
  (let
    [count : i64 (ast-decl-list-len (& decls))]
    [cursor : AstDeclList decls]
    [out : AstDeclList (ast-decl-list-with-capacity count)]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast-decl-list-step cursor)
          [(AstDeclListStep.Nil) (set! done true)]
          [(AstDeclListStep.Cons decl rest)
            (begin
              (ast-decl-list-push
                (&mut out)
                (macro-rewrite-generated-import-decl
                  ctx
                  orig-decls
                  module
                  definition-module
                  env
                  decl))
              (set! cursor rest))]))
      out)))

(define (macro-rewrite-generated-import-decls
  [ctx : TcContext]
  [orig-decls : AstDeclList]
  [module : String]
  [definition-module : String]
  [env : CtfeEnv]
  [decls : AstDeclList]) : AstDeclList
  (let
    [rewrite-env : CtfeEnv
      (ctfe-env-extend
        (ctfe-env-rebase-pools env (tc-context-pools ctx))
        (ctfe-hygiene-enabled-name)
        (CompilerCtfeValue.Bool true))]
    (macro-rewrite-generated-import-decls-with-env
      ctx
      orig-decls
      module
      definition-module
      rewrite-env
      decls)))

;; Fast path for the hot stdlib.vector declaration macro. The macro body
;; is a deterministic quasiquote that emits a fixed growable-vector declaration
;; family, so building the AST directly avoids CTFE plus macro-output parsing.
(define (macro-vector-family-decls-macro?
  [macro-name : String]
  [definition-module : String]) : bool
  (and
    (string.eq definition-module "stdlib.vector")
    (tc-name-base-eq? macro-name "vector-family")))

(define (macro-vf-name-expr [expr : AstExpr]) : TcMaybeString
  (match (ast-expr-unspan expr)
    [(AstExpr.Var name) (TcMaybeString.Some (intern-str name))]
    [_ (TcMaybeString.No)]))

(define (macro-vf-var [name : String]) : i64
  (ast-node-push (AstExpr.Var (intern name))))

(define (macro-vf-lit-i64 [value : i64]) : i64
  (ast-node-push (AstExpr.Literal (ast-lit-int value))))

(define (macro-vf-lit-bool [value : bool]) : i64
  (ast-node-push (AstExpr.Literal (AstLiteral.Bool value))))

(define (macro-vf-unit) : i64
  (ast-node-push (AstExpr.Literal AstLiteral.Unit)))

(define (macro-vf-expr-list1 [a : i64]) : AstExprList
  (ast-expr-cons a (ast-expr-list-new)))

(define (macro-vf-expr-list2 [a : i64] [b : i64]) : AstExprList
  (ast-expr-cons a (macro-vf-expr-list1 b)))

(define (macro-vf-expr-list3 [a : i64] [b : i64] [c : i64]) : AstExprList
  (ast-expr-cons a (macro-vf-expr-list2 b c)))

(define (macro-vf-expr-list4 [a : i64] [b : i64] [c : i64] [d : i64]) : AstExprList
  (ast-expr-cons a (macro-vf-expr-list3 b c d)))

(define (macro-vf-param [name : String] [ty : AstType]) : AstParam
  (ast-param name ty false))

(define (macro-vf-param-list1 [a : AstParam]) : AstParamList
  (ast-param-cons a (ast-param-list-new)))

(define (macro-vf-param-list2 [a : AstParam] [b : AstParam]) : AstParamList
  (ast-param-cons a (macro-vf-param-list1 b)))

(define (macro-vf-param-list3 [a : AstParam] [b : AstParam] [c : AstParam]) : AstParamList
  (ast-param-cons a (macro-vf-param-list2 b c)))

(define (macro-vf-param-list4
  [a : AstParam]
  [b : AstParam]
  [c : AstParam]
  [d : AstParam]) : AstParamList
  (ast-param-cons a (macro-vf-param-list3 b c d)))

(define (macro-vf-call [name : String] [args : AstExprList]) : i64
  (ast-expr-call (macro-vf-var name) args))

(define (macro-vf-call0 [name : String]) : i64
  (macro-vf-call name (ast-expr-list-new)))

(define (macro-vf-call1 [name : String] [a : i64]) : i64
  (macro-vf-call name (macro-vf-expr-list1 a)))

(define (macro-vf-call2 [name : String] [a : i64] [b : i64]) : i64
  (macro-vf-call name (macro-vf-expr-list2 a b)))

(define (macro-vf-array-length [value : i64]) : i64
  (macro-vf-call1 "__tl_array-length" value))

(define (macro-vf-array-ty [elem-ty : AstType]) : AstType
  (ast-ty-dyn-array elem-ty))

(define (macro-vf-vec-ty [vec-name : String]) : AstType
  (AstType.Var (intern vec-name)))

(define (macro-vf-ref-ty [region : String] [inner : AstType]) : AstType
  (ast-ty-ref region inner))

(define (macro-vf-mut-ref-ty [region : String] [inner : AstType]) : AstType
  (ast-ty-mut-ref region inner))

(define (macro-vf-borrow [mutable : bool] [expr : i64]) : i64
  (ast-expr-borrow mutable (AstBorrowLifetime.Inferred) expr))

(define (macro-vf-struct-get [target : String] [field : String]) : i64
  (ast-expr-struct-get-id (macro-vf-var target) (intern field)))

(define (macro-vf-struct-set [target : String] [field : String] [value : i64]) : i64
  (ast-expr-struct-set-id (macro-vf-var target) (intern field) value))

(define (macro-vf-begin2 [a : i64] [b : i64]) : i64
  (ast-node-push (AstExpr.Begin (macro-vf-expr-list2 a b))))

(define (macro-vf-struct-decl [vec-name : String] [elem-ty : AstType]) : AstDecl
  (let
    [slots-field : AstFieldDef
      (ast-field-def "slots" (macro-vf-array-ty elem-ty) AstFieldCleanup.No)]
    [len-field : AstFieldDef
      (ast-field-def "len" (AstType.I64) AstFieldCleanup.No)]
    (ast-decl-def-struct
      vec-name
      (AstStructRepr.Default)
      (AstStructCleanup.No)
      (ast-field-def-cons
        slots-field
        (ast-field-def-cons len-field (ast-field-def-list-new))))))

(define (macro-vf-slots-decl
  [slots-name : String]
  [vec-name : String]
  [elem-ty : AstType]) : AstDecl
  (ast-decl-def-fn
    slots-name
    (macro-vf-param-list1
      (macro-vf-param "v" (macro-vf-ref-ty "v" (macro-vf-vec-ty vec-name))))
    (macro-vf-ref-ty "v" (macro-vf-array-ty elem-ty))
    (macro-vf-borrow false (macro-vf-struct-get "v" "slots"))))

(define (macro-vf-len-decl [len-name : String] [vec-name : String]) : AstDecl
  (ast-decl-def-fn
    len-name
    (macro-vf-param-list1
      (macro-vf-param "v" (macro-vf-ref-ty "v" (macro-vf-vec-ty vec-name))))
    (AstType.I64)
    (macro-vf-struct-get "v" "len")))

(define (macro-vf-capacity-decl
  [capacity-name : String]
  [slots-name : String]
  [vec-name : String]) : AstDecl
  (ast-decl-def-fn
    capacity-name
    (macro-vf-param-list1
      (macro-vf-param "v" (macro-vf-ref-ty "v" (macro-vf-vec-ty vec-name))))
    (AstType.I64)
    (macro-vf-array-length (macro-vf-call1 slots-name (macro-vf-var "v")))))

(define (macro-vf-with-capacity-decl
  [with-capacity-name : String]
  [vec-name : String]
  [elem-ty : AstType]) : AstDecl
  (let
    [capacity-var : i64 (macro-vf-var "capacity")]
    [cap-var : i64 (macro-vf-var "cap")]
    [cap-init : i64
      (ast-expr-if
        (ast-expr-binary (AstBinOp.Lt) capacity-var (macro-vf-lit-i64 1))
        (macro-vf-lit-i64 1)
        (macro-vf-var "capacity"))]
    [make-slots : i64 (ast-expr-make-array elem-ty cap-var)]
    [body : i64
      (macro-vf-call
        vec-name
        (macro-vf-expr-list2 make-slots (macro-vf-lit-i64 0)))]
    (ast-decl-def-fn
      with-capacity-name
      (macro-vf-param-list1 (macro-vf-param "capacity" (AstType.I64)))
      (macro-vf-vec-ty vec-name)
      (ast-expr-let
        (ast-let-binding-cons
          (ast-let-binding "cap" (AstMaybeType.Some (AstType.I64)) cap-init)
          (ast-let-binding-list-new))
        body))))

(define (macro-vf-new-decl
  [new-name : String]
  [with-capacity-name : String]
  [vec-name : String]) : AstDecl
  (ast-decl-def-fn
    new-name
    (ast-param-list-new)
    (macro-vf-vec-ty vec-name)
    (macro-vf-call1 with-capacity-name (macro-vf-lit-i64 4))))

(define (macro-vf-bounds-check [len-expr : i64]) : i64
  (ast-expr-if
    (ast-expr-binary (AstBinOp.Ge) (macro-vf-var "index") (macro-vf-lit-i64 0))
    (ast-expr-binary (AstBinOp.Lt) (macro-vf-var "index") len-expr)
    (macro-vf-lit-bool false)))

(define (macro-vf-get-decl
  [get-name : String]
  [slots-name : String]
  [len-name : String]
  [vec-name : String]
  [elem-ty : AstType]) : AstDecl
  (ast-decl-def-fn
    get-name
    (macro-vf-param-list3
      (macro-vf-param "v" (macro-vf-ref-ty "v" (macro-vf-vec-ty vec-name)))
      (macro-vf-param "index" (AstType.I64))
      (macro-vf-param "fallback" elem-ty))
    elem-ty
    (ast-expr-if
      (macro-vf-bounds-check (macro-vf-call1 len-name (macro-vf-var "v")))
      (ast-expr-array-ref
        (macro-vf-call1 slots-name (macro-vf-var "v"))
        (macro-vf-var "index"))
      (macro-vf-var "fallback"))))

(define (macro-vf-set-decl
  [set-name : String]
  [vec-name : String]
  [elem-ty : AstType]) : AstDecl
  (ast-decl-def-fn
    set-name
    (macro-vf-param-list3
      (macro-vf-param "v" (macro-vf-mut-ref-ty "v" (macro-vf-vec-ty vec-name)))
      (macro-vf-param "index" (AstType.I64))
      (macro-vf-param "value" elem-ty))
    (AstType.Unit)
    (ast-expr-if
      (macro-vf-bounds-check (macro-vf-struct-get "v" "len"))
      (ast-expr-array-set
        (macro-vf-struct-get "v" "slots")
        (macro-vf-var "index")
        (macro-vf-var "value"))
      (macro-vf-unit))))

(define (macro-vf-copy-range-decl
  [copy-range-name : String]
  [elem-ty : AstType]) : AstDecl
  (ast-decl-def-fn
    copy-range-name
    (macro-vf-param-list4
      (macro-vf-param
        "dst"
        (macro-vf-mut-ref-ty "dst" (macro-vf-array-ty elem-ty)))
      (macro-vf-param "src" (macro-vf-ref-ty "src" (macro-vf-array-ty elem-ty)))
      (macro-vf-param "index" (AstType.I64))
      (macro-vf-param "count" (AstType.I64)))
    (AstType.Unit)
    (ast-expr-if
      (ast-expr-binary
        (AstBinOp.Ge)
        (macro-vf-var "index")
        (macro-vf-var "count"))
      (macro-vf-unit)
      (macro-vf-begin2
        (ast-expr-array-set
          (macro-vf-var "dst")
          (macro-vf-var "index")
          (ast-expr-array-ref (macro-vf-var "src") (macro-vf-var "index")))
        (macro-vf-call
          copy-range-name
          (macro-vf-expr-list4
            (macro-vf-var "dst")
            (macro-vf-var "src")
            (ast-expr-binary
              (AstBinOp.Add)
              (macro-vf-var "index")
              (macro-vf-lit-i64 1))
            (macro-vf-var "count")))))))

(define (macro-vf-grow-decl
  [grow-name : String]
  [copy-range-name : String]
  [vec-name : String]
  [elem-ty : AstType]) : AstDecl
  (let
    [n-init : i64 (macro-vf-struct-get "v" "len")]
    [old-cap-init : i64
      (macro-vf-array-length (macro-vf-struct-get "v" "slots"))]
    [new-cap-init : i64
      (ast-expr-if
        (ast-expr-binary
          (AstBinOp.Lt)
          (macro-vf-var "old-cap")
          (macro-vf-lit-i64 1))
        (macro-vf-lit-i64 1)
        (ast-expr-binary
          (AstBinOp.Mul)
          (macro-vf-var "old-cap")
          (macro-vf-lit-i64 2)))]
    [bigger-init : i64 (ast-expr-make-array elem-ty (macro-vf-var "new-cap"))]
    [copy-call : i64
      (macro-vf-call
        copy-range-name
        (macro-vf-expr-list4
          (macro-vf-borrow true (macro-vf-var "bigger"))
          (macro-vf-borrow false (macro-vf-struct-get "v" "slots"))
          (macro-vf-lit-i64 0)
          (macro-vf-var "n")))]
    [body : i64
      (macro-vf-begin2
        copy-call
        (macro-vf-struct-set "v" "slots" (macro-vf-var "bigger")))]
    (ast-decl-def-fn
      grow-name
      (macro-vf-param-list1
        (macro-vf-param
          "v"
          (macro-vf-mut-ref-ty "v" (macro-vf-vec-ty vec-name))))
      (AstType.Unit)
      (ast-expr-let
        (ast-let-binding-cons
          (ast-let-binding "n" (AstMaybeType.Some (AstType.I64)) n-init)
          (ast-let-binding-cons
            (ast-let-binding
              "old-cap"
              (AstMaybeType.Some (AstType.I64))
              old-cap-init)
            (ast-let-binding-cons
              (ast-let-binding
                "new-cap"
                (AstMaybeType.Some (AstType.I64))
                new-cap-init)
              (ast-let-binding-cons
                (ast-let-binding
                  "bigger"
                  (AstMaybeType.Some (macro-vf-array-ty elem-ty))
                  bigger-init)
                (ast-let-binding-list-new)))))
        body))))

(define (macro-vf-push-decl
  [push-name : String]
  [grow-name : String]
  [vec-name : String]
  [elem-ty : AstType]) : AstDecl
  (let
    [ensure-capacity : i64
      (ast-expr-if
        (ast-expr-binary
          (AstBinOp.Lt)
          (macro-vf-struct-get "v" "len")
          (macro-vf-array-length (macro-vf-struct-get "v" "slots")))
        (macro-vf-unit)
        (macro-vf-call1 grow-name (macro-vf-var "v")))]
    [push-body : i64
      (ast-expr-let
        (ast-let-binding-cons
          (ast-let-binding
            "index"
            (AstMaybeType.Some (AstType.I64))
            (macro-vf-struct-get "v" "len"))
          (ast-let-binding-list-new))
        (macro-vf-begin2
          (ast-expr-array-set
            (macro-vf-struct-get "v" "slots")
            (macro-vf-var "index")
            (macro-vf-var "value"))
          (macro-vf-struct-set
            "v"
            "len"
            (ast-expr-binary
              (AstBinOp.Add)
              (macro-vf-var "index")
              (macro-vf-lit-i64 1)))))]
    (ast-decl-def-fn
      push-name
      (macro-vf-param-list2
        (macro-vf-param
          "v"
          (macro-vf-mut-ref-ty "v" (macro-vf-vec-ty vec-name)))
        (macro-vf-param "value" elem-ty))
      (AstType.Unit)
      (macro-vf-begin2 ensure-capacity push-body))))

(define (macro-vf-decls [elem-ty : AstType] [vec-name : String] [base : String]) : AstDeclList
  (let
    [slots-name : String (string.append base "-slots")]
    [len-name : String (string.append base "-len")]
    [capacity-name : String (string.append base "-capacity")]
    [with-capacity-name : String (string.append base "-with-capacity")]
    [new-name : String (string.append base "-new")]
    [get-name : String (string.append base "-get")]
    [set-name : String (string.append base "-set!")]
    [copy-range-name : String (string.append base "-copy-range")]
    [grow-name : String (string.append base "-grow")]
    [push-name : String (string.append base "-push")]
    (ast-decl-cons
      (macro-vf-struct-decl vec-name elem-ty)
      (ast-decl-cons
        (macro-vf-slots-decl slots-name vec-name elem-ty)
        (ast-decl-cons
          (macro-vf-len-decl len-name vec-name)
          (ast-decl-cons
            (macro-vf-capacity-decl capacity-name slots-name vec-name)
            (ast-decl-cons
              (macro-vf-with-capacity-decl with-capacity-name vec-name elem-ty)
              (ast-decl-cons
                (macro-vf-new-decl new-name with-capacity-name vec-name)
                (ast-decl-cons
                  (macro-vf-get-decl
                    get-name
                    slots-name
                    len-name
                    vec-name
                    elem-ty)
                  (ast-decl-cons
                    (macro-vf-set-decl set-name vec-name elem-ty)
                    (ast-decl-cons
                      (macro-vf-copy-range-decl copy-range-name elem-ty)
                      (ast-decl-cons
                        (macro-vf-grow-decl
                          grow-name
                          copy-range-name
                          vec-name
                          elem-ty)
                        (ast-decl-cons
                          (macro-vf-push-decl
                            push-name
                            grow-name
                            vec-name
                            elem-ty)
                          (ast-decl-list-new))))))))))))))

(define (macro-vector-family-fast-arity-error [call-expr : AstExpr]) : ResultMacroParsedDecls
  (ResultMacroParsedDecls.Err
    (box
      (ctfe-diagnostic-at-expr
        call-expr
        "typecheck: vector-family expects exactly three arguments"))))

(define (macro-vector-family-fast-decls
  [ctx : TcContext]
  [decls : AstDeclList]
  [fallback-module : String]
  [args : AstExprList]
  [call-expr : AstExpr]) : ResultMacroParsedDecls
  (if (= (struct-get (& args) len) 3)
    (let
      [type-id : i64 (ast-expr-list-get (& args) 0 0)]
      [vec-id : i64 (ast-expr-list-get (& args) 1 0)]
      [prefix-id : i64 (ast-expr-list-get (& args) 2 0)]
      [type-expr : AstExpr (ast-node-get type-id)]
      [vec-expr : AstExpr (ast-node-get vec-id)]
      (match (macro-type-arg-with-fallback ctx decls fallback-module type-expr)
        [(ResultMacroTypeArg.Ok elem-ty)
          (match (macro-vf-name-expr vec-expr)
            [(TcMaybeString.Some vec-name)
              (match (macro-vf-name-expr (ast-node-get prefix-id))
                [(TcMaybeString.Some base)
                  (ResultMacroParsedDecls.Ok
                    (macro-vf-decls elem-ty vec-name base))]
                [(TcMaybeString.No)
                  (ResultMacroParsedDecls.Ok (ast-decl-list-new))])]
            [(TcMaybeString.No) (ResultMacroParsedDecls.Ok (ast-decl-list-new))])]
        [(ResultMacroTypeArg.Err diag) (ResultMacroParsedDecls.Err diag)]))
    (macro-vector-family-fast-arity-error call-expr)))

;; The core prelude macros below are deterministic syntax rewrites. Expanding
;; them in the compiler avoids running the CTFE evaluator for thousands of hot
;; self-compile calls while preserving normal CTFE for user-defined macros.
(define (macro-core-prelude-module? [definition-module : String]) : bool
  (or
    (string.eq definition-module "stdlib.core_macros")
    (string.eq definition-module "stdlib.core-macros")))

(define (macro-core-fast-path-base [macro-name : String]) : String
  (if (tc-name-qualified? macro-name)
    (tc-qualified-name-base macro-name)
    macro-name))

(define (macro-core-fast-path-base-known? [base : String]) : bool
  (or
    (string.eq base "and")
    (string.eq base "or")
    (string.eq base "when")
    (string.eq base "unless")
    (string.eq base "cond")))

(define (macro-str-cat-module? [definition-module : String]) : bool
  (or
    (string.eq definition-module "stdlib.str_cat")
    (string.eq definition-module "stdlib.str-cat")))

(define (macro-str-cat-fast-path?
  [macro-name : String]
  [definition-module : String]) : bool
  (and
    (macro-str-cat-module? definition-module)
    (string.eq (macro-core-fast-path-base macro-name) "str-cat")))

(define (macro-core-fast-bool [value : bool]) : i64
  (ast-node-push (AstExpr.Literal (AstLiteral.Bool value))))

(define (macro-core-fast-unit) : i64
  (ast-node-push (AstExpr.Literal AstLiteral.Unit)))

(define (macro-core-fast-var [name : String]) : i64
  (ast-node-push (AstExpr.Var (intern name))))

(define (macro-core-fast-string [value : String]) : i64
  (ast-node-push (AstExpr.Literal (AstLiteral.String value))))

(define (macro-core-fast-int [value : i64]) : i64
  (ast-node-push (AstExpr.Literal (ast-lit-int value))))

(define (macro-core-fast-and [args : AstExprList]) : i64
  (macro-core-fast-and-at (& args) 0))

(define (macro-core-fast-and-at [args : (& args AstExprList)] [index : i64]) : i64
  (if (>= index (struct-get args len))
    (macro-core-fast-bool true)
    (ast-expr-if
      (ast-expr-list-get args index 0)
      (macro-core-fast-and-at args (+ index 1))
      (macro-core-fast-bool false))))

(define (macro-core-fast-or [args : AstExprList]) : i64
  (macro-core-fast-or-at (& args) 0))

(define (macro-core-fast-or-at [args : (& args AstExprList)] [index : i64]) : i64
  (if (>= index (struct-get args len))
    (macro-core-fast-bool false)
    (ast-expr-if
      (ast-expr-list-get args index 0)
      (macro-core-fast-bool true)
      (macro-core-fast-or-at args (+ index 1)))))

(define (macro-core-fast-arity-error [call-expr : AstExpr] [message : String]) : ResultMacroCompatCall
  (ResultMacroCompatCall.Err (box (ctfe-diagnostic-at-expr call-expr message))))

(define (macro-core-fast-guard
  [args : AstExprList]
  [is-unless : bool]
  [call-expr : AstExpr]) : ResultMacroCompatCall
  (let
    [len : i64 (struct-get (& args) len)]
    (cond
      [(< len 2)
        (macro-core-fast-arity-error
          call-expr
          "macro call has too few arguments")]
      [(> len 2)
        (macro-core-fast-arity-error
          call-expr
          "macro call has too many arguments")]
      [else
        (let
          [cond : i64 (ast-expr-list-get (& args) 0 0)]
          [body : i64 (ast-expr-list-get (& args) 1 0)]
          [unit-expr : i64 (macro-core-fast-unit)]
          (if is-unless
            (ResultMacroCompatCall.Ok (ast-expr-if cond unit-expr body))
            (ResultMacroCompatCall.Ok (ast-expr-if cond body unit-expr))))])))

(define (macro-core-fast-cond-else? [test : i64]) : bool
  (match (ast-expr-unspan (ast-node-get test))
    [(AstExpr.Var name) (string.eq (intern-str name) "else")]
    [_ false]))

(define (macro-core-fast-cond [clauses : AstExprClauseList]) : i64
  (macro-core-fast-cond-at (& clauses) 0))

(define (macro-core-fast-cond-at
  [clauses : (& clauses AstExprClauseList)]
  [index : i64]) : i64
  (if (>= index (struct-get clauses len))
    (macro-core-fast-var "core-cond-missing-else")
    (let
      [clause : AstExprClause
        (ast-expr-clause-list-get clauses index (ast-expr-clause-fallback))]
      [test : i64 (struct-get clause first)]
      [result : i64 (struct-get clause second)]
      [last? : bool (= (+ index 1) (struct-get clauses len))]
      (if (macro-core-fast-cond-else? test)
        (if last?
          result
          (macro-core-fast-var "core-cond-else-must-be-final"))
        (if last?
          (macro-core-fast-var "core-cond-missing-else")
          (ast-expr-if
            test
            result
            (macro-core-fast-cond-at clauses (+ index 1))))))))

(define (macro-core-fast-cond-call [args : AstExprList]) : ResultMacroCompatCall
  (match (macro-expr-clause-list-from-args args)
    [(ResultMacroClauseList.Ok clauses)
      (ResultMacroCompatCall.Ok (macro-core-fast-cond clauses))]
    [(ResultMacroClauseList.Err diag) (ResultMacroCompatCall.Err diag)]))

(define (macro-str-cat-fast-length [args : AstExprList]) : i64
  (struct-get (& args) len))

(define (macro-str-cat-fast-call
  [definition-module : String]
  [name : String]
  [args : AstExprList]) : i64
  (ast-expr-call
    (macro-core-fast-var
      (tc-hygiene-global-context-name definition-module name))
    args))

(define (macro-str-cat-fast-list1 [a : i64]) : AstExprList
  (ast-expr-cons a (ast-expr-list-new)))

(define (macro-str-cat-fast-list2 [a : i64] [b : i64]) : AstExprList
  (ast-expr-cons a (macro-str-cat-fast-list1 b)))

(define (macro-str-cat-fast-list3 [a : i64] [b : i64] [c : i64]) : AstExprList
  (ast-expr-cons a (macro-str-cat-fast-list2 b c)))

(define (macro-str-cat-fast-list4 [a : i64] [b : i64] [c : i64] [d : i64]) : AstExprList
  (ast-expr-cons a (macro-str-cat-fast-list3 b c d)))

(define (macro-str-cat-fast-list5
  [a : i64]
  [b : i64]
  [c : i64]
  [d : i64]
  [e : i64]) : AstExprList
  (ast-expr-cons a (macro-str-cat-fast-list4 b c d e)))

(define (macro-array-module? [definition-module : String]) : bool
  (or
    (string.eq definition-module "stdlib.array")
    (string.eq definition-module "stdlib/array")))

(define (macro-array-fast-path-base-known? [base : String]) : bool
  (or
    (string.eq base "make-array")
    (string.eq base "length")
    (string.eq base "array-length")
    (string.eq base "ref")
    (string.eq base "array-ref")
    (string.eq base "array-set!")
    (string.eq base "push!")
    (string.eq base "array-push!")))

(define (macro-array-fast-path?
  [macro-name : String]
  [definition-module : String]) : bool
  (and
    (macro-array-module? definition-module)
    (macro-array-fast-path-base-known? (macro-core-fast-path-base macro-name))))

(define (macro-array-fast-private-call [name : String] [args : AstExprList]) : i64
  (ast-expr-call (macro-core-fast-var name) args))

(define (macro-array-fast-make-array
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [macro-name : String]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]) : ResultMacroCompatCall
  (if (= (struct-get (& args) len) 2)
    (let
      [type-id : i64 (ast-expr-list-get (& args) 0 0)]
      [count-id : i64 (ast-expr-list-get (& args) 1 0)]
      [type-expr : AstExpr (ast-node-get type-id)]
      (match (macro-type-arg-with-fallback
        ctx
        decls
        (tc-context-module ctx)
        type-expr)
        [(ResultMacroTypeArg.Ok elem-ty)
          (match (macro-expand-expr
            ctx
            type-env
            decls
            depth
            (ast-node-get count-id))
            [(ResultMacroExpr.Ok ncount)
              (begin
                (tc-context-capture-active-pools! ctx)
                (macro-core-fast-profile-ok
                  macro-name
                  args
                  (ast-expr-make-array elem-ty ncount)))]
            [(ResultMacroExpr.Err diag) (ResultMacroCompatCall.Err diag)])]
        [(ResultMacroTypeArg.Err diag) (ResultMacroCompatCall.Err diag)]))
    (macro-core-fast-arity-error
      call-expr
      "typecheck: make-array expects exactly two arguments")))

(define (macro-array-fast-array-length
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [macro-name : String]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]) : ResultMacroCompatCall
  (if (= (struct-get (& args) len) 1)
    (let
      [items-id : i64 (ast-expr-list-get (& args) 0 0)]
      (match (macro-expand-expr
        ctx
        type-env
        decls
        depth
        (ast-node-get items-id))
        [(ResultMacroExpr.Ok nitems)
          (begin
            (tc-context-capture-active-pools! ctx)
            (macro-core-fast-profile-ok
              macro-name
              args
              (macro-array-fast-private-call
                "__tl_array-length"
                (macro-str-cat-fast-list1 nitems))))]
        [(ResultMacroExpr.Err diag) (ResultMacroCompatCall.Err diag)]))
    (macro-core-fast-arity-error
      call-expr
      "typecheck: array-length expects exactly one argument")))

(define (macro-array-fast-array-ref
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [macro-name : String]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]) : ResultMacroCompatCall
  (if (= (struct-get (& args) len) 2)
    (let
      [items-id : i64 (ast-expr-list-get (& args) 0 0)]
      [index-id : i64 (ast-expr-list-get (& args) 1 0)]
      (match (macro-expand-expr
        ctx
        type-env
        decls
        depth
        (ast-node-get items-id))
        [(ResultMacroExpr.Ok nitems)
          (match (macro-expand-expr
            ctx
            type-env
            decls
            depth
            (ast-node-get index-id))
            [(ResultMacroExpr.Ok nindex)
              (begin
                (tc-context-capture-active-pools! ctx)
                (macro-core-fast-profile-ok
                  macro-name
                  args
                  (ast-expr-array-ref nitems nindex)))]
            [(ResultMacroExpr.Err diag) (ResultMacroCompatCall.Err diag)])]
        [(ResultMacroExpr.Err diag) (ResultMacroCompatCall.Err diag)]))
    (macro-core-fast-arity-error
      call-expr
      "typecheck: array-ref expects exactly two arguments")))

(define (macro-array-fast-array-set
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [macro-name : String]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]) : ResultMacroCompatCall
  (if (= (struct-get (& args) len) 3)
    (let
      [items-id : i64 (ast-expr-list-get (& args) 0 0)]
      [index-id : i64 (ast-expr-list-get (& args) 1 0)]
      [value-id : i64 (ast-expr-list-get (& args) 2 0)]
      (match (macro-expand-expr
        ctx
        type-env
        decls
        depth
        (ast-node-get items-id))
        [(ResultMacroExpr.Ok nitems)
          (match (macro-expand-expr
            ctx
            type-env
            decls
            depth
            (ast-node-get index-id))
            [(ResultMacroExpr.Ok nindex)
              (match (macro-expand-expr
                ctx
                type-env
                decls
                depth
                (ast-node-get value-id))
                [(ResultMacroExpr.Ok nvalue)
                  (begin
                    (tc-context-capture-active-pools! ctx)
                    (macro-core-fast-profile-ok
                      macro-name
                      args
                      (ast-expr-array-set nitems nindex nvalue)))]
                [(ResultMacroExpr.Err diag) (ResultMacroCompatCall.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroCompatCall.Err diag)])]
        [(ResultMacroExpr.Err diag) (ResultMacroCompatCall.Err diag)]))
    (macro-core-fast-arity-error
      call-expr
      "typecheck: array-set! expects exactly three arguments")))

(define (macro-array-fast-array-push
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [macro-name : String]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]) : ResultMacroCompatCall
  (if (= (struct-get (& args) len) 2)
    (let
      [items-id : i64 (ast-expr-list-get (& args) 0 0)]
      [value-id : i64 (ast-expr-list-get (& args) 1 0)]
      (match (macro-expand-expr
        ctx
        type-env
        decls
        depth
        (ast-node-get items-id))
        [(ResultMacroExpr.Ok nitems)
          (match (macro-expand-expr
            ctx
            type-env
            decls
            depth
            (ast-node-get value-id))
            [(ResultMacroExpr.Ok nvalue)
              (begin
                (tc-context-capture-active-pools! ctx)
                (macro-core-fast-profile-ok
                  macro-name
                  args
                  (ast-expr-array-push nitems nvalue)))]
            [(ResultMacroExpr.Err diag) (ResultMacroCompatCall.Err diag)])]
        [(ResultMacroExpr.Err diag) (ResultMacroCompatCall.Err diag)]))
    (macro-core-fast-arity-error
      call-expr
      "typecheck: array-push! expects exactly two arguments")))

(define (macro-array-fast-expand
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [macro-name : String]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]) : ResultMacroCompatCall
  (let
    [base : String (macro-core-fast-path-base macro-name)]
    (cond
      [(string.eq base "make-array")
        (macro-array-fast-make-array
          ctx
          type-env
          decls
          macro-name
          args
          depth
          call-expr)]
      [(string.eq base "array-length")
        (macro-array-fast-array-length
          ctx
          type-env
          decls
          macro-name
          args
          depth
          call-expr)]
      [(string.eq base "length")
        (macro-array-fast-array-length
          ctx
          type-env
          decls
          macro-name
          args
          depth
          call-expr)]
      [(string.eq base "array-ref")
        (macro-array-fast-array-ref
          ctx
          type-env
          decls
          macro-name
          args
          depth
          call-expr)]
      [(string.eq base "ref")
        (macro-array-fast-array-ref
          ctx
          type-env
          decls
          macro-name
          args
          depth
          call-expr)]
      [(string.eq base "array-set!")
        (macro-array-fast-array-set
          ctx
          type-env
          decls
          macro-name
          args
          depth
          call-expr)]
      [(string.eq base "push!")
        (macro-array-fast-array-push
          ctx
          type-env
          decls
          macro-name
          args
          depth
          call-expr)]
      [else
        (macro-array-fast-array-push
          ctx
          type-env
          decls
          macro-name
          args
          depth
          call-expr)])))

(define (macro-str-cat-fast-pack
  [definition-module : String]
  [parts : i64]
  [index : i64]
  [args : AstExprList]) : i64
  (macro-str-cat-fast-pack-at definition-module parts index (& args) 0))

(define (macro-str-cat-fast-pack-at
  [definition-module : String]
  [parts : i64]
  [part-index : i64]
  [args : (& args AstExprList)]
  [arg-index : i64]) : i64
  (if (>= arg-index (struct-get args len))
    parts
    (macro-str-cat-fast-pack-at
      definition-module
      (macro-str-cat-fast-call
        definition-module
        "stdlib.string.concat-all-pack-part"
        (macro-str-cat-fast-list3
          parts
          (macro-core-fast-int part-index)
          (ast-expr-list-get args arg-index 0)))
      (+ part-index 1)
      args
      (+ arg-index 1))))

(define (macro-str-cat-fast-nth [args : AstExprList] [index : i64]) : i64
  (if (< index (struct-get (& args) len))
    (ast-expr-list-get (& args) index 0)
    (macro-core-fast-string "")))

(define (macro-str-cat-fast-expand
  [definition-module : String]
  [args : AstExprList]) : i64
  (let
    [arity : i64 (macro-str-cat-fast-length args)]
    (cond
      [(= arity 0) (macro-core-fast-string "")]
      [(= arity 1) (macro-str-cat-fast-nth args 0)]
      [(= arity 2)
        (macro-str-cat-fast-call
          definition-module
          "stdlib.string.concat3"
          (macro-str-cat-fast-list3
            (macro-str-cat-fast-nth args 0)
            (macro-str-cat-fast-nth args 1)
            (macro-core-fast-string "")))]
      [(= arity 3)
        (macro-str-cat-fast-call
          definition-module
          "stdlib.string.concat3"
          (macro-str-cat-fast-list3
            (macro-str-cat-fast-nth args 0)
            (macro-str-cat-fast-nth args 1)
            (macro-str-cat-fast-nth args 2)))]
      [(= arity 4)
        (macro-str-cat-fast-call
          definition-module
          "stdlib.string.concat4"
          (macro-str-cat-fast-list4
            (macro-str-cat-fast-nth args 0)
            (macro-str-cat-fast-nth args 1)
            (macro-str-cat-fast-nth args 2)
            (macro-str-cat-fast-nth args 3)))]
      [(= arity 5)
        (macro-str-cat-fast-call
          definition-module
          "stdlib.string.concat5"
          (macro-str-cat-fast-list5
            (macro-str-cat-fast-nth args 0)
            (macro-str-cat-fast-nth args 1)
            (macro-str-cat-fast-nth args 2)
            (macro-str-cat-fast-nth args 3)
            (macro-str-cat-fast-nth args 4)))]
      [else
        (macro-str-cat-fast-call
          definition-module
          "stdlib.string.concat-all"
          (macro-str-cat-fast-list1
            (macro-str-cat-fast-pack
              definition-module
              (ast-expr-make-array (AstType.String) (macro-core-fast-int arity))
              0
              args)))])))

(define (macro-core-fast-profile-ok
  [_macro-name : String]
  [_args : AstExprList]
  [expanded : i64]) : ResultMacroCompatCall
  (begin
    (cfg compile-profile (compiler-tc-macro-profile-start))
    (cfg compile-profile (compiler-tc-macro-profile-finish _macro-name _args))
    (ResultMacroCompatCall.Ok expanded)))

(define (macro-core-fast-profile-result
  [macro-name : String]
  [args : AstExprList]
  [result : ResultMacroCompatCall]) : ResultMacroCompatCall
  (match result
    [(ResultMacroCompatCall.Ok expanded)
      (macro-core-fast-profile-ok macro-name args expanded)]
    [(ResultMacroCompatCall.Err diag) (ResultMacroCompatCall.Err diag)]
    [(ResultMacroCompatCall.No) (ResultMacroCompatCall.No)]))

(define (macro-core-fast-expand
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [macro-name : String]
  [definition-module : String]
  [params : AstMacroParamList]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]) : ResultMacroCompatCall
  (cond
    [(macro-array-fast-path? macro-name definition-module)
      (macro-array-fast-expand
        ctx
        type-env
        decls
        macro-name
        args
        depth
        call-expr)]
    [(macro-str-cat-fast-path? macro-name definition-module)
      (match (macro-expand-exprs ctx type-env decls depth args)
        [(ResultMacroExprList.Ok expanded-args)
          (begin
            (tc-context-capture-active-pools! ctx)
            (match (macro-bind-params
              ctx
              decls
              definition-module
              type-env
              params
              expanded-args
              (tc-ctfe-env ctx)
              (tc-string-list-contains
                macro-expand-expr-type-macro-names
                macro-name)
              call-expr)
              [(ResultMacroEnv.Ok _)
                (macro-core-fast-profile-ok
                  macro-name
                  expanded-args
                  (macro-str-cat-fast-expand definition-module expanded-args))]
              [(ResultMacroEnv.Err diag) (ResultMacroCompatCall.Err diag)]))]
        [(ResultMacroExprList.Err diag) (ResultMacroCompatCall.Err diag)])]
    [(macro-core-prelude-module? definition-module)
      (let
        [base : String (macro-core-fast-path-base macro-name)]
        (if (macro-core-fast-path-base-known? base)
          (match (macro-expand-exprs ctx type-env decls depth args)
            [(ResultMacroExprList.Ok expanded-args)
              (begin
                (tc-context-capture-active-pools! ctx)
                (match (macro-bind-params
                  ctx
                  decls
                  definition-module
                  type-env
                  params
                  expanded-args
                  (tc-ctfe-env ctx)
                  (tc-string-list-contains
                    macro-expand-expr-type-macro-names
                    macro-name)
                  call-expr)
                  [(ResultMacroEnv.Ok _)
                    (cond
                      [(string.eq base "and")
                        (macro-core-fast-profile-ok
                          macro-name
                          expanded-args
                          (macro-core-fast-and expanded-args))]
                      [(string.eq base "or")
                        (macro-core-fast-profile-ok
                          macro-name
                          expanded-args
                          (macro-core-fast-or expanded-args))]
                      [(string.eq base "when")
                        (macro-core-fast-profile-result
                          macro-name
                          expanded-args
                          (macro-core-fast-guard expanded-args false call-expr))]
                      [(string.eq base "unless")
                        (macro-core-fast-profile-result
                          macro-name
                          expanded-args
                          (macro-core-fast-guard expanded-args true call-expr))]
                      [else
                        (macro-core-fast-profile-result
                          macro-name
                          expanded-args
                          (macro-core-fast-cond-call expanded-args))])]
                  [(ResultMacroEnv.Err diag) (ResultMacroCompatCall.Err diag)]))]
            [(ResultMacroExprList.Err diag) (ResultMacroCompatCall.Err diag)])
          (ResultMacroCompatCall.No)))]
    [else (ResultMacroCompatCall.No)]))

;; Run an expression-position macro transformer via CTFE and re-expand its
;; produced form to a fixpoint.
(define (macro-expand-call
  [ctx : TcContext]
  [type-env : TcTypeEnv]
  [decls : AstDeclList]
  [macro-name : String]
  [definition-module : String]
  [params : AstMacroParamList]
  [ret : AstType]
  [body : AstExpr]
  [args : AstExprList]
  [depth : i64]
  [call-expr : AstExpr]) : ResultMacroExpr
  (if (tc-macro-result-module? ret)
    (ResultMacroExpr.Err
      (box
        (ctfe-diagnostic-at-expr
          call-expr
          "typecheck: Module macro can only be used in import position")))
    (if (tc-macro-result-decls? ret)
      (ResultMacroExpr.Err
        (box
          (ctfe-diagnostic-at-expr
            call-expr
            "typecheck: Decls macro can only be used at module scope")))
      (match (macro-core-fast-expand
        ctx
        type-env
        decls
        macro-name
        definition-module
        params
        args
        depth
        call-expr)
        [(ResultMacroCompatCall.Ok expanded) (ResultMacroExpr.Ok expanded)]
        [(ResultMacroCompatCall.Err diag) (ResultMacroExpr.Err diag)]
        [(ResultMacroCompatCall.No)
          (match (macro-eval-transformer
            ctx
            type-env
            decls
            definition-module
            macro-name
            params
            body
            args
            depth
            call-expr)
            [(ResultMacroValue.Ok value)
              (match value
                [(CompilerCtfeValue.Expr expanded produced)
                  (if (tc-macro-produced-type-compatible? ctx ret produced)
                    (macro-expand-expr
                      ctx
                      type-env
                      decls
                      (+ depth 1)
                      (ast-node-get
                        (macro-hygiene-expr
                          (ast-node-get expanded)
                          MacroHygieneEnv.Nil
                          (macro-hygiene-context-macro-name
                            macro-name
                            definition-module)
                          (+ depth 1))))
                    (ResultMacroExpr.Err
                      (box
                        (ctfe-diagnostic-at-expr
                          call-expr
                          "typecheck: macro expansion produced type does not match declaration"))))]
                [_
                  (ResultMacroExpr.Err
                    (box
                      (ctfe-diagnostic-at-expr
                        call-expr
                        "macro transformer did not produce an Expr")))])]
            [(ResultMacroValue.Err diag) (ResultMacroExpr.Err diag)])]))))

(define (macro-expand-exprs
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [exprs : AstExprList]) : ResultMacroExprList
  (let
    [out : AstExprList (ast-expr-list-with-capacity (struct-get (& exprs) len))]
    (match (macro-expand-exprs-into ctx env decls depth (& exprs) 0 (&mut out))
      [(ResultMacroCheck.Ok) (ResultMacroExprList.Ok out)]
      [(ResultMacroCheck.Err diag) (ResultMacroExprList.Err diag)])))

(define (macro-expand-exprs-into
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [exprs : (& exprs AstExprList)]
  [index : i64]
  [out : (&mut out AstExprList)]) : ResultMacroCheck
  (if (>= index (struct-get exprs len))
    (ResultMacroCheck.Ok)
    (let
      [head : AstExpr (ast-node-get (ast-expr-list-get exprs index 0))]
      (match (macro-expand-expr ctx env decls depth head)
        [(ResultMacroExpr.Ok nhead)
          (begin
            (ast-expr-list-push out nhead)
            (macro-expand-exprs-into ctx env decls depth exprs (+ index 1) out))]
        [(ResultMacroExpr.Err diag) (ResultMacroCheck.Err diag)]))))

(define (macro-expand-arms
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [scrut-ty : AstType]
  [arms : AstMatchArmList]) : ResultMacroArms
  (let
    [out : AstMatchArmList
      (ast-match-arm-list-with-capacity (struct-get (& arms) len))]
    (match (macro-expand-arms-into
      ctx
      env
      decls
      depth
      scrut-ty
      (& arms)
      0
      (&mut out))
      [(ResultMacroCheck.Ok) (ResultMacroArms.Ok out)]
      [(ResultMacroCheck.Err diag) (ResultMacroArms.Err diag)])))

(define (macro-expand-arms-into
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [scrut-ty : AstType]
  [arms : (& arms AstMatchArmList)]
  [index : i64]
  [out : (&mut out AstMatchArmList)]) : ResultMacroCheck
  (if (>= index (struct-get arms len))
    (ResultMacroCheck.Ok)
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body-box)
        (let
          [body : AstExpr (ast-node-get body-box)]
          (match (tc-bind-match-pattern ctx env scrut-ty pattern)
            [(ResultTcEnv.Ok arm-env)
              (match (macro-expand-expr ctx arm-env decls depth body)
                [(ResultMacroExpr.Ok nbody)
                  (begin
                    (ast-match-arm-list-push out (ast-match-arm pattern nbody))
                    (macro-expand-arms-into
                      ctx
                      env
                      decls
                      depth
                      scrut-ty
                      arms
                      (+ index 1)
                      out))]
                [(ResultMacroExpr.Err diag) (ResultMacroCheck.Err diag)])]
            [(ResultTcEnv.Err message)
              (ResultMacroCheck.Err (box (tc-expr-diag body message)))]))])))

(define (macro-expand-bindings
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [bindings : AstLetBindingList]) : ResultMacroLetBindings
  (let
    [out : AstLetBindingList
      (ast-let-binding-list-with-capacity
        (ast-let-binding-list-len (& bindings)))]
    (match (macro-expand-bindings-into
      ctx
      env
      decls
      depth
      (& bindings)
      0
      (&mut out))
      [(ResultMacroLetBindingsBuild.Ok final-env)
        (ResultMacroLetBindings.Ok out final-env)]
      [(ResultMacroLetBindingsBuild.Err diag) (ResultMacroLetBindings.Err diag)])))

(define (macro-expand-bindings-into
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [bindings : (& bindings AstLetBindingList)]
  [index : i64]
  [out : (&mut out AstLetBindingList)]) : ResultMacroLetBindingsBuild
  (if (>= index (ast-let-binding-list-len bindings))
    (ResultMacroLetBindingsBuild.Ok env)
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : AstExpr (ast-node-get init-box)]
          (match (macro-expand-expr ctx env decls depth init)
            [(ResultMacroExpr.Ok ninit)
              (match (tc-let-bindings
                ctx
                env
                (ast-let-binding-cons
                  (ast-let-binding-id name maybe-ty ninit)
                  (ast-let-binding-list-new)))
                [(ResultTcEnv.Ok next-env)
                  (begin
                    (ast-let-binding-list-push
                      out
                      (ast-let-binding-id name maybe-ty ninit))
                    (macro-expand-bindings-into
                      ctx
                      next-env
                      decls
                      depth
                      bindings
                      (+ index 1)
                      out))]
                [(ResultTcEnv.Err message)
                  (ResultMacroLetBindingsBuild.Err
                    (box (tc-expr-diag (ast-node-get ninit) message)))])]
            [(ResultMacroExpr.Err diag) (ResultMacroLetBindingsBuild.Err diag)]))])))

(define (macro-compat-unit-expr) : i64
  (ast-node-push (AstExpr.Literal AstLiteral.Unit)))

(define (macro-compat-append-unit [exprs : AstExprList]) : AstExprList
  (let
    [out : AstExprList
      (ast-expr-list-with-capacity (+ (struct-get (& exprs) len) 1))]
    (begin
      (ast-expr-list-append-from (&mut out) (& exprs) 0)
      (ast-expr-list-push (&mut out) (macro-compat-unit-expr))
      out)))

(define (macro-compat-call-name [func : AstExpr]) : TcMaybeString
  (match (ast-expr-unspan func)
    [(AstExpr.Var name) (TcMaybeString.Some (intern-str name))]
    [_ (TcMaybeString.No)]))

(define (macro-compat-guard-message [name : String]) : String
  (if (string.eq name "unless")
    "parse: unless expects a condition and at least one body expression"
    "parse: when expects a condition and at least one body expression"))

(define (macro-expand-compat-guard-body
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [cond : AstExpr]
  [body : AstExprList]
  [is-unless : bool]) : ResultMacroCompatCall
  (match (macro-expand-expr ctx env decls depth cond)
    [(ResultMacroExpr.Ok ncond)
      (match (macro-expand-exprs ctx env decls depth body)
        [(ResultMacroExprList.Ok nbody)
          (let
            [unit-expr : i64 (macro-compat-unit-expr)]
            [body-expr : i64
              (ast-node-push (AstExpr.Begin (macro-compat-append-unit nbody)))]
            (if is-unless
              (ResultMacroCompatCall.Ok (ast-expr-if ncond unit-expr body-expr))
              (ResultMacroCompatCall.Ok (ast-expr-if ncond body-expr unit-expr))))]
        [(ResultMacroExprList.Err diag) (ResultMacroCompatCall.Err diag)])]
    [(ResultMacroExpr.Err diag) (ResultMacroCompatCall.Err diag)]))

(define (macro-expand-compat-guard-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [name : String]
  [args : AstExprList]
  [is-unless : bool]
  [call-expr : AstExpr]) : ResultMacroCompatCall
  (if (< (struct-get (& args) len) 2)
    (ResultMacroCompatCall.Err
      (box
        (ctfe-diagnostic-at-expr call-expr (macro-compat-guard-message name))))
    (macro-expand-compat-guard-body
      ctx
      env
      decls
      depth
      (ast-node-get (ast-expr-list-get (& args) 0 0))
      (ast-expr-list-tail-from-ref (& args) 1)
      is-unless)))

(define (macro-expand-compat-call
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [func : AstExpr]
  [args : AstExprList]
  [call-expr : AstExpr]) : ResultMacroCompatCall
  (match (macro-compat-call-name func)
    [(TcMaybeString.Some name)
      (if (string.eq name "when")
        (macro-expand-compat-guard-call
          ctx
          env
          decls
          depth
          name
          args
          false
          call-expr)
        (if (string.eq name "unless")
          (macro-expand-compat-guard-call
            ctx
            env
            decls
            depth
            name
            args
            true
            call-expr)
          (ResultMacroCompatCall.No)))]
    [(TcMaybeString.No) (ResultMacroCompatCall.No)]))

(define (macro-expand-expr
  [ctx : TcContext]
  [env : TcTypeEnv]
  [decls : AstDeclList]
  [depth : i64]
  [expr : AstExpr]) : ResultMacroExpr
  (if (< (macro-expand-depth-limit) depth)
    (ResultMacroExpr.Err
      (box
        (ctfe-diagnostic-at-expr expr "macro expansion exceeded depth limit")))
    (match expr
      [(AstExpr.Spanned inner-box span)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-spanned ninner span))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Call func-box args)
        (let
          [func : AstExpr (ast-node-get func-box)]
          (if (macro-call-callee-maybe-macro? func)
            (match (macro-call-decl ctx func decls expr)
              [(ResultMacroCallDecl.Ok maybe-decl)
                (match maybe-decl
                  [(MacroMaybeDecl.Some
                      macro-name
                      definition-module
                      params
                      ret
                      body)
                    (macro-expand-call
                      ctx
                      env
                      decls
                      macro-name
                      definition-module
                      params
                      ret
                      body
                      args
                      depth
                      expr)]
                  [(MacroMaybeDecl.No)
                    (match (macro-expand-compat-call
                      ctx
                      env
                      decls
                      depth
                      func
                      args
                      expr)
                      [(ResultMacroCompatCall.Ok expanded)
                        (ResultMacroExpr.Ok expanded)]
                      [(ResultMacroCompatCall.No)
                        (match (macro-expand-expr ctx env decls depth func)
                          [(ResultMacroExpr.Ok nfunc)
                            (match (macro-expand-exprs ctx env decls depth args)
                              [(ResultMacroExprList.Ok nargs)
                                (ResultMacroExpr.Ok (ast-expr-call nfunc nargs))]
                              [(ResultMacroExprList.Err diag)
                                (ResultMacroExpr.Err diag)])]
                          [(ResultMacroExpr.Err diag)
                            (ResultMacroExpr.Err diag)])]
                      [(ResultMacroCompatCall.Err diag)
                        (ResultMacroExpr.Err diag)])])]
              [(ResultMacroCallDecl.Err diag) (ResultMacroExpr.Err diag)])
            (match (macro-expand-expr ctx env decls depth func)
              [(ResultMacroExpr.Ok nfunc)
                (match (macro-expand-exprs ctx env decls depth args)
                  [(ResultMacroExprList.Ok nargs)
                    (ResultMacroExpr.Ok (ast-expr-call nfunc nargs))]
                  [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
              [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])))]
      [(AstExpr.BracketClause items)
        (match (macro-expand-exprs ctx env decls depth items)
          [(ResultMacroExprList.Ok nitems)
            (ResultMacroExpr.Ok (ast-expr-bracket-clause nitems))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [(AstExpr.Binary op left-box right-box)
        (let
          [left : AstExpr (ast-node-get left-box)]
          [right : AstExpr (ast-node-get right-box)]
          (match (macro-expand-expr ctx env decls depth left)
            [(ResultMacroExpr.Ok nleft)
              (match (macro-expand-expr ctx env decls depth right)
                [(ResultMacroExpr.Ok nright)
                  (ResultMacroExpr.Ok (ast-expr-binary op nleft nright))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Unary op inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-unary op ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.If cond-box then-branch-box else-branch-box)
        (let
          [cond : AstExpr (ast-node-get cond-box)]
          [then-branch : AstExpr (ast-node-get then-branch-box)]
          [else-branch : AstExpr (ast-node-get else-branch-box)]
          (match (macro-expand-expr ctx env decls depth cond)
            [(ResultMacroExpr.Ok ncond)
              (match (macro-expand-expr ctx env decls depth then-branch)
                [(ResultMacroExpr.Ok nthen)
                  (match (macro-expand-expr ctx env decls depth else-branch)
                    [(ResultMacroExpr.Ok nelse)
                      (ResultMacroExpr.Ok (ast-expr-if ncond nthen nelse))]
                    [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Let let-box)
        (match (box-get let-box)
          [(AstLet.Let bindings body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (match (macro-expand-bindings ctx env decls depth bindings)
                [(ResultMacroLetBindings.Ok nbindings body-env)
                  (match (macro-expand-expr ctx body-env decls depth body)
                    [(ResultMacroExpr.Ok nbody)
                      (ResultMacroExpr.Ok (ast-expr-let nbindings nbody))]
                    [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
                [(ResultMacroLetBindings.Err diag) (ResultMacroExpr.Err diag)]))])]
      [(AstExpr.Begin exprs)
        (match (macro-expand-exprs ctx env decls depth exprs)
          [(ResultMacroExprList.Ok nexprs)
            (ResultMacroExpr.Ok (ast-node-push (AstExpr.Begin nexprs)))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [(AstExpr.Unsafe exprs)
        ;; Expansion typechecks some sub-expressions (e.g. `match` scrutinees) via
        ;; `tc-expr`; descend with the unsafe marker set so those checks see the
        ;; enclosing `unsafe` context, matching the real typecheck pass. Without
        ;; this, an `unsafe`-only primitive under an `(unsafe ...)` reachable here
        ;; is wrongly rejected once the program defines a macro.
        (match (macro-expand-exprs ctx (tc-enter-unsafe env) decls depth exprs)
          [(ResultMacroExprList.Ok nexprs)
            (ResultMacroExpr.Ok (ast-node-push (AstExpr.Unsafe nexprs)))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [(AstExpr.Tuple exprs)
        (match (macro-expand-exprs ctx env decls depth exprs)
          [(ResultMacroExprList.Ok nexprs)
            (ResultMacroExpr.Ok (ast-node-push (AstExpr.Tuple nexprs)))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [(AstExpr.Array exprs)
        (match (macro-expand-exprs ctx env decls depth exprs)
          [(ResultMacroExprList.Ok nexprs)
            (ResultMacroExpr.Ok (ast-node-push (AstExpr.Array nexprs)))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [(AstExpr.Match match-box)
        (match (box-get match-box)
          [(AstMatch.Match scrut-box arms)
            (let
              [scrut : AstExpr (ast-node-get scrut-box)]
              (match (macro-expand-expr ctx env decls depth scrut)
                [(ResultMacroExpr.Ok nscrut)
                  (match (tc-expr ctx env (ast-node-get nscrut))
                    [(ResultTcType.Ok scrut-ty)
                      (match (macro-expand-arms
                        ctx
                        env
                        decls
                        depth
                        scrut-ty
                        arms)
                        [(ResultMacroArms.Ok narms)
                          (ResultMacroExpr.Ok (ast-expr-match nscrut narms))]
                        [(ResultMacroArms.Err diag) (ResultMacroExpr.Err diag)])]
                    [(ResultTcType.Err message)
                      (ResultMacroExpr.Err
                        (box (tc-expr-diag (ast-node-get nscrut) message)))])]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))])]
      [(AstExpr.While cond-box body-box)
        (let
          [cond : AstExpr (ast-node-get cond-box)]
          [body : AstExpr (ast-node-get body-box)]
          (match (macro-expand-expr ctx env decls depth cond)
            [(ResultMacroExpr.Ok ncond)
              (match (macro-expand-expr ctx env decls depth body)
                [(ResultMacroExpr.Ok nbody)
                  (ResultMacroExpr.Ok (ast-expr-while ncond nbody))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Foreach fe-box)
        (match (box-get fe-box)
          [(AstForeach.Foreach index index-ty start-box end-box body-box)
            (let
              [start : AstExpr (ast-node-get start-box)]
              [end : AstExpr (ast-node-get end-box)]
              [body : AstExpr (ast-node-get body-box)]
              (match (macro-expand-expr ctx env decls depth start)
                [(ResultMacroExpr.Ok nstart)
                  (match (macro-expand-expr ctx env decls depth end)
                    [(ResultMacroExpr.Ok nend)
                      (match (macro-expand-expr
                        ctx
                        (tc-bind-id env index (tc-resolve-type ctx index-ty))
                        decls
                        depth
                        body)
                        [(ResultMacroExpr.Ok nbody)
                          (ResultMacroExpr.Ok
                            (ast-expr-foreach-id
                              index
                              index-ty
                              nstart
                              nend
                              nbody))]
                        [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
                    [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))])]
      [(AstExpr.Lambda lambda-box)
        (match (box-get lambda-box)
          [(AstLambda.Lambda params maybe-ret body-box)
            (let
              [body : AstExpr (ast-node-get body-box)]
              (match (macro-expand-expr
                ctx
                (match maybe-ret
                  [(AstMaybeType.Some ret)
                    (tc-bind-return-type
                      (tc-bind-params ctx env params)
                      (tc-resolve-type ctx ret))]
                  [(AstMaybeType.No)
                    (tc-bind-return-type
                      (tc-bind-params ctx env params)
                      (AstType.Never))])
                decls
                depth
                body)
                [(ResultMacroExpr.Ok nbody)
                  (ResultMacroExpr.Ok (ast-expr-lambda params maybe-ret nbody))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))])]
      [(AstExpr.Ann inner-box ty)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-ann ninner ty))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Cast inner-box ty)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-cast ninner ty))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Borrow mutable lifetime place-box)
        (let
          [place : AstExpr (ast-node-get place-box)]
          (match (macro-expand-expr ctx env decls depth place)
            [(ResultMacroExpr.Ok nplace)
              (ResultMacroExpr.Ok (ast-expr-borrow mutable lifetime nplace))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.StructGet inner-box field)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-struct-get-id ninner field))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.StructSet inner-box field value-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          [value : AstExpr (ast-node-get value-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (match (macro-expand-expr ctx env decls depth value)
                [(ResultMacroExpr.Ok nvalue)
                  (ResultMacroExpr.Ok
                    (ast-expr-struct-set-id ninner field nvalue))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.WithRegion region body)
        (match (macro-expand-exprs
          ctx
          (tc-push-region env region)
          decls
          depth
          body)
          [(ResultMacroExprList.Ok nbody)
            (ResultMacroExpr.Ok
              (ast-node-push (AstExpr.WithRegion region nbody)))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [(AstExpr.WithEscape scratch-box body)
        (let
          [scratch : AstExpr (ast-node-get scratch-box)]
          (match (macro-expand-expr ctx env decls depth scratch)
            [(ResultMacroExpr.Ok nscratch)
              (match (macro-expand-exprs ctx env decls depth body)
                [(ResultMacroExprList.Ok nbody)
                  (ResultMacroExpr.Ok (ast-expr-with-escape nscratch nbody))]
                [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.WithScratch body)
        (match (macro-expand-exprs ctx env decls depth body)
          [(ResultMacroExprList.Ok nbody)
            (ResultMacroExpr.Ok (ast-expr-with-scratch nbody))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [(AstExpr.InArena arena-box body)
        (let
          [arena : AstExpr (ast-node-get arena-box)]
          (match (macro-expand-expr ctx env decls depth arena)
            [(ResultMacroExpr.Ok narena)
              (match (macro-expand-exprs ctx env decls depth body)
                [(ResultMacroExprList.Ok nbody)
                  (ResultMacroExpr.Ok (ast-expr-in-arena narena nbody))]
                [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.ArrayRef array-box index-box)
        (let
          [array : AstExpr (ast-node-get array-box)]
          [index : AstExpr (ast-node-get index-box)]
          (match (macro-expand-expr ctx env decls depth array)
            [(ResultMacroExpr.Ok narray)
              (match (macro-expand-expr ctx env decls depth index)
                [(ResultMacroExpr.Ok nindex)
                  (ResultMacroExpr.Ok (ast-expr-array-ref narray nindex))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.ArraySet array-box index-box value-box)
        (let
          [array : AstExpr (ast-node-get array-box)]
          [index : AstExpr (ast-node-get index-box)]
          [value : AstExpr (ast-node-get value-box)]
          (match (macro-expand-expr ctx env decls depth array)
            [(ResultMacroExpr.Ok narray)
              (match (macro-expand-expr ctx env decls depth index)
                [(ResultMacroExpr.Ok nindex)
                  (match (macro-expand-expr ctx env decls depth value)
                    [(ResultMacroExpr.Ok nvalue)
                      (ResultMacroExpr.Ok
                        (ast-expr-array-set narray nindex nvalue))]
                    [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Box inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-box ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.BoxGet inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-box-get ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.BoxTake inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-box-take ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.BoxSet inner-box value-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          [value : AstExpr (ast-node-get value-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (match (macro-expand-expr ctx env decls depth value)
                [(ResultMacroExpr.Ok nvalue)
                  (ResultMacroExpr.Ok (ast-expr-box-set ninner nvalue))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Comptime inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-comptime ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Return inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-return ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Set name rhs-box)
        (let
          [rhs : AstExpr (ast-node-get rhs-box)]
          (match (macro-expand-expr ctx env decls depth rhs)
            [(ResultMacroExpr.Ok nrhs)
              (ResultMacroExpr.Ok (ast-expr-set-id name nrhs))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.StringData inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-string-data ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.StringFromBytes ptr-box len-box)
        (let
          [ptr : AstExpr (ast-node-get ptr-box)]
          [len : AstExpr (ast-node-get len-box)]
          (match (macro-expand-expr ctx env decls depth ptr)
            [(ResultMacroExpr.Ok nptr)
              (match (macro-expand-expr ctx env decls depth len)
                [(ResultMacroExpr.Ok nlen)
                  (ResultMacroExpr.Ok (ast-expr-string-from-bytes nptr nlen))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.ArrayData inner-box)
        (let
          [inner : AstExpr (ast-node-get inner-box)]
          (match (macro-expand-expr ctx env decls depth inner)
            [(ResultMacroExpr.Ok ninner)
              (ResultMacroExpr.Ok (ast-expr-array-data ninner))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.BinaryData bytes)
        (ResultMacroExpr.Ok (ast-node-push (AstExpr.BinaryData bytes)))]
      [(AstExpr.SpmdProgramIndex)
        (ResultMacroExpr.Ok (ast-expr-spmd-program-index))]
      [(AstExpr.SpmdProgramCount)
        (ResultMacroExpr.Ok (ast-expr-spmd-program-count))]
      [(AstExpr.CpuIdEax leaf-box subleaf-box)
        (let
          [leaf : AstExpr (ast-node-get leaf-box)]
          [subleaf : AstExpr (ast-node-get subleaf-box)]
          (match (macro-expand-expr ctx env decls depth leaf)
            [(ResultMacroExpr.Ok nleaf)
              (match (macro-expand-expr ctx env decls depth subleaf)
                [(ResultMacroExpr.Ok nsubleaf)
                  (ResultMacroExpr.Ok (ast-expr-cpuid-eax nleaf nsubleaf))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.CpuIdEbx leaf-box subleaf-box)
        (let
          [leaf : AstExpr (ast-node-get leaf-box)]
          [subleaf : AstExpr (ast-node-get subleaf-box)]
          (match (macro-expand-expr ctx env decls depth leaf)
            [(ResultMacroExpr.Ok nleaf)
              (match (macro-expand-expr ctx env decls depth subleaf)
                [(ResultMacroExpr.Ok nsubleaf)
                  (ResultMacroExpr.Ok (ast-expr-cpuid-ebx nleaf nsubleaf))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.CpuIdEcx leaf-box subleaf-box)
        (let
          [leaf : AstExpr (ast-node-get leaf-box)]
          [subleaf : AstExpr (ast-node-get subleaf-box)]
          (match (macro-expand-expr ctx env decls depth leaf)
            [(ResultMacroExpr.Ok nleaf)
              (match (macro-expand-expr ctx env decls depth subleaf)
                [(ResultMacroExpr.Ok nsubleaf)
                  (ResultMacroExpr.Ok (ast-expr-cpuid-ecx nleaf nsubleaf))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.CpuIdEdx leaf-box subleaf-box)
        (let
          [leaf : AstExpr (ast-node-get leaf-box)]
          [subleaf : AstExpr (ast-node-get subleaf-box)]
          (match (macro-expand-expr ctx env decls depth leaf)
            [(ResultMacroExpr.Ok nleaf)
              (match (macro-expand-expr ctx env decls depth subleaf)
                [(ResultMacroExpr.Ok nsubleaf)
                  (ResultMacroExpr.Ok (ast-expr-cpuid-edx nleaf nsubleaf))]
                [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)])]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Xgetbv index-box)
        (let
          [index : AstExpr (ast-node-get index-box)]
          (match (macro-expand-expr ctx env decls depth index)
            [(ResultMacroExpr.Ok nindex)
              (ResultMacroExpr.Ok (ast-expr-xgetbv nindex))]
            [(ResultMacroExpr.Err diag) (ResultMacroExpr.Err diag)]))]
      [(AstExpr.Syscall args)
        (match (macro-expand-exprs ctx env decls depth args)
          [(ResultMacroExprList.Ok nargs)
            (ResultMacroExpr.Ok (ast-expr-syscall nargs))]
          [(ResultMacroExprList.Err diag) (ResultMacroExpr.Err diag)])]
      [_ (ResultMacroExpr.Ok (ast-node-push expr))])))

(define (macro-expand-module-call-position
  [ctx : TcContext]
  [decls : AstDeclList]
  [call-id : i64]
  [import-position : bool]) : ResultMacroDecl
  (let
    [call-expr : AstExpr (ast-node-get call-id)]
    (match (ast-expr-unspan call-expr)
      [(AstExpr.Call func-box _)
        (let
          [func : AstExpr (ast-node-get func-box)]
          (match (macro-call-decl ctx func decls call-expr)
            [(ResultMacroCallDecl.Ok maybe-decl)
              (match maybe-decl
                [(MacroMaybeDecl.Some _ _ _ ret _)
                  (cond
                    [(and import-position (tc-macro-result-module? ret))
                      (ResultMacroDecl.Err
                        (box
                          (ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: Module macro expansion is not implemented yet (#3153)")))]
                    [(and import-position (tc-macro-result-decls? ret))
                      (ResultMacroDecl.Err
                        (box
                          (ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: Decls macro cannot be used in import position")))]
                    [import-position
                      (ResultMacroDecl.Err
                        (box
                          (ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: expression macro cannot be used as module import")))]
                    [(tc-macro-result-decls? ret)
                      (ResultMacroDecl.Err
                        (box
                          (ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: Decls macro expansion is not implemented yet (#3153)")))]
                    [(tc-macro-result-module? ret)
                      (ResultMacroDecl.Err
                        (box
                          (ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: Module macro can only be used in import position")))]
                    [else
                      (ResultMacroDecl.Err
                        (box
                          (ctfe-diagnostic-at-expr
                            call-expr
                            "typecheck: expression macro cannot be used at module scope")))])]
                [(MacroMaybeDecl.No)
                  (ResultMacroDecl.Err
                    (box
                      (ctfe-diagnostic-at-expr
                        call-expr
                        "typecheck: module-scope macro call must resolve to defmacro")))])]
            [(ResultMacroCallDecl.Err diag) (ResultMacroDecl.Err diag)]))]
      [_
        (ResultMacroDecl.Err
          (box
            (ctfe-diagnostic-at-expr
              call-expr
              "typecheck: module-scope macro placeholder must be a call")))])))

(define (macro-expand-decl
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [decls : AstDeclList]
  [decl : AstDecl]) : ResultMacroDecl
  (let
    [global-env : TcTypeEnv (tc-hygiene-global-env top-env)]
    (match decl
      [(AstDecl.Def name maybe-ty expr-box)
        (let
          [expr : AstExpr (ast-node-get expr-box)]
          (match (macro-expand-expr ctx global-env decls 0 expr)
            [(ResultMacroExpr.Ok nexpr)
              (ResultMacroDecl.Ok (ast-decl-def-id name maybe-ty nexpr))]
            [(ResultMacroExpr.Err diag) (ResultMacroDecl.Err diag)]))]
      [(AstDecl.DefFn name params ret body-box export)
        (let
          [body : AstExpr (ast-node-get body-box)]
          (match (macro-expand-expr
            ctx
            (tc-bind-return-type
              (tc-bind-params ctx global-env params)
              (tc-resolve-type ctx ret))
            decls
            0
            body)
            [(ResultMacroExpr.Ok nbody)
              (ResultMacroDecl.Ok
                (ast-decl-def-fn-export-id name params ret nbody export))]
            [(ResultMacroExpr.Err diag) (ResultMacroDecl.Err diag)]))]
      [(AstDecl.Test _ _ _) (ResultMacroDecl.Ok decl)]
      [(AstDecl.Import (AstImportSpec.Spec kind _ _ _ _))
        (match kind
          [(AstImportKind.Macro call-id _)
            (macro-expand-module-call-position ctx decls call-id true)]
          [(AstImportKind.MacroDecls call-id _)
            (macro-expand-module-call-position ctx decls call-id false)]
          [_ (ResultMacroDecl.Ok decl)])]
      [(AstDecl.Unsafe inner-box)
        (let
          [inner : AstDecl (box-get inner-box)]
          (match (macro-expand-decl ctx top-env decls inner)
            [(ResultMacroDecl.Ok ninner)
              (ResultMacroDecl.Ok (ast-decl-unsafe ninner))]
            [(ResultMacroDecl.Err diag) (ResultMacroDecl.Err diag)]))]
      [_ (ResultMacroDecl.Ok decl)])))

(define (macro-single-decl-expansion [decl : AstDecl] [path : String]) : ResultMacroDeclExpansion
  (ResultMacroDeclExpansion.Ok
    (ast-decl-cons decl (ast-decl-list-new))
    (ast-decl-path-cons path (ast-decl-path-list-new))))

(define (macro-env-for-module
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [module : String]) : ResultTcEnv
  (if (string.eq module "")
    (ResultTcEnv.Ok top-env)
    (tc-module-local-env ctx top-env module)))

(define (macro-module-import-marker-decls
  [target-module : String]
  [alias : AstMaybeImportAlias]
  [span : AstSourceSpan]) : AstDeclList
  (let
    [binding-alias : AstMaybeImportAlias
      (match alias
        [(AstMaybeImportAlias.No) (AstMaybeImportAlias.Some "")]
        [_ alias])]
    (ast-decl-cons
      (AstDecl.Import
        (AstImportSpec.Spec
          (AstImportKind.Module)
          target-module
          (AstMaybeModuleName.Some target-module)
          binding-alias
          span))
      (ast-decl-list-new))))

(define (macro-existing-module-import-target
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [call-id : i64]
  [context : AstMaybeModuleName]) : CompilerMaybeString
  (let
    [call-expr : AstExpr (ast-node-get call-id)]
    (match (ast-expr-unspan call-expr)
      [(AstExpr.Call func-box args)
        (let
          [func : AstExpr (ast-node-get func-box)]
          [global-env : TcTypeEnv (tc-hygiene-global-env top-env)]
          (match (macro-call-decl-with-context
            ctx
            func
            orig-decls
            module
            context
            call-expr)
            [(ResultMacroCallDeclModule.Ok maybe-decl call-module)
              (let
                [call-ctx : TcContext (tc-context-with-module ctx module)]
                (match maybe-decl
                  [(MacroMaybeDecl.Some
                      macro-name
                      definition-module
                      params
                      ret
                      _)
                    (if (tc-macro-result-module? ret)
                      (match (macro-expand-exprs
                        call-ctx
                        global-env
                        orig-decls
                        0
                        args)
                        [(ResultMacroExprList.Ok expanded-args)
                          (match (macro-module-identity
                            call-ctx
                            orig-decls
                            call-module
                            macro-name
                            definition-module
                            params
                            expanded-args
                            (tc-ctfe-env call-ctx)
                            call-expr)
                            [(ResultGenKey.Ok identity _)
                              (macro-find-generated-identity-module
                                orig-decls
                                identity)]
                            [(ResultGenKey.Err _) CompilerNoString])]
                        [(ResultMacroExprList.Err _) CompilerNoString])
                      CompilerNoString)]
                  [(MacroMaybeDecl.No) CompilerNoString]))]
            [(ResultMacroCallDeclModule.Err _) CompilerNoString]))]
      [_ CompilerNoString])))

(define (macro-collapse-existing-module-import-decl
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [decl : AstDecl]
  [decl-path : String]) : ResultMacroDeclExpansion
  (match decl
    [(AstDecl.ComptimeDecl _ template-box)
      (let
        [template : AstDecl (box-get template-box)]
        (match template
          [(AstDecl.Import (AstImportSpec.Spec kind _ _ alias span))
            (match kind
              [(AstImportKind.Macro call-id context)
                (match (macro-existing-module-import-target
                  ctx
                  top-env
                  orig-decls
                  module
                  call-id
                  context)
                  [(CompilerSomeString target-module)
                    (let
                      [expanded : AstDeclList
                        (macro-module-import-marker-decls
                          target-module
                          alias
                          span)]
                      (ResultMacroDeclExpansion.Ok
                        expanded
                        (macro-paths-for-decls expanded decl-path)))]
                  [(CompilerNoString)
                    (macro-single-decl-expansion decl decl-path)])]
              [_ (macro-single-decl-expansion decl decl-path)])]
          [_ (macro-single-decl-expansion decl decl-path)]))]
    [(AstDecl.Import (AstImportSpec.Spec kind _ _ alias span))
      (match kind
        [(AstImportKind.Macro call-id context)
          (match (macro-existing-module-import-target
            ctx
            top-env
            orig-decls
            module
            call-id
            context)
            [(CompilerSomeString target-module)
              (let
                [expanded : AstDeclList
                  (macro-module-import-marker-decls target-module alias span)]
                (ResultMacroDeclExpansion.Ok
                  expanded
                  (macro-paths-for-decls expanded decl-path)))]
            [(CompilerNoString) (macro-single-decl-expansion decl decl-path)])]
        [_ (macro-single-decl-expansion decl decl-path)])]
    [_ (macro-single-decl-expansion decl decl-path)]))

(define (macro-collapse-existing-module-imports
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [decls : AstDeclList]
  [decl-path : String]) : ResultMacroDeclExpansion
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil)
      (ResultMacroDeclExpansion.Ok (ast-decl-list-new) (ast-decl-path-list-new))]
    [(AstDeclListStep.Cons decl rest-box)
      (match (macro-collapse-existing-module-import-decl
        ctx
        top-env
        orig-decls
        module
        decl
        decl-path)
        [(ResultMacroDeclExpansion.Ok head-decls head-paths)
          (match (macro-collapse-existing-module-imports
            ctx
            top-env
            orig-decls
            module
            rest-box
            decl-path)
            [(ResultMacroDeclExpansion.Ok rest-decls rest-paths)
              (ResultMacroDeclExpansion.Ok
                (macro-decl-list-append head-decls rest-decls)
                (macro-decl-path-list-append head-paths rest-paths))]
            [(ResultMacroDeclExpansion.Err diag)
              (ResultMacroDeclExpansion.Err diag)])]
        [(ResultMacroDeclExpansion.Err diag)
          (ResultMacroDeclExpansion.Err diag)])]))

(define (macro-collapse-existing-module-imports-or-original
  [ctx : TcContext]
  [top-env : TcTypeEnv]
  [orig-decls : AstDeclList]
  [module : String]
  [decls : AstDeclList]
  [decl-path : String]) : AstDeclList
  (match (macro-collapse-existing-module-imports
    ctx
    top-env
    orig-decls
    module
    decls
    decl-path)
    [(ResultMacroDeclExpansion.Ok collapsed _) collapsed]
    [(ResultMacroDeclExpansion.Err _) decls]))

;; Alias-qualified generated collection imports only need declarations reachable
;; from the members the importer names; keep generated imports and a local
;; dependency closure so the module body remains replay-stable.
(defstruct MacroGeneratedSurfaceNameSet
  (map hashmap.StringI64Map))

(define (macro-generated-surface-name-set-empty) : MacroGeneratedSurfaceNameSet
  (MacroGeneratedSurfaceNameSet (hashmap.string-i64-map-with-capacity 16)))

(define (macro-generated-surface-name-set-map
  [set : MacroGeneratedSurfaceNameSet]) : hashmap.StringI64Map
  (struct-get set map))

(define (macro-generated-surface-name-set-len
  [set : MacroGeneratedSurfaceNameSet]) : i64
  (hashmap.string-i64-map-len (macro-generated-surface-name-set-map set)))

(define (macro-generated-surface-name-set-contains?
  [set : MacroGeneratedSurfaceNameSet]
  [name : String]) : bool
  (hashmap.string-i64-map-contains?
    (macro-generated-surface-name-set-map set)
    name))

(define (macro-generated-surface-name-set-add
  [set : MacroGeneratedSurfaceNameSet]
  [name : String]) : MacroGeneratedSurfaceNameSet
  (if (or
    (string.eq name "")
    (macro-generated-surface-name-set-contains? set name))
    set
    (MacroGeneratedSurfaceNameSet
      (hashmap.string-i64-map-put
        (macro-generated-surface-name-set-map set)
        name
        1))))

(define (macro-generated-surface-name-set-add-id
  [set : MacroGeneratedSurfaceNameSet]
  [name : i64]) : MacroGeneratedSurfaceNameSet
  (macro-generated-surface-name-set-add set (intern-str name)))

(define (macro-generated-surface-alias-add
  [aliases : MacroGeneratedSurfaceNameSet]
  [alias : AstMaybeImportAlias]) : MacroGeneratedSurfaceNameSet
  (match alias
    [(AstMaybeImportAlias.Some alias-name)
      (macro-generated-surface-name-set-add aliases alias-name)]
    [(AstMaybeImportAlias.No) aliases]))

(define (macro-generated-surface-aliases-decl
  [decl : AstDecl]
  [target-module : String]
  [aliases : MacroGeneratedSurfaceNameSet]) : MacroGeneratedSurfaceNameSet
  (match decl
    [(AstDecl.ModuleBody _ body-box)
      (macro-generated-surface-aliases-decls
        (box-get body-box)
        target-module
        aliases)]
    [(AstDecl.Import (AstImportSpec.Spec kind _ expected alias _))
      (match kind
        [(AstImportKind.Macro _ _)
          (macro-generated-surface-alias-add aliases alias)]
        [(AstImportKind.Module)
          (match expected
            [(AstMaybeModuleName.Some expected-module)
              (if (string.eq expected-module target-module)
                (macro-generated-surface-alias-add aliases alias)
                aliases)]
            [(AstMaybeModuleName.No) aliases])]
        [_ aliases])]
    [(AstDecl.Unsafe inner-box)
      (macro-generated-surface-aliases-decl
        (box-get inner-box)
        target-module
        aliases)]
    [(AstDecl.ComptimeDecl _ template-box)
      (macro-generated-surface-aliases-decl
        (box-get template-box)
        target-module
        aliases)]
    [_ aliases]))

(define (macro-generated-surface-aliases-decls
  [decls : AstDeclList]
  [target-module : String]
  [aliases : MacroGeneratedSurfaceNameSet]) : MacroGeneratedSurfaceNameSet
  (match (ast-decl-list-step decls)
    [(AstDeclListStep.Nil) aliases]
    [(AstDeclListStep.Cons decl rest)
      (macro-generated-surface-aliases-decls
        rest
        target-module
        (macro-generated-surface-aliases-decl decl target-module aliases))]))

(define (macro-generated-surface-aliases
  [orig-decls : AstDeclList]
  [target-module : String]
  [alias : AstMaybeImportAlias]) : MacroGeneratedSurfaceNameSet
  (macro-generated-surface-aliases-decls
    orig-decls
    target-module
    (macro-generated-surface-alias-add
      (macro-generated-surface-name-set-empty)
      alias)))

(define (macro-generated-surface-name-ref
  [aliases : MacroGeneratedSurfaceNameSet]
  [refs : MacroGeneratedSurfaceNameSet]
  [name : String]
  [alias-qualified? : bool]) : MacroGeneratedSurfaceNameSet
  (if alias-qualified?
    (let
      [first-dot : i64 (tc-name-first-dot name)]
      (if (> first-dot 0)
        (let
          [base-start : i64 (+ first-dot 1)]
          [qualifier : String (string.substring name 0 first-dot)]
          [base : String
            (string.substring
              name
              base-start
              (- (string.string-length name) base-start))]
          (if (macro-generated-surface-name-set-contains? aliases qualifier)
            (macro-generated-surface-name-set-add refs base)
            refs))
        (if (tc-name-qualified? name)
          (let
            [qualifier : String (tc-qualified-name-module name)]
            (if (macro-generated-surface-name-set-contains? aliases qualifier)
              (macro-generated-surface-name-set-add
                refs
                (tc-qualified-name-base name))
              refs))
          refs)))
    (if (or (tc-name-qualified? name) (>= (tc-name-first-dot name) 0))
      refs
      (macro-generated-surface-name-set-add refs name))))

(define (macro-generated-surface-name-id-ref
  [aliases : MacroGeneratedSurfaceNameSet]
  [refs : MacroGeneratedSurfaceNameSet]
  [name : i64]
  [alias-qualified? : bool]) : MacroGeneratedSurfaceNameSet
  (macro-generated-surface-name-ref
    aliases
    refs
    (intern-str name)
    alias-qualified?))

(define (macro-generated-surface-maybe-type-refs
  [maybe-ty : AstMaybeType]
  [aliases : MacroGeneratedSurfaceNameSet]
  [refs : MacroGeneratedSurfaceNameSet]
  [alias-qualified? : bool]) : MacroGeneratedSurfaceNameSet
  (match maybe-ty
    [(AstMaybeType.No) refs]
    [(AstMaybeType.Some ty)
      (macro-generated-surface-type-refs ty aliases refs alias-qualified?)]))

(define (macro-generated-surface-type-list-refs
  [types : AstTypeList]
  [aliases : MacroGeneratedSurfaceNameSet]
  [refs : MacroGeneratedSurfaceNameSet]
  [alias-qualified? : bool]) : MacroGeneratedSurfaceNameSet
  (macro-generated-surface-type-list-refs-at
    (& types)
    aliases
    refs
    alias-qualified?
    0))

(define (macro-generated-surface-type-list-refs-at
  [types : (& types AstTypeList)]
  [aliases : MacroGeneratedSurfaceNameSet]
  [refs : MacroGeneratedSurfaceNameSet]
  [alias-qualified? : bool]
  [index : i64]) : MacroGeneratedSurfaceNameSet
  (if (>= index (ast-type-list-len types))
    refs
    (macro-generated-surface-type-list-refs-at
      types
      aliases
      (macro-generated-surface-type-refs
        (ty-node-get (ast-type-list-get types index (ast-type-id-fallback)))
        aliases
        refs
        alias-qualified?)
      alias-qualified?
      (+ index 1))))

(define (macro-generated-surface-type-id-refs
  [ty : i64]
  [aliases : MacroGeneratedSurfaceNameSet]
  [refs : MacroGeneratedSurfaceNameSet]
  [alias-qualified? : bool]) : MacroGeneratedSurfaceNameSet
  (macro-generated-surface-type-refs
    (ty-node-get ty)
    aliases
    refs
    alias-qualified?))

(define (macro-generated-surface-type-refs
  [ty : AstType]
  [aliases : MacroGeneratedSurfaceNameSet]
  [refs : MacroGeneratedSurfaceNameSet]
  [alias-qualified? : bool]) : MacroGeneratedSurfaceNameSet
  (match ty
    [(AstType.I64) refs]
    [(AstType.I32) refs]
    [(AstType.I16) refs]
    [(AstType.I8) refs]
    [(AstType.U64) refs]
    [(AstType.U32) refs]
    [(AstType.U16) refs]
    [(AstType.U8) refs]
    [(AstType.F64) refs]
    [(AstType.F32) refs]
    [(AstType.Bool) refs]
    [(AstType.Char) refs]
    [(AstType.String) refs]
    [(AstType.Str) refs]
    [(AstType.Bytes) refs]
    [(AstType.Unit) refs]
    [(AstType.Never) refs]
    [(AstType.Expr) refs]
    [(AstType.ExprList) refs]
    [(AstType.Func args ret)
      (macro-generated-surface-type-id-refs
        ret
        aliases
        (macro-generated-surface-type-list-refs
          (box-get args)
          aliases
          refs
          alias-qualified?)
        alias-qualified?)]
    [(AstType.Tuple items)
      (macro-generated-surface-type-list-refs
        (box-get items)
        aliases
        refs
        alias-qualified?)]
    [(AstType.Array elem _)
      (macro-generated-surface-type-id-refs elem aliases refs alias-qualified?)]
    [(AstType.DynArray elem)
      (macro-generated-surface-type-id-refs elem aliases refs alias-qualified?)]
    [(AstType.Box elem)
      (macro-generated-surface-type-id-refs elem aliases refs alias-qualified?)]
    [(AstType.Region _ inner)
      (macro-generated-surface-type-id-refs inner aliases refs alias-qualified?)]
    [(AstType.Ref _ inner)
      (macro-generated-surface-type-id-refs inner aliases refs alias-qualified?)]
    [(AstType.MutRef _ inner)
      (macro-generated-surface-type-id-refs inner aliases refs alias-qualified?)]
    [(AstType.Enum name)
      (macro-generated-surface-name-id-ref aliases refs name alias-qualified?)]
    [(AstType.EnumArgs name _)
      (macro-generated-surface-name-id-ref aliases refs name alias-qualified?)]
    [(AstType.Struct name)
      (macro-generated-surface-name-id-ref aliases refs name alias-qualified?)]
    [(AstType.StructArgs name _)
      (macro-generated-surface-name-id-ref aliases refs name alias-qualified?)]
    [(AstType.Var name)
      (macro-generated-surface-name-id-ref aliases refs name alias-qualified?)]
    [(AstType.VarArgs name _)
      (macro-generated-surface-name-id-ref aliases refs name alias-qualified?)]
    [(AstType.Ptr inner)
      (macro-generated-surface-type-id-refs inner aliases refs alias-qualified?)]
    [(AstType.MutPtr inner)
      (macro-generated-surface-type-id-refs inner aliases refs alias-qualified?)]))

(define (macro-generated-surface-param-list-refs
  [params : AstParamList]
  [aliases : MacroGeneratedSurfaceNameSet]
  [refs : MacroGeneratedSurfaceNameSet]
  [alias-qualified? : bool]) : MacroGeneratedSurfaceNameSet
  (macro-generated-surface-param-list-refs-at
    (& params)
    aliases
    refs
    alias-qualified?
    0))

(define (macro-generated-surface-param-list-refs-at
  [params : (& params AstParamList)]
  [aliases : MacroGeneratedSurfaceNameSet]
  [refs : MacroGeneratedSurfaceNameSet]
  [alias-qualified? : bool]
  [index : i64]) : MacroGeneratedSurfaceNameSet
  (if (>= index (ast-param-list-len params))
    refs
    (match (ast-param-list-get params index (ast-param-fallback))
      [(AstParam.Param _ ty _)
        (macro-generated-surface-param-list-refs-at
          params
          aliases
          (macro-generated-surface-type-refs ty aliases refs alias-qualified?)
          alias-qualified?
          (+ index 1))])))

(define (macro-generated-surface-macro-param-list-refs
  [params : AstMacroParamList]
  [aliases : MacroGeneratedSurfaceNameSet]
  [refs : MacroGeneratedSurfaceNameSet]
  [alias-qualified? : bool]) : MacroGeneratedSurfaceNameSet
  (macro-generated-surface-macro-param-list-refs-at
    (& params)
    aliases
    refs
    alias-qualified?
    0))

(define (macro-generated-surface-macro-param-list-refs-at
  [params : (& params AstMacroParamList)]
  [aliases : MacroGeneratedSurfaceNameSet]
  [refs : MacroGeneratedSurfaceNameSet]
  [alias-qualified? : bool]
  [index : i64]) : MacroGeneratedSurfaceNameSet
  (if (>= index (ast-macro-param-list-len params))
    refs
    (match (ast-macro-param-list-get params index (ast-macro-param-fallback))
      [(AstMacroParam.Param _ ty _)
        (macro-generated-surface-macro-param-list-refs-at
          params
          aliases
          (macro-generated-surface-type-refs ty aliases refs alias-qualified?)
          alias-qualified?
          (+ index 1))])))

(define (macro-generated-surface-pattern-list-refs
  [patterns : AstPatternList]
  [aliases : MacroGeneratedSurfaceNameSet]
  [refs : MacroGeneratedSurfaceNameSet]
  [alias-qualified? : bool]) : MacroGeneratedSurfaceNameSet
  (macro-generated-surface-pattern-list-refs-at
    (& patterns)
    aliases
    refs
    alias-qualified?
    0))

(define (macro-generated-surface-pattern-list-refs-at
  [patterns : (& patterns AstPatternList)]
  [aliases : MacroGeneratedSurfaceNameSet]
  [refs : MacroGeneratedSurfaceNameSet]
  [alias-qualified? : bool]
  [index : i64]) : MacroGeneratedSurfaceNameSet
  (if (>= index (struct-get patterns len))
    refs
    (macro-generated-surface-pattern-list-refs-at
      patterns
      aliases
      (macro-generated-surface-pattern-refs
        (ast-pattern-list-get patterns index (ast-pattern-fallback))
        aliases
        refs
        alias-qualified?)
      alias-qualified?
      (+ index 1))))

(define (macro-generated-surface-pattern-refs
  [pattern : AstPattern]
  [aliases : MacroGeneratedSurfaceNameSet]
  [refs : MacroGeneratedSurfaceNameSet]
  [alias-qualified? : bool]) : MacroGeneratedSurfaceNameSet
  (match pattern
    [(AstPattern.Var _ maybe-ty)
      (macro-generated-surface-maybe-type-refs
        maybe-ty
        aliases
        refs
        alias-qualified?)]
    [(AstPattern.Tuple items)
      (macro-generated-surface-pattern-list-refs
        (box-get items)
        aliases
        refs
        alias-qualified?)]
    [(AstPattern.Wildcard) refs]
    [(AstPattern.Binding _) refs]
    [(AstPattern.Variant name items)
      (macro-generated-surface-pattern-list-refs
        (box-get items)
        aliases
        (macro-generated-surface-name-id-ref aliases refs name alias-qualified?)
        alias-qualified?)]
    [(AstPattern.Literal _) refs]))

(define (macro-generated-surface-expr-list-refs
  [exprs : AstExprList]
  [aliases : MacroGeneratedSurfaceNameSet]
  [refs : MacroGeneratedSurfaceNameSet]
  [alias-qualified? : bool]) : MacroGeneratedSurfaceNameSet
  (macro-generated-surface-expr-list-refs-at
    (& exprs)
    aliases
    refs
    alias-qualified?
    0))

(define (macro-generated-surface-expr-list-refs-at
  [exprs : (& exprs AstExprList)]
  [aliases : MacroGeneratedSurfaceNameSet]
  [refs : MacroGeneratedSurfaceNameSet]
  [alias-qualified? : bool]
  [index : i64]) : MacroGeneratedSurfaceNameSet
  (if (>= index (struct-get exprs len))
    refs
    (macro-generated-surface-expr-list-refs-at
      exprs
      aliases
      (macro-generated-surface-expr-refs
        (ast-node-get (ast-expr-list-get exprs index 0))
        aliases
        refs
        alias-qualified?)
      alias-qualified?
      (+ index 1))))

(define (macro-generated-surface-let-binding-refs
  [bindings : AstLetBindingList]
  [aliases : MacroGeneratedSurfaceNameSet]
  [refs : MacroGeneratedSurfaceNameSet]
  [alias-qualified? : bool]) : MacroGeneratedSurfaceNameSet
  (macro-generated-surface-let-binding-refs-at
    (& bindings)
    aliases
    refs
    alias-qualified?
    0))

(define (macro-generated-surface-let-binding-refs-at
  [bindings : (& bindings AstLetBindingList)]
  [aliases : MacroGeneratedSurfaceNameSet]
  [refs : MacroGeneratedSurfaceNameSet]
  [alias-qualified? : bool]
  [index : i64]) : MacroGeneratedSurfaceNameSet
  (if (>= index (ast-let-binding-list-len bindings))
    refs
    (match (ast-let-binding-list-get bindings index (ast-let-binding-fallback))
      [(AstLetBinding.Binding _ maybe-ty init)
        (macro-generated-surface-let-binding-refs-at
          bindings
          aliases
          (macro-generated-surface-expr-refs
            (ast-node-get init)
            aliases
            (macro-generated-surface-maybe-type-refs
              maybe-ty
              aliases
              refs
              alias-qualified?)
            alias-qualified?)
          alias-qualified?
          (+ index 1))])))

(define (macro-generated-surface-match-arm-refs
  [arms : AstMatchArmList]
  [aliases : MacroGeneratedSurfaceNameSet]
  [refs : MacroGeneratedSurfaceNameSet]
  [alias-qualified? : bool]) : MacroGeneratedSurfaceNameSet
  (macro-generated-surface-match-arm-refs-at
    (& arms)
    aliases
    refs
    alias-qualified?
    0))

(define (macro-generated-surface-match-arm-refs-at
  [arms : (& arms AstMatchArmList)]
  [aliases : MacroGeneratedSurfaceNameSet]
  [refs : MacroGeneratedSurfaceNameSet]
  [alias-qualified? : bool]
  [index : i64]) : MacroGeneratedSurfaceNameSet
  (if (>= index (struct-get arms len))
    refs
    (match (ast-match-arm-list-get arms index (ast-match-arm-fallback))
      [(AstMatchArm.Arm pattern body)
        (macro-generated-surface-match-arm-refs-at
          arms
          aliases
          (macro-generated-surface-expr-refs
            (ast-node-get body)
            aliases
