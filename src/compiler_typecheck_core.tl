  (len i64)
  (owner-arena i64))

;; Persistent scoped strings use an allocation-free singleton and then an
;; append-only dense node store. A list snapshot is only a stable store handle,
;; tail index, and length; appending a sibling never rewrites either branch.
(defenum TcStringList
  (Nil)
  (One String)
  (Dense i64 i64 i64))

(defstruct TcNameIdListNode
  (value i64)
  (parent i64))

(defstruct TcNameIdListStoreData
  (nodes (__tl_dyn-array TcNameIdListNode))
  (len i64)
  (owner-arena i64))

;; Name-id sets, stacks, and ordered paths share the same persistent dense
;; spine representation as strings. Membership policy stays with each caller;
;; `tc-name-id-list-cons` preserves duplicates while `-add` deduplicates.
(defenum TcNameIdList
  (Nil)
  (One i64)
  (Dense i64 i64 i64))

;; Lazy import aliases and their summary-use counters are mutable, intern-owned
;; typecheck state. Keep one lazily allocated table per compiler job so a reset
;; or lookup in one job cannot observe or clear another job's aliases.
(defstruct TcLazyImportStateData
  (owner-arena i64)
  (module-ids (__tl_dyn-array i64))
  (alias-ids (__tl_dyn-array i64))
  (target-ids (__tl_dyn-array i64))
  (summary-backed (__tl_dyn-array bool))
  (index-slots (__tl_dyn-array i64))
  (record-count i64)
  (intern-table-id i64)
  (intern-generation i64)
  (summary-backed-count i64)
  (summary-macro-force-count i64))

(defstruct TcLazyImportState
  (address i64))

