        (tc-ref-closure-local-uses-ok? expr-bases str name bound))]
    [(ast.AstExpr.StringFromBytes ptr-box len-box)
      (let
        [ptr : ast.AstExpr (ast.ast-expr-segment-bases-get expr-bases ptr-box)]
