(cfg
  compile-profile
  (define (compiler-tc-reinfer-profile-effective-arg-expr
    [site : String]
    [ctx : TcContext]
    [env : TcTypeEnv]
    [arg : AstExpr]
    [want : AstType]) : ResultTcExpr
    (let
      [start-ms : i64 (profile.now-ms)]
