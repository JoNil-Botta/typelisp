(define (tc-expr-diag [expr : ast.AstExpr] [message : String]) : cdiag.CompilerDiagnostic
  (cond
    [(tc-macro-framed-error? message) (tc-macro-framed-error-diag message)]
    [(tc-rich-error? message) (tc-rich-error-diag message)]
    [(tc-located-error? message) (tc-located-error-diag message)]
    [else
      (match (tc-macro-framed-error-from-root expr message)
        [(TcMaybeString.Some framed) (tc-macro-framed-error-diag framed)]
        [(TcMaybeString.No)
          (match (tc-expr-maybe-span expr)
            [(TcMaybeAstSourceSpan.Some span)
              (tc-canonical-diagnostic
                (cdiag.compiler-diagnostic-from-ast-span "" span message))]
            [(TcMaybeAstSourceSpan.No) (tc-diag-at-start message)])])]))

;; Locate an error at the nearest available declaration body span. A top-level
;; `define` body is wrapped in `AstExpr.Spanned`, so its span points the
;; diagnostic at the offending declaration's expression; otherwise fall back 1:1.
(define (tc-generated-decl-diag
  [meta : ast.AstGeneratedDeclMeta]
  [diag : cdiag.CompilerDiagnostic]) : cdiag.CompilerDiagnostic
  (match meta
    [(ast.AstGeneratedDeclMeta.Some generator item _ key)
      (let
        [with-context : cdiag.CompilerDiagnostic
          (cdiag.compiler-diagnostic-with-note
            diag
            (str_cat.str-cat "generated declaration: " item " from " generator))]
        (if (> (string.string-length key) 0)
          (cdiag.compiler-diagnostic-with-note
            with-context
            (str_cat.str-cat "generated identity: " key))
          with-context))]
    [(ast.AstGeneratedDeclMeta.No) diag]))

(define (tc-decl-location-diag [decl : ast.AstDecl] [message : String]) : cdiag.CompilerDiagnostic
  (match decl
    [(ast.AstDecl.Def decl-meta _ _ expr-box)
      (let
        [expr : ast.AstExpr (ast.ast-node-get expr-box)]
        (tc-expr-diag expr message))]
    [(ast.AstDecl.DefFn decl-meta _ _ _ body-box _)
      (let
        [body : ast.AstExpr (ast.ast-node-get body-box)]
        (tc-expr-diag body message))]
    [(ast.AstDecl.DefMacro decl-meta _ _ _ body-box)
      (let
        [body : ast.AstExpr (ast.ast-node-get body-box)]
        (tc-expr-diag body message))]
    [(ast.AstDecl.Test _ _ span)
      (tc-canonical-diagnostic
        (cdiag.compiler-diagnostic-from-ast-span "" span message))]
    [(ast.AstDecl.Unsafe inner-box)
      (tc-decl-location-diag (__tl-box-place inner-box) message)]
    [_ (tc-diag-at-start message)]))

(define (tc-decl-diag [decl : ast.AstDecl] [message : String]) : cdiag.CompilerDiagnostic
  (cond
    [(tc-macro-framed-error? message) (tc-macro-framed-error-diag message)]
    [(tc-rich-error? message) (tc-rich-error-diag message)]
    [(tc-located-error? message) (tc-located-error-diag message)]
    [else
      (tc-generated-decl-diag
        (ast.ast-decl-generated-meta decl)
        (tc-decl-location-diag decl message))]))

(define (tc-decl-diag-with-maybe-origin
  [origin : parser.CompilerParseMaybeDeclSpan]
  [decl : ast.AstDecl]
  [message : String]) : cdiag.CompilerDiagnostic
  (let
    [diag : cdiag.CompilerDiagnostic (tc-decl-diag decl message)]
    (if (and
      (= (cdiag.compiler-diagnostic-line diag) 1)
      (= (cdiag.compiler-diagnostic-col diag) 1)
      (= (cdiag.compiler-diagnostic-end-line diag) 1)
      (= (cdiag.compiler-diagnostic-end-col diag) 1))
      (match origin
        [(parser.CompilerParseMaybeDeclSpan.Some span)
          (cdiag.compiler-diagnostic-with-primary-span
            diag
            (cdiag.CompilerDiagnosticSpan
              ""
              (ast.ast-source-span-start-line span)
              (ast.ast-source-span-start-col span)
              (ast.ast-source-span-end-line span)
              (ast.ast-source-span-end-col span)))]
        [(parser.CompilerParseMaybeDeclSpan.None) diag])
      diag)))

(define (tc-locate-error-at-expr [expr : ast.AstExpr] [message : String]) : String
  (if (tc-encoded-error? message)
    message
    (match (tc-expr-maybe-span expr)
      [(TcMaybeAstSourceSpan.Some span)
        (if (tc-borrow-place-error-message? message)
          (tc-rich-borrow-place-error span message)
          (tc-located-error span message))]
      [(TcMaybeAstSourceSpan.No) message])))

(define (tc-expr-id-maybe-span [expr-id : i64]) : TcMaybeAstSourceSpan
  (tc-expr-maybe-span (ast.ast-node-get expr-id)))

(define (tc-expr-maybe-span [expr : ast.AstExpr]) : TcMaybeAstSourceSpan
  (match expr
    [(ast.AstExpr.Spanned _ span) (TcMaybeAstSourceSpan.Some span)]
    [(ast.AstExpr.MacroExpansion inner _ _) (tc-expr-id-maybe-span inner)]
    [(ast.AstExpr.Unary _ inner) (tc-expr-id-maybe-span inner)]
    [(ast.AstExpr.Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(ast.AstLambda.Lambda _ _ body) (tc-expr-id-maybe-span body)])]
    [(ast.AstExpr.TupleRef target _) (tc-expr-id-maybe-span target)]
    [(ast.AstExpr.MakeArray _ size) (tc-expr-id-maybe-span size)]
    [(ast.AstExpr.Set _ value) (tc-expr-id-maybe-span value)]
    [(ast.AstExpr.Ann inner _) (tc-expr-id-maybe-span inner)]
    [(ast.AstExpr.Cast inner _) (tc-expr-id-maybe-span inner)]
    [(ast.AstExpr.Borrow _ _ inner) (tc-expr-id-maybe-span inner)]
    [(ast.AstExpr.Box value) (tc-expr-id-maybe-span value)]
    [(ast.AstExpr.BoxGet value) (tc-expr-id-maybe-span value)]
    [(ast.AstExpr.BoxTake value) (tc-expr-id-maybe-span value)]
    [(ast.AstExpr.Comptime inner) (tc-expr-id-maybe-span inner)]
    [(ast.AstExpr.Quote inner) (tc-expr-id-maybe-span inner)]
    [(ast.AstExpr.Quasiquote inner) (tc-expr-id-maybe-span inner)]
    [(ast.AstExpr.Unquote inner) (tc-expr-id-maybe-span inner)]
    [(ast.AstExpr.UnquoteSplicing inner) (tc-expr-id-maybe-span inner)]
    [(ast.AstExpr.Try inner) (tc-expr-id-maybe-span inner)]
    [(ast.AstExpr.Return inner) (tc-expr-id-maybe-span inner)]
    [(ast.AstExpr.PtrNullCheck inner) (tc-expr-id-maybe-span inner)]
    [(ast.AstExpr.PtrAddrOf inner) (tc-expr-id-maybe-span inner)]
    [(ast.AstExpr.PtrRead inner) (tc-expr-id-maybe-span inner)]
    [(ast.AstExpr.PtrCast inner _) (tc-expr-id-maybe-span inner)]
    [(ast.AstExpr.PtrToInt inner) (tc-expr-id-maybe-span inner)]
    [(ast.AstExpr.IntToPtr inner _) (tc-expr-id-maybe-span inner)]
    [(ast.AstExpr.StringData inner) (tc-expr-id-maybe-span inner)]
    [(ast.AstExpr.ArrayData inner) (tc-expr-id-maybe-span inner)]
    [(ast.AstExpr.Xgetbv inner) (tc-expr-id-maybe-span inner)]
    [_ (TcMaybeAstSourceSpan.No)]))

(define (tc-expr-list-last-maybe-span [exprs : ast.AstExprList]) : TcMaybeAstSourceSpan
  (if (ast.ast-expr-list-empty? (& exprs))
    (TcMaybeAstSourceSpan.No)
    (tc-expr-maybe-span
      (ast.ast-node-get (ast.ast-expr-list-get (& exprs) (- exprs.len 1) 0)))))

(define (tc-reference-escape-help) : String
  "return an owned clone, keep the reference inside its scope, or tie the returned reference lifetime to a parameter")

(define (tc-borrow-place-error-message) : String
  "typecheck: borrow requires a local, parameter, or aggregate place")

(define (tc-borrow-place-error-message? [message : String]) : bool
  (string.eq message (tc-borrow-place-error-message)))

(define (tc-borrow-place-help) : String
  "bind the value to a local before borrowing it, or borrow a field or array element from a local aggregate")

(define (tc-rich-borrow-place-error
  [span : ast.AstSourceSpan]
  [message : String]) : String
  (tc-rich-error-one-secondary
    span
    message
    (tc-borrow-place-help)
    span
    "this expression produces a temporary value, not a borrowable place"))

(define (tc-assignment-escape-help [target : String]) : String
  (str_cat.str-cat
    "store an owned value instead, or keep `"
    target
    "` inside the borrowed value's lifetime"))

(define (tc-arena-escape-help [region : String]) : String
  (str_cat.str-cat
    "use with-escape to clone one supported result out of `"
    region
    "`, or keep the value inside the with-arena scope"))

(define (tc-closure-escape-help) : String
  "move owned data into the closure or keep the closure inside the borrowed/arena scope")

(define (tc-region-call-escape-help) : String
  "pass an owned clone, keep the call inside the value's arena/scope, or use with-escape to clone out a supported arena result before passing it")

(define (tc-reference-escape-message? [message : String]) : bool
  (or
    (string.eq message "typecheck: reference value would escape lexical scope")
    (tc-diag-string-prefix?
      message
      "typecheck: cannot store reference into longer-lived")
    (tc-diag-string-prefix?
      message
      "typecheck: cannot store reference into non-place")
    (string.eq
      message
      "typecheck: lambda cannot capture mutable reference; reference value would escape lexical scope")
    (string.eq
      message
      "typecheck: lambda cannot capture immutable reference; reference value would escape lexical scope")
    (string.eq
      message
      "typecheck: reference-capturing closure value would escape lexical scope")))

(define (tc-region-escape-message? [message : String]) : bool
  (or
    (tc-diag-string-prefix?
      message
      "typecheck: region-tagged value cannot escape with-arena '")
    (tc-diag-string-prefix?
      message
      "typecheck: cannot store region-tagged value into ")
    (string.eq
      message
      "typecheck: lambda cannot capture region-tagged value; region value would escape")
    (string.eq
      message
      "typecheck: lambda return value has region-tagged type; region value would escape")
    (string.eq
      message
      "typecheck: cannot pass region-tagged value to function parameter; region value would escape")))

(define (tc-cleanup-escape-message? [message : String]) : bool
  (or
    (string.eq
      message
      "typecheck: cleanup-required resource would escape with scope")
    (string.eq
      message
      "typecheck: lambda cannot capture cleanup-required resource; resource value would escape")
    (string.eq
      message
      "typecheck: cannot store cleanup-required resource in longer-lived binding")))

(define (tc-escape-message? [message : String]) : bool
  (or
    (tc-reference-escape-message? message)
    (tc-region-escape-message? message)
    (tc-cleanup-escape-message? message)))

(define (tc-escape-help [message : String]) : String
  (if (tc-region-escape-message? message)
    "return an owned clone, keep the value inside the arena/scope, or use with-escape for supported clone-out"
    (if (tc-cleanup-escape-message? message)
      "keep the cleanup-required value inside its resource scope or return a non-resource result"
      (tc-reference-escape-help))))

(define (tc-rich-error-with-maybe-secondary
  [primary : ast.AstSourceSpan]
  [message : String]
  [help : String]
  [maybe-secondary : TcMaybeAstSourceSpan]
  [secondary-label : String]) : String
  (match maybe-secondary
    [(TcMaybeAstSourceSpan.Some secondary)
      (tc-rich-error-one-secondary
        primary
        message
        help
        secondary
        secondary-label)]
    [(TcMaybeAstSourceSpan.No)
      (tc-rich-error-one-secondary primary message help primary secondary-label)]))

(define (tc-rich-escape-at-expr
  [expr : ast.AstExpr]
  [message : String]
  [secondary-label : String]) : String
  (match (tc-expr-maybe-span expr)
    [(TcMaybeAstSourceSpan.Some span)
      (tc-rich-error-one-secondary
        span
        message
        (tc-escape-help message)
        span
        secondary-label)]
    [(TcMaybeAstSourceSpan.No) message]))

;; Macros that read a vector element directly often expand to
;; `(array-ref vec.slots index)`. The outer generated nodes do
;; not carry a source span, but the unquoted vector expression does.  Use that
;; span so this diagnostic points to the user's borrowed-vector argument, not
;; only the macro's quasiquote body.
(define (tc-vector-ref-rvalue-source-span [arg : ast.AstExpr]) : TcMaybeAstSourceSpan
  (match (ast.ast-expr-unspan arg)
    [(ast.AstExpr.ArrayRef array-box _)
      (match (ast.ast-expr-unspan (ast.ast-node-get array-box))
        [(ast.AstExpr.StructGet receiver-box field)
          (if (= field cbi.compiler-builtin-id-fix-slots)
            (tc-expr-maybe-span (ast.ast-node-get receiver-box))
            (TcMaybeAstSourceSpan.No))]
        [_ (TcMaybeAstSourceSpan.No)])]
    [_ (TcMaybeAstSourceSpan.No)]))

;; A direct array read through a reference rvalue can produce a region-tagged
;; move-only aggregate. Keep the sound confinement rejection, but make this
;; frequent vector-iteration shape actionable without changing diagnostics for
;; unrelated region values crossing a call boundary.
(define (tc-region-call-arg-error [arg : ast.AstExpr]) : String
  (let
    [message : String
      "typecheck: cannot pass region-tagged value to function parameter; region value would escape"]
    (match (tc-vector-ref-rvalue-source-span arg)
      [(TcMaybeAstSourceSpan.Some span)
        (tc-rich-error-one-secondary
          span
          (str_cat.str-cat
            message
            "; direct aggregate reads through a shared vector borrow are not owned values; borrow slots from a vector place or use the generated vector get helper")
          "a direct aggregate read through this shared vector reference is not an owned value; borrow slots from a vector place or use the generated vector get helper"
          span
          "this by-value argument reads an aggregate through a shared reference")]
      [(TcMaybeAstSourceSpan.No)
        (match (tc-expr-maybe-span arg)
          [(TcMaybeAstSourceSpan.Some span)
            (tc-rich-error-one-secondary
              span
              message
              (tc-region-call-escape-help)
              span
              "this argument carries an arena region that the parameter does not accept")]
          [(TcMaybeAstSourceSpan.No) message])])))

;; Ordinary lifetime names stay on the old direct intern lookup. Structural
;; syntax identities and malformed internal ids take the total display path.
(defmacro (tc-lifetime-name-render [name : comptime.Expr]) : comptime.Expr
  `(let
    [lifetime-name-id : i64 ,name]
    (if (ci.intern-renderable-id? lifetime-name-id)
      (ci.intern-str lifetime-name-id)
      (ci.intern-syntax-name-text-or
        lifetime-name-id
        (str_cat.str-cat "<id:" (string.int->string lifetime-name-id) ">")))))

(define (tc-spanned-escape-error
  [inner : ast.AstExpr]
  [span : ast.AstSourceSpan]
  [message : String]) : TcMaybeString
  (if (tc-encoded-error? message)
    (TcMaybeString.No)
    (match inner
      [(ast.AstExpr.WithRegion region body)
        (if (tc-diag-string-prefix?
          message
          "typecheck: region-tagged value cannot escape with-arena '")
          (match (tc-expr-list-last-maybe-span body)
            [(TcMaybeAstSourceSpan.Some value-span)
              (TcMaybeString.Some
                (tc-rich-error-one-secondary
                  value-span
                  message
                  (tc-arena-escape-help (tc-lifetime-name-render region))
                  span
                  (str_cat.str-cat
                    "with-arena `"
                    (tc-lifetime-name-render region)
                    "` scope resets before this value can escape")))]
            [(TcMaybeAstSourceSpan.No)
              (TcMaybeString.Some
                (tc-rich-error-one-secondary
                  span
                  message
                  (tc-arena-escape-help (tc-lifetime-name-render region))
                  span
                  "with-arena scope boundary"))])
          (TcMaybeString.No))]
      [(ast.AstExpr.Return value-box)
        (if (tc-escape-message? message)
          (let
            [value : ast.AstExpr (ast.ast-node-get value-box)]
            (TcMaybeString.Some
              (tc-rich-error-with-maybe-secondary
                span
                message
                (tc-escape-help message)
                (tc-expr-maybe-span value)
                "returned value carries a lifetime or arena that cannot cross this boundary")))
          (TcMaybeString.No))]
      [(ast.AstExpr.Set name value-box)
        (if (tc-escape-message? message)
          (let
            [value : ast.AstExpr (ast.ast-node-get value-box)]
            [target : String (tc-env-key-name-text name)]
            (match (tc-expr-maybe-span value)
              [(TcMaybeAstSourceSpan.Some value-span)
                (TcMaybeString.Some
                  (tc-rich-error-two-secondaries
                    span
                    message
                    (tc-assignment-escape-help target)
                    value-span
                    "assigned value carries a shorter lifetime"
                    span
                    (str_cat.str-cat
                      "target binding `"
                      target
                      "` lives longer than the assigned value")))]
              [(TcMaybeAstSourceSpan.No)
                (TcMaybeString.Some
                  (tc-rich-error-one-secondary
                    span
                    message
                    (tc-assignment-escape-help target)
                    span
                    (str_cat.str-cat
                      "target binding `"
                      target
                      "` lives longer than the assigned value")))]))
          (TcMaybeString.No))]
      [(ast.AstExpr.Let let-box)
        (match (__tl-box-place let-box)
          [(ast.AstLet.Let _ body-box)
            (if (tc-escape-message? message)
              (let
                [body : ast.AstExpr (ast.ast-node-get body-box)]
                (TcMaybeString.Some
                  (tc-rich-error-with-maybe-secondary
                    span
                    message
                    (tc-escape-help message)
                    (tc-expr-maybe-span body)
                    "let result carries a lifetime that cannot outlive this binding scope")))
              (TcMaybeString.No))])]
      [(ast.AstExpr.Lambda lambda-box)
        (match (__tl-box-place lambda-box)
          [(ast.AstLambda.Lambda _ _ body-box)
            (if (tc-escape-message? message)
              (let
                [body : ast.AstExpr (ast.ast-node-get body-box)]
                (TcMaybeString.Some
                  (tc-rich-error-with-maybe-secondary
                    span
                    message
                    (tc-closure-escape-help)
                    (tc-expr-maybe-span body)
                    "closure body captures a value whose lifetime cannot escape")))
              (TcMaybeString.No))])]
      [_ (TcMaybeString.No)])))

(define (tc-expect-at-expr
  [expr : ast.AstExpr]
  [actual : ast.AstType]
  [expected : ast.AstType]
  [message : String]) : ResultTcUnit
  (if (tc-type-compatible? expected actual)
    ResultTcUnit.Ok
    (ResultTcUnit.Err
      (tc-locate-error-at-expr
        expr
        (tc-type-mismatch-message actual expected message)))))

(define (tc-type-env-binding-segment-capacity) : i64
  64)

(define (tc-type-env-cache-segment-capacity) : i64
  8)

;; Monotone counter of every event that can hand out a persistent-env node
;; address: a new store cell, a new binding segment, or a new cache segment.
;; Node addresses are stable while a store lives, because segments are only
;; appended to the store's owner arena, so a cached (store handle, node
;; address) pair can only ever be invalidated by a teardown that is followed by
;; one of those three allocations. Caches over persistent chains therefore stay
;; exact by dropping themselves whenever this counter moves.
(define tc-type-env-store-epoch : i64
  0)

(define (tc-type-env-store-new-with-topenv-state-address
  [topenv-state-address : i64]
  [structural-session-address : i64]) : TcTypeEnvStore
  (TcTypeEnvStore
    (array.make-array TcTypeEnvBinding 1)
    0
    0
    (array.make-array TcTypeEnvCache 1)
    0
    0
    (arena.tl_arena_current)
    topenv-state-address
    0
    structural-session-address))

(define (tc-type-env-store-handle-new-with-topenv-state-address
  [topenv-state-address : i64]
  [structural-session-address : i64]) : i64
  (let
    [cell : (__tl_dyn-array TcTypeEnvStore) (array.make-array TcTypeEnvStore 1)]
    (begin
      (set! tc-type-env-store-epoch (+ tc-type-env-store-epoch 1))
      (set!
        (array-ref cell 0)
        (tc-type-env-store-new-with-topenv-state-address
          topenv-state-address
          structural-session-address))
      (unsafe
        (cast (ptr->int (ptr-cast (__tl_array-data cell) : (Ptr u8))) : i64)))))

(define (tc-type-env-store-handle-new) : i64
  (let
    [source-names : ci.InternSourceNameSessionHandle
      (ci.intern-source-name-session-capture-active-handle)]
    (tc-type-env-store-handle-new-with-topenv-state-address
      0
      source-names.address)))

(define (tc-type-env-store-read [handle : i64]) : TcTypeEnvStore
  (unsafe
    (ptr-read (int->ptr (cast handle : u64) : (Ptr TcTypeEnvStore)))))

(define (tc-type-env-store-write! [handle : i64] [store : TcTypeEnvStore]) : unit
  (unsafe
    (ptr-write! (int->ptr (cast handle : u64) : (MutPtr TcTypeEnvStore)) store)))

(define (tc-type-env-new) : TcTypeEnv
  (TcTypeEnv (tc-type-env-store-handle-new) -1 0))

(define (tc-type-env-new-with-job-state [state : TcJobState]) : TcTypeEnv
  (let
    [source-names : ci.InternSourceNameSessionHandle
      (tc-macro-state-source-names (tc-job-state-macro-state state))]
    (TcTypeEnv
      (tc-type-env-store-handle-new-with-topenv-state-address
        (__tl-project-field (tc-job-state-topenv-membership state) address)
        source-names.address)
      -1
      0)))

(define (tc-type-env-structural-session [env : TcTypeEnv]) : cis.InternStructuralSessionHandle
  (cis.InternStructuralSessionHandle
    (unsafe
      (ptr-read (ptr-offset (int->ptr env.store : (Ptr i64)) 9)))))

(define (tc-type-env-topenv-membership-state [env : TcTypeEnv]) : TcTopEnvMembershipState
  (TcTopEnvMembershipState
    (unsafe
      (ptr-read (ptr-offset (int->ptr env.store : (Ptr i64)) 7)))))

(define (tc-type-env-set-topenv-membership-state!
  [env : TcTypeEnv]
  [state : TcTopEnvMembershipState]) : unit
  (unsafe
    (ptr-write!
      (ptr-offset (int->ptr env.store : (MutPtr i64)) 7)
      state.address)))

(define (tc-type-env-store-grow-bindings!
  [store : (&mut store TcTypeEnvStore)]
  [required : i64]) : unit
  (let
    [next-capacity : i64
      (if (< required (tc-type-env-binding-segment-capacity))
        (tc-type-env-binding-segment-capacity)
        required)]
    [owner : i64 store.owner-arena]
    (begin
      (set! tc-type-env-store-epoch (+ tc-type-env-store-epoch 1))
      (in-arena
        (arena.Arena owner)
        (let
          [bigger : (__tl_dyn-array TcTypeEnvBinding)
            (array.make-array TcTypeEnvBinding next-capacity)]
          (begin
            (set! store.bindings bigger)
            (set! store.binding-capacity next-capacity)
            (set! store.binding-len 0)))))))

(define (tc-type-env-store-grow-caches!
  [store : (&mut store TcTypeEnvStore)]
  [required : i64]) : unit
  (let
    [next-capacity : i64
      (if (< required (tc-type-env-cache-segment-capacity))
        (tc-type-env-cache-segment-capacity)
        required)]
    [owner : i64 store.owner-arena]
    (begin
      (set! tc-type-env-store-epoch (+ tc-type-env-store-epoch 1))
      (in-arena
        (arena.Arena owner)
        (let
          [bigger : (__tl_dyn-array TcTypeEnvCache)
            (array.make-array TcTypeEnvCache next-capacity)]
          (begin
            (set! store.caches bigger)
            (set! store.cache-capacity next-capacity)
            (set! store.cache-len 0)))))))

(define (tc-type-env-store-write-cache!
  [store : (&mut store TcTypeEnvStore)]
  [index : i64]
  [cache : TcTypeEnvCache]) : unit
  (set! (array-ref store.caches index) cache))

;; Hot persistent-env walkers expand these address/field reads at their direct
;; match sites. Returning an enum-shaped view per node was measurably expensive
;; here: it copied the store and the largest cache payload even when a walker
;; only needed the binding key and parent. Arena segments are never moved, so a
;; snapshot head remains a valid element address after later segments are added.
;; `tc-type-env-raw-layout-smoke?` pins the word offsets used by these hot
;; accessors without adding byte-offset conversion work to each expansion.
(defmacro (tc-type-env-binding-ptr
  [_store-handle : comptime.Expr]
  [index : comptime.Expr]) : comptime.Expr
  `(unsafe
    (int->ptr (cast ,index : u64) : (Ptr TcTypeEnvBinding))))

(defmacro (tc-type-env-cache-ptr
  [_store-handle : comptime.Expr]
  [index : comptime.Expr]) : comptime.Expr
  `(unsafe
    (int->ptr (cast ,index : u64) : (Ptr TcTypeEnvCache))))

(defmacro (tc-type-env-binding-name-at [binding-ptr : comptime.Expr]) : comptime.Expr
  `(unsafe
    (ptr-read (ptr-cast ,binding-ptr : (Ptr i64)))))

(defmacro (tc-type-env-binding-type-at [binding-ptr : comptime.Expr]) : comptime.Expr
  `(unsafe
    (ptr-read
      (ptr-cast
        (ptr-offset (ptr-cast ,binding-ptr : (Ptr i64)) 1)
        : (Ptr ast.AstType)))))

(defmacro (tc-type-env-binding-parent-at [binding-ptr : comptime.Expr]) : comptime.Expr
  `(unsafe
    (ptr-read (ptr-offset (ptr-cast ,binding-ptr : (Ptr i64)) 4))))

(defmacro (tc-type-env-cache-at [cache-ptr : comptime.Expr]) : comptime.Expr
  `(unsafe
    (ptr-read ,cache-ptr)))

;; Physical byte offsets in TcTypeEnvCache after the four-word chain prefix:
;; ids=32 (the map is inline and 24 bytes), values=56, sidecar arrays=64/72/80,
;; flags=88/89, and rest/below=96/104. Keep these literals paired with the
;; raw-layout smoke and
;; cache behavior tests; `offset-of` currently treats the inline map as one word
;; and therefore under-reports every following field.
(defmacro (tc-type-env-cache-field-at
  [cache-ptr : comptime.Expr]
  [byte-offset : comptime.Expr]
  [_T : type]) : comptime.Expr
  `(unsafe
    (ptr-read
      (ptr-cast
        (ptr-offset (ptr-cast ,cache-ptr : (Ptr u8)) ,byte-offset)
        : (Ptr ,_T)))))

(define (tc-type-env-store-push-binding!
  [store-handle : i64]
  [binding : TcTypeEnvBinding]) : i64
  (let
    [store-words : (MutPtr i64)
      (unsafe
        (int->ptr (cast store-handle : u64) : (MutPtr i64)))]
    [index : i64
      (unsafe
        (ptr-read (ptr-offset store-words 2)))]
    (begin
      (if (<
        index
        (unsafe
          (ptr-read (ptr-offset store-words 1))))
        unit
        (let
          [store : TcTypeEnvStore (tc-type-env-store-read store-handle)]
          (begin
            (tc-type-env-store-grow-bindings! (&mut store) (+ index 1))
            (tc-type-env-store-write! store-handle store)
            (set! index 0))))
      (let
        [items : (__tl_dyn-array TcTypeEnvBinding)
          (unsafe
            (ptr-read
              (ptr-cast store-words : (Ptr (__tl_dyn-array TcTypeEnvBinding)))))]
        (begin
          (set! (array-ref items index) binding)
          (unsafe
            (ptr-write! (ptr-offset store-words 2) (+ index 1)))
          (unsafe
            (cast
              (ptr->int
                (ptr-cast (ptr-offset (__tl_array-data items) index) : (Ptr u8)))
              : i64)))))))

(define (tc-type-env-store-push-cache!
  [store : (&mut store TcTypeEnvStore)]
  [cache : TcTypeEnvCache]) : i64
  (let
    [index : i64 store.cache-len]
    (begin
      (if (< index store.cache-capacity)
        unit
        (begin
          (tc-type-env-store-grow-caches! store (+ index 1))
          (set! index 0)))
      (tc-type-env-store-write-cache! store index cache)
      (set! store.cache-len (+ index 1))
      (unsafe
        (cast
          (ptr->int
            (ptr-cast
              (ptr-offset (__tl_array-data store.caches) index)
              : (Ptr u8)))
          : i64)))))

;; Cleanup-owner markers are only ever introduced by `with`-resource bindings, so
;; most programs never create one. `tc-active-cleanup-owners` has to walk the
;; whole persistent binding spine to prove that, once per checked let/store/
;; transfer expression. Counting marker binds at the single persistent-bind choke
;; point turns that proof into one load: a marker can only be observed by the
;; scan if some binding record carries `tc-cleanup-owner-marker-id` as its key,
;; and every binding record is created here, so a zero count means every spine in
;; every store is marker-free and the scan is provably empty. The count is
;; monotone and process-wide, i.e. conservative in the safe direction: it can
;; only ever disable the fast path, never enable it wrongly.
(define tc-cleanup-owner-marker-bind-count : i64
  0)

(define (tc-cleanup-owner-markers-possible?) : bool
  (not (= tc-cleanup-owner-marker-bind-count 0)))

(define (tc-type-env-cache-head [index : i64]) : i64
  (- 0 index))

(define (tc-type-env-cache-index [head : i64]) : i64
  (- 0 head))

(define (tc-type-env-bind-node
  [env : TcTypeEnv]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnv
  (let
    [store-handle : i64 env.store]
    [_note-marker : unit
      (if (= name-id (tc-cleanup-owner-marker-id))
        (set!
          tc-cleanup-owner-marker-bind-count
          (+ tc-cleanup-owner-marker-bind-count 1))
        unit)]
    [index : i64
      (tc-type-env-store-push-binding!
        store-handle
        (TcTypeEnvBinding name-id ty env.head))]
    (TcTypeEnv store-handle index 0)))

(define (tc-type-env-cache-node [env : TcTypeEnv] [cache : TcTypeEnvCache]) : TcTypeEnv
  (let
    [store-handle : i64 env.store]
    [store : TcTypeEnvStore (tc-type-env-store-read store-handle)]
    [index : i64 (tc-type-env-store-push-cache! (&mut store) cache)]
    (begin
      (tc-type-env-store-write! store-handle store)
      (TcTypeEnv store-handle (tc-type-env-cache-head index) 0))))

(define (tc-type-env-view [env : TcTypeEnv]) : TcTypeEnvView
  (let
    [head : i64 env.head]
    (cond
      [(= head -1) TcTypeEnvView.Nil]
      [(>= head 0)
        (let
          [store-handle : i64 env.store]
          [binding-ptr : (Ptr TcTypeEnvBinding)
            (tc-type-env-binding-ptr store-handle head)]
          (TcTypeEnvView.Bind
            (tc-type-env-binding-name-at binding-ptr)
            (tc-type-env-binding-type-at binding-ptr)
            (TcTypeEnv
              store-handle
              (tc-type-env-binding-parent-at binding-ptr)
              0)))]
      [else
        (let
          [store-handle : i64 env.store]
          [cache-ptr : (Ptr TcTypeEnvCache)
            (tc-type-env-cache-ptr store-handle (tc-type-env-cache-index head))]
          (TcTypeEnvView.Cache
            cache-ptr
            (tc-type-env-cache-field-at cache-ptr 88 bool)
            (tc-type-env-cache-field-at cache-ptr 89 bool)
            (TcTypeEnv
              store-handle
              (tc-type-env-cache-field-at cache-ptr 96 i64)
              0)
            (TcTypeEnv
              store-handle
              (tc-type-env-cache-field-at cache-ptr 104 i64)
              0)))])))

(define (tc-empty-env) : TcTypeEnv
  (tc-type-env-new))

(define (tc-empty-env-with-job-state [state : TcJobState]) : TcTypeEnv
  (tc-type-env-new-with-job-state state))

(define (tc-type-env-spine-step [env : TcTypeEnv]) : TcTypeEnvSpineStep
  (match (tc-type-env-view env)
    [(TcTypeEnvView.Nil) (TcTypeEnvSpineStep.Done)]
    [(TcTypeEnvView.Cache _ _ _ rest _) (TcTypeEnvSpineStep.Cache rest)]
    [(TcTypeEnvView.Bind key ty rest) (TcTypeEnvSpineStep.Bind key ty rest)]))

(define (tc-type-env-marker-start [env : TcTypeEnv]) : TcTypeEnv
  (match (tc-type-env-view env)
    [(TcTypeEnvView.Cache _ _ _ rest _) rest]
    [_ env]))

(define (tc-type-env-marker-step [env : TcTypeEnv]) : TcTypeEnvMarkerStep
  (match (tc-type-env-view env)
    [(TcTypeEnvView.Nil) (TcTypeEnvMarkerStep.Done)]
    [(TcTypeEnvView.Cache _ scan-through _ rest _)
      (if scan-through
        (TcTypeEnvMarkerStep.Cache rest)
        (TcTypeEnvMarkerStep.Done))]
    [(TcTypeEnvView.Bind key ty rest) (TcTypeEnvMarkerStep.Bind key ty rest)]))

(define (tc-type-env-lookup-step [env : TcTypeEnv] [name-id : i64]) : TcTypeEnvLookupStep
  (match (tc-type-env-view env)
    [(TcTypeEnvView.Nil) (TcTypeEnvLookupStep.Missing)]
    [(TcTypeEnvView.Cache cache-ptr _ partial _ below)
      (let
        [ids : tc_i64_i64_map.Map
          (tc-type-env-cache-field-at cache-ptr 32 tc_i64_i64_map.Map)]
        [values : (__tl_dyn-array ast.AstType)
          (tc-type-env-cache-field-at cache-ptr 56 (__tl_dyn-array ast.AstType))]
        (match (tc_i64_i64_map.get (& ids) name-id)
          [(tc_i64_i64_map.LookupFound index)
            ;; AstType reads must stay `array-ref` because inline-by-value
            ;; AstType values are multi-word.
            (TcTypeEnvLookupStep.Found (array-ref values index))]
          [(tc_i64_i64_map.LookupMissing)
            (if partial
              (TcTypeEnvLookupStep.Miss below)
              (TcTypeEnvLookupStep.Missing))]))]
    [(TcTypeEnvView.Bind key ty rest)
      (if (= key name-id)
        (TcTypeEnvLookupStep.Found ty)
        (TcTypeEnvLookupStep.Miss rest))]))

(define (tc-type-env-unsafe-lookup-step [env : TcTypeEnv] [name-id : i64]) : TcTypeEnvUnsafeLookupStep
  (match (tc-type-env-view env)
    [(TcTypeEnvView.Nil) (TcTypeEnvUnsafeLookupStep.Missing)]
    [(TcTypeEnvView.Cache cache-ptr _ partial _ below)
      (let
        [ids : tc_i64_i64_map.Map
          (tc-type-env-cache-field-at cache-ptr 32 tc_i64_i64_map.Map)]
        [values : (__tl_dyn-array ast.AstType)
          (tc-type-env-cache-field-at cache-ptr 56 (__tl_dyn-array ast.AstType))]
        [unsafe-flags : (__tl_dyn-array i64)
          (tc-type-env-cache-field-at cache-ptr 64 (__tl_dyn-array i64))]
        (match (tc_i64_i64_map.get (& ids) name-id)
          [(tc_i64_i64_map.LookupFound index)
            ;; AstType read must stay `array-ref`; the unsafe flag is a
            ;; scalar i64 and keeps the previous raw read path.
            (TcTypeEnvUnsafeLookupStep.Found
              (array-ref values index)
              (=
                (unsafe
                  (ptr-read
                    (ptr-offset
                      (ptr-cast (__tl_array-data unsafe-flags) : (Ptr i64))
                      index)))
                1))]
          [(tc_i64_i64_map.LookupMissing)
            (if partial
              (TcTypeEnvUnsafeLookupStep.Miss below)
              (TcTypeEnvUnsafeLookupStep.Missing))]))]
    [(TcTypeEnvView.Bind key ty rest)
      (if (= key name-id)
        (TcTypeEnvUnsafeLookupStep.Found
          ty
          (tc-binding-unsafe-marker-head-id? rest name-id))
        (TcTypeEnvUnsafeLookupStep.Miss rest))]))

(define (tc-local-cache-threshold) : i64
  32)

(define (tc-local-cache-partial-layer-cap) : i64
  8)

(define (tc-builtin-symbol-name-id [raw-name-id : i64] [hygiene-global : bool]) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    (if hygiene-global
      (macro-hygiene-global-source-name-id-or raw-name-id -1)
      raw-name-id)))

(define (tc-builtin-call-name-id [raw-name-id : i64] [hygiene-global : bool]) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    (if hygiene-global
      (let
        [source-id : i64
          (macro-hygiene-global-source-name-id-or raw-name-id -1)]
        source-id)
      raw-name-id)))

;; --- top-env build membership side table ------------------------------------
;; The whole-program top-level env is an UNCACHED spine of ~46K binds. The
;; threshold-compaction machinery (tc-env-compact-local-if-threshold) is for
;; single-bind function scopes and does not fire here: unsafe/c-abi decls
;; prepend two binds at once, breaking the exact-"32 binds above a cache"
;; alignment it needs, so the top env stays a plain list. The enum-variant
;; binder uses `tc-bind-alias-id-if-free`, whose guard `tc-name-bound-id?`
;; rescans that whole spine per variant -> O(decls^2) (measured: 46.4M node
;; visits, ~120ms of the top-env build of a self-compile, with the guard never
;; once finding a name already bound).
;;
;; This is a job-owned membership bloom keyed by name identity: every name
;; bound during the build (plus the seeded base env) is stamped with the
;; current ownership epoch. An UNMARKED id is provably absent from the env, so
;; the guard binds directly with no scan. A MARKED id (a real prior binding, or
;; a transient local bind from an un-annotated top-level `define` initializer)
;; falls back to the exact spine scan -- the bloom only ever SKIPS the scan when
;; the name is definitely unbound, so the bound env, lookups, and diagnostics
;; are identical to the unconditional scan.
;;
;; Bit 1 is the EXACT complement for the guard's other verdict: it is stamped
;; only by binds that provably join the accumulated top-env spine
;; (the seeded base env, tc-bind-alias-id-if-free's own binds, and top-env alias
;; fanout binds -- never the transient inference binds that make the bloom
;; conservative). A stamped id is therefore definitely bound, so the guard can
;; skip without the O(spine) scan.
;; Self-compiles repeat enum-variant names (Ok/Err/None/Nil/...) across
;; hundreds of enums; every repeat after the first used to rescan the whole
;; spine from the head down to the first binding. Ids that are bloom-marked but
;; not bound-stamped (e.g. spine binds made outside the alias binder) still
;; take the exact scan, so results are identical either way.
(define (tc-topenv-membership-state-present? [state : TcTopEnvMembershipState]) : bool
  (not (= state.address 0)))

(define (tc-topenv-membership-map-needs-grow?
  [map : (& map tc_i64_i64_map.Map)]) : bool
  (let
    [capacity : i64 (tc_i64_i64_map.capacity map)]
    (or
      (<= capacity 0)
      (>=
        (* (+ (tc_i64_i64_map.len map) (tc_i64_i64_map.deleted map)) 4)
        (* capacity 3)))))

(define (tc-cache-map-clear! [map : (&mut map tc_i64_i64_map.Map)]) : unit
  (let
    [index : i64 0]
    (begin
      (while (< index (array.length map.slots))
        (begin
          (__tl-project-set-field
            (array-ref map.slots index)
            state
            (tc_i64_i64_map.GeneratedHashmapSlotState.Empty))
          (set! index (+ index 1))))
      (set! map.len 0)
      (set!
        map.growth-limit
        (tc_i64_i64_map.growth-limit-for (tc_i64_i64_map.capacity (& map)))))))

(define (tc-cache-map-grow-in-owner!
  [map : (&mut map tc_i64_i64_map.Map)]
  [owner : i64]) : unit
  (if (tc-topenv-membership-map-needs-grow? (& map))
    (in-arena (arena.Arena owner) (tc_i64_i64_map.grow! map))
    unit))

(define (tc-topenv-membership-renderable-overflow-flags-for
  [data : (& data TcTopEnvMembershipStateData)]
  [name-id : ci.InternId]) : i64
  (let
    [packed : i64
      (tc_i64_i64_map.get-value-or
        (& data.structural-flags)
        (ci.intern-id-value name-id)
        0)]
    (if (= (shr packed 3) data.epoch)
      (bit-and packed 3)
      0)))

(define (tc-topenv-membership-structural-flags-for
  [data : (& data TcTopEnvMembershipStateData)]
  [name-id : i64]) : i64
  (let
    [packed : i64
      (tc_i64_i64_map.get-value-or (& data.structural-flags) name-id 0)]
    (if (= (shr packed 2) data.epoch)
      (bit-and packed 3)
      0)))

(define (tc-topenv-membership-mark-structural-data!
  [data : (&mut data TcTopEnvMembershipStateData)]
  [name-id : i64]
  [bits : i64]) : unit
  (let
    [current : i64 (tc-topenv-membership-structural-flags-for (& data) name-id)]
    (begin
      (tc-cache-map-grow-in-owner!
        (&mut data.structural-flags)
        data.owner-arena)
      (tc_i64_i64_map.insert-ref!
        (&mut data.structural-flags)
        name-id
        (bit-or (shl data.epoch 2) (bit-or current bits))))))

(define (tc-topenv-membership-mark-renderable-data!
  [data : (&mut data TcTopEnvMembershipStateData)]
  [name-id : ci.InternId]
  [bound : bool]) : unit
  (let
    [index : i64 (ci.intern-id-value name-id)]
    (if (< index (array.length data.renderable-slots))
      (begin
        (set! (array-ref data.renderable-slots index) data.epoch)
        (if bound
          (set! (array-ref data.renderable-bound-slots index) data.epoch)
          unit))
      (let
        [current : i64
          (tc-topenv-membership-renderable-overflow-flags-for (& data) name-id)]
        (begin
          (tc-cache-map-grow-in-owner!
            (&mut data.structural-flags)
            data.owner-arena)
          (tc_i64_i64_map.insert-ref!
            (&mut data.structural-flags)
            index
            (bit-or
              (shl data.epoch 3)
              (bit-or
                current
                (if bound
                  3
                  1)))))))))

;; TcTypeEnv still carries raw name keys during the typed-ID migration. Keep
;; this one compatibility boundary explicit: valid renderable IDs become
;; InternId before entering dense storage; every other raw identity takes the
;; structural map path.
(define (tc-topenv-membership-mark-key-data!
  [data : (&mut data TcTopEnvMembershipStateData)]
  [name-id : i64]
  [bound : bool]) : unit
  (if (ci.intern-renderable-id? name-id)
    (tc-topenv-membership-mark-renderable-data!
      data
      (ci.intern-id-from-renderable name-id)
      bound)
    (tc-topenv-membership-mark-structural-data!
      data
      name-id
      (if bound
        3
        1))))

(define (tc-topenv-membership-mark!
  [state : TcTopEnvMembershipState]
  [name-id : i64]) : unit
  (if (tc-topenv-membership-state-present? state)
    (let
      [data : TcTopEnvMembershipStateData
        (tc-topenv-membership-state-data state)]
      (if (and (not (= (bit-and data.mode 1) 0)) data.accelerator-enabled)
        (begin
          (tc-topenv-membership-mark-key-data! (&mut data) name-id false)
          (tc-topenv-membership-state-data-set! state data))
        unit))
    unit))

(define (tc-topenv-membership-mark-bound!
  [state : TcTopEnvMembershipState]
  [name-id : i64]) : unit
  (if (tc-topenv-membership-state-present? state)
    (let
      [data : TcTopEnvMembershipStateData
        (tc-topenv-membership-state-data state)]
      (if (and (not (= (bit-and data.mode 1) 0)) data.accelerator-enabled)
        (begin
          (tc-topenv-membership-mark-key-data! (&mut data) name-id true)
          (tc-topenv-membership-state-data-set! state data))
        unit))
    unit))

(define (tc-topenv-explicit-build-active? [state : TcTopEnvMembershipState]) : bool
  (and
    (tc-topenv-membership-state-present? state)
    (not (= (bit-and (tc-topenv-membership-mode state) 4) 0))))

(define (tc-topenv-membership-mode [state : TcTopEnvMembershipState]) : i64
  (if (tc-topenv-membership-state-present? state)
    (unsafe
      (ptr-read (int->ptr (cast state.address : u64) : (Ptr i64))))
    0))

(define (tc-topenv-membership-set-alias-fanout-active!
  [state : TcTopEnvMembershipState]
  [active : bool]) : unit
  (let
    [data : TcTopEnvMembershipStateData (tc-topenv-membership-state-data state)]
    (begin
      (set!
        data.mode
        (if active
          (bit-or data.mode 2)
          (bit-and data.mode -3)))
      (tc-topenv-membership-state-data-set! state data))))

(define (tc-topenv-membership-set-explicit-build-active!
  [state : TcTopEnvMembershipState]
  [active : bool]) : unit
  (let
    [data : TcTopEnvMembershipStateData (tc-topenv-membership-state-data state)]
    (begin
      (set!
        data.mode
        (if active
          (bit-or data.mode 4)
          (bit-and data.mode -5)))
      (tc-topenv-membership-state-data-set! state data))))

;; True when the id is PROVABLY bound in the accumulated top-env spine (stamped
;; by a spine-joining bind this generation); false means "unknown", not
;; "unbound".
(define (tc-topenv-membership-bound?
  [state : TcTopEnvMembershipState]
  [name-id : i64]) : bool
  (if (tc-topenv-membership-state-present? state)
    (let
      [data : TcTopEnvMembershipStateData
        (tc-topenv-membership-state-data state)]
      (if (not data.accelerator-enabled)
        false
        (if (ci.intern-renderable-id? name-id)
          (let
            [renderable : ci.InternId (ci.intern-id-from-renderable name-id)]
            [index : i64 (ci.intern-id-value renderable)]
            (if (< index (array.length data.renderable-bound-slots))
              (= (array-ref data.renderable-bound-slots index) data.epoch)
              (not
                (=
                  (bit-and
                    (tc-topenv-membership-renderable-overflow-flags-for
                      (& data)
                      renderable)
                    2)
                  0))))
          (not
            (=
              (bit-and
                (tc-topenv-membership-structural-flags-for (& data) name-id)
                2)
              0)))))
    false))

;; True when the id MIGHT be in the env; false only when the accelerator has
;; recorded enough state to prove absence. Disabling the accelerator preserves
;; the exact-scan behavior for differential tests.
(define (tc-topenv-membership-maybe?
  [state : TcTopEnvMembershipState]
  [name-id : i64]) : bool
  (if (tc-topenv-membership-state-present? state)
    (let
      [data : TcTopEnvMembershipStateData
        (tc-topenv-membership-state-data state)]
      (if (not data.accelerator-enabled)
        true
        (if (ci.intern-renderable-id? name-id)
          (let
            [renderable : ci.InternId (ci.intern-id-from-renderable name-id)]
            [index : i64 (ci.intern-id-value renderable)]
            (if (< index (array.length data.renderable-slots))
              (= (array-ref data.renderable-slots index) data.epoch)
              (not
                (=
                  (bit-and
                    (tc-topenv-membership-renderable-overflow-flags-for
                      (& data)
                      renderable)
                    1)
                  0))))
          (not
            (=
              (bit-and
                (tc-topenv-membership-structural-flags-for (& data) name-id)
                1)
              0)))))
    true))

(define (tc-topenv-membership-seed!
  [state : TcTopEnvMembershipState]
  [env : TcTypeEnv]) : unit
  (match (tc-type-env-spine-step env)
    [(TcTypeEnvSpineStep.Done) unit]
    [(TcTypeEnvSpineStep.Cache rest-env)
      (tc-topenv-membership-seed! state rest-env)]
    [(TcTypeEnvSpineStep.Bind key _ rest-env)
      (begin
        (tc-topenv-membership-mark! state key)
        (tc-topenv-membership-mark-bound! state key)
        (tc-topenv-membership-seed! state rest-env))]))

(define (tc-topenv-membership-begin!
  [state : TcTopEnvMembershipState]
  [env : TcTypeEnv]
  [intern-table-id : i64]
  [intern-generation : i64]) : unit
  (let
    [data : TcTopEnvMembershipStateData (tc-topenv-membership-state-data state)]
    (begin
      (if (or
        (not (= data.intern-table-id intern-table-id))
        (not (= data.intern-generation intern-generation)))
        (tc-cache-map-clear! (&mut data.structural-flags))
        unit)
      ;; Every build gets a fresh stamp. Recording the immutable source-name
      ;; owner here prevents equal numeric IDs in two intern sessions from
      ;; sharing accelerator facts.
      (set! data.epoch (+ data.epoch 1))
      (set! data.intern-table-id intern-table-id)
      (set! data.intern-generation intern-generation)
      (set! data.mode 1)
      (tc-topenv-membership-state-data-set! state data)
      (tc-topenv-membership-seed! state env))))

(define (tc-topenv-membership-end! [state : TcTopEnvMembershipState]) : unit
  (let
    [data : TcTopEnvMembershipStateData (tc-topenv-membership-state-data state)]
    (begin
      (set! data.mode 0)
      (tc-topenv-membership-state-data-set! state data))))

(cfg
  test
  (define (tc-topenv-membership-job-owned-capacity-smoke?) : bool
    (let
      [job-a : TcJobState (tc-job-state-new)]
      [job-b : TcJobState (tc-job-state-new)]
      [state-a : TcTopEnvMembershipState (tc-job-state-topenv-membership job-a)]
      [state-b : TcTopEnvMembershipState (tc-job-state-topenv-membership job-b)]
      [env-a : TcTypeEnv (tc-empty-env-with-job-state job-a)]
      [env-b : TcTypeEnv (tc-empty-env-with-job-state job-b)]
      [renderable : i64 (ci.intern "membership-job-owned")]
      [renderable-overflow : i64 (+ tc-topenv-renderable-table-capacity 1)]
      [alias-id : i64 (ci.intern "membership-ab-alias")]
      [structural-base : i64 (* (ci.intern-capacity) (ci.intern-capacity))]
      [stress-count : i64 65537]
      [index : i64 0]
      (begin
        (tc-topenv-membership-begin! state-a env-a 101 201)
        (tc-topenv-membership-begin! state-b env-b 102 202)
        (tc-topenv-membership-mark-bound! state-a renderable)
        ;; One more entry than the removed fixed overflow table proves structural
        ;; membership has no hidden 65,536-key ceiling.
        (while (< index stress-count)
          (begin
            (tc-topenv-membership-mark-bound! state-a (+ structural-base index))
            (set! index (+ index 1))))
        (let
          [isolated? : bool
            (and
              (tc-topenv-membership-bound? state-a renderable)
              (not (tc-topenv-membership-maybe? state-b renderable))
              (tc-topenv-membership-bound? state-a structural-base)
              (tc-topenv-membership-bound?
                state-a
                (+ structural-base (- stress-count 1)))
              (not (tc-topenv-membership-maybe? state-b structural-base)))]
          [enabled-env : TcTypeEnv
            (tc-bind-alias-id-if-free
              (tc-bind-alias-id-if-free env-a alias-id (ast.AstType.I64))
              alias-id
              (ast.AstType.Bool))]
          [overflow-safe? : bool
            (begin
              ;; A typed ID above the dense prefix remains exact in the
              ;; renderable overflow map; it never enters the structural path.
              (tc-topenv-membership-mark-bound! state-a renderable-overflow)
              (and
                (tc-topenv-membership-maybe? state-a renderable)
                (tc-topenv-membership-maybe? state-a renderable-overflow)
                (tc-topenv-membership-bound? state-a renderable)
                (tc-topenv-membership-bound? state-a renderable-overflow)))]
          (begin
            (tc-job-state-set-topenv-membership-enabled! job-b false)
            (tc-topenv-membership-begin! state-b env-b 102 202)
            (let
              [disabled-env : TcTypeEnv
                (tc-bind-alias-id-if-free
                  (tc-bind-alias-id-if-free env-b alias-id (ast.AstType.I64))
                  alias-id
                  (ast.AstType.Bool))]
              (begin
                (tc-topenv-membership-end! state-a)
                (tc-topenv-membership-end! state-b)
                (and
                  isolated?
                  overflow-safe?
                  (match (tc-lookup-id enabled-env alias-id)
                    [(ResultTcType.Ok (ast.AstType.I64)) true]
                    [_ false])
                  (match (tc-lookup-id disabled-env alias-id)
                    [(ResultTcType.Ok (ast.AstType.I64)) true]
                    [_ false]))))))))))

(cfg
  test
  (test
    tc-topenv-membership-job-owned-capacity
    (if (tc-topenv-membership-job-owned-capacity-smoke?)
      unit
      (io.panic "typecheck: job-owned top-env membership/capacity smoke failed"))))

(define (tc-bind-raw-id [env : TcTypeEnv] [name-id : i64] [ty : ast.AstType]) : TcTypeEnv
  (let
    [topenv-state : TcTopEnvMembershipState
      (tc-type-env-topenv-membership-state env)]
    [topenv-mode : i64 (tc-topenv-membership-mode topenv-state)]
    (begin
      (cfg compile-profile (compiler-tc-env-profile-note-bind))
      (if (not (= (bit-and topenv-mode 2) 0))
        (tc-topenv-membership-mark-bound! topenv-state name-id)
        (if (not (= (bit-and topenv-mode 1) 0))
          (tc-topenv-membership-mark! topenv-state name-id)
          unit))
      (let
        [next-env : TcTypeEnv (tc-type-env-bind-node env name-id ty)]
        (begin
          (if tc-type-env-scoped-runtime-active
            (tc-type-env-scoped-runtime-note-bind-id! next-env name-id ty env)
            unit)
          next-env)))))

(define (tc-env-uncached-prefix-reaches-cache?
  [env : TcTypeEnv]
  [remaining : i64]) : bool
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    [left : i64 remaining]
    (begin
      (while (and (> left 0) (>= head 0))
        (let
          [binding-ptr : (Ptr TcTypeEnvBinding)
            (tc-type-env-binding-ptr store-handle head)]
          (begin
            (set! head (tc-type-env-binding-parent-at binding-ptr))
            (set! left (- left 1)))))
      (and (<= left 0) (< head -1)))))

(define (tc-env-after-prefix [env : TcTypeEnv] [remaining : i64]) : TcTypeEnv
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    [left : i64 remaining]
    (begin
      (while (and (> left 0) (>= head 0))
        (let
          [binding-ptr : (Ptr TcTypeEnvBinding)
            (tc-type-env-binding-ptr store-handle head)]
          (begin
            (set! head (tc-type-env-binding-parent-at binding-ptr))
            (set! left (- left 1)))))
      (TcTypeEnv store-handle head 0))))

(define (tc-env-partial-layer-depth [env : TcTypeEnv]) : i64
  (match (tc-type-env-view env)
    [(TcTypeEnvView.Cache _ scan-through partial _ below)
      (if (and scan-through partial)
        (+ 1 (tc-env-partial-layer-depth below))
        0)]
    [_ 0]))

;; Local partial caches allocate their value arrays at exactly twice the number
;; of covered spine binds (the local threshold is well above the tiny-cache
;; minimum). This lets a collapsed layer retain its exact coverage without
;; widening TcTypeEnv: later collapses can sum old layers and stop at the
;; immutable explicit top-env boundary.
(define (tc-env-partial-local-covered-count [env : TcTypeEnv]) : i64
  (match (tc-type-env-view env)
    [(TcTypeEnvView.Cache cache-ptr scan-through partial _ below)
      (let
        [values : (__tl_dyn-array ast.AstType)
          (tc-type-env-cache-field-at cache-ptr 56 (__tl_dyn-array ast.AstType))]
        (if (and scan-through partial)
          (+
            (/ (array.length values) 2)
            (tc-env-partial-local-covered-count below))
          0))]
    [_ 0]))

(define (tc-env-partial-local-base [env : TcTypeEnv]) : TcTypeEnv
  (match (tc-type-env-view env)
    [(TcTypeEnvView.Cache _ scan-through partial _ below)
      (if (and scan-through partial)
        (tc-env-partial-local-base below)
        env)]
    [_ env]))

(cfg
  test
  (define (tc-env-cache-explicit-head? [env : TcTypeEnv]) : bool
    (match (tc-type-env-view env)
      [(TcTypeEnvView.Cache _ scan-through _ _ _) (not scan-through)]
      [_ false])))

(define (tc-env-uncached-prefix-to-explicit-cache-count [env : TcTypeEnv]) : i64
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    [count : i64 0]
    [found : bool false]
    [done : bool false]
    (begin
      (while (not done)
        (cond
          [(>= head 0)
            (let
              [binding-ptr : (Ptr TcTypeEnvBinding)
                (tc-type-env-binding-ptr store-handle head)]
              (begin
                (set! count (+ count 1))
                (set! head (tc-type-env-binding-parent-at binding-ptr))))]
          [(< head -1)
            (let
              [cache : TcTypeEnvCache
                (tc-type-env-cache-at
                  (tc-type-env-cache-ptr
                    store-handle
                    (tc-type-env-cache-index head)))]
              (if cache.scan-through
                (if cache.partial
                  (let
                    [shadow-flags : (__tl_dyn-array i64) cache.shadow-flags]
                    [capacity : i64 (array.length shadow-flags)]
                    [covered : i64 (array-ref shadow-flags (- capacity 1))]
                    (begin
                      (set! count (+ count covered))
                      (set! head cache.below)))
                  (set! done true))
                (begin
                  (set! found true)
                  (set! done true))))]
          [else (set! done true)]))
      (if found
        count
        -1))))

;; Walk an exact binding count through both ordinary spine nodes and partial
;; cache nodes. `rest` is the original covered spine, so it is the authoritative
;; route when the requested boundary lies inside or immediately after a partial
;; layer.
(define (tc-env-after-cache-expanded-prefix [env : TcTypeEnv] [remaining : i64]) : TcTypeEnv
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    [left : i64 remaining]
    [done : bool false]
    (begin
      (while (and (not done) (> left 0))
        (cond
          [(>= head 0)
            (let
              [binding-ptr : (Ptr TcTypeEnvBinding)
                (tc-type-env-binding-ptr store-handle head)]
              (begin
                (set! head (tc-type-env-binding-parent-at binding-ptr))
                (set! left (- left 1))))]
          [(< head -1)
            (let
              [cache : TcTypeEnvCache
                (tc-type-env-cache-at
                  (tc-type-env-cache-ptr
                    store-handle
                    (tc-type-env-cache-index head)))]
              (if (and cache.scan-through cache.partial)
                (set! head cache.rest)
                (set! done true)))]
          [else (set! done true)]))
      (TcTypeEnv store-handle head 0))))

(define (tc-env-compact-local-if-threshold [env : TcTypeEnv]) : TcTypeEnv
  (let
    [topenv-state : TcTopEnvMembershipState
      (tc-type-env-topenv-membership-state env)]
    [topenv-mode : i64 (tc-topenv-membership-mode topenv-state)]
    (if (not (= (bit-and topenv-mode 6) 0))
      env
      (if (tc-env-uncached-prefix-reaches-cache? env (tc-local-cache-threshold))
        (let
          [below : TcTypeEnv
            (tc-env-after-prefix env (tc-local-cache-threshold))]
          (if (>=
            (tc-env-partial-layer-depth below)
            (tc-local-cache-partial-layer-cap))
            (tc-env-with-collapsed-local-cache env)
            (tc-env-with-local-cache env)))
        env))))

(define (tc-bind-id [env : TcTypeEnv] [name-id : i64] [ty : ast.AstType]) : TcTypeEnv
  (tc-env-compact-local-if-threshold (tc-bind-raw-id env name-id ty)))

(define (tc-unsafe-decl-marker-key-id? [key : i64] [name-id : i64]) : bool
  (= key (tc-unsafe-decl-marker-id name-id)))

;; Environment keys are either interner ids or packed nonnegative composite
;; ids. Negative odd/even ids form disjoint, allocation-free marker namespaces.
(define (tc-unsafe-decl-marker-id [name-id : i64]) : i64
  (- 0 (+ (* name-id 2) 1)))

(define (tc-bind-unsafe-id [env : TcTypeEnv] [name-id : i64] [ty : ast.AstType]) : TcTypeEnv
  (let
    [next-env : TcTypeEnv
      (tc-env-compact-local-if-threshold
        (tc-bind-raw-id
          (tc-bind-raw-id
            env
            (tc-unsafe-decl-marker-id name-id)
            (ast.AstType.Unit))
          name-id
          ty))]
    (begin
      (if tc-type-env-scoped-runtime-active
        (tc-type-env-scoped-runtime-mark-latest-flags-id!
          name-id
          tc-type-env-scoped-flag-unsafe)
        unit)
      next-env)))

(define (tc-c-abi-fnptr-marker-key-id? [key : i64] [name-id : i64]) : bool
  (= key (tc-c-abi-fnptr-marker-id name-id)))

(define (tc-c-abi-fnptr-marker-id [name-id : i64]) : i64
  (- 0 (+ (* name-id 2) 2)))

(define (tc-bind-c-abi-fnptr-id
  [env : TcTypeEnv]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnv
  (let
    [next-env : TcTypeEnv
      (tc-env-compact-local-if-threshold
        (tc-bind-raw-id
          (tc-bind-raw-id
            env
            (tc-c-abi-fnptr-marker-id name-id)
            (ast.AstType.Unit))
          name-id
          ty))]
    (begin
      (if tc-type-env-scoped-runtime-active
        (tc-type-env-scoped-runtime-mark-latest-flags-id!
          name-id
          tc-type-env-scoped-flag-c-abi-fnptr)
        unit)
      next-env)))

(define (tc-bind-unsafe-c-abi-fnptr-id
  [env : TcTypeEnv]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnv
  (let
    [next-env : TcTypeEnv
      (tc-env-compact-local-if-threshold
        (tc-bind-raw-id
          (tc-bind-raw-id
            (tc-bind-raw-id
              env
              (tc-c-abi-fnptr-marker-id name-id)
              (ast.AstType.Unit))
            (tc-unsafe-decl-marker-id name-id)
            (ast.AstType.Unit))
          name-id
          ty))]
    (begin
      (if tc-type-env-scoped-runtime-active
        (tc-type-env-scoped-runtime-mark-latest-flags-id!
          name-id
          (bit-or
            tc-type-env-scoped-flag-unsafe
            tc-type-env-scoped-flag-c-abi-fnptr))
        unit)
      next-env)))

(define tc-type-env-scoped-flag-unsafe : i64
  1)
(define tc-type-env-scoped-flag-c-abi-fnptr : i64
  2)
(define tc-type-env-scoped-flag-marker : i64
  4)

(define (tc-type-env-scoped-capacity [capacity : i64]) : i64
  (if (< capacity 1)
    1
    capacity))

(define (tc-type-env-scoped-marker-kind-tag [kind : TcTypeEnvScopedMarkerKind]) : i64
  (match kind
    [(TcTypeEnvScopedMarkerKind.None) 0]
    [(TcTypeEnvScopedMarkerKind.UnsafeDecl) 1]
    [(TcTypeEnvScopedMarkerKind.CAbiFnptr) 2]
    [(TcTypeEnvScopedMarkerKind.DefaultBoundary) 3]
    [(TcTypeEnvScopedMarkerKind.Region) 4]
    [(TcTypeEnvScopedMarkerKind.UnsafeContext) 5]
    [(TcTypeEnvScopedMarkerKind.CleanupOwner) 6]
    [(TcTypeEnvScopedMarkerKind.OrdinaryArenaOwner) 7]
    [(TcTypeEnvScopedMarkerKind.AtomicArenaOwner) 8]
    [(TcTypeEnvScopedMarkerKind.Other) 9]))

(define (tc-type-env-scoped-marker-kind-from-tag [tag : i64]) : TcTypeEnvScopedMarkerKind
  (cond
    [(= tag 0) TcTypeEnvScopedMarkerKind.None]
    [(= tag 1) TcTypeEnvScopedMarkerKind.UnsafeDecl]
    [(= tag 2) TcTypeEnvScopedMarkerKind.CAbiFnptr]
    [(= tag 3) TcTypeEnvScopedMarkerKind.DefaultBoundary]
    [(= tag 4) TcTypeEnvScopedMarkerKind.Region]
    [(= tag 5) TcTypeEnvScopedMarkerKind.UnsafeContext]
    [(= tag 6) TcTypeEnvScopedMarkerKind.CleanupOwner]
    [(= tag 7) TcTypeEnvScopedMarkerKind.OrdinaryArenaOwner]
    [(= tag 8) TcTypeEnvScopedMarkerKind.AtomicArenaOwner]
    [else TcTypeEnvScopedMarkerKind.Other]))

(define (tc-type-env-scoped-marker-kind-same?
  [left : TcTypeEnvScopedMarkerKind]
  [right : TcTypeEnvScopedMarkerKind]) : bool
  (=
    (tc-type-env-scoped-marker-kind-tag left)
    (tc-type-env-scoped-marker-kind-tag right)))

(define (tc-type-env-scoped-flag? [flags : i64] [flag : i64]) : bool
  (not (= (bit-and flags flag) 0)))

(define (tc-type-env-scoped-slot-c-abi-fnptr?
  [slot : (& slot TcTypeEnvScopedSlot)]) : bool
  (tc-type-env-scoped-flag? slot.flags tc-type-env-scoped-flag-c-abi-fnptr))

;; One dense latest-slot table is shared by every scoped stack. Each stack has
;; a unique epoch, so nested carriers can overwrite entries safely; restoring
;; an older carrier lazily repairs only the names it queries.
(define tc-type-env-scoped-dense-lookup-capacity : i64
  262144)
(define tc-type-env-scoped-dense-lookup-indices : (__tl_dyn-array i64)
  (array.make-array i64 tc-type-env-scoped-dense-lookup-capacity))
(define tc-type-env-scoped-dense-lookup-epochs : (__tl_dyn-array i64)
  (array.make-array i64 tc-type-env-scoped-dense-lookup-capacity))
(define tc-type-env-scoped-next-lookup-epoch : i64
  1)

(define (tc-type-env-scoped-stack-with-capacity
  [slot-capacity : i64]
  [mark-capacity : i64]) : TcTypeEnvScopedStack
  (let
    [lookup-epoch : i64 tc-type-env-scoped-next-lookup-epoch]
    (begin
      (set!
        tc-type-env-scoped-next-lookup-epoch
        (+ tc-type-env-scoped-next-lookup-epoch 1))
      (TcTypeEnvScopedStack
        (array.make-array
          TcTypeEnvScopedSlot
          (tc-type-env-scoped-capacity slot-capacity))
        0
        (box
          (tc_i64_i64_map.with-capacity
            (tc-type-env-scoped-capacity slot-capacity)))
        lookup-epoch
        (array.make-array
          TcTypeEnvScopedMark
          (tc-type-env-scoped-capacity mark-capacity))
        0
        0
        0))))

(define (tc-type-env-scoped-stack-new) : TcTypeEnvScopedStack
  (tc-type-env-scoped-stack-with-capacity 16 8))

(define (tc-type-env-scoped-stack-len [stack : TcTypeEnvScopedStack]) : i64
  stack.slot-count)

(define (tc-type-env-scoped-stack-mark-count [stack : TcTypeEnvScopedStack]) : i64
  stack.mark-count)

(define (tc-type-env-scoped-stack-scope-depth [stack : TcTypeEnvScopedStack]) : i64
  stack.scope-depth)

(define (tc-type-env-scoped-stack-cache-generation
  [stack : TcTypeEnvScopedStack]) : i64
  stack.cache-generation)

(define (tc-type-env-scoped-empty-slot) : TcTypeEnvScopedSlot
  (TcTypeEnvScopedSlot 0 (ast.AstType.Unit) 0 0 0 0))

(define (tc-type-env-scoped-empty-mark) : TcTypeEnvScopedMark
  (TcTypeEnvScopedMark 0 0 0 0))

(define (tc-type-env-scoped-stack-reserve-slots!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [min-capacity : i64]) : unit
  (begin
    (while (< (array-length stack.slots) min-capacity)
      (__tl_array-push! stack.slots (tc-type-env-scoped-empty-slot)))
    unit))

(define (tc-type-env-scoped-stack-reserve-marks!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [min-capacity : i64]) : unit
  (begin
    (while (< (array-length stack.marks) min-capacity)
      (__tl_array-push! stack.marks (tc-type-env-scoped-empty-mark)))
    unit))

(define (tc-type-env-scoped-stack-push-slot!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [name-id : i64]
  [ty : ast.AstType]
  [flags : i64]
  [marker-kind : TcTypeEnvScopedMarkerKind]) : unit
  (let
    [index : i64 stack.slot-count]
    (begin
      (tc-type-env-scoped-stack-reserve-slots! stack (+ index 1))
      ;; A restored stack reuses array storage. Invalidate the overwritten
      ;; name's cached index so an in-range hit always names this slot.
      (let
        [old-name-id : i64
          (__tl-project-field (array-ref stack.slots index) name-id)]
        (if (and
          (>= old-name-id 0)
          (< old-name-id tc-type-env-scoped-dense-lookup-capacity))
          (if (and
            (=
              (array-ref tc-type-env-scoped-dense-lookup-epochs old-name-id)
              stack.lookup-epoch)
            (=
              (array-ref tc-type-env-scoped-dense-lookup-indices old-name-id)
              index))
            (set!
              (array-ref tc-type-env-scoped-dense-lookup-epochs old-name-id)
              0)
            unit)
          (match (tc_i64_i64_map.get
            (& (__tl-box-place stack.lookup-cache))
            old-name-id)
            [(tc_i64_i64_map.LookupFound old-index)
              (if (= old-index index)
                (tc_i64_i64_map.insert-ref!
                  (&mut (__tl-box-place stack.lookup-cache))
                  old-name-id
                  -1)
                unit)]
            [(tc_i64_i64_map.LookupMissing) unit])))
      (set!
        (array-ref stack.slots index)
        (TcTypeEnvScopedSlot
          name-id
          ty
          flags
          (tc-type-env-scoped-marker-kind-tag marker-kind)
          stack.scope-depth
          stack.cache-generation))
      (if (and
        (>= name-id 0)
        (< name-id tc-type-env-scoped-dense-lookup-capacity))
        (begin
          (set!
            (array-ref tc-type-env-scoped-dense-lookup-indices name-id)
            index)
          (set!
            (array-ref tc-type-env-scoped-dense-lookup-epochs name-id)
            stack.lookup-epoch))
        (tc_i64_i64_map.insert-ref!
          (&mut (__tl-box-place stack.lookup-cache))
          name-id
          index))
      (cfg compile-profile (compiler-tc-env-profile-note-scoped-bind))
      (set! stack.slot-count (+ index 1)))))

(define (tc-type-env-scoped-stack-bind-id!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [name-id : i64]
  [ty : ast.AstType]) : unit
  (tc-type-env-scoped-stack-push-slot!
    stack
    name-id
    ty
    0
    TcTypeEnvScopedMarkerKind.None))

(define (tc-type-env-scoped-stack-bind-flags-id!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [name-id : i64]
  [ty : ast.AstType]
  [flags : i64]) : unit
  (tc-type-env-scoped-stack-push-slot!
    stack
    name-id
    ty
    flags
    TcTypeEnvScopedMarkerKind.None))

(define (tc-type-env-scoped-stack-bind-marker-id!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [name-id : i64]
  [ty : ast.AstType]
  [marker-kind : TcTypeEnvScopedMarkerKind]) : unit
  (tc-type-env-scoped-stack-push-slot!
    stack
    name-id
    ty
    tc-type-env-scoped-flag-marker
    marker-kind))

(define (tc-type-env-scoped-clamp-count [value : i64] [current : i64]) : i64
  (if (< value 0)
    0
    (if (> value current)
      current
      value)))

(define (tc-type-env-scoped-stack-save!
  [stack : (&mut stack TcTypeEnvScopedStack)]) : TcTypeEnvScopedMark
  (let
    [index : i64 stack.mark-count]
    [mark : TcTypeEnvScopedMark
      (TcTypeEnvScopedMark
        stack.slot-count
        index
        stack.scope-depth
        stack.cache-generation)]
    (begin
      (tc-type-env-scoped-stack-reserve-marks! stack (+ index 1))
      (set! (array-ref stack.marks index) mark)
      (set! stack.mark-count (+ index 1))
      (set! stack.scope-depth (+ stack.scope-depth 1))
      mark)))

(define (tc-type-env-scoped-stack-restore!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [mark : TcTypeEnvScopedMark]) : unit
  (begin
    (set!
      stack.slot-count
      (tc-type-env-scoped-clamp-count mark.slot-count stack.slot-count))
    (set!
      stack.mark-count
      (tc-type-env-scoped-clamp-count mark.mark-count stack.mark-count))
    (set!
      stack.scope-depth
      (tc-type-env-scoped-clamp-count mark.scope-depth stack.scope-depth))
    (set! stack.cache-generation (+ stack.cache-generation 1))))

(define (tc-type-env-scoped-stack-lookup-id-at
  [stack : TcTypeEnvScopedStack]
  [index : i64]) : TcTypeEnvScopedLookup
  (if (< index 0)
    TcTypeEnvScopedLookup.Missing
    (let
      [slot : TcTypeEnvScopedSlot (array-ref stack.slots index)]
      (TcTypeEnvScopedLookup.Found
        slot.ty
        (tc-type-env-scoped-flag? slot.flags tc-type-env-scoped-flag-unsafe)
        (tc-type-env-scoped-flag?
          slot.flags
          tc-type-env-scoped-flag-c-abi-fnptr)
        (tc-type-env-scoped-marker-kind-from-tag slot.marker-kind-tag)
        slot.scope-depth
        slot.generation))))

(define (tc-type-env-scoped-stack-dense-lookup-id-refresh
  [stack : (& stack TcTypeEnvScopedStack)]
  [name-id : i64]) : i64
  (let
    [index : i64
      (tc-type-env-scoped-stack-find-id-index-from
        stack
        name-id
        (- stack.slot-count 1))]
    (begin
      (set! (array-ref tc-type-env-scoped-dense-lookup-indices name-id) index)
      (set!
        (array-ref tc-type-env-scoped-dense-lookup-epochs name-id)
        stack.lookup-epoch)
      (cfg compile-profile (compiler-tc-env-profile-note-scoped-cache-miss))
      index)))

(define (tc-type-env-scoped-stack-map-cached-index
  [lookup-cache : (& lookup-cache tc_i64_i64_map.Map)]
  [name-id : i64]) : i64
  (match (tc_i64_i64_map.get lookup-cache name-id)
    [(tc_i64_i64_map.LookupFound index) index]
    [(tc_i64_i64_map.LookupMissing) -2]))

(define (tc-type-env-scoped-stack-map-lookup-id
  [stack : (& stack TcTypeEnvScopedStack)]
  [name-id : i64]) : i64
  (let
    [lookup-cache : (Box tc_i64_i64_map.Map) stack.lookup-cache]
    [index : i64
      (tc-type-env-scoped-stack-map-cached-index
        (& (__tl-box-place lookup-cache))
        name-id)]
    (if (= index -2)
      (begin
        (cfg compile-profile (compiler-tc-env-profile-note-scoped-cache-miss))
        -1)
      (if (and
        (>= index 0)
        (< index stack.slot-count)
        (= (__tl-project-field (array-ref stack.slots index) name-id) name-id))
        (begin
          (cfg compile-profile (compiler-tc-env-profile-note-scoped-cache-hit))
          index)
        (begin
          (cfg compile-profile (compiler-tc-env-profile-note-scoped-cache-miss))
          (let
            [repaired-index : i64
              (tc-type-env-scoped-stack-find-id-index-from
                stack
                name-id
                (- stack.slot-count 1))]
            (begin
              (tc_i64_i64_map.insert-ref!
                (&mut (__tl-box-place lookup-cache))
                name-id
                repaired-index)
              repaired-index)))))))

(define (tc-type-env-scoped-stack-lookup-index
  [stack : TcTypeEnvScopedStack]
  [name-id : i64]) : i64
  (if (and (>= name-id 0) (< name-id tc-type-env-scoped-dense-lookup-capacity))
    (if (=
      (array-ref tc-type-env-scoped-dense-lookup-epochs name-id)
      stack.lookup-epoch)
      (let
        [index : i64
          (array-ref tc-type-env-scoped-dense-lookup-indices name-id)]
        (if (< index 0)
          (begin
            (cfg
              compile-profile
              (compiler-tc-env-profile-note-scoped-cache-hit))
            -1)
          (if (< index stack.slot-count)
            (begin
              (cfg
                compile-profile
                (compiler-tc-env-profile-note-scoped-cache-hit))
              index)
            (tc-type-env-scoped-stack-dense-lookup-id-refresh (& stack) name-id))))
      (tc-type-env-scoped-stack-dense-lookup-id-refresh (& stack) name-id))
    (tc-type-env-scoped-stack-map-lookup-id stack name-id)))

(define (tc-type-env-scoped-stack-lookup-id
  [stack : TcTypeEnvScopedStack]
  [name-id : i64]) : TcTypeEnvScopedLookup
  (tc-type-env-scoped-stack-lookup-id-at
    stack
    (tc-type-env-scoped-stack-lookup-index stack name-id)))

(define (tc-type-env-scoped-stack-marker-lookup-from
  [stack : TcTypeEnvScopedStack]
  [marker-kind : TcTypeEnvScopedMarkerKind]
  [index : i64]) : TcTypeEnvScopedMarkerLookup
  (if (< index 0)
    TcTypeEnvScopedMarkerLookup.Missing
    (let
      [slot : TcTypeEnvScopedSlot (array-ref stack.slots index)]
      (if (and
        (tc-type-env-scoped-flag? slot.flags tc-type-env-scoped-flag-marker)
        (=
          slot.marker-kind-tag
          (tc-type-env-scoped-marker-kind-tag marker-kind)))
        (TcTypeEnvScopedMarkerLookup.Found
          slot.name-id
          slot.ty
          slot.scope-depth
          slot.generation)
        (tc-type-env-scoped-stack-marker-lookup-from
          stack
          marker-kind
          (- index 1))))))

(define (tc-type-env-scoped-stack-marker-lookup
  [stack : TcTypeEnvScopedStack]
  [marker-kind : TcTypeEnvScopedMarkerKind]) : TcTypeEnvScopedMarkerLookup
  (tc-type-env-scoped-stack-marker-lookup-from
    stack
    marker-kind
    (- stack.slot-count 1)))

(define (tc-type-env-scoped-stack-owner-marker-before?
  [stack : TcTypeEnvScopedStack]
  [index : i64]
  [name-id : i64]
  [marker-id : i64]) : bool
  (if (<= index 0)
    false
    (let
      [slot : TcTypeEnvScopedSlot (array-ref stack.slots (- index 1))]
      (tc-arena-owner-marker-for? marker-id slot.name-id slot.ty name-id))))

(define (tc-type-env-scoped-stack-cleanup-owner-before?
  [stack : TcTypeEnvScopedStack]
  [index : i64]
  [name-id : i64]) : bool
  (if (<= index 0)
    false
    (let
      [slot : TcTypeEnvScopedSlot (array-ref stack.slots (- index 1))]
      (tc-cleanup-owner-marker-for? slot.name-id slot.ty name-id))))

(define (tc-type-env-scoped-marker-cursor [stack : TcTypeEnvScopedStack]) : TcTypeEnvScopedMarkerCursor
  (TcTypeEnvScopedMarkerCursor stack (- (tc-type-env-scoped-stack-len stack) 1)))

(define (tc-type-env-scoped-marker-step [cursor : TcTypeEnvScopedMarkerCursor]) : TcTypeEnvScopedMarkerStep
  (let
    [index : i64 cursor.index]
    (if (< index 0)
      TcTypeEnvScopedMarkerStep.Done
      (let
        [slot : TcTypeEnvScopedSlot (array-ref cursor.stack.slots index)]
        (TcTypeEnvScopedMarkerStep.Bind
          slot.name-id
          slot.ty
          (TcTypeEnvScopedMarkerCursor cursor.stack (- index 1)))))))

(define (tc-type-env-scoped-stack-find-id-index-from
  [stack : (& stack TcTypeEnvScopedStack)]
  [name-id : i64]
  [index : i64]) : i64
  (if (< index 0)
    -1
    (let
      [slot : TcTypeEnvScopedSlot (array-ref stack.slots index)]
      (if (= slot.name-id name-id)
        index
        (tc-type-env-scoped-stack-find-id-index-from stack name-id (- index 1))))))

(define (tc-type-env-scoped-stack-find-id-index
  [stack : (& stack TcTypeEnvScopedStack)]
  [name-id : i64]) : i64
  (tc-type-env-scoped-stack-find-id-index-from
    stack
    name-id
    (- stack.slot-count 1)))

(define (tc-type-env-scoped-stack-find-lifetime-index-from
  [stack : TcTypeEnvScopedStack]
  [session : cis.InternStructuralSessionHandle]
  [lifetime-id : i64]
  [signature-marker-id : i64]
  [index : i64]) : i64
  (if (< index 0)
    -1
    (let
      [slot : TcTypeEnvScopedSlot (array-ref stack.slots index)]
      (if (tc-env-binding-matches-lifetime-id?
        session
        slot.name-id
        slot.ty
        lifetime-id
        signature-marker-id)
        index
        (tc-type-env-scoped-stack-find-lifetime-index-from
          stack
          session
          lifetime-id
          signature-marker-id
          (- index 1))))))

(define (tc-type-env-scoped-stack-find-lifetime-index
  [stack : TcTypeEnvScopedStack]
  [session : cis.InternStructuralSessionHandle]
  [lifetime-id : i64]) : i64
  (tc-type-env-scoped-stack-find-lifetime-index-from
    stack
    session
    lifetime-id
    (tc-signature-lifetime-marker-id)
    (- (tc-type-env-scoped-stack-len stack) 1)))

(define (tc-type-env-scoped-stack-signature-lifetime-index?
  [stack : TcTypeEnvScopedStack]
  [index : i64]
  [lifetime-id : i64]) : bool
  (if (< index 0)
    false
    (let
      [slot : TcTypeEnvScopedSlot (array-ref stack.slots index)]
      (tc-signature-lifetime-marker-entry-id?
        slot.name-id
        slot.ty
        lifetime-id
        (tc-signature-lifetime-marker-id)))))

(define (tc-type-env-scoped-visible-marker-kind
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnvScopedMarkerKind
  (cond
    [(= name-id (tc-unsafe-marker-id)) TcTypeEnvScopedMarkerKind.UnsafeContext]
    [(= name-id (tc-return-type-id)) TcTypeEnvScopedMarkerKind.Other]
    [(= name-id (tc-loop-target-id)) TcTypeEnvScopedMarkerKind.Other]
    [(= name-id (tc-default-boundary-id))
      TcTypeEnvScopedMarkerKind.DefaultBoundary]
    [(= name-id (tc-region-marker-id)) TcTypeEnvScopedMarkerKind.Region]
    [(= name-id (tc-signature-lifetime-marker-id))
      TcTypeEnvScopedMarkerKind.Other]
    [(tc-cleanup-owner-marker-entry? name-id ty)
      TcTypeEnvScopedMarkerKind.CleanupOwner]
    [(tc-ordinary-arena-owner-marker-entry? name-id ty)
      TcTypeEnvScopedMarkerKind.OrdinaryArenaOwner]
    [(tc-atomic-arena-owner-marker-entry? name-id ty)
      TcTypeEnvScopedMarkerKind.AtomicArenaOwner]
    [else TcTypeEnvScopedMarkerKind.None]))

(define (tc-type-env-scoped-visible-bind-flags
  [rest-env : TcTypeEnv]
  [name-id : i64]) : i64
  (bit-or
    (if (tc-binding-unsafe-marker-head-id? rest-env name-id)
      tc-type-env-scoped-flag-unsafe
      0)
    (if (tc-c-abi-fnptr-marker-near-id? rest-env name-id 3)
      tc-type-env-scoped-flag-c-abi-fnptr
      0)))

(define (tc-type-env-scoped-stack-push-visible-bind!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [name-id : i64]
  [ty : ast.AstType]
  [rest-env : TcTypeEnv]) : unit
  (let
    [marker-kind : TcTypeEnvScopedMarkerKind
      (tc-type-env-scoped-visible-marker-kind name-id ty)]
    [flags : i64 (tc-type-env-scoped-visible-bind-flags rest-env name-id)]
    [slot-flags : i64
      (if (tc-type-env-scoped-marker-kind-same?
        marker-kind
        TcTypeEnvScopedMarkerKind.None)
        flags
        (bit-or flags tc-type-env-scoped-flag-marker))]
    (tc-type-env-scoped-stack-push-slot!
      stack
      name-id
      ty
      slot-flags
      marker-kind)))

(define (tc-type-env-scoped-sidecar-fill-visible-env!
  [sidecar : (&mut sidecar TcTypeEnvScopedSidecar)]
  [env : TcTypeEnv]) : unit
  (match (tc-type-env-marker-step env)
    [(TcTypeEnvMarkerStep.Done) unit]
    [(TcTypeEnvMarkerStep.Cache rest-env)
      (tc-type-env-scoped-sidecar-fill-visible-env! sidecar rest-env)]
    [(TcTypeEnvMarkerStep.Bind key ty rest-env)
      (begin
        (tc-type-env-scoped-sidecar-fill-visible-env! sidecar rest-env)
        (tc-type-env-scoped-stack-push-visible-bind!
          (&mut sidecar.stack)
          key
          ty
          rest-env))]))

(define (tc-type-env-scoped-sidecar-from-marker-visible-env [env : TcTypeEnv]) : TcTypeEnvScopedSidecar
  (let
    [sidecar : TcTypeEnvScopedSidecar (tc-type-env-scoped-sidecar-from-env env)]
    (begin
      (tc-type-env-scoped-sidecar-fill-visible-env!
        (&mut sidecar)
        (tc-type-env-marker-start env))
      (set!
        sidecar.materialize-start
        (tc-type-env-scoped-stack-len sidecar.stack))
      sidecar)))

(define (tc-type-env-scoped-sidecar-from-env [env : TcTypeEnv]) : TcTypeEnvScopedSidecar
  (TcTypeEnvScopedSidecar env (tc-type-env-scoped-stack-new) 0))

(define (tc-type-env-scoped-sidecar-new) : TcTypeEnvScopedSidecar
  (tc-type-env-scoped-sidecar-from-env (tc-empty-env)))

(define (tc-type-env-scoped-sidecar-marker-cursor
  [sidecar : TcTypeEnvScopedSidecar]) : TcTypeEnvScopedMarkerCursor
  (tc-type-env-scoped-marker-cursor sidecar.stack))

(define (tc-type-env-scoped-sidecar-persistent
  [sidecar : TcTypeEnvScopedSidecar]) : TcTypeEnv
  sidecar.persistent)

(define (tc-type-env-scoped-sidecar-lookup-id
  [sidecar : TcTypeEnvScopedSidecar]
  [name-id : i64]) : TcTypeEnvScopedLookup
  (tc-type-env-scoped-stack-lookup-id sidecar.stack name-id))

(define (tc-type-env-scoped-sidecar-save!
  [sidecar : (&mut sidecar TcTypeEnvScopedSidecar)]) : TcTypeEnvScopedMark
  (tc-type-env-scoped-stack-save! (&mut sidecar.stack)))

(define (tc-type-env-scoped-sidecar-mark
  [sidecar : TcTypeEnvScopedSidecar]
  [stack-mark : TcTypeEnvScopedMark]) : TcTypeEnvScopedSidecarMark
  (TcTypeEnvScopedSidecarMark
    sidecar.persistent
    stack-mark
    sidecar.materialize-start))

(define (tc-type-env-scoped-sidecar-restore!
  [sidecar : (&mut sidecar TcTypeEnvScopedSidecar)]
  [mark : TcTypeEnvScopedSidecarMark]) : unit
  (begin
    (set! sidecar.persistent mark.persistent)
    (set! sidecar.materialize-start mark.materialize-start)
    (tc-type-env-scoped-stack-restore! (&mut sidecar.stack) mark.stack-mark)))

(define (tc-type-env-scoped-sidecar-bind-id
  [sidecar : TcTypeEnvScopedSidecar (:consume)]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnvScopedSidecar
  (let
    [next : TcTypeEnvScopedSidecar sidecar]
    (begin
      (tc-type-env-scoped-stack-bind-id! (&mut next.stack) name-id ty)
      next)))

(define (tc-type-env-scoped-sidecar-bind-marker-id
  [sidecar : TcTypeEnvScopedSidecar (:consume)]
  [name-id : i64]
  [ty : ast.AstType]
  [marker-kind : TcTypeEnvScopedMarkerKind]) : TcTypeEnvScopedSidecar
  (let
    [next : TcTypeEnvScopedSidecar sidecar]
    (begin
      (tc-type-env-scoped-stack-bind-marker-id!
        (&mut next.stack)
        name-id
        ty
        marker-kind)
      next)))

(define (tc-type-env-scoped-sidecar-enter-unsafe
  [sidecar : TcTypeEnvScopedSidecar (:consume)]) : TcTypeEnvScopedSidecar
  (tc-type-env-scoped-sidecar-bind-marker-id
    sidecar
    (tc-unsafe-marker-id)
    (ast.AstType.Unit)
    TcTypeEnvScopedMarkerKind.UnsafeContext))

(define (tc-type-env-scoped-sidecar-bind-return-type
  [sidecar : TcTypeEnvScopedSidecar (:consume)]
  [ty : ast.AstType]) : TcTypeEnvScopedSidecar
  (tc-type-env-scoped-sidecar-bind-marker-id
    sidecar
    (tc-return-type-id)
    ty
    TcTypeEnvScopedMarkerKind.Other))

(define (tc-type-env-scoped-sidecar-bind-default-boundary
  [sidecar : TcTypeEnvScopedSidecar (:consume)]) : TcTypeEnvScopedSidecar
  (tc-type-env-scoped-sidecar-bind-marker-id
    sidecar
    (tc-default-boundary-id)
    (ast.AstType.Unit)
    TcTypeEnvScopedMarkerKind.DefaultBoundary))

(define (tc-type-env-scoped-sidecar-push-region
  [sidecar : TcTypeEnvScopedSidecar (:consume)]
  [region : i64]) : TcTypeEnvScopedSidecar
  (tc-type-env-scoped-sidecar-bind-marker-id
    sidecar
    (tc-region-marker-id)
    (ast.AstType.Var region)
    TcTypeEnvScopedMarkerKind.Region))

(define (tc-type-env-scoped-sidecar-bind-cleanup-owner
  [sidecar : TcTypeEnvScopedSidecar (:consume)]
  [name-id : i64]) : TcTypeEnvScopedSidecar
  (tc-type-env-scoped-sidecar-bind-marker-id
    sidecar
    (tc-cleanup-owner-marker-id)
    (ast.AstType.Var name-id)
    TcTypeEnvScopedMarkerKind.CleanupOwner))

(define (tc-type-env-scoped-sidecar-bind-ordinary-arena-owner
  [sidecar : TcTypeEnvScopedSidecar (:consume)]
  [name-id : i64]) : TcTypeEnvScopedSidecar
  (tc-type-env-scoped-sidecar-bind-marker-id
    sidecar
    (tc-ordinary-arena-owner-marker-id)
    (ast.AstType.Var name-id)
    TcTypeEnvScopedMarkerKind.OrdinaryArenaOwner))

(define (tc-type-env-scoped-sidecar-bind-atomic-arena-owner
  [sidecar : TcTypeEnvScopedSidecar (:consume)]
  [name-id : i64]) : TcTypeEnvScopedSidecar
  (tc-type-env-scoped-sidecar-bind-marker-id
    sidecar
    (tc-atomic-arena-owner-marker-id)
    (ast.AstType.Var name-id)
    TcTypeEnvScopedMarkerKind.AtomicArenaOwner))

(define (tc-type-env-scoped-sidecar-bind-unsafe-c-abi-fnptr-id
  [sidecar : TcTypeEnvScopedSidecar (:consume)]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnvScopedSidecar
  (let
    [next : TcTypeEnvScopedSidecar sidecar]
    (begin
      (tc-type-env-scoped-stack-bind-marker-id!
        (&mut next.stack)
        (tc-c-abi-fnptr-marker-id name-id)
        (ast.AstType.Unit)
        TcTypeEnvScopedMarkerKind.CAbiFnptr)
      (tc-type-env-scoped-stack-bind-marker-id!
        (&mut next.stack)
        (tc-unsafe-decl-marker-id name-id)
        (ast.AstType.Unit)
        TcTypeEnvScopedMarkerKind.UnsafeDecl)
      (tc-type-env-scoped-stack-bind-flags-id!
        (&mut next.stack)
        name-id
        ty
        (bit-or
          tc-type-env-scoped-flag-unsafe
          tc-type-env-scoped-flag-c-abi-fnptr))
      next)))

;; The scoped stack owns local bindings. The persistent env is an immutable
;; module/top-level tail and is materialized only when an older TcTypeEnv API
;; explicitly asks for a snapshot. Walking slots from oldest to newest rebuilds
;; the same head-first lexical order without putting a persistent node on every
;; carrier bind.
(define (tc-type-env-scoped-stack-materialize-at
  [stack : TcTypeEnvScopedStack]
  [index : i64]
  [env : TcTypeEnv]) : TcTypeEnv
  (if (>= index (tc-type-env-scoped-stack-len stack))
    env
    (let
      [slot : TcTypeEnvScopedSlot (array-ref stack.slots index)]
      (tc-type-env-scoped-stack-materialize-at
        stack
        (+ index 1)
        (begin
          (cfg compile-profile (compiler-tc-env-profile-note-bind))
          (tc-type-env-bind-node env slot.name-id slot.ty))))))

(define (tc-type-env-scoped-sidecar-materialize
  [sidecar : TcTypeEnvScopedSidecar]) : TcTypeEnv
  (begin
    (cfg
      compile-profile
      (compiler-tc-env-profile-note-scoped-materialization
        (-
          (tc-type-env-scoped-stack-len sidecar.stack)
          sidecar.materialize-start)))
    (tc-type-env-scoped-stack-materialize-at
      sidecar.stack
      sidecar.materialize-start
      sidecar.persistent)))

(define (tc-type-env-scoped-carrier-from-env [env : TcTypeEnv]) : TcTypeEnvScopedCarrier
  (TcTypeEnvScopedCarrier env (tc-type-env-scoped-sidecar-from-env env) false))

(define (tc-type-env-scoped-carrier-from-marker-visible-env [env : TcTypeEnv]) : TcTypeEnvScopedCarrier
  (TcTypeEnvScopedCarrier
    env
    (tc-type-env-scoped-sidecar-from-marker-visible-env env)
    false))

(define (tc-type-env-scoped-carrier-new) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-from-env (tc-empty-env)))

(define (tc-type-env-scoped-carrier-env [carrier : TcTypeEnvScopedCarrier]) : TcTypeEnv
  (if carrier.dirty
    (tc-type-env-scoped-sidecar-materialize carrier.sidecar)
    carrier.env))

(define (tc-type-env-scoped-carrier-sidecar [carrier : TcTypeEnvScopedCarrier]) : TcTypeEnvScopedSidecar
  carrier.sidecar)

(define (tc-type-env-scoped-carrier-persistent
  [carrier : TcTypeEnvScopedCarrier]) : TcTypeEnv
  (tc-type-env-scoped-sidecar-persistent carrier.sidecar))

(define (tc-type-env-scoped-carrier-marker-cursor
  [carrier : TcTypeEnvScopedCarrier]) : TcTypeEnvScopedMarkerCursor
  (tc-type-env-scoped-sidecar-marker-cursor carrier.sidecar))

(define (tc-type-env-scoped-carrier-with-sidecar
  [carrier : TcTypeEnvScopedCarrier]
  [sidecar : TcTypeEnvScopedSidecar]) : TcTypeEnvScopedCarrier
  (TcTypeEnvScopedCarrier carrier.env sidecar true))

(define (tc-type-env-scoped-carrier-save
  [carrier : TcTypeEnvScopedCarrier (:consume)]) : TcTypeEnvScopedCarrierSave
  (let
    [sidecar : TcTypeEnvScopedSidecar carrier.sidecar]
    [stack-mark : TcTypeEnvScopedMark
      (tc-type-env-scoped-sidecar-save! (&mut sidecar))]
    (TcTypeEnvScopedCarrierSave
      (TcTypeEnvScopedCarrier carrier.env sidecar carrier.dirty)
      (TcTypeEnvScopedCarrierMark
        carrier.env
        (tc-type-env-scoped-sidecar-mark sidecar stack-mark)
        carrier.dirty))))

(define (tc-type-env-scoped-carrier-snapshot-mark
  [carrier : TcTypeEnvScopedCarrier]) : TcTypeEnvScopedCarrierMark
  (let
    [sidecar : TcTypeEnvScopedSidecar carrier.sidecar]
    [stack : TcTypeEnvScopedStack sidecar.stack]
    (TcTypeEnvScopedCarrierMark
      carrier.env
      (tc-type-env-scoped-sidecar-mark
        sidecar
        (TcTypeEnvScopedMark
          stack.slot-count
          stack.mark-count
          stack.scope-depth
          stack.cache-generation))
      carrier.dirty)))

(define (tc-type-env-scoped-carrier-restore
  [carrier : TcTypeEnvScopedCarrier (:consume)]
  [mark : TcTypeEnvScopedCarrierMark]) : TcTypeEnvScopedCarrier
  (let
    [sidecar : TcTypeEnvScopedSidecar carrier.sidecar]
    (begin
      (tc-type-env-scoped-sidecar-restore! (&mut sidecar) mark.sidecar-mark)
      (TcTypeEnvScopedCarrier mark.env sidecar mark.dirty))))

(define (tc-type-env-scoped-carrier-bind-id
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-with-sidecar
    carrier
    (tc-type-env-scoped-sidecar-bind-id carrier.sidecar name-id ty)))

(define (tc-type-env-scoped-carrier-enter-unsafe
  [carrier : TcTypeEnvScopedCarrier (:consume)]) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-with-sidecar
    carrier
    (tc-type-env-scoped-sidecar-enter-unsafe carrier.sidecar)))

(define (tc-type-env-scoped-carrier-bind-return-type
  [carrier : TcTypeEnvScopedCarrier (:consume)]
  [ty : ast.AstType]) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-with-sidecar
    carrier
    (tc-type-env-scoped-sidecar-bind-return-type carrier.sidecar ty)))

(define (tc-type-env-scoped-carrier-bind-default-boundary
  [carrier : TcTypeEnvScopedCarrier (:consume)]) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-with-sidecar
    carrier
    (tc-type-env-scoped-sidecar-bind-default-boundary carrier.sidecar)))

(define (tc-type-env-scoped-carrier-push-region
  [carrier : TcTypeEnvScopedCarrier (:consume)]
  [region : i64]) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-with-sidecar
    carrier
    (tc-type-env-scoped-sidecar-push-region carrier.sidecar region)))

(define (tc-type-env-scoped-carrier-bind-cleanup-owner
  [carrier : TcTypeEnvScopedCarrier (:consume)]
  [name-id : i64]) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-with-sidecar
    carrier
    (tc-type-env-scoped-sidecar-bind-cleanup-owner carrier.sidecar name-id)))

(define (tc-type-env-scoped-carrier-bind-ordinary-arena-owner
  [carrier : TcTypeEnvScopedCarrier (:consume)]
  [name-id : i64]) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-with-sidecar
    carrier
    (tc-type-env-scoped-sidecar-bind-ordinary-arena-owner
      carrier.sidecar
      name-id)))

(define (tc-type-env-scoped-carrier-bind-atomic-arena-owner
  [carrier : TcTypeEnvScopedCarrier (:consume)]
  [name-id : i64]) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-with-sidecar
    carrier
    (tc-type-env-scoped-sidecar-bind-atomic-arena-owner carrier.sidecar name-id)))

(define (tc-type-env-scoped-carrier-bind-unsafe-c-abi-fnptr-id
  [carrier : TcTypeEnvScopedCarrier (:consume)]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-with-sidecar
    carrier
    (tc-type-env-scoped-sidecar-bind-unsafe-c-abi-fnptr-id
      carrier.sidecar
      name-id
      ty)))

(define (tc-type-env-scoped-carrier-lookup-id
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : ResultTcType
  (let
    [sidecar : TcTypeEnvScopedSidecar carrier.sidecar]
    [stack : TcTypeEnvScopedStack sidecar.stack]
    [index : i64 (tc-type-env-scoped-stack-lookup-index stack name-id)]
    (if (>= index 0)
      (ResultTcType.Ok (__tl-project-field (array-ref stack.slots index) ty))
      (begin
        (cfg
          compile-profile
          (compiler-tc-env-profile-note-scoped-tail-fallback))
        (tc-lookup-persistent-id
          (tc-type-env-scoped-sidecar-persistent sidecar)
          name-id)))))

(define (tc-type-env-scoped-carrier-name-bound-id?
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : bool
  (let
    [sidecar : TcTypeEnvScopedSidecar carrier.sidecar]
    [stack : TcTypeEnvScopedStack sidecar.stack]
    (if (>= (tc-type-env-scoped-stack-lookup-index stack name-id) 0)
      true
      (begin
        (cfg
          compile-profile
          (compiler-tc-env-profile-note-scoped-tail-fallback))
        (tc-name-bound-persistent-id?
          (tc-type-env-scoped-sidecar-persistent sidecar)
          name-id)))))

(define (tc-type-env-scoped-carrier-bind-alias-id-if-free
  [carrier : TcTypeEnvScopedCarrier (:consume)]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnvScopedCarrier
  (if (tc-type-env-scoped-carrier-name-bound-id? carrier name-id)
    carrier
    (tc-type-env-scoped-carrier-bind-id carrier name-id ty)))

(define (tc-type-env-scoped-carrier-lookup-unsafe-id
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : ResultTcTypeUnsafe
  (let
    [sidecar : TcTypeEnvScopedSidecar carrier.sidecar]
    [stack : TcTypeEnvScopedStack sidecar.stack]
    [index : i64 (tc-type-env-scoped-stack-lookup-index stack name-id)]
    (if (>= index 0)
      (let
        [slot : TcTypeEnvScopedSlot (array-ref stack.slots index)]
        (ResultTcTypeUnsafe.Ok
          slot.ty
          (tc-type-env-scoped-flag? slot.flags tc-type-env-scoped-flag-unsafe)))
      (begin
        (cfg
          compile-profile
          (compiler-tc-env-profile-note-scoped-tail-fallback))
        (tc-lookup-unsafe-persistent-id
          (tc-type-env-scoped-sidecar-persistent sidecar)
          name-id)))))

(define (tc-type-env-scoped-carrier-binding-unsafe-id?
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : bool
  (match (tc-type-env-scoped-carrier-lookup-unsafe-id carrier name-id)
    [(ResultTcTypeUnsafe.Ok _ unsafe) unsafe]
    [(ResultTcTypeUnsafe.Err _) false]))

(define (tc-type-env-scoped-carrier-binding-c-abi-fnptr-id?
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : bool
  (let
    [sidecar : TcTypeEnvScopedSidecar carrier.sidecar]
    [stack : TcTypeEnvScopedStack sidecar.stack]
    [index : i64 (tc-type-env-scoped-stack-lookup-index stack name-id)]
    (if (>= index 0)
      (tc-type-env-scoped-slot-c-abi-fnptr? (array-ref stack.slots index))
      (begin
        (cfg
          compile-profile
          (compiler-tc-env-profile-note-scoped-tail-fallback))
        (tc-binding-c-abi-fnptr-persistent-id?
          (tc-type-env-scoped-sidecar-persistent sidecar)
          name-id)))))

(define (tc-type-env-scoped-carrier-marker-type
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : ast.AstMaybeType
  (match (tc-type-env-scoped-sidecar-lookup-id carrier.sidecar name-id)
    [(TcTypeEnvScopedLookup.Found ty _ _ _ _ _) (ast.AstMaybeType.Some ty)]
    [(TcTypeEnvScopedLookup.Missing)
      (tc-env-marker-type
        (tc-type-env-scoped-sidecar-persistent carrier.sidecar)
        name-id)]))

(define (tc-type-env-scoped-carrier-in-unsafe?
  [carrier : TcTypeEnvScopedCarrier]) : bool
  (match (tc-type-env-scoped-carrier-marker-type carrier (tc-unsafe-marker-id))
    [(ast.AstMaybeType.Some _) true]
    [(ast.AstMaybeType.No) false]))

(define (tc-type-env-scoped-carrier-current-return-type
  [carrier : TcTypeEnvScopedCarrier]) : ResultTcType
  (match (tc-type-env-scoped-carrier-marker-type carrier (tc-return-type-id))
    [(ast.AstMaybeType.Some ty) (ResultTcType.Ok ty)]
    [(ast.AstMaybeType.No)
      (ResultTcType.Err
        "typecheck: try requires enclosing Result-like function")]))

(define (tc-type-env-scoped-carrier-active-region
  [carrier : TcTypeEnvScopedCarrier]) : TcMaybeNameId
  (match (tc-type-env-scoped-carrier-marker-type carrier (tc-region-marker-id))
    [(ast.AstMaybeType.Some (ast.AstType.Var region))
      (TcMaybeNameId.Some region)]
    [(ast.AstMaybeType.Some _) (tc-active-region carrier.env)]
    [(ast.AstMaybeType.No) (TcMaybeNameId.No)]))

;; Fully materialized marker-visible snapshots and the active function-body
;; runtime use stack indexes here. A miss falls back only to the carrier's
;; immutable module/top-level tail; inactive passes keep using TcTypeEnv's
;; relevance-indexed owner cache below.
(define (tc-type-env-scoped-carrier-cleanup-owner-active?
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : bool
  (let
    [stack : TcTypeEnvScopedStack carrier.sidecar.stack]
    [index : i64 (tc-type-env-scoped-stack-find-id-index (& stack) name-id)]
    (if (>= index 0)
      (tc-type-env-scoped-stack-cleanup-owner-before? stack index name-id)
      (tc-cleanup-owner-active-persistent-id?
        (tc-type-env-scoped-carrier-persistent carrier)
        name-id))))

(define (tc-type-env-scoped-carrier-arena-owner-active?
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]
  [marker-id : i64]) : bool
  (let
    [stack : TcTypeEnvScopedStack carrier.sidecar.stack]
    [index : i64 (tc-type-env-scoped-stack-find-id-index (& stack) name-id)]
    (if (>= index 0)
      (tc-type-env-scoped-stack-owner-marker-before?
        stack
        index
        name-id
        marker-id)
      (tc-arena-owner-active-persistent-id?
        (tc-type-env-scoped-carrier-persistent carrier)
        name-id
        marker-id))))

(define (tc-type-env-scoped-carrier-ordinary-arena-owner-active?
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : bool
  (tc-type-env-scoped-carrier-arena-owner-active?
    carrier
    name-id
    (tc-ordinary-arena-owner-marker-id)))

(define (tc-type-env-scoped-carrier-atomic-arena-owner-active?
  [carrier : TcTypeEnvScopedCarrier]
  [name-id : i64]) : bool
  (tc-type-env-scoped-carrier-arena-owner-active?
    carrier
    name-id
    (tc-atomic-arena-owner-marker-id)))

(define tc-type-env-scoped-cache-visible-valid : bool
  false)
(define tc-type-env-scoped-cache-visible-len : i64
  -1)
(define tc-type-env-scoped-cache-visible-generation : i64
  -1)
(define tc-type-env-scoped-cache-visible-session-owner : i64
  -1)
(define tc-type-env-scoped-cache-visible-session-generation : i64
  -1)
(define tc-type-env-scoped-cache-visible-lifetime-id : i64
  -1)
(define tc-type-env-scoped-cache-visible-result : bool
  false)
(define tc-type-env-scoped-cache-outlives-binding-valid : bool
  false)
(define tc-type-env-scoped-cache-outlives-binding-len : i64
  -1)
(define tc-type-env-scoped-cache-outlives-binding-generation : i64
  -1)
(define tc-type-env-scoped-cache-outlives-binding-session-owner : i64
  -1)
(define tc-type-env-scoped-cache-outlives-binding-session-generation : i64
  -1)
(define tc-type-env-scoped-cache-outlives-binding-lifetime-id : i64
  -1)
(define tc-type-env-scoped-cache-outlives-binding-target-id : i64
  -1)
(define tc-type-env-scoped-cache-outlives-binding-result : bool
  false)
(define tc-type-env-scoped-cache-outlives-lifetime-valid : bool
  false)
(define tc-type-env-scoped-cache-outlives-lifetime-len : i64
  -1)
(define tc-type-env-scoped-cache-outlives-lifetime-generation : i64
  -1)
(define tc-type-env-scoped-cache-outlives-lifetime-session-owner : i64
  -1)
(define tc-type-env-scoped-cache-outlives-lifetime-session-generation : i64
  -1)
(define tc-type-env-scoped-cache-outlives-lifetime-value-id : i64
  -1)
(define tc-type-env-scoped-cache-outlives-lifetime-target-id : i64
  -1)
(define tc-type-env-scoped-cache-outlives-lifetime-result : bool
  false)

(define (tc-type-env-scoped-cache-clear!) : unit
  (begin
    (set! tc-type-env-scoped-cache-visible-valid false)
    (set! tc-type-env-scoped-cache-outlives-binding-valid false)
    (set! tc-type-env-scoped-cache-outlives-lifetime-valid false)))

(define (tc-type-env-scoped-carrier-lifetime-visible-id?
  [carrier : TcTypeEnvScopedCarrier]
  [lifetime-id : i64]) : bool
  (let
    [stack : TcTypeEnvScopedStack carrier.sidecar.stack]
    [session : cis.InternStructuralSessionHandle
      (tc-type-env-structural-session carrier.env)]
    [session-owner : i64 (cis.intern-structural-session-owner session)]
    [session-generation : i64
      (cis.intern-structural-session-current-reset-generation session)]
    [slot-count : i64 (tc-type-env-scoped-stack-len stack)]
    [generation : i64 (tc-type-env-scoped-stack-cache-generation stack)]
    (if (and
      tc-type-env-scoped-cache-visible-valid
      (= tc-type-env-scoped-cache-visible-len slot-count)
      (= tc-type-env-scoped-cache-visible-generation generation)
      (= tc-type-env-scoped-cache-visible-session-owner session-owner)
      (= tc-type-env-scoped-cache-visible-session-generation session-generation)
      (= tc-type-env-scoped-cache-visible-lifetime-id lifetime-id))
      tc-type-env-scoped-cache-visible-result
      (let
        [result : bool
          (if (>=
            (tc-type-env-scoped-stack-find-lifetime-index
              stack
              session
              lifetime-id)
            0)
            true
            (tc-lifetime-visible-persistent-id?
              (tc-type-env-scoped-carrier-persistent carrier)
              lifetime-id))]
        (begin
          (set! tc-type-env-scoped-cache-visible-valid true)
          (set! tc-type-env-scoped-cache-visible-len slot-count)
          (set! tc-type-env-scoped-cache-visible-generation generation)
          (set! tc-type-env-scoped-cache-visible-session-owner session-owner)
          (set!
            tc-type-env-scoped-cache-visible-session-generation
            session-generation)
          (set! tc-type-env-scoped-cache-visible-lifetime-id lifetime-id)
          (set! tc-type-env-scoped-cache-visible-result result)
          result)))))

(define (tc-type-env-scoped-carrier-lifetime-outlives-binding-id?
  [carrier : TcTypeEnvScopedCarrier]
  [lifetime-id : i64]
  [target-id : i64]) : bool
  (let
    [stack : TcTypeEnvScopedStack carrier.sidecar.stack]
    [session : cis.InternStructuralSessionHandle
      (tc-type-env-structural-session carrier.env)]
    [session-owner : i64 (cis.intern-structural-session-owner session)]
    [session-generation : i64
      (cis.intern-structural-session-current-reset-generation session)]
    [slot-count : i64 (tc-type-env-scoped-stack-len stack)]
    [generation : i64 (tc-type-env-scoped-stack-cache-generation stack)]
    (if (and
      tc-type-env-scoped-cache-outlives-binding-valid
      (= tc-type-env-scoped-cache-outlives-binding-len slot-count)
      (= tc-type-env-scoped-cache-outlives-binding-generation generation)
      (= tc-type-env-scoped-cache-outlives-binding-session-owner session-owner)
      (=
        tc-type-env-scoped-cache-outlives-binding-session-generation
        session-generation)
      (= tc-type-env-scoped-cache-outlives-binding-lifetime-id lifetime-id)
      (= tc-type-env-scoped-cache-outlives-binding-target-id target-id))
      tc-type-env-scoped-cache-outlives-binding-result
      (let
        [lifetime-index : i64
          (tc-type-env-scoped-stack-find-lifetime-index
            stack
            session
            lifetime-id)]
        [target-index : i64
          (tc-type-env-scoped-stack-find-id-index (& stack) target-id)]
        [result : bool
          (cond
            [(>= lifetime-index 0)
              (and (>= target-index 0) (< lifetime-index target-index))]
            [(>= target-index 0)
              (tc-lifetime-visible-persistent-id?
                (tc-type-env-scoped-carrier-persistent carrier)
                lifetime-id)]
            [else
              (tc-lifetime-outlives-binding-persistent-id?
                (tc-type-env-scoped-carrier-persistent carrier)
                lifetime-id
                target-id)])]
        (begin
          (set! tc-type-env-scoped-cache-outlives-binding-valid true)
          (set! tc-type-env-scoped-cache-outlives-binding-len slot-count)
          (set! tc-type-env-scoped-cache-outlives-binding-generation generation)
          (set!
            tc-type-env-scoped-cache-outlives-binding-session-owner
            session-owner)
          (set!
            tc-type-env-scoped-cache-outlives-binding-session-generation
            session-generation)
          (set!
            tc-type-env-scoped-cache-outlives-binding-lifetime-id
            lifetime-id)
          (set! tc-type-env-scoped-cache-outlives-binding-target-id target-id)
          (set! tc-type-env-scoped-cache-outlives-binding-result result)
          result)))))

(define (tc-type-env-scoped-carrier-lifetime-outlives-lifetime-id?
  [carrier : TcTypeEnvScopedCarrier]
  [value-lifetime-id : i64]
  [target-lifetime-id : i64]) : bool
  (if (= value-lifetime-id target-lifetime-id)
    true
    (let
      [stack : TcTypeEnvScopedStack carrier.sidecar.stack]
      [session : cis.InternStructuralSessionHandle
        (tc-type-env-structural-session carrier.env)]
      [session-owner : i64 (cis.intern-structural-session-owner session)]
      [session-generation : i64
        (cis.intern-structural-session-current-reset-generation session)]
      [slot-count : i64 (tc-type-env-scoped-stack-len stack)]
      [generation : i64 (tc-type-env-scoped-stack-cache-generation stack)]
      (if (and
        tc-type-env-scoped-cache-outlives-lifetime-valid
        (= tc-type-env-scoped-cache-outlives-lifetime-len slot-count)
        (= tc-type-env-scoped-cache-outlives-lifetime-generation generation)
        (=
          tc-type-env-scoped-cache-outlives-lifetime-session-owner
          session-owner)
        (=
          tc-type-env-scoped-cache-outlives-lifetime-session-generation
          session-generation)
        (=
          tc-type-env-scoped-cache-outlives-lifetime-value-id
          value-lifetime-id)
        (=
          tc-type-env-scoped-cache-outlives-lifetime-target-id
          target-lifetime-id))
        tc-type-env-scoped-cache-outlives-lifetime-result
        (let
          [value-index : i64
            (tc-type-env-scoped-stack-find-lifetime-index
              stack
              session
              value-lifetime-id)]
          [target-index : i64
            (tc-type-env-scoped-stack-find-lifetime-index
              stack
              session
              target-lifetime-id)]
          [value-signature : bool
            (tc-type-env-scoped-stack-signature-lifetime-index?
              stack
              value-index
              value-lifetime-id)]
          [target-signature : bool
            (tc-type-env-scoped-stack-signature-lifetime-index?
              stack
              target-index
              target-lifetime-id)]
          [result : bool
            (cond
              [(and value-signature target-signature) false]
              [(>= value-index 0)
                (and (>= target-index 0) (< value-index target-index))]
              [(>= target-index 0)
                (tc-lifetime-visible-persistent-id?
                  (tc-type-env-scoped-carrier-persistent carrier)
                  value-lifetime-id)]
              [else
                (tc-lifetime-outlives-lifetime-persistent-id?
                  (tc-type-env-scoped-carrier-persistent carrier)
                  value-lifetime-id
                  target-lifetime-id)])]
          (begin
            (set! tc-type-env-scoped-cache-outlives-lifetime-valid true)
            (set! tc-type-env-scoped-cache-outlives-lifetime-len slot-count)
            (set!
              tc-type-env-scoped-cache-outlives-lifetime-generation
              generation)
            (set!
              tc-type-env-scoped-cache-outlives-lifetime-session-owner
              session-owner)
            (set!
              tc-type-env-scoped-cache-outlives-lifetime-session-generation
              session-generation)
            (set!
              tc-type-env-scoped-cache-outlives-lifetime-value-id
              value-lifetime-id)
            (set!
              tc-type-env-scoped-cache-outlives-lifetime-target-id
              target-lifetime-id)
            (set! tc-type-env-scoped-cache-outlives-lifetime-result result)
            result))))))

(define tc-type-env-scoped-runtime-active : bool
  false)
(define tc-type-env-scoped-runtime-carrier : TcTypeEnvScopedCarrier
  (tc-type-env-scoped-carrier-new))

;; Entering scoped runtime eagerly interns these stable marker names. Keeping
;; their cached ids also makes the ordering explicit across intern resets.
(define tc-type-env-scoped-runtime-marker-id-generation : i64
  -1)
(define tc-type-env-scoped-runtime-marker-id-unsafe : i64
  -1)
(define tc-type-env-scoped-runtime-marker-id-return : i64
  -1)
(define tc-type-env-scoped-runtime-marker-id-region : i64
  -1)

;; This private marker is stable only within an intern generation.  Remember its
;; canonical ID without carrying it through every recursive environment walk.
(define tc-signature-lifetime-marker-id-generation : i64
  -1)
(define tc-signature-lifetime-marker-id-cache : i64
  -1)

(define (tc-type-env-scoped-runtime-active?) : bool
  tc-type-env-scoped-runtime-active)

(define (tc-type-env-scoped-runtime-current) : TcTypeEnvScopedCarrier
  (tc-global-shared-view tc-type-env-scoped-runtime-carrier))

(define (tc-type-env-scoped-runtime-lookup-index [name-id : i64]) : i64
  (if (and (>= name-id 0) (< name-id tc-type-env-scoped-dense-lookup-capacity))
    (if (=
      (array-ref tc-type-env-scoped-dense-lookup-epochs name-id)
      (__tl-project-field
        (__tl-project-field
          (__tl-project-field tc-type-env-scoped-runtime-carrier sidecar)
          stack)
        lookup-epoch))
      (let
        [index : i64
          (array-ref tc-type-env-scoped-dense-lookup-indices name-id)]
        (if (< index 0)
          (begin
            (cfg
              compile-profile
              (compiler-tc-env-profile-note-scoped-cache-hit))
            -1)
          (if (<
            index
            (__tl-project-field
              (__tl-project-field
                (__tl-project-field tc-type-env-scoped-runtime-carrier sidecar)
                stack)
              slot-count))
            (begin
              (cfg
                compile-profile
                (compiler-tc-env-profile-note-scoped-cache-hit))
              index)
            (tc-type-env-scoped-stack-dense-lookup-id-refresh
              (&
                (__tl-project-field
                  (__tl-project-field
                    tc-type-env-scoped-runtime-carrier
                    sidecar)
                  stack))
              name-id))))
      (tc-type-env-scoped-stack-dense-lookup-id-refresh
        (&
          (__tl-project-field
            (__tl-project-field tc-type-env-scoped-runtime-carrier sidecar)
            stack))
        name-id))
    (tc-type-env-scoped-stack-map-lookup-id
      (&
        (__tl-project-field
          (__tl-project-field tc-type-env-scoped-runtime-carrier sidecar)
          stack))
      name-id)))

(define (tc-type-env-scoped-runtime-save) : TcTypeEnvScopedRuntimeSave
  (if tc-type-env-scoped-runtime-active
    (TcTypeEnvScopedRuntimeSave.Scope
      (tc-type-env-scoped-carrier-snapshot-mark
        (tc-global-shared-view tc-type-env-scoped-runtime-carrier)))
    (TcTypeEnvScopedRuntimeSave.Inactive)))

(define (tc-type-env-scoped-runtime-suspend!) : TcTypeEnvScopedRuntimeSave
  (let
    [saved : TcTypeEnvScopedRuntimeSave (tc-type-env-scoped-runtime-save)]
    (begin
      (set! tc-type-env-scoped-runtime-active false)
      saved)))

(define (tc-type-env-scoped-runtime-restore!
  [saved : TcTypeEnvScopedRuntimeSave]) : unit
  (match saved
    [(TcTypeEnvScopedRuntimeSave.Inactive)
      (begin
        (tc-type-env-scoped-cache-clear!)
        (set! tc-type-env-scoped-runtime-active false))]
    [(TcTypeEnvScopedRuntimeSave.Scope mark)
      (begin
        (set!
          tc-type-env-scoped-runtime-carrier
          (tc-type-env-scoped-carrier-restore
            (tc-global-shared-view tc-type-env-scoped-runtime-carrier)
            mark))
        (set! tc-type-env-scoped-runtime-active true))]
    [(TcTypeEnvScopedRuntimeSave.Replaced carrier)
      (begin
        (tc-type-env-scoped-cache-clear!)
        (set! tc-type-env-scoped-runtime-carrier carrier)
        (set! tc-type-env-scoped-runtime-active true))]))

(define (tc-type-env-scoped-runtime-enter! [carrier : TcTypeEnvScopedCarrier]) : TcTypeEnvScopedRuntimeSave
  (let
    [saved : TcTypeEnvScopedRuntimeSave
      (if tc-type-env-scoped-runtime-active
        (TcTypeEnvScopedRuntimeSave.Replaced
          (tc-global-shared-view tc-type-env-scoped-runtime-carrier))
        (TcTypeEnvScopedRuntimeSave.Inactive))]
    (begin
      (tc-type-env-scoped-runtime-marker-ids-ensure!)
      (tc-type-env-scoped-cache-clear!)
      (set! tc-type-env-scoped-runtime-carrier carrier)
      (set! tc-type-env-scoped-runtime-active true)
      saved)))

(define (tc-type-env-scoped-runtime-slot-flags
  [marker-kind : TcTypeEnvScopedMarkerKind]) : i64
  (if (tc-type-env-scoped-marker-kind-same?
    marker-kind
    TcTypeEnvScopedMarkerKind.None)
    0
    tc-type-env-scoped-flag-marker))

(define (tc-type-env-scoped-runtime-marker-ids-ensure!) : unit
  (if (= tc-type-env-scoped-runtime-marker-id-generation (ci.intern-generation))
    unit
    (begin
      (set!
        tc-type-env-scoped-runtime-marker-id-generation
        (ci.intern-generation))
      (set! tc-type-env-scoped-runtime-marker-id-unsafe (tc-unsafe-marker-id))
      (set! tc-type-env-scoped-runtime-marker-id-return (tc-return-type-id))
      (set! tc-type-env-scoped-runtime-marker-id-region (tc-region-marker-id)))))

(define (tc-type-env-scoped-runtime-note-bind-id!
  [_next-env : TcTypeEnv]
  [name-id : i64]
  [ty : ast.AstType]
  [_rest-env : TcTypeEnv]) : unit
  (begin
    (tc-type-env-scoped-stack-push-slot!
      (&mut
        (__tl-project-field
          (__tl-project-field tc-type-env-scoped-runtime-carrier sidecar)
          stack))
      name-id
      ty
      0
      TcTypeEnvScopedMarkerKind.None)
    (__tl-project-set-field tc-type-env-scoped-runtime-carrier dirty true)))

(define (tc-type-env-scoped-stack-mark-latest-flags-id!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [name-id : i64]
  [flags : i64]) : unit
  (let
    [index : i64 (- stack.slot-count 1)]
    (if (and
      (>= index 0)
      (= (__tl-project-field (array-ref stack.slots index) name-id) name-id))
      (let
        [slot : TcTypeEnvScopedSlot (clone (array-ref stack.slots index))]
        (set!
          (array-ref stack.slots index)
          (TcTypeEnvScopedSlot
            slot.name-id
            slot.ty
            (bit-or slot.flags flags)
            slot.marker-kind-tag
            slot.scope-depth
            slot.generation)))
      unit)))

(define (tc-type-env-scoped-runtime-mark-latest-flags-id!
  [name-id : i64]
  [flags : i64]) : unit
  (tc-type-env-scoped-stack-mark-latest-flags-id!
    (&mut
      (__tl-project-field
        (__tl-project-field tc-type-env-scoped-runtime-carrier sidecar)
        stack))
    name-id
    flags))

(define (tc-type-env-scoped-stack-mark-latest-marker-id!
  [stack : (&mut stack TcTypeEnvScopedStack)]
  [name-id : i64]
  [marker-kind : TcTypeEnvScopedMarkerKind]) : unit
  (let
    [index : i64 (- stack.slot-count 1)]
    (if (and
      (>= index 0)
      (= (__tl-project-field (array-ref stack.slots index) name-id) name-id))
      (let
        [slot : TcTypeEnvScopedSlot (clone (array-ref stack.slots index))]
        (set!
          (array-ref stack.slots index)
          (TcTypeEnvScopedSlot
            slot.name-id
            slot.ty
            (bit-or
              slot.flags
              (tc-type-env-scoped-runtime-slot-flags marker-kind))
            (tc-type-env-scoped-marker-kind-tag marker-kind)
            slot.scope-depth
            slot.generation)))
      unit)))

(define (tc-type-env-scoped-runtime-mark-latest-marker-id!
  [name-id : i64]
  [marker-kind : TcTypeEnvScopedMarkerKind]) : unit
  (tc-type-env-scoped-stack-mark-latest-marker-id!
    (&mut
      (__tl-project-field
        (__tl-project-field tc-type-env-scoped-runtime-carrier sidecar)
        stack))
    name-id
    marker-kind))

(define (tc-type-env-scoped-runtime-enter-env! [env : TcTypeEnv]) : TcTypeEnvScopedRuntimeSave
  (if tc-type-env-scoped-runtime-active
    (tc-type-env-scoped-runtime-save)
    (tc-type-env-scoped-runtime-enter!
      (tc-type-env-scoped-carrier-from-env env))))

(define (tc-bind-runtime-marker-id
  [env : TcTypeEnv]
  [name-id : i64]
  [ty : ast.AstType]
  [marker-kind : TcTypeEnvScopedMarkerKind]) : TcTypeEnv
  (let
    [next-env : TcTypeEnv (tc-bind-id env name-id ty)]
    (begin
      (if tc-type-env-scoped-runtime-active
        (tc-type-env-scoped-runtime-mark-latest-marker-id! name-id marker-kind)
        unit)
      next-env)))

(define (tc-c-abi-fnptr-marker-near-id?
  [env : TcTypeEnv]
  [name-id : i64]
  [remaining : i64]) : bool
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    [left : i64 remaining]
    [done : bool false]
    [found : bool false]
    (begin
      (while (and (> left 0) (not done))
        (cond
          [(= head -1) (set! done true)]
          [(< head -1)
            (let
              [cache : TcTypeEnvCache
                (tc-type-env-cache-at
                  (tc-type-env-cache-ptr
                    store-handle
                    (tc-type-env-cache-index head)))]
              (set! head cache.rest))]
          [else
            (let
              [binding-ptr : (Ptr TcTypeEnvBinding)
                (tc-type-env-binding-ptr store-handle head)]
              [key : i64 (tc-type-env-binding-name-at binding-ptr)]
              (cond
                [(tc-c-abi-fnptr-marker-key-id? key name-id)
                  (begin
                    (set! found true)
                    (set! done true))]
                [(= key name-id) (set! done true)]
                [else
                  (begin
                    (set! head (tc-type-env-binding-parent-at binding-ptr))
                    (set! left (- left 1)))]))]))
      found)))

;; `name-id` is the lookup key already selected by the caller. Module/import
;; bindings use structural keys, while local bindings use raw interner ids.
;; Do not normalize it with `tc-env-name-key-id` here: a qualified raw id and
;; its structural key are distinct storage domains, and the marker is stored
;; beside the value under the selected domain.
(define (tc-binding-c-abi-fnptr-persistent-id?
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    (cond
      [(= head -1) false]
      [(< head -1)
        (let
          [node-addr : i64 (tc-type-env-cache-index head)]
          (if (>= (tc-chain-node-depth node-addr) 0)
            (let
              [ref : i64 (tc-chain-resolve store-handle node-addr name-id)]
              (if (>= ref 0)
                (=
                  (array-ref
                    (__tl-project-field
                      (tc-chain-ref-cache store-handle ref)
                      c-abi-fnptr-flags)
                    (tc-chain-ref-slot ref))
                  1)
                false))
            (let
              [cache : TcTypeEnvCache
                (tc-type-env-cache-at
                  (tc-type-env-cache-ptr store-handle node-addr))]
              [ids : tc_i64_i64_map.Map cache.ids]
              [index : i64 (tc_i64_i64_map.get-value-or (& ids) name-id -1)]
              (if (>= index 0)
                (= (array-ref cache.c-abi-fnptr-flags index) 1)
                (if cache.partial
                  (tc-binding-c-abi-fnptr-persistent-id?
                    (TcTypeEnv store-handle cache.below 0)
                    name-id)
                  false)))))]
      [else
        (let
          [binding-ptr : (Ptr TcTypeEnvBinding)
            (tc-type-env-binding-ptr store-handle head)]
          [rest : TcTypeEnv
            (TcTypeEnv
              store-handle
              (tc-type-env-binding-parent-at binding-ptr)
              0)]
          (if (= (tc-type-env-binding-name-at binding-ptr) name-id)
            (tc-c-abi-fnptr-marker-near-id? rest name-id 3)
            (tc-binding-c-abi-fnptr-persistent-id? rest name-id)))])))

(define (tc-binding-c-abi-fnptr-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (if tc-type-env-scoped-runtime-active
    (let
      [index : i64 (tc-type-env-scoped-runtime-lookup-index name-id)]
      [scoped : bool
        (if (>= index 0)
          (tc-type-env-scoped-slot-c-abi-fnptr?
            (array-ref
              (__tl-project-field
                (__tl-project-field
                  (__tl-project-field
                    tc-type-env-scoped-runtime-carrier
                    sidecar)
                  stack)
                slots)
              index))
          (begin
            (cfg
              compile-profile
              (compiler-tc-env-profile-note-scoped-tail-fallback))
            (tc-binding-c-abi-fnptr-persistent-id?
              (__tl-project-field
                (__tl-project-field tc-type-env-scoped-runtime-carrier sidecar)
                persistent)
              name-id)))]
      (begin
        (cfg
          tc-env-scoped-dual-verify
          (if (= scoped (tc-binding-c-abi-fnptr-persistent-id? env name-id))
            unit
            (io.panic
              "typecheck: scoped C ABI fnptr lookup diverged from persistent env")))
        scoped))
    (tc-binding-c-abi-fnptr-persistent-id? env name-id)))

(define (tc-binding-unsafe-marker-head-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (let
    [head : i64 env.head]
    (if (>= head 0)
      (let
        [binding-ptr : (Ptr TcTypeEnvBinding)
          (tc-type-env-binding-ptr env.store head)]
        (tc-unsafe-decl-marker-key-id?
          (tc-type-env-binding-name-at binding-ptr)
          name-id))
      false)))

(define (tc-binding-unsafe-id? [env : TcTypeEnv] [name-id : i64]) : bool
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    (cond
      [(= head -1) false]
      [(< head -1)
        (let
          [node-addr : i64 (tc-type-env-cache-index head)]
          (if (>= (tc-chain-node-depth node-addr) 0)
            (let
              [ref : i64 (tc-chain-resolve store-handle node-addr name-id)]
              (if (>= ref 0)
                (=
                  (array-ref
                    (__tl-project-field
                      (tc-chain-ref-cache store-handle ref)
                      unsafe-flags)
                    (tc-chain-ref-slot ref))
                  1)
                false))
            (let
              [cache : TcTypeEnvCache
                (tc-type-env-cache-at
                  (tc-type-env-cache-ptr store-handle node-addr))]
              [ids : tc_i64_i64_map.Map cache.ids]
              [index : i64 (tc_i64_i64_map.get-value-or (& ids) name-id -1)]
              (if (>= index 0)
                (= (array-ref cache.unsafe-flags index) 1)
                (if cache.partial
                  (tc-binding-unsafe-id?
                    (TcTypeEnv store-handle cache.below 0)
                    name-id)
                  false)))))]
      [else
        (let
          [binding-ptr : (Ptr TcTypeEnvBinding)
            (tc-type-env-binding-ptr store-handle head)]
          [rest : TcTypeEnv
            (TcTypeEnv
              store-handle
              (tc-type-env-binding-parent-at binding-ptr)
              0)]
          (if (= (tc-type-env-binding-name-at binding-ptr) name-id)
            (tc-binding-unsafe-marker-head-id? rest name-id)
            (tc-binding-unsafe-id? rest name-id)))])))

(define (tc-env-cache-count [env : TcTypeEnv]) : i64
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    [count : i64 0]
    [done : bool false]
    (begin
      (while (not done)
        (cond
          [(= head -1) (set! done true)]
          [(>= head 0)
            (let
              [binding-ptr : (Ptr TcTypeEnvBinding)
                (tc-type-env-binding-ptr store-handle head)]
              (begin
                (set! count (+ count 1))
                (set! head (tc-type-env-binding-parent-at binding-ptr))))]
          [else
            (let
              [cache : TcTypeEnvCache
                (tc-type-env-cache-at
                  (tc-type-env-cache-ptr
                    store-handle
                    (tc-type-env-cache-index head)))]
              (set! head cache.rest))]))
      count)))

(define (tc-env-cache-count-prefix [env : TcTypeEnv] [remaining : i64]) : i64
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    [left : i64 remaining]
    [count : i64 0]
    (begin
      (while (and (> left 0) (>= head 0))
        (let
          [binding-ptr : (Ptr TcTypeEnvBinding)
            (tc-type-env-binding-ptr store-handle head)]
          (begin
            (set! count (+ count 1))
            (set! left (- left 1))
            (set! head (tc-type-env-binding-parent-at binding-ptr)))))
      count)))

(define (tc-env-cache-capacity [count : i64]) : i64
  (if (< count 5)
    16
    (* count 2)))

(define tc-env-cache-flag-default-shadow : i64
  1)
(define tc-env-cache-flag-cleanup-owner : i64
  2)
(define tc-env-cache-flag-ordinary-arena-owner : i64
  4)
(define tc-env-cache-flag-atomic-arena-owner : i64
  8)
(define tc-env-cache-flag-signature-lifetime : i64
  16)
(define tc-env-cache-sidecar-position-scale : i64
  32)

;; Environment name IDs are non-negative.  Negative derived keys let the
;; existing relevance map index marker-owned lifetime spellings without
;; colliding with ordinary bindings or allocating a second map per cache.
(define (tc-env-cache-lifetime-marker-key [lifetime-id : i64]) : i64
  (- -2 (* lifetime-id 2)))

(define (tc-env-cache-arena-lifetime-marker-key [owner-id : i64]) : i64
  (- -3 (* owner-id 2)))

(define (tc-env-cache-lifetime-marker-lifetime-id
  [name-id : i64]
  [ty : ast.AstType]
  [signature-marker-id : i64]
  [region-marker-id : i64]
  [ordinary-arena-marker-id : i64]
  [atomic-arena-marker-id : i64]) : i64
  (if (or
    (= name-id signature-marker-id)
    (= name-id region-marker-id)
    (= name-id ordinary-arena-marker-id)
    (= name-id atomic-arena-marker-id))
    (match ty
      [(ast.AstType.Var lifetime-id) lifetime-id]
      [_ -1])
    -1))

(define (tc-env-cache-binding-sidecar-flags
  [rest-env : TcTypeEnv]
  [name-id : i64]
  [default-shadow : bool]
  [cleanup-marker-id : i64]
  [ordinary-arena-marker-id : i64]
  [atomic-arena-marker-id : i64]) : i64
  (let
    [base : i64
      (if default-shadow
        tc-env-cache-flag-default-shadow
        0)]
    [head : i64 rest-env.head]
    (if (>= head 0)
      (let
        [binding-ptr : (Ptr TcTypeEnvBinding)
          (tc-type-env-binding-ptr rest-env.store head)]
        [marker-id : i64 (tc-type-env-binding-name-at binding-ptr)]
        [marker-ty : ast.AstType (tc-type-env-binding-type-at binding-ptr)]
        [marker-flag : i64
          (cond
            [(= marker-id cleanup-marker-id) tc-env-cache-flag-cleanup-owner]
            [(= marker-id ordinary-arena-marker-id)
              tc-env-cache-flag-ordinary-arena-owner]
            [(= marker-id atomic-arena-marker-id)
              tc-env-cache-flag-atomic-arena-owner]
            [else 0])]
        (if (= marker-flag 0)
          base
          (match marker-ty
            [(ast.AstType.Var owner)
              (if (= owner name-id)
                (+ base marker-flag)
                base)]
            [_ base])))
      base)))

(define (tc-env-cache-owner-marker-head-id?
  [env : TcTypeEnv]
  [name-id : i64]
  [marker-id : i64]) : bool
  (let
    [head : i64 env.head]
    (if (>= head 0)
      (let
        [binding-ptr : (Ptr TcTypeEnvBinding)
          (tc-type-env-binding-ptr env.store head)]
        (if (= (tc-type-env-binding-name-at binding-ptr) marker-id)
          (match (tc-type-env-binding-type-at binding-ptr)
            [(ast.AstType.Var owner) (= owner name-id)]
            [_ false])
          false))
      false)))

;; Cache construction is the dominant i64 map workload of a self-compile
;; (~16% of stage2 CPU before this change): the previous shape walked the
;; spine FOUR times per compaction (entry count, shadow count, entry fill,
;; shadow fill) and built a second whole-env map just to answer "is this
;; default builtin shadowed?". Default-shadow membership is now a per-entry
;; flag array parallel to `values`/`unsafe-flags`, computed during the single
;; entry fill walk: an entry's low bit is set when its head-most binding sits
;; above the first default-boundary marker. Head-first walk order means a
;; name bound both above and below the boundary keeps its head-most (above)
;; occurrence, which matches the old any-occurrence-above map exactly.
(define (tc-env-cache-add!
  [ids : (&mut ids tc_i64_i64_map.Map)]
  [values : (__tl_dyn-array ast.AstType)]
  [unsafe-flags : (__tl_dyn-array i64)]
  [c-abi-fnptr-flags : (__tl_dyn-array i64)]
  [shadow-flags : (__tl_dyn-array i64)]
  [name-id : i64]
  [next : i64]
  [ty : ast.AstType]
  [unsafe : bool]
  [c-abi-fnptr : bool]
  [sidecar-flags : i64]
  [position : i64]) : bool
  (if (tc_i64_i64_map.insert-if-absent-ref! ids name-id next)
    (begin
      (cfg compile-profile (compiler-tc-env-profile-note-cache-entry))
      (set! (array-ref values next) ty)
      (set!
        (array-ref unsafe-flags next)
        (if unsafe
          1
          0))
      (set!
        (array-ref c-abi-fnptr-flags next)
        (if c-abi-fnptr
          1
          0))
      (set!
        (array-ref shadow-flags next)
        (+ sidecar-flags (* position tc-env-cache-sidecar-position-scale)))
      true)
    false))

(define (tc-env-cache-add-lifetime-marker!
  [ids : (&mut ids tc_i64_i64_map.Map)]
  [values : (__tl_dyn-array ast.AstType)]
  [unsafe-flags : (__tl_dyn-array i64)]
  [c-abi-fnptr-flags : (__tl_dyn-array i64)]
  [shadow-flags : (__tl_dyn-array i64)]
  [lifetime-id : i64]
  [next : i64]
  [ty : ast.AstType]
  [signature : bool]
  [arena-owner : bool]
  [position : i64]) : bool
  (if (< lifetime-id 0)
    false
    (let
      [general-added : bool
        (tc_i64_i64_map.insert-if-absent-ref!
          ids
          (tc-env-cache-lifetime-marker-key lifetime-id)
          next)]
      [arena-added : bool
        (if arena-owner
          (tc_i64_i64_map.insert-if-absent-ref!
            ids
            (tc-env-cache-arena-lifetime-marker-key lifetime-id)
            next)
          false)]
      (if (or general-added arena-added)
        (begin
          (set! (array-ref values next) ty)
          (set! (array-ref unsafe-flags next) 0)
          (set! (array-ref c-abi-fnptr-flags next) 0)
          (set!
            (array-ref shadow-flags next)
            (+
              (if signature
                tc-env-cache-flag-signature-lifetime
                0)
              (* position tc-env-cache-sidecar-position-scale)))
          true)
        false))))

(define (tc-env-cache-fill
  [env : TcTypeEnv]
  [ids : tc_i64_i64_map.Map (:consume)]
  [values : (__tl_dyn-array ast.AstType)]
  [track-resolution : bool]
  [unsafe-flags : (__tl_dyn-array i64)]
  [c-abi-fnptr-flags : (__tl_dyn-array i64)]
  [shadow-flags : (__tl_dyn-array i64)]
  [above-boundary : bool]) : tc_i64_i64_map.Map
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    [cur-ids : tc_i64_i64_map.Map ids]
    [next : i64 0]
    [resolution-next : i64 0]
    [position : i64 0]
    [signature-marker-id : i64 (tc-signature-lifetime-marker-id)]
    [region-marker-id : i64 (tc-region-marker-id)]
    [cleanup-marker-id : i64 (tc-cleanup-owner-marker-id)]
    [ordinary-arena-marker-id : i64 (tc-ordinary-arena-owner-marker-id)]
    [atomic-arena-marker-id : i64 (tc-atomic-arena-owner-marker-id)]
    [cur-above-boundary : bool above-boundary]
    [done : bool false]
    (begin
      (while (not done)
        (cond
          [(= head -1) (set! done true)]
          [(>= head 0)
            (let
              [binding-ptr : (Ptr TcTypeEnvBinding)
                (tc-type-env-binding-ptr store-handle head)]
              [name-id : i64 (tc-type-env-binding-name-at binding-ptr)]
              [ty : ast.AstType (tc-type-env-binding-type-at binding-ptr)]
              [rest-env : TcTypeEnv
                (TcTypeEnv
                  store-handle
                  (tc-type-env-binding-parent-at binding-ptr)
                  0)]
              ;; The boundary bind itself and everything below it are not
              ;; default shadows.
              [still-above : bool
                (if cur-above-boundary
                  (not (= name-id (tc-default-boundary-id)))
                  false)]
              (begin
                (if (tc-env-cache-add!
                  (&mut cur-ids)
                  values
                  unsafe-flags
                  c-abi-fnptr-flags
                  shadow-flags
                  name-id
                  next
                  ty
                  (tc-binding-unsafe-marker-head-id? rest-env name-id)
                  (tc-c-abi-fnptr-marker-near-id? rest-env name-id 3)
                  (tc-env-cache-binding-sidecar-flags
                    rest-env
                    name-id
                    still-above
                    cleanup-marker-id
                    ordinary-arena-marker-id
                    atomic-arena-marker-id)
                  position)
                  (begin
                    (if (and track-resolution (tc-type-needs-resolution? ty))
                      (begin
                        (set!
                          (array-ref
                            unsafe-flags
                            (+ (array.length values) 1 resolution-next))
                          name-id)
                        (set! resolution-next (+ resolution-next 1)))
                      unit)
                    (set! next (+ next 1)))
                  unit)
                (let
                  [marker-lifetime-id : i64
                    (tc-env-cache-lifetime-marker-lifetime-id
                      name-id
                      ty
                      signature-marker-id
                      region-marker-id
                      ordinary-arena-marker-id
                      atomic-arena-marker-id)]
                  (if (tc-env-cache-add-lifetime-marker!
                    (&mut cur-ids)
                    values
                    unsafe-flags
                    c-abi-fnptr-flags
                    shadow-flags
                    marker-lifetime-id
                    next
                    ty
                    (= name-id signature-marker-id)
                    (or
                      (= name-id ordinary-arena-marker-id)
                      (= name-id atomic-arena-marker-id))
                    position)
                    (set! next (+ next 1))
                    unit))
                (set! head rest-env.head)
                (set! position (+ position 1))
                (set! cur-above-boundary still-above)))]
          [else
            (let
              [cache : TcTypeEnvCache
                (tc-type-env-cache-at
                  (tc-type-env-cache-ptr
                    store-handle
                    (tc-type-env-cache-index head)))]
              (set! head cache.rest))]))
      ;; The final slot is a construction-only handoff to the cache node. It
      ;; avoids a second result aggregate around the consuming map.
      (if track-resolution
        (set! (array-ref unsafe-flags (array.length values)) resolution-next)
        unit)
      cur-ids)))

(define (tc-env-cache-fill-prefix
  [env : TcTypeEnv]
  [remaining : i64]
  [ids : tc_i64_i64_map.Map (:consume)]
  [values : (__tl_dyn-array ast.AstType)]
  [track-resolution : bool]
  [unsafe-flags : (__tl_dyn-array i64)]
  [c-abi-fnptr-flags : (__tl_dyn-array i64)]
  [shadow-flags : (__tl_dyn-array i64)]
  [above-boundary : bool]) : tc_i64_i64_map.Map
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    [left : i64 remaining]
    [cur-ids : tc_i64_i64_map.Map ids]
    [next : i64 0]
    [resolution-next : i64 0]
    [position : i64 0]
    [signature-marker-id : i64 (tc-signature-lifetime-marker-id)]
    [region-marker-id : i64 (tc-region-marker-id)]
    [cleanup-marker-id : i64 (tc-cleanup-owner-marker-id)]
    [ordinary-arena-marker-id : i64 (tc-ordinary-arena-owner-marker-id)]
    [atomic-arena-marker-id : i64 (tc-atomic-arena-owner-marker-id)]
    [cur-above-boundary : bool above-boundary]
    [done : bool false]
    (begin
      (while (and (not done) (> left 0))
        (cond
          [(>= head 0)
            (let
              [binding-ptr : (Ptr TcTypeEnvBinding)
                (tc-type-env-binding-ptr store-handle head)]
              [name-id : i64 (tc-type-env-binding-name-at binding-ptr)]
              [ty : ast.AstType (tc-type-env-binding-type-at binding-ptr)]
              [rest-env : TcTypeEnv
                (TcTypeEnv
                  store-handle
                  (tc-type-env-binding-parent-at binding-ptr)
                  0)]
              [still-above : bool
                (if cur-above-boundary
                  (not (= name-id (tc-default-boundary-id)))
                  false)]
              (begin
                (if (tc-env-cache-add!
                  (&mut cur-ids)
                  values
                  unsafe-flags
                  c-abi-fnptr-flags
                  shadow-flags
                  name-id
                  next
                  ty
                  (tc-binding-unsafe-marker-head-id? rest-env name-id)
                  (tc-c-abi-fnptr-marker-near-id? rest-env name-id 3)
                  (tc-env-cache-binding-sidecar-flags
                    rest-env
                    name-id
                    still-above
                    cleanup-marker-id
                    ordinary-arena-marker-id
                    atomic-arena-marker-id)
                  position)
                  (begin
                    (if (and track-resolution (tc-type-needs-resolution? ty))
                      (begin
                        (set!
                          (array-ref
                            unsafe-flags
                            (+ (array.length values) 1 resolution-next))
                          name-id)
                        (set! resolution-next (+ resolution-next 1)))
                      unit)
                    (set! next (+ next 1)))
                  unit)
                (let
                  [marker-lifetime-id : i64
                    (tc-env-cache-lifetime-marker-lifetime-id
                      name-id
                      ty
                      signature-marker-id
                      region-marker-id
                      ordinary-arena-marker-id
                      atomic-arena-marker-id)]
                  (if (tc-env-cache-add-lifetime-marker!
                    (&mut cur-ids)
                    values
                    unsafe-flags
                    c-abi-fnptr-flags
                    shadow-flags
                    marker-lifetime-id
                    next
                    ty
                    (= name-id signature-marker-id)
                    (or
                      (= name-id ordinary-arena-marker-id)
                      (= name-id atomic-arena-marker-id))
                    position)
                    (set! next (+ next 1))
                    unit))
                (set! left (- left 1))
                (set! head rest-env.head)
                (set! position (+ position 1))
                (set! cur-above-boundary still-above)))]
          [(< head -1)
            (let
              [cache : TcTypeEnvCache
                (tc-type-env-cache-at
                  (tc-type-env-cache-ptr
                    store-handle
                    (tc-type-env-cache-index head)))]
              (if (and cache.scan-through cache.partial)
                ;; The cache's `rest` starts at the first bind it covers. Walk
                ;; that layer, then the next partial layer, but stop before an
                ;; explicit/global cache; `left` is the exact covered-bind sum.
                (set! head cache.rest)
                (set! done true)))]
          [else (set! done true)]))
      (if track-resolution
        (set! (array-ref unsafe-flags (array.length values)) resolution-next)
        unit)
      cur-ids)))

;; --- structural index over the explicit top-env layer forest -----------------
;;
;; `tc-env-with-cache-layer-over-explicit` pushes one explicit layer per module
;; extension / additive splice, each layer's `below` being the layer
;; it extends. A self-compile builds 343 such layers over 2 explicit roots, and
;; because splices and module extensions re-extend older base snapshots the
;; result is a FOREST, not a stack (measured: 214 of 343 pushes did not sit on
;; the previous tip; max depth 128, mean creation depth 52). Every layer is a
;; correct non-membership filter, so lookups fall through them one map probe at
;; a time: 31.2M probes per opt1 self-compile, most of them from walks 12-18
;; layers deep. With the index the same compile does 3.18M probes plus 0.53M
;; version-list steps (0.17 per probe, 32 at worst).
;;
;; The index replaces that per-layer fall-through with one probe. Per store it
;; keeps a single map from binding key to the packed reference of the NEWEST
;; layer that binds it; each layer carries a `chain-prev` array parallel to its
;; `values`, threading the older versions of the same key in strictly
;; decreasing `seq`. A lookup starting at layer S takes the first version whose
;; layer is an ancestor-or-self of S, which is exactly the layer the `below`
;; walk would have stopped at:
;;
;;   * a version's layer is visited by the walk from S iff it is an
;;     ancestor-or-self of S (the walk follows `below` and stops at the root);
;;   * `seq` strictly increases along any root-to-node path, so among the
;;     ancestors of S greater `seq` means greater depth means closer to S, and
;;     the decreasing-`seq` version list therefore hands back the top-most
;;     binding first;
;;   * `seq` greater than S's own `seq` proves non-ancestry without any test.
;;
;; No value is ever copied into the index: a reference is (layer node address,
;; slot), and every payload read goes to that layer's live arrays. This is what
;; keeps `tc-top-env-reresolve-cache-node!` (issue #5493) sound -- it rewrites
;; `values` in place and never touches `ids`, so a re-resolved signature is
;; observed identically through the index and through the walk. The index is
;; append-only and is extended only where a layer is created, so nothing has to
;; be invalidated.
(define tc-chain-empty-i64-array : (__tl_dyn-array i64)
  (array.make-array i64 0))

;; A reference packs the layer node address (8-byte aligned, so the low three
;; bits are free) above an 18-bit slot. Layers wider than the slot field, or
;; sitting above the addressable range, are left unindexed and keep the walk.
(define (tc-chain-ref-slot-limit) : i64
  262144)

(define (tc-chain-ref-addr-limit) : i64
  140737488355328)

(define (tc-chain-ref-pack [addr : i64] [slot : i64]) : i64
  (bit-or (shl (shr addr 3) 18) slot))

(define (tc-chain-ref-addr [ref : i64]) : i64
  (shl (shr ref 18) 3))

(define (tc-chain-ref-slot [ref : i64]) : i64
  (bit-and ref 262143))

;; Word offsets 0..3 of TcTypeEnvCache. The four chain fields lead the record
;; and are one word each, so the version walk and the ancestor test read them
;; without materializing the whole cache.
(defmacro (tc-chain-node-depth [addr : comptime.Expr]) : comptime.Expr
  `(unsafe
    (ptr-read (int->ptr (cast ,addr : u64) : (Ptr i64)))))

(defmacro (tc-chain-node-seq [addr : comptime.Expr]) : comptime.Expr
  `(unsafe
    (ptr-read (ptr-offset (int->ptr (cast ,addr : u64) : (Ptr i64)) 1))))

(defmacro (tc-chain-node-jumps [addr : comptime.Expr]) : comptime.Expr
  `(unsafe
    (ptr-read
      (ptr-cast
        (ptr-offset (int->ptr (cast ,addr : u64) : (Ptr i64)) 2)
        : (Ptr (__tl_dyn-array i64))))))

(defmacro (tc-chain-node-prev [addr : comptime.Expr]) : comptime.Expr
  `(unsafe
    (ptr-read
      (ptr-cast
        (ptr-offset (int->ptr (cast ,addr : u64) : (Ptr i64)) 3)
        : (Ptr (__tl_dyn-array i64))))))

(define (tc-chain-node-set-fields!
  [addr : i64]
  [depth : i64]
  [seq : i64]
  [jumps : (__tl_dyn-array i64)]
  [prev : (__tl_dyn-array i64)]) : unit
  (let
    [words : (MutPtr i64)
      (unsafe
        (int->ptr (cast addr : u64) : (MutPtr i64)))]
    (begin
      (unsafe
        (ptr-write! (ptr-offset words 1) seq))
      (unsafe
        (ptr-write!
          (ptr-cast (ptr-offset words 2) : (MutPtr (__tl_dyn-array i64)))
          jumps))
      (unsafe
        (ptr-write!
          (ptr-cast (ptr-offset words 3) : (MutPtr (__tl_dyn-array i64)))
          prev))
      ;; Depth last: it is the published "this layer is indexed" flag, and the
      ;; three fields above must be visible before any walker reads it.
      (unsafe
        (ptr-write! words depth)))))

(define (tc-chain-store-owner [store-handle : i64]) : i64
  (unsafe
    (ptr-read (ptr-offset (int->ptr (cast store-handle : u64) : (Ptr i64)) 6))))

(define (tc-chain-state-address [store-handle : i64]) : i64
  (unsafe
    (ptr-read (ptr-offset (int->ptr (cast store-handle : u64) : (Ptr i64)) 8))))

(define (tc-chain-state-set! [store-handle : i64] [addr : i64]) : unit
  (unsafe
    (ptr-write!
      (ptr-offset (int->ptr (cast store-handle : u64) : (MutPtr i64)) 8)
      addr)))

(define (tc-chain-state-read [addr : i64]) : TcChainIndex
  (unsafe
    (ptr-read (int->ptr (cast addr : u64) : (Ptr TcChainIndex)))))

(define (tc-chain-state-write! [addr : i64] [state : TcChainIndex]) : unit
  (unsafe
    (ptr-write! (int->ptr (cast addr : u64) : (MutPtr TcChainIndex)) state)))

;; The index cell and everything it points at live in the store's owner arena,
;; exactly like the cache nodes whose addresses it records.
(define (tc-chain-state-ensure! [store-handle : i64]) : i64
  (let
    [existing : i64 (tc-chain-state-address store-handle)]
    (if (> existing 0)
      existing
      (let
        [owner : i64 (tc-chain-store-owner store-handle)]
        [cell : i64
          (in-arena
            (arena.Arena owner)
            (let
              [slots : (__tl_dyn-array TcChainIndex)
                (array.make-array TcChainIndex 1)]
              (begin
                (set!
                  (array-ref slots 0)
                  (TcChainIndex (tc_i64_i64_map.with-capacity 1024) 0 owner))
                (unsafe
                  (cast
                    (ptr->int (ptr-cast (__tl_array-data slots) : (Ptr u8)))
                    : i64)))))]
        (begin
          (tc-chain-state-set! store-handle cell)
          cell)))))

(define (tc-chain-jump-levels [depth : i64]) : i64
  (if (< depth 1)
    0
    (let
      [levels : i64 1]
      [span : i64 2]
      (begin
        (while (<= span depth)
          (begin
            (set! levels (+ levels 1))
            (set! span (* span 2))))
        levels))))

(define (tc-chain-jump-at [addr : i64] [k : i64]) : i64
  (if (= addr 0)
    0
    (let
      [jumps : (__tl_dyn-array i64) (tc-chain-node-jumps addr)]
      (if (< k (array.length jumps))
        (array-ref jumps k)
        0))))

;; True when `x-addr` is `s-addr` or one of its `below` ancestors. Lifts S by
;; the depth difference through the binary-lifting table; entry k is only read
;; when bit k of the remaining difference is set, and the remaining difference
;; never exceeds the current node's depth, so the entry always exists.
(define (tc-chain-ancestor? [x-addr : i64] [s-addr : i64] [s-depth : i64]) : bool
  (let
    [x-depth : i64 (tc-chain-node-depth x-addr)]
    (cond
      [(> x-depth s-depth) false]
      [(= x-depth s-depth) (= x-addr s-addr)]
      [else
        (let
          [cur : i64 s-addr]
          [delta : i64 (- s-depth x-depth)]
          [k : i64 0]
          (begin
            (while (> delta 0)
              (begin
                (if (= (bit-and delta 1) 1)
                  (set! cur (tc-chain-jump-at cur k))
                  unit)
                (set! delta (shr delta 1))
                (set! k (+ k 1))))
            (= cur x-addr)))])))

;; Packed reference of the layer the plain `below` walk from the indexed layer
;; at `s-addr` would have stopped at for `key`, or -1 when no ancestor of that
;; layer binds it.
(define (tc-chain-resolve [store-handle : i64] [s-addr : i64] [key : i64]) : i64
  (let
    [state-addr : i64 (tc-chain-state-address store-handle)]
    (if (<= state-addr 0)
      -1
      (let
        [state : TcChainIndex (tc-chain-state-read state-addr)]
        [s-depth : i64 (tc-chain-node-depth s-addr)]
        [s-seq : i64 (tc-chain-node-seq s-addr)]
        [ref : i64 (tc_i64_i64_map.get-value-or (& state.map) key -1)]
        [answer : i64 -1]
        [done : bool false]
        (begin
          (while (not done)
            (if (< ref 0)
              (set! done true)
              (let
                [addr : i64 (tc-chain-ref-addr ref)]
                (if (and
                  (<= (tc-chain-node-seq addr) s-seq)
                  (tc-chain-ancestor? addr s-addr s-depth))
                  (begin
                    (set! answer ref)
                    (set! done true))
                  (set!
                    ref
                    (-
                      (array-ref
                        (tc-chain-node-prev addr)
                        (tc-chain-ref-slot ref))
                      2))))))
          answer)))))

(define (tc-chain-ref-cache [store-handle : i64] [ref : i64]) : TcTypeEnvCache
  (tc-type-env-cache-at
    (tc-type-env-cache-ptr store-handle (tc-chain-ref-addr ref))))

;; Threads every key this layer binds onto its per-key version list. `ids`
;; already holds the head-most slot per key, so the traversal only has to
;; reproduce the covered-bind walk of `tc-env-cache-fill{,-prefix}` and take
;; the first occurrence of each slot (`chain-prev` still zero).
(define (tc-chain-register-layer!
  [store-handle : i64]
  [state-addr : i64]
  [node-addr : i64]
  [prev : (__tl_dyn-array i64)]
  [rest-head : i64]
  [count : i64]
  [full : bool]) : unit
  (let
    [ids : tc_i64_i64_map.Map
      (__tl-project-field
        (tc-type-env-cache-at (tc-type-env-cache-ptr store-handle node-addr))
        ids)]
    [state : TcChainIndex (tc-chain-state-read state-addr)]
    [owner : i64 state.owner-arena]
    [head : i64 rest-head]
    [left : i64 count]
    [done : bool false]
    (begin
      (while (not done)
        (cond
          [(= head -1) (set! done true)]
          [(and (not full) (<= left 0)) (set! done true)]
          [(>= head 0)
            (let
              [binding-ptr : (Ptr TcTypeEnvBinding)
                (tc-type-env-binding-ptr store-handle head)]
              [name-id : i64 (tc-type-env-binding-name-at binding-ptr)]
              [slot : i64 (tc_i64_i64_map.get-value-or (& ids) name-id -1)]
              (begin
                (if (and
                  (>= slot 0)
                  (< slot (array.length prev))
                  (= (array-ref prev slot) 0))
                  (begin
                    (set!
                      (array-ref prev slot)
                      (+
                        (tc_i64_i64_map.get-value-or (& state.map) name-id -1)
                        2))
                    (tc-cache-map-grow-in-owner! (&mut state.map) owner)
                    (tc_i64_i64_map.insert-ref!
                      (&mut state.map)
                      name-id
                      (tc-chain-ref-pack node-addr slot)))
                  unit)
                (set! head (tc-type-env-binding-parent-at binding-ptr))
                (set! left (- left 1))))]
          [else
            (set!
              head
              (__tl-project-field
                (tc-type-env-cache-at
                  (tc-type-env-cache-ptr
                    store-handle
                    (tc-type-env-cache-index head)))
                rest))]))
      (tc-chain-state-write! state-addr state))))

;; Publishes a freshly pushed explicit (scan-through = false) layer into its
;; store's index. `below-head` is the layer this one extends for a partial
;; link, or -1 for a root, whose `partial = false` already terminates the walk.
(define (tc-chain-attach-layer!
  [store-handle : i64]
  [node-head : i64]
  [below-head : i64]
  [count : i64]
  [capacity : i64]
  [rest-head : i64]
  [full : bool]) : unit
  (let
    [node-addr : i64 (tc-type-env-cache-index node-head)]
    [below-addr : i64
      (if (< below-head -1)
        (tc-type-env-cache-index below-head)
        0)]
    [below-depth : i64
      (if (= below-addr 0)
        -1
        (tc-chain-node-depth below-addr))]
    [depth : i64
      (if full
        0
        (+ below-depth 1))]
    (if (or
      (>= count (tc-chain-ref-slot-limit))
      (>= capacity (tc-chain-ref-slot-limit))
      (>= node-addr (tc-chain-ref-addr-limit))
      (and (not full) (< below-depth 0)))
      unit
      (let
        [state-addr : i64 (tc-chain-state-ensure! store-handle)]
        [owner : i64 (tc-chain-store-owner store-handle)]
        [levels : i64 (tc-chain-jump-levels depth)]
        ;; The jump and version arrays are reached from the index by node
        ;; address, so they must live exactly as long as the node: allocate
        ;; them in the store's owner arena, not the ambient one.
        (in-arena
          (arena.Arena owner)
          (let
            [jumps : (__tl_dyn-array i64)
              (if (= levels 0)
                (tc-global-shared-view tc-chain-empty-i64-array)
                (array.make-array i64 levels))]
            [prev : (__tl_dyn-array i64) (array.make-array i64 capacity)]
            [seq : i64
              (let
                [state : TcChainIndex (tc-chain-state-read state-addr)]
                [next : i64 state.next-seq]
                (begin
                  (tc-chain-state-write!
                    state-addr
                    (TcChainIndex state.map (+ next 1) state.owner-arena))
                  next))]
            (begin
              (if (= levels 0)
                unit
                (let
                  [k : i64 1]
                  (begin
                    (set! (array-ref jumps 0) below-addr)
                    (while (< k levels)
                      (begin
                        (set!
                          (array-ref jumps k)
                          (tc-chain-jump-at (array-ref jumps (- k 1)) (- k 1)))
                        (set! k (+ k 1)))))))
              (tc-chain-node-set-fields! node-addr depth seq jumps prev)
              (tc-chain-register-layer!
                store-handle
                state-addr
                node-addr
                prev
                rest-head
                count
                full))))))))

(define (tc-env-with-cache-mode [env : TcTypeEnv] [scan-through : bool]) : TcTypeEnv
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-cache-build))
    (let
      [count : i64 (tc-env-cache-count env)]
      [capacity : i64 (tc-env-cache-capacity count)]
      [values : (__tl_dyn-array ast.AstType)
        (array.make-array ast.AstType capacity)]
      [unsafe-flags : (__tl_dyn-array i64)
        (array.make-array
          i64
          (if scan-through
            capacity
            (+ (* capacity 2) 1)))]
      [c-abi-fnptr-flags : (__tl_dyn-array i64) (array.make-array i64 capacity)]
      [shadow-flags : (__tl_dyn-array i64) (array.make-array i64 capacity)]
      [ids : tc_i64_i64_map.Map
        (tc-env-cache-fill
          env
          (tc_i64_i64_map.with-capacity capacity)
          values
          (not scan-through)
          unsafe-flags
          c-abi-fnptr-flags
          shadow-flags
          true)]
      [node : TcTypeEnv
        (begin
          (set! (array-ref shadow-flags (- capacity 1)) count)
          (tc-type-env-cache-node
            env
            (TcTypeEnvCache
              -1
              -1
              (tc-global-shared-view tc-chain-empty-i64-array)
              (tc-global-shared-view tc-chain-empty-i64-array)
              ids
              values
              unsafe-flags
              c-abi-fnptr-flags
              shadow-flags
              scan-through
              false
              env.head
              env.head)))]
      (begin
        (if scan-through
          unit
          (tc-chain-attach-layer!
            env.store
            node.head
            -1
            count
            capacity
            env.head
            true))
        node))))

(define (tc-env-with-partial-local-cache [env : TcTypeEnv]) : TcTypeEnv
  (tc-env-with-cache-prefix-layer
    env
    (tc-env-cache-count-prefix env (tc-local-cache-threshold))
    true
    (tc-env-after-prefix env (tc-local-cache-threshold))))

(define (tc-env-with-cache-prefix-layer
  [env : TcTypeEnv]
  [count : i64]
  [scan-through : bool]
  [below : TcTypeEnv]) : TcTypeEnv
  (begin
    (cfg compile-profile (compiler-tc-env-profile-note-cache-build))
    (let
      [capacity : i64 (tc-env-cache-capacity count)]
      [values : (__tl_dyn-array ast.AstType)
        (array.make-array ast.AstType capacity)]
      [unsafe-flags : (__tl_dyn-array i64)
        (array.make-array
          i64
          (if scan-through
            capacity
            (+ (* capacity 2) 1)))]
      [c-abi-fnptr-flags : (__tl_dyn-array i64) (array.make-array i64 capacity)]
      [shadow-flags : (__tl_dyn-array i64) (array.make-array i64 capacity)]
      [ids : tc_i64_i64_map.Map
        (tc-env-cache-fill-prefix
          env
          count
          (tc_i64_i64_map.with-capacity capacity)
          values
          (not scan-through)
          unsafe-flags
          c-abi-fnptr-flags
          shadow-flags
          true)]
      [node : TcTypeEnv
        (begin
          (set! (array-ref shadow-flags (- capacity 1)) count)
          (tc-type-env-cache-node
            env
            (TcTypeEnvCache
              -1
              -1
              (tc-global-shared-view tc-chain-empty-i64-array)
              (tc-global-shared-view tc-chain-empty-i64-array)
              ids
              values
              unsafe-flags
              c-abi-fnptr-flags
              shadow-flags
              scan-through
              true
              env.head
              below.head)))]
      (begin
        (if scan-through
          unit
          (tc-chain-attach-layer!
            env.store
            node.head
            below.head
            count
            capacity
            env.head
            false))
        node))))

(define (tc-env-with-cache-layer-over-explicit [env : TcTypeEnv]) : TcTypeEnv
  (let
    [prefix-count : i64 (tc-env-uncached-prefix-to-explicit-cache-count env)]
    (cond
      [(= prefix-count 0) env]
      [(> prefix-count 0)
        (tc-env-with-cache-prefix-layer
          env
          prefix-count
          false
          (tc-env-after-cache-expanded-prefix env prefix-count))]
      [else (tc-env-with-cache-mode env false)])))

;; Explicit top-env/module caches: marker scans terminate here.
(define (tc-env-with-cache [env : TcTypeEnv]) : TcTypeEnv
  (tc-env-with-cache-mode env false))

;; Collapse a deep stack of local windows into one wider partial cache. Lookup
;; misses jump directly to the existing explicit/global cache, while `rest`
;; keeps the original spine available to marker scans. This avoids rebuilding
;; tens of thousands of immutable top-level bindings for a few hundred locals.
(define (tc-env-with-collapsed-local-cache [env : TcTypeEnv]) : TcTypeEnv
  (let
    [threshold : i64 (tc-local-cache-threshold)]
    [layers : TcTypeEnv (tc-env-after-prefix env threshold)]
    [count : i64
      (+
        (tc-env-cache-count-prefix env threshold)
        (tc-env-partial-local-covered-count layers))]
    (tc-env-with-cache-prefix-layer
      env
      count
      true
      (tc-env-partial-local-base layers))))

;; Threshold-compaction caches inside function-body spines: partial lookup
;; cache for the newest bind window; marker scans keep scanning the full spine.
(define (tc-env-with-local-cache [env : TcTypeEnv]) : TcTypeEnv
  (tc-env-with-partial-local-cache env))

(define (tc-name-bound-id-with-top-env-membership?
  [env : TcTypeEnv]
  [name-id : i64]) : bool
  (let
    [state : TcTopEnvMembershipState (tc-type-env-topenv-membership-state env)]
    [active : bool (not (= (bit-and (tc-topenv-membership-mode state) 1) 0))]
    (cond
      [(and active (not (tc-topenv-membership-maybe? state name-id))) false]
      [(and active (tc-topenv-membership-bound? state name-id)) true]
      [else (tc-name-bound-id? env name-id)])))

(define (tc-bind-alias-id-if-free
  [env : TcTypeEnv]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnv
  (let
    [state : TcTopEnvMembershipState (tc-type-env-topenv-membership-state env)]
    [active : bool (not (= (bit-and (tc-topenv-membership-mode state) 1) 0))]
    (cond
      [(and active (not (tc-topenv-membership-maybe? state name-id)))
        ;; Provably unbound in the top-env spine: bind without the O(spine) scan.
        (begin
          (tc-topenv-membership-mark-bound! state name-id)
          (tc-bind-id env name-id ty))]
      [(and active (tc-topenv-membership-bound? state name-id))
        ;; Provably bound by an earlier spine-joining bind this build: skip
        ;; without the O(spine) scan (the scan would find that binding).
        env]
      [(tc-name-bound-id? env name-id) env]
      [else
        (begin
          (tc-topenv-membership-mark-bound! state name-id)
          (tc-bind-id env name-id ty))])))

(define (tc-module-name-id-by-id [module-id : i64] [name-id : i64]) : i64
  (csym.compiler-symbol-module-key-id-by-id module-id name-id))

(define (tc-env-key-has-name-id? [key : i64]) : bool
  (and
    (>= key 0)
    (< key (ci.intern-capacity))
    (or (< key (ci.intern-pool-len)) (ci.intern-generated-id-active? key))))

(define (tc-env-name-key-id [name-id : i64]) : i64
  (cond
    [(macro-hygiene-global-id? name-id)
      (csym.compiler-symbol-module-key-id-by-id
        (macro-hygiene-global-module-id name-id)
        (macro-hygiene-structural-source-name-id name-id))]
    [(and
        (tc-env-key-has-name-id? name-id)
        (ci.intern-qualified? name-id)
        (not (tc-hygiene-local-name-id? name-id)))
      (csym.compiler-symbol-name-id-key name-id)]
    [else name-id]))

(define tc-unqualified-import-owner-modules : sym_i64_env.SymI64Env
  (sym_i64_env.sym-i64-empty))
(define tc-unqualified-import-ambiguous-first-modules : sym_i64_env.SymI64Env
  (sym_i64_env.sym-i64-empty))
(define tc-unqualified-import-ambiguous-second-modules : sym_i64_env.SymI64Env
  (sym_i64_env.sym-i64-empty))
(define tc-unqualified-import-has-ambiguity : bool
  false)

(define (tc-unqualified-import-ambiguity-reset!) : unit
  (begin
    (set! tc-unqualified-import-owner-modules (sym_i64_env.sym-i64-empty))
    (set!
      tc-unqualified-import-ambiguous-first-modules
      (sym_i64_env.sym-i64-empty))
    (set!
      tc-unqualified-import-ambiguous-second-modules
      (sym_i64_env.sym-i64-empty))
    (set! tc-unqualified-import-has-ambiguity false)))

(define (tc-unqualified-import-key-id
  [importer-module-id : i64]
  [name-id : i64]) : i64
  (tc-module-name-id-by-id importer-module-id name-id))

(define (tc-unqualified-import-note-value!
  [_ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [name-id : i64]) : unit
  (if import-unqualified
    (let
      [key-id : i64 (tc-unqualified-import-key-id importer-module-id name-id)]
      [source-id : i64 source-module-id]
      [binding-id : i64 (tc-module-name-id-by-id alias-id name-id)]
      [owner-id : i64
        (sym_i64_env.sym-i64-lookup-id-or
          (tc-global-shared-view tc-unqualified-import-owner-modules)
          key-id
          (csym.compiler-symbols-missing-handle))]
      (if (csym.compiler-symbols-handle-found? owner-id)
        (if (= owner-id source-id)
          unit
          (if (sym_i64_env.sym-i64-contains-id
            (tc-global-shared-view
              tc-unqualified-import-ambiguous-first-modules)
            key-id)
            unit
            (begin
              (set! tc-unqualified-import-has-ambiguity true)
              (set!
                tc-unqualified-import-ambiguous-first-modules
                (sym_i64_env.sym-i64-bind-id
                  (tc-global-shared-view
                    tc-unqualified-import-ambiguous-first-modules)
                  key-id
                  owner-id))
              (set!
                tc-unqualified-import-ambiguous-second-modules
                (sym_i64_env.sym-i64-bind-id
                  (tc-global-shared-view
                    tc-unqualified-import-ambiguous-second-modules)
                  key-id
                  source-id)))))
        (if (tc-name-bound-id-with-top-env-membership? env binding-id)
          unit
          (set!
            tc-unqualified-import-owner-modules
            (sym_i64_env.sym-i64-bind-id
              (tc-global-shared-view tc-unqualified-import-owner-modules)
              key-id
              source-id)))))
    unit))

(define (tc-bind-import-alias-value-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnv
  (begin
    (tc-unqualified-import-note-value!
      ctx
      env
      alias-id
      importer-module-id
      source-module-id
      import-unqualified
      name-id)
    (tc-bind-id env (tc-module-name-id-by-id alias-id name-id) ty)))

(define (tc-bind-import-alias-value-unsafe-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnv
  (begin
    (tc-unqualified-import-note-value!
      ctx
      env
      alias-id
      importer-module-id
      source-module-id
      import-unqualified
      name-id)
    (tc-bind-unsafe-id env (tc-module-name-id-by-id alias-id name-id) ty)))

(define (tc-bind-import-alias-value-c-abi-fnptr-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnv
  (begin
    (tc-unqualified-import-note-value!
      ctx
      env
      alias-id
      importer-module-id
      source-module-id
      import-unqualified
      name-id)
    (tc-bind-c-abi-fnptr-id env (tc-module-name-id-by-id alias-id name-id) ty)))

(define (tc-bind-import-alias-value-unsafe-c-abi-fnptr-id
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [name-id : i64]
  [ty : ast.AstType]) : TcTypeEnv
  (begin
    (tc-unqualified-import-note-value!
      ctx
      env
      alias-id
      importer-module-id
      source-module-id
      import-unqualified
      name-id)
    (tc-bind-unsafe-c-abi-fnptr-id
      env
      (tc-module-name-id-by-id alias-id name-id)
      ty)))

(define (tc-struct-cleanup-function-type [struct-ty : ast.AstType]) : ast.AstType
  (tc-fn1 struct-ty (ast.AstType.Unit)))

(define (tc-enum-cleanup-function-type [enum-ty : ast.AstType]) : ast.AstType
  (tc-fn1 enum-ty (ast.AstType.Unit)))

(define (tc-bind-struct-cleanup-module-id
  [env : TcTypeEnv]
  [module-id : i64]
  [cleanup : ast.AstStructCleanup]
  [struct-ty : ast.AstType]) : TcTypeEnv
  (match cleanup
    [(ast.AstStructCleanup.No) env]
    [(ast.AstStructCleanup.Fn cleanup-name)
      (tc-bind-id
        env
        (tc-module-name-id-by-id module-id cleanup-name)
        (tc-struct-cleanup-function-type struct-ty))]))

(define (tc-bind-enum-cleanup-module-id
  [env : TcTypeEnv]
  [module-id : i64]
  [cleanup : ast.AstEnumCleanup]
  [enum-ty : ast.AstType]) : TcTypeEnv
  (match cleanup
    [(ast.AstEnumCleanup.No) env]
    [(ast.AstEnumCleanup.Fn cleanup-name)
      (tc-bind-id
        env
        (tc-module-name-id-by-id module-id cleanup-name)
        (tc-enum-cleanup-function-type enum-ty))]))

(define (tc-bind-struct-cleanup-import-alias
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [cleanup : ast.AstStructCleanup]
  [struct-ty : ast.AstType]) : TcTypeEnv
  (match cleanup
    [(ast.AstStructCleanup.No) env]
    [(ast.AstStructCleanup.Fn cleanup-name)
      (tc-bind-import-alias-value-id
        ctx
        env
        alias-id
        importer-module-id
        source-module-id
        import-unqualified
        cleanup-name
        (tc-struct-cleanup-function-type struct-ty))]))

(define (tc-bind-enum-cleanup-import-alias
  [ctx : TcContext]
  [env : TcTypeEnv]
  [alias-id : i64]
  [importer-module-id : i64]
  [source-module-id : i64]
  [import-unqualified : bool]
  [cleanup : ast.AstEnumCleanup]
  [enum-ty : ast.AstType]) : TcTypeEnv
  (match cleanup
    [(ast.AstEnumCleanup.No) env]
    [(ast.AstEnumCleanup.Fn cleanup-name)
      (tc-bind-import-alias-value-id
        ctx
        env
        alias-id
        importer-module-id
        source-module-id
        import-unqualified
        cleanup-name
        (tc-enum-cleanup-function-type enum-ty))]))

(define (tc-default-boundary-id) : i64
  cbi.compiler-builtin-id-tc-default-boundary)

(define (tc-region-marker-id) : i64
  cbi.compiler-builtin-id-tc-active-region)

(define (tc-signature-lifetime-marker-id) : i64
  (let
    [generation : i64 (ci.intern-generation)]
    (if (= tc-signature-lifetime-marker-id-generation generation)
      tc-signature-lifetime-marker-id-cache
      (let
        [marker-id : i64 (ci.intern "\n__typelisp_signature_lifetime_marker")]
        (begin
          (set! tc-signature-lifetime-marker-id-cache marker-id)
          (set! tc-signature-lifetime-marker-id-generation generation)
          marker-id)))))

(define (tc-cleanup-owner-marker-id) : i64
  cbi.compiler-builtin-id-tc-cleanup-owner)

(define (tc-ordinary-arena-owner-marker-id) : i64
  cbi.compiler-builtin-id-tc-ordinary-arena-owner)

(define (tc-atomic-arena-owner-marker-id) : i64
  cbi.compiler-builtin-id-tc-atomic-arena-owner)

;; First-class Arena brands live in the generated-name lane, so source text can
;; render them for diagnostics/reflection but can never name or forge them. The
;; call expression's pooled function-node id is unique within the compile job;
;; canonical generated interning makes repeated checker passes over that call
;; recover the same identity.
(define (tc-arena-brand-ordinary-prefix) : String
  "arena-brand/ordinary#")

(define (tc-arena-brand-atomic-prefix) : String
  "arena-brand/atomic#")

(define (tc-generated-arena-brand-with-prefix-id?
  [name-id : i64]
  [prefix : String]) : bool
  (and
    (ci.intern-generated-id-active? name-id)
    (tc-diag-string-prefix? (ci.intern-str name-id) prefix)))

(define (tc-generated-ordinary-arena-brand-id? [name-id : i64]) : bool
  (tc-generated-arena-brand-with-prefix-id?
    name-id
    (tc-arena-brand-ordinary-prefix)))

(define (tc-generated-atomic-arena-brand-id? [name-id : i64]) : bool
  (tc-generated-arena-brand-with-prefix-id?
    name-id
    (tc-arena-brand-atomic-prefix)))

(define (tc-generated-arena-brand-id? [name-id : i64]) : bool
  (or
    (tc-generated-ordinary-arena-brand-id? name-id)
    (tc-generated-atomic-arena-brand-id? name-id)))

(define (tc-return-type-id) : i64
  cbi.compiler-builtin-id-tc-return-type)

(define (tc-loop-target-id) : i64
  cbi.compiler-builtin-id-tc-loop-target)

(define (tc-hygiene-global-boundary-id) : i64
  cbi.compiler-builtin-id-tc-hygiene-global-boundary)

;; One spelling per prefix, owned by the interner: it classifies every pool
;; entry against these strings when the entry is recorded, so a second copy here
;; would let the stored class and the string test disagree.
(define (tc-hygiene-template-prefix) : String
  (ci.intern-macro-template-prefix))

(define (tc-hygiene-global-prefix) : String
  (ci.intern-macro-global-prefix))

(define (tc-hygiene-local-prefix) : String
  (ci.intern-macro-local-prefix))

(defenum TcHygieneGlobalName
  (Legacy String)
  (Context String String))

(define (tc-empty-type-env) : TcTypeEnv
  (tc-empty-env))

(define (tc-empty-module-local-env-cache) : TcModuleLocalEnvCache
  (TcModuleLocalEnvCache (array.make-array TcModuleLocalEnvEntry 0) 0))

(defstruct TcMacroModuleEnvStateData
  (hygiene-active-top-env-ready bool)
  (hygiene-active-top-env TcTypeEnv)
  (hygiene-module-env-cache TcModuleLocalEnvCache)
  (macro-cache-store i64)
  (macro-cache-head i64)
  (macro-cache-capacity i64)
  (macro-cache-module-ids (__tl_dyn-array i64))
  (macro-cache-values (__tl_dyn-array TcTypeEnv))
  (macro-cache-len i64)
  (hygiene-cache-arena i64)
  (hygiene-cache-arena-root i64)
  (hygiene-cache-arena-mark i64))

(define (tc-macro-module-env-state-new) : TcMacroModuleEnvStateData
  (TcMacroModuleEnvStateData
    false
    (tc-empty-type-env)
    (tc-empty-module-local-env-cache)
    0
    -1
    256
    (array.make-array i64 0)
    (array.make-array TcTypeEnv 0)
    0
    0
    0
    0))

(define (tc-macro-module-env-state-address-initialize [state : TcMacroState]) : i64
  (let
    [address : i64
      (tc-macro-state-slot-address state tc-macro-state-slot-module-env)]
    (if (> address 0)
      address
      (let
        [owner : i64 (tc-macro-state-owner-arena state)]
        (in-arena
          (arena.Arena owner)
          (let
            [cell : (__tl_dyn-array TcMacroModuleEnvStateData)
              (array.make-array TcMacroModuleEnvStateData 1)]
            [_init : unit
              (set! (array-ref cell 0) (tc-macro-module-env-state-new))]
            [next : i64
              (cast
                (unsafe
                  (ptr->int
                    (ptr-cast
                      (__tl_array-data cell)
                      : (Ptr TcMacroModuleEnvStateData))))
                : i64)]
            (begin
              (tc-macro-state-slot-address-set!
                state
                tc-macro-state-slot-module-env
                next)
              next)))))))

(define (tc-macro-module-env-state-address [state : TcMacroState]) : i64
  (tc-macro-state-address-fast
    state
    0
    tc-macro-module-env-state-address-initialize))

(define (tc-macro-module-env-state-data [state : TcMacroState]) : TcMacroModuleEnvStateData
  (unsafe
    (ptr-read
      (int->ptr
        (cast (tc-macro-module-env-state-address state) : u64)
        : (Ptr TcMacroModuleEnvStateData)))))

(define (tc-macro-module-env-state-data-set!
  [state : TcMacroState]
  [data : TcMacroModuleEnvStateData]) : unit
  (unsafe
    (ptr-write!
      (int->ptr
        (cast (tc-macro-module-env-state-address state) : u64)
        : (MutPtr TcMacroModuleEnvStateData))
      data)))

;; Arena that owns the module-local env cache chain. The cache lives in
;; the GLOBAL above, but hygiene lookups fire deep inside per-decl typechecking
;; whose allocations land in scratch arenas; the cache entries and cached env
;; internals would dangle once the scratch arena is reclaimed. Build cache
;; entries inside this dedicated persistent arena (same idiom as the node
;; pools' base arena). Linux starts small for tiny compiles; if a large cache
;; spills, reset promotes it once to a reusable general root. Module identity
;; itself is the stable intern ID.
(define (tc-hygiene-module-env-cache-arena-install!
  [state : TcMacroState]
  [root : i64]) : unit
  (let
    [data : TcMacroModuleEnvStateData (tc-macro-module-env-state-data state)]
    (begin
      (set! data.hygiene-cache-arena-root root)
      (set! data.hygiene-cache-arena root)
      (in-arena
        (arena.Arena root)
        (set! data.hygiene-cache-arena-mark (arena.tl_region_mark)))
      (tc-macro-module-env-state-data-set! state data))))

(define (tc-hygiene-module-env-cache-arena-handle [state : TcMacroState]) : i64
  (let
    [data : TcMacroModuleEnvStateData (tc-macro-module-env-state-data state)]
    (begin
      (if (= data.hygiene-cache-arena-root 0)
        (tc-hygiene-module-env-cache-arena-install!
          state
          (cfg windows (arena.tl_arena_make) (arena.tl_arena_make_small)))
        unit)
      (__tl-project-field
        (tc-macro-module-env-state-data state)
        hygiene-cache-arena))))

;; Installing the owner publishes three ownership fields into the job state.
;; Return a post-install snapshot so callers can safely update another field
;; and write the aggregate back without erasing that newly published state.
(define (tc-hygiene-module-env-cache-owned-data [state : TcMacroState]) : TcMacroModuleEnvStateData
  (begin
    (tc-hygiene-module-env-cache-arena-handle state)
    (tc-macro-module-env-state-data state)))

(define (tc-hygiene-module-env-cache-arena-reset! [state : TcMacroState]) : unit
  (let
    [data : TcMacroModuleEnvStateData (tc-macro-module-env-state-data state)]
    (if (= data.hygiene-cache-arena-root 0)
      unit
      ;; Growth appends segments behind the stable root, so the original mark
      ;; can reset the complete chain without recapturing or replacing a head.
      (in-arena
        (arena.Arena data.hygiene-cache-arena-root)
        (unsafe
          (arena.tl_region_reset data.hygiene-cache-arena-mark))))))

(define (tc-macro-module-env-cache-clear! [state : TcMacroState]) : unit
  (let
    [data : TcMacroModuleEnvStateData (tc-macro-module-env-state-data state)]
    (begin
      (set! data.macro-cache-store 0)
      (set! data.macro-cache-head -1)
      (set! data.macro-cache-len 0)
      (tc-macro-module-env-state-data-set! state data))))

(define (tc-hygiene-clear-active-top-env! [state : TcMacroState]) : unit
  (let
    [data : TcMacroModuleEnvStateData (tc-macro-module-env-state-data state)]
    (begin
      (set! data.hygiene-active-top-env-ready false)
      (set! data.hygiene-active-top-env (tc-empty-type-env))
      (set! data.hygiene-module-env-cache (tc-empty-module-local-env-cache))
      (tc-macro-module-env-state-data-set! state data)
      (tc-hygiene-module-env-cache-arena-reset! state))))

(define (tc-hygiene-module-env-cache-release! [state : TcMacroState]) : unit
  (let
    [data : TcMacroModuleEnvStateData (tc-macro-module-env-state-data state)]
    [head : i64 data.hygiene-cache-arena]
    (begin
      (set! data.hygiene-active-top-env-ready false)
      (set! data.hygiene-active-top-env (tc-empty-type-env))
      (set! data.hygiene-module-env-cache (tc-empty-module-local-env-cache))
      (if (= head 0)
        unit
        (begin
          (if (= (arena.tl_arena_current) head)
            (unsafe
              (arena.tl_arena_set ast.node-pool-base-arena))
            unit)
          (unsafe
            (arena.tl_arena_destroy head))))
      (set! data.hygiene-cache-arena 0)
      (set! data.hygiene-cache-arena-root 0)
      (set! data.hygiene-cache-arena-mark 0)
      (tc-macro-module-env-state-data-set! state data))))

(test
  tc-hygiene-module-env-cache-lazy-owner-state
  (let
    [job : TcJobState (tc-job-state-new)]
    [state : TcMacroState (tc-job-state-macro-state job)]
    [before : TcMacroModuleEnvStateData (tc-macro-module-env-state-data state)]
    [owned : TcMacroModuleEnvStateData
      (tc-hygiene-module-env-cache-owned-data state)]
    (begin
      ;; Mirror the cache success arm: update unrelated aggregate state and
      ;; publish it after the lazy owner install.
      (set! owned.hygiene-active-top-env-ready true)
      (tc-macro-module-env-state-data-set! state owned)
      (let
        [after : TcMacroModuleEnvStateData
          (tc-macro-module-env-state-data state)]
        [preserved? : bool
          (and
            (= before.hygiene-cache-arena-root 0)
            (> after.hygiene-cache-arena-root 0)
            (= after.hygiene-cache-arena after.hygiene-cache-arena-root)
            after.hygiene-active-top-env-ready)]
        (begin
          (tc-hygiene-module-env-cache-release! state)
          (test.assert-true
            preserved?
            "hygiene cache writes preserve a lazily installed owner"))))))

(define (tc-hygiene-string-prefix? [text : String] [prefix : String]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [prefix-len : i64 (string.string-length prefix)]
    [text-data : (Ptr u8)
      (unsafe
        (string-data (& text)))]
    [prefix-data : (Ptr u8)
      (unsafe
        (string-data (& prefix)))]
    [i : i64 0]
    [word-end : i64 (- prefix-len 7)]
    (if (< text-len prefix-len)
      false
      (begin
        (while (< i word-end)
          (if (=
            (unsafe
              (ptr-read (ptr-cast (ptr-offset text-data i) : (Ptr i64))))
            (unsafe
              (ptr-read (ptr-cast (ptr-offset prefix-data i) : (Ptr i64)))))
            (set! i (+ i 8))
            (return false)))
        (while (< i prefix-len)
          (if (=
            (unsafe
              (ptr-read (ptr-offset text-data i)))
            (unsafe
              (ptr-read (ptr-offset prefix-data i))))
            (set! i (+ i 1))
            (return false)))
        true))))

(define (tc-hygiene-name-base [name : String] [prefix : String]) : String
  (string.substring
    name
    (string.string-length prefix)
    (- (string.string-length name) (string.string-length prefix))))

(define (tc-hygiene-template-name? [name : String]) : bool
  (tc-hygiene-string-prefix? name (tc-hygiene-template-prefix)))

;; Pool ids and the structural families partition the id space: every
;; structural base is at least stride^2 above the pool range, so a pool id can
;; never be a template-source id. Testing the pool range first therefore keeps
;; the same answer while skipping the structural predicate on the common path,
;; and the prefix answer comes from the class the interner already recorded.
(define (tc-hygiene-template-name-id? [name-id : i64]) : bool
  (if (and (>= name-id 0) (< name-id (ci.intern-capacity)))
    (ci.intern-macro-template-name-id? name-id)
    (ci.intern-template-source-id? name-id)))

(define (tc-hygiene-template-source-id-or [name-id : i64] [fallback : i64]) : i64
  (if (ci.intern-template-source-id? name-id)
    (ci.intern-template-source-name-id name-id)
    fallback))

(define (tc-hygiene-template-base [name : String]) : String
  (tc-hygiene-name-base name (tc-hygiene-template-prefix)))

(define (tc-hygiene-global-name? [name : String]) : bool
  (tc-hygiene-string-prefix? name (tc-hygiene-global-prefix)))

(define (tc-hygiene-local-name? [name : String]) : bool
  (tc-hygiene-string-prefix? name (tc-hygiene-local-prefix)))

(define (tc-hygiene-global-name-id? [name-id : i64]) : bool
  (if (and (>= name-id 0) (< name-id (ci.intern-capacity)))
    (ci.intern-macro-global-name-id? name-id)
    (macro-hygiene-global-id? name-id)))

(define (tc-structural-local-name-id? [name-id : i64]) : bool
  (if (< name-id (ci.intern-capacity))
    false
    (or
      (macro-hygiene-local-id? name-id)
      (ci.intern-structural-local-id? name-id))))

(define (tc-hygiene-local-name-id? [name-id : i64]) : bool
  (if (and (>= name-id 0) (< name-id (ci.intern-capacity)))
    (ci.intern-macro-local-name-id? name-id)
    (tc-structural-local-name-id? name-id)))

(define (tc-hygiene-name-text-id [name-id : i64]) : String
  (cond
    [(and (>= name-id 0) (< name-id (ci.intern-capacity)))
      (ci.intern-str name-id)]
    [(ci.intern-structural-local-id? name-id)
      (ci.intern-str (ci.intern-structural-local-source-name-id name-id))]
    [(or (macro-hygiene-global-id? name-id) (macro-hygiene-local-id? name-id))
      (ci.intern-str (macro-hygiene-structural-source-name-id name-id))]
    [(ci.intern-template-source-id? name-id)
      (ci.intern-str (ci.intern-template-source-name-id name-id))]
    [(or
        (csym.compiler-composite-pair-key-id? name-id)
        (csym.compiler-composite-triple-key-id? name-id))
      (ast.ast-nominal-name-id-display name-id)]
    [else
      (ci.intern-syntax-name-text-or
        name-id
        (str_cat.str-cat "<id:" (string.int->string name-id) ">"))]))

(define (tc-hygiene-global-base [name : String]) : String
  (tc-hygiene-name-base name (tc-hygiene-global-prefix)))

(define (tc-hygiene-global-name [name : String]) : String
  (str_cat.str-cat (tc-hygiene-global-prefix) name))

(define (tc-hygiene-global-context-name [module : String] [name : String]) : String
  (tc-hygiene-global-name (str_cat.str-cat module "|" name)))

(define (tc-hygiene-context-separator-index [payload : String]) : i64
  (let
    [i : i64 0]
    [n : i64 (string.string-length payload)]
    [found : i64 -1]
    (begin
      (while (and (< i n) (< found 0))
        (if (= (cast (string.string-ref payload i) : i64) 124)
          (set! found i)
          (set! i (+ i 1))))
      found)))

(define (tc-hygiene-global-decode [name : String]) : TcHygieneGlobalName
  (let
    [payload : String (tc-hygiene-global-base name)]
    [sep : i64 (tc-hygiene-context-separator-index payload)]
    (if (< sep 0)
      (TcHygieneGlobalName.Legacy payload)
      (let
        [start : i64 (+ sep 1)]
        (TcHygieneGlobalName.Context
          (string.substring payload 0 sep)
          (string.substring
            payload
            start
            (- (string.string-length payload) start)))))))

(define (tc-hygiene-global-call-name [name : String]) : String
  (if (tc-hygiene-global-name? name)
    (match (tc-hygiene-global-decode name)
      [(TcHygieneGlobalName.Legacy lookup-name) lookup-name]
      [(TcHygieneGlobalName.Context _ lookup-name) lookup-name])
    name))

(define (tc-hygiene-global-symbol-name [name : String]) : String
  (if (tc-hygiene-global-name? name)
    (match (tc-hygiene-global-decode name)
      [(TcHygieneGlobalName.Legacy lookup-name) lookup-name]
      [(TcHygieneGlobalName.Context module lookup-name)
        (if (tc-name-qualified? lookup-name)
          lookup-name
          (csym.compiler-symbol-module-key module lookup-name))])
    name))

(define (tc-hygiene-global-env [top-env : TcTypeEnv]) : TcTypeEnv
  (tc-bind-id top-env (tc-hygiene-global-boundary-id) (ast.AstType.Unit)))

(define (tc-hygiene-reset-active-top-env!
  [state : TcMacroState]
  [top-env : TcTypeEnv]) : unit
  (let
    [data : TcMacroModuleEnvStateData (tc-macro-module-env-state-data state)]
    (begin
      (set! data.hygiene-active-top-env top-env)
      (set! data.hygiene-active-top-env-ready true)
      (set! data.hygiene-module-env-cache (tc-empty-module-local-env-cache))
      (tc-macro-module-env-state-data-set! state data)
      (tc-hygiene-module-env-cache-arena-reset! state))))

(define (tc-unsafe-marker-id) : i64
  cbi.compiler-builtin-id-tc-unsafe-context)

(define (tc-enter-unsafe [env : TcTypeEnv]) : TcTypeEnv
  (tc-bind-runtime-marker-id
    env
    (tc-unsafe-marker-id)
    (ast.AstType.Unit)
    TcTypeEnvScopedMarkerKind.UnsafeContext))

(define (tc-env-marker-type-scan [env : TcTypeEnv] [name-id : i64]) : ast.AstMaybeType
  (let
    [store-handle : i64 env.store]
    [head : i64 env.head]
    (cond
      [(= head -1) (ast.AstMaybeType.No)]
      [(< head -1)
        (let
          [cache : TcTypeEnvCache
            (tc-type-env-cache-at
              (tc-type-env-cache-ptr
                store-handle
                (tc-type-env-cache-index head)))]
          [ids : tc_i64_i64_map.Map cache.ids]
          (if cache.scan-through
            (match (tc_i64_i64_map.get (& ids) name-id)
              [(tc_i64_i64_map.LookupFound index)
                (ast.AstMaybeType.Some (array-ref cache.values index))]
              [(tc_i64_i64_map.LookupMissing)
                (if cache.partial
                  (tc-env-marker-type-scan
                    (TcTypeEnv store-handle cache.below 0)
                    name-id)
                  (ast.AstMaybeType.No))])
            (ast.AstMaybeType.No)))]
      [else
        (let
          [binding-ptr : (Ptr TcTypeEnvBinding)
            (tc-type-env-binding-ptr store-handle head)]
          (if (= (tc-type-env-binding-name-at binding-ptr) name-id)
            (ast.AstMaybeType.Some (tc-type-env-binding-type-at binding-ptr))
            (tc-env-marker-type-scan
              (TcTypeEnv
                store-handle
                (tc-type-env-binding-parent-at binding-ptr)
                0)
              name-id)))])))

(define (tc-env-marker-type [env : TcTypeEnv] [name-id : i64]) : ast.AstMaybeType
  (let
    [head : i64 env.head]
    (if (< head -1)
      (let
        [store-handle : i64 env.store]
        [cache : TcTypeEnvCache
          (tc-type-env-cache-at
            (tc-type-env-cache-ptr store-handle (tc-type-env-cache-index head)))]
        (if cache.scan-through
          (tc-env-marker-type-scan env name-id)
          (tc-env-marker-type-scan
            (TcTypeEnv store-handle cache.rest 0)
            name-id)))
      (tc-env-marker-type-scan env name-id))))

(define (tc-in-unsafe? [env : TcTypeEnv]) : bool
  (if tc-type-env-scoped-runtime-active
    (tc-type-env-scoped-carrier-in-unsafe? (tc-type-env-scoped-runtime-current))
    (begin
      (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
      (match (tc-env-marker-type env (tc-unsafe-marker-id))
        [(ast.AstMaybeType.Some _) true]
        [(ast.AstMaybeType.No) false]))))

(define (tc-unused-unsafe-no-span) : ast.AstSourceSpan
  (ast.ast-source-span 0 0 0 0))

(define (tc-unused-unsafe-state-storage-ensure! [state : TcUnusedUnsafeState]) : unit
  (let
    [data : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
    (if (> (array.length data.block-spans) 0)
      unit
      (in-arena
        (arena.Arena data.fixed-storage-arena)
        (begin
          (set! data.block-spans (array.make-array ast.AstSourceSpan 128))
          (set! data.block-paths (array.make-array String 128))
          (set! data.block-used (array.make-array bool 128))
          (tc-unused-unsafe-state-data-set! state data))))))

(define (tc-unused-unsafe-tracking-reset!
  [state : TcUnusedUnsafeState]
  [path : String]) : unit
  (begin
    (tc-unused-unsafe-state-storage-ensure! state)
    (let
      [data : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
      (begin
        (set! data.current-block -1)
        (set! data.current-path "")
        (set! data.target-path path)
        (set! data.block-len 0)
        (set! data.enabled true)
        (tc-unused-unsafe-state-data-set! state data)))))

(define (tc-unused-unsafe-tracking-disable! [state : TcUnusedUnsafeState]) : unit
  (let
    [data : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
    (begin
      (set! data.enabled false)
      (set! data.current-block -1)
      (set! data.current-path "")
      (set! data.target-path "")
      (tc-unused-unsafe-state-data-set! state data))))

(define (tc-unused-unsafe-tracking-clear! [state : TcUnusedUnsafeState]) : unit
  (begin
    (tc-unused-unsafe-tracking-disable! state)
    (let
      [data : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
      (begin
        (set! data.block-len 0)
        (tc-unused-unsafe-state-data-set! state data)))))

(define (tc-unused-unsafe-block-count [state : TcUnusedUnsafeState]) : i64
  (let
    [data : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
    data.block-len))

(define (tc-unused-unsafe-block-path
  [state : TcUnusedUnsafeState]
  [index : i64]) : String
  (let
    [data : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
    (if (and (>= index 0) (< index data.block-len))
      (array-ref data.block-paths index)
      "")))

(define (tc-unused-unsafe-block-span
  [state : TcUnusedUnsafeState]
  [index : i64]) : ast.AstSourceSpan
  (let
    [data : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
    (if (and (>= index 0) (< index data.block-len))
      (array-ref data.block-spans index)
      (tc-unused-unsafe-no-span))))

(define (tc-unused-unsafe-block-used?
  [state : TcUnusedUnsafeState]
  [index : i64]) : bool
  (let
    [data : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
    (if (and (>= index 0) (< index data.block-len))
      (array-ref data.block-used index)
      false)))

(define (tc-unused-unsafe-set-current-path!
  [state : TcUnusedUnsafeState]
  [path : String]) : String
  (let
    [data : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
    [current : String data.current-path]
    [prev : String (string.copy (& current))]
    (begin
      (if data.enabled
        (begin
          (set! data.current-path path)
          (tc-unused-unsafe-state-data-set! state data))
        unit)
      prev)))

(define (tc-unused-unsafe-restore-current-path!
  [state : TcUnusedUnsafeState]
  [path : String]) : unit
  (let
    [data : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
    (if data.enabled
      (begin
        (set! data.current-path path)
        (tc-unused-unsafe-state-data-set! state data))
      unit)))

(define (tc-unused-unsafe-span-eq?
  [a : ast.AstSourceSpan]
  [b : ast.AstSourceSpan]) : bool
  (and
    (= (ast.ast-source-span-start-line a) (ast.ast-source-span-start-line b))
    (= (ast.ast-source-span-start-col a) (ast.ast-source-span-start-col b))
    (= (ast.ast-source-span-end-line a) (ast.ast-source-span-end-line b))
    (= (ast.ast-source-span-end-col a) (ast.ast-source-span-end-col b))))

(define (tc-unused-unsafe-find-existing
  [state : TcUnusedUnsafeState]
  [path : String]
  [span : ast.AstSourceSpan]
  [index : i64]) : i64
  (let
    [data : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
    (if (>= index data.block-len)
      -1
      (if (and
        (string.eq (array-ref data.block-paths index) path)
        (tc-unused-unsafe-span-eq? (array-ref data.block-spans index) span))
        index
        (tc-unused-unsafe-find-existing state path span (+ index 1))))))

(define (tc-unused-unsafe-grow-copy
  [data : TcUnusedUnsafeStateData]
  [new-spans : (__tl_dyn-array ast.AstSourceSpan)]
  [new-paths : (__tl_dyn-array String)]
  [new-used : (__tl_dyn-array bool)]
  [index : i64]) : unit
  (if (>= index data.block-len)
    unit
    (begin
      (set! (array-ref new-spans index) (array-ref data.block-spans index))
      (set! (array-ref new-paths index) (array-ref data.block-paths index))
      (set! (array-ref new-used index) (array-ref data.block-used index))
      (tc-unused-unsafe-grow-copy data new-spans new-paths new-used (+ index 1)))))

(define (tc-unused-unsafe-grow! [state : TcUnusedUnsafeState]) : unit
  (let
    [data : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
    [old-cap : i64 (array.length data.block-spans)]
    [new-cap : i64 (* old-cap 2)]
    (in-arena
      (arena.Arena data.fixed-storage-arena)
      (let
        [new-spans : (__tl_dyn-array ast.AstSourceSpan)
          (array.make-array ast.AstSourceSpan new-cap)]
        [new-paths : (__tl_dyn-array String) (array.make-array String new-cap)]
        [new-used : (__tl_dyn-array bool) (array.make-array bool new-cap)]
        (begin
          (tc-unused-unsafe-grow-copy data new-spans new-paths new-used 0)
          (set! data.block-spans new-spans)
          (set! data.block-paths new-paths)
          (set! data.block-used new-used)
          (tc-unused-unsafe-state-data-set! state data))))))

(define (tc-unused-unsafe-push
  [state : TcUnusedUnsafeState]
  [span : ast.AstSourceSpan]) : i64
  (let
    [data : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
    [existing : i64
      (tc-unused-unsafe-find-existing state data.current-path span 0)]
    (if (>= existing 0)
      existing
      (let
        [slot : i64 data.block-len]
        (begin
          (if (>= slot (array.length data.block-spans))
            (tc-unused-unsafe-grow! state)
            unit)
          (let
            [next : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
            (begin
              (set! (array-ref next.block-spans slot) span)
              (set! (array-ref next.block-paths slot) next.current-path)
              (set! (array-ref next.block-used slot) false)
              (set! next.block-len (+ slot 1))
              (tc-unused-unsafe-state-data-set! state next)
              slot)))))))

(define (tc-unused-unsafe-enter-block
  [state : TcUnusedUnsafeState]
  [span : TcMaybeAstSourceSpan]) : i64
  (let
    [data : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
    [prev : i64 data.current-block]
    (begin
      (if data.enabled
        (if (string.eq data.current-path data.target-path)
          (match span
            [(TcMaybeAstSourceSpan.Some real-span)
              (let
                [slot : i64 (tc-unused-unsafe-push state real-span)]
                [next : TcUnusedUnsafeStateData
                  (tc-unused-unsafe-state-data state)]
                (begin
                  (set! next.current-block slot)
                  (tc-unused-unsafe-state-data-set! state next)))]
            [(TcMaybeAstSourceSpan.No) unit])
          unit)
        unit)
      prev)))

(define (tc-unused-unsafe-restore-block!
  [state : TcUnusedUnsafeState]
  [prev : i64]) : unit
  (let
    [data : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
    (if data.enabled
      (begin
        (set! data.current-block prev)
        (tc-unused-unsafe-state-data-set! state data))
      unit)))

(define (tc-unused-unsafe-mark-current-used! [state : TcUnusedUnsafeState]) : unit
  (let
    [data : TcUnusedUnsafeStateData (tc-unused-unsafe-state-data state)]
    [current : i64 data.current-block]
    (if (and data.enabled (>= current 0) (< current data.block-len))
      (set! (array-ref data.block-used current) true)
      unit)))

(define (tc-unsafe-begin-list-with-expected
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]
  [expected : ast.AstType]
  [span : TcMaybeAstSourceSpan]) : ResultTcType
  (let
    [unused-unsafe : TcUnusedUnsafeState
      (tc-job-state-unused-unsafe (tc-context-job-state ctx))]
    [prev : i64 (tc-unused-unsafe-enter-block unused-unsafe span)]
    [result : ResultTcType
      (tc-begin-list-with-expected ctx (tc-enter-unsafe env) exprs expected)]
    (begin
      (tc-unused-unsafe-restore-block! unused-unsafe prev)
      result)))

(define (tc-unsafe-begin-list
  [ctx : TcContext]
  [env : TcTypeEnv]
  [exprs : ast.AstExprList]
  [span : TcMaybeAstSourceSpan]) : ResultTcType
  (let
    [unused-unsafe : TcUnusedUnsafeState
      (tc-job-state-unused-unsafe (tc-context-job-state ctx))]
    [prev : i64 (tc-unused-unsafe-enter-block unused-unsafe span)]
    [result : ResultTcType (tc-begin-list ctx (tc-enter-unsafe env) exprs)]
    (begin
      (tc-unused-unsafe-restore-block! unused-unsafe prev)
      result)))

(define (tc-bind-return-type [env : TcTypeEnv] [ty : ast.AstType]) : TcTypeEnv
  (tc-bind-runtime-marker-id
    env
    (tc-return-type-id)
    ty
    TcTypeEnvScopedMarkerKind.Other))

(define (tc-current-return-type [env : TcTypeEnv]) : ResultTcType
  (if tc-type-env-scoped-runtime-active
    (tc-type-env-scoped-carrier-current-return-type
      (tc-type-env-scoped-runtime-current))
    (begin
      (cfg compile-profile (compiler-tc-env-profile-note-marker-scan))
      (match (tc-env-marker-type env (tc-return-type-id))
        [(ast.AstMaybeType.Some ty) (ResultTcType.Ok ty)]
        [(ast.AstMaybeType.No)
          (ResultTcType.Err
            "typecheck: try requires enclosing Result-like function")]))))

(define (tc-enter-loop-target [env : TcTypeEnv]) : TcTypeEnv
  (tc-bind-runtime-marker-id
    env
    (tc-loop-target-id)
    (ast.AstType.Unit)
    TcTypeEnvScopedMarkerKind.Other))

(define (tc-clear-loop-target [env : TcTypeEnv]) : TcTypeEnv
  (tc-bind-runtime-marker-id
    env
    (tc-loop-target-id)
    (ast.AstType.Never)
    TcTypeEnvScopedMarkerKind.Other))

(define (tc-in-loop-target? [env : TcTypeEnv]) : bool
  (match (tc-env-marker-type env (tc-loop-target-id))
    [(ast.AstMaybeType.Some ty) (not (tc-never-type? ty))]
    [(ast.AstMaybeType.No) false]))

(define (tc-loop-control-expr [env : TcTypeEnv] [form : String]) : ResultTcType
  (if (tc-in-loop-target? env)
    (ResultTcType.Ok (ast.AstType.Never))
    (ResultTcType.Err
      (str_cat.str-cat "typecheck: " form " requires enclosing scalar while"))))

(define (tc-type-list1 [a : ast.AstType]) : ast.AstTypeList
  (ast.ast-type-cons a (ast.ast-type-list-new)))

(define (tc-type-list2 [a : ast.AstType] [b : ast.AstType]) : ast.AstTypeList
  (ast.ast-type-cons a (ast.ast-type-cons b (ast.ast-type-list-new))))

(define (tc-type-list3 [a : ast.AstType] [b : ast.AstType] [c : ast.AstType]) : ast.AstTypeList
  (ast.ast-type-cons
    a
    (ast.ast-type-cons b (ast.ast-type-cons c (ast.ast-type-list-new)))))

(define (tc-fn0 [ret : ast.AstType]) : ast.AstType
  (ast.ast-ty-func (ast.ast-type-list-new) ret))

(define (tc-fn1 [a : ast.AstType] [ret : ast.AstType]) : ast.AstType
  (ast.ast-ty-func (tc-type-list1 a) ret))

(define (tc-fn2 [a : ast.AstType] [b : ast.AstType] [ret : ast.AstType]) : ast.AstType
  (ast.ast-ty-func (tc-type-list2 a b) ret))

(define (tc-fn3
  [a : ast.AstType]
  [b : ast.AstType]
  [c : ast.AstType]
  [ret : ast.AstType]) : ast.AstType
  (ast.ast-ty-func (tc-type-list3 a b c) ret))

(define (tc-fn4
  [a : ast.AstType]
  [b : ast.AstType]
  [c : ast.AstType]
  [d : ast.AstType]
  [ret : ast.AstType]) : ast.AstType
  (ast.ast-ty-func
    (ast.ast-type-cons
      a
      (ast.ast-type-cons
        b
        (ast.ast-type-cons c (ast.ast-type-cons d (ast.ast-type-list-new)))))
    ret))

(define (tc-type-list-render [types : ast.AstTypeList]) : String
  (tc-type-list-render-at (& types) 0))

(define (tc-type-list-render-at
  [types : (& types ast.AstTypeList)]
  [index : i64]) : String
  (if (>= index (ast.ast-type-list-len types))
    ""
    (let
      [head : ast.AstType
        (ast.ty-node-get
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      (str_cat.str-cat
        (tc-type-render head)
        (if (>= (+ index 1) (ast.ast-type-list-len types))
          ""
          (str_cat.str-cat " " (tc-type-list-render-at types (+ index 1))))))))

(define (tc-lifetime-list-render [lifetimes : ast.AstLifetimeList]) : String
  (tc-lifetime-list-render-at (& lifetimes) 0))

(define (tc-lifetime-list-render-at
  [lifetimes : (& lifetimes ast.AstLifetimeList)]
  [index : i64]) : String
  (if (>= index (ast.ast-lifetime-list-len lifetimes))
    ""
    (let
      [head : i64
        (ast.ast-lifetime-list-get lifetimes index (ast.ast-lifetime-fallback))]
      (str_cat.str-cat
        (tc-lifetime-name-render head)
        (if (>= (+ index 1) (ast.ast-lifetime-list-len lifetimes))
          ""
          (str_cat.str-cat
            " "
            (tc-lifetime-list-render-at lifetimes (+ index 1))))))))

(define (tc-render-nominal-lifetime-type
  [name : String]
  [lifetimes : ast.AstLifetimeList]) : String
  (str_cat.str-cat "(" name " " (tc-lifetime-list-render lifetimes) ")"))

(define (tc-elided-lifetime-name-prefix) : String
  "\n__typelisp_signature_elided_lifetime_")

(define (tc-elaborated-lifetime-hidden? [name : i64]) : bool
  (or
    (= name cbi.compiler-builtin-id-fix-empty)
    (and
      (ci.intern-renderable-id? name)
      (tc-diag-string-prefix?
        (ci.intern-str name)
        (tc-elided-lifetime-name-prefix)))))

(define (tc-type-render [ty : ast.AstType]) : String
  (match ty
    [(ast.AstType.I64) "i64"]
    [(ast.AstType.I32) "i32"]
    [(ast.AstType.I16) "i16"]
    [(ast.AstType.I8) "i8"]
    [(ast.AstType.U64) "u64"]
    [(ast.AstType.U32) "u32"]
    [(ast.AstType.U16) "u16"]
    [(ast.AstType.U8) "u8"]
    [(ast.AstType.F64) "f64"]
    [(ast.AstType.F32) "f32"]
    [(ast.AstType.Bool) "bool"]
    [(ast.AstType.Char) "char"]
    [(ast.AstType.String) "String"]
    [(ast.AstType.Str) "str"]
    [(ast.AstType.Bytes) "bytes"]
    [(ast.AstType.Unit) "unit"]
    [(ast.AstType.Never) "never"]
    [(ast.AstType.Expr) "Expr"]
    [(ast.AstType.ExprList) "ExprList"]
    [(ast.AstType.Func args ret)
      (str_cat.str-cat
        "(-> "
        (tc-type-list-render (__tl-box-place args))
        " "
        (tc-type-render (ast.ty-node-get ret))
        ")")]
    [(ast.AstType.Tuple elems)
      (str_cat.str-cat
        "(Tuple "
        (tc-type-list-render (__tl-box-place elems))
        ")")]
    [(ast.AstType.Array elem count)
      (str_cat.str-cat
        "(Array "
        (tc-type-render (ast.ty-node-get elem))
        " "
        (string.int->string count)
        ")")]
    [(ast.AstType.DynArray elem)
      (str_cat.str-cat "(Array " (tc-type-render (ast.ty-node-get elem)) ")")]
    [(ast.AstType.Slice elem)
      (str_cat.str-cat "(Slice " (tc-type-render (ast.ty-node-get elem)) ")")]
    [(ast.AstType.Box elem)
      (str_cat.str-cat "(Box " (tc-type-render (ast.ty-node-get elem)) ")")]
    [(ast.AstType.Ptr elem)
      (str_cat.str-cat "(Ptr " (tc-type-render (ast.ty-node-get elem)) ")")]
    [(ast.AstType.MutPtr elem)
      (str_cat.str-cat "(MutPtr " (tc-type-render (ast.ty-node-get elem)) ")")]
    [(ast.AstType.Ref region inner)
      (if (tc-elaborated-lifetime-hidden? region)
        (str_cat.str-cat "(& " (tc-type-render (ast.ty-node-get inner)) ")")
        (str_cat.str-cat
          "(& "
          (tc-lifetime-name-render region)
          " "
          (tc-type-render (ast.ty-node-get inner))
          ")"))]
    [(ast.AstType.MutRef region inner)
      (if (tc-elaborated-lifetime-hidden? region)
        (str_cat.str-cat "(&mut " (tc-type-render (ast.ty-node-get inner)) ")")
        (str_cat.str-cat
          "(&mut "
          (tc-lifetime-name-render region)
          " "
          (tc-type-render (ast.ty-node-get inner))
          ")"))]
    [(ast.AstType.Region region inner)
      (str_cat.str-cat
        "(Region "
        (tc-lifetime-name-render region)
        " "
        (tc-type-render (ast.ty-node-get inner))
        ")")]
    [(ast.AstType.Enum name) (tc-nominal-name-id-display name)]
    [(ast.AstType.EnumArgs name lifetimes)
      (tc-render-nominal-lifetime-type
        (tc-nominal-name-id-display name)
        (__tl-box-place lifetimes))]
    [(ast.AstType.Struct name) (tc-nominal-name-id-display name)]
    [(ast.AstType.StructArgs name lifetimes)
      (tc-render-nominal-lifetime-type
        (tc-nominal-name-id-display name)
        (__tl-box-place lifetimes))]
    [(ast.AstType.Var name) (tc-nominal-name-id-display name)]
    [(ast.AstType.VarArgs name lifetimes)
      (tc-render-nominal-lifetime-type
        (tc-nominal-name-id-display name)
        (__tl-box-place lifetimes))]
    [(ast.AstType.Consume inner)
      (str_cat.str-cat
        "(:consume "
        (tc-type-render (ast.ty-node-get inner))
        ")")]))

(define (tc-type-mismatch-message
  [actual : ast.AstType]
  [expected : ast.AstType]
  [message : String]) : String
  (str_cat.str-cat
    message
    ": expected "
    (tc-type-render (tc-type-without-regions expected))
    ", found "
    (tc-type-render (tc-type-without-regions actual))))

(define (tc-default-env) : TcTypeEnv
  (tc-bind-id (tc-default-env-base) (tc-default-boundary-id) (ast.AstType.Unit)))

(define (tc-default-env-with-job-state [state : TcJobState]) : TcTypeEnv
  (tc-bind-id
    (tc-default-env-base-with-job-state state)
    (tc-default-boundary-id)
    (ast.AstType.Unit)))

(define (tc-default-env-base) : TcTypeEnv
  (let
    [e0 : TcTypeEnv (tc-empty-env)]
    [e1 : TcTypeEnv
      (tc-bind-id
        e0
        cbi.compiler-builtin-id-cpuid
        (tc-fn2
          (ast.AstType.I64)
          (ast.AstType.I64)
          (ast.ast-ty-tuple
            (ast.ast-type-cons
              (ast.AstType.I32)
              (ast.ast-type-cons
                (ast.AstType.I32)
                (ast.ast-type-cons
                  (ast.AstType.I32)
                  (ast.ast-type-cons (ast.AstType.I32) (ast.ast-type-list-new))))))))]
    [e2 : TcTypeEnv
      (tc-bind-id
        e1
        cbi.compiler-builtin-id-xgetbv
        (tc-fn1 (ast.AstType.I64) (ast.AstType.I64)))]
    (tc-bind-id e2 (tc-default-boundary-id) (ast.AstType.Unit))))

(define (tc-default-env-base-with-job-state [state : TcJobState]) : TcTypeEnv
  (let
    [e0 : TcTypeEnv (tc-empty-env-with-job-state state)]
    [e1 : TcTypeEnv
      (tc-bind-id
        e0
        cbi.compiler-builtin-id-cpuid
        (tc-fn2
          (ast.AstType.I64)
          (ast.AstType.I64)
          (ast.ast-ty-tuple
            (ast.ast-type-cons
              (ast.AstType.I32)
              (ast.ast-type-cons
                (ast.AstType.I32)
                (ast.ast-type-cons
                  (ast.AstType.I32)
                  (ast.ast-type-cons (ast.AstType.I32) (ast.ast-type-list-new))))))))]
    [e2 : TcTypeEnv
      (tc-bind-id
        e1
        cbi.compiler-builtin-id-xgetbv
        (tc-fn1 (ast.AstType.I64) (ast.AstType.I64)))]
    (tc-bind-id e2 (tc-default-boundary-id) (ast.AstType.Unit))))

(define (tc-macro-expr-clause-type) : ast.AstType
  (ast.AstType.Var cbi.compiler-builtin-id-fix-ExprClause))

(define (tc-macro-expr-clause-list-type) : ast.AstType
  (ast.AstType.Var cbi.compiler-builtin-id-fix-ExprClauseList))

(define (tc-macro-expr-binding-clause-type) : ast.AstType
  (ast.AstType.Var cbi.compiler-builtin-id-fix-ExprBindingClause))

(define (tc-macro-expr-binding-clause-list-type) : ast.AstType
  (ast.AstType.Var cbi.compiler-builtin-id-fix-ExprBindingClauseList))

(define (tc-macro-pattern-type) : ast.AstType
  (ast.AstType.Var cbi.compiler-builtin-id-fix-Pattern))

(define (tc-macro-pattern-list-type) : ast.AstType
  (ast.AstType.Var cbi.compiler-builtin-id-fix-PatternList))

(define (tc-macro-match-arm-type) : ast.AstType
  (ast.AstType.Var cbi.compiler-builtin-id-fix-MatchArm))

(define (tc-macro-match-arm-list-type) : ast.AstType
  (ast.AstType.Var cbi.compiler-builtin-id-fix-MatchArmList))

(define (tc-macro-expr-clause-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.Var name)
      (or
        (= name cbi.compiler-builtin-id-fix-ExprClause)
        (=
          name
          cbi.compiler-builtin-id-fix-stdlib_dot_comptime_slash_ExprClause))]
    [_ false]))

(define (tc-macro-expr-clause-list-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.Var name)
      (or
        (= name cbi.compiler-builtin-id-fix-ExprClauseList)
        (=
          name
          cbi.compiler-builtin-id-fix-stdlib_dot_comptime_slash_ExprClauseList))]
    [_ false]))

(define (tc-macro-expr-binding-clause-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.Var name)
      (or
        (= name cbi.compiler-builtin-id-fix-ExprBindingClause)
        (=
          name
          cbi.compiler-builtin-id-fix-stdlib_dot_comptime_slash_ExprBindingClause))]
    [_ false]))

(define (tc-macro-expr-binding-clause-list-type? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.Var name)
      (or
        (= name cbi.compiler-builtin-id-fix-ExprBindingClauseList)
        (=
          name
          cbi.compiler-builtin-id-fix-stdlib_dot_comptime_slash_ExprBindingClauseList))]
    [_ false]))

(define (tc-macro-type-param-kind? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.Var name) (= name cbi.compiler-builtin-id-fix-type)]
    [_ false]))

(define (tc-macro-module-param-kind? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.Var name)
      (or
        (= name cbi.compiler-builtin-id-fix-Module)
        (= name cbi.compiler-builtin-id-fix-module))]
    [_ false]))

(define (tc-type-unquote-marker? [ty : ast.AstType]) : bool
  (match ty
    [(ast.AstType.VarArgs name _) (= name cbi.compiler-builtin-id-fix-unquote)]
    [_ false]))

(define (tc-stdlib-comptime-module-name) : String
  "stdlib.comptime")

(define (tc-stdlib-comptime-type-key-id [_ : String] [name-id : i64]) : i64
  (tc-qualified-name-key-id
    cbi.compiler-builtin-id-fix-stdlib_dot_comptime
    name-id))

(define (tc-stdlib-comptime-type-display-name [name : String]) : String
  (str_cat.str-cat (tc-stdlib-comptime-module-name) "." name))

(define tc-stdlib-comptime-syntax-type-cache-generation : i64
  -1)
(define tc-stdlib-comptime-expr-key-id-cache : i64
  -1)
(define tc-stdlib-comptime-expr-list-key-id-cache : i64
  -1)
(define tc-stdlib-comptime-expr-clause-key-id-cache : i64
  -1)
(define tc-stdlib-comptime-expr-clause-list-key-id-cache : i64
  -1)
(define tc-stdlib-comptime-expr-binding-clause-key-id-cache : i64
  -1)
(define tc-stdlib-comptime-expr-binding-clause-list-key-id-cache : i64
  -1)
(define tc-stdlib-comptime-pattern-key-id-cache : i64
  -1)
(define tc-stdlib-comptime-pattern-list-key-id-cache : i64
  -1)
(define tc-stdlib-comptime-match-arm-key-id-cache : i64
  -1)
(define tc-stdlib-comptime-match-arm-list-key-id-cache : i64
  -1)

(define (tc-stdlib-comptime-syntax-type-cache-refresh!) : unit
  (begin
    (set!
      tc-stdlib-comptime-expr-key-id-cache
      (tc-stdlib-comptime-type-key-id "Expr" cbi.compiler-builtin-id-fix-Expr))
    (set!
      tc-stdlib-comptime-expr-list-key-id-cache
      (tc-stdlib-comptime-type-key-id
        "ExprList"
        cbi.compiler-builtin-id-fix-ExprList))
    (set!
      tc-stdlib-comptime-expr-clause-key-id-cache
      (tc-stdlib-comptime-type-key-id
        "ExprClause"
        cbi.compiler-builtin-id-fix-ExprClause))
    (set!
      tc-stdlib-comptime-expr-clause-list-key-id-cache
      (tc-stdlib-comptime-type-key-id
        "ExprClauseList"
        cbi.compiler-builtin-id-fix-ExprClauseList))
    (set!
      tc-stdlib-comptime-expr-binding-clause-key-id-cache
      (tc-stdlib-comptime-type-key-id
        "ExprBindingClause"
        cbi.compiler-builtin-id-fix-ExprBindingClause))
    (set!
      tc-stdlib-comptime-expr-binding-clause-list-key-id-cache
      (tc-stdlib-comptime-type-key-id
        "ExprBindingClauseList"
        cbi.compiler-builtin-id-fix-ExprBindingClauseList))
    (set!
      tc-stdlib-comptime-pattern-key-id-cache
      (tc-stdlib-comptime-type-key-id
        "Pattern"
        cbi.compiler-builtin-id-fix-Pattern))
    (set!
      tc-stdlib-comptime-pattern-list-key-id-cache
      (tc-stdlib-comptime-type-key-id
        "PatternList"
        cbi.compiler-builtin-id-fix-PatternList))
    (set!
      tc-stdlib-comptime-match-arm-key-id-cache
      (tc-stdlib-comptime-type-key-id
        "MatchArm"
        cbi.compiler-builtin-id-fix-MatchArm))
    (set!
      tc-stdlib-comptime-match-arm-list-key-id-cache
      (tc-stdlib-comptime-type-key-id
        "MatchArmList"
        cbi.compiler-builtin-id-fix-MatchArmList))
    (set!
      tc-stdlib-comptime-syntax-type-cache-generation
      (ci.intern-generation))))

(define (tc-stdlib-comptime-syntax-type-cache-ensure!) : unit
  (begin
    (cbi.compiler-builtin-refresh!)
    (if (=
      tc-stdlib-comptime-syntax-type-cache-generation
      (ci.intern-generation))
      unit
      (tc-stdlib-comptime-syntax-type-cache-refresh!))))

(define (tc-stdlib-comptime-syntax-type-id [canonical-id : i64]) : ast.AstMaybeType
  (let
    [_ : unit (tc-stdlib-comptime-syntax-type-cache-ensure!)]
    (cond
      [(= canonical-id tc-stdlib-comptime-expr-key-id-cache)
        (ast.AstMaybeType.Some (ast.AstType.Expr))]
      [(= canonical-id tc-stdlib-comptime-expr-list-key-id-cache)
        (ast.AstMaybeType.Some (ast.AstType.ExprList))]
      [(= canonical-id tc-stdlib-comptime-expr-clause-key-id-cache)
        (ast.AstMaybeType.Some (tc-macro-expr-clause-type))]
      [(= canonical-id tc-stdlib-comptime-expr-clause-list-key-id-cache)
        (ast.AstMaybeType.Some (tc-macro-expr-clause-list-type))]
      [(= canonical-id tc-stdlib-comptime-expr-binding-clause-key-id-cache)
        (ast.AstMaybeType.Some (tc-macro-expr-binding-clause-type))]
      [(= canonical-id tc-stdlib-comptime-expr-binding-clause-list-key-id-cache)
        (ast.AstMaybeType.Some (tc-macro-expr-binding-clause-list-type))]
      [(= canonical-id tc-stdlib-comptime-pattern-key-id-cache)
        (ast.AstMaybeType.Some (tc-macro-pattern-type))]
      [(= canonical-id tc-stdlib-comptime-pattern-list-key-id-cache)
        (ast.AstMaybeType.Some (tc-macro-pattern-list-type))]
      [(= canonical-id tc-stdlib-comptime-match-arm-key-id-cache)
        (ast.AstMaybeType.Some (tc-macro-match-arm-type))]
      [(= canonical-id tc-stdlib-comptime-match-arm-list-key-id-cache)
        (ast.AstMaybeType.Some (tc-macro-match-arm-list-type))]
      [else (ast.AstMaybeType.No)])))

(define (tc-stdlib-comptime-syntax-alias?
  [canonical-name : String]
  [type-name : String]) : bool
  (or
    (string.eq canonical-name type-name)
    (string.eq canonical-name (str_cat.str-cat "comptime." type-name))
    (string.eq
      canonical-name
      (str_cat.str-cat (tc-stdlib-comptime-module-name) "." type-name))
    (string.eq canonical-name (str_cat.str-cat "stdlib/comptime." type-name))
    (string.eq
      canonical-name
      (csym.compiler-symbol-module-key "comptime" type-name))
    (string.eq
      canonical-name
      (csym.compiler-symbol-module-key "stdlib/comptime" type-name))))

(define (tc-stdlib-comptime-syntax-alias-type [canonical-name : String]) : ast.AstMaybeType
  (cond
    [(tc-stdlib-comptime-syntax-alias? canonical-name "Expr")
      (ast.AstMaybeType.Some (ast.AstType.Expr))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "ExprList")
      (ast.AstMaybeType.Some (ast.AstType.ExprList))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "ExprClause")
      (ast.AstMaybeType.Some (tc-macro-expr-clause-type))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "ExprClauseList")
      (ast.AstMaybeType.Some (tc-macro-expr-clause-list-type))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "ExprBindingClause")
      (ast.AstMaybeType.Some (tc-macro-expr-binding-clause-type))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "ExprBindingClauseList")
      (ast.AstMaybeType.Some (tc-macro-expr-binding-clause-list-type))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "Pattern")
      (ast.AstMaybeType.Some (tc-macro-pattern-type))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "PatternList")
      (ast.AstMaybeType.Some (tc-macro-pattern-list-type))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "MatchArm")
      (ast.AstMaybeType.Some (tc-macro-match-arm-type))]
    [(tc-stdlib-comptime-syntax-alias? canonical-name "MatchArmList")
      (ast.AstMaybeType.Some (tc-macro-match-arm-list-type))]
    [else (ast.AstMaybeType.No)]))

(define (tc-macro-signature-stdlib-comptime-type-id [name : i64]) : ast.AstMaybeType
  (match (tc-stdlib-comptime-syntax-type-id name)
    [(ast.AstMaybeType.Some ty) (ast.AstMaybeType.Some ty)]
    [(ast.AstMaybeType.No)
      (tc-stdlib-comptime-syntax-alias-type (tc-env-key-name-text name))]))

(defenum TcStdlibTypeSpec
  (I64)
  (Bool)
  (String)
  (Name i64)
  (BoxName i64)
  (ArrayName i64))

;; The expected-surface spec tables are fixed, tiny (at most twelve entries) and
;; rebuilt once per stdlib surface check, so they are dense arrays and the
;; `-cons` spellings prepend by copy rather than chaining cells.
(defstruct TcStdlibTypeSpecList
  (slots (__tl_dyn-array TcStdlibTypeSpec))
  (len i64))

(defenum TcStdlibFieldSpec
  (Spec i64 TcStdlibTypeSpec))

(defstruct TcStdlibFieldSpecList
  (slots (__tl_dyn-array TcStdlibFieldSpec))
  (len i64))

(defenum TcStdlibVariantSpec
  (Spec i64 TcStdlibTypeSpecList))

(defstruct TcStdlibVariantSpecList
  (slots (__tl_dyn-array TcStdlibVariantSpec))
  (len i64))

(define (tc-stdlib-type-spec-list0) : TcStdlibTypeSpecList
  (TcStdlibTypeSpecList (array.make-array TcStdlibTypeSpec 0) 0))

(define (tc-stdlib-type-spec-list1 [a : TcStdlibTypeSpec]) : TcStdlibTypeSpecList
  (let
    [slots : (__tl_dyn-array TcStdlibTypeSpec)
      (array.make-array TcStdlibTypeSpec 1)]
    (begin
      (set! (array-ref slots 0) a)
      (TcStdlibTypeSpecList slots 1))))

(define (tc-stdlib-type-spec-list2
  [a : TcStdlibTypeSpec]
  [b : TcStdlibTypeSpec]) : TcStdlibTypeSpecList
  (let
    [slots : (__tl_dyn-array TcStdlibTypeSpec)
      (array.make-array TcStdlibTypeSpec 2)]
    (begin
      (set! (array-ref slots 0) a)
      (set! (array-ref slots 1) b)
      (TcStdlibTypeSpecList slots 2))))

(define (tc-stdlib-type-spec-list3
  [a : TcStdlibTypeSpec]
  [b : TcStdlibTypeSpec]
  [c : TcStdlibTypeSpec]) : TcStdlibTypeSpecList
  (let
    [slots : (__tl_dyn-array TcStdlibTypeSpec)
      (array.make-array TcStdlibTypeSpec 3)]
    (begin
      (set! (array-ref slots 0) a)
      (set! (array-ref slots 1) b)
      (set! (array-ref slots 2) c)
      (TcStdlibTypeSpecList slots 3))))

(define (tc-stdlib-field-spec-nil) : TcStdlibFieldSpecList
  (TcStdlibFieldSpecList (array.make-array TcStdlibFieldSpec 0) 0))

(define (tc-stdlib-field-spec-cons
  [name : i64]
  [ty : TcStdlibTypeSpec]
  [rest : TcStdlibFieldSpecList]) : TcStdlibFieldSpecList
  (let
    [n : i64 rest.len]
    [src : (__tl_dyn-array TcStdlibFieldSpec) rest.slots]
    [slots : (__tl_dyn-array TcStdlibFieldSpec)
      (array.make-array TcStdlibFieldSpec (+ n 1))]
    [i : i64 0]
    (begin
      (cfg compile-profile (tc-lp-note 8))
      (set! (array-ref slots 0) (TcStdlibFieldSpec.Spec name ty))
      (while (< i n)
        (begin
          (set! (array-ref slots (+ i 1)) (array-ref src i))
          (set! i (+ i 1))))
      (TcStdlibFieldSpecList slots (+ n 1)))))

(define (tc-stdlib-variant-spec-nil) : TcStdlibVariantSpecList
  (TcStdlibVariantSpecList (array.make-array TcStdlibVariantSpec 0) 0))

(define (tc-stdlib-variant-spec-cons
  [name : i64]
  [payloads : TcStdlibTypeSpecList]
  [rest : TcStdlibVariantSpecList]) : TcStdlibVariantSpecList
  (let
    [n : i64 rest.len]
    [src : (__tl_dyn-array TcStdlibVariantSpec) rest.slots]
    [slots : (__tl_dyn-array TcStdlibVariantSpec)
      (array.make-array TcStdlibVariantSpec (+ n 1))]
    [i : i64 0]
    (begin
      (cfg compile-profile (tc-lp-note 10))
      (set! (array-ref slots 0) (TcStdlibVariantSpec.Spec name payloads))
      (while (< i n)
        (begin
          (set! (array-ref slots (+ i 1)) (array-ref src i))
          (set! i (+ i 1))))
      (TcStdlibVariantSpecList slots (+ n 1)))))

(define (tc-stdlib-well-known-mismatch [type-name : String] [detail : String]) : ResultTcUnit
  (ResultTcUnit.Err
    (str_cat.str-cat
      "typecheck: stdlib well-known type mismatch for "
      (tc-stdlib-comptime-type-display-name type-name)
      ": "
      detail)))

(define (tc-stdlib-comptime-plain-declaration-message) : String
  "expected plain stdlib.comptime well-known declaration")

(define (tc-stdlib-comptime-well-known-type? [type-name : String]) : bool
  (or
    (string.eq type-name "Expr")
    (string.eq type-name "ExprList")
    (string.eq type-name "ExprClause")
    (string.eq type-name "ExprClauseList")
    (string.eq type-name "ExprBindingClause")
    (string.eq type-name "ExprBindingClauseList")
    (string.eq type-name "Pattern")
    (string.eq type-name "PatternList")
    (string.eq type-name "MatchArm")
    (string.eq type-name "MatchArmList")
    (string.eq type-name "TypeInfo")
    (string.eq type-name "TypeInfoList")
    (string.eq type-name "TypeField")
    (string.eq type-name "TypeFieldList")
    (string.eq type-name "TypeVariantPayload")
    (string.eq type-name "TypeVariantPayloadList")
    (string.eq type-name "TypeVariant")
    (string.eq type-name "TypeVariantList")
    (string.eq type-name "TypeParam")
    (string.eq type-name "TypeParamList")))

(define (tc-stdlib-comptime-raw-type-name [decl : ast.AstDecl]) : TcMaybeString
  (match decl
    [(ast.AstDecl.Unsafe inner-box)
      (tc-stdlib-comptime-raw-type-name (__tl-box-place inner-box))]
    [(ast.AstDecl.DefEnum decl-meta name _ _)
      (TcMaybeString.Some (tc-env-key-name-text name))]
    [(ast.AstDecl.DefEnumLifetimes decl-meta name _ _ _)
      (TcMaybeString.Some (tc-env-key-name-text name))]
    [(ast.AstDecl.DefStruct decl-meta name _ _ _)
      (TcMaybeString.Some (tc-env-key-name-text name))]
    [(ast.AstDecl.DefStructLifetimes decl-meta name _ _ _ _)
      (TcMaybeString.Some (tc-env-key-name-text name))]
    [_ (TcMaybeString.No)]))

(define (tc-stdlib-comptime-raw-comptime-decl? [decl : ast.AstDecl]) : bool
  (ast.ast-decl-comptime-only? decl))

(define (tc-stdlib-check-comptime-declaration-surface-decl
  [module : String]
  [decl : ast.AstDecl]) : ResultTcUnit
  (if (not (string.eq module (tc-stdlib-comptime-module-name)))
    ResultTcUnit.Ok
    (match (tc-stdlib-comptime-raw-type-name decl)
      [(TcMaybeString.No) ResultTcUnit.Ok]
      [(TcMaybeString.Some type-name)
        (if (tc-stdlib-comptime-raw-comptime-decl? decl)
          (if (tc-stdlib-comptime-well-known-type? type-name)
            (tc-stdlib-well-known-mismatch
              type-name
              (tc-stdlib-comptime-plain-declaration-message))
            ResultTcUnit.Ok)
          ResultTcUnit.Ok)])))

;; Index cursor rather than `ast-decl-list-step`; the first `Err` still stops
;; the walk, now through `ok` instead of by not recursing.
(define (tc-stdlib-check-comptime-declaration-surface-list
  [decls : ast.AstDeclList]
  [module : String]) : ResultTcUnit
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
    [decl-offset : i64 decls.offset]
    [index : i64 0]
    [current-module : String module]
    [message : String ""]
    [ok : bool true]
    (begin
      (while (and ok (< index count))
        (begin
          (match (array-ref decl-slots (+ decl-offset index))
            [(ast.AstDecl.Module module-id)
              (set! current-module (tc-env-key-name-text module-id))]
            [_
              (match (tc-stdlib-check-comptime-declaration-surface-decl
                current-module
                (array-ref decl-slots (+ decl-offset index)))
                [(ResultTcUnit.Ok) unit]
                [(ResultTcUnit.Err step-message)
                  (begin
                    (set! message step-message)
                    (set! ok false))])])
          (set! index (+ index 1))))
      (if ok
        ResultTcUnit.Ok
        (ResultTcUnit.Err message)))))

(define (tc-stdlib-check-comptime-declaration-surface [ctx : TcContext]) : ResultTcUnit
  (match (tc-context-program ctx)
    [(ast.AstProgram.Program decls-box)
      (tc-stdlib-check-comptime-declaration-surface-list
        (__tl-box-place decls-box)
        "")]))

(define (tc-stdlib-type-normalize-name [ctx : TcContext] [ty : ast.AstType]) : ast.AstType
  (match ty
    [(ast.AstType.Var name)
      (tc-resolve-type-name ctx (tc-hygiene-name-text-id name) name)]
    [_ ty]))

(define (tc-stdlib-type-match-normalized?
  [ctx : TcContext]
  [actual : ast.AstType]
  [expected : ast.AstType]) : bool
  (match actual
    [(ast.AstType.I64)
      (match expected
        [(ast.AstType.I64) true]
        [_ false])]
    [(ast.AstType.I32)
      (match expected
        [(ast.AstType.I32) true]
        [_ false])]
    [(ast.AstType.Bool)
      (match expected
        [(ast.AstType.Bool) true]
        [_ false])]
    [(ast.AstType.String)
      (match expected
        [(ast.AstType.String) true]
        [_ false])]
    [(ast.AstType.Expr)
      (match expected
        [(ast.AstType.Expr) true]
        [_ false])]
    [(ast.AstType.ExprList)
      (match expected
        [(ast.AstType.ExprList) true]
        [_ false])]
    [(ast.AstType.Box actual-inner)
      (match expected
        [(ast.AstType.Box expected-inner)
          (tc-stdlib-type-match?
            ctx
            (tc-context-type-get ctx actual-inner)
            (ast.ty-node-get expected-inner))]
        [_ false])]
    [(ast.AstType.DynArray actual-inner)
      (match expected
        [(ast.AstType.DynArray expected-inner)
          (tc-stdlib-type-match?
            ctx
            (tc-context-type-get ctx actual-inner)
            (ast.ty-node-get expected-inner))]
        [_ false])]
    [(ast.AstType.Struct actual-name)
      (match expected
        [(ast.AstType.Struct expected-name)
          (tc-nominal-name-id-eq? actual-name expected-name)]
        [_ false])]
    [(ast.AstType.Enum actual-name)
      (match expected
        [(ast.AstType.Enum expected-name)
          (tc-nominal-name-id-eq? actual-name expected-name)]
        [_ false])]
    [(ast.AstType.Var actual-name)
      (match expected
        [(ast.AstType.Var expected-name)
          (tc-nominal-name-id-eq? actual-name expected-name)]
        [_ false])]
    [_ false]))

(define (tc-stdlib-type-match?
  [ctx : TcContext]
  [actual : ast.AstType]
  [expected : ast.AstType]) : bool
  (tc-stdlib-type-match-normalized?
    ctx
    (tc-stdlib-type-normalize-name ctx actual)
    (tc-stdlib-type-normalize-name ctx expected)))

(define (tc-stdlib-type-name-match?
  [ctx : TcContext]
  [actual : ast.AstType]
  [name : i64]) : bool
  (tc-stdlib-type-match? ctx actual (ast.AstType.Var name)))

(define (tc-stdlib-type-spec-match?
  [ctx : TcContext]
  [actual : ast.AstType]
  [expected : TcStdlibTypeSpec]) : bool
  (match expected
    [(TcStdlibTypeSpec.I64)
      (match actual
        [(ast.AstType.I64) true]
        [_ false])]
    [(TcStdlibTypeSpec.Bool)
      (match actual
        [(ast.AstType.Bool) true]
        [_ false])]
    [(TcStdlibTypeSpec.String)
      (match actual
        [(ast.AstType.String) true]
        [_ false])]
    [(TcStdlibTypeSpec.Name name) (tc-stdlib-type-name-match? ctx actual name)]
    [(TcStdlibTypeSpec.BoxName name)
      (match actual
        [(ast.AstType.Box inner)
          (tc-stdlib-type-name-match? ctx (tc-context-type-get ctx inner) name)]
        [_ false])]
    [(TcStdlibTypeSpec.ArrayName name)
      (match actual
        [(ast.AstType.DynArray inner)
          (tc-stdlib-type-name-match? ctx (tc-context-type-get ctx inner) name)]
        [_ false])]))

(define (tc-stdlib-type-spec-render [expected : TcStdlibTypeSpec]) : String
  (match expected
    [(TcStdlibTypeSpec.I64) "i64"]
    [(TcStdlibTypeSpec.Bool) "bool"]
    [(TcStdlibTypeSpec.String) "String"]
    [(TcStdlibTypeSpec.Name name) (tc-env-key-name-text name)]
    [(TcStdlibTypeSpec.BoxName name)
      (str_cat.str-cat "(Box " (tc-env-key-name-text name) ")")]
    [(TcStdlibTypeSpec.ArrayName name)
      (str_cat.str-cat "(Array " (tc-env-key-name-text name) ")")]))

(define (tc-stdlib-check-field-specs
  [ctx : TcContext]
  [type-name : String]
  [fields : ast.AstFieldDefList]
  [specs : TcStdlibFieldSpecList]
  [index : i64]) : ResultTcUnit
  (if (>= index specs.len)
    (if (>= index fields.len)
      ResultTcUnit.Ok
      (tc-stdlib-well-known-mismatch type-name "unexpected extra field"))
    (match (array-ref specs.slots index)
      [(TcStdlibFieldSpec.Spec expected-name expected-ty)
        (let
          [expected-name-text : String (ci.intern-str expected-name)]
          (begin
            (cfg compile-profile (tc-lp-note 9))
            (if (>= index fields.len)
              (tc-stdlib-well-known-mismatch
                type-name
                (str_cat.str-cat "missing field " expected-name-text))
              (match (ast.ast-field-def-list-get
                (& fields)
                index
                (ast.ast-field-def-fallback))
                [(ast.AstFieldDef.Def actual-name actual-ty _)
                  (cond
                    [(not (= actual-name expected-name))
                      (tc-stdlib-well-known-mismatch
                        type-name
                        (str_cat.str-cat
                          "expected field "
                          expected-name-text
                          " at index "
                          (string.int->string index)))]
                    [(tc-stdlib-type-spec-match? ctx actual-ty expected-ty)
                      (tc-stdlib-check-field-specs
                        ctx
                        type-name
                        fields
                        specs
                        (+ index 1))]
                    [else
                      (tc-stdlib-well-known-mismatch
                        type-name
                        (str_cat.str-cat
                          "expected field "
                          expected-name-text
                          " type "
                          (tc-stdlib-type-spec-render expected-ty)))])]))))])))

(define (tc-stdlib-check-payload-specs
  [ctx : TcContext]
  [type-name : String]
  [variant-name : String]
  [actual : ast.AstTypeList]
  [expected : TcStdlibTypeSpecList]
  [index : i64]) : ResultTcUnit
  (if (>= index expected.len)
    (if (>= index (ast.ast-type-list-len (& actual)))
      ResultTcUnit.Ok
      (tc-stdlib-well-known-mismatch
        type-name
        (str_cat.str-cat "payload arity mismatch for variant " variant-name)))
    (if (>= index (ast.ast-type-list-len (& actual)))
      (tc-stdlib-well-known-mismatch
        type-name
        (str_cat.str-cat "payload arity mismatch for variant " variant-name))
      (let
        [actual-id : i64
          (ast.ast-type-list-get (& actual) index (ast.ast-type-id-fallback))]
        [actual-ty : ast.AstType (tc-context-type-get ctx actual-id)]
        [expected-ty : TcStdlibTypeSpec (array-ref expected.slots index)]
        (if (tc-stdlib-type-spec-match? ctx actual-ty expected-ty)
          (tc-stdlib-check-payload-specs
            ctx
            type-name
            variant-name
            actual
            expected
            (+ index 1))
          (tc-stdlib-well-known-mismatch
            type-name
            (str_cat.str-cat
              "payload type mismatch for variant "
              variant-name
              " at index "
              (string.int->string index))))))))

(define (tc-stdlib-check-variant-specs
  [ctx : TcContext]
  [type-name : String]
  [variants : ast.AstVariantDefList]
  [specs : TcStdlibVariantSpecList]
  [index : i64]) : ResultTcUnit
  (if (>= index specs.len)
    (if (>= index variants.len)
      ResultTcUnit.Ok
      (tc-stdlib-well-known-mismatch type-name "unexpected extra variant"))
    (match (array-ref specs.slots index)
      [(TcStdlibVariantSpec.Spec expected-name expected-payloads)
        (let
          [expected-name-text : String (ci.intern-str expected-name)]
          (begin
            (cfg compile-profile (tc-lp-note 11))
            (if (>= index variants.len)
              (tc-stdlib-well-known-mismatch
                type-name
                (str_cat.str-cat "missing variant " expected-name-text))
              (let
                [variant : ast.AstVariantDef
                  (ast.ast-variant-def-list-get
                    (& variants)
                    index
                    (ast.ast-variant-def-fallback))]
                (match variant
                  [(ast.AstVariantDef.Def actual-name actual-payloads _)
                    (if (not (= actual-name expected-name))
                      (tc-stdlib-well-known-mismatch
                        type-name
                        (str_cat.str-cat
                          "expected variant "
                          expected-name-text
                          " at index "
                          (string.int->string index)))
                      (match (tc-stdlib-check-payload-specs
                        ctx
                        type-name
                        expected-name-text
                        actual-payloads
                        expected-payloads
                        0)
                        [(ResultTcUnit.Ok)
                          (tc-stdlib-check-variant-specs
                            ctx
                            type-name
                            variants
                            specs
                            (+ index 1))]
                        [(ResultTcUnit.Err message) (ResultTcUnit.Err message)]))])))))])))

(define (tc-stdlib-check-struct
  [ctx : TcContext]
  [type-name : String]
  [type-name-id : i64]
  [specs : TcStdlibFieldSpecList]) : ResultTcUnit
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-type-in-module-id-or
        (tc-context-symbols ctx)
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime
        type-name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (match (csym.compiler-symbols-decl-at-index
        (tc-context-symbols ctx)
        (csym.compiler-symbol-handle-index handle))
        [(parser.ResultAstDecl.Ok decl)
          (match decl
            [(ast.AstDecl.DefStruct decl-meta _ _ _ fields)
              (tc-stdlib-check-field-specs
                (tc-context-with-module-id
                  ctx
                  (tc-stdlib-comptime-module-name)
                  cbi.compiler-builtin-id-fix-stdlib_dot_comptime)
                type-name
                fields
                specs
                0)]
            [_ (tc-stdlib-well-known-mismatch type-name "expected defstruct")])]
        [(parser.ResultAstDecl.Err message)
          (tc-stdlib-well-known-mismatch type-name message)])
      (tc-stdlib-well-known-mismatch type-name "missing declaration"))))

(define (tc-stdlib-check-enum
  [ctx : TcContext]
  [type-name : String]
  [type-name-id : i64]
  [specs : TcStdlibVariantSpecList]) : ResultTcUnit
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-type-in-module-id-or
        (tc-context-symbols ctx)
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime
        type-name-id
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (match (csym.compiler-symbols-decl-at-index
        (tc-context-symbols ctx)
        (csym.compiler-symbol-handle-index handle))
        [(parser.ResultAstDecl.Ok decl)
          (match decl
            [(ast.AstDecl.DefEnum decl-meta _ _ variants)
              (tc-stdlib-check-variant-specs
                (tc-context-with-module-id
                  ctx
                  (tc-stdlib-comptime-module-name)
                  cbi.compiler-builtin-id-fix-stdlib_dot_comptime)
                type-name
                variants
                specs
                0)]
            [_ (tc-stdlib-well-known-mismatch type-name "expected defenum")])]
        [(parser.ResultAstDecl.Err message)
          (tc-stdlib-well-known-mismatch type-name message)])
      (tc-stdlib-well-known-mismatch type-name "missing declaration"))))

(define (tc-stdlib-comptime-present? [ctx : TcContext]) : bool
  (or
    (csym.compiler-symbols-handle-found?
      (csym.compiler-symbols-lookup-type-in-module-id-or
        (tc-context-symbols ctx)
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime
        cbi.compiler-builtin-id-fix-Expr
        (csym.compiler-symbols-missing-handle)))
    (csym.compiler-symbols-handle-found?
      (csym.compiler-symbols-lookup-type-in-module-id-or
        (tc-context-symbols ctx)
        cbi.compiler-builtin-id-fix-stdlib_dot_comptime
        cbi.compiler-builtin-id-fix-TypeInfo
        (csym.compiler-symbols-missing-handle)))))

(define (tc-stdlib-expr-specs [_ctx : TcContext]) : TcStdlibVariantSpecList
  (tc-stdlib-variant-spec-cons
    cbi.compiler-builtin-id-comptime-expr-bool-variant
    (tc-stdlib-type-spec-list1 (TcStdlibTypeSpec.Bool))
    (tc-stdlib-variant-spec-cons
      cbi.compiler-builtin-id-comptime-expr-int-variant
      (tc-stdlib-type-spec-list1 (TcStdlibTypeSpec.I64))
      (tc-stdlib-variant-spec-cons
        cbi.compiler-builtin-id-comptime-expr-var-variant
        (tc-stdlib-type-spec-list1 (TcStdlibTypeSpec.String))
        (tc-stdlib-variant-spec-cons
          cbi.compiler-builtin-id-comptime-expr-splice-variant
          (tc-stdlib-type-spec-list1
            (TcStdlibTypeSpec.BoxName cbi.compiler-builtin-id-fix-Expr))
          (tc-stdlib-variant-spec-cons
            cbi.compiler-builtin-id-comptime-expr-if-variant
            (tc-stdlib-type-spec-list3
              (TcStdlibTypeSpec.BoxName cbi.compiler-builtin-id-fix-Expr)
              (TcStdlibTypeSpec.BoxName cbi.compiler-builtin-id-fix-Expr)
              (TcStdlibTypeSpec.BoxName cbi.compiler-builtin-id-fix-Expr))
            (tc-stdlib-variant-spec-cons
              cbi.compiler-builtin-id-comptime-expr-call-variant
              (tc-stdlib-type-spec-list2
                (TcStdlibTypeSpec.BoxName cbi.compiler-builtin-id-fix-Expr)
                (TcStdlibTypeSpec.Name cbi.compiler-builtin-id-fix-ExprList))
              (tc-stdlib-variant-spec-cons
                cbi.compiler-builtin-id-comptime-expr-begin-variant
                (tc-stdlib-type-spec-list1
                  (TcStdlibTypeSpec.Name cbi.compiler-builtin-id-fix-ExprList))
                (tc-stdlib-variant-spec-cons
                  cbi.compiler-builtin-id-comptime-expr-quote-variant
                  (tc-stdlib-type-spec-list1
                    (TcStdlibTypeSpec.BoxName cbi.compiler-builtin-id-fix-Expr))
                  (tc-stdlib-variant-spec-cons
                    cbi.compiler-builtin-id-comptime-expr-quasiquote-variant
                    (tc-stdlib-type-spec-list1
                      (TcStdlibTypeSpec.BoxName
                        cbi.compiler-builtin-id-fix-Expr))
                    (tc-stdlib-variant-spec-cons
                      cbi.compiler-builtin-id-comptime-expr-unquote-variant
                      (tc-stdlib-type-spec-list1
                        (TcStdlibTypeSpec.BoxName
                          cbi.compiler-builtin-id-fix-Expr))
                      (tc-stdlib-variant-spec-cons
                        cbi.compiler-builtin-id-comptime-expr-unquote-splicing-variant
                        (tc-stdlib-type-spec-list1
                          (TcStdlibTypeSpec.BoxName
                            cbi.compiler-builtin-id-fix-Expr))
                        (tc-stdlib-variant-spec-nil)))))))))))))

(define (tc-stdlib-sequence-fields [_ctx : TcContext] [elem-name : i64]) : TcStdlibFieldSpecList
  (tc-stdlib-field-spec-cons
    cbi.compiler-builtin-id-fix-items
    (TcStdlibTypeSpec.ArrayName elem-name)
    (tc-stdlib-field-spec-cons
      cbi.compiler-builtin-id-fix-len
      (TcStdlibTypeSpec.I64)
      (tc-stdlib-field-spec-nil))))

(define (tc-stdlib-pattern-specs [_ctx : TcContext]) : TcStdlibVariantSpecList
  (tc-stdlib-variant-spec-cons
    cbi.compiler-builtin-id-comptime-pattern-wildcard-variant
    (tc-stdlib-type-spec-list0)
    (tc-stdlib-variant-spec-cons
      cbi.compiler-builtin-id-comptime-pattern-binding-variant
      (tc-stdlib-type-spec-list1 (TcStdlibTypeSpec.String))
      (tc-stdlib-variant-spec-cons
        cbi.compiler-builtin-id-comptime-pattern-variant-variant
        (tc-stdlib-type-spec-list2
          (TcStdlibTypeSpec.String)
          (TcStdlibTypeSpec.Name cbi.compiler-builtin-id-fix-PatternList))
        (tc-stdlib-variant-spec-nil)))))

(define (tc-stdlib-match-arm-fields) : TcStdlibFieldSpecList
  (tc-stdlib-field-spec-cons
    cbi.compiler-builtin-id-fix-pattern
    (TcStdlibTypeSpec.Name cbi.compiler-builtin-id-fix-Pattern)
    (tc-stdlib-field-spec-cons
      cbi.compiler-builtin-id-fix-body
      (TcStdlibTypeSpec.Name cbi.compiler-builtin-id-fix-Expr)
      (tc-stdlib-field-spec-nil))))

(define (tc-stdlib-type-info-specs [_ctx : TcContext]) : TcStdlibVariantSpecList
  (tc-stdlib-variant-spec-cons
    cbi.compiler-builtin-id-comptime-type-info-builtin-variant
    (tc-stdlib-type-spec-list1 (TcStdlibTypeSpec.String))
    (tc-stdlib-variant-spec-cons
      cbi.compiler-builtin-id-comptime-type-info-array-variant
      (tc-stdlib-type-spec-list2
        (TcStdlibTypeSpec.BoxName cbi.compiler-builtin-id-fix-TypeInfo)
        (TcStdlibTypeSpec.I64))
      (tc-stdlib-variant-spec-cons
        cbi.compiler-builtin-id-comptime-type-info-dyn-array-variant
        (tc-stdlib-type-spec-list1
          (TcStdlibTypeSpec.BoxName cbi.compiler-builtin-id-fix-TypeInfo))
        (tc-stdlib-variant-spec-cons
          cbi.compiler-builtin-id-comptime-type-info-function-variant
          (tc-stdlib-type-spec-list2
            (TcStdlibTypeSpec.Name cbi.compiler-builtin-id-fix-TypeInfoList)
            (TcStdlibTypeSpec.BoxName cbi.compiler-builtin-id-fix-TypeInfo))
          (tc-stdlib-variant-spec-cons
            cbi.compiler-builtin-id-comptime-type-info-tuple-variant
            (tc-stdlib-type-spec-list1
              (TcStdlibTypeSpec.Name cbi.compiler-builtin-id-fix-TypeInfoList))
            (tc-stdlib-variant-spec-cons
              cbi.compiler-builtin-id-comptime-type-info-struct-variant
              (tc-stdlib-type-spec-list2
                (TcStdlibTypeSpec.String)
                (TcStdlibTypeSpec.Name
                  cbi.compiler-builtin-id-fix-TypeFieldList))
              (tc-stdlib-variant-spec-cons
                cbi.compiler-builtin-id-comptime-type-info-enum-variant
                (tc-stdlib-type-spec-list2
                  (TcStdlibTypeSpec.String)
                  (TcStdlibTypeSpec.Name
                    cbi.compiler-builtin-id-fix-TypeVariantList))
                (tc-stdlib-variant-spec-cons
                  cbi.compiler-builtin-id-comptime-type-info-opaque-variant
                  (tc-stdlib-type-spec-list1 (TcStdlibTypeSpec.String))
                  (tc-stdlib-variant-spec-cons
                    cbi.compiler-builtin-id-comptime-type-info-slice-variant
                    (tc-stdlib-type-spec-list1
                      (TcStdlibTypeSpec.BoxName
                        cbi.compiler-builtin-id-fix-TypeInfo))
                    (tc-stdlib-variant-spec-nil)))))))))))

(define (tc-stdlib-comptime-surface-step
  [current : ResultTcUnit]
  [next : ResultTcUnit]) : ResultTcUnit
  (match current
    [(ResultTcUnit.Ok) next]
    [(ResultTcUnit.Err _) current]))

(define (tc-stdlib-expr-clause-fields) : TcStdlibFieldSpecList
  (tc-stdlib-field-spec-cons
    cbi.compiler-builtin-id-fix-first
    (TcStdlibTypeSpec.Name cbi.compiler-builtin-id-fix-Expr)
    (tc-stdlib-field-spec-cons
      cbi.compiler-builtin-id-fix-second
      (TcStdlibTypeSpec.Name cbi.compiler-builtin-id-fix-Expr)
      (tc-stdlib-field-spec-nil))))

(define (tc-stdlib-expr-binding-clause-fields) : TcStdlibFieldSpecList
  (tc-stdlib-field-spec-cons
    cbi.compiler-builtin-id-fix-name
